(module jolt.coil.core-runtime)
(import "coil.scheme" :use *)
(import "jolt.coil.expression-runtime" :use *)
(import "coil.scheme.stdproc" :as stdproc)
(import "coil.primitive" :as primitive)

;; Minimal executable Jolt runtime surface. These are the names emitted by the
;; backend, not source-level conveniences invented by the adapter.
;; Shared before-thunk marker used by Jolt's emitted finally dynamic-winds. On
;; the single-threaded host it deliberately has no effect, matching values.ss;
;; its identity becomes significant only to Jolt's optional fiber scheduler.
(define (jolt-finally-in) #f)
(export jolt-finally-in)
(define (jolt-zero? n) (= n 0))
(define (jolt-n- a b) (- a b))
(define (jolt-n+ a b) (+ a b))
(define (jolt-n+0) 0)
(define (jolt-n+1 a) a)
(define (jolt-n+3 a b c) (+ (+ a b) c))
(define (jolt-n+4 a b c d) (+ (+ a b) (+ c d)))
(define (jolt-n* a b) (* a b))
(define (jolt-sub-rest acc xs)
  (if (null? xs) acc (jolt-sub-rest (- acc (car xs)) (cdr xs))))
(define (jolt-sub-value)
  (lambda xs
    (if (null? (cdr xs)) (- 0 (car xs))
      (jolt-sub-rest (car xs) (cdr xs)))))
(define (jolt-mul-rest acc xs)
  (if (null? xs) acc (jolt-mul-rest (* acc (car xs)) (cdr xs))))
(define (jolt-mul-value) (lambda xs (jolt-mul-rest 1 xs)))
(define (jolt-n-max a b) (if (> a b) a b))
(define (jolt-n-min a b) (if (< a b) a b))
(define (jolt-n> a b) (> a b))
(define (jolt-n< a b) (< a b))
(define (jolt-n<= a b) (<= a b))
(define (jolt-n>= a b) (>= a b))
(define (jolt-lt-value) (lambda (a b) (< a b)))
(define (jolt-le-value) (lambda (a b) (<= a b)))
(define (jolt-gt-value) (lambda (a b) (> a b)))
(define (jolt-ge-value) (lambda (a b) (>= a b)))
(define (jolt-n-dec n) (- n 1))
(define (jolt-n-inc n) (+ n 1))
(define (jolt-inc-value) (lambda (n) (jolt-n-inc n)))
(define (jolt-dec-value) (lambda (n) (jolt-n-dec n)))
(define (jolt-neg? n) (< n 0))
(define (jolt-pos? n) (> n 0))
(define (jolt-long-cast n) n)
(define (jolt-int-cast n) n)
(define (jolt-double n) (exact->inexact n))
(define (jolt-bit-and a b)
  (mk-fixnum (primitive/iand (fixnum-value a) (fixnum-value b))))
(define (jolt-not x) (if (jolt-truthy? x) #f #t))
(define (jolt-identity x) x)
(define (jolt-identity-value) (lambda (x) x))
(define (jolt=2 a b)
  (if (and (jolt-set? a) (jolt-set? b)) (jolt-set-equal? a b)
    (equal? a b)))
(define (jolt-equal-rest? previous xs)
  (if (null? xs) #t
    (if (jolt=2 previous (car xs))
      (jolt-equal-rest? (car xs) (cdr xs))
      #f)))
(define (jolt-equal-value)
  (lambda xs
    (if (null? xs) #t (jolt-equal-rest? (car xs) (cdr xs)))))
(define (jolt-nil-value) (string->symbol "jolt.runtime/nil"))
(define (jolt-nil? x) (eq? x (jolt-nil-value)))
(define (jolt-truthy? x)
  (if (jolt-nil? x) #f (if (eq? x #f) #f #t)))
;; Native seed definitions must resolve their cold error branches at compile
;; time. Programs whose control flow actually throws are routed through the
;; evaluator runtime; this fallback preserves the payload only so valid native
;; compiler paths can be linked while that boundary remains split.
(define (jolt-throw value) value)
(define (jolt-ex-info message data) (cons message data))
(define (jolt-vector . xs) (list->vector xs))
(define (jolt-vector0) (vector))
(define (jolt-vector1 a) (vector a))
(define (jolt-vector2 a b) (vector a b))
(define (jolt-vector3 a b c) (vector a b c))
(define (jolt-vector4 a b c d) (vector a b c d))
(define (jolt-vector5 a b c d e) (vector a b c d e))
(define (jolt-vector6 a b c d e f) (vector a b c d e f))
(define (jolt-vector7 a b c d e f g) (vector a b c d e f g))
(define (jolt-vector8 a b c d e f g h) (vector a b c d e f g h))
(define (jolt-vector-value) (lambda xs (list->vector xs)))
(define (jolt-list . xs) xs)
(define (jolt-list0) (list))
(define (jolt-list1 a) (list a))
(define (jolt-list2 a b) (list a b))
(define (jolt-list3 a b c) (list a b c))
(define (jolt-list4 a b c d) (list a b c d))
(define (jolt-list5 a b c d e) (list a b c d e))
(define (jolt-list6 a b c d e f) (list a b c d e f))
(define (jolt-list-value) (lambda xs xs))
(define (jolt-count xs)
  (if (jolt-nil? xs) 0
    (if (vector? xs) (vector-length xs)
      (if (string? xs) (string-length xs) (length xs)))))
(define (jolt-nth xs i)
  (if (vector? xs) (vector-ref xs i)
    (if (string? xs) (string-ref xs i)
      (if (= i 0) (car xs)
        (let ((tail (cdr xs)))
          (if (and (= i 1) (not (pair? tail))) tail
            (jolt-nth tail (- i 1))))))))
(define (jolt-nth3 xs i fallback)
  (if (or (< i 0) (>= i (jolt-count xs))) fallback (jolt-nth xs i)))
(define (jolt-conj2 xs x)
  (if (jolt-nil? xs) (list x)
    (if (jolt-set? xs) (jolt-set-conj xs x)
    (if (vector? xs)
      (list->vector (append (vector->list xs) (list x)))
      (if (and (core-map? xs) (core-map? x))
        (jolt-map-merge xs x)
        (cons x xs))))))
(define (jolt-conj-value) (lambda (xs x) (jolt-conj2 xs x)))
(define (jolt-first xs)
  (if (jolt-nil? xs) (jolt-nil-value)
    (if (vector? xs)
      (if (= (vector-length xs) 0) (jolt-nil-value) (vector-ref xs 0))
      (if (null? xs) (jolt-nil-value) (car xs)))))
(define (jolt-first-value) (lambda (xs) (jolt-first xs)))
(define (jolt-next xs)
  (if (jolt-nil? xs) (jolt-nil-value)
    (let ((items (if (vector? xs) (vector->list xs)
                   (if (string? xs) (string->list xs) xs))))
      (if (or (null? items) (null? (cdr items)))
        (jolt-nil-value)
        (cdr items)))))
(define (jolt-rest xs)
  (let ((items (if (vector? xs) (vector->list xs) xs)))
    (if (null? items) (list) (cdr items))))
(define (jolt-rest-value) (lambda (xs) (jolt-rest xs)))
(define (jolt-take n xs)
  (if (<= n 0) (list)
    (let ((s (jolt-seq xs)))
      (if (jolt-nil? s) (list)
        (cons (jolt-first s) (jolt-take (- n 1) (jolt-rest s)))))))
(define (jolt-drop n xs)
  (let ((s (jolt-seq xs)))
    (if (or (<= n 0) (jolt-nil? s)) s
      (jolt-drop (- n 1) (jolt-rest s)))))
(define (jolt-cons x xs) (cons x xs))
(define (jolt-empty? xs)
  (if (jolt-nil? xs) #t
    (if (vector? xs) (= (vector-length xs) 0)
      (if (string? xs) (= (string-length xs) 0) (null? xs)))))
(define (jolt-some? x) (not (jolt-nil? x)))
(define (jolt-seq xs)
  (if (jolt-nil? xs) (jolt-nil-value)
    (if (vector? xs)
      (if (= (vector-length xs) 0) (jolt-nil-value) (vector->list xs))
      (if (string? xs)
        (if (= (string-length xs) 0) (jolt-nil-value) (string->list xs))
        (if (null? xs) (jolt-nil-value) xs)))))
(define (jolt-seq-value) (lambda (xs) (jolt-seq xs)))
(define (jolt-concat a b)
  (append (let ((s (jolt-seq a))) (if (jolt-nil? s) (list) s))
          (let ((s (jolt-seq b))) (if (jolt-nil? s) (list) s))))
(define (jolt-concat0) (list))
(define (jolt-concat3 a b c) (jolt-concat (jolt-concat a b) c))
(define (jolt-concat-list xss)
  (if (null? xss) (list)
    (jolt-concat (car xss) (jolt-concat-list (cdr xss)))))
(define (jolt-concat-value) (lambda xss (jolt-concat-list xss)))
;; Filesystem interop is outside the single-threaded language kernel. Keep the
;; host-call boundary linkable so ordinary core can load; file-seq takes its
;; portable __dir?/__list-dir branch for Coil-owned values.
(define (jolt-host-call method target) (jolt-nil-value))
(define (record-method-dispatch method target args) (jolt-nil-value))
(define (jolt-peek xs)
  (if (vector? xs)
      (if (= (vector-length xs) 0) (jolt-nil-value)
        (vector-ref xs (- (vector-length xs) 1)))
      (if (null? xs) (jolt-nil-value) (car xs))))
(define (jolt-vector-pop-list xs)
  (if (null? (cdr xs)) (list)
    (cons (car xs) (jolt-vector-pop-list (cdr xs)))))
(define (jolt-pop xs)
  (if (vector? xs)
      (if (= (vector-length xs) 0) (jolt-nil-value)
        (list->vector (jolt-vector-pop-list (vector->list xs))))
      (if (null? xs) (jolt-nil-value) (cdr xs))))
(define (jolt-last xs)
  (if (vector? xs) (jolt-peek xs)
    (if (null? xs) (jolt-nil-value)
      (if (null? (cdr xs)) (car xs) (jolt-last (cdr xs))))))
(define (jolt-reverse xs)
  (let ((s (jolt-seq xs)))
    (if (jolt-nil? s) (list) (reverse s))))

;; Jolt passes clojure.core/+ as a runtime value to reduce. Return a managed
;; binary procedure rather than exposing a native Scheme defn as an i64 value.
(define (jolt-add-value) (lambda xs (apply + xs)))
(define (jolt-rest-seq xs)
  (if (null? xs) (jolt-nil-value) xs))
;; Coil managed closures already record their variadic ABI. Jolt's host-side
;; registry exists for Schemes that cannot inspect it directly, so registration
;; is an identity operation on this target.
(define (jolt-register-variadic! fixed proc) proc)

(define (jolt-reduce-list f acc xs)
  (if (null? xs) acc
    (jolt-reduce-list f (jolt-invoke2 f acc (car xs)) (cdr xs))))
(define (jolt-reduce-vector f acc xs i n)
  (if (= i n) acc
    (jolt-reduce-vector f
      (jolt-invoke2 f acc (vector-ref xs i)) xs (+ i 1) n)))
(define (jolt-reduce f init xs)
  (if (vector? xs)
    (jolt-reduce-vector f init xs 0 (vector-length xs))
    (jolt-reduce-list f init xs)))
(define (jolt-reduce2 f xs)
  (let ((s (jolt-seq xs)))
    (if (jolt-nil? s) (jolt-invoke0 f)
      (jolt-reduce f (jolt-first s) (jolt-rest s)))))

(define (jolt-map-list f xs)
  (if (null? xs) (list)
    (cons (jolt-invoke1 f (car xs)) (jolt-map-list f (cdr xs)))))
(define (jolt-map-vector f xs i n)
  (if (= i n) (list)
    (cons (jolt-invoke1 f (vector-ref xs i))
          (jolt-map-vector f xs (+ i 1) n))))
(define (jolt-map f xs)
  (if (vector? xs)
    (jolt-map-vector f xs 0 (vector-length xs))
    (jolt-map-list f xs)))
(define (jolt-into target xs) (jolt-reduce (jolt-conj-value) target xs))
(define (jolt-into-value) (lambda (target xs) (jolt-into target xs)))
(define (jolt-map2 f xs ys)
  (if (or (null? xs) (null? ys)) (list)
    (cons (jolt-invoke2 f (car xs) (car ys))
      (jolt-map2 f (cdr xs) (cdr ys)))))
(define (jolt-map3 f xs ys zs)
  (if (or (null? xs) (or (null? ys) (null? zs))) (list)
    (cons (jolt-invoke3 f (car xs) (car ys) (car zs))
      (jolt-map3 f (cdr xs) (cdr ys) (cdr zs)))))
(define (jolt-any-empty? colls)
  (if (null? colls) #f
    (if (null? (car colls)) #t (jolt-any-empty? (cdr colls)))))
(define (jolt-cars colls)
  (if (null? colls) (list)
    (cons (car (car colls)) (jolt-cars (cdr colls)))))
(define (jolt-cdrs colls)
  (if (null? colls) (list)
    (cons (cdr (car colls)) (jolt-cdrs (cdr colls)))))
(define (jolt-map-many f colls)
  (if (or (null? colls) (jolt-any-empty? colls)) (list)
    (cons (jolt-invoke-list f (jolt-cars colls))
      (jolt-map-many f (jolt-cdrs colls)))))
(define (jolt-map-value)
  (lambda (f . colls) (jolt-map-many f colls)))
(define (jolt-filter f xs)
  (if (null? xs) (list)
    (let ((x (car xs)))
      (if (jolt-truthy? (jolt-invoke1 f x))
        (cons x (jolt-filter f (cdr xs)))
        (jolt-filter f (cdr xs))))))
(define (jolt-filter-value) (lambda (f xs) (jolt-filter f xs)))
(define (jolt-range-from i end)
  (if (= i end) (list)
    (cons i (jolt-range-from (+ i 1) end))))
(define (jolt-range end) (jolt-range-from 0 end))
(define (jolt-odd-value) (lambda (n) (= (remainder n 2) 1)))
(define (jolt-symbol ns name) (string->symbol name))
(define (keyword ns name)
  (string->symbol
    (if ns (string-append ":" ns "/" name) (string-append ":" name))))
(define (jolt-hash-map0) (list))
(define (jolt-hash-map2 k1 v1) (list (cons k1 v1)))
(define (jolt-hash-map4 k1 v1 k2 v2)
  (list (cons k1 v1) (cons k2 v2)))
(define (jolt-hash-map6 k1 v1 k2 v2 k3 v3)
  (list (cons k1 v1) (cons k2 v2) (cons k3 v3)))
(define (jolt-hash-map8 k1 v1 k2 v2 k3 v3 k4 v4)
  (list (cons k1 v1) (cons k2 v2) (cons k3 v3) (cons k4 v4)))
(define (jolt-hash-map-from-list xs)
  (if (null? xs) (list)
    (cons (cons (car xs) (car (cdr xs)))
      (jolt-hash-map-from-list (cdr (cdr xs))))))
(define (jolt-hash-map-fn-value)
  (lambda xs (jolt-hash-map-from-list xs)))
(define (host-new class message)
  (cons message (jolt-hash-map2 (keyword #f "class") class)))
(define (jolt-set-tag) (string->symbol "jolt.runtime/set"))
(define (jolt-hash-set0) (vector (jolt-set-tag)))
(define (jolt-hash-set1 a) (vector (jolt-set-tag) a))
(define (jolt-hash-set2 a b) (vector (jolt-set-tag) a b))
(define (jolt-hash-set3 a b c) (vector (jolt-set-tag) a b c))
(define (jolt-hash-set4 a b c d) (vector (jolt-set-tag) a b c d))
(define (jolt-hash-set-from-list xs)
  (list->vector (cons (jolt-set-tag) xs)))
(define (jolt-hash-set-value)
  (lambda xs (jolt-hash-set-from-list xs)))
(define (jolt-set? x)
  (and (vector? x)
       (> (vector-length x) 0)
       (eq? (vector-ref x 0) (jolt-set-tag))))
(define (jolt-set-contains-at? s x i n)
  (if (= i n) #f
    (if (jolt=2 (vector-ref s i) x) #t
      (jolt-set-contains-at? s x (+ i 1) n))))
(define (jolt-set-contains? s x)
  (jolt-set-contains-at? s x 1 (vector-length s)))
(define (jolt-set-every-in? a b i n)
  (if (= i n) #t
    (if (jolt-set-contains? b (vector-ref a i))
      (jolt-set-every-in? a b (+ i 1) n)
      #f)))
(define (jolt-set-equal? a b)
  (and (= (vector-length a) (vector-length b))
       (jolt-set-every-in? a b 1 (vector-length a))))
(define (jolt-set-conj s x)
  (if (jolt-set-contains? s x) s
    (list->vector (append (vector->list s) (list x)))))
(define (jolt-set-disj-list xs x)
  (if (null? xs) (list)
    (if (jolt=2 (car xs) x)
      (jolt-set-disj-list (cdr xs) x)
      (cons (car xs) (jolt-set-disj-list (cdr xs) x)))))
(define (core-disj2 s x)
  (list->vector
    (cons (jolt-set-tag)
      (jolt-set-disj-list (cdr (vector->list s)) x))))
(define (jolt-contains? coll key)
  (if (jolt-set? coll) (jolt-set-contains? coll key)
    (if (vector? coll)
      (and (integer? key) (>= key 0) (< key (vector-length coll)))
      (if (string? coll)
        (and (integer? key) (>= key 0) (< key (string-length coll)))
        (if (assoc key coll) #t #f)))))
(define (jolt-get m k)
  (let ((entry (assoc k m)))
    (if entry (cdr entry) (jolt-nil-value))))
(define (jolt-get-value) (lambda (m k) (jolt-get m k)))
(define (jolt-get3 m k fallback)
  (let ((entry (assoc k m)))
    (if entry (cdr entry) fallback)))
(define (jolt-find2 m k)
  (let ((entry (assoc k m)))
    (if entry (vector (car entry) (cdr entry)) (jolt-nil-value))))
(define (jolt-keys m)
  (if (null? m) (list)
    (cons (car (car m)) (jolt-keys (cdr m)))))
(define (jolt-vals m)
  (if (null? m) (list)
    (cons (cdr (car m)) (jolt-vals (cdr m)))))
(define (jolt-assoc-list m k v)
  (if (null? m) (list (cons k v))
    (if (equal? (car (car m)) k)
      (cons (cons k v) (cdr m))
      (cons (car m) (jolt-assoc-list (cdr m) k v)))))
(define (jolt-assoc3 m k v) (jolt-assoc-list m k v))
(define (jolt-assoc-value) (lambda (m k v) (jolt-assoc3 m k v)))
(define (jolt-map-merge target entries)
  (if (null? entries) target
    (jolt-map-merge
      (jolt-assoc3 target (car (car entries)) (cdr (car entries)))
      (cdr entries))))
(define (jolt-dissoc2 m k)
  (if (null? m) (list)
    (if (equal? (car (car m)) k) (cdr m)
      (cons (car m) (jolt-dissoc2 (cdr m) k)))))
(define (image-register-fn-form! name form ns free-names) #f)

(define (core-str-value x)
  (if (jolt-nil? x) ""
  (if (string? x) x
    (if (number? x) (number->string x)
      (if (eq? x #t) "true"
        (if (eq? x #f) "false" ""))))))
(define (core-str-fold xs out)
  (if (null? xs) out
    (core-str-fold (cdr xs) (string-append out (core-str-value (car xs))))))
(define (core-str . xs) (core-str-fold xs ""))

(define (core-println-items xs first?)
  (if (null? xs) #f
    (begin
      (if first? #f (display " "))
      (display (core-str-value (car xs)))
      (core-println-items (cdr xs) #f))))
(define (core-println . xs)
  (begin (core-println-items xs #t) (newline) #f))

(define (core-symbol? x) (symbol? x))
(define (core-string? x) (string? x))
(define (core-vector? x) (vector? x))
(define (core-number? x) (number? x))
(define (core-map? x)
  (if (null? x) #t
    (if (pair? x) (pair? (car x)) #f)))
(define (core-map-entry? x) (pair? x))
(define (core-meta x) (jolt-nil-value))
(define (core-with-meta x metadata) x)
(define (core-sq1 x) (list x))
(define (core-sqcat-fold parts out)
  (if (null? parts) out
    (core-sqcat-fold (cdr parts) (append out (car parts)))))
(define (core-sqcat . parts) (core-sqcat-fold parts (list)))

;; Single-threaded var roots. The outer pair gives us one stable, traced cell;
;; entries are mutable key/value pairs so redefining a var preserves its lookup
;; identity without relying on Scheme local `set!` support.
(define jolt-var-roots (cons (list) #f))
(define (jolt-var-key ns name) (string-append ns "/" name))
(define (jolt-var-entry ns name)
  (assoc (jolt-var-key ns name) (car jolt-var-roots)))
(define (def-var-with-meta! ns name value meta)
  (let ((entry (jolt-var-entry ns name)))
    (if entry
      (set-cdr! entry value)
      (set-car! jolt-var-roots
        (cons (cons (jolt-var-key ns name) value) (car jolt-var-roots))))
    value))
(define (def-var! ns name value)
  (def-var-with-meta! ns name value (jolt-nil-value)))
(define (declare-var! ns name)
  (let ((entry (jolt-var-entry ns name)))
    (if entry (cdr entry)
      (def-var! ns name (jolt-nil-value)))))
;; Macro identity is compiler metadata. Seed loading needs to retain the var;
;; the current host-side compiler path still performs macroexpansion in Jolt.
(define (mark-macro! ns name) #f)
(define (set-var-meta! ns name meta) meta)

;; This is deliberately a real namespace/name dispatch point, even though only
;; the first core var is installed. Unknown vars return #f until the registry is
;; expanded into mutable Jolt var cells.
(define (var-deref ns name)
  (let ((entry (jolt-var-entry ns name)))
    (if entry (cdr entry)
      (if (string=? ns "clojure.core")
        (if (string=? name "str") core-str
          (if (string=? name "println") core-println
            (if (string=? name "disj") core-disj2
              (if (string=? name "symbol?") core-symbol?
                (if (string=? name "string?") core-string?
                  (if (string=? name "vector?") core-vector?
                    (if (string=? name "number?") core-number?
                      (if (string=? name "map?") core-map?
                      (if (string=? name "map-entry?") core-map-entry?
                      (if (string=? name "meta") core-meta
                        (if (string=? name "with-meta") core-with-meta
                          (if (string=? name "__sq1") core-sq1
                            (if (string=? name "__sqcat") core-sqcat
                              (jolt-nil-value)))))))))))))
        (jolt-nil-value))))))
