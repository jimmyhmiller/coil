(module jolt.coil.expression-runtime)
(import "coil.scheme.stdproc" :as stdproc)

;; Jolt's emitted invocation ABI dispatches managed Scheme procedure values.
;; These are macros so an arbitrary expression can occupy the procedure slot;
;; Coil's Scheme surface normally recognizes only lexical-variable calls.
(defn jolt-invoke0 [(f Code)] (-> Code)
  `(stdproc/call--0 ~f))
(defn jolt-invoke1 [(f Code) (a Code)] (-> Code)
  `(stdproc/call--1 ~f ~a))
(defn jolt-invoke2 [(f Code) (a Code) (b Code)] (-> Code)
  `(stdproc/call--2 ~f ~a ~b))
(defn jolt-invoke3 [(f Code) (a Code) (b Code) (c Code)] (-> Code)
  `(stdproc/call--3 ~f ~a ~b ~c))
(defn jolt-invoke4 [(f Code) (a Code) (b Code) (c Code) (d Code)] (-> Code)
  `(stdproc/call--4 ~f ~a ~b ~c ~d))
(defn jolt-invoke5 [(f Code) (a Code) (b Code) (c Code) (d Code) (e Code)] (-> Code)
  `(stdproc/call--5 ~f ~a ~b ~c ~d ~e))
(defn jolt-invoke6 [(f Code) (a Code) (b Code) (c Code) (d Code) (e Code) (g Code)] (-> Code)
  `(stdproc/call--6 ~f ~a ~b ~c ~d ~e ~g))
(defn jolt-invoke-list [(f Code) (args Code)] (-> Code)
  `(stdproc/scm-apply-list ~f ~args))
