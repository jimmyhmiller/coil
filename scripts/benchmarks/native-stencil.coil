(module benchmark.native-stencil)
(import "coil.primitive" :as p)
(import "coil.args" :as args)
(import "coil.cc" :as cc)

(extern printf :cc (cc/C) [(ptr i8) ...] (-> i32))

; A periodic three-point integer stencil. Each pass depends on the previous
; pass, but cells within a pass are independent: a normal loop-vectorization
; opportunity. Unsigned arithmetic wraps identically on all backends.
(defn stencil :inline (Never) [(passes i64) (seed u32)] (-> u64)
  (let [first (p/alloc-stack (array u32 16384))
        second (p/alloc-stack (array u32 16384))
        (mut src) (p/cast (ptr u32) first)
        (mut dst) (p/cast (ptr u32) second)
        (mut i) 0
        (mut round) 0]
    (while (< i 16384)
      (store! (p/index src i)
              (p/ixor seed (p/imul (p/cast u32 i) (: 2654435761 u32))))
      (set! i (+ i 1)))
    (while (< round passes)
      (store! (p/index dst 0)
              (p/iadd (load (p/index src 16383))
                      (p/iadd (p/imul (load (p/index src 0)) (: 2 u32))
                              (load (p/index src 1)))))
      (set! i 1)
      (while (< i 16383)
        (store! (p/index dst i)
                (p/iadd (load (p/index src (- i 1)))
                        (p/iadd (p/imul (load (p/index src i)) (: 2 u32))
                                (load (p/index src (+ i 1))))))
        (set! i (+ i 1)))
      (store! (p/index dst 16383)
              (p/iadd (load (p/index src 16382))
                      (p/iadd (p/imul (load (p/index src 16383)) (: 2 u32))
                              (load (p/index src 0)))))
      (let [old src] (set! src dst) (set! dst old))
      (set! round (+ round 1)))
    ; Position weighting keeps the observable result sensitive to cell contents,
    ; rather than only the conserved sum of a periodic stencil.
    (let [(mut checksum) (: 0 u64)]
      (set! i 0)
      (while (< i 16384)
        (set! checksum
              (p/iadd checksum
                      (p/imul (p/cast u64 (load (p/index src i)))
                              (p/cast u64 (+ i 1)))))
        (set! i (+ i 1)))
      checksum)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (let [passes (args/int "--iterations" 10000)
        seed (args/int "--seed" 12345)]
    (if (<= passes 0)
        2
        (do (printf c"%llu\n" (stencil passes (p/cast u32 seed))) 0))))
