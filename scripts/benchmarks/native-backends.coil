(module benchmark.native-backends)
(import "coil.primitive" :as p)
(import "coil.args" :as args)
(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "coil.time" :as time)
(import "coil.subprocess" :as process)
(import "coil.cancellation" :as cancellation)
(import "coil.cc" :as cc)

(extern printf :cc (cc/C) [(ptr i8) ...] (-> i32))

(extern fflush :cc (cc/C) [(ptr i8)] (-> i32))

(defn fail [(message (slice u8))] (-> never)
  (printf c"ERROR: %.*s\n" (p/cast i32 (len message)) (data message))
  (fflush (p/cast (ptr i8) 0))
  (args/exit-now (: 1 i32)))

(defn now [] (-> i64)
  (match (time/monotonic-now)
    (Err [_] (fail "monotonic clock failed"))
    (Ok [t] (+ (* (.sec t) 1000000000) (.nsec t)))))

(defn invoke [(program (slice u8))
              (argv (slice (slice u8)))
              (result (ptr process/RunResult))] (-> i64)
  (let [timeout
          (match (time/Duration::seconds 120)
            (Ok [x] x)
            (Err [_] (fail "duration")))
        deadline
          (match (time/Instant::from-now timeout)
            (Ok [x] x)
            (Err [_] (fail "deadline")))
        grace
          (match (time/Duration::millis 100)
            (Ok [x] x)
            (Err [_] (fail "grace")))
        settings
          (process/RunOptions::new program
                                   argv
                                   ""
                                   1048576
                                   1048576
                                   (Some deadline)
                                   (p/cast (ptr cancellation/Cancellation) 0)
                                   grace)
        start (now)]
    (match (process/run (alloc/malloc-allocator) result settings)
      (Err [_] (fail "subprocess failed to start"))
      (Ok [_] 0))
    (let [elapsed (- (now) start)]
      (when (or (.timed-out result)
                (.cancelled result)
                (.stdout-truncated result)
                (.stderr-truncated result)
                (match (.status result)
                  (process/Exited [code] (!= code 0))
                  (process/Signaled [_] true)))
        (printf c"command: %.*s\n%.*s%.*s"
                (p/cast i32 (len program))
                (data program)
                (p/cast i32 (len (.stdout result)))
                (data (.stdout result))
                (p/cast i32 (len (.stderr result)))
                (data (.stderr result)))
        (fail "command did not complete successfully"))
      elapsed)))

(defn path [(directory (slice u8)) (name (slice u8))] (-> (slice u8))
  (match (str/concat3 (alloc/malloc-allocator) directory "/" name)
    (Some [s] s)
    (None [] (fail "path allocation"))))

(defn backend [(i i64)] (-> (slice u8))
  (case i 0 "llvm" 1 "tpde" 2 "stogir" (fail "backend index")))

(defn record [(phase (slice u8)) (engine i64) (sample i64) (ns i64)] (-> i64)
  (let [name (backend engine)]
    (printf c"%.*s,%.*s,%lld,%lld\n"
            (p/cast i32 (len phase))
            (data phase)
            (p/cast i32 (len name))
            (data name)
            sample
            ns)
    (fflush (p/cast (ptr i8) 0))
    0))

(defn metadata [(program (slice u8)) (argv (slice (slice u8)))] (-> void)
  (let [result (p/alloc-stack process/RunResult)]
    (invoke program argv result)
    (when (> (len (.stderr result)) 0) (fail "metadata command wrote stderr"))
    (let [text (.stdout result)
          (mut start) 0]
      (for [i 0 (len text)]
        (when (= (get text i) (: 10 u8))
          (printf c"# %.*s\n"
                  (p/cast i32 (- i start))
                  (p/index (data text) start))
          (set! start (+ i 1))))
      (when (< start (len text))
        (printf c"# %.*s\n"
                (p/cast i32 (- (len text) start))
                (p/index (data text) start))))
    (process/RunResult::free (alloc/malloc-allocator) result)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (let [compiler (args/value "--compiler")
        source (args/value "--source")
        directory (args/value "--output")
        samples (args/int "--samples" 7)
        iterations (args/value "--iterations")
        objects (p/alloc-stack (array (slice u8) 3))
        programs (p/alloc-stack (array (slice u8) 3))
        command (p/alloc-stack (array (slice u8) 12))
        command-ptr (p/cast (ptr (slice u8)) command)
        result (p/alloc-stack process/RunResult)
        baseline (p/alloc-stack process/RunResult)]
    (when (or (= (len compiler) 0)
              (= (len source) 0)
              (= (len directory) 0)
              (= (len iterations) 0)
              (< samples 1)
              (> samples 99))
      (fail "required: --compiler PATH --source PATH --output EXISTING-DIRECTORY --iterations N [--samples 7]"))
    (printf c"# warmup sample 0 excluded; rotating backend order; -O3 --no-debug; elapsed nanoseconds include subprocess startup\n")
    (store! (p/index command 0) "--version")
    (metadata compiler (slice::new command-ptr 1))
    (store! (p/index command 0) "-a")
    (metadata "/usr/bin/uname" (slice::new command-ptr 1))
    (store! (p/index command 1) "256")
    (store! (p/index command 2) compiler)
    (store! (p/index command 3) source)
    (metadata "/usr/bin/shasum" (slice::new command-ptr 4))
    (printf c"# iterations=%.*s seed=12345 samples=%lld\n"
            (p/cast i32 (len iterations))
            (data iterations)
            samples)
    (printf c"phase,backend,sample,elapsed_ns\n")
    (let [(mut i) 0]
      (while (< i 3)
        (store! (p/index programs i) (path directory (backend i)))
        (store! (p/index objects i)
                (path directory (case i 0 "llvm.o" 1 "tpde.o" "stogir.o")))
        (set! i (+ i 1))))
    ; Finish each round before rotating the first engine. Every compiler emits
    ; exactly the same source and options; system cc performs the separate link.
    (let [(mut round) 0]
      (while (<= round samples)
        (let [(mut turn) 0]
          (while (< turn 3)
            (let [engine (% (+ round turn) 3)
                  object (load (p/index objects engine))
                  executable (load (p/index programs engine))]
              (store! (p/index command 0) "emit-obj")
              (store! (p/index command 1) source)
              (store! (p/index command 2) "--backend")
              (store! (p/index command 3) (backend engine))
              (store! (p/index command 4) "-O3")
              (store! (p/index command 5) "--no-debug")
              (store! (p/index command 6) "-o")
              (store! (p/index command 7) object)
              (record "compile"
                      engine
                      round
                      (invoke compiler (slice::new command-ptr 8) result))
              (when (or (not (str/starts-with (.stdout result) "wrote "))
                        (> (len (.stderr result)) 0))
                (printf c"stdout=[%.*s] stderr=[%.*s]\n"
                        (p/cast i32 (len (.stdout result)))
                        (data (.stdout result))
                        (p/cast i32 (len (.stderr result)))
                        (data (.stderr result)))
                (fail "compiler emitted unexpected diagnostics"))
              (process/RunResult::free (alloc/malloc-allocator) result)
              (store! (p/index command 0) object)
              (store! (p/index command 1) "-o")
              (store! (p/index command 2) executable)
              (store! (p/index command 3) "-lm")
              (record "link"
                      engine
                      round
                      (invoke "cc" (slice::new command-ptr 4) result))
              (process/RunResult::free (alloc/malloc-allocator) result)
              (store! (p/index command 0) "--iterations")
              (store! (p/index command 1) iterations)
              (store! (p/index command 2) "--seed")
              (store! (p/index command 3) "12345")
              (if (and (= round 0) (= engine 0))
                  (do
                    (record "run"
                            engine
                            round
                            (invoke executable
                                    (slice::new command-ptr 4)
                                    baseline))
                    (when (or (= (len (.stdout baseline)) 0)
                              (> (len (.stderr baseline)) 0))
                      (fail "missing baseline output"))
                    (printf c"# checksum=%.*s"
                            (p/cast i32 (len (.stdout baseline)))
                            (data (.stdout baseline))))
                  (do
                    (record "run"
                            engine
                            round
                            (invoke executable
                                    (slice::new command-ptr 4)
                                    result))
                    (when (or (!= (.stdout baseline) (.stdout result))
                              (> (len (.stderr result)) 0))
                      (fail "backend output differs from LLVM baseline"))
                    (process/RunResult::free (alloc/malloc-allocator) result))))
            (set! turn (+ turn 1))))
        (set! round (+ round 1))))
    (process/RunResult::free (alloc/malloc-allocator) baseline)
    (let [(mut i) 0]
      (while (< i 3)
        (alloc/free [u8] (alloc/malloc-allocator) (load (p/index objects i)))
        (alloc/free [u8] (alloc/malloc-allocator) (load (p/index programs i)))
        (set! i (+ i 1))))
    0))
