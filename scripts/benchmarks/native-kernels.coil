(module benchmark.native-kernels)
(import "coil.primitive" :as p)
(import "coil.args" :as args)
(import "coil.cc" :as cc)

(extern printf :cc (cc/C) [(ptr i8) ...] (-> i32))

; Inputs come from argv. Each iteration depends on the preceding one; the output
; keeps the work observable and lets the harness compare complete results.
(defn integer-kernel :inline (Never) [(n i64) (seed u64)] (-> u64)
  (let [(mut x) seed
        (mut i) 0]
    (while (< i n)
      (set! x (p/ixor x (p/ishl x 13)))
      (set! x (p/ixor x (p/ishr x 7)))
      (set! x (p/ixor x (p/ishl x 17)))
      (set! i (+ i 1)))
    x))

(defn memory-kernel :inline (Never) [(n i64) (seed u64)] (-> u64)
  (let [memory (p/alloc-stack (array u64 4096))
        (mut i) 0
        (mut x) seed]
    (while (< i 4096)
      (store! (p/index memory i) (p/cast u64 (+ i 1)))
      (set! i (+ i 1)))
    (set! i 0)
    (while (< i n)
      (let [at (p/cast i64 (p/iand x (: 4095 u64)))
            value (load (p/index memory at))]
        (set! x
              (p/iadd (p/imul (p/ixor x value) (: 6364136223846793005 u64))
                      (: 1 u64)))
        (store! (p/index memory at) x))
      (set! i (+ i 1)))
    x))

(defn float-kernel :inline (Never) [(n i64) (seed f64)] (-> f64)
  (let [(mut x) seed
        (mut y) (: 0.25 f64)
        (mut i) 0]
    (while (< i n)
      (set! x (+ (* x (: 0.9999999 f64)) (* y (: 0.0000001 f64))))
      (set! y (+ (* y (: 0.9999998 f64)) (* x (: 0.0000002 f64))))
      (set! i (+ i 1)))
    (+ x y)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (let [n (args/int "--iterations" 20000000)
        seed (args/int "--seed" 12345)]
    (if (<= n 0)
        2
        (do
          (printf c"%llu,%llu,%.17g\n"
                  (integer-kernel n (p/cast u64 seed))
                  (memory-kernel n (p/cast u64 seed))
                  (float-kernel n (p/cast f64 seed)))
          0))))
