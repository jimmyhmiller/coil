(module examples.kvserver.store-test)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.arraylist" :use [al-free!])
(import "coil.debug-allocator"
        :use
        [debug-allocator-init debug-allocator-view debug-allocator-deinit!])
(import "coil.prop" :use *)
(import "coil.result" :use [none?])
(import "examples.kvserver.store" :use *)

;; Option has no Eq impl, so lookups are compared through this.
(defn holds? [(store (ref Store)) (key (slice u8)) (value (slice u8))] (-> bool)
  (match (lookup store key)
    (Some [stored] (= stored value))
    (None [] false)))

(deftest put-reports-insert-then-replace
         (let [(mut store) (Store::new (malloc-allocator))]
           (assert-eq (put! (mut store) "k" "one") (Inserted))
           (assert-eq (put! (mut store) "k" "two") (Replaced))
           (assert (holds? store "k" "two"))
           (assert (none? (lookup store "missing")))))

(deftest put-copies-the-callers-bytes
         (let [(mut store) (Store::new (malloc-allocator))
               (mut key) (: [#\a #\b] (array u8 2))
               (mut value) (: [#\x #\y] (array u8 2))]
           (put! (mut store) key value)
           (set! (mut key) 0 #\z)
           (set! (mut value) 0 #\z)
           (assert (holds? store "ab" "xy"))
           (assert (none? (lookup store "zb")))))

(deftest delete-removes-only-present-keys
         (let [(mut store) (Store::new (malloc-allocator))]
           (put! (mut store) "k" "v")
           (assert (delete! (mut store) "k"))
           (assert (not (delete! (mut store) "k")))
           (assert (none? (lookup store "k")))))

(deftest keys-come-back-sorted
         (let [a (malloc-allocator)
               (mut store) (Store::new a)]
           (for key
             ["pear" "apple" "fig" "apple-pie"]
             (put! (mut store) key "x"))
           (let [(mut keys) (sorted-keys store a)]
             (assert-eq (len keys) 4)
             (assert-eq (get keys 0) "apple")
             (assert-eq (get keys 1) "apple-pie")
             (assert-eq (get keys 2) "fig")
             (assert-eq (get keys 3) "pear")
             (al-free! (mut keys)))))

;; Every way a value leaves the store (replaced, deleted, dropped with the store)
;; frees it, and the map frees its keys.
(defn churn [(a (dyn Allocator))] (-> void)
  (let [(mut store) (Store::new a)]
    (put! (mut store) "kept" "first")
    (put! (mut store) "kept" "second")
    (put! (mut store) "gone" "value")
    (delete! (mut store) "gone")
    (put! (mut store) "empty" "")))

(deftest the-store-frees-everything-it-owns
         (let [debug (debug-allocator-init (malloc-allocator))]
           (churn (debug-allocator-view debug))
           (assert-eq (debug-allocator-deinit! debug) 0)))

(defprop the-last-put-wins
         [(key (slice u8)) (first (slice u8)) (second (slice u8))]
         (let [(mut store) (Store::new (malloc-allocator))]
           (put! (mut store) key first)
           (and (= (put! (mut store) key second) (Replaced))
                (holds? store key second))))
