(module examples.kvserver.handler-test)
(import "coil.alloc" :as alloc :use [malloc-allocator])
(import "coil.http.server" :as http)
(import "examples.kvserver.handler" :use [handle])
(import "examples.kvserver.response" :use *)
(import "examples.kvserver.store" :use [Store])

;; What the server answers to `raw`, minus the socket.
(defn answer [(store (mut Store)) (raw (slice u8))] (-> Response)
  (let [a (malloc-allocator)]
    (try (let [request
                 (try-or! (http/parse-request a raw)
                          (error-response a (Malformed)))
               response (handle a (mut store) request)]
           (http/request-free request)
           response))))

(defn seeded [] (-> Store)
  (let [(mut store) (Store::new (malloc-allocator))]
    (put! (mut store) "b" "bee")
    (put! (mut store) "a" "ay")
    store))

(deftest put-creates-then-replaces
  (let [(mut store) (Store::new (malloc-allocator))
        created
          (answer (mut store)
                  "PUT /kv/k HTTP/1.1\r\nContent-Length: 3\r\n\r\none")
        replaced
          (answer (mut store)
                  "PUT /kv/k HTTP/1.1\r\nContent-Length: 3\r\n\r\ntwo")
        fetched (answer (mut store) "GET /kv/k HTTP/1.1\r\n\r\n")]
    (assert-eq (.status created) (Created))
    (assert-eq (.status replaced) (Success))
    (assert-eq (.status fetched) (Success))
    (assert-eq (.body fetched) "two")))

(deftest a-chunked-body-is-stored-decoded
  (let [(mut store) (Store::new (malloc-allocator))
        put
          (answer (mut store)
                  "PUT /kv/c HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n1\r\n!\r\n0\r\n\r\n")
        fetched (answer (mut store) "GET /kv/c HTTP/1.1\r\n\r\n")]
    (assert-eq (.status put) (Created))
    (assert-eq (.body fetched) "hello!")))

(deftest get-of-a-missing-key-is-not-found
  (let [(mut store) (seeded)
        response (answer (mut store) "GET /kv/zzz HTTP/1.1\r\n\r\n")]
    (assert-eq (.status response) (NotFound))
    (assert-eq (.body response) "no such key: zzz\n")))

(deftest delete-is-no-content-then-not-found
  (let [(mut store) (seeded)
        first (answer (mut store) "DELETE /kv/a HTTP/1.1\r\n\r\n")
        second (answer (mut store) "DELETE /kv/a HTTP/1.1\r\n\r\n")
        listing (answer (mut store) "GET /kv HTTP/1.1\r\n\r\n")]
    (assert-eq (.status first) (NoContent))
    (assert-eq (.body first) "")
    (assert-eq (.status second) (NotFound))
    (assert-eq (.body listing) "b\n")))

(deftest the-collection-lists-sorted-keys
  (let [(mut store) (seeded)
        (mut empty) (Store::new (malloc-allocator))
        listing (answer (mut store) "GET /kv HTTP/1.1\r\n\r\n")
        nothing (answer (mut empty) "GET /kv HTTP/1.1\r\n\r\n")]
    (assert-eq (.status listing) (Success))
    (assert-eq (.body listing) "a\nb\n")
    (assert-eq (.status nothing) (Success))
    (assert-eq (.body nothing) "")))

(deftest other-methods-name-the-allowed-ones
  (let [(mut store) (seeded)
        on-collection
          (answer (mut store)
                  "POST /kv HTTP/1.1\r\nContent-Length: 0\r\n\r\n")
        on-entry (answer (mut store) "HEAD /kv/a HTTP/1.1\r\n\r\n")]
    (assert-eq (.status on-collection) (MethodNotAllowed "GET"))
    (assert-eq (.status on-entry) (MethodNotAllowed "GET, PUT, DELETE"))))

(deftest bad-paths-keys-and-bytes
  (let [(mut store) (seeded)
        unknown (answer (mut store) "GET /elsewhere HTTP/1.1\r\n\r\n")
        empty-key
          (answer (mut store)
                  "PUT /kv/ HTTP/1.1\r\nContent-Length: 1\r\n\r\nx")
        garbage (answer (mut store) "NOT HTTP\r\n\r\n")]
    (assert-eq (.status unknown) (NotFound))
    (assert-eq (.status empty-key) (BadRequest))
    (assert-eq (.status garbage) (BadRequest))))

(deftest render-carries-allow-and-connection
  (let [a (malloc-allocator)
        not-allowed (error-response a (UnsupportedMethod "GET"))
        wire (render a not-allowed (Some "close"))]
    (assert-eq wire
               "HTTP/1.1 405 Method Not Allowed\r\nAllow: GET\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 13\r\n\r\nallowed: GET\n")
    (alloc/free a wire)))

(deftest render-omits-length-for-no-content
  (let [a (malloc-allocator)
        deleted (respond a (NoContent) [])
        wire (render a deleted (None))]
    (assert-eq wire "HTTP/1.1 204 No Content\r\n\r\n")
    (alloc/free a wire)))
