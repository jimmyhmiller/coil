(module examples.kvserver.route-test)
(import "coil.try" :use [try try-or!])
(import "examples.kvserver.response"
        :use
        [ApiError NoSuchResource UnsupportedMethod EmptyKey])
(import "examples.kvserver.route" :use *)

;; Option and Result have no Eq impl, so outcomes are compared through these.
(defn routes-to? [(method (slice u8)) (target (slice u8)) (expected Route)] (-> bool)
  (try (= (try-or! (parse-route method target) false) expected)))

(defn fails-with? [(method (slice u8)) (target (slice u8)) (expected ApiError)] (-> bool)
  (match (parse-route method target)
    (Ok [_] false)
    (Err [error] (= error expected))))

(deftest collection-lists-keys
         (assert (routes-to? "GET" "/kv" (ListKeys))))

(deftest entry-methods-name-the-key
         (assert (routes-to? "GET" "/kv/greeting" (FetchKey "greeting")))
         (assert (routes-to? "PUT" "/kv/greeting" (StoreKey "greeting")))
         (assert (routes-to? "DELETE" "/kv/greeting" (DeleteKey "greeting"))))

(deftest query-string-is-ignored
         (assert (routes-to? "GET" "/kv?pretty" (ListKeys)))
         (assert (routes-to? "GET" "/kv/a?x=1" (FetchKey "a"))))

(deftest keys-are-taken-verbatim
         (assert (routes-to? "GET" "/kv/a%20b" (FetchKey "a%20b")))
         (assert (routes-to? "GET" "/kv/KV" (FetchKey "KV"))))

(deftest other-methods-are-not-allowed
         (assert (fails-with? "POST" "/kv" (UnsupportedMethod "GET")))
         (assert (fails-with? "DELETE" "/kv" (UnsupportedMethod "GET")))
         (assert (fails-with? "POST"
                              "/kv/a"
                              (UnsupportedMethod "GET, PUT, DELETE")))
         (assert (fails-with? "get"
                              "/kv/a"
                              (UnsupportedMethod "GET, PUT, DELETE"))))

(deftest unknown-paths-are-not-found
         (assert (fails-with? "GET" "/" (NoSuchResource)))
         (assert (fails-with? "GET" "/kvx" (NoSuchResource)))
         (assert (fails-with? "GET" "/kv/a/b" (NoSuchResource)))
         (assert (fails-with? "POST" "/elsewhere" (NoSuchResource))))

(deftest an-empty-key-is-rejected
         (assert (fails-with? "GET" "/kv/" (EmptyKey)))
         (assert (fails-with? "PUT" "/kv/?x" (EmptyKey))))
