(module examples.kvserver.route-test)
(import "examples.kvserver.response"
        :use
        [NoSuchResource UnsupportedMethod EmptyKey])
(import "examples.kvserver.route" :use *)

(deftest collection-lists-keys
  (assert-eq (parse-route "GET" "/kv") (Ok (ListKeys))))

(deftest entry-methods-name-the-key
  (assert-eq (parse-route "GET" "/kv/greeting") (Ok (FetchKey "greeting")))
  (assert-eq (parse-route "PUT" "/kv/greeting") (Ok (StoreKey "greeting")))
  (assert-eq (parse-route "DELETE" "/kv/greeting") (Ok (DeleteKey "greeting"))))

(deftest query-string-is-ignored
  (assert-eq (parse-route "GET" "/kv?pretty") (Ok (ListKeys)))
  (assert-eq (parse-route "GET" "/kv/a?x=1") (Ok (FetchKey "a"))))

(deftest keys-are-taken-verbatim
  (assert-eq (parse-route "GET" "/kv/a%20b") (Ok (FetchKey "a%20b")))
  (assert-eq (parse-route "GET" "/kv/KV") (Ok (FetchKey "KV"))))

(deftest other-methods-are-not-allowed
  (assert-eq (parse-route "POST" "/kv") (Err (UnsupportedMethod "GET")))
  (assert-eq (parse-route "DELETE" "/kv") (Err (UnsupportedMethod "GET")))
  (assert-eq (parse-route "POST" "/kv/a")
             (Err (UnsupportedMethod "GET, PUT, DELETE")))
  (assert-eq (parse-route "get" "/kv/a")
             (Err (UnsupportedMethod "GET, PUT, DELETE"))))

(deftest unknown-paths-are-not-found
  (assert-eq (parse-route "GET" "/") (Err (NoSuchResource)))
  (assert-eq (parse-route "GET" "/kvx") (Err (NoSuchResource)))
  (assert-eq (parse-route "GET" "/kv/a/b") (Err (NoSuchResource)))
  (assert-eq (parse-route "POST" "/elsewhere") (Err (NoSuchResource))))

(deftest an-empty-key-is-rejected
  (assert-eq (parse-route "GET" "/kv/") (Err (EmptyKey)))
  (assert-eq (parse-route "PUT" "/kv/?x") (Err (EmptyKey))))
