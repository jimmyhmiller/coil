(module examples.kvserver.live-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.slice" :use [subslice])
(import "coil.socket" :as socket :use [TcpListener TcpConnection SocketError])
(import "coil.str" :use [StrBuf])
(import "coil.thread" :as thread)
(import "coil.time" :as time)
(import "examples.kvserver.server" :use [serve-connection! send-all!])
(import "examples.kvserver.store" :use [Store])

;; These tests run the real server code over a real loopback socket: the server
;; side on its own thread, accepting one connection and serving it with a fresh
;; store; the client side on the test's thread, sending every request and then
;; reading every response, to EOF. Each test closes its listener and both ends of
;; the connection and joins the server thread. Accepting and idling both time out,
;; so a failing test cannot leave anything listening or blocked.
(const IDLE-TIMEOUT (time/Duration :sec 1 :nsec 0))

;; What the server thread is given, and what it reports back.
(defstruct ServerThread
  [(listener (ptr TcpListener))
   (outcome (Result i64 SocketError))])

(defn run-server-thread [(arg (ptr i8))] (-> (ptr i8))
  (let [server (cast (ptr ServerThread) arg)
        a (malloc-allocator)
        (mut store) (Store::new a)
        (mut conn) (zeroed TcpConnection)]
    (defer (close! (mut conn)))
    (let [accepted (accept-for (.listener server) (mut conn) IDLE-TIMEOUT)]
      ;; Each test makes one connection. Closing the listener now also resets a
      ;; connection that was never accepted, so the client cannot wait forever.
      (close! (.listener server))
      (set! (.outcome server)
            (try
              (try! accepted)
              (serve-connection! a (mut store) (mut conn) IDLE-TIMEOUT))))
    arg))

(defn read-to-end! [(conn (ptr TcpConnection)) (out (mut StrBuf))]
  (-> (Result i64 SocketError))
  (let [(mut chunk) (zeroed (array u8 4096))]
    (try
      (loop (let [n
                    (try! (read conn
                                (cast (ptr i8) (mut chunk))
                                (len chunk)))]
              (if (= n 0)
                  (break)
                  (push-str! (mut out) (subslice chunk 0 n)))))
      (Ok 0))))

(defn client-side [(port i64) (requests (slice u8)) (transcript (mut StrBuf))]
  (-> (Result i64 SocketError))
  (let [(mut client) (zeroed TcpConnection)]
    (defer (close! (mut client)))
    (try
      (try! (socket/TcpConnection::connect (malloc-allocator)
                                           (mut client)
                                           "127.0.0.1"
                                           port))
      (try! (send-all! (mut client) requests))
      (read-to-end! (mut client) (mut transcript)))))

(defn converse [(listener (ptr TcpListener))
                (requests (slice u8))
                (transcript (mut StrBuf))] (-> (Result i64 SocketError))
  (try (let [port (try! (port listener))
             (mut server) (ServerThread :listener listener :outcome (Ok 0))
             (mut worker) (zeroed thread/Thread)]
         (assert-eq (thread/Thread::spawn (mut worker)
                                          (fnptr-of run-server-thread)
                                          (cast (ptr i8) (mut server)))
                    0)
         (let [client (client-side port requests (mut transcript))]
           (assert-eq (join (mut worker)) 0)
           (try! client)
           (.outcome server)))))

(defn exchange-over-socket [(requests (slice u8)) (transcript (mut StrBuf))]
  (-> (Result i64 SocketError))
  (let [(mut listener) (zeroed TcpListener)]
    (defer (close! (mut listener)))
    (try
      (try! (socket/TcpListener::listen (malloc-allocator)
                                        (mut listener)
                                        "127.0.0.1"
                                        0
                                        true
                                        1))
      (converse (mut listener) requests (mut transcript)))))

;; Everything the server sent back for `requests`, sent on one connection.
(defn transcript-of [(requests (slice u8))] (-> StrBuf)
  (let [(mut transcript) (StrBuf::new (malloc-allocator))]
    (when-let [(Err [error]) (exchange-over-socket requests (mut transcript))]
      (eprintln "socket error: {}" error)
      (assert false))
    transcript))

(defn joined [(parts (slice (slice u8)))] (-> StrBuf)
  (let [(mut out) (StrBuf::new (malloc-allocator))]
    (for part parts (push-str! (mut out) part))
    out))

;; Send `requests` on one connection and check the server answers with exactly
;; `responses`, then closes.
(defn assert-conversation [(requests (slice (slice u8)))
                           (responses (slice (slice u8)))] (-> void)
  (let [(mut sent) (joined requests)
        (mut expected) (joined responses)
        (mut received) (transcript-of (str sent))]
    (defer (free! (mut sent)))
    (defer (free! (mut expected)))
    (defer (free! (mut received)))
    (assert-eq (str received) (str expected))))

(deftest pipelined-put-get-delete-round-trip
  (assert-conversation ["PUT /kv/greeting HTTP/1.1\r\nHost: test\r\nContent-Length: 5\r\n\r\nhello"
                        "GET /kv/greeting HTTP/1.1\r\nHost: test\r\n\r\n"
                        "DELETE /kv/greeting HTTP/1.1\r\nHost: test\r\n\r\n"
                        "GET /kv/greeting HTTP/1.1\r\nHost: test\r\nConnection: close\r\n\r\n"]
                       ["HTTP/1.1 201 Created\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 0\r\n\r\n"
                        "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 5\r\n\r\nhello"
                        "HTTP/1.1 204 No Content\r\n\r\n"
                        "HTTP/1.1 404 Not Found\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 22\r\n\r\nno such key: greeting\n"]))

;; A value bigger than one read arrives over several, and is parsed as it comes.
(deftest a-value-spanning-many-reads-round-trips
  (let [(mut value) (StrBuf::new (malloc-allocator))]
    (for i (range 0 200000)
      (push-str! (mut value) (if (= (% i 64) 63) "\n" "v")))
    (assert-conversation ["PUT /kv/big HTTP/1.1\r\nContent-Length: 200000\r\n\r\n"
                          (str value)
                          "GET /kv/big HTTP/1.1\r\nConnection: close\r\n\r\n"]
                         ["HTTP/1.1 201 Created\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 0\r\n\r\n"
                          "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 200000\r\n\r\n"
                          (str value)])
    (free! (mut value))))

;; Nothing after unparseable bytes is answered: where a next request would start
;; is unknowable.
(deftest garbage-gets-a-400-and-the-connection-closes
  (assert-conversation ["BREW /pot HTCPCP/1.0\r\n\r\n"
                        "GET /kv HTTP/1.1\r\n\r\n"]
                       ["HTTP/1.1 400 Bad Request\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 23\r\n\r\nmalformed HTTP request\n"]))

;; HTTP/1.0 closes after each response unless the client asks to keep the connection.
(deftest http-1-0-closes-unless-asked-not-to
  (assert-conversation ["GET /kv HTTP/1.0\r\nConnection: keep-alive\r\n\r\n"
                        "GET /kv/x HTTP/1.0\r\n\r\n"
                        "GET /kv HTTP/1.0\r\n\r\n"]
                       ["HTTP/1.1 200 OK\r\nConnection: keep-alive\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 0\r\n\r\n"
                        "HTTP/1.1 404 Not Found\r\nConnection: close\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 15\r\n\r\nno such key: x\n"]))

;; A keep-alive client that goes quiet is hung up on after the idle timeout, so it
;; cannot hold a server that serves one connection at a time.
(deftest an-idle-keep-alive-connection-is-closed
  (assert-conversation ["GET /kv HTTP/1.1\r\nHost: test\r\n\r\n"]
                       ["HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 0\r\n\r\n"]))
