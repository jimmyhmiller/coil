(module examples.kvserver.store)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.mem" :use [mem-copy])
(import "coil.slice" :use [sort])
(import "coil.str" :use [str-keyops str-cmp])

;;; Whether `put!` added a new key or replaced the value of an existing one.
(defsum PutOutcome (Inserted) (Replaced))

(derive Debug Eq PutOutcome)

;;; An in-memory key-value store that owns every key and value it holds, so callers
;;; may reuse or free their buffers as soon as a call returns. The map copies keys
;;; itself (`str-keyops`); values are copied here and freed when they are replaced,
;;; deleted, or the store is dropped.
(defstruct Store
  [(allocator (dyn alloc/Allocator))
   (entries (HashMap (slice u8) (slice u8)))])

(defn copy-bytes [(a (dyn alloc/Allocator)) (bytes (slice u8))] (-> (slice u8))
  (if-let [(Some [owned]) (alloc/alloc [u8] a (len bytes))]
    (do
      (mem-copy (data owned) (data bytes) (len bytes))
      owned)
    (panic "kvserver: out of memory storing a {}-byte value" (len bytes))))

(impl Store
  ;;; An empty store whose keys and values are allocated from `a`.
  (new [(a (dyn alloc/Allocator))]
    (-> Store)
    (Store
      :allocator a
      :entries (HashMap::new [(slice u8) (slice u8)] a (str-keyops))))

  ;;; The value stored under `key`, borrowed: valid until the next `put!` or
  ;;; `delete!` of that key.
  (lookup [(store (ref Store)) (key (slice u8))]
    (-> (Option (slice u8)))
    (get (.entries store) key))

  ;;; Store a copy of `value` under `key`, freeing any value it replaces.
  (put! [(store (mut Store)) (key (slice u8)) (value (slice u8))]
    (-> PutOutcome)
    (let [previous (lookup store key)]
      (set! (mut (.entries store)) key (copy-bytes (.allocator store) value))
      (match previous
        (Some [old] (alloc/free (.allocator store) old) (Replaced))
        (None [] (Inserted)))))

  ;;; Remove `key` and free its value. False when the key was absent.
  (delete! [(store (mut Store)) (key (slice u8))]
    (-> bool)
    (if-let [(Some [old]) (lookup store key)]
      (do
        (remove! (mut (.entries store)) key)
        (alloc/free (.allocator store) old)
        true)
      false))

  ;;; Every key in ascending byte order, borrowed from the store. The caller frees
  ;;; the list (not the keys) with `free!`.
  (sorted-keys [(store (ref Store)) (a (dyn alloc/Allocator))]
    (-> (ArrayList (slice u8)))
    (let [(mut keys) (ArrayList::new [(slice u8)] a)]
      (for key (.entries store) (push! (mut keys) key))
      (sort (slice keys) (fnptr-of str-cmp))
      keys)))

(impl Drop Store
  (drop [(self (mut Store))]
    (-> void)
    (for key (.entries self)
      (when-let [(Some [value]) (lookup self key)]
        (alloc/free (.allocator self) value)))
    (free! (mut (.entries self)))))
