;;; kvserver: a tiny HTTP/1.1 key-value store.
;;;
;;;     coil run examples/kvserver            # listens on http://127.0.0.1:8040
;;;     coil run examples/kvserver -- 9000    # or on another port
;;;
;;;   GET    /kv          200, every key, one per line, in ascending order
;;;   GET    /kv/KEY      200 with the value, or 404
;;;   PUT    /kv/KEY      201 when the key is new, 200 when its value is replaced
;;;   DELETE /kv/KEY      204, or 404
;;;
;;; Any other path is 404; any other method on a known path is 405 with an `Allow`
;;; header; bytes that are not an HTTP request are 400, and the connection closes.
;;; Connections are served one at a time, keep-alive and pipelining included; one
;;; idle for 5 seconds is closed so it cannot hold the server.
;;;
;;;     $ curl -X PUT --data 'hello, world' http://127.0.0.1:8040/kv/greeting
;;;     $ curl http://127.0.0.1:8040/kv/greeting
;;;     hello, world
;;;     $ curl -i -X POST http://127.0.0.1:8040/kv
;;;     HTTP/1.1 405 Method Not Allowed
;;;     Allow: GET
;;;     ...
;;;
;;; The server logs each request line and its status:
;;;
;;;     kvserver listening on http://127.0.0.1:8040/kv
;;;     PUT /kv/greeting -> 201 Created
;;;     GET /kv/greeting -> 200 OK
;;;     POST /kv -> 405 Method Not Allowed
(module examples.kvserver.main)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.args" :use [args-set! args-count args-nth])
(import "coil.fmt" :use [fmt])
(import "coil.io" :use [stderr])
(import "coil.socket" :as socket :use [TcpListener])
(import "coil.str" :use [str-parse-int])
(import "coil.try" :use [try try?])
(import "coil.time" :as time)
(import "examples.kvserver.server" :use [serve! socket-error-text])
(import "examples.kvserver.store" :use [Store])

(const HOST "127.0.0.1")

(const DEFAULT-PORT 8040)

(def IDLE-TIMEOUT (time/Duration :sec 5 :nsec 0))

(const LISTEN-BACKLOG 16)

;;; A TCP port number other than 0, which would ask for an ephemeral port.
(defn parse-port [(text (slice u8))] (-> (Option i64))
  (try (let [port (try? (str-parse-int text))]
         (if (and (> port 0) (<= port 65535)) (Some port) (None)))))

;;; The port named by the only argument, or the default without one.
(defn port-from-args [] (-> (Option i64))
  (cond (= (args-count) 1) (Some DEFAULT-PORT)
        (= (args-count) 2) (parse-port (args-nth 1))
        :else (None)))

(defn run [(port i64) (idle time/Duration)] (-> i64)
  (let [a (malloc-allocator)
        (mut listener) (zeroed TcpListener)
        (mut store) (Store::new a)]
    (match (socket/tcp-listen a (mut listener) HOST port true LISTEN-BACKLOG)
      (Err [error]
           (do
             (fmt (stderr)
                  "kvserver: cannot listen on {}:{}: {}\n"
                  HOST
                  port
                  (socket-error-text error))
             1))
      (Ok [_]
          (do
            (println "kvserver listening on http://{}:{}/kv" HOST port)
            (let [error (serve! a (mut store) (mut listener) idle)]
              (fmt (stderr)
                   "kvserver: cannot accept connections: {}\n"
                   (socket-error-text error))
              (socket/tcp-listener-close! (mut listener))
              1))))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args-set! argc argv)
  (match (port-from-args)
    (None [] (do (fmt (stderr) "usage: kvserver [PORT]\n") 2))
    (Some [port] (run port IDLE-TIMEOUT))))
