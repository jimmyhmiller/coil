(module examples.kvserver.handler)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use [al-free!])
(import "coil.http.server" :as http)
(import "coil.str" :use [sb-new sb-push-str! sb-push-byte! sb-finish!])
(import "coil.try" :use [try try!])
(import "examples.kvserver.response" :use *)
(import "examples.kvserver.route" :use *)
(import "examples.kvserver.store" :use [Store PutOutcome Inserted Replaced])

;;; The keys, one per line, in ascending order.
(defn key-listing [(a (dyn alloc/Allocator)) (store (ref Store))] (-> Response)
  (let [(mut keys) (sorted-keys store a)
        (mut body) (sb-new a)]
    (for key
      keys
      (sb-push-str! (mut body) key)
      (sb-push-byte! (mut body) #\newline))
    (al-free! (mut keys))
    (Response
      :status (Success)
      :body (sb-finish! (mut body))
      :allocator a)))

(defn perform [(a (dyn alloc/Allocator))
               (store (mut Store))
               (route Route)
               (body (slice u8))] (-> (Result Response ApiError))
  (match route
    (ListKeys [] (Ok (key-listing a store)))
    (FetchKey [key]
              (match (lookup store key)
                (Some [value] (Ok (respond a (Success) [value])))
                (None [] (Err (MissingKey key)))))
    (StoreKey [key]
              (match (put! (mut store) key body)
                (Inserted [] (Ok (empty-response a (Created))))
                (Replaced [] (Ok (empty-response a (Success))))))
    (DeleteKey [key]
               (if (delete! (mut store) key)
                   (Ok (empty-response a (NoContent)))
                   (Err (MissingKey key))))))

(defn attempt [(a (dyn alloc/Allocator))
               (store (mut Store))
               (request http/Request)] (-> (Result Response ApiError))
  (try (perform a
                (mut store)
                (try! (parse-route (http/method request) (http/target request)))
                (http/body request))))

;;; Answer one parsed request against `store`. Apart from updating the store this
;;; is pure: no I/O happens here, so every route and status is testable without a
;;; socket.
(defn handle [(a (dyn alloc/Allocator))
              (store (mut Store))
              (request http/Request)] (-> Response)
  (match (attempt a (mut store) request)
    (Ok [response] response)
    (Err [error] (error-response a error))))
