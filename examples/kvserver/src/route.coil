(module examples.kvserver.route)
(import "coil.slice" :use [subslice])
(import "coil.result" :use [some?])
(import "coil.str" :use [starts-with str-find])
(import "coil.try" :use [try try!])
(import "examples.kvserver.response"
        :use
        [ApiError NoSuchResource UnsupportedMethod EmptyKey])

;;; What a request asks the store to do.
(defsum Route
  (ListKeys)
  (FetchKey [(key (slice u8))])
  (StoreKey [(key (slice u8))])
  (DeleteKey [(key (slice u8))]))

(derive Debug Eq Route)

;;; The two kinds of resource the server exposes: the collection `/kv` and one entry
;;; `/kv/<key>`.
(defsum Resource (Collection) (Entry [(key (slice u8))]))

(const COLLECTION-METHODS "GET")

(const ENTRY-METHODS "GET, PUT, DELETE")

(const ENTRY-PREFIX "/kv/")

;;; The target without its query string; the server has no use for one.
(defn path-of [(target (slice u8))] (-> (slice u8))
  (match (str-find target "?")
    (Some [at] (subslice target 0 at))
    (None [] target)))

;;; A key is the single path segment after `/kv/`, taken byte for byte.
(defn parse-resource [(path (slice u8))] (-> (Result Resource ApiError))
  (cond (= path "/kv") (Ok (Collection))
        (starts-with path ENTRY-PREFIX)
          (let [key (subslice path (len ENTRY-PREFIX) (len path))]
            (cond (empty? key) (Err (EmptyKey))
                  (some? (str-find key "/")) (Err (NoSuchResource))
                  :else (Ok (Entry key))))
        :else (Err (NoSuchResource))))

;;; Route a request line. Keys borrow from `target`.
(defn parse-route [(method (slice u8)) (target (slice u8))] (-> (Result Route
                                                                        ApiError))
  (try (match (try! (parse-resource (path-of target)))
         (Collection []
                     (if (= method "GET")
                         (Ok (ListKeys))
                         (Err (UnsupportedMethod COLLECTION-METHODS))))
         (Entry [key]
                (cond (= method "GET") (Ok (FetchKey key))
                      (= method "PUT") (Ok (StoreKey key))
                      (= method "DELETE") (Ok (DeleteKey key))
                      :else (Err (UnsupportedMethod ENTRY-METHODS)))))))
