(module examples.kvserver.response)
(import "coil.alloc" :as alloc)
(import "coil.str" :use [StrBuf sb-new sb-push-str! sb-push-i64! sb-finish!])

;;; The statuses this server answers with. `MethodNotAllowed` carries the value of
;;; the `Allow` header that RFC 9110 requires alongside a 405.
(defsum Status
  (Success)
  (Created)
  (NoContent)
  (BadRequest)
  (NotFound)
  (MethodNotAllowed [(allow (slice u8))])
  (ContentTooLarge))

(derive Debug Eq Status)

;;; Everything that can go wrong with a request, from the bytes on the wire to the
;;; key it names. `error-response` is the one place these become statuses.
(defsum ApiError
  (Malformed)
  (TooLarge)
  (NoSuchResource)
  (UnsupportedMethod [(allow (slice u8))])
  (EmptyKey)
  (MissingKey [(key (slice u8))]))

(derive Debug Eq ApiError)

(defn status-code [(status Status)] (-> i64)
  (match status
    (Success [] 200)
    (Created [] 201)
    (NoContent [] 204)
    (BadRequest [] 400)
    (NotFound [] 404)
    (MethodNotAllowed [_] 405)
    (ContentTooLarge [] 413)))

(defn reason-phrase [(status Status)] (-> (slice u8))
  (match status
    (Success [] "OK")
    (Created [] "Created")
    (NoContent [] "No Content")
    (BadRequest [] "Bad Request")
    (NotFound [] "Not Found")
    (MethodNotAllowed [_] "Method Not Allowed")
    (ContentTooLarge [] "Content Too Large")))

;;; A status as it appears on a status line: `405 Method Not Allowed`.
(impl Display Status
  (display-fmt [(status Status) (f (ptr Formatter))]
               (-> i64)
               (fmt (formatter-writer f)
                    "{} {}"
                    (status-code status)
                    (reason-phrase status))
               0))

;;; A response with an owned plain-text body, freed when the response is dropped.
(defstruct Response
  [(status Status)
   (body (slice u8))
   (allocator (dyn alloc/Allocator))])

(impl Drop Response
  (drop [(self (mut Response))]
        (-> void)
        (alloc/free (.allocator self) (.body self))))

;;; A response whose body is the concatenation of `parts`, copied into storage the
;;; response owns.
(defn respond [(a (dyn alloc/Allocator))
               (status Status)
               (parts (slice (slice u8)))] (-> Response)
  (let [(mut body) (sb-new a)]
    (for part parts (sb-push-str! (mut body) part))
    (Response
      :status status
      :body (sb-finish! (mut body))
      :allocator a)))

(defn empty-response [(a (dyn alloc/Allocator)) (status Status)] (-> Response)
  (let [(mut nothing) (sb-new a)]
    (Response
      :status status
      :body (sb-finish! (mut nothing))
      :allocator a)))

;;; The single mapping from an error to what the client sees.
(defn error-response [(a (dyn alloc/Allocator)) (error ApiError)] (-> Response)
  (match error
    (Malformed [] (respond a (BadRequest) ["malformed HTTP request\n"]))
    (TooLarge []
              (respond a (ContentTooLarge) ["request exceeds the size limit\n"]))
    (NoSuchResource [] (respond a (NotFound) ["no such resource\n"]))
    (UnsupportedMethod [allow]
                       (respond a
                                (MethodNotAllowed allow)
                                ["allowed: " allow "\n"]))
    (EmptyKey [] (respond a (BadRequest) ["the key must not be empty\n"]))
    (MissingKey [key] (respond a (NotFound) ["no such key: " key "\n"]))))

(defn push-header! [(out (mut StrBuf)) (name (slice u8)) (value (slice u8))] (-> void)
  (sb-push-str! (mut out) name)
  (sb-push-str! (mut out) ": ")
  (sb-push-str! (mut out) value)
  (sb-push-str! (mut out) "\r\n"))

;;; The response as HTTP/1.1 wire bytes, owned by the caller (free with `alloc/free`).
;;; `connection` is the value of the `Connection` header, if one is needed. A 204
;;; carries neither a body nor a `Content-Length` (RFC 9110 §8.6).
(defn render [(a (dyn alloc/Allocator))
              (response (ref Response))
              (connection (Option (slice u8)))] (-> (slice u8))
  (let [status (.status response)
        (mut out) (sb-new a)]
    (sb-push-str! (mut out) "HTTP/1.1 ")
    (sb-push-i64! (mut out) (status-code status))
    (sb-push-str! (mut out) " ")
    (sb-push-str! (mut out) (reason-phrase status))
    (sb-push-str! (mut out) "\r\n")
    (match status
      (MethodNotAllowed [allow] (push-header! (mut out) "Allow" allow))
      (_ 0))
    (match connection
      (Some [value] (push-header! (mut out) "Connection" value))
      (None [] 0))
    (match status
      (NoContent [] 0)
      (_ (do
           (push-header! (mut out) "Content-Type" "text/plain; charset=utf-8")
           (sb-push-str! (mut out) "Content-Length: ")
           (sb-push-i64! (mut out) (len (.body response)))
           (sb-push-str! (mut out) "\r\n"))))
    (sb-push-str! (mut out) "\r\n")
    (sb-push-str! (mut out) (.body response))
    (sb-finish! (mut out))))
