(module examples.kvserver.response)
(import "coil.alloc" :as alloc)
(import "coil.str" :use [format! StrBuf])

;;; The statuses this server answers with. `MethodNotAllowed` carries the value of
;;; the `Allow` header that RFC 9110 requires alongside a 405.
(defsum Status
  (Success)
  (Created)
  (NoContent)
  (BadRequest)
  (NotFound)
  (MethodNotAllowed [(allow (slice u8))])
  (ContentTooLarge))

(derive Debug Eq Status)

;;; Everything that can go wrong with a request, from the bytes on the wire to the
;;; key it names. `error-response` is the one place these become statuses.
(defsum ApiError
  (Malformed)
  (TooLarge)
  (NoSuchResource)
  (UnsupportedMethod [(allow (slice u8))])
  (EmptyKey)
  (MissingKey [(key (slice u8))]))

(derive Debug Eq ApiError)

;;; A status as it appears on a status line: `405 Method Not Allowed`.
(impl Display Status
  (display-fmt [(status Status) (f (ptr Formatter))] (-> i64)
    (fmt (writer f)
         "{}"
         (match status
           (Success [] "200 OK")
           (Created [] "201 Created")
           (NoContent [] "204 No Content")
           (BadRequest [] "400 Bad Request")
           (NotFound [] "404 Not Found")
           (MethodNotAllowed [_] "405 Method Not Allowed")
           (ContentTooLarge [] "413 Content Too Large")))
    0))

;;; A response with an owned plain-text body, freed when the response is dropped.
(defstruct Response
  [(status Status)
   (body (slice u8))
   (allocator (dyn alloc/Allocator))])

(impl Drop Response
  (drop [(self (mut Response))]
    (-> void)
    (alloc/free (.allocator self) (.body self))))

;;; A response whose body is the concatenation of `parts`, copied into storage the
;;; response owns.
(defn respond [(a (dyn alloc/Allocator))
               (status Status)
               (parts (slice (slice u8)))] (-> Response)
  (let [(mut body) (StrBuf::new a)]
    (for part parts (push-str! (mut body) part))
    (Response
      :status status
      :body (finish! (mut body))
      :allocator a)))

;;; The single mapping from an error to what the client sees.
(defn error-response [(a (dyn alloc/Allocator)) (error ApiError)] (-> Response)
  (match error
    (Malformed [] (respond a (BadRequest) ["malformed HTTP request\n"]))
    (TooLarge []
              (respond a (ContentTooLarge) ["request exceeds the size limit\n"]))
    (NoSuchResource [] (respond a (NotFound) ["no such resource\n"]))
    (UnsupportedMethod [allow]
                       (respond a
                                (MethodNotAllowed allow)
                                ["allowed: " allow "\n"]))
    (EmptyKey [] (respond a (BadRequest) ["the key must not be empty\n"]))
    (MissingKey [key] (respond a (NotFound) ["no such key: " key "\n"]))))

;;; The response as HTTP/1.1 wire bytes, owned by the caller (free with `alloc/free`).
;;; `connection` is the value of the `Connection` header, if one is needed. A 204
;;; carries neither a body nor a `Content-Length` (RFC 9110 §8.6).
(defn render [(a (dyn alloc/Allocator))
              (response (ref Response))
              (connection (Option (slice u8)))] (-> (slice u8))
  (let [status (.status response)
        (mut out) (StrBuf::new a)]
    (format! (mut out) "HTTP/1.1 {}\r\n" status)
    (when-let [(MethodNotAllowed [allow]) status]
      (format! (mut out) "Allow: {}\r\n" allow))
    (when-let [(Some [value]) connection]
      (format! (mut out) "Connection: {}\r\n" value))
    (unless (= status (NoContent))
      (format! (mut out)
               "Content-Type: text/plain; charset=utf-8\r\nContent-Length: {}\r\n"
               (len (.body response))))
    (format! (mut out) "\r\n{}" (.body response))
    (finish! (mut out))))
