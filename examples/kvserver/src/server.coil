(module examples.kvserver.server)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use [ArrayList])
(import "coil.http.server" :as http)
(import "coil.selectors" :as selectors)
(import "coil.slice" :use [subslice])
(import "coil.socket" :as socket :use [TcpConnection TcpListener SocketError])
(import "coil.time" :as time)
(import "examples.kvserver.handler" :use [handle])
(import "examples.kvserver.response"
        :use
        [Response ApiError Malformed TooLarge error-response render])
(import "examples.kvserver.store" :use [Store])

;;; Bytes received on a connection that no complete request has consumed yet. A
;;; request can arrive split across reads, and a pipelining client can send several
;;; in one.
(defstruct Inbox [(allocator (dyn alloc/Allocator)) (bytes (ArrayList u8))])

(impl Inbox
  ;;; An empty inbox that buffers in `a`.
  (new [(a (dyn alloc/Allocator))]
    (-> Inbox)
    (Inbox :allocator a :bytes (ArrayList::new [u8] a)))

  (unread [(inbox (ref Inbox))]
    (-> (slice u8))
    (slice (.bytes inbox)))

  (append! [(inbox (mut Inbox)) (bytes (slice u8))]
    (-> void)
    (extend! (mut (.bytes inbox)) (data bytes) (len bytes)))

  ;;; Discard the first `n` bytes, keeping whatever follows them.
  (consume! [(inbox (mut Inbox)) (n i64)]
    (-> void)
    (let [all (unread inbox)
          rest (subslice all n (len all))
          (mut kept) (ArrayList::new [u8] (.allocator inbox))]
      (extend! (mut kept) (data rest) (len rest))
      (free! (mut (.bytes inbox)))
      (set! (.bytes inbox) kept))))

(impl Drop Inbox
  (drop [(self (mut Inbox))]
    (-> void)
    (free! (mut (.bytes self)))))

;;; Whether a connection stays open after an exchange.
(defsum Next (KeepOpen) (Hangup))

;;; The `Connection` header a response needs. HTTP/1.1 persists by default, so only
;;; closing is announced; an HTTP/1.0 client that asked to keep the connection is
;;; told it was kept, since 1.0 closes by default.
(defn connection-header [(keep-alive bool) (version (slice u8))]
  (-> (Option (slice u8)))
  (cond (not keep-alive) (Some "close")
        (= version "HTTP/1.0") (Some "keep-alive")
        :else (None)))

(defn send-all! [(conn (ptr TcpConnection)) (bytes (slice u8))]
  (-> (Result i64 SocketError))
  (let [(mut sent) 0]
    (try
      (while (< sent (len bytes))
        (let [rest (subslice bytes sent (len bytes))]
          (set! sent
                (+ sent
                   (try! (write conn
                                (cast (ptr i8) (data rest))
                                (len rest)))))))
      (Ok sent))))

(defn send-response! [(a (dyn alloc/Allocator))
                      (conn (ptr TcpConnection))
                      (response (ref Response))
                      (connection (Option (slice u8)))]
  (-> (Result i64 SocketError))
  (let [wire (render a response connection)]
    (defer (alloc/free a wire))
    (send-all! conn wire)))

;;; Answer the complete request at the front of the inbox, then drop its bytes.
(defn exchange! [(a (dyn alloc/Allocator))
                 (store (mut Store))
                 (conn (ptr TcpConnection))
                 (inbox (mut Inbox))
                 (request http/Request)] (-> (Result Next SocketError))
  (let [keep-alive (http/keep-alive? request)
        response (handle a (mut store) request)
        sent
          (send-response! a
                          conn
                          response
                          (connection-header keep-alive (http/version request)))]
    (println "{} {} -> {}"
             (http/method request)
             (http/target request)
             (.status response))
    ;; The request's method, target and headers borrow the inbox, so it is freed
    ;; before the inbox lets go of those bytes.
    (let [used (http/consumed request)]
      (http/request-free request)
      (consume! (mut inbox) used))
    (try
      (try! sent)
      (Ok (if keep-alive (KeepOpen) (Hangup))))))

;;; Answer bytes that can never become a valid request, then close: nothing says
;;; where a following request would begin.
(defn reject! [(a (dyn alloc/Allocator))
               (conn (ptr TcpConnection))
               (error ApiError)] (-> (Result Next SocketError))
  (let [response (error-response a error)]
    (println "rejected request -> {}" (.status response))
    (try
      (try! (send-response! a conn response (Some "close")))
      (Ok (Hangup)))))

;;; Wait for more bytes. A peer that closes, or stays silent for `idle`, ends the
;;; connection, so an idle keep-alive client cannot hold the server forever.
(defn receive! [(conn (ptr TcpConnection))
                (inbox (mut Inbox))
                (idle time/Duration)] (-> (Result Next SocketError))
  (match (selectors/wait-fd-for (.fd conn) (selectors/interest-readable) idle)
    (Err [(selectors/Timeout)] (Ok (Hangup)))
    (Err [(selectors/InvalidFd)] (Err (socket/Closed)))
    (Err [(selectors/Syscall [errno])] (Err (socket/IoFailed errno)))
    (Ok [_]
        (let [(mut chunk) (zeroed (array u8 65536))]
          (try (let [n
                       (try! (read conn
                                   (cast (ptr i8) (mut chunk))
                                   (len chunk)))]
                 (if (= n 0)
                     (Ok (Hangup))
                     (do
                       (append! (mut inbox) (subslice chunk 0 n))
                       (Ok (KeepOpen))))))))))

;;; Take the next step on a connection: read until the request at the front of the
;;; inbox is complete and answer it, or reject input that cannot be one. The parser
;;; picks up where it left off as more bytes arrive.
(defn step! [(a (dyn alloc/Allocator))
             (store (mut Store))
             (conn (ptr TcpConnection))
             (inbox (mut Inbox))
             (idle time/Duration)] (-> (Result Next SocketError))
  (let [(mut parser) (zeroed http/RequestParser)]
    (http/request-parser-init! (mut parser) a)
    (defer (http/request-parser-free! (mut parser)))
    (try (loop (match (http/request-parser-feed! (mut parser) (unread inbox))
                 (Ok [(Some [request])]
                     (break (exchange! a (mut store) conn (mut inbox) request)))
                 (Ok [(None)]
                     (match (try! (receive! conn (mut inbox) idle))
                       (KeepOpen [])
                       (Hangup [] (break (Ok (Hangup))))))
                 (Err [error]
                      (break (reject! a
                                      conn
                                      (if (http/limit-exceeded? error)
                                          (TooLarge)
                                          (Malformed))))))))))

;;; Serve requests on one connection until the client closes it or asks to, idles
;;; for `idle`, or sends something unparseable. Pipelined requests are answered in
;;; order. The caller still owns, and closes, `conn`.
(defn serve-connection! [(a (dyn alloc/Allocator))
                         (store (mut Store))
                         (conn (ptr TcpConnection))
                         (idle time/Duration)] (-> (Result i64 SocketError))
  (let [(mut inbox) (Inbox::new a)]
    (try
      (loop (match (try! (step! a (mut store) conn (mut inbox) idle))
              (KeepOpen [] (continue))
              (Hangup [] (break))))
      (Ok 0))))

;;; Accept and serve connections one at a time until accepting fails. Serving one
;;; at a time keeps the store free of locking; the idle timeout bounds how long a
;;; single client can hold the server. A failed connection is logged and dropped.
(defn serve! [(a (dyn alloc/Allocator))
              (store (mut Store))
              (listener (ptr TcpListener))
              (idle time/Duration)] (-> SocketError)
  (loop (let [(mut conn) (zeroed TcpConnection)]
          (match (accept listener (mut conn))
            (Err [error] (break error))
            (Ok [_]
                (when-let [(Err [error])
                             (serve-connection! a (mut store) (mut conn) idle)]
                  (println "connection dropped: {}" error))
                (close! (mut conn)))))))
