(module examples.mandelbrot.kernel)
(import "coil.primitive" :as primitive)
(import "coil.simd" :as v)

;;; |z|² beyond which an orbit is known to diverge (escape radius 2).
(const ESCAPE-RADIUS-SQ 4.0)

;;; The SIMD width, in f64 lanes, for the target being compiled for. `coil.simd`
;;; vectors may be wider than a hardware register, and here wider is faster: the
;;; escape loop is one long chain of dependent multiplies, so extra registers' worth
;;; of lanes give the core independent work to overlap. Measured best: 16 lanes on
;;; arm64 (eight NEON registers per vector), 8 on x86-64, where baseline SSE2 has
;;; half as many vector registers and wider vectors spill.
(defn native-lanes [] (-> Code)
  (if (= (primitive/target-arch) `x86_64) `8 `16))

;;; `native-lanes` as a value, for reporting.
(const LANES (native-lanes))

;;; The fate of one point c under z ← z² + c, starting from z = 0.
(defsum Escape
  (Bounded)
  (Escaped [(iterations i64) (radius-sq f64)]))

(derive Debug Eq Escape)

;;; Iterate one point for at most `max-iter` steps. `Escaped` records how many steps
;;; it took for |z| to pass the escape radius and |z|² at that moment, which the
;;; palette needs for smooth coloring.
(defn escape-scalar [(cr f64) (ci f64) (max-iter i64)] (-> Escape)
  (block
    :orbit
      (let [(mut zr) 0.0
            (mut zi) 0.0]
        (for n (range 0 (+ max-iter 1))
          (let [zr2 (* zr zr)
                zi2 (* zi zi)
                radius-sq (+ zr2 zi2)]
            (when (> radius-sq ESCAPE-RADIUS-SQ)
              (return-from :orbit (Escaped n radius-sq)))
            (set! zi (+ (* (+ zr zr) zi) ci))
            (set! zr (+ (- zr2 zi2) cr))))
        (Bounded))))

;;; The per-lane outcome of `escape-lanes`: lane i escaped iff `(escaped i)`, and then
;;; its iteration count and |z|² are in the matching lanes.
(defstruct Lanes [(const N i64)]
  [(iterations (vec i64 N)) (radius-sq (vec f64 N)) (escaped (mask N))])

;;; Iterate N points that share an imaginary part `ci` at once. Only `live` lanes are
;;; computed; the rest (the tail of a row) start retired. Each step performs the same
;;; IEEE operations in the same order as `escape-scalar`, so every lane's result is
;;; bit-for-bit the scalar one.
(defn escape-lanes [(const N i64)] [(cr (vec f64 N))
                                    (ci f64)
                                    (live (mask N))
                                    (max-iter i64)] (-> (Lanes N))
  (let [radius-limit (v/vsplat [f64 N] ESCAPE-RADIUS-SQ)
        civ (v/vsplat [f64 N] ci)
        (mut zr) (v/vzero [f64 N])
        (mut zi) (v/vzero [f64 N])
        (mut active) live
        (mut iterations) (v/vzero [i64 N])
        (mut radius-sq) (v/vzero [f64 N])
        (mut n) 0]
    (while (and (<= n max-iter) (v/mask-any? active))
      (let [zr2 (v/vmul zr zr)
            zi2 (v/vmul zi zi)
            mag (v/vadd zr2 zi2)
            escaping (v/vand active (v/v> mag radius-limit))]
        (set! iterations (v/vselect escaping (v/vsplat [i64 N] n) iterations))
        (set! radius-sq (v/vselect escaping mag radius-sq))
        (set! active (v/vxor active escaping))
        ;; Retired lanes keep their z, so they never overflow into inf/NaN.
        (set! zi (v/vselect active (v/vadd (v/vmul (v/vadd zr zr) zi) civ) zi))
        (set! zr (v/vselect active (v/vadd (v/vsub zr2 zi2) cr) zr))
        (set! n (+ n 1))))
    (Lanes
      :iterations iterations
      :radius-sq radius-sq
      :escaped (v/vxor live active))))

;;; Lane `i` of a vector result, as the scalar kernel would have reported it.
(defn lane-escape [(const N i64)] [(lanes (Lanes N)) (i i64)] (-> Escape)
  (if (v/vextract (.escaped lanes) i)
      (Escaped (v/vextract (.iterations lanes) i)
               (v/vextract (.radius-sq lanes) i))
      (Bounded)))
