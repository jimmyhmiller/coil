(module examples.mandelbrot.options)
(import "coil.str" :use [str-parse-int])
(import "coil.try" :use [try try!])

;;; What to render and where to put it.
(defstruct Options
  [(width i64) (height i64) (max-iter i64) (threads i64) (out (slice u8))])

;;; Why the command line was rejected.
(defsum OptionError
  (UnknownFlag [(flag (slice u8))])
  (MissingValue [(flag (slice u8))])
  (NotAPositiveInteger [(flag (slice u8)) (value (slice u8))]))

(derive Debug Eq OptionError)

(impl Display OptionError
  (display-fmt [(e OptionError) (f (ptr Formatter))]
               (-> i64)
               (match e
                 (UnknownFlag [flag]
                              (fmt (formatter-writer f) "unknown flag {}" flag))
                 (MissingValue [flag]
                               (fmt (formatter-writer f)
                                    "{} needs a value"
                                    flag))
                 (NotAPositiveInteger [flag value]
                                      (fmt (formatter-writer f)
                                           "{} wants a positive integer, got {:?}"
                                           flag
                                           value)))
               0))

(def USAGE
  "usage: mandelbrot [--width N] [--height N] [--iterations N] [--threads N] [--out FILE.ppm]")

;;; Apply `--flag value` pairs from `args` on top of `defaults`.
(defn parse-options [(args (slice (slice u8))) (defaults Options)] (-> (Result Options
                                                                               OptionError))
  (let [(mut options) defaults
        (mut i) 0]
    (try (while (< i (len args))
           (let [flag (get args i)]
             (when (= (+ i 1) (len args))
               (return-from :try (Err (MissingValue flag))))
             (try! (apply-flag (mut options) flag (get args (+ i 1))))
             (set! i (+ i 2))))
         (Ok options))))

(defn apply-flag [(options (mut Options)) (flag (slice u8)) (value (slice u8))] (-> (Result i64
                                                                                            OptionError))
  (try (cond (= flag "--width")
               (set! (.width options) (try! (positive flag value)))
             (= flag "--height")
               (set! (.height options) (try! (positive flag value)))
             (= flag "--iterations")
               (set! (.max-iter options) (try! (positive flag value)))
             (= flag "--threads")
               (set! (.threads options) (try! (positive flag value)))
             (= flag "--out") (set! (.out options) value)
             :else (return-from :try (Err (UnknownFlag flag))))
       (Ok 0)))

(defn positive [(flag (slice u8)) (value (slice u8))] (-> (Result i64
                                                                  OptionError))
  (match (str-parse-int value)
    (Some [n] (if (> n 0) (Ok n) (Err (NotAPositiveInteger flag value))))
    (None [] (Err (NotAPositiveInteger flag value)))))
