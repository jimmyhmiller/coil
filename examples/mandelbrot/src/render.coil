(module examples.mandelbrot.render)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist"
        :use
        [ArrayList])
(import "coil.atomic" :use [add])
(import "coil.math" :as math)
(import "coil.simd" :as v)
(import "coil.thread" :use [Thread thread-spawn thread-join])
(import "examples.mandelbrot.kernel" :as k :use [Escape Bounded Escaped LANES])

;;; The window onto the complex plane: its center and the width of the real axis it
;;; shows. The imaginary extent follows from the image's aspect ratio.
(defstruct Viewport [(center-re f64) (center-im f64) (span f64)])

;;; The point each pixel samples: `columns` holds the real part of every column and
;;; `rows` the imaginary part of every row. Both kernels read these same tables, so
;;; they iterate exactly the same c values.
(defstruct Plane
  [(width i64) (height i64) (columns (ArrayList f64)) (rows (ArrayList f64))])

(impl Drop Plane
  (drop [(self (mut Plane))]
    (-> void)
    (free! (mut (.columns self)))
    (free! (mut (.rows self)))))

;;; Sample `view` at the center of each pixel of a `width` × `height` grid, with row 0
;;; at the top. `cell-aspect` is how many times taller than wide one cell is: 1 for
;;; image pixels, about 2 for terminal characters.
(defn plane-new [(a (dyn Allocator))
                 (view Viewport)
                 (width i64)
                 (height i64)
                 (cell-aspect f64)] (-> Plane)
  (let [step-re (/ (.span view) (cast f64 width))
        step-im (* step-re cell-aspect)
        (mut columns) (ArrayList::new [f64] a)
        (mut rows) (ArrayList::new [f64] a)]
    (for col (range 0 width)
      (push! (mut columns)
             (+ (.center-re view) (* (offset-from-center col width) step-re))))
    (for row (range 0 height)
      (push! (mut rows)
             (- (.center-im view) (* (offset-from-center row height) step-im))))
    (Plane
      :width width
      :height height
      :columns columns
      :rows rows)))

;;; How many cells the center of cell `i` lies from the middle of `count` cells.
(defn offset-from-center [(i i64) (count i64)] (-> f64)
  (- (+ (cast f64 i) 0.5) (/ (cast f64 count) 2.0)))

;;; Every pixel's escape result, in row-major order.
(defstruct EscapeImage [(width i64) (height i64) (pixels (ArrayList Escape))])

(impl Drop EscapeImage
  (drop [(self (mut EscapeImage))]
    (-> void)
    (free! (mut (.pixels self)))))

;;; Whether two renders agree on every pixel, iteration counts and |z|² alike.
(defn images-equal? [(a (ref EscapeImage)) (b (ref EscapeImage))] (-> bool)
  (and (= (.width a) (.width b))
       (= (.height a) (.height b))
       (= (slice (.pixels a)) (slice (.pixels b)))))

;;; The single-threaded reference renderer: one point at a time through the scalar kernel.
(defn render-scalar [(a (dyn Allocator)) (plane (ref Plane)) (max-iter i64)]
  (-> EscapeImage)
  (let [(mut pixels) (ArrayList::new [Escape] a)]
    (reserve! (mut pixels) (* (.width plane) (.height plane)))
    (for ci (.rows plane)
      (for cr (.columns plane)
        (push! (mut pixels) (k/escape-scalar cr ci max-iter))))
    (EscapeImage
      :width (.width plane)
      :height (.height plane)
      :pixels pixels)))

;;; Why a parallel render could not run to completion.
(defsum RenderError
  (SpawnFailed [(status i32)])
  (JoinFailed [(status i32)]))

(impl Display RenderError
  (display-fmt [(e RenderError) (f (ptr Formatter))]
    (-> i64)
    (match e
      (SpawnFailed [status]
                   (fmt (formatter-writer f)
                        "pthread_create failed with status {}"
                        status))
      (JoinFailed [status]
                  (fmt (formatter-writer f)
                       "pthread_join failed with status {}"
                       status)))
    0))

;;; What every worker shares. Workers only read the tables; `next-row` is the one
;;; contended word, claimed with an atomic add; and each row of `pixels` is written by
;;; exactly the worker that claimed it, so no two threads ever write the same memory.
(defstruct RenderJob
  [(width i64)
   (height i64)
   (max-iter i64)
   (columns (ptr f64))
   (rows (ptr f64))
   (pixels (ptr Escape))
   (next-row i64)])

;;; Render one row of `job` N pixels at a time. The last chunk of a row may be short;
;;; its missing lanes start retired, so they cost nothing and are never stored.
(defn render-row [(const N i64)] [(job (ptr RenderJob)) (row i64)] (-> void)
  (let [width (.width job)
        ci (load (index (.rows job) row))
        out (index (.pixels job) (* row width))]
    (for chunk (range 0 (/ (+ width (- N 1)) N))
      (let [col (* chunk N)
            remaining (- width col)
            cr
              (v/vload-partial [f64 N]
                               (index (.columns job) col)
                               remaining
                               (v/vzero [f64 N]))
            lanes
              (k/escape-lanes cr ci (v/mask-low [N] remaining) (.max-iter job))]
        (for lane (range 0 (math/min N remaining))
          (set! (index out (+ col lane)) (k/lane-escape lanes lane)))))))

;;; Thread entry point: claim rows until none are left. Faster workers simply claim
;;; more rows, which balances the expensive rows that cross the set's interior.
(defn render-worker [(arg (ptr i8))] (-> (ptr i8))
  (let [job (cast (ptr RenderJob) arg)
        (mut row) (add (field job next-row) 1)]
    (while (< row (.height job))
      (render-row [(const LANES)] job row)
      (set! row (add (field job next-row) 1))))
  (cast (ptr i8) 0))

;;; Render with `thread-count` workers, each running the SIMD kernel.
(defn render-parallel [(a (dyn Allocator))
                       (plane (ref Plane))
                       (max-iter i64)
                       (thread-count i64)] (-> (Result EscapeImage RenderError))
  (let [(mut pixels) (ArrayList::new [Escape] a)]
    (extend-zeroed! (mut pixels) (* (.width plane) (.height plane)))
    (let [(mut job)
            (RenderJob
              :width (.width plane)
              :height (.height plane)
              :max-iter max-iter
              :columns (data (slice (.columns plane)))
              :rows (data (slice (.rows plane)))
              :pixels (data (slice pixels))
              :next-row 0)]
      (match (run-workers a (mut job) thread-count)
        (Ok [_]
            (Ok (EscapeImage
                  :width (.width plane)
                  :height (.height plane)
                  :pixels pixels)))
        (Err [e]
             (free! (mut pixels))
             (Err e))))))

;;; Spawn the workers over `job` and wait for all of them. If a spawn fails, the
;;; workers already running still finish every row before the error is returned,
;;; because they hold a pointer into the caller's frame.
(defn run-workers [(a (dyn Allocator)) (job (ptr RenderJob)) (thread-count i64)]
  (-> (Result i64 RenderError))
  (let [(mut threads) (ArrayList::new [Thread] a)
        (mut spawn-status) (: 0 i32)
        (mut join-status) (: 0 i32)]
    (defer (free! (mut threads)))
    (reserve! (mut threads) thread-count)
    (for _ (range 0 thread-count)
      (when (= spawn-status 0)
        (let [(mut thread) (zeroed Thread)]
          (set! spawn-status
                (thread-spawn (mut thread)
                              (fnptr-of render-worker)
                              (cast (ptr i8) job)))
          (when (= spawn-status 0)
            (push! (mut threads) thread)))))
    (for (mut thread) threads
      (let [status (thread-join (mut thread))]
        (when (!= status 0)
          (set! join-status status))))
    (cond (!= spawn-status 0) (Err (SpawnFailed spawn-status))
          (!= join-status 0) (Err (JoinFailed join-status))
          :else (Ok thread-count))))

(const FNV-OFFSET-BASIS (: 0xcbf29ce484222325 u64))

(const FNV-PRIME (: 0x100000001b3 u64))

;;; An order-sensitive FNV-1a hash of every pixel's iteration count: unlike a sum, it
;;; changes when a row lands in the wrong place. Bounded points hash as 0, which no
;;; escaped point can be: z starts at 0 and needs at least one step to leave the disk.
;;; FNV relies on wrapping multiplication, hence `primitive/imul`.
(defn checksum [(image (ref EscapeImage))] (-> u64)
  (let [(mut hash) FNV-OFFSET-BASIS]
    (for e (.pixels image)
      (set! hash
            (primitive/imul (^ hash (cast u64 (iteration-count e)))
                            FNV-PRIME)))
    hash))

(defn iteration-count [(e Escape)] (-> i64)
  (match e
    (Bounded [] 0)
    (Escaped [n _] n)))
