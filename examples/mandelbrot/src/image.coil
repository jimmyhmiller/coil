(module examples.mandelbrot.image)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.fs" :as fs)
(import "coil.io" :use [IoError])
(import "coil.math" :as math)
(import "coil.slice" :use [subslice])
(import "coil.str" :use [format! StrBuf])
(import "examples.mandelbrot.kernel" :use [Escape Bounded Escaped])
(import "examples.mandelbrot.render" :use [EscapeImage])

;;; One 8-bit-per-channel color.
(defstruct Rgb [(r u8) (g u8) (b u8)])

(derive Debug Eq Rgb)

;;; A fixed point of the palette gradient: color `color` at position `at` in [0, 1).
(defstruct Stop [(at f64) (color Rgb)])

;; The classic deep-blue / white / orange gradient, cycled every PALETTE-PERIOD
;; iterations. It wraps from the last stop back to the first.
(def STOPS [(Stop
              :at 0.0
              :color
                (Rgb
                  :r 0
                  :g 7
                  :b 100))
            (Stop
              :at 0.16
              :color
                (Rgb
                  :r 32
                  :g 107
                  :b 203))
            (Stop
              :at 0.42
              :color
                (Rgb
                  :r 237
                  :g 255
                  :b 255))
            (Stop
              :at 0.6425
              :color
                (Rgb
                  :r 255
                  :g 170
                  :b 0))
            (Stop
              :at 0.8575
              :color
                (Rgb
                  :r 0
                  :g 2
                  :b 0))])

(const BLACK
       (Rgb
         :r 0
         :g 0
         :b 0))

(const PALETTE-PERIOD 48.0)

;;; The continuous ("normalized") iteration count of an escaped point. Integer
;;; counts jump by one between neighbouring bands; subtracting log2(ln|z|) removes
;;; the jump, which is what makes the gradient smooth.
(defn smooth-iterations [(n i64) (radius-sq f64)] (-> f64)
  (- (+ (cast f64 n) 1.0) (math/log2 (* 0.5 (math/log radius-sq)))))

;;; The color of one pixel. Points in the set are black.
(defn color-of [(e Escape)] (-> Rgb)
  (match e
    (Bounded [] BLACK)
    (Escaped [n radius-sq]
             (let [phase (/ (smooth-iterations n radius-sq) PALETTE-PERIOD)]
               (gradient (- phase (math/floor phase)))))))

;;; The gradient color at `t` in [0, 1), interpolated between the stops around it.
(defn gradient [(t f64)] (-> Rgb)
  (let [last (- (len STOPS) 1)
        i (stop-before t)
        from (get STOPS i)
        to (get STOPS (if (= i last) 0 (+ i 1)))
        to-at (if (= i last) 1.0 (.at to))]
    (blend (.color from) (.color to) (/ (- t (.at from)) (- to-at (.at from))))))

;;; The index of the last stop at or before `t`.
(defn stop-before [(t f64)] (-> i64)
  (let [(mut i) 0]
    (while (and (< (+ i 1) (len STOPS)) (>= t (.at (get STOPS (+ i 1)))))
      (set! i (+ i 1)))
    i))

(defn blend [(a Rgb) (b Rgb) (t f64)] (-> Rgb)
  (Rgb
    :r (blend-channel (.r a) (.r b) t)
    :g (blend-channel (.g a) (.g b) t)
    :b (blend-channel (.b a) (.b b) t)))

(defn blend-channel [(a u8) (b u8) (t f64)] (-> u8)
  (cast u8 (math/round (+ (cast f64 a) (* t (- (cast f64 b) (cast f64 a)))))))

;;; `image` encoded as a binary PPM: the header, then three bytes per pixel, row by
;;; row from the top. The caller owns the returned bytes.
(defn encode-ppm [(a (dyn Allocator)) (image (ref EscapeImage))]
  (-> (ArrayList u8))
  (let [(mut out) (StrBuf::new a)]
    (format! (mut out) "P6\n{} {}\n255\n" (.width image) (.height image))
    (for e (.pixels image)
      (let [c (color-of e)]
        (push! (mut out) (.r c))
        (push! (mut out) (.g c))
        (push! (mut out) (.b c))))
    (.bytes out)))

;;; Write `image` to `path` as a binary PPM.
(defn write-ppm [(a (dyn Allocator))
                 (path (slice u8))
                 (image (ref EscapeImage))]
  (-> (Result i64 IoError))
  (let [(mut bytes) (encode-ppm a image)]
    (defer (free! (mut bytes)))
    (fs/write-file a path (slice bytes))))

;; Darkest to brightest; points in the set take the last, densest glyph.
(def SHADES " .:-=+*#%@")

;;; Print `image` as ASCII art, one character per pixel, shading escaped points by
;;; how long they took to escape.
(defn print-ascii [(image (ref EscapeImage))] (-> void)
  (for row (range 0 (.height image))
    (for col (range 0 (.width image))
      (print "{}" (shade (get (.pixels image) (+ (* row (.width image)) col)))))
    (println "")))

(defn shade [(e Escape)] (-> (slice u8))
  (let [last (- (len SHADES) 1)
        level
          (match e
            (Bounded [] last)
            ;; Escape times grow geometrically towards the set, so shade by octave.
            (Escaped [n radius-sq]
                     (cast i64
                           (math/min (cast f64 (- last 1))
                                     (- (math/log2 (smooth-iterations n
                                                                      radius-sq))
                                        1.0)))))]
    (subslice SHADES level (+ level 1))))
