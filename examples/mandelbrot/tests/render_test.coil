(module examples.mandelbrot.render-test)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "examples.mandelbrot.kernel" :use [Escape Bounded Escaped])
(import "examples.mandelbrot.render"
        :use
        [Viewport EscapeImage Plane plane-new render-scalar render-parallel
         images-equal? checksum])

(const VIEW
       (Viewport
         :center-re -0.65
         :center-im 0.0
         :span 3.0))

(defn parallel [(a (dyn Allocator))
                (plane (ref Plane))
                (max-iter i64)
                (threads i64)]
  (-> EscapeImage)
  (match (render-parallel a plane max-iter threads)
    (Ok [image] image)
    (Err [e] (panic "parallel render failed: {}" e))))

(deftest plane-samples-pixel-centers-symmetrically
  (let [plane (plane-new (malloc-allocator) VIEW 4 2 1.0)]
    ;; 3.0 wide over 4 columns: centers at -0.65 + (-1.5, -0.5, 0.5, 1.5) * 0.75.
    (assert-eq (get (.columns plane) 0) -1.775)
    (assert-eq (get (.columns plane) 3) 0.475)
    ;; Row 0 is the top, so it has the positive imaginary part.
    (assert-eq (get (.rows plane) 0) 0.375)
    (assert-eq (get (.rows plane) 1) -0.375)))

(deftest cell-aspect-stretches-rows
  (let [plane (plane-new (malloc-allocator) VIEW 4 2 2.0)]
    (assert-eq (get (.rows plane) 0) 0.75)))

(deftest parallel-render-matches-scalar-render
  ;; 37 columns is not a multiple of any SIMD width, so every row has a short chunk.
  (let [a (malloc-allocator)
        plane (plane-new a VIEW 37 23 1.0)]
    (assert (images-equal? (render-scalar a plane 200) (parallel a plane 200 4)))))

(deftest checksum-is-independent-of-thread-count
  (let [a (malloc-allocator)
        plane (plane-new a VIEW 61 47 1.0)
        expected (checksum (render-scalar a plane 300))]
    (for threads (range 1 10)
      (assert-eq (checksum (parallel a plane 300 threads)) expected))))

(deftest more-threads-than-rows-is-fine
  (let [a (malloc-allocator)
        plane (plane-new a VIEW 5 3 1.0)]
    (assert (images-equal? (render-scalar a plane 50) (parallel a plane 50 16)))))

(deftest checksum-sees-pixel-order
  (let [a (malloc-allocator)
        (mut forward) (ArrayList::new [Escape] a)
        (mut backward) (ArrayList::new [Escape] a)]
    (push! (mut forward) (Escaped 1 8.0))
    (push! (mut forward) (Bounded))
    (push! (mut backward) (Bounded))
    (push! (mut backward) (Escaped 1 8.0))
    (let [one
            (EscapeImage
              :width 2
              :height 1
              :pixels forward)
          other
            (EscapeImage
              :width 2
              :height 1
              :pixels backward)]
      (assert-ne (checksum one) (checksum other))
      (assert (not (images-equal? one other))))))
