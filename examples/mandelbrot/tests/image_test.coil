(module examples.mandelbrot.image-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.math" :as math)
(import "coil.slice" :use [subslice])
(import "examples.mandelbrot.kernel" :use [Escape Bounded Escaped])
(import "examples.mandelbrot.render" :use [EscapeImage])
(import "examples.mandelbrot.image"
        :use
        [Rgb color-of gradient smooth-iterations encode-ppm shade])

(defn two-pixel-image [] (-> EscapeImage)
  (let [(mut pixels) (ArrayList::new [Escape] (malloc-allocator))]
    (push! (mut pixels) (Bounded))
    (push! (mut pixels) (Escaped 3 25.0))
    (EscapeImage
      :width 2
      :height 1
      :pixels pixels)))

(deftest ppm-is-header-then-three-bytes-per-pixel
  (let [(mut owned) (encode-ppm (malloc-allocator) (two-pixel-image))
        header "P6\n2 1\n255\n"
        encoded (slice owned)]
    (assert-eq (len encoded) (+ (len header) 6))
    (assert-eq (subslice encoded 0 (len header)) header)
    ;; The first pixel is in the set, so black.
    (assert-eq (subslice encoded (len header) (+ (len header) 3)) "\0\0\0")
    (free! (mut owned))))

(deftest points-in-the-set-are-black
  (assert-eq (color-of (Bounded))
             (Rgb
               :r 0
               :g 0
               :b 0)))

(deftest gradient-passes-through-its-stops
  (assert-eq (gradient 0.0)
             (Rgb
               :r 0
               :g 7
               :b 100))
  (assert-eq (gradient 0.42)
             (Rgb
               :r 237
               :g 255
               :b 255)))

(deftest gradient-wraps-back-to-the-first-stop
  (let [near-end (gradient 0.999999)]
    (assert (<= (.r near-end) 1))
    (assert (<= (- 100 (cast i64 (.b near-end))) 1))))

(deftest smooth-iterations-is-continuous-across-a-band
  ;; Far out, one more step squares |z|. So escaping at step n with |z|² = 4 and
  ;; escaping a step later with |z|² = 16 are the same distance from the set, and the
  ;; smooth count agrees up to rounding in log and log2.
  (assert (< (math/abs (- (smooth-iterations 5 4.0) (smooth-iterations 6 16.0)))
             1e-12)))

(deftest set-points-use-the-densest-shade
  (assert-eq (shade (Bounded)) "@")
  (assert-eq (shade (Escaped 1 8.0)) " "))
