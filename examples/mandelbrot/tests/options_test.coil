(module examples.mandelbrot.options-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [al-new al-free! al-slice])
(import "examples.mandelbrot.options"
        :use
        [Options
         OptionError
         UnknownFlag
         MissingValue
         NotAPositiveInteger
         parse-options])

(def DEFAULTS
  (Options
    :width 800
    :height 600
    :max-iter 1000
    :threads 4
    :out "out.ppm"))

(deftest no-arguments-keep-the-defaults
         ;; An empty array literal has no element type, so borrow an empty list instead.
         (let [(mut none) (al-new [(slice u8)] (malloc-allocator))]
           (match (parse-options (al-slice none) DEFAULTS)
             (Ok [options]
                 (assert-eq (.width options) 800)
                 (assert (= (.out options) "out.ppm")))
             (Err [_] (assert false)))
           (al-free! (mut none))))

(deftest flags-override-defaults
         (match (parse-options ["--width"
                                "64"
                                "--iterations"
                                "50"
                                "--out"
                                "x.ppm"]
                               DEFAULTS)
           (Ok [options]
               (assert-eq (.width options) 64)
               (assert-eq (.height options) 600)
               (assert-eq (.max-iter options) 50)
               (assert (= (.out options) "x.ppm")))
           (Err [_] (assert false))))

(deftest unknown-flags-are-rejected
         (match (parse-options ["--colour" "red"] DEFAULTS)
           (Ok [_] (assert false))
           (Err [e] (assert-eq e (UnknownFlag "--colour")))))

(deftest a-flag-needs-its-value
         (match (parse-options ["--threads"] DEFAULTS)
           (Ok [_] (assert false))
           (Err [e] (assert-eq e (MissingValue "--threads")))))

(deftest sizes-must-be-positive-integers
         (match (parse-options ["--height" "0"] DEFAULTS)
           (Ok [_] (assert false))
           (Err [e] (assert-eq e (NotAPositiveInteger "--height" "0"))))
         (match (parse-options ["--height" "tall"] DEFAULTS)
           (Ok [_] (assert false))
           (Err [e] (assert-eq e (NotAPositiveInteger "--height" "tall")))))
