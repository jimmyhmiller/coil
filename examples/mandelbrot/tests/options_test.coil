(module examples.mandelbrot.options-test)
(import "examples.mandelbrot.options"
        :use
        [Options UnknownFlag MissingValue NotAPositiveInteger parse-options])

(const DEFAULTS
       (Options
         :width 800
         :height 600
         :max-iter 1000
         :threads 4
         :out "out.ppm"))

(deftest no-arguments-keep-the-defaults
  (assert-eq (parse-options [] DEFAULTS) (Ok DEFAULTS)))

(deftest flags-override-defaults
  (assert-eq (parse-options ["--width" "64" "--iterations" "50" "--out" "x.ppm"]
                            DEFAULTS)
             (Ok (Options
                   :width 64
                   :height 600
                   :max-iter 50
                   :threads 4
                   :out "x.ppm"))))

(deftest unknown-flags-are-rejected
  (assert-eq (parse-options ["--colour" "red"] DEFAULTS)
             (Err (UnknownFlag "--colour"))))

(deftest a-flag-needs-its-value
  (assert-eq (parse-options ["--threads"] DEFAULTS)
             (Err (MissingValue "--threads"))))

(deftest sizes-must-be-positive-integers
  (assert-eq (parse-options ["--height" "0"] DEFAULTS)
             (Err (NotAPositiveInteger "--height" "0")))
  (assert-eq (parse-options ["--height" "tall"] DEFAULTS)
             (Err (NotAPositiveInteger "--height" "tall"))))
