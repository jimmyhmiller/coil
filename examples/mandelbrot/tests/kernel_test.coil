(module examples.mandelbrot.kernel-test)
(import "coil.math" :as math)
(import "coil.prop" :use *)
(import "coil.simd" :as v)
(import "examples.mandelbrot.kernel"
        :use
        [Escape Bounded Escaped escape-scalar escape-lanes lane-escape])

(deftest origin-is-in-the-set
  (assert-eq (escape-scalar 0.0 0.0 1000) (Bounded)))

(deftest period-two-cycle-is-in-the-set
  (assert-eq (escape-scalar -1.0 0.0 1000) (Bounded)))

(deftest tip-of-the-antenna-is-in-the-set
  ;; z runs 0, -2, 2, 2, …: |z| reaches the escape radius but never passes it.
  (assert-eq (escape-scalar -2.0 0.0 1000) (Bounded)))

(deftest far-point-escapes-after-one-step
  ;; z1 = c = 2+2i, and |z1|² = 8.
  (assert-eq (escape-scalar 2.0 2.0 1000) (Escaped 1 8.0)))

(deftest one-escapes-after-three-steps
  ;; z runs 0, 1, 2, 5.
  (assert-eq (escape-scalar 1.0 0.0 1000) (Escaped 3 25.0)))

(deftest iteration-limit-decides-slow-escapes
  ;; c = 0.26 lies just outside the cardioid's cusp at 0.25 and takes a while to leave.
  (let [slow (escape-scalar 0.26 0.0 1000)]
    (match slow
      (Escaped [n _]
               (assert (> n 20))
               (assert-eq (escape-scalar 0.26 0.0 (- n 1)) (Bounded)))
      (Bounded [] (assert false)))))

;; Real parts are spread over [-2.5, 1.0) and imaginary parts over [-1.25, 1.25], a
;; grid that crosses the set's boundary many times.
(defn grid-re [(col i64) (columns i64)] (-> f64)
  (+ -2.5 (/ (* 3.5 (cast f64 col)) (cast f64 columns))))

(defn grid-im [(row i64) (rows i64)] (-> f64)
  (+ -1.25 (/ (* 2.5 (cast f64 row)) (cast f64 (- rows 1)))))

;;; Count the grid points where the N-lane kernel and the scalar kernel disagree.
;;; `columns` is deliberately not a multiple of N, so every row ends in a short chunk.
(defn grid-disagreements [(const N i64)] [(columns i64)
                                          (rows i64)
                                          (max-iter i64)] (-> i64)
  (let [(mut mismatches) 0]
    (for row (range 0 rows)
      (for chunk (range 0 (/ (+ columns (- N 1)) N))
        (let [first-col (* chunk N)
              live (math/min N (- columns first-col))
              (mut cr) (v/vzero [f64 N])]
          (for lane (range 0 live)
            (set! cr (v/vinsert cr lane (grid-re (+ first-col lane) columns))))
          (let [lanes
                  (escape-lanes cr
                                (grid-im row rows)
                                (v/mask-low [N] live)
                                max-iter)]
            (for lane (range 0 live)
              (unless (= (lane-escape lanes lane)
                         (escape-scalar (grid-re (+ first-col lane) columns)
                                        (grid-im row rows)
                                        max-iter))
                (set! mismatches (+ mismatches 1))))))))
    mismatches))

(deftest simd-kernel-matches-scalar-kernel-exactly
  ;; Both kernels do the same IEEE operations in the same order, so the results,
  ;; including the f64 |z|² at escape, are identical rather than merely close.
  (assert-eq (grid-disagreements [(const 1)] 61 41 300) 0)
  (assert-eq (grid-disagreements [(const 2)] 61 41 300) 0)
  (assert-eq (grid-disagreements [(const 3)] 61 41 300) 0)
  (assert-eq (grid-disagreements [(const 8)] 61 41 300) 0)
  (assert-eq (grid-disagreements [(const 16)] 61 41 300) 0))

(deftest dead-lanes-report-nothing
  (let [lanes
          (escape-lanes (v/vsplat [f64 4] 2.0)
                        2.0
                        (v/mask-low [4] 0)
                        100)]
    (for lane (range 0 4)
      (assert-eq (lane-escape lanes lane) (Bounded)))))

;;; A drawn coordinate, in thousandths, so counterexamples read as short decimals.
(defn milli [(n i64)] (-> f64)
  (/ (cast f64 n) 1000.0))

(defn vec4 [(a f64) (b f64) (c f64) (d f64)] (-> (vec f64 4))
  (v/vinsert (v/vinsert (v/vinsert (v/vinsert (v/vzero [f64 4]) 0 a) 1 b) 2 c)
             3
             d))

(defprop simd-lanes-match-scalar-at-any-points []
  (let [ci (milli (prop-note "ci*1000" (draw-int! (prop-src) -1250 1250)))
        cr
          (vec4 (milli (prop-note "cr0*1000"
                                  (draw-int! (prop-src) -2500 1000)))
                (milli (prop-note "cr1*1000"
                                  (draw-int! (prop-src) -2500 1000)))
                (milli (prop-note "cr2*1000"
                                  (draw-int! (prop-src) -2500 1000)))
                (milli (prop-note "cr3*1000"
                                  (draw-int! (prop-src) -2500 1000))))
        lanes (escape-lanes cr ci (v/mask-low [4] 4) 500)]
    (block :check
      (for lane (range 0 4)
        (unless (= (lane-escape lanes lane)
                   (escape-scalar (v/vextract cr lane) ci 500))
          (return-from :check false)))
      true)))
