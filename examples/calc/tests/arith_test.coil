(module examples.calc.arith-test)
(import "coil.prop" :use *)
(import "examples.calc.arith"
        :use
        [checked-add checked-sub checked-mul checked-div checked-rem checked-pow])
(import "examples.calc.error"
        :use
        [ErrorKind Overflow DivisionByZero NegativeExponent])

;; The checked operations are compared against the same operation done exactly in
;; 128 bits, where two i64 operands cannot overflow.
(defn wide [(x i64)] (-> i128)
  (cast i128 x))

(defn fits-i64? [(x i128)] (-> bool)
  (and (>= x (wide -9223372036854775808)) (<= x (wide 9223372036854775807))))

(defn agrees? [(r (Result i64 ErrorKind)) (exact i128)] (-> bool)
  (if (fits-i64? exact)
      (= r (Ok (cast i64 exact)))
      (= r (Err (Overflow)))))

(defprop addition-is-exact-or-overflows [(a i64) (b i64)]
  (agrees? (checked-add a b) (+ (wide a) (wide b))))

(defprop subtraction-is-exact-or-overflows [(a i64) (b i64)]
  (agrees? (checked-sub a b) (- (wide a) (wide b))))

(defprop multiplication-is-exact-or-overflows [(a i64) (b i64)]
  (agrees? (checked-mul a b) (* (wide a) (wide b))))

(defprop division-and-remainder-reassemble-the-dividend [(a i64) (b i64)]
  (assume (!= b 0))
  (try (let [r (try-or! (checked-rem a b) false)]
         (match (checked-div a b)
           ;; Only MIN / -1 overflows, and its remainder is still 0.
           (Err [kind] (and (= kind (Overflow)) (= b -1) (= r 0)))
           (Ok [q] (= (wide a) (+ (* (wide q) (wide b)) (wide r))))))))

(deftest dividing-by-zero-is-an-error
  (assert-eq (checked-div 7 0) (Err (DivisionByZero)))
  (assert-eq (checked-rem 7 0) (Err (DivisionByZero))))

(deftest only-min-divided-by-minus-one-overflows
  (assert-eq (checked-div -9223372036854775808 -1) (Err (Overflow)))
  (assert-eq (checked-rem -9223372036854775808 -1) (Ok 0))
  (assert-eq (checked-div -9223372036854775808 1) (Ok -9223372036854775808)))

(deftest division-truncates-toward-zero
  (assert-eq (checked-div -7 2) (Ok -3))
  (assert-eq (checked-rem -7 2) (Ok -1))
  (assert-eq (checked-rem 7 -2) (Ok 1)))

(defprop powers-match-repeated-multiplication [(base i64) (e i64)]
  (let [small-base (- (% base 7) 3)
        exponent (% (& e 0xFF) 70)
        (mut exact) (wide 1)]
    (for _ (range 0 exponent)
      (when (fits-i64? exact) (set! exact (* exact (wide small-base)))))
    (agrees? (checked-pow small-base exponent) exact)))

(deftest powers-of-edge-bases
  (assert-eq (checked-pow 2 62) (Ok 4611686018427387904))
  (assert-eq (checked-pow 2 63) (Err (Overflow)))
  (assert-eq (checked-pow -2 63) (Ok -9223372036854775808))
  (assert-eq (checked-pow 1 9223372036854775807) (Ok 1))
  (assert-eq (checked-pow 0 0) (Ok 1))
  (assert-eq (checked-pow 2 -1) (Err (NegativeExponent))))
