(module examples.calc.arith-test)
(import "coil.primitive" :as primitive)
(import "coil.prop" :use *)
(import "examples.calc.arith"
        :use
        [checked-add
         checked-sub
         checked-mul
         checked-div
         checked-rem
         checked-pow])
(import "examples.calc.error"
        :use
        [ErrorKind Overflow DivisionByZero NegativeExponent])

;; The checked operations are compared against the same operation done exactly in
;; 128 bits, where two i64 operands cannot overflow. i128 has no operator impls,
;; so that arithmetic is spelled with the primitives, which work at any width.
(defn wide [(x i64)] (-> i128)
  (cast i128 x))

(defn wide-add [(a i128) (b i128)] (-> i128)
  (primitive/iadd a b))

(defn wide-sub [(a i128) (b i128)] (-> i128)
  (primitive/isub a b))

(defn wide-mul [(a i128) (b i128)] (-> i128)
  (primitive/imul a b))

(defn fits-i64? [(x i128)] (-> bool)
  (and (primitive/icmp-ge x (wide -9223372036854775808))
       (primitive/icmp-le x (wide 9223372036854775807))))

(defn agrees? [(r (Result i64 ErrorKind)) (exact i128)] (-> bool)
  (match r
    (Ok [value] (and (fits-i64? exact) (primitive/icmp-eq (wide value) exact)))
    (Err [kind] (and (not (fits-i64? exact)) (= kind (Overflow))))))

(defn assert-ok [(r (Result i64 ErrorKind)) (expected i64)] (-> void)
  (try (let [value (try-or! r (assert false))] (assert-eq value expected))))

(defn assert-err [(r (Result i64 ErrorKind)) (expected ErrorKind)] (-> void)
  (match r
    (Ok [_] (assert false))
    (Err [kind] (assert-eq kind expected))))

(defprop addition-is-exact-or-overflows
         [(a i64) (b i64)]
         (agrees? (checked-add a b) (wide-add (wide a) (wide b))))

(defprop subtraction-is-exact-or-overflows
         [(a i64) (b i64)]
         (agrees? (checked-sub a b) (wide-sub (wide a) (wide b))))

(defprop multiplication-is-exact-or-overflows
         [(a i64) (b i64)]
         (agrees? (checked-mul a b) (wide-mul (wide a) (wide b))))

(defprop division-and-remainder-reassemble-the-dividend
         [(a i64) (b i64)]
         (assume (!= b 0))
         (try (let [r
                      (try-or! (checked-rem a b)
                               false)]
                (match (checked-div a b)
                  ;; Only MIN / -1 overflows, and its remainder is still 0.
                  (Err [kind] (and (= kind (Overflow)) (= b -1) (= r 0)))
                  (Ok [q]
                      (primitive/icmp-eq (wide a)
                                         (wide-add (wide-mul (wide q) (wide b))
                                                   (wide r))))))))

(deftest dividing-by-zero-is-an-error
         (assert-err (checked-div 7 0) (DivisionByZero))
         (assert-err (checked-rem 7 0) (DivisionByZero)))

(deftest only-min-divided-by-minus-one-overflows
         (assert-err (checked-div -9223372036854775808 -1) (Overflow))
         (assert-ok (checked-rem -9223372036854775808 -1) 0)
         (assert-ok (checked-div -9223372036854775808 1) -9223372036854775808))

(deftest division-truncates-toward-zero
         (assert-ok (checked-div -7 2) -3)
         (assert-ok (checked-rem -7 2) -1)
         (assert-ok (checked-rem 7 -2) 1))

(defprop powers-match-repeated-multiplication
         [(base i64) (e i64)]
         (let [small-base (- (% base 7) 3)
               exponent (% (& e 0xFF) 70)
               (mut exact) (wide 1)]
           (for _
             (range 0 exponent)
             (when (fits-i64? exact)
               (set! exact (wide-mul exact (wide small-base)))))
           (agrees? (checked-pow small-base exponent) exact)))

(deftest powers-of-edge-bases
         (assert-ok (checked-pow 2 62) 4611686018427387904)
         (assert-err (checked-pow 2 63) (Overflow))
         (assert-ok (checked-pow -2 63) -9223372036854775808)
         (assert-ok (checked-pow 1 9223372036854775807) 1)
         (assert-ok (checked-pow 0 0) 1)
         (assert-err (checked-pow 2 -1) (NegativeExponent)))
