(module examples.calc.parser-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.scratch"
        :use
        [ScratchArena scratch-init scratch-allocator scratch-close!])
(import "coil.str" :use [format! StrBuf])
(import "examples.calc.ast" :use [Node Stmt Binding Evaluate Blank])
(import "examples.calc.error"
        :use
        [Span CalcError ErrorKind ExpectedExpression Expected UnknownFunction
         WrongArity])
(import "examples.calc.builtin" :use [Abs])
(import "examples.calc.parser" :use [parse-line])

(defn assert-renders [(n (ptr Node)) (expected (slice u8))] (-> void)
  (let [(mut text) (StrBuf::new (malloc-allocator))]
    (defer (free! (mut text)))
    (format! (mut text) "{}" n)
    (assert-eq (str text) expected)))

;;; The arena a check parses into, closed when the check ends.
(defstruct Trees [(scratch ScratchArena)])

(impl Trees
  (new []
    (-> Trees)
    (let [(mut t) (Trees :scratch (zeroed ScratchArena))]
      (scratch-init (mut (.scratch t)) (malloc-allocator))
      t))
  (parse [(t (mut Trees)) (line (slice u8))]
    (-> (Result Stmt CalcError))
    (parse-line (scratch-allocator (mut (.scratch t))) line)))

(impl Drop Trees
  (drop [(t (mut Trees))]
    (-> void)
    (scratch-close! (mut (.scratch t)))))

;;; Asserts that `line` is an expression that displays as `expected`.
(defn assert-parses [(line (slice u8)) (expected (slice u8))] (-> void)
  (let [(mut trees) (Trees::new)]
    (match (parse (mut trees) line)
      (Ok [(Evaluate [n])] (assert-renders n expected))
      (_ (assert false)))))

(defn assert-blank [(line (slice u8))] (-> void)
  (let [(mut trees) (Trees::new)]
    (match (parse (mut trees) line)
      (Ok [(Blank [])])
      (_ (assert false)))))

(defn assert-fails [(line (slice u8)) (kind ErrorKind) (start i64) (end i64)]
  (-> void)
  (let [(mut trees) (Trees::new)]
    (match (parse (mut trees) line)
      (Ok [_] (assert false))
      (Err [e]
           (assert-eq e
                      (CalcError
                        :kind kind
                        :span (Span :start start :end end)))))))

(deftest multiplication-binds-tighter-than-addition
  (assert-parses "1 + 2 * 3" "(+ 1 (* 2 3))")
  (assert-parses "1 * 2 + 3" "(+ (* 1 2) 3)")
  (assert-parses "8 % 3 - 4 / 2" "(- (% 8 3) (/ 4 2))"))

(deftest arithmetic-operators-associate-left
  (assert-parses "10 - 4 - 3" "(- (- 10 4) 3)")
  (assert-parses "64 / 4 / 2" "(/ (/ 64 4) 2)")
  (assert-parses "7 % 4 * 3" "(* (% 7 4) 3)"))

(deftest exponentiation-associates-right-and-binds-tightest
  (assert-parses "2 ^ 3 ^ 2" "(^ 2 (^ 3 2))")
  (assert-parses "2 * 3 ^ 2" "(* 2 (^ 3 2))"))

(deftest negation-sits-between-multiplication-and-exponentiation
  (assert-parses "-2 ^ 2" "(- (^ 2 2))")
  (assert-parses "-2 * 3" "(* (- 2) 3)")
  (assert-parses "2 ^ -1" "(^ 2 (- 1))")
  (assert-parses "--x" "(- (- x))"))

(deftest parentheses-override-precedence
  (assert-parses "(1 + 2) * 3" "(* (+ 1 2) 3)")
  (assert-parses "2 ^ (3 ^ 2)" "(^ 2 (^ 3 2))")
  (assert-parses "((x))" "x"))

(deftest calls-take-expressions-as-arguments
  (assert-parses "max(a, b + 1, 3)" "(max a (+ b 1) 3)")
  (assert-parses "abs(-x) * 2" "(* (abs (- x)) 2)"))

(deftest a-let-binds-a-name
  (let [(mut trees) (Trees::new)]
    (match (parse (mut trees) "let total = a + 1")
      (Ok [(Binding [name value])]
          (assert-eq name "total")
          (assert-renders value "(+ a 1)"))
      (_ (assert false)))))

(deftest blank-and-comment-lines-are-blank
  (assert-blank "")
  (assert-blank "   ")
  (assert-blank "# just a comment"))

(deftest errors-point-at-the-offending-token
  (assert-fails "1 + * 2" (ExpectedExpression) 4 5)
  (assert-fails "1 +" (ExpectedExpression) 3 3)
  (assert-fails "(1 + 2" (Expected "')'") 6 6)
  (assert-fails "1 2"
                (Expected "an operator or the end of the line")
                2
                3)
  (assert-fails "let = 3" (Expected "a variable name") 4 5)
  (assert-fails "let x 3" (Expected "'='") 6 7)
  (assert-fails "min(1 2)" (Expected "')' or ','") 6 7))

(deftest calls-are-checked-against-the-builtins
  (assert-fails "sqrt(4)" (UnknownFunction "sqrt") 0 4)
  (assert-fails "abs(1, 2)" (WrongArity (Abs) 2) 0 9)
  (assert-fails "abs()" (WrongArity (Abs) 0) 0 5))
