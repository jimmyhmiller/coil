(module examples.calc.session-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.debug-allocator"
        :use
        [DebugAllocator])
(import "examples.calc.builtin" :use [Min])
(import "examples.calc.error"
        :use
        [Span CalcError ErrorKind UnknownVariable DivisionByZero
         NegativeExponent Overflow WrongArity])
(import "examples.calc.session"
        :use
        [Session run-line! Outcome Value Bound Nothing])

(defn assert-outcome [(s (mut Session)) (line (slice u8)) (expected Outcome)]
  (-> void)
  (assert-eq (run-line! (mut s) line) (Ok expected)))

(defn assert-value [(s (mut Session)) (line (slice u8)) (expected i64)]
  (-> void)
  (assert-outcome (mut s) line (Value expected)))

(defn assert-fails [(s (mut Session))
                    (line (slice u8))
                    (kind ErrorKind)
                    (start i64)
                    (end i64)] (-> void)
  (assert-eq (run-line! (mut s) line)
             (Err (CalcError
                    :kind kind
                    :span (Span :start start :end end)))))

(deftest expressions-evaluate
  (let [(mut s) (Session::new (malloc-allocator))]
    (assert-value (mut s) "1 + 2 * 3" 7)
    (assert-value (mut s) "(1 + 2) * 3" 9)
    (assert-value (mut s) "10 - 4 - 3" 3)
    (assert-value (mut s) "2 ^ 3 ^ 2" 512)
    (assert-value (mut s) "-2 ^ 2" -4)
    (assert-value (mut s) "-7 / 2" -3)
    (assert-value (mut s) "-7 % 3" -1)))

(deftest builtins-evaluate
  (let [(mut s) (Session::new (malloc-allocator))]
    (assert-value (mut s) "min(4, -2, 9)" -2)
    (assert-value (mut s) "max(4, -2, 9)" 9)
    (assert-value (mut s) "max(7)" 7)
    (assert-value (mut s) "abs(3 - 10)" 7)))

(deftest variables-persist-across-lines
  (let [(mut s) (Session::new (malloc-allocator))]
    (assert-outcome (mut s) "let width = 12" (Bound "width" 12))
    (assert-outcome (mut s) "let height = width - 5" (Bound "height" 7))
    (assert-value (mut s) "width * height" 84)
    (assert-outcome (mut s) "let width = width + 1" (Bound "width" 13))
    (assert-value (mut s) "width" 13)))

(deftest blank-lines-do-nothing
  (let [(mut s) (Session::new (malloc-allocator))]
    (assert-outcome (mut s) "" (Nothing))
    (assert-outcome (mut s) "  # a note" (Nothing))))

(deftest a-failed-binding-changes-nothing
  (let [(mut s) (Session::new (malloc-allocator))]
    (assert-outcome (mut s) "let x = 5" (Bound "x" 5))
    (assert-fails (mut s) "let x = x / 0" (DivisionByZero) 12 13)
    (assert-value (mut s) "x" 5)
    (assert-fails (mut s) "let y = 1 / 0" (DivisionByZero) 12 13)
    (assert-fails (mut s) "y" (UnknownVariable "y") 0 1)))

(deftest evaluation-errors-point-at-their-cause
  (let [(mut s) (Session::new (malloc-allocator))]
    (assert-fails (mut s) "1 + depth * 2" (UnknownVariable "depth") 4 9)
    ;; The divisor, parentheses included, is what is wrong.
    (assert-fails (mut s) "10 / (3 - 3)" (DivisionByZero) 5 12)
    (assert-fails (mut s) "7 % 0" (DivisionByZero) 4 5)
    (assert-fails (mut s) "2 ^ -1" (NegativeExponent) 4 6)
    ;; An overflow is the whole operation's fault.
    (assert-fails (mut s) "1 + 9223372036854775807 * 2" (Overflow) 4 27)
    (assert-fails (mut s) "-(-9223372036854775807 - 1)" (Overflow) 0 27)
    (assert-fails (mut s) "min()" (WrongArity (Min) 0) 0 5)))

(deftest a-session-frees-everything-it-allocates
  (let [debug (DebugAllocator::new (malloc-allocator))]
    (let [(mut s) (Session::new (view debug))]
      (assert-outcome (mut s)
                      "let total = max(1, 2, 3) * (4 + 5)"
                      (Bound "total" 27))
      (assert-outcome (mut s) "let total = total + 1" (Bound "total" 28))
      (assert-fails (mut s) "total / (total - 28)" (DivisionByZero) 8 20))
    (assert-eq (deinit! debug) 0)))
