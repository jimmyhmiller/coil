(module examples.calc.lexer-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.iter" :use [Indexed])
(import "coil.prop" :use * :exclude [Span])
(import "coil.str" :use [sb-new sb-format! sb-str sb-free!])
(import "examples.calc.error"
        :use
        [Span CalcError ErrorKind UnexpectedChar NumberTooLarge])
(import "examples.calc.lexer"
        :use
        [Lexer lexer next-token! Token Tok Num Ident Let Operator LParen RParen
         Comma Equals End Plus Minus Star Slash Percent Caret])

(defn assert-token [(lx (mut Lexer)) (kind Tok) (start i64) (end i64)] (-> void)
  (assert-eq (next-token! (mut lx))
             (Ok (Token
                   :kind kind
                   :span (Span :start start :end end)))))

(defn assert-error [(lx (mut Lexer)) (kind ErrorKind) (start i64) (end i64)]
  (-> void)
  (assert-eq (next-token! (mut lx))
             (Err (CalcError
                    :kind kind
                    :span (Span :start start :end end)))))

(deftest operators-and-punctuation
  (let [(mut lx) (lexer "+-*/%^(),=")
        expected
          [(Operator (Plus))
           (Operator (Minus))
           (Operator (Star))
           (Operator (Slash))
           (Operator (Percent))
           (Operator (Caret))
           (LParen)
           (RParen)
           (Comma)
           (Equals)]]
    (for (Indexed :index i :value kind) (enumerate expected)
      (assert-token (mut lx) kind i (+ i 1)))))

(deftest words-numbers-and-spans
  (let [(mut lx) (lexer "let rate_2 = 42")]
    (assert-token (mut lx) (Let) 0 3)
    (assert-token (mut lx) (Ident "rate_2") 4 10)
    (assert-token (mut lx) (Equals) 11 12)
    (assert-token (mut lx) (Num 42) 13 15)
    (assert-token (mut lx) (End) 15 15)))

(deftest a-keyword-prefix-is-still-a-name
  (let [(mut lx) (lexer "letter")]
    (assert-token (mut lx) (Ident "letter") 0 6)))

(deftest blanks-and-comments-are-skipped
  (let [(mut lx) (lexer "\t 7  # the rest is ignored")]
    (assert-token (mut lx) (Num 7) 2 3)
    (assert-token (mut lx) (End) 26 26)))

(deftest end-repeats
  (let [(mut lx) (lexer "")]
    (assert-token (mut lx) (End) 0 0)
    (assert-token (mut lx) (End) 0 0)))

(deftest an-unknown-character-is-an-error-at-that-character
  (let [(mut lx) (lexer "1 $ 2")]
    (assert-token (mut lx) (Num 1) 0 1)
    (assert-error (mut lx) (UnexpectedChar) 2 3)))

(deftest numbers-must-fit-in-64-bits
  (let [(mut lx) (lexer "9223372036854775807 9223372036854775808")]
    (assert-token (mut lx) (Num 9223372036854775807) 0 19)
    (assert-error (mut lx) (NumberTooLarge) 20 39)))

(defprop every-non-negative-i64-lexes-to-itself [(n i64)]
  (let [value (& n 9223372036854775807)
        (mut digits) (sb-new (malloc-allocator))]
    (defer (sb-free! (mut digits)))
    (sb-format! (mut digits) "{}" value)
    (let [(mut lx) (lexer (sb-str digits))]
      (= (next-token! (mut lx))
         (Ok (Token
               :kind (Num value)
               :span (Span :start 0 :end (len (sb-str digits)))))))))
