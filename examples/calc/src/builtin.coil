(module examples.calc.builtin)

;;; The functions a calculation can call, as `min(a, b, …)`, `max(…)` and `abs(x)`.
(defsum Builtin (Min) (Max) (Abs))

(derive Debug Eq Builtin)

(def ALL-BUILTINS [(Min) (Max) (Abs)])

;;; The name a builtin is called by.
(defn builtin-name [(b Builtin)] (-> (slice u8))
  (match b
    (Min [] "min")
    (Max [] "max")
    (Abs [] "abs")))

;;; The builtin called `name`, if there is one.
(defn builtin-named [(name (slice u8))] (-> (Option Builtin))
  (block :found
    (for b ALL-BUILTINS
      (when (= (builtin-name b) name) (return-from :found (Some b))))
    (None)))

(impl Display Builtin
  (display-fmt [(b Builtin) (f (ptr Formatter))]
    (-> i64)
    (fmt (formatter-writer f) "{}" (builtin-name b))
    0))

;;; How many arguments a builtin accepts.
(defsum Arity
  (Exactly [(count i64)])
  (AtLeast [(count i64)]))

(defn arity [(b Builtin)] (-> Arity)
  (match b
    (Min [] (AtLeast 1))
    (Max [] (AtLeast 1))
    (Abs [] (Exactly 1))))

(defn accepts? [(a Arity) (given i64)] (-> bool)
  (match a
    (Exactly [n] (= given n))
    (AtLeast [n] (>= given n))))

(defn arguments [(n i64)] (-> (slice u8))
  (if (= n 1) "argument" "arguments"))

(impl Display Arity
  (display-fmt [(a Arity) (f (ptr Formatter))]
    (-> i64)
    (let [w (formatter-writer f)]
      (match a
        (Exactly [n] (fmt w "exactly {} {}" n (arguments n)))
        (AtLeast [n] (fmt w "at least {} {}" n (arguments n)))))
    0))
