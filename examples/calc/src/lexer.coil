(module examples.calc.lexer)
(import "coil.slice" :use [subslice])
(import "examples.calc.arith" :use [checked-add checked-mul])
(import "examples.calc.error"
        :use
        [Span CalcError ErrorKind UnexpectedChar NumberTooLarge])
(import "coil.cc" :as cc)

;;; The binary operators; `Minus` doubles as negation.
(defsum Op (Plus) (Minus) (Star) (Slash) (Percent) (Caret))

(derive Debug Eq Op)

(impl Display Op
  (display-fmt [(op Op) (f (ptr Formatter))]
    (-> i64)
    (fmt (writer f)
         "{}"
         (match op
           (Plus [] "+")
           (Minus [] "-")
           (Star [] "*")
           (Slash [] "/")
           (Percent [] "%")
           (Caret [] "^")))
    0))

;;; What a token is, without where it is.
(defsum Tok
  (Num [(value i64)])
  (Ident [(name (slice u8))])
  (Let)
  (Operator [(op Op)])
  (LParen)
  (RParen)
  (Comma)
  (Equals)
  (End))

(derive Debug Eq Tok)

;;; A token and the bytes of the line it came from.
(defstruct Token [(kind Tok) (span Span)])

(derive Debug Eq Token)

;;; Produces the tokens of one line on demand. It allocates nothing: names are
;;; slices of the line.
(defstruct Lexer [(line (slice u8)) (pos i64)])

(defn lexer [(line (slice u8))] (-> Lexer)
  (Lexer :line line :pos 0))

(defn digit? [(c u8)] (-> bool)
  (and (>= c #\0) (<= c #\9)))

(defn ident-start? [(c u8)] (-> bool)
  (or (and (>= c #\a) (<= c #\z)) (and (>= c #\A) (<= c #\Z)) (= c #\_)))

(defn ident-char? [(c u8)] (-> bool)
  (or (ident-start? c) (digit? c)))

(defn at-end? [(lx Lexer)] (-> bool)
  (>= (.pos lx) (len (.line lx))))

(defn current-byte [(lx Lexer)] (-> u8)
  (get (.line lx) (.pos lx)))

;;; Advances past bytes satisfying `keep?` and returns the span consumed.
(defn scan-while! [(lx (mut Lexer)) (keep? (fnptr (cc/C) [u8] bool))] (-> Span)
  (let [start (.pos lx)]
    (while (and (not (at-end? lx)) (keep? (current-byte lx)))
      (set! (.pos lx) (+ (.pos lx) 1)))
    (Span :start start :end (.pos lx))))

(defn blank? [(c u8)] (-> bool)
  (or (= c #\space) (= c #\tab) (= c #\return)))

;;; Skips spaces, tabs and a `#` comment, which runs to the end of the line.
(defn skip-trivia! [(lx (mut Lexer))] (-> void)
  (scan-while! (mut lx) (fnptr-of blank?))
  (when (and (not (at-end? lx)) (= (current-byte lx) #\#))
    (set! (.pos lx) (len (.line lx)))))

(defn text [(lx Lexer) (span Span)] (-> (slice u8))
  (subslice (.line lx) (.start span) (.end span)))

(defn digits-value [(digits (slice u8))] (-> (Result i64 ErrorKind))
  (try (let [(mut value) 0]
         (for c digits
           (set! value
                 (try! (checked-add (try! (checked-mul value 10))
                                    (- (cast i64 c) #\0)))))
         (Ok value))))

(defn lex-number! [(lx (mut Lexer))] (-> (Result Token CalcError))
  (let [span (scan-while! (mut lx) (fnptr-of digit?))]
    (try (let [value
                 (try-or! (digits-value (text lx span))
                          (Err (CalcError :kind (NumberTooLarge) :span span)))]
           (Ok (Token :kind (Num value) :span span))))))

(defn lex-word! [(lx (mut Lexer))] (-> Token)
  (let [span (scan-while! (mut lx) (fnptr-of ident-char?))
        word (text lx span)]
    (Token :kind (if (= word "let") (Let) (Ident word)) :span span)))

(defn symbol-tok [(c u8)] (-> (Option Tok))
  (match c
    (#\+ (Some (Operator (Plus))))
    (#\- (Some (Operator (Minus))))
    (#\* (Some (Operator (Star))))
    (#\/ (Some (Operator (Slash))))
    (#\% (Some (Operator (Percent))))
    (#\^ (Some (Operator (Caret))))
    (#\( (Some (LParen)))
    (#\) (Some (RParen)))
    (#\, (Some (Comma)))
    (#\= (Some (Equals)))
    (_ (None))))

(defn lex-symbol! [(lx (mut Lexer))] (-> (Result Token CalcError))
  (let [start (.pos lx)
        span (Span :start start :end (+ start 1))]
    (if-let [(Some [kind]) (symbol-tok (current-byte lx))]
      (do
        (set! (.pos lx) (.end span))
        (Ok (Token :kind kind :span span)))
      (Err (CalcError :kind (UnexpectedChar) :span span)))))

;;; The next token of the line. At the end of the line this is `End`, with an
;;; empty span just past the last byte, however often it is asked for.
(defn next-token! [(lx (mut Lexer))] (-> (Result Token CalcError))
  (skip-trivia! (mut lx))
  (if (at-end? lx)
      (Ok (Token
            :kind (End)
            :span (Span :start (.pos lx) :end (.pos lx))))
      (let [c (current-byte lx)]
        (cond (digit? c) (lex-number! (mut lx))
              (ident-start? c) (Ok (lex-word! (mut lx)))
              :else (lex-symbol! (mut lx))))))
