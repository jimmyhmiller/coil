(module examples.calc.ast)
(import "examples.calc.builtin" :use [Builtin])
(import "examples.calc.error" :use [Span])
(import "examples.calc.lexer" :use [Op])

;;; An expression. Children are nodes owned by the arena the parser was given.
(defsum Expr
  (Literal [(value i64)])
  (Var [(name (slice u8))])
  (Negate [(operand (ptr Node))])
  (Binary [(op Op) (left (ptr Node)) (right (ptr Node))])
  (Call [(builtin Builtin) (args (slice (ptr Node)))]))

;;; An expression and the source it was parsed from, so evaluation errors can
;;; point at it.
(defstruct Node [(expr Expr) (span Span)])

;;; One line of input.
(defsum Stmt
  (Binding [(name (slice u8)) (value (ptr Node))])
  (Evaluate [(value (ptr Node))])
  (Blank))

;; Displays as a fully parenthesised prefix form, `1 + 2 * 3` as `(+ 1 (* 2 3))`,
;; which makes precedence and associativity visible.
(impl Display Node
  (display-fmt [(n Node) (f (ptr Formatter))]
    (-> i64)
    (let [w (writer f)]
      (match (.expr n)
        (Literal [value] (fmt w "{}" value))
        (Var [name] (fmt w "{}" name))
        (Negate [operand] (fmt w "(- {})" operand))
        (Binary [op left right]
                (fmt w "({} {} {})" op left right))
        (Call [builtin args]
              (fmt w "({}" builtin)
              (for arg args (fmt w " {}" arg))
              (fmt w ")"))))
    0))
