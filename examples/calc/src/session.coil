(module examples.calc.session)
(import "coil.alloc" :use [Allocator])
(import "coil.hashmap" :use [HashMap])
(import "coil.scratch"
        :use
        [ScratchArena scratch-init scratch-allocator scratch-recycle!
         scratch-close!])
(import "coil.str" :use [str-keyops])
(import "examples.calc.ast" :use [Binding Evaluate Blank])
(import "examples.calc.error" :use [CalcError])
(import "examples.calc.eval" :use [eval])
(import "examples.calc.parser" :use [parse-line])

;;; What running one line produced.
(defsum Outcome
  (Value [(value i64)])
  (Bound [(name (slice u8)) (value i64)])
  (Nothing))

(derive Debug Eq Outcome)

;;; A calculator's state across lines. Variables persist, and copy their names,
;;; since a line is gone once it has run. Each line's syntax tree lives in a
;;; scratch arena that is recycled when the next line starts, so a session holds
;;; no more tree than its largest line needed.
(defstruct Session [(vars (HashMap (slice u8) i64)) (arena ScratchArena)])

(impl Session
  (new [(heap (dyn Allocator))]
    (-> Session)
    (let [(mut s)
            (Session
              :vars
                (HashMap::new [(slice u8) i64]
                              heap
                              (str-keyops))
              :arena (zeroed ScratchArena))]
      (scratch-init (mut (.arena s)) heap)
      s)))

(impl Drop Session
  (drop [(s (mut Session))]
    (-> void)
    (free! (mut (.vars s)))
    (scratch-close! (mut (.arena s)))))

;;; Runs one line: parses it, evaluates it, and stores a `let` binding. On an
;;; error nothing changes.
(defn run-line! [(s (mut Session)) (line (slice u8))]
  (-> (Result Outcome CalcError))
  (scratch-recycle! (mut (.arena s)))
  (try (match (try! (parse-line (scratch-allocator (mut (.arena s))) line))
         (Blank [] (Ok (Nothing)))
         (Evaluate [e] (Ok (Value (try! (eval (.vars s) e)))))
         (Binding [name e]
                  (let [value (try! (eval (.vars s) e))]
                    (set! (mut (.vars s)) name value)
                    (Ok (Bound name value)))))))
