;;; calc: an integer calculator REPL.
;;;
;;; Each line is `let NAME = EXPR`, an expression, or blank; `#` starts a comment.
;;; Expressions have `+ - * / % ^`, unary minus, parentheses, variables, and the
;;; builtins `min(…)`, `max(…)` and `abs(x)`. Arithmetic is on 64-bit integers and
;;; is exact: overflow and division by zero are errors, never wrapped or rounded
;;; values. An error points at the part of the line it is about.
;;;
;;;   coil run examples/calc                         # runs data/session.txt
;;;   coil run examples/calc -- FILE                 # runs FILE
;;;   cd examples/calc && coil build && build/release/calc   # interactive
;;;
;;; Reading a file or a pipe echoes each line after the prompt, so the output reads
;;; like a session at the terminal. The bundled session prints:
;;;
;;;   > # Integer arithmetic with the usual precedence.
;;;   > 1 + 2 * 3
;;;   7
;;;   ...
;;;   > let width = 12
;;;   width = 12
;;;   ...
;;;   > 1 + * 2
;;;         ^ expected an expression
;;;   > 10 / (width - 12)
;;;          ^^^^^^^^^^^^ division by zero
(module examples.calc.main)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.args" :use [init! count nth])
(import "coil.fs" :use [file-reader file-close open-file O_RDONLY])
(import "coil.io"
        :use
        [Reader IoError BufferedInput buffered-input-reader stdin
         read-line-alloc owned-bytes-slice owned-bytes-free])
(import "examples.calc.error" :use [CalcError Underline])
(import "examples.calc.session"
        :use
        [Session run-line! Outcome Value Bound Nothing])

(extern isatty :cc c [i32] (-> i32))

(const PROMPT "> ")

(const MAX-LINE-BYTES 4096)

(defn show [(result (Result Outcome CalcError))] (-> void)
  (match result
    (Ok [(Value [value])] (println "{}" value))
    (Ok [(Bound [name value])] (println "{} = {}" name value))
    (Ok [(Nothing [])])
    (Err [(CalcError :kind kind :span span)]
         (println "{} {}" (Underline :span span :indent (len PROMPT)) kind))))

;;; Runs every line of `input`, failing only if reading does. Unless
;;; `interactive`, each line is echoed after the prompt, since nobody typed it.
(defn run-session [(input (ptr Reader)) (interactive bool)]
  (-> (Result i64 IoError))
  (let [heap (malloc-allocator)
        (mut session) (Session::new heap)
        (mut buffered) (zeroed BufferedInput)
        lines (buffered-input-reader (mut buffered) input)]
    (block :session
      (loop (when interactive (print "{}" PROMPT))
        (match (read-line-alloc heap lines MAX-LINE-BYTES)
          (Err [(Eof [])] (break))
          (Err [e] (return-from :session (Err e)))
          (Ok [(mut owned)]
              (defer (owned-bytes-free heap (mut owned)))
              (let [line (owned-bytes-slice owned)]
                (unless interactive (println "{}{}" PROMPT line))
                (show (run-line! (mut session) line))))))
      (when interactive (println ""))
      (Ok 0))))

(defn run-file [(path (slice u8))] (-> (Result i64 IoError))
  (try (let [(mut file) (try! (open-file (malloc-allocator) path O_RDONLY 0))
             (mut reader) (zeroed Reader)
             result (run-session (file-reader (mut reader) (mut file)) false)]
         (try! (file-close (mut file)))
         result)))

(defn exit-status [(result (Result i64 IoError)) (source (slice u8))] (-> i64)
  (match result
    (Ok [_] 0)
    (Err [e] (eprintln "calc: cannot read {}: {}" source e) 1)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (init! argc argv)
  (if (> (count) 1)
      (exit-status (run-file (nth 1)) (nth 1))
      (exit-status (run-session (stdin) (= (isatty 0) 1)) "standard input")))
