(module examples.calc.parser)
(import "coil.alloc" :as alloc :use [Allocator])
(import "coil.arraylist" :use [al-new al-slice])
(import "coil.result" :use [ok-or res-map])
(import "coil.try" :use [try try!])
(import "examples.calc.ast"
        :use
        [Node Expr Literal Var Negate Binary Call Stmt Binding Evaluate Blank])
(import "examples.calc.builtin" :use [builtin-named arity accepts?])
(import "examples.calc.error"
        :use
        [Span
         span-join
         CalcError
         ErrorKind
         ExpectedExpression
         Expected
         UnknownFunction
         WrongArity])
(import "examples.calc.lexer"
        :use
        [Lexer
         lexer
         next-token!
         Token
         Tok
         Num
         Ident
         Let
         Operator
         LParen
         RParen
         Comma
         Equals
         End
         Op
         Plus
         Minus
         Star
         Slash
         Percent
         Caret])

;; A Pratt parser. Each binary operator has a left and a right binding power: an
;; operator joins the expression to its left only if its left power is at least
;; the power the caller is parsing at, and then parses its right operand at its
;; right power. A right power one above the left makes the operator
;; left-associative; one below makes it right-associative.

;;; The binding powers of an infix operator.
(defstruct Power [(left i64) (right i64)])

(defn infix-power [(op Op)] (-> Power)
  (match op
    (Plus [] (Power :left 10 :right 11))
    (Minus [] (Power :left 10 :right 11))
    (Star [] (Power :left 20 :right 21))
    (Slash [] (Power :left 20 :right 21))
    (Percent [] (Power :left 20 :right 21))
    (Caret [] (Power :left 31 :right 30))))

;; Negation binds tighter than `*` but looser than `^`, so `-2^2` is `-(2^2)`.
(const NEGATE-POWER 25)

(defstruct Parser [(lexer Lexer) (current Token) (arena (dyn Allocator))])

(defn peek [(p Parser)] (-> Tok)
  (.kind (.current p)))

;;; Moves to the next token and returns the one moved past.
(defn advance! [(p (mut Parser))] (-> (Result Token CalcError))
  (try (let [token (.current p)]
         (set! (.current p) (try! (next-token! (mut (.lexer p)))))
         (Ok token))))

(defn error-here [(p Parser) (kind ErrorKind)] (-> CalcError)
  (CalcError :kind kind :span (.span (.current p))))

;;; Consumes a `want` token, or fails saying `what` was expected.
(defn expect! [(p (mut Parser)) (want Tok) (what (slice u8))] (-> (Result Token
                                                                          CalcError))
  (if (= (peek p) want)
      (advance! (mut p))
      (Err (error-here p (Expected what)))))

(defn node [(p Parser) (expr Expr) (span Span)] (-> (ptr Node))
  (alloc/box! (.arena p) Node (Node :expr expr :span span)))

(defn parse-group [(p (mut Parser))] (-> (Result (ptr Node) CalcError))
  (try (let [open (try! (advance! (mut p)))
             inner (try! (parse-expr (mut p) 0))
             close (try! (expect! (mut p) (RParen) "')'"))]
         ;; Widen the span over the parentheses so errors underline all of `(2 - 2)`.
         (set! (.span inner) (span-join (.span open) (.span close)))
         (Ok inner))))

(defn parse-args [(p (mut Parser))] (-> (Result (slice (ptr Node)) CalcError))
  (try (let [(mut args) (al-new [(ptr Node)] (.arena p))]
         (unless (= (peek p) (RParen))
           (push! (mut args) (try! (parse-expr (mut p) 0)))
           (while (= (peek p) (Comma))
             (try! (advance! (mut p)))
             (push! (mut args) (try! (parse-expr (mut p) 0)))))
         (Ok (al-slice args)))))

(defn parse-call [(p (mut Parser)) (name (slice u8)) (name-span Span)] (-> (Result (ptr Node)
                                                                                   CalcError))
  (try (let [builtin
               (try! (ok-or (builtin-named name)
                            (CalcError :kind (UnknownFunction name)
                              :span name-span)))]
         (try! (advance! (mut p)))
         (let [args (try! (parse-args (mut p)))
               close (try! (expect! (mut p) (RParen) "')' or ','"))
               span (span-join name-span (.span close))]
           (if (accepts? (arity builtin) (len args))
               (Ok (node p (Call builtin args) span))
               (Err (CalcError :kind (WrongArity builtin (len args)) :span span)))))))

(defn parse-prefix [(p (mut Parser))] (-> (Result (ptr Node) CalcError))
  (try (let [token (.current p)
             span (.span token)]
         (match (.kind token)
           (Num [value]
                (do
                  (try! (advance! (mut p)))
                  (Ok (node p (Literal value) span))))
           (Ident [name]
                  (do
                    (try! (advance! (mut p)))
                    (if (= (peek p) (LParen))
                        (parse-call (mut p) name span)
                        (Ok (node p (Var name) span)))))
           (Operator [(Minus [])]
                     (do
                       (try! (advance! (mut p)))
                       (let [operand (try! (parse-expr (mut p) NEGATE-POWER))]
                         (Ok (node p
                                   (Negate operand)
                                   (span-join span (.span operand)))))))
           (LParen [] (parse-group (mut p)))
           (_ (Err (error-here p (ExpectedExpression))))))))

(defn infix-op [(t Tok)] (-> (Option Op))
  (match t
    (Operator [op] (Some op))
    (_ (None))))

;;; Parses an expression whose operators all bind at least as tightly as `min-power`.
(defn parse-expr [(p (mut Parser)) (min-power i64)] (-> (Result (ptr Node)
                                                                CalcError))
  (try (let [(mut left) (try! (parse-prefix (mut p)))]
         (loop (match (infix-op (peek p))
                 (None [] (break))
                 (Some [op]
                       (let [(Power :left lp :right rp) (infix-power op)]
                         (when (< lp min-power) (break))
                         (try! (advance! (mut p)))
                         (let [right (try! (parse-expr (mut p) rp))]
                           (set! left
                                 (node p
                                       (Binary
                                         :op op
                                         :left left
                                         :right right)
                                       (span-join (.span left) (.span right)))))))))
         (Ok left))))

(defn parse-let [(p (mut Parser))] (-> (Result Stmt CalcError))
  (try (try! (advance! (mut p)))
       (match (peek p)
         (Ident [name]
                (do
                  (try! (advance! (mut p)))
                  (try! (expect! (mut p) (Equals) "'='"))
                  (Ok (Binding :name name :value (try! (parse-expr (mut p) 0))))))
         (_ (Err (error-here p (Expected "a variable name")))))))

(defn parse-stmt [(p (mut Parser))] (-> (Result Stmt CalcError))
  (match (peek p)
    (End [] (Ok (Blank)))
    (Let [] (parse-let (mut p)))
    (_ (res-map (parse-expr (mut p) 0) (fn [e] (Evaluate e))))))

;;; Parses one line: `let NAME = EXPR`, an expression, or nothing. Nodes are
;;; allocated from `arena` and names borrow from `line`, so the statement lives
;;; as long as both do.
(defn parse-line [(arena (dyn Allocator)) (line (slice u8))] (-> (Result Stmt
                                                                         CalcError))
  (try (let [(mut lx) (lexer line)
             first (try! (next-token! (mut lx)))
             (mut p)
               (Parser
                 :lexer lx
                 :current first
                 :arena arena)
             stmt (try! (parse-stmt (mut p)))]
         (try! (expect! (mut p) (End) "an operator or the end of the line"))
         (Ok stmt))))
