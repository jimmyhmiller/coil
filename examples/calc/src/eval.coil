(module examples.calc.eval)
(import "coil.hashmap" :use [HashMap])
(import "coil.result" :use [ok-or])
(import "coil.try" :use [try try!])
(import "examples.calc.arith"
        :use
        [checked-add checked-sub checked-mul checked-div checked-rem checked-pow
         checked-neg checked-abs])
(import "examples.calc.ast" :use [Node Literal Var Negate Binary Call])
(import "examples.calc.builtin" :use [Builtin Min Max Abs])
(import "examples.calc.error"
        :use
        [Span CalcError ErrorKind UnknownVariable DivisionByZero
         NegativeExponent])
(import "examples.calc.lexer" :use [Op Plus Minus Star Slash Percent Caret])

(defn apply-op [(op Op) (a i64) (b i64)] (-> (Result i64 ErrorKind))
  (match op
    (Plus [] (checked-add a b))
    (Minus [] (checked-sub a b))
    (Star [] (checked-mul a b))
    (Slash [] (checked-div a b))
    (Percent [] (checked-rem a b))
    (Caret [] (checked-pow a b))))

;;; Where to point for a failed operation: at the right operand when it alone is
;;; to blame, otherwise at the whole operation.
(defn blame [(kind ErrorKind) (whole Span) (right Span)] (-> Span)
  (match kind
    (DivisionByZero [] right)
    (NegativeExponent [] right)
    (_ whole)))

(defn located [(span Span) (r (Result i64 ErrorKind))]
  (-> (Result i64 CalcError))
  (match r
    (Ok [value] (Ok value))
    (Err [kind] (Err (CalcError :kind kind :span span)))))

;;; The argument that `better?` prefers over every other. The parser has checked
;;; that there is at least one.
(defn extremum [(env (HashMap (slice u8) i64))
                (args (slice (ptr Node)))
                (better? (fnptr c [i64 i64] bool))] (-> (Result i64 CalcError))
  (try (let [(mut best) (try! (eval env (get args 0)))]
         (for arg (skip 1 args)
           (let [value (try! (eval env arg))]
             (when (better? value best) (set! best value))))
         (Ok best))))

(defn call-builtin [(env (HashMap (slice u8) i64))
                    (builtin Builtin)
                    (args (slice (ptr Node)))
                    (span Span)] (-> (Result i64 CalcError))
  (match builtin
    (Min [] (extremum env args (fn [a b] (< a b))))
    (Max [] (extremum env args (fn [a b] (> a b))))
    (Abs [] (try (located span (checked-abs (try! (eval env (get args 0)))))))))

;;; The value of the expression at `n`, looking variables up in `env`.
(defn eval [(env (HashMap (slice u8) i64)) (n (ptr Node))]
  (-> (Result i64 CalcError))
  (let [span (.span n)]
    (match (.expr n)
      (Literal [value] (Ok value))
      (Var [name]
           (ok-or (get env name)
                  (CalcError :kind (UnknownVariable name) :span span)))
      (Negate [operand]
              (try (located span (checked-neg (try! (eval env operand))))))
      (Binary [op left right]
              (try (let [a (try! (eval env left))
                         b (try! (eval env right))]
                     (match (apply-op op a b)
                       (Ok [value] (Ok value))
                       (Err [kind]
                            (Err (CalcError
                                   :kind kind
                                   :span (blame kind span (.span right)))))))))
      (Call [builtin args] (call-builtin env builtin args span)))))
