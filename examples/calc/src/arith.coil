(module examples.calc.arith)

;; Machine arithmetic on i64 wraps, and division by zero or `MIN / -1` is undefined
;; behaviour, so every operation the calculator performs goes through here and
;; turns those cases into errors.
(import "coil.integer" :as integer)
(import "examples.calc.error"
        :use
        [ErrorKind Overflow DivisionByZero NegativeExponent])

(defn checked [(r (integer/Overflow i64))] (-> (Result i64 ErrorKind))
  (if (.overflow r) (Err (Overflow)) (Ok (.value r))))

;;; `a + b`, or `Overflow`.
(defn checked-add [(a i64) (b i64)] (-> (Result i64 ErrorKind))
  (checked (integer/overflowing-add a b)))

;;; `a - b`, or `Overflow`.
(defn checked-sub [(a i64) (b i64)] (-> (Result i64 ErrorKind))
  (checked (integer/overflowing-sub a b)))

;;; `a * b`, or `Overflow`.
(defn checked-mul [(a i64) (b i64)] (-> (Result i64 ErrorKind))
  (checked (integer/overflowing-mul a b)))

;;; `-a`, or `Overflow` for the one negative value with no positive counterpart.
(defn checked-neg [(a i64)] (-> (Result i64 ErrorKind))
  (checked-sub 0 a))

;;; The magnitude of `a`, or `Overflow` as for `checked-neg`.
(defn checked-abs [(a i64)] (-> (Result i64 ErrorKind))
  (if (< a 0) (checked-neg a) (Ok a)))

;;; Division truncating toward zero, like C.
(defn checked-div [(a i64) (b i64)] (-> (Result i64 ErrorKind))
  (match b
    (0 (Err (DivisionByZero)))
    (-1 (checked-neg a))
    (_ (Ok (/ a b)))))

;;; The remainder of `checked-div`; it takes the sign of `a`.
(defn checked-rem [(a i64) (b i64)] (-> (Result i64 ErrorKind))
  (match b
    (0 (Err (DivisionByZero)))
    (-1 (Ok 0))
    (_ (Ok (% a b)))))

;;; `base` raised to `exponent` by repeated squaring.
(defn checked-pow [(base i64) (exponent i64)] (-> (Result i64 ErrorKind))
  (if (< exponent 0)
      (Err (NegativeExponent))
      (try (let [(mut result) 1
                 (mut square) base
                 (mut e) exponent]
             (while (> e 0)
               (when (= (& e 1) 1)
                 (set! result (try! (checked-mul result square))))
               (set! e (>> e 1))
               ;; Squaring only when another bit remains means an overflow here is
               ;; one the result would have hit anyway.
               (when (> e 0) (set! square (try! (checked-mul square square)))))
             (Ok result)))))
