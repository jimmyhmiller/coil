(module examples.calc.error)
(import "examples.calc.builtin" :use [Builtin arity])

;;; A half-open byte range `[start, end)` of one input line.
(defstruct Span [(start i64) (end i64)])

(derive Debug Eq Span)

;;; The smallest span covering both `a` and `b`, which must be in order.
(defn span-join [(a Span) (b Span)] (-> Span)
  (Span :start (.start a) :end (.end b)))

;;; Everything that can go wrong with a line, from lexing through evaluation.
(defsum ErrorKind
  (UnexpectedChar)
  (NumberTooLarge)
  (ExpectedExpression)
  (Expected [(what (slice u8))])
  (UnknownVariable [(name (slice u8))])
  (UnknownFunction [(name (slice u8))])
  (WrongArity [(builtin Builtin) (given i64)])
  (DivisionByZero)
  (NegativeExponent)
  (Overflow))

(derive Debug Eq ErrorKind)

(impl Display ErrorKind
  (display-fmt [(kind ErrorKind) (f (ptr Formatter))]
    (-> i64)
    (let [w (writer f)]
      (match kind
        (UnexpectedChar [] (fmt w "unexpected character"))
        (NumberTooLarge [] (fmt w "number does not fit in 64 bits"))
        (ExpectedExpression [] (fmt w "expected an expression"))
        (Expected [what] (fmt w "expected {}" what))
        (UnknownVariable [name] (fmt w "unknown variable '{}'" name))
        (UnknownFunction [name] (fmt w "unknown function '{}'" name))
        (WrongArity [builtin given]
                    (fmt w
                         "{} takes {}, got {}"
                         builtin
                         (arity builtin)
                         given))
        (DivisionByZero [] (fmt w "division by zero"))
        (NegativeExponent [] (fmt w "negative exponent"))
        (Overflow [] (fmt w "integer overflow"))))
    0))

;;; An error and the part of the line it is about.
(defstruct CalcError [(kind ErrorKind) (span Span)])

(derive Debug Eq CalcError)

;;; Displays as a row of carets under `span`, for a line printed `indent` columns in.
(defstruct Underline [(span Span) (indent i64)])

(impl Display Underline
  (display-fmt [(u Underline) (f (ptr Formatter))]
    (-> i64)
    (let [(Span :start start :end end) (.span u)]
      ;; An empty span (the end of the line) still gets one caret.
      (fmt (writer f)
           "{:*}{:^<*}"
           (+ (.indent u) start)
           ""
           (if (> end start) (- end start) 1)
           ""))
    0))
