;;; The machines the demo drives, each declared as a `defmachine` table.
(module examples.statemachine.machines)
(import "examples.statemachine.machine" :use [defmachine])

;;; A coin-operated turnstile. Kicking it breaks it from any state, and only a
;;; repair brings it back.
(defmachine Turnstile
  :states [Locked Unlocked Broken]
  :events [Coin Push Kick Repair]
  :initial Locked
  :transitions
    [(Locked Coin -> Unlocked)
     (Unlocked Push -> Locked)
     (* Kick -> Broken)
     (Broken Repair -> Locked)])

;;; A client connection's lifecycle: resolve, connect, then alternate requests
;;; and responses. Closing while a request is in flight waits for its response;
;;; a timeout fails the connection, which can be retried; abort works anywhere.
(defmachine Connection
  :states [Idle Resolving Connecting Ready Waiting Closing Closed Failed]
  :events [Open Resolved Connected Request Response Timeout Close Retry Abort]
  :initial Idle
  :transitions
    [(Idle Open -> Resolving)
     (Resolving Resolved -> Connecting)
     (Connecting Connected -> Ready)
     (Ready Request -> Waiting)
     (Waiting Response -> Ready)
     (Ready Close -> Closed)
     (Waiting Close -> Closing)
     (Closing Response -> Closed)
     (Resolving Timeout -> Failed)
     (Connecting Timeout -> Failed)
     (Waiting Timeout -> Failed)
     (Failed Retry -> Resolving)
     (* Abort -> Closed)])
