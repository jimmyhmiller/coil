;;; `defmachine`: declare a finite state machine as a transition table and get
;;; its types and step function generated, and checked, at compile time.
;;;
;;;     (defmachine Turnstile
;;;       :states [Locked Unlocked Broken]
;;;       :events [Coin Push Kick Repair]
;;;       :initial Locked
;;;       :transitions [(Locked Coin -> Unlocked)
;;;                     (Unlocked Push -> Locked)
;;;                     (* Kick -> Broken)
;;;                     (Broken Repair -> Locked)])
;;;
;;; defines
;;;
;;; - `Turnstile`, a sum with one variant per state, and `TurnstileEvent`, a sum
;;;   with one variant per event, both with `Eq`, `Debug` and a `Display` that
;;;   prints the variant's name;
;;; - `(Turnstile::initial)`, the `:initial` state;
;;; - an impl of `StateMachine` whose `step` is one exhaustive `match` over
;;;   every (state, event) pair.
;;;
;;; A `*` row applies to every state that has no row of its own for that event.
;;; Malformed declarations are compile errors located at the offending name:
;;; unknown states or events, a (state, event) pair given twice, an `:initial`
;;; that is not a state, and states no event sequence can reach from `:initial`.
;;; An unreachable state is an error rather than a warning because every `match`
;;; over the state type must still handle it; it is always either a typo in a
;;; target or a missing row, and the table is the one place to fix either.
(module examples.statemachine.machine)
(import "coil.primitive" :as primitive)
(import "coil.result" :use [some?])
(import "coil.slice" :use [slice-new subslice])
(import "coil.try" :use [try try?])

;;; A finite state machine whose states are `Self` and whose inputs are `Event`.
;;; `step` is the transition table as a pure function: the next state, or
;;; `(None)` when the state has no transition on that event. `fire!` applies
;;; `step` in place and says whether the event was accepted. `allowed-events`
;;; lists the events a state accepts, in declaration order.
(deftrait StateMachine [Self Event]
  (step [(state Self) (event Event)] (-> (Option Self)))
  (fire! [(state (mut Self)) (event Event)] (-> bool))
  (allowed-events [(state Self)] (-> (slice Event))))

;; ---- reading the declaration ----------------------------------------------
(defn reject [(node Code) (message (slice u8))] (-> bool)
  (primitive/report node message)
  false)

(defn member? [(names Code) (name Code)] (-> bool)
  (block :found
         (for candidate
           names
           (when (= candidate name) (return-from :found true)))
         false))

(defn option-key? [(key Code)] (-> bool)
  (or (= key `:states) (= key `:events) (= key `:initial) (= key `:transitions)))

;; Where `key`'s value sits in the flat `:key value …` option list.
(defn option-index [(options Code) (key Code)] (-> (Option i64))
  (block :found
         (for i
           (range 0 (/ (len options) 2))
           (when (= (get options (* 2 i)) key)
             (return-from :found (Some (+ (* 2 i) 1)))))
         (None)))

;; `spelling` is the key's text, which `code-str` cannot take from a keyword.
(defn required-option [(name Code)
                       (options Code)
                       (key Code)
                       (spelling (slice u8))] (-> (Option Code))
  (match (option-index options key)
    (Some [i] (Some (get options i)))
    (None []
          (do
            (reject name
                    (primitive/code-str "defmachine: missing option " spelling))
            (None)))))

;; The values of :states, :events, :initial and :transitions, in that order,
;; or `(None)` once every problem with the options has been reported.
(defn parse-options [(name Code) (options Code)] (-> (Option Code))
  (if (!= (% (len options) 2) 0)
      (do
        (reject name
                "defmachine: expected :key value pairs after the machine name")
        (None))
      (let [(mut ok) true]
        (for i
          (range 0 (/ (len options) 2))
          (let [key (get options (* 2 i))]
            (cond (not (option-key? key))
                    (set! ok
                          (reject key
                                  "defmachine: unknown option; expected :states, :events, :initial or :transitions"))
                  (member? (primitive/code-slice options 0 (* 2 i)) key)
                    (set! ok (reject key "defmachine: option given twice")))))
        (let [states (required-option name options `:states ":states")
              events (required-option name options `:events ":events")
              initial (required-option name options `:initial ":initial")
              transitions
                (required-option name options `:transitions ":transitions")]
          (if ok
              (try (Some `(~(try? states) ~(try? events)
                             ~(try? initial)
                             ~(try? transitions))))
              (None))))))

(defn check-names [(names Code) (what (slice u8))] (-> bool)
  (if (not (primitive/code-vector? names))
      (reject names
              (primitive/code-str "defmachine: "
                                  what
                                  " must be a vector of names"))
      (let [(mut ok) (> (len names) 0)]
        (when (not ok)
          (reject names
                  (primitive/code-str "defmachine: " what " must not be empty")))
        (for i
          (range 0 (len names))
          (let [name (get names i)]
            (cond (not (primitive/code-sym? name))
                    (set! ok
                          (reject name
                                  (primitive/code-str "defmachine: "
                                                      what
                                                      " must be names")))
                  (= name `*)
                    (set! ok
                          (reject name
                                  "defmachine: `*` is the wildcard, not a name"))
                  (member? (primitive/code-slice names 0 i) name)
                    (set! ok
                          (reject name
                                  (primitive/code-str "defmachine: `"
                                                      name
                                                      "` is listed twice"))))))
        ok)))

(defn check-disjoint [(states Code) (events Code)] (-> bool)
  (let [(mut ok) true]
    (for event
      events
      (when (member? states event)
        (set! ok
              (reject event
                      (primitive/code-str "defmachine: `"
                                          event
                                          "` is both a state and an event")))))
    ok))

;; A row is `(FROM EVENT -> TO)`; FROM may be `*`.
(defn row-from [(row Code)] (-> Code)
  (get row 0))

(defn row-event [(row Code)] (-> Code)
  (get row 1))

(defn row-to [(row Code)] (-> Code)
  (get row 3))

(defn row-shape? [(row Code)] (-> bool)
  (and (primitive/code-list? row) (= (len row) 4) (= (get row 2) `->)))

(defn check-row [(row Code) (earlier Code) (states Code) (events Code)] (-> bool)
  (if (not (row-shape? row))
      (reject row "defmachine: a transition is (FROM EVENT -> TO)")
      (let [from (row-from row)
            event (row-event row)
            to (row-to row)
            from-ok
              (if (or (= from `*) (member? states from))
                  true
                  (reject from
                          (primitive/code-str "defmachine: unknown state `"
                                              from
                                              "`")))
            event-ok
              (if (member? events event)
                  true
                  (reject event
                          (primitive/code-str "defmachine: unknown event `"
                                              event
                                              "`")))
            to-ok
              (if (member? states to)
                  true
                  (reject to
                          (primitive/code-str "defmachine: unknown state `"
                                              to
                                              "`")))]
        (and from-ok
             event-ok
             to-ok
             (if (some? (explicit-target earlier from event))
                 (reject row
                         (primitive/code-str "defmachine: `"
                                             from
                                             "` already has a transition on `"
                                             event
                                             "`"))
                 true)))))

(defn check-rows [(rows Code) (states Code) (events Code)] (-> bool)
  (cond (not (primitive/code-vector? rows))
          (reject rows
                  "defmachine: :transitions must be a vector of (FROM EVENT -> TO) rows")
        (= (len rows) 0)
          (reject rows "defmachine: a machine needs at least one transition")
        :else
          (let [(mut ok) true]
            (for i
              (range 0 (len rows))
              (when (not (check-row (get rows i)
                                    (primitive/code-slice rows 0 i)
                                    states
                                    events))
                (set! ok false)))
            ok)))

;; ---- the transition table -------------------------------------------------

;; The row written for exactly (from, event), ignoring wildcards.
(defn explicit-target [(rows Code) (from Code) (event Code)] (-> (Option Code))
  (block :found
         (for row
           rows
           (when (and (row-shape? row)
                      (= (row-from row) from)
                      (= (row-event row) event))
             (return-from :found (Some (row-to row)))))
         (None)))

;; Where `event` leads from `state`: its own row, else the `*` row.
(defn target [(rows Code) (state Code) (event Code)] (-> (Option Code))
  (match (explicit-target rows state event)
    (Some [to] (Some to))
    (None [] (explicit-target rows `* event))))

(defn reachable [(rows Code) (events Code) (initial Code)] (-> Code)
  (let [(mut reached) `(~initial)
        (mut i) 0]
    (while (< i (len reached))
      (let [state (get reached i)]
        (for event
          events
          (match (target rows state event)
            (Some [to]
                  (when (not (member? reached to))
                    (set! reached `(~@reached ~to))))
            (None [] 0))))
      (set! i (+ i 1)))
    reached))

(defn check-reachable [(rows Code) (states Code) (events Code) (initial Code)] (-> bool)
  (let [reached (reachable rows events initial)
        (mut ok) true]
    (for state
      states
      (when (not (member? reached state))
        (set! ok
              (reject state
                      (primitive/code-str "defmachine: state `"
                                          state
                                          "` is unreachable from `"
                                          initial
                                          "`")))))
    ok))

(defn check-initial [(initial Code) (states Code)] (-> bool)
  (if (member? states initial)
      true
      (reject initial
              (primitive/code-str "defmachine: initial state `"
                                  initial
                                  "` is not one of :states"))))

;; Every check runs, so one compile reports every problem in the declaration.
(defn check-machine [(states Code) (events Code) (initial Code) (rows Code)] (-> bool)
  (if (not (and (check-names states ":states")
                (check-names events ":events")
                (check-disjoint states events)))
      false
      (let [initial-ok (check-initial initial states)
            rows-ok (check-rows rows states events)]
        (and initial-ok rows-ok (check-reachable rows states events initial)))))

;; ---- generating the machine -----------------------------------------------
(defn variants [(names Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for name names (push! (mut out) `(~name)))
    `(~@out)))

(defn name-arms [(names Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for name names (push! (mut out) `(~name [] ~(primitive/code-str name))))
    `(~@out)))

;; Delegating to the name's own `Display` keeps width and alignment specs working.
(defn display-impl [(type-name Code) (names Code)] (-> Code)
  (let [value (primitive/fresh-identifier "value")
        formatter (primitive/fresh-identifier "formatter")]
    `(impl Display ~type-name
       (display-fmt [(~value ~type-name) (~formatter (ptr Formatter))]
                    (-> i64)
                    (display-fmt (match ~value ~@(name-arms names)) ~formatter)))))

;; One arm per event for `state`, so the inner match is exhaustive without `_`.
(defn event-arms [(rows Code) (state Code) (events Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for event
      events
      (push! (mut out)
             (match (target rows state event)
               (Some [to] `(~event [] (Some (~to))))
               (None [] `(~event [] (None))))))
    `(~@out)))

(defn step-arms [(rows Code) (states Code) (events Code) (event Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for state
      states
      (push! (mut out)
             `(~state [] (match ~event ~@(event-arms rows state events)))))
    `(~@out)))

;; The events `state` has a transition on, in declaration order.
(defn accepted-events [(rows Code) (state Code) (events Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for event
      events
      (when (some? (target rows state event))
        (push! (mut out) event)))
    `(~@out)))

;; Every state's accepted events, concatenated in state order, so that each
;; state's `allowed-events` is a window onto one static array.
(defn allowed-table [(rows Code) (states Code) (events Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for state
      states
      (for event
        (accepted-events rows state events)
        (push! (mut out) `(~event))))
    `[~@out]))

(defn allowed-arms [(rows Code) (states Code) (events Code) (table Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)
        (mut start) 0]
    (for state
      states
      (let [end (+ start (len (accepted-events rows state events)))]
        (push! (mut out) `(~state [] (subslice ~table ~start ~end)))
        (set! start end)))
    `(~@out)))

;; The table lives in static storage so the returned slices outlive the call.
;; It is reached through a pointer because borrowing a `def` array as a slice
;; borrows a temporary copy.
(defn allowed-events-body [(rows Code)
                           (states Code)
                           (events Code)
                           (event-type Code)
                           (state Code)] (-> Code)
  (let [entries (allowed-table rows states events)
        size (len entries)
        table (primitive/fresh-identifier "table")]
    `(let [~table
             (slice-new (cast (ptr ~event-type)
                              (primitive/alloc-static (array ~event-type ~size)
                                                      ~entries))
                        ~size)]
       (match ~state ~@(allowed-arms rows states events table)))))

(defn expand-machine [(name Code)
                      (states Code)
                      (events Code)
                      (initial Code)
                      (rows Code)] (-> Code)
  ;; The two sum types and `initial` are the machine's public surface, so their
  ;; names enter the caller's namespace; everything else stays hygienic.
  (let [event-type
          (primitive/syntax->datum (primitive/code-symbol name "Event"))
        initial-method (primitive/syntax->datum `initial)
        state (primitive/fresh-identifier "state")
        event (primitive/fresh-identifier "event")
        next (primitive/fresh-identifier "next")]
    `(do
       (defsum ~name ~@(variants states))
       (defsum ~event-type ~@(variants events))
       (derive Eq Debug ~name)
       (derive Eq Debug ~event-type)
       ~(display-impl name states)
       ~(display-impl event-type events)
       (impl ~name (~initial-method [] (-> ~name) (~initial)))
       (impl StateMachine ~name
         (step [(~state ~name) (~event ~event-type)]
               (-> (Option ~name))
               (match ~state ~@(step-arms rows states events event)))
         (fire! [(~state (mut ~name)) (~event ~event-type)]
                (-> bool)
                (match (step (load ~state) ~event)
                  (Some [~next] (do (set! ~state ~next) true))
                  (None [] false)))
         (allowed-events [(~state ~name)]
                         (-> (slice ~event-type))
                         ~(allowed-events-body rows
                                               states
                                               events
                                               event-type
                                               state))))))

;;; `(defmachine NAME :states [S…] :events [E…] :initial S :transitions [(FROM E -> TO)…])`
;;; — see the module documentation.
(defn defmachine [(name Code) & (options Code)] (-> Code)
  (if (not (primitive/code-sym? name))
      (do (reject name "defmachine: the machine needs a name") `(do))
      (match (parse-options name options)
        (None [] `(do))
        (Some [parsed]
              (let [[states events initial rows] parsed]
                (if (check-machine states events initial rows)
                    (expand-machine name states events initial rows)
                    `(do)))))))

(export StateMachine step fire! allowed-events defmachine)
