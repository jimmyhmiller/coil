;;; statemachine: a library adds a language feature at compile time.
;;;
;;; `defmachine` (src/machine.coil) is an ordinary Coil function from `Code` to
;;; `Code`. Given a transition table, it checks the table while the program
;;; compiles and expands it into two sum types, their `Display` impls and a
;;; `StateMachine` impl whose `step` is one exhaustive `match`. Mistakes in the
;;; table (an unknown state or event, a pair defined twice, a bad `:initial`, a
;;; state nothing reaches) are compile errors pointing at the offending name.
;;; src/machines.coil declares the two machines this program drives through a
;;; script of events, using one generic runner (src/runner.coil) for both.
;;;
;;;     coil run examples/statemachine
;;;
;;;     Turnstile, from Locked:
;;;       Locked       Coin       -> Unlocked
;;;       Unlocked     Push       -> Locked
;;;       Locked       Push       rejected; accepts Coin, Kick
;;;       Locked       Coin       -> Unlocked
;;;       Unlocked     Coin       rejected; accepts Push, Kick
;;;       Unlocked     Kick       -> Broken
;;;       Broken       Coin       rejected; accepts Kick, Repair
;;;       Broken       Repair     -> Locked
;;;       Locked       Coin       -> Unlocked
;;;       Unlocked     Push       -> Locked
;;;       ends Locked: 7 accepted, 3 rejected
;;;
;;;     Connection, from Idle:
;;;       Idle         Request    rejected; accepts Open, Abort
;;;       Idle         Open       -> Resolving
;;;       ...
;;;       Closing      Response   -> Closed
;;;       Closed       Open       rejected; accepts Abort
;;;       ends Closed: 13 accepted, 3 rejected
;;;
;;; `coil expand src/machines.coil` (run from examples/statemachine) shows what
;;; the Turnstile declaration became; abridged, without the derived impls:
;;;
;;;     (defsum Turnstile (Locked) (Unlocked) (Broken))
;;;     (defsum TurnstileEvent (Coin) (Push) (Kick) (Repair))
;;;     (impl StateMachine Turnstile
;;;       (step [(state Turnstile) (event TurnstileEvent)] (-> (Option Turnstile))
;;;         (match state
;;;           (Locked [] (match event
;;;                        (Coin [] (Some (Unlocked))) (Push [] (None))
;;;                        (Kick [] (Some (Broken))) (Repair [] (None))))
;;;           (Unlocked [] (match event
;;;                          (Coin [] (None)) (Push [] (Some (Locked)))
;;;                          (Kick [] (Some (Broken))) (Repair [] (None))))
;;;           (Broken [] (match event
;;;                        (Coin [] (None)) (Push [] (None))
;;;                        (Kick [] (Some (Broken))) (Repair [] (Some (Locked)))))))
;;;       (fire! …)
;;;       (allowed-events [(state Turnstile)] (-> (slice TurnstileEvent))
;;;         (match state
;;;           (Locked [] (subslice allowed 0 2))
;;;           (Unlocked [] (subslice allowed 2 4))
;;;           (Broken [] (subslice allowed 4 6)))))
;;;
;;; where `allowed`, a static array of every state's accepted events, is
;;;
;;;     (def allowed [(Coin) (Kick) (Push) (Kick) (Kick) (Repair)])
;;;
;;; `tests/defmachine_errors_test.coil` shows the tables `defmachine` rejects, and
;;; the errors it reports for each.
(module examples.statemachine.main)
(import "examples.statemachine.machine" :use [StateMachine])
(import "examples.statemachine.machines" :use *)
(import "examples.statemachine.runner" :use [Summary run-script])

(defn demo [(E Display) (S (StateMachine E) Display)] [(title (slice u8))
                                                       (start S)
                                                       (script (slice E))]
  (-> void)
  (println "{}, from {}:" title start)
  (let [summary (run-script start script)]
    (println "  ends {}: {} accepted, {} rejected"
             (.final summary)
             (.accepted summary)
             (.rejected summary))))

(defn main [] (-> i64)
  (demo "Turnstile"
        (Turnstile::initial)
        [(Coin)
         (Push)
         (Push)
         (Coin)
         (Coin)
         (Kick)
         (Coin)
         (Repair)
         (Coin)
         (Push)])
  (println "")
  (demo "Connection"
        (Connection::initial)
        [(Request)
         (Open)
         (Resolved)
         (Connected)
         (Request)
         (Response)
         (Request)
         (Timeout)
         (Retry)
         (Resolved)
         (Connected)
         (Request)
         (Close)
         (Request)
         (Response)
         (Open)])
  0)
