;;; Drive any `StateMachine` through a script of events, narrating each step.
(module examples.statemachine.runner)
(import "examples.statemachine.machine" :use [StateMachine step allowed-events])

;;; How a run ended.
(defstruct Summary [S] [(final S) (accepted i64) (rejected i64)])

(defn print-list [(E Display)] [(events (slice E))] (-> void)
  (for i (range 0 (len events))
    (when (> i 0) (print ", "))
    (print "{}" (get events i))))

;;; Feed `script` to a machine that starts in `start`. Each accepted event
;;; prints the transition; each rejected one prints what the state accepts.
(defn run-script [(E Display) (S (StateMachine E) Display)] [(start S)
                                                             (script (slice E))]
  (-> (Summary S))
  (let [(mut state) start
        (mut accepted) 0
        (mut rejected) 0]
    (for event script
      (if-let [(Some [next]) (step state event)]
        (do
          (set! accepted (+ accepted 1))
          (println "  {:<12} {:<10} -> {}" state event next)
          (set! state next))
        (do
          (set! rejected (+ rejected 1))
          (print "  {:<12} {:<10} rejected; accepts " state event)
          (print-list (allowed-events state))
          (println ""))))
    (Summary
      :final state
      :accepted accepted
      :rejected rejected)))
