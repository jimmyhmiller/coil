(module examples.statemachine.machine-test)
(import "coil.io" :as io)
(import "coil.prop" :use *)
(import "coil.slice" :use [slice-new])
(import "coil.result" :use [some?])
(import "examples.statemachine.machine"
        :use
        [StateMachine step fire! allowed-events defmachine])
(import "examples.statemachine.machines" :use *)

(derive Arbitrary Turnstile)

(derive Arbitrary TurnstileEvent)

(derive Arbitrary Connection)

(derive Arbitrary ConnectionEvent)

;; `Option` has no `Eq`, so outcomes are compared by hand.
(defn same-outcome? [(T Eq)] [(actual (Option T)) (expected (Option T))] (-> bool)
  (match actual
    (Some [a] (match expected (Some [e] (= a e)) (None [] false)))
    (None [] (match expected (Some [_] false) (None [] true)))))

(defn member? [(T Eq)] [(items (slice T)) (wanted T)] (-> bool)
  (block :found
         (for item
           items
           (when (= item wanted) (return-from :found true)))
         false))

(defn same-items? [(T Eq)] [(actual (slice T)) (expected (slice T))] (-> bool)
  (and (= (len actual) (len expected))
       (block :differ
              (for i
                (range 0 (len actual))
                (when (!= (get actual i) (get expected i))
                  (return-from :differ false)))
              true)))

(defstruct TurnstileRow
  [(from Turnstile) (event TurnstileEvent) (to (Option Turnstile))])

;; Every (state, event) pair, written out the long way.
(deftest turnstile-steps-follow-the-table
         (let [table
                 [(TurnstileRow
                    :from (Locked)
                    :event (Coin)
                    :to (Some (Unlocked)))
                  (TurnstileRow
                    :from (Locked)
                    :event (Push)
                    :to (None))
                  (TurnstileRow
                    :from (Locked)
                    :event (Kick)
                    :to (Some (Broken)))
                  (TurnstileRow
                    :from (Locked)
                    :event (Repair)
                    :to (None))
                  (TurnstileRow
                    :from (Unlocked)
                    :event (Coin)
                    :to (None))
                  (TurnstileRow
                    :from (Unlocked)
                    :event (Push)
                    :to (Some (Locked)))
                  (TurnstileRow
                    :from (Unlocked)
                    :event (Kick)
                    :to (Some (Broken)))
                  (TurnstileRow
                    :from (Unlocked)
                    :event (Repair)
                    :to (None))
                  (TurnstileRow
                    :from (Broken)
                    :event (Coin)
                    :to (None))
                  (TurnstileRow
                    :from (Broken)
                    :event (Push)
                    :to (None))
                  (TurnstileRow
                    :from (Broken)
                    :event (Kick)
                    :to (Some (Broken)))
                  (TurnstileRow
                    :from (Broken)
                    :event (Repair)
                    :to (Some (Locked)))]]
           (for (TurnstileRow
                  :from from
                  :event event
                  :to to)
             table
             (assert (same-outcome? (step from event) to)))))

(deftest initial-state-is-the-declared-one
         (assert-eq (Turnstile::initial) (Locked))
         (assert-eq (Connection::initial) (Idle)))

(deftest allowed-events-are-in-declaration-order
         (assert (same-items? (allowed-events (Locked)) [(Coin) (Kick)]))
         (assert (same-items? (allowed-events (Unlocked)) [(Push) (Kick)]))
         (assert (same-items? (allowed-events (Broken)) [(Kick) (Repair)]))
         (assert (same-items? (allowed-events (Closed)) [(Abort)])))

(deftest wildcard-row-applies-to-every-state
         (let [states
                 [(Idle)
                  (Resolving)
                  (Connecting)
                  (Ready)
                  (Waiting)
                  (Closing)
                  (Closed)
                  (Failed)]]
           (for state
             states
             (assert (same-outcome? (step state (Abort)) (Some (Closed)))))))

(deftest fire-moves-only-on-accepted-events
         (let [(mut state) (Turnstile::initial)]
           (assert (not (fire! (mut state) (Push))))
           (assert-eq state (Locked))
           (assert (fire! (mut state) (Coin)))
           (assert-eq state (Unlocked))))

(deftest closing-waits-for-the-response-in-flight
         (let [(mut state) (Ready)]
           (assert (fire! (mut state) (Request)))
           (assert (fire! (mut state) (Close)))
           (assert-eq state (Closing))
           (assert (not (fire! (mut state) (Request))))
           (assert (fire! (mut state) (Response)))
           (assert-eq state (Closed))))

(defn rendered [(T Display)] [(value T) (buffer (mut (array u8 32)))] (-> (slice u8))
  (let [(mut sink)
          (io/FixBuf
            :data (cast (ptr i8) buffer)
            :len 0
            :cap 32)
        (mut writer) (zeroed io/Writer)]
    (io/fixed-buffer-writer (mut writer) (mut sink))
    (fmt (mut writer) "[{:<9}]" value)
    (slice-new (cast (ptr u8) buffer) (.len sink))))

(deftest display-prints-padded-variant-names
         (let [(mut buffer) (zeroed (array u8 32))]
           (assert-eq (rendered (Unlocked) (mut buffer)) "[Unlocked ]")
           (assert-eq (rendered (Repair) (mut buffer)) "[Repair   ]")))

;; A row for one state overrides the `*` row for that event.
(defmachine Lamp
  :states [Off On Dimmed]
  :events [Toggle Dim]
  :initial Off
  :transitions
    [(* Toggle -> On)
     (On Toggle -> Off)
     (On Dim -> Dimmed)])

(deftest specific-row-overrides-wildcard
         (assert (same-outcome? (step (Off) (Toggle)) (Some (On))))
         (assert (same-outcome? (step (Dimmed) (Toggle)) (Some (On))))
         (assert (same-outcome? (step (On) (Toggle)) (Some (Off)))))

(defprop turnstile-allows-exactly-what-steps
         [(state Turnstile) (event TurnstileEvent)]
         (= (some? (step state event)) (member? (allowed-events state) event)))

(defprop connection-allows-exactly-what-steps
         [(state Connection) (event ConnectionEvent)]
         (= (some? (step state event)) (member? (allowed-events state) event)))

(defprop fire-agrees-with-step
         [(state Connection) (event ConnectionEvent)]
         (let [(mut fired) state
               accepted (fire! (mut fired) event)]
           (match (step state event)
             (Some [next] (and accepted (= fired next)))
             (None [] (and (not accepted) (= fired state))))))
