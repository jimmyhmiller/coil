(module examples.statemachine.machine-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.prop" :use *)
(import "coil.result" :use [some?])
(import "coil.str" :use [sb-new sb-format! sb-str sb-free!])
(import "examples.statemachine.machine"
        :use
        [step fire! allowed-events defmachine])
(import "examples.statemachine.machines" :use *)

(derive Arbitrary Turnstile)

(derive Arbitrary TurnstileEvent)

(derive Arbitrary Connection)

(derive Arbitrary ConnectionEvent)

(defn member? [(T Eq)] [(items (slice T)) (wanted T)] (-> bool)
  (block :found
    (for item items
      (when (= item wanted) (return-from :found true)))
    false))

;; Every (state, event) pair, written out the long way.
(deftest turnstile-steps-follow-the-table
  (assert-eq (step (Locked) (Coin)) (Some (Unlocked)))
  (assert-eq (step (Locked) (Push)) (None))
  (assert-eq (step (Locked) (Kick)) (Some (Broken)))
  (assert-eq (step (Locked) (Repair)) (None))
  (assert-eq (step (Unlocked) (Coin)) (None))
  (assert-eq (step (Unlocked) (Push)) (Some (Locked)))
  (assert-eq (step (Unlocked) (Kick)) (Some (Broken)))
  (assert-eq (step (Unlocked) (Repair)) (None))
  (assert-eq (step (Broken) (Coin)) (None))
  (assert-eq (step (Broken) (Push)) (None))
  (assert-eq (step (Broken) (Kick)) (Some (Broken)))
  (assert-eq (step (Broken) (Repair)) (Some (Locked))))

(deftest initial-state-is-the-declared-one
  (assert-eq (Turnstile::initial) (Locked))
  (assert-eq (Connection::initial) (Idle)))

(deftest allowed-events-are-in-declaration-order
  (assert-eq (allowed-events (Locked)) [(Coin) (Kick)])
  (assert-eq (allowed-events (Unlocked)) [(Push) (Kick)])
  (assert-eq (allowed-events (Broken)) [(Kick) (Repair)])
  (assert-eq (allowed-events (Closed)) [(Abort)]))

(deftest wildcard-row-applies-to-every-state
  (for state [(Idle)
              (Resolving)
              (Connecting)
              (Ready)
              (Waiting)
              (Closing)
              (Closed)
              (Failed)]
    (assert-eq (step state (Abort)) (Some (Closed)))))

(deftest fire-moves-only-on-accepted-events
  (let [(mut state) (Turnstile::initial)]
    (assert (not (fire! (mut state) (Push))))
    (assert-eq state (Locked))
    (assert (fire! (mut state) (Coin)))
    (assert-eq state (Unlocked))))

(deftest closing-waits-for-the-response-in-flight
  (let [(mut state) (Ready)]
    (assert (fire! (mut state) (Request)))
    (assert (fire! (mut state) (Close)))
    (assert-eq state (Closing))
    (assert (not (fire! (mut state) (Request))))
    (assert (fire! (mut state) (Response)))
    (assert-eq state (Closed))))

(deftest display-prints-padded-variant-names
  (let [(mut out) (sb-new (malloc-allocator))]
    (defer (sb-free! (mut out)))
    (sb-format! (mut out) "[{:<9}][{:<9}]" (Unlocked) (Repair))
    (assert-eq (sb-str out) "[Unlocked ][Repair   ]")))

;; A row for one state overrides the `*` row for that event.
(defmachine Lamp
  :states [Off On Dimmed]
  :events [Toggle Dim]
  :initial Off
  :transitions
    [(* Toggle -> On)
     (On Toggle -> Off)
     (On Dim -> Dimmed)])

(deftest specific-row-overrides-wildcard
  (assert-eq (step (Off) (Toggle)) (Some (On)))
  (assert-eq (step (Dimmed) (Toggle)) (Some (On)))
  (assert-eq (step (On) (Toggle)) (Some (Off))))

(defprop turnstile-allows-exactly-what-steps [(state Turnstile)
                                              (event TurnstileEvent)]
  (= (some? (step state event)) (member? (allowed-events state) event)))

(defprop connection-allows-exactly-what-steps [(state Connection)
                                               (event ConnectionEvent)]
  (= (some? (step state event)) (member? (allowed-events state) event)))

(defprop fire-agrees-with-step [(state Connection) (event ConnectionEvent)]
  (let [(mut fired) state
        accepted (fire! (mut fired) event)]
    (match (step state event)
      (Some [next] (and accepted (= fired next)))
      (None [] (and (not accepted) (= fired state))))))
