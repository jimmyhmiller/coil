(module examples.statemachine.fixtures.several-errors)
(import "examples.statemachine.machine" :use [defmachine])

(defmachine Door
  :states [Open Shut Open]
  :events [Push Pull]
  :initial Shut
  :transitions [(Shut Pull -> Open)])

(defmachine Gate
  :states [Up Down]
  :events [Raise Lower]
  :initial Down
  :transitions [(Down Raise Up)
                (* Lower -> Down)
                (* Lower -> Up)
                (Up Raise -> Sideways)])
