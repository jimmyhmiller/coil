;;; `defmachine` rejects malformed tables at compile time. Each fixture under
;;; `tests/fixtures/` (excluded from the package, so nothing else compiles it)
;;; is checked with the `coil` on PATH, from the package directory where
;;; `coil test` runs, and must fail with the located errors listed here.
(module examples.statemachine.defmachine-errors-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.cancellation" :as cancellation)
(import "coil.result" :use [ok? some?])
(import "coil.str" :use [str-find])
(import "coil.subprocess" :as subprocess)
(import "coil.time" :as time)
(import "coil.try" :use [try try-or!])

(const OUTPUT-LIMIT 1_000_000)

;; Run `coil check FIXTURE` into `result`; false if it could not be run at all.
(defn coil-check [(fixture (slice u8)) (result (ptr subprocess/RunResult))] (-> bool)
  (try (let [timeout (try-or! (time/duration-seconds 300) false)
             deadline (try-or! (time/deadline-after timeout) false)
             grace (try-or! (time/duration-seconds 1) false)
             args ["check" fixture]
             no-cancellation (cast (ptr cancellation/Cancellation) 0)
             options
               (subprocess/run-options "coil"
                                       args
                                       ""
                                       OUTPUT-LIMIT
                                       OUTPUT-LIMIT
                                       (Some deadline)
                                       no-cancellation
                                       grace)]
         (ok? (subprocess/run (malloc-allocator) result options)))))

(defn exited-with? [(status subprocess/ExitStatus) (wanted i64)] (-> bool)
  (match status
    (subprocess/Exited [code] (= code wanted))
    (subprocess/Signaled [_] false)))

;; True when checking `fixture` fails and its diagnostics contain every line of
;; `expected`; otherwise prints what `coil check` said.
(defn rejected-with? [(fixture (slice u8)) (expected (slice (slice u8)))] (-> bool)
  (let [(mut result) (zeroed subprocess/RunResult)
        (mut ok)
          (and (coil-check fixture (mut result))
               (exited-with? (.status result) 1))]
    (for line
      expected
      (when (not (some? (str-find (.stderr result) line)))
        (set! ok false)))
    (when (not ok)
      (println "coil check {} said:\n{}" fixture (.stderr result)))
    (subprocess/run-result-free (malloc-allocator) (mut result))
    ok))

(deftest unknown-state-in-a-transition
         (assert (rejected-with? "tests/fixtures/unknown_state.coil"
                                 ["error: defmachine: unknown state `Closed`"
                                  "--> tests/fixtures/unknown_state.coil:9:31"])))

(deftest unknown-event-in-a-transition
         (assert (rejected-with? "tests/fixtures/unknown_event.coil"
                                 ["error: defmachine: unknown event `Slam`"
                                  "--> tests/fixtures/unknown_event.coil:9:23"])))

(deftest duplicate-state-event-pair
         (assert (rejected-with? "tests/fixtures/duplicate_transition.coil"
                                 ["error: defmachine: `Shut` already has a transition on `Pull`"
                                  "--> tests/fixtures/duplicate_transition.coil:10:17"])))

(deftest initial-state-must-be-a-state
         (assert (rejected-with? "tests/fixtures/bad_initial.coil"
                                 ["error: defmachine: initial state `Ajar` is not one of :states"
                                  "--> tests/fixtures/bad_initial.coil:7:12"])))

(deftest unreachable-state
         (assert (rejected-with? "tests/fixtures/unreachable_state.coil"
                                 ["error: defmachine: state `Locked` is unreachable from `Shut`"
                                  "--> tests/fixtures/unreachable_state.coil:5:22"])))

(deftest unknown-and-missing-options
         (assert (rejected-with? "tests/fixtures/bad_options.coil"
                                 ["error: defmachine: unknown option; expected :states, :events, :initial or :transitions"
                                  "--> tests/fixtures/bad_options.coil:7:3"
                                  "error: defmachine: missing option :initial"
                                  "--> tests/fixtures/bad_options.coil:4:13"])))

(deftest every-problem-is-reported-in-one-compile
         (assert (rejected-with? "tests/fixtures/several_errors.coil"
                                 ["error: defmachine: `Open` is listed twice"
                                  "error: defmachine: a transition is (FROM EVENT -> TO)"
                                  "error: defmachine: `*` already has a transition on `Lower`"
                                  "error: defmachine: unknown state `Sideways`"])))
