;;; `defmachine` rejects malformed tables at compile time, with errors located at
;;; the offending name. Each test compiles one declaration while it runs
;;; (`coil.test.compile`) and checks the diagnostics; a location is where in this
;;; file the offending name is written.
(module examples.statemachine.defmachine-errors-test)
(import "coil.test.compile" :use [assert-compile-error])

;; A transition may only name declared states.
(deftest unknown-state-in-a-transition
  (assert-compile-error ["error: defmachine: unknown state `Closed`"
                         "defmachine_errors_test.coil:19:24"]
    (import "examples.statemachine.machine" :use [defmachine])
    (defmachine Door
      :states [Open Shut]
      :events [Push Pull]
      :initial Shut
      :transitions
        [(Shut Pull -> Open)
         (Open Push -> Closed)])))

;; ... and only declared events.
(deftest unknown-event-in-a-transition
  (assert-compile-error ["error: defmachine: unknown event `Slam`"
                         "defmachine_errors_test.coil:32:16"]
    (import "examples.statemachine.machine" :use [defmachine])
    (defmachine Door
      :states [Open Shut]
      :events [Push Pull]
      :initial Shut
      :transitions
        [(Shut Pull -> Open)
         (Open Slam -> Shut)])))

;; A (state, event) pair has one transition; the repeated row is the error.
(deftest duplicate-state-event-pair
  (assert-compile-error ["error: defmachine: `Shut` already has a transition on `Pull`"
                         "defmachine_errors_test.coil:46:10"]
    (import "examples.statemachine.machine" :use [defmachine])
    (defmachine Door
      :states [Open Shut]
      :events [Push Pull]
      :initial Shut
      :transitions
        [(Shut Pull -> Open)
         (Open Push -> Shut)
         (Shut Pull -> Shut)])))

(deftest initial-state-must-be-a-state
  (assert-compile-error ["error: defmachine: initial state `Ajar` is not one of :states"
                         "defmachine_errors_test.coil:55:16"]
    (import "examples.statemachine.machine" :use [defmachine])
    (defmachine Door
      :states [Open Shut]
      :events [Push Pull]
      :initial Ajar
      :transitions
        [(Shut Pull -> Open)
         (Open Push -> Shut)])))

;; Every state must be reachable from :initial; the error names the state.
(deftest unreachable-state
  (assert-compile-error ["error: defmachine: state `Locked` is unreachable from `Shut`"
                         "defmachine_errors_test.coil:66:26"]
    (import "examples.statemachine.machine" :use [defmachine])
    (defmachine Door
      :states [Open Shut Locked]
      :events [Push Pull Lock Unlock]
      :initial Shut
      :transitions
        [(Shut Pull -> Open)
         (Open Push -> Shut)
         (Locked Unlock -> Shut)])))

;; An unknown option is located at its key, a missing one at the machine's name.
(deftest unknown-and-missing-options
  (assert-compile-error ["error: defmachine: unknown option; expected :states, :events, :initial or :transitions"
                         "defmachine_errors_test.coil:84:7"
                         "error: defmachine: missing option :initial"
                         "defmachine_errors_test.coil:81:17"]
    (import "examples.statemachine.machine" :use [defmachine])
    (defmachine Door
      :states [Open Shut]
      :events [Push Pull]
      :start Shut
      :transitions
        [(Shut Pull -> Open)
         (Open Push -> Shut)])))

;; One compile reports every problem in every declaration.
(deftest every-problem-is-reported-in-one-compile
  (assert-compile-error ["error: defmachine: `Open` is listed twice"
                         "error: defmachine: a transition is (FROM EVENT -> TO)"
                         "error: defmachine: `*` already has a transition on `Lower`"
                         "error: defmachine: unknown state `Sideways`"]
    (import "examples.statemachine.machine" :use [defmachine])
    (defmachine Door
      :states [Open Shut Open]
      :events [Push Pull]
      :initial Shut
      :transitions [(Shut Pull -> Open)])
    (defmachine Gate
      :states [Up Down]
      :events [Raise Lower]
      :initial Down
      :transitions
        [(Down Raise Up)
         (* Lower -> Down)
         (* Lower -> Up)
         (Up Raise -> Sideways)])))
