(module examples.statemachine.runner-test)
(import "examples.statemachine.machines" :use *)
(import "examples.statemachine.runner" :use [Summary run-script])

(deftest run-counts-accepted-and-rejected-events
         (let [summary
                 (run-script (Turnstile::initial)
                             [(Push) (Coin) (Coin) (Push) (Kick)])]
           (assert-eq (.final summary) (Broken))
           (assert-eq (.accepted summary) 3)
           (assert-eq (.rejected summary) 2)))

(deftest rejected-events-leave-the-state-alone
         (let [summary
                 (run-script (Connection::initial)
                             [(Request) (Response) (Close)])]
           (assert-eq (.final summary) (Idle))
           (assert-eq (.accepted summary) 0)
           (assert-eq (.rejected summary) 3)))

(deftest a-failed-connection-can-be-retried
         (let [summary
                 (run-script (Connection::initial)
                             [(Open)
                              (Timeout)
                              (Retry)
                              (Resolved)
                              (Connected)
                              (Request)
                              (Response)])]
           (assert-eq (.final summary) (Ready))
           (assert-eq (.accepted summary) 7)))
