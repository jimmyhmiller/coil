(module examples.lru.ownership-test)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.debug-allocator"
        :use
        [debug-allocator-init
         debug-allocator-view
         debug-allocator-deinit!])
(import "coil.var" :use [Var var-static])
(import "coil.str"
        :use
        [String StringView sv string-from-view string-as-view string-free!])
(import "examples.lru.cache"
        :use
        [lru-new lru-get! lru-put! lru-remove! lru-len])
(import "examples.lru.key" :use [CacheKey])
(import "examples.lru.support" :use [borrowed-lease])

;; Keys and values that own memory, counting how many of each are alive.
(def live-names (var-static i64 0))

(def live-pages (var-static i64 0))

(defn count! [(counter (Var i64)) (by i64)] (-> void)
  (set counter (+ (get counter) by)))

;; A key holding its text in a heap buffer it frees when dropped.
(defstruct Name [(text String)])

(defn name [(heap (dyn Allocator)) (text StringView)] (-> Name)
  (count! live-names 1)
  (Name :text (string-from-view heap text)))

(impl Drop Name
  (drop [(self (mut Name))]
        (-> void)
        (string-free! (mut (.text self)))
        (count! live-names -1)))

(impl CacheKey Name
  (key-hash [(key (ref Name))] (-> i64) (hash (.text key)))
  (same-key? [(a (ref Name)) (b (ref Name))] (-> bool) (= (.text a) (.text b))))

(defn named? [(key (ref Name)) (text StringView)] (-> bool)
  (= (string-as-view (.text key)) text))

(defstruct Page [(number i64)])

(defn page [(number i64)] (-> Page)
  (count! live-pages 1)
  (Page :number number))

(impl Clone Page
  (clone [(self (ref Page))] (-> Page) (page (.number self))))

(impl Drop Page
  (drop [(self (mut Page))] (-> void) (count! live-pages -1)))

;; Every key and value the cache was given is dropped exactly once: by whoever it
;; was handed back to, or by the cache itself when the cache is dropped. The debug
;; allocator then confirms no string buffer and no cache storage leaked.
(deftest owned-keys-and-values-are-dropped-exactly-once
         (let [debug (debug-allocator-init (malloc-allocator))
               heap (debug-allocator-view debug)]
           (match (lru-new [Name Page] (borrowed-lease heap) 2)
             (None [] (assert false))
             (Some [fresh]
                   (let [(mut cache) fresh]
                     (lru-put! (mut cache) (name heap (sv "alpha")) (page 1))
                     (lru-put! (mut cache) (name heap (sv "beta")) (page 2))
                     (match (lru-put! (mut cache)
                                      (name heap (sv "gamma"))
                                      (page 3))
                       (Some [evicted]
                             (assert (named? (field evicted key) (sv "alpha"))))
                       (None [] (assert false)))
                     (assert-eq (get live-names) 2)
                     (assert-eq (get live-pages) 2)
                     (let [probe (name heap (sv "beta"))]
                       (match (lru-get! (mut cache) probe)
                         (Some [copy] (assert-eq (.number copy) 2))
                         (None [] (assert false)))
                       (match (lru-remove! (mut cache) probe)
                         (Some [removed]
                               (assert-eq (.number (field removed value)) 2))
                         (None [] (assert false))))
                     (assert-eq (lru-len cache) 1)
                     (assert-eq (get live-names) 1)
                     (assert-eq (get live-pages) 1)
                     ; Replacing gamma hands back its old pair, which nothing
                     ; receives, so it is dropped right here.
                     (lru-put! (mut cache) (name heap (sv "gamma")) (page 4))
                     (assert-eq (get live-names) 1)
                     (assert-eq (get live-pages) 1))))
           (assert-eq (get live-names) 0)
           (assert-eq (get live-pages) 0)
           (assert-eq (debug-allocator-deinit! debug) 0)))
