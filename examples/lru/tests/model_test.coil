(module examples.lru.model-test)
(import "coil.arraylist" :use [ArrayList al-new])
(import "coil.iter" :use [Indexed])
(import "coil.io" :use [Writer])
(import "coil.prop"
        :use
        [Source draw-int! draw-tag! src-alloc defprop-stateful])
(import "examples.lru.cache"
        :use
        [Entry Lru lru-new lru-get! lru-put! lru-remove! lru-len lru-recency])
(import "examples.lru.support" :use [borrowed-lease])

;; Model-based testing: random command sequences run against the cache and against
;; a model too simple to be wrong, and after every command the two must agree on
;; what the command returned and on what the cache now holds, in recency order.

;; Few enough keys that gets hit, puts replace and full caches evict.
(const KEY-SPACE 8)

;; The specification: the cached entries, least recently used first.
(defstruct Model [(capacity i64) (pairs (ArrayList (Entry i64 i64)))])

;; `Put` comes first because a shrunk sequence collapses toward the first variant,
;; and puts are what every interesting sequence is built from.
(defsum Cmd
  (Put [(key i64) (value i64)])
  (Get [(key i64)])
  (Remove [(key i64)]))

;; What a command answered: the entry `get` found, or the entry `put!` or
;; `remove!` handed back.
(defstruct Observed [(entry (Option (Entry i64 i64)))])

;; The cache and the model live in the case's arena, which the runner rewinds
;; between cases, so neither is freed piece by piece and the cache is never dropped.
(defn start [(model (ptr Model)) (cache (ptr (Lru i64 i64))) (src (ptr Source))]
  (-> i64)
  (let [capacity (draw-int! src 1 4)]
    (set! model
          (Model
            :capacity capacity
            :pairs (al-new [(Entry i64 i64)] (src-alloc src))))
    (match (lru-new [i64 i64] (borrowed-lease (src-alloc src)) capacity)
      (Some [fresh] (set! cache fresh))
      (None [] (assert false)))
    0))

(defn draw-key [(src (ptr Source))] (-> i64)
  (draw-int! src 0 (- KEY-SPACE 1)))

(defn draw-command [(cmd (ptr Cmd)) (model (ptr Model)) (src (ptr Source))]
  (-> i64)
  (set! cmd
        (match (draw-tag! src 3)
          (0 (Put :key (draw-key src) :value (draw-int! src 0 99)))
          (1 (Get (draw-key src)))
          (_ (Remove (draw-key src)))))
  0)

;; Every command makes sense in every state.
(defn always [(model (ptr Model)) (cmd (ptr Cmd))] (-> bool)
  true)

(defn run-command [(cache (ptr (Lru i64 i64)))
                   (cmd (ptr Cmd))
                   (observed (ptr Observed))] (-> i64)
  (set! observed
        (Observed
          :entry
            (match (load cmd)
              (Put [key value] (lru-put! cache key value))
              (Get [key]
                   (if-let [(Some [value]) (lru-get! cache key)]
                     (Some (Entry :key key :value value))
                     (None)))
              (Remove [key] (lru-remove! cache key)))))
  0)

;; ---- the model ----------------------------------------------------------------
(defn position [(pairs (ArrayList (Entry i64 i64))) (key i64)] (-> (Option i64))
  (block :found
    (for (Indexed :index at :value pair) (enumerate pairs)
      (when (= (.key pair) key) (return-from :found (Some at))))
    (None)))

(defn pair-at [(pairs (ArrayList (Entry i64 i64))) (at (Option i64))]
  (-> (Option (Entry i64 i64)))
  (if-let [(Some [i]) at] (Some (get pairs i)) (None)))

(defn remove-at! [(pairs (mut (ArrayList (Entry i64 i64)))) (at i64)] (-> void)
  (for i (range at (- (len pairs) 1))
    (set! (mut pairs) i (get pairs (+ i 1))))
  (pop! (mut pairs)))

(defn full? [(model (ptr Model))] (-> bool)
  (= (len (.pairs model)) (.capacity model)))

;; What the cache should answer, given the model before the command.
(defn expected [(model (ptr Model)) (cmd Cmd)] (-> (Option (Entry i64 i64)))
  (let [pairs (.pairs model)]
    (match cmd
      (Put [key _]
           (match (position pairs key)
             (Some [at] (Some (get pairs at)))
             (None [] (if (full? model) (Some (get pairs 0)) (None)))))
      (Get [key] (pair-at pairs (position pairs key)))
      (Remove [key] (pair-at pairs (position pairs key))))))

(defn answer-matches? [(model (ptr Model))
                       (cmd (ptr Cmd))
                       (observed (ptr Observed))] (-> bool)
  (= (expected model cmd) (.entry observed)))

(defn advance-model [(model (ptr Model))
                     (cmd (ptr Cmd))
                     (observed (ptr Observed))] (-> i64)
  (let [pairs (field model pairs)]
    (match (load cmd)
      (Put [key value]
           (match (position pairs key)
             (Some [at] (remove-at! pairs at))
             (None [] (when (full? model) (remove-at! pairs 0))))
           (push! pairs (Entry :key key :value value)))
      (Get [key]
           (when-let [(Some [at]) (position pairs key)]
             (let [pair (get pairs at)]
               (remove-at! pairs at)
               (push! pairs pair))))
      (Remove [key]
              (when-let [(Some [at]) (position pairs key)]
                (remove-at! pairs at)))))
  0)

;; The cache holds exactly the model's pairs, most recent first.
(defn same-contents? [(model (ptr Model)) (cache (ptr (Lru i64 i64)))] (-> bool)
  (let [pairs (.pairs model)
        (mut at) (len pairs)
        (mut same) (= (lru-len cache) (len pairs))]
    (for entry (lru-recency cache)
      (set! at (- at 1))
      (set! same
            (and same
                 (>= at 0)
                 (= (load entry) (get pairs at)))))
    (and same (= at 0))))

(defn show-command [(cmd (ptr Cmd)) (w (ptr Writer))] (-> i64)
  (match (load cmd)
    (Put [key value] (fmt w "(put! {} {})" key value))
    (Get [key] (fmt w "(get! {})" key))
    (Remove [key] (fmt w "(remove! {})" key)))
  0)

(defprop-stateful cache-matches-model [Cmd Model (Lru i64 i64) Observed]
  :init start
  :gen draw-command
  :pre always
  :run run-command
  :post answer-matches?
  :next advance-model
  :inv same-contents?
  :show show-command
  :max-cmds 60)
