(module examples.lru.support)
(import "coil.alloc" :use [Allocator AllocatorLease unsafe-allocator-lease-new])

(defn lease-nothing [(state (ptr i8))] (-> i64)
  0)

;;; A lease on `allocator` for a test whose allocator outlives every cache made
;;; from it, so the lease has nothing to keep alive or release.
(defn borrowed-lease [(allocator (dyn Allocator))] (-> AllocatorLease)
  (unsafe-allocator-lease-new allocator
                              (cast (ptr i8) 0)
                              (fnptr-of lease-nothing)
                              (fnptr-of lease-nothing)))
