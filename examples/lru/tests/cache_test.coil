(module examples.lru.cache-test)
(import "coil.alloc" :use [malloc-allocator malloc-allocator-lease])
(import "coil.debug-allocator"
        :use
        [debug-allocator-init
         debug-allocator-view
         debug-allocator-deinit!])
(import "coil.result" :use [none?])
(import "examples.lru.cache"
        :use
        [Entry
         Lru
         lru-new
         lru-get!
         lru-put!
         lru-remove!
         lru-len
         lru-capacity
         lru-recency])
(import "examples.lru.support" :use [borrowed-lease])

;; `(with-cache [name capacity] body…)` runs `body` with `name` bound to a fresh,
;; mutable `(Lru i64 i64)` of `capacity` entries, failing the test if there is none.
(defn with-cache [(binding Code) & (body Code)] (-> Code)
  `(match (lru-new [i64 i64] (malloc-allocator-lease) ~(get binding 1))
     (None [] (assert false))
     (Some [fresh] (let [(mut ~(get binding 0)) fresh] ~@body))))

;; Whether the cache holds exactly `expected` keys, most recently used first.
(defn recency-is? [(cache (ref (Lru i64 i64))) (expected (slice i64))] (-> bool)
  (let [(mut at) 0
        (mut same) true]
    (for entry
      (lru-recency cache)
      (set! same
            (and same (< at (len expected)) (= (.key entry) (get expected at))))
      (set! at (+ at 1)))
    (and same (= at (len expected)))))

;; Whether `key` is cached with `value`. Like any `lru-get!`, it makes `key` the most
;; recent entry.
(defn get-is? [(cache (mut (Lru i64 i64))) (key i64) (value i64)] (-> bool)
  (match (lru-get! (mut cache) key)
    (Some [cached] (= cached value))
    (None [] false)))

;; Whether `displaced` is the entry `key` → `value`.
(defn entry-is? [(displaced (Option (Entry i64 i64))) (key i64) (value i64)] (-> bool)
  (match displaced
    (Some [entry] (and (= (.key entry) key) (= (.value entry) value)))
    (None [] false)))

(deftest a-new-cache-is-empty
         (with-cache [cache 3]
                     (assert-eq (lru-len cache) 0)
                     (assert-eq (lru-capacity cache) 3)
                     (assert-eq (count (lru-recency cache)) 0)))

(deftest a-capacity-below-one-is-refused
         (assert (none? (lru-new [i64 i64] (malloc-allocator-lease) 0)))
         (assert (none? (lru-new [i64 i64] (malloc-allocator-lease) -4))))

(deftest a-full-cache-evicts-the-least-recently-used-entry
         (with-cache [cache 3]
                     (assert (none? (lru-put! (mut cache) 1 10)))
                     (assert (none? (lru-put! (mut cache) 2 20)))
                     (assert (none? (lru-put! (mut cache) 3 30)))
                     (assert (entry-is? (lru-put! (mut cache) 4 40) 1 10))
                     (assert (entry-is? (lru-put! (mut cache) 5 50) 2 20))
                     (assert-eq (lru-len cache) 3)
                     (assert (recency-is? cache [5 4 3]))))

(deftest get-makes-an-entry-the-most-recent
         (with-cache [cache 3]
                     (lru-put! (mut cache) 1 10)
                     (lru-put! (mut cache) 2 20)
                     (lru-put! (mut cache) 3 30)
                     (assert (get-is? (mut cache) 1 10))
                     (assert (recency-is? cache [1 3 2]))
                     (assert (entry-is? (lru-put! (mut cache) 4 40) 2 20))
                     (assert (recency-is? cache [4 1 3]))))

(deftest get-of-a-missing-key-changes-nothing
         (with-cache [cache 2]
                     (lru-put! (mut cache) 1 10)
                     (lru-put! (mut cache) 2 20)
                     (assert (none? (lru-get! (mut cache) 7)))
                     (assert (recency-is? cache [2 1]))))

(deftest put-of-a-cached-key-hands-back-the-old-entry
         (with-cache [cache 3]
                     (lru-put! (mut cache) 1 10)
                     (lru-put! (mut cache) 2 20)
                     (assert (entry-is? (lru-put! (mut cache) 1 11) 1 10))
                     (assert-eq (lru-len cache) 2)
                     (assert (recency-is? cache [1 2]))
                     (assert (get-is? (mut cache) 1 11))))

(deftest remove-hands-back-the-entry-once
         (with-cache [cache 3]
                     (lru-put! (mut cache) 1 10)
                     (lru-put! (mut cache) 2 20)
                     (lru-put! (mut cache) 3 30)
                     (assert (entry-is? (lru-remove! (mut cache) 2) 2 20))
                     (assert (none? (lru-remove! (mut cache) 2)))
                     (assert (none? (lru-get! (mut cache) 2)))
                     (assert-eq (lru-len cache) 2)
                     (assert (recency-is? cache [3 1]))))

(deftest a-removed-entry-frees-room-without-an-eviction
         (with-cache [cache 2]
                     (lru-put! (mut cache) 1 10)
                     (lru-put! (mut cache) 2 20)
                     (lru-remove! (mut cache) 1)
                     (assert (none? (lru-put! (mut cache) 3 30)))
                     (assert (recency-is? cache [3 2]))))

(deftest capacity-one-keeps-only-the-latest-entry
         (with-cache [cache 1]
                     (assert (none? (lru-put! (mut cache) 1 10)))
                     (assert (entry-is? (lru-put! (mut cache) 2 20) 1 10))
                     (assert (entry-is? (lru-put! (mut cache) 2 21) 2 20))
                     (assert (get-is? (mut cache) 2 21))
                     (assert (none? (lru-get! (mut cache) 1)))
                     (assert (recency-is? cache [2]))))

;; Keys a multiple of 16 apart share their home bucket, so every removal here also
;; exercises shifting a probe run back.
(deftest freed-slots-are-reused-without-allocating
         (let [debug (debug-allocator-init (malloc-allocator))]
           (match (lru-new [i64 i64]
                           (borrowed-lease (debug-allocator-view debug))
                           4)
             (None [] (assert false))
             (Some [fresh]
                   (let [(mut cache) fresh
                         allocated (.live-allocations debug)]
                     (for round
                       (range 0 500)
                       (for i
                         (range 0 4)
                         (assert (none? (lru-put! (mut cache)
                                                  (+ round (* 16 i))
                                                  i))))
                       (for i
                         (range 0 4)
                         (assert (entry-is? (lru-remove! (mut cache)
                                                         (+ round (* 16 i)))
                                            (+ round (* 16 i))
                                            i))))
                     (assert-eq (lru-len cache) 0)
                     (assert-eq (.live-allocations debug) allocated))))
           (assert-eq (debug-allocator-deinit! debug) 0)))
