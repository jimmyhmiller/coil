(module examples.lru.cache)
(import "coil.alloc" :use [AllocatorLease allocator-lease-borrow alloc free])
(import "coil.result" :use [some?])
(import "coil.slice" :use [slice-data])
(import "examples.lru.key" :use [CacheKey key-hash same-key?])

;;; One cached pair. Entries the cache lets go of are handed back to the caller,
;;; who owns them from then on.
(defstruct Entry [K V] [(key K) (value V)])

;; Every slot is on exactly one of two circular doubly-linked lists: the recency
;; list (live entries, most recent first) or the free list. Each list has a head
;; slot of its own after the `capacity` real ones, so linking and unlinking never
;; meet an empty list or an end. While a slot is on the recency list its entry is
;; initialized and `bucket` is where the index points at it; otherwise neither
;; means anything.
(defstruct Slot [K V] [(prev i64) (next i64) (bucket i64) (entry (Entry K V))])

;;; A least-recently-used cache holding at most `capacity` entries.
;;;
;;; `lru-new` allocates everything the cache will ever use: a slot array, and an
;;; open-addressed table mapping each key to its slot. Nothing grows afterwards,
;;; and dropping the cache drops every entry still in it.
(defstruct Lru [K V]
  [(capacity i64)
   (len i64)
   (slots (slice (Slot K V)))
   (buckets (slice (Option i64)))  ; slot of each cached key; a power of two long
   (lease AllocatorLease)])

;;; A cache for `capacity` entries, or `None` when `capacity` is below one or the
;;; lease's allocator cannot supply the storage. The cache keeps a clone of
;;; `lease`, so its allocator stays alive for as long as the cache does.
(defn lru-new [(K CacheKey) V] [(lease (ref AllocatorLease)) (capacity i64)] (-> (Option (Lru K
                                                                                              V)))
  (if (< capacity 1)
      (None)
      (let [a (allocator-lease-borrow lease)]
        (match (alloc [(Slot K V)] a (+ capacity 2))
          (None [] (None))
          (Some [slots]
                (match (alloc [(Option i64)] a (bucket-count capacity))
                  (None [] (do (free a slots) (None)))
                  (Some [buckets]
                        (let [(mut cache)
                                (Lru
                                  :capacity capacity
                                  :len 0
                                  :slots slots
                                  :buckets buckets
                                  :lease (clone lease))]
                          (init! (mut cache))
                          (Some cache)))))))))

;; At most half full, so every probe run ends at an empty bucket soon.
(defn bucket-count [(capacity i64)] (-> i64)
  (let [(mut n) 2]
    (while (< n (* 2 capacity)) (set! n (* n 2)))
    n))

;; The empty cache: every slot on the free list, every bucket empty.
(defn init! [K V] [(cache (mut (Lru K V)))] (-> void)
  (empty-list! (mut cache) (recent-head cache))
  (empty-list! (mut cache) (free-head cache))
  (for slot
    (range 0 (.capacity cache))
    (link-after! (mut cache) (free-head cache) slot))
  (for bucket
    (range 0 (len (.buckets cache)))
    (set! (mut (.buckets cache)) bucket (None))))

;;; How many entries the cache holds.
(defn lru-len [K V] [(cache (ref (Lru K V)))] (-> i64)
  (.len cache))

;;; The most entries the cache will hold.
(defn lru-capacity [K V] [(cache (ref (Lru K V)))] (-> i64)
  (.capacity cache))

;;; A clone of the value cached under `key`, which becomes the most recently used
;;; entry. `None` when the key is not cached.
(defn lru-get! [(K CacheKey) (V Clone)] [(cache (mut (Lru K V))) (key (ref K))] (-> (Option V))
  (match (find cache key)
    (None [] (None))
    (Some [slot]
          (do
            (move-to-front! (mut cache) slot)
            (Some (cloned [V] (field (entry-at cache slot) value)))))))

;; `clone` will not accept a pointer for its `(ref Self)` receiver; an ordinary
;; function's `(ref T)` parameter will.
(defn cloned [(T Clone)] [(value (ref T))] (-> T)
  (clone value))

;;; Cache `value` under `key` as the most recently used entry. Returns the entry
;;; the cache let go of to make room: the old entry for `key` when it was already
;;; cached, else the least recently used entry when the cache was full.
(defn lru-put! [(K CacheKey) V] [(cache (mut (Lru K V))) (key K) (value V)] (-> (Option (Entry K
                                                                                               V)))
  (let [(mut entry) (Entry :key key :value value)]
    (match (find cache (field (mut entry) key))
      (Some [slot]
            (let [old (take! [(Entry K V)] (entry-at cache slot))]
              (set! (entry-at cache slot) entry)
              (move-to-front! (mut cache) slot)
              (Some old)))
      (None []
            (let [evicted (make-room! (mut cache))
                  slot (.next (slot-at cache (free-head cache)))]
              (unlink! (mut cache) slot)
              (set! (entry-at cache slot) entry)
              (index-insert! (mut cache) slot)
              (link-after! (mut cache) (recent-head cache) slot)
              (set! (.len cache) (+ (.len cache) 1))
              evicted)))))

;; Evict the least recently used entry if the cache is full, so a slot is free.
(defn make-room! [(K CacheKey) V] [(cache (mut (Lru K V)))] (-> (Option (Entry K
                                                                               V)))
  (if (< (.len cache) (.capacity cache))
      (None)
      (Some (release! (mut cache) (.prev (slot-at cache (recent-head cache)))))))

;;; Remove `key` from the cache, handing back its entry. `None` when it was not cached.
(defn lru-remove! [(K CacheKey) V] [(cache (mut (Lru K V))) (key (ref K))] (-> (Option (Entry K
                                                                                              V)))
  (match (find cache key)
    (None [] (None))
    (Some [slot]
          (Some (release! (mut cache) slot)))))

;; Take a live slot's entry out of the cache and put the slot on the free list.
(defn release! [(K CacheKey) V] [(cache (mut (Lru K V))) (slot i64)] (-> (Entry K
                                                                                V))
  (index-remove! (mut cache) (.bucket (slot-at cache slot)))
  (unlink! (mut cache) slot)
  (link-after! (mut cache) (free-head cache) slot)
  (set! (.len cache) (- (.len cache) 1))
  (take! [(Entry K V)] (entry-at cache slot)))

;; ---- the recency and free lists ---------------------------------------------
(defn empty-list! [K V] [(cache (mut (Lru K V))) (head i64)] (-> void)
  (set! (.prev (slot-at cache head)) head)
  (set! (.next (slot-at cache head)) head))

(defn recent-head [K V] [(cache (ref (Lru K V)))] (-> i64)
  (.capacity cache))

(defn free-head [K V] [(cache (ref (Lru K V)))] (-> i64)
  (+ (.capacity cache) 1))

(defn slot-at [K V] [(cache (ref (Lru K V))) (slot i64)] (-> (ptr (Slot K V)))
  (index (slice-data (.slots cache)) slot))

(defn entry-at [K V] [(cache (ref (Lru K V))) (slot i64)] (-> (ptr (Entry K V)))
  (field (slot-at cache slot) entry))

(defn unlink! [K V] [(cache (mut (Lru K V))) (slot i64)] (-> void)
  (let [prev (.prev (slot-at cache slot))
        next (.next (slot-at cache slot))]
    (set! (.next (slot-at cache prev)) next)
    (set! (.prev (slot-at cache next)) prev)))

(defn link-after! [K V] [(cache (mut (Lru K V))) (head i64) (slot i64)] (-> void)
  (let [first (.next (slot-at cache head))]
    (set! (.prev (slot-at cache slot)) head)
    (set! (.next (slot-at cache slot)) first)
    (set! (.prev (slot-at cache first)) slot)
    (set! (.next (slot-at cache head)) slot)))

(defn move-to-front! [K V] [(cache (mut (Lru K V))) (slot i64)] (-> void)
  (unlink! (mut cache) slot)
  (link-after! (mut cache) (recent-head cache) slot))

;; ---- the key index ----------------------------------------------------------
;; Linear probing over `buckets`. Removal shifts the rest of a probe run back
;; instead of leaving tombstones, so lookups stay short however much the cache
;; churns.
(defn bucket-mask [K V] [(cache (ref (Lru K V)))] (-> i64)
  (- (len (.buckets cache)) 1))

(defn home-bucket [(K CacheKey) V] [(cache (ref (Lru K V))) (key (ref K))] (-> i64)
  (& (key-hash key) (bucket-mask cache)))

(defn next-bucket [K V] [(cache (ref (Lru K V))) (bucket i64)] (-> i64)
  (& (+ bucket 1) (bucket-mask cache)))

(defn key-of [K V] [(cache (ref (Lru K V))) (slot i64)] (-> (ptr K))
  (field (entry-at cache slot) key))

(defn find [(K CacheKey) V] [(cache (ref (Lru K V))) (key (ref K))] (-> (Option i64))
  (let [(mut bucket) (home-bucket cache key)]
    (loop (match (get (.buckets cache) bucket)
            (None [] (break (None)))
            (Some [slot]
                  (if (same-key? (key-of cache slot) key)
                      (break (Some slot))
                      (set! bucket (next-bucket cache bucket))))))))

(defn index-insert! [(K CacheKey) V] [(cache (mut (Lru K V))) (slot i64)] (-> void)
  (let [(mut bucket) (home-bucket [K V] cache (key-of cache slot))]
    (while (some? (get (.buckets cache) bucket))
      (set! bucket (next-bucket cache bucket)))
    (set! (mut (.buckets cache)) bucket (Some slot))
    (set! (.bucket (slot-at cache slot)) bucket)))

(defn index-remove! [(K CacheKey) V] [(cache (mut (Lru K V))) (bucket i64)] (-> void)
  (let [mask (bucket-mask cache)
        (mut hole) bucket
        (mut probe) (next-bucket cache bucket)]
    (loop (match (get (.buckets cache) probe)
            (None [] (break))
            (Some [slot]
                  (let [home (home-bucket [K V] cache (key-of cache slot))]
                    ; The entry may fill the hole only if the hole lies between its
                    ; home bucket and where it sits now.
                    (when (>= (& (- probe home) mask) (& (- probe hole) mask))
                      (set! (mut (.buckets cache)) hole (Some slot))
                      (set! (.bucket (slot-at cache slot)) hole)
                      (set! hole probe))
                    (set! probe (next-bucket cache probe))))))
    (set! (mut (.buckets cache)) hole (None))))

;; ---- iteration and ownership ------------------------------------------------

;;; A cursor over a cache's entries from most to least recently used, yielding
;;; borrowed pointers. Walking it does not count as using an entry. It borrows the
;;; cache, which must outlive it and not change while it is in use.
(defstruct Recency [K V] [(slots (ptr (Slot K V))) (head i64) (at i64)])

;;; The cache's entries, most recently used first.
(defn lru-recency [K V] [(cache (ref (Lru K V)))] (-> (Recency K V))
  (Recency
    :slots (slice-data (.slots cache))
    :head (recent-head cache)
    :at (recent-head cache)))

(impl [K V] Iterator (Recency K V)
  (next [(it (mut (Recency K V)))]
        (-> (Option (ptr (Entry K V))))
        (let [slot (.next (index (.slots it) (.at it)))]
          (if (= slot (.head it))
              (None)
              (do
                (set! (.at it) slot)
                (Some (field (index (.slots it) slot) entry)))))))

(impl [K V] Iterable (Recency K V)
  (iter [(it (Recency K V))] (-> (Recency K V)) it))

(impl [K V] Drop (Lru K V)
  (drop [(cache (mut (Lru K V)))]
        (-> void)
        ; Taking each entry out of its slot and letting it go drops it.
        (for entry
          (lru-recency cache)
          (let [spent (take! [(Entry K V)] entry)] 0))
        (let [a (allocator-lease-borrow (field cache lease))]
          (free a (.slots cache))
          (free a (.buckets cache)))))
