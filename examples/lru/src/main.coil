;;; An LRU cache in front of a slow page store.
;;;
;;; A client asks for pages: a skewed working set, then a one-off scan through
;;; pages it never asks for again, then the working set once more. Every request
;;; goes through an `(Lru i64 i64)` from page number to page checksum; a miss reads
;;; the page from the store and caches it, evicting the least recently used page
;;; when the cache is full. The run is repeated for several cache sizes.
;;;
;;;     coil run examples/lru
;;;
;;; prints
;;;
;;;     84 requests: working set x3, scan of 12 pages, working set x3
;;;     capacity  hits  misses  evictions  hit rate  cached, most recent first
;;;            2    16      68         66     19.0%  6 1
;;;            4    44      40         36     52.4%  6 1 2 5
;;;            6    60      24         18     71.4%  6 1 2 5 4 3
;;;           12    60      24         12     71.4%  6 1 2 5 4 3 111 110 109 108 107 106
;;;           18    66      18          0     78.6%  6 1 2 5 4 3 111 110 109 108 107 106 105 104 103 102 101 100
;;;
;;; Six pages make up the working set, yet doubling the cache from 6 to 12 buys
;;; nothing: the scan pushes the whole working set out, because to LRU a page
;;; read once a moment ago looks more valuable than a hot page read before the
;;; scan. Only a cache big enough for the scan and the working set together (18)
;;; keeps the hot pages through it.
(module examples.lru.main)
(import "coil.alloc" :use [malloc-allocator-lease])
(import "coil.result" :use [some?])
(import "examples.lru.cache" :use [Lru lru-new lru-get! lru-put! lru-recency])

;; The pages the client keeps coming back to, in the order it asks for them.
(const WORKING-SET [1 2 1 3 1 2 4 1 5 2 1 6])

(const WORKING-SET-ROUNDS 3)

(const SCAN-START 100)

(const SCAN-LENGTH 12)

(defn working-set-pass [] (-> i64)
  (* WORKING-SET-ROUNDS (len WORKING-SET)))

;; Request `i` of the run.
(defn request [(i i64)] (-> i64)
  (let [scan-from (working-set-pass)
        scan-to (+ scan-from SCAN-LENGTH)]
    (cond (< i scan-from) (get WORKING-SET (% i (len WORKING-SET)))
          (< i scan-to) (+ SCAN-START (- i scan-from))
          :else (get WORKING-SET (% (- i scan-to) (len WORKING-SET))))))

(defn request-count [] (-> i64)
  (+ (* 2 (working-set-pass)) SCAN-LENGTH))

;;; The slow lookup the cache saves: reading a page from the store, which here
;;; means checksumming its 4 KiB.
(defn read-page [(page i64)] (-> i64)
  (fold (fn [sum byte] (% (+ (* sum 31) byte) 1000003))
        page
        (map (fn [offset] (% (* offset 7) 251)) (range 0 4096))))

(defstruct Stats [(hits i64) (misses i64) (evictions i64)])

;;; Serve every request through `cache`, going to the store only on a miss.
(defn serve [(cache (mut (Lru i64 i64)))] (-> Stats)
  (let [(mut stats)
          (Stats
            :hits 0
            :misses 0
            :evictions 0)]
    (for i
      (range 0 (request-count))
      (let [page (request i)]
        (match (lru-get! (mut cache) page)
          (Some [_] (set! (.hits stats) (+ (.hits stats) 1)))
          (None []
                (set! (.misses stats) (+ (.misses stats) 1))
                (when (some? (lru-put! (mut cache) page (read-page page)))
                  (set! (.evictions stats) (+ (.evictions stats) 1)))))))
    stats))

(defn report [(capacity i64) (stats Stats) (cache (ref (Lru i64 i64)))] (-> void)
  (let [rate (/ (* 100.0 (cast f64 (.hits stats))) (cast f64 (request-count)))]
    (print "{:>8} {:>5} {:>7} {:>10} {:>8.1}% "
           capacity
           (.hits stats)
           (.misses stats)
           (.evictions stats)
           rate)
    (for entry (lru-recency cache) (print " {}" (.key entry)))
    (println "")))

(defn main [] (-> i64)
  (println "{} requests: working set x{}, scan of {} pages, working set x{}"
           (request-count)
           WORKING-SET-ROUNDS
           SCAN-LENGTH
           WORKING-SET-ROUNDS)
  (println "capacity  hits  misses  evictions  hit rate  cached, most recent first")
  (for capacity
    [2 4 6 12 18]
    (match (lru-new [i64 i64] (malloc-allocator-lease) capacity)
      (None [] (println "no memory for a cache of {} pages" capacity))
      (Some [fresh]
            (let [(mut cache) fresh
                  stats (serve (mut cache))]
              (report capacity stats cache)))))
  0)
