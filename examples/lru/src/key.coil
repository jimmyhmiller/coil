(module examples.lru.key)

;;; What the cache asks of a key: a hash, and an equality test, that only borrow it.
;;;
;;; The prelude's `Hash` and `Eq` take `Self` by value. For a key that owns memory
;;; (a `Drop` type) that would hand the key over on every lookup, so a cache keyed
;;; by owned strings could not be queried without giving its keys away.
(deftrait CacheKey [Self]
  (key-hash [(key (ref Self))] (-> i64))
  (same-key? [(a (ref Self)) (b (ref Self))] (-> bool)))

(impl CacheKey i64
  (key-hash [(key (ref i64))] (-> i64) (hash key))
  (same-key? [(a (ref i64)) (b (ref i64))] (-> bool) (= a b)))
