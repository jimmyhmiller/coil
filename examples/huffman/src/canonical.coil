;;; Canonical Huffman codes. Given only each byte's code length, the codes are
;;; fixed: shorter codes come first, bytes of one length take consecutive codes in
;;; byte order. That is why a file needs to store nothing but the 256 lengths.
(module examples.huffman.canonical)
(import "coil.result" :use [ok-or])
(import "examples.huffman.bits" :use [BitReader read-bit! bit-position])
(import "examples.huffman.error" :use *)
(import "examples.huffman.tree" :use [MAX-CODE-LEN])

;;; A code: its low `length` bits, high bit first.
(defstruct Codeword [(bits u32) (length u8)])

(derive Debug Eq Codeword)

;;; How many bytes have each code length, indexed by length (index 0 unused).
(defn length-counts [(lengths (array u8 256))] (-> (array u32 33))
  (let [(mut counts) (zeroed (array u32 33))]
    (for length
      lengths
      (when (> length 0)
        (let [i (cast i64 length)]
          (set! (mut counts) i (+ (get counts i) 1)))))
    counts))

;;; The canonical code of every byte with a nonzero length. `lengths` must come
;;; from `code-lengths`, or have passed `decode-table`.
(defn canonical-codes [(lengths (array u8 256))] (-> (array Codeword 256))
  (let [counts (length-counts lengths)
        ;; u64: past the longest length in use the next code can reach 2^32.
        (mut next-code) (zeroed (array u64 33))
        (mut codes) (zeroed (array Codeword 256))]
    (for length
      (range 1 (+ MAX-CODE-LEN 1))
      (set! (mut next-code)
            length
            (<< (+ (get next-code (- length 1))
                   (cast u64 (get counts (- length 1))))
                1)))
    (for symbol
      (range 0 256)
      (let [length (cast i64 (get lengths symbol))]
        (when (> length 0)
          (set! (mut codes)
                symbol
                (Codeword :bits (cast u32 (get next-code length))
                  :length (cast u8 length)))
          (set! (mut next-code) length (+ (get next-code length) 1)))))
    codes))

;;; What a decoder needs: how many codes each length has, and the bytes in
;;; canonical order (by length, then by value).
(defstruct DecodeTable [(counts (array u32 33)) (symbols (array u8 256))])

(defn canonical-order [(lengths (array u8 256)) (counts (array u32 33))] (-> (array u8
                                                                                    256))
  (let [(mut next-slot) (zeroed (array u32 33))
        (mut symbols) (zeroed (array u8 256))]
    (for length
      (range 1 (+ MAX-CODE-LEN 1))
      (set! (mut next-slot)
            length
            (+ (get next-slot (- length 1)) (get counts (- length 1)))))
    (for symbol
      (range 0 256)
      (let [length (cast i64 (get lengths symbol))]
        (when (> length 0)
          (set! (mut symbols)
                (cast i64 (get next-slot length))
                (cast u8 symbol))
          (set! (mut next-slot) length (+ (get next-slot length) 1)))))
    symbols))

;;; Check that `lengths` (from an untrusted header) describe a prefix code,
;;; then build its decoding table. A code may be incomplete (one byte alone gets
;;; the single code `0`), but it may never promise more codes than exist.
(defn decode-table [(lengths (array u8 256))] (-> (Result DecodeTable
                                                          FormatError))
  (try (for symbol
         (range 0 256)
         (let [length (get lengths symbol)]
           (ensure! (<= length MAX-CODE-LEN)
                    (Err (CodeTooLong (cast u8 symbol) length)))))
       (let [counts (length-counts lengths)
             (mut unused) 1]
         (for length
           (range 1 (+ MAX-CODE-LEN 1))
           (set! unused (- (* unused 2) (cast i64 (get counts length))))
           (ensure! (>= unused 0) (Err (Oversubscribed (cast u8 length)))))
         (Ok (DecodeTable :counts counts
               :symbols (canonical-order lengths counts))))))

;;; Decode one byte. The code is read a bit at a time; after `n` bits it is a
;;; complete code exactly when it lands among the `n`-bit codes, which are
;;; consecutive integers starting at `first`.
(defn decode-symbol! [(table DecodeTable) (reader (mut BitReader))] (-> (Result u8
                                                                                FormatError))
  (let [start (bit-position reader)]
    (try (let [(mut code) 0
               (mut first) 0
               (mut index) 0]
           (for length
             (range 1 (+ MAX-CODE-LEN 1))
             (set! code
                   (| code
                      (cast i64
                            (try! (ok-or (read-bit! (mut reader)) (Truncated))))))
             (let [count (cast i64 (get (.counts table) length))]
               (when (< (- code first) count)
                 (return-from :try
                                (Ok (get (.symbols table)
                                         (+ index (- code first))))))
               (set! index (+ index count))
               (set! first (<< (+ first count) 1))
               (set! code (<< code 1))))
           (Err (CorruptCode start))))))
