;;; huffman: a Huffman-coding file compressor.
;;;
;;;   huffman compress IN OUT     write IN, compressed, to OUT
;;;   huffman decompress IN OUT   restore a compressed IN to OUT
;;;   huffman demo FILE           round-trip FILE through a temporary file and
;;;                               show the codes chosen for its commonest bytes
;;;
;;; `coil run examples/huffman` runs the demo on the bundled sample text:
;;;
;;;   data/sample.txt: 3636 bytes
;;;   compressed: 2234 bytes (61.4% of the original)
;;;   round trip: identical
;;;
;;;   54 distinct bytes; the 12 most frequent:
;;;   byte    count  bits  code
;;;   ' '       643     3  000
;;;   'e'       395     3  001
;;;   't'       290     4  1010
;;;   'a'       243     4  0100
;;;   ...
;;;   'l'       100     5  11001
;;;
;;; The 2234 bytes include a 268-byte header; see `examples.huffman.format`.
(module examples.huffman.main)
(import "coil.alloc" :use [Allocator malloc-allocator free])
(import "coil.args" :use [args-set! args-count args-nth])
(import "coil.arraylist" :use [ArrayList al-free! al-slice])
(import "coil.fs" :use [read-file write-file])
(import "coil.io" :use [IoError Errno OutOfMemory stderr])
(import "coil.str" :use [cstr->str])
(import "coil.temp" :use [TempError temp-path temp-remove! temp-error-text])
(import "examples.huffman.error" :use [FormatError])
(import "examples.huffman.format" :use [compress decompress])
(import "examples.huffman.report" :use [print-sizes print-code-table])

(extern strerror :cc c [i32] (-> (ptr i8)))

;;; How many rows of the code table the demo prints.
(const TABLE-ROWS 12)

(defsum Command
  (Compress [(input (slice u8)) (output (slice u8))])
  (Decompress [(input (slice u8)) (output (slice u8))])
  (Demo [(input (slice u8))]))

;;; The command named on the command line, or `None` if it is malformed.
(defn parse-command [] (-> (Option Command))
  (let [verb (args-nth 1)
        n (args-count)]
    (cond (and (= verb "compress") (= n 4))
            (Some (Compress (args-nth 2) (args-nth 3)))
          (and (= verb "decompress") (= n 4))
            (Some (Decompress (args-nth 2) (args-nth 3)))
          (and (= verb "demo") (= n 3)) (Some (Demo (args-nth 2)))
          :else (None))))

(defsum AppError
  (Io [(path (slice u8)) (error IoError)])
  (Format [(path (slice u8)) (error FormatError)])
  (Temp [(error TempError)])
  (Mismatch))

(defn io-error-text [(e IoError)] (-> (slice u8))
  (match e
    (Errno [code] (cstr->str (strerror (cast i32 code))))
    (OutOfMemory [] "out of memory")
    (_ "I/O error")))

(impl Display AppError
  (display-fmt [(e AppError) (f (ptr Formatter))]
               (-> i64)
               (let [w (formatter-writer f)]
                 (match e
                   (Io [path error] (fmt w "{}: {}" path (io-error-text error)))
                   (Format [path error] (fmt w "{}: {}" path error))
                   (Temp [error] (fmt w "{}" (temp-error-text error)))
                   (Mismatch [] (fmt w "round trip changed the data"))))
               0))

;;; The whole file at `path`, allocated with `a`; release it with `free`.
(defn read-input [(a (dyn Allocator)) (path (slice u8))] (-> (Result (slice u8)
                                                                     AppError))
  (match (read-file a path)
    (Ok [bytes] (Ok bytes))
    (Err [e] (Err (Io path e)))))

(defn write-output [(a (dyn Allocator)) (path (slice u8)) (bytes (slice u8))] (-> (Result i64
                                                                                          AppError))
  (match (write-file a path bytes)
    (Ok [n] (Ok n))
    (Err [e] (Err (Io path e)))))

;;; A fresh temporary file name ending in `name`.
(defn temp-file [(name (slice u8))] (-> (Result (slice u8) AppError))
  (match (temp-path name)
    (Ok [path] (Ok path))
    (Err [e] (Err (Temp e)))))

;;; Decompress `bytes`, which came from `path`; the caller frees the result.
(defn restore [(a (dyn Allocator)) (path (slice u8)) (bytes (slice u8))] (-> (Result (ArrayList u8)
                                                                                     AppError))
  (match (decompress a bytes)
    (Ok [out] (Ok out))
    (Err [e] (Err (Format path e)))))

;;; Compress `original` and write it to `path`.
(defn store [(a (dyn Allocator)) (path (slice u8)) (original (slice u8))] (-> (Result i64
                                                                                      AppError))
  (let [(mut packed) (compress a original)
        written (write-output a path (al-slice packed))]
    (al-free! (mut packed))
    written))

;;; Read and decompress the file at `path`; the caller frees the result.
(defn fetch [(a (dyn Allocator)) (path (slice u8))] (-> (Result (ArrayList u8)
                                                                AppError))
  (try (let [packed (try! (read-input a path))
             restored (restore a path packed)]
         (free a packed)
         restored)))

(defn compress-file [(a (dyn Allocator)) (input (slice u8)) (output (slice u8))] (-> (Result i64
                                                                                             AppError))
  (try (let [original (try! (read-input a input))
             written (store a output original)]
         (free a original)
         written)))

(defn decompress-file [(a (dyn Allocator))
                       (input (slice u8))
                       (output (slice u8))] (-> (Result i64 AppError))
  (try (let [(mut restored) (try! (fetch a input))
             written (write-output a output (al-slice restored))]
         (al-free! (mut restored))
         written)))

;;; Compress `original` to `path`, decompress it again, and check that nothing
;;; changed. Returns the compressed size.
(defn check-round-trip [(a (dyn Allocator))
                        (path (slice u8))
                        (original (slice u8))] (-> (Result i64 AppError))
  (try (let [compressed-size (try! (store a path original))
             (mut restored) (try! (fetch a path))
             same (= (al-slice restored) original)]
         (al-free! (mut restored))
         (ensure! same (Err (Mismatch)))
         (Ok compressed-size))))

;;; Round-trip `original` through a temporary file, removed afterwards.
(defn round-trip [(a (dyn Allocator)) (original (slice u8))] (-> (Result i64
                                                                         AppError))
  (try (let [path (try! (temp-file "demo.huf"))
             outcome (check-round-trip a path original)]
         (temp-remove! path)
         outcome)))

(defn show-demo [(input (slice u8)) (original (slice u8)) (compressed-size i64)] (-> void)
  (print-sizes input (len original) compressed-size)
  (println "round trip: identical")
  (println "")
  (print-code-table original TABLE-ROWS))

(defn demo [(a (dyn Allocator)) (input (slice u8))] (-> (Result i64 AppError))
  (try (let [original (try! (read-input a input))
             outcome (round-trip a original)]
         (match outcome
           (Ok [compressed-size] (show-demo input original compressed-size))
           ;; Nothing to show; the error is returned below.
           (Err [_] 0))
         (free a original)
         outcome)))

(defn run [(a (dyn Allocator)) (command Command)] (-> (Result i64 AppError))
  (match command
    (Compress [input output] (compress-file a input output))
    (Decompress [input output] (decompress-file a input output))
    (Demo [input] (demo a input))))

(defn usage [] (-> i64)
  (fmt (stderr) "usage: huffman compress IN OUT\n")
  (fmt (stderr) "       huffman decompress IN OUT\n")
  (fmt (stderr) "       huffman demo FILE\n")
  2)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args-set! argc argv)
  (match (parse-command)
    (None [] (usage))
    (Some [command]
          (match (run (malloc-allocator) command)
            (Ok [_] 0)
            (Err [e]
                 (fmt (stderr) "huffman: {}\n" e)
                 1)))))
