;;; Bit-granular writing and reading over byte buffers. Bits are packed
;;; most-significant first, so a code written as `1101` reads back in that order.
(module examples.huffman.bits)
(import "coil.arraylist" :use [ArrayList])

;;; Appends bits to an owned byte list. Up to seven not-yet-full bits wait in
;;; `pending`, right-aligned; `finish` pads the last byte with zeros.
(defstruct BitWriter [(bytes (ArrayList u8)) (pending u64) (pending-count u8)])

;;; A writer that appends to `bytes`, taking ownership of the list. Whatever the
;;; list already holds stays in front of the bits.
(defn bit-writer [(bytes (ArrayList u8))] (-> BitWriter)
  (BitWriter
    :bytes bytes
    :pending 0
    :pending-count 0))

;;; Append the low `count` bits of `value`, high bit first. `count` is at most 32.
(defn write-bits! [(w (mut BitWriter)) (value u32) (count u8)] (-> void)
  (set! (.pending w) (| (<< (.pending w) (cast u64 count)) (cast u64 value)))
  (set! (.pending-count w) (+ (.pending-count w) count))
  (while (>= (.pending-count w) 8)
    (set! (.pending-count w) (- (.pending-count w) 8))
    (push! (mut (.bytes w))
           (cast u8 (& (>> (.pending w) (cast u64 (.pending-count w))) 0xFF))))
  (set! (.pending w)
        (& (.pending w) (- (<< (: 1 u64) (cast u64 (.pending-count w))) 1))))

;;; Flush the final partial byte (zero-padded) and hand back the bytes.
(defn finish [(w (mut BitWriter))] (-> (ArrayList u8))
  (when (> (.pending-count w) 0)
    (write-bits! (mut w) 0 (- (: 8 u8) (.pending-count w))))
  (.bytes w))

;;; Reads bits back out of a borrowed byte slice.
(defstruct BitReader [(bytes (slice u8)) (position i64)])

(defn bit-reader [(bytes (slice u8))] (-> BitReader)
  (BitReader :bytes bytes :position 0))

;;; How many bits have been consumed so far.
(defn bit-position [(r BitReader)] (-> i64)
  (.position r))

;;; The next bit, or `None` once every byte is used up.
(defn read-bit! [(r (mut BitReader))] (-> (Option u32))
  (let [at (.position r)]
    (if (>= at (* 8 (len (.bytes r))))
        (None)
        (let [byte (get (.bytes r) (>> at 3))
              shift (- 7 (& at 7))]
          (set! (.position r) (+ at 1))
          (Some (cast u32 (& (>> byte (cast u8 shift)) 1)))))))

;;; The next `count` bits as an integer, high bit first, or `None` if the
;;; slice ends before all of them are read.
(defn read-bits! [(r (mut BitReader)) (count u8)] (-> (Option u32))
  (try (let [(mut value) (: 0 u32)]
         (for _
           (range 0 (cast i64 count))
           (set! value (| (<< value 1) (try? (read-bit! (mut r))))))
         (Some value))))
