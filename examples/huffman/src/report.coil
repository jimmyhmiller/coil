;;; The demo's summary: sizes, and the code chosen for the most frequent bytes.
(module examples.huffman.report)
(import "coil.slice" :use [sort])
(import "examples.huffman.canonical" :use [Codeword canonical-codes])
(import "examples.huffman.freq" :use [count-bytes distinct-bytes])
(import "examples.huffman.tree" :use [code-lengths])

;;; A byte as a reader would want to see it in a table.
(defstruct ByteLabel [(byte u8)])

(impl Display ByteLabel
  (display-fmt [(label ByteLabel) (f (ptr Formatter))]
               (-> i64)
               (let [w (formatter-writer f)
                     b (.byte label)]
                 (cond (= b (: #\newline u8)) (fmt w "'\\n'")
                       (= b (: #\tab u8)) (fmt w "'\\t'")
                       (and (>= b (: #\space u8)) (<= b (: #\~ u8)))
                         (let [text [b]] (fmt w "'{}'" (: text (slice u8))))
                       :else (fmt w "0x{:x}" (cast i64 b))))
               0))

(impl Display Codeword
  (display-fmt [(code Codeword) (f (ptr Formatter))]
               (-> i64)
               (let [w (formatter-writer f)]
                 (for i
                   (range 0 (cast i64 (.length code)))
                   (let [shift (- (cast i64 (.length code)) 1 i)]
                     (fmt w "{}" (& (>> (.bits code) (cast u32 shift)) 1)))))
               0))

(defstruct SymbolStat [(byte u8) (count u64)])

;;; Most frequent first; ties in byte order.
(defn by-frequency [(a SymbolStat) (b SymbolStat)] (-> i64)
  (cond (> (.count a) (.count b)) -1
        (< (.count a) (.count b)) 1
        :else (- (cast i64 (.byte a)) (cast i64 (.byte b)))))

(defn ranked-bytes [(counts (array u64 256))] (-> (array SymbolStat 256))
  (let [(mut stats) (zeroed (array SymbolStat 256))]
    (for i
      (range 0 256)
      (set! (mut stats) i (SymbolStat :byte (cast u8 i) :count (get counts i))))
    (sort stats (fn [a b] (by-frequency a b)))
    stats))

;;; The original and compressed sizes, and how much was saved.
(defn print-sizes [(name (slice u8)) (original-size i64) (compressed-size i64)] (-> void)
  (println "{}: {} bytes" name original-size)
  (println "compressed: {} bytes ({:.1}% of the original)"
           compressed-size
           (if (= original-size 0)
               0.0
               (/ (* 100.0 (cast f64 compressed-size)) (cast f64 original-size)))))

;;; A table of the `rows` most frequent bytes of `data` with their codes.
(defn print-code-table [(data (slice u8)) (rows i64)] (-> void)
  (let [counts (count-bytes data)
        codes (canonical-codes (code-lengths counts))
        distinct (distinct-bytes counts)
        shown (if (< distinct rows) distinct rows)]
    (println "{} distinct bytes; the {} most frequent:" distinct shown)
    (println "{:<6} {:>6} {:>5}  {}" "byte" "count" "bits" "code")
    (for stat
      (take shown (ranked-bytes counts))
      (let [code (get codes (cast i64 (.byte stat)))]
        (println "{:<6} {:>6} {:>5}  {}"
                 (ByteLabel :byte (.byte stat))
                 (.count stat)
                 (.length code)
                 code)))))
