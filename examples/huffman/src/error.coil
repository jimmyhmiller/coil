;;; Everything that can be wrong with a compressed file.
(module examples.huffman.error)

;;; Why a compressed buffer could not be decoded.
(defsum FormatError
  (BadMagic)
  (Truncated)
  (CodeTooLong [(symbol u8) (length u8)])
  (Oversubscribed [(length u8)])
  (CorruptCode [(bit-offset i64)])
  (TrailingBytes [(count i64)]))

(derive Debug Eq FormatError)

(impl Display FormatError
  (display-fmt [(e FormatError) (f (ptr Formatter))]
    (-> i64)
    (let [w (formatter-writer f)]
      (match e
        (BadMagic [] (fmt w "not a huffman file (bad magic bytes)"))
        (Truncated [] (fmt w "file is truncated"))
        (CodeTooLong [symbol length]
                     (fmt w
                          "byte {} has a {}-bit code, longer than allowed"
                          symbol
                          length))
        (Oversubscribed [length]
                        (fmt w
                             "code lengths claim more {}-bit codes than exist"
                             length))
        (CorruptCode [bit]
                     (fmt w
                          "no code matches the bits at bit offset {}"
                          bit))
        (TrailingBytes [count]
                       (fmt w
                            "{} unexpected bytes after the data"
                            count))))
    0))
