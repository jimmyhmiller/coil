;;; Byte frequency counting.
(module examples.huffman.freq)

;;; How often each byte value occurs in `data`, indexed by the byte.
(defn count-bytes [(data (slice u8))] (-> (array u64 256))
  (let [(mut counts) (zeroed (array u64 256))]
    (for byte data
      (let [i (cast i64 byte)]
        (set! (mut counts) i (+ (get counts i) 1))))
    counts))

;;; How many different byte values occur at all.
(defn distinct-bytes [(counts (array u64 256))] (-> i64)
  (count (filter (fn [n] (> n 0)) counts)))
