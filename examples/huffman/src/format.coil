;;; The compressed file format:
;;;
;;;   bytes 0..4     magic "HUF1"
;;;   bytes 4..12    original size in bytes, u64 little-endian
;;;   bytes 12..268  code length of each byte value 0..255 (0 = unused)
;;;   bytes 268..    the canonical codes of the original bytes, high bit
;;;                  first, the last byte zero-padded
(module examples.huffman.format)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList al-new al-reserve! al-free!])
(import "coil.slice" :use [subslice])
(import "examples.huffman.bits" :use *)
(import "examples.huffman.canonical"
        :use
        [canonical-codes decode-table decode-symbol! DecodeTable])
(import "examples.huffman.error" :use *)
(import "examples.huffman.freq" :use [count-bytes])
(import "examples.huffman.tree" :use [code-lengths])

;;; The first bytes of every compressed file.
(def MAGIC "HUF1")

(const SIZE-OFFSET 4)

(const LENGTHS-OFFSET 12)

;;; Where the coded bits begin.
(const HEADER-LEN 268)

;;; Everything before the coded bits.
(defstruct Header [(original-size u64) (lengths (array u8 256))])

(defn write-header [(out (mut (ArrayList u8))) (header Header)] (-> void)
  (for byte MAGIC (push! (mut out) byte))
  (for i
    (range 0 8)
    (push! (mut out)
           (cast u8
                 (& (>> (.original-size header) (cast u64 (* 8 i))) 0xFF))))
  (for length (.lengths header) (push! (mut out) length)))

;;; Compress `data` into a new list allocated with `a`; the caller frees it.
(defn compress [(a (dyn Allocator)) (data (slice u8))] (-> (ArrayList u8))
  (let [lengths (code-lengths (count-bytes data))
        codes (canonical-codes lengths)
        (mut out) (al-new [u8] a)]
    (write-header (mut out)
                  (Header :original-size (cast u64 (len data))
                    :lengths lengths))
    (let [(mut writer) (bit-writer out)]
      (for byte
        data
        (let [code (get codes (cast i64 byte))]
          (write-bits! (mut writer) (.bits code) (.length code))))
      (finish (mut writer)))))

(defn read-u64-le [(bytes (slice u8))] (-> u64)
  (let [(mut value) (: 0 u64)]
    (for i
      (range 0 8)
      (set! value (| value (<< (cast u64 (get bytes i)) (cast u64 (* 8 i))))))
    value))

(defn read-lengths [(bytes (slice u8))] (-> (array u8 256))
  (let [(mut lengths) (zeroed (array u8 256))]
    (for i (range 0 256) (set! (mut lengths) i (get bytes i)))
    lengths))

;;; Read and check the fixed-size header at the front of `data`.
(defn parse-header [(data (slice u8))] (-> (Result Header FormatError))
  (try (ensure! (>= (len data) (len MAGIC)) (Err (Truncated)))
       (ensure! (= (subslice data 0 (len MAGIC)) MAGIC) (Err (BadMagic)))
       (ensure! (>= (len data) HEADER-LEN) (Err (Truncated)))
       (Ok (Header :original-size
                     (read-u64-le (subslice data SIZE-OFFSET LENGTHS-OFFSET))
             :lengths (read-lengths (subslice data LENGTHS-OFFSET HEADER-LEN))))))

;;; Decode `count` bytes from `payload` onto `out`, which must use every byte
;;; of the payload.
(defn decode-payload! [(table DecodeTable)
                       (payload (slice u8))
                       (count i64)
                       (out (mut (ArrayList u8)))] (-> (Result i64 FormatError))
  (try (let [(mut reader) (bit-reader payload)]
         (for _
           (range 0 count)
           (push! (mut out) (try! (decode-symbol! table (mut reader)))))
         (let [used (/ (+ (bit-position reader) 7) 8)
               extra (- (len payload) used)]
           (ensure! (= extra 0) (Err (TrailingBytes extra)))
           (Ok count)))))

;;; Decompress `data` into a new list allocated with `a`; the caller frees it.
(defn decompress [(a (dyn Allocator)) (data (slice u8))] (-> (Result (ArrayList u8)
                                                                     FormatError))
  (try (let [header (try! (parse-header data))
             table (try! (decode-table (.lengths header)))
             payload (subslice data HEADER-LEN (len data))]
         ;; Every byte costs at least one bit, so a size beyond that is a lie, and
         ;; checking it first keeps a forged header from sizing a huge allocation.
         (ensure! (<= (.original-size header) (cast u64 (* 8 (len payload))))
                  (Err (Truncated)))
         (let [count (cast i64 (.original-size header))
               (mut out) (al-new [u8] a)]
           (al-reserve! (mut out) count)
           (match (decode-payload! table payload count (mut out))
             (Ok [_] (Ok out))
             (Err [e]
                  (al-free! (mut out))
                  (Err e)))))))
