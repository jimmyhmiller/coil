;;; A binary min-heap keyed by a `u64` priority. Equal priorities come out in
;;; insertion order, which keeps everything built on it deterministic.
(module examples.huffman.heap)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList al-new al-free!])

;;; One queued value with its priority.
(defstruct Entry [T] [(priority u64) (seq u64) (value T)])

;;; The heap owns its entry list; release it with `heap-free!`.
(defstruct MinHeap [T] [(entries (ArrayList (Entry T))) (next-seq u64)])

(defn heap-new [T] [(a (dyn Allocator))] (-> (MinHeap T))
  (MinHeap :entries (al-new [(Entry T)] a) :next-seq 0))

(defn heap-free! [T] [(h (mut (MinHeap T)))] (-> void)
  (al-free! (mut (.entries h))))

(defn heap-len [T] [(h (MinHeap T))] (-> i64)
  (len (.entries h)))

(defn before? [T] [(a (Entry T)) (b (Entry T))] (-> bool)
  (or (< (.priority a) (.priority b))
      (and (= (.priority a) (.priority b)) (< (.seq a) (.seq b)))))

(defn swap! [T] [(entries (mut (ArrayList (Entry T)))) (i i64) (j i64)] (-> void)
  (let [x (get entries i)]
    (set! (mut entries) i (get entries j))
    (set! (mut entries) j x)))

(defn sift-up! [T] [(entries (mut (ArrayList (Entry T)))) (start i64)] (-> void)
  (let [(mut i) start]
    (while (and (> i 0)
                (before? (get entries i) (get entries (/ (- i 1) 2))))
      (swap! (mut entries) i (/ (- i 1) 2))
      (set! i (/ (- i 1) 2)))))

(defn smallest-child [T] [(entries (ArrayList (Entry T))) (i i64)] (-> i64)
  (let [left (+ (* 2 i) 1)
        right (+ left 1)]
    (if (and (< right (len entries))
             (before? (get entries right) (get entries left)))
        right
        left)))

(defn sift-down! [T] [(entries (mut (ArrayList (Entry T))))] (-> void)
  (let [(mut i) 0]
    (loop (let [child (smallest-child entries i)]
            (if (and (< child (len entries))
                     (before? (get entries child) (get entries i)))
                (do (swap! (mut entries) i child) (set! i child))
                (break))))))

;;; Queue `value` with `priority`.
(defn heap-push! [T] [(h (mut (MinHeap T))) (priority u64) (value T)] (-> void)
  (push! (mut (.entries h))
         (Entry
           :priority priority
           :seq (.next-seq h)
           :value value))
  (set! (.next-seq h) (+ (.next-seq h) 1))
  (sift-up! (mut (.entries h)) (- (len (.entries h)) 1)))

;;; Remove and return the entry with the smallest priority, or `None` when empty.
(defn heap-pop! [T] [(h (mut (MinHeap T)))] (-> (Option (Entry T)))
  (match (pop! (mut (.entries h)))
    (None [] (None))
    (Some [last]
          (if (empty? (.entries h))
              (Some last)
              (let [top (get (.entries h) 0)]
                (set! (mut (.entries h)) 0 last)
                (sift-down! (mut (.entries h)))
                (Some top))))))
