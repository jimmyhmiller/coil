;;; The Huffman tree, and the code lengths read off its leaves.
(module examples.huffman.tree)
(import "coil.alloc" :as alloc :use [Allocator malloc-allocator])
(import "coil.scratch"
        :use
        [ScratchArena scratch-init scratch-allocator scratch-close!])
(import "examples.huffman.heap"
        :use
        [heap-new heap-free! heap-push! heap-pop! MinHeap])

;;; The longest code allowed. Codes are carried in a `u32`, and the header stores
;;; lengths, so a decoder can reject anything longer up front.
(const MAX-CODE-LEN 32)

;;; A leaf is one byte value; a branch's left edge is a 0 bit and its right a 1.
(defsum Node
  (Leaf [(symbol u8)])
  (Branch [(left (ptr Node)) (right (ptr Node))]))

;;; Merge the two lightest subtrees until one remains: the root, or `None` when
;;; the queue started empty.
(defn merge-all! [(queue (mut (MinHeap (ptr Node)))) (a (dyn Allocator))]
  (-> (Option (ptr Node)))
  (if-let [(Some [lightest]) (heap-pop! (mut queue))]
    (if-let [(Some [next]) (heap-pop! (mut queue))]
      (do
        (heap-push! (mut queue)
                    (+ (.priority lightest) (.priority next))
                    (alloc/box! a Node (Branch (.value lightest) (.value next))))
        (merge-all! (mut queue) a))
      (Some (.value lightest)))
    (None)))

;;; The Huffman tree for `counts`, every node allocated in `a`. `None` when no
;;; byte occurs at all.
(defn build-tree [(counts (array u64 256)) (a (dyn Allocator))]
  (-> (Option (ptr Node)))
  (let [(mut queue) (heap-new [(ptr Node)] a)]
    (defer (heap-free! (mut queue)))
    (for symbol (range 0 256)
      (let [weight (get counts symbol)]
        (when (> weight 0)
          (heap-push! (mut queue)
                      weight
                      (alloc/box! a Node (Leaf (cast u8 symbol)))))))
    (merge-all! (mut queue) a)))

(defn assign-lengths! [(node (ptr Node))
                       (depth i64)
                       (lengths (mut (array u8 256)))] (-> void)
  (match (load node)
    ;; A tree that is a lone leaf has depth 0, but its byte still needs a 1-bit code.
    (Leaf [symbol]
          (set! (mut lengths)
                (cast i64 symbol)
                (cast u8 (if (= depth 0) 1 depth))))
    (Branch [left right]
            (assign-lengths! left (+ depth 1) (mut lengths))
            (assign-lengths! right (+ depth 1) (mut lengths)))))

;;; Each byte's depth in the Huffman tree for `counts` (0 for bytes that never
;;; occur). The tree only lives for this call, so it goes in a scratch arena that
;;; is released whole at the end.
(defn tree-lengths [(counts (array u64 256))] (-> (array u8 256))
  (let [(mut arena) (zeroed ScratchArena)
        (mut lengths) (zeroed (array u8 256))]
    (scratch-init (mut arena) (malloc-allocator))
    (defer (scratch-close! (mut arena)))
    (when-let [(Some [root]) (build-tree counts (scratch-allocator (mut arena)))]
      (assign-lengths! root 0 (mut lengths)))
    lengths))

(defn longest [(lengths (array u8 256))] (-> u8)
  (fold (fn [deepest length] (if (> length deepest) length deepest))
        (: 0 u8)
        lengths))

;;; Halve every count, keeping nonzero counts nonzero. Repeated, this levels the
;;; distribution until every count is 1, where the tree is balanced.
(defn flatten [(counts (array u64 256))] (-> (array u64 256))
  (let [(mut flatter) counts]
    (for symbol (range 0 256)
      (let [weight (get counts symbol)]
        (when (> weight 1)
          (set! (mut flatter) symbol (>> weight 1)))))
    flatter))

;;; Huffman code lengths for `counts`, none longer than `MAX-CODE-LEN`. Only
;;; pathologically skewed inputs (counts growing like the Fibonacci numbers, at
;;; least megabytes of them) are deep enough to need flattening.
(defn code-lengths [(counts (array u64 256))] (-> (array u8 256))
  (let [(mut weights) counts
        (mut lengths) (tree-lengths counts)]
    (while (> (longest lengths) MAX-CODE-LEN)
      (set! weights (flatten weights))
      (set! lengths (tree-lengths weights)))
    lengths))
