(module examples.huffman.bits-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList al-new al-free! al-slice])
(import "coil.prop" :use *)
(import "examples.huffman.bits" :use *)

(deftest writer-packs-high-bit-first-and-pads-with-zeros
  (let [(mut w) (bit-writer (al-new [u8] (malloc-allocator)))]
    (write-bits! (mut w) 0b101 3)
    (write-bits! (mut w) 0b11111 5)
    (write-bits! (mut w) 0b1 1)
    (let [(mut bytes) (finish (mut w))]
      (assert-eq (len bytes) 2)
      (assert-eq (get bytes 0) 0b10111111)
      (assert-eq (get bytes 1) 0b10000000)
      (al-free! (mut bytes)))))

(deftest writer-keeps-bytes-already-in-the-list
  (let [(mut prefix) (al-new [u8] (malloc-allocator))]
    (push! (mut prefix) 0xAB)
    (let [(mut w) (bit-writer prefix)]
      (write-bits! (mut w) 0xCD 8)
      (let [(mut bytes) (finish (mut w))]
        (assert-eq (al-slice bytes) [0xAB 0xCD])
        (al-free! (mut bytes))))))

(deftest reader-reads-back-mixed-widths
  (let [(mut w) (bit-writer (al-new [u8] (malloc-allocator)))]
    (write-bits! (mut w) 5 3)
    (write-bits! (mut w) 0xDEADBEEF 32)
    (write-bits! (mut w) 0 1)
    (write-bits! (mut w) 0x2A 7)
    (let [(mut bytes) (finish (mut w))
          (mut r) (bit-reader (al-slice bytes))]
      (assert-eq (read-bits! (mut r) 3) (Some 5))
      (assert-eq (read-bits! (mut r) 32) (Some 0xDEADBEEF))
      (assert-eq (read-bits! (mut r) 1) (Some 0))
      (assert-eq (read-bits! (mut r) 7) (Some 0x2A))
      (assert-eq (bit-position r) 43)
      (al-free! (mut bytes)))))

(deftest reader-stops-at-the-end
  (let [(mut r) (bit-reader [0xFF])]
    (assert-eq (read-bits! (mut r) 8) (Some 0xFF))
    (assert-eq (read-bit! (mut r)) (None))
    (assert-eq (read-bits! (mut r) 1) (None))))

;; A field's width (1 to 32 bits) and value both come from one generated number.
(defn field-width [(n u32)] (-> u8)
  (cast u8 (+ (% n 32) 1)))

(defn field-value [(n u32)] (-> u32)
  (cast u32 (& (cast u64 n) (- (<< 1 (cast u64 (field-width n))) 1))))

;; Any sequence of fields of 1 to 32 bits reads back exactly as written.
(defprop bit-fields-round-trip [(fields (ArrayList u32))]
  (let [(mut w) (bit-writer (al-new [u8] (src-alloc (prop-src))))]
    (for n fields
      (write-bits! (mut w) (field-value n) (field-width n)))
    (let [bytes (finish (mut w))
          (mut r) (bit-reader (al-slice bytes))]
      (block :check
        (for n fields
          (unless (= (read-bits! (mut r) (field-width n))
                     (Some (field-value n)))
            (return-from :check false)))
        true))))
