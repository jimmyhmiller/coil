(module examples.huffman.format-test)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.prop" :use *)
(import "examples.huffman.error" :use *)
(import "examples.huffman.format" :use *)

(defn round-trips? [(a (dyn Allocator)) (data (slice u8))] (-> bool)
  (let [(mut packed) (compress a data)]
    (defer (free! (mut packed)))
    (if-let [(Ok [(mut out)]) (decompress a (slice packed))]
      (do
        (defer (free! (mut out)))
        (= (slice out) data))
      false)))

(defn fails-with? [(data (slice u8)) (expected FormatError)] (-> bool)
  (match (decompress (malloc-allocator) data)
    (Ok [(mut out)] (free! (mut out)) false)
    (Err [e] (= e expected))))

(defn repeated [(byte u8) (count i64)] (-> (ArrayList u8))
  (let [(mut out) (ArrayList::new [u8] (malloc-allocator))]
    (for _ (range 0 count) (push! (mut out) byte))
    out))

(deftest empty-input-round-trips-to-a-bare-header
  (let [(mut packed) (compress (malloc-allocator) "")]
    (assert-eq (len packed) HEADER-LEN)
    (free! (mut packed)))
  (assert (round-trips? (malloc-allocator) "")))

(deftest a-single-repeated-byte-costs-one-bit-each
  (let [(mut data) (repeated #\x 1000)
        (mut packed) (compress (malloc-allocator) (slice data))]
    (assert-eq (len packed) (+ HEADER-LEN 125))
    (assert (round-trips? (malloc-allocator) (slice data)))
    (free! (mut packed))
    (free! (mut data))))

(deftest every-byte-value-round-trips
  ;; Byte i appears i + 1 times, so all 256 values get codes of varied lengths.
  (let [(mut data) (ArrayList::new [u8] (malloc-allocator))]
    (for byte (range 0 256)
      (for _ (range 0 (+ byte 1)) (push! (mut data) (cast u8 byte))))
    (assert (round-trips? (malloc-allocator) (slice data)))
    (free! (mut data))))

(deftest text-gets-smaller
  (let [text
          "she sells sea shells by the sea shore, and the shells she sells are sea shells for sure"
        (mut packed) (compress (malloc-allocator) text)]
    (assert (< (- (len packed) HEADER-LEN) (len text)))
    (assert (round-trips? (malloc-allocator) text))
    (free! (mut packed))))

;; Whatever the bytes, decompressing the compressed form gives them back.
(defprop any-bytes-round-trip [(data (slice u8))]
  (round-trips? (src-alloc (source)) data))

(deftest wrong-magic-is-rejected
  (let [(mut packed) (compress (malloc-allocator) "hello")]
    (set! (mut packed) 0 #\X)
    (assert (fails-with? (slice packed) (BadMagic)))
    (free! (mut packed)))
  (assert (fails-with? "GIF89a" (BadMagic))))

(deftest short-headers-are-truncated
  (assert (fails-with? "" (Truncated)))
  (assert (fails-with? "HU" (Truncated)))
  (assert (fails-with? "HUF1 and not much else" (Truncated))))

(deftest a-missing-payload-is-truncated
  (let [(mut packed) (compress (malloc-allocator) "hello, world")]
    (pop! (mut packed))
    (assert (fails-with? (slice packed) (Truncated)))
    (free! (mut packed))))

(deftest an-inflated-length-is-truncated
  (let [(mut packed) (compress (malloc-allocator) "hello, world")]
    ;; The top byte of the little-endian original size.
    (set! (mut packed) 11 0x7F)
    (assert (fails-with? (slice packed) (Truncated)))
    (free! (mut packed))))

(deftest forged-code-lengths-are-rejected
  (let [(mut packed) (compress (malloc-allocator) "abcd")]
    ;; 'a' through 'd' have 2-bit codes; a fifth 2-bit code does not exist.
    (set! (mut packed) (+ 12 #\e) 2)
    (assert (fails-with? (slice packed) (Oversubscribed 2)))
    (set! (mut packed) (+ 12 #\e) 40)
    (assert (fails-with? (slice packed) (CodeTooLong #\e 40)))
    (free! (mut packed))))

(deftest bits-that-match-no-code-are-corrupt
  ;; A lone byte's only code is `0`, so a run of 1 bits matches nothing.
  (let [(mut data) (repeated #\x 64)
        (mut packed) (compress (malloc-allocator) (slice data))]
    (for i (range HEADER-LEN (len packed)) (set! (mut packed) i 0xFF))
    (assert (fails-with? (slice packed) (CorruptCode 0)))
    (free! (mut packed))
    (free! (mut data))))

(deftest extra-bytes-after-the-data-are-rejected
  (let [(mut packed) (compress (malloc-allocator) "hello, world")]
    (push! (mut packed) 0)
    (push! (mut packed) 0)
    (assert (fails-with? (slice packed) (TrailingBytes 2)))
    (free! (mut packed))))
