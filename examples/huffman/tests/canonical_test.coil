(module examples.huffman.canonical-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [ok?])
(import "examples.huffman.canonical" :use *)
(import "examples.huffman.error" :use *)
(import "examples.huffman.freq" :use [count-bytes])
(import "examples.huffman.heap" :use *)
(import "examples.huffman.tree" :use [code-lengths MAX-CODE-LEN])

(defn lengths-of [(pairs (slice (array u8 2)))] (-> (array u8 256))
  (let [(mut lengths) (zeroed (array u8 256))]
    (for [symbol length]
      pairs
      (set! (mut lengths) (cast i64 symbol) length))
    lengths))

(defn code-of [(codes (array Codeword 256)) (symbol u8)] (-> Codeword)
  (get codes (cast i64 symbol)))

;; Whether `a` is the first `(.length a)` bits of `b`.
(defn prefix-of? [(a Codeword) (b Codeword)] (-> bool)
  (and (<= (.length a) (.length b))
       (= (.bits a) (>> (.bits b) (cast u32 (- (.length b) (.length a)))))))

(defn prefix-free? [(codes (array Codeword 256))] (-> bool)
  (block :check
         (for i
           (range 0 256)
           (for j
             (range 0 256)
             (let [a (get codes i)
                   b (get codes j)]
               (when (and (!= i j)
                          (> (.length a) 0)
                          (> (.length b) 0)
                          (prefix-of? a b))
                 (return-from :check false)))))
         true))

;; Kraft's sum, scaled by 2^MAX-CODE-LEN: a prefix code's never exceeds 2^MAX-CODE-LEN.
(defn kraft-sum [(lengths (array u8 256))] (-> u64)
  (fold (fn [total length]
          (if (= length 0)
              total
              (+ total (<< (: 1 u64) (cast u64 (- 32 (cast i64 length)))))))
        (: 0 u64)
        lengths))

(deftest canonical-codes-follow-length-then-byte-order
         (let [codes
                 (canonical-codes (lengths-of [[#\a 2] [#\b 1] [#\c 3] [#\d 3]]))]
           (assert-eq (code-of codes #\b) (Codeword :bits 0b0 :length 1))
           (assert-eq (code-of codes #\a) (Codeword :bits 0b10 :length 2))
           (assert-eq (code-of codes #\c) (Codeword :bits 0b110 :length 3))
           (assert-eq (code-of codes #\d) (Codeword :bits 0b111 :length 3))
           (assert-eq (code-of codes #\e) (Codeword :bits 0 :length 0))))

(deftest huffman-lengths-match-a-worked-example
         ;; Weights 1, 1, 2, 4, 8: each merge pairs the new subtree with the next weight.
         (let [lengths (code-lengths (count-bytes "abccddddeeeeeeee"))]
           (assert-eq (get lengths #\e) 1)
           (assert-eq (get lengths #\d) 2)
           (assert-eq (get lengths #\c) 3)
           (assert-eq (get lengths #\a) 4)
           (assert-eq (get lengths #\b) 4)
           (assert-eq (get lengths #\z) 0)))

(deftest a-lone-byte-gets-a-one-bit-code
         (let [lengths (code-lengths (count-bytes "zzzz"))]
           (assert-eq (get lengths #\z) 1)
           (assert-eq (code-of (canonical-codes lengths) #\z)
                      (Codeword :bits 0 :length 1))))

(deftest codes-for-text-are-prefix-free
         (let [lengths
                 (code-lengths (count-bytes "it was the best of times, it was the worst of times"))]
           (assert (prefix-free? (canonical-codes lengths)))
           (assert (<= (kraft-sum lengths) (<< (: 1 u64) 32)))))

(deftest skewed-counts-are-flattened-to-the-length-limit
         ;; Fibonacci weights give the deepest possible tree: 39 levels for 40 bytes.
         (let [(mut counts) (zeroed (array u64 256))
               (mut a) (: 1 u64)
               (mut b) (: 1 u64)]
           (for symbol
             (range 0 40)
             (set! (mut counts) symbol a)
             (let [next (+ a b)]
               (set! a b)
               (set! b next)))
           (let [lengths (code-lengths counts)]
             (assert (<= (fold (fn [m l] (if (> l m) l m)) (: 0 u8) lengths)
                         MAX-CODE-LEN))
             (assert (<= (kraft-sum lengths) (<< (: 1 u64) 32)))
             (assert (prefix-free? (canonical-codes lengths))))))

(deftest decode-table-accepts-what-the-encoder-makes
         (assert (ok? (decode-table (code-lengths (count-bytes "mississippi")))))
         (assert (ok? (decode-table (zeroed (array u8 256))))))

(deftest decode-table-rejects-overlong-codes
         (match (decode-table (lengths-of [[7 33]]))
           (Err [e] (assert-eq e (CodeTooLong 7 33)))
           (Ok [_] (assert false))))

(deftest decode-table-rejects-oversubscribed-lengths
         ;; Three 1-bit codes cannot exist.
         (match (decode-table (lengths-of [[1 1] [2 1] [3 1]]))
           (Err [e] (assert-eq e (Oversubscribed 1)))
           (Ok [_] (assert false))))

(deftest heap-pops-by-priority-then-insertion-order
         (let [(mut heap) (heap-new [u8] (malloc-allocator))]
           (for [priority value]
             [[5 #\a] [1 #\b] [5 #\c] [3 #\d] [1 #\e]]
             (heap-push! (mut heap) (cast u64 priority) (cast u8 value)))
           (for expected
             "bedac"
             (match (heap-pop! (mut heap))
               (Some [entry] (assert-eq (.value entry) expected))
               (None [] (assert false))))
           (assert-eq (heap-len heap) 0)
           (heap-free! (mut heap))))
