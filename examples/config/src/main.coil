;;; A typed application-config loader.
;;;
;;; Each JSON file named on the command line is decoded into a `ServerConfig`
;;; through coil.serde (derived for the structs), then checked by a pass that
;;; collects every problem rather than stopping at the first. A valid config is
;;; summarised and serialized back out as indented JSON; an unreadable,
;;; malformed or invalid one is explained on stderr and makes the exit status 1.
;;;
;;;   coil run examples/config
;;;
;;;   data/server.json: ok
;;;     name       edge-gateway
;;;     listen     0.0.0.0:8443 (https: certs/edge.pem)
;;;     log level  warn
;;;     workers    8
;;;     routes     4
;;;       /api/users   -> http://users.internal:9000     5000 ms  GET POST
;;;       /api/orders  -> http://orders.internal:9100   30000 ms  GET POST DELETE
;;;       /static      -> https://cdn.example.com        2000 ms  GET
;;;       /healthz     -> http://127.0.0.1:8081           250 ms  GET
;;;   serialized back out:
;;;   {
;;;     "name": "edge-gateway",
;;;     "listen": {
;;;       "host": "0.0.0.0",
;;;       "port": 8443
;;;     },
;;;     ...
;;;   }
;;;
;;;   coil run examples/config -- data/broken.json data/malformed.json data/missing.json
;;;
;;;   data/broken.json: 7 problems
;;;     listen.port 70000 is outside 1..65535
;;;     workers 0 is outside 1..256
;;;     routes[1]: path "admin" must start with '/'
;;;     routes[1]: upstream "ftp://admin.internal" is not an http:// or https:// URL
;;;     routes[1]: methods is empty
;;;     routes[2]: path "/api" is already routed by routes[0]
;;;     routes[2]: timeoutMs 900000 is outside 1..300000
;;;   data/malformed.json: 3:42: expected an integer
;;;   data/missing.json: cannot read: No such file or directory (os error 2)
(module examples.config.main)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.args" :use [args-set! args-count args-nth])
(import "coil.io" :use [stdout])
(import "coil.scratch"
        :use
        [ScratchArena scratch-init scratch-allocator scratch-close!])
(import "coil.serde.json" :use [to-json-indented])
(import "examples.config.schema" :use *)
(import "examples.config.load" :use [load-config])
(import "examples.config.validate" :use [validate])

(defn print-route [(r Route)] (-> void)
  (print "    {:<12} -> {:<28} {:>6} ms "
         (.path r)
         (.upstream r)
         (.timeout-ms r))
  (for m (.methods r) (print " {}" m))
  (println ""))

(defn print-summary [(path (slice u8)) (config ServerConfig)] (-> void)
  (println "{}: ok" path)
  (println "  name       {}" (.name config))
  (print "  listen     {}:{}" (.. config listen host) (.. config listen port))
  (match (.tls config)
    (Some [tls] (println " (https: {})" (.cert-file tls)))
    (None [] (println " (plain http)")))
  (println "  log level  {}" (.log-level config))
  (println "  workers    {}" (.workers config))
  (println "  routes     {}" (len (.routes config)))
  (for r (.routes config) (print-route r)))

(defn print-round-trip [(config ServerConfig)] (-> void)
  (println "serialized back out:")
  (match (to-json-indented config (stdout) 2)
    (Ok [_] (println ""))
    (Err [e] (eprintln "cannot serialize: {}" e))))

;;; Validate a decoded config and report on it. True when it is valid.
(defn report-config [(a (dyn Allocator))
                     (path (slice u8))
                     (config ServerConfig)] (-> bool)
  (let [problems (validate a config)]
    (if (empty? problems)
        (do
          (print-summary path config)
          (print-round-trip config)
          true)
        (do
          (eprintln "{}: {} {}"
                    path
                    (len problems)
                    (if (= (len problems) 1) "problem" "problems"))
          (for p problems (eprintln "  {}" p))
          false))))

;;; Load, validate and report one config file. True when it is valid.
(defn report-file [(path (slice u8))] (-> bool)
  ;; One arena per file: the source text, every decoded string and list, and
  ;; the problem list all live exactly as long as this report.
  (let [(mut arena) (zeroed ScratchArena)]
    (scratch-init (mut arena) (malloc-allocator))
    (defer (scratch-close! (mut arena)))
    (let [a (scratch-allocator (mut arena))]
      (match (load-config a path)
        (Ok [config] (report-config a path config))
        (Err [e] (eprintln "{}: {}" path e) false)))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args-set! argc argv)
  (if (< (args-count) 2)
      (do (eprintln "usage: config FILE.json...") 2)
      (let [(mut failures) 0]
        (for i (range 1 (args-count))
          (unless (report-file (args-nth i))
            (set! failures (+ failures 1))))
        (if (= failures 0) 0 1))))
