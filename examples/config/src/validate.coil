;;; Semantic checks that a well-typed config can still fail. Every rule runs and
;;; every problem is collected, so one pass reports them all.
(module examples.config.validate)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList al-new])
(import "coil.hashmap" :use [HashMap])
(import "coil.iter" :use [Indexed])
(import "coil.str" :use [starts-with str-keyops-borrowed])
(import "examples.config.schema" :use *)

(const MAX-PORT 65535)

(const MAX-WORKERS 256)

(const MAX-TIMEOUT-MS 300000)

;;; One violated rule. Route problems carry the route's index in `routes`.
(defsum ConfigError
  (PortOutOfRange [(port i64)])
  (WorkersOutOfRange [(workers i64)])
  (NoRoutes)
  (RelativePath [(route i64) (path (slice u8))])
  (DuplicatePath [(route i64) (first i64) (path (slice u8))])
  (BadUpstream [(route i64) (upstream (slice u8))])
  (NoMethods [(route i64)])
  (TimeoutOutOfRange [(route i64) (timeout-ms i64)]))

(derive Eq ConfigError)

(impl Display ConfigError
  (display-fmt [(e ConfigError) (f (ptr Formatter))]
    (-> i64)
    (let [w (formatter-writer f)]
      (match e
        (PortOutOfRange [port]
                        (fmt w
                             "listen.port {} is outside 1..{}"
                             port
                             MAX-PORT))
        (WorkersOutOfRange [n]
                           (fmt w
                                "workers {} is outside 1..{}"
                                n
                                MAX-WORKERS))
        (NoRoutes []
                  (fmt w
                       "routes is empty; the server would answer nothing"))
        (RelativePath [i path]
                      (fmt w
                           "routes[{}]: path \"{}\" must start with '/'"
                           i
                           path))
        (DuplicatePath [i first path]
                       (fmt w
                            "routes[{}]: path \"{}\" is already routed by routes[{}]"
                            i
                            path
                            first))
        (BadUpstream [i upstream]
                     (fmt w
                          "routes[{}]: upstream \"{}\" is not an http:// or https:// URL"
                          i
                          upstream))
        (NoMethods [i] (fmt w "routes[{}]: methods is empty" i))
        (TimeoutOutOfRange [i ms]
                           (fmt w
                                "routes[{}]: timeoutMs {} is outside 1..{}"
                                i
                                ms
                                MAX-TIMEOUT-MS))))
    0))

(defn within? [(n i64) (lo i64) (hi i64)] (-> bool)
  (and (>= n lo) (<= n hi)))

(defn http-url? [(s (slice u8))] (-> bool)
  (or (starts-with s "http://") (starts-with s "https://")))

(defn check-route [(problems (mut (ArrayList ConfigError)))
                   (first-use (mut (HashMap (slice u8) i64)))
                   (i i64)
                   (r Route)] (-> void)
  (unless (starts-with (.path r) "/")
    (push! (mut problems) (RelativePath i (.path r))))
  (match (get first-use (.path r))
    (Some [first]
          (push! (mut problems)
                 (DuplicatePath
                   :route i
                   :first first
                   :path (.path r))))
    (None [] (set! (mut first-use) (.path r) i)))
  (unless (http-url? (.upstream r))
    (push! (mut problems) (BadUpstream i (.upstream r))))
  (when (empty? (.methods r))
    (push! (mut problems) (NoMethods i)))
  (unless (within? (.timeout-ms r) 1 MAX-TIMEOUT-MS)
    (push! (mut problems) (TimeoutOutOfRange i (.timeout-ms r)))))

;;; Every rule `config` breaks, in file order. The list is allocated from `a`
;;; and owned by the caller.
(defn validate [(a (dyn Allocator)) (config ServerConfig)]
  (-> (ArrayList ConfigError))
  (let [(mut problems) (al-new [ConfigError] a)
        routes (.routes config)]
    (unless (within? (.. config listen port) 1 MAX-PORT)
      (push! (mut problems) (PortOutOfRange (.. config listen port))))
    (unless (within? (.workers config) 1 MAX-WORKERS)
      (push! (mut problems) (WorkersOutOfRange (.workers config))))
    (when (empty? routes)
      (push! (mut problems) (NoRoutes)))
    ;; Keys borrow the config's own path strings, which outlive this map.
    (let [(mut first-use)
            (HashMap::new [(slice u8) i64] a (str-keyops-borrowed))]
      (defer (free! (mut first-use)))
      (for (Indexed :index i :value r) (enumerate routes)
        (check-route (mut problems) (mut first-use) i r)))
    problems))
