;;; Reading a config file and decoding it, with failures reported as a
;;; `LoadError` that knows where in the file the problem is.
(module examples.config.load)
(import "coil.alloc" :use [Allocator])
(import "coil.fs" :use [read-file])
(import "coil.io"
        :use
        [Writer IoError Eof Errno LineTooLong OutOfMemory InvalidLimit])
(import "coil.slice" :use [subslice])
(import "coil.str" :use [cstr->str])
(import "coil.serde" :use *)
(import "coil.serde.json" :use [from-json])
(import "examples.config.schema" :use [ServerConfig])

(extern strerror :cc c [i32] (-> (ptr i8)))

;;; A 1-based line and column in the source text.
(defstruct Position [(line i64) (column i64)])

(impl Display Position
  (display-fmt [(p Position) (f (ptr Formatter))]
               (-> i64)
               (fmt (formatter-writer f) "{}:{}" (.line p) (.column p))
               0))

(defsum LoadError
  (Unreadable [(error IoError)])
  (Malformed [(error DeError) (at (Option Position))]))

(defn newline? [(b u8)] (-> bool)
  (= (cast i64 b) #\newline))

;;; The offset of the first byte of the line holding byte `offset`.
(defn line-start [(src (slice u8)) (offset i64)] (-> i64)
  (let [(mut i) offset]
    (while (and (> i 0) (not (newline? (get src (- i 1)))))
      (set! i (- i 1)))
    i))

;;; The line and column of byte `offset` in `src`.
(defn position-of [(src (slice u8)) (offset i64)] (-> Position)
  (let [newlines (count (filter (fn [b] (newline? b)) (subslice src 0 offset)))]
    (Position :line (+ newlines 1)
      :column (+ (- offset (line-start src offset)) 1))))

;;; Decode `src` as a `ServerConfig`. Decoded strings and lists borrow `src` and
;;; `a`, so both must outlive the result.
(defn parse-config [(a (dyn Allocator)) (src (slice u8))] (-> (Result ServerConfig
                                                                      LoadError))
  (match (from-json [ServerConfig] a src)
    (Ok [config] (Ok config))
    (Err [e]
         (Err (Malformed :error e
                :at
                  (if (< (.offset e) 0)
                      (None)
                      (Some (position-of src (.offset e)))))))))

;;; Read and decode the config file at `path`; everything is allocated from `a`.
(defn load-config [(a (dyn Allocator)) (path (slice u8))] (-> (Result ServerConfig
                                                                      LoadError))
  (match (read-file a path)
    (Ok [src] (parse-config a src))
    (Err [e] (Err (Unreadable e)))))

(defn describe-io [(e IoError)] (-> (slice u8))
  (match e
    (Errno [code] (cstr->str (strerror (cast i32 code))))
    (Eof [] "unexpected end of file")
    (LineTooLong [] "line too long")
    (OutOfMemory [] "out of memory")
    (InvalidLimit [] "invalid read limit")))

(defn describe-decode [(e DeError) (w (ptr Writer))] (-> i64)
  (let [code (.code e)
        ctx (.ctx e)]
    (cond (= code DE-E-MISSING-FIELD)
            (fmt w "missing required field \"{}\"" ctx)
          (= code DE-E-UNKNOWN-FIELD) (fmt w "unknown field")
          (= code DE-E-EXPECTED-OBJECT) (fmt w "expected a {} object" ctx)
          (= code DE-E-INT-RANGE) (fmt w "integer out of range")
          (= code DE-E-PARSE) (fmt w "invalid JSON")
          (= code DE-E-TRAILING) (fmt w "unexpected text after the document")
          :else (fmt w "{}" ctx))
    0))

(impl Display LoadError
  (display-fmt [(e LoadError) (f (ptr Formatter))]
               (-> i64)
               (let [w (formatter-writer f)]
                 (match e
                   (Unreadable [io] (fmt w "cannot read: {}" (describe-io io)))
                   (Malformed [de at]
                              (do
                                (match at
                                  (Some [pos] (fmt w "{}: " pos))
                                  (None [] 0))
                                (describe-decode de w)))))
               0))
