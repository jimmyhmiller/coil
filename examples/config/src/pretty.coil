;;; An indented JSON writer for coil.serde. It is a second Serializer, not a
;;; reformatter: containers, keys and indentation are laid out here, and every
;;; scalar goes through coil.serde.json's own JsonSer, so escaping and number
;;; formatting are exactly those of the compact backend.
(module examples.config.pretty)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [al-into-slice al-free!])
(import "coil.io" :use [Writer IoError print-str])
(import "coil.serde" :use *)
(import "coil.serde.json" :use [JsonSer])

(const MAX-DEPTH 64)

(const INDENT "  ")

;;; Serializer state. `fresh` is true while the innermost open container has
;;; no items yet: it decides both the comma before an item and whether a closing
;;; bracket goes on its own line (an empty container prints as `[]` or `{}`).
(defstruct PrettyJson
  [(scalars JsonSer)
   (out (ptr Writer))
   (depth i64)
   (fresh bool)])

(defn io-result [(r (Result i64 IoError))] (-> (Result i64 SerError))
  (try (Ok (try-or! r (Err (ser-err (WriteFailed)))))))

(defn emit [(p (ptr PrettyJson)) (text (slice u8))] (-> (Result i64 SerError))
  (io-result (print-str (.out p) text)))

(defn newline-indent [(p (ptr PrettyJson))] (-> (Result i64 SerError))
  (try (do
         (try! (emit p "\n"))
         (for _ (range 0 (.depth p)) (try! (emit p INDENT)))
         (Ok 0))))

(defn open [(p (ptr PrettyJson)) (bracket (slice u8))] (-> (Result i64 SerError))
  (if (>= (.depth p) MAX-DEPTH)
      (Err (ser-err (TooDeep)))
      (try (do
             (try! (emit p bracket))
             (set! (.depth p) (+ (.depth p) 1))
             (set! (.fresh p) true)
             (Ok 0)))))

;; A closed container was itself an item of its parent, so the parent is no
;; longer fresh afterwards.
(defn close [(p (ptr PrettyJson)) (bracket (slice u8))] (-> (Result i64
                                                                    SerError))
  (try (do
         (set! (.depth p) (- (.depth p) 1))
         (unless (.fresh p) (try! (newline-indent p)))
         (set! (.fresh p) false)
         (emit p bracket))))

(defn item [(p (ptr PrettyJson))] (-> (Result i64 SerError))
  (try (do
         (unless (.fresh p) (try! (emit p ",")))
         (set! (.fresh p) false)
         (newline-indent p))))

(defn key [(p (ptr PrettyJson)) (name (slice u8))] (-> (Result i64 SerError))
  (try (do
         (try! (item p))
         (try! (ser-str (field p scalars) name))
         (emit p ": "))))

(impl Serializer PrettyJson
  (ser-null [(p (ptr PrettyJson))]
            (-> (Result i64 SerError))
            (ser-null (field p scalars)))
  (ser-bool [(p (ptr PrettyJson)) (v bool)]
            (-> (Result i64 SerError))
            (ser-bool (field p scalars) v))
  (ser-i64 [(p (ptr PrettyJson)) (v i64)]
           (-> (Result i64 SerError))
           (ser-i64 (field p scalars) v))
  (ser-u64 [(p (ptr PrettyJson)) (v i64)]
           (-> (Result i64 SerError))
           (ser-u64 (field p scalars) v))
  (ser-f64 [(p (ptr PrettyJson)) (v f64)]
           (-> (Result i64 SerError))
           (ser-f64 (field p scalars) v))
  (ser-str [(p (ptr PrettyJson)) (v (slice u8))]
           (-> (Result i64 SerError))
           (ser-str (field p scalars) v))
  (ser-bytes [(p (ptr PrettyJson)) (v (slice u8))]
             (-> (Result i64 SerError))
             (ser-bytes (field p scalars) v))
  (seq-begin [(p (ptr PrettyJson)) (n i64)]
             (-> (Result i64 SerError))
             (open p "["))
  (seq-elem [(p (ptr PrettyJson))] (-> (Result i64 SerError)) (item p))
  (seq-end [(p (ptr PrettyJson))] (-> (Result i64 SerError)) (close p "]"))
  (map-begin [(p (ptr PrettyJson)) (n i64)]
             (-> (Result i64 SerError))
             (open p "{"))
  (map-key [(p (ptr PrettyJson)) (k (slice u8))]
           (-> (Result i64 SerError))
           (key p k))
  (map-end [(p (ptr PrettyJson))] (-> (Result i64 SerError)) (close p "}"))
  (struct-begin [(p (ptr PrettyJson)) (name (slice u8)) (nfields i64)]
                (-> (Result i64 SerError))
                (open p "{"))
  (field-key [(p (ptr PrettyJson)) (name (slice u8))]
             (-> (Result i64 SerError))
             (key p name))
  (struct-end [(p (ptr PrettyJson))] (-> (Result i64 SerError)) (close p "}"))
  (variant-unit [(p (ptr PrettyJson)) (sum (slice u8)) (tag (slice u8))]
                (-> (Result i64 SerError))
                (ser-str (field p scalars) tag))
  (variant-begin [(p (ptr PrettyJson))
                  (sum (slice u8))
                  (tag (slice u8))
                  (nfields i64)]
                 (-> (Result i64 SerError))
                 (try (do
                        (try! (open p "{"))
                        (try! (key p tag))
                        (open p "{"))))
  (variant-end [(p (ptr PrettyJson))]
               (-> (Result i64 SerError))
               (try (do
                      (try! (close p "}"))
                      (close p "}")))))

(defn pretty-json [(out (ptr Writer))] (-> PrettyJson)
  (let [(mut scalars) (zeroed JsonSer)]
    (set! (.w scalars) out)
    (PrettyJson
      :scalars scalars
      :out out
      :depth 0
      :fresh true)))

;;; Write `x` to `out` as indented JSON, with no trailing newline.
(defn to-pretty-json [(T Serialize)] [(x T) (out (ptr Writer))] (-> (Result i64
                                                                            SerError))
  (let [(mut p) (pretty-json out)]
    (ser x (mut p))))

;;; Render `x` as indented JSON, in bytes allocated from `a` that the caller owns.
(defn to-pretty-json-str [(T Serialize)] [(a (dyn Allocator)) (x T)] (-> (Result (slice u8)
                                                                                 SerError))
  (let [(mut buf) (zeroed GrowBuf)
        (mut w) (zeroed Writer)]
    (grow-writer (mut w) (mut buf) a)
    (match (to-pretty-json x (mut w))
      (Ok [_] (Ok (al-into-slice (mut (.buf buf)))))
      (Err [e] (do (al-free! (mut (.buf buf))) (Err e))))))
