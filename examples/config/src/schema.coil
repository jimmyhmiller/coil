;;; The typed shape of a server config file. Everything derives its
;;; serialization: the structs with camelCase keys and defaults for optional
;;; settings, the enums with the spellings config files conventionally use
;;; ("warn", "GET") instead of their variant names.
(module examples.config.schema)
(import "coil.arraylist" :use [ArrayList])
(import "coil.io" :use [print-str])
(import "coil.serde" :use *)
(import "coil.serde.derive" :use *)

(defsum-serde LogLevel
              (Debug)
              (Info)
              (Warn)
              (Error)
              (variant Debug (rename "debug"))
              (variant Info (rename "info"))
              (variant Warn (rename "warn"))
              (variant Error (rename "error")))

(derive Eq LogLevel)

(defsum-serde Method
              (Get)
              (Post)
              (Put)
              (Delete)
              (variant Get (rename "GET"))
              (variant Post (rename "POST"))
              (variant Put (rename "PUT"))
              (variant Delete (rename "DELETE")))

(derive Eq Method)

;;; The address the server binds.
(defstruct Listen [(host (slice u8)) (port i64)])

(derive Serialize Deserialize Listen)

;;; Certificate and key paths; their presence turns on HTTPS.
(defstruct Tls [(cert-file (slice u8)) (key-file (slice u8))])

(derive (Serialize (rename-all :camelCase))
        (Deserialize (rename-all :camelCase))
        Tls)

;;; Requests whose path starts with `path` are proxied to `upstream`.
(defstruct Route
  [(path (slice u8))
   (upstream (slice u8))
   (methods (ArrayList Method))
   (timeout-ms i64)])

(derive (Serialize (rename-all :camelCase))
        (Deserialize (rename-all :camelCase) (field timeout-ms (default 30000)))
        Route)

;;; A whole config file. `logLevel` and `workers` may be omitted; a missing
;;; `tls` decodes as `None` and serves plain HTTP.
(defstruct ServerConfig
  [(name (slice u8))
   (listen Listen)
   (log-level LogLevel)
   (workers i64)
   (tls (Option Tls))
   (routes (ArrayList Route))])

(derive (Serialize (rename-all :camelCase))
        (Deserialize (rename-all :camelCase)
                     (field log-level (default (Info)))
                     (field workers (default 4)))
        ServerConfig)

(impl Display LogLevel
  (display-fmt [(level LogLevel) (f (ptr Formatter))] (-> i64)
    (print-str (formatter-writer f)
               (match level
                 (Debug [] "debug")
                 (Info [] "info")
                 (Warn [] "warn")
                 (Error [] "error")))
    0))

(impl Display Method
  (display-fmt [(m Method) (f (ptr Formatter))] (-> i64)
    (print-str (formatter-writer f)
               (match m
                 (Get [] "GET")
                 (Post [] "POST")
                 (Put [] "PUT")
                 (Delete [] "DELETE")))
    0))
