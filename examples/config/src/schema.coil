;;; The typed shape of a server config file. The structs derive their
;;; serialization, with options that give the JSON camelCase keys and fill in
;;; defaults for optional settings; the two enums spell themselves by hand.
(module examples.config.schema)
(import "coil.arraylist" :use [ArrayList])
(import "coil.io" :use [print-str])
(import "coil.serde" :use *)
(import "coil.serde.derive" :use *)

(defsum LogLevel (Debug) (Info) (Warn) (Error))

(derive Eq LogLevel)

(defsum Method (Get) (Post) (Put) (Delete))

(derive Eq Method)

;;; The address the server binds.
(defstruct Listen [(host (slice u8)) (port i64)])

(derive Serialize Deserialize Listen)

;;; Certificate and key paths; their presence turns on HTTPS.
(defstruct Tls [(cert-file (slice u8)) (key-file (slice u8))])

(derive (Serialize (rename-all :camelCase))
        (Deserialize (rename-all :camelCase))
        Tls)

;;; Requests whose path starts with `path` are proxied to `upstream`.
(defstruct Route
  [(path (slice u8))
   (upstream (slice u8))
   (methods (ArrayList Method))
   (timeout-ms i64)])

(derive (Serialize (rename-all :camelCase))
        (Deserialize (rename-all :camelCase) (field timeout-ms (default 30000)))
        Route)

;;; A whole config file. `logLevel` and `workers` may be omitted; a missing
;;; `tls` decodes as `None` and serves plain HTTP.
(defstruct ServerConfig
  [(name (slice u8))
   (listen Listen)
   (log-level LogLevel)
   (workers i64)
   (tls (Option Tls))
   (routes (ArrayList Route))])

(derive (Serialize (rename-all :camelCase))
        (Deserialize (rename-all :camelCase)
                     (field log-level (default (Info)))
                     (field workers (default 4)))
        ServerConfig)

;; The two enums are spelled the way config files conventionally spell them
;; ("warn", "GET"), not by variant name, so their impls are written by hand.
(defn log-level-name [(level LogLevel)] (-> (slice u8))
  (match level
    (Debug [] "debug")
    (Info [] "info")
    (Warn [] "warn")
    (Error [] "error")))

(defn log-level-named [(name (slice u8))] (-> (Option LogLevel))
  (cond (= name "debug") (Some (Debug))
        (= name "info") (Some (Info))
        (= name "warn") (Some (Warn))
        (= name "error") (Some (Error))
        :else (None)))

(defn method-name [(m Method)] (-> (slice u8))
  (match m
    (Get [] "GET")
    (Post [] "POST")
    (Put [] "PUT")
    (Delete [] "DELETE")))

(defn method-named [(name (slice u8))] (-> (Option Method))
  (cond (= name "GET") (Some (Get))
        (= name "POST") (Some (Post))
        (= name "PUT") (Some (Put))
        (= name "DELETE") (Some (Delete))
        :else (None)))

;;; Decode a string through `named`, failing with `expected` when it is not a
;;; known name.
(defn de-named [T] [(out (ptr T))
                    (d (dyn Deserializer))
                    (named (fnptr c [(slice u8)] (Option T)))
                    (expected (slice u8))] (-> (Result i64 DeError))
  (try (match (named (try! (de-str d)))
         (Some [v] (do (store! out v) (Ok 0)))
         (None [] (Err (de-err (UnknownVariant) -1 expected))))))

(impl Serialize LogLevel
  (ser [(level LogLevel) (s (dyn Serializer))]
       (-> (Result i64 SerError))
       (ser-str s (log-level-name level))))

(impl Deserialize LogLevel
  (de [(out (ptr LogLevel)) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (de-named out
                d
                (fnptr-of log-level-named)
                "logLevel must be debug, info, warn or error")))

(impl Serialize Method
  (ser [(m Method) (s (dyn Serializer))]
       (-> (Result i64 SerError))
       (ser-str s (method-name m))))

(impl Deserialize Method
  (de [(out (ptr Method)) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (de-named out
                d
                (fnptr-of method-named)
                "methods must be GET, POST, PUT or DELETE")))

(impl Display LogLevel
  (display-fmt [(level LogLevel) (f (ptr Formatter))]
               (-> i64)
               (print-str (formatter-writer f) (log-level-name level))
               0))

(impl Display Method
  (display-fmt [(m Method) (f (ptr Formatter))]
               (-> i64)
               (print-str (formatter-writer f) (method-name m))
               0))
