;;; Helpers shared by the config tests.
(module examples.config.support)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.str" :use [sb-new sb-format! sb-str])
(import "coil.scratch"
        :use
        [ScratchArena scratch-init scratch-allocator scratch-close!])
(import "coil.result" :use [none?])

;;; `(with-arena a body…)` runs `body` with `a` bound to a fresh scratch
;;; allocator, and releases everything allocated from it afterwards.
(defn with-arena [(name Code) & (body Code)] (-> Code)
  `(let [(mut arena) (zeroed ScratchArena)]
     (scratch-init (mut arena) (malloc-allocator))
     (let [~name (scratch-allocator (mut arena))] ~@body)
     (scratch-close! (mut arena))))

;;; The `Ok` value of `r`, dropping the error.
(defn ok [T E] [(r (Result T E))] (-> (Option T))
  (try (Some (try-or! r (None)))))

;;; `x` rendered through its `Display` impl, in memory allocated from `a`.
(defn render [(T Display)] [(a (dyn Allocator)) (x T)] (-> (slice u8))
  (let [(mut out) (sb-new a)]
    (sb-format! (mut out) "{}" x)
    (sb-str out)))

;;; Whether `x` and `y` are both `None` or hold equal values. The prelude's
;;; `Option` has no `Eq` impl.
(defn same? [(T Eq)] [(x (Option T)) (y (Option T))] (-> bool)
  (match x
    (Some [v]
          (match y
            (Some [w] (= v w))
            (None [] false)))
    (None [] (none? y))))
