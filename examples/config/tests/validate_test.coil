(module examples.config.validate-test)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList al-new])
(import "coil.collect" :use [collect])
(import "examples.config.schema" :use *)
(import "examples.config.validate" :use *)
(import "examples.config.support" :use [with-arena])

(defn route [(a (dyn Allocator)) (path (slice u8)) (upstream (slice u8))]
  (-> Route)
  (Route
    :path path
    :upstream upstream
    :methods (collect [(ArrayList Method)] a [(Get)])
    :timeout-ms 1000))

(defn config [(a (dyn Allocator)) (routes (slice Route))] (-> ServerConfig)
  (ServerConfig
    :name "test"
    :listen (Listen :host "127.0.0.1" :port 8080)
    :log-level (Info)
    :workers 2
    :tls (None)
    :routes (collect [(ArrayList Route)] a routes)))

(defn valid [(a (dyn Allocator))] (-> ServerConfig)
  (config a [(route a "/a" "http://a") (route a "/b" "https://b")]))

;;; The single problem `c` has, if it has exactly one.
(defn sole-problem [(a (dyn Allocator)) (c ServerConfig)]
  (-> (Option ConfigError))
  (let [problems (validate a c)]
    (if (= (len problems) 1) (Some (get problems 0)) (None))))

(deftest a-valid-config-has-no-problems
  (with-arena a
              (assert (empty? (validate a (valid a))))))

(deftest port-must-be-in-range
  (with-arena a
              (let [(mut c) (valid a)]
                (set! (.. c listen port) 0)
                (assert-eq (sole-problem a c) (Some (PortOutOfRange 0)))
                (set! (.. c listen port) 65536)
                (assert-eq (sole-problem a c) (Some (PortOutOfRange 65536)))
                (set! (.. c listen port) 65535)
                (assert (empty? (validate a c))))))

(deftest workers-must-be-in-range
  (with-arena a
              (let [(mut c) (valid a)]
                (set! (.workers c) 257)
                (assert-eq (sole-problem a c) (Some (WorkersOutOfRange 257))))))

(deftest routes-must-not-be-empty
  (with-arena a
              (let [(mut c) (valid a)]
                (set! (.routes c) (al-new [Route] a))
                (assert-eq (sole-problem a c) (Some (NoRoutes))))))

(deftest paths-must-be-absolute
  (with-arena a
              (let [c
                      (config a
                              [(route a "/a" "http://a")
                               (route a "b" "http://b")])]
                (assert-eq (sole-problem a c) (Some (RelativePath 1 "b"))))))

(deftest paths-must-be-unique
  (with-arena a
              (let [c
                      (config a
                              [(route a "/a" "http://a")
                               (route a "/b" "http://b")
                               (route a "/a" "http://c")])]
                (assert-eq (sole-problem a c) (Some (DuplicatePath 2 0 "/a"))))))

(deftest upstreams-must-be-http-urls
  (with-arena a
              (let [c (config a [(route a "/a" "ftp://a")])]
                (assert-eq (sole-problem a c) (Some (BadUpstream 0 "ftp://a"))))))

(deftest routes-need-a-method
  (with-arena a
              (let [(mut r) (route a "/a" "http://a")]
                (set! (.methods r) (al-new [Method] a))
                (assert-eq (sole-problem a (config a [r])) (Some (NoMethods 0))))))

(deftest timeouts-must-be-in-range
  (with-arena a
              (let [(mut r) (route a "/a" "http://a")]
                (set! (.timeout-ms r) 0)
                (assert-eq (sole-problem a (config a [r]))
                           (Some (TimeoutOutOfRange 0 0))))))

(deftest every-problem-is-reported
  (with-arena a
              (let [(mut c)
                      (config a
                              [(route a "x" "ftp://x") (route a "x" "http://y")])]
                (set! (.. c listen port) -1)
                (set! (.workers c) 0)
                (assert-eq (len (validate a c)) 6))))
