(module examples.config.roundtrip-test)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList al-new])
(import "coil.prop" :use *)
(import "coil.serde.json" :use [from-json to-json-str])
(import "examples.config.schema" :use *)
(import "examples.config.load" :use [parse-config])
(import "examples.config.pretty" :use [to-pretty-json-str])
(import "examples.config.support" :use [with-arena ok same?])
(import "coil.result" :use [none?])

(def SAMPLE
  "{\"name\": \"edge\",
    \"listen\": {\"host\": \"0.0.0.0\", \"port\": 8443},
    \"logLevel\": \"debug\",
    \"workers\": 2,
    \"tls\": {\"certFile\": \"c.pem\", \"keyFile\": \"k.pem\"},
    \"routes\": [{\"path\": \"/a\", \"upstream\": \"http://a\", \"methods\": [\"GET\", \"PUT\"]},
                 {\"path\": \"/b\\\"q\", \"upstream\": \"https://b\", \"methods\": [], \"timeoutMs\": 7}]}")

;;; Decode `src`, then encode it again as compact JSON.
(defn reencoded [(a (dyn Allocator)) (src (slice u8))] (-> (Option (slice u8)))
  (try (let [config (try? (ok (parse-config a src)))]
         (ok (to-json-str a config)))))

(defn pretty [(a (dyn Allocator)) (src (slice u8))] (-> (Option (slice u8)))
  (try (let [config (try? (ok (parse-config a src)))]
         (ok (to-pretty-json-str a config)))))

;;; `listen` written as pretty JSON, read back, and written as compact JSON.
(defn via-pretty [(a (dyn Allocator)) (listen Listen)] (-> (Option (slice u8)))
  (try (let [text (try? (ok (to-pretty-json-str a listen)))
             back (try? (ok (from-json [Listen] a text)))]
         (ok (to-json-str a back)))))

(deftest compact-output-decodes-to-the-same-config
         (with-arena a
                     (match (reencoded a SAMPLE)
                       (Some [once]
                             (assert (same? (reencoded a once) (Some once))))
                       (None [] (assert false)))))

(deftest pretty-output-decodes-to-the-same-config
         (with-arena a
                     (match (pretty a SAMPLE)
                       (Some [text]
                             (assert (same? (reencoded a text)
                                            (reencoded a SAMPLE))))
                       (None [] (assert false)))))

(deftest omitted-settings-take-defaults
         (with-arena a
                     (match (parse-config a
                                          "{\"name\": \"n\", \"listen\": {\"host\": \"h\", \"port\": 1},
                             \"routes\": [{\"path\": \"/\", \"upstream\": \"http://u\", \"methods\": []}]}")
                       (Ok [config]
                           (assert-eq (.log-level config) (Info))
                           (assert-eq (.workers config) 4)
                           (assert (none? (.tls config)))
                           (assert-eq (.timeout-ms (get (.routes config) 0))
                                      30000))
                       (Err [_] (assert false)))))

(deftest pretty-layout
         (with-arena a
                     (assert (same? (ok (to-pretty-json-str a
                                                            (Listen :host "h"
                                                              :port 1)))
                                    (Some "{\n  \"host\": \"h\",\n  \"port\": 1\n}")))
                     (assert (same? (ok (to-pretty-json-str a
                                                            (al-new [Method] a)))
                                    (Some "[]")))
                     (assert (same? (ok (to-pretty-json-str a
                                                            (Route
                                                              :path "/"
                                                              :upstream "u"
                                                              :methods
                                                                (al-new [Method]
                                                                        a)
                                                              :timeout-ms 5)))
                                    (Some "{\n  \"path\": \"/\",\n  \"upstream\": \"u\",\n  \"methods\": [],\n  \"timeoutMs\": 5\n}")))))

(deftest enum-names-round-trip
         (let [levels [(Debug) (Info) (Warn) (Error)]
               methods [(Get) (Post) (Put) (Delete)]]
           (for level
             levels
             (assert (same? (log-level-named (log-level-name level))
                            (Some level))))
           (for m
             methods
             (assert (same? (method-named (method-name m)) (Some m)))))
         (assert (none? (log-level-named "Info")))
         (assert (none? (method-named "get"))))

(defprop pretty-and-compact-agree
         [(host (slice u8)) (port i64)]
         (let [listen (Listen :host host :port port)
               (mut agree) false]
           (with-arena a
                       (set! agree
                             (same? (via-pretty a listen)
                                    (ok (to-json-str a listen)))))
           agree))
