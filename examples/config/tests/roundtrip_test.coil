(module examples.config.roundtrip-test)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.prop" :use *)
(import "coil.serde" :use [Serialize])
(import "coil.serde.json" :use [from-json to-json-str to-json-str-indented])
(import "coil.result" :use [none? unwrap-or])
(import "examples.config.schema" :use *)
(import "examples.config.load" :use [parse-config])
(import "examples.config.support" :use [with-arena ok])

(def SAMPLE
  "{\"name\": \"edge\",
    \"listen\": {\"host\": \"0.0.0.0\", \"port\": 8443},
    \"logLevel\": \"debug\",
    \"workers\": 2,
    \"tls\": {\"certFile\": \"c.pem\", \"keyFile\": \"k.pem\"},
    \"routes\": [{\"path\": \"/a\", \"upstream\": \"http://a\", \"methods\": [\"GET\", \"PUT\"]},
                 {\"path\": \"/b\\\"q\", \"upstream\": \"https://b\", \"methods\": [], \"timeoutMs\": 7}]}")

;;; Decode `src`, then encode it again as compact JSON.
(defn reencoded [(a (dyn Allocator)) (src (slice u8))] (-> (Option (slice u8)))
  (try (ok (to-json-str a (try? (ok (parse-config a src)))))))

(defn pretty [(T Serialize)] [(a (dyn Allocator)) (x T)]
  (-> (Option (slice u8)))
  (ok (to-json-str-indented a x 2)))

;;; `listen` written as pretty JSON, read back, and written as compact JSON.
(defn via-pretty [(a (dyn Allocator)) (listen Listen)] (-> (Option (slice u8)))
  (try (let [text (try? (pretty a listen))]
         (ok (to-json-str a (try? (ok (from-json [Listen] a text))))))))

(deftest compact-output-decodes-to-the-same-config
  (with-arena a
              (match (reencoded a SAMPLE)
                (Some [once] (assert-eq (reencoded a once) (Some once)))
                (None [] (assert false)))))

(deftest pretty-output-decodes-to-the-same-config
  (with-arena a
              (match (parse-config a SAMPLE)
                (Ok [config]
                    (assert-eq (reencoded a (unwrap-or (pretty a config) ""))
                               (reencoded a SAMPLE)))
                (Err [e] (panic "parse failed: {}" e)))))

(deftest omitted-settings-take-defaults
  (with-arena a
              (match (parse-config a
                                   "{\"name\": \"n\", \"listen\": {\"host\": \"h\", \"port\": 1},
 \"routes\": [{\"path\": \"/\", \"upstream\": \"http://u\", \"methods\": []}]}")
                (Ok [config]
                    (assert-eq (.log-level config) (Info))
                    (assert-eq (.workers config) 4)
                    (assert (none? (.tls config)))
                    (assert-eq (.timeout-ms (get (.routes config) 0)) 30000))
                (Err [e] (panic "parse failed: {}" e)))))

(deftest pretty-layout
  (with-arena a
              (assert-eq (pretty a (Listen :host "h" :port 1))
                         (Some "{\n  \"host\": \"h\",\n  \"port\": 1\n}"))
              (assert-eq (pretty a (ArrayList::new [Method] a)) (Some "[]"))
              (assert-eq (pretty a
                                 (Route
                                   :path "/"
                                   :upstream "u"
                                   :methods (ArrayList::new [Method] a)
                                   :timeout-ms 5))
                         (Some "{\n  \"path\": \"/\",\n  \"upstream\": \"u\",\n  \"methods\": [],\n  \"timeoutMs\": 5\n}"))))

(deftest enum-names-round-trip
  (with-arena a
              (for level [(Debug) (Info) (Warn) (Error)]
                (let [text (unwrap-or (ok (to-json-str a level)) "")]
                  (assert-eq (from-json [LogLevel] a text) (Ok level))))
              (for m [(Get) (Post) (Put) (Delete)]
                (let [text (unwrap-or (ok (to-json-str a m)) "")]
                  (assert-eq (from-json [Method] a text) (Ok m))))
              (assert-eq (to-json-str a (Warn)) (Ok "\"warn\""))
              (assert-eq (to-json-str a (Delete)) (Ok "\"DELETE\""))
              (assert (none? (ok (from-json [LogLevel] a "\"Info\""))))
              (assert (none? (ok (from-json [Method] a "\"get\""))))))

(defprop pretty-and-compact-agree [(host (slice u8)) (port i64)]
  (let [listen (Listen :host host :port port)
        (mut agree) false]
    (with-arena a
                (set! agree
                      (= (via-pretty a listen) (ok (to-json-str a listen)))))
    agree))
