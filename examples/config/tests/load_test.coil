(module examples.config.load-test)
(import "coil.alloc" :use [Allocator])
(import "coil.io" :use [Errno])
(import "examples.config.load" :use *)
(import "examples.config.support" :use [with-arena render same?])

(deftest positions-are-one-based-lines-and-columns
         (let [src "ab\ncd\n\nef"]
           (assert-eq (.line (position-of src 0)) 1)
           (assert-eq (.column (position-of src 0)) 1)
           (assert-eq (.line (position-of src 4)) 2)
           (assert-eq (.column (position-of src 4)) 2)
           (assert-eq (.line (position-of src 7)) 4)
           (assert-eq (.column (position-of src 7)) 1)))

;;; The message `parse-config` gives for `src`, if it fails to decode.
(defn failure [(a (dyn Allocator)) (src (slice u8))] (-> (Option (slice u8)))
  (match (parse-config a src)
    (Ok [_] (None))
    (Err [e] (Some (render a e)))))

(deftest a-wrong-type-is-located
         (with-arena a
                     (assert (same? (failure a
                                             "{\"name\": \"n\",\n \"listen\": {\"host\": \"h\", \"port\": \"80\"}}")
                                    (Some "2:34: expected an integer")))))

(deftest a-syntax-error-is-located
         (with-arena a
                     (assert (same? (failure a
                                             "{\"name\": \"n\",\n\n  \"listen\": }")
                                    (Some "3:13: invalid JSON")))))

(deftest a-missing-field-is-named
         (with-arena a
                     (assert (same? (failure a
                                             "{\"name\": \"n\", \"routes\": []}")
                                    (Some "missing required field \"ServerConfig.listen\"")))))

(deftest an-unknown-log-level-lists-the-choices
         (with-arena a
                     (assert (same? (failure a
                                             "{\"name\": \"n\", \"listen\": {\"host\": \"h\", \"port\": 1},
                          \"logLevel\": \"loud\", \"routes\": []}")
                                    (Some "logLevel must be debug, info, warn or error")))))

(deftest an-unreadable-file-reports-the-os-error
         (with-arena a
                     (match (load-config a "data/no-such-file.json")
                       (Ok [_] (assert false))
                       (Err [e]
                            (assert (match e
                                      (Unreadable [(Errno [_])] true)
                                      (_ false)))
                            (assert-eq (render a e)
                                       "cannot read: No such file or directory (os error 2)")))))
