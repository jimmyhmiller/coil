{
  "name": "edge-gateway",
  "listen": { "host": "0.0.0.0", "port": 8443 },
  "logLevel": "warn",
  "workers": 8,
  "tls": { "certFile": "certs/edge.pem", "keyFile": "certs/edge.key" },
  "routes": [
    { "path": "/api/users", "upstream": "http://users.internal:9000", "methods": ["GET", "POST"], "timeoutMs": 5000 },
    { "path": "/api/orders", "upstream": "http://orders.internal:9100", "methods": ["GET", "POST", "DELETE"] },
    { "path": "/static", "upstream": "https://cdn.example.com", "methods": ["GET"], "timeoutMs": 2000 },
    { "path": "/healthz", "upstream": "http://127.0.0.1:8081", "methods": ["GET"], "timeoutMs": 250 }
  ]
}
