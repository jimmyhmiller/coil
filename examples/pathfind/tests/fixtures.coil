(module examples.pathfind.fixtures)
(import "coil.alloc" :use [malloc-allocator])
(import "examples.pathfind.astar" :use [find-path path-free!])
(import "examples.pathfind.grid" :use [parse-grid grid-free!])

;; `(with-grid [g "text"] body…)` runs `body` with `g` bound to the parsed maze
;; and frees it afterwards. A maze the parser rejects fails the test with its reason.
(defn with-grid [(binding Code) & (body Code)] (-> Code)
  `(match (parse-grid ~(get binding 1) (malloc-allocator))
     (Ok [(mut ~(get binding 0))]
         (defer (grid-free! (mut ~(get binding 0))))
         ~@body)
     (Err [e] (panic "unexpected parse error: {}" e))))

;; `(with-route [p g strategy] body…)` runs `body` with `p` bound to the route
;; the search finds, freeing it afterwards. Finding none fails the test.
(defn with-route [(binding Code) & (body Code)] (-> Code)
  `(match (find-path ~(get binding 1) ~(get binding 2) (malloc-allocator))
     (Some [(mut ~(get binding 0))]
           (defer (path-free! (mut ~(get binding 0))))
           ~@body)
     (None [] (panic "expected a route, found none"))))
