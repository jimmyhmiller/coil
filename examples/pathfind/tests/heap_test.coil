(module examples.pathfind.heap-test)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.arraylist" :use [ArrayList al-new al-free! al-slice])
(import "coil.collect" :use [collect])
(import "coil.prop" :use *)
(import "coil.slice" :use [sort])
(import "examples.pathfind.heap" :use [Heap heap-new heap-free!])

;; Pops everything, smallest first, into a fresh list the caller frees.
(defn drain [(h (mut (Heap i64))) (a (dyn Allocator))] (-> (ArrayList i64))
  (let [(mut out) (al-new [i64] a)]
    (while-let [(Some [x]) (pop! (mut h))] (push! (mut out) x))
    out))

(defn heap-of [(xs (slice i64)) (a (dyn Allocator))] (-> (Heap i64))
  (let [(mut h) (heap-new [i64] a)]
    (for x xs (push! (mut h) x))
    h))

(defn ascending [(x i64) (y i64)] (-> i64)
  (cond (< x y) -1
        (> x y) 1
        :else 0))

(deftest pops-in-ascending-order
  (let [a (malloc-allocator)
        (mut h) (heap-of [5 3 9 1 4 1] a)]
    (defer (heap-free! (mut h)))
    (assert-eq (len h) 6)
    (let [(mut out) (drain (mut h) a)]
      (assert-eq (al-slice out) [1 1 3 4 5 9])
      (al-free! (mut out)))
    (assert-eq (len h) 0)))

(deftest empty-heap-pops-nothing
  (let [(mut h) (heap-new [i64] (malloc-allocator))]
    (assert-eq (pop! (mut h)) (None))
    (heap-free! (mut h))))

(deftest interleaved-pushes-and-pops
  (let [a (malloc-allocator)
        (mut h) (heap-of [8 2 6] a)]
    (defer (heap-free! (mut h)))
    (assert-eq (len h) 3)
    (pop! (mut h))
    (push! (mut h) 1)
    (push! (mut h) 7)
    (let [(mut out) (drain (mut h) a)]
      (assert-eq (al-slice out) [1 6 7 8])
      (al-free! (mut out)))))

(defprop draining-a-heap-sorts-its-input [(xs (ArrayList i64))]
  (let [a (malloc-allocator)
        (mut h) (heap-of (al-slice xs) a)
        (mut drained) (drain (mut h) a)
        (mut sorted) (collect [(ArrayList i64)] a (al-slice xs))]
    (defer (heap-free! (mut h)))
    (defer (al-free! (mut drained)))
    (defer (al-free! (mut sorted)))
    (sort (al-slice sorted) (fnptr-of ascending))
    (= (al-slice drained) (al-slice sorted))))
