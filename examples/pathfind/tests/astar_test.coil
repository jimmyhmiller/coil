(module examples.pathfind.astar-test)
(import "coil.alloc" :as alloc :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.prop" :use *)
(import "coil.result" :use [none?])
(import "examples.pathfind.astar" :use *)
(import "examples.pathfind.grid" :use *)
(import "examples.pathfind.fixtures" :use [with-grid with-route])
(import "examples.pathfind.render" :use [draw])

(defn adjacent? [(a Point) (b Point)] (-> bool)
  (= (distance a b) 1))

;; A route is sound when it runs start to goal through open cells one step at a
;; time and its cost is what entering each of those cells costs.
(defn sound? [(g Grid) (p Path)] (-> bool)
  (let [points (.points p)
        n (len points)
        (mut paid) 0
        (mut connected) true]
    (for i (range 1 n)
      (let [here (get points i)]
        (unless (adjacent? (get points (- i 1)) here) (set! connected false))
        (match (cell-at g here)
          (Open [cost] (set! paid (+ paid cost)))
          (Wall [] (set! connected false)))))
    (and connected
         (= (get points 0) (.start g))
         (= (get points (- n 1)) (.goal g))
         (= paid (.cost p)))))

(deftest straight-corridor
  (with-grid [g "S...G"]
             (with-route [p g (AStar)]
                         (assert-eq (steps p) 4)
                         (assert-eq (.cost p) 4)
                         (assert (sound? g p)))))

(deftest walks-around-costly-terrain
  (with-grid [g "S9G\n..."]
             (with-route [p g (AStar)]
                         (assert-eq (.cost p) 4)
                         (assert-eq (steps p) 4)
                         (assert (sound? g p)))))

(deftest crosses-terrain-when-the-detour-costs-more
  (with-grid [g "S2G\n..."]
             (with-route [p g (AStar)]
                         (assert-eq (.cost p) 3)
                         (assert-eq (steps p) 2)
                         (assert (sound? g p)))))

(deftest start-next-to-goal
  (with-grid [g "SG"]
             (with-route [p g (AStar)]
                         (assert-eq (steps p) 1)
                         (assert-eq (.cost p) 1))))

(deftest walled-off-goal-has-no-route
  (with-grid [g "S.#G"]
             (assert (none? (find-path g (AStar) (malloc-allocator))))
             (assert (none? (find-path g (Dijkstra) (malloc-allocator))))))

(deftest heuristic-saves-work-in-open-space
  (with-grid [g "S.........\n..........\n..........\n.........G"]
             (with-route [guided g (AStar)]
                         (with-route [blind g (Dijkstra)]
                                     (assert-eq (.cost guided)
                                                (.cost blind))
                                     (assert (< (.expanded guided)
                                                (.expanded blind)))))))

(deftest draws-the-route
  (with-grid [g "S9G\n..."]
             (let [a (malloc-allocator)
                   route (find-path g (AStar) a)
                   text (draw g route a)]
               (assert-eq text "S9G\n***\n")
               (alloc/free a text)
               (route-free! route))))

;; Random maze text: `width` by `height` cells of floor, walls and terrain, with
;; the start at the top left and the goal at the bottom right.
(defn random-maze [(src (ptr Source)) (width i64) (height i64)]
  (-> (ArrayList u8))
  (let [(mut text) (ArrayList::new [u8] (malloc-allocator))
        palette "#..123459"]
    (for y (range 0 height)
      (for x (range 0 width)
        (push! (mut text)
               (cond (and (= x 0) (= y 0)) #\S
                     (and (= x (- width 1)) (= y (- height 1))) #\G
                     :else (get palette (draw-int! src 0 (- (len palette) 1))))))
      (push! (mut text) #\newline))
    text))

;; A* must agree with Dijkstra, which searches without an estimate, on whether
;; a route exists and on what the cheapest one costs.
(defn searches-agree? [(g Grid)] (-> bool)
  (let [guided (find-path g (AStar) (malloc-allocator))
        blind (find-path g (Dijkstra) (malloc-allocator))]
    (defer (route-free! guided))
    (defer (route-free! blind))
    (match guided
      (Some [p]
            (if-let [(Some [q]) blind]
              (and (sound? g p) (= (.cost p) (.cost q)))
              false))
      (None [] (none? blind)))))

(defprop astar-matches-dijkstra []
  (let [(mut text)
          (random-maze (source)
                       (draw-int! (source) 2 9)
                       (draw-int! (source) 1 7))]
    (defer (free! (mut text)))
    (match (parse-grid (note "maze" (slice text)) (malloc-allocator))
      (Ok [(mut g)]
          (defer (grid-free! (mut g)))
          (searches-agree? g))
      (Err [_] false))))
