(module examples.pathfind.grid-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.io" :use [FixBuf Writer fixed-buffer-writer])
(import "coil.slice" :use [subslice])
(import "examples.pathfind.fixtures" :use [with-grid])
(import "examples.pathfind.grid" :use *)

;; Formats `e` as `{}` would print it, into `buf`.
(defn displayed [(e ParseError) (buf (mut (array u8 128)))] (-> (slice u8))
  (let [(mut sink)
          (FixBuf
            :data (cast (ptr i8) buf)
            :len 0
            :cap 128)
        (mut w) (zeroed Writer)]
    (fixed-buffer-writer (mut w) (mut sink))
    (fmt (mut w) "{}" e)
    (subslice buf 0 (.len sink))))

(defn rejects-with? [(text (slice u8)) (expected ParseError)] (-> bool)
  (match (parse-grid text (malloc-allocator))
    (Err [e]
         (when (!= e expected) (println "expected {}, got {}" expected e))
         (= e expected))
    (Ok [g]
        (let [(mut owned) g] (grid-free! (mut owned)))
        false)))

(deftest reads-dimensions-endpoints-and-terrain
         (with-grid [g "#S.7\n.#G.\n"]
                    (assert-eq (.width g) 4)
                    (assert-eq (.height g) 2)
                    (assert-eq (.start g) (Point :x 1 :y 0))
                    (assert-eq (.goal g) (Point :x 2 :y 1))
                    (assert-eq (cell-at g (Point :x 0 :y 0)) (Wall))
                    (assert-eq (cell-at g (Point :x 2 :y 0)) (Open 1))
                    (assert-eq (cell-at g (Point :x 3 :y 0)) (Open 7))
                    (assert-eq (cell-at g (.start g)) (Open 1))))

(deftest final-newline-is-optional
         (with-grid [g "S.\n.G\n"] (assert-eq (.height g) 2))
         (with-grid [g "S.\n.G"] (assert-eq (.height g) 2)))

(deftest moves-skip-walls-and-edges
         (with-grid [g "S#\n3G\n"]
                    (let [moves (moves-from g (.start g))]
                      (assert-eq (len moves) 1)
                      (assert-eq (.to (get moves 0)) (Point :x 0 :y 1))
                      (assert-eq (.cost (get moves 0)) 3))))

(deftest rejects-a-ragged-row
         (assert (rejects-with? "S..\n.G\n..."
                                (RaggedRow
                                  :line 2
                                  :expected 3
                                  :found 2))))

(deftest rejects-an-unknown-character
         (assert (rejects-with? "S..\n.x.\n..G"
                                (UnknownChar
                                  :line 2
                                  :column 2
                                  :char #\x))))

(deftest rejects-duplicate-endpoints
         (assert (rejects-with? "S.G\n..S" (MultipleStarts :line 2 :column 3)))
         (assert (rejects-with? "SG.\n.G." (MultipleGoals :line 2 :column 2))))

(deftest rejects-missing-endpoints
         (assert (rejects-with? "...\n..G" (NoStart)))
         (assert (rejects-with? "S..\n..." (NoGoal)))
         (assert (rejects-with? "" (EmptyMaze))))

(deftest explains-errors-with-positions
         (let [(mut buf) (zeroed (array u8 128))]
           (assert-eq (displayed (UnknownChar
                                   :line 3
                                   :column 7
                                   :char #\?)
                                 (mut buf))
                      "line 3, column 7: unknown character \"?\"")
           (assert-eq (displayed (RaggedRow
                                   :line 2
                                   :expected 5
                                   :found 4)
                                 (mut buf))
                      "line 2: row is 4 cells wide, but the first row is 5")))
