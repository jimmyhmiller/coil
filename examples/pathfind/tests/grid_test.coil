(module examples.pathfind.grid-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.str" :use [sb-new sb-format! sb-str sb-free!])
(import "examples.pathfind.fixtures" :use [with-grid])
(import "examples.pathfind.grid" :use *)

;; `(shows value "text")` asserts that `{}` prints `value` as `text`.
(defn shows [(value Code) (expected Code)] (-> Code)
  `(let [(mut sb) (sb-new (malloc-allocator))]
     (sb-format! (mut sb) "{}" ~value)
     (assert-eq (sb-str sb) ~expected)
     (sb-free! (mut sb))))

;; The error parsing `text` fails with, or `None` when it parses.
(defn rejection [(text (slice u8))] (-> (Option ParseError))
  (match (parse-grid text (malloc-allocator))
    (Err [e] (Some e))
    (Ok [(mut g)] (grid-free! (mut g)) (None))))

(deftest reads-dimensions-endpoints-and-terrain
  (with-grid [g "#S.7\n.#G.\n"]
             (assert-eq (.width g) 4)
             (assert-eq (.height g) 2)
             (assert-eq (.start g) (Point :x 1 :y 0))
             (assert-eq (.goal g) (Point :x 2 :y 1))
             (assert-eq (cell-at g (Point :x 0 :y 0)) (Wall))
             (assert-eq (cell-at g (Point :x 2 :y 0)) (Open 1))
             (assert-eq (cell-at g (Point :x 3 :y 0)) (Open 7))
             (assert-eq (cell-at g (.start g)) (Open 1))))

(deftest final-newline-is-optional
  (with-grid [g "S.\n.G\n"] (assert-eq (.height g) 2))
  (with-grid [g "S.\n.G"] (assert-eq (.height g) 2)))

(deftest moves-skip-walls-and-edges
  (with-grid [g "S#\n3G\n"]
             (let [moves (moves-from g (.start g))]
               (assert-eq (len moves) 1)
               (assert-eq (.to (get moves 0)) (Point :x 0 :y 1))
               (assert-eq (.cost (get moves 0)) 3))))

(deftest rejects-a-ragged-row
  (assert-eq (rejection "S..\n.G\n...")
             (Some (RaggedRow
                     :line 2
                     :expected 3
                     :found 2))))

(deftest rejects-an-unknown-character
  (assert-eq (rejection "S..\n.x.\n..G")
             (Some (UnknownChar
                     :line 2
                     :column 2
                     :char #\x))))

(deftest rejects-duplicate-endpoints
  (assert-eq (rejection "S.G\n..S") (Some (MultipleStarts :line 2 :column 3)))
  (assert-eq (rejection "SG.\n.G.") (Some (MultipleGoals :line 2 :column 2))))

(deftest rejects-missing-endpoints
  (assert-eq (rejection "...\n..G") (Some (NoStart)))
  (assert-eq (rejection "S..\n...") (Some (NoGoal)))
  (assert-eq (rejection "") (Some (EmptyMaze))))

(deftest explains-errors-with-positions
  (shows (UnknownChar
           :line 3
           :column 7
           :char #\?)
         "line 3, column 7: unknown character \"?\"")
  (shows (RaggedRow
           :line 2
           :expected 5
           :found 4)
         "line 2: row is 4 cells wide, but the first row is 5"))
