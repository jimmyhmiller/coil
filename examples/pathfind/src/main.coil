;;; pathfind: cheapest routes through grid mazes with A*.
;;;
;;; Each argument names a maze file. `#` is a wall, `.` open floor, `S` the start
;;; and `G` the goal; a digit `1`–`9` is open terrain that costs that much to step
;;; onto, which is why the cheapest route is not always the shortest one. For each
;;; maze the program draws the A* route as `*` and compares the work A* did with
;;; a plain Dijkstra search, which finds a route of the same cost blind.
;;;
;;;     coil run examples/pathfind                     # data/maze.txt and data/walled.txt
;;;     coil run examples/pathfind -- my-maze.txt      # paths are relative to examples/pathfind
;;;
;;; The bundled mazes print:
;;;
;;;     data/maze.txt (40x12)
;;;     ########################################
;;;     #S*........#...........................#
;;;     #.*........#...........................#
;;;     #.*######..#.......99999999999.........#
;;;     #.*#.......#.......99999999999.........#
;;;     #.*#..######.......99999999999...#######
;;;     #.*#...............99999999999...#.....#
;;;     #.*#######*********99999999999...#..G..#
;;;     #.*********#......*99999999999...#.**..#
;;;     #..........#......*99999999999...##*####
;;;     #..........#......******************...#
;;;     ########################################
;;;     A*        49 steps, cost 50, 158 cells expanded
;;;     Dijkstra  49 steps, cost 50, 279 cells expanded
;;;
;;;     data/walled.txt (12x7)
;;;     ############
;;;     #S...#.....#
;;;     #.##.#.###.#
;;;     #.#..#.#G#.#
;;;     #.#.##.###.#
;;;     #..........#
;;;     ############
;;;     A*        no path
;;;     Dijkstra  no path
(module examples.pathfind.main)
(import "coil.alloc" :as alloc :use [Allocator malloc-allocator])
(import "coil.args" :use [args-set! args-count args-nth])
(import "coil.fs" :use [read-file])
(import "coil.io"
        :use
        [IoError Errno OutOfMemory Eof LineTooLong InvalidLimit stderr])
(import "coil.str" :use [cstr->str])
(import "examples.pathfind.astar"
        :use
        [Path AStar Dijkstra find-path route-free! steps])
(import "examples.pathfind.grid" :use [Grid ParseError parse-grid grid-free!])
(import "examples.pathfind.render" :use [draw])

(extern strerror :cc c [i32] (-> (ptr i8)))

;;; Why a maze file could not be used.
(defsum LoadError
  (Unreadable [(error IoError)])
  (Malformed [(error ParseError)]))

(defn io-message [(e IoError)] (-> (slice u8))
  (match e
    (Errno [code] (cstr->str (strerror (cast i32 code))))
    (OutOfMemory [] "out of memory")
    (Eof [] "unexpected end of file")
    (LineTooLong [] "line too long")
    (InvalidLimit [] "invalid read limit")))

(impl Display LoadError
  (display-fmt [(e LoadError) (f (ptr Formatter))]
               (-> i64)
               (let [w (formatter-writer f)]
                 (match e
                   (Unreadable [error] (fmt w "{}" (io-message error)))
                   (Malformed [error] (fmt w "{}" error)))
                 0)))

;;; Read and parse the maze at `path`. The returned grid is the caller's to free.
(defn load-maze [(path (slice u8)) (a (dyn Allocator))] (-> (Result Grid
                                                                    LoadError))
  (match (read-file a path)
    (Err [error] (Err (Unreadable error)))
    (Ok [text]
        (let [parsed (parse-grid text a)]
          (alloc/free a text)
          (match parsed
            (Ok [grid] (Ok grid))
            (Err [error] (Err (Malformed error))))))))

(defn report [(label (slice u8)) (route (Option Path))] (-> void)
  (match route
    (Some [path]
          (println "{:<9} {} steps, cost {}, {} cells expanded"
                   label
                   (steps path)
                   (.cost path)
                   (.expanded path)))
    (None [] (println "{:<9} no path" label))))

(defn solve [(g Grid) (a (dyn Allocator))] (-> void)
  (let [astar (find-path g (AStar) a)
        dijkstra (find-path g (Dijkstra) a)
        picture (draw g astar a)]
    (print "{}" picture)
    (report "A*" astar)
    (report "Dijkstra" dijkstra)
    (alloc/free a picture)
    (route-free! astar)
    (route-free! dijkstra)))

;; Solves one maze file, returning the process status it contributes.
(defn solve-file [(path (slice u8)) (a (dyn Allocator))] (-> i64)
  (match (load-maze path a)
    (Err [error]
         (fmt (stderr) "{}: {}\n" path error)
         1)
    (Ok [grid]
        (let [(mut g) grid]
          (println "{} ({}x{})" path (.width g) (.height g))
          (solve g a)
          (grid-free! (mut g))
          0))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args-set! argc argv)
  (if (< (args-count) 2)
      (do
        (fmt (stderr) "usage: pathfind MAZE-FILE...\n")
        2)
      (let [a (malloc-allocator)
            (mut status) 0]
        (for i
          (range 1 (args-count))
          (when (> i 1) (println ""))
          (when (!= (solve-file (args-nth i) a) 0) (set! status 1)))
        status)))
