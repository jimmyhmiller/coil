(module examples.pathfind.render)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [al-new al-into-slice])
(import "examples.pathfind.astar" :use [Path])
(import "examples.pathfind.grid" :use [Grid Cell Wall Open Point cell-at])

(defn glyph [(c Cell)] (-> u8)
  (match c
    (Wall [] #\#)
    (Open [cost] (if (= cost 1) #\. (cast u8 (+ #\0 cost))))))

;; Where `p` lands in the drawn text, whose rows each end in a newline.
(defn offset [(g Grid) (p Point)] (-> i64)
  (+ (* (.y p) (+ (.width g) 1)) (.x p)))

;;; The maze as text, one line per row: walls `#`, plain floor `.`, weighted
;;; terrain as its digit, `S` and `G` at the ends, and `*` along `route`. The
;;; text is allocated from `a`; the caller frees it with `(alloc/free a text)`.
(defn draw [(g Grid) (route (Option Path)) (a (dyn Allocator))] (-> (slice u8))
  (let [(mut canvas) (al-new [u8] a)]
    (for y (range 0 (.height g))
      (for x (range 0 (.width g))
        (push! (mut canvas) (glyph (cell-at g (Point :x x :y y)))))
      (push! (mut canvas) #\newline))
    (when-let [(Some [path]) route]
      (for p (.points path) (set! (mut canvas) (offset g p) #\*)))
    (set! (mut canvas) (offset g (.start g)) #\S)
    (set! (mut canvas) (offset g (.goal g)) #\G)
    (al-into-slice (mut canvas))))
