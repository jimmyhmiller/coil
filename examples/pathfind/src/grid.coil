(module examples.pathfind.grid)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList al-new al-free!])
(import "coil.fixedlist" :use [InlineList inline-list])
(import "coil.iter" :use [Indexed])
(import "coil.slice" :use [subslice])
(import "coil.str" :use [str-find-from])
(import "coil.result" :use [none? err?])
(import "coil.try" :use [try try! ensure! some-or!])

;;; A cell position: `x` counts columns rightward, `y` counts rows downward.
(defstruct Point [(x i64) (y i64)])

(derive Debug Eq Point)

;;; What occupies one cell. Stepping onto an open cell costs `cost`: 1 for `.`,
;;; `S` and `G`, and the digit's value for weighted terrain `1`–`9`.
(defsum Cell
  (Wall)
  (Open [(cost i64)]))

(derive Debug Eq Cell)

;;; A rectangular maze, its cells stored row by row. Owns `cells`; release it
;;; with `grid-free!`.
(defstruct Grid
  [(width i64)
   (height i64)
   (cells (ArrayList Cell))
   (start Point)
   (goal Point)])

;;; Why maze text was rejected. Lines and columns count from 1, as an editor
;;; shows them.
(defsum ParseError
  (EmptyMaze)
  (RaggedRow [(line i64) (expected i64) (found i64)])
  (UnknownChar [(line i64) (column i64) (char u8)])
  (MultipleStarts [(line i64) (column i64)])
  (MultipleGoals [(line i64) (column i64)])
  (NoStart)
  (NoGoal))

(derive Debug Eq ParseError)

(impl Display ParseError
  (display-fmt [(e ParseError) (f (ptr Formatter))]
               (-> i64)
               (let [w (formatter-writer f)]
                 (match e
                   (EmptyMaze [] (fmt w "the maze has no rows"))
                   (RaggedRow [line expected found]
                              (fmt w
                                   "line {}: row is {} cells wide, but the first row is {}"
                                   line
                                   found
                                   expected))
                   (UnknownChar [line column c]
                                (fmt w
                                     "line {}, column {}: unknown character {:?}"
                                     line
                                     column
                                     (: [c] (slice u8))))
                   (MultipleStarts [line column]
                                   (fmt w
                                        "line {}, column {}: a second start `S`"
                                        line
                                        column))
                   (MultipleGoals [line column]
                                  (fmt w
                                       "line {}, column {}: a second goal `G`"
                                       line
                                       column))
                   (NoStart [] (fmt w "no start `S`"))
                   (NoGoal [] (fmt w "no goal `G`")))
                 0)))

;;; Release the grid's cell storage.
(defn grid-free! [(g (mut Grid))] (-> void)
  (al-free! (mut (.cells g))))

;;; Where `p`'s cell sits in the row-major `cells` list.
(defn cell-index [(g Grid) (p Point)] (-> i64)
  (+ (* (.y p) (.width g)) (.x p)))

(defn cell-at [(g Grid) (p Point)] (-> Cell)
  (get (.cells g) (cell-index g p)))

;;; One orthogonal step onto an open cell, and what entering it costs.
(defstruct Move [(to Point) (cost i64)])

(defn in-bounds? [(g Grid) (p Point)] (-> bool)
  (and (>= (.x p) 0) (< (.x p) (.width g)) (>= (.y p) 0) (< (.y p) (.height g))))

;;; The moves out of `p`: one per orthogonal neighbour inside the grid that is
;;; not a wall.
(defn moves-from [(g Grid) (p Point)] (-> (InlineList Move 4))
  (let [(mut out) (inline-list [Move 4])]
    (for [dx dy]
      [[1 0] [0 1] [-1 0] [0 -1]]
      (let [next (Point :x (+ (.x p) dx) :y (+ (.y p) dy))]
        (when (in-bounds? g next)
          (match (cell-at g next)
            (Open [cost] (push! (mut out) (Move :to next :cost cost)))
            (Wall [] 0)))))
    out))

;; Yields each line of the text without its newline. A trailing newline ends the
;; last line rather than starting an empty one.
(defstruct Lines [(text (slice u8)) (at i64)])

(defn lines [(text (slice u8))] (-> Lines)
  (Lines :text text :at 0))

(impl Iterator Lines
  (next [(it (mut Lines))]
        (-> (Option (slice u8)))
        (let [text (.text it)
              start (.at it)]
          (if (>= start (len text))
              (None)
              (let [end
                      (match (str-find-from text "\n" start)
                        (Some [newline] newline)
                        (None [] (len text)))]
                (set! (.at it) (+ end 1))
                (Some (subslice text start end)))))))

(impl Iterable Lines
  (iter [(it Lines)] (-> Lines) it))

(defn read-cell [(c u8) (at Point)] (-> (Result Cell ParseError))
  (cond (= c #\#) (Ok (Wall))
        (or (= c #\.) (= c #\S) (= c #\G)) (Ok (Open 1))
        (and (>= c #\1) (<= c #\9)) (Ok (Open (- (cast i64 c) #\0)))
        :else
          (Err (UnknownChar
                 :line (+ (.y at) 1)
                 :column (+ (.x at) 1)
                 :char c))))

;;; Parse maze text: one row per line, every row the same width, with exactly one
;;; `S` and one `G`. The grid copies what it needs, so `text` may be freed after.
(defn parse-grid [(text (slice u8)) (a (dyn Allocator))] (-> (Result Grid
                                                                     ParseError))
  (let [(mut cells) (al-new [Cell] a)
        (mut width) 0
        (mut height) 0
        (mut start) (: (None) (Option Point))
        (mut goal) (: (None) (Option Point))
        parsed
          (try (for (Indexed :index y :value row)
                 (enumerate (lines text))
                 (when (= y 0) (set! width (len row)))
                 (ensure! (= (len row) width)
                          (Err (RaggedRow
                                 :line (+ y 1)
                                 :expected width
                                 :found (len row))))
                 (for (Indexed :index x :value c)
                   (enumerate row)
                   (let [at (Point :x x :y y)]
                     (when (= c #\S)
                       (ensure! (none? start)
                                (Err (MultipleStarts :line (+ y 1)
                                       :column (+ x 1))))
                       (set! start (Some at)))
                     (when (= c #\G)
                       (ensure! (none? goal)
                                (Err (MultipleGoals :line (+ y 1)
                                       :column (+ x 1))))
                       (set! goal (Some at)))
                     (push! (mut cells) (try! (read-cell c at)))))
                 (set! height (+ y 1)))
               (ensure! (> height 0) (Err (EmptyMaze)))
               (Ok (Grid
                     :width width
                     :height height
                     :cells cells
                     :start (some-or! start (Err (NoStart)))
                     :goal (some-or! goal (Err (NoGoal))))))]
    (when (err? parsed) (al-free! (mut cells)))
    parsed))
