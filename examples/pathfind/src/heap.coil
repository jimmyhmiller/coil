(module examples.pathfind.heap)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList al-new al-free!])

;;; A binary min-heap: `pop!` yields the smallest element under `Ord`, so any
;;; type with `<` can be a priority. The heap owns its storage; release it with
;;; `heap-free!`.
(defstruct Heap [T] [(items (ArrayList T))])

;;; An empty heap that grows through `a`.
(defn heap-new [T] [(a (dyn Allocator))] (-> (Heap T))
  (Heap :items (al-new [T] a)))

;;; Release the heap's storage. The elements themselves are not dropped.
(defn heap-free! [T] [(h (mut (Heap T)))] (-> void)
  (al-free! (mut (.items h))))

(defn parent-of [(i i64)] (-> i64)
  (/ (- i 1) 2))

(defn exchange! [T] [(items (mut (ArrayList T))) (i i64) (j i64)] (-> void)
  (let [held (get items i)]
    (set! (mut items) i (get items j))
    (set! (mut items) j held)))

(defn sift-up! [(T Ord)] [(items (mut (ArrayList T))) (start i64)] (-> void)
  (let [(mut i) start]
    (while (and (> i 0) (< (get items i) (get items (parent-of i))))
      (exchange! (mut items) i (parent-of i))
      (set! i (parent-of i)))))

;; The child a sinking element would trade places with: the smaller of the two.
(defn smaller-child [(T Ord)] [(items (ArrayList T)) (i i64)] (-> (Option i64))
  (let [left (+ (* 2 i) 1)
        right (+ left 1)]
    (cond (>= left (len items)) (None)
          (and (< right (len items)) (< (get items right) (get items left)))
            (Some right)
          :else (Some left))))

(defn sift-down! [(T Ord)] [(items (mut (ArrayList T)))] (-> void)
  (let [(mut i) 0]
    (loop (match (smaller-child items i)
            (Some [child]
                  (if (< (get items child) (get items i))
                      (do
                        (exchange! (mut items) i child)
                        (set! i child))
                      (break)))
            (None [] (break))))))

(impl [T] Len (Heap T)
  (len [(h (Heap T))] (-> i64) (len (.items h))))

(impl [(T Ord)] Push (Heap T)
  (push! [(h (mut (Heap T))) (v T)]
         (-> i64)
         (push! (mut (.items h)) v)
         (sift-up! (mut (.items h)) (- (len (.items h)) 1))
         0))

(impl [(T Ord)] Pop (Heap T)
  (pop! [(h (mut (Heap T)))]
        (-> (Option T))
        (if (empty? (.items h))
            (None)
            (do
              (exchange! (mut (.items h)) 0 (- (len (.items h)) 1))
              (let [smallest (pop! (mut (.items h)))]
                (sift-down! (mut (.items h)))
                smallest)))))
