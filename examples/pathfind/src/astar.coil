(module examples.pathfind.astar)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList al-new al-free!])
(import "examples.pathfind.grid" :use [Grid Move Point cell-index moves-from])
(import "examples.pathfind.heap" :use [Heap heap-new heap-free!])

;;; How the search estimates the cost still to go from a cell to the goal.
(defsum Strategy
  ;; Manhattan distance. It never overestimates, because every step costs at
  ;; least 1, so the first route to reach the goal is a cheapest one.
  (AStar)
  ;; No estimate at all: the search widens by cost alone.
  (Dijkstra))

;;; A cheapest route from start to goal, both included. `expanded` counts the
;;; cells the search settled before it reached the goal. Owns `points`; release
;;; it with `path-free!`.
(defstruct Path [(points (ArrayList Point)) (cost i64) (expanded i64)])

;;; Release the path's points.
(defn path-free! [(p (mut Path))] (-> void)
  (al-free! (mut (.points p))))

;;; Release the path a search returned, if it found one.
(defn route-free! [(route (Option Path))] (-> void)
  (when-let [(Some [(mut path)]) route] (path-free! (mut path))))

;;; Moves taken along the path: one fewer than the cells it visits.
(defn steps [(p Path)] (-> i64)
  (- (len (.points p)) 1))

(defn distance [(a Point) (b Point)] (-> i64)
  (let [dx (- (.x a) (.x b))
        dy (- (.y a) (.y b))]
    (+ (if (< dx 0) (- dx) dx) (if (< dy 0) (- dy) dy))))

(defn estimate [(strategy Strategy) (from Point) (goal Point)] (-> i64)
  (match strategy
    (AStar [] (distance from goal))
    (Dijkstra [] 0)))

;; One cell waiting on the frontier: `cost` to reach it so far, `priority` that
;; cost plus the estimate of what remains.
(defstruct Frontier [(priority i64) (cost i64) (at Point)])

;; Lowest priority first. Among equals, prefer the entry that has already paid
;; more: it has less left to go, so the search heads toward the goal instead of
;; fanning out across every equally promising cell.
(defn before? [(a Frontier) (b Frontier)] (-> bool)
  (or (< (.priority a) (.priority b))
      (and (= (.priority a) (.priority b)) (> (.cost a) (.cost b)))))

(impl Ord Frontier
  (< [(a Frontier) (b Frontier)] (-> bool)
    (before? a b))
  (<= [(a Frontier) (b Frontier)] (-> bool)
    (not (before? b a)))
  (> [(a Frontier) (b Frontier)] (-> bool)
    (before? b a))
  (>= [(a Frontier) (b Frontier)] (-> bool)
    (not (before? a b))))

;; Everything one search allocates, indexed by `cell-index`: the cheapest known
;; cost to each cell and the cell it was reached from.
(defstruct Search
  [(open (Heap Frontier))
   (best (ArrayList (Option i64)))
   (came-from (ArrayList (Option Point)))
   (expanded i64)])

(defn filled [T] [(a (dyn Allocator)) (n i64) (value T)] (-> (ArrayList T))
  (let [(mut out) (al-new [T] a)]
    (for _ (range 0 n) (push! (mut out) value))
    out))

(defn search-new [(g Grid) (a (dyn Allocator))] (-> Search)
  (let [cells (* (.width g) (.height g))]
    (Search
      :open (heap-new [Frontier] a)
      :best (filled a cells (None))
      :came-from (filled a cells (None))
      :expanded 0)))

(defn search-free! [(s (mut Search))] (-> void)
  (heap-free! (mut (.open s)))
  (al-free! (mut (.best s)))
  (al-free! (mut (.came-from s))))

(defn cheaper? [(known (Option i64)) (cost i64)] (-> bool)
  (match known
    (Some [best] (< cost best))
    (None [] true)))

;; Record a route to `at` and queue it, unless a route at least as cheap is known.
(defn offer! [(s (mut Search))
              (g Grid)
              (strategy Strategy)
              (at Point)
              (cost i64)
              (from (Option Point))] (-> void)
  (let [i (cell-index g at)]
    (when (cheaper? (get (.best s) i) cost)
      (set! (mut (.best s)) i (Some cost))
      (set! (mut (.came-from s)) i from)
      (push! (mut (.open s))
             (Frontier
               :priority (+ cost (estimate strategy at (.goal g)))
               :cost cost
               :at at)))))

;; A cell can sit on the frontier several times, once per improvement; only the
;; entry carrying its cheapest cost is worth expanding.
(defn stale? [(s Search) (g Grid) (entry Frontier)] (-> bool)
  (match (get (.best s) (cell-index g (.at entry)))
    (Some [best] (< best (.cost entry)))
    (None [] false)))

(defn reverse! [T] [(items (mut (ArrayList T)))] (-> void)
  (let [n (len items)]
    (for i (range 0 (/ n 2))
      (let [front (get items i)]
        (set! (mut items) i (get items (- n 1 i)))
        (set! (mut items) (- n 1 i) front)))))

;; Walks `came-from` back from the goal, then flips the walk to run start-first.
(defn trace-route [(s Search) (g Grid) (cost i64) (a (dyn Allocator))] (-> Path)
  (let [(mut points) (al-new [Point] a)
        (mut at) (Some (.goal g))]
    (while-let [(Some [p]) at]
      (push! (mut points) p)
      (set! at (get (.came-from s) (cell-index g p))))
    (reverse! (mut points))
    (Path
      :points points
      :cost cost
      :expanded (.expanded s))))

;;; The cheapest route from the grid's start to its goal, or `None` when walls
;;; cut the goal off. `a` provides the search's working memory, freed before
;;; returning, and the returned path's points.
(defn find-path [(g Grid) (strategy Strategy) (a (dyn Allocator))]
  (-> (Option Path))
  (let [(mut s) (search-new g a)]
    (defer (search-free! (mut s)))
    (offer! (mut s) g strategy (.start g) 0 (None))
    (block :search
      (while-let [(Some [entry]) (pop! (mut (.open s)))]
        (unless (stale? s g entry)
          (set! (.expanded s) (+ (.expanded s) 1))
          (when (= (.at entry) (.goal g))
            (return-from :search (Some (trace-route s g (.cost entry) a))))
          (for (Move :to next :cost cost) (moves-from g (.at entry))
            (offer! (mut s)
                    g
                    strategy
                    next
                    (+ (.cost entry) cost)
                    (Some (.at entry))))))
      (None))))
