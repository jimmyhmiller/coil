(module examples.wordfreq.cli-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [al-slice])
(import "examples.wordfreq.cli"
        :use
        [ArgError MissingValue BadCount UnknownFlag NoInputFiles parse-args])

(defn assert-parses [(args (slice (slice u8)))
                     (top i64)
                     (paths (slice (slice u8)))] (-> void)
  (match (parse-args (malloc-allocator) args)
    (Ok [opts]
        (assert-eq (.top opts) top)
        (assert-eq (al-slice (.paths opts)) paths))
    (Err [e] (panic "rejected: {}" e))))

(defn assert-rejects [(args (slice (slice u8))) (expected ArgError)] (-> void)
  (match (parse-args (malloc-allocator) args)
    (Ok [_] (assert false))
    (Err [e] (assert-eq e expected))))

(deftest top-defaults-to-ten
  (assert-parses ["a.txt"] 10 ["a.txt"]))

(deftest top-may-appear-among-the-files
  (assert-parses ["a.txt" "--top" "3" "b.txt"] 3 ["a.txt" "b.txt"])
  (assert-parses ["--top" "1" "--top" "7" "a.txt"] 7 ["a.txt"]))

(deftest at-least-one-file-is-required
  (assert-rejects [] (NoInputFiles))
  (assert-rejects ["--top" "5"] (NoInputFiles)))

(deftest top-needs-a-value
  (assert-rejects ["a.txt" "--top"] (MissingValue "--top")))

(deftest top-must-be-a-positive-integer
  (assert-rejects ["--top" "x" "a.txt"] (BadCount "x"))
  (assert-rejects ["--top" "0" "a.txt"] (BadCount "0"))
  (assert-rejects ["--top" "-2" "a.txt"] (BadCount "-2"))
  (assert-rejects ["--top" "" "a.txt"] (BadCount "")))

(deftest unknown-flags-are-rejected
  (assert-rejects ["-v" "a.txt"] (UnknownFlag "-v"))
  (assert-rejects ["a.txt" "--top=3"] (UnknownFlag "--top=3")))
