(module examples.wordfreq.tally-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [al-free! al-slice])
(import "coil.prop" :use *)
(import "coil.str"
        :use
        [StringView String sv string-new string-free! string-push-view!
         string-as-view])
(import "examples.wordfreq.tally"
        :use
        [Tally WordCount tally-new tally-text! count-of unique-words ranking
         rank-order])
(import "examples.wordfreq.words" :use [words])

(defn tallied [(text StringView)] (-> Tally)
  (let [(mut t) (tally-new (malloc-allocator))]
    (tally-text! (mut t) text)
    t))

(defn assert-ranking [(t (ref Tally)) (expected (slice WordCount))] (-> void)
  (let [(mut rows) (ranking (malloc-allocator) t)]
    (assert-eq (al-slice rows) expected)
    (al-free! (mut rows))))

(deftest counts-ignore-case
  (let [t (tallied (sv "The the THE cat"))]
    (assert-eq (count-of t "the") 3)
    (assert-eq (count-of t "cat") 1)
    (assert-eq (count-of t "The") 0)
    (assert-eq (.total t) 4)
    (assert-eq (unique-words t) 2)))

(deftest both-apostrophe-styles-are-one-word
  (let [t (tallied (sv "don't DON’T don’t"))]
    (assert-eq (count-of t "don't") 3)
    (assert-eq (unique-words t) 1)))

(deftest accents-distinguish-words
  (let [t (tallied (sv "Été été ete"))]
    (assert-eq (count-of t "été") 2)
    (assert-eq (count-of t "ete") 1)))

(deftest tallying-accumulates-across-texts
  (let [(mut t) (tally-new (malloc-allocator))]
    (assert-eq (tally-text! (mut t) (sv "one two")) 2)
    (assert-eq (tally-text! (mut t) (sv "two three, three")) 3)
    (assert-eq (.total t) 5)
    (assert-eq (count-of t "three") 2)
    (assert-eq (unique-words t) 3)))

(deftest ranking-puts-higher-counts-first
  (assert-ranking (tallied (sv "b a c b a b"))
                  [(WordCount :word "b" :count 3)
                   (WordCount :word "a" :count 2)
                   (WordCount :word "c" :count 1)]))

(deftest ranking-breaks-ties-by-code-point
  (assert-ranking (tallied (sv "pear éclair Apple fig zebra fig"))
                  [(WordCount :word "fig" :count 2)
                   (WordCount :word "apple" :count 1)
                   (WordCount :word "pear" :count 1)
                   (WordCount :word "zebra" :count 1)
                   (WordCount :word "éclair" :count 1)]))

(deftest wordless-text-ranks-nothing
  (let [t (tallied (sv " 42, -- ' "))]
    (assert-eq (.total t) 0)
    (assert-ranking t [])))

;;; A text assembled from `choices`, each byte picking one piece: letters in both
;;; cases, both apostrophes, and separators.
(defn text-from [(choices (slice u8))] (-> String)
  (let [pieces
          [(sv "a")
           (sv "b")
           (sv "A")
           (sv "é")
           (sv "É")
           (sv "'")
           (sv "’")
           (sv " ")
           (sv ",")
           (sv "-")]
        (mut text) (string-new (malloc-allocator))]
    (for c choices
      (string-push-view! (mut text) (get pieces (% (cast i64 c) (len pieces)))))
    text))

(defn ranking-consistent? [(t (ref Tally)) (words-seen i64)] (-> bool)
  (let [(mut rows) (ranking (malloc-allocator) t)
        sum (fold (fn [acc row] (+ acc (.count row))) 0 rows)
        (mut ordered) true]
    (for i (range 1 (len rows))
      (when (>= (rank-order (get rows (- i 1)) (get rows i)) 0)
        (set! ordered false)))
    (al-free! (mut rows))
    (and ordered (= sum (.total t)) (= words-seen (.total t)))))

(defprop ranking-accounts-for-every-word [(choices (slice u8))]
  (let [(mut text) (text-from choices)
        ok
          (let [view (string-as-view text)]
            (ranking-consistent? (tallied view) (count (words view))))]
    (string-free! (mut text))
    ok))
