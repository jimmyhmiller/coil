(module examples.wordfreq.words-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.iter" :use [ZipItem])
(import "coil.str"
        :use
        [StringView sv String])
(import "examples.wordfreq.words" :use [words normalize-into!])

(defn assert-words [(text StringView) (expected (slice (slice u8)))] (-> void)
  (assert-eq (count (words text)) (len expected))
  (for (ZipItem :first word :second want) (zip (words text) expected)
    (assert-eq (bytes word) want)))

(defn assert-normalized [(word StringView) (expected (slice u8))] (-> void)
  (let [(mut out) (String::new (malloc-allocator))]
    (normalize-into! (mut out) word)
    (assert-eq (bytes (as-string-view out)) expected)
    (free! (mut out))))

(deftest whitespace-and-punctuation-separate-words
  (assert-words (sv "Hello, world!  How\tare\nyou?")
                ["Hello" "world" "How" "are" "you"]))

(deftest digits-hyphens-and-dashes-separate-words
  (assert-words (sv "In 1815, soixante-quinze ans — vrai")
                ["In" "soixante" "quinze" "ans" "vrai"]))

(deftest empty-and-wordless-text-has-no-words
  (assert-eq (count (words (sv ""))) 0)
  (assert-eq (count (words (sv " 42 -- !? ''"))) 0))

(deftest apostrophes-join-letters-inside-a-word
  (assert-words (sv "don't l'avait") ["don't" "l'avait"])
  (assert-words (sv "c’était") ["c’était"]))

(deftest apostrophes-at-word-edges-are-quotes
  (assert-words (sv "'tis the dogs' 'quoted'")
                ["tis" "the" "dogs" "quoted"])
  (assert-words (sv "rock 'n' roll") ["rock" "n" "roll"]))

(deftest letters-of-every-script-are-letters
  (assert-words (sv "évêque, cœur; Ελλάδα и Москва")
                ["évêque" "cœur" "Ελλάδα" "и" "Москва"])
  (assert-words (sv "東京、ὁδός. שלום")
                ["東京" "ὁδός" "שלום"]))

(deftest combining-marks-stay-in-their-word
  (assert-words (sv "cafe\x301; noir") ["cafe\x301;" "noir"]))

(deftest symbols-and-punctuation-separate-words
  (assert-words (sv "2×3÷4 «oui» a·b") ["oui" "a" "b"]))

(deftest normalizing-folds-case-and-apostrophes
  (assert-normalized (sv "Don’t") "don't")
  (assert-normalized (sv "ÉTÉ") "été")
  (assert-normalized (sv "ΑΘΗΝΑ") "αθηνα")
  (assert-normalized (sv "МОСКВА") "москва")
  (assert-normalized (sv "ŒUVRE Ἀθῆναι ǅ") "œuvre ἀθῆναι ǆ")
  (assert-normalized (sv "東京") "東京"))
