(module examples.wordfreq.cli)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList al-new al-free!])
(import "coil.result" :use [unwrap-or])
(import "coil.str" :use [str-parse-int starts-with])
(import "coil.try" :use [try try! ensure!])

;;; How many rows the table shows when `--top` is not given.
(const DEFAULT-TOP 10)

;;; What went wrong on the command line.
(defsum ArgError
  (MissingValue [(flag (slice u8))])
  (BadCount [(text (slice u8))])
  (UnknownFlag [(flag (slice u8))])
  (NoInputFiles))

(derive Eq ArgError)

(impl Display ArgError
  (display-fmt [(e ArgError) (f (ptr Formatter))]
    (-> i64)
    (let [w (formatter-writer f)]
      (match e
        (MissingValue [flag] (fmt w "{} needs a value" flag))
        (BadCount [text]
                  (fmt w
                       "expected a positive whole number, got '{}'"
                       text))
        (UnknownFlag [flag] (fmt w "unknown option {}" flag))
        (NoInputFiles [] (fmt w "no input files"))))
    0))

;;; A parsed command line. `paths` borrows the argument strings.
(defstruct Options [(top i64) (paths (ArrayList (slice u8)))])

(impl Drop Options
  (drop [(o (mut Options))]
    (-> void)
    (al-free! (mut (.paths o)))))

(defn parse-count [(text (slice u8))] (-> (Result i64 ArgError))
  (let [n (unwrap-or (str-parse-int text) 0)]
    (if (> n 0) (Ok n) (Err (BadCount text)))))

;;; The count following `--top` at `args[at]`.
(defn top-value [(args (slice (slice u8))) (at i64)] (-> (Result i64 ArgError))
  (if (= (+ at 1) (len args))
      (Err (MissingValue (get args at)))
      (parse-count (get args (+ at 1)))))

;;; Collect the file arguments into `paths`, returning the `--top` count.
(defn scan-args! [(paths (mut (ArrayList (slice u8))))
                  (args (slice (slice u8)))] (-> (Result i64 ArgError))
  (let [(mut top) DEFAULT-TOP
        (mut i) 0]
    (try
      (while (< i (len args))
        (let [arg (get args i)]
          (if (= arg "--top")
              (do
                (set! top (try! (top-value args i)))
                (set! i (+ i 2)))
              (do
                (ensure! (not (starts-with arg "-")) (Err (UnknownFlag arg)))
                (push! (mut paths) arg)
                (set! i (+ i 1))))))
      (ensure! (not (empty? paths)) (Err (NoInputFiles)))
      (Ok top))))

;;; Parse `[--top N] FILE...`, with the flag allowed anywhere among the files.
(defn parse-args [(a (dyn Allocator)) (args (slice (slice u8)))]
  (-> (Result Options ArgError))
  (let [(mut paths) (al-new [(slice u8)] a)]
    (match (scan-args! (mut paths) args)
      (Ok [top] (Ok (Options :top top :paths paths)))
      (Err [e]
           (al-free! (mut paths))
           (Err e)))))
