(module examples.wordfreq.words)
(import "coil.str"
        :use
        [StringView String StringIndex Rune rune-value string-clear!
         string-push-rune! string-view-start string-view-end string-view-slice
         string-view-rune-at string-view-next-rune-index
         string-index-byte-offset])
(import "coil.unicode" :as u)

;;; How a rune takes part in a word. Letters build words, apostrophes may join
;;; letters inside a word (`don't`, `l'avait`), everything else separates words.
(defsum RuneClass
  (Letter)
  (Apostrophe)
  (Separator))

;;; The ASCII apostrophe and U+2019, the typographic one most published text uses.
(defn apostrophe? [(r Rune)] (-> bool)
  (let [c (rune-value r)]
    (or (= c 0x27) (= c 0x2019))))

;;; A letter of any script is part of a word, and so is a combining mark, so a
;;; decomposed `e` + U+0301 stays one word.
(defn classify [(r Rune)] (-> RuneClass)
  (cond (or (u/letter? r) (u/mark? r)) (Letter)
        (apostrophe? r) (Apostrophe)
        :else (Separator)))

;;; The form a rune takes in a counted word: case-folded, with every apostrophe
;;; spelled as ASCII `'` so `don’t` and `don't` count as one word.
(defn normalize-rune [(r Rune)] (-> Rune)
  (if (apostrophe? r) (Rune :value 0x27) (u/case-fold r)))

;;; Replace the contents of `out` with the normalized spelling of `word`.
(defn normalize-into! [(out (mut String)) (word StringView)] (-> void)
  (string-clear! (mut out))
  (for r word (string-push-rune! (mut out) (normalize-rune r))))

;;; One decoded rune and the index just past it.
(defstruct Step [(rune Rune) (next StringIndex)])

(defn step [(text StringView) (at StringIndex)] (-> (Option Step))
  (if-let [(Some [next]) (string-view-next-rune-index text at)]
    (Some (Step
            :rune (string-view-rune-at text (string-index-byte-offset at))
            :next next))
    (None)))

;;; The index of the first letter at or after `at`.
(defn find-letter [(text StringView) (at StringIndex)] (-> (Option StringIndex))
  (let [(mut pos) at]
    (loop (match (step text pos)
            (None [] (break (None)))
            (Some [(Step :rune r :next next)]
                  (match (classify r)
                    (Letter [] (break (Some pos)))
                    (_ (set! pos next))))))))

;;; A word found by `scan-word`: where it ends, and where scanning resumes.
(defstruct WordEnd [(end StringIndex) (resume StringIndex)])

;;; Scan the word that begins with the letter at `start`. The word runs to the first
;;; separator, minus any trailing apostrophes, which are quotation marks rather
;;; than part of the word.
(defn scan-word [(text StringView) (start StringIndex)] (-> WordEnd)
  (let [(mut pos) start
        (mut end) start]
    (loop (match (step text pos)
            (None [] (break))
            (Some [(Step :rune r :next next)]
                  (match (classify r)
                    (Letter [] (set! end next) (set! pos next))
                    (Apostrophe [] (set! pos next))
                    (Separator [] (break))))))
    (WordEnd :end end :resume pos)))

;;; An iterator over the words of a text, yielding each word as a view of the text
;;; exactly as written. A word starts with a letter, so leading apostrophes (opening
;;; quotes, `'tis`) are not part of it either.
(defstruct Words [(text StringView) (at StringIndex)])

;;; The words of `text`, in order.
(defn words [(text StringView)] (-> Words)
  (Words :text text :at (string-view-start text)))

(impl Iterable Words
  (iter [(ws Words)] (-> Words)
    ws))

(impl Iterator Words
  (next [(ws (mut Words))] (-> (Option StringView))
    (let [text (.text ws)]
      (match (find-letter text (.at ws))
        (None []
              (set! (.at ws) (string-view-end text))
              (None))
        (Some [start]
              (let [(WordEnd :end end :resume resume) (scan-word text start)]
                (set! (.at ws) resume)
                (Some (string-view-slice text start end))))))))
