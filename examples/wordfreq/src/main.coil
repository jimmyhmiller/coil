;;; wordfreq: count the words in one or more UTF-8 text files and print the most
;;; frequent ones.
;;;
;;;   coil run examples/wordfreq                 # bundled Austen and Hugo excerpts, top 25
;;;   coil run examples/wordfreq -- --top 5 data/hugo.txt missing.txt
;;;
;;; A word is a run of letters, possibly joined by apostrophes (`don't`, the French
;;; `l’avait`). Words are case-folded and `’` is read as `'`; `examples.wordfreq.words`
;;; says exactly which scripts count as letters and which cases fold. Ties are broken
;;; by code point, so `éclair` sorts after `zebra`. A file that cannot be read, or is not
;;; valid UTF-8, is reported on stderr and skipped; the other files are still counted
;;; and the exit status is 1.
;;;
;;; Sample output (`coil run examples/wordfreq`, rows 6-20 elided):
;;;
;;;    rank   count   share  word
;;;       1      28    2.5%  you
;;;       2      25    2.3%  de
;;;       3      24    2.2%  of
;;;       4      18    1.6%  a
;;;       5      17    1.5%  to
;;;     ...
;;;      21       8    0.7%  dans
;;;      22       8    0.7%  en
;;;      23       8    0.7%  et
;;;      24       8    0.7%  il
;;;      25       8    0.7%  était
;;;
;;;   files: 2   words: 1110   unique: 510
(module examples.wordfreq.main)
(import "coil.alloc" :as alloc :use [Allocator malloc-allocator])
(import "coil.args" :use [args-set! args-count args-nth])
(import "coil.arraylist" :use [ArrayList al-new al-free! al-slice])
(import "coil.fs" :use [read-file])
(import "coil.io"
        :use
        [IoError stderr])
(import "coil.iter" :use [Indexed])
(import "coil.str" :use [string-view-from-utf8 utf8-error-offset])
(import "examples.wordfreq.cli" :use [Options parse-args])
(import "examples.wordfreq.tally"
        :use
        [Tally
         WordCount
         tally-new
         tally-text!
         unique-words
         ranking])

(const USAGE "usage: wordfreq [--top N] FILE...")

;;; Why one input file was skipped.
(defsum FileError
  (Unreadable [(cause IoError)])
  (NotUtf8 [(offset i64)]))

(impl Display FileError
  (display-fmt [(e FileError) (f (ptr Formatter))]
               (-> i64)
               (let [w (formatter-writer f)]
                 (match e
                   (Unreadable [cause] (fmt w "{}" cause))
                   (NotUtf8 [offset] (fmt w "not valid UTF-8 (byte {})" offset))))
               0))

;;; Tally every word of the file at `path`, returning how many it held. The file's
;;; bytes are freed before returning; the tally keeps its own copies of the words.
(defn tally-file! [(t (mut Tally)) (a (dyn Allocator)) (path (slice u8))] (-> (Result i64
                                                                                      FileError))
  (match (read-file a path)
    (Err [cause] (Err (Unreadable cause)))
    (Ok [bytes]
        (let [counted
                (match (string-view-from-utf8 bytes)
                  (Ok [text] (Ok (tally-text! (mut t) text)))
                  (Err [bad] (Err (NotUtf8 (utf8-error-offset bad)))))]
          (alloc/free a bytes)
          counted))))

(defn percent [(part i64) (whole i64)] (-> f64)
  (/ (* 100.0 (cast f64 part)) (cast f64 whole)))

;;; The `top` most frequent words. Only the word column is unpadded: width specs
;;; count bytes, so padding a non-ASCII word would misalign the columns after it.
(defn print-table [(a (dyn Allocator)) (t (ref Tally)) (top i64)] (-> void)
  (let [(mut rows) (ranking a t)]
    (println "{:>5}  {:>6}  {:>6}  {}" "rank" "count" "share" "word")
    (for (Indexed
           :index i
           :value (WordCount :word word :count n))
      (enumerate (take top rows))
      (println "{:>5}  {:>6}  {:>5.1}%  {}"
               (+ i 1)
               n
               (percent n (.total t))
               word))
    (al-free! (mut rows))))

;;; Count every file named in `opts`, print the report, and return the exit status.
(defn run [(a (dyn Allocator)) (opts (ref Options))] (-> i64)
  (let [(mut t) (tally-new a)
        (mut read) 0
        (mut failed) 0]
    (for path
      (.paths opts)
      (match (tally-file! (mut t) a path)
        (Ok [_] (set! read (+ read 1)))
        (Err [e]
             (fmt (stderr) "wordfreq: {}: {}\n" path e)
             (set! failed (+ failed 1)))))
    (if (= (.total t) 0)
        (println "no words found")
        (print-table a t (.top opts)))
    (println "")
    (println "files: {}   words: {}   unique: {}"
             read
             (.total t)
             (unique-words t))
    (when (> failed 0) (println "skipped: {}" failed))
    (if (= failed 0) 0 1)))

;;; The program's arguments, without its own name. The slices borrow `argv`.
(defn command-line [(a (dyn Allocator))] (-> (ArrayList (slice u8)))
  (let [(mut out) (al-new [(slice u8)] a)]
    (for i
      (range 1 (args-count))
      (push! (mut out) (args-nth i)))
    out))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args-set! argc argv)
  (let [heap (malloc-allocator)
        (mut args) (command-line heap)
        status
          (match (parse-args heap (al-slice args))
            (Ok [opts] (run heap opts))
            (Err [e]
                 (fmt (stderr) "wordfreq: {}\n{}\n" e USAGE)
                 2))]
    (al-free! (mut args))
    status))
