(module examples.wordfreq.tally)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList al-new al-slice])
(import "coil.hashmap" :use [HashMap hm-new hm-free!])
(import "coil.result" :use [unwrap-or])
(import "coil.slice" :use [sort])
(import "coil.str"
        :use
        [StringView String string-new string-free! string-as-view
         string-view-bytes str-keyops str-cmp])
(import "examples.wordfreq.words" :use [words normalize-into!])

;;; Word counts over any number of texts. The map owns copies of its keys, so a
;;; text can be freed as soon as it has been tallied.
(defstruct Tally
  [(counts (HashMap (slice u8) i64))
   (total i64)
   (scratch String)])

(impl Drop Tally
  (drop [(t (mut Tally))]
    (-> void)
    (hm-free! (mut (.counts t)))
    (string-free! (mut (.scratch t)))))

;;; An empty tally whose map and scratch buffer live in `a`.
(defn tally-new [(a (dyn Allocator))] (-> Tally)
  (Tally
    :counts (hm-new [(slice u8) i64] a (str-keyops))
    :total 0
    :scratch (string-new a)))

;;; How many times the normalized `word` has been seen.
(defn count-of [(t (ref Tally)) (word (slice u8))] (-> i64)
  (unwrap-or (get (.counts t) word) 0))

;;; Count one occurrence of `word`, normalizing it first. The scratch buffer is
;;; reused for every word; only a word new to the map is copied into it.
(defn tally-word! [(t (mut Tally)) (word StringView)] (-> void)
  (normalize-into! (mut (.scratch t)) word)
  (let [key (string-view-bytes (string-as-view (.scratch t)))]
    (set! (mut (.counts t)) key (+ (count-of t key) 1))
    (set! (.total t) (+ (.total t) 1))))

;;; Count every word of `text`, returning how many there were.
(defn tally-text! [(t (mut Tally)) (text StringView)] (-> i64)
  (let [before (.total t)]
    (for w (words text) (tally-word! (mut t) w))
    (- (.total t) before)))

;;; How many distinct words have been seen.
(defn unique-words [(t (ref Tally))] (-> i64)
  (len (.counts t)))

;;; One row of the ranking. `word` borrows the tally's key, so a ranking must not
;;; outlive the tally it came from.
(defstruct WordCount [(word (slice u8)) (count i64)])

(derive Eq WordCount)

;;; Higher counts first; equal counts in ascending byte order, which for UTF-8 is
;;; code point order.
(defn rank-order [(a WordCount) (b WordCount)] (-> i64)
  (if (= (.count a) (.count b))
      (str-cmp (.word a) (.word b))
      (- (.count b) (.count a))))

;;; Every distinct word with its count, most frequent first. The caller frees the
;;; list with `al-free!`.
(defn ranking [(a (dyn Allocator)) (t (ref Tally))] (-> (ArrayList WordCount))
  (let [(mut rows) (al-new [WordCount] a)]
    (for word (.counts t)
      (push! (mut rows) (WordCount :word word :count (count-of t word))))
    (sort (al-slice rows) (fnptr-of rank-order))
    rows))
