(module examples.logscan.classify-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList al-new al-free! al-slice])
(import "examples.logscan.classify" :use *)

(deftest status-classes-follow-the-hundreds-digit
         (assert-eq (status-class 101) (Informational))
         (assert-eq (status-class 200) (Success))
         (assert-eq (status-class 299) (Success))
         (assert-eq (status-class 304) (Redirection))
         (assert-eq (status-class 404) (ClientError))
         (assert-eq (status-class 503) (ServerError)))

(deftest paths-are-api-asset-or-page
         (assert-eq (path-kind "/api") (Api))
         (assert-eq (path-kind "/api/users/42") (Api))
         (assert-eq (path-kind "/api?debug=1") (Api))
         (assert-eq (path-kind "/apiary") (Page))
         (assert-eq (path-kind "/static/app.js") (Asset))
         (assert-eq (path-kind "/static/APP.CSS?v=3") (Asset))
         (assert-eq (path-kind "/fonts/inter.woff2") (Asset))
         (assert-eq (path-kind "/photo.jpeg") (Asset))
         (assert-eq (path-kind "/blog/what-is.json") (Page))
         (assert-eq (path-kind "/") (Page)))

(deftest bots-are-recognized-by-user-agent
         (assert (bot? "Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)"))
         (assert (bot? "Mozilla/5.0 (compatible; AhrefsBot/7.0)"))
         (assert (bot? "curl/8.4.0"))
         (assert (bot? "python-requests/2.32.3"))
         (assert (not (bot? "Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0")))
         (assert (not (bot? ""))))

(defn route-of [(path (slice u8))] (-> (ArrayList u8))
  (let [(mut out) (al-new [u8] (malloc-allocator))]
    (push-route! (mut out) path)
    out))

(defn assert-route [(path (slice u8)) (expected (slice u8))] (-> void)
  (let [(mut route) (route-of path)]
    (assert-eq (al-slice route) expected)
    (al-free! (mut route))))

(deftest routes-collapse-ids-and-drop-queries
         (assert-route "/api/users/42" "/api/users/:id")
         (assert-route "/api/users/42/orders/7?page=2"
                       "/api/users/:id/orders/:id")
         (assert-route "/api/search?q=coil" "/api/search")
         (assert-route "/v2/items" "/v2/items")
         (assert-route "/2026/10/regex" "/:id/:id/regex")
         (assert-route "/" "/"))
