(module examples.logscan.scan-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.fs" :use [write-file])
(import "coil.io" :use [Errno])
(import "coil.result" :use [ok?])
(import "coil.temp" :use [temp-path])
(import "examples.logscan.parse" :use [Truncated BadLatency])
(import "examples.logscan.scan" :use [scan-file])
(import "examples.logscan.stats" :use [Rejection])

(def sample
  "192.0.2.1 - - [10/Oct/2026:13:55:36 +0000] \"GET / HTTP/1.1\" 200 5 \"Firefox\" 30ms
-- MARK --
192.0.2.1 - - [10/Oct/2026:13:55:37 +0000] \"GET /api/cart HTTP/1.1\" 503 5 \"curl/8.4.0\" 900ms
192.0.2.9 - - [10/Oct/2026:13:55:38 +0000] \"GET /app.js HTTP/1.1\" 200 9 \"Firefox\" 7
")

(deftest scans-a-file-line-by-line
  (let [a (malloc-allocator)]
    (match (temp-path "access.txt")
      (Err [_] (assert false))
      (Ok [path]
          (assert (ok? (write-file a path sample)))
          (match (scan-file a path)
            (Err [_] (assert false))
            (Ok [stats]
                (assert-eq (.requests stats) 2)
                (assert-eq (.bots stats) 1)
                (assert-eq (.. stats statuses server-error) 1)
                (assert-eq (.rejected stats) 2)
                (assert-eq (get (.first-rejections stats) 0)
                           (Rejection :line-number 2 :reason (Truncated)))
                (assert-eq (get (.first-rejections stats) 1)
                           (Rejection
                             :line-number 4
                             :reason (BadLatency)))))))))

(deftest a-missing-file-is-an-error
  (match (scan-file (malloc-allocator) "no/such/access.txt")
    (Err [(Errno [_])] 0)
    (_ (assert false))))
