(module examples.logscan.lines-test)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.io" :use [Reader IoError LineTooLong])
(import "coil.mem" :use [mem-copy])
(import "coil.prop" :use *)
(import "coil.slice" :use [slice-data subslice])
(import "examples.logscan.lines" :use *)

;;; An in-memory source that hands out at most `chunk` bytes per read, so the
;;; line reader's refills land mid-line and mid-terminator.
(defstruct ChunkedSource [(data (slice u8)) (position i64) (chunk i64)])

(defn chunked-read [(ctx (ptr i8)) (buf (ptr i8)) (capacity i64)] (-> (Result i64
                                                                              IoError))
  (let [source (cast (ptr ChunkedSource) ctx)
        remaining (- (len (.data source)) (.position source))
        n (min (min capacity (.chunk source)) remaining)]
    (mem-copy (cast (ptr u8) buf)
              (slice-data (subslice (.data source)
                                    (.position source)
                                    (len (.data source))))
              n)
    (set! (.position source) (+ (.position source) n))
    (Ok n)))

(defn min [(a i64) (b i64)] (-> i64)
  (if (< a b) a b))

(defn reader-over [(r (ptr Reader)) (source (mut ChunkedSource))] (-> (ptr Reader))
  (set! (.read-fn r) (fnptr-of chunked-read))
  (set! (.ctx r) (cast (ptr i8) source))
  r)

(defn expect-line [(lines (mut LineReader)) (expected (slice u8))] (-> void)
  (match (next-line! (mut lines))
    (Ok [(Some [line])] (assert-eq line expected))
    (_ (assert false))))

(defn expect-end [(lines (mut LineReader))] (-> void)
  (match (next-line! (mut lines))
    (Ok [(None [])] 0)
    (_ (assert false))))

(deftest splits-lines-across-small-reads
         (let [(mut source)
                 (ChunkedSource
                   :data "first\r\nsecond\n\nlast"
                   :position 0
                   :chunk 3)
               (mut r) (zeroed Reader)]
           (match (line-reader (malloc-allocator)
                               (reader-over (mut r) (mut source))
                               8)
             (Err [_] (assert false))
             (Ok [lines]
                 (let [(mut lines) lines]
                   (expect-line (mut lines) "first")
                   (expect-line (mut lines) "second")
                   (expect-line (mut lines) "")
                   (expect-line (mut lines) "last")
                   (expect-end (mut lines))
                   (expect-end (mut lines)))))))

(deftest a-line-longer-than-the-buffer-is-an-error
         (let [(mut source)
                 (ChunkedSource
                   :data "ok\nmuch too long\n"
                   :position 0
                   :chunk 64)
               (mut r) (zeroed Reader)]
           (match (line-reader (malloc-allocator)
                               (reader-over (mut r) (mut source))
                               8)
             (Err [_] (assert false))
             (Ok [lines]
                 (let [(mut lines) lines]
                   (expect-line (mut lines) "ok")
                   (match (next-line! (mut lines))
                     (Err [(LineTooLong [])] 0)
                     (_ (assert false))))))))

(defn newline? [(b u8)] (-> bool)
  (= b #\newline))

(defprop lines-reassemble-the-input
         [(text (slice u8))]
         (assume (not (any? (fn [b] (= b #\return)) text)))
         (let [(mut source)
                 (ChunkedSource
                   :data text
                   :position 0
                   :chunk (draw-int! (prop-src) 1 16))
               (mut r) (zeroed Reader)
               newlines (count (filter (fn [b] (newline? b)) text))
               unterminated
                 (and (not (empty? text))
                      (not (newline? (get text (- (len text) 1)))))]
           (match (line-reader (malloc-allocator)
                               (reader-over (mut r) (mut source))
                               4096)
             (Err [_] false)
             (Ok [lines]
                 (let [(mut lines) lines
                       (mut seen) 0
                       (mut content) 0]
                   (while (match (next-line! (mut lines))
                            (Ok [(Some [line])]
                                (set! seen (+ seen 1))
                                (set! content (+ content (len line)))
                                true)
                            (_ false)))
                   (and (= seen (+ newlines (if unterminated 1 0)))
                        (= (+ content newlines) (len text))))))))
