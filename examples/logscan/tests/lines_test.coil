(module examples.logscan.lines-test)
(import "coil.io" :use [Reader IoError LineTooLong])
(import "coil.math" :as math)
(import "coil.mem" :use [mem-copy])
(import "coil.prop" :use *)
(import "coil.slice" :use [subslice])
(import "examples.logscan.scan" :use [next-line])

;;; An in-memory source that hands out at most `chunk` bytes per read, so lines
;;; arrive split across reads, even between `\r` and `\n`.
(defstruct ChunkedSource [(data (slice u8)) (position i64) (chunk i64)])

(defn chunked-read [(ctx (ptr i8)) (buf (ptr i8)) (capacity i64)]
  (-> (Result i64 IoError))
  (let [source (cast (ptr ChunkedSource) ctx)
        rest (subslice (.data source) (.position source) (len (.data source)))
        n (math/min (math/min capacity (.chunk source)) (len rest))]
    (mem-copy (cast (ptr u8) buf) (data rest) n)
    (set! (.position source) (+ (.position source) n))
    (Ok n)))

(defn reader-over [(r (ptr Reader)) (source (mut ChunkedSource))]
  (-> (ptr Reader))
  (set! (.read-fn r) (fnptr-of chunked-read))
  (set! (.ctx r) (cast (ptr i8) source))
  r)

(deftest splits-lines-across-small-reads
  (let [(mut source)
          (ChunkedSource
            :data "first\r\nsecond\n\nlast"
            :position 0
            :chunk 3)
        (mut r) (zeroed Reader)
        lines (reader-over (mut r) (mut source))
        (mut buffer) (zeroed (array u8 8))]
    (assert-eq (next-line lines buffer) (Ok (Some "first")))
    (assert-eq (next-line lines buffer) (Ok (Some "second")))
    (assert-eq (next-line lines buffer) (Ok (Some "")))
    (assert-eq (next-line lines buffer) (Ok (Some "last")))
    (assert-eq (next-line lines buffer) (Ok (None)))
    (assert-eq (next-line lines buffer) (Ok (None)))))

(deftest a-line-longer-than-the-buffer-is-an-error
  (let [(mut source)
          (ChunkedSource
            :data "ok\nmuch too long\n"
            :position 0
            :chunk 64)
        (mut r) (zeroed Reader)
        lines (reader-over (mut r) (mut source))
        (mut buffer) (zeroed (array u8 8))]
    (assert-eq (next-line lines buffer) (Ok (Some "ok")))
    (assert-eq (next-line lines buffer) (Err (LineTooLong)))))

(defprop lines-reassemble-the-input [(text (slice u8))]
  (assume (not (any? (fn [b] (= b #\return)) text)))
  (let [(mut source)
          (ChunkedSource
            :data text
            :position 0
            :chunk (draw-int! (prop-src) 1 16))
        (mut r) (zeroed Reader)
        lines (reader-over (mut r) (mut source))
        (mut buffer) (zeroed (array u8 4096))
        newlines (count (filter (fn [b] (= b #\newline)) text))
        unterminated
          (and (not (empty? text))
               (!= (get text (- (len text) 1)) #\newline))
        (mut seen) 0
        (mut content) 0]
    (while-let [(Ok [(Some [line])]) (next-line lines buffer)]
      (set! seen (+ seen 1))
      (set! content (+ content (len line))))
    (and (= seen (+ newlines (if unterminated 1 0)))
         (= (+ content newlines) (len text)))))
