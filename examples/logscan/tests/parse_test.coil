(module examples.logscan.parse-test)
(import "coil.result" :use [ok?])
(import "examples.logscan.parse" :use *)

(def good-line
  "203.0.113.7 - alice [10/Oct/2026:13:55:36 +0000] \"POST /api/orders?id=9 HTTP/1.1\" 201 512 \"Mozilla/5.0 (X11; Linux x86_64)\" 42ms")

(deftest parses-every-field
  (assert-eq (parse-line good-line)
             (Ok (LogLine
                   :address "203.0.113.7"
                   :user "alice"
                   :timestamp "10/Oct/2026:13:55:36 +0000"
                   :method (Post)
                   :path "/api/orders?id=9"
                   :status 201
                   :size 512
                   :agent "Mozilla/5.0 (X11; Linux x86_64)"
                   :latency-ms 42))))

(deftest dash-size-means-no-body
  (match (parse-line "198.51.100.7 - - [10/Oct/2026:13:55:36 +0000] \"HEAD / HTTP/2\" 304 - \"curl/8.4.0\" 1ms")
    (Err [why] (assert false))
    (Ok [entry]
        (assert-eq (.method entry) (Head))
        (assert-eq (.size entry) 0))))

(deftest accepts-ipv6-clients
  (assert (ok? (parse-line "2001:db8::1 - - [10/Oct/2026:13:55:36 +0000] \"GET / HTTP/1.1\" 200 10 \"x\" 3ms"))))

(deftest blank-and-cut-off-lines
  (assert-eq (parse-line "") (Err (Blank)))
  (assert-eq (parse-line "203.0.113.42 - - [10/Oct/2026:14:02:11 +0000] \"GET /app.js HTTP/1.1\" 200")
             (Err (Truncated)))
  (assert-eq (parse-line "-- MARK --") (Err (Truncated)))
  (assert-eq (parse-line "203.0.113.4 - - [10/Oct/2026:14:02:11 +0000] \"GET / HTTP/1.1\" 200 1 \"no closing quote 3ms")
             (Err (Truncated))))

(deftest rejects-bad-fields
  (assert-eq (parse-line "localhost - - [10/Oct/2026:14:05:40 +0000] \"GET / HTTP/1.1\" 200 5 \"x\" 3ms")
             (Err (BadAddress)))
  (assert-eq (parse-line "198.51.100.7 - - [2026-10-10T14:09:12Z] \"GET / HTTP/1.1\" 200 5 \"x\" 3ms")
             (Err (BadTimestamp)))
  (assert-eq (parse-line "203.0.113.88 - - [10/Oct/2026:14:13:00 +0000] \"BREW /coffee HTTP/1.1\" 418 0 \"x\" 1ms")
             (Err (UnknownMethod)))
  (assert-eq (parse-line "203.0.113.4 - - [10/Oct/2026:14:40:20 +0000] \"GET /docs/getting started HTTP/1.1\" 400 3 \"x\" 5ms")
             (Err (BadRequestLine)))
  (assert-eq (parse-line "203.0.113.17 - - [10/Oct/2026:14:20:31 +0000] \"GET /pricing HTTP/1.1\" 2OO 7 \"x\" 22ms")
             (Err (BadStatus)))
  (assert-eq (parse-line "203.0.113.17 - - [10/Oct/2026:14:20:31 +0000] \"GET /pricing HTTP/1.1\" 600 7 \"x\" 22ms")
             (Err (BadStatus)))
  (assert-eq (parse-line "198.51.100.64 - - [10/Oct/2026:14:31:59 +0000] \"GET / HTTP/1.1\" 200 -12 \"x\" 31ms")
             (Err (BadSize)))
  (assert-eq (parse-line "192.0.2.10 - - [10/Oct/2026:14:26:02 +0000] \"GET / HTTP/1.1\" 200 17 \"x\" 2")
             (Err (BadLatency))))
