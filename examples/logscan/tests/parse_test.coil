(module examples.logscan.parse-test)
(import "coil.result" :use [ok?])
(import "examples.logscan.parse" :use *)

(def good-line
  "203.0.113.7 - alice [10/Oct/2026:13:55:36 +0000] \"POST /api/orders?id=9 HTTP/1.1\" 201 512 \"Mozilla/5.0 (X11; Linux x86_64)\" 42ms")

(defn rejected-as? [(line (slice u8)) (expected Malformed)] (-> bool)
  (match (parse-line line)
    (Ok [_] false)
    (Err [why] (= why expected))))

(deftest parses-every-field
         (match (parse-line good-line)
           (Err [why] (assert false))
           (Ok [entry]
               (assert-eq (.address entry) "203.0.113.7")
               (assert-eq (.user entry) "alice")
               (assert-eq (.timestamp entry) "10/Oct/2026:13:55:36 +0000")
               (assert-eq (.method entry) (Post))
               (assert-eq (.path entry) "/api/orders?id=9")
               (assert-eq (.status entry) 201)
               (assert-eq (.size entry) 512)
               (assert-eq (.agent entry) "Mozilla/5.0 (X11; Linux x86_64)")
               (assert-eq (.latency-ms entry) 42))))

(deftest dash-size-means-no-body
         (match (parse-line "198.51.100.7 - - [10/Oct/2026:13:55:36 +0000] \"HEAD / HTTP/2\" 304 - \"curl/8.4.0\" 1ms")
           (Err [why] (assert false))
           (Ok [entry]
               (assert-eq (.method entry) (Head))
               (assert-eq (.size entry) 0))))

(deftest accepts-ipv6-clients
         (assert (ok? (parse-line "2001:db8::1 - - [10/Oct/2026:13:55:36 +0000] \"GET / HTTP/1.1\" 200 10 \"x\" 3ms"))))

(deftest blank-and-cut-off-lines
         (assert (rejected-as? "" (Blank)))
         (assert (rejected-as? "203.0.113.42 - - [10/Oct/2026:14:02:11 +0000] \"GET /app.js HTTP/1.1\" 200"
                               (Truncated)))
         (assert (rejected-as? "-- MARK --" (Truncated)))
         (assert (rejected-as? "203.0.113.4 - - [10/Oct/2026:14:02:11 +0000] \"GET / HTTP/1.1\" 200 1 \"no closing quote 3ms"
                               (Truncated))))

(deftest rejects-bad-fields
         (assert (rejected-as? "localhost - - [10/Oct/2026:14:05:40 +0000] \"GET / HTTP/1.1\" 200 5 \"x\" 3ms"
                               (BadAddress)))
         (assert (rejected-as? "198.51.100.7 - - [2026-10-10T14:09:12Z] \"GET / HTTP/1.1\" 200 5 \"x\" 3ms"
                               (BadTimestamp)))
         (assert (rejected-as? "203.0.113.88 - - [10/Oct/2026:14:13:00 +0000] \"BREW /coffee HTTP/1.1\" 418 0 \"x\" 1ms"
                               (UnknownMethod)))
         (assert (rejected-as? "203.0.113.4 - - [10/Oct/2026:14:40:20 +0000] \"GET /docs/getting started HTTP/1.1\" 400 3 \"x\" 5ms"
                               (BadRequestLine)))
         (assert (rejected-as? "203.0.113.17 - - [10/Oct/2026:14:20:31 +0000] \"GET /pricing HTTP/1.1\" 2OO 7 \"x\" 22ms"
                               (BadStatus)))
         (assert (rejected-as? "203.0.113.17 - - [10/Oct/2026:14:20:31 +0000] \"GET /pricing HTTP/1.1\" 600 7 \"x\" 22ms"
                               (BadStatus)))
         (assert (rejected-as? "198.51.100.64 - - [10/Oct/2026:14:31:59 +0000] \"GET / HTTP/1.1\" 200 -12 \"x\" 31ms"
                               (BadSize)))
         (assert (rejected-as? "192.0.2.10 - - [10/Oct/2026:14:26:02 +0000] \"GET / HTTP/1.1\" 200 17 \"x\" 2"
                               (BadLatency))))
