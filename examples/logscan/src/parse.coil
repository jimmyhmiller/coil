(module examples.logscan.parse)
(import "coil.regex" :as regex)
(import "coil.result" :use [ok-or])
(import "coil.slice" :use [subslice])
(import "coil.str" :use [str-parse-int])
(import "coil.try" :use [try try!])
(import "examples.logscan.lines" :use [index-of-byte])

;;; An HTTP request method. Anything else makes the line malformed.
(defsum Method (Get) (Head) (Post) (Put) (Patch) (Delete) (Options))

(derive Debug Eq Method)

;;; Why a line could not be read as a request. The first failing field wins.
(defsum Malformed
  (Blank)
  (Truncated)
  (BadAddress)
  (BadTimestamp)
  (BadRequestLine)
  (UnknownMethod)
  (BadStatus)
  (BadSize)
  (BadLatency))

(derive Debug Eq Malformed)

(impl Display Malformed
  (display-fmt [(m Malformed) (f (ptr Formatter))]
               (-> i64)
               (fmt (formatter-writer f)
                    "{}"
                    (match m
                      (Blank [] "blank line")
                      (Truncated [] "missing fields")
                      (BadAddress [] "bad client address")
                      (BadTimestamp [] "bad timestamp")
                      (BadRequestLine [] "bad request line")
                      (UnknownMethod [] "unknown method")
                      (BadStatus [] "bad status code")
                      (BadSize [] "bad response size")
                      (BadLatency [] "bad latency")))
               0))

;;; One access-log request. Every slice borrows the line it was parsed from.
(defstruct LogLine
  [(address (slice u8))
   (user (slice u8))
   (timestamp (slice u8))
   (method Method)
   (path (slice u8))
   (status i64)
   (size i64)
   (agent (slice u8))
   (latency-ms i64)])

;;; A field and the text after it.
(defstruct Split [(field (slice u8)) (rest (slice u8))])

;;; Parse one line of the form
;;;
;;;   ADDRESS IDENT USER [TIMESTAMP] "METHOD PATH PROTOCOL" STATUS SIZE "AGENT" LATENCYms
;;;
;;; which is the Common Log Format plus the user agent and a trailing latency.
(defn parse-line [(line (slice u8))] (-> (Result LogLine Malformed))
  (if (empty? line)
      (Err (Blank))
      (try (let [(Split :field address :rest after-address) (try! (word line))
                 (Split :rest after-ident) (try! (word after-address))
                 (Split :field user :rest after-user) (try! (word after-ident))
                 (Split :field timestamp :rest after-time)
                   (try! (delimited after-user #\[ #\]))
                 (Split :field request :rest after-request)
                   (try! (delimited after-time #\" #\"))
                 (Split :field status :rest after-status)
                   (try! (word after-request))
                 (Split :field size :rest after-size) (try! (word after-status))
                 (Split :field agent :rest latency)
                   (try! (delimited after-size #\" #\"))
                 (Request :method method :path path)
                   (try! (parse-request request))]
             (Ok (LogLine
                   :address (try! (check-address address))
                   :user user
                   :timestamp (try! (check-timestamp timestamp))
                   :method method
                   :path path
                   :status (try! (parse-status status))
                   :size (try! (parse-size size))
                   :agent agent
                   :latency-ms (try! (parse-latency latency))))))))

;;; Split at the next space; a field with no space after it is truncated.
(defn word [(s (slice u8))] (-> (Result Split Malformed))
  (ok-or (split-at s #\space) (Truncated)))

(defn split-at [(s (slice u8)) (separator u8)] (-> (Option Split))
  (match (index-of-byte s separator)
    (None [] (None))
    (Some [at]
          (Some (Split :field (subslice s 0 at)
                  :rest (subslice s (+ at 1) (len s)))))))

;;; A field wrapped in OPEN … CLOSE and followed by a space, such as `[…]` or `"…"`.
(defn delimited [(s (slice u8)) (open u8) (close u8)] (-> (Result Split
                                                                  Malformed))
  (if (or (empty? s) (!= (get s 0) open))
      (Err (Truncated))
      (try (let [(Split :field inside :rest after)
                   (try! (ok-or (split-at (subslice s 1 (len s)) close)
                                (Truncated)))]
             (if (and (not (empty? after)) (= (get after 0) #\space))
                 (Ok (Split :field inside :rest (subslice after 1 (len after))))
                 (Err (Truncated)))))))

(defstruct Request [(method Method) (path (slice u8))])

(defn parse-request [(request (slice u8))] (-> (Result Request Malformed))
  (try (let [(Split :field method :rest target)
               (try! (ok-or (split-at request #\space) (BadRequestLine)))
             (Split :field path :rest protocol)
               (try! (ok-or (split-at target #\space) (BadRequestLine)))]
         (if (and (regex/is-match? "^/[!-~]*$" path)
                  (regex/is-match? "^HTTP/\\d(\\.\\d)?$" protocol))
             (Ok (Request :method
                            (try! (ok-or (method-named method) (UnknownMethod)))
                   :path path))
             (Err (BadRequestLine))))))

(defn method-named [(name (slice u8))] (-> (Option Method))
  (cond (= name "GET") (Some (Get))
        (= name "HEAD") (Some (Head))
        (= name "POST") (Some (Post))
        (= name "PUT") (Some (Put))
        (= name "PATCH") (Some (Patch))
        (= name "DELETE") (Some (Delete))
        (= name "OPTIONS") (Some (Options))
        :else (None)))

(defn check-address [(address (slice u8))] (-> (Result (slice u8) Malformed))
  (if (or (regex/is-match? "^\\d{1,3}(\\.\\d{1,3}){3}$" address)
          (regex/is-match? "^[0-9a-fA-F]*:[0-9a-fA-F:]+$" address))
      (Ok address)
      (Err (BadAddress))))

(defn check-timestamp [(timestamp (slice u8))] (-> (Result (slice u8) Malformed))
  (if (regex/is-match? "^\\d\\d/[A-Z][a-z][a-z]/\\d{4}(:\\d\\d){3} [+-]\\d{4}$"
                       timestamp)
      (Ok timestamp)
      (Err (BadTimestamp))))

(defn parse-status [(status (slice u8))] (-> (Result i64 Malformed))
  (if (regex/is-match? "^[1-5]\\d\\d$" status)
      (ok-or (str-parse-int status) (BadStatus))
      (Err (BadStatus))))

;;; `-` is the Common Log Format's spelling of "no body".
(defn parse-size [(size (slice u8))] (-> (Result i64 Malformed))
  (cond (= size "-") (Ok 0)
        (regex/is-match? "^\\d+$" size) (ok-or (str-parse-int size) (BadSize))
        :else (Err (BadSize))))

(defn parse-latency [(latency (slice u8))] (-> (Result i64 Malformed))
  (if (regex/is-match? "^\\d+ms$" latency)
      (ok-or (str-parse-int (subslice latency 0 (- (len latency) 2)))
             (BadLatency))
      (Err (BadLatency))))
