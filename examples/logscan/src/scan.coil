(module examples.logscan.scan)
(import "coil.alloc" :as alloc :use [Allocator])
(import "coil.fs" :as fs)
(import "coil.io"
        :as
        io
        :use
        [Reader BufferedInput IoError LineTooLong OutOfMemory])
(import "coil.result" :use [ok-or])
(import "coil.slice" :use [subslice])
(import "examples.logscan.parse" :use [parse-line])
(import "examples.logscan.stats" :use [Stats stats-new record! reject!])

;;; The longest line accepted; a longer one stops the scan with `LineTooLong`.
(const MAX-LINE 4096)

;;; Stream the access log at PATH, one line at a time, into fresh statistics.
(defn scan-file [(a (dyn Allocator)) (path (slice u8))]
  (-> (Result Stats IoError))
  (try (let [(mut file) (try! (fs/open-file a path fs/O_RDONLY 0))
             (mut source) (zeroed Reader)
             (mut input) (zeroed BufferedInput)]
         (defer (close (mut file)))
         (scan-lines a
                     (io/buffered-input-reader (mut input)
                                               (fs/File::reader (mut source)
                                                                (mut file)))))))

;;; Parse every line LINES yields, counting requests and malformed lines.
(defn scan-lines [(a (dyn Allocator)) (lines (ptr Reader))]
  (-> (Result Stats IoError))
  (try (let [buffer
               (try! (ok-or (alloc/alloc [u8] a (+ MAX-LINE 1)) (OutOfMemory)))
             (mut stats) (stats-new a)
             (mut line-number) 0]
         (defer (alloc/free a buffer))
         (while-let [(Some [line]) (try! (next-line lines buffer))]
           (set! line-number (+ line-number 1))
           (match (parse-line line)
             (Ok [entry] (record! (mut stats) entry))
             (Err [reason] (reject! (mut stats) line-number reason))))
         (Ok stats))))

;;; The next line of LINES without its terminator (`\n` or `\r\n`), or `None` at
;;; the end of input. The line is read into BUFFER and borrows it. A line that
;;; fills BUFFER may not have ended, so it is `(Err (LineTooLong))`.
(defn next-line [(lines (ptr Reader)) (buffer (slice u8))]
  (-> (Result (Option (slice u8)) IoError))
  (match (io/read-line lines (cast (ptr i8) (data buffer)) (len buffer))
    (Err [(Eof [])] (Ok (None)))
    (Err [e] (Err e))
    (Ok [n]
        (if (= n (len buffer))
            (Err (LineTooLong))
            (Ok (Some (without-cr (subslice buffer 0 n))))))))

(defn without-cr [(line (slice u8))] (-> (slice u8))
  (if (and (not (empty? line)) (= (get line (- (len line) 1)) #\return))
      (subslice line 0 (- (len line) 1))
      line))
