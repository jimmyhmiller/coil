(module examples.logscan.scan)
(import "coil.alloc" :as alloc :use [Allocator])
(import "coil.fs" :as fs :use [File])
(import "coil.io" :use [Reader IoError OutOfMemory])
(import "coil.slice" :use [slice-new])
(import "coil.str" :use [str->cstr])
(import "coil.try" :use [try try!])
(import "examples.logscan.lines" :use [LineReader line-reader next-line!])
(import "examples.logscan.parse" :use [parse-line])
(import "examples.logscan.stats" :use [Stats stats-new record! reject!])

;;; The longest line accepted; a longer one stops the scan with `LineTooLong`.
(const MAX-LINE 4096)

;;; Stream the access log at PATH, one line at a time, into fresh statistics.
(defn scan-file [(a (dyn Allocator)) (path (slice u8))] (-> (Result Stats
                                                                    IoError))
  (try (let [(mut file) (try! (open-for-reading a path))]
         (scope :reading
                (defer (fs/file-close (mut file)))
                (let [(mut source) (zeroed Reader)
                      (mut lines)
                        (try! (line-reader a
                                           (fs/file-reader (mut source)
                                                           (mut file))
                                           MAX-LINE))]
                  (scan-lines a (mut lines)))))))

;;; Parse every line of LINES, counting requests and rejected lines.
(defn scan-lines [(a (dyn Allocator)) (lines (mut LineReader))] (-> (Result Stats
                                                                            IoError))
  (try (let [(mut stats) (stats-new a)
             (mut line-number) 0]
         (loop (match (try! (next-line! (mut lines)))
                 (None [] (break))
                 (Some [line]
                       (set! line-number (+ line-number 1))
                       (match (parse-line line)
                         (Ok [entry] (record! (mut stats) entry))
                         (Err [reason] (reject! (mut stats) line-number reason))))))
         (Ok stats))))

;;; `coil.fs/file-open` takes a C string, so PATH is copied into one for the call.
(defn open-for-reading [(a (dyn Allocator)) (path (slice u8))] (-> (Result File
                                                                           IoError))
  (let [c-path (str->cstr a path)]
    (if (= c-path (cast (ptr i8) 0))
        (Err (OutOfMemory))
        (let [opened (fs/file-open c-path fs/O_RDONLY 0)]
          (alloc/free-bytes a
                            (slice-new (cast (ptr u8) c-path) (+ (len path) 1))
                            1)
          opened))))
