(module examples.logscan.lines)
(import "coil.alloc" :as alloc :use [Allocator])
(import "coil.io" :as io :use [Reader IoError LineTooLong OutOfMemory])
(import "coil.result" :use [opt-map])
(import "coil.mem" :use [mem-find-byte mem-move])
(import "coil.slice" :use [slice-data subslice])
(import "coil.try" :use [try try!])

;;; Streams lines out of a `coil.io` Reader through one fixed buffer, so input of
;;; any size is read in large chunks and never held whole. `coil.io/read-line`
;;; issues one `read` per byte; this issues one per buffer refill.
(defstruct LineReader
  [(source (ptr Reader))
   (allocator (dyn Allocator))
   (buffer (slice u8))
   (start i64)
   (end i64)
   (exhausted bool)])

(impl Drop LineReader
  (drop [(self (mut LineReader))]
        (-> void)
        (alloc/free (.allocator self) (.buffer self))))

;;; A reader over SOURCE that accepts lines of up to CAPACITY bytes.
(defn line-reader [(a (dyn Allocator)) (source (ptr Reader)) (capacity i64)] (-> (Result LineReader
                                                                                         IoError))
  (match (alloc/alloc [u8] a capacity)
    (None [] (Err (OutOfMemory)))
    (Some [buffer]
          (Ok (LineReader
                :source source
                :allocator a
                :buffer buffer
                :start 0
                :end 0
                :exhausted false)))))

;;; The next line without its line terminator (`\n` or `\r\n`), or `(None)` at
;;; the end of input. The slice borrows the reader's buffer and is valid only
;;; until the next call. A line longer than the buffer is `(Err (LineTooLong))`.
(defn next-line! [(r (mut LineReader))] (-> (Result (Option (slice u8))
                                                    IoError))
  (loop (match (take-buffered-line! (mut r))
          (Some [line] (break (Ok (Some (without-cr line)))))
          (None []
                (if (.exhausted r)
                    (break (Ok (opt-map (take-rest! (mut r))
                                        (fn [line] (without-cr line)))))
                    (match (refill! (mut r))
                      (Err [e] (break (Err e)))
                      (Ok [_] (continue))))))))

(defn pending [(r (ref LineReader))] (-> (slice u8))
  (subslice (.buffer r) (.start r) (.end r)))

(defn index-of-byte [(s (slice u8)) (byte u8)] (-> (Option i64))
  (let [hit (mem-find-byte (slice-data s) byte (len s))]
    (if (= hit (cast (ptr u8) 0))
        (None)
        (Some (- (cast i64 hit) (cast i64 (slice-data s)))))))

(defn take-buffered-line! [(r (mut LineReader))] (-> (Option (slice u8)))
  (let [unread (pending r)]
    (match (index-of-byte unread #\newline)
      (None [] (None))
      (Some [at]
            (set! (.start r) (+ (.start r) at 1))
            (Some (subslice unread 0 at))))))

;;; A final line that has no trailing newline.
(defn take-rest! [(r (mut LineReader))] (-> (Option (slice u8)))
  (let [unread (pending r)]
    (if (empty? unread)
        (None)
        (do (set! (.start r) (.end r)) (Some unread)))))

(defn without-cr [(line (slice u8))] (-> (slice u8))
  (if (and (not (empty? line)) (= (get line (- (len line) 1)) #\return))
      (subslice line 0 (- (len line) 1))
      line))

;;; Slide the unread bytes to the front of the buffer, then read more after them.
(defn refill! [(r (mut LineReader))] (-> (Result i64 IoError))
  (let [unread (len (pending r))]
    (mem-move (slice-data (.buffer r)) (slice-data (pending r)) unread)
    (set! (.start r) 0)
    (set! (.end r) unread))
  (let [space (subslice (.buffer r) (.end r) (len (.buffer r)))]
    (if (empty? space)
        (Err (LineTooLong))
        (try (let [n
                     (try! (io/read-some (.source r)
                                         (cast (ptr i8) (slice-data space))
                                         (len space)))]
               (if (= n 0)
                   (set! (.exhausted r) true)
                   (set! (.end r) (+ (.end r) n)))
               (Ok n))))))
