(module examples.logscan.report)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [al-free!])
(import "examples.logscan.stats" :as stats :use [Stats])

;;; How many routes the report lists.
(const TOP-ROUTES 5)

;;; Print the report for STATS, which has scanned the log at PATH. Sorts the
;;; recorded latencies in place.
(defn print-report [(a (dyn Allocator)) (path (slice u8)) (s (mut Stats))]
  (-> void)
  (println "{}: {} requests, {} malformed lines"
           path
           (.requests s)
           (.rejected s))
  (print-statuses s)
  (print-kinds s)
  (print-routes a s)
  (println "")
  (println "bots        {} of {} requests ({:.1}%)"
           (.bots s)
           (.requests s)
           (percent (.bots s) (.requests s)))
  (print-latency (mut s))
  (print-rejections s))

(defn print-statuses [(s (ref Stats))] (-> void)
  (let [t (.statuses s)]
    (println "")
    (println "status")
    (print-share "1xx informational" (.informational t) (.requests s))
    (print-share "2xx success" (.success t) (.requests s))
    (print-share "3xx redirection" (.redirection t) (.requests s))
    (print-share "4xx client error" (.client-error t) (.requests s))
    (print-share "5xx server error" (.server-error t) (.requests s))))

(defn print-kinds [(s (ref Stats))] (-> void)
  (let [k (.kinds s)]
    (println "")
    (println "paths")
    (print-share "api" (.api k) (.requests s))
    (print-share "static assets" (.asset k) (.requests s))
    (print-share "pages" (.page k) (.requests s))))

(defn print-share [(label (slice u8)) (count i64) (total i64)] (-> void)
  (println "  {:<18} {:>5} {:>6.1}%" label count (percent count total)))

(defn percent [(part i64) (total i64)] (-> f64)
  (if (= total 0) 0.0 (/ (* 100.0 (cast f64 part)) (cast f64 total))))

(defn print-routes [(a (dyn Allocator)) (s (ref Stats))] (-> void)
  (let [(mut ranked) (stats/ranked-routes a s)]
    (println "")
    (println "top routes")
    (for (stats/RouteHits :route route :hits hits) (take TOP-ROUTES ranked)
      (println "  {:<30} {:>5}" route hits))
    (al-free! (mut ranked))))

(defn print-latency [(s (mut Stats))] (-> void)
  (match (stats/latency-summary (stats/sorted-latencies! (mut s)))
    (None [] (println "latency     no requests"))
    (Some [(stats/LatencySummary
             :p50 p50
             :p90 p90
             :p99 p99
             :max slowest)]
          (println "latency     p50 {}ms  p90 {}ms  p99 {}ms  max {}ms"
                   p50
                   p90
                   p99
                   slowest))))

(defn print-rejections [(s (ref Stats))] (-> void)
  (when (> (.rejected s) 0)
    (println "")
    (println "malformed (first {} of {})"
             (len (.first-rejections s))
             (.rejected s))
    (for (stats/Rejection :line-number n :reason reason) (.first-rejections s)
      (println "  line {:>4}: {}" n reason))))
