;;; logscan: an access-log analyzer.
;;;
;;; Streams an access log through a `coil.io` Reader one line at a time, parses
;;; each line into a `LogLine` (or a `Malformed` reason), and reports requests per
;;; status class and path kind, the busiest routes, the share of bot traffic, and
;;; latency percentiles. Field validation, path classification and bot detection
;;; use `coil.regex/is-match?`, and routes are split into segments with
;;; `coil.regex/find-iter`; each pattern is compiled with this program into an
;;; allocation-free state machine.
;;;
;;;   coil run examples/logscan                 # the bundled data/access.txt
;;;   coil run examples/logscan -- FILE         # FILE is read relative to examples/logscan
;;;
;;; Sample output:
;;;
;;;   data/access.txt: 420 requests, 10 malformed lines
;;;
;;;   status
;;;     1xx informational      0    0.0%
;;;     2xx success          336   80.0%
;;;     3xx redirection       45   10.7%
;;;     4xx client error      23    5.5%
;;;     5xx server error      16    3.8%
;;;
;;;   paths
;;;     api                  192   45.7%
;;;     static assets        118   28.1%
;;;     pages                110   26.2%
;;;
;;;   top routes
;;;     /api/cart                         46
;;;     /api/health                       42
;;;     /api/users/:id                    40
;;;     /api/search                       37
;;;     /api/orders/:id                   27
;;;
;;;   bots        88 of 420 requests (21.0%)
;;;   latency     p50 16ms  p90 115ms  p99 3501ms  max 3688ms
;;;
;;;   malformed (first 5 of 10)
;;;     line   32: missing fields
;;;     line   57: bad client address
;;;     line   85: bad timestamp
;;;     line  106: unknown method
;;;     line  123: blank line
(module examples.logscan.main)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.args" :use [init! count nth])
(import "coil.io" :use [IoError LineTooLong])
(import "examples.logscan.report" :use [print-report])
(import "examples.logscan.scan" :use [scan-file MAX-LINE])

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (init! argc argv)
  (let [a (malloc-allocator)
        path (if (> (count) 1) (nth 1) "data/access.txt")]
    (match (scan-file a path)
      (Ok [(mut stats)] (print-report a path (mut stats)) 0)
      (Err [e] (report-error path e) 1))))

(defn report-error [(path (slice u8)) (e IoError)] (-> void)
  (match e
    (LineTooLong []
                 (eprintln "logscan: {}: a line is longer than {} bytes"
                           path
                           MAX-LINE))
    (_ (eprintln "logscan: {}: {}" path e))))
