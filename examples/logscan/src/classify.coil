(module examples.logscan.classify)
(import "coil.arraylist" :use [ArrayList])
(import "coil.regex" :as regex :use [span-bytes])
(import "coil.slice" :use [subslice])

;;; The hundreds digit of an HTTP status code.
(defsum StatusClass
  (Informational)
  (Success)
  (Redirection)
  (ClientError)
  (ServerError))

(derive Debug Eq StatusClass)

;;; Class of STATUS, which `parse-line` has already checked lies in 100–599.
(defn status-class [(status i64)] (-> StatusClass)
  (cond (< status 200) (Informational)
        (< status 300) (Success)
        (< status 400) (Redirection)
        (< status 500) (ClientError)
        :else (ServerError)))

;;; What a request path asks for.
(defsum PathKind (Api) (Asset) (Page))

(derive Debug Eq PathKind)

(defn path-kind [(path (slice u8))] (-> PathKind)
  (cond (regex/is-match? "^/api(/|\\?|$)" path) (Api)
        (regex/is-match? "(?i:\\.(css|js|png|jpe?g|gif|svg|ico|woff2?))(\\?|$)"
                         path)
          (Asset)
        :else (Page)))

;;; Whether AGENT identifies a crawler or a scripted client rather than a person.
(defn bot? [(agent (slice u8))] (-> bool)
  (regex/is-match? "(?i:bot|crawl|spider|curl|wget|python-requests)" agent))

;;; Append PATH's route to OUT: the query string is dropped and every all-digit
;;; segment becomes `:id`, so `/api/users/42?x=1` and `/api/users/7` share a route.
(defn push-route! [(out (mut (ArrayList u8))) (path (slice u8))] (-> void)
  (let [route (if-let [(Some [at]) (find path "?")] (subslice path 0 at) path)]
    (for span (regex/find-iter "/[^/]*" route)
      (let [segment (span-bytes route span)]
        (push-bytes! (mut out)
                     (if (regex/is-match? "^/\\d+$" segment) "/:id" segment))))))

(defn push-bytes! [(out (mut (ArrayList u8))) (bytes (slice u8))] (-> void)
  (extend! (mut out) (data bytes) (len bytes)))
