(module examples.logscan.stats)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.fixedlist" :use [InlineList full?])
(import "coil.hashmap" :use [HashMap])
(import "coil.math" :as math)
(import "coil.result" :use [unwrap-or])
(import "coil.slice" :use [sort])
(import "coil.str" :use [str-cmp str-keyops])
(import "examples.logscan.classify" :as classify :use [StatusClass PathKind])
(import "examples.logscan.parse" :use [LogLine Malformed])

;;; Requests per status class.
(defstruct StatusTally
  [(informational i64)
   (success i64)
   (redirection i64)
   (client-error i64)
   (server-error i64)])

;;; Requests per kind of path.
(defstruct KindTally [(api i64) (asset i64) (page i64)])

;;; A line that did not parse, by its 1-based number in the input.
(defstruct Rejection [(line-number i64) (reason Malformed)])

(derive Debug Eq Rejection)

;;; Everything the report needs, accumulated one line at a time. `routes` owns
;;; copies of its keys; `route-scratch` is reused to build each line's route.
(defstruct Stats
  [(requests i64)
   (bots i64)
   (statuses StatusTally)
   (kinds KindTally)
   (routes (HashMap (slice u8) i64))
   (route-scratch (ArrayList u8))
   (latencies (ArrayList i64))
   (rejected i64)
   (first-rejections (InlineList Rejection 5))])

(impl Drop Stats
  (drop [(self (mut Stats))]
    (-> void)
    (free! (mut (.routes self)))
    (free! (mut (.route-scratch self)))
    (free! (mut (.latencies self)))))

(defn stats-new [(a (dyn Allocator))] (-> Stats)
  (Stats
    :requests 0
    :bots 0
    :statuses (zeroed StatusTally)
    :kinds (zeroed KindTally)
    :routes (HashMap::new [(slice u8) i64] a (str-keyops))
    :route-scratch (ArrayList::new [u8] a)
    :latencies (ArrayList::new [i64] a)
    :rejected 0
    :first-rejections (InlineList::new [Rejection 5])))

;;; Count one well-formed request.
(defn record! [(s (mut Stats)) (entry LogLine)] (-> void)
  (set! (.requests s) (+ (.requests s) 1))
  (when (classify/bot? (.agent entry))
    (set! (.bots s) (+ (.bots s) 1)))
  (tally-status! (mut (.statuses s)) (classify/status-class (.status entry)))
  (tally-kind! (mut (.kinds s)) (classify/path-kind (.path entry)))
  (count-route! (mut s) (.path entry))
  (push! (mut (.latencies s)) (.latency-ms entry)))

;;; Count one malformed line, keeping the first few for the report.
(defn reject! [(s (mut Stats)) (line-number i64) (reason Malformed)] (-> void)
  (set! (.rejected s) (+ (.rejected s) 1))
  (unless (full? (.first-rejections s))
    (push! (mut (.first-rejections s))
           (Rejection :line-number line-number :reason reason))))

(defn tally-status! [(t (mut StatusTally)) (class StatusClass)] (-> void)
  (match class
    (classify/Informational []
                            (set! (.informational t) (+ (.informational t) 1)))
    (classify/Success [] (set! (.success t) (+ (.success t) 1)))
    (classify/Redirection [] (set! (.redirection t) (+ (.redirection t) 1)))
    (classify/ClientError [] (set! (.client-error t) (+ (.client-error t) 1)))
    (classify/ServerError [] (set! (.server-error t) (+ (.server-error t) 1)))))

(defn tally-kind! [(t (mut KindTally)) (kind PathKind)] (-> void)
  (match kind
    (classify/Api [] (set! (.api t) (+ (.api t) 1)))
    (classify/Asset [] (set! (.asset t) (+ (.asset t) 1)))
    (classify/Page [] (set! (.page t) (+ (.page t) 1)))))

(defn count-route! [(s (mut Stats)) (path (slice u8))] (-> void)
  (clear! (mut (.route-scratch s)))
  (classify/push-route! (mut (.route-scratch s)) path)
  (let [route (slice (.route-scratch s))]
    (set! (mut (.routes s)) route (+ (unwrap-or (get (.routes s) route) 0) 1))))

;;; The nearest-rank P-th percentile (0 < P <= 100) of SORTED, which must be in
;;; ascending order, or `(None)` when it is empty.
(defn percentile [(sorted (slice i64)) (p i64)] (-> (Option i64))
  (if (empty? sorted)
      (None)
      (let [rank (/ (+ (* p (len sorted)) 99) 100)]
        (Some (get sorted (- (math/max rank 1) 1))))))

;;; The latency percentiles the report prints, in milliseconds.
(defstruct LatencySummary [(p50 i64) (p90 i64) (p99 i64) (max i64)])

(derive Debug Eq LatencySummary)

;;; Summarize SORTED, which must be in ascending order; `(None)` when it is empty.
(defn latency-summary [(sorted (slice i64))] (-> (Option LatencySummary))
  (try (Some (LatencySummary
               :p50 (try? (percentile sorted 50))
               :p90 (try? (percentile sorted 90))
               :p99 (try? (percentile sorted 99))
               :max (try? (percentile sorted 100))))))

;;; The recorded latencies in ascending order. Sorts in place.
(defn sorted-latencies! [(s (mut Stats))] (-> (slice i64))
  (let [latencies (slice (.latencies s))]
    (sort latencies (fn [a b] (- a b)))
    latencies))

;;; A route and how many requests it received.
(defstruct RouteHits [(route (slice u8)) (hits i64)])

(derive Debug Eq RouteHits)

;;; The routes by descending hit count, ties in byte order, in a list allocated
;;; from A that the caller frees. Each route borrows a key of `(.routes s)`.
(defn ranked-routes [(a (dyn Allocator)) (s (ref Stats))]
  (-> (ArrayList RouteHits))
  (let [(mut ranked) (ArrayList::new [RouteHits] a)]
    (for route (.routes s)
      (push! (mut ranked)
             (RouteHits
               :route route
               :hits (unwrap-or (get (.routes s) route) 0))))
    (sort (slice ranked)
          (fn [x y]
            (if (= (.hits x) (.hits y))
                (str-cmp (.route x) (.route y))
                (- (.hits y) (.hits x)))))
    ranked))
