diff --git a/llvm/lib/Target/WebAssembly/MCTargetDesc/WebAssemblyMCCodeEmitter.cpp b/llvm/lib/Target/WebAssembly/MCTargetDesc/WebAssemblyMCCodeEmitter.cpp
index a0280907a..21839226c 100644
--- a/llvm/lib/Target/WebAssembly/MCTargetDesc/WebAssemblyMCCodeEmitter.cpp
+++ b/llvm/lib/Target/WebAssembly/MCTargetDesc/WebAssemblyMCCodeEmitter.cpp
@@ -113,7 +113,28 @@ void WebAssemblyMCCodeEmitter::encodeInstruction(
   raw_svector_ostream OS(CB);
   uint64_t Start = OS.tell();
 
-  uint64_t Binary = getBinaryCodeForInstr(MI, Fixups, STI);
+  unsigned Opcode = MI.getOpcode();
+  // Reference-select opcodes carry their result type in the instruction name,
+  // rather than an explicit MC operand. References cannot use the MVP select:
+  // encode the typed select and its single-element result-type vector.
+  unsigned SelectType = 0;
+  switch (Opcode) {
+  case WebAssembly::SELECT_FUNCREF:
+  case WebAssembly::SELECT_FUNCREF_S:
+    SelectType = wasm::WASM_TYPE_FUNCREF;
+    break;
+  case WebAssembly::SELECT_EXTERNREF:
+  case WebAssembly::SELECT_EXTERNREF_S:
+    SelectType = wasm::WASM_TYPE_EXTERNREF;
+    break;
+  case WebAssembly::SELECT_EXNREF:
+  case WebAssembly::SELECT_EXNREF_S:
+    SelectType = wasm::WASM_TYPE_EXNREF;
+    break;
+  default:
+    break;
+  }
+  uint64_t Binary = SelectType ? 0x1c : getBinaryCodeForInstr(MI, Fixups, STI);
   if (Binary < (1 << 8)) {
     OS << uint8_t(Binary);
   } else if (Binary < (1 << 16)) {
@@ -126,10 +147,14 @@ void WebAssemblyMCCodeEmitter::encodeInstruction(
     llvm_unreachable("Very large (prefix + 3 byte) opcodes not supported");
   }
 
+  if (SelectType) {
+    encodeULEB128(1, OS);
+    OS << uint8_t(SelectType);
+  }
+
   // For br_table instructions, encode the size of the table. In the MCInst,
   // there's an index operand (if not a stack instruction), one operand for
   // each table entry, and the default operand.
-  unsigned Opcode = MI.getOpcode();
   if (Opcode == WebAssembly::BR_TABLE_I32_S ||
       Opcode == WebAssembly::BR_TABLE_I64_S)
     encodeULEB128(MI.getNumOperands() - 1, OS);
