# x86-64: registers and the instructions the backend emits.
bytes
align 16

class gpr 4
reg rax rcx rdx rbx rsp rbp rsi rdi : gpr
reg r8..r15 : gpr

class simd 4
reg xmm0..xmm15 : simd

set allocatable  = rax rcx rdx rbx rsi rdi r8 r9 r12..r15 xmm0..xmm14
set caller-saved = rax rcx rdx rsi rdi r8..r11 xmm0..xmm15
set callee-saved = rbx r12..r15

# Registers the emitter may use to open a ring of copies, or to pass a word
# along through.
const scratch0 = 11
const scratch1 = 10
const fscratch = 47
# Machine code is bytes.
# A switch goes by comparing with each case; this machine's tables are not described.
const tables = 0
const code-unit = 1

# Condition codes.
const overflow = 0
const no-overflow = 1
const below = 2
const above-equal = 3
const equal = 4
const not-equal = 5
const below-equal = 6
const above = 7
const parity = 10
const no-parity = 11
const less = 12
const greater-equal = 13
const less-equal = 14
const greater = 15
const sign = 8

# The prefix that widens an operation to 64 bits and reaches registers 8 to 15:
# needed only when it does either. `rex8` is always written, which is what
# makes the low byte of rsi, rdi, rsp and rbp nameable.
form rex(w, reg, rm) when w == 1 or (reg >> 3) & 1 == 1 or (rm >> 3) & 1 == 1 = byte(0x40 | w << 3 | ((reg >> 3) & 1) << 2 | (rm >> 3) & 1)
form rex(w, reg, rm) = nothing
form rex8(w, reg, rm) = byte(0x40 | w << 3 | ((reg >> 3) & 1) << 2 | (rm >> 3) & 1)

# Two registers, or a register and an operation's extra opcode bits.
form modrm(reg, rm) = byte(0xC0 | (reg & 7) << 3 | rm & 7)

# A register and the memory at base + disp. rsp and r12 as a base take a second
# byte; rbp and r13 always take a displacement.
form mem(reg, base, disp) when base & 7 == 4 and disp == 0       = byte((reg & 7) << 3 | 4) byte(0x24)
form mem(reg, base, disp) when base & 7 == 4 and s8(disp)        = byte(0x40 | (reg & 7) << 3 | 4) byte(0x24) byte(disp)
form mem(reg, base, disp) when base & 7 == 4                     = byte(0x80 | (reg & 7) << 3 | 4) byte(0x24) le32(disp)
form mem(reg, base, disp) when disp == 0 and base & 7 != 5       = byte((reg & 7) << 3 | base & 7)
form mem(reg, base, disp) when s8(disp)                          = byte(0x40 | (reg & 7) << 3 | base & 7) byte(disp)
form mem(reg, base, disp)                                        = byte(0x80 | (reg & 7) << 3 | base & 7) le32(disp)

# The same with an index register besides: the prefix names all three, and
# the memory is at base + (index << scale) + disp, which takes a second byte.
form rexx(w, reg, index, base) when w == 1 or (reg >> 3) & 1 == 1 or (index >> 3) & 1 == 1 or (base >> 3) & 1 == 1 = byte(0x40 | w << 3 | ((reg >> 3) & 1) << 2 | ((index >> 3) & 1) << 1 | (base >> 3) & 1)
form rexx(w, reg, index, base) = nothing
form memx(reg, base, index, scale, disp) when disp == 0 and base & 7 != 5 = byte((reg & 7) << 3 | 4) byte(scale << 6 | (index & 7) << 3 | base & 7)
form memx(reg, base, index, scale, disp) when s8(disp)                    = byte(0x40 | (reg & 7) << 3 | 4) byte(scale << 6 | (index & 7) << 3 | base & 7) byte(disp)
form memx(reg, base, index, scale, disp)                                  = byte(0x80 | (reg & 7) << 3 | 4) byte(scale << 6 | (index & 7) << 3 | base & 7) le32(disp)

# A register onto the stack, the stack pointer going down by eight.
inst push(src: use gpr)                              = rex(0, 0, src) byte(0x50 | src & 7)

# Copies and constants. `w` picks 64-bit (1) or 32-bit (0) registers; a 32-bit
# write clears the upper half.
inst mov(w: u1, dst: def gpr, src: use gpr)          = rex(w, src, dst) byte(0x89) modrm(src, dst)
inst mov-imm32(dst: def gpr, imm: u32)               = rex(0, 0, dst) byte(0xB8 | dst & 7) le32(imm)
inst mov-simm32(dst: def gpr, imm: s32)              = rex(1, 0, dst) byte(0xC7) modrm(0, dst) le32(imm)
inst mov-imm64(dst: def gpr, imm: s64)               = rex(1, 0, dst) byte(0xB8 | dst & 7) le64(imm)

# Arithmetic: the first operand is also the result.
inst add(w: u1, dst: mod gpr, src: use gpr)          = rex(w, src, dst) byte(0x01) modrm(src, dst)
inst or(w: u1, dst: mod gpr, src: use gpr)           = rex(w, src, dst) byte(0x09) modrm(src, dst)
inst and(w: u1, dst: mod gpr, src: use gpr)          = rex(w, src, dst) byte(0x21) modrm(src, dst)
inst sub(w: u1, dst: mod gpr, src: use gpr)          = rex(w, src, dst) byte(0x29) modrm(src, dst)
inst xor(w: u1, dst: mod gpr, src: use gpr)          = rex(w, src, dst) byte(0x31) modrm(src, dst)
# With the carry: the high halves of a wider sum or difference.
inst adc(w: u1, dst: mod gpr, src: use gpr)          = rex(w, src, dst) byte(0x11) modrm(src, dst)
inst sbb(w: u1, dst: mod gpr, src: use gpr)          = rex(w, src, dst) byte(0x19) modrm(src, dst)
inst cmp(w: u1, x: use gpr, y: use gpr)              = rex(w, y, x) byte(0x39) modrm(y, x)
inst test(w: u1, x: use gpr, y: use gpr)             = rex(w, y, x) byte(0x85) modrm(y, x)
inst add-imm(w: u1, dst: mod gpr, imm: s32)          = rex(w, 0, dst) byte(0x81) modrm(0, dst) le32(imm)
inst or-imm(w: u1, dst: mod gpr, imm: s32)           = rex(w, 0, dst) byte(0x81) modrm(1, dst) le32(imm)
inst and-imm(w: u1, dst: mod gpr, imm: s32)          = rex(w, 0, dst) byte(0x81) modrm(4, dst) le32(imm)
inst sub-imm(w: u1, dst: mod gpr, imm: s32)          = rex(w, 0, dst) byte(0x81) modrm(5, dst) le32(imm)
inst xor-imm(w: u1, dst: mod gpr, imm: s32)          = rex(w, 0, dst) byte(0x81) modrm(6, dst) le32(imm)
inst cmp-imm(w: u1, x: use gpr, imm: s32)            = rex(w, 0, x) byte(0x81) modrm(7, x) le32(imm)
inst imul(w: u1, dst: mod gpr, src: use gpr)         = rex(w, dst, src) byte(0x0F) byte(0xAF) modrm(dst, src)
inst neg(w: u1, dst: mod gpr)                        = rex(w, 0, dst) byte(0xF7) modrm(3, dst)
inst not(w: u1, dst: mod gpr)                        = rex(w, 0, dst) byte(0xF7) modrm(2, dst)

# Shifts by the count in rcx, which the machine takes modulo the width.
inst shl-cl(w: u1, dst: mod gpr)                     = rex(w, 0, dst) byte(0xD3) modrm(4, dst)   reads rcx
inst shr-cl(w: u1, dst: mod gpr)                     = rex(w, 0, dst) byte(0xD3) modrm(5, dst)   reads rcx
inst sar-cl(w: u1, dst: mod gpr)                     = rex(w, 0, dst) byte(0xD3) modrm(7, dst)   reads rcx

# Shifts by a constant count.
inst shl-imm(w: u1, dst: mod gpr, count: u6)         = rex(w, 0, dst) byte(0xC1) modrm(4, dst) byte(count)
inst shr-imm(w: u1, dst: mod gpr, count: u6)         = rex(w, 0, dst) byte(0xC1) modrm(5, dst) byte(count)
inst sar-imm(w: u1, dst: mod gpr, count: u6)         = rex(w, 0, dst) byte(0xC1) modrm(7, dst) byte(count)

# Division of rdx:rax, leaving the quotient in rax and the remainder in rdx.
inst sign-extend-rax(w: u1)                          = rex(w, 0, 0) byte(0x99)                   reads rax writes rdx
inst div(w: u1, src: use gpr)                        = rex(w, 0, src) byte(0xF7) modrm(6, src)   reads rax rdx writes rax rdx
inst idiv(w: u1, src: use gpr)                       = rex(w, 0, src) byte(0xF7) modrm(7, src)   reads rax rdx writes rax rdx

# Widths.
inst movzx8(dst: def gpr, src: use gpr)              = rex8(0, dst, src) byte(0x0F) byte(0xB6) modrm(dst, src)
inst movzx16(dst: def gpr, src: use gpr)             = rex(0, dst, src) byte(0x0F) byte(0xB7) modrm(dst, src)
inst movsx8(w: u1, dst: def gpr, src: use gpr)       = rex8(w, dst, src) byte(0x0F) byte(0xBE) modrm(dst, src)
inst movsx16(w: u1, dst: def gpr, src: use gpr)      = rex(w, dst, src) byte(0x0F) byte(0xBF) modrm(dst, src)
inst movsx32(dst: def gpr, src: use gpr)             = rex(1, dst, src) byte(0x63) modrm(dst, src)

# Conditions.
inst setcc(cond: u4, dst: def gpr)                   = rex8(0, 0, dst) byte(0x0F) byte(0x90 | cond) modrm(0, dst)
inst cmov(w: u1, cond: u4, dst: mod gpr, src: use gpr) = rex(w, dst, src) byte(0x0F) byte(0x40 | cond) modrm(dst, src)

# Control. A label is a distance in bytes from the end of the instruction.
inst jmp(to: label)                                  = byte(0xE9) rel32(to)
inst jcc(cond: u4, to: label)                        = byte(0x0F) byte(0x80 | cond) rel32(to)   opposite cond
inst ret()                                           = byte(0xC3)
# Machine code given as it is.
inst raw(bits: u8)                                   = byte(bits)
inst ud2()                                           = byte(0x0F) byte(0x0B)
inst jmp-reg(f: use gpr)                             = rex(0, 0, f) byte(0xFF) modrm(4, f)
inst jmp-symbol(to: symbol)                          = byte(0xE9) sym32(to)                                        reloc plt32 = S - P - 4
inst call-reg(f: use gpr)                            = rex(0, 0, f) byte(0xFF) modrm(2, f)

# Symbols. S is the symbol's address, G the address of its slot in the table of
# addresses, P the address of the four bytes being filled in.
inst call(to: symbol)                                = byte(0xE8) sym32(to)                                        reloc plt32 = S - P - 4
inst lea-symbol(dst: def gpr, to: symbol)            = rex(1, dst, 0) byte(0x8D) byte((dst & 7) << 3 | 5) sym32(to) reloc pc32 = S - P - 4
inst mov-got(dst: def gpr, to: symbol)               = rex(1, dst, 0) byte(0x8B) byte((dst & 7) << 3 | 5) sym32(to) reloc gotpcrel = G - P - 4

# Bits.
inst lzcnt(w: u1, dst: def gpr, src: use gpr)        = byte(0xF3) rex(w, dst, src) byte(0x0F) byte(0xBD) modrm(dst, src)
inst tzcnt(w: u1, dst: def gpr, src: use gpr)        = byte(0xF3) rex(w, dst, src) byte(0x0F) byte(0xBC) modrm(dst, src)
inst popcnt(w: u1, dst: def gpr, src: use gpr)       = byte(0xF3) rex(w, dst, src) byte(0x0F) byte(0xB8) modrm(dst, src)
inst bswap(w: u1, dst: mod gpr)                      = rex(w, 0, dst) byte(0x0F) byte(0xC8 | dst & 7)
inst rol-cl(w: u1, dst: mod gpr)                     = rex(w, 0, dst) byte(0xD3) modrm(0, dst)   reads rcx
inst ror-cl(w: u1, dst: mod gpr)                     = rex(w, 0, dst) byte(0xD3) modrm(1, dst)   reads rcx
# rdx:rax = rax * src, unsigned and signed.
inst mul-wide(w: u1, src: use gpr)                   = rex(w, 0, src) byte(0xF7) modrm(4, src)   reads rax writes rax rdx
inst imul-wide(w: u1, src: use gpr)                  = rex(w, 0, src) byte(0xF7) modrm(5, src)   reads rax writes rax rdx

# Floating point, on the low element of a vector register. `ty` picks double
# (1) or single (0), which is a different first byte.
form scalar(ty) when ty == 1 = byte(0xF2)
form scalar(ty)              = byte(0xF3)
form packed(ty) when ty == 1 = byte(0x66)
form packed(ty)              = nothing
inst movaps(dst: def simd, src: use simd)            = rex(0, dst, src) byte(0x0F) byte(0x28) modrm(dst, src)
inst addf(ty: u1, dst: mod simd, src: use simd)      = scalar(ty) rex(0, dst, src) byte(0x0F) byte(0x58) modrm(dst, src)
inst mulf(ty: u1, dst: mod simd, src: use simd)      = scalar(ty) rex(0, dst, src) byte(0x0F) byte(0x59) modrm(dst, src)
inst subf(ty: u1, dst: mod simd, src: use simd)      = scalar(ty) rex(0, dst, src) byte(0x0F) byte(0x5C) modrm(dst, src)
inst divf(ty: u1, dst: mod simd, src: use simd)      = scalar(ty) rex(0, dst, src) byte(0x0F) byte(0x5E) modrm(dst, src)
inst sqrtf(ty: u1, dst: def simd, src: use simd)     = scalar(ty) rex(0, dst, src) byte(0x0F) byte(0x51) modrm(dst, src)
inst xorf(dst: mod simd, src: use simd)              = byte(0x66) rex(0, dst, src) byte(0x0F) byte(0x57) modrm(dst, src)
# dst = src with the bits of dst cleared.
inst andnotf(dst: mod simd, src: use simd)           = byte(0x66) rex(0, dst, src) byte(0x0F) byte(0x55) modrm(dst, src)
inst andf(dst: mod simd, src: use simd)              = byte(0x66) rex(0, dst, src) byte(0x0F) byte(0x54) modrm(dst, src)
inst orf(dst: mod simd, src: use simd)               = byte(0x66) rex(0, dst, src) byte(0x0F) byte(0x56) modrm(dst, src)
# The smaller and the larger; src when the two are equal or either is not a number.
inst minf(ty: u1, dst: mod simd, src: use simd)      = scalar(ty) rex(0, dst, src) byte(0x0F) byte(0x5D) modrm(dst, src)
inst maxf(ty: u1, dst: mod simd, src: use simd)      = scalar(ty) rex(0, dst, src) byte(0x0F) byte(0x5F) modrm(dst, src)
# Every bit of dst set if either is not a number, and cleared otherwise.
inst unordered(ty: u1, dst: mod simd, src: use simd) = scalar(ty) rex(0, dst, src) byte(0x0F) byte(0xC2) modrm(dst, src) byte(3)
# To a whole number: `mode` 0 nearest even, 1 down, 2 up, 3 toward zero.
inst roundf(ty: u1, mode: u2, dst: def simd, src: use simd) = byte(0x66) rex(0, dst, src) byte(0x0F) byte(0x3A) byte(0x0A | ty) modrm(dst, src) byte(8 | mode)
# dst = x * dst + y, rounded once. The prefix names all three registers.
form vex(w, reg, other, rm) = byte(0xC4) byte((1 - ((reg >> 3) & 1)) << 7 | 0x40 | (1 - ((rm >> 3) & 1)) << 5 | 2) byte(w << 7 | (15 - (other & 15)) << 3 | 1)
inst fma(ty: u1, dst: mod simd, x: use simd, y: use simd) = vex(ty, dst, x, y) byte(0xA9) modrm(dst, y)
# Compare, into the flags: equal, below and parity all set when either is not a number.
inst cmpf(ty: u1, x: use simd, y: use simd)          = packed(ty) rex(0, x, y) byte(0x0F) byte(0x2E) modrm(x, y)
inst single-to-double(dst: def simd, src: use simd)  = byte(0xF3) rex(0, dst, src) byte(0x0F) byte(0x5A) modrm(dst, src)
inst double-to-single(dst: def simd, src: use simd)  = byte(0xF2) rex(0, dst, src) byte(0x0F) byte(0x5A) modrm(dst, src)
# Between integers and floating point: `w` is the integer's width.
inst int-to-float(w: u1, ty: u1, dst: def simd, src: use gpr)  = scalar(ty) rex(w, dst, src) byte(0x0F) byte(0x2A) modrm(dst, src)
inst float-to-int(w: u1, ty: u1, dst: def gpr, src: use simd)  = scalar(ty) rex(w, dst, src) byte(0x0F) byte(0x2C) modrm(dst, src)
# The same bits, moved between the two kinds of register.
inst bits-to-float(w: u1, dst: def simd, src: use gpr)  = byte(0x66) rex(w, dst, src) byte(0x0F) byte(0x6E) modrm(dst, src)
inst float-to-bits(w: u1, dst: def gpr, src: use simd)  = byte(0x66) rex(w, src, dst) byte(0x0F) byte(0x7E) modrm(src, dst)
# A whole vector register to and from memory, wherever that is.
inst loadv(dst: def simd, base: use gpr, disp: s32)           = rex(0, dst, base) byte(0x0F) byte(0x10) mem(dst, base, disp)
inst storev(src: use simd, base: use gpr, disp: s32)          = rex(0, src, base) byte(0x0F) byte(0x11) mem(src, base, disp)
inst loadf(ty: u1, dst: def simd, base: use gpr, disp: s32)   = scalar(ty) rex(0, dst, base) byte(0x0F) byte(0x10) mem(dst, base, disp)
inst storef(ty: u1, src: use simd, base: use gpr, disp: s32)  = scalar(ty) rex(0, src, base) byte(0x0F) byte(0x11) mem(src, base, disp)

# Memory at base + disp.
inst lea(dst: def gpr, base: use gpr, disp: s32)     = rex(1, dst, base) byte(0x8D) mem(dst, base, disp)
# The address base + (index << scale) + disp; and 64- or 32-bit loads and
# stores at base + (index << scale).
inst lea-indexed(dst: def gpr, base: use gpr, index: use gpr, scale: u2, disp: s32) = rexx(1, dst, index, base) byte(0x8D) memx(dst, base, index, scale, disp)
inst load-indexed(w: u1, dst: def gpr, base: use gpr, index: use gpr, scale: u2)    = rexx(w, dst, index, base) byte(0x8B) memx(dst, base, index, scale, 0)
inst store-indexed(w: u1, src: use gpr, base: use gpr, index: use gpr, scale: u2)   = rexx(w, src, index, base) byte(0x89) memx(src, base, index, scale, 0)
inst load(w: u1, dst: def gpr, base: use gpr, disp: s32)   = rex(w, dst, base) byte(0x8B) mem(dst, base, disp)
inst load16(dst: def gpr, base: use gpr, disp: s32)  = rex(0, dst, base) byte(0x0F) byte(0xB7) mem(dst, base, disp)
inst load8(dst: def gpr, base: use gpr, disp: s32)   = rex(0, dst, base) byte(0x0F) byte(0xB6) mem(dst, base, disp)
inst store(w: u1, src: use gpr, base: use gpr, disp: s32)  = rex(w, src, base) byte(0x89) mem(src, base, disp)
inst store16(src: use gpr, base: use gpr, disp: s32) = byte(0x66) rex(0, src, base) byte(0x89) mem(src, base, disp)
inst store8(src: use gpr, base: use gpr, disp: s32)  = rex8(0, src, base) byte(0x88) mem(src, base, disp)
# A constant stored: 8 bytes (sign-extended from 32 bits) or 4, then 2 and 1.
inst store-imm(w: u1, base: use gpr, disp: s32, imm: s32) = rex(w, 0, base) byte(0xC7) mem(0, base, disp) le32(imm)
inst store16-imm(base: use gpr, disp: s32, imm: s32)      = byte(0x66) rex(0, 0, base) byte(0xC7) mem(0, base, disp) byte(imm & 0xFF) byte((imm >> 8) & 0xFF)
inst store8-imm(base: use gpr, disp: s32, imm: s32)       = rex(0, 0, base) byte(0xC6) mem(0, base, disp) byte(imm & 0xFF)

# Memory shared between threads, 8, 16, 32 or 64 bits of it at `base`: the
# prefix that makes an operation 16 bits, the prefix byte, and an opcode whose
# low bit is clear for 8.
form narrow(bits) when bits == 16 = byte(0x66)
form narrow(bits)                 = nothing
form rex-bits(bits, reg, base) when bits == 8  = rex8(0, reg, base)
form rex-bits(bits, reg, base) when bits == 64 = rex(1, reg, base)
form rex-bits(bits, reg, base)                 = rex(0, reg, base)
form sized(bits, code) when bits == 8 = byte(code)
form sized(bits, code)                = byte(code | 1)
# src and memory change places; src is added to memory and becomes what was
# there; and src goes to memory if rax was there, rax then being what was.
inst swap-memory(bits: u7, src: mod gpr, base: use gpr)  = narrow(bits) rex-bits(bits, src, base) sized(bits, 0x86) mem(src, base, 0)
inst add-memory(bits: u7, src: mod gpr, base: use gpr)   = byte(0xF0) narrow(bits) rex-bits(bits, src, base) byte(0x0F) sized(bits, 0xC0) mem(src, base, 0)
inst compare-swap(bits: u7, src: use gpr, base: use gpr) = byte(0xF0) narrow(bits) rex-bits(bits, src, base) byte(0x0F) sized(bits, 0xB0) mem(src, base, 0)   reads rax writes rax
inst barrier()                                           = byte(0x0F) byte(0xAE) byte(0xF0)
