# Which x86-64 instructions compute each node.
lower in unit
nodes declarative.backend.nodes
target declarative.x64.target
emit mach

# A constant is built again in each block that needs it in a register, and so
# are addresses the machine forms in one instruction.
local CONST
local SLOT
local SYMBOL
local EXTERN

# What the allocator and the emitter ask for by name.
template move(d, s) is copy       = mov(1, d, s)
template move-float(d, s) is copy = movaps(d, s)
template jump(to) is jump         = jmp(to)
template leave() is return        = ret()
# A register to and from a slot of the frame, which is found from `base`.
template from-frame(d, base, slot)       = load(1, d, base, slot * 8)
template to-frame(s, base, slot)         = store(1, s, base, slot * 8)
template from-frame-float(d, base, slot) = loadf(1, d, base, slot * 8)
template to-frame-float(s, base, slot)   = storef(1, s, base, slot * 8)
# Sixteen bytes, in two slots.
# A frame object `at` bytes above the base: this target's rules reach frame
# objects from the frame register and ask for none of these.
template frame-address(d, base, at)              = lea(d, base, at)
template from-object(d, base, at, bytes)         = from-stack(d, base, at, bytes)
template from-object-float(d, base, at, bytes)   = from-stack-float(d, base, at, bytes)
template to-object(s, base, at, bytes) when bytes == 8 = store(1, s, base, at)
template to-object(s, base, at, bytes) when bytes == 4 = store(0, s, base, at)
template to-object(s, base, at, bytes) when bytes == 2 = store16(s, base, at)
template to-object(s, base, at, bytes)                 = store8(s, base, at)
template to-object-float(s, base, at, bytes) when bytes == 8 = storef(1, s, base, at)
template to-object-float(s, base, at, bytes)                 = storef(0, s, base, at)
# Never asked for: `tables` is 0, and selection stops if it is asked anyway.
template table-jump(w, v, low, last, otherwise) = ud2()
template table-entry(to) = ud2()
# Two words next to each other in memory: one after the other.
template load-pair(a, b, base, at)  = load(1, a, base, at) ; load(1, b, base, at + 8)
template store-pair(a, b, base, at) = store(1, a, base, at) ; store(1, b, base, at + 8)
# Sixteen bytes `sat` bytes from `s` copied to `dat` bytes from `d`, and a
# word of `bytes`, through r11: a word at a time, as what is copied was most
# often just written a word at a time (a 16-byte read of two 8-byte writes
# waits for both to reach the cache).
template copy-sixteen(s, sat, d, dat) = copy-word(s, sat, d, dat, 8) ; copy-word(s, sat + 8, d, dat + 8, 8)
template copy-word(s, sat, d, dat, bytes) = load-word(r11, s, sat, bytes, 0) ; store-word(r11, d, dat, bytes)
# Two words of a frame object `below` bytes below the frame record.
template load-pair-object(a, b, below)  = load(1, a, rbp, 0 - below) ; load(1, b, rbp, 8 - below)
template store-pair-object(a, b, below) = store(1, a, rbp, 0 - below) ; store(1, b, rbp, 8 - below)
# Two registers to and from two slots next to each other: one after the other.
template to-frame-pair(a, b, base, slot)         = to-frame(a, base, slot) ; to-frame(b, base, slot + 1)
template from-frame-pair(a, b, base, slot)       = from-frame(a, base, slot) ; from-frame(b, base, slot + 1)
template to-frame-float-pair(a, b, base, slot)   = to-frame-float(a, base, slot) ; to-frame-float(b, base, slot + 1)
template from-frame-float-pair(a, b, base, slot) = from-frame-float(a, base, slot) ; from-frame-float(b, base, slot + 1)
template from-frame-wide(d, base, slot)  = loadv(d, base, slot * 8)
template to-frame-wide(s, base, slot)    = storev(s, base, slot * 8)
# An argument of `bytes` bytes to its place above the stack pointer, and a
# parameter from its place above `base`.
template to-stack(s, at, bytes) when bytes == 8 = store(1, s, rsp, at)
template to-stack(s, at, bytes) when bytes == 4 = store(0, s, rsp, at)
template to-stack(s, at, bytes) when bytes == 2 = store16(s, rsp, at)
template to-stack(s, at, bytes)                 = store8(s, rsp, at)
template to-stack-float(s, at, bytes) when bytes == 16 = storev(s, rsp, at)
template to-stack-float(s, at, bytes) when bytes == 8 = storef(1, s, rsp, at)
template to-stack-float(s, at, bytes)                 = storef(0, s, rsp, at)
template from-stack(d, base, at, bytes) when bytes == 8 = load(1, d, base, at)
template from-stack(d, base, at, bytes) when bytes == 4 = load(0, d, base, at)
template from-stack(d, base, at, bytes) when bytes == 2 = load16(d, base, at)
template from-stack(d, base, at, bytes)                 = load8(d, base, at)
template from-stack-float(d, base, at, bytes) when bytes == 16 = loadv(d, base, at)
template from-stack-float(d, base, at, bytes) when bytes == 8 = loadf(1, d, base, at)
template from-stack-float(d, base, at, bytes)                 = loadf(0, d, base, at)
# In a function that moves the stack pointer as it runs: where the frame is,
# kept and given back; the stack pointer down by the bytes in n, to a multiple
# of 16; and the address n bytes above it.
template base-from-stack(d)  = mov(1, d, rsp)
template stack-from-base(s)  = mov(1, rsp, s)
template reserve(n)          = move(r10, n) ; add-imm(1, r10, 15) ; and-imm(1, r10, 0 - 16) ; sub(1, rsp, r10)
template above-arguments(d, n) = lea(d, rsp, n)
template grow-stack(n)            = sub-imm(1, rsp, n)
template shrink-stack(n)          = add-imm(1, rsp, n)
template frame-record(base, n)    = lea(rbp, base, n)
# A frame with its record at the top and `rest` bytes below: opened the way
# every debugger and unwinder on this machine knows a frame to open.
template open-record(rest) when rest == 0 = push(rbp) ; mov(1, rbp, rsp)
template open-record(rest)                = push(rbp) ; mov(1, rbp, rsp) ; sub-imm(1, rsp, rest)
# And the base from rbp, which is n bytes above it.
template base-from-frame(d, n)    = lea(d, rbp, 0 - n)
# Go to `to` if register v holds k; `w` is 1 to compare all 64 bits.
template branch-if-equal(w, v, k, to) when s32(k) = cmp-imm(w, v, k) ; jcc(equal, to)
template branch-if-equal(w, v, k, to)             = mov-imm64(r10, k) ; cmp(w, v, r10) ; jcc(equal, to)
template tail-register(f) is return = jmp-reg(f)
template tail-symbol(s) is return   = jmp-symbol(s)
template count-into(d, k)         = mov-imm32(d, k)
template call-register(f)         = call-reg(f)
template call-symbol(s)           = call(s)
template machine-code(bits) = raw(bits)
# What the compile straight from CIR asks of the machine besides its rules:
# a constant, an address, a word of `bytes` bytes to or from memory (one
# narrower read back extended as `signed` says), a floating value likewise,
# zeros, calls through the table of addresses, and a value rounded up to `a`.
template constant(d, k) when k >= 0 and k < 4294967296 = mov-imm32(d, k)
template constant(d, k) when s32(k)                    = mov-simm32(d, k)
template constant(d, k)                                = mov-imm64(d, k)
template address(d, base, at) when at == 0 and d == base = nothing
template address(d, base, at) when s32(at)              = lea(d, base, at)
template address(d, base, at)                           = mov-imm64(r11, at) ; lea-indexed(d, base, r11, 0, 0)
template load-word(d, base, at, bytes, signed) when bytes == 8                  = load(1, d, base, at)
template load-word(d, base, at, bytes, signed) when bytes == 4 and signed == 0  = load(0, d, base, at)
template load-word(d, base, at, bytes, signed) when bytes == 4                  = load(0, d, base, at) ; movsx32(d, d)
template load-word(d, base, at, bytes, signed) when bytes == 2 and signed == 0  = load16(d, base, at)
template load-word(d, base, at, bytes, signed) when bytes == 2                  = load16(d, base, at) ; movsx16(1, d, d)
template load-word(d, base, at, bytes, signed) when signed == 0                 = load8(d, base, at)
template load-word(d, base, at, bytes, signed)                                  = load8(d, base, at) ; movsx8(1, d, d)
template store-word(s, base, at, bytes) when bytes == 8 = store(1, s, base, at)
template store-word(s, base, at, bytes) when bytes == 4 = store(0, s, base, at)
template store-word(s, base, at, bytes) when bytes == 2 = store16(s, base, at)
template store-word(s, base, at, bytes)                 = store8(s, base, at)
# Zero stored as a constant of the instruction: no register is needed for it.
template store-zero(base, at, bytes) when bytes == 8 = store-imm(1, base, at, 0)
template store-zero(base, at, bytes) when bytes == 4 = store-imm(0, base, at, 0)
template store-zero(base, at, bytes) when bytes == 2 = store16-imm(base, at, 0)
template store-zero(base, at, bytes)                 = store8-imm(base, at, 0)
template load-float(d, base, at, bytes) when bytes == 16 = loadv(d, base, at)
template load-float(d, base, at, bytes) when bytes == 8  = loadf(1, d, base, at)
template load-float(d, base, at, bytes)                  = loadf(0, d, base, at)
template store-float(s, base, at, bytes) when bytes == 16 = storev(s, base, at)
template store-float(s, base, at, bytes) when bytes == 8  = storef(1, s, base, at)
template store-float(s, base, at, bytes)                  = storef(0, s, base, at)
template call-through-table(s) = mov-got(r11, s) ; call-reg(r11)
template tail-through-table(s) is return = mov-got(r11, s) ; jmp-reg(r11)
template align-up(d, s, a) = move(d, s) ; add-imm(1, d, a - 1) ; and-imm(1, d, 0 - a)
# What memory other threads share held, `bytes` wide, carried up with zeros;
# and as a signed or unsigned number of that width, for comparing.
template narrow(d, bytes) when bytes == 8 = nothing
template narrow(d, bytes) when bytes == 4 = mov(0, d, d)
template narrow(d, bytes) when bytes == 2 = movzx16(d, d)
template narrow(d, bytes)                 = movzx8(d, d)
template signed-of(d, s, bytes) when bytes == 8 = move(d, s)
template signed-of(d, s, bytes) when bytes == 4 = movsx32(d, s)
template signed-of(d, s, bytes) when bytes == 2 = movsx16(1, d, s)
template signed-of(d, s, bytes)                 = movsx8(1, d, s)
template unsigned-of(d, s, bytes) when bytes == 8 = move(d, s)
template unsigned-of(d, s, bytes) when bytes == 4 = mov(0, d, s)
template unsigned-of(d, s, bytes) when bytes == 2 = movzx16(d, s)
template unsigned-of(d, s, bytes)                 = movzx8(d, s)
# One round of an update the machine has no instruction for: `n`, what was
# there, combined with `v` as `kind` says (CIR's ATOMIC-RMW: 2 and, 3 or,
# 4 exclusive or, the larger and the smaller signed 6 7, unsigned 8 9), with
# `a` and `b` registers of the caller's for comparing.
template update(kind, bytes, n, v, a, b) when kind == 2 = and(1, n, v)
template update(kind, bytes, n, v, a, b) when kind == 3 = or(1, n, v)
template update(kind, bytes, n, v, a, b) when kind == 4 = xor(1, n, v)
template update(kind, bytes, n, v, a, b) when kind == 6 = signed-of(a, n, bytes) ; signed-of(b, v, bytes) ; cmp(1, a, b) ; cmov(1, less, n, v)
template update(kind, bytes, n, v, a, b) when kind == 7 = signed-of(a, n, bytes) ; signed-of(b, v, bytes) ; cmp(1, a, b) ; cmov(1, greater, n, v)
template update(kind, bytes, n, v, a, b) when kind == 8 = unsigned-of(a, n, bytes) ; unsigned-of(b, v, bytes) ; cmp(1, a, b) ; cmov(1, below, n, v)
template update(kind, bytes, n, v, a, b)                = unsigned-of(a, n, bytes) ; unsigned-of(b, v, bytes) ; cmp(1, a, b) ; cmov(1, above, n, v)

# A value narrower than 32 bits has no promise about the bits above it. These
# make a copy with those bits filled, for the instructions that read them.
template sign-extend(d, s, bits) when bits == 8  = movsx8(0, d, s)
template sign-extend(d, s, bits)                 = movsx16(0, d, s)
template zero-extend(d, s, bits) when bits == 8  = movzx8(d, s)
template zero-extend(d, s, bits) when bits == 16 = movzx16(d, s)
template zero-extend(d, s, bits)                 = mov(0, d, s) ; and-imm(0, d, 1)

# Control that is only structure.
rule START   => nothing
rule REGION  => nothing
rule LOOP    => nothing
rule TRUE    => nothing
rule FALSE   => nothing
rule PHI     => nothing
rule SWITCH  => nothing
rule CASE    => nothing
rule DEFAULT => nothing
rule TRAP    => ud2()
rule TAILCALL => nothing
rule CALL    => nothing
rule RESULT  => nothing
rule RETURN  => nothing
rule RESERVE => nothing
rule PARAM   => nothing

rule SLOT                        => lea(out, rbp, 0 - object)
rule SYMBOL s                    => lea-symbol(out, s)
rule EXTERN s                    => mov-got(out, s)

# A floating constant is its bits, built in an integer register and moved across.
rule CONST k when float and width == 32 => mov-imm32($t, k) ; bits-to-float(0, out, $t)
rule CONST k when float                 => mov-imm64($t, k) ; bits-to-float(1, out, $t)

# Constants, by the shortest instruction that makes them.
rule CONST k when k >= 0 and k < 4294967296 => mov-imm32(out, k)
rule CONST k when s32(k)                    => mov-simm32(out, k)
rule CONST k                                => mov-imm64(out, k)

# Arithmetic: the result starts as a copy of the first operand.
rule ADD(x, CONST k) when s32(k) and width == 64 => lea(out, x, k)
# A sum of two registers, the second perhaps times 2, 4 or 8, is an address the
# machine computes in one instruction, into any register.
rule ADD(x, once SHL(y, CONST s)) when width == 64 and s >= 1 and s <= 3 => lea-indexed(out, x, y, s, 0)
rule ADD(x, y) when width == 64    => lea-indexed(out, x, y, 0, 0)
rule ADD(x, CONST k) when s32(k)   => move(out, x) ; add-imm(sf, out, k)
rule ADD(x, y)                     => move(out, x) ; add(sf, out, y)
rule SUB(x, CONST k) when s32(k)   => move(out, x) ; sub-imm(sf, out, k)
rule SUB(x, y)                     => move(out, x) ; sub(sf, out, y)
rule MUL(x, y)                     => move(out, x) ; imul(sf, out, y)
# Arithmetic kept to its low 32 bits is the 32-bit instruction, which leaves
# zeros above them.
rule AND(once ADD(a, CONST c), CONST k) when width == 64 and k == 4294967295 and s32(c) => move(out, a) ; add-imm(0, out, c)
rule AND(once ADD(a, b), CONST k) when width == 64 and k == 4294967295 => move(out, a) ; add(0, out, b)
rule AND(once SUB(a, b), CONST k) when width == 64 and k == 4294967295 => move(out, a) ; sub(0, out, b)
rule AND(once MUL(a, b), CONST k) when width == 64 and k == 4294967295 => move(out, a) ; imul(0, out, b)
# A mask of the low 32, 16 or 8 bits is the move that fills the rest with zeros.
rule AND(x, CONST k) when width == 64 and k == 4294967295 => mov(0, out, x)
rule AND(x, CONST k) when width == 64 and k == 65535      => movzx16(out, x)
rule AND(x, CONST k) when width == 64 and k == 255        => movzx8(out, x)
rule AND(x, CONST k) when s32(k)   => move(out, x) ; and-imm(sf, out, k)
rule AND(x, y)                     => move(out, x) ; and(sf, out, y)
rule OR(x, CONST k) when s32(k)    => move(out, x) ; or-imm(sf, out, k)
rule OR(x, y)                      => move(out, x) ; or(sf, out, y)
rule XOR(x, CONST k) when s32(k)   => move(out, x) ; xor-imm(sf, out, k)
rule XOR(x, y)                     => move(out, x) ; xor(sf, out, y)
rule NEG(x)                        => move(out, x) ; neg(sf, out)
rule NOT(x) when width == 1        => move(out, x) ; xor-imm(0, out, 1)
rule NOT(x)                        => move(out, x) ; not(sf, out)

# Shifts count modulo the width, which the machine does for 32 and 64 bits.
rule SHL(x, CONST k) when width >= 32 => move(out, x) ; shl-imm(sf, out, k & (width - 1))
rule SHR(x, CONST k) when width >= 32 => move(out, x) ; shr-imm(sf, out, k & (width - 1))
rule SAR(x, CONST k) when width >= 32 => move(out, x) ; sar-imm(sf, out, k & (width - 1))
rule SHL(x, y) when width == 8     => move(out, x) ; move(rcx, y) ; and-imm(0, rcx, 7) ; shl-cl(0, out)
rule SHL(x, y) when width == 16    => move(out, x) ; move(rcx, y) ; and-imm(0, rcx, 15) ; shl-cl(0, out)
rule SHL(x, y)                     => move(out, x) ; move(rcx, y) ; shl-cl(sf, out)
rule SHR(x, y) when width == 8     => zero-extend(out, x, 8) ; move(rcx, y) ; and-imm(0, rcx, 7) ; shr-cl(0, out)
rule SHR(x, y) when width == 16    => zero-extend(out, x, 16) ; move(rcx, y) ; and-imm(0, rcx, 15) ; shr-cl(0, out)
rule SHR(x, y)                     => move(out, x) ; move(rcx, y) ; shr-cl(sf, out)
rule SAR(x, y) when width == 8     => sign-extend(out, x, 8) ; move(rcx, y) ; and-imm(0, rcx, 7) ; sar-cl(0, out)
rule SAR(x, y) when width == 16    => sign-extend(out, x, 16) ; move(rcx, y) ; and-imm(0, rcx, 15) ; sar-cl(0, out)
rule SAR(x, y)                     => move(out, x) ; move(rcx, y) ; sar-cl(sf, out)

# Division goes through rax and rdx.
rule UDIV(x, y)                    => move(rax, zx(x)) ; mov-imm32(rdx, 0) ; div(sf, zx(y)) ; move(out, rax)
rule UREM(x, y)                    => move(rax, zx(x)) ; mov-imm32(rdx, 0) ; div(sf, zx(y)) ; move(out, rdx)
rule SDIV(x, y)                    => move(rax, sx(x)) ; sign-extend-rax(sf) ; idiv(sf, sx(y)) ; move(out, rax)
rule SREM(x, y)                    => move(rax, sx(x)) ; sign-extend-rax(sf) ; idiv(sf, sx(y)) ; move(out, rdx)

# Bits. Below 32 bits, leading zeros are counted in 32 and the extra taken
# off; trailing zeros are counted with a bit set just above the value.
rule CLZ(x) when width == 8        => lzcnt(0, $c, zx(x)) ; move(out, $c) ; sub-imm(0, out, 24)
rule CLZ(x) when width == 16       => lzcnt(0, $c, zx(x)) ; move(out, $c) ; sub-imm(0, out, 16)
rule CLZ(x)                        => lzcnt(sf, out, x)
rule CTZ(x) when width == 8        => move($t, x) ; or-imm(0, $t, 256) ; tzcnt(0, out, $t)
rule CTZ(x) when width == 16       => move($t, x) ; or-imm(0, $t, 65536) ; tzcnt(0, out, $t)
rule CTZ(x)                        => tzcnt(sf, out, x)
rule POPCNT(x)                     => popcnt(sf, out, zx(x))
rule BSWAP(x)                      => move(out, x) ; bswap(sf, out)
# The bits in the opposite order: the bytes, then within each byte the halves,
# within each half the pairs, and within each pair the bits.
template swap-fields(w, d, mask, by) = swap-fields-in(w, d, mask, by, $m, $t)
template swap-fields-in(w, d, mask, by, m, t) = mov-imm64(m, mask) ; move(t, d) ; shr-imm(w, t, by) ; and(w, t, m) ; and(w, d, m) ; shl-imm(w, d, by) ; or(w, d, t)
rule BITREV(x) when width == 64    => move(out, x) ; bswap(1, out) ; swap-fields(1, out, 1085102592571150095, 4) ; swap-fields(1, out, 3689348814741910323, 2) ; swap-fields(1, out, 6148914691236517205, 1)
rule BITREV(x)                     => move(out, x) ; bswap(0, out) ; swap-fields(0, out, 252645135, 4) ; swap-fields(0, out, 858993459, 2) ; swap-fields(0, out, 1431655765, 1)
rule ROL(x, y)                     => move(out, x) ; move(rcx, y) ; rol-cl(sf, out)
rule ROR(x, y)                     => move(out, x) ; move(rcx, y) ; ror-cl(sf, out)

rule SMIN(x, y)                    => move(out, x) ; cmp(sf, sx(x), sx(y)) ; cmov(sf, greater, out, y)
rule SMAX(x, y)                    => move(out, x) ; cmp(sf, sx(x), sx(y)) ; cmov(sf, less, out, y)
rule UMIN(x, y)                    => move(out, x) ; cmp(sf, zx(x), zx(y)) ; cmov(sf, above, out, y)
rule UMAX(x, y)                    => move(out, x) ; cmp(sf, zx(x), zx(y)) ; cmov(sf, below, out, y)
rule UMULH(x, y)                   => move(rax, x) ; mul-wide(sf, y) ; move(out, rdx)
rule SMULH(x, y)                   => move(rax, x) ; imul-wide(sf, y) ; move(out, rdx)

# Overflow: the flag the same operation leaves.
rule SADDO(a, b)                   => move($t, a) ; add(sf(a), $t, b) ; setcc(overflow, $f) ; movzx8(out, $f)
rule UADDO(a, b)                   => move($t, a) ; add(sf(a), $t, b) ; setcc(below, $f) ; movzx8(out, $f)
rule SSUBO(a, b)                   => move($t, a) ; sub(sf(a), $t, b) ; setcc(overflow, $f) ; movzx8(out, $f)
rule USUBO(a, b)                   => cmp(sf(a), a, b) ; setcc(below, $f) ; movzx8(out, $f)
rule SMULO(a, b)                   => move($t, a) ; imul(sf(a), $t, b) ; setcc(overflow, $f) ; movzx8(out, $f)
rule UMULO(a, b)                   => move(rax, a) ; mul-wide(sf(a), b) ; setcc(overflow, $f) ; movzx8(out, $f)

# Floating point: the result starts as a copy of the first operand.
rule FADD(x, y)   => move-float(out, x) ; addf(sf, out, y)
rule FSUB(x, y)   => move-float(out, x) ; subf(sf, out, y)
rule FMUL(x, y)   => move-float(out, x) ; mulf(sf, out, y)
rule FDIV(x, y)   => move-float(out, x) ; divf(sf, out, y)
rule FSQRT(x)     => sqrtf(sf, out, x)
# The machine's smaller and larger give their second operand when the two are
# equal or either is not a number. Asked both ways round and put together, the
# answers are right for zeros of either sign; FMIN is then still not a number
# when it should be, and FMAX is made so.
rule FMIN(x, y)   => move-float($a, x) ; minf(sf, $a, y) ; move-float(out, y) ; minf(sf, out, x) ; orf(out, $a)
rule FMAX(x, y)   => move-float($a, x) ; maxf(sf, $a, y) ; move-float($b, y) ; maxf(sf, $b, x) ; andf($a, $b) ; move-float(out, x) ; unordered(sf, out, y) ; orf(out, $a)
# With one value that is not a number, the other: each way's answer is dropped
# where its second operand was not a number.
rule FMIN-NUMBER(x, y) => move-float($a, y) ; minf(sf, $a, x) ; move-float($b, x) ; minf(sf, $b, y) ; move-float($nx, x) ; unordered(sf, $nx, x) ; move-float($ny, y) ; unordered(sf, $ny, y) ; move-float(out, $nx) ; andf(out, $ny) ; andnotf($nx, $a) ; andnotf($ny, $b) ; orf(out, $nx) ; orf(out, $ny)
rule FMAX-NUMBER(x, y) => move-float($a, y) ; maxf(sf, $a, x) ; move-float($b, x) ; maxf(sf, $b, y) ; move-float($nx, x) ; unordered(sf, $nx, x) ; move-float($ny, y) ; unordered(sf, $ny, y) ; orf($a, $nx) ; orf($b, $ny) ; move-float(out, $a) ; andf(out, $b)
rule ROUND-EVEN(x)  => roundf(sf, 0, out, x)
rule ROUND-DOWN(x)  => roundf(sf, 1, out, x)
rule ROUND-UP(x)    => roundf(sf, 2, out, x)
rule ROUND-ZERO(x)  => roundf(sf, 3, out, x)
# Halves away from zero: toward zero, after adding the value just below a half
# with the sign of the value itself.
rule ROUND-AWAY(x) when width == 64 => mov-imm64($s, 0 - 9223372036854775807 - 1) ; bits-to-float(1, $sign, $s) ; andf($sign, x) ; mov-imm64($h, 4602678819172646911) ; bits-to-float(1, $half, $h) ; orf($half, $sign) ; addf(1, $half, x) ; roundf(1, 3, out, $half)
rule ROUND-AWAY(x)                  => mov-imm32($s, 2147483648) ; bits-to-float(0, $sign, $s) ; andf($sign, x) ; mov-imm32($h, 1056964607) ; bits-to-float(0, $half, $h) ; orf($half, $sign) ; addf(0, $half, x) ; roundf(0, 3, out, $half)
rule FMA(x, y, z) => move-float(out, x) ; fma(sf, out, y, z)
# The sign is one bit: flipped for the negative, cleared for the absolute value.
rule FNEG(x) when width == 64 => mov-imm64($m, 0 - 9223372036854775807 - 1) ; bits-to-float(1, $v, $m) ; move-float(out, x) ; xorf(out, $v)
rule FNEG(x)                  => mov-imm32($m, 2147483648) ; bits-to-float(0, $v, $m) ; move-float(out, x) ; xorf(out, $v)
rule FABS(x) when width == 64 => mov-imm64($m, 9223372036854775807) ; bits-to-float(1, $v, $m) ; move-float(out, x) ; andf(out, $v)
rule FABS(x)                  => mov-imm32($m, 2147483647) ; bits-to-float(0, $v, $m) ; move-float(out, x) ; andf(out, $v)
# Less than is asked the other way round, so that "not a number" reads as false.
rule FLT(a, b)    => cmpf(sf(a), b, a) ; setcc(above, $t) ; movzx8(out, $t)
rule FLE(a, b)    => cmpf(sf(a), b, a) ; setcc(above-equal, $t) ; movzx8(out, $t)
rule FEQ(a, b)    => cmpf(sf(a), a, b) ; setcc(no-parity, $p) ; setcc(equal, $e) ; and(0, $e, $p) ; movzx8(out, $e)
rule FNE(a, b)    => cmpf(sf(a), a, b) ; setcc(parity, $p) ; setcc(not-equal, $e) ; or(0, $e, $p) ; movzx8(out, $e)
rule SITOF(x) when bits(x) == 64 => int-to-float(1, sf, out, x)
rule SITOF(x)                    => int-to-float(0, sf, out, sx(x))
# An unsigned integer below 64 bits is a non-negative 64-bit one. At 64 bits,
# one with its top bit set is halved, keeping the bit that falls off for the
# rounding, converted and doubled.
rule UITOF(x) when bits(x) < 64  => mov(0, $t, zx(x)) ; int-to-float(1, sf, out, $t)
rule UITOF(x) => move($h, x) ; mov-imm32(rcx, 1) ; shr-cl(1, $h) ; move($l, x) ; and-imm(1, $l, 1) ; or(1, $h, $l) ; int-to-float(1, sf, $half, $h) ; move-float($twice, $half) ; addf(sf, $twice, $half) ; int-to-float(1, sf, $plain, x) ; float-to-bits(sf, $a, $plain) ; float-to-bits(sf, $b, $twice) ; test(1, x, x) ; cmov(1, sign, $a, $b) ; bits-to-float(sf, out, $a)
# To an integer: the machine's answer for what does not fit or is not a number
# is the smallest integer; what was too large becomes the largest, and what was
# not a number 0.
rule FTOSI(x) when width == 64 => float-to-int(1, sf(x), $r, x) ; mov-imm64($m, 9223372036854775807) ; int-to-float(1, sf(x), $edge, $m) ; cmpf(sf(x), x, $edge) ; cmov(1, above-equal, $r, $m) ; mov-imm32($z, 0) ; cmpf(sf(x), x, x) ; cmov(1, parity, $r, $z) ; move(out, $r)
rule FTOSI(x)                  => float-to-int(1, sf(x), $r, x) ; mov-imm64($m, 2147483647) ; mov-simm32($n, 0 - 2147483648) ; cmp(1, $r, $m) ; cmov(1, greater, $r, $m) ; cmp(1, $r, $n) ; cmov(1, less, $r, $n) ; int-to-float(1, sf(x), $edge, $m) ; cmpf(sf(x), x, $edge) ; cmov(1, above-equal, $r, $m) ; mov-imm32($z, 0) ; cmpf(sf(x), x, x) ; cmov(1, parity, $r, $z) ; move(out, $r)
rule FTOUI(x) when width == 32 => float-to-int(1, sf(x), $r, x) ; mov-imm32($z, 0) ; cmp(1, $r, $z) ; cmov(1, less, $r, $z) ; mov-imm32($m, 4294967295) ; cmp(1, $r, $m) ; cmov(1, greater, $r, $m) ; mov-imm64($big, 4294967296) ; int-to-float(1, sf(x), $edge, $big) ; cmpf(sf(x), x, $edge) ; cmov(1, above-equal, $r, $m) ; cmpf(sf(x), x, x) ; cmov(1, parity, $r, $z) ; move(out, $r)
rule FTOUI(x) => float-to-int(1, sf(x), $low, x) ; mov-imm64($top, 0 - 9223372036854775807 - 1) ; mov-imm64($m, 9223372036854775807) ; int-to-float(1, sf(x), $edge, $m) ; move-float($y, x) ; subf(sf(x), $y, $edge) ; float-to-int(1, sf(x), $high, $y) ; xor(1, $high, $top) ; cmpf(sf(x), x, $edge) ; cmov(1, above-equal, $low, $high) ; move-float($d, $edge) ; addf(sf(x), $d, $edge) ; mov-simm32($all, 0 - 1) ; cmpf(sf(x), x, $d) ; cmov(1, above-equal, $low, $all) ; mov-imm32($z, 0) ; bits-to-float(1, $fz, $z) ; cmpf(sf(x), x, $fz) ; cmov(1, below, $low, $z) ; move(out, $low)
rule FEXT(x)      => single-to-double(out, x)
rule FTRUNC(x)    => double-to-single(out, x)
rule BITCAST(x) when float and not float(x)  => bits-to-float(sf, out, x)
rule BITCAST(x) when float(x) and not float  => float-to-bits(sf, out, x)

rule LOAD(_, ADD(p, CONST k)) when width == 128 and s32(k)         => loadv(out, p, k)
rule LOAD(_, p) when width == 128                                  => loadv(out, p, 0)
rule STORE(_, ADD(p, CONST k), v) when bits(v) == 128 and s32(k)   => storev(v, p, k)
rule STORE(_, p, v) when bits(v) == 128                            => storev(v, p, 0)
rule LOAD(_, ADD(p, CONST k)) when float and s32(k) => loadf(sf, out, p, k)
rule LOAD(_, p) when float                          => loadf(sf, out, p, 0)
rule STORE(_, ADD(p, CONST k), v) when float(v) and s32(k) => storef(sf(v), v, p, k)
rule STORE(_, p, v) when float(v)                          => storef(sf(v), v, p, 0)
# One of two floating values: chosen as bits, in integer registers.
rule COND(c, x, y) when float => float-to-bits(sf, $a, x) ; float-to-bits(sf, $b, y) ; test(0, c, c) ; cmov(1, equal, $a, $b) ; bits-to-float(sf, out, $a)

# Between widths.
rule ZEXT(x) when bits(x) == 32    => mov(0, out, x)
rule ZEXT(x) when bits(x) == 16    => movzx16(out, x)
rule ZEXT(x) when bits(x) == 8     => movzx8(out, x)
rule ZEXT(x)                       => x
rule SEXT(x) when bits(x) == 32    => movsx32(out, x)
rule SEXT(x) when bits(x) == 16    => movsx16(1, out, x)
rule SEXT(x)                       => movsx8(1, out, x)
rule TRUNC(x) when width == 1      => mov(0, out, x) ; and-imm(0, out, 1)
rule TRUNC(x)                      => x
rule BITCAST(x) when not float and not float(x) => x

# Memory. A frame object, and a place inside one, is read and written from
# the frame register: no address is computed.
rule LOAD(_, p) when not float and width == 64 and slot(p)  => load(1, out, rbp, 0 - object(p))
rule LOAD(_, p) when not float and width == 32 and slot(p)  => load(0, out, rbp, 0 - object(p))
rule LOAD(_, p) when not float and width == 16 and slot(p)  => load16(out, rbp, 0 - object(p))
rule LOAD(_, p) when not float and width <= 8 and slot(p)   => load8(out, rbp, 0 - object(p))
rule LOAD(_, ADD(p, CONST k)) when not float and width == 64 and slot(p) and k >= 0 and k < object(p) => load(1, out, rbp, k - object(p))
rule LOAD(_, ADD(p, CONST k)) when not float and width == 32 and slot(p) and k >= 0 and k < object(p) => load(0, out, rbp, k - object(p))
rule LOAD(_, ADD(p, CONST k)) when not float and width == 16 and slot(p) and k >= 0 and k < object(p) => load16(out, rbp, k - object(p))
rule LOAD(_, ADD(p, CONST k)) when not float and width <= 8 and slot(p) and k >= 0 and k < object(p)  => load8(out, rbp, k - object(p))
rule STORE(_, p, v) when not float(v) and bits(v) == 64 and slot(p) => store(1, v, rbp, 0 - object(p))
rule STORE(_, p, v) when not float(v) and bits(v) == 32 and slot(p) => store(0, v, rbp, 0 - object(p))
rule STORE(_, p, v) when not float(v) and bits(v) == 16 and slot(p) => store16(v, rbp, 0 - object(p))
rule STORE(_, p, v) when not float(v) and bits(v) <= 8 and slot(p)  => store8(v, rbp, 0 - object(p))
rule STORE(_, ADD(p, CONST k), v) when not float(v) and bits(v) == 64 and slot(p) and k >= 0 and k < object(p) => store(1, v, rbp, k - object(p))
rule STORE(_, ADD(p, CONST k), v) when not float(v) and bits(v) == 32 and slot(p) and k >= 0 and k < object(p) => store(0, v, rbp, k - object(p))
rule STORE(_, ADD(p, CONST k), v) when not float(v) and bits(v) == 16 and slot(p) and k >= 0 and k < object(p) => store16(v, rbp, k - object(p))
rule STORE(_, ADD(p, CONST k), v) when not float(v) and bits(v) <= 8 and slot(p) and k >= 0 and k < object(p)  => store8(v, rbp, k - object(p))
rule LOAD(_, ADD(p, CONST k)) when not float and width == 64 and s32(k) => load(1, out, p, k)
# A base plus an index, the index perhaps times 2, 4 or 8, is an address as it is.
rule LOAD(_, ADD(p, once SHL(i, CONST s))) when not float and width == 64 and s >= 1 and s <= 3 => load-indexed(1, out, p, i, s)
rule LOAD(_, ADD(p, once SHL(i, CONST s))) when not float and width == 32 and s >= 1 and s <= 3 => load-indexed(0, out, p, i, s)
rule LOAD(_, once ADD(p, i)) when not float and width == 64 => load-indexed(1, out, p, i, 0)
rule LOAD(_, once ADD(p, i)) when not float and width == 32 => load-indexed(0, out, p, i, 0)
rule STORE(_, ADD(p, once SHL(i, CONST s)), v) when not float(v) and bits(v) == 64 and s >= 1 and s <= 3 => store-indexed(1, v, p, i, s)
rule STORE(_, ADD(p, once SHL(i, CONST s)), v) when not float(v) and bits(v) == 32 and s >= 1 and s <= 3 => store-indexed(0, v, p, i, s)
rule LOAD(_, ADD(p, CONST k)) when not float and width == 32 and s32(k) => load(0, out, p, k)
rule LOAD(_, ADD(p, CONST k)) when not float and width == 16 and s32(k) => load16(out, p, k)
rule LOAD(_, ADD(p, CONST k)) when not float and s32(k)                 => load8(out, p, k)
rule LOAD(_, p) when not float and width == 64   => load(1, out, p, 0)
rule LOAD(_, p) when not float and width == 32   => load(0, out, p, 0)
rule LOAD(_, p) when not float and width == 16   => load16(out, p, 0)
rule LOAD(_, p) when not float                   => load8(out, p, 0)
rule STORE(_, ADD(p, CONST k), v) when not float(v) and bits(v) == 64 and s32(k) => store(1, v, p, k)
rule STORE(_, ADD(p, CONST k), v) when not float(v) and bits(v) == 32 and s32(k) => store(0, v, p, k)
rule STORE(_, ADD(p, CONST k), v) when not float(v) and bits(v) == 16 and s32(k) => store16(v, p, k)
rule STORE(_, ADD(p, CONST k), v) when not float(v) and s32(k)                   => store8(v, p, k)
rule STORE(_, p, v) when not float(v) and bits(v) == 64 => store(1, v, p, 0)
rule STORE(_, p, v) when not float(v) and bits(v) == 32 => store(0, v, p, 0)
rule STORE(_, p, v) when not float(v) and bits(v) == 16 => store16(v, p, 0)
rule STORE(_, p, v) when not float(v)                   => store8(v, p, 0)

# One of two values, by a comparison's flags: the flags first, since copying a
# register leaves them be, and the copy may then take a register the comparison read.
rule COND(EQ(a, CONST k), x, y) when not float and s32(k) => cmp-imm(sf(a), zx(a), k) ; move(out, y) ; cmov(sf, equal, out, x)
rule COND(NE(a, CONST k), x, y) when not float and s32(k) => cmp-imm(sf(a), zx(a), k) ; move(out, y) ; cmov(sf, not-equal, out, x)
rule COND(LT(a, CONST k), x, y) when not float and s32(k) and (bits(a) >= 32 or k < 128) => cmp-imm(sf(a), sx(a), k) ; move(out, y) ; cmov(sf, less, out, x)
rule COND(LE(a, CONST k), x, y) when not float and s32(k) and (bits(a) >= 32 or k < 128) => cmp-imm(sf(a), sx(a), k) ; move(out, y) ; cmov(sf, less-equal, out, x)
rule COND(ULT(a, CONST k), x, y) when not float and s32(k) and (k >= 0 or bits(a) == 64) => cmp-imm(sf(a), zx(a), k) ; move(out, y) ; cmov(sf, below, out, x)
rule COND(ULE(a, CONST k), x, y) when not float and s32(k) and (k >= 0 or bits(a) == 64) => cmp-imm(sf(a), zx(a), k) ; move(out, y) ; cmov(sf, below-equal, out, x)
rule COND(EQ(a, b), x, y) when not float => cmp(sf(a), zx(a), zx(b)) ; move(out, y) ; cmov(sf, equal, out, x)
rule COND(NE(a, b), x, y) when not float => cmp(sf(a), zx(a), zx(b)) ; move(out, y) ; cmov(sf, not-equal, out, x)
rule COND(LT(a, b), x, y) when not float => cmp(sf(a), sx(a), sx(b)) ; move(out, y) ; cmov(sf, less, out, x)
rule COND(LE(a, b), x, y) when not float => cmp(sf(a), sx(a), sx(b)) ; move(out, y) ; cmov(sf, less-equal, out, x)
rule COND(ULT(a, b), x, y) when not float => cmp(sf(a), zx(a), zx(b)) ; move(out, y) ; cmov(sf, below, out, x)
rule COND(ULE(a, b), x, y) when not float => cmp(sf(a), zx(a), zx(b)) ; move(out, y) ; cmov(sf, below-equal, out, x)
rule COND(c, x, y) when not float  => move(out, y) ; test(0, c, c) ; cmov(sf, not-equal, out, x)

# A comparison as a value: the flags, then 1 where the condition holds.
# Against a constant that fits, the constant needs no register.
rule EQ(a, CONST k) when s32(k)   => cmp-imm(sf(a), zx(a), k) ; setcc(equal, $t) ; movzx8(out, $t)
rule NE(a, CONST k) when s32(k)   => cmp-imm(sf(a), zx(a), k) ; setcc(not-equal, $t) ; movzx8(out, $t)
rule LT(a, CONST k) when s32(k) and (bits(a) >= 32 or k < 128)   => cmp-imm(sf(a), sx(a), k) ; setcc(less, $t) ; movzx8(out, $t)
rule LE(a, CONST k) when s32(k) and (bits(a) >= 32 or k < 128)   => cmp-imm(sf(a), sx(a), k) ; setcc(less-equal, $t) ; movzx8(out, $t)
rule ULT(a, CONST k) when s32(k)  => cmp-imm(sf(a), zx(a), k) ; setcc(below, $t) ; movzx8(out, $t)
rule ULE(a, CONST k) when s32(k)  => cmp-imm(sf(a), zx(a), k) ; setcc(below-equal, $t) ; movzx8(out, $t)
rule EQ(a, b)   => cmp(sf(a), zx(a), zx(b)) ; setcc(equal, $t) ; movzx8(out, $t)
rule NE(a, b)   => cmp(sf(a), zx(a), zx(b)) ; setcc(not-equal, $t) ; movzx8(out, $t)
rule LT(a, b)   => cmp(sf(a), sx(a), sx(b)) ; setcc(less, $t) ; movzx8(out, $t)
rule LE(a, b)   => cmp(sf(a), sx(a), sx(b)) ; setcc(less-equal, $t) ; movzx8(out, $t)
rule ULT(a, b)  => cmp(sf(a), zx(a), zx(b)) ; setcc(below, $t) ; movzx8(out, $t)
rule ULE(a, b)  => cmp(sf(a), zx(a), zx(b)) ; setcc(below-equal, $t) ; movzx8(out, $t)

# A signed comparison of a value narrower than 32 bits with a constant takes
# this way only if the constant is not negative: a negative one is held as its
# low bits, which is not the number.
# A branch on a comparison uses its flags directly. Against zero the value is
# tested with itself; with the constant first, the comparison is the other
# way round; and the low 32 bits of a value are compared as they are.
rule IF(_, EQ(AND(x, CONST m), CONST k)) when m == 4294967295 and bits(x) == 64 and s32(k) and k >= 0 => cmp-imm(0, x, k) ; jcc(equal, then) ; jump(else)
rule IF(_, NE(AND(x, CONST m), CONST k)) when m == 4294967295 and bits(x) == 64 and s32(k) and k >= 0 => cmp-imm(0, x, k) ; jcc(not-equal, then) ; jump(else)
rule IF(_, EQ(a, CONST k)) when k == 0 and bits(a) >= 32 => test(sf(a), a, a) ; jcc(equal, then) ; jump(else)
rule IF(_, NE(a, CONST k)) when k == 0 and bits(a) >= 32 => test(sf(a), a, a) ; jcc(not-equal, then) ; jump(else)
rule IF(_, LT(CONST k, a)) when s32(k) and (bits(a) >= 32 or k < 128)  => cmp-imm(sf(a), sx(a), k) ; jcc(greater, then) ; jump(else)
rule IF(_, LE(CONST k, a)) when s32(k) and (bits(a) >= 32 or k < 128)  => cmp-imm(sf(a), sx(a), k) ; jcc(greater-equal, then) ; jump(else)
rule IF(_, ULT(CONST k, a)) when s32(k) and (k >= 0 or bits(a) == 64) => cmp-imm(sf(a), zx(a), k) ; jcc(above, then) ; jump(else)
rule IF(_, ULE(CONST k, a)) when s32(k) and (k >= 0 or bits(a) == 64) => cmp-imm(sf(a), zx(a), k) ; jcc(above-equal, then) ; jump(else)
rule IF(_, EQ(a, CONST k)) when s32(k)  => cmp-imm(sf(a), zx(a), k) ; jcc(equal, then) ; jump(else)
rule IF(_, NE(a, CONST k)) when s32(k)  => cmp-imm(sf(a), zx(a), k) ; jcc(not-equal, then) ; jump(else)
rule IF(_, LT(a, CONST k)) when s32(k) and (bits(a) >= 32 or k < 128)  => cmp-imm(sf(a), sx(a), k) ; jcc(less, then) ; jump(else)
rule IF(_, LE(a, CONST k)) when s32(k) and (bits(a) >= 32 or k < 128)  => cmp-imm(sf(a), sx(a), k) ; jcc(less-equal, then) ; jump(else)
rule IF(_, ULT(a, CONST k)) when s32(k) and (k >= 0 or bits(a) == 64) => cmp-imm(sf(a), zx(a), k) ; jcc(below, then) ; jump(else)
rule IF(_, ULE(a, CONST k)) when s32(k) and (k >= 0 or bits(a) == 64) => cmp-imm(sf(a), zx(a), k) ; jcc(below-equal, then) ; jump(else)
rule IF(_, EQ(a, b))   => cmp(sf(a), zx(a), zx(b)) ; jcc(equal, then) ; jump(else)
rule IF(_, NE(a, b))   => cmp(sf(a), zx(a), zx(b)) ; jcc(not-equal, then) ; jump(else)
rule IF(_, LT(a, b))   => cmp(sf(a), sx(a), sx(b)) ; jcc(less, then) ; jump(else)
rule IF(_, LE(a, b))   => cmp(sf(a), sx(a), sx(b)) ; jcc(less-equal, then) ; jump(else)
rule IF(_, ULT(a, b))  => cmp(sf(a), zx(a), zx(b)) ; jcc(below, then) ; jump(else)
rule IF(_, ULE(a, b))  => cmp(sf(a), zx(a), zx(b)) ; jcc(below-equal, then) ; jump(else)
rule IF(_, FLT(a, b))  => cmpf(sf(a), b, a) ; jcc(above, then) ; jump(else)
rule IF(_, FLE(a, b))  => cmpf(sf(a), b, a) ; jcc(above-equal, then) ; jump(else)
rule IF(_, FEQ(a, b))  => cmpf(sf(a), a, b) ; jcc(parity, else) ; jcc(equal, then) ; jump(else)
rule IF(_, FNE(a, b))  => cmpf(sf(a), a, b) ; jcc(parity, then) ; jcc(not-equal, then) ; jump(else)
rule IF(_, c)          => test(0, c, c) ; jcc(not-equal, then) ; jump(else)

# Memory shared between threads. Every thread already sees this machine's
# loads and stores in one order, except that a store must be seen before the
# loads after it, which a swap is. What the machine cannot do in one
# instruction is done by a loop around CAS before any of this is asked.
rule ATOMIC-LOAD(_, p) when width == 64 => load(1, out, p, 0)
rule ATOMIC-LOAD(_, p) when width == 32 => load(0, out, p, 0)
rule ATOMIC-LOAD(_, p) when width == 16 => load16(out, p, 0)
rule ATOMIC-LOAD(_, p)                  => load8(out, p, 0)
rule ATOMIC-STORE(_, p, v) => move($t, v) ; swap-memory(bits(v), $t, p)
rule SWAP(_, p, v)         => move(out, v) ; swap-memory(width, out, p)
rule FETCH-ADD(_, p, v)    => move(out, v) ; add-memory(width, out, p)
rule FETCH-SUB(_, p, v)    => move(out, v) ; neg(sf, out) ; add-memory(width, out, p)
rule CAS(_, p, e, v)       => move(rax, e) ; compare-swap(width, v, p) ; move(out, rax)
rule FENCE                 => barrier()
