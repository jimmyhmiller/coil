# An ELF relocatable object for x86-64: the code and the data, their
# relocations, the symbols and their names, and the table of sections that
# says where each is.
target declarative.x64.target
symbols defined first
prefix ""

block header {
  u8 0x7f  text "ELF"
  u8 2  u8 1  u8 1  u8 0  u64 0       # 64-bit, little end first, System V
  u16 1                               # a relocatable object
  u16 62                              # x86-64
  u32 1
  u64 0  u64 0  u64 offset(sections)
  u32 0  u16 64  u16 0  u16 0
  u16 64  u16 9  u16 8                # nine sections; the last holds their names
}

block code { code }
block after-code { align 8 }
block data { data }
block after-data { align 8 }

# A relocation: where, the symbol and the kind, and what to add. Each kind
# here fills four bytes with a distance from the end of those bytes.
block relocs {
  each r in relocs {
    u64 r.at
    u64 (r.symbol.number + 1) << 32 | r.kind(plt32: 4, pc32: 2, gotpcrel: 9)
    u64 0 - 4
  }
}

# A pointer in the data: eight bytes that hold a symbol's address.
block pointers {
  each p in pointers {
    u64 p.at
    u64 (p.symbol.number + 1) << 32 | 1
    u64 0
  }
}

# Symbols, after the empty one every table starts with: global, a function or
# an object if defined here, and in the section it is in or in none.
block symtab {
  u64 0  u64 0  u64 0
  each s in symbols {
    u32 s.strx
    u8 if not s.defined then 0x10 else if s.in-data then 0x11 else 0x12
    u8 0
    u16 if not s.defined then 0 else if s.in-data then 3 else 1
    u64 if s.defined then s.value else 0
    u64 0
  }
}

block strings {
  u8 0
  each s in symbols { text s.name  u8 0 }
}

block names {
  u8 0
  text ".text" pad 6
  text ".rela.text" pad 11
  text ".data" pad 6
  text ".rela.data" pad 11
  text ".symtab" pad 8
  text ".strtab" pad 8
  text ".note.GNU-stack" pad 16
  text ".shstrtab" pad 10
}
block after-names { align 8 }

# A section: its name's place in `names`, its type and flags, where it is and
# how large, two links whose meaning depends on the type, alignment, and the
# size of one entry if it is a table.
block sections {
  u64 0  u64 0  u64 0  u64 0  u64 0  u64 0  u64 0  u64 0
  u32 1   u32 1  u64 6     u64 0  u64 offset(code)      u64 size(code)      u32 0  u32 0  u64 16  u64 0
  u32 7   u32 4  u64 0x40  u64 0  u64 offset(relocs)    u64 size(relocs)    u32 5  u32 1  u64 8   u64 24
  u32 18  u32 1  u64 3     u64 0  u64 offset(data)      u64 size(data)      u32 0  u32 0  u64 8   u64 0
  u32 24  u32 4  u64 0x40  u64 0  u64 offset(pointers)  u64 size(pointers)  u32 5  u32 3  u64 8   u64 24
  u32 35  u32 2  u64 0     u64 0  u64 offset(symtab)    u64 size(symtab)    u32 6  u32 1  u64 8   u64 24
  u32 43  u32 3  u64 0     u64 0  u64 offset(strings)   u64 size(strings)   u32 0  u32 0  u64 1   u64 0
  u32 51  u32 1  u64 0     u64 0  u64 offset(names)     u64 0               u32 0  u32 0  u64 1   u64 0
  u32 67  u32 3  u64 0     u64 0  u64 offset(names)     u64 size(names)     u32 0  u32 0  u64 1   u64 0
}
