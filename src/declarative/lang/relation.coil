;;; Relations are ordered row queries, independent of their indexed storage.
;;; The planner materializes a dense inverse index with two query scans and a
;;; prefix sum. A meet solver uses that inverse index to visit only dependents
;;; whose input changed. Client specifications contain no cursor/worklist code.
(module lang.relation)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "lang.text" :as t)

(defstruct Clause [(kind (slice u8)) (name (slice u8)) (value (slice u8)) (second (slice u8)) (next (slice u8)) (end (slice u8))])
(defstruct Column [(target (slice u8)) (value (slice u8))])
(defstruct Index
  [(name (slice u8)) (params (slice u8)) (keys (slice u8))
   (offsets (slice u8)) (cursor (slice u8)) (key (slice u8))
   (clauses (ArrayList Clause)) (columns (ArrayList Column))])

(defn empty [(name (slice u8)) (params (slice u8))] (-> Index)
  (Index :name name :params params :keys "" :offsets "" :cursor "" :key ""
         :clauses (ArrayList::new [Clause] (malloc-allocator))
         :columns (ArrayList::new [Column] (malloc-allocator))))

;;; A query's bound variables are scoped inside each traversal. They cannot
;;; alias the planner's temporaries, whose names contain `*`.
(defn segments-text [(clause Clause) (body (slice u8))] (-> (slice u8))
  (t/cat4 "(let [(mut offset*) 0 counts* " (.value clause) "] (for "
    (t/cat4 (.name clause) " (range 0 (len counts*)) (let [end* (+ offset* (cast i64 (get counts* "
      (.name clause) (t/cat4 ")))] (for " (.second clause) " (range offset* end*) "
        (t/cat2 body ") (set! offset* end*))))")))))

(defn query [(q Index) (body (slice u8))] (-> (slice u8))
  (let [(mut out) body]
    (for j (range 0 (len (.clauses q)))
      (let [clause (get (.clauses q) (- (- (len (.clauses q)) 1) j))]
        (set! out
          (cond (= (.kind clause) "from")
                  (t/cat4 "(for " (.name clause) " " (t/cat4 (.value clause) " " out ")"))
                (= (.kind clause) "let")
                  (t/cat4 "(let [" (.name clause) " " (t/cat4 (.value clause) "] " out ")"))
                (= (.kind clause) "chain")
                  (t/cat4 "(let [(mut " (.name clause) ") "
                    (t/cat4 (.value clause) "] (while (!= " (.name clause)
                      (t/cat4 " " (.end clause) ") "
                        (t/cat4 out " (set! " (.name clause) (t/cat3 " " (.next clause) ")))")))))
                (= (.kind clause) "segments") (segments-text clause out)
                :else (t/cat4 "(when " (.value clause) " " (t/cat2 out ")"))))))
    out))

(defn empty-sized [(target (slice u8)) (count (slice u8))] (-> (slice u8))
  (t/cat4 "(clear! (mut " target ")) (extend-zeroed! (mut " (t/cat4 target ") " count ")")))

(defn index-text [(q Index)] (-> (slice u8))
  (let [(mut out) (t/out-new)
        offset (.offsets q) cursor (.cursor q)]
    (t/line! (mut out) (t/cat4 "(defn " (.name q) " " (t/cat2 (.params q) " (-> void)")))
    (t/line! (mut out) (t/cat3 " (let [keys* " (.keys q) "]"))
    (t/line! (mut out) (empty-sized offset "(+ keys* 1)"))
    (t/line! (mut out) (query q
      (t/cat4 "(let [key* (cast i64 " (.key q) ")] (set! (mut "
        (t/cat4 offset ") key* (+ (get " offset " key*) (: 1 u32))))"))))
    (t/line! (mut out) " (let [(mut total*) (: 0 u32)]")
    (t/line! (mut out) (t/cat4 " (for key* (range 0 keys*) (let [count* (get " offset " key*)] (set! (mut "
      (t/cat4 offset ") key* total*) (set! total* (+ total* count*)))) (set! (mut " offset ") keys* total*)")))
    (for column (.columns q)
      (t/line! (mut out) (empty-sized (.target column) "(cast i64 total*)")))
    (t/line! (mut out) ")")
    (t/line! (mut out) (t/cat4 " (clear! (mut " cursor ")) (extend! (mut "
      (t/cat4 cursor ") (.data " offset ") keys*)")))
    (let [(mut row) (t/out-new)]
      (t/line! (mut row) (t/cat4 "(let [key* (cast i64 " (.key q) ") at* (get " (t/cat2 cursor " key*)]")))
      (for column (.columns q)
        (t/line! (mut row) (t/cat4 "(set! (mut " (.target column) ") (cast i64 at*) " (t/cat2 (.value column) ")"))))
      (t/line! (mut row) (t/cat4 "(set! (mut " cursor ") key* " "(+ at* (: 1 u32))))"))
      (t/line! (mut out) (query q (t/text-of (mut row)))))
    (t/line! (mut out) "))")
    (t/text-of (mut out))))

;;; Least loss of finite bit facts: initial facts descend by intersection with
;;; every dependency. A boundary node denotes information outside the graph.
;;; Only the inverse neighbors of a changed fact are scheduled.
(defn meet-text [(name (slice u8)) (params (slice u8)) (values (slice u8))
                 (offsets (slice u8)) (users (slice u8)) (top (slice u8)) (boundary (slice u8))] (-> (slice u8))
  (let [(mut out) (t/out-new)]
    (t/line! (mut out) (t/cat4 "(defn " name " " (t/cat2 params " (-> void)")))
    (t/line! (mut out) (t/cat4 "(let [count* (len " values ") top* "
      (t/cat4 top " boundary* " boundary " (mut work*) (ArrayList::new [u32] (malloc-allocator))]")))
    (t/line! (mut out) (t/cat4 "(for key* (range 0 (+ count* 1)) (when (!= (if (< key* count*) (get " values
      " key*) boundary*) top*) (push! (mut work*) (cast u32 key*))))" ""))
    (t/line! (mut out) "(while (> (len work*) 0) (let [key* (cast i64 (get work* (- (len work*) 1)))] (pop! (mut work*))")
    (t/line! (mut out) (t/cat4 "(let [fact* (if (< key* count*) (get " values " key*) boundary*)] (for edge* (range (cast i64 (get "
      (t/cat4 offsets " key*)) (cast i64 (get " offsets " (+ key* 1))))")))
    (t/line! (mut out) (t/cat4 "(let [user* (cast i64 (get " users " edge*)) old* (get "
      (t/cat4 values " user*) next* (& old* fact*)] (when (!= next* old*) (set! (mut " values ") user* next*) (push! (mut work*) (cast u32 user*))))))))")))
    (t/line! (mut out) "(free! (mut work*))))")
    (t/text-of (mut out))))

;;; Dense per-key cardinality, without constructing an inverse adjacency index.
(defn tally-text [(name (slice u8)) (params (slice u8)) (inline bool)
                 (count (slice u8)) (output (slice u8)) (rows Index)] (-> (slice u8))
  (let [(mut out) (t/out-new)]
    (t/line! (mut out) (t/cat4 "(defn " name (if inline " :inline (Always) " " ") (t/cat2 params " (-> void)")))
    (t/line! (mut out) (empty-sized output count))
    (t/line! (mut out) (query rows (t/cat4 "(let [key* (cast i64 " (.key rows) ")] (set! (mut "
      (t/cat4 output ") key* (+ (get " output " key*) (: 1 u32))))"))))
    (t/emit! (mut out) "(do))") (t/text-of (mut out))))
