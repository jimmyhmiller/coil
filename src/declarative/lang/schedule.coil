;;; Ordered rule application and grouped materialization. Queries describe the
;;; rows; scheduling, fixed-point detection, append cursors and per-group order
;;; are derived. Effects may change facts, but not the query's storage topology.
(module lang.schedule)
(import "lang.text" :as t)
(import "lang.relation" :as relation)
(import "lang.template" :as template)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn sweep-text [(name (slice u8)) (params (slice u8)) (inline bool) (mode i64)
                 (rows relation/Index) (effect (slice u8)) (changed (slice u8))] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (push! (mut values) (relation/Column :target "name" :value name))
    (push! (mut values) (relation/Column :target "params" :value params))
    (push! (mut values) (relation/Column :target "policy" :value (if inline " :inline (Always) " " ")))
    (push! (mut values) (relation/Column :target "row" :value (.key rows)))
    (push! (mut values) (relation/Column :target "effect" :value effect))
    (push! (mut values) (relation/Column :target "changed" :value changed))
    (push! (mut values) (relation/Column :target "rows" :value (relation/query rows
      (template/text (cond (= mode 0) "(let [row @row@] @effect@)"
                           (= mode 1) "(let [row @row@ result @effect@] (when @changed@ (set! changed* true)))"
                           :else "(let [row @row@ result @effect@] (when @changed@ (set! matches* (+ matches* 1))))") values))))
    (template/text (cond (= mode 0) "(defn @name@@policy@@params@ (-> void) @rows@ (do))"
                        (= mode 1) "(defn @name@@policy@@params@ (-> void) (let [(mut changed*) true] (while changed* (set! changed* false) @rows@)))"
                        :else "(defn @name@@policy@@params@ (-> i64) (let [(mut matches*) 0] @rows@ matches*))") values)))

(defn grouped-text [(name (slice u8)) (params (slice u8)) (inline bool)
                   (bindings (ArrayList relation/Column)) (groups relation/Index)
                   (rows relation/Index) (reverse bool)] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (for binding bindings (push! (mut values) binding))
    (push! (mut values) (relation/Column :target "name" :value name))
    (push! (mut values) (relation/Column :target "params" :value params))
    (push! (mut values) (relation/Column :target "policy" :value (if inline " :inline (Always) " " ")))
    (push! (mut values) (relation/Column :target "row" :value (.key rows)))
    (push! (mut values) (relation/Column :target "group" :value (.key groups)))
    (push! (mut values) (relation/Column :target "rows" :value
      (relation/query rows (template/text "(push! (mut @target@) @row@)" values))))
    (push! (mut values) (relation/Column :target "reorder" :value
      (if reverse
          (template/text
"(for i* (range 0 (/ count* 2))
   (let [a* (+ begin* i*) z* (- (+ begin* (- count* 1)) i*) value* (get @target@ a*)]
     (set! (mut @target@) a* (get @target@ z*)) (set! (mut @target@) z* value*)))" values)
          "")))
    (push! (mut values) (relation/Column :target "groups" :value
      (relation/query groups (template/text
"(let [group @group@ begin* (len @target@)]
   @rows@
   (let [count* (- (len @target@) begin*)]
@reorder@
     (let [begin (cast u32 begin*) count (cast u32 count*)] @configure@)))" values))))
    (template/text
      "(defn @name@@policy@@params@ (-> void) (clear! (mut @target@)) @groups@ (do))" values)))

;;; In-place stable retention of graph-ID views: no output allocation, and the
;;; metadata hook receives each retained ID's new ordinal before it is written.
(defn retain-text [(name (slice u8)) (params (slice u8)) (inline bool)
                  (bindings (ArrayList relation/Column))] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (for binding bindings (push! (mut values) binding))
    (push! (mut values) (relation/Column :target "name" :value name))
    (push! (mut values) (relation/Column :target "params" :value params))
    (push! (mut values) (relation/Column :target "policy" :value (if inline " :inline (Always) " " ")))
    (template/text
"(defn @name@@policy@@params@ (-> void)
  (let [(mut kept*) 0]
    (for i* (range 0 (len @data@))
      (let [v (: (get @data@ i*) u32) index (cast u32 kept*)]
        (when @keep@ @configure@
          (set! (mut @data@) kept* v) (set! kept* (+ kept* 1)))))
    (set! (.len @data@) kept*)))" values)))

;;; Append-only worklists visit every published item once in insertion order.
;;; The effect may append, but cannot remove or reorder pending items. Reading
;;; by index on each step remains valid when an append relocates the buffer.
(defn worklist-text [(name (slice u8)) (params (slice u8)) (inline bool)
                     (queue (slice u8)) (effect (slice u8)) (lifo bool)] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (push! (mut values) (relation/Column :target "name" :value name))
    (push! (mut values) (relation/Column :target "params" :value params))
    (push! (mut values) (relation/Column :target "policy" :value (if inline " :inline (Always) " " ")))
    (push! (mut values) (relation/Column :target "queue" :value queue))
    (push! (mut values) (relation/Column :target "effect" :value effect))
    (template/text (if lifo
"(defn @name@@policy@@params@ (-> void)
   (while (> (len @queue@) 0)
     (let [row (get @queue@ (- (len @queue@) 1))]
       (pop! (mut @queue@)) @effect@)))"
"(defn @name@@policy@@params@ (-> void)
   (let [(mut cursor*) 0]
     (while (< cursor* (len @queue@))
       (let [row (get @queue@ cursor*)] @effect@)
       (set! cursor* (+ cursor* 1)))))") values)))

;;; Ordered folds over pure rows, with an explicit empty identity.
(defn reduce-text [(name (slice u8)) (params (slice u8)) (result (slice u8))
                   (initial (slice u8)) (rows relation/Index) (step (slice u8))] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (push! (mut values) (relation/Column :target "name" :value name))
    (push! (mut values) (relation/Column :target "params" :value params))
    (push! (mut values) (relation/Column :target "result" :value result))
    (push! (mut values) (relation/Column :target "initial" :value initial))
    (push! (mut values) (relation/Column :target "step" :value step))
    (push! (mut values) (relation/Column :target "row" :value (.key rows)))
    (push! (mut values) (relation/Column :target "rows" :value
      (relation/query rows (template/text "(let [row @row@] (set! acc @step@))" values))))
    (template/text "(defn @name@ @params@ (-> @result@) (let [(mut acc) (: @initial@ @result@)] @rows@ acc))" values)))
