;;; The `.layout` language: a file's bytes, described.
;;;
;;;   block header {
;;;     u32 0xfeedfacf
;;;     u32 size(commands)
;;;   }
;;;   block relocs { each r in relocs { u32 r.at * 4   u32 r.symbol.number | 1 << 27 } }
;;;
;;; A file is its blocks in order. A block is fields of a fixed width, text,
;;; the image's code, and repetitions over the image's symbols or relocations.
;;; A field's value may be the size or offset of any block, before or after.
;;; `symbols defined first` gives each symbol its number in the file.
;;;
;;; From it: `write`, the bytes of an image as this kind of file.
(module lang.layout)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "lang.text" :as t)
(import "lang.isa" :as isa)
(import "lang.project" :as project)

(defstruct Y
  [(c t/Cur)
   (target isa/Spec)
   (blocks (ArrayList (slice u8)))
   (symbol-vars (ArrayList (slice u8)))
   (reloc-vars (ArrayList (slice u8)))
   (pointer-vars (ArrayList (slice u8)))])

(defn module-name! [(c (mut t/Cur))] (-> (slice u8))
  (let [(mut name) (t/name! (mut c) "a module name")]
    (while (and (t/at? (mut c) ".") (.glued (t/peek (mut c))))
      (t/advance! (mut c))
      (set! name (t/cat3 name "." (t/name! (mut c) "a module name"))))
    name))

(defn block-index [(y (mut Y)) (c (mut t/Cur)) (at t/Tok) (name (slice u8))] (-> i64)
  (let [i (t/index-of (.blocks y) name)]
    (when (< i 0) (t/die (mut c) at (t/cat2 "no block named " name)))
    i))

(defn level [(op (slice u8))] (-> i64)
  (cond (= op "or") 1
        (= op "and") 2
        (or (= op "==") (= op "!=") (= op "<") (= op "<=") (= op ">") (= op ">=")) 3
        (= op "|") 4
        (= op "&") 5
        (or (= op "<<") (= op ">>")) 6
        (or (= op "+") (= op "-")) 7
        (or (= op "*") (= op "/") (= op "%")) 8
        :else 0))

;;; `r.kind(branch26: 2, page21: 3, else 0)`: a number by the relocation's name.
(defn kind-text [(y (mut Y)) (var (slice u8))] (-> (slice u8))
  (let [(mut o) (t/out-new)
        (mut otherwise) "0"]
    (t/emit! (mut o) (t/cat3 "(let [k* (get (.reloc-op im) " var ")] (cond"))
    (while (not (t/accept! (mut (.c y)) ")"))
      (let [at (t/peek (mut (.c y)))
            name (t/name! (mut (.c y)) "a relocation name or else")]
        (if (= name "else")
            (set! otherwise (expr (mut y) 0))
            (do (t/expect! (mut (.c y)) ":")
                (let [value (expr (mut y) 0)
                      (mut any) false]
                  ; Every instruction that carries this relocation.
                  (t/emit! (mut o) " (or false")
                  (for i (range 0 (len (.insts (.target y))))
                    (when (= (.reloc (get (.insts (.target y)) i)) name)
                      (set! any true)
                      (t/emit! (mut o) (t/cat3 " (= k* " (t/int-text (+ i 1)) ")"))))
                  (unless any (t/die (mut (.c y)) at (t/cat2 "the target has no relocation named " name)))
                  (t/emit! (mut o) (t/cat3 ") " value "")))))
        (t/accept! (mut (.c y)) ",")))
    (t/emit! (mut o) (t/cat3 " :else " otherwise "))"))
    (t/text-of (mut o))))

(defn primary [(y (mut Y))] (-> (slice u8))
  (let [tok (t/advance! (mut (.c y)))
        name (.text tok)]
    (cond
      (= (.kind tok) t/T-NUM) (t/int-text (cast i64 (.value tok)))
      (t/tok-is? tok "(")
        (let [e (expr (mut y) 0)]
          (t/expect! (mut (.c y)) ")")
          e)
      (= name "if")
        (let [test (expr (mut y) 0)]
          (t/expect! (mut (.c y)) "then")
          (let [yes (expr (mut y) 0)]
            (t/expect! (mut (.c y)) "else")
            (t/cat4 "(if " test " " (t/cat4 yes " " (expr (mut y) 0) ")"))))
      (= name "not") (t/cat3 "(not " (primary (mut y)) ")")
      (or (= name "size") (= name "offset"))
        (do (t/expect! (mut (.c y)) "(")
            (let [at (t/peek (mut (.c y)))
                  block (t/name! (mut (.c y)) "a block name")]
              (t/expect! (mut (.c y)) ")")
              (t/cat4 "(get " (if (= name "size") "sizes " "offsets ")
                      (t/int-text (block-index (mut y) (mut (.c y)) at block)) ")")))
      (= name "count")
        (do (t/expect! (mut (.c y)) "(")
            (let [what (t/name! (mut (.c y)) "symbols, defined, undefined or relocs")]
              (t/expect! (mut (.c y)) ")")
              (cond (= what "symbols") "(len (.names im))"
                    (= what "defined") "defined-count"
                    (= what "undefined") "(- (len (.names im)) defined-count)"
                    (= what "relocs") "(len (.reloc-at im))"
                    (= what "pointers") "(len (.pointer-at im))"
                    :else (t/die (mut (.c y)) tok "count takes symbols, defined, undefined, relocs or pointers"))))
      (= name "bytes") "(len (.code im))"
      ; A symbol in a repetition: `s.defined`, `s.value`, `s.number`, `s.strx`.
      (>= (t/index-of (.symbol-vars y) name) 0)
        (do (t/expect! (mut (.c y)) ".")
            (let [field (t/name! (mut (.c y)) "a symbol's field")]
              (cond (= field "defined") (t/cat3 "(>= (get (.defined im) " name ") 0)")
                    (= field "value") (t/cat3 "(get (.defined im) " name ")")
                    (= field "in-data") (t/cat3 "(get (.in-data im) " name ")")
                    (= field "number") (t/cat3 "(get numbers " name ")")
                    (= field "strx") (t/cat3 "(get strx " name ")")
                    :else (t/die (mut (.c y)) tok "a symbol has defined, value, number and strx"))))
      ; A pointer in the data: `p.at`, `p.symbol.number`.
      (>= (t/index-of (.pointer-vars y) name) 0)
        (do (t/expect! (mut (.c y)) ".")
            (let [field (t/name! (mut (.c y)) "a pointer's field")]
              (cond (= field "at") (t/cat3 "(get (.pointer-at im) " name ")")
                    (= field "symbol")
                      (do (t/expect! (mut (.c y)) ".")
                          (t/expect! (mut (.c y)) "number")
                          (t/cat3 "(get numbers (get (.pointer-symbol im) " name "))"))
                    :else (t/die (mut (.c y)) tok "a pointer has at and symbol.number"))))
      ; A relocation: `r.at`, `r.symbol.number`, `r.kind(…)`.
      (>= (t/index-of (.reloc-vars y) name) 0)
        (do (t/expect! (mut (.c y)) ".")
            (let [field (t/name! (mut (.c y)) "a relocation's field")]
              (cond (= field "at") (t/cat3 "(get (.reloc-at im) " name ")")
                    (= field "symbol")
                      (do (t/expect! (mut (.c y)) ".")
                          (t/expect! (mut (.c y)) "number")
                          (t/cat3 "(get numbers (get (.reloc-symbol im) " name "))"))
                    (= field "kind")
                      (do (t/expect! (mut (.c y)) "(")
                          (kind-text (mut y) name))
                    :else (t/die (mut (.c y)) tok "a relocation has at, symbol.number and kind(…)"))))
      :else (t/die (mut (.c y)) tok (t/cat2 "expected a value, found " name)))))

(defn expr [(y (mut Y)) (min i64)] (-> (slice u8))
  (let [(mut left) (primary (mut y))
        (mut going) true]
    (while going
      (let [tok (t/peek (mut (.c y)))
            l (if (.first tok) 0 (level (.text tok)))]
        (if (and (> l 0) (> l min))
            (do (t/advance! (mut (.c y)))
                (let [right (expr (mut y) l)
                      op (if (= (.text tok) "==") "=" (.text tok))]
                  (set! left (t/cat4 (t/cat3 "(" op " ") left " " (t/cat2 right ")")))))
            (set! going false))))
    left))

;;; A block's items up to `}`, as Coil that appends to `out`.
(defn items [(y (mut Y))] (-> (slice u8))
  (let [(mut o) (t/out-new)]
    (while (not (t/accept! (mut (.c y)) "}"))
      (let [tok (t/advance! (mut (.c y)))
            name (.text tok)]
        (cond
          (= name "u8") (t/emit! (mut o) (t/cat3 " (bytes/u8! (mut out) " (expr (mut y) 0) ")"))
          (= name "u16") (t/emit! (mut o) (t/cat3 " (bytes/u16! (mut out) " (expr (mut y) 0) ")"))
          (= name "u32") (t/emit! (mut o) (t/cat3 " (bytes/u32! (mut out) " (expr (mut y) 0) ")"))
          (= name "u64") (t/emit! (mut o) (t/cat3 " (bytes/u64! (mut out) " (expr (mut y) 0) ")"))
          ; `text "name" pad 16`, or `text s.name` for a symbol's own name.
          (= name "text")
            (let [what (t/advance! (mut (.c y)))
                  source (if (= (.kind what) t/T-STR)
                             (t/cat3 "\"" (.text what) "\"")
                             (do (t/expect! (mut (.c y)) ".")
                                 (t/expect! (mut (.c y)) "name")
                                 (when (< (t/index-of (.symbol-vars y) (.text what)) 0)
                                   (t/die (mut (.c y)) what "text takes a string or a symbol's name"))
                                 (t/cat3 "(get (.names im) " (.text what) ")")))
                  pad (if (t/accept! (mut (.c y)) "pad") (expr (mut y) 0) "0")]
              ; A symbol's name is written with the file's prefix.
              (when (!= (.kind what) t/T-STR) (t/emit! (mut o) " (bytes/text! (mut out) PREFIX 0)"))
              (t/emit! (mut o) (t/cat4 " (bytes/text! (mut out) " source " " (t/cat2 pad ")"))))
          (= name "code") (t/emit! (mut o) " (for b (.code im) (push! (mut out) b))")
          (= name "data") (t/emit! (mut o) " (for b (.data im) (push! (mut out) b))")
          (= name "align")
            (t/emit! (mut o) (t/cat3 " (bytes/align! (mut out) " (expr (mut y) 0) ")"))
          (= name "each")
            (let [var (t/name! (mut (.c y)) "a name")]
              (t/expect! (mut (.c y)) "in")
              (let [at (t/peek (mut (.c y)))
                    what (t/name! (mut (.c y)) "symbols or relocs")]
                (t/expect! (mut (.c y)) "{")
                (cond
                  (= what "symbols")
                    (do (push! (mut (.symbol-vars y)) var)
                        (t/emit! (mut o) (t/cat4 " (for " var " order (do" (t/cat2 (items (mut y)) "))")))
                        (pop! (mut (.symbol-vars y))))
                  (= what "relocs")
                    (do (push! (mut (.reloc-vars y)) var)
                        (t/emit! (mut o)
                                 (t/cat4 " (for " var " (range 0 (len (.reloc-at im))) (do"
                                         (t/cat2 (items (mut y)) "))")))
                        (pop! (mut (.reloc-vars y))))
                  (= what "pointers")
                    (do (push! (mut (.pointer-vars y)) var)
                        (t/emit! (mut o)
                                 (t/cat4 " (for " var " (range 0 (len (.pointer-at im))) (do"
                                         (t/cat2 (items (mut y)) "))")))
                        (pop! (mut (.pointer-vars y))))
                  :else (t/die (mut (.c y)) at "each runs over symbols, relocs or pointers"))))
          :else (t/die (mut (.c y)) tok (t/cat2 "expected a field, found " name)))))
    (t/text-of (mut o))))

(defn module-text [(context Code)] (-> (slice u8))
  (let [p (project/open context)
        path (t/path-of context)
        src (t/source-of context)
        (mut c) (t/cursor src path)]
    (t/expect! (mut c) "target")
    (let [at (t/peek (mut c))
          target (module-name! (mut c))
          file (project/file-of p target (.line at) (.col at))
          (mut y) (Y
                    :c c
                    :target (isa/parse (project/read-file file path) file)
                    :blocks (ArrayList::new [(slice u8)] (malloc-allocator))
                    :symbol-vars (ArrayList::new [(slice u8)] (malloc-allocator))
                    :reloc-vars (ArrayList::new [(slice u8)] (malloc-allocator))
                    :pointer-vars (ArrayList::new [(slice u8)] (malloc-allocator)))
          (mut o) (t/out-new)
          (mut body) (t/out-new)
          (mut prefix) ""]
      ; Block names first, so a field may name a block that comes later.
      (let [(mut scan) (t/cursor src path)]
        (while (not (t/eof? (mut scan)))
          (let [tok (t/advance! (mut scan))]
            (when (and (t/tok-is? tok "block") (= (.col tok) 1))
              (push! (mut (.blocks y)) (t/name! (mut scan) "a block name"))))))
      (while (not (t/eof? (mut (.c y))))
        (let [tok (t/advance! (mut (.c y)))]
          (cond
            (t/tok-is? tok "symbols")
              (do (t/expect! (mut (.c y)) "defined") (t/expect! (mut (.c y)) "first"))
            ; `prefix "_"`: what every symbol's name starts with in the file.
            (t/tok-is? tok "prefix") (set! prefix (.text (t/advance! (mut (.c y)))))
            (t/tok-is? tok "block")
              (let [name (t/name! (mut (.c y)) "a block name")
                    index (t/index-of (.blocks y) name)]
                (t/expect! (mut (.c y)) "{")
                (t/line! (mut body) (t/cat3 "    (set! (mut offsets) " (t/int-text index) " (len out))"))
                (t/line! (mut body) (t/cat3 "    (do" (items (mut y)) " (do))"))
                (t/line! (mut body)
                         (t/cat4 "    (set! (mut sizes) " (t/int-text index) " (- (len out) (get offsets "
                                 (t/cat2 (t/int-text index) ")))"))))
            :else (t/die (mut (.c y)) tok (t/cat2 "expected block, symbols or prefix, found " (.text tok))))))
      (t/line! (mut o) (t/cat3 "(depends-on \"" file "\")"))
      (t/line! (mut o) "(import \"coil.alloc\" :use [Allocator])")
      (t/line! (mut o) "(import \"coil.arraylist\" :use [ArrayList])")
      (t/line! (mut o) "(import \"declarative.rt.image\" :as image)")
      (t/line! (mut o) "(import \"declarative.rt.bytes\" :as bytes)")
      (t/line! (mut o) (t/cat3 "(const PREFIX \"" prefix "\")"))
      (t/line! (mut o) (t/cat3 "(const BLOCKS " (t/int-text (len (.blocks y))) ")"))
      (t/line! (mut o) "(defn emit [(im image/Image) (out (mut (ArrayList u8))) (sizes (mut (ArrayList i64)))")
      (t/line! (mut o) "            (offsets (mut (ArrayList i64))) (order (ArrayList i64)) (numbers (ArrayList i64))")
      (t/line! (mut o) "            (strx (ArrayList i64)) (defined-count i64)] (-> void)")
      (t/line! (mut o) "  (do")
      (t/emit! (mut o) (t/text-of (mut body)))
      (t/line! (mut o) "    (do)))")
      (t/line! (mut o) ";;; The image as a file of this layout. Symbols the image defines are numbered")
      (t/line! (mut o) ";;; first; a symbol's name starts at `strx` in a table of names that begins")
      (t/line! (mut o) ";;; with one zero byte and gives each name its prefix and a zero after it.")
      (t/line! (mut o) "(defn write [(im image/Image) (a (dyn Allocator))] (-> (ArrayList u8))")
      (t/line! (mut o) "  (let [(mut out) (ArrayList::new [u8] a)")
      (t/line! (mut o) "        (mut sizes) (ArrayList::new [i64] a)")
      (t/line! (mut o) "        (mut offsets) (ArrayList::new [i64] a)")
      (t/line! (mut o) "        (mut order) (ArrayList::new [i64] a)")
      (t/line! (mut o) "        (mut numbers) (ArrayList::new [i64] a)")
      (t/line! (mut o) "        (mut strx) (ArrayList::new [i64] a)")
      (t/line! (mut o) "        (mut defined-count) 0")
      (t/line! (mut o) "        (mut at) 1]")
      (t/line! (mut o) "    (for _ (range 0 BLOCKS) (push! (mut sizes) 0) (push! (mut offsets) 0))")
      (t/line! (mut o) "    (for s (range 0 (len (.names im))) (push! (mut numbers) 0) (push! (mut strx) 0))")
      (t/line! (mut o) "    (for s (range 0 (len (.names im)))")
      (t/line! (mut o) "      (when (>= (get (.defined im) s) 0) (push! (mut order) s) (set! defined-count (+ defined-count 1))))")
      (t/line! (mut o) "    (for s (range 0 (len (.names im)))")
      (t/line! (mut o) "      (when (< (get (.defined im) s) 0) (push! (mut order) s)))")
      (t/line! (mut o) "    (for i (range 0 (len order))")
      (t/line! (mut o) "      (set! (mut numbers) (get order i) i)")
      (t/line! (mut o) "      (set! (mut strx) (get order i) at)")
      (t/line! (mut o) "      (set! at (+ at (+ (+ (len PREFIX) (len (get (.names im) (get order i)))) 1))))")
      (t/line! (mut o) "    ; Once for the blocks' sizes and offsets, once with them.")
      (t/line! (mut o) "    (emit im (mut out) (mut sizes) (mut offsets) order numbers strx defined-count)")
      (t/line! (mut o) "    (clear! (mut out))")
      (t/line! (mut o) "    (emit im (mut out) (mut sizes) (mut offsets) order numbers strx defined-count)")
      (t/line! (mut o) "    (free! (mut sizes))")
      (t/line! (mut o) "    (free! (mut offsets))")
      (t/line! (mut o) "    (free! (mut order))")
      (t/line! (mut o) "    (free! (mut numbers))")
      (t/line! (mut o) "    (free! (mut strx))")
      (t/line! (mut o) "    out))")
      (t/text-of (mut o)))))
