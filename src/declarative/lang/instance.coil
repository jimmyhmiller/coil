;;; One Coil file as several modules. A file of this language names the file it
;;; is an instance of, from its own directory, and the imports it answers:
;;;
;;;   instance machine.coil
;;;   answer declarative.target with declarative.target-a64
;;;
;;; is machine.coil with every import of declarative.target importing
;;; declarative.target-a64 instead. That is how the adapter, written once, is a
;;; module for each machine: each `machine-pick` in it is answered by the target
;;; its instance imports. The module's name is the manifest's, as for any file a
;;; reader reads.
(module lang.instance)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "coil.fs" :as fs)
(import "lang.text" :as t)

(defstruct Answer [(module (slice u8)) (with (slice u8)) (line i64)])

;;; The words of `line`, split at spaces.
(defn words [(line (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut start) -1]
    (for i (range 0 (+ (len line) 1))
      (let [space (or (= i (len line)) (= (get line i) #\space))]
        (cond
          (and space (>= start 0)) (do (push! (mut out) (subslice line start i)) (set! start -1))
          (and (not space) (< start 0)) (set! start i)
          :else 0)))
    out))

(defn module-text [(src (slice u8)) (path (slice u8))] (-> (slice u8))
  (let [(mut of) ""
        (mut answers) (ArrayList::new [Answer] (malloc-allocator))
        (mut start) 0
        (mut line-no) 0]
    (for i (range 0 (+ (len src) 1))
      (when (or (= i (len src)) (= (get src i) #\newline))
        (let [line (subslice src start i)
              w (words line)]
          (set! start (+ i 1))
          (set! line-no (+ line-no 1))
          (cond
            (or (= (len w) 0) (= (get (get w 0) 0) #\#)) 0
            (and (= (get w 0) "instance") (= (len w) 2))
              (do (unless (= of "") (t/fail-at path line-no 1 "an instance is of one file"))
                  (set! of (get w 1)))
            (and (= (get w 0) "answer") (and (= (len w) 4) (= (get w 2) "with")))
              (push! (mut answers) (Answer :module (get w 1) :with (get w 3) :line line-no))
            :else (t/fail-at path line-no 1 "expected `instance FILE` or `answer MODULE with OTHER`")))))
    (when (= of "") (t/fail-at path 1 1 "no `instance FILE` line"))
    (let [file (t/cat3 (t/directory path) "/" of)
          text (match (fs/read-file (malloc-allocator) file)
                 (Ok [bytes] bytes)
                 (Err [_] (t/fail-at path 1 1 (t/cat2 "cannot read " file))))
          (mut o) (t/out-new)
          (mut from) 0]
      (for i (range 0 (+ (len text) 1))
        (when (or (= i (len text)) (= (get text i) #\newline))
          (let [line (subslice text from i)]
            (set! from (+ i 1))
            ; The manifest names the module; the file's own name is the file's.
            (unless (and (= i (len text)) (= (len line) 0))
              (unless (and (>= (len line) 8) (= (subslice line 0 8) "(module "))
                (let [(mut out) line]
                  (for a answers
                    (let [import (t/cat3 "(import \"" (.module a) "\"")]
                      (when (and (>= (len out) (len import)) (= (subslice out 0 (len import)) import))
                        (set! out (t/cat3 "(import \"" (.with a) (subslice out (- (len import) 1) (len out)))))))
                  (t/line! (mut o) out)))))))
      (for a answers
        (when (< (t/index-of-text text (t/cat3 "\n(import \"" (.module a) "\"")) 0)
          (t/fail-at path (.line a) 1 (t/cat3 of " imports no module " (.module a)))))
      (t/emit! (mut o) (t/cat3 "(depends-on \"" file "\")"))
      (t/text-of (mut o)))))
