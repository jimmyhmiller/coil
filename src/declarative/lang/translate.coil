;;; Operation-to-node translation. A rule binds CIR value operands by position
;;; and constructs a pure node in the destination graph. The graph type is
;;; either fixed by the rule or inherited from the translated result.
(module lang.translate)
(import "coil.arraylist" :use [ArrayList])
(import "coil.meta" :as meta)
(import "coil.primitive" :as primitive)
(import "lang.ir" :as ir)
(import "lang.ops" :as ops)
(import "lang.pass" :as pass)
(import "lang.project" :as project)
(import "lang.text" :as t)

(defstruct Expr [(body Code) (mask Code)])

(defstruct Rule [(op ops/Op) (expression Expr)])

(defn names! [(c (mut t/Cur))] (-> (ArrayList (slice u8)))
  (let [(mut names) (ArrayList::new [(slice u8)] (meta/expansion-allocator))]
    (t/expect! (mut c) "(")
    (unless (t/accept! (mut c) ")")
      (loop (push! (mut names) (t/name! (mut c) "an operand binding"))
        (when (t/accept! (mut c) ")") (break))
        (t/expect! (mut c) ",")))
    names))

(defn source-op [(c (mut t/Cur)) (source ops/Ops) (at t/Tok)] (-> ops/Op)
  (let [index (ops/op-index source (.text at))]
    (when (< index 0) (t/die (mut c) at "unknown source operation"))
    (get (.ops source) index)))

(defn immediate! [(c (mut t/Cur)) (op ops/Op) (what (slice u8))] (-> Code)
  (let [at (t/peek (mut c))
        field (t/name! (mut c) "a CIR immediate")]
    (cond (and (!= (.imm op) "") (= field (.imm op))) `immediate
          (and (!= (.imm2 op) "") (= field (.imm2 op))) `secondary
          :else
            (t/die (mut c)
                   at
                   (t/cat2 what " must name a source operation immediate")))))

(defn payload-atom! [(c (mut t/Cur)) (op ops/Op)] (-> Code)
  (cond (t/accept! (mut c) "(")
          (let [value (payload! (mut c) op)]
            (t/expect! (mut c) ")")
            value)
        (t/at-num? (mut c)) `~(cast i64 (t/num! (mut c) "an integer"))
        :else (immediate! (mut c) op "literal")))

(defn payload-sum! [(c (mut t/Cur)) (op ops/Op)] (-> Code)
  (let [(mut value) (payload-atom! (mut c) op)]
    (while (or (t/at? (mut c) "+") (t/at? (mut c) "-"))
      (let [add (= (.text (t/advance! (mut c))) "+")
            right (payload-atom! (mut c) op)]
        (set! value
              (if add
                  `(primitive/iadd ~value ~right)
                  `(primitive/isub ~value ~right)))))
    value))

;;; Payload arithmetic computes a word while constructing the graph.
(defn payload! [(c (mut t/Cur)) (op ops/Op)] (-> Code)
  (let [(mut value) (payload-sum! (mut c) op)]
    (while (t/accept! (mut c) "<<")
      (let [right (payload-sum! (mut c) op)]
        (set! value `(<< (: ~value i64) (: ~right i64)))))
    value))

(defn literal! [(c (mut t/Cur)) (target ir/Spec) (op ops/Op)] (-> Code)
  (let [at (t/peek (mut c))
        payload (payload! (mut c) op)
        constant (ir/const-name target)
        id (ir/node-number target constant)]
    (when (= id 0) (t/die (mut c) at "target graph declares no constant node"))
    (let [node (get (.nodes target) (- id 1))]
      (unless (and (= (len (.operands node)) 0)
                   (!= (.payload node) "")
                   (!= (.result node) "")
                   (= (ir/type-number target (.result node)) 0))
        (t/die (mut c) at "target constant must take a type and a payload")))
    (t/expect! (mut c) "at")
    (let [type-at (t/peek (mut c))
          type (t/name! (mut c) "a graph value type")]
      (when (or (= (ir/type-number target type) 0)
                (ir/control-type? target type))
        (t/die (mut c) type-at "unknown graph value type"))
      (let [ty (primitive/code-symbol "nodes/T-" (t/upper type))
            build (primitive/code-symbol "nodes/" (ir/builder-name constant))]
        `(~build (mut g) ~ty (cast u64 ~payload))))))

;;; Compose a unary rule whose immediate is supplied explicitly. Earlier-only
;;; references make the rule graph acyclic and independent of CIR instruction order.
(defn lower! [(c (mut t/Cur))
              (target ir/Spec)
              (bindings (ArrayList (slice u8)))
              (op ops/Op)
              (earlier (ArrayList ops/Op))] (-> Expr)
  (let [at (t/peek (mut c))
        name (t/name! (mut c) "an earlier translation rule")
        (mut id) -1]
    (for i (range 0 (len earlier))
      (when (= (.name (get earlier i)) name) (set! id i)))
    (when (< id 0)
      (t/die (mut c) at "lower requires an earlier translation rule"))
    (let [callee (get earlier id)]
      (unless (and (= (len (.operands callee)) 1)
                   (!= (.imm callee) "")
                   (= (.imm2 callee) ""))
        (t/die (mut c) at "lower requires one graph operand and one immediate"))
      (t/expect! (mut c) "(")
      (let [arg (expression! (mut c) target bindings op earlier)]
        (t/expect! (mut c) ",")
        (let [value (payload! (mut c) op)
              build (primitive/code-symbol "build-rule-" (.number callee))
              mask (primitive/code-symbol "mask-rule-" (.number callee))]
          (t/expect! (mut c) ")")
          (Expr
            :body
              `(let [payload* (: ~value i64)]
                 (~build (mut g)
                    type
                    payload*
                    0
                    (if (= (~mask payload* 0) 0) 0 ~(.body arg))
                    0
                    0))
            :mask `(if (= (~mask (: ~value i64) 0) 0) 0 ~(.mask arg))))))))

(defn guard! [(c (mut t/Cur))
              (target ir/Spec)
              (bindings (ArrayList (slice u8)))
              (op ops/Op)
              (earlier (ArrayList ops/Op))] (-> Expr)
  (let [left (immediate! (mut c) op "guard")
        at (t/advance! (mut c))
        cmp (.text at)]
    (unless (or (= cmp "<")
                (= cmp "<=")
                (= cmp ">")
                (= cmp ">=")
                (= cmp "==")
                (= cmp "!="))
      (t/die (mut c) at "expected an immediate comparison"))
    (let [right (cast i64 (t/num! (mut c) "an integer comparison bound"))
          relation (primitive/code-symbol (if (= cmp "==") "=" cmp))
          test `(~relation ~left ~right)]
      (t/expect! (mut c) "then")
      (let [yes (expression! (mut c) target bindings op earlier)]
        (t/expect! (mut c) "else")
        (let [no (expression! (mut c) target bindings op earlier)]
          (Expr
            :body `(if ~test ~(.body yes) ~(.body no))
            :mask `(if ~test ~(.mask yes) ~(.mask no))))))))

(defn expression! [(c (mut t/Cur))
                   (target ir/Spec)
                   (bindings (ArrayList (slice u8)))
                   (op ops/Op)
                   (earlier (ArrayList ops/Op))]
  (-> Expr)
  (cond (t/accept! (mut c) "literal")
          (Expr :body (literal! (mut c) target op) :mask `0)
        (t/accept! (mut c) "lower") (lower! (mut c) target bindings op earlier)
        (t/accept! (mut c) "if") (guard! (mut c) target bindings op earlier)
        (t/accept! (mut c) "match")
          (dispatch! (mut c) target bindings op earlier)
        (t/tok-is? (t/peek-at (mut c) 1) "(")
          (node! (mut c) target bindings op earlier)
        :else
          (let [at (t/peek (mut c))
                name (t/name! (mut c) "an operand or node construction")
                index (t/index-of bindings name)]
            (when (< index 0)
              (t/die (mut c) at (t/cat2 "unbound operand " name)))
            (Expr
              :body (primitive/code-symbol "arg" index)
              :mask `~(<< 1 index)))))

(defn node! [(c (mut t/Cur))
             (target ir/Spec)
             (bindings (ArrayList (slice u8)))
             (op ops/Op)
             (earlier (ArrayList ops/Op))]
  (-> Expr)
  (let [node-at (t/peek (mut c))
        name (t/name! (mut c) "a target node")
        id (ir/node-number target name)
        (mut args) (primitive/code-list-new)
        (mut mask) `0
        (mut count) 0]
    (when (= id 0) (t/die (mut c) node-at "unknown target node"))
    (t/expect! (mut c) "(")
    (unless (t/accept! (mut c) ")")
      (loop (let [expression (expression! (mut c) target bindings op earlier)]
              (push! (mut args) (.body expression))
              (set! mask `(| ~mask ~(.mask expression))))
        (set! count (+ count 1))
        (when (t/accept! (mut c) ")") (break))
        (t/expect! (mut c) ",")))
    (let [node (get (.nodes target) (- id 1))]
      (unless (and (= (.role node) "pure")
                   (= (.payload node) "")
                   (not (ir/variadic? node))
                   (not (ir/control-node? target node))
                   (!= (.result node) "")
                   (= (ir/type-number target (.result node)) 0)
                   (= count (len (.operands node))))
        (t/die (mut c)
               node-at
               "expected a pure node with matching operand count")))
    (t/expect! (mut c) "at")
    (let [type-at (t/peek (mut c))
          type (t/name! (mut c) "a graph type or result")]
      (unless (or (= type "result")
                  (and (> (ir/type-number target type) 0)
                       (not (ir/control-type? target type))))
        (t/die (mut c) type-at "unknown graph value type"))
      (unless (= type "result")
        (let [node (get (.nodes target) (- id 1))]
          (for constraint (.constraints node)
            (when (= (.var constraint) (.result node))
              (for types (.sets target)
                (when (and (= (.name types) (.set constraint))
                           (< (t/index-of (.members types) type) 0))
                  (t/die (mut c)
                         type-at
                         (t/cat3 type
                                 " is outside target type set "
                                 (.name types)))))))))
      (let [ty
              (if (= type "result")
                  `type
                  (primitive/code-symbol "nodes/T-" (t/upper type)))
            build (primitive/code-symbol "nodes/" (ir/builder-name name))]
        (Expr :body `(~build (mut g) ~ty ~@args) :mask mask)))))

(defn dispatch! [(c (mut t/Cur))
                 (target ir/Spec)
                 (bindings (ArrayList (slice u8)))
                 (op ops/Op)
                 (earlier (ArrayList ops/Op))] (-> Expr)
  (let [immediate (immediate! (mut c) op "match")
        (mut seen) (ArrayList::new [u64] (meta/expansion-allocator))
        (mut arms) (primitive/code-list-new)
        (mut masks) (primitive/code-list-new)]
    (t/expect! (mut c) "{")
    (while (not (t/accept! (mut c) "otherwise"))
      (let [(mut test) `false]
        (loop (let [key-at (t/peek (mut c))
                    key (t/num! (mut c) "an immediate value or otherwise")]
                (for previous seen
                  (when (= previous key)
                    (t/die (mut c) key-at "duplicate immediate case")))
                (push! (mut seen) key)
                (set! test `(or ~test (= ~immediate ~(cast i64 key)))))
          (unless (t/accept! (mut c) ",") (break)))
        (t/expect! (mut c) "=>")
        (let [expression (expression! (mut c) target bindings op earlier)]
          (push! (mut arms) test)
          (push! (mut arms) (.body expression))
          (push! (mut masks) test)
          (push! (mut masks) (.mask expression)))
        (t/expect! (mut c) ";")))
    (t/expect! (mut c) "=>")
    (let [fallback (expression! (mut c) target bindings op earlier)]
      (t/expect! (mut c) ";")
      (t/expect! (mut c) "}")
      (Expr
        :body `(cond ~@arms :else ~(.body fallback))
        :mask `(cond ~@masks :else ~(.mask fallback))))))

(defn rule! [(c (mut t/Cur))
             (source ops/Ops)
             (target ir/Spec)
             (earlier (ArrayList ops/Op))] (-> Rule)
  (let [at (t/peek (mut c))
        _ (t/name! (mut c) "a source operation")
        op (source-op (mut c) source at)
        bindings (names! (mut c))]
    (unless (and (= (.role op) "value") (= (.aux op) ""))
      (t/die (mut c)
             at
             "translation requires a value operation without an auxiliary immediate"))
    (when (or (.variadic op)
              (!= (len bindings) (len (.operands op)))
              (> (len bindings) 3))
      (t/die (mut c)
             at
             "translation requires the operation's fixed arity of at most three"))
    (for i (range 0 (len bindings))
      (when (!= i (t/index-of bindings (get bindings i)))
        (t/die (mut c) at "duplicate operand binding")))
    (t/expect! (mut c) "=>")
    (let [expression (expression! (mut c) target bindings op earlier)]
      (t/expect! (mut c) ";")
      (Rule :op op :expression expression))))

(defn compile-module [(p project/Project) (path (slice u8)) (src (slice u8))]
  (-> Code)
  (let [(mut c) (t/cursor src path)]
    (t/expect! (mut c) "translate")
    (t/expect! (mut c) "from")
    (let [source-pos (t/peek (mut c))
          source-name (pass/module-name! (mut c))
          source-path
            (project/file-of p source-name (.line source-pos) (.col source-pos))]
      (t/expect! (mut c) "to")
      (let [target-pos (t/peek (mut c))
            target-name (pass/module-name! (mut c))
            target-path
              (project/file-of p
                               target-name
                               (.line target-pos)
                               (.col target-pos))
            source (ops/parse (project/read-file source-path path) source-path)
            target (ir/parse (project/read-file target-path path) target-path)
            (mut seen) (ArrayList::new [ops/Op] (meta/expansion-allocator))
            (mut helpers) (primitive/code-list-new)
            (mut masks) (primitive/code-list-new)
            (mut builders) (primitive/code-list-new)]
        (t/expect! (mut c) "{")
        (while (not (t/accept! (mut c) "}"))
          (let [at (t/peek (mut c))
                rule (rule! (mut c) source target seen)
                op (.number (.op rule))
                build (primitive/code-symbol "build-rule-" op)
                mask (primitive/code-symbol "mask-rule-" op)]
            (for prior seen
              (when (= (.number prior) op)
                (t/die (mut c) at "duplicate translation rule")))
            (push! (mut seen) (.op rule))
            (push! (mut helpers)
                   `(defn ~mask [(immediate i64) (secondary i64)] (-> i64)
                      ~(.mask (.expression rule))))
            (push! (mut helpers)
                   `(defn ~build [(g (mut graph/Graph))
                                  (type i32)
                                  (immediate i64)
                                  (secondary i64)
                                  (arg0 i32)
                                  (arg1 i32)
                                  (arg2 i32)] (-> i32)
                      ~(.body (.expression rule))))
            (push! (mut masks) `(= op ~op))
            (push! (mut masks) `(~mask immediate secondary))
            (push! (mut builders) `(= op ~op))
            (push! (mut builders)
                   `(~build (mut g) type immediate secondary arg0 arg1 arg2))))
        (unless (t/eof? (mut c))
          (t/die (mut c) (t/peek (mut c)) "unexpected text after translation"))
        `(do
           (depends-on ~source-path ~target-path)
           (import ~target-name :as nodes)
           (import "coil.primitive" :as primitive)
           (import "declarative.rt.graph" :as graph)
           ~@helpers
           (defn operand-mask [(op i64) (immediate i64) (secondary i64)]
             (-> i64)
             (cond ~@masks :else -1))
           (defn build [(g (mut graph/Graph))
                        (op i64)
                        (type i32)
                        (immediate i64)
                        (secondary i64)
                        (arg0 i32)
                        (arg1 i32)
                        (arg2 i32)] (-> i32)
             (cond ~@builders :else
                   (panic "missing scalar translation for operation {}" op))))))))
