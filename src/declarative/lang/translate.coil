;;; Operation-to-node translation. A rule binds CIR value operands by position
;;; and constructs a pure node in the destination graph. The graph type is
;;; either fixed by the rule or inherited from the translated result.
(module lang.translate)
(import "coil.arraylist" :use [ArrayList])
(import "coil.meta" :as meta)
(import "coil.primitive" :as primitive)
(import "lang.ir" :as ir)
(import "lang.ops" :as ops)
(import "lang.pass" :as pass)
(import "lang.project" :as project)
(import "lang.text" :as t)

(defstruct Rule [(op i64) (arity i64) (body Code)])

(defn names! [(c (mut t/Cur))] (-> (ArrayList (slice u8)))
  (let [(mut names) (ArrayList::new [(slice u8)] (meta/expansion-allocator))]
    (t/expect! (mut c) "(")
    (unless (t/accept! (mut c) ")")
      (loop (push! (mut names) (t/name! (mut c) "an operand binding"))
        (when (t/accept! (mut c) ")") (break))
        (t/expect! (mut c) ",")))
    names))

(defn source-op [(c (mut t/Cur)) (source ops/Ops) (at t/Tok)] (-> ops/Op)
  (let [index (ops/op-index source (.text at))]
    (when (< index 0) (t/die (mut c) at "unknown source operation"))
    (get (.ops source) index)))

(defn node! [(c (mut t/Cur)) (target ir/Spec) (bindings (ArrayList (slice u8)))]
  (-> Code)
  (let [node-at (t/peek (mut c))
        name (t/name! (mut c) "a target node")
        id (ir/node-number target name)
        operands (names! (mut c))
        (mut inputs) (ArrayList::new [i64] (meta/expansion-allocator))]
    (when (= id 0) (t/die (mut c) node-at "unknown target node"))
    (let [node (get (.nodes target) (- id 1))]
      (unless (and (= (.role node) "pure")
                   (= (.payload node) "")
                   (not (ir/variadic? node))
                   (not (ir/control-node? target node))
                   (!= (.result node) "")
                   (= (ir/type-number target (.result node)) 0)
                   (= (len operands) (len (.operands node))))
        (t/die (mut c)
               node-at
               "expected a pure node with matching operand count")))
    (for operand operands
      (let [input (t/index-of bindings operand)]
        (when (< input 0)
          (t/die (mut c) node-at (t/cat2 "unbound operand " operand)))
        (push! (mut inputs) input)))
    (t/expect! (mut c) "at")
    (let [type-at (t/peek (mut c))
          type (t/name! (mut c) "a graph type or result")]
      (unless (or (= type "result")
                  (and (> (ir/type-number target type) 0)
                       (not (ir/control-type? target type))))
        (t/die (mut c) type-at "unknown graph value type"))
      (unless (= type "result")
        (let [node (get (.nodes target) (- id 1))]
          (for constraint (.constraints node)
            (when (= (.var constraint) (.result node))
              (for types (.sets target)
                (when (and (= (.name types) (.set constraint))
                           (< (t/index-of (.members types) type) 0))
                  (t/die (mut c)
                         type-at
                         (t/cat3 type
                                 " is outside target type set "
                                 (.name types)))))))))
      (let [(mut args) (primitive/code-list-new)
            ty
              (if (= type "result")
                  `type
                  (primitive/code-symbol "nodes/T-" (t/upper type)))
            build (primitive/code-symbol "nodes/" (ir/builder-name name))]
        (for input inputs
          (push! (mut args) (primitive/code-symbol "arg" input)))
        `(~build (mut g) ~ty ~@args)))))

(defn dispatch! [(c (mut t/Cur))
                 (target ir/Spec)
                 (bindings (ArrayList (slice u8)))
                 (op ops/Op)] (-> Code)
  (let [at (t/peek (mut c))
        field (t/name! (mut c) "an immediate name")
        (mut seen) (ArrayList::new [u64] (meta/expansion-allocator))
        (mut arms) (primitive/code-list-new)]
    (unless (and (!= (.imm op) "") (= field (.imm op)))
      (t/die (mut c)
             at
             "match must name the source operation's first immediate"))
    (t/expect! (mut c) "{")
    (while (not (t/accept! (mut c) "otherwise"))
      (let [key-at (t/peek (mut c))
            key (t/num! (mut c) "an immediate value or otherwise")]
        (for previous seen
          (when (= previous key)
            (t/die (mut c) key-at "duplicate immediate case")))
        (push! (mut seen) key)
        (t/expect! (mut c) "=>")
        (push! (mut arms) `(= immediate ~(cast i64 key)))
        (push! (mut arms) (node! (mut c) target bindings))
        (t/expect! (mut c) ";")))
    (t/expect! (mut c) "=>")
    (let [fallback (node! (mut c) target bindings)]
      (t/expect! (mut c) ";")
      (t/expect! (mut c) "}")
      `(cond ~@arms :else ~fallback))))

(defn rule! [(c (mut t/Cur)) (source ops/Ops) (target ir/Spec)] (-> Rule)
  (let [at (t/peek (mut c))
        _ (t/name! (mut c) "a source operation")
        op (source-op (mut c) source at)
        bindings (names! (mut c))]
    (unless (and (= (.role op) "value")
                 (= (.imm2 op) "")
                 (= (.aux op) ""))
      (t/die (mut c)
             at
             "translation requires a value operation without secondary immediates"))
    (when (or (.variadic op)
              (!= (len bindings) (len (.operands op)))
              (> (len bindings) 3))
      (t/die (mut c)
             at
             "translation requires the operation's fixed arity of at most three"))
    (for i (range 0 (len bindings))
      (when (!= i (t/index-of bindings (get bindings i)))
        (t/die (mut c) at "duplicate operand binding")))
    (t/expect! (mut c) "=>")
    (let [body
            (if (t/accept! (mut c) "match")
                (dispatch! (mut c) target bindings op)
                (do
                  (unless (= (.imm op) "")
                    (t/die (mut c)
                           at
                           "translation must match the operation's immediate"))
                  (node! (mut c) target bindings)))]
      (t/expect! (mut c) ";")
      (Rule
        :op (.number op)
        :arity (len bindings)
        :body body))))

(defn compile-module [(p project/Project) (path (slice u8)) (src (slice u8))]
  (-> Code)
  (let [(mut c) (t/cursor src path)]
    (t/expect! (mut c) "translate")
    (t/expect! (mut c) "from")
    (let [source-pos (t/peek (mut c))
          source-name (pass/module-name! (mut c))
          source-path
            (project/file-of p source-name (.line source-pos) (.col source-pos))]
      (t/expect! (mut c) "to")
      (let [target-pos (t/peek (mut c))
            target-name (pass/module-name! (mut c))
            target-path
              (project/file-of p
                               target-name
                               (.line target-pos)
                               (.col target-pos))
            source (ops/parse (project/read-file source-path path) source-path)
            target (ir/parse (project/read-file target-path path) target-path)
            (mut seen) (ArrayList::new [i64] (meta/expansion-allocator))
            (mut arities) (primitive/code-list-new)
            (mut builders) (primitive/code-list-new)]
        (t/expect! (mut c) "{")
        (while (not (t/accept! (mut c) "}"))
          (let [at (t/peek (mut c))
                rule (rule! (mut c) source target)
                op (.op rule)]
            (for prior seen
              (when (= prior op)
                (t/die (mut c) at "duplicate translation rule")))
            (push! (mut seen) op)
            (push! (mut arities) `(= op ~op))
            (push! (mut arities) `~(.arity rule))
            (push! (mut builders) `(= op ~op))
            (push! (mut builders) (.body rule))))
        (unless (t/eof? (mut c))
          (t/die (mut c) (t/peek (mut c)) "unexpected text after translation"))
        `(do
           (depends-on ~source-path ~target-path)
           (import ~target-name :as nodes)
           (import "declarative.rt.graph" :as graph)
           (defn arity [(op i64)] (-> i64)
             (cond ~@arities :else -1))
           (defn build [(g (mut graph/Graph))
                        (op i64)
                        (type i32)
                        (immediate i64)
                        (arg0 i32)
                        (arg1 i32)
                        (arg2 i32)] (-> i32)
             (cond ~@builders :else
                   (panic "missing scalar translation for operation {}" op))))))))
