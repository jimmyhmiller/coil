;;; Operation-to-node translation. A rule binds CIR value operands by position
;;; and constructs a pure node in the destination graph. The graph type is
;;; either fixed by the rule or inherited from the translated result.
(module lang.translate)
(import "coil.arraylist" :use [ArrayList])
(import "coil.meta" :as meta)
(import "coil.primitive" :as primitive)
(import "lang.ir" :as ir)
(import "lang.ops" :as ops)
(import "lang.pass" :as pass)
(import "lang.project" :as project)
(import "lang.text" :as t)

(defstruct Expr [(body Code) (mask Code)])

(defstruct Rule [(op i64) (expression Expr)])

(defn names! [(c (mut t/Cur))] (-> (ArrayList (slice u8)))
  (let [(mut names) (ArrayList::new [(slice u8)] (meta/expansion-allocator))]
    (t/expect! (mut c) "(")
    (unless (t/accept! (mut c) ")")
      (loop (push! (mut names) (t/name! (mut c) "an operand binding"))
        (when (t/accept! (mut c) ")") (break))
        (t/expect! (mut c) ",")))
    names))

(defn source-op [(c (mut t/Cur)) (source ops/Ops) (at t/Tok)] (-> ops/Op)
  (let [index (ops/op-index source (.text at))]
    (when (< index 0) (t/die (mut c) at "unknown source operation"))
    (get (.ops source) index)))

(defn immediate! [(c (mut t/Cur)) (op ops/Op) (what (slice u8))] (-> Code)
  (let [at (t/peek (mut c))
        field (t/name! (mut c) "a CIR immediate")]
    (cond (and (!= (.imm op) "") (= field (.imm op))) `immediate
          (and (!= (.imm2 op) "") (= field (.imm2 op))) `secondary
          :else
            (t/die (mut c)
                   at
                   (t/cat2 what " must name a source operation immediate")))))

(defn literal! [(c (mut t/Cur)) (target ir/Spec) (op ops/Op)] (-> Code)
  (let [at (t/peek (mut c))
        immediate (immediate! (mut c) op "literal")
        constant (ir/const-name target)
        id (ir/node-number target constant)]
    (when (= id 0) (t/die (mut c) at "target graph declares no constant node"))
    (let [node (get (.nodes target) (- id 1))]
      (unless (and (= (len (.operands node)) 0)
                   (!= (.payload node) "")
                   (!= (.result node) "")
                   (= (ir/type-number target (.result node)) 0))
        (t/die (mut c) at "target constant must take a type and a payload")))
    (t/expect! (mut c) "at")
    (let [type-at (t/peek (mut c))
          type (t/name! (mut c) "a graph value type")]
      (when (or (= (ir/type-number target type) 0)
                (ir/control-type? target type))
        (t/die (mut c) type-at "unknown graph value type"))
      (let [ty (primitive/code-symbol "nodes/T-" (t/upper type))
            build (primitive/code-symbol "nodes/" (ir/builder-name constant))]
        `(~build (mut g) ~ty (cast u64 ~immediate))))))

(defn expression! [(c (mut t/Cur))
                   (target ir/Spec)
                   (bindings (ArrayList (slice u8)))
                   (op ops/Op)]
  (-> Expr)
  (cond (t/accept! (mut c) "literal")
          (Expr :body (literal! (mut c) target op) :mask `0)
        (t/accept! (mut c) "match") (dispatch! (mut c) target bindings op)
        (t/tok-is? (t/peek-at (mut c) 1) "(") (node! (mut c) target bindings op)
        :else
          (let [at (t/peek (mut c))
                name (t/name! (mut c) "an operand or node construction")
                index (t/index-of bindings name)]
            (when (< index 0)
              (t/die (mut c) at (t/cat2 "unbound operand " name)))
            (Expr
              :body (primitive/code-symbol "arg" index)
              :mask `~(<< 1 index)))))

(defn node! [(c (mut t/Cur))
             (target ir/Spec)
             (bindings (ArrayList (slice u8)))
             (op ops/Op)]
  (-> Expr)
  (let [node-at (t/peek (mut c))
        name (t/name! (mut c) "a target node")
        id (ir/node-number target name)
        (mut args) (primitive/code-list-new)
        (mut mask) `0
        (mut count) 0]
    (when (= id 0) (t/die (mut c) node-at "unknown target node"))
    (t/expect! (mut c) "(")
    (unless (t/accept! (mut c) ")")
      (loop (let [expression (expression! (mut c) target bindings op)]
              (push! (mut args) (.body expression))
              (set! mask `(| ~mask ~(.mask expression))))
        (set! count (+ count 1))
        (when (t/accept! (mut c) ")") (break))
        (t/expect! (mut c) ",")))
    (let [node (get (.nodes target) (- id 1))]
      (unless (and (= (.role node) "pure")
                   (= (.payload node) "")
                   (not (ir/variadic? node))
                   (not (ir/control-node? target node))
                   (!= (.result node) "")
                   (= (ir/type-number target (.result node)) 0)
                   (= count (len (.operands node))))
        (t/die (mut c)
               node-at
               "expected a pure node with matching operand count")))
    (t/expect! (mut c) "at")
    (let [type-at (t/peek (mut c))
          type (t/name! (mut c) "a graph type or result")]
      (unless (or (= type "result")
                  (and (> (ir/type-number target type) 0)
                       (not (ir/control-type? target type))))
        (t/die (mut c) type-at "unknown graph value type"))
      (unless (= type "result")
        (let [node (get (.nodes target) (- id 1))]
          (for constraint (.constraints node)
            (when (= (.var constraint) (.result node))
              (for types (.sets target)
                (when (and (= (.name types) (.set constraint))
                           (< (t/index-of (.members types) type) 0))
                  (t/die (mut c)
                         type-at
                         (t/cat3 type
                                 " is outside target type set "
                                 (.name types)))))))))
      (let [ty
              (if (= type "result")
                  `type
                  (primitive/code-symbol "nodes/T-" (t/upper type)))
            build (primitive/code-symbol "nodes/" (ir/builder-name name))]
        (Expr :body `(~build (mut g) ~ty ~@args) :mask mask)))))

(defn dispatch! [(c (mut t/Cur))
                 (target ir/Spec)
                 (bindings (ArrayList (slice u8)))
                 (op ops/Op)] (-> Expr)
  (let [immediate (immediate! (mut c) op "match")
        (mut seen) (ArrayList::new [u64] (meta/expansion-allocator))
        (mut arms) (primitive/code-list-new)
        (mut masks) (primitive/code-list-new)]
    (t/expect! (mut c) "{")
    (while (not (t/accept! (mut c) "otherwise"))
      (let [key-at (t/peek (mut c))
            key (t/num! (mut c) "an immediate value or otherwise")]
        (for previous seen
          (when (= previous key)
            (t/die (mut c) key-at "duplicate immediate case")))
        (push! (mut seen) key)
        (t/expect! (mut c) "=>")
        (let [test `(= ~immediate ~(cast i64 key))
              expression (expression! (mut c) target bindings op)]
          (push! (mut arms) test)
          (push! (mut arms) (.body expression))
          (push! (mut masks) test)
          (push! (mut masks) (.mask expression)))
        (t/expect! (mut c) ";")))
    (t/expect! (mut c) "=>")
    (let [fallback (expression! (mut c) target bindings op)]
      (t/expect! (mut c) ";")
      (t/expect! (mut c) "}")
      (Expr
        :body `(cond ~@arms :else ~(.body fallback))
        :mask `(cond ~@masks :else ~(.mask fallback))))))

(defn rule! [(c (mut t/Cur)) (source ops/Ops) (target ir/Spec)] (-> Rule)
  (let [at (t/peek (mut c))
        _ (t/name! (mut c) "a source operation")
        op (source-op (mut c) source at)
        bindings (names! (mut c))]
    (unless (and (= (.role op) "value") (= (.aux op) ""))
      (t/die (mut c)
             at
             "translation requires a value operation without an auxiliary immediate"))
    (when (or (.variadic op)
              (!= (len bindings) (len (.operands op)))
              (> (len bindings) 3))
      (t/die (mut c)
             at
             "translation requires the operation's fixed arity of at most three"))
    (for i (range 0 (len bindings))
      (when (!= i (t/index-of bindings (get bindings i)))
        (t/die (mut c) at "duplicate operand binding")))
    (t/expect! (mut c) "=>")
    (let [expression (expression! (mut c) target bindings op)]
      (t/expect! (mut c) ";")
      (Rule :op (.number op) :expression expression))))

(defn compile-module [(p project/Project) (path (slice u8)) (src (slice u8))]
  (-> Code)
  (let [(mut c) (t/cursor src path)]
    (t/expect! (mut c) "translate")
    (t/expect! (mut c) "from")
    (let [source-pos (t/peek (mut c))
          source-name (pass/module-name! (mut c))
          source-path
            (project/file-of p source-name (.line source-pos) (.col source-pos))]
      (t/expect! (mut c) "to")
      (let [target-pos (t/peek (mut c))
            target-name (pass/module-name! (mut c))
            target-path
              (project/file-of p
                               target-name
                               (.line target-pos)
                               (.col target-pos))
            source (ops/parse (project/read-file source-path path) source-path)
            target (ir/parse (project/read-file target-path path) target-path)
            (mut seen) (ArrayList::new [i64] (meta/expansion-allocator))
            (mut masks) (primitive/code-list-new)
            (mut builders) (primitive/code-list-new)]
        (t/expect! (mut c) "{")
        (while (not (t/accept! (mut c) "}"))
          (let [at (t/peek (mut c))
                rule (rule! (mut c) source target)
                op (.op rule)]
            (for prior seen
              (when (= prior op)
                (t/die (mut c) at "duplicate translation rule")))
            (push! (mut seen) op)
            (push! (mut masks) `(= op ~op))
            (push! (mut masks) (.mask (.expression rule)))
            (push! (mut builders) `(= op ~op))
            (push! (mut builders) (.body (.expression rule)))))
        (unless (t/eof? (mut c))
          (t/die (mut c) (t/peek (mut c)) "unexpected text after translation"))
        `(do
           (depends-on ~source-path ~target-path)
           (import ~target-name :as nodes)
           (import "declarative.rt.graph" :as graph)
           (defn operand-mask [(op i64) (immediate i64) (secondary i64)]
             (-> i64)
             (cond ~@masks :else -1))
           (defn build [(g (mut graph/Graph))
                        (op i64)
                        (type i32)
                        (immediate i64)
                        (secondary i64)
                        (arg0 i32)
                        (arg1 i32)
                        (arg2 i32)] (-> i32)
             (cond ~@builders :else
                   (panic "missing scalar translation for operation {}" op))))))))
