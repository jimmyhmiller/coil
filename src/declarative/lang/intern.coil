;;; Interned construction with either a bounded dense key domain or ordered key
;;; and value columns. A constructor runs only on a miss. Dense-domain bypasses
;;; do not evaluate the key or touch the cache; keyed insertion preserves order.
(module lang.intern)
(import "lang.text" :as t)
(import "lang.relation" :as relation)
(import "lang.template" :as template)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn text [(name (slice u8)) (params (slice u8)) (result (slice u8))
            (bindings (ArrayList relation/Column)) (keyed bool)] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (for binding bindings (push! (mut values) binding))
    (push! (mut values) (relation/Column :target "name" :value name))
    (push! (mut values) (relation/Column :target "params" :value params))
    (push! (mut values) (relation/Column :target "result" :value result))
    (template/text (if keyed
"(defn @name@ @params@ (-> @result@)
  (block :intern*
    (let [key* @key@]
      (for i* (range 0 (len @keys@))
        (when (= (get @keys@ i*) key*) (return-from :intern* (get @values@ i*))))
      (let [value* @compute@]
        (push! (mut @keys@) key*) (push! (mut @values@) value*) value*))))"
"(defn @name@ @params@ (-> @result@)
  (if @eligible@
      (let [key* (cast i64 @key@) value* (get @values@ key*)]
        (if (!= value* @absent@) value*
            (let [created* @compute@] (set! (mut @values@) key* created*) created*)))
      @compute@))") values)))
