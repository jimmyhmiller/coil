;;; A ragged row with column-major planes. Its full storage is reserved and its
;;; shape is published before resolving row values. Nested resolution can append
;;; other rows without changing the reserved row's offsets. The row query supplies
;;; source identities; the schema supplies a resolver and each output plane.
(module lang.gather)
(import "lang.text" :as t)
(import "lang.relation" :as relation)
(import "lang.template" :as template)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn text [(name (slice u8)) (params (slice u8)) (result (slice u8))
            (bindings (ArrayList relation/Column)) (rows relation/Index)
            (columns (ArrayList (slice u8))) (zeros (ArrayList (slice u8)))] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))
        (mut writes) (t/out-new) (mut zeroing) (t/out-new)]
    (for binding bindings (push! (mut values) binding))
    (push! (mut values) (relation/Column :target "name" :value name))
    (push! (mut values) (relation/Column :target "params" :value params))
    (push! (mut values) (relation/Column :target "result" :value result))
    (push! (mut values) (relation/Column :target "width" :value (t/int-text (len columns))))
    (for target zeros
      (t/line! (mut zeroing) (t/cat3 "(extend-zeroed! (mut " target ") total*)")))
    (push! (mut values) (relation/Column :target "zeroing" :value (t/text-of (mut zeroing))))
    (for i (range 0 (len columns))
      (let [(mut cell) (ArrayList::new [relation/Column] (malloc-allocator))]
        (for binding bindings (push! (mut cell) binding))
        (push! (mut cell) (relation/Column :target "plane" :value (t/int-text i)))
        (push! (mut cell) (relation/Column :target "column" :value (get columns i)))
        (t/line! (mut writes) (template/text
          "(set! (mut @data@) (cast i64 (+ base (+ (* count (: @plane@ u32)) ordinal*))) @column@)" cell))))
    (push! (mut values) (relation/Column :target "row" :value (.key rows)))
    (push! (mut values) (relation/Column :target "writes" :value (t/text-of (mut writes))))
    (push! (mut values) (relation/Column :target "rows" :value
      (relation/query rows (template/text
        "(let [row @row@ value @resolve@] @writes@ (set! ordinal* (+ ordinal* (: 1 u32))))" values))))
    (template/text
"(defn @name@ @params@ (-> @result@)
  (let [base* (cast u32 (len @data@)) count* (cast u32 @count@) width* (: @width@ u32)
        total* (cast i64 (* count* width*))]
    (extend-zeroed! (mut @data@) total*) @zeroing@
    (let [base base* count count* width width*]
      @configure@
      (let [(mut ordinal*) (: 0 u32)] @rows@)
      @finish@)))" values)))
