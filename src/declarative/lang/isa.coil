;;; The `.isa` language: a machine's registers and instruction encodings.
;;;
;;;   word 32
;;;   class gpr 5
;;;   reg x0..x30 : gpr
;;;   set callee-saved = x19..x28
;;;   inst add-imm(sf: u1, rd: def gpr, rn: use gpr, imm: u12) = sf 0 0 100010 0 imm rn rd
;;;
;;; An encoding is the instruction's bits from the most significant: literal bits
;;; and operand fields, which must add up to the word. From it: instruction
;;; numbers, what each operand is (defined, used, an immediate, a label), register
;;; numbers and sets, and an encoder. Other languages read the same file through
;;; `parse`.
(module lang.isa)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "lang.text" :as t)

(const K-NONE 0)
(const K-DEF 1)
(const K-USE 2)
(const K-MOD 3)
(const K-IMM 4)
(const K-LABEL 5)
(const K-SYMBOL 6)

;;; base: the number of the class's first register among all registers.
(defstruct Class [(name (slice u8)) (width i64) (base i64)])

(defstruct Reg [(name (slice u8)) (number i64) (class (slice u8))])

(defstruct RegSet [(name (slice u8)) (members (ArrayList (slice u8)))])

;;; class: a register operand's class. width: an immediate's bits. signed: `sN`.
(defstruct Operand
  [(name (slice u8)) (kind i64) (class (slice u8)) (width i64) (signed bool)])

;;; One piece of an encoding: literal bits, or `width` bits of an operand.
;;; `low`: the operand's bit this piece starts at, for a field written `to[20:2]`.
(defstruct Piece [(bits (slice u8)) (field (slice u8)) (width i64) (low i64)])

;;; reloc: the relocation's name, or "". formula: Coil for the value its symbol
;;; operand takes, over s (the symbol's address), g (its table slot's) and p (the
;;; instruction's).
(defstruct Inst
  [(name (slice u8)) (operands (ArrayList Operand)) (pieces (ArrayList Piece)) (line i64)
   (reloc (slice u8)) (formula (slice u8))
   (reads (ArrayList (slice u8))) (writes (ArrayList (slice u8)))
   (body (slice u8))
   ; For a branch: what branches when this does not, another instruction or
   ; this one with an operand's low bit turned.
   (opposite (slice u8))])

(defstruct Spec
  [(word i64)
   (classes (ArrayList Class))
   (regs (ArrayList Reg))
   (sets (ArrayList RegSet))
   (consts (ArrayList Reg))
   (insts (ArrayList Inst))
   (form-names (ArrayList (slice u8)))
   (form-heads (ArrayList (slice u8)))
   (form-cases (ArrayList (slice u8)))
   ; The most bytes each form writes, whichever case applies, and whether an
   ; instruction or form has used it yet (its cases must all come before).
   (form-longest (ArrayList i64))
   (form-used (ArrayList bool))
   ; The most bytes any instruction takes.
   (longest i64)
   (immediates (ArrayList (slice u8)))
   (immediate-text (slice u8))
   (align i64)])

(defn class-width [(spec Spec) (name (slice u8))] (-> i64)
  (let [(mut width) 0]
    (for c (.classes spec) (when (= (.name c) name) (set! width (.width c))))
    width))

(defn class-index [(spec Spec) (name (slice u8))] (-> i64)
  (let [(mut found) 0]
    (for i (range 0 (len (.classes spec)))
      (when (= (.name (get (.classes spec) i)) name) (set! found i)))
    found))

(defn reg-number [(spec Spec) (name (slice u8))] (-> i64)
  (let [(mut number) -1]
    (for r (.regs spec) (when (= (.name r) name) (set! number (.number r))))
    number))

;;; A named constant's value, or -1.
(defn const-number [(spec Spec) (name (slice u8))] (-> i64)
  (let [(mut number) -1]
    (for k (.consts spec) (when (= (.name k) name) (set! number (.number k))))
    number))

;;; An instruction's number, from 1 in declaration order, or 0.
(defn inst-number [(spec Spec) (name (slice u8))] (-> i64)
  (let [(mut found) 0]
    (for i (range 0 (len (.insts spec)))
      (when (= (.name (get (.insts spec) i)) name) (set! found (+ i 1))))
    found))

(defn operand-index [(inst Inst) (name (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for i (range 0 (len (.operands inst)))
      (when (= (.name (get (.operands inst) i)) name) (set! found i)))
    found))

;;; `x0..x30` as its names: a shared prefix and a run of numbers.
(defn expand-range [(c (mut t/Cur)) (at t/Tok) (lo (slice u8)) (hi (slice u8))]
  (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut split) (len lo)]
    (while (and (> split 0) (t/digit? (get lo (- split 1)))) (set! split (- split 1)))
    (let [prefix (t/slice-of lo 0 split)
          (mut a) 0
          (mut b) 0]
      (when (or (= split (len lo)) (< (len hi) (+ split 1)) (!= (t/slice-of hi 0 split) prefix))
        (t/die (mut c) at "a register range is NAMEn..NAMEm"))
      (for i (range split (len lo)) (set! a (+ (* a 10) (cast i64 (- (get lo i) #\0)))))
      (for i (range split (len hi)) (set! b (+ (* b 10) (cast i64 (- (get hi i) #\0)))))
      (for n (range a (+ b 1)) (push! (mut out) (t/cat2 prefix (t/int-text n)))))
    out))

;;; Register names up to the end of the line: names and ranges.
(defn parse-reg-list [(c (mut t/Cur))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (while (and (t/at-ident? (mut c)) (not (t/at-line-start? (mut c))))
      (let [at (t/peek (mut c))
            name (t/name! (mut c) "a register")]
        (if (t/accept! (mut c) "..")
            (for r (expand-range (mut c) at name (t/name! (mut c) "a register")) (push! (mut out) r))
            (push! (mut out) name))))
    out))

(defn parse-operand [(c (mut t/Cur)) (spec Spec)] (-> Operand)
  (let [name (t/name! (mut c) "an operand name")]
    (t/expect! (mut c) ":")
    (let [at (t/peek (mut c))
          word (t/name! (mut c) "def, use, mod, label, symbol or an immediate type")]
      (cond
        (or (= word "def") (= word "use") (= word "mod"))
          (let [class (t/name! (mut c) "a register class")]
            (when (= (class-width spec class) 0) (t/die (mut c) at (t/cat2 "no class named " class)))
            (Operand
              :name name
              :kind (cond (= word "def") K-DEF (= word "use") K-USE :else K-MOD)
              :class class
              :width (class-width spec class)
              :signed false))
        (= word "label") (Operand :name name :kind K-LABEL :class "" :width 0 :signed true)
        (= word "symbol") (Operand :name name :kind K-SYMBOL :class "" :width 0 :signed true)
        (and (> (len word) 1) (or (= (get word 0) #\u) (= (get word 0) #\s))
             (t/digit? (get word 1)))
          (let [(mut width) 0]
            (for i (range 1 (len word)) (set! width (+ (* width 10) (cast i64 (- (get word i) #\0)))))
            (Operand :name name :kind K-IMM :class "" :width width :signed (= (get word 0) #\s)))
        :else (t/die (mut c) at (t/cat2 "not an operand kind: " word))))))

(defn parse-inst [(c (mut t/Cur)) (spec (mut Spec))] (-> void)
  (let [at (t/peek (mut c))
        name (t/name! (mut c) "an instruction name")
        (mut inst) (Inst
                     :name name
                     :operands (ArrayList::new [Operand] (malloc-allocator))
                     :pieces (ArrayList::new [Piece] (malloc-allocator))
                     :line (.line at)
                     :reloc ""
                     :formula ""
                     :reads (ArrayList::new [(slice u8)] (malloc-allocator))
                     :writes (ArrayList::new [(slice u8)] (malloc-allocator))
                     :body ""
                     :opposite "")
        (mut total) 0]
    (when (!= (inst-number spec name) 0) (t/die (mut c) at (t/cat2 "instruction declared twice: " name)))
    (t/expect! (mut c) "(")
    (unless (t/at? (mut c) ")")
      (let [(mut more) true]
        (while more
          (push! (mut (.operands inst)) (parse-operand (mut c) spec))
          (set! more (t/accept! (mut c) ",")))))
    (t/expect! (mut c) ")")
    (when (> (len (.operands inst)) 5) (t/die (mut c) at "an instruction has at most five operands"))
    (let [(mut labels) 0]
      (for x (.operands inst) (when (= (.kind x) K-LABEL) (set! labels (+ labels 1))))
      (when (> labels 1) (t/die (mut c) at "an instruction has at most one label")))
    (t/expect! (mut c) "=")
    (when (= (.word spec) 0)
      ; A byte-encoded machine: the encoding is pieces over the operands.
      (let [(mut names) (ArrayList::new [(slice u8)] (malloc-allocator))]
        (for operand (.operands inst) (push! (mut names) (.name operand)))
        (let [(mut longest) 0]
          (set! (.body inst) (byte-pieces (mut c) (mut spec) names "" true (mut longest)))
          (when (> longest (.longest spec)) (set! (.longest spec) longest)))))
    (while (and (!= (.word spec) 0) (not (t/at-line-start? (mut c))) (not (t/at? (mut c) "reloc"))
                (not (t/at? (mut c) "reads")) (not (t/at? (mut c) "writes")) (not (t/at? (mut c) "opposite")))
      (let [tok (t/advance! (mut c))]
        (cond
          (= (.kind tok) t/T-NUM)
            (do (for ch (.text tok)
                  (when (and (!= ch #\0) (!= ch #\1)) (t/die (mut c) tok "literal bits are 0s and 1s")))
                (push! (mut (.pieces inst)) (Piece :bits (.text tok) :field "" :width (len (.text tok)) :low 0))
                (set! total (+ total (len (.text tok)))))
          (= (.kind tok) t/T-IDENT)
            (let [index (operand-index inst (.text tok))]
              (when (< index 0) (t/die (mut c) tok (t/cat2 "no operand named " (.text tok))))
              (if (and (t/at? (mut c) "[") (.glued (t/peek (mut c))))
                  ; `to[20:2]`: bits 20 down to 2 of the operand.
                  (do (t/advance! (mut c))
                      (let [high (cast i64 (t/num! (mut c) "the highest bit"))]
                        (t/expect! (mut c) ":")
                        (let [low (cast i64 (t/num! (mut c) "the lowest bit"))]
                          (t/expect! (mut c) "]")
                          (push! (mut (.pieces inst))
                                 (Piece :bits "" :field (.text tok) :width (+ (- high low) 1) :low low))
                          (set! total (+ total (+ (- high low) 1))))))
                  (let [given (if (and (t/at? (mut c) ":") (.glued (t/peek (mut c))))
                                  (do (t/advance! (mut c)) (cast i64 (t/num! (mut c) "a width")))
                                  0)
                        width (if (> given 0) given (.width (get (.operands inst) index)))]
                    (when (= width 0) (t/die (mut c) tok "this field needs a width: `name:bits`"))
                    (push! (mut (.pieces inst)) (Piece :bits "" :field (.text tok) :width width :low 0))
                    (set! total (+ total width)))))
          :else (t/die (mut c) tok (t/cat2 "unexpected in an encoding: " (.text tok))))))
    (when (and (!= (.word spec) 0) (!= total (.word spec)))
      (t/die (mut c) at
             (t/cat4 "the encoding of " name " has " (t/cat4 (t/int-text total) " bits, the word "
                                                             (t/int-text (.word spec)) ""))))
    (when (t/accept! (mut c) "reloc")
      (set! (.reloc inst) (t/name! (mut c) "a relocation name"))
      (t/expect! (mut c) "=")
      (set! (.formula inst) (formula-expr (mut c) 0)))
    ; Registers the instruction reads and writes without naming them as operands.
    (let [(mut more) true]
      (while more
        (cond (t/accept! (mut c) "reads") (set! (.reads inst) (parse-until-keyword (mut c)))
              (t/accept! (mut c) "writes") (set! (.writes inst) (parse-until-keyword (mut c)))
              ; `opposite NAME`: the branch that goes when this one does not.
              (t/accept! (mut c) "opposite") (set! (.opposite inst) (t/name! (mut c) "an instruction or an operand"))
              :else (set! more false))))
    (push! (mut (.insts spec)) inst)))

;;; Register names up to the end of the line or the next `reads` or `writes`.
(defn parse-until-keyword [(c (mut t/Cur))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (while (and (t/at-ident? (mut c)) (not (t/at-line-start? (mut c)))
                (not (t/at? (mut c) "reads")) (not (t/at? (mut c) "writes")) (not (t/at? (mut c) "opposite")))
      (let [at (t/peek (mut c))
            name (t/name! (mut c) "a register")]
        (if (t/accept! (mut c) "..")
            (for r (expand-range (mut c) at name (t/name! (mut c) "a register")) (push! (mut out) r))
            (push! (mut out) name))))
    out))

;; ---------------------------------------------------------------- enumerated immediates

;;; `immediate NAME(p in A B C, q in LO..HI) = VALUE encoded CODE`: a class of
;;; immediates given by listing it. Every choice of the parameters gives one
;;; value and the bits that encode it; the class is the table of them all.
;;; Expressions are evaluated here, as the file is read.
(defstruct Env [(names (ArrayList (slice u8))) (values (ArrayList i64))])

(defn imm-level [(op (slice u8))] (-> i64)
  (cond (= op "|") 1
        (= op "&") 2
        (or (= op "==") (= op "!=") (= op "<") (= op ">")) 3
        (or (= op "<<") (= op ">>")) 4
        (or (= op "+") (= op "-")) 5
        (= op "*") 6
        :else 0))

(defn imm-primary [(c (mut t/Cur)) (env Env)] (-> i64)
  (let [tok (t/advance! (mut c))
        name (.text tok)]
    (cond
      (= (.kind tok) t/T-NUM) (cast i64 (.value tok))
      (t/tok-is? tok "(")
        (let [v (imm-expr (mut c) env 0)]
          (t/expect! (mut c) ")")
          v)
      (t/tok-is? tok "-") (- 0 (imm-primary (mut c) env))
      (t/tok-is? tok "~") (^ (imm-primary (mut c) env) -1)
      (and (t/at? (mut c) "(") (.glued (t/peek (mut c))))
        (do (t/advance! (mut c))
            (let [a (imm-expr (mut c) env 0)
                  b (if (t/accept! (mut c) ",") (imm-expr (mut c) env 0) 0)
                  d (if (t/accept! (mut c) ",") (imm-expr (mut c) env 0) 0)]
              (t/expect! (mut c) ")")
              (cond
                ; The low `a` bits set.
                (= name "low-ones") (if (>= a 64) -1 (- (<< 1 a) 1))
                ; `a` turned right by `b` places within `d` bits.
                (= name "rotate-right")
                  (let [mask (if (>= d 64) (: 0xFFFFFFFFFFFFFFFF u64) (- (<< (: 1 u64) (cast u64 d)) 1))
                        x (& (primitive/cast u64 a) mask)]
                    (primitive/cast i64
                      (if (= b 0) x (& (| (>> x (cast u64 b)) (<< x (cast u64 (- d b)))) mask))))
                ; The low `b` bits of `a`, again and again up to 64 bits.
                (= name "repeat")
                  (let [(mut out) (: 0 u64)
                        mask (if (>= b 64) (: 0xFFFFFFFFFFFFFFFF u64) (- (<< (: 1 u64) (cast u64 b)) 1))
                        (mut at) 0]
                    (while (< at 64)
                      (set! out (| out (<< (& (primitive/cast u64 a) mask) (cast u64 at))))
                      (set! at (+ at b)))
                    (primitive/cast i64 out))
                :else (t/die (mut c) tok (t/cat2 "no function named " name)))))
      (>= (t/index-of (.names env) name) 0) (get (.values env) (t/index-of (.names env) name))
      :else (t/die (mut c) tok (t/cat2 "no such name: " name)))))

(defn imm-expr [(c (mut t/Cur)) (env Env) (min i64)] (-> i64)
  (let [(mut left) (imm-primary (mut c) env)
        (mut going) true]
    (while going
      (let [tok (t/peek (mut c))
            level (if (.first tok) 0 (imm-level (.text tok)))
            op (.text tok)]
        (if (and (> level 0) (> level min))
            (do (t/advance! (mut c))
                (let [right (imm-expr (mut c) env level)]
                  (set! left
                        (cond (= op "|") (| left right)
                              (= op "&") (& left right)
                              (= op "==") (if (= left right) 1 0)
                              (= op "!=") (if (!= left right) 1 0)
                              (= op "<") (if (< left right) 1 0)
                              (= op ">") (if (> left right) 1 0)
                              (= op "<<") (if (>= right 64) 0 (primitive/cast i64 (<< (primitive/cast u64 left) (cast u64 right))))
                              (= op ">>") (if (>= right 64) 0 (primitive/cast i64 (>> (primitive/cast u64 left) (cast u64 right))))
                              (= op "+") (primitive/iadd left right)
                              (= op "-") (primitive/isub left right)
                              :else (primitive/imul left right)))))
            (set! going false))))
    left))

;;; Every choice of the parameters from `depth` on, each adding one value and
;;; code to the lists.
(defn enumerate! [(c (mut t/Cur)) (env (mut Env)) (starts (ArrayList i64)) (depth i64) (body i64)
                  (values (mut (ArrayList u64))) (codes (mut (ArrayList i64)))] (-> void)
  (if (= depth (len starts))
      (do (set! (.pos c) body)
          (let [v (imm-expr (mut c) env 0)]
            (t/expect! (mut c) "encoded")
            (push! (mut values) (primitive/cast u64 v))
            (push! (mut codes) (imm-expr (mut c) env 0))))
      (do
        ; A parameter's choices: listed numbers, or a range whose ends may
        ; depend on the parameters before it.
        (set! (.pos c) (get starts depth))
        (let [name (t/name! (mut c) "a parameter")]
          (t/expect! (mut c) "in")
          (let [first (imm-expr (mut c) env 0)]
            (if (t/accept! (mut c) "..")
                (let [last (imm-expr (mut c) env 0)]
                  (for v (range first (+ last 1))
                    (push! (mut (.names env)) name)
                    (push! (mut (.values env)) v)
                    (enumerate! (mut c) (mut env) starts (+ depth 1) body (mut values) (mut codes))
                    (pop! (mut (.names env)))
                    (pop! (mut (.values env)))))
                (let [(mut choices) (ArrayList::new [i64] (malloc-allocator))]
                  (push! (mut choices) first)
                  (while (t/at-num? (mut c)) (push! (mut choices) (cast i64 (.value (t/advance! (mut c))))))
                  (for v choices
                    (push! (mut (.names env)) name)
                    (push! (mut (.values env)) v)
                    (enumerate! (mut c) (mut env) starts (+ depth 1) body (mut values) (mut codes))
                    (pop! (mut (.names env)))
                    (pop! (mut (.values env)))))))))))

(defn parse-immediate [(c (mut t/Cur)) (spec (mut Spec))] (-> void)
  (let [name (t/name! (mut c) "an immediate class name")
        (mut starts) (ArrayList::new [i64] (malloc-allocator))
        (mut depth) 0]
    (t/expect! (mut c) "(")
    ; Note where each parameter starts, and pass over it.
    (push! (mut starts) (.pos c))
    (set! depth 1)
    (while (> depth 0)
      (let [tok (t/advance! (mut c))]
        (cond (t/tok-is? tok "(") (set! depth (+ depth 1))
              (t/tok-is? tok ")") (set! depth (- depth 1))
              (and (t/tok-is? tok ",") (= depth 1)) (push! (mut starts) (.pos c))
              :else 0)))
    (t/expect! (mut c) "=")
    (let [body (.pos c)
          (mut env) (Env :names (ArrayList::new [(slice u8)] (malloc-allocator))
                         :values (ArrayList::new [i64] (malloc-allocator)))
          (mut values) (ArrayList::new [u64] (malloc-allocator))
          (mut codes) (ArrayList::new [i64] (malloc-allocator))
          (mut o) (t/out-new)]
      (enumerate! (mut c) (mut env) starts 0 body (mut values) (mut codes))
      ; In order of value, each value once, so that a search can find it.
      (let [(mut order) (ArrayList::new [i64] (malloc-allocator))]
        (for i (range 0 (len values))
          (let [(mut lo) 0
                (mut hi) (len order)]
            (while (< lo hi)
              (let [mid (/ (+ lo hi) 2)]
                (if (< (get values (get order mid)) (get values i)) (set! lo (+ mid 1)) (set! hi mid))))
            (unless (and (< lo (len order)) (= (get values (get order lo)) (get values i)))
              (push! (mut order) 0)
              (for j (range 0 (- (- (len order) 1) lo))
                (let [at (- (- (len order) 1) j)]
                  (set! (mut order) at (get order (- at 1)))))
              (set! (mut order) lo i))))
        (t/emit! (mut o) (t/cat3 "(def " (t/upper name) "-VALUES ["))
        (for i order (t/emit! (mut o) (t/cat2 (t/u64-text (get values i)) " ")))
        (t/line! (mut o) "])")
        (t/emit! (mut o) (t/cat3 "(def " (t/upper name) "-CODES ["))
        (for i order (t/emit! (mut o) (t/cat2 (t/int-text (get codes i)) " ")))
        (t/line! (mut o) "])")
        (t/line! (mut o) (t/cat3 ";;; The bits that encode `v` as a " name " immediate, or -1 if it is not one."))
        (t/line! (mut o) (t/cat3 "(defn " name "-code [(v i64)] (-> i64)"))
        (t/line! (mut o) "  (let [want (primitive/cast u64 v)")
        (t/line! (mut o) "        (mut lo) 0")
        (t/line! (mut o) (t/cat3 "        (mut hi) " (t/int-text (len order)) "]"))
        (t/line! (mut o) "    (while (< lo hi)")
        (t/line! (mut o) "      (let [mid (/ (+ lo hi) 2)]")
        (t/line! (mut o) (t/cat3 "        (if (< (get " (t/upper name) "-VALUES mid) want) (set! lo (+ mid 1)) (set! hi mid))))"))
        (t/line! (mut o) (t/cat4 "    (if (and (< lo " (t/int-text (len order)) ") (= (get " (t/cat2 (t/upper name) "-VALUES lo) want))")))
        (t/line! (mut o) (t/cat3 "        (get " (t/upper name) "-CODES lo)"))
        (t/line! (mut o) "        -1)))"))
      (push! (mut (.immediates spec)) name)
      (set! (.immediate-text spec) (t/cat2 (.immediate-text spec) (t/text-of (mut o))))
      ; The cursor is left after the last evaluation of the body.
      (do))))

;; ---------------------------------------------------------------- byte encodings

;;; Arithmetic in a byte encoding or a form: over the names in `names`, which
;;; the Coil text calls by the same names with `prefix` in front.
(defn byte-level [(op (slice u8))] (-> i64)
  (cond (= op "or") 1
        (= op "and") 2
        (or (= op "==") (= op "!=") (= op "<") (= op "<=") (= op ">") (= op ">=")) 3
        (= op "|") 4
        (= op "&") 5
        (or (= op "<<") (= op ">>")) 6
        (or (= op "+") (= op "-")) 7
        :else 0))

(defn byte-primary [(c (mut t/Cur)) (names (ArrayList (slice u8))) (prefix (slice u8))] (-> (slice u8))
  (let [tok (t/advance! (mut c))
        name (.text tok)]
    (cond
      (= (.kind tok) t/T-NUM) (t/int-text (cast i64 (.value tok)))
      (t/tok-is? tok "(")
        (let [e (byte-expr (mut c) names prefix 0)]
          (t/expect! (mut c) ")")
          e)
      (t/tok-is? tok "-") (t/cat3 "(- 0 " (byte-primary (mut c) names prefix) ")")
      (t/tok-is? tok "not") (t/cat3 "(not " (byte-primary (mut c) names prefix) ")")
      ; `s8(x)`, `s32(x)`: the value fits that many bits with a sign.
      (and (or (= name "s8") (= name "s32")) (t/at? (mut c) "("))
        (do (t/advance! (mut c))
            (let [e (byte-expr (mut c) names prefix 0)
                  half (if (= name "s8") "128" "2147483648")]
              (t/expect! (mut c) ")")
              (t/cat4 "(let [v* " e (t/cat3 "] (and (>= v* (- 0 " half ")) (< v* ") (t/cat2 half ")))"))))
      (>= (t/index-of names name) 0) (t/cat2 prefix (if (= prefix "") (arg-name (t/index-of names name)) name))
      :else (t/die (mut c) tok (t/cat2 "no such name in this encoding: " name)))))

(defn byte-expr [(c (mut t/Cur)) (names (ArrayList (slice u8))) (prefix (slice u8)) (min i64)] (-> (slice u8))
  (let [(mut left) (byte-primary (mut c) names prefix)
        (mut going) true]
    (while going
      (let [tok (t/peek (mut c))
            level (if (.first tok) 0 (byte-level (.text tok)))]
        (if (and (> level 0) (> level min))
            (do (t/advance! (mut c))
                (let [right (byte-expr (mut c) names prefix level)
                      op (if (= (.text tok) "==") "=" (.text tok))]
                  (set! left (t/cat4 (t/cat3 "(" op " ") left " " (t/cat2 right ")")))))
            (set! going false))))
    left))

;;; The pieces of a byte encoding, up to the end of the line or a clause that
;;; follows an encoding: bytes, little-endian numbers, forms, and the two that
;;; only an instruction has, a label's distance and a symbol's place.
(defn byte-pieces [(c (mut t/Cur)) (spec (mut Spec)) (names (ArrayList (slice u8))) (prefix (slice u8))
                   (in-inst bool) (longest (mut i64))] (-> (slice u8))
  (let [(mut o) (t/out-new)]
    (while (and (not (t/at-line-start? (mut c))) (not (t/at? (mut c) "reloc"))
                (not (t/at? (mut c) "reads")) (not (t/at? (mut c) "writes")) (not (t/at? (mut c) "opposite")))
      (let [tok (t/advance! (mut c))
            name (.text tok)]
        (if (= name "nothing")
            0
            (do
              (t/expect! (mut c) "(")
              (cond
                (= name "byte")
                  (do (t/emit! (mut o) (t/cat3 " (put-byte! (mut out) (primitive/cast u8 (& " (byte-expr (mut c) names prefix 0) " 255)))"))
                      (set! longest (+ longest 1)))
                (or (= name "le16") (= name "le32") (= name "le64"))
                  (let [bytes (cond (= name "le16") 2 (= name "le32") 4 :else 8)]
                    (t/emit! (mut o)
                             (t/cat4 " (little! (mut out) " (byte-expr (mut c) names prefix 0) " "
                                     (t/cat2 (t/int-text bytes) ")")))
                    (set! longest (+ longest bytes)))
                (and in-inst (= name "rel32"))
                  (do (t/emit! (mut o)
                               (t/cat3 " (little! (mut out) (- " (byte-expr (mut c) names prefix 0)
                                       " (+ (- (len out) start) 4)) 4)"))
                      (set! longest (+ longest 4)))
                (and in-inst (= name "sym32"))
                  (do (byte-expr (mut c) names prefix 0)
                      (t/emit! (mut o) " (set! field (- (len out) start)) (little! (mut out) 0 4)")
                      (set! longest (+ longest 4)))
                (>= (t/index-of (.form-names spec) name) 0)
                  (let [index (t/index-of (.form-names spec) name)]
                    (set! longest (+ longest (get (.form-longest spec) index)))
                    (set! (mut (.form-used spec)) index true)
                    (t/emit! (mut o) (t/cat3 " (form-" name " (mut out)"))
                      (let [(mut more) (not (t/at? (mut c) ")"))]
                        (while more
                          (t/emit! (mut o) (t/cat2 " " (byte-expr (mut c) names prefix 0)))
                          (set! more (t/accept! (mut c) ","))))
                      (t/emit! (mut o) ")"))
                :else (t/die (mut c) tok (t/cat2 "no form or piece named " name)))
              (t/expect! (mut c) ")")))))
    (t/text-of (mut o))))

;;; `form NAME(params) [when GUARD] = pieces`: a named piece of encoding, the
;;; first of its cases whose condition holds.
(defn parse-form [(c (mut t/Cur)) (spec (mut Spec))] (-> void)
  (let [name (t/name! (mut c) "a form name")
        (mut params) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut head) (t/out-new)
        (mut index) (t/index-of (.form-names spec) name)]
    (t/emit! (mut head) (t/cat3 "(defn form-" name " :inline (Always) [(out (mut (ArrayList u8)))"))
    (t/expect! (mut c) "(")
    (while (not (t/accept! (mut c) ")"))
      (let [param (t/name! (mut c) "a parameter")]
        (push! (mut params) param)
        (t/emit! (mut head) (t/cat3 " (f-" param " i64)"))
        (t/accept! (mut c) ",")))
    (t/line! (mut head) "] (-> void)")
    (when (< index 0)
      (push! (mut (.form-names spec)) name)
      (push! (mut (.form-heads spec)) (t/text-of (mut head)))
      (push! (mut (.form-cases spec)) "")
      (push! (mut (.form-longest spec)) 0)
      (push! (mut (.form-used spec)) false)
      (set! index (- (len (.form-names spec)) 1)))
    ; What an instruction takes is counted from its forms as it is read.
    (when (get (.form-used spec) index)
      (t/die (mut c) (t/peek (mut c)) (t/cat3 "a case of form " name " comes after the form is used")))
    (let [guard (if (t/accept! (mut c) "when") (byte-expr (mut c) params "f-" 0) "true")]
      (t/expect! (mut c) "=")
      (let [(mut longest) 0
            pieces (byte-pieces (mut c) (mut spec) params "f-" false (mut longest))]
        (when (> longest (get (.form-longest spec) index)) (set! (mut (.form-longest spec)) index longest))
        (set! (mut (.form-cases spec)) index
              (t/cat4 (get (.form-cases spec) index) "    " guard (t/cat3 " (do" pieces " (do))\n")))))))

;;; A relocation's value: arithmetic over S, G and P, and `page(x)`.
(defn formula-level [(op (slice u8))] (-> i64)
  (cond (= op "&") 1
        (or (= op "<<") (= op ">>")) 2
        (or (= op "+") (= op "-")) 3
        :else 0))

(defn formula-primary [(c (mut t/Cur))] (-> (slice u8))
  (let [tok (t/advance! (mut c))]
    (cond
      (= (.kind tok) t/T-NUM) (t/int-text (cast i64 (.value tok)))
      (t/tok-is? tok "(")
        (let [e (formula-expr (mut c) 0)]
          (t/expect! (mut c) ")")
          e)
      (t/tok-is? tok "S") "s"
      (t/tok-is? tok "G") "g"
      (t/tok-is? tok "P") "p"
      (t/tok-is? tok "page")
        (do (t/expect! (mut c) "(")
            (let [e (formula-expr (mut c) 0)]
              (t/expect! (mut c) ")")
              (t/cat3 "(& " e " -4096)")))
      :else (t/die (mut c) tok "a relocation is arithmetic over S, G and P"))))

(defn formula-expr [(c (mut t/Cur)) (min i64)] (-> (slice u8))
  (let [(mut left) (formula-primary (mut c))
        (mut going) true]
    (while going
      (let [tok (t/peek (mut c))
            level (if (.first tok) 0 (formula-level (.text tok)))]
        (if (and (> level 0) (> level min))
            (do (t/advance! (mut c))
                (let [right (formula-expr (mut c) level)]
                  (set! left (t/cat4 (t/cat3 "(" (.text tok) " ") left " " (t/cat2 right ")")))))
            (set! going false))))
    left))

(defn parse [(src (slice u8)) (path (slice u8))] (-> Spec)
  (let [(mut c) (t/cursor src path)
        (mut spec) (Spec
                     :word 32
                     :classes (ArrayList::new [Class] (malloc-allocator))
                     :regs (ArrayList::new [Reg] (malloc-allocator))
                     :sets (ArrayList::new [RegSet] (malloc-allocator))
                     :consts (ArrayList::new [Reg] (malloc-allocator))
                     :insts (ArrayList::new [Inst] (malloc-allocator))
                     :form-names (ArrayList::new [(slice u8)] (malloc-allocator))
                     :form-heads (ArrayList::new [(slice u8)] (malloc-allocator))
                     :form-cases (ArrayList::new [(slice u8)] (malloc-allocator))
                     :form-longest (ArrayList::new [i64] (malloc-allocator))
                     :form-used (ArrayList::new [bool] (malloc-allocator))
                     :longest 0
                     :immediates (ArrayList::new [(slice u8)] (malloc-allocator))
                     :immediate-text ""
                     :align 4)]
    (while (not (t/eof? (mut c)))
      (let [tok (t/advance! (mut c))]
        (cond
          (t/tok-is? tok "word") (set! (.word spec) (cast i64 (t/num! (mut c) "the word's bits")))
          ; `bytes`: instructions are runs of bytes, described piece by piece.
          (t/tok-is? tok "bytes") (set! (.word spec) 0)
          (t/tok-is? tok "align") (set! (.align spec) (cast i64 (t/num! (mut c) "bytes")))
          (t/tok-is? tok "form") (parse-form (mut c) (mut spec))
          (t/tok-is? tok "immediate") (parse-immediate (mut c) (mut spec))
          (t/tok-is? tok "class")
            (let [name (t/name! (mut c) "a class name")
                  width (cast i64 (t/num! (mut c) "the field width"))]
              ; Each class has room for 32 registers, one class after another.
              (push! (mut (.classes spec))
                     (Class :name name :width width :base (* 32 (len (.classes spec))))))
          (t/tok-is? tok "reg")
            (let [names (parse-reg-list (mut c))]
              (t/expect! (mut c) ":")
              (let [class (t/name! (mut c) "a register class")
                    (mut number) (if (t/accept! (mut c) "=")
                                     (cast i64 (t/num! (mut c) "a register number"))
                                     -1)]
                (for name names
                  ; Unnumbered registers take the number their name ends in.
                  (let [(mut split) (len name)
                        (mut own) 0]
                    (while (and (> split 0) (t/digit? (get name (- split 1)))) (set! split (- split 1)))
                    (for i (range split (len name))
                      (set! own (+ (* own 10) (cast i64 (- (get name i) #\0)))))
                    ; A name with no number in it takes the next number of its class.
                    (let [(mut next) 0]
                      (for other (.regs spec)
                        (when (= (.class other) class) (set! next (+ (% (.number other) 32) 1))))
                      (push! (mut (.regs spec))
                             (Reg :name name
                                  :number (+ (* 32 (class-index spec class))
                                             (cond (>= number 0) number
                                                   (= split (len name)) next
                                                   :else own))
                                  :class class)))))))
          (t/tok-is? tok "set")
            (let [name (t/name! (mut c) "a set name")]
              (t/expect! (mut c) "=")
              (let [members (parse-reg-list (mut c))]
                (for m members
                  (when (< (reg-number spec m) 0) (t/die (mut c) tok (t/cat2 "no register named " m))))
                (push! (mut (.sets spec)) (RegSet :name name :members members))))
          (t/tok-is? tok "const")
            (let [name (t/name! (mut c) "a constant's name")]
              (t/expect! (mut c) "=")
              (push! (mut (.consts spec))
                     (Reg :name name :number (cast i64 (t/num! (mut c) "a number")) :class "")))
          (t/tok-is? tok "inst") (parse-inst (mut c) (mut spec))
          :else (t/die (mut c) tok (t/cat2 "expected word, class, reg, set or inst, found "
                                           (.text tok))))))
    spec))

;; ---------------------------------------------------------------- output

(defn arg-name [(i i64)] (-> (slice u8))
  (cond (= i 0) "a" (= i 1) "b" (= i 2) "c" (= i 3) "d" :else "e"))

;;; An instruction's word: its literal bits, and each field cut to its width
;;; and shifted into place.
;;; Coil that stops with the instruction's name if an immediate operand does
;;; not fit its declared width.
(defn range-checks [(inst Inst)] (-> (slice u8))
  (let [(mut o) (t/out-new)]
    (for i (range 0 (len (.operands inst)))
      (let [operand (get (.operands inst) i)]
        (when (and (= (.kind operand) K-IMM) (< (.width operand) 64))
          (t/emit! (mut o)
                   (if (.signed operand)
                       (t/cat4 " (when (or (< " (arg-name i) (t/cat3 " (- 0 (<< 1 " (t/int-text (- (.width operand) 1)) ")))")
                               (t/cat4 " (>= " (arg-name i) (t/cat3 " (<< 1 " (t/int-text (- (.width operand) 1)) ")))")
                                       (t/cat4 " (panic \"" (.name inst) (t/cat3 ": operand " (.name operand) " does not fit\"))") "")))
                       (t/cat4 " (when (or (< " (arg-name i) " 0)"
                               (t/cat4 " (>= " (arg-name i) (t/cat3 " (<< 1 " (t/int-text (.width operand)) ")))")
                                       (t/cat4 " (panic \"" (.name inst) (t/cat3 ": operand " (.name operand) " does not fit\"))") ""))))))))
    (t/text-of (mut o))))

(defn encode-text [(spec Spec) (inst Inst)] (-> (slice u8))
  (let [(mut o) (t/out-new)
        (mut shift) (.word spec)
        (mut literal) (: 0 u64)]
    (for piece (.pieces inst)
      (set! shift (- shift (.width piece)))
      (if (= (.field piece) "")
          (for i (range 0 (len (.bits piece)))
            (when (= (get (.bits piece) i) #\1)
              (set! literal (| literal (<< (: 1 u64) (cast u64 (+ shift (- (- (.width piece) 1) i))))))))
          (let [mask (- (<< (: 1 u64) (cast u64 (.width piece))) 1)]
            (t/emit! (mut o)
                     (t/cat4 " (<< (& (>> (primitive/cast u64 "
                             (arg-name (operand-index inst (.field piece)))
                             (t/cat3 ") " (t/int-text (.low piece)) ") ")
                             (t/cat4 (t/u64-text mask) ") " (t/int-text shift) ")"))))))
    (t/cat4 (t/cat3 "(do" (range-checks inst) " (primitive/cast u32 (| ") (t/u64-text literal) (t/text-of (mut o)) " 0)))")))

(defn module-text [(src (slice u8)) (path (slice u8))] (-> (slice u8))
  (let [spec (parse src path)
        (mut o) (t/out-new)]
    (t/line! (mut o) "(import \"coil.primitive\" :as primitive)")
    (t/line! (mut o) "(import \"coil.arraylist\" :use [ArrayList])")
    (for i (range 0 (len (.insts spec)))
      (t/line! (mut o)
               (t/cat4 "(const " (t/upper (.name (get (.insts spec) i))) " "
                       (t/cat2 (t/int-text (+ i 1)) ")"))))
    (for r (.regs spec)
      (t/line! (mut o) (t/cat4 "(const " (t/upper (.name r)) " " (t/cat2 (t/int-text (.number r)) ")"))))
    (for k (.consts spec)
      (t/line! (mut o) (t/cat4 "(const " (t/upper (.name k)) " " (t/cat2 (t/int-text (.number k)) ")"))))
    (for s (.sets spec)
      (let [(mut mask) (: 0 u64)]
        (for m (.members s) (set! mask (| mask (<< (: 1 u64) (cast u64 (reg-number spec m))))))
        (t/line! (mut o) (t/cat4 "(const " (t/upper (.name s)) " " (t/cat2 (t/u64-text mask) ")")))))
    (t/emit! (mut o) "(def NAMES [\"\"")
    (for inst (.insts spec) (t/emit! (mut o) (t/cat3 " \"" (.name inst) "\"")))
    (t/line! (mut o) "])")
    (t/emit! (mut o) "(def COUNTS [0")
    (for inst (.insts spec) (t/emit! (mut o) (t/cat2 " " (t/int-text (len (.operands inst))))))
    (t/line! (mut o) "])")
    ; Five kinds per instruction, from instruction 0.
    (t/emit! (mut o) "(def KINDS [0 0 0 0 0")
    (for inst (.insts spec)
      (for i (range 0 5)
        (t/emit! (mut o)
                 (t/cat2 " " (t/int-text (if (< i (len (.operands inst)))
                                             (.kind (get (.operands inst) i))
                                             K-NONE))))))
    (t/line! (mut o) "])")
    ; The register class of each operand that is a register, five per instruction.
    (t/emit! (mut o) "(def CLASSES [0 0 0 0 0")
    (for inst (.insts spec)
      (for i (range 0 5)
        (t/emit! (mut o)
                 (t/cat2 " " (t/int-text (if (and (< i (len (.operands inst)))
                                                  (!= (.class (get (.operands inst) i)) ""))
                                             (class-index spec (.class (get (.operands inst) i)))
                                             0))))))
    (t/line! (mut o) "])")
    (t/line! (mut o) (t/cat3 "(const REGISTERS " (t/int-text (* 32 (len (.classes spec)))) ")"))
    (t/line! (mut o) "(defn operand-class :inline (Always) [(op i64) (i i64)] (-> i64) (get CLASSES (+ (* op 5) i)))")
    (t/line! (mut o) "(defn reg-class :inline (Always) [(r i64)] (-> i64) (/ r 32))")
    (t/line! (mut o) ";;; The registers of class `c`, as a set.")
    (t/line! (mut o) "(defn class-registers :inline (Always) [(c i64)] (-> u64) (<< (: 0xFFFFFFFF u64) (cast u64 (* c 32))))")
    (t/emit! (mut o) "(def REG-NAMES [")
    (for n (range 0 64)
      (let [(mut name) "?"]
        (for r (.regs spec) (when (and (= name "?") (= (.number r) n)) (set! name (.name r))))
        (t/emit! (mut o) (t/cat3 " \"" name "\""))))
    (t/line! (mut o) "])")
    (t/line! (mut o) "(const K-DEF 1)")
    (t/line! (mut o) "(const K-USE 2)")
    (t/line! (mut o) "(const K-MOD 3)")
    (t/line! (mut o) "(const K-IMM 4)")
    (t/line! (mut o) "(const K-LABEL 5)")
    (t/line! (mut o) "(const K-SYMBOL 6)")
    (t/line! (mut o) "(defn name [(op i64)] (-> (slice u8)) (get NAMES op))")
    (t/line! (mut o) "(defn reg-name [(r i64)] (-> (slice u8)) (get REG-NAMES r))")
    (t/line! (mut o) "(defn operand-count :inline (Always) [(op i64)] (-> i64) (get COUNTS op))")
    (t/line! (mut o) "(defn operand-kind :inline (Always) [(op i64) (i i64)] (-> i64) (get KINDS (+ (* op 5) i)))")
    (t/line! (mut o) "(defn in-set? :inline (Always) [(set u64) (r i64)] (-> bool) (!= (& set (<< (: 1 u64) (cast u64 r))) 0))")
    ; What writing an instruction asks of its operands at once: which are
    ; registers, which a symbol, and which one is a label (at most one is).
    (t/emit! (mut o) "(def OPERAND-MASKS [0")
    (for inst (.insts spec)
      (let [(mut regs) 0
            (mut syms) 0
            (mut label) -1]
        (for i (range 0 (len (.operands inst)))
          (let [k (.kind (get (.operands inst) i))]
            (when (or (= k K-DEF) (= k K-USE) (= k K-MOD)) (set! regs (| regs (<< 1 i))))
            (when (= k K-SYMBOL) (set! syms (| syms (<< 1 i))))
            (when (= k K-LABEL) (set! label i))))
        (t/emit! (mut o) (t/cat2 " " (t/int-text (| (| regs (<< syms 8)) (<< (+ label 1) 16)))))))
    (t/line! (mut o) "])")
    (t/line! (mut o) ";;; Bit k: operand k is a register; bit 8 + k: a symbol; bits 16 up: the label operand + 1, 0 if none.")
    (t/line! (mut o) "(defn operand-mask :inline (Always) [(op i64)] (-> i64) (get OPERAND-MASKS op))")
    ; Relocations: a number per name, which one an instruction carries, and how
    ; its word is finished once the addresses are known.
    (let [(mut relocs) (ArrayList::new [(slice u8)] (malloc-allocator))]
      (for inst (.insts spec)
        (when (and (!= (.reloc inst) "") (< (t/index-of relocs (.reloc inst)) 0))
          (push! (mut relocs) (.reloc inst))))
      (t/emit! (mut o) "(def RELOC-NAMES [\"\"")
      (for name relocs (t/emit! (mut o) (t/cat3 " \"" name "\"")))
      (t/line! (mut o) "])")
      (for i (range 0 (len relocs))
        (t/line! (mut o) (t/cat4 "(const R-" (t/upper (get relocs i)) " " (t/cat2 (t/int-text (+ i 1)) ")"))))
      (t/emit! (mut o) "(def RELOCS [0")
      (for inst (.insts spec)
        (t/emit! (mut o) (t/cat2 " " (t/int-text (+ (t/index-of relocs (.reloc inst)) 1)))))
      (t/line! (mut o) "])")
      (t/line! (mut o) "(defn reloc-name [(reloc i64)] (-> (slice u8)) (get RELOC-NAMES reloc))")
      (t/line! (mut o) "(defn reloc-of :inline (Always) [(op i64)] (-> i64) (get RELOCS op))")
      (when (!= (.word spec) 0)
        (t/line! (mut o) ";;; An instruction's word with its symbol's value filled in: `s` is the symbol's")
        (t/line! (mut o) ";;; address, `g` the address of its slot in the table of addresses, `p` the")
        (t/line! (mut o) ";;; instruction's own.")
        (t/line! (mut o) "(defn patch [(op i64) (word u32) (s i64) (g i64) (p i64)] (-> u32)")
        (t/line! (mut o) "  (match op")
        (for i (range 0 (len (.insts spec)))
          (let [inst (get (.insts spec) i)]
            (when (!= (.reloc inst) "")
              (let [(mut fields) (t/out-new)
                    (mut shift) (.word spec)]
                (for piece (.pieces inst)
                  (set! shift (- shift (.width piece)))
                  (when (and (!= (.field piece) "")
                             (= (.kind (get (.operands inst) (operand-index inst (.field piece)))) K-SYMBOL))
                    (t/emit! (mut fields)
                             (t/cat4 " (<< (& (>> (primitive/cast u64 v) " (t/int-text (.low piece)) ") "
                                     (t/cat4 (t/u64-text (- (<< (: 1 u64) (cast u64 (.width piece))) 1)) ") "
                                             (t/int-text shift) ")")))))
                (t/line! (mut o)
                         (t/cat4 "    (" (t/int-text (+ i 1)) " (let [v " 
                                 (t/cat4 (.formula inst) "] (| word (primitive/cast u32 (|"
                                         (t/text-of (mut fields)) " (: 0 u64))))))")))))))
        (t/line! (mut o) "    (_ word)))")))
    (t/emit! (mut o) "(def IMPLICIT-READS [(: 0 u64)")
    (for inst (.insts spec)
      (let [(mut mask) (: 0 u64)]
        (for name (.reads inst) (set! mask (| mask (<< (: 1 u64) (cast u64 (reg-number spec name))))))
        (t/emit! (mut o) (t/cat2 " " (t/u64-text mask)))))
    (t/line! (mut o) "])")
    (t/emit! (mut o) "(def IMPLICIT-WRITES [(: 0 u64)")
    (for inst (.insts spec)
      (let [(mut mask) (: 0 u64)]
        (for name (.writes inst) (set! mask (| mask (<< (: 1 u64) (cast u64 (reg-number spec name))))))
        (t/emit! (mut o) (t/cat2 " " (t/u64-text mask)))))
    (t/line! (mut o) "])")
    ; A branch's opposite: the instruction (0 if it is this one or there is
    ; none), and the operand whose low bit turns (-1 if none).
    (t/emit! (mut o) "(def OPPOSITE-OPS [0")
    (for inst (.insts spec) (t/emit! (mut o) (t/cat2 " " (t/int-text (inst-number spec (.opposite inst))))))
    (t/line! (mut o) "])")
    (t/emit! (mut o) "(def OPPOSITE-TURNS [-1")
    (for inst (.insts spec)
      (when (and (!= (.opposite inst) "") (= (inst-number spec (.opposite inst)) 0)
                 (< (operand-index inst (.opposite inst)) 0))
        (t/fail-at "" (.line inst) 1 (t/cat2 "opposite names no instruction and no operand: " (.opposite inst))))
      (t/emit! (mut o) (t/cat2 " " (t/int-text (if (= (.opposite inst) "") -1 (operand-index inst (.opposite inst)))))))
    (t/line! (mut o) "])")
    (t/line! (mut o) "(defn opposite-op :inline (Always) [(op i64)] (-> i64) (get OPPOSITE-OPS op))")
    (t/line! (mut o) "(defn opposite-turn :inline (Always) [(op i64)] (-> i64) (get OPPOSITE-TURNS op))")
    (t/line! (mut o) "(defn implicit-reads :inline (Always) [(op i64)] (-> u64) (get IMPLICIT-READS op))")
    (t/line! (mut o) "(defn implicit-writes :inline (Always) [(op i64)] (-> u64) (get IMPLICIT-WRITES op))")
    (t/emit! (mut o) (.immediate-text spec))
    (if (!= (.word spec) 0)
        (emit-word-encoder! (mut o) spec)
        (emit-byte-encoder! (mut o) spec))
    (t/text-of (mut o))))

;;; Whether an instruction can go out already encoded by whoever knows which it
;;; is: the machine's instructions are words, and it names no label or symbol.
(defn encodable? [(spec Spec) (inst Inst)] (-> bool)
  (let [(mut plain) (!= (.word spec) 0)]
    (for x (.operands inst)
      (when (or (= (.kind x) K-LABEL) (= (.kind x) K-SYMBOL)) (set! plain false)))
    plain))

;;; Operand `i`'s Coil `code` as the encoder takes it: a register's number
;;; from its marker (-r - 1), anything else as it is.
(defn operand-code-text [(inst Inst) (i i64) (code (slice u8))] (-> (slice u8))
  (if (and (< i (len (.operands inst)))
           (let [k (.kind (get (.operands inst) i))] (or (= k K-DEF) (= k K-USE) (= k K-MOD))))
      (t/cat3 "(- -1 " code ")")
      code))

(defn emit-word-encoder! [(o (mut t/Out)) (spec Spec)] (-> void)
  (do
    (t/line! (mut o) "(defn word-of [(op i64) (a i64) (b i64) (c i64) (d i64) (e i64)] (-> u32)")
    (t/line! (mut o) "  (match op")
    (for i (range 0 (len (.insts spec)))
      (t/line! (mut o)
               (t/cat4 "    (" (t/int-text (+ i 1)) " "
                       (t/cat2 (encode-text spec (get (.insts spec) i)) ")"))))
    (t/line! (mut o) "    (_ (: 0 u32))))")
    (t/line! (mut o) (t/cat3 "(const ALIGN " (t/int-text (/ (.word spec) 8)) ")"))
    (t/line! (mut o) ";;; How many bytes an instruction takes.")
    (t/line! (mut o) "(defn size [(out (mut (ArrayList u8))) (op i64) (a i64) (b i64) (c i64) (d i64) (e i64)] (-> i64) ALIGN)")
    (t/line! (mut o) ";;; An instruction's bytes, appended to `out`. A label operand is the distance in")
    (t/line! (mut o) ";;; bytes from this instruction to its target. Returns where in the instruction")
    (t/line! (mut o) ";;; its symbol's bits are, to be filled in when addresses are known, or -1.")
    (t/line! (mut o) "(defn encode! [(out (mut (ArrayList u8))) (op i64) (a i64) (b i64) (c i64) (d i64) (e i64)] (-> i64)")
    (t/line! (mut o) "  (put-word! (mut out) (cast u64 (word-of op a b c d e)))")
    (t/line! (mut o) "  (if (!= (get RELOCS op) 0) 0 -1))")
    ; The word's bytes, least significant first, written in room made for all
    ; of them at once.
    (t/line! (mut o) ";;; A finished word appended to `out`.")
    (t/line! (mut o) "(defn put-word! :inline (Always) [(out (mut (ArrayList u8))) (word u64)] (-> void)")
    (t/line! (mut o) "  (let [w (cast u32 word)")
    (t/line! (mut o) "        at (len out)]")
    (t/line! (mut o) "    (when (> (+ at ALIGN) (cap out)) (reserve! (mut out) (if (< (cap out) 256) 256 (* (cap out) 2))))")
    (t/line! (mut o) "    (let [p (primitive/index (load (field out data)) at)]")
    (t/line! (mut o) "      (for k (range 0 ALIGN)")
    (t/line! (mut o) "        (primitive/store! (primitive/index p k) (primitive/cast u8 (& (>> w (cast u32 (* k 8))) 255)))))")
    (t/line! (mut o) "    (primitive/store! (field out len) (+ at ALIGN))))")
    ; Each instruction's word on its own, for whoever writes it knowing which
    ; instruction it is: its operands as the encoder takes them.
    (for i (range 0 (len (.insts spec)))
      (t/line! (mut o) (t/cat3 "(defn word-" (t/int-text (+ i 1)) " :inline (Always) [(a i64) (b i64) (c i64) (d i64) (e i64)] (-> u32)"))
      (t/line! (mut o) (t/cat3 "  " (encode-text spec (get (.insts spec) i)) ")")))
    (do)))

(defn emit-byte-encoder! [(o (mut t/Out)) (spec Spec)] (-> void)
  (t/line! (mut o) (t/cat3 "(const ALIGN " (t/int-text (.align spec)) ")"))
  ; Instructions of bytes are never handed over as finished words.
  (t/line! (mut o) ";;; A finished word: what a machine of bytes is never given.")
  (t/line! (mut o) "(defn put-word! [(out (mut (ArrayList u8))) (word u64)] (-> void)")
  (t/line! (mut o) "  (panic \"this machine's instructions are bytes, not words: none is put as a finished word\"))")
  ; Room for the longest instruction is made once, before it is written: each
  ; byte is then a store.
  (t/line! (mut o) ";;; The most bytes an instruction takes.")
  (t/line! (mut o) (t/cat3 "(const LONGEST " (t/int-text (.longest spec)) ")"))
  (t/line! (mut o) "(defn put-byte! :inline (Always) [(out (mut (ArrayList u8))) (b u8)] (-> void)")
  (t/line! (mut o) "  (let [n (len out)]")
  (t/line! (mut o) "    (primitive/store! (primitive/index (load (field out data)) n) b)")
  (t/line! (mut o) "    (primitive/store! (field out len) (+ n 1))))")
  (t/line! (mut o) "(defn little! :inline (Always) [(out (mut (ArrayList u8))) (v i64) (bytes i64)] (-> void)")
  (t/line! (mut o) "  (for k (range 0 bytes) (put-byte! (mut out) (primitive/cast u8 (& (>> v (* k 8)) 255)))))")
  (for i (range 0 (len (.form-names spec)))
    (t/emit! (mut o) (get (.form-heads spec) i))
    (t/line! (mut o) "  (cond")
    (t/emit! (mut o) (get (.form-cases spec) i))
    (t/line! (mut o) (t/cat3 "    :else (panic \"no case of form " (get (.form-names spec) i) " applies\")))")))
  (t/line! (mut o) ";;; An instruction's bytes, appended to `out`. A label operand is the distance in")
  (t/line! (mut o) ";;; bytes from this instruction to its target. Returns where in the instruction")
  (t/line! (mut o) ";;; its symbol's bytes are, to be filled in when addresses are known, or -1.")
  (t/line! (mut o) "(defn encode! [(out (mut (ArrayList u8))) (op i64) (a i64) (b i64) (c i64) (d i64) (e i64)] (-> i64)")
  (t/line! (mut o) "  (when (> (+ (len out) LONGEST) (cap out))")
  (t/line! (mut o) "    (reserve! (mut out) (+ (if (< (cap out) 128) 256 (* (cap out) 2)) LONGEST)))")
  (t/line! (mut o) "  (let [start (len out)")
  (t/line! (mut o) "        (mut field) -1]")
  (t/line! (mut o) "    (match op")
  (for i (range 0 (len (.insts spec)))
    (t/line! (mut o) (t/cat4 "      (" (t/int-text (+ i 1)) " (do" (t/cat2 (.body (get (.insts spec) i)) " (do)))"))))
  (t/line! (mut o) "      (_ (do)))")
  (t/line! (mut o) "    field))")
  (t/line! (mut o) ";;; How many bytes an instruction takes, with these operands.")
  (t/line! (mut o) "(defn size [(out (mut (ArrayList u8))) (op i64) (a i64) (b i64) (c i64) (d i64) (e i64)] (-> i64)")
  (t/line! (mut o) "  (let [start (len out)]")
  (t/line! (mut o) "    (encode! (mut out) op a b c d e)")
  (t/line! (mut o) "    (let [bytes (- (len out) start)]")
  (t/line! (mut o) "      (for _ (range 0 bytes) (pop! (mut out)))")
  (t/line! (mut o) "      bytes)))")
  ; The four bytes at a relocation, from its formula.
  (t/line! (mut o) "(defn patch [(op i64) (word u32) (s i64) (g i64) (p i64)] (-> u32)")
  (t/line! (mut o) "  (match op")
  (for i (range 0 (len (.insts spec)))
    (let [inst (get (.insts spec) i)]
      (when (!= (.reloc inst) "")
        (t/line! (mut o) (t/cat4 "    (" (t/int-text (+ i 1)) " (primitive/cast u32 (& "
                                 (t/cat2 (.formula inst) " 4294967295)))"))))))
  (t/line! (mut o) "    (_ word)))"))
