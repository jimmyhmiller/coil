; SPDX-FileCopyrightText: 2026 Jimmy Miller
; SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
; Buffer API and allocation/LEB algorithms derive from native.buf; see
; src/compiler/native/NOTICE and its LICENSES directory.
;;; Primitive storage generation. The schema says what bytes a buffer stores;
;;; the generated API owns its allocation and implements encodings explicitly,
;;; with the declared byte order and alignment 1 for every appended field.
(module lang.storage)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "lang.text" :as t)

;;; Native and LLVM compilation lower an alignment-1 memory operation in
;;; one instruction where the target permits it. The portable wasm backend
;;; uses byte operations instead; selection is at expansion, never at runtime.
(defn store-text [(width i64) (address (slice u8)) (value (slice u8))]
  (-> (slice u8))
  (let [bits (t/int-text width)
        fast
          (t/cat4 "(library-primitive/llvm-ir i64 ["
                  address
                  " "
                  (t/cat4 value
                          "] \"store i"
                          bits
                          " $1, ptr $0, align 1\nret i64 0\")"))
        (mut portable) (t/out-new)]
    (t/emit! (mut portable) "(do ")
    (for i (range 0 (/ width 8))
      (t/emit! (mut portable)
               (t/cat4 "(store! (index "
                       address
                       " "
                       (t/cat4 (t/int-text i)
                               ") (cast u8 (>> "
                               value
                               (t/cat4 " (: "
                                       (t/int-text (* i 8))
                                       " u"
                                       (t/cat2 bits ")))) "))))))
    (t/emit! (mut portable) ")")
    (t/cat4 "(buffer-word-pick "
            fast
            " "
            (t/cat2 (t/text-of (mut portable)) ")"))))

(defn read-text [(width i64) (address (slice u8))] (-> (slice u8))
  (let [bits (t/int-text width)
        fast
          (t/cat4 "(library-primitive/llvm-ir u"
                  bits
                  " ["
                  (t/cat4 address
                          "] \"%value = load i"
                          bits
                          (t/cat4 ", ptr $0, align 1\nret i"
                                  bits
                                  " %value"
                                  "\")")))
        (mut portable) (t/out-new)]
    (t/emit! (mut portable) (t/cat3 "(| (: 0 u" bits ")"))
    (for i (range 0 (/ width 8))
      (t/emit! (mut portable)
               (t/cat4 " (<< (cast u"
                       bits
                       " (load (index "
                       (t/cat4 address
                               " "
                               (t/int-text i)
                               (t/cat4 "))) (: "
                                       (t/int-text (* i 8))
                                       " u"
                                       (t/cat2 bits "))"))))))
    (t/emit! (mut portable) ")")
    (t/cat4 "(buffer-word-pick "
            fast
            " "
            (t/cat2 (t/text-of (mut portable)) ")"))))

(defn buffer-text [(c (mut t/Cur))] (-> (slice u8))
  (let [record (t/name! (mut c) "a buffer record")
        (mut widths) (ArrayList::new [i64] (malloc-allocator))
        (mut capacity) 256
        (mut leb) false
        (mut out) (t/out-new)]
    (t/expect! (mut c) "{")
    (while (not (t/accept! (mut c) "}"))
      (let [at (t/advance! (mut c))]
        (cond (t/tok-is? at "capacity")
                (do
                  (set! capacity
                        (cast i64 (t/num! (mut c) "an initial capacity")))
                  (when (<= capacity 0)
                    (t/die (mut c) at "buffer capacity must be positive")))
              (t/tok-is? at "endian") (t/expect! (mut c) "little")
              (t/tok-is? at "integer")
                (let [width (cast i64 (t/num! (mut c) "an integer width"))]
                  (unless (or (= width 8)
                              (= width 16)
                              (= width 32)
                              (= width 64))
                    (t/die (mut c)
                           at
                           "buffer integers must be 8, 16, 32 or 64 bits"))
                  (for old widths
                    (when (= old width)
                      (t/die (mut c) at "duplicate buffer integer width")))
                  (push! (mut widths) width))
              (t/tok-is? at "leb128") (set! leb true)
              :else
                (t/die (mut c)
                       at
                       "expected capacity, endian, integer or leb128"))
        (t/expect! (mut c) ";")))
    (let [(mut has-byte) false]
      (for width widths (when (= width 8) (set! has-byte true)))
      (unless has-byte
        (t/die (mut c) (t/peek (mut c)) "a byte buffer must declare integer 8")))
    (t/line! (mut out)
             "(defn buffer-word-pick [(fast Code) (portable Code)] (-> Code) (match (target-arch) (Wasm32 [] portable) (Wasm64 [] portable) (_ fast)))")
    (t/line! (mut out) "(import \"coil.cc\" :as cc)")
    (t/line! (mut out)
             "(extern realloc :cc (cc/C) [(ptr u8) isize] (-> (ptr u8)))")
    (t/line! (mut out) "(extern free :cc (cc/C) [(ptr u8)] (-> void))")
    (t/line! (mut out)
             "(extern memcpy :cc (cc/C) [(ptr u8) (ptr u8) isize] (-> (ptr u8)))")
    (t/line! (mut out)
             "(extern memset :cc (cc/C) [(ptr u8) i32 isize] (-> (ptr u8)))")
    (t/line! (mut out)
             "(extern memmove :cc (cc/C) [(ptr u8) (ptr u8) isize] (-> (ptr u8)))")
    (t/line! (mut out)
             (t/cat3 "(defstruct "
                     record
                     " [(data (ptr u8)) (len i64) (cap i64)])"))
    (t/line! (mut out)
             (t/cat4 "(impl "
                     record
                     " (new [] (-> "
                     (t/cat4 record
                             ") ("
                             record
                             " :data (cast (ptr u8) 0) :len 0 :cap 0)))")))
    (let [ref (t/cat3 "(ptr " record ")")
          param (t/cat3 "[(b " ref ")")]
      (t/line! (mut out)
               (t/cat4 "(defn buf-reserve! "
                       param
                       " (extra i64)] (-> void) "
                       (t/cat3 "(let [need (+ (.len b) extra)] (when (> need (.cap b)) (let [(mut cap) (if (= (.cap b) 0) "
                               (t/int-text capacity)
                               " (* (.cap b) 2))] (while (< cap need) (set! cap (* cap 2))) (set! (.data b) (realloc (.data b) (cast isize cap))) (set! (.cap b) cap)))))")))
      (t/line! (mut out)
               (t/cat3 "(defn buf-clear! "
                       param
                       "] (-> void) (set! (.len b) 0))"))
      (t/line! (mut out)
               (t/cat3 "(defn buf-free! "
                       param
                       "] (-> void) (when (!= (cast i64 (.data b)) 0) (free (.data b))) (set! (.data b) (cast (ptr u8) 0)) (set! (.len b) 0) (set! (.cap b) 0))"))
      (t/line! (mut out)
               (t/cat3 "(defn buf-at "
                       param
                       " (off i64)] (-> (ptr u8)) (index (.data b) off))"))
      (for width widths
        (let [bits (t/int-text width)
              bytes (t/int-text (/ width 8))]
          (t/emit! (mut out)
                   (t/cat4 "(defn emit"
                           bits
                           "! "
                           (t/cat4 param " (x u" bits ")] (-> void) ")))
          (t/emit! (mut out) (t/cat3 "(buf-reserve! b " bytes ") "))
          (t/emit! (mut out) (store-text width "(buf-at b (.len b))" "x"))
          (t/line! (mut out)
                   (t/cat3 " (set! (.len b) (+ (.len b) " bytes ")))"))
          (t/emit! (mut out)
                   (t/cat4 "(defn read"
                           bits
                           " "
                           (t/cat4 param " (off i64)] (-> u" bits ") ")))
          (t/line! (mut out) (t/cat2 (read-text width "(buf-at b off)") ")"))
          (t/emit! (mut out)
                   (t/cat4 "(defn patch"
                           bits
                           "! "
                           (t/cat4 param " (off i64) (x u" bits ")] (-> void) ")))
          (t/line! (mut out)
                   (t/cat2 (store-text width "(buf-at b off)" "x") ")"))))
      (t/line! (mut out)
               (t/cat3 "(defn emit-bytes! "
                       param
                       " (p (ptr u8)) (n i64)] (-> void) (when (> n 0) (buf-reserve! b n) (memcpy (buf-at b (.len b)) p (cast isize n)) (set! (.len b) (+ (.len b) n))))"))
      (t/line! (mut out)
               (t/cat3 "(defn emit-slice! "
                       param
                       " (s (slice u8))] (-> void) (emit-bytes! b (data s) (len s)))"))
      (t/line! (mut out)
               (t/cat3 "(defn emit-zeros! "
                       param
                       " (n i64)] (-> void) (when (> n 0) (buf-reserve! b n) (memset (buf-at b (.len b)) 0 (cast isize n)) (set! (.len b) (+ (.len b) n))))"))
      (t/line! (mut out)
               (t/cat3 "(defn align-to! "
                       param
                       " (align i64)] (-> void) (emit-zeros! b (- (& (+ (.len b) (- align 1)) (- 0 align)) (.len b))))"))
      (t/line! (mut out)
               (t/cat3 "(defn cut! "
                       param
                       " (off i64) (n i64)] (-> void) (when (> n 0) (memmove (buf-at b off) (buf-at b (+ off n)) (cast isize (- (.len b) (+ off n)))) (set! (.len b) (- (.len b) n))))"))
      (t/line! (mut out)
               (t/cat4 "(defn as-slice "
                       param
                       "] (-> (slice u8)) "
                       "(slice::new (.data b) (.len b)))"))
      (when leb
        (t/line! (mut out)
                 (t/cat3 "(defn uleb! "
                         param
                         " (v0 u64)] (-> void) (let [(mut v) v0] (loop (let [byte (cast u8 (& v (: 0x7f u64)))] (set! v (>> v (: 7 u64))) (if (= v (: 0 u64)) (do (emit8! b byte) (break)) (emit8! b (| byte (: 0x80 u8))))))))"))
        (t/line! (mut out)
                 (t/cat3 "(defn sleb! "
                         param
                         " (v0 i64)] (-> void) (let [(mut v) v0] (loop (let [byte (cast u8 (& v 0x7f))] (set! v (>> v 7)) (if (or (and (= v 0) (= (& byte (: 0x40 u8)) (: 0 u8))) (and (= v -1) (!= (& byte (: 0x40 u8)) (: 0 u8)))) (do (emit8! b byte) (break)) (emit8! b (| byte (: 0x80 u8))))))))"))))
    (t/text-of (mut out))))
