;;; Functional-path equations, optionally accumulating a fold. The lowering is
;;; one loop, including at -O0: declarative recursion needs no runtime stack or
;;; dependence on the backend's tail-call optimization. State updates use the
;;; old node/view/accumulator; terminal paths never evaluate the next expression.
(module lang.follow)
(import "lang.text" :as t)
(import "lang.relation" :as relation)
(import "lang.template" :as template)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn text [(name (slice u8)) (params (slice u8)) (result (slice u8)) (inline bool)
            (bindings (ArrayList relation/Column)) (fold bool)] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (for binding bindings (push! (mut values) binding))
    (push! (mut values) (relation/Column :target "name" :value name))
    (push! (mut values) (relation/Column :target "params" :value params))
    (push! (mut values) (relation/Column :target "type" :value result))
    (push! (mut values) (relation/Column :target "policy" :value (if inline " :inline (Always) " " ")))
    (push! (mut values) (relation/Column :target "initial-state" :value
      (if fold (template/text "(mut acc*) @initial@" values) "")))
    (push! (mut values) (relation/Column :target "accumulator" :value (if fold "acc acc*" "")))
    (push! (mut values) (relation/Column :target "advance" :value
      (template/text (if fold
        "(let [next* @next@ value* @step@] (set! node* next*) (set! acc* value*))"
        "(set! node* @next@)") values)))
    (template/text
"(defn @name@@policy@@params@ (-> @type@)
  (block :follow*
    (let [(mut node*) @start@ @initial-state@]
      (loop
        (let [node node* item @view@ @accumulator@]
          (when @stop@ (return-from :follow* @result@))
          @advance@)))))" values)))
