; Derived from native.asm; see src/compiler/native/NOTICE and LICENSES.
;;; Stable-address chunked indexes. The outer table's bound is derived from its
;;; record field's declared reservation, so readers never observe relocation of
;;; the chunk headers. Chunks are reserved before publication and never resized.
(module lang.stable-index)
(import "lang.text" :as t)
(import "lang.relation" :as relation)
(import "lang.template" :as template)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn text [(name (slice u8)) (context (slice u8)) (owner (slice u8))
            (item-name (slice u8)) (item-type (slice u8)) (bindings (ArrayList relation/Column))] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (for binding bindings (push! (mut values) binding))
    (push! (mut values) (relation/Column :target "name" :value name))
    (push! (mut values) (relation/Column :target "context" :value context))
    (push! (mut values) (relation/Column :target "owner" :value owner))
    (push! (mut values) (relation/Column :target "item-name" :value item-name))
    (push! (mut values) (relation/Column :target "item-type" :value item-type))
    (template/text
"(const @name@$limit @limit@)
(const @name@$shift
  (comptime (if (and (>= @shift@ 0) (< @shift@ 32) (> @name@$limit 0)
                     (<= @name@$limit (>> 4294967295 @shift@)))
                @shift@ (library-primitive/error \"invalid stable-index capacity or chunk shift\"))))
(defn @name@ [(@context@ (ptr @owner@)) (@item-name@ @item-type@)] (-> u32)
  @acquire@
  (let [i* @count@ ci* (>> i* @name@$shift)]
    (when (>= ci* (len @chunks@))
      (when (>= ci* @name@$limit) (abort))
      (let [(mut chunk*) (ArrayList::new [@item-type@] (malloc-allocator))]
        (reserve! (mut chunk*) (<< 1 @name@$shift)) (push! (mut @chunks@) chunk*)))
    (push! (mut (elem (mut @chunks@) ci*)) @item-name@)
    (set! @count@ (+ i* 1))
    @release@
    (cast u32 i*)))
(defn @lookup@ [(@context@ (ptr @owner@)) (i u32)] (-> (ptr @item-type@))
  (let [x* (cast i64 i)]
    (elem (elem (mut @chunks@) (>> x* @name@$shift)) (& x* (- (<< 1 @name@$shift) 1)))))
(defn @length@ [(@context@ (ptr @owner@))] (-> u32) (cast u32 @count@))" values)))
