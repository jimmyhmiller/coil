;;; Reachability in a graph of ordered segments. The specification supplies
;;; partition, bounds and adjacency, not a traversal algorithm or worklist.
;;; Scanning segments directly preserves the fast path: positions are not
;;; allocated as graph nodes and a segment is scheduled once per generation.
(module lang.region)
(import "lang.text" :as t)
(import "lang.relation" :as relation)

(defstruct Region
  [(name (slice u8)) (context (slice u8)) (type (slice u8)) (stop (slice u8))
   (forward bool) (advance bool) (starts (slice u8)) (partition (slice u8))
   (begin (slice u8)) (end (slice u8)) (marks (slice u8)) (entered (slice u8))
   (generation (slice u8)) (work (slice u8)) (collect (slice u8))
   (neighbors relation/Index)])

(defn text [(r Region)] (-> (slice u8))
  (let [(mut out) (t/out-new)
        scanner (t/cat2 "scan-" (.name r)) ctx (.context r) stop (.stop r)
        work (.work r) mark (.marks r) entered (.entered r) epoch (.generation r)
        position (if (.forward r) "from" "before")]
    (t/line! (mut out) (t/cat4 "(defn " scanner " [(" (t/cat4 ctx " " (.type r) ")(b u32)")))
    (t/line! (mut out) (t/cat4 "(" position " u32)(" (t/cat2 stop " u32)] (-> void)")))
    (t/line! (mut out) (t/cat4 "(let [bound* " (if (.forward r) (.end r) (.begin r)) " (mut at*) "
        (t/cat2 position " (mut blocked*) false]")))
    (t/line! (mut out) (t/cat3 "(while (and (not blocked*) "
        (if (.forward r) "(< at* bound*)" "(> at* bound*)") ")"))
    (unless (.forward r) (t/line! (mut out) "(set! at* (- at* (: 1 u32)))"))
    (t/line! (mut out) (t/cat3 "(if (= at* " stop ") (set! blocked* true) (do"))
    (when (.forward r)
      (t/line! (mut out) (t/cat4 "(when (!= (get " mark " (cast i64 at*)) " (t/cat2 epoch ")"))))
    (t/line! (mut out) (t/cat4 "(set! (mut " mark ") (cast i64 at*) " (t/cat2 epoch ")")))
    (unless (= (.collect r) "")
      (t/line! (mut out) (t/cat3 "(push! (mut " (.collect r) ") at*)")))
    (when (.forward r) (t/line! (mut out) ") (set! at* (+ at* (: 1 u32)))"))
    (t/line! (mut out) ")))")
    (t/line! (mut out) "(unless blocked*")
    (t/line! (mut out) (relation/query (.neighbors r)
      (t/cat4 "(let [next* " (.key (.neighbors r)) "] (when (!= (get "
        (t/cat4 entered " (cast i64 next*)) " epoch
          (t/cat4 ") (set! (mut " entered ") (cast i64 next*) "
            (t/cat4 epoch ") (push! (mut " work ") next*)))"))))))
    (t/line! (mut out) ")))")
    (t/line! (mut out) (t/cat4 "(defn " (.name r) " [(" (t/cat4 ctx " " (.type r) (t/cat3 ")(" stop " u32)] (-> void)"))))
    (when (.advance r) (t/line! (mut out) (t/cat4 "(set! " epoch " (+ " (t/cat2 epoch " (: 1 u32)))"))))
    (unless (= (.collect r) "") (t/line! (mut out) (t/cat3 "(clear! (mut " (.collect r) "))")))
    (t/line! (mut out) (t/cat3 "(clear! (mut " work "))"))
    (t/line! (mut out) (t/cat4 "(for i* (range 0 (len " (.starts r) ")) (let [p (get " (t/cat2 (.starts r) " i*)]")))
    (t/line! (mut out) (t/cat4 "(" scanner " "
        (t/cat4 ctx " " (.partition r) (t/cat4 " " (if (.forward r) "(+ p (: 1 u32))" "p") " " (t/cat2 stop ")))")))))
    (t/emit! (mut out) (t/cat4 "(while (> (len " work ") 0) (let [b (get " (t/cat2 work " (- (len ")))
    (t/line! (mut out) (t/cat3 work ") 1))] (pop! (mut " (t/cat2 work "))")))
    (t/line! (mut out) (t/cat4 "(" scanner " "
        (t/cat4 ctx " b " (if (.forward r) (.begin r) (.end r)) (t/cat3 " " stop "))))"))))
    (t/text-of (mut out))))
