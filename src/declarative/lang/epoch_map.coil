;;; Epoch-cleared, open-addressed maps. A schema supplies storage, key/value
;;; types, the hash equation and load policy. Reset is O(1) except at epoch wrap;
;;; growth retains capacity and reinserts only entries from the current epoch.
(module lang.epoch-map)
(import "lang.text" :as t)
(import "lang.relation" :as relation)
(import "lang.template" :as template)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn text [(name (slice u8)) (context (slice u8)) (type (slice u8))
            (bindings (ArrayList relation/Column))] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (for binding bindings (push! (mut values) binding))
    (push! (mut values) (relation/Column :target "name" :value name))
    (push! (mut values) (relation/Column :target "context" :value context))
    (push! (mut values) (relation/Column :target "type" :value type))
    (template/text
"(defn @name@-reset! [(@context@ @type@)] (-> void)
  (set! @count@ 0)
  (set! @generation@ (+ @generation@ (: 1 u32)))
  (when (= @generation@ (: 0 u32))
    (for i* (range 0 (len @entries@))
      (set! (.gen (elem (mut @entries@) i*)) (: 0 u32)))
    (set! @generation@ (: 1 u32))))
(defn @name@-home [(@context@ @type@) (key @key-type@)] (-> i64)
  (& (cast i64 @hash@) (- (len @entries@) 1)))
(defn @name@-put! [(@context@ @type@) (key @key-type@) (value @value-type@)] (-> void)
  (let [generation* @generation@ mask* (- (len @entries@) 1)
        (mut i*) (@name@-home @context@ key)]
    (while (and (= (.gen (get @entries@ i*)) generation*)
                (!= (.key (get @entries@ i*)) key))
      (set! i* (& (+ i* 1) mask*)))
    (let [slot* (elem (mut @entries@) i*)]
      (when (!= (.gen slot*) generation*) (set! @count@ (+ @count@ 1)))
      (set! (.key slot*) key) (set! (.value slot*) value) (set! (.gen slot*) generation*))))
(defn @name@-grow! [(@context@ @type@)] (-> void)
  (let [generation* @generation@ old* (len @entries@)
        (mut live*) (ArrayList::new [@entry-type@] (malloc-allocator))]
    (for i* (range 0 old*)
      (let [slot* (get @entries@ i*)]
        (when (= (.gen slot*) generation*) (push! (mut live*) slot*))))
    (extend-zeroed! (mut @entries@) (if (= old* 0) @initial@ old*))
    (for i* (range 0 (len @entries@))
      (set! (.gen (elem (mut @entries@) i*)) (: 0 u32)))
    (set! @count@ 0)
    (for slot* live* (@name@-put! @context@ (.key slot*) (.value slot*)))
    (free! (mut live*))))
(defn @name@-set! [(@context@ @type@) (key @key-type@) (value @value-type@)] (-> void)
  (when (>= (* (+ @count@ 1) @load-denominator@) (len @entries@))
    (@name@-grow! @context@))
  (@name@-put! @context@ key value))
(defn @name@-get [(@context@ @type@) (key @key-type@)] (-> @value-type@)
  (if (= (len @entries@) 0) @absent@
      (let [generation* @generation@ mask* (- (len @entries@) 1)
            (mut i*) (@name@-home @context@ key)]
        (block :found*
          (while (= (.gen (get @entries@ i*)) generation*)
            (when (= (.key (get @entries@ i*)) key)
              (return-from :found* (.value (get @entries@ i*))))
            (set! i* (& (+ i* 1) mask*)))
          @absent@))))"
      values)))
