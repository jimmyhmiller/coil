; Derived from native.asm; see src/compiler/native/NOTICE and LICENSES.
;;; A mutex resource's lifecycle and conditional acquisition, derived from an
;;; active flag and an address. Failed synchronization operations abort; a lock
;;; is never silently treated as acquired after an error.
(module lang.mutex)
(import "lang.relation" :as relation)
(import "lang.template" :as template)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn text [(context (slice u8)) (type (slice u8)) (bindings (ArrayList relation/Column))] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (for binding bindings (push! (mut values) binding))
    (push! (mut values) (relation/Column :target "context" :value context))
    (push! (mut values) (relation/Column :target "type" :value type))
    (template/text
"(defn @initialize@ [(@context@ @type@)] (-> void)
   (unless @active@
     (match (library-sync/Mutex::init @address@)
       (Ok [_] (set! @active@ true)) (Err [_] (abort)))))
(defn @destroy@ [(@context@ @type@)] (-> void)
   (when @active@
     (match (library-sync/Mutex::destroy! @address@)
       (Ok [_] (set! @active@ false)) (Err [_] (abort)))))
(defn @acquire@ :inline (Always) [(@context@ @type@)] (-> void)
   (when @active@
     (match (library-sync/Mutex::lock! @address@) (Ok [_] (do)) (Err [_] (abort)))))
(defn @release@ :inline (Always) [(@context@ @type@)] (-> void)
   (when @active@
     (match (library-sync/Mutex::unlock! @address@) (Ok [_] (do)) (Err [_] (abort)))))" values)))
