;;; Demand-driven SSA from sealed predecessor constraints. Open blocks acquire
;;; deferred merges. A merge is published before following predecessors, so
;;; cycles refer to that merge instead of recursing forever. Storage and merge
;;; construction are supplied by the graph schema, without CIR dependencies.
(module lang.sealed-ssa)
(import "lang.text" :as t)
(import "lang.relation" :as relation)
(import "lang.template" :as template)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn text [(name (slice u8)) (context (slice u8)) (type (slice u8))
            (bindings (ArrayList relation/Column))] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (for binding bindings (push! (mut values) binding))
    (push! (mut values) (relation/Column :target "read" :value name))
    (push! (mut values) (relation/Column :target "context" :value context))
    (push! (mut values) (relation/Column :target "type" :value type))
    (template/text
"(defn @read@ [(@context@ @type@) (var u32) (block u32)] (-> u32)
  (let [value @definition@]
    (if (!= value @absent@) @resolved@
        (@recursive@ @context@ var block))))
(defn @recursive@ [(@context@ @type@) (var u32) (block u32)] (-> u32)
  (let [ty @variable-type@
        value
          (cond (not @sealed@)
                  (let [phi @merge@]
                    (push! (mut @pending@) (@pending-type@ :block block :var var :phi phi))
                    phi)
                (= @predecessor-count@ (: 1 u32))
                  (@read@ @context@ var @only-predecessor@)
                (= @predecessor-count@ (: 0 u32)) @undefined@
                :else
                  (let [phi @merge@ value phi]
                    @publish@
                    @complete@))]
    @publish@
    value))
(defn @use@ [(@context@ @type@) (var u32)] (-> u32)
  (@read@ @context@ var @current@))
(defn @seal@ [(@context@ @type@) (b u32)] (-> void)
  (let [block b]
    (unless @sealed@
      (let [(mut i*) 0]
        (while (< i* (len @pending@))
          (let [item* (get @pending@ i*)]
            (if (= (.block item*) block)
                (let [var (.var item*) phi (.phi item*)]
                  @complete@
                  (let [last* (- (len @pending@) 1)]
                    (set! (mut @pending@) i* (get @pending@ last*))
                    (pop! (mut @pending@))))
                (set! i* (+ i* 1))))))
      @close@)))"
      values)))
