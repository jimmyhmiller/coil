;;; What every language shares: one lexer, a token cursor with located errors,
;;; and a buffer for the Coil text a language compiles to. Compile-time only.
(module lang.text)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "coil.str" :as str)
(import "coil.fs" :as fs)

(defn directory [(path (slice u8))] (-> (slice u8))
  (let [(mut cut) -1]
    (for i (range 0 (len path)) (when (= (get path i) #\/) (set! cut i)))
    (if (< cut 0) "." (subslice path 0 cut))))

;;; A file whose whole text is `same OTHER` stands for the file OTHER, named
;;; from its own directory: how one source file serves several targets, each
;;; of which needs a file of its own to be a module.
(defn follow [(src (slice u8)) (path (slice u8))] (-> (slice u8))
  (if (and (> (len src) 5) (= (subslice src 0 5) "same "))
      (let [(mut end) 5]
        (while (and (< end (len src)) (!= (get src end) #\newline)) (set! end (+ end 1)))
        (let [(mut b) (str/StrBuf::new (malloc-allocator))]
          (str/format! (mut b) "{}/{}" (directory path) (subslice src 5 end))
          (let [other (finish! (mut b))]
            (match (fs/read-file (malloc-allocator) other)
              (Ok [bytes] (follow bytes other))
              (Err [_] (do (primitive/error (cat2 "cannot read " other)) (unreachable)))))))
      src))

(defn source-of [(context Code)] (-> (slice u8))
  (follow (primitive/code-str (get context 2)) (primitive/code-str (get context 1))))

(defn path-of [(context Code)] (-> (slice u8))
  (primitive/code-str (get context 1)))

;;; Stop the build with a message located in the guest file.
(defn fail-at [(path (slice u8)) (line i64) (col i64) (msg (slice u8))] (-> never)
  (let [(mut b) (str/StrBuf::new (malloc-allocator))]
    (str/format! (mut b) "{}:{}:{}: {}" path line col msg)
    (primitive/error (finish! (mut b)))
    (unreachable)))

(defn cat2 [(a (slice u8)) (b (slice u8))] (-> (slice u8))
  (let [(mut sb) (str/StrBuf::new (malloc-allocator))]
    (push-str! (mut sb) a)
    (push-str! (mut sb) b)
    (finish! (mut sb))))

(defn cat3 [(a (slice u8)) (b (slice u8)) (c (slice u8))] (-> (slice u8))
  (cat2 (cat2 a b) c))

(defn cat4 [(a (slice u8)) (b (slice u8)) (c (slice u8)) (d (slice u8))] (-> (slice u8))
  (cat2 (cat3 a b c) d))

(defn int-text [(n i64)] (-> (slice u8))
  (let [(mut sb) (str/StrBuf::new (malloc-allocator))]
    (push-i64! (mut sb) n)
    (finish! (mut sb))))

;;; An unsigned 64-bit value as a Coil literal.
(defn u64-text [(n u64)] (-> (slice u8))
  (let [(mut sb) (str/StrBuf::new (malloc-allocator))]
    (str/format! (mut sb) "(: {:#x} u64)" n)
    (finish! (mut sb))))

;; ---------------------------------------------------------------- tokens

(const T-EOF 0)
(const T-IDENT 1)
(const T-NUM 2)
(const T-STR 3)
(const T-PUNCT 4)

;;; first: the token starts its line. glued: no space separates it from the one before.
(defstruct Tok
  [(kind i64) (text (slice u8)) (value u64) (line i64) (col i64) (first bool) (glued bool)])

(defn ident-start? [(c u8)] (-> bool)
  (or (and (>= c #\a) (<= c #\z)) (and (>= c #\A) (<= c #\Z)) (= c #\_)))

(defn digit? [(c u8)] (-> bool)
  (and (>= c #\0) (<= c #\9)))

(defn hex-value [(c u8)] (-> i64)
  (cond (digit? c) (cast i64 (- c #\0))
        (and (>= c #\a) (<= c #\f)) (+ 10 (cast i64 (- c #\a)))
        (and (>= c #\A) (<= c #\F)) (+ 10 (cast i64 (- c #\A)))
        :else -1))

;;; Inside a name: letters, digits, `_`, a trailing `?` or `!`, and a `-` that a
;;; name character follows (`spill-cost`); subtraction is written with spaces.
(defn ident-rest? [(src (slice u8)) (i i64)] (-> bool)
  (let [c (get src i)]
    (or (ident-start? c)
        (digit? c)
        (= c #\?)
        (= c #\!)
        (and (= c #\-)
             (< (+ i 1) (len src))
             (or (ident-start? (get src (+ i 1))) (digit? (get src (+ i 1))))))))

(defn punct? [(s (slice u8))] (-> bool)
  (or (= s "...") (= s ">>>") (= s "<<=") (= s "=>") (= s "->") (= s "==") (= s "!=") (= s "<=")
      (= s ">=") (= s "<<") (= s ">>") (= s "..") (= s "::") (= s "??") (= s ":=") (= s "|>")
      (= s "&&") (= s "||") (= s "(") (= s ")") (= s "[") (= s "]") (= s "{") (= s "}") (= s ",")
      (= s ";") (= s ":") (= s ".") (= s "=") (= s "<") (= s ">") (= s "+") (= s "-") (= s "*")
      (= s "/") (= s "%") (= s "&") (= s "|") (= s "^") (= s "~") (= s "!") (= s "?") (= s "@")
      (= s "$")))

;;; The length of the longest punctuation at `i`, or 0.
(defn punct-at [(src (slice u8)) (i i64)] (-> i64)
  (cond (and (<= (+ i 3) (len src)) (punct? (subslice src i (+ i 3)))) 3
        (and (<= (+ i 2) (len src)) (punct? (subslice src i (+ i 2)))) 2
        (and (<= (+ i 1) (len src)) (punct? (subslice src i (+ i 1)))) 1
        :else 0))

;;; The whole file as tokens, ending with one T-EOF. `#` starts a comment.
(defn lex [(src (slice u8)) (path (slice u8))] (-> (ArrayList Tok))
  (let [(mut out) (ArrayList::new [Tok] (malloc-allocator))
        (mut i) 0
        (mut line) 1
        (mut line-start) 0
        (mut first) true
        (mut glued) false
        n (len src)]
    (while (< i n)
      (let [c (get src i)
            col (+ (- i line-start) 1)]
        (cond
          (= c #\newline)
            (do (set! i (+ i 1)) (set! line (+ line 1)) (set! line-start i)
                (set! first true) (set! glued false))
          (or (= c #\space) (= c #\tab) (= c #\return))
            (do (set! i (+ i 1)) (set! glued false))
          (= c #\#)
            (while (and (< i n) (!= (get src i) #\newline)) (set! i (+ i 1)))
          (ident-start? c)
            (let [start i]
              (set! i (+ i 1))
              (while (and (< i n) (ident-rest? src i)) (set! i (+ i 1)))
              (push! (mut out)
                     (Tok :kind T-IDENT :text (subslice src start i) :value 0 :line line
                          :col col :first first :glued glued))
              (set! first false) (set! glued true))
          (digit? c)
            (let [start i
                  (mut v) (: 0 u64)]
              (cond
                (and (= c #\0) (< (+ i 1) n) (= (get src (+ i 1)) #\x))
                  (do (set! i (+ i 2))
                      (while (and (< i n) (or (>= (hex-value (get src i)) 0) (= (get src i) #\_)))
                        (when (!= (get src i) #\_)
                          (set! v (| (<< v 4) (cast u64 (hex-value (get src i))))))
                        (set! i (+ i 1))))
                (and (= c #\0) (< (+ i 1) n) (= (get src (+ i 1)) #\b))
                  (do (set! i (+ i 2))
                      (while (and (< i n) (or (= (get src i) #\0) (= (get src i) #\1)
                                              (= (get src i) #\_)))
                        (when (!= (get src i) #\_)
                          (set! v (| (<< v 1) (cast u64 (- (get src i) #\0)))))
                        (set! i (+ i 1))))
                :else
                  (while (and (< i n) (or (digit? (get src i)) (= (get src i) #\_)))
                    (when (!= (get src i) #\_)
                      (set! v (primitive/iadd (primitive/imul v 10)
                                              (cast u64 (- (get src i) #\0)))))
                    (set! i (+ i 1))))
              (push! (mut out)
                     (Tok :kind T-NUM :text (subslice src start i) :value v :line line
                          :col col :first first :glued glued))
              (set! first false) (set! glued true))
          (= c #\")
            (let [start (+ i 1)]
              (set! i (+ i 1))
              (while (and (< i n) (!= (get src i) #\"))
                (set! i (+ i (if (= (get src i) #\\) 2 1))))
              (when (>= i n) (fail-at path line col "unterminated string"))
              (push! (mut out)
                     (Tok :kind T-STR :text (subslice src start i) :value 0 :line line
                          :col col :first first :glued glued))
              (set! i (+ i 1))
              (set! first false) (set! glued true))
          :else
            (let [k (punct-at src i)]
              (when (= k 0) (fail-at path line col "unexpected character"))
              (push! (mut out)
                     (Tok :kind T-PUNCT :text (subslice src i (+ i k)) :value 0 :line line
                          :col col :first first :glued glued))
              (set! i (+ i k))
              (set! first false) (set! glued true)))))
    (push! (mut out)
           (Tok :kind T-EOF :text "end of file" :value 0 :line line :col (+ (- i line-start) 1)
                :first true :glued false))
    out))

;; ---------------------------------------------------------------- cursor

(defstruct Cur [(toks (ArrayList Tok)) (pos i64) (path (slice u8))])

(defn cursor [(src (slice u8)) (path (slice u8))] (-> Cur)
  (Cur :toks (lex src path) :pos 0 :path path))

(defn peek [(c (mut Cur))] (-> Tok)
  (get (.toks c) (.pos c)))

;;; The token `k` after the current one, or the final T-EOF.
(defn peek-at [(c (mut Cur)) (k i64)] (-> Tok)
  (let [i (+ (.pos c) k)
        last (- (len (.toks c)) 1)]
    (get (.toks c) (if (> i last) last i))))

(defn advance! [(c (mut Cur))] (-> Tok)
  (let [t (peek (mut c))]
    (when (!= (.kind t) T-EOF) (set! (.pos c) (+ (.pos c) 1)))
    t))

(defn die [(c (mut Cur)) (t Tok) (msg (slice u8))] (-> never)
  (fail-at (.path c) (.line t) (.col t) msg))

(defn eof? [(c (mut Cur))] (-> bool)
  (= (.kind (peek (mut c))) T-EOF))

(defn tok-is? [(t Tok) (s (slice u8))] (-> bool)
  (and (or (= (.kind t) T-IDENT) (= (.kind t) T-PUNCT)) (= (.text t) s)))

;;; The current token is this word or punctuation.
(defn at? [(c (mut Cur)) (s (slice u8))] (-> bool)
  (tok-is? (peek (mut c)) s))

(defn at-ident? [(c (mut Cur))] (-> bool)
  (= (.kind (peek (mut c))) T-IDENT))

(defn at-num? [(c (mut Cur))] (-> bool)
  (= (.kind (peek (mut c))) T-NUM))

;;; The current token begins a line: where line-ended forms stop.
(defn at-line-start? [(c (mut Cur))] (-> bool)
  (.first (peek (mut c))))

(defn accept! [(c (mut Cur)) (s (slice u8))] (-> bool)
  (if (at? (mut c) s)
      (do (advance! (mut c)) true)
      false))

(defn expect! [(c (mut Cur)) (s (slice u8))] (-> Tok)
  (if (at? (mut c) s)
      (advance! (mut c))
      (let [t (peek (mut c))]
        (die (mut c) t (cat4 "expected `" s "`, found " (.text t))))))

(defn name! [(c (mut Cur)) (what (slice u8))] (-> (slice u8))
  (let [t (peek (mut c))]
    (if (= (.kind t) T-IDENT)
        (.text (advance! (mut c)))
        (die (mut c) t (cat4 "expected " what ", found " (.text t))))))

(defn num! [(c (mut Cur)) (what (slice u8))] (-> u64)
  (let [t (peek (mut c))]
    (if (= (.kind t) T-NUM)
        (.value (advance! (mut c)))
        (die (mut c) t (cat4 "expected " what ", found " (.text t))))))

;; ---------------------------------------------------------------- output

;;; The Coil text a language compiles a file to.
(defstruct Out [(buf str/StrBuf)])

(defn out-new [] (-> Out)
  (Out :buf (str/StrBuf::new (malloc-allocator))))

(defn emit! [(o (mut Out)) (s (slice u8))] (-> void)
  (push-str! (mut (.buf o)) s))

(defn line! [(o (mut Out)) (s (slice u8))] (-> void)
  (push-str! (mut (.buf o)) s)
  (push-str! (mut (.buf o)) "\n"))

(defn emit-int! [(o (mut Out)) (n i64)] (-> void)
  (push-i64! (mut (.buf o)) n))

(defn text-of [(o (mut Out))] (-> (slice u8))
  (finish! (mut (.buf o))))

;;; A name's upper-case form: how a type `i32` becomes a constant `T-I32`.
(defn upper [(s (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (malloc-allocator))]
    (for ch s
      (push! (mut (.bytes b)) (if (and (>= ch #\a) (<= ch #\z)) (- ch 32) ch)))
    (finish! (mut b))))

;;; A name's lower-case form: how a node `ADD` becomes a function `add`.
(defn lower [(s (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (malloc-allocator))]
    (for ch s
      (push! (mut (.bytes b))
             (cond (and (>= ch #\A) (<= ch #\Z)) (+ ch 32)
                   (= ch #\_) #\-
                   :else ch)))
    (finish! (mut b))))

(defn slice-of [(s (slice u8)) (lo i64) (hi i64)] (-> (slice u8))
  (subslice s lo hi))

(defn index-of [(names (ArrayList (slice u8))) (name (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for i (range 0 (len names))
      (when (and (< found 0) (= (get names i) name)) (set! found i)))
    found))

;;; Where `part` first starts in `s`, or -1.
(defn index-of-text [(s (slice u8)) (part (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for i (range 0 (+ (- (len s) (len part)) 1))
      (when (and (< found 0) (= (subslice s i (+ i (len part))) part)) (set! found i)))
    found))

(defn ends-with [(s (slice u8)) (suffix (slice u8))] (-> bool)
  (and (>= (len s) (len suffix))
       (= (subslice s (- (len s) (len suffix)) (len s)) suffix)))
