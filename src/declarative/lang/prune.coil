;;; Reference-count pruning of an ordered graph stream. Queries declare uses,
;;; protected roots and each node's operands. A reverse sweep removes eligible
;;; zero-use nodes and releases their operand uses, preserving stream order.
(module lang.prune)
(import "lang.text" :as t)
(import "lang.relation" :as relation)
(import "lang.template" :as template)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn text [(name (slice u8)) (params (slice u8)) (bindings (ArrayList relation/Column))
            (uses relation/Index) (roots relation/Index) (operands relation/Index)] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (for binding bindings (push! (mut values) binding))
    (push! (mut values) (relation/Column :target "name" :value name))
    (push! (mut values) (relation/Column :target "params" :value params))
    (push! (mut values) (relation/Column :target "uses" :value
      (relation/query uses (t/cat3 "(let [node* (cast i64 " (.key uses)
        ")] (set! (mut counts*) node* (+ (get counts* node*) (: 1 u32))))"))))
    (push! (mut values) (relation/Column :target "roots" :value
      (relation/query roots (t/cat3 "(let [node* (cast i64 " (.key roots)
        ")] (set! (mut counts*) node* (+ (get counts* node*) (: 1 u32))))"))))
    (push! (mut values) (relation/Column :target "operands" :value
      (relation/query operands (t/cat3 "(let [node* (cast i64 " (.key operands)
        ")] (set! (mut counts*) node* (- (get counts* node*) (: 1 u32))))"))))
    (template/text
"(defn @name@ @params@ (-> void)
  (let [(mut counts*) @counts@]
    (clear! (mut counts*)) (extend-zeroed! (mut counts*) @count@)
    @uses@ @roots@ @observe@
    (let [(mut removed*) 0 (mut i*) (- (len @stream@) 1)]
      (while (>= i* 0)
        (let [v (get @stream@ i*) item @view@]
          (when (and @removable@ (= (get counts* (cast i64 v)) (: 0 u32)))
            @operands@
            @mark@
            (set! removed* (+ removed* 1))))
        (set! i* (- i* 1)))
      (set! @counts@ counts*)
      (when (> removed* 0) @compact@))))" values)))
