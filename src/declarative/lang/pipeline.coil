;;; A pipeline declares named plans over the passes of one compilation unit.
;;; A plan may call another plan. A fixed point repeats a block until all its
;;; change-reporting passes return zero. Timing measures each top-level step.
(module lang.pipeline)
(import "coil.meta" :as meta)
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "lang.text" :as t)
(import "lang.pass" :as pass)
(import "lang.project" :as project)

(defsum Step
  (Call [(owner t/Tok) (function (slice u8)) (observe bool)])
  (PlanCall [(name t/Tok)])
  (Reset)
  (FixedPoint [(at t/Tok) (body (ArrayList Step))]))

(defstruct Plan [(name t/Tok) (body (ArrayList Step))])

(defn parse-block [(c (mut t/Cur))] (-> (ArrayList Step))
  (t/expect! (mut c) "{")
  (let [(mut steps) (ArrayList::new [Step] (meta/expansion-allocator))]
    (while (not (t/accept! (mut c) "}"))
      (let [tok (t/peek (mut c))
            name (t/name! (mut c) "a pipeline step or `}`")]
        (push! (mut steps)
               (cond (= name "repeat") (FixedPoint tok (parse-block (mut c)))
                     (= name "invalidate") (do (t/expect! (mut c) ";") (Reset))
                     (= name "include")
                       (let [called (t/peek (mut c))]
                         (t/name! (mut c) "a plan name")
                         (t/expect! (mut c) ";")
                         (PlanCall called))
                     (or (= name "run") (= name "observe"))
                       (let [owner (t/peek (mut c))]
                         (t/name! (mut c) "a pass name")
                         (t/expect! (mut c) ".")
                         (let [function (t/name! (mut c) "a pass function")]
                           (t/expect! (mut c) ";")
                           (Call owner function (= name "observe"))))
                     :else
                       (t/die (mut c)
                              tok
                              "expected run, observe, include, invalidate or repeat")))))
    steps))

(defn parse-plans [(c (mut t/Cur))] (-> (ArrayList Plan))
  (let [(mut plans) (ArrayList::new [Plan] (meta/expansion-allocator))
        (mut exports) (ArrayList::new [(slice u8)] (meta/expansion-allocator))]
    (while (not (t/eof? (mut c)))
      (t/expect! (mut c) "plan")
      (let [tok (t/peek (mut c))
            name (t/name! (mut c) "a plan name")]
        (for export [name
                     (t/cat2 name "-timed")
                     (t/cat2 (t/upper name) "-STEPS")]
          (when (>= (t/index-of exports export) 0)
            (t/die (mut c) tok (t/cat2 "duplicate pipeline export " export)))
          (push! (mut exports) export))
        (push! (mut plans) (Plan :name tok :body (parse-block (mut c))))))
    plans))

(defsum Action
  (RunPass [(module-id i64) (function (slice u8)) (reports-change bool)])
  (RunPlan [(plan-id i64)])
  (ResetState)
  (Repeat [(body (ArrayList CheckedStep))]))

(defstruct CheckedStep [(label (slice u8)) (action Action)])

(defstruct Check
  [(path (slice u8))
   (decls pass/Decls)
   (plans (ArrayList Plan))
   (modules (ArrayList (slice u8)))])

(defn fail [(k Check) (at t/Tok) (msg (slice u8))] (-> never)
  (t/fail-at (.path k) (.line at) (.col at) msg))

(defn plan-id [(k Check) (name t/Tok) (before i64)] (-> i64)
  (let [(mut id) (- 0 1)]
    (for i (range 0 before)
      (when (= (.text (.name (get (.plans k) i))) (.text name)) (set! id i)))
    (when (< id 0) (fail k name (t/cat2 "no earlier plan named " (.text name))))
    id))

(defn resolve-call [(k (mut Check))
                    (owner t/Tok)
                    (function (slice u8))
                    (observe bool)]
  (-> CheckedStep)
  (let [label (t/cat3 (.text owner) "." function)
        suffix (t/cat2 "." (.text owner))
        (mut module) ""
        (mut result) ""
        (mut arity) 0]
    (for f (.funcs (.decls k))
      (when (and (= (.name f) function) (t/ends-with (.module f) suffix))
        (when (and (!= module "") (!= module (.module f)))
          (fail k owner (t/cat2 "ambiguous step " label)))
        (set! module (.module f))
        (set! result (.result f))
        (set! arity (len (.params f)))))
    (when (= module "") (fail k owner (t/cat2 "no step " label)))
    (when (!= arity 0)
      (fail k owner (t/cat2 "pipeline steps cannot take arguments: " label)))
    (when (and observe (!= result "Int"))
      (fail k owner (t/cat2 "observed pass must report a change count: " label)))
    (let [(mut id) (t/index-of (.modules k) module)]
      (when (< id 0)
        (set! id (len (.modules k)))
        (push! (mut (.modules k)) module))
      (CheckedStep
        :label label
        :action
          (RunPass id
                   (if (pass/pass-module? (.decls k) module)
                       (pass/local-name function)
                       function)
                   observe)))))

(defn check-block [(k (mut Check))
                   (steps (ArrayList Step))
                   (before i64)
                   (repeating bool)]
  (-> (ArrayList CheckedStep))
  (let [(mut body) (ArrayList::new [CheckedStep] (meta/expansion-allocator))]
    (for step steps
      (push! (mut body)
             (match step
               (Call [owner f observe]
                     (when (and observe (not repeating))
                       (fail k
                             owner
                             "observe is only allowed directly in a repeat block"))
                     (resolve-call (mut k) owner f observe))
               (PlanCall [name]
                         (CheckedStep
                           :label (.text name)
                           :action (RunPlan (plan-id k name before))))
               (Reset [] (CheckedStep :label "start-over" :action (ResetState)))
               (FixedPoint [at block]
                           (let [checked (check-block (mut k) block before true)
                                 (mut reports) false]
                             (for s checked
                               (match (.action s)
                                 (RunPass [_ _ changes]
                                          (when changes (set! reports true)))
                                 (_ (do))))
                             (unless reports
                               (fail k
                                     at
                                     "repeat needs an observed pass"))
                             (CheckedStep
                               :label "until-stable"
                               :action (Repeat checked)))))))
    body))

(defn lower-step [(plans (ArrayList Plan)) (step CheckedStep) (counted bool)]
  (-> Code)
  (match (.action step)
    (RunPass [id f changes]
             (let [call `(~(primitive/code-symbol "m" id "/" f) (mut cx))]
               (if (and counted changes)
                   `(when (> ~call 0) (set! changed* true))
                   call)))
    (RunPlan [id]
             `(~(primitive/code-symbol (.text (.name (get plans id)))) (mut cx)))
    (ResetState [] `(st/begin! (mut cx)))
    (Repeat [body]
            (let [(mut forms) (primitive/code-list-new)]
              (for s body (push! (mut forms) (lower-step plans s true)))
              `(let [(mut changed*) true]
                 (while changed*
                   (set! changed* false)
                   ~@forms))))))

(defn lower-plan [(plans (ArrayList Plan))
                  (plan Plan)
                  (body (ArrayList CheckedStep))] (-> Code)
  (let [name (.text (.name plan))
        (mut plain) (primitive/code-list-new)
        (mut timed) (primitive/code-list-new)
        (mut names) (primitive/code-list-new)]
    (for i (range 0 (len body))
      (let [step (get body i)
            form (lower-step plans step false)]
        (push! (mut plain) form)
        (push! (mut timed)
               `(let [t* (clock/now)] ~form (clock/add! (mut times) ~i t*)))
        (push! (mut names) `~(.label step))))
    `((defn ~(primitive/code-symbol name) [(cx (mut st/State))] (-> void)
        ~@plain
        (do)) (defn ~(primitive/code-symbol name "-timed") [(cx (mut st/State))
                                                            (times (mut (ArrayList i64)))]
                (-> void)
                ~@timed
                (do))
        (def ~(primitive/code-symbol (t/upper name) "-STEPS") [~@names]))))

(defn compile-module [(project project/Project)
                      (path (slice u8))
                      (src (slice u8))] (-> Code)
  (let [(mut c) (t/cursor src path)]
    (t/expect! (mut c) "schedule")
    (t/expect! (mut c) "for")
    (let [at (t/peek (mut c))
          unit
            (project/resolve project
                             (pass/module-name! (mut c))
                             (.line at)
                             (.col at))
          template
            (if (t/accept! (mut c) "using")
                (let [tok (t/advance! (mut c))]
                  (unless (= (.kind tok) t/T-STR)
                    (t/die (mut c) tok "expected a quoted schedule file"))
                  (unless (t/eof? (mut c))
                    (t/die (mut c)
                           (t/peek (mut c))
                           "unexpected text after schedule"))
                  (t/cat3 (project/dir-of path) "/" (.text tok)))
                "")
          plan-path (if (= template "") path template)
          plans
            (if (= template "")
                (parse-plans (mut c))
                (let [(mut shared)
                        (t/cursor (project/read-file template path) template)]
                  (parse-plans (mut shared))))
          decls
            (pass/load-unit project
                            (project/file-of project unit (.line at) (.col at))
                            path)
          (mut k)
            (Check
              :path plan-path
              :decls decls
              :plans plans
              :modules (ArrayList::new [(slice u8)] (meta/expansion-allocator)))
          (mut definitions) (primitive/code-list-new)
          (mut imports) (primitive/code-list-new)
          (mut dependencies) (primitive/code-list-new)]
      (for i (range 0 (len plans))
        (let [plan (get plans i)
              body (check-block (mut k) (.body plan) i false)
              forms (lower-plan plans plan body)]
          (for j (range 0 (primitive/code-count forms))
            (push! (mut definitions) (primitive/code-nth forms j)))))
      (when (!= template "") (push! (mut dependencies) `~template))
      (for file (.files decls) (push! (mut dependencies) `~file))
      (for i (range 0 (len (.modules k)))
        (push! (mut imports)
               `(import ~(get (.modules k) i)
                        :as
                        ~(primitive/code-symbol "m" i))))
      `(do
         (depends-on ~@dependencies)
         (import ~unit :as st)
         (import "coil.arraylist" :use [ArrayList])
         (import "declarative.rt.clock" :as clock)
         ~@imports
         ~@definitions))))
