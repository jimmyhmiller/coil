;;; The `.pipeline` language: which steps make a compile, as named plans.
;;;
;;;   plan quick   { cfg.build  schedule.build  select.run  alloc.run  emit.run }
;;;   plan default { until-stable { simplify.run }  quick }
;;;
;;; A step is a function of a pass, a rewrite or another plan. `until-stable`
;;; repeats its steps while any of them reports a change (a step that answers a
;;; number answers how much it changed). A plan is one function of the compile's
;;; state; nothing else is shared, so plans may run on as many threads as there
;;; are states.
;;;
;;; Each plan is also `NAME-timed`, which adds the nanoseconds each of its steps
;;; took to a list of totals, and `NAME-STEPS` names those steps.
(module lang.pipeline)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "lang.text" :as t)
(import "lang.pass" :as pass)
(import "lang.project" :as project)

(defstruct P [(c t/Cur) (d pass/Decls) (plans (ArrayList (slice u8))) (modules (ArrayList (slice u8)))
              (names (ArrayList (slice u8)))])

;;; The steps up to `}`, as Coil, one text for each. `counted` wraps each step
;;; so that what it changed is added to `changed*`.
(defn step-list [(p (mut P)) (counted bool)] (-> (ArrayList (slice u8)))
  (let [(mut list) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (while (not (t/accept! (mut (.c p)) "}"))
      (let [tok (t/advance! (mut (.c p)))
            name (.text tok)
            (mut label) name]
        (cond
          (= name "until-stable")
            (do (t/expect! (mut (.c p)) "{")
                (push! (mut list)
                       (t/cat3 " (let [(mut changed*) 1] (while (> changed* 0) (set! changed* 0)"
                               (steps (mut p) true) "))")))
          ; `start-over`: forget everything the passes have worked out, keeping
          ; the graph, as after a pass that changed it.
          (= name "start-over") (push! (mut list) " (st/begin! (mut cx))")
          ; Another plan, in full.
          (>= (t/index-of (.plans p) name) 0) (push! (mut list) (t/cat3 " (" name " (mut cx))"))
          :else
            ; `module.function`, where the module is named by its last part.
            (let [(mut module) ""]
              (t/expect! (mut (.c p)) ".")
              (let [function (t/name! (mut (.c p)) "a function")
                    (mut result) ""]
                (set! label (t/cat3 name "." function))
                (for f (.funcs (.d p))
                  (when (and (= (.name f) function) (t/ends-with (.module f) (t/cat2 "." name)))
                    (set! module (.module f))
                    (set! result (.result f))))
                (when (= module "")
                  (t/die (mut (.c p)) tok (t/cat4 "no step " name "." function)))
                (when (< (t/index-of (.modules p) module) 0) (push! (mut (.modules p)) module))
                  (let [call (t/cat4 "(" (t/cat3 "m" (t/int-text (t/index-of (.modules p) module)) "/")
                                   (if (pass/pass-module? (.d p) module) (pass/local-name function) function)
                                   " (mut cx))")]
                  (push! (mut list)
                         (if (and counted (= result "Int"))
                             (t/cat3 " (set! changed* (+ changed* " call "))")
                             (t/cat2 " " call)))))))
        ; The names of a plan's own steps, not of those inside them.
        (unless counted (push! (mut (.names p)) label))))
    list))

(defn steps [(p (mut P)) (counted bool)] (-> (slice u8))
  (let [(mut o) (t/out-new)]
    (for step (step-list (mut p) counted) (t/emit! (mut o) step))
    (t/text-of (mut o))))

(defn module-text [(context Code)] (-> (slice u8))
  (let [project (project/open context)
        path (t/path-of context)
        src (t/source-of context)
        (mut c) (t/cursor src path)]
    (t/expect! (mut c) "pipeline")
    (t/expect! (mut c) "in")
    (let [at (t/peek (mut c))
          unit (project/resolve project (pass/module-name! (mut c)) (.line at) (.col at))
          d (pass/load-unit project (project/file-of project unit (.line at) (.col at)) path)
          (mut p) (P :c c :d d
                     :plans (ArrayList::new [(slice u8)] (malloc-allocator))
                     :modules (ArrayList::new [(slice u8)] (malloc-allocator))
                     :names (ArrayList::new [(slice u8)] (malloc-allocator)))
          (mut body) (t/out-new)
          (mut o) (t/out-new)]
      (while (not (t/eof? (mut (.c p))))
        (let [tok (t/advance! (mut (.c p)))]
          (unless (t/tok-is? tok "plan") (t/die (mut (.c p)) tok (t/cat2 "expected plan, found " (.text tok))))
          (let [name (t/name! (mut (.c p)) "a plan name")]
            (t/expect! (mut (.c p)) "{")
            (clear! (mut (.names p)))
            (let [list (step-list (mut p) false)
                  (mut plain) (t/out-new)
                  (mut timed) (t/out-new)
                  (mut names) (t/out-new)]
              (for i (range 0 (len list))
                (t/emit! (mut plain) (get list i))
                (t/emit! (mut timed) (t/cat4 " (let [t* (clock/now)]" (get list i)
                                             " (clock/add! (mut times) " (t/cat2 (t/int-text i) " t*))")))
                (t/emit! (mut names) (t/cat3 " \"" (get (.names p) i) "\"")))
              (t/line! (mut body)
                       (t/cat4 "(defn " name " [(cx (mut st/State))] (-> void) (do"
                               (t/cat2 (t/text-of (mut plain)) " (do)))")))
              (t/line! (mut body)
                       (t/cat4 "(defn " name "-timed [(cx (mut st/State)) (times (mut (ArrayList i64)))] (-> void) (do"
                               (t/cat2 (t/text-of (mut timed)) " (do)))")))
              (t/line! (mut body) (t/cat4 "(def " (t/upper name) "-STEPS [" (t/cat2 (t/text-of (mut names)) "])"))))
            (push! (mut (.plans p)) name))))
      (t/emit! (mut o) (pass/depends-text d))
      (t/line! (mut o) (t/cat3 "(import \"" unit "\" :as st)"))
      (t/line! (mut o) "(import \"coil.arraylist\" :use [ArrayList])")
      (t/line! (mut o) "(import \"declarative.rt.clock\" :as clock)")
      (for i (range 0 (len (.modules p)))
        (t/line! (mut o) (t/cat4 "(import \"" (get (.modules p) i) "\" :as m" (t/cat2 (t/int-text i) ")"))))
      (t/emit! (mut o) (t/text-of (mut body)))
      (t/text-of (mut o)))))
