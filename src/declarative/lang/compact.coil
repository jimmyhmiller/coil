;;; Stable segmented filtering, optionally carrying forward anchors. Dropped
;;; anchored items refer to the next retained item in their own segment, or the
;;; absent value. Scratch capacity is reused; input and scratch exchange ownership.
(module lang.compact)
(import "lang.text" :as t)
(import "lang.relation" :as relation)
(import "lang.template" :as template)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn text [(name (slice u8)) (params (slice u8)) (inline bool) (tracked bool)
            (bindings (ArrayList relation/Column)) (groups relation/Index)] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (for binding bindings (push! (mut values) binding))
    (push! (mut values) (relation/Column :target "name" :value name))
    (push! (mut values) (relation/Column :target "params" :value params))
    (push! (mut values) (relation/Column :target "policy" :value (if inline " :inline (Always) " " ")))
    (push! (mut values) (relation/Column :target "group" :value (.key groups)))
    (push! (mut values) (relation/Column :target "groups" :value
      (relation/query groups (template/text (if tracked
"(let [group @group@ lo* (cast i64 @begin@) hi* (cast i64 @end@)
       begin (cast u32 (len out*)) (mut pending*) (len moved*)]
   (for j* (range lo* hi*)
     (let [v (get @input@ j*) item @view@]
       (if @keep@
           (do (push! (mut out*) v)
               (when (< pending* (len moved*))
                 @mark@
                 (for k* (range pending* (len moved*))
                   (when (= (% k* 2) 1) (set! (mut moved*) k* v)))
                 (set! pending* (len moved*))))
           (when @anchored@
             (push! (mut moved*) v) (push! (mut moved*) @absent@)))))
   (let [end (cast u32 (len out*))] @configure@))"
"(let [group @group@ lo* (cast i64 @begin@) hi* (cast i64 @end@) begin (cast u32 (len out*))]
   (for j* (range lo* hi*)
     (let [v (get @input@ j*) item @view@] (when @keep@ (push! (mut out*) v))))
   (let [end (cast u32 (len out*))] @configure@))") values))))
    (template/text (if tracked
"(defn @name@@policy@@params@ (-> void)
  (let [(mut out*) @output@ (mut moved*) (ArrayList::new [u32] (malloc-allocator))]
    (clear! (mut out*))
    @groups@
    (when (> (len moved*) 0)
      (for m* (range 0 (len @anchors@))
        (let [old* (get @anchors@ m*)]
          (for k* (range 0 (/ (len moved*) 2))
            (when (= (get moved* (* k* 2)) old*)
              (set! (mut @anchors@) m* (get moved* (+ (* k* 2) 1))))))))
    (free! (mut moved*))
    (set! @output@ @input@)
    (set! @input@ out*)))"
"(defn @name@@policy@@params@ (-> void)
  (let [(mut out*) @output@] (clear! (mut out*)) @groups@
    (set! @output@ @input@) (set! @input@ out*)))") values)))
