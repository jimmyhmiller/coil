;;; Predicate and rewrite plans are conjunctions of constraints over derived
;;; relations. Materializations are scheduled in dependency order; a failed
;;; constraint skips the remaining work and a rewrite's effects.
(module lang.plan)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "lang.text" :as t)
(import "lang.relation" :as relation)
(defstruct Step [(kind (slice u8)) (name (slice u8)) (value (slice u8)) (cleanup (slice u8))])

(defn materialize [(target (slice u8)) (rows relation/Index)] (-> (slice u8))
  (t/cat4 "(clear! (mut " target ")) "
    (relation/query rows (t/cat4 "(push! (mut " target ") " (t/cat2 (.key rows) ")")))))

(defn text [(name (slice u8)) (params (slice u8)) (inline bool) (steps (ArrayList Step))
            (result (slice u8)) (failure (slice u8)) (success (slice u8))] (-> (slice u8))
  (let [(mut guarded) false]
    (for step steps (when (= (.kind step) "require") (set! guarded true)))
    (let [(mut body) (if guarded (t/cat3 "(return-from :rewrite* " success ")") success)]
      (for i (range 0 (len steps))
        (let [step (get steps (- (- (len steps) 1) i))]
          (set! body
            (cond (= (.kind step) "resource")
                    (t/cat4 "(let [(mut " (.name step) ") "
                      (t/cat4 (.value step) "] (defer " (.cleanup step) (t/cat3 ") " body ")")))
                  (or (= (.kind step) "let") (= (.kind step) "create"))
                    (t/cat4 "(let [" (.name step) " " (t/cat4 (.value step) "] " body ")"))
                  (= (.kind step) "require")
                    (t/cat4 "(if " (.value step) " " (t/cat2 body " (return-from :reject* (do)))"))
                  :else (t/cat4 "(do " (.value step) " " (t/cat2 body ")"))))))
      ; A common rejection path belongs to the function's parameter scope, not
      ; any rule binding's scope. It runs once and only if a constraint fails.
      (when guarded
        (set! body (t/cat4 "(block :rewrite* (block :reject* " body ") " (t/cat2 failure ")"))))
      (t/cat4 "(defn " name (if inline " :inline (Always) " " ")
        (t/cat4 params " (-> " result (t/cat3 ") " body ")"))))))
