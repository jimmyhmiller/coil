;;; Internal code templates. Substitutions are single-pass: inserted expressions
;;; are never reinterpreted as template syntax. Guest languages cannot supply a
;;; template, only the typed declarations their readers accept.
(module lang.template)
(import "lang.text" :as t)
(import "lang.relation" :use [Column])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)

(defn text [(source (slice u8)) (bindings (ArrayList Column))] (-> (slice u8))
  (let [(mut out) (t/out-new) (mut begin) 0 (mut i) 0]
    (while (< i (len source))
      (if (= (get source i) #\@)
          (do
            (t/emit! (mut out) (t/slice-of source begin i))
            (set! begin (+ i 1)) (set! i begin)
            (while (and (< i (len source)) (!= (get source i) #\@)) (set! i (+ i 1)))
            (when (= i (len source)) (primitive/error "unterminated internal template binding"))
            (let [key (t/slice-of source begin i) (mut found) false]
              (for binding bindings
                (when (= (.target binding) key)
                  (when found (primitive/error "duplicate internal template binding"))
                  (set! found true) (t/emit! (mut out) (.value binding))))
              (unless found (primitive/error (t/cat2 "unknown internal template binding: " key))))
            (set! i (+ i 1)) (set! begin i))
          (set! i (+ i 1))))
    (t/emit! (mut out) (t/slice-of source begin (len source)))
    (t/text-of (mut out))))
