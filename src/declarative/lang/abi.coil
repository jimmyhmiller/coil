;;; The `.abi` language: how a calling convention places arguments and results.
;;;
;;;   target backend.a64
;;;   integers x0..x7        # integer arguments, in order; the rest go on the stack
;;;   result x0
;;;   link x30               # where a call leaves its return address, or
;;;   return-address 8       # how many bytes of it a call leaves on the stack
;;;   frame x29              # the frame record's register
;;;
;;; From it: `int-arg` (the register of the i-th integer argument, or -1 for the
;;; stack), the set of argument registers, and the named registers' numbers.
(module lang.abi)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "lang.text" :as t)
(import "lang.isa" :as isa)
(import "lang.project" :as project)

(defn module-name! [(c (mut t/Cur))] (-> (slice u8))
  (let [(mut name) (t/name! (mut c) "a module name")]
    (while (and (t/at? (mut c) ".") (.glued (t/peek (mut c))))
      (t/advance! (mut c))
      (set! name (t/cat3 name "." (t/name! (mut c) "a module name"))))
    name))

(defn reg! [(c (mut t/Cur)) (spec isa/Spec)] (-> i64)
  (let [at (t/peek (mut c))
        name (t/name! (mut c) "a register")
        number (isa/reg-number spec name)]
    (when (< number 0) (t/die (mut c) at (t/cat2 "the target has no register " name)))
    number))

(defn module-text [(context Code)] (-> (slice u8))
  (let [p (project/open context)
        path (t/path-of context)
        (mut c) (t/cursor (t/source-of context) path)
        (mut o) (t/out-new)
        (mut link) false
        (mut return-slots) 0
        (mut variadic-stack) false
        (mut variadic-count) -1
        (mut indirect) -1
        (mut packed) false
        (mut closing) false]
    (t/expect! (mut c) "target")
    (let [at (t/peek (mut c))
          target (module-name! (mut c))
          file (project/file-of p target (.line at) (.col at))
          spec (isa/parse (project/read-file file path) file)]
      (t/line! (mut o) (t/cat3 "(depends-on \"" file "\")"))
      (while (not (t/eof? (mut c)))
        (let [tok (t/advance! (mut c))]
          (cond
            (t/tok-is? tok "integers")
              (let [names (isa/parse-reg-list (mut c))
                    (mut mask) (: 0 u64)]
                (t/line! (mut o) "(defn int-arg :inline (Always) [(i i64)] (-> i64)")
                (t/emit! (mut o) "  (cond")
                (for i (range 0 (len names))
                  (let [number (isa/reg-number spec (get names i))]
                    (when (< number 0) (t/die (mut c) tok (t/cat2 "the target has no register " (get names i))))
                    (set! mask (| mask (<< (: 1 u64) (cast u64 number))))
                    (t/emit! (mut o) (t/cat4 " (= i " (t/int-text i) ") " (t/int-text number)))))
                (t/line! (mut o) " :else -1))")
                (t/line! (mut o) (t/cat3 "(const INT-ARGS " (t/int-text (len names)) ")"))
                (t/line! (mut o) (t/cat3 "(const ARGUMENTS " (t/u64-text mask) ")")))
            (t/tok-is? tok "floats")
              (let [names (isa/parse-reg-list (mut c))]
                (t/line! (mut o) "(defn float-arg :inline (Always) [(i i64)] (-> i64)")
                (t/emit! (mut o) "  (cond")
                (for i (range 0 (len names))
                  (let [number (isa/reg-number spec (get names i))]
                    (when (< number 0) (t/die (mut c) tok (t/cat2 "the target has no register " (get names i))))
                    (t/emit! (mut o) (t/cat4 " (= i " (t/int-text i) ") " (t/int-text number)))))
                (t/line! (mut o) " :else -1))")
                (t/line! (mut o) (t/cat3 "(const FLOAT-ARGS " (t/int-text (len names)) ")")))
            ; Where values come back, in order: `results` the integers,
            ; `float-results` the floating ones.
            (or (t/tok-is? tok "results") (t/tok-is? tok "float-results"))
              (let [names (isa/parse-reg-list (mut c))]
                (t/line! (mut o) (t/cat3 "(defn " (if (t/tok-is? tok "results") "int-result" "float-result")
                                         " :inline (Always) [(i i64)] (-> i64)"))
                (t/emit! (mut o) "  (cond")
                (for i (range 0 (len names))
                  (let [number (isa/reg-number spec (get names i))]
                    (when (< number 0) (t/die (mut c) tok (t/cat2 "the target has no register " (get names i))))
                    (t/emit! (mut o) (t/cat4 " (= i " (t/int-text i) ") " (t/int-text number)))))
                (t/line! (mut o) " :else -1))"))
            (t/tok-is? tok "link")
              (do (set! link true)
                  (t/line! (mut o) (t/cat3 "(const LINK " (t/int-text (reg! (mut c) spec)) ")")))
            ; How a function that takes any number of arguments gets the ones it
            ; does not name: `variadic stack` puts them all on the stack;
            ; `variadic count REG` passes them like the others and says in REG
            ; how many floating registers were used.
            (t/tok-is? tok "variadic")
              (if (t/accept! (mut c) "stack")
                  (set! variadic-stack true)
                  (do (t/expect! (mut c) "count") (set! variadic-count (reg! (mut c) spec))))
            ; `return-address 8`: a call leaves that many bytes on the stack.
            (t/tok-is? tok "return-address")
              (set! return-slots (/ (cast i64 (t/num! (mut c) "a number of bytes")) 8))
            ; `stack REG` is the stack pointer, and `base REG` the register that
            ; holds where the frame is in a function that moves the stack
            ; pointer as it runs.
            (t/tok-is? tok "stack")
              (t/line! (mut o) (t/cat3 "(const STACK " (t/int-text (reg! (mut c) spec)) ")"))
            (t/tok-is? tok "base")
              (t/line! (mut o) (t/cat3 "(const BASE " (t/int-text (reg! (mut c) spec)) ")"))
            ; `indirect-result REG`: the address a function is to write its
            ; result to has a register of its own.
            (t/tok-is? tok "indirect-result") (set! indirect (reg! (mut c) spec))
            ; `stacked packed`: an argument on the stack takes its own size,
            ; not a whole word. `stacked closing`: once one argument of a kind
            ; is on the stack, so is every later one of that kind.
            (t/tok-is? tok "stacked")
              (let [(mut more) true]
                (while more
                  (cond (t/accept! (mut c) "packed") (set! packed true)
                        (t/accept! (mut c) "closing") (set! closing true)
                        :else (set! more false))))
            (t/tok-is? tok "frame")
              (t/line! (mut o) (t/cat3 "(const FRAME " (t/int-text (reg! (mut c) spec)) ")"))
            :else (t/die (mut c) tok (t/cat2 "expected integers, result, link or frame, found "
                                             (.text tok)))))))
    ; A machine whose calls leave the return address on the stack has no link register.
    (unless link (t/line! (mut o) "(const LINK -1)"))
    (t/line! (mut o) (t/cat3 "(const RETURN-SLOTS " (t/int-text return-slots) ")"))
    (t/line! (mut o) (t/cat3 "(const VARIADIC-ON-STACK " (if variadic-stack "true" "false") ")"))
    (t/line! (mut o) (t/cat3 "(const VARIADIC-COUNT " (t/int-text variadic-count) ")"))
    (t/line! (mut o) (t/cat3 "(const INDIRECT-RESULT " (t/int-text indirect) ")"))
    (t/line! (mut o) (t/cat3 "(const STACK-PACKED " (if packed "true" "false") ")"))
    (t/line! (mut o) (t/cat3 "(const REGISTERS-CLOSE " (if closing "true" "false") ")"))
    (t/text-of (mut o))))
