;;; Dominator equations over a declared directed graph. The lowering uses
;;; reverse postorder and Cooper-Harvey-Kennedy intersection, retaining linear
;;; storage and the original sparse predecessor walk. Unreachable nodes have
;;; no immediate dominator; the entry dominates itself.
(module lang.dominance)
(import "lang.text" :as t)
(import "lang.relation" :as relation)
(import "lang.template" :as template)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn text [(name (slice u8)) (params (slice u8)) (bindings (ArrayList relation/Column))
            (predecessors relation/Index)] (-> (slice u8))
  (let [(mut values) (ArrayList::new [relation/Column] (malloc-allocator))]
    (for binding bindings (push! (mut values) binding))
    (push! (mut values) (relation/Column :target "name" :value name))
    (push! (mut values) (relation/Column :target "params" :value params))
    (push! (mut values) (relation/Column :target "predecessors" :value
      (relation/query predecessors
        (t/cat3 "(let [p* " (.key predecessors)
          "] (when (!= (get parents* (cast i64 p*)) absent*)
            (set! new* (if (= new* absent*) p*
              (block :intersection* (let [(mut a*) p* (mut c*) new*]
                (while (!= a* c*)
                  (while (> (get ranks* (cast i64 a*)) (get ranks* (cast i64 c*)))
                    (set! a* (get parents* (cast i64 a*))))
                  (while (> (get ranks* (cast i64 c*)) (get ranks* (cast i64 a*)))
                    (set! c* (get parents* (cast i64 c*)))))
                a*))))))"))))
    (template/text
"(defn @name@ @params@ (-> void)
  (let [nodes* @nodes@ entry* @entry@ absent* @absent@]
    (library-fill! (mut @ranks@) nodes* absent*)
    (library-fill! (mut @parents@) nodes* absent*)
    (clear! (mut @order@))
    (when (> nodes* 0)
      (let [(mut visited*) (library-repeat [bool] nodes* false)]
        (clear! (mut @work@))
        (push! (mut @work@) entry*) (push! (mut @work@) (: 0 u32))
        (set! (mut visited*) (cast i64 entry*) true)
        (while (> (len @work@) 0)
          (let [n* (len @work@) b (get @work@ (- n* 2)) k (get @work@ (- n* 1))]
            (if (< k @successor-count@)
                (let [next* @successor@]
                  (set! (mut @work@) (- n* 1) (+ k (: 1 u32)))
                  (unless (get visited* (cast i64 next*))
                    (set! (mut visited*) (cast i64 next*) true)
                    (push! (mut @work@) next*) (push! (mut @work@) (: 0 u32))))
                (do (push! (mut @order@) b)
                    (pop! (mut @work@)) (pop! (mut @work@))))))
        (free! (mut visited*)))
      (let [(mut ranks*) @ranks@ (mut parents*) @parents@ count* (len @order@)]
        (for i* (range 0 count*)
          (set! (mut ranks*) (cast i64 (get @order@ i*)) (cast u32 (- (- count* 1) i*))))
        (set! (mut parents*) (cast i64 entry*) entry*)
        (let [(mut changed*) true]
          (while changed*
            (set! changed* false)
            (let [(mut i*) (- count* 1)]
              (while (>= i* 0)
                (let [b (get @order@ i*)]
                  (unless (= b entry*)
                    (let [(mut new*) absent*]
                      @predecessors@
                      (when (and (!= new* absent*) (!= (get parents* (cast i64 b)) new*))
                        (set! (mut parents*) (cast i64 b) new*)
                        (set! changed* true)))))
                (set! i* (- i* 1))))))))))"
      values)))
