;;; Facts: relations over dense keys, derived by rules. A block of facts names
;;; its relations and the rules that state them; the engine owns their storage,
;;; resets it for each derivation, runs every rule driven by a relation once per
;;; fact of it until none is new, and indexes many-valued relations by key.
;;;
;;;   one   R(k) -> T: at most one value per key (a second is an error); a key
;;;         without one reads as `absent`. A scalar's presence is its value, so
;;;         a scalar relation may not state `absent` itself.
;;;   many  R(k) -> T: any number per key, read back as a slice in rule order;
;;;         its rows also have flat indices (R-start, R-at, R-total, R-keys)
;;;   flag  R(k):      whether it holds
;;;   fold  R(k) -> T: `from` X, combined `by` &, |, + or max with every value stated
;;;
;;; A rule states one or more heads, each `R(k) = v` (or `R(k)` for a flag),
;;; each optionally `when` a condition, for every row of its body.
;;;
;;; A rule's body is a row query; `with R(k) = v` makes it run once per fact of
;;; the one-valued relation R in its own block, or each time a fold's value
;;; changes, which is how facts recurse. Lookups take the context alone. A
;;; body reads its own block's relations only through `with`, so what it reads
;;; is complete: other blocks' relations, derived before, are read by call.
(module lang.facts)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "lang.text" :as t)
(import "lang.relation" :as relation)
(import "lang.template" :as template)
(import "coil.primitive" :as primitive)

(defstruct Rel [(kind (slice u8)) (name (slice u8)) (key (slice u8)) (type (slice u8))
                (domain (slice u8)) (init (slice u8)) (op (slice u8))])
(defstruct Head [(rel i64) (key (slice u8)) (value (slice u8)) (guard (slice u8))])
(defstruct Rule [(driver i64) (key (slice u8)) (value (slice u8)) (body relation/Index) (heads (ArrayList Head))])

(defn field-of [(i i64) (part (slice u8))] (-> (slice u8)) (t/cat4 "(." (t/cat2 "r" (t/int-text i)) part " b*)"))
(defn place [(i i64) (part (slice u8))] (-> (slice u8)) (t/cat3 "(mut " (field-of i part) ")"))

(defn bind [(pairs (slice (slice u8)))] (-> (ArrayList relation/Column))
  (let [(mut out) (ArrayList::new [relation/Column] (malloc-allocator))]
    (for i (range 0 (/ (len pairs) 2))
      (push! (mut out) (relation/Column :target (get pairs (* i 2)) :value (get pairs (+ (* i 2) 1)))))
    out))

(defn drives? [(rules (ArrayList Rule)) (i i64)] (-> bool)
  (block :found (for rule rules (when (= (.driver rule) i) (return-from :found true))) false))

;;; A many-valued relation stated only by rules that run once (no `with`) is
;;; counted, then placed, by running those rules twice: no log of its rows.
(defn counted? [(rels (ArrayList Rel)) (rules (ArrayList Rule)) (i i64)] (-> bool)
  (and (= (.kind (get rels i)) "many")
       (block :found (for rule rules (for head (.heads rule) (when (and (= (.rel head) i) (>= (.driver rule) 0)) (return-from :found false)))) true)))

(defn counting? [(rels (ArrayList Rel)) (rules (ArrayList Rule)) (rule Rule)] (-> bool)
  (let [(mut some) false (mut all) true]
    (for head (.heads rule) (if (counted? rels rules (.rel head)) (set! some true) (set! all false)))
    (when (and some (not all)) (primitive/error "facts: a counted many relation is stated by a rule with other heads"))
    some))

;;; A block's boolean columns (flags, and whether a record-valued one relation
;;; holds) share a byte per key with the others over the same domain, a bit each.
(defn bits? [(rel Rel)] (-> bool) (or (= (.kind rel) "flag") (and (= (.kind rel) "one") (not (scalar? rel)))))

(defn bit-index [(rels (ArrayList Rel)) (i i64)] (-> i64)
  (let [(mut n) 0]
    (for k (range 0 i) (when (and (bits? (get rels k)) (= (.domain (get rels k)) (.domain (get rels i)))) (set! n (+ n 1))))
    n))

(defn bit-owner [(rels (ArrayList Rel)) (i i64)] (-> i64)
  (block :found
    (for k (range 0 (+ i 1))
      (when (and (bits? (get rels k)) (= (.domain (get rels k)) (.domain (get rels i)))
                 (= (bit-index rels k) (* (/ (bit-index rels i) 8) 8)))
        (return-from :found k)))
    i))

(defn bits-of [(rels (ArrayList Rel)) (i i64)] (-> (slice u8)) (field-of (bit-owner rels i) "-bits"))
(defn mask-of [(rels (ArrayList Rel)) (i i64)] (-> (slice u8)) (t/cat3 "(: " (t/int-text (<< 1 (% (bit-index rels i) 8))) " u8)"))
(defn bit-test [(rels (ArrayList Rel)) (i i64) (k (slice u8))] (-> (slice u8))
  (t/cat4 "(!= (& (get " (bits-of rels i) (t/cat4 " " k ") " (mask-of rels i)) ") (: 0 u8))"))
(defn bit-set [(rels (ArrayList Rel)) (i i64) (k (slice u8))] (-> (slice u8))
  (t/cat4 "(set! (mut " (bits-of rels i) (t/cat4 ") " k " (| (get " (bits-of rels i)) (t/cat4 " " k ") " (t/cat2 (mask-of rels i) "))"))))

(defn head-text [(name (slice u8)) (rels (ArrayList Rel)) (rules (ArrayList Rule)) (head Head) (mode (slice u8))] (-> (slice u8))
  (let [rel (get rels (.rel head)) i (.rel head)
        values (bind ["v" (place i "-v") "mark" (if (bits? rel) (bit-set rels i "k*") "") "trail" (place i "-trail") "keys" (place i "-keys")
                      "rows" (place i "-rows") "get" (field-of i "-v") "seen" (if (bits? rel) (bit-test rels i "k*") "") "at" (place i "-at") "get-at" (field-of i "-at")
                      "key" (.key head) "value" (.value head) "absent" (t/cat3 "i" (t/int-text i) "*") "what" (t/cat3 name "." (.name rel)) "push" (if (drives? rules i) (t/cat3 " (push! " (place i "-trail") " (cast u32 k*))") "")])
        kind (.kind rel)]
    (template/text
      (t/cat3 (if (= (.guard head) "") "(do " (t/cat3 "(when " (.guard head) " "))
      (cond (= mode "count") "(let [k* (+ (cast i64 @key@) 2)] (set! @at@ k* (+ (get @get-at@ k*) (: 1 u32))))"
            (= mode "place") "(let [k* (+ (cast i64 @key@) 1) at* (get @get-at@ k*)] (set! @v@ (cast i64 at*) @value@) (set! @at@ k* (+ at* (: 1 u32))))"
            (and (= kind "one") (scalar? rel)) "(let [k* (cast i64 @key@) v* @value@] (if (or (!= (get @get@ k*) @absent@) (= v* @absent@)) (do (eprintln \"facts: @what@ is stated twice for one key, or stated absent\") (abort)) (do (set! @v@ k* v*)@push@)))"
            (= kind "one") "(let [k* (cast i64 @key@) v* @value@] (if @seen@ (do (eprintln \"facts: @what@ is stated twice for one key\") (abort)) (do @mark@ (set! @v@ k* v*)@push@)))"
            (= kind "many") "(let [k* (cast u32 @key@) v* @value@] (push! @keys@ k*) (push! @rows@ v*))"
            (= kind "flag") "(let [k* (cast i64 @key@)] @mark@)"
            :else (t/cat3 "(let [k* (cast i64 @key@) o* (get @get@ k*) w* "
                    (if (= (.op rel) "max") "(let [x* @value@] (if (> x* o*) x* o*))" (t/cat3 "(" (.op rel) " o* @value@)"))
                    "] (when (!= w* o*) (set! @v@ k* w*)@push@))"))
      ")")
      values)))

(defn rule-text [(name (slice u8)) (rels (ArrayList Rel)) (rules (ArrayList Rule)) (rule Rule) (mode (slice u8))] (-> (slice u8))
  (let [(mut heads) (t/out-new)]
    (for head (.heads rule) (t/emit! (mut heads) (t/cat2 " " (head-text name rels rules head mode))))
    (relation/query (.body rule) (t/cat3 "(do" (t/text-of (mut heads)) ")"))))

(defn scalar? [(rel Rel)] (-> bool)
  (let [t (.type rel)]
    (or (= t "u8") (= t "u16") (= t "u32") (= t "u64") (= t "i8") (= t "i16") (= t "i32") (= t "i64") (= t "bool"))))

(defn stores? [(rel Rel) (part (slice u8)) (counted bool)] (-> bool)
  (let [kind (.kind rel)]
  (cond (= part "-v") (!= kind "flag")
        (= part "-trail") (or (= kind "one") (= kind "fold")) (= part "-at") (= kind "many") :else (and (= kind "many") (not counted)))))

(defn storage-type [(rel Rel) (part (slice u8))] (-> (slice u8))
  (cond (= part "-bits") "u8" (or (= part "-trail") (= part "-keys") (= part "-at")) "u32" :else (.type rel)))

;;; The first parameter of a parameter list's text, `(name type)`.
(defn first-param [(params (slice u8))] (-> (slice u8))
  (let [(mut depth) 0 (mut i) 1]
    (loop (let [ch (get params i)]
            (when (= ch #\() (set! depth (+ depth 1)))
            (when (= ch #\)) (set! depth (- depth 1)))
            (set! i (+ i 1))
            (when (= depth 0) (break))))
    (t/slice-of params 1 i)))

(defn text [(name (slice u8)) (params (slice u8)) (context (slice u8)) (place-field (slice u8))
            (rels (ArrayList Rel)) (rules (ArrayList Rule))] (-> (slice u8))
  (let [(mut out) (t/out-new) (mut fields) (t/out-new) (mut news) (t/out-new) (mut frees) (t/out-new)
        (mut reset) (t/out-new) (mut seeds) (t/out-new) (mut drive) (t/out-new) (mut index) (t/out-new)
        (mut cursors) (t/out-new) (mut prefixes) (t/out-new) (mut counts) (t/out-new) (mut places) (t/out-new)
        head (t/cat2 "[" (first-param params))
        storage-of (t/cat4 "(let [b* (field " context " " (t/cat2 place-field ")]"))]
    (for i (range 0 (len rels))
      (let [rel (get rels i) r (t/cat2 "r" (t/int-text i)) n (t/cat3 "n" (t/int-text i) "*") kind (.kind rel)
            values (bind ["n" n "init" (t/cat3 "i" (t/int-text i) "*") "v" (place i "-v") "has" (place i "-has") "trail" (place i "-trail")
                          "keys" (place i "-keys") "rows" (place i "-rows") "at" (place i "-at")
                          "bits" (if (and (bits? rel) (= (bit-owner rels i) i)) (t/cat4 " (library-fill! " (place i "-bits") (t/cat2 " " n) " (: 0 u8))") "")
                          "get-keys" (field-of i "-keys") "get-rows" (field-of i "-rows") "get-at" (field-of i "-at")
                          "trail-reset" (if (drives? rules i) (t/cat4 " (clear! " (place i "-trail") ") (reserve! " (t/cat4 (place i "-trail") " " n ")")) "")])]
        (for part ["-v" "-bits" "-trail" "-keys" "-rows" "-at"]
          (when (if (= part "-bits") (and (bits? rel) (= (bit-owner rels i) i))
                    (and (stores? rel part (counted? rels rules i)) (or (!= part "-trail") (drives? rules i))))
           (let [type (storage-type rel part)]
            (t/emit! (mut fields) (t/cat4 " (" r part (t/cat3 " (ArrayList " type "))")))
            (t/emit! (mut news) (t/cat4 " :" r part (t/cat3 " (ArrayList::new [" type "] (malloc-allocator))")))
            (t/emit! (mut frees) (t/cat3 " (free! (mut (.r" (t/int-text i) (t/cat3 part " b*)))" ""))))))
        (t/line! (mut reset) (t/cat4 "(let [" n " (cast i64 " (t/cat4 (.domain rel) ")" (if (= (.init rel) "") "" (t/cat4 " i" (t/int-text i) "* " (.init rel))) "]")))
        (t/line! (mut reset) (template/text
          (cond (and (= kind "one") (scalar? rel)) "(facts-fill! @v@ @n@ @init@)@trail-reset@"
                (= kind "one") "(facts-fill! @v@ @n@ @init@)@bits@@trail-reset@"
                (counted? rels rules i) "(library-fill! @at@ (+ @n@ 2) (: 0 u32))"
                (= kind "many") "(clear! @keys@) (clear! @rows@) (reserve! @keys@ @n@) (reserve! @rows@ @n@)"
                (= kind "flag") "@bits@"
                :else "(facts-fill! @v@ @n@ @init@)@trail-reset@") values))
        (when (= kind "many")
          (let [counted (counted? rels rules i)
                prefix "(for k* (range 0 @n@) (set! @at@ (+ k* 2) (+ (get @get-at@ (+ k* 1)) (get @get-at@ (+ k* 2))))) (clear! @v@) (extend-zeroed! @v@ (cast i64 (get @get-at@ (+ @n@ 1))))"]
            (if counted
                (t/line! (mut prefixes) (template/text prefix values))
                (t/line! (mut index) (template/text (t/cat3 "(library-fill! @at@ (+ @n@ 2) (: 0 u32))
 (for i* (range 0 (len @get-keys@)) (let [k* (+ (cast i64 (get @get-keys@ i*)) 2)] (set! @at@ k* (+ (get @get-at@ k*) (: 1 u32)))))"
                  prefix "(for i* (range 0 (len @get-keys@)) (let [k* (+ (cast i64 (get @get-keys@ i*)) 1) at* (get @get-at@ k*)] (set! @v@ (cast i64 at*) (get @get-rows@ i*)) (set! @at@ k* (+ at* (: 1 u32)))))") values)))))
        (let [lookup (t/cat4 "(defn " (.name rel) " :inline (Always) " (t/cat4 head " (key* " (.key rel) ")] (-> "))
              row (t/cat3 storage-of (if (= kind "flag") (t/cat2 " " (bit-test rels i "(cast i64 key*)")) (t/cat3 " (get " (field-of i "-v") " (cast i64 key*))")) "))")]
          (t/line! (mut out)
            (if (= kind "many")
                (t/cat3 lookup "(slice " (t/cat4 (.type rel) ")) " storage-of
                  (template/text " (let [lo* (get @get-at@ (cast i64 key*)) hi* (get @get-at@ (+ (cast i64 key*) 1))] (slice::new (library-primitive/index (.data @rows@) (cast i64 lo*)) (cast i64 (- hi* lo*))))))"
                    (bind ["get-at" (field-of i "-at") "rows" (field-of i "-v")]))))
                (t/cat4 lookup (if (= kind "flag") "bool" (.type rel)) ") " row)))
          ; A many relation's rows have flat indices 0 .. R-total, key k's from R-start(k).
          (when (= kind "many")
            (t/line! (mut out) (template/text
"(defn @r@-start :inline (Always) @head@ (key* @key@)] (-> i64) @storage@ (cast i64 (get @at@ (cast i64 key*)))))
(defn @r@-at :inline (Always) @head@ (i* i64)] (-> @type@) @storage@ (get @rows@ i*)))
(defn @r@-total :inline (Always) @head@] (-> i64) @storage@ (len @rows@)))
(defn @r@-keys :inline (Always) @head@] (-> i64) @storage@ (- (len @at@) 2)))"
              (bind ["r" (.name rel) "head" head "key" (.key rel) "type" (.type rel) "storage" storage-of
                     "at" (field-of i "-at") "rows" (field-of i "-v")])))))
        (when (or (= kind "one") (= kind "fold"))
          (let [c (t/cat3 "c" (t/int-text i) "*") (mut driven) (t/out-new)]
            (for rule rules
              (when (= (.driver rule) i)
                (t/emit! (mut driven) (t/cat4 " (let [" (.key rule) (t/cat4 " key* " (.value rule) " (get " (field-of i "-v"))
                  (t/cat3 " (cast i64 key*))] " (rule-text name rels rules rule "") ")")))))
            (let [text (t/text-of (mut driven))]
              (unless (= (len text) 0)
                (t/emit! (mut cursors) (t/cat3 " (mut " c ") 0"))
                (t/line! (mut drive) (template/text "(while (< @c@ (len @trail@)) (let [key* (get @trail@ @c@)] (set! @c@ (+ @c@ 1)) (set! more* true)@driven@))"
                  (bind ["c" c "trail" (field-of i "-trail") "driven" text])))))))))
    (for rule rules
      (when (< (.driver rule) 0)
        (if (counting? rels rules rule)
            (do (t/line! (mut counts) (rule-text name rels rules rule "count")) (t/line! (mut places) (rule-text name rels rules rule "place")))
            (t/line! (mut seeds) (rule-text name rels rules rule "")))))
    (template/text
"(defstruct @name@ [@fields@])
(defn @name@-new [] (-> @name@) (@name@@news@))
(defn @name@-free! [(b* (ptr @name@))] (-> void)@frees@)
@lookups@(defn @name@-derive! @params@ (-> void)
 @storage@
 @reset@ @seeds@
 (let [@cursors@] (loop (let [(mut more*) false] @drive@ (unless more* (break)))))
 @index@ @counts@ @prefixes@ @places@ @close@)"
      (bind ["name" name "fields" (t/text-of (mut fields)) "news" (t/text-of (mut news)) "frees" (t/text-of (mut frees))
             "lookups" (t/text-of (mut out)) "params" params "storage" storage-of "reset" (t/text-of (mut reset))
             "seeds" (t/text-of (mut seeds)) "cursors" (t/text-of (mut cursors)) "drive" (t/text-of (mut drive))
             "index" (t/text-of (mut index)) "counts" (t/text-of (mut counts)) "prefixes" (t/text-of (mut prefixes))
             "places" (t/text-of (mut places))
             "close" (let [(mut close) (t/out-new)] (for _ rels (t/emit! (mut close) ")")) (t/emit! (mut close) ")") (t/text-of (mut close)))]))))
