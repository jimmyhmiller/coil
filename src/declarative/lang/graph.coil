;;; Graphs: a control-flow graph said once, as blocks that each hold a run of
;;; positions, with successors and predecessors. The language owns the storage
;;; (a record named NAME) and derives what passes ask of such a graph, in
;;; functions named after it in lower case (Flow: flow-block):
;;;
;;;   NAME-derive!(ctx)       the block of every position; clears reachability
;;;   NAME-dominators!(ctx)   immediate dominators (the graph's shape only)
;;;   NAME-block(ctx, p)      the block holding position p
;;;   NAME-dominates?(ctx, a, b)  a runs before b on every path to b
;;;   NAME-after!, NAME-before!   regions for `reach`: the positions reachable
;;;                           after the starts, or from which a start is
;;;                           reachable, without passing a stop position
;;;   NAME-after?(ctx, p), NAME-before?(ctx, p), NAME-reached(ctx)
;;;                           what the last such region marked
;;;
;;; Each direction has its own generation stamp, so a region's marks are its
;;; own: nothing is cleared between queries.
(module lang.graph)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "lang.text" :as t)
(import "lang.relation" :as relation)
(import "lang.region" :as region)
(import "lang.dominance" :as dominance)
(import "lang.template" :as template)

(defstruct Graph
  [(name (slice u8)) (params (slice u8)) (context (slice u8)) (context-type (slice u8)) (place (slice u8))
   (blocks (slice u8)) (points (slice u8)) (entry (slice u8)) (begin (slice u8)) (end (slice u8))
   (successor-count (slice u8)) (successor (slice u8)) (predecessors relation/Index)])

;;; The generated names start with the graph's name in lower case: Flow, flow-block.
(defn prefix [(g Graph)] (-> (slice u8)) (t/lower (.name g)))

(defn store [(g Graph) (part (slice u8))] (-> (slice u8))
  (t/cat4 "(." part " (field " (t/cat4 (.context g) " " (.place g) "))")))

(defn bind [(pairs (slice (slice u8)))] (-> (ArrayList relation/Column))
  (let [(mut out) (ArrayList::new [relation/Column] (malloc-allocator))]
    (for i (range 0 (/ (len pairs) 2))
      (push! (mut out) (relation/Column :target (get pairs (* i 2)) :value (get pairs (+ (* i 2) 1)))))
    out))

;;; Successors as a row query over `b`, for a region's neighbors.
(defn successors [(g Graph)] (-> relation/Index)
  (let [(mut q) (relation/empty "" "")]
    (push! (mut (.clauses q)) (relation/Clause :kind "from" :name "k*" :value (t/cat3 "(range 0 (cast i64 " (.successor-count g) "))")
                                                :second "" :next "" :end ""))
    (push! (mut (.clauses q)) (relation/Clause :kind "let" :name "k" :value "(cast u32 k*)" :second "" :next "" :end ""))
    (set! (.key q) (.successor g))
    q))

(defn regions [(g Graph)] (-> (ArrayList region/Region))
  (let [(mut out) (ArrayList::new [region/Region] (malloc-allocator))
        partition (t/cat3 "(get " (store g "block-of") " (cast i64 p))")]
    (push! (mut out) (region/Region :name (t/cat2 (prefix g) "-after!") :context (.context g) :type (.context-type g) :stop "stop"
      :forward true :advance true :starts (store g "starts") :partition partition :begin (.begin g) :end (.end g)
      :marks (store g "after") :entered (store g "after-entered") :generation (store g "after-stamp")
      :work (store g "work") :collect (store g "reached") :neighbors (successors g)))
    (push! (mut out) (region/Region :name (t/cat2 (prefix g) "-before!") :context (.context g) :type (.context-type g) :stop "stop"
      :forward false :advance true :starts (store g "starts") :partition partition :begin (.begin g) :end (.end g)
      :marks (store g "before") :entered (store g "before-entered") :generation (store g "before-stamp")
      :work (store g "work") :collect "" :neighbors (.predecessors g)))
    out))

(defn text [(g Graph)] (-> (slice u8))
  (let [(mut out) (t/out-new)
        values (bind ["name" (.name g) "fn" (prefix g) "params" (.params g) "ctx" (t/cat4 "[(" (.context g) " " (t/cat2 (.context-type g) ")"))
                      "storage" (t/cat4 "(field " (.context g) " " (t/cat2 (.place g) ")")) "blocks" (.blocks g) "points" (.points g)
                      "entry" (.entry g) "begin" (.begin g) "end" (.end g)
                      "block-of" (store g "block-of") "parents" (store g "parents")
                      "after" (store g "after") "before" (store g "before") "after-stamp" (store g "after-stamp")
                      "before-stamp" (store g "before-stamp") "after-entered" (store g "after-entered")
                      "before-entered" (store g "before-entered") "reached" (store g "reached")])]
    (t/line! (mut out) (template/text
"(defstruct @name@ [(block-of (ArrayList u32)) (ranks (ArrayList u32)) (parents (ArrayList u32)) (order (ArrayList u32))
  (work (ArrayList u32)) (starts (ArrayList u32)) (reached (ArrayList u32)) (after (ArrayList u32)) (before (ArrayList u32))
  (after-entered (ArrayList u32)) (before-entered (ArrayList u32)) (after-stamp u32) (before-stamp u32)])
(defn @name@-new [] (-> @name@)
  (@name@ :block-of (ArrayList::new [u32] (malloc-allocator)) :ranks (ArrayList::new [u32] (malloc-allocator))
    :parents (ArrayList::new [u32] (malloc-allocator)) :order (ArrayList::new [u32] (malloc-allocator))
    :work (ArrayList::new [u32] (malloc-allocator)) :starts (ArrayList::new [u32] (malloc-allocator))
    :reached (ArrayList::new [u32] (malloc-allocator)) :after (ArrayList::new [u32] (malloc-allocator))
    :before (ArrayList::new [u32] (malloc-allocator)) :after-entered (ArrayList::new [u32] (malloc-allocator))
    :before-entered (ArrayList::new [u32] (malloc-allocator)) :after-stamp (: 0 u32) :before-stamp (: 0 u32)))
(defn @name@-free! [(g* (ptr @name@))] (-> void)
  (free! (mut (.block-of g*))) (free! (mut (.ranks g*))) (free! (mut (.parents g*))) (free! (mut (.order g*)))
  (free! (mut (.work g*))) (free! (mut (.starts g*))) (free! (mut (.reached g*))) (free! (mut (.after g*)))
  (free! (mut (.before g*))) (free! (mut (.after-entered g*))) (free! (mut (.before-entered g*))))
(defn @fn@-derive! @ctx@] (-> void)
  (let [points* (cast i64 @points@) blocks* (cast i64 @blocks@)]
    (library-fill! (mut @block-of@) points* (: 0 u32))
    (for i* (range 0 blocks*)
      (let [b (cast u32 i*)] (for p* (range (cast i64 @begin@) (cast i64 @end@)) (set! (mut @block-of@) p* b))))
    (library-fill! (mut @after@) points* (: 0 u32)) (library-fill! (mut @before@) points* (: 0 u32))
    (library-fill! (mut @after-entered@) blocks* (: 0 u32)) (library-fill! (mut @before-entered@) blocks* (: 0 u32))
    (set! @after-stamp@ (: 0 u32)) (set! @before-stamp@ (: 0 u32))))
(defn @fn@-block :inline (Always) @ctx@ (p u32)] (-> u32) (get @block-of@ (cast i64 p)))
(defn @fn@-after? :inline (Always) @ctx@ (p u32)] (-> bool) (= (get @after@ (cast i64 p)) @after-stamp@))
(defn @fn@-before? :inline (Always) @ctx@ (p u32)] (-> bool) (= (get @before@ (cast i64 p)) @before-stamp@))
(defn @fn@-reached :inline (Always) @ctx@] (-> (slice u32)) (slice @reached@))
(defn @fn@-dominates? @ctx@ (a u32) (b u32)] (-> bool)
  (let [ba* (get @block-of@ (cast i64 a)) bb* (get @block-of@ (cast i64 b)) absent* (: 0xffffffff u32)]
    (cond (or (= (get @parents@ (cast i64 ba*)) absent*) (= (get @parents@ (cast i64 bb*)) absent*)) false
          (= ba* bb*) (< a b)
          :else (let [(mut n*) bb*]
                  (while (and (!= n* @entry@) (!= n* ba*)) (set! n* (get @parents@ (cast i64 n*))))
                  (= n* ba*)))))" values))
    (t/line! (mut out) (dominance/text (t/cat2 (prefix g) "-dominators!") (t/cat4 "[(" (.context g) " " (t/cat2 (.context-type g) ")]"))
      (bind ["nodes" (t/cat3 "(cast i64 " (.blocks g) ")") "entry" (.entry g) "absent" "(: 0xffffffff u32)"
             "ranks" (store g "ranks") "parents" (store g "parents") "order" (store g "order") "work" (store g "work")
             "successor-count" (.successor-count g) "successor" (.successor g)])
      (.predecessors g)))
    (for r (regions g) (t/line! (mut out) (region/text r)))
    (t/text-of (mut out))))
