;;; What an operation does to memory and to addresses, read off its meaning in
;;; a `.ops` file by abstract interpretation, so that no pass says it again.
;;;
;;; A value is a constant (numbers and immediates and arithmetic on them), an
;;; address (an operand plus a constant), or some other value; each also
;;; knows which operands it may be computed from. Per operand:
;;;
;;;   read / write   load, store, copy or fill at the operand plus a constant
;;;                  offset, of a constant number of bytes
;;;   derive         the meaning is the operand plus a constant: another address
;;;   value          any other use: the operand's value goes somewhere (escapes)
;;;   opaque         the operation has no meaning to read
;;;
;;; An operation clobbers when it may write memory its operands' effects do not
;;; name: one with no meaning whose role is a call, tail call or effect (unless
;;; said `memory reads`, `memory none` or `memory allocates`), or one that
;;; writes an extent that is not constant.
;;;
;;; Address provenance, for the frame: the result carries operand k when k may
;;; flow into it (arithmetic, bits, conversions, either arm of a select), but
;;; not through a truth value (a comparison, an overflow test) or a load. An
;;; operand is stored when its value goes into memory. An operation with no
;;; meaning carries every operand when its role is `value`, and otherwise lets
;;; every operand escape, unless said `memory reads`, `none` or `allocates`
;;; (its result is a new stack address); `role object` allocates too.
(module lang.effects)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "lang.text" :as t)

(const E-VALUE 0)
(const E-READ 1)
(const E-WRITE 2)
(const E-DERIVE 3)
(const E-OPAQUE 4)

(defstruct Effect [(kind i64) (offset (slice u8)) (bytes (slice u8))])

;;; An abstract value: kind 0 constant (text: its i64 expression), 1 address
;;; (operand k plus text), 2 anything else. `sum`: made by adding a constant.
;;; `carry`: the operands (bit k) it may be computed from.
(defstruct Abstract [(kind i64) (k i64) (text (slice u8)) (sum bool) (carry i64)])

;;; carries/stores: operand masks (-1: every operand, however many).
(defstruct Analysis
  [(operands (ArrayList (slice u8))) (imm (slice u8)) (imm2 (slice u8)) (aux (slice u8))
   (effects (ArrayList Effect)) (clobbers bool) (carries i64) (stores i64) (allocates bool)])

(defn other [(carry i64)] (-> Abstract) (Abstract :kind 2 :k -1 :text "" :sum false :carry carry))
(defn constant [(text (slice u8))] (-> Abstract) (Abstract :kind 0 :k -1 :text text :sum false :carry 0))

;;; The value goes somewhere this analysis does not follow.
(defn spend! [(a (mut Analysis)) (v Abstract)] (-> void)
  (when (= (.kind v) 1) (set! (mut (.effects a)) (.k v) (Effect :kind E-VALUE :offset "0" :bytes "0"))))

;;; An access of `bytes` at address `at`; a write of an extent not constant clobbers.
(defn access! [(a (mut Analysis)) (at Abstract) (bytes Abstract) (kind i64)] (-> void)
  (if (and (= (.kind at) 1) (= (.kind bytes) 0))
      (unless (= (.kind (get (.effects a) (.k at))) E-VALUE)
        (set! (mut (.effects a)) (.k at) (Effect :kind kind :offset (.text at) :bytes (.text bytes))))
      (do (spend! (mut a) at) (spend! (mut a) bytes)
          (when (= kind E-WRITE) (set! (.clobbers a) true)))))

;;; `v` is written to memory.
(defn put-in-memory! [(a (mut Analysis)) (v Abstract)] (-> void)
  (spend! (mut a) v)
  (set! (.stores a) (| (.stores a) (.carry v))))

(defn level [(op (slice u8))] (-> i64)
  (cond (= op "|") 1 (= op "^") 2 (= op "&") 3 (or (= op "==") (= op "!=")) 4
        (or (= op "<<") (= op ">>")) 5 (or (= op "+") (= op "-")) 6 (= op "*") 7 :else 0))

(defn binary! [(a (mut Analysis)) (op (slice u8)) (x Abstract) (y Abstract)] (-> Abstract)
  (let [carry (if (or (= op "==") (= op "!=")) 0 (| (.carry x) (.carry y)))]
    (cond
      (and (= op "+") (= (.kind x) 1) (= (.kind y) 0))
        (Abstract :kind 1 :k (.k x) :text (t/cat4 "(+ " (.text x) " " (t/cat2 (.text y) ")")) :sum true :carry carry)
      (and (= op "+") (= (.kind x) 0) (= (.kind y) 1))
        (Abstract :kind 1 :k (.k y) :text (t/cat4 "(+ " (.text x) " " (t/cat2 (.text y) ")")) :sum true :carry carry)
      (and (= (.kind x) 0) (= (.kind y) 0) (!= op "==") (!= op "!="))
        (constant (t/cat4 (t/cat3 "(" op " ") (.text x) " " (t/cat2 (.text y) ")")))
      :else (do (spend! (mut a) x) (spend! (mut a) y) (other carry)))))

;;; Functions whose value is a truth (0 or 1): no address flows through them.
(defn truth? [(name (slice u8))] (-> bool)
  (or (= name "slt") (= name "sle") (= name "ult") (= name "ule") (= name "feq") (= name "flt") (= name "fle")
      (= name "unordered") (t/ends-with name "-overflows")))

(defn call! [(c (mut t/Cur)) (a (mut Analysis)) (name (slice u8))] (-> Abstract)
  (let [(mut args) (ArrayList::new [Abstract] (malloc-allocator))]
    (unless (t/at? (mut c) ")")
      (push! (mut args) (expr! (mut c) (mut a) 0))
      (while (t/accept! (mut c) ",") (push! (mut args) (expr! (mut c) (mut a) 0))))
    (t/expect! (mut c) ")")
    (let [n (len args) (mut all) 0]
      (for v args (set! all (| all (.carry v))))
      (cond
        ; A type's width is no use of the operand's value.
        (= name "width") (other 0)
        (and (= name "load") (= n 3)) (do (access! (mut a) (get args 0) (get args 1) E-READ) (spend! (mut a) (get args 2)) (other 0))
        (and (= name "store") (= n 3)) (do (access! (mut a) (get args 0) (get args 2) E-WRITE) (put-in-memory! (mut a) (get args 1)) (other 0))
        (and (= name "copy") (= n 3)) (do (access! (mut a) (get args 0) (get args 2) E-WRITE) (access! (mut a) (get args 1) (get args 2) E-READ) (other 0))
        (and (= name "fill") (= n 3)) (do (access! (mut a) (get args 0) (get args 2) E-WRITE) (put-in-memory! (mut a) (get args 1)) (other 0))
        (and (= name "select") (= n 3))
          (do (for v args (spend! (mut a) v)) (other (| (.carry (get args 1)) (.carry (get args 2)))))
        (and (= name "cases") (>= n 1))
          (let [(mut arms) 0]
            (for i (range 1 n) (set! arms (| arms (.carry (get args i)))))
            (for v args (spend! (mut a) v))
            (other arms))
        :else (do (for v args (spend! (mut a) v)) (other (if (truth? name) 0 all)))))))

(defn primary! [(c (mut t/Cur)) (a (mut Analysis))] (-> Abstract)
  (let [tok (t/advance! (mut c)) word (.text tok)]
    (cond
      (= (.kind tok) t/T-NUM) (constant (t/int-text (cast i64 (.value tok))))
      (t/tok-is? tok "(") (let [v (expr! (mut c) (mut a) 0)] (t/expect! (mut c) ")") v)
      (or (t/tok-is? tok "-") (t/tok-is? tok "~"))
        (let [v (primary! (mut c) (mut a))]
          (if (= (.kind v) 0) (constant (t/cat3 (if (t/tok-is? tok "-") "(- 0 " "(^ -1 ") (.text v) ")")) (do (spend! (mut a) v) (other (.carry v)))))
      (and (= (.kind tok) t/T-IDENT) (t/at? (mut c) "(") (.glued (t/peek (mut c))))
        (do (t/advance! (mut c)) (call! (mut c) (mut a) word))
      (= word (.imm a)) (constant "imm")
      (= word (.imm2 a)) (constant "imm2")
      (= word (.aux a)) (constant "aux")
      :else (block :found
              (for k (range 0 (len (.operands a)))
                (when (= (get (.operands a) k) word)
                  (return-from :found (Abstract :kind 1 :k k :text "0" :sum false :carry (<< 1 k)))))
              (other 0)))))

(defn expr! [(c (mut t/Cur)) (a (mut Analysis)) (min i64)] (-> Abstract)
  (let [(mut left) (primary! (mut c) (mut a)) (mut going) true]
    (while going
      (let [tok (t/peek (mut c))
            l (if (and (= (.kind tok) t/T-PUNCT) (not (.first tok))) (level (.text tok)) 0)]
        (if (and (> l 0) (> l min))
            (do (t/advance! (mut c)) (set! left (binary! (mut a) (.text tok) left (expr! (mut c) (mut a) l))))
            (set! going false))))
    left))

;;; The effects of an operation whose meaning starts at the cursor (or that has
;;; none: `meaning` false), with its operands and immediates' names, role,
;;; whether it is variadic, and `memory` clause ("", "reads", "none" or "allocates").
(defn analyze [(c (mut t/Cur)) (meaning bool) (operands (ArrayList (slice u8))) (imm (slice u8)) (imm2 (slice u8))
               (aux (slice u8)) (role (slice u8)) (memory (slice u8)) (variadic bool)] (-> Analysis)
  (let [(mut a) (Analysis :operands operands :imm imm :imm2 imm2 :aux aux
                          :effects (ArrayList::new [Effect] (malloc-allocator)) :clobbers false
                          :carries 0 :stores 0 :allocates (or (= role "object") (= memory "allocates")))
        every (if variadic -1 (- (<< 1 (len operands)) 1))]
    (for _ operands (push! (mut (.effects a)) (Effect :kind (if meaning E-VALUE E-OPAQUE) :offset "0" :bytes "0")))
    (if meaning
        (do
          ; Operands start unused: an access or derivation names them, any other use spends them.
          (for k (range 0 (len operands)) (set! (mut (.effects a)) k (Effect :kind -1 :offset "0" :bytes "0")))
          (let [v (expr! (mut c) (mut a) 0)]
            (set! (.carries a) (.carry v))
            (if (and (= (.kind v) 1) (.sum v) (= (.kind (get (.effects a) (.k v))) -1))
                (set! (mut (.effects a)) (.k v) (Effect :kind E-DERIVE :offset (.text v) :bytes "0"))
                (spend! (mut a) v)))
          (for k (range 0 (len operands))
            (when (= (.kind (get (.effects a) k)) -1) (set! (mut (.effects a)) k (Effect :kind E-VALUE :offset "0" :bytes "0")))))
        (let [quiet (or (= memory "reads") (= memory "none") (= memory "allocates"))]
          (set! (.clobbers a) (and (or (= role "call") (= role "tailcall") (= role "effect")) (not quiet)))
          (cond (= role "value") (set! (.carries a) every)
                quiet 0
                :else (set! (.stores a) every))))
    a))
