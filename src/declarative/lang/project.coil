;;; What a language reads besides its own file: the manifest's [modules], and
;;; the files of the modules a file names.
(module lang.project)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "coil.fs" :as fs)
(import "coil.meta" :as meta)
(import "lang.text" :as t)

(defstruct Entry [(name (slice u8)) (file (slice u8))])

(defstruct Project [(entries (ArrayList Entry)) (path (slice u8))])

(defn dir-of [(path (slice u8))] (-> (slice u8))
  (let [(mut cut) -1]
    (for i (range 0 (len path)) (when (= (get path i) #\/) (set! cut i)))
    (if (< cut 0) "." (subslice path 0 cut))))

(defn read-file [(path (slice u8)) (from (slice u8))] (-> (slice u8))
  (match (fs/read-file (malloc-allocator) path)
    (Ok [bytes] (t/follow bytes path))
    (Err [_] (t/fail-at from 1 1 (t/cat2 "cannot read " path)))))

;;; The manifest that names the file at `path`: the nearest Coil.toml above it.
;;; That is this package's own even when another project is being built with
;;; this one as a dependency. `otherwise` is the manifest of the build.
(defn manifest-above [(path (slice u8)) (otherwise (slice u8))] (-> (slice u8))
  (let [(mut dir) (dir-of path)
        (mut found) ""]
    (while (and (= found "") (> (len dir) 1))
      (let [candidate (t/cat2 dir "/Coil.toml")]
        (match (fs/read-file (malloc-allocator) candidate)
          (Ok [_] (set! found candidate))
          (Err [_] (set! dir (dir-of dir))))))
    (if (= found "") otherwise found)))

;;; The modules the manifest of the file being read names, with absolute files.
(defn open [(context Code)] (-> Project)
  (let [path (t/path-of context)
        manifest (manifest-above path (meta/read-context-manifest context))
        base (dir-of manifest)
        text (read-file manifest path)
        (mut entries) (ArrayList::new [Entry] (malloc-allocator))
        (mut start) 0
        (mut in-modules) false]
    (for i (range 0 (+ (len text) 1))
      (when (or (= i (len text)) (= (get text i) #\newline))
        (let [line (subslice text start i)]
          (set! start (+ i 1))
          (cond
            (and (> (len line) 0) (= (get line 0) #\[)) (set! in-modules (= line "[modules]"))
            (and in-modules (> (len line) 0) (= (get line 0) #\"))
              (let [(mut quotes) (ArrayList::new [i64] (malloc-allocator))]
                (for j (range 0 (len line))
                  (when (= (get line j) #\") (push! (mut quotes) j)))
                (when (= (len quotes) 4)
                  (push! (mut entries)
                         (Entry
                           :name (subslice line (+ (get quotes 0) 1) (get quotes 1))
                           :file (t/cat3 base "/"
                                         (subslice line (+ (get quotes 2) 1) (get quotes 3)))))))
            :else 0))))
    (Project :entries entries :path path)))

;;; The file of a module the manifest names; a build error naming `at` if none.
(defn file-of [(p Project) (name (slice u8)) (line i64) (col i64)] (-> (slice u8))
  (let [(mut file) ""]
    (for e (.entries p) (when (= (.name e) name) (set! file (.file e))))
    (when (= file "")
      (t/fail-at (.path p) line col (t/cat2 "the manifest's [modules] names no module " name)))
    file))

;;; The module a file is, by the manifest.
(defn module-of [(p Project) (file (slice u8))] (-> (slice u8))
  (let [(mut name) ""]
    (for e (.entries p) (when (t/ends-with file (.file e)) (set! name (.name e))))
    (when (= name "")
      (for e (.entries p) (when (t/ends-with (.file e) file) (set! name (.name e)))))
    name))

;;; The unit the file being read belongs to: the one in its directory.
(defn unit-of [(p Project)] (-> (slice u8))
  (let [here (dir-of (.path p))
        (mut name) ""]
    (for e (.entries p)
      (when (and (t/ends-with (.file e) ".unit") (t/ends-with here (dir-of (.file e)))
                 (t/ends-with (dir-of (.file e)) (last-part here)))
        (set! name (.name e))))
    (when (= name "") (t/fail-at (.path p) 1 1 "no unit in this file's directory"))
    name))

(defn last-part [(path (slice u8))] (-> (slice u8))
  (let [(mut cut) -1]
    (for i (range 0 (len path)) (when (= (get path i) #\/) (set! cut i)))
    (subslice path (+ cut 1) (len path))))

;;; A module named in a file: `unit` is the unit of the file's directory, a
;;; dotted name is itself, and a short name is the module of that name in the
;;; file's directory (`cfg` is `a64.cfg` in a file of a64's).
(defn resolve [(p Project) (name (slice u8)) (line i64) (col i64)] (-> (slice u8))
  (let [(mut dotted) false]
    (for ch name (when (= ch #\.) (set! dotted true)))
    (cond
      (= name "unit") (unit-of p)
      dotted name
      :else
        (let [here (last-part (dir-of (.path p)))
              (mut found) ""]
          (for e (.entries p)
            (when (and (= (last-part (dir-of (.file e))) here) (t/ends-with (.name e) (t/cat2 "." name)))
              (set! found (.name e))))
          (when (= found "")
            (t/fail-at (.path p) line col (t/cat2 "no module in this directory named " name)))
          found))))
