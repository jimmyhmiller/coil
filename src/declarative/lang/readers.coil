;;; Each backend language is compiled to the forms of a Coil module.
(module lang.readers)
(import "coil.primitive" :as primitive)
(import "lang.text" :as t)
(import "lang.project" :as project)
(import "lang.ir" :as ir)
(import "lang.pass" :as pass)
(import "lang.library" :as library)
(import "lang.isa" :as isa)
(import "lang.lower" :as lower)
(import "lang.abi" :as abi)
(import "lang.rewrite" :as rewrite)
(import "lang.layout" :as layout)
(import "lang.pipeline" :as pipeline)
(import "lang.flow" :as flow)
(import "lang.ops" :as ops)
(import "lang.select" :as select)
(import "lang.instance" :as instance)

(reader-provider "lang.readers" read-any)

(defn read-any [(context Code)] (-> Code)
  (let [path (t/path-of context)]
    (if (t/ends-with path ".pipeline")
        (primitive/code-read (primitive/code-source (pipeline/compile-module (project/open context)
                                                                             path
                                                                             (t/source-of context)))
                             `(reader-config))
        (primitive/code-read (module-text context) `(reader-config)))))

(defn module-text [(context Code)] (-> (slice u8))
  (let [path (t/path-of context)
        src (t/source-of context)]
    (cond (t/ends-with path ".ir") (ir/module-text src path)
          (t/ends-with path ".unit") (pass/unit-text context)
          (t/ends-with path ".pass")
            (let [(mut c) (t/cursor src path)]
              (if (t/at? (mut c) "library")
                  (library/module-text context)
                  (pass/pass-text context)))
          (t/ends-with path ".isa") (isa/module-text src path)
          (t/ends-with path ".lower") (lower/module-text context)
          (t/ends-with path ".abi") (abi/module-text context)
          (t/ends-with path ".rewrite") (rewrite/module-text context)
          (t/ends-with path ".layout") (layout/module-text context)
          (t/ends-with path ".flow") (flow/module-text context)
          (t/ends-with path ".ops") (ops/module-text (t/source-of context) path)
          (t/ends-with path ".numbers") (ops/numbers-text src path)
          (t/ends-with path ".select") (select/module-text context)
          (t/ends-with path ".instance") (instance/module-text src path)
          :else
            (t/fail-at path 1 1 "no language reads a file with this extension"))))
