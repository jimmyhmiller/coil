;;; The `.rewrite` language: what a node may be replaced by.
;;;
;;;   rule add-zero : ADD(x, CONST 0)                  => x
;;;   rule sub-self : SUB(x, x)                        => 0
;;;   rule mul-pow2 : MUL(x, CONST k) when pow2(k)     => SHL(x, log2(k))
;;;   rule reassoc  : ADD(ADD(x, CONST a), CONST b)    => ADD(x, a + b)
;;;
;;; A pattern names nodes; a name used twice means the same node; `CONST k`
;;; binds a constant's value and `CONST 0` matches one. A commutative node whose
;;; operands differ in shape is tried both ways round. The right side is built
;;; with the node set's builders, so it is value-numbered as it is made.
;;;
;;; `rule if-true : IF(_, CONST 1) => always true` says a branch goes one way:
;;; the engine takes out the side that cannot run and everything only it reached.
;;;
;;; From the rules: `simplify`, one decision per root operation; folding of any
;;; node whose inputs are all constants, from the node's meaning; and `run`,
;;; which applies both to a fixed point over a worklist, keeps commutative
;;; operands in order, merges nodes that have become equal and removes what
;;; nothing uses.
(module lang.rewrite)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "lang.text" :as t)
(import "lang.ir" :as ir)
(import "lang.project" :as project)

;;; node: a node's name, or "". var: a variable, `_`, or `self`. literal: for
;;; `CONST 5`, that the payload must equal `value`. payload: the name bound to it.
(defstruct Pat
  [(node (slice u8)) (var (slice u8)) (payload (slice u8)) (literal bool) (value i64)
   (kids (ArrayList Pat)) (tok t/Tok)])

(defstruct Binding [(name (slice u8)) (code (slice u8)) (is-node bool)])

(defstruct R
  [(c t/Cur) (nodes ir/Spec) (bindings (ArrayList Binding)) (facts bool) (masking (slice u8))])

(defn parse-pattern [(r (mut R))] (-> Pat)
  (let [tok (t/peek (mut (.c r)))
        name (if (t/accept! (mut (.c r)) "_") "_" (t/name! (mut (.c r)) "a pattern"))
        (mut kids) (ArrayList::new [Pat] (malloc-allocator))]
    (if (!= (ir/node-number (.nodes r) name) 0)
        (let [(mut payload) ""
              (mut literal) false
              (mut value) 0]
          (cond
            (and (t/at? (mut (.c r)) "(") (.glued (t/peek (mut (.c r)))))
              (do (t/advance! (mut (.c r)))
                  (unless (t/at? (mut (.c r)) ")")
                    (push! (mut kids) (parse-pattern (mut r)))
                    (while (t/accept! (mut (.c r)) ",") (push! (mut kids) (parse-pattern (mut r)))))
                  (t/expect! (mut (.c r)) ")"))
            (and (t/at-num? (mut (.c r))) (not (t/at-line-start? (mut (.c r)))))
              (do (set! literal true)
                  (set! value (cast i64 (.value (t/advance! (mut (.c r)))))))
            (and (t/at? (mut (.c r)) "-") (= (.kind (t/peek-at (mut (.c r)) 1)) t/T-NUM))
              (do (t/advance! (mut (.c r)))
                  (set! literal true)
                  (set! value (- 0 (cast i64 (.value (t/advance! (mut (.c r))))))))
            (and (t/at-ident? (mut (.c r))) (not (t/at-line-start? (mut (.c r))))
                 (not (t/at? (mut (.c r)) "when")))
              (set! payload (t/name! (mut (.c r)) "a payload name"))
            :else 0)
          (Pat :node name :var "" :payload payload :literal literal :value value :kids kids :tok tok))
        (Pat :node "" :var name :payload "" :literal false :value 0 :kids kids :tok tok))))

(defn binding-of [(r (mut R)) (name (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for i (range 0 (len (.bindings r)))
      (when (= (.name (get (.bindings r) i)) name) (set! found i)))
    found))

;;; The tests a pattern makes of the node `at`, and the names it binds.
(defn match-text! [(r (mut R)) (p Pat) (at (slice u8)) (tests (mut t/Out)) (swap bool) (root bool)]
  (-> void)
  (cond
    (= (.var p) "_") 0
    (= (.var p) "self") (t/emit! (mut tests) (t/cat3 " (= " at " n)"))
    (= (.node p) "")
      (let [seen (binding-of (mut r) (.var p))]
        (if (>= seen 0)
            (t/emit! (mut tests) (t/cat4 " (= " at " " (t/cat2 (.code (get (.bindings r) seen)) ")")))
            (push! (mut (.bindings r)) (Binding :name (.var p) :code at :is-node true))))
    :else
      (do (unless root
            (t/emit! (mut tests) (t/cat4 " (= (graph/op (.g cx) " at ") ir/" (t/cat2 (.node p) ")"))))
          ; A node with any number of operands matches only with as many as the pattern has.
          (when (and (> (len (.kids p)) 0)
                     (ir/variadic? (get (.nodes (.nodes r)) (- (ir/node-number (.nodes r) (.node p)) 1))))
            (t/emit! (mut tests)
                     (t/cat4 " (= (graph/arity (.g cx) " at ") " (t/cat2 (t/int-text (len (.kids p))) ")"))))
          (when (.literal p)
            (t/emit! (mut tests) (t/cat4 " (= (payload-value (mut cx) " at ") " (t/cat2 (t/int-text (.value p)) ")"))))
          (when (!= (.payload p) "")
            (push! (mut (.bindings r))
                   (Binding :name (.payload p) :code (t/cat3 "(payload-value (mut cx) " at ")")
                            :is-node false)))
          (for i (range 0 (len (.kids p)))
            (let [slot (if (and swap (= (len (.kids p)) 2)) (- 1 i) i)]
              (match-text! (mut r) (get (.kids p) i)
                           (t/cat4 "(graph/input (.g cx) " at " " (t/cat2 (t/int-text slot) ")"))
                           (mut tests) false false))))))

;; ---------------------------------------------------------------- values

(defn value-level [(op (slice u8))] (-> i64)
  (cond (= op "or") 1
        (= op "and") 2
        (or (= op "==") (= op "!=") (= op "<") (= op "<=") (= op ">") (= op ">=")) 3
        (= op "|") 4
        (= op "^") 5
        (= op "&") 6
        (or (= op "<<") (= op ">>")) 7
        (or (= op "+") (= op "-")) 8
        (= op "*") 9
        :else 0))

;;; Arithmetic over constants' values, as signed 64-bit numbers.
(defn value-primary [(r (mut R))] (-> (slice u8))
  (let [tok (t/advance! (mut (.c r)))
        name (.text tok)
        call (and (t/at? (mut (.c r)) "(") (.glued (t/peek (mut (.c r)))))]
    (cond
      (= (.kind tok) t/T-NUM) (t/int-text (cast i64 (.value tok)))
      (t/tok-is? tok "(")
        (let [e (value-expr (mut r) 0)]
          (t/expect! (mut (.c r)) ")")
          e)
      (t/tok-is? tok "-") (t/cat3 "(primitive/isub 0 " (value-primary (mut r)) ")")
      (t/tok-is? tok "~") (t/cat3 "(^ " (value-primary (mut r)) " -1)")
      (t/tok-is? tok "not") (t/cat3 "(not " (value-primary (mut r)) ")")
      (!= (.kind tok) t/T-IDENT) (t/die (mut (.c r)) tok (t/cat2 "expected a value, found " name))
      call
        (do (t/advance! (mut (.c r)))
            (let [x (value-expr (mut r) 0)]
              (t/expect! (mut (.c r)) ")")
              (cond
                (= name "pow2") (t/cat3 "(bv/pow2? " x ")")
                (= name "log2") (t/cat3 "(bv/lowest (primitive/cast u64 " x "))")
                (= name "bits") (t/cat3 "(ir/type-bits (graph/ty (.g cx) (primitive/cast i32 " x ")))")
                (= name "uses") (t/cat3 "(graph/use-count (.g cx) (primitive/cast i32 " x "))")
                (= name "signed") (t/cat3 "(ir/type-signed? (graph/ty (.g cx) (primitive/cast i32 " x ")))")
                (= name "ones") (t/cat3 "(bv/ones " x ")")
                ; Anything else is a fact, if the file names where facts come from.
                (.facts r) (t/cat4 "(facts/" name " (mut cx) (primitive/cast i32 " (t/cat2 x "))"))
                :else (t/die (mut (.c r)) tok (t/cat2 "no function named " name)))))
      (= name "width") "(ir/type-bits (graph/ty (.g cx) n))"
      (>= (binding-of (mut r) name) 0)
        (let [b (get (.bindings r) (binding-of (mut r) name))]
          (if (.is-node b) (t/cat3 "(cast i64 " (.code b) ")") (.code b)))
      :else (t/die (mut (.c r)) tok (t/cat2 "no such name in this rule: " name)))))

(defn value-expr [(r (mut R)) (min i64)] (-> (slice u8))
  (let [(mut left) (value-primary (mut r))
        (mut going) true]
    (while going
      (let [tok (t/peek (mut (.c r)))
            level (if (.first tok) 0 (value-level (.text tok)))]
        (if (and (> level 0) (> level min))
            (do (t/advance! (mut (.c r)))
                (let [right (value-expr (mut r) level)
                      op (.text tok)]
                  (set! left
                        (cond (= op "==") (t/cat4 "(= " left " " (t/cat2 right ")"))
                              (= op "+") (t/cat4 "(primitive/iadd " left " " (t/cat2 right ")"))
                              (= op "-") (t/cat4 "(primitive/isub " left " " (t/cat2 right ")"))
                              (= op "*") (t/cat4 "(primitive/imul " left " " (t/cat2 right ")"))
                              (= op "<<") (t/cat4 "(bv/shl-signed " left " " (t/cat2 right ")"))
                              (= op ">>") (t/cat4 "(bv/sar-signed " left " " (t/cat2 right ")"))
                              :else (t/cat4 (t/cat3 "(" op " ") left " " (t/cat2 right ")"))))))
            (set! going false))))
    left))

;;; The right side: a node the pattern named, a node to build, or a constant.
;;; `type` is the Coil expression for the type a constant or a typed node
;;; built here takes.
(defn build-text [(r (mut R)) (type (slice u8))] (-> (slice u8))
  (if (t/accept! (mut (.c r)) "always")
      ; A branch that always goes one way: -1 for its true side, -2 for its false.
      (if (t/accept! (mut (.c r)) "true")
          "-1"
          (do (t/expect! (mut (.c r)) "false") "-2"))
      (build-node-text (mut r) type)))

(defn build-node-text [(r (mut R)) (type (slice u8))] (-> (slice u8))
  (let [tok (t/peek (mut (.c r)))
        name (.text tok)
        next (t/peek-at (mut (.c r)) 1)
        number (if (= (.kind tok) t/T-IDENT) (ir/node-number (.nodes r) name) 0)]
    (cond
      ; A node to build, with the node set's builder.
      (and (!= number 0) (t/tok-is? next "(") (.glued next))
        (let [node (get (.nodes (.nodes r)) (- number 1))
              typed (and (!= (.result node) "") (= (ir/type-number (.nodes r) (.result node)) 0))
              (mut args) (ArrayList::new [(slice u8)] (malloc-allocator))
              (mut o) (t/out-new)]
          (t/advance! (mut (.c r)))
          (t/advance! (mut (.c r)))
          (when (ir/variadic? node)
            (t/die (mut (.c r)) tok "a rule cannot build a node with a variable number of operands"))
          ; An untyped node's operands take their type from the first operand
          ; that is a node the pattern named.
          (let [start (.pos (.c r))
                (mut inner) type]
            (unless typed
              (let [first (t/peek (mut (.c r)))
                    index (binding-of (mut r) (.text first))]
                (when (and (>= index 0) (.is-node (get (.bindings r) index)))
                  (set! inner (t/cat3 "(graph/ty (.g cx) " (.code (get (.bindings r) index)) ")")))))
            (set! (.pos (.c r)) start)
            (unless (t/at? (mut (.c r)) ")")
              (push! (mut args) (build-node-text (mut r) inner))
              (while (t/accept! (mut (.c r)) ",") (push! (mut args) (build-node-text (mut r) inner)))))
          (t/expect! (mut (.c r)) ")")
          (when (!= (len args) (ir/fixed-count node))
            (t/die (mut (.c r)) tok (t/cat4 name " takes " (t/int-text (ir/fixed-count node)) " operands")))
          (t/emit! (mut o) (t/cat3 "(ir/" (ir/builder-name name) " (mut (.g cx))"))
          (when typed (t/emit! (mut o) (t/cat2 " " type)))
          (for arg args (t/emit! (mut o) (t/cat2 " " arg)))
          (t/emit! (mut o) ")")
          (t/text-of (mut o)))
      ; A node the pattern named.
      (and (= (.kind tok) t/T-IDENT) (>= (binding-of (mut r) name) 0)
           (.is-node (get (.bindings r) (binding-of (mut r) name))))
        (do (t/advance! (mut (.c r)))
            (.code (get (.bindings r) (binding-of (mut r) name))))
      ; Otherwise a constant, of the type this place has.
      :else (t/cat4 "(make-const (mut cx) " type " " (t/cat2 (value-expr (mut r) 0) ")")))))

;; ---------------------------------------------------------------- checking the rules

;;; Whether a pattern can be built as a value of parameters and constants: no
;;; `self`, and only nodes that are values of their inputs.
(defn checkable? [(r (mut R)) (p Pat)] (-> bool)
  (cond (= (.var p) "self") false
        (= (.node p) "") true
        :else
          (let [node (get (.nodes (.nodes r)) (- (ir/node-number (.nodes r) (.node p)) 1))
                (mut ok) (and (ir/pure? node) (not (ir/variadic? node)) (!= (.role node) "param"))]
            (for kid (.kids p) (unless (checkable? (mut r) kid) (set! ok false)))
            ok)))

;;; Coil that builds a pattern: each variable a parameter, each constant one of
;;; a few telling values, each type the trial's main type or, now and then,
;;; another. `vars` gathers the variables' names, whose parameters are bound
;;; around the whole.
(defn instance-text [(r (mut R)) (p Pat) (vars (mut (ArrayList (slice u8))))] (-> (slice u8))
  (cond
    (= (.var p) "_")
      (do (push! (mut vars) "_")
          (t/cat2 "v*" (t/int-text (- (len vars) 1))))
    (= (.node p) "")
      (do (when (< (t/index-of vars (.var p)) 0) (push! (mut vars) (.var p)))
          (t/cat2 "v*" (t/int-text (t/index-of vars (.var p)))))
    :else
      (let [node (get (.nodes (.nodes r)) (- (ir/node-number (.nodes r) (.node p)) 1))
            typed (and (!= (.result node) "") (= (ir/type-number (.nodes r) (.result node)) 0))
            (mut o) (t/out-new)]
        (if (= (.role node) "const")
            (t/cat3 "(let [t* (deviate! (mut rnd) main)] (ir/make-const! (mut (.g cx)) t* (bv/cut "
                    (if (.literal p)
                        (t/cat3 "(primitive/cast u64 " (t/int-text (.value p)) ")")
                        "(interesting! (mut rnd))")
                    " (ir/type-bits t*))))")
            (do (t/emit! (mut o) (t/cat3 "(ir/" (ir/builder-name (.node p)) " (mut (.g cx))"))
                (when typed (t/emit! (mut o) " (deviate! (mut rnd) main)"))
                (for kid (.kids p) (t/emit! (mut o) (t/cat2 " " (instance-text (mut r) kid (mut vars)))))
                (t/emit! (mut o) ")")
                (t/text-of (mut o)))))))

;;; `(defn instance-K …)`: rule K's pattern as a graph, or 0 if it cannot be checked.
(defn instance-defn [(r (mut R)) (rule i64) (p Pat)] (-> (slice u8))
  (let [(mut vars) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut o) (t/out-new)]
    (t/line! (mut o) (t/cat3 "(defn instance-" (t/int-text rule)
                             " [(cx (mut st/State)) (rnd (mut Rnd)) (main i32)] (-> i32)"))
    (if (not (checkable? (mut r) p))
        (t/line! (mut o) "  0)")
        (let [body (instance-text (mut r) p (mut vars))]
          (t/emit! (mut o) "  (let [")
          (for i (range 0 (len vars))
            (t/emit! (mut o)
                     (t/cat4 "v*" (t/int-text i) " (narrowed! (mut cx) (mut rnd) (ir/make-param! (mut (.g cx)) (deviate! (mut rnd) main) "
                             (t/cat2 (t/int-text i) ")) "))))
          (t/line! (mut o) (t/cat3 "] " body "))"))))
    (t/text-of (mut o))))

;;; The checker, the same for every rule set but for the dispatch to instances.
(defn emit-checker! [(o (mut t/Out)) (rules i64) (facts bool) (masking (slice u8))] (-> void)
  (t/line! (mut o) "(defstruct Rnd [(state u64)])")
  (t/line! (mut o) "(defn roll! [(rnd (mut Rnd))] (-> u64)")
  (t/line! (mut o) "  (let [(mut x) (.state rnd)]")
  (t/line! (mut o) "    (set! x (^ x (<< x 13))) (set! x (^ x (>> x 7))) (set! x (^ x (<< x 17)))")
  (t/line! (mut o) "    (set! (.state rnd) x)")
  (t/line! (mut o) "    x))")
  (t/line! (mut o) "(defn value-type! [(rnd (mut Rnd))] (-> i32)")
  (t/line! (mut o) "  (let [(mut type) (: 0 i32)]")
  (t/line! (mut o) "    (while (not (ir/value-type? type))")
  (t/line! (mut o) "      (set! type (cast i32 (+ 1 (cast i64 (% (roll! (mut rnd)) (cast u64 ir/TYPES)))))))")
  (t/line! (mut o) "    type))")
  (t/line! (mut o) ";;; The trial's main type, or one time in three some other.")
  (t/line! (mut o) "(defn deviate! [(rnd (mut Rnd)) (main i32)] (-> i32)")
  (t/line! (mut o) "  (if (= (% (roll! (mut rnd)) 3) 0) (value-type! (mut rnd)) main))")
  (t/line! (mut o) ";;; Values that find mistakes: zero, one, the edges of every width, and noise.")
  (t/line! (mut o) "(defn interesting! [(rnd (mut Rnd))] (-> u64)")
  (t/line! (mut o) "  (let [k (% (roll! (mut rnd)) 16)]")
  (t/line! (mut o) "    (cond (= k 0) (: 0 u64) (= k 1) (: 1 u64) (= k 2) (: 0xFFFFFFFFFFFFFFFF u64)")
  (t/line! (mut o) "          (= k 3) (: 2 u64) (= k 4) (: 0x7F u64) (= k 5) (: 0x80 u64) (= k 6) (: 0xFF u64)")
  (t/line! (mut o) "          (= k 7) (: 0x7FFF u64) (= k 8) (: 0x8000 u64) (= k 9) (: 0x7FFFFFFF u64)")
  (t/line! (mut o) "          (= k 10) (: 0x80000000 u64) (= k 11) (: 0x8000000000000000 u64)")
  (t/line! (mut o) "          (= k 12) (<< (: 1 u64) (% (roll! (mut rnd)) 64))")
  (t/line! (mut o) "          (= k 13) (% (roll! (mut rnd)) 64)")
  (t/line! (mut o) "          :else (roll! (mut rnd)))))")
  (t/line! (mut o) ";;; A parameter, or one time in three its low few bits, so that rules which ask")
  (t/line! (mut o) ";;; what is known of a value meet values of which something is known.")
  (t/line! (mut o) "(defn narrowed! [(cx (mut st/State)) (rnd (mut Rnd)) (p i32)] (-> i32)")
  (if (= masking "")
      (t/line! (mut o) "  p)")
      (do
        (t/line! (mut o) "  (let [type (graph/ty (.g cx) p)]")
        (t/line! (mut o) "    (if (and (= (% (roll! (mut rnd)) 3) 0) (> (ir/type-bits type) 1) (not (ir/type-float? type)))")
        (t/line! (mut o) (t/cat3 "        (ir/" (ir/builder-name masking) " (mut (.g cx)) type p"))
        (t/line! (mut o) "                 (ir/make-const! (mut (.g cx)) type")
        (t/line! (mut o) "                            (bv/mask (cast i64 (% (roll! (mut rnd)) (cast u64 (ir/type-bits type)))))))")
        (t/line! (mut o) "        p)))")))
  (t/line! (mut o) "(defn instance [(cx (mut st/State)) (rnd (mut Rnd)) (rule i64) (main i32)] (-> i32)")
  (t/line! (mut o) "  (match rule")
  (for k (range 1 (+ rules 1))
    (t/line! (mut o) (t/cat4 "    (" (t/int-text k) " (instance-" (t/cat2 (t/int-text k) " (mut cx) (mut rnd) main))"))))
  (t/line! (mut o) "    (_ 0)))")
  (t/line! (mut o) ";;; Every rule against the nodes' meanings: its pattern is built over")
  (t/line! (mut o) ";;; parameters with `tries` choices of types and constants, and wherever a")
  (t/line! (mut o) ";;; rule applies, the node and its replacement must have one type and one")
  (t/line! (mut o) ";;; value for 64 choices of the parameters. Prints what is wrong and returns")
  (t/line! (mut o) ";;; how many rules are wrong or were never seen to apply.")
  (t/line! (mut o) "(defn check-rules [(cx (mut st/State)) (tries i64)] (-> i64)")
  (t/line! (mut o) "  (let [(mut rnd) (Rnd :state (: 0x9E3779B97F4A7C15 u64))")
  (t/line! (mut o) "        (mut applied) (ArrayList::new [i64] (.alc cx))")
  (t/line! (mut o) "        (mut wrong) (ArrayList::new [bool] (.alc cx))")
  (t/line! (mut o) "        (mut args) (ArrayList::new [u64] (.alc cx))")
  (t/line! (mut o) "        (mut bad) 0]")
  (t/line! (mut o) "    (for _ (range 0 (+ RULES 1)) (push! (mut applied) 0) (push! (mut wrong) false))")
  (t/line! (mut o) "    (for _ (range 0 8) (push! (mut args) 0))")
  (t/line! (mut o) "    (for rule (range 1 (+ RULES 1))")
  (t/line! (mut o) "      (let [(mut checkable) true]")
  (t/line! (mut o) "        (for _ (range 0 tries)")
  (t/line! (mut o) "          (when checkable")
  (t/line! (mut o) "            (graph/release! (mut (.g cx)))")
  (t/line! (mut o) "            (set! (.g cx) (graph/create (.alc cx)))")
  (t/line! (mut o) "            (let [main (value-type! (mut rnd))")
  (t/line! (mut o) "                  root (instance (mut cx) (mut rnd) rule main)]")
  (t/line! (mut o) "              (if (= root 0)")
  (t/line! (mut o) "                  (set! checkable false)")
  (t/line! (mut o) "                  (when (= (ir/verify (.g cx)) \"\")")
  (t/line! (mut o) (if facts "                    (do (st/begin! (mut cx)) (facts/solve (mut cx)))" "                    (st/begin! (mut cx))"))
  (t/line! (mut o) "                    (set! (.fired cx) 0)")
  (t/line! (mut o) "                    (let [new (simplify (mut cx) root)")
  (t/line! (mut o) "                          fired (.fired cx)]")
  (t/line! (mut o) "                      (when (and (!= new 0) (> fired 0) (not (get wrong fired)))")
  (t/line! (mut o) "                        (set! (mut applied) fired (+ (get applied fired) 1))")
  (t/line! (mut o) "                        (cond")
  (t/line! (mut o) "                          (!= (graph/ty (.g cx) new) (graph/ty (.g cx) root))")
  (t/line! (mut o) "                            (do (println \"  WRONG {}: a {} becomes a {}\" (rule-name fired)")
  (t/line! (mut o) "                                         (ir/type-name (graph/ty (.g cx) root))")
  (t/line! (mut o) "                                         (ir/type-name (graph/ty (.g cx) new)))")
  (t/line! (mut o) "                                (set! (mut wrong) fired true))")
  (t/line! (mut o) "                          (!= (ir/verify (.g cx)) \"\")")
  (t/line! (mut o) "                            (do (println \"  WRONG {}: it builds a node that is not well formed: {}\"")
  (t/line! (mut o) "                                         (rule-name fired) (ir/verify (.g cx)))")
  (t/line! (mut o) "                                (set! (mut wrong) fired true))")
  (t/line! (mut o) "                          :else")
  (t/line! (mut o) "                            (for _ (range 0 64)")
  (t/line! (mut o) "                              (unless (get wrong fired)")
  (t/line! (mut o) "                                (for i (range 0 8) (set! (mut args) i (interesting! (mut rnd))))")
  (t/line! (mut o) "                                (let [before (ir/eval-node (.g cx) (slice args) root)")
  (t/line! (mut o) "                                      after (ir/eval-node (.g cx) (slice args) new)]")
  (t/line! (mut o) "                                  (when (!= before after)")
  (t/line! (mut o) "                                    (println \"  WRONG {}: on a {} with parameters {:x} {:x} {:x}, {:x} became {:x}\"")
  (t/line! (mut o) "                                             (rule-name fired) (ir/type-name (graph/ty (.g cx) root))")
  (t/line! (mut o) "                                             (get args 0) (get args 1) (get args 2) before after)")
  (t/line! (mut o) "                                    (set! (mut wrong) fired true)))))))))))))")
  (t/line! (mut o) "        (unless checkable")
  (t/line! (mut o) "          (println \"  not checked, its pattern is not a value of its inputs alone: {}\" (rule-name rule))")
  (t/line! (mut o) "          (set! (mut applied) rule -1))))")
  (t/line! (mut o) "    (for rule (range 1 (+ RULES 1))")
  (t/line! (mut o) "      (when (get wrong rule) (set! bad (+ bad 1)))")
  (t/line! (mut o) "      (when (= (get applied rule) 0)")
  (t/line! (mut o) "        (println \"  never seen to apply: {}\" (rule-name rule))")
  (t/line! (mut o) "        (set! bad (+ bad 1))))")
  (t/line! (mut o) "    bad))"))

;; ---------------------------------------------------------------- the module

(defn module-name! [(c (mut t/Cur))] (-> (slice u8))
  (let [(mut name) (t/name! (mut c) "a module name")]
    (while (and (t/at? (mut c) ".") (.glued (t/peek (mut c))))
      (t/advance! (mut c))
      (set! name (t/cat3 name "." (t/name! (mut c) "a module name"))))
    name))

(defn module-text [(context Code)] (-> (slice u8))
  (let [p (project/open context)
        path (t/path-of context)
        (mut c) (t/cursor (t/source-of context) path)]
    (t/expect! (mut c) "rewrite")
    (t/expect! (mut c) "in")
    (let [unit (project/resolve p (module-name! (mut c)) 1 1)
          at (t/peek-at (mut c) 1)
          nodes-module (do (t/expect! (mut c) "nodes") (module-name! (mut c)))
          nodes-file (project/file-of p nodes-module (.line at) (.col at))
          facts-module (if (t/accept! (mut c) "facts") (project/resolve p (module-name! (mut c)) (.line at) (.col at)) "")
          ; `masking AND`: the node that keeps the bits two values share, which
          ; the rule checker uses to make values of which something is known.
          masking (if (t/accept! (mut c) "masking") (t/name! (mut c) "a node name") "")
          (mut r) (R
                    :c c
                    :nodes (ir/parse (project/read-file nodes-file path) nodes-file)
                    :bindings (ArrayList::new [Binding] (malloc-allocator))
                    :facts (!= facts-module "")
                    :masking masking)
          (mut groups) (ArrayList::new [(slice u8)] (malloc-allocator))
          (mut texts) (ArrayList::new [(slice u8)] (malloc-allocator))
          (mut names) (t/out-new)
          (mut instances) (t/out-new)
          (mut o) (t/out-new)
          (mut rule) 0]
      (t/emit! (mut names) "(def RULE-NAMES [\"folding\"")
      (while (not (t/eof? (mut (.c r))))
        (let [tok (t/advance! (mut (.c r)))]
          (unless (t/tok-is? tok "rule")
            (t/die (mut (.c r)) tok (t/cat2 "expected rule, found " (.text tok))))
          (let [name (t/name! (mut (.c r)) "a rule name")]
            (t/expect! (mut (.c r)) ":")
            (let [pattern (parse-pattern (mut r))
                  commutative (and (!= (.node pattern) "")
                                   (= (len (.kids pattern)) 2)
                                   (.commutative (get (.nodes (.nodes r))
                                                      (- (ir/node-number (.nodes r) (.node pattern)) 1)))
                                   (!= (.node (get (.kids pattern) 0)) "")
                                   (= (.node (get (.kids pattern) 1)) ""))
                  start (.pos (.c r))
                  (mut group) -1]
              (when (= (.node pattern) "")
                (t/die (mut (.c r)) tok "a rule's pattern starts at a node"))
              (set! group (t/index-of groups (.node pattern)))
              (when (< group 0)
                (push! (mut groups) (.node pattern))
                (push! (mut texts) "")
                (set! group (- (len groups) 1)))
              (set! rule (+ rule 1))
              (t/emit! (mut names) (t/cat3 " \"" name "\""))
              (t/emit! (mut instances) (instance-defn (mut r) rule pattern))
              (for way (range 0 (if commutative 2 1))
                (set! (.pos (.c r)) start)
                (clear! (mut (.bindings r)))
                (let [(mut tests) (t/out-new)]
                  (match-text! (mut r) pattern "n" (mut tests) (= way 1) true)
                  (when (t/accept! (mut (.c r)) "when")
                    (t/emit! (mut tests) (t/cat2 " " (value-expr (mut r) 0))))
                  (t/expect! (mut (.c r)) "=>")
                  (let [built (build-text (mut r) "(graph/ty (.g cx) n)")]
                    (set! (mut texts) group
                          (t/cat4 (get texts group) "        (and true" (t/text-of (mut tests))
                                  (t/cat4 ") (do (set! (.fired cx) " (t/int-text rule) ") "
                                          (t/cat2 built ")\n")))))))))))
      (t/line! (mut names) "])")
      (t/line! (mut o) (t/cat3 "(depends-on \"" nodes-file "\")"))
      (t/line! (mut o) "(import \"coil.primitive\" :as primitive)")
      (t/line! (mut o) "(import \"coil.arraylist\" :use [ArrayList])")
      (t/line! (mut o) "(import \"declarative.rt.graph\" :as graph)")
      (t/line! (mut o) "(import \"declarative.rt.bits\" :as bv)")
      (t/line! (mut o) (t/cat3 "(import \"" unit "\" :as st)"))
      (t/line! (mut o) (t/cat3 "(import \"" nodes-module "\" :as ir)"))
      (when (.facts r) (t/line! (mut o) (t/cat3 "(import \"" facts-module "\" :as facts)")))
      (t/emit! (mut o) (t/text-of (mut names)))
      (t/line! (mut o) (t/cat3 "(const RULES " (t/int-text rule) ")"))
      (t/line! (mut o) "(defn rule-name [(rule i64)] (-> (slice u8)) (get RULE-NAMES rule))")
      (t/line! (mut o) "(defn payload-value [(cx (mut st/State)) (n i32)] (-> i64)")
      (t/line! (mut o) "  (if (ir/type-signed? (graph/ty (.g cx) n))")
      (t/line! (mut o) "      (bv/signed (graph/payload (.g cx) n) (ir/type-bits (graph/ty (.g cx) n)))")
      (t/line! (mut o) "      (primitive/cast i64 (graph/payload (.g cx) n))))")
      (t/line! (mut o) "(defn make-const [(cx (mut st/State)) (type i32) (v i64)] (-> i32)")
      (t/line! (mut o) "  (ir/make-const! (mut (.g cx)) type (bv/cut (primitive/cast u64 v) (ir/type-bits type))))")
      (t/line! (mut o) ";;; What `n` may be replaced by, or 0. `(.fired cx)` is the rule that said so.")
      (t/line! (mut o) "(defn simplify [(cx (mut st/State)) (n i32)] (-> i32)")
      (t/line! (mut o) "  (match (graph/op (.g cx) n)")
      (for i (range 0 (len groups))
        (t/line! (mut o) (t/cat3 "    (" (t/int-text (ir/node-number (.nodes r) (get groups i))) " (cond"))
        (t/emit! (mut o) (get texts i))
        (t/line! (mut o) "        :else 0))"))
      (t/line! (mut o) "    (_ 0)))")
      (emit-engine! (mut o) (.nodes r))
      (t/emit! (mut o) (t/text-of (mut instances)))
      (emit-checker! (mut o) rule (.facts r) (.masking r))
      (t/text-of (mut o)))))

;;; Whether the node set has phis and regions: ways that meet.
(defn joins? [(spec ir/Spec)] (-> bool)
  (let [(mut phi) false
        (mut region) false]
    (for node (.nodes spec)
      (when (= (.role node) "phi") (set! phi true))
      (when (= (.role node) "region") (set! region true)))
    (and phi region)))

(defn const-name [(spec ir/Spec)] (-> (slice u8))
  (let [(mut name) ""]
    (for node (.nodes spec) (when (= (.role node) "const") (set! name (.name node))))
    name))

;;; Folding and the worklist: the same for every rule set.
(defn emit-engine! [(o (mut t/Out)) (spec ir/Spec)] (-> void)
  (let [k (const-name spec)]
    (t/line! (mut o) ";;; A node whose inputs are all constants is the constant its meaning gives.")
    (t/line! (mut o) "(defn fold [(cx (mut st/State)) (n i32)] (-> i32)")
    (t/line! (mut o) "  (let [operation (graph/op (.g cx) n)")
    (t/line! (mut o) "        count (graph/arity (.g cx) n)]")
    (t/line! (mut o) "    (if (or (not (ir/foldable? operation)) (= count 0) (> count 3))")
    (t/line! (mut o) "        0")
    (t/line! (mut o) "        (let [a (graph/input (.g cx) n 0)")
    (t/line! (mut o) "              b (if (> count 1) (graph/input (.g cx) n 1) a)")
    (t/line! (mut o) "              c (if (> count 2) (graph/input (.g cx) n 2) a)]")
    (t/line! (mut o) (t/cat3 "          (if (and (= (graph/op (.g cx) a) ir/" k ")"))
    (t/line! (mut o) (t/cat3 "                   (= (graph/op (.g cx) b) ir/" k ")"))
    (t/line! (mut o) (t/cat3 "                   (= (graph/op (.g cx) c) ir/" k "))"))
    (t/line! (mut o) "              (do (set! (.fired cx) 0)")
    (t/line! (mut o) "                  (ir/make-const! (mut (.g cx)) (graph/ty (.g cx) n)")
    (t/line! (mut o) "                             (ir/eval operation (ir/type-bits (graph/ty (.g cx) n))")
    (t/line! (mut o) "                                      (ir/type-bits (graph/ty (.g cx) a))")
    (t/line! (mut o) "                                      (graph/payload (.g cx) a) (graph/payload (.g cx) b)")
    (t/line! (mut o) "                                      (graph/payload (.g cx) c))))")
    (t/line! (mut o) "              0)))))")
    (if (joins? spec)
        (do
          (t/line! (mut o) ";;; A node over a phi, its other operands constants, is a phi of what the node")
          (t/line! (mut o) ";;; is for each of the phi's values: a constant where the value is one, and")
          (t/line! (mut o) ";;; the node over the value where it is not. Done when every value is a")
          (t/line! (mut o) ";;; constant, or when some are and nothing else reads the phi, so that the node")
          (t/line! (mut o) ";;; is not computed more often than it was.")
          (t/line! (mut o) "(defn fold-phi [(cx (mut st/State)) (n i32)] (-> i32)")
          (t/line! (mut o) "  (let [operation (graph/op (.g cx) n)")
          (t/line! (mut o) "        count (graph/arity (.g cx) n)")
          (t/line! (mut o) "        (mut phi) (: 0 i32)")
          (t/line! (mut o) "        (mut at) -1")
          (t/line! (mut o) "        (mut ok) (and (ir/foldable? operation) (> count 0) (<= count 3))]")
          (t/line! (mut o) "    (when ok")
          (t/line! (mut o) "      (for i (range 0 count)")
          (t/line! (mut o) "        (let [d (graph/input (.g cx) n i)")
          (t/line! (mut o) "              role (ir/role (graph/op (.g cx) d))]")
          (t/line! (mut o) "          (cond (= role 10) 0")
          (t/line! (mut o) "                (and (= role 8) (= phi 0)) (do (set! phi d) (set! at i) 0)")
          (t/line! (mut o) "                :else (do (set! ok false) 0)))))")
          (t/line! (mut o) "    (when (and ok (!= phi 0))")
          (t/line! (mut o) "      (when (< (graph/arity (.g cx) phi) 3) (set! ok false))")
          (t/line! (mut o) "      (let [(mut known) 0]")
          (t/line! (mut o) "        (for i (range 1 (graph/arity (.g cx) phi))")
          (t/line! (mut o) "          (when (= (ir/role (graph/op (.g cx) (graph/input (.g cx) phi i))) 10) (set! known (+ known 1))))")
          (t/line! (mut o) "        (when (or (= known 0)")
          (t/line! (mut o) "                  (and (< known (- (graph/arity (.g cx) phi) 1)) (!= (graph/use-count (.g cx) phi) 1)))")
          (t/line! (mut o) "          (set! ok false))))")
          (t/line! (mut o) "    (if (or (not ok) (= phi 0))")
          (t/line! (mut o) "        0")
          (t/line! (mut o) "        (let [ways (- (graph/arity (.g cx) phi) 1)")
          (t/line! (mut o) "              out (ir/make-phi! (mut (.g cx)) (graph/ty (.g cx) n) (graph/input (.g cx) phi 0) ways)")
          (t/line! (mut o) "              bits (ir/type-bits (graph/ty (.g cx) (graph/input (.g cx) n 0)))]")
          (t/line! (mut o) "          (for i (range 1 (+ ways 1))")
          (t/line! (mut o) "            (let [value (graph/input (.g cx) phi i)")
          (t/line! (mut o) "                  k (graph/payload (.g cx) value)")
          (t/line! (mut o) "                  a (if (= at 0) k (graph/payload (.g cx) (graph/input (.g cx) n 0)))")
          (t/line! (mut o) "                  b (cond (< count 2) a (= at 1) k :else (graph/payload (.g cx) (graph/input (.g cx) n 1)))")
          (t/line! (mut o) "                  c (cond (< count 3) a (= at 2) k :else (graph/payload (.g cx) (graph/input (.g cx) n 2)))]")
          (t/line! (mut o) "              (graph/set-input! (mut (.g cx)) out i")
          (t/line! (mut o) "                                (if (= (ir/role (graph/op (.g cx) value)) 10)")
          (t/line! (mut o) "                                    (ir/make-const! (mut (.g cx)) (graph/ty (.g cx) n)")
          (t/line! (mut o) "                                                    (ir/eval operation (ir/type-bits (graph/ty (.g cx) n)) bits a b c))")
          (t/line! (mut o) "                                    ; The node itself, over this value in the phi's place.")
          (t/line! (mut o) "                                    (graph/intern! (mut (.g cx)) operation (graph/ty (.g cx) n) (graph/payload (.g cx) n) count")
          (t/line! (mut o) "                                                   (if (= at 0) value (graph/input (.g cx) n 0))")
          (t/line! (mut o) "                                                   (cond (< count 2) 0 (= at 1) value :else (graph/input (.g cx) n 1))")
          (t/line! (mut o) "                                                   (cond (< count 3) 0 (= at 2) value :else (graph/input (.g cx) n 2)))))))")
          (t/line! (mut o) "          (set! (.fired cx) 0)")
          (t/line! (mut o) "          out))))")
          0)
        (do
          (t/line! (mut o) ";;; This node set has no phis for a node to be over.")
          (t/line! (mut o) "(defn fold-phi [(cx (mut st/State)) (n i32)] (-> i32) 0)")
          0))
    (t/line! (mut o) "(defn enqueue! [(work (mut (ArrayList i32))) (queued (mut (ArrayList bool))) (n i32)] (-> void)")
    (t/line! (mut o) "  (while (<= (len queued) (cast i64 n)) (push! (mut queued) false))")
    (t/line! (mut o) "  (unless (get queued (cast i64 n))")
    (t/line! (mut o) "    (set! (mut queued) (cast i64 n) true)")
    (t/line! (mut o) "    (push! (mut work) n)))")
    (t/line! (mut o) ";;; Every use of `old` becomes a use of `new`; the users are looked at again,")
    (t/line! (mut o) ";;; and `old` goes, with whatever only it was using.")
    (t/line! (mut o) "(defn replace! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))")
    (t/line! (mut o) "                (old i32) (new i32)] (-> void)")
    (t/line! (mut o) "  (let [(mut e) (graph/first-use (.g cx) old)]")
    (t/line! (mut o) "    (while (>= e 0)")
    (t/line! (mut o) "      (enqueue! (mut work) (mut queued) (graph/user (.g cx) e))")
    (t/line! (mut o) "      (set! e (graph/next-use (.g cx) e))))")
    (t/line! (mut o) "  (graph/replace-uses! (mut (.g cx)) old new)")
    (t/line! (mut o) "  (enqueue! (mut work) (mut queued) new)")
    (t/line! (mut o) "  (let [role (ir/role (graph/op (.g cx) old))]")
    (t/line! (mut o) "    (cond (ir/pure? (graph/op (.g cx) old)) (do (graph/kill! (mut (.g cx)) old ir/PURE) (do))")
    (t/line! (mut o) "          ; A region or phi that has been replaced has no one left to speak for it.")
    (t/line! (mut o) "          (or (= role 3) (= role 4) (= role 8)) (graph/drop! (mut (.g cx)) old)")
    (t/line! (mut o) "          :else (do)))")
    (t/line! (mut o) "  (do))")
    (t/line! (mut o) ";;; A region with one way in is about to become that way. Its phis go first,")
    (t/line! (mut o) ";;; each becoming its one value: a phi left behind would name as its region")
    (t/line! (mut o) ";;; whatever the way in was, and if that is a region, be taken for one of its phis.")
    (t/line! (mut o) "(defn settle-phis! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))")
    (t/line! (mut o) "                    (n i32)] (-> void)")
    (t/line! (mut o) "  (let [role (ir/role (graph/op (.g cx) n))]")
    (t/line! (mut o) "    (when (and (or (= role 3) (= role 4)) (= (graph/arity (.g cx) n) 1))")
    (t/line! (mut o) "      (let [(mut again) true]")
    (t/line! (mut o) "        (while again")
    (t/line! (mut o) "          (set! again false)")
    (t/line! (mut o) "          (let [(mut e) (graph/first-use (.g cx) n)]")
    (t/line! (mut o) "            (while (and (>= e 0) (not again))")
    (t/line! (mut o) "              (let [u (graph/user (.g cx) e)]")
    (t/line! (mut o) "                (when (and (= (ir/role (graph/op (.g cx) u)) 8) (= (graph/input (.g cx) u 0) n)")
    (t/line! (mut o) "                           (= (graph/arity (.g cx) u) 2) (!= (graph/input (.g cx) u 1) u))")
    (t/line! (mut o) "                  (replace! (mut cx) (mut work) (mut queued) u (graph/input (.g cx) u 1))")
    (t/line! (mut o) "                  (set! again true))")
    (t/line! (mut o) "                (unless again (set! e (graph/next-use (.g cx) e)))))))))))")
    (t/line! (mut o) ";;; A control node that can never run goes, and so does whatever only it led to.")
    (t/line! (mut o) ";;; A region loses the input that came from it, and its phis the matching")
    (t/line! (mut o) ";;; input; a loop that loses its way in goes entirely.")
    (t/line! (mut o) "(defn kill-control! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))")
    (t/line! (mut o) "                     (dead i32)] (-> void)")
    (t/line! (mut o) "  (let [(mut stack) (ArrayList::new [i32] (.alc cx))]")
    (t/line! (mut o) "    (push! (mut stack) dead)")
    (t/line! (mut o) "    (while (> (len stack) 0)")
    (t/line! (mut o) "      (let [d (get stack (- (len stack) 1))]")
    (t/line! (mut o) "        (pop! (mut stack))")
    (t/line! (mut o) "        (unless (graph/dead? (.g cx) d)")
    (t/line! (mut o) "          ; Who uses it is noted before anything is changed: taking an input out")
    (t/line! (mut o) "          ; of a region or a phi moves its later inputs down, and with them the")
    (t/line! (mut o) "          ; uses a walk of this node's users would go on to.")
    (t/line! (mut o) "          (let [(mut users) (ArrayList::new [i32] (.alc cx))")
    (t/line! (mut o) "                (mut e) (graph/first-use (.g cx) d)]")
    (t/line! (mut o) "            (while (>= e 0)")
    (t/line! (mut o) "              (push! (mut users) (graph/user (.g cx) e))")
    (t/line! (mut o) "              (set! e (graph/next-use (.g cx) e)))")
    (t/line! (mut o) "            (for u users")
    (t/line! (mut o) "              (unless (graph/dead? (.g cx) u)")
    (t/line! (mut o) "                (let [role (ir/role (graph/op (.g cx) u))]")
    (t/line! (mut o) "                  (cond")
    (t/line! (mut o) "                    ; A phi of a dead region, or the value of a dead call or load: it goes when its users do.")
    (t/line! (mut o) "                    (not (ir/control-node? (graph/op (.g cx) u))) (enqueue! (mut work) (mut queued) u)")
    (t/line! (mut o) "                    (or (= role 3) (= role 4))")
    (t/line! (mut o) "                      ; Each input of the region that is this node, wherever it now is.")
    (t/line! (mut o) "                      (let [(mut going) true]")
    (t/line! (mut o) "                        (while going")
    (t/line! (mut o) "                          (let [(mut slot) -1]")
    (t/line! (mut o) "                            (for i (range 0 (graph/arity (.g cx) u))")
    (t/line! (mut o) "                              (when (and (< slot 0) (= (graph/input (.g cx) u i) d)) (set! slot i)))")
    (t/line! (mut o) "                            (cond")
    (t/line! (mut o) "                              (< slot 0) (set! going false)")
    (t/line! (mut o) "                              ; A loop that loses its way in goes entirely.")
    (t/line! (mut o) "                              (and (= role 4) (= slot 0)) (do (push! (mut stack) u) (set! going false))")
    (t/line! (mut o) "                              :else")
    (t/line! (mut o) "                                (do")
    (t/line! (mut o) "                                  ; The region's phis lose the input that came along this way.")
    (t/line! (mut o) "                                  (let [(mut phis) (ArrayList::new [i32] (.alc cx))")
    (t/line! (mut o) "                                        (mut p) (graph/first-use (.g cx) u)]")
    (t/line! (mut o) "                                    (while (>= p 0)")
    (t/line! (mut o) "                                      (let [phi (graph/user (.g cx) p)]")
    (t/line! (mut o) "                                        (when (and (= (ir/role (graph/op (.g cx) phi)) 8) (= (graph/input (.g cx) phi 0) u))")
    (t/line! (mut o) "                                          (push! (mut phis) phi)))")
    (t/line! (mut o) "                                      (set! p (graph/next-use (.g cx) p)))")
    (t/line! (mut o) "                                    (for phi phis")
    (t/line! (mut o) "                                      (enqueue! (mut work) (mut queued) (graph/input (.g cx) phi (+ slot 1)))")
    (t/line! (mut o) "                                      (graph/remove-input! (mut (.g cx)) phi (+ slot 1))")
    (t/line! (mut o) "                                      (enqueue! (mut work) (mut queued) phi))")
    (t/line! (mut o) "                                    (free! (mut phis)))")
    (t/line! (mut o) "                                  (graph/remove-input! (mut (.g cx)) u slot)")
    (t/line! (mut o) "                                  (enqueue! (mut work) (mut queued) u)")
    (t/line! (mut o) "                                  (when (= (graph/arity (.g cx) u) 0)")
    (t/line! (mut o) "                                    (push! (mut stack) u)")
    (t/line! (mut o) "                                    (set! going false)))))))")
    (t/line! (mut o) "                    :else (push! (mut stack) u)))))")
    (t/line! (mut o) "            (free! (mut users)))")
    (t/line! (mut o) "          (for i (range 0 (graph/arity (.g cx) d))")
    (t/line! (mut o) "            (when (!= (graph/input (.g cx) d i) 0) (enqueue! (mut work) (mut queued) (graph/input (.g cx) d i))))")
    (t/line! (mut o) "          (graph/drop! (mut (.g cx)) d))))")
    (t/line! (mut o) "    (free! (mut stack))))")
    (t/line! (mut o) ";;; A branch that always goes one way: what followed its live side follows what")
    (t/line! (mut o) ";;; led to the branch, and its other side can never run.")
    (t/line! (mut o) "(defn branch! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))")
    (t/line! (mut o) "               (n i32) (taken bool)] (-> void)")
    (t/line! (mut o) "  (let [before (graph/input (.g cx) n 0)")
    (t/line! (mut o) "        (mut live) (: 0 i32)")
    (t/line! (mut o) "        (mut dead) (: 0 i32)")
    (t/line! (mut o) "        (mut e) (graph/first-use (.g cx) n)]")
    (t/line! (mut o) "    (while (>= e 0)")
    (t/line! (mut o) "      (let [u (graph/user (.g cx) e)")
    (t/line! (mut o) "            role (ir/role (graph/op (.g cx) u))]")
    (t/line! (mut o) "        (when (= role 6) (if taken (set! live u) (set! dead u)))")
    (t/line! (mut o) "        (when (= role 7) (if taken (set! dead u) (set! live u))))")
    (t/line! (mut o) "      (set! e (graph/next-use (.g cx) e)))")
    (t/line! (mut o) "    (when (!= dead 0) (kill-control! (mut cx) (mut work) (mut queued) dead))")
    (t/line! (mut o) "    (when (!= live 0)")
    (t/line! (mut o) "      (let [(mut u) (graph/first-use (.g cx) live)]")
    (t/line! (mut o) "        (while (>= u 0)")
    (t/line! (mut o) "          (enqueue! (mut work) (mut queued) (graph/user (.g cx) u))")
    (t/line! (mut o) "          (set! u (graph/next-use (.g cx) u))))")
    (t/line! (mut o) "      (graph/replace-uses! (mut (.g cx)) live before)")
    (t/line! (mut o) "      (graph/drop! (mut (.g cx)) live))")
    (t/line! (mut o) "    (enqueue! (mut work) (mut queued) (graph/input (.g cx) n 1))")
    (t/line! (mut o) "    (graph/drop! (mut (.g cx)) n)))")
    (if (joins? spec)
        (do
          (t/line! (mut o) ";;; Ways that meet only to part again. Where several ways reach a region, each")
          (t/line! (mut o) ";;; bringing a constant, and all that is done there is to branch or switch on")
          (t/line! (mut o) ";;; which constant came, each way goes straight to the side its constant")
          (t/line! (mut o) ";;; chooses, and a side no way chooses can never run. True if `n` was such a")
          (t/line! (mut o) ";;; branch or switch, which is then gone with its region and phi.")
          (t/line! (mut o) "(defn thread! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))")
          (t/line! (mut o) "               (n i32)] (-> bool)")
          (t/line! (mut o) "  (let [role (ir/role (graph/op (.g cx) n))]")
          (t/line! (mut o) "    (if (or (and (!= role 5) (!= role 19)) (< (graph/arity (.g cx) n) 2))")
          (t/line! (mut o) "        false")
          (t/line! (mut o) "        (let [r (graph/input (.g cx) n 0)")
          (t/line! (mut o) "              v (graph/input (.g cx) n 1)")
          (t/line! (mut o) "              ways (graph/arity (.g cx) r)")
          (t/line! (mut o) "              (mut ok) (and (= (ir/role (graph/op (.g cx) r)) 3)")
          (t/line! (mut o) "                            (= (ir/role (graph/op (.g cx) v)) 8)")
          (t/line! (mut o) "                            (= (graph/input (.g cx) v 0) r)")
          (t/line! (mut o) "                            (= (graph/use-count (.g cx) r) 2)")
          (t/line! (mut o) "                            (= (graph/use-count (.g cx) v) 1)")
          (t/line! (mut o) "                            (= (graph/arity (.g cx) v) (+ ways 1))")
          (t/line! (mut o) "                            (>= ways 2))")
          (t/line! (mut o) "              (mut known) 0]")
          (t/line! (mut o) "          ; How many ways bring a constant: those are the ones that can go on.")
          (t/line! (mut o) "          (when ok")
          (t/line! (mut o) "            (for i (range 1 (+ ways 1))")
          (t/line! (mut o) "              (when (= (ir/role (graph/op (.g cx) (graph/input (.g cx) v i))) 10) (set! known (+ known 1)))))")
          (t/line! (mut o) "          (if (or (not ok) (= known 0))")
          (t/line! (mut o) "              false")
          (t/line! (mut o) "              (let [(mut sides) (ArrayList::new [i32] (.alc cx))")
          (t/line! (mut o) "                    (mut chosen) (ArrayList::new [i32] (.alc cx))")
          (t/line! (mut o) "                    (mut goes) (ArrayList::new [i32] (.alc cx))")
          (t/line! (mut o) "                    (mut e) (graph/first-use (.g cx) n)]")
          (t/line! (mut o) "                (while (>= e 0)")
          (t/line! (mut o) "                  (let [u (graph/user (.g cx) e)]")
          (t/line! (mut o) "                    (when (= (graph/input (.g cx) u 0) n) (push! (mut sides) u)))")
          (t/line! (mut o) "                  (set! e (graph/next-use (.g cx) e)))")
          (t/line! (mut o) "                ; Which side each way goes to, settled before anything is changed:")
          (t/line! (mut o) "                ; the side its constant chooses, a switch's default if no case does.")
          (t/line! (mut o) "                (for i (range 0 ways)")
          (t/line! (mut o) "                  (let [k (graph/payload (.g cx) (graph/input (.g cx) v (+ i 1)))")
          (t/line! (mut o) "                        (mut to) (: 0 i32)")
          (t/line! (mut o) "                        (mut otherwise) (: 0 i32)]")
          (t/line! (mut o) "                    (for side sides")
          (t/line! (mut o) "                      (let [side-role (ir/role (graph/op (.g cx) side))]")
          (t/line! (mut o) "                        (when (= side-role 21) (set! otherwise side))")
          (t/line! (mut o) "                        (when (or (and (= side-role 6) (!= k 0))")
          (t/line! (mut o) "                                  (and (= side-role 7) (= k 0))")
          (t/line! (mut o) "                                  (and (= side-role 20) (= (graph/payload (.g cx) side) k)))")
          (t/line! (mut o) "                          (set! to side))))")
          (t/line! (mut o) "                    ; A way that brings no constant stays where it is.")
          (t/line! (mut o) "                    (push! (mut goes)")
          (t/line! (mut o) "                           (cond (!= (ir/role (graph/op (.g cx) (graph/input (.g cx) v (+ i 1)))) 10) 0")
          (t/line! (mut o) "                                 (!= to 0) to")
          (t/line! (mut o) "                                 :else otherwise))))")
          (t/line! (mut o) "                (for side sides")
          (t/line! (mut o) "                  (clear! (mut chosen))")
          (t/line! (mut o) "                  (for i (range 0 ways)")
          (t/line! (mut o) "                    (when (= (get goes i) side) (push! (mut chosen) (graph/input (.g cx) r i))))")
          (t/line! (mut o) "                  (cond")
          (t/line! (mut o) "                    ; Some ways stay, so the side is still reached from the")
          (t/line! (mut o) "                    ; branch as well as from the ways that now go straight to it.")
          (t/line! (mut o) "                    (< known ways)")
          (t/line! (mut o) "                      (when (> (len chosen) 0)")
          (t/line! (mut o) "                        (let [meet (ir/make-region! (mut (.g cx)) (+ (len chosen) 1))]")
          (t/line! (mut o) "                          (replace! (mut cx) (mut work) (mut queued) side meet)")
          (t/line! (mut o) "                          (graph/set-input! (mut (.g cx)) meet 0 side)")
          (t/line! (mut o) "                          (for i (range 0 (len chosen))")
          (t/line! (mut o) "                            (graph/set-input! (mut (.g cx)) meet (+ i 1) (get chosen i)))))")
          (t/line! (mut o) "                    (= (len chosen) 0) (kill-control! (mut cx) (mut work) (mut queued) side)")
          (t/line! (mut o) "                    (= (len chosen) 1)")
          (t/line! (mut o) "                      (do (replace! (mut cx) (mut work) (mut queued) side (get chosen 0))")
          (t/line! (mut o) "                          (graph/drop! (mut (.g cx)) side))")
          (t/line! (mut o) "                    :else")
          (t/line! (mut o) "                      (let [meet (ir/make-region! (mut (.g cx)) (len chosen))]")
          (t/line! (mut o) "                        (for i (range 0 (len chosen)) (graph/set-input! (mut (.g cx)) meet i (get chosen i)))")
          (t/line! (mut o) "                        (replace! (mut cx) (mut work) (mut queued) side meet)")
          (t/line! (mut o) "                        (graph/drop! (mut (.g cx)) side))))")
          (t/line! (mut o) "                (for i (range 1 (+ ways 1)) (enqueue! (mut work) (mut queued) (graph/input (.g cx) v i)))")
          (t/line! (mut o) "                (if (< known ways)")
          (t/line! (mut o) "                    ; The ways that went on leave the region and its phi, last first.")
          (t/line! (mut o) "                    (do (for back (range 0 ways)")
          (t/line! (mut o) "                          (let [i (- (- ways 1) back)]")
          (t/line! (mut o) "                            (when (!= (get goes i) 0)")
          (t/line! (mut o) "                              (graph/remove-input! (mut (.g cx)) v (+ i 1))")
          (t/line! (mut o) "                              (graph/remove-input! (mut (.g cx)) r i))))")
          (t/line! (mut o) "                        (enqueue! (mut work) (mut queued) r)")
          (t/line! (mut o) "                        (enqueue! (mut work) (mut queued) v)")
          (t/line! (mut o) "                        (enqueue! (mut work) (mut queued) n))")
          (t/line! (mut o) "                    (do (graph/drop! (mut (.g cx)) n)")
          (t/line! (mut o) "                        (graph/drop! (mut (.g cx)) v)")
          (t/line! (mut o) "                        (graph/drop! (mut (.g cx)) r)))")
          (t/line! (mut o) "                (free! (mut sides))")
          (t/line! (mut o) "                (free! (mut chosen))")
          (t/line! (mut o) "                (free! (mut goes))")
          (t/line! (mut o) "                true))))))")
          0)
        (do
          (t/line! (mut o) ";;; This node set has no regions for ways to meet at.")
          (t/line! (mut o) "(defn thread! [(cx (mut st/State)) (work (mut (ArrayList i32))) (queued (mut (ArrayList bool)))")
          (t/line! (mut o) "               (n i32)] (-> bool) false)")
          0))
    (t/line! (mut o) ";;; A region with one way in is that way; a phi all of whose values are one
;;; node, or that node and the phi itself, is that node.")
    (t/line! (mut o) "(defn collapse [(cx (mut st/State)) (n i32)] (-> i32)")
    (t/line! (mut o) "  (let [role (ir/role (graph/op (.g cx) n))]")
    (t/line! (mut o) "    (cond (and (or (= role 3) (= role 4)) (= (graph/arity (.g cx) n) 1)) (graph/input (.g cx) n 0)")
    (t/line! (mut o) "          (= role 8)")
    (t/line! (mut o) "            (let [(mut only) (: 0 i32)")
    (t/line! (mut o) "                  (mut several) false]")
    (t/line! (mut o) "              (for i (range 1 (graph/arity (.g cx) n))")
    (t/line! (mut o) "                (let [v (graph/input (.g cx) n i)]")
    (t/line! (mut o) "                  (when (!= v n)")
    (t/line! (mut o) "                    (if (or (= only 0) (= only v)) (set! only v) (set! several true)))))")
    (t/line! (mut o) "              (if several 0 only))")
    (t/line! (mut o) "          :else 0)))")
    (t/line! (mut o) ";;; Keep what control from the start reaches and what")
    (t/line! (mut o) ";;; that reads, and drop the rest, which may be rings of values that only read")
    (t/line! (mut o) ";;; each other.")
    (t/line! (mut o) "(defn sweep! [(cx (mut st/State))] (-> void)")
    (t/line! (mut o) "  (let [(mut keep) (ArrayList::new [bool] (.alc cx))")
    (t/line! (mut o) "        (mut stack) (ArrayList::new [i32] (.alc cx))]")
    (t/line! (mut o) "    (for _ (range 0 (graph/size (.g cx))) (push! (mut keep) false))")
    (t/line! (mut o) "    (when (!= (.start (.g cx)) 0)")
    (t/line! (mut o) "      (set! (mut keep) (cast i64 (.start (.g cx))) true)")
    (t/line! (mut o) "      (push! (mut stack) (.start (.g cx))))")
    (t/line! (mut o) "    (while (> (len stack) 0)")
    (t/line! (mut o) "      (let [n (get stack (- (len stack) 1))]")
    (t/line! (mut o) "        (pop! (mut stack))")
    (t/line! (mut o) "        ; Whatever a kept node reads is kept.")
    (t/line! (mut o) "        (for i (range 0 (graph/arity (.g cx) n))")
    (t/line! (mut o) "          (let [d (graph/input (.g cx) n i)]")
    (t/line! (mut o) "            (when (and (!= d 0) (not (get keep (cast i64 d))))")
    (t/line! (mut o) "              (set! (mut keep) (cast i64 d) true)")
    (t/line! (mut o) "              (push! (mut stack) d))))")
    (t/line! (mut o) "        ; Control goes on to the control nodes that follow a kept one.")
    (t/line! (mut o) "        (when (ir/control-node? (graph/op (.g cx) n))")
    (t/line! (mut o) "          (let [(mut e) (graph/first-use (.g cx) n)]")
    (t/line! (mut o) "            (while (>= e 0)")
    (t/line! (mut o) "              (let [u (graph/user (.g cx) e)")
    (t/line! (mut o) "                    role (ir/role (graph/op (.g cx) u))]")
    (t/line! (mut o) "                (when (and (not (get keep (cast i64 u))) (ir/control-node? (graph/op (.g cx) u))")
    (t/line! (mut o) "                           (or (= role 3) (= role 4) (= (graph/input (.g cx) u 0) n)))")
    (t/line! (mut o) "                  (set! (mut keep) (cast i64 u) true)")
    (t/line! (mut o) "                  (push! (mut stack) u)))")
    (t/line! (mut o) "              (set! e (graph/next-use (.g cx) e)))))))")
    (t/line! (mut o) "    (for i (range 1 (graph/size (.g cx)))")
    (t/line! (mut o) "      (let [n (cast i32 i)]")
    (t/line! (mut o) "        (unless (or (get keep i) (graph/dead? (.g cx) n)) (graph/drop! (mut (.g cx)) n))))")
    (t/line! (mut o) "    (free! (mut keep))")
    (t/line! (mut o) "    (free! (mut stack))))")
    (t/line! (mut o) ";;; Apply folding and the rules until nothing changes. Returns how many")
    (t/line! (mut o) ";;; replacements were made; `counts`, if not empty, gets one more per rule fired.")
    (t/line! (mut o) "(defn run-counting [(cx (mut st/State)) (counts (mut (ArrayList i64)))] (-> i64)")
    (t/line! (mut o) "  (let [(mut work) (ArrayList::new [i32] (.alc cx))")
    (t/line! (mut o) "        (mut queued) (ArrayList::new [bool] (.alc cx))")
    (t/line! (mut o) "        (mut changes) 0")
    (t/line! (mut o) "        (mut cut) false]")
    (t/line! (mut o) "    (for i (range 1 (graph/size (.g cx)))")
    (t/line! (mut o) "      (let [n (cast i32 (- (graph/size (.g cx)) i))]")
    (t/line! (mut o) "        (unless (graph/dead? (.g cx) n) (enqueue! (mut work) (mut queued) n))))")
    (t/line! (mut o) "    (while (> (len work) 0)")
    (t/line! (mut o) "      (let [n (get work (- (len work) 1))]")
    (t/line! (mut o) "        (pop! (mut work))")
    (t/line! (mut o) "        (set! (mut queued) (cast i64 n) false)")
    (t/line! (mut o) "        (unless (graph/dead? (.g cx) n)")
    (t/line! (mut o) "          ; What a rule makes in place of `n` comes from where `n` came from.")
    (t/line! (mut o) "          (graph/from! (mut (.g cx)) n)")
    (t/line! (mut o) "          (let [operation (graph/op (.g cx) n)]")
    (t/line! (mut o) "            (if (and (ir/pure? operation) (= (graph/use-count (.g cx) n) 0))")
    (t/line! (mut o) "                (do (graph/kill! (mut (.g cx)) n ir/PURE) (do))")
    (t/line! (mut o) "                (do")
    (t/line! (mut o) "                  ; A commutative node keeps its operands in the builder's order.")
    (t/line! (mut o) "                  (when (and (ir/commutative? operation) (= (graph/arity (.g cx) n) 2))")
    (t/line! (mut o) "                    (let [a (graph/input (.g cx) n 0)")
    (t/line! (mut o) "                          b (graph/input (.g cx) n 1)]")
    (t/line! (mut o) "                      (when (ir/swap? (.g cx) a b)")
    (t/line! (mut o) "                        (graph/set-input! (mut (.g cx)) n 0 b)")
    (t/line! (mut o) "                        (graph/set-input! (mut (.g cx)) n 1 a))))")
    (t/line! (mut o) "                  (if (thread! (mut cx) (mut work) (mut queued) n)")
    (t/line! (mut o) "                      (do (set! changes (+ changes 1)) (set! cut true))")
    (t/line! (mut o) "                  (do")
    (t/line! (mut o) "                  (settle-phis! (mut cx) (mut work) (mut queued) n)")
    (t/line! (mut o) "                  (let [collapsed (collapse (mut cx) n)")
    (t/line! (mut o) "                        plain (if (!= collapsed 0) collapsed (fold (mut cx) n))")
    (t/line! (mut o) "                        folded (if (!= plain 0) plain (fold-phi (mut cx) n))")
    (t/line! (mut o) "                        simpler (if (!= folded 0) folded (simplify (mut cx) n))")
    (t/line! (mut o) "                        ; Unchanged by any rule: it may now equal a node already there.")
    (t/line! (mut o) "                        ; Two frame objects alike in every way are still two objects.")
    (t/line! (mut o) "                        other (if (and (= simpler 0) (ir/pure? operation) (!= (ir/role operation) 15))")
    (t/line! (mut o) "                                  (graph/canonical! (mut (.g cx)) n)")
    (t/line! (mut o) "                                  simpler)]")
    (t/line! (mut o) "                    (when (< other 0)")
    (t/line! (mut o) "                      (when (> (len counts) (.fired cx))")
    (t/line! (mut o) "                        (set! (mut counts) (.fired cx) (+ (get counts (.fired cx)) 1)))")
    (t/line! (mut o) "                      (set! changes (+ changes 1))")
    (t/line! (mut o) "                      (set! cut true)")
    (t/line! (mut o) "                      (branch! (mut cx) (mut work) (mut queued) n (= other -1)))")
    (t/line! (mut o) "                    (when (and (> other 0) (!= other n))")
    (t/line! (mut o) "                      (when (and (!= simpler 0) (> (len counts) (.fired cx)))")
    (t/line! (mut o) "                        (set! (mut counts) (.fired cx) (+ (get counts (.fired cx)) 1)))")
    (t/line! (mut o) "                      (set! changes (+ changes 1))")
    (t/line! (mut o) "                      (replace! (mut cx) (mut work) (mut queued) n other)))))))))))")
    (t/line! (mut o) "    (graph/from! (mut (.g cx)) 0)")
    (t/line! (mut o) "    (free! (mut work))")
    (t/line! (mut o) "    (free! (mut queued))")
    (t/line! (mut o) "    ; Always: rings of phis that only feed each other are dead without any cut.")
    (t/line! (mut o) "    (when (or cut (> changes 0) (.swept cx)) (sweep! (mut cx)))")
    (t/line! (mut o) "    (set! (.swept cx) false)")
    (t/line! (mut o) "    (st/grow-nodes! (mut cx))")
    (t/line! (mut o) "    changes))")
    (t/line! (mut o) "(defn run [(cx (mut st/State))] (-> i64)")
    (t/line! (mut o) "  (let [(mut none) (ArrayList::new [i64] (.alc cx))]")
    (t/line! (mut o) "    (run-counting (mut cx) (mut none))))")))
