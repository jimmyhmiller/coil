;;; The `.ops` language: a linear IR's operations, said once.
;;;
;;;   ops read through declarative.view, functions are Func of native.cir
;;;   type I64 = 1 : 64
;;;   op ADD 10 (a, b) = a + b
;;;   op SEXT 29 (a) imm bits = sext(a, bits)
;;;   op LOAD 80 (p) imm offset imm2 shape role load = load(p + offset, shape & 255, (shape >> 8) & 1)
;;;   op CONDBR 111 (c) role branch = c == 0
;;;
;;; An IR of this kind is a function of blocks, each a run of instructions
;;; ending in one that leaves it; a value is an instruction's result, and a few
;;; values (constants, symbols, parameters, stack variables) are no
;;; instruction. Everything about how the IR is stored is in the module named
;;; by `read through`: the accessors `op`, `ty`, `nops`, `operand`, `target`,
;;; `imm`, `imm2`, `aux`, `value-count`, `block-count`, `block-first`,
;;; `block-end`, `inst`, `term`, `phi-count`, `phi`, `incoming`, `case-count`,
;;; `case-value`, over its `Func`.
;;;
;;; An operation has its number in the IR, its value operands, names for its
;;; immediates, a role (what it is to control and memory: `value` unless said),
;;; and from `= …` what it computes, over 64-bit words. For a branch the
;;; meaning is which of its targets it goes to.
;;;
;;; From it: the numbers and names, tables of each operation's role and
;;; operand count, and a reference interpreter, so that compiled code can be
;;; checked against the meanings.
(module lang.ops)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.fs" :as fs)
(import "lang.text" :as t)

(defstruct OpsType [(name (slice u8)) (number i64) (bits i64) (float bool)])

;;; immediates: the names given to imm, imm2 and aux, or "".
(defstruct Op
  [(name (slice u8))
   (number i64)
   (operands (ArrayList (slice u8)))
   (variadic bool)
   (imm (slice u8))
   (imm2 (slice u8))
   (aux (slice u8))
   (role (slice u8))
   (meaning (slice u8))
   (line i64)])

(defstruct Ops
  [(view (slice u8))
   (func-module (slice u8))
   (func-type (slice u8))
   (types (ArrayList OpsType))
   (ops (ArrayList Op))])

;;; Roles, and their numbers in the generated tables.
(const ROLE-COUNT 17)

(defn role-name [(i i64)] (-> (slice u8))
  (cond
        (= i 0) "value"
        (= i 1) "const"
        (= i 2) "symbol"
        (= i 3) "param"
        (= i 4) "object"
        (= i 5) "result"
        (= i 6) "load"
        (= i 7) "store"
        (= i 8) "call"
        (= i 9) "tailcall"
        (= i 10) "jump"
        (= i 11) "branch"
        (= i 12) "switch"
        (= i 13) "return"
        (= i 14) "trap"
        (= i 15) "phi"
        (= i 16) "effect"
        :else ""))

(defn role-number [(role (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for i (range 0 ROLE-COUNT) (when (= (role-name i) role) (set! found i)))
    found))

(defn op-index [(spec Ops) (name (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for i (range 0 (len (.ops spec))) (when (= (.name (get (.ops spec) i)) name) (set! found i)))
    found))

(defn op-number [(spec Ops) (name (slice u8))] (-> i64)
  (let [i (op-index spec name)]
    (if (< i 0) -1 (.number (get (.ops spec) i)))))

(defn type-number [(spec Ops) (name (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for ty (.types spec) (when (= (.name ty) name) (set! found (.number ty))))
    found))

;; ---------------------------------------------------------------- meanings

;;; What a name in a meaning stands for in the evaluator.
(defn meaning-name [(c (mut t/Cur)) (op Op) (tok t/Tok)] (-> (slice u8))
  (let [name (.text tok)
        (mut found) ""]
    (for i (range 0 (len (.operands op)))
      (when (= (get (.operands op) i) name) (set! found (t/cat3 "(operand* (mut r) v " (t/int-text i) ")"))))
    (cond
      (!= found "") found
      (= name (.imm op)) "imm*"
      (= name (.imm2 op)) "imm2*"
      (= name (.aux op)) "aux*"
      (= name "width") "(cast u64 width*)"
      :else (t/die (mut c) tok (t/cat4 "a meaning of " (.name op) " names nothing: " name)))))

(defn truth [(test (slice u8))] (-> (slice u8))
  (t/cat3 "(if " test " (: 1 u64) (: 0 u64))"))

;;; Functions a meaning may call. Widths are given where they matter: the
;;; words themselves are always 64 bits.
(defn meaning-call [(c (mut t/Cur)) (op Op) (name (slice u8)) (at t/Tok)] (-> (slice u8))
  (let [(mut args) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (unless (t/at? (mut c) ")")
      (push! (mut args) (meaning-expr (mut c) op 0))
      (while (t/accept! (mut c) ",") (push! (mut args) (meaning-expr (mut c) op 0))))
    (t/expect! (mut c) ")")
    (let [k (len args)
          a (if (> k 0) (get args 0) "")
          b (if (> k 1) (get args 1) "")
          z (if (> k 2) (get args 2) "")]
      (cond
        ; `cases(k, e0, e1, …)`: the k-th of the expressions.
        (and (= name "cases") (>= k 2))
          (let [(mut o) (t/out-new)]
            (t/emit! (mut o) (t/cat3 "(let [k* " a "] (cond"))
            (for i (range 1 k)
              (t/emit! (mut o) (t/cat4 " (= k* " (t/int-text (- i 1)) ") " (get args i))))
            (t/emit! (mut o) " :else (panic \"a meaning's `cases` has no case for this number\")))")
            (t/text-of (mut o)))
        ; `width(x)`: the bits of operand x's type.
        (and (= name "width") (= k 1)) (t/cat3 "(cast u64 (type-bits (view/ty (.f r) (operand-id (mut r) v " (operand-position (mut c) op at a) "))))")
        (and (= name "sext") (= k 2)) (t/cat4 "(bv/sext " a " (cast i64 " (t/cat2 b "))"))
        (and (= name "zext") (= k 2)) (t/cat4 "(bv/cut " a " (cast i64 " (t/cat2 b "))"))
        (and (= name "signed") (= k 2)) (t/cat4 "(cast u64 (bv/signed " a " (cast i64 " (t/cat2 b ")))"))
        (and (= name "clz") (= k 2)) (t/cat4 "(bv/clz " a " (cast i64 " (t/cat2 b "))"))
        (and (= name "ctz") (= k 2)) (t/cat4 "(bv/ctz " a " (cast i64 " (t/cat2 b "))"))
        (and (= name "popcount") (= k 2)) (t/cat4 "(bv/popcount " a " (cast i64 " (t/cat2 b "))"))
        (and (= name "bswap") (= k 2)) (t/cat4 "(bv/bswap " a " (cast i64 " (t/cat2 b "))"))
        (and (= name "bitrev") (= k 2)) (t/cat4 "(bv/bitrev " a " (cast i64 " (t/cat2 b "))"))
        (and (= name "rol") (= k 3)) (t/cat4 "(bv/rol " a " " (t/cat4 b " (cast i64 " z "))"))
        (and (= name "ror") (= k 3)) (t/cat4 "(bv/ror " a " " (t/cat4 b " (cast i64 " z "))"))
        (and (= name "umulh") (= k 2)) (t/cat4 "(bv/umulh " a " " (t/cat2 b " 64)"))
        (and (= name "smulh") (= k 2)) (t/cat4 "(bv/smulh " a " " (t/cat2 b " 64)"))
        (and (= name "udiv") (= k 2)) (t/cat4 "(bv/udiv " a " " (t/cat2 b ")"))
        (and (= name "urem") (= k 2)) (t/cat4 "(bv/urem " a " " (t/cat2 b ")"))
        (and (= name "sdiv") (= k 2)) (t/cat4 "(bv/sdiv " a " " (t/cat2 b ")"))
        (and (= name "srem") (= k 2)) (t/cat4 "(bv/srem " a " " (t/cat2 b ")"))
        (and (= name "sar") (= k 2)) (t/cat4 "(bv/sar " a " (& " (t/cat2 b " (: 63 u64)))"))
        (and (= name "slt") (= k 2)) (truth (t/cat4 "(< (cast i64 " a ") (cast i64 " (t/cat2 b "))")))
        (and (= name "sle") (= k 2)) (truth (t/cat4 "(<= (cast i64 " a ") (cast i64 " (t/cat2 b "))")))
        (and (= name "ult") (= k 2)) (truth (t/cat4 "(< " a " " (t/cat2 b ")")))
        (and (= name "ule") (= k 2)) (truth (t/cat4 "(<= " a " " (t/cat2 b ")")))
        (and (= name "select") (= k 3)) (t/cat4 "(if (!= " a " (: 0 u64)) " (t/cat4 b " " z ")"))
        ; Overflow of an operation done in `w` bits, signed or not.
        (and (= name "sadd-overflows") (= k 3)) (truth (t/cat4 "(bv/sadd-overflows " a " " (t/cat4 b " (cast i64 " z "))")))
        (and (= name "uadd-overflows") (= k 3)) (truth (t/cat4 "(bv/uadd-overflows " a " " (t/cat4 b " (cast i64 " z "))")))
        (and (= name "ssub-overflows") (= k 3)) (truth (t/cat4 "(bv/ssub-overflows " a " " (t/cat4 b " (cast i64 " z "))")))
        (and (= name "usub-overflows") (= k 3)) (truth (t/cat4 "(bv/usub-overflows " a " " (t/cat4 b " (cast i64 " z "))")))
        (and (= name "smul-overflows") (= k 3)) (truth (t/cat4 "(bv/smul-overflows " a " " (t/cat4 b " (cast i64 " z "))")))
        (and (= name "umul-overflows") (= k 3)) (truth (t/cat4 "(bv/umul-overflows " a " " (t/cat4 b " (cast i64 " z "))")))
        ; Floating point, on the values' bits; the last argument is the width.
        (and (= name "fadd") (= k 3)) (t/cat4 "(bv/fadd " a " " (t/cat4 b " (cast i64 " z "))"))
        (and (= name "fsub") (= k 3)) (t/cat4 "(bv/fsub " a " " (t/cat4 b " (cast i64 " z "))"))
        (and (= name "fmul") (= k 3)) (t/cat4 "(bv/fmul " a " " (t/cat4 b " (cast i64 " z "))"))
        (and (= name "fdiv") (= k 3)) (t/cat4 "(bv/fdiv " a " " (t/cat4 b " (cast i64 " z "))"))
        (and (= name "fmin") (= k 3)) (t/cat4 "(bv/fmin " a " " (t/cat4 b " (cast i64 " z "))"))
        (and (= name "fmax") (= k 3)) (t/cat4 "(bv/fmax " a " " (t/cat4 b " (cast i64 " z "))"))
        (and (= name "fmin-number") (= k 3)) (t/cat4 "(bv/fmin-number " a " " (t/cat4 b " (cast i64 " z "))"))
        (and (= name "fmax-number") (= k 3)) (t/cat4 "(bv/fmax-number " a " " (t/cat4 b " (cast i64 " z "))"))
        (and (= name "fround") (= k 3)) (t/cat4 "(bv/fround " a " " (t/cat4 b " (cast i64 " z "))"))
        (and (= name "fneg") (= k 2)) (t/cat4 "(bv/fneg " a " (cast i64 " (t/cat2 b "))"))
        (and (= name "fabs") (= k 2)) (t/cat4 "(bv/fabs " a " (cast i64 " (t/cat2 b "))"))
        (and (= name "fsqrt") (= k 2)) (t/cat4 "(bv/fsqrt " a " (cast i64 " (t/cat2 b "))"))
        (and (= name "fma") (= k 4)) (t/cat4 "(bv/fma " a " " (t/cat4 b " " z (t/cat3 " (cast i64 " (get args 3) "))")))
        (and (= name "feq") (= k 3)) (truth (t/cat4 "(bv/feq " a " " (t/cat4 b " (cast i64 " z "))")))
        (and (= name "flt") (= k 3)) (truth (t/cat4 "(bv/flt " a " " (t/cat4 b " (cast i64 " z "))")))
        (and (= name "fle") (= k 3)) (truth (t/cat4 "(bv/fle " a " " (t/cat4 b " (cast i64 " z "))")))
        ; Whether either is not a number.
        (and (= name "unordered") (= k 3))
          (truth (t/cat4 "(or (bv/nan? " a (t/cat3 " (cast i64 " z ")) ") (t/cat4 "(bv/nan? " b (t/cat3 " (cast i64 " z "))") ")")))
        (and (= name "sitof") (= k 2)) (t/cat4 "(bv/sitof " a " (cast i64 " (t/cat2 b "))"))
        (and (= name "uitof") (= k 2)) (t/cat4 "(bv/uitof " a " (cast i64 " (t/cat2 b "))"))
        (and (= name "ftosi") (= k 3)) (t/cat4 "(bv/ftosi " a " (cast i64 " (t/cat4 b ") (cast i64 " z "))"))
        (and (= name "ftoui") (= k 3)) (t/cat4 "(bv/ftoui " a " (cast i64 " (t/cat4 b ") (cast i64 " z "))"))
        (and (= name "fext") (= k 1)) (t/cat3 "(bv/fext " a ")")
        (and (= name "ftrunc") (= k 1)) (t/cat3 "(bv/ftrunc " a ")")
        ; Memory: `bytes` at an address, sign-extended if `signed` is not 0;
        ; and a store, whose meaning is 0.
        (and (= name "load") (= k 3)) (t/cat4 "(load-bytes " a " " (t/cat4 b " " z ")"))
        ; Bytes copied (apart, or overlapping as memmove allows) and filled; 0.
        (and (= name "copy") (= k 3)) (t/cat4 "(copy-bytes " a " " (t/cat4 b " " z ")"))
        (and (= name "fill") (= k 3)) (t/cat4 "(fill-bytes " a " " (t/cat4 b " " z ")"))
        (and (= name "store") (= k 3)) (t/cat4 "(store-bytes " a " " (t/cat4 b " " z ")"))
        :else (t/die (mut c) at (t/cat2 "no meaning function named " name))))))

;;; The position among the operation's operands of the operand an expression is.
(defn operand-position [(c (mut t/Cur)) (op Op) (at t/Tok) (code (slice u8))] (-> (slice u8))
  (let [(mut found) ""]
    (for i (range 0 (len (.operands op)))
      (when (= code (t/cat3 "(operand* (mut r) v " (t/int-text i) ")")) (set! found (t/int-text i))))
    (when (= found "") (t/die (mut c) at "width(x) takes one of the operation's operands"))
    found))

(defn meaning-primary [(c (mut t/Cur)) (op Op)] (-> (slice u8))
  (let [tok (t/advance! (mut c))]
    (cond
      (= (.kind tok) t/T-NUM) (t/cat3 "(: " (t/u64-text (.value tok)) " u64)")
      (t/tok-is? tok "(")
        (let [e (meaning-expr (mut c) op 0)]
          (t/expect! (mut c) ")")
          e)
      (t/tok-is? tok "-") (t/cat3 "(primitive/isub (: 0 u64) " (meaning-primary (mut c) op) ")")
      (t/tok-is? tok "~") (t/cat3 "(^ " (meaning-primary (mut c) op) " (: 0xFFFFFFFFFFFFFFFF u64))")
      (= (.kind tok) t/T-IDENT)
        (if (and (t/at? (mut c) "(") (.glued (t/peek (mut c))))
            (do (t/advance! (mut c)) (meaning-call (mut c) op (.text tok) tok))
            (meaning-name (mut c) op tok))
      :else (t/die (mut c) tok (t/cat2 "expected a value, found " (.text tok))))))

(defn meaning-level [(op (slice u8))] (-> i64)
  (cond (= op "|") 1
        (= op "^") 2
        (= op "&") 3
        (or (= op "==") (= op "!=")) 4
        (or (= op "<<") (= op ">>")) 5
        (or (= op "+") (= op "-")) 6
        (= op "*") 7
        :else 0))

(defn meaning-binary [(op (slice u8)) (x (slice u8)) (y (slice u8))] (-> (slice u8))
  (cond
    (= op "+") (t/cat4 "(primitive/iadd " x " " (t/cat2 y ")"))
    (= op "-") (t/cat4 "(primitive/isub " x " " (t/cat2 y ")"))
    (= op "*") (t/cat4 "(primitive/imul " x " " (t/cat2 y ")"))
    (= op "<<") (t/cat4 "(bv/shl " x " (& " (t/cat2 y " (: 63 u64)))"))
    (= op ">>") (t/cat4 "(bv/shr " x " (& " (t/cat2 y " (: 63 u64)))"))
    (= op "==") (truth (t/cat4 "(= " x " " (t/cat2 y ")")))
    (= op "!=") (truth (t/cat4 "(!= " x " " (t/cat2 y ")")))
    :else (t/cat4 (t/cat3 "(" op " ") x " " (t/cat2 y ")"))))

(defn meaning-expr [(c (mut t/Cur)) (op Op) (min i64)] (-> (slice u8))
  (let [(mut left) (meaning-primary (mut c) op)
        (mut going) true]
    (while going
      (let [tok (t/peek (mut c))
            level (if (and (= (.kind tok) t/T-PUNCT) (not (.first tok))) (meaning-level (.text tok)) 0)]
        (if (and (> level 0) (> level min))
            (do (t/advance! (mut c))
                (set! left (meaning-binary (.text tok) left (meaning-expr (mut c) op level))))
            (set! going false))))
    left))

;; ---------------------------------------------------------------- parsing

(defn parse [(src (slice u8)) (path (slice u8))] (-> Ops)
  (let [(mut c) (t/cursor src path)
        (mut spec) (Ops :view "" :func-module "" :func-type "" :types (ArrayList::new [OpsType] (malloc-allocator))
                        :ops (ArrayList::new [Op] (malloc-allocator)))]
    (t/expect! (mut c) "ops")
    (t/expect! (mut c) "read")
    (t/expect! (mut c) "through")
    (let [(mut name) (t/name! (mut c) "the module that reads the IR")]
      (while (and (t/at? (mut c) ".") (.glued (t/peek (mut c))))
        (t/advance! (mut c))
        (set! name (t/cat3 name "." (t/name! (mut c) "a module name"))))
      (set! (.view spec) name))
    ; `functions are Func of native.cir`: the type a function of the IR is.
    (t/expect! (mut c) ",")
    (t/expect! (mut c) "functions")
    (t/expect! (mut c) "are")
    (set! (.func-type spec) (t/name! (mut c) "the type of a function"))
    (t/expect! (mut c) "of")
    (let [(mut name) (t/name! (mut c) "its module")]
      (while (and (t/at? (mut c) ".") (.glued (t/peek (mut c))))
        (t/advance! (mut c))
        (set! name (t/cat3 name "." (t/name! (mut c) "a module name"))))
      (set! (.func-module spec) name))
    (while (not (t/eof? (mut c)))
      (let [tok (t/advance! (mut c))]
        (cond
          (t/tok-is? tok "type")
            (let [name (t/name! (mut c) "a type name")]
              (t/expect! (mut c) "=")
              (let [number (cast i64 (t/num! (mut c) "the type's number"))
                    bits (if (t/accept! (mut c) ":") (cast i64 (t/num! (mut c) "the type's bits")) 0)
                    float (t/accept! (mut c) "float")]
                (push! (mut (.types spec)) (OpsType :name name :number number :bits bits :float float))))
          (t/tok-is? tok "op") (push! (mut (.ops spec)) (parse-op (mut c) spec tok))
          :else (t/die (mut c) tok (t/cat2 "expected type or op, found " (.text tok))))))
    spec))

(defn parse-op [(c (mut t/Cur)) (spec Ops) (at t/Tok)] (-> Op)
  (let [name (t/name! (mut c) "an operation name")
        number (cast i64 (t/num! (mut c) "the operation's number"))
        (mut op) (Op :name name :number number :operands (ArrayList::new [(slice u8)] (malloc-allocator))
                     :variadic false :imm "" :imm2 "" :aux "" :role "value" :meaning "" :line (.line at))]
    (when (>= (op-index spec name) 0) (t/die (mut c) at (t/cat2 "an operation said twice: " name)))
    (when (t/accept! (mut c) "(")
      (unless (t/at? (mut c) ")")
        (let [(mut more) true]
          (while more
            (push! (mut (.operands op)) (t/name! (mut c) "an operand name"))
            (when (t/accept! (mut c) "...") (set! (.variadic op) true))
            (set! more (and (not (.variadic op)) (t/accept! (mut c) ","))))))
      (t/expect! (mut c) ")"))
    (let [(mut going) true]
      (while going
        (cond
          (t/accept! (mut c) "imm") (set! (.imm op) (t/name! (mut c) "a name for imm"))
          (t/accept! (mut c) "imm2") (set! (.imm2 op) (t/name! (mut c) "a name for imm2"))
          (t/accept! (mut c) "aux") (set! (.aux op) (t/name! (mut c) "a name for aux"))
          (t/accept! (mut c) "role")
            (let [tok (t/peek (mut c))
                  role (t/name! (mut c) "a role")]
              (when (< (role-number role) 0) (t/die (mut c) tok (t/cat2 "no role named " role)))
              (set! (.role op) role))
          (t/accept! (mut c) "=") (do (set! (.meaning op) (meaning-expr (mut c) op 0)) (set! going false))
          :else (set! going false))))
    op))

;; ---------------------------------------------------------------- the module

(defn max-op [(spec Ops)] (-> i64)
  (let [(mut most) 0]
    (for op (.ops spec) (when (> (.number op) most) (set! most (.number op))))
    most))

(defn table [(spec Ops) (name (slice u8)) (kind i64) (otherwise (slice u8))]
  (-> (slice u8))
  (let [(mut o) (t/out-new)]
    (t/emit! (mut o) (t/cat3 "(def " name " ["))
    (for n (range 0 (+ (max-op spec) 1))
      (let [i (let [(mut found) -1]
                (for k (range 0 (len (.ops spec))) (when (= (.number (get (.ops spec) k)) n) (set! found k)))
                found)]
        (t/emit! (mut o) (t/cat2 " " (if (< i 0) otherwise (entry kind (get (.ops spec) i)))))))
    (t/line! (mut o) "])")
    (t/text-of (mut o))))

(defn entry [(kind i64) (op Op)] (-> (slice u8))
  (cond (= kind 0) (t/cat3 "\"" (.name op) "\"")
        (= kind 1) (t/int-text (role-number (.role op)))
        (.variadic op) "-1"
        :else (t/int-text (len (.operands op)))))

(defn module-text [(src (slice u8)) (path (slice u8))] (-> (slice u8))
  (let [spec (parse src path)
        (mut o) (t/out-new)]
    (t/line! (mut o) (t/cat3 "(depends-on \"" path "\")"))
    (t/line! (mut o) "(import \"coil.alloc\" :use [malloc-allocator])")
    (t/line! (mut o) "(import \"coil.arraylist\" :use [ArrayList])")
    (t/line! (mut o) "(import \"coil.primitive\" :as primitive)")
    (t/line! (mut o) "(import \"declarative.rt.bits\" :as bv)")
    (t/line! (mut o) "(import \"coil.cc\" :as cc)")
    (t/line! (mut o) (t/cat3 "(import \"" (.view spec) "\" :as view)"))
    (t/line! (mut o) (t/cat3 "(import \"" (.func-module spec) "\" :as ir)"))
    (for ty (.types spec)
      (t/line! (mut o) (t/cat4 "(const T-" (.name ty) " " (t/cat2 (t/int-text (.number ty)) ")"))))
    (for op (.ops spec)
      (t/line! (mut o) (t/cat4 "(const " (.name op) " " (t/cat2 (t/int-text (.number op)) ")"))))
    (for i (range 0 ROLE-COUNT)
      (t/line! (mut o) (t/cat4 "(const ROLE-" (t/upper (role-name i)) " " (t/cat2 (t/int-text i) ")"))))
    (t/emit! (mut o) (table spec "NAMES" 0 "\"\""))
    (t/emit! (mut o) (table spec "ROLES" 1 "-1"))
    (t/emit! (mut o) (table spec "ARITIES" 2 "-2"))
    (t/line! (mut o) (t/cat3 "(const OPS " (t/int-text (+ (max-op spec) 1)) ")"))
    (t/line! (mut o) "(defn name [(op i64)] (-> (slice u8)) (if (and (>= op 0) (< op OPS)) (get NAMES op) \"\"))")
    (t/line! (mut o) "(defn role :inline (Always) [(op i64)] (-> i64) (if (and (>= op 0) (< op OPS)) (get ROLES op) -1))")
    (t/line! (mut o) "(defn arity :inline (Always) [(op i64)] (-> i64) (if (and (>= op 0) (< op OPS)) (get ARITIES op) -2))")
    ; Each type's bits, and whether it is floating.
    (t/emit! (mut o) "(defn type-bits :inline (Always) [(ty i64)] (-> i64) (cond")
    (for ty (.types spec) (t/emit! (mut o) (t/cat4 " (= ty " (t/int-text (.number ty)) ") " (t/int-text (.bits ty)))))
    (t/line! (mut o) " :else 0))")
    (t/emit! (mut o) "(defn type-float? :inline (Always) [(ty i64)] (-> bool) (cond")
    (for ty (.types spec)
      (t/emit! (mut o) (t/cat4 " (= ty " (t/int-text (.number ty)) ") " (if (.float ty) "true" "false"))))
    (t/line! (mut o) " :else false))")
    (t/emit! (mut o) (interpreter-text spec))
    (t/text-of (mut o))))

;;; A `.numbers` file: `numbers of FILE` names an `.ops` file, from its own
;;; directory, and is the IR's own module of its types' and operations' numbers
;;; (T-I64, OP-ADD), so that the IR and everything that builds it number them as
;;; the `.ops` file says, which is said nowhere else.
(defn numbers-text [(src (slice u8)) (path (slice u8))] (-> (slice u8))
  (let [(mut c) (t/cursor src path)]
    (t/expect! (mut c) "numbers")
    (t/expect! (mut c) "of")
    (let [(mut file) (t/name! (mut c) "the .ops file")]
      (while (and (t/at? (mut c) ".") (.glued (t/peek (mut c))))
        (t/advance! (mut c))
        (set! file (t/cat3 file "." (t/name! (mut c) "the .ops file"))))
      (unless (t/eof? (mut c)) (t/die (mut c) (t/peek (mut c)) "expected nothing after `numbers of FILE`"))
      (let [ops-path (t/cat3 (t/directory path) "/" file)
            ops-src (match (fs/read-file (malloc-allocator) ops-path)
                      (Ok [bytes] bytes)
                      (Err [_] (t/fail-at path 1 1 (t/cat2 "cannot read " ops-path))))
            spec (parse ops-src ops-path)
            (mut o) (t/out-new)]
        (t/line! (mut o) (t/cat4 "(depends-on \"" path "\" \"" (t/cat2 ops-path "\")")))
        (for ty (.types spec)
          (t/line! (mut o) (t/cat4 "(const T-" (.name ty) " " (t/cat2 (t/int-text (.number ty)) ")"))))
        (for op (.ops spec)
          (t/line! (mut o) (t/cat4 "(const OP-" (.name op) " " (t/cat3 (t/int-text (.number op)) ")" (signature op)))))
        (t/text-of (mut o))))))

;;; What an operation takes, as a comment: `  ; (a, n) imm w`.
(defn signature [(op Op)] (-> (slice u8))
  (let [(mut o) (t/out-new)]
    (when (> (len (.operands op)) 0)
      (t/emit! (mut o) " (")
      (for k (range 0 (len (.operands op)))
        (when (> k 0) (t/emit! (mut o) ", "))
        (t/emit! (mut o) (get (.operands op) k)))
      (when (.variadic op) (t/emit! (mut o) "..."))
      (t/emit! (mut o) ")"))
    (unless (= (.imm op) "") (t/emit! (mut o) (t/cat2 " imm " (.imm op))))
    (unless (= (.imm2 op) "") (t/emit! (mut o) (t/cat2 " imm2 " (.imm2 op))))
    (unless (= (.aux op) "") (t/emit! (mut o) (t/cat2 " aux " (.aux op))))
    (unless (= (.role op) "value") (t/emit! (mut o) (t/cat2 " role " (.role op))))
    (let [text (t/text-of (mut o))]
      (if (= text "") "" (t/cat2 "  ;" text)))))

;;; The reference interpreter: values are 64-bit words; memory is the
;;; process's own, stack variables in a buffer of the run's.
(defn interpreter-text [(spec Ops)] (-> (slice u8))
  (let [(mut o) (t/out-new)]
    (t/line! (mut o) ";;; A run of the reference interpreter over one function.")
    (t/line! (mut o) (t/cat3 "(defstruct Run [(f (ptr ir/" (.func-type spec) ")) (words (ArrayList u64)) (done (ArrayList bool)) (args (slice u64))"))
    (t/line! (mut o) "                (symbols (slice u64)) (frame (ArrayList u8)) (objects (ArrayList i64)) (fuel i64)])")
    (t/line! (mut o) "(defn load-bytes [(a u64) (bytes u64) (signed u64)] (-> u64)")
    (t/line! (mut o) "  (let [p (primitive/cast (ptr u8) a) (mut v) (: 0 u64)]")
    (t/line! (mut o) "    (for i (range 0 (cast i64 bytes)) (set! v (| v (<< (cast u64 (primitive/load (primitive/index p i))) (cast u64 (* i 8))))))")
    (t/line! (mut o) "    (if (and (!= signed (: 0 u64)) (< bytes (: 8 u64))) (bv/sext v (cast i64 (* bytes (: 8 u64)))) v)))")
    (t/line! (mut o) "(defn store-bytes [(a u64) (v u64) (bytes u64)] (-> u64)")
    (t/line! (mut o) "  (let [p (primitive/cast (ptr u8) a)]")
    (t/line! (mut o) "    (for i (range 0 (cast i64 bytes)) (primitive/store! (primitive/index p i) (cast u8 (& (>> v (cast u64 (* i 8))) (: 255 u64)))))")
    (t/line! (mut o) "    (: 0 u64)))")
    (t/line! (mut o) ";;; `n` bytes from `src` to `dst`, overlapping or not; and `n` bytes set to `byte`.")
    (t/line! (mut o) "(defn copy-bytes [(dst u64) (src u64) (n u64)] (-> u64)")
    (t/line! (mut o) "  (let [d (primitive/cast (ptr u8) dst) s (primitive/cast (ptr u8) src) k (cast i64 n)]")
    (t/line! (mut o) "    (if (< dst src)")
    (t/line! (mut o) "        (for i (range 0 k) (primitive/store! (primitive/index d i) (primitive/load (primitive/index s i))))")
    (t/line! (mut o) "        (for j (range 0 k) (let [i (- (- k 1) j)] (primitive/store! (primitive/index d i) (primitive/load (primitive/index s i))))))")
    (t/line! (mut o) "    (: 0 u64)))")
    (t/line! (mut o) "(defn fill-bytes [(dst u64) (byte u64) (n u64)] (-> u64)")
    (t/line! (mut o) "  (let [d (primitive/cast (ptr u8) dst)]")
    (t/line! (mut o) "    (for i (range 0 (cast i64 n)) (primitive/store! (primitive/index d i) (cast u8 (& byte (: 255 u64)))))")
    (t/line! (mut o) "    (: 0 u64)))")
    (t/line! (mut o) ";;; A call: the function at `target` with up to twelve words, by the C convention.")
    (t/line! (mut o) "(defn call-words [(r (mut Run)) (v i64) (target u64) (first i64)] (-> u64)")
    (t/line! (mut o) "  (let [f (.f r) (mut a) (ArrayList::new [u64] (malloc-allocator))]")
    (t/line! (mut o) "    (for i (range first (view/nops f v)) (push! (mut a) (operand* (mut r) v i)))")
    (t/line! (mut o) "    (when (> (len a) 12) (panic \"the interpreter calls with twelve words at most\"))")
    (t/line! (mut o) "    (while (< (len a) 12) (push! (mut a) 0))")
    (t/line! (mut o) "    (let [g (primitive/cast (fnptr (cc/C) [u64 u64 u64 u64 u64 u64 u64 u64 u64 u64 u64 u64] u64) (primitive/cast (ptr i8) target))")
    (t/line! (mut o) "          answer (g (get a 0) (get a 1) (get a 2) (get a 3) (get a 4) (get a 5) (get a 6) (get a 7) (get a 8) (get a 9) (get a 10) (get a 11))]")
    (t/line! (mut o) "      (free! (mut a))")
    (t/line! (mut o) "      answer)))")
    (t/line! (mut o) "(defn callee [(r (mut Run)) (v i64)] (-> u64)")
    (t/line! (mut o) "  (let [f (.f r) s (view/imm f v)] (if (< s 0) (operand* (mut r) v 0) (get (.symbols r) s))))")
    (t/line! (mut o) "(defn operand-id [(r (mut Run)) (v i64) (i i64)] (-> i64) (view/operand (.f r) v i))")
    (t/line! (mut o) "(defn operand* [(r (mut Run)) (v i64) (i i64)] (-> u64) (word (mut r) (view/operand (.f r) v i)))")
    ; A value that is no instruction is made when it is read.
    (t/line! (mut o) ";;; The word value `x` holds: an instruction's as it was computed, or one that")
    (t/line! (mut o) ";;; is no instruction, made from what it is.")
    (t/line! (mut o) "(defn word [(r (mut Run)) (x i64)] (-> u64)")
    (t/line! (mut o) "  (if (get (.done r) x) (get (.words r) x)")
    (t/line! (mut o) "      (let [f (.f r) op (view/op f x) k (role op)]")
    (t/line! (mut o) "        (cond")
    (t/line! (mut o) "          (= k ROLE-CONST) (cast u64 (view/imm f x))")
    (t/line! (mut o) "          (= k ROLE-SYMBOL) (primitive/iadd (get (.symbols r) (view/imm f x)) (cast u64 (view/imm2 f x)))")
    (t/line! (mut o) "          (= k ROLE-PARAM) (get (.args r) (view/imm f x))")
    (t/line! (mut o) "          (= k ROLE-OBJECT) (object-address (mut r) x)")
    (t/line! (mut o) "          :else (panic \"the interpreter reads a value before it is computed\")))))")
    (t/line! (mut o) ";;; A stack variable's address: its own bytes in the run's frame, at a")
    (t/line! (mut o) ";;; multiple of 16 (its size in imm).")
    (t/line! (mut o) "(defn object-address [(r (mut Run)) (x i64)] (-> u64)")
    (t/line! (mut o) "  (when (< (get (.objects r) x) 0)")
    (t/line! (mut o) "    (let [at (* (/ (+ (len (.frame r)) 15) 16) 16)]")
    (t/line! (mut o) "      (when (> (+ at (view/imm (.f r) x)) (len (.frame r))) (panic \"the interpreter's frame is full\"))")
    (t/line! (mut o) "      (set! (mut (.objects r)) x at)))")
    (t/line! (mut o) "  (primitive/cast u64 (primitive/index (primitive/cast (ptr u8) (.data (.frame r))) (get (.objects r) x))))")
    ; The meanings.
    (t/line! (mut o) ";;; What instruction `v` computes.")
    (t/line! (mut o) "(defn compute [(r (mut Run)) (v i64)] (-> u64)")
    (t/line! (mut o) "  (let [f (.f r) op (view/op f v) imm* (cast u64 (view/imm f v)) imm2* (cast u64 (view/imm2 f v))")
    (t/line! (mut o) "        aux* (cast u64 (view/aux f v)) width* (type-bits (view/ty f v))]")
    (t/emit! (mut o) "    (cond")
    (for op (.ops spec)
      (when (!= (.meaning op) "")
        (t/line! (mut o) (t/cat4 "      (= op " (t/int-text (.number op)) ") " (.meaning op)))))
    (t/line! (mut o) "      :else (panic \"the interpreter has no meaning for an operation\"))))")
    ; Running: blocks, phis, branches.
    (t/line! (mut o) ";;; Runs `f` on `args` until it returns (its first value) or `fuel` instructions")
    (t/line! (mut o) ";;; have run (None). `symbols` is the address of each symbol.")
    (t/line! (mut o) (t/cat3 "(defn interpret [(f (ptr ir/" (.func-type spec) ")) (args (slice u64)) (symbols (slice u64)) (fuel i64)] (-> (Option u64))"))
    (t/line! (mut o) "  (let [n (view/value-count f)")
    (t/line! (mut o) "        (mut r) (Run :f f :words (ArrayList::new [u64] (malloc-allocator)) :done (ArrayList::new [bool] (malloc-allocator))")
    (t/line! (mut o) "                    :args args :symbols symbols :frame (ArrayList::new [u8] (malloc-allocator))")
    (t/line! (mut o) "                    :objects (ArrayList::new [i64] (malloc-allocator)) :fuel fuel)")
    (t/line! (mut o) "        (mut phis) (ArrayList::new [u64] (malloc-allocator))")
    (t/line! (mut o) "        (mut block) 0 (mut from) -1 (mut result) (None [u64]) (mut going) true]")
    (t/line! (mut o) "    (for _ (range 0 n) (push! (mut (.words r)) 0) (push! (mut (.done r)) false) (push! (mut (.objects r)) -1))")
    (t/line! (mut o) "    (extend-zeroed! (mut (.frame r)) 65536)")
    (t/line! (mut o) "    (while going")
    ; Phis take their values all at once, from the block control came from.
    (t/line! (mut o) "      (clear! (mut phis))")
    (t/line! (mut o) "      (for i (range 0 (view/phi-count f block))")
    (t/line! (mut o) "        (push! (mut phis) (word (mut r) (view/incoming f (view/phi f block i) from))))")
    (t/line! (mut o) "      (for i (range 0 (view/phi-count f block))")
    (t/line! (mut o) "        (let [p (view/phi f block i)] (set! (mut (.words r)) p (get phis i)) (set! (mut (.done r)) p true)))")
    (t/line! (mut o) "      (let [(mut next) -1]")
    (t/line! (mut o) "        (for k (range (view/block-first f block) (view/block-end f block))")
    (t/line! (mut o) "          (let [v (view/inst f k) role* (role (view/op f v))]")
    (t/line! (mut o) "            (set! (.fuel r) (- (.fuel r) 1))")
    (t/line! (mut o) "            (when (< (.fuel r) 0) (set! going false))")
    (t/line! (mut o) "            (when going")
    (t/line! (mut o) "              (cond")
    (t/line! (mut o) "                (= role* ROLE-JUMP) (set! next (view/target f v 0))")
    (t/line! (mut o) "                (= role* ROLE-BRANCH) (set! next (view/target f v (cast i64 (compute (mut r) v))))")
    (t/line! (mut o) "                (= role* ROLE-SWITCH)")
    (t/line! (mut o) "                  (let [x (operand* (mut r) v 0) (mut to) (view/target f v 0)]")
    (t/line! (mut o) "                    (for c (range 0 (view/case-count f v)) (when (= (view/case-value f v c) x) (set! to (view/target f v (+ c 1)))))")
    (t/line! (mut o) "                    (set! next to))")
    (t/line! (mut o) "                (= role* ROLE-RETURN)")
    (t/line! (mut o) "                  (do (set! result (Some (if (> (view/nops f v) 0) (operand* (mut r) v 0) (: 0 u64)))) (set! going false))")
    (t/line! (mut o) "                (= role* ROLE-TRAP) (set! going false)")
    (t/line! (mut o) "                (= role* ROLE-CALL)")
    (t/line! (mut o) "                  (do (when (> (view/aux f v) 1) (panic \"the interpreter's calls give one result\"))")
    (t/line! (mut o) "                      (set! (mut (.words r)) v (call-words (mut r) v (callee (mut r) v) (if (< (view/imm f v) 0) 1 0)))")
    (t/line! (mut o) "                      (set! (mut (.done r)) v true))")
    (t/line! (mut o) "                (= role* ROLE-TAILCALL)")
    (t/line! (mut o) "                  (do (set! result (Some (call-words (mut r) v (callee (mut r) v) (if (< (view/imm f v) 0) 1 0)))) (set! going false))")
    (t/line! (mut o) "                :else (do (set! (mut (.words r)) v (compute (mut r) v)) (set! (mut (.done r)) v true))))))")
    (t/line! (mut o) "        (when (and going (< next 0)) (panic \"a block ends in nothing that leaves it\"))")
    (t/line! (mut o) "        (set! from block)")
    (t/line! (mut o) "        (set! block next)))")
    (t/line! (mut o) "    (free! (mut (.words r))) (free! (mut (.done r))) (free! (mut (.frame r))) (free! (mut (.objects r))) (free! (mut phis))")
    (t/line! (mut o) "    result))")
    (t/text-of (mut o))))
