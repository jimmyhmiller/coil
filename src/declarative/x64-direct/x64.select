# Which x86-64 instructions compute each CIR operation, for the compile that
# goes straight from CIR. Every integer is a whole 64-bit word. Most of the
# machine's instructions change their first operand, so a result starts as a
# copy of the value it is computed from: a rule of more than one instruction
# is given a register none of its operands is in, so the copy loses nothing.
# Registers a rule names (rax, rcx, rdx) are emptied of other values first.
select in unit
ops declarative.cir.ops
target declarative.x64.target
templates lower
registers regs
emit mach

# Made where they are read: a constant, a symbol's address, a stack variable's.
rule CONST k when float and k == 0        => xorf(out, out)
rule CONST k when float and width == 32   => mov-imm32(r11, k & 4294967295) ; bits-to-float(0, out, r11)
rule CONST k when float and width == 64   => mov-imm64(r11, k) ; bits-to-float(1, out, r11)
rule CONST k when width == 64             => constant(out, k)
rule SYM as s when outside(s)             => mov-got(out, symbol) ; address(out, out, addend)
rule SYM                                  => lea-symbol(out, symbol) ; address(out, out, addend)
rule ALLOCA as o when align <= 16         => lea(out, rbp, 0 - object(o))
# One aligned to more than the frame is: room for it and its alignment, and
# its address the first place in that room that will do.
rule ALLOCA as o                          => lea(out, rbp, 0 - object(o)) ; add-imm(1, out, align - 1) ; and-imm(1, out, 0 - align)

# 128-bit integers: the low half in a register as a word is, the high half
# in another (`hi`). Sums and differences carry from the low halves into the
# high; a product is the low halves' full product and the cross terms.
rule CONST k when width == 128 and not float => constant(out, k) ; constant(hi(out), high)
rule ADD(x, y) when width == 128 and not float => move(out, x) ; move(hi(out), hi(x)) ; add(1, out, y) ; adc(1, hi(out), hi(y))
rule SUB(x, y) when width == 128 and not float => move(out, x) ; move(hi(out), hi(x)) ; sub(1, out, y) ; sbb(1, hi(out), hi(y))
rule NEG(x) when width == 128 and not float => move(out, x) ; move(hi(out), hi(x)) ; neg(1, out) ; mov-imm32($z, 0) ; adc(1, hi(out), $z) ; neg(1, hi(out))
rule AND(x, y) when width == 128 and not float => move(out, x) ; and(1, out, y) ; move(hi(out), hi(x)) ; and(1, hi(out), hi(y))
rule OR(x, y) when width == 128 and not float => move(out, x) ; or(1, out, y) ; move(hi(out), hi(x)) ; or(1, hi(out), hi(y))
rule XOR(x, y) when width == 128 and not float => move(out, x) ; xor(1, out, y) ; move(hi(out), hi(x)) ; xor(1, hi(out), hi(y))
rule NOT(x) when width == 128 and not float => move(out, x) ; not(1, out) ; move(hi(out), hi(x)) ; not(1, hi(out))
rule MUL(x, y) when width == 128 and not float => move(rax, x) ; mul-wide(1, y) ; move(out, x) ; imul(1, out, hi(y)) ; add(1, rdx, out) ; move(out, hi(x)) ; imul(1, out, y) ; add(1, rdx, out) ; move(out, rax) ; move(hi(out), rdx)
# Shifts by the count modulo 128: below 64 the halves trade the bits that
# cross between them; from 64 one half moves into the other.
rule SHL(x, n) when width == 128 and not float => move(rcx, n) ; move(out, x) ; shl-cl(1, out) ; move(hi(out), hi(x)) ; shl-cl(1, hi(out)) ; move($p, x) ; shr-imm(1, $p, 1) ; not(1, rcx) ; shr-cl(1, $p) ; or(1, hi(out), $p) ; move(rcx, n) ; and-imm(1, rcx, 64) ; cmov(1, not-equal, hi(out), out) ; mov-imm32($p, 0) ; cmov(1, not-equal, out, $p)
rule LSHR(x, n) when width == 128 and not float => move(rcx, n) ; move(hi(out), hi(x)) ; shr-cl(1, hi(out)) ; move(out, x) ; shr-cl(1, out) ; move($p, hi(x)) ; add(1, $p, $p) ; not(1, rcx) ; shl-cl(1, $p) ; or(1, out, $p) ; move(rcx, n) ; and-imm(1, rcx, 64) ; cmov(1, not-equal, out, hi(out)) ; mov-imm32($p, 0) ; cmov(1, not-equal, hi(out), $p)
rule ASHR(x, n) when width == 128 and not float => move(rcx, n) ; move(hi(out), hi(x)) ; sar-cl(1, hi(out)) ; move(out, x) ; shr-cl(1, out) ; move($p, hi(x)) ; add(1, $p, $p) ; not(1, rcx) ; shl-cl(1, $p) ; or(1, out, $p) ; move($p, hi(x)) ; sar-imm(1, $p, 63) ; move(rcx, n) ; and-imm(1, rcx, 64) ; cmov(1, not-equal, out, hi(out)) ; cmov(1, not-equal, hi(out), $p)
# Comparing: equal when both halves are; less by a subtraction through both,
# which leaves the flags of the whole; one that wants `b < a` subtracts the
# other way.
rule ICMP(a, b) when bits(a) == 128 and not float(a) and predicate < 2 => move($l, a) ; xor(1, $l, b) ; move($h, hi(a)) ; xor(1, $h, hi(b)) ; or(1, $l, $h) ; setcc(cases(predicate, equal, not-equal), out) ; movzx8(out, out)
rule ICMP(a, b) when bits(a) == 128 and not float(a) and (predicate == 2 or predicate == 5 or predicate == 6 or predicate == 9) => move($t, hi(a)) ; cmp(1, a, b) ; sbb(1, $t, hi(b)) ; setcc(cases(predicate, equal, equal, less, equal, equal, greater-equal, below, equal, equal, above-equal), out) ; movzx8(out, out)
rule ICMP(a, b) when bits(a) == 128 and not float(a) => move($t, hi(b)) ; cmp(1, b, a) ; sbb(1, $t, hi(a)) ; setcc(cases(predicate, equal, equal, equal, greater-equal, less, equal, equal, above-equal, below, equal), out) ; movzx8(out, out)
rule SELECT(c, x, y) when width == 128 and not float => move(out, y) ; move(hi(out), hi(y)) ; test(1, c, c) ; cmov(1, not-equal, out, x) ; cmov(1, not-equal, hi(out), hi(x))
# Into and out of 128 bits.
rule SEXT(x) when width == 128 and not float => move(out, x) ; shl-imm(1, out, 64 - bits) ; sar-imm(1, out, 64 - bits) ; move(hi(out), out) ; sar-imm(1, hi(out), 63)
rule ZEXT(x) when width == 128 and not float => move(out, x) ; shl-imm(1, out, 64 - bits) ; shr-imm(1, out, 64 - bits) ; mov-imm32(hi(out), 0)
rule LO(x)                                => move(out, x)
rule HI(x)                                => move(out, hi(x))
rule PAIR(a, b)                           => move(out, a) ; move(hi(out), b)
rule COPY(x) when width == 128 and not float => move(out, x) ; move(hi(out), hi(x))
rule LOAD(p) when width == 128 and not float => load-word(out, p, offset, 8, 0) ; load-word(hi(out), p, offset + 8, 8, 0)
rule STORE(p, v) when bits(v) == 128 and not float(v) => store-word(v, p, offset, 8) ; store-word(hi(v), p, offset + 8, 8)

# Words.
rule ADD(x, CONST k) when s32(k)          => lea(out, x, k)
rule ADD(CONST k, x) when s32(k)          => lea(out, x, k)
rule ADD(x, once SHL(y, CONST k)) when k >= 1 and k <= 3 => lea-indexed(out, x, y, k, 0)
rule ADD(x, y)                            => lea-indexed(out, x, y, 0, 0)
rule SUB(x, CONST k) when s32(0 - k)      => lea(out, x, 0 - k)
rule SUB(x, y)                            => move(out, x) ; sub(1, out, y)
rule MUL(x, y)                            => move(out, x) ; imul(1, out, y)
rule AND(x, CONST k) when k == 4294967295 => mov(0, out, x)
rule AND(x, CONST k) when k == 65535      => movzx16(out, x)
rule AND(x, CONST k) when k == 255        => movzx8(out, x)
rule AND(x, CONST k) when s32(k)          => move(out, x) ; and-imm(1, out, k)
rule AND(x, y)                            => move(out, x) ; and(1, out, y)
rule OR(x, CONST k) when s32(k)           => move(out, x) ; or-imm(1, out, k)
rule OR(x, y)                             => move(out, x) ; or(1, out, y)
rule XOR(x, CONST k) when s32(k)          => move(out, x) ; xor-imm(1, out, k)
rule XOR(x, y)                            => move(out, x) ; xor(1, out, y)
# Shifts count modulo 64, as CIR does and the machine does.
rule SHL(x, CONST k)                      => move(out, x) ; shl-imm(1, out, k & 63)
rule SHL(x, n)                            => move(out, x) ; move(rcx, n) ; shl-cl(1, out)
rule LSHR(x, CONST k)                     => move(out, x) ; shr-imm(1, out, k & 63)
rule LSHR(x, n)                           => move(out, x) ; move(rcx, n) ; shr-cl(1, out)
rule ASHR(x, CONST k)                     => move(out, x) ; sar-imm(1, out, k & 63)
rule ASHR(x, n)                           => move(out, x) ; move(rcx, n) ; sar-cl(1, out)
# Division goes through rax and rdx, and traps where CIR's does not: by zero
# the quotient is 0 and the remainder the dividend; by -1 (signed) the
# quotient is the negation and the remainder 0. Such a divisor is replaced by
# 1, and the answer chosen after.
rule UDIV(x, y)                           => test(1, y, y) ; setcc(equal, $d) ; movzx8($d, $d) ; add(1, $d, y) ; move(rax, x) ; mov-imm32(rdx, 0) ; div(1, $d) ; mov-imm32($d, 0) ; test(1, y, y) ; cmov(1, equal, rax, $d) ; move(out, rax)
rule UREM(x, y)                           => test(1, y, y) ; setcc(equal, $d) ; movzx8($d, $d) ; add(1, $d, y) ; move(rax, x) ; mov-imm32(rdx, 0) ; div(1, $d) ; test(1, y, y) ; cmov(1, equal, rdx, x) ; move(out, rdx)
rule SDIV(x, y)                           => move($d, y) ; lea($p, y, 1) ; cmp-imm(1, $p, 1) ; mov-imm32($p, 1) ; cmov(1, below-equal, $d, $p) ; move(rax, x) ; sign-extend-rax(1) ; idiv(1, $d) ; move($p, x) ; neg(1, $p) ; cmp-imm(1, y, -1) ; cmov(1, equal, rax, $p) ; mov-imm32($p, 0) ; test(1, y, y) ; cmov(1, equal, rax, $p) ; move(out, rax)
rule SREM(x, y)                           => move($d, y) ; lea($p, y, 1) ; cmp-imm(1, $p, 1) ; mov-imm32($p, 1) ; cmov(1, below-equal, $d, $p) ; move(rax, x) ; sign-extend-rax(1) ; idiv(1, $d) ; test(1, y, y) ; cmov(1, equal, rdx, x) ; move(out, rdx)
# Rotations of a whole word, or of 32 bits, are the machine's; a narrower one
# shifts the low `w` bits both ways by the count modulo `w` (a mask for 8 or
# 16, else a division) and puts the two together.
rule ROTL(x, n) when w == 64              => move(out, x) ; move(rcx, n) ; rol-cl(1, out)
rule ROTL(x, n) when w == 32              => move(out, x) ; move(rcx, n) ; rol-cl(0, out)
rule ROTR(x, n) when w == 64              => move(out, x) ; move(rcx, n) ; ror-cl(1, out)
rule ROTR(x, n) when w == 32              => move(out, x) ; move(rcx, n) ; ror-cl(0, out)
rule ROTL(x, n) when w == 8 or w == 16    => move($a, x) ; and-imm(1, $a, (1 << w) - 1) ; move(rcx, n) ; and-imm(0, rcx, w - 1) ; move(out, $a) ; shl-cl(1, out) ; neg(0, rcx) ; add-imm(0, rcx, w) ; shr-cl(1, $a) ; or(1, out, $a) ; and-imm(1, out, (1 << w) - 1)
rule ROTR(x, n) when w == 8 or w == 16    => move($a, x) ; and-imm(1, $a, (1 << w) - 1) ; move(rcx, n) ; and-imm(0, rcx, w - 1) ; move(out, $a) ; shr-cl(1, out) ; neg(0, rcx) ; add-imm(0, rcx, w) ; shl-cl(1, $a) ; or(1, out, $a) ; and-imm(1, out, (1 << w) - 1)
rule ROTL(x, n) when w > 0 and w < 64     => move(rax, n) ; mov-imm32(rdx, 0) ; mov-imm32(rcx, w) ; div(1, rcx) ; move(rcx, rdx) ; mov-imm64($k, (1 << w) - 1) ; move($a, x) ; and(1, $a, $k) ; move(out, $a) ; shl-cl(1, out) ; neg(0, rcx) ; add-imm(0, rcx, w) ; shr-cl(1, $a) ; or(1, out, $a) ; and(1, out, $k)
rule ROTR(x, n) when w > 0 and w < 64     => move(rax, n) ; mov-imm32(rdx, 0) ; mov-imm32(rcx, w) ; div(1, rcx) ; move(rcx, rdx) ; mov-imm64($k, (1 << w) - 1) ; move($a, x) ; and(1, $a, $k) ; move(out, $a) ; shr-cl(1, out) ; neg(0, rcx) ; add-imm(0, rcx, w) ; shl-cl(1, $a) ; or(1, out, $a) ; and(1, out, $k)
rule NEG(x)                               => move(out, x) ; neg(1, out)
rule NOT(x)                               => move(out, x) ; not(1, out)
rule SMULH(x, y)                          => move(rax, x) ; imul-wide(1, y) ; move(out, rdx)
rule UMULH(x, y)                          => move(rax, x) ; mul-wide(1, y) ; move(out, rdx)
rule SEXT(x) when bits == 64              => move(out, x)
rule SEXT(x) when bits == 32              => movsx32(out, x)
rule SEXT(x) when bits == 16              => movsx16(1, out, x)
rule SEXT(x) when bits == 8               => movsx8(1, out, x)
rule SEXT(x)                              => move(out, x) ; shl-imm(1, out, 64 - bits) ; sar-imm(1, out, 64 - bits)
rule ZEXT(x) when bits == 64              => move(out, x)
rule ZEXT(x) when bits == 32              => mov(0, out, x)
rule ZEXT(x) when bits == 16              => movzx16(out, x)
rule ZEXT(x) when bits == 8               => movzx8(out, x)
rule ZEXT(x)                              => move(out, x) ; shl-imm(1, out, 64 - bits) ; shr-imm(1, out, 64 - bits)
rule COPY(x) when float                   => move-float(out, x)
rule COPY(x)                              => move(out, x)

# Bits of the low `w`. Leading zeros are counted in 64 and the extra taken
# off; trailing zeros with a bit set just above the value.
rule CLZ(x) when w == 64                  => lzcnt(1, out, x)
rule CLZ(x) when w == 32                  => lzcnt(0, out, x)
rule CLZ(x)                               => mov-imm64($k, (1 << w) - 1) ; move($z, x) ; and(1, $z, $k) ; lzcnt(1, out, $z) ; sub-imm(1, out, 64 - w)
rule CTZ(x) when w == 64                  => tzcnt(1, out, x)
rule CTZ(x)                               => mov-imm64($k, 1 << w) ; move($t, x) ; or(1, $t, $k) ; tzcnt(1, out, $t)
rule POPCNT(x) when w == 64               => popcnt(1, out, x)
rule POPCNT(x)                            => mov-imm64($k, (1 << w) - 1) ; move($z, x) ; and(1, $z, $k) ; popcnt(1, out, $z)
rule BSWAP(x) when w == 64                => move(out, x) ; bswap(1, out)
rule BSWAP(x)                             => move(out, x) ; bswap(1, out) ; shr-imm(1, out, 64 - w)
# The bits in the opposite order: the bytes, then within each byte the halves,
# within each half the pairs, and within each pair the bits.
rule BITREV(x) when w == 64               => move(out, x) ; bswap(1, out) ; swap-fields-in(1, out, 1085102592571150095, 4, $m, $t) ; swap-fields-in(1, out, 3689348814741910323, 2, $m, $t) ; swap-fields-in(1, out, 6148914691236517205, 1, $m, $t)
rule BITREV(x)                            => move(out, x) ; bswap(1, out) ; swap-fields-in(1, out, 1085102592571150095, 4, $m, $t) ; swap-fields-in(1, out, 3689348814741910323, 2, $m, $t) ; swap-fields-in(1, out, 6148914691236517205, 1, $m, $t) ; shr-imm(1, out, 64 - w)

# Comparing: 1 when it holds, else 0.
rule ICMP(a, CONST k) when bits(a) == 64 and s32(k) => cmp-imm(1, a, k) ; setcc(cases(predicate, equal, not-equal, less, less-equal, greater, greater-equal, below, below-equal, above, above-equal), out) ; movzx8(out, out)
rule ICMP(a, b) when bits(a) == 64        => cmp(1, a, b) ; setcc(cases(predicate, equal, not-equal, less, less-equal, greater, greater-equal, below, below-equal, above, above-equal), out) ; movzx8(out, out)
rule SELECT(once ICMP(a, CONST k) as t, x, y) when bits(a) == 64 and s32(k) and not float and width == 64 => move(out, y) ; cmp-imm(1, a, k) ; cmov(1, cases(t.predicate, equal, not-equal, less, less-equal, greater, greater-equal, below, below-equal, above, above-equal), out, x)
rule SELECT(once ICMP(a, b) as t, x, y) when bits(a) == 64 and not float and width == 64 => move(out, y) ; cmp(1, a, b) ; cmov(1, cases(t.predicate, equal, not-equal, less, less-equal, greater, greater-equal, below, below-equal, above, above-equal), out, x)
# One of two floating values: chosen as bits, in integer registers.
rule SELECT(c, x, y) when float and width <= 64 => float-to-bits(sf, $a, x) ; float-to-bits(sf, $b, y) ; test(1, c, c) ; cmov(1, equal, $a, $b) ; bits-to-float(sf, out, $a)
rule SELECT(c, x, y)                      => move(out, y) ; test(1, c, c) ; cmov(1, not-equal, out, x)

# Whether an operation of `w` bits overflowed: 64 bits by the flag the
# machine leaves; fewer by whether the 64-bit answer is what its low `w` bits
# say it is.
rule ADDO(a, b) when w == 64 and signed != 0 => move($t, a) ; add(1, $t, b) ; setcc(overflow, out) ; movzx8(out, out)
rule ADDO(a, b) when w == 64              => move($t, a) ; add(1, $t, b) ; setcc(below, out) ; movzx8(out, out)
rule SUBO(a, b) when w == 64 and signed != 0 => move($t, a) ; sub(1, $t, b) ; setcc(overflow, out) ; movzx8(out, out)
rule SUBO(a, b) when w == 64              => cmp(1, a, b) ; setcc(below, out) ; movzx8(out, out)
rule MULO(a, b) when w == 64 and signed != 0 => move($t, a) ; imul(1, $t, b) ; setcc(overflow, out) ; movzx8(out, out)
rule MULO(a, b) when w == 64              => move(rax, a) ; mul-wide(1, b) ; setcc(overflow, out) ; movzx8(out, out)
rule ADDO(a, b) when signed != 0          => move($t, a) ; add(1, $t, b) ; move($e, $t) ; shl-imm(1, $e, 64 - w) ; sar-imm(1, $e, 64 - w) ; cmp(1, $t, $e) ; setcc(not-equal, out) ; movzx8(out, out)
rule ADDO(a, b)                           => move($t, a) ; add(1, $t, b) ; move($e, $t) ; shl-imm(1, $e, 64 - w) ; shr-imm(1, $e, 64 - w) ; cmp(1, $t, $e) ; setcc(not-equal, out) ; movzx8(out, out)
rule SUBO(a, b) when signed != 0          => move($t, a) ; sub(1, $t, b) ; move($e, $t) ; shl-imm(1, $e, 64 - w) ; sar-imm(1, $e, 64 - w) ; cmp(1, $t, $e) ; setcc(not-equal, out) ; movzx8(out, out)
rule SUBO(a, b)                           => move($t, a) ; sub(1, $t, b) ; move($e, $t) ; shl-imm(1, $e, 64 - w) ; shr-imm(1, $e, 64 - w) ; cmp(1, $t, $e) ; setcc(not-equal, out) ; movzx8(out, out)
rule MULO(a, b) when signed != 0          => move($t, a) ; imul(1, $t, b) ; move($e, $t) ; shl-imm(1, $e, 64 - w) ; sar-imm(1, $e, 64 - w) ; cmp(1, $t, $e) ; setcc(not-equal, out) ; movzx8(out, out)
rule MULO(a, b)                           => move($t, a) ; imul(1, $t, b) ; move($e, $t) ; shl-imm(1, $e, 64 - w) ; shr-imm(1, $e, 64 - w) ; cmp(1, $t, $e) ; setcc(not-equal, out) ; movzx8(out, out)

# Floating point: the result starts as a copy of the first operand.
rule FADD(x, y)                           => move-float(out, x) ; addf(sf, out, y)
rule FSUB(x, y)                           => move-float(out, x) ; subf(sf, out, y)
rule FMUL(x, y)                           => move-float(out, x) ; mulf(sf, out, y)
rule FDIV(x, y)                           => move-float(out, x) ; divf(sf, out, y)
rule FSQRT(x)                             => sqrtf(sf, out, x)
# The sign is one bit: flipped for the negative, cleared for the absolute value.
rule FNEG(x) when width == 64             => mov-imm64(r11, 0 - 9223372036854775807 - 1) ; bits-to-float(1, $v, r11) ; move-float(out, x) ; xorf(out, $v)
rule FNEG(x)                              => mov-imm32(r11, 2147483648) ; bits-to-float(0, $v, r11) ; move-float(out, x) ; xorf(out, $v)
rule FABS(x) when width == 64             => mov-imm64(r11, 9223372036854775807) ; bits-to-float(1, $v, r11) ; move-float(out, x) ; andf(out, $v)
rule FABS(x)                              => mov-imm32(r11, 2147483647) ; bits-to-float(0, $v, r11) ; move-float(out, x) ; andf(out, $v)
# The machine's smaller and larger give their second operand when the two are
# equal or either is not a number. Asked both ways round and put together, the
# answers are right for zeros of either sign; the smaller is then still not a
# number when it should be, and the larger is made so. With one value that is
# not a number, the other (the NM kinds): each way's answer is dropped where
# its second operand was not a number.
rule FMIN(x, y)                           => move-float($a, x) ; minf(sf, $a, y) ; move-float(out, y) ; minf(sf, out, x) ; orf(out, $a)
rule FMAX(x, y)                           => move-float($a, x) ; maxf(sf, $a, y) ; move-float($b, y) ; maxf(sf, $b, x) ; andf($a, $b) ; move-float(out, x) ; unordered(sf, out, y) ; orf(out, $a)
rule FMINNM(x, y)                         => move-float($a, y) ; minf(sf, $a, x) ; move-float($b, x) ; minf(sf, $b, y) ; move-float($nx, x) ; unordered(sf, $nx, x) ; move-float($ny, y) ; unordered(sf, $ny, y) ; move-float(out, $nx) ; andf(out, $ny) ; andnotf($nx, $a) ; andnotf($ny, $b) ; orf(out, $nx) ; orf(out, $ny)
rule FMAXNM(x, y)                         => move-float($a, y) ; maxf(sf, $a, x) ; move-float($b, x) ; maxf(sf, $b, y) ; move-float($nx, x) ; unordered(sf, $nx, x) ; move-float($ny, y) ; unordered(sf, $ny, y) ; orf($a, $nx) ; orf($b, $ny) ; move-float(out, $a) ; andf(out, $b)
# Rounding: to even, up, down, toward zero as the machine does; away from
# zero, toward zero after adding the value just below a half with the sign of
# the value itself.
rule FRINT(x) when mode == 0              => roundf(sf, 0, out, x)
rule FRINT(x) when mode == 1              => roundf(sf, 2, out, x)
rule FRINT(x) when mode == 2              => roundf(sf, 1, out, x)
rule FRINT(x) when mode == 3              => roundf(sf, 3, out, x)
rule FRINT(x) when width == 64            => mov-imm64($s, 0 - 9223372036854775807 - 1) ; bits-to-float(1, $sign, $s) ; andf($sign, x) ; mov-imm64($h, 4602678819172646911) ; bits-to-float(1, $half, $h) ; orf($half, $sign) ; addf(1, $half, x) ; roundf(1, 3, out, $half)
rule FRINT(x)                             => mov-imm32($s, 2147483648) ; bits-to-float(0, $sign, $s) ; andf($sign, x) ; mov-imm32($h, 1056964607) ; bits-to-float(0, $half, $h) ; orf($half, $sign) ; addf(0, $half, x) ; roundf(0, 3, out, $half)
rule FMA(x, y, z)                         => move-float(out, x) ; fma(sf, out, y, z)
rule FPEXT(x)                             => single-to-double(out, x)
rule FPTRUNC(x)                           => double-to-single(out, x)
rule SITOFP(x)                            => int-to-float(1, sf, out, x)
# An unsigned word with its top bit set is halved, keeping the bit that falls
# off for the rounding, converted and doubled.
rule UITOFP(x)                            => move($h, x) ; shr-imm(1, $h, 1) ; move($l, x) ; and-imm(1, $l, 1) ; or(1, $h, $l) ; int-to-float(1, sf, $half, $h) ; move-float($twice, $half) ; addf(sf, $twice, $half) ; int-to-float(1, sf, $plain, x) ; float-to-bits(sf, $a, $plain) ; float-to-bits(sf, $b, $twice) ; test(1, x, x) ; cmov(1, sign, $a, $b) ; bits-to-float(sf, out, $a)
# To an integer: the machine's answer for what does not fit or is not a number
# is the smallest integer; what was too large becomes the largest, and what was
# not a number 0.
rule FPTOSI(x) when bits == 64            => float-to-int(1, sf(x), $r, x) ; mov-imm64($m, 9223372036854775807) ; int-to-float(1, sf(x), $edge, $m) ; cmpf(sf(x), x, $edge) ; cmov(1, above-equal, $r, $m) ; mov-imm32($z, 0) ; cmpf(sf(x), x, x) ; cmov(1, parity, $r, $z) ; move(out, $r)
rule FPTOSI(x)                            => float-to-int(1, sf(x), $r, x) ; mov-imm64($m, 2147483647) ; mov-simm32($n, 0 - 2147483648) ; cmp(1, $r, $m) ; cmov(1, greater, $r, $m) ; cmp(1, $r, $n) ; cmov(1, less, $r, $n) ; int-to-float(1, sf(x), $edge, $m) ; cmpf(sf(x), x, $edge) ; cmov(1, above-equal, $r, $m) ; mov-imm32($z, 0) ; cmpf(sf(x), x, x) ; cmov(1, parity, $r, $z) ; move(out, $r)
rule FPTOUI(x) when bits == 32            => float-to-int(1, sf(x), $r, x) ; mov-imm32($z, 0) ; cmp(1, $r, $z) ; cmov(1, less, $r, $z) ; mov-imm32($m, 4294967295) ; cmp(1, $r, $m) ; cmov(1, greater, $r, $m) ; mov-imm64($big, 4294967296) ; int-to-float(1, sf(x), $edge, $big) ; cmpf(sf(x), x, $edge) ; cmov(1, above-equal, $r, $m) ; cmpf(sf(x), x, x) ; cmov(1, parity, $r, $z) ; move(out, $r)
rule FPTOUI(x)                            => float-to-int(1, sf(x), $low, x) ; mov-imm64($top, 0 - 9223372036854775807 - 1) ; mov-imm64($m, 9223372036854775807) ; int-to-float(1, sf(x), $edge, $m) ; move-float($y, x) ; subf(sf(x), $y, $edge) ; float-to-int(1, sf(x), $high, $y) ; xor(1, $high, $top) ; cmpf(sf(x), x, $edge) ; cmov(1, above-equal, $low, $high) ; move-float($d, $edge) ; addf(sf(x), $d, $edge) ; mov-simm32($all, 0 - 1) ; cmpf(sf(x), x, $d) ; cmov(1, above-equal, $low, $all) ; mov-imm32($z, 0) ; bits-to-float(1, $fz, $z) ; cmpf(sf(x), x, $fz) ; cmov(1, below, $low, $z) ; move(out, $low)
rule BITCAST(x) when float and float(x)   => move-float(out, x)
rule BITCAST(x) when float                => bits-to-float(sf, out, x)
rule BITCAST(x) when float(x)             => float-to-bits(sf(x), out, x)
rule BITCAST(x)                           => move(out, x)
# Comparing floating values, as the flags of an unordered comparison leave
# them: not a number sets all of zero, parity and carry. A less-than is asked
# the other way round, so that "not a number" reads as false.
rule FCMP(a, b) when predicate == 0       => cmpf(sf(a), a, b) ; setcc(no-parity, $p) ; setcc(equal, out) ; and(0, out, $p) ; movzx8(out, out)
rule FCMP(a, b) when predicate == 1       => cmpf(sf(a), a, b) ; setcc(not-equal, out) ; movzx8(out, out)
rule FCMP(a, b) when predicate == 2       => cmpf(sf(a), b, a) ; setcc(above, out) ; movzx8(out, out)
rule FCMP(a, b) when predicate == 3       => cmpf(sf(a), b, a) ; setcc(above-equal, out) ; movzx8(out, out)
rule FCMP(a, b) when predicate == 4       => cmpf(sf(a), a, b) ; setcc(above, out) ; movzx8(out, out)
rule FCMP(a, b) when predicate == 5       => cmpf(sf(a), a, b) ; setcc(above-equal, out) ; movzx8(out, out)
rule FCMP(a, b) when predicate == 6       => cmpf(sf(a), a, b) ; setcc(parity, $p) ; setcc(not-equal, out) ; or(0, out, $p) ; movzx8(out, out)
rule FCMP(a, b) when predicate == 7       => cmpf(sf(a), a, b) ; setcc(equal, out) ; movzx8(out, out)
rule FCMP(a, b) when predicate == 8       => cmpf(sf(a), a, b) ; setcc(no-parity, out) ; movzx8(out, out)
rule FCMP(a, b) when predicate == 9       => cmpf(sf(a), a, b) ; setcc(parity, out) ; movzx8(out, out)
rule FCMP(a, b) when predicate == 10      => cmpf(sf(a), a, b) ; setcc(below, out) ; movzx8(out, out)
rule FCMP(a, b) when predicate == 11      => cmpf(sf(a), a, b) ; setcc(below-equal, out) ; movzx8(out, out)
rule FCMP(a, b) when predicate == 12      => cmpf(sf(a), b, a) ; setcc(below, out) ; movzx8(out, out)
rule FCMP(a, b) when predicate == 13      => cmpf(sf(a), b, a) ; setcc(below-equal, out) ; movzx8(out, out)

# Memory. A stack variable is reached from the frame register.
rule LOAD(ALLOCA as o) when o.align <= 16 and not float and width == 64 => load-word(out, rbp, offset - object(o), shape & 255, (shape >> 8) & 1)
rule LOAD(ALLOCA as o) when o.align <= 16 and float => load-float(out, rbp, offset - object(o), shape & 255)
rule LOAD(once ADDI(p) as a) when not float and width == 64 and s32(offset + a.offset) => load-word(out, p, offset + a.offset, shape & 255, (shape >> 8) & 1)
rule LOAD(once ADDI(p) as a) when float and s32(offset + a.offset) => load-float(out, p, offset + a.offset, shape & 255)
rule LOAD(p) when not float and width == 64 and s32(offset) => load-word(out, p, offset, shape & 255, (shape >> 8) & 1)
rule LOAD(p) when not float and width == 64 => address(r10, p, offset) ; load-word(out, r10, 0, shape & 255, (shape >> 8) & 1)
rule LOAD(p) when float and s32(offset)   => load-float(out, p, offset, shape & 255)
rule LOAD(p) when float                   => address(r10, p, offset) ; load-float(out, r10, 0, shape & 255)
rule STORE(ALLOCA as o, v) when o.align <= 16 and float(v) => store-float(v, rbp, offset - object(o), bytes)
rule STORE(ALLOCA as o, v) when o.align <= 16 and bits(v) == 64 => store-word(v, rbp, offset - object(o), bytes)
rule STORE(once ADDI(p) as a, v) when float(v) and s32(offset + a.offset) => store-float(v, p, offset + a.offset, bytes)
rule STORE(once ADDI(p) as a, v) when bits(v) == 64 and s32(offset + a.offset) => store-word(v, p, offset + a.offset, bytes)
rule STORE(p, v) when float(v) and s32(offset) => store-float(v, p, offset, bytes)
rule STORE(p, v) when float(v)            => address(r10, p, offset) ; store-float(v, r10, 0, bytes)
rule STORE(p, v) when bits(v) == 64 and s32(offset) => store-word(v, p, offset, bytes)
rule STORE(p, v) when bits(v) == 64       => address(r10, p, offset) ; store-word(v, r10, 0, bytes)
rule ADDI(ALLOCA as o) when o.align <= 16 and s32(offset - object(o)) => lea(out, rbp, offset - object(o))
rule ADDI(p)                              => move(out, p) ; address(out, out, offset)
rule PTRADD(p, i) when scale == 0         => move(out, p) ; address(out, out, offset)
rule PTRADD(p, i) when (scale == 1 or scale == 2 or scale == 4 or scale == 8) and s32(offset) => lea-indexed(out, p, i, log2(scale), offset)
rule PTRADD(p, i)                         => mov-imm64($s, scale) ; move($t, i) ; imul(1, $t, $s) ; lea-indexed(out, p, $t, 0, 0) ; address(out, out, offset)

# Memory other threads share, `bytes` wide. A load and a store in the one
# order every thread sees: a load as it is, a store by an exchange. A sum, a
# difference and an exchange are the machine's own, leaving what was there,
# carried up with zeros; any other update is a loop: what is there, the
# update worked out, put back if nothing else got there first.
rule ATOMIC-LOAD(p)                       => load-word(out, p, 0, bytes, 0)
rule ATOMIC-STORE(p, v)                   => move($t, v) ; swap-memory(bytes * 8, $t, p)
rule ATOMIC-RMW(p, v) when update == 0    => move(out, v) ; add-memory(bytes * 8, out, p) ; narrow(out, bytes)
rule ATOMIC-RMW(p, v) when update == 1    => move(out, v) ; neg(1, out) ; add-memory(bytes * 8, out, p) ; narrow(out, bytes)
rule ATOMIC-RMW(p, v) when update == 5    => move(out, v) ; swap-memory(bytes * 8, out, p) ; narrow(out, bytes)
rule ATOMIC-RMW(p, v)                     => load-word(rax, p, 0, bytes, 0) ; place(again) ; move($n, rax) ; update(update, bytes, $n, v, $a, $b) ; compare-swap(bytes * 8, $n, p) ; jcc(not-equal, label(again)) ; narrow(rax, bytes) ; move(out, rax)
rule CMPXCHG(p, e, d)                     => move(rax, e) ; compare-swap(bytes * 8, d, p) ; narrow(rax, bytes) ; move(out, rax)
rule FENCE                                => barrier()

# Branches: to `then` when the condition holds; the compile goes on to `else`.
rule CONDBR(once ICMP(a, CONST k) as c) when bits(a) == 64 and s32(k) => cmp-imm(1, a, k) ; jcc(cases(c.predicate, equal, not-equal, less, less-equal, greater, greater-equal, below, below-equal, above, above-equal), then)
rule CONDBR(once ICMP(a, b) as c) when bits(a) == 64 => cmp(1, a, b) ; jcc(cases(c.predicate, equal, not-equal, less, less-equal, greater, greater-equal, below, below-equal, above, above-equal), then)
rule CONDBR(c)                            => test(1, c, c) ; jcc(not-equal, then)
rule UNREACHABLE                          => ud2()
