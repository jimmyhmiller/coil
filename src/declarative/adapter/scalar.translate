# Scalar CIR operations with a direct graph-node interpretation.
translate from declarative.cir.ops to declarative.backend.nodes {
  ADD(left, right) => ADD(left, right) at ptr;
  SUB(left, right) => SUB(left, right) at ptr;
  MUL(left, right) => MUL(left, right) at ptr;
  AND(left, right) => AND(left, right) at ptr;
  OR(left, right) => OR(left, right) at ptr;
  XOR(left, right) => XOR(left, right) at ptr;
  SHL(left, right) => SHL(left, right) at ptr;
  LSHR(left, right) => SHR(left, right) at ptr;
  ASHR(left, right) => SAR(left, right) at ptr;
  SDIV(left, right) => SDIV(left, right) at ptr;
  UDIV(left, right) => UDIV(left, right) at ptr;
  SREM(left, right) => SREM(left, right) at ptr;
  UREM(left, right) => UREM(left, right) at ptr;
  NEG(value) => NEG(value) at ptr;
  NOT(value) => NOT(value) at ptr;
  SMULH(left, right) => SMULH(left, right) at ptr;
  UMULH(left, right) => UMULH(left, right) at ptr;
  FADD(left, right) => FADD(left, right) at result;
  FSUB(left, right) => FSUB(left, right) at result;
  FMUL(left, right) => FMUL(left, right) at result;
  FDIV(left, right) => FDIV(left, right) at result;
  FNEG(value) => FNEG(value) at result;
  FABS(value) => FABS(value) at result;
  FSQRT(value) => FSQRT(value) at result;
  FMIN(left, right) => FMIN(left, right) at result;
  FMAX(left, right) => FMAX(left, right) at result;
  FMINNM(left, right) => FMIN-NUMBER(left, right) at result;
  FMAXNM(left, right) => FMAX-NUMBER(left, right) at result;
  SITOFP(value) => SITOF(value) at result;
  UITOFP(value) => UITOF(value) at result;
  FMA(left, right, addend) => FMA(left, right, addend) at result;
  FPEXT(value) => FEXT(value) at f64;
  FPTRUNC(value) => FTRUNC(value) at f32;
  FRINT(value) => match mode {
    0 => ROUND-EVEN(value) at result;
    1 => ROUND-UP(value) at result;
    2 => ROUND-DOWN(value) at result;
    3 => ROUND-ZERO(value) at result;
    otherwise => ROUND-AWAY(value) at result;
  };
  FPTOSI(value) => match bits {
    32 => SEXT(FTOSI(value) at i32) at ptr;
    otherwise => TRUNC(FTOSI(value) at i64) at ptr;
  };
  FPTOUI(value) => match bits {
    32 => ZEXT(FTOUI(value) at u32) at ptr;
    otherwise => TRUNC(FTOUI(value) at u64) at ptr;
  };
  COPY(value) => value;
  LO(low) => low;
  ADDI(base) => match offset {
    0 => base;
    otherwise => ADD(base, literal offset at ptr) at ptr;
  };
  PTRADD(base, index) => match scale {
    0 => match offset {
      0 => base;
      otherwise => ADD(base, literal offset at ptr) at ptr;
    };
    otherwise => match offset {
      0 => ADD(base, MUL(index, literal scale at ptr) at ptr) at ptr;
      otherwise => ADD(ADD(base, MUL(index, literal scale at ptr) at ptr) at ptr,
                       literal offset at ptr) at ptr;
    };
  };
}
