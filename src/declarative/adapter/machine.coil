;;; From the Coil compiler's CIR to the backend: one function's CIR becomes a
;;; graph, the graph is compiled, and its code and what it refers to go into
;;; the compiler's assembler. Written once, for both machines: machine-a64.instance
;;; and machine-x64.instance make it declarative.machine-a64 and
;;; declarative.machine-x64, each with a `target` that picks its machine's half
;;; of every `machine-pick`.
;;;
;;; CIR's integers are all 64 bits, kept extended by whoever made them; here
;;; they are all of the node set's 64-bit address type, which arithmetic and
;;; memory both take. A 128-bit integer is two of them, the low half and the
;;; high. Blocks are walked from the entry in an order that has every block
;;; after the blocks that reach it going forward; a block several edges enter
;;; is a REGION, one that an edge comes back to is a LOOP whose first input is
;;; the way in, and a block one edge enters is just what follows that edge.
(module declarative.machine)
(import "coil.alloc" :as alloc :use [Allocator malloc-allocator box!])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.var" :use [var-static])
(import "coil.str" :as str)
(import "coil.slice" :as slice)
(import "coil.scratch" :as scratch)
(import "coil.atomic" :as atomic)
(import "coil.thread" :use [Thread ThreadConfig])
(import "native.cir" :as cir)
(import "native.cir-ops" :as cop)
(import "native.asm" :as asm)
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.clock" :as clock)
(import "declarative.backend.nodes" :as ir)
(import "declarative.target" :as target)
(target/machine-pick (import "declarative.a64.unit" :as st) (import "declarative.x64.unit" :as st))
(target/machine-pick (import "declarative.a64.plans" :as plans) (import "declarative.x64.plans" :as plans))
(target/machine-pick (import "declarative.a64.target" :as isa) (import "declarative.x64.target" :as isa))
; The compile straight from CIR: all of -O0 and -O1.
(target/machine-pick (import "declarative.a64-direct.unit" :as dst) (import "declarative.x64-direct.unit" :as dst))
(target/machine-pick (import "declarative.a64-direct.plans" :as dplans) (import "declarative.x64-direct.plans" :as dplans))
(target/machine-pick (import "declarative.a64-direct.regs" :as dregs) (import "declarative.x64-direct.regs" :as dregs))
(import "declarative.view" :as view)
(import "declarative.cir.ops" :as cops)
(import "declarative.dump" :as dump)

(defn fail [(f (ptr cir/Func)) (what (slice u8))] (-> never)
  (panic "declarative backend: {}: {}" (.name f) what))

;;; The type every 64-bit integer has.
(const W ir/T-PTR)

;;; What the environment asks for, read once for a module.
;;;   DECLARATIVE_CHECK        each graph is checked against the node set
;;;   DECLARATIVE_SHOW=NAME    that function's graph, before and after, and its
;;;                            code are printed; `?` names each with its number
;;;   DECLARATIVE_ONLY=N       only the first N functions are optimized, to find
;;;                            which function a wrong optimization is in
;;;   DECLARATIVE_TRIAL=N      only the first N functions get what a pass that
;;;                            asks `trial` is trying; unset, all do
;;;   DECLARATIVE_OFF=BITS     the numbered things done to a function whose bits are
;;;                            set are not done (the numbers are in cfg.pass); with
;;;                            DECLARATIVE_OFF_AT=N, to function N only
;;;   DECLARATIVE_SMALL=N, DECLARATIVE_GROWTH=N    other limits on what is put
;;;                            in place of its calls
;;;   DECLARATIVE_ONCE=N       the most instructions a private function called from
;;;                            one place may have and be put there for that alone
;;;   DECLARATIVE_THREADS=N    how many threads compile a module's functions
;;;   DECLARATIVE_TIMES        below -O2, how long building graphs and each step
;;;                            of the plan took, printed when the compile ends
(defstruct Settings
  [(check bool) (show (ptr i8)) (only i64) (trial i64) (off i64) (off-at i64) (small i64) (growth i64) (threads i64) (once i64)
   (times bool)])

(extern getenv :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

;;; A number from the environment; `otherwise` if unset.
(defn tuned [(name (ptr i8)) (otherwise i64)] (-> i64)
  (let [text (getenv name)]
    (if (= (primitive/cast u64 text) 0)
        otherwise
        (match (str/parse-int (str/from-cstr text))
          (Some [n] n)
          (None [] (panic "declarative backend: {} is not a number" (str/from-cstr name)))))))

;;; The most instructions a function may have and still be put in place
;;; call without having asked, how deep that may go, and how many instructions
;;; may be put into one function in all.
(const SMALL 40)
(const DEEPEST 5)
(const GROWTH 1200)
;;; And for a private function called from one place only: the most
;;; instructions it may have, and how many such may go into one function.
;;; (Measured on the Coil compiler: at 300 the text is 8% smaller and the
;;; program runs in as many cycles; at 3000 the text is larger again.)
(const ONCE-SIZE 300)
(const ONCE-GROWTH 12000)

(defn settings-read [] (-> Settings)
  (Settings :check (!= (primitive/cast u64 (getenv c"DECLARATIVE_CHECK")) 0)
            :show (getenv c"DECLARATIVE_SHOW")
            :only (tuned c"DECLARATIVE_ONLY" -1)
            :trial (tuned c"DECLARATIVE_TRIAL" -1)
            :off (tuned c"DECLARATIVE_OFF" 0)
            :off-at (tuned c"DECLARATIVE_OFF_AT" -1)
            :small (tuned c"DECLARATIVE_SMALL" SMALL)
            :growth (tuned c"DECLARATIVE_GROWTH" GROWTH)
            :threads (tuned c"DECLARATIVE_THREADS" 0)
            :once (tuned c"DECLARATIVE_ONCE" ONCE-SIZE)
            :times (!= (primitive/cast u64 (getenv c"DECLARATIVE_TIMES")) 0)
))

;;; The settings that change the code, as text: for whoever keeps code under a
;;; key (Coil's units). How much is put in place, and what is left out or only
;;; tried; what is shown or checked, and on how many threads, change nothing.
(defn settings-key [(a (dyn Allocator))] (-> (slice u8))
  (let [s (settings-read)
        (mut sb) (str/StrBuf::new a)]
    (str/format! (mut sb) "only={} trial={} off={} off-at={} small={} growth={} once={}"
                 (.only s) (.trial s) (.off s) (.off-at s) (.small s) (.growth s) (.once s))
    (finish! (mut sb))))

;;; A function's code, and each word of it that depends on a symbol's address:
;;; where, which symbol, and the assembler's kind of relocation.
(defstruct Compiled
  [(code (ArrayList u8))
   (reloc-at (ArrayList i64))
   (reloc-symbol (ArrayList i64))
   (reloc-kind (ArrayList i64))
   ; For a function compiled to be looked at as it runs: pairs of where in the
   ; code and which place in the source; pairs of a CIR value and where the
   ; code for it starts; and for each of the function's frame objects, in
   ; CIR's order, how far from the frame register it is.
   (rows (ArrayList u64))
   (marks (ArrayList u64))
   (objects (ArrayList i64))
   ; and where each value it was asked to follow is, as it changes: triples of
   ; which (its place in that list), where in the code, and where it is (as
   ; the compile straight from CIR notes it).
   (locs (ArrayList u64))
   (done bool)])

(defn compiled-none [] (-> Compiled)
  (let [a (malloc-allocator)]
    (Compiled :code (ArrayList::new [u8] a) :reloc-at (ArrayList::new [i64] a)
              :reloc-symbol (ArrayList::new [i64] a) :reloc-kind (ArrayList::new [i64] a)
              :rows (ArrayList::new [u64] a) :marks (ArrayList::new [u64] a) :objects (ArrayList::new [i64] a)
              :locs (ArrayList::new [u64] a) :done false)))

(defn compiled-free! [(c (ptr Compiled))] (-> void)
  (free! (mut (.code c)))
  (free! (mut (.reloc-at c)))
  (free! (mut (.reloc-symbol c)))
  (free! (mut (.reloc-kind c)))
  (free! (mut (.rows c)))
  (free! (mut (.marks c)))
  (free! (mut (.objects c)))
  (free! (mut (.locs c)))
  (set! (.done c) false))

;;; Every function of a module, by its symbol, so that a call of a small one
;;; can be the function's own instructions where the call stands, and so that
;;; the functions can be compiled several at a time: each into its own
;;; `Compiled`, put into the assembler afterwards in the module's order.
(defstruct Module
  [(functions (ArrayList (ptr cir/Func)))   ; by symbol; null for a symbol that is no function here
   (never (ArrayList bool))                 ; asked never to be put in place of its calls
   (always (ArrayList bool))                ; asked always to be
   ; Nothing outside the module can call it or have its address; how many
   ; calls of it the module's functions make; and whether any takes its address.
   (private (ArrayList bool))
   (calls (ArrayList i32))
   (taken (ArrayList bool))
   (compiled (ArrayList Compiled))          ; by symbol
   (order (ArrayList u32))                  ; the functions' symbols, in the order they were added
   (position (ArrayList i64))               ; by symbol: where it is in `order`
   (wave (ArrayList u32))                   ; the functions being compiled now
   (settings Settings)
   ; For the threads compiling: the assembler, the level, the next of `order` to take.
   (ta (ptr asm/Asm))
   (level i32)
   (next i64)])

(defn module-create [] (-> Module)
  (let [a (malloc-allocator)]
    (Module :functions (ArrayList::new [(ptr cir/Func)] a) :never (ArrayList::new [bool] a)
            :always (ArrayList::new [bool] a) :private (ArrayList::new [bool] a)
            :calls (ArrayList::new [i32] a) :taken (ArrayList::new [bool] a) :compiled (ArrayList::new [Compiled] a)
            :order (ArrayList::new [u32] a) :position (ArrayList::new [i64] a)
            :wave (ArrayList::new [u32] a) :settings (settings-read)
            :ta (primitive/cast (ptr asm/Asm) 0) :level 0 :next 0)))

(defn module-free! [(m (ptr Module))] (-> void)
  (for i (range 0 (len (.compiled m))) (compiled-free! (elem (mut (.compiled m)) i)))
  (free! (mut (.functions m)))
  (free! (mut (.never m)))
  (free! (mut (.always m)))
  (free! (mut (.private m)))
  (free! (mut (.calls m)))
  (free! (mut (.taken m)))
  (free! (mut (.compiled m)))
  (free! (mut (.position m)))
  (free! (mut (.wave m)))
  (free! (mut (.order m))))

;;; `f` is the function `symbol` names. It must stay as it is until the last
;;; function of the module is compiled.
(defn module-add! [(m (ptr Module)) (f (ptr cir/Func)) (symbol u32) (never bool) (always bool) (private bool)]
  (-> void)
  (while (<= (len (.functions m)) (cast i64 symbol))
    (push! (mut (.functions m)) (primitive/cast (ptr cir/Func) 0))
    (push! (mut (.never m)) false)
    (push! (mut (.always m)) false)
    (push! (mut (.private m)) false)
    (push! (mut (.calls m)) 0)
    (push! (mut (.taken m)) false)
    (push! (mut (.position m)) -1)
    (push! (mut (.compiled m)) (compiled-none)))
  (set! (mut (.functions m)) (cast i64 symbol) f)
  (set! (mut (.never m)) (cast i64 symbol) never)
  (set! (mut (.always m)) (cast i64 symbol) always)
  (set! (mut (.private m)) (cast i64 symbol) private)
  (set! (mut (.position m)) (cast i64 symbol) (len (.order m)))
  (push! (mut (.order m)) symbol))

;;; Every function is added: count the calls of each, and note whose address
;;; is taken. A private function called from one place only is put there,
;;; whatever its size: the module is then no larger for it, and one function fewer.
(defn module-count! [(m (ptr Module))] (-> void)
  (for symbol (.order m)
    (let [f (get (.functions m) (cast i64 symbol))]
      (for v (range 0 (i64-of (cir/value-count f)))
        (let [x (cir/val f (cast u32 v))
              op (cast i64 (.op x))
              to (.imm x)]
          (when (and (>= to 0) (< to (len (.functions m))))
            (cond (or (= op cop/OP-CALL) (= op cop/OP-TAILCALL))
                    (do (set! (mut (.calls m)) to (+ (get (.calls m) to) 1)) 0)
                  (= op cop/OP-SYM) (do (set! (mut (.taken m)) to true) 0)
                  :else 0)))))))

;;; What one function being compiled has had put in place of its calls: how
;;; many instructions, and the functions being put in place, outermost first.
;;; And two things that must not both be true of it: that a function whose
;;; frame's addresses get out was put in place in it (`escaped`), and that it
;;; ends some way by going straight to another function, or round to its own
;;; start, with its frame given back or used again (`tails`).
(defstruct Budget [(grown i64) (once i64) (active (ArrayList u32)) (escaped bool) (tails bool)])

;;; The library routines compiled code calls. While a function is compiled a
;;; routine is the symbol RUNTIME + its place here; it becomes the assembler's
;;; symbol when the code is put there, so that the assembler's symbols are made
;;; in the module's order however many threads compile.
(const RUNTIME 0x40000000)
(const ROUTINES 7)

(defn routine-name [(k i64)] (-> (slice u8))
  (cond (= k 0) "memcpy"
        (= k 1) "memset"
        (= k 2) "memmove"
        (= k 3) "__divti3"
        (= k 4) "__udivti3"
        (= k 5) "__modti3"
        (= k 6) "__umodti3"
        :else (panic "declarative backend: no library routine numbered {}" k)))

(defn routine [(name (slice u8))] (-> u64)
  (block :found
    (for k (range 0 ROUTINES)
      (when (= (routine-name k) name) (return-from :found (cast u64 (+ RUNTIME k)))))
    (panic "declarative backend: {} is not a library routine it knows" name)))

(defstruct Adapter
  [(f (ptr cir/Func))
   (ta (ptr asm/Asm))
   (g graph/Graph)
   (a (dyn Allocator))
   ; A CIR value's node, the high half of a 128-bit one, and the comparison a
   ; 0-or-1 value is the answer to; 0 for none.
   (node (ArrayList i32))
   (high (ArrayList i32))
   (truth (ArrayList i32))
   ; Blocks, by CIR's numbers: where each is in the walk (0 not reached, 1
   ; being walked, 2 walked), its edges out (a run of `targets` and `backward`),
   ; how many edges enter going forward and coming back, how many of each are
   ; connected so far, and the nodes that stand for it.
   (seen (ArrayList u8))
   (first-out (ArrayList i32))
   (targets (ArrayList u32))
   (backward (ArrayList bool))
   (forward-in (ArrayList i32))
   (backward-in (ArrayList i32))
   (forward-done (ArrayList i32))
   (backward-done (ArrayList i32))
   (merge (ArrayList i32))   ; the REGION of the forward edges, if several
   (loop (ArrayList i32))    ; the LOOP, if any edge comes back
   (enters (ArrayList i32))  ; the control that enters a block one forward edge reaches
   ; The control node that starts the graph's block a block's nodes are made
   ; in: its region or loop, the projection of the branch that enters it, or,
   ; for a block one jump enters, the same as the block that jumps.
   (heads (ArrayList i32))
   ; For a phi of a block with both: its phi at the REGION, and that phi's high half.
   (before (ArrayList i32))
   (before-high (ArrayList i32))
   (order (ArrayList u32))
   ; The control the instruction being lowered follows.
   (c i32)
   (params i64)
   (ints i64)
   (floats i64)
   ; The module, or null. For a function being put in place of a call: how
   ; deep, and each place it returns from: the control there and the values,
   ; `exit-width` of them for each.
   (module (ptr Module))
   (settings Settings)
   (budget (ptr Budget))
   ; For a function that calls itself as the last thing it does: its own
   ; symbol (-1 if it does not), the loop its body is in, the phi each
   ; parameter's node is there, and how many of those calls are done.
   (self i64)
   (debug bool)              ; compiled to be looked at as it runs
   (sret i32)                ; the parameter that says where the result is written, if there is one
   (level i32)
   (again i32)
   (again-phis (ArrayList i32))
   (again-done i64)
   (depth i64)
   (exits (ArrayList i32))
   (exit-values (ArrayList i32))
   (exit-width i64)])

(defn i64-of [(x u32)] (-> i64) (cast i64 x))

(defn word [(s (mut Adapter)) (v u64)] (-> i32)
  (ir/const! (mut (.g s)) W v))

;; ---------------------------------------------------------------- the walk

;;; The blocks `b`'s last instruction can go to, one for each edge: a branch on
;;; a condition whose two ways are one block has one edge, and a switch has one
;;; for its default and one for each case.
(defn out-edges! [(s (mut Adapter)) (b u32)] (-> void)
  (let [f (.f s)
        term (cir/val f (.term (cir/blk f b)))
        op (cast i64 (.op term))
        blocks (- (.ntotal term) (.nops term))]
    (set! (mut (.first-out s)) (i64-of b) (cast i32 (len (.targets s))))
    (cond
      (= op cop/OP-CONDBR)
        (let [then (cir/operand f term (.nops term))
              else (cir/operand f term (+ (.nops term) (: 1 u32)))]
          (push! (mut (.targets s)) then)
          (push! (mut (.backward s)) false)
          (when (!= then else)
            (push! (mut (.targets s)) else)
            (push! (mut (.backward s)) false)))
      (or (= op cop/OP-BR) (= op cop/OP-SWITCH))
        (for i (range 0 (i64-of blocks))
          (push! (mut (.targets s)) (cir/operand f term (+ (.nops term) (cast u32 i))))
          (push! (mut (.backward s)) false))
      :else 0)))

;;; Depth first from the entry: each block's edges, which of them come back to
;;; a block still being walked, and the blocks in the reverse of the order they
;;; were finished. The walk keeps its own stack: a function can be deep.
(defn walk! [(s (mut Adapter))] (-> void)
  (let [f (.f s)
        count (i64-of (cir/block-count f))
        (mut stack) (ArrayList::new [u32] (.a s))
        (mut at) (ArrayList::new [i64] (.a s))
        (mut post) (ArrayList::new [u32] (.a s))]
    ; `first-out` holds each block's first edge, and after those each block's
    ; one past its last.
    (for _ (range 0 (* count 2)) (push! (mut (.first-out s)) 0))
    (push! (mut stack) 0)
    (push! (mut at) 0)
    (set! (mut (.seen s)) 0 1)
    (out-edges! (mut s) 0)
    (set! (mut (.first-out s)) count (cast i32 (len (.targets s))))
    (while (> (len stack) 0)
      (let [b (get stack (- (len stack) 1))
            k (get at (- (len at) 1))
            from (cast i64 (get (.first-out s) (i64-of b)))
            to (cast i64 (get (.first-out s) (+ count (i64-of b))))]
        (if (< (+ from k) to)
            (let [t (get (.targets s) (+ from k))
                  state (get (.seen s) (i64-of t))]
              (set! (mut at) (- (len at) 1) (+ k 1))
              (cond
                (= state 0)
                  (do (set! (mut (.seen s)) (i64-of t) 1)
                      (out-edges! (mut s) t)
                      (set! (mut (.first-out s)) (+ count (i64-of t)) (cast i32 (len (.targets s))))
                      (set! (mut (.forward-in s)) (i64-of t) (+ (get (.forward-in s) (i64-of t)) 1))
                      (push! (mut stack) t)
                      (push! (mut at) 0))
                (= state 1)
                  (do (set! (mut (.backward s)) (+ from k) true)
                      (set! (mut (.backward-in s)) (i64-of t) (+ (get (.backward-in s) (i64-of t)) 1)))
                :else (set! (mut (.forward-in s)) (i64-of t) (+ (get (.forward-in s) (i64-of t)) 1))))
            (do (set! (mut (.seen s)) (i64-of b) 2)
                (push! (mut post) b)
                (pop! (mut stack))
                (pop! (mut at))
                0))))
    (for i (range 0 (len post)) (push! (mut (.order s)) (get post (- (- (len post) 1) i))))))

;; ---------------------------------------------------------------- types and values

(defn type-of [(s (mut Adapter)) (ty i64)] (-> i32)
  (cond (= ty cop/T-I64) W
        (= ty cop/T-I128) W
        (= ty cop/T-F32) ir/T-F32
        (= ty cop/T-F64) ir/T-F64
        (= ty cop/T-V128) ir/T-V128
        :else (fail (.f s) "a value of a type the backend does not know")))

(defn wide? [(s (mut Adapter)) (v u32)] (-> bool)
  (= (cast i64 (.ty (cir/val (.f s) v))) cop/T-I128))

;;; The integer type `bytes` wide, signed or not.
(defn narrow-type [(s (mut Adapter)) (bytes i64) (signed bool)] (-> i32)
  (cond (= bytes 1) (if signed ir/T-I8 ir/T-U8)
        (= bytes 2) (if signed ir/T-I16 ir/T-U16)
        (= bytes 4) (if signed ir/T-I32 ir/T-U32)
        (= bytes 8) W
        :else (fail (.f s) "an integer that is not 1, 2, 4 or 8 bytes")))

;;; A symbol's address: where it is, if this module defines it, or read from
;;; the table of addresses if it does not.
(defn symbol-address [(s (mut Adapter)) (symbol u32)] (-> i32)
  (if (through-table? (.ta s) symbol (.module s))
      (ir/extern! (mut (.g s)) (cast u64 symbol))
      (ir/symbol! (mut (.g s)) (cast u64 symbol))))

;;; Whether `symbol`'s address is read from the table of addresses: what the
;;; module does not define, and, where a shared object's own symbols may be
;;; taken over by another's (ELF), whatever is not private to it.
(defn through-table? [(ta (ptr asm/Asm)) (symbol u32) (m (ptr Module))] (-> bool)
  (let [at (cast i64 symbol)]
    (or (and (target/machine-pick false true) (!= (.binding (asm/sym-at ta symbol)) (: 0 u8)))
        (and (= (.sect (asm/sym-at ta symbol)) -1)
             (or (= (primitive/cast u64 m) 0) (>= at (len (.functions m)))
                 (= (primitive/cast u64 (get (.functions m) at)) 0))))))

;;; A parameter of the graph, the next one, passed as `how` says.
(defn next-param! [(s (mut Adapter)) (type i32) (how u64)] (-> i32)
  (let [index (.params s)]
    (set! (.params s) (+ index 1))
    (graph/declare-passing! (mut (.g s)) index how)
    (ir/param! (mut (.g s)) type (cast u64 index))))

;;; `v` carried from `bits` bits to all 64, by its sign or by zeros.
(defn extended [(s (mut Adapter)) (v i32) (bits i64) (signed bool)] (-> i32)
  (cond
    (>= bits 64) v
    (or (= bits 8) (= bits 16) (= bits 32))
      ; By zeros it is a mask, which what is known of the value can show to be
      ; needless and a 32-bit instruction can do in passing.
      (if signed
          (ir/sext! (mut (.g s)) W (ir/trunc! (mut (.g s)) (narrow-type (mut s) (/ bits 8) true) v))
          (ir/and! (mut (.g s)) W v (word (mut s) (- (<< (: 1 u64) (cast u64 bits)) 1))))
    :else
      (let [by (word (mut s) (cast u64 (- 64 bits)))
            up (ir/shl! (mut (.g s)) W v by)]
        (if signed (ir/sar! (mut (.g s)) W up by) (ir/shr! (mut (.g s)) W up by)))))

;;; Every parameter, in order: where each arrives depends on all before it.
(defn params! [(s (mut Adapter))] (-> void)
  (let [f (.f s)]
    (for i (range 0 (len (.args f)))
      (let [v (get (.args f) i)
            ty (cast i64 (.ty (cir/val f v)))
            flags (get (.arg-flags f) i)
            with (cast u64 (& (>> flags (: 16 u32)) (: 255 u32)))
            size (cast i64 (& (>> flags (: 24 u32)) (: 7 u32)))
            signed (!= (& flags (cast u32 cir/AF-SEXT)) (: 0 u32))]
        (cond
          (get (.arg-sret f) i)
            (do (set! (.sret s) (next-param! (mut s) W graph/PASS-INDIRECT))
                (set! (mut (.node s)) (i64-of v) (.sret s)))
          ; The address of the copy the caller made on the stack.
          (cir/af-byval? flags)
            (set! (mut (.node s)) (i64-of v)
                  (next-param! (mut s) W (| graph/PASS-COPIED (<< (cast u64 (cir/af-byval-size flags)) 32))))
          (= ty cop/T-I128)
            (do (set! (mut (.node s)) (i64-of v) (next-param! (mut s) W (| (: 1 u64) graph/PASS-ALIGN16)))
                (set! (mut (.high s)) (i64-of v) (next-param! (mut s) W 0)))
          ; An integer narrower than a word arrives with only its own bits
          ; promised; the flags say how many those are.
          (and (= ty cop/T-I64) (> size 0) (< (& (>> flags (: 16 u32)) (: 255 u32)) (: 1 u32)))
            (let [bytes (<< 1 (- size 1))
                  p (next-param! (mut s) (narrow-type (mut s) bytes signed) with)]
              (set! (mut (.node s)) (i64-of v)
                    (if signed (ir/sext! (mut (.g s)) W p) (ir/zext! (mut (.g s)) W p))))
          :else (set! (mut (.node s)) (i64-of v) (next-param! (mut s) (type-of (mut s) ty) with)))))))

;;; The node of CIR value `v`. A constant, a symbol's address and a frame
;;; object have no instruction: each is made where it is first used.
(defn value [(s (mut Adapter)) (v u32)] (-> i32)
  (let [have (get (.node s) (i64-of v))]
    (if (!= have 0)
        have
        (let [f (.f s)
              x (cir/val f v)
              op (cast i64 (.op x))
              ty (cast i64 (.ty x))
              made
                (cond
                  (= op cop/OP-CONST)
                    (cond (= ty cop/T-F32) (ir/const! (mut (.g s)) ir/T-F32 (& (cast u64 (.imm x)) (: 0xFFFFFFFF u64)))
                          (= ty cop/T-F64) (ir/const! (mut (.g s)) ir/T-F64 (cast u64 (.imm x)))
                          (= ty cop/T-I128)
                            (do (set! (mut (.high s)) (i64-of v) (word (mut s) (cast u64 (.imm2 x))))
                                (word (mut s) (cast u64 (.imm x))))
                          (= ty cop/T-I64) (word (mut s) (cast u64 (.imm x)))
                          (and (= ty cop/T-V128) (= (.imm x) 0) (= (.imm2 x) 0)) (ir/const! (mut (.g s)) ir/T-V128 0)
                          :else (fail f "a constant vector that is not zero"))
                  (= op cop/OP-SYM)
                    (let [address (symbol-address (mut s) (cast u32 (.imm x)))]
                      (if (= (.imm2 x) 0)
                          address
                          (ir/add! (mut (.g s)) W address (word (mut s) (cast u64 (.imm2 x))))))
                  (= op cop/OP-ALLOCA)
                    ; An object's size is a whole number of its alignment, so
                    ; one aligned to 16 is larger than 8 bytes and is put at 16.
                    ; An object that asks for more is made that much larger,
                    ; and its address is the first place in it that will do.
                    (let [align (.imm2 x)
                          size (* (/ (+ (.imm x) (- align 1)) align) align)]
                      (if (<= align 16)
                          (ir/slot! (mut (.g s)) (cast u64 size))
                          (ir/and! (mut (.g s)) W
                                   (ir/add! (mut (.g s)) W (ir/slot! (mut (.g s)) (cast u64 (+ size align)))
                                            (word (mut s) (cast u64 (- align 1))))
                                   (word (mut s) (cast u64 (- 0 align))))))
                  :else (fail f "a value is used before the instruction that makes it"))]
          (set! (mut (.node s)) (i64-of v) made)
          made))))

;;; The high half of a 128-bit value.
(defn value-high [(s (mut Adapter)) (v u32)] (-> i32)
  (value (mut s) v)
  (let [have (get (.high s) (i64-of v))]
    (when (= have 0) (fail (.f s) "a 128-bit value has no high half"))
    have))

(defn define! [(s (mut Adapter)) (v u32) (n i32)] (-> void)
  (set! (mut (.node s)) (i64-of v) n))

(defn define-wide! [(s (mut Adapter)) (v u32) (low i32) (high i32)] (-> void)
  (set! (mut (.node s)) (i64-of v) low)
  (set! (mut (.high s)) (i64-of v) high))

;;; A 0-or-1 value from a condition, remembering the condition.
(defn define-truth! [(s (mut Adapter)) (v u32) (condition i32)] (-> void)
  (set! (mut (.truth s)) (i64-of v) condition)
  (define! (mut s) v (ir/zext! (mut (.g s)) W condition)))

;;; CIR value `v` as a condition: the one it was made from, or whether it is not 0.
(defn condition [(s (mut Adapter)) (v u32)] (-> i32)
  (let [n (value (mut s) v)
        made (get (.truth s) (i64-of v))]
    (if (!= made 0) made (ir/ne! (mut (.g s)) n (word (mut s) 0)))))

;; ---------------------------------------------------------------- blocks

(defn phi-at [(s (mut Adapter)) (b u32) (i i64)] (-> u32)
  (get (.phis (.f s)) (+ (i64-of (.phi-begin (cir/blk (.f s) b))) i)))

;;; The nodes that stand for each block more than one edge enters, and its phis.
(defn heads! [(s (mut Adapter))] (-> void)
  (let [f (.f s)]
    (for b (.order s)
      (let [at (i64-of b)
            forward (+ (cast i64 (get (.forward-in s) at)) (if (= at 0) 1 0))
            back (cast i64 (get (.backward-in s) at))
            phis (i64-of (.phi-count (cir/blk f b)))]
        (when (> forward 1)
          (let [region (ir/region! (mut (.g s)) forward)]
            (set! (mut (.merge s)) at region)
            (for i (range 0 phis)
              (let [p (phi-at (mut s) b i)
                    type (type-of (mut s) (cast i64 (.ty (cir/val f p))))]
                (set! (mut (.before s)) (i64-of p) (ir/phi! (mut (.g s)) type region forward))
                (when (wide? (mut s) p)
                  (set! (mut (.before-high s)) (i64-of p) (ir/phi! (mut (.g s)) type region forward)))))))
        (if (> back 0)
            (let [loop (ir/loop! (mut (.g s)) (+ back 1))
                  region (get (.merge s) at)]
              (set! (mut (.loop s)) at loop)
              (when (!= region 0) (graph/set-input! (mut (.g s)) loop 0 region))
              (for i (range 0 phis)
                (let [p (phi-at (mut s) b i)
                      type (type-of (mut s) (cast i64 (.ty (cir/val f p))))
                      low (ir/phi! (mut (.g s)) type loop (+ back 1))]
                  (when (!= region 0) (graph/set-input! (mut (.g s)) low 1 (get (.before s) (i64-of p))))
                  (set! (mut (.node s)) (i64-of p) low)
                  (when (wide? (mut s) p)
                    (let [high (ir/phi! (mut (.g s)) type loop (+ back 1))]
                      (when (!= region 0)
                        (graph/set-input! (mut (.g s)) high 1 (get (.before-high s) (i64-of p))))
                      (set! (mut (.high s)) (i64-of p) high))))))
            (for i (range 0 phis)
              (let [p (phi-at (mut s) b i)]
                (set! (mut (.node s)) (i64-of p) (get (.before s) (i64-of p)))
                (set! (mut (.high s)) (i64-of p) (get (.before-high s) (i64-of p))))))))))

;;; Which of phi `p`'s values comes from block `from`.
(defn incoming [(s (mut Adapter)) (p u32) (from u32)] (-> u32)
  (let [f (.f s)
        x (cir/val f p)]
    (block :found
      (for k (range 0 (i64-of (.nops x)))
        (when (= (cir/operand f x (+ (.nops x) (cast u32 k))) from)
          (return-from :found (cir/operand f x (cast u32 k)))))
      (fail f "a phi has no value for a block that reaches it"))))

;;; Whether control node `c` starts a block of the graph.
(defn head? [(g graph/Graph) (c i32)] (-> bool)
  (let [op (graph/op g c)]
    (or (= op ir/START) (= op ir/REGION) (= op ir/LOOP) (= op ir/TRUE) (= op ir/FALSE)
        (= op ir/CASE) (= op ir/DEFAULT))))

;;; Edge `e`, out of block `from`, is taken from control `c`: the block it goes
;;; to follows `c`, and each of that block's phis takes its value for `from`.
(defn connect! [(s (mut Adapter)) (from u32) (e i64) (c i32)] (-> void)
  (let [f (.f s)
        to (get (.targets s) e)
        at (i64-of to)
        phis (i64-of (.phi-count (cir/blk f to)))
        region (get (.merge s) at)
        loop (get (.loop s) at)]
    (if (get (.backward s) e)
        (let [slot (+ 1 (cast i64 (get (.backward-done s) at)))]
          (set! (mut (.backward-done s)) at (cast i32 slot))
          (graph/set-input! (mut (.g s)) loop slot c)
          (for i (range 0 phis)
            (let [p (phi-at (mut s) to i)
                  v (incoming (mut s) p from)]
              (graph/set-input! (mut (.g s)) (get (.node s) (i64-of p)) (+ slot 1) (value (mut s) v))
              (when (wide? (mut s) p)
                (graph/set-input! (mut (.g s)) (get (.high s) (i64-of p)) (+ slot 1) (value-high (mut s) v))))))
        (let [slot (cast i64 (get (.forward-done s) at))]
          (set! (mut (.forward-done s)) at (cast i32 (+ slot 1)))
          (cond
            (!= region 0) (graph/set-input! (mut (.g s)) region slot c)
            (!= loop 0) (graph/set-input! (mut (.g s)) loop 0 c)
            :else (do (set! (mut (.enters s)) at c)
                      (set! (mut (.heads s)) at (if (head? (.g s) c) c (get (.heads s) (i64-of from))))))
          (for i (range 0 phis)
            (let [p (phi-at (mut s) to i)
                  v (incoming (mut s) p from)
                  low (value (mut s) v)
                  high (if (wide? (mut s) p) (value-high (mut s) v) 0)]
              (cond
                (!= region 0)
                  (do (graph/set-input! (mut (.g s)) (get (.before s) (i64-of p)) (+ slot 1) low)
                      (when (!= high 0)
                        (graph/set-input! (mut (.g s)) (get (.before-high s) (i64-of p)) (+ slot 1) high)))
                (!= loop 0)
                  (do (graph/set-input! (mut (.g s)) (get (.node s) (i64-of p)) 1 low)
                      (when (!= high 0) (graph/set-input! (mut (.g s)) (get (.high s) (i64-of p)) 1 high)))
                ; A phi of a block one edge enters is the value that edge brings.
                :else
                  (do (set! (mut (.node s)) (i64-of p) low)
                      (set! (mut (.high s)) (i64-of p) high)
                      (set! (mut (.truth s)) (i64-of p) (get (.truth s) (i64-of v)))))))))))

;; ---------------------------------------------------------------- calls and returns

;;; How one argument of a call is passed, from CIR's flags for it.
(defn passing [(flags u32)] (-> u64)
  (let [with (cast u64 (& (>> flags (: 16 u32)) (: 255 u32)))]
    (| with
       (if (!= (& flags (cast u32 cir/AF-SRET)) (: 0 u32)) graph/PASS-INDIRECT (: 0 u64))
       (if (!= (& flags (cast u32 cir/AF-VARIADIC)) (: 0 u32)) graph/PASS-UNNAMED (: 0 u64)))))

;;; The arguments of call `v` as the graph passes them, into `values` and `how`:
;;; a 128-bit integer as two words that go in registers together, an integer
;;; the C function takes as a narrower one as that. Returns whether the
;;; function called takes any number of arguments.
(defn arguments! [(s (mut Adapter)) (v u32) (values (mut (ArrayList i32))) (how (mut (ArrayList u64)))] (-> bool)
  (let [f (.f s)
        x (cir/val f v)
        first (if (= (.imm x) -1) 1 0)
        (mut variadic) false]
    (for i (range first (i64-of (.nops x)))
      (let [a (cir/operand f x (cast u32 i))
            flags (get (.argflags f) (+ (i64-of (.opb x)) i))
            ty (cast i64 (.ty (cir/val f a)))
            size (cast i64 (& (>> flags (: 24 u32)) (: 7 u32)))
            unnamed (!= (& flags (cast u32 cir/AF-VARIADIC)) (: 0 u32))]
        (when unnamed (set! variadic true))
        (cond
          ; The address of bytes the convention copies onto the stack.
          (cir/af-byval? flags)
            (do (push! (mut values) (value (mut s) a))
                (push! (mut how) (| graph/PASS-COPIED (<< (cast u64 (cir/af-byval-size flags)) 32))))
          (= ty cop/T-I128)
            (do (push! (mut values) (value (mut s) a))
                (push! (mut how) (| (: 1 u64) graph/PASS-ALIGN16 (if unnamed graph/PASS-UNNAMED (: 0 u64))))
                (push! (mut values) (value-high (mut s) a))
                (push! (mut how) (if unnamed graph/PASS-UNNAMED (: 0 u64))))
          (and (= ty cop/T-I64) (> size 0) (not unnamed))
            (do (push! (mut values)
                       (ir/trunc! (mut (.g s))
                                  (narrow-type (mut s) (<< 1 (- size 1)) (cir/af-signed? flags))
                                  (value (mut s) a)))
                (push! (mut how) (passing flags)))
          :else
            (do (push! (mut values) (value (mut s) a))
                (push! (mut how) (passing flags))))))
    variadic))

;;; The shape that says `how`, or 0 if there is nothing to say.
(defn shape-of [(s (mut Adapter)) (how (ArrayList u64)) (variadic bool)] (-> u64)
  (let [(mut plain) (not variadic)]
    (for h how (when (!= h 0) (set! plain false)))
    (if plain
        (: 0 u64)
        (let [shape (graph/shape! (mut (.g s)) variadic)]
          (for h how (graph/shape-arg! (mut (.g s)) shape h))
          shape))))

;;; What call `v` calls: a symbol, called where it is, or an address.
;;; What the backend knows of the C library routine a symbol of this name is,
;;; or 0. On Mach-O (the AArch64 build) a C name is written with an underscore
;;; before it: Coil's table of symbols has `extern`s so written, and the
;;; routines it calls itself (memcpy for a large copy) as C writes them, the
;;; underscore put before them with the object; so one underscore is not part
;;; of the name. On ELF (x86-64) there is none, and `_memcpy` is another
;;; routine. Like LLVM, this takes a symbol with one of these names to be the C
;;; library's: Coil's own functions are named by their modules and never match.
(defn known-routine [(symbol (slice u8))] (-> i64)
  (let [name (target/machine-pick
               (if (and (> (len symbol) 0) (= (get symbol 0) #\_)) (slice/subslice symbol 1 (len symbol)) symbol)
               symbol)]
    (cond (= name "memcpy") graph/COPIES
          (= name "memmove") graph/MOVES
          (= name "memset") graph/FILLS
          (= name "memcmp") graph/COMPARES
          (or (= name "bcmp") (= name "strlen") (= name "strcmp") (= name "strncmp") (= name "memchr")) graph/READS
          :else 0)))

(defn callee [(s (mut Adapter)) (v u32)] (-> i32)
  (let [x (cir/val (.f s) v)]
    (if (= (.imm x) -1)
        (value (mut s) (cir/operand (.f s) x 0))
        (let [kind (known-routine (.name (asm/sym-at (.ta s) (cast u32 (.imm x)))))]
          (when (!= kind 0) (graph/routine-is! (mut (.g s)) (cast u64 (.imm x)) kind))
          (ir/symbol! (mut (.g s)) (cast u64 (.imm x)))))))

;;; The next result of call node `call` of CIR type `ty`, for CIR value `v`:
;;; integers and floating values each count their own.
(defn result! [(s (mut Adapter)) (call i32) (v u32) (ty i64)] (-> void)
  (cond
    (= ty cop/T-I128)
      (do (define-wide! (mut s) v
                        (ir/result! (mut (.g s)) W (cast u64 (.ints s)) call)
                        (ir/result! (mut (.g s)) W (cast u64 (+ (.ints s) 1)) call))
          (set! (.ints s) (+ (.ints s) 2)))
    (or (= ty cop/T-F32) (= ty cop/T-F64) (= ty cop/T-V128))
      (do (define! (mut s) v (ir/result! (mut (.g s)) (type-of (mut s) ty) (cast u64 (.floats s)) call))
          (set! (.floats s) (+ (.floats s) 1)))
    :else
      (do (define! (mut s) v (ir/result! (mut (.g s)) (type-of (mut s) ty) (cast u64 (.ints s)) call))
          (set! (.ints s) (+ (.ints s) 1)))))

;;; Every result of CIR call `v`, which graph node `call` made.
(defn results! [(s (mut Adapter)) (v u32) (call i32)] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        count (cast i64 (.aux x))]
    (set! (.ints s) 0)
    (set! (.floats s) 0)
    (when (> count 0) (result! (mut s) call v (cast i64 (.ty x))))
    (for i (range 1 count)
      (let [r (+ v (cast u32 i))]
        (result! (mut s) call r (cast i64 (.ty (cir/val f r))))))))

;;; A call under a convention of its own: each argument in the register the
;;; flags name, the registers it may write, and the register of its result.
;;; It is a call of a symbol, or machine code from the function's bytes.
(defn pinned-call! [(s (mut Adapter)) (v u32)] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        count (i64-of (.nops x))
        shape (graph/shape! (mut (.g s)) false)
        inline (= (.imm x) -1)
        target (if inline (word (mut s) 0) (ir/symbol! (mut (.g s)) (cast u64 (.imm x))))
        call (ir/call-node! (mut (.g s)) shape (.c s) target count)
        result (if (= (cast i64 (.aux x)) 255) -1 (cast i64 (.aux x)))
        (mut code) (ArrayList::new [u8] (.a s))]
    (for i (range 0 count)
      (graph/shape-arg! (mut (.g s)) shape
                        (| graph/PASS-PINNED (cast u64 (get (.argflags f) (+ (i64-of (.opb x)) i)))))
      (graph/set-input! (mut (.g s)) call (+ i 2) (value (mut s) (cir/operand f x (cast u32 i)))))
    (when inline
      (for i (range (i64-of (.block x)) (+ (i64-of (.block x)) (i64-of (.next x))))
        (push! (mut code) (get (.bytes f) i))))
    (graph/shape-pin! (mut (.g s)) shape (cast u64 (.imm2 x)) result (slice code))
    (set! (.c s) call)
    (when (>= result 0) (define! (mut s) v (ir/result! (mut (.g s)) W 0 call)))))

(defn call-out! [(s (mut Adapter)) (v u32)] (-> void)
  (unless (in-place! (mut s) v) (call-there! (mut s) v)))

(defn call-there! [(s (mut Adapter)) (v u32)] (-> void)
  (let [(mut values) (ArrayList::new [i32] (.a s))
        (mut how) (ArrayList::new [u64] (.a s))
        variadic (arguments! (mut s) v (mut values) (mut how))
        shape (shape-of (mut s) how variadic)
        call (ir/call-node! (mut (.g s)) shape (.c s) (callee (mut s) v) (len values))]
    (for i (range 0 (len values)) (graph/set-input! (mut (.g s)) call (+ i 2) (get values i)))
    (set! (.c s) call)
    (results! (mut s) v call)))

;;; The values a return gives back, in the order of their registers.
(defn return-values! [(s (mut Adapter)) (values (mut (ArrayList i32))) (v u32)] (-> void)
  (push! (mut values) (value (mut s) v))
  (when (wide? (mut s) v) (push! (mut values) (value-high (mut s) v))))

(defn return! [(s (mut Adapter)) (values (ArrayList i32))] (-> void)
  (if (> (.depth s) 0)
      ; In place of a call, a return is a way out to what follows the call.
      (do (push! (mut (.exits s)) (.c s))
          (set! (.exit-width s) (len values))
          (for v values (push! (mut (.exit-values s)) v)))
      ; Where the convention has the address a result was written to given
      ; back as well, it is what is returned.
      (let [back (and (target/machine-pick false true) (!= (.sret s) 0) (= (len values) 0))
            r (ir/return! (mut (.g s)) (.c s) (if back 1 (len values)))]
        (when back (graph/set-input! (mut (.g s)) r 1 (.sret s)))
        (for i (range 0 (len values)) (graph/set-input! (mut (.g s)) r (+ i 1) (get values i))))))

;;; A call that ends the function with the called function's results. It goes
;;; straight there, this function's frame given back first, when every
;;; argument is in a register and none is an address into this frame; if not,
;;; it is a call and a return of what it returned.
(defn tail-call! [(s (mut Adapter)) (v u32)] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        (mut values) (ArrayList::new [i32] (.a s))
        (mut how) (ArrayList::new [u64] (.a s))
        variadic (arguments! (mut s) v (mut values) (mut how))
        (mut ints) 0
        (mut floats) 0
        ; In place of a call, the frame given back would be the caller's.
        (mut direct) (and (not variadic) (= (.depth s) 0))]
    (for i (range 0 (len values))
      (let [h (get how i)
            float (ir/type-float? (graph/ty (.g s) (get values i)))]
        (when (!= (& h (| graph/PASS-INDIRECT graph/PASS-COPIED)) 0) (set! direct false))
        (if float (set! floats (+ floats 1)) (set! ints (+ ints 1)))
        (when (and (or (.frame-escapes f) (.escaped (.budget s))) (not float)) (set! direct false))))
    (when direct (set! (.tails (.budget s)) true))
    (if direct
        (let [call (ir/tailcall! (mut (.g s)) (if (> (cast i64 (.aux x)) 0) (type-of (mut s) (cast i64 (.ty x))) W)
                                 (shape-of (mut s) how false) (.c s) (callee (mut s) v) (len values))]
          (for i (range 0 (len values)) (graph/set-input! (mut (.g s)) call (+ i 2) (get values i))))
        (let [call (ir/call-node! (mut (.g s)) (shape-of (mut s) how variadic) (.c s) (callee (mut s) v) (len values))
              (mut back) (ArrayList::new [i32] (.a s))]
          (for i (range 0 (len values)) (graph/set-input! (mut (.g s)) call (+ i 2) (get values i)))
          (set! (.c s) call)
          (results! (mut s) v call)
          (for i (range 0 (cast i64 (.aux x))) (return-values! (mut s) (mut back) (+ v (cast u32 i))))
          (return! (mut s) back)))))

;; ---------------------------------------------------------------- integers

(defn zext-bool [(s (mut Adapter)) (c i32)] (-> i32)
  (ir/zext! (mut (.g s)) W c))

;;; a + b and whether it carried; a - b and whether it borrowed.
(defn carry [(s (mut Adapter)) (sum i32) (a i32)] (-> i32)
  (zext-bool (mut s) (ir/ult! (mut (.g s)) sum a)))

;;; `x` turned left or right by `n` within its low `w` bits, the rest zeros.
(defn rotate [(s (mut Adapter)) (left bool) (x i32) (n i32) (w i64)] (-> i32)
  (cond
    (= w 64) (if left (ir/rol! (mut (.g s)) W x n) (ir/ror! (mut (.g s)) W x n))
    (= w 32)
      (let [low (ir/trunc! (mut (.g s)) ir/T-U32 x)
            by (ir/trunc! (mut (.g s)) ir/T-U32 n)]
        (ir/zext! (mut (.g s)) W
                  (if left (ir/rol! (mut (.g s)) ir/T-U32 low by) (ir/ror! (mut (.g s)) ir/T-U32 low by))))
    :else
      ; The count taken within the width; a shift by the whole width is done
      ; in two steps so that a count of zero leaves the value alone.
      (let [count (ir/urem! (mut (.g s)) W n (word (mut s) (cast u64 w)))
            value (extended (mut s) x w false)
            other (ir/sub! (mut (.g s)) W (word (mut s) (cast u64 (- w 1))) count)
            one (word (mut s) 1)
            up (if left
                   (ir/shl! (mut (.g s)) W value count)
                   (ir/shl! (mut (.g s)) W (ir/shl! (mut (.g s)) W value one) other))
            down (if left
                     (ir/shr! (mut (.g s)) W (ir/shr! (mut (.g s)) W value one) other)
                     (ir/shr! (mut (.g s)) W value count))]
        (extended (mut s) (ir/or! (mut (.g s)) W up down) w false))))

;;; Whether a + b, a - b or a * b does not fit `w` bits, signed or not: 0 or 1.
(defn overflow [(s (mut Adapter)) (op i64) (a i32) (b i32) (w i64) (signed bool)] (-> i32)
  (let [g (.g s)]
    (cond
      (and (= w 64) (= op cop/OP-ADDO))
        (if signed (ir/saddo! (mut (.g s)) a b) (ir/uaddo! (mut (.g s)) a b))
      (and (= w 64) (= op cop/OP-SUBO))
        (if signed (ir/ssubo! (mut (.g s)) a b) (ir/usubo! (mut (.g s)) a b))
      (and (= w 64) (= op cop/OP-MULO))
        (if signed (ir/smulo! (mut (.g s)) a b) (ir/umulo! (mut (.g s)) a b))
      :else
        ; In 64 bits, with operands that are already extended: it fits if
        ; extending the answer again leaves it as it is. A product can also
        ; pass 64 bits, which its high half shows.
        (let [t (cond (= op cop/OP-ADDO) (ir/add! (mut (.g s)) W a b)
                      (= op cop/OP-SUBO) (ir/sub! (mut (.g s)) W a b)
                      :else (ir/mul! (mut (.g s)) W a b))
              narrow (ir/ne! (mut (.g s)) (extended (mut s) t w signed) t)]
          (if (and (= op cop/OP-MULO) (> w 32))
              (ir/or! (mut (.g s)) ir/T-BOOL narrow
                      (if signed (ir/smulo! (mut (.g s)) a b) (ir/umulo! (mut (.g s)) a b)))
              narrow)))))

;;; A comparison of two words by CIR's predicate.
(defn compare [(s (mut Adapter)) (predicate i64) (a i32) (b i32)] (-> i32)
  (cond (= predicate cir/P-EQ) (ir/eq! (mut (.g s)) a b)
        (= predicate cir/P-NE) (ir/ne! (mut (.g s)) a b)
        (= predicate cir/P-SLT) (ir/lt! (mut (.g s)) a b)
        (= predicate cir/P-SLE) (ir/le! (mut (.g s)) a b)
        (= predicate cir/P-SGT) (ir/lt! (mut (.g s)) b a)
        (= predicate cir/P-SGE) (ir/le! (mut (.g s)) b a)
        (= predicate cir/P-ULT) (ir/ult! (mut (.g s)) a b)
        (= predicate cir/P-ULE) (ir/ule! (mut (.g s)) a b)
        (= predicate cir/P-UGT) (ir/ult! (mut (.g s)) b a)
        (= predicate cir/P-UGE) (ir/ule! (mut (.g s)) b a)
        :else (fail (.f s) "an integer comparison the backend does not know")))

(defn both [(s (mut Adapter)) (a i32) (b i32)] (-> i32) (ir/and! (mut (.g s)) ir/T-BOOL a b))
(defn either [(s (mut Adapter)) (a i32) (b i32)] (-> i32) (ir/or! (mut (.g s)) ir/T-BOOL a b))
(defn negated [(s (mut Adapter)) (a i32)] (-> i32) (ir/not! (mut (.g s)) ir/T-BOOL a))

;;; A comparison of two floating values by CIR's predicate. The nodes' own
;;; comparisons are false when either side is not a number, but for FNE.
(defn float-compare [(s (mut Adapter)) (predicate i64) (a i32) (b i32)] (-> i32)
  (cond (= predicate cir/F-OEQ) (ir/feq! (mut (.g s)) a b)
        (= predicate cir/F-ONE) (either (mut s) (ir/flt! (mut (.g s)) a b) (ir/flt! (mut (.g s)) b a))
        (= predicate cir/F-OLT) (ir/flt! (mut (.g s)) a b)
        (= predicate cir/F-OLE) (ir/fle! (mut (.g s)) a b)
        (= predicate cir/F-OGT) (ir/flt! (mut (.g s)) b a)
        (= predicate cir/F-OGE) (ir/fle! (mut (.g s)) b a)
        (= predicate cir/F-UNE) (ir/fne! (mut (.g s)) a b)
        (= predicate cir/F-UEQ) (negated (mut s) (either (mut s) (ir/flt! (mut (.g s)) a b) (ir/flt! (mut (.g s)) b a)))
        (= predicate cir/F-ORD) (both (mut s) (ir/feq! (mut (.g s)) a a) (ir/feq! (mut (.g s)) b b))
        (= predicate cir/F-UNO) (either (mut s) (ir/fne! (mut (.g s)) a a) (ir/fne! (mut (.g s)) b b))
        (= predicate cir/F-ULT) (negated (mut s) (ir/fle! (mut (.g s)) b a))
        (= predicate cir/F-ULE) (negated (mut s) (ir/flt! (mut (.g s)) b a))
        (= predicate cir/F-UGT) (negated (mut s) (ir/fle! (mut (.g s)) a b))
        (= predicate cir/F-UGE) (negated (mut s) (ir/flt! (mut (.g s)) a b))
        :else (fail (.f s) "a floating comparison the backend does not know")))

;; ---------------------------------------------------------------- 128-bit integers

;;; A call of one of the library's routines for 128-bit division: (a, b) as
;;; two pairs of words, each pair in registers together, and a pair back.
(defn wide-divide! [(s (mut Adapter)) (v u32) (name (slice u8)) (a u32) (b u32)] (-> void)
  (let [shape (graph/shape! (mut (.g s)) false)
        routine (ir/symbol! (mut (.g s)) (routine name))
        call (ir/call-node! (mut (.g s)) shape (.c s) routine 4)]
    (for i (range 0 4)
      (graph/shape-arg! (mut (.g s)) shape (if (= (% i 2) 0) (| (: 1 u64) graph/PASS-ALIGN16) (: 0 u64))))
    (graph/set-input! (mut (.g s)) call 2 (value (mut s) a))
    (graph/set-input! (mut (.g s)) call 3 (value-high (mut s) a))
    (graph/set-input! (mut (.g s)) call 4 (value (mut s) b))
    (graph/set-input! (mut (.g s)) call 5 (value-high (mut s) b))
    (set! (.c s) call)
    (define-wide! (mut s) v (ir/result! (mut (.g s)) W 0 call) (ir/result! (mut (.g s)) W 1 call))))

;;; A 128-bit shift: the count is taken within 128. Each half moves by the
;;; count within 64, taking what the other half pushes its way; a count of 64
;;; or more then moves one half into the other's place.
(defn wide-shift! [(s (mut Adapter)) (v u32) (op i64) (a u32) (count u32)] (-> void)
  (let [low (value (mut s) a)
        high (value-high (mut s) a)
        n (value (mut s) count)
        by (ir/and! (mut (.g s)) W n (word (mut s) 63))
        across (ir/sub! (mut (.g s)) W (word (mut s) 63) by)
        one (word (mut s) 1)
        far (ir/ne! (mut (.g s)) (ir/and! (mut (.g s)) W n (word (mut s) 64)) (word (mut s) 0))
        zero (word (mut s) 0)]
    (if (= op cop/OP-SHL)
        (let [moved (ir/shl! (mut (.g s)) W low by)
              pushed (ir/shr! (mut (.g s)) W (ir/shr! (mut (.g s)) W low one) across)
              top (ir/or! (mut (.g s)) W (ir/shl! (mut (.g s)) W high by) pushed)]
          (define-wide! (mut s) v
                        (ir/cond! (mut (.g s)) W far zero moved)
                        (ir/cond! (mut (.g s)) W far moved top)))
        (let [signed (= op cop/OP-ASHR)
              moved (if signed (ir/sar! (mut (.g s)) W high by) (ir/shr! (mut (.g s)) W high by))
              pushed (ir/shl! (mut (.g s)) W (ir/shl! (mut (.g s)) W high one) across)
              bottom (ir/or! (mut (.g s)) W (ir/shr! (mut (.g s)) W low by) pushed)
              fill (if signed (ir/sar! (mut (.g s)) W high (word (mut s) 63)) zero)]
          (define-wide! (mut s) v
                        (ir/cond! (mut (.g s)) W far moved bottom)
                        (ir/cond! (mut (.g s)) W far fill moved))))))

;;; Whether a < b, as 128-bit integers signed or not.
(defn wide-less [(s (mut Adapter)) (signed bool) (a u32) (b u32)] (-> i32)
  (let [al (value (mut s) a)
        ah (value-high (mut s) a)
        bl (value (mut s) b)
        bh (value-high (mut s) b)]
    (either (mut s)
            (if signed (ir/lt! (mut (.g s)) ah bh) (ir/ult! (mut (.g s)) ah bh))
            (both (mut s) (ir/eq! (mut (.g s)) ah bh) (ir/ult! (mut (.g s)) al bl)))))

(defn wide-compare [(s (mut Adapter)) (predicate i64) (a u32) (b u32)] (-> i32)
  (let [same (ir/eq! (mut (.g s))
                     (ir/or! (mut (.g s)) W
                             (ir/xor! (mut (.g s)) W (value (mut s) a) (value (mut s) b))
                             (ir/xor! (mut (.g s)) W (value-high (mut s) a) (value-high (mut s) b)))
                     (word (mut s) 0))]
    (cond (= predicate cir/P-EQ) same
          (= predicate cir/P-NE) (negated (mut s) same)
          (= predicate cir/P-SLT) (wide-less (mut s) true a b)
          (= predicate cir/P-SLE) (negated (mut s) (wide-less (mut s) true b a))
          (= predicate cir/P-SGT) (wide-less (mut s) true b a)
          (= predicate cir/P-SGE) (negated (mut s) (wide-less (mut s) true a b))
          (= predicate cir/P-ULT) (wide-less (mut s) false a b)
          (= predicate cir/P-ULE) (negated (mut s) (wide-less (mut s) false b a))
          (= predicate cir/P-UGT) (wide-less (mut s) false b a)
          (= predicate cir/P-UGE) (negated (mut s) (wide-less (mut s) false a b))
          :else (fail (.f s) "an integer comparison the backend does not know"))))

;;; An instruction whose result is a 128-bit integer.
(defn wide! [(s (mut Adapter)) (v u32)] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        op (cast i64 (.op x))
        a (if (> (.nops x) (: 0 u32)) (cir/operand f x 0) (: 0 u32))
        b (if (> (.nops x) (: 1 u32)) (cir/operand f x 1) (: 0 u32))]
    (cond
      (= op cop/OP-ADD)
        (let [low (ir/add! (mut (.g s)) W (value (mut s) a) (value (mut s) b))]
          (define-wide! (mut s) v low
                        (ir/add! (mut (.g s)) W
                                 (ir/add! (mut (.g s)) W (value-high (mut s) a) (value-high (mut s) b))
                                 (carry (mut s) low (value (mut s) a)))))
      (= op cop/OP-SUB)
        (let [al (value (mut s) a)
              bl (value (mut s) b)]
          (define-wide! (mut s) v (ir/sub! (mut (.g s)) W al bl)
                        (ir/sub! (mut (.g s)) W
                                 (ir/sub! (mut (.g s)) W (value-high (mut s) a) (value-high (mut s) b))
                                 (zext-bool (mut s) (ir/ult! (mut (.g s)) al bl)))))
      (= op cop/OP-NEG)
        (let [al (value (mut s) a)
              zero (word (mut s) 0)]
          (define-wide! (mut s) v (ir/sub! (mut (.g s)) W zero al)
                        (ir/sub! (mut (.g s)) W
                                 (ir/sub! (mut (.g s)) W zero (value-high (mut s) a))
                                 (zext-bool (mut s) (ir/ne! (mut (.g s)) al zero)))))
      (= op cop/OP-MUL)
        (let [al (value (mut s) a)
              bl (value (mut s) b)]
          (define-wide! (mut s) v (ir/mul! (mut (.g s)) W al bl)
                        (ir/add! (mut (.g s)) W
                                 (ir/umulh! (mut (.g s)) W al bl)
                                 (ir/add! (mut (.g s)) W
                                          (ir/mul! (mut (.g s)) W al (value-high (mut s) b))
                                          (ir/mul! (mut (.g s)) W (value-high (mut s) a) bl)))))
      (= op cop/OP-AND)
        (define-wide! (mut s) v (ir/and! (mut (.g s)) W (value (mut s) a) (value (mut s) b))
                      (ir/and! (mut (.g s)) W (value-high (mut s) a) (value-high (mut s) b)))
      (= op cop/OP-OR)
        (define-wide! (mut s) v (ir/or! (mut (.g s)) W (value (mut s) a) (value (mut s) b))
                      (ir/or! (mut (.g s)) W (value-high (mut s) a) (value-high (mut s) b)))
      (= op cop/OP-XOR)
        (define-wide! (mut s) v (ir/xor! (mut (.g s)) W (value (mut s) a) (value (mut s) b))
                      (ir/xor! (mut (.g s)) W (value-high (mut s) a) (value-high (mut s) b)))
      (= op cop/OP-NOT)
        (define-wide! (mut s) v (ir/not! (mut (.g s)) W (value (mut s) a)) (ir/not! (mut (.g s)) W (value-high (mut s) a)))
      (or (= op cop/OP-SHL) (= op cop/OP-LSHR) (= op cop/OP-ASHR)) (wide-shift! (mut s) v op a b)
      (= op cop/OP-SDIV) (wide-divide! (mut s) v "__divti3" a b)
      (= op cop/OP-UDIV) (wide-divide! (mut s) v "__udivti3" a b)
      (= op cop/OP-SREM) (wide-divide! (mut s) v "__modti3" a b)
      (= op cop/OP-UREM) (wide-divide! (mut s) v "__umodti3" a b)
      (= op cop/OP-SEXT)
        (define-wide! (mut s) v (value (mut s) a) (ir/sar! (mut (.g s)) W (value (mut s) a) (word (mut s) 63)))
      (= op cop/OP-ZEXT) (define-wide! (mut s) v (value (mut s) a) (word (mut s) 0))
      (= op cop/OP-PAIR) (define-wide! (mut s) v (value (mut s) a) (value (mut s) b))
      (= op cop/OP-COPY) (define-wide! (mut s) v (value (mut s) a) (value-high (mut s) a))
      (= op cop/OP-SELECT)
        (let [c (condition (mut s) a)
              y (cir/operand f x 2)]
          (define-wide! (mut s) v (ir/cond! (mut (.g s)) W c (value (mut s) b) (value (mut s) y))
                        (ir/cond! (mut (.g s)) W c (value-high (mut s) b) (value-high (mut s) y))))
      (= op cop/OP-LOAD)
        (let [at (address (mut s) a (.imm x))
              low (ir/load-node! (mut (.g s)) W (volatile (mut s) v) (.c s) at)
              high (ir/load-node! (mut (.g s)) W (volatile (mut s) v) low
                                  (ir/add! (mut (.g s)) W at (word (mut s) 8)))]
          (set! (.c s) high)
          (define-wide! (mut s) v low high))
      :else (fail f "a 128-bit operation the backend does not know"))))

;; ---------------------------------------------------------------- memory

;;; base + offset as an address.
(defn address [(s (mut Adapter)) (base u32) (offset i64)] (-> i32)
  (if (= offset 0)
      (value (mut s) base)
      (ir/add! (mut (.g s)) W (value (mut s) base) (word (mut s) (cast u64 offset)))))

(defn volatile [(s (mut Adapter)) (v u32)] (-> u64)
  (if (cir/volatile? (.f s) v) (: 1 u64) (: 0 u64)))

(defn read! [(s (mut Adapter)) (v u32)] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        ty (cast i64 (.ty x))
        bytes (& (.imm2 x) 255)
        signed (!= (& (.imm2 x) 256) 0)
        at (address (mut s) (cir/operand f x 0) (.imm x))
        how (volatile (mut s) v)]
    (cond
      (= ty cop/T-I64)
        (let [type (narrow-type (mut s) bytes signed)
              read (ir/load-node! (mut (.g s)) type how (.c s) at)]
          (set! (.c s) read)
          (define! (mut s) v (cond (= bytes 8) read
                                   signed (ir/sext! (mut (.g s)) W read)
                                   :else (ir/zext! (mut (.g s)) W read))))
      (= ty cop/T-V128)
        (if (= bytes 16)
            (let [read (ir/load-node! (mut (.g s)) ir/T-V128 how (.c s) at)]
              (set! (.c s) read)
              (define! (mut s) v read))
            ; Fewer bytes are the vector's low ones, the rest zero: they go by
            ; way of sixteen bytes of the frame, zeroed first.
            (let [part (narrow-type (mut s) bytes false)
                  whole (ir/slot! (mut (.g s)) 16)
                  zero (word (mut s) 0)
                  low (ir/store-node! (mut (.g s)) 0 (.c s) whole zero)
                  high (ir/store-node! (mut (.g s)) 0 low (ir/add! (mut (.g s)) W whole (word (mut s) 8)) zero)
                  read (ir/load-node! (mut (.g s)) part how high at)
                  kept (ir/store-node! (mut (.g s)) 0 read whole read)
                  all (ir/load-node! (mut (.g s)) ir/T-V128 0 kept whole)]
              (when (and (!= bytes 8) (!= bytes 4)) (fail f "a vector read from neither four, eight nor sixteen bytes"))
              (set! (.c s) all)
              (define! (mut s) v all)))
      :else
        (let [read (ir/load-node! (mut (.g s)) (type-of (mut s) ty) how (.c s) at)]
          (set! (.c s) read)
          (define! (mut s) v read)))))

(defn write! [(s (mut Adapter)) (v u32)] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        what (cir/operand f x 1)
        ty (cast i64 (.ty (cir/val f what)))
        bytes (.imm2 x)
        at (address (mut s) (cir/operand f x 0) (.imm x))
        how (volatile (mut s) v)]
    (cond
      (= ty cop/T-I128)
        (let [low (ir/store-node! (mut (.g s)) how (.c s) at (value (mut s) what))]
          (set! (.c s) (ir/store-node! (mut (.g s)) how low (ir/add! (mut (.g s)) W at (word (mut s) 8))
                                       (value-high (mut s) what))))
      (and (= ty cop/T-I64) (!= bytes 8))
        (set! (.c s) (ir/store-node! (mut (.g s)) how (.c s) at
                                     (ir/trunc! (mut (.g s)) (narrow-type (mut s) bytes false) (value (mut s) what))))
      ; A vector's low bytes: by way of sixteen bytes of the frame.
      (and (= ty cop/T-V128) (!= bytes 16))
        (let [whole (ir/slot! (mut (.g s)) 16)
              kept (ir/store-node! (mut (.g s)) 0 (.c s) whole (value (mut s) what))
              part (ir/load-node! (mut (.g s)) (narrow-type (mut s) bytes false) 0 kept whole)]
          (when (and (!= bytes 8) (!= bytes 4)) (fail f "a vector written to neither four, eight nor sixteen bytes"))
          (set! (.c s) (ir/store-node! (mut (.g s)) how part at part)))
      :else (set! (.c s) (ir/store-node! (mut (.g s)) how (.c s) at (value (mut s) what))))))

;;; A call of one of the C library's routines that take three words.
(defn routine! [(s (mut Adapter)) (v u32) (name (slice u8))] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        call (ir/call-node! (mut (.g s)) 0 (.c s)
                            (ir/symbol! (mut (.g s)) (routine name)) 3)]
    (graph/routine-is! (mut (.g s)) (routine name) (known-routine name))
    (for i (range 0 3) (graph/set-input! (mut (.g s)) call (+ i 2) (value (mut s) (cir/operand f x (cast u32 i)))))
    (set! (.c s) call)))

;;; Something done to memory other threads share, on `bytes` bytes of it: the
;;; operands cut to that width, and what was there carried up with zeros.
(defn shared! [(s (mut Adapter)) (v u32)] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        op (cast i64 (.op x))
        bytes (.imm2 x)
        type (narrow-type (mut s) bytes false)
        at (value (mut s) (cir/operand f x 0))
        c (.c s)]
    (cond
      (= op cop/OP-ATOMIC-LOAD)
        (let [read (ir/atomic-load! (mut (.g s)) type c at)]
          (set! (.c s) read)
          (define! (mut s) v (if (= bytes 8) read (ir/zext! (mut (.g s)) W read))))
      (= op cop/OP-ATOMIC-STORE)
        (let [what (value (mut s) (cir/operand f x 1))]
          (set! (.c s) (ir/atomic-store! (mut (.g s)) c at (if (= bytes 8) what (ir/trunc! (mut (.g s)) type what)))))
      (= op cop/OP-CMPXCHG)
        (let [expected (value (mut s) (cir/operand f x 1))
              new (value (mut s) (cir/operand f x 2))
              was (ir/cas! (mut (.g s)) type c at
                           (if (= bytes 8) expected (ir/trunc! (mut (.g s)) type expected))
                           (if (= bytes 8) new (ir/trunc! (mut (.g s)) type new)))]
          (set! (.c s) was)
          (define! (mut s) v (if (= bytes 8) was (ir/zext! (mut (.g s)) W was))))
      :else
        (let [wide (value (mut s) (cir/operand f x 1))
              what (if (= bytes 8) wide (ir/trunc! (mut (.g s)) type wide))
              how (.imm x)
              was (cond (= how 0) (ir/fetch-add! (mut (.g s)) type c at what)
                        (= how 1) (ir/fetch-sub! (mut (.g s)) type c at what)
                        (= how 2) (ir/fetch-and! (mut (.g s)) type c at what)
                        (= how 3) (ir/fetch-or! (mut (.g s)) type c at what)
                        (= how 4) (ir/fetch-xor! (mut (.g s)) type c at what)
                        (= how 5) (ir/swap! (mut (.g s)) type c at what)
                        (= how 6) (ir/fetch-smax! (mut (.g s)) type c at what)
                        (= how 7) (ir/fetch-smin! (mut (.g s)) type c at what)
                        (= how 8) (ir/fetch-umax! (mut (.g s)) type c at what)
                        :else (ir/fetch-umin! (mut (.g s)) type c at what))]
          (set! (.c s) was)
          (define! (mut s) v (if (= bytes 8) was (ir/zext! (mut (.g s)) W was)))))))

;; ---------------------------------------------------------------- one instruction

(defn instruction! [(s (mut Adapter)) (v u32)] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        op (cast i64 (.op x))
        ty (cast i64 (.ty x))
        type (if (= ty cop/T-VOID) W (type-of (mut s) ty))
        a (if (> (.nops x) (: 0 u32)) (cir/operand f x 0) (: 0 u32))
        b (if (> (.nops x) (: 1 u32)) (cir/operand f x 1) (: 0 u32))]
    (cond
      (= op cop/OP-CALL) (call-out! (mut s) v)
      (= op cop/OP-STORE) (write! (mut s) v)
      (and (= ty cop/T-I128) (!= op cop/OP-PHI) (!= op cop/OP-CALLRES)) (wide! (mut s) v)
      (= op cop/OP-LOAD) (read! (mut s) v)
      ; Words.
      (= op cop/OP-ADD) (define! (mut s) v (ir/add! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-SUB) (define! (mut s) v (ir/sub! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-MUL) (define! (mut s) v (ir/mul! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-AND) (define! (mut s) v (ir/and! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-OR) (define! (mut s) v (ir/or! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-XOR) (define! (mut s) v (ir/xor! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-SHL) (define! (mut s) v (ir/shl! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-LSHR) (define! (mut s) v (ir/shr! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-ASHR) (define! (mut s) v (ir/sar! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-SDIV) (define! (mut s) v (ir/sdiv! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-UDIV) (define! (mut s) v (ir/udiv! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-SREM) (define! (mut s) v (ir/srem! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-UREM) (define! (mut s) v (ir/urem! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-ROTL) (define! (mut s) v (rotate (mut s) true (value (mut s) a) (value (mut s) b) (.imm x)))
      (= op cop/OP-ROTR) (define! (mut s) v (rotate (mut s) false (value (mut s) a) (value (mut s) b) (.imm x)))
      (= op cop/OP-NEG) (define! (mut s) v (ir/neg! (mut (.g s)) W (value (mut s) a)))
      (= op cop/OP-NOT) (define! (mut s) v (ir/not! (mut (.g s)) W (value (mut s) a)))
      (= op cop/OP-SMULH) (define! (mut s) v (ir/smulh! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-UMULH) (define! (mut s) v (ir/umulh! (mut (.g s)) W (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-SEXT) (define! (mut s) v (extended (mut s) (value (mut s) a) (.imm x) true))
      (= op cop/OP-ZEXT) (define! (mut s) v (extended (mut s) (value (mut s) a) (.imm x) false))
      (= op cop/OP-LO) (define! (mut s) v (value (mut s) a))
      (= op cop/OP-HI) (define! (mut s) v (value-high (mut s) a))
      ; Bits, within the low `imm` of them.
      (= op cop/OP-CLZ)
        (define! (mut s) v
                 (ir/sub! (mut (.g s)) W
                          (ir/clz! (mut (.g s)) W (extended (mut s) (value (mut s) a) (.imm x) false))
                          (word (mut s) (cast u64 (- 64 (.imm x))))))
      (= op cop/OP-CTZ)
        (define! (mut s) v
                 (ir/ctz! (mut (.g s)) W
                          (if (>= (.imm x) 64)
                              (value (mut s) a)
                              (ir/or! (mut (.g s)) W (value (mut s) a) (word (mut s) (<< (: 1 u64) (cast u64 (.imm x))))))))
      (= op cop/OP-POPCNT)
        (define! (mut s) v (ir/popcnt! (mut (.g s)) W (extended (mut s) (value (mut s) a) (.imm x) false)))
      (= op cop/OP-BSWAP)
        (define! (mut s) v (ir/shr! (mut (.g s)) W (ir/bswap! (mut (.g s)) W (value (mut s) a))
                                    (word (mut s) (cast u64 (- 64 (.imm x))))))
      (= op cop/OP-BITREV)
        (define! (mut s) v (ir/shr! (mut (.g s)) W (ir/bitrev! (mut (.g s)) W (value (mut s) a))
                                    (word (mut s) (cast u64 (- 64 (.imm x))))))
      (= op cop/OP-ICMP)
        (define-truth! (mut s) v
                       (if (wide? (mut s) a)
                           (wide-compare (mut s) (.imm x) a b)
                           (compare (mut s) (.imm x) (value (mut s) a) (value (mut s) b))))
      (= op cop/OP-SELECT)
        (define! (mut s) v (ir/cond! (mut (.g s)) type (condition (mut s) a) (value (mut s) b)
                                     (value (mut s) (cir/operand f x 2))))
      (or (= op cop/OP-ADDO) (= op cop/OP-SUBO) (= op cop/OP-MULO))
        (define-truth! (mut s) v (overflow (mut s) op (value (mut s) a) (value (mut s) b) (.imm x) (!= (.imm2 x) 0)))
      ; Floating point.
      (= op cop/OP-FADD) (define! (mut s) v (ir/fadd! (mut (.g s)) type (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-FSUB) (define! (mut s) v (ir/fsub! (mut (.g s)) type (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-FMUL) (define! (mut s) v (ir/fmul! (mut (.g s)) type (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-FDIV) (define! (mut s) v (ir/fdiv! (mut (.g s)) type (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-FNEG) (define! (mut s) v (ir/fneg! (mut (.g s)) type (value (mut s) a)))
      (= op cop/OP-FABS) (define! (mut s) v (ir/fabs! (mut (.g s)) type (value (mut s) a)))
      (= op cop/OP-FSQRT) (define! (mut s) v (ir/fsqrt! (mut (.g s)) type (value (mut s) a)))
      (= op cop/OP-FMIN) (define! (mut s) v (ir/fmin! (mut (.g s)) type (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-FMAX) (define! (mut s) v (ir/fmax! (mut (.g s)) type (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-FMINNM) (define! (mut s) v (ir/fmin-number! (mut (.g s)) type (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-FMAXNM) (define! (mut s) v (ir/fmax-number! (mut (.g s)) type (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-FRINT)
        (define! (mut s) v
                 (cond (= (.imm x) 0) (ir/round-even! (mut (.g s)) type (value (mut s) a))
                       (= (.imm x) 1) (ir/round-up! (mut (.g s)) type (value (mut s) a))
                       (= (.imm x) 2) (ir/round-down! (mut (.g s)) type (value (mut s) a))
                       (= (.imm x) 3) (ir/round-zero! (mut (.g s)) type (value (mut s) a))
                       :else (ir/round-away! (mut (.g s)) type (value (mut s) a))))
      (= op cop/OP-FMA)
        (define! (mut s) v (ir/fma! (mut (.g s)) type (value (mut s) a) (value (mut s) b)
                                    (value (mut s) (cir/operand f x 2))))
      (= op cop/OP-FCMP) (define-truth! (mut s) v (float-compare (mut s) (.imm x) (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-FPEXT) (define! (mut s) v (ir/fext! (mut (.g s)) ir/T-F64 (value (mut s) a)))
      (= op cop/OP-FPTRUNC) (define! (mut s) v (ir/ftrunc! (mut (.g s)) ir/T-F32 (value (mut s) a)))
      (= op cop/OP-SITOFP) (define! (mut s) v (ir/sitof! (mut (.g s)) type (value (mut s) a)))
      (= op cop/OP-UITOFP) (define! (mut s) v (ir/uitof! (mut (.g s)) type (value (mut s) a)))
      (= op cop/OP-FPTOSI)
        (define! (mut s) v
                 (if (= (.imm x) 32)
                     (ir/sext! (mut (.g s)) W (ir/ftosi! (mut (.g s)) ir/T-I32 (value (mut s) a)))
                     (ir/trunc! (mut (.g s)) W (ir/ftosi! (mut (.g s)) ir/T-I64 (value (mut s) a)))))
      (= op cop/OP-FPTOUI)
        (define! (mut s) v
                 (if (= (.imm x) 32)
                     (ir/zext! (mut (.g s)) W (ir/ftoui! (mut (.g s)) ir/T-U32 (value (mut s) a)))
                     (ir/trunc! (mut (.g s)) W (ir/ftoui! (mut (.g s)) ir/T-U64 (value (mut s) a)))))
      (= op cop/OP-BITCAST)
        (let [from (cast i64 (.ty (cir/val f a)))]
          (define! (mut s) v
                   (cond (= from ty) (value (mut s) a)
                         ; A word's low 32 bits are a single-precision value's.
                         (= ty cop/T-F32)
                           (ir/bitcast! (mut (.g s)) ir/T-F32 (ir/trunc! (mut (.g s)) ir/T-U32 (value (mut s) a)))
                         (= from cop/T-F32)
                           (ir/zext! (mut (.g s)) W (ir/bitcast! (mut (.g s)) ir/T-U32 (value (mut s) a)))
                         (or (= ty cop/T-F64) (= from cop/T-F64)) (ir/bitcast! (mut (.g s)) type (value (mut s) a))
                         :else (fail f "the bits of a value taken as a type the backend does not know"))))
      (= op cop/OP-COPY) (define! (mut s) v (value (mut s) a))
      ; Addresses and memory.
      (= op cop/OP-PTRADD)
        (let [scaled (if (= (.imm x) 0)
                         (value (mut s) a)
                         (ir/add! (mut (.g s)) W (value (mut s) a)
                                  (ir/mul! (mut (.g s)) W (value (mut s) b) (word (mut s) (cast u64 (.imm x))))))]
          (define! (mut s) v (if (= (.imm2 x) 0) scaled (ir/add! (mut (.g s)) W scaled (word (mut s) (cast u64 (.imm2 x)))))))
      (= op cop/OP-ADDI) (define! (mut s) v (address (mut s) a (.imm x)))
      (= op cop/OP-MEMCPY)
        (set! (.c s) (ir/copy! (mut (.g s)) (cast u64 (.imm x)) (.c s) (value (mut s) a) (value (mut s) b)))
      (= op cop/OP-MEMZERO)
        (set! (.c s) (ir/fill! (mut (.g s)) (cast u64 (.imm x)) (.c s) (value (mut s) a)
                               (ir/const! (mut (.g s)) ir/T-U8 0)))
      (= op cop/OP-MEMCPYV) (routine! (mut s) v "memcpy")
      (= op cop/OP-MEMMOVEV) (routine! (mut s) v "memmove")
      (= op cop/OP-MEMSETV) (routine! (mut s) v "memset")
      (= op cop/OP-DYNALLOCA)
        (let [room (ir/reserve! (mut (.g s)) (.c s) (ir/trunc! (mut (.g s)) ir/T-U64 (value (mut s) a)))]
          (set! (.c s) room)
          (define! (mut s) v room))
      (or (= op cop/OP-ATOMIC-RMW) (= op cop/OP-CMPXCHG) (= op cop/OP-ATOMIC-LOAD) (= op cop/OP-ATOMIC-STORE))
        (shared! (mut s) v)
      (= op cop/OP-FENCE) (set! (.c s) (ir/fence! (mut (.g s)) (.c s)))
      (= op cop/OP-SHIMCALL) (pinned-call! (mut s) v)
      :else (fail f "an operation the backend does not know"))))


;; ---------------------------------------------------------------- the end of a block

(defn terminator! [(s (mut Adapter)) (b u32) (v u32)] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        op (cast i64 (.op x))
        first (cast i64 (get (.first-out s) (i64-of b)))]
    (cond
      (= op cop/OP-BR) (connect! (mut s) b first (.c s))
      (= op cop/OP-CONDBR)
        (if (= (cir/operand f x (.nops x)) (cir/operand f x (+ (.nops x) (: 1 u32))))
            (connect! (mut s) b first (.c s))
            (let [branch (ir/if! (mut (.g s)) (.c s) (condition (mut s) (cir/operand f x 0)))]
              (connect! (mut s) b first (ir/true! (mut (.g s)) branch))
              (connect! (mut s) b (+ first 1) (ir/false! (mut (.g s)) branch))))
      (= op cop/OP-SWITCH)
        (let [switch (ir/switch! (mut (.g s)) (.c s) (value (mut s) (cir/operand f x 0)))
              cases (- (i64-of (- (.ntotal x) (.nops x))) 1)]
          (connect! (mut s) b first (ir/default! (mut (.g s)) switch))
          (for i (range 0 cases)
            (connect! (mut s) b (+ first (+ i 1))
                      (ir/case! (mut (.g s)) (get (.case-values f) (+ (.imm x) i)) switch))))
      (= op cop/OP-RET)
        (let [(mut values) (ArrayList::new [i32] (.a s))]
          (for i (range 0 (i64-of (.nops x))) (return-values! (mut s) (mut values) (cir/operand f x (cast u32 i))))
          (return! (mut s) values))
      (= op cop/OP-UNREACHABLE) (do (ir/trap! (mut (.g s)) (.c s)) 0)
      (= op cop/OP-TAILCALL) (tail-call! (mut s) v)
      :else (fail f "a block does not end in a branch, a switch, a return or a trap"))))

;; ---------------------------------------------------------------- out

;;; The assembler's name for what an instruction of the backend's needs of a
;;; symbol's address.
(defn reloc-kind [(f (ptr cir/Func)) (op i64)] (-> i64)
  (let [name (isa/reloc-name (isa/reloc-of op))]
    (cond (= name "branch26") asm/R-BRANCH26
          (= name "page21") asm/R-PAGE21
          (= name "pageoff12") asm/R-PAGEOFF12
          (= name "got-page21") asm/R-GOT-PAGE21
          (= name "got-pageoff12") asm/R-GOT-PAGEOFF12
          (= name "plt32") asm/R-PLT32
          (= name "pc32") asm/R-PCREL32
          (= name "gotpcrel") asm/R-GOTPCREL32
          :else (fail f "the assembler has no relocation of this kind"))))

;;; Whether to print a function's graph, before and after the plan, and its code.
(defn showing? [(s (mut Adapter))] (-> bool)
  (let [want (.show (.settings s))]
    (and (!= (primitive/cast u64 want) 0) (= (str/from-cstr want) (.name (.f s))))))

;;; Compiles the graph into `out`. `index` is which of its module's functions
;;; this is, or -1 for a function on its own.
(defn emit! [(s (mut Adapter)) (level i32) (index i64) (out (ptr Compiled))] (-> void)
  (let [f (.f s)
        settings (.settings s)
        problem (if (.check settings) (ir/verify (.g s)) "")]
    (when (!= problem "") (fail f problem))
    (when (showing? (mut s))
      (println "; {} as built" (.name f))
      (ir/dump (.g s))
      (when (> (graph/mark-count (.g s)) 0)
        (print "; blocks start at nodes (first made, head):")
        (for i (range 0 (graph/mark-count (.g s)))
          (print " {}:{}" (graph/mark-first (.g s) i) (graph/mark-head (.g s) i)))
        (println "")))
    (when (and (!= (primitive/cast u64 (.show settings)) 0) (= (str/from-cstr (.show settings)) "?"))
      (println "; {} {}" index (.name f)))
    ; -O0 and -O1 compile straight from CIR (compile-quick!), never from a graph.
    (when (< (cast i64 level) 2) (fail f "a graph was built to be compiled below -O2"))
    (if (and (>= (.only settings) 0) (>= index (.only settings)))
        (emit-direct! (mut s) out)
        (emit-optimized! (mut s) index out))))

;;; Functions a DECLARATIVE_ONLY setting leaves unoptimized at -O2: compiled
;;; straight from CIR, as -O0 and -O1 are, the graph built for them unused.
(defn emit-direct! [(s (mut Adapter)) (out (ptr Compiled))] (-> void)
  (let [f (.f s)
        cx (box! (.a s) dst/State (dst/create (.a s)))]
    (set! (.f cx) f)
    (set! (.tmp cx) (.a s))
    (dst/begin! cx)
    (direct-setup! cx f (.ta s) (.debug s))
    (dplans/quick cx)
    (unless (= (.refusal cx) 0) (refused f cx))
    (direct-output! (mut s) cx out (.debug s))))

(defn emit-optimized! [(s (mut Adapter)) (index i64) (out (ptr Compiled))] (-> void)
  (let [settings (.settings s)
        (mut cx) (st/create (.g s) (.a s))]
    (st/begin! (mut cx))
    (set! (.trial cx) (or (< (.trial settings) 0) (< index (.trial settings))))
    (set! (.off cx) (if (or (< (.off-at settings) 0) (= index (.off-at settings))) (.off settings) 0))
    (set! (.near-routines cx) true)
    (set! (.debugging cx) (.debug s))
    (set! (.self-symbol cx) (+ (.self s) 1))
    (set! (.copy-routine cx) (+ (cast i64 (routine "memcpy")) 1))
    (set! (.fill-routine cx) (+ (cast i64 (routine "memset")) 1))
    (plans/default (mut cx))
    (output! (mut s) out (.code cx) (.reloc-at cx) (.reloc-symbol cx) (.reloc-op cx) (.row-at cx) (.row-from cx))
    (graph-objects! (mut s) (.g cx) out (.object-at cx))))

;;; What a compiled function is, from whichever unit compiled it: its code,
;;; the words that depend on a symbol's address, and for a debugger where
;;; each place in the source starts and how far each frame object is from the
;;; frame register.
(defn output! [(s (mut Adapter)) (out (ptr Compiled)) (code (ArrayList u8))
               (reloc-at (ArrayList i64)) (reloc-symbol (ArrayList i64)) (reloc-op (ArrayList i64))
               (row-at (ArrayList i64)) (row-from (ArrayList i64))] (-> void)
  (let [f (.f s)]
    (when (showing? (mut s))
      (println "; {} as compiled" (.name f))
      (ir/dump (.g s))
      (print "code:")
      (for b code (print " {:02x}" b))
      (println ""))
    (clear! (mut (.code out)))
    (clear! (mut (.reloc-at out)))
    (clear! (mut (.reloc-symbol out)))
    (clear! (mut (.reloc-kind out)))
    (extend! (mut (.code out)) (.data code) (len code))
    (for i (range 0 (len reloc-at))
      (push! (mut (.reloc-at out)) (get reloc-at i))
      (push! (mut (.reloc-symbol out)) (get reloc-symbol i))
      (push! (mut (.reloc-kind out)) (reloc-kind f (get reloc-op i))))
    (clear! (mut (.rows out)))
    (clear! (mut (.marks out)))
    (clear! (mut (.objects out)))
    (when (.debug s)
      ; A row where the place in the source changes; a mark where a value's code first starts.
      (let [(mut seen) (ArrayList::new [bool] (.a s))
            (mut last) (: 0 u64)]
        (for _ (range 0 (i64-of (cir/value-count f))) (push! (mut seen) false))
        (for i (range 0 (len row-at))
          (let [v (- (get row-from i) 1)
                at (cast u64 (get row-at i))
                place (get (.locs f) v)]
            (unless (get seen v)
              (set! (mut seen) v true)
              (push! (mut (.marks out)) (cast u64 v))
              (push! (mut (.marks out)) at))
            (when (and (!= place 0) (!= place last))
              (push! (mut (.rows out)) at)
              (push! (mut (.rows out)) place)
              (set! last place))))))
    (set! (.done out) true)))

;;; For a debugger, of a function compiled through the graph: each frame
;;; object is so far below the frame register; one nothing uses is nowhere.
(defn graph-objects! [(s (mut Adapter)) (g graph/Graph) (out (ptr Compiled)) (object-at (ArrayList i64))] (-> void)
  (when (.debug s)
    (for v (.allocas (.f s))
      (let [(mut n) (get (.node s) (i64-of v))]
        (when (and (!= n 0) (not (graph/dead? g n)) (= (graph/op g n) ir/AND))
          (set! n (graph/input g (graph/input g n 0) 0)))
        (push! (mut (.objects out))
               (if (and (!= n 0) (not (graph/dead? g n)) (= (graph/op g n) ir/SLOT))
                   (- 0 (get object-at (cast i64 n)))
                   0))))))

;;; Puts compiled code in the assembler's text, as `symbol`.
(defn place-code! [(ta (ptr asm/Asm)) (symbol u32) (c (ptr Compiled))] (-> void)
  (unless (.done c) (panic "declarative backend: a function is put in place before it is compiled"))
  (let [code (.code c)
        at (asm/sect-append! ta asm/SEC-TEXT (.data code) (len code) isa/ALIGN)]
    (for i (range 0 (len (.reloc-at c)))
      (let [named (get (.reloc-symbol c) i)
            to (if (>= named RUNTIME)
                   (asm/runtime-sym! ta (routine-name (- named RUNTIME)))
                   (cast u32 named))]
        (asm/reloc! ta asm/SEC-TEXT (+ at (get (.reloc-at c) i)) to (get (.reloc-kind c) i) 0)))
    (asm/sym-def! ta symbol asm/SEC-TEXT at (len code))))

;;; An adapter for `f`, building into graph `g`.
(defn adapter [(f (ptr cir/Func)) (ta (ptr asm/Asm)) (g graph/Graph) (a (dyn Allocator)) (module (ptr Module))
               (settings Settings) (budget (ptr Budget)) (depth i64)] (-> Adapter)
  (let [(mut s) (adapter-empty g a)]
    (adapter-ready! (mut s) f ta a module settings budget depth)
    s))

;;; An adapter with empty lists from `lists`, for `adapter-ready!`.
(defn adapter-empty [(g graph/Graph) (lists (dyn Allocator))] (-> Adapter)
  (let [a lists]
    (Adapter
      :f (primitive/cast (ptr cir/Func) 0) :ta (primitive/cast (ptr asm/Asm) 0) :g g :a a
      :node (ArrayList::new [i32] a) :high (ArrayList::new [i32] a) :truth (ArrayList::new [i32] a)
      :seen (ArrayList::new [u8] a) :first-out (ArrayList::new [i32] a)
      :targets (ArrayList::new [u32] a) :backward (ArrayList::new [bool] a)
      :forward-in (ArrayList::new [i32] a) :backward-in (ArrayList::new [i32] a)
      :forward-done (ArrayList::new [i32] a) :backward-done (ArrayList::new [i32] a)
      :merge (ArrayList::new [i32] a) :loop (ArrayList::new [i32] a) :enters (ArrayList::new [i32] a)
      :heads (ArrayList::new [i32] a)
      :before (ArrayList::new [i32] a) :before-high (ArrayList::new [i32] a)
      :order (ArrayList::new [u32] a)
      :c 0 :params 0 :ints 0 :floats 0
      :module (primitive/cast (ptr Module) 0) :settings (zeroed Settings) :budget (primitive/cast (ptr Budget) 0)
      :self -1 :debug false :sret 0 :level 0 :again 0 :again-phis (ArrayList::new [i32] a) :again-done 0 :depth 0
      :exits (ArrayList::new [i32] a) :exit-values (ArrayList::new [i32] a) :exit-width 0)))

;;; The adapter ready for `f`: its lists emptied and sized to `f`'s values and
;;; blocks, what it makes for itself from `a`.
(defn adapter-ready! [(s (mut Adapter)) (f (ptr cir/Func)) (ta (ptr asm/Asm)) (a (dyn Allocator)) (module (ptr Module))
                      (settings Settings) (budget (ptr Budget)) (depth i64)] (-> void)
  (set! (.f s) f)
  (set! (.ta s) ta)
  (set! (.a s) a)
  (set! (.module s) module)
  (set! (.settings s) settings)
  (set! (.budget s) budget)
  (set! (.depth s) depth)
  (set! (.c s) 0)
  (set! (.params s) 0)
  (set! (.ints s) 0)
  (set! (.floats s) 0)
  (set! (.self s) -1)
  (set! (.debug s) false)
  (set! (.sret s) 0)
  (set! (.level s) 0)
  (set! (.again s) 0)
  (set! (.again-done s) 0)
  (set! (.exit-width s) 0)
  (let [values (i64-of (cir/value-count f))
        blocks (i64-of (cir/block-count f))]
    (clear! (mut (.node s)))
    (extend-zeroed! (mut (.node s)) values)
    (clear! (mut (.high s)))
    (extend-zeroed! (mut (.high s)) values)
    (clear! (mut (.truth s)))
    (extend-zeroed! (mut (.truth s)) values)
    (clear! (mut (.before s)))
    (extend-zeroed! (mut (.before s)) values)
    (clear! (mut (.before-high s)))
    (extend-zeroed! (mut (.before-high s)) values)
    (clear! (mut (.seen s)))
    (extend-zeroed! (mut (.seen s)) blocks)
    (clear! (mut (.forward-in s)))
    (extend-zeroed! (mut (.forward-in s)) blocks)
    (clear! (mut (.backward-in s)))
    (extend-zeroed! (mut (.backward-in s)) blocks)
    (clear! (mut (.forward-done s)))
    (extend-zeroed! (mut (.forward-done s)) blocks)
    (clear! (mut (.backward-done s)))
    (extend-zeroed! (mut (.backward-done s)) blocks)
    (clear! (mut (.merge s)))
    (extend-zeroed! (mut (.merge s)) blocks)
    (clear! (mut (.loop s)))
    (extend-zeroed! (mut (.loop s)) blocks)
    (clear! (mut (.enters s)))
    (extend-zeroed! (mut (.enters s)) blocks)
    (clear! (mut (.heads s)))
    (extend-zeroed! (mut (.heads s)) blocks)
    (clear! (mut (.first-out s)))
    (clear! (mut (.again-phis s)))
    (clear! (mut (.exits s)))
    (clear! (mut (.exit-values s)))
    (clear! (mut (.targets s)))
    (clear! (mut (.backward s)))
    (clear! (mut (.order s)))))

;;; The function's blocks, entered from control `entry`. The walk is done and
;;; the parameters have their nodes.
(defn body! [(s (mut Adapter)) (entry i32)] (-> void)
  (let [f (.f s)]
    (heads! (mut s))
    (if (!= (get (.loop s) 0) 0)
        (graph/set-input! (mut (.g s)) (get (.loop s) 0) 0 entry)
        (do (set! (mut (.enters s)) 0 entry)
            (set! (mut (.heads s)) 0 entry)))
    (set! (mut (.forward-done s)) 0 1)
    (for b (.order s)
      (let [at (i64-of b)
            bb (cir/blk f b)]
        (set! (.c s) (cond (!= (get (.loop s) at) 0) (get (.loop s) at)
                           (!= (get (.merge s) at) 0) (get (.merge s) at)
                           :else (get (.enters s) at)))
        ; Where this block's nodes are made, for a compile that keeps the
        ; order: one whose graph shares no node between blocks.
        (let [head (cond (!= (get (.loop s) at) 0) (get (.loop s) at)
                         (!= (get (.merge s) at) 0) (get (.merge s) at)
                         :else (get (.heads s) at))]
          (set! (mut (.heads s)) at head)
          (when (= (.sharing (.g s)) graph/SHARE-LEAVES) (graph/mark-block! (mut (.g s)) head)))
        (let [ending (ends-in-call (mut s) b)
              ; Round to its own start whatever it returns; straight to another
              ; function only with one result at most, in one register.
              last (if (or (= ending (none-value)) (calls-itself? (mut s) ending)
                           (and (<= (cast i64 (.aux (cir/val f ending))) 1)
                                (!= (cast i64 (.ty (cir/val f ending))) cop/T-I128)))
                       ending
                       (none-value))
              (mut plain) (- (i64-of (.iend bb)) 1)]
          (when (!= last (none-value))
            (while (!= (get (.insts f) plain) last) (set! plain (- plain 1))))
          (for i (range (i64-of (.ibegin bb)) plain)
            (let [first (graph/size (.g s))]
              (instruction! (mut s) (get (.insts f) i))
              (when (.debug s) (graph/originate! (mut (.g s)) first (+ (get (.insts f) i) 1)))))
          (let [first (graph/size (.g s))]
            (cond
              (= last (none-value)) (terminator! (mut s) b (.term bb))
              ; Put in place, the called function's results are returned as ever.
              (and (not (calls-itself? (mut s) last)) (in-place! (mut s) last)) (terminator! (mut s) b (.term bb))
              :else
                (let [through (= (cast i64 (.op (cir/val f (.term bb)))) cop/OP-BR)
                      ; Where the block went on to the return, it still does, by
                      ; a way never taken that simplifying then takes out.
                      never (if through (ir/if! (mut (.g s)) (.c s) (ir/const! (mut (.g s)) ir/T-BOOL 0)) 0)]
                  (when through (set! (.c s) (ir/false! (mut (.g s)) never)))
                  (let [first (graph/size (.g s))]
                    (if (calls-itself? (mut s) last) (again! (mut s) last) (tail-call! (mut s) last))
                    (when (.debug s) (graph/originate! (mut (.g s)) first (+ last 1))))
                  (when through
                    (for i (range 0 (cast i64 (.aux (cir/val f last))))
                      (let [r (+ last (cast u32 i))
                            ty (cast i64 (.ty (cir/val f r)))]
                        (if (= ty cop/T-I128)
                            (define-wide! (mut s) r (word (mut s) 0) (word (mut s) 0))
                            (define! (mut s) r (ir/const! (mut (.g s)) (type-of (mut s) ty) 0)))))
                    (connect! (mut s) b (cast i64 (get (.first-out s) (i64-of b))) (ir/true! (mut (.g s)) never)))))
            ; What ends the block comes from its terminator: a test that is
            ; made with the branch is where a debugger stops for that line.
            (when (.debug s) (graph/originate! (mut (.g s)) first (+ (.term bb) 1)))))))
    ; Nothing made from here on was made where a block's nodes are.
    (when (= (.sharing (.g s)) graph/SHARE-LEAVES) (graph/mark-block! (mut (.g s)) 0))))

(defn none-value [] (-> u32) (: 0xFFFFFFFF u32))

;;; If block `b` of the function being compiled (not one put in place) ends by
;;; calling a function and returning exactly what it returned, the call; else
;;; `none-value`. Between the call and the return are only the call's further
;;; results; and the return may be in the next block, one that does nothing
;;; but return its phis, which for this block are the call's results.
(defn ends-in-call [(s (mut Adapter)) (b u32)] (-> u32)
  (let [f (.f s)
        bb (cir/blk f b)
        t (cir/val f (.term bb))
        op (cast i64 (.op t))]
    (block :no
      ; At every level: how deep a program can go must not depend on the level.
      (when (> (.depth s) 0) (return-from :no (none-value)))
      (let [(mut at) (- (i64-of (.iend bb)) 2)]
        (while (and (>= at (i64-of (.ibegin bb)))
                    (= (cast i64 (.op (cir/val f (get (.insts f) at)))) cop/OP-CALLRES))
          (set! at (- at 1)))
        (when (< at (i64-of (.ibegin bb))) (return-from :no (none-value)))
        (let [v (get (.insts f) at)
              x (cir/val f v)
              results (cast i64 (.aux x))]
          (when (!= (cast i64 (.op x)) cop/OP-CALL) (return-from :no (none-value)))
          (cond
            (= op cop/OP-RET)
              (do (when (!= (i64-of (.nops t)) results) (return-from :no (none-value)))
                  (for i (range 0 results)
                    (when (!= (cir/operand f t (cast u32 i)) (+ v (cast u32 i))) (return-from :no (none-value)))))
            (= op cop/OP-BR)
              ; Through blocks that do nothing but pass their phis on, to one
              ; that returns them: each result is a phi of the next block.
              (let [(mut now) (ArrayList::new [u32] (.a s))
                    (mut from) b
                    (mut edge) (cast i64 (get (.first-out s) (i64-of b)))
                    (mut steps) 0
                    (mut arrived) false]
                (for i (range 0 results) (push! (mut now) (+ v (cast u32 i))))
                (while (not arrived)
                  (let [to (get (.targets s) edge)
                        next (cir/blk f to)
                        end (cir/val f (.term next))
                        end-op (cast i64 (.op end))]
                    (when (or (get (.backward s) edge) (> steps 4)) (return-from :no (none-value)))
                    (for i (range (i64-of (.ibegin next)) (- (i64-of (.iend next)) 1))
                      (when (!= (cast i64 (.op (cir/val f (get (.insts f) i)))) cop/OP-PHI)
                        (return-from :no (none-value))))
                    (for i (range 0 results)
                      (let [(mut found) (none-value)]
                        (for k (range 0 (i64-of (.phi-count next)))
                          (let [p (phi-at (mut s) to k)]
                            (when (= (incoming (mut s) p from) (get now i)) (set! found p))))
                        (when (= found (none-value)) (return-from :no (none-value)))
                        (set! (mut now) i found)))
                    (cond
                      (= end-op cop/OP-RET)
                        (do (when (!= (i64-of (.nops end)) results) (return-from :no (none-value)))
                            (for i (range 0 results)
                              (when (!= (cir/operand f end (cast u32 i)) (get now i)) (return-from :no (none-value))))
                            (set! arrived true))
                      (= end-op cop/OP-BR)
                        (do (set! from to)
                            (set! edge (cast i64 (get (.first-out s) (i64-of to))))
                            (set! steps (+ steps 1)))
                      :else (return-from :no (none-value))))))
            :else (return-from :no (none-value)))
          v)))))

;;; Whether call `v` is of the function being compiled, with one plain
;;; argument for each parameter and of its type, in a function whose frame's
;;; addresses stay in it: such a call, returned from at once, is the function
;;; over again from its start with new parameters.
(defn calls-itself? [(s (mut Adapter)) (v u32)] (-> bool)
  (let [f (.f s)
        x (cir/val f v)]
    (block :no
      (when (or (< (.self s) 0) (!= (.imm x) (.self s)) (> (.depth s) 0)
                (.frame-escapes f) (.has-dynamic-alloca f)
                (!= (i64-of (.nops x)) (len (.args f))))
        (return-from :no false))
      (for i (range 0 (len (.args f)))
        (when (or (!= (.ty (cir/val f (cir/operand f x (cast u32 i)))) (.ty (cir/val f (get (.args f) i))))
                  (!= (& (get (.argflags f) (+ (i64-of (.opb x)) i)) (cast u32 cir/AF-VARIADIC)) (: 0 u32))
                  (cir/af-byval? (get (.argflags f) (+ (i64-of (.opb x)) i))))
          (return-from :no false)))
      true)))

;;; How many of the function's blocks end by calling the function itself.
(defn self-calls [(s (mut Adapter))] (-> i64)
  (let [(mut count) 0]
    (for b (.order s)
      (let [v (ends-in-call (mut s) b)]
        (when (and (!= v (none-value)) (calls-itself? (mut s) v)) (set! count (+ count 1)))))
    count))

;;; The function's body is entered through a loop that each call of itself
;;; comes back to: every parameter's node becomes a phi there, of what arrived
;;; and what each such call passes. Returns the loop.
(defn again-loop! [(s (mut Adapter)) (entry i32) (count i64)] (-> i32)
  (let [f (.f s)
        loop (ir/loop! (mut (.g s)) (+ count 1))]
    (graph/set-input! (mut (.g s)) loop 0 entry)
    (for i (range 0 (len (.args f)))
      (let [v (i64-of (get (.args f) i))
            low (ir/phi! (mut (.g s)) (graph/ty (.g s) (get (.node s) v)) loop (+ count 1))]
        (graph/set-input! (mut (.g s)) low 1 (get (.node s) v))
        (set! (mut (.node s)) v low)
        (push! (mut (.again-phis s)) low)
        (when (wide? (mut s) (get (.args f) i))
          (let [high (ir/phi! (mut (.g s)) (graph/ty (.g s) (get (.high s) v)) loop (+ count 1))]
            (graph/set-input! (mut (.g s)) high 1 (get (.high s) v))
            (set! (mut (.high s)) v high)
            (push! (mut (.again-phis s)) high)))))
    (set! (.again s) loop)
    (set! (.tails (.budget s)) true)
    loop))

;;; Call `v` of the function itself, returned from at once: round the loop,
;;; each parameter's phi taking the argument.
(defn again! [(s (mut Adapter)) (v u32)] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        way (+ (.again-done s) 1)
        (mut at) 0]
    (for i (range 0 (len (.args f)))
      (let [a (cir/operand f x (cast u32 i))]
        (graph/set-input! (mut (.g s)) (get (.again-phis s) at) (+ way 1) (value (mut s) a))
        (set! at (+ at 1))
        (when (wide? (mut s) (get (.args f) i))
          (graph/set-input! (mut (.g s)) (get (.again-phis s) at) (+ way 1) (value-high (mut s) a))
          (set! at (+ at 1)))))
    (graph/set-input! (mut (.g s)) (.again s) way (.c s))
    (set! (.again-done s) way)))

;;; Whether any block the function can reach returns.
(defn returns? [(s (mut Adapter))] (-> bool)
  (let [f (.f s)
        (mut found) false]
    (for b (.order s)
      (let [op (cast i64 (.op (cir/val f (.term (cir/blk f b)))))]
        (when (or (= op cop/OP-RET) (= op cop/OP-TAILCALL)) (set! found true))))
    found))

;;; Call `v` as the called function's own instructions, if the module has the
;;; function and it is small or asks for this; false if the call must be made.
(defn in-place! [(s (mut Adapter)) (v u32)] (-> bool)
  (let [f (.f s)
        x (cir/val f v)
        m (.module s)
        budget (.budget s)
        symbol (.imm x)]
    (block :done
      (when (or (= (primitive/cast u64 m) 0) (< symbol 0) (>= symbol (len (.functions m))))
        (return-from :done false))
      (let [callee (get (.functions m) symbol)]
        (when (or (= (primitive/cast u64 callee) 0) (get (.never m) symbol)) (return-from :done false))
        (let [size (len (.insts callee))
              always (get (.always m) symbol)
              ; Only into the function being compiled itself: one put in place
              ; of several calls would take this with it to each.
              once (and (= (.depth s) 0) (get (.private m) symbol)
                        (= (get (.calls m) symbol) 1) (not (get (.taken m) symbol))
                        (<= size (.once (.settings s))) (<= (+ (.once budget) size) ONCE-GROWTH))]
          (when (or (.has-dynamic-alloca callee)
                    (!= (len (.args callee)) (i64-of (.nops x)))
                    (>= (.depth s) DEEPEST)
                    ; Its frame would be this function's, which is given back early.
                    (and (.frame-escapes callee) (.tails budget))
                    (and (not always) (not once) (> size (.small (.settings s))))
                    (and (not once) (> (+ (.grown budget) size) (.growth (.settings s)))))
            (return-from :done false))
          (for active (.active budget) (when (= (i64-of active) symbol) (return-from :done false)))
          ; Each argument must be what the parameter is, and all of them named.
          (for i (range 0 (i64-of (.nops x)))
            (when (or (!= (.ty (cir/val f (cir/operand f x (cast u32 i))))
                          (.ty (cir/val callee (get (.args callee) i))))
                      (!= (& (get (.argflags f) (+ (i64-of (.opb x)) i)) (cast u32 cir/AF-VARIADIC)) (: 0 u32))
                      ; The called function owns a copy; in place it would have the original.
                      (cir/af-byval? (get (.argflags f) (+ (i64-of (.opb x)) i))))
              (return-from :done false)))
          (let [(mut inner) (adapter callee (.ta s) (.g s) (.a s) m (.settings s) budget (+ (.depth s) 1))]
            (walk! (mut inner))
            (unless (returns? (mut inner)) (return-from :done false))
            (for i (range 0 (i64-of (.nops x)))
              (let [a (cir/operand f x (cast u32 i))
                    p (i64-of (get (.args callee) i))]
                (set! (mut (.node inner)) p (value (mut s) a))
                (when (wide? (mut s) a) (set! (mut (.high inner)) p (value-high (mut s) a)))))
            (when (.frame-escapes callee) (set! (.escaped budget) true))
            (push! (mut (.active budget)) (cast u32 symbol))
            (if once (set! (.once budget) (+ (.once budget) size)) (set! (.grown budget) (+ (.grown budget) size)))
            (set! (.g inner) (.g s))
            (body! (mut inner) (.c s))
            (set! (.g s) (.g inner))
            (pop! (mut (.active budget)))
            (leave! (mut s) v (mut inner))
            true))))))

;;; What follows a function put in place of call `v`: where it returns from, or
;;; where its several returns meet, and its results as the call's.
(defn leave! [(s (mut Adapter)) (v u32) (inner (mut Adapter))] (-> void)
  (let [f (.f s)
        x (cir/val f v)
        count (len (.exits inner))
        width (.exit-width inner)
        (mut results) (ArrayList::new [i32] (.a s))]
    (if (= count 1)
        (do (set! (.c s) (get (.exits inner) 0))
            (for k (range 0 width) (push! (mut results) (get (.exit-values inner) k))))
        (let [region (ir/region! (mut (.g s)) count)]
          (for e (range 0 count) (graph/set-input! (mut (.g s)) region e (get (.exits inner) e)))
          (for k (range 0 width)
            (let [phi (ir/phi! (mut (.g s)) (graph/ty (.g s) (get (.exit-values inner) k)) region count)]
              (for e (range 0 count)
                (graph/set-input! (mut (.g s)) phi (+ e 1) (get (.exit-values inner) (+ (* e width) k))))
              (push! (mut results) phi)))
          (set! (.c s) region)))
    ; The call's results, in order, a 128-bit one taking two values.
    (let [(mut at) 0]
      (for i (range 0 (cast i64 (.aux x)))
        (let [r (+ v (cast u32 i))]
          (if (wide? (mut s) r)
              (do (define-wide! (mut s) r (get results at) (get results (+ at 1)))
                  (set! at (+ at 2)))
              (do (define! (mut s) r (get results at))
                  (set! at (+ at 1)))))))))

;;; One function compiled into `out`, with calls of its module's small
;;; functions put in place if it has a module. `level` is the optimization
;;; level asked for: below 2, selection and allocation alone.
(defn compile-to! [(module (ptr Module)) (settings Settings) (f (ptr cir/Func)) (ta (ptr asm/Asm)) (symbol u32)
                   (level i32) (index i64) (debug bool) (out (ptr Compiled))] (-> void)
  (let [work (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/ScratchArena::init-with-capacity work (malloc-allocator) 65536)
    (let [a (allocator work)
          (mut budget) (Budget :grown 0 :once 0 :active (ArrayList::new [u32] a) :escaped false :tails false)
          ; Past the functions a trial is on for, the limits tried are not used either.
          (mut limits) settings
          (mut s) (do (when (and (>= (.trial settings) 0) (>= index (.trial settings)))
                        (set! (.small limits) SMALL)
                        (set! (.growth limits) GROWTH))
                      (adapter f ta (graph-for a level) a module limits (primitive/cast (ptr Budget) (mut budget)) 0))]
      (push! (mut (.active budget)) symbol)
      (set! (.self s) (i64-of symbol))
      (set! (.debug s) debug)
      (set! (.level s) level)
      (walk! (mut s))
      (let [start (ir/start! (mut (.g s)))
            again (self-calls (mut s))]
        (params! (mut s))
        (body! (mut s) (if (> again 0) (again-loop! (mut s) start again) start)))
      (emit! (mut s) level index out))
    (close! work)))

;;; The graph a function is built into. A quick compile computes each node in
;;; the block it was built in, so no node made for one block may be shared
;;; with another; only nodes with no inputs are.
(defn graph-for [(a (dyn Allocator)) (level i32)] (-> graph/Graph)
  (let [(mut g) (graph/create a)]
    (when (< (cast i64 level) 2) (set! (.sharing g) graph/SHARE-LEAVES))
    g))

;;; What a thread compiling one function after another keeps from one to the
;;; next at -O0 and -O1, so that none of it is made again: the adapter's lists,
;;; the graph, the base unit's state and the compiled code, all on the heap;
;;; and an arena for what each function makes for itself, emptied between
;;; functions. The settings are read once.
(defstruct Work
  [(arena scratch/ScratchArena)
   (s Adapter)
   (out Compiled)
   (dx dst/State)
   ; How many functions were compiled, and their CIR instructions.
   (direct i64)
   (direct-insts i64)
   ; The CIR values a debugger follows in the function being compiled.
   (track (ArrayList u32))
   (settings Settings)
   ; With DECLARATIVE_TIMES: nanoseconds in each step of the plan, then the
   ; whole of it, the look at what it takes included, then what is around it.
   (direct-times (ArrayList i64))])

(defn work-create [] (-> (ptr Work))
  (let [heap (malloc-allocator)
        w (box! heap Work (zeroed Work))]
    (scratch/ScratchArena::init-with-capacity (field w arena) heap 65536)
    (let [(mut g) (graph/create heap)]
      (set! (.sharing g) graph/SHARE-LEAVES)
      (set! (.s w) (adapter-empty g heap)))
    (set! (.dx w) (dst/create heap))
    (set! (.out w) (compiled-none))
    (set! (.settings w) (settings-read))
    (set! (.direct-times w) (ArrayList::new [i64] heap))
    (set! (.track w) (ArrayList::new [u32] heap))
    w))

(defn work-free! [(w (ptr Work))] (-> void)
  (when (.times (.settings w))
    (eprintln "declarative quick compile: {} functions ({} CIR instructions) straight from CIR"
              (.direct w) (.direct-insts w))
    (let [t (.direct-times w)]
      (for i (range 0 (len dplans/QUICK-STEPS))
        (eprintln "  direct {} {}" (get dplans/QUICK-STEPS i) (if (> (len t) i) (/ (get t i) 1000000) 0)))
      (eprintln "  direct in all {}" (if (> (len t) (len dplans/QUICK-STEPS)) (/ (get t (len dplans/QUICK-STEPS)) 1000000) 0))
      (for i (range 0 (len AROUND))
        (let [k (+ (+ (len dplans/QUICK-STEPS) 1) i)]
          (eprintln "  direct, around: {} {}" (get AROUND i) (if (> (len t) k) (/ (get t k) 1000000) 0))))
      (eprintln "  direct bodies written again: {}" (.rewritten (.dx w)))))
  (free! (mut (.direct-times w)))
  (free! (mut (.track w)))
  (compiled-free! (field w out))
  (close! (field w arena))
  (alloc/destroy [Work] (malloc-allocator) w))

;;; One function at -O0 or -O1, compiled straight from CIR with what `w`
;;; keeps, into `(.out w)`.
(defn compile-quick! [(w (ptr Work)) (f (ptr cir/Func)) (ta (ptr asm/Asm)) (debug bool)] (-> void)
  (scratch/ScratchArena::recycle! (field w arena))
  (direct! w f ta debug)
  (set! (.direct w) (+ (.direct w) 1))
  (set! (.direct-insts w) (+ (.direct-insts w) (len (.insts f)))))

;;; What the compile straight from CIR found it cannot compile in `f`: an
;;; error, as there is no other way to compile it below -O2.
(defn refused [(f (ptr cir/Func)) (cx (ptr dst/State))] (-> never)
  (let [why (.refusal cx)]
    (cond
      (= why 3) (fail f "a call returns more values than the calling convention has result registers for")
      (= why 8) (fail f "a return gives back more values than the calling convention has result registers for")
      (= why 10) (panic "declarative backend: {}: no rule computes {}" (.name f) (cops/name (.refused-op cx)))
      :else (panic "declarative backend: {}: the compile straight from CIR refused it for a reason numbered {}, which has no message" (.name f) why))))

;;; What the compile straight from CIR does around its plan, as it is timed.
(def AROUND ["starting" "symbols" "output"])

(defn around! [(w (ptr Work)) (i i64) (started i64)] (-> i64)
  (when (.times (.settings w))
    (let [(mut times) (.direct-times w)]
      (clock/add! (mut times) (+ (+ (len dplans/QUICK-STEPS) 1) i) started)
      (set! (.direct-times w) times)))
  (if (.times (.settings w)) (clock/now) 0))

;;; What the compile straight from CIR is told before it compiles `f` into `cx`.
(defn direct-setup! [(cx (ptr dst/State)) (f (ptr cir/Func)) (ta (ptr asm/Asm)) (debug bool)] (-> void)
  (set! (.near-calls cx) true)
  (set! (.near-routines cx) true)
  ; For a debugger: where in the source each piece of code comes from.
  (set! (.rows cx) debug)
  (set! (.copy-routine cx) (+ (cast i64 (routine "memcpy")) 1))
  (set! (.move-routine cx) (+ (cast i64 (routine "memmove")) 1))
  (set! (.fill-routine cx) (+ (cast i64 (routine "memset")) 1))
  (set! (.divide-routine cx) (+ (cast i64 (routine "__divti3")) 1))
  (set! (.udivide-routine cx) (+ (cast i64 (routine "__udivti3")) 1))
  (set! (.remainder-routine cx) (+ (cast i64 (routine "__modti3")) 1))
  (set! (.uremainder-routine cx) (+ (cast i64 (routine "__umodti3")) 1))
  (for v (range 0 (view/value-count f))
    (when (= (view/op f v) cops/SYM)
      (dregs/set-outside cx (cast i32 (+ v 1))
                         (through-table? ta (cast u32 (view/imm f v)) (primitive/cast (ptr Module) 0))))))

;;; The code the compile straight from CIR left in `cx`, into `out`.
(defn direct-output! [(s (mut Adapter)) (cx (ptr dst/State)) (out (ptr Compiled)) (debug bool)] (-> void)
  (output! (mut s) out (.code cx) (.reloc-at cx) (.reloc-symbol cx) (.reloc-op cx) (.row-at cx) (.row-from cx))
  ; Each frame object is so far below the frame register; one nothing
  ; reads is nowhere.
  (clear! (mut (.locs out)))
  (when debug
    (clear! (mut (.objects out)))
    (for v (.allocas (.f s))
      (push! (mut (.objects out)) (- 0 (dregs/object-distance cx (cast i32 (+ (cast i64 v) 1))))))
    ; Each change of where a followed value is, from the row of code it holds
    ; from (one past the last row: from the end of the code).
    (for i (range 0 (len (.loc-row cx)))
      (let [row (get (.loc-row cx) i)
            at (if (< row (len (.row-at cx))) (get (.row-at cx) row) (.code-bytes cx))]
        (push! (mut (.locs out)) (cast u64 (get (.loc-track cx) i)))
        (push! (mut (.locs out)) (cast u64 at))
        (push! (mut (.locs out)) (get (.loc-what cx) i))))))

;;; Straight from CIR, into `(.out w)`.
(defn direct! [(w (ptr Work)) (f (ptr cir/Func)) (ta (ptr asm/Asm)) (debug bool)] (-> void)
  (let [started (if (.times (.settings w)) (clock/now) 0)
        cx (field w dx)]
    (set! (.f cx) f)
    (set! (.tmp cx) (allocator (field w arena)))
    (dst/begin! cx)
    ; For a debugger: the values it follows (by CIR number + 1).
    (clear! (mut (.track cx)))
    (when debug (for v (.track w) (push! (mut (.track cx)) (+ (cast i64 v) 1))))
    (let [t (around! w 0 started)]
    (when (and (!= (primitive/cast u64 (.show (.settings w))) 0) (= (str/from-cstr (.show (.settings w))) (.name f)))
      (dump/cir f))
    (when (and (!= (primitive/cast u64 (.show (.settings w))) 0) (= (str/from-cstr (.show (.settings w))) "?"))
      (println "; compiling {}" (.name f)))
    (direct-setup! cx f ta debug)
    (around! w 1 t)
    (if (.times (.settings w))
        (let [(mut steps) (ArrayList::new [i64] (allocator (field w arena)))
              (mut times) (.direct-times w)]
          (dplans/quick-timed cx (mut steps))
          (for i (range 0 (len steps))
            (while (<= (len times) i) (push! (mut times) 0))
            (set! (mut times) i (+ (get times i) (get steps i))))
          (set! (.direct-times w) times))
        (dplans/quick cx))
    (unless (= (.refusal cx) 0) (refused f cx))
    (when (and (!= (primitive/cast u64 (.show (.settings w))) 0) (= (str/from-cstr (.show (.settings w))) "?"))
      (println "; direct {} {}" (+ (.direct w) 1) (.name f)))
    (let [s (field w s)
          t (if (.times (.settings w)) (clock/now) 0)]
      (set! (.f s) f)
      (set! (.settings s) (.settings w))
      (set! (.debug s) debug)
      (when (showing? s)
        (print "code:")
        (for b (.code cx) (print " {:02x}" b))
        (println ""))
      (direct-output! s cx (field w out) debug)
      (around! w 2 t))
    (when (.times (.settings w))
      (let [(mut times) (.direct-times w)]
        (while (< (len times) (+ (len dplans/QUICK-STEPS) 1)) (push! (mut times) 0))
        (clock/add! (mut times) (len dplans/QUICK-STEPS) started)
        (set! (.direct-times w) times))))))

;;; One function on its own, compiled into the assembler as `symbol`. Below
;;; -O2, with what `work` keeps from the functions before.
(defn compile! [(f (ptr cir/Func)) (ta (ptr asm/Asm)) (symbol u32) (level i32) (work (ptr Work))] (-> void)
  (if (< (cast i64 level) 2)
      (do (clear! (mut (.track work)))
          (compile-quick! work f ta false)
          (place-code! ta symbol (field work out)))
      (let [(mut out) (compiled-none)]
        (compile-to! (primitive/cast (ptr Module) 0) (.settings work) f ta symbol level -1 false (mut out))
        (place-code! ta symbol (mut out))
        (compiled-free! (mut out)))))

;;; The same, to be looked at as it runs: its frame objects stay in memory,
;;; and what a debugger needs is added to the lists given: `rows`, pairs of a
;;; place in the assembler's text and the place in the source the code there
;;; came from; `marks`, pairs of a CIR value and where in the function's code
;;; the code for it starts; `objects`, for each frame object in CIR's order
;;; how far from the frame register it is (below is negative; 0 if unused);
;;; and `locs`, for the CIR values `track` names, triples of which (its place
;;; in `track`), where in the assembler's text, and where it is from there on:
;;; 1 << 56 | a register, 2 << 56 | how far from the frame register (32 bits),
;;; or 0, nowhere. Above -O1 no value is followed.
(defn compile-debug! [(f (ptr cir/Func)) (ta (ptr asm/Asm)) (symbol u32) (level i32)
                      (rows (mut (ArrayList u64))) (marks (mut (ArrayList u64))) (objects (mut (ArrayList i64)))
                      (track (ArrayList u32)) (locs (mut (ArrayList u64)))
                      (work (ptr Work))]
  (-> void)
  (clear! (mut (.track work)))
  (for v track (push! (mut (.track work)) v))
  (let [(mut fresh) (compiled-none)
        out (if (< (cast i64 level) 2)
                (do (compile-quick! work f ta true) (field work out))
                (do (compile-to! (primitive/cast (ptr Module) 0) (.settings work) f ta symbol level -1 true (mut fresh))
                    (primitive/cast (ptr Compiled) (mut fresh))))]
    (place-code! ta symbol out)
    (let [base (cast u64 (.off (asm/sym-at ta symbol)))]
      (for i (range 0 (/ (len (.rows out)) 2))
        (push! (mut rows) (+ base (get (.rows out) (* i 2))))
        (push! (mut rows) (get (.rows out) (+ (* i 2) 1))))
      (for i (range 0 (/ (len (.marks out)) 2))
        (push! (mut marks) (get (.marks out) (* i 2)))
        (push! (mut marks) (+ base (get (.marks out) (+ (* i 2) 1)))))
      (for o (.objects out) (push! (mut objects) o))
      (for i (range 0 (/ (len (.locs out)) 3))
        (push! (mut locs) (get (.locs out) (* i 3)))
        (push! (mut locs) (+ base (get (.locs out) (+ (* i 3) 1))))
        (push! (mut locs) (get (.locs out) (+ (* i 3) 2)))))
    (compiled-free! (mut fresh))))

;;; What each thread compiling a module does: takes the next function of the
;;; wave nobody has taken, until there is none. A function is numbered by its
;;; place in the module, whatever wave it is compiled in.
(defn work [(argument (ptr i8))] (-> (ptr i8))
  (let [m (primitive/cast (ptr Module) argument)
        count (len (.wave m))]
    (loop
      (let [at (atomic/add (field m next) 1)]
        (when (>= at count) (break))
        (let [symbol (get (.wave m) at)]
          (compile-to! m (.settings m) (get (.functions m) (cast i64 symbol)) (.ta m) symbol (.level m)
                       (get (.position m) (cast i64 symbol)) false
                       (elem (mut (.compiled m)) (cast i64 symbol))))))
    argument))

;;; A thread's stack: a pass may go as deep as a function's graph is.
(const STACK 268435456)

;;; Compiles the functions of the wave, on `threads` threads (or as many as
;;; DECLARATIVE_THREADS says; one while a function is being shown), and no
;;; more threads than functions.
(defn run-wave! [(m (ptr Module)) (ta (ptr asm/Asm)) (level i32) (threads i64)] (-> void)
  (let [settings (.settings m)
        asked (if (> (.threads settings) 0) (.threads settings) threads)
        wanted (if (!= (primitive/cast u64 (.show settings)) 0) 1 asked)
        count (if (< (len (.wave m)) wanted) (if (< (len (.wave m)) 1) 1 (len (.wave m))) wanted)
        (mut others) (ArrayList::new [Thread] (malloc-allocator))
        (mut started) 0]
    (when (or (< wanted 1) (> wanted 64)) (panic "declarative backend: {} threads is not between 1 and 64" wanted))
    (set! (.ta m) ta)
    (set! (.level m) level)
    (set! (.next m) 0)
    ; A thread's handle must not move once the thread is started into it.
    (for _ (range 1 count) (push! (mut others) (zeroed Thread)))
    (for i (range 0 (len others))
      (when (= (Thread::spawn-configured (elem (mut others) i) (fnptr-of work) (primitive/cast (ptr i8) m)
                                         (ThreadConfig::new STACK -1))
               (: 0 i32))
        (set! started (+ started 1))))
    ; This thread compiles too, so a thread that could not be started is only fewer.
    (work (primitive/cast (ptr i8) m))
    (for i (range 0 started)
      (unless (= (Thread::join (elem (mut others) i)) (: 0 i32))
        (panic "declarative backend: a compiling thread could not be waited for")))
    (free! (mut others))))

;;; Compiles every function of the module. Nothing is put in the assembler:
;;; `place!` does that for each, in whatever order the module's code is to be
;;; in, which is what makes the object the same however many threads there are.
(defn compile-module! [(m (ptr Module)) (ta (ptr asm/Asm)) (level i32) (threads i64)] (-> void)
  (clear! (mut (.wave m)))
  (for symbol (.order m) (push! (mut (.wave m)) symbol))
  (run-wave! m ta level threads))

;;; Compiles these functions of the module only: for a caller that compiles
;;; what is reached from what must be there, wave by wave, and leaves out
;;; functions nothing reaches once the calls of them were put in place.
(defn compile-wave! [(m (ptr Module)) (ta (ptr asm/Asm)) (level i32) (threads i64) (symbols (slice u32))] (-> void)
  (clear! (mut (.wave m)))
  (for symbol symbols (push! (mut (.wave m)) symbol))
  (run-wave! m ta level threads))

;;; The symbols the compiled function `symbol` refers to, added to `out`.
(defn references! [(m (ptr Module)) (symbol u32) (out (mut (ArrayList u32)))] (-> void)
  (let [c (elem (mut (.compiled m)) (cast i64 symbol))]
    (unless (.done c) (panic "declarative backend: a function's references are asked before it is compiled"))
    (for named (.reloc-symbol c)
      (when (< named RUNTIME) (push! (mut out) (cast u32 named))))))

;;; Puts the compiled function `symbol` of the module in the assembler's text.
(defn place! [(m (ptr Module)) (ta (ptr asm/Asm)) (symbol u32)] (-> void)
  (let [c (elem (mut (.compiled m)) (cast i64 symbol))]
    (place-code! ta symbol c)
    (compiled-free! c)))
