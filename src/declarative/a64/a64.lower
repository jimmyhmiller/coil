# Which AArch64 instructions compute each node.
lower in unit
nodes declarative.backend.nodes
target declarative.a64.target
emit mach

# A constant is built again in each block that needs it in a register.
local CONST
local SLOT
local SYMBOL
local EXTERN

# What the allocator and the emitter ask for by name.
template move(d, s) is copy       = orr(1, d, zr, s)
template jump(to) is jump         = b(to)
template leave() is return        = ret(x30)
template move-float(d, s) is copy = mov-vector(d, s)
# A register to and from a slot of the frame, which is found from `base`. An
# instruction reaches 4095 times the size of what it moves; further than that,
# x17 is first given the address 4096 bytes at a time.
template from-frame-float(d, base, slot) when slot < 4096 = ldr-d(d, base, slot)
template from-frame-float(d, base, slot) = add-imm-hi(1, x17, base, slot / 512) ; ldr-d(d, x17, slot % 512)
template to-frame-float(s, base, slot) when slot < 4096   = str-d(s, base, slot)
template to-frame-float(s, base, slot)   = add-imm-hi(1, x17, base, slot / 512) ; str-d(s, x17, slot % 512)
template from-frame(d, base, slot) when slot < 4096 = ldr(d, base, slot)
template from-frame(d, base, slot) = add-imm-hi(1, x17, base, slot / 512) ; ldr(d, x17, slot % 512)
template to-frame(s, base, slot) when slot < 4096   = str(s, base, slot)
template to-frame(s, base, slot)   = add-imm-hi(1, x17, base, slot / 512) ; str(s, x17, slot % 512)
# Sixteen bytes, in two slots of which the first is at a multiple of sixteen.
# Two words next to each other in memory, `at` bytes from a base, read into
# and written from two registers.
template load-pair(a, b, base, at)  = ldp(a, b, base, at / 8)
template store-pair(a, b, base, at) = stp(a, b, base, at / 8)
# Sixteen bytes `sat` bytes from `s` copied to `dat` bytes from `d`, and a
# word of `bytes`, through scratch registers: x15 and x16 as a pair near enough
# for one instruction, else x15 a word at a time (a far address takes x16 and
# x17).
template copy-sixteen(s, sat, d, dat) when sat % 8 == 0 and sat >= -512 and sat < 512 and dat % 8 == 0 and dat >= -512 and dat < 512 = ldp(x15, x16, s, (sat / 8) & 127) ; stp(x15, x16, d, (dat / 8) & 127)
template copy-sixteen(s, sat, d, dat) = copy-word(s, sat, d, dat, 8) ; copy-word(s, sat + 8, d, dat + 8, 8)
template copy-word(s, sat, d, dat, bytes) = load-word(x15, s, sat, bytes, 0) ; store-word(x15, d, dat, bytes)
# Two words of a frame object `below` bytes below the frame record, from the frame register.
template load-pair-object(a, b, below)  = ldp(a, b, x29, (128 - below / 8) & 127)
template store-pair-object(a, b, below) = stp(a, b, x29, (128 - below / 8) & 127)
# Two registers to and from two slots next to each other.
template to-frame-pair(a, b, base, slot) when slot < 63 = stp(a, b, base, slot)
template to-frame-pair(a, b, base, slot)                = to-frame(a, base, slot) ; to-frame(b, base, slot + 1)
template from-frame-pair(a, b, base, slot) when slot < 63 = ldp(a, b, base, slot)
template from-frame-pair(a, b, base, slot)                = from-frame(a, base, slot) ; from-frame(b, base, slot + 1)
template to-frame-float-pair(a, b, base, slot) when slot < 63 = stp-d(a, b, base, slot)
template to-frame-float-pair(a, b, base, slot)                = to-frame-float(a, base, slot) ; to-frame-float(b, base, slot + 1)
template from-frame-float-pair(a, b, base, slot) when slot < 63 = ldp-d(a, b, base, slot)
template from-frame-float-pair(a, b, base, slot)                = from-frame-float(a, base, slot) ; from-frame-float(b, base, slot + 1)

template from-frame-wide(d, base, slot) when slot < 8192 = ldr-q(d, base, slot / 2)
template from-frame-wide(d, base, slot) = add-imm-hi(1, x17, base, slot / 512) ; ldr-q(d, x17, (slot % 512) / 2)
template to-frame-wide(s, base, slot) when slot < 8192   = str-q(s, base, slot / 2)
template to-frame-wide(s, base, slot)   = add-imm-hi(1, x17, base, slot / 512) ; str-q(s, x17, (slot % 512) / 2)
# An argument of `bytes` bytes to its place above the stack pointer, and a
# parameter from its place above `base`.
template to-stack(s, at, bytes) when bytes == 8 = str(s, sp, at / 8)
template to-stack(s, at, bytes) when bytes == 4 = strw(s, sp, at / 4)
template to-stack(s, at, bytes) when bytes == 2 = strh(s, sp, at / 2)
template to-stack(s, at, bytes)                 = strb(s, sp, at)
template to-stack-float(s, at, bytes) when bytes == 16 = str-q(s, sp, at / 16)
template to-stack-float(s, at, bytes) when bytes == 8 = str-d(s, sp, at / 8)
template to-stack-float(s, at, bytes)                 = str-s(s, sp, at / 4)
template from-stack(d, base, at, bytes) when at >= 4096 = add-imm-hi(1, x17, base, at / 4096) ; from-stack(d, x17, at % 4096, bytes)
template from-stack(d, base, at, bytes) when bytes == 8 = ldr(d, base, at / 8)
template from-stack(d, base, at, bytes) when bytes == 4 = ldrw(d, base, at / 4)
template from-stack(d, base, at, bytes) when bytes == 2 = ldrh(d, base, at / 2)
template from-stack(d, base, at, bytes)                 = ldrb(d, base, at)
template from-stack-float(d, base, at, bytes) when at >= 4096 = add-imm-hi(1, x17, base, at / 4096) ; from-stack-float(d, x17, at % 4096, bytes)
template from-stack-float(d, base, at, bytes) when bytes == 16 = ldr-q(d, base, at / 16)
template from-stack-float(d, base, at, bytes) when bytes == 8 = ldr-d(d, base, at / 8)
template from-stack-float(d, base, at, bytes)                 = ldr-s(d, base, at / 4)
# A frame object, `at` bytes above the base: its address; `bytes` bytes of it
# read and written, directly where the offset is one the instruction can
# hold, and through its address where not.
template frame-address(d, base, at) when at < 4096 = add-imm(1, d, base, at)
template frame-address(d, base, at)                = add-imm(1, d, base, at % 4096) ; add-imm-hi(1, d, d, at / 4096)
template to-bytes(s, base, at, bytes) when bytes == 8 = str(s, base, at / 8)
template to-bytes(s, base, at, bytes) when bytes == 4 = strw(s, base, at / 4)
template to-bytes(s, base, at, bytes) when bytes == 2 = strh(s, base, at / 2)
template to-bytes(s, base, at, bytes)                 = strb(s, base, at)
template to-bytes-float(s, base, at, bytes) when bytes == 8 = str-d(s, base, at / 8)
template to-bytes-float(s, base, at, bytes)                 = str-s(s, base, at / 4)
template from-object(d, base, at, bytes) when at % bytes != 0 or at / bytes >= 4096 = frame-address(x17, base, at) ; from-stack(d, x17, 0, bytes)
template from-object(d, base, at, bytes)                                            = from-stack(d, base, at, bytes)
template from-object-float(d, base, at, bytes) when at % bytes != 0 or at / bytes >= 4096 = frame-address(x17, base, at) ; from-stack-float(d, x17, 0, bytes)
template from-object-float(d, base, at, bytes)                                            = from-stack-float(d, base, at, bytes)
template to-object(s, base, at, bytes) when at % bytes != 0 or at / bytes >= 4096 = frame-address(x17, base, at) ; to-bytes(s, x17, 0, bytes)
template to-object(s, base, at, bytes)                                            = to-bytes(s, base, at, bytes)
template to-object-float(s, base, at, bytes) when at % bytes != 0 or at / bytes >= 4096 = frame-address(x17, base, at) ; to-bytes-float(s, x17, 0, bytes)
template to-object-float(s, base, at, bytes)                                            = to-bytes-float(s, base, at, bytes)
# What stands for these until the frame is laid out.
template read-object(d, below, bytes) is object-read      = ldr(d, sp, 0)
template read-object-float(d, below, bytes) is object-read = ldr-d(d, sp, 0)
template write-object(s, below, bytes) is object-write    = str(s, sp, 0)
template write-object-float(s, below, bytes) is object-write = str-d(s, sp, 0)
template object-address(d, below, bytes) is object-address = add-imm(1, d, sp, 0)

# In a function that moves the stack pointer as it runs: where the frame is,
# kept and given back; the stack pointer down by the bytes in n, to a multiple
# of 16; and the address n bytes above it.
template base-from-stack(d)  = add-imm(1, d, sp, 0)
template stack-from-base(s)  = add-imm(1, sp, s, 0)
template reserve(n)          = add-imm(1, $up, n, 15) ; and-imm(1, $whole, $up, logical(0 - 16)) ; add-imm(1, $top, sp, 0) ; sub(1, $low, $top, $whole) ; add-imm(1, sp, $low, 0)
template above-arguments(d, n) = add-imm(1, d, sp, n)
template align-up(d, s, a)    = add-imm(1, d, s, a - 1) ; and-imm(1, d, d, logical(0 - a))
# The stack pointer down and up by n bytes; from 4096 up it takes two instructions.
template grow-stack(n) when n < 4096   = sub-imm(1, sp, sp, n)
template grow-stack(n)                 = sub-imm(1, sp, sp, n % 4096) ; sub-imm-hi(1, sp, sp, n / 4096)
template shrink-stack(n) when n < 4096 = add-imm(1, sp, sp, n)
template shrink-stack(n)               = add-imm(1, sp, sp, n % 4096) ; add-imm-hi(1, sp, sp, n / 4096)
# x29 to the frame record, n bytes above the stack pointer.
template frame-record(base, n) when n < 4096 = add-imm(1, x29, base, n)
template frame-record(base, n)               = add-imm(1, x29, base, n % 4096) ; add-imm-hi(1, x29, x29, n / 4096)
# A frame with its record at the top and `rest` bytes below.
template open-record(rest) = grow-stack(rest + 16) ; to-frame-pair(x29, x30, sp, rest / 8) ; frame-record(sp, rest)
# And the base from x29, which is n bytes above it.
template base-from-frame(d, n) when n < 4096 = sub-imm(1, d, x29, n)
template base-from-frame(d, n)               = sub-imm(1, d, x29, n % 4096) ; sub-imm-hi(1, d, d, n / 4096)
# Go to `to` if register v holds k; `w` is 1 to compare all 64 bits.
template branch-if-equal(w, v, k, to) when k >= 0 and k < 4096 = subs-imm(w, zr, v, k) ; b-cond(eq, to)
template branch-if-equal(w, v, k, to) = movz(1, $t, k & 65535, 0) ; movk(1, $t, (k >> 16) & 65535, 1) ; movk(1, $t, (k >> 32) & 65535, 2) ; movk(1, $t, (k >> 48) & 65535, 3) ; subs(w, zr, v, $t) ; b-cond(eq, to)
template tail-register(f) is return = br(f)
template tail-symbol(s) is return   = b-symbol(s)
# A switch by table: the value less the lowest case is the index; past the
# last it is the default; else the table, which follows at once, holds for
# each index the distance from its own word to where that case goes.
template table-jump(w, v, low, last, otherwise) = sub-imm(w, $i, v, low) ; subs-imm(w, zr, $i, last) ; b-cond(hi, otherwise) ; address-ahead(x16, 5) ; load-distance(x17, x16, $i) ; add-shifted(1, x16, x16, $i, 2) ; add(1, x16, x16, x17) ; br(x16)
template table-entry(to) = distance-to(to)
template count-into(d, k)  = movz(1, d, k, 0)
template call-register(f)  = blr(f)
# A call of a symbol whose address is read from the table of addresses, and
# the same in tail position.
template call-through-table(s) = adrp-got(x16, s) ; ldr-got(x16, x16, s) ; blr(x16)
template tail-through-table(s) is return = adrp-got(x16, s) ; ldr-got(x16, x16, s) ; br(x16)
template call-symbol(s)    = bl(s)
template machine-code(bits) = raw(bits)

# A value narrower than 32 bits has no promise about the bits above it. These
# make a copy with those bits filled, for the instructions that read them.
template sign-extend(d, s, bits) = sbfm(0, d, s, 0, bits - 1)
template zero-extend(d, s, bits) = ubfm(0, d, s, 0, bits - 1)

# A 64-bit constant into register d, in as few pieces as it needs.
template constant(d, k) when k >= 0 and k < 65536  = movz(1, d, k, 0)
template constant(d, k) when k < 0 and k >= -65536 = movn(1, d, ~k, 0)
template constant(d, k) = movz(1, d, k & 65535, 0) ; movk(1, d, (k >> 16) & 65535, 1) ; movk(1, d, (k >> 32) & 65535, 2) ; movk(1, d, (k >> 48) & 65535, 3)
# The address `at` bytes from `base`, into d; a far one through x16.
template address(d, base, at) when at == 0 and d == base = nothing
template address(d, base, at) when at >= 0 and at < 4096  = add-imm(1, d, base, at)
template address(d, base, at) when at < 0 and at > -4096  = sub-imm(1, d, base, 0 - at)
template address(d, base, at)                             = constant(x16, at) ; add(1, d, base, x16)
# `bytes` at `at` from `base`, read into d, their sign extended to 64 bits if
# `signed`, by the shortest form the offset allows; a far one from x17.
template load-word(d, base, at, bytes, signed) when bytes == 8 and at >= 0 and at < 32768 and at % 8 == 0 = ldr(d, base, at / 8)
template load-word(d, base, at, bytes, signed) when bytes == 4 and signed == 0 and at >= 0 and at < 16384 and at % 4 == 0 = ldrw(d, base, at / 4)
template load-word(d, base, at, bytes, signed) when bytes == 4 and at >= 0 and at < 16384 and at % 4 == 0 = ldrsw(d, base, at / 4)
template load-word(d, base, at, bytes, signed) when bytes == 2 and signed == 0 and at >= 0 and at < 8192 and at % 2 == 0 = ldrh(d, base, at / 2)
template load-word(d, base, at, bytes, signed) when bytes == 2 and at >= 0 and at < 8192 and at % 2 == 0 = ldrsh(d, base, at / 2)
template load-word(d, base, at, bytes, signed) when bytes == 1 and signed == 0 and at >= 0 and at < 4096 = ldrb(d, base, at)
template load-word(d, base, at, bytes, signed) when bytes == 1 and at >= 0 and at < 4096 = ldrsb(d, base, at)
template load-word(d, base, at, bytes, signed) when at >= -256 and at < 256 and (signed == 0 or bytes == 8) = ldur(log2(bytes), d, base, at & 511)
template load-word(d, base, at, bytes, signed) when at >= -256 and at < 256 = ldur(log2(bytes), d, base, at & 511) ; sbfm(1, d, d, 0, bytes * 8 - 1)
template load-word(d, base, at, bytes, signed) = address(x17, base, at) ; load-word(d, x17, 0, bytes, signed)
template store-word(s, base, at, bytes) when bytes == 8 and at >= 0 and at < 32768 and at % 8 == 0 = str(s, base, at / 8)
template store-word(s, base, at, bytes) when bytes == 4 and at >= 0 and at < 16384 and at % 4 == 0 = strw(s, base, at / 4)
template store-word(s, base, at, bytes) when bytes == 2 and at >= 0 and at < 8192 and at % 2 == 0 = strh(s, base, at / 2)
template store-word(s, base, at, bytes) when bytes == 1 and at >= 0 and at < 4096 = strb(s, base, at)
template store-word(s, base, at, bytes) when at >= -256 and at < 256 = stur(log2(bytes), s, base, at & 511)
template store-word(s, base, at, bytes) = address(x17, base, at) ; store-word(s, x17, 0, bytes)
# Zero into `bytes` at `at` from `base`.
template store-zero(base, at, bytes) = store-word(zr, base, at, bytes)
# The same for floating registers: 4, 8 or 16 bytes.
template load-float(d, base, at, bytes) when bytes == 16 and at >= 0 and at < 65536 and at % 16 == 0 = ldr-q(d, base, at / 16)
template load-float(d, base, at, bytes) when bytes == 8 and at >= 0 and at < 32768 and at % 8 == 0 = ldr-d(d, base, at / 8)
template load-float(d, base, at, bytes) when bytes == 4 and at >= 0 and at < 16384 and at % 4 == 0 = ldr-s(d, base, at / 4)
template load-float(d, base, at, bytes) when bytes <= 8 and at >= -256 and at < 256 = ldur-f(log2(bytes), d, base, at & 511)
template load-float(d, base, at, bytes) = address(x17, base, at) ; load-float(d, x17, 0, bytes)
template store-float(s, base, at, bytes) when bytes == 16 and at >= 0 and at < 65536 and at % 16 == 0 = str-q(s, base, at / 16)
template store-float(s, base, at, bytes) when bytes == 8 and at >= 0 and at < 32768 and at % 8 == 0 = str-d(s, base, at / 8)
template store-float(s, base, at, bytes) when bytes == 4 and at >= 0 and at < 16384 and at % 4 == 0 = str-s(s, base, at / 4)
template store-float(s, base, at, bytes) when bytes <= 8 and at >= -256 and at < 256 = stur-f(log2(bytes), s, base, at & 511)
template store-float(s, base, at, bytes) = address(x17, base, at) ; store-float(s, x17, 0, bytes)

# Control that is only structure.
rule START   => nothing
rule REGION  => nothing
rule LOOP    => nothing
rule TRUE    => nothing
rule FALSE   => nothing
rule PHI     => nothing
rule SWITCH  => nothing
rule CASE    => nothing
rule DEFAULT => nothing
rule TRAP    => brk(1)
rule TAILCALL => nothing
rule CALL    => nothing
rule RESULT  => nothing
rule RETURN  => nothing
rule RESERVE => nothing

rule PARAM   => nothing

# A frame object's address: so far below the frame record.
rule SLOT                        => object-address(out, object, 0)

# The address of something in this image, and of something outside it, which
# is read from the table of addresses.
rule SYMBOL s                    => adrp(out, s) ; add-symbol(out, out, s)
rule EXTERN s                    => adrp-got(out, s) ; ldr-got(out, out, s)

# A floating constant is its bits, built in an integer register and moved across.
rule CONST k when float and k == 0          => fmov-from-gpr(sf, out, zr)
rule CONST k when float and width == 32     => movz(0, $t, k & 65535, 0) ; movk(0, $t, (k >> 16) & 65535, 1) ; fmov-from-gpr(0, out, $t)
rule CONST k when float => movz(1, $t, k & 65535, 0) ; movk(1, $t, (k >> 16) & 65535, 1) ; movk(1, $t, (k >> 32) & 65535, 2) ; movk(1, $t, (k >> 48) & 65535, 3) ; fmov-from-gpr(1, out, $t)

# Constants, by how many sixteen-bit pieces they need.
rule CONST k when k >= 0 and k < 65536      => movz(1, out, k, 0)
rule CONST k when k < 0 and k >= -65536     => movn(1, out, ~k, 0)
rule CONST k when k >= 0 and k < 4294967296 => movz(1, out, k & 65535, 0) ; movk(1, out, (k >> 16) & 65535, 1)
rule CONST k when k >= 0 and k < 281474976710656 => movz(1, out, k & 65535, 0) ; movk(1, out, (k >> 16) & 65535, 1) ; movk(1, out, (k >> 32) & 65535, 2)
rule CONST k => movz(1, out, k & 65535, 0) ; movk(1, out, (k >> 16) & 65535, 1) ; movk(1, out, (k >> 32) & 65535, 2) ; movk(1, out, (k >> 48) & 65535, 3)

rule ADD(x, CONST k) when u12(k)   => add-imm(sf, out, x, k)
rule ADD(x, CONST k) when u12(-k)  => sub-imm(sf, out, x, -k)
rule ADD(once MUL(a, b), c)        => madd(sf, out, a, b, c)
rule ADD(x, once SHL(y, CONST k)) when width >= 32 and k > 0 and k < width => add-shifted(sf, out, x, y, k)
rule ADD(x, y)                     => add(sf, out, x, y)
rule SUB(x, CONST k) when u12(k)   => sub-imm(sf, out, x, k)
rule SUB(x, once SHL(y, CONST k)) when width >= 32 and k > 0 and k < width => sub-shifted(sf, out, x, y, k)
rule SUB(x, y)                     => sub(sf, out, x, y)
rule MUL(x, y)                     => madd(sf, out, x, y, zr)
# A mask that is a logical immediate needs no register. Below 64 bits it is
# the 32-bit pattern, which as an immediate is the pattern twice.
# Arithmetic kept to its low 32 bits is the 32-bit instruction, which leaves
# zeros above them.
rule AND(once ADD(a, CONST c), CONST k) when width == 64 and k == 4294967295 and u12(c)  => add-imm(0, out, a, c)
rule AND(once ADD(a, CONST c), CONST k) when width == 64 and k == 4294967295 and u12(-c) => sub-imm(0, out, a, -c)
rule AND(once ADD(a, b), CONST k) when width == 64 and k == 4294967295 => add(0, out, a, b)
rule AND(once SUB(a, b), CONST k) when width == 64 and k == 4294967295 => sub(0, out, a, b)
rule AND(once MUL(a, b), CONST k) when width == 64 and k == 4294967295 => madd(0, out, a, b, zr)
rule AND(once NEG(a), CONST k) when width == 64 and k == 4294967295    => sub(0, out, zr, a)
rule AND(once SHL(a, CONST s), CONST k) when width == 64 and k == 4294967295 and s > 0 and s < 32 => ubfm(0, out, a, 32 - s, 31 - s)
rule AND(x, CONST k) when width == 64 and logical(k)           => and-imm(1, out, x, logical(k))
rule AND(x, CONST k) when width < 64 and logical(repeat32(k))  => and-imm(0, out, x, logical(repeat32(k)))
rule AND(x, once SHL(y, CONST s)) when width >= 32 and s > 0 and s < width => and-lsl(sf, out, x, y, s)
rule AND(x, once SHR(y, CONST s)) when width >= 32 and s > 0 and s < width => and-lsr(sf, out, x, y, s)
rule AND(x, y)                     => and(sf, out, x, y)
rule OR(x, CONST k) when width == 64 and logical(k)            => orr-imm(1, out, x, logical(k))
rule OR(x, CONST k) when width < 64 and logical(repeat32(k))   => orr-imm(0, out, x, logical(repeat32(k)))
rule OR(x, once SHL(y, CONST s)) when width >= 32 and s > 0 and s < width => orr-lsl(sf, out, x, y, s)
rule OR(x, once SHR(y, CONST s)) when width >= 32 and s > 0 and s < width => orr-lsr(sf, out, x, y, s)
rule OR(x, y)                      => orr(sf, out, x, y)
rule XOR(x, CONST k) when width == 64 and logical(k)           => eor-imm(1, out, x, logical(k))
rule XOR(x, CONST k) when width < 64 and logical(repeat32(k))  => eor-imm(0, out, x, logical(repeat32(k)))
rule XOR(x, once SHL(y, CONST s)) when width >= 32 and s > 0 and s < width => eor-lsl(sf, out, x, y, s)
rule XOR(x, once SHR(y, CONST s)) when width >= 32 and s > 0 and s < width => eor-lsr(sf, out, x, y, s)
rule XOR(x, y)                     => eor(sf, out, x, y)
rule NEG(x)                        => sub(sf, out, zr, x)
rule NOT(x) when width == 1        => movz(0, $one, 1, 0) ; eor(0, out, x, $one)
rule NOT(x)                        => orn(sf, out, zr, x)

# Shifts count modulo the width, which the machine does for 32 and 64 bits.
# By a constant, a shift is a bit field.
rule SHL(x, CONST k) when width >= 32 => ubfm(sf, out, x, (width - (k & (width - 1))) & (width - 1), width - 1 - (k & (width - 1)))
rule SHR(x, CONST k) when width >= 32 => ubfm(sf, out, x, k & (width - 1), width - 1)
rule SAR(x, CONST k) when width >= 32 => sbfm(sf, out, x, k & (width - 1), width - 1)
rule SHL(x, y) when width == 8     => ubfm(0, $n, y, 0, 2) ; lslv(0, out, x, $n)
rule SHL(x, y) when width == 16    => ubfm(0, $n, y, 0, 3) ; lslv(0, out, x, $n)
rule SHL(x, y)                     => lslv(sf, out, x, y)
rule SHR(x, y) when width == 8     => ubfm(0, $n, y, 0, 2) ; lsrv(0, out, zx(x), $n)
rule SHR(x, y) when width == 16    => ubfm(0, $n, y, 0, 3) ; lsrv(0, out, zx(x), $n)
rule SHR(x, y)                     => lsrv(sf, out, x, y)
rule SAR(x, y) when width == 8     => ubfm(0, $n, y, 0, 2) ; asrv(0, out, sx(x), $n)
rule SAR(x, y) when width == 16    => ubfm(0, $n, y, 0, 3) ; asrv(0, out, sx(x), $n)
rule SAR(x, y)                     => asrv(sf, out, x, y)

# Bits. Below 32 bits, leading zeros are counted in 32 and the extra taken
# off; trailing zeros are counted with a bit set just above the value.
rule CLZ(x) when width == 8        => clz(0, $c, zx(x)) ; sub-imm(0, out, $c, 24)
rule CLZ(x) when width == 16       => clz(0, $c, zx(x)) ; sub-imm(0, out, $c, 16)
rule CLZ(x)                        => clz(sf, out, x)
rule CTZ(x) when width == 8        => movz(0, $m, 256, 0) ; orr(0, $t, x, $m) ; rbit(0, $r, $t) ; clz(0, out, $r)
rule CTZ(x) when width == 16       => movz(0, $m, 1, 1) ; orr(0, $t, x, $m) ; rbit(0, $r, $t) ; clz(0, out, $r)
rule CTZ(x)                        => rbit(sf, $r, x) ; clz(sf, out, $r)
rule POPCNT(x) when width == 64    => fmov-from-gpr(1, $v, x) ; cnt-bytes($c, $v) ; add-bytes($s, $c) ; fmov-to-gpr(0, out, $s)
rule POPCNT(x)                     => fmov-from-gpr(0, $v, zx(x)) ; cnt-bytes($c, $v) ; add-bytes($s, $c) ; fmov-to-gpr(0, out, $s)
rule BITREV(x)                     => rbit(sf, out, x)
rule BSWAP(x) when width == 64     => rev64(out, x)
rule BSWAP(x)                      => rev32(out, x)
rule ROR(x, y)                     => rorv(sf, out, x, y)
rule ROL(x, y)                     => sub(sf, $n, zr, y) ; rorv(sf, out, x, $n)

rule SMIN(x, y)                    => subs(sf, zr, sx(x), sx(y)) ; csel(sf, out, x, y, lt)
rule SMAX(x, y)                    => subs(sf, zr, sx(x), sx(y)) ; csel(sf, out, x, y, gt)
rule UMIN(x, y)                    => subs(sf, zr, zx(x), zx(y)) ; csel(sf, out, x, y, lo)
rule UMAX(x, y)                    => subs(sf, zr, zx(x), zx(y)) ; csel(sf, out, x, y, hi)
rule UMULH(x, y) when width == 64  => umulh(out, x, y)
rule UMULH(x, y)                   => umull($p, x, y) ; ubfm(1, out, $p, 32, 63)
rule SMULH(x, y) when width == 64  => smulh(out, x, y)
rule SMULH(x, y)                   => smull($p, x, y) ; ubfm(1, out, $p, 32, 63)

# Overflow: the flags of the same sum or difference, or the product's high half.
rule SADDO(a, b)                   => adds(sf(a), zr, a, b) ; csinc(0, out, zr, zr, vc)
rule UADDO(a, b)                   => adds(sf(a), zr, a, b) ; csinc(0, out, zr, zr, lo)
rule SSUBO(a, b)                   => subs(sf(a), zr, a, b) ; csinc(0, out, zr, zr, vc)
rule USUBO(a, b)                   => subs(sf(a), zr, a, b) ; csinc(0, out, zr, zr, hs)
rule SMULO(a, b) when bits(a) == 64 => madd(1, $l, a, b, zr) ; smulh($h, a, b) ; cmp-asr(1, $h, $l, 63) ; csinc(0, out, zr, zr, eq)
rule SMULO(a, b)                   => smull($p, a, b) ; sbfm(1, $s, $p, 0, 31) ; subs(1, zr, $p, $s) ; csinc(0, out, zr, zr, eq)
rule UMULO(a, b) when bits(a) == 64 => umulh($h, a, b) ; subs-imm(1, zr, $h, 0) ; csinc(0, out, zr, zr, eq)
rule UMULO(a, b)                   => umull($p, a, b) ; ubfm(1, $h, $p, 32, 63) ; subs-imm(1, zr, $h, 0) ; csinc(0, out, zr, zr, eq)
rule IF(_, SADDO(a, b))            => adds(sf(a), zr, a, b) ; b-cond(vs, then) ; jump(else)
rule IF(_, UADDO(a, b))            => adds(sf(a), zr, a, b) ; b-cond(hs, then) ; jump(else)
rule IF(_, SSUBO(a, b))            => subs(sf(a), zr, a, b) ; b-cond(vs, then) ; jump(else)
rule IF(_, USUBO(a, b))            => subs(sf(a), zr, a, b) ; b-cond(lo, then) ; jump(else)

rule UDIV(x, y)                    => udiv(sf, out, zx(x), zx(y))
rule SDIV(x, y)                    => sdiv(sf, out, sx(x), sx(y))
rule UREM(x, y)                    => udiv(sf, $q, zx(x), zx(y)) ; msub(sf, out, $q, zx(y), zx(x))
rule SREM(x, y)                    => sdiv(sf, $q, sx(x), sx(y)) ; msub(sf, out, $q, sx(y), sx(x))

# A boolean in a register is exactly 0 or 1, so as a wider number it is itself.
rule ZEXT(x) when bits(x) == 1     => x
# A load of fewer than 64 bits leaves zeros above them.
rule ZEXT(x) when loaded(x) and bits(x) >= 8 => x
rule ZEXT(x)                       => ubfm(1, out, x, 0, bits(x) - 1)
rule SEXT(x)                       => sbfm(1, out, x, 0, bits(x) - 1)
rule TRUNC(x) when width == 1      => ubfm(0, out, x, 0, 0)
# Cutting a value down leaves it where it is: the bits above are nobody's.
rule TRUNC(x)                      => x

# Floating point.
rule FADD(x, y)   => fadd(sf, out, x, y)
rule FSUB(x, y)   => fsub(sf, out, x, y)
rule FMUL(x, y)   => fmul(sf, out, x, y)
rule FDIV(x, y)   => fdiv(sf, out, x, y)
rule FNEG(x)      => fneg(sf, out, x)
rule FABS(x)      => fabs(sf, out, x)
rule FSQRT(x)     => fsqrt(sf, out, x)
rule FMAX(x, y)         => fextreme(sf, 0, out, x, y)
rule FMIN(x, y)         => fextreme(sf, 1, out, x, y)
rule FMAX-NUMBER(x, y)  => fextreme(sf, 2, out, x, y)
rule FMIN-NUMBER(x, y)  => fextreme(sf, 3, out, x, y)
rule ROUND-EVEN(x)      => fround(sf, 0, out, x)
rule ROUND-UP(x)        => fround(sf, 1, out, x)
rule ROUND-DOWN(x)      => fround(sf, 2, out, x)
rule ROUND-ZERO(x)      => fround(sf, 3, out, x)
rule ROUND-AWAY(x)      => fround(sf, 4, out, x)
rule FMA(x, y, z)       => fmadd(sf, out, x, y, z)
rule FEQ(a, b)    => fcmp(sf(a), a, b) ; csinc(0, out, zr, zr, ne)
rule FNE(a, b)    => fcmp(sf(a), a, b) ; csinc(0, out, zr, zr, eq)
rule FLT(a, b)    => fcmp(sf(a), a, b) ; csinc(0, out, zr, zr, pl)
rule FLE(a, b)    => fcmp(sf(a), a, b) ; csinc(0, out, zr, zr, hi)
rule SITOF(x)     => scvtf(sf(x), sf, out, sx(x))
rule UITOF(x)     => ucvtf(sf(x), sf, out, zx(x))
rule FTOSI(x)     => fcvtzs(sf, sf(x), out, x)
rule FTOUI(x)     => fcvtzu(sf, sf(x), out, x)
rule FEXT(x)      => fcvt-to-double(out, x)
rule FTRUNC(x)    => fcvt-to-single(out, x)
rule BITCAST(x) when float and not float(x)  => fmov-from-gpr(sf, out, x)
rule BITCAST(x) when float(x) and not float  => fmov-to-gpr(sf, out, x)
rule BITCAST(x)                              => x

# A frame object near the frame record, and a place inside one, is read and
# written from the frame register: no address is computed.
rule LOAD(_, p) when width <= 64 and slot(p) and object(p) <= 256 and float => ldur-f(log2(width / 8), out, x29, (512 - object(p)) & 511)
rule LOAD(_, p) when width <= 64 and slot(p) and object(p) <= 256 => ldur(log2((width + 7) / 8), out, x29, (512 - object(p)) & 511)
rule LOAD(_, ADD(p, CONST k)) when width <= 64 and slot(p) and k >= 0 and k < object(p) and object(p) - k <= 256 and float => ldur-f(log2(width / 8), out, x29, (512 - (object(p) - k)) & 511)
rule LOAD(_, ADD(p, CONST k)) when width <= 64 and slot(p) and k >= 0 and k < object(p) and object(p) - k <= 256 => ldur(log2((width + 7) / 8), out, x29, (512 - (object(p) - k)) & 511)
rule STORE(_, p, v) when bits(v) <= 64 and slot(p) and object(p) <= 256 and float(v) => stur-f(log2(bits(v) / 8), v, x29, (512 - object(p)) & 511)
rule STORE(_, p, v) when bits(v) <= 64 and slot(p) and object(p) <= 256 => stur(log2((bits(v) + 7) / 8), v, x29, (512 - object(p)) & 511)
rule STORE(_, ADD(p, CONST k), v) when bits(v) <= 64 and slot(p) and k >= 0 and k < object(p) and object(p) - k <= 256 and float(v) => stur-f(log2(bits(v) / 8), v, x29, (512 - (object(p) - k)) & 511)
rule STORE(_, ADD(p, CONST k), v) when bits(v) <= 64 and slot(p) and k >= 0 and k < object(p) and object(p) - k <= 256 => stur(log2((bits(v) + 7) / 8), v, x29, (512 - (object(p) - k)) & 511)

rule LOAD(_, ADD(p, CONST k)) when width == 128 and k >= 0 and k < 65536 and k & 15 == 0 => ldr-q(out, p, k >> 4)
rule LOAD(_, p) when width == 128            => ldr-q(out, p, 0)
rule STORE(_, ADD(p, CONST k), v) when bits(v) == 128 and k >= 0 and k < 65536 and k & 15 == 0 => str-q(v, p, k >> 4)
rule STORE(_, p, v) when bits(v) == 128      => str-q(v, p, 0)
rule LOAD(_, ADD(p, CONST k)) when float and width == 64 and k >= 0 and k < 32768 and k & 7 == 0 => ldr-d(out, p, k >> 3)
rule LOAD(_, ADD(p, CONST k)) when float and width == 32 and k >= 0 and k < 16384 and k & 3 == 0 => ldr-s(out, p, k >> 2)
rule LOAD(_, p) when float and width == 64   => ldr-d(out, p, 0)
rule LOAD(_, p) when float                   => ldr-s(out, p, 0)
rule STORE(_, ADD(p, CONST k), v) when float(v) and bits(v) == 64 and k >= 0 and k < 32768 and k & 7 == 0 => str-d(v, p, k >> 3)
rule STORE(_, ADD(p, CONST k), v) when float(v) and bits(v) == 32 and k >= 0 and k < 16384 and k & 3 == 0 => str-s(v, p, k >> 2)
rule STORE(_, p, v) when float(v) and bits(v) == 64 => str-d(v, p, 0)
rule STORE(_, p, v) when float(v)                   => str-s(v, p, 0)

# Memory. An address that is a base plus a small multiple of the width is one
# instruction; any other address is computed first.
rule LOAD(_, ADD(p, CONST k)) when width == 64 and k >= 0 and k < 32768 and k & 7 == 0 => ldr(out, p, k >> 3)
rule LOAD(_, ADD(p, CONST k)) when width == 32 and k >= 0 and k < 16384 and k & 3 == 0 => ldrw(out, p, k >> 2)
rule LOAD(_, ADD(p, CONST k)) when width == 16 and k >= 0 and k < 8192 and k & 1 == 0  => ldrh(out, p, k >> 1)
rule LOAD(_, ADD(p, CONST k)) when width <= 8 and k >= 0 and k < 4096                 => ldrb(out, p, k)
# A base plus an index, or plus an index times the width, is an address as it is.
rule LOAD(_, ADD(p, once SHL(i, CONST k))) when not float and width == 64 and k == 3 => load-indexed(3, out, p, i, 1)
rule LOAD(_, ADD(p, once SHL(i, CONST k))) when not float and width == 32 and k == 2 => load-indexed(2, out, p, i, 1)
rule LOAD(_, ADD(p, once SHL(i, CONST k))) when not float and width == 16 and k == 1 => load-indexed(1, out, p, i, 1)
rule LOAD(_, once ADD(p, i)) when not float and width <= 64 => load-indexed(log2((width + 7) / 8), out, p, i, 0)
rule LOAD(_, p) when width == 64   => ldr(out, p, 0)
rule LOAD(_, p) when width == 32   => ldrw(out, p, 0)
rule LOAD(_, p) when width == 16   => ldrh(out, p, 0)
rule LOAD(_, p)                    => ldrb(out, p, 0)
# A frame object further off, and a place inside one, is read and written
# from the base, at an offset settled when the frame is laid out.
rule LOAD(_, p) when width <= 64 and slot(p) and float            => read-object-float(out, object(p), width / 8)
rule LOAD(_, p) when width <= 64 and slot(p)                      => read-object(out, object(p), (width + 7) / 8)
rule LOAD(_, ADD(p, CONST k)) when width <= 64 and slot(p) and k >= 0 and k < object(p) and float => read-object-float(out, object(p) - k, width / 8)
rule LOAD(_, ADD(p, CONST k)) when width <= 64 and slot(p) and k >= 0 and k < object(p)           => read-object(out, object(p) - k, (width + 7) / 8)
rule STORE(_, p, CONST z as v) when z == 0 and not float(v) and bits(v) <= 64 and slot(p) => write-object(zr, object(p), (bits(v) + 7) / 8)
rule STORE(_, ADD(p, CONST k), CONST z as v) when z == 0 and not float(v) and bits(v) <= 64 and slot(p) and k >= 0 and k < object(p) => write-object(zr, object(p) - k, (bits(v) + 7) / 8)
rule STORE(_, p, v) when bits(v) <= 64 and slot(p) and float(v)   => write-object-float(v, object(p), bits(v) / 8)
rule STORE(_, p, v) when bits(v) <= 64 and slot(p)                => write-object(v, object(p), (bits(v) + 7) / 8)
rule STORE(_, ADD(p, CONST k), v) when bits(v) <= 64 and slot(p) and k >= 0 and k < object(p) and float(v) => write-object-float(v, object(p) - k, bits(v) / 8)
rule STORE(_, ADD(p, CONST k), v) when bits(v) <= 64 and slot(p) and k >= 0 and k < object(p)              => write-object(v, object(p) - k, (bits(v) + 7) / 8)

# Zero is stored from the register that is always zero.
rule STORE(_, p, CONST z as v) when z == 0 and not float(v) and slot(p) and object(p) <= 256 => stur(log2((bits(v) + 7) / 8), zr, x29, (512 - object(p)) & 511)
rule STORE(_, ADD(p, CONST k), CONST z as v) when z == 0 and not float(v) and slot(p) and k >= 0 and k < object(p) and object(p) - k <= 256 => stur(log2((bits(v) + 7) / 8), zr, x29, (512 - (object(p) - k)) & 511)
rule STORE(_, ADD(p, CONST k), CONST z as v) when z == 0 and bits(v) == 64 and not float(v) and k >= 0 and k < 32768 and k & 7 == 0 => str(zr, p, k >> 3)
rule STORE(_, ADD(p, CONST k), CONST z as v) when z == 0 and bits(v) == 32 and not float(v) and k >= 0 and k < 16384 and k & 3 == 0 => strw(zr, p, k >> 2)
rule STORE(_, ADD(p, CONST k), CONST z as v) when z == 0 and bits(v) == 16 and k >= 0 and k < 8192 and k & 1 == 0 => strh(zr, p, k >> 1)
rule STORE(_, ADD(p, CONST k), CONST z as v) when z == 0 and bits(v) <= 8 and k >= 0 and k < 4096 => strb(zr, p, k)
rule STORE(_, p, CONST z as v) when z == 0 and bits(v) == 64 and not float(v) => str(zr, p, 0)
rule STORE(_, p, CONST z as v) when z == 0 and bits(v) == 32 and not float(v) => strw(zr, p, 0)
rule STORE(_, p, CONST z as v) when z == 0 and bits(v) == 16 => strh(zr, p, 0)
rule STORE(_, p, CONST z as v) when z == 0 and bits(v) <= 8  => strb(zr, p, 0)
rule STORE(_, ADD(p, CONST k), v) when bits(v) == 64 and k >= 0 and k < 32768 and k & 7 == 0 => str(v, p, k >> 3)
rule STORE(_, ADD(p, CONST k), v) when bits(v) == 32 and k >= 0 and k < 16384 and k & 3 == 0 => strw(v, p, k >> 2)
rule STORE(_, ADD(p, CONST k), v) when bits(v) == 16 and k >= 0 and k < 8192 and k & 1 == 0  => strh(v, p, k >> 1)
rule STORE(_, ADD(p, CONST k), v) when bits(v) <= 8 and k >= 0 and k < 4096                 => strb(v, p, k)
rule STORE(_, ADD(p, once SHL(i, CONST k)), v) when not float(v) and bits(v) == 64 and k == 3 => store-indexed(3, v, p, i, 1)
rule STORE(_, ADD(p, once SHL(i, CONST k)), v) when not float(v) and bits(v) == 32 and k == 2 => store-indexed(2, v, p, i, 1)
rule STORE(_, ADD(p, once SHL(i, CONST k)), v) when not float(v) and bits(v) == 16 and k == 1 => store-indexed(1, v, p, i, 1)
rule STORE(_, once ADD(p, i), v) when not float(v) and bits(v) <= 64 => store-indexed(log2((bits(v) + 7) / 8), v, p, i, 0)
rule STORE(_, p, v) when bits(v) == 64 => str(v, p, 0)
rule STORE(_, p, v) when bits(v) == 32 => strw(v, p, 0)
rule STORE(_, p, v) when bits(v) == 16 => strh(v, p, 0)
rule STORE(_, p, v)                    => strb(v, p, 0)

# One of two values: on a comparison's flags, or on a boolean in a register.
rule COND(c, x, y) when float => subs-imm(0, zr, c, 0) ; fcsel(sf, out, x, y, ne)
rule COND(EQ(a, b), x, y)   => subs(sf(a), zr, zx(a), zx(b)) ; csel(sf, out, x, y, eq)
rule COND(NE(a, b), x, y)   => subs(sf(a), zr, zx(a), zx(b)) ; csel(sf, out, x, y, ne)
rule COND(LT(a, b), x, y)   => subs(sf(a), zr, sx(a), sx(b)) ; csel(sf, out, x, y, lt)
rule COND(LE(a, b), x, y)   => subs(sf(a), zr, sx(a), sx(b)) ; csel(sf, out, x, y, le)
rule COND(ULT(a, b), x, y)  => subs(sf(a), zr, zx(a), zx(b)) ; csel(sf, out, x, y, lo)
rule COND(ULE(a, b), x, y)  => subs(sf(a), zr, zx(a), zx(b)) ; csel(sf, out, x, y, ls)
rule COND(c, x, y)          => subs-imm(0, zr, c, 0) ; csel(sf, out, x, y, ne)

# A comparison as a value: the flags, then 1 where the condition holds.
# Against a small constant, the constant needs no register.
rule EQ(a, CONST k) when u12(k)   => subs-imm(sf(a), zr, zx(a), k) ; csinc(0, out, zr, zr, ne)
rule NE(a, CONST k) when u12(k)   => subs-imm(sf(a), zr, zx(a), k) ; csinc(0, out, zr, zr, eq)
rule LT(a, CONST k) when u12(k) and (bits(a) >= 32 or k < 128)   => subs-imm(sf(a), zr, sx(a), k) ; csinc(0, out, zr, zr, ge)
rule LE(a, CONST k) when u12(k) and (bits(a) >= 32 or k < 128)   => subs-imm(sf(a), zr, sx(a), k) ; csinc(0, out, zr, zr, gt)
rule ULT(a, CONST k) when u12(k)  => subs-imm(sf(a), zr, zx(a), k) ; csinc(0, out, zr, zr, hs)
rule ULE(a, CONST k) when u12(k)  => subs-imm(sf(a), zr, zx(a), k) ; csinc(0, out, zr, zr, hi)
# With the constant first, the comparison is the other way round.
rule LT(CONST k, a) when u12(k) and (bits(a) >= 32 or k < 128)   => subs-imm(sf(a), zr, sx(a), k) ; csinc(0, out, zr, zr, le)
rule LE(CONST k, a) when u12(k) and (bits(a) >= 32 or k < 128)   => subs-imm(sf(a), zr, sx(a), k) ; csinc(0, out, zr, zr, lt)
rule ULT(CONST k, a) when u12(k)  => subs-imm(sf(a), zr, zx(a), k) ; csinc(0, out, zr, zr, ls)
rule ULE(CONST k, a) when u12(k)  => subs-imm(sf(a), zr, zx(a), k) ; csinc(0, out, zr, zr, lo)
rule EQ(a, b)   => subs(sf(a), zr, zx(a), zx(b)) ; csinc(0, out, zr, zr, ne)
rule NE(a, b)   => subs(sf(a), zr, zx(a), zx(b)) ; csinc(0, out, zr, zr, eq)
rule LT(a, b)   => subs(sf(a), zr, sx(a), sx(b)) ; csinc(0, out, zr, zr, ge)
rule LE(a, b)   => subs(sf(a), zr, sx(a), sx(b)) ; csinc(0, out, zr, zr, gt)
rule ULT(a, b)  => subs(sf(a), zr, zx(a), zx(b)) ; csinc(0, out, zr, zr, hs)
rule ULE(a, b)  => subs(sf(a), zr, zx(a), zx(b)) ; csinc(0, out, zr, zr, hi)

# A signed comparison of a value narrower than 32 bits with a constant takes
# this way only if the constant is not negative: a negative one is held as its
# low bits, which is not the number.
# A branch on a comparison uses its flags directly.
# The low 32 bits against a small constant.
rule IF(_, EQ(AND(x, CONST m), CONST k)) when k > 0 and u12(k) and m == 4294967295 and bits(x) == 64 => subs-imm(0, zr, x, k) ; b-cond(eq, then) ; jump(else)
rule IF(_, NE(AND(x, CONST m), CONST k)) when k > 0 and u12(k) and m == 4294967295 and bits(x) == 64 => subs-imm(0, zr, x, k) ; b-cond(ne, then) ; jump(else)
rule IF(_, ULT(AND(x, CONST m), CONST k)) when u12(k) and m == 4294967295 and bits(x) == 64 => subs-imm(0, zr, x, k) ; b-cond(lo, then) ; jump(else)
# Whether the low 32 bits are zero.
rule IF(_, EQ(AND(x, CONST m), CONST k)) when k == 0 and m == 4294967295 and bits(x) == 64 => cbz(0, x, then) ; jump(else)
rule IF(_, NE(AND(x, CONST m), CONST k)) when k == 0 and m == 4294967295 and bits(x) == 64 => cbnz(0, x, then) ; jump(else)
rule IF(_, EQ(a, CONST k)) when k == 0  => cbz(sf(a), zx(a), then) ; jump(else)
rule IF(_, NE(a, CONST k)) when k == 0  => cbnz(sf(a), zx(a), then) ; jump(else)
rule IF(_, EQ(a, CONST k)) when u12(k)  => subs-imm(sf(a), zr, zx(a), k) ; b-cond(eq, then) ; jump(else)
rule IF(_, NE(a, CONST k)) when u12(k)  => subs-imm(sf(a), zr, zx(a), k) ; b-cond(ne, then) ; jump(else)
rule IF(_, LT(a, CONST k)) when u12(k) and (bits(a) >= 32 or k < 128)  => subs-imm(sf(a), zr, sx(a), k) ; b-cond(lt, then) ; jump(else)
rule IF(_, LE(a, CONST k)) when u12(k) and (bits(a) >= 32 or k < 128)  => subs-imm(sf(a), zr, sx(a), k) ; b-cond(le, then) ; jump(else)
rule IF(_, ULT(a, CONST k)) when u12(k) => subs-imm(sf(a), zr, zx(a), k) ; b-cond(lo, then) ; jump(else)
rule IF(_, ULE(a, CONST k)) when u12(k) => subs-imm(sf(a), zr, zx(a), k) ; b-cond(ls, then) ; jump(else)
rule IF(_, LT(CONST k, a)) when u12(k) and (bits(a) >= 32 or k < 128)  => subs-imm(sf(a), zr, sx(a), k) ; b-cond(gt, then) ; jump(else)
rule IF(_, LE(CONST k, a)) when u12(k) and (bits(a) >= 32 or k < 128)  => subs-imm(sf(a), zr, sx(a), k) ; b-cond(ge, then) ; jump(else)
rule IF(_, ULT(CONST k, a)) when u12(k) => subs-imm(sf(a), zr, zx(a), k) ; b-cond(hi, then) ; jump(else)
rule IF(_, ULE(CONST k, a)) when u12(k) => subs-imm(sf(a), zr, zx(a), k) ; b-cond(hs, then) ; jump(else)
rule IF(_, EQ(a, b))   => subs(sf(a), zr, zx(a), zx(b)) ; b-cond(eq, then) ; jump(else)
rule IF(_, NE(a, b))   => subs(sf(a), zr, zx(a), zx(b)) ; b-cond(ne, then) ; jump(else)
rule IF(_, LT(a, b))   => subs(sf(a), zr, sx(a), sx(b)) ; b-cond(lt, then) ; jump(else)
rule IF(_, LE(a, b))   => subs(sf(a), zr, sx(a), sx(b)) ; b-cond(le, then) ; jump(else)
rule IF(_, ULT(a, b))  => subs(sf(a), zr, zx(a), zx(b)) ; b-cond(lo, then) ; jump(else)
rule IF(_, ULE(a, b))  => subs(sf(a), zr, zx(a), zx(b)) ; b-cond(ls, then) ; jump(else)
rule IF(_, FEQ(a, b))  => fcmp(sf(a), a, b) ; b-cond(eq, then) ; jump(else)
rule IF(_, FNE(a, b))  => fcmp(sf(a), a, b) ; b-cond(ne, then) ; jump(else)
rule IF(_, FLT(a, b))  => fcmp(sf(a), a, b) ; b-cond(mi, then) ; jump(else)
rule IF(_, FLE(a, b))  => fcmp(sf(a), a, b) ; b-cond(ls, then) ; jump(else)
rule IF(_, c)          => cbnz(0, c, then) ; jump(else)

# Memory shared between threads. What the machine cannot do in one instruction
# is done by a loop around CAS before any of this is asked.
rule ATOMIC-LOAD(_, p)     => load-ordered(log2(width / 8), out, p)
rule ATOMIC-STORE(_, p, v) => store-ordered(log2(bits(v) / 8), v, p)
rule SWAP(_, p, v)         => swap(log2(width / 8), v, out, p)
rule FETCH-ADD(_, p, v)    => fetch(log2(width / 8), 0, v, out, p)
rule FETCH-SUB(_, p, v)    => sub(sf, $n, zr, v) ; fetch(log2(width / 8), 0, $n, out, p)
rule FETCH-AND(_, p, v)    => orn(sf, $n, zr, v) ; fetch(log2(width / 8), 1, $n, out, p)
rule FETCH-XOR(_, p, v)    => fetch(log2(width / 8), 2, v, out, p)
rule FETCH-OR(_, p, v)     => fetch(log2(width / 8), 3, v, out, p)
rule FETCH-SMAX(_, p, v)   => fetch(log2(width / 8), 4, v, out, p)
rule FETCH-SMIN(_, p, v)   => fetch(log2(width / 8), 5, v, out, p)
rule FETCH-UMAX(_, p, v)   => fetch(log2(width / 8), 6, v, out, p)
rule FETCH-UMIN(_, p, v)   => fetch(log2(width / 8), 7, v, out, p)
rule CAS(_, p, e, v)       => move(out, e) ; compare-swap(log2(width / 8), out, v, p)
rule FENCE                 => barrier()
