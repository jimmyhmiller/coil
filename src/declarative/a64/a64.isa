# AArch64: registers and the instructions the backend emits.
word 32

class gpr 5
reg x0..x30 : gpr
reg sp : gpr = 31
reg zr : gpr = 31

class simd 5
reg v0..v31 : simd

set allocatable  = x0..x14 x19..x28 v0..v30
set caller-saved = x0..x17 v0..v7 v16..v31
set callee-saved = x19..x28 v8..v15
set arguments    = x0..x7

# Registers the emitter may use for a value that lives in the frame.
const scratch0 = 16
const scratch1 = 17
const scratch2 = 15
const fscratch = 63
# A switch may go by a table of distances.
const tables = 1
# Machine code is whole instructions of this many bytes.
const code-unit = 4

# Condition codes.
const eq = 0
const ne = 1
const hs = 2
const lo = 3
const vs = 6
const vc = 7
const mi = 4
const pl = 5
const hi = 8
const ls = 9
const ge = 10
const lt = 11
const gt = 12
const le = 13
const al = 14

# Arithmetic on registers. `sf` picks 64-bit (1) or 32-bit (0) registers.
inst add(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)   = sf 0 0 01011 00 0 rm 000000 rn rd
inst sub(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)   = sf 1 0 01011 00 0 rm 000000 rn rd
inst subs(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)  = sf 1 1 01011 00 0 rm 000000 rn rd
inst and(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)   = sf 00 01010 00 0 rm 000000 rn rd
inst orr(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)   = sf 01 01010 00 0 rm 000000 rn rd
inst eor(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)   = sf 10 01010 00 0 rm 000000 rn rd
inst madd(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr, ra: use gpr) = sf 00 11011 000 rm 0 ra rn rd
inst lslv(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)  = sf 0 0 11010110 rm 0010 00 rn rd
inst lsrv(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)  = sf 0 0 11010110 rm 0010 01 rn rd
inst asrv(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)  = sf 0 0 11010110 rm 0010 10 rn rd
inst orn(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)   = sf 01 01010 00 1 rm 000000 rn rd
inst msub(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr, ra: use gpr) = sf 00 11011 000 rm 1 ra rn rd
inst udiv(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)  = sf 0 0 11010110 rm 00001 0 rn rd
inst sdiv(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)  = sf 0 0 11010110 rm 00001 1 rn rd
inst csel(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr, cond: u4) = sf 0 0 11010100 rm cond 0 0 rn rd
inst adds(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)  = sf 0 1 01011 00 0 rm 000000 rn rd
# With the carry: the high halves of a wider sum or difference.
inst adc(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)   = sf 0 0 11010000 rm 000000 rn rd
inst sbc(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)   = sf 1 0 11010000 rm 000000 rn rd
inst sbcs(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)  = sf 1 1 11010000 rm 000000 rn rd
inst rorv(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr)  = sf 0 0 11010110 rm 0010 11 rn rd
inst clz(sf: u1, rd: def gpr, rn: use gpr)                = sf 1 0 11010110 00000 00010 0 rn rd
inst rbit(sf: u1, rd: def gpr, rn: use gpr)               = sf 1 0 11010110 00000 00000 0 rn rd
inst rev32(rd: def gpr, rn: use gpr)                      = 0 1 0 11010110 00000 00001 0 rn rd
inst rev64(rd: def gpr, rn: use gpr)                      = 1 1 0 11010110 00000 00001 1 rn rd
inst umulh(rd: def gpr, rn: use gpr, rm: use gpr)         = 1 00 11011 110 rm 0 11111 rn rd
inst smulh(rd: def gpr, rn: use gpr, rm: use gpr)         = 1 00 11011 010 rm 0 11111 rn rd
inst umull(rd: def gpr, rn: use gpr, rm: use gpr)         = 1 00 11011 101 rm 0 11111 rn rd
inst smull(rd: def gpr, rn: use gpr, rm: use gpr)         = 1 00 11011 001 rm 0 11111 rn rd
# Compare with the second operand shifted right, keeping its sign, by `amount`.
inst cmp-asr(sf: u1, rn: use gpr, rm: use gpr, amount: u6) = sf 1 1 01011 10 0 rm amount rn 11111
# Count the set bits of each byte of a vector register, and add the bytes up.
inst cnt-bytes(rd: def simd, rn: use simd)                = 0 0 0 01110 00 10000 00101 10 rn rd
inst add-bytes(rd: def simd, rn: use simd)                = 0 0 0 01110 00 11000 11011 10 rn rd
inst csinc(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr, cond: u4) = sf 0 0 11010100 rm cond 0 1 rn rd

# Sums and differences with the second operand shifted left by `amount`.
inst add-shifted(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr, amount: u6) = sf 0 0 01011 00 0 rm amount rn rd
inst sub-shifted(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr, amount: u6) = sf 1 0 01011 00 0 rm amount rn rd

# And, or and exclusive-or with the second operand shifted left or right by `amount`.
inst and-lsl(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr, amount: u6) = sf 00 01010 00 0 rm amount rn rd
inst and-lsr(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr, amount: u6) = sf 00 01010 01 0 rm amount rn rd
inst orr-lsl(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr, amount: u6) = sf 01 01010 00 0 rm amount rn rd
inst orr-lsr(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr, amount: u6) = sf 01 01010 01 0 rm amount rn rd
inst eor-lsl(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr, amount: u6) = sf 10 01010 00 0 rm amount rn rd
inst eor-lsr(sf: u1, rd: def gpr, rn: use gpr, rm: use gpr, amount: u6) = sf 10 01010 01 0 rm amount rn rd

# A logical immediate: a run of `ones` one-bits, turned right by `rotate`
# within an element of `size` bits, the element repeated to fill the register.
immediate logical(size in 2 4 8 16 32 64, ones in 1..size - 1, rotate in 0..size - 1) = repeat(rotate-right(low-ones(ones), rotate, size), size) encoded (size == 64) << 12 | rotate << 6 | (~(size * 2 - 1)) & 63 | (ones - 1)

inst and-imm(sf: u1, rd: def gpr, rn: use gpr, mask: u13) = sf 00 100100 mask rn rd
inst ands-imm(sf: u1, rd: def gpr, rn: use gpr, mask: u13) = sf 11 100100 mask rn rd
inst orr-imm(sf: u1, rd: def gpr, rn: use gpr, mask: u13) = sf 01 100100 mask rn rd
inst eor-imm(sf: u1, rd: def gpr, rn: use gpr, mask: u13) = sf 10 100100 mask rn rd

# Arithmetic with a 12-bit immediate.
inst add-imm(sf: u1, rd: def gpr, rn: use gpr, imm: u12)  = sf 0 0 100010 0 imm rn rd
inst sub-imm(sf: u1, rd: def gpr, rn: use gpr, imm: u12)  = sf 1 0 100010 0 imm rn rd
inst subs-imm(sf: u1, rd: def gpr, rn: use gpr, imm: u12) = sf 1 1 100010 0 imm rn rd
# The same with the immediate times 4096.
inst add-imm-hi(sf: u1, rd: def gpr, rn: use gpr, imm: u12) = sf 0 0 100010 1 imm rn rd
inst sub-imm-hi(sf: u1, rd: def gpr, rn: use gpr, imm: u12) = sf 1 0 100010 1 imm rn rd

# Bit fields: bits 0..last of rn, with the rest zeros (ubfm) or the sign (sbfm).
inst ubfm(sf: u1, rd: def gpr, rn: use gpr, first: u6, last: u6) = sf 10 100110 sf first last rn rd
inst sbfm(sf: u1, rd: def gpr, rn: use gpr, first: u6, last: u6) = sf 00 100110 sf first last rn rd

# Constants, sixteen bits at a time: `hw` is which sixteen.
inst movz(sf: u1, rd: def gpr, imm: u16, hw: u2)          = sf 10 100101 hw imm rd
inst movn(sf: u1, rd: def gpr, imm: u16, hw: u2)          = sf 00 100101 hw imm rd
inst movk(sf: u1, rd: mod gpr, imm: u16, hw: u2)          = sf 11 100101 hw imm rd

# Control. A label is a distance in bytes, of which a field holds all but the
# two low bits, which are always zero.
inst b(to: label)                                         = 000101 to[27:2]
# A conditional branch names its opposite: the branch taken when it is not.
inst b-cond(cond: u4, to: label)                          = 01010100 to[20:2] 0 cond      opposite cond
inst cbz(sf: u1, rt: use gpr, to: label)                  = sf 0110100 to[20:2] rt        opposite cbnz
inst cbnz(sf: u1, rt: use gpr, to: label)                 = sf 0110101 to[20:2] rt        opposite cbz
inst brk(imm: u16)                                        = 11010100001 imm 00000
inst ret(rn: use gpr)                                     = 1101011001011111000000 rn 00000
# For a switch by table: the address `words` instructions ahead; a signed
# 32-bit word read from a base plus four times an index; and a word that is
# the distance from itself to a label.
inst address-ahead(rd: def gpr, words: u19)                         = 0 00 10000 words rd
inst load-distance(rt: def gpr, rn: use gpr, rm: use gpr)           = 10111000101 rm 011 1 10 rn rt
inst distance-to(to: label)                                         = to[31:0]
# Machine code given as it is.
inst raw(bits: u32)                                       = bits
# Symbols. S is the symbol's address, G the address of its slot in the table of
# addresses, P the instruction's own.
inst bl(to: symbol)                                       = 100101 to:26                  reloc branch26 = (S - P) >> 2
inst adrp(rd: def gpr, to: symbol)                        = 1 to[1:0] 10000 to[20:2] rd   reloc page21 = (page(S) - page(P)) >> 12
inst add-symbol(rd: def gpr, rn: use gpr, to: symbol)     = 1 0 0 100010 0 to:12 rn rd    reloc pageoff12 = S & 4095
inst adrp-got(rd: def gpr, to: symbol)                    = 1 to[1:0] 10000 to[20:2] rd   reloc got-page21 = (page(G) - page(P)) >> 12
inst ldr-got(rt: def gpr, rn: use gpr, to: symbol)        = 1111100101 to:12 rn rt        reloc got-pageoff12 = (G & 4095) >> 3
inst br(rn: use gpr)                                      = 1101011000011111000000 rn 00000
inst b-symbol(to: symbol)                                 = 000101 to:26                  reloc branch26 = (S - P) >> 2
inst blr(rn: use gpr)                                     = 1101011000111111000000 rn 00000

# Memory shared between threads; `size` is which power of two bytes. A load and
# a store in the one order every thread sees; rs put where rt was (swap); what
# was there combined with rs and put back, rt being what was there (fetch, `how`
# being add 0, clear 1, exclusive-or 2, set 3, and the larger and the smaller
# signed 4 5 and unsigned 6 7); and rt put there if rs was, rs then being what was.
inst load-ordered(size: u2, rt: def gpr, rn: use gpr)          = size 001000 1 1 0 11111 1 11111 rn rt
inst store-ordered(size: u2, rt: use gpr, rn: use gpr)         = size 001000 1 0 0 11111 1 11111 rn rt
inst swap(size: u2, rs: use gpr, rt: def gpr, rn: use gpr)     = size 111000 1 1 1 rs 1 000 00 rn rt
inst fetch(size: u2, how: u3, rs: use gpr, rt: def gpr, rn: use gpr) = size 111000 1 1 1 rs 0 how 00 rn rt
inst compare-swap(size: u2, rs: mod gpr, rt: use gpr, rn: use gpr)   = size 001000 1 1 1 rs 1 11111 rn rt
inst barrier()                                                 = 11010101000000110011101110111111

# Floating point. `ty` picks double (1) or single (0).
inst fadd(ty: u1, rd: def simd, rn: use simd, rm: use simd)  = 00011110 0 ty 1 rm 001010 rn rd
inst fsub(ty: u1, rd: def simd, rn: use simd, rm: use simd)  = 00011110 0 ty 1 rm 001110 rn rd
inst fmul(ty: u1, rd: def simd, rn: use simd, rm: use simd)  = 00011110 0 ty 1 rm 000010 rn rd
inst fdiv(ty: u1, rd: def simd, rn: use simd, rm: use simd)  = 00011110 0 ty 1 rm 000110 rn rd
inst fmov(ty: u1, rd: def simd, rn: use simd)                = 00011110 0 ty 1 0000 00 10000 rn rd
inst fabs(ty: u1, rd: def simd, rn: use simd)                = 00011110 0 ty 1 0000 01 10000 rn rd
inst fneg(ty: u1, rd: def simd, rn: use simd)                = 00011110 0 ty 1 0000 10 10000 rn rd
inst fsqrt(ty: u1, rd: def simd, rn: use simd)               = 00011110 0 ty 1 0000 11 10000 rn rd
# The larger and the smaller, as FMAX, FMIN, FMAX-NUMBER and FMIN-NUMBER (`how` 0 to 3).
inst fextreme(ty: u1, how: u2, rd: def simd, rn: use simd, rm: use simd) = 00011110 0 ty 1 rm 01 how 10 rn rd
# To a whole number: `mode` 0 nearest even, 1 up, 2 down, 3 toward zero, 4 nearest away.
inst fround(ty: u1, mode: u3, rd: def simd, rn: use simd)    = 00011110 0 ty 1 001 mode 10000 rn rd
# ra + rn * rm, rounded once.
inst fmadd(ty: u1, rd: def simd, rn: use simd, rm: use simd, ra: use simd) = 00011111 0 ty 0 rm 0 ra rn rd
inst fcmp(ty: u1, rn: use simd, rm: use simd)                = 00011110 0 ty 1 rm 001000 rn 00000
inst fcsel(ty: u1, rd: def simd, rn: use simd, rm: use simd, cond: u4) = 00011110 0 ty 1 rm cond 11 rn rd
inst fcvt-to-double(rd: def simd, rn: use simd)              = 00011110 00 1 0001 01 10000 rn rd
inst fcvt-to-single(rd: def simd, rn: use simd)              = 00011110 01 1 0001 00 10000 rn rd
# Between integers and floating point: `sf` is the integer's width.
inst scvtf(sf: u1, ty: u1, rd: def simd, rn: use gpr)        = sf 0011110 0 ty 1 00 010 000000 rn rd
inst ucvtf(sf: u1, ty: u1, rd: def simd, rn: use gpr)        = sf 0011110 0 ty 1 00 011 000000 rn rd
inst fcvtzs(sf: u1, ty: u1, rd: def gpr, rn: use simd)       = sf 0011110 0 ty 1 11 000 000000 rn rd
inst fcvtzu(sf: u1, ty: u1, rd: def gpr, rn: use simd)       = sf 0011110 0 ty 1 11 001 000000 rn rd
# The same bits, moved between the two kinds of register.
inst fmov-from-gpr(sf: u1, rd: def simd, rn: use gpr)        = sf 0011110 0 sf 1 00 111 000000 rn rd
inst fmov-to-gpr(sf: u1, rd: def gpr, rn: use simd)          = sf 0011110 0 sf 1 00 110 000000 rn rd
# A whole vector register: copied, and to and from memory at a multiple of sixteen.
inst mov-vector(rd: def simd, rn: use simd)                  = 0 1 0 01110 10 1 rn 000111 rn rd
inst ldr-q(rt: def simd, rn: use gpr, imm: u12)              = 0011110111 imm rn rt
inst str-q(rt: use simd, rn: use gpr, imm: u12)              = 0011110110 imm rn rt
inst ldr-d(rt: def simd, rn: use gpr, imm: u12)              = 1111110101 imm rn rt
inst str-d(rt: use simd, rn: use gpr, imm: u12)              = 1111110100 imm rn rt
inst ldr-s(rt: def simd, rn: use gpr, imm: u12)              = 1011110101 imm rn rt
inst str-s(rt: use simd, rn: use gpr, imm: u12)              = 1011110100 imm rn rt

# Memory at a base plus an offset counted in units of the access's width.
inst ldrb(rt: def gpr, rn: use gpr, imm: u12)             = 0011100101 imm rn rt
inst ldrh(rt: def gpr, rn: use gpr, imm: u12)             = 0111100101 imm rn rt
inst ldrw(rt: def gpr, rn: use gpr, imm: u12)             = 1011100101 imm rn rt
# Loads of fewer than 64 bits that extend their sign to all 64.
inst ldrsb(rt: def gpr, rn: use gpr, imm: u12)            = 0011100110 imm rn rt
inst ldrsh(rt: def gpr, rn: use gpr, imm: u12)            = 0111100110 imm rn rt
inst ldrsw(rt: def gpr, rn: use gpr, imm: u12)            = 1011100110 imm rn rt
inst strb(rt: use gpr, rn: use gpr, imm: u12)             = 0011100100 imm rn rt
inst strh(rt: use gpr, rn: use gpr, imm: u12)             = 0111100100 imm rn rt
inst strw(rt: use gpr, rn: use gpr, imm: u12)             = 1011100100 imm rn rt

# Memory at a base plus any offset from -256 to 255, in bytes: `size` is which
# power of two bytes are read or written, and `-f` is a floating register.
inst ldur(size: u2, rt: def gpr, rn: use gpr, imm: u9)      = size 111 0 00 01 0 imm 00 rn rt
inst stur(size: u2, rt: use gpr, rn: use gpr, imm: u9)      = size 111 0 00 00 0 imm 00 rn rt
inst ldur-f(size: u2, rt: def simd, rn: use gpr, imm: u9)   = size 111 1 00 01 0 imm 00 rn rt
inst stur-f(size: u2, rt: use simd, rn: use gpr, imm: u9)   = size 111 1 00 00 0 imm 00 rn rt

# Memory at a base plus an index register, the index times the access's width
# if `scaled` is 1; `size` is which power of two bytes.
inst load-indexed(size: u2, rt: def gpr, rn: use gpr, rm: use gpr, scaled: u1)  = size 111000011 rm 011 scaled 10 rn rt
inst store-indexed(size: u2, rt: use gpr, rn: use gpr, rm: use gpr, scaled: u1) = size 111000001 rm 011 scaled 10 rn rt

# Two registers to and from two words next to each other, the first `imm`
# words from the base, which may be up to 64 words below it.
inst stp(rt: use gpr, rt2: use gpr, rn: use gpr, imm: u7)      = 1010100100 imm rt2 rn rt
inst ldp(rt: def gpr, rt2: def gpr, rn: use gpr, imm: u7)      = 1010100101 imm rt2 rn rt
inst stp-d(rt: use simd, rt2: use simd, rn: use gpr, imm: u7)  = 0110110100 imm rt2 rn rt
inst ldp-d(rt: def simd, rt2: def simd, rn: use gpr, imm: u7)  = 0110110101 imm rt2 rn rt

# The frame: 64-bit loads and stores at a multiple of eight from a base.
inst ldr(rt: def gpr, rn: use gpr, imm: u12)              = 1111100101 imm rn rt
inst str(rt: use gpr, rn: use gpr, imm: u12)              = 1111100100 imm rn rt
