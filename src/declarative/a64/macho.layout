# A Mach-O relocatable object for arm64: one segment with a section of code and
# a section of data, their relocations, the symbols and their names.
target declarative.a64.target
symbols defined first
prefix "_"

block header {
  u32 0xfeedfacf                      # 64-bit Mach-O
  u32 0x0100000c  u32 0               # arm64
  u32 1                               # a relocatable object
  u32 4  u32 size(commands)           # four load commands
  u32 0x2000                          # symbols divide the sections
  u32 0
}

block commands {
  # The segment: everything from the code to the end of the data.
  u32 0x19  u32 232
  text "" pad 16
  u64 0  u64 offset(after-data) - offset(code)  u64 offset(code)  u64 offset(after-data) - offset(code)
  u32 7  u32 7  u32 2  u32 0
  # The section of code.
  text "__text" pad 16  text "__TEXT" pad 16
  u64 0  u64 size(code)  u32 offset(code)
  u32 2                               # aligned to four bytes
  u32 offset(relocs)  u32 count(relocs)
  u32 0x80000400                      # instructions, and nothing else
  u32 0  u32 0  u32 0
  # The section of data, which follows the code.
  text "__data" pad 16  text "__DATA" pad 16
  u64 offset(data) - offset(code)  u64 size(data)  u32 offset(data)
  u32 3                               # aligned to eight bytes
  u32 offset(pointers)  u32 count(pointers)
  u32 0  u32 0  u32 0  u32 0

  # Built for macOS 11.0.
  u32 0x32  u32 24  u32 1  u32 0x000b0000  u32 0  u32 0

  # The symbol table and the names.
  u32 2  u32 24  u32 offset(symtab)  u32 count(symbols)  u32 offset(strings)  u32 size(strings)

  # Which symbols are which: none local, then the defined, then the undefined.
  u32 0xb  u32 80
  u32 0  u32 0
  u32 0  u32 count(defined)
  u32 count(defined)  u32 count(undefined)
  u32 0  u32 0  u32 0  u32 0  u32 0  u32 0  u32 0  u32 0  u32 0  u32 0  u32 0  u32 0
}

block code { code }
block after-code { align 8 }
block data { data }
block after-data { align 8 }

# A relocation: where, then the symbol's number, whether the value is relative
# to the instruction, four bytes wide, by symbol, and which kind.
block relocs {
  each r in relocs {
    u32 r.at
    u32 r.symbol.number | r.kind(branch26: 1, page21: 1, got-page21: 1, else 0) << 24 | 2 << 25 | 1 << 27 | r.kind(branch26: 2, page21: 3, pageoff12: 4, got-page21: 5, got-pageoff12: 6) << 28
  }
}

# A pointer in the data: eight bytes that hold a symbol's address.
block pointers {
  each p in pointers {
    u32 p.at
    u32 p.symbol.number | 3 << 25 | 1 << 27
  }
}

block symtab {
  each s in symbols {
    u32 s.strx
    u8 if s.defined then 0x0f else 0x01    # external, and in a section or not
    u8 if not s.defined then 0 else if s.in-data then 2 else 1
    u16 0
    u64 if not s.defined then 0 else if s.in-data then offset(data) - offset(code) + s.value else s.value
  }
}

block strings {
  u8 0
  each s in symbols { text s.name  u8 0 }
  align 8
}
