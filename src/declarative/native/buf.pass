# Byte storage shared by CIR's assembler and the object writers. Encoding is
# explicit even at unaligned offsets; allocation and growth are generated.
library declarative
byte-buffer Buf {
  capacity 256;
  endian little;
  integer 8;
  integer 16;
  integer 32;
  integer 64;
  leb128;
}
