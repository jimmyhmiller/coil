# Library algorithms and their storage for cir-copies.

library

use "native.cir" as cir;

use "native.cir-ops" as cop;


const K-READ = 1;

const K-WRITE = 2;

const K-SRET = 3;

const K-CALL = 4;

const K-ARG = 5;

record Access {
  inst: u32;
  kind: i64;
  lo: i64;
  hi: i64;
}

const P-NOCAPTURE = 1;

const P-READONLY = 2;

record Edge {
  symbol: i64;
  arg: u32;
  operands: u32;
}

record Summaries {
  first: list[u32];
  count: list[u32];
  flags: list[u8];
}

construct Summaries as summaries-new();

release Summaries as summaries-free!(sums);

# The slot of `symbol`'s argument `arg` when called with `operands`
# operands, or -1 when nothing is known of such a call.
# Flags of `symbol`'s argument `arg` when called with `operands` operands.
fn summary-slot(sums: ref[Summaries], symbol: i64, arg: u32, operands: u32) -> i64 {
  if(((symbol < 0) or (symbol >= len(sums.first)) or ((sums.first)[symbol] == typed[u32](0)) or ((sums.count)[symbol] != operands) or (arg >= operands)), -1, cir::i64-of((((sums.first)[symbol] - typed[u32](1)) + arg)));
}

fn summary(sums: ref[Summaries], symbol: i64, arg: u32, operands: u32) -> u8 {
  bind {
    slot = summary-slot(sums, symbol, arg, operands);
  } {
    if((slot < 0), typed[u8](0), (sums.flags)[slot]);
  };
}

record State {
  f: ref[cir::Func] = f;
  sums: ref[Summaries] = sums;
  at: list[u32];
  block-of: list[u32];
  use-start: list[u32];
  use-user: list[u32];
  use-index: list[u32];
  root: list[u32];
  off: list[i64];
  escaped: list[bool];
  calls: list[u32];
  acc-first: list[u32];
  acc-count: list[u32];
  accesses: list[Access];
  derived: list[u32];
  sret-arg: list[bool];
  rpo: list[u32];
  order: list[u32];
  idom: list[u32];
  mark-f: list[u32];
  mark-b: list[u32];
  enter-f: list[u32];
  enter-b: list[u32];
  reached: list[u32];
  stamp: u32 = typed[u32](0);
  work: list[u32];
  starts: list[u32];
  work-writes: list[u32];
  hoist: list[u32];
  touched: list[bool];
  dead-slot: list[bool];
  fill: list[u32];
}

fn none() -> u32 {
  cir::none();
}

fn opcode(f: ref[cir::Func], v: u32) -> i64 {
  as[i64]((cir::val(f, v)).op);
}

construct State as state-new(f: ref[cir::Func], sums: ref[Summaries]);

# Turn ST to another function. Every analysis fills what it reads from the
# function at hand, so a state serves any number of functions in turn.
fn state-retarget!(st: ref[State], f: ref[cir::Func], sums: ref[Summaries]) -> void {
  set st.f = f;
  set st.sums = sums;
  clear!(borrow(st.hoist));
}

release State as state-free!(st);

# One allocation and a store loop, not n capacity-checked pushes.
fn fill-u32!(xs: mut[list[u32]], n: i64, v: u32) -> void {
  fill(borrow(xs), n, v);
}

fn fill-bool!(xs: mut[list[bool]], n: i64, v: bool) -> void {
  fill(borrow(xs), n, v);
}

# ---- CFG ----
fn successor-count(f: ref[cir::Func], b: u32) -> u32 {
  bind {
    term = (cir::blk(f, b)).term;
  } {
    if((term == none()), typed[u32](0), bind {
      x = cir::val(f, term);
    } {
      (x.ntotal - x.nops);
    });
  };
}

fn successor(f: ref[cir::Func], b: u32, i: u32) -> u32 {
  bind {
    x = cir::val(f, (cir::blk(f, b)).term);
  } {
    cir::operand(f, x, (x.nops + i));
  };
}

# Immediate-dominator equations over CIR's declared CFG adjacency. The graph
# language derives traversal order and convergence, including unreachable nodes.
dominators dominators!(st: ref[State]) {
  nodes = cir::i64-of(cir::block-count(st.f));
  entry = typed[u32](0);
  absent = none();
  ranks = st.rpo;
  parents = st.idom;
  order = st.order;
  work = st.work;
  successor-count = successor-count(st.f, b);
  successor = successor(st.f, b, k);
  predecessors {
    chain e from (cir::blk(st.f, b)).pred-first until none() next st.f.edges[cir::i64-of(e)].next;
    yield = st.f.edges[cir::i64-of(e)].from;
  }
}

# Whether position `a` executes before `b` on every path reaching `b`.
fn dominates?(st: ref[State], a: u32, b: u32) -> bool {
  bind {
    ba = (st.block-of)[cir::i64-of(a)];
    bb = (st.block-of)[cir::i64-of(b)];
  } {
    choose {
      (((st.idom)[cir::i64-of(ba)] == none()) or ((st.idom)[cir::i64-of(bb)] == none())) => false;
      (ba == bb) => (a < b);
      else => bind {
        var x = bb;
        var found = false;
      } {
        while((not(found) and (x != typed[u32](0)))) {
          set x = (st.idom)[cir::i64-of(x)];
          when((x == ba)) {
            set found = true;
          };
        };
        found;
      };
    };
  };
}

# ---- regions ----
# Mark (in mark-f, listed in `reached`) every position reachable after one of
# `starts`, without executing position `stop` (NONE: no stop).
region forward!(st: ref[State], stop: u32) {
  direction = forward;
  advance = true;
  starts = st.starts;
  partition = st.block-of[cir::i64-of(p)];
  begin = (cir::blk(st.f, b)).ibegin;
  end = (cir::blk(st.f, b)).iend;
  marks = st.mark-f;
  entered = st.enter-f;
  generation = st.stamp;
  work = st.work;
  collect = st.reached;
  neighbors {
    from i in range(0, cir::i64-of(successor-count(st.f, b)));
    yield = successor(st.f, b, cir::u32-of(i));
  }
}



# Mark (in mark-b) every position from which one of `starts` is reachable
# without executing `stop`. Uses the forward pass's stamp.
region backward!(st: ref[State], stop: u32) {
  direction = backward;
  advance = false;
  starts = st.starts;
  partition = st.block-of[cir::i64-of(p)];
  begin = (cir::blk(st.f, b)).ibegin;
  end = (cir::blk(st.f, b)).iend;
  marks = st.mark-b;
  entered = st.enter-b;
  generation = st.stamp;
  work = st.work;
  neighbors {
    chain e from (cir::blk(st.f, b)).pred-first until none() next st.f.edges[cir::i64-of(e)].next;
    yield = st.f.edges[cir::i64-of(e)].from;
  }
}

# Positions below `before` in block b, latest first.


fn forward-marked?(st: ref[State], p: u32) -> bool {
  ((st.mark-f)[cir::i64-of(p)] == st.stamp);
}

fn backward-marked?(st: ref[State], p: u32) -> bool {
  ((st.mark-b)[cir::i64-of(p)] == st.stamp);
}

# ---- analysis ----




fn each-user(f: ref[cir::Func], i: i64) -> u32 {
  if((i < len(f.insts)), (f.insts)[i], (f.phis)[(i - len(f.insts))]);
}

fn analyze-uses!(st: ref[State]) -> void {
  bind {
    f = st.f;
    nv = len(f.values);
    ni = len(f.insts);
    users = (ni + len(f.phis));
  } {
    fill-u32!(borrow(st.at), nv, none());
    fill-u32!(borrow(st.block-of), ni, typed[u32](0));
    for b in range(0, cir::i64-of(cir::block-count(f))) {
      bind {
        bb = cir::blk(f, cir::u32-of(b));
      } {
        for j in range(cir::i64-of(bb.ibegin), cir::i64-of(bb.iend)) {
          put(borrow(st.block-of), j, cir::u32-of(b));
          put(borrow(st.at), cir::i64-of((f.insts)[j]), cir::u32-of(j));
        };
      };
    };
    index-uses!(st);
  };
}

# Inverting this relation derives the CSR use index. The same ordered rows
# supply counting, prefix sums and placement; no pass maintains a cursor.
relation index-uses!(st: ref[State]) {
  keys = len(st.f.values);
  offsets = st.use-start;
  cursor = st.fill;
  from i in range(0, len(st.f.insts) + len(st.f.phis));
  let user = each-user(st.f, i);
  let value = cir::val(st.f, user);
  from k in range(0, cir::i64-of(value.nops));
  key = cir::operand(st.f, value, cir::u32-of(k));
  column st.use-user = user;
  column st.use-index = cir::u32-of(k);
}

fn analyze!(st: ref[State]) -> void {
  analyze-uses!(st);
  bind {
    f = st.f;
    nv = len(f.values);
  } {
    fill-u32!(borrow(st.root), nv, none());
    clear!(borrow(st.off));
    extend-zeroed!(borrow(st.off), nv);
    fill-bool!(borrow(st.escaped), nv, false);
    fill-u32!(borrow(st.calls), nv, typed[u32](0));
    fill-u32!(borrow(st.acc-first), nv, typed[u32](0));
    fill-u32!(borrow(st.acc-count), nv, typed[u32](0));
    fill-bool!(borrow(st.sret-arg), nv, false);
    fill-bool!(borrow(st.touched), nv, false);
    fill-bool!(borrow(st.dead-slot), nv, false);
    clear!(borrow(st.accesses));
    for i in range(0, len(f.allocas)) {
      trace-root!(st, (f.allocas)[i]);
    };
    for i in range(0, len(f.args)) {
      when((f.arg-sret)[i]) {
        bind {
          a = (f.args)[i];
        } {
          put(borrow(st.sret-arg), cir::i64-of(a), true);
          trace-root!(st, a);
        };
      };
    };
  };
}

# Every use of root r's derived addresses, as accesses or an escape.
fn trace-root!(st: ref[State], r: u32) -> void {
  bind {
    f = st.f;
    first = cir::u32-of(len(st.accesses));
  } {
    put(borrow(st.root), cir::i64-of(r), r);
    put(borrow(st.off), cir::i64-of(r), 0);
    clear!(borrow(st.derived));
    push!(borrow(st.derived), r);
    bind {
      var i = 0;
    } {
      while((i < len(st.derived))) {
        bind {
          d = (st.derived)[i];
          o = (st.off)[cir::i64-of(d)];
          lo = (st.use-start)[cir::i64-of(d)];
          hi = (st.use-start)[(cir::i64-of(d) + 1)];
        } {
          for u in range(cir::i64-of(lo), cir::i64-of(hi)) {
            bind {
              user = (st.use-user)[u];
              k = (st.use-index)[u];
              x = cir::val(f, user);
              op = as[i64](x.op);
              inst = (st.at)[cir::i64-of(user)];
            } {
              choose {
                (inst == none()) => put(borrow(st.escaped), cir::i64-of(r), true);
                ((op == cop::OP-ADDI) and (k == typed[u32](0))) => if(((st.root)[cir::i64-of(user)] != none()), put(borrow(st.escaped), cir::i64-of(r), true), do {
                  put(borrow(st.root), cir::i64-of(user), r);
                  put(borrow(st.off), cir::i64-of(user), (o + x.imm));
                  push!(borrow(st.derived), user);
                });
                ((op == cop::OP-LOAD) and (k == typed[u32](0)) and not(cir::volatile?(f, user))) => push-access!(st, user, K-READ, (o + x.imm), (x.imm2 & 255));
                ((op == cop::OP-STORE) and (k == typed[u32](0)) and not(cir::volatile?(f, user))) => push-access!(st, user, K-WRITE, (o + x.imm), (x.imm2 & 255));
                (op == cop::OP-MEMCPY) => push-access!(st, user, if((k == typed[u32](0)), K-WRITE, K-READ), o, x.imm);
                ((op == cop::OP-MEMZERO) and (k == typed[u32](0))) => push-access!(st, user, K-WRITE, o, x.imm);
                (op == cop::OP-CALL) => bind {
                  flags = (f.argflags)[cir::i64-of((x.opb + k))];
                  known = if((as[u64](st.sums) == 0), typed[u8](0), summary(st.sums, x.imm, k, x.nops));
                } {
                  choose {
                    (((known & typed[u8](3)) != typed[u8](0)) and ((flags & typed[u32](0x100)) == typed[u32](0))) => push-access!(st, user, if(((known & typed[u8](3)) == typed[u8](3)), K-READ, K-ARG), o, 0x40000000);
                    (((flags & typed[u32](0x100)) != typed[u32](0)) and (x.aux == typed[u8](0)) and (x.ty == as[u8](cop::T-VOID))) => push-access!(st, user, K-SRET, o, 0x40000000);
                    ((flags & as[u32](cir::AF-INDIRECT)) != typed[u32](0)) => push-access!(st, user, K-ARG, o, 0x40000000);
                    else => do {
                      put(borrow(st.calls), cir::i64-of(r), ((st.calls)[cir::i64-of(r)] + typed[u32](1)));
                      push-access!(st, user, K-CALL, o, 0x40000000);
                    };
                  };
                };
                else => put(borrow(st.escaped), cir::i64-of(r), true);
              };
            };
          };
        };
        set i = (i + 1);
      };
    };
    put(borrow(st.acc-first), cir::i64-of(r), first);
    put(borrow(st.acc-count), cir::i64-of(r), (cir::u32-of(len(st.accesses)) - first));
  };
}

fn push-access!(st: ref[State], inst: u32, kind: i64, lo: i64, size: i64) -> void {
  push!(borrow(st.accesses), make Access {
    inst = inst;
    kind = kind;
    lo = lo;
    hi = (lo + size);
  });
}

fn access(st: ref[State], r: u32, i: u32) -> Access {
  (st.accesses)[cir::i64-of(((st.acc-first)[cir::i64-of(r)] + i))];
}

fn private?(st: ref[State], r: u32) -> bool {
  ((r != none()) and not((st.escaped)[cir::i64-of(r)]) and ((st.calls)[cir::i64-of(r)] == typed[u32](0)) and not((st.touched)[cir::i64-of(r)]));
}

fn alloca?(st: ref[State], r: u32) -> bool {
  (opcode(st.f, r) == cop::OP-ALLOCA);
}

fn position(st: ref[State], v: u32) -> u32 {
  (st.at)[cir::i64-of(v)];
}

# An instruction that may write memory other than a private slot's.
fn foreign-write?(st: ref[State], p: u32) -> bool {
  bind {
    f = st.f;
    v = (f.insts)[cir::i64-of(p)];
    x = cir::val(f, v);
    op = as[i64](x.op);
  } {
    choose {
      ((op == cop::OP-STORE) or (op == cop::OP-MEMCPY) or (op == cop::OP-MEMZERO)) => bind {
        r = (st.root)[cir::i64-of(cir::operand(f, x, typed[u32](0)))];
      } {
        not(((r != none()) and alloca?(st, r) and not((st.escaped)[cir::i64-of(r)]) and ((st.calls)[cir::i64-of(r)] == typed[u32](0))));
      };
      ((op == cop::OP-MEMCPYV) or (op == cop::OP-MEMMOVEV) or (op == cop::OP-MEMSETV) or (op == cop::OP-CALL) or (op == cop::OP-TAILCALL) or (op == cop::OP-SHIMCALL) or (op == cop::OP-MACHINE) or (op == cop::OP-ATOMIC-RMW) or (op == cop::OP-CMPXCHG) or (op == cop::OP-ATOMIC-STORE) or (op == cop::OP-FENCE)) => true;
      else => false;
    };
  };
}

# Every derived ADDI of root r, and every access, is dominated by position p.
fn uses-dominated?(st: ref[State], r: u32, p: u32, except: u32) -> bool =
  (all i in range(0, cir::i64-of(st.acc-count[cir::i64-of(r)])):
    let a = access(st, r, cir::u32-of(i)) in a.inst == except or dominates?(st, p, position(st, a.inst)))
  and derived-dominated?(st, r, p);

fn derived-dominated?(st: ref[State], r: u32, p: u32) -> bool =
  all u in range(cir::i64-of(st.use-start[cir::i64-of(r)]), cir::i64-of(st.use-start[cir::i64-of(r) + 1])):
    let user = st.use-user[u] in
      opcode(st.f, user) != cop::OP-ADDI or dominates?(st, p, position(st, user));

# ---- the three rewrites ----
# Forward or move: the copy's destination slot becomes its source.
rewrite try-into-source!(st: ref[State], c: u32) {
  let f = st.f;
  let x = cir::val(f, c);
  let n = x.imm;
  let pc = position(st, c);
  let dst = cir::operand(f, x, typed[u32](0));
  let src = cir::operand(f, x, typed[u32](1));
  let d = st.root[cir::i64-of(dst)];
  let s = st.root[cir::i64-of(src)];
  let soff = st.off[cir::i64-of(src)];
  require d != none() and alloca?(st, d) and dst == d and not(st.escaped[cir::i64-of(d)])
    and not(st.touched[cir::i64-of(d)]) and (cir::val(f, d)).imm == n and s != d;
  require all i in range(0, cir::i64-of(st.acc-count[cir::i64-of(d)])):
    let a = access(st, d, cir::u32-of(i)) in
      if(a.inst == c, a.kind == K-WRITE, dominates?(st, pc, position(st, a.inst)));
  require hoistable?(f, src) or derived-dominated?(st, d, pc);
  require s == none() or not(st.touched[cir::i64-of(s)]);
  let written = any i in range(0, cir::i64-of(st.acc-count[cir::i64-of(d)])):
    let a = access(st, d, cir::u32-of(i)) in a.inst != c and a.kind != K-READ;
  require if(written, move-safe?(st, c, d, s, soff, n), forward-safe?(st, c, d, s, src, soff, n));
  apply hoist-chain!(st, src) when not(cir-value?(f, src)) and hoistable?(f, src);
  apply replace-root!(st, d, src, c, s);
}

# An ADDI chain ending at an alloca or argument computes the same address
# anywhere, so it may move to the entry block.
fn hoistable?(f: ref[cir::Func], v: u32) -> bool =
  cir-value?(f, v) or (opcode(f, v) == cop::OP-ADDI
    and hoistable?(f, cir::operand(f, cir::val(f, v), typed[u32](0))));

fn hoist-chain!(st: ref[State], v: u32) -> void {
  bind {
    f = st.f;
    var x = v;
  } {
    while((opcode(f, x) == cop::OP-ADDI)) {
      push!(borrow(st.hoist), x);
      set x = cir::operand(f, cir::val(f, x), typed[u32](0));
    };
  };
}

# Move the recorded ADDIs to the start of the entry block, outermost first.
fn hoist!(st: ref[State]) -> void {
  bind {
    f = st.f;
    n = len(st.hoist);
  } {
    when((n > 0)) {
      bind {
        var moved = list[bool];
        var out = list[u32];
      } {
        fill-bool!(borrow(moved), len(f.values), false);
        for v in st.hoist {
          put(borrow(moved), cir::i64-of(v), true);
        };
        for b in range(0, cir::i64-of(cir::block-count(f))) {
          bind {
            bb = cir::blk(f, cir::u32-of(b));
            lo = cir::i64-of(bb.ibegin);
            hi = cir::i64-of(bb.iend);
          } {
            set bb.ibegin = cir::u32-of(len(out));
            when((b == 0)) {
              bind {
                var i = (n - 1);
              } {
                while((i >= 0)) {
                  bind {
                    v = (st.hoist)[i];
                  } {
                    when((moved)[cir::i64-of(v)]) {
                      put(borrow(moved), cir::i64-of(v), false);
                      push!(borrow(out), v);
                    };
                  };
                  set i = (i - 1);
                };
              };
            };
            for j in range(lo, hi) {
              bind {
                v = (f.insts)[j];
              } {
                unless(contains-hoisted?(st, v)) {
                  push!(borrow(out), v);
                };
              };
            };
            set bb.iend = cir::u32-of(len(out));
          };
        };
        clear!(borrow(f.insts));
        for v in out {
          push!(borrow(f.insts), v);
        };
        free!(borrow(out));
        free!(borrow(moved));
        clear!(borrow(st.hoist));
      };
    };
  };
}

fn contains-hoisted?(st: ref[State], v: u32) -> bool = any h in st.hoist: h == v;

# Constant-free values usable anywhere: allocas and arguments.
fn cir-value?(f: ref[cir::Func], v: u32) -> bool {
  bind {
    op = as[i64]((cir::val(f, v)).op);
  } {
    ((op == cop::OP-ALLOCA) or (op == cop::OP-ARG));
  };
}

predicate move-safe?(st: ref[State], c: u32, d: u32, s: u32, soff: i64, n: i64) {
  let f = st.f;
  require s != none() and alloca?(st, s) and private?(st, s)
    and soff + n <= (cir::val(f, s)).imm
    and (cir::val(f, s)).imm2 >= (cir::val(f, d)).imm2
    and soff % (cir::val(f, d)).imm2 == 0;
  reach forward! from { yield = position(st, c); } until none();
  ensure all i in range(0, cir::i64-of(st.acc-count[cir::i64-of(s)])):
    let a = access(st, s, cir::u32-of(i)) in a.inst == c or not(forward-marked?(st, position(st, a.inst)));
}

predicate forward-safe?(st: ref[State], c: u32, d: u32, s: u32, src: u32, soff: i64, n: i64) {
  let f = st.f;
  let pc = position(st, c);
  let enumerable = s != none() and not(st.escaped[cir::i64-of(s)]) and st.calls[cir::i64-of(s)] == typed[u32](0);
  reach forward! from { yield = pc; } until pc;
  reach backward! from {
    from i in range(0, cir::i64-of(st.acc-count[cir::i64-of(d)]));
    let a = access(st, d, cir::u32-of(i));
    where a.inst != c;
    yield = position(st, a.inst);
  } until pc;
  ensure if(enumerable,
    (all i in range(0, cir::i64-of(st.acc-count[cir::i64-of(s)])):
      let a = access(st, s, cir::u32-of(i)), p = position(st, a.inst) in
        a.inst == c or a.kind == K-READ or a.lo >= soff + n or a.hi <= soff
        or not((forward-marked?(st, p) and backward-marked?(st, p)) or reads-root?(st, a.inst, d))),
    (all p in st.reached: not(backward-marked?(st, p) and foreign-write?(st, p)))
      and (all i in range(0, cir::i64-of(st.acc-count[cir::i64-of(d)])):
        let a = access(st, d, cir::u32-of(i)) in a.inst == c or not(foreign-write?(st, position(st, a.inst)))));
  ensure all i in range(0, cir::i64-of(st.acc-count[cir::i64-of(d)])):
    let a = access(st, d, cir::u32-of(i)) in
      a.inst == c or opcode(f, a.inst) != cop::OP-MEMCPY or copy-target-safe?(st, a, s, soff, enumerable);
}

fn copy-target-safe?(st: ref[State], a: Access, s: u32, soff: i64, enumerable: bool) -> bool =
  let y = cir::val(st.f, a.inst), target = cir::operand(st.f, y, typed[u32](0)), t = st.root[cir::i64-of(target)] in
    (t != none() and alloca?(st, t) and t != s and not(st.escaped[cir::i64-of(t)]) and st.calls[cir::i64-of(t)] == typed[u32](0))
    or (t != none() and t == s and enumerable and
      (let to = st.off[cir::i64-of(target)], from = soff + a.lo in to + y.imm <= from or from + y.imm <= to));

# Whether instruction v also accesses root r (through any operand).
fn reads-root?(st: ref[State], v: u32, r: u32) -> bool =
  any i in range(0, cir::i64-of(st.acc-count[cir::i64-of(r)])):
    (access(st, r, cir::u32-of(i))).inst == v;

# Call slot: the copy's private source slot becomes the destination.
rewrite try-into-destination!(st: ref[State], c: u32) {
  let f = st.f;
  let x = cir::val(f, c);
  let n = x.imm;
  let pc = position(st, c);
  let dst = cir::operand(f, x, typed[u32](0));
  let src = cir::operand(f, x, typed[u32](1));
  let s = st.root[cir::i64-of(src)];
  let d = st.root[cir::i64-of(dst)];
  let doff = st.off[cir::i64-of(dst)];
  require s != none() and alloca?(st, s) and src == s and private?(st, s) and (cir::val(f, s)).imm == n
    and st.acc-count[cir::i64-of(s)] > typed[u32](1) and d != none() and d != s and private?(st, d)
    and ((alloca?(st, d) and doff + n <= (cir::val(f, d)).imm
      and (cir::val(f, d)).imm2 >= (cir::val(f, s)).imm2 and doff % (cir::val(f, s)).imm2 == 0)
      or st.sret-arg[cir::i64-of(d)]);
  require hoistable?(f, dst) or uses-dominated?(st, s, position(st, dst), none());
  reach forward! from { yield = pc; } until none();
  ensure all i in range(0, cir::i64-of(st.acc-count[cir::i64-of(s)])):
    let a = access(st, s, cir::u32-of(i)) in a.inst == c or not(forward-marked?(st, position(st, a.inst)));
  ensure all i in range(0, cir::i64-of(st.acc-count[cir::i64-of(s)])):
    let a = access(st, s, cir::u32-of(i)) in a.inst == c or not(reads-root?(st, a.inst, d));
  reach forward! from {
    from i in range(0, cir::i64-of(st.acc-count[cir::i64-of(s)]));
    let a = access(st, s, cir::u32-of(i));
    where a.inst != c;
    yield = position(st, a.inst);
  } until pc;
  ensure all i in range(0, cir::i64-of(st.acc-count[cir::i64-of(d)])):
    let a = access(st, d, cir::u32-of(i)) in a.inst == c or not(forward-marked?(st, position(st, a.inst)))
      or a.kind == K-WRITE or a.kind == K-SRET;
  derive st.work-writes from {
    from i in range(0, cir::i64-of(st.acc-count[cir::i64-of(d)]));
    let a = access(st, d, cir::u32-of(i));
    where a.inst != c and forward-marked?(st, position(st, a.inst));
    yield = position(st, a.inst);
  };
  ensure all write in st.work-writes: write-before-source-safe?(st, write, s);
  apply hoist-chain!(st, dst) when not(cir-value?(f, dst)) and hoistable?(f, dst);
  apply replace-root!(st, s, dst, c, d);
}

predicate write-before-source-safe?(st: ref[State], write: u32, s: u32) {
  reach forward! from { yield = write; } until none();
  ensure all i in range(0, cir::i64-of(st.acc-count[cir::i64-of(s)])):
    not(forward-marked?(st, position(st, (access(st, s, cir::u32-of(i))).inst)));
}

# Every operand naming slot `old` names `new` instead; the copy is dead.
scatter redirect-root-uses!(st: ref[State], old: u32, new: u32) {
  from u in range(cir::i64-of(st.use-start[cir::i64-of(old)]), cir::i64-of(st.use-start[cir::i64-of(old) + 1]));
  let user = st.use-user[u];
  let x = cir::val(st.f, user);
  write st.f.operands at cir::i64-of(x.opb + st.use-index[u]) = new;
}
scatter retire-copy!(st: ref[State], old: u32, c: u32) {
  let dead = cir::val(st.f, c);
  field dead.flags = dead.flags | typed[u8](8);
  field dead.nops = typed[u32](0);
  field dead.ntotal = typed[u32](0);
  write st.touched at cir::i64-of(old) = true;
  write st.dead-slot at cir::i64-of(old) = true;
}
scatter touch-root!(st: ref[State], root: u32) {
  where root != none();
  write st.touched at cir::i64-of(root) = true;
}
rewrite replace-root!(st: ref[State], old: u32, new: u32, c: u32, other: u32) {
  apply redirect-root-uses!(st, old, new);
  apply retire-copy!(st, old, c);
  apply touch-root!(st, other);
  apply touch-root!(st, st.root[cir::i64-of(new)]);
}

fn drop-slots!(st: ref[State]) -> void {
  bind {
    f = st.f;
    var kept = 0;
  } {
    for i in range(0, len(f.allocas)) {
      bind {
        v = (f.allocas)[i];
      } {
        unless((st.dead-slot)[cir::i64-of(v)]) {
          set (cir::val(f, v)).next = cir::u32-of(kept);
          put(borrow(f.allocas), kept, v);
          set kept = (kept + 1);
        };
      };
    };
    truncate(borrow(f.allocas), kept);
  };
}

# ---- sinking copies out of PHIs ----
# Uses of every PHI by instructions and other PHIs.
fn phi-uses!(f: ref[cir::Func], counts: mut[list[u32]]) -> void {
  fill-u32!(borrow(counts), len(f.values), typed[u32](0));
  for i in range(0, (len(f.insts) + len(f.phis))) {
    bind {
      x = cir::val(f, each-user(f, i));
    } {
      for k in range(0, cir::i64-of(x.nops)) {
        bind {
          o = cir::i64-of(cir::operand(f, x, cir::u32-of(k)));
        } {
          when((opcode(f, cir::u32-of(o)) == cop::OP-PHI)) {
            put(borrow(counts), o, ((counts)[o] + typed[u32](1)));
          };
        };
      };
    };
  };
}

# Whether block b ends in an unconditional branch to `target`.
fn branches-to?(f: ref[cir::Func], b: u32, target: u32) -> bool {
  bind {
    term = (cir::blk(f, b)).term;
  } {
    ((term != none()) and (opcode(f, term) == cop::OP-BR) and (successor(f, b, typed[u32](0)) == target));
  };
}

# MEMCPY(dst <- PHI) as the first instruction of the PHI's block becomes one
# copy before each predecessor's branch. dst must be an alloca or argument.
fn sink-copies!(f: ref[cir::Func]) -> i64 {
  bind {
    var pending = list[u32];
    var dead-phis = list[u32];
    var counts = list[u32];
    var counted = false;
    var sunk = typed[i64](0);
  } {
    for b in range(0, cir::i64-of(cir::block-count(f))) {
      bind {
        bb = read(cir::blk(f, cir::u32-of(b)));
      } {
        when((bb.ibegin < bb.iend)) {
          bind {
            c = (f.insts)[cir::i64-of(bb.ibegin)];
            x = read(cir::val(f, c));
          } {
            when(((as[i64](x.op) == cop::OP-MEMCPY) and ((x.flags & typed[u8](8)) == typed[u8](0)) and cir-value?(f, cir::operand(f, cir::val(f, c), typed[u32](0))))) {
              bind {
                dst = cir::operand(f, cir::val(f, c), typed[u32](0));
                src = cir::operand(f, cir::val(f, c), typed[u32](1));
                y = read(cir::val(f, src));
              } {
                when(((as[i64](y.op) == cop::OP-PHI) and (y.block == cir::u32-of(b)) and (src != dst))) {
                  bind {
                    var good = true;
                  } {
                    for k in range(0, cir::i64-of(y.nops)) {
                      bind {
                        pred = cir::operand(f, cir::val(f, src), (y.nops + cir::u32-of(k)));
                      } {
                        unless(branches-to?(f, pred, cir::u32-of(b))) {
                          set good = false;
                        };
                      };
                    };
                    when(good) {
                      unless(counted) {
                        phi-uses!(f, borrow(counts));
                        set counted = true;
                      };
                      for k in range(0, cir::i64-of(y.nops)) {
                        bind {
                          pred = cir::operand(f, cir::val(f, src), (y.nops + cir::u32-of(k)));
                          incoming = cir::operand(f, cir::val(f, src), cir::u32-of(k));
                          v = cir::push-value!(f, cop::OP-MEMCPY, cop::T-VOID, x.imm, 0);
                        } {
                          cir::push-operand!(f, dst, typed[u32](0));
                          cir::push-operand!(f, incoming, typed[u32](0));
                          cir::set-ops!(f, v, typed[u32](2), typed[u32](2));
                          push!(borrow(pending), pred);
                          push!(borrow(pending), v);
                        };
                      };
                      bind {
                        dead = cir::val(f, c);
                      } {
                        set dead.flags = (dead.flags | typed[u8](8));
                        set dead.nops = typed[u32](0);
                        set dead.ntotal = typed[u32](0);
                      };
                      when(((counts)[cir::i64-of(src)] == typed[u32](1))) {
                        push!(borrow(dead-phis), src);
                      };
                      set sunk = (sunk + 1);
                    };
                  };
                };
              };
            };
          };
        };
      };
    };
    when((sunk > 0)) {
      bind {
        var out = list[u32];
      } {
        for b in range(0, cir::i64-of(cir::block-count(f))) {
          bind {
            bb = cir::blk(f, cir::u32-of(b));
            lo = cir::i64-of(bb.ibegin);
            hi = cir::i64-of(bb.iend);
            term = bb.term;
          } {
            set bb.ibegin = cir::u32-of(len(out));
            for j in range(lo, hi) {
              bind {
                v = (f.insts)[j];
              } {
                when((v == term)) {
                  for k in range(0, (len(pending) / 2)) {
                    when(((pending)[(k * 2)] == cir::u32-of(b))) {
                      push!(borrow(out), (pending)[((k * 2) + 1)]);
                    };
                  };
                };
                push!(borrow(out), v);
              };
            };
            set bb.iend = cir::u32-of(len(out));
          };
        };
        clear!(borrow(f.insts));
        for v in out {
          push!(borrow(f.insts), v);
        };
        free!(borrow(out));
      };
      when((len(dead-phis) > 0)) {
        bind {
          var kept = list[u32];
        } {
          for b in range(0, cir::i64-of(cir::block-count(f))) {
            bind {
              bb = cir::blk(f, cir::u32-of(b));
              begin = cir::u32-of(len(kept));
            } {
              for j in range(cir::i64-of(bb.phi-begin), cir::i64-of((bb.phi-begin + bb.phi-count))) {
                bind {
                  phi = (f.phis)[j];
                  var drop = false;
                } {
                  for d in dead-phis {
                    when((d == phi)) {
                      set drop = true;
                    };
                  };
                  if(drop, bind {
                    x = cir::val(f, phi);
                  } {
                    set x.nops = typed[u32](0);
                    set x.ntotal = typed[u32](0);
                  }, push!(borrow(kept), phi));
                };
              };
              set bb.phi-begin = begin;
              set bb.phi-count = (cir::u32-of(len(kept)) - begin);
            };
          };
          clear!(borrow(f.phis));
          for v in kept {
            push!(borrow(f.phis), v);
          };
          free!(borrow(kept));
        };
      };
      cir::compact-dead!(f);
    };
    free!(borrow(pending));
    free!(borrow(dead-phis));
    free!(borrow(counts));
    sunk;
  };
}

# Forward aggregate copies until none applies (a few rounds at most).
fn forward-copies!(f: ref[cir::Func]) -> i64 {
  forward-copies-with!(f, as[ref[Summaries]](0));
}

fn forward-copies-with!(f: ref[cir::Func], sums: ref[Summaries]) -> i64 {
  bind {
    var modified = false;
    var st = state-new(f, sums);
    removed = forward-copies-in!(borrow(st), f, sums, borrow(modified));
  } {
    state-free!(borrow(st));
    removed;
  };
}

# forward-copies-with! using the analysis storage of ST (any state), also
# storing in MODIFIED whether F was changed at all. A rewrite that does not
# apply leaves F as it was, and a sunk copy counts as a change although it
# removes none.
fn forward-copies-in!(st: ref[State], f: ref[cir::Func], sums: ref[Summaries], modified: mut[bool]) -> i64 {
  set modified = false;
  bind {
    var copies = false;
  } {
    for i in range(0, len(f.insts)) {
      when((opcode(f, (f.insts)[i]) == cop::OP-MEMCPY)) {
        set copies = true;
      };
    };
    if((not(copies) or (len(f.allocas) == 0)), 0, bind {
      var removed = typed[i64](0);
      var round = 0;
      var changed = true;
    } {
      state-retarget!(st, f, sums);
      while((changed and (round < 4))) {
        set changed = false;
        when((sink-copies!(f) > 0)) {
          set changed = true;
        };
        analyze!(st);
        when((round == 0)) {
          dominators!(st);
        };
        bind {
          nb = cir::i64-of(cir::block-count(f));
          ni = len(f.insts);
        } {
          fill-u32!(borrow(st.mark-f), ni, typed[u32](0));
          fill-u32!(borrow(st.mark-b), ni, typed[u32](0));
          fill-u32!(borrow(st.enter-f), nb, typed[u32](0));
          fill-u32!(borrow(st.enter-b), nb, typed[u32](0));
          set st.stamp = typed[u32](0);
        };
        for i in range(0, len(f.insts)) {
          bind {
            c = (f.insts)[i];
          } {
            when(((opcode(f, c) == cop::OP-MEMCPY) and (((cir::val(f, c)).flags & typed[u8](8)) == typed[u8](0)))) {
              when((try-into-source!(st, c) or try-into-destination!(st, c))) {
                set changed = true;
                set removed = (removed + 1);
              };
            };
          };
        };
        when(changed) {
          set modified = true;
          hoist!(st);
          cir::compact-dead!(f);
          drop-slots!(st);
        };
        set round = (round + 1);
      };
      removed;
    });
  };
}

# ---- argument summaries ----
# One argument's local verdict (P-* bits from its own uses) and the callee
# arguments its address flows into.
fn local-argument!(f: ref[cir::Func], uses: ref[State], arg: u32, edges: mut[list[Edge]]) -> u8 {
  bind {
    var bits = typed[u8](3);
    var work = list[u32];
  } {
    push!(borrow(work), arg);
    while((len(work) > 0)) {
      bind {
        d = (work)[(len(work) - 1)];
      } {
        pop!(borrow(work));
        for u in range(cir::i64-of((uses.use-start)[cir::i64-of(d)]), cir::i64-of((uses.use-start)[(cir::i64-of(d) + 1)])) {
          bind {
            user = (uses.use-user)[u];
            k = (uses.use-index)[u];
            x = cir::val(f, user);
            op = as[i64](x.op);
          } {
            choose {
              ((uses.at)[cir::i64-of(user)] == none()) => set bits = typed[u8](0);
              ((op == cop::OP-ADDI) and (k == typed[u32](0))) => push!(borrow(work), user);
              ((op == cop::OP-LOAD) and (k == typed[u32](0)) and not(cir::volatile?(f, user))) => 0;
              ((op == cop::OP-MEMCPY) and (k == typed[u32](1))) => 0;
              (((op == cop::OP-STORE) and (k == typed[u32](0)) and not(cir::volatile?(f, user))) or ((op == cop::OP-MEMCPY) and (k == typed[u32](0))) or ((op == cop::OP-MEMZERO) and (k == typed[u32](0)))) => set bits = (bits & typed[u8](1));
              ((op == cop::OP-CALL) and (((f.argflags)[cir::i64-of((x.opb + k))] & (typed[u32](0x100) | as[u32](cir::AF-INDIRECT))) != typed[u32](0))) => set bits = (bits & typed[u8](1));
              ((op == cop::OP-CALL) and (x.imm >= 0)) => push!(borrow(edges), make Edge {
                symbol = x.imm;
                arg = k;
                operands = x.nops;
              });
              else => set bits = typed[u8](0);
            };
          };
        };
      };
    };
    free!(borrow(work));
    bits;
  };
}

# One function's contribution to the module's summaries: per argument its
# local verdict and the callee arguments it flows into. It depends on that
# function's CIR alone.
record Local {
  bits: list[u8];
  edge-count: list[u32];
  edges: list[Edge];
}

construct Local as local-new();

release Local as local-free!(local);

fn local-summarize!(st: ref[State], f: ref[cir::Func], local: ref[Local]) -> void {
  clear!(borrow(local.bits));
  clear!(borrow(local.edge-count));
  clear!(borrow(local.edges));
  bind {
    n = len(f.args);
  } {
    when((n > 0)) {
      state-retarget!(st, f, as[ref[Summaries]](0));
      analyze-uses!(st);
      for k in range(0, n) {
        bind {
          begin = len(local.edges);
          bits = local-argument!(f, st, (f.args)[k], borrow(local.edges));
        } {
          push!(borrow(local.bits), bits);
          push!(borrow(local.edge-count), cir::u32-of((len(local.edges) - begin)));
        };
      };
    };
  };
}

# Summaries for every function (function i defines `syms[i]` and contributes
# `locals[i]`): each argument's facts are its local verdict weakened by the
# facts of every callee argument it flows into, the greatest solution of
# that. Facts only ever lose bits, so a fact that changes is pushed once per
# change to the arguments that flow into it, until none does.
# An argument promises only the facts its local uses and all callee arguments
# promise. Unknown callees are the boundary fact 0. Intersection is monotone
# on these two bits, including recursive calls; the solver derives scheduling.
fn summarize-locals!(sums: ref[Summaries], locals: span[Local], syms: span[u32]) -> void {
  bind { var max = typed[i64](0); var start = list[u32]; var users = list[u32]; var cursor = list[u32]; } {
    for s in syms { when(cir::i64-of(s) >= max) { set max = cir::i64-of(s) + 1; }; };
    fill-u32!(borrow(sums.first), max, typed[u32](0));
    fill-u32!(borrow(sums.count), max, typed[u32](0));
    clear!(borrow(sums.flags));
    for i in range(0, len(locals)) {
      bind { local = locals[i]; symbol = cir::i64-of(syms[i]); n = len(local.bits); } {
        put(borrow(sums.first), symbol, cir::u32-of(len(sums.flags) + 1));
        put(borrow(sums.count), symbol, cir::u32-of(n));
        when(n > 0) { append-list(borrow(sums.flags), local.bits, n); };
      };
    };
    index-callees!(sums, locals, syms, borrow(start), borrow(users), borrow(cursor));
    solve-argument-facts!(sums, borrow(start), borrow(users));
    free!(borrow(start)); free!(borrow(users)); free!(borrow(cursor));
  };
}

relation index-callees!(sums: ref[Summaries], locals: span[Local], syms: span[u32], start: mut[list[u32]], users: mut[list[u32]], cursor: mut[list[u32]]) {
  keys = len(sums.flags) + 1;
  offsets = start;
  cursor = cursor;
  from i in range(0, len(locals));
  let local = locals[i];
  let base = cir::i64-of(sums.first[cir::i64-of(syms[i])]) - 1;
  segments k, e in local.edge-count;
  let target = local.edges[e];
  let to = summary-slot(sums, target.symbol, target.arg, target.operands);
  key = if(to < 0, len(sums.flags), to);
  column users = cir::u32-of(base + k);
}

meet solve-argument-facts!(sums: ref[Summaries], start: mut[list[u32]], users: mut[list[u32]]) {
  values = sums.flags;
  offsets = start;
  users = users;
  top = typed[u8](3);
  boundary = typed[u8](0);
}

# Whether every argument fact in `after` still holds what `before` promised.
fn summaries-hold?(before: ref[Summaries], after: ref[Summaries]) -> bool =
  len(before.flags) == len(after.flags) and
  (all i in range(0, len(before.flags)): (before.flags[i] & after.flags[i]) == before.flags[i]);

# Report each argument whose fact `after` no longer holds.
fn report-weakened!(funcs: span[ref[cir::Func]], syms: span[u32], before: ref[Summaries], after: ref[Summaries]) -> void {
  for i in range(0, len(funcs)) {
    bind {
      symbol = cir::i64-of((syms)[i]);
      first = cir::i64-of(((before.first)[symbol] - typed[u32](1)));
    } {
      for k in range(0, cir::i64-of((before.count)[symbol])) {
        bind {
          b = (before.flags)[(first + k)];
          a = (after.flags)[(first + k)];
        } {
          unless(((b & a) == b)) {
            eprintln("copy forwarding: {} argument {}: {} became {}", (read((funcs)[i])).name, k, b, a);
          };
        };
      };
    };
  };
}

# Module-wide forwarding in two rounds. Each round forwards every function's
# copies with argument summaries of the module as it stands, then summarizes
# again: rewrites may only strengthen facts (copies sunk out of PHIs remove
# uses that looked retaining), and a weakened fact is reported as an error.
#
# The work is three phases of per-function steps, each followed by a join:
#
# phase 0  step: the function's local summary       join: summaries
# phase 1  step: forward with them, local summary   join: summaries, check
# phase 2  step: forward with those, local summary  join: summaries, check
#
# A step (module-forward-step!) reads the summaries of the last join and
# reads and writes only its own function and that function's entries here,
# so the steps of one phase may run in any order or at the same time; a
# join (module-forward-join!) runs alone. What a step computes is a function
# of its function's CIR and the summaries, so two cases are answered without
# recomputing: a function the last forwarding left unchanged keeps its local
# summary, and in phase 2 a function that phase 1 left unchanged, none of
# whose direct callees' facts changed in between, is not forwarded again
# (it would be the same computation that found nothing to do).
record ModuleForward {
  funcs: span[ref[cir::Func]] = funcs;
  syms: span[u32] = syms;
  locals: list[Local] = tabulate[Local](len(funcs), i: local-new()) drop-each local-free!;
  modified: list[bool] = repeat[bool](len(funcs), false);
  current: Summaries = summaries-new() drop summaries-free!;
  next: Summaries = summaries-new() drop summaries-free!;
  strengthened: list[bool];
  any-strengthened: bool;
}
construct ModuleForward as module-forward-new(funcs: span[ref[cir::Func]], syms: span[u32]);
release ModuleForward as module-forward-free!(m);

const MODULE-FORWARD-PHASES = 3;

# Whether F calls a function one of whose facts changed at the last join.
fn calls-strengthened?(m: ref[ModuleForward], f: ref[cir::Func]) -> bool =
  m.any-strengthened and (any v in f.insts:
    let x = cir::val(f, v) in as[i64](x.op) == cop::OP-CALL and x.imm >= 0
      and x.imm < len(m.strengthened) and m.strengthened[x.imm]);

# SCRATCH is analysis storage of the calling thread module-forward-scratch.
fn module-forward-step!(m: ref[ModuleForward], scratch: ref[State], phase: i64, i: i64) -> void {
  bind {
    f = (m.funcs)[i];
    local = element(borrow(m.locals), i);
  } {
    if((phase == 0), local-summarize!(scratch, f, local), when(((phase == 1) or (m.modified)[i] or calls-strengthened?(m, f))) {
      bind {
        var modified = false;
      } {
        forward-copies-in!(scratch, f, address(m, current), borrow(modified));
        put(borrow(m.modified), i, modified);
        when(modified) {
          local-summarize!(scratch, f, local);
        };
      };
    });
  };
}

fn module-forward-scratch() -> State {
  state-new(as[ref[cir::Func]](0), as[ref[Summaries]](0));
}

fn module-forward-scratch-free!(scratch: ref[State]) -> void {
  state-free!(scratch);
}

# Close PHASE after every function's step of it: the summaries of the module
# as it now stands become current. False when a fact was weakened reported.
fn module-forward-join!(m: ref[ModuleForward], phase: i64) -> bool {
  summarize-locals!(address(m, next), span-of(m.locals), m.syms);
  bind {
    var ok = true;
  } {
    when((phase > 0)) {
      unless(summaries-hold?(address(m, current), address(m, next))) {
        report-weakened!(m.funcs, m.syms, address(m, current), address(m, next));
        set ok = false;
      };
      when(ok) {
        fill-bool!(borrow(m.strengthened), len((m.next).first), false);
        set m.any-strengthened = false;
        for symbol in range(0, len((m.next).first)) {
          bind {
            first = ((m.next).first)[symbol];
          } {
            when((first != typed[u32](0))) {
              for k in range(0, cir::i64-of(((m.next).count)[symbol])) {
                bind {
                  slot = ((cir::i64-of(first) - 1) + k);
                } {
                  when((((m.next).flags)[slot] != ((m.current).flags)[slot])) {
                    put(borrow(m.strengthened), symbol, true);
                    set m.any-strengthened = true;
                  };
                };
              };
            };
          };
        };
      };
    };
    bind {
      previous = m.current;
    } {
      set m.current = m.next;
      set m.next = previous;
    };
    ok;
  };
}

fn forward-module!(funcs: span[ref[cir::Func]], syms: span[u32]) -> bool {
  bind {
    var m = module-forward-new(funcs, syms);
    var scratch = module-forward-scratch();
    var ok = true;
  } {
    for phase in range(0, MODULE-FORWARD-PHASES) {
      when(ok) {
        for i in range(0, len(funcs)) {
          module-forward-step!(borrow(m), borrow(scratch), phase, i);
        };
        set ok = module-forward-join!(borrow(m), phase);
      };
    };
    module-forward-scratch-free!(borrow(scratch));
    module-forward-free!(borrow(m));
    ok;
  };
}
