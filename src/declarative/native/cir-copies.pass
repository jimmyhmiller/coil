# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# Aggregate copy forwarding over CIR: facts about where addresses point and
# what touches them, the rewrites those facts allow, and argument summaries.

library declarative

use "native.cir" as cir;

use "native.cir-ops" as cop;

# What one use of a slot's address does with it.
const K-ESCAPE = 0;

const K-READ = 1;

const K-WRITE = 2;

const K-SRET = 3;

const K-CALL = 4;

const K-ARG = 5;

const K-DERIVE = 6;

record Access {
  inst: u32;
  kind: i64;
  lo: i64;
  hi: i64;
}

# What the uses of an argument leave true of it.
const P-NOCAPTURE = 1;

const P-READONLY = 2;

fn promise(bits: i64) -> u8 = as[u8](bits);

record Edge {
  symbol: i64;
  arg: u32;
  operands: u32;
}

# Facts of every argument of the module's functions, one slot each: symbol s's
# arguments are slots first[s] - 1 .. + count[s] (first 0: unknown). `flags`
# holds each slot's local verdict, `promised` what holds once callees weigh in.
record Summaries {
  first: list[u32];
  count: list[u32];
  flags: list[u8];
  callers: Callers = Callers-new() drop Callers-free!;
  promised: Promised = Promised-new() drop Promised-free!;
}

construct Summaries as summaries-new();

release Summaries as summaries-free!(sums);

# The slot of `symbol`'s argument `arg` when called with `operands`
# operands, or -1 when nothing is known of such a call.
fn summary-slot(sums: ref[Summaries], symbol: i64, arg: u32, operands: u32) -> i64 = if(((symbol < 0) or (symbol >= len(sums.first)) or ((sums.first)[symbol] == typed[u32](0)) or ((sums.count)[symbol] != operands) or (arg >= operands)), -1, cir::i64-of((((sums.first)[symbol] - typed[u32](1)) + arg)));

# Flags of `symbol`'s argument `arg` when called with `operands` operands.
fn summary(sums: ref[Summaries], symbol: i64, arg: u32, operands: u32) -> u8 =
  let slot = summary-slot(sums, symbol, arg, operands) in
    if(slot < 0, typed[u8](0), promises(sums, cir::u32-of(slot)));

record Use { user: u32; index: u32; }

record Address { root: u32; off: i64; }

record State {
  f: ref[cir::Func] = f;
  sums: ref[Summaries] = sums;
  uses: Uses = Uses-new() drop Uses-free!;
  memory: Memory = Memory-new() drop Memory-free!;
  arguments: Arguments = Arguments-new() drop Arguments-free!;
  flow: Flow = Flow-new() drop Flow-free!;
  work-writes: list[u32];
  touched: list[bool];
  dead-slot: list[bool];
  removed: i64;
  modified: bool;
  changed: bool;
  # edits
  edits: Edits = Edits-new() drop Edits-free!;
  hoist: list[u32];
  sinks: list[Sunk];
  sunk-phis: list[u32];
  phi-uses: list[u32];
  out: list[u32];
  kept: list[u32];
}

fn none() -> u32 = cir::none();

fn opcode(f: ref[cir::Func], v: u32) -> i64 = as[i64]((cir::val(f, v)).op);

construct State as state-new(f: ref[cir::Func], sums: ref[Summaries]);

# Turn ST to another function. Every analysis fills what it reads from the
# function at hand, so a state serves any number of functions in turn.
scatter retarget-fields!(st: ref[State], f: ref[cir::Func], sums: ref[Summaries]) {
  field st.f = f;
  field st.sums = sums;
  field st.removed = 0;
  field st.modified = false;
  field st.changed = true;
}
pipeline state-retarget!(st: ref[State], f: ref[cir::Func], sums: ref[Summaries]) {
  run retarget-fields!(st, f, sums);
  run clear-edits!(st);
}

release State as state-free!(st);

# ---- CFG ----
fn successor-count(f: ref[cir::Func], b: u32) -> u32 =
  let term = (cir::blk(f, b)).term in
    if(term == none(), typed[u32](0),
       let x = cir::val(f, term) in x.ntotal - x.nops);

fn successor(f: ref[cir::Func], b: u32, i: u32) -> u32 =
  let x = cir::val(f, (cir::blk(f, b)).term) in cir::operand(f, x, x.nops + i);

# The function's control flow: its blocks' runs of positions and their edges.
graph Flow(st: ref[State]) in flow {
  blocks = cir::block-count(st.f);
  points = len(st.f.insts);
  entry = typed[u32](0);
  begin = (cir::blk(st.f, b)).ibegin;
  end = (cir::blk(st.f, b)).iend;
  successor-count = successor-count(st.f, b);
  successor = successor(st.f, b, k);
  predecessors {
    chain e from (cir::blk(st.f, b)).pred-first until none() next st.f.edges[cir::i64-of(e)].next;
    yield = st.f.edges[cir::i64-of(e)].from;
  }
}

# ---- facts ----
fn each-user(f: ref[cir::Func], i: i64) -> u32 = if((i < len(f.insts)), (f.insts)[i], (f.phis)[(i - len(f.insts))]);

# Where each instruction is, and which instructions use each value.
facts Uses(st: ref[State]) in uses {
  one position(value: u32) -> u32 over len(st.f.values) absent none();
  many users(value: u32) -> Use over len(st.f.values);
  rule position(st.f.insts[j]) = cir::u32-of(j)
    if from b in range(0, cir::i64-of(cir::block-count(st.f))), let bb = cir::blk(st.f, cir::u32-of(b)),
       from j in range(cir::i64-of(bb.ibegin), cir::i64-of(bb.iend));
  rule users(cir::operand(st.f, x, cir::u32-of(k))) = make Use { user = user; index = cir::u32-of(k); }
    if from i in range(0, len(st.f.insts) + len(st.f.phis)), let user = each-user(st.f, i),
       let x = cir::val(st.f, user), from k in range(0, cir::i64-of(x.nops));
}

# Where every address points: a slot (an alloca or an sret argument) and an
# offset into it, through ADDIs; and what every other use does with it.
facts Memory(st: ref[State]) in memory {
  one addr(value: u32) -> Address over len(st.f.values) absent make Address { root = none(); off = 0; };
  many touches(root: u32) -> Access over len(st.f.values);
  flag escaped?(root: u32) over len(st.f.values);
  flag opaque?(root: u32) over len(st.f.values);
  flag sret?(root: u32) over len(st.f.values);
  rule addr(a) = make Address { root = a; off = 0; } if from a in st.f.allocas;
  rule addr(a) = make Address { root = a; off = 0; }, sret?(a)
    if from i in range(0, len(st.f.args)), where st.f.arg-sret[i], let a = st.f.args[i];
  rule addr(u.user) = make Address { root = a.root; off = t.lo; } when t.kind == K-DERIVE,
       touches(a.root) = t when t.kind != K-DERIVE and t.kind != K-ESCAPE,
       opaque?(a.root) when t.kind == K-CALL,
       escaped?(a.root) when t.kind == K-ESCAPE
    if with addr(d) = a, from u in users(st, d), let t = address-use(st, u, a.off);
}

fn call-access-kind(st: ref[State], x: ref[cir::Value], k: u32) -> i64 =
  let flags = st.f.argflags[cir::i64-of(x.opb + k)],
      known = if(as[u64](st.sums) == 0, typed[u8](0), summary(st.sums, x.imm, k, x.nops)),
      both = promise(P-NOCAPTURE | P-READONLY) in
    choose {
      (known & both) != typed[u8](0) and (flags & as[u32](cir::AF-SRET)) == typed[u32](0) =>
        if((known & both) == both, K-READ, K-ARG);
      (flags & as[u32](cir::AF-SRET)) != typed[u32](0) and x.aux == typed[u8](0) and x.ty == as[u8](cop::T-VOID) => K-SRET;
      (flags & as[u32](cir::AF-INDIRECT)) != typed[u32](0) => K-ARG;
      else => K-CALL;
    };

# What an operation does with operand k, read off CIR's operation meanings.
fn effect(x: ref[cir::Value], k: u32) -> cop::MemoryEffect = cop::memory-effect(as[i64](x.op), cir::i64-of(k), x.imm, x.imm2, as[i64](x.aux));

# What use `u` of an address `off` bytes into its slot does: derives another
# address, reads or writes bytes lo..hi of the slot, passes it to a call, or
# lets it escape. A volatile access lets it escape.
fn address-use(st: ref[State], u: Use, off: i64) -> Access =
  let x = cir::val(st.f, u.user), e = effect(x, u.index),
      access = (e.kind == cop::E-READ or e.kind == cop::E-WRITE) and not(cir::volatile?(st.f, u.user)),
      kind = choose {
        position(st, u.user) == none() => K-ESCAPE;
        e.kind == cop::E-DERIVE => K-DERIVE;
        access => if(e.kind == cop::E-READ, K-READ, K-WRITE);
        as[i64](x.op) == cop::OP-CALL => call-access-kind(st, x, u.index);
        else => K-ESCAPE;
      },
      lo = off + e.offset in make Access { inst = u.user; kind = kind; lo = lo; hi = lo + if(access, e.bytes, 0x40000000); };

pipeline analyze!(st: ref[State]) {
  run Uses-derive!(st);
  run flow-derive!(st);
  run Memory-derive!(st);
  run fill!(borrow(st.touched), len(st.f.values), false);
  run fill!(borrow(st.dead-slot), len(st.f.values), false);
}

# A slot nothing outside the function can reach or change.
fn private?(st: ref[State], r: u32) -> bool = r != none() and not(escaped?(st, r)) and not(opaque?(st, r)) and not(st.touched[cir::i64-of(r)]);

fn alloca?(st: ref[State], r: u32) -> bool = (opcode(st.f, r) == cop::OP-ALLOCA);

# An alloca whose every access is one of `touches`.
fn enumerable?(st: ref[State], r: u32) -> bool = r != none() and not(escaped?(st, r)) and not(opaque?(st, r));

fn at(st: ref[State], a: Access) -> u32 = position(st, a.inst);

# An instruction that may write memory other than a private slot's.
fn foreign-write?(st: ref[State], p: u32) -> bool =
  let f = st.f, x = cir::val(f, f.insts[cir::i64-of(p)]) in
    cop::clobbers?(as[i64](x.op)) or (any k in range(0, cir::i64-of(x.nops)):
      effect(x, cir::u32-of(k)).kind == cop::E-WRITE
        and (let r = addr(st, cir::operand(f, x, cir::u32-of(k))).root in not(enumerable?(st, r) and alloca?(st, r))));

# Every derived ADDI of root r, and every access, is dominated by position p.
fn uses-dominated?(st: ref[State], r: u32, p: u32) -> bool =
  (all a in touches(st, r): flow-dominates?(st, p, at(st, a))) and derived-dominated?(st, r, p);

fn derived-dominated?(st: ref[State], r: u32, p: u32) -> bool =
  all u in users(st, r): effect(cir::val(st.f, u.user), u.index).kind != cop::E-DERIVE or flow-dominates?(st, p, position(st, u.user));

# ---- the rewrites ----
# Forward or move: the copy's destination slot becomes its source.
rewrite try-into-source!(st: ref[State], c: u32) {
  let f = st.f;
  let x = cir::val(f, c);
  let n = x.imm;
  let pc = position(st, c);
  let dst = cir::operand(f, x, typed[u32](0));
  let src = cir::operand(f, x, typed[u32](1));
  let d = addr(st, dst).root;
  let source = addr(st, src);
  let s = source.root;
  let soff = source.off;
  require d != none() and alloca?(st, d) and dst == d and not(escaped?(st, d))
    and not(st.touched[cir::i64-of(d)]) and (cir::val(f, d)).imm == n and s != d;
  let td = touches(st, d);
  require all a in td: if(a.inst == c, a.kind == K-WRITE, flow-dominates?(st, pc, at(st, a)));
  require hoistable?(f, src) or derived-dominated?(st, d, pc);
  require s == none() or not(st.touched[cir::i64-of(s)]);
  let written = any a in td: a.inst != c and a.kind != K-READ;
  require if(written, move-safe?(st, c, d, s, soff, n), forward-safe?(st, c, d, s, soff, n));
  apply hoist-chain!(st, src) when not(cir-value?(f, src)) and hoistable?(f, src);
  apply replace-root!(st, d, src, c, s);
}

# An ADDI chain ending at an alloca or argument computes the same address
# anywhere, so it may move to the entry block.
follow hoistable?(f: ref[cir::Func], v: u32) -> bool {
  start = v; view = cir::val(f, node);
  stop = as[i64](item.op) != cop::OP-ADDI;
  next = cir::operand(f, item, typed[u32](0));
  result = as[i64](item.op) == cop::OP-ALLOCA or as[i64](item.op) == cop::OP-ARG;
}

insert append-hoisted!(st: ref[State], value: u32) -> void inline { column st.hoist = value; }
sweep hoist-chain!(st: ref[State], v: u32) {
  rows {
    chain x from v until none() next if(opcode(st.f, x) == cop::OP-ADDI, cir::operand(st.f, cir::val(st.f, x), typed[u32](0)), none());
    where opcode(st.f, x) == cop::OP-ADDI;
    yield = x;
  }
  apply = append-hoisted!(st, row);
}

# Constant-free values usable anywhere: allocas and arguments.
fn cir-value?(f: ref[cir::Func], v: u32) -> bool =
  let op = opcode(f, v) in op == cop::OP-ALLOCA or op == cop::OP-ARG;

# Whether access `a` is after the copy, where the forward region (from the
# copy) marked it; the copy's own access does not count.
fn after?(st: ref[State], c: u32, a: Access) -> bool = a.inst != c and flow-after?(st, at(st, a));

predicate move-safe?(st: ref[State], c: u32, d: u32, s: u32, soff: i64, n: i64) {
  let f = st.f;
  require s != none() and alloca?(st, s) and private?(st, s)
    and soff + n <= (cir::val(f, s)).imm
    and (cir::val(f, s)).imm2 >= (cir::val(f, d)).imm2
    and soff % (cir::val(f, d)).imm2 == 0;
  reach flow-after! from { yield = position(st, c); } until none();
  ensure all a in touches(st, s): not(after?(st, c, a));
}

predicate forward-safe?(st: ref[State], c: u32, d: u32, s: u32, soff: i64, n: i64) {
  let f = st.f;
  let pc = position(st, c);
  let enumerable = enumerable?(st, s);
  let td = touches(st, d);
  reach flow-after! from { yield = pc; } until pc;
  reach flow-before! from { from a in td; where a.inst != c; yield = at(st, a); } until pc;
  ensure if(enumerable,
    all a in touches(st, s):
      let p = at(st, a) in
        a.inst == c or a.kind == K-READ or a.lo >= soff + n or a.hi <= soff
        or not((flow-after?(st, p) and flow-before?(st, p)) or touches?(st, a.inst, d)),
    (all p in flow-reached(st): not(flow-before?(st, p) and foreign-write?(st, p)))
      and (all a in td: a.inst == c or not(foreign-write?(st, at(st, a)))));
  ensure all a in td:
    a.inst == c or opcode(f, a.inst) != cop::OP-MEMCPY or copy-target-safe?(st, a, s, soff, enumerable);
}

fn copy-target-safe?(st: ref[State], a: Access, s: u32, soff: i64, enumerable: bool) -> bool =
  let y = cir::val(st.f, a.inst), target = addr(st, cir::operand(st.f, y, typed[u32](0))), t = target.root in
    (enumerable?(st, t) and alloca?(st, t) and t != s)
    or (t != none() and t == s and enumerable and
      (let to = target.off, from = soff + a.lo in to + y.imm <= from or from + y.imm <= to));

# Whether instruction v also accesses root r (through any operand).
fn touches?(st: ref[State], v: u32, r: u32) -> bool = any a in touches(st, r): a.inst == v;

# Call slot: the copy's private source slot becomes the destination.
rewrite try-into-destination!(st: ref[State], c: u32) {
  let f = st.f;
  let x = cir::val(f, c);
  let n = x.imm;
  let pc = position(st, c);
  let dst = cir::operand(f, x, typed[u32](0));
  let src = cir::operand(f, x, typed[u32](1));
  let s = addr(st, src).root;
  let target = addr(st, dst);
  let d = target.root;
  let doff = target.off;
  require s != none() and alloca?(st, s) and src == s;
  let ts = touches(st, s);
  require private?(st, s) and (cir::val(f, s)).imm == n and len(ts) > 1 and d != none() and d != s and private?(st, d)
    and ((alloca?(st, d) and doff + n <= (cir::val(f, d)).imm
      and (cir::val(f, d)).imm2 >= (cir::val(f, s)).imm2 and doff % (cir::val(f, s)).imm2 == 0)
      or sret?(st, d));
  require hoistable?(f, dst) or uses-dominated?(st, s, position(st, dst));
  reach flow-after! from { yield = pc; } until none();
  ensure all a in ts: not(after?(st, c, a)) and (a.inst == c or not(touches?(st, a.inst, d)));
  reach flow-after! from { from a in ts; where a.inst != c; yield = at(st, a); } until pc;
  let td = touches(st, d);
  ensure all a in td: not(after?(st, c, a)) or a.kind == K-WRITE or a.kind == K-SRET;
  derive st.work-writes from { from a in td; where after?(st, c, a); yield = at(st, a); };
  ensure all write in st.work-writes: write-before-source-safe?(st, write, s);
  apply hoist-chain!(st, dst) when not(cir-value?(f, dst)) and hoistable?(f, dst);
  apply replace-root!(st, s, dst, c, d);
}

predicate write-before-source-safe?(st: ref[State], write: u32, s: u32) {
  reach flow-after! from { yield = write; } until none();
  ensure all a in touches(st, s): not(flow-after?(st, at(st, a)));
}

# Every operand naming slot `old` names `new` instead; the copy is dead.
scatter redirect-root-uses!(st: ref[State], old: u32, new: u32) {
  from u in users(st, old);
  let x = cir::val(st.f, u.user);
  write st.f.operands at cir::i64-of(x.opb + u.index) = new;
}
scatter retire-slot!(st: ref[State], old: u32) {
  write st.touched at cir::i64-of(old) = true;
  write st.dead-slot at cir::i64-of(old) = true;
}
scatter touch-root!(st: ref[State], root: u32) {
  where root != none();
  write st.touched at cir::i64-of(root) = true;
}
rewrite replace-root!(st: ref[State], old: u32, new: u32, c: u32, other: u32) {
  apply redirect-root-uses!(st, old, new);
  apply retire!(st.f, c);
  apply retire-slot!(st, old);
  apply touch-root!(st, other);
  apply touch-root!(st, addr(st, new).root);
}

retain drop-slots!(st: ref[State]) {
  data = st.f.allocas;
  keep = not(st.dead-slot[cir::i64-of(v)]);
  configure = cir::number-alloca!(st.f, v, index);
}

# ---- edits ----
# Rewrites record where instructions go; `relayout!` then rebuilds every
# block's list once. The hoisted ADDIs open the entry block, each where it was
# last hoisted, latest first (outermost last); each sunk copy goes in front of
# the instruction it was sunk before. Retired instructions leave with
# compact-dead!.
record Sunk { before: u32; value: u32; }

facts Edits(st: ref[State]) in edits {
  many sunk(before: u32) -> u32 over len(st.f.values);
  fold hoisted(value: u32) -> i64 over len(st.f.values) from -1 by max;
  rule sunk(s.before) = s.value if from s in st.sinks;
  rule hoisted(st.hoist[i]) = i if from i in range(0, len(st.hoist));
}

scatter configure-block!(st: ref[State], b: u32, begin: u32, count: u32) inline {
  let bb = cir::blk(st.f, b);
  field bb.ibegin = begin;
  field bb.iend = begin + count;
}
materialize lay-out!(st: ref[State]) {
  target = st.out;
  groups { from b in range(0, cir::i64-of(cir::block-count(st.f))); yield = cir::u32-of(b); }
  rows {
    let bb = cir::blk(st.f, group);
    from j in range(if(group == typed[u32](0), -len(st.hoist), 0), cir::i64-of(bb.iend - bb.ibegin));
    let i = if(j < 0, -j - 1, cir::i64-of(bb.ibegin) + j);
    let v = if(j < 0, st.hoist[i], st.f.insts[i]);
    let before = if(j < 0, 0, len(sunk(st, v)));
    from k in range(0, before + 1);
    where k < before or hoisted(st, v) == if(j < 0, i, -1);
    yield = if(k < before, sunk(st, v)[k], v);
  }
  order = forward;
  configure = configure-block!(st, group, begin, count);
}
scatter publish-layout!(st: ref[State]) {
  let old = st.f.insts;
  field st.f.insts = st.out;
  field st.out = old;
}
pipeline clear-edits!(st: ref[State]) {
  run clear!(borrow(st.hoist));
  run clear!(borrow(st.sinks));
}
rewrite relayout!(st: ref[State]) -> void {
  require len(st.hoist) + len(st.sinks) > 0;
  apply Edits-derive!(st);
  apply lay-out!(st);
  apply publish-layout!(st);
  apply clear-edits!(st);
}
scatter retire!(f: ref[cir::Func], v: u32) inline {
  let dead = cir::val(f, v);
  field dead.flags = dead.flags | typed[u8](8);
  field dead.nops = typed[u32](0);
  field dead.ntotal = typed[u32](0);
}

# ---- sinking copies out of PHIs ----
# Whether block b ends in an unconditional branch to `target`.
fn branches-to?(f: ref[cir::Func], b: u32, target: u32) -> bool =
  let term = (cir::blk(f, b)).term in term != none() and opcode(f, term) == cop::OP-BR and successor(f, b, typed[u32](0)) == target;

# MEMCPY(dst <- PHI) as the first instruction of the PHI's block becomes one
# copy before each predecessor's branch. dst must be an alloca or argument.
rewrite sink-copy!(st: ref[State], b: u32) {
  let f = st.f;
  let bb = cir::blk(f, b);
  require bb.ibegin < bb.iend;
  let c = f.insts[cir::i64-of(bb.ibegin)];
  let x = cir::val(f, c);
  require as[i64](x.op) == cop::OP-MEMCPY and (x.flags & typed[u8](8)) == typed[u8](0);
  let dst = cir::operand(f, x, typed[u32](0));
  require cir-value?(f, dst);
  let src = cir::operand(f, x, typed[u32](1));
  let y = cir::val(f, src);
  require as[i64](y.op) == cop::OP-PHI and y.block == b and src != dst;
  require all k in range(0, cir::i64-of(y.nops)):
    branches-to?(f, cir::operand(f, y, y.nops + cir::u32-of(k)), b);
  apply sink-into-predecessors!(st, dst, src, x.imm);
  apply retire!(f, c);
  apply note-sunk-phi!(st, src);
}
sweep sink-into-predecessors!(st: ref[State], dst: u32, phi: u32, size: i64) {
  rows { from k in range(0, cir::i64-of((cir::val(st.f, phi)).nops)); yield = cir::u32-of(k); }
  apply = sink-into-predecessor!(st, dst, phi, size, row);
}
rewrite sink-into-predecessor!(st: ref[State], dst: u32, phi: u32, size: i64, k: u32) -> void {
  let f = st.f;
  let y = cir::val(f, phi);
  let incoming = cir::operand(f, y, k);
  let branch = (cir::blk(f, cir::operand(f, y, y.nops + k))).term;
  create v = cir::push-value!(f, cop::OP-MEMCPY, cop::T-VOID, size, 0);
  apply cir::push-operand!(f, dst, typed[u32](0));
  apply cir::push-operand!(f, incoming, typed[u32](0));
  apply cir::set-ops!(f, v, typed[u32](2), typed[u32](2));
  apply append-sink!(st, make Sunk { before = branch; value = v; });
}
insert append-sink!(st: ref[State], s: Sunk) -> void inline { column st.sinks = s; }
insert note-sunk-phi!(st: ref[State], phi: u32) -> void inline { column st.sunk-phis = phi; }
count-rewrites sink-copies!(st: ref[State]) {
  rows { from b in range(0, cir::i64-of(cir::block-count(st.f))); yield = cir::u32-of(b); }
  apply = sink-copy!(st, row);
  changed = result;
}

# Uses of every PHI by instructions and other PHIs.
tally phi-uses!(f: ref[cir::Func], counts: mut[list[u32]]) {
  count = len(f.values);
  output = counts;
  rows {
    from i in range(0, len(f.insts) + len(f.phis));
    let x = cir::val(f, each-user(f, i));
    from k in range(0, cir::i64-of(x.nops));
    let operand = cir::operand(f, x, cir::u32-of(k));
    where opcode(f, operand) == cop::OP-PHI;
    yield = operand;
  }
}
# A PHI whose one use was a copy sunk out of it goes with it.
scatter retire-sunk-phis!(st: ref[State]) {
  from p in st.sunk-phis;
  where st.phi-uses[cir::i64-of(p)] == typed[u32](0);
  let x = cir::val(st.f, p);
  field x.flags = x.flags | typed[u8](8);
  field x.nops = typed[u32](0);
  field x.ntotal = typed[u32](0);
}
compact compact-phis!(st: ref[State]) {
  input = st.f.phis; output = st.kept;
  groups { from b in range(0, cir::i64-of(cir::block-count(st.f))); yield = cir::u32-of(b); }
  begin = (cir::blk(st.f, group)).phi-begin;
  end = (cir::blk(st.f, group)).phi-begin + (cir::blk(st.f, group)).phi-count;
  view = v; keep = ((cir::val(st.f, v)).flags & typed[u8](8)) == typed[u8](0);
  configure = cir::configure-phi-range!(st.f, group, begin, end - begin);
}
rewrite finish-sinking!(st: ref[State], sunk: i64) -> void {
  require sunk > 0;
  apply relayout!(st);
  apply phi-uses!(st.f, borrow(st.phi-uses));
  apply retire-sunk-phis!(st);
  apply compact-phis!(st);
  apply cir::compact-dead!(st.f);
  apply clear!(borrow(st.sunk-phis));
}

# ---- rounds ----
# Forward aggregate copies until none applies (a few rounds at most).
fn forward-copies!(f: ref[cir::Func]) -> i64 = forward-copies-with!(f, as[ref[Summaries]](0));

rewrite forward-copies-with!(f: ref[cir::Func], sums: ref[Summaries]) -> i64 {
  resource st = state-new(f, sums) release state-free!(borrow(st));
  apply forward-copies-in!(borrow(st), f, sums);
  result = st.removed;
}

# Forward F's copies with the analysis storage of ST (any state), leaving in
# ST how many it removed and whether F changed at all: a sunk copy is a
# change although it removes none.
rewrite forward-copies-in!(st: ref[State], f: ref[cir::Func], sums: ref[Summaries]) -> void {
  apply state-retarget!(st, f, sums);
  apply forward-rounds!(st) when len(f.allocas) != 0 and (any c in f.insts: opcode(f, c) == cop::OP-MEMCPY);
}
sweep forward-rounds!(st: ref[State]) {
  rows { from round in range(0, 4); where st.changed; yield = round; }
  apply = forward-round!(st, row);
}
rewrite forward-round!(st: ref[State], round: i64) -> void {
  create sunk = sink-copies!(st);
  apply finish-sinking!(st, sunk);
  apply analyze!(st);
  apply flow-dominators!(st) when round == 0;
  create removed = forward-round-copies!(st);
  apply record-round!(st, sunk + removed, removed);
  apply finish-round!(st) when st.changed;
}
rewrite forward-one-copy!(st: ref[State], c: u32) {
  require opcode(st.f, c) == cop::OP-MEMCPY and ((cir::val(st.f, c)).flags & typed[u8](8)) == typed[u8](0);
  create changed = try-into-source!(st, c) or try-into-destination!(st, c);
  result = changed;
}
count-rewrites forward-round-copies!(st: ref[State]) {
  rows { from c in st.f.insts; yield = c; }
  apply = forward-one-copy!(st, row);
  changed = result;
}
scatter record-round!(st: ref[State], changes: i64, removed: i64) inline {
  field st.changed = changes > 0;
  field st.removed = st.removed + removed;
  field st.modified = st.modified or changes > 0;
}
pipeline finish-round!(st: ref[State]) {
  run relayout!(st);
  run cir::compact-dead!(st.f);
  run drop-slots!(st);
}

# ---- argument summaries ----
# Which argument (by index) each address is derived from; what its uses leave
# true of that argument (P-* bits); and the callee arguments it flows into.
facts Arguments(st: ref[State]) in arguments {
  one origin(value: u32) -> u32 over len(st.f.values) absent none();
  fold verdict(argument: u32) -> u8 over len(st.f.args) from promise(P-NOCAPTURE | P-READONLY) by &;
  many flows(argument: u32) -> Edge over len(st.f.args);
  rule origin(st.f.args[i]) = cir::u32-of(i) if from i in range(0, len(st.f.args));
  rule verdict(arg) = argument-use-bits(st, u),
       origin(u.user) = arg when placed?(st, u.user) and effect(x, u.index).kind == cop::E-DERIVE,
       flows(arg) = make Edge { symbol = x.imm; arg = u.index; operands = x.nops; }
         when placed?(st, u.user) and as[i64](x.op) == cop::OP-CALL and x.imm >= 0 and not(by-reference?(st, x, u.index))
    if with origin(d) = arg, from u in users(st, d), let x = cir::val(st.f, u.user);
}

fn placed?(st: ref[State], v: u32) -> bool = position(st, v) != none();

# A call argument passed as sret or indirectly: the callee may write it.
fn by-reference?(st: ref[State], x: ref[cir::Value], k: u32) -> bool =
  (st.f.argflags[cir::i64-of(x.opb + k)] & (as[u32](cir::AF-SRET) | as[u32](cir::AF-INDIRECT))) != typed[u32](0);

fn argument-use-bits(st: ref[State], u: Use) -> u8 =
  let x = cir::val(st.f, u.user), e = effect(x, u.index).kind, op = as[i64](x.op),
      plain = not(cir::volatile?(st.f, u.user)) in choose {
    not(placed?(st, u.user)) => typed[u8](0);
    e == cop::E-DERIVE or (e == cop::E-READ and plain) => promise(P-NOCAPTURE | P-READONLY);
    (e == cop::E-WRITE and plain) or (op == cop::OP-CALL and by-reference?(st, x, u.index)) => promise(P-NOCAPTURE);
    op == cop::OP-CALL and x.imm >= 0 => promise(P-NOCAPTURE | P-READONLY);
    else => typed[u8](0);
  };

# One function's contribution to the module's summaries: per argument its
# local verdict and the callee arguments it flows into. It depends on that
# function's CIR alone.
record Local {
  bits: list[u8];
  edge-count: list[u32];
  edges: list[Edge];
}

construct Local as local-new();

release Local as local-free!(local);

fn clear-local-bits!(local: ref[Local]) -> void = clear!(borrow(local.bits));
fn clear-local-counts!(local: ref[Local]) -> void = clear!(borrow(local.edge-count));
fn clear-local-edges!(local: ref[Local]) -> void = clear!(borrow(local.edges));
insert append-local-argument!(local: ref[Local], bits: u8, count: u32) -> void inline {
  column local.bits = bits;
  column local.edge-count = count;
}
fn append-flows!(local: ref[Local], edges: span[Edge]) -> void = extend!(borrow(local.edges), data(edges), len(edges));
rewrite summarize-argument!(st: ref[State], local: ref[Local], arg: u32) -> void {
  apply append-local-argument!(local, verdict(st, arg), cir::u32-of(len(flows(st, arg))));
  apply append-flows!(local, flows(st, arg));
}
sweep summarize-arguments!(st: ref[State], f: ref[cir::Func], local: ref[Local]) {
  rows { from i in range(0, len(f.args)); yield = cir::u32-of(i); }
  apply = summarize-argument!(st, local, row);
}
rewrite summarize-present-arguments!(st: ref[State], f: ref[cir::Func], local: ref[Local]) -> void {
  require len(f.args) > 0;
  apply state-retarget!(st, f, as[ref[Summaries]](0));
  apply Uses-derive!(st);
  apply Arguments-derive!(st);
  apply summarize-arguments!(st, f, local);
}
pipeline local-summarize!(st: ref[State], f: ref[cir::Func], local: ref[Local]) {
  run clear-local-bits!(local);
  run clear-local-counts!(local);
  run clear-local-edges!(local);
  run summarize-present-arguments!(st, f, local);
}

# Summaries for every function (function i defines `syms[i]` and contributes
# `locals[i]`): an argument promises only what its local uses and every
# callee argument it flows into promise, the greatest solution of that. An
# unknown callee (the slot past the last) promises nothing. Intersection is
# monotone on these bits, recursive calls included.
reduce symbol-bound(syms: span[u32]) -> i64 {
  initial = 0;
  rows { from symbol in syms; yield = cir::i64-of(symbol) + 1; }
  step = if(row > acc, row, acc);
}
scatter configure-summary!(sums: ref[Summaries], syms: span[u32], group: i64, begin: u32, count: u32) inline {
  let symbol = cir::i64-of(syms[group]);
  write sums.first at symbol = begin + typed[u32](1);
  write sums.count at symbol = count;
}
materialize layout-local-facts!(sums: ref[Summaries], locals: span[Local], syms: span[u32]) {
  target = sums.flags;
  groups { from i in range(0, len(locals)); yield = i; }
  rows { from bit in locals[group].bits; yield = bit; }
  order = forward;
  configure = configure-summary!(sums, syms, group, begin, count);
}

# The argument slots that flow into each slot.
facts Callers(sums: ref[Summaries], locals: span[Local], syms: span[u32]) in callers {
  many callers(slot: u32) -> u32 over len(sums.flags) + 1;
  rule callers(if(to < 0, len(sums.flags), to)) = cir::u32-of(base + k)
    if from i in range(0, len(locals)), let local = locals[i],
       let base = cir::i64-of(sums.first[cir::i64-of(syms[i])]) - 1,
       segments k, e in local.edge-count, let target = local.edges[e],
       let to = summary-slot(sums, target.symbol, target.arg, target.operands);
}

facts Promised(sums: ref[Summaries]) in promised {
  fold promises(slot: u32) -> u8 over len(sums.flags) + 1 from promise(P-NOCAPTURE | P-READONLY) by &;
  rule promises(cir::u32-of(slot)) = sums.flags[slot] if from slot in range(0, len(sums.flags));
  rule promises(cir::u32-of(len(sums.flags))) = typed[u8](0);
  rule promises(user) = bits if with promises(slot) = bits, from user in callers(sums, slot);
}

rewrite summarize-locals!(sums: ref[Summaries], locals: span[Local], syms: span[u32]) -> void {
  let bound = symbol-bound(syms);
  apply fill!(borrow(sums.first), bound, typed[u32](0));
  apply fill!(borrow(sums.count), bound, typed[u32](0));
  apply layout-local-facts!(sums, locals, syms);
  apply Callers-derive!(sums, locals, syms);
  apply Promised-derive!(sums);
}

# Whether every argument fact in `after` still holds what `before` promised.
fn summaries-hold?(before: ref[Summaries], after: ref[Summaries]) -> bool =
  len(before.flags) == len(after.flags) and
  (all i in range(0, len(before.flags)):
    let b = promises(before, cir::u32-of(i)) in (b & promises(after, cir::u32-of(i))) == b);

# Report each argument whose fact `after` no longer holds.
sweep report-weakened!(funcs: span[ref[cir::Func]], syms: span[u32], before: ref[Summaries], after: ref[Summaries]) {
  rows {
    from i in range(0, len(funcs));
    let symbol = cir::i64-of(syms[i]);
    let first = cir::i64-of(before.first[symbol] - typed[u32](1));
    from k in range(0, cir::i64-of(before.count[symbol]));
    let b = promises(before, cir::u32-of(first + k));
    let a = promises(after, cir::u32-of(first + k));
    where (b & a) != b;
    yield = make Weakened { name = (read(funcs[i])).name; arg = k; before = b; after = a; };
  }
  apply = report-weakened-argument!(row);
}
record Weakened { name: span[u8]; arg: i64; before: u8; after: u8; }
rewrite report-weakened-argument!(row: Weakened) -> void {
  apply eprintln("copy forwarding: {} argument {}: {} became {}", row.name, row.arg, row.before, row.after);
}

# Module-wide forwarding in two rounds. Each round forwards every function's
# copies with argument summaries of the module as it stands, then summarizes
# again: rewrites may only strengthen facts (copies sunk out of PHIs remove
# uses that looked retaining), and a weakened fact is reported as an error.
#
# The work is three phases of per-function steps, each followed by a join:
#
# phase 0  step: the function's local summary       join: summaries
# phase 1  step: forward with them, local summary   join: summaries, check
# phase 2  step: forward with those, local summary  join: summaries, check
#
# A step (module-forward-step!) reads the summaries of the last join and
# reads and writes only its own function and that function's entries here,
# so the steps of one phase may run in any order or at the same time; a
# join (module-forward-join!) runs alone. What a step computes is a function
# of its function's CIR and the summaries, so two cases are answered without
# recomputing: a function the last forwarding left unchanged keeps its local
# summary, and in phase 2 a function that phase 1 left unchanged, none of
# whose direct callees' facts changed in between, is not forwarded again
# (it would be the same computation that found nothing to do).
record ModuleForward {
  funcs: span[ref[cir::Func]] = funcs;
  syms: span[u32] = syms;
  locals: list[Local] = tabulate[Local](len(funcs), i: local-new()) drop-each local-free!;
  modified: list[bool] = repeat[bool](len(funcs), false);
  current: Summaries = summaries-new() drop summaries-free!;
  next: Summaries = summaries-new() drop summaries-free!;
  strengthening: Strengthening = Strengthening-new() drop Strengthening-free!;
}
construct ModuleForward as module-forward-new(funcs: span[ref[cir::Func]], syms: span[u32]);
release ModuleForward as module-forward-free!(m);

const MODULE-FORWARD-PHASES = 3;

# The symbols one of whose argument facts the last join changed.
facts Strengthening(m: ref[ModuleForward]) in strengthening {
  flag strengthened?(symbol: i64) over len(m.next.first);
  rule strengthened?(symbol)
    if from symbol in range(0, len(m.next.first)), let first = cir::i64-of(m.next.first[symbol]), where first != 0,
       from k in range(0, cir::i64-of(m.next.count[symbol])), let slot = cir::u32-of(first - 1 + k),
       where promises(address(m, next), slot) != promises(address(m, current), slot);
}

# Whether F calls a function one of whose facts changed at the last join
# (whose summaries are current now: the domain strengthened? was derived over).
fn calls-strengthened?(m: ref[ModuleForward], f: ref[cir::Func]) -> bool =
  any v in f.insts:
    let x = cir::val(f, v) in as[i64](x.op) == cop::OP-CALL and x.imm >= 0
      and x.imm < len(m.current.first) and strengthened?(m, x.imm);

# SCRATCH is analysis storage of the calling thread module-forward-scratch.
scatter record-function-modified!(m: ref[ModuleForward], i: i64, modified: bool) inline { write m.modified at i = modified; }
rewrite forward-module-function!(m: ref[ModuleForward], scratch: ref[State], phase: i64, i: i64) -> void {
  let f = m.funcs[i];
  require phase == 1 or m.modified[i] or calls-strengthened?(m, f);
  apply forward-copies-in!(scratch, f, address(m, current));
  apply record-function-modified!(m, i, scratch.modified);
  apply local-summarize!(scratch, f, element(address(m, locals), i)) when scratch.modified;
}
rewrite module-forward-step!(m: ref[ModuleForward], scratch: ref[State], phase: i64, i: i64) -> void else create forward-module-function!(m, scratch, phase, i) {
  require phase == 0;
  apply local-summarize!(scratch, m.funcs[i], element(address(m, locals), i));
}

fn module-forward-scratch() -> State = state-new(as[ref[cir::Func]](0), as[ref[Summaries]](0));

fn module-forward-scratch-free!(scratch: ref[State]) -> void = state-free!(scratch);

# Close PHASE after every function's step of it: the summaries of the module
# as it now stands become current. False when a fact was weakened reported.
scatter publish-summaries!(m: ref[ModuleForward]) {
  let previous = m.current;
  field m.current = m.next;
  field m.next = previous;
}
rewrite module-forward-join!(m: ref[ModuleForward], phase: i64) -> bool {
  apply summarize-locals!(address(m, next), span-of(m.locals), m.syms);
  create ok = phase == 0 or summaries-hold?(address(m, current), address(m, next));
  apply report-weakened!(m.funcs, m.syms, address(m, current), address(m, next)) when not(ok);
  apply Strengthening-derive!(m) when phase > 0 and ok;
  apply publish-summaries!(m);
  result = ok;
}

record ModuleRun {
  module: ModuleForward = module-forward-new(funcs, syms) drop module-forward-free!;
  scratch: State = module-forward-scratch() drop module-forward-scratch-free!;
  ok: bool = true;
}
construct ModuleRun.new(funcs: span[ref[cir::Func]], syms: span[u32]);
release ModuleRun as module-run-free!(run);
sweep forward-module-functions!(run: ref[ModuleRun], phase: i64) {
  rows { from i in range(0, len(run.module.funcs)); yield = i; }
  apply = module-forward-step!(address(run, module), address(run, scratch), phase, row);
}
scatter record-module-phase!(run: ref[ModuleRun], ok: bool) inline { field run.ok = ok; }
rewrite forward-module-phase!(run: ref[ModuleRun], phase: i64) -> void {
  apply forward-module-functions!(run, phase);
  create ok = module-forward-join!(address(run, module), phase);
  apply record-module-phase!(run, ok);
}
sweep forward-module-phases!(run: ref[ModuleRun]) {
  rows { from phase in range(0, MODULE-FORWARD-PHASES); where run.ok; yield = phase; }
  apply = forward-module-phase!(run, row);
}
rewrite forward-module!(funcs: span[ref[cir::Func]], syms: span[u32]) -> bool {
  resource run = invoke ModuleRun.new(funcs, syms) release module-run-free!(borrow(run));
  apply forward-module-phases!(borrow(run));
  result = run.ok;
}
