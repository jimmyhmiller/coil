# Library algorithms and their storage for asm.

library

use "coil.primitive" as primitive;

use "native.buf" as buf only [Buf];

use "coil.sync" as sync;

use "coil.result" only [Ok, Err];

const SEC-TEXT = 0;

const SEC-CONST = 1;

const SEC-CSTRING = 2;

const SEC-DATA = 3;

const SEC-DATA-CONST = 4;

const SEC-BSS = 5;

const SEC-COUNT = 6;

const BIND-LOCAL = 0;

const BIND-GLOBAL = 1;

const BIND-WEAK = 2;

const R-BRANCH26 = 0;

const R-PAGE21 = 1;

const R-PAGEOFF12 = 2;

const R-GOT-PAGE21 = 3;

const R-GOT-PAGEOFF12 = 4;

const R-ABS64 = 5;

const R-PCREL32 = 6;

const R-PLT32 = 7;

const R-GOTPCREL32 = 8;

const R-ABS32 = 9;

record Section {
  segname: span[u8] = seg;
  sectname: span[u8] = sect;
  data: Buf = invoke Buf.new();
  align: i64 = align;
  flags: u32 = flags;
  zsize: i64;
}

record Symbol {
  name: span[u8];
  sect: i64;
  off: i64;
  size: i64;
  binding: u8;
}

record Reloc {
  sect: i64;
  off: i64;
  sym: u32;
  kind: u8;
  addend: i64;
}

const SYM-CHUNK-LOG = 12;

const SYM-CHUNK = 4096;

const SYM-MAX-CHUNKS = 1024;

record Asm {
  sects: list[Section] = list[Section](
    mk-section("__TEXT", "__text", 4, typed[u32](0x80000400)),
    mk-section("__TEXT", "__const", 4, typed[u32](0)),
    mk-section("__TEXT", "__cstring", 0, typed[u32](2)),
    mk-section("__DATA", "__data", 3, typed[u32](0)),
    mk-section("__DATA", "__const", 3, typed[u32](0)),
    mk-section("__DATA", "__bss", 4, typed[u32](1)));
  # Reserving the chunk table up front is part of stable symbol addressing.
  sym-chunks: list[list[Symbol]] capacity SYM-MAX-CHUNKS;
  nsyms: i64;
  shared: bool;
  sym-lock: sync::Mutex;
  relocs: list[Reloc];
  rt-names: list[span[u8]];
  rt-syms: list[u32];
}

construct Section as mk-section(seg: span[u8], sect: span[u8], align: i64, flags: u32);
construct Asm.new();

fn asm-free!(a: ref[Asm]) -> void {
  for i in range(0, len(a.sects)) {
    buf::buf-free!(sect-buf(a, i));
  };
  free!(borrow(a.sects));
  for i in range(0, len(a.sym-chunks)) {
    free!(borrow(element(borrow(a.sym-chunks), i)));
  };
  free!(borrow(a.sym-chunks));
  set a.nsyms = 0;
  free!(borrow(a.relocs));
  free!(borrow(a.rt-names));
  free!(borrow(a.rt-syms));
  when(a.shared) {
    invoke sync::Mutex.destroy!(address(a, sym-lock));
    set a.shared = false;
  };
}

fn share!(a: ref[Asm]) -> void {
  match(invoke sync::Mutex.init(address(a, sym-lock))) {
    Ok(_) => do {
      set a.shared = true;
    };
    Err(_) => do {
      abort();
    };
  };
}

fn sym-push!(a: ref[Asm], s: Symbol) -> u32 {
  when(a.shared) {
    invoke sync::Mutex.lock!(address(a, sym-lock));
  };
  bind {
    i = a.nsyms;
    ci = (i >> SYM-CHUNK-LOG);
  } {
    when((ci >= len(a.sym-chunks))) {
      when((ci >= SYM-MAX-CHUNKS)) {
        abort();
      };
      bind {
        var chunk = list[Symbol];
      } {
        reserve!(borrow(chunk), SYM-CHUNK);
        push!(borrow(a.sym-chunks), chunk);
      };
    };
    push!(borrow(element(borrow(a.sym-chunks), ci)), s);
    set a.nsyms = (i + 1);
    when(a.shared) {
      invoke sync::Mutex.unlock!(address(a, sym-lock));
    };
    as[u32](i);
  };
}

fn sect-at(a: ref[Asm], s: i64) -> ref[Section] {
  element(borrow(a.sects), s);
}

fn sect-buf(a: ref[Asm], s: i64) -> ref[Buf] {
  address(sect-at(a, s), data);
}

fn sym-at(a: ref[Asm], i: u32) -> ref[Symbol] {
  bind {
    x = as[i64](i);
  } {
    element(element(borrow(a.sym-chunks), (x >> SYM-CHUNK-LOG)), (x & (SYM-CHUNK - 1)));
  };
}

fn sym-count(a: ref[Asm]) -> u32 {
  as[u32](a.nsyms);
}

fn sect-align-at-least!(a: ref[Asm], s: i64, log2: i64) -> void {
  bind {
    sec = sect-at(a, s);
  } {
    when((sec.align < log2)) {
      set sec.align = log2;
    };
  };
}

fn sym-add-undef!(a: ref[Asm], name: span[u8], binding: u8) -> u32 {
  sym-push!(a, make Symbol {
    name = name;
    sect = -1;
    off = 0;
    size = 0;
    binding = binding;
  });
}

fn sym-def!(a: ref[Asm], sym: u32, sect: i64, off: i64, size: i64) -> void {
  bind {
    s = sym-at(a, sym);
  } {
    set s.sect = sect;
    set s.off = off;
    set s.size = size;
  };
}

fn sym-add-def!(a: ref[Asm], name: span[u8], sect: i64, off: i64, size: i64, binding: u8) -> u32 {
  sym-push!(a, make Symbol {
    name = name;
    sect = sect;
    off = off;
    size = size;
    binding = binding;
  });
}

fn sym-add-anon!(a: ref[Asm], sect: i64, off: i64, size: i64) -> u32 {
  sym-add-def!(a, "", sect, off, size, typed[u8](0));
}

fn sect-append!(a: ref[Asm], sect: i64, p: ref[u8], n: i64, align: i64) -> i64 {
  bind {
    b = sect-buf(a, sect);
  } {
    buf::align-to!(b, align);
    bind {
      off = b.len;
    } {
      buf::emit-bytes!(b, p, n);
      sect-align-at-least!(a, sect, primitive::ctz(align));
      off;
    };
  };
}

fn bss-reserve!(a: ref[Asm], n: i64, align: i64) -> i64 {
  bind {
    sec = sect-at(a, SEC-BSS);
    off = ((sec.zsize + (align - 1)) & (0 - align));
  } {
    set sec.zsize = (off + n);
    sect-align-at-least!(a, SEC-BSS, primitive::ctz(align));
    off;
  };
}

fn const-data!(a: ref[Asm], p: ref[u8], n: i64, align: i64) -> u32 {
  bind {
    off = sect-append!(a, SEC-CONST, p, n, align);
  } {
    sym-add-anon!(a, SEC-CONST, off, n);
  };
}

fn reloc!(a: ref[Asm], sect: i64, off: i64, sym: u32, kind: i64, addend: i64) -> void {
  push!(borrow(a.relocs), make Reloc {
    sect = sect;
    off = off;
    sym = sym;
    kind = as[u8](kind);
    addend = addend;
  });
}

fn runtime-sym!(a: ref[Asm], name: span[u8]) -> u32 {
  escape found {
    for i in range(0, len(a.rt-names)) {
      when(((a.rt-names)[i] == name)) {
        yield found((a.rt-syms)[i]);
      };
    };
    bind {
      s = sym-add-undef!(a, name, typed[u8](1));
    } {
      push!(borrow(a.rt-names), name);
      push!(borrow(a.rt-syms), s);
      s;
    };
  };
}
