# Library algorithms and their storage for asm.

library declarative

use "coil.primitive" as primitive;

use "native.buf" as buf only [Buf];

use "coil.sync" as sync;


const SEC-TEXT = 0;

const SEC-CONST = 1;

const SEC-CSTRING = 2;

const SEC-DATA = 3;

const SEC-DATA-CONST = 4;

const SEC-BSS = 5;

const SEC-COUNT = 6;

const BIND-LOCAL = 0;

const BIND-GLOBAL = 1;

const BIND-WEAK = 2;

const R-BRANCH26 = 0;

const R-PAGE21 = 1;

const R-PAGEOFF12 = 2;

const R-GOT-PAGE21 = 3;

const R-GOT-PAGEOFF12 = 4;

const R-ABS64 = 5;

const R-PCREL32 = 6;

const R-PLT32 = 7;

const R-GOTPCREL32 = 8;

const R-ABS32 = 9;

record Section {
  segname: span[u8] = seg;
  sectname: span[u8] = sect;
  data: Buf = invoke Buf.new() drop buf::buf-free!;
  align: i64 = align;
  flags: u32 = flags;
  zsize: i64;
}

record Symbol {
  name: span[u8];
  sect: i64;
  off: i64;
  size: i64;
  binding: u8;
}

record Reloc {
  sect: i64;
  off: i64;
  sym: u32;
  kind: u8;
  addend: i64;
}

const SYM-CHUNK-LOG = 12;

const SYM-CHUNK = 4096;

const SYM-MAX-CHUNKS = 1024;

record Asm {
  sects: list[Section] = list[Section](
    mk-section("__TEXT", "__text", 4, typed[u32](0x80000400)),
    mk-section("__TEXT", "__const", 4, typed[u32](0)),
    mk-section("__TEXT", "__cstring", 0, typed[u32](2)),
    mk-section("__DATA", "__data", 3, typed[u32](0)),
    mk-section("__DATA", "__const", 3, typed[u32](0)),
    mk-section("__DATA", "__bss", 4, typed[u32](1))) drop-each section-free!;
  # Reserving the chunk table up front is part of stable symbol addressing.
  sym-chunks: list[list[Symbol]] capacity SYM-MAX-CHUNKS drop-each free!;
  nsyms: i64;
  shared: bool;
  sym-lock: sync::Mutex;
  relocs: list[Reloc];
  rt-names: list[span[u8]];
  rt-syms: list[u32];
}

construct Section as mk-section(seg: span[u8], sect: span[u8], align: i64, flags: u32);
construct Asm.new();

release Section as section-free!;
release Asm as asm-storage-free!(a);

mutex symbols(a: ref[Asm]) {
  active = a.shared; address = address(a, sym-lock);
  initialize = share!; destroy = unshare!; acquire = lock-symbols!; release = unlock-symbols!;
}
scatter reset-symbol-count!(a: ref[Asm]) inline { field a.nsyms = 0; }
pipeline asm-free!(a: ref[Asm]) {
  run asm-storage-free!(a); run reset-symbol-count!(a); run unshare!(a);
}
stable-index sym-push!(a: ref[Asm], s: Symbol) {
  chunks = sym-chunks; count = nsyms; shift = SYM-CHUNK-LOG;
  lookup = sym-at; length = sym-count;
  acquire = lock-symbols!(a); release = unlock-symbols!(a);
}

fn sect-at(a: ref[Asm], s: i64) -> ref[Section] = element(address(a, sects), s);

fn sect-buf(a: ref[Asm], s: i64) -> ref[Buf] = address(sect-at(a, s), data);

scatter sect-align-at-least!(a: ref[Asm], s: i64, log2: i64) {
  let sec = sect-at(a, s);
  where sec.align < log2;
  field sec.align = log2;
}

fn sym-add-undef!(a: ref[Asm], name: span[u8], binding: u8) -> u32 = sym-push!(a, make Symbol {
    name = name;
    sect = -1;
    off = 0;
    size = 0;
    binding = binding;
  });

scatter sym-def!(a: ref[Asm], sym: u32, sect: i64, off: i64, size: i64) {
  let s = sym-at(a, sym);
  field s.sect = sect; field s.off = off; field s.size = size;
}

fn sym-add-def!(a: ref[Asm], name: span[u8], sect: i64, off: i64, size: i64, binding: u8) -> u32 = sym-push!(a, make Symbol {
    name = name;
    sect = sect;
    off = off;
    size = size;
    binding = binding;
  });

fn sym-add-anon!(a: ref[Asm], sect: i64, off: i64, size: i64) -> u32 = sym-add-def!(a, "", sect, off, size, typed[u8](0));

rewrite sect-append!(a: ref[Asm], sect: i64, p: ref[u8], n: i64, align: i64) -> i64 {
  let b = sect-buf(a, sect);
  apply buf::align-to!(b, align);
  create off = b.len;
  apply buf::emit-bytes!(b, p, n);
  apply sect-align-at-least!(a, sect, primitive::ctz(align));
  result = off;
}

scatter set-bss-size!(sec: ref[Section], size: i64) inline { field sec.zsize = size; }
rewrite bss-reserve!(a: ref[Asm], n: i64, align: i64) -> i64 {
  let sec = sect-at(a, SEC-BSS);
  let off = (sec.zsize + (align - 1)) & (0 - align);
  apply set-bss-size!(sec, off + n);
  apply sect-align-at-least!(a, SEC-BSS, primitive::ctz(align));
  result = off;
}

rewrite const-data!(a: ref[Asm], p: ref[u8], n: i64, align: i64) -> u32 {
  create off = sect-append!(a, SEC-CONST, p, n, align);
  create symbol = sym-add-anon!(a, SEC-CONST, off, n);
  result = symbol;
}

insert reloc!(a: ref[Asm], sect: i64, off: i64, sym: u32, kind: i64, addend: i64) -> void {
  column a.relocs = make Reloc { sect = sect; off = off; sym = sym; kind = as[u8](kind); addend = addend; };
}

intern runtime-sym!(a: ref[Asm], name: span[u8]) -> u32 {
  keys = a.rt-names; values = a.rt-syms; key = name;
  compute = sym-add-undef!(a, name, typed[u8](1));
}
