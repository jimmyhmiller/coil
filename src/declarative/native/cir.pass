# Library algorithms and their storage for cir.

library

use "native.cir-ops" only *;

const P-EQ = 0;

const P-NE = 1;

const P-SLT = 2;

const P-SLE = 3;

const P-SGT = 4;

const P-SGE = 5;

const P-ULT = 6;

const P-ULE = 7;

const P-UGT = 8;

const P-UGE = 9;

const F-OEQ = 0;

const F-ONE = 1;

const F-OLT = 2;

const F-OLE = 3;

const F-OGT = 4;

const F-OGE = 5;

const F-UNE = 6;

const F-UEQ = 7;

const F-ORD = 8;

const F-UNO = 9;

const F-ULT = 10;

const F-ULE = 11;

const F-UGT = 12;

const F-UGE = 13;

const AF-SEXT = 0x80;

const AF-SRET = 0x100;

const AF-VARIADIC = 0x200;

const AF-ZEXT = 0x400;

const AF-BYVAL = 0x800;

fn af-byval(size: i64) -> u32 {
  (typed[u32](0x800) | (as[u32](size) << typed[u32](12)));
}

fn af-byval-size(flags: u32) -> u32 {
  (flags >> typed[u32](12));
}

fn af-byval?(flags: u32) -> bool {
  ((flags & typed[u32](0x800)) != typed[u32](0));
}

const AF-ADDRESS = 0x2000;

const AF-INDIRECT = 0x4000;

const AF-SIGNED = 0x8000;

fn af-signed?(flags: u32) -> bool {
  (not(af-byval?(flags)) and ((flags & typed[u32](0x8000)) != typed[u32](0)));
}

fn af-address?(flags: u32) -> bool {
  (not(af-byval?(flags)) and ((flags & typed[u32](0x2000)) != typed[u32](0)));
}

const AF-MIXED = 0x1000;

# bits 24..26: log2 of an integer argument's C size plus one (Apple lays
# stack arguments out at that size); 0 for the part's own size
fn af-size(bytes: i64) -> u32 {
  choose {
    (bytes == 1) => typed[u32](0x1000000);
    (bytes == 2) => typed[u32](0x2000000);
    (bytes == 4) => typed[u32](0x3000000);
    else => typed[u32](0);
  };
}

# bits 16..23: how many following arguments must stay in consecutive registers
record Value {
  op: u8;
  ty: u8;
  flags: u8;
  aux: u8;
  nops: u32;
  ntotal: u32;
  opb: u32;
  imm: i64;
  imm2: i64;
  block: u32;
  next: u32;
}

record Block {
  ibegin: u32;
  iend: u32;
  phi-first: u32;
  phi-begin: u32;
  phi-count: u32;
  term: u32;
  pred-first: u32;
  npred: u32;
  sealed: bool;
  info: u32;
  info2: u32;
}

record Edge {
  from: u32;
  next: u32;
}

# A PHI created in an unsealed block, completed when the block is sealed.
record IncompletePhi {
  block: u32;
  var: u32;
  phi: u32;
}

record VarDef {
  block: u32;
  value: u32;
}

# A slot of the (variable, block) -> definition table. A slot is live only
# when its `gen` is the function's: starting a function bumps the generation
# instead of zeroing the table, which only ever grows to the largest function.
record DefSlot {
  key: u64;
  value: u32;
  gen: u32;
}

record Func {
  name: span[u8] = "";
  values: list[Value];
  operands: list[u32];
  argflags: list[u32];
  insts: list[u32];
  blocks: list[Block];
  edges: list[Edge];
  args: list[u32];
  arg-sret: list[bool];
  arg-flags: list[u32];
  allocas: list[u32];
  phis: list[u32];
  case-values: list[u64];
  fwd: list[u32];
  bytes: list[u8];
  cur: u32 = none();
  has-calls: bool = false;
  has-tail-calls: bool = false;
  has-dynamic-alloca: bool = false;
  frame-escapes: bool = false;
  var-types: list[u8];
  last-def: list[VarDef];
  def-slots: list[DefSlot];
  def-gen: u32 = typed[u32](1);
  def-count: i64 = 0;
  incomplete: list[IncompletePhi];
  undef-i64: u32 = none();
  small-consts: list[u32] = bind {
    var xs = list[u32];
  } {
    for _ in range(0, 64) {
      push!(borrow(xs), none());
    };
    xs;
  };
  scratch-uses: list[u32];
  scratch-insts: list[u32];
  locs: list[u64];
  cur-loc: u64 = typed[u64](0);
  mark-insts: list[u32];
  pending-marks: u32 = typed[u32](0);
}

fn none() -> u32 {
  typed[u32](0xFFFFFFFF);
}

fn i64-of(x: u32) -> i64 {
  as[i64](x);
}

fn u32-of(x: i64) -> u32 {
  as[u32](x);
}

construct Func.new();

release Func as func-free!(f);

# A copy of XS in storage of exactly its length.
fn list-copy[T](xs: ref[list[T]]) -> list[T] {
  bind {
    var out = list[T];
    n = len(read(xs));
  } {
    when((n > 0)) {
      append-list(borrow(out), read(xs), n);
    };
    out;
  };
}

# Make DST (uninitialized storage) the function SRC is after finish!, in
# storage of exactly its size. SRC is unchanged and can be reset! for the
# next function: a client that keeps every function lowers each into one
# reused Func, whose lists have long since grown to size, and keeps this
# copy, instead of growing a fresh Func's twenty lists from nothing every
# time. The copy has SRC's values, instructions, blocks and PHIs, and none
# of its SSA variables: after finish! no variable is read or written again,
# and the definition table belongs to SRC's storage (it is sized for the
# largest function SRC has held). A variable made in the copy is a new one.
fn copy-finished!(dst: ref[Func], src: ref[Func]) -> void {
  bind {

  } {
    write(dst, make Func {
      name = src.name;
      values = specialize list-copy[Value](address(src, values));
      operands = specialize list-copy[u32](address(src, operands));
      argflags = specialize list-copy[u32](address(src, argflags));
      insts = specialize list-copy[u32](address(src, insts));
      blocks = specialize list-copy[Block](address(src, blocks));
      edges = specialize list-copy[Edge](address(src, edges));
      args = specialize list-copy[u32](address(src, args));
      arg-sret = specialize list-copy[bool](address(src, arg-sret));
      arg-flags = specialize list-copy[u32](address(src, arg-flags));
      allocas = specialize list-copy[u32](address(src, allocas));
      phis = specialize list-copy[u32](address(src, phis));
      case-values = specialize list-copy[u64](address(src, case-values));
      fwd = specialize list-copy[u32](address(src, fwd));
      bytes = specialize list-copy[u8](address(src, bytes));
      cur = src.cur;
      has-calls = src.has-calls;
      has-tail-calls = src.has-tail-calls;
      has-dynamic-alloca = src.has-dynamic-alloca;
      frame-escapes = src.frame-escapes;
      var-types = list[u8];
      last-def = list[VarDef];
      def-slots = list[DefSlot];
      def-gen = typed[u32](1);
      def-count = 0;
      incomplete = list[IncompletePhi];
      undef-i64 = src.undef-i64;
      small-consts = specialize list-copy[u32](address(src, small-consts));
      scratch-uses = list[u32];
      scratch-insts = list[u32];
      locs = specialize list-copy[u64](address(src, locs));
      cur-loc = src.cur-loc;
      mark-insts = specialize list-copy[u32](address(src, mark-insts));
      pending-marks = src.pending-marks;
    });
  };
}

# Start a new function (keeps the storage).
fn reset!(f: ref[Func], name: span[u8]) -> void {
  set f.name = name;
  clear!(borrow(f.values));
  clear!(borrow(f.operands));
  clear!(borrow(f.argflags));
  clear!(borrow(f.insts));
  clear!(borrow(f.blocks));
  clear!(borrow(f.edges));
  clear!(borrow(f.args));
  clear!(borrow(f.arg-sret));
  clear!(borrow(f.arg-flags));
  clear!(borrow(f.allocas));
  clear!(borrow(f.locs));
  set f.cur-loc = typed[u64](0);
  clear!(borrow(f.mark-insts));
  set f.pending-marks = typed[u32](0);
  clear!(borrow(f.phis));
  clear!(borrow(f.case-values));
  clear!(borrow(f.fwd));
  clear!(borrow(f.bytes));
  clear!(borrow(f.var-types));
  clear!(borrow(f.last-def));
  defs-reset!(f);
  clear!(borrow(f.incomplete));
  set f.cur = none();
  set f.has-calls = false;
  set f.has-tail-calls = false;
  set f.has-dynamic-alloca = false;
  set f.frame-escapes = false;
  set f.undef-i64 = none();
  for i in range(0, 64) {
    put(borrow(f.small-consts), i, none());
  };
}

fn val(f: ref[Func], v: u32) -> ref[Value] {
  element(borrow(f.values), i64-of(v));
}

# ---- frame escapes ----
# Value.flags bit 2: the value is the address of (or into) this frame. If one
# reaches a call argument, a stored value, a return or a variable, the frame
# escapes, and pointer-argument tail calls are demoted (LLVM's musttail rule).
fn frame-derived?(f: ref[Func], v: u32) -> bool {
  (((val(f, v)).flags & typed[u8](4)) != typed[u8](0));
}

fn mark-frame-derived!(f: ref[Func], v: u32) -> void {
  set (val(f, v)).flags = ((val(f, v)).flags | typed[u8](4));
}

fn note-escape!(f: ref[Func], v: u32) -> void {
  when(frame-derived?(f, v)) {
    set f.frame-escapes = true;
  };
}

# ---- volatile accesses ----
# Value.flags bit 6 on an OP-LOAD or OP-STORE: the access is volatile. It
# happens exactly once where it stands, in order with the other volatile
# accesses, whatever is known about the memory: a pass may not remove,
# forward, repeat, move or merge it, and the slot it names is not private.
# The compile straight from CIR (-O0, -O1) writes each instruction as it stands
# and need not look; the graph compile gives the load or store a volatile payload.
fn volatile?(f: ref[Func], v: u32) -> bool {
  (((val(f, v)).flags & typed[u8](0x40)) != typed[u8](0));
}

fn mark-volatile!(f: ref[Func], v: u32) -> void {
  set (val(f, v)).flags = ((val(f, v)).flags | typed[u8](0x40));
}

fn blk(f: ref[Func], b: u32) -> ref[Block] {
  element(borrow(f.blocks), i64-of(b));
}

fn value-count(f: ref[Func]) -> u32 {
  u32-of(len(f.values));
}

fn block-count(f: ref[Func]) -> u32 {
  u32-of(len(f.blocks));
}

fn operand(f: ref[Func], v: ref[Value], i: u32) -> u32 {
  (f.operands)[i64-of((v.opb + i))];
}

fn push-value!(f: ref[Func], op: i64, ty: i64, imm: i64, imm2: i64) -> u32 {
  bind {
    id = value-count(f);
  } {
    push!(borrow(f.values), make Value {
      op = as[u8](op);
      ty = as[u8](ty);
      flags = typed[u8](0);
      aux = typed[u8](0);
      nops = typed[u32](0);
      ntotal = typed[u32](0);
      opb = u32-of(len(f.operands));
      imm = imm;
      imm2 = imm2;
      block = none();
      next = none();
    });
    push!(borrow(f.fwd), none());
    push!(borrow(f.locs), f.cur-loc);
    id;
  };
}

# The source position the instructions made from here on belong to (an
# opaque nonzero number the client decodes; 0 for none).
fn set-loc!(f: ref[Func], loc: u64) -> void {
  set f.cur-loc = loc;
}

# A debug mark here (where a variable comes into scope, say): it marks the
# next instruction, whose code offset the compiler records (Value.flags bit
# 5, Compiler.dbg-marks). Returns its id. No instruction is added.
fn dbg-mark!(f: ref[Func]) -> u32 {
  bind {
    id = u32-of(len(f.mark-insts));
  } {
    push!(borrow(f.mark-insts), none());
    set f.pending-marks = (f.pending-marks + typed[u32](1));
    id;
  };
}

fn nmarks(f: ref[Func]) -> i64 {
  len(f.mark-insts);
}

# Whether instruction `v` carries debug marks.
fn dbg-marked?(f: ref[Func], v: u32) -> bool {
  (((val(f, v)).flags & typed[u8](0x20)) != typed[u8](0));
}

fn push-operand!(f: ref[Func], x: u32, flags: u32) -> void {
  push!(borrow(f.operands), x);
  push!(borrow(f.argflags), flags);
}

# ---- values without instructions ----
fn const!(f: ref[Func], ty: i64, lo: u64, hi: u64) -> u32 {
  push-value!(f, OP-CONST, ty, as[i64](lo), as[i64](hi));
}

fn iconst!(f: ref[Func], v: i64) -> u32 {
  if(((v >= -16) and (v < 48)), bind {
    have = (f.small-consts)[(v + 16)];
  } {
    if((have != none()), have, bind {
      c = push-value!(f, OP-CONST, T-I64, v, 0);
    } {
      put(borrow(f.small-consts), (v + 16), c);
      c;
    });
  }, push-value!(f, OP-CONST, T-I64, v, 0));
}

fn sym!(f: ref[Func], sym: u32, addend: i64) -> u32 {
  push-value!(f, OP-SYM, T-I64, i64-of(sym), addend);
}

fn arg!(f: ref[Func], ty: i64, sret: bool) -> u32 {
  arg-flagged!(f, ty, sret, typed[u32](0));
}

# An argument with flags (see the AF-… constants and bits 16..23).
fn arg-flagged!(f: ref[Func], ty: i64, sret: bool, flags: u32) -> u32 {
  bind {
    v = push-value!(f, OP-ARG, ty, len(f.args), 0);
  } {
    push!(borrow(f.args), v);
    push!(borrow(f.arg-sret), sret);
    push!(borrow(f.arg-flags), flags);
    v;
  };
}

# A stack slot of `size` bytes; its value is the slot's address.
# A static stack slot; its `next` is its ordinal in `allocas`.
fn alloca!(f: ref[Func], size: i64, align: i64) -> u32 {
  bind {
    v = push-value!(f, OP-ALLOCA, T-I64, if((size < 1), 1, size), if((align < 1), 1, align));
  } {
    set (val(f, v)).next = u32-of(len(f.allocas));
    push!(borrow(f.allocas), v);
    mark-frame-derived!(f, v);
    v;
  };
}

# ---- blocks ----
fn new-block!(f: ref[Func]) -> u32 {
  bind {
    b = block-count(f);
  } {
    push!(borrow(f.blocks), make Block {
      ibegin = typed[u32](0);
      iend = typed[u32](0);
      phi-first = none();
      phi-begin = typed[u32](0);
      phi-count = typed[u32](0);
      term = none();
      pred-first = none();
      npred = typed[u32](0);
      sealed = false;
      info = typed[u32](0);
      info2 = typed[u32](0);
    });
    b;
  };
}

# Make `b` the block instructions go to. The previous block must be terminated.
fn set-block!(f: ref[Func], b: u32) -> void {
  set f.cur = b;
  bind {
    bb = blk(f, b);
    at = u32-of(len(f.insts));
  } {
    set bb.ibegin = at;
    set bb.iend = at;
  };
}

fn cur-block(f: ref[Func]) -> u32 {
  f.cur;
}

fn terminated?(f: ref[Func]) -> bool {
  ((f.cur == none()) or ((blk(f, f.cur)).term != none()));
}

fn add-edge!(f: ref[Func], from: u32, to: u32) -> void {
  bind {
    e = u32-of(len(f.edges));
    tb = blk(f, to);
  } {
    push!(borrow(f.edges), make Edge {
      from = from;
      next = tb.pred-first;
    });
    set tb.pred-first = e;
    set tb.npred = (tb.npred + typed[u32](1));
  };
}

# ---- instructions ----
fn inst!(f: ref[Func], op: i64, ty: i64, imm: i64, imm2: i64) -> u32 {
  bind {
    v = push-value!(f, op, ty, imm, imm2);
  } {
    push!(borrow(f.insts), v);
    set (blk(f, f.cur)).iend = u32-of(len(f.insts));
    when((f.pending-marks > typed[u32](0))) {
      bind {
        n = len(f.mark-insts);
      } {
        for k in range((n - i64-of(f.pending-marks)), n) {
          put(borrow(f.mark-insts), k, v);
        };
      };
      set (val(f, v)).flags = ((val(f, v)).flags | typed[u8](0x20));
      set f.pending-marks = typed[u32](0);
    };
    v;
  };
}

fn set-ops!(f: ref[Func], v: u32, nops: u32, ntotal: u32) -> void {
  bind {
    x = val(f, v);
  } {
    set x.nops = nops;
    set x.ntotal = ntotal;
  };
}

fn op0!(f: ref[Func], op: i64, ty: i64, imm: i64, imm2: i64) -> u32 {
  inst!(f, op, ty, imm, imm2);
}

fn op1!(f: ref[Func], op: i64, ty: i64, a: u32, imm: i64, imm2: i64) -> u32 {
  bind {
    x = val(f, a);
  } {
    if((((op == OP-SEXT) or (op == OP-ZEXT)) and (ty == T-I64) and (as[i64](x.op) == OP-CONST) and (as[i64](x.ty) == T-I64) and (imm > 0) and (imm < 64)), bind {
      sh = (64 - imm);
      c = if((op == OP-SEXT), ((x.imm << sh) >> sh), as[i64](((as[u64](x.imm) << as[u64](sh)) >> as[u64](sh))));
    } {
      iconst!(f, c);
    }, op1-inst!(f, op, ty, a, imm, imm2));
  };
}

fn op1-inst!(f: ref[Func], op: i64, ty: i64, a: u32, imm: i64, imm2: i64) -> u32 {
  bind {
    v = inst!(f, op, ty, imm, imm2);
  } {
    push-operand!(f, a, typed[u32](0));
    set-ops!(f, v, typed[u32](1), typed[u32](1));
    when(((op == OP-DYNALLOCA) or (((op == OP-ADDI) or (op == OP-COPY)) and frame-derived?(f, a)))) {
      mark-frame-derived!(f, v);
    };
    v;
  };
}

fn op2!(f: ref[Func], op: i64, ty: i64, a: u32, b: u32, imm: i64, imm2: i64) -> u32 {
  bind {
    v = inst!(f, op, ty, imm, imm2);
  } {
    push-operand!(f, a, typed[u32](0));
    push-operand!(f, b, typed[u32](0));
    set-ops!(f, v, typed[u32](2), typed[u32](2));
    choose {
      (((op == OP-PTRADD) or (op == OP-ADD) or (op == OP-SUB) or (op == OP-OR) or (op == OP-AND)) and (frame-derived?(f, a) or frame-derived?(f, b))) => mark-frame-derived!(f, v);
      (op == OP-STORE) => note-escape!(f, b);
      ((op == OP-ATOMIC-STORE) or (op == OP-ATOMIC-RMW)) => note-escape!(f, b);
      else => 0;
    };
    v;
  };
}

fn op3!(f: ref[Func], op: i64, ty: i64, a: u32, b: u32, c: u32, imm: i64, imm2: i64) -> u32 {
  bind {
    v = inst!(f, op, ty, imm, imm2);
  } {
    push-operand!(f, a, typed[u32](0));
    push-operand!(f, b, typed[u32](0));
    push-operand!(f, c, typed[u32](0));
    set-ops!(f, v, typed[u32](3), typed[u32](3));
    when(((op == OP-SELECT) and (frame-derived?(f, b) or frame-derived?(f, c)))) {
      mark-frame-derived!(f, v);
    };
    when((op == OP-CMPXCHG)) {
      note-escape!(f, c);
    };
    v;
  };
}

# The base of address `p` once the constant offsets of ADDIs are folded into
# the access's own (`addr-off` gives the total): `ldr x, [base, #off]`
# instead of an add before every field access. An ADDI left without uses is
# dropped by `finish!`.
fn addr-base(f: ref[Func], p: u32) -> u32 {
  bind {
    var b = p;
  } {
    while((as[i64]((val(f, b)).op) == OP-ADDI)) {
      set b = operand(f, val(f, b), typed[u32](0));
    };
    b;
  };
}

fn addr-off(f: ref[Func], p: u32, off: i64) -> i64 {
  bind {
    var b = p;
    var o = off;
  } {
    while((as[i64]((val(f, b)).op) == OP-ADDI)) {
      set o = (o + (val(f, b)).imm);
      set b = operand(f, val(f, b), typed[u32](0));
    };
    o;
  };
}

fn load-mem!(f: ref[Func], ty: i64, p: u32, off: i64, bytes: i64, signed: bool) -> u32 {
  op1!(f, OP-LOAD, ty, addr-base(f, p), addr-off(f, p, off), (bytes | if(signed, 256, 0)));
}

fn store-mem!(f: ref[Func], p: u32, v: u32, off: i64, bytes: i64) -> u32 {
  op2!(f, OP-STORE, T-VOID, addr-base(f, p), v, addr-off(f, p, off), bytes);
}

fn addi!(f: ref[Func], p: u32, off: i64) -> u32 {
  if((off == 0), p, op1!(f, OP-ADDI, T-I64, p, off, 0));
}

# Terminators.
fn br!(f: ref[Func], target: u32) -> void {
  bind {
    b = f.cur;
    v = inst!(f, OP-BR, T-VOID, 0, 0);
  } {
    push-operand!(f, target, typed[u32](0));
    set-ops!(f, v, typed[u32](0), typed[u32](1));
    set (blk(f, b)).term = v;
    add-edge!(f, b, target);
  };
}

fn condbr!(f: ref[Func], c: u32, t: u32, e: u32) -> void {
  bind {
    b = f.cur;
    v = inst!(f, OP-CONDBR, T-VOID, 0, 0);
  } {
    push-operand!(f, c, typed[u32](0));
    push-operand!(f, t, typed[u32](0));
    push-operand!(f, e, typed[u32](0));
    set-ops!(f, v, typed[u32](1), typed[u32](3));
    set (blk(f, b)).term = v;
    add-edge!(f, b, t);
    when((t != e)) {
      add-edge!(f, b, e);
    };
  };
}

# A switch on `x` (I64): `values[i]` goes to `targets[i]`, anything else to
# `default`. Values must be distinct.
fn switch!(f: ref[Func], x: u32, default: u32, values: ref[list[u64]], targets: ref[list[u32]]) -> void {
  bind {
    b = f.cur;
    n = len(read(values));
    v = inst!(f, OP-SWITCH, T-VOID, len(f.case-values), 0);
  } {
    push-operand!(f, x, typed[u32](0));
    push-operand!(f, default, typed[u32](0));
    for i in range(0, n) {
      push!(borrow(f.case-values), (read(values))[i]);
      push-operand!(f, (read(targets))[i], typed[u32](0));
    };
    set-ops!(f, v, typed[u32](1), u32-of((n + 2)));
    set (blk(f, b)).term = v;
    add-edge!(f, b, default);
    for i in range(0, n) {
      bind {
        t = (read(targets))[i];
        var seen = (t == default);
      } {
        for j in range(0, i) {
          when(((read(targets))[j] == t)) {
            set seen = true;
          };
        };
        when(not(seen)) {
          add-edge!(f, b, t);
        };
      };
    };
  };
}

fn ret!(f: ref[Func], vals: ref[list[u32]]) -> void {
  bind {
    b = f.cur;
    n = len(read(vals));
    v = inst!(f, OP-RET, T-VOID, 0, 0);
  } {
    for i in range(0, n) {
      note-escape!(f, (read(vals))[i]);
      push-operand!(f, (read(vals))[i], typed[u32](0));
    };
    set-ops!(f, v, u32-of(n), u32-of(n));
    set (blk(f, b)).term = v;
  };
}

fn ret0!(f: ref[Func]) -> void {
  bind {
    b = f.cur;
    v = inst!(f, OP-RET, T-VOID, 0, 0);
  } {
    set (blk(f, b)).term = v;
  };
}

fn ret1!(f: ref[Func], x: u32) -> void {
  note-escape!(f, x);
  bind {
    b = f.cur;
    v = inst!(f, OP-RET, T-VOID, 0, 0);
  } {
    push-operand!(f, x, typed[u32](0));
    set-ops!(f, v, typed[u32](1), typed[u32](1));
    set (blk(f, b)).term = v;
  };
}

fn unreachable!(f: ref[Func]) -> void {
  bind {
    b = f.cur;
    v = inst!(f, OP-UNREACHABLE, T-VOID, 0, 0);
  } {
    set (blk(f, b)).term = v;
  };
}

# ---- calls ----
# A call: `target` is a symbol, or NONE with `callee` the pointer. `args` and
# `flags` are parallel. Results beyond the first become OP-CALLRES values;
# returns the call (its first result).
fn call!(f: ref[Func], target: u32, callee: u32, args: ref[list[u32]], flags: ref[list[u32]], rtypes: ref[list[u8]], tail: bool) -> u32 {
  if(tail, set f.has-tail-calls = true, set f.has-calls = true);
  bind {
    nr = len(read(rtypes));
    rty = if((nr > 0), as[i64]((read(rtypes))[0]), T-VOID);
    v = inst!(f, if(tail, OP-TAILCALL, OP-CALL), rty, if((target == none()), -1, i64-of(target)), 0);
    n = len(read(args));
  } {
    when((callee != none())) {
      push-operand!(f, callee, typed[u32](0));
    };
    for i in range(0, n) {
      note-escape!(f, (read(args))[i]);
      push-operand!(f, (read(args))[i], (read(flags))[i]);
    };
    bind {
      nops = (u32-of(n) + if((callee == none()), typed[u32](0), typed[u32](1)));
    } {
      set-ops!(f, v, nops, nops);
    };
    set (val(f, v)).aux = as[u8](nr);
    for i in range(1, nr) {
      bind {
        r = push-value!(f, OP-CALLRES, as[i64]((read(rtypes))[i]), (i - 1), 0);
      } {
        set (val(f, r)).block = v;
      };
    };
    when(tail) {
      set (blk(f, f.cur)).term = v;
    };
    v;
  };
}

# A call under a :shim convention (see OP-SHIMCALL).
fn shimcall!(f: ref[Func], target: u32, args: ref[list[u32]], regs: ref[list[u32]], ret-reg: u32, clobber: u64, bytes: span[u8], rty: i64) -> u32 {
  set f.has-calls = true;
  bind {
    v = inst!(f, OP-SHIMCALL, rty, if((target == none()), -1, i64-of(target)), as[i64](clobber));
    n = len(read(args));
  } {
    for i in range(0, n) {
      note-escape!(f, (read(args))[i]);
      push-operand!(f, (read(args))[i], (read(regs))[i]);
    };
    set-ops!(f, v, u32-of(n), u32-of(n));
    bind {
      x = val(f, v);
    } {
      set x.aux = as[u8](ret-reg);
      set x.block = u32-of(len(f.bytes));
      set x.next = u32-of(len(bytes));
    };
    for i in range(0, len(bytes)) {
      push!(borrow(f.bytes), (bytes)[i]);
    };
    v;
  };
}

# The i-th result of a call (0 is the call itself).
fn call-result(f: ref[Func], call: u32, i: i64) -> u32 {
  if((i == 0), call, (call + u32-of(i)));
}

# ============================ SSA construction ==============================
# A new variable of type `ty`.
fn new-var!(f: ref[Func], ty: i64) -> u32 {
  bind {
    v = u32-of(len(f.var-types));
  } {
    push!(borrow(f.var-types), as[u8](ty));
    push!(borrow(f.last-def), make VarDef {
      block = none();
      value = none();
    });
    v;
  };
}

fn def-key(var: u32, block: u32) -> u64 {
  ((as[u64](var) << typed[u64](32)) | as[u64](block));
}

# ---- the definition table (open addressing, linear probing) ----
fn defs-reset!(f: ref[Func]) -> void {
  set f.def-count = 0;
  set f.def-gen = (f.def-gen + typed[u32](1));
  when((f.def-gen == typed[u32](0))) {
    for i in range(0, len(f.def-slots)) {
      set (element(borrow(f.def-slots), i)).gen = typed[u32](0);
    };
    set f.def-gen = typed[u32](1);
  };
}

fn defs-home(f: ref[Func], k: u64) -> i64 {
  bind {
    h = (k * typed[u64](0x9E3779B97F4A7C15));
  } {
    (as[i64]((h >> typed[u64](32))) & (len(f.def-slots) - 1));
  };
}

fn defs-put!(f: ref[Func], k: u64, v: u32) -> void {
  bind {
    gen = f.def-gen;
    mask = (len(f.def-slots) - 1);
    var i = defs-home(f, k);
  } {
    while(((((f.def-slots)[i]).gen == gen) and (((f.def-slots)[i]).key != k))) {
      set i = ((i + 1) & mask);
    };
    bind {
      sl = element(borrow(f.def-slots), i);
    } {
      when((sl.gen != gen)) {
        set f.def-count = (f.def-count + 1);
      };
      set sl.key = k;
      set sl.value = v;
      set sl.gen = gen;
    };
  };
}

fn defs-grow!(f: ref[Func]) -> void {
  bind {
    gen = f.def-gen;
    old = len(f.def-slots);
    var live = list[DefSlot];
  } {
    for i in range(0, old) {
      bind {
        sl = (f.def-slots)[i];
      } {
        when((sl.gen == gen)) {
          push!(borrow(live), sl);
        };
      };
    };
    extend-zeroed!(borrow(f.def-slots), if((old == 0), 64, old));
    for i in range(0, len(f.def-slots)) {
      set (element(borrow(f.def-slots), i)).gen = typed[u32](0);
    };
    set f.def-count = 0;
    for i in range(0, len(live)) {
      bind {
        sl = (live)[i];
      } {
        defs-put!(f, sl.key, sl.value);
      };
    };
    free!(borrow(live));
  };
}

fn defs-set!(f: ref[Func], k: u64, v: u32) -> void {
  when((((f.def-count + 1) * 2) >= len(f.def-slots))) {
    defs-grow!(f);
  };
  defs-put!(f, k, v);
}

fn defs-get(f: ref[Func], k: u64) -> u32 {
  if((len(f.def-slots) == 0), none(), bind {
    gen = f.def-gen;
    mask = (len(f.def-slots) - 1);
    var i = defs-home(f, k);
  } {
    escape found {
      while((((f.def-slots)[i]).gen == gen)) {
        when((((f.def-slots)[i]).key == k)) {
          yield found(((f.def-slots)[i]).value);
        };
        set i = ((i + 1) & mask);
      };
      none();
    };
  });
}

fn write-var!(f: ref[Func], var: u32, block: u32, v: u32) -> void {
  bind {
    ld = element(borrow(f.last-def), i64-of(var));
  } {
    when(((ld.block != none()) and (ld.block != block))) {
      defs-set!(f, def-key(var, ld.block), ld.value);
    };
    set ld.block = block;
    set ld.value = v;
  };
}

fn def-var!(f: ref[Func], var: u32, v: u32) -> void {
  note-escape!(f, v);
  write-var!(f, var, f.cur, v);
}

fn lookup-def(f: ref[Func], var: u32, block: u32) -> u32 {
  bind {
    ld = (f.last-def)[i64-of(var)];
  } {
    if((ld.block == block), ld.value, defs-get(f, def-key(var, block)));
  };
}

fn new-phi!(f: ref[Func], block: u32, ty: i64) -> u32 {
  bind {
    v = push-value!(f, OP-PHI, ty, 0, 0);
    bb = blk(f, block);
    x = val(f, v);
  } {
    set x.block = block;
    set x.next = bb.phi-first;
    set bb.phi-first = v;
    v;
  };
}

fn resolve(f: ref[Func], v0: u32) -> u32 {
  bind {
    var v = v0;
  } {
    while(((f.fwd)[i64-of(v)] != none())) {
      set v = (f.fwd)[i64-of(v)];
    };
    v;
  };
}

fn undef!(f: ref[Func], ty: i64) -> u32 {
  choose {
    (ty == T-I128) => const!(f, T-I128, typed[u64](0), typed[u64](0));
    (ty == T-F32) => const!(f, T-F32, typed[u64](0), typed[u64](0));
    (ty == T-F64) => const!(f, T-F64, typed[u64](0), typed[u64](0));
    (ty == T-V128) => const!(f, T-V128, typed[u64](0), typed[u64](0));
    else => iconst!(f, 0);
  };
}

# Whether the PHI's operands are all itself or one other value; forwards it then.
fn try-remove-trivial-phi!(f: ref[Func], phi: u32) -> u32 {
  bind {
    x = val(f, phi);
    n = x.nops;
    var same = none();
    var trivial = true;
  } {
    for i in range(0, i64-of(n)) {
      bind {
        op = resolve(f, operand(f, x, u32-of(i)));
      } {
        when((trivial and (op != phi) and (op != same))) {
          if((same != none()), set trivial = false, set same = op);
        };
      };
    };
    if(not(trivial), phi, bind {
      s = if((same == none()), undef!(f, as[i64]((val(f, phi)).ty)), same);
    } {
      put(borrow(f.fwd), i64-of(phi), s);
      s;
    });
  };
}

fn add-phi-operands!(f: ref[Func], var: u32, phi: u32) -> u32 {
  bind {
    block = (val(f, phi)).block;
    bb = read(blk(f, block));
    n = bb.npred;
    opb = u32-of(len(f.operands));
  } {
    for _ in range(0, (2 * i64-of(n))) {
      push-operand!(f, typed[u32](0), typed[u32](0));
    };
    bind {
      x = val(f, phi);
    } {
      set x.opb = opb;
      set x.nops = n;
      set x.ntotal = (typed[u32](2) * n);
    };
    bind {
      var e = bb.pred-first;
      var i = typed[u32](0);
    } {
      while((e != none())) {
        bind {
          edge = (f.edges)[i64-of(e)];
          v = read-var!(f, var, edge.from);
        } {
          put(borrow(f.operands), i64-of((opb + i)), v);
          put(borrow(f.operands), i64-of(((opb + n) + i)), edge.from);
          set i = (i + typed[u32](1));
          set e = edge.next;
        };
      };
    };
    try-remove-trivial-phi!(f, phi);
  };
}

fn read-var-recursive!(f: ref[Func], var: u32, block: u32) -> u32 {
  bind {
    bb = read(blk(f, block));
    ty = as[i64]((f.var-types)[i64-of(var)]);
    v = choose {
      not(bb.sealed) => bind {
        phi = new-phi!(f, block, ty);
      } {
        push!(borrow(f.incomplete), make IncompletePhi {
          block = block;
          var = var;
          phi = phi;
        });
        phi;
      };
      (bb.npred == typed[u32](1)) => read-var!(f, var, ((f.edges)[i64-of(bb.pred-first)]).from);
      (bb.npred == typed[u32](0)) => undef!(f, ty);
      else => bind {
        phi = new-phi!(f, block, ty);
      } {
        write-var!(f, var, block, phi);
        add-phi-operands!(f, var, phi);
      };
    };
  } {
    write-var!(f, var, block, v);
    v;
  };
}

fn read-var!(f: ref[Func], var: u32, block: u32) -> u32 {
  bind {
    d = lookup-def(f, var, block);
  } {
    if((d != none()), resolve(f, d), read-var-recursive!(f, var, block));
  };
}

# The current value of `var` in the current block.
fn use-var!(f: ref[Func], var: u32) -> u32 {
  read-var!(f, var, f.cur);
}

# All predecessors of `b` are known.
fn seal!(f: ref[Func], b: u32) -> void {
  when(not((blk(f, b)).sealed)) {
    bind {
      var i = 0;
    } {
      while((i < len(f.incomplete))) {
        bind {
          ip = (f.incomplete)[i];
        } {
          if((ip.block == b), do {
            add-phi-operands!(f, ip.var, ip.phi);
            bind {
              last = (len(f.incomplete) - 1);
            } {
              put(borrow(f.incomplete), i, (f.incomplete)[last]);
              pop!(borrow(f.incomplete));
            };
          }, set i = (i + 1));
        };
      };
    };
    set (blk(f, b)).sealed = true;
  };
}

# Finish construction: seal every block, remove trivial PHIs to a fixpoint,
# rewrite operands through forwards and lay out each block's PHIs.
# Instructions with no effect besides their result.
fn pure-op?(op: i64) -> bool {
  (((op >= OP-ADD) and (op <= OP-ASHR)) or ((op >= OP-ROTL) and (op <= OP-SELECT)) or ((op >= OP-ADDO) and (op <= OP-BITREV)) or ((op >= OP-FADD) and (op <= OP-COPY)) or (op == OP-PTRADD) or (op == OP-ADDI));
}

# Remove pure instructions whose results are unused (address arithmetic the
# access folded, results lowering computed and dropped), and with them uses
# that kept others alive.
# Instructions the isel compiles to a call of a runtime function: the
# function is not a leaf.
fn runtime-call-op?(x: ref[Value]) -> bool {
  bind {
    op = as[i64](x.op);
  } {
    ((op == OP-MEMCPYV) or (op == OP-MEMMOVEV) or (op == OP-MEMSETV) or ((op >= OP-SDIV) and (op <= OP-UREM) and (as[i64](x.ty) == T-I128)));
  };
}

# Compact instructions marked dead, preserving block ranges and moving
# source debug marks to the next surviving instruction in the same block.
fn compact-dead!(f: ref[Func]) -> void {
  bind {
    var out = f.scratch-insts;
    var moved = list[u32];
  } {
    clear!(borrow(out));
    for b in range(0, len(f.blocks)) {
      bind {
        bb = blk(f, u32-of(b));
        lo = i64-of(bb.ibegin);
        hi = i64-of(bb.iend);
        var pending = len(moved);
      } {
        set bb.ibegin = u32-of(len(out));
        for j in range(lo, hi) {
          bind {
            v = (f.insts)[j];
            x = val(f, v);
          } {
            if(((x.flags & typed[u8](8)) == typed[u8](0)), do {
              push!(borrow(out), v);
              when((pending < len(moved))) {
                set x.flags = (x.flags | typed[u8](0x20));
                for k in range(pending, len(moved)) {
                  when(((k % 2) == 1)) {
                    put(borrow(moved), k, v);
                  };
                };
                set pending = len(moved);
              };
            }, when(((x.flags & typed[u8](0x20)) != typed[u8](0))) {
              push!(borrow(moved), v);
              push!(borrow(moved), none());
            });
          };
        };
        set bb.iend = u32-of(len(out));
      };
    };
    when((len(moved) > 0)) {
      for m in range(0, len(f.mark-insts)) {
        bind {
          mv = (f.mark-insts)[m];
        } {
          for k in range(0, (len(moved) / 2)) {
            when(((moved)[(k * 2)] == mv)) {
              put(borrow(f.mark-insts), m, (moved)[((k * 2) + 1)]);
            };
          };
        };
      };
    };
    free!(borrow(moved));
    set f.scratch-insts = f.insts;
    set f.insts = out;
  };
}

fn drop-dead!(f: ref[Func]) -> void {
  bind {
    nv = len(f.values);
    var uses = f.scratch-uses;
  } {
    clear!(borrow(uses));
    extend-zeroed!(borrow(uses), nv);
    for vi in range(0, nv) {
      bind {
        x = val(f, u32-of(vi));
      } {
        when(((as[i64](x.op) != OP-CONST) and ((f.fwd)[vi] == none()))) {
          for k in range(0, i64-of(x.nops)) {
            bind {
              o = i64-of((f.operands)[(i64-of(x.opb) + k)]);
            } {
              put(borrow(uses), o, ((uses)[o] + typed[u32](1)));
            };
          };
        };
      };
    };
    for i in range(0, len(f.args)) {
      bind {
        a = i64-of((f.args)[i]);
      } {
        put(borrow(uses), a, ((uses)[a] + typed[u32](1)));
      };
    };
    for i in range(0, len(f.insts)) {
      when(runtime-call-op?(val(f, (f.insts)[i]))) {
        set f.has-calls = true;
      };
    };
    bind {
      var dead = 0;
      ni = len(f.insts);
      var i = (ni - 1);
    } {
      while((i >= 0)) {
        bind {
          v = (f.insts)[i];
          x = val(f, v);
        } {
          when((pure-op?(as[i64](x.op)) and ((uses)[i64-of(v)] == typed[u32](0)))) {
            set x.flags = (x.flags | typed[u8](8));
            set dead = (dead + 1);
            for k in range(0, i64-of(x.nops)) {
              bind {
                o = i64-of((f.operands)[(i64-of(x.opb) + k)]);
              } {
                put(borrow(uses), o, ((uses)[o] - typed[u32](1)));
              };
            };
          };
        };
        set i = (i - 1);
      };
      set f.scratch-uses = uses;
      when((dead > 0)) {
        compact-dead!(f);
      };
    };
  };
}

# Whether the function calls anything, runtime calls its instructions
# become included (before finish!, which marks those).
fn calls-anything?(f: ref[Func]) -> bool {
  (f.has-calls or bind {
    var r = false;
  } {
    for i in range(0, len(f.insts)) {
      when(runtime-call-op?(val(f, (f.insts)[i]))) {
        set r = true;
      };
    };
    r;
  });
}

# Remove the stores whose address is alloca `a`, and `a` itself (debug info
# dropping a frame only it would need).
fn drop-alloca!(f: ref[Func], a: u32) -> void {
  bind {
    var out = f.scratch-insts;
  } {
    clear!(borrow(out));
    for b in range(0, len(f.blocks)) {
      bind {
        bb = blk(f, u32-of(b));
        lo = i64-of(bb.ibegin);
        hi = i64-of(bb.iend);
      } {
        set bb.ibegin = u32-of(len(out));
        for j in range(lo, hi) {
          bind {
            v = (f.insts)[j];
            x = val(f, v);
          } {
            unless(((as[i64](x.op) == OP-STORE) and (operand(f, x, typed[u32](0)) == a))) {
              push!(borrow(out), v);
            };
          };
        };
        set bb.iend = u32-of(len(out));
      };
    };
    set f.scratch-insts = f.insts;
    set f.insts = out;
  };
  bind {
    var k = 0;
  } {
    for i in range(0, len(f.allocas)) {
      bind {
        v = (f.allocas)[i];
      } {
        when((v != a)) {
          set (val(f, v)).next = u32-of(k);
          put(borrow(f.allocas), k, v);
          set k = (k + 1);
        };
      };
    };
    truncate(borrow(f.allocas), k);
  };
}

# Collapse a private aggregate snapshot into an overlap-safe transfer.
# Exact two-use ownership and adjacent effects are required: an escaped,
# partial, reused or cross-block temporary is never rewritten.
fn fuse-snapshots!(f: ref[Func]) -> void {
  when((len(f.allocas) > 0)) {
    bind {
      var uses = f.scratch-uses;
      var removed = 0;
    } {
      clear!(borrow(uses));
      extend-zeroed!(borrow(uses), len(f.values));
      for vi in range(0, len(f.values)) {
        bind {
          x = val(f, u32-of(vi));
        } {
          when(((f.fwd)[vi] == none())) {
            for k in range(0, i64-of(x.nops)) {
              bind {
                v = i64-of(operand(f, x, u32-of(k)));
              } {
                put(borrow(uses), v, ((uses)[v] + typed[u32](1)));
              };
            };
          };
        };
      };
      for b in range(0, len(f.blocks)) {
        bind {
          bb = read(blk(f, u32-of(b)));
          var j = i64-of(bb.ibegin);
        } {
          while(((j + 1) < i64-of(bb.iend))) {
            bind {
              first = (f.insts)[j];
              second = (f.insts)[(j + 1)];
              x = read(val(f, first));
              y = read(val(f, second));
              op = as[i64](x.op);
            } {
              when((((op == OP-MEMCPY) or (op == OP-MEMZERO)) and (as[i64](y.op) == OP-MEMCPY) and (x.imm > 0) and (x.imm == y.imm))) {
                bind {
                  temporary = operand(f, val(f, first), typed[u32](0));
                  slot = read(val(f, temporary));
                } {
                  when(((as[i64](slot.op) == OP-ALLOCA) and (slot.imm == x.imm) and ((uses)[i64-of(temporary)] == typed[u32](2)) and (operand(f, val(f, second), typed[u32](1)) == temporary))) {
                    bind {
                      destination = operand(f, val(f, second), typed[u32](0));
                      source = if((op == OP-MEMZERO), iconst!(f, 0), operand(f, val(f, first), typed[u32](1)));
                      count = iconst!(f, x.imm);
                      begin = u32-of(len(f.operands));
                    } {
                      push-operand!(f, destination, typed[u32](0));
                      push-operand!(f, source, typed[u32](0));
                      push-operand!(f, count, typed[u32](0));
                      bind {
                        replacement = val(f, second);
                        dead = val(f, first);
                      } {
                        set replacement.op = as[u8](if((op == OP-MEMZERO), OP-MEMSETV, OP-MEMMOVEV));
                        set replacement.opb = begin;
                        set replacement.nops = typed[u32](3);
                        set replacement.ntotal = typed[u32](3);
                        set replacement.imm = 0;
                        set replacement.imm2 = 0;
                        set dead.flags = (dead.flags | typed[u8](8));
                        set dead.nops = typed[u32](0);
                        set dead.ntotal = typed[u32](0);
                      };
                      put(borrow(uses), i64-of(temporary), none());
                      set removed = (removed + 1);
                    };
                  };
                };
              };
            };
            set j = (j + 1);
          };
        };
      };
      when((removed > 0)) {
        set f.has-calls = true;
        compact-dead!(f);
        bind {
          var kept = 0;
        } {
          for temporary in f.allocas {
            unless(((uses)[i64-of(temporary)] == none())) {
              set (val(f, temporary)).next = u32-of(kept);
              put(borrow(f.allocas), kept, temporary);
              set kept = (kept + 1);
            };
          };
          truncate(borrow(f.allocas), kept);
        };
      };
      set f.scratch-uses = uses;
    };
  };
}

fn finish!(f: ref[Func]) -> void {
  for b in range(0, len(f.blocks)) {
    seal!(f, u32-of(b));
  };
  bind {
    var changed = true;
  } {
    while(changed) {
      set changed = false;
      for b in range(0, len(f.blocks)) {
        bind {
          var p = (blk(f, u32-of(b))).phi-first;
        } {
          while((p != none())) {
            bind {
              next = (val(f, p)).next;
            } {
              when(((f.fwd)[i64-of(p)] == none())) {
                when((try-remove-trivial-phi!(f, p) != p)) {
                  set changed = true;
                };
              };
              set p = next;
            };
          };
        };
      };
    };
  };
  for vi in range(0, len(f.values)) {
    bind {
      x = val(f, u32-of(vi));
    } {
      for k in range(0, i64-of(x.nops)) {
        bind {
          at = (i64-of(x.opb) + k);
          o = (f.operands)[at];
        } {
          when(((f.fwd)[i64-of(o)] != none())) {
            put(borrow(f.operands), at, resolve(f, o));
          };
        };
      };
    };
  };
  drop-dead!(f);
  clear!(borrow(f.phis));
  for b in range(0, len(f.blocks)) {
    bind {
      bb = blk(f, u32-of(b));
      begin = u32-of(len(f.phis));
    } {
      bind {
        var p = bb.phi-first;
      } {
        while((p != none())) {
          when(((f.fwd)[i64-of(p)] == none())) {
            push!(borrow(f.phis), p);
          };
          set p = (val(f, p)).next;
        };
      };
      bind {
        n = (len(f.phis) - i64-of(begin));
      } {
        for i in range(0, (n / 2)) {
          bind {
            a = (i64-of(begin) + i);
            z = ((i64-of(begin) + (n - 1)) - i);
            t = (f.phis)[a];
          } {
            put(borrow(f.phis), a, (f.phis)[z]);
            put(borrow(f.phis), z, t);
          };
        };
      };
      set bb.phi-begin = begin;
      set bb.phi-count = (u32-of(len(f.phis)) - begin);
    };
  };
}
