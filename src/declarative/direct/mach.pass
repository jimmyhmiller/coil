# Machine code as it is written: the sink the templates and rules write
# instructions to, with machine registers already chosen. The instruction
# just written is held back one step, so that what a template marks it as
# can still change it: a copy to the register it reads, or a jump to the code
# that comes next, is no instruction at all. Labels are numbered; a branch to
# one not yet placed is written with no distance and put right when the body
# is done. The frame is opened, and each way out closes it, once the body is
# written, so the body comes first and the opening is put in front of it.
pass in unit
import target as isa

entity Label
column at: Label -> Int                # where its code starts in the body, + 1, once placed

state emitting-from: Int               # where in the source what is being written comes from
state object-bytes: Int                # bytes of frame objects, a multiple of 16
state out-slots: Int                   # frame slots for arguments passed on the stack
state calls: Bool                      # the function calls another
state dynamic: Bool                    # the function moves the stack pointer as it runs
state pinned-writes: Word              # registers that calls following no convention may write
state next-label: Label                # the label of the code that follows what is being written

state held: Bool                       # an instruction is held back
state held-op: Int
state held-a0: Int
state held-a1: Int
state held-a2: Int
state held-a3: Int
state held-a4: Int
state held-from: Int
state held-encoded: Bool               # what is held is a finished word, of an instruction
state held-word: Word                  # with no label or symbol

state into: Int                        # 0 the body, 1 a patch, 2 the opening
state body: [Byte]
state patch: [Byte]
state code: [Byte]
state patch-base: Int                  # where in the body the patch being written goes
state last-from: Int
state fix-at: [Int]                    # instructions whose label was not yet placed: where,
state fix-op: [Int]                    # and the instruction again
state fix-a0: [Int]
state fix-a1: [Int]
state fix-a2: [Int]
state fix-a3: [Int]
state fix-a4: [Int]
state reloc-at: [Int]                  # the words that depend on a symbol's address,
state reloc-symbol: [Int]              # the symbol,
state reloc-op: [Int]                  # and the instruction there
state row-at: [Int]                    # where in the code what is computed starts to come from
state row-from: [Int]                  # somewhere else in the source, and from where
state code-bytes: Int
setting rows: Bool                     # where in the source each piece of code comes from is kept

# Registers a template asks for (`$t`): free ones, given back when what asked
# is done.
state occupied: Word                   # the registers that hold a value
state busy: Word                       # registers the instruction being written reads or writes
state forbidden: Word                  # registers the instruction being written writes by name
state temps: Word                      # registers given as temporaries, until `done-temps`
state used: Word                       # every register given to anything
state temp-class-regs: Word            # the registers a temporary may be

fn reg-kind?(kind: Int) -> Bool = kind == isa.K-DEF or kind == isa.K-USE or kind == isa.K-MOD

fn pick(k: Int, a0: Int, a1: Int, a2: Int, a3: Int, a4: Int) -> Int =
  if k == 0 then a0 else if k == 1 then a1 else if k == 2 then a2 else if k == 3 then a3 else a4

fn without(a: Word, b: Word) -> Word = a & (b ^ word(-1))

# ---------------------------------------------------------------- what templates call

inline fn emit(op: Int, a: Int, b: Int, c: Int, d: Int, e: Int) {
  release()
  held = true
  held-encoded = false
  held-op = op
  held-a0 = a
  held-a1 = b
  held-a2 = c
  held-a3 = d
  held-a4 = e
  held-from = emitting-from
}

# An instruction already encoded, which names no label and no symbol: what a
# template or a rule writes when it knows which instruction it is.
inline fn emit-word(op: Int, w: Word) {
  release()
  held = true
  held-encoded = true
  held-op = op
  held-word = w
  held-from = emitting-from
}

# A register of a template's own: a free general register, kept from values
# until the template's caller says it is done.
fn fresh() -> Int {
  let open = without(temp-class-regs, occupied | busy | forbidden | temps)
  if open == word(0) { panic("no register is free for what a template needs") }
  let r = lowest-bit(open)
  temps = set-bit(temps, r)
  used = set-bit(used, r)
  0 - r - 1
}

fn done-temps() {
  temps = word(0)
}

# The instruction just written copies `s` to `d`: if they are one register,
# it is nothing.
fn mark-copy(d: Int, s: Int) {
  if held and d == s { held = false }
}

# It only goes to its label: if that is what comes next, it is nothing.
fn mark-jump() {
  if held and not held-encoded and next-label != none {
    for k in 0..isa.operand-count(held-op) {
      if isa.operand-kind(held-op, k) == isa.K-LABEL and pick(k, held-a0, held-a1, held-a2, held-a3, held-a4) == int(next-label) { held = false }
    }
  }
}

fn mark-return() {
}

# Frame objects far from the frame record are reached by the rules of this
# compile themselves.
fn mark-object(kind: Int, r: Int, below: Int, bytes: Int) {
  panic("a template that reads or writes a frame object as the frame is laid out")
}

# ---------------------------------------------------------------- writing bytes

fn symbol-of(op: Int, a0: Int, a1: Int, a2: Int, a3: Int, a4: Int) -> Int {
  for k in 0..isa.operand-count(op) {
    if isa.operand-kind(op, k) == isa.K-SYMBOL { return pick(k, a0, a1, a2, a3, a4) }
  }
  0
}

fn row(from: Int) {
  if rows and into == 0 and from != 0 and from != last-from {
    row-at.push(body.len)
    row-from.push(from)
    last-from = from
  }
}

fn put(op: Int, a0: Int, a1: Int, a2: Int, a3: Int, a4: Int) {
  let here = if into == 0 then body.len else if into == 1 then patch-base + patch.len else code.len
  let mask = isa.operand-mask(op)
  var c0 = code-of(mask, 0, a0)
  var c1 = code-of(mask, 1, a1)
  var c2 = code-of(mask, 2, a2)
  var c3 = code-of(mask, 3, a3)
  var c4 = code-of(mask, 4, a4)
  # The label's operand: how far it is, if it is placed.
  let l = mask / 65536 - 1
  var ahead = false
  if l >= 0 {
    let to: Label = id(pick(l, a0, a1, a2, a3, a4))
    let d = if to.at > 0 then to.at - 1 - here else 0
    ahead = to.at == 0
    if l == 0 { c0 = d } else if l == 1 { c1 = d } else if l == 2 { c2 = d } else if l == 3 { c3 = d } else { c4 = d }
  }
  let field = if into == 0 then isa.encode!(mut body, op, c0, c1, c2, c3, c4)
              else if into == 1 then isa.encode!(mut patch, op, c0, c1, c2, c3, c4)
              else isa.encode!(mut code, op, c0, c1, c2, c3, c4)
  # A symbol's bits are filled in when the code is given addresses.
  if field >= 0 {
    if into != 0 { panic("only the body names symbols") }
    reloc-at.push(here + field)
    reloc-symbol.push(symbol-of(op, a0, a1, a2, a3, a4))
    reloc-op.push(op)
  }
  if into == 0 and ahead {
    fix-at.push(here)
    fix-op.push(op)
    fix-a0.push(a0)
    fix-a1.push(a1)
    fix-a2.push(a2)
    fix-a3.push(a3)
    fix-a4.push(a4)
  }
}

# Operand `k`, as the encoder wants it, by what `mask` (isa.operand-mask)
# says it is: a register's number; nothing yet for a symbol; else itself.
fn code-of(mask: Int, k: Int, a: Int) -> Int =
  if has-bit(word(mask), k) then 0 - a - 1 else if has-bit(word(mask), k + 8) then 0 else a

# The instruction held back, written.
inline fn release() {
  if held {
    held = false
    row(held-from)
    if held-encoded {
      if into == 0 { isa.put-word!(mut body, held-word) }
      else if into == 1 { isa.put-word!(mut patch, held-word) }
      else { isa.put-word!(mut code, held-word) }
    }
    else { put(held-op, held-a0, held-a1, held-a2, held-a3, held-a4) }
  }
}

# Label `l` is here.
fn place(l: Label) {
  release()
  l.at = body.len + 1
}

fn new-label() -> Label = Label.new()

# The branch just written, turned to go the other way to `to`: its opposite
# instruction, or itself with the operand that says which way turned. Whether
# it is a branch that can be turned is `turns?`.
fn turns?() -> Bool = held and not held-encoded and (isa.opposite-op(held-op) != 0 or isa.opposite-turn(held-op) >= 0)

fn held-label() -> Int {
  if not held or held-encoded { return 0 }
  for k in 0..isa.operand-count(held-op) {
    if isa.operand-kind(held-op, k) == isa.K-LABEL { return pick(k, held-a0, held-a1, held-a2, held-a3, held-a4) }
  }
  0
}

fn turn(to: Label) {
  let op = held-op
  let turn = isa.opposite-turn(op)
  var x0 = held-a0
  var x1 = held-a1
  var x2 = held-a2
  for k in 0..3 {
    if k < isa.operand-count(op) and isa.operand-kind(op, k) == isa.K-LABEL {
      if k == 0 { x0 = int(to) }
      if k == 1 { x1 = int(to) }
      if k == 2 { x2 = int(to) }
    }
  }
  if turn == 0 { x0 = if x0 % 2 == 0 then x0 + 1 else x0 - 1 }
  if turn == 1 { x1 = if x1 % 2 == 0 then x1 + 1 else x1 - 1 }
  if turn == 2 { x2 = if x2 % 2 == 0 then x2 + 1 else x2 - 1 }
  held-op = if isa.opposite-op(op) != 0 then isa.opposite-op(op) else op
  held-a0 = x0
  held-a1 = x1
  held-a2 = x2
}

# Branches to labels that were not yet placed, put right.
fn fix() {
  release()
  into = 1
  for j in 0..fix-at.len {
    patch.clear()
    patch-base = fix-at[j]
    put(fix-op[j], fix-a0[j], fix-a1[j], fix-a2[j], fix-a3[j], fix-a4[j])
    for q in 0..patch.len { body[fix-at[j] + q] = patch[q] }
  }
  into = 0
}

# Writing to the opening: what the frame opening's templates write goes in
# front of the body.
fn opening() {
  release()
  into = 2
  code.clear()
}

# The opening, then the body; places in the body move by the opening's length.
fn assemble() {
  release()
  let shift = code.len
  code.extend(body)
  for j in 0..reloc-at.len { reloc-at[j] = reloc-at[j] + shift }
  for j in 0..row-at.len { row-at[j] = row-at[j] + shift }
  code-bytes = code.len
  into = 0
}
