# Registers and frame slots for values, chosen as the code is written: what
# the rules of a `.select` file ask for as they compute an instruction.
#
# A value read or written in more than one block lives in a frame slot: it is
# stored there when it is computed, and a block that reads it loads it where
# it first needs it, so every register is free where a block starts. Inside a
# block a value keeps its register until its last use there, counted as the
# block begins. When no register is free, the value used furthest off in the
# block gives its register up, to its slot. A constant, a symbol's address or
# a stack variable's is no register's: it is made again wherever it is read.
pass in unit
use mach as mach
use lower as lower
use frames as frames
import target as isa
import abi as abi

column home: Value -> Block            # the block it is computed in
column shared: Value -> Bool           # read in another block (a phi always): it lives in its slot
column uses: Value -> Int32            # how many operands name it, in the whole function
column left: Value -> Int32            # how many operands of the block being written still read it
column last-use: Value -> Int32        # where in the block it is last read, for choosing what gives way
column across: Value -> Bool           # alive over a call in its block
column folded: Value -> Bool           # computed in place by the instruction that reads it,
column folder: Value -> Value          # that instruction
column rule: Value -> Int32            # the rule chosen for it
column reg: Value -> Int8              # the register + 1 it is in; 0 if none
column slot: Value -> Int32            # its frame slot + 1, once it has one
column clean: Value -> Bool            # its slot holds what its register does
column object-at: Value -> Int32       # a stack variable's distance below the frame record
column fixed: Value -> Int8             # the register + 1 it keeps wherever it is alive; 0 if none
column high: Value -> Int8             # a 128-bit value's high half: the register + 1 it is in; 0 if none
column hint: Value -> Int8             # the register + 1 its last reader wants it in; 0 if none
column outside: Value -> Bool          # a symbol from outside the image: reached through its table of
                                       # addresses (whoever compiles says)

state holder: [Int]                    # for each machine register, the value it holds, or 0
state slots: Int
state class-regs: [Word]               # the registers values may be given, by class
state reserved: Word                   # the registers values keep wherever they are alive
state folds: [Int]                     # the values computed in place, as each was folded
state given-high: Int                  # where a 128-bit value made in registers its reader chose keeps its high half
state with-frame: Bool                 # the body is written expecting a frame
state rewrite: Bool                    # it needed one after all: the body is written again
state labels: [Int]                    # the labels a branch being written goes to, by target

fn marker(r: Int) -> Int = 0 - r - 1

fn without(a: Word, b: Word) -> Word = a & (b ^ word(-1))

fn allocatable?(r: Int) -> Bool = isa.in-set?(isa.ALLOCATABLE, r) and not (dynamic and r == abi.BASE)

# A 128-bit value: two words, in two registers, or two words of its slot.
fn wide?(v: Value) -> Bool = v.type == I128

# Which kind of register a value lives in.
fn class-of(v: Value) -> Int = if v.float then 1 else 0

# A value made again wherever it is read.
fn remade?(v: Value) -> Bool = v is CONST or v is SYM or v is ALLOCA

fn setup() {
  let usable = without(isa.ALLOCATABLE, reserved | (if dynamic then set-bit(word(0), abi.BASE) else word(0)))
  class-regs.clear()
  class-regs.push(usable & isa.class-registers(0))
  class-regs.push(usable & isa.class-registers(1))
  temp-class-regs = class-regs[0]
  holder.zeros(isa.REGISTERS)
}

# ---------------------------------------------------------------- registers

fn give(v: Value, r: Int) {
  v.reg = r + 1
  holder[r] = int(v)
  occupied = set-bit(occupied, r)
  used = set-bit(used, r)
  # A register the caller expects back is saved where the frame opens.
  if not with-frame and isa.in-set?(isa.CALLEE-SAVED, r) { rewrite = true }
}

# A 128-bit value's high half into register `r`.
fn give-high(v: Value, r: Int) {
  v.high = r + 1
  holder[r] = int(v)
  occupied = set-bit(occupied, r)
  used = set-bit(used, r)
  if not with-frame and isa.in-set?(isa.CALLEE-SAVED, r) { rewrite = true }
}

# The value in register `r` lets go of its registers: both, for a 128-bit one.
fn free(r: Int) {
  let v: Value = id(holder[r])
  let lo = v.reg - 1
  holder[lo] = 0
  occupied = clear-bit(occupied, lo)
  busy = clear-bit(busy, lo)
  v.reg = 0
  if v.high != 0 {
    let hi = v.high - 1
    holder[hi] = 0
    occupied = clear-bit(occupied, hi)
    busy = clear-bit(busy, hi)
    v.high = 0
  }
}

# The register of the high half of 128-bit value `v`, which a rule has read
# or is writing; with `given`, the one its reader chose.
fn high(v: Value) -> Int {
  if v.high == 0 { panic("the high half of a 128-bit value is in no register") }
  marker(v.high - 1)
}

fn high-out(v: Value, given: Int) -> Int = if given != 0 then given-high else high(v)

# The high half of 128-bit value `v`, just read for a rule: in its register,
# or for one made where it is read, in the temporary it was made in.
fn read-high(v: Value) -> Int = if remade?(v) then given-high else high(v)

fn set-given-high(r: Int) {
  given-high = r
}

# Where `v`'s slot is, as a word above the stack pointer: given one if it has none.
fn slot-of(v: Value) -> Int {
  if v.slot == 0 {
    slots = slots + (if wide?(v) then 2 else 1)
    v.slot = slots - (if wide?(v) then 1 else 0)
    if not with-frame { rewrite = true }
  }
  out-slots + v.slot - 1
}

fn store(v: Value) {
  frames.keep(v.reg - 1, slot-of(v), false)
  if v.high != 0 { frames.keep(v.high - 1, slot-of(v) + 1, false) }
  v.clean = true
}

# `v` from its slot into register `r`. Blocks are written in the function's
# order, which need not put a value's block before every block that reads it:
# the slot is given at whichever comes first.
fn load-into(v: Value, r: Int) {
  frames.fetch(r, slot-of(v), false)
}

# The register `r` gives up its value, which goes to its slot unless the slot
# already holds it or nothing reads it again.
fn spill(r: Int) {
  let w: Value = id(holder[r])
  if not w.clean and (w.left > 0 or w.shared) { store(w) }
  free(r)
}

# A register of class `c`, none of `avoid`: a free one, those in `prefer`
# first; else the one whose value is wanted furthest off in the block, a
# value its slot already holds before one that has to be stored.
fn take(c: Int, avoid: Word, prefer: Word) -> Int {
  let can = without(class-regs[c], avoid | busy | forbidden | temps)
  let open = without(can, occupied)
  if open & prefer != word(0) { return lowest-bit(open & prefer) }
  # For a value no call is made across, one the caller does not expect back
  # next, which costs no saving where the frame opens.
  if prefer & isa.CALLEE-SAVED == word(0) and open & isa.CALLER-SAVED != word(0) {
    return lowest-bit(open & isa.CALLER-SAVED)
  }
  if open != word(0) { return lowest-bit(open) }
  var best = -1
  var furthest = -1
  var rest = can & occupied
  while rest != word(0) {
    let r = lowest-bit(rest)
    rest = clear-bit(rest, r)
    let w: Value = id(holder[r])
    let score = if w.clean then w.last-use + 1073741824 else w.last-use
    if score > furthest {
      furthest = score
      best = r
    }
  }
  if best < 0 { panic("register allocation: every register is needed at once") }
  spill(best)
  best
}

# Whether register `r` of class `c` is free to be given.
fn open?(r: Int, c: Int) -> Bool =
  has-bit(without(class-regs[c], occupied | busy | forbidden | temps), r)

# Registers values prefer: those no call or argument needs, unless the value
# lives across a call, which prefers one the callee keeps.
fn preferred(across: Bool) -> Word =
  if across then isa.CALLEE-SAVED else without(isa.CALLER-SAVED, abi.ARGUMENTS)

# ---------------------------------------------------------------- what rules ask

# The register `v` is in, for an instruction to read: loaded from its slot if
# it is not in one. It stays this instruction's until the instruction is done.
inline fn read(v: Value) -> Int {
  if v.reg == 0 {
    if remade?(v) { panic("a constant, symbol or stack variable is read as a register outside its own rule") }
    let r = take(class-of(v), word(0), preferred(false))
    load-into(v, r)
    give(v, r)
    if wide?(v) {
      busy = set-bit(busy, r)
      let r2 = take(0, word(0), preferred(false))
      frames.fetch(r2, slot-of(v) + 1, false)
      give-high(v, r2)
    }
    v.clean = true
  }
  busy = set-bit(busy, v.reg - 1)
  if v.high != 0 { busy = set-bit(busy, v.high - 1) }
  marker(v.reg - 1)
}

# One read of `v` is done: after its last in the block, its register is free,
# and free for what the instruction writes. A value read in more than one
# region is kept in its slot as well: its register, which always holds what
# the slot does, stays its own until another value wants it or the region
# ends, and nothing counts its reads.
# (A constant, symbol or stack variable is in no register: its count goes
# down to no effect.)
inline fn done(v: Value) {
  if v.shared { return }
  v.left = v.left - 1
  if v.left <= 0 and v.reg != 0 and v.fixed == 0 { free(v.reg - 1) }
}

# A register for `v`'s value.
inline fn write(v: Value) -> Int {
  if v.reg != 0 { return marker(v.reg - 1) }
  let h = v.hint - 1
  let r = if h >= 0 and not v.across and open?(h, class-of(v)) then h else take(class-of(v), word(0), preferred(v.across))
  give(v, r)
  busy = set-bit(busy, r)
  if wide?(v) {
    let r2 = take(0, word(0), preferred(v.across))
    give-high(v, r2)
    busy = set-bit(busy, r2)
  }
  marker(r)
}

# A register of class `c` for a rule's own use, until the rule is done.
fn temp(c: Int) -> Int {
  let r = take(c, word(0), preferred(false))
  temps = set-bit(temps, r)
  used = set-bit(used, r)
  marker(r)
}

# `v`'s instructions are written: its value goes to its slot if another block
# reads it, and its register is let go if nothing reads it. With `given`, it
# was made into a register its reader chose, and is that reader's.
inline fn finish(v: Value, given: Int) {
  if given != 0 { return }
  v.clean = false
  if v.reg != 0 and v.fixed == 0 {
    if v.shared { store(v) }
    else if v.left <= 0 { free(v.reg - 1) }
  }
  busy = word(0)
  forbidden = word(0)
  mach.done-temps()
}

# The machine registers the rule about to be written writes by name: a value
# in one of them moves to another register, or to its slot, and none of them
# is given to anything until the rule is done.
inline fn clobbers(set: Word) {
  clobbers-but(set, word(0))
}

# The same, but for the registers of `keep`, whose values the rule reads for
# the last time and are moved by it.
fn clobbers-but(set: Word, keep: Word) {
  let mask = set & isa.ALLOCATABLE
  if mask & reserved != word(0) { panic("a register a value keeps for its whole life is written by name") }
  var hit = without(occupied & mask, keep)
  while hit != word(0) {
    let r = lowest-bit(hit)
    hit = clear-bit(hit, r)
    # (The other half of a 128-bit value rescued already went with it.)
    if has-bit(occupied, r) { rescue(r, mask) }
  }
  forbidden = forbidden | mask
}

# The value in `r`, which is about to be written, moves to a register free of
# `avoid`, or goes to its slot; one nothing reads again just lets it go.
fn rescue(r: Int, avoid: Word) {
  let w: Value = id(holder[r])
  if w.clean or (w.left <= 0 and not w.shared) {
    free(r)
    return
  }
  # A 128-bit value goes to its slot.
  if wide?(w) {
    spill(r)
    return
  }
  let open = without(without(class-regs[class-of(w)], avoid | busy | forbidden | temps), occupied)
  if open == word(0) {
    spill(r)
    return
  }
  let to = lowest-bit(open)
  frames.copy(to, r)
  free(r)
  give(w, to)
}

# Whether `inner` may be computed in place by `root`: nothing else reads it,
# it is in the same block, and nothing has taken it already.
fn fusable?(inner: Value, root: Value) -> Bool =
  inner.uses == 1 and inner.home == root.home and not inner.folded

# Whether symbol `v` is reached through the table of addresses.
fn outside?(v: Value) -> Bool = v.outside

# How far below the frame record stack variable `v` was put, for a debugger;
# 0 if nothing read it.
fn object-distance(v: Value) -> Int = v.object-at

# Whoever compiles says symbol `v` is reached through the table.
fn set-outside(v: Value, yes: Bool) {
  v.outside = yes
}

# `v` is computed in place by `root`'s rule: what `v`'s own rule would have
# computed in place, `root`'s reads where it is.
fn fold(v: Value, root: Value) {
  v.folded = true
  v.folder = root
  folds.push(int(v))
  for i in 0..v.arity {
    let x = v.in(i)
    if x.folder == v {
      x.folded = false
      x.folder = none
    }
  }
}

# The label branch `v` goes to as its target `k`.
fn label(v: Value, k: Int) -> Int = labels[k]

# How far below the frame record a stack variable lies: aligned as it asks,
# and to 16 if it is larger than 8 bytes, else to 8.
fn object-offset(o: Value) -> Int {
  if o.object-at == 0 {
    let align = max(o.imm2, if o.imm > 8 then 16 else 8)
    let size = (max(o.imm, 1) + align - 1) / align * align
    # Aligned to more than the frame record is (16), it is found in room as
    # much larger, by its rule.
    let room = if align > 16 then size + align else size
    let at = min(align, 16)
    object-bytes = (object-bytes + room + at - 1) / at * at
    o.object-at = object-bytes
  }
  o.object-at
}
