;;; Compiled code and data before they have addresses: their bytes, symbols by
;;; name, and the places whose bits depend on where a symbol ends up. A JIT gives it addresses
;;; in memory; an object file writes it down for a linker.
(module declarative.rt.image)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])

;;; defined: the byte a symbol starts at, in the code or, if `in-data`, in the
;;; data; -1 for one from outside. A relocation is the byte of code it changes
;;; from, the symbol, and the instruction there. A pointer is eight bytes of
;;; data that hold a symbol's address.
(defstruct Image
  [(code (ArrayList u8))
   (data (ArrayList u8))
   (names (ArrayList (slice u8)))
   (defined (ArrayList i64))
   (in-data (ArrayList bool))
   (pointer-at (ArrayList i64))
   (pointer-symbol (ArrayList i64))
   (reloc-at (ArrayList i64))
   (reloc-symbol (ArrayList i64))
   (reloc-op (ArrayList i64))])

(defn create [(a (dyn Allocator))] (-> Image)
  (Image
    :code (ArrayList::new [u8] a)
    :data (ArrayList::new [u8] a)
    :names (ArrayList::new [(slice u8)] a)
    :defined (ArrayList::new [i64] a)
    :in-data (ArrayList::new [bool] a)
    :pointer-at (ArrayList::new [i64] a)
    :pointer-symbol (ArrayList::new [i64] a)
    :reloc-at (ArrayList::new [i64] a)
    :reloc-symbol (ArrayList::new [i64] a)
    :reloc-op (ArrayList::new [i64] a)))

;;; The symbol with this name: its number, the same every time it is asked for.
(defn symbol! [(im (mut Image)) (name (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for i (range 0 (len (.names im)))
      (when (and (< found 0) (= (get (.names im) i) name)) (set! found i)))
    (when (< found 0)
      (push! (mut (.names im)) name)
      (push! (mut (.defined im)) -1)
      (push! (mut (.in-data im)) false)
      (set! found (- (len (.names im)) 1)))
    found))

;;; A function's code, as the symbol `symbol`, starting at a multiple of
;;; `align` bytes: `at`, `symbols` and `ops` are its relocations, counted in
;;; bytes from its start.
(defn add-function! [(im (mut Image)) (symbol i64) (code (ArrayList u8)) (at (ArrayList i64))
                     (symbols (ArrayList i64)) (ops (ArrayList i64)) (align i64)] (-> void)
  (while (!= (% (len (.code im)) align) 0) (push! (mut (.code im)) (: 0 u8)))
  (let [base (len (.code im))]
    (set! (mut (.defined im)) symbol base)
    (for b code (push! (mut (.code im)) b))
    (for i (range 0 (len at))
      (push! (mut (.reloc-at im)) (+ base (get at i)))
      (push! (mut (.reloc-symbol im)) (get symbols i))
      (push! (mut (.reloc-op im)) (get ops i)))))

;;; Data, as the symbol `symbol`, starting at a multiple of `align` bytes.
;;; Returns where in the data it starts.
(defn add-data! [(im (mut Image)) (symbol i64) (bytes (slice u8)) (align i64)] (-> i64)
  (while (!= (% (len (.data im)) align) 0) (push! (mut (.data im)) (: 0 u8)))
  (let [base (len (.data im))]
    (set! (mut (.defined im)) symbol base)
    (set! (mut (.in-data im)) symbol true)
    (for b bytes (push! (mut (.data im)) b))
    base))

;;; The eight bytes of data at `at` hold the address of `symbol`.
(defn add-pointer! [(im (mut Image)) (at i64) (symbol i64)] (-> void)
  (push! (mut (.pointer-at im)) at)
  (push! (mut (.pointer-symbol im)) symbol))
