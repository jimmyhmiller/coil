;;; Arithmetic on values held as 64-bit words of a narrower declared width.
(module declarative.rt.bits)
(import "coil.primitive" :as primitive)
(import "coil.math" :as math)

(defn mask :inline (Always) [(bits i64)] (-> u64)
  (if (>= bits 64)
      (: 0xFFFFFFFFFFFFFFFF u64)
      (primitive/isub (<< (: 1 u64) (cast u64 bits)) (: 1 u64))))

;;; The low `bits` bits of a word.
(defn cut :inline (Always) [(v u64) (bits i64)] (-> u64)
  (& v (mask bits)))

;;; A `bits`-wide value's sign carried up through all 64 bits.
(defn sext :inline (Always) [(v u64) (bits i64)] (-> u64)
  (if (or (>= bits 64) (<= bits 0))
      v
      (let [sign (<< (: 1 u64) (cast u64 (- bits 1)))]
        (primitive/isub (^ (& v (mask bits)) sign) sign))))

(defn signed :inline (Always) [(v u64) (bits i64)] (-> i64)
  (primitive/cast i64 (sext v bits)))

(defn shl :inline (Always) [(v u64) (n u64)] (-> u64)
  (if (>= n 64) (: 0 u64) (<< v n)))

(defn shr :inline (Always) [(v u64) (n u64)] (-> u64)
  (if (>= n 64) (: 0 u64) (>> v n)))

;;; Arithmetic shift of a word already sign-extended to 64 bits.
(defn sar :inline (Always) [(v u64) (n u64)] (-> u64)
  (primitive/cast u64 (>> (primitive/cast i64 v) (if (>= n 64) (: 63 i64) (primitive/cast i64 n)))))

(defn urem :inline (Always) [(v u64) (n u64)] (-> u64)
  (if (= n 0) v (% v n)))

;;; An Int kept in 32 bits: one that does not fit is a mistake where it is kept.
(defn int32 :inline (Always) [(v i64)] (-> i32)
  (when (or (< v -2147483648) (> v 2147483647)) (panic "a number kept in 32 bits does not fit"))
  (cast i32 v))
;;; An Int kept in 8 bits: one that does not fit is a mistake where it is kept.
(defn int8 :inline (Always) [(v i64)] (-> i8)
  (when (or (< v -128) (> v 127)) (panic "a number kept in 8 bits does not fit"))
  (cast i8 v))

;;; The number of the lowest set bit of a nonzero word.
(defn lowest :inline (Always) [(v u64)] (-> i64)
  (cast i64 (primitive/ctz v)))

;;; The number of the highest set bit of a nonzero word.
(defn highest :inline (Always) [(v u64)] (-> i64)
  (- 63 (cast i64 (primitive/clz v))))

;;; How many bits of a word are set.
(defn count :inline (Always) [(v u64)] (-> i64)
  (cast i64 (primitive/popcount v)))

;;; Division as machines without a trap do it: by zero gives zero, and the one
;;; signed overflow gives the dividend back.
(defn udiv :inline (Always) [(v u64) (n u64)] (-> u64)
  (if (= n 0) (: 0 u64) (/ v n)))

(defn sdiv :inline (Always) [(v u64) (n u64)] (-> u64)
  (let [a (primitive/cast i64 v)
        b (primitive/cast i64 n)]
    (cond (= b 0) (: 0 u64)
          (= b -1) (primitive/isub (: 0 u64) v)
          :else (primitive/cast u64 (/ a b)))))

(defn srem :inline (Always) [(v u64) (n u64)] (-> u64)
  (let [a (primitive/cast i64 v)
        b (primitive/cast i64 n)]
    (cond (= b 0) v
          (= b -1) (: 0 u64)
          :else (primitive/cast u64 (% a b)))))

;;; Exactly one bit set, taking the value as a signed number's bits.
(defn pow2? [(v i64)] (-> bool)
  (and (> v 0) (= (& v (- v 1)) 0)))

(defn shl-signed [(v i64) (n i64)] (-> i64)
  (if (or (< n 0) (>= n 64)) 0 (primitive/cast i64 (<< (primitive/cast u64 v) (primitive/cast u64 n)))))

(defn sar-signed [(v i64) (n i64)] (-> i64)
  (>> v (if (or (< n 0) (>= n 64)) 63 n)))

;; ---------------------------------------------------------------- floating point
;; A floating value is held as its bits, 32 or 64 of them.

(defn f64-of [(v u64)] (-> f64)
  (let [(mut x) v]
    (primitive/load (primitive/cast (ptr f64) (mut x)))))

(defn of-f64 [(v f64)] (-> u64)
  (let [(mut x) v]
    (primitive/load (primitive/cast (ptr u64) (mut x)))))

(defn f32-of [(v u64)] (-> f32)
  (let [(mut x) (primitive/cast u32 (& v (: 0xFFFFFFFF u64)))]
    (primitive/load (primitive/cast (ptr f32) (mut x)))))

(defn of-f32 [(v f32)] (-> u64)
  (let [(mut x) v]
    (cast u64 (primitive/load (primitive/cast (ptr u32) (mut x))))))

(defn fadd [(a u64) (b u64) (bits i64)] (-> u64)
  (if (= bits 32) (of-f32 (+ (f32-of a) (f32-of b))) (of-f64 (+ (f64-of a) (f64-of b)))))

(defn fsub [(a u64) (b u64) (bits i64)] (-> u64)
  (if (= bits 32) (of-f32 (- (f32-of a) (f32-of b))) (of-f64 (- (f64-of a) (f64-of b)))))

(defn fmul [(a u64) (b u64) (bits i64)] (-> u64)
  (if (= bits 32) (of-f32 (* (f32-of a) (f32-of b))) (of-f64 (* (f64-of a) (f64-of b)))))

(defn fdiv [(a u64) (b u64) (bits i64)] (-> u64)
  (if (= bits 32) (of-f32 (/ (f32-of a) (f32-of b))) (of-f64 (/ (f64-of a) (f64-of b)))))

;;; Negation and absolute value are the sign bit alone, whatever the value.
(defn fneg [(a u64) (bits i64)] (-> u64)
  (^ a (<< (: 1 u64) (cast u64 (- bits 1)))))

(defn fabs [(a u64) (bits i64)] (-> u64)
  (& a (primitive/isub (<< (: 1 u64) (cast u64 (- bits 1))) (: 1 u64))))

(defn fsqrt [(a u64) (bits i64)] (-> u64)
  (if (= bits 32)
      (of-f32 (cast f32 (math/sqrt (cast f64 (f32-of a)))))
      (of-f64 (math/sqrt (f64-of a)))))

;;; Not a number: every exponent bit set and some bit below them. The highest
;;; of those lower bits says it is a quiet one, which arithmetic passes along;
;;; without it, it is a signaling one, which arithmetic first makes quiet.
(defn quiet-bit [(bits i64)] (-> u64)
  (if (= bits 32) (: 0x400000 u64) (: 0x8000000000000 u64)))

(defn nan? [(a u64) (bits i64)] (-> bool)
  (if (= bits 32)
      (and (= (& a (: 0x7F800000 u64)) (: 0x7F800000 u64)) (!= (& a (: 0x7FFFFF u64)) 0))
      (and (= (& a (: 0x7FF0000000000000 u64)) (: 0x7FF0000000000000 u64)) (!= (& a (: 0xFFFFFFFFFFFFF u64)) 0))))

(defn signaling? [(a u64) (bits i64)] (-> bool)
  (and (nan? a bits) (= (& a (quiet-bit bits)) 0)))

;;; Of two values at least one of which is not a number, the one an operation
;;; gives: a signaling one before a quiet one, the first before the second.
(defn nan-of [(a u64) (b u64) (bits i64)] (-> u64)
  (cond (signaling? a bits) (| a (quiet-bit bits))
        (signaling? b bits) (| b (quiet-bit bits))
        (nan? a bits) a
        :else b))

;;; The smaller and the larger. Zero with its sign set is below zero without.
(defn fmin [(a u64) (b u64) (bits i64)] (-> u64)
  (cond (or (nan? a bits) (nan? b bits)) (nan-of a b bits)
        (< (fvalue a bits) (fvalue b bits)) a
        (< (fvalue b bits) (fvalue a bits)) b
        :else (| a b)))

(defn fmax [(a u64) (b u64) (bits i64)] (-> u64)
  (cond (or (nan? a bits) (nan? b bits)) (nan-of a b bits)
        (> (fvalue a bits) (fvalue b bits)) a
        (> (fvalue b bits) (fvalue a bits)) b
        :else (& a b)))

;;; The same, but with one quiet value that is not a number, the other value.
(defn fmin-number [(a u64) (b u64) (bits i64)] (-> u64)
  (cond (and (nan? a bits) (not (signaling? a bits)) (not (nan? b bits))) b
        (and (nan? b bits) (not (signaling? b bits)) (not (nan? a bits))) a
        :else (fmin a b bits)))

(defn fmax-number [(a u64) (b u64) (bits i64)] (-> u64)
  (cond (and (nan? a bits) (not (signaling? a bits)) (not (nan? b bits))) b
        (and (nan? b bits) (not (signaling? b bits)) (not (nan? a bits))) a
        :else (fmax a b bits)))

;;; To a whole number. `mode` 0 is the nearest with halves to the even one, 1
;;; the next up, 2 the next down, 3 toward zero, 4 the nearest with halves away
;;; from zero. Every single-precision value is a double, and rounds the same.
(defn fround [(a u64) (mode u64) (bits i64)] (-> u64)
  (if (nan? a bits)
      (| a (quiet-bit bits))
      (let [x (fvalue a bits)]
        (of-fvalue (cond (= mode 0) (math/round-even x)
                         (= mode 1) (math/ceil x)
                         (= mode 2) (math/floor x)
                         (= mode 3) (math/trunc x)
                         :else (math/round x))
                   bits))))

;;; a * b + c, rounded once.
(defn fma [(a u64) (b u64) (c u64) (bits i64)] (-> u64)
  (if (= bits 32)
      (of-f32 (math/mul-add (f32-of a) (f32-of b) (f32-of c)))
      (of-f64 (math/mul-add (f64-of a) (f64-of b) (f64-of c)))))

;;; Comparisons are false when either side is not a number, but for `fne`.
(defn feq [(a u64) (b u64) (bits i64)] (-> bool)
  (if (= bits 32) (= (f32-of a) (f32-of b)) (= (f64-of a) (f64-of b))))

(defn flt [(a u64) (b u64) (bits i64)] (-> bool)
  (if (= bits 32) (< (f32-of a) (f32-of b)) (< (f64-of a) (f64-of b))))

(defn fle [(a u64) (b u64) (bits i64)] (-> bool)
  (if (= bits 32) (<= (f32-of a) (f32-of b)) (<= (f64-of a) (f64-of b))))

(defn fvalue [(a u64) (bits i64)] (-> f64)
  (if (= bits 32) (cast f64 (f32-of a)) (f64-of a)))

(defn of-fvalue [(v f64) (bits i64)] (-> u64)
  (if (= bits 32) (of-f32 (cast f32 v)) (of-f64 v)))

;;; An integer as the nearest floating value.
(defn sitof [(a u64) (bits i64)] (-> u64)
  (if (= bits 32) (of-f32 (cast f32 (primitive/cast i64 a))) (of-f64 (cast f64 (primitive/cast i64 a)))))

(defn uitof [(a u64) (bits i64)] (-> u64)
  (if (= bits 32) (of-f32 (cast f32 a)) (of-f64 (cast f64 a))))

;;; A floating value as an integer of `to` bits, toward zero: what is not a
;;; number gives 0 and what is out of range gives the nearest end of the range.
(defn ftosi [(a u64) (bits i64) (to i64)] (-> u64)
  (let [x (fvalue a bits)
        low (cast f64 (primitive/cast i64 (sext (<< (: 1 u64) (cast u64 (- to 1))) to)))
        high (- 0.0 low)]
    (cond (!= x x) (: 0 u64)
          (<= x low) (<< (: 1 u64) (cast u64 (- to 1)))
          (>= x high) (primitive/isub (<< (: 1 u64) (cast u64 (- to 1))) (: 1 u64))
          :else (cut (primitive/cast u64 (cast i64 x)) to))))

(defn ftoui [(a u64) (bits i64) (to i64)] (-> u64)
  (let [x (fvalue a bits)
        high (* 2.0 (cast f64 (<< (: 1 u64) (cast u64 (- to 1)))))]
    (cond (!= x x) (: 0 u64)
          (<= x 0.0) (: 0 u64)
          (>= x high) (mask to)
          :else (cast u64 x))))

(defn fext [(a u64)] (-> u64)
  (of-f64 (cast f64 (f32-of a))))

(defn ftrunc [(a u64)] (-> u64)
  (of-f32 (cast f32 (f64-of a))))

;; ---------------------------------------------------------------- bits

;;; Leading zeros of a `bits`-wide value; all of them for zero.
(defn clz [(v u64) (bits i64)] (-> u64)
  (let [(mut n) 0
        (mut probe) (<< (: 1 u64) (cast u64 (- bits 1)))]
    (while (and (< n bits) (= (& v probe) 0))
      (set! n (+ n 1))
      (set! probe (>> probe 1)))
    (cast u64 n)))

(defn ctz [(v u64) (bits i64)] (-> u64)
  (let [x (cut v bits)]
    (if (= x 0) (cast u64 bits) (cast u64 (lowest x)))))

(defn popcount [(v u64) (bits i64)] (-> u64)
  (cast u64 (count (cut v bits))))

;;; The bits of a `bits`-wide value in the opposite order.
(defn bitrev [(v u64) (bits i64)] (-> u64)
  (let [(mut out) (: 0 u64)]
    (for i (range 0 bits)
      (set! out (| out (<< (& (>> v (cast u64 i)) 1) (cast u64 (- (- bits 1) i))))))
    out))

;;; The bytes of a `bits`-wide value in the opposite order.
(defn bswap [(v u64) (bits i64)] (-> u64)
  (let [bytes (/ bits 8)
        (mut out) (: 0 u64)]
    (for i (range 0 bytes)
      (set! out (| out (<< (& (>> v (cast u64 (* i 8))) 255) (cast u64 (* (- (- bytes 1) i) 8))))))
    out))

(defn rol [(v u64) (n u64) (bits i64)] (-> u64)
  (let [k (% n (cast u64 bits))
        x (cut v bits)]
    (if (= k 0) x (cut (| (<< x k) (>> x (- (cast u64 bits) k))) bits))))

(defn ror [(v u64) (n u64) (bits i64)] (-> u64)
  (let [k (% n (cast u64 bits))
        x (cut v bits)]
    (if (= k 0) x (cut (| (>> x k) (<< x (- (cast u64 bits) k))) bits))))

;;; The high half of a product of two `bits`-wide values, 32 or 64 wide.
(defn umulh [(a u64) (b u64) (bits i64)] (-> u64)
  (if (<= bits 32)
      (>> (primitive/imul (cut a bits) (cut b bits)) (cast u64 bits))
      (let [al (& a (: 0xFFFFFFFF u64))
            ah (>> a 32)
            bl (& b (: 0xFFFFFFFF u64))
            bh (>> b 32)
            ll (primitive/imul al bl)
            lh (primitive/imul al bh)
            hl (primitive/imul ah bl)
            hh (primitive/imul ah bh)
            mid (primitive/iadd (primitive/iadd (>> ll 32) (& lh (: 0xFFFFFFFF u64))) (& hl (: 0xFFFFFFFF u64)))]
        (primitive/iadd (primitive/iadd hh (>> lh 32)) (primitive/iadd (>> hl 32) (>> mid 32))))))

(defn smulh [(a u64) (b u64) (bits i64)] (-> u64)
  (if (<= bits 32)
      (>> (primitive/imul (sext a bits) (sext b bits)) (cast u64 bits))
      (let [x (sext a bits)
            y (sext b bits)
            high (umulh x y 64)
            fix-a (if (< (primitive/cast i64 x) 0) y (: 0 u64))
            fix-b (if (< (primitive/cast i64 y) 0) x (: 0 u64))]
        (primitive/isub (primitive/isub high fix-a) fix-b))))

;;; Whether the true sum, difference or product does not fit the width.
(defn sadd-overflows [(a u64) (b u64) (bits i64)] (-> bool)
  (let [x (sext a bits)
        y (sext b bits)
        r (sext (primitive/iadd x y) bits)]
    (and (= (>> (^ x y) 63) 0) (!= (>> (^ x r) 63) 0))))

(defn ssub-overflows [(a u64) (b u64) (bits i64)] (-> bool)
  (let [x (sext a bits)
        y (sext b bits)
        r (sext (primitive/isub x y) bits)]
    (and (!= (>> (^ x y) 63) 0) (!= (>> (^ x r) 63) 0))))

(defn uadd-overflows [(a u64) (b u64) (bits i64)] (-> bool)
  (< (cut (primitive/iadd a b) bits) (cut a bits)))

(defn usub-overflows [(a u64) (b u64) (bits i64)] (-> bool)
  (< (cut a bits) (cut b bits)))

(defn umul-overflows [(a u64) (b u64) (bits i64)] (-> bool)
  (if (<= bits 32)
      (!= (>> (primitive/imul (cut a bits) (cut b bits)) (cast u64 bits)) 0)
      (!= (umulh a b 64) 0)))

(defn smul-overflows [(a u64) (b u64) (bits i64)] (-> bool)
  (if (<= bits 32)
      (let [p (primitive/imul (sext a bits) (sext b bits))]
        (!= p (sext p bits)))
      (let [low (primitive/imul a b)
            high (smulh a b 64)]
        (!= high (if (< (primitive/cast i64 low) 0) (: 0xFFFFFFFFFFFFFFFF u64) (: 0 u64))))))

;;; How many bits it takes to write a value: one more than its highest set bit.
(defn bit-length [(v u64)] (-> i64)
  (let [(mut n) 0
        (mut x) v]
    (while (!= x 0)
      (set! n (+ n 1))
      (set! x (>> x 1)))
    n))

;;; The value with its low `n` bits set.
(defn ones [(n i64)] (-> i64)
  (primitive/cast i64 (mask n)))
