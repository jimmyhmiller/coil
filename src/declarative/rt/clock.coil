;;; Time as a plan runs, for whoever asks how long each step took.
(module declarative.rt.clock)
(import "coil.time" :as time)
(import "coil.arraylist" :use [ArrayList])

;;; Nanoseconds from some fixed moment.
(defn now [] (-> i64)
  (match (time/monotonic-now)
    (Err [_] (panic "the clock could not be read"))
    (Ok [t] (+ (* (.sec t) 1000000000) (.nsec t)))))

;;; Adds the time since `started` to step `i`'s total.
(defn add! [(times (mut (ArrayList i64))) (i i64) (started i64)] (-> void)
  (while (<= (len times) i) (push! (mut times) 0))
  (set! (mut times) i (+ (get times i) (- (now) started))))

