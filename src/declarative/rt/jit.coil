;;; Machine code made runnable in this process: mapped writable, filled, then
;;; made executable. Never writable and executable at once.
(module declarative.rt.jit)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.os" :as os)
(import "coil.arraylist" :use [ArrayList])
(import "declarative.rt.image" :as image)

(extern declarative.rt.jit.mmap :as "mmap" :cc (cc/C) [(ptr u8) i64 i32 i32 i32 i64] (-> (ptr u8)))
(extern declarative.rt.jit.mprotect :as "mprotect" :cc (cc/C) [(ptr u8) i64 i32] (-> i32))
(extern declarative.rt.jit.munmap :as "munmap" :cc (cc/C) [(ptr u8) i64] (-> i32))
(extern declarative.rt.jit.pagesize :as "getpagesize" :cc (cc/C) [] (-> i32))

(os/os-pick
  (extern declarative.rt.jit.clear-cache :as "__clear_cache" :cc (cc/C) [(ptr u8) (ptr u8)] (-> void))
  (extern declarative.rt.jit.invalidate :as "sys_icache_invalidate" :cc (cc/C) [(ptr u8) i64] (-> void))
  (do))

(defstruct Mapped [(base (ptr u8)) (size i64)])

;;; Bytes of code, made runnable. Panics if the system refuses the mapping.
(defn map-bytes [(code (ArrayList u8))] (-> Mapped)
  (let [length (len code)
        page (cast i64 (declarative.rt.jit.pagesize))
        size (* (/ (+ (if (= length 0) 1 length) (- page 1)) page) page)
        base (declarative.rt.jit.mmap (primitive/cast (ptr u8) 0) size 3 (os/os-pick 0x22 0x1002 0) -1 0)]
    (when (= (primitive/cast i64 base) -1) (panic "cannot map memory for code"))
    (for i (range 0 length) (set! (index base i) (get code i)))
    (when (!= (declarative.rt.jit.mprotect base size 5) 0) (panic "cannot make code executable"))
    (os/os-pick (declarative.rt.jit.clear-cache base (primitive/index base length))
                (declarative.rt.jit.invalidate base length)
                (do))
    (Mapped :base base :size size)))

(defn release! [(code Mapped)] (-> void)
  (declarative.rt.jit.munmap (.base code) (.size code))
  (do))

;;; An image linked into this process. Its code is followed by a table with one
;;; address per symbol, for code that reaches a symbol through the table.
(defstruct Loaded [(base (ptr u8)) (size i64) (im image/Image) (data-at i64)])

;;; Give back the memory a loaded image was put in.
(defn unload! [(loaded Loaded)] (-> void)
  (declarative.rt.jit.munmap (.base loaded) (.size loaded))
  (do))

(defn read32 [(base (ptr u8)) (at i64)] (-> u32)
  (| (| (cast u32 (primitive/load (primitive/index base at)))
        (<< (cast u32 (primitive/load (primitive/index base (+ at 1)))) 8))
     (| (<< (cast u32 (primitive/load (primitive/index base (+ at 2)))) 16)
        (<< (cast u32 (primitive/load (primitive/index base (+ at 3)))) 24))))

(defn write32! [(base (ptr u8)) (at i64) (w u32)] (-> void)
  (set! (index base at) (primitive/cast u8 (& w 255)))
  (set! (index base (+ at 1)) (primitive/cast u8 (& (>> w 8) 255)))
  (set! (index base (+ at 2)) (primitive/cast u8 (& (>> w 16) 255)))
  (set! (index base (+ at 3)) (primitive/cast u8 (& (>> w 24) 255))))

;;; Give an image addresses and make it runnable: its code, then on pages of
;;; their own its data and the table of addresses, which stay writable.
;;; `outside` has the address of each symbol the image does not define, by
;;; symbol number. `patch` is the target's: the four bytes at a relocation
;;; finished with its symbol's address, the address of the symbol's table slot
;;; and the relocation's own address.
(defn load-image [(im image/Image) (outside (ArrayList u64))
                  (patch (fnptr (cc/C) [i64 u32 i64 i64 i64] u32))] (-> Loaded)
  (let [page (cast i64 (declarative.rt.jit.pagesize))
        bytes (len (.code im))
        code-size (* (/ (+ (if (= bytes 0) 1 bytes) (- page 1)) page) page)
        data-at code-size
        table (+ data-at (* 8 (/ (+ (len (.data im)) 7) 8)))
        length (+ table (* 8 (len (.names im))))
        size (* (/ (+ length (- page 1)) page) page)
        base (declarative.rt.jit.mmap (primitive/cast (ptr u8) 0) size 3 (os/os-pick 0x22 0x1002 0) -1 0)
        here (primitive/cast i64 base)]
    (when (= here -1) (panic "cannot map memory for code"))
    (for i (range 0 bytes) (set! (index base i) (get (.code im) i)))
    (for i (range 0 (len (.data im))) (set! (index base (+ data-at i)) (get (.data im) i)))
    (for s (range 0 (len (.names im)))
      (let [address (address-in im outside here data-at s)]
        (when (= address 0) (panic "undefined symbol {}" (get (.names im) s)))
        (write64! base (+ table (* s 8)) (primitive/cast u64 address))))
    (for i (range 0 (len (.pointer-at im)))
      (write64! base (+ data-at (get (.pointer-at im) i))
                (primitive/cast u64 (address-in im outside here data-at (get (.pointer-symbol im) i)))))
    (for i (range 0 (len (.reloc-at im)))
      (let [at (get (.reloc-at im) i)
            s (get (.reloc-symbol im) i)]
        (write32! base at
                  (patch (get (.reloc-op im) i) (read32 base at) (address-in im outside here data-at s)
                         (+ here (+ table (* s 8))) (+ here at)))))
    (when (!= (declarative.rt.jit.mprotect base code-size 5) 0) (panic "cannot make code executable"))
    (os/os-pick (declarative.rt.jit.clear-cache base (primitive/index base bytes))
                (declarative.rt.jit.invalidate base bytes)
                (do))
    (Loaded :base base :size size :im im :data-at data-at)))

;;; Where symbol `s` is, once the image's code is at `here` and its data
;;; `data-at` bytes after; 0 if it is from outside and no one said where.
(defn address-in [(im image/Image) (outside (ArrayList u64)) (here i64) (data-at i64) (s i64)] (-> i64)
  (let [at (get (.defined im) s)]
    (cond (< at 0) (if (< s (len outside)) (primitive/cast i64 (get outside s)) 0)
          (get (.in-data im) s) (+ here (+ data-at at))
          :else (+ here at))))

(defn write64! [(base (ptr u8)) (at i64) (v u64)] (-> void)
  (for b (range 0 8)
    (set! (index base (+ at b)) (primitive/cast u8 (& (>> v (cast u64 (* b 8))) 255)))))

;;; Where a symbol the image defines was put.
(defn address-of [(loaded Loaded) (symbol i64)] (-> (ptr u8))
  (let [im (.im loaded)
        at (get (.defined im) symbol)]
    (primitive/index (.base loaded) (if (get (.in-data im) symbol) (+ (.data-at loaded) at) at))))
