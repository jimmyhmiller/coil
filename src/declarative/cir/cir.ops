# CIR, Coil's IR for code generation: its types and operations, said once.
# Their numbers here are CIR's own: numbers.numbers makes them the module
# native.cir-ops, which native/cir.pass and everything that builds CIR use. How
# CIR's functions are stored is the adapter's (adapter/view.coil).
#
# Every I64 value is a whole 64-bit word, kept extended by whoever made it:
# an operation reads all 64 bits. Widths in immediates say how an operation
# works below 64 bits. Floating values are their bits.
ops read through declarative.view, functions are Func of native.cir

type VOID = 0
type I64 = 1 : 64
type I128 = 2 : 128
type F32 = 3 : 32 float
type F64 = 4 : 64 float
type V128 = 5 : 128 float

# Values that are no instruction.
op CONST 1 imm low imm2 high role const = low
op SYM 2 imm symbol imm2 addend role symbol
op ARG 3 imm index role param
op ALLOCA 4 imm size imm2 align role object
# A call's results after the first: `index` from 0.
op CALLRES 5 imm index role result

# Words.
op ADD 10 (a, b) = a + b
op SUB 11 (a, b) = a - b
op MUL 12 (a, b) = a * b
op AND 13 (a, b) = a & b
op OR 14 (a, b) = a | b
op XOR 15 (a, b) = a ^ b
op SHL 16 (a, n) = a << n
op LSHR 17 (a, n) = a >> n
op ASHR 18 (a, n) = sar(a, n)
# Division by zero gives 0 and the smallest number by -1 itself; nothing traps.
op SDIV 19 (a, b) = sdiv(a, b)
op UDIV 20 (a, b) = udiv(a, b)
op SREM 21 (a, b) = srem(a, b)
op UREM 22 (a, b) = urem(a, b)
# Rotations within the low `w` bits, zero-extended.
op ROTL 23 (a, n) imm w = rol(zext(a, w), n, w)
op ROTR 24 (a, n) imm w = ror(zext(a, w), n, w)
op NEG 25 (a) = 0 - a
op NOT 26 (a) = ~a
op SMULH 27 (a, b) = smulh(a, b)
op UMULH 28 (a, b) = umulh(a, b)
op SEXT 29 (a) imm bits = sext(a, bits)
op ZEXT 30 (a) imm bits = zext(a, bits)
op LO 31 (a)
op HI 32 (a)
op PAIR 33 (low, high)
# Bits within the low `w`.
op CLZ 34 (a) imm w = clz(zext(a, w), w)
op CTZ 35 (a) imm w = ctz(zext(a, w), w)
op POPCNT 36 (a) imm w = popcount(zext(a, w), w)
op BSWAP 37 (a) imm w = bswap(zext(a, w), w)
op BITREV 43 (a) imm w = bitrev(zext(a, w), w)
op ICMP 38 (a, b) imm predicate =
  cases(predicate, a == b, a != b, slt(a, b), sle(a, b), slt(b, a), sle(b, a), ult(a, b), ule(a, b), ult(b, a), ule(b, a))
op SELECT 39 (c, a, b) = select(c, a, b)
# Whether the operation done in `w` bits overflows, signed or not.
op ADDO 40 (a, b) imm w imm2 signed =
  select(w == 64, select(signed, sadd-overflows(a, b, 64), uadd-overflows(a, b, 64)),
         select(signed, sext(a + b, w) != a + b, zext(a + b, w) != a + b))
op SUBO 41 (a, b) imm w imm2 signed =
  select(w == 64, select(signed, ssub-overflows(a, b, 64), usub-overflows(a, b, 64)),
         select(signed, sext(a - b, w) != a - b, zext(a - b, w) != a - b))
op MULO 42 (a, b) imm w imm2 signed =
  select(w == 64, select(signed, smul-overflows(a, b, 64), umul-overflows(a, b, 64)),
         select(signed, sext(a * b, w) != a * b, zext(a * b, w) != a * b))

# Floating point, in the operation's own width.
op FADD 50 (a, b) = fadd(a, b, width)
op FSUB 51 (a, b) = fsub(a, b, width)
op FMUL 52 (a, b) = fmul(a, b, width)
op FDIV 53 (a, b) = fdiv(a, b, width)
op FNEG 54 (a) = fneg(a, width)
op FABS 55 (a) = fabs(a, width)
op FSQRT 56 (a) = fsqrt(a, width)
op FMIN 57 (a, b) = fmin(a, b, width)
op FMAX 58 (a, b) = fmax(a, b, width)
op FMINNM 59 (a, b) = fmin-number(a, b, width)
op FMAXNM 60 (a, b) = fmax-number(a, b, width)
# Rounding: 0 to even, 1 up, 2 down, 3 toward zero, 4 away from zero.
op FRINT 61 (a) imm mode = fround(a, mode, width)
op FMA 62 (a, b, c) = fma(a, b, c, width)
op FCMP 63 (a, b) imm predicate =
  cases(predicate, feq(a, b, width(a)), (unordered(a, b, width(a)) | feq(a, b, width(a))) ^ 1,
        flt(a, b, width(a)), fle(a, b, width(a)), flt(b, a, width(a)), fle(b, a, width(a)),
        feq(a, b, width(a)) ^ 1, unordered(a, b, width(a)) | feq(a, b, width(a)),
        unordered(a, b, width(a)) ^ 1, unordered(a, b, width(a)),
        unordered(a, b, width(a)) | flt(a, b, width(a)), unordered(a, b, width(a)) | fle(a, b, width(a)),
        unordered(a, b, width(a)) | flt(b, a, width(a)), unordered(a, b, width(a)) | fle(b, a, width(a)))
op FPEXT 64 (a) = fext(a)
op FPTRUNC 65 (a) = ftrunc(a)
op SITOFP 66 (a) = sitof(a, width)
op UITOFP 67 (a) = uitof(a, width)
# To an integer of `bits` (32 or 64), saturating, with 0 for what is not a
# number; a 32-bit one is extended to the word.
op FPTOSI 68 (a) imm bits = sext(ftosi(a, width(a), bits), bits)
op FPTOUI 69 (a) imm bits = ftoui(a, width(a), bits)
# The same bits as another type; a single-precision value is the low 32.
op BITCAST 70 (a) = select(width == 32, zext(a, 32), select(width(a) == 32, zext(a, 32), a))
op COPY 71 (a) = a

# Memory. A load's `shape` is its bytes, and 256 if it extends their sign.
op LOAD 80 (p) imm offset imm2 shape role load = load(p + offset, shape & 255, (shape >> 8) & 1)
op STORE 81 (p, v) imm offset imm2 bytes role store = store(p + offset, v, bytes)
op PTRADD 82 (p, i) imm scale imm2 offset = p + i * scale + offset
op ADDI 83 (p) imm offset = p + offset
op MEMCPY 84 (dst, src) imm bytes role effect = copy(dst, src, bytes)
op MEMZERO 85 (dst) imm bytes role effect = fill(dst, 0, bytes)
op DYNALLOCA 86 (bytes) imm align role effect
# An update of memory: 0 add 1 sub 2 and 3 or 4 xor 5 exchange 6 smax 7 smin
# 8 umax 9 umin, of `bytes`; the value is what was there, zero-extended.
op ATOMIC-RMW 87 (p, v) imm update imm2 bytes role effect
op CMPXCHG 88 (p, expected, desired) imm2 bytes role effect
op ATOMIC-LOAD 89 (p) imm2 bytes role effect
op ATOMIC-STORE 90 (p, v) imm2 bytes role effect
op FENCE 91 role effect
op MEMCPYV 92 (dst, src, bytes) role effect = copy(dst, src, bytes)
op MEMMOVEV 93 (dst, src, bytes) role effect = copy(dst, src, bytes)
op MEMSETV 94 (dst, byte, bytes) role effect = fill(dst, byte, bytes)
op VLOAD-LANE 95 (p) role effect

# Calls. `symbol` is what is called, or -1 when the first operand is; `results`
# is how many values it gives.
op CALL 100 (args...) imm symbol aux results role call
op RET 101 (values...) role return
op TAILCALL 102 (args...) imm symbol aux results role tailcall
op MACHINE 103 imm bytes role effect
op SHIMCALL 104 (args...) imm symbol imm2 clobbers aux result role call

# Control. A branch's meaning is which of its targets it goes to.
op BR 110 role jump
op CONDBR 111 (c) role branch = c == 0
op SWITCH 112 (v) imm cases role switch
op UNREACHABLE 113 role trap
op PHI 114 role phi
