target declarative.a64.target
abi declarative.a64.abi
pass declarative.a64-direct.mach
templates declarative.a64-direct.lower
pass declarative.a64-direct.frames
pass declarative.a64-direct.regs
select declarative.a64-direct.select
pass declarative.a64-direct.walk
