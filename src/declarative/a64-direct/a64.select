# Which AArch64 instructions compute each CIR operation, for the compile that
# goes straight from CIR. Every integer is a whole 64-bit word.
select in unit
ops declarative.cir.ops
target declarative.a64.target
templates lower
registers regs
emit mach

# Made where they are read: a constant, a symbol's address, a stack variable's.
rule CONST k when float and k == 0        => fmov-from-gpr(sf, out, zr)
rule CONST k when float and width == 32   => constant(x16, k & 4294967295) ; fmov-from-gpr(0, out, x16)
rule CONST k when float and width == 64   => constant(x16, k) ; fmov-from-gpr(1, out, x16)
rule CONST k when width == 64             => constant(out, k)
rule SYM as s when outside(s)             => adrp-got(out, symbol) ; ldr-got(out, out, symbol) ; address(out, out, addend)
rule SYM                                  => adrp(out, symbol) ; add-symbol(out, out, symbol) ; address(out, out, addend)
rule ALLOCA as o when align <= 16         => address(out, x29, 0 - object(o))
# One aligned to more than the frame is: room for it and its alignment, and
# its address the first place in that room that will do.
rule ALLOCA as o                          => address(out, x29, 0 - object(o)) ; add-imm(1, out, out, align - 1) ; and-imm(1, out, out, logical(0 - align))

# 128-bit integers: the low half in a register as a word is, the high half
# in another (`hi`). Sums and differences carry from the low halves into the
# high; a product is the low halves' full product and the cross terms.
rule CONST k when width == 128 and not float            => constant(out, k) ; constant(hi(out), high)
rule ADD(x, y) when width == 128 and not float          => adds(1, out, x, y) ; adc(1, hi(out), hi(x), hi(y))
rule SUB(x, y) when width == 128 and not float          => subs(1, out, x, y) ; sbc(1, hi(out), hi(x), hi(y))
rule NEG(x) when width == 128 and not float             => subs(1, out, zr, x) ; sbc(1, hi(out), zr, hi(x))
rule AND(x, y) when width == 128 and not float          => and(1, out, x, y) ; and(1, hi(out), hi(x), hi(y))
rule OR(x, y) when width == 128 and not float           => orr(1, out, x, y) ; orr(1, hi(out), hi(x), hi(y))
rule XOR(x, y) when width == 128 and not float          => eor(1, out, x, y) ; eor(1, hi(out), hi(x), hi(y))
rule NOT(x) when width == 128 and not float             => orn(1, out, zr, x) ; orn(1, hi(out), zr, hi(x))
rule MUL(x, y) when width == 128 and not float          => umulh($h, x, y) ; madd(1, $h, x, hi(y), $h) ; madd(1, hi(out), hi(x), y, $h) ; madd(1, out, x, y, zr)
# Shifts by the count modulo 128: below 64 the halves trade the bits that
# cross between them; from 64 one half moves into the other.
rule SHL(x, n) when width == 128 and not float          => lslv(1, $m, x, n) ; ubfm(1, $p, x, 1, 63) ; orn(1, $q, zr, n) ; lsrv(1, $p, $p, $q) ; lslv(1, $t, hi(x), n) ; orr(1, $t, $t, $p) ; ands-imm(1, zr, n, logical(64)) ; csel(1, out, zr, $m, ne) ; csel(1, hi(out), $m, $t, ne)
rule LSHR(x, n) when width == 128 and not float         => lsrv(1, $m, hi(x), n) ; add(1, $p, hi(x), hi(x)) ; orn(1, $q, zr, n) ; lslv(1, $p, $p, $q) ; lsrv(1, $t, x, n) ; orr(1, $t, $t, $p) ; ands-imm(1, zr, n, logical(64)) ; csel(1, out, $m, $t, ne) ; csel(1, hi(out), zr, $m, ne)
rule ASHR(x, n) when width == 128 and not float         => asrv(1, $m, hi(x), n) ; add(1, $p, hi(x), hi(x)) ; orn(1, $q, zr, n) ; lslv(1, $p, $p, $q) ; lsrv(1, $t, x, n) ; orr(1, $t, $t, $p) ; sbfm(1, $f, hi(x), 63, 63) ; ands-imm(1, zr, n, logical(64)) ; csel(1, out, $m, $t, ne) ; csel(1, hi(out), $f, $m, ne)
# Comparing: equal when both halves are; less by the high halves, then the
# low (a subtraction through both, which leaves the flags of the whole); a
# comparison that wants `b < a` subtracts the other way.
rule ICMP(a, b) when bits(a) == 128 and not float(a) and predicate < 2 => eor(1, $l, a, b) ; eor(1, $h, hi(a), hi(b)) ; orr(1, $l, $l, $h) ; subs-imm(1, zr, $l, 0) ; csinc(0, out, zr, zr, cases(predicate, ne, eq))
rule ICMP(a, b) when bits(a) == 128 and not float(a) and (predicate == 2 or predicate == 5 or predicate == 6 or predicate == 9) => subs(1, zr, a, b) ; sbcs(1, zr, hi(a), hi(b)) ; csinc(0, out, zr, zr, cases(predicate, al, al, ge, al, al, lt, hs, al, al, lo))
rule ICMP(a, b) when bits(a) == 128 and not float(a)       => subs(1, zr, b, a) ; sbcs(1, zr, hi(b), hi(a)) ; csinc(0, out, zr, zr, cases(predicate, al, al, al, lt, ge, al, al, lo, hs, al))
rule SELECT(c, x, y) when width == 128 and not float    => subs-imm(1, zr, c, 0) ; csel(1, out, x, y, ne) ; csel(1, hi(out), hi(x), hi(y), ne)
# Into and out of 128 bits.
rule SEXT(x) when width == 128 and not float            => sbfm(1, out, x, 0, bits - 1) ; sbfm(1, hi(out), out, 63, 63)
rule ZEXT(x) when width == 128 and not float            => ubfm(1, out, x, 0, bits - 1) ; move(hi(out), zr)
rule LO(x)                                => move(out, x)
rule HI(x)                                => move(out, hi(x))
rule PAIR(a, b)                           => move(out, a) ; move(hi(out), b)
rule COPY(x) when width == 128 and not float            => move(out, x) ; move(hi(out), hi(x))
rule LOAD(p) when width == 128 and not float            => load-word(out, p, offset, 8, 0) ; load-word(hi(out), p, offset + 8, 8, 0)
rule STORE(p, v) when bits(v) == 128 and not float(v)      => store-word(v, p, offset, 8) ; store-word(hi(v), p, offset + 8, 8)

# Words.
rule ADD(x, CONST k) when u12(k)          => add-imm(1, out, x, k)
rule ADD(x, CONST k) when u12(0 - k)      => sub-imm(1, out, x, 0 - k)
rule ADD(CONST k, x) when u12(k)          => add-imm(1, out, x, k)
rule ADD(once MUL(a, b), c)               => madd(1, out, a, b, c)
rule ADD(c, once MUL(a, b))               => madd(1, out, a, b, c)
rule ADD(x, once SHL(y, CONST k)) when k > 0 and k < 64 => add-shifted(1, out, x, y, k)
rule ADD(x, y)                            => add(1, out, x, y)
rule SUB(x, CONST k) when u12(k)          => sub-imm(1, out, x, k)
rule SUB(x, CONST k) when u12(0 - k)      => add-imm(1, out, x, 0 - k)
rule SUB(c, once MUL(a, b))               => msub(1, out, a, b, c)
rule SUB(x, once SHL(y, CONST k)) when k > 0 and k < 64 => sub-shifted(1, out, x, y, k)
rule SUB(x, y)                            => sub(1, out, x, y)
rule MUL(x, y)                            => madd(1, out, x, y, zr)
rule AND(x, CONST k) when logical(k)      => and-imm(1, out, x, logical(k))
rule AND(x, once SHL(y, CONST s)) when s > 0 and s < 64 => and-lsl(1, out, x, y, s)
rule AND(x, once LSHR(y, CONST s)) when s > 0 and s < 64 => and-lsr(1, out, x, y, s)
rule AND(x, y)                            => and(1, out, x, y)
rule OR(x, CONST k) when logical(k)       => orr-imm(1, out, x, logical(k))
rule OR(x, once SHL(y, CONST s)) when s > 0 and s < 64 => orr-lsl(1, out, x, y, s)
rule OR(x, once LSHR(y, CONST s)) when s > 0 and s < 64 => orr-lsr(1, out, x, y, s)
rule OR(x, y)                             => orr(1, out, x, y)
rule XOR(x, CONST k) when logical(k)      => eor-imm(1, out, x, logical(k))
rule XOR(x, y)                            => eor(1, out, x, y)
# By a constant a shift is a bit field; by a register the machine takes the
# count modulo 64, as CIR does.
rule SHL(x, CONST k)                      => ubfm(1, out, x, (64 - (k & 63)) & 63, 63 - (k & 63))
rule SHL(x, n)                            => lslv(1, out, x, n)
rule LSHR(x, CONST k)                     => ubfm(1, out, x, k & 63, 63)
rule LSHR(x, n)                           => lsrv(1, out, x, n)
rule ASHR(x, CONST k)                     => sbfm(1, out, x, k & 63, 63)
rule ASHR(x, n)                           => asrv(1, out, x, n)
rule SDIV(x, y)                           => sdiv(1, out, x, y)
rule UDIV(x, y)                           => udiv(1, out, x, y)
rule SREM(x, y)                           => sdiv(1, $q, x, y) ; msub(1, out, $q, y, x)
rule UREM(x, y)                           => udiv(1, $q, x, y) ; msub(1, out, $q, y, x)
rule ROTR(x, n) when w == 64              => rorv(1, out, x, n)
rule ROTR(x, n) when w == 32              => rorv(0, out, x, n)
rule ROTL(x, n) when w == 64              => sub(1, $n, zr, n) ; rorv(1, out, x, $n)
rule ROTL(x, n) when w == 32              => sub(0, $n, zr, n) ; rorv(0, out, x, $n)
# A narrower rotation, of the low `w` bits: those, shifted both ways by the
# count modulo `w`, put together and cut back to `w` bits. (The modulo of 8 or
# 16 is a mask.)
rule ROTL(x, n) when w == 8 or w == 16    => ubfm(1, $a, x, 0, w - 1) ; and-imm(1, $k, n, logical(w - 1)) ; lslv(1, $l, $a, $k) ; constant($m, w) ; sub(1, $m, $m, $k) ; lsrv(1, $r, $a, $m) ; orr(1, out, $l, $r) ; and-imm(1, out, out, logical((1 << w) - 1))
rule ROTR(x, n) when w == 8 or w == 16    => ubfm(1, $a, x, 0, w - 1) ; and-imm(1, $k, n, logical(w - 1)) ; lsrv(1, $l, $a, $k) ; constant($m, w) ; sub(1, $m, $m, $k) ; lslv(1, $r, $a, $m) ; orr(1, out, $l, $r) ; and-imm(1, out, out, logical((1 << w) - 1))
rule ROTL(x, n) when w > 0 and w < 64     => ubfm(1, $a, x, 0, w - 1) ; constant($m, w) ; udiv(1, $q, n, $m) ; msub(1, $k, $q, $m, n) ; lslv(1, $l, $a, $k) ; sub(1, $m, $m, $k) ; lsrv(1, $r, $a, $m) ; orr(1, out, $l, $r) ; and-imm(1, out, out, logical((1 << w) - 1))
rule ROTR(x, n) when w > 0 and w < 64     => ubfm(1, $a, x, 0, w - 1) ; constant($m, w) ; udiv(1, $q, n, $m) ; msub(1, $k, $q, $m, n) ; lsrv(1, $l, $a, $k) ; sub(1, $m, $m, $k) ; lslv(1, $r, $a, $m) ; orr(1, out, $l, $r) ; and-imm(1, out, out, logical((1 << w) - 1))
rule NEG(x)                               => sub(1, out, zr, x)
rule NOT(x)                               => orn(1, out, zr, x)
rule SMULH(x, y)                          => smulh(out, x, y)
rule UMULH(x, y)                          => umulh(out, x, y)
rule SEXT(x) when bits == 64              => move(out, x)
rule SEXT(x)                              => sbfm(1, out, x, 0, bits - 1)
rule ZEXT(x) when bits == 64              => move(out, x)
rule ZEXT(x) when bits == 32              => orr(0, out, zr, x)
rule ZEXT(x)                              => ubfm(1, out, x, 0, bits - 1)
rule COPY(x) when float                   => move-float(out, x)
rule COPY(x)                              => move(out, x)

# Bits within the low `w`.
rule CLZ(x) when w == 64                  => clz(1, out, x)
rule CLZ(x) when w == 32                  => clz(0, out, x)
rule CLZ(x)                               => ubfm(0, $z, x, 0, w - 1) ; clz(0, $c, $z) ; sub-imm(0, out, $c, 32 - w)
rule CTZ(x) when w == 64                  => rbit(1, $r, x) ; clz(1, out, $r)
rule CTZ(x) when w == 32                  => rbit(0, $r, x) ; clz(0, out, $r)
rule CTZ(x)                               => orr-imm(1, $t, x, logical(1 << w)) ; rbit(1, $r, $t) ; clz(1, out, $r)
rule POPCNT(x) when w == 64               => fmov-from-gpr(1, $v, x) ; cnt-bytes($c, $v) ; add-bytes($s, $c) ; fmov-to-gpr(0, out, $s)
rule POPCNT(x)                            => ubfm(1, $z, x, 0, w - 1) ; fmov-from-gpr(1, $v, $z) ; cnt-bytes($c, $v) ; add-bytes($s, $c) ; fmov-to-gpr(0, out, $s)
rule BSWAP(x) when w == 64                => rev64(out, x)
rule BSWAP(x)                             => rev64(out, x) ; ubfm(1, out, out, 64 - w, 63)
rule BITREV(x) when w == 64               => rbit(1, out, x)
rule BITREV(x)                            => rbit(1, out, x) ; ubfm(1, out, out, 64 - w, 63)

# Comparisons: 0 or 1. A predicate's condition, and the condition that does
# not hold when it does (what `csinc` sets on).
rule ICMP(a, CONST k) when bits(a) == 64 and u12(k) => subs-imm(1, zr, a, k) ; csinc(0, out, zr, zr, cases(predicate, ne, eq, ge, gt, le, lt, hs, hi, ls, lo))
rule ICMP(a, b) when bits(a) == 64        => subs(1, zr, a, b) ; csinc(0, out, zr, zr, cases(predicate, ne, eq, ge, gt, le, lt, hs, hi, ls, lo))
rule SELECT(once ICMP(a, CONST k) as t, x, y) when bits(a) == 64 and u12(k) and not float and width == 64 => subs-imm(1, zr, a, k) ; csel(1, out, x, y, cases(t.predicate, eq, ne, lt, le, gt, ge, lo, ls, hi, hs))
rule SELECT(once ICMP(a, b) as t, x, y) when bits(a) == 64 and not float and width == 64 => subs(1, zr, a, b) ; csel(1, out, x, y, cases(t.predicate, eq, ne, lt, le, gt, ge, lo, ls, hi, hs))
rule SELECT(c, x, y) when float           => subs-imm(1, zr, c, 0) ; fcsel(sf, out, x, y, ne)
rule SELECT(c, x, y)                      => subs-imm(1, zr, c, 0) ; csel(1, out, x, y, ne)

# Whether an operation done in `w` bits overflows: at 64 by the flags or the
# high half; below, whether the 64-bit result, cut to `w` bits and extended
# again, is itself.
rule ADDO(a, b) when w == 64 and signed != 0 => adds(1, zr, a, b) ; csinc(0, out, zr, zr, vc)
rule ADDO(a, b) when w == 64              => adds(1, zr, a, b) ; csinc(0, out, zr, zr, lo)
rule SUBO(a, b) when w == 64 and signed != 0 => subs(1, zr, a, b) ; csinc(0, out, zr, zr, vc)
rule SUBO(a, b) when w == 64              => subs(1, zr, a, b) ; csinc(0, out, zr, zr, hs)
rule MULO(a, b) when w == 64 and signed != 0 => madd(1, $l, a, b, zr) ; smulh($h, a, b) ; cmp-asr(1, $h, $l, 63) ; csinc(0, out, zr, zr, eq)
rule MULO(a, b) when w == 64              => umulh($h, a, b) ; subs-imm(1, zr, $h, 0) ; csinc(0, out, zr, zr, eq)
rule ADDO(a, b) when signed != 0          => add(1, $t, a, b) ; sbfm(1, $e, $t, 0, w - 1) ; subs(1, zr, $t, $e) ; csinc(0, out, zr, zr, eq)
rule ADDO(a, b)                           => add(1, $t, a, b) ; ubfm(1, $e, $t, 0, w - 1) ; subs(1, zr, $t, $e) ; csinc(0, out, zr, zr, eq)
rule SUBO(a, b) when signed != 0          => sub(1, $t, a, b) ; sbfm(1, $e, $t, 0, w - 1) ; subs(1, zr, $t, $e) ; csinc(0, out, zr, zr, eq)
rule SUBO(a, b)                           => sub(1, $t, a, b) ; ubfm(1, $e, $t, 0, w - 1) ; subs(1, zr, $t, $e) ; csinc(0, out, zr, zr, eq)
rule MULO(a, b) when signed != 0          => madd(1, $t, a, b, zr) ; sbfm(1, $e, $t, 0, w - 1) ; subs(1, zr, $t, $e) ; csinc(0, out, zr, zr, eq)
rule MULO(a, b)                           => madd(1, $t, a, b, zr) ; ubfm(1, $e, $t, 0, w - 1) ; subs(1, zr, $t, $e) ; csinc(0, out, zr, zr, eq)

# Floating point.
rule FADD(x, y)   => fadd(sf, out, x, y)
rule FSUB(x, y)   => fsub(sf, out, x, y)
rule FMUL(x, y)   => fmul(sf, out, x, y)
rule FDIV(x, y)   => fdiv(sf, out, x, y)
rule FNEG(x)      => fneg(sf, out, x)
rule FABS(x)      => fabs(sf, out, x)
rule FSQRT(x)     => fsqrt(sf, out, x)
rule FMAX(x, y)   => fextreme(sf, 0, out, x, y)
rule FMIN(x, y)   => fextreme(sf, 1, out, x, y)
rule FMAXNM(x, y) => fextreme(sf, 2, out, x, y)
rule FMINNM(x, y) => fextreme(sf, 3, out, x, y)
rule FRINT(x)     => fround(sf, mode, out, x)
rule FMA(x, y, z) => fmadd(sf, out, x, y, z)
rule FPEXT(x)     => fcvt-to-double(out, x)
rule FPTRUNC(x)   => fcvt-to-single(out, x)
rule SITOFP(x)    => scvtf(1, sf, out, x)
rule UITOFP(x)    => ucvtf(1, sf, out, x)
rule FPTOSI(x) when bits == 64 => fcvtzs(1, sf(x), out, x)
rule FPTOSI(x)    => fcvtzs(0, sf(x), out, x) ; sbfm(1, out, out, 0, 31)
rule FPTOUI(x) when bits == 64 => fcvtzu(1, sf(x), out, x)
rule FPTOUI(x)    => fcvtzu(0, sf(x), out, x)
rule BITCAST(x) when float and float(x)          => move-float(out, x)
rule BITCAST(x) when float                       => fmov-from-gpr(sf, out, x)
rule BITCAST(x) when float(x)                    => fmov-to-gpr(sf(x), out, x)
rule BITCAST(x)                                  => move(out, x)
# After `fcmp`: the condition each predicate is, or for those that are two,
# both set and joined.
rule FCMP(a, b) when predicate == 1 => fcmp(sf(a), a, b) ; csinc(0, $l, zr, zr, pl) ; csinc(0, $g, zr, zr, le) ; orr(0, out, $l, $g)
rule FCMP(a, b) when predicate == 7 => fcmp(sf(a), a, b) ; csinc(0, $e, zr, zr, ne) ; csinc(0, $u, zr, zr, vc) ; orr(0, out, $e, $u)
rule FCMP(a, b) => fcmp(sf(a), a, b) ; csinc(0, out, zr, zr, cases(predicate, ne, 0, pl, hi, le, lt, eq, 0, vs, vc, ge, gt, ls, mi))

# Memory. A stack variable is reached from the frame register.
rule LOAD(ALLOCA as o) when o.align <= 16 and not float and width == 64 => load-word(out, x29, offset - object(o), shape & 255, (shape >> 8) & 1)
rule LOAD(ALLOCA as o) when o.align <= 16 and float         => load-float(out, x29, offset - object(o), shape & 255)
rule LOAD(once ADDI(p) as a) when not float and width == 64 => load-word(out, p, offset + a.offset, shape & 255, (shape >> 8) & 1)
rule LOAD(once ADDI(p) as a) when float   => load-float(out, p, offset + a.offset, shape & 255)
rule LOAD(p) when not float and width == 64 => load-word(out, p, offset, shape & 255, (shape >> 8) & 1)
rule LOAD(p) when float                   => load-float(out, p, offset, shape & 255)
rule STORE(ALLOCA as o, CONST z) when o.align <= 16 and z == 0 and bytes <= 8 => store-word(zr, x29, offset - object(o), bytes)
rule STORE(ALLOCA as o, v) when o.align <= 16 and float(v)  => store-float(v, x29, offset - object(o), bytes)
rule STORE(ALLOCA as o, v) when o.align <= 16 and bits(v) == 64 => store-word(v, x29, offset - object(o), bytes)
rule STORE(once ADDI(p) as a, CONST z) when z == 0 and bytes <= 8 => store-word(zr, p, offset + a.offset, bytes)
rule STORE(once ADDI(p) as a, v) when float(v) => store-float(v, p, offset + a.offset, bytes)
rule STORE(once ADDI(p) as a, v) when bits(v) == 64 => store-word(v, p, offset + a.offset, bytes)
rule STORE(p, CONST z) when z == 0 and bytes <= 8 => store-word(zr, p, offset, bytes)
rule STORE(p, v) when float(v)            => store-float(v, p, offset, bytes)
rule STORE(p, v) when bits(v) == 64       => store-word(v, p, offset, bytes)
rule ADDI(ALLOCA as o) when o.align <= 16 => address(out, x29, offset - object(o))
rule ADDI(p)                              => address(out, p, offset)
rule PTRADD(p, i) when scale == 0         => address(out, p, offset)
rule PTRADD(p, i) when scale == 1         => add(1, out, p, i) ; address(out, out, offset)
rule PTRADD(p, i) when pow2(scale)        => add-shifted(1, out, p, i, log2(scale)) ; address(out, out, offset)
rule PTRADD(p, i)                         => constant(x16, scale) ; madd(1, out, i, x16, p) ; address(out, out, offset)

# Memory other threads share, `bytes` wide: loads and stores in the one order
# every thread sees, and updates by the machine's own instructions, each
# leaving what was there, carried up with zeros. A subtraction adds the
# negation, and an `and` clears the bits the complement has.
rule ATOMIC-LOAD(p)                       => load-ordered(log2(bytes), out, p)
rule ATOMIC-STORE(p, v)                   => store-ordered(log2(bytes), v, p)
rule ATOMIC-RMW(p, v) when update == 0    => fetch(log2(bytes), 0, v, out, p)
rule ATOMIC-RMW(p, v) when update == 1    => sub(1, $n, zr, v) ; fetch(log2(bytes), 0, $n, out, p)
rule ATOMIC-RMW(p, v) when update == 2    => orn(1, $n, zr, v) ; fetch(log2(bytes), 1, $n, out, p)
rule ATOMIC-RMW(p, v) when update == 3    => fetch(log2(bytes), 3, v, out, p)
rule ATOMIC-RMW(p, v) when update == 4    => fetch(log2(bytes), 2, v, out, p)
rule ATOMIC-RMW(p, v) when update == 5    => swap(log2(bytes), v, out, p)
rule ATOMIC-RMW(p, v) when update == 6    => fetch(log2(bytes), 4, v, out, p)
rule ATOMIC-RMW(p, v) when update == 7    => fetch(log2(bytes), 5, v, out, p)
rule ATOMIC-RMW(p, v) when update == 8    => fetch(log2(bytes), 6, v, out, p)
rule ATOMIC-RMW(p, v) when update == 9    => fetch(log2(bytes), 7, v, out, p)
rule CMPXCHG(p, e, d)                     => move(out, e) ; compare-swap(log2(bytes), out, d, p)
rule FENCE                                => barrier()

# Branches: to `then` when the condition holds; the compile goes on to `else`.
rule CONDBR(once ICMP(a, CONST k) as c) when bits(a) == 64 and u12(k) => subs-imm(1, zr, a, k) ; b-cond(cases(c.predicate, eq, ne, lt, le, gt, ge, lo, ls, hi, hs), then)
rule CONDBR(once ICMP(a, b) as c) when bits(a) == 64 => subs(1, zr, a, b) ; b-cond(cases(c.predicate, eq, ne, lt, le, gt, ge, lo, ls, hi, hs), then)
rule CONDBR(c)                            => cbnz(1, c, then)
rule UNREACHABLE                          => brk(1)
