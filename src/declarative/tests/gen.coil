;;; Random programs: straight-line arithmetic, diamonds and counted loops.
;;; A program made to be linked (`linked`) also calls itself, by the symbol
;;; SELF, and the C library's routines, by the symbols below; whoever runs it
;;; says where those are.
(module tests.gen)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.var" :use [var-static])
(import "declarative.rt.graph" :as graph)
(import "declarative.backend.nodes" :as ir)

;;; What generated programs call. Each has a twin that reads only the low 32
;;; bits of its arguments, for programs whose values are 32 bits wide: the
;;; convention leaves the rest of an argument register unspecified.
(defn helper1 [(a u64)] (-> u64)
  (primitive/iadd (primitive/imul a (: 3 u64)) (: 1 u64)))

(defn helper3 [(a u64) (b u64) (c u64)] (-> u64)
  (^ (primitive/isub a b) (primitive/imul c (: 5 u64))))

(defn helper10 [(a u64) (b u64) (c u64) (d u64) (e u64) (f u64) (g u64) (h u64) (i u64) (j u64)]
  (-> u64)
  (primitive/iadd
    (primitive/iadd (primitive/iadd a (primitive/imul b (: 2 u64)))
                    (primitive/iadd (primitive/imul c (: 3 u64)) (primitive/imul d (: 4 u64))))
    (primitive/iadd (primitive/iadd (primitive/imul e (: 5 u64)) (primitive/imul f (: 6 u64)))
                    (primitive/iadd (primitive/iadd (primitive/imul g (: 7 u64)) (primitive/imul h (: 8 u64)))
                                    (primitive/iadd (primitive/imul i (: 9 u64)) (primitive/imul j (: 10 u64)))))))

(defn float-helper [(a f64) (x u64) (b f64)] (-> f64)
  (+ (* a 0.5) (- b (cast f64 (& x (: 1023 u64))))))

(defn low [(a u64)] (-> u64) (& a (: 0xFFFFFFFF u64)))

(defn helper1-32 [(a u64)] (-> u64) (helper1 (low a)))

(defn helper3-32 [(a u64) (b u64) (c u64)] (-> u64) (helper3 (low a) (low b) (low c)))

(defn helper10-32 [(a u64) (b u64) (c u64) (d u64) (e u64) (f u64) (g u64) (h u64) (i u64) (j u64)]
  (-> u64)
  (helper10 (low a) (low b) (low c) (low d) (low e) (low f) (low g) (low h) (low i) (low j)))

;;; A pointer into the scratch memory that only running the program tells:
;;; somewhere in its first 128 bytes, at a multiple of 16.
(defn offset-into [(base u64) (x u64)] (-> u64)
  (primitive/iadd base (& x (: 0x70 u64))))

;;; The symbols of a linked program: the program itself, then the routines.
(const SELF 0)
(const MEMCPY 1)
(const MEMSET 2)
(const MEMMOVE 3)
(const MEMCMP 4)
(const SYMBOLS 5)
(def SYMBOL-NAMES ["f" "memcpy" "memset" "memmove" "memcmp"])

;;; Shapes not to make, for finding which one a failure needs: a bit each.
;;;   0 early exits   1 calls of itself   2 array loops   3 pairs of words
;;;   4 C library routines   5 flags tested by diamonds   6 switches of many
;;;   or every case   7 switches on a flag
(def without (var-static i64 0))
(defn shape? [(bit i64)] (-> bool) (= (& (get without) (<< 1 bit)) 0))

(defstruct Gen
  [(g graph/Graph) (state u64) (control i32) (env (ArrayList i32)) (type i32) (budget i64)
   (memory u64) (rich bool) (window i64) (object i32) (twin i32) (vars (ArrayList i32))
   (linked bool) (early bool)])

(defn next! [(r (mut Gen))] (-> u64)
  (let [(mut x) (.state r)]
    (set! x (^ x (<< x 13)))
    (set! x (^ x (>> x 7)))
    (set! x (^ x (<< x 17)))
    (set! (.state r) x)
    x))

(defn below! [(r (mut Gen)) (n i64)] (-> i64)
  (cast i64 (% (next! (mut r)) (cast u64 n))))

(defn pick! [(r (mut Gen))] (-> i32)
  (get (.env r) (below! (mut r) (len (.env r)))))

(defn constant! [(r (mut Gen))] (-> i32)
  (let [kind (below! (mut r) 6)
        bits (ir/type-bits (.type r))
        raw (cond (= kind 0) (: 0 u64)
                  (= kind 1) (: 1 u64)
                  (= kind 2) (cast u64 (below! (mut r) 4096))
                  (= kind 3) (primitive/isub (: 0 u64) (cast u64 (below! (mut r) 4096)))
                  (= kind 4) (cast u64 (below! (mut r) 100000))
                  :else (next! (mut r)))]
    (ir/const! (mut (.g r)) (.type r) (if (>= bits 64) raw (& raw (- (<< (: 1 u64) (cast u64 bits)) 1))))))

(defn operand! [(r (mut Gen))] (-> i32)
  (if (= (below! (mut r) 4) 0) (constant! (mut r)) (pick! (mut r))))

;;; A value to divide by: never zero and never -1, since division by zero and
;;; the one signed overflow are for a program to avoid and some machines trap.
(defn divisor! [(r (mut Gen)) (t i32) (b i32)] (-> i32)
  (let [bits (ir/type-bits t)
        all (if (>= bits 64) (: 0xFFFFFFFFFFFFFFFF u64) (- (<< (: 1 u64) (cast u64 bits)) 1))]
    (ir/or! (mut (.g r)) t
            (ir/and! (mut (.g r)) t b (ir/const! (mut (.g r)) t (& all (: 0xFFFFFFFFFFFFFFFD u64))))
            (ir/const! (mut (.g r)) t 1))))

(defn binary! [(r (mut Gen)) (t i32) (op i64) (a i32) (b i32)] (-> i32)
  (cond (= op 0) (ir/add! (mut (.g r)) t a b)
        (= op 1) (ir/sub! (mut (.g r)) t a b)
        (= op 2) (ir/mul! (mut (.g r)) t a b)
        (= op 3) (ir/and! (mut (.g r)) t a b)
        (= op 4) (ir/or! (mut (.g r)) t a b)
        (= op 5) (ir/xor! (mut (.g r)) t a b)
        (= op 6) (ir/shl! (mut (.g r)) t a b)
        (= op 7) (ir/shr! (mut (.g r)) t a b)
        (= op 8) (ir/sar! (mut (.g r)) t a b)
        (= op 9) (ir/udiv! (mut (.g r)) t a (divisor! (mut r) t b))
        (= op 10) (ir/sdiv! (mut (.g r)) t a (divisor! (mut r) t b))
        (= op 11) (ir/urem! (mut (.g r)) t a (divisor! (mut r) t b))
        (= op 12) (ir/srem! (mut (.g r)) t a (divisor! (mut r) t b))
        (= op 13) (ir/neg! (mut (.g r)) t a)
        (= op 14) (ir/not! (mut (.g r)) t a)
        (= op 15) (ir/clz! (mut (.g r)) t a)
        (= op 16) (ir/ctz! (mut (.g r)) t a)
        (= op 17) (ir/popcnt! (mut (.g r)) t a)
        (= op 18) (ir/smin! (mut (.g r)) t a b)
        (= op 19) (ir/smax! (mut (.g r)) t a b)
        (= op 20) (ir/umin! (mut (.g r)) t a b)
        (= op 21) (ir/umax! (mut (.g r)) t a b)
        (= op 22) (ir/bswap! (mut (.g r)) t a)
        (= op 23) (ir/rol! (mut (.g r)) t a b)
        (= op 24) (ir/ror! (mut (.g r)) t a b)
        (= op 25) (ir/umulh! (mut (.g r)) t a b)
        (= op 26) (ir/smulh! (mut (.g r)) t a b)
        :else (ir/bitrev! (mut (.g r)) t a)))

;;; How many of `binary!`'s operations a type has: the last six need 32 bits.
(defn operations [(t i32)] (-> i64)
  (if (>= (ir/type-bits t) 32) 28 22))

(defn compare! [(r (mut Gen)) (op i64) (a i32) (b i32)] (-> i32)
  (cond (= op 0) (ir/eq! (mut (.g r)) a b)
        (= op 1) (ir/ne! (mut (.g r)) a b)
        (= op 2) (ir/lt! (mut (.g r)) a b)
        (= op 3) (ir/le! (mut (.g r)) a b)
        (= op 4) (ir/ult! (mut (.g r)) a b)
        (= op 5) (ir/ule! (mut (.g r)) a b)
        (= op 6) (ir/saddo! (mut (.g r)) a b)
        (= op 7) (ir/uaddo! (mut (.g r)) a b)
        (= op 8) (ir/ssubo! (mut (.g r)) a b)
        (= op 9) (ir/usubo! (mut (.g r)) a b)
        (= op 10) (ir/smulo! (mut (.g r)) a b)
        :else (ir/umulo! (mut (.g r)) a b)))

;;; How many of `compare!`'s tests a type has: overflow needs 32 bits.
(defn tests [(r (mut Gen)) (t i32)] (-> i64)
  (if (and (.rich r) (>= (ir/type-bits t) 32)) 12 6))

(defn arithmetic! [(r (mut Gen))] (-> i32)
  (let [a (pick! (mut r))
        b (operand! (mut r))
        count (if (.rich r) (operations (.type r)) 9)
        op (below! (mut r) (if (.rich r) (+ count 1) 9))]
    (if (= op count)
        (ir/cond! (mut (.g r)) (.type r) (comparison! (mut r)) a b)
        (binary! (mut r) (.type r) op a b))))

;;; A type narrower than the program's, or as wide.
(defn other-type! [(r (mut Gen))] (-> i32)
  (let [k (below! (mut r) (if (>= (ir/type-bits (.type r)) 64) 6 4))]
    (cond (= k 0) ir/T-I8 (= k 1) ir/T-U8 (= k 2) ir/T-I16 (= k 3) ir/T-U16 (= k 4) ir/T-I32
          :else ir/T-U32)))

(defn widen! [(r (mut Gen)) (v i32)] (-> i32)
  (if (= (below! (mut r) 2) 0)
      (ir/sext! (mut (.g r)) (.type r) v)
      (ir/zext! (mut (.g r)) (.type r) v)))

;;; A few operations at another width: cut two values down, compute, compare,
;;; choose, and carry the result back up.
(defn narrow! [(r (mut Gen))] (-> i32)
  (let [t (other-type! (mut r))
        (mut a) (ir/trunc! (mut (.g r)) t (pick! (mut r)))
        b (ir/trunc! (mut (.g r)) t (pick! (mut r)))
        steps (+ 1 (below! (mut r) 3))]
    (for _ (range 0 steps) (set! a (binary! (mut r) t (below! (mut r) (operations t)) a b)))
    (let [flag (compare! (mut r) (below! (mut r) (tests (mut r) t)) a b)
          kind (below! (mut r) 4)]
      (cond
        (= kind 0) (widen! (mut r) a)
        (= kind 1) (widen! (mut r) (ir/cond! (mut (.g r)) t flag a b))
        (= kind 2)
          (ir/zext! (mut (.g r)) (.type r)
                    (ir/xor! (mut (.g r)) ir/T-BOOL (ir/not! (mut (.g r)) ir/T-BOOL flag)
                             (ir/trunc! (mut (.g r)) ir/T-BOOL (pick! (mut r)))))
        :else (ir/cond! (mut (.g r)) (.type r)
                        (ir/and! (mut (.g r)) ir/T-BOOL flag (compare! (mut r) (below! (mut r) (tests (mut r) t)) b a))
                        (pick! (mut r)) (pick! (mut r)))))))

;;; A floating constant: ordinary values, the ends, and what is not a number.
(defn float-constant! [(r (mut Gen)) (ft i32)] (-> i32)
  (let [k (below! (mut r) 8)
        wide (cond (= k 0) (: 0 u64)
                   (= k 1) (: 0x3FF0000000000000 u64)
                   (= k 2) (: 0xBFF8000000000000 u64)
                   (= k 3) (: 0x4024000000000000 u64)
                   (= k 4) (: 0x43E0000000000000 u64)
                   (= k 5) (: 0x7FF0000000000000 u64)
                   (= k 6) (: 0x7FF8000000000000 u64)
                   :else (: 0x3F50624DD2F1A9FC u64))]
    (if (= ft ir/T-F64)
        (ir/const! (mut (.g r)) ft wide)
        (ir/ftrunc! (mut (.g r)) ft (ir/const! (mut (.g r)) ir/T-F64 wide)))))

(defn float-operand! [(r (mut Gen)) (ft i32)] (-> i32)
  (let [k (below! (mut r) 4)]
    (cond (= k 0) (float-constant! (mut r) ft)
          (= k 1) (ir/uitof! (mut (.g r)) ft (pick! (mut r)))
          :else (ir/sitof! (mut (.g r)) ft (pick! (mut r))))))

;;; A floating value back as one of the program's integers.
(defn float-result! [(r (mut Gen)) (v i32)] (-> i32)
  (if (= (below! (mut r) 3) 0)
      (ir/trunc! (mut (.g r)) (.type r)
                 (ir/ftoui! (mut (.g r)) (cast i32 (if (>= (ir/type-bits (.type r)) 64) ir/T-U64 ir/T-U32)) v))
      (ir/ftosi! (mut (.g r)) (.type r) v)))

;;; Some floating point: integers in, arithmetic, a comparison or a choice or a
;;; call, and an integer out. Nothing looks at the bits of a value that may not
;;; be a number, since which such value arithmetic gives is the machine's choice.
(defn float! [(r (mut Gen))] (-> i32)
  (let [ft (cast i32 (if (= (below! (mut r) 2) 0) ir/T-F32 ir/T-F64))
        (mut a) (float-operand! (mut r) ft)
        b (float-operand! (mut r) ft)
        steps (+ 1 (below! (mut r) 3))]
    (for _ (range 0 steps)
      (let [op (below! (mut r) 17)]
        (set! a (cond (= op 7) (ir/fmin! (mut (.g r)) ft a b)
                      (= op 8) (ir/fmax! (mut (.g r)) ft a b)
                      (= op 9) (ir/fmin-number! (mut (.g r)) ft a b)
                      (= op 10) (ir/fmax-number! (mut (.g r)) ft a b)
                      (= op 11) (ir/round-even! (mut (.g r)) ft a)
                      (= op 12) (ir/round-up! (mut (.g r)) ft a)
                      (= op 13) (ir/round-down! (mut (.g r)) ft a)
                      (= op 14) (ir/round-zero! (mut (.g r)) ft a)
                      (= op 15) (ir/round-away! (mut (.g r)) ft a)
                      (= op 16) (ir/fma! (mut (.g r)) ft a b (float-operand! (mut r) ft))
                      (= op 0) (ir/fadd! (mut (.g r)) ft a b)
                      (= op 1) (ir/fsub! (mut (.g r)) ft a b)
                      (= op 2) (ir/fmul! (mut (.g r)) ft a b)
                      (= op 3) (ir/fdiv! (mut (.g r)) ft a b)
                      (= op 4) (ir/fneg! (mut (.g r)) ft a)
                      (= op 5) (ir/fabs! (mut (.g r)) ft a)
                      :else (ir/fsqrt! (mut (.g r)) ft a)))))
    (let [cmp (below! (mut r) 4)
          flag (cond (= cmp 0) (ir/feq! (mut (.g r)) a b)
                     (= cmp 1) (ir/fne! (mut (.g r)) a b)
                     (= cmp 2) (ir/flt! (mut (.g r)) a b)
                     :else (ir/fle! (mut (.g r)) b a))
          kind (below! (mut r) 5)]
      (cond
        (= kind 0) (float-result! (mut r) a)
        (= kind 1) (ir/cond! (mut (.g r)) (.type r) flag (pick! (mut r)) (pick! (mut r)))
        (= kind 2) (float-result! (mut r) (ir/cond! (mut (.g r)) ft flag a b))
        (= kind 3)
          ; Across widths and through a call that takes and gives floating point.
          (let [wide-a (if (= ft ir/T-F32) (ir/fext! (mut (.g r)) ir/T-F64 a) a)
                wide-b (if (= ft ir/T-F32) (ir/fext! (mut (.g r)) ir/T-F64 b) b)
                target (ir/const! (mut (.g r)) ir/T-PTR
                                  (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of float-helper))))
                node (ir/call-node! (mut (.g r)) 0 (.control r) target 3)]
            (graph/set-input! (mut (.g r)) node 2 wide-a)
            (graph/set-input! (mut (.g r)) node 3 (ir/zext! (mut (.g r)) ir/T-U64 (ir/trunc! (mut (.g r)) ir/T-U8 (pick! (mut r)))))
            (graph/set-input! (mut (.g r)) node 4 wide-b)
            (set! (.control r) node)
            (float-result! (mut r) (ir/result! (mut (.g r)) ir/T-F64 0 node)))
        :else
          ; The bits of an integer as a floating value, which may be anything at all.
          (let [bits (if (= ft ir/T-F64)
                         (ir/zext! (mut (.g r)) ir/T-U64 (ir/trunc! (mut (.g r)) ir/T-U32 (pick! (mut r))))
                         (ir/trunc! (mut (.g r)) ir/T-U32 (pick! (mut r))))
                odd (ir/bitcast! (mut (.g r)) ft bits)]
            (float-result! (mut r) (ir/fmul! (mut (.g r)) ft odd a)))))))

;;; An address inside the scratch memory, right for a value of `bits` bits.
(defn address! [(r (mut Gen)) (bits i64)] (-> i32)
  (let [size (/ (+ bits 7) 8)
        own (and (!= (.object r) 0) (= (below! (mut r) 3) 0))
        offset (* size (below! (mut r) (/ (if own 64 256) size)))
        base (cond (and own (!= (.twin r) 0) (= (below! (mut r) 2) 0)) (.twin r)
                   own (.object r)
                   :else (ir/const! (mut (.g r)) ir/T-PTR (.memory r)))]
    (if (and (not own) (= (below! (mut r) 5) 0))
        (ir/const! (mut (.g r)) ir/T-PTR (+ (.memory r) (cast u64 offset)))
        (ir/add! (mut (.g r)) ir/T-PTR base (ir/const! (mut (.g r)) ir/T-PTR (cast u64 offset))))))

(defn memory-type! [(r (mut Gen))] (-> i32)
  (let [k (below! (mut r) 8)]
    (cond (= k 0) ir/T-I8 (= k 1) ir/T-U8 (= k 2) ir/T-I16 (= k 3) ir/T-U16 (= k 4) ir/T-I32
          (= k 5) ir/T-U32 (= k 6) ir/T-I64 :else ir/T-U64)))

(defn write! [(r (mut Gen))] (-> void)
  (let [t (memory-type! (mut r))
        bits (ir/type-bits t)
        v (pick! (mut r))
        fitted (cond (< bits (ir/type-bits (.type r))) (ir/trunc! (mut (.g r)) t v)
                     (> bits (ir/type-bits (.type r))) (ir/zext! (mut (.g r)) t v)
                     :else v)]
    (set! (.control r) (ir/store-node! (mut (.g r)) 0 (.control r) (address! (mut r) bits) fitted))))

(defn read! [(r (mut Gen))] (-> i32)
  (let [t (memory-type! (mut r))
        bits (ir/type-bits t)
        v (ir/load-node! (mut (.g r)) t 0 (.control r) (address! (mut r) bits))]
    (set! (.control r) v)
    ; TRUNC to a type as wide is how a value changes between signed and unsigned.
    (if (< bits (ir/type-bits (.type r)))
        (widen! (mut r) v)
        (ir/trunc! (mut (.g r)) (.type r) v))))

(defn comparison! [(r (mut Gen))] (-> i32)
  (let [a (pick! (mut r))
        b (operand! (mut r))]
    (compare! (mut r) (below! (mut r) (tests (mut r) (.type r))) a b)))

;;; A call to one of the helpers, with one, three or ten arguments.
(defn call! [(r (mut Gen))] (-> i32)
  (let [kind (below! (mut r) 3)
        narrow (< (ir/type-bits (.type r)) 64)
        count (cond (= kind 0) 1 (= kind 1) 3 :else 10)
        address (cond (= kind 0) (if narrow (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper1-32)))
                                     (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper1))))
                      (= kind 1) (if narrow (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper3-32)))
                                     (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper3))))
                      :else (if narrow (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper10-32)))
                                (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper10)))))
        target (ir/const! (mut (.g r)) ir/T-PTR address)
        node (ir/call-node! (mut (.g r)) 0 (.control r) target count)]
    ; The interpreter passes every integer as 64 bits, which is not how a
    ; narrower one goes on the stack everywhere; so each goes as 64 bits here.
    (for i (range 0 count)
      (let [a (operand! (mut r))]
        (graph/set-input! (mut (.g r)) node (+ i 2) (if narrow (ir/zext! (mut (.g r)) ir/T-U64 a) a))))
    (set! (.control r) node)
    (ir/result! (mut (.g r)) (.type r) 0 node)))

;;; A value of the program's type as one of type `t`.
(defn fitted! [(r (mut Gen)) (t i32) (v i32)] (-> i32)
  (let [bits (ir/type-bits t)]
    (cond (> bits (ir/type-bits (.type r))) (ir/zext! (mut (.g r)) t v)
          (= t (.type r)) v
          :else (ir/trunc! (mut (.g r)) t v))))

;;; Something done to memory the way threads that share it do: an ordered load
;;; or store, a fence, a swap, a compare-and-swap, or one of the updates.
(defn shared! [(r (mut Gen))] (-> void)
  (let [t (memory-type! (mut r))
        bits (ir/type-bits t)
        kind (below! (mut r) 16)
        c (.control r)
        address (address! (mut r) bits)
        v (fitted! (mut r) t (pick! (mut r)))
        node (cond (= kind 0) (ir/atomic-load! (mut (.g r)) t c address)
                   (= kind 1) (ir/atomic-store! (mut (.g r)) c address v)
                   (= kind 2) (ir/fence! (mut (.g r)) c)
                   (= kind 3) (ir/swap! (mut (.g r)) t c address v)
                   (= kind 4) (ir/fetch-add! (mut (.g r)) t c address v)
                   (= kind 5) (ir/fetch-sub! (mut (.g r)) t c address v)
                   (= kind 6) (ir/fetch-and! (mut (.g r)) t c address v)
                   (= kind 7) (ir/fetch-nand! (mut (.g r)) t c address v)
                   (= kind 8) (ir/fetch-or! (mut (.g r)) t c address v)
                   (= kind 9) (ir/fetch-xor! (mut (.g r)) t c address v)
                   (= kind 10) (ir/fetch-smax! (mut (.g r)) t c address v)
                   (= kind 11) (ir/fetch-smin! (mut (.g r)) t c address v)
                   (= kind 12) (ir/fetch-umax! (mut (.g r)) t c address v)
                   (= kind 13) (ir/fetch-umin! (mut (.g r)) t c address v)
                   ; Half the time what is expected is what was just read there.
                   (= kind 14) (ir/cas! (mut (.g r)) t c address (fitted! (mut r) t (pick! (mut r))) v)
                   :else (let [seen (ir/atomic-load! (mut (.g r)) t c address)]
                           (ir/cas! (mut (.g r)) t seen address seen v)))]
    (set! (.control r) node)
    (unless (or (= kind 1) (= kind 2))
      (push! (mut (.env r))
             (if (< bits (ir/type-bits (.type r)))
                 (widen! (mut r) node)
                 (ir/trunc! (mut (.g r)) (.type r) node))))))

;;; A few statements: new values, calls, diamonds and counted loops.
(defn statements! [(r (mut Gen)) (depth i64)] (-> void)
  (let [count (+ 1 (below! (mut r) 6))]
    (for _ (range 0 count)
      (let [choice (below! (mut r) (if (.rich r) (if (.linked r) 31 29) 10))]
        (set! (.budget r) (- (.budget r) 1))
        (cond
          (or (< choice (if (.rich r) 5 6)) (>= depth 3) (< (.budget r) 0))
            (push! (mut (.env r)) (arithmetic! (mut r)))
          (and (.rich r) (< choice 6)) (push! (mut (.env r)) (call! (mut r)))
          (< choice 8) (diamond! (mut r) depth)
          (< choice 10) (counted-loop! (mut r) depth)
          (< choice 12) (push! (mut (.env r)) (narrow! (mut r)))
          (= choice 12) (write! (mut r))
          (= choice 13) (push! (mut (.env r)) (read! (mut r)))
          (= choice 16) (if (< depth 2) (switch! (mut r) depth) (trap! (mut r)))
          (= choice 17) (trap! (mut r))
          (or (= choice 21) (= choice 22)) (shared! (mut r))
          ; Memory reserved as the function runs needs its frame open from the
          ; start, which a function that may leave early is written to avoid.
          (= choice 23) (push! (mut (.env r)) (if (.early r) (arithmetic! (mut r)) (reserve! (mut r))))
          (= choice 26) (block! (mut r))
          (and (or (= choice 27) (and (= choice 28) (not (.linked r)))) (shape? 2)) (array-loop! (mut r))
          (and (or (= choice 28) (= choice 29)) (.linked r) (shape? 3)) (pair! (mut r))
          (and (= choice 30) (shape? 4)) (routine! (mut r))
          (>= choice 27) (push! (mut (.env r)) (arithmetic! (mut r)))
          (or (= choice 24) (= choice 25)) (bottom-loop! (mut r) depth)
          (= choice 18)
            (set! (.control r)
                  (ir/store-node! (mut (.g r)) 0 (.control r) (get (.vars r) (below! (mut r) 3)) (pick! (mut r))))
          (or (= choice 19) (= choice 20))
            (let [v (ir/load-node! (mut (.g r)) (.type r) 0 (.control r) (get (.vars r) (below! (mut r) 3)))]
              (set! (.control r) v)
              (push! (mut (.env r)) v))
          :else (push! (mut (.env r)) (float! (mut r))))
        ; With a window, old values fall out of scope, as locals do in real code.
        (when (and (> (.window r) 0) (= depth 0))
          (while (> (len (.env r)) (.window r))
            (let [gone (below! (mut r) (len (.env r)))]
              (set! (mut (.env r)) gone (get (.env r) (- (len (.env r)) 1)))
              (pop! (mut (.env r))))))))))

;;; A read of memory as the program's own type: the load itself is the value.
(defn last-read! [(r (mut Gen))] (-> i32)
  (let [v (ir/load-node! (mut (.g r)) (.type r) 0 (.control r) (address! (mut r) (ir/type-bits (.type r))))]
    (set! (.control r) v)
    v))

;;; if (cond) { … } else { … }, then phis for the values either side changed.
(defn diamond! [(r (mut Gen)) (depth i64)] (-> void)
  ; One rich diamond in five asks about two constants, as a function put in
  ; place of a call with constant arguments does: one side can never run.
  (let [settled (and (.rich r) (= (below! (mut r) 5) 0))
        ; One rich diamond in five tests a flag set on the ways just before.
        flagged (and (.rich r) (not settled) (= (below! (mut r) 4) 0) (shape? 5))
        test (cond settled
                     (compare! (mut r) (below! (mut r) (tests (mut r) (.type r))) (constant! (mut r)) (constant! (mut r)))
                   flagged (decided! (mut r) ir/T-BOOL 2 true)
                   :else (comparison! (mut r)))
        ; One rich diamond in three reads memory just before it parts, a value
        ; only the first way then sees: a load that can be made on that way alone.
        early (if (and (.rich r) (= (below! (mut r) 3) 0)) (read! (mut r)) 0)
        ; One rich diamond in four ends each way by reading memory, and what was
        ; read is itself what the phi takes: the last thing in the flow of
        ; control on a way is then also a value where the ways meet. (When one
        ; way can never run, taking it out must not disturb the other.)
        last (and (.rich r) (= (below! (mut r) 4) 0))
        branch (ir/if! (mut (.g r)) (.control r) test)
        base (len (.env r))
        yes (ir/true! (mut (.g r)) branch)
        no (ir/false! (mut (.g r)) branch)]
    (set! (.control r) yes)
    (when (!= early 0)
      (push! (mut (.env r)) early)
      (push! (mut (.env r)) (ir/add! (mut (.g r)) (.type r) early (pick! (mut r)))))
    (statements! (mut r) (+ depth 1))
    (let [yes-a (if last (last-read! (mut r)) (pick! (mut r)))
          yes-end (.control r)
          yes-b (pick! (mut r))]
      (while (> (len (.env r)) base) (pop! (mut (.env r))))
      (set! (.control r) no)
      (statements! (mut r) (+ depth 1))
      (let [no-a (if last (last-read! (mut r)) (pick! (mut r)))
            no-end (.control r)
            no-b (pick! (mut r))
            region (ir/region! (mut (.g r)) 2)
            pa (ir/phi! (mut (.g r)) (.type r) region 2)
            pb (ir/phi! (mut (.g r)) (.type r) region 2)]
        (while (> (len (.env r)) base) (pop! (mut (.env r))))
        ; In either order: what a node's uses are walked in follows the order
        ; they were made in, and taking out a way that can never run once went
        ; wrong only when the region's use of a load came before the phi's.
        (let [phi-first (= (below! (mut r) 2) 0)]
          (when phi-first
            (graph/set-input! (mut (.g r)) pa 1 yes-a)
            (graph/set-input! (mut (.g r)) pa 2 no-a))
          (graph/set-input! (mut (.g r)) region 0 yes-end)
          (graph/set-input! (mut (.g r)) region 1 no-end)
          (unless phi-first
            (graph/set-input! (mut (.g r)) pa 1 yes-a)
            (graph/set-input! (mut (.g r)) pa 2 no-a)))
        (graph/set-input! (mut (.g r)) pb 1 yes-b)
        (graph/set-input! (mut (.g r)) pb 2 no-b)
        (push! (mut (.env r)) pa)
        (push! (mut (.env r)) pb)
        (set! (.control r) region)))))

;;; Ways that part on a test and meet again at once, each bringing a constant
;;; below `limit` (of type `t`) and, when `extra`, other values too, as code
;;; that sets a flag on each side and then asks it does. The constant is
;;; returned; the other values go into scope.
(defn decided! [(r (mut Gen)) (t i32) (limit i64) (extra bool)] (-> i32)
  (let [branch (ir/if! (mut (.g r)) (.control r) (comparison! (mut r)))
        meet (ir/region! (mut (.g r)) 2)
        chosen (ir/phi! (mut (.g r)) t meet 2)]
    (graph/set-input! (mut (.g r)) meet 0 (ir/true! (mut (.g r)) branch))
    (graph/set-input! (mut (.g r)) meet 1 (ir/false! (mut (.g r)) branch))
    (graph/set-input! (mut (.g r)) chosen 1 (ir/const! (mut (.g r)) t (cast u64 (below! (mut r) limit))))
    (graph/set-input! (mut (.g r)) chosen 2 (ir/const! (mut (.g r)) t (cast u64 (below! (mut r) limit))))
    ; What each way brings is chosen from before the ways: a phi of the region
    ; is no value on a way into it.
    (when extra
      (let [count (+ 1 (below! (mut r) 2))
            (mut made) (ArrayList::new [i32] (malloc-allocator))]
        (for _ (range 0 count)
          (let [v (ir/phi! (mut (.g r)) (.type r) meet 2)]
            (graph/set-input! (mut (.g r)) v 1 (pick! (mut r)))
            (graph/set-input! (mut (.g r)) v 2 (pick! (mut r)))
            (push! (mut made) v)))
        (for v made (push! (mut (.env r)) v))
        (free! (mut made))))
    (set! (.control r) meet)
    chosen))

;;; A switch, then a phi of what each arm made. Three kinds:
;;;   switch (v & 7) { case 0: … case 3: … case 5: … default: … }
;;;   switch (v & 2^m-1) with a case for every value and a default that traps
;;;   five to twelve cases, close together (a table) or far apart (halved)
(defn switch! [(r (mut Gen)) (depth i64)] (-> void)
  (let [t (.type r)
        kind (if (and (.rich r) (shape? 6)) (below! (mut r) 3) 0)
        (mut values) (ArrayList::new [u64] (malloc-allocator))
        (mut mask) (: 7 u64)]
    (cond
      (= kind 0) (do (push! (mut values) 0) (push! (mut values) 3) (push! (mut values) 5))
      (= kind 1)
        (do (set! mask (- (<< (: 1 u64) (cast u64 (+ 1 (below! (mut r) 3)))) 1))
            (for v (range 0 (+ (cast i64 mask) 1)) (push! (mut values) (cast u64 v))))
      :else
        (let [count (+ 5 (below! (mut r) 8))
              dense (= (below! (mut r) 2) 0)
              step (if dense (+ 1 (below! (mut r) 2)) (+ 7 (below! (mut r) 40)))
              start (below! (mut r) 20)]
          (for j (range 0 count) (push! (mut values) (cast u64 (+ start (* j step)))))
          (set! mask (if (= (below! (mut r) 2) 0) (: 511 u64) (: 15 u64)))))
    ; The highest case and two past it: a selector chosen by a branch may miss every case.
    (let [high (get values (- (len values) 1))
          trapping (= kind 1)
          ; One switch in three is on a constant chosen by a branch just before
          ; it, as a match on a value just made is: each way in knows its case.
          selector (if (= (below! (mut r) 3) 0)
                       (decided! (mut r) t (if trapping (+ (cast i64 mask) 1) (+ (cast i64 high) 3)) (and (.rich r) (shape? 7)))
                       (ir/and! (mut (.g r)) t (pick! (mut r)) (ir/const! (mut (.g r)) t mask)))
          node (ir/switch! (mut (.g r)) (.control r) selector)
          base (len (.env r))
          arms (+ (len values) (if trapping 0 1))
          region (ir/region! (mut (.g r)) arms)
          merged (ir/phi! (mut (.g r)) t region arms)]
      ; A default that is never taken stops the program.
      (when trapping (ir/trap! (mut (.g r)) (ir/default! (mut (.g r)) node)))
      (for arm (range 0 arms)
        (set! (.control r)
              (if (< arm (len values))
                  (ir/case! (mut (.g r)) (get values arm) node)
                  (ir/default! (mut (.g r)) node)))
        (statements! (mut r) (+ depth 1))
        ; Arms of a rich switch end by reading memory one time in three, and
        ; what was read is what the phi takes, put there before or after the
        ; region's input (as in `diamond!`).
        (let [v (if (and (.rich r) (= (below! (mut r) 3) 0)) (last-read! (mut r)) (pick! (mut r)))]
          (if (= (below! (mut r) 2) 0)
              (do (graph/set-input! (mut (.g r)) merged (+ arm 1) v)
                  (graph/set-input! (mut (.g r)) region arm (.control r)))
              (do (graph/set-input! (mut (.g r)) region arm (.control r))
                  (graph/set-input! (mut (.g r)) merged (+ arm 1) v))))
        (while (> (len (.env r)) base) (pop! (mut (.env r)))))
      (free! (mut values))
      (push! (mut (.env r)) merged)
      (set! (.control r) region))))

;;; A value of the program's type as a 64-bit counter's.
;;; Counters are words, as Coil's are: of the type addresses are.
(defn as-counter! [(r (mut Gen)) (v i32)] (-> i32)
  (if (>= (ir/type-bits (.type r)) 64) (ir/trunc! (mut (.g r)) ir/T-PTR v) (ir/zext! (mut (.g r)) ir/T-PTR v)))

;;; A pointer into the scratch memory that a call gives, so not a constant.
(defn pointer! [(r (mut Gen))] (-> i32)
  (let [target (ir/const! (mut (.g r)) ir/T-PTR (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of offset-into))))
        node (ir/call-node! (mut (.g r)) 0 (.control r) target 2)]
    (graph/set-input! (mut (.g r)) node 2 (ir/const! (mut (.g r)) ir/T-PTR (.memory r)))
    (graph/set-input! (mut (.g r)) node 3 (fitted! (mut r) ir/T-U64 (pick! (mut r))))
    (set! (.control r) node)
    (ir/result! (mut (.g r)) ir/T-PTR 0 node)))

;;; Two whole words next to each other, read or written one straight after
;;; the other, through a pointer not known until the program runs.
(defn pair! [(r (mut Gen))] (-> void)
  (let [p (pointer! (mut r))
        k (* 8 (below! (mut r) 8))
        first (ir/add! (mut (.g r)) ir/T-PTR p (ir/const! (mut (.g r)) ir/T-PTR (cast u64 k)))
        second (ir/add! (mut (.g r)) ir/T-PTR p (ir/const! (mut (.g r)) ir/T-PTR (cast u64 (+ k 8))))]
    (if (= (below! (mut r) 2) 0)
        (do (set! (.control r) (ir/store-node! (mut (.g r)) 0 (.control r) first (fitted! (mut r) ir/T-U64 (pick! (mut r)))))
            (set! (.control r) (ir/store-node! (mut (.g r)) 0 (.control r) second (fitted! (mut r) ir/T-U64 (pick! (mut r))))))
        (let [a (ir/load-node! (mut (.g r)) ir/T-U64 0 (.control r) first)
              b (ir/load-node! (mut (.g r)) ir/T-U64 0 a second)]
          (set! (.control r) b)
          (push! (mut (.env r)) (ir/trunc! (mut (.g r)) (.type r) a))
          (push! (mut (.env r)) (ir/trunc! (mut (.g r)) (.type r) b))))))

;;; A call of one of the C library's routines, on the scratch memory: memcpy
;;; between its two halves, memmove anywhere, memset, or memcmp asked only
;;; whether the bytes were the same or only which way they differ. The size
;;; is mostly a constant, and one time in five not known until the program runs.
(defn routine! [(r (mut Gen))] (-> void)
  (let [kind (below! (mut r) 4)
        known (!= (below! (mut r) 5) 0)
        ; Where the ends are placed leaves room for as many bytes as the size can be.
        bytes (cond (not known) 31 (= (below! (mut r) 3) 0) (+ 17 (below! (mut r) 100)) :else (below! (mut r) 17))
        swap (= (below! (mut r) 2) 0)
        a (if (= kind 0) (below! (mut r) (- 128 bytes)) (below! (mut r) (- 256 bytes)))
        b (if (= kind 0) (+ 128 (below! (mut r) (- 128 bytes))) (below! (mut r) (- 256 bytes)))
        base (ir/const! (mut (.g r)) ir/T-PTR (.memory r))
        dst (ir/add! (mut (.g r)) ir/T-PTR base (ir/const! (mut (.g r)) ir/T-PTR (cast u64 (if swap b a))))
        src (ir/add! (mut (.g r)) ir/T-PTR base (ir/const! (mut (.g r)) ir/T-PTR (cast u64 (if swap a b))))
        size (if known
                 (ir/const! (mut (.g r)) ir/T-U64 (cast u64 bytes))
                 (ir/and! (mut (.g r)) ir/T-U64 (fitted! (mut r) ir/T-U64 (pick! (mut r))) (ir/const! (mut (.g r)) ir/T-U64 31)))
        symbol (cond (= kind 0) MEMCPY (= kind 1) MEMMOVE (= kind 2) MEMSET :else MEMCMP)
        node (ir/call-node! (mut (.g r)) 0 (.control r) (ir/extern! (mut (.g r)) (cast u64 symbol)) 3)]
    (graph/set-input! (mut (.g r)) node 2 dst)
    (graph/set-input! (mut (.g r)) node 3 (if (= kind 2) (fitted! (mut r) ir/T-U64 (pick! (mut r))) src))
    (graph/set-input! (mut (.g r)) node 4 size)
    (set! (.control r) node)
    (cond
      (= kind 3)
        (let [answer (ir/result! (mut (.g r)) ir/T-I32 0 node)
              zero (ir/const! (mut (.g r)) ir/T-I32 0)
              flag (if (= (below! (mut r) 3) 0) (ir/lt! (mut (.g r)) answer zero) (ir/eq! (mut (.g r)) answer zero))]
          (push! (mut (.env r)) (ir/zext! (mut (.g r)) (.type r) flag)))
      ; What a copy or a fill answers is where it wrote.
      (= (below! (mut r) 3) 0)
        (push! (mut (.env r))
               (ir/trunc! (mut (.g r)) (.type r)
                          (ir/sub! (mut (.g r)) ir/T-PTR (ir/result! (mut (.g r)) ir/T-PTR 0 node)
                                   (ir/const! (mut (.g r)) ir/T-PTR (.memory r)))))
      :else (do))))

;;; for (i = 0; i < n; i++) x = x + a[i] (and sometimes b[i] = x), where the
;;; counter is used only to make addresses: the addresses can be stepped
;;; themselves. Sometimes the loop also reads a word that does not change.
;;; One time in two the loop may be left from its middle, and the way out
;;; reads c[i] through a pointer it is only given there: a base made outside
;;; the loop that is no base to step from on the way in.
(defn array-loop! [(r (mut Gen))] (-> void)
  (let [t (.type r)
        head (ir/loop! (mut (.g r)) 2)
        i (ir/phi! (mut (.g r)) ir/T-PTR head 2)
        x (ir/phi! (mut (.g r)) t head 2)
        bound (ir/and! (mut (.g r)) ir/T-PTR (as-counter! (mut r) (pick! (mut r))) (ir/const! (mut (.g r)) ir/T-PTR 15))
        test (if (= (below! (mut r) 2) 0) (ir/lt! (mut (.g r)) i bound) (ir/ult! (mut (.g r)) i bound))
        branch (ir/if! (mut (.g r)) head test)
        body (ir/true! (mut (.g r)) branch)
        exit (ir/false! (mut (.g r)) branch)
        shifted (= (below! (mut r) 2) 0)
        shift (+ 1 (below! (mut r) 3))
        step (if shifted (<< 1 shift) (get [3 5 6 12] (below! (mut r) 4)))
        scaled (if shifted
                   (ir/shl! (mut (.g r)) ir/T-PTR i (ir/const! (mut (.g r)) ir/T-PTR (cast u64 shift)))
                   (ir/mul! (mut (.g r)) ir/T-PTR i (ir/const! (mut (.g r)) ir/T-PTR (cast u64 step))))
        ; The most bytes a group of addresses reaches from its base.
        reach (+ (* 15 step) 8)
        from-call (and (.linked r) (<= reach 128) (= (below! (mut r) 3) 0))
        base (if from-call
                 (pointer! (mut r))
                 (ir/const! (mut (.g r)) ir/T-PTR (+ (.memory r) (cast u64 (below! (mut r) (- 256 reach))))))
        leaving (= (below! (mut r) 2) 0)
        x0 (pick! (mut r))
        (mut out) (: 0 i32)
        (mut out-x) (: 0 i32)]
    (graph/set-input! (mut (.g r)) head 0 (.control r))
    (graph/set-input! (mut (.g r)) i 1 (ir/const! (mut (.g r)) ir/T-PTR 0))
    (graph/set-input! (mut (.g r)) x 1 x0)
    (set! (.control r) body)
    (let [steady (if (= (below! (mut r) 2) 0)
                     (let [v (ir/load-node! (mut (.g r)) t 0 (.control r)
                                            (ir/const! (mut (.g r)) ir/T-PTR (+ (.memory r) (cast u64 (* 8 (below! (mut r) 28))))))]
                       (set! (.control r) v)
                       v)
                     0)
          lt (memory-type! (mut r))
          read (ir/load-node! (mut (.g r)) lt 0 (.control r) (ir/add! (mut (.g r)) ir/T-PTR base scaled))]
      (set! (.control r) read)
      (let [wide (if (< (ir/type-bits lt) (ir/type-bits t)) (widen! (mut r) read) (ir/trunc! (mut (.g r)) t read))
            mixed (binary! (mut r) t (below! (mut r) 6) x wide)
            next-x (if (!= steady 0) (ir/add! (mut (.g r)) t mixed steady) mixed)]
        (when leaving
          (let [stop (ir/if! (mut (.g r)) (.control r)
                             (ir/eq! (mut (.g r)) (ir/and! (mut (.g r)) t wide (ir/const! (mut (.g r)) t 7))
                                     (ir/const! (mut (.g r)) t 3)))
                stay (ir/false! (mut (.g r)) stop)]
            (set! (.control r) (ir/true! (mut (.g r)) stop))
            (let [p (if (<= reach 128)
                        (pointer! (mut r))
                        (ir/const! (mut (.g r)) ir/T-PTR (+ (.memory r) (cast u64 (below! (mut r) (- 256 reach))))))
                  ct (memory-type! (mut r))
                  late (ir/load-node! (mut (.g r)) ct 0 (.control r) (ir/add! (mut (.g r)) ir/T-PTR p scaled))]
              (set! out late)
              (set! out-x (binary! (mut r) t (below! (mut r) 6) next-x
                                   (if (< (ir/type-bits ct) (ir/type-bits t)) (widen! (mut r) late) (ir/trunc! (mut (.g r)) t late)))))
            (set! (.control r) stay)))
        ; Then sometimes b[i] = x, mostly when the loop may be left: then the
        ; loop does not end in the test that may leave it, and can be turned.
        (when (< (below! (mut r) 4) (if leaving 3 2))
          (let [other (ir/const! (mut (.g r)) ir/T-PTR (+ (.memory r) (cast u64 (below! (mut r) (- 256 reach)))))
                st (memory-type! (mut r))]
            (set! (.control r)
                  (ir/store-node! (mut (.g r)) 0 (.control r) (ir/add! (mut (.g r)) ir/T-PTR other scaled)
                                  (fitted! (mut r) st next-x)))))
        (graph/set-input! (mut (.g r)) head 1 (.control r))
        (graph/set-input! (mut (.g r)) i 2 (ir/add! (mut (.g r)) ir/T-PTR i (ir/const! (mut (.g r)) ir/T-PTR 1)))
        (graph/set-input! (mut (.g r)) x 2 next-x)))
    (set! (.control r) exit)
    ; Where the two ways out meet, what the loop made by each.
    (let [made (if leaving
                   (let [meet (ir/region! (mut (.g r)) 2)
                         v (ir/phi! (mut (.g r)) t meet 2)]
                     (graph/set-input! (mut (.g r)) meet 0 exit)
                     (graph/set-input! (mut (.g r)) meet 1 out)
                     (graph/set-input! (mut (.g r)) v 1 x)
                     (graph/set-input! (mut (.g r)) v 2 out-x)
                     (set! (.control r) meet)
                     v)
                   x)]
      ; Mostly what the loop made is handed to a call: a value read outside only
      ; through a long expression keeps the loop from being turned.
      (push! (mut (.env r))
             (if (= (below! (mut r) 3) 0)
                 made
                 (let [narrow (< (ir/type-bits t) 64)
                       target (ir/const! (mut (.g r)) ir/T-PTR
                                         (if narrow (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper1-32)))
                                             (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper1)))))
                       node (ir/call-node! (mut (.g r)) 0 (.control r) target 1)]
                   (graph/set-input! (mut (.g r)) node 2 (if narrow (ir/zext! (mut (.g r)) ir/T-U64 made) made))
                   (set! (.control r) node)
                   (ir/result! (mut (.g r)) t 0 node)))))))

;;; if (test) return something: a way out before anything else is done.
(defn early-exit! [(r (mut Gen))] (-> void)
  (let [a (get (.env r) (below! (mut r) 6))
        b (if (= (below! (mut r) 2) 0) (constant! (mut r)) (get (.env r) (below! (mut r) 6)))
        test (compare! (mut r) (below! (mut r) 6) a b)
        branch (ir/if! (mut (.g r)) (.control r) test)
        out (ir/return! (mut (.g r)) (ir/true! (mut (.g r)) branch) 1)]
    (graph/set-input! (mut (.g r)) out 1 (binary! (mut r) (.type r) (below! (mut r) 9) a (get (.env r) (below! (mut r) 6))))
    (set! (.control r) (ir/false! (mut (.g r)) branch))))

;;; The end of a program that calls itself: while its first parameter's low
;;; three bits are not zero, the answer is that of a call of itself with
;;; them one less, which is returned at once, or through a phi, or with
;;; one added; else `result`.
(defn self-ending! [(r (mut Gen)) (first i32) (result i32)] (-> void)
  (let [t (.type r)
        depth (ir/and! (mut (.g r)) t first (ir/const! (mut (.g r)) t 7))
        branch (ir/if! (mut (.g r)) (.control r) (ir/ne! (mut (.g r)) depth (ir/const! (mut (.g r)) t 0)))
        call (ir/call-node! (mut (.g r)) 0 (ir/true! (mut (.g r)) branch) (ir/symbol! (mut (.g r)) (cast u64 SELF)) 10)
        no (ir/false! (mut (.g r)) branch)
        answer (ir/result! (mut (.g r)) t 0 call)
        how (below! (mut r) 3)]
    (graph/set-input! (mut (.g r)) call 2 (ir/sub! (mut (.g r)) t depth (ir/const! (mut (.g r)) t 1)))
    (for k (range 1 10) (graph/set-input! (mut (.g r)) call (+ k 2) (pick! (mut r))))
    (if (= how 0)
        (do (graph/set-input! (mut (.g r)) (ir/return! (mut (.g r)) call 1) 1 answer)
            (graph/set-input! (mut (.g r)) (ir/return! (mut (.g r)) no 1) 1 result))
        (let [meet (ir/region! (mut (.g r)) 2)
              v (ir/phi! (mut (.g r)) t meet 2)]
          (graph/set-input! (mut (.g r)) meet 0 call)
          (graph/set-input! (mut (.g r)) meet 1 no)
          (graph/set-input! (mut (.g r)) v 1 (if (= how 1) answer (ir/add! (mut (.g r)) t answer (ir/const! (mut (.g r)) t 1))))
          (graph/set-input! (mut (.g r)) v 2 result)
          (graph/set-input! (mut (.g r)) (ir/return! (mut (.g r)) meet 1) 1 v)))))

;;; A trap on a path that is never taken: a value's low bit is never 2.
(defn trap! [(r (mut Gen))] (-> void)
  (let [t (.type r)
        never (ir/eq! (mut (.g r)) (ir/and! (mut (.g r)) t (pick! (mut r)) (ir/const! (mut (.g r)) t 1))
                      (ir/const! (mut (.g r)) t 2))
        branch (ir/if! (mut (.g r)) (.control r) never)]
    (ir/trap! (mut (.g r)) (ir/true! (mut (.g r)) branch))
    (set! (.control r) (ir/false! (mut (.g r)) branch))))

;;; for (i = 0; i < small; i++) { … }, with two values carried round.
(defn counted-loop! [(r (mut Gen)) (depth i64)] (-> void)
  (let [t (.type r)
        head (ir/loop! (mut (.g r)) 2)
        i (ir/phi! (mut (.g r)) t head 2)
        x (ir/phi! (mut (.g r)) t head 2)
        y (ir/phi! (mut (.g r)) t head 2)
        x0 (pick! (mut r))
        y0 (pick! (mut r))
        bound (ir/const! (mut (.g r)) t (cast u64 (+ 1 (below! (mut r) 9))))
        test (ir/ult! (mut (.g r)) i bound)
        branch (ir/if! (mut (.g r)) head test)
        body (ir/true! (mut (.g r)) branch)
        exit (ir/false! (mut (.g r)) branch)
        base (len (.env r))]
    (graph/set-input! (mut (.g r)) head 0 (.control r))
    (graph/set-input! (mut (.g r)) i 1 (ir/const! (mut (.g r)) t 0))
    (graph/set-input! (mut (.g r)) x 1 x0)
    (graph/set-input! (mut (.g r)) y 1 y0)
    (push! (mut (.env r)) i)
    (push! (mut (.env r)) x)
    (push! (mut (.env r)) y)
    (set! (.control r) body)
    (statements! (mut r) (+ depth 1))
    ; Sometimes the two carried values swap, which makes the phis read each other.
    (let [swap (= (below! (mut r) 4) 0)
          x2 (if swap y (pick! (mut r)))
          y2 (if swap x (pick! (mut r)))]
      (graph/set-input! (mut (.g r)) head 1 (.control r))
      (graph/set-input! (mut (.g r)) i 2 (ir/add! (mut (.g r)) t i (ir/const! (mut (.g r)) t 1)))
      (graph/set-input! (mut (.g r)) x 2 x2)
      (graph/set-input! (mut (.g r)) y 2 y2))
    (while (> (len (.env r)) base) (pop! (mut (.env r))))
    (push! (mut (.env r)) x)
    (push! (mut (.env r)) y)
    (set! (.control r) exit)))

;;; do { … } while (i + 1 < bound): the loop's first block is also where it
;;; comes round from, so what the phis read is computed after them in their
;;; own block.
(defn bottom-loop! [(r (mut Gen)) (depth i64)] (-> void)
  (let [t (.type r)
        head (ir/loop! (mut (.g r)) 2)
        i (ir/phi! (mut (.g r)) t head 2)
        x (ir/phi! (mut (.g r)) t head 2)
        bound (ir/const! (mut (.g r)) t (cast u64 (+ 1 (below! (mut r) 6))))
        base (len (.env r))]
    (graph/set-input! (mut (.g r)) head 0 (.control r))
    (graph/set-input! (mut (.g r)) i 1 (ir/const! (mut (.g r)) t 0))
    (graph/set-input! (mut (.g r)) x 1 (pick! (mut r)))
    (push! (mut (.env r)) i)
    (push! (mut (.env r)) x)
    (set! (.control r) head)
    (statements! (mut r) (+ depth 1))
    (let [x2 (pick! (mut r))
          next (ir/add! (mut (.g r)) t i (ir/const! (mut (.g r)) t 1))
          branch (ir/if! (mut (.g r)) (.control r) (ir/ult! (mut (.g r)) next bound))]
      (graph/set-input! (mut (.g r)) head 1 (ir/true! (mut (.g r)) branch))
      (graph/set-input! (mut (.g r)) i 2 next)
      (graph/set-input! (mut (.g r)) x 2 x2)
      (while (> (len (.env r)) base) (pop! (mut (.env r))))
      ; The body ran at least once, so what it last made is there after it.
      (push! (mut (.env r)) x2)
      (set! (.control r) (ir/false! (mut (.g r)) branch)))))

;;; A copy or a fill of a few bytes inside the scratch memory. A copy's two
;;; ends are apart: one in the low half, the other in the high half.
(defn block! [(r (mut Gen))] (-> void)
  (let [bytes (+ 1 (below! (mut r) 40))
        low (below! (mut r) (- 128 bytes))
        high (+ 128 (below! (mut r) (- 128 bytes)))
        swap (= (below! (mut r) 2) 0)
        base (ir/const! (mut (.g r)) ir/T-PTR (.memory r))
        a (ir/add! (mut (.g r)) ir/T-PTR base (ir/const! (mut (.g r)) ir/T-PTR (cast u64 (if swap high low))))
        b (ir/add! (mut (.g r)) ir/T-PTR base (ir/const! (mut (.g r)) ir/T-PTR (cast u64 (if swap low high))))]
    (set! (.control r)
          (if (= (below! (mut r) 3) 0)
              (ir/fill! (mut (.g r)) (cast u64 bytes) (.control r) a
                        (if (= (ir/type-bits (.type r)) 8)
                            (pick! (mut r))
                            (ir/trunc! (mut (.g r)) ir/T-U8 (pick! (mut r)))))
              (ir/copy! (mut (.g r)) (cast u64 bytes) (.control r) a b)))))

;;; Memory reserved as the program runs, a value written to it and read back.
(defn reserve! [(r (mut Gen))] (-> i32)
  (let [words (+ 1 (below! (mut r) 6))
        room (ir/reserve! (mut (.g r)) (.control r) (ir/const! (mut (.g r)) ir/T-U64 (cast u64 (* words 8))))
        at (ir/add! (mut (.g r)) ir/T-PTR room
                    (ir/const! (mut (.g r)) ir/T-PTR (cast u64 (* 8 (below! (mut r) words)))))
        kept (ir/store-node! (mut (.g r)) 0 room at (pick! (mut r)))]
    (set! (.control r) kept)
    ; Something between the write and the read, so the value waits there.
    (push! (mut (.env r)) (arithmetic! (mut r)))
    (let [back (ir/load-node! (mut (.g r)) (.type r) 0 (.control r) at)]
      (set! (.control r) back)
      back)))

;;; One random function of ten parameters (two arrive on the stack), of about `size` statements beyond
;;; its first few. `memory` is the address of 256 bytes it may read and write.
;;; `rich` adds calls, other widths, division, choices and memory, and six more
;;; parameters; without it the programs are the ones tools/old-bench also makes.
;;; `window`, if not 0, is how many values stay in scope at the top level. Its result mixes every value still
;;; in scope, so all of them stay live to the end.
(defn program [(seed u64) (type i32) (size i64) (memory u64) (rich bool) (window i64) (linked bool)]
  (-> graph/Graph)
  (let [(mut r) (Gen
                  :g (graph/create (malloc-allocator))
                  :state (| (primitive/imul seed (: 0x9E3779B97F4A7C15 u64)) 1)
                  :control 0
                  :env (ArrayList::new [i32] (malloc-allocator))
                  :type type
                  :budget size
                  :memory memory
                  :rich rich
                  :window window
                  :object 0
                  :twin 0
                  :vars (ArrayList::new [i32] (malloc-allocator))
                  ; Calls of itself pass all ten parameters, which only rich programs have.
                  :linked (and linked rich)
                  :early false)]
    (set! (.control r) (ir/start! (mut (.g r))))
    (when (.linked r)
      (graph/routine-is! (mut (.g r)) (cast u64 MEMCPY) graph/COPIES)
      (graph/routine-is! (mut (.g r)) (cast u64 MEMMOVE) graph/MOVES)
      (graph/routine-is! (mut (.g r)) (cast u64 MEMSET) graph/FILLS)
      (graph/routine-is! (mut (.g r)) (cast u64 MEMCMP) graph/COMPARES))
    (for i (range 0 (if rich 10 4)) (push! (mut (.env r)) (ir/param! (mut (.g r)) type (cast u64 i))))
    (let [first (get (.env r) 0)]
      ; One linked program in three may leave before it does anything else,
      ; as a function that checks its arguments first does.
      (when (and (.linked r) (= (% (/ seed 4) 3) 0) (shape? 0))
        (set! (.early r) true)
      ; Nor does it read the parameters that may arrive in the caller's frame:
      ; past the sixth, on x86-64.
      (for _ (range 0 4) (pop! (mut (.env r))))
      (for _ (range 0 (+ 1 (below! (mut r) 2))) (early-exit! (mut r))))
      ; Half the rich programs have a frame object of 64 bytes, filled before use.
      (when (and rich (= (% seed 2) 0))
        (set! (.object r) (ir/slot! (mut (.g r)) 64))
        (for i (range 0 8)
          (set! (.control r)
                (ir/store-node! (mut (.g r)) 0 (.control r)
                                (ir/add! (mut (.g r)) ir/T-PTR (.object r)
                                         (ir/const! (mut (.g r)) ir/T-PTR (cast u64 (* i 8))))
                                (ir/const! (mut (.g r)) ir/T-U64 (cast u64 (* (+ i 1) 1000003)))))))
      ; Half of those have a second object just like it: two objects, not one.
      (when (and rich (= (% seed 4) 0))
        (set! (.twin r) (ir/slot! (mut (.g r)) 64))
        (for i (range 0 8)
          (set! (.control r)
                (ir/store-node! (mut (.g r)) 0 (.control r)
                                (ir/add! (mut (.g r)) ir/T-PTR (.twin r)
                                         (ir/const! (mut (.g r)) ir/T-PTR (cast u64 (* i 8))))
                                (ir/const! (mut (.g r)) ir/T-U64 (cast u64 (* (+ i 3) 999983)))))))
      ; Rich programs keep three variables in frame objects of their own, written
      ; before they are read: the kind a compiler turns into values.
      (when rich
        (for i (range 0 3)
          (let [v (ir/slot! (mut (.g r)) 8)]
            (push! (mut (.vars r)) v)
            (set! (.control r) (ir/store-node! (mut (.g r)) 0 (.control r) v (get (.env r) i))))))
      (statements! (mut r) 0)
      (statements! (mut r) 0)
      (while (> (.budget r) 0) (statements! (mut r) 0))
      (let [(mut result) (get (.env r) 0)]
        (for i (range 1 (len (.env r)))
          (set! result (ir/xor! (mut (.g r)) type
                                (ir/add! (mut (.g r)) type result (get (.env r) i))
                                (ir/const! (mut (.g r)) type (cast u64 i)))))
        ; One program in four ends by calling a helper in its own place, and
        ; one linked program in four by calling itself.
        (cond
          (and (.linked r) (= (% seed 4) 3) (shape? 1)) (self-ending! (mut r) first result)
          (and rich (= (% seed 4) 1))
            (let [narrow (< (ir/type-bits type) 64)
                  target (ir/const! (mut (.g r)) ir/T-PTR
                                    (if narrow (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper1-32)))
                                        (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper1)))))
                  node (ir/tailcall! (mut (.g r)) type 0 (.control r) target 1)]
              (graph/set-input! (mut (.g r)) node 2 result))
          :else (graph/set-input! (mut (.g r)) (ir/return! (mut (.g r)) (.control r) 1) 1 result))))
    (free! (mut (.env r)))
    (.g r)))

