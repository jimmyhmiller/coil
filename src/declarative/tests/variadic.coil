;;; A call to a function that takes any number of arguments: the C library's
;;; snprintf, with an integer, a double and another integer after its format.
(module tests.variadic)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.os" :as os)
(import "coil.str" :as str)
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.jit" :as jit)
(import "declarative.backend.nodes" :as ir)
(import "declarative.target" :as target)
(target/machine-pick (import "declarative.a64.unit" :as st) (import "declarative.x64.unit" :as st))
(target/machine-pick (import "declarative.a64.plans" :as plans) (import "declarative.x64.plans" :as plans))

;;; format(buffer, pattern, n, x) = snprintf(buffer, 64, pattern, n, x, n + 1)
(defn format [(snprintf u64)] (-> graph/Graph)
  (let [(mut g) (graph/create (malloc-allocator))
        s (ir/start! (mut g))
        buffer (ir/param! (mut g) ir/T-PTR 0)
        pattern (ir/param! (mut g) ir/T-PTR 1)
        n (ir/param! (mut g) ir/T-I64 2)
        x (ir/param! (mut g) ir/T-F64 3)
        ; Three named arguments, then three more.
        shape (graph/shape! (mut g) true)
        call (ir/call-node! (mut g) shape s (ir/const! (mut g) ir/T-PTR snprintf) 6)]
    (for i (range 0 6) (graph/shape-arg! (mut g) shape (if (< i 3) (: 0 u64) graph/PASS-UNNAMED)))
    (graph/set-input! (mut g) call 2 buffer)
    (graph/set-input! (mut g) call 3 (ir/const! (mut g) ir/T-U64 64))
    (graph/set-input! (mut g) call 4 pattern)
    (graph/set-input! (mut g) call 5 n)
    (graph/set-input! (mut g) call 6 x)
    (graph/set-input! (mut g) call 7 (ir/add! (mut g) ir/T-I64 n (ir/const! (mut g) ir/T-I64 1)))
    (graph/set-input! (mut g) (ir/return! (mut g) call 1) 1 (ir/result! (mut g) ir/T-I32 0 call))
    g))

(defn main [] (-> i64)
  (let [snprintf (primitive/cast u64 (os/dlsym (primitive/cast (ptr i8) (os/os-pick 0 -2 0)) c"snprintf"))
        g (format snprintf)
        problem (ir/verify g)
        (mut cx) (st/create g (malloc-allocator))
        (mut buffer) (ArrayList::new [u8] (malloc-allocator))]
    (when (!= problem "") (panic "{}" problem))
    (for _ (range 0 64) (push! (mut buffer) 0))
    (st/begin! (mut cx))
    (plans/default (mut cx))
    (let [code (jit/map-bytes (.code cx))
          f (primitive/cast (fnptr (cc/C) [(ptr u8) (ptr i8) i64 f64] i32) (.base code))
          written (f (elem buffer 0) c"%ld %.2f %ld" 12 3.5)
          text (str/from-cstr (primitive/cast (ptr i8) (elem buffer 0)))
          good (and (= written 10) (= text "12 3.50 13"))]
      (println "variadic call wrote '{}': {}" text (if good "as expected" "WRONG"))
      (if good 0 1))))
