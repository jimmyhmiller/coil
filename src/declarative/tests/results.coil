;;; Functions that return more than one value: two integers, and an integer
;;; with two floating values. A compiled caller takes them from a compiled
;;; function, the interpreter takes the integers from the same function, and
;;; so does this program, as a C function that returns a pair.
(module tests.results)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.jit" :as jit)
(import "declarative.backend.nodes" :as ir)
(import "declarative.target" :as target)
(target/machine-pick (import "declarative.a64.unit" :as st) (import "declarative.x64.unit" :as st))
(target/machine-pick (import "declarative.a64.plans" :as plans) (import "declarative.x64.plans" :as plans))

(defstruct Pair [(first u64) (second u64)])

;;; both(a, b) = (a + b, a * b)
(defn both [] (-> graph/Graph)
  (let [(mut g) (graph/create (malloc-allocator))
        s (ir/start! (mut g))
        a (ir/param! (mut g) ir/T-I64 0)
        b (ir/param! (mut g) ir/T-I64 1)
        r (ir/return! (mut g) s 2)]
    (graph/set-input! (mut g) r 1 (ir/add! (mut g) ir/T-I64 a b))
    (graph/set-input! (mut g) r 2 (ir/mul! (mut g) ir/T-I64 a b))
    g))

;;; mixed(a, x) = (x + x, a + 1, x * x): two floating values around an integer.
(defn mixed [] (-> graph/Graph)
  (let [(mut g) (graph/create (malloc-allocator))
        s (ir/start! (mut g))
        a (ir/param! (mut g) ir/T-I64 0)
        x (ir/param! (mut g) ir/T-F64 1)
        r (ir/return! (mut g) s 3)]
    (graph/set-input! (mut g) r 1 (ir/fadd! (mut g) ir/T-F64 x x))
    (graph/set-input! (mut g) r 2 (ir/add! (mut g) ir/T-I64 a (ir/const! (mut g) ir/T-I64 1)))
    (graph/set-input! (mut g) r 3 (ir/fmul! (mut g) ir/T-F64 x x))
    g))

;;; use(a, b) = let (s, p) = both(b, a) in s * 1000 + p - a
(defn use-both [(target u64)] (-> graph/Graph)
  (let [(mut g) (graph/create (malloc-allocator))
        s (ir/start! (mut g))
        a (ir/param! (mut g) ir/T-I64 0)
        b (ir/param! (mut g) ir/T-I64 1)
        call (ir/call-node! (mut g) 0 s (ir/const! (mut g) ir/T-PTR target) 2)
        sum (ir/result! (mut g) ir/T-I64 0 call)
        product (ir/result! (mut g) ir/T-I64 1 call)]
    (graph/set-input! (mut g) call 2 b)
    (graph/set-input! (mut g) call 3 a)
    (graph/set-input! (mut g) (ir/return! (mut g) call 1) 1
                      (ir/sub! (mut g) ir/T-I64
                               (ir/add! (mut g) ir/T-I64
                                        (ir/mul! (mut g) ir/T-I64 sum (ir/const! (mut g) ir/T-I64 1000))
                                        product)
                               a))
    g))

;;; use(a, x) = let (d, n, q) = mixed(a, x) in to-integer(d + q) + n
(defn use-mixed [(target u64)] (-> graph/Graph)
  (let [(mut g) (graph/create (malloc-allocator))
        s (ir/start! (mut g))
        a (ir/param! (mut g) ir/T-I64 0)
        x (ir/param! (mut g) ir/T-F64 1)
        call (ir/call-node! (mut g) 0 s (ir/const! (mut g) ir/T-PTR target) 2)
        double (ir/result! (mut g) ir/T-F64 0 call)
        next (ir/result! (mut g) ir/T-I64 0 call)
        square (ir/result! (mut g) ir/T-F64 1 call)]
    (graph/set-input! (mut g) call 2 a)
    (graph/set-input! (mut g) call 3 x)
    (graph/set-input! (mut g) (ir/return! (mut g) call 1) 1
                      (ir/add! (mut g) ir/T-I64
                               (ir/ftosi! (mut g) ir/T-I64 (ir/fadd! (mut g) ir/T-F64 double square))
                               next))
    g))

;;; The address of `g` compiled; the code stays mapped.
(defn compile [(g graph/Graph)] (-> (ptr u8))
  (let [problem (ir/verify g)
        (mut cx) (st/create g (malloc-allocator))]
    (when (!= problem "") (panic "{}" problem))
    (st/begin! (mut cx))
    (plans/default (mut cx))
    (.base (jit/map-bytes (.code cx)))))

(defn main [] (-> i64)
  (let [both-at (compile (both))
        mixed-at (compile (mixed))
        caller (use-both (primitive/cast u64 both-at))
        (mut args) (ArrayList::new [u64] (malloc-allocator))
        (mut failures) 0]
    (push! (mut args) 7)
    (push! (mut args) 5)
    (let [pair-fn (primitive/cast (fnptr (cc/C) [u64 u64] Pair) both-at)
          caller-fn (primitive/cast (fnptr (cc/C) [u64 u64] u64) (compile caller))
          mixed-fn (primitive/cast (fnptr (cc/C) [u64 f64] u64) (compile (use-mixed (primitive/cast u64 mixed-at))))
          direct (pair-fn 7 5)
          interpreted (match (ir/interpret caller (slice args) 1000)
                        (Some [v] v)
                        (None [] (panic "the interpreter did not return")))
          compiled (caller-fn 7 5)
          floating (mixed-fn 9 2.5)]
      (when (or (!= (.first direct) 12) (!= (.second direct) 35)) (set! failures (+ failures 1)))
      (when (!= interpreted 12028) (set! failures (+ failures 1)))
      (when (!= compiled 12028) (set! failures (+ failures 1)))
      ; 2.5 + 2.5 + 2.5 * 2.5 = 11.25, toward zero 11, and 9 + 1
      (when (!= floating 21) (set! failures (+ failures 1)))
      (println "several results: pair ({}, {}), interpreted {}, compiled {}, with floating values {}: {} failures"
               (.first direct) (.second direct) interpreted compiled floating failures)
      failures)))
