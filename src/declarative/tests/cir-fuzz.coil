;;; Random CIR functions, run by the reference interpreter of src/cir/cir.ops
;;; and compiled straight from CIR, with the same arguments and memory: they
;;; must give the same answer and leave the same memory.
;;;   cir-fuzz [count] [first-seed]       one seed: its code is printed
;;; A function takes four words and the address of 512 bytes of memory, and
;;; computes with variables (CIR builds the phis): arithmetic, comparisons,
;;; loads and stores, ways that part and meet, counted loops, switches, calls
;;; of two helpers (some in tail position), copies and fills of memory.
(module tests.cir-fuzz)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.str" :as str)
(import "native.cir" :as cir)
(import "native.cir-ops" :as cop)
(import "declarative.cir.ops" :as ops)
(import "declarative.dump" :as dump)
(import "declarative.rt.image" :as image)
(import "declarative.rt.jit" :as jit)
(import "declarative.target" :as target)
(target/machine-pick (import "declarative.a64-direct.unit" :as dst) (import "declarative.x64-direct.unit" :as dst))
(target/machine-pick (import "declarative.a64-direct.plans" :as dplans) (import "declarative.x64-direct.plans" :as dplans))
(target/machine-pick (import "declarative.a64.target" :as isa) (import "declarative.x64.target" :as isa))

(extern scratch-memory :as "malloc" :cc (cc/C) [i64] (-> (ptr u8)))
(import "coil.os" :as os)

(def MEMORY 512)

;;; What the programs call, by their symbols' numbers in the image: 0 and 1
;;; the helpers, then the C library's routines, then a helper of twelve
;;; arguments, the last four on the stack.
(defn helper1 :cc (cc/C) [(a u64)] (-> u64)
  (primitive/iadd (primitive/imul a (: 7 u64)) (: 3 u64)))
(defn helper3 :cc (cc/C) [(a u64) (b u64) (c u64)] (-> u64)
  (^ (primitive/isub a (primitive/imul b (: 5 u64))) (>> c 3)))
(defn helper12 :cc (cc/C) [(a u64) (b u64) (c u64) (d u64) (e u64) (f u64) (g u64) (h u64)
                           (i u64) (j u64) (k u64) (l u64)] (-> u64)
  (^ (primitive/iadd (primitive/iadd a (primitive/imul d 3)) (primitive/imul h 5))
     (primitive/iadd (primitive/imul i 7) (primitive/iadd (primitive/imul j 11) (primitive/isub (primitive/imul k 13) l)))))
(def SYMBOL-NAMES ["helper1" "helper3" "memcpy" "memset" "memmove" "helper12"])

(defn routine-address [(name (ptr i8))] (-> u64)
  (primitive/cast u64 (os/dlsym (primitive/cast (ptr i8) (os/os-pick 0 -2 0)) name)))

(defn addresses [] (-> (ArrayList u64))
  (let [(mut at) (ArrayList::new [u64] (malloc-allocator))]
    (push! (mut at) (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper1))))
    (push! (mut at) (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper3))))
    (push! (mut at) (routine-address c"memcpy"))
    (push! (mut at) (routine-address c"memset"))
    (push! (mut at) (routine-address c"memmove"))
    (push! (mut at) (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper12))))
    at))

(defstruct Gen
  [(f (ptr cir/Func)) (state u64) (vars (ArrayList u32)) (memory u32) (budget i64)])

(defn next! [(g (mut Gen))] (-> u64)
  (set! (.state g) (primitive/iadd (primitive/imul (.state g) (: 6364136223846793005 u64)) (: 1442695040888963407 u64)))
  (>> (.state g) 17))

(defn below! [(g (mut Gen)) (n i64)] (-> i64) (cast i64 (% (next! (mut g)) (cast u64 n))))

(defn constant! [(g (mut Gen))] (-> u32)
  (let [f (.f g)
        k (below! (mut g) 6)]
    (cir/iconst! f
                 (cond (= k 0) (- (below! (mut g) 20) 4)
                       (= k 1) (below! (mut g) 5000)
                       (= k 2) (- 0 (below! (mut g) 5000))
                       (= k 3) (cast i64 (next! (mut g)))
                       (= k 4) (<< 1 (below! (mut g) 63))
                       :else (cast i64 (primitive/imul (next! (mut g)) (next! (mut g))))))))

(defn var! [(g (mut Gen))] (-> u32) (get (.vars g) (below! (mut g) (len (.vars g)))))

;;; A value: a variable's, or a constant one time in five.
(defn pick! [(g (mut Gen))] (-> u32)
  (if (= (below! (mut g) 5) 0) (constant! (mut g)) (cir/use-var! (.f g) (var! (mut g)))))

(defn define! [(g (mut Gen)) (v u32)] (-> void)
  (cir/def-var! (.f g) (var! (mut g)) v))

(defn binary! [(g (mut Gen)) (a u32) (b u32)] (-> u32)
  (let [f (.f g)
        ops [cop/OP-ADD cop/OP-SUB cop/OP-MUL cop/OP-AND cop/OP-OR cop/OP-XOR cop/OP-SHL cop/OP-LSHR
             cop/OP-ASHR cop/OP-SDIV cop/OP-UDIV cop/OP-SREM cop/OP-UREM cop/OP-SMULH cop/OP-UMULH]
        op (get ops (below! (mut g) (len ops)))]
    (cir/op2! f op cop/T-I64 a b 0 0)))

(defn unary! [(g (mut Gen)) (a u32)] (-> u32)
  (let [f (.f g)
        k (below! (mut g) 11)
        w (get [8 16 32 64] (below! (mut g) 4))]
    (cond (= k 0) (cir/op1-inst! f cop/OP-NEG cop/T-I64 a 0 0)
          (= k 1) (cir/op1-inst! f cop/OP-NOT cop/T-I64 a 0 0)
          (= k 2) (cir/op1-inst! f cop/OP-SEXT cop/T-I64 a w 0)
          (= k 3) (cir/op1-inst! f cop/OP-ZEXT cop/T-I64 a w 0)
          (= k 4) (cir/op1-inst! f cop/OP-CLZ cop/T-I64 a w 0)
          (= k 5) (cir/op1-inst! f cop/OP-CTZ cop/T-I64 a w 0)
          (= k 6) (cir/op1-inst! f cop/OP-POPCNT cop/T-I64 a w 0)
          (= k 7) (cir/op1-inst! f cop/OP-BSWAP cop/T-I64 a (if (< w 16) 16 w) 0)
          (= k 8) (cir/op1-inst! f cop/OP-BITREV cop/T-I64 a w 0)
          (= k 9) (cir/op2! f (if (= (below! (mut g) 2) 0) cop/OP-ROTL cop/OP-ROTR) cop/T-I64 a (pick! (mut g))
                            (get [8 16 32 64 7 13 33 63] (below! (mut g) 8)) 0)
          :else (cir/op1-inst! f cop/OP-COPY cop/T-I64 a 0 0))))

(defn compare! [(g (mut Gen)) (a u32) (b u32)] (-> u32)
  (cir/op2! (.f g) cop/OP-ICMP cop/T-I64 a b (below! (mut g) 10) 0))

;;; An address into the memory, `bytes` wide: `offset` from it, through an ADDI
;;; or a PTRADD, or as it is.
(defn address! [(g (mut Gen)) (bytes i64)] (-> u32)
  (let [f (.f g)
        p (cir/use-var! f (.memory g))
        k (below! (mut g) 3)]
    (cond (= k 0) (cir/op1-inst! f cop/OP-ADDI cop/T-I64 p (below! (mut g) (- 249 bytes)) 0)
          (= k 1) (cir/op2! f cop/OP-PTRADD cop/T-I64 p
                            (cir/op2! f cop/OP-AND cop/T-I64 (pick! (mut g)) (cir/iconst! f 15) 0 0)
                            8 (below! (mut g) (- 129 bytes)))
          :else p)))

(defn call! [(g (mut Gen)) (tail bool)] (-> u32)
  (let [f (.f g)
        pick (below! (mut g) 3)
        which (if (= pick 2) 5 pick)
        (mut args) (ArrayList::new [u32] (malloc-allocator))
        (mut flags) (ArrayList::new [u32] (malloc-allocator))
        (mut types) (ArrayList::new [u8] (malloc-allocator))]
    (for _ (range 0 (cond (= which 0) 1 (= which 1) 3 :else 12))
      (push! (mut args) (pick! (mut g)))
      (push! (mut flags) 0))
    (push! (mut types) (cast u8 cop/T-I64))
    (cir/call! f (cast u32 which) (cir/none) (primitive/cast (ptr (ArrayList u32)) (mut args))
               (primitive/cast (ptr (ArrayList u32)) (mut flags)) (primitive/cast (ptr (ArrayList u8)) (mut types)) tail)))

;;; A place in the memory's first half, and one in its second: what copies
;;; copy from and to, which do not overlap.
(defn low-half! [(g (mut Gen))] (-> u32)
  (cir/op1-inst! (.f g) cop/OP-ADDI cop/T-I64 (cir/use-var! (.f g) (.memory g)) (below! (mut g) 16) 0))
(defn high-half! [(g (mut Gen))] (-> u32)
  (cir/op1-inst! (.f g) cop/OP-ADDI cop/T-I64 (cir/use-var! (.f g) (.memory g)) (+ 256 (below! (mut g) 16)) 0))

(defn memory-op! [(g (mut Gen))] (-> void)
  (let [f (.f g)
        k (below! (mut g) 5)
        bytes (if (= (below! (mut g) 3) 0) (+ 129 (below! (mut g) 100)) (below! (mut g) 129))]
    (cond (= k 0) (cir/op2! f cop/OP-MEMCPY cop/T-VOID (low-half! (mut g)) (high-half! (mut g)) bytes 0)
          (= k 1) (cir/op1-inst! f cop/OP-MEMZERO cop/T-VOID (low-half! (mut g)) bytes 0)
          (= k 2) (cir/op3! f cop/OP-MEMCPYV cop/T-VOID (low-half! (mut g)) (high-half! (mut g)) (cir/iconst! f bytes) 0 0)
          (= k 3) (cir/op3! f cop/OP-MEMMOVEV cop/T-VOID (low-half! (mut g)) (low-half! (mut g)) (cir/iconst! f bytes) 0 0)
          :else (cir/op3! f cop/OP-MEMSETV cop/T-VOID (high-half! (mut g)) (pick! (mut g)) (cir/iconst! f bytes) 0 0))
    0))

(defn statement! [(g (mut Gen)) (depth i64)] (-> void)
  (set! (.budget g) (- (.budget g) 1))
  (let [f (.f g)
        k (below! (mut g) 19)]
    (cond
      (= k 16) (define! (mut g) (call! (mut g) false))
      (= k 17) (memory-op! (mut g))
      (< k 4) (define! (mut g) (binary! (mut g) (pick! (mut g)) (pick! (mut g))))
      (< k 6) (define! (mut g) (unary! (mut g) (pick! (mut g))))
      (= k 6) (define! (mut g) (compare! (mut g) (pick! (mut g)) (pick! (mut g))))
      (= k 7) (define! (mut g) (cir/op3! f cop/OP-SELECT cop/T-I64 (compare! (mut g) (pick! (mut g)) (pick! (mut g)))
                                        (pick! (mut g)) (pick! (mut g)) 0 0))
      (= k 8) (define! (mut g) (cir/op2! f (get [cop/OP-ADDO cop/OP-SUBO cop/OP-MULO] (below! (mut g) 3)) cop/T-I64
                                        (pick! (mut g)) (pick! (mut g)) (get [8 16 32 64] (below! (mut g) 4)) (below! (mut g) 2)))
      (= k 9)
        (let [bytes (get [1 2 4 8] (below! (mut g) 4))
              signed (if (and (< bytes 8) (= (below! (mut g) 2) 0)) 256 0)]
          (define! (mut g) (cir/op1-inst! f cop/OP-LOAD cop/T-I64 (address! (mut g) bytes) 0 (| bytes signed))))
      (= k 10)
        (let [bytes (get [1 2 4 8] (below! (mut g) 4))]
          (cir/op2! f cop/OP-STORE cop/T-VOID (address! (mut g) bytes) (pick! (mut g)) 0 bytes)
          0)
      (and (= k 11) (< depth 3) (> (.budget g) 0)) (diamond! (mut g) depth)
      (and (= k 12) (< depth 2) (> (.budget g) 0)) (counted-loop! (mut g) depth)
      (and (= k 13) (< depth 3) (> (.budget g) 0)) (switch! (mut g) depth)
      (and (= k 14) (< depth 3) (> (.budget g) 0)) (skip! (mut g) depth)
      (and (= k 15) (< depth 2) (> (.budget g) 0)) (bottom-loop! (mut g) depth)
      :else (define! (mut g) (binary! (mut g) (pick! (mut g)) (pick! (mut g)))))))

(defn statements! [(g (mut Gen)) (depth i64)] (-> void)
  (for _ (range 0 (+ 1 (below! (mut g) 4)))
    (when (> (.budget g) 0) (statement! (mut g) depth))))

;;; if (test) { … } else { … }: the test a comparison, or any value.
(defn diamond! [(g (mut Gen)) (depth i64)] (-> void)
  (let [f (.f g)
        yes (cir/new-block! f)
        no (cir/new-block! f)
        join (cir/new-block! f)
        test (if (= (below! (mut g) 3) 0) (pick! (mut g)) (compare! (mut g) (pick! (mut g)) (pick! (mut g))))]
    (cir/condbr! f test yes no)
    (cir/set-block! f yes)
    (statements! (mut g) (+ depth 1))
    ; One way in six ends the function by a call in tail position.
    (if (= (below! (mut g) 6) 0) (call! (mut g) true) (do (cir/br! f join) 0))
    (cir/set-block! f no)
    (statements! (mut g) (+ depth 1))
    (cir/br! f join)
    (cir/set-block! f join)))

;;; if (test) skip { … }: the branch goes straight to where the ways meet,
;;; whose phis take the values from before the block and from after it.
(defn skip! [(g (mut Gen)) (depth i64)] (-> void)
  (let [f (.f g)
        body (cir/new-block! f)
        join (cir/new-block! f)
        test (compare! (mut g) (pick! (mut g)) (pick! (mut g)))]
    (if (= (below! (mut g) 2) 0) (cir/condbr! f test join body) (cir/condbr! f test body join))
    (cir/set-block! f body)
    (statements! (mut g) (+ depth 1))
    (cir/br! f join)
    (cir/set-block! f join)))

;;; do { … } while (++i < n): the loop's own block comes round to itself by
;;; a branch, its phis set on the way back.
(defn bottom-loop! [(g (mut Gen)) (depth i64)] (-> void)
  (let [f (.f g)
        i (cir/new-var! f cop/T-I64)
        body (cir/new-block! f)
        out (cir/new-block! f)
        bound (cir/iconst! f (+ 1 (below! (mut g) 5)))]
    (cir/def-var! f i (cir/iconst! f 0))
    (cir/br! f body)
    (cir/set-block! f body)
    (statements! (mut g) (+ depth 1))
    (cir/def-var! f i (cir/op2! f cop/OP-ADD cop/T-I64 (cir/use-var! f i) (cir/iconst! f 1) 0 0))
    (cir/condbr! f (cir/op2! f cop/OP-ICMP cop/T-I64 (cir/use-var! f i) bound cir/P-SLT 0) body out)
    (cir/set-block! f out)))

;;; for (i = 0; i < n; i++) { … }, n a small constant.
(defn counted-loop! [(g (mut Gen)) (depth i64)] (-> void)
  (let [f (.f g)
        i (cir/new-var! f cop/T-I64)
        head (cir/new-block! f)
        body (cir/new-block! f)
        out (cir/new-block! f)
        bound (cir/iconst! f (+ 1 (below! (mut g) 5)))]
    (cir/def-var! f i (cir/iconst! f 0))
    (cir/br! f head)
    (cir/set-block! f head)
    (cir/condbr! f (cir/op2! f cop/OP-ICMP cop/T-I64 (cir/use-var! f i) bound cir/P-SLT 0) body out)
    (cir/set-block! f body)
    (statements! (mut g) (+ depth 1))
    (cir/def-var! f i (cir/op2! f cop/OP-ADD cop/T-I64 (cir/use-var! f i) (cir/iconst! f 1) 0 0))
    (cir/br! f head)
    (cir/set-block! f out)))

;;; A switch on a value's low bits: three cases and the default.
(defn switch! [(g (mut Gen)) (depth i64)] (-> void)
  (let [f (.f g)
        join (cir/new-block! f)
        (mut values) (ArrayList::new [u64] (malloc-allocator))
        (mut targets) (ArrayList::new [u32] (malloc-allocator))
        default (cir/new-block! f)
        x (cir/op2! f cop/OP-AND cop/T-I64 (pick! (mut g)) (cir/iconst! f 7) 0 0)]
    (for c (range 0 3)
      (push! (mut values) (cast u64 (* c 2)))
      (push! (mut targets) (cir/new-block! f)))
    (cir/switch! f x default (primitive/cast (ptr (ArrayList u64)) (mut values))
                 (primitive/cast (ptr (ArrayList u32)) (mut targets)))
    (for t (slice targets)
      (cir/set-block! f t)
      (statements! (mut g) (+ depth 1))
      (cir/br! f join))
    (cir/set-block! f default)
    (statements! (mut g) (+ depth 1))
    (cir/br! f join)
    (cir/set-block! f join)))

(defn program [(seed u64)] (-> cir/Func)
  (let [(mut f) (cir/Func::new)
        fp (primitive/cast (ptr cir/Func) (mut f))
        entry (cir/new-block! fp)
        (mut g) (Gen :f fp :state (| seed 1) :vars (ArrayList::new [u32] (malloc-allocator)) :memory 0 :budget 40)]
    (cir/set-block! fp entry)
    ; Ten parameters: four words, the memory's address, five words more, the
    ; last two of which are on the stack.
    (let [(mut args) (ArrayList::new [u32] (malloc-allocator))]
      (for _ (range 0 4) (push! (mut args) (cir/arg! fp cop/T-I64 false)))
      (let [p (cir/arg! fp cop/T-I64 false)]
        (set! (.memory g) (cir/new-var! fp cop/T-I64))
        (cir/def-var! fp (.memory g) p))
      (for _ (range 0 5) (push! (mut args) (cir/arg! fp cop/T-I64 false)))
      (for i (range 0 11)
        (let [v (cir/new-var! fp cop/T-I64)]
          (push! (mut (.vars g)) v)
          (cir/def-var! fp v (if (< i 9) (get args i) (constant! (mut g)))))))
    (statements! (mut g) 0)
    (while (> (.budget g) 0) (statement! (mut g) 0))
    (let [(mut sum) (cir/use-var! fp (get (.vars g) 0))]
      (for i (range 1 (len (.vars g)))
        (set! sum (cir/op2! fp cop/OP-XOR cop/T-I64 (cir/op2! fp cop/OP-MUL cop/T-I64 sum (cir/iconst! fp 31) 0 0)
                            (cir/use-var! fp (get (.vars g) i)) 0 0)))
      (if (= (below! (mut g) 4) 0)
          (let [(mut args) (ArrayList::new [u32] (malloc-allocator))
                (mut flags) (ArrayList::new [u32] (malloc-allocator))
                (mut types) (ArrayList::new [u8] (malloc-allocator))]
            (push! (mut args) sum)
            (push! (mut flags) 0)
            (push! (mut types) (cast u8 cop/T-I64))
            (cir/call! fp (: 0 u32) (cir/none) (primitive/cast (ptr (ArrayList u32)) (mut args))
                       (primitive/cast (ptr (ArrayList u32)) (mut flags)) (primitive/cast (ptr (ArrayList u8)) (mut types)) true)
            0)
          (do (cir/ret1! fp sum) 0)))
    (cir/finish! fp)
    f))

(defn reset-memory! [(memory (ptr u8)) (round i64)] (-> void)
  (for i (range 0 MEMORY)
    (primitive/store! (primitive/index memory i) (primitive/cast u8 (& (+ (* i 37) (* round 11)) 255)))))

(defn memory-sum [(memory (ptr u8))] (-> u64)
  (let [(mut h) (: 1469598103934665603 u64)]
    (for i (range 0 MEMORY)
      (set! h (primitive/imul (^ h (cast u64 (primitive/load (primitive/index memory i)))) (: 1099511628211 u64))))
    h))

(defn check [(seed u64) (show bool) (memory (ptr u8)) (outside (ArrayList u64))] (-> bool)
  (let [(mut f) (program seed)
        fp (primitive/cast (ptr cir/Func) (mut f))
        (mut ok) true
        symbols outside
        (mut cx) (dst/create (malloc-allocator))]
    (set! (.f cx) fp)
    (dst/begin! (mut cx))
    (set! (.copy-routine cx) 3)
    (set! (.fill-routine cx) 4)
    (set! (.move-routine cx) 5)
    (when show (dump/cir fp))
    ; The helpers and routines are outside the image: called where they are.
    (dplans/quick (mut cx))
    (if (!= (.refusal cx) 0)
        (do (println "seed {}: the compile straight from CIR does not take this program (test {})" seed (.refusal cx))
            false)
        (do
          (when show
            (print "code:")
            (for byte (.code cx) (print " {:02x}" byte))
            (println ""))
          (let [(mut im) (image/create (malloc-allocator))]
            (for name SYMBOL-NAMES (image/symbol! (mut im) name))
            (let [sym (image/symbol! (mut im) "f")
                  (mut at) (ArrayList::new [u64] (malloc-allocator))]
            (image/add-function! (mut im) sym (.code cx) (.reloc-at cx) (.reloc-symbol cx) (.reloc-op cx) isa/ALIGN)
            (for a outside (push! (mut at) a))
            (for _ (range (len at) (len (.names im))) (push! (mut at) 0))
            (let [loaded (jit/load-image im at (fnptr-of isa/patch))
                  run (primitive/cast (fnptr (cc/C) [u64 u64 u64 u64 u64 u64 u64 u64 u64 u64] u64) (jit/address-of loaded sym))
                  (mut state) (| seed 7)]
              (for round (range 0 3)
                (let [(mut args) (ArrayList::new [u64] (malloc-allocator))]
                  (for i (range 0 4)
                    (set! state (primitive/iadd (primitive/imul state (: 6364136223846793005 u64)) (: 1442695040888963407 u64)))
                    (push! (mut args) (if (= round 0) (cast u64 (+ i 1)) (>> state (if (= round 1) 40 0)))))
                  (push! (mut args) (primitive/cast u64 memory))
                  (for i (range 0 5)
                    (set! state (primitive/iadd (primitive/imul state (: 6364136223846793005 u64)) (: 1442695040888963407 u64)))
                    (push! (mut args) (if (= round 0) (cast u64 (+ i 5)) (>> state (if (= round 1) 40 0)))))
                  (reset-memory! memory round)
                  (let [want (match (ops/interpret fp (slice args) (slice symbols) 1000000)
                               (Some [v] v)
                               (None [] (do (println "seed {}: the interpreter did not finish" seed) (set! ok false) 0)))
                        want-sum (memory-sum memory)]
                    (reset-memory! memory round)
                    (let [got (run (get args 0) (get args 1) (get args 2) (get args 3) (get args 4)
                                   (get args 5) (get args 6) (get args 7) (get args 8) (get args 9))]
                      (when (!= got want)
                        (println "seed {} round {}: compiled gave {:x}, the interpreter {:x}" seed round got want)
                        (set! ok false))
                      (when (!= (memory-sum memory) want-sum)
                        (println "seed {} round {}: compiled left memory different from the interpreter" seed round)
                        (set! ok false))))))
              (jit/unload! loaded))))
          ok))))

(extern getenv :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [count (if (> argc 1)
                  (match (str/parse-int (str/from-cstr (primitive/load (primitive/index argv 1)))) (Some [n] n) (None [] 100))
                  100)
        first (if (> argc 2)
                  (match (str/parse-int (str/from-cstr (primitive/load (primitive/index argv 2)))) (Some [n] n) (None [] 1))
                  1)
        memory (scratch-memory MEMORY)
        outside (addresses)
        (mut failed) 0]
    (for seed (range first (+ first count))
      (unless (check (cast u64 seed) (= count 1) memory outside) (set! failed (+ failed 1))))
    (println "{} CIR programs, {} failed" count failed)
    (if (= failed 0) 0 1)))
