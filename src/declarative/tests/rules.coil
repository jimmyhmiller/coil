;;; Every rewrite rule and every fact, checked against the meanings of the nodes.
(module tests.rules)
(import "coil.alloc" :use [malloc-allocator])
(import "declarative.rt.graph" :as graph)
(import "declarative.target" :as target)
(target/machine-pick (import "declarative.a64.unit" :as st) (import "declarative.x64.unit" :as st))
(target/machine-pick (import "declarative.a64.simplify" :as simplify) (import "declarative.x64.simplify" :as simplify))
(target/machine-pick (import "declarative.a64.narrow" :as narrow) (import "declarative.x64.narrow" :as narrow))
(target/machine-pick (import "declarative.a64.facts" :as facts) (import "declarative.x64.facts" :as facts))

(defn main [] (-> i64)
  (let [(mut cx) (st/create (graph/create (malloc-allocator)) (malloc-allocator))
        bad (+ (simplify/check-rules (mut cx) 4000) (narrow/check-rules (mut cx) 4000))]
    (println "{} rules, {} wrong or never seen to apply" (+ simplify/RULES narrow/RULES) bad)
    (let [wrong (facts/check-facts (mut cx) 20000)]
      (println "facts: {} wrong" wrong)
      (if (and (= bad 0) (= wrong 0)) 0 1))))
