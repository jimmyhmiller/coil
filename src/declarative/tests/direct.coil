;;; The compile straight from CIR, on functions built by hand: each is
;;; interpreted by the reference interpreter of src/cir/cir.ops, compiled,
;;; loaded in memory and run, and the two must agree.
(module tests.direct)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "native.cir" :as cir)
(import "native.cir-ops" :as cop)
(import "declarative.cir.ops" :as ops)
(import "declarative.rt.image" :as image)
(import "declarative.rt.jit" :as jit)
(import "declarative.target" :as target)
(target/machine-pick (import "declarative.a64-direct.unit" :as dst) (import "declarative.x64-direct.unit" :as dst))
(target/machine-pick (import "declarative.a64-direct.plans" :as dplans) (import "declarative.x64-direct.plans" :as dplans))
(target/machine-pick (import "declarative.a64.target" :as isa) (import "declarative.x64.target" :as isa))

;;; The runtime's 128-bit division, as the compiled code calls it: by the C
;;; convention, each operand and the answer in two registers.
(defn divti :cc (cc/C) [(a i128) (b i128)] (-> i128) (/ a b))
(defn udivti :cc (cc/C) [(a u128) (b u128)] (-> u128) (/ a b))
(defn modti :cc (cc/C) [(a i128) (b i128)] (-> i128) (% a b))
(defn umodti :cc (cc/C) [(a u128) (b u128)] (-> u128) (% a b))

;;; (a + b) * 3
(defn sum [] (-> cir/Func)
  (let [(mut f) (cir/Func::new)
        fp (primitive/cast (ptr cir/Func) (mut f))
        b0 (cir/new-block! fp)]
    (cir/set-block! fp b0)
    (let [a (cir/arg! fp cop/T-I64 false)
          b (cir/arg! fp cop/T-I64 false)
          s (cir/op2! fp cop/OP-ADD cop/T-I64 a b 0 0)
          m (cir/op2! fp cop/OP-MUL cop/T-I64 s (cir/iconst! fp 3) 0 0)]
      (cir/ret1! fp m))
    (cir/finish! fp)
    f))

;;; 1 + 2 + … + n, by a loop over a variable.
(defn triangle [] (-> cir/Func)
  (let [(mut f) (cir/Func::new)
        fp (primitive/cast (ptr cir/Func) (mut f))
        entry (cir/new-block! fp)
        head (cir/new-block! fp)
        body (cir/new-block! fp)
        out (cir/new-block! fp)
        i (cir/new-var! fp cop/T-I64)
        total (cir/new-var! fp cop/T-I64)]
    (cir/set-block! fp entry)
    (let [n (cir/arg! fp cop/T-I64 false)]
      (cir/def-var! fp i (cir/iconst! fp 1))
      (cir/def-var! fp total (cir/iconst! fp 0))
      (cir/br! fp head)
      (cir/set-block! fp head)
      (let [c (cir/op2! fp cop/OP-ICMP cop/T-I64 (cir/use-var! fp i) n cir/P-SLE 0)]
        (cir/condbr! fp c body out))
      (cir/set-block! fp body)
      (cir/def-var! fp total (cir/op2! fp cop/OP-ADD cop/T-I64 (cir/use-var! fp total) (cir/use-var! fp i) 0 0))
      (cir/def-var! fp i (cir/op2! fp cop/OP-ADD cop/T-I64 (cir/use-var! fp i) (cir/iconst! fp 1) 0 0))
      (cir/br! fp head)
      (cir/set-block! fp out)
      (cir/ret1! fp (cir/use-var! fp total)))
    (cir/finish! fp)
    f))

;;; Twelve parameters, the last four on the stack, three of them narrower in C
;;; than a word: Σ p_i * (i + 1).
(defn many-params [] (-> cir/Func)
  (let [(mut f) (cir/Func::new)
        fp (primitive/cast (ptr cir/Func) (mut f))
        b0 (cir/new-block! fp)
        (mut ps) (ArrayList::new [u32] (malloc-allocator))]
    (cir/set-block! fp b0)
    (for _ (range 0 8) (push! (mut ps) (cir/arg! fp cop/T-I64 false)))
    (push! (mut ps) (cir/arg-flagged! fp cop/T-I64 false (| (cir/af-size 4) (cast u32 cir/AF-SIGNED))))
    (push! (mut ps) (cir/arg-flagged! fp cop/T-I64 false (cir/af-size 2)))
    (push! (mut ps) (cir/arg-flagged! fp cop/T-I64 false (| (cir/af-size 1) (cast u32 cir/AF-SIGNED))))
    (push! (mut ps) (cir/arg! fp cop/T-I64 false))
    (let [(mut total) (cir/iconst! fp 0)]
      (for i (range 0 12)
        (set! total (cir/op2! fp cop/OP-ADD cop/T-I64 total
                              (cir/op2! fp cop/OP-MUL cop/T-I64 (get ps i) (cir/iconst! fp (+ i 1)) 0 0) 0 0)))
      (cir/ret1! fp total))
    (cir/finish! fp)
    f))

(defn many-params-want [] (-> u64)
  (let [(mut total) (: 0 u64)
        words [(: 11 u64) 22 33 44 55 66 77 88
               (cast u64 (: -5 i64)) 60000 (cast u64 (: -7 i64)) (<< (: 1 u64) 40)]]
    (for i (range 0 12)
      (set! total (primitive/iadd total (primitive/imul (get words i) (cast u64 (+ i 1))))))
    total))

;;; What `many-args` calls: twelve arguments, as C has them.
(defn helper12 :cc (cc/C) [(a u64) (b u64) (c u64) (d u64) (e u64) (f u64) (g u64) (h u64)
                           (i i32) (j u16) (k i8) (l u64)] (-> u64)
  (^ (primitive/iadd (primitive/iadd a (primitive/imul b 3)) (primitive/iadd (primitive/imul c 5) (primitive/imul h 7)))
     (primitive/iadd (primitive/iadd (cast u64 (cast i64 i)) (primitive/imul (cast u64 j) 11))
                     (primitive/iadd (primitive/imul (cast u64 (cast i64 k)) 13) (primitive/imul l 17)))))

;;; helper12(a, a + 1, …, a + 7, a * 3, a + 100, a - 200, a << 20), the last
;;; four on the stack.
(defn many-args [] (-> cir/Func)
  (let [(mut f) (cir/Func::new)
        fp (primitive/cast (ptr cir/Func) (mut f))
        b0 (cir/new-block! fp)
        (mut args) (ArrayList::new [u32] (malloc-allocator))
        (mut flags) (ArrayList::new [u32] (malloc-allocator))
        (mut types) (ArrayList::new [u8] (malloc-allocator))]
    (cir/set-block! fp b0)
    (let [a (cir/arg! fp cop/T-I64 false)
          b (cir/arg! fp cop/T-I64 false)]
      (for i (range 0 8)
        (push! (mut args) (cir/op2! fp cop/OP-ADD cop/T-I64 a (cir/iconst! fp i) 0 0))
        (push! (mut flags) 0))
      (push! (mut args) (cir/op2! fp cop/OP-MUL cop/T-I64 a (cir/iconst! fp 3) 0 0))
      (push! (mut flags) (| (cir/af-size 4) (cast u32 cir/AF-SIGNED)))
      (push! (mut args) (cir/op2! fp cop/OP-ADD cop/T-I64 a (cir/iconst! fp 100) 0 0))
      (push! (mut flags) (cir/af-size 2))
      (push! (mut args) (cir/op2! fp cop/OP-SUB cop/T-I64 a (cir/iconst! fp 200) 0 0))
      (push! (mut flags) (| (cir/af-size 1) (cast u32 cir/AF-SIGNED)))
      (push! (mut args) (cir/op2! fp cop/OP-SHL cop/T-I64 a (cir/iconst! fp 20) 0 0))
      (push! (mut flags) 0)
      (push! (mut types) (cast u8 cop/T-I64))
      (let [r (cir/call! fp (: 0 u32) (cir/none) (primitive/cast (ptr (ArrayList u32)) (mut args))
                         (primitive/cast (ptr (ArrayList u32)) (mut flags)) (primitive/cast (ptr (ArrayList u8)) (mut types)) false)]
        (cir/ret1! fp (cir/op2! fp cop/OP-ADD cop/T-I64 r b 0 0))))
    (cir/finish! fp)
    f))

(defn many-args-want [(a u64) (b u64)] (-> u64)
  (primitive/iadd
    (helper12 a (primitive/iadd a 1) (primitive/iadd a 2) (primitive/iadd a 3) (primitive/iadd a 4) (primitive/iadd a 5)
              (primitive/iadd a 6) (primitive/iadd a 7) (cast i32 (primitive/imul a 3)) (cast u16 (primitive/iadd a 100))
              (cast i8 (primitive/isub a 200)) (<< a 20))
    b))

;;; 128-bit integers: each operation of `op`'s list on a = (a1:a0), b = (b1:b0)
;;; and a count, and the result's two halves folded into one word.
(defn wide-op [(op i64) (pred i64)] (-> cir/Func)
  (let [(mut f) (cir/Func::new)
        fp (primitive/cast (ptr cir/Func) (mut f))
        b0 (cir/new-block! fp)]
    (cir/set-block! fp b0)
    (let [a0 (cir/arg! fp cop/T-I64 false)
          a1 (cir/arg! fp cop/T-I64 false)
          c0 (cir/arg! fp cop/T-I64 false)
          c1 (cir/arg! fp cop/T-I64 false)
          n (cir/arg! fp cop/T-I64 false)
          a (cir/op2! fp cop/OP-PAIR cop/T-I128 a0 a1 0 0)
          b (cir/op2! fp cop/OP-PAIR cop/T-I128 c0 c1 0 0)
          r (cond (= op cop/OP-ICMP) (cir/op2! fp cop/OP-ICMP cop/T-I64 a b pred 0)
                  (or (= op cop/OP-SHL) (= op cop/OP-LSHR) (= op cop/OP-ASHR)) (cir/op2! fp op cop/T-I128 a n 0 0)
                  (= op cop/OP-NEG) (cir/op1! fp op cop/T-I128 a 0 0)
                  :else (cir/op2! fp op cop/T-I128 a b 0 0))]
      (if (= op cop/OP-ICMP)
          (cir/ret1! fp r)
          (cir/ret1! fp (cir/op2! fp cop/OP-XOR cop/T-I64 (cir/op1! fp cop/OP-LO cop/T-I64 r 0 0)
                                  (cir/op2! fp cop/OP-MUL cop/T-I64 (cir/op1! fp cop/OP-HI cop/T-I64 r 0 0) (cir/iconst! fp 31) 0 0)
                                  0 0))))
    (cir/finish! fp)
    f))

(defn fold-wide [(x u128)] (-> u64)
  (^ (cast u64 x) (primitive/imul (cast u64 (>> x 64)) 31)))

(defn wide-want [(op i64) (pred i64) (a u128) (b u128) (n u64)] (-> u64)
  (let [sa (cast i128 a)
        sb (cast i128 b)
        k (cast u128 (% n 128))]
    (cond (= op cop/OP-ADD) (fold-wide (primitive/iadd a b))
          (= op cop/OP-SUB) (fold-wide (primitive/isub a b))
          (= op cop/OP-MUL) (fold-wide (primitive/imul a b))
          (= op cop/OP-AND) (fold-wide (& a b))
          (= op cop/OP-OR) (fold-wide (| a b))
          (= op cop/OP-XOR) (fold-wide (^ a b))
          (= op cop/OP-NEG) (fold-wide (primitive/isub (: 0 u128) a))
          (= op cop/OP-SHL) (fold-wide (<< a k))
          (= op cop/OP-LSHR) (fold-wide (>> a k))
          (= op cop/OP-ASHR) (fold-wide (cast u128 (>> sa (cast i128 k))))
          (= op cop/OP-UDIV) (fold-wide (/ a b))
          (= op cop/OP-UREM) (fold-wide (% a b))
          (= op cop/OP-SDIV) (fold-wide (cast u128 (/ sa sb)))
          (= op cop/OP-SREM) (fold-wide (cast u128 (% sa sb)))
          (= pred cir/P-EQ) (if (= a b) 1 0)
          (= pred cir/P-NE) (if (!= a b) 1 0)
          (= pred cir/P-SLT) (if (< sa sb) 1 0)
          (= pred cir/P-SLE) (if (<= sa sb) 1 0)
          (= pred cir/P-SGT) (if (> sa sb) 1 0)
          (= pred cir/P-SGE) (if (>= sa sb) 1 0)
          (= pred cir/P-ULT) (if (< a b) 1 0)
          (= pred cir/P-ULE) (if (<= a b) 1 0)
          (= pred cir/P-UGT) (if (> a b) 1 0)
          :else (if (>= a b) 1 0))))

(defn check-wide [] (-> i64)
  (let [(mut failures) 0
        values [(: 0 u128) 1 5 (<< (: 1 u128) 64) (primitive/isub (: 0 u128) 1) (: 0x8000000000000000_0000000000000003 u128)
                (: 0x0123456789abcdef_fedcba9876543210 u128) (: 0xfffffffffffffffe_0000000000000007 u128)]
        counts [(: 0 u64) 1 13 63 64 65 100 127 128 200]
        ops [cop/OP-ADD cop/OP-SUB cop/OP-MUL cop/OP-AND cop/OP-OR cop/OP-XOR cop/OP-NEG cop/OP-SHL cop/OP-LSHR cop/OP-ASHR
             cop/OP-UDIV cop/OP-UREM cop/OP-SDIV cop/OP-SREM]]
    (for oi (range 0 (+ (len ops) 10))
      (let [op (if (< oi (len ops)) (get ops oi) cop/OP-ICMP)
            pred (if (< oi (len ops)) 0 (- oi (len ops)))
            (mut f) (wide-op op pred)
            l (load-compiled (primitive/cast (ptr cir/Func) (mut f)) false)
            g (primitive/cast (fnptr (cc/C) [u64 u64 u64 u64 u64] u64) (primitive/cast (ptr i8) (.at l)))]
        (for a values
          (for b values
            (for n counts
              (let [divides (or (= op cop/OP-UDIV) (= op cop/OP-UREM) (= op cop/OP-SDIV) (= op cop/OP-SREM))]
                (unless (and divides (= b 0))
                  (let [got (g (cast u64 a) (cast u64 (>> a 64)) (cast u64 b) (cast u64 (>> b 64)) n)
                        want (wide-want op pred a b n)]
                    (when (!= got want)
                      (when (< failures 10)
                        (println "128-bit op {} pred {} a {:x} b {:x} n {}: compiled {:x} wanted {:x}" op pred a b n got want))
                      (set! failures (+ failures 1)))))))))
        (jit/unload! (.loaded l))))
    failures))

;;; Compiled and loaded, with symbol 0 `helper12`.
(defstruct Compiled [(loaded jit/Loaded) (at u64)])

(defn load-compiled [(fp (ptr cir/Func)) (show bool)] (-> Compiled)
  (let [(mut cx) (dst/create (malloc-allocator))
        (mut im) (image/create (malloc-allocator))
        (mut outside) (ArrayList::new [u64] (malloc-allocator))
        helper (image/symbol! (mut im) "helper12")
        divti (image/symbol! (mut im) "__divti3")
        udivti (image/symbol! (mut im) "__udivti3")
        modti (image/symbol! (mut im) "__modti3")
        umodti (image/symbol! (mut im) "__umodti3")
        sym (image/symbol! (mut im) "f")]
    (set! (.f cx) fp)
    (dst/begin! (mut cx))
    (set! (.divide-routine cx) (+ (cast i64 divti) 1))
    (set! (.udivide-routine cx) (+ (cast i64 udivti) 1))
    (set! (.remainder-routine cx) (+ (cast i64 modti) 1))
    (set! (.uremainder-routine cx) (+ (cast i64 umodti) 1))
    (dplans/quick (mut cx))
    (when show
      (print "code:")
      (for byte (.code cx) (print " {:02x}" byte))
      (println ""))
    (image/add-function! (mut im) sym (.code cx) (.reloc-at cx) (.reloc-symbol cx) (.reloc-op cx) isa/ALIGN)
    (push! (mut outside) (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper12))))
    (push! (mut outside) (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of divti))))
    (push! (mut outside) (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of udivti))))
    (push! (mut outside) (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of modti))))
    (push! (mut outside) (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of umodti))))
    (for _ (range 5 (len (.names im))) (push! (mut outside) 0))
    (let [loaded (jit/load-image im outside (fnptr-of isa/patch))]
      (Compiled :loaded loaded :at (primitive/cast u64 (jit/address-of loaded sym))))))

(defn check-many [] (-> i64)
  (let [(mut failures) 0
        (mut f) (many-params)
        l (load-compiled (primitive/cast (ptr cir/Func) (mut f)) false)
        g (primitive/cast (fnptr (cc/C) [u64 u64 u64 u64 u64 u64 u64 u64 i32 u16 i8 u64] u64) (primitive/cast (ptr i8) (.at l)))
        got (g 11 22 33 44 55 66 77 88 -5 60000 -7 (<< (: 1 u64) 40))]
    (jit/unload! (.loaded l))
    (when (!= got (many-params-want))
      (println "many-params: compiled {} wanted {}" got (many-params-want))
      (set! failures (+ failures 1)))
    (let [(mut h) (many-args)
          l2 (load-compiled (primitive/cast (ptr cir/Func) (mut h)) false)
          k (primitive/cast (fnptr (cc/C) [u64 u64] u64) (primitive/cast (ptr i8) (.at l2)))]
      (for a [(: 5 u64) 1000 (cast u64 (: -3 i64)) 0x123456789]
        (let [got2 (k a 9)]
          (when (!= got2 (many-args-want a 9))
            (println "many-args {}: compiled {} wanted {}" a got2 (many-args-want a 9))
            (set! failures (+ failures 1)))))
      (jit/unload! (.loaded l2)))
    failures))

;;; Compiled and run on two arguments.
(defn compiled [(fp (ptr cir/Func)) (a u64) (b u64) (show bool)] (-> u64)
  (let [(mut cx) (dst/create (malloc-allocator))
        (mut im) (image/create (malloc-allocator))
        (mut outside) (ArrayList::new [u64] (malloc-allocator))
        sym (image/symbol! (mut im) "f")]
    (set! (.f cx) fp)
    (dst/begin! (mut cx))
    (dplans/quick (mut cx))
    (when show
      (print "code:")
      (for byte (.code cx) (print " {:02x}" byte))
      (println ""))
    (image/add-function! (mut im) sym (.code cx) (.reloc-at cx) (.reloc-symbol cx) (.reloc-op cx) isa/ALIGN)
    (for _ (range 0 (len (.names im))) (push! (mut outside) 0))
    (let [loaded (jit/load-image im outside (fnptr-of isa/patch))
          f (primitive/cast (fnptr (cc/C) [u64 u64] u64) (jit/address-of loaded sym))
          got (f a b)]
      (jit/unload! loaded)
      got)))

(defn check [(name (slice u8)) (f cir/Func) (a u64) (b u64)] (-> i64)
  (let [(mut g) f
        fp (primitive/cast (ptr cir/Func) (mut g))
        (mut symbols) (ArrayList::new [u64] (malloc-allocator))
        want (match (ops/interpret fp [a b] (slice symbols) 1000000) (Some [v] v) (None [] (panic "the interpreter did not finish")))
        got (compiled fp a b false)]
    (if (= want got)
        0
        (do (println "{}: compiled {} interpreted {}" name got want)
            (compiled fp a b true)
            1))))

(defn main [] (-> i64)
  (let [failures (+ (+ (+ (check "sum" (sum) 4 5) (check "triangle" (triangle) 10 0)) (check-many)) (check-wide))]
    (println "the compile straight from CIR: {} failures" failures)
    (if (= failures 0) 0 1)))
