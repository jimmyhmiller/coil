;;; The second client of the languages: a calculator's node set, rules, fact,
;;; pass and plan, built by the same compiler/ as the backend. An expression is
;;; tidied and must still mean what it meant; the rules and the fact are checked
;;; against the calculator's own meanings.
(module tests.toy)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "declarative.rt.graph" :as graph)
(import "toy.calc" :as calc)
(import "toy.unit" :as st)
(import "toy.tidy" :as tidy)
(import "toy.sharpen" :as sharpen)
(import "toy.known" :as known)
(import "toy.measure" :as measure)
(import "toy.steps" :as steps)
(import "toy.storage" :as storage)
(import "toy.chunks" :as chunks)
(import "coil.primitive" :as primitive)
(import "coil.thread" :use [Thread])
(import "coil.cc" :as cc)

;;; ((x * 1) + (y - y)) + pick(x == x, -(-y), 7 & 15), which is x + y.
(defn expression [] (-> graph/Graph)
  (let [(mut g) (graph/create (malloc-allocator))
        begin (calc/begin! (mut g))
        x (calc/input! (mut g) calc/T-NUM 0)
        y (calc/input! (mut g) calc/T-NUM 1)
        left (calc/plus! (mut g) calc/T-NUM
                         (calc/times! (mut g) calc/T-NUM x (calc/lit! (mut g) calc/T-NUM 1))
                         (calc/minus! (mut g) calc/T-NUM y y))
        right (calc/pick! (mut g) calc/T-NUM (calc/same! (mut g) x x)
                          (calc/negate! (mut g) calc/T-NUM (calc/negate! (mut g) calc/T-NUM y))
                          (calc/both! (mut g) calc/T-NUM (calc/lit! (mut g) calc/T-NUM 7)
                                      (calc/lit! (mut g) calc/T-NUM 15)))]
    (calc/give! (mut g) begin (calc/plus! (mut g) calc/T-NUM left right))
    g))

(defn answer [(g graph/Graph) (x u64) (y u64)] (-> u64)
  (let [(mut args) (ArrayList::new [u64] (malloc-allocator))]
    (push! (mut args) x)
    (push! (mut args) y)
    (match (calc/interpret g (slice args) 1000)
      (Some [v] v)
      (None [] (panic "the calculator did not answer")))))

(defn check-stable-cells [] (-> bool)
  (let [(mut cells) (chunks/Cells::new)
        table (primitive/cast (ptr chunks/Cells) (mut cells))
        outer (primitive/cast u64 (.data (.chunks cells)))]
    (chunks/start-cells! table)
    (chunks/start-cells! table)
    (let [first (chunks/cell-push! table (chunks/Cell :value 123))
          address (primitive/cast u64 (chunks/cell-at table first))
          (mut ok) (= first (: 0 u32))]
      (for i (range 1 700)
        (unless (= (chunks/cell-push! table (chunks/Cell :value (cast u64 i))) (cast u32 i))
          (set! ok false)))
      (set! ok (and ok (= (chunks/cell-count table) (: 700 u32))
                   (= (primitive/cast u64 (.data (.chunks cells))) outer)
                   (= (primitive/cast u64 (chunks/cell-at table first)) address)
                   (= (.value (chunks/cell-at table first)) (: 123 u64))
                   (= (.value (chunks/cell-at table (: 699 u32))) (: 699 u64))))
      (chunks/stop-cells! table) (chunks/stop-cells! table)
      (chunks/cells-free! table)
      (and ok (= (chunks/cell-count table) (: 0 u32))))))

(defstruct ChunkWorker [(table (ptr chunks/Cells)) (worker u64) (failures i64)])
(defn chunk-worker :cc (cc/C) [(raw (ptr i8))] (-> (ptr i8))
  (let [worker (primitive/cast (ptr ChunkWorker) raw) table (.table worker)]
    (for i (range 0 100)
      (let [value (+ (* (.worker worker) (: 1000 u64)) (cast u64 i))
            index (chunks/cell-push! table (chunks/Cell :value value))]
        (unless (= (.value (chunks/cell-at table index)) value)
          (set! (.failures worker) (+ (.failures worker) 1)))))
    (primitive/cast (ptr i8) 0)))

(defn check-shared-cells [] (-> bool)
  (let [(mut cells) (chunks/Cells::new)
        table (primitive/cast (ptr chunks/Cells) (mut cells))
        (mut workers) (zeroed (array ChunkWorker 4))
        (mut threads) (zeroed (array Thread 4))
        (mut seen) (ArrayList::new [bool] (malloc-allocator))]
    (chunks/start-cells! table)
    (let [first (chunks/cell-push! table (chunks/Cell :value 9999))
          pointer (chunks/cell-at table first)]
      (for i (range 0 4)
        (set! (mut workers) i (ChunkWorker :table table :worker (cast u64 i) :failures 0))
        (unless (= (Thread::spawn (primitive/index (mut threads) i) (fnptr-of chunk-worker)
                                 (primitive/cast (ptr i8) (primitive/index (mut workers) i))) (: 0 i32))
          (panic "could not start stable-index worker")))
      (for i (range 0 4)
        (unless (= (Thread::join (primitive/index (mut threads) i)) (: 0 i32))
          (panic "could not join stable-index worker")))
      (let [(mut ok) (and (= (chunks/cell-count table) (: 401 u32)) (= (.value pointer) (: 9999 u64)))]
        (for i (range 0 4)
          (when (!= (.failures (primitive/index (mut workers) i)) 0) (set! ok false)))
        (extend-zeroed! (mut seen) 400)
        (for i (range 1 401)
          (let [value (.value (chunks/cell-at table (cast u32 i)))
                position (+ (* (/ value (: 1000 u64)) (: 100 u64)) (% value (: 1000 u64)))]
            (if (>= position (: 400 u64)) (set! ok false)
                (let [index (cast i64 position)]
                  (when (get seen index) (set! ok false))
                  (set! (mut seen) index true)))))
        (free! (mut seen))
        (chunks/cells-free! table)
        ok))))

(defn main [] (-> i64)
  (let [g (expression)
        problem (calc/verify g)
        before (answer g 30 12)
        (mut cx) (st/create g (malloc-allocator))
        (mut failures) 0]
    (unless (check-stable-cells) (println "stable index: wrong chunk boundary or address") (set! failures (+ failures 1)))
    (unless (check-shared-cells) (println "stable index: wrong concurrent publication") (set! failures (+ failures 1)))
    (unless (storage/check-reduction) (println "reduction: wrong empty identity or row order") (set! failures (+ failures 1)))
    (unless (storage/check-scoped-worklist) (println "scoped worklist: wrong cleanup or stack traversal") (set! failures (+ failures 1)))
    (unless (storage/check-worklist) (println "worklist: wrong discovery order or relocation") (set! failures (+ failures 1)))
    (unless (storage/check-interning) (println "interning: wrong miss, hit or domain bypass") (set! failures (+ failures 1)))
    (unless (storage/check-paths) (println "paths: wrong terminal, fold or bounded stack") (set! failures (+ failures 1)))
    (unless (storage/check-rule-scope) (println "rule scope: wrong fallback capture or eager effect") (set! failures (+ failures 1)))
    (unless (storage/check-counting) (println "counting: wrong applications, tally or void guard") (set! failures (+ failures 1)))
    (unless (storage/check-retention) (println "retention: wrong stable IDs, ordinals or anchor omission") (set! failures (+ failures 1)))
    (unless (storage/check-scheduling) (println "scheduling: wrong convergence, group order or stages") (set! failures (+ failures 1)))
    (unless (storage/check-pruning) (println "pruning: wrong cascade, effect or protected root") (set! failures (+ failures 1)))
    (unless (storage/check-compaction) (println "compaction: wrong segment, anchor or scratch reuse") (set! failures (+ failures 1)))
    (unless (storage/check-gather) (println "gather: wrong reserved row across nested append") (set! failures (+ failures 1)))
    (unless (storage/check-ssa) (println "sealed SSA: wrong deferred or cyclic merge") (set! failures (+ failures 1)))
    (unless (storage/check-tabulate) (println "tabulate: wrong collection equation") (set! failures (+ failures 1)))
    (unless (storage/check-insertion) (println "insertion: wrong parallel columns or ordinal") (set! failures (+ failures 1)))
    (unless (storage/check-ownership) (println "ownership: wrong field or element release") (set! failures (+ failures 1)))
    (unless (storage/check-consensus) (println "consensus: wrong agreement or typed rewrite") (set! failures (+ failures 1)))
    (unless (storage/check-epoch-map) (println "epoch map: wrong collision, growth or wrap") (set! failures (+ failures 1)))
    (unless (storage/check-dominators) (println "dominators: wrong diamond, cycle or unreachable node") (set! failures (+ failures 1)))
    (unless (storage/check-plans) (println "plans: wrong constraint or rewrite effects") (set! failures (+ failures 1)))
    (unless (storage/check-lifecycle) (println "lifecycle: wrong snapshot or retained scratch") (set! failures (+ failures 1)))
    (unless (storage/check-regions) (println "regions: wrong stopped cyclic reachability") (set! failures (+ failures 1)))
    (unless (storage/check-relations) (println "relation fixed point: wrong recursive promise") (set! failures (+ failures 1)))
    (unless (storage/check) (println "library storage: wrong buffer encoding or record lifetime") (set! failures (+ failures 1)))
    (when (!= problem "") (println "not well formed: {}" problem) (set! failures 1))
    (st/begin! (mut cx))
    (let [nodes-before (measure/live (mut cx))
          depth-before (measure/deepest (mut cx))]
      (steps/tidy-up (mut cx))
      (st/begin! (mut cx))
      (let [after (answer (.g cx) 30 12)]
        (println "tidied {} nodes of depth {} to {} of depth {}; 30 and 12 gave {} before and {} after"
                 nodes-before depth-before (measure/live (mut cx)) (measure/deepest (mut cx)) before after)
        (when (or (!= before after) (!= after 42)) (set! failures (+ failures 1)))))
    (let [bad (+ (tidy/check-rules (mut cx) 3000) (sharpen/check-rules (mut cx) 3000))
          wrong (known/check-facts (mut cx) 5000)]
      (println "calculator: {} rules, {} wrong or never seen to apply; facts: {} wrong"
               (+ tidy/RULES sharpen/RULES) bad wrong)
      (set! failures (+ failures (+ bad wrong))))
    (if (= failures 0) 0 1)))
