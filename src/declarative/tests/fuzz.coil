;;; Differential check: random programs, the reference interpreter against the
;;; generated machine code. Usage: fuzz [count] [first-seed] [classic]
;;; With one program, its graph before and after rewriting and its code are printed.
;;; Each program is linked as an image of its own, so that it can call itself
;;; and the C library's routines by symbol.
(module tests.fuzz)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(extern scratch-memory :as "malloc" :cc (cc/C) [i64] (-> (ptr u8)))

(import "coil.str" :as str)
(import "coil.os" :as os)
(import "coil.var" :use [var-static])
(import "declarative.rt.image" :as image)
(import "coil.slice" :use [subslice])
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.jit" :as jit)
(import "declarative.backend.nodes" :as ir)
(import "tests.gen" :as gen)
(import "declarative.target" :as target)
(target/machine-pick (import "declarative.a64.unit" :as st) (import "declarative.x64.unit" :as st))
(target/machine-pick (import "declarative.a64.plans" :as plans) (import "declarative.x64.plans" :as plans))
(target/machine-pick (import "declarative.a64.target" :as isa) (import "declarative.x64.target" :as isa))

(defstruct Stats [(spilled i64) (slots i64) (words i64) (nodes i64) (fired (ArrayList i64))])

;;; What each transformation did, summed over a run: one that never fires is
;;; not being tested by these programs. `late` counts frames opened late,
;;; `unplanned` such plans that did not hold, `spilled` programs that needed the frame.
(def FIRED-NAMES ["promoted" "forwarded" "overwritten" "elided" "split" "turned" "hoisted" "parted" "learned" "reduced" "halved" "settled" "looped" "chosen" "expanded" "known-calls" "paired" "tabled" "late" "unplanned" "spilled"])

(defn tally! [(stats (mut Stats)) (cx st/State)] (-> void)
  (let [counts [(.promoted cx) (.forwarded cx) (.overwritten cx) (.elided cx) (.split cx) (.turned cx) (.hoisted cx) (.parted cx) (.learned cx) (.reduced cx) (.halved cx) (.settled cx) (.looped cx) (.chosen cx) (.expanded cx) (.known-calls cx) (.paired cx) (.tabled cx) (if (!= (.frame-at cx) 0) 1 0) (.unplanned cx) (if (> (.slots cx) 0) 1 0)]]
    (for i (range 0 (len counts))
      (set! (mut (.fired stats)) i (+ (get (.fired stats) i) (get counts i))))))

;;; The program being interpreted, for its calls of itself: the interpreter
;;; calls the symbol SELF's address with the C convention, every integer as
;;; 64 bits, and that is this, which interprets the program again.
(def interpreting (var-static (ptr graph/Graph) (primitive/cast (ptr graph/Graph) 0)))
(def lost (var-static bool false))

(defn interpret-self [(a u64) (b u64) (c u64) (d u64) (e u64) (f u64) (g u64) (h u64) (i u64) (j u64)] (-> u64)
  (let [(mut args) (ArrayList::new [u64] (malloc-allocator))]
    (for v [a b c d e f g h i j] (push! (mut args) v))
    (let [answer (match (ir/interpret (primitive/load (get interpreting)) (slice args) 10000000)
                   (Some [v] v)
                   (None [] (do (set lost true) (: 0 u64))))]
      (free! (mut args))
      answer)))

(extern getenv :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

;;; FUZZ_OFF: the transformations not to make, as DECLARATIVE_OFF says them
;;; (bit numbers in cfg.pass), for finding which one a failure needs.
(defn transformations-off [] (-> i64)
  (let [text (getenv c"FUZZ_OFF")]
    (if (= (primitive/cast u64 text) 0)
        0
        (match (str/parse-int (str/from-cstr text)) (Some [n] n) (None [] (panic "FUZZ_OFF is not a number"))))))

(defn routine-address [(name (ptr i8))] (-> u64)
  (primitive/cast u64 (os/dlsym (primitive/cast (ptr i8) (os/os-pick 0 -2 0)) name)))

;;; Where each of the generator's symbols is, for the interpreter.
(defn addresses [] (-> (ArrayList u64))
  (let [(mut at) (ArrayList::new [u64] (malloc-allocator))]
    (push! (mut at) (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of interpret-self))))
    (push! (mut at) (routine-address c"memcpy"))
    (push! (mut at) (routine-address c"memset"))
    (push! (mut at) (routine-address c"memmove"))
    (push! (mut at) (routine-address c"memcmp"))
    at))

(defn low32 [(v u64)] (-> u32) (primitive/cast u32 (& v (: 0xFFFFFFFF u64))))

(defn reset-memory! [(memory (ptr u8)) (round i64)] (-> void)
  (for i (range 0 256)
    (primitive/store! (primitive/index memory i) (primitive/cast u8 (& (+ (* i 37) (* round 11)) 255)))))

(defn memory-sum [(memory (ptr u8))] (-> u64)
  (let [(mut h) (: 1469598103934665603 u64)]
    (for i (range 0 256)
      (set! h (primitive/imul (^ h (cast u64 (primitive/load (primitive/index memory i)))) (: 1099511628211 u64))))
    h))

(defn check [(seed u64) (type i32) (show bool) (stats (mut Stats)) (memory (ptr u8)) (rich bool)
             (outside (ArrayList u64))] (-> bool)
  (let [(mut g) (gen/program seed type 60 (primitive/cast u64 memory) rich (if (= (% seed 3) 0) 12 0) true)
        problem (ir/verify g)
        bits (ir/type-bits type)
        (mut args) (ArrayList::new [u64] (malloc-allocator))
        (mut want) (ArrayList::new [u64] (malloc-allocator))
        (mut sums) (ArrayList::new [u64] (malloc-allocator))
        (mut state) (| seed 1)
        (mut ok) true]
    (when (!= problem "")
      (println "seed {}: the generator made a wrong graph: {}" seed problem)
      (set! ok false))
    (for a outside (push! (mut (.addresses g)) a))
    (set interpreting (primitive/cast (ptr graph/Graph) (mut g)))
    (set lost false)
    ; Three sets of arguments, interpreted before the graph is given away.
    (for round (range 0 3)
      (for i (range 0 10)
        (set! state (primitive/iadd (primitive/imul state (: 6364136223846793005 u64)) (: 1442695040888963407 u64)))
        (push! (mut args) (if (= round 0) (cast u64 (+ i 1)) (>> state (if (= round 1) 40 0)))))
      (reset-memory! memory round)
      (match (ir/interpret g (subslice (slice args) (* round 10) (+ (* round 10) 10)) 10000000)
        (Some [v] (push! (mut want) v))
        (None [] (do (println "seed {}: the interpreter did not finish" seed) (set! ok false) (push! (mut want) 0))))
      (when (get lost)
        (println "seed {}: the interpreter did not finish a call of the program itself" seed)
        (set! ok false))
      (push! (mut sums) (memory-sum memory)))
    (when show (println "before:") (ir/dump g))
    (let [(mut cx) (st/create g (malloc-allocator))
          (mut im) (image/create (malloc-allocator))]
      (for name gen/SYMBOL-NAMES (image/symbol! (mut im) name))
      (st/begin! (mut cx))
      (set! (.self-symbol cx) (+ gen/SELF 1))
      (set! (.copy-routine cx) (+ gen/MEMCPY 1))
      (set! (.fill-routine cx) (+ gen/MEMSET 1))
      (set! (.off cx) (transformations-off))
      ; FUZZ_QUICK: selection and allocation alone, to tell the optimizer's
      ; failures from the rest's.
      (if (= (primitive/cast u64 (getenv c"FUZZ_QUICK")) 0) (plans/default (mut cx)) (plans/quick (mut cx)))
      (image/add-function! (mut im) gen/SELF (.code cx) (.reloc-at cx) (.reloc-symbol cx) (.reloc-op cx) isa/ALIGN)
      (when show
        (ir/dump (.g cx))
        (print "code:")
        (for b (.code cx) (print " {:02x}" b))
        (println ""))
      (when (> (.slots cx) 0) (set! (.spilled stats) (+ (.spilled stats) 1)))
      (tally! (mut stats) cx)
      (set! (.slots stats) (+ (.slots stats) (.slots cx)))
      (set! (.words stats) (+ (.words stats) (/ (len (.code cx)) 4)))
      (set! (.nodes stats) (+ (.nodes stats) (graph/size (.g cx))))
      (let [code (jit/load-image im outside (fnptr-of isa/patch))
            entry (jit/address-of code gen/SELF)
            f (primitive/cast (fnptr (cc/C) [u64 u64 u64 u64 u64 u64 u64 u64 u64 u64] u64) entry)
            ; A program of 32-bit values takes 32-bit parameters, which are
            ; not passed on the stack as 64-bit ones are.
            f32 (primitive/cast (fnptr (cc/C) [u32 u32 u32 u32 u32 u32 u32 u32 u32 u32] u64) entry)
            mask (if (>= bits 64) (: 0xFFFFFFFFFFFFFFFF u64) (- (<< (: 1 u64) (cast u64 bits)) 1))]
        (for round (range 0 3)
          (reset-memory! memory round)
          (let [at (* round 10)
                got (& (if (>= bits 64)
                           (f (get args at) (get args (+ at 1)) (get args (+ at 2)) (get args (+ at 3))
                              (get args (+ at 4)) (get args (+ at 5)) (get args (+ at 6))
                              (get args (+ at 7)) (get args (+ at 8)) (get args (+ at 9)))
                           (f32 (low32 (get args at)) (low32 (get args (+ at 1))) (low32 (get args (+ at 2)))
                                (low32 (get args (+ at 3))) (low32 (get args (+ at 4))) (low32 (get args (+ at 5)))
                                (low32 (get args (+ at 6))) (low32 (get args (+ at 7))) (low32 (get args (+ at 8)))
                                (low32 (get args (+ at 9)))))
                       mask)]
            (when (!= got (get want round))
              (println "seed {} type {} round {}: machine code gave {:x}, the interpreter {:x}"
                       seed (ir/type-name type) round got (get want round))
              (set! ok false))
            (when (!= (memory-sum memory) (get sums round))
              (println "seed {} type {} round {}: machine code left memory different from the interpreter"
                       seed (ir/type-name type) round)
              (set! ok false))))
        (jit/unload! code)))
    ok))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [count (if (> argc 1)
                  (match (str/parse-int (str/from-cstr (primitive/load (primitive/index argv 1))))
                    (Some [n] n) (None [] 100))
                  100)
        first (if (> argc 2)
                  (match (str/parse-int (str/from-cstr (primitive/load (primitive/index argv 2))))
                    (Some [n] n) (None [] 1))
                  1)
        rich (not (and (> argc 3) (= (str/from-cstr (primitive/load (primitive/index argv 3))) "classic")))
        (mut failed) 0
        (mut stats) (Stats :spilled 0 :slots 0 :words 0 :nodes 0 :fired (ArrayList::new [i64] (malloc-allocator)))
        memory (scratch-memory 256)
        outside (addresses)
        without (getenv c"FUZZ_WITHOUT")]
    (when (!= (primitive/cast u64 without) 0)
      (set gen/without (match (str/parse-int (str/from-cstr without)) (Some [n] n) (None [] (panic "FUZZ_WITHOUT is not a number")))))
    (for _ (range 0 (len FIRED-NAMES)) (push! (mut (.fired stats)) 0))
    (for seed (range first (+ first count))
      (unless (check (cast u64 seed) ir/T-I64 (= count 1) (mut stats) memory rich outside) (set! failed (+ failed 1)))
      (unless (check (cast u64 seed) ir/T-I32 false (mut stats) memory rich outside) (set! failed (+ failed 1))))
    (println "{} programs, {} failed" (* count 2) failed)
    (println "{} spilled something ({} slots); {} nodes became {} instructions"
             (.spilled stats) (.slots stats) (.nodes stats) (.words stats))
    (print "fired:")
    ; A machine with no jump tables has no switches by table to count.
    (for i (range 0 (len FIRED-NAMES))
      (unless (and (= (get FIRED-NAMES i) "tabled") (= isa/TABLES 0))
        (print " {}={}" (get FIRED-NAMES i) (get (.fired stats) i))))
    (println "")
    (if (= failed 0) 0 1)))
