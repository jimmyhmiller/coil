;;; Two functions and a helper from outside, linked in memory and written as an
;;; object file (tests/link-main.c is the program that links against it):
;;;   triple(x) = x * 3 + 1
;;;   both(x)   = triple(x) + helper(x + 1), the address of triple taken and called
;;;               through a register, a number read from data, and triple called
;;;               once more through a pointer kept in that data.
;;;   spread(p) = 300 bytes at p set to 0x5A, 200 of them copied to p + 300 (both
;;;               by the C library's routines, being too many for loads and
;;;               stores), and the byte at p + 499 read once, come what may.
(module tests.link)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "declarative.rt.graph" :as graph)
(import "declarative.rt.image" :as image)
(import "declarative.rt.jit" :as jit)
(import "declarative.backend.nodes" :as ir)
(import "declarative.target" :as target)
(target/machine-pick (import "declarative.a64.unit" :as st) (import "declarative.x64.unit" :as st))
(target/machine-pick (import "declarative.a64.plans" :as plans) (import "declarative.x64.plans" :as plans))
(target/machine-pick (import "declarative.a64.target" :as isa) (import "declarative.x64.target" :as isa))
(target/machine-pick (import "declarative.a64.macho" :as macho) (import "declarative.x64.elf" :as macho))
(import "coil.fs" :as fs)
(import "coil.os" :as os)

(defn helper [(a u64)] (-> u64)
  (primitive/isub (primitive/imul a (: 7 u64)) (: 2 u64)))

(defn compile! [(im (mut image/Image)) (name (slice u8)) (g graph/Graph)] (-> void)
  (let [problem (ir/verify g)
        (mut cx) (st/create g (malloc-allocator))]
    (when (!= problem "") (panic "{}: {}" name problem))
    (st/begin! (mut cx))
    (set! (.copy-routine cx) (+ (image/symbol! (mut im) "memcpy") 1))
    (set! (.fill-routine cx) (+ (image/symbol! (mut im) "memset") 1))
    (plans/default (mut cx))
    (image/add-function! (mut im) (image/symbol! (mut im) name) (.code cx) (.reloc-at cx)
                         (.reloc-symbol cx) (.reloc-op cx) isa/ALIGN)))

(defn triple [] (-> graph/Graph)
  (let [(mut g) (graph/create (malloc-allocator))
        s (ir/start! (mut g))
        x (ir/param! (mut g) ir/T-I64 0)
        r (ir/add! (mut g) ir/T-I64 (ir/mul! (mut g) ir/T-I64 x (ir/const! (mut g) ir/T-I64 3))
                   (ir/const! (mut g) ir/T-I64 1))]
    (graph/set-input! (mut g) (ir/return! (mut g) s 1) 1 r)
    g))

(defn both [(triple-symbol i64) (helper-symbol i64) (table-symbol i64)] (-> graph/Graph)
  (let [(mut g) (graph/create (malloc-allocator))
        s (ir/start! (mut g))
        x (ir/param! (mut g) ir/T-I64 0)
        direct (ir/call-node! (mut g) 0 s (ir/symbol! (mut g) (cast u64 triple-symbol)) 1)
        a (ir/result! (mut g) ir/T-I64 0 direct)
        outside (ir/call-node! (mut g) 0 direct (ir/extern! (mut g) (cast u64 helper-symbol)) 1)
        b (ir/result! (mut g) ir/T-I64 0 outside)
        ; The same function again, through its address in a register.
        pointer (ir/add! (mut g) ir/T-PTR (ir/symbol! (mut g) (cast u64 triple-symbol))
                         (ir/sub! (mut g) ir/T-PTR (ir/trunc! (mut g) ir/T-PTR x) (ir/trunc! (mut g) ir/T-PTR x)))
        indirect (ir/call-node! (mut g) 0 outside pointer 1)
        c (ir/result! (mut g) ir/T-I64 0 indirect)
        ; A number out of the data, and a call through a pointer kept there.
        table (ir/symbol! (mut g) (cast u64 table-symbol))
        d (ir/load-node! (mut g) ir/T-I64 0 indirect table)
        kept (ir/load-node! (mut g) ir/T-PTR 0 d
                            (ir/add! (mut g) ir/T-PTR table (ir/const! (mut g) ir/T-PTR 8)))
        through (ir/call-node! (mut g) 0 kept kept 1)
        e (ir/result! (mut g) ir/T-I64 0 through)
        sum (ir/add! (mut g) ir/T-I64
                     (ir/add! (mut g) ir/T-I64 (ir/add! (mut g) ir/T-I64 a b) c)
                     (ir/add! (mut g) ir/T-I64 d e))]
    (graph/set-input! (mut g) direct 2 x)
    (graph/set-input! (mut g) outside 2 (ir/add! (mut g) ir/T-I64 x (ir/const! (mut g) ir/T-I64 1)))
    (graph/set-input! (mut g) indirect 2 b)
    (graph/set-input! (mut g) through 2 x)
    (graph/set-input! (mut g) (ir/return! (mut g) through 1) 1 sum)
    g))

(defn spread [] (-> graph/Graph)
  (let [(mut g) (graph/create (malloc-allocator))
        s (ir/start! (mut g))
        p (ir/param! (mut g) ir/T-PTR 0)
        filled (ir/fill! (mut g) 300 s p (ir/const! (mut g) ir/T-U8 0x5A))
        copied (ir/copy! (mut g) 200 filled (ir/add! (mut g) ir/T-PTR p (ir/const! (mut g) ir/T-PTR 300)) p)
        last (ir/load-node! (mut g) ir/T-U8 1 copied (ir/add! (mut g) ir/T-PTR p (ir/const! (mut g) ir/T-PTR 499)))]
    (graph/set-input! (mut g) (ir/return! (mut g) last 1) 1 (ir/zext! (mut g) ir/T-U64 last))
    g))

(defn expected [(x u64)] (-> u64)
  (let [a (primitive/iadd (primitive/imul x (: 3 u64)) (: 1 u64))
        b (helper (primitive/iadd x (: 1 u64)))
        c (primitive/iadd (primitive/imul b (: 3 u64)) (: 1 u64))]
    (primitive/iadd (primitive/iadd (primitive/iadd a b) c) (primitive/iadd (: 1000 u64) a))))

(defn main [] (-> i64)
  (let [(mut im) (image/create (malloc-allocator))
        triple-symbol (image/symbol! (mut im) "triple")
        helper-symbol (image/symbol! (mut im) "helper")
        both-symbol (image/symbol! (mut im) "both")
        table-symbol (image/symbol! (mut im) "table")
        ; The data: the number 1000, then the address of `triple`.
        (mut table) (ArrayList::new [u8] (malloc-allocator))
        (mut outside) (ArrayList::new [u64] (malloc-allocator))
        (mut failures) 0]
    (for i (range 0 16) (push! (mut table) (cond (= i 0) (: 0xE8 u8) (= i 1) (: 3 u8) :else (: 0 u8))))
    (let [at (image/add-data! (mut im) table-symbol (slice table) 8)]
      (image/add-pointer! (mut im) (+ at 8) triple-symbol))
    (compile! (mut im) "both" (both triple-symbol helper-symbol table-symbol))
    (compile! (mut im) "triple" (triple))
    (compile! (mut im) "spread" (spread))
    (for _ (range 0 (len (.names im))) (push! (mut outside) 0))
    (set! (mut outside) (image/symbol! (mut im) "memcpy")
          (primitive/cast u64 (os/dlsym (primitive/cast (ptr i8) (os/os-pick 0 -2 0)) c"memcpy")))
    (set! (mut outside) (image/symbol! (mut im) "memset")
          (primitive/cast u64 (os/dlsym (primitive/cast (ptr i8) (os/os-pick 0 -2 0)) c"memset")))
    (set! (mut outside) helper-symbol (primitive/cast u64 (primitive/cast (ptr i8) (fnptr-of helper))))
    (let [loaded (jit/load-image im outside (fnptr-of isa/patch))
          f (primitive/cast (fnptr (cc/C) [u64] u64) (jit/address-of loaded both-symbol))]
      (for x (range 0 50)
        (when (!= (f (cast u64 (* x 977))) (expected (cast u64 (* x 977))))
          (set! failures (+ failures 1))))
      (let [spread-fn (primitive/cast (fnptr (cc/C) [(ptr u8)] u64) (jit/address-of loaded (image/symbol! (mut im) "spread")))
            (mut room) (ArrayList::new [u8] (malloc-allocator))]
        (for _ (range 0 600) (push! (mut room) 1))
        (when (!= (spread-fn (elem room 0)) 0x5A) (set! failures (+ failures 1)))
        (for i (range 0 600)
          (when (!= (get room i) (if (< i 500) (: 0x5A u8) (: 1 u8))) (set! failures (+ failures 1))))))
    (println "linked in memory: {} failures" failures)
    ; The same image as an object file, for the system's linker.
    (let [(mut object) (macho/write im (malloc-allocator))]
      (match (fs/write-file (malloc-allocator) "out/link.o" (slice object))
        (Ok [_] (println "wrote out/link.o, {} bytes" (len object)))
        (Err [_] (do (println "cannot write out/link.o") (set! failures (+ failures 1))))))
    (if (= failures 0) 0 1)))
