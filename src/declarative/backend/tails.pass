# A function that ends some way by calling itself and returning what that
# returned goes round a loop instead: its parameters become phis of what
# arrived and what each such call passes. Only where every frame object is
# read and written and nothing else, so that none is still wanted by the call.
pass in unit
use cfg as cfg
use loops as loops

setting self-symbol: Int               # one more than the function's own symbol; 0 if not known
state site-call: [Node]                # each such call,
state site-never: [Node]               # and the test, never true, that parts it from the return
tally looped: Int

# Whether address `a`, of or into a frame object, is only read and written through.
fn private?(a: Node) -> Bool {
  for e in edges(a) {
    let u = edge-user(e)
    let k = edge-slot(e)
    if u is ADD and (u.in(0) is CONST or u.in(1) is CONST) {
      if not private?(u) { return false }
    } else if not ((u is LOAD or u is STORE) and k == 1) { return false }
  }
  true
}

fn itself?(c: Node) -> Bool {
  if not (c is CALL) or self-symbol == 0 or not (c.in(1) is SYMBOL) or int(c.in(1).payload) + 1 != self-symbol { return false }
  if c.arity - 2 != param-count() or shape-pinned(int(c.payload)) or shape-variadic(int(c.payload)) { return false }
  # A parameter that is the address of the caller's copy is not the argument.
  all k in 0..param-count(): int(c.in(k + 2).type) == int(param-type(k)) and not has-bit(param-passing(k), 12)
}

# Whether `v`, the `n`th value of its kind a return gives back, is what call
# `c` gave back as the `n`th of that kind, and nothing else reads it.
fn result-of?(v: Node, c: Node, n: Int) -> Bool = v is RESULT and v.in(0) == c and int(v.payload) == n and v.uses == 1

# The control parted from `c` by a test that is never true: a way on that is
# never taken, and the way round. Notes the site.
fn part(c: Node) -> Node {
  let never = ir.if!(mut graph, c.in(0), ir.make-const!(mut graph, ir.T-BOOL, word(0)))
  site-call.push(c)
  site-never.push(never)
  ir.true!(mut graph, never)
}

# A zero of `v`'s type, for a way never taken.
fn nothing(v: Node) -> Node = ir.make-const!(mut graph, v.type, word(0))

# Return `r` straight after a call of the function itself.
fn direct(r: Node) {
  let c = r.in(0)
  if not itself?(c) { return }
  var ints = 0
  var floats = 0
  for i in 1..r.arity {
    let v = r.in(i)
    if v.float {
      if not result-of?(v, c, floats) { return }
      floats = floats + 1
    } else {
      if not result-of?(v, c, ints) { return }
      ints = ints + 1
    }
  }
  set-input(r, 0, part(c))
  for i in 1..r.arity { set-input(r, i, nothing(r.in(i))) }
}

# The values `values` are returned where ways meet at `region`, each a phi
# there: each way that is a call of the function itself whose results are what
# the phis are on that way goes round instead; and a way that is itself where
# ways meet, bringing phis nothing else reads, is looked into the same.
fn joined(region: Node, values: [Node], deep: Int) {
  for v in values { if not (v is PHI and v.in(0) == region) { return } }
  for j in 0..region.arity {
    let c = region.in(j)
    if itself?(c) {
      var ints = 0
      var floats = 0
      var ok = true
      for v in values {
        let x = v.in(j + 1)
        if x.float {
          if not result-of?(x, c, floats) { ok = false }
          floats = floats + 1
        } else {
          if not result-of?(x, c, ints) { ok = false }
          ints = ints + 1
        }
      }
      if ok {
        set-input(region, j, part(c))
        for v in values { set-input(v, j + 1, nothing(v)) }
      }
    } else if c is REGION and deep < 4 {
      var inner: [Node] = []
      var only = true
      for v in values {
        let x = v.in(j + 1)
        if x.uses != 1 { only = false }
        inner.push(x)
      }
      if only { joined(c, inner, deep + 1) }
    }
  }
}

fn run() {
  if self-symbol == 0 or not cfg.on?(4) { return }
  for n in Node {
    if not n.dead and ((n is SLOT and not private?(n)) or n is RESERVE) { return }
  }
  site-call.clear()
  site-never.clear()
  for n in Node {
    if not n.dead and n is RETURN {
      if n.in(0) is CALL { direct(n) } else if n.in(0) is REGION {
        var values: [Node] = []
        for i in 1..n.arity { values.push(n.in(i)) }
        joined(n.in(0), values, 0)
      }
    }
  }
  if site-call.len == 0 { return }
  let start = first n in Node: not n.dead and n is START
  let round = ir.loop!(mut graph, site-call.len + 1)
  grow-nodes()
  loops.follow(start, round)
  set-input(round, 0, start)
  for j in 0..site-call.len { set-input(round, j + 1, ir.false!(mut graph, site-never[j])) }
  var params: [Node] = []
  for n in Node { if not n.dead and n is PARAM { params.push(n) } }
  for p in params {
    let phi = ir.phi!(mut graph, p.type, round, site-call.len + 1)
    replace-uses(p, phi)
    set-input(phi, 1, p)
    for j in 0..site-call.len { set-input(phi, j + 2, site-call[j].in(int(p.payload) + 2)) }
  }
  grow-nodes()
  # The calls and their results go: nothing reads them now.
  for c in site-call {
    var results: [Node] = []
    for u in users(c) { if u is RESULT { results.push(u) } }
    for u in results { drop(u) }
    drop(c)
  }
  looped = looped + site-call.len
}
