# Replacements that depend on what is known of a value.
rewrite in unit
nodes declarative.backend.nodes
facts facts
masking AND

# A mask that keeps every bit the value can have keeps the value.
rule and-keeps-all   : AND(x, CONST m) when (m & ones(width(x))) == ones(width(x))   => x

# With its top bit known to be zero, a value's sign and zero extensions agree,
# and so do its signed and unsigned shifts, divisions and comparisons.
rule sext-of-small   : SEXT(x) when width(x) < bits(x)                                => ZEXT(x)
rule sar-of-small    : SAR(x, y) when width(x) < bits(x)                              => SHR(x, y)
rule lt-of-small     : LT(x, y) when width(x) < bits(x) and width(y) < bits(y)        => ULT(x, y)
rule le-of-small     : LE(x, y) when width(x) < bits(x) and width(y) < bits(y)        => ULE(x, y)
rule sdiv-of-small   : SDIV(x, y) when width(x) < bits(x) and width(y) < bits(y)      => UDIV(x, y)
rule srem-of-small   : SREM(x, y) when width(x) < bits(x) and width(y) < bits(y)      => UREM(x, y)

# A value shifted right past all its bits, or compared below a bound it cannot reach.
rule shr-past        : SHR(x, CONST k) when k >= width(x) and k < bits(x)             => 0
rule ult-bounded     : ULT(x, CONST k) when width(x) < 63 and k >= 0 and (1 << width(x)) <= k => 1
