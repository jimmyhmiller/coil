# A branch that only chooses between values, its two ways doing nothing else
# and meeting again at once, is the choice itself: each phi there becomes one
# of two values by the condition, and the branch goes. Only where what either
# way alone would have computed is little and cannot fault.
pass in unit
use cfg as cfg
use loops as loops

tally chosen: Int

# What computing `v` costs that would not be computed anyway: nothing for a
# value others read too or that stays where it is, one for each node only this
# reads, and too much for one that is deep, or could fault, or is not cheap.
fn extra(v: Node, deep: Int) -> Int {
  if v is CONST or v is PARAM or v is PHI or v is RESULT or v is SLOT or v is SYMBOL or v is EXTERN or cfg.control?(v) { return 0 }
  if v.uses > 1 { return 0 }
  if deep == 0 or v is UDIV or v is SDIV or v is UREM or v is SREM or v is MUL or v.float { return 100 }
  var cost = 1
  for i in inputs(v) { if i != none { cost = cost + extra(i, deep - 1) } }
  cost
}

fn choose(r: Node) {
  if r.arity != 2 { return }
  let a = r.in(0)
  let b = r.in(1)
  if not ((a is TRUE and b is FALSE) or (a is FALSE and b is TRUE)) or a.in(0) != b.in(0) { return }
  if a.uses != 1 or b.uses != 1 { return }
  let test = a.in(0)
  if not (test is IF) { return }
  var phis: [Node] = []
  var cost = 0
  for u in users(r) {
    if u is PHI and u.in(0) == r {
      if u.bits > 64 { return }
      phis.push(u)
      cost = cost + extra(u.in(1), 2) + extra(u.in(2), 2)
    }
  }
  if phis.len == 0 or phis.len > 2 or cost > 2 { return }
  let yes = if a is TRUE then 1 else 2
  for p in phis {
    let pick = ir.cond!(mut graph, p.type, test.in(1), p.in(yes), p.in(3 - yes))
    grow-nodes()
    replace-uses(p, pick)
    drop(p)
  }
  loops.follow(r, test.in(0))
  drop(r)
  drop(a)
  drop(b)
  drop(test)
  chosen = chosen + 1
}

fn run() -> Int {
  if not cfg.on?(13) { return 0 }
  let was = chosen
  for n in Node { if not n.dead and n is REGION { choose(n) } }
  chosen - was
}
