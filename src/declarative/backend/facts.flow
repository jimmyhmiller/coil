# What is known of values without running them.
flow in unit
nodes declarative.backend.nodes

# How many of a value's low bits may be set: every bit above them is zero.
fact width holds bit-length(value) <= width
  CONST k          = bit-length(k)
  ZEXT(x)          = width(x)
  TRUNC(x)         = width(x)
  AND(x, y)        = min(width(x), width(y))
  OR(x, y)         = max(width(x), width(y))
  XOR(x, y)        = max(width(x), width(y))
  SHR(x, CONST k)  = width(x) - mod(k, bits(x))     # a shift counts modulo the width
  UDIV(x, y)       = width(x)
  UREM(x, y)       = width(x)                       # by zero, it is x itself
  UMIN(x, y)       = min(width(x), width(y))
  UMAX(x, y)       = max(width(x), width(y))
  COND(_, x, y)    = max(width(x), width(y))
  CLZ(x)           = bit-length(bits(x))
  CTZ(x)           = bit-length(bits(x))
  POPCNT(x)        = bit-length(bits(x))
  PHI              = join
