# What a compile is, as plans.
pipeline in unit

# From a graph to code, with no optimization beyond what building the graph did.
plan quick {
  atomics.run
  blocks.run
  cfg.build
  schedule.build
  select.run
  alloc.run
  emit.run
}

# Frame objects that can be values become values; then simplify until nothing
# changes, solve the facts, simplify with them, and compile.
# Then what the facts allow, and what that opens up.
plan default {
  switches.settle
  atomics.run
  until-stable { simplify.run }
  copies.run
  blocks.run
  split.run
  cfg.build
  promote.run
  forward.run
  start-over
  until-stable { simplify.run }
  tails.run
  facts.solve
  until-stable { narrow.run  simplify.run }
  until-stable { forward.prune }
  loops.run
  switches.run
  until-stable { simplify.run  selects.run }
  quick
}
