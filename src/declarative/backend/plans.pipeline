# Graph scheduling shared by the machine units.
plan quick {
  run atomics.run;
  run blocks.run;
  run cfg.build;
  run schedule.build;
  run select.run;
  run alloc.run;
  run emit.run;
}

plan default {
  run switches.settle;
  run atomics.run;
  repeat { observe simplify.run; }
  run copies.run;
  run blocks.run;
  run split.run;
  run cfg.build;
  run promote.run;
  run forward.run;
  invalidate;
  repeat { observe simplify.run; }
  run tails.run;
  run facts.solve;
  repeat { observe narrow.run; observe simplify.run; }
  repeat { observe forward.prune; }
  run loops.run;
  run switches.run;
  repeat { observe simplify.run; observe selects.run; }
  include quick;
}
