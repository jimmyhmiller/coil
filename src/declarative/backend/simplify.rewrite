# What a value may be replaced by. A node whose inputs are all constants is
# folded by its meaning; these are the rest.
rewrite in unit
nodes declarative.backend.nodes

# Identities.
rule add-zero      : ADD(x, CONST 0)                   => x
rule sub-zero      : SUB(x, CONST 0)                   => x
rule sub-self      : SUB(x, x)                         => 0
rule zero-sub      : SUB(CONST 0, x)                   => NEG(x)
rule mul-one       : MUL(x, CONST 1)                   => x
rule mul-zero      : MUL(x, CONST 0)                   => 0
rule and-zero      : AND(x, CONST 0)                   => 0
rule and-ones      : AND(x, CONST -1)                  => x
rule and-self      : AND(x, x)                         => x
rule or-zero       : OR(x, CONST 0)                    => x
rule or-ones       : OR(x, CONST -1)                   => -1
rule or-self       : OR(x, x)                          => x
rule xor-zero      : XOR(x, CONST 0)                   => x
rule xor-self      : XOR(x, x)                         => 0
rule xor-ones      : XOR(x, CONST -1)                  => NOT(x)
rule shl-zero      : SHL(x, CONST 0)                   => x
rule shr-zero      : SHR(x, CONST 0)                   => x
rule sar-zero      : SAR(x, CONST 0)                   => x
rule udiv-one      : UDIV(x, CONST 1)                  => x
rule sdiv-one      : SDIV(x, CONST 1)                  => x
rule add-then-sub  : SUB(ADD(x, y), y)                 => x
rule sub-then-add  : ADD(SUB(x, y), y)                 => x
rule neg-neg       : NEG(NEG(x))                       => x
rule not-not       : NOT(NOT(x))                       => x

# Cheaper forms.
rule mul-pow2      : MUL(x, CONST k) when pow2(k)      => SHL(x, log2(k))
rule udiv-pow2     : UDIV(x, CONST k) when pow2(k)     => SHR(x, log2(k))
rule urem-pow2     : UREM(x, CONST k) when pow2(k)     => AND(x, k - 1)
rule sub-const     : SUB(x, CONST k)                   => ADD(x, -k)
rule add-neg       : ADD(x, NEG(y))                    => SUB(x, y)
rule sub-neg       : SUB(x, NEG(y))                    => ADD(x, y)

# Constants together.
rule add-add       : ADD(ADD(x, CONST a), CONST b)     => ADD(x, a + b)
rule mul-mul       : MUL(MUL(x, CONST a), CONST b)     => MUL(x, a * b)
rule and-and       : AND(AND(x, CONST a), CONST b)     => AND(x, a & b)
rule or-or         : OR(OR(x, CONST a), CONST b)       => OR(x, a | b)
rule xor-xor       : XOR(XOR(x, CONST a), CONST b)     => XOR(x, a ^ b)

# Comparisons.
rule eq-self       : EQ(x, x)                          => 1
rule ne-self       : NE(x, x)                          => 0
rule lt-self       : LT(x, x)                          => 0
rule le-self       : LE(x, x)                          => 1
rule ult-self      : ULT(x, x)                         => 0
rule ule-self      : ULE(x, x)                         => 1
rule not-eq        : NOT(EQ(a, b))                     => NE(a, b)
rule not-ne        : NOT(NE(a, b))                     => EQ(a, b)
rule not-lt        : NOT(LT(a, b))                     => LE(b, a)
rule not-le        : NOT(LE(a, b))                     => LT(b, a)
rule not-ult       : NOT(ULT(a, b))                    => ULE(b, a)
rule not-ule       : NOT(ULE(a, b))                    => ULT(b, a)

# Whether a value is zero is not changed by widening it; a boolean widened is
# not zero when it holds.
rule eq-zext-zero  : EQ(ZEXT(x), CONST 0) when bits(x) > 1   => EQ(x, 0)
rule ne-zext-zero  : NE(ZEXT(x), CONST 0) when bits(x) > 1   => NE(x, 0)
rule eq-sext-zero  : EQ(SEXT(x), CONST 0)              => EQ(x, 0)
rule ne-sext-zero  : NE(SEXT(x), CONST 0)              => NE(x, 0)
rule ne-bool-zero  : NE(ZEXT(x), CONST 0) when bits(x) == 1  => x
rule eq-bool-zero  : EQ(ZEXT(x), CONST 0) when bits(x) == 1  => NOT(x)

# Choices.
rule cond-same     : COND(c, x, x)                     => x
rule cond-true     : COND(CONST 1, x, y)               => x
rule cond-false    : COND(CONST 0, x, y)               => y
rule cond-not      : COND(NOT(c), x, y)                => COND(c, y, x)

# Widths.
rule zext-zext     : ZEXT(ZEXT(x))                     => ZEXT(x)
rule sext-sext     : SEXT(SEXT(x))                     => SEXT(x)
rule sext-zext     : SEXT(ZEXT(x))                     => ZEXT(x)

# A phi whose inputs are all one value, or that value and itself.
rule phi-same      : PHI(_, x, x)                      => x
rule phi-loop      : PHI(_, x, self)                   => x

# A branch on a constant goes one way; what the other way led to is gone.
rule if-true       : IF(_, CONST 1)                    => always true
rule if-false      : IF(_, CONST 0)                    => always false
