# Machine code before registers are chosen: instructions in layout order, each
# with up to five operands. A register operand is a virtual register (a positive
# number: the node it holds, or a fresh one) or a machine register r, written
# -(r + 1). What each operand is comes from the target's description.
pass in unit

entity Inst
column inst-op: Inst -> Int
column a0: Inst -> Int
column a1: Inst -> Int
column a2: Inst -> Int
column a3: Inst -> Int
column a4: Inst -> Int
column also-reads: Inst -> Word       # machine registers it reads besides its operands
column also-writes: Inst -> Word      # and writes
column kind: Inst -> Int               # 1 a register copy, 2 a jump, 3 a return, 4 a read of the caller's frame,
                                       # 5 the address just above the arguments for calls,
                                       # 6 the frame register put back, 7 the base register put back, else 0
column caller-bytes: Inst -> Int       # for a read of the caller's frame: how many bytes
column copy-to: Inst -> Int            # for a copy: the register written
column copy-from: Inst -> Int          # and the register read
column calling: Inst -> Bool           # it calls a function
column came-from: Inst -> Int               # where the node it computes came from (`origin`), or 0
state emitting-from: Int               # that, for the instructions being emitted
column first-inst: Block -> Int       # a block's instructions are first..last
column last-inst: Block -> Int
column needed: Node -> Bool           # must be in a register
column tile: Node -> Int              # the rule that computes it, or 0
column local-reg: Node -> Int         # for a node computed per block: its register there
column local-block: Node -> Block
column kept: Node -> Bool             # computed once after all, where it was placed: it costs
                                      # several instructions and is wanted inside a loop
state emitting: Block                 # the block whose instructions are being emitted
state next-vreg: Int
column object-at: Node -> Int         # a frame object's distance below the frame record
state object-bytes: Int               # bytes of frame objects, a multiple of 16
state out-slots: Int                  # frame slots for arguments passed on the stack
state calls: Bool                     # the function calls another
state dynamic: Bool                   # the function moves the stack pointer as it runs
state pinned-writes: Word             # registers that calls following no convention may write
state worklist: [Node]
state wide-temps: [Int]               # the fresh registers that hold sixteen bytes

fn emit(op: Int, a: Int, b: Int, c: Int, d: Int, e: Int) {
  let i = Inst.new()
  i.came-from = emitting-from
  i.inst-op = op
  i.a0 = a
  i.a1 = b
  i.a2 = c
  i.a3 = d
  i.a4 = e
}

fn arg(i: Inst, k: Int) -> Int =
  if k == 0 then i.a0 else if k == 1 then i.a1 else if k == 2 then i.a2 else if k == 3 then i.a3 else i.a4

fn fresh() -> Int {
  next-vreg = next-vreg + 1
  next-vreg
}

# A fresh register for a value of `n`'s kind.
fn fresh-like(n: Node) -> Int {
  let t = fresh()
  if n.bits == 128 { wide-temps.push(t) }
  t
}

fn need(n: Node) {
  if not n.needed {
    n.needed = true
    worklist.push(n)
  }
}

# The block an IF goes to when its condition holds (taken = 1) or does not.
fn target(n: Node, taken: Int) -> Int {
  let proj = first u in users(n): if taken == 1 then u is TRUE else u is FALSE
  int(proj.block-of)
}

# A node a rule may compute as part of its root: nothing else reads it, and it
# was not moved to a block that runs less often than the root's.
fn fusable(inner: Node, root: Node) -> Bool = inner.uses == 1 and inner.block-of == root.block-of

# The register a per-block node has in the block being emitted, or 0.
fn kept?(n: Node) -> Bool = n.kept

fn local(n: Node) -> Int = if n.local-block == emitting then n.local-reg else 0

fn set-local(n: Node, r: Int) {
  n.local-block = emitting
  n.local-reg = r
}

fn rule-of(n: Node) -> Int = n.tile

# Instruction `at` also reads and writes these machine registers.
fn implicit-at(at: Int, reads: Word, writes: Word) {
  let i: Inst = id(at)
  i.also-reads = reads
  i.also-writes = writes
}

fn mark-call-at(at: Int) {
  let i: Inst = id(at)
  i.calling = true
}

# The instruction just emitted also reads and writes these machine registers.
fn implicit(reads: Word, writes: Word) {
  let i = id(Inst.count)
  i.also-reads = reads
  i.also-writes = writes
}

# The instruction just emitted reads register `d` from `bytes` bytes at `at`
# in the caller's frame, which is as far above this function's own as the
# frame is large: where exactly is known only when the frame is.
fn from-caller(d: Int, at: Int, bytes: Int) {
  let i = id(Inst.count)
  i.kind = 4
  i.copy-to = d
  i.copy-from = at
  i.caller-bytes = bytes
}

# The instruction just emitted gives register `d` the address `at` bytes into
# the caller's frame, which is as far above this function's own as the frame
# is large.
fn caller-address(d: Int, at: Int) {
  let i = id(Inst.count)
  i.kind = 11
  i.copy-to = d
  i.copy-from = at
}

# The instruction just emitted writes register `r` to `bytes` bytes at `at` in
# the caller's frame: an argument, on the stack, of a call that leaves this
# function for good, which goes where this function's own such parameters came.
fn to-caller(r: Int, at: Int, bytes: Int) {
  let i = id(Inst.count)
  i.kind = 12
  i.copy-to = r
  i.copy-from = at
  i.caller-bytes = bytes
}

# The instruction just emitted gives register `d` the address just above the
# arguments for calls, which is known only when every call has been seen.
fn above-arguments(d: Int) {
  let i = id(Inst.count)
  i.kind = 5
  i.copy-to = d
}

# How far below the frame record a frame object lies. Objects up to 8 bytes
# are aligned to 8, larger ones to 16.
fn object-offset(n: Node) -> Int {
  if n.object-at == 0 {
    let size = max(int(n.payload), 1)
    let align = if size > 8 then 16 else 8
    object-bytes = (object-bytes + size + align - 1) / align * align
    n.object-at = object-bytes
  }
  n.object-at
}

# What the instruction just emitted is to the passes, as its template says.
fn mark-copy(d: Int, s: Int) {
  let i = id(Inst.count)
  i.kind = 1
  i.copy-to = d
  i.copy-from = s
}

# The instruction just emitted stands for putting the frame register (6) or
# the base register (7) back after something wrote it: how is known only when
# the frame is.
fn mark-restore(which: Int) {
  id(Inst.count).kind = which
}

# The instruction just emitted stands for reading (8) or writing (9) `bytes`
# bytes of a frame object `below` bytes under the frame record, into or from
# register `r`, or for giving `r` that address (10): the instruction it becomes
# is known only when the frame is laid out.
fn mark-object(kind: Int, r: Int, below: Int, bytes: Int) {
  let i = id(Inst.count)
  i.kind = kind
  i.copy-to = r
  i.copy-from = below
  i.caller-bytes = bytes
}

# The instruction just emitted is a call.
fn mark-call() {
  id(Inst.count).calling = true
}

fn mark-jump() {
  id(Inst.count).kind = 2
}

fn mark-return() {
  id(Inst.count).kind = 3
}
