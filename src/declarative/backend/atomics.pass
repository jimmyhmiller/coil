# An update the machine has no instruction for becomes a loop around the one it
# has: read what is there, work out what to leave, and leave it if nothing else
# got there first.
pass in unit
use cfg as cfg
use lower as lower

tally expanded: Int
state spelled: Bool                   # an update here was spelled out: its block is now several

# What `n` leaves in memory, from what was there.
fn left(n: Node, old: Node, v: Node) -> Node {
  let t = n.type
  if n is SWAP { return v }
  if n is FETCH-ADD { return ir.add!(mut graph, t, old, v) }
  if n is FETCH-SUB { return ir.sub!(mut graph, t, old, v) }
  if n is FETCH-AND { return ir.and!(mut graph, t, old, v) }
  if n is FETCH-NAND { return ir.not!(mut graph, t, ir.and!(mut graph, t, old, v)) }
  if n is FETCH-OR { return ir.or!(mut graph, t, old, v) }
  if n is FETCH-XOR { return ir.xor!(mut graph, t, old, v) }
  if n is FETCH-SMAX { return ir.smax!(mut graph, t, old, v) }
  if n is FETCH-SMIN { return ir.smin!(mut graph, t, old, v) }
  if n is FETCH-UMAX { return ir.umax!(mut graph, t, old, v) }
  if n is FETCH-UMIN { return ir.umin!(mut graph, t, old, v) }
  panic("the machine has no instruction for this update, and it is not one a loop can do")
  n
}

fn expand(n: Node) {
  from(n)
  let t = n.type
  let first = ir.atomic-load!(mut graph, t, n.in(0), n.in(1))
  let loop = ir.loop!(mut graph, 2)
  let old = ir.phi!(mut graph, t, loop, 2)
  let tried = ir.cas!(mut graph, t, loop, n.in(1), old, left(n, old, n.in(2)))
  let done = ir.if!(mut graph, tried, ir.eq!(mut graph, tried, old))
  let out = ir.true!(mut graph, done)
  set-input(loop, 0, first)
  set-input(loop, 1, ir.false!(mut graph, done))
  set-input(old, 1, first)
  set-input(old, 2, tried)
  grow-nodes()
  # What followed the update in control follows the loop; what read it reads
  # the value that was there when the loop's write went through.
  for e in edges(n) {
    let u = edge-user(e)
    let k = edge-slot(e)
    if u is REGION or u is LOOP or (k == 0 and cfg.control?(u)) { set-input(u, k, out) } else { set-input(u, k, tried) }
  }
  drop(n)
  from(none)
  expanded = expanded + 1
  spelled = true
}

fn run() {
  for n in Node {
    if not n.dead and cfg.update?(n) and not (n is CAS) and lower.select(n) == 0 { expand(n) }
  }
}
