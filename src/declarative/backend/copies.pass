# Copies of whole records that need not be made. A frame object that is only
# ever written is never made at all. A record copied into a frame object that
# is then only copied on, or only read, with the original not written in
# between, is copied or read from where it was.
pass in unit
use cfg as cfg

tally elided: Int
state copy-reads: [Node]                  # the loads of the frame object in hand, as they are met

# What address `a` is an offset from.
fn base(a: Node) -> Node =
  if a is ADD and a.in(1) is CONST then a.in(0) else if a is ADD and a.in(0) is CONST then a.in(1) else a

fn offset(a: Node) -> Int =
  if a is ADD and a.in(1) is CONST then int(a.in(1).payload) else if a is ADD and a.in(0) is CONST then int(a.in(0).payload) else 0

# Whether everything done with address `a`, of or into a frame object, is a
# write there: a store, or a copy or a fill to it.
fn only-written?(a: Node) -> Bool {
  for e in edges(a) {
    let u = edge-user(e)
    let k = edge-slot(e)
    if u is ADD and (u.in(0) is CONST or u.in(1) is CONST) {
      if not only-written?(u) { return false }
    } else if not (((u is STORE and u.payload == 0) or u is COPY or u is FILL) and k == 1) { return false }
  }
  true
}

# Whether everything done with address `a` is a plain read or write through it.
fn private?(a: Node) -> Bool {
  for e in edges(a) {
    let u = edge-user(e)
    let k = edge-slot(e)
    if u is ADD and (u.in(0) is CONST or u.in(1) is CONST) {
      if not private?(u) { return false }
    } else if not ((u is LOAD or u is STORE) and k == 1) { return false }
  }
  true
}

# Control node `c` goes: what followed it follows what it followed.
fn unlink(c: Node) {
  var users: [Node] = []
  var slots: [Int] = []
  for e in edges(c) {
    users.push(edge-user(e))
    slots.push(edge-slot(e))
  }
  for i in 0..users.len { set-input(users[i], slots[i], c.in(0)) }
  drop(c)
}

# The writes to address `a` and into it go.
fn unwrite(a: Node) {
  var users: [Node] = []
  for u in users(a) { users.push(u) }
  for u in users {
    if not u.dead {
      if u is ADD { unwrite(u) } else { unlink(u) }
    }
  }
}

# Whether control node `c` may write memory that address `from` reaches: a
# store to a frame object nothing else can reach is one that cannot.
fn may-write?(c: Node, from: Node) -> Bool {
  if c is LOAD or c is ATOMIC-LOAD or c is FENCE { return false }
  if c is CALL { return not (c.in(1) is SYMBOL and reads-only(c.in(1).payload)) }
  if c is STORE {
    let to = base(c.in(1))
    return not (to is SLOT and to != base(from) and private?(to))
  }
  true
}

# A record copied into frame object `s` by copy `c`, and then only copied on
# from there by one copy further down the same block, the original not
# written between: the second copy is from the original and the first goes.
# Or only read, down the same block, the original not written before the
# last read: the reads are of the original and the copy goes.
fn through(c: Node) {
  let s = c.in(1)
  if not (s is SLOT) or c.in(2) == s { return }
  let src = c.in(2)
  # Who uses the object besides `c`: one copy from it, or loads.
  var onward: Node = none
  var loads = 0
  for e in edges(s) {
    let u = edge-user(e)
    let k = edge-slot(e)
    if u == c and k == 1 { }
    else if u is COPY and k == 2 and u.in(1) != s and onward == none and u.payload <= c.payload { onward = u }
    else if u is LOAD and k == 1 { loads = loads + 1 }
    else if u is ADD and u.in(0) == s and u.in(1) is CONST and int(u.in(1).payload) < int(c.payload) and (all e2 in edges(u): edge-user(e2) is LOAD and edge-slot(e2) == 1) {
      loads = loads + (count e2 in edges(u): true)
    }
    else { return }
  }
  if (onward != none and loads > 0) or (onward == none and loads == 0) { return }
  copy-reads.clear()
  var at = cfg.follower(c)
  while at != none and cfg.chain?(at) {
    if at == onward {
      set-input(onward, 2, src)
      unlink(c)
      elided = elided + 1
      return
    }
    if at is LOAD and base(at.in(1)) == s { copy-reads.push(at) }
    else if may-write?(at, src) { return }
    if onward == none and copy-reads.len == loads {
      for l in copy-reads {
        let k = offset(l.in(1))
        set-input(l, 1, if k == 0 then src else ir.add!(mut graph, ir.T-PTR, src, ir.make-const!(mut graph, ir.T-PTR, word(k))))
      }
      grow-nodes()
      unlink(c)
      elided = elided + 1
      return
    }
    at = cfg.follower(at)
  }
}

fn run() {
  # Not when the program is to be looked at: what is only written is still looked at.
  if not cfg.on?(17) or debugging { return }
  for n in Node {
    if not n.dead and n is SLOT and n.uses > 0 and only-written?(n) {
      unwrite(n)
      elided = elided + 1
    }
  }
  for n in Node { if not n.dead and n is COPY { through(n) } }
}
