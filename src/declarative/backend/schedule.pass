# Where each floating node goes, and in what order a block computes its nodes.
# Click's global code motion: as early as its inputs allow, as late as its uses
# allow, and between those the block in the fewest loops.
pass in unit
use cfg as cfg

column early-done: Node -> Bool
column late-done: Node -> Bool
column placed: Node -> Bool
column seq: Block -> [Node]           # a block's nodes, in the order they run
column members: Block -> [Node]       # the floating nodes scheduled into a block

fn pinned?(n: Node) -> Bool = cfg.control?(n) or n is PHI or n is PARAM or n is RESULT

# Both walks stop at pinned nodes, whose blocks are known: the floating nodes
# between them form no cycle, so each is placed after all it depends on.
fn early(n: Node) {
  if n.early-done or pinned?(n) { return }
  n.early-done = true
  var b = cfg.entry()
  for i in inputs(n) {
    if i != none {
      early(i)
      if i.block-of.dom-depth > b.dom-depth { b = i.block-of }
    }
  }
  n.block-of = b
}

fn late(n: Node) {
  if n.late-done or pinned?(n) { return }
  n.late-done = true
  for u in users(n) { late(u) }
  var lca: Block = none
  for u in users(n) {
    if u is PHI {
      let region = u.in(0).block-of
      for i in 1..u.arity {
        if u.in(i) == n { lca = cfg.join(lca, region.preds[i - 1]) }
      }
    } else if u.block-of != none {
      lca = cfg.join(lca, u.block-of)
    }
  }
  let earliest = n.block-of
  n.block-of = none
  if lca != none {
    var best = lca
    var x = lca
    while x != earliest {
      if x == x.idom { panic("a node's uses are not dominated by its inputs") }
      x = x.idom
      if x.loop-depth < best.loop-depth { best = x }
    }
    n.block-of = best
    best.members.push(n)
  }
}

# The block where `u` uses value `n`: its own, or for a phi the block the
# value comes from.
fn use-block(u: Node, n: Node) -> Block {
  if not (u is PHI) { return u.block-of }
  let region = u.in(0).block-of
  var found: Block = none
  for i in 1..u.arity {
    if u.in(i) == n { found = cfg.join(found, region.preds[i - 1]) }
  }
  found
}

# Something in the control chain that may write memory.
fn writes-memory?(n: Node) -> Bool =
  n is STORE or n is CALL or n is COPY or n is FILL or n is ATOMIC-STORE or n is RESERVE or cfg.update?(n)

# A load whose value is used only down one of the ways its block ends in is
# made there instead, if nothing after it in its block could write what it
# reads: the other way then does without it. `s` is the block that way begins.
fn sink(l: Node, s: Block) {
  let before = l.in(0)
  var users: [Node] = []
  var slots: [Int] = []
  for e in edges(l) {
    let u = edge-user(e)
    let k = edge-slot(e)
    if u is REGION or u is LOOP or (k == 0 and cfg.control?(u)) {
      users.push(u)
      slots.push(k)
    }
  }
  for i in 0..users.len { set-input(users[i], slots[i], before) }
  users.clear()
  slots.clear()
  let h = s.head
  for e in edges(h) {
    let u = edge-user(e)
    let k = edge-slot(e)
    if u != l and (u is REGION or u is LOOP or (k == 0 and cfg.control?(u))) {
      users.push(u)
      slots.push(k)
    }
  }
  set-input(l, 0, h)
  for i in 0..users.len { set-input(users[i], slots[i], l) }
  l.block-of = s
}

fn sink-loads(b: Block) {
  if b.succs.len < 2 { return }
  # The loads of the block, and whether anything after each may write memory.
  var loads: [Node] = []
  var c = cfg.follower(b.head)
  while c != none and cfg.chain?(c) {
    if writes-memory?(c) { loads.clear() }
    else if c is LOAD and c.payload == 0 { loads.push(c) }
    c = cfg.follower(c)
  }
  for i in reverse 0..loads.len {
    let l = loads[i]
    var to: Block = none
    var ok = l.uses > 1
    for u in users(l) {
      # Whatever reads the value, which may also be what follows the load.
      # (A node in the flow of control has that flow as its first input, and
      # any other node has a value there.)
      let reads = any k in 0..u.arity: u.in(k) == l and (k > 0 or not cfg.control?(u))
      if reads and not (u is REGION) and not (u is LOOP) {
        let at = use-block(u, l)
        if at == none { ok = false } else { to = cfg.join(to, at) }
      }
    }
    if ok and to != none and to != b {
      # The way out of `b` that leads there.
      for s in b.succs {
        if s.preds.len == 1 and s.loop-depth <= b.loop-depth and cfg.dominates(s, to) { sink(l, s) }
      }
    }
  }
}

# `n` after whatever it needs from its own block. A phi needs nothing there:
# its values are those the blocks before its own end with, and when the block
# comes round to itself, what it reads is computed after it.
fn place(n: Node, b: Block) {
  if n.placed { return }
  n.placed = true
  if not (n is PHI) {
    for i in inputs(n) {
      if i != none and i.block-of == b and not pinned?(i) { place(i, b) }
    }
  }
  b.seq.push(n)
}

fn order-block(b: Block) {
  let h = b.head
  place(h, b)
  for u in users(h) { if u is PHI and u.in(0) == h { place(u, b) } }
  if h is START { for n in Node { if n is PARAM and not n.dead { place(n, b) } } }
  var c = cfg.follower(h)
  while c != none and cfg.chain?(c) {
    place(c, b)
    for u in users(c) { if u is RESULT { place(u, b) } }
    c = cfg.follower(c)
  }
  for n in b.members { place(n, b) }
  if c != none { place(c, b) }
}

fn build() {
  for n in Node { if n is PHI or n is RESULT { n.block-of = n.in(0).block-of } }
  for n in Node { if n is PARAM { n.block-of = cfg.entry() } }
  for n in Node { if not n.dead { early(n) } }
  for n in Node { if not n.dead { late(n) } }
  # A constant that takes several instructions to make, placed outside a loop
  # that something reading it is in, is made once there and not every time round.
  for n in Node {
    if cfg.on?(8) and not n.dead and n is CONST and n.block-of != none and (n.float or int(n.payload) > 65535 or int(n.payload) < -65536) {
      if any u in users(n): u.block-of != none and u.block-of.loop-depth > n.block-of.loop-depth { n.kept = true }
    }
  }
  for b in order { sink-loads(b) }
  for b in order { order-block(b) }
}

fn dump() {
  for b in order {
    print("block {} head={} idom={} loop-depth={}", b, b.head, b.idom, b.loop-depth)
    for n in b.seq { print("  {} {}", n, n.name) }
  }
}
