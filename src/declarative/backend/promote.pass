# Frame objects that are only ever read and written whole become values: each
# read is the value last written on the way to it, with a phi where ways meet.
# The object, its loads and its stores then go.
pass in unit
use cfg as cfg

column chain-pos: Node -> Int          # a chain node's place in its block
column reaching: Node -> Node          # for a load: the value that reaches it
column out-store: Block -> Node        # for the object in hand: the block's last store
column store-mark: Block -> Int
column entry-value: Block -> Node      # and the object's value on entry to the block
column entry-mark: Block -> Int
state serial: Int
tally promoted: Int

fn number-chains() {
  for b in Block {
    var pos = 0
    var c = cfg.follower(b.head)
    while c != none {
      pos = pos + 1
      c.chain-pos = pos
      c = if cfg.chain?(c) then cfg.follower(c) else none
    }
  }
}

# What `u` reads or writes of object `s` as a whole: the type, or 0 if `u` does
# anything else with it.
fn access-type(u: Node, s: Node) -> Int =
  if u is LOAD and u.in(1) == s and u.payload == 0 then int(u.type)
  else if u is STORE and u.in(1) == s and u.in(2) != s and u.payload == 0 then int(u.in(2).type)
  else 0

# Whether a value of type `have` can be read as type `want`: the same bytes
# taken as another type, or integers and `want` the low bits.
fn readable?(want: Int, have: Int) -> Bool =
  type-bytes(id(want)) == type-bytes(id(have)) or (not float-type?(id(want)) and not float-type?(id(have)) and type-bytes(id(want)) < type-bytes(id(have)))

# The type an object is as a value: what it is first written as, every other
# store writing as many bytes and every load reading those or, of an integer,
# the low ones; or 0 if it cannot be a value. An object nothing writes is what
# it is read as, if that is one type.
fn object-type(s: Node) -> Int {
  var t = 0
  for u in users(s) {
    let a = access-type(u, s)
    if a == 0 { return 0 }
    if u is STORE {
      if t != 0 and type-bytes(id(a)) != type-bytes(id(t)) { return 0 }
      if t == 0 { t = a }
    }
  }
  var read = 0
  for u in users(s) {
    if u is LOAD {
      let a = int(u.type)
      if t != 0 and not readable?(a, t) { return 0 }
      if t == 0 and read != 0 and a != read { return 0 }
      read = a
    }
  }
  if t != 0 then t else read
}

# Value `v` as type `t`, which is as many bytes: itself, or its bits as `t`.
fn as-type(v: Node, t: Int) -> Node {
  if int(v.type) == t { return v }
  let cast = ir.bitcast!(mut graph, id(t), v)
  grow-nodes()
  cast
}

# The object's value on entry to `b`: what leaves the one block before it, a
# phi of what leaves each of several, or nothing in particular at the start.
fn entering(b: Block, t: Int) -> Node {
  if b.entry-mark == serial { return b.entry-value }
  if b.preds.len == 1 {
    # Asked for again from further round a loop, this finds the loop's phi:
    # only a block where ways meet can be asked for while it is being worked out.
    let v = leaving(b.preds[0], t)
    b.entry-mark = serial
    b.entry-value = v
    return v
  }
  b.entry-mark = serial
  if b.preds.len == 0 {
    b.entry-value = ir.make-const!(mut graph, id(t), word(0))
    grow-nodes()
  } else {
    let phi = ir.phi!(mut graph, id(t), b.head, b.preds.len)
    grow-nodes()
    b.entry-value = phi
    var i = 1
    for p in b.preds {
      set-input(phi, i, leaving(p, t))
      i = i + 1
    }
  }
  b.entry-value
}

fn leaving(b: Block, t: Int) -> Node =
  if b.store-mark == serial then as-type(b.out-store.in(2), t) else entering(b, t)

# A value that is itself a load of the object stands for what reached that load.
fn settled(v: Node, s: Node) -> Node {
  var x = v
  while x is LOAD and x.in(1) == s { x = x.reaching }
  x
}

# What load `l` reads of value `v`: `v`, or its low bits if the load is narrower.
fn as-read(l: Node, v: Node) -> Node {
  if type-bytes(l.type) == type-bytes(v.type) { return as-type(v, int(l.type)) }
  let low = ir.trunc!(mut graph, l.type, v)
  grow-nodes()
  low
}

fn promote(s: Node) {
  let t = object-type(s)
  if t == 0 { return }
  serial = serial + 1
  var accesses: [Node] = []
  for u in users(s) {
    accesses.push(u)
    if u is STORE {
      let b = u.block-of
      if b.store-mark != serial or u.chain-pos > b.out-store.chain-pos {
        b.store-mark = serial
        b.out-store = u
      }
    }
  }
  # A load takes the value of the store before it in its block, or the block's on entry.
  for l in accesses {
    if l is LOAD {
      var before: Node = none
      for w in accesses {
        if w is STORE and w.block-of == l.block-of and w.chain-pos < l.chain-pos and (before == none or w.chain-pos > before.chain-pos) {
          before = w
        }
      }
      l.reaching = if before != none then as-type(before.in(2), t) else entering(l.block-of, t)
    }
  }
  # Whatever followed an access in control follows what it followed; whatever
  # read a load's value reads the value that reached it.
  for a in accesses {
    for e in edges(a) {
      let u = edge-user(e)
      let k = edge-slot(e)
      if u is REGION or u is LOOP or (k == 0 and cfg.control?(u)) { set-input(u, k, a.in(0)) }
      else { set-input(u, k, as-read(a, settled(a.reaching, s))) }
    }
  }
  for a in accesses { drop(a) }
  drop(s)
  promoted = promoted + 1
}

fn run() {
  if not cfg.on?(11) or debugging { return }
  number-chains()
  for n in Node { if not n.dead and n is SLOT { promote(n) } }
}
