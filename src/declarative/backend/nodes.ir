# The node set: a sea of nodes with explicit control.

type ctrl : 0 control
type bool : 1 unsigned
type i8  : 8 signed
type i16 : 16 signed
type i32 : 32 signed
type i64 : 64 signed
type u8  : 8 unsigned
type u16 : 16 unsigned
type u32 : 32 unsigned
type u64 : 64 unsigned
type ptr : 64 unsigned
type f32 : 32 float
type f64 : 64 float
# Sixteen bytes that live in a floating register: read, written, passed and
# returned whole, and nothing else.
type v128 : 128 float

set int = i8 i16 i32 i64 u8 u16 u32 u64 ptr
set word = bool i8 i16 i32 i64 u8 u16 u32 u64 ptr
set float = f32 f64
set value = bool i8 i16 i32 i64 u8 u16 u32 u64 ptr f32 f64
set stored = bool i8 i16 i32 i64 u8 u16 u32 u64 ptr f32 f64 v128
set signed-wide = i32 i64
set wide = i32 i64 u32 u64 ptr
set unsigned-wide = u32 u64

# Control. A control node's first operand is the control it follows.
node START : ctrl                               role start
# A function returns any number of values: integers in the convention's integer
# result registers in order, floating values in its floating ones.
node RETURN(c: ctrl, values...)                 role return
node REGION(c...: ctrl) : ctrl                  role region
node LOOP(c...: ctrl) : ctrl                    role loop
node IF(c: ctrl, cond: bool) : ctrl             role if
node TRUE(branch: ctrl) : ctrl                  role true
node FALSE(branch: ctrl) : ctrl                 role false
# A switch goes to the case whose value its operand has, or to its default.
node SWITCH(c: ctrl, value) : ctrl              role switch
node CASE(switch: ctrl) : ctrl                  role case     payload value
node DEFAULT(switch: ctrl) : ctrl               role default
# Control that reaches a trap stops the program.
node TRAP(c: ctrl)                              role trap
# A call follows the C convention. Its `shape` is 0 when every argument is
# passed as its type alone says, or names a shape the graph holds, which says
# what else there is to say of each. RESULT is a value the call returned: of
# the integers or of the floating values, whichever its type is, the one
# numbered `index` from 0.
node CALL(c: ctrl, target: ptr, args...) : ctrl role call  payload shape
node RESULT(call: ctrl) : T                     role result  payload index
# A call whose result is this function's: the function ends by going there,
# with its own frame already given back. Its type is what it returns.
node TAILCALL(c: ctrl, target: ptr, args...) : T  role tailcall  payload shape

# Memory. A load and a store sit in the control chain, in the order they happen;
# a load is also the value it read. The width is the type's. One that is
# `volatile` (not 0) happens exactly once, where it stands, whatever is known
# of the memory.
node LOAD(c: ctrl, addr: ptr) : T in stored     role load   payload volatile
node STORE(c: ctrl, addr: ptr, value) : ctrl    role store  payload volatile
# `bytes` bytes from src to dst, which are apart or the same place; and `bytes`
# bytes at dst each set to `value`.
node COPY(c: ctrl, dst: ptr, src: ptr) : ctrl   role copy   payload bytes
node FILL(c: ctrl, dst: ptr, value: u8) : ctrl  role fill   payload bytes

# Memory that other threads share. ATOMIC-LOAD and ATOMIC-STORE are a load and
# a store that every thread sees in one order. An update happens whole: nothing
# else reads or writes its address between its read and its write. The update
# is the value that was there, and on the right is what it leaves there.
node ATOMIC-LOAD(c: ctrl, addr: ptr) : T in int                  role load
node ATOMIC-STORE(c: ctrl, addr: ptr, value) : ctrl              role store
node SWAP(c: ctrl, addr: ptr, v: T) : T in int                   role update  = v
node FETCH-ADD(c: ctrl, addr: ptr, v: T) : T in int              role update  = old + v
node FETCH-SUB(c: ctrl, addr: ptr, v: T) : T in int              role update  = old - v
node FETCH-AND(c: ctrl, addr: ptr, v: T) : T in int              role update  = old & v
node FETCH-NAND(c: ctrl, addr: ptr, v: T) : T in int             role update  = ~(old & v)
node FETCH-OR(c: ctrl, addr: ptr, v: T) : T in int               role update  = old | v
node FETCH-XOR(c: ctrl, addr: ptr, v: T) : T in int              role update  = old ^ v
node FETCH-SMAX(c: ctrl, addr: ptr, v: T) : T in int             role update  = smax(old, v)
node FETCH-SMIN(c: ctrl, addr: ptr, v: T) : T in int             role update  = smin(old, v)
node FETCH-UMAX(c: ctrl, addr: ptr, v: T) : T in int             role update  = umax(old, v)
node FETCH-UMIN(c: ctrl, addr: ptr, v: T) : T in int             role update  = umin(old, v)
# `new` goes there only if `expected` was there.
node CAS(c: ctrl, addr: ptr, expected: T, new: T) : T in int     role update  = select(old == expected, new, old)
# Every access to memory before this one is seen by the other threads before
# any after it.
node FENCE(c: ctrl) : ctrl                                       role barrier

# Memory of the function's own, sized as it runs: `bytes` of it at a multiple
# of 16, until the function returns.
node RESERVE(c: ctrl, bytes: u64) : ptr                          role reserve

# Addresses. SLOT is a frame object of `size` bytes, its own for each call of
# the function. SYMBOL is something in the same image, EXTERN something outside.
node SLOT : ptr                                 role object  payload size
node SYMBOL : ptr                               role symbol  payload symbol
node EXTERN : ptr                               role extern  payload symbol

# Values that come from outside the graph.
node PARAM : T                                  role param  payload index
node CONST : T                                  role const  payload value
node PHI(region: ctrl, in...: T) : T            role phi

# Arithmetic. Operands and result share a width; results wrap.
node ADD(a: T, b: T) : T in int   commutative   = a + b
node SUB(a: T, b: T) : T in int                 = a - b
node MUL(a: T, b: T) : T in int   commutative   = a * b
node AND(a: T, b: T) : T in word  commutative   = a & b
node OR(a: T, b: T)  : T in word  commutative   = a | b
node XOR(a: T, b: T) : T in word  commutative   = a ^ b
node NEG(a: T) : T in int                       = 0 - a
node NOT(a: T) : T in word                      = ~a
node SHL(a: T, n: T) : T in int                 = a << (n % bits)
node SHR(a: T, n: T) : T in int                 = a >> (n % bits)
node SAR(a: T, n: T) : T in int                 = sar(a, n % bits)

# Division. By zero, and the smallest signed value by -1, are for the program
# to avoid: some machines trap, and the results here are only what the ones
# that do not trap give.
node UDIV(a: T, b: T) : T in int                = udiv(a, b)
node SDIV(a: T, b: T) : T in int                = sdiv(a, b)
node UREM(a: T, b: T) : T in int                = urem(a, b)
node SREM(a: T, b: T) : T in int                = srem(a, b)

# Bits.
node CLZ(a: T) : T in int                       = clz(a)
node CTZ(a: T) : T in int                       = ctz(a)
node POPCNT(a: T) : T in int                    = popcount(a)
node BSWAP(a: T) : T in wide                    = bswap(a)
node BITREV(a: T) : T in wide                   = bitrev(a)
node ROL(a: T, n: T) : T in wide                = rol(a, n)
node ROR(a: T, n: T) : T in wide                = ror(a, n)

# The larger and the smaller, and the high half of a product.
node SMIN(a: T, b: T) : T in int   commutative  = smin(a, b)
node SMAX(a: T, b: T) : T in int   commutative  = smax(a, b)
node UMIN(a: T, b: T) : T in int   commutative  = umin(a, b)
node UMAX(a: T, b: T) : T in int   commutative  = umax(a, b)
node UMULH(a: T, b: T) : T in wide commutative  = umulh(a, b)
node SMULH(a: T, b: T) : T in wide commutative  = smulh(a, b)

# Whether the true result does not fit: the sum or product itself is ADD or MUL.
node SADDO(a: S, b: S) : bool, S in wide  commutative = sadd-overflows(a, b)
node UADDO(a: S, b: S) : bool, S in wide  commutative = uadd-overflows(a, b)
node SSUBO(a: S, b: S) : bool, S in wide        = ssub-overflows(a, b)
node USUBO(a: S, b: S) : bool, S in wide        = usub-overflows(a, b)
node SMULO(a: S, b: S) : bool, S in wide  commutative = smul-overflows(a, b)
node UMULO(a: S, b: S) : bool, S in wide  commutative = umul-overflows(a, b)

# Between widths. TRUNC keeps the low bits; ZEXT and SEXT fill the new ones.
node ZEXT(a: S) : T in int, S in word, bits(S) < bits(T)   = a
node SEXT(a: S) : T in int, S in int, bits(S) < bits(T)    = sext(a)
node TRUNC(a: S) : T in word, S in int, bits(T) <= bits(S) = a

# Floating point. Comparisons are false when either side is not a number,
# except FNE, which is then true. To an integer is toward zero, with the
# nearest end of the range for what does not fit and 0 for what is not a number.
node FADD(a: T, b: T) : T in float  commutative = fadd(a, b)
node FSUB(a: T, b: T) : T in float              = fsub(a, b)
node FMUL(a: T, b: T) : T in float  commutative = fmul(a, b)
node FDIV(a: T, b: T) : T in float              = fdiv(a, b)
node FNEG(a: T) : T in float                    = fneg(a)
node FABS(a: T) : T in float                    = fabs(a)
node FSQRT(a: T) : T in float                   = fsqrt(a)
# The smaller and the larger; zero with its sign set is below zero without.
# With a value that is not a number, so are FMIN and FMAX; FMIN-NUMBER and
# FMAX-NUMBER are then the other value, if that is a number.
node FMIN(a: T, b: T) : T in float              = fmin(a, b)
node FMAX(a: T, b: T) : T in float              = fmax(a, b)
node FMIN-NUMBER(a: T, b: T) : T in float       = fmin-number(a, b)
node FMAX-NUMBER(a: T, b: T) : T in float       = fmax-number(a, b)
# To a whole number: the nearest, a half going to the even one or away from
# zero; the next one up; the next one down; and the next one toward zero.
node ROUND-EVEN(a: T) : T in float              = fround(a, 0)
node ROUND-UP(a: T) : T in float                = fround(a, 1)
node ROUND-DOWN(a: T) : T in float              = fround(a, 2)
node ROUND-ZERO(a: T) : T in float              = fround(a, 3)
node ROUND-AWAY(a: T) : T in float              = fround(a, 4)
# a * b + c, rounded once.
node FMA(a: T, b: T, c: T) : T in float         = fma(a, b, c)
node FEQ(a: S, b: S) : bool, S in float  commutative = feq(a, b)
node FNE(a: S, b: S) : bool, S in float  commutative = fne(a, b)
node FLT(a: S, b: S) : bool, S in float         = flt(a, b)
node FLE(a: S, b: S) : bool, S in float         = fle(a, b)
node SITOF(a: S) : T in float, S in int         = sitof(a)
node UITOF(a: S) : T in float, S in int         = uitof(a)
node FTOSI(a: S) : T in signed-wide, S in float = ftosi(a)
node FTOUI(a: S) : T in unsigned-wide, S in float = ftoui(a)
node FEXT(a: S) : T in float, S in float, bits(S) < bits(T)   = fext(a)
node FTRUNC(a: S) : T in float, S in float, bits(T) < bits(S) = ftrunc(a)

# The same bits as another type of the same width.
node BITCAST(a: S) : T in value, S in value, bits(S) <= bits(T), bits(T) <= bits(S) = a

# One of two values.
node COND(c: bool, a: T, b: T) : T in value     = select(c, a, b)

# Comparisons.
node EQ(a: S, b: S)  : bool, S in int  commutative = a == b
node NE(a: S, b: S)  : bool, S in int  commutative = a != b
node LT(a: S, b: S)  : bool, S in int           = slt(a, b)
node LE(a: S, b: S)  : bool, S in int           = sle(a, b)
node ULT(a: S, b: S) : bool, S in int           = ult(a, b)
node ULE(a: S, b: S) : bool, S in int           = ule(a, b)
