# What memory is known to hold. Down a block, and on into a block that only
# it leads to, an address that was read or written is known to hold what was
# read or written there, until something that might write memory comes by. A
# load of an address whose value is known is that value, and the load goes.
pass in unit
use cfg as cfg

column known-at: Block -> [Node]      # at a block's end: the addresses whose value is known,
column known-as: Block -> [Node]      # and for each the value
state at: [Node]                      # the same for the block being walked
state as: [Node]
state open: [Node]                    # the stores of the block being walked that nothing has read since
tally forwarded: Int
tally overwritten: Int

# Something that may write memory this pass knows nothing of.
fn clobbers?(n: Node) -> Bool =
  (n is CALL and not (n.in(1) is SYMBOL and reads-only(n.in(1).payload))) or n is COPY or n is FILL or n is ATOMIC-STORE or n is RESERVE or cfg.update?(n)

# What an address is an offset from, and the offset.
fn base(a: Node) -> Node =
  if a is ADD and a.in(1) is CONST then a.in(0) else if a is ADD and a.in(0) is CONST then a.in(1) else a

fn offset(a: Node) -> Int =
  if a is ADD and a.in(1) is CONST then int(a.in(1).payload) else if a is ADD and a.in(0) is CONST then int(a.in(0).payload) else 0

# Whether `bytes` bytes at address `a` and what is known at address `b` are
# surely different memory: offsets from one base that do not overlap, or two
# different frame objects.
fn apart?(a: Node, bytes: Int, b: Node, value: Node) -> Bool {
  let x = base(a)
  let y = base(b)
  if x == y { return offset(a) + bytes <= offset(b) or offset(b) + type-bytes(value.type) <= offset(a) }
  x is SLOT and y is SLOT
}

# A store of `bytes` bytes at `address`: what is known of memory it may have
# written is known no longer.
fn written(address: Node, bytes: Int) {
  var kept = 0
  for i in 0..at.len {
    if apart?(address, bytes, at[i], as[i]) {
      at[kept] = at[i]
      as[kept] = as[i]
      kept = kept + 1
    }
  }
  while at.len > kept {
    at.pop()
    as.pop()
  }
}

# `l`, a load, is value `v`: what followed it in control follows what it
# followed, and what read it reads `v`.
fn replace(l: Node, v: Node) {
  var users: [Node] = []
  var slots: [Int] = []
  for e in edges(l) {
    users.push(edge-user(e))
    slots.push(edge-slot(e))
  }
  for i in 0..users.len {
    let u = users[i]
    let k = slots[i]
    if u is REGION or u is LOOP or (k == 0 and cfg.control?(u)) { set-input(u, k, l.in(0)) } else { set-input(u, k, v) }
  }
  drop(l)
  forwarded = forwarded + 1
}

# Store `s` is written over before anything reads it: it is not made.
fn unwrite(s: Node) {
  var users: [Node] = []
  var slots: [Int] = []
  for e in edges(s) {
    users.push(edge-user(e))
    slots.push(edge-slot(e))
  }
  for i in 0..users.len { set-input(users[i], slots[i], s.in(0)) }
  drop(s)
  overwritten = overwritten + 1
}

# Load `l` stays: the stores it may read are read.
fn reads(l: Node) {
  var kept = 0
  for i in 0..open.len {
    if apart?(open[i].in(1), type-bytes(open[i].in(2).type), l.in(1), l) {
      open[kept] = open[i]
      kept = kept + 1
    }
  }
  while open.len > kept { open.pop() }
}

fn walk(b: Block) {
  at.clear()
  as.clear()
  open.clear()
  if b.preds.len == 1 and b.preds[0] != b {
    let p = b.preds[0]
    for i in 0..p.known-at.len {
      at.push(p.known-at[i])
      as.push(p.known-as[i])
    }
  }
  var c = cfg.follower(b.head)
  while c != none and cfg.chain?(c) {
    let next = cfg.follower(c)
    if c is LOAD and c.payload == 0 {
      var found: Node = none
      for i in 0..at.len { if at[i] == c.in(1) and as[i].type == c.type { found = as[i] } }
      if found != none { replace(c, found) }
      else {
        reads(c)
        if at.len < 24 {
          at.push(c.in(1))
          as.push(c)
        }
      }
    } else if c is STORE {
      # A store nothing has read, to the same place and as wide, is written over.
      if c.payload == 0 and cfg.on?(6) and not debugging {
        var kept = 0
        for i in 0..open.len {
          let s = open[i]
          if s.in(1) == c.in(1) and type-bytes(s.in(2).type) == type-bytes(c.in(2).type) { unwrite(s) } else {
            open[kept] = s
            kept = kept + 1
          }
        }
        while open.len > kept { open.pop() }
        if open.len < 24 { open.push(c) }
      } else { open.clear() }
      # What the store may have written is known no longer; what it wrote is known.
      written(c.in(1), type-bytes(c.in(2).type))
      if c.payload == 0 and at.len < 24 {
        at.push(c.in(1))
        as.push(c.in(2))
      }
    } else {
      # Anything else may read whatever was stored.
      open.clear()
      if clobbers?(c) or c is LOAD {
        at.clear()
        as.clear()
      }
    }
    c = next
  }
  for i in 0..at.len {
    b.known-at.push(at[i])
    b.known-as.push(as[i])
  }
}

fn run() {
  if not cfg.on?(10) { return }
  for b in order { walk(b) }
}

# Whether nothing reads what load `l` reads: all that uses it is what follows it.
fn unread?(l: Node) -> Bool =
  all e in edges(l): edge-user(e) is REGION or edge-user(e) is LOOP or (edge-slot(e) == 0 and cfg.control?(edge-user(e)))

# A load nothing reads is not made. (A whole record is read to get at one
# field of it.) Returns how many went, since one going may leave another unread.
fn prune() -> Int {
  if not cfg.on?(6) { return 0 }
  var gone = 0
  for n in Node {
    if not n.dead and n is LOAD and n.payload == 0 and unread?(n) {
      replace(n, none)
      gone = gone + 1
    }
  }
  gone
}
