# Copies and fills of many bytes at once. A few bytes are loads and stores of
# the widest pieces that fit, the last one reaching back over bytes already
# done when the count is not a multiple of its width. More than that is a call
# of the routine the unit was told of.
pass in unit
use cfg as cfg

setting copy-routine: Int              # one more than the symbols of routines outside the image that
setting fill-routine: Int              # copy and fill any number of bytes; 0 if there is none
setting near-routines: Bool            # they are called as the image's own functions are, not
                                       # through the table of addresses
tally known-calls: Int                 # calls of the C library's routines done here instead
state inline-bytes: Int               # the most bytes done by loads and stores

fn at(p: Node, offset: Int) -> Node =
  if offset == 0 then p else ir.add!(mut graph, ir.T-PTR, p, ir.make-const!(mut graph, ir.T-PTR, word(offset)))

# The type of a piece `bytes` wide.
fn piece(bytes: Int) -> Int =
  if bytes == 8 then int(ir.T-PTR) else if bytes == 4 then int(ir.T-U32) else if bytes == 2 then int(ir.T-U16) else int(ir.T-U8)

# One piece `width` wide at `offset`: copied, or written from `value`, a whole
# word of what a fill writes. Returns the control after its store.
fn one(c: Node, dst: Node, src: Node, value: Node, offset: Int, width: Int) -> Node {
  let t = id(piece(width))
  if value != none {
    return ir.store-node!(mut graph, word(0), c, at(dst, offset), if width < 8 then ir.trunc!(mut graph, t, value) else value)
  }
  let v = ir.load-node!(mut graph, t, word(0), c, at(src, offset))
  ir.store-node!(mut graph, word(0), v, at(dst, offset), v)
}

# `total` bytes in pieces of the widest width that fits, one after another,
# and a last one that ends where the bytes do.
fn pieces(c: Node, dst: Node, src: Node, value: Node, total: Int) -> Node {
  var width = 8
  while width > total { width = width / 2 }
  var control = c
  var done = 0
  # Words are copied two at a time, both read before either is written: where
  # the machine reads and writes two words at once, that is half the instructions.
  while value == none and width == 8 and done + 16 <= total {
    let a = ir.load-node!(mut graph, ir.T-PTR, word(0), control, at(src, done))
    let b = ir.load-node!(mut graph, ir.T-PTR, word(0), a, at(src, done + 8))
    control = ir.store-node!(mut graph, word(0), ir.store-node!(mut graph, word(0), b, at(dst, done), a), at(dst, done + 8), b)
    done = done + 16
  }
  while done + width <= total {
    control = one(control, dst, src, value, done, width)
    done = done + width
  }
  if done < total { control = one(control, dst, src, value, total - width, width) }
  control
}

fn call(c: Node, routine: Int, a: Node, b: Node, bytes: Int) -> Node {
  if routine == 0 { panic("a copy or fill of this many bytes needs a routine, and the unit was told of none") }
  let target = if near-routines then ir.symbol!(mut graph, word(routine - 1)) else ir.extern!(mut graph, word(routine - 1))
  let n = ir.call-node!(mut graph, word(0), c, target, 3)
  set-input(n, 2, a)
  set-input(n, 3, b)
  set-input(n, 4, ir.make-const!(mut graph, ir.T-U64, word(bytes)))
  n
}

fn expand(n: Node) {
  let bytes = int(n.payload)
  var control = n.in(0)
  if n is COPY {
    if bytes > inline-bytes { control = call(control, copy-routine, n.in(1), n.in(2), bytes) }
    else if n.in(1) != n.in(2) { control = pieces(control, n.in(1), n.in(2), none, bytes) }
  } else {
    let wide = ir.zext!(mut graph, ir.T-U64, n.in(2))
    if bytes > inline-bytes { control = call(control, fill-routine, n.in(1), wide, bytes) }
    else {
      let every = ir.mul!(mut graph, ir.T-U64, wide, ir.make-const!(mut graph, ir.T-U64, word(72340172838076673)))
      control = pieces(control, n.in(1), none, every, bytes)
    }
  }
  grow-nodes()
  replace-uses(n, control)
  drop(n)
}

# `total` bytes from `src` to `dst`, which may overlap: every piece is read
# before any is written.
fn moved(c: Node, dst: Node, src: Node, total: Int) -> Node {
  var width = 8
  while width > total { width = width / 2 }
  var offsets: [Int] = []
  var done = 0
  while done + width <= total {
    offsets.push(done)
    done = done + width
  }
  if done < total { offsets.push(total - width) }
  var control = c
  var values: [Node] = []
  for o in offsets {
    control = ir.load-node!(mut graph, id(piece(width)), word(0), control, at(src, o))
    values.push(control)
  }
  for i in 0..offsets.len { control = ir.store-node!(mut graph, word(0), control, at(dst, offsets[i]), values[i]) }
  control
}

# What the routine a call calls is known to be, if it is called plainly; else 0.
fn routine(n: Node) -> Int =
  if n is CALL and n.payload == 0 and n.arity == 5 and (n.in(1) is SYMBOL or n.in(1) is EXTERN) then routine-kind(n.in(1).payload) else 0

# A call of the C library's memcpy, memmove or memset for a known few bytes is
# those loads and stores; what the call answers is where it wrote.
fn known-call(n: Node) {
  if not cfg.on?(7) { return }
  let kind = routine(n)
  if kind != 2 and kind != 3 and kind != 4 { return }
  if not (n.in(4) is CONST) or n.in(4).payload > word(if kind == 3 then 64 else inline-bytes) { return }
  if kind == 4 and type-bytes(n.in(3).type) != 8 { return }
  let bytes = int(n.in(4).payload)
  var control = n.in(0)
  if bytes > 0 and n.in(2) != n.in(3) {
    if kind == 2 { control = pieces(control, n.in(2), n.in(3), none, bytes) }
    else if kind == 3 { control = moved(control, n.in(2), n.in(3), bytes) }
    else {
      let byte = ir.and!(mut graph, ir.T-U64, ir.bitcast!(mut graph, ir.T-U64, n.in(3)), ir.make-const!(mut graph, ir.T-U64, word(255)))
      control = pieces(control, n.in(2), none, ir.mul!(mut graph, ir.T-U64, byte, ir.make-const!(mut graph, ir.T-U64, word(72340172838076673))), bytes)
    }
  }
  grow-nodes()
  var results: [Node] = []
  for u in users(n) { if u is RESULT { results.push(u) } }
  for r in results {
    replace-uses(r, n.in(2))
    drop(r)
  }
  replace-uses(n, control)
  drop(n)
  known-calls = known-calls + 1
}

# Whether all that is asked of `v` is whether it is zero.
fn zero-tested?(v: Node, deep: Int) -> Bool {
  for e in edges(v) {
    let u = edge-user(e)
    if u is EQ or u is NE {
      let other = if u.in(0) == v then u.in(1) else u.in(0)
      if not (other is CONST and other.payload == word(0)) { return false }
    } else if (u is TRUNC or u is ZEXT or u is SEXT) and u.bits >= 8 and deep < 3 {
      if not zero-tested?(u, deep + 1) { return false }
    } else { return false }
  }
  true
}

# A call of the C library's memcmp for a known few bytes, of which all that is
# asked is whether they were the same, is those bytes read and compared: the
# answer is 0 if they were and 1 if not.
fn compare(n: Node) {
  if not cfg.on?(7) or routine(n) != 5 or not (n.in(4) is CONST) or n.in(4).payload > word(16) { return }
  var result: Node = none
  for u in users(n) {
    if u is RESULT {
      if result != none { return }
      result = u
    }
  }
  if result != none and (int(result.payload) != 0 or result.float or not zero-tested?(result, 0)) { return }
  let bytes = int(n.in(4).payload)
  var control = n.in(0)
  var differ = ir.make-const!(mut graph, ir.T-PTR, word(0))
  if bytes > 0 {
    var width = 8
    while width > bytes { width = width / 2 }
    var offsets: [Int] = []
    var done = 0
    while done + width <= bytes {
      offsets.push(done)
      done = done + width
    }
    if done < bytes { offsets.push(bytes - width) }
    for o in offsets {
      let a = ir.load-node!(mut graph, id(piece(width)), word(0), control, at(n.in(2), o))
      let b = ir.load-node!(mut graph, id(piece(width)), word(0), a, at(n.in(3), o))
      control = b
      let x = ir.xor!(mut graph, a.type, a, b)
      differ = ir.or!(mut graph, ir.T-PTR, differ, if width == 8 then x else ir.zext!(mut graph, ir.T-PTR, x))
    }
  }
  grow-nodes()
  if result != none {
    replace-uses(result, ir.zext!(mut graph, result.type, ir.ne!(mut graph, differ, ir.make-const!(mut graph, ir.T-PTR, word(0)))))
    drop(result)
  }
  grow-nodes()
  replace-uses(n, control)
  drop(n)
  known-calls = known-calls + 1
}

# The calls of known routines whose sizes have become known since `run`.
fn again() -> Int {
  if inline-bytes == 0 { inline-bytes = 128 }
  let was = known-calls
  for n in Node {
    if not n.dead and n is CALL {
      # What is done in place of the call comes from where the call came from.
      from(n)
      if routine(n) == 5 { compare(n) } else { known-call(n) }
      from(none)
    }
  }
  known-calls - was
}

fn run() {
  if inline-bytes == 0 { inline-bytes = 128 }
  for n in Node {
    if not n.dead and (n is COPY or n is FILL) {
      from(n)
      expand(n)
      from(none)
    }
  }
  for n in Node {
    if not n.dead and n is CALL {
      # What is done in place of the call comes from where the call came from.
      from(n)
      if routine(n) == 5 { compare(n) } else { known-call(n) }
      from(none)
    }
  }
}
