# A second, strictly declarative client of bounded stable storage and locks.
library declarative
use "coil.sync" as sync;
record Cell { value: u64; }
record Cells {
  chunks: list[list[Cell]] capacity 512 drop-each free!;
  count: i64;
  active: bool;
  lock: sync::Mutex;
}
construct Cells.new();
release Cells as cells-storage-free!(state);
mutex cells(state: ref[Cells]) {
  active = state.active; address = address(state, lock);
  initialize = start-cells!; destroy = stop-cells!;
  acquire = acquire-cells!; release = release-cells!;
}
stable-index cell-push!(state: ref[Cells], cell: Cell) {
  chunks = chunks; count = count; shift = typed[i64](1);
  lookup = cell-at; length = cell-count;
  acquire = acquire-cells!(state); release = release-cells!(state);
}
scatter reset-cells-count!(state: ref[Cells]) inline { field state.count = 0; }
pipeline cells-free!(state: ref[Cells]) {
  run cells-storage-free!(state); run reset-cells-count!(state); run stop-cells!(state);
}
