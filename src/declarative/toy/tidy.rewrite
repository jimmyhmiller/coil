# What an expression may be replaced by.
rewrite in unit
nodes toy.calc

rule plus-nothing   : PLUS(x, LIT 0)             => x
rule minus-nothing  : MINUS(x, LIT 0)            => x
rule minus-itself   : MINUS(x, x)                => 0
rule times-one      : TIMES(x, LIT 1)            => x
rule times-nothing  : TIMES(x, LIT 0)            => 0
rule times-two      : TIMES(x, LIT 2)            => PLUS(x, x)
rule negate-twice   : NEGATE(NEGATE(x))          => x
rule plus-negated   : PLUS(x, NEGATE(y))         => MINUS(x, y)
rule both-itself    : BOTH(x, x)                 => x
rule same-itself    : SAME(x, x)                 => 1
rule below-itself   : BELOW(x, x)                => 0
rule pick-either    : PICK(w, x, x)              => x
rule pick-yes       : PICK(LIT 1, x, y)          => x
rule pick-no        : PICK(LIT 0, x, y)          => y
