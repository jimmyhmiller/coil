# How deep an expression is: a pass written over the calculator's nodes.
pass in unit

column depth: Node -> Int

fn depth-of(n: Node) -> Int {
  if n.depth != 0 { return n.depth }
  var most = 0
  for i in inputs(n) {
    if i != none and i.pure { most = max(most, depth-of(i)) }
  }
  n.depth = most + 1
  most + 1
}

fn deepest() -> Int = greatest n in Node: if n.dead then 0 else depth-of(n)

fn live() -> Int = count n in Node: not n.dead
