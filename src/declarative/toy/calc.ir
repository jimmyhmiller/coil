# A second node set: a calculator. It shares nothing with the backend's nodes
# but the languages it is written in, which is why it is here: whatever in
# compiler/ would only work for the backend's nodes fails to build this.
type flow : 0 control
type num  : 32 signed
type flag : 1 unsigned

set numbers  = num
set anything = num flag

node BEGIN : flow                               role start
node GIVE(after: flow, answer)                  role return
node LIT : T                                    role const  payload value
node INPUT : T                                  role param  payload index

node PLUS(a: T, b: T)  : T in numbers   commutative = a + b
node MINUS(a: T, b: T) : T in numbers               = a - b
node TIMES(a: T, b: T) : T in numbers   commutative = a * b
node BOTH(a: T, b: T)  : T in anything  commutative = a & b
node NEGATE(a: T)      : T in numbers               = 0 - a
node SAME(a: S, b: S)  : flag, S in numbers  commutative = a == b
node BELOW(a: S, b: S) : flag, S in numbers         = slt(a, b)
node PICK(which: flag, a: T, b: T) : T in anything  = select(which, a, b)
