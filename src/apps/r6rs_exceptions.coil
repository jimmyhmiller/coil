(module coil.r6rs.exceptions)

;; R6RS exception handling expressed in Scheme itself.  This module is an
;; optional whole-build setup layered on the native continuation setup; it is
;; intentionally not part of the default R5RS surface.
(import "coil.scheme" :use *)
(import "coil.scheme.continuations" :use * :reexport)
(reader-provider "coil.scheme.reader" scheme-read)

;; The head is the currently active handler.  Each installation is protected by
;; dynamic-wind, so entering or leaving a captured continuation restores exactly
;; the handler chain belonging to that dynamic extent.
(define *exception-handlers* '())

(define (with-exception-handler handler thunk)
  (let ((outside *exception-handlers*)
        (inside (cons handler *exception-handlers*)))
    (dynamic-wind
      (lambda () (set! *exception-handlers* inside))
      thunk
      (lambda () (set! *exception-handlers* outside)))))

;; A handler runs with itself removed.  Consequently, an exception raised by the
;; handler is offered to the next enclosing handler rather than recursing into
;; the handler that is already processing an exception.
(define (raise-continuable object)
  (if (null? *exception-handlers*)
      (begin
        (display "uncaught Scheme exception: ")
        (write object)
        (newline)
        (exit 1))
      (let ((active *exception-handlers*)
            (outside (cdr *exception-handlers*)))
        (dynamic-wind
          (lambda () (set! *exception-handlers* outside))
          (lambda () ((car active) object))
          (lambda () (set! *exception-handlers* active))))))

;; R6RS `raise` is non-continuable.  A conforming handler normally escapes (as
;; `guard` does).  If it returns, offer the object to the next outer handler;
;; this preserves the essential non-continuation property without pretending
;; the original raise returned normally.
(define (raise object)
  (if (null? *exception-handlers*)
      (raise-continuable object)
      (let ((active *exception-handlers*)
            (outside (cdr *exception-handlers*)))
        (dynamic-wind
          (lambda () (set! *exception-handlers* outside))
          (lambda ()
            ((car active) object)
            (raise object))
          (lambda () (set! *exception-handlers* active))))))

(export with-exception-handler raise raise-continuable)
