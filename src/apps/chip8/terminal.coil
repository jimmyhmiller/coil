; ============================================================================
; terminal.coil — TERMINAL front-end for the CHIP-8 core (chip8.coil, alongside).
;
;   cd src/apps/chip8 && coil run terminal.coil -- /path/to/game.ch8
;   keypad 1234/qwer/asdf/zxcv, ESC quits
;
; The 64x32 framebuffer is drawn with Unicode half-blocks (one cell = two vertical
; pixels). Input is raw, non-blocking stdin. Pure libc FFI — the VM itself lives in
; chip8.coil; this file is just rendering + input + the run loop. Control flow
; (for/while/cond/…) is in coil.core — no import needed.
; ============================================================================

(module app)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "chip8" :use *)  ; the VM core (vendored in this app)

(extern read :cc c [i32 (ptr i8) isize] (-> isize))
(extern write :cc c [i32 (ptr i8) isize] (-> isize))
(extern usleep :cc c [:i64] (-> :i32))
(extern exit :cc c [:i64] (-> :i32))
(extern puts :cc c [(ptr i8)] (-> :i32))
(extern putchar :cc c [:i64] (-> :i32))
(extern tcgetattr :cc c [:i64 (ptr i8)] (-> :i32))
(extern tcsetattr :cc c [:i64 :i64 (ptr i8)] (-> :i32))
(extern cfmakeraw :cc c [(ptr i8)] (-> :i32))
(extern memcpy :cc c [(ptr i8) (ptr i8) :i64] (-> (ptr i8)))
(extern fcntl :cc c [:i64 :i64 :i64] (-> :i32))

; ---- terminal rendering (half-block glyphs) --------------------------------
(defn emit [(buf (ptr u8)) (idx (ptr i64)) (b i64)] (-> i64)
  (let [i (load idx)]
    (do
      (store! (primitive/index buf i) (primitive/cast :u8 b))
      (store! idx
              (primitive/iadd i 1))
      0)))
(defn glyph [(buf (ptr u8)) (idx (ptr i64)) (top i64) (bot i64)] (-> i64)
  (if (= top (cast i64 1))
      (if (= bot (cast i64 1))
          (do (emit buf idx 0xE2) (emit buf idx 0x96) (emit buf idx 0x88) 0)  ; full
          (do (emit buf idx 0xE2) (emit buf idx 0x96) (emit buf idx 0x80) 0))  ; upper
      (if (= bot (cast i64 1))
          (do (emit buf idx 0xE2) (emit buf idx 0x96) (emit buf idx 0x84) 0)  ; lower
          (do (emit buf idx 0x20) 0))))  ; blank

(defn render [(c (ptr Chip8))] (-> i64)
  (let [buf (alloc/stack (array u8 8192))
        idx (alloc/stack i64)
        bp (primitive/index buf 0)]
    (do
      (store! idx 0)
      (emit bp idx 0x1B)
      (emit bp idx 0x5B)
      (emit bp idx 0x48)  ; ESC [ H — home
      (for [r 0 16]
        (do
          (for [col 0 64]
            (glyph bp
                   idx
                   (px c (primitive/iadd (primitive/imul (primitive/imul r 2) 64) col))
                   (px c (primitive/iadd (primitive/imul (primitive/iadd (primitive/imul r 2) 1) 64) col))))
          (emit bp idx 0x0A)))
      (write 1 bp (load idx))
      0)))

; ---- input  (keyboard -> keypad: 1234 / qwer / asdf / zxcv) -----------------
(defn map-key [(ch i64)] (-> i64)
  (cond (= ch (cast i64 49)) 1
        (= ch (cast i64 50)) 2
        (= ch (cast i64 51)) 3
        (= ch (cast i64 52)) 12
        (= ch (cast i64 113)) 4
        (= ch (cast i64 119)) 5
        (= ch (cast i64 101)) 6
        (= ch (cast i64 114)) 13
        (= ch (cast i64 97)) 7
        (= ch (cast i64 115)) 8
        (= ch (cast i64 100)) 9
        (= ch (cast i64 102)) 14
        (= ch (cast i64 122)) 10
        (= ch (cast i64 120)) 0
        (= ch (cast i64 99)) 11
        (= ch (cast i64 118)) 15
        -1))

(defn poll-input [(c (ptr Chip8)) (saved (ptr u8))] (-> i64)
  (let [buf (alloc/stack (array u8 32))
        n (read 0 (primitive/index buf 0) 32)]
    (do
      (decay-keys c)
      (if (> n (cast i64 0))
          (for [bi 0 n]
            (let [ch (primitive/cast :i64 (load (primitive/index buf bi)))]
              (if (= ch (cast i64 27))
                  (do (tcsetattr 0 0 saved) (exit 0) 0)  ; ESC quits
                  (let [k (map-key ch)] (if (>= k (cast i64 0)) (set-key c k 8) 0)))))
          0)
      0)))

; ---- terminal raw mode -----------------------------------------------------
(defn term-raw [(saved (ptr u8))] (-> i64)
  (let [raw (alloc/stack (array u8 128))]
    (do
      (tcgetattr 0 saved)
      (memcpy (primitive/index raw 0) saved 128)
      (cfmakeraw (primitive/index raw 0))
      (tcsetattr 0 0 (primitive/index raw 0))
      (fcntl 0 4 4)
      0)))  ; TCSANOW; F_SETFL O_NONBLOCK

; headless self-test: run N steps and print the framebuffer as #/.
(defn dump [(c (ptr Chip8))] (-> i64)
  (do
    (for [s 0 200] (step c))
    (for [r 0 32]
      (do
        (for [col 0 64] (putchar (if (= (px c (primitive/iadd (primitive/imul r 64) col)) (cast i64 1)) 35 46)))
        (putchar 10)))
    0))

(defn run [(c (ptr Chip8)) (saved (ptr u8))] (-> i64)
  (while 1
    (do
      (poll-input c saved)
      (for [k 0 12] (step c))
      (tick c)
      (if (= (draw? c) (cast i64 1)) (do (render c) (clear-draw c) 0) 0)
      (usleep 16000))))

(defn main [(argc :i32) (argv (ptr (ptr i8)))] (-> :i64)
  (let [c (alloc/stack Chip8)
        saved (alloc/stack (array u8 128))]
    (do
      (init c)
      (if (< (primitive/cast :i64 argc) (cast i64 2))
          (do (puts c"usage: chip8 <rom> [--dump]") 1)
          (if (< (load-rom c (load (primitive/index argv 1))) (cast i64 0))
              (do (puts c"chip8: cannot open ROM") 1)
              (do
                (if (>= (primitive/cast :i64 argc) (cast i64 3))
                    (dump c)  ; headless
                    (do (term-raw (primitive/index saved 0)) (run c (primitive/index saved 0))))
                0))))))
