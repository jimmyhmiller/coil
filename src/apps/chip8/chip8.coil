; ============================================================================
; chip8.coil — the CHIP-8 virtual machine core, front-end agnostic. Both the
; terminal (src/examples/chip8.coil) and the macOS-window (src/apps/chip8) front-ends
; import this module and supply their own rendering + input. No I/O here except
; reading a ROM file.
;
;   (import "src/stdlib/chip8.coil" :as c8)
;   (let [vm (alloc/stack c8/Chip8)]
;     (c8/init vm) (c8/load-rom vm path)
;     (c8/step vm) (c8/tick vm)
;     (c8/px vm i)            ; pixel i (0/1) of the 64x32 display
;     (c8/set-key vm k 8) (c8/decay-keys vm))
; ============================================================================

(module chip8)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(export Chip8 init load-rom step tick px draw? clear-draw set-key key-down decay-keys)

(import "coil.control" :use *)   ; cond / for / while

(extern open       :cc c [(ptr i8) :i64] (-> :i32))
(extern read       :cc c [i32 (ptr i8) isize] (-> isize))
(extern close      :cc c [:i64] (-> :i32))
(extern memset     :cc c [(ptr i8) :i64 :i64] (-> (ptr i8)))
(extern arc4random :cc c [] (-> :u32))

(defstruct Chip8
  [(mem   (array u8 4096))
   (v     (array u8 16))
   (stack (array u16 16))
   (disp  (array u8 2048))     ; 64x32, one byte per pixel
   (keys  (array i32 16))      ; per-key "frames still held"
   (ireg  i64) (pc i64) (sp i64) (dt i64) (st i64) (drawf i64)])

; ---- internal accessors ----------------------------------------------------
(defn vget [(c (ptr Chip8)) (i i64)] (-> i64) (primitive/cast :i64 (load (primitive/index (field c v) i))))
(defn vset [(c (ptr Chip8)) (i i64) (x i64)] (-> i64)
  (do (store! (primitive/index (field c v) i) (primitive/cast :u8 (primitive/iand x 0xFF))) 0))
(defn mget [(c (ptr Chip8)) (a i64)] (-> i64) (primitive/cast :i64 (load (primitive/index (field c mem) a))))
(defn mset [(c (ptr Chip8)) (a i64) (x i64)] (-> i64)
  (do (store! (primitive/index (field c mem) a) (primitive/cast :u8 (primitive/iand x 0xFF))) 0))
(defn ireg-get [(c (ptr Chip8))] (-> i64) (load (field c ireg)))
(defn ireg-set [(c (ptr Chip8)) (x i64)] (-> i64) (do (store! (field c ireg) (primitive/iand x 0xFFFF)) 0))
(defn key-raw [(c (ptr Chip8)) (k i64)] (-> i64) (primitive/cast :i64 (load (primitive/index (field c keys) k))))
(defn pc-get [(c (ptr Chip8))] (-> i64) (load (field c pc)))
(defn pc-set [(c (ptr Chip8)) (a i64)] (-> i64) (do (store! (field c pc) (primitive/iand a 0xFFF)) 0))
(defn pc-skip [(c (ptr Chip8))] (-> i64) (pc-set c (primitive/iadd (pc-get c) 2)))

(defn stack-push [(c (ptr Chip8)) (a i64)] (-> i64)
  (let [sp (load (field c sp))]
    (do (store! (primitive/index (field c stack) sp) (primitive/cast :u16 (pc-get c)))
        (store! (field c sp) (primitive/iadd sp 1)) (pc-set c a))))
(defn stack-pop [(c (ptr Chip8))] (-> i64)
  (let [sp (primitive/isub (load (field c sp)) 1)]
    (do (store! (field c sp) sp) (pc-set c (primitive/cast :i64 (load (primitive/index (field c
                                                                                                                  stack) sp)))))))

(defn clear-disp [(c (ptr Chip8))] (-> i64)
  (do (for [i 0 2048] (store! (primitive/index (field c disp) i) (primitive/cast :u8 0)))
      (store! (field c drawf) 1) 0))

(defn draw-sprite [(c (ptr Chip8)) (vx i64) (vy i64) (n i64)] (-> i64)
  (let [x (primitive/iand (vget c vx) 0x3F) y (primitive/iand (vget c vy) 0x1F)]
    (do (vset c 15 0)
        (for [row 0 n]
          (let [bits (mget c (primitive/iadd (ireg-get c) row))]
            (for [col 0 8]
              (if (!= (primitive/iand bits (primitive/ishr 0x80 col)) (cast i64 0))
                  (let [px (primitive/irem (primitive/iadd x col) 64) py (primitive/irem (primitive/iadd y row) 32)
                        idx (primitive/iadd (primitive/imul py 64) px)
                        cur (primitive/cast :i64 (load (primitive/index (field c disp) idx)))]
                    (do (if (= cur (cast i64 1)) (vset c 15 1) 0)
                        (store! (primitive/index (field c disp) idx) (primitive/cast :u8 (primitive/ixor cur 1))) 0))
                  0))))
        (store! (field c drawf) 1) 0)))

(defn op0 [(c (ptr Chip8)) (op i64)] (-> i64)
  (cond (= op (cast i64 0xE0)) (clear-disp c) (= op (cast i64 0xEE)) (stack-pop c) 0))

(defn op8 [(c (ptr Chip8)) (x i64) (y i64) (n i64)] (-> i64)
  (let [vx (vget c x) vy (vget c y)]
    (cond
      (= n (cast i64 0))  (vset c x vy)
      (= n (cast i64 1))  (vset c x (primitive/ior vx vy))
      (= n (cast i64 2))  (vset c x (primitive/iand vx vy))
      (= n (cast i64 3))  (vset c x (primitive/ixor vx vy))
      (= n (cast i64 4))  (let [s (primitive/iadd vx vy)] (do (vset c x s)        (vset c 15 (if (> s
                                                                                                         (cast i64 255)) 1 0))))
      (= n (cast i64 5))  (do (vset c x (primitive/isub vx vy)) (vset c 15 (if (>= vx vy) 1 0)))
      (= n (cast i64 6))  (do (vset c x (primitive/ishr vx 1))  (vset c 15 (primitive/iand vx 1)))
      (= n (cast i64 7))  (do (vset c x (primitive/isub vy vx)) (vset c 15 (if (>= vy vx) 1 0)))
      (= n (cast i64 14)) (do (vset c x (primitive/ishl vx 1))  (vset c 15 (primitive/iand (primitive/ishr vx 7) 1)))
      0)))

(defn opE [(c (ptr Chip8)) (x i64) (nn i64)] (-> i64)
  (cond (= nn (cast i64 0x9E)) (if (> (key-raw c (vget c x)) (cast i64 0)) (pc-skip c) 0)
        (= nn (cast i64 0xA1)) (if (= (key-raw c (vget c x)) (cast i64 0)) (pc-skip c) 0)
        0))

(defn find-key [(c (ptr Chip8))] (-> i64)
  (let [r (alloc/stack i64)]
    (do (store! r -1)
        (for [k 0 16] (if (> (key-raw c k) (cast i64 0)) (if (< (load r) (cast i64 0)) (store! r k) 0) 0))
        (load r))))
(defn wait-key [(c (ptr Chip8)) (x i64)] (-> i64)
  (let [k (find-key c)] (if (>= k (cast i64 0)) (vset c x k) (pc-set c (primitive/isub (pc-get c) 2)))))

(defn bcd [(c (ptr Chip8)) (x i64)] (-> i64)
  (let [v (vget c x) i (ireg-get c)]
    (do (mset c i (primitive/idiv v 100)) (mset c (primitive/iadd i 1) (primitive/irem (primitive/idiv v 10) 10)) (mset c (primitive/iadd i 2) (primitive/irem v 10)) 0)))
(defn store-regs [(c (ptr Chip8)) (x i64)] (-> i64)
  (do (for [k 0 (primitive/iadd x 1)] (mset c (primitive/iadd (ireg-get c) k) (vget c k))) 0))
(defn load-regs [(c (ptr Chip8)) (x i64)] (-> i64)
  (do (for [k 0 (primitive/iadd x 1)] (vset c k (mget c (primitive/iadd (ireg-get c) k)))) 0))

(defn opF [(c (ptr Chip8)) (x i64) (nn i64)] (-> i64)
  (cond
    (= nn (cast i64 0x07)) (vset c x (load (field c dt)))
    (= nn (cast i64 0x0A)) (wait-key c x)
    (= nn (cast i64 0x15)) (do (store! (field c dt) (vget c x)) 0)
    (= nn (cast i64 0x18)) (do (store! (field c st) (vget c x)) 0)
    (= nn (cast i64 0x1E)) (ireg-set c (primitive/iadd (ireg-get c) (vget c x)))
    (= nn (cast i64 0x29)) (ireg-set c (primitive/iadd 0x50 (primitive/imul (vget c x) 5)))
    (= nn (cast i64 0x33)) (bcd c x)
    (= nn (cast i64 0x55)) (store-regs c x)
    (= nn (cast i64 0x65)) (load-regs c x)
    0))

(defn exec [(c (ptr Chip8)) (op i64)] (-> i64)
  (let [hi (primitive/iand (primitive/ishr op 12) 0xF) x (primitive/iand (primitive/ishr op 8) 0xF) y (primitive/iand (primitive/ishr op 4) 0xF)
        n (primitive/iand op 0xF) nn (primitive/iand op 0xFF) nnn (primitive/iand op 0xFFF)]
    (cond
      (= hi (cast i64 0))  (op0 c op)
      (= hi (cast i64 1))  (pc-set c nnn)
      (= hi (cast i64 2))  (stack-push c nnn)
      (= hi (cast i64 3))  (if (= (vget c x) nn) (pc-skip c) 0)
      (= hi (cast i64 4))  (if (!= (vget c x) nn) (pc-skip c) 0)
      (= hi (cast i64 5))  (if (= (vget c x) (vget c y)) (pc-skip c) 0)
      (= hi (cast i64 6))  (vset c x nn)
      (= hi (cast i64 7))  (vset c x (primitive/iadd (vget c x) nn))
      (= hi (cast i64 8))  (op8 c x y n)
      (= hi (cast i64 9))  (if (!= (vget c x) (vget c y)) (pc-skip c) 0)
      (= hi (cast i64 10)) (ireg-set c nnn)
      (= hi (cast i64 11)) (pc-set c (primitive/iadd nnn (vget c 0)))
      (= hi (cast i64 12)) (vset c x (primitive/iand (primitive/cast :i64 (arc4random)) nn))
      (= hi (cast i64 13)) (draw-sprite c x y n)
      (= hi (cast i64 14)) (opE c x nn)
      (= hi (cast i64 15)) (opF c x nn)
      0)))

(defn fnt [(c (ptr Chip8)) (o i64) (a i64) (b i64) (d i64) (e i64) (f i64)] (-> i64)
  (do (mset c (primitive/iadd 0x50 o) a) (mset c (primitive/iadd 0x51 o) b) (mset c (primitive/iadd 0x52 o) d)
      (mset c (primitive/iadd 0x53 o) e) (mset c (primitive/iadd 0x54 o) f) 0))
(defn load-font [(c (ptr Chip8))] (-> i64)
  (do
    (fnt c 0   0xF0 0x90 0x90 0x90 0xF0)  (fnt c 5   0x20 0x60 0x20 0x20 0x70)
    (fnt c 10  0xF0 0x10 0xF0 0x80 0xF0)  (fnt c 15  0xF0 0x10 0xF0 0x10 0xF0)
    (fnt c 20  0x90 0x90 0xF0 0x10 0x10)  (fnt c 25  0xF0 0x80 0xF0 0x10 0xF0)
    (fnt c 30  0xF0 0x80 0xF0 0x90 0xF0)  (fnt c 35  0xF0 0x10 0x20 0x40 0x40)
    (fnt c 40  0xF0 0x90 0xF0 0x90 0xF0)  (fnt c 45  0xF0 0x90 0xF0 0x10 0xF0)
    (fnt c 50  0xF0 0x90 0xF0 0x90 0x90)  (fnt c 55  0xE0 0x90 0xE0 0x90 0xE0)
    (fnt c 60  0xF0 0x80 0x80 0x80 0xF0)  (fnt c 65  0xE0 0x90 0x90 0x90 0xE0)
    (fnt c 70  0xF0 0x80 0xF0 0x80 0xF0)  (fnt c 75  0xF0 0x80 0xF0 0x80 0x80)
    0))

; ---- public API ------------------------------------------------------------
(defn init [(c (ptr Chip8))] (-> i64)
  (do (memset c 0 (primitive/sizeof Chip8)) (store! (field c pc) 0x200) (load-font c) 0))

; load a ROM at 0x200; returns 0 on success, -1 if the file can't be opened.
(defn load-rom [(c (ptr Chip8)) (path (ptr i8))] (-> i64)
  (let [fd (primitive/cast :i64 (open path 0))]
    (if (< fd (cast i64 0)) -1
        (do (read (primitive/cast i32 fd) (primitive/index (field c mem) 0x200) 3584) (close fd) 0))))

(defn step [(c (ptr Chip8))] (-> i64)
  (let [pc (pc-get c) op (primitive/ior (primitive/ishl (mget c pc) 8) (mget c (primitive/iadd pc 1)))]
    (do (pc-set c (primitive/iadd pc 2)) (exec c op) 0)))

; decrement the 60 Hz timers — call once per frame.
(defn tick [(c (ptr Chip8))] (-> i64)
  (do (if (> (load (field c dt)) (cast i64 0)) (store! (field c dt)
                                                            (primitive/isub (load (field c
                                                                                                                       dt)) 1)) 0)
      (if (> (load (field c st)) (cast i64 0)) (store! (field c st)
                                                            (primitive/isub (load (field c
                                                                                                                       st)) 1)) 0) 0))

(defn px       [(c (ptr Chip8)) (i i64)] (-> i64) (primitive/cast :i64 (load (primitive/index (field c disp) i))))
(defn draw?    [(c (ptr Chip8))] (-> i64) (load (field c drawf)))
(defn clear-draw [(c (ptr Chip8))] (-> i64) (do (store! (field c drawf) 0) 0))

; input: front-ends mark a key "held for N frames" (terminals can't see key-up),
; test it, and age all keys by one frame.
(defn set-key   [(c (ptr Chip8)) (k i64) (frames i64)] (-> i64)
  (do (store! (primitive/index (field c keys) k) (primitive/cast :i32 frames)) 0))
(defn key-down  [(c (ptr Chip8)) (k i64)] (-> i64) (if (> (key-raw c k) (cast i64 0)) 1 0))
(defn decay-keys [(c (ptr Chip8))] (-> i64)
  (do (for [k 0 16] (let [kv (key-raw c k)]
                      (if (> kv (cast i64 0)) (store! (primitive/index (field c keys) k)
                                                      (primitive/cast :i32 (primitive/isub kv 1))) 0))) 0))
