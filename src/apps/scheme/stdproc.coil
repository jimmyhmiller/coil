(module coil.scheme.stdproc)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.continuation-runtime" :use [continuation-invoke
        continuation-current-winds continuation-wind-push
        continuation-wind-before continuation-wind-after
        continuation-wind-parent continuation-wind-set-current!
        continuation-target-winds])
(import "coil.scheme.symbol" :use *)
(import "coil.scheme.core" :use *)
(import "coil.scheme.closure" :use [closure-code closure-env closure-arity])
(import "coil.scheme.bignum" :use [big-sign big-limbs])

(extern snprintf :cc c [(ptr i8) i64 (ptr i8) ...] (-> i32))

;; R5RS §6.3 and §6.4: the standard procedures over pairs, strings, chars and
;; vectors — plus the two heap types that value.coil reserved tags for but never
;; built.
;;
;; THE REPRESENTATION PROBLEM. heap.coil's collector traces exactly three slots
;; (`a`, `b`, `c`) of a uniform 40-byte `Obj`, and every object shape goes through
;; that one path. A vector of N elements does not fit in three slots, and the
;; obvious fix — a malloc'd element array hung off a slot — is invisible to the
;; tracer: the elements would be collected while the vector still held them, and
;; the array itself would leak because a sweep has no finalizer to run.
;;
;; So element storage is built out of the SAME `Obj` the collector already knows.
;; A vector is a header (`a` = length, `b` = the first storage cell) and storage is
;; a chain of cells, each carrying two elements plus the link:
;;
;;     cell:  a = element 2k    b = element 2k+1    c = next cell (or 0)
;;
;; `mark` recurses on a, b and c, so it reaches every element and every subsequent
;; cell without a single line changing in heap.coil. That is the whole point of the
;; uniform three-slot design, and this is the first thing to actually exercise it.
;;
;; Two elements per cell rather than one is not a micro-optimization: the chain is
;; the tracer's recursion depth, so packing two halves it. It stays O(n/2) deep,
;; which is the honest cost of not touching the collector — see the note on
;; `vector-ref` below.
;;
;; A string uses the identical layout with a different tag, storing each character
;; as a tagged char immediate. Storing raw code points would be a latent
;; catastrophe: a raw small integer has low bits 000, which is exactly the encoding
;; of a heap pointer, so the tracer would dereference character data as an object.
;; Tagging keeps every stored word an immediate the collector skips by construction.

; ---- storage chains ---------------------------------------------------------
;; Cells reuse `tag-pair`: a storage cell is never reachable from Scheme code (only
;; the header points at the chain), so its tag is never observed, and reusing a tag
;; keeps the collector's shape assumptions uniform.
(defn cell-tag [] (-> i64) (tag-pair))

;; Build a chain of `n` cells, all slots initialized to `fill`. Built back-to-front
;; so each cell's link is already a complete object when it is stored — there is no
;; window where a half-built chain is reachable and a collection could run inside
;; `allocate` and free the tail.
(defn chain-make [(n i64) (fill i64)] (-> i64)
  (if (<= n 0) 0
    (let [sp (gc-sp)
          rest (chain-make (- n 2) fill)]
      (gc-root fill)
      (gc-root rest)
      (let [cell (allocate (cell-tag) fill fill rest)]
        (gc-sp-set! sp)
        cell))))

;; Walk `k` cells down the chain. Element i lives in cell i/2, slot i&1.
(defn chain-cell [(c i64) (k i64)] (-> i64)
  (if (<= k 0) c
    (chain-cell (primitive/load (primitive/field (obj-of c) c)) (- k 1))))

(defn chain-ref [(head i64) (i i64)] (-> i64)
  (let [cell (chain-cell head (primitive/idiv i 2))
        o (obj-of cell)]
    (if (= (primitive/iand i 1) 0)
        (primitive/load (primitive/field o a))
      (primitive/load (primitive/field o b)))))

(defn chain-set! [(head i64) (i i64) (v i64)] (-> i64)
  (let [cell (chain-cell head (primitive/idiv i 2))
        o (obj-of cell)]
    (if (= (primitive/iand i 1) 0)
        (primitive/store! (primitive/field o a) v)
      (primitive/store! (primitive/field o b) v))
    0))

; ---- vectors ----------------------------------------------------------------
;; `a` = length (a raw count, not a Val — it is never traced as one because it has
;; the low bits of a fixnum only by accident; see below), `b` = storage chain.
;;
;; The length is stored as a TAGGED fixnum, not a raw i64, for the same reason
;; string characters are tagged: slot `a` is traced, and a raw length like 8 has
;; low bits 000 and would be dereferenced as a heap pointer.
(defn make-vector-filled [(n i64) (fill i64)] (-> i64)
  (let [sp (gc-sp)
        storage (chain-make n fill)]
    (gc-root storage)
    (let [v (allocate (tag-vector) (mk-fixnum n) storage 0)]
      (gc-sp-set! sp)
      v)))

(defn vector-length-raw [(v i64)] (-> i64)
  (fixnum-value (primitive/load (primitive/field (obj-of v) a))))
(defn vector-storage [(v i64)] (-> i64) (primitive/load (primitive/field (obj-of v) b)))

;; O(n) in the index, because the storage is a chain rather than an array. That is
;; the price of a collector that traces three slots and nothing else; a real
;; implementation would give the collector a variable-length object shape and index
;; in O(1). The chunking above halves the constant, and nothing in the R5RS surface
;; here indexes a large vector in a loop.
(defn scm-vector-ref [(v i64) (i i64)] (-> i64)
  (chain-ref (vector-storage v) (fixnum-value i)))
(defn scm-vector-set! [(v i64) (i i64) (x i64)] (-> i64)
  (chain-set! (vector-storage v) (fixnum-value i) x)
  (s-unspecified))
(defn scm-vector-length [(v i64)] (-> i64) (mk-fixnum (vector-length-raw v)))
(defn scm-vector? [(v i64)] (-> i64) (mk-bool (is-vector v)))

;; R5RS leaves the fill of a one-argument `make-vector` unspecified; the
;; unspecified singleton is the honest answer, and it is never printed by the
;; conformance cases (the README forbids printing it).
(defn scm-make-vector [(n i64)] (-> i64)
  (make-vector-filled (fixnum-value n) (s-unspecified)))
(defn scm-make-vector-fill [(n i64) (fill i64)] (-> i64)
  (make-vector-filled (fixnum-value n) fill))

(defn scm-vector->list [(v i64)] (-> i64) (vec--tolist v 0 (vector-length-raw v)))
(defn vec--tolist [(v i64) (i i64) (n i64)] (-> i64)
  (if (>= i n) (s-nil)
    (let [sp (gc-sp)]
      (gc-root v)
      (let [item (scm-vector-ref v (mk-fixnum i))]
        (gc-root item)
        (let [tail (vec--tolist v (+ i 1) n)]
          (gc-root tail)
          (let [out (cons item tail)]
            (gc-sp-set! sp) (gc-root out) out))))))

(defn scm-list->vector [(l i64)] (-> i64)
  (let [sp (gc-sp) n (list--length l 0)]
    (gc-root l)
    (let [v (make-vector-filled n (s-unspecified))]
      (gc-root v)
      (vec--fill! v l 0)
      (gc-sp-set! sp)
      (gc-root v)
      v)))
(defn vec--fill! [(v i64) (l i64) (i i64)] (-> i64)
  (if (is-null l) 0
    (do (scm-vector-set! v (mk-fixnum i) (car l))
        (vec--fill! v (cdr l) (+ i 1)))))
(defn vector-fill-loop! [(v i64) (x i64) (i i64) (n i64)] (-> i64)
  (if (>= i n) (s-unspecified)
    (do (scm-vector-set! v (mk-fixnum i) x)
        (vector-fill-loop! v x (+ i 1) n))))
(defn scm-vector-fill! [(v i64) (x i64)] (-> i64)
  (vector-fill-loop! v x 0 (vector-length-raw v)))

; ---- strings ----------------------------------------------------------------
;; Same layout as a vector under `tag-string`; every stored element is a tagged
;; char, so `string-ref` hands back an R5RS character with no conversion.
(defn make-string-raw [(n i64)] (-> i64)
  (let [sp (gc-sp)
        storage (chain-make n (mk-char 32))]
    (gc-root storage)
    (let [s (allocate (tag-string) (mk-fixnum n) storage 0)]
      (gc-sp-set! sp)
      s)))

(defn string-length-raw [(v i64)] (-> i64)
  (fixnum-value (primitive/load (primitive/field (obj-of v) a))))
(defn string-storage [(v i64)] (-> i64) (primitive/load (primitive/field (obj-of v) b)))

(defn scm-string-length [(s i64)] (-> i64) (mk-fixnum (string-length-raw s)))
(defn scm-string-ref [(s i64) (i i64)] (-> i64)
  (chain-ref (string-storage s) (fixnum-value i)))
(defn scm-string? [(v i64)] (-> i64) (mk-bool (is-string v)))

;; Raw code point at i — the form every internal consumer (comparison, hashing,
;; symbol conversion) wants, without unwrapping a char Val at each step.
(defn string-code [(s i64) (i i64)] (-> i64)
  (char-value (chain-ref (string-storage s) i)))
(defn string-set-code! [(s i64) (i i64) (c i64)] (-> i64)
  (chain-set! (string-storage s) i (mk-char c)) 0)
(defn scm-make-string [(n i64)] (-> i64)
  (make-string-raw (fixnum-value n)))
(defn scm-make-string-fill [(n i64) (fill i64)] (-> i64)
  (let [s (make-string-raw (fixnum-value n))]
    (scm-string-fill! s fill)
    s))
(defn scm-string-set! [(s i64) (i i64) (c i64)] (-> i64)
  (do (string-set-code! s (fixnum-value i) (char-value c)) (s-unspecified)))
(defn scm-string-copy [(s i64)] (-> i64)
  (scm-substring s (mk-fixnum 0) (mk-fixnum (string-length-raw s))))
(defn string-fill-loop! [(s i64) (c i64) (i i64) (n i64)] (-> i64)
  (if (>= i n) (s-unspecified)
    (do (string-set-code! s i (char-value c))
        (string-fill-loop! s c (+ i 1) n))))
(defn scm-string-fill! [(s i64) (c i64)] (-> i64)
  (string-fill-loop! s c 0 (string-length-raw s)))

;; Build a Scheme string from a Coil byte slice. ASCII only: a `(slice u8)` is
;; bytes, and decoding UTF-8 into code points is a separate concern from the
;; standard-procedure surface. Non-ASCII source text therefore round-trips as
;; individual bytes rather than characters — stated plainly because it is a real
;; limitation, not an oversight.
(defn string-from-slice [(bs (slice u8))] (-> i64)
  (let [n (slice-len bs)
        s (make-string-raw n)]
    (for [i 0 n]
      (string-set-code! s i (primitive/cast i64 (slice-get bs i))))
    s))

(defn scm-string-append [(a i64) (b i64)] (-> i64)
  (let [na (string-length-raw a)
        nb (string-length-raw b)
        s (make-string-raw (+ na nb))]
    (for [i 0 na] (string-set-code! s i (string-code a i)))
    (for [i 0 nb] (string-set-code! s (+ na i) (string-code b i)))
    s))

;; R5RS: `(substring s start end)` is the half-open range [start, end).
(defn scm-substring [(str i64) (start i64) (end i64)] (-> i64)
  (let [lo (fixnum-value start)
        hi (fixnum-value end)
        s (make-string-raw (- hi lo))]
    (for [i 0 (- hi lo)] (string-set-code! s i (string-code str (+ lo i))))
    s))

(defn scm-string->list [(s i64)] (-> i64) (str--tolist s 0 (string-length-raw s)))
(defn str--tolist [(s i64) (i i64) (n i64)] (-> i64)
  (if (>= i n) (s-nil)
    (cons (mk-char (string-code s i)) (str--tolist s (+ i 1) n))))

(defn scm-list->string [(l i64)] (-> i64)
  (let [n (list--length l 0)
        s (make-string-raw n)]
    (str--fill! s l 0)
    s))
(defn str--fill! [(s i64) (l i64) (i i64)] (-> i64)
  (if (is-null l) 0
    (do (string-set-code! s i (char-value (car l)))
        (str--fill! s (cdr l) (+ i 1)))))

;; Lexicographic comparison over code points, returning -1/0/1. `string=?` and the
;; ordering predicates all fold onto it so there is one definition of the order.
(defn string-cmp [(a i64) (b i64)] (-> i64)
  (let [na (string-length-raw a) nb (string-length-raw b)
        (mut r) 0 (mut i) 0]
    (loop
      (if (or (not (= (primitive/load (mut r)) 0))
              (or (>= (primitive/load (mut i)) na) (>= (primitive/load (mut i)) nb)))
          (break)
        (let [ca (string-code a (primitive/load (mut i)))
              cb (string-code b (primitive/load (mut i)))]
          (if (< ca cb) (primitive/store! (mut r) -1)
            (if (> ca cb) (primitive/store! (mut r) 1) 0))
          (primitive/store! (mut i) (+ (primitive/load (mut i)) 1)))))
    ; a common prefix means the shorter string sorts first
    (if (not (= (primitive/load (mut r)) 0)) (primitive/load (mut r))
      (if (< na nb) -1 (if (> na nb) 1 0)))))

(defn scm-string=? [(a i64) (b i64)] (-> i64) (mk-bool (= (string-cmp a b) 0)))
(defn scm-string<? [(a i64) (b i64)] (-> i64) (mk-bool (< (string-cmp a b) 0)))
(defn scm-string>? [(a i64) (b i64)] (-> i64) (mk-bool (> (string-cmp a b) 0)))
(defn scm-string<=? [(a i64) (b i64)] (-> i64) (mk-bool (<= (string-cmp a b) 0)))
(defn scm-string>=? [(a i64) (b i64)] (-> i64) (mk-bool (>= (string-cmp a b) 0)))

(defn ascii-down [(n i64)] (-> i64)
  (if (and (>= n 65) (<= n 90)) (+ n 32) n))
(defn string-ci-cmp [(a i64) (b i64)] (-> i64)
  (let [na (string-length-raw a) nb (string-length-raw b)
        (mut r) 0 (mut i) 0]
    (loop
      (if (or (not (= (primitive/load (mut r)) 0))
              (or (>= (primitive/load (mut i)) na) (>= (primitive/load (mut i)) nb)))
          (break)
        (let [ca (ascii-down (string-code a (primitive/load (mut i))))
              cb (ascii-down (string-code b (primitive/load (mut i))))]
          (if (< ca cb) (primitive/store! (mut r) -1)
            (if (> ca cb) (primitive/store! (mut r) 1) 0))
          (primitive/store! (mut i) (+ (primitive/load (mut i)) 1)))))
    (if (not (= (primitive/load (mut r)) 0)) (primitive/load (mut r))
      (if (< na nb) -1 (if (> na nb) 1 0)))))
(defn scm-string-ci=? [(a i64) (b i64)] (-> i64) (mk-bool (= (string-ci-cmp a b) 0)))
(defn scm-string-ci<? [(a i64) (b i64)] (-> i64) (mk-bool (< (string-ci-cmp a b) 0)))
(defn scm-string-ci>? [(a i64) (b i64)] (-> i64) (mk-bool (> (string-ci-cmp a b) 0)))
(defn scm-string-ci<=? [(a i64) (b i64)] (-> i64) (mk-bool (<= (string-ci-cmp a b) 0)))
(defn scm-string-ci>=? [(a i64) (b i64)] (-> i64) (mk-bool (>= (string-ci-cmp a b) 0)))

;; `string->symbol` / `symbol->string` bridge the two string worlds: a Scheme
;; string is a chain of chars, while the symbol table keys on a Coil byte slice.
;; The conversion is a copy in both directions, which is correct rather than
;; clever — symbols are interned, so `(eq? (string->symbol "hi") 'hi)` holds
;; because both paths reach the same table entry.
(defn scm-string->symbol [(s i64)] (-> i64)
  (let [n (string-length-raw s)
        buf (primitive/cast (ptr u8) (malloc (+ n 1)))]
    (for [i 0 n]
      (primitive/store! (primitive/index buf i)
                        (primitive/cast u8 (string-code s i))))
    (intern (slice-new buf n))))

(defn scm-symbol->string [(v i64)] (-> i64) (string-from-slice (symbol-name v)))

; ---- characters -------------------------------------------------------------
(defn scm-char->integer [(c i64)] (-> i64) (mk-fixnum (char-value c)))
(defn scm-integer->char [(n i64)] (-> i64) (mk-char (fixnum-value n)))
(defn scm-char? [(v i64)] (-> i64) (mk-bool (is-char v)))

;; ASCII case mapping only. R5RS requires `char-upcase` to be the identity on any
;; character with no upper-case counterpart, which is exactly what falling through
;; gives — so the guard is the definition, not a shortcut.
(defn scm-char-upcase [(c i64)] (-> i64)
  (let [n (char-value c)]
    (if (and (>= n 97) (<= n 122)) (mk-char (- n 32)) c)))
(defn scm-char-downcase [(c i64)] (-> i64)
  (let [n (char-value c)]
    (if (and (>= n 65) (<= n 90)) (mk-char (+ n 32)) c)))

(defn scm-char=? [(a i64) (b i64)] (-> i64) (mk-bool (= (char-value a) (char-value b))))
(defn scm-char<? [(a i64) (b i64)] (-> i64) (mk-bool (< (char-value a) (char-value b))))
(defn scm-char>? [(a i64) (b i64)] (-> i64) (mk-bool (> (char-value a) (char-value b))))
(defn scm-char<=? [(a i64) (b i64)] (-> i64) (mk-bool (<= (char-value a) (char-value b))))
(defn scm-char>=? [(a i64) (b i64)] (-> i64) (mk-bool (>= (char-value a) (char-value b))))
(defn scm-char-ci=? [(a i64) (b i64)] (-> i64)
  (mk-bool (= (ascii-down (char-value a)) (ascii-down (char-value b)))))
(defn scm-char-ci<? [(a i64) (b i64)] (-> i64)
  (mk-bool (< (ascii-down (char-value a)) (ascii-down (char-value b)))))
(defn scm-char-ci>? [(a i64) (b i64)] (-> i64)
  (mk-bool (> (ascii-down (char-value a)) (ascii-down (char-value b)))))
(defn scm-char-ci<=? [(a i64) (b i64)] (-> i64)
  (mk-bool (<= (ascii-down (char-value a)) (ascii-down (char-value b)))))
(defn scm-char-ci>=? [(a i64) (b i64)] (-> i64)
  (mk-bool (>= (ascii-down (char-value a)) (ascii-down (char-value b)))))
(defn scm-char-alphabetic? [(c i64)] (-> i64)
  (let [n (ascii-down (char-value c))] (mk-bool (and (>= n 97) (<= n 122)))))
(defn scm-char-numeric? [(c i64)] (-> i64)
  (let [n (char-value c)] (mk-bool (and (>= n 48) (<= n 57)))))
(defn scm-char-whitespace? [(c i64)] (-> i64)
  (let [n (char-value c)]
    (mk-bool (or (= n 32) (or (= n 9) (or (= n 10) (= n 13)))))))
(defn scm-char-upper-case? [(c i64)] (-> i64)
  (let [n (char-value c)] (mk-bool (and (>= n 65) (<= n 90)))))
(defn scm-char-lower-case? [(c i64)] (-> i64)
  (let [n (char-value c)] (mk-bool (and (>= n 97) (<= n 122)))))

;; Variadic comparison adapters. R5RS chains every adjacent pair.
(defn comparison-arity-fail [] (-> i64)
  (alloc/oom-puts c"coil.scheme: comparison expects at least two arguments\n")
  (alloc/abort)
  (s-unspecified))
(defn apply-type-fail [] (-> i64)
  (alloc/oom-puts c"coil.scheme: attempted to call a non-procedure\n")
  (alloc/abort)
  (s-unspecified))
(defn scm-char-compare-mode [(mode i64) (a i64) (b i64)] (-> i64)
  (cond (= mode 0) (scm-char=? a b) (= mode 1) (scm-char<? a b)
        (= mode 2) (scm-char>? a b) (= mode 3) (scm-char<=? a b)
        (= mode 4) (scm-char>=? a b) (= mode 5) (scm-char-ci=? a b)
        (= mode 6) (scm-char-ci<? a b) (= mode 7) (scm-char-ci>? a b)
        (= mode 8) (scm-char-ci<=? a b) :else (scm-char-ci>=? a b)))
(defn scm-char-compare-rest [(mode i64) (previous i64) (rest i64)] (-> i64)
  (if (is-null rest) (s-true)
    (if (not (truthy? (scm-char-compare-mode mode previous (car rest)))) (s-false)
      (scm-char-compare-rest mode (car rest) (cdr rest)))))
(defn scm-char-compare-args [(mode i64) (args i64)] (-> i64)
  (if (or (is-null args) (is-null (cdr args))) (comparison-arity-fail)
    (scm-char-compare-rest mode (car args) (cdr args))))
(defn scm-char-eq-args [(args i64)] (-> i64) (scm-char-compare-args 0 args))
(defn scm-char-lt-args [(args i64)] (-> i64) (scm-char-compare-args 1 args))
(defn scm-char-gt-args [(args i64)] (-> i64) (scm-char-compare-args 2 args))
(defn scm-char-le-args [(args i64)] (-> i64) (scm-char-compare-args 3 args))
(defn scm-char-ge-args [(args i64)] (-> i64) (scm-char-compare-args 4 args))
(defn scm-char-ci-eq-args [(args i64)] (-> i64) (scm-char-compare-args 5 args))
(defn scm-char-ci-lt-args [(args i64)] (-> i64) (scm-char-compare-args 6 args))
(defn scm-char-ci-gt-args [(args i64)] (-> i64) (scm-char-compare-args 7 args))
(defn scm-char-ci-le-args [(args i64)] (-> i64) (scm-char-compare-args 8 args))
(defn scm-char-ci-ge-args [(args i64)] (-> i64) (scm-char-compare-args 9 args))

(defn scm-string-compare-mode [(mode i64) (a i64) (b i64)] (-> i64)
  (cond (= mode 0) (scm-string=? a b) (= mode 1) (scm-string<? a b)
        (= mode 2) (scm-string>? a b) (= mode 3) (scm-string<=? a b)
        (= mode 4) (scm-string>=? a b) (= mode 5) (scm-string-ci=? a b)
        (= mode 6) (scm-string-ci<? a b) (= mode 7) (scm-string-ci>? a b)
        (= mode 8) (scm-string-ci<=? a b) :else (scm-string-ci>=? a b)))
(defn scm-string-compare-rest [(mode i64) (previous i64) (rest i64)] (-> i64)
  (if (is-null rest) (s-true)
    (if (not (truthy? (scm-string-compare-mode mode previous (car rest)))) (s-false)
      (scm-string-compare-rest mode (car rest) (cdr rest)))))
(defn scm-string-compare-args [(mode i64) (args i64)] (-> i64)
  (if (or (is-null args) (is-null (cdr args))) (comparison-arity-fail)
    (scm-string-compare-rest mode (car args) (cdr args))))
(defn scm-string-eq-args [(args i64)] (-> i64) (scm-string-compare-args 0 args))
(defn scm-string-lt-args [(args i64)] (-> i64) (scm-string-compare-args 1 args))
(defn scm-string-gt-args [(args i64)] (-> i64) (scm-string-compare-args 2 args))
(defn scm-string-le-args [(args i64)] (-> i64) (scm-string-compare-args 3 args))
(defn scm-string-ge-args [(args i64)] (-> i64) (scm-string-compare-args 4 args))
(defn scm-string-ci-eq-args [(args i64)] (-> i64) (scm-string-compare-args 5 args))
(defn scm-string-ci-lt-args [(args i64)] (-> i64) (scm-string-compare-args 6 args))
(defn scm-string-ci-gt-args [(args i64)] (-> i64) (scm-string-compare-args 7 args))
(defn scm-string-ci-le-args [(args i64)] (-> i64) (scm-string-compare-args 8 args))
(defn scm-string-ci-ge-args [(args i64)] (-> i64) (scm-string-compare-args 9 args))

; ---- pairs and lists --------------------------------------------------------
;; The c[ad]+r family. R5RS defines these by composition, and the naming reads
;; right-to-left: `cadr` is the car OF the cdr.
(defn scm-caar [(v i64)] (-> i64) (car (car v)))
(defn scm-cadr [(v i64)] (-> i64) (car (cdr v)))
(defn scm-cdar [(v i64)] (-> i64) (cdr (car v)))
(defn scm-cddr [(v i64)] (-> i64) (cdr (cdr v)))
(defn scm-caddr [(v i64)] (-> i64) (car (cdr (cdr v))))
(defn scm-cdddr [(v i64)] (-> i64) (cdr (cdr (cdr v))))
(defn scm-caadr [(v i64)] (-> i64) (car (car (cdr v))))
(defn scm-cddar [(v i64)] (-> i64) (cdr (cdr (car v))))
(defn scm-cadar [(v i64)] (-> i64) (car (cdr (car v))))
(defn scm-cdadr [(v i64)] (-> i64) (cdr (car (cdr v))))
(defn scm-cadddr [(v i64)] (-> i64) (car (cdr (cdr (cdr v)))))
(defn scm-caaar [(v i64)] (-> i64) (car (car (car v))))
(defn scm-cdaar [(v i64)] (-> i64) (cdr (car (car v))))
(defn scm-caaaar [(v i64)] (-> i64) (car (car (car (car v)))))
(defn scm-caaadr [(v i64)] (-> i64) (car (car (car (cdr v)))))
(defn scm-caadar [(v i64)] (-> i64) (car (car (cdr (car v)))))
(defn scm-caaddr [(v i64)] (-> i64) (car (car (cdr (cdr v)))))
(defn scm-cadaar [(v i64)] (-> i64) (car (cdr (car (car v)))))
(defn scm-cadadr [(v i64)] (-> i64) (car (cdr (car (cdr v)))))
(defn scm-caddar [(v i64)] (-> i64) (car (cdr (cdr (car v)))))
(defn scm-cdaaar [(v i64)] (-> i64) (cdr (car (car (car v)))))
(defn scm-cdaadr [(v i64)] (-> i64) (cdr (car (car (cdr v)))))
(defn scm-cdadar [(v i64)] (-> i64) (cdr (car (cdr (car v)))))
(defn scm-cdaddr [(v i64)] (-> i64) (cdr (car (cdr (cdr v)))))
(defn scm-cddaar [(v i64)] (-> i64) (cdr (cdr (car (car v)))))
(defn scm-cddadr [(v i64)] (-> i64) (cdr (cdr (car (cdr v)))))
(defn scm-cdddar [(v i64)] (-> i64) (cdr (cdr (cdr (car v)))))
(defn scm-cddddr [(v i64)] (-> i64) (cdr (cdr (cdr (cdr v)))))

(defn list--length [(l i64) (acc i64)] (-> i64)
  (if (is-null l) acc (list--length (cdr l) (+ acc 1))))
(defn scm-length [(l i64)] (-> i64) (mk-fixnum (list--length l 0)))

;; `append` copies every argument but the last, which keeps its structure — R5RS
;; says the result shares the last argument's tail, and code relies on that.
(defn scm-append [(a i64) (b i64)] (-> i64)
  (if (is-null a) b
    (let [sp (gc-sp)]
      ; The recursive copy may collect.  Keep both the source pair (whose car
      ; is still needed) and the shared final tail alive across that call.
      (gc-root a) (gc-root b)
      (let [tail (scm-append (cdr a) b)]
        (gc-root tail)
        (let [out (cons (car a) tail)]
          (gc-sp-set! sp) (gc-root out) out)))))

(defn scm-reverse [(l i64)] (-> i64) (rev--acc l (s-nil)))
(defn rev--acc [(l i64) (acc i64)] (-> i64)
  (if (is-null l) acc
    (let [sp (gc-sp)]
      ; `cons` can collect before the recursive call receives its arguments.
      (gc-root l) (gc-root acc)
      (let [next (cons (car l) acc)]
        (gc-root next)
        (let [out (rev--acc (cdr l) next)]
          (gc-sp-set! sp) (gc-root out) out)))))

(defn scm-list-tail [(l i64) (k i64)] (-> i64) (tail--n l (fixnum-value k)))
(defn tail--n [(l i64) (k i64)] (-> i64) (if (<= k 0) l (tail--n (cdr l) (- k 1))))
(defn scm-list-ref [(l i64) (k i64)] (-> i64) (car (tail--n l (fixnum-value k))))

;; R5RS `list?` must terminate on a circular list, so it walks with a tortoise and
;; hare rather than trusting the cdr chain to end. `(list? '(1 . 2))` is #f — an
;; improper tail is not a list, which is the case a naive `is-null`-or-`is-pair` loop
;; gets right only by accident.
(defn scm-list? [(l i64)] (-> i64) (mk-bool (list--proper? l l)))
(defn list--proper? [(slow i64) (fast i64)] (-> bool)
  (if (is-null fast) true
    (if (not (is-pair fast)) false
      (let [f1 (cdr fast)]
        (if (is-null f1) true
          (if (not (is-pair f1)) false
            (let [f2 (cdr f1) s1 (cdr slow)]
              (if (val-eq? f2 s1) false        ; the hare lapped the tortoise: circular
                (list--proper? s1 f2)))))))))

; ---- equivalence ------------------------------------------------------------
;; The three predicates differ in exactly one axis — how deep they look — and the
;; searches below (`memq`/`memv`/`member`, `assq`/`assv`/`assoc`) are the same
;; search parameterized by which one they use.
;;
;; `eq?` and `eqv?` coincide in this implementation: every immediate is compared by
;; its word and every heap object by its address, and with no flonums or bignums
;; there is no value for which R5RS distinguishes them. They are kept separate
;; because that stops being true the moment the numeric tower lands.
(defn scm-eq? [(a i64) (b i64)] (-> i64) (mk-bool (val-eq? a b)))

;; `equal?` recurses structurally where `eqv?` does not: over pairs, and over the
;; two aggregate types this module introduces. R5RS defines it as `eqv?` on
;; everything else, so the base case is a word compare.
(defn equal--p [(a i64) (b i64)] (-> bool)
  (if (val-eq? a b) true                       ; identity short-circuits every case
    (if (and (is-pair a) (is-pair b))
        (and (equal--p (car a) (car b)) (equal--p (cdr a) (cdr b)))
      (if (and (is-string a) (is-string b)) (= (string-cmp a b) 0)
        (if (and (is-vector a) (is-vector b))
            (and (= (vector-length-raw a) (vector-length-raw b))
                 (vec--equal? a b 0 (vector-length-raw a)))
          (truthy? (scm-eqv? a b)))))))
(defn vec--equal? [(a i64) (b i64) (i i64) (n i64)] (-> bool)
  (if (>= i n) true
    (and (equal--p (scm-vector-ref a (mk-fixnum i)) (scm-vector-ref b (mk-fixnum i)))
         (vec--equal? a b (+ i 1) n))))
(defn scm-equal? [(a i64) (b i64)] (-> i64) (mk-bool (equal--p a b)))

;; R5RS: `member`/`assoc` return the sublist/pair found, NOT #t — that is what
;; makes `(cdr (assq k alist))` the idiomatic lookup. A miss is #f.
(defn scm-memq [(x i64) (l i64)] (-> i64)
  (if (is-null l) (s-false)
    (if (val-eq? x (car l)) l (scm-memq x (cdr l)))))
(defn scm-memv [(x i64) (l i64)] (-> i64) (scm-memq x l))
(defn scm-member [(x i64) (l i64)] (-> i64)
  (if (is-null l) (s-false)
    (if (equal--p x (car l)) l (scm-member x (cdr l)))))

(defn scm-assq [(x i64) (l i64)] (-> i64)
  (if (is-null l) (s-false)
    (if (val-eq? x (car (car l))) (car l) (scm-assq x (cdr l)))))
(defn scm-assv [(x i64) (l i64)] (-> i64) (scm-assq x l))
(defn scm-assoc [(x i64) (l i64)] (-> i64)
  (if (is-null l) (s-false)
    (if (equal--p x (car (car l))) (car l) (scm-assoc x (cdr l)))))

; ---- procedures as values ---------------------------------------------------
;; `map`, `for-each` and `apply` all take a procedure as an ORDINARY ARGUMENT and
;; call it, which the dialect had no way to express: lambda.coil defines a closure
;; object with a code-pointer slot, but nothing ever put a code pointer in it and
;; nothing could call one back out.
;;
;; The missing piece is a round trip between a Coil function pointer and the i64 a
;; `Val` must be. `primitive/cast` refuses it — it converts only among ints, floats
;; and pointers, and a `fnptr` is none of those to the checker — so the conversion
;; drops to `llvm-ir` for a `ptrtoint`/`inttoptr` pair. That is a two-instruction
;; escape hatch, not a representation change: the pointer is still exactly the
;; function's address.
;;
;; A procedure object is `tag-primitive` with `a` = the code address and `b` = the
;; arity as a tagged fixnum. The address is stored SHIFTED LEFT BY 3 and tagged as
;; a fixnum for the same reason string characters are tagged: slot `a` is traced,
;; and a raw code address has low bits 000, so the collector would follow it into
;; the text segment and corrupt whatever it found there.
(defn fnptr1->i64 [(f (fnptr c [i64] i64))] (-> i64)
  (primitive/llvm-ir i64 [f] "%r = ptrtoint $t0 $0 to i64\nret i64 %r"))
(defn fnptr2->i64 [(f (fnptr c [i64 i64] i64))] (-> i64)
  (primitive/llvm-ir i64 [f] "%r = ptrtoint $t0 $0 to i64\nret i64 %r"))
(defn fnptr3->i64 [(f (fnptr c [i64 i64 i64] i64))] (-> i64)
  (primitive/llvm-ir i64 [f] "%r = ptrtoint $t0 $0 to i64\nret i64 %r"))

;; `(scm-procedure NAME ARITY)` — wrap a Coil function of `ARITY` Val parameters as
;; a Scheme procedure value. Arity is fixed at the wrap site because the call has
;; to be made through a correctly-typed pointer; there is no variadic indirect call.
(defn scm-procedure [(name Code) (arity Code)] (-> Code)
  `(make-procedure (~(primitive/code-symbol `fnptr (primitive/code-str arity)) ~name)
                   ~arity))
(defn fnptr1 [(f Code)] (-> Code) `(fnptr1->i64 (primitive/fnptr-of ~f)))
(defn fnptr2 [(f Code)] (-> Code) `(fnptr2->i64 (primitive/fnptr-of ~f)))
(defn fnptr3 [(f Code)] (-> Code) `(fnptr3->i64 (primitive/fnptr-of ~f)))

;; A REDUCER: a binary function applied left-to-right across the whole argument
;; list, with an identity for the empty case. This is not a convenience — it is the
;; only honest way to represent R5RS's variadic arithmetic as a first-class value.
;; `+` accepts any number of arguments, so `(apply + 1 2 '(3 4))` must fold over
;; five of them; a procedure with a fixed arity of 2 simply cannot be `+`, and
;; wrapping one would silently give 3 instead of 10.
;;
;; Arity -1 marks the reducer kind, so `scm-apply-list` dispatches on it before it
;; ever compares argument counts.
(defn reducer-arity [] (-> i64) -1)
(defn scm-reducer [(name Code) (identity Code)] (-> Code)
  `(make-reducer (fnptr2->i64 (primitive/fnptr-of ~name)) ~identity))
(defn make-reducer [(code i64) (identity i64)] (-> i64)
  ;; `c` carries the identity — the value R5RS gives for zero arguments, e.g. 0
  ;; for `+` and 1 for `*`.
  (allocate (tag-primitive) (mk-fixnum code) (mk-fixnum (reducer-arity)) identity))
(defn reducer? [(p i64)] (-> bool)
  (and (has-tag? p (tag-primitive)) (= (procedure-arity p) (reducer-arity))))
(defn reducer-identity [(p i64)] (-> i64) (primitive/load (primitive/field (obj-of p) c)))
(defn call-reducer2 [(p i64) (a i64) (b i64)] (-> i64)
  (primitive/call-ptr
    (primitive/llvm-ir (fnptr c [i64 i64] i64) [(procedure-code p)]
                       "%r = inttoptr i64 $0 to ptr\nret ptr %r")
    a b))

;; Fold left-to-right. `(+)` is the identity, `(+ x)` is x, and anything longer
;; folds — exactly R5RS's definition for the variadic arithmetic operators.
(defn reduce--list [(p i64) (acc i64) (l i64)] (-> i64)
  (if (is-null l) acc (reduce--list p (call-reducer2 p acc (car l)) (cdr l))))
(defn scm-reduce [(p i64) (args i64)] (-> i64)
  (if (is-null args) (reducer-identity p)
    (reduce--list p (car args) (cdr args))))

;; General variadic primitives receive their complete argument list. Reducers
;; remain separate because their binary hot path is materially cheaper.
(defn list-procedure-arity [] (-> i64) -2)
(defn make-list-procedure [(code i64)] (-> i64)
  (allocate (tag-primitive) (mk-fixnum code) (mk-fixnum (list-procedure-arity)) 0))
(defn list-procedure? [(p i64)] (-> bool)
  (and (has-tag? p (tag-primitive)) (= (procedure-arity p) (list-procedure-arity))))
(defn call-list-procedure [(p i64) (args i64)] (-> i64)
  (primitive/call-ptr
    (primitive/llvm-ir (fnptr c [i64] i64) [(procedure-code p)]
                       "%r = inttoptr i64 $0 to ptr\nret ptr %r")
    args))

(defn variadic-fold [(op i64) (acc i64) (rest i64)] (-> i64)
  (if (is-null rest) acc
    (variadic-fold op
      (if (= op 0) (scm-sub acc (car rest)) (scm-div acc (car rest)))
      (cdr rest))))
(defn scm-sub-args [(args i64)] (-> i64)
  (if (is-null args) (s-unspecified)
    (if (is-null (cdr args)) (scm-sub (mk-fixnum 0) (car args))
      (variadic-fold 0 (car args) (cdr args)))))
(defn scm-div-args [(args i64)] (-> i64)
  (if (is-null args) (s-unspecified)
    (if (is-null (cdr args)) (scm-div (mk-fixnum 1) (car args))
      (variadic-fold 1 (car args) (cdr args)))))
(defn compare-args [(mode i64) (args i64)] (-> i64)
  (if (or (is-null args) (is-null (cdr args))) (comparison-arity-fail)
    (let [a (car args) b (car (cdr args))
          ok (cond (= mode 0) (scm-lt a b)
                   (= mode 1) (scm-gt a b)
                   (= mode 2) (scm-le a b)
                   (= mode 3) (scm-ge a b)
                   :else (scm-num-eq a b))]
      (if (truthy? ok)
          (if (is-null (cdr (cdr args))) (s-true)
            (compare-args mode (cdr args)))
        (s-false)))))
(defn scm-lt-args [(args i64)] (-> i64) (compare-args 0 args))
(defn scm-gt-args [(args i64)] (-> i64) (compare-args 1 args))
(defn scm-le-args [(args i64)] (-> i64) (compare-args 2 args))
(defn scm-ge-args [(args i64)] (-> i64) (compare-args 3 args))
(defn scm-eq-args [(args i64)] (-> i64) (compare-args 4 args))
(defn scm-list-args [(args i64)] (-> i64) args)
(defn scm-vector-args [(args i64)] (-> i64) (scm-list->vector args))
(defn scm-append-args [(args i64)] (-> i64)
  (if (is-null args) (s-nil)
    (if (is-null (cdr args)) (car args)
      (let [sp (gc-sp)]
        (gc-root args)
        (let [tail (scm-append-args (cdr args))]
          (gc-root tail)
          (let [out (scm-append (car args) tail)]
            (gc-sp-set! sp) (gc-root out) out))))))
(defn scm-string-append-args [(args i64)] (-> i64)
  (if (is-null args) (string-from-slice "")
    (if (is-null (cdr args)) (car args)
      (let [sp (gc-sp)]
        (gc-root args)
        (let [tail (scm-string-append-args (cdr args))]
          (gc-root tail)
          (let [out (scm-string-append (car args) tail)]
            (gc-sp-set! sp) (gc-root out) out))))))
(defn scm-map-args [(args i64)] (-> i64)
  (if (or (is-null args) (is-null (cdr args))) (s-unspecified)
    (scm-map-n (car args) (cdr args))))
(defn scm-for-each-args [(args i64)] (-> i64)
  (if (or (is-null args) (is-null (cdr args))) (s-unspecified)
    (scm-for-each-n (car args) (cdr args))))
(defn apply-args-tail [(args i64)] (-> i64)
  (if (is-null (cdr args)) (car args)
    (let [sp (gc-sp)]
      (gc-root args)
      (let [tail (apply-args-tail (cdr args))]
        (gc-root tail)
        (let [out (cons (car args) tail)]
          (gc-sp-set! sp) out)))))
(defn scm-apply-args [(args i64)] (-> i64)
  (if (or (is-null args) (is-null (cdr args))) (s-unspecified)
    (let [sp (gc-sp)]
      (gc-root args)
      (let [tail (apply-args-tail (cdr args))]
        (gc-root tail)
        (let [out (scm-apply-list (car args) tail)]
          (gc-sp-set! sp) out)))))
(defn scm-tail-request-apply-args [(args i64)] (-> i64)
  (if (or (is-null args) (is-null (cdr args))) (s-unspecified)
    (let [sp (gc-sp)]
      (gc-root args)
      (let [tail (apply-args-tail (cdr args))]
        (gc-root tail)
        (let [p (car args)]
          (gc-root p)
          (let [out (scm-tail-request-list p tail)]
            (gc-sp-set! sp) out))))))
(defn scm-values-args [(args i64)] (-> i64) (scm-values-list args))
(defn scm-make-string-args [(args i64)] (-> i64)
  (if (is-null args) (s-unspecified)
    (let [rest (cdr args)]
      (if (is-null rest) (scm-make-string (car args))
        (if (is-null (cdr rest)) (scm-make-string-fill (car args) (car rest))
          (s-unspecified))))))
(defn scm-make-vector-args [(args i64)] (-> i64)
  (if (is-null args) (s-unspecified)
    (let [rest (cdr args)]
      (if (is-null rest) (scm-make-vector (car args))
        (if (is-null (cdr rest)) (scm-make-vector-fill (car args) (car rest))
          (s-unspecified))))))

(defn make-procedure [(code i64) (arity i64)] (-> i64)
  (allocate (tag-primitive) (mk-fixnum code) (mk-fixnum arity) 0))
(defn procedure-code [(p i64)] (-> i64)
  (if (is-closure p) (closure-code p)
    (fixnum-value (primitive/load (primitive/field (obj-of p) a)))))
(defn procedure-arity [(p i64)] (-> i64)
  (if (is-closure p) (closure-arity p)
    (fixnum-value (primitive/load (primitive/field (obj-of p) b)))))
(defn variadic-closure? [(p i64)] (-> bool)
  (and (is-closure p) (and (<= (closure-arity p) -2) (> (closure-arity p) -100000))))
(defn fixed-list-closure? [(p i64)] (-> bool)
  (and (is-closure p) (<= (closure-arity p) -100000)))
(defn fixed-list-arity [(p i64)] (-> i64) (- 0 (+ (closure-arity p) 100000)))
(defn call-fixed-list [(p i64) (args i64) (n i64)] (-> i64)
  (if (not (= n (fixed-list-arity p))) (s-unspecified)
    (call-closure--1 p args)))
(defn variadic-min-arity [(p i64)] (-> i64)
  (- 0 (+ (closure-arity p) 2)))
(defn call-variadic-list [(p i64) (args i64) (n i64)] (-> i64)
  (if (< n (variadic-min-arity p)) (s-unspecified)
    (call-closure--1 p args)))

(defn call-closure--0 [(p i64)] (-> i64)
  (primitive/call-ptr
    (primitive/llvm-ir (fnptr c [i64] i64) [(procedure-code p)]
                       "%r = inttoptr i64 $0 to ptr\nret ptr %r")
    (closure-env p)))
(defn call-closure--1 [(p i64) (x i64)] (-> i64)
  (primitive/call-ptr
    (primitive/llvm-ir (fnptr c [i64 i64] i64) [(procedure-code p)]
                       "%r = inttoptr i64 $0 to ptr\nret ptr %r")
    (closure-env p) x))
(defn call-closure--2 [(p i64) (x i64) (y i64)] (-> i64)
  (primitive/call-ptr
    (primitive/llvm-ir (fnptr c [i64 i64 i64] i64) [(procedure-code p)]
                       "%r = inttoptr i64 $0 to ptr\nret ptr %r")
    (closure-env p) x y))
(defn call-closure--3 [(p i64) (x i64) (y i64) (z i64)] (-> i64)
  (primitive/call-ptr
    (primitive/llvm-ir (fnptr c [i64 i64 i64 i64] i64) [(procedure-code p)]
                       "%r = inttoptr i64 $0 to ptr\nret ptr %r")
    (closure-env p) x y z))
(defn call-closure--4 [(p i64) (a i64) (b i64) (c i64) (d i64)] (-> i64)
  (primitive/call-ptr
    (primitive/llvm-ir (fnptr c [i64 i64 i64 i64 i64] i64) [(procedure-code p)]
                       "%r = inttoptr i64 $0 to ptr\nret ptr %r")
    (closure-env p) a b c d))
(defn call-closure--5 [(p i64) (a i64) (b i64) (c i64) (d i64) (e i64)] (-> i64)
  (primitive/call-ptr
    (primitive/llvm-ir (fnptr c [i64 i64 i64 i64 i64 i64] i64) [(procedure-code p)]
                       "%r = inttoptr i64 $0 to ptr\nret ptr %r")
    (closure-env p) a b c d e))
(defn call-closure--6 [(p i64) (a i64) (b i64) (c i64) (d i64) (e i64) (f i64)] (-> i64)
  (primitive/call-ptr
    (primitive/llvm-ir (fnptr c [i64 i64 i64 i64 i64 i64 i64] i64) [(procedure-code p)]
                       "%r = inttoptr i64 $0 to ptr\nret ptr %r")
    (closure-env p) a b c d e f))

(defn call-once--1 [(p i64) (x i64)] (-> i64)
  (if (is-continuation p) (scm-continuation-transfer p x)
  (if (reducer? p) (scm-reduce p (cons x (s-nil)))
  (if (list-procedure? p) (call-list-procedure p (cons x (s-nil)))
  (if (variadic-closure? p)
      (call-variadic-list p (cons x (s-nil)) 1)
    (if (not (= (procedure-arity p) 1)) (s-unspecified)
    (if (is-closure p) (call-closure--1 p x)
    (primitive/call-ptr
      (primitive/llvm-ir (fnptr c [i64] i64) [(procedure-code p)]
                         "%r = inttoptr i64 $0 to ptr\nret ptr %r")
      x))))))))
(defn call-once--2 [(p i64) (x i64) (y i64)] (-> i64)
  (if (reducer? p) (scm-reduce p (cons x (cons y (s-nil))))
  (if (list-procedure? p) (call-list-procedure p (cons x (cons y (s-nil))))
  (if (variadic-closure? p)
      (call-variadic-list p (cons x (cons y (s-nil))) 2)
    (if (not (= (procedure-arity p) 2)) (s-unspecified)
    (if (is-closure p) (call-closure--2 p x y)
    (primitive/call-ptr
      (primitive/llvm-ir (fnptr c [i64 i64] i64) [(procedure-code p)]
                         "%r = inttoptr i64 $0 to ptr\nret ptr %r")
      x y)))))))
(defn call-once--3 [(p i64) (x i64) (y i64) (z i64)] (-> i64)
  (if (reducer? p) (scm-reduce p (cons x (cons y (cons z (s-nil)))))
  (if (list-procedure? p) (call-list-procedure p (cons x (cons y (cons z (s-nil)))))
  (if (variadic-closure? p)
      (call-variadic-list p (cons x (cons y (cons z (s-nil)))) 3)
    (if (not (= (procedure-arity p) 3)) (s-unspecified)
    (if (is-closure p) (call-closure--3 p x y z)
    (primitive/call-ptr
      (primitive/llvm-ir (fnptr c [i64 i64 i64] i64) [(procedure-code p)]
                         "%r = inttoptr i64 $0 to ptr\nret ptr %r")
      x y z)))))))
(defn call-once--4 [(p i64) (a i64) (b i64) (c i64) (d i64)] (-> i64)
  (if (reducer? p)
      (scm-reduce p (cons a (cons b (cons c (cons d (s-nil))))))
  (if (list-procedure? p)
      (call-list-procedure p (cons a (cons b (cons c (cons d (s-nil))))))
  (if (variadic-closure? p)
      (call-variadic-list p (cons a (cons b (cons c (cons d (s-nil))))) 4)
    (if (not (= (procedure-arity p) 4)) (s-unspecified)
      (call-closure--4 p a b c d))))))
(defn call-once--5 [(p i64) (a i64) (b i64) (c i64) (d i64) (e i64)] (-> i64)
  (if (reducer? p)
      (scm-reduce p (cons a (cons b (cons c (cons d (cons e (s-nil)))))))
  (if (list-procedure? p)
      (call-list-procedure p (cons a (cons b (cons c (cons d (cons e (s-nil)))))))
  (if (variadic-closure? p)
      (call-variadic-list p (cons a (cons b (cons c (cons d (cons e (s-nil)))))) 5)
    (if (not (= (procedure-arity p) 5)) (s-unspecified)
      (call-closure--5 p a b c d e))))))
(defn call-once--6 [(p i64) (a i64) (b i64) (c i64) (d i64) (e i64) (f i64)] (-> i64)
  (if (reducer? p)
      (scm-reduce
        p (cons a (cons b (cons c (cons d (cons e (cons f (s-nil))))))))
  (if (list-procedure? p)
      (call-list-procedure
        p (cons a (cons b (cons c (cons d (cons e (cons f (s-nil))))))))
  (if (variadic-closure? p)
      (call-variadic-list
        p (cons a (cons b (cons c (cons d (cons e (cons f (s-nil))))))) 6)
    (if (not (= (procedure-arity p) 6)) (s-unspecified)
      (call-closure--6 p a b c d e f))))))

;; Apply a procedure to an argument LIST — the shape `apply`, `map` and
;; `call-with-values` all need. Dispatching on the stored arity is what makes an
;; indirect call type-safe here: the pointer is re-typed to match the arity the
;; wrap site declared, so a wrong-arity call is a detected error rather than a
;; corrupt stack.
(defn scm-apply-dispatch [(p i64) (args i64)] (-> i64)
  ; a reducer folds over however many arguments it is given, so it is dispatched
  ; before any arity comparison — that is what makes `(apply + 1 2 '(3 4))` work
  (if (not (is-procedure p)) (apply-type-fail)
  (if (reducer? p) (scm-reduce p args)
  (if (list-procedure? p) (call-list-procedure p args)
    (let [n (list--length args 0) a (procedure-arity p)]
      (if (fixed-list-closure? p) (call-fixed-list p args n)
      (if (variadic-closure? p) (call-variadic-list p args n)
      (if (not (= n a)) (s-unspecified)
        (if (= n 0) (call-once--0 p)
        (if (= n 1) (call-once--1 p (car args))
          (if (= n 2) (call-once--2 p (car args) (scm-cadr args))
            (if (= n 3) (call-once--3 p (car args) (scm-cadr args) (scm-caddr args))
              (if (= n 4) (call-once--4 p (car args) (scm-cadr args) (scm-caddr args)
                                      (car (cdr (cdr (cdr args)))))
                (if (= n 5) (call-once--5 p (car args) (scm-cadr args) (scm-caddr args)
                                        (car (cdr (cdr (cdr args))))
                                        (car (cdr (cdr (cdr (cdr args))))))
                  (if (= n 6) (call-once--6 p (car args) (scm-cadr args) (scm-caddr args)
                                          (car (cdr (cdr (cdr args))))
                                          (car (cdr (cdr (cdr (cdr args)))))
                                          (car (cdr (cdr (cdr (cdr (cdr args)))))))
                    (s-unspecified))))))))))))))))

(defn scm-apply-list [(p i64) (args i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root p) (gc-root args)
    (let [out (tail-run (scm-apply-dispatch p args))]
      (gc-sp-set! sp)
      out)))

;; R5RS `(apply f a b … list)`: the leading arguments are ordinary, and only the
;; LAST is spread. Prepending the fixed arguments onto the final list is the whole
;; of it.
(defn scm-apply1 [(p i64) (l i64)] (-> i64) (scm-apply-list p l))
(defn scm-apply2 [(p i64) (x i64) (l i64)] (-> i64)
  (scm-apply-list p (cons x l)))
(defn scm-apply3 [(p i64) (x i64) (y i64) (l i64)] (-> i64)
  (scm-apply-list p (cons x (cons y l))))

;; `map` over one or two lists. R5RS: with several lists the result is as long as
;; the SHORTEST, and the order in which the procedure is applied is unspecified —
;; so nothing here may depend on it, and nothing does.
;; Both go through `scm-apply-list` rather than calling `call--n` directly, so a
;; reducer like `+` behaves the same here as under `apply` — `(map + xs ys)` folds
;; each pair instead of hitting an arity check it was never going to satisfy.
(defn scm-map1 [(p i64) (l i64)] (-> i64)
  (if (is-null l) (s-nil)
    (let [sp (gc-sp)]
      (gc-root p) (gc-root l)
      (let [args (cons (car l) (s-nil))]
        (gc-root args)
        (let [mapped (scm-apply-list p args)]
          (gc-root mapped)
          (let [tail (scm-map1 p (cdr l))]
            (gc-root tail)
            (let [out (cons mapped tail)]
              (gc-sp-set! sp) (gc-root out) out)))))))
(defn scm-map2 [(p i64) (a i64) (b i64)] (-> i64)
  (if (or (is-null a) (is-null b)) (s-nil)     ; stops at the shorter list
    (let [sp (gc-sp)]
      (gc-root p) (gc-root a) (gc-root b)
      (let [args (cons (car a) (cons (car b) (s-nil)))]
        (gc-root args)
        (let [mapped (scm-apply-list p args)]
          (gc-root mapped)
          (let [tail (scm-map2 p (cdr a) (cdr b))]
            (gc-root tail)
            (let [out (cons mapped tail)]
              (gc-sp-set! sp) (gc-root out) out)))))))

;; General multi-list map support. The list of input lists advances as one
;; column: stop when any input is empty, apply to the current cars, then recurse
;; over the cdrs. This removes a call-site arity table from the R5RS surface.
(defn lists--any-null? [(lists i64)] (-> bool)
  (if (is-null lists) false
    (or (is-null (car lists)) (lists--any-null? (cdr lists)))))
(defn lists--cars [(lists i64)] (-> i64)
  (if (is-null lists) (s-nil)
    (let [sp (gc-sp)]
      (gc-root lists)
      (let [tail (lists--cars (cdr lists))]
        (gc-root tail)
        (let [out (cons (car (car lists)) tail)]
          (gc-sp-set! sp) (gc-root out) out)))))
(defn lists--cdrs [(lists i64)] (-> i64)
  (if (is-null lists) (s-nil)
    (let [sp (gc-sp)]
      (gc-root lists)
      (let [tail (lists--cdrs (cdr lists))]
        (gc-root tail)
        (let [out (cons (cdr (car lists)) tail)]
          (gc-sp-set! sp) (gc-root out) out)))))
(defn scm-map-n [(p i64) (lists i64)] (-> i64)
  (if (lists--any-null? lists) (s-nil)
    (let [sp (gc-sp)]
      (gc-root p) (gc-root lists)
      (let [args (lists--cars lists)]
        (gc-root args)
        (let [next (lists--cdrs lists)]
          (gc-root next)
          (let [mapped (scm-apply-list p args)]
            (gc-root mapped)
            (let [tail (scm-map-n p next)]
              (gc-root tail)
              (let [out (cons mapped tail)]
                (gc-sp-set! sp) (gc-root out) out))))))))

;; `for-each` is `map` with the result discarded, and R5RS DOES specify its order:
;; left to right. So this one is a loop with a defined sequence, unlike `map`.
(defn scm-for-each1 [(p i64) (l i64)] (-> i64)
  (if (is-null l) (s-unspecified)
    (let [sp (gc-sp)]
      (gc-root p) (gc-root l)
      (let [args (cons (car l) (s-nil))]
        (gc-root args)
        (scm-apply-list p args)
        (let [out (scm-for-each1 p (cdr l))]
          (gc-sp-set! sp) out)))))
(defn scm-for-each2 [(p i64) (a i64) (b i64)] (-> i64)
  (if (or (is-null a) (is-null b)) (s-unspecified)
    (let [sp (gc-sp)]
      (gc-root p) (gc-root a) (gc-root b)
      (let [args (cons (car a) (cons (car b) (s-nil)))]
        (gc-root args)
        (scm-apply-list p args)
        (let [out (scm-for-each2 p (cdr a) (cdr b))]
          (gc-sp-set! sp) out)))))
(defn scm-for-each-n [(p i64) (lists i64)] (-> i64)
  (if (lists--any-null? lists) (s-unspecified)
    (let [sp (gc-sp)]
      (gc-root p) (gc-root lists)
      (let [args (lists--cars lists)]
        (gc-root args)
        (let [next (lists--cdrs lists)]
          (gc-root next)
          (scm-apply-list p args)
          (let [out (scm-for-each-n p next)]
            (gc-sp-set! sp) out))))))

;; `call-with-values`: run the producer, unpack whatever it returned, and apply the
;; consumer to those values. A lone value unpacks to a one-element list, so a
;; producer that never called `values` works unchanged.
(defn scm-call-with-values [(producer i64) (consumer i64)] (-> i64)
  (scm-apply-list consumer (values-contents (call--0 producer))))
(defn scm-tail-call-with-values [(producer i64) (consumer i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root producer) (gc-root consumer)
    (let [produced (call--0 producer)]
      (gc-root produced)
      (let [args (values-contents produced)]
        (gc-root args)
        (let [out (scm-tail-request-list consumer args)]
          (gc-sp-set! sp) out)))))
(defn call-once--0 [(p i64)] (-> i64)
  (if (reducer? p) (scm-reduce p (s-nil))
  (if (list-procedure? p) (call-list-procedure p (s-nil))
  (if (variadic-closure? p)
      (call-variadic-list p (s-nil) 0)
    (if (not (= (procedure-arity p) 0)) (s-unspecified)
    (if (is-closure p) (call-closure--0 p)
    (primitive/call-ptr
      (primitive/llvm-ir (fnptr c [] i64) [(procedure-code p)]
                         "%r = inttoptr i64 $0 to ptr\nret ptr %r"))))))))

;; A computed tail call returns a traced request. The nearest ordinary dynamic
;; call boundary consumes requests in `tail-run`, whose self recursion is native
;; musttail and therefore constant-stack.
(defn scm-tail-request-list [(p i64) (args i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root p) (gc-root args)
    (let [out (allocate (tag-tail-call) p args 0)]
      (gc-sp-set! sp)
      out)))
(defn tail-call-proc [(v i64)] (-> i64)
  (primitive/load (primitive/field (obj-of v) a)))
(defn tail-call-args [(v i64)] (-> i64)
  (primitive/load (primitive/field (obj-of v) b)))
(defn tail-call-request? [(v i64)] (-> bool)
  ;; A native procedure may return an aligned raw i64 (including zero).  Its low
  ;; bits look heap-tagged, so do not inspect an object header until the allocator
  ;; confirms that the address belongs to a Scheme heap slab.
  (and (is-heap v)
       (not (= v 0))
       (managed-address? v)
       (= (obj-tag v) (tag-tail-call))))
(defn tail-run [(v i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root v)
    (if (tail-call-request? v)
        (let [p (tail-call-proc v) args (tail-call-args v)]
          (gc-root p) (gc-root args)
          (let [next (scm-apply-dispatch p args)]
            (gc-sp-set! sp)
            (tail-run next)))
      (do (gc-sp-set! sp) v))))

(defn call--0 [(p i64)] (-> i64) (tail-run (call-once--0 p)))
(defn call--1 [(p i64) (x i64)] (-> i64) (tail-run (call-once--1 p x)))
(defn call--2 [(p i64) (x i64) (y i64)] (-> i64) (tail-run (call-once--2 p x y)))
(defn call--3 [(p i64) (x i64) (y i64) (z i64)] (-> i64)
  (tail-run (call-once--3 p x y z)))
(defn call--4 [(p i64) (a i64) (b i64) (c i64) (d i64)] (-> i64)
  (tail-run (call-once--4 p a b c d)))
(defn call--5 [(p i64) (a i64) (b i64) (c i64) (d i64) (e i64)] (-> i64)
  (tail-run (call-once--5 p a b c d e)))
(defn call--6 [(p i64) (a i64) (b i64) (c i64) (d i64) (e i64) (f i64)] (-> i64)
  (tail-run (call-once--6 p a b c d e f)))

;; Dynamic-wind transfer is kept at the compiled procedure-dispatch layer.  The
;; native continuation runtime owns only stack/root state; calling before/after
;; thunks uses the same first-class compiled closure ABI as every other Scheme
;; higher-order operation.
(defn scm-wind-depth [(w i64)] (-> i64)
  (if (is-null w) 0 (+ 1 (scm-wind-depth (continuation-wind-parent w)))))

(defn scm-wind-common [(a i64) (ad i64) (b i64) (bd i64)] (-> i64)
  (if (val-eq? a b) a
    (if (> ad bd)
        (scm-wind-common (continuation-wind-parent a) (- ad 1) b bd)
      (if (> bd ad)
          (scm-wind-common a ad (continuation-wind-parent b) (- bd 1))
        (scm-wind-common (continuation-wind-parent a) (- ad 1)
                         (continuation-wind-parent b) (- bd 1))))))

(defn scm-wind-leave-to [(w i64) (common i64)] (-> i64)
  (if (val-eq? w common) 0
    (do (call--0 (continuation-wind-after w))
        (continuation-wind-set-current! (continuation-wind-parent w))
        (scm-wind-leave-to (continuation-wind-parent w) common))))

(defn scm-wind-enter-from [(target i64) (common i64)] (-> i64)
  (if (val-eq? target common) 0
    (do (scm-wind-enter-from (continuation-wind-parent target) common)
        (call--0 (continuation-wind-before target))
        (continuation-wind-set-current! target)
        0)))

(defn scm-continuation-transfer [(k i64) (value i64)] (-> i64)
  (let [current (continuation-current-winds)
        target (continuation-target-winds k)
        common (scm-wind-common current (scm-wind-depth current)
                                target (scm-wind-depth target))]
    (scm-wind-leave-to current common)
    (scm-wind-enter-from target common)
    (continuation-invoke k value)))

(defn scm-dynamic-wind [(before i64) (thunk i64) (after i64)] (-> i64)
  (call--0 before)
  (let [frame (continuation-wind-push before after)
        result (call--0 thunk)]
    (continuation-wind-set-current! (continuation-wind-parent frame))
    (call--0 after)
    result))
(defn fnptr0->i64 [(f (fnptr c [] i64))] (-> i64)
  (primitive/llvm-ir i64 [f] "%r = ptrtoint $t0 $0 to i64\nret i64 %r"))
(defn fnptr0 [(f Code)] (-> Code) `(fnptr0->i64 (primitive/fnptr-of ~f)))

; ---- predicates -------------------------------------------------------------
(defn scm-number? [(v i64)] (-> i64) (mk-bool (is-fixnum v)))
(defn scm-symbol? [(v i64)] (-> i64) (mk-bool (is-symbol v)))
(defn scm-procedure? [(v i64)] (-> i64) (mk-bool (is-procedure v)))
(defn scm-boolean? [(v i64)] (-> i64)
  (mk-bool (or (val-eq? v (s-true)) (val-eq? v (s-false)))))
(defn scm-not [(v i64)] (-> i64) (mk-bool (not (truthy? v))))

; ---- multiple values --------------------------------------------------------
;; `values` packages its arguments into a `tag-values` object holding the list, and
;; `call-with-values` unpacks it. R5RS §6.4 allows exactly this: the only thing a
;; producer's result may be passed to is a consumer, so the package never escapes
;; into ordinary value context — and a single value is NOT wrapped, because
;; `(values x)` must be indistinguishable from `x`.
(defn scm-values-list [(l i64)] (-> i64)
  (if (and (is-pair l) (is-null (cdr l))) (car l)
    (allocate (tag-values) l 0 0)))
(defn values-package? [(v i64)] (-> bool) (has-tag? v (tag-values)))
(defn values-contents [(v i64)] (-> i64)
  (if (values-package? v) (primitive/load (primitive/field (obj-of v) a))
    ; a lone value is its own one-element argument list
    (cons v (s-nil))))

; ---- write ------------------------------------------------------------------
;; `write` is the machine-readable printer and is genuinely different from
;; `display`: a string comes back with quotes and a character as `#\a`, so the
;; output can be read back in. core.coil noted the distinction and did not make it;
;; this is it.
;;
;; The 09 case depends on this precisely: `("abc" 3 "bc")` is what `write` prints
;; and `display` would print `(abc 3 bc)`. The cases README flags nested strings
;; under `display` as a place conforming Schemes legitimately diverge, which is why
;; the case uses `write` and why this had to exist before the case could pass.
(defn write-char-name [(w (ptr Writer)) (n i64)] (-> i64)
  ; R5RS names exactly two characters; everything else prints as the glyph
  (if (= n 32) (do (fmt w "#\\space") 0)
    (if (= n 10) (do (fmt w "#\\newline") 0)
      (do (fmt w "#\\{c}" n) 0))))

(defn write--str [(w (ptr Writer)) (s i64)] (-> i64)
  (fmt w "\"")
  (for [i 0 (string-length-raw s)]
    (let [c (string-code s i)]
      ; a quote or backslash inside a string must be escaped, or the output does
      ; not read back as the same string
      (if (= c 34) (do (fmt w "\\\"") 0)
        (if (= c 92) (do (fmt w "\\\\") 0)
          (do (fmt w "{c}" c) 0)))))
  (fmt w "\"")
  0)

(defn scm-write [(v i64)] (-> i64) (write--val (stdout) v))

(defn write--val [(w (ptr Writer)) (v i64)] (-> i64)
  (if (is-string v) (write--str w v)
    (if (is-char v) (write-char-name w (char-value v))
      (if (is-pair v) (do (fmt w "(") (write--list w v) (fmt w ")") 0)
        (if (is-vector v) (do (fmt w "#(") (write--vec w v 0 (vector-length-raw v)) (fmt w ")") 0)
          ; everything else has one external representation, so display's is right
          (display--atom w v))))))

(defn write--list [(w (ptr Writer)) (v i64)] (-> i64)
  (write--val w (car v))
  (let [d (cdr v)]
    (if (is-null d) 0
      (if (is-pair d) (do (fmt w " ") (write--list w d) 0)
        (do (fmt w " . ") (write--val w d) 0)))))

(defn write--vec [(w (ptr Writer)) (v i64) (i i64) (n i64)] (-> i64)
  (if (>= i n) 0
    (do (if (> i 0) (do (fmt w " ") 0) 0)
        (write--val w (scm-vector-ref v (mk-fixnum i)))
        (write--vec w v (+ i 1) n))))

;; The shapes with a single external representation — no quoting decision to make,
;; so `display` and `write` agree and share this.
(defn display--limb9 [(w (ptr Writer)) (n i64)] (-> i64)
  (do
    (if (< n 100000000) (do (fmt w "0") 0) 0)
    (if (< n 10000000) (do (fmt w "0") 0) 0)
    (if (< n 1000000) (do (fmt w "0") 0) 0)
    (if (< n 100000) (do (fmt w "0") 0) 0)
    (if (< n 10000) (do (fmt w "0") 0) 0)
    (if (< n 1000) (do (fmt w "0") 0) 0)
    (if (< n 100) (do (fmt w "0") 0) 0)
    (if (< n 10) (do (fmt w "0") 0) 0)
    (fmt w "{d}" n) 0))
(defn display--big-limbs [(w (ptr Writer)) (xs i64)] (-> i64)
  (let [rest (cdr xs) n (fixnum-value (car xs))]
    (if (is-null rest) (do (fmt w "{d}" n) 0)
      (do (display--big-limbs w rest) (display--limb9 w n) 0))))
(defn display--bignum [(w (ptr Writer)) (v i64)] (-> i64)
  (do (if (< (big-sign v) 0) (do (fmt w "-") 0) 0)
      (display--big-limbs w (big-limbs v)) 0))

(defn display--flonum-has-marker? [(s (slice u8)) (i i64)] (-> bool)
  (if (>= i (slice-len s)) false
    (let [c (primitive/cast i64 (slice-get [u8] s i))]
      (or (= c 46) (or (= c 101) (or (= c 69)
          (display--flonum-has-marker? s (+ i 1))))))))
(defn display--flonum [(w (ptr Writer)) (v i64)] (-> i64)
  (let [buf (alloc/stack (array u8 64))
        n0 (snprintf (primitive/cast (ptr i8) buf) 64 c"%.17g" (flonum-value v))
        first (slice-new [u8] (primitive/cast (ptr u8) buf) (primitive/cast i64 n0))
        n (if (display--flonum-has-marker? first 0) n0
              (snprintf (primitive/cast (ptr i8) buf) 64 c"%.17g.0" (flonum-value v)))]
    (print-str w (slice-new [u8] (primitive/cast (ptr u8) buf)
                            (primitive/cast i64 n)))
    0))

(defn display--atom [(w (ptr Writer)) (v i64)] (-> i64)
  (if (is-fixnum v) (do (fmt w "{d}" (fixnum-value v)) 0)
    (if (is-bignum v) (display--bignum w v)
    (if (is-ratnum v)
        (do (display--atom w (ratnum-numerator-val v))
            (fmt w "/")
            (display--atom w (ratnum-denominator-val v)) 0)
    (if (is-complex-number v)
        (let [r (complex-real v) i (complex-imag v)]
          (display--atom w r)
          (if (primitive/fcmp-lt (core-number->f64 i) 0.0)
              (display--atom w i)
            (do (fmt w "+") (display--atom w i) 0))
          (fmt w "i")
          0)
    (if (is-flonum v) (display--flonum w v)
      (if (val-eq? v (s-true)) (do (fmt w "#t") 0)
        (if (val-eq? v (s-false)) (do (fmt w "#f") 0)
          (if (is-null v) (do (fmt w "()") 0)
            (if (is-symbol v) (do (fmt w "{s}" (symbol-name v)) 0)
              (if (is-procedure v) (do (fmt w "#<procedure>") 0)
                (do (fmt w "#<object>") 0))))))))))))

;; `display` differs from `write` in exactly two places — strings lose their
;; quotes and characters print as themselves — and is otherwise the same walk.
;; core.coil's `scm-display` predates strings and vectors; this one handles them,
;; and printing a vector is required by the 09 case's `(list->vector '(3 4))`.
(defn scm-display2 [(v i64)] (-> i64) (display--val (stdout) v))

(defn display--val [(w (ptr Writer)) (v i64)] (-> i64)
  (if (is-string v)
      (do (for [i 0 (string-length-raw v)]
            (fmt w "{c}" (string-code v i)))
          0)
    (if (is-char v) (do (fmt w "{c}" (char-value v)) 0)
      (if (is-pair v) (do (fmt w "(") (display--list w v) (fmt w ")") 0)
        (if (is-vector v) (do (fmt w "#(") (display--vec w v 0 (vector-length-raw v)) (fmt w ")") 0)
          (display--atom w v))))))

(defn display--list [(w (ptr Writer)) (v i64)] (-> i64)
  (display--val w (car v))
  (let [d (cdr v)]
    (if (is-null d) 0
      (if (is-pair d) (do (fmt w " ") (display--list w d) 0)
        (do (fmt w " . ") (display--val w d) 0)))))

(defn display--vec [(w (ptr Writer)) (v i64) (i i64) (n i64)] (-> i64)
  (if (>= i n) 0
    (do (if (> i 0) (do (fmt w " ") 0) 0)
        (display--val w (scm-vector-ref v (mk-fixnum i)))
        (display--vec w v (+ i 1) n))))

; =============================================================================
; THE R5RS SPELLINGS
; =============================================================================
;; Everything above is named `scm-…`, and a Scheme programmer does not write
;; `(scm-cadr x)`. These are the same procedures under the names R5RS actually
;; gives them: one-line forwarders, no behaviour of their own, so there is
;; exactly one implementation of each and the alias cannot drift from it.
;;
;; They are ordinary `defn`s, so `coil.scheme`'s `:reexport` carries them to
;; every client module, and the dialect's whole-tree pass never has to know
;; these names exist — a call to `cadr` is an ordinary call the pass rewrites
;; the arguments of, exactly like a call to `scm-cadr`.
;;
;; ⚠ WHY THE FORWARDERS LIVE AT THE END OF THE FILE, AND NOT NEXT TO WHAT THEY
;;   FORWARD TO. A `defn` binds its name for the WHOLE module, not from its
;;   position onward, so `(defn cadr …)` anywhere in this file would be visible
;;   to every earlier definition too. That is harmless for `cadr` and fatal for
;;   the type predicates — see below. Keeping them in one block at the end is
;;   what makes the danger a single reviewable place rather than a property of
;;   wherever each one happened to be written.

; ---- pairs and lists ---------------------------------------------------------
(defn caar [(v i64)] (-> i64) (scm-caar v))
(defn cadr [(v i64)] (-> i64) (scm-cadr v))
(defn cdar [(v i64)] (-> i64) (scm-cdar v))
(defn cddr [(v i64)] (-> i64) (scm-cddr v))
(defn caddr [(v i64)] (-> i64) (scm-caddr v))
(defn cdddr [(v i64)] (-> i64) (scm-cdddr v))
(defn caadr [(v i64)] (-> i64) (scm-caadr v))
(defn cddar [(v i64)] (-> i64) (scm-cddar v))
(defn cadar [(v i64)] (-> i64) (scm-cadar v))
(defn cdadr [(v i64)] (-> i64) (scm-cdadr v))
(defn cadddr [(v i64)] (-> i64) (scm-cadddr v))
(defn caaar [(v i64)] (-> i64) (scm-caaar v))
(defn cdaar [(v i64)] (-> i64) (scm-cdaar v))
(defn caaaar [(v i64)] (-> i64) (scm-caaaar v))
(defn caaadr [(v i64)] (-> i64) (scm-caaadr v))
(defn caadar [(v i64)] (-> i64) (scm-caadar v))
(defn caaddr [(v i64)] (-> i64) (scm-caaddr v))
(defn cadaar [(v i64)] (-> i64) (scm-cadaar v))
(defn cadadr [(v i64)] (-> i64) (scm-cadadr v))
(defn caddar [(v i64)] (-> i64) (scm-caddar v))
(defn cdaaar [(v i64)] (-> i64) (scm-cdaaar v))
(defn cdaadr [(v i64)] (-> i64) (scm-cdaadr v))
(defn cdadar [(v i64)] (-> i64) (scm-cdadar v))
(defn cdaddr [(v i64)] (-> i64) (scm-cdaddr v))
(defn cddaar [(v i64)] (-> i64) (scm-cddaar v))
(defn cddadr [(v i64)] (-> i64) (scm-cddadr v))
(defn cdddar [(v i64)] (-> i64) (scm-cdddar v))
(defn cddddr [(v i64)] (-> i64) (scm-cddddr v))

(defn length [(l i64)] (-> i64) (scm-length l))
(defn reverse [(l i64)] (-> i64) (scm-reverse l))
(defn list-tail [(l i64) (k i64)] (-> i64) (scm-list-tail l k))
(defn list-ref [(l i64) (k i64)] (-> i64) (scm-list-ref l k))
(defn list? [(l i64)] (-> i64) (scm-list? l))

;; ⚠ BINARY, where R5RS's is variadic. forms.coil collects surplus arguments at
;; the call site only for procedures it saw `define`d with a dotted signature in
;; the CALLING module; a forwarder defined here is an ordinary fixed-arity Coil
;; function, so `(append '(1) '(2) '(3 4))` is an arity error rather than a
;; three-way append. Right-nesting is what a left-to-right variadic append
;; means, and it is what a call site has to write: `(append a (append b c))`.
;; The name is still worth binding — two-argument `append` is overwhelmingly the
;; common case, and the alternative is that the R5RS spelling does not exist.
(defn append [(a i64) (b i64)] (-> i64) (scm-append a b))

; ---- equivalence and search --------------------------------------------------
(defn eq? [(a i64) (b i64)] (-> i64) (scm-eq? a b))
(defn eqv? [(a i64) (b i64)] (-> i64) (scm-eqv? a b))
(defn equal? [(a i64) (b i64)] (-> i64) (scm-equal? a b))

(defn memq [(x i64) (l i64)] (-> i64) (scm-memq x l))
(defn memv [(x i64) (l i64)] (-> i64) (scm-memv x l))
(defn member [(x i64) (l i64)] (-> i64) (scm-member x l))
(defn assq [(x i64) (l i64)] (-> i64) (scm-assq x l))
(defn assv [(x i64) (l i64)] (-> i64) (scm-assv x l))
(defn assoc [(x i64) (l i64)] (-> i64) (scm-assoc x l))

; ---- strings -----------------------------------------------------------------
(defn string-length [(s i64)] (-> i64) (scm-string-length s))
(defn string-ref [(s i64) (i i64)] (-> i64) (scm-string-ref s i))
(defn string-set! [(s i64) (i i64) (c i64)] (-> i64) (scm-string-set! s i c))
(defn string-copy [(s i64)] (-> i64) (scm-string-copy s))
(defn string-fill! [(s i64) (c i64)] (-> i64) (scm-string-fill! s c))
;; binary for the same reason `append` is
(defn string-append [(a i64) (b i64)] (-> i64) (scm-string-append a b))
(defn substring [(s i64) (start i64) (end i64)] (-> i64) (scm-substring s start end))
(defn string->list [(s i64)] (-> i64) (scm-string->list s))
(defn list->string [(l i64)] (-> i64) (scm-list->string l))
(defn string->symbol [(s i64)] (-> i64) (scm-string->symbol s))
(defn symbol->string [(v i64)] (-> i64) (scm-symbol->string v))
(defn string=? [(a i64) (b i64)] (-> i64) (scm-string=? a b))
(defn string<? [(a i64) (b i64)] (-> i64) (scm-string<? a b))
(defn string>? [(a i64) (b i64)] (-> i64) (scm-string>? a b))
(defn string<=? [(a i64) (b i64)] (-> i64) (scm-string<=? a b))
(defn string>=? [(a i64) (b i64)] (-> i64) (scm-string>=? a b))
(defn string-ci=? [(a i64) (b i64)] (-> i64) (scm-string-ci=? a b))
(defn string-ci<? [(a i64) (b i64)] (-> i64) (scm-string-ci<? a b))
(defn string-ci>? [(a i64) (b i64)] (-> i64) (scm-string-ci>? a b))
(defn string-ci<=? [(a i64) (b i64)] (-> i64) (scm-string-ci<=? a b))
(defn string-ci>=? [(a i64) (b i64)] (-> i64) (scm-string-ci>=? a b))

; ---- characters --------------------------------------------------------------
(defn char->integer [(c i64)] (-> i64) (scm-char->integer c))
(defn integer->char [(n i64)] (-> i64) (scm-integer->char n))
(defn char-upcase [(c i64)] (-> i64) (scm-char-upcase c))
(defn char-downcase [(c i64)] (-> i64) (scm-char-downcase c))
(defn char=? [(a i64) (b i64)] (-> i64) (scm-char=? a b))
(defn char<? [(a i64) (b i64)] (-> i64) (scm-char<? a b))
(defn char>? [(a i64) (b i64)] (-> i64) (scm-char>? a b))
(defn char<=? [(a i64) (b i64)] (-> i64) (scm-char<=? a b))
(defn char>=? [(a i64) (b i64)] (-> i64) (scm-char>=? a b))
(defn char-ci=? [(a i64) (b i64)] (-> i64) (scm-char-ci=? a b))
(defn char-ci<? [(a i64) (b i64)] (-> i64) (scm-char-ci<? a b))
(defn char-ci>? [(a i64) (b i64)] (-> i64) (scm-char-ci>? a b))
(defn char-ci<=? [(a i64) (b i64)] (-> i64) (scm-char-ci<=? a b))
(defn char-ci>=? [(a i64) (b i64)] (-> i64) (scm-char-ci>=? a b))
(defn char-alphabetic? [(c i64)] (-> i64) (scm-char-alphabetic? c))
(defn char-numeric? [(c i64)] (-> i64) (scm-char-numeric? c))
(defn char-whitespace? [(c i64)] (-> i64) (scm-char-whitespace? c))
(defn char-upper-case? [(c i64)] (-> i64) (scm-char-upper-case? c))
(defn char-lower-case? [(c i64)] (-> i64) (scm-char-lower-case? c))

; ---- vectors -----------------------------------------------------------------
(defn make-vector [(n i64)] (-> i64) (scm-make-vector n))
(defn vector-length [(v i64)] (-> i64) (scm-vector-length v))
(defn vector-ref [(v i64) (i i64)] (-> i64) (scm-vector-ref v i))
(defn vector-set! [(v i64) (i i64) (x i64)] (-> i64) (scm-vector-set! v i x))
(defn vector-fill! [(v i64) (x i64)] (-> i64) (scm-vector-fill! v x))
(defn vector->list [(v i64)] (-> i64) (scm-vector->list v))
(defn list->vector [(l i64)] (-> i64) (scm-list->vector l))

; ---- predicates and output ---------------------------------------------------
;; `number?` is bindable and the other five type predicates are NOT — see the
;; block at the bottom of this file for exactly why, name by name.
(defn number? [(v i64)] (-> i64) (scm-number? v))
(defn boolean? [(v i64)] (-> i64) (scm-boolean? v))
(defn write [(v i64)] (-> i64) (scm-write v))

; ---- procedures as values ----------------------------------------------------
;; The one-list / one-procedure arities, which are what R5RS's names denote when
;; given the usual number of arguments. `scm-map2`, `scm-for-each2`, `scm-apply2`
;; and `scm-apply3` stay under their arity-explicit names: R5RS spells all four
;; `map` / `for-each` / `apply`, and one Coil name cannot mean four arities.
(defn map [(p i64) (l i64)] (-> i64) (scm-map1 p l))
(defn for-each [(p i64) (l i64)] (-> i64) (scm-for-each1 p l))
(defn apply [(p i64) (l i64)] (-> i64) (scm-apply1 p l))
(defn call-with-values [(producer i64) (consumer i64)] (-> i64)
  (scm-call-with-values producer consumer))

; =============================================================================
;; WHAT CANNOT BE BOUND HERE, AND WHY — each of these was tried and reverted.
;;
;; 1. `is-string` `is-vector` `is-char` `is-procedure` `is-null` `is-pair` `is-symbol`
;;    value.coil ALREADY binds every one of them, as an internal predicate
;;    returning a raw `bool`. Scheme's must return a Val. A `defn` binds its name
;;    for the whole module, so adding `(defn is-string …)` here does not add a
;;    second binding — it REPLACES value.coil's for every earlier line in this
;;    file, and `scm-string?`'s own body stops compiling:
;;
;;      argument 1 to 'mk-bool' has type i64 but expected bool
;;
;;    `is-null` and `is-pair` fail one step further out, inside `scm-map2` and
;;    `equal--p`, as "if branches on different types (bool vs i64)" — the same
;;    collision reaching a different use. These names are reachable only by
;;    renaming value.coil's predicates, which is a change to a file this round
;;    does not own; until then the Scheme spelling is `scm-string?` and friends.
;;
;; 2. `not` — a Coil BUILT-IN FORM. The compiler rejects the definition outright:
;;    "cannot define 'not': it is a built-in form and can never be called as
;;    (not …)". Same class as `let` / `and` / `or` / `if` / `do` / `quote`.
;;
;; 3. `list` `display` `newline` `+` `-` `*` `<` `>` `=` — forms.coil already
;;    binds these as MACROS, which is what makes them variadic and what lifts
;;    their literal arguments. A `defn` here would shadow a strictly better
;;    binding.
;;
;; 4. `car` `cdr` `cons` `set-car!` `set-cdr!` (heap.coil), `begin` `cond`
;;    `when` `unless` `let*` (derived.coil), `letrec` `force` (derived2.coil),
;;    `define` (core.coil), `number->string` `string->number` (numeric.coil) —
;;    already bound under their R5RS spellings by the module that owns them.
;;    ⚠ A duplicate here does NOT produce an error: it silently shadows, and
;;    `coil.scheme`'s `:reexport` then hands clients whichever this file defines.
;;    Verified with `force`: a stub added here compiled and ran, quietly
;;    replacing derived2's real one. Absence of a compiler complaint is not
;;    evidence a name is free.
;;
;; 5. `vector` `string` `values` — bindable, and deliberately not bound. All
;;    three are variadic CONSTRUCTORS in R5RS; a fixed-arity forwarder would
;;    accept exactly one argument under a name that promises any number, which
;;    is worse than the name not existing. `scm-values-list` takes the list.
;;
;; 6. `quotient` `remainder` `modulo` `abs` `expt` `zero?` `even?` `odd?` and the
;;    rest of numeric.coil's surface. Nothing about the names collides — they are
;;    simply not reachable from here: this module does not import
;;    `coil.scheme.numeric`, so `(quotient …)` fails with "call to undefined
;;    function 'scm-quotient'; it is defined in module 'coil.scheme.numeric',
;;    which is not imported here". They belong in that file, next to what they
;;    forward to.

;; ---- the type predicates, under their R5RS names ---------------------------
;; These were previously unbindable: value.coil owned `string?`/`pair?`/`null?`
;; and the rest as INTERNAL predicates returning a Coil `bool`. A defn binds a
;; name for the whole module, so adding a Scheme `string?` did not add a second
;; binding — it replaced value.coil's for every earlier line, and the file stopped
;; compiling. Worse, a client writing `(list (string? "a"))` got
;; "argument 1 to cons has type bool but expected i64": the bool predicate won,
;; silently, at the call site.
;;
;; value.coil's internals are now spelled `is-string`/`is-pair`/… , which cannot
;; collide with an R5RS name, so the standard spellings are free to mean what
;; Scheme says they mean — a procedure returning a Scheme boolean.
(defn string? [(v i64)] (-> i64) (scm-string? v))
(defn vector? [(v i64)] (-> i64) (scm-vector? v))
(defn char? [(v i64)] (-> i64) (scm-char? v))
(defn symbol? [(v i64)] (-> i64) (scm-symbol? v))
(defn procedure? [(v i64)] (-> i64) (scm-procedure? v))
(defn boolean? [(v i64)] (-> i64) (scm-boolean? v))
(defn null? [(v i64)] (-> i64) (scm-null? v))
(defn pair? [(v i64)] (-> i64) (scm-pair? v))

;; ⚠ EXPORT ONLY THE R5RS-SPELLED SURFACE.
;;
;; This module's `scm-` names are implementation spellings. If they were exported
;; they would reach every Scheme program through the umbrella, and `(scm-append
;; a b)` would compile — at which point the language being written is a lookalike
;; rather than Scheme. `coil.scheme.r5rs` reaches them through a qualified alias
;; and re-binds each under its standard name.
; `scm-display2` and `scm-procedure` are exported for macro expansion only: a
; symbol in a macro template resolves in the MACRO's namespace, so forms.coil's
; `display` expanding to `scm-display2` needs it visible there. The lint keeps
; them unwritable in Scheme source.
;; Everything below is exported for this module's own _test.coil and for macros
;; that expand to these names. `coil.scheme.lint` still rejects any `scm-` name
;; written by hand in Scheme source, so this does not widen the Scheme surface.
