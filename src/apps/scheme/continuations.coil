(module coil.scheme.continuations)
(import "coil.scheme")
(reader-provider "coil.scheme.reader" scheme-read)
(import "coil.scheme.continuation-runtime" :use *)
(import "coil.scheme.heap" :use [gc-sp gc-root gc-sp-set!])
(import "coil.scheme.stdproc" :use [call--1 scm-dynamic-wind])

;; Loading this module is the whole-build opt-in.  The dialect sees the module
;; marker and instruments native main; these bindings add the R5RS surface.
(defn call-with-current-continuation [(p i64)] (-> i64)
  (let [sp (gc-sp)]
    ;; Capturing allocates the continuation object and its native stack/root
    ;; snapshots. The callback is still needed afterwards, so it must already
    ;; be visible to the precise collector before capture begins.
    (gc-root p)
    (let [k (continuation-capture)]
      (if (continuation-resuming?)
        (let [value (continuation-take-resume-value)]
          (gc-root value)
          (gc-sp-set! sp)
          value)
      (do
        (gc-root k)
        (let [value (call--1 p k)]
          (gc-root value)
          (gc-sp-set! sp)
          value))))))

(defn call/cc [(p i64)] (-> i64)
  (call-with-current-continuation p))
(defn call/1cc [(p i64)] (-> i64)
  ;; Coil continuations already resume through a single explicit value slot.
  ;; Jolt uses this spelling to document one-shot scheduler continuations.
  (call-with-current-continuation p))

(defn dynamic-wind [(before i64) (thunk i64) (after i64)] (-> i64)
  (scm-dynamic-wind before thunk after))

(export call-with-current-continuation call/cc call/1cc dynamic-wind)
