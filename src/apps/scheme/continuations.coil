(module coil.scheme.continuations)
(import "coil.scheme")
(reader-provider "coil.scheme.reader" scheme-read)
(import "coil.scheme.continuation-runtime" :use *)
(import "coil.scheme.stdproc" :use [call--1 scm-dynamic-wind])

;; Loading this module is the whole-build opt-in.  The dialect sees the module
;; marker and instruments native main; these bindings add the R5RS surface.
(defn call-with-current-continuation [(p i64)] (-> i64)
  (let [k (continuation-capture)]
    (if (continuation-resuming?)
        (continuation-take-resume-value)
      (call--1 p k))))

(defn call/cc [(p i64)] (-> i64)
  (call-with-current-continuation p))

(defn dynamic-wind [(before i64) (thunk i64) (after i64)] (-> i64)
  (scm-dynamic-wind before thunk after))

(export call-with-current-continuation call/cc dynamic-wind)
