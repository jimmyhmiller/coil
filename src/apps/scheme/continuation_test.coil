(module coil.scheme.continuation-test)
(import "coil.assert" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.continuation" :use *)

(deftest continuation-is-a-procedure
  (let [k (make-halt-continuation)]
    (assert (continuation-frame? k))
    (assert (is-procedure k))
    (assert-eq (continuation-kind k) (continuation-halt-kind))))

(deftest continuation-chain-is-persistent-and-shareable
  ;; Two captures may share an immutable suffix. Reading either chain repeatedly
  ;; proves that capture/invocation bookkeeping does not consume the frames.
  (let [halt (make-halt-continuation)
        suffix (make-continuation-frame (continuation-sequence-kind)
                                        (mk-fixnum 20) halt)
        left (make-continuation-frame (continuation-if-kind)
                                      (mk-fixnum 41) suffix)
        right (make-continuation-frame (continuation-callcc-kind)
                                       (mk-fixnum 42) suffix)]
    (assert (val-eq? (continuation-next left) suffix))
    (assert (val-eq? (continuation-next right) suffix))
    (assert-eq (fixnum-value (continuation-data left)) 41)
    (assert-eq (fixnum-value (continuation-data right)) 42)
    (assert-eq (fixnum-value (continuation-data (continuation-next left))) 20)
    (assert-eq (fixnum-value (continuation-data (continuation-next left))) 20)))

(deftest continuation-traces-data-and-parent-through-collection
  (let [sp (gc-sp)
        payload (cons (mk-fixnum 7) (cons (mk-fixnum 8) (s-nil)))]
    (gc-root payload)
    (let [halt (make-halt-continuation)]
      (gc-root halt)
      (let [k (make-continuation-frame (continuation-argument-kind) payload halt)]
        (gc-root k)
        (collect)
        (assert (is-pair (continuation-data k)))
        (assert-eq (fixnum-value (car (continuation-data k))) 7)
        (assert (continuation-frame? (continuation-next k)))
        (assert-eq (continuation-kind (continuation-next k))
                   (continuation-halt-kind))))
    (gc-sp-set! sp)))
