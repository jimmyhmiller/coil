(module coil.scheme.symbol)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)

;; Symbol interning.
;;
;; `eq?` on symbols must be O(1) — R5RS guarantees that two symbols with the same
;; name are `eq?`, and the evaluator compares symbols constantly (every variable
;; reference, every special-form dispatch). So a symbol carries an integer id and
;; comparison is an integer compare.
;;
;; The predecessor's biggest single performance bug was interning in the wrong
;; place: it called `(intern "if")` on *every* dispatch, which is a linear scan of
;; the symbol table plus a fresh allocation, up to four times per expression.
;; Fixing that alone was 1.83× on fib(30) and cut allocations 37%. The lesson is
;; structural, not incidental: **intern once, compare by id**. Anything that
;; interns inside the evaluator loop is a bug, and `special-form-id` below exists
;; so the evaluator never has to.
;;
;; The table is a plain growable list — symbol creation is rare (it happens at
;; read time), so a linear scan there is fine; what must never be linear is the
;; comparison.

(defstruct SymTab [(init i64) (names (ptr (ArrayList (slice u8)))) (vals (ptr (ArrayList i64)))])
(defn symtab [] (-> (ptr SymTab)) (alloc/static SymTab))

(defn symtab-init! [] (-> i64)
  (let [t (symtab)]
    (if (= (primitive/load (primitive/field t init)) 0)
        (let [a (malloc-allocator)
              n (unwrap-ptr [(ArrayList (slice u8))] (create [(ArrayList (slice u8))] a))
              v (unwrap-ptr [(ArrayList i64)] (create [(ArrayList i64)] a))]
          (primitive/store! n (al-new [(slice u8)] a))
          (primitive/store! v (al-new [i64] a))
          (primitive/store! (primitive/field t names) n)
          (primitive/store! (primitive/field t vals) v)
          (primitive/store! (primitive/field t init) 1)
          0)
      0)))

(defn sym-names [] (-> (ptr (ArrayList (slice u8))))
  (symtab-init!)
  (primitive/load (primitive/field (symtab) names)))
(defn sym-vals [] (-> (ptr (ArrayList i64)))
  (symtab-init!)
  (primitive/load (primitive/field (symtab) vals)))

;; The id for a name, creating it on first sight. O(n) in the table size — fine at
;; read time, never acceptable inside the evaluator (see the note above).
(defn intern-id [(name (slice u8))] (-> i64)
  (let [ns (sym-names)
        n (al-len [(slice u8)] (primitive/load ns))
        (mut found) -1]
    (for [i 0 n]
      (if (and (< (primitive/load (mut found)) 0)
               (str-eq (al-get [(slice u8)] (primitive/load ns) i) name))
          (do (primitive/store! (mut found) i) 0)
        0))
    (if (>= (primitive/load (mut found)) 0)
        (primitive/load (mut found))
      (do (al-push! [(slice u8)] ns name) n))))

;; The interned symbol object for a name. Symbols are unique per id, so the object
;; is cached: `eq?` on two symbols with the same name must be true, and that holds
;; because they are literally the same object.
(defn intern [(name (slice u8))] (-> i64)
  (let [id (intern-id name)
        vs (sym-vals)
        n (al-len [i64] (primitive/load vs))]
    ; the value table trails the name table until a symbol is first materialized
    (loop
      (if (> (al-len [i64] (primitive/load vs)) id) (break)
        (al-push! [i64] vs 0)))
    (let [cached (al-get [i64] (primitive/load vs) id)]
      (if (not (= cached 0)) cached
        (let [obj (allocate (tag-symbol) id 0 0)]
          (al-set! [i64] vs id obj)
          ; symbols live for the whole program and are reachable from the table,
          ; which the collector does not scan — so root the object permanently.
          (gc-root obj)
          obj)))))

(defn symbol-id [(v i64)] (-> i64) (primitive/load (primitive/field (obj-of v) a)))
(defn symbol-name [(v i64)] (-> (slice u8))
  (al-get [(slice u8)] (primitive/load (sym-names)) (symbol-id v)))

;; R5RS: two symbols are eq? iff their names are the same. One integer compare.
(defn symbol-eq? [(a i64) (b i64)] (-> bool) (= (symbol-id a) (symbol-id b)))
