(module coil.scheme.value)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)

;; The Scheme value representation.
;;
;; A `Val` is one machine word. Heap objects are 8-byte aligned, so the low three
;; bits are free to mark an immediate:
;;
;;     ...000   heap pointer (to an Obj, whose header carries the type tag)
;;     ...001   fixnum        value = word >> 3  (arithmetic shift, so negatives work)
;;     ...011   character     code point = word >> 3
;;     ...111   singleton     #f #t () eof unspecified undefined  (see below)
;;
;; Immediates matter more than they look: making nil and the booleans immediate
;; took the predecessor implementation from 233M allocations to 21.5M on the same
;; program, because every `is-null` and `eq?` in a loop had been boxing its result.
;; The collector also skips them outright — an immediate is never traced.
;;
;; Fixnums are 61-bit. R5RS requires exact integers of "practically unlimited"
;; size, so overflow promotes to a bignum rather than wrapping; see number.coil.

;; A Scheme value IS the tagged word — a bare `i64`, not a wrapper struct. Coil's
;; `field` needs a place, so a one-field struct would force every accessor to
;; round-trip through stack storage to read the word back out. The tag discipline
;; below is the type; keep every construction going through these constructors.
;;
;; `Val` is spelled i64 throughout this module. Read the parameter names.

; --- tag tests -------------------------------------------------------------
(defn tag3 [(v i64)] (-> i64) (primitive/iand v 7))
;; True when the value is a heap object — the only case the collector traces.
(defn is-heap [(v i64)] (-> bool) (= (tag3 v) 0))
(defn is-fixnum [(v i64)] (-> bool) (= (tag3 v) 1))
(defn is-char [(v i64)] (-> bool) (= (tag3 v) 3))
(defn is-singleton [(v i64)] (-> bool) (= (tag3 v) 7))

; --- immediate constructors -------------------------------------------------
(defn mk-fixnum [(n i64)] (-> i64) (primitive/ior (primitive/ishl n 3) 1))
(defn fixnum-value [(v i64)] (-> i64) (primitive/ishr v 3))
(defn mk-char [(c i64)] (-> i64) (primitive/ior (primitive/ishl c 3) 3))
(defn char-value [(v i64)] (-> i64) (primitive/ishr v 3))

;; The singletons. Encoded as `(n << 3) | 7` so they are distinguishable from each
;; other by a single integer compare.
;;
;; `undefined` is the letrec hole: R5RS binds letrec variables to an unspecified
;; value and makes it an error to *evaluate* one before its init has run. Giving
;; that state its own singleton lets the evaluator detect the error instead of
;; silently propagating a wrong value. It must never be visible to a program.
(defn s-false [] (-> i64) 7)
(defn s-true [] (-> i64) 15)
(defn s-nil [] (-> i64) 23)
(defn s-eof [] (-> i64) 31)
(defn s-unspecified [] (-> i64) 39)
(defn s-undefined [] (-> i64) 47)

(defn val-eq? [(a i64) (b i64)] (-> bool) (= a b))
(defn is-null [(v i64)] (-> bool) (val-eq? v (s-nil)))
(defn undefined? [(v i64)] (-> bool) (val-eq? v (s-undefined)))

;; R5RS 6.3.1: #f is the ONLY false value. The empty list, 0 and "" are all true —
;; this is the single most common place a Scheme written by a C programmer goes
;; wrong, so it is one function and everything routes through it.
(defn truthy? [(v i64)] (-> bool) (not (val-eq? v (s-false))))
(defn mk-bool [(b bool)] (-> i64) (if b (s-true) (s-false)))

; --- heap objects -----------------------------------------------------------
;; Header tags. The header also carries the collector's mark bit, so an object is
;; `(tag, mark)` followed by its payload.
(defn tag-pair [] (-> i64) 1)
(defn tag-symbol [] (-> i64) 2)
(defn tag-string [] (-> i64) 3)
(defn tag-vector [] (-> i64) 4)
(defn tag-closure [] (-> i64) 5)
(defn tag-primitive [] (-> i64) 6)
(defn tag-continuation [] (-> i64) 7)
(defn tag-promise [] (-> i64) 8)
(defn tag-port [] (-> i64) 9)
(defn tag-environment [] (-> i64) 10)
(defn tag-bignum [] (-> i64) 11)
(defn tag-ratnum [] (-> i64) 12)
(defn tag-flonum [] (-> i64) 13)
(defn tag-values [] (-> i64) 14)
(defn tag-complex [] (-> i64) 15)
(defn tag-tail-call [] (-> i64) 16)

;; Every heap object starts with this header. `a`/`b`/`c` are generic payload
;; slots so the collector can trace a pair, a closure and a continuation frame
;; through one code path; each tag documents what its slots mean:
;;
;;   pair          a=car        b=cdr
;;   symbol        a=intern id  b=name (slice, boxed)
;;   closure       a=params     b=body        c=env
;;   continuation  a=frame      b=next-k      c=wind-list
;;   promise       a=thunk/value b=forced?
;;   environment   a=names      b=values      c=parent
(defstruct Obj [(tag i64) (mark i64) (a i64) (b i64) (c i64)])

(defn obj-of [(v i64)] (-> (ptr Obj)) (primitive/cast (ptr Obj) v))
(defn obj-tag [(v i64)] (-> i64) (primitive/load (primitive/field (obj-of v) tag)))
;; Tag test that is safe on an immediate: an immediate is never a heap object, so
;; it must be rejected before the pointer is dereferenced.
(defn has-tag? [(v i64) (t i64)] (-> bool) (and (is-heap v) (= (obj-tag v) t)))

(defn is-pair [(v i64)] (-> bool) (has-tag? v (tag-pair)))
(defn is-symbol [(v i64)] (-> bool) (has-tag? v (tag-symbol)))
(defn is-string [(v i64)] (-> bool) (has-tag? v (tag-string)))
(defn is-vector [(v i64)] (-> bool) (has-tag? v (tag-vector)))
(defn is-closure [(v i64)] (-> bool) (has-tag? v (tag-closure)))
(defn is-primitive [(v i64)] (-> bool) (has-tag? v (tag-primitive)))
(defn is-bignum [(v i64)] (-> bool) (has-tag? v (tag-bignum)))
(defn is-ratnum [(v i64)] (-> bool) (has-tag? v (tag-ratnum)))
(defn is-flonum [(v i64)] (-> bool) (has-tag? v (tag-flonum)))
(defn is-complex-number [(v i64)] (-> bool) (has-tag? v (tag-complex)))
(defn is-continuation [(v i64)] (-> bool) (has-tag? v (tag-continuation)))
(defn is-tail-call [(v i64)] (-> bool) (has-tag? v (tag-tail-call)))
;; R5RS 6.4: a continuation IS a procedure, and `is-procedure` must say so.
(defn is-procedure [(v i64)] (-> bool)
  (or (is-closure v) (or (is-primitive v) (is-continuation v))))
