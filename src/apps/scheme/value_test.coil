(module coil.scheme.value-test)
(import "coil.assert" :use *)
(import "coil.scheme.value" :use *)

;; The tag discipline is the type system for `Val`, so it gets tested directly:
;; a bug here is silent and corrupts everything downstream.

(deftest fixnums-round-trip
  (assert-eq (fixnum-value (mk-fixnum 0)) 0)
  (assert-eq (fixnum-value (mk-fixnum 42)) 42)
  ; negatives are the reason the shift must be arithmetic, not logical
  (assert-eq (fixnum-value (mk-fixnum -1)) -1)
  (assert-eq (fixnum-value (mk-fixnum -999999)) -999999)
  ; 61-bit range: the largest magnitudes that must survive the tag
  (assert-eq (fixnum-value (mk-fixnum 1152921504606846975)) 1152921504606846975)
  (assert-eq (fixnum-value (mk-fixnum -1152921504606846976)) -1152921504606846976)
  (assert (is-fixnum (mk-fixnum 7)))
  (assert (not (is-heap (mk-fixnum 7)))))

(deftest chars-round-trip
  (assert-eq (char-value (mk-char 65)) 65)
  (assert-eq (char-value (mk-char 955)) 955)        ; λ — not everything is ASCII
  (assert-eq (char-value (mk-char 128512)) 128512)  ; astral plane
  (assert (is-char (mk-char 65)))
  (assert (not (is-fixnum (mk-char 65)))))

(deftest singletons-are-distinct
  ; every singleton must differ from every other, or eq? collapses them
  (assert (not (val-eq? (s-false) (s-true))))
  (assert (not (val-eq? (s-false) (s-nil))))
  (assert (not (val-eq? (s-nil) (s-eof))))
  (assert (not (val-eq? (s-unspecified) (s-undefined))))
  (assert (is-null (s-nil)))
  (assert (not (is-null (s-false))))
  (assert (undefined? (s-undefined))))

(deftest only-false-is-false
  ; R5RS 6.3.1 — the empty list, zero and #t are ALL true. This is the rule a
  ; Scheme written by a C programmer gets wrong.
  (assert (not (truthy? (s-false))))
  (assert (truthy? (s-true)))
  (assert (truthy? (s-nil)))
  (assert (truthy? (mk-fixnum 0)))
  (assert (truthy? (s-unspecified))))

(deftest tags-do-not-collide
  ; an immediate must never be mistaken for a heap pointer — has-tag? would
  ; otherwise dereference it
  (assert (not (is-heap (s-nil))))
  (assert (not (is-heap (s-false))))
  (assert (not (is-heap (mk-fixnum 123))))
  (assert (not (is-heap (mk-char 65))))
  (assert (not (is-pair (mk-fixnum 1))))
  (assert (not (is-procedure (s-nil))))
  (assert (is-singleton (s-eof))))

(deftest booleans-map-to-singletons
  (assert (val-eq? (mk-bool true) (s-true)))
  (assert (val-eq? (mk-bool false) (s-false))))
