(module coil.scheme.exception-runtime)

;; Neutral bridge between the Chez compatibility layer and the optional R6RS
;; exception library.  The compatibility layer is below coil.r6rs.exceptions
;; in the import graph, so importing that library to implement `error` would
;; create a cycle.  Instead the R6RS module installs its ordinary Scheme `raise`
;; procedure here once initialization reaches it; host primitives then dispatch
;; through the exact same in-process handler stack and continuation machinery.
(import "coil.alloc" :as alloc)
(import "coil.scheme.heap" :use [gc-root-permanent])
(import "coil.scheme.stdproc" :use [call--1])

(defn exception-raise-cell [] (-> (ptr i64)) (alloc/static i64))

(defn exception-raise-procedure-set! [(p i64)] (-> i64)
  (let [cell (exception-raise-cell)]
    ;; Installation normally happens once.  Keeping the procedure in the
    ;; permanent root set is required: a raw .bss word is invisible to the
    ;; precise Scheme collector.
    (if (= (load cell) 0)
        (do (gc-root-permanent p) (store! cell p) 0)
      0)
    0))

(defn exception-raise [(object i64)] (-> i64)
  (let [p (load (exception-raise-cell))]
    (if (= p 0)
        (do (alloc/abort) 0)
      (call--1 p object))))

(export exception-raise-procedure-set! exception-raise)
