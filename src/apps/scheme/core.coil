(module coil.scheme.core)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)

;; LLVM tailcc permits guaranteed sibling calls between different native
;; signatures. Procedure `define` below refers to this convention from its macro
;; definition site, so user modules need no generated top-level declaration.
(defcc scheme-tail :native swifttail)
(import "coil.scheme.symbol" :use *)
(import "coil.scheme.bignum" :use *)

;; The R5RS surface, as ordinary Coil macros and functions.
;;
;; There is no interpreter here and no compiler. Scheme syntax is already Coil
;; syntax — the same reader produces the same s-expressions — so `define` is a
;; macro that expands to `defn`, `lambda` to a closure, `cond` to nested `if`.
;; What reaches codegen is an ordinary Coil program, and it runs at native speed
;; because it IS native code.
;;
;; Every Scheme value is a `Val` (a tagged i64, see value.coil), because Scheme is
;; dynamically typed: a function's parameter can hold a fixnum on one call and a
;; pair on the next, so one uniform representation is not an optimization choice
;; but a requirement.
;;
;; NOT implemented, by decision (see ../../tests/scheme/out-of-scope/):
;; unbounded tail calls, call/cc, dynamic-wind. Recursion here runs on the native
;; stack and is bounded by it.

; ---- define -----------------------------------------------------------------
;; `(define (f a b) body …)` -> a defn over Val; `(define x e)` -> a global cell.
;;
;; The two shapes are told apart by whether the head is a list, which is exactly
;; how R5RS distinguishes them. Variadic `(define (f . rest) …)` and
;; `(define (f a . rest) …)` are handled by scanning for the dot.

(defn scm--params [(sig Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `[]
    (let [p (primitive/code-nth sig i)]
      ; a `.` marks the rest parameter: everything after it is one list
      (if (primitive/code-eq p `.)
          `[(~(primitive/code-nth sig (+ i 1)) i64)]
        `[(~p i64) ~@(scm--params sig (+ i 1) n)]))))

;; True when the signature has a dotted rest parameter.
(defn scm--variadic? [(sig Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (primitive/code-eq (primitive/code-nth sig i) `.) true
      (scm--variadic? sig (+ i 1) n))))

;; A global variable's storage, as EXPORTED functions rather than an inline
;; expansion.
;;
;; ⚠ TWO HOST CONSTRAINTS MEET HERE, AND TOGETHER THEY RULE OUT THE OBVIOUS
;; IMPLEMENTATIONS.
;;
;; 1. `alloc-static` gives one cell per CALL SITE, not per call. A shared
;;    `(defn scm--new-cell [] (alloc/static i64))` here is ONE site, so every
;;    global in the program would alias the same word.
;; 2. A macro expands in the CALLER's namespace, so the expansion cannot name
;;    `alloc/static` or `primitive/…` — those are aliases of THIS module's
;;    imports. Emitting them fails with "call to undefined function
;;    'alloc/static'", and namespace aliases do NOT transit `:reexport`, so the
;;    umbrella cannot rescue them either (verified).
;;
;; So the storage is a HEAP CELL from the Scheme heap, keyed by the variable's
;; interned symbol: a global is an entry in a genuine global environment. That
;; needs no per-site allocation (constraint 1 gone) and no namespace-qualified
;; name at the call site (constraint 2 gone), and the collector already traces it,
;; so a global holding a list keeps that list alive — which an `alloc/static` word
;; would NOT have done, since the tracer never scans .bss. That last point makes
;; this the more correct design regardless of the constraints.
;;
;; The environment is an association list of (symbol . value) pairs, living in
;; heap.coil's `globals` cell — the permanent root `mark-roots` traces before the
;; shadow stack, reserved there for exactly this. Globals are few and looked up
;; once per reference, so a list is the right shape; a hash table would be more
;; machinery for no measurable gain at this size.
(defn scm--assq [(s i64) (l i64)] (-> i64)
  (if (is-null l) (s-nil)
    (if (val-eq? (car (car l)) s) (car l)
      (scm--assq s (cdr l)))))

;; ⚠ The `globals` cell starts as a ZERO WORD (.bss), and nil is 23 — so the raw
;; cell is NOT the empty list. Reading it directly made `scm--assq` fail its
;; `is-null` test and dereference 0 as a pair: an immediate SIGSEGV on the first
;; `define`. Normalizing 0 to nil here is what makes "no globals yet" and "the
;; empty environment" the same thing, and it is the only place that has to know.
(defn scm--genv [] (-> i64)
  (let [g (globals)]
    (if (= g 0) (s-nil) g)))

;; Find the (symbol . value) pair for `s`, or nil.
(defn scm--genv-find [(s i64)] (-> i64) (scm--assq s (scm--genv)))

;; Install a value that has just been initialized. Keep the old environment and
;; both new fields live across the two pair allocations.
(defn scm--global-install [(s i64) (v i64)] (-> i64)
  (let [sp (gc-sp) old (scm--genv)]
    (gc-root s) (gc-root v) (gc-root old)
    (let [entry (cons s v)]
      (gc-root entry)
      (let [next (cons entry old)]
        (set-globals! next)
        (gc-sp-set! sp)
        v))))

;; Read a global, initializing it on first reference.
;;
;; The init is passed as a value, so it is evaluated on every read — but it is
;; only STORED once, on the first. That matters for `(define x (list 1 2))`:
;; re-reading must not rebuild the list, or `set!` would be undone and `eq?` on
;; the same global would be false.
(defn scm--global-read [(s i64) (init i64)] (-> i64)
  (let [p (scm--genv-find s)]
    (if (is-null p)
        (do (set-globals! (cons (cons s init) (scm--genv)))
            init)
      (cdr p))))

;; `set!` on an existing binding mutates the pair in place, so every reference
;; sees the new value. R5RS returns an unspecified value.
(defn scm--global-write [(s i64) (v i64)] (-> i64)
  (let [p (scm--genv-find s)]
    (if (is-null p)
        (set-globals! (cons (cons s v) (scm--genv)))
      (set-cdr! p v))
    (s-unspecified)))

(defn define [(head Code) & (body Code)] (-> Code)
  (if (primitive/code-list? head)
      ; (define (f args…) body…)
      `(defn ~(primitive/code-nth head 0)
             :cc scheme-tail
             ~(scm--params head 1 (primitive/code-count head))
             (-> i64)
         ~@body)
    ; (define x e) — a zero-argument getter over the global environment, keyed by
    ; the variable's interned symbol, because R5RS `set!` must be able to reassign
    ; it. Crucially, E is inside the missing-entry branch. Passing E as an
    ; argument to `scm--global-read` evaluated it on every access; Mal therefore
    ; rebuilt its entire core environment for every expression.
    ; Every name the expansion mentions — `scm--genv-find`,
    ; `scm--global-install`, `intern-literal` — is
    ; exported by this module and reaches the user through `:use *`, which is what
    ; keeps the macro from leaking its own namespace.
    `(defn ~head [] (-> i64)
       (let [s (intern-literal ~(primitive/code-str head))]
         (let [p (scm--genv-find s)]
           (if (is-null p)
               (scm--global-install s ~(primitive/code-nth body 0))
             (cdr p)))))))

; ---- set! -------------------------------------------------------------------
;; R5RS `(set! x e)`. Coil reserves `set!` as a 3-argument trait method (the Set
;; trait), so Scheme's 2-argument form cannot use that name — it fails with
;; "'set!' expects 3 args, got 2" and the name cannot be rebound. `scm-set!` is
;; the same treatment `do` and `quasiquote` get, and `dialect.coil` routes the
;; Scheme spelling to it.
;;
;; Only GLOBALS are assignable: this writes the global environment entry for the
;; name's symbol. A `set!` on a LOCAL (a `let` binding or a parameter) is NOT
;; supported — Coil locals are immutable unless declared `(mut …)`, and nothing
;; rewrites a Scheme binding into one. Such a `set!` silently writes a global of
;; the same name instead of the local, which is the one sharp edge here.
(defn scm-set! [(name Code) (v Code)] (-> Code)
  `(scm--global-write (intern-literal ~(primitive/code-str name)) ~v))

; ---- the immediate literals -------------------------------------------------
;; `#t`, `#f` and `'()` read as ordinary symbols, so they are bound like any
;; other name rather than needing reader support.
(defn scm--true [] (-> i64) (s-true))
(defn scm--false [] (-> i64) (s-false))

; ---- arithmetic and comparison ----------------------------------------------
;; R5RS `+ - * < =` are variadic; these are the binary core the macros fold onto.
;; Preserve the allocation-free fixnum path. Exact rational operations stay
;; exact; only an explicitly inexact operand promotes the result to a flonum.
(defn core-numeric-fail [(msg (ptr i8))] (-> i64)
  (oom-puts c"coil.scheme: ")
  (oom-puts msg)
  (oom-puts c"\n")
  (abort)
  (s-unspecified))
(defn number-real-part [(v i64)] (-> i64)
  (if (is-complex-number v) (complex-real v) v))
(defn number-imag-part [(v i64)] (-> i64)
  (if (is-complex-number v) (complex-imag v) (mk-fixnum 0)))
(defn complex-add [(a i64) (b i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root a) (gc-root b)
    (let [r (scm-add (number-real-part a) (number-real-part b))]
      (gc-root r)
      (let [i (scm-add (number-imag-part a) (number-imag-part b))]
        (gc-root i)
        (let [out (make-complex r i)]
          (gc-sp-set! sp) (gc-root out) out)))))
(defn complex-sub [(a i64) (b i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root a) (gc-root b)
    (let [r (scm-sub (number-real-part a) (number-real-part b))]
      (gc-root r)
      (let [i (scm-sub (number-imag-part a) (number-imag-part b))]
        (gc-root i)
        (let [out (make-complex r i)]
          (gc-sp-set! sp) (gc-root out) out)))))
(defn complex-mul [(a i64) (b i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root a) (gc-root b)
    (let [ar (number-real-part a) ai (number-imag-part a)
          br (number-real-part b) bi (number-imag-part b)]
      (gc-root ar) (gc-root ai) (gc-root br) (gc-root bi)
      (let [ac (scm-mul ar br) bd (scm-mul ai bi)
            ad (scm-mul ar bi) bc (scm-mul ai br)]
        (gc-root ac) (gc-root bd) (gc-root ad) (gc-root bc)
        (let [out (make-complex (scm-sub ac bd) (scm-add ad bc))]
          (gc-sp-set! sp) (gc-root out) out)))))
(defn core-abs-f64 [(x f64)] (-> f64)
  (if (primitive/fcmp-lt x 0.0) (primitive/fsub 0.0 x) x))
(defn complex-div-inexact [(ar i64) (ai i64) (br i64) (bi i64)] (-> i64)
  ;; Smith's scaled division avoids both squaring overflow and denominator
  ;; underflow. `(1e300+i1e300)/(4e300+i4e300)` and its 1e-300 analogue must
  ;; both produce 0.25 rather than NaN or a false division-by-zero trap.
  (let [x (core-number->f64 ar) y (core-number->f64 ai)
        u (core-number->f64 br) v (core-number->f64 bi)]
    (if (primitive/fcmp-ge (core-abs-f64 u) (core-abs-f64 v))
        (let [r (primitive/fdiv v u)
              den (primitive/fadd u (primitive/fmul v r))]
          (make-complex
            (mk-flonum (primitive/fdiv (primitive/fadd x (primitive/fmul y r)) den))
            (mk-flonum (primitive/fdiv (primitive/fsub y (primitive/fmul x r)) den))))
      (let [r (primitive/fdiv u v)
            den (primitive/fadd v (primitive/fmul u r))]
        (make-complex
          (mk-flonum (primitive/fdiv (primitive/fadd (primitive/fmul x r) y) den))
          (mk-flonum (primitive/fdiv (primitive/fsub (primitive/fmul y r) x) den)))))))
(defn complex-div [(a i64) (b i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root a) (gc-root b)
    (let [ar (number-real-part a) ai (number-imag-part a)
          br (number-real-part b) bi (number-imag-part b)]
      (gc-root ar) (gc-root ai) (gc-root br) (gc-root bi)
      (if (or (is-flonum ar) (or (is-flonum ai) (or (is-flonum br) (is-flonum bi))))
          (let [out (complex-div-inexact ar ai br bi)]
            (gc-sp-set! sp) (gc-root out) out)
      (let [br2 (scm-mul br br) bi2 (scm-mul bi bi)]
        (gc-root br2) (gc-root bi2)
        (let [den (scm-add br2 bi2)]
          (gc-root den)
          (let [real-num (scm-add (scm-mul ar br) (scm-mul ai bi))
                imag-num (scm-sub (scm-mul ai br) (scm-mul ar bi))]
            (gc-root real-num) (gc-root imag-num)
            (let [out (make-complex (scm-div real-num den) (scm-div imag-num den))]
              (gc-sp-set! sp) (gc-root out) out))))))))

(defn exact-add [(a i64) (b i64)] (-> i64)
  (make-rational
    (integer-add (integer-mul (exact-numerator-val a) (exact-denominator-val b))
                 (integer-mul (exact-numerator-val b) (exact-denominator-val a)))
    (integer-mul (exact-denominator-val a) (exact-denominator-val b))))
(defn exact-sub [(a i64) (b i64)] (-> i64)
  (make-rational
    (integer-sub (integer-mul (exact-numerator-val a) (exact-denominator-val b))
                 (integer-mul (exact-numerator-val b) (exact-denominator-val a)))
    (integer-mul (exact-denominator-val a) (exact-denominator-val b))))
(defn exact-mul [(a i64) (b i64)] (-> i64)
  (make-rational (integer-mul (exact-numerator-val a) (exact-numerator-val b))
                 (integer-mul (exact-denominator-val a) (exact-denominator-val b))))
(defn exact-div [(a i64) (b i64)] (-> i64)
  (make-rational (integer-mul (exact-numerator-val a) (exact-denominator-val b))
                 (integer-mul (exact-denominator-val a) (exact-numerator-val b))))
(defn exact-numerator-val [(v i64)] (-> i64)
  (if (is-ratnum v) (ratnum-numerator-val v) v))
(defn exact-denominator-val [(v i64)] (-> i64)
  (if (is-ratnum v) (ratnum-denominator-val v) (mk-fixnum 1)))
(defn integer-object? [(v i64)] (-> bool) (or (is-fixnum v) (is-bignum v)))
(defn core-number-zero? [(v i64)] (-> bool)
  (if (is-complex-number v)
      (and (core-number-zero? (complex-real v))
           (core-number-zero? (complex-imag v)))
    (if (is-flonum v) (primitive/fcmp-eq (flonum-value v) 0.0)
      (if (is-ratnum v) (= (integer-sign (ratnum-numerator-val v)) 0)
        (if (integer-object? v) (= (integer-sign v) 0) false)))))
(defn core-finite-positive? [(x f64)] (-> bool)
  (and (primitive/fcmp-gt x 0.0)
       (not (= (primitive/iand (f64->raw-bits x) 9218868437227405312)
               9218868437227405312))))
(defn core-binary-exponent [(x f64)] (-> i64)
  (let [(mut y) x (mut e) 0]
    (if (primitive/fcmp-ge (primitive/load (mut y)) 1.0)
        (loop
          (if (primitive/fcmp-lt (primitive/load (mut y)) 2.0) (break)
            (do (primitive/store! (mut y) (primitive/fmul (primitive/load (mut y)) 0.5))
                (primitive/store! (mut e) (+ (primitive/load (mut e)) 1)))))
      (loop
        (if (primitive/fcmp-ge (primitive/load (mut y)) 1.0) (break)
          (do (primitive/store! (mut y) (primitive/fmul (primitive/load (mut y)) 2.0))
              (primitive/store! (mut e) (- (primitive/load (mut e)) 1))))))
    (primitive/load (mut e))))
(defn core-ratio-at-least-power? [(num i64) (den i64) (e i64)] (-> bool)
  (let [sp (gc-sp)]
    (gc-root num) (gc-root den)
    (let [power (integer-power-of-two (if (< e 0) (- 0 e) e))]
      (gc-root power)
      (let [result
            (if (>= e 0)
                (let [scaled-den (integer-mul den power)]
                  (gc-root scaled-den)
                  (>= (integer-cmp num scaled-den) 0))
              (let [scaled-num (integer-mul num power)]
                (gc-root scaled-num)
                (>= (integer-cmp scaled-num den) 0)))]
        (gc-sp-set! sp)
        result))))
(defn core-ratio-exponent [(num i64) (den i64) (estimate f64)] (-> i64)
  ;; When both exact operands overflow f64, decimal-limb counts still give a
  ;; close seed (base 10^9 is just under 2^30). Exact comparisons then remove
  ;; every approximation before the significand is rounded.
  (let [(mut e)
        (if (core-finite-positive? estimate) (core-binary-exponent estimate)
          (* 30 (- (mag-length (integer-limbs num))
                   (mag-length (integer-limbs den)))))]
    (loop
      (if (core-ratio-at-least-power? num den (primitive/load (mut e))) (break)
        (primitive/store! (mut e) (- (primitive/load (mut e)) 1))))
    (loop
      (if (not (core-ratio-at-least-power? num den (+ (primitive/load (mut e)) 1)))
          (break)
        (primitive/store! (mut e) (+ (primitive/load (mut e)) 1))))
    (primitive/load (mut e))))
(defn core-scale-f64 [(x f64) (e i64)] (-> f64)
  (let [(mut out) x]
    (if (>= e 0)
        (for [i 0 e]
          (primitive/store! (mut out) (primitive/fmul (primitive/load (mut out)) 2.0)))
      (for [i 0 (- 0 e)]
        (primitive/store! (mut out) (primitive/fmul (primitive/load (mut out)) 0.5))))
    (primitive/load (mut out))))
(defn core-rounded-ratio [(num i64) (den i64) (shift i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root num) (gc-root den)
    (let [power (integer-power-of-two (if (< shift 0) (- 0 shift) shift))]
      (gc-root power)
      (let [scaled-num (if (>= shift 0) (integer-mul num power) num)
            scaled-den (if (< shift 0) (integer-mul den power) den)]
        (gc-root scaled-num) (gc-root scaled-den)
        (let [q (integer-quotient scaled-num scaled-den)]
          (gc-root q)
          (let [rem (integer-remainder scaled-num scaled-den)]
            (gc-root rem)
            (let [twice (integer-add rem rem)]
              (gc-root twice)
              (let [cmp (integer-cmp twice scaled-den)
                    odd (not (= (integer-sign (integer-remainder q (mk-fixnum 2))) 0))]
                (let [out (if (or (> cmp 0) (and (= cmp 0) odd))
                              (integer-add q (mk-fixnum 1)) q)]
                  (gc-sp-set! sp) (gc-root out) out)))))))))
(defn core-rational->f64 [(v i64)] (-> f64)
  (let [n (ratnum-numerator-val v) d (ratnum-denominator-val v)
        neg (< (integer-sign (ratnum-numerator-val v)) 0)
        magnitude (integer-abs (ratnum-numerator-val v))]
    (gc-root v) (gc-root n) (gc-root d) (gc-root magnitude)
    (let [estimate (primitive/fdiv (integer-to-f64 magnitude) (integer-to-f64 d))]
      (let [e (core-ratio-exponent magnitude d estimate)
            subnormal (< e -1022)
            shift (if subnormal 1074 (- 52 e))
            q (core-rounded-ratio magnitude d shift)
            out (core-scale-f64 (integer-to-f64 q) (if subnormal -1074 (- e 52)))]
        (if neg (primitive/fsub 0.0 out) out)))))
(defn core-number->f64 [(v i64)] (-> f64)
  (if (is-bignum v) (integer-to-f64 v)
    (if (is-ratnum v)
        (core-rational->f64 v)
      (number->f64 v))))
(defn scm-integer-literal [(s (slice u8))] (-> i64) (integer-from-slice s 10))
(defn scm-rational-slash [(s (slice u8)) (i i64)] (-> i64)
  (if (>= i (slice-len [u8] s)) -1
    (if (= (primitive/cast i64 (slice-get [u8] s i)) 47) i
      (scm-rational-slash s (+ i 1)))))
(defn scm-rational-literal [(s (slice u8))] (-> i64)
  (let [slash (scm-rational-slash s 0)]
    (if (< slash 0) (s-unspecified)
      (make-rational (integer-from-slice (subslice [u8] s 0 slash) 10)
                     (integer-from-slice (subslice [u8] s (+ slash 1) (slice-len [u8] s)) 10)))))

(defn scm-add-slow [(a i64) (b i64)] (-> i64)
  (if (or (is-complex-number a) (is-complex-number b)) (complex-add a b)
    (if (or (is-flonum a) (is-flonum b))
        (mk-flonum (+ (core-number->f64 a) (core-number->f64 b)))
      (if (and (integer-object? a) (integer-object? b)) (integer-add a b)
        (exact-add a b)))))
(defn scm-add-fix [(s i64)] (-> i64)
  (if (and (>= s -1152921504606846976) (<= s 1152921504606846975))
      (mk-fixnum s) (big-from-i64 s)))
(defn scm-fixnum-add [(a i64) (b i64)] (-> i64)
  (scm-add-fix (+ (fixnum-value a) (fixnum-value b))))
(defn scm-add [(a i64) (b i64)] (-> i64)
  (if (and (is-fixnum a) (is-fixnum b))
      (let [s (+ (fixnum-value a) (fixnum-value b))]
        (if (and (>= s -1152921504606846976) (<= s 1152921504606846975))
            (mk-fixnum s) (big-from-i64 s)))
    (scm-add-slow a b)))

(defn scm-sub-slow [(a i64) (b i64)] (-> i64)
  (if (or (is-complex-number a) (is-complex-number b)) (complex-sub a b)
    (if (or (is-flonum a) (is-flonum b))
        (mk-flonum (- (core-number->f64 a) (core-number->f64 b)))
      (if (and (integer-object? a) (integer-object? b)) (integer-sub a b)
        (exact-sub a b)))))
(defn scm-sub [(a i64) (b i64)] (-> i64)
  (if (and (is-fixnum a) (is-fixnum b))
      (let [d (- (fixnum-value a) (fixnum-value b))]
        (if (and (>= d -1152921504606846976) (<= d 1152921504606846975))
            (mk-fixnum d) (big-from-i64 d)))
    (scm-sub-slow a b)))
(defn scm-fixnum-sub [(a i64) (b i64)] (-> i64)
  (let [d (- (fixnum-value a) (fixnum-value b))]
    (if (and (>= d -1152921504606846976) (<= d 1152921504606846975))
        (mk-fixnum d) (big-from-i64 d))))

(defn scm-mul-slow [(a i64) (b i64)] (-> i64)
  (if (or (is-complex-number a) (is-complex-number b)) (complex-mul a b)
    (if (or (is-flonum a) (is-flonum b))
        (mk-flonum (* (core-number->f64 a) (core-number->f64 b)))
      (if (and (integer-object? a) (integer-object? b)) (integer-mul a b)
        (exact-mul a b)))))
(defn scm-mul-fix [(a i64) (b i64) (x i64) (y i64)] (-> i64)
  (let [ax (if (< x 0) (- 0 x) x) ay (if (< y 0) (- 0 y) y)]
    (if (or (= ax 0) (<= ay (/ 1152921504606846975 ax)))
        (mk-fixnum (* x y)) (integer-mul a b))))
(defn scm-mul [(a i64) (b i64)] (-> i64)
  (if (and (is-fixnum a) (is-fixnum b))
      (scm-mul-fix a b (fixnum-value a) (fixnum-value b))
    (scm-mul-slow a b)))
(defn scm-div [(a i64) (b i64)] (-> i64)
  (if (core-number-zero? b) (core-numeric-fail c"/: division by zero")
    (if (or (is-complex-number a) (is-complex-number b)) (complex-div a b)
    (if (or (is-flonum a) (is-flonum b))
        (mk-flonum (primitive/fdiv (core-number->f64 a) (core-number->f64 b)))
      (exact-div a b)))))
(defn exact-cross-left [(a i64) (b i64)] (-> i64)
  (integer-mul (exact-numerator-val a) (exact-denominator-val b)))
(defn exact-cross-right [(a i64) (b i64)] (-> i64)
  (integer-mul (exact-numerator-val b) (exact-denominator-val a)))
(defn core-finite-flonum->exact [(v i64)] (-> i64)
  ;; Compare mixed exact/inexact values against the exact binary64 value, not
  ;; against an exact operand rounded to binary64. The latter makes adjacent
  ;; huge integers spuriously equal once they share a floating representation.
  (let [bits (f64->raw-bits (flonum-value v))
        neg (= (primitive/cast i64
                 (primitive/ishr (primitive/cast u64 bits) 63)) 1)
        ef (primitive/iand
             (primitive/cast i64 (primitive/ishr (primitive/cast u64 bits) 52))
             2047)
        mant (primitive/iand bits 4503599627370495)]
    (if (= ef 2047) (s-unspecified)
      (if (and (= ef 0) (= mant 0)) (mk-fixnum 0)
        (let [(mut sig) (if (= ef 0) mant (+ mant 4503599627370496))
              (mut e) (if (= ef 0) -1074 (- ef 1075))]
          (loop
            (if (or (>= (primitive/load (mut e)) 0)
                    (not (= (% (primitive/load (mut sig)) 2) 0)))
                (break)
              (do (primitive/store! (mut sig) (/ (primitive/load (mut sig)) 2))
                  (primitive/store! (mut e) (+ (primitive/load (mut e)) 1)))))
          (let [sp (gc-sp)
                s (mk-fixnum (if neg (- 0 (primitive/load (mut sig)))
                                      (primitive/load (mut sig))))]
            (gc-root s)
            (let [power (integer-power-of-two
                          (if (< (primitive/load (mut e)) 0)
                              (- 0 (primitive/load (mut e)))
                            (primitive/load (mut e))))]
              (gc-root power)
              (let [out (if (>= (primitive/load (mut e)) 0)
                            (integer-mul s power)
                          (allocate (tag-ratnum) s power 0))]
                (gc-sp-set! sp) (gc-root out) out))))))))
(defn exact-cmp [(a i64) (b i64)] (-> i64)
  (if (and (integer-object? a) (integer-object? b)) (integer-cmp a b)
    (integer-cmp (exact-cross-left a b) (exact-cross-right a b))))
(defn mixed-flonum-cmp [(exact i64) (inexact i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root exact) (gc-root inexact)
    (let [as-exact (core-finite-flonum->exact inexact)]
      (gc-root as-exact)
      (let [result (if (val-eq? as-exact (s-unspecified))
                       (if (< (core-number->f64 exact) (flonum-value inexact)) -1
                         (if (> (core-number->f64 exact) (flonum-value inexact)) 1 0))
                     (exact-cmp exact as-exact))]
        (gc-sp-set! sp)
        result))))
(defn scm-lt-slow [(a i64) (b i64)] (-> i64)
  (mk-bool (if (and (is-flonum a) (not (is-flonum b)))
               (> (mixed-flonum-cmp b a) 0)
             (if (and (not (is-flonum a)) (is-flonum b))
               (< (mixed-flonum-cmp a b) 0)
             (if (or (is-flonum a) (is-flonum b))
               (< (core-number->f64 a) (core-number->f64 b))
             (if (and (integer-object? a) (integer-object? b))
                 (< (integer-cmp a b) 0)
               (< (integer-cmp (exact-cross-left a b) (exact-cross-right a b)) 0)))))))
(defn scm-lt [(a i64) (b i64)] (-> i64)
  (if (and (is-fixnum a) (is-fixnum b))
      (mk-bool (< (fixnum-value a) (fixnum-value b))) (scm-lt-slow a b)))
(defn scm-fixnum-lt [(a i64) (b i64)] (-> i64)
  (mk-bool (< (fixnum-value a) (fixnum-value b))))
(defn scm-gt-slow [(a i64) (b i64)] (-> i64)
  (mk-bool (if (and (is-flonum a) (not (is-flonum b)))
               (< (mixed-flonum-cmp b a) 0)
             (if (and (not (is-flonum a)) (is-flonum b))
               (> (mixed-flonum-cmp a b) 0)
             (if (or (is-flonum a) (is-flonum b))
               (> (core-number->f64 a) (core-number->f64 b))
             (if (and (integer-object? a) (integer-object? b))
                 (> (integer-cmp a b) 0)
               (> (integer-cmp (exact-cross-left a b) (exact-cross-right a b)) 0)))))))
(defn scm-gt [(a i64) (b i64)] (-> i64)
  (if (and (is-fixnum a) (is-fixnum b))
      (mk-bool (> (fixnum-value a) (fixnum-value b))) (scm-gt-slow a b)))
(defn scm-le-slow [(a i64) (b i64)] (-> i64)
  (mk-bool (if (and (is-flonum a) (not (is-flonum b)))
               (>= (mixed-flonum-cmp b a) 0)
             (if (and (not (is-flonum a)) (is-flonum b))
               (<= (mixed-flonum-cmp a b) 0)
             (if (or (is-flonum a) (is-flonum b))
               (<= (core-number->f64 a) (core-number->f64 b))
             (if (and (integer-object? a) (integer-object? b))
                 (<= (integer-cmp a b) 0)
               (<= (integer-cmp (exact-cross-left a b) (exact-cross-right a b)) 0)))))))
(defn scm-le [(a i64) (b i64)] (-> i64)
  (if (and (is-fixnum a) (is-fixnum b))
      (mk-bool (<= (fixnum-value a) (fixnum-value b))) (scm-le-slow a b)))
(defn scm-ge-slow [(a i64) (b i64)] (-> i64)
  (mk-bool (if (and (is-flonum a) (not (is-flonum b)))
               (<= (mixed-flonum-cmp b a) 0)
             (if (and (not (is-flonum a)) (is-flonum b))
               (>= (mixed-flonum-cmp a b) 0)
             (if (or (is-flonum a) (is-flonum b))
               (>= (core-number->f64 a) (core-number->f64 b))
             (if (and (integer-object? a) (integer-object? b))
                 (>= (integer-cmp a b) 0)
               (>= (integer-cmp (exact-cross-left a b) (exact-cross-right a b)) 0)))))))
(defn scm-ge [(a i64) (b i64)] (-> i64)
  (if (and (is-fixnum a) (is-fixnum b))
      (mk-bool (>= (fixnum-value a) (fixnum-value b))) (scm-ge-slow a b)))
(defn scm-num-eq-slow [(a i64) (b i64)] (-> i64)
  (if (and (is-flonum a) (not (is-flonum b)))
      (mk-bool (= (mixed-flonum-cmp b a) 0))
  (if (and (not (is-flonum a)) (is-flonum b))
      (mk-bool (= (mixed-flonum-cmp a b) 0))
  (if (or (is-flonum a) (is-flonum b))
      (mk-bool (primitive/fcmp-eq (core-number->f64 a) (core-number->f64 b)))
    (if (and (integer-object? a) (integer-object? b))
        (mk-bool (= (integer-cmp a b) 0))
      (mk-bool (= (integer-cmp (exact-cross-left a b) (exact-cross-right a b)) 0)))))))
(defn scm-num-eq [(a i64) (b i64)] (-> i64)
  (if (or (is-complex-number a) (is-complex-number b))
      (mk-bool
        (and (truthy? (scm-num-eq (number-real-part a) (number-real-part b)))
             (truthy? (scm-num-eq (number-imag-part a) (number-imag-part b)))))
    (if (and (is-fixnum a) (is-fixnum b))
        (mk-bool (= (fixnum-value a) (fixnum-value b))) (scm-num-eq-slow a b))))

; ---- pairs and lists --------------------------------------------------------
(defn scm-car [(v i64)] (-> i64) (car v))
(defn scm-cdr [(v i64)] (-> i64) (cdr v))
(defn scm-cons [(a i64) (d i64)] (-> i64) (cons a d))
(defn scm-null? [(v i64)] (-> i64) (mk-bool (is-null v)))
(defn scm-pair? [(v i64)] (-> i64) (mk-bool (is-pair v)))

;; R5RS eqv?: identical for immediates (fixnums, booleans, chars, nil) and
;; pointer-identical for heap objects. Symbols satisfy it because interning makes
;; two same-named symbols the same object.
(defn scm-eqv? [(a i64) (b i64)] (-> i64)
  (if (or (is-complex-number a) (is-complex-number b))
      (scm-num-eq a b)
    (if (and (is-flonum a) (is-flonum b))
        (mk-bool (primitive/fcmp-eq (flonum-value a) (flonum-value b)))
      (if (and (or (is-fixnum a) (or (is-bignum a) (is-ratnum a)))
               (or (is-fixnum b) (or (is-bignum b) (is-ratnum b))))
          (scm-num-eq a b)
        (mk-bool (val-eq? a b))))))

; ---- output -----------------------------------------------------------------
;; `display` writes human-readable (strings unquoted), `write` machine-readable.
;; Only display is here so far; the distinction matters and is not yet made.
(defn scm-display [(v i64)] (-> i64)
  (let [w (stdout)]
    (if (is-fixnum v) (do (fmt w "{d}" (fixnum-value v)) 0)
      (if (val-eq? v (s-true)) (do (fmt w "#t") 0)
        (if (val-eq? v (s-false)) (do (fmt w "#f") 0)
          (if (is-null v) (do (fmt w "()") 0)
            (if (is-symbol v) (do (fmt w "{s}" (symbol-name v)) 0)
              (if (is-pair v) (do (fmt w "(") (scm-display-list v) (fmt w ")") 0)
                (do (fmt w "#<object>") 0)))))))))

;; A list prints as `(a b c)`, and an improper tail as `(a . b)` — R5RS external
;; representation, and the reason this cannot just loop over cdrs blindly.
(defn scm-display-list [(v i64)] (-> i64)
  (scm-display (car v))
  (let [d (cdr v)]
    (if (is-null d) 0
      (if (is-pair d) (do (fmt (stdout) " ") (scm-display-list d) 0)
        (do (fmt (stdout) " . ") (scm-display d) 0)))))

(defn scm-newline [] (-> i64) (fmt (stdout) "\n") 0)

;; ⚠ EXPORT ONLY THE R5RS-SPELLED SURFACE.
;;
;; This module's `scm-` names are implementation spellings. If they were exported
;; they would reach every Scheme program through the umbrella, and `(scm-append
;; a b)` would compile — at which point the language being written is a lookalike
;; rather than Scheme. `coil.scheme.r5rs` reaches them through a qualified alias
;; and re-binds each under its standard name.
;; ⚠ The `scm-` names here are exported for ONE reason: macros in forms.coil and
;; derived*.coil expand to them, and a symbol in a macro template resolves in the
;; MACRO's namespace — so `<` expanding to `scm-lt` needs `scm-lt` visible where
;; the macro was defined, not where it was called.
;;
;; They are still not part of the Scheme surface. `coil.scheme.lint` reports any
;; `scm-` identifier written in a module that imports `coil.scheme`, so the
;; expansion works while the spelling stays unwritable by hand — which is the
;; distinction that matters: generated code may use them, source code may not.
;; Everything below is exported for this module's own _test.coil and for macros
;; that expand to these names. `coil.scheme.lint` still rejects any `scm-` name
;; written by hand in Scheme source, so this does not widen the Scheme surface.
(export
        define
        scheme-tail
        scm--assq
        scm--false
        scm--genv
        scm--genv-find
        scm--global-install
        scm--global-read
        scm--global-write
        scm--params
        scm--true
        scm--variadic?
        scm-add
        scm-add-slow
        scm-fixnum-add
        scm-car
        scm-cdr
        scm-cons
        scm-display
        scm-display-list
        scm-div
        scm-integer-literal
        scm-rational-literal
        core-number->f64
        core-number-zero?
        number-real-part
        number-imag-part
        scm-eqv?
        scm-gt
        scm-ge
        scm-le
        scm-lt
        scm-lt-slow
        scm-fixnum-lt
        scm-mul
        scm-newline
        scm-null?
        scm-num-eq
        scm-pair?
        scm-set!
        scm-sub
        scm-sub-slow
        scm-fixnum-sub
 define scheme-tail
        scm-eqv? scm-null? scm-pair? scm-cons scm-car scm-cdr scm-add scm-sub scm-mul scm-div scm-lt scm-gt scm-num-eq
        scm-le scm-ge scm-display scm-newline scm-set! scm-true scm-false scm-let)
