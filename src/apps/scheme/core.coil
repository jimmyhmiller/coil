(module coil.scheme.core)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.symbol" :use *)

;; The R5RS surface, as ordinary Coil macros and functions.
;;
;; There is no interpreter here and no compiler. Scheme syntax is already Coil
;; syntax — the same reader produces the same s-expressions — so `define` is a
;; macro that expands to `defn`, `lambda` to a closure, `cond` to nested `if`.
;; What reaches codegen is an ordinary Coil program, and it runs at native speed
;; because it IS native code.
;;
;; Every Scheme value is a `Val` (a tagged i64, see value.coil), because Scheme is
;; dynamically typed: a function's parameter can hold a fixnum on one call and a
;; pair on the next, so one uniform representation is not an optimization choice
;; but a requirement.
;;
;; NOT implemented, by decision (see ../../tests/scheme/out-of-scope/):
;; unbounded tail calls, call/cc, dynamic-wind. Recursion here runs on the native
;; stack and is bounded by it.

; ---- define -----------------------------------------------------------------
;; `(define (f a b) body …)` -> a defn over Val; `(define x e)` -> a global cell.
;;
;; The two shapes are told apart by whether the head is a list, which is exactly
;; how R5RS distinguishes them. Variadic `(define (f . rest) …)` and
;; `(define (f a . rest) …)` are handled by scanning for the dot.

(defn scm--params [(sig Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `[]
    (let [p (primitive/code-nth sig i)]
      ; a `.` marks the rest parameter: everything after it is one list
      (if (primitive/code-eq p `.)
          `[(~(primitive/code-nth sig (+ i 1)) i64)]
        `[(~p i64) ~@(scm--params sig (+ i 1) n)]))))

;; True when the signature has a dotted rest parameter.
(defn scm--variadic? [(sig Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (primitive/code-eq (primitive/code-nth sig i) `.) true
      (scm--variadic? sig (+ i 1) n))))

(defn define [(head Code) & (body Code)] (-> Code)
  (if (primitive/code-list? head)
      ; (define (f args…) body…)
      `(defn ~(primitive/code-nth head 0)
             ~(scm--params head 1 (primitive/code-count head))
             (-> i64)
         ~@body)
    ; (define x e) — a global cell, so `set!` can reassign it
    `(defn ~head [] (-> i64)
       (let [c (alloc/static i64)]
         (if (= (primitive/load c) 0)
             (primitive/store! c ~(primitive/code-nth body 0))
           0)
         (primitive/load c)))))

; ---- the immediate literals -------------------------------------------------
;; `#t`, `#f` and `'()` read as ordinary symbols, so they are bound like any
;; other name rather than needing reader support.
(defn scm--true [] (-> i64) (s-true))
(defn scm--false [] (-> i64) (s-false))

; ---- arithmetic and comparison ----------------------------------------------
;; R5RS `+ - * < =` are variadic; these are the binary core the macros fold onto.
;; Fixnum-only for now — the numeric tower (bignums, rationals) is a later phase,
;; and `value.coil` reserves the tags for it.
(defn scm-add [(a i64) (b i64)] (-> i64) (mk-fixnum (+ (fixnum-value a) (fixnum-value b))))
(defn scm-sub [(a i64) (b i64)] (-> i64) (mk-fixnum (- (fixnum-value a) (fixnum-value b))))
(defn scm-mul [(a i64) (b i64)] (-> i64) (mk-fixnum (* (fixnum-value a) (fixnum-value b))))
(defn scm-lt [(a i64) (b i64)] (-> i64) (mk-bool (< (fixnum-value a) (fixnum-value b))))
(defn scm-gt [(a i64) (b i64)] (-> i64) (mk-bool (> (fixnum-value a) (fixnum-value b))))
(defn scm-num-eq [(a i64) (b i64)] (-> i64) (mk-bool (= (fixnum-value a) (fixnum-value b))))

; ---- pairs and lists --------------------------------------------------------
(defn scm-car [(v i64)] (-> i64) (car v))
(defn scm-cdr [(v i64)] (-> i64) (cdr v))
(defn scm-cons [(a i64) (d i64)] (-> i64) (cons a d))
(defn scm-null? [(v i64)] (-> i64) (mk-bool (null? v)))
(defn scm-pair? [(v i64)] (-> i64) (mk-bool (pair? v)))

;; R5RS eqv?: identical for immediates (fixnums, booleans, chars, nil) and
;; pointer-identical for heap objects. Symbols satisfy it because interning makes
;; two same-named symbols the same object.
(defn scm-eqv? [(a i64) (b i64)] (-> i64) (mk-bool (val-eq? a b)))

; ---- output -----------------------------------------------------------------
;; `display` writes human-readable (strings unquoted), `write` machine-readable.
;; Only display is here so far; the distinction matters and is not yet made.
(defn scm-display [(v i64)] (-> i64)
  (let [w (stdout)]
    (if (fixnum? v) (do (fmt w "{d}" (fixnum-value v)) 0)
      (if (val-eq? v (s-true)) (do (fmt w "#t") 0)
        (if (val-eq? v (s-false)) (do (fmt w "#f") 0)
          (if (null? v) (do (fmt w "()") 0)
            (if (symbol? v) (do (fmt w "{s}" (symbol-name v)) 0)
              (if (pair? v) (do (fmt w "(") (scm-display-list v) (fmt w ")") 0)
                (do (fmt w "#<object>") 0)))))))))

;; A list prints as `(a b c)`, and an improper tail as `(a . b)` — R5RS external
;; representation, and the reason this cannot just loop over cdrs blindly.
(defn scm-display-list [(v i64)] (-> i64)
  (scm-display (car v))
  (let [d (cdr v)]
    (if (null? d) 0
      (if (pair? d) (do (fmt (stdout) " ") (scm-display-list d) 0)
        (do (fmt (stdout) " . ") (scm-display d) 0)))))

(defn scm-newline [] (-> i64) (fmt (stdout) "\n") 0)
