(module coil.scheme.core)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.symbol" :use *)

;; The R5RS surface, as ordinary Coil macros and functions.
;;
;; There is no interpreter here and no compiler. Scheme syntax is already Coil
;; syntax — the same reader produces the same s-expressions — so `define` is a
;; macro that expands to `defn`, `lambda` to a closure, `cond` to nested `if`.
;; What reaches codegen is an ordinary Coil program, and it runs at native speed
;; because it IS native code.
;;
;; Every Scheme value is a `Val` (a tagged i64, see value.coil), because Scheme is
;; dynamically typed: a function's parameter can hold a fixnum on one call and a
;; pair on the next, so one uniform representation is not an optimization choice
;; but a requirement.
;;
;; NOT implemented, by decision (see ../../tests/scheme/out-of-scope/):
;; unbounded tail calls, call/cc, dynamic-wind. Recursion here runs on the native
;; stack and is bounded by it.

; ---- define -----------------------------------------------------------------
;; `(define (f a b) body …)` -> a defn over Val; `(define x e)` -> a global cell.
;;
;; The two shapes are told apart by whether the head is a list, which is exactly
;; how R5RS distinguishes them. Variadic `(define (f . rest) …)` and
;; `(define (f a . rest) …)` are handled by scanning for the dot.

(defn scm--params [(sig Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `[]
    (let [p (primitive/code-nth sig i)]
      ; a `.` marks the rest parameter: everything after it is one list
      (if (primitive/code-eq p `.)
          `[(~(primitive/code-nth sig (+ i 1)) i64)]
        `[(~p i64) ~@(scm--params sig (+ i 1) n)]))))

;; True when the signature has a dotted rest parameter.
(defn scm--variadic? [(sig Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (primitive/code-eq (primitive/code-nth sig i) `.) true
      (scm--variadic? sig (+ i 1) n))))

;; A global variable's storage, as EXPORTED functions rather than an inline
;; expansion.
;;
;; ⚠ TWO HOST CONSTRAINTS MEET HERE, AND TOGETHER THEY RULE OUT THE OBVIOUS
;; IMPLEMENTATIONS.
;;
;; 1. `alloc-static` gives one cell per CALL SITE, not per call. A shared
;;    `(defn scm--new-cell [] (alloc/static i64))` here is ONE site, so every
;;    global in the program would alias the same word.
;; 2. A macro expands in the CALLER's namespace, so the expansion cannot name
;;    `alloc/static` or `primitive/…` — those are aliases of THIS module's
;;    imports. Emitting them fails with "call to undefined function
;;    'alloc/static'", and namespace aliases do NOT transit `:reexport`, so the
;;    umbrella cannot rescue them either (verified).
;;
;; So the storage is a HEAP CELL from the Scheme heap, keyed by the variable's
;; interned symbol: a global is an entry in a genuine global environment. That
;; needs no per-site allocation (constraint 1 gone) and no namespace-qualified
;; name at the call site (constraint 2 gone), and the collector already traces it,
;; so a global holding a list keeps that list alive — which an `alloc/static` word
;; would NOT have done, since the tracer never scans .bss. That last point makes
;; this the more correct design regardless of the constraints.
;;
;; The environment is an association list of (symbol . value) pairs, living in
;; heap.coil's `globals` cell — the permanent root `mark-roots` traces before the
;; shadow stack, reserved there for exactly this. Globals are few and looked up
;; once per reference, so a list is the right shape; a hash table would be more
;; machinery for no measurable gain at this size.
(defn scm--assq [(s i64) (l i64)] (-> i64)
  (if (null? l) (s-nil)
    (if (val-eq? (car (car l)) s) (car l)
      (scm--assq s (cdr l)))))

;; ⚠ The `globals` cell starts as a ZERO WORD (.bss), and nil is 23 — so the raw
;; cell is NOT the empty list. Reading it directly made `scm--assq` fail its
;; `null?` test and dereference 0 as a pair: an immediate SIGSEGV on the first
;; `define`. Normalizing 0 to nil here is what makes "no globals yet" and "the
;; empty environment" the same thing, and it is the only place that has to know.
(defn scm--genv [] (-> i64)
  (let [g (globals)]
    (if (= g 0) (s-nil) g)))

;; Find the (symbol . value) pair for `s`, or nil.
(defn scm--genv-find [(s i64)] (-> i64) (scm--assq s (scm--genv)))

;; Read a global, initializing it on first reference.
;;
;; The init is passed as a value, so it is evaluated on every read — but it is
;; only STORED once, on the first. That matters for `(define x (list 1 2))`:
;; re-reading must not rebuild the list, or `set!` would be undone and `eq?` on
;; the same global would be false.
(defn scm--global-read [(s i64) (init i64)] (-> i64)
  (let [p (scm--genv-find s)]
    (if (null? p)
        (do (set-globals! (cons (cons s init) (scm--genv)))
            init)
      (cdr p))))

;; `set!` on an existing binding mutates the pair in place, so every reference
;; sees the new value. R5RS returns an unspecified value.
(defn scm--global-write [(s i64) (v i64)] (-> i64)
  (let [p (scm--genv-find s)]
    (if (null? p)
        (set-globals! (cons (cons s v) (scm--genv)))
      (set-cdr! p v))
    (s-unspecified)))

(defn define [(head Code) & (body Code)] (-> Code)
  (if (primitive/code-list? head)
      ; (define (f args…) body…)
      `(defn ~(primitive/code-nth head 0)
             ~(scm--params head 1 (primitive/code-count head))
             (-> i64)
         ~@body)
    ; (define x e) — a zero-argument getter over the global environment, keyed by
    ; the variable's interned symbol, because R5RS `set!` must be able to reassign
    ; it. Every name the expansion mentions — `scm--global-read`, `intern` — is
    ; exported by this module and reaches the user through `:use *`, which is what
    ; keeps the macro from leaking its own namespace.
    `(defn ~head [] (-> i64)
       (scm--global-read (intern ~(primitive/code-str head))
                         ~(primitive/code-nth body 0)))))

; ---- set! -------------------------------------------------------------------
;; R5RS `(set! x e)`. Coil reserves `set!` as a 3-argument trait method (the Set
;; trait), so Scheme's 2-argument form cannot use that name — it fails with
;; "'set!' expects 3 args, got 2" and the name cannot be rebound. `scm-set!` is
;; the same treatment `do` and `quasiquote` get, and `dialect.coil` routes the
;; Scheme spelling to it.
;;
;; Only GLOBALS are assignable: this writes the global environment entry for the
;; name's symbol. A `set!` on a LOCAL (a `let` binding or a parameter) is NOT
;; supported — Coil locals are immutable unless declared `(mut …)`, and nothing
;; rewrites a Scheme binding into one. Such a `set!` silently writes a global of
;; the same name instead of the local, which is the one sharp edge here.
(defn scm-set! [(name Code) (v Code)] (-> Code)
  `(scm--global-write (intern ~(primitive/code-str name)) ~v))

; ---- the immediate literals -------------------------------------------------
;; `#t`, `#f` and `'()` read as ordinary symbols, so they are bound like any
;; other name rather than needing reader support.
(defn scm--true [] (-> i64) (s-true))
(defn scm--false [] (-> i64) (s-false))

; ---- arithmetic and comparison ----------------------------------------------
;; R5RS `+ - * < =` are variadic; these are the binary core the macros fold onto.
;; Fixnum-only for now — the numeric tower (bignums, rationals) is a later phase,
;; and `value.coil` reserves the tags for it.
(defn scm-add [(a i64) (b i64)] (-> i64) (mk-fixnum (+ (fixnum-value a) (fixnum-value b))))
(defn scm-sub [(a i64) (b i64)] (-> i64) (mk-fixnum (- (fixnum-value a) (fixnum-value b))))
(defn scm-mul [(a i64) (b i64)] (-> i64) (mk-fixnum (* (fixnum-value a) (fixnum-value b))))
(defn scm-lt [(a i64) (b i64)] (-> i64) (mk-bool (< (fixnum-value a) (fixnum-value b))))
(defn scm-gt [(a i64) (b i64)] (-> i64) (mk-bool (> (fixnum-value a) (fixnum-value b))))
(defn scm-num-eq [(a i64) (b i64)] (-> i64) (mk-bool (= (fixnum-value a) (fixnum-value b))))

; ---- pairs and lists --------------------------------------------------------
(defn scm-car [(v i64)] (-> i64) (car v))
(defn scm-cdr [(v i64)] (-> i64) (cdr v))
(defn scm-cons [(a i64) (d i64)] (-> i64) (cons a d))
(defn scm-null? [(v i64)] (-> i64) (mk-bool (null? v)))
(defn scm-pair? [(v i64)] (-> i64) (mk-bool (pair? v)))

;; R5RS eqv?: identical for immediates (fixnums, booleans, chars, nil) and
;; pointer-identical for heap objects. Symbols satisfy it because interning makes
;; two same-named symbols the same object.
(defn scm-eqv? [(a i64) (b i64)] (-> i64) (mk-bool (val-eq? a b)))

; ---- output -----------------------------------------------------------------
;; `display` writes human-readable (strings unquoted), `write` machine-readable.
;; Only display is here so far; the distinction matters and is not yet made.
(defn scm-display [(v i64)] (-> i64)
  (let [w (stdout)]
    (if (fixnum? v) (do (fmt w "{d}" (fixnum-value v)) 0)
      (if (val-eq? v (s-true)) (do (fmt w "#t") 0)
        (if (val-eq? v (s-false)) (do (fmt w "#f") 0)
          (if (null? v) (do (fmt w "()") 0)
            (if (symbol? v) (do (fmt w "{s}" (symbol-name v)) 0)
              (if (pair? v) (do (fmt w "(") (scm-display-list v) (fmt w ")") 0)
                (do (fmt w "#<object>") 0)))))))))

;; A list prints as `(a b c)`, and an improper tail as `(a . b)` — R5RS external
;; representation, and the reason this cannot just loop over cdrs blindly.
(defn scm-display-list [(v i64)] (-> i64)
  (scm-display (car v))
  (let [d (cdr v)]
    (if (null? d) 0
      (if (pair? d) (do (fmt (stdout) " ") (scm-display-list d) 0)
        (do (fmt (stdout) " . ") (scm-display d) 0)))))

(defn scm-newline [] (-> i64) (fmt (stdout) "\n") 0)

;; ⚠ EXPORT ONLY THE R5RS-SPELLED SURFACE.
;;
;; This module's `scm-` names are implementation spellings. If they were exported
;; they would reach every Scheme program through the umbrella, and `(scm-append
;; a b)` would compile — at which point the language being written is a lookalike
;; rather than Scheme. `coil.scheme.r5rs` reaches them through a qualified alias
;; and re-binds each under its standard name.
;; ⚠ The `scm-` names here are exported for ONE reason: macros in forms.coil and
;; derived*.coil expand to them, and a symbol in a macro template resolves in the
;; MACRO's namespace — so `<` expanding to `scm-lt` needs `scm-lt` visible where
;; the macro was defined, not where it was called.
;;
;; They are still not part of the Scheme surface. `coil.scheme.lint` reports any
;; `scm-` identifier written in a module that imports `coil.scheme`, so the
;; expansion works while the spelling stays unwritable by hand — which is the
;; distinction that matters: generated code may use them, source code may not.
(export define
        scm-eqv? scm-add scm-sub scm-mul scm-lt scm-gt scm-num-eq
        scm-display scm-newline scm-set! scm-true scm-false scm-let)
