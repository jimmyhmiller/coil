(module coil.scheme)

;; Macro expansions for lifted lambdas need the host's function-address
;; primitive in the caller namespace because imports added by a before-expand
;; transform are too late for loader alias resolution. The Scheme source lint
;; rejects this implementation spelling when written by users.
(import "coil.primitive" :use [fnptr-of] :reexport)

;; The Scheme dialect. One import, and you write REAL Scheme.
;;
;;

;; ⚠ THE IMPLEMENTATION MODULES ARE IMPORTED BUT NOT RE-EXPORTED.
;;
;; `:reexport` forwards a module's names through this one. Doing that for
;; stdproc/numeric/core would put `scm-append`, `scm-cadr` and the rest in every
;; Scheme program's scope — which is exactly the leak this arrangement exists to
;; close. They are imported qualified (`:as`) so `r5rs.coil` can reach them, and
;; re-exported not at all.

;; ⚠ THE IMPLEMENTATION MODULES ARE RE-EXPORTED, BUT THEY EXPORT ONLY THEIR
;; R5RS-SPELLED SURFACE.
;;
;; Each of core/derived/derived2/numeric/stdproc ends with an explicit `(export
;; …)` naming just the standard procedures it defines. Its `scm-` spellings are
;; implementation detail and are NOT exported, so they never reach a Scheme
;; program's scope: `(scm-append a b)` is undefined at the call site rather than
;; merely discouraged. `coil.scheme.lint` reports any that appear anyway.
(import "coil.scheme.core" :use * :reexport)
(import "coil.scheme.closure" :use * :reexport)
(import "coil.scheme.lambda" :use * :reexport)
(import "coil.scheme.derived" :use * :reexport)
(import "coil.scheme.derived2" :use * :reexport)
(import "coil.scheme.numeric" :use * :reexport)
(import "coil.scheme.stdproc" :use * :reexport)
(import "coil.scheme.port" :use * :reexport)
(import "coil.scheme.eval" :use * :reexport)
(import "coil.scheme.value" :use * :reexport)
(import "coil.scheme.heap" :use * :reexport)
(import "coil.scheme.symbol" :use * :reexport)
(import "coil.scheme.forms" :use * :reexport)
(import "coil.scheme.dialect" :use * :reexport)
(import "coil.scheme.lint" :use * :reexport)
