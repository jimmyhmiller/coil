(module coil.scheme)
;; The dialect, in one import.
;;
;;     (import "coil.scheme")
;;     (define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
;;
;; Importing this brings the R5RS surface into scope AND registers the
;; before-expand transform that rewrites the Scheme spellings of forms Coil
;; reserves (see dialect.coil). Both are needed: the library supplies the
;; bindings, the transform supplies the syntax Coil would otherwise claim.
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.symbol" :use *)
(import "coil.scheme.core" :use *)
(import "coil.scheme.lambda" :use *)
(import "coil.scheme.derived" :use *)
(import "coil.scheme.dialect" :use *)
