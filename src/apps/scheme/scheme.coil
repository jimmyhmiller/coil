(module coil.scheme)
;; The dialect, in one import.
;;
;;     (import "coil.scheme")
;;     (define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
;;
;; `:reexport` is what makes one line enough: it forwards each module's exported
;; names through this one, so a user importing `coil.scheme` gets the whole R5RS
;; surface without naming its pieces. Without it, `(export …)` here would only
;; cover names this module itself defines — and it defines none.
;;
;; Importing this is ALSO the dialect's opt-in marker: `coil.scheme.dialect`'s
;; transform looks for exactly this import to decide which modules to rewrite.
(import "coil.scheme.value" :use * :reexport)
(import "coil.scheme.heap" :use * :reexport)
(import "coil.scheme.symbol" :use * :reexport)
(import "coil.scheme.core" :use * :reexport)
(import "coil.scheme.lambda" :use * :reexport)
(import "coil.scheme.derived" :use * :reexport)
(import "coil.scheme.numeric" :use * :reexport)
(import "coil.scheme.stdproc" :use * :reexport)
(import "coil.scheme.derived2" :use * :reexport)
(import "coil.scheme.forms" :use * :reexport)
(import "coil.scheme.dialect" :use * :reexport)
