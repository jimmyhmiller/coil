(module coil.scheme.lambda)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.str" :use [str-eq str-keyops-borrowed])
(import "coil.hashmap" :use *)
(import "coil.slice" :use [slice-len subslice])
(import "coil.io" :as io)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.closure" :use *)
(import "coil.scheme.stdproc"
        :use [call--0 call--1 call--2 call--3 call--4 call--5 call--6])

(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))
(extern clock :cc c [] (-> i64))
(defn lam--trace [(stage (slice u8)) (m Code)] (-> i64)
  (let [enabled (getenv c"COIL_SCHEME_STAGE_TRACE")]
    (if (= (primitive/cast i64 enabled) 0) 0
      (let [w (io/stderr)]
        (io/print-str w "scheme-lambda  stage=")
        (io/print-str w stage)
        (io/print-str w "  module=")
        (if (and (primitive/code-list? m) (> (primitive/code-count m) 0))
            (io/print-str w (primitive/code-str (primitive/code-nth m 0)))
          (io/print-str w "<malformed>"))
        (io/print-str w "  forms=")
        (io/print-int w (if (primitive/code-list? m) (primitive/code-count m) -1))
        (io/print-str w "  ticks=")
        (io/print-int w (clock))
        (io/write-byte w (primitive/cast u8 10))
        0))))

(defn lam--trace-form [(i i64) (f Code)] (-> i64)
  (let [enabled (getenv c"COIL_SCHEME_TRACE")]
    (if (= (primitive/cast i64 enabled) 0) 0
      (let [w (io/stderr)]
        (io/print-str w "scheme-lambda  lift-form=")
        (io/print-int w i)
        (io/print-str w "  head=")
        (if (and (primitive/code-list? f) (> (primitive/code-count f) 0))
            (io/print-str w (primitive/code-str (primitive/code-nth f 0)))
          (io/print-str w "<atom>"))
        (io/print-str w "  count=")
        (io/print-int w (if (primitive/code-list? f) (primitive/code-count f) -1))
        (when (and (primitive/code-list? f)
                   (and (>= (primitive/code-count f) 2)
                        (lam--name? (primitive/code-nth f 0) "define")))
          (let [target (primitive/code-nth f 1)]
            (io/print-str w "  name=")
            (if (and (primitive/code-list? target)
                     (> (primitive/code-count target) 0))
                (io/print-str w (primitive/code-str (primitive/code-nth target 0)))
              (io/print-str w (primitive/code-str target)))
            0))
        (io/write-byte w (primitive/cast u8 10))
        0))))

;; `lambda` — procedures as values, with captures found automatically.
;;
;; Coil's `defclosure` needs its captures declared. Scheme's `lambda` captures
;; whatever it mentions, so the macro has to work out the free variables itself:
;; walk the body, collect every symbol that is not a parameter, not a local
;; binding, and not a known global. What is left is the capture set.
;;
;; A closure is a heap object: `a` = a function pointer, `b` = the captured
;; environment (a Scheme list), `c` = arity. Representing the environment as an
;; ordinary list rather than a bespoke struct means the collector already traces
;; it — a closure keeps its captures alive through the same path as any pair,
;; which is the property that makes closures and GC compose instead of fight.

(defn lam--call-code [(proc Code) (args Code) (n i64)] (-> Code)
  (if (= n 0) `(call--0 ~proc ~@args)
    (if (= n 1) `(call--1 ~proc ~@args)
      (if (= n 2) `(call--2 ~proc ~@args)
        (if (= n 3) `(call--3 ~proc ~@args)
          (if (= n 4) `(call--4 ~proc ~@args)
            (if (= n 5) `(call--5 ~proc ~@args)
              `(call--6 ~proc ~@args))))))))

; ---- free-variable analysis -------------------------------------------------
;; Is `name` bound anywhere in `bound` (a Code list acting as a set)?
(defn lam--member? [(name Code) (bound Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (primitive/code-eq (primitive/code-nth bound i) name) true
      (lam--member? name bound (+ i 1) n))))

;; Append by copying only the left spine. With persistent Code pairs this is
;; linear in the newly contributed prefix and shares the complete suffix.
(defn lam--append [(xs Code) (ys Code)] (-> Code)
  (if (primitive/code-null? xs)
      ys
      (primitive/code-cons (primitive/code-car xs)
                           (lam--append (primitive/code-cdr xs) ys))))

(defn lam--quote-head? [(h Code)] (-> bool)
  (or (lam--name? h "quote") (lam--name? h "quote-data")))

(defn lam--module-decl-head? [(h Code)] (-> bool)
  (if (not (primitive/code-sym? h)) false
    (let [s (primitive/code-str h)]
      (or (str-eq s "import")
          (or (str-eq s "export")
              (or (str-eq s "coil.core.import") (str-eq s "coil.core.export")))))))

(defn lam--name? [(h Code) (want (slice u8))] (-> bool)
  (if (not (primitive/code-sym? h)) false
    (let [name (primitive/code-str h) n (slice-len name) wn (slice-len want)]
      (or (str-eq name want)
          (and (> n wn)
               (and (= (subslice name (- n wn) n) want)
                    (= (subslice name (- (- n wn) 1) (- n wn)) ".")))))))
(defn lam--lambda-head? [(h Code)] (-> bool) (lam--name? h "lambda"))
(defn lam--scheme-let-head? [(h Code)] (-> bool)
  (or (lam--name? h "let") (lam--name? h "scm-let")))
(defn lam--let-star-head? [(h Code)] (-> bool)
  (or (lam--name? h "let*") (lam--name? h "scm-let*")))
(defn lam--letrec-head? [(h Code)] (-> bool)
  (or (lam--name? h "letrec") (lam--name? h "letrec*")))

;; Fixed-arity R5RS procedures that can be named as ordinary values. Calls in
;; head position remain direct; only a bare reference is wrapped. `+` and `*`
;; are handled separately as true variadic reducers.
(defn lam--primitive-arity [(s Code)] (-> i64)
  (if (str-eq (primitive/code-str s) "call-with-current-continuation") 1
  (if (str-eq (primitive/code-str s) "dynamic-wind") 3
  (if (or (primitive/code-eq s `current-input-port)
          (or (primitive/code-eq s `current-output-port)
              (primitive/code-eq s `transcript-off))) 0
  (if (or (primitive/code-eq s `car)
          (or (primitive/code-eq s `cadr)
              (primitive/code-eq s `char-downcase))) 1
  (let [one '(car cdr caar cadr cdar cddr caddr cdddr caadr cddar cadar cdadr cadddr
               caaar cdaar caaaar caaadr caadar caaddr cadaar cadadr caddar
               cdaaar cdaadr cdadar cdaddr cddaar cddadr cdddar cddddr
               length reverse list? null? pair?
               number? integer? exact? inexact? zero? positive? negative? odd? even?
               complex? real? rational? numerator denominator magnitude angle
               acos asin cos exp log floor ceiling truncate round sin sqrt tan
               exact->inexact inexact->exact real-part imag-part
               symbol? string? vector? procedure? boolean? char? not abs
               char-downcase char-upcase char->integer integer->char
               char-alphabetic? char-numeric? char-whitespace?
               char-upper-case? char-lower-case?
               string-length string->list list->string string->symbol
               symbol->string string-copy vector-length vector->list list->vector
               input-port? output-port? eof-object? open-input-file open-output-file
               close-input-port close-output-port force
               transcript-on
               call-with-current-continuation)
        two '(cons set-car! set-cdr! eq? eqv? equal? memq memv member assq assv assoc
               quotient remainder modulo expt
               rationalize make-rectangular make-polar
               list-tail list-ref string-ref string-append string=? string<?
               string>? string<=? string>=? string-ci=? string-ci<? string-ci>?
               string-ci<=? string-ci>=? string-fill!
               char=? char<? char>? char<=? char>=?
               char-ci=? char-ci<? char-ci>? char-ci<=? char-ci>=?
               vector-ref vector-fill! call-with-input-file call-with-output-file
               with-input-from-file with-output-to-file call-with-values)
        three '(vector-set! string-set! substring dynamic-wind)]
    (if (lam--member? s one 0 (primitive/code-count one)) 1
      (if (lam--member? s two 0 (primitive/code-count two)) 2
        (if (lam--member? s three 0 (primitive/code-count three)) 3 -1)))))))))

(defn lam--reducer? [(s Code)] (-> bool)
  (or (primitive/code-eq s `+) (primitive/code-eq s `*)))
(defn lam--variadic-comparison? [(s Code)] (-> bool)
  (or (primitive/code-eq s `string=?) (or (primitive/code-eq s `string<?)
  (or (primitive/code-eq s `string>?) (or (primitive/code-eq s `string<=?)
  (or (primitive/code-eq s `string>=?) (or (primitive/code-eq s `string-ci=?)
  (or (primitive/code-eq s `string-ci<?) (or (primitive/code-eq s `string-ci>?)
  (or (primitive/code-eq s `string-ci<=?) (or (primitive/code-eq s `string-ci>=?)
  (or (primitive/code-eq s `char=?) (or (primitive/code-eq s `char<?)
  (or (primitive/code-eq s `char>?) (or (primitive/code-eq s `char<=?)
  (or (primitive/code-eq s `char>=?) (or (primitive/code-eq s `char-ci=?)
  (or (primitive/code-eq s `char-ci<?) (or (primitive/code-eq s `char-ci>?)
  (or (primitive/code-eq s `char-ci<=?) (primitive/code-eq s `char-ci>=?)))))))))))))))))))))
(defn lam--list-primitive? [(s Code)] (-> bool)
  (or (lam--variadic-comparison? s)
      (let [xs '(- / < > <= >= = list string vector max min gcd lcm append
                  string-append map for-each apply values make-string make-vector
                  number->string string->number atan format
                  read read-char peek-char char-ready? display write newline write-char)]
        (lam--member? s xs 0 (primitive/code-count xs)))))
(defn lam--list-target [(s Code)] (-> Code)
  (cond (primitive/code-eq s `-) `scm-sub-args
        (primitive/code-eq s `/) `scm-div-args
        (primitive/code-eq s `<) `scm-lt-args
        (primitive/code-eq s `>) `scm-gt-args
        (primitive/code-eq s `<=) `scm-le-args
        (primitive/code-eq s `>=) `scm-ge-args
        (primitive/code-eq s `=) `scm-eq-args
        (primitive/code-eq s `list) `scm-list-args
        (primitive/code-eq s `string) `scm-list->string
        (primitive/code-eq s `vector) `scm-vector-args
        (primitive/code-eq s `max) `scm-max-args
        (primitive/code-eq s `min) `scm-min-args
        (primitive/code-eq s `gcd) `scm-gcd-args
        (primitive/code-eq s `lcm) `scm-lcm-args
        (primitive/code-eq s `append) `scm-append-args
        (primitive/code-eq s `string-append) `scm-string-append-args
        (primitive/code-eq s `map) `scm-map-args
        (primitive/code-eq s `for-each) `scm-for-each-args
        (primitive/code-eq s `apply) `scm-apply-args
        (primitive/code-eq s `values) `scm-values-args
        (primitive/code-eq s `make-string) `scm-make-string-args
        (primitive/code-eq s `make-vector) `scm-make-vector-args
        (primitive/code-eq s `number->string) `scm-number->string-args
        (primitive/code-eq s `string->number) `scm-string->number-args
        (primitive/code-eq s `atan) `scm-atan-args
        (primitive/code-eq s `format) `scm-format-args
        (primitive/code-eq s `string=?) `scm-string-eq-args
        (primitive/code-eq s `string<?) `scm-string-lt-args
        (primitive/code-eq s `string>?) `scm-string-gt-args
        (primitive/code-eq s `string<=?) `scm-string-le-args
        (primitive/code-eq s `string>=?) `scm-string-ge-args
        (primitive/code-eq s `string-ci=?) `scm-string-ci-eq-args
        (primitive/code-eq s `string-ci<?) `scm-string-ci-lt-args
        (primitive/code-eq s `string-ci>?) `scm-string-ci-gt-args
        (primitive/code-eq s `string-ci<=?) `scm-string-ci-le-args
        (primitive/code-eq s `string-ci>=?) `scm-string-ci-ge-args
        (primitive/code-eq s `char=?) `scm-char-eq-args
        (primitive/code-eq s `char<?) `scm-char-lt-args
        (primitive/code-eq s `char>?) `scm-char-gt-args
        (primitive/code-eq s `char<=?) `scm-char-le-args
        (primitive/code-eq s `char>=?) `scm-char-ge-args
        (primitive/code-eq s `char-ci=?) `scm-char-ci-eq-args
        (primitive/code-eq s `char-ci<?) `scm-char-ci-lt-args
        (primitive/code-eq s `char-ci>?) `scm-char-ci-gt-args
        (primitive/code-eq s `char-ci<=?) `scm-char-ci-le-args
        (primitive/code-eq s `char-ci>=?) `scm-char-ci-ge-args
        (primitive/code-eq s `read) `scm-read-args
        (primitive/code-eq s `read-char) `scm-read-char-args
        (primitive/code-eq s `peek-char) `scm-peek-char-args
        (primitive/code-eq s `char-ready?) `scm-char-ready-args
        (primitive/code-eq s `display) `scm-display-args
        (primitive/code-eq s `write) `scm-write-args
        (primitive/code-eq s `newline) `scm-newline-args
        :else `scm-write-char-args))

(defn lam--primitive-value [(s Code) (arity i64)] (-> Code)
  (if (lam--reducer? s)
      `(make-reducer
         (fnptr2->i64 (fnptr-of ~(if (primitive/code-eq s `+) `scm-add `scm-mul)))
         ~(if (primitive/code-eq s `+) `(mk-fixnum 0) `(mk-fixnum 1)))
    (if (lam--list-primitive? s)
      `(make-list-procedure (fnptr1->i64 (fnptr-of ~(lam--list-target s))))
    `(make-procedure
       ~(let [target (if (primitive/code-eq s `not) `scm-not s)]
          (if (= arity 0) `(fnptr0->i64 (fnptr-of ~target))
            (if (= arity 1) `(fnptr1->i64 (fnptr-of ~target))
              (if (= arity 2) `(fnptr2->i64 (fnptr-of ~target))
                `(fnptr3->i64 (fnptr-of ~target))))))
       ~arity))))

(defn lam--surface-value [(e Code)] (-> Code)
  (let [arity (if (primitive/code-sym? e) (lam--primitive-arity e) -1)]
    (if (or (>= arity 0) (or (lam--reducer? e) (lam--list-primitive? e)))
        (lam--primitive-value e arity)
      e)))

;; Names that must never be captured: special forms, and anything already bound.
;; A head position is not a variable reference — `(f x)` mentions `f` as an
;; operator, and operators resolve as globals, so capturing them would be wrong.
(defn lam--special? [(s Code)] (-> bool)
  (or (primitive/code-eq s `if)
      (or (primitive/code-eq s `quote)
          (or (primitive/code-eq s `let)
              (or (primitive/code-eq s `lambda)
                  (or (primitive/code-eq s `define)
                      (or (primitive/code-eq s `begin)
                          (or (primitive/code-eq s `set!)
                              (primitive/code-eq s `do)))))))))

;; Collect free symbols of `e` into `acc`, given the currently-bound set.
;; Over-approximating is safe here in one direction only: capturing something
;; that did not need capturing costs a slot, while missing a capture is a bug —
;; so anything ambiguous is captured.
(defn lam--free [(e Code) (bound Code) (acc Code)] (-> Code)
  (if (primitive/code-sym? e)
      (if (or (lam--member? e bound 0 (primitive/code-count bound))
              (or (lam--member? e acc 0 (primitive/code-count acc))
                  (lam--special? e)))
          acc
        `(~@acc ~e))
    (if (primitive/code-vector? e) acc
      (if (primitive/code-list? e)
        (if (= (primitive/code-count e) 0) acc
          ; `quote` shields its argument: (quote x) mentions no variables
          (if (lam--quote-head? (primitive/code-nth e 0)) acc
            (lam--free-args e 1 (primitive/code-count e) bound
                            ; the head is a call target, not a captured variable
                            acc)))
        acc))))

(defn lam--free-args [(e Code) (i i64) (n i64) (bound Code) (acc Code)] (-> Code)
  (if (>= i n) acc
    (lam--free-args e (+ i 1) n bound
                    (lam--free (primitive/code-nth e i) bound acc))))

(defn closure-fnptr0 [(f Code)] (-> Code) `(closure-fnptr0->i64 (fnptr-of ~f)))
(defn closure-fnptr1 [(f Code)] (-> Code) `(closure-fnptr1->i64 (fnptr-of ~f)))
(defn closure-fnptr2 [(f Code)] (-> Code) `(closure-fnptr2->i64 (fnptr-of ~f)))
(defn closure-fnptr3 [(f Code)] (-> Code) `(closure-fnptr3->i64 (fnptr-of ~f)))
(defn closure-fnptr4 [(f Code)] (-> Code) `(closure-fnptr4->i64 (fnptr-of ~f)))
(defn closure-fnptr5 [(f Code)] (-> Code) `(closure-fnptr5->i64 (fnptr-of ~f)))
(defn closure-fnptr6 [(f Code)] (-> Code) `(closure-fnptr6->i64 (fnptr-of ~f)))

(defn lam--closure-fnptr [(name Code) (arity i64)] (-> Code)
  (cond (= arity 0) `(closure-fnptr0->i64 (fnptr-of ~name))
        (= arity 1) `(closure-fnptr1->i64 (fnptr-of ~name))
        (= arity 2) `(closure-fnptr2->i64 (fnptr-of ~name))
        (= arity 3) `(closure-fnptr3->i64 (fnptr-of ~name))
        (= arity 4) `(closure-fnptr4->i64 (fnptr-of ~name))
        (= arity 5) `(closure-fnptr5->i64 (fnptr-of ~name))
        :else `(closure-fnptr6->i64 (fnptr-of ~name))))

; ---- source lambda lifting -------------------------------------------------
;; A lift result is `(rewritten-expression generated-top-level-definitions)`.
;; Keeping both in Code lets the transform remain pure and deterministic: once
;; every source lambda has disappeared, the next before-expand round is a fixed
;; point and no new gensyms are requested.
(defn lam--result [(value Code) (defs Code)] (-> Code) `(~value ~defs))
(defn lam--value [(r Code)] (-> Code) (primitive/code-nth r 0))
(defn lam--defs [(r Code)] (-> Code) (primitive/code-nth r 1))
(defn lam--lifted-name [(proto Code)] (-> Code)
  (primitive/code-symbol-context proto
    (primitive/code-str "coil-scheme-lambda$" (primitive/gensym))))
(defn lam--scheme-bindings? [(e Code)] (-> bool)
  (and (primitive/code-list? e)
       (and (not (primitive/code-vector? e))
            (or (= (primitive/code-count e) 0)
                (primitive/code-list? (primitive/code-nth e 0))))))
(defn lam--coil-bindings? [(e Code)] (-> bool)
  (and (primitive/code-vector? e) (= (primitive/urem (primitive/code-count e) 2) 0)))
(defn lam--coil-binding-names [(bs Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(primitive/code-nth bs i) ~@(lam--coil-binding-names bs (+ i 2) n))))
(defn lam--captures-coil-inits [(bs Code) (outer Code) (local Code) (acc Code)
                                (i i64) (n i64)] (-> Code)
  (if (>= i n) acc
    (let [name (primitive/code-nth bs i)]
      (lam--captures-coil-inits bs outer (lam--add-set local `(~name) 0 1)
        (lam--captures (primitive/code-nth bs (+ i 1)) outer local acc) (+ i 2) n))))

(defn lam--add-set [(xs Code) (ys Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) xs
    (let [x (primitive/code-nth ys i)]
      (lam--add-set (if (lam--member? x xs 0 (primitive/code-count xs)) xs `(~@xs ~x))
                    ys (+ i 1) n))))

(defn lam--formal-count [(ps Code)] (-> i64)
  (if (primitive/code-sym? ps) 1 (primitive/code-count ps)))
(defn lam--dot-index [(ps Code) (i i64) (n i64)] (-> i64)
  (if (>= i n) -1
    (if (primitive/code-eq (primitive/code-nth ps i) `.) i
      (lam--dot-index ps (+ i 1) n))))
(defn lam--variadic-formals? [(ps Code)] (-> bool)
  (if (primitive/code-sym? ps) true
    (>= (lam--dot-index ps 0 (primitive/code-count ps)) 0)))
(defn lam--fixed-count [(ps Code)] (-> i64)
  (if (primitive/code-sym? ps) 0
    (let [dot (lam--dot-index ps 0 (primitive/code-count ps))]
      (if (>= dot 0) dot (primitive/code-count ps)))))
(defn lam--rest-name [(ps Code)] (-> Code)
  (if (primitive/code-sym? ps) ps
    (primitive/code-nth ps (+ (lam--fixed-count ps) 1))))
(defn lam--params [(ps Code) (i i64) (n i64)] (-> Code)
  (if (primitive/code-sym? ps) `(~ps)
    (if (>= i n) `()
      (let [p (primitive/code-nth ps i)]
        (if (primitive/code-eq p `.)
            `(~(primitive/code-nth ps (+ i 1)))
          `(~p ~@(lam--params ps (+ i 1) n)))))))

;; Variadic closures use one ABI regardless of their minimum arity: the lifted
;; entry receives the complete argument list and binds fixed parameters from its
;; prefix plus the rest name to the remaining tail.
(defn lam--arg-tail [(args Code) (n i64)] (-> Code)
  (if (= n 0) args `(cdr ~(lam--arg-tail args (- n 1)))))
(defn lam--arg-at [(args Code) (i i64)] (-> Code)
  `(car ~(lam--arg-tail args i)))
(defn lam--variadic-bindings [(ps Code) (i i64) (fixed i64)] (-> Code)
  (if (>= i fixed)
      `[~(lam--rest-name ps) ~(lam--arg-tail `args fixed)]
    `[~(primitive/code-nth ps i) ~(lam--arg-at `args i)
      ~@(lam--variadic-bindings ps (+ i 1) fixed)]))

;; Collect only references that resolve to an enclosing lexical binding. Global
;; names are intentionally absent from `outer`, so they stay direct calls or
;; global references instead of becoming bogus captures.
(defn lam--captures [(e Code) (outer Code) (local Code) (acc Code)] (-> Code)
  (if (primitive/code-sym? e)
      (if (and (lam--member? e outer 0 (primitive/code-count outer))
               (and (not (lam--member? e local 0 (primitive/code-count local)))
                    (not (lam--member? e acc 0 (primitive/code-count acc)))))
          `(~@acc ~e)
        acc)
    (if (not (primitive/code-list? e)) acc
      (if (= (primitive/code-count e) 0) acc
        (let [h (primitive/code-nth e 0)]
            (if (lam--quote-head? h) acc
            (if (and (lam--lambda-head? h) (>= (primitive/code-count e) 3))
                ;; The nested lambda owns bindings from this lambda, but an
                ;; outer binding used only by that nested body still has to pass
                ;; through this closure's environment.  Otherwise constructing
                ;; a grandchild closure here leaves its grandparent capture
                ;; unbound in the generated constructor.
                (let [ps (primitive/code-nth e 1)
                      params (lam--params ps 0 (lam--formal-count ps))]
                  (lam--captures-all e 2 (primitive/code-count e) outer
                                     (lam--add-set local params 0 (primitive/code-count params))
                                     acc))
              (if (and (lam--let-star-head? h)
                       (and (>= (primitive/code-count e) 3)
                            (lam--scheme-bindings? (primitive/code-nth e 1))))
                  (let [bs (primitive/code-nth e 1)
                        names (lam--binding-names bs 0 (primitive/code-count bs))
                        a1 (lam--captures-star-inits bs outer local acc 0 (primitive/code-count bs))]
                    (lam--captures-all e 2 (primitive/code-count e) outer
                                       (lam--add-set local names 0 (primitive/code-count names)) a1))
              (if (and (primitive/code-eq h `let)
                       (and (>= (primitive/code-count e) 3)
                            (lam--coil-bindings? (primitive/code-nth e 1))))
                  (let [bs (primitive/code-nth e 1)
                        names (lam--coil-binding-names bs 0 (primitive/code-count bs))
                        a1 (lam--captures-coil-inits bs outer local acc 0 (primitive/code-count bs))]
                    (lam--captures-all e 2 (primitive/code-count e) outer
                                       (lam--add-set local names 0 (primitive/code-count names)) a1))
              (if (and (primitive/code-eq h `let)
                       (and (>= (primitive/code-count e) 3)
                            (lam--scheme-bindings? (primitive/code-nth e 1))))
                  (let [bs (primitive/code-nth e 1)
                        names (lam--binding-names bs 0 (primitive/code-count bs))
                        a1 (lam--captures-bind-inits bs outer local acc 0 (primitive/code-count bs))]
                    (lam--captures-all e 2 (primitive/code-count e) outer
                                       (lam--add-set local names 0 (primitive/code-count names)) a1))
                (lam--captures-all e 0 (primitive/code-count e) outer local acc)))))))))))

(defn lam--captures-all [(e Code) (i i64) (n i64) (outer Code) (local Code) (acc Code)] (-> Code)
  (if (>= i n) acc
    (lam--captures-all e (+ i 1) n outer local
      (lam--captures (primitive/code-nth e i) outer local acc))))
(defn lam--binding-names [(bs Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    (let [b (primitive/code-nth bs i)]
      `(~(primitive/code-nth b 0) ~@(lam--binding-names bs (+ i 1) n)))))
(defn lam--captures-bind-inits [(bs Code) (outer Code) (local Code) (acc Code)
                                (i i64) (n i64)] (-> Code)
  (if (>= i n) acc
    (let [b (primitive/code-nth bs i)]
      (lam--captures-bind-inits bs outer local
        (lam--captures (primitive/code-nth b 1) outer local acc) (+ i 1) n))))
(defn lam--captures-star-inits [(bs Code) (outer Code) (local Code) (acc Code)
                                (i i64) (n i64)] (-> Code)
  (if (>= i n) acc
    (let [b (primitive/code-nth bs i)
          name (primitive/code-nth b 0)]
      (lam--captures-star-inits bs outer (lam--add-set local `(~name) 0 1)
        (lam--captures (primitive/code-nth b 1) outer local acc) (+ i 1) n))))

(defn lam--capture-index [(caps Code) (s Code) (i i64) (n i64)] (-> i64)
  (if (>= i n) -1
    (if (primitive/code-eq (primitive/code-nth caps i) s) i
      (lam--capture-index caps s (+ i 1) n))))

(defn lam--dynamic-call [(head Code) (e Code) (caps Code) (local Code)] (-> Code)
  (let [n (- (primitive/code-count e) 1)]
    (if (> n 6)
        (do (primitive/report e "first-class Scheme procedures currently support at most 6 arguments") e)
      (lam--call-code
        (lam--subst head caps local)
        (lam--subst-all e 1 (primitive/code-count e) caps local)
        n))))

(defn lam--subst [(e Code) (caps Code) (local Code)] (-> Code)
  (if (primitive/code-sym? e)
      (let [i (lam--capture-index caps e 0 (primitive/code-count caps))]
        (if (>= i 0) `(env-ref env ~i) e))
    (if (primitive/code-vector? e) e
      (if (not (primitive/code-list? e)) e
      (if (= (primitive/code-count e) 0) e
        (let [h (primitive/code-nth e 0)]
          (if (lam--quote-head? h) e
            (if (and (primitive/code-eq h `let)
                     (and (>= (primitive/code-count e) 3)
                          (lam--coil-bindings? (primitive/code-nth e 1))))
                (let [bs (primitive/code-nth e 1)
                      names (lam--coil-binding-names bs 0 (primitive/code-count bs))
                      inner (lam--add-set local names 0 (primitive/code-count names))]
                  `(let ~(lam--subst-coil-bindings bs 0 (primitive/code-count bs) caps local)
                     ~@(lam--subst-all e 2 (primitive/code-count e) caps inner)))
            (if (and (lam--let-star-head? h)
                     (and (>= (primitive/code-count e) 3)
                          (lam--scheme-bindings? (primitive/code-nth e 1))))
                (let [bs (primitive/code-nth e 1)
                      names (lam--binding-names bs 0 (primitive/code-count bs))
                      inner (lam--add-set local names 0 (primitive/code-count names))]
                  `(~h ~(lam--subst-star-bindings bs 0 (primitive/code-count bs) caps local)
                     ~@(lam--subst-all e 2 (primitive/code-count e) caps inner)))
            (if (and (lam--scheme-let-head? h)
                     (and (>= (primitive/code-count e) 3)
                          (lam--scheme-bindings? (primitive/code-nth e 1))))
                (let [bs (primitive/code-nth e 1)
                      names (lam--binding-names bs 0 (primitive/code-count bs))
                      inner (lam--add-set local names 0 (primitive/code-count names))]
                  `(let ~(lam--subst-bindings bs 0 (primitive/code-count bs) caps local)
                     ~@(lam--subst-all e 2 (primitive/code-count e) caps inner)))
              (if (primitive/code-list? h)
                  (lam--dynamic-call h e caps local)
              (if (and (primitive/code-sym? h)
                       (or (lam--member? h local 0 (primitive/code-count local))
                           (>= (lam--capture-index caps h 0 (primitive/code-count caps)) 0)))
                  (lam--dynamic-call h e caps local)
                `(~(lam--subst h caps local)
                  ~@(lam--subst-all e 1 (primitive/code-count e) caps local))))))))))))))
(defn lam--subst-all [(e Code) (i i64) (n i64) (caps Code) (local Code)] (-> Code)
  (if (>= i n) `()
    (primitive/code-cons (lam--subst (primitive/code-nth e i) caps local)
                         (lam--subst-all e (+ i 1) n caps local))))
(defn lam--subst-bindings [(bs Code) (i i64) (n i64) (caps Code) (local Code)] (-> Code)
  (if (>= i n) `()
    (let [b (primitive/code-nth bs i)]
      `((~(primitive/code-nth b 0) ~(lam--subst (primitive/code-nth b 1) caps local))
        ~@(lam--subst-bindings bs (+ i 1) n caps local)))))
(defn lam--subst-star-bindings [(bs Code) (i i64) (n i64) (caps Code) (local Code)] (-> Code)
  (if (>= i n) `()
    (let [b (primitive/code-nth bs i)
          name (primitive/code-nth b 0)]
      `((~name ~(lam--subst (primitive/code-nth b 1) caps local))
        ~@(lam--subst-star-bindings bs (+ i 1) n caps
             (lam--add-set local `(~name) 0 1))))))
(defn lam--subst-coil-bindings [(bs Code) (i i64) (n i64) (caps Code) (local Code)] (-> Code)
  (if (>= i n) `[]
    (let [name (primitive/code-nth bs i)]
      `[~name ~(lam--subst (primitive/code-nth bs (+ i 1)) caps local)
        ~@(lam--subst-coil-bindings bs (+ i 2) n caps
             (lam--add-set local `(~name) 0 1))])))

(defn lam--typed-params [(ps Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `[]
    `[(~(primitive/code-nth ps i) i64) ~@(lam--typed-params ps (+ i 1) n)]))
(defn lam--fixed-list-bindings [(ps Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `((~(primitive/code-nth ps i) (scm-list-ref args (mk-fixnum ~i)))
      ~@(lam--fixed-list-bindings ps (+ i 1) n))))
(defn lam--env-expr [(caps Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(primitive/code-nth caps i) ~@(lam--env-expr caps (+ i 1) n))))

(defn lam--lift-lambda [(e Code) (outer Code)] (-> Code)
  (let [ps (primitive/code-nth e 1)
        params (lam--params ps 0 (lam--formal-count ps))
        visible (lam--add-set outer params 0 (primitive/code-count params))
        captures (lam--captures-all e 2 (primitive/code-count e) outer params `())
        bodies (lam--lift-all e 2 (primitive/code-count e) visible)
        name (lam--lifted-name (primitive/code-nth e 0))
        variadic (lam--variadic-formals? ps)
        fixed (lam--fixed-count ps)
        list-fixed (and (not variadic) (> fixed 6))
        arity (if variadic (- 0 (+ fixed 2))
                (if list-fixed (- 0 (+ fixed 100000)) (primitive/code-count params)))
        body (lam--subst-all (lam--value bodies) 0 (primitive/code-count (lam--value bodies)) captures params)
        entry (if variadic
                  `(defn ~name [(env i64) (args i64)] (-> i64)
                     (scm-closure-body
                       (let ~(lam--variadic-bindings ps 0 fixed) ~@body)))
                (if list-fixed
                    `(defn ~name [(env i64) (args i64)] (-> i64)
                       (scm-closure-body
                         (let ~(lam--fixed-list-bindings params 0 fixed) ~@body)))
                  `(defn ~name [(env i64) ~@(lam--typed-params params 0 arity)] (-> i64)
                     (scm-closure-body ~@body))))
        ctor `(make-closure ~(lam--closure-fnptr name
                              (if (or variadic list-fixed) 1 arity))
                            (list ~@(lam--env-expr captures 0 (primitive/code-count captures)))
                            ~arity)]
    (lam--result ctor `(~@(lam--defs bodies) ~entry))))

(defn lam--lift-all [(e Code) (i i64) (n i64) (outer Code)] (-> Code)
  (if (>= i n) (lam--result `() `())
    (let [one (lam--lift-expr (primitive/code-nth e i) outer)
          rest (lam--lift-all e (+ i 1) n outer)]
      (lam--result (primitive/code-cons (lam--value one) (lam--value rest))
                   (lam--append (lam--defs one) (lam--defs rest))))))

(defn lam--lift-bindings [(bs Code) (i i64) (n i64) (outer Code)] (-> Code)
  (if (>= i n) (lam--result `() `())
    (let [b (primitive/code-nth bs i)
          one (lam--lift-expr (primitive/code-nth b 1) outer)
          rest (lam--lift-bindings bs (+ i 1) n outer)]
      (lam--result `((~(primitive/code-nth b 0) ~(lam--value one)) ~@(lam--value rest))
                   `(~@(lam--defs one) ~@(lam--defs rest))))))
(defn lam--lift-star-bindings [(bs Code) (i i64) (n i64) (outer Code)] (-> Code)
  (if (>= i n) (lam--result `() `())
    (let [b (primitive/code-nth bs i)
          name (primitive/code-nth b 0)
          one (lam--lift-expr (primitive/code-nth b 1) outer)
          inner (lam--add-set outer `(~name) 0 1)
          rest (lam--lift-star-bindings bs (+ i 1) n inner)]
      (lam--result `((~name ~(lam--value one)) ~@(lam--value rest))
                   `(~@(lam--defs one) ~@(lam--defs rest))))))
(defn lam--lift-coil-bindings [(bs Code) (i i64) (n i64) (outer Code)] (-> Code)
  (if (>= i n) (lam--result `[] `())
    (let [name (primitive/code-nth bs i)
          one (lam--lift-expr (primitive/code-nth bs (+ i 1)) outer)
          inner (lam--add-set outer `(~name) 0 1)
          rest (lam--lift-coil-bindings bs (+ i 2) n inner)]
      (lam--result `[~name ~(lam--value one) ~@(lam--value rest)]
                   `(~@(lam--defs one) ~@(lam--defs rest))))))

;; Lower a directly applied fixed-arity lambda before closure substitution.
;; Leaving this shape for `lam--subst` is incorrect when an enclosing lambda is
;; lifted: substitution sees the operator as a procedure value and emits
;; `(call--N (lambda ...) ...)`, while the parameter list is binder metadata, not
;; an expression.  This is the same report-defined lambda/let equivalence used
;; by forms.coil, but it must happen here because closure conversion precedes
;; literal lowering.
(defn lam--applied-bindings [(ps Code) (call Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `((~(primitive/code-nth ps i) ~(primitive/code-nth call (+ i 1)))
      ~@(lam--applied-bindings ps call (+ i 1) n))))
(defn lam--code-tail [(e Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(primitive/code-nth e i) ~@(lam--code-tail e (+ i 1) n))))
(defn lam--applied-lambda [(call Code) (head Code)] (-> Code)
  (let [ps (primitive/code-nth head 1)
        pn (primitive/code-count ps)
        an (- (primitive/code-count call) 1)]
    (if (not (= pn an))
        (do (primitive/report call "literal lambda application has the wrong number of arguments")
            call)
      `(let ~(lam--applied-bindings ps call 0 pn)
         ~@(lam--code-tail head 2 (primitive/code-count head))))))

;; `do` bindings are triples `(name init step)` rather than calls. Initializers
;; are evaluated outside the loop scope; steps are evaluated with every loop
;; variable visible. Treating a triple as an ordinary expression makes `name`
;; look like a callee and silently destroys an otherwise unrelated `do` whenever
;; the containing function also happens to contain a lambda.
(defn lam--lift-do-bindings [(bs Code) (i i64) (n i64)
                              (outer Code) (inner Code)] (-> Code)
  (if (>= i n) (lam--result `() `())
    (let [b (primitive/code-nth bs i)
          init (lam--lift-expr (primitive/code-nth b 1) outer)
          step (if (>= (primitive/code-count b) 3)
                   (lam--lift-expr (primitive/code-nth b 2) inner)
                 (lam--result `() `()))
          rest (lam--lift-do-bindings bs (+ i 1) n outer inner)]
      (lam--result
        `((~(primitive/code-nth b 0) ~(lam--value init)
           ~@(if (>= (primitive/code-count b) 3) `(~(lam--value step)) `()))
          ~@(lam--value rest))
                   `(~@(lam--defs init) ~@(lam--defs step) ~@(lam--defs rest))))))
(defn lam--lift-case-clauses [(e Code) (i i64) (n i64) (outer Code)] (-> Code)
  (if (>= i n) (lam--result `() `())
    (let [clause (primitive/code-nth e i)
          body (lam--lift-all clause 1 (primitive/code-count clause) outer)
          rest (lam--lift-case-clauses e (+ i 1) n outer)]
      (lam--result `((~(primitive/code-nth clause 0) ~@(lam--value body))
                     ~@(lam--value rest))
                   `(~@(lam--defs body) ~@(lam--defs rest))))))

;; Lower letrec to traced Scheme cells before lifting lambdas. A recursive
;; closure captures the CELL, not the initial undefined value; every recursive
;; reference loads the current car. This is the missing semantic distinction
;; between an ordinary lexical capture and a letrec capture.
(defn lam--gensyms [(i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(primitive/gensym) ~@(lam--gensyms (+ i 1) n))))
(defn lam--cell-index [(names Code) (s Code) (i i64) (n i64)] (-> i64)
  (if (>= i n) -1
    (if (primitive/code-eq (primitive/code-nth names i) s) i
      (lam--cell-index names s (+ i 1) n))))
(defn lam--set-target-all? [(e Code) (i i64) (n i64) (names Code) (local Code)] (-> bool)
  (if (>= i n) false
    (if (lam--set-target? (primitive/code-nth e i) names local) true
      (lam--set-target-all? e (+ i 1) n names local))))
(defn lam--set-target? [(e Code) (names Code) (local Code)] (-> bool)
  (if (not (primitive/code-list? e)) false
    (if (= (primitive/code-count e) 0) false
      (let [h (primitive/code-nth e 0)]
        (if (lam--quote-head? h) false
          (if (and (primitive/code-eq h `set!)
                   (and (= (primitive/code-count e) 3)
                        (primitive/code-sym? (primitive/code-nth e 1))))
              (let [target (primitive/code-nth e 1)]
                (or (and (>= (lam--cell-index names target 0 (primitive/code-count names)) 0)
                         (not (lam--member? target local 0 (primitive/code-count local))))
                    (lam--set-target? (primitive/code-nth e 2) names local)))
            (if (and (lam--lambda-head? h) (>= (primitive/code-count e) 3))
                (let [ps (primitive/code-nth e 1)
                      formals (lam--params ps 0 (lam--formal-count ps))
                      inner (lam--add-set local formals 0 (primitive/code-count formals))]
                  (lam--set-target-all? e 2 (primitive/code-count e) names inner))
              (if (and (lam--scheme-let-head? h)
                       (and (>= (primitive/code-count e) 3)
                            (lam--scheme-bindings? (primitive/code-nth e 1))))
                  (let [bs (primitive/code-nth e 1)
                        bound (lam--binding-names bs 0 (primitive/code-count bs))
                        inner (lam--add-set local bound 0 (primitive/code-count bound))]
                    (or (lam--set-target-inits? bs 0 (primitive/code-count bs) names local)
                        (lam--set-target-all? e 2 (primitive/code-count e) names inner)))
                (lam--set-target-all? e 0 (primitive/code-count e) names local)))))))))
(defn lam--set-target-inits? [(bs Code) (i i64) (n i64) (names Code) (local Code)] (-> bool)
  (if (>= i n) false
    (if (lam--set-target? (primitive/code-nth (primitive/code-nth bs i) 1) names local) true
      (lam--set-target-inits? bs (+ i 1) n names local))))
(defn lam--cell-subst-bindings [(bs Code) (i i64) (n i64) (names Code) (cells Code)
                                 (local Code)] (-> Code)
  (if (>= i n) `()
    (let [b (primitive/code-nth bs i)]
      `((~(primitive/code-nth b 0)
         ~(lam--cell-subst (primitive/code-nth b 1) names cells local))
        ~@(lam--cell-subst-bindings bs (+ i 1) n names cells local)))))
(defn lam--cell-subst [(e Code) (names Code) (cells Code) (local Code)] (-> Code)
  (if (primitive/code-sym? e)
      (let [i (if (lam--member? e local 0 (primitive/code-count local)) -1
                  (lam--cell-index names e 0 (primitive/code-count names)))]
        (if (>= i 0) `(car ~(primitive/code-nth cells i)) e))
    (if (not (primitive/code-list? e)) e
      (if (= (primitive/code-count e) 0) e
        (let [h (primitive/code-nth e 0)]
          (if (lam--quote-head? h) e
            (if (and (primitive/code-eq h `set!)
                     (and (= (primitive/code-count e) 3)
                          (primitive/code-sym? (primitive/code-nth e 1))))
                (let [i (lam--cell-index names (primitive/code-nth e 1) 0
                                          (primitive/code-count names))]
                  (if (and (>= i 0)
                           (not (lam--member? (primitive/code-nth e 1) local 0
                                              (primitive/code-count local))))
                      `(set-car! ~(primitive/code-nth cells i)
                                 ~(lam--cell-subst (primitive/code-nth e 2) names cells local))
                    `(~h ~(primitive/code-nth e 1)
                         ~(lam--cell-subst (primitive/code-nth e 2) names cells local))))
              (if (and (lam--lambda-head? h) (>= (primitive/code-count e) 3))
                  (let [ps (primitive/code-nth e 1)
                        formals (lam--params ps 0 (lam--formal-count ps))
                        inner (lam--add-set local formals 0 (primitive/code-count formals))]
                    `(lambda ~ps ~@(lam--cell-subst-all e 2 (primitive/code-count e)
                                                        names cells inner)))
                (if (and (lam--scheme-let-head? h)
                         (and (>= (primitive/code-count e) 3)
                              (lam--scheme-bindings? (primitive/code-nth e 1))))
                    (let [bs (primitive/code-nth e 1)
                          bound (lam--binding-names bs 0 (primitive/code-count bs))
                          inner (lam--add-set local bound 0 (primitive/code-count bound))]
                      `(~h ~(lam--cell-subst-bindings bs 0 (primitive/code-count bs)
                                                        names cells local)
                           ~@(lam--cell-subst-all e 2 (primitive/code-count e)
                                                 names cells inner)))
                  `(~@(lam--cell-subst-all e 0 (primitive/code-count e) names cells local)))))))))))
(defn lam--cell-subst-all [(e Code) (i i64) (n i64) (names Code) (cells Code)
                            (local Code)] (-> Code)
  (if (>= i n) `()
    (primitive/code-cons (lam--cell-subst (primitive/code-nth e i) names cells local)
                         (lam--cell-subst-all e (+ i 1) n names cells local))))
(defn lam--cell-bindings [(cells Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `((~(primitive/code-nth cells i) (cons (s-undefined) (s-nil)))
      ~@(lam--cell-bindings cells (+ i 1) n))))
(defn lam--cell-inits [(bs Code) (names Code) (cells Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    (let [b (primitive/code-nth bs i)]
      `((set-car! ~(primitive/code-nth cells i)
                  ~(lam--cell-subst (primitive/code-nth b 1) names cells `()))
        ~@(lam--cell-inits bs names cells (+ i 1) n)))))
(defn lam--boxed-let-bindings [(bs Code) (cells Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    (let [b (primitive/code-nth bs i)]
      `((~(primitive/code-nth cells i)
         (cons ~(primitive/code-nth b 1) (s-nil)))
        ~@(lam--boxed-let-bindings bs cells (+ i 1) n)))))
(defn lam--lower-mutable-let [(e Code)] (-> Code)
  (let [bs (primitive/code-nth e 1)
        names (lam--binding-names bs 0 (primitive/code-count bs))
        cells (lam--gensyms 0 (primitive/code-count names))]
    `(let ~(lam--boxed-let-bindings bs cells 0 (primitive/code-count bs))
       ~@(lam--cell-subst-all e 2 (primitive/code-count e) names cells `()))))
(defn lam--boxed-param-bindings [(params Code) (cells Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `((~(primitive/code-nth cells i)
       (cons ~(primitive/code-nth params i) (s-nil)))
      ~@(lam--boxed-param-bindings params cells (+ i 1) n))))
(defn lam--lower-mutable-params [(e Code)] (-> Code)
  (let [ps (primitive/code-nth e 1)
        params (lam--params ps 0 (lam--formal-count ps))
        cells (lam--gensyms 0 (primitive/code-count params))]
    `(lambda ~ps
       (let ~(lam--boxed-param-bindings params cells 0 (primitive/code-count params))
         ~@(lam--cell-subst-all e 2 (primitive/code-count e) params cells `())))))
(defn lam--lower-letrec [(e Code)] (-> Code)
  (let [bs (primitive/code-nth e 1)
        names (lam--binding-names bs 0 (primitive/code-count bs))
        cells (lam--gensyms 0 (primitive/code-count names))]
    `(let ~(lam--cell-bindings cells 0 (primitive/code-count cells))
       ~@(lam--cell-inits bs names cells 0 (primitive/code-count bs))
       ~@(lam--cell-subst-all e 2 (primitive/code-count e) names cells `()))))

(defn lam--lift-expr [(e Code) (outer Code)] (-> Code)
  (if (primitive/code-vector? e) (lam--result e `())
    (if (not (primitive/code-list? e))
      (let [arity (if (primitive/code-sym? e) (lam--primitive-arity e) -1)]
        (if (and (not (lam--member? e outer 0 (primitive/code-count outer)))
                 (or (>= arity 0) (or (lam--reducer? e) (lam--list-primitive? e))))
            (lam--result (lam--primitive-value e arity) `())
          (lam--result e `())))
    (if (= (primitive/code-count e) 0) (lam--result e `())
      (let [h (primitive/code-nth e 0)]
        (if (lam--quote-head? h) (lam--result e `())
          (if (and (primitive/code-list? h)
                   (and (>= (primitive/code-count h) 3)
                        (and (lam--lambda-head? (primitive/code-nth h 0))
                             (primitive/code-list? (primitive/code-nth h 1)))))
              (lam--lift-expr (lam--applied-lambda e h) outer)
          ;; Expression-position delay is a zero-argument lexical closure. This
          ;; rewrite happens here (before ordinary macros expand), so the thunk
          ;; goes through the same lifting and capture analysis as source lambda.
          (if (and (primitive/code-eq h `delay) (= (primitive/code-count e) 2))
              (lam--lift-expr `(make-promise (lambda () ~(primitive/code-nth e 1))) outer)
          (if (and (lam--lambda-head? h) (>= (primitive/code-count e) 3))
              (let [ps (primitive/code-nth e 1)
                    params (lam--params ps 0 (lam--formal-count ps))]
                (if (lam--set-target-all? e 2 (primitive/code-count e) params `())
                    (lam--lift-expr (lam--lower-mutable-params e) outer)
                  (lam--lift-lambda e outer)))
            (if (and (primitive/code-eq h `letrec) (>= (primitive/code-count e) 3))
                (lam--lift-expr (lam--lower-letrec e) outer)
            (if (and (lam--let-star-head? h)
                     (and (>= (primitive/code-count e) 3)
                          (lam--scheme-bindings? (primitive/code-nth e 1))))
                (let [bs (primitive/code-nth e 1)
                      names (lam--binding-names bs 0 (primitive/code-count bs))
                      br (lam--lift-star-bindings bs 0 (primitive/code-count bs) outer)
                      body (lam--lift-all e 2 (primitive/code-count e)
                             (lam--add-set outer names 0 (primitive/code-count names)))]
                  (lam--result `(~h ~(lam--value br) ~@(lam--value body))
                               `(~@(lam--defs br) ~@(lam--defs body))))
            (if (and (primitive/code-eq h `let)
                     (and (>= (primitive/code-count e) 3)
                          (lam--coil-bindings? (primitive/code-nth e 1))))
                (let [bs (primitive/code-nth e 1)
                      names (lam--coil-binding-names bs 0 (primitive/code-count bs))
                      br (lam--lift-coil-bindings bs 0 (primitive/code-count bs) outer)
                      body (lam--lift-all e 2 (primitive/code-count e)
                             (lam--add-set outer names 0 (primitive/code-count names)))]
                  (lam--result `(let ~(lam--value br) ~@(lam--value body))
                               `(~@(lam--defs br) ~@(lam--defs body))))
            (if (and (lam--scheme-let-head? h)
                     (and (>= (primitive/code-count e) 2)
                          (not (lam--scheme-bindings? (primitive/code-nth e 1)))))
                (lam--result e `())
            (if (and (lam--scheme-let-head? h)
                     (and (>= (primitive/code-count e) 3)
                          (lam--scheme-bindings? (primitive/code-nth e 1))))
                (let [bs (primitive/code-nth e 1)
                      names (lam--binding-names bs 0 (primitive/code-count bs))]
                  (if (lam--set-target-all? e 2 (primitive/code-count e) names `())
                      (lam--lift-expr (lam--lower-mutable-let e) outer)
                    (let [br (lam--lift-bindings bs 0 (primitive/code-count bs) outer)
                          body (lam--lift-all e 2 (primitive/code-count e)
                                  (lam--add-set outer names 0 (primitive/code-count names)))]
                      (lam--result `(~h ~(lam--value br) ~@(lam--value body))
                                   `(~@(lam--defs br) ~@(lam--defs body))))))
              (if (and (lam--name? h "case") (>= (primitive/code-count e) 2))
                  (let [key (lam--lift-expr (primitive/code-nth e 1) outer)
                        clauses (lam--lift-case-clauses e 2 (primitive/code-count e) outer)]
                    (lam--result `(case ~(lam--value key) ~@(lam--value clauses))
                                 `(~@(lam--defs key) ~@(lam--defs clauses))))
              ;; `do` is also Coil's sequencing form. It is Scheme `do` only
              ;; when it has the report's binding-list and termination-clause
              ;; shape; rooted/generated host code commonly contains
              ;; `(do expression ...)` and must take the generic expression
              ;; walk below.
              (if (and (lam--name? h "do")
                       (and (>= (primitive/code-count e) 3)
                            (and (lam--scheme-bindings? (primitive/code-nth e 1))
                                 (primitive/code-list? (primitive/code-nth e 2)))))
                  (let [bs (primitive/code-nth e 1)
                        names (lam--binding-names bs 0 (primitive/code-count bs))
                        inner (lam--add-set outer names 0 (primitive/code-count names))
                        br (lam--lift-do-bindings bs 0 (primitive/code-count bs) outer inner)
                        term (lam--lift-all (primitive/code-nth e 2) 0
                                           (primitive/code-count (primitive/code-nth e 2)) inner)
                        body (lam--lift-all e 3 (primitive/code-count e) inner)]
                    (lam--result `(do ~(lam--value br) ~(lam--value term)
                                     ~@(lam--value body))
                                 `(~@(lam--defs br) ~@(lam--defs term) ~@(lam--defs body))))
              (if (and (primitive/code-sym? h)
                       (lam--member? h outer 0 (primitive/code-count outer)))
                  (let [args (lam--lift-all e 1 (primitive/code-count e) outer)
                        arity (- (primitive/code-count e) 1)]
                    (if (> arity 6)
                        (lam--result `(scm-apply-list ~h (list ~@(lam--value args)))
                                     (lam--defs args))
                      (lam--result
                        (lam--call-code h (lam--value args) arity)
                        (lam--defs args))))
                (if (and (primitive/code-list? h)
                         (or (not (and (> (primitive/code-count h) 0)
                                       (lam--lambda-head? (primitive/code-nth h 0))))
                             ; Keep the allocation-free immediate-lambda path
                             ; unless its body contains closures (notably an
                             ; internal-definition block lowered to letrec).
                             (lam--has-value-lambda-all?
                               h 2 (primitive/code-count h))))
                    (let [headr (lam--lift-expr h outer)
                          args (lam--lift-all e 1 (primitive/code-count e) outer)
                          arity (- (primitive/code-count e) 1)]
                      (if (> arity 6)
                          (lam--result
                            `(scm-apply-list ~(lam--value headr) (list ~@(lam--value args)))
                            `(~@(lam--defs headr) ~@(lam--defs args)))
                        (lam--result
                          (lam--call-code (lam--value headr) (lam--value args) arity)
                          `(~@(lam--defs headr) ~@(lam--defs args)))))
                  (if (and (primitive/code-sym? h) (lam--list-primitive? h))
                      (let [args (lam--lift-all e 1 (primitive/code-count e) outer)]
                        (lam--result `(~(lam--list-target h) (list ~@(lam--value args)))
                                     (lam--defs args)))
                    ;; A symbolic head is a direct fixed procedure call. Lift
                    ;; only its arguments; wrapping `car` here would turn
                    ;; `(car x)` into a list-headed call too early.
                    (let [args (lam--lift-all e 1 (primitive/code-count e) outer)]
                      (lam--result `(~h ~@(lam--value args))
                                   (lam--defs args))))))))))))))))))))))

(defn lam--host-params [(ps Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    (let [p (primitive/code-nth ps i)]
      (if (and (primitive/code-list? p) (> (primitive/code-count p) 0))
          `(~(primitive/code-nth p 0) ~@(lam--host-params ps (+ i 1) n))
        (lam--host-params ps (+ i 1) n)))))

(defn lam--has-value-lambda-all? [(e Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (lam--has-value-lambda? (primitive/code-nth e i)) true
      (lam--has-value-lambda-all? e (+ i 1) n))))
(defn lam--has-value-lambda-bindings? [(bs Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (let [b (primitive/code-nth bs i)]
      (if (and (primitive/code-list? b) (>= (primitive/code-count b) 2))
          (if (lam--has-value-lambda? (primitive/code-nth b 1)) true
            (lam--has-value-lambda-bindings? bs (+ i 1) n))
        (lam--has-value-lambda-bindings? bs (+ i 1) n)))))
(defn lam--has-value-lambda? [(e Code)] (-> bool)
  (if (primitive/code-vector? e) false
    (if (not (primitive/code-list? e))
      (and (primitive/code-sym? e)
           (or (>= (lam--primitive-arity e) 0)
               (or (lam--reducer? e) (lam--list-primitive? e))))
    (if (= (primitive/code-count e) 0) false
      (let [h (primitive/code-nth e 0)]
        (if (lam--quote-head? h) false
          ;; A top-level Scheme variable definition is indexed before this pass;
          ;; its quoted initializer may already be represented as definition
          ;; payload rather than an ordinary nested call. Keep code-as-data
          ;; opaque explicitly instead of discovering `lambda` inside it.
          (if (and (primitive/code-eq h `define)
                   (and (>= (primitive/code-count e) 3)
                        (let [init (primitive/code-nth e 2)]
                          (and (primitive/code-list? init)
                               (and (> (primitive/code-count init) 0)
                                    (lam--quote-head? (primitive/code-nth init 0)))))))
              false
          (if (primitive/code-eq h `delay) true
          (if (lam--lambda-head? h) true
            (if (and (lam--letrec-head? h)
                     (and (>= (primitive/code-count e) 3)
                          (lam--scheme-bindings? (primitive/code-nth e 1))))
                (let [bs (primitive/code-nth e 1)]
                  (or (lam--has-value-lambda-bindings?
                        bs 0 (primitive/code-count bs))
                      (lam--has-value-lambda-all? e 2 (primitive/code-count e))))
            (if (and (lam--scheme-let-head? h)
                     (and (>= (primitive/code-count e) 3)
                          (lam--scheme-bindings? (primitive/code-nth e 1))))
                (let [bs (primitive/code-nth e 1)]
                  (or (lam--has-value-lambda-bindings?
                        bs 0 (primitive/code-count bs))
                      (lam--has-value-lambda-all? e 2 (primitive/code-count e))))
            ;; A literal lambda in operator position is lowered directly to let
            ;; by forms.coil and normally needs no closure object. If its body
            ;; itself contains a closure (for example internal definitions
            ;; lowered to letrec), the outer form must enter the lifting pass.
            (if (and (primitive/code-list? h)
                     (and (> (primitive/code-count h) 0)
                          (lam--lambda-head? (primitive/code-nth h 0))))
                (or (lam--has-value-lambda-all? h 2 (primitive/code-count h))
                    (lam--has-value-lambda-all? e 1 (primitive/code-count e)))
              ;; Any other list head is an arbitrary Scheme operator expression:
              ;; `((choose-procedure) arg ...)`. It must enter the lifting walk
              ;; even when the surrounding form contains no literal lambda;
              ;; lam--lift-expr evaluates the head once and routes the result
              ;; through call--N. A symbolic head remains a direct call, so only
              ;; its arguments need searching.
              (if (primitive/code-list? h)
                  true
                (lam--has-value-lambda-all? e 1 (primitive/code-count e)))))))))))))))

;; A directly-called top-level Scheme definition can use Coil's typed fast path,
;; but the same name in value position must be a Scheme procedure object. Eta
;; expansion bridges those representations before ordinary lambda lifting:
;;
;;   (let ((f add-two)) ...)  =>  (let ((f (lambda ($x) (add-two $x)))) ...)
;;
;; Direct call heads are deliberately left alone. Lexically bound names are also
;; left alone, so a local `car` or `+` shadows both the top-level and R5RS binding.
(defn lam--top-procs [(forms Code)] (-> Code)
  (if (primitive/code-null? forms)
      `()
      (let [f (primitive/code-car forms)
            rest (lam--top-procs (primitive/code-cdr forms))]
        (if (and (primitive/code-list? f)
                 (and (>= (primitive/code-count f) 3)
                      (and (primitive/code-eq (primitive/code-nth f 0) `define)
                           (primitive/code-list? (primitive/code-nth f 1)))))
            (let [sig (primitive/code-nth f 1)
                  ps (primitive/code-rest sig)
                  fixed (lam--fixed-count ps)]
              (primitive/code-cons
                `(~(primitive/code-nth sig 0) ~fixed
                  ~(if (lam--variadic-formals? ps) 1 0))
                rest))
            rest))))

;; Imported procedure values need the defining module's arity, but only when
;; normal import resolution made that binding visible. Scan Scheme modules
;; first: compiler-generated records can have non-symbol heads, whereas a module
;; that explicitly imports `coil.scheme` is source and has an ordinary name.
(defn lam--code-string? [(e Code)] (-> bool)
  (and (not (primitive/code-sym? e))
       (and (not (primitive/code-int? e))
            (and (not (primitive/code-float? e))
                 (and (not (primitive/code-vector? e))
                      (not (primitive/code-list? e)))))))

(defn lam--module-imports-scheme? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (let [f (primitive/code-nth m i)]
      (if (and (primitive/code-list? f)
               (and (>= (primitive/code-count f) 2)
                    (and (primitive/code-eq (primitive/code-nth f 0) `import)
                         (and (lam--code-string? (primitive/code-nth f 1))
                              (= (primitive/code-str (primitive/code-nth f 1))
                                 "coil.scheme")))))
          true
        (lam--module-imports-scheme? m (+ i 1) n)))))

(defn lam--use-star? [(f Code) (i i64) (n i64)] (-> bool)
  (if (>= (+ i 1) n) false
    (if (and (primitive/code-keyword? (primitive/code-nth f i))
             (primitive/code-eq (primitive/code-nth f (+ i 1)) `*))
        true
      (lam--use-star? f (+ i 1) n))))

(defn lam--imports-use-name? [(caller Code) (target (slice u8))
                              (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (let [f (primitive/code-nth caller i)]
      (if (not (primitive/code-list? f))
          (lam--imports-use-name? caller target (+ i 1) n)
        (if (< (primitive/code-count f) 4)
            (lam--imports-use-name? caller target (+ i 1) n)
          (if (not (primitive/code-eq (primitive/code-nth f 0) `import))
              (lam--imports-use-name? caller target (+ i 1) n)
            (if (not (lam--code-string? (primitive/code-nth f 1)))
                (lam--imports-use-name? caller target (+ i 1) n)
              (if (and (= (primitive/code-str (primitive/code-nth f 1)) target)
                       (lam--use-star? f 2 (primitive/code-count f)))
                  true
                (lam--imports-use-name? caller target (+ i 1) n)))))))))

(defn lam--visible-tops [(tops Code) (target-name Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    (if (= (+ i 1) n)
        (let [p (primitive/code-nth tops i)]
          (if (primitive/code-exported? (primitive/code-nth p 0) target-name) `(~p) `()))
      (let [mid (+ i (primitive/idiv (- n i) 2))
            left (lam--visible-tops tops target-name i mid)
            right (lam--visible-tops tops target-name mid n)]
        `(~@left ~@right)))))

(defn lam--visible-import-tops [(caller Code) (ms Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    (let [m (primitive/code-nth ms i)]
      (if (lam--module-imports-scheme? m 1 (primitive/code-count m))
          (let [name (primitive/code-nth m 0)]
            (if (and (primitive/code-sym? name)
                     (lam--imports-use-name? caller (primitive/code-str name) 1
                                             (primitive/code-count caller)))
                `(~@(lam--visible-tops
                       (lam--top-procs (primitive/code-cdr m))
                       name 0
                       (primitive/code-count
                         (lam--top-procs (primitive/code-cdr m))))
                  ~@(lam--visible-import-tops caller ms (+ i 1) n))
              (lam--visible-import-tops caller ms (+ i 1) n)))
        (lam--visible-import-tops caller ms (+ i 1) n)))))

(defstruct LamTopIndex [(entries (HashMap (slice u8) Code))])
(defn lam--top-index! [(idx (ptr LamTopIndex)) (tops Code) (i i64) (n i64)] (-> i64)
  (if (>= i n) 0
    (let [p (primitive/code-nth tops i)
          name (primitive/code-nth p 0)]
      (hm-put! [(slice u8) Code] (mut (field idx entries)) (primitive/code-str name) p)
      (lam--top-index! idx tops (+ i 1) n))))
(defn lam--top-entry [(tops (ptr LamTopIndex)) (s Code)] (-> Code)
  (match (hm-get [(slice u8) Code] (load (field tops entries)) (primitive/code-str s))
    (Some [p] p)
    (None [] `())))

(defn lam--eta-params [(i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(primitive/gensym) ~@(lam--eta-params (+ i 1) n))))

(defn lam--eta-value [(name Code) (entry Code)] (-> Code)
  (let [fixed (primitive/code-int (primitive/code-nth entry 1))
        variadic (primitive/code-int (primitive/code-nth entry 2))
        ps (lam--eta-params 0 fixed)]
    (if (= variadic 0)
        `(lambda (~@ps) (~name ~@ps))
      (let [rest (primitive/gensym)]
        `(lambda (~@ps . ~rest)
           (~name ~@ps (scm-collected ~rest)))))))

(defn lam--eta-all [(e Code) (i i64) (n i64) (tops (ptr LamTopIndex)) (bound Code)] (-> Code)
  (if (>= i n) `()
    (primitive/code-cons (lam--eta (primitive/code-nth e i) tops bound)
                         (lam--eta-all e (+ i 1) n tops bound))))

(defn lam--eta-bindings [(bs Code) (i i64) (n i64) (tops (ptr LamTopIndex)) (bound Code)] (-> Code)
  (if (>= i n) `()
    (let [b (primitive/code-nth bs i)]
      `((~(primitive/code-nth b 0) ~(lam--eta (primitive/code-nth b 1) tops bound))
        ~@(lam--eta-bindings bs (+ i 1) n tops bound)))))
(defn lam--eta-star-bindings [(bs Code) (i i64) (n i64)
                              (tops (ptr LamTopIndex)) (bound Code)] (-> Code)
  (if (>= i n) `()
    (let [b (primitive/code-nth bs i)
          name (primitive/code-nth b 0)]
      `((~name ~(lam--eta (primitive/code-nth b 1) tops bound))
        ~@(lam--eta-star-bindings bs (+ i 1) n tops
             (lam--add-set bound `(~name) 0 1))))))
(defn lam--eta-case-clauses [(e Code) (i i64) (n i64)
                             (tops (ptr LamTopIndex)) (bound Code)] (-> Code)
  (if (>= i n) `()
    (let [clause (primitive/code-nth e i)]
      `((~(primitive/code-nth clause 0)
         ~@(lam--eta-all clause 1 (primitive/code-count clause) tops bound))
        ~@(lam--eta-case-clauses e (+ i 1) n tops bound)))))

(defn lam--eta [(e Code) (tops (ptr LamTopIndex)) (bound Code)] (-> Code)
  (if (primitive/code-sym? e)
      (if (lam--member? e bound 0 (primitive/code-count bound)) e
        (let [p (lam--top-entry tops e)]
          (if (= (primitive/code-count p) 0) e (lam--eta-value e p))))
    ;; Vectors here are host binder/type metadata, not Scheme expression trees.
    (if (primitive/code-vector? e) e
    (if (not (primitive/code-list? e)) e
      (if (= (primitive/code-count e) 0) e
        (let [h (primitive/code-nth e 0)]
          (if (lam--quote-head? h) e
          (if (and (lam--lambda-head? h) (>= (primitive/code-count e) 3))
              (let [ps (primitive/code-nth e 1)
                    names (lam--params ps 0 (lam--formal-count ps))
                    inner (lam--add-set bound names 0 (primitive/code-count names))]
                `(lambda ~ps ~@(lam--eta-all e 2 (primitive/code-count e) tops inner)))
          (if (and (lam--let-star-head? h)
                   (and (>= (primitive/code-count e) 3)
                        (lam--scheme-bindings? (primitive/code-nth e 1))))
              (let [bs (primitive/code-nth e 1)
                    names (lam--binding-names bs 0 (primitive/code-count bs))
                    inner (lam--add-set bound names 0 (primitive/code-count names))]
                `(~h ~(lam--eta-star-bindings bs 0 (primitive/code-count bs) tops bound)
                     ~@(lam--eta-all e 2 (primitive/code-count e) tops inner)))
          (if (and (lam--name? h "case") (>= (primitive/code-count e) 2))
              `(case ~(lam--eta (primitive/code-nth e 1) tops bound)
                 ~@(lam--eta-case-clauses e 2 (primitive/code-count e) tops bound))
          (if (and (lam--letrec-head? h)
                   (and (>= (primitive/code-count e) 3)
                        (lam--scheme-bindings? (primitive/code-nth e 1))))
              (let [bs (primitive/code-nth e 1)
                    names (lam--binding-names bs 0 (primitive/code-count bs))
                    inner (lam--add-set bound names 0 (primitive/code-count names))]
                `(~h ~(lam--eta-bindings bs 0 (primitive/code-count bs) tops inner)
                     ~@(lam--eta-all e 2 (primitive/code-count e) tops inner)))
          (if (and (lam--scheme-let-head? h)
                   (and (>= (primitive/code-count e) 3)
                        (lam--scheme-bindings? (primitive/code-nth e 1))))
              (let [bs (primitive/code-nth e 1)
                    names (lam--binding-names bs 0 (primitive/code-count bs))
                    inner (lam--add-set bound names 0 (primitive/code-count names))]
                `(~h ~(lam--eta-bindings bs 0 (primitive/code-count bs) tops bound)
                     ~@(lam--eta-all e 2 (primitive/code-count e) tops inner)))
          ;; The head is an operator occurrence, never a value occurrence.
          `(~h ~@(lam--eta-all e 1 (primitive/code-count e) tops bound))))))))))))))

(defn lam--eta-form [(f Code) (tops (ptr LamTopIndex))] (-> Code)
  (if (not (primitive/code-list? f)) f
    (if (< (primitive/code-count f) 2) f
      (let [h (primitive/code-nth f 0)]
        ;; Module declarations contain names and option syntax, never Scheme
        ;; value expressions (`:use *` must not eta-expand `*`, for example).
        (if (lam--module-decl-head? h) f
        (if (and (primitive/code-eq h `define)
                 (and (>= (primitive/code-count f) 3)
                      (primitive/code-list? (primitive/code-nth f 1))))
            (let [sig (primitive/code-nth f 1)
                  bound (lam--params sig 1 (primitive/code-count sig))]
              `(~h ~sig ~@(lam--eta-all f 2 (primitive/code-count f) tops bound)))
          (if (and (primitive/code-eq h `defn)
                   (and (>= (primitive/code-count f) 5)
                        (primitive/code-list?
                          (primitive/code-nth f (lam--defn-params-at f)))))
              (let [pi (lam--defn-params-at f)
                    bi (lam--defn-body-at f)
                    ps (primitive/code-nth f pi)
                    bound (lam--host-params ps 0 (primitive/code-count ps))]
                (if (lam--defn-cc? f)
                    `(defn ~(primitive/code-nth f 1) :cc ~(primitive/code-nth f 3)
                       ~ps ~(primitive/code-nth f 5)
                       ~@(lam--eta-all f bi (primitive/code-count f) tops bound))
                  `(defn ~(primitive/code-nth f 1) ~ps ~(primitive/code-nth f 3)
                     ~@(lam--eta-all f bi (primitive/code-count f) tops bound))))
            (lam--eta f tops `()))))))))

(defn lam--eta-forms [(forms Code) (tops (ptr LamTopIndex))] (-> Code)
  (if (primitive/code-null? forms)
      `()
      (primitive/code-cons (lam--eta-form (primitive/code-car forms) tops)
                           (lam--eta-forms (primitive/code-cdr forms) tops))))

(defn lam--defn-cc? [(f Code)] (-> bool)
  (and (>= (primitive/code-count f) 4)
       (primitive/code-eq (primitive/code-nth f 2) `:cc)))
(defn lam--defn-params-at [(f Code)] (-> i64) (if (lam--defn-cc? f) 4 2))
(defn lam--defn-body-at [(f Code)] (-> i64) (if (lam--defn-cc? f) 6 4))

(defn lam--lift-form [(f Code)] (-> Code)
  (if (and (primitive/code-list? f)
           (and (> (primitive/code-count f) 0)
                (lam--module-decl-head? (primitive/code-nth f 0))))
      (lam--result f `())
  (if (not (lam--has-value-lambda? f)) (lam--result f `())
  (if (not (primitive/code-list? f)) (lam--result f `())
    (if (< (primitive/code-count f) 2) (lam--result f `())
      (let [h (primitive/code-nth f 0)]
        ;; `deftest` is a host top-level macro whose expansion is indexed before
        ;; this transform runs. Rebuilding that declaration makes it a new
        ;; top-level macro call the existing index does not own. Tests of lifted
        ;; lambdas therefore live in ordinary `defn` application fixtures.
        (if (primitive/code-eq h `deftest) (lam--result f `())
        (if (and (primitive/code-eq h `define) (primitive/code-list? (primitive/code-nth f 1)))
            (let [sig (primitive/code-nth f 1)
                  outer (lam--params sig 1 (primitive/code-count sig))
                  body (lam--lift-all f 2 (primitive/code-count f) outer)]
              ;; Preserve the source binding-form token. Introducing a fresh
              ;; `define` here changes the macro expansion context and can make
              ;; the rebuilt function invisible to a same-stage caller even
              ;; though its printed name is identical.
              (lam--result `(~h ~sig ~@(lam--value body)) (lam--defs body)))
          (if (and (primitive/code-eq h `defn)
                   (and (>= (primitive/code-count f) 5)
                        (primitive/code-list?
                          (primitive/code-nth f (lam--defn-params-at f)))))
              (let [pi (lam--defn-params-at f)
                    bi (lam--defn-body-at f)
                    ps (primitive/code-nth f pi)
                    outer (lam--host-params ps 0 (primitive/code-count ps))
                    body (lam--lift-all f bi (primitive/code-count f) outer)]
                (lam--result (if (lam--defn-cc? f)
                                `(defn ~(primitive/code-nth f 1) :cc ~(primitive/code-nth f 3)
                                   ~ps ~(primitive/code-nth f 5) ~@(lam--value body))
                                `(defn ~(primitive/code-nth f 1) ~ps ~(primitive/code-nth f 3)
                                   ~@(lam--value body)))
                             (lam--defs body)))
            (lam--lift-expr f `()))))))))))

(defn lam--lift-forms [(forms Code) (i i64)] (-> Code)
  (if (primitive/code-null? forms)
      (lam--result `() `())
      (let [f (primitive/code-car forms)
            ignored (lam--trace-form i f)
            one (lam--lift-form f)
            rest (lam--lift-forms (primitive/code-cdr forms) (+ i 1))]
        (lam--result (primitive/code-cons (lam--value one) (lam--value rest))
                     (lam--append (lam--defs one) (lam--defs rest))))))

(defn lambda-lift-module-visible [(m Code) (ms Code)] (-> Code)
  (do
  (lam--trace "enter" m)
  (let [local-tops (do (lam--trace "top-procs" m)
                       (lam--top-procs (primitive/code-cdr m)))
        imported-tops (do (lam--trace "visible-import-tops" m)
                          (lam--visible-import-tops m ms 0 (primitive/code-count ms)))
        tops `(~@local-tops ~@imported-tops)
        top-index (alloc/stack LamTopIndex)
        _top-index-init
          (store! (field top-index entries)
                  (hm-new [(slice u8) Code] (malloc-allocator) (str-keyops-borrowed)))
        _top-index-fill (lam--top-index! top-index tops 0 (primitive/code-count tops))
        eta (do (lam--trace "eta" m)
                `(~(primitive/code-nth m 0)
                  ~@(lam--eta-forms (primitive/code-cdr m) top-index)))
        _top-index-free (hm-free! [(slice u8) Code] (mut (field top-index entries)))]
    (lam--trace "lift" eta)
    (let [r (lam--lift-forms (primitive/code-cdr eta) 1)
          out (if (and (= (primitive/code-count (lam--defs r)) 0)
                       (primitive/code-eq eta m))
                  m
                `(~(primitive/code-nth m 0) ~@(lam--value r) ~@(lam--defs r)))]
      ;; Module-record heads and injected imports are synthetic.  An actual body
      ;; form carries the destination lexical context generated references need.
      out))))
(defn lambda-lift-module [(m Code)] (-> Code)
  (lambda-lift-module-visible m `(~m)))
(defn lambda-lift-mods [(ms Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(lambda-lift-module (primitive/code-nth ms i))
      ~@(lambda-lift-mods ms (+ i 1) n))))
