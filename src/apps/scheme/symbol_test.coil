(module coil.scheme.symbol-test)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use *)
(import "coil.control" :use *)
(import "coil.str" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.symbol" :use *)

(deftest same-name-is-the-same-object
  ; R5RS guarantees (eq? 'foo 'foo) — which holds here because interning returns
  ; the identical object, so eq? is a word compare and never a string compare.
  (let [a (intern "foo") b (intern "foo")]
    (assert (val-eq? a b))
    (assert (symbol-eq? a b))
    (assert (is-symbol a))))

(deftest different-names-differ
  (let [a (intern "foo") c (intern "bar")]
    (assert (not (val-eq? a c)))
    (assert (not (symbol-eq? a c)))))

(deftest names-round-trip
  (assert (str-eq (symbol-name (intern "lambda")) "lambda"))
  (assert (str-eq (symbol-name (intern "call-with-current-continuation"))
                   "call-with-current-continuation"))
  ; R5RS extended identifier characters must survive interning
  (assert (str-eq (symbol-name (intern "set!")) "set!"))
  (assert (str-eq (symbol-name (intern "string->symbol")) "string->symbol"))
  (assert (str-eq (symbol-name (intern "+")) "+"))
  (assert (str-eq (symbol-name (intern "...")) "...")))

(deftest interning-is-idempotent
  ; The performance rule this module exists to enforce: re-interning an existing
  ; name must allocate nothing. The predecessor's worst bug was interning inside
  ; the evaluator loop, which allocated a fresh symbol per dispatch.
  (intern "already-there")
  (let [before (gc-total)]
    (for [i 0 1000] (intern "already-there"))
    (assert-eq (gc-total) before)))

(deftest compiler-literal-cache-preserves-canonical-symbols
  ; The fast path is keyed by the stable address of a compiler string literal,
  ; but its miss must still return the same canonical object as dynamic interning.
  (let [first (intern-literal "quoted-hot-symbol")
        canonical (intern "quoted-hot-symbol")
        before (gc-total)]
    (for [i 0 1000]
      (assert (val-eq? (intern-literal "quoted-hot-symbol") first)))
    (assert (val-eq? first canonical))
    (assert-eq (gc-total) before)))

(deftest symbols-survive-collection
  ; Symbols are reachable only from the intern table, which the collector does not
  ; scan — so they are permanently rooted. If that rooting is wrong, the object is
  ; freed and reused, and two `eq?` symbols silently stop being eq?.
  (let [s (intern "durable")]
    (for [i 0 2000000] (cons (mk-fixnum i) (s-nil)))
    (assert (> (gc-collections) 0))
    (assert (val-eq? (intern "durable") s))
    (assert (str-eq (symbol-name s) "durable"))))
