(module coil.scheme.bignum)
(import "coil.primitive" :as primitive)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.slice" :use *)

;; Exact integers outside the 61-bit immediate range. A bignum object holds a
;; sign and a low-limb-first proper list of base-10^9 fixnums. Both slots are
;; ordinary Scheme Vals, so the existing precise collector traces the complete
;; representation without an opaque native allocation or finalizer.
(defn big-base [] (-> i64) 1000000000)
(defn big-sign [(v i64)] (-> i64)
  (fixnum-value (.b (obj-of v))))
(defn big-limbs [(v i64)] (-> i64)
  (.a (obj-of v)))
(defn big-length [(v i64)] (-> i64)
  (fixnum-value (.c (obj-of v))))
(defn integer-sign [(v i64)] (-> i64)
  (if (is-bignum v) (big-sign v)
    (let [n (fixnum-value v)] (if (< n 0) -1 (if (> n 0) 1 0)))))

(defn limbs-from-positive [(n i64)] (-> i64)
  (if (= n 0) (s-nil)
    (let [sp (gc-sp) rest (limbs-from-positive (/ n (big-base)))]
      (gc-root rest)
      (let [out (cons (mk-fixnum (% n (big-base))) rest)]
        (gc-sp-set! sp) out))))
(defn integer-limbs [(v i64)] (-> i64)
  (if (is-bignum v) (big-limbs v)
    (let [n (fixnum-value v)]
      (limbs-from-positive (if (< n 0) (- 0 n) n)))))

(defn mag-trim [(xs i64)] (-> i64)
  (if (is-null xs) xs
    (let [sp (gc-sp) rest (mag-trim (cdr xs))]
      (gc-root xs) (gc-root rest)
      (let [out (if (and (is-null rest) (= (fixnum-value (car xs)) 0)) (s-nil)
                  (cons (car xs) rest))]
        (gc-sp-set! sp) out))))
(defn mag-length [(xs i64)] (-> i64)
  (if (is-null xs) 0 (+ 1 (mag-length (cdr xs)))))
(defn mag-cmp-same [(a i64) (b i64)] (-> i64)
  (if (is-null a) 0
    (let [higher (mag-cmp-same (cdr a) (cdr b))]
      (if (not (= higher 0)) higher
        (let [x (fixnum-value (car a)) y (fixnum-value (car b))]
          (if (< x y) -1 (if (> x y) 1 0)))))))
(defn mag-cmp [(a i64) (b i64)] (-> i64)
  (let [la (mag-length a) lb (mag-length b)]
    (if (< la lb) -1 (if (> la lb) 1 (mag-cmp-same a b)))))

(defn mag-add [(a i64) (b i64) (carry i64)] (-> i64)
  (if (and (is-null a) (is-null b))
      (if (= carry 0) (s-nil) (cons (mk-fixnum carry) (s-nil)))
    (let [x (if (is-null a) 0 (fixnum-value (car a)))
          y (if (is-null b) 0 (fixnum-value (car b)))
          s (+ (+ x y) carry)]
      (let [sp (gc-sp)
            rest (mag-add (if (is-null a) a (cdr a))
                          (if (is-null b) b (cdr b))
                          (/ s (big-base)))]
        (gc-root rest)
        (let [out (cons (mk-fixnum (% s (big-base))) rest)]
          (gc-sp-set! sp) out)))))

;; Magnitude subtraction, precondition a >= b.
(defn mag-sub [(a i64) (b i64) (borrow i64)] (-> i64)
  (if (is-null a) (s-nil)
    (let [x (- (fixnum-value (car a)) borrow)
          y (if (is-null b) 0 (fixnum-value (car b)))
          low (if (< x y) (+ (- x y) (big-base)) (- x y))
          next-borrow (if (< x y) 1 0)]
      (let [sp (gc-sp)
            rest (mag-sub (cdr a) (if (is-null b) b (cdr b)) next-borrow)]
        (gc-root rest)
        (let [out (cons (mk-fixnum low) rest)] (gc-sp-set! sp) out)))))

(defn mag-mul-digit-known [(a i64) (n i64) (d i64) (carry i64)
                           (out-len (ptr i64))] (-> i64)
  ;; The allocator builds and fills the entire traced pair chain after one
  ;; collection check, avoiding a generic allocation call for every limb.
  (let [sp (gc-sp)]
    (gc-root a)
    (let [out (allocate-limb-product a n d carry out-len)]
      (gc-sp-set! sp) out)))
(defn mag-mul-digit [(a i64) (d i64) (carry i64)] (-> i64)
  (let [sp (gc-sp) (mut ignored-len) 0]
    (gc-root a)
    (let [out (mag-mul-digit-known a (mag-length a) d carry (mut ignored-len))]
      (gc-sp-set! sp) out)))
(defn mag-zero-prefix [(xs i64) (n i64)] (-> i64)
  (if (= n 0) xs
    (let [sp (gc-sp) rest (mag-zero-prefix xs (- n 1))]
      (gc-root rest)
      (let [out (cons (mk-fixnum 0) rest)] (gc-sp-set! sp) out))))
(defn mag-mul-loop [(a i64) (b i64) (shift i64) (acc i64)] (-> i64)
  (if (is-null b) acc
    (let [sp (gc-sp)]
      (gc-root a) (gc-root b) (gc-root acc)
      (let [digits (mag-mul-digit a (fixnum-value (car b)) 0)]
        (gc-root digits)
        (let [term (mag-zero-prefix digits shift)]
          (gc-root term)
          (let [next (mag-add acc term 0)]
            (gc-root next)
            (let [out (mag-mul-loop a (cdr b) (+ shift 1) next)]
              (gc-sp-set! sp) out)))))))
(defn mag-mul [(a i64) (b i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root a) (gc-root b)
    (let [raw (mag-mul-loop a b 0 (s-nil))]
      (gc-root raw)
      (let [out (mag-trim raw)] (gc-sp-set! sp) out))))

(defn big-normalize [(sign i64) (raw i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root raw)
    (let [xs (mag-trim raw)]
      (gc-root xs)
      (let [out
              (if (is-null xs) (mk-fixnum 0)
                (let [len (mag-length xs)]
                  (if (<= len 2)
                      (let [lo (fixnum-value (car xs))
                            hi (if (is-null (cdr xs)) 0 (fixnum-value (car (cdr xs))))
                            n (+ lo (* hi (big-base)))
                            limit (if (< sign 0) 1152921504606846976 1152921504606846975)]
                        (if (<= n limit) (mk-fixnum (if (< sign 0) (- 0 n) n))
                          (allocate (tag-bignum) xs (mk-fixnum sign) (mk-fixnum len))))
                    (allocate (tag-bignum) xs (mk-fixnum sign) (mk-fixnum len)))))]
        (gc-sp-set! sp)
        out))))

(defn big-from-i64 [(n i64)] (-> i64)
  (big-normalize (if (< n 0) -1 1)
                 (limbs-from-positive (if (< n 0) (- 0 n) n))))

(defn integer-add [(a i64) (b i64)] (-> i64)
  (let [sp (gc-sp) sa (integer-sign a) sb (integer-sign b)]
    (gc-root a) (gc-root b)
    (let [ma (integer-limbs a)]
      (gc-root ma)
      (let [mb (integer-limbs b)]
        (gc-root mb)
        (let [out
                (if (= sa 0) b
                  (if (= sb 0) a
                    (if (= sa sb) (big-normalize sa (mag-add ma mb 0))
                      (let [cmp (mag-cmp ma mb)]
                        (if (= cmp 0) (mk-fixnum 0)
                          (if (> cmp 0) (big-normalize sa (mag-sub ma mb 0))
                            (big-normalize sb (mag-sub mb ma 0))))))))]
          (gc-sp-set! sp) out)))))
(defn integer-negate [(v i64)] (-> i64)
  (if (is-bignum v)
      (let [sp (gc-sp)]
        (gc-root v)
        (let [out (allocate (tag-bignum) (big-limbs v)
                            (mk-fixnum (- 0 (big-sign v)))
                            (mk-fixnum (big-length v)))]
          (gc-sp-set! sp) out))
    (let [n (fixnum-value v)]
      (if (= n -1152921504606846976)
          (big-normalize 1 (integer-limbs v))
        (mk-fixnum (- 0 n))))))
(defn integer-sub [(a i64) (b i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root a) (gc-root b)
    (let [neg (integer-negate b)]
      (gc-root neg)
      (let [out (integer-add a neg)] (gc-sp-set! sp) out))))
(defn small-limb-fixnum? [(v i64)] (-> bool)
  (if (not (is-fixnum v)) false
    (let [n (fixnum-value v)]
      (and (> n (- 0 (big-base))) (< n (big-base))))))
(defn big-mul-small [(big i64) (small i64)] (-> i64)
  (let [sp (gc-sp) n (fixnum-value small)]
    (gc-root big)
    (if (= n 0) (do (gc-sp-set! sp) (mk-fixnum 0))
      ;; One base-10^9 digit needs one carry walk. Sending it through `mag-mul`
      ;; also built a shifted term, added that term to an empty accumulator, and
      ;; trimmed twice—several complete copies of the growing factorial value.
      (let [limbs (big-limbs big)]
        (gc-root limbs)
        (let [(mut len) 0
              raw (mag-mul-digit-known limbs (big-length big)
                                       (if (< n 0) (- 0 n) n) 0 (mut len))]
          (gc-root raw)
          ;; A canonical bignum multiplied by a nonzero integer of magnitude at
          ;; least one cannot shrink back into the fixnum range, and the digit
          ;; walk already omits a zero high carry. Avoid `big-normalize`'s full
          ;; trim and length passes over this known-canonical result.
          (let [out (allocate (tag-bignum) raw
                              (mk-fixnum
                                (* (big-sign big) (if (< n 0) -1 1)))
                              (mk-fixnum (load (mut len))))]
            (gc-sp-set! sp) out))))))
(defn integer-mul [(a i64) (b i64)] (-> i64)
  (if (and (is-bignum a) (small-limb-fixnum? b)) (big-mul-small a b)
  (if (and (is-bignum b) (small-limb-fixnum? a)) (big-mul-small b a)
  (let [sp (gc-sp) sa (integer-sign a) sb (integer-sign b)]
    (gc-root a) (gc-root b)
    (let [ma (integer-limbs a)]
      (gc-root ma)
      (let [mb (integer-limbs b)]
        (gc-root mb)
        (let [raw (if (or (= sa 0) (= sb 0)) (s-nil) (mag-mul ma mb))]
          (gc-root raw)
          (let [out (if (or (= sa 0) (= sb 0)) (mk-fixnum 0)
                      (big-normalize (* sa sb) raw))]
            (gc-sp-set! sp) out))))))))
(defn integer-cmp [(a i64) (b i64)] (-> i64)
  (let [sa (integer-sign a) sb (integer-sign b)]
    (if (< sa sb) -1 (if (> sa sb) 1
      (if (= sa 0) 0
        (let [m (mag-cmp (integer-limbs a) (integer-limbs b))]
          (if (< sa 0) (- 0 m) m)))))))
(defn mag-to-f64 [(xs i64)] (-> f64)
  (if (is-null xs) 0.0
    (primitive/fadd (primitive/cast f64 (fixnum-value (car xs)))
                    (primitive/fmul 1000000000.0 (mag-to-f64 (cdr xs))))))
(defn integer-to-f64 [(v i64)] (-> f64)
  (if (is-fixnum v) (primitive/cast f64 (fixnum-value v))
    (let [m (mag-to-f64 (big-limbs v))]
      (if (< (big-sign v) 0) (primitive/fsub 0.0 m) m))))

(defn integer-power-of-two [(e i64)] (-> i64)
  (let [sp (gc-sp) (mut out) (mk-fixnum 1)]
    (for [i 0 e]
      (do
        (gc-sp-set! sp)
        (gc-root (load (mut out)))
        (store! (mut out) (integer-add (load (mut out)) (load (mut out))))))
    (let [result (load (mut out))]
      (gc-sp-set! sp)
      (gc-root result)
      result)))

(defn big-digit [(c i64) (radix i64)] (-> i64)
  (let [d (if (and (>= c 48) (<= c 57)) (- c 48)
            (if (and (>= c 97) (<= c 122)) (- c 87)
              (if (and (>= c 65) (<= c 90)) (- c 55) -1)))]
    (if (or (< d 0) (>= d radix)) -1 d)))

;; Validated arbitrary-size integer parser. Accumulating through integer-mul/add
;; naturally stays a fixnum for small inputs and promotes only at the boundary.
(defn integer-from-slice [(s (slice u8)) (radix i64)] (-> i64)
  (let [n (slice-len [u8] s)]
    (if (or (= n 0) (or (< radix 2) (> radix 36))) (s-false)
      (let [first (primitive/cast i64 (slice-get [u8] s 0))
            neg (= first 45) plus (= first 43)
            start (if (or neg plus) 1 0)
            (mut acc) (mk-fixnum 0)
            (mut ok) (< start n)]
        (for [i start n]
          (let [d (big-digit (primitive/cast i64 (slice-get [u8] s i)) radix)]
            (if (< d 0) (store! (mut ok) false)
              (store! (mut acc)
                      (integer-add (integer-mul (load (mut acc)) (mk-fixnum radix))
                                   (mk-fixnum d))))))
        (if (not (load (mut ok))) (s-false)
          (if neg (integer-negate (load (mut acc))) (load (mut acc))))))))

(defn integer-abs [(v i64)] (-> i64)
  (if (< (integer-sign v) 0) (integer-negate v) v))

;; Positive long division by subtracting the largest power-of-two multiple of
;; the divisor that fits. This is quadratic in bit length, but has no host-sized
;; escape hatch and is ample for the report's integer procedures. A future limb
;; Knuth division can replace it without changing the representation or surface.
(defn integer-div-positive [(num i64) (den i64)] (-> i64)
  (let [sp (gc-sp) (mut rem) num (mut q) (mk-fixnum 0)]
    (gc-root num) (gc-root den)
    (loop
      (if (< (integer-cmp (load (mut rem)) den) 0) (break)
        (let [(mut chunk) den (mut factor) (mk-fixnum 1) (mut seeking) true]
          (loop
            (if (not (load (mut seeking))) (break)
              (do
                (gc-root (load (mut rem)))
                (gc-root (load (mut chunk)))
                (gc-root (load (mut factor)))
              (let [twice (integer-add (load (mut chunk))
                                       (load (mut chunk)))]
                (gc-root twice)
                (if (> (integer-cmp twice (load (mut rem))) 0)
                    (set! (mut seeking) false)
                  (do (set! (mut chunk) twice)
                      (set! (mut factor)
                            (integer-add (load (mut factor))
                                         (load (mut factor))))))))))
          (gc-root (load (mut rem)))
          (gc-root (load (mut q)))
          (gc-root (load (mut chunk)))
          (gc-root (load (mut factor)))
          (set! (mut rem) (integer-sub (load (mut rem)) (load (mut chunk))))
          (gc-root (load (mut rem)))
          (set! (mut q) (integer-add (load (mut q)) (load (mut factor))))
          ;; `q` must survive the next iteration's entire chunk-search loop.
          (gc-root (load (mut q))))))
    (let [out (load (mut q))]
      (gc-sp-set! sp) out)))

(defn integer-quotient [(a i64) (b i64)] (-> i64)
  (let [sp (gc-sp) sa (integer-sign a) sb (integer-sign b)]
    (gc-root a) (gc-root b)
    (let [out (if (= sb 0) (s-unspecified)
      (let [aa (integer-abs a) bb (integer-abs b)]
        (gc-root aa) (gc-root bb)
        (let [q (integer-div-positive aa bb)]
          (gc-root q)
          (if (= sa sb) q (integer-negate q)))))]
      (gc-sp-set! sp) out)))
(defn integer-remainder [(a i64) (b i64)] (-> i64)
  (if (= (integer-sign b) 0) (s-unspecified)
    (let [sp (gc-sp)]
      (gc-root a) (gc-root b)
      (let [q (integer-quotient a b)]
        (gc-root q)
        (let [product (integer-mul q b)]
          (gc-root product)
          (let [out (integer-sub a product)] (gc-sp-set! sp) out))))))
(defn integer-modulo [(a i64) (b i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root a) (gc-root b)
    (let [r (integer-remainder a b)]
      (gc-root r)
      (let [out (if (or (= (integer-sign r) 0) (= (integer-sign r) (integer-sign b))) r
                  (integer-add r b))]
        (gc-sp-set! sp) out))))
(defn integer-gcd [(a i64) (b i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root a) (gc-root b)
    (let [x (integer-abs a) y (integer-abs b)]
      (gc-root x) (gc-root y)
      (let [out
              (if (= (integer-sign y) 0) x
                (let [r (integer-remainder x y)]
                  (gc-root r)
                  (integer-gcd y r)))]
        (gc-sp-set! sp) out))))

(defn make-rational [(num i64) (den i64)] (-> i64)
  (if (= (integer-sign den) 0) (s-unspecified)
    (let [sp (gc-sp)]
      ;; This runtime module is not rewritten by the dialect rooting pass. Keep
      ;; every completed exact value alive while normalization performs further
      ;; allocating bignum operations.
      (gc-root num)
      (gc-root den)
      (let [n (if (< (integer-sign den) 0) (integer-negate num) num)]
        (gc-root n)
        (let [d (integer-abs den)]
          (gc-root d)
          (let [g (integer-gcd n d)]
            (gc-root g)
            (let [rn (integer-quotient n g)]
              (gc-root rn)
              (let [rd (integer-quotient d g)]
                (gc-root rd)
                (let [out (if (= (integer-cmp rd (mk-fixnum 1)) 0) rn
                            (allocate (tag-ratnum) rn rd 0))]
                  (gc-sp-set! sp)
                  (gc-root out)
                  out)))))))))

(export big-sign big-limbs big-length integer-sign integer-limbs big-normalize big-from-i64
        integer-add integer-negate integer-sub integer-mul integer-cmp integer-to-f64
        integer-power-of-two
        integer-abs integer-quotient integer-remainder integer-modulo integer-gcd
        make-rational
        mag-length mag-cmp integer-from-slice)
