(module coil.scheme.ffi)
(import "coil.primitive" :as primitive)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.stdproc" :use [string-length-raw string-code make-string-raw string-set-code!])
(import "coil.scheme.symbol" :use [intern symbol-name])
(import "coil.sync" :as sync)

(extern malloc :cc c [i64] (-> (ptr u8)))
(extern free :cc c [(ptr u8)] (-> void))
(extern dlsym :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern dlopen :cc c [(ptr i8) i32] (-> (ptr i8)))

;; Native addresses are boxed because a Scheme fixnum has only 61 payload bits
;; and an aligned bare address looks exactly like a managed object to the GC.
(defn ffi-pointer [(address i64) (owned bool)] (-> i64)
  (if (= address 0) (s-false)
    (allocate (tag-foreign-pointer) address (if owned 1 0) 0)))

;; Accept bytevectors wherever C asks for u8*, matching Chez's FFI convention.
(defn ffi-pointer-address [(v i64)] (-> i64)
  (if (is-foreign-pointer v)
      (load (field (obj-of v) a))
    (if (is-bytevector v)
        (load (field (obj-of v) a))
      (if (is-fixnum v) (fixnum-value v) 0))))

(defn ffi-pointer-free! [(v i64)] (-> i64)
  (if (not (is-foreign-pointer v)) (s-unspecified)
    (let [o (obj-of v)]
      (if (= (load (field o b)) 1)
          (do (free (primitive/cast (ptr u8) (load (field o a)))) 0)
        0)
      (store! (field o a) 0)
      (store! (field o b) 0)
      (s-unspecified))))

(defn ffi-string-cstr [(s i64)] (-> (ptr i8))
  (let [n (string-length-raw s)
        p (primitive/cast (ptr i8) (malloc (+ n 1)))]
    (for [i 0 n]
      (store! (primitive/index p i) (primitive/cast i8 (string-code s i))))
    (store! (primitive/index p n) (primitive/cast i8 0))
    p))
(defn ffi-cstr-free [(p (ptr i8))] (-> i64)
  (free (primitive/cast (ptr u8) p)) 0)

;; Resolve in the current image. This is the same address space as the compiler
;; and the running metaprogram; no helper executable or dynamic child exists.
(defn ffi-resolve [(name i64)] (-> i64)
  (let [p (ffi-string-cstr name)
        address (dlsym (primitive/cast (ptr i8) 0) p)]
    (ffi-cstr-free p)
    (ffi-pointer (primitive/cast i64 address) false)))

(defn foreign-alloc [(n i64)] (-> i64)
  (mk-fixnum (primitive/cast i64 (malloc (fixnum-value n)))))
(defn foreign-free [(address i64)] (-> i64)
  (free (primitive/cast (ptr u8) (ffi-pointer-address address)))
  (s-unspecified))
(defn foreign-type-name [(ty i64)] (-> (slice u8))
  (if (is-symbol ty) (symbol-name ty) ""))
(defn foreign-pointer-type? [(name (slice u8))] (-> bool)
  (or (= name "void*") (or (= name "iptr") (= name "uptr"))))
(defn foreign-sizeof [(ty i64)] (-> i64)
  (let [name (foreign-type-name ty)]
    (mk-fixnum
      (if (or (= name "unsigned-8") (or (= name "integer-8") (= name "char"))) 1
        (if (or (= name "unsigned-16") (= name "integer-16")) 2
          (if (or (= name "unsigned-32")
                  (or (= name "integer-32") (or (= name "unsigned-int") (= name "int")))) 4
            8))))))
(defn foreign-ref [(ty i64) (address i64) (offset i64)] (-> i64)
  (let [name (foreign-type-name ty)
        p (primitive/index (primitive/cast (ptr u8) (ffi-pointer-address address))
                           (fixnum-value offset))]
    (if (or (= name "unsigned-8") (= name "char"))
        (mk-fixnum (primitive/cast i64 (load p)))
      (if (= name "integer-8")
          (mk-fixnum (primitive/cast i64 (load (primitive/cast (ptr i8) p))))
        (if (or (= name "unsigned-16") (= name "integer-16"))
            (mk-fixnum (primitive/cast i64 (load (primitive/cast (ptr i16) p))))
          (if (or (= name "unsigned-32")
                  (or (= name "integer-32") (or (= name "unsigned-int") (= name "int"))))
              (mk-fixnum (primitive/cast i64 (load (primitive/cast (ptr i32) p))))
            (mk-fixnum (load (primitive/cast (ptr i64) p)))))))))
(defn foreign-set! [(ty i64) (address i64) (offset i64) (value i64)] (-> i64)
  (let [name (foreign-type-name ty)
        p (primitive/index (primitive/cast (ptr u8) (ffi-pointer-address address))
                           (fixnum-value offset))
        raw (if (foreign-pointer-type? name) (ffi-pointer-address value)
              (fixnum-value value))]
    (if (or (= name "unsigned-8") (or (= name "integer-8") (= name "char")))
        (store! p (primitive/cast u8 raw))
      (if (or (= name "unsigned-16") (= name "integer-16"))
          (store! (primitive/cast (ptr i16) p) (primitive/cast i16 raw))
        (if (or (= name "unsigned-32")
                (or (= name "integer-32") (or (= name "unsigned-int") (= name "int"))))
            (store! (primitive/cast (ptr i32) p) (primitive/cast i32 raw))
          (store! (primitive/cast (ptr i64) p) raw))))
    (s-unspecified)))
(defn lock-object [(v i64)] (-> i64) (let [ignored v] (s-unspecified)))
(defn unlock-object [(v i64)] (-> i64) (let [ignored v] (s-unspecified)))
(defn load-shared-object [(name i64)] (-> i64)
  (if (val-eq? name (s-false))
      (do (dlopen (primitive/cast (ptr i8) 0) 2) (s-unspecified))
    (let [p (ffi-string-cstr name)]
      (dlopen p 2)
      (ffi-cstr-free p)
      (s-unspecified))))
;; Runtime Scheme `(load path)` is distinct from the dialect's source-inclusion
;; form. At this late boundary PATH names an already-compiled shared object;
;; dlopen both maps it and runs its initializer in this process.
(defn scheme-load [(name i64)] (-> i64) (load-shared-object name))
(defn foreign-entry [(name i64)] (-> i64) (ffi-resolve name))
(defn foreign-entry? [(name i64)] (-> i64)
  (mk-bool (not (val-eq? (ffi-resolve name) (s-false)))))
(defn foreign-callable-entry-point [(callable i64)] (-> i64)
  (mk-fixnum (ffi-pointer-address callable)))

(defn make-bytevector-raw [(n i64) (fill i64)] (-> i64)
  (let [p (malloc (if (= n 0) 1 n))]
    (for [i 0 n] (store! (primitive/index p i) (primitive/cast u8 fill)))
    (allocate (tag-bytevector) (primitive/cast i64 p) (mk-fixnum n) 1)))
(defn scm-make-bytevector [(n i64)] (-> i64)
  (make-bytevector-raw (fixnum-value n) 0))
(defn scm-make-bytevector-fill [(n i64) (fill i64)] (-> i64)
  (make-bytevector-raw (fixnum-value n) (fixnum-value fill)))
(defn bytevector-length [(v i64)] (-> i64) (load (field (obj-of v) b)))
(defn bytevector-u8-ref [(v i64) (i i64)] (-> i64)
  (mk-fixnum (primitive/cast i64
    (load (primitive/index (primitive/cast (ptr u8) (ffi-pointer-address v))
                           (fixnum-value i))))))
(defn bytevector-u8-set! [(v i64) (i i64) (x i64)] (-> i64)
  (store! (primitive/index (primitive/cast (ptr u8) (ffi-pointer-address v))
                           (fixnum-value i))
          (primitive/cast u8 (fixnum-value x)))
  (s-unspecified))
(defn bytevector? [(v i64)] (-> i64) (mk-bool (is-bytevector v)))
(defn bytevector-copy-loop! [(src i64) (src-start i64) (dst i64)
                             (dst-start i64) (n i64) (i i64)] (-> i64)
  (if (>= i n) (s-unspecified)
      (do
        (bytevector-u8-set! dst (mk-fixnum (+ dst-start i))
                            (bytevector-u8-ref src (mk-fixnum (+ src-start i))))
        (bytevector-copy-loop! src src-start dst dst-start n (+ i 1)))))
(defn bytevector-copy! [(src i64) (src-start i64) (dst i64)
                        (dst-start i64) (count i64)] (-> i64)
  (bytevector-copy-loop! src (fixnum-value src-start) dst
                         (fixnum-value dst-start) (fixnum-value count) 0))
(defn endian-little? [(endianness i64)] (-> bool)
  (val-eq? endianness (intern "little")))
(defn bytevector-uint-ref-loop [(bv i64) (start i64) (bytes i64)
                                (little bool) (i i64) (acc i64)] (-> i64)
  (if (>= i bytes) acc
      (let [at (if little (+ start i) (+ start (- (- bytes 1) i)))
            byte (bv-u8 bv at)]
        (bytevector-uint-ref-loop bv start bytes little (+ i 1)
          (primitive/ior acc (primitive/ishl byte (* i 8)))))))
(defn bytevector-uint-ref [(bv i64) (index i64) (bytes i64) (endianness i64)] (-> i64)
  (mk-fixnum (bytevector-uint-ref-loop bv (fixnum-value index) bytes
                                       (endian-little? endianness) 0 0)))
(defn bytevector-u16-ref [(bv i64) (index i64) (endianness i64)] (-> i64)
  (bytevector-uint-ref bv index 2 endianness))
(defn bytevector-u32-ref [(bv i64) (index i64) (endianness i64)] (-> i64)
  (bytevector-uint-ref bv index 4 endianness))
(defn bytevector-u64-ref [(bv i64) (index i64) (endianness i64)] (-> i64)
  (bytevector-uint-ref bv index 8 endianness))
(defn bytevector-s64-ref [(bv i64) (index i64) (endianness i64)] (-> i64)
  (bytevector-u64-ref bv index endianness))
(defn bytevector-uint-set-loop! [(bv i64) (start i64) (bytes i64) (little bool)
                                 (value i64) (i i64)] (-> i64)
  (if (>= i bytes) (s-unspecified)
      (let [at (if little (+ start i) (+ start (- (- bytes 1) i)))]
        (utf8-put! bv at (primitive/iand (primitive/ishr value (* i 8)) 255))
        (bytevector-uint-set-loop! bv start bytes little value (+ i 1)))))
(defn bytevector-s64-set! [(bv i64) (index i64) (value i64) (endianness i64)] (-> i64)
  (bytevector-uint-set-loop! bv (fixnum-value index) 8 (endian-little? endianness)
                             (fixnum-value value) 0))
(defn bytevector-u64-set! [(bv i64) (index i64) (value i64) (endianness i64)] (-> i64)
  (bytevector-s64-set! bv index value endianness))
(defn bytevector-u32-native-ref [(bv i64) (index i64)] (-> i64)
  (bytevector-u32-ref bv index (intern "little")))
(defn bytevector-u64-native-set! [(bv i64) (index i64) (value i64)] (-> i64)
  (bytevector-u64-set! bv index value (intern "little")))
(defn bytevector-ieee-double-native-set! [(bv i64) (index i64) (value i64)] (-> i64)
  (bytevector-uint-set-loop! bv (fixnum-value index) 8 true
                             (f64->raw-bits (flonum-value value)) 0))
(defn utf8-width [(c i64)] (-> i64)
  (if (< c 128) 1 (if (< c 2048) 2 (if (< c 65536) 3 4))))
(defn string-utf8-length [(s i64) (i i64) (n i64) (bytes i64)] (-> i64)
  (if (>= i n) bytes
      (string-utf8-length s (+ i 1) n (+ bytes (utf8-width (string-code s i))))))
(defn utf8-put! [(bv i64) (i i64) (x i64)] (-> i64)
  (bytevector-u8-set! bv (mk-fixnum i) (mk-fixnum x)))
(defn string->utf8-fill! [(s i64) (bv i64) (si i64) (sn i64) (bi i64)] (-> i64)
  (if (>= si sn) bv
      (let [c (string-code s si) w (utf8-width (string-code s si))]
        (if (= w 1) (utf8-put! bv bi c)
            (if (= w 2)
                (do (utf8-put! bv bi (+ 192 (primitive/ishr c 6)))
                    (utf8-put! bv (+ bi 1) (+ 128 (primitive/iand c 63))))
                (if (= w 3)
                    (do (utf8-put! bv bi (+ 224 (primitive/ishr c 12)))
                        (utf8-put! bv (+ bi 1) (+ 128 (primitive/iand (primitive/ishr c 6) 63)))
                        (utf8-put! bv (+ bi 2) (+ 128 (primitive/iand c 63))))
                    (do (utf8-put! bv bi (+ 240 (primitive/ishr c 18)))
                        (utf8-put! bv (+ bi 1) (+ 128 (primitive/iand (primitive/ishr c 12) 63)))
                        (utf8-put! bv (+ bi 2) (+ 128 (primitive/iand (primitive/ishr c 6) 63)))
                        (utf8-put! bv (+ bi 3) (+ 128 (primitive/iand c 63)))))))
        (string->utf8-fill! s bv (+ si 1) sn (+ bi w)))))
(defn string->utf8 [(s i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root s)
    (let [n (string-length-raw s)
          bv (make-bytevector-raw (string-utf8-length s 0 (string-length-raw s) 0) 0)]
      (gc-root bv)
      (string->utf8-fill! s bv 0 n 0)
      (gc-sp-set! sp)
      bv)))
(defn bv-u8 [(bv i64) (i i64)] (-> i64)
  (fixnum-value (bytevector-u8-ref bv (mk-fixnum i))))
(defn utf8-sequence-width [(b i64)] (-> i64)
  (if (< b 128) 1 (if (< b 224) 2 (if (< b 240) 3 4))))
(defn utf8-char-count [(bv i64) (i i64) (n i64) (count i64)] (-> i64)
  (if (>= i n) count
      (utf8-char-count bv (+ i (utf8-sequence-width (bv-u8 bv i))) n (+ count 1))))
(defn utf8-codepoint [(bv i64) (i i64) (w i64)] (-> i64)
  (if (= w 1) (bv-u8 bv i)
      (if (= w 2)
          (+ (* (primitive/iand (bv-u8 bv i) 31) 64)
             (primitive/iand (bv-u8 bv (+ i 1)) 63))
          (if (= w 3)
              (+ (* (primitive/iand (bv-u8 bv i) 15) 4096)
                 (+ (* (primitive/iand (bv-u8 bv (+ i 1)) 63) 64)
                    (primitive/iand (bv-u8 bv (+ i 2)) 63)))
              (+ (* (primitive/iand (bv-u8 bv i) 7) 262144)
                 (+ (* (primitive/iand (bv-u8 bv (+ i 1)) 63) 4096)
                    (+ (* (primitive/iand (bv-u8 bv (+ i 2)) 63) 64)
                       (primitive/iand (bv-u8 bv (+ i 3)) 63))))))))
(defn utf8->string-fill! [(bv i64) (s i64) (bi i64) (bn i64) (si i64)] (-> i64)
  (if (>= bi bn) s
      (let [w (utf8-sequence-width (bv-u8 bv bi))]
        (string-set-code! s si (utf8-codepoint bv bi w))
        (utf8->string-fill! bv s (+ bi w) bn (+ si 1)))))
(defn utf8->string [(bv i64)] (-> i64)
  (let [sp (gc-sp) n (fixnum-value (bytevector-length bv))]
    (gc-root bv)
    (let [s (make-string-raw (utf8-char-count bv 0 n 0))]
      (gc-root s)
      (utf8->string-fill! bv s 0 n 0)
      (gc-sp-set! sp)
      s)))

(defn utf16-big? [(endianness i64)] (-> bool)
  (val-eq? endianness (intern "big")))
(defn string->utf16-fill! [(s i64) (bv i64) (i i64) (n i64) (big bool)] (-> i64)
  (if (>= i n) bv
    (let [c (string-code s i)
          hi (primitive/iand (primitive/ishr c 8) 255)
          lo (primitive/iand c 255)
          at (* i 2)]
      (utf8-put! bv at (if big hi lo))
      (utf8-put! bv (+ at 1) (if big lo hi))
      (string->utf16-fill! s bv (+ i 1) n big))))
(defn string->utf16 [(s i64) (endianness i64)] (-> i64)
  (let [sp (gc-sp) n (string-length-raw s)]
    (gc-root s) (gc-root endianness)
    (let [bv (make-bytevector-raw (* n 2) 0)]
      (gc-root bv)
      (string->utf16-fill! s bv 0 n (utf16-big? endianness))
      (gc-sp-set! sp)
      bv)))
(defn utf16->string-fill! [(bv i64) (s i64) (i i64) (n i64) (big bool)] (-> i64)
  (if (>= i n) s
    (let [at (* i 2)
          a (bv-u8 bv at)
          b (bv-u8 bv (+ at 1))
          c (if big (+ (* a 256) b) (+ (* b 256) a))]
      (string-set-code! s i c)
      (utf16->string-fill! bv s (+ i 1) n big))))
(defn utf16->string [(bv i64) (endianness i64)] (-> i64)
  (let [sp (gc-sp) n (/ (fixnum-value (bytevector-length bv)) 2)]
    (gc-root bv) (gc-root endianness)
    (let [s (make-string-raw n)]
      (gc-root s)
      (utf16->string-fill! bv s 0 n (utf16-big? endianness))
      (gc-sp-set! sp)
      s)))
(defn string->utf32-fill! [(s i64) (bv i64) (i i64) (n i64) (big bool)] (-> i64)
  (if (>= i n) bv
    (let [c (string-code s i) at (* i 4)]
      (for [j 0 4]
        (let [shift (* (if big (- 3 j) j) 8)]
          (utf8-put! bv (+ at j) (primitive/iand (primitive/ishr c shift) 255))))
      (string->utf32-fill! s bv (+ i 1) n big))))
(defn string->utf32 [(s i64) (endianness i64)] (-> i64)
  (let [sp (gc-sp) n (string-length-raw s)]
    (gc-root s) (gc-root endianness)
    (let [bv (make-bytevector-raw (* n 4) 0)]
      (gc-root bv)
      (string->utf32-fill! s bv 0 n (utf16-big? endianness))
      (gc-sp-set! sp)
      bv)))
(defn utf32-codepoint [(bv i64) (at i64) (big bool) (j i64) (acc i64)] (-> i64)
  (if (>= j 4) acc
    (let [shift (* (if big (- 3 j) j) 8)]
      (utf32-codepoint bv at big (+ j 1)
        (primitive/ior acc (primitive/ishl (bv-u8 bv (+ at j)) shift))))))
(defn utf32->string-fill! [(bv i64) (s i64) (i i64) (n i64) (big bool)] (-> i64)
  (if (>= i n) s
    (do (string-set-code! s i (utf32-codepoint bv (* i 4) big 0 0))
        (utf32->string-fill! bv s (+ i 1) n big))))
(defn utf32->string [(bv i64) (endianness i64)] (-> i64)
  (let [sp (gc-sp) n (/ (fixnum-value (bytevector-length bv)) 4)]
    (gc-root bv) (gc-root endianness)
    (let [s (make-string-raw n)]
      (gc-root s)
      (utf32->string-fill! bv s 0 n (utf16-big? endianness))
      (gc-sp-set! sp)
      s)))

(defn bytevector-copy [(src i64)] (-> i64)
  (let [sp (gc-sp) n (fixnum-value (bytevector-length src))]
    (gc-root src)
    (let [out (make-bytevector-raw n 0)]
      (gc-root out)
      (bytevector-copy! src (mk-fixnum 0) out (mk-fixnum 0) (mk-fixnum n))
      (gc-sp-set! sp)
      (gc-root out)
      out)))
(defn bytevector->u8-list-loop [(bv i64) (i i64) (n i64)] (-> i64)
  (if (>= i n) (s-nil)
      (let [sp (gc-sp)]
        (gc-root bv)
        (let [tail (bytevector->u8-list-loop bv (+ i 1) n)]
          (gc-root tail)
          (let [out (cons (bytevector-u8-ref bv (mk-fixnum i)) tail)]
            (gc-root out)
            (gc-sp-set! sp)
            (gc-root out)
            out)))))
(defn bytevector->u8-list [(bv i64)] (-> i64)
  (bytevector->u8-list-loop bv 0 (fixnum-value (bytevector-length bv))))

;; Chez permits the empty variadic constructor.  Non-empty bytevector literals
;; are handled at the syntax seam, where their arity is known.
(defn bytevector [] (-> i64) (make-bytevector-raw 0 0))

;; Scheme's optional fill argument is lowered at the syntax seam, since Coil
;; functions themselves have fixed arity.
(defn make-bytevector [(n i64)] (-> i64) (scm-make-bytevector n))

;; Native synchronization stays in this process and uses Coil's existing
;; pthread-backed implementation. The Scheme heap owns these boxes; sweep calls
;; the corresponding destroy operation before releasing the outer struct.
(defn scm-make-mutex [] (-> i64)
  (let [p (primitive/cast (ptr sync/Mutex) (malloc (sizeof sync/Mutex)))]
    (match (sync/mutex-init p)
      (Ok [_] (allocate (tag-mutex) (primitive/cast i64 p) 0 0))
      (Err [_] (do (free (primitive/cast (ptr u8) p)) (s-false))))))
(defn make-mutex [] (-> i64) (scm-make-mutex))
(defn mutex-acquire [(m i64)] (-> i64)
  (match (sync/mutex-lock!
           (primitive/cast (ptr sync/Mutex) (load (field (obj-of m) a))))
    (Ok [_] (s-unspecified))
    (Err [_] (s-false))))
(defn scm-mutex-acquire [(m i64) (block i64)] (-> i64)
  (if (truthy? block) (mutex-acquire m)
      (match (sync/mutex-try-lock!
               (primitive/cast (ptr sync/Mutex) (load (field (obj-of m) a))))
        (Ok [got] (mk-bool got))
        (Err [_] (s-false)))))
(defn mutex-release [(m i64)] (-> i64)
  (match (sync/mutex-unlock!
           (primitive/cast (ptr sync/Mutex) (load (field (obj-of m) a))))
    (Ok [_] (s-unspecified))
    (Err [_] (s-false))))
(defn scm-make-condition [] (-> i64)
  (let [p (primitive/cast (ptr sync/Condition) (malloc (sizeof sync/Condition)))]
    (match (sync/condition-init p)
      (Ok [_] (allocate (tag-condition) (primitive/cast i64 p) 0 0))
      (Err [_] (do (free (primitive/cast (ptr u8) p)) (s-false))))))
(defn make-condition [] (-> i64) (scm-make-condition))
(defn condition-wait [(c i64) (m i64)] (-> i64)
  (match (sync/condition-wait!
           (primitive/cast (ptr sync/Condition) (load (field (obj-of c) a)))
           (primitive/cast (ptr sync/Mutex) (load (field (obj-of m) a))))
    (Ok [_] (s-unspecified))
    (Err [_] (s-false))))
(defn scm-condition-wait-timeout [(c i64) (m i64) (deadline i64)] (-> i64)
  ;; Deadline-aware waiting is wired when the Chez time object below is lowered
  ;; to coil.time.Duration. Preserve synchronization correctness meanwhile: a
  ;; wake is reported true and never crosses a process boundary.
  (let [ignored deadline]
    (condition-wait c m)
    (s-true)))
(defn condition-signal [(c i64)] (-> i64)
  (match (sync/condition-notify-one!
           (primitive/cast (ptr sync/Condition) (load (field (obj-of c) a))))
    (Ok [_] (s-unspecified))
    (Err [_] (s-false))))
(defn condition-broadcast [(c i64)] (-> i64)
  (match (sync/condition-notify-all!
           (primitive/cast (ptr sync/Condition) (load (field (obj-of c) a))))
    (Ok [_] (s-unspecified))
    (Err [_] (s-false))))
(defn condition? [(v i64)] (-> i64) (mk-bool (is-exception-condition v)))
