(module coil.scheme.forms-test)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.str" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.symbol" :use *)
(import "coil.scheme.core" :use *)
(import "coil.scheme.forms" :use *)

;; `forms.coil` is exercised as a MACRO surface, not through the transform: these
;; call `+`/`-`/`*`/`<`/`list`/`quote-data` directly, which is exactly how a
;; Scheme module reaches them after the dialect has run. Literal lifting is done
;; per-argument by each macro, so the bare `1` below is the case under test.

;; Walk a Scheme list without the list chunk, so structure can be asserted here.
(defn len [(v i64)] (-> i64) (if (is-pair v) (primitive/iadd 1 (len (cdr v))) 0))
(defn nth [(v i64) (i i64)] (-> i64)
  ; `=` is the Scheme numeric macro imported below; this helper indexes with a
  ; host i64 and therefore must use the host comparison explicitly.
  (if (primitive/icmp-eq i (primitive/cast i64 0))
      (car v)
      (nth (cdr v) (primitive/isub i 1))))

(deftest arithmetic-folds-left
  ;; `-` and `/` are the asymmetric ones: `(- 10 1 2)` is 7, not 11, so a fold in
  ;; the wrong direction is visible only with three or more arguments.
  (assert-eq (fixnum-value (+ 1 2 3)) 6)
  (assert-eq (fixnum-value (- 10 1 2)) 7)
  (assert-eq (fixnum-value (* 2 3 4)) 24))

(deftest arithmetic-identities-and-negation
  ;; R5RS gives `(+)` and `(*)` identities, and `(- 5)` NEGATES rather than folds.
  (assert-eq (fixnum-value (+)) 0)
  (assert-eq (fixnum-value (*)) 1)
  (assert-eq (fixnum-value (- 5)) -5))

(deftest comparisons-chain
  ;; `(< 1 2 3)` is the conjunction of ADJACENT pairs, not `(< 1 3)`.
  (assert (truthy? (< 1 2 3)))
  (assert (not (truthy? (< 1 3 2))))
  (assert (truthy? (= 2 2 2)))
  (assert (not (truthy? (> 1 2)))))

(deftest literals-lift-to-vals
  ;; A bare `1` is a raw i64 until a form lifts it; `#t`/`#f` are the singletons.
  (assert (truthy? (+ 1)))
  (assert (is-fixnum (+ 1 0)))
  ;; `#t`/`#f` as bare expressions are lowered by the whole-module transform,
  ;; which only runs for modules importing `coil.scheme`; this one does not, so
  ;; the macros that spell the same values are what is asserted here.
  (assert (truthy? (scm-true)))
  (assert (not (truthy? (scm-false)))))

(deftest list-builds-a-proper-spine
  (let [l (list 1 2 3)]
    (assert-eq (len l) 3)
    (assert-eq (fixnum-value (nth l 0)) 1)
    (assert-eq (fixnum-value (nth l 2)) 3))
  (assert-eq (len (list)) 0))

(deftest quote-materializes-data
  ;; `quote-data` is what the transform rewrites `(quote X)` into. Symbols must be
  ;; INTERNED so `eq?` holds, which is the property tested here rather than shape.
  (let [l (quote-data (a b c))]
    (assert-eq (len l) 3)
    (assert (val-eq? (nth l 0) (intern "a")))
    (assert (val-eq? (nth l 2) (intern "c"))))
  (assert (is-null (quote-data ())))
  (assert-eq (fixnum-value (nth (quote-data (1 2)) 1)) 2))

(deftest quoted-char-and-boolean-literals
  ;; `#\a` reads as a symbol whose text keeps the `#\` prefix; it must become a
  ;; char Val, not an interned symbol.
  (assert (is-char (quote-data #\a)))
  (assert-eq (char-value (quote-data #\a)) 97)
  (assert-eq (char-value (quote-data #\space)) 32)
  (assert-eq (char-value (quote-data #\newline)) 10)
  (assert (val-eq? (quote-data #t) (s-true)))
  (assert (val-eq? (quote-data #f) (s-false))))
