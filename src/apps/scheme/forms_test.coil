(module coil.scheme.forms-test)
(import "coil.assert" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.symbol" :use *)
(import "coil.scheme.core" :use *)
(import "coil.scheme.forms" :use *)

;; The corners of R5RS §4.1 that are easy to get wrong, tested for the SEMANTICS
;; rather than the happy path. Each test names the rule it pins down.
;;
;; This module deliberately does NOT import `coil.scheme`, so the dialect's
;; before-expand pass leaves it alone: the tests call the forms directly and
;; assert on the Vals they produce, which is what isolates a bug in this file
;; from a bug in the surface lowering.

; ---- variadic arithmetic ----------------------------------------------------
;; R5RS 6.2.5: `+` and `*` have identities, `-` negates when given one argument,
;; and all of them fold LEFT — which is the only thing that makes `-` and `/`
;; mean what the standard says.
(deftest arithmetic-is-variadic
  (assert-eq (fixnum-value (+)) 0)          ; the identity, not an error
  (assert-eq (fixnum-value (*)) 1)
  (assert-eq (fixnum-value (+ 1)) 1)
  (assert-eq (fixnum-value (+ 1 2 3 4)) 10)
  (assert-eq (fixnum-value (* 2 3 4)) 24)
  ; left fold: (- 10 1 2) is (10-1)-2 = 7. A right fold would give 11.
  (assert-eq (fixnum-value (- 10 1 2)) 7)
  ; one argument NEGATES rather than folding — (- 5) is -5, not 5
  (assert-eq (fixnum-value (- 5)) -5)
  (assert-eq (fixnum-value (- 0 7)) -7))

(deftest arithmetic-on-negatives
  ; the tag shift must be arithmetic all the way through the fold
  (assert-eq (fixnum-value (+ -1 -2)) -3)
  (assert-eq (fixnum-value (* -6 7)) -42)
  (assert-eq (fixnum-value (- -5 -3)) -2))

; ---- chained comparison ------------------------------------------------------
;; R5RS 6.2.5: the comparisons are variadic and mean the CONJUNCTION of adjacent
;; pairs. `(< 1 3 2)` is false even though `(< 1 3)` is true, which is the case a
;; naive fold gets wrong.
(deftest comparison-chains
  (assert (truthy? (< 1 2)))
  (assert (not (truthy? (< 2 1))))
  (assert (truthy? (< 1 2 3 4)))
  ; the middle pair fails, so the whole chain is false
  (assert (not (truthy? (< 1 3 2))))
  (assert (truthy? (> 3 2 1)))
  (assert (not (truthy? (> 3 1 2))))
  (assert (truthy? (= 4 4 4)))
  (assert (not (truthy? (= 4 4 5))))
  ; equal values are not LESS than each other — a `<=` bug hides here
  (assert (not (truthy? (< 1 1)))))

(deftest comparison-returns-scheme-booleans
  ; the result must be the #t/#f singletons, not a raw Coil bool or a fixnum
  (assert (val-eq? (< 1 2) (s-true)))
  (assert (val-eq? (< 2 1) (s-false)))
  ; and #f must be the ONLY false value: a false comparison is not nil
  (assert (not (val-eq? (< 2 1) (s-nil)))))

; ---- quote materializes runtime data ----------------------------------------
;; The heart of this chunk: a quoted form is a compile-time Code tree, and these
;; assertions are about the RUNTIME Vals it becomes.
(deftest quote-builds-pairs
  (let [l (quote-data (1 2 3))]
    (assert (pair? l))
    (assert-eq (fixnum-value (car l)) 1)
    (assert-eq (fixnum-value (car (cdr l))) 2)
    (assert-eq (fixnum-value (car (cdr (cdr l)))) 3)
    ; a proper list ENDS IN NIL — not in 0, and not in an unspecified value
    (assert (null? (cdr (cdr (cdr l)))))))

(deftest quote-of-empty-list-is-nil
  ; '() is the empty list, which is a singleton and NOT a pair
  (assert (null? (quote-data ())))
  (assert (not (pair? (quote-data ()))))
  ; and it is TRUE — R5RS 6.3.1, the rule a C programmer's Scheme breaks
  (assert (truthy? (quote-data ()))))

(deftest quote-interns-symbols
  ;; R5RS 6.3.3 guarantees two symbols with the same name are `eq?`. That holds
  ;; only because both sites intern, so this is the assertion that would catch a
  ;; `quote` which allocated a fresh symbol each time.
  (assert (val-eq? (quote-data abc) (quote-data abc)))
  (assert (not (val-eq? (quote-data abc) (quote-data abd))))
  (assert (symbol? (quote-data abc)))
  ; the same name reached through a quoted LIST is the same object again
  (assert (val-eq? (car (quote-data (abc))) (quote-data abc))))

(deftest quote-nests
  ; a quoted sublist is data too, all the way down
  (let [l (quote-data (a (b c) d))]
    (assert (symbol? (car l)))
    (assert (pair? (car (cdr l))))
    (assert (val-eq? (car (car (cdr l))) (quote-data b)))
    (assert (symbol? (car (cdr (cdr l)))))))

(deftest quote-of-literals
  ; inside a quote, the self-evaluating literals stay themselves
  (assert (val-eq? (quote-data #t) (s-true)))
  (assert (val-eq? (quote-data #f) (s-false)))
  (assert-eq (fixnum-value (quote-data 42)) 42)
  (assert-eq (fixnum-value (quote-data -7)) -7)
  (assert-eq (char-value (quote-data #\a)) 97)
  (assert-eq (char-value (quote-data #\space)) 32)
  (assert-eq (char-value (quote-data #\newline)) 10))

; ---- list --------------------------------------------------------------------
(deftest list-builds-a-proper-list
  (assert (null? (list)))                    ; (list) is '()
  (let [l (list 1 2 3)]
    (assert (pair? l))
    (assert-eq (fixnum-value (car l)) 1)
    (assert (null? (cdr (cdr (cdr l))))))
  ; unlike quote, `list` EVALUATES its arguments
  (let [l (list (+ 1 1) (* 2 3))]
    (assert-eq (fixnum-value (car l)) 2)
    (assert-eq (fixnum-value (car (cdr l))) 6)))

; ---- literal lifting ---------------------------------------------------------
;; `lift` is what turns a bare Coil i64 into a Scheme number. Without it a
;; literal keeps the low tag bits of a raw integer and every predicate lies.
(deftest literals-lift-to-vals
  (assert (fixnum? (+ 1 0)))
  (assert (fixnum? (quote-data 5)))
  ; 42 as a raw i64 is NOT a fixnum — the tag is what makes it one, and this is
  ; the assertion that documents why lifting has to happen at all
  (assert (not (fixnum? 42)))
  (assert (fixnum? (mk-fixnum 42))))

; ---- #f is the only false value ---------------------------------------------
;; R5RS 6.3.1. Everything routes through `truthy?`, so this is the test that
;; keeps a future `if` from treating 0 or '() as false.
(deftest only-false-is-false
  (assert (truthy? (mk-fixnum 0)))
  (assert (truthy? (s-nil)))
  (assert (truthy? (s-true)))
  (assert (not (truthy? (s-false))))
  ; a comparison that fails yields exactly #f, so it is the only falsy result
  (assert (not (truthy? (= 1 2)))))
