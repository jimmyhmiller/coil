(module coil.scheme.lint)
(import "coil.primitive" :as primitive)
(import "coil.str" :use *)

;; A checker that refuses `scm-` in Scheme source.
;;
;; The premise of this dialect is that you write REAL Scheme — `car`, `append`,
;; `string-length`, `+` — not a lookalike. An implementation detail leaking into
;; the surface is not a cosmetic problem: the moment `(scm-append a b)` works, the
;; language being written is no longer Scheme, and every program, benchmark and
;; conformance result built on it is measuring something else.
;;
;; That happened here. `scm-` names reached the conformance cases and the
;; benchmarks before anyone noticed, and the numbers looked fine because the
;; VALUES were right — it was only the surface that was wrong, which is precisely
;; the kind of error that survives testing. Hence a checker rather than a
;; convention: a rule nothing enforces is a rule that erodes.
;;
;; The implementation may name its internals whatever it likes. `coil.scheme`
;; renames them to their R5RS spellings at the import boundary, and a rename
;; REPLACES — so the `scm-` spelling is not merely discouraged, it is undefined in
;; a module that imports the dialect. This checker exists for the case that slips
;; past that: a module reaching around the umbrella into an implementation module
;; directly.

;; Does this identifier wear an implementation prefix that must never appear in
;; Scheme source?
(defn lint--internal-name? [(s (slice u8))] (-> bool)
  (or (starts-with s "scm-") (str-eq s "fnptr-of")))

;; ⚠ ONLY THE AUTHOR'S OWN SYMBOLS. A `before-expand` transform is re-run on its
;; own output until that output stops changing, so on the second round this check
;; sees the FIRST round's result — which legitimately contains `scm-let`,
;; `scm-set!` and the rest, because emitting them is what the passes are for.
;;
;; Without a provenance test the checker therefore rejected the very syntax it
;; exists to protect: `(let ((a 1) (b 2)) (+ a b))` — ordinary R5RS — failed with
;;
;;     error: this is not Scheme: `scm-` is an implementation spelling …
;;      --> src/apps/scheme/forms.coil:443:21
;;
;; pointing at the pass's own source line rather than at anything the author
;; wrote. Scheme `let` was unusable, which is a large hole for a Scheme.
;;
;; ⚠ `code-from-user?` IS THE WRONG PREDICATE HERE, and it is worth saying why,
;; because the name invites the mistake. It answers "is this node from a real
;; file rather than the bundled stdlib" — and `src/apps/scheme/forms.coil` IS a
;; real file in this repo, so it says true for every node the passes manufacture.
;; It distinguishes repo-vs-bundled, not author-vs-macro.
;;
;; The question this check actually needs is "which FILE did this symbol come
;; from". A symbol emitted by the dialect's own implementation carries that
;; implementation's path, and no user Scheme ever does.
(defn lint--impl-file? [(s (slice u8))] (-> bool)
  (match (str-find s "src/apps/scheme/")
    (Some [_] true)
    (None [] false)))

(defn lint--user-sym? [(e Code)] (-> bool)
  (and (primitive/code-sym? e)
       (not (lint--impl-file? (primitive/code-file e)))))

(defn lint--walk [(e Code)] (-> i64)
  (if (lint--user-sym? e)
      (do
        (when (lint--internal-name? (primitive/code-str e))
          (primitive/report e
            "this is not Scheme: that identifier is an implementation spelling, not a standard procedure — write the R5RS surface name")
          0)
        0)
    (if (primitive/code-list? e)
        (lint--walk-all e 0 (primitive/code-count e))
      0)))

(defn lint--walk-all [(e Code) (i i64) (n i64)] (-> i64)
  (if (primitive/icmp-ge i n) 0
    (do (lint--walk (primitive/code-nth e i))
        (lint--walk-all e (primitive/iadd i 1) n))))

;; Only modules that opted into the dialect are Scheme source. The dialect's own
;; runtime is ordinary Coil and is where these names legitimately live.
(defn lint--imports-scheme? [(m Code) (i i64) (n i64)] (-> bool)
  (if (primitive/icmp-ge i n) false
    (let [f (primitive/code-nth m i)]
      (if (and (primitive/code-list? f)
               (and (primitive/icmp-ge (primitive/code-count f) 2)
                    (and (primitive/code-eq (primitive/code-nth f 0) `import)
                         (str-eq (primitive/code-str (primitive/code-nth f 1))
                                 "coil.scheme"))))
          true
        (lint--imports-scheme? m (primitive/iadd i 1) n)))))

(defn lint--scheme-module? [(m Code)] (-> bool)
  (and (primitive/icmp-gt (primitive/code-count m) 1)
       (and (not (starts-with (primitive/code-str (primitive/code-nth m 0))
                              "coil.scheme"))
            (lint--imports-scheme? m 1 (primitive/code-count m)))))

(defn lint--mods [(ms Code) (i i64) (n i64)] (-> i64)
  (if (primitive/icmp-ge i n) 0
    (do
      (let [m (primitive/code-nth ms i)]
        (if (lint--scheme-module? m)
            (lint--walk-all m 1 (primitive/code-count m))
          0))
      (lint--mods ms (primitive/iadd i 1) n))))

(defn no-implementation-names [(prog Code)] (-> Code)
  (lint--mods prog 0 (primitive/code-count prog))
  prog)

;; ⚠ NOT registered here. A `(checker …)` registration does not propagate through
;; an import, the same way a `(transform …)` does not — so registering it in this
;; module would mean it never runs for the programs it is meant to police.
;; `coil.scheme.dialect` owns the single registration and calls this pass, which
;; is also the right order: the check runs on the author's surface syntax, before
;; any macro has had a chance to introduce an `scm-` name legitimately.
(defn lint-scheme-source [(prog Code)] (-> i64)
  (lint--mods prog 0 (primitive/code-count prog)))
