          (str-eq n "transcript-off") (port/transcript-off)
          (str-eq n "load") (scm-load-args args)
          (str-eq n "eval")
            (if (and (not (is-null args))
                     (and (not (is-null (cdr args)))
                          (is-null (cdr (cdr args)))))
                (eval (car args) (stdproc/scm-cadr args))
                (s-unspecified))
          (str-eq n "scheme-report-environment") (scheme-report-environment (car args))
          (str-eq n "null-environment") (null-environment (car args))
          (str-eq n "interaction-environment") (interaction-environment)
          (str-eq n "force") (derived2/force (car args))
          (cxr-name? n) (eval-cxr n (car args))
          :else (s-unspecified))))

(defn eval [(expression i64) (environment i64)] (-> i64)
  (if (is-environment environment) (runtime-eval expression environment) (s-unspecified)))

(export eval
        scheme-report-environment
        null-environment
        interaction-environment
        scm-load
        scm-load-args
        environment?
        is-environment
        runtime-eval
        continuation-eval)
