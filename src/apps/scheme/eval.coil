(module coil.scheme.eval)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.str" :use *)
(import "coil.slice" :use [slice-len])
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.symbol" :use *)
(import "coil.scheme.bignum" :use *)
(import "coil.scheme.core" :use *)
(import "coil.scheme.numeric" :as numeric)
(import "coil.scheme.stdproc" :as stdproc)
(import "coil.scheme.closure" :use [make-closure closure-code closure-env])
(import "coil.scheme.continuation" :use *)
(import "coil.scheme.lambda" :use [closure-fnptr1->i64])
(import "coil.scheme.port" :as port)
(import "coil.scheme.derived2" :as derived2)

;; Runtime environments use the representation reserved in value.coil:
;;   a = kind (0 null, 1 report, 2 interaction)
;;   b = association list of (symbol . mutable-cell)
;;   c = parent environment or nil.
(defn is-environment [(v i64)] (-> bool)
  (has-tag? v (tag-environment)))
(defn environment? [(v i64)] (-> i64)
  (mk-bool (is-environment v)))
(defn env-kind [(e i64)] (-> i64)
  (fixnum-value (primitive/load (primitive/field (obj-of e) a))))
(defn env-bindings [(e i64)] (-> i64)
  (primitive/load (primitive/field (obj-of e) b)))
(defn env-parent [(e i64)] (-> i64)
  (primitive/load (primitive/field (obj-of e) c)))
(defn env-set-bindings! [(e i64) (v i64)] (-> i64)
  (primitive/store! (primitive/field (obj-of e) b) v)
  0)
(defn make-environment [(kind i64) (parent i64)] (-> i64)
  (allocate (tag-environment) (mk-fixnum kind) (s-nil) parent))

(defn report-version? [(v i64)] (-> bool)
  (and (is-fixnum v) (= (fixnum-value v) 5)))
(defn scheme-report-environment [(version i64)] (-> i64)
  (if (report-version? version) (make-environment 1 (s-nil)) (s-unspecified)))
(defn null-environment [(version i64)] (-> i64)
  (if (report-version? version) (make-environment 0 (s-nil)) (s-unspecified)))
(defn interaction-root [] (-> (ptr i64))
  (alloc/static i64))
(defn cek-root-cell-a [] (-> (ptr i64))
  (alloc/static i64))
(defn cek-root-cell-b [] (-> (ptr i64))
  (alloc/static i64))
(defn cek-shadow-base [] (-> (ptr i64))
  (alloc/static i64))
(defn cek-root-record [(cell (ptr i64))] (-> i64)
  (let [old (primitive/load cell)]
    (if (= old 0)
        (let [record (allocate (tag-environment) (s-nil) (s-nil) (s-nil))]
          (primitive/store! cell record)
          (gc-root-permanent record)
          record)
        old)))
(defn cek-roots6! [(x0 i64) (x1 i64) (x2 i64) (x3 i64) (x4 i64) (x5 i64)] (-> i64)
  (let [ra (cek-root-record (cek-root-cell-a))
        rb (cek-root-record (cek-root-cell-b))]
    (primitive/store! (primitive/field (obj-of ra) a) x0)
    (primitive/store! (primitive/field (obj-of ra) b) x1)
    (primitive/store! (primitive/field (obj-of ra) c) x2)
    (primitive/store! (primitive/field (obj-of rb) a) x3)
    (primitive/store! (primitive/field (obj-of rb) b) x4)
    (primitive/store! (primitive/field (obj-of rb) c) x5)
    ;; A machine transition abandons its caller's logical evaluation context.
    ;; The permanent records above now own every live value, so rooted-return
    ;; slots left by ordinary runtime helpers must not accumulate indefinitely.
    (gc-sp-set! (primitive/load (cek-shadow-base)))
    0))
(defn cek-clear-roots! [] (-> i64)
  (cek-roots6! (s-nil) (s-nil) (s-nil) (s-nil) (s-nil) (s-nil)))
(defn interaction-environment [] (-> i64)
  (let [old (primitive/load (interaction-root))]
    (if (= old 0)
        (let [e (make-environment 2 (s-nil))]
          (primitive/store! (interaction-root) e)
          (gc-root e)
          e)
      old)))

;; Evaluate every datum in a file in one shared environment. The interaction
;; environment is persistent, so definitions introduced by the one-argument
;; R5RS form remain visible to later `eval` and `load` calls.
(defn scm-load-port [(p i64) (env i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root p)
    (gc-root env)
    (let [form (port/scm-read p)]
      (gc-root form)
      (if (val-eq? form (s-eof))
          (do (gc-sp-set! sp) (s-unspecified))
          (do
            (runtime-eval form env)
            (gc-sp-set! sp)
            (scm-load-port p env))))))
(defn scm-load [(path i64) (env i64)] (-> i64)
  (if (not (is-environment env))
      (s-unspecified)
    (let [sp (gc-sp)]
        (gc-root path)
        (gc-root env)
      (let [p (port/open-input-file path)]
        (gc-root p)
        (let [result (scm-load-port p env)]
          (port/close-input-port p)
          (gc-sp-set! sp)
          result)))))
(defn scm-load-args [(args i64)] (-> i64)
  (if (is-null args)
      (s-unspecified)
    (let [rest (cdr args)]
        (if (is-null rest)
            (scm-load (car args) (interaction-environment))
            (if (is-null (cdr rest))
                (scm-load (car args) (car rest))
          (s-unspecified))))))

(defn name=? [(s i64) (name (slice u8))] (-> bool)
  (and (is-symbol s) (str-eq (symbol-name s) name)))
(defn binding-cell [(name i64) (bs i64)] (-> i64)
  (if (is-null bs)
      (s-false)
    (let [entry (car bs)]
        (if (val-eq? (car entry) name)
            (cdr entry)
        (binding-cell name (cdr bs))))))
(defn env-cell [(name i64) (env i64)] (-> i64)
  (let [cell (binding-cell name (env-bindings env))]
    (if (not (val-eq? cell (s-false)))
        cell
      (let [parent (env-parent env)]
        (if (is-environment parent) (env-cell name parent) (s-false))))))
(defn env-define! [(env i64) (name i64) (value i64)] (-> i64)
  (let [cell (binding-cell name (env-bindings env))]
    (if (val-eq? cell (s-false))
        (env-set-bindings! env (cons (cons name (cons value (s-nil))) (env-bindings env)))
      (set-car! cell value))
    value))
(defn env-set! [(env i64) (name i64) (value i64)] (-> i64)
  (let [cell (env-cell name env)]
    (if (val-eq? cell (s-false))
        (s-unspecified)
      (do (set-car! cell value) value))))

(defn primitive-name-old? [(s i64)] (-> bool)
  (if (not (is-symbol s))
      false
    (let [n (symbol-name s)]
        (or (str-eq n "+")
            (or (str-eq n "-")
                (or (str-eq n "*")
                    (or (str-eq n "/")
                        (or (str-eq n "<")
                            (or (str-eq n ">")
                                (or (str-eq n "<=")
                                    (or (str-eq n ">=")
                                        (or (str-eq n "=")
                                            (or (str-eq n "cons")
                                                (or (str-eq n "car")
                                                    (or (str-eq n "cdr")
                                                        (or (str-eq n "list")
                                                            (or (str-eq n "null?")
                                                                (or (str-eq n "pair?")
                                                                    (or (str-eq n "number?")
                                                                        (or (str-eq n "symbol?")
                                                                            (or (str-eq n "boolean?")
                                                                                (or (str-eq n "procedure?")
                                                                                    (or (str-eq n "eq?")
                                                                                        (or (str-eq n "eqv?")
                                                                                            (or (str-eq n "equal?")
                                                                                                (or (str-eq n "not")
                                                                                                    (or (str-eq n
                                                                                                                "display")
                                                                                                        (or (str-eq n
                                                                                                                    "write")
                                                                                                            (or (str-eq n
                                                                                                                        "newline")
                                                                                                                (or (str-eq n
                                                                                                                            "apply")
                                                                                                                    (str-eq n
                                                                                                                            "values")))))))))))))))))))))))))))))))

(defn primitive-name? [(s i64)] (-> bool)
  (if (not (is-symbol s))
      false
    (let [n (symbol-name s)]
        (cond (str-eq n "+") true
              (str-eq n "-") true
              (str-eq n "*") true
              (str-eq n "/") true
              (str-eq n "<") true
              (str-eq n ">") true
              (str-eq n "<=") true
              (str-eq n ">=") true
              (str-eq n "=") true
              (str-eq n "cons") true
              (str-eq n "car") true
              (str-eq n "cdr") true
              (str-eq n "list") true
              (str-eq n "null?") true
              (str-eq n "pair?") true
              (str-eq n "number?") true
              (str-eq n "symbol?") true
              (str-eq n "boolean?") true
              (str-eq n "procedure?") true
              (str-eq n "eq?") true
              (str-eq n "eqv?") true
              (str-eq n "equal?") true
              (str-eq n "not") true
              (str-eq n "display") true
              (str-eq n "write") true
              (str-eq n "newline") true
              (str-eq n "apply") true
              (str-eq n "values") true
            :else (standard-primitive-name? n)))))

(defn cxr-middle? [(n (slice u8)) (i i64) (last i64)] (-> bool)
  (if (>= i last)
      true
    (let [c (primitive/cast i64 (char-at n i))]
      (and (or (= c 97) (= c 100)) (cxr-middle? n (+ i 1) last)))))
(defn cxr-name? [(n (slice u8))] (-> bool)
  (let [len (slice-len n)]
    (and (and (>= len 4) (<= len 6))
         (and (= (primitive/cast i64 (char-at n 0)) 99)
              (and (= (primitive/cast i64 (char-at n (- len 1))) 114)
                   (cxr-middle? n 1 (- len 1)))))))
(defn eval-cxr-at [(n (slice u8)) (i i64) (v i64)] (-> i64)
  (if (= i 0)
      v
      (eval-cxr-at n
                   (- i 1)
      (if (= (primitive/cast i64 (char-at n i)) 97) (car v) (cdr v)))))
(defn eval-cxr [(n (slice u8)) (v i64)] (-> i64)
  (eval-cxr-at n (- (slice-len n) 2) v))

(defn standard-primitive-name? [(n (slice u8))] (-> bool)
  (cond (str-eq n "set-car!") true
        (str-eq n "set-cdr!") true
        (str-eq n "list?") true
        (str-eq n "length") true
        (str-eq n "reverse") true
        (str-eq n "append") true
        (str-eq n "list-tail") true
        (str-eq n "list-ref") true
        (str-eq n "memq") true
        (str-eq n "memv") true
        (str-eq n "member") true
        (str-eq n "assq") true
        (str-eq n "assv") true
        (str-eq n "assoc") true
        (str-eq n "map") true
        (str-eq n "for-each") true
        (str-eq n "call-with-values") true
        (str-eq n "string?") true
        (str-eq n "string") true
        (str-eq n "make-string") true
        (str-eq n "string-length") true
        (str-eq n "string-ref") true
        (str-eq n "string-set!") true
        (str-eq n "substring") true
        (str-eq n "string-append") true
        (str-eq n "string->list") true
        (str-eq n "list->string") true
        (str-eq n "string-copy") true
        (str-eq n "string-fill!") true
        (str-eq n "string->symbol") true
        (str-eq n "symbol->string") true
        (str-eq n "string=?") true
        (str-eq n "string<?") true
        (str-eq n "string>?") true
        (str-eq n "string<=?") true
        (str-eq n "string>=?") true
        (str-eq n "string-ci=?") true
        (str-eq n "string-ci<?") true
        (str-eq n "string-ci>?") true
        (str-eq n "string-ci<=?") true
        (str-eq n "string-ci>=?") true
        (str-eq n "vector?") true
        (str-eq n "vector") true
        (str-eq n "make-vector") true
        (str-eq n "vector-length") true
        (str-eq n "vector-ref") true
        (str-eq n "vector-set!") true
        (str-eq n "vector->list") true
        (str-eq n "list->vector") true
        (str-eq n "vector-fill!") true
        (str-eq n "char?") true
        (str-eq n "char->integer") true
        (str-eq n "integer->char") true
        (str-eq n "char-upcase") true
        (str-eq n "char-downcase") true
        (str-eq n "char-alphabetic?") true
        (str-eq n "char-numeric?") true
        (str-eq n "char-whitespace?") true
        (str-eq n "char-upper-case?") true
        (str-eq n "char-lower-case?") true
        (str-eq n "char=?") true
        (str-eq n "char<?") true
        (str-eq n "char>?") true
        (str-eq n "char<=?") true
        (str-eq n "char>=?") true
        (str-eq n "char-ci=?") true
        (str-eq n "char-ci<?") true
        (str-eq n "char-ci>?") true
        (str-eq n "char-ci<=?") true
        (str-eq n "char-ci>=?") true
        (str-eq n "integer?") true
        (str-eq n "exact?") true
        (str-eq n "complex?") true
        (str-eq n "real?") true
        (str-eq n "rational?") true
        (str-eq n "numerator") true
        (str-eq n "denominator") true
        (str-eq n "magnitude") true
        (str-eq n "angle") true
        (str-eq n "make-rectangular") true
        (str-eq n "make-polar") true
        (str-eq n "real-part") true
        (str-eq n "imag-part") true
        (str-eq n "inexact?") true
        (str-eq n "zero?") true
        (str-eq n "positive?") true
        (str-eq n "negative?") true
        (str-eq n "odd?") true
        (str-eq n "even?") true
        (str-eq n "max") true
        (str-eq n "min") true
        (str-eq n "abs") true
        (str-eq n "quotient") true
        (str-eq n "rationalize") true
        (str-eq n "remainder") true
        (str-eq n "modulo") true
        (str-eq n "gcd") true
        (str-eq n "lcm") true
        (str-eq n "floor") true
        (str-eq n "ceiling") true
        (str-eq n "truncate") true
        (str-eq n "round") true
        (str-eq n "exp") true
        (str-eq n "log") true
        (str-eq n "sin") true
        (str-eq n "cos") true
        (str-eq n "tan") true
        (str-eq n "asin") true
        (str-eq n "acos") true
        (str-eq n "atan") true
        (str-eq n "sqrt") true
        (str-eq n "expt") true
        (str-eq n "exact->inexact") true
        (str-eq n "inexact->exact") true
        (str-eq n "number->string") true
        (str-eq n "string->number") true
        (str-eq n "read") true
        (str-eq n "read-char") true
        (str-eq n "peek-char") true
        (str-eq n "char-ready?") true
        (str-eq n "write-char") true
        (str-eq n "current-input-port") true
        (str-eq n "current-output-port") true
        (str-eq n "input-port?") true
        (str-eq n "output-port?") true
        (str-eq n "eof-object?") true
        (str-eq n "open-input-file") true
        (str-eq n "open-output-file") true
        (str-eq n "close-input-port") true
        (str-eq n "close-output-port") true
        (str-eq n "call-with-input-file") true
        (str-eq n "call-with-output-file") true
        (str-eq n "with-input-from-file") true
        (str-eq n "with-output-to-file") true
        (str-eq n "transcript-on") true
        (str-eq n "transcript-off") true
        (str-eq n "load") true
        (str-eq n "eval") true
        (str-eq n "scheme-report-environment") true
        (str-eq n "null-environment") true
        (str-eq n "interaction-environment") true
        (str-eq n "force") true
        (str-eq n "call-with-current-continuation") true
        (str-eq n "call/cc") true
        (str-eq n "dynamic-wind") true
        :else (cxr-name? n)))

(defn env-allows-primitives? [(env i64)] (-> bool)
  (if (> (env-kind env) 0)
      true
    (let [parent (env-parent env)]
      (and (is-environment parent) (env-allows-primitives? parent)))))

(defn eval-primitive-entry [(captured i64) (args i64)] (-> i64)
  (eval-primitive (car captured) args))
(defn make-eval-primitive [(name i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root name)
    (let [captured (cons name (s-nil))]
      (gc-root captured)
      (let [p
              (make-closure (closure-fnptr1->i64 (primitive/fnptr-of eval-primitive-entry))
                            captured
                            -2)]
        (gc-sp-set! sp)
        (gc-root p)
        p))))
(defn env-lookup [(env i64) (name i64)] (-> i64)
  (let [cell (env-cell name env)]
    (if (not (val-eq? cell (s-false)))
        (car cell)
      (if (and (env-allows-primitives? env) (primitive-name? name))
          ;; A report procedure denotes one stable procedure object within an
          ;; environment. Re-wrapping every lookup made `(eqv? car car)` false
          ;; and allocated on every primitive reference.
          (let [p (make-eval-primitive name)]
            (env-define! env name p)
            p)
        (s-unspecified)))))

(defn eval-list [(xs i64) (env i64)] (-> i64)
  (if (is-null xs)
      (s-nil)
    (let [sp (gc-sp)]
        (gc-root xs)
        (gc-root env)
      (let [head (runtime-eval (car xs) env)]
        (gc-root head)
        (let [tail (eval-list (cdr xs) env)]
          (gc-root tail)
          (let [out (cons head tail)] (gc-sp-set! sp) (gc-root out) out))))))
(defn eval-sequence [(body i64) (env i64)] (-> i64)
  (if (is-null body)
      (s-unspecified)
      (if (is-null (cdr body))
          (runtime-eval (car body) env)
      (do (runtime-eval (car body) env) (eval-sequence (cdr body) env)))))

(defn bind-formals! [(params i64) (args i64) (env i64)] (-> i64)
  (if (is-symbol params)
      (env-define! env params args)
    (if (is-null params)
        (if (is-null args) env (s-unspecified))
          (if (or (is-null args) (not (is-pair params)))
              (s-unspecified)
              (do
                (env-define! env (car params) (car args))
            (bind-formals! (cdr params) (cdr args) env))))))
(defn eval-closure-entry [(captured i64) (args i64)] (-> i64)
  (let [params (car captured)
        body (car (cdr captured))
        parent (car (cdr (cdr captured)))
        child (make-environment 0 parent)]
    (bind-formals! params args child)
    (eval-sequence body child)))
(defn make-eval-closure [(params i64) (body i64) (env i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root params)
    (gc-root body)
    (gc-root env)
    (let [captured (cons params (cons body (cons env (s-nil))))]
      (gc-root captured)
      (let [p
              (make-closure (closure-fnptr1->i64 (primitive/fnptr-of eval-closure-entry))
                            captured
                            -2)]
        (gc-sp-set! sp)
        (gc-root p)
        p))))
(defn cek-make-eval-closure [(params i64) (body i64) (env i64)] (-> i64)
  (let [sp (gc-sp)
        p (make-eval-closure params body env)]
    (gc-sp-set! sp)
    p))

;; Portable continuation kernel. Pending Scheme work is an immutable traced
;; frame chain, never a native return address. These mutually recursive entries
;; only call one another in tail position; captured chains therefore have
;; unlimited, multi-shot heap extent without penalizing compiled Scheme that
;; does not opt into this evaluator.
(defn cek-list2 [(a i64) (b i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root a)
    (gc-root b)
    (let [tail (cons b (s-nil))]
      (gc-root tail)
      (let [out (cons a tail)] (gc-sp-set! sp) out))))
(defn cek-list3 [(a i64) (b i64) (c i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root a)
    (gc-root b)
    (gc-root c)
    (let [tail (cek-list2 b c)]
      (gc-root tail)
      (let [out (cons a tail)] (gc-sp-set! sp) out))))
(defn cek-list4 [(a i64) (b i64) (c i64) (d i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root a)
    (gc-root b)
    (gc-root c)
    (gc-root d)
    (let [tail (cek-list3 b c d)]
      (gc-root tail)
      (let [out (cons a tail)] (gc-sp-set! sp) out))))

;; Standard runtime list helpers return a rooted result for generated callers.
;; The explicit machine owns its roots separately, so these variants restore
;; their temporary shadow slots without leaking one slot per transition.
(defn cek-reverse-acc [(l i64) (acc i64)] (-> i64)
  (if (is-null l)
      acc
      (let [sp (gc-sp)]
        (gc-root l)
        (gc-root acc)
        (let [next (cons (car l) acc)]
          (gc-root next)
          (let [out (cek-reverse-acc (cdr l) next)]
            (gc-sp-set! sp)
            out)))))
(defn cek-reverse [(l i64)] (-> i64)
  (cek-reverse-acc l (s-nil)))
(defn cek-append [(a i64) (b i64)] (-> i64)
  (if (is-null a)
      b
      (let [sp (gc-sp)]
        (gc-root a)
        (gc-root b)
        (let [tail (cek-append (cdr a) b)]
          (gc-root tail)
          (let [out (cons (car a) tail)]
            (gc-sp-set! sp)
            out)))))

;; Runtime `eval` receives datums after compilation, so unlike a source file it
;; has not passed through the dialect's derived-form normalizer. Lower the
;; binding forms to the same lambda/set! core consumed by the machine; doing
;; this here keeps captures in initializers and bodies inside the caller's CEK
;; continuation instead of falling back to the native tree walker.
(defn cek-binding-expressions [(bindings i64)] (-> i64)
  (if (is-null bindings)
      (s-nil)
      (cons (stdproc/scm-cadr (car bindings))
            (cek-binding-expressions (cdr bindings)))))

(defn cek-lambda-datum [(params i64) (body i64)] (-> i64)
  (cons (intern "lambda") (cons params body)))

(defn cek-application-datum [(operator i64) (operands i64)] (-> i64)
  (cons operator operands))

(defn cek-let-datum [(bindings i64) (body i64)] (-> i64)
  (cek-application-datum (cek-lambda-datum (binding-names bindings) body)
                         (cek-binding-expressions bindings)))

(defn cek-let-star-datum [(bindings i64) (body i64)] (-> i64)
  (if (is-null bindings)
      ;; Even an empty let* establishes a fresh internal-definition region.
      (cek-let-datum (s-nil) body)
      (cek-let-datum (cons (car bindings) (s-nil))
                     (cons (cek-let-star-datum (cdr bindings) body) (s-nil)))))

(defn cek-letrec-holes [(bindings i64)] (-> i64)
  (if (is-null bindings)
      (s-nil)
      (cons (cons (intern "s-undefined") (s-nil))
            (cek-letrec-holes (cdr bindings)))))

(defn cek-letrec-sets [(bindings i64)] (-> i64)
  (if (is-null bindings)
      (s-nil)
      (let [binding (car bindings)]
        (cons (cek-list3 (intern "set!") (car binding) (stdproc/scm-cadr binding))
              (cek-letrec-sets (cdr bindings))))))

(defn cek-letrec-datum [(bindings i64) (body i64)] (-> i64)
  (cek-application-datum (cek-lambda-datum (binding-names bindings)
                                           (cek-append (cek-letrec-sets bindings) body))
                         (cek-letrec-holes bindings)))

(defn cek-named-let-datum [(name i64) (bindings i64) (body i64)] (-> i64)
  (let [procedure (cek-lambda-datum (binding-names bindings) body)
        recursive-binding (cons name (cons procedure (s-nil)))
        initial-call (cek-application-datum name (cek-binding-expressions bindings))]
    (cek-letrec-datum (cons recursive-binding (s-nil))
                      (cons initial-call (s-nil)))))

(defn cek-begin-datum [(body i64)] (-> i64)
  (cons (intern "begin") body))

(defn cek-if-datum [(test i64) (yes i64) (no i64)] (-> i64)
  (cons (intern "if") (cek-list3 test yes no)))

(defn cek-cond-datum [(clauses i64)] (-> i64)
  (if (is-null clauses)
      (cek-begin-datum (s-nil))
      (let [clause (car clauses)
            test (car clause)
            body (cdr clause)]
        (if (name=? test "else")
            (cek-begin-datum body)
            (let [rest (cek-cond-datum (cdr clauses))
                  temp (fresh-symbol-like (intern "condition-value"))]
              (if (is-null body)
                  (cek-application-datum (cek-lambda-datum (cons temp (s-nil))
                                                           (cons (cek-if-datum temp temp rest) (s-nil)))
                                         (cons test (s-nil)))
                  (if (name=? (car body) "=>")
                      (let [recipient (stdproc/scm-cadr body)]
                        (cek-application-datum (cek-lambda-datum (cons temp (s-nil))
                                                                 (cons (cek-if-datum temp
                                                                                     (cek-application-datum recipient
                                                                                                            (cons temp
                                                                                                                  (s-nil)))
                                                                                     rest)
                                                                       (s-nil)))
                                               (cons test (s-nil))))
                      (cek-if-datum test (cek-begin-datum body) rest))))))))

(defn cek-case-clauses-datum [(key i64) (clauses i64)] (-> i64)
  (if (is-null clauses)
      (cek-begin-datum (s-nil))
      (let [clause (car clauses)
            datums (car clause)
            body (cdr clause)]
        (if (name=? datums "else")
            (cek-begin-datum body)
            (let [quoted (cons (intern "quote") (cons datums (s-nil)))
                  member (cek-application-datum (intern "memv") (cek-list2 key quoted))]
              (cek-if-datum member
                            (cek-begin-datum body)
                            (cek-case-clauses-datum key (cdr clauses))))))))

(defn cek-case-datum [(key-expression i64) (clauses i64)] (-> i64)
  (let [key (fresh-symbol-like (intern "case-key"))]
    (cek-application-datum (cek-lambda-datum (cons key (s-nil))
                                             (cons (cek-case-clauses-datum key clauses) (s-nil)))
                           (cons key-expression (s-nil)))))

(defn cek-do-steps [(specs i64)] (-> i64)
  (if (is-null specs)
      (s-nil)
      (let [spec (car specs)]
        (cons (if (is-null (cdr (cdr spec))) (car spec) (stdproc/scm-caddr spec))
              (cek-do-steps (cdr specs))))))

(defn cek-do-datum [(specs i64) (test-clause i64) (commands i64)] (-> i64)
  (let [loop-name (fresh-symbol-like (intern "do-loop"))
        names (binding-names specs)
        test (car test-clause)
        results (cdr test-clause)
        done (cek-begin-datum results)
        again (cek-application-datum loop-name (cek-do-steps specs))
        body (cek-begin-datum (cek-append commands (cons again (s-nil))))
        loop-procedure
          (cek-lambda-datum names
                            (cons (cek-if-datum test done body) (s-nil)))
        recursive-binding (cons loop-name (cons loop-procedure (s-nil)))]
    (cek-letrec-datum (cons recursive-binding (s-nil))
                      (cons (cek-application-datum loop-name (cek-binding-expressions specs)) (s-nil)))))

(defn cek-quote-datum [(datum i64)] (-> i64)
  (cons (intern "quote") (cons datum (s-nil))))

(defn cek-qq-wrap-datum [(marker i64) (value-expression i64)] (-> i64)
  (cek-application-datum (intern "cons")
                         (cek-list2 (cek-quote-datum marker)
                                    (cek-application-datum (intern "cons")
                                                           (cek-list2 value-expression (cek-quote-datum (s-nil)))))))

(defn cek-quasiquote-list-datum [(datum i64) (env i64) (level i64)] (-> i64)
  (if (is-null datum)
      (cek-quote-datum (s-nil))
      (if (not (is-pair datum))
          (cek-quasiquote-datum datum env level)
          ;; A dotted `.<space>,tail` is represented by the pair `(unquote tail)`
          ;; itself, not by a list element containing that form.
          (if (and (= level 1) (name=? (car datum) "unquote"))
              (cek-quasiquote-datum datum env level)
              (let [item (car datum)]
                (if (and (= level 1)
                         (and (is-pair item) (name=? (car item) "unquote-splicing")))
                    (cek-application-datum (intern "append")
                                           (cek-list2 (stdproc/scm-cadr item)
                                                      (cek-quasiquote-list-datum (cdr datum) env level)))
                    (cek-application-datum (intern "cons")
                                           (cek-list2 (cek-quasiquote-datum item env level)
                                                      (cek-quasiquote-list-datum (cdr datum) env level)))))))))

(defn cek-quasiquote-datum [(datum i64) (env i64) (level i64)] (-> i64)
  (if (is-vector datum)
      (cek-application-datum (intern "list->vector")
                             (cons (cek-quasiquote-list-datum (stdproc/scm-vector->list datum) env level)
                                   (s-nil)))
      (if (not (is-pair datum))
          (cek-quote-datum datum)
          (let [head (car datum)]
            (if (name=? head "quasiquote")
                (cek-qq-wrap-datum head
                                   (cek-quasiquote-datum (stdproc/scm-cadr datum) env (+ level 1)))
                (if (name=? head "unquote")
                    (if (= level 1)
                        (stdproc/scm-cadr datum)
                        (cek-qq-wrap-datum head
                                           (cek-quasiquote-datum (stdproc/scm-cadr datum) env (- level 1))))
                    (if (name=? head "unquote-splicing")
                        (if (= level 1)
                            (cek-begin-datum (s-nil))
                            (cek-qq-wrap-datum head
                                               (cek-quasiquote-datum (stdproc/scm-cadr datum) env (- level 1))))
                        (cek-quasiquote-list-datum datum env level))))))))

(defn eval-closure-procedure? [(p i64)] (-> bool)
  (and (is-closure p)
       (= (closure-code p)
          (closure-fnptr1->i64 (primitive/fnptr-of eval-closure-entry)))))

(defn eval-primitive-procedure? [(p i64)] (-> bool)
  (and (is-closure p)
       (= (closure-code p)
          (closure-fnptr1->i64 (primitive/fnptr-of eval-primitive-entry)))))

(defn cek-any-null-list? [(lists i64)] (-> bool)
  (if (is-null lists)
      false
      (or (is-null (car lists)) (cek-any-null-list? (cdr lists)))))

(defn cek-list-cars [(lists i64)] (-> i64)
  (if (is-null lists)
      (s-nil)
      (cons (car (car lists)) (cek-list-cars (cdr lists)))))

(defn cek-list-cdrs [(lists i64)] (-> i64)
  (if (is-null lists)
      (s-nil)
      (cons (cdr (car lists)) (cek-list-cdrs (cdr lists)))))

(defn cek-for-each-n [(p i64) (lists i64) (k i64)] (-> i64)
  (if (or (is-null lists) (cek-any-null-list? lists))
      (cek-continue (s-unspecified) k)
      (cek-apply p
                 (cek-list-cars lists)
                 (make-continuation-frame (continuation-for-each-kind)
                                          (cek-list2 p (cek-list-cdrs lists))
                                          k))))

(defn cek-map-n [(p i64) (lists i64) (reversed i64) (k i64)] (-> i64)
  (if (or (is-null lists) (cek-any-null-list? lists))
      (cek-continue (cek-reverse reversed) k)
      (cek-apply p
                 (cek-list-cars lists)
                 (make-continuation-frame (continuation-map-kind)
                                          (cek-list3 p (cek-list-cdrs lists) reversed)
                                          k))))

(defn cek-load-next [(p i64) (env i64) (k i64)] (-> i64)
  (cek-roots6! p env k (s-nil) (s-nil) (s-nil))
  (let [form (port/scm-read p)]
    (if (val-eq? form (s-eof))
        (do (port/close-input-port p) (cek-continue (s-unspecified) k))
        (cek-eval form
                  env
                  (make-continuation-frame (continuation-load-kind)
                                           (cek-list2 p env)
                                           k)))))

(defn cek-apply-tail [(args i64)] (-> i64)
  (if (is-null (cdr args))
      (car args)
      (cons (car args) (cek-apply-tail (cdr args)))))

(defn cek-wind-boundary? [(k i64)] (-> bool)
  (and (is-continuation k)
       (let [kind (continuation-kind k)]
         (or (= kind (continuation-wind-after-kind))
             (or (= kind (continuation-input-extent-kind))
                 (= kind (continuation-output-extent-kind)))))))

(defn cek-action-marker [] (-> i64)
  (intern "#%cek-dynamic-action"))
(defn cek-action [(kind i64) (value i64)] (-> i64)
  (cek-list3 (cek-action-marker) (mk-fixnum kind) value))
(defn cek-action? [(v i64)] (-> bool)
  (and (is-pair v) (val-eq? (car v) (cek-action-marker))))
(defn cek-run-action [(action i64)] (-> i64)
  (let [kind (fixnum-value (stdproc/scm-cadr action))
        value (stdproc/scm-caddr action)]
    (if (= kind 0)
        (port/port-set-current-input! value)
        (if (= kind 1)
            (port/port-set-current-output! value)
            (if (= kind 2)
                (do
                  (port/reopen-input-port! (car value) (stdproc/scm-cadr value))
                  (port/port-set-current-input! (car value)))
                (if (= kind 3)
                    (do
                      (port/port-set-current-input! (car value))
                      (port/close-input-port (stdproc/scm-cadr value)))
                    (if (= kind 4)
                        (do
                          (port/reopen-output-port! (car value) (stdproc/scm-cadr value))
                          (port/port-set-current-output! (car value)))
                        (do
                          (port/port-set-current-output! (car value))
                          (port/close-output-port (stdproc/scm-cadr value))))))))))

(defn cek-boundary-before [(k i64)] (-> i64)
  (let [kind (continuation-kind k)
        data (continuation-data k)]
    (if (= kind (continuation-wind-after-kind))
        (car data)
        (if (= kind (continuation-input-extent-kind))
            (cek-action 2
                        (cek-list2 (stdproc/scm-cadr data)
                                   (stdproc/scm-caddr data)))
            (cek-action 4
                        (cek-list2 (stdproc/scm-cadr data)
                                   (stdproc/scm-caddr data)))))))

(defn cek-boundary-after [(k i64)] (-> i64)
  (let [kind (continuation-kind k)
        data (continuation-data k)]
    (if (= kind (continuation-wind-after-kind))
        (stdproc/scm-cadr data)
        (if (= kind (continuation-input-extent-kind))
            (cek-action 3 (cek-list2 (car data) (stdproc/scm-cadr data)))
            (cek-action 5 (cek-list2 (car data) (stdproc/scm-cadr data)))))))

(defn cek-chain-has? [(chain i64) (needle i64)] (-> bool)
  (if (is-null chain)
      false
      (or (val-eq? chain needle)
          (cek-chain-has? (continuation-next chain) needle))))

(defn cek-common-continuation [(current i64) (destination i64)] (-> i64)
  (if (is-null current)
      (s-nil)
      (if (cek-chain-has? destination current)
          current
          (cek-common-continuation (continuation-next current) destination))))

;; A transfer item is `(thunk . context)`. `context` is the continuation chain
;; representing the dynamic environment in which that thunk must execute.
(defn cek-transfer-item [(thunk i64) (context i64)] (-> i64)
  (cons thunk context))

(defn cek-exit-items [(k i64) (common i64)] (-> i64)
  (if (or (is-null k) (val-eq? k common))
      (s-nil)
      (let [rest (cek-exit-items (continuation-next k) common)]
        (if (cek-wind-boundary? k)
            (cons (cek-transfer-item (cek-boundary-after k)
                                     (continuation-next k))
                  rest)
            rest))))

(defn cek-enter-items-inner-first [(k i64) (common i64)] (-> i64)
  (if (or (is-null k) (val-eq? k common))
      (s-nil)
      (let [rest (cek-enter-items-inner-first (continuation-next k) common)]
        (if (cek-wind-boundary? k)
            (cons (cek-transfer-item (cek-boundary-before k)
                                     (continuation-next k))
                  rest)
            rest))))

(defn cek-run-transfer [(items i64) (destination i64) (value i64)] (-> i64)
  (cek-roots6! items destination value (s-nil) (s-nil) (s-nil))
  (if (is-null items)
      (cek-continue value destination)
      (let [item (car items)]
        (if (cek-action? (car item))
            (do
              (cek-run-action (car item))
              (cek-run-transfer (cdr items) destination value))
            (cek-apply (car item)
                       (s-nil)
                       (make-continuation-frame (continuation-transfer-kind)
                                                (cek-list3 (cdr items) destination value)
                                                (cdr item)))))))

(defn cek-transfer [(current i64) (destination i64) (value i64)] (-> i64)
  (cek-roots6! current destination value (s-nil) (s-nil) (s-nil))
  (let [common (cek-common-continuation current destination)
        exits (cek-exit-items current common)]
    (cek-roots6! current destination value common exits (s-nil))
    (let [enters-inner (cek-enter-items-inner-first destination common)]
      (cek-roots6! current destination value common exits enters-inner)
      (let [enters (cek-reverse enters-inner)]
        (cek-roots6! current destination value exits enters (s-nil))
        (cek-run-transfer (cek-append exits enters) destination value)))))

(defn cek-sequence [(body i64) (env i64) (k i64)] (-> i64)
  (cek-roots6! body env k (s-nil) (s-nil) (s-nil))
  (if (is-null body)
      (cek-continue (s-unspecified) k)
      (if (is-null (cdr body))
          (cek-eval (car body) env k)
      (let [data (cek-list2 (cdr body) env)]
            (cek-eval (car body)
                      env
          (make-continuation-frame (continuation-sequence-kind) data k))))))

(defn cek-apply [(p i64) (args i64) (k i64)] (-> i64)
  (cek-roots6! p args k (s-nil) (s-nil) (s-nil))
  (if (is-continuation p)
      (if (or (is-null args) (not (is-null (cdr args))))
          (s-unspecified)
          (cek-transfer k p (car args)))
    (if (eval-closure-procedure? p)
        (let [captured (closure-env p)
                params (car captured)
                body (car (cdr captured))
              parent (car (cdr (cdr captured)))
              child (make-environment 0 parent)]
            (cek-roots6! p args k captured child parent)
          (bind-formals! params args child)
          (cek-sequence body child k))
          (if (eval-primitive-procedure? p)
              (let [name (car (closure-env p))]
                (cond (or (name=? name "call-with-current-continuation")
                          (name=? name "call/cc"))
                        (if (or (is-null args) (not (is-null (cdr args))))
                            (s-unspecified)
                            (cek-apply (car args) (cons k (s-nil)) k))
                      (name=? name "apply")
                        (if (or (is-null args) (is-null (cdr args)))
                            (s-unspecified)
                            (cek-apply (car args) (cek-apply-tail (cdr args)) k))
                      (name=? name "for-each")
                        (if (or (is-null args) (is-null (cdr args)))
                            (s-unspecified)
                            (cek-for-each-n (car args) (cdr args) k))
                      (name=? name "map")
                        (if (or (is-null args) (is-null (cdr args)))
                            (s-unspecified)
                            (cek-map-n (car args) (cdr args) (s-nil) k))
                      (name=? name "call-with-values")
                        (if (or (is-null args) (is-null (cdr args)))
                            (s-unspecified)
                            (cek-apply (car args)
                                       (s-nil)
                                       (make-continuation-frame (continuation-values-kind)
                                                                (stdproc/scm-cadr args)
                                                                k)))
                      (name=? name "dynamic-wind")
                        (if (or (is-null args)
                                (or (is-null (cdr args))
                                    (or (is-null (cdr (cdr args)))
                                        (not (is-null (cdr (cdr (cdr args))))))))
                            (s-unspecified)
                            (cek-apply (car args)
                                       (s-nil)
                                       (make-continuation-frame (continuation-wind-before-kind)
                                                                (cek-list3 (car args)
                                                                           (stdproc/scm-cadr args)
                                                                           (stdproc/scm-caddr args))
                                                                k)))
                      (name=? name "eval")
                        (if (or (is-null args)
                                (or (is-null (cdr args))
                                    (not (is-null (cdr (cdr args))))))
                            (s-unspecified)
                            (if (is-environment (stdproc/scm-cadr args))
                                (cek-eval (car args) (stdproc/scm-cadr args) k)
                                (cek-continue (s-unspecified) k)))
                      (name=? name "force")
                        (if (or (is-null args) (not (is-null (cdr args))))
                            (s-unspecified)
                            (let [promise (car args)]
                              (if (not (derived2/is-promise promise))
                                  (cek-continue promise k)
                                  (if (derived2/promise-forced? promise)
                                      (cek-continue (derived2/promise-slot promise) k)
                                      (let [thunk (derived2/promise-slot promise)]
                                        (if (eval-closure-procedure? thunk)
                                            (cek-apply thunk
                                                       (s-nil)
                                                       (make-continuation-frame (continuation-force-kind)
                                                                                promise
                                                                                k))
                                            (cek-continue (derived2/force promise) k)))))))
                      (name=? name "load")
                        (if (or (is-null args)
                                (not (or (is-null (cdr args))
                                         (is-null (cdr (cdr args))))))
                            (s-unspecified)
                            (let [env
                                    (if (is-null (cdr args))
                                        (interaction-environment)
                                        (stdproc/scm-cadr args))]
                              (if (not (is-environment env))
                                  (s-unspecified)
                                  (cek-load-next (port/open-input-file (car args)) env k))))
                      (name=? name "call-with-input-file")
                        (if (or (is-null args)
                                (or (is-null (cdr args))
                                    (not (is-null (cdr (cdr args))))))
                            (s-unspecified)
                            (let [p (port/open-input-file (car args))]
                              (cek-apply (stdproc/scm-cadr args)
                                         (cons p (s-nil))
                                         (make-continuation-frame (continuation-close-input-kind)
                                                                  p
                                                                  k))))
                      (name=? name "call-with-output-file")
                        (if (or (is-null args)
                                (or (is-null (cdr args))
                                    (not (is-null (cdr (cdr args))))))
                            (s-unspecified)
                            (let [p (port/open-output-file (car args))]
                              (cek-apply (stdproc/scm-cadr args)
                                         (cons p (s-nil))
                                         (make-continuation-frame (continuation-close-output-kind)
                                                                  p
                                                                  k))))
                      (name=? name "with-input-from-file")
                        (if (or (is-null args)
                                (or (is-null (cdr args))
                                    (not (is-null (cdr (cdr args))))))
                            (s-unspecified)
                            (let [old (port/current-input-port)
                                  p (port/open-input-file (car args))]
                              (port/port-set-current-input! p)
                              (cek-apply (stdproc/scm-cadr args)
                                         (s-nil)
                                         (make-continuation-frame (continuation-input-extent-kind)
                                                                  (cek-list3 old p (car args))
                                                                  k))))
                      (name=? name "with-output-to-file")
                        (if (or (is-null args)
                                (or (is-null (cdr args))
                                    (not (is-null (cdr (cdr args))))))
                            (s-unspecified)
                            (let [old (port/current-output-port)
                                  p (port/open-output-file (car args))]
                              (port/port-set-current-output! p)
                              (cek-apply (stdproc/scm-cadr args)
                                         (s-nil)
                                         (make-continuation-frame (continuation-output-extent-kind)
                                                                  (cek-list3 old p (car args))
                                                                  k))))
                      :else (cek-continue (eval-primitive name args) k)))
        (s-unspecified)))))

(defn cek-eval-arguments [(p i64) (done i64) (rest i64) (env i64) (k i64)] (-> i64)
  (cek-roots6! p done rest env k (s-nil))
  (if (is-null rest)
      (cek-apply p (cek-reverse done) k)
    (let [data (cek-list4 p done (cdr rest) env)]
        (cek-eval (car rest)
                  env
        (make-continuation-frame (continuation-argument-kind) data k)))))

(defn cek-eval [(e i64) (env i64) (k i64)] (-> i64)
  (cek-roots6! e env k (s-nil) (s-nil) (s-nil))
  (if (is-symbol e)
      (cek-continue (env-lookup env e) k)
      (if (not (is-pair e))
          (cek-continue e k)
      (let [head (car e)]
            (let [macro (env-syntax env head)]
              (if (not (val-eq? macro (s-false)))
                  (let [expanded (expand-runtime-syntax macro (cdr e) env)]
                    (cek-eval (car expanded) (cdr expanded) k))
                  (cond (or (name=? head "quote") (name=? head "quote-data")) (cek-continue (stdproc/scm-cadr e) k)
              (name=? head "if")
                (let [tail (cdr (cdr (cdr e)))
                                other
                                  (if (is-null (cdr (cdr (cdr e))))
                                      (s-unspecified)
                                      (car (cdr (cdr (cdr e)))))]
                            (cek-eval (stdproc/scm-cadr e)
                                      env
                                      (make-continuation-frame (continuation-if-kind)
                                                               (cek-list3 (stdproc/scm-caddr e) other env)
                                                               k)))
              (name=? head "begin") (cek-sequence (cdr e) env k)
                        (name=? head "let")
                          (let [second (stdproc/scm-cadr e)]
                            (if (is-symbol second)
                                (let [bindings (stdproc/scm-caddr e)
                                      child (make-environment 0 env)
                                      procedure
                                        (cek-make-eval-closure (binding-names bindings)
                                                               (cdr (cdr (cdr e)))
                                                               child)]
                                  (env-define! child second procedure)
                                  ;; Named-let initializers are outside the recursive
                                  ;; binding's scope; only the body sees `second`.
                                  (cek-eval-arguments procedure
                                                      (s-nil)
                                                      (cek-binding-expressions bindings)
                                                      env
                                                      k))
                                (cek-eval (cek-let-datum second (cdr (cdr e))) env k)))
                        (name=? head "let*")
                          (cek-eval (cek-let-star-datum (stdproc/scm-cadr e) (cdr (cdr e)))
                                    env
                                    k)
                        (name=? head "letrec")
                          (cek-eval (cek-letrec-datum (stdproc/scm-cadr e) (cdr (cdr e)))
                                    env
                                    k)
                        (name=? head "and")
                          (if (is-null (cdr e))
                              (cek-continue (s-true) k)
                              (cek-eval (stdproc/scm-cadr e)
                                        env
                                        (make-continuation-frame (continuation-and-kind)
                                                                 (cek-list2 (cdr (cdr e)) env)
                                                                 k)))
                        (name=? head "or")
                          (if (is-null (cdr e))
                              (cek-continue (s-false) k)
                              (cek-eval (stdproc/scm-cadr e)
                                        env
                                        (make-continuation-frame (continuation-or-kind)
                                                                 (cek-list2 (cdr (cdr e)) env)
                                                                 k)))
                        (name=? head "cond") (cek-eval (cek-cond-datum (cdr e)) env k)
                        (name=? head "case") (cek-eval (cek-case-datum (stdproc/scm-cadr e) (cdr (cdr e))) env k)
                        (name=? head "do")
                          (cek-eval (cek-do-datum (stdproc/scm-cadr e)
                                                  (stdproc/scm-caddr e)
                                                  (cdr (cdr (cdr e))))
                                    env
                                    k)
                        (name=? head "quasiquote")
                          (cek-eval (cek-quasiquote-datum (stdproc/scm-cadr e) env 1)
                                    env
                                    k)
                        (name=? head "cek-collect-now") (do (collect) (cek-continue (s-unspecified) k))
                        (name=? head "s-undefined") (cek-continue (s-undefined) k)
              (name=? head "lambda")
                          (cek-continue (cek-make-eval-closure (stdproc/scm-cadr e) (cdr (cdr e)) env)
                                        k)
                        (name=? head "delay")
                          (cek-continue (derived2/make-promise (cek-make-eval-closure (s-nil) (cdr e) env))
                                        k)
              (name=? head "define")
                (let [target (stdproc/scm-cadr e)]
                  (if (is-symbol target)
                                (cek-eval (stdproc/scm-caddr e)
                                          env
                        (make-continuation-frame (continuation-define-kind)
                                                                   (cek-list2 target env)
                                                                   k))
                                (cek-continue (env-define! env
                                                           (car target)
                                                           (cek-make-eval-closure (cdr target) (cdr (cdr e)) env))
                                              k)))
                        (name=? head "define-syntax") (cek-continue (eval-define-syntax e env) k)
                        (name=? head "let-syntax")
                          (let [local (make-environment 0 env)]
                            (eval-syntax-bindings! (stdproc/scm-cadr e) local env)
                            (cek-sequence (cdr (cdr e)) local k))
                        (name=? head "letrec-syntax")
                          (let [local (make-environment 0 env)]
                            (eval-syntax-bindings! (stdproc/scm-cadr e) local local)
                            (cek-sequence (cdr (cdr e)) local k))
                        (or (name=? head "set!") (name=? head "coil.core.set!"))
                          (cek-eval (stdproc/scm-caddr e)
                                    env
                  (make-continuation-frame (continuation-set-kind)
                                                             (cek-list2 (stdproc/scm-cadr e) env)
                                                             k))
              (or (name=? head "call-with-current-continuation")
                  (name=? head "call/cc"))
                          (cek-eval (stdproc/scm-cadr e)
                                    env
                  (make-continuation-frame (continuation-callcc-kind) (s-nil) k))
              :else
                          (cek-eval head
                                    env
                  (make-continuation-frame (continuation-operator-kind)
                                                             (cek-list2 (cdr e) env)
                                                             k)))))))))

(defn cek-continue [(v i64) (k i64)] (-> i64)
  (cek-roots6! v k (s-nil) (s-nil) (s-nil) (s-nil))
  (let [kind (continuation-kind k)
        data (continuation-data k)
        next (continuation-next k)]
    (cond (= kind (continuation-halt-kind)) v
          (= kind (continuation-if-kind))
            (cek-eval (if (truthy? v) (car data) (stdproc/scm-cadr data))
                      (stdproc/scm-caddr data)
                      next)
          (= kind (continuation-sequence-kind)) (cek-sequence (car data) (stdproc/scm-cadr data) next)
          (= kind (continuation-operator-kind)) (cek-eval-arguments v (s-nil) (car data) (stdproc/scm-cadr data) next)
          (= kind (continuation-argument-kind))
            (cek-eval-arguments (car data)
                                (cons v (stdproc/scm-cadr data))
                                (stdproc/scm-caddr data)
                                (car (cdr (cdr (cdr data))))
                                next)
          (= kind (continuation-define-kind)) (cek-continue (env-define! (stdproc/scm-cadr data) (car data) v) next)
          (= kind (continuation-set-kind)) (cek-continue (env-set! (stdproc/scm-cadr data) (car data) v) next)
          (= kind (continuation-callcc-kind)) (cek-apply v (cons next (s-nil)) next)
          (= kind (continuation-values-kind)) (cek-apply data (stdproc/values-contents v) next)
          (= kind (continuation-for-each-kind)) (cek-for-each-n (car data) (stdproc/scm-cadr data) next)
          (= kind (continuation-map-kind))
            (cek-map-n (car data)
                       (stdproc/scm-cadr data)
                       (cons v (stdproc/scm-caddr data))
                       next)
          (= kind (continuation-wind-before-kind))
            (let [boundary
                    (make-continuation-frame (continuation-wind-after-kind)
                                             (cek-list2 (car data) (stdproc/scm-caddr data))
                                             next)]
              (cek-apply (stdproc/scm-cadr data) (s-nil) boundary))
          (= kind (continuation-wind-after-kind))
            (cek-apply (stdproc/scm-cadr data)
                       (s-nil)
                       (make-continuation-frame (continuation-wind-finish-kind) v next))
          (= kind (continuation-wind-finish-kind)) (cek-continue data next)
          (= kind (continuation-transfer-kind))
            (cek-run-transfer (car data)
                              (stdproc/scm-cadr data)
                              (stdproc/scm-caddr data))
          (= kind (continuation-force-kind)) (cek-continue (derived2/promise-finish! data v) next)
          (= kind (continuation-and-kind))
            (if (or (not (truthy? v)) (is-null (car data)))
                (cek-continue v next)
                (cek-eval (car (car data))
                          (stdproc/scm-cadr data)
                          (make-continuation-frame (continuation-and-kind)
                                                   (cek-list2 (cdr (car data)) (stdproc/scm-cadr data))
                                                   next)))
          (= kind (continuation-or-kind))
            (if (or (truthy? v) (is-null (car data)))
                (cek-continue v next)
                (cek-eval (car (car data))
                          (stdproc/scm-cadr data)
                          (make-continuation-frame (continuation-or-kind)
                                                   (cek-list2 (cdr (car data)) (stdproc/scm-cadr data))
                                                   next)))
          (= kind (continuation-load-kind)) (cek-load-next (car data) (stdproc/scm-cadr data) next)
          (= kind (continuation-close-input-kind)) (do (port/close-input-port data) (cek-continue v next))
          (= kind (continuation-close-output-kind)) (do (port/close-output-port data) (cek-continue v next))
          (= kind (continuation-input-extent-kind))
            (do
              (port/port-set-current-input! (car data))
              (port/close-input-port (stdproc/scm-cadr data))
              (cek-continue v next))
          (= kind (continuation-output-extent-kind))
            (do
              (port/port-set-current-output! (car data))
              (port/close-output-port (stdproc/scm-cadr data))
              (cek-continue v next))
          :else (s-unspecified))))

(defn continuation-eval [(expression i64) (environment i64)] (-> i64)
  (if (is-environment environment)
      (let [base (gc-sp)]
        (primitive/store! (cek-shadow-base) base)
        (cek-roots6! expression environment (s-nil) (s-nil) (s-nil) (s-nil))
        (let [out (cek-eval expression environment (make-halt-continuation))]
          (cek-clear-roots!)
          (gc-sp-set! base)
          out))
    (s-unspecified)))

(defn eval-if [(e i64) (env i64)] (-> i64)
  (let [test (runtime-eval (stdproc/scm-cadr e) env)]
    (if (truthy? test)
        (runtime-eval (stdproc/scm-caddr e) env)
      (let [rest (cdr (cdr (cdr e)))]
        (if (is-null rest) (s-unspecified) (runtime-eval (car rest) env))))))
(defn eval-define [(e i64) (env i64)] (-> i64)
  (let [target (stdproc/scm-cadr e)]
    (if (is-symbol target)
        (env-define! env target (runtime-eval (stdproc/scm-caddr e) env))
        (let [name (car target)
              params (cdr target)
              body (cdr (cdr e))]
        (env-define! env name (make-eval-closure params body env))))))
(defn eval-set [(e i64) (env i64)] (-> i64)
  (env-set! env (stdproc/scm-cadr e) (runtime-eval (stdproc/scm-caddr e) env)))

(defn eval-and [(forms i64) (env i64)] (-> i64)
  (if (is-null forms)
      (s-true)
    (let [value (runtime-eval (car forms) env)]
        (if (not (truthy? value))
            value
        (if (is-null (cdr forms)) value (eval-and (cdr forms) env))))))
(defn eval-or [(forms i64) (env i64)] (-> i64)
  (if (is-null forms)
      (s-false)
    (let [value (runtime-eval (car forms) env)]
      (if (truthy? value) value (eval-or (cdr forms) env)))))

(defn binding-names [(bindings i64)] (-> i64)
  (if (is-null bindings)
      (s-nil)
    (cons (car (car bindings)) (binding-names (cdr bindings)))))
(defn binding-values [(bindings i64) (env i64)] (-> i64)
  (if (is-null bindings)
      (s-nil)
      (let [sp (gc-sp)
            value (runtime-eval (stdproc/scm-cadr (car bindings)) env)]
        (gc-root value)
        (gc-root bindings)
        (gc-root env)
      (let [rest (binding-values (cdr bindings) env)]
        (gc-root rest)
        (let [out (cons value rest)] (gc-sp-set! sp) (gc-root out) out)))))
(defn bind-names! [(names i64) (values i64) (env i64)] (-> i64)
  (if (is-null names)
      env
      (do
        (env-define! env (car names) (car values))
        (bind-names! (cdr names) (cdr values) env))))
(defn eval-let [(e i64) (env i64)] (-> i64)
  (let [named (is-symbol (stdproc/scm-cadr e))
        name (if named (stdproc/scm-cadr e) (s-false))
        bindings (if named (stdproc/scm-caddr e) (stdproc/scm-cadr e))
        body (if named (cdr (cdr (cdr e))) (cdr (cdr e)))
        names (binding-names bindings)
        values (binding-values bindings env)]
    (if named
        (let [child (make-environment 0 env)
              closure (make-eval-closure names body child)]
          (env-define! child name closure)
          (stdproc/scm-apply-list closure values))
      (let [child (make-environment 0 env)]
        (bind-names! names values child)
        (eval-sequence body child)))))
(defn eval-let-star-bindings [(bindings i64) (body i64) (env i64)] (-> i64)
  (if (is-null bindings)
      (eval-sequence body env)
    (let [child (make-environment 0 env)
          binding (car bindings)
          value (runtime-eval (stdproc/scm-cadr binding) env)]
      (env-define! child (car binding) value)
      (eval-let-star-bindings (cdr bindings) body child))))
(defn eval-let-star [(e i64) (env i64)] (-> i64)
  ;; Even `(let* () ...)` introduces a fresh definition region. Reusing `env`
  ;; made an internal define escape and overwrite the surrounding/global cell.
  (eval-let-star-bindings (stdproc/scm-cadr e)
                          (cdr (cdr e))
                          (make-environment 0 env)))
(defn prebind! [(bindings i64) (env i64)] (-> i64)
  (if (is-null bindings)
      env
      (do
        (env-define! env (car (car bindings)) (s-unspecified))
        (prebind! (cdr bindings) env))))
(defn init-letrec! [(bindings i64) (env i64)] (-> i64)
  (if (is-null bindings)
      env
      (do
        (env-set! env
                  (car (car bindings))
                  (runtime-eval (stdproc/scm-cadr (car bindings)) env))
        (init-letrec! (cdr bindings) env))))
(defn eval-letrec [(e i64) (env i64)] (-> i64)
  (let [bindings (stdproc/scm-cadr e)
        child (make-environment 0 env)]
    (prebind! bindings child)
    (init-letrec! bindings child)
    (eval-sequence (cdr (cdr e)) child)))

(defn eval-cond [(clauses i64) (env i64)] (-> i64)
  (if (is-null clauses)
      (s-unspecified)
      (let [clause (car clauses)
            test (car clause)]
        (if (name=? test "else")
            (eval-sequence (cdr clause) env)
            (let [value (runtime-eval test env)
                  tail (cdr clause)]
              (if (not (truthy? value))
                  (eval-cond (cdr clauses) env)
                  (if (is-null tail)
                      value
              (if (name=? (car tail) "=>")
                  (stdproc/call--1 (runtime-eval (stdproc/scm-cadr tail) env) value)
                (eval-sequence tail env)))))))))
(defn case-member? [(key i64) (datums i64)] (-> bool)
  (if (is-null datums)
      false
    (or (truthy? (scm-eqv? key (car datums))) (case-member? key (cdr datums)))))
(defn eval-case-clauses [(key i64) (clauses i64) (env i64)] (-> i64)
  (if (is-null clauses)
      (s-unspecified)
      (let [clause (car clauses)
            datums (car clause)]
      (if (or (name=? datums "else") (case-member? key datums))
          (eval-sequence (cdr clause) env)
        (eval-case-clauses key (cdr clauses) env)))))
(defn eval-case [(e i64) (env i64)] (-> i64)
  (eval-case-clauses (runtime-eval (stdproc/scm-cadr e) env) (cdr (cdr e)) env))

(defn do-step-values [(specs i64) (env i64)] (-> i64)
  (if (is-null specs)
      (s-nil)
      (let [sp (gc-sp)
            spec (car specs)
            value
              (if (is-null (cdr (cdr spec)))
                    (env-lookup env (car spec))
                  (runtime-eval (stdproc/scm-caddr spec) env))]
        (gc-root value)
        (gc-root specs)
        (gc-root env)
      (let [rest (do-step-values (cdr specs) env)]
        (gc-root rest)
        (let [out (cons value rest)] (gc-sp-set! sp) (gc-root out) out)))))
(defn set-names! [(names i64) (values i64) (env i64)] (-> i64)
  (if (is-null names)
      env
      (do
        (env-set! env (car names) (car values))
        (set-names! (cdr names) (cdr values) env))))
(defn eval-do-loop [(specs i64) (test-clause i64) (body i64) (env i64)] (-> i64)
  (if (truthy? (runtime-eval (car test-clause) env))
      (if (is-null (cdr test-clause))
          (s-unspecified)
        (eval-sequence (cdr test-clause) env))
      (do
        (eval-sequence body env)
        (let [names (binding-names specs)
              values (do-step-values specs env)]
          (set-names! names values env)
          (eval-do-loop specs test-clause body env)))))
(defn eval-do [(e i64) (env i64)] (-> i64)
  (let [specs (stdproc/scm-cadr e)
        test-clause (stdproc/scm-caddr e)
        child (make-environment 0 env)
        names (binding-names specs)
        values (binding-values specs env)]
    (bind-names! names values child)
    (eval-do-loop specs test-clause (cdr (cdr (cdr e))) child)))

(defn qq-wrap [(marker i64) (value i64)] (-> i64)
  (cons marker (cons value (s-nil))))
(defn eval-quasiquote-list [(datum i64) (env i64) (level i64)] (-> i64)
  (if (is-null datum)
      (s-nil)
      (if (not (is-pair datum))
          (eval-quasiquote datum env level)
      ;; In a dotted tail, `.<space>,x` is represented by the reader as the
      ;; pair `(unquote x)` itself. It must be evaluated as the tail rather than
      ;; copied as the two ordinary elements `unquote` and `x`.
      (if (and (= level 1) (name=? (car datum) "unquote"))
          (eval-quasiquote datum env level)
      (let [item (car datum)]
        (if (and (= level 1)
                 (and (is-pair item) (name=? (car item) "unquote-splicing")))
                    (stdproc/scm-append (runtime-eval (stdproc/scm-cadr item) env)
              (eval-quasiquote-list (cdr datum) env level))
          (cons (eval-quasiquote item env level)
                (eval-quasiquote-list (cdr datum) env level))))))))
(defn eval-quasiquote [(datum i64) (env i64) (level i64)] (-> i64)
  (if (is-vector datum)
      (stdproc/scm-list->vector (eval-quasiquote-list (stdproc/scm-vector->list datum) env level))
      (if (not (is-pair datum))
          datum
      (let [head (car datum)]
        (if (name=? head "quasiquote")
            (qq-wrap head (eval-quasiquote (stdproc/scm-cadr datum) env (+ level 1)))
          (if (name=? head "unquote")
                    (if (= level 1)
                        (runtime-eval (stdproc/scm-cadr datum) env)
                (qq-wrap head (eval-quasiquote (stdproc/scm-cadr datum) env (- level 1))))
            (if (name=? head "unquote-splicing")
                        (if (= level 1)
                            (s-unspecified)
                  (qq-wrap head (eval-quasiquote (stdproc/scm-cadr datum) env (- level 1))))
              (eval-quasiquote-list datum env level))))))))

; ============================================================================
; Runtime syntax-rules
; ============================================================================
;; Compiled Scheme uses the Code-level expander in numeric.coil. `eval` and
;; `load` operate on runtime datum objects, so they need the same semantics over
;; Val lists. A syntax binding is an ordinary traced list
;;   (#%runtime-syntax spec definition-environment)
;; stored in the lexical environment. Template-introduced identifiers become
;; unique symbols; free identifiers are aliased to their definition-site values
;; in an expansion environment whose parent is the use-site environment.

(defn eval-fail [(msg (ptr i8))] (-> i64)
  (alloc/oom-puts c"coil.scheme: ")
  (alloc/oom-puts msg)
  (alloc/oom-puts c"\n")
  (alloc/abort)
  (s-unspecified))

(defn srval-nth [(xs i64) (i i64)] (-> i64)
  (if (= i 0) (car xs) (srval-nth (cdr xs) (- i 1))))
(defn srval-length [(xs i64)] (-> i64)
  (stdproc/list--length xs 0))
(defn srval-append [(a i64) (b i64)] (-> i64)
  (if (is-null a) b (cons (car a) (srval-append (cdr a) b))))
(defn srval-member-symbol? [(x i64) (xs i64)] (-> bool)
  (if (is-null xs)
      false
    (or (val-eq? x (car xs)) (srval-member-symbol? x (cdr xs)))))
(defn srval-ellipsis? [(v i64)] (-> bool)
  (name=? v "..."))
(defn srval-failure [] (-> i64)
  (intern "#%syntax-no-match"))
(defn srval-failed? [(v i64)] (-> bool)
  (val-eq? v (srval-failure)))

;; A binding is `(name depth value)`. Depth one is a column gathered by an
;; ellipsis; slicing one repetition turns it back into depth zero.
(defn srval-binding [(name i64) (depth i64) (value i64)] (-> i64)
  (cons name (cons (mk-fixnum depth) (cons value (s-nil)))))
(defn srval-binding-name [(b i64)] (-> i64)
  (car b))
(defn srval-binding-depth [(b i64)] (-> i64)
  (fixnum-value (stdproc/scm-cadr b)))
(defn srval-binding-value [(b i64)] (-> i64)
  (stdproc/scm-caddr b))
(defn srval-lookup [(bs i64) (name i64)] (-> i64)
  (if (is-null bs)
      (s-false)
      (if (val-eq? (srval-binding-name (car bs)) name)
          (car bs)
      (srval-lookup (cdr bs) name))))

(defn srval-literal? [(s i64) (lits i64)] (-> bool)
  (if (is-null lits)
      false
    (or (val-eq? s (car lits)) (srval-literal? s (cdr lits)))))
(defn srval-literal-match? [(lit i64) (form i64) (defenv i64) (useenv i64)] (-> bool)
  (if (not (and (is-symbol form) (val-eq? lit form)))
      false
      (let [dc (env-cell lit defenv)
            uc (env-cell form useenv)]
      ;; The same lexical cell matches. Two unbound/report identifiers also
      ;; match (the usual case for `else`, `=>`, and primitive names).
      (or (and (val-eq? dc (s-false)) (val-eq? uc (s-false)))
          (and (not (val-eq? dc (s-false))) (val-eq? dc uc))))))

(defn srval-vars [(p i64) (lits i64) (acc i64)] (-> i64)
  (if (is-symbol p)
      (if (or (srval-ellipsis? p)
              (or (name=? p "_") (srval-literal? p lits)))
          acc
        (if (srval-member-symbol? p acc) acc (cons p acc)))
      (if (is-pair p)
          (srval-vars-list p lits acc)
          (if (is-vector p)
              (srval-vars-list (stdproc/scm-vector->list p) lits acc)
        acc))))
(defn srval-vars-list [(p i64) (lits i64) (acc i64)] (-> i64)
  (if (is-null p)
      acc
    (srval-vars-list (cdr p) lits (srval-vars (car p) lits acc))))

;; Validation needs the un-deduplicated variable stream; matching uses the
;; compact list above. The first pattern element (the macro keyword) is skipped
;; by the caller and is not a pattern variable.
(defn srval-vars-all [(p i64) (lits i64) (acc i64)] (-> i64)
  (if (is-symbol p)
      (if (or (srval-ellipsis? p)
              (or (name=? p "_") (srval-literal? p lits)))
          acc
        (cons p acc))
      (if (is-pair p)
          (srval-vars-all-list p lits acc)
      (if (is-vector p)
          (srval-vars-all-list (stdproc/scm-vector->list p) lits acc)
        acc))))
(defn srval-vars-all-list [(p i64) (lits i64) (acc i64)] (-> i64)
  (if (is-null p)
      acc
    (srval-vars-all-list (cdr p) lits (srval-vars-all (car p) lits acc))))
(defn srval-duplicate-vars? [(xs i64)] (-> bool)
  (if (is-null xs)
      false
    (or (srval-member-symbol? (car xs) (cdr xs))
        (srval-duplicate-vars? (cdr xs)))))

(defn srval-rules-well-formed? [(rules i64)] (-> bool)
  (if (is-null rules)
      true
      (if (not (is-pair rules))
          false
      (let [rule (car rules)]
        (and (is-pair rule)
             (and (is-pair (cdr rule))
                  (and (is-null (cdr (cdr rule)))
                       (and (is-pair (car rule))
                            (srval-rules-well-formed? (cdr rules))))))))))
(defn srval-rules-unique? [(rules i64) (lits i64)] (-> bool)
  (if (is-null rules)
      true
    (let [pat (car (car rules))]
      (and (not (srval-duplicate-vars? (srval-vars-all-list (cdr pat) lits (s-nil))))
           (srval-rules-unique? (cdr rules) lits)))))
(defn srval-transformer-shape? [(spec i64)] (-> bool)
  (and (is-pair spec)
       (and (name=? (car spec) "syntax-rules")
            (and (is-pair (cdr spec))
                 (let [lits (stdproc/scm-cadr spec)
                       rules (cdr (cdr spec))]
                   (and (truthy? (stdproc/scm-list? lits))
                        (and (is-pair rules)
                             (srval-rules-well-formed? rules))))))))
(defn srval-transformer-unique? [(spec i64)] (-> bool)
  (srval-rules-unique? (cdr (cdr spec)) (stdproc/scm-cadr spec)))

(defn srval-ellipsis-pos [(p i64) (i i64)] (-> i64)
  (if (is-null p)
      -1
    (if (srval-ellipsis? (car p)) i (srval-ellipsis-pos (cdr p) (+ i 1)))))

(defn srval-match-fixed [(p i64)
                         (pi i64)
                         (pend i64)
                         (f i64)
                         (fi i64)
                         (fend i64)
                         (bs i64)
                         (lits i64)
                         (defenv i64)
                         (useenv i64)] (-> i64)
  (if (>= pi pend)
      bs
      (if (>= fi fend)
          (srval-failure)
          (let [r
                  (srval-match (srval-nth p pi)
                               (srval-nth f fi)
                               bs
                               lits
                               defenv
                               useenv)]
            (if (srval-failed? r)
                r
                (srval-match-fixed p
                                   (+ pi 1)
                                   pend
                                   f
                                   (+ fi 1)
                                   fend
                                   r
                                   lits
                                   defenv
                                   useenv))))))

(defn srval-match-reps [(sub i64)
                        (f i64)
                        (i i64)
                        (end i64)
                        (lits i64)
                        (defenv i64)
                        (useenv i64)] (-> i64)
  (if (>= i end)
      (s-nil)
    (let [r (srval-match sub (srval-nth f i) (s-nil) lits defenv useenv)]
        (if (srval-failed? r)
            r
        (let [more (srval-match-reps sub f (+ i 1) end lits defenv useenv)]
          (if (srval-failed? more) more (cons r more)))))))

(defn srval-column [(reps i64) (name i64)] (-> i64)
  (if (is-null reps)
      (s-nil)
    (let [b (srval-lookup (car reps) name)]
        (if (val-eq? b (s-false))
            (srval-column (cdr reps) name)
        (cons (srval-binding-value b) (srval-column (cdr reps) name))))))
(defn srval-column-depth [(reps i64) (name i64)] (-> i64)
  (if (is-null reps)
      1
    (let [b (srval-lookup (car reps) name)]
        (if (val-eq? b (s-false))
            (srval-column-depth (cdr reps) name)
        (+ (srval-binding-depth b) 1)))))
(defn srval-transpose [(vars i64) (reps i64) (bs i64)] (-> i64)
  (if (is-null vars)
      bs
      (srval-transpose (cdr vars)
                       reps
                       (cons (srval-binding (car vars)
                                            (srval-column-depth reps (car vars))
                                            (srval-column reps (car vars)))
                             bs))))

(defn srval-match [(p i64)
                   (f i64)
                   (bs i64)
                   (lits i64)
                   (defenv i64)
                   (useenv i64)] (-> i64)
  (if (is-symbol p)
      (if (name=? p "_")
          bs
        (if (srval-literal? p lits)
            (if (srval-literal-match? p f defenv useenv) bs (srval-failure))
          (cons (srval-binding p 0 f) bs)))
    (if (is-vector p)
          (if (not (is-vector f))
              (srval-failure)
              (srval-match (stdproc/scm-vector->list p)
                           (stdproc/scm-vector->list f)
                           bs
                           lits
                           defenv
                           useenv))
    (if (is-pair p)
              (if (not (or (is-pair f) (is-null f)))
                  (srval-failure)
                  (let [pn (srval-length p)
                        fn (srval-length f)
                epos (srval-ellipsis-pos p 0)]
            (if (< epos 0)
                        (if (!= pn fn)
                            (srval-failure)
                  (srval-match-fixed p 0 pn f 0 fn bs lits defenv useenv))
              (let [nfixed (- epos 1)
                    ntail (- pn (+ epos 1))
                    nrep (- (- fn nfixed) ntail)]
                          (if (< nrep 0)
                              (srval-failure)
                              (let [r1
                                      (srval-match-fixed p
                                                         0
                                                         nfixed
                                                         f
                                                         0
                                                         nfixed
                                                         bs
                                                         lits
                                                         defenv
                                                         useenv)]
                                (if (srval-failed? r1)
                                    r1
                      (let [sub (srval-nth p (- epos 1))
                                          reps
                                            (srval-match-reps sub
                                                              f
                                                              nfixed
                                                              (+ nfixed nrep)
                                                              lits
                                                              defenv
                                                              useenv)]
                                      (if (srval-failed? reps)
                                          reps
                                          (srval-match-fixed p
                                                             (+ epos 1)
                                                             pn
                                                             f
                                                             (+ nfixed nrep)
                                                             fn
                            (srval-transpose (srval-vars sub lits (s-nil)) reps r1)
                                                             lits
                                                             defenv
                                                             useenv))))))))))
      (if (val-eq? p f) bs (srval-failure))))))

(defn srval-special-identifier? [(s i64)] (-> bool)
  (if (not (is-symbol s))
      false
    (let [n (symbol-name s)]
        (cond (str-eq n "quote") true
              (str-eq n "if") true
              (str-eq n "begin") true
              (str-eq n "lambda") true
              (str-eq n "define") true
              (str-eq n "set!") true
              (str-eq n "and") true
              (str-eq n "or") true
              (str-eq n "let") true
              (str-eq n "let*") true
              (str-eq n "letrec") true
              (str-eq n "cond") true
              (str-eq n "case") true
              (str-eq n "do") true
              (str-eq n "delay") true
              (str-eq n "quasiquote") true
              (str-eq n "unquote") true
              (str-eq n "unquote-splicing") true
              (str-eq n "else") true
              (str-eq n "=>") true
              (str-eq n "define-syntax") true
              (str-eq n "syntax-rules") true
            :else false))))

(defn srval-renamed [(s i64) (rename-env i64) (alias-env i64) (defenv i64)] (-> i64)
  (let [cell (env-cell s rename-env)]
    (if (not (val-eq? cell (s-false)))
        (car cell)
      (let [sp (gc-sp)]
          (gc-root s)
          (gc-root rename-env)
          (gc-root alias-env)
          (gc-root defenv)
        (let [fresh (fresh-symbol-like s)]
        (gc-root fresh)
        (env-define! rename-env s fresh)
        (let [definition (env-lookup defenv s)]
          (gc-root definition)
          (if (not (val-eq? definition (s-unspecified)))
              (env-define! alias-env fresh definition)
            0))
            (gc-sp-set! sp)
            (gc-root fresh)
            fresh)))))

(defn srval-slice-bindings [(bs i64) (k i64)] (-> i64)
  (if (is-null bs)
      (s-nil)
    (let [b (car bs)]
      (cons (if (> (srval-binding-depth b) 0)
                  (srval-binding (srval-binding-name b)
                                 (- (srval-binding-depth b) 1)
                               (srval-nth (srval-binding-value b) k))
              b)
            (srval-slice-bindings (cdr bs) k)))))
(defn srval-rep-count [(vars i64) (bs i64)] (-> i64)
  (if (is-null vars)
      0
    (let [b (srval-lookup bs (car vars))]
      (if (and (not (val-eq? b (s-false))) (> (srval-binding-depth b) 0))
          (srval-length (srval-binding-value b))
        (srval-rep-count (cdr vars) bs)))))
(defn srval-has-repeated-var? [(vars i64) (bs i64)] (-> bool)
  (if (is-null vars)
      false
    (let [b (srval-lookup bs (car vars))]
      (or (and (not (val-eq? b (s-false))) (> (srval-binding-depth b) 0))
          (srval-has-repeated-var? (cdr vars) bs)))))

(defn srval-expand-reps [(sub i64)
                         (bs i64)
                         (k i64)
                         (n i64)
                         (rename-env i64)
                         (alias-env i64)
                         (defenv i64)] (-> i64)
  (if (>= k n)
      (s-nil)
      (cons (srval-expand sub
                          (srval-slice-bindings bs k)
                          rename-env
                          alias-env
                          defenv
                          false)
          (srval-expand-reps sub bs (+ k 1) n rename-env alias-env defenv))))

(defn srval-expand-list [(t i64)
                         (bs i64)
                         (rename-env i64)
                         (alias-env i64)
                         (defenv i64)
                         (quoted bool)] (-> i64)
  (if (is-null t)
      (s-nil)
    (if (and (is-pair (cdr t)) (srval-ellipsis? (stdproc/scm-cadr t)))
        (let [sub (car t)
              vars (srval-vars sub (s-nil) (s-nil))]
          (if (not (srval-has-repeated-var? vars bs))
              (eval-fail c"syntax-rules: template ellipsis has no repeated pattern variable")
                (let [reps
                        (srval-expand-reps sub
                                           bs
                                           0
                                           (srval-rep-count vars bs)
                                           rename-env
                                           alias-env
                                           defenv)]
              (srval-append reps
                (srval-expand-list (cdr (cdr t)) bs rename-env alias-env defenv quoted)))))
      (cons (srval-expand (car t) bs rename-env alias-env defenv quoted)
            (srval-expand-list (cdr t) bs rename-env alias-env defenv quoted)))))

(defn srval-expand [(t i64)
                    (bs i64)
                    (rename-env i64)
                    (alias-env i64)
                    (defenv i64)
                    (quoted bool)] (-> i64)
  (if (is-symbol t)
      (let [b (srval-lookup bs t)]
        (if (not (val-eq? b (s-false)))
            (srval-binding-value b)
            (if (or quoted (srval-special-identifier? t))
                t
            (srval-renamed t rename-env alias-env defenv))))
    (if (is-pair t)
        (let [is-quote (and (is-symbol (car t)) (name=? (car t) "quote"))]
            (srval-expand-list t
                               bs
                               rename-env
                               alias-env
                               defenv
                             (or quoted is-quote)))
      (if (is-vector t)
              (stdproc/scm-list->vector (srval-expand-list (stdproc/scm-vector->list t)
                                                           bs
                                                           rename-env
                                                           alias-env
                                                           defenv
                                                           quoted))
        t))))

(defn runtime-syntax-marker [] (-> i64)
  (intern "#%runtime-syntax"))
(defn make-runtime-syntax [(spec i64) (defenv i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root spec)
    (gc-root defenv)
    (let [tail2 (cons defenv (s-nil))]
      (gc-root tail2)
      (let [tail1 (cons spec tail2)]
        (gc-root tail1)
        (let [out (cons (runtime-syntax-marker) tail1)]
          (gc-sp-set! sp)
          (gc-root out)
          out)))))
(defn runtime-syntax? [(v i64)] (-> bool)
  (and (is-pair v) (val-eq? (car v) (runtime-syntax-marker))))
(defn runtime-syntax-spec [(v i64)] (-> i64)
  (stdproc/scm-cadr v))
(defn runtime-syntax-env [(v i64)] (-> i64)
  (stdproc/scm-caddr v))

(defn srval-try-rules [(rules i64)
                       (args i64)
                       (lits i64)
                       (defenv i64)
                       (useenv i64)
                       (rename-env i64)
                       (alias-env i64)] (-> i64)
  (if (is-null rules)
      (eval-fail c"syntax-rules: no matching rule")
      (let [rule (car rules)
            pat (car rule)
            tmpl (stdproc/scm-cadr rule)
          bs (srval-match (cdr pat) args (s-nil) lits defenv useenv)]
      (if (srval-failed? bs)
          (srval-try-rules (cdr rules) args lits defenv useenv rename-env alias-env)
        (srval-expand tmpl bs rename-env alias-env defenv false)))))

(defn expand-runtime-syntax [(macro i64) (args i64) (useenv i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root macro)
    (gc-root args)
    (gc-root useenv)
    (let [spec (runtime-syntax-spec macro)
          defenv (runtime-syntax-env macro)]
      (gc-root spec)
      (gc-root defenv)
      (let [rename-env (make-environment 0 (s-nil))]
        (gc-root rename-env)
        (let [alias-env (make-environment 0 useenv)]
          (gc-root alias-env)
          (let [expanded
                  (srval-try-rules (cdr (cdr spec))
                                   args
                                   (stdproc/scm-cadr spec)
                                   defenv
                                   useenv
                                   rename-env
                                   alias-env)]
            (gc-root expanded)
            ;; Return both because hygienically introduced free identifiers are
            ;; bound in `alias-env`; evaluating only the expanded datum in the
            ;; use-site environment would reintroduce capture.
            (let [out (cons expanded alias-env)]
              (gc-sp-set! sp)
              (gc-root out)
              out)))))))

(defn eval-runtime-syntax [(macro i64) (args i64) (useenv i64)] (-> i64)
  (let [expanded (expand-runtime-syntax macro args useenv)]
    (runtime-eval (car expanded) (cdr expanded))))

(defn eval-define-syntax [(e i64) (env i64)] (-> i64)
  (let [name (stdproc/scm-cadr e)
        spec (stdproc/scm-caddr e)]
    (if (not (and (is-symbol name) (srval-transformer-shape? spec)))
        (eval-fail c"define-syntax: expected identifier and well-formed syntax-rules transformer")
      (if (not (srval-transformer-unique? spec))
          (eval-fail c"syntax-rules: pattern variable appears more than once")
        (do (env-define! env name (make-runtime-syntax spec env)) (s-unspecified))))))

(defn eval-syntax-bindings! [(bindings i64) (target i64) (defenv i64)] (-> i64)
  (if (is-null bindings)
      0
    (let [binding (car bindings)
          name (car binding)
          spec (stdproc/scm-cadr binding)]
      (if (not (and (is-symbol name) (srval-transformer-shape? spec)))
          (eval-fail c"local syntax binding expects (identifier (syntax-rules ...))")
        (if (not (srval-transformer-unique? spec))
            (eval-fail c"syntax-rules: pattern variable appears more than once")
          (env-define! target name (make-runtime-syntax spec defenv))))
      (eval-syntax-bindings! (cdr bindings) target defenv))))

(defn eval-let-syntax [(e i64) (env i64) (recursive bool)] (-> i64)
  (let [local (make-environment 0 env)]
    (eval-syntax-bindings! (stdproc/scm-cadr e) local (if recursive local env))
    (eval-sequence (cdr (cdr e)) local)))

(defn env-syntax [(env i64) (name i64)] (-> i64)
  (if (not (is-symbol name))
      (s-false)
    (let [cell (env-cell name env)]
      (if (and (not (val-eq? cell (s-false))) (runtime-syntax? (car cell)))
          (car cell)
        (s-false)))))

(defn runtime-eval [(e i64) (env i64)] (-> i64)
  (if (is-symbol e)
      (env-lookup env e)
      (if (not (is-pair e))
          e
      (let [head (car e)]
        (let [macro (env-syntax env head)]
              (if (not (val-eq? macro (s-false)))
                  (eval-runtime-syntax macro (cdr e) env)
                  (if (name=? head "quote")
                      (stdproc/scm-cadr e)
                      (if (name=? head "if")
                          (eval-if e env)
                          (if (name=? head "begin")
                              (eval-sequence (cdr e) env)
        (if (name=? head "lambda")
            (make-eval-closure (stdproc/scm-cadr e) (cdr (cdr e)) env)
                                  (if (name=? head "define")
                                      (eval-define e env)
                                      (if (name=? head "define-syntax")
                                          (eval-define-syntax e env)
                                          (if (name=? head "let-syntax")
                                              (eval-let-syntax e env false)
                                              (if (name=? head "letrec-syntax")
                                                  (eval-let-syntax e env true)
                                                  (if (name=? head "set!")
                                                      (eval-set e env)
                                                      (if (name=? head "and")
                                                          (eval-and (cdr e) env)
                                                          (if (name=? head "or")
                                                              (eval-or (cdr e) env)
                                                              (if (name=? head "let")
                                                                  (eval-let e env)
                                                                  (if (name=? head "let*")
                                                                      (eval-let-star e env)
                                                                      (if (name=? head "letrec")
                                                                          (eval-letrec e env)
                                                                          (if (name=? head "cond")
                                                                              (eval-cond (cdr e) env)
                                                                              (if (name=? head "case")
                                                                                  (eval-case e env)
                                                                                  (if (name=? head "do")
                                                                                      (eval-do e env)
        (if (name=? head "delay")
                                                                                          (derived2/make-promise (make-eval-closure (s-nil)
                                                                                                                                    (cdr e)
                                                                                                                                    env))
        (if (name=? head "quasiquote")
                                                                                              (eval-quasiquote (stdproc/scm-cadr e)
                                                                                                               env
                                                                                                               1)
                                                                                              (let [proc
                                                                                                      (runtime-eval head
                                                                                                                    env)
                                                                                                    args
                                                                                                      (eval-list (cdr e)
                                                                                                                 env)]
                                                                                                (stdproc/scm-apply-list proc
                                                                                                                        args)))))))))))))))))))))))))))

(defn numeric-fold [(mode i64) (args i64)] (-> i64)
  (if (is-null args)
      (if (= mode 0) (mk-fixnum 0) (mk-fixnum 1))
      (let [first (car args)
            rest (cdr args)]
        (if (and (is-null rest) (= mode 2))
            (scm-sub (mk-fixnum 0) first)
            (if (and (is-null rest) (= mode 3))
                (scm-div (mk-fixnum 1) first)
          (numeric-fold-rest mode first rest))))))
(defn numeric-fold-rest [(mode i64) (acc i64) (rest i64)] (-> i64)
  (if (is-null rest)
      acc
    (numeric-fold-rest mode
      (cond (= mode 0) (scm-add acc (car rest))
            (= mode 1) (scm-mul acc (car rest))
            (= mode 2) (scm-sub acc (car rest))
            :else (scm-div acc (car rest)))
      (cdr rest))))
(defn compare-fold [(mode i64) (args i64)] (-> i64)
  (if (or (is-null args) (is-null (cdr args)))
      (eval-fail c"comparison expects at least two arguments")
      (let [a (car args)
            b (car (cdr args))
            ok
              (cond (= mode 0) (scm-lt a b)
                    (= mode 1) (scm-gt a b)
                    (= mode 2) (scm-le a b)
                    (= mode 3) (scm-ge a b)
                   :else (scm-num-eq a b))]
        (if (not (truthy? ok))
            (s-false)
        (if (is-null (cdr (cdr args))) (s-true) (compare-fold mode (cdr args)))))))
(defn eval-primitive [(op i64) (args i64)] (-> i64)
  (let [n (symbol-name op)]
    (cond (str-eq n "+") (numeric-fold 0 args)
          (str-eq n "*") (numeric-fold 1 args)
          (str-eq n "-") (numeric-fold 2 args)
          (str-eq n "/") (numeric-fold 3 args)
          (str-eq n "<") (compare-fold 0 args)
          (str-eq n ">") (compare-fold 1 args)
          (str-eq n "<=") (compare-fold 2 args)
          (str-eq n ">=") (compare-fold 3 args)
          (str-eq n "=") (compare-fold 4 args)
          (str-eq n "cons") (cons (car args) (car (cdr args)))
          (str-eq n "car") (car (car args))
          (str-eq n "cdr") (cdr (car args))
          (str-eq n "list") args
          (str-eq n "null?") (mk-bool (is-null (car args)))
          (str-eq n "pair?") (mk-bool (is-pair (car args)))
          (str-eq n "number?") (numeric/scm-number? (car args))
          (str-eq n "symbol?") (mk-bool (is-symbol (car args)))
          (str-eq n "boolean?")
            (mk-bool (or (val-eq? (car args) (s-true))
                         (val-eq? (car args) (s-false))))
          (str-eq n "procedure?") (mk-bool (is-procedure (car args)))
          (str-eq n "eq?") (mk-bool (val-eq? (car args) (car (cdr args))))
          (str-eq n "eqv?") (scm-eqv? (car args) (car (cdr args)))
          (str-eq n "equal?") (mk-bool (stdproc/equal--p (car args) (car (cdr args))))
          (str-eq n "not") (mk-bool (not (truthy? (car args))))
          (str-eq n "display") (port/scm-display-args args)
          (str-eq n "write") (port/scm-write-args args)
          (str-eq n "newline") (port/scm-newline-args args)
          (str-eq n "apply") (stdproc/scm-apply-args args)
          (str-eq n "values") (stdproc/scm-values-args args)
          (str-eq n "set-car!") (set-car! (car args) (stdproc/scm-cadr args))
          (str-eq n "set-cdr!") (set-cdr! (car args) (stdproc/scm-cadr args))
          (str-eq n "list?") (stdproc/scm-list? (car args))
          (str-eq n "length") (stdproc/scm-length (car args))
          (str-eq n "reverse") (stdproc/scm-reverse (car args))
          (str-eq n "append") (stdproc/scm-append-args args)
          (str-eq n "list-tail") (stdproc/scm-list-tail (car args) (stdproc/scm-cadr args))
          (str-eq n "list-ref") (stdproc/scm-list-ref (car args) (stdproc/scm-cadr args))
          (str-eq n "memq") (stdproc/scm-memq (car args) (stdproc/scm-cadr args))
          (str-eq n "memv") (stdproc/scm-memv (car args) (stdproc/scm-cadr args))
          (str-eq n "member") (stdproc/scm-member (car args) (stdproc/scm-cadr args))
          (str-eq n "assq") (stdproc/scm-assq (car args) (stdproc/scm-cadr args))
          (str-eq n "assv") (stdproc/scm-assv (car args) (stdproc/scm-cadr args))
          (str-eq n "assoc") (stdproc/scm-assoc (car args) (stdproc/scm-cadr args))
          (str-eq n "map") (stdproc/scm-map-args args)
          (str-eq n "for-each") (stdproc/scm-for-each-args args)
          (str-eq n "call-with-values") (stdproc/scm-call-with-values (car args) (stdproc/scm-cadr args))
          (str-eq n "string?") (stdproc/scm-string? (car args))
          (str-eq n "string") (stdproc/scm-list->string args)
          (str-eq n "make-string") (stdproc/scm-make-string-args args)
          (str-eq n "string-length") (stdproc/scm-string-length (car args))
          (str-eq n "string-ref") (stdproc/scm-string-ref (car args) (stdproc/scm-cadr args))
