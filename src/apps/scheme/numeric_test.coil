(module coil.scheme.numeric-test)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.bignum" :use *)
(import "coil.scheme.core" :use *)
(import "coil.scheme.numeric" :use *)

;; The cases here are the ones R5RS specifies precisely and implementations get
;; wrong quietly: division signs, gcd/lcm on negatives, and the chain comparisons.
;; The happy path is barely tested because it barely fails.

(defn fx [(n i64)] (-> i64) (fixnum-value n))

(deftest zero-divisor-detection-covers-inexact-and-complex-zero
  (assert (core-number-zero? (mk-fixnum 0)))
  (assert (core-number-zero? (mk-flonum 0.0)))
  (assert (core-number-zero? (mk-flonum -0.0)))
  (assert (core-number-zero? (make-complex (mk-fixnum 0) (mk-flonum -0.0))))
  (assert (not (core-number-zero? (mk-fixnum 1))))
  (assert (not (core-number-zero? (make-complex (mk-fixnum 0) (mk-fixnum 1))))))

(deftest rectangular-complex-arithmetic-retains-exact-components
  (let [z (scm-make-rectangular (mk-fixnum 3) (mk-fixnum 4))
        w (scm-make-rectangular (mk-fixnum 1) (mk-fixnum -2))]
    (assert (truthy? (scm-number? z)))
    (assert (truthy? (scm-complex? z)))
    (assert (not (truthy? (scm-real? z))))
    (assert-eq (fx (scm-real-part z)) 3)
    (assert-eq (fx (scm-imag-part z)) 4)
    (let [s (scm-add z (mk-fixnum 2))]
      (assert-eq (fx (scm-real-part s)) 5)
      (assert-eq (fx (scm-imag-part s)) 4))
    (let [p (scm-mul z w)]
      (assert-eq (fx (scm-real-part p)) 11)
      (assert-eq (fx (scm-imag-part p)) -2))
    (let [q (scm-div z w)]
      (assert-eq (fx (scm-real-part q)) -1)
      (assert-eq (fx (scm-imag-part q)) 2))))

(deftest inexact-complex-magnitude-and-division-are-scaled
  (let [huge (make-complex (mk-flonum 1e300) (mk-flonum 1e300))
        huge-den (make-complex (mk-flonum 4e300) (mk-flonum 4e300))
        tiny (make-complex (mk-flonum 1e-300) (mk-flonum 1e-300))
        tiny-den (make-complex (mk-flonum 4e-300) (mk-flonum 4e-300))]
    (let [mag (flonum-value (scm-magnitude huge))]
      (assert (primitive/fcmp-gt mag 1.4e300))
      (assert (primitive/fcmp-lt mag 1.5e300)))
    (let [q (scm-div huge huge-den)]
      (assert (primitive/fcmp-eq (flonum-value (complex-real q)) 0.25))
      (assert (primitive/fcmp-eq (flonum-value (complex-imag q)) 0.0)))
    (let [q (scm-div tiny tiny-den)]
      (assert (primitive/fcmp-eq (flonum-value (complex-real q)) 0.25))
      (assert (primitive/fcmp-eq (flonum-value (complex-imag q)) 0.0)))))

(deftest quotient-truncates-toward-zero
  ; R5RS 6.2.5 — NOT floor division. (quotient -7 2) is -3, not -4.
  (assert-eq (fx (scm-quotient (mk-fixnum 7) (mk-fixnum 2))) 3)
  (assert-eq (fx (scm-quotient (mk-fixnum -7) (mk-fixnum 2))) -3)
  (assert-eq (fx (scm-quotient (mk-fixnum 7) (mk-fixnum -2))) -3)
  (assert-eq (fx (scm-quotient (mk-fixnum -7) (mk-fixnum -2))) 3))

(deftest exact-fixnum-boundaries-promote-instead-of-wrapping
  (let [minimum (mk-fixnum -1152921504606846976)
        q (scm-quotient (mk-fixnum -1152921504606846976) (mk-fixnum -1))
        magnitude (scm-abs minimum)]
    (assert (is-bignum q))
    (assert (is-bignum magnitude))
    (assert-eq (integer-cmp q magnitude) 0)
    (assert-eq (integer-cmp q (big-from-i64 1152921504606846976)) 0)
    (assert-eq (fx (scm-remainder minimum (mk-fixnum -1))) 0)
    (assert-eq (fx (scm-modulo minimum (mk-fixnum -1))) 0)))

(deftest bignum-times-small-fixnum-fast-path-preserves-sign-and-value
  (let [big (integer-from-slice "123456789012345678901234567890" 10)
        want (integer-from-slice "123333332223333333222333333322110" 10)
        negative-want (integer-negate want)]
    (assert-eq (big-length big) (mag-length (big-limbs big)))
    (assert-eq (big-length want) (mag-length (big-limbs want)))
    (assert-eq (integer-cmp (integer-mul big (mk-fixnum 999)) want) 0)
    (assert-eq (integer-cmp (integer-mul (mk-fixnum 999) big) want) 0)
    (assert-eq (integer-cmp (integer-mul big (mk-fixnum -999)) negative-want) 0)
    (assert-eq (fixnum-value (integer-mul big (mk-fixnum 0))) 0)))

(deftest remainder-takes-sign-of-dividend
  (assert-eq (fx (scm-remainder (mk-fixnum 7) (mk-fixnum 2))) 1)
  (assert-eq (fx (scm-remainder (mk-fixnum -7) (mk-fixnum 2))) -1)
  (assert-eq (fx (scm-remainder (mk-fixnum 7) (mk-fixnum -2))) 1)
  (assert-eq (fx (scm-remainder (mk-fixnum -7) (mk-fixnum -2))) -1)
  ; exact division leaves zero, with no sign to get wrong
  (assert-eq (fx (scm-remainder (mk-fixnum -4) (mk-fixnum 2))) 0))

(deftest modulo-takes-sign-of-divisor
  ; the pair 08-numbers turns on: (modulo -7 2) = 1 while (remainder -7 2) = -1
  (assert-eq (fx (scm-modulo (mk-fixnum -7) (mk-fixnum 2))) 1)
  (assert-eq (fx (scm-modulo (mk-fixnum 7) (mk-fixnum 2))) 1)
  (assert-eq (fx (scm-modulo (mk-fixnum 7) (mk-fixnum -2))) -1)
  (assert-eq (fx (scm-modulo (mk-fixnum -7) (mk-fixnum -2))) -1)
  ; a zero remainder must NOT be shifted by the divisor
  (assert-eq (fx (scm-modulo (mk-fixnum -4) (mk-fixnum 2))) 0)
  (assert-eq (fx (scm-modulo (mk-fixnum 4) (mk-fixnum -2))) 0)
  ; R5RS's own examples
  (assert-eq (fx (scm-modulo (mk-fixnum 13) (mk-fixnum 4))) 1)
  (assert-eq (fx (scm-modulo (mk-fixnum -13) (mk-fixnum 4))) 3)
  (assert-eq (fx (scm-modulo (mk-fixnum 13) (mk-fixnum -4))) -3)
  (assert-eq (fx (scm-modulo (mk-fixnum -13) (mk-fixnum -4))) -1))

(deftest abs-max-min
  (assert-eq (fx (scm-abs (mk-fixnum -4))) 4)
  (assert-eq (fx (scm-abs (mk-fixnum 4))) 4)
  (assert-eq (fx (scm-abs (mk-fixnum 0))) 0)
  (assert-eq (fx (scm-max (mk-fixnum 1) (mk-fixnum 2) (mk-fixnum 3))) 3)
  (assert-eq (fx (scm-min (mk-fixnum 1) (mk-fixnum 2) (mk-fixnum 3))) 1)
  ; variadic past three, and with the extremum in the middle
  (assert-eq (fx (scm-max (mk-fixnum 1) (mk-fixnum 9) (mk-fixnum 3) (mk-fixnum 2))) 9)
  (assert-eq (fx (scm-min (mk-fixnum 4) (mk-fixnum -9) (mk-fixnum 3))) -9)
  ; one argument is legal and is its own answer
  (assert-eq (fx (scm-max (mk-fixnum 5))) 5))

(deftest gcd-lcm-use-absolute-values
  ; R5RS: the result is non-negative whatever the argument signs.
  ; (gcd 32 -36) = 4 and (lcm 32 -36) = 288, both positive.
  (assert-eq (fx (scm-gcd (mk-fixnum 32) (mk-fixnum -36))) 4)
  (assert-eq (fx (scm-lcm (mk-fixnum 32) (mk-fixnum -36))) 288)
  (assert-eq (fx (scm-gcd (mk-fixnum -32) (mk-fixnum -36))) 4)
  (assert-eq (fx (scm-lcm (mk-fixnum -32) (mk-fixnum 36))) 288)
  ; identities: (gcd) = 0, (lcm) = 1
  (assert-eq (fx (scm-gcd)) 0)
  (assert-eq (fx (scm-lcm)) 1)
  ; a single argument is its magnitude
  (assert-eq (fx (scm-gcd (mk-fixnum -7))) 7)
  ; zero is the gcd identity and the lcm annihilator
  (assert-eq (fx (scm-gcd (mk-fixnum 0) (mk-fixnum 5))) 5)
  (assert-eq (fx (scm-lcm (mk-fixnum 0) (mk-fixnum 5))) 0)
  ; variadic
  (assert-eq (fx (scm-gcd (mk-fixnum 12) (mk-fixnum 18) (mk-fixnum 24))) 6)
  (assert-eq (fx (scm-lcm (mk-fixnum 2) (mk-fixnum 3) (mk-fixnum 4))) 12))

(deftest expt-fixnum-range
  (assert-eq (fx (scm-expt (mk-fixnum 2) (mk-fixnum 10))) 1024)
  (assert-eq (fx (scm-expt (mk-fixnum 2) (mk-fixnum 0))) 1)
  (assert-eq (fx (scm-expt (mk-fixnum 5) (mk-fixnum 3))) 125)
  ; odd exponents take the multiply branch of square-and-multiply
  (assert-eq (fx (scm-expt (mk-fixnum 3) (mk-fixnum 5))) 243)
  ; a negative base keeps its sign only on odd exponents
  (assert-eq (fx (scm-expt (mk-fixnum -2) (mk-fixnum 3))) -8)
  (assert-eq (fx (scm-expt (mk-fixnum -2) (mk-fixnum 4))) 16)
  (assert (primitive/fcmp-eq
            (flonum-value (scm-expt (mk-flonum 0.0) (mk-flonum 1.0))) 0.0))
  (assert (primitive/fcmp-eq
            (flonum-value (scm-expt (mk-fixnum -25) (mk-flonum 0.0))) 1.0)))

(deftest predicates
  (assert (truthy? (scm-zero? (mk-fixnum 0))))
  (assert (not (truthy? (scm-zero? (mk-fixnum 1)))))
  (assert (truthy? (scm-positive? (mk-fixnum 3))))
  (assert (not (truthy? (scm-positive? (mk-fixnum 0)))))
  (assert (truthy? (scm-negative? (mk-fixnum -3))))
  (assert (not (truthy? (scm-negative? (mk-fixnum 0)))))
  ; odd?/even? on negatives: C's % gives -1 for (% -3 2), so a test against 1
  ; would answer wrongly here
  (assert (truthy? (scm-odd? (mk-fixnum -3))))
  (assert (truthy? (scm-even? (mk-fixnum -4))))
  (assert (truthy? (scm-even? (mk-fixnum 0))))
  (assert (not (truthy? (scm-odd? (mk-fixnum -4)))))
  ; number? is false for non-numbers, which is the point of asking
  (assert (truthy? (scm-number? (mk-fixnum 1))))
  (assert (not (truthy? (scm-number? (s-nil)))))
  (assert (not (truthy? (scm-number? (s-true)))))
  (assert (not (truthy? (scm-number? (mk-char 65)))))
  (assert (truthy? (scm-integer? (mk-fixnum 1))))
  ; every fixnum is exact, and nothing here is inexact
  (assert (truthy? (scm-exact? (mk-fixnum 1))))
  (assert (not (truthy? (scm-inexact? (mk-fixnum 1))))))

(deftest inexact-integer-and-rounding-work-beyond-i64-range
  (let [huge (mk-flonum 1e300)
        negative-zero (mk-flonum-bits -9223372036854775808)]
    (assert (truthy? (scm-integer? huge)))
    (assert (primitive/fcmp-eq (flonum-value (scm-floor huge)) 1e300))
    (assert (primitive/fcmp-eq (flonum-value (scm-ceiling huge)) 1e300))
    (assert (primitive/fcmp-eq (flonum-value (scm-truncate huge)) 1e300))
    (assert (primitive/fcmp-eq (flonum-value (scm-round huge)) 1e300))
    ; IEEE negative zero is an integer and rounding must retain its sign bit.
    (assert (truthy? (scm-integer? negative-zero)))
    (assert-eq (f64->raw-bits (flonum-value (scm-truncate negative-zero)))
               -9223372036854775808)))

(deftest mixed-bignum-flonum-comparisons-do-not-round-the-exact-side
  (let [rounded (mk-flonum 1.4272476927059599e45)
        equal (integer-from-slice "1427247692705959881058285969449495136382746624" 10)
        above (integer-add equal (mk-fixnum 1))
        below (integer-sub equal (mk-fixnum 1))]
    (assert (truthy? (scm-num-eq equal rounded)))
    (assert (not (truthy? (scm-num-eq above rounded))))
    (assert (truthy? (scm-lt below rounded)))
    (assert (truthy? (scm-lt rounded above)))
    (assert (truthy? (scm-le equal rounded)))
    (assert (truthy? (scm-ge rounded equal)))))

(deftest chain-comparisons
  ; two-argument base case
  (assert (truthy? (scm-num-lt (mk-fixnum 1) (mk-fixnum 2))))
  (assert (not (truthy? (scm-num-lt (mk-fixnum 2) (mk-fixnum 1)))))
  ; three or more compares ADJACENT pairs, and every pair must hold
  (assert (truthy? (scm-num-lt (mk-fixnum 1) (mk-fixnum 2) (mk-fixnum 3))))
  (assert (not (truthy? (scm-num-lt (mk-fixnum 1) (mk-fixnum 3) (mk-fixnum 2)))))
  ; the trap: 1<3 and 1<9 both hold, so a chain that only compares against the
  ; FIRST argument would wrongly say true here
  (assert (not (truthy? (scm-num-lt (mk-fixnum 1) (mk-fixnum 3) (mk-fixnum 2) (mk-fixnum 9)))))
  (assert (truthy? (scm-num-gt (mk-fixnum 3) (mk-fixnum 2) (mk-fixnum 1))))
  (assert (not (truthy? (scm-num-gt (mk-fixnum 3) (mk-fixnum 1) (mk-fixnum 2)))))
  ; <= and >= admit equality where < and > do not
  (assert (truthy? (scm-num-le (mk-fixnum 1) (mk-fixnum 1) (mk-fixnum 2))))
  (assert (not (truthy? (scm-num-lt (mk-fixnum 1) (mk-fixnum 1) (mk-fixnum 2)))))
  (assert (truthy? (scm-num-ge (mk-fixnum 2) (mk-fixnum 2) (mk-fixnum 1))))
  (assert (truthy? (scm-num-eqv (mk-fixnum 2) (mk-fixnum 2) (mk-fixnum 2))))
  (assert (not (truthy? (scm-num-eqv (mk-fixnum 2) (mk-fixnum 2) (mk-fixnum 3)))))
  ; negatives, where an unsigned comparison would flip the answer
  (assert (truthy? (scm-num-lt (mk-fixnum -5) (mk-fixnum -1) (mk-fixnum 0)))))

;; A middle argument of a chain appears in two comparisons. If the expansion
;; duplicated the expression instead of binding it, this counter would tick twice.
(defn ntimes [] (-> (ptr i64)) (alloc/static i64))
(defn bump [(n i64)] (-> i64)
  (primitive/store! (ntimes) (+ (primitive/load (ntimes)) 1))
  (mk-fixnum n))

(deftest chain-evaluates-each-argument-once
  (primitive/store! (ntimes) 0)
  (assert (truthy? (scm-num-lt (bump 1) (bump 2) (bump 3))))
  (assert-eq (primitive/load (ntimes)) 3))

(deftest number-to-string
  (assert (str-eq (string-slice (scm-number->string1 (mk-fixnum 255))) "255"))
  (assert (str-eq (string-slice (scm-number->string1 (mk-fixnum 0))) "0"))
  (assert (str-eq (string-slice (scm-number->string1 (mk-fixnum -42))) "-42"))
  ; radix 16 — R5RS leaves the digit CASE unspecified; this emits lowercase
  (assert (str-eq (string-slice (scm-number->string2 (mk-fixnum 255) (mk-fixnum 16))) "ff"))
  (assert (str-eq (string-slice (scm-number->string2 (mk-fixnum 8) (mk-fixnum 2))) "1000"))
  (assert (str-eq (string-slice (scm-number->string2 (mk-fixnum 255) (mk-fixnum 8))) "377"))
  (assert (str-eq (string-slice (scm-number->string2 (mk-fixnum -255) (mk-fixnum 16))) "-ff"))
  ; the macro form defaults the radix to 10
  (assert (str-eq (string-slice (number->string (mk-fixnum 99))) "99"))
  (assert (str-eq (string-slice (number->string (mk-fixnum 255) (mk-fixnum 16))) "ff")))

(deftest string-to-number
  (assert-eq (fx (str->num "255" 10)) 255)
  (assert-eq (fx (str->num "-42" 10)) -42)
  (assert-eq (fx (str->num "+42" 10)) 42)
  (assert-eq (fx (str->num "0" 10)) 0)
  ; radix 16, both cases accepted because the writer's case is unspecified
  (assert-eq (fx (str->num "ff" 16)) 255)
  (assert-eq (fx (str->num "FF" 16)) 255)
  (assert-eq (fx (str->num "1000" 2)) 8)
  ; R5RS: #f, not an error and not 0, when the string is not a number
  (assert (not (truthy? (str->num "abc" 10))))
  (assert (not (truthy? (str->num "" 10))))
  (assert (not (truthy? (str->num "-" 10))))
  ; R5RS complex units require an explicit sign. Bare `i` is an identifier,
  ; while +i and -i are the exact imaginary numbers used by complex syntax.
  (assert (val-eq? (parse-number-slice "i" 10) (s-false)))
  (assert (val-eq? (parse-number-slice "3i" 10) (s-false)))
  (let [positive-i (parse-number-slice "+i" 10)
        negative-i (parse-number-slice "-i" 10)]
    (assert (is-complex-number positive-i))
    (assert-eq (fixnum-value (complex-imag positive-i)) 1)
    (assert-eq (fixnum-value (complex-imag negative-i)) -1))
  ; trailing junk must fail the WHOLE parse rather than stopping early at 12
  (assert (not (truthy? (str->num "12x" 10))))
  ; a digit outside the radix is not a digit: 'f' is junk in base 10, '9' in base 8
  (assert (not (truthy? (str->num "ff" 10))))
  (assert (not (truthy? (str->num "9" 8))))
  ; round trip through both directions
  (assert-eq (fx (scm-string->number2 (scm-number->string2 (mk-fixnum 48879) (mk-fixnum 16))
                                      (mk-fixnum 16)))
             48879))

(deftest explicit-exact-decimals-never-round-through-binary64
  (let [tenth (parse-prefixed-number-slice "#e0.1")]
    (assert (is-ratnum tenth))
    (assert-eq (fx (ratnum-numerator-val tenth)) 1)
    (assert-eq (fx (ratnum-denominator-val tenth)) 10))
  (let [z (parse-prefixed-number-slice "#e0.1+0.2i")]
    (assert (is-complex-number z))
    (assert (truthy? (scm-exact? z)))
    (assert (truthy? (scm-num-eq (complex-real z) (make-rational (mk-fixnum 1) (mk-fixnum 10)))))
    (assert (truthy? (scm-num-eq (complex-imag z) (make-rational (mk-fixnum 1) (mk-fixnum 5))))))
  (assert (val-eq? (parse-prefixed-number-slice "#e1@1") (s-false))))

; ---- syntax-rules -----------------------------------------------------------
;; Each macro below is a one-line forwarder to `syntax-rules-expand` — the shape a
;; user writes, because `define-syntax` cannot install a new keyword (see the
;; module notes). The pattern language itself is what is under test, and the four
;; cases are the traps 07-syntax-rules encodes.

;; my-or: R5RS's own example, and the hygiene trap. The template binds `t`.
;; `let` cannot appear in a template: the matcher rebuilds every sequence as a
;; LIST, so Coil's binding VECTOR would come back as `(t e)` and the parser would
;; reject its own form. Templates therefore bind through this helper, which
;; rebuilds the vector on the far side of the expansion.
(defn sr-test--let1 [(n Code) (v Code) (body Code)] (-> Code)
  `(let [~n ~v] ~body))

(defn my-or [& (args Code)] (-> Code)
  (syntax-rules-expand
    `(syntax-rules ()
       ((_) (s-false))
       ((_ e) e)
       ((_ e r ...) (sr-test--let1 t e (if (truthy? t) t (my-or r ...)))))
    args))

(defn sr-do-shape [& (args Code)] (-> Code)
  (syntax-rules-expand
    `(syntax-rules ()
       ((_ ((variable init step) ...) (test expression ...) command ...)
        (mk-fixnum 42)))
    args))

(deftest syntax-rules-matches-do-report-shape
  (assert-eq (fx (sr-do-shape ((i 0 (+ i 1)) (acc 0 (+ acc i)))
                              ((= i 5) acc)))
             42))

(defn sr-test--vector-result [(v Code)] (-> Code)
  (if (not (primitive/code-vector? v))
      (primitive/error "syntax-rules vector template lost its vector shape")
    `(mk-fixnum ~(primitive/code-count v))))

(defn sr-vector-copy [& (args Code)] (-> Code)
  (syntax-rules-expand
    `(syntax-rules ()
       ((_ #(x ...)) (sr-test--vector-result #(x ...))))
    args))

(deftest syntax-rules-matches-and-builds-vectors
  (assert-eq (fx (sr-vector-copy #((mk-fixnum 1) (mk-fixnum 2) (mk-fixnum 3)))) 3)
  (assert-eq (fx (sr-vector-copy #())) 0))

(defn sr-test--nested-result [(rows Code)] (-> Code)
  `(mk-fixnum ~(+ (* (primitive/code-count rows) 100)
                  (+ (* (primitive/code-count (primitive/code-nth rows 0)) 10)
                     (primitive/code-count (primitive/code-nth rows 1))))))

(defn sr-nested-copy [& (args Code)] (-> Code)
  (syntax-rules-expand
    `(syntax-rules ()
       ((_ ((x ...) ...)) (sr-test--nested-result ((x ...) ...))))
    args))

(deftest syntax-rules-preserves-two-ellipsis-depths
  (assert-eq (fx (sr-nested-copy (((mk-fixnum 1) (mk-fixnum 2))
                                  ((mk-fixnum 3)))))
             221))

(deftest syntax-rules-selects-rule-by-arity
  ; zero, one and many arguments must select the three different rules, in order
  (assert (not (truthy? (my-or))))
  (assert-eq (fx (my-or (mk-fixnum 5))) 5)
  (assert-eq (fx (my-or (s-false) (mk-fixnum 7))) 7)
  ; the recursive rule, three deep
  (assert-eq (fx (my-or (s-false) (s-false) (mk-fixnum 9))) 9)
  ; and it returns the VALUE that decided the result, not a boolean
  (assert-eq (fx (my-or (mk-fixnum 3) (mk-fixnum 4))) 3))

(deftest syntax-rules-hygiene-template-binding
  ; 07's my-or trap. The user has a `t`, and the template binds its own `t`
  ; around the expansion of the SECOND argument. If the template's binding
  ; captured, `t` here would read #f and the answer would be #f.
  (let [t (mk-fixnum 99)]
    (assert-eq (fx (my-or (s-false) t)) 99))
  ; the same trap where the user's value is what the template's temporary held
  (let [t (mk-fixnum 1)]
    (assert-eq (fx (my-or (s-false) t)) 1)))

;; swap!: the other hygiene trap. The template introduces `tmp`, and the caller
;; passes a variable actually NAMED tmp.
(defn swap! [& (args Code)] (-> Code)
  (syntax-rules-expand
    `(syntax-rules ()
       ((_ a b) (sr-test--let1 tmp (primitive/load (mut a))
                  (do (primitive/store! (mut a) (primitive/load (mut b)))
                      (primitive/store! (mut b) tmp)))))
    args))

(deftest syntax-rules-hygiene-swap
  ; 07 line 5 exactly: the user's variable is named `tmp`, the same name the
  ; template introduces. A capturing expansion leaves both variables equal.
  (let [(mut tmp) (mk-fixnum 1)
        (mut other) (mk-fixnum 2)]
    (swap! tmp other)
    (assert-eq (fx (primitive/load (mut tmp))) 2)
    (assert-eq (fx (primitive/load (mut other))) 1)))

;; my-let: nested ellipsis. `((n v) ...)` gathers TWO columns from one ellipsis
;; and the template re-emits them in two different positions.
(defn my-let [& (args Code)] (-> Code)
  (syntax-rules-expand
    `(syntax-rules () ((_ ((n v) ...) body ...) (sr-test--bind (n ...) (v ...) body ...)))
    args))

;; The template's target. Coil has no immediately-applied lambda over Val, so the
;; `((lambda (n ...) body ...) v ...)` of 07 is spelled as a `let` over the two
;; columns — the transposition is what is under test, not the application form.
(defn sr-test--bind [& (parts Code)] (-> Code)
  (let [names (primitive/code-nth parts 0)
        vals (primitive/code-nth parts 1)]
    `(let ~(sr-test--zip names vals 0 (primitive/code-count names))
           ~@(num--rest parts 2 (primitive/code-count parts)))))

;; Coil's `let` takes a flat binding VECTOR `[n v n v]`, not Scheme's list of
;; pairs — this module is ordinary Coil, so the dialect rewrite does not run here.
(defn sr-test--zip [(ns Code) (vs Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `[]
    `[~(primitive/code-nth ns i) ~(primitive/code-nth vs i)
      ~@(sr-test--zip ns vs (+ i 1) n)]))

(deftest syntax-rules-nested-ellipsis
  ; 07 line 13: one ellipsis over a PAIR sub-pattern, emitted as two sequences
  (assert-eq (fx (my-let ((a (mk-fixnum 1)) (b (mk-fixnum 2))) (scm-add a b))) 3)
  ; three bindings, and a multi-form body — `body ...` is its own ellipsis
  (assert-eq (fx (my-let ((a (mk-fixnum 1)) (b (mk-fixnum 2)) (c (mk-fixnum 4)))
                   (scm-add a (mk-fixnum 0))
                   (scm-add a (scm-add b c))))
             7)
  ; a single binding still goes through the ellipsis path
  (assert-eq (fx (my-let ((a (mk-fixnum 5))) a)) 5))

;; tail-pattern: an ellipsis followed by a FIXED trailing pattern, which forces
;; the matcher to reserve the tail from the end before consuming.
(defn tail-pattern [& (args Code)] (-> Code)
  (syntax-rules-expand
    `(syntax-rules () ((_ a ... last) (sr-test--count (a ...) last)))
    args))

;; Reports how many elements the ellipsis took, paired with what `last` matched.
(defn sr-test--count [(as Code) (last Code)] (-> Code)
  `(scm-cons (mk-fixnum ~(primitive/code-count as)) ~last))

(deftest syntax-rules-trailing-fixed-pattern
  ; 07 line 16: `a ...` must take (1 2) and `last` must take 3. A greedy ellipsis
  ; swallows all three and leaves `last` with nothing to match.
  (let [r (tail-pattern (mk-fixnum 1) (mk-fixnum 2) (mk-fixnum 3))]
    (assert-eq (fx (scm-car r)) 2)
    (assert-eq (fx (scm-cdr r)) 3))
  ; one argument: the ellipsis matches ZERO times and `last` still binds — the
  ; case where the reserved tail is the entire input
  (let [r (tail-pattern (mk-fixnum 9))]
    (assert-eq (fx (scm-car r)) 0)
    (assert-eq (fx (scm-cdr r)) 9))
  ; five arguments: four to the ellipsis, one to the tail
  (let [r (tail-pattern (mk-fixnum 1) (mk-fixnum 2) (mk-fixnum 3)
                        (mk-fixnum 4) (mk-fixnum 8))]
    (assert-eq (fx (scm-car r)) 4)
    (assert-eq (fx (scm-cdr r)) 8)))

;; The literal rule: a symbol named in the literals list matches only ITSELF,
;; where an ordinary pattern variable would match anything.
(defn with-else [& (args Code)] (-> Code)
  (syntax-rules-expand
    `(syntax-rules (else)
       ((_ else v) (scm-cons (mk-fixnum 1) v))    ; the keyword form
       ((_ x v) (scm-cons (mk-fixnum 0) v)))      ; anything else
    args))

(deftest syntax-rules-literals
  ; `else` in the input hits the first rule; another symbol falls through to the
  ; second, even though a bare pattern variable would have matched both
  (let [r (with-else else (mk-fixnum 7))]
    (assert-eq (fx (scm-car r)) 1)
    (assert-eq (fx (scm-cdr r)) 7))
  (let [r (with-else notelse (mk-fixnum 7))]
    (assert-eq (fx (scm-car r)) 0)))

;; `_` matches without binding, so it can appear twice in one pattern where a
;; repeated variable could not.
(defn take-middle [& (args Code)] (-> Code)
  (syntax-rules-expand
    `(syntax-rules () ((_ _ m _) m))
    args))

(deftest syntax-rules-underscore
  (assert-eq (fx (take-middle (mk-fixnum 1) (mk-fixnum 2) (mk-fixnum 3))) 2))
