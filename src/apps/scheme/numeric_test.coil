(module coil.scheme.numeric-test)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.numeric" :use *)

;; The cases here are the ones R5RS specifies precisely and implementations get
;; wrong quietly: division signs, gcd/lcm on negatives, and the chain comparisons.
;; The happy path is barely tested because it barely fails.

(defn fx [(n i64)] (-> i64) (fixnum-value n))

(deftest quotient-truncates-toward-zero
  ; R5RS 6.2.5 — NOT floor division. (quotient -7 2) is -3, not -4.
  (assert-eq (fx (scm-quotient (mk-fixnum 7) (mk-fixnum 2))) 3)
  (assert-eq (fx (scm-quotient (mk-fixnum -7) (mk-fixnum 2))) -3)
  (assert-eq (fx (scm-quotient (mk-fixnum 7) (mk-fixnum -2))) -3)
  (assert-eq (fx (scm-quotient (mk-fixnum -7) (mk-fixnum -2))) 3))

(deftest remainder-takes-sign-of-dividend
  (assert-eq (fx (scm-remainder (mk-fixnum 7) (mk-fixnum 2))) 1)
  (assert-eq (fx (scm-remainder (mk-fixnum -7) (mk-fixnum 2))) -1)
  (assert-eq (fx (scm-remainder (mk-fixnum 7) (mk-fixnum -2))) 1)
  (assert-eq (fx (scm-remainder (mk-fixnum -7) (mk-fixnum -2))) -1)
  ; exact division leaves zero, with no sign to get wrong
  (assert-eq (fx (scm-remainder (mk-fixnum -4) (mk-fixnum 2))) 0))

(deftest modulo-takes-sign-of-divisor
  ; the pair 08-numbers turns on: (modulo -7 2) = 1 while (remainder -7 2) = -1
  (assert-eq (fx (scm-modulo (mk-fixnum -7) (mk-fixnum 2))) 1)
  (assert-eq (fx (scm-modulo (mk-fixnum 7) (mk-fixnum 2))) 1)
  (assert-eq (fx (scm-modulo (mk-fixnum 7) (mk-fixnum -2))) -1)
  (assert-eq (fx (scm-modulo (mk-fixnum -7) (mk-fixnum -2))) -1)
  ; a zero remainder must NOT be shifted by the divisor
  (assert-eq (fx (scm-modulo (mk-fixnum -4) (mk-fixnum 2))) 0)
  (assert-eq (fx (scm-modulo (mk-fixnum 4) (mk-fixnum -2))) 0)
  ; R5RS's own examples
  (assert-eq (fx (scm-modulo (mk-fixnum 13) (mk-fixnum 4))) 1)
  (assert-eq (fx (scm-modulo (mk-fixnum -13) (mk-fixnum 4))) 3)
  (assert-eq (fx (scm-modulo (mk-fixnum 13) (mk-fixnum -4))) -3)
  (assert-eq (fx (scm-modulo (mk-fixnum -13) (mk-fixnum -4))) -1))

(deftest abs-max-min
  (assert-eq (fx (scm-abs (mk-fixnum -4))) 4)
  (assert-eq (fx (scm-abs (mk-fixnum 4))) 4)
  (assert-eq (fx (scm-abs (mk-fixnum 0))) 0)
  (assert-eq (fx (scm-max (mk-fixnum 1) (mk-fixnum 2) (mk-fixnum 3))) 3)
  (assert-eq (fx (scm-min (mk-fixnum 1) (mk-fixnum 2) (mk-fixnum 3))) 1)
  ; variadic past three, and with the extremum in the middle
  (assert-eq (fx (scm-max (mk-fixnum 1) (mk-fixnum 9) (mk-fixnum 3) (mk-fixnum 2))) 9)
  (assert-eq (fx (scm-min (mk-fixnum 4) (mk-fixnum -9) (mk-fixnum 3))) -9)
  ; one argument is legal and is its own answer
  (assert-eq (fx (scm-max (mk-fixnum 5))) 5))

(deftest gcd-lcm-use-absolute-values
  ; R5RS: the result is non-negative whatever the argument signs.
  ; (gcd 32 -36) = 4 and (lcm 32 -36) = 288, both positive.
  (assert-eq (fx (scm-gcd (mk-fixnum 32) (mk-fixnum -36))) 4)
  (assert-eq (fx (scm-lcm (mk-fixnum 32) (mk-fixnum -36))) 288)
  (assert-eq (fx (scm-gcd (mk-fixnum -32) (mk-fixnum -36))) 4)
  (assert-eq (fx (scm-lcm (mk-fixnum -32) (mk-fixnum 36))) 288)
  ; identities: (gcd) = 0, (lcm) = 1
  (assert-eq (fx (scm-gcd)) 0)
  (assert-eq (fx (scm-lcm)) 1)
  ; a single argument is its magnitude
  (assert-eq (fx (scm-gcd (mk-fixnum -7))) 7)
  ; zero is the gcd identity and the lcm annihilator
  (assert-eq (fx (scm-gcd (mk-fixnum 0) (mk-fixnum 5))) 5)
  (assert-eq (fx (scm-lcm (mk-fixnum 0) (mk-fixnum 5))) 0)
  ; variadic
  (assert-eq (fx (scm-gcd (mk-fixnum 12) (mk-fixnum 18) (mk-fixnum 24))) 6)
  (assert-eq (fx (scm-lcm (mk-fixnum 2) (mk-fixnum 3) (mk-fixnum 4))) 12))

(deftest expt-fixnum-range
  (assert-eq (fx (scm-expt (mk-fixnum 2) (mk-fixnum 10))) 1024)
  (assert-eq (fx (scm-expt (mk-fixnum 2) (mk-fixnum 0))) 1)
  (assert-eq (fx (scm-expt (mk-fixnum 5) (mk-fixnum 3))) 125)
  ; odd exponents take the multiply branch of square-and-multiply
  (assert-eq (fx (scm-expt (mk-fixnum 3) (mk-fixnum 5))) 243)
  ; a negative base keeps its sign only on odd exponents
  (assert-eq (fx (scm-expt (mk-fixnum -2) (mk-fixnum 3))) -8)
  (assert-eq (fx (scm-expt (mk-fixnum -2) (mk-fixnum 4))) 16))

(deftest predicates
  (assert (truthy? (scm-zero? (mk-fixnum 0))))
  (assert (not (truthy? (scm-zero? (mk-fixnum 1)))))
  (assert (truthy? (scm-positive? (mk-fixnum 3))))
  (assert (not (truthy? (scm-positive? (mk-fixnum 0)))))
  (assert (truthy? (scm-negative? (mk-fixnum -3))))
  (assert (not (truthy? (scm-negative? (mk-fixnum 0)))))
  ; odd?/even? on negatives: C's % gives -1 for (% -3 2), so a test against 1
  ; would answer wrongly here
  (assert (truthy? (scm-odd? (mk-fixnum -3))))
  (assert (truthy? (scm-even? (mk-fixnum -4))))
  (assert (truthy? (scm-even? (mk-fixnum 0))))
  (assert (not (truthy? (scm-odd? (mk-fixnum -4)))))
  ; number? is false for non-numbers, which is the point of asking
  (assert (truthy? (scm-number? (mk-fixnum 1))))
  (assert (not (truthy? (scm-number? (s-nil)))))
  (assert (not (truthy? (scm-number? (s-true)))))
  (assert (not (truthy? (scm-number? (mk-char 65)))))
  (assert (truthy? (scm-integer? (mk-fixnum 1))))
  ; every fixnum is exact, and nothing here is inexact
  (assert (truthy? (scm-exact? (mk-fixnum 1))))
  (assert (not (truthy? (scm-inexact? (mk-fixnum 1))))))

(deftest chain-comparisons
  ; two-argument base case
  (assert (truthy? (scm-num-lt (mk-fixnum 1) (mk-fixnum 2))))
  (assert (not (truthy? (scm-num-lt (mk-fixnum 2) (mk-fixnum 1)))))
  ; three or more compares ADJACENT pairs, and every pair must hold
  (assert (truthy? (scm-num-lt (mk-fixnum 1) (mk-fixnum 2) (mk-fixnum 3))))
  (assert (not (truthy? (scm-num-lt (mk-fixnum 1) (mk-fixnum 3) (mk-fixnum 2)))))
  ; the trap: 1<3 and 1<9 both hold, so a chain that only compares against the
  ; FIRST argument would wrongly say true here
  (assert (not (truthy? (scm-num-lt (mk-fixnum 1) (mk-fixnum 3) (mk-fixnum 2) (mk-fixnum 9)))))
  (assert (truthy? (scm-num-gt (mk-fixnum 3) (mk-fixnum 2) (mk-fixnum 1))))
  (assert (not (truthy? (scm-num-gt (mk-fixnum 3) (mk-fixnum 1) (mk-fixnum 2)))))
  ; <= and >= admit equality where < and > do not
  (assert (truthy? (scm-num-le (mk-fixnum 1) (mk-fixnum 1) (mk-fixnum 2))))
  (assert (not (truthy? (scm-num-lt (mk-fixnum 1) (mk-fixnum 1) (mk-fixnum 2)))))
  (assert (truthy? (scm-num-ge (mk-fixnum 2) (mk-fixnum 2) (mk-fixnum 1))))
  (assert (truthy? (scm-num-eqv (mk-fixnum 2) (mk-fixnum 2) (mk-fixnum 2))))
  (assert (not (truthy? (scm-num-eqv (mk-fixnum 2) (mk-fixnum 2) (mk-fixnum 3)))))
  ; negatives, where an unsigned comparison would flip the answer
  (assert (truthy? (scm-num-lt (mk-fixnum -5) (mk-fixnum -1) (mk-fixnum 0)))))

;; A middle argument of a chain appears in two comparisons. If the expansion
;; duplicated the expression instead of binding it, this counter would tick twice.
(defn ntimes [] (-> (ptr i64)) (alloc/static i64))
(defn bump [(n i64)] (-> i64)
  (primitive/store! (ntimes) (+ (primitive/load (ntimes)) 1))
  (mk-fixnum n))

(deftest chain-evaluates-each-argument-once
  (primitive/store! (ntimes) 0)
  (assert (truthy? (scm-num-lt (bump 1) (bump 2) (bump 3))))
  (assert-eq (primitive/load (ntimes)) 3))

(deftest number-to-string
  (assert (str-eq (string-slice (scm-number->string1 (mk-fixnum 255))) "255"))
  (assert (str-eq (string-slice (scm-number->string1 (mk-fixnum 0))) "0"))
  (assert (str-eq (string-slice (scm-number->string1 (mk-fixnum -42))) "-42"))
  ; radix 16 — R5RS leaves the digit CASE unspecified; this emits lowercase
  (assert (str-eq (string-slice (scm-number->string2 (mk-fixnum 255) (mk-fixnum 16))) "ff"))
  (assert (str-eq (string-slice (scm-number->string2 (mk-fixnum 8) (mk-fixnum 2))) "1000"))
  (assert (str-eq (string-slice (scm-number->string2 (mk-fixnum 255) (mk-fixnum 8))) "377"))
  (assert (str-eq (string-slice (scm-number->string2 (mk-fixnum -255) (mk-fixnum 16))) "-ff"))
  ; the macro form defaults the radix to 10
  (assert (str-eq (string-slice (number->string (mk-fixnum 99))) "99"))
  (assert (str-eq (string-slice (number->string (mk-fixnum 255) (mk-fixnum 16))) "ff")))

(deftest string-to-number
  (assert-eq (fx (str->num "255" 10)) 255)
  (assert-eq (fx (str->num "-42" 10)) -42)
  (assert-eq (fx (str->num "+42" 10)) 42)
  (assert-eq (fx (str->num "0" 10)) 0)
  ; radix 16, both cases accepted because the writer's case is unspecified
  (assert-eq (fx (str->num "ff" 16)) 255)
  (assert-eq (fx (str->num "FF" 16)) 255)
  (assert-eq (fx (str->num "1000" 2)) 8)
  ; R5RS: #f, not an error and not 0, when the string is not a number
  (assert (not (truthy? (str->num "abc" 10))))
  (assert (not (truthy? (str->num "" 10))))
  (assert (not (truthy? (str->num "-" 10))))
  ; trailing junk must fail the WHOLE parse rather than stopping early at 12
  (assert (not (truthy? (str->num "12x" 10))))
  ; a digit outside the radix is not a digit: 'f' is junk in base 10, '9' in base 8
  (assert (not (truthy? (str->num "ff" 10))))
  (assert (not (truthy? (str->num "9" 8))))
  ; round trip through both directions
  (assert-eq (fx (scm-string->number2 (scm-number->string2 (mk-fixnum 48879) (mk-fixnum 16))
                                      (mk-fixnum 16)))
             48879))
