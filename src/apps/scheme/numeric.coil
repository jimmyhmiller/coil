(module coil.scheme.numeric)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.symbol" :use *)
(import "coil.scheme.stdproc" :as stdproc)
(import "coil.reader" :as reader :use *)
(import "coil.scheme.math" :as math)
(import "coil.scheme.bignum" :use *)
(import "coil.scheme.core" :use [scm-add scm-sub scm-mul scm-div scm-lt scm-num-eq
                                 core-number->f64 number-real-part number-imag-part])

;; Identical libc declaration to coil.reader. Identical extern redeclarations are
;; permitted; this keeps numeric formatting independent of compiler modules.
(extern snprintf :cc c [(ptr i8) i64 (ptr i8) ...] (-> i32))

;; Scheme numerics, and `syntax-rules`.
;;
;; Two halves that share a file because neither touches anything else. The
;; numerics are ordinary functions over `Val`; `syntax-rules` is a macro that
;; compiles a pattern language into Coil macros.
;;
;; SCOPE: 61-bit exact integers plus IEEE-754 inexact reals. R5RS 6.2.3 requires
;; exact integers of "practically unlimited size", so a conforming `(expt 2 100)`
;; is a bignum and `(/ 1 3)` is an exact rational. Those representations remain
;; the next numeric phase; operations that require them stay absent rather than
;; silently returning an inexact answer for an exact computation.

; ============================================================================
; Integer division
; ============================================================================
;; The sign rules are the whole content of these three, and they are the classic
;; place an implementation is quietly wrong.
;;
;; R5RS 6.2.5: quotient truncates toward zero, so `(quotient -7 2)` is -3, not -4.
;; Then `remainder` takes the sign of the DIVIDEND and `modulo` the sign of the
;; DIVISOR, which is the only difference between them and is invisible until an
;; operand goes negative:
;;
;;     (remainder -7 2) = -1      (modulo -7 2) =  1
;;     (remainder  7 -2) = 1      (modulo  7 -2) = -1
;;
;; Coil's `/` and `%` are C's: truncating division and a remainder with the
;; dividend's sign. So `remainder` is `%` directly, and `modulo` is `%` corrected
;; when the signs disagree and the remainder is non-zero.

(defn integer-division-fail [] (-> i64)
  (oom-puts c"coil.scheme: integer division by zero\n")
  (abort)
  (s-unspecified))
(defn numeric-arity-fail [(name (ptr i8))] (-> i64)
  (oom-puts c"coil.scheme: ")
  (oom-puts name)
  (oom-puts c" expects at least one argument\n")
  (abort)
  (s-unspecified))

(defn scm-quotient [(a i64) (b i64)] (-> i64)
  (if (= (integer-sign b) 0) (integer-division-fail)
    (if (and (is-fixnum a) (is-fixnum b))
        (let [x (fixnum-value a) y (fixnum-value b)]
          ;; The sole fixnum quotient outside the signed 61-bit range.
          (if (and (= x -1152921504606846976) (= y -1))
              (big-from-i64 1152921504606846976)
            (mk-fixnum (/ x y))))
      (integer-quotient a b))))

(defn scm-remainder [(a i64) (b i64)] (-> i64)
  (if (= (integer-sign b) 0) (integer-division-fail)
    (if (and (is-fixnum a) (is-fixnum b))
        (let [x (fixnum-value a) y (fixnum-value b)]
          (if (and (= x -1152921504606846976) (= y -1)) (mk-fixnum 0)
            (mk-fixnum (% x y))))
      (integer-remainder a b))))

;; `modulo` differs from `remainder` only when the operands' signs disagree: then
;; the truncated remainder is on the wrong side of zero and one divisor's worth
;; brings it back. A zero remainder is already correct and must not be shifted —
;; `(modulo -4 2)` is 0, not 2.
(defn scm-modulo [(a i64) (b i64)] (-> i64)
  (if (= (integer-sign b) 0) (integer-division-fail)
  (if (or (is-bignum a) (is-bignum b)) (integer-modulo a b)
  (let [x (fixnum-value a)
        y (fixnum-value b)
        r (if (and (= x -1152921504606846976) (= y -1)) 0 (% x y))]
    (mk-fixnum
      (if (= r 0) 0
        (if (= (< r 0) (< y 0)) r (+ r y))))))))

; ============================================================================
; max / min / abs / gcd / lcm
; ============================================================================
;; All variadic in R5RS. The binary cores are here; the macros below fold them,
;; because folding at expansion time keeps the call sites as straight-line native
;; code instead of a loop over an argument list.

(defn scm-abs [(a i64)] (-> i64)
  (if (is-complex-number a) (scm-magnitude a)
  (if (is-fixnum a)
      (let [x (fixnum-value a)]
        (if (= x -1152921504606846976)
            (big-from-i64 1152921504606846976)
          (mk-fixnum (if (< x 0) (- 0 x) x))))
    (if (is-bignum a)
        (if (< (big-sign a) 0) (integer-negate a) a)
    (if (is-ratnum a)
        (make-rational (integer-abs (ratnum-numerator-val a)) (ratnum-denominator-val a))
      (let [x (flonum-value a)]
        (mk-flonum (if (primitive/fcmp-lt x 0.0) (primitive/fsub 0.0 x) x))))))))

(defn promote-result [(v i64) (a i64) (b i64)] (-> i64)
  ; R5RS requires max/min to be inexact when ANY argument is inexact, even when
  ; the selected magnitude happened to be the exact operand.
  (if (or (is-flonum a) (is-flonum b))
      (if (is-flonum v) v (mk-flonum (core-number->f64 v)))
    v))

(defn scm-max2 [(a i64) (b i64)] (-> i64)
  (promote-result (if (primitive/fcmp-gt (core-number->f64 a) (core-number->f64 b)) a b) a b))
(defn scm-min2 [(a i64) (b i64)] (-> i64)
  (promote-result (if (primitive/fcmp-lt (core-number->f64 a) (core-number->f64 b)) a b) a b))

;; Euclid, on absolute values. R5RS 6.2.5 specifies gcd and lcm to return a
;; NON-NEGATIVE result regardless of argument signs, which is why `(gcd 32 -36)`
;; is 4 rather than -4 — the negative operand's magnitude is what participates.
(defn gcd2 [(x i64) (y i64)] (-> i64)
  (if (= y 0) x (gcd2 y (% x y))))

(defn scm-gcd2 [(a i64) (b i64)] (-> i64)
  (if (or (is-bignum a) (is-bignum b)) (integer-gcd a b)
    (let [x (fixnum-value (scm-abs a))
          y (fixnum-value (scm-abs b))]
      (mk-fixnum (gcd2 x y)))))

;; `(lcm 0 n)` is 0 and must short-circuit: the general form divides by the gcd,
;; which is zero exactly when both operands are.
(defn scm-lcm2 [(a i64) (b i64)] (-> i64)
  (if (or (is-bignum a) (is-bignum b))
      (if (or (= (integer-sign a) 0) (= (integer-sign b) 0)) (mk-fixnum 0)
        (integer-abs (integer-mul (integer-quotient a (integer-gcd a b)) b)))
    (let [x (fixnum-value (scm-abs a))
          y (fixnum-value (scm-abs b))]
      (if (or (= x 0) (= y 0)) (mk-fixnum 0)
        (mk-fixnum (* (/ x (gcd2 x y)) y))))))

;; Fold a binary core over a variadic argument list at expansion time.
;; R5RS gives `max`/`min` at least one argument, so the one-argument case is the
;; base and a zero-argument call is a static error rather than a runtime one.
(defn num--fold [(f Code) (es Code) (i i64) (n i64)] (-> Code)
  (if (= i (- n 1)) (primitive/code-nth es i)
    `(~f ~(primitive/code-nth es i) ~(num--fold f es (+ i 1) n))))

(defn scm-max [& (es Code)] (-> Code)
  (if (= (primitive/code-count es) 0)
      (primitive/error "max expects at least one argument")
    (num--fold `scm-max2 es 0 (primitive/code-count es))))
(defn scm-min [& (es Code)] (-> Code)
  (if (= (primitive/code-count es) 0)
      (primitive/error "min expects at least one argument")
    (num--fold `scm-min2 es 0 (primitive/code-count es))))

;; R5RS: `(gcd)` is 0 and `(lcm)` is 1 — the identities of the two operations, so
;; the empty fold is meaningful rather than an error.
(defn scm-gcd [& (es Code)] (-> Code)
  (if (= (primitive/code-count es) 0) `(mk-fixnum 0)
    (if (= (primitive/code-count es) 1) `(scm-abs ~(primitive/code-nth es 0))
      (num--fold `scm-gcd2 es 0 (primitive/code-count es)))))
(defn scm-lcm [& (es Code)] (-> Code)
  (if (= (primitive/code-count es) 0) `(mk-fixnum 1)
    (if (= (primitive/code-count es) 1) `(scm-abs ~(primitive/code-nth es 0))
      (num--fold `scm-lcm2 es 0 (primitive/code-count es)))))

(defn numeric-list-fold [(mode i64) (acc i64) (rest i64)] (-> i64)
  (if (is-null rest) acc
    (numeric-list-fold mode
      (cond (= mode 0) (scm-max2 acc (car rest))
            (= mode 1) (scm-min2 acc (car rest))
            (= mode 2) (scm-gcd2 acc (car rest))
            :else (scm-lcm2 acc (car rest)))
      (cdr rest))))
(defn scm-max-args [(args i64)] (-> i64)
  (if (is-null args) (numeric-arity-fail c"max")
    (numeric-list-fold 0 (car args) (cdr args))))
(defn scm-min-args [(args i64)] (-> i64)
  (if (is-null args) (numeric-arity-fail c"min")
    (numeric-list-fold 1 (car args) (cdr args))))
(defn scm-gcd-args [(args i64)] (-> i64)
  (numeric-list-fold 2 (mk-fixnum 0) args))
(defn scm-lcm-args [(args i64)] (-> i64)
  (numeric-list-fold 3 (mk-fixnum 1) args))

; ============================================================================
; expt
; ============================================================================
;; Fixnum-range results only. R5RS would promote past 61 bits; here the result
;; wraps, which is exactly the case `(expt 2 100)` in 08-numbers needs and does
;; not get. Square-and-multiply rather than a loop of multiplies because the
;; exponent is often a constant and the shape folds well.
(defn expt-i [(b i64) (e i64)] (-> i64)
  (if (= e 0) 1
    (let [h (expt-i b (/ e 2))]
      (if (= (% e 2) 0) (* h h) (* (* h h) b)))))
(defn expt-val [(b i64) (e i64) (acc i64)] (-> i64)
  (if (= e 0) acc
    (let [sp (gc-sp)]
      (gc-root b) (gc-root acc)
      (let [square (scm-mul b b)]
        (gc-root square)
        (let [next-acc (if (= (% e 2) 0) acc (scm-mul acc b))]
          (gc-root next-acc)
          (let [out (expt-val square (/ e 2) next-acc)]
            (gc-sp-set! sp) out))))))

(defn complex-exp-val [(v i64)] (-> i64)
  (let [x (core-number->f64 (number-real-part v))
        y (core-number->f64 (number-imag-part v))
        scale (math/real-exp x)]
    (make-complex
      (mk-flonum (primitive/fmul scale (math/real-cos y)))
      (mk-flonum (primitive/fmul scale (math/real-sin y))))))

(defn complex-log-val [(v i64)] (-> i64)
  (make-complex
    (mk-flonum (math/real-log (core-number->f64 (scm-magnitude v))))
    (scm-angle v)))

;; A negative exponent is an exact rational in R5RS (`(expt 2 -1)` = 1/2) and
;; there are no rationals here, so it yields 0 rather than a wrong integer.
(defn scm-expt [(b i64) (e i64)] (-> i64)
  (if (truthy? (scm-zero? e))
      (if (or (truthy? (scm-inexact? b)) (truthy? (scm-inexact? e)))
          (mk-flonum 1.0) (mk-fixnum 1))
  (if (and (truthy? (scm-zero? b))
           (primitive/fcmp-gt (core-number->f64 e) 0.0))
      (if (or (truthy? (scm-inexact? b)) (truthy? (scm-inexact? e)))
          (mk-flonum 0.0) (mk-fixnum 0))
  (if (or (is-complex-number b) (is-complex-number e))
      (complex-exp-val (scm-mul e (complex-log-val b)))
  (if (and (primitive/fcmp-lt (core-number->f64 b) 0.0)
           (and (is-flonum e)
                (not (primitive/fcmp-eq
                       (flonum-value e)
                       (primitive/cast f64 (primitive/cast i64 (flonum-value e)))))))
      (complex-exp-val
        (scm-mul e (complex-log-val (make-complex b (mk-fixnum 0)))))
  (if (or (is-flonum b) (is-flonum e))
      (mk-flonum (math/real-pow (core-number->f64 b) (core-number->f64 e)))
    (let [n (fixnum-value e)]
      (if (< n 0)
          (mk-ratnum 1 (expt-i (fixnum-value b) (- 0 n)))
        (expt-val b n (mk-fixnum 1))))))))))

; ============================================================================
; Real elementary functions
; ============================================================================
(defn sinh-f64 [(x f64)] (-> f64)
  (primitive/fdiv
    (primitive/fsub (math/real-exp x) (math/real-exp (primitive/fsub 0.0 x))) 2.0))
(defn cosh-f64 [(x f64)] (-> f64)
  (primitive/fdiv
    (primitive/fadd (math/real-exp x) (math/real-exp (primitive/fsub 0.0 x))) 2.0))
(defn complex-sin-val [(v i64)] (-> i64)
  (let [x (core-number->f64 (number-real-part v))
        y (core-number->f64 (number-imag-part v))]
    (make-complex
      (mk-flonum (primitive/fmul (math/real-sin x) (cosh-f64 y)))
      (mk-flonum (primitive/fmul (math/real-cos x) (sinh-f64 y))))))
(defn complex-cos-val [(v i64)] (-> i64)
  (let [x (core-number->f64 (number-real-part v))
        y (core-number->f64 (number-imag-part v))]
    (make-complex
      (mk-flonum (primitive/fmul (math/real-cos x) (cosh-f64 y)))
      (mk-flonum (primitive/fsub 0.0
                   (primitive/fmul (math/real-sin x) (sinh-f64 y)))))))
(defn scm-exp [(v i64)] (-> i64)
  (if (is-complex-number v) (complex-exp-val v)
    (mk-flonum (math/real-exp (core-number->f64 v)))))
(defn scm-log [(v i64)] (-> i64)
  (if (or (is-complex-number v)
          (primitive/fcmp-lt (core-number->f64 v) 0.0))
      (complex-log-val (if (is-complex-number v) v
                         (make-complex v (mk-fixnum 0))))
    (mk-flonum (math/real-log (core-number->f64 v)))))
(defn scm-sin [(v i64)] (-> i64)
  (if (is-complex-number v) (complex-sin-val v)
    (mk-flonum (math/real-sin (core-number->f64 v)))))
(defn scm-cos [(v i64)] (-> i64)
  (if (is-complex-number v) (complex-cos-val v)
    (mk-flonum (math/real-cos (core-number->f64 v)))))
(defn scm-tan [(v i64)] (-> i64)
  (if (is-complex-number v) (scm-div (complex-sin-val v) (complex-cos-val v))
    (mk-flonum (math/real-tan (core-number->f64 v)))))
;; Principal complex asin in a form that does not erase which side of a branch
;; cut a signed zero denotes.  The algebraic `-i log(iz + sqrt(1-z^2))`
;; identity is mathematically equivalent away from the cuts, but ordinary
;; complex arithmetic turns several `+0.0`/`-0.0` intermediates into the same
;; zero and consequently chooses the wrong lip for explicit complex inputs.
(defn signed-magnitude-f64 [(sign f64) (mag f64)] (-> f64)
  (if (negative-sign-f64? sign) (primitive/fsub 0.0 mag) mag))
(defn hypot-f64 [(x f64) (y f64)] (-> f64)
  (let [ax (if (primitive/fcmp-lt x 0.0) (primitive/fsub 0.0 x) x)
        ay (if (primitive/fcmp-lt y 0.0) (primitive/fsub 0.0 y) y)
        hi (if (primitive/fcmp-ge ax ay) ax ay)
        lo (if (primitive/fcmp-ge ax ay) ay ax)]
    (if (primitive/fcmp-eq hi 0.0) 0.0
      (let [r (primitive/fdiv lo hi)]
        (primitive/fmul hi
          (math/real-sqrt (primitive/fadd 1.0 (primitive/fmul r r))))))))
(defn acosh-f64 [(x f64)] (-> f64)
  (math/real-log
    (primitive/fadd x
      (math/real-sqrt (primitive/fsub (primitive/fmul x x) 1.0)))))
(defn clamp-unit-f64 [(x f64)] (-> f64)
  (if (primitive/fcmp-lt x -1.0) -1.0
    (if (primitive/fcmp-gt x 1.0) 1.0 x)))
(defn complex-asin-val [(v i64)] (-> i64)
  (let [x (core-number->f64 (number-real-part v))
        y (core-number->f64 (number-imag-part v))
        rp (hypot-f64 (primitive/fadd x 1.0) y)
        rm (hypot-f64 (primitive/fsub x 1.0) y)
        alpha (primitive/fmul 0.5 (primitive/fadd rp rm))
        beta (primitive/fmul 0.5 (primitive/fsub rp rm))]
    (make-complex
      (mk-flonum (if (primitive/fcmp-eq beta 0.0) x
                    (math/real-asin (clamp-unit-f64 beta))))
      (mk-flonum (signed-magnitude-f64 y (acosh-f64 alpha))))))
(defn real-cut-zero-f64 [(x f64)] (-> f64)
  ;; Chez/R5RS principal values approach the real axis from below for x > 1
  ;; and from above for x < -1 when the input was not explicitly complex.
  (if (primitive/fcmp-lt x 0.0) 0.0 -0.0))
(defn scm-asin [(v i64)] (-> i64)
  (if (or (is-complex-number v)
          (or (primitive/fcmp-lt (core-number->f64 v) -1.0)
              (primitive/fcmp-gt (core-number->f64 v) 1.0)))
      (complex-asin-val (if (is-complex-number v) v
                          (make-complex v
                            (mk-flonum (real-cut-zero-f64
                                         (core-number->f64 v))))))
    (mk-flonum (math/real-asin (core-number->f64 v)))))
(defn scm-acos [(v i64)] (-> i64)
  (if (or (is-complex-number v)
          (or (primitive/fcmp-lt (core-number->f64 v) -1.0)
              (primitive/fcmp-gt (core-number->f64 v) 1.0)))
      (let [a (complex-asin-val (if (is-complex-number v) v
                                  (make-complex v
                                    (mk-flonum (real-cut-zero-f64
                                                 (core-number->f64 v))))))]
        (make-complex
          (mk-flonum
            (primitive/fsub (primitive/fdiv (math/real-atan2 0.0 -1.0) 2.0)
                            (core-number->f64 (complex-real a))))
          (mk-flonum (primitive/fsub 0.0
                        (core-number->f64 (complex-imag a))))))
    (mk-flonum (math/real-acos (core-number->f64 v)))))
(defn scm-atan1 [(v i64)] (-> i64)
  (if (is-complex-number v)
      (let [x (core-number->f64 (number-real-part v))
            y (core-number->f64 (number-imag-part v))
            x2 (primitive/fmul x x)
            yp (primitive/fadd y 1.0)
            ym (primitive/fsub y 1.0)]
        (make-complex
          (mk-flonum
            (let [num (primitive/fmul 2.0 x)
                  den (primitive/fsub (primitive/fsub 1.0 x2)
                                      (primitive/fmul y y))]
              (primitive/fmul 0.5
                (if (and (primitive/fcmp-eq num 0.0)
                         (primitive/fcmp-lt den 0.0))
                    (signed-magnitude-f64 num (math/real-atan2 0.0 -1.0))
                  (math/real-atan2 num den)))))
          (mk-flonum
            (primitive/fmul 0.25
              (math/real-log
                (primitive/fdiv
                  (primitive/fadd x2 (primitive/fmul yp yp))
                  (primitive/fadd x2 (primitive/fmul ym ym))))))))
    (mk-flonum (math/real-atan (core-number->f64 v)))))
(defn scm-atan2 [(y i64) (x i64)] (-> i64)
  (mk-flonum (math/real-atan2 (core-number->f64 y) (core-number->f64 x))))

(defn exact-isqrt [(n i64)] (-> i64)
  (if (<= n 1) n
    (let [(mut x) n (mut done) false]
      (loop
        (if (load (mut done)) (break)
          (let [next (/ (+ (load (mut x))
                            (/ n (load (mut x)))) 2)]
            (if (>= next (load (mut x)))
                (set! (mut done) true)
              (set! (mut x) next)))))
      (load (mut x)))))

(defn integer-isqrt [(n i64)] (-> i64)
  (if (is-fixnum n) (mk-fixnum (exact-isqrt (fixnum-value n)))
    (let [sp (gc-sp) (mut x) n (mut done) false]
      (gc-root n)
      (loop
        (if (load (mut done)) (break)
          (do
            (gc-root (load (mut x)))
            (let [part (integer-quotient n (load (mut x)))]
              (gc-root part)
              (let [sum (integer-add (load (mut x)) part)]
                (gc-root sum)
                (let [next (integer-quotient sum (mk-fixnum 2))]
                  (gc-root next)
                  (if (>= (integer-cmp next (load (mut x))) 0)
                      (set! (mut done) true)
                    (set! (mut x) next))))))))
      (let [out (load (mut x))]
        (gc-sp-set! sp) (gc-root out) out))))

(defn exact-square-root [(n i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root n)
    (let [r (integer-isqrt n)]
      (gc-root r)
      (let [square (integer-mul r r)]
        (gc-root square)
        (let [out (if (= (integer-cmp square n) 0) r (s-false))]
          (gc-sp-set! sp) (gc-root out) out)))))

(defn scm-sqrt [(v i64)] (-> i64)
  (if (is-complex-number v)
      ;; Principal square root via polar form.
      (scm-make-polar
        (mk-flonum (math/real-sqrt (core-number->f64 (scm-magnitude v))))
        (mk-flonum (primitive/fdiv (core-number->f64 (scm-angle v)) 2.0)))
  (if (or (is-fixnum v) (is-bignum v))
      (if (< (integer-sign v) 0)
          (make-complex (mk-fixnum 0)
                        (scm-sqrt (integer-negate v)))
        (let [r (exact-square-root v)]
          (if (val-eq? r (s-false))
              (mk-flonum (math/real-sqrt (core-number->f64 v))) r)))
    (if (is-ratnum v)
        (let [sp (gc-sp)]
          (gc-root v)
          (let [n (ratnum-numerator-val v) d (ratnum-denominator-val v)]
            (gc-root n) (gc-root d)
            (if (< (integer-sign n) 0)
                (let [mag (make-rational (integer-abs n) d)]
                  (gc-root mag)
                  (let [out (make-complex (mk-fixnum 0) (scm-sqrt mag))]
                    (gc-sp-set! sp) (gc-root out) out))
              (let [rn (exact-square-root n)]
                (gc-root rn)
                (let [rd (exact-square-root d)]
                  (gc-root rd)
                  (let [out (if (and (not (val-eq? rn (s-false)))
                                     (not (val-eq? rd (s-false))))
                                (make-rational rn rd)
                              (mk-flonum (math/real-sqrt (core-number->f64 v))))]
                    (gc-sp-set! sp) (gc-root out) out))))))
      (if (negative-sign-f64? (flonum-value v))
          (make-complex (mk-flonum 0.0)
                        (mk-flonum (math/real-sqrt
                                      (primitive/fsub 0.0 (flonum-value v)))))
        (mk-flonum (math/real-sqrt (flonum-value v))))))))

; ============================================================================
; Numeric predicates
; ============================================================================
;; `number?` and `integer?` agree here because every number is a fixnum. They are
;; separate functions anyway: when the tower lands they diverge, and call sites
;; written against the right one keep working.
(defn scm-number? [(v i64)] (-> i64)
  (mk-bool (or (is-complex-number v)
               (or (is-fixnum v) (or (is-bignum v) (or (is-ratnum v) (is-flonum v)))))))
(defn finite-f64? [(x f64)] (-> bool)
  ; IEEE-754 infinities and NaNs have an all-ones exponent. Avoid converting
  ; them—or a finite value outside i64—to an integer merely to ask integer?.
  (not (= (primitive/iand (f64->raw-bits x) 9218868437227405312)
          9218868437227405312)))
(defn negative-sign-f64? [(x f64)] (-> bool)
  (= (primitive/cast i64
       (primitive/ishr (primitive/cast u64 (f64->raw-bits x)) 63)) 1))
(defn scm-integer? [(v i64)] (-> i64)
  (if (is-complex-number v)
      (mk-bool (and (truthy? (scm-num-eq (complex-imag v) (mk-fixnum 0)))
                    (truthy? (scm-integer? (complex-real v)))))
  (mk-bool (or (is-fixnum v)
               (or (is-bignum v)
               (and (is-flonum v)
                    (and (finite-f64? (flonum-value v))
                         (primitive/fcmp-eq
                           (flonum-value v)
                           (trunc-f64 (flonum-value v))))))))))
;; Every fixnum is exact; no inexact numbers exist yet.
(defn scm-exact? [(v i64)] (-> i64)
  (if (is-complex-number v)
      (mk-bool (and (truthy? (scm-exact? (complex-real v)))
                    (truthy? (scm-exact? (complex-imag v)))))
    (mk-bool (or (is-fixnum v) (or (is-bignum v) (is-ratnum v))))))
(defn scm-inexact? [(v i64)] (-> i64)
  (if (is-complex-number v)
      (mk-bool (or (truthy? (scm-inexact? (complex-real v)))
                   (truthy? (scm-inexact? (complex-imag v)))))
    (mk-bool (is-flonum v))))
(defn scm-complex? [(v i64)] (-> i64) (scm-number? v))
(defn scm-real? [(v i64)] (-> i64)
  (if (is-complex-number v)
      (scm-num-eq (complex-imag v) (mk-fixnum 0))
    (scm-number? v)))
(defn scm-rational? [(v i64)] (-> i64)
  (if (truthy? (scm-real? v))
      (if (is-complex-number v) (scm-rational? (complex-real v)) (scm-number? v))
    (s-false)))

(defn scm-zero? [(v i64)] (-> i64)
  (if (is-complex-number v)
      (mk-bool (and (truthy? (scm-zero? (complex-real v)))
                    (truthy? (scm-zero? (complex-imag v)))))
    (mk-bool (primitive/fcmp-eq (core-number->f64 v) 0.0))))
(defn scm-positive? [(v i64)] (-> i64)
  (mk-bool (if (is-bignum v) (> (big-sign v) 0) (> (core-number->f64 v) 0.0))))
(defn scm-negative? [(v i64)] (-> i64)
  (mk-bool (if (is-bignum v) (< (big-sign v) 0) (< (core-number->f64 v) 0.0))))

;; `odd?`/`even?` must hold for negatives, and C's `%` gives -1 for `(% -3 2)` —
;; so the test is against zero, not against one.
(defn integer-value [(v i64)] (-> i64)
  (if (is-fixnum v) (fixnum-value v) (primitive/cast i64 (flonum-value v))))
(defn integer-low [(v i64)] (-> i64)
  (if (is-bignum v) (fixnum-value (car (big-limbs v))) (integer-value v)))
(defn scm-even? [(v i64)] (-> i64) (mk-bool (= (% (integer-low v) 2) 0)))
(defn scm-odd? [(v i64)] (-> i64) (mk-bool (not (= (% (integer-low v) 2) 0))))

; ============================================================================
; Exactness conversion and rounding
; ============================================================================
(defn scm-exact->inexact [(v i64)] (-> i64)
  (if (is-complex-number v)
      (make-complex (scm-exact->inexact (complex-real v))
                    (scm-exact->inexact (complex-imag v)))
    (if (is-flonum v) v
      (mk-flonum (core-number->f64 v)))))

(defn scm-numerator [(v i64)] (-> i64)
  (if (is-flonum v)
      (scm-exact->inexact (scm-numerator (scm-inexact->exact v)))
    (if (is-ratnum v) (ratnum-numerator-val v) v)))
(defn scm-denominator [(v i64)] (-> i64)
  (if (is-flonum v)
      (scm-exact->inexact (scm-denominator (scm-inexact->exact v)))
    (if (is-ratnum v) (ratnum-denominator-val v) (mk-fixnum 1))))
(defn scm-make-rectangular [(real i64) (imag i64)] (-> i64)
  (make-complex real imag))
(defn scm-make-polar [(mag i64) (ang i64)] (-> i64)
  (make-complex
    (mk-flonum (primitive/fmul (core-number->f64 mag)
                               (math/real-cos (core-number->f64 ang))))
    (mk-flonum (primitive/fmul (core-number->f64 mag)
                               (math/real-sin (core-number->f64 ang))))))
(defn scm-real-part [(v i64)] (-> i64)
  (if (is-complex-number v) (complex-real v) v))
(defn scm-imag-part [(v i64)] (-> i64)
  (if (is-complex-number v) (complex-imag v) (mk-fixnum 0)))
(defn scm-magnitude [(v i64)] (-> i64)
  (if (is-complex-number v)
      (mk-flonum (hypot-f64 (core-number->f64 (complex-real v))
                            (core-number->f64 (complex-imag v))))
    (scm-abs v)))
(defn scm-angle [(v i64)] (-> i64)
  (let [pi (math/real-atan2 0.0 -1.0)]
    (if (is-complex-number v)
        (let [y (core-number->f64 (complex-imag v))
              x (core-number->f64 (complex-real v))]
          (if (primitive/fcmp-eq y 0.0)
              (if (negative-sign-f64? x)
                  (mk-flonum (if (negative-sign-f64? y)
                                 (primitive/fsub 0.0 pi) pi))
                (mk-flonum y))
            (mk-flonum (math/real-atan2 y x))))
      (let [x (core-number->f64 v)]
        (mk-flonum (if (or (primitive/fcmp-lt x 0.0) (negative-sign-f64? x))
                       pi 0.0))))))
(defn simplest-rational [(x i64) (y i64)] (-> i64)
  (let [fx (scm-floor x) fy (scm-floor y)]
    (if (truthy? (scm-lt fx x))
        (if (truthy? (scm-num-eq fx fy))
            (scm-add fx
              (scm-div (mk-fixnum 1)
                (simplest-rational
                  (scm-div (mk-fixnum 1) (scm-sub y fy))
                  (scm-div (mk-fixnum 1) (scm-sub x fx)))))
          (scm-add fx (mk-fixnum 1)))
      fx)))
(defn scm-rationalize [(x i64) (y i64)] (-> i64)
  (simplest-rational (scm-sub x y) (scm-add x y)))

(defn exact-power-of-two [(e i64)] (-> i64)
  (expt-val (mk-fixnum 2) e (mk-fixnum 1)))
(defn exact-scale-power-of-two [(sig i64) (e i64)] (-> i64)
  (let [sp (gc-sp) s (mk-fixnum sig)]
    (gc-root s)
    (let [p (exact-power-of-two (if (< e 0) (- 0 e) e))]
      (gc-root p)
      ;; The IEEE significand has had every factor of two cancelled above, so
      ;; for a negative exponent `s/p` is already normalized. Avoid feeding a
      ;; 1000-bit power-of-two denominator through the generic quadratic gcd.
      (let [out (if (>= e 0) (integer-mul s p)
                  (allocate (tag-ratnum) s p 0))]
        (gc-sp-set! sp) (gc-root out) out))))

(defn scm-inexact->exact [(v i64)] (-> i64)
  (if (is-complex-number v)
      (make-complex (scm-inexact->exact (complex-real v))
                    (scm-inexact->exact (complex-imag v)))
  (if (not (is-flonum v)) v
    (let [bits (f64->raw-bits (flonum-value v))
          neg (= (primitive/cast i64
                   (primitive/ishr (primitive/cast u64 bits) 63)) 1)
          ef (primitive/iand
               (primitive/cast i64 (primitive/ishr (primitive/cast u64 bits) 52))
               2047)
          mant (primitive/iand bits 4503599627370495)]
      (if (= ef 2047) (s-unspecified)
        (if (and (= ef 0) (= mant 0)) (mk-fixnum 0)
          (let [(mut sig) (if (= ef 0) mant (+ mant 4503599627370496))
                (mut e) (if (= ef 0) -1074 (- ef 1075))]
            ; Cancel powers of two before constructing the denominator. This is
            ; why ordinary decimals such as 0.5 and 0.1 fit the current 61-bit
            ; exact representation even though their raw significand has 53 bits.
            (loop
              (if (or (>= (load (mut e)) 0)
                      (not (= (% (load (mut sig)) 2) 0)))
                  (break)
                (do (set! (mut sig) (/ (load (mut sig)) 2))
                    (set! (mut e) (+ (load (mut e)) 1)))))
            (let [s (if neg (- 0 (load (mut sig))) (load (mut sig)))
                  ex (load (mut e))]
              (exact-scale-power-of-two s ex)))))))))

(defn trunc-f64 [(x f64)] (-> f64)
  ; At |x| >= 2^52 every finite binary64 value is already integral. Besides
  ; avoiding an undefined out-of-range fptosi, returning x preserves -0.0.
  (if (or (primitive/fcmp-eq x 0.0)
          (or (primitive/fcmp-ge x 4503599627370496.0)
              (primitive/fcmp-le x -4503599627370496.0)))
      x
    (primitive/cast f64 (primitive/cast i64 x))))
(defn floor-f64 [(x f64)] (-> f64)
  (let [t (trunc-f64 x)]
    (if (primitive/fcmp-lt x t) (primitive/fsub t 1.0) t)))
(defn ceiling-f64 [(x f64)] (-> f64)
  (let [t (trunc-f64 x)]
    (if (primitive/fcmp-gt x t) (primitive/fadd t 1.0) t)))
(defn round-f64 [(x f64)] (-> f64)
  ; R5RS resolves exact half-way cases toward the even integer.
  (if (or (primitive/fcmp-eq x 0.0)
          (or (primitive/fcmp-ge x 4503599627370496.0)
              (primitive/fcmp-le x -4503599627370496.0)))
      x
    (let [q (primitive/cast i64 x)
          t (primitive/cast f64 q)
          d (primitive/fsub x t)
          ad (if (primitive/fcmp-lt d 0.0) (primitive/fsub 0.0 d) d)]
      (if (primitive/fcmp-lt ad 0.5) t
        (if (primitive/fcmp-gt ad 0.5)
            (primitive/cast f64 (if (primitive/fcmp-lt d 0.0) (- q 1) (+ q 1)))
          (if (= (% q 2) 0) t
            (primitive/cast f64 (if (primitive/fcmp-lt d 0.0) (- q 1) (+ q 1)))))))))

;; mode: 0=floor, 1=ceiling, 2=truncate, 3=round-to-even.
(defn rational-rounding [(v i64) (mode i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root v)
    (let [n (ratnum-numerator-val v) d (ratnum-denominator-val v)]
      (gc-root n) (gc-root d)
      (let [q (integer-quotient n d)]
        (gc-root q)
      (let [r (integer-remainder n d)]
        (gc-root r)
        (let [nonzero (not (= (integer-sign r) 0))
              out
                (cond (= mode 0)
                        (if (and (< (integer-sign n) 0) nonzero)
                            (integer-sub q (mk-fixnum 1)) q)
                      (= mode 1)
                        (if (and (> (integer-sign n) 0) nonzero)
                            (integer-add q (mk-fixnum 1)) q)
                      (= mode 2) q
                      :else
                        (let [twice (integer-mul (integer-abs r) (mk-fixnum 2))]
                          (gc-root twice)
                          (let [cmp (integer-cmp twice d)
                                away (if (< (integer-sign n) 0)
                                         (integer-sub q (mk-fixnum 1))
                                       (integer-add q (mk-fixnum 1)))]
                            (if (< cmp 0) q
                              (if (> cmp 0) away
                                (if (= (integer-sign
                                         (integer-remainder q (mk-fixnum 2))) 0)
                                    q away))))))]
          (gc-sp-set! sp)
          (gc-root out)
          out))))))

(defn scm-floor [(v i64)] (-> i64)
  (if (is-fixnum v) v
    (if (is-ratnum v)
        (rational-rounding v 0)
      (mk-flonum (floor-f64 (flonum-value v))))))
(defn scm-ceiling [(v i64)] (-> i64)
  (if (is-fixnum v) v
    (if (is-ratnum v)
        (rational-rounding v 1)
      (mk-flonum (ceiling-f64 (flonum-value v))))))
(defn scm-truncate [(v i64)] (-> i64)
  (if (is-fixnum v) v
    (if (is-ratnum v)
        (rational-rounding v 2)
      (mk-flonum (trunc-f64 (flonum-value v))))))
(defn scm-round [(v i64)] (-> i64)
  (if (is-fixnum v) v
    (if (is-ratnum v)
        (rational-rounding v 3)
      (mk-flonum (round-f64 (flonum-value v))))))

; ============================================================================
; Variadic chain comparisons
; ============================================================================
;; R5RS 6.2.5: `(< 1 2 3)` compares ADJACENT pairs and is true iff every pair
;; holds — it is not `(and (< 1 2) (< 1 3))` and it is not a fold of the result.
;; Expanding to the conjunction of the pairs is the whole implementation, with one
;; trap: each middle argument appears in TWO comparisons, so it must be evaluated
;; once and bound, or `(< (f) (g) (h))` calls `g` twice.
(defn num--chain [(op Code) (es Code) (i i64) (n i64)] (-> Code)
  (if (>= (+ i 2) n)
      ; last pair: neither operand is reused, so no binding is needed
      `(~op ~(primitive/code-nth es i) ~(primitive/code-nth es (+ i 1)))
    (let [tmp (primitive/gensym)]
      `(let [~tmp ~(primitive/code-nth es (+ i 1))]
         (if (~op ~(primitive/code-nth es i) ~tmp)
             ~(num--chain op `(~tmp ~@(num--rest es (+ i 2) n)) 0 (- n (+ i 1)))
           false)))))

(defn num--rest [(e Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `() `(~(primitive/code-nth e i) ~@(num--rest e (+ i 1) n))))

;; The bool-level comparison chain, then one `mk-bool` at the end: the
;; intermediate results are never Scheme values, so no boxing happens per pair.
(defn num--cmp [(op Code) (es Code)] (-> Code)
  (let [n (primitive/code-count es)]
    (if (< n 2) `(s-true)
      `(mk-bool ~(num--chain op es 0 n)))))

(defn num-lt [(a i64) (b i64)] (-> bool) (< (fixnum-value a) (fixnum-value b)))
(defn num-gt [(a i64) (b i64)] (-> bool) (> (fixnum-value a) (fixnum-value b)))
(defn num-le [(a i64) (b i64)] (-> bool) (<= (fixnum-value a) (fixnum-value b)))
(defn num-ge [(a i64) (b i64)] (-> bool) (>= (fixnum-value a) (fixnum-value b)))
(defn num-eq [(a i64) (b i64)] (-> bool) (= (fixnum-value a) (fixnum-value b)))

(defn scm-num-lt [& (es Code)] (-> Code) (num--cmp `num-lt es))
(defn scm-num-gt [& (es Code)] (-> Code) (num--cmp `num-gt es))
(defn scm-num-le [& (es Code)] (-> Code) (num--cmp `num-le es))
(defn scm-num-ge [& (es Code)] (-> Code) (num--cmp `num-ge es))
(defn scm-num-eqv [& (es Code)] (-> Code) (num--cmp `num-eq es))

; ============================================================================
; number->string / string->number
; ============================================================================
;; Radix 2..36. R5RS leaves the CASE of the digits above 9 unspecified, which is
;; why 08-numbers pipes `(number->string 255 16)` through `char-downcase` instead
;; of comparing to "ff" directly — an implementation emitting "FF" is conforming.
;; Lowercase here; the reader below accepts both.

(defn digit-char [(d i64)] (-> i64)
  (if (< d 10) (+ 48 d) (+ 87 d)))          ; '0' | 'a'-10

;; A digit's value in the given radix, or -1 for "not a digit here". Both cases
;; are accepted on input because R5RS's unspecified output case means a program
;; can legitimately be handed either.
(defn char-digit [(c i64) (radix i64)] (-> i64)
  (let [d (if (and (>= c 48) (<= c 57)) (- c 48)
            (if (and (>= c 97) (<= c 122)) (- c 87)
              (if (and (>= c 65) (<= c 90)) (- c 55) -1)))]
    (if (or (< d 0) (>= d radix)) -1 d)))

;; One Scheme string representation, owned by stdproc.coil. Numeric conversion
;; used to allocate a boxed byte slice under the SAME tag as stdproc's traced
;; character-chain string. Passing a source literal to `string->number` then
;; interpreted its tagged length as a pointer (for a 31-byte path, address 0xf9)
;; and crashed. All construction now delegates to the canonical representation.
(defn mk-string [(s (slice u8))] (-> i64)
  (stdproc/string-from-slice s))

(defn string-slice [(v i64)] (-> (slice u8))
  (let [n (stdproc/string-length-raw v)
        data (primitive/cast (ptr u8) (unwrap-ptr [i8] (raw-alloc (malloc-allocator) n 1)))]
    (for [i 0 n]
      (store! (primitive/index data i) (primitive/cast u8 (stdproc/string-code v i))))
    (slice-new [u8] data n)))

;; Digits are generated least-significant first, so they are written into a
;; fixed buffer from the END and the slice is taken from where the writing stopped.
;; 64 bytes covers radix 2 over the whole 61-bit range plus a sign.
(defn num->str [(n i64) (radix i64)] (-> (slice u8))
  (let [buf (unwrap-ptr [(array u8 72)] (create [(array u8 72)] (malloc-allocator)))
        (mut pos) 72
        (mut x) (if (< n 0) (- 0 n) n)]
    ; the zero case writes no digits in the loop below, so it is written here
    (if (= n 0)
        (do (set! (mut pos) 71)
            (set! (primitive/index buf 71) (primitive/cast u8 48)) 0)
      (loop
        (if (= (load (mut x)) 0) (break)
          (do
            (set! (mut pos) (- (load (mut pos)) 1))
            (set! (primitive/index buf (load (mut pos)))
                  (primitive/cast u8 (digit-char (% (load (mut x)) radix))))
            (set! (mut x) (/ (load (mut x)) radix))
            0))))
    (if (< n 0)
        (do (set! (mut pos) (- (load (mut pos)) 1))
            (set! (primitive/index buf (load (mut pos))) (primitive/cast u8 45))    ; '-'
            0)
      0)
    (let [p (load (mut pos))]
      (slice-new [u8] (primitive/cast (ptr u8)
                                      (+ (primitive/cast i64 buf) p))
                 (- 72 p)))))

(defn big-str-limbs! [(sb (mut StrBuf)) (xs i64)] (-> i64)
  (let [rest (cdr xs) n (fixnum-value (car xs))]
    (if (is-null rest) (sb-push-str! (mut sb) (num->str n 10))
      (do (big-str-limbs! (mut sb) rest)
          (let [digits (num->str n 10) pad (- 9 (slice-len [u8] digits))]
            (for [i 0 pad] (sb-push-byte! (mut sb) (primitive/cast u8 48)))
            (sb-push-str! (mut sb) digits))))))
(defn big-num->str [(v i64)] (-> (slice u8))
  (let [(mut sb) (sb-new (malloc-allocator))]
    (if (< (big-sign v) 0) (sb-push-byte! (mut sb) (primitive/cast u8 45)) 0)
    (big-str-limbs! (mut sb) (big-limbs v))
    (sb-finish! (mut sb))))
(defn radix-digit-byte [(d i64)] (-> u8)
  (primitive/cast u8 (if (< d 10) (+ 48 d) (+ 87 d))))
(defn big-radix-digits! [(sb (mut StrBuf)) (v i64) (radix i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root v)
    (let [base (mk-fixnum radix)
          q (integer-quotient v base)]
      (gc-root q)
      (if (not (= (integer-sign q) 0)) (big-radix-digits! (mut sb) q radix) 0)
      (let [r (integer-remainder v base)]
        (sb-push-byte! (mut sb) (radix-digit-byte (fixnum-value r)))
        (gc-sp-set! sp)
        0))))
(defn big-radix-num->str [(v i64) (radix i64)] (-> (slice u8))
  (let [(mut sb) (sb-new (malloc-allocator))
        magnitude (integer-abs v)]
    (if (< (integer-sign v) 0) (sb-push-byte! (mut sb) (primitive/cast u8 45)) 0)
    (big-radix-digits! (mut sb) magnitude radix)
    (sb-finish! (mut sb))))
(defn integer-num->str [(v i64) (radix i64)] (-> (slice u8))
  (if (is-bignum v)
      (if (= radix 10) (big-num->str v) (big-radix-num->str v radix))
    (num->str (fixnum-value v) radix)))

;; This implementation module is below the dialect's automatic rooting pass.
;; Keep the rational and each intermediate string alive across the allocations
;; needed to assemble "numerator/denominator".
(defn rational-num->string [(v i64) (radix i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root v)
    (let [n (mk-string (integer-num->str (ratnum-numerator-val v) radix))]
      (gc-root n)
      (let [slash (mk-string "/")]
        (gc-root slash)
        (let [prefix (stdproc/scm-string-append n slash)]
          (gc-root prefix)
          (let [d (mk-string (integer-num->str (ratnum-denominator-val v) radix))]
            (gc-root d)
            (let [out (stdproc/scm-string-append prefix d)]
              (gc-sp-set! sp)
              ;; The public caller may immediately allocate while consuming the
              ;; returned string (for example `display` inside `list`). Transfer
              ;; this one root into its surrounding frame; that frame clears it.
              (gc-root out)
              out)))))))

(defn complex-num->string [(v i64) (radix i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root v)
    (let [real (scm-number->string2 (complex-real v) radix)
          imagv (complex-imag v)]
      (gc-root real) (gc-root imagv)
      (let [imag (scm-number->string2 imagv radix)]
        (gc-root imag)
        (let [signed
              (if (or (truthy? (scm-negative? imagv))
                      (and (is-flonum imagv)
                           (negative-sign-f64? (flonum-value imagv)))) imag
                (let [plus (mk-string "+")]
                  (gc-root plus)
                  (stdproc/scm-string-append plus imag)))]
          (gc-root signed)
          (let [prefix (stdproc/scm-string-append real signed)]
            (gc-root prefix)
            (let [suffix (mk-string "i")]
              (gc-root suffix)
              (let [out (stdproc/scm-string-append prefix suffix)]
                (gc-sp-set! sp) (gc-root out) out))))))))

(defn flonum-text-has-marker? [(s (slice u8)) (i i64)] (-> bool)
  (if (>= i (slice-len s)) false
    (let [c (primitive/cast i64 (slice-get s i))]
      (if (or (= c 46) (or (= c 101) (= c 69))) true
        (flonum-text-has-marker? s (+ i 1))))))

(defn flonum-num->string [(v i64)] (-> i64)
  (let [buf (unwrap-ptr [(array u8 64)] (create [(array u8 64)] (malloc-allocator)))
        n (snprintf (primitive/cast (ptr i8) buf) 64 c"%.17g" (flonum-value v))
        text (slice-new [u8] (primitive/cast (ptr u8) buf) (primitive/cast i64 n))]
    ;; R5RS requires `string->number` of this representation to recover an
    ;; equivalent number. `%.17g` supplies enough digits but emits integral
    ;; flonums as "1" and signed zero as "-0", both of which read as exact.
    (if (flonum-text-has-marker? text 0) (mk-string text)
      (let [(mut sb) (sb-new (malloc-allocator))]
        (sb-push-str! (mut sb) text)
        (sb-push-str! (mut sb) ".0")
        (mk-string (sb-finish! (mut sb)))))))

(defn scm-number->string2 [(v i64) (radix i64)] (-> i64)
  (let [r (fixnum-value radix)]
    (if (is-complex-number v) (complex-num->string v radix)
    (if (is-flonum v)
        (flonum-num->string v)
    (if (is-bignum v)
        (mk-string (integer-num->str v r))
    (if (is-ratnum v)
        (rational-num->string v r)
      (mk-string (num->str (fixnum-value v) r))))))))
(defn scm-number->string1 [(v i64)] (-> i64)
  (scm-number->string2 v (mk-fixnum 10)))

;; R5RS: the radix argument is optional and defaults to 10.
(defn number->string [(v Code) & (rest Code)] (-> Code)
  (if (= (primitive/code-count rest) 0) `(scm-number->string1 ~v)
    `(scm-number->string2 ~v ~(primitive/code-nth rest 0))))

;; R5RS 6.2.6: `string->number` returns #f — not an error and not zero — when the
;; string is not a number in that radix. That is the contract callers test, so a
;; trailing junk character has to fail the whole parse rather than stop early.
(defn str->num [(s (slice u8)) (radix i64)] (-> i64)
  (let [n (slice-len [u8] s)]
    (if (= n 0) (s-false)
      (let [neg (= (primitive/cast i64 (slice-get [u8] s 0)) 45)
            plus (= (primitive/cast i64 (slice-get [u8] s 0)) 43)
            start (if (or neg plus) 1 0)]
        (if (>= start n) (s-false)          ; "-" alone is not a number
          (let [(mut acc) 0
                (mut ok) 1]
            (for [i start n]
              (let [d (char-digit (primitive/cast i64 (slice-get [u8] s i)) radix)]
                (if (< d 0) (do (store! (mut ok) 0) 0)
                  (do (store! (mut acc) (+ (* (load (mut acc)) radix) d))
                      0))))
            (if (= (load (mut ok)) 0) (s-false)
              (mk-fixnum (if neg (- 0 (load (mut acc)))
                           (load (mut acc)))))))))))

(defn number-slash-index [(s (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (slice-len [u8] s)]
      (if (= (primitive/cast i64 (slice-get [u8] s i)) 47)
          (if (>= (load (mut found)) 0)
              (store! (mut found) -2)
            (store! (mut found) i))
        0))
    (load (mut found))))

(defn number-at-index [(s (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (slice-len [u8] s)]
      (if (= (primitive/cast i64 (slice-get [u8] s i)) 64)
          (if (>= (load found) 0) (store! found -2) (store! found i)) 0))
    (load found)))

(defn parse-polar-slice [(s (slice u8)) (radix i64) (at i64)] (-> i64)
  (if (or (<= at 0) (>= at (- (slice-len [u8] s) 1))) (s-false)
    (let [mag (parse-number-slice (subslice [u8] s 0 at) radix)
          ang (parse-number-slice (subslice [u8] s (+ at 1) (slice-len [u8] s)) radix)]
      (if (or (val-eq? mag (s-false)) (val-eq? ang (s-false))) (s-false)
        (scm-make-polar mag ang)))))

(defn complex-separator [(s (slice u8)) (i i64) (stop i64) (last i64)] (-> i64)
  (if (>= i stop) last
    (let [c (primitive/cast i64 (slice-get [u8] s i))
          prev (primitive/cast i64 (slice-get [u8] s (- i 1)))]
      (complex-separator s (+ i 1) stop
        (if (and (or (= c 43) (= c 45))
                 (not (or (= prev 101) (= prev 69)))) i last)))))

(defn parse-complex-slice [(s (slice u8)) (radix i64)] (-> i64)
  (let [n (slice-len [u8] s)
        stop (- n 1)
        sep (if (> stop 1) (complex-separator s 1 stop -1) -1)]
    (if (or (< n 2)
            (and (< sep 0)
                 (let [first (primitive/cast i64 (slice-get [u8] s 0))]
                   (not (or (= first 43) (= first 45)))))
            (not (or (= (primitive/cast i64 (slice-get [u8] s stop)) 105)
                     (= (primitive/cast i64 (slice-get [u8] s stop)) 73))))
        (s-false)
      (let [real (if (< sep 0) (mk-fixnum 0)
                   (parse-number-slice (subslice [u8] s 0 sep) radix))
            imagtext (subslice [u8] s (if (< sep 0) 0 sep) stop)
            imag
              (if (= (slice-len [u8] imagtext) 0) (mk-fixnum 1)
                (if (and (= (slice-len [u8] imagtext) 1)
                         (= (primitive/cast i64 (slice-get [u8] imagtext 0)) 43))
                    (mk-fixnum 1)
                  (if (and (= (slice-len [u8] imagtext) 1)
                           (= (primitive/cast i64 (slice-get [u8] imagtext 0)) 45))
                      (mk-fixnum -1)
                    (parse-number-slice imagtext radix))))]
        (if (or (val-eq? real (s-false)) (val-eq? imag (s-false))) (s-false)
          (make-complex real imag))))))

;; Parse exact integer or rational syntax in the requested radix. This is shared
;; by `string->number` and the runtime datum reader so both accept the same token.
(defn parse-number-slice [(s (slice u8)) (radix i64)] (-> i64)
  (let [at (number-at-index s)]
  (if (>= at 0) (parse-polar-slice s radix at)
  (if (and (> (slice-len [u8] s) 0)
           (let [c (primitive/cast i64 (slice-get [u8] s (- (slice-len [u8] s) 1)))]
             (or (= c 105) (= c 73))))
      (parse-complex-slice s radix)
  (let [slash (number-slash-index s)]
    (if (< slash 0)
        (let [integer (integer-from-slice s radix)]
          (if (or (not (val-eq? integer (s-false))) (not (= radix 10))) integer
            (match (reader/atom (malloc-allocator) s)
              (KFloat [bits] (mk-flonum-bits bits))
              (_ (s-false)))))
      (if (or (= slash 0) (>= slash (- (slice-len [u8] s) 1))) (s-false)
        (let [n (integer-from-slice (subslice [u8] s 0 slash) radix)
              d (integer-from-slice (subslice [u8] s (+ slash 1) (slice-len [u8] s)) radix)]
          (if (or (val-eq? n (s-false))
                  (or (val-eq? d (s-false)) (= (integer-sign d) 0)))
              (s-false)
            (make-rational n d))))))))))

(defn scm-complex-literal [(s (slice u8))] (-> i64)
  (parse-number-slice s 10))

(defn exact-power-of-ten [(e i64)] (-> i64)
  (let [sp (gc-sp) (mut out) (mk-fixnum 1)]
    (for [i 0 e]
      (do
        (gc-sp-set! sp)
        (gc-root (load out))
        (store! out (integer-mul (load out) (mk-fixnum 10)))))
    (let [result (load out)]
      (gc-sp-set! sp) (gc-root result) result)))

(defn exact-decimal-exponent-marker? [(c i64)] (-> bool)
  (or (= c 101) (or (= c 69)
  (or (= c 115) (or (= c 83)
  (or (= c 102) (or (= c 70)
  (or (= c 100) (or (= c 68)
  (or (= c 108) (= c 76)))))))))))

(defn exact-decimal-exponent [(s (slice u8)) (start i64)] (-> i64)
  (let [n (slice-len [u8] s)
        neg (and (< start n) (= (primitive/cast i64 (slice-get [u8] s start)) 45))
        plus (and (< start n) (= (primitive/cast i64 (slice-get [u8] s start)) 43))
        first (if (or neg plus) (+ start 1) start)
        (mut value) 0 (mut ok) (< first n)]
    (for [i first n]
      (let [c (primitive/cast i64 (slice-get [u8] s i))]
        (if (or (< c 48) (> c 57)) (store! ok false)
          (store! value (+ (* (load value) 10) (- c 48))))))
    (if (not (load ok)) 9223372036854775807
      (if neg (- 0 (load value)) (load value)))))

;; Parse an explicitly exact decimal directly into base-10 integer components.
;; Going through `KFloat` and `inexact->exact` makes #e0.1 the exact IEEE
;; approximation instead of the report-required 1/10.
(defn parse-exact-decimal-slice [(s (slice u8))] (-> i64)
  (let [sp (gc-sp) n (slice-len [u8] s)
        neg (and (> n 0) (= (primitive/cast i64 (slice-get [u8] s 0)) 45))
        plus (and (> n 0) (= (primitive/cast i64 (slice-get [u8] s 0)) 43))
        first (if (or neg plus) 1 0)
        (mut acc) (mk-fixnum 0) (mut digits) 0 (mut frac) 0
        (mut dotted) false (mut exponent-at) -1 (mut ok) (< first n)
        (mut i) first]
    (loop
      (if (or (>= (load i) n) (>= (load exponent-at) 0)) (break)
        (let [c (primitive/cast i64 (slice-get [u8] s (load i)))]
          (do
            (if (and (>= c 48) (<= c 57))
                (do
                  (gc-sp-set! sp) (gc-root (load acc))
                  (set! acc
                        (integer-add (integer-mul (load acc) (mk-fixnum 10))
                                     (mk-fixnum (- c 48))))
                  (set! digits (+ (load digits) 1))
                  (if (load dotted) (set! frac (+ (load frac) 1)) 0))
              (if (= c 46)
                  (if (load dotted) (set! ok false) (set! dotted true))
                (if (exact-decimal-exponent-marker? c)
                    (set! exponent-at (load i))
                  (set! ok false))))
            (set! i (+ (load i) 1))))))
    (let [exp (if (< (load exponent-at) 0) 0
                (exact-decimal-exponent s (+ (load exponent-at) 1)))]
      (if (or (not (load ok))
              (or (= (load digits) 0) (= exp 9223372036854775807)))
          (do (gc-sp-set! sp) (s-false))
        (let [scale (- exp (load frac))
              signed (if neg (integer-negate (load acc)) (load acc))]
          (gc-root signed)
          (let [power (exact-power-of-ten (if (< scale 0) (- 0 scale) scale))]
            (gc-root power)
            (let [out (if (>= scale 0) (integer-mul signed power)
                        (make-rational signed power))]
              (gc-sp-set! sp) (gc-root out) out)))))))

(defn parse-explicit-exact-slice [(s (slice u8)) (radix i64)] (-> i64)
  (if (not (= radix 10)) (parse-number-slice s radix)
    (let [sp (gc-sp) n (slice-len [u8] s) at (number-at-index s)]
      (if (>= at 0)
          (let [mag (parse-explicit-exact-slice (subslice [u8] s 0 at) radix)]
            (gc-root mag)
            (let [ang (parse-explicit-exact-slice (subslice [u8] s (+ at 1) n) radix)]
              (gc-root ang)
              ;; A nonzero polar angle generally has no exact rectangular
              ;; representation. Chez rejects it under #e; angle zero is just
              ;; the exact magnitude and can be represented without trig.
              (let [out (if (or (val-eq? mag (s-false)) (val-eq? ang (s-false)))
                            (s-false)
                          (if (truthy? (scm-zero? ang)) mag (s-false)))]
                (gc-sp-set! sp) (gc-root out) out)))
        (if (and (> n 0)
                 (let [last (primitive/cast i64 (slice-get [u8] s (- n 1)))]
                   (or (= last 105) (= last 73))))
            (let [stop (- n 1)
                  sep (if (> (- n 1) 1) (complex-separator s 1 (- n 1) -1) -1)
                  real (if (< sep 0) (mk-fixnum 0)
                         (parse-explicit-exact-slice (subslice [u8] s 0 sep) radix))]
              (gc-root real)
              (let [imagtext (subslice [u8] s (if (< sep 0) 0 sep) stop)
                    imag
                    (if (= (slice-len [u8] imagtext) 0) (mk-fixnum 1)
                      (if (and (= (slice-len [u8] imagtext) 1)
                               (= (primitive/cast i64 (slice-get [u8] imagtext 0)) 43))
                          (mk-fixnum 1)
                        (if (and (= (slice-len [u8] imagtext) 1)
                                 (= (primitive/cast i64 (slice-get [u8] imagtext 0)) 45))
                            (mk-fixnum -1)
                          (parse-explicit-exact-slice imagtext radix))))]
                (gc-root imag)
                (let [out (if (or (val-eq? real (s-false)) (val-eq? imag (s-false)))
                              (s-false) (make-complex real imag))]
                  (gc-sp-set! sp) (gc-root out) out)))
          (let [ordinary (parse-number-slice s radix)]
            (gc-root ordinary)
            (let [out (if (val-eq? ordinary (s-false)) ordinary
                        (if (is-flonum ordinary) (parse-exact-decimal-slice s) ordinary))]
              (gc-sp-set! sp) (gc-root out) out)))))))

;; R5RS numeric prefixes may appear in either order (`#e#x10`, `#x#e10`).
;; `exactness`: 0 unspecified, 1 exact, -1 inexact. Duplicate radix or
;; exactness prefixes are rejected rather than silently taking the last one.
(defn prefixed-number-state [(s (slice u8)) (i i64) (radix i64)
                             (radix-set bool) (exactness i64) (exact-set bool)] (-> i64)
  (let [n (slice-len [u8] s)]
    (if (and (< (+ i 1) n)
             (= (primitive/cast i64 (slice-get [u8] s i)) 35))
        (let [c (primitive/cast i64 (slice-get [u8] s (+ i 1)))]
          (cond (or (= c 98) (= c 66))
                  (if radix-set (s-false)
                    (prefixed-number-state s (+ i 2) 2 true exactness exact-set))
                (or (= c 111) (= c 79))
                  (if radix-set (s-false)
                    (prefixed-number-state s (+ i 2) 8 true exactness exact-set))
                (or (= c 100) (= c 68))
                  (if radix-set (s-false)
                    (prefixed-number-state s (+ i 2) 10 true exactness exact-set))
                (or (= c 120) (= c 88))
                  (if radix-set (s-false)
                    (prefixed-number-state s (+ i 2) 16 true exactness exact-set))
                (or (= c 101) (= c 69))
                  (if exact-set (s-false)
                    (prefixed-number-state s (+ i 2) radix radix-set 1 true))
                (or (= c 105) (= c 73))
                  (if exact-set (s-false)
                    (prefixed-number-state s (+ i 2) radix radix-set -1 true))
                :else (s-false)))
      (if (>= i n) (s-false)
        (let [body (subslice [u8] s i n)
              v (if (= exactness 1) (parse-explicit-exact-slice body radix)
                  (parse-number-slice body radix))]
          (if (val-eq? v (s-false)) v
            (if (= exactness 1)
                v
              (if (= exactness -1)
                  (if (is-flonum v) v (scm-exact->inexact v))
                v))))))))

(defn parse-prefixed-number-slice-base [(s (slice u8)) (base i64)] (-> i64)
  (if (or (< (slice-len [u8] s) 2)
          (not (= (primitive/cast i64 (slice-get [u8] s 0)) 35)))
      (s-false)
    (prefixed-number-state s 0 base false 0 false)))
(defn parse-prefixed-number-slice [(s (slice u8))] (-> i64)
  (parse-prefixed-number-slice-base s 10))

(defn prefixed-declared-radix [(s (slice u8)) (i i64) (found i64)] (-> i64)
  (if (or (>= (+ i 1) (slice-len [u8] s))
          (not (= (primitive/cast i64 (slice-get [u8] s i)) 35))) found
    (let [c (primitive/cast i64 (slice-get [u8] s (+ i 1)))
          r (cond (or (= c 98) (= c 66)) 2
                  (or (= c 111) (= c 79)) 8
                  (or (= c 100) (= c 68)) 10
                  (or (= c 120) (= c 88)) 16
                  :else 0)]
      (if (> r 0)
          (if (> found 0) -1 (prefixed-declared-radix s (+ i 2) r))
        (if (or (= c 101) (or (= c 69) (or (= c 105) (= c 73))))
            (prefixed-declared-radix s (+ i 2) found)
          found)))))

;; Runtime `read` has already consumed the first `#` and prefix character.
(defn parse-prefixed-number-tail [(s (slice u8)) (first i64)] (-> i64)
  (cond (or (= first 98) (= first 66)) (prefixed-number-state s 0 2 true 0 false)
        (or (= first 111) (= first 79)) (prefixed-number-state s 0 8 true 0 false)
        (or (= first 100) (= first 68)) (prefixed-number-state s 0 10 true 0 false)
        (or (= first 120) (= first 88)) (prefixed-number-state s 0 16 true 0 false)
        (or (= first 101) (= first 69)) (prefixed-number-state s 0 10 false 1 true)
        (or (= first 105) (= first 73)) (prefixed-number-state s 0 10 false -1 true)
        :else (s-false)))

(defn scm-prefixed-number-literal [(s (slice u8))] (-> i64)
  (parse-prefixed-number-slice s))

(defn scm-string->number2 [(v i64) (radix i64)] (-> i64)
  (let [s (string-slice v) r (fixnum-value radix)]
    (if (and (> (slice-len [u8] s) 0)
             (= (primitive/cast i64 (slice-get [u8] s 0)) 35))
        (let [declared (prefixed-declared-radix s 0 0)]
          (if (or (< declared 0) (and (> declared 0) (not (= declared r))))
              (s-false)
            (parse-prefixed-number-slice-base s r)))
      (parse-number-slice s r))))
(defn scm-string->number1 [(v i64)] (-> i64)
  (let [s (string-slice v)]
    (if (and (> (slice-len [u8] s) 0)
             (= (primitive/cast i64 (slice-get [u8] s 0)) 35))
        (parse-prefixed-number-slice s)
      (parse-number-slice s 10))))

(defn scm-number->string-args [(args i64)] (-> i64)
  (if (is-null args) (s-unspecified)
    (let [rest (cdr args)]
      (if (is-null rest) (scm-number->string1 (car args))
        (if (is-null (cdr rest)) (scm-number->string2 (car args) (car rest))
          (s-unspecified))))))
(defn scm-string->number-args [(args i64)] (-> i64)
  (if (is-null args) (s-unspecified)
    (let [rest (cdr args)]
      (if (is-null rest) (scm-string->number1 (car args))
        (if (is-null (cdr rest)) (scm-string->number2 (car args) (car rest))
          (s-unspecified))))))
(defn scm-atan-args [(args i64)] (-> i64)
  (if (is-null args) (s-unspecified)
    (let [rest (cdr args)]
      (if (is-null rest) (scm-atan1 (car args))
        (if (is-null (cdr rest)) (scm-atan2 (car args) (car rest))
          (s-unspecified))))))

(defn string->number [(v Code) & (rest Code)] (-> Code)
  (if (= (primitive/code-count rest) 0) `(scm-string->number1 ~v)
    `(scm-string->number2 ~v ~(primitive/code-nth rest 0))))

; ============================================================================
; syntax-rules
; ============================================================================
;; The pattern language of R5RS 4.3.2: a matcher over `Code`, a binding table, and
;; a template instantiator.
;;
;; Direct Coil macros inherit hygiene from the host expander: quasiquote renames
;; template-introduced identifiers, as the unit tests demonstrate.  The Scheme
;; dialect has one additional boundary: it expands a Code tree inside a
;; before-expand transform, after which host lexical marks cannot be applied a
;; second time. `dialect.coil` therefore preserves provenance explicitly by
;; gensyming template-introduced lexical binders when it registers a
;; `define-syntax` declaration.
;;
;; ⚠ EVERY helper below reads list slots with `code-nth` directly instead of
;; through accessor functions. A `defn` whose return type is `Code` IS a macro
;; here, so an accessor like `(bind-name b)` would be a macro call nested inside a
;; macro body — which the stager prunes, and the helper then fails to resolve.
;; These helpers all call each other, so none of them can afford an accessor.

;; A binding is the 3-element list `(name depth value)`. Depth 0 is an ordinary
;; variable; depth 1 means the value is a LIST of matches gathered by an ellipsis,
;; which is the distinction a template needs to know whether `x` is one form or a
;; sequence of them.
(defn sr--lookup [(bs Code) (name Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    (if (primitive/code-eq (primitive/code-nth (primitive/code-nth bs i) 0) name)
        (primitive/code-nth bs i)
      (sr--lookup bs name (+ i 1) n))))

;; Is `s` in the literals list? R5RS's literal rule is why this exists: a literal
;; matches only the SAME identifier in the input, while every other symbol in a
;; pattern is a variable that matches anything. `else` in a `cond`-like macro is a
;; literal — and a user who rebinds `else` makes it stop being the keyword, which
;; is the corner the rule is written for.
(defn sr--literal? [(s Code) (lits Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (if (primitive/code-eq (primitive/code-nth lits i) s) true
      (sr--literal? s lits (+ i 1) n))))

(defn sr--lex-binding [(env Code) (name Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    (let [b (primitive/code-nth env i)]
      (if (primitive/code-eq (primitive/code-nth b 0) name)
          (primitive/code-nth b 1)
        (sr--lex-binding env name (+ i 1) n)))))
(defn sr--literal-match? [(p Code) (f Code) (defenv Code) (useenv Code)] (-> bool)
  (if (not (primitive/code-eq p f)) false
    (let [d (sr--lex-binding defenv p 0 (primitive/code-count defenv))
          u (sr--lex-binding useenv f 0 (primitive/code-count useenv))]
      (if (and (primitive/code-list? d) (= (primitive/code-count d) 0))
          (and (primitive/code-list? u) (= (primitive/code-count u) 0))
        (and (not (primitive/code-list? u)) (primitive/code-eq d u))))))

;; `...` is an ordinary symbol until a pattern gives it meaning, so it is compared
;; by name rather than carrying any reader support.
(defn sr--ellipsis? [(s Code)] (-> bool) (primitive/code-eq s `...))

(defn sr--followed-by-ellipsis? [(p Code) (i i64) (n i64)] (-> bool)
  (and (< (+ i 1) n) (sr--ellipsis? (primitive/code-nth p (+ i 1)))))

;; The pattern variables of a (sub)pattern. An ellipsis needs this to know which
;; names it gathers — including when it matches ZERO times and those names must
;; still bind, to the empty sequence.
(defn sr--vars [(p Code) (acc Code) (lits Code)] (-> Code)
  (if (primitive/code-sym? p)
      (if (or (sr--ellipsis? p)
              (or (primitive/code-eq p `_)
                  (sr--literal? p lits 0 (primitive/code-count lits))))
          acc
        `(~@acc ~p))
    (if (primitive/code-list? p) (sr--vars-list p 0 (primitive/code-count p) acc lits)
      acc)))

(defn sr--vars-list [(p Code) (i i64) (n i64) (acc Code) (lits Code)] (-> Code)
  (if (>= i n) acc
    (sr--vars-list p (+ i 1) n (sr--vars (primitive/code-nth p i) acc lits) lits)))

(defn sr--contains-from? [(xs Code) (name Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (or (primitive/code-eq (primitive/code-nth xs i) name)
        (sr--contains-from? xs name (+ i 1) n))))
(defn sr--duplicate-vars? [(xs Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (or (sr--contains-from? xs (primitive/code-nth xs i) (+ i 1) n)
        (sr--duplicate-vars? xs (+ i 1) n))))

(defn sr--rules-unique? [(spec Code) (lits Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) true
    (let [pat (primitive/code-nth (primitive/code-nth spec i) 0)
          body `(~@(num--rest pat 1 (primitive/code-count pat)))
          vars (sr--vars body `() lits)]
      (and (not (sr--duplicate-vars? vars 0 (primitive/code-count vars)))
           (sr--rules-unique? spec lits (+ i 1) n)))))

(defn syntax-rules-patterns-unique? [(spec Code)] (-> bool)
  (let [lits (primitive/code-nth spec 1)]
    (sr--rules-unique? spec lits 2 (primitive/code-count spec))))

; ---- the matcher ------------------------------------------------------------
;; Failure is the sentinel symbol `sr-no-match` rather than an option type:
;; everything here is already Code, so a distinguished symbol costs nothing and
;; keeps every helper returning one type.

(defn sr--ellipsis-pos [(p Code) (i i64) (n i64)] (-> i64)
  (if (>= i n) -1
    (if (sr--ellipsis? (primitive/code-nth p i)) i
      (sr--ellipsis-pos p (+ i 1) n))))

(defn sr--match-fixed [(p Code) (pi i64) (pend i64) (f Code) (fi i64) (fend i64)
                       (bs Code) (lits Code) (defenv Code) (useenv Code)] (-> Code)
  (if (>= pi pend) bs
    (if (>= fi fend) `sr-no-match
      (let [r (sr--match (primitive/code-nth p pi) (primitive/code-nth f fi)
                         bs lits defenv useenv)]
        (if (primitive/code-eq r `sr-no-match) `sr-no-match
          (sr--match-fixed p (+ pi 1) pend f (+ fi 1) fend r lits defenv useenv))))))

;; Match the repeated sub-pattern against each input element, keeping one binding
;; list per repetition. Those per-repetition lists are transposed below into one
;; binding per variable whose value is the whole column.
(defn sr--match-rep [(sub Code) (f Code) (fi i64) (fend i64) (lits Code)
                     (defenv Code) (useenv Code)] (-> Code)
  (if (>= fi fend) `()
    (let [r (sr--match sub (primitive/code-nth f fi) `() lits defenv useenv)]
      (if (primitive/code-eq r `sr-no-match) `sr-no-match
        (let [more (sr--match-rep sub f (+ fi 1) fend lits defenv useenv)]
          (if (primitive/code-eq more `sr-no-match) `sr-no-match
            `(~r ~@more)))))))

;; The values one variable took across every repetition.
(defn sr--column [(reps Code) (i i64) (n i64) (name Code)] (-> Code)
  (if (>= i n) `()
    (let [b (sr--lookup (primitive/code-nth reps i) name 0
                        (primitive/code-count (primitive/code-nth reps i)))]
      (if (= (primitive/code-count b) 0) (sr--column reps (+ i 1) n name)
        `(~(primitive/code-nth b 2) ~@(sr--column reps (+ i 1) n name))))))

;; The repeated sub-pattern may itself contain ellipses. Preserve that existing
;; depth and add the dimension gathered by this outer repetition.
(defn sr--column-depth [(reps Code) (i i64) (n i64) (name Code)] (-> i64)
  (if (>= i n) 1
    (let [b (sr--lookup (primitive/code-nth reps i) name 0
                        (primitive/code-count (primitive/code-nth reps i)))]
      (if (= (primitive/code-count b) 3)
          (+ (primitive/code-int (primitive/code-nth b 1)) 1)
        (sr--column-depth reps (+ i 1) n name)))))

;; Depth-1 bindings, one per variable of the sub-pattern. Driven by the
;; sub-pattern's VARIABLE LIST rather than by what happened to match, so zero
;; repetitions still bind every variable — which is what `(x ...)` against `()`
;; must produce.
(defn sr--transpose [(vars Code) (vi i64) (vn i64) (reps Code) (bs Code)] (-> Code)
  (if (>= vi vn) bs
    (let [name (primitive/code-nth vars vi)]
      (sr--transpose vars (+ vi 1) vn reps
                     `(~@bs (~name
                              ~(sr--column-depth reps 0 (primitive/code-count reps) name)
                              ~(sr--column reps 0 (primitive/code-count reps) name)))))))

;; `_` matches anything and binds nothing; any other symbol is a pattern variable;
;; a list matches structurally; anything else must be equal.
;;
;; A pattern list containing an ellipsis splits three ways:
;;
;;     (p0 … pk   sub ...   q1 … qm)
;;      ^fixed     ^rep      ^tail
;;
;; R5RS allows that FIXED TAIL after the ellipsis, and it is what forces care: the
;; ellipsis cannot simply eat the rest of the input. The tail's length is known
;; from the pattern, so it is reserved from the END first and the ellipsis takes
;; exactly what remains in the middle. `(_ a ... last)` against `(1 2 3)` therefore
;; binds `a` to (1 2) and `last` to 3, where a greedy ellipsis would swallow all
;; three and leave `last` with nothing.
(defn sr--match [(p Code) (f Code) (bs Code) (lits Code)
                 (defenv Code) (useenv Code)] (-> Code)
  (if (primitive/code-sym? p)
      (if (primitive/code-eq p `_) bs
        ; R5RS 4.3.2: a symbol in the literals list is a KEYWORD, not a variable —
        ; it matches only the same identifier and binds nothing. Without this an
        ; `else` pattern would match any symbol and a rebound `else` could never
        ; stop acting as the keyword.
        (if (sr--literal? p lits 0 (primitive/code-count lits))
            (if (sr--literal-match? p f defenv useenv) bs `sr-no-match)
          `(~@bs (~p 0 ~f))))
    (if (primitive/code-vector? p)
        (if (not (primitive/code-vector? f)) `sr-no-match
          (let [pn (primitive/code-count p)
                fcount (primitive/code-count f)
                epos (sr--ellipsis-pos p 0 pn)]
            (if (< epos 0)
                (if (not (= pn fcount)) `sr-no-match
                  (sr--match-fixed p 0 pn f 0 fcount bs lits defenv useenv))
              (let [nfixed (- epos 1)
                    ntail (- pn (+ epos 1))
                    nrep (- (- fcount nfixed) ntail)]
                (if (< nrep 0) `sr-no-match
                  (let [r1 (sr--match-fixed p 0 nfixed f 0 nfixed bs lits defenv useenv)]
                    (if (primitive/code-eq r1 `sr-no-match) `sr-no-match
                      (let [sub (primitive/code-nth p (- epos 1))
                            reps (sr--match-rep sub f nfixed (+ nfixed nrep) lits defenv useenv)]
                        (if (primitive/code-eq reps `sr-no-match) `sr-no-match
                          (let [vars (sr--vars sub `() lits)
                                r2 (sr--transpose vars 0 (primitive/code-count vars) reps r1)]
                            (sr--match-fixed p (+ epos 1) pn f (+ nfixed nrep) fcount
                                             r2 lits defenv useenv)))))))))))
    (if (primitive/code-list? p)
        (if (or (primitive/code-vector? f) (not (primitive/code-list? f))) `sr-no-match
          (let [pn (primitive/code-count p)
                fcount (primitive/code-count f)
                epos (sr--ellipsis-pos p 0 pn)]
            (if (< epos 0)
                (if (not (= pn fcount)) `sr-no-match
                  (sr--match-fixed p 0 pn f 0 fcount bs lits defenv useenv))
              (let [nfixed (- epos 1)
                    ntail (- pn (+ epos 1))
                    nrep (- (- fcount nfixed) ntail)]
                (if (< nrep 0) `sr-no-match
                  (let [r1 (sr--match-fixed p 0 nfixed f 0 nfixed bs lits defenv useenv)]
                    (if (primitive/code-eq r1 `sr-no-match) `sr-no-match
                      (let [sub (primitive/code-nth p (- epos 1))
                            reps (sr--match-rep sub f nfixed (+ nfixed nrep) lits defenv useenv)]
                        (if (primitive/code-eq reps `sr-no-match) `sr-no-match
                          (let [vars (sr--vars sub `() lits)
                                r2 (sr--transpose vars 0 (primitive/code-count vars) reps r1)]
                            (sr--match-fixed p (+ epos 1) pn f (+ nfixed nrep) fcount
                                             r2 lits defenv useenv)))))))))))
      (if (primitive/code-eq p f) bs `sr-no-match)))))

; ---- the template instantiator ----------------------------------------------
;; A symbol bound at depth 0 is replaced by its match. A symbol that is NOT bound
;; is a template-introduced identifier and is left exactly as written — that is
;; where hygiene happens, because the quasiquote around the finished template
;; renames it and it cannot capture at the use site.

;; How many repetitions a sub-template calls for: the length of the first depth-1
;; column among its variables. They were gathered together, so they agree.
(defn sr--rep-count [(vars Code) (i i64) (n i64) (bs Code)] (-> i64)
  (if (>= i n) 0
    (let [b (sr--lookup bs (primitive/code-nth vars i) 0 (primitive/code-count bs))]
      ; an unbound name yields the EMPTY list, so its count must be checked before
      ; any slot of it is read
      (if (and (= (primitive/code-count b) 3)
               (> (primitive/code-int (primitive/code-nth b 1)) 0))
          (primitive/code-count (primitive/code-nth b 2))
        (sr--rep-count vars (+ i 1) n bs)))))

(defn sr--has-repeated-var? [(vars Code) (i i64) (n i64) (bs Code)] (-> bool)
  (if (>= i n) false
    (let [b (sr--lookup bs (primitive/code-nth vars i) 0 (primitive/code-count bs))]
      (if (and (= (primitive/code-count b) 3)
               (> (primitive/code-int (primitive/code-nth b 1)) 0))
          true
        (sr--has-repeated-var? vars (+ i 1) n bs)))))

;; The bindings for ONE repetition: each depth-1 variable narrows to its k-th
;; element and becomes depth 0, while depth-0 variables pass through unchanged so
;; a fixed variable may be referenced inside an ellipsis.
(defn sr--slice [(bs Code) (i i64) (n i64) (k i64)] (-> Code)
  (if (>= i n) `()
    (let [b (primitive/code-nth bs i)]
      `(~(if (and (> (primitive/code-int (primitive/code-nth b 1)) 0)
                  (> (primitive/code-count (primitive/code-nth b 2)) k))
             `(~(primitive/code-nth b 0)
                ~(- (primitive/code-int (primitive/code-nth b 1)) 1)
                ~(primitive/code-nth (primitive/code-nth b 2) k))
           b)
        ~@(sr--slice bs (+ i 1) n k)))))

(defn sr--expand-reps [(sub Code) (bs Code) (k i64) (n i64)] (-> Code)
  (if (>= k n) `()
    `(~(sr--expand sub (sr--slice bs 0 (primitive/code-count bs) k))
      ~@(sr--expand-reps sub bs (+ k 1) n))))

;; Walk a template list, splicing `sub ...` in place and expanding the rest
;; pointwise. Nested `((n v) ...)` works because the sub-template is instantiated
;; once per repetition against that repetition's slice of every column.
(defn sr--expand-list [(t Code) (i i64) (n i64) (bs Code)] (-> Code)
  (if (>= i n) `()
    (if (sr--followed-by-ellipsis? t i n)
        (let [sub (primitive/code-nth t i)
              vars (sr--vars sub `() `())]
          (if (not (sr--has-repeated-var? vars 0 (primitive/code-count vars) bs))
              (primitive/error "syntax-rules: template ellipsis has no repeated pattern variable")
            `(~@(sr--expand-reps sub bs 0
                                 (sr--rep-count vars 0 (primitive/code-count vars) bs))
              ; continue AFTER the ellipsis token
              ~@(sr--expand-list t (+ i 2) n bs))))
      `(~(sr--expand (primitive/code-nth t i) bs)
        ~@(sr--expand-list t (+ i 1) n bs)))))

(defn sr--expand [(t Code) (bs Code)] (-> Code)
  (if (primitive/code-sym? t)
      (let [b (sr--lookup bs t 0 (primitive/code-count bs))]
        (if (= (primitive/code-count b) 3) (primitive/code-nth b 2) t))
    (if (primitive/code-vector? t)
        `#(~@(sr--expand-list t 0 (primitive/code-count t) bs))
    (if (primitive/code-list? t)
        (sr--expand-list t 0 (primitive/code-count t) bs)
      t))))

; ---- rule selection ---------------------------------------------------------
;; Rules are tried in order and the first whose pattern matches wins — R5RS's
;; order, which is what makes `((_) …)` then `((_ e) …)` then `((_ e r ...) …)`
;; behave as written.
;;
;; The pattern's FIRST position is ignored per R5RS 4.3.2: it names the macro
;; itself (or is `_`), so matching starts at index 1 against the argument list.
(defn sr--try-rules [(rules Code) (i i64) (n i64) (args Code) (lits Code)
                     (defenv Code) (useenv Code)] (-> Code)
  (if (>= i n) (primitive/error "syntax-rules: no matching rule")
    (let [rule (primitive/code-nth rules i)
          pat (primitive/code-nth rule 0)
          tmpl (primitive/code-nth rule 1)
          prest `(~@(num--rest pat 1 (primitive/code-count pat)))
          bs (sr--match prest args `() lits defenv useenv)]
      (if (primitive/code-eq bs `sr-no-match)
          (sr--try-rules rules (+ i 1) n args lits defenv useenv)
        (sr--expand tmpl bs)))))

;; Validate the structural shell before any matcher reads positional slots.
;; Malformed macro declarations are program errors, but reporting the macro
;; error is substantially better than leaking a `code-nth` implementation
;; failure from the compiler's metaprogram evaluator.
(defn sr--rules-well-formed? [(spec Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) true
    (let [rule (primitive/code-nth spec i)]
      (and (primitive/code-list? rule)
           (and (= (primitive/code-count rule) 2)
                (let [pat (primitive/code-nth rule 0)]
                  (and (primitive/code-list? pat)
                       (and (> (primitive/code-count pat) 0)
                            (sr--rules-well-formed? spec (+ i 1) n)))))))))

;; The entry point: given a `(syntax-rules (literals…) rules…)` form and the
;; actual arguments, produce the expansion.
;;
;; Direct Coil users call this from an ordinary Code-returning macro. Scheme's
;; `define-syntax` is implemented one layer above, in the dialect transform,
;; because Coil collects host macro names before transforms run. The dialect
;; stores the syntax-rules spec and expands its uses before the host expander;
;; it does not attempt to generate a late Coil macro declaration.
(defn syntax-rules-expand-context [(spec Code) (args Code)
                                   (defenv Code) (useenv Code)] (-> Code)
  (if (or (< (primitive/code-count spec) 3)
          (not (primitive/code-list? (primitive/code-nth spec 1))))
      (primitive/error "syntax-rules: expected literal list and at least one rule")
    (if (not (sr--rules-well-formed? spec 2 (primitive/code-count spec)))
        (primitive/error "syntax-rules: each rule must be (nonempty-pattern template)")
      (if (not (syntax-rules-patterns-unique? spec))
          (primitive/error "syntax-rules: pattern variable appears more than once")
        (let [lits (primitive/code-nth spec 1)]
          (sr--try-rules spec 2 (primitive/code-count spec) args lits defenv useenv))))))

(defn syntax-rules-expand [(spec Code) (args Code)] (-> Code)
  (syntax-rules-expand-context spec args `() `()))


;; ---- the R5RS surface ------------------------------------------------------
;; The `scm-` spellings above are implementation detail. These re-bind each under
;; the name a Scheme program actually writes, and only these are exported — so
;; `(abs x)` works and `(scm-abs x)` is undefined at the call site.
(defn abs [(a i64)] (-> i64) (scm-abs a))
(defn acos [(a i64)] (-> i64) (scm-acos a))
(defn asin [(a i64)] (-> i64) (scm-asin a))
(defn atan [(a Code) & (rest Code)] (-> Code)
  (if (= (primitive/code-count rest) 0) `(scm-atan1 ~a)
    `(scm-atan2 ~a ~(primitive/code-nth rest 0))))
(defn cos [(a i64)] (-> i64) (scm-cos a))
(defn complex? [(a i64)] (-> i64) (scm-complex? a))
(defn real? [(a i64)] (-> i64) (scm-real? a))
(defn rational? [(a i64)] (-> i64) (scm-rational? a))
(defn numerator [(a i64)] (-> i64) (scm-numerator a))
(defn denominator [(a i64)] (-> i64) (scm-denominator a))
(defn make-rectangular [(a i64) (b i64)] (-> i64) (scm-make-rectangular a b))
(defn make-polar [(a i64) (b i64)] (-> i64) (scm-make-polar a b))
(defn real-part [(a i64)] (-> i64) (scm-real-part a))
(defn imag-part [(a i64)] (-> i64) (scm-imag-part a))
(defn magnitude [(a i64)] (-> i64) (scm-magnitude a))
(defn angle [(a i64)] (-> i64) (scm-angle a))
(defn rationalize [(a i64) (b i64)] (-> i64) (scm-rationalize a b))
(defn even? [(a i64)] (-> i64) (scm-even? a))
(defn exact->inexact [(a i64)] (-> i64) (scm-exact->inexact a))
(defn inexact->exact [(a i64)] (-> i64) (scm-inexact->exact a))
(defn exact? [(a i64)] (-> i64) (scm-exact? a))
(defn expt [(a i64) (b i64)] (-> i64) (scm-expt a b))
(defn exp [(a i64)] (-> i64) (scm-exp a))
(defn inexact? [(a i64)] (-> i64) (scm-inexact? a))
(defn integer? [(a i64)] (-> i64) (scm-integer? a))
(defn log [(a i64)] (-> i64) (scm-log a))
(defn modulo [(a i64) (b i64)] (-> i64) (scm-modulo a b))
(defn negative? [(a i64)] (-> i64) (scm-negative? a))
(defn number? [(a i64)] (-> i64) (scm-number? a))
(defn odd? [(a i64)] (-> i64) (scm-odd? a))
(defn positive? [(a i64)] (-> i64) (scm-positive? a))
(defn quotient [(a i64) (b i64)] (-> i64) (scm-quotient a b))
(defn remainder [(a i64) (b i64)] (-> i64) (scm-remainder a b))
(defn floor [(a i64)] (-> i64) (scm-floor a))
(defn ceiling [(a i64)] (-> i64) (scm-ceiling a))
(defn truncate [(a i64)] (-> i64) (scm-truncate a))
(defn round [(a i64)] (-> i64) (scm-round a))
(defn sin [(a i64)] (-> i64) (scm-sin a))
(defn sqrt [(a i64)] (-> i64) (scm-sqrt a))
(defn tan [(a i64)] (-> i64) (scm-tan a))
(defn zero? [(a i64)] (-> i64) (scm-zero? a))

;; ⚠ EXPORT ONLY THE R5RS-SPELLED SURFACE.
;;
;; This module's `scm-` names are implementation spellings. If they were exported
;; they would reach every Scheme program through the umbrella, and `(scm-append
;; a b)` would compile — at which point the language being written is a lookalike
;; rather than Scheme. `coil.scheme.r5rs` reaches them through a qualified alias
;; and re-binds each under its standard name.
;; The `scm-` names are exported for two consumers that are NOT Scheme source:
;; numeric_test.coil, which tests the implementation, and macros elsewhere that
;; expand to them. `coil.scheme.lint` still rejects any of them written by hand in
;; a module that imports coil.scheme, so exporting them does not put them back in
;; the Scheme surface — it only makes them reachable to the implementation.
(export
        scm-abs
        scm-acos
        scm-asin
        scm-atan1
        scm-atan2
        scm-atan-args
        scm-cos
        scm-complex?
        scm-complex-literal
        scm-real?
        scm-rational?
        scm-numerator
        scm-denominator
        scm-make-rectangular
        scm-make-polar
        scm-real-part
        scm-imag-part
        scm-magnitude
        scm-angle
        scm-rationalize
        scm-even?
        scm-exact->inexact
        scm-inexact->exact
        scm-exact?
        scm-expt
        scm-exp
        scm-gcd
        scm-gcd2
        scm-gcd-args
        scm-inexact?
        scm-integer?
        scm-lcm
        scm-lcm2
        scm-lcm-args
        scm-log
        scm-max
        scm-max2
        scm-max-args
        scm-min
        scm-min2
        scm-min-args
        scm-modulo
        scm-negative?
        scm-num-eqv
        scm-num-ge
        scm-num-gt
        scm-num-le
        scm-num-lt
        scm-number->string1
        scm-number->string2
        scm-number->string-args
        scm-number?
        scm-odd?
        scm-positive?
        scm-quotient
        scm-remainder
        scm-floor
        scm-ceiling
        scm-truncate
        scm-round
        scm-sin
        scm-sqrt
        scm-tan
        scm-string->number1
        scm-string->number2
        scm-string->number-args
        scm-zero?)

;; The names below the blank line are reached by numeric_test.coil, which is part of
;; the implementation rather than the Scheme surface. They are exported for it and
;; are still not R5RS spellings, so the lint keeps them unwritable in Scheme source.
(export
        num-lt
        num-gt
        num-le
        num-ge
        num-eq
        num--rest
        num--fold
        num--chain
        num--cmp
        expt-i
        gcd2
        mk-string
        string-slice
        num->str
        str->num
        parse-number-slice
        parse-prefixed-number-slice
        parse-prefixed-number-tail
        scm-prefixed-number-literal
        digit-char
        char-digit

        abs
        acos
        asin
        atan
        ceiling
        cos
        complex?
        real?
        rational?
        numerator
        denominator
        make-rectangular
        make-polar
        real-part
        imag-part
        magnitude
        angle
        rationalize
        even?
        exact->inexact
        exact?
        expt
        exp
        inexact?
        inexact->exact
        integer?
        log
        modulo
        negative?
        number->string
        number?
        odd?
        positive?
        quotient
        remainder
        floor
        round
        sin
        sqrt
        string->number
        syntax-rules-expand
        syntax-rules-expand-context
        syntax-rules-patterns-unique?
        truncate
        tan
        zero?)
