(module coil.scheme.continuation)
(import "coil.primitive" :as primitive)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)

;; Persistent continuation frames for the continuation-aware Scheme evaluator.
;;
;; Frames are immutable after construction. A captured continuation is therefore
;; just a pointer to a frame chain: invoking it never consumes or mutates the
;; chain, which is the representation invariant required by R5RS's unlimited,
;; multi-shot extent. `data` is a traced Scheme value containing the operands
;; needed by the frame. `next` is another frame or `()` for the halt frame.
;; Dynamic-wind state deliberately lives in the frame data rather than a native
;; cleanup stack; a later transfer can compare wind chains without depending on
;; the Coil or C stack.
(defn make-continuation-frame [(kind i64) (data i64) (next i64)] (-> i64)
  (allocate (tag-continuation) (mk-fixnum kind) data next))

(defn continuation-kind [(k i64)] (-> i64)
  (fixnum-value (.a (obj-of k))))

(defn continuation-data [(k i64)] (-> i64)
  (.b (obj-of k)))

(defn continuation-next [(k i64)] (-> i64)
  (.c (obj-of k)))

(defn continuation-frame? [(v i64)] (-> bool)
  (is-continuation v))

;; Frame kinds are functions instead of host constants so generated code can use
;; them without introducing a second representation. Keep zero as halt: it makes
;; malformed fall-through obvious in the dispatcher and leaves the remaining
;; values available for evaluator contexts.
(defn continuation-halt-kind [] (-> i64)
  0)
(defn continuation-if-kind [] (-> i64)
  1)
(defn continuation-sequence-kind [] (-> i64)
  2)
(defn continuation-operator-kind [] (-> i64)
  3)
(defn continuation-argument-kind [] (-> i64)
  4)
(defn continuation-define-kind [] (-> i64)
  5)
(defn continuation-set-kind [] (-> i64)
  6)
(defn continuation-callcc-kind [] (-> i64)
  7)
(defn continuation-values-kind [] (-> i64)
  8)
(defn continuation-wind-before-kind [] (-> i64)
  9)
(defn continuation-wind-after-kind [] (-> i64)
  10)
(defn continuation-for-each-kind [] (-> i64)
  11)
(defn continuation-map-kind [] (-> i64)
  12)
(defn continuation-wind-finish-kind [] (-> i64)
  13)
(defn continuation-transfer-kind [] (-> i64)
  14)
(defn continuation-force-kind [] (-> i64)
  15)
(defn continuation-and-kind [] (-> i64)
  16)
(defn continuation-or-kind [] (-> i64)
  17)
(defn continuation-load-kind [] (-> i64)
  18)
(defn continuation-close-input-kind [] (-> i64)
  19)
(defn continuation-close-output-kind [] (-> i64)
  20)
(defn continuation-input-extent-kind [] (-> i64)
  21)
(defn continuation-output-extent-kind [] (-> i64)
  22)

(defn make-halt-continuation [] (-> i64)
  (make-continuation-frame (continuation-halt-kind) (s-nil) (s-nil)))

(export make-continuation-frame
        make-halt-continuation
        continuation-frame?
        continuation-kind
        continuation-data
        continuation-next
        continuation-halt-kind
        continuation-if-kind
        continuation-sequence-kind
        continuation-operator-kind
        continuation-argument-kind
        continuation-define-kind
        continuation-set-kind
        continuation-callcc-kind
        continuation-values-kind
        continuation-wind-before-kind
        continuation-wind-after-kind
        continuation-for-each-kind
        continuation-map-kind
        continuation-wind-finish-kind
        continuation-transfer-kind
        continuation-force-kind
        continuation-and-kind
        continuation-or-kind
        continuation-load-kind
        continuation-close-input-kind
        continuation-close-output-kind
        continuation-input-extent-kind
        continuation-output-extent-kind)
