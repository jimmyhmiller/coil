(module coil.scheme.eval-test)
(import "coil.assert" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.forms" :use [quote-data])
(import "coil.scheme.symbol" :use [intern])
(import "coil.scheme.eval" :use *)
(import "coil.scheme.stdproc" :as stdproc)
(import "coil.scheme.port" :as scheme-port)

(deftest evaluated-expression-and-environment-survive-collection
  (let [expression (quote-data ((lambda (x) (+ x 1)) 41))
        environment (scheme-report-environment (mk-fixnum 5))]
    ;; `collect` is an explicit implementation hook rather than an allocating
    ;; call the rooting pass recognizes, so state its live roots at this boundary.
    (gc-root expression)
    (gc-root environment)
    (collect)
    (assert-eq (fixnum-value (eval expression environment)) 42)))

(deftest continuation-evaluator-supports-escape
  (let [environment (scheme-report-environment (mk-fixnum 5))]
           (assert-eq (fixnum-value (continuation-eval (quote-data (call-with-current-continuation (lambda (k)
                                                                                                           (+ 1 (k 42)))))
          environment))
      42)))

(deftest continuation-evaluator-is-multi-shot-after-capture-returns
  ;; The same saved continuation is invoked twice after its original call/cc has
  ;; returned. Each invocation resumes at the pending `+`, then repeats the rest
  ;; of the begin sequence. A one-shot escape implementation cannot produce 4.
  (let [environment (scheme-report-environment (mk-fixnum 5))]
           (assert-eq (fixnum-value (continuation-eval (quote-data (begin (define k #f)
              (define count 0)
              (define result
                                                                                  (+ 1
                                                                                     (call-with-current-continuation (lambda (captured)
                                                                                                                             (set! k
                                                                                                                                   captured)
                                                                                                                             1))))
              (set! count (+ count 1))
              (if (< count 3) (k (+ count 1)) result)))
          environment))
      4)))

(deftest continuation-reentry-preserves-the-rest-of-the-outer-sequence
         (let [environment (scheme-report-environment (mk-fixnum 5))]
           (assert-eq (fixnum-value (continuation-eval (quote-data (begin (define k #f)
                                                                          (define count 0)
                                                                          (define result
                                                                                  (+ 1
                                                                                     (call/cc (lambda (c) (set! k c) 1))))
                                                                          (set! count (+ count 1))
                                                                          (if (< count 3) (k (+ count 1)) 'finished)
                                                                          999))
                                                       environment))
                      999)))

(deftest captured-continuation-survives-collection-and-repeated-invocation
  (let [environment (scheme-report-environment (mk-fixnum 5))]
           (continuation-eval (quote-data (begin (define saved #f)
          (call/cc (lambda (k) (set! saved k) 1))))
      environment)
    ;; The environment retains `saved`; the continuation must in turn retain its
    ;; complete immutable frame chain when every otherwise-dead object is swept.
    (gc-root environment)
    (collect)
           (assert-eq (fixnum-value (continuation-eval (quote-data (saved 42)) environment))
                      42)
           (assert-eq (fixnum-value (continuation-eval (quote-data (saved 43)) environment))
                      43)))

(deftest collection-during-evaluation-traces-the-active-machine-state
         (let [environment (scheme-report-environment (mk-fixnum 5))]
           (assert-eq (fixnum-value (continuation-eval (quote-data (begin (define payload (list 40 2))
                                                                          (define saved #f)
                                                                          (+ (car payload)
                                                                             (call/cc (lambda (k)
                                                                                              (set! saved k)
                                                                                              (cek-collect-now)
                                                                                              (car (cdr payload)))))))
                                                       environment))
                      42)
           ;; `collect` is an explicit implementation hook, so preserve the local
           ;; environment that owns `saved` across this test-only collection boundary.
           (gc-root environment)
           (collect)
           (assert-eq (fixnum-value (continuation-eval (quote-data (saved 3)) environment))
                      43)))

(deftest eval-captures-the-callers-pending-continuation
         ;; `eval` is part of the same Scheme evaluation, not a nested native
         ;; tree-walker. Re-entering the saved continuation must therefore replay the
         ;; pending `+ 10` and the remainder of the caller's sequence.
         (let [environment (interaction-environment)]
           (assert-eq (fixnum-value (continuation-eval (quote-data (begin (define eval-saved #f)
                                                                          (define eval-count 0)
                                                                          (define eval-result
                                                                                  (+ 10
                                                                                     (eval '(call/cc (lambda (k)
                                                                                                             (set! eval-saved
                                                                                                                   k)
                                                                                                             1))
                                                                                           (interaction-environment))))
                                                                          (set! eval-count (+ eval-count 1))
                                                                          (if (< eval-count 2)
                                                                              (eval-saved 5)
                                                                              eval-result)))
                                                       environment))
                      15)))

(deftest eval-expands-runtime-syntax-inside-the-continuation-machine
         (let [environment (interaction-environment)]
           (assert-eq (fixnum-value (continuation-eval (quote-data (begin (define-syntax eval-escape
                                                                                         (syntax-rules ()
                                                                                                       ((_ value) (call/cc (lambda (k)
                                                                                                                                   (k value))))))
                                                                          (+ 1
                                                                             (eval '(eval-escape 41)
                                                                                   (interaction-environment)))))
                                                       environment))
                      42)))

(deftest eval-derived-bindings-remain-continuation-aware
         (let [environment (scheme-report-environment (mk-fixnum 5))]
           (assert-eq (fixnum-value (continuation-eval (quote-data (+ 1
                                                                      (eval '(let ((x (call/cc (lambda (k) (k 40)))))
                                                                               (+ x 1))
                                                                            (scheme-report-environment 5))))
                                                       environment))
                      42)
           (assert-eq (fixnum-value (continuation-eval (quote-data (eval '(letrec ((loop (lambda (n)
                                                                                                 (if (= n 0)
                                                                                                     42
                                                                                                     (loop (- n 1))))))
                                                                                  (loop 1000))
                                                                         (scheme-report-environment 5)))
                                                       environment))
                      42)))

(deftest eval-derived-control-forms-remain-continuation-aware
         (let [environment (scheme-report-environment (mk-fixnum 5))]
           (let [result
                   (continuation-eval (quote-data (list (eval '(and #t (call/cc (lambda (k) (k 7))))
                                                              (scheme-report-environment 5))
                                                        (eval '(or #f (call/cc (lambda (k) (k 8))))
                                                              (scheme-report-environment 5))
                                                        (eval '(cond ((call/cc (lambda (k) (k #t))) 9) (else 0))
                                                              (scheme-report-environment 5))
                                                        (eval '(case (call/cc (lambda (k) (k 2))) ((1) 10)
                                                                     ((2) 11) (else 12))
                                                              (scheme-report-environment 5))
                                                        (eval '(do
                                                                 ((i 0 (+ i (call/cc (lambda (k) (k 1))))))
                                                                 ((= i 3) i))
                                                              (scheme-report-environment 5))))
                                      environment)]
             (assert-eq (fixnum-value (car result)) 7)
             (assert-eq (fixnum-value (stdproc/scm-cadr result)) 8)
             (assert-eq (fixnum-value (stdproc/scm-caddr result)) 9)
             (assert-eq (fixnum-value (car (cdr (cdr (cdr result))))) 11)
             (assert-eq (fixnum-value (car (cdr (cdr (cdr (cdr result)))))) 3))))

(deftest eval-quasiquote-unquotes-remain-continuation-aware
         (let [environment (scheme-report-environment (mk-fixnum 5))
               result
                 (continuation-eval (quote-data (eval '(quasiquote (a (unquote (call/cc (lambda (k) (k 7))))
                                                                      (unquote-splicing (call/cc (lambda (k) (k '(8 9)))))))
                                                      (scheme-report-environment 5)))
                                    environment)]
           (assert (val-eq? (car result) (intern "a")))
           (assert-eq (fixnum-value (stdproc/scm-cadr result)) 7)
           (assert-eq (fixnum-value (stdproc/scm-caddr result)) 8)
           (assert-eq (fixnum-value (car (cdr (cdr (cdr result))))) 9)))

(deftest force-preserves-continuations-and-memoizes-the-resumed-value
         (let [environment (scheme-report-environment (mk-fixnum 5))]
           (let [result
                   (continuation-eval (quote-data (begin (define force-saved #f)
                                                         (define force-first #t)
                                                         (define force-count 0)
                                                         (define force-promise
                                                                 (delay (set! force-count (+ force-count 1))
                                                                        (call/cc (lambda (k) (set! force-saved k) 42))))
                                                         (define force-result (force force-promise))
                                                         (if force-first
                                                             (begin (set! force-first #f) (force-saved 99)))
                                                         (list force-result force-count (force force-promise))))
                                      environment)]
             ;; Re-entering the forcing continuation cannot overwrite the value that
             ;; the original force already memoized.
             (assert-eq (fixnum-value (car result)) 42)
             (assert-eq (fixnum-value (stdproc/scm-cadr result)) 1)
             (assert-eq (fixnum-value (stdproc/scm-caddr result)) 42))))

(deftest recursive-force-keeps-the-first-memoized-value
         (let [environment (scheme-report-environment (mk-fixnum 5))]
           (assert-eq (fixnum-value (continuation-eval (quote-data (letrec ((p (delay (if done
                                                                                          3
                                                                                          (begin (set! done #t)
                                                                                                 (+ (force p) 1))))) (done #f))
                                                                           (force p)))
                                                       environment))
                      3)))

(deftest load-evaluates-forms-in-the-callers-continuation-machine
         (let [environment (interaction-environment)
               result
                 (continuation-eval (quote-data (begin (define load-saved #f)
                                                       (define load-count 0)
                                                       (load "tests/scheme/fixtures/continuation-load.scm"
                                                             (interaction-environment))
                                                       (list load-saved load-count)))
                                    environment)]
           (assert-eq (fixnum-value (car result)) 7)
           ;; The continuation restores Scheme control state, not the external file
           ;; descriptor's already-advanced byte position, so the second form ran once.
           (assert-eq (fixnum-value (stdproc/scm-cadr result)) 1)))

(deftest file-port-extents-follow-continuation-exit-and-reentry
         (let [environment (interaction-environment)
               outer-port (scheme-port/current-input-port)
               result
                 (continuation-eval (quote-data (begin (define port-saved #f)
                                                       (define port-first #t)
                                                       (define inside-port #f)
                                                       (define port-result
                                                               (with-input-from-file "tests/scheme/fixtures/input.txt"
                                                                                     (lambda ()
                                                                                             (set! inside-port
                                                                                                   (current-input-port))
                                                                                             (call/cc (lambda (k)
                                                                                                              (set! port-saved
                                                                                                                    k)
                                                                                                              'initial))
                                                                                             (read-char))))
                                                       (if port-first
                                                           (begin (set! port-first #f) (port-saved 'again)))
                                                       (list port-result
                                                             (eq? (current-input-port) inside-port)
                                                             inside-port)))
                                    environment)]
           ;; Re-entry reopened the same captured port object at the beginning and the
           ;; ordinary return then restored the ambient port and closed the extent.
           (assert-eq (char-value (car result)) 97)
           (assert (val-eq? (stdproc/scm-cadr result) (s-false)))
           (assert (val-eq? (scheme-port/current-input-port) outer-port))
           (assert (not (scheme-port/port-open? (stdproc/scm-caddr result))))))

(deftest escaping-a-file-port-extent-restores-the-ambient-port
         (let [environment (scheme-report-environment (mk-fixnum 5))
               outer-port (scheme-port/current-input-port)]
           (assert-eq (fixnum-value (continuation-eval (quote-data (call/cc (lambda (escape)
                                                                                    (with-input-from-file "tests/scheme/fixtures/input.txt"
                                                                                                          (lambda ()
                                                                                                                  (escape 42))))))
                                                       environment))
                      42)
           (assert (val-eq? (scheme-port/current-input-port) outer-port))))

(deftest interaction-bindings-survive-collection
  (let [environment (interaction-environment)
        definition (quote-data (define persistent-value (list 1 2 3)))
        reference (quote-data persistent-value)]
    (eval definition environment)
    (collect)
    (let [value (eval reference (interaction-environment))]
      (assert-eq (fixnum-value (car value)) 1)
      (assert-eq (fixnum-value (car (cdr value))) 2)
      (assert-eq (fixnum-value (car (cdr (cdr value)))) 3))))

(deftest runtime-eval-expands-define-syntax-and-ellipsis
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (eval (quote-data
            (define-syntax when
              (syntax-rules ()
                ((_ test body ...) (if test (begin body ...))))))
          environment)
    (assert-eq
      (fixnum-value (eval (quote-data (when #t (+ 20 21) (+ 40 2))) environment))
      42)))

(deftest runtime-syntax-rules-is-hygienic-for-introduced-binders
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (eval (quote-data
            (define-syntax add-with-temp
              (syntax-rules ()
                ((_ x) (let ((temp 1)) (+ temp x))))))
          environment)
    ;; The argument `temp` remains a use-site reference; the template's `temp`
    ;; is a distinct introduced binding.
    (assert-eq
      (fixnum-value
        (eval (quote-data (let ((temp 100)) (add-with-temp temp))) environment))
      101)))

(deftest runtime-syntax-rules-keeps-definition-site-free-identifiers
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (eval (quote-data
            (define-syntax add-one
              (syntax-rules () ((_ x) (+ x 1)))))
          environment)
    ;; A use-site binding named `+` must not capture the `+` introduced by the
    ;; macro definition.
    (assert-eq
      (fixnum-value
        (eval (quote-data
                (let ((+ (lambda (a b) 999))) (add-one 41)))
              environment))
      42)))

(deftest runtime-syntax-rules-literals-respect-use-site-shadowing
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (eval (quote-data
            (define-syntax choose
              (syntax-rules (else)
                ((_ else x) x)
                ((_ other x) 0))))
          environment)
    (assert-eq (fixnum-value (eval (quote-data (choose else 7)) environment)) 7)
    (assert-eq
      (fixnum-value
        (eval (quote-data (let ((else #t)) (choose else 7))) environment))
      0)))

(deftest runtime-syntax-rules-matches-and-builds-vectors
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (eval (quote-data
            (define-syntax vector-copy-form
              (syntax-rules ()
                ((_ #(x rest ...)) #(x rest ...)))))
          environment)
    (let [v (eval (quote-data (vector-copy-form #(1 2 3 4))) environment)]
      (assert (is-vector v))
      (assert-eq (fixnum-value (stdproc/scm-vector-ref v (mk-fixnum 0))) 1)
      (assert-eq (fixnum-value (stdproc/scm-vector-ref v (mk-fixnum 3))) 4))))

(deftest runtime-syntax-rules-preserves-two-ellipsis-depths
  (let [environment (scheme-report-environment (mk-fixnum 5))]
           (eval (quote-data (define-syntax nested-copy-form
              (syntax-rules ()
                ((_ ((x ...) ...)) (list (list x ...) ...)))))
          environment)
    (let [rows (eval (quote-data (nested-copy-form ((1 2) (3)))) environment)]
      (assert-eq (stdproc/list--length rows 0) 2)
      (assert-eq (stdproc/list--length (car rows) 0) 2)
      (assert-eq (stdproc/list--length (car (cdr rows)) 0) 1))))

(deftest runtime-let-syntax-is-lexical
  (let [environment (scheme-report-environment (mk-fixnum 5))]
           (assert-eq (fixnum-value (eval (quote-data (let-syntax ((twice (syntax-rules () ((_ x) (+ x x)))))
                  (twice 21)))
              environment))
      42)))

(deftest runtime-letrec-syntax-supports-mutual-recursion
  (let [environment (scheme-report-environment (mk-fixnum 5))]
           (assert-eq (fixnum-value (eval (quote-data (letrec-syntax ((ping (syntax-rules () ((_ x) (pong x)))) (pong (syntax-rules ()
                                                                                                                                    ((_ x) x))))
                  (ping 42)))
              environment))
      42)))
