(module coil.scheme.eval-test)
(import "coil.assert" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.forms" :use [quote-data])
(import "coil.scheme.eval" :use *)
(import "coil.scheme.stdproc" :as stdproc)

(deftest evaluated-expression-and-environment-survive-collection
  (let [expression (quote-data ((lambda (x) (+ x 1)) 41))
        environment (scheme-report-environment (mk-fixnum 5))]
    ;; `collect` is an explicit implementation hook rather than an allocating
    ;; call the rooting pass recognizes, so state its live roots at this boundary.
    (gc-root expression)
    (gc-root environment)
    (collect)
    (assert-eq (fixnum-value (eval expression environment)) 42)))

(deftest continuation-evaluator-supports-escape
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (assert-eq
      (fixnum-value
        (continuation-eval
          (quote-data
            (call-with-current-continuation (lambda (k) (+ 1 (k 42)))))
          environment))
      42)))

(deftest continuation-evaluator-is-multi-shot-after-capture-returns
  ;; The same saved continuation is invoked twice after its original call/cc has
  ;; returned. Each invocation resumes at the pending `+`, then repeats the rest
  ;; of the begin sequence. A one-shot escape implementation cannot produce 4.
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (assert-eq
      (fixnum-value
        (continuation-eval
          (quote-data
            (begin
              (define k #f)
              (define count 0)
              (define result
                (+ 1 (call-with-current-continuation
                       (lambda (captured) (set! k captured) 1))))
              (set! count (+ count 1))
              (if (< count 3) (k (+ count 1)) result)))
          environment))
      4)))

(deftest captured-continuation-survives-collection-and-repeated-invocation
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (continuation-eval
      (quote-data
        (begin
          (define saved #f)
          (call/cc (lambda (k) (set! saved k) 1))))
      environment)
    ;; The environment retains `saved`; the continuation must in turn retain its
    ;; complete immutable frame chain when every otherwise-dead object is swept.
    (gc-root environment)
    (collect)
    (assert-eq
      (fixnum-value (continuation-eval (quote-data (saved 42)) environment)) 42)
    (assert-eq
      (fixnum-value (continuation-eval (quote-data (saved 43)) environment)) 43)))

(deftest interaction-bindings-survive-collection
  (let [environment (interaction-environment)
        definition (quote-data (define persistent-value (list 1 2 3)))
        reference (quote-data persistent-value)]
    (eval definition environment)
    (collect)
    (let [value (eval reference (interaction-environment))]
      (assert-eq (fixnum-value (car value)) 1)
      (assert-eq (fixnum-value (car (cdr value))) 2)
      (assert-eq (fixnum-value (car (cdr (cdr value)))) 3))))

(deftest runtime-eval-expands-define-syntax-and-ellipsis
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (eval (quote-data
            (define-syntax when
              (syntax-rules ()
                ((_ test body ...) (if test (begin body ...))))))
          environment)
    (assert-eq
      (fixnum-value (eval (quote-data (when #t (+ 20 21) (+ 40 2))) environment))
      42)))

(deftest runtime-syntax-rules-is-hygienic-for-introduced-binders
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (eval (quote-data
            (define-syntax add-with-temp
              (syntax-rules ()
                ((_ x) (let ((temp 1)) (+ temp x))))))
          environment)
    ;; The argument `temp` remains a use-site reference; the template's `temp`
    ;; is a distinct introduced binding.
    (assert-eq
      (fixnum-value
        (eval (quote-data (let ((temp 100)) (add-with-temp temp))) environment))
      101)))

(deftest runtime-syntax-rules-keeps-definition-site-free-identifiers
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (eval (quote-data
            (define-syntax add-one
              (syntax-rules () ((_ x) (+ x 1)))))
          environment)
    ;; A use-site binding named `+` must not capture the `+` introduced by the
    ;; macro definition.
    (assert-eq
      (fixnum-value
        (eval (quote-data
                (let ((+ (lambda (a b) 999))) (add-one 41)))
              environment))
      42)))

(deftest runtime-syntax-rules-literals-respect-use-site-shadowing
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (eval (quote-data
            (define-syntax choose
              (syntax-rules (else)
                ((_ else x) x)
                ((_ other x) 0))))
          environment)
    (assert-eq (fixnum-value (eval (quote-data (choose else 7)) environment)) 7)
    (assert-eq
      (fixnum-value
        (eval (quote-data (let ((else #t)) (choose else 7))) environment))
      0)))

(deftest runtime-syntax-rules-matches-and-builds-vectors
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (eval (quote-data
            (define-syntax vector-copy-form
              (syntax-rules ()
                ((_ #(x rest ...)) #(x rest ...)))))
          environment)
    (let [v (eval (quote-data (vector-copy-form #(1 2 3 4))) environment)]
      (assert (is-vector v))
      (assert-eq (fixnum-value (stdproc/scm-vector-ref v (mk-fixnum 0))) 1)
      (assert-eq (fixnum-value (stdproc/scm-vector-ref v (mk-fixnum 3))) 4))))

(deftest runtime-syntax-rules-preserves-two-ellipsis-depths
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (eval (quote-data
            (define-syntax nested-copy-form
              (syntax-rules ()
                ((_ ((x ...) ...)) (list (list x ...) ...)))))
          environment)
    (let [rows (eval (quote-data (nested-copy-form ((1 2) (3)))) environment)]
      (assert-eq (stdproc/list--length rows 0) 2)
      (assert-eq (stdproc/list--length (car rows) 0) 2)
      (assert-eq (stdproc/list--length (car (cdr rows)) 0) 1))))

(deftest runtime-let-syntax-is-lexical
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (assert-eq
      (fixnum-value
        (eval (quote-data
                (let-syntax
                  ((twice (syntax-rules () ((_ x) (+ x x)))))
                  (twice 21)))
              environment))
      42)))

(deftest runtime-letrec-syntax-supports-mutual-recursion
  (let [environment (scheme-report-environment (mk-fixnum 5))]
    (assert-eq
      (fixnum-value
        (eval (quote-data
                (letrec-syntax
                  ((ping (syntax-rules () ((_ x) (pong x))))
                   (pong (syntax-rules () ((_ x) x))))
                  (ping 42)))
              environment))
      42)))
