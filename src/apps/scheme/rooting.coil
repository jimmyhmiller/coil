(module coil.scheme.rooting)
(import "coil.primitive" :as primitive)
(import "coil.str" :use *)
(import "coil.io" :as io)

(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))
(defn rt--trace-form [(event (slice u8)) (i i64) (form Code)] (-> i64)
  (let [enabled (getenv c"COIL_SCHEME_TRACE")]
    (if (= (primitive/cast i64 enabled) 0)
        0
        (let [w (io/stderr)]
          (io/print-str w "scheme-rooting  ")
          (io/print-str w event)
          (io/print-str w "  top-level=")
          (io/print-int w i)
          (io/print-str w "  head=")
          (if (and (primitive/code-list? form) (> (primitive/code-count form) 0))
              (io/print-str w (primitive/code-str (primitive/code-nth form 0)))
              (io/print-str w "<atom>"))
          (io/write-byte w (primitive/cast u8 10))
          0))))

;; THE GC PILLAR: automatic rooting.
;;
;; A Scheme value lives on the heap and the collector is PRECISE — it traces from
;; a root set, not by scanning the machine stack. So a value held only in a Coil
;; function's frame is invisible to it. `(cons (make-tree …) (make-tree …))` builds
;; the left subtree, holds it in a frame slot, and then allocates the right one:
;; if that allocation collects, the left subtree has no root and is swept out from
;; under the program.
;;
;; That is not hypothetical. It is what made `bintree` SIGSEGV on its SECOND
;; collection — the first collection happens while little is live, the second
;; while a partially-built tree is. `heap.coil` has always documented a shadow
;; stack and said "the GC transform emits gc-root/gc-sp/gc-sp-set!"; this is that
;; transform, which had not been written.
;;
;; ── WHAT IT EMITS ───────────────────────────────────────────────────────────
;;
;; Each Scheme `define` gets a frame, and every value that must survive a later
;; allocation is pushed onto the shadow stack:
;;
;;     (define (f a b) BODY)
;;  => (defn f [(a i64) (b i64)] (-> i64)
;;       (let [$sp (gc-sp)]                 ; remember the frame base
;;         (gc-root a) (gc-root b)          ; params can outlive an inner alloc
;;         BODY'))                          ; every EXIT in BODY' pops $sp itself
;;
;; The epilogue lands on the exits rather than wrapping the body, because a
;; wrapping `let` puts every tail call out of tail position and costs TCO. A
;; returning exit becomes `(let [$r V] (gc-sp-set! $sp) $r)` and a tail call
;; becomes `(do (gc-sp-set! $sp) (g …))` — pop, then jump.
;;
;; and an allocating call's arguments are A-normalized into rooted temporaries:
;;
;;     (cons (f x) (g y))
;;  => (let [$1 (f x)] (gc-root $1)
;;        (let [$2 (g y)] (gc-root $2) (cons $1 $2)))
;;
;; The second binding is the whole point: without it, `(g y)` can collect while
;; `$1` is reachable only from a machine register.
;;
;; ── KNOWN LIMITATION: DEEP RECURSION GROWS THE SHADOW STACK ─────────────────
;;
;; ⚠ THIS IS A REAL, MEASURED LIMIT, NOT A THEORETICAL ONE. Read before assuming
;; an allocating benchmark that hangs is slow rather than broken.
;;
;; An earlier version of this comment argued that no tail-call handling was needed
;; because "unbounded tail calls are out of scope, so roots pop with the native
;; stack". That reasoning is WRONG, and the benchmarks disprove it. A Scheme
;; tail call is still a native CALL here, so the caller's frame — and its roots —
;; stay live for the whole recursion. `(rev l acc)` at depth 8000 holds 8000
;; frames' worth of roots simultaneously.
;;
;; Two consequences, both observed:
;;
;;   1. `gc-root` has NO BOUNDS CHECK (heap.coil). Past 1048576 live roots it
;;      writes off the end of the array and keeps incrementing the counter.
;;   2. `mark-roots` traces [0, top) on EVERY collection. A shadow stack in the
;;      hundreds of thousands makes each collection walk all of it, and each entry
;;      roots a long list — so collection cost grows with depth and the program
;;      appears to hang rather than fail.
;;
;; FIXED, by the tail-call reset in `rt--tail` below. Before it, `listrev` (300
;; rounds at depth 8000) and `bintree` (300 rounds at depth 14) did not terminate:
;; every frame's roots stayed live for the whole recursion, so each collection
;; walked a shadow stack in the hundreds of thousands. ANY call in tail position —
;; self or mutual — now drops its frame's roots before jumping, so the shadow
;; stack is bounded by real nesting depth rather than by iteration count.
;;
;; ⚠ THE SAME SHAPE ALSO DECIDES WHETHER TCO HAPPENS AT ALL, which is the part
;; that is easy to get wrong. The epilogue must sit on the EXITS, not wrap the
;; body — see the note above `rt--tail`. A wrapping frame is correct for rooting
;; and silently turns every tail call into a stack-consuming one.
;;
;; MEASURED, in Scheme, at depths no stack could hold:
;;   self-recursive   (count 50000000 0)        -> 50000000, constant stack
;;   mutual           (my-even? 50000000)       -> 1,         constant stack
;;
;; What remains is a genuine limit rather than a bug: deep NON-tail recursion
;; still holds its roots for the duration, which is correct but not free.
;; `gc-root` also has no bounds check past 1048576 entries (heap.coil), which a
;; program with a million simultaneously live roots would run off the end of.
;;
;; ── WHY OVER-APPROXIMATION IS SAFE, AND UNDER- IS NOT ───────────────────────
;;
;; Rooting something that did not need it costs one shadow-stack slot. FAILING to
;; root something that did is a use-after-free that shows up as corrupted data
;; much later, in an unrelated part of the program. So every judgement here is
;; biased toward rooting, and the analysis below treats an unknown call as
;; allocating.

;; A call that can trigger a collection. Only `allocate` collects, so only its
;; callers matter — but a Scheme program's calls are mostly to other Scheme
;; functions, whose bodies allocate. Treating any non-obviously-pure call as
;; allocating is the safe direction.
;;
;; The immediates are the exception worth making, and they are the common case in
;; a loop: `mk-fixnum`, `mk-bool`, `mk-char`, the singletons and the accessors all
;; touch no heap, so a program doing arithmetic pays nothing.
(defn rt--non-allocating? [(h Code)] (-> bool)
  ;; `scm-collected` is also syntax-significant: the variadic-call pass must see
  ;; it directly in the final argument position.  Treating the identity marker
  ;; as allocating A-normalizes it into a temporary and makes that pass collect
  ;; an already-collected rest list a second time.
  (or (rt--member? h
                   `(mk-fixnum mk-char
                               mk-bool
                               s-nil
                               s-true
                               s-false
                               s-unspecified
                               s-eof
                               s-undefined
                               fixnum-value
                               char-value
                               car
                               cdr
                               truthy?
                               is-null
                               val-eq?
                               scm-collected
                               fnptr-of)
                   0)
      (and (primitive/code-sym? h)
           (starts-with (primitive/code-str h) "closure-fnptr"))))

;; Linear membership over a quoted name list — clearer than a 16-deep `or`, and
;; the list is the documentation: these are the operations that touch no heap.
(defn rt--member? [(h Code) (l Code) (i i64)] (-> bool)
  (if (primitive/icmp-ge i (primitive/code-count l))
      false
      (if (primitive/code-eq h (primitive/code-nth l i))
          true
          (rt--member? h l (primitive/iadd i 1)))))

;; Heads whose result is a RAW `bool`, not a Val.
;;
;; ⚠ These must not have their arguments A-normalized. The rewrite turns a call
;; into `(let [$g ARG] (gc-root $g) (head $g))`, and that `let`'s value is then
;; the head's result — so for a bool-returning head the `let` has type `bool`
;; where the surrounding code expects an `i64` Val, and the checker rejects it:
;;
;;     error: in 'f.count': let body has type bool but expected i64
;;
;; `truthy?` is the one that matters, because `forms.coil` lowers EVERY Scheme
;; `if` test to `(truthy? …)` — so any `if` whose test allocates hits this. That
;; is most of them: `(if (< n 1) …)` allocates, since `<` builds a Val.
;;
;; Leaving the argument un-normalized is safe here precisely BECAUSE the result
;; is a bool: a bool is not a heap value, nothing downstream can hold it, and the
;; argument is consumed immediately by a non-allocating predicate. There is no
;; window in which a collection could run between the two.
(defn rt--bool-head? [(h Code)] (-> bool)
  (rt--member? h
               `(truthy? is-null
                         val-eq?
                         is-heap
                         is-fixnum
                         is-char
                         is-pair
                         is-symbol
                         is-string
                         is-procedure
                         is-singleton
                         is-vector
                         undefined?
                         symbol-eq?
                         str-eq)
               0))

;; ── FORMS WHOSE ELEMENT 1 IS A BINDER LIST, NOT AN EXPRESSION ────────────────
;;
;; ⚠ AN OMISSION FROM THIS LIST DOES NOT FAIL LOUDLY — IT DELETES CODE. A walk
;; that treats element 1 as an expression rewrites `((a 1) (b 2))` as if it were
;; a call, and what reaches the macro is an empty binding list. The program then
;; fails with `unbound variable 'a'` pointed at the USER's source, with the
;; bindings simply gone and nothing naming the pass that removed them.
;;
;; That is exactly what `scm-let` did before it was added here: `let` was
;; special-cased and its Scheme spelling was not, so every Scheme `let` in the
;; language silently lost its bindings. Two passes were investigated at length
;; and both were innocent.
;;
;; So this is ONE list, checked by one predicate, rather than a shape test
;; repeated per site. Adding a binding form to the dialect means adding it here.
(defn rt--binder-list-form? [(h Code)] (-> bool)
  (or (primitive/code-eq h `let)
      (or (primitive/code-eq h `scm-let)
          (or (primitive/code-eq h `let*)
              (or (primitive/code-eq h `letrec)
                  (or (primitive/code-eq h `letrec*)
                      (primitive/code-eq h `scm-do)))))))

;; Forms that are syntax rather than calls: rewriting their heads or descending
;; into their binders would corrupt them.
(defn rt--syntax? [(h Code)] (-> bool)
  (or (rt--binder-list-form? h)
      (or (primitive/code-eq h `if)
          (or (primitive/code-eq h `do)
              (or (primitive/code-eq h `scm-case)
                  (or (primitive/code-eq h `cond)
                      (or (primitive/code-eq h `scm-quasiquote)
                          (or (primitive/code-eq h `quote)
                              (or (primitive/code-eq h `loop)
                                  (or (primitive/code-eq h `break)
                                      (primitive/code-eq h `continue)))))))))))

;; Does evaluating `e` reach an allocation? Over-approximates: any call whose head
;; is not on the immediate list counts, and so does any subexpression containing
;; one. A false "yes" costs a shadow-stack slot; a false "no" is a dangling value.
(defn rt--allocates? [(e Code)] (-> bool)
  (if (not (primitive/code-list? e))
      false
      (if (primitive/icmp-eq (primitive/code-count e) 0)
          false
          (let [h (primitive/code-nth e 0)]
            (if (primitive/code-eq h `quote)
                false
                (if (and (primitive/code-sym? h)
                         (and (not (rt--syntax? h)) (not (rt--non-allocating? h))))
                    true
                    (rt--any-allocates? e 1 (primitive/code-count e))))))))

(defn rt--any-allocates? [(e Code) (i i64) (n i64)] (-> bool)
  (if (primitive/icmp-ge i n)
      false
      (if (rt--allocates? (primitive/code-nth e i))
          true
          (rt--any-allocates? e (primitive/iadd i 1) n))))

;; A-normalize a call's arguments, rooting each one that allocated.
;;
;; ⚠ The test is on the ORIGINAL argument, not the rewritten one: rewriting may
;; have wrapped an allocating call in a `let`, which would hide its allocating-ness
;; from a naive check — and its result still has to survive the NEXT argument's
;; allocation. Getting this backwards is silent and rare, which is the worst
;; combination.
(defn rt--args [(head Code) (e Code) (i i64) (n i64) (placed Code)] (-> Code)
  (if (primitive/icmp-ge i n)
      `(~head ~@placed)
      (let [orig (primitive/code-nth e i)
            arg (rt--expr orig)]
        (if (rt--allocates? orig)
            (let [g (primitive/gensym)]
              `(let [~g ~arg]
                 (gc-root ~g)
                 ~(rt--args head e (primitive/iadd i 1) n `(~@placed ~g))))
            (rt--args head e (primitive/iadd i 1) n `(~@placed ~arg))))))

;; Copy elements [i, n) unchanged — for clause lists, whose heads are data or
;; tests rather than callees.
(defn rt--verbatim [(e Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n)
      `()
      (primitive/code-cons (primitive/code-nth e i)
                           (rt--verbatim e (primitive/iadd i 1) n))))

(defn rt--all [(e Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n)
      `()
      (primitive/code-cons (rt--expr (primitive/code-nth e i))
                           (rt--all e (primitive/iadd i 1) n))))

;; Preserve a case clause's datum head while rooting its body. The dialect has
;; already lowered Scheme binders by this point, so these bodies are ordinary
;; executable forms and must not remain opaque to the collector transform.
(defn rt--case-clauses [(e Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n)
      `()
      (let [clause (primitive/code-nth e i)]
        `((~(primitive/code-nth clause 0) ~@(rt--all clause 1 (primitive/code-count clause))) ~@(rt--case-clauses e
                                                                                                                  (primitive/iadd i
                                                                                                                                  1)
                                                                                                                  n)))))

;; Rewrite a body: every form but the last as an ordinary expression, the last in
;; TAIL position. Declared here, defined after `rt--tail` — the file is one
;; mutually recursive group and Coil resolves forward references at module scope.
(defn rt--body-tail-mode [(sp Code) (e Code) (i i64) (n i64) (requests bool)] (-> Code)
  (if (primitive/icmp-ge i n)
      `()
      (if (primitive/icmp-eq i (primitive/isub n 1))
          `(~(rt--tail-mode (primitive/code-nth e i) sp requests))
          `(~(rt--expr (primitive/code-nth e i)) ~@(rt--body-tail-mode sp e (primitive/iadd i 1) n requests)))))
(defn rt--body-tail [(sp Code) (e Code) (i i64) (n i64)] (-> Code)
  (rt--body-tail-mode sp e i n false))

;; `let` bindings whose init allocates are rooted too — an evaluator binds many
;; intermediates that must survive later allocations, and a binding is exactly the
;; construct that keeps a value alive across them.
(defn rt--binds [(head Code)
                 (bs Code)
                 (i i64)
                 (n i64)
                 (placed Code)
                 (body Code)] (-> Code)
  (if (primitive/icmp-ge i n)
      `(~head (~@placed) ~@(rt--all body 0 (primitive/code-count body)))
      (let [b (primitive/code-nth bs i)
            nm (primitive/code-nth b 0)
            init (primitive/code-nth b 1)
            g (primitive/gensym)]
        ;; Lift each initializer into a fresh host binding. This preserves Scheme
        ;; `let`'s simultaneous scope (no user binder is visible to a later init),
        ;; while making every completed value a root before the next init runs.
        `(let [~g ~(rt--expr init)]
           (gc-root ~g)
           ~(rt--binds head
                       bs
                       (primitive/iadd i 1)
                       n
                       `(~@placed (~nm ~g))
                       body)))))

;; `let*` is sequential, so the actual Scheme binder must become visible after
;; each initializer. A chain of one-binding host lets has exactly those semantics
;; and gives us a point to root each value before evaluating the next initializer.
(defn rt--binds-sequential [(bs Code) (i i64) (n i64) (body Code)] (-> Code)
  (if (primitive/icmp-ge i n)
      `(do ~@(rt--all body 0 (primitive/code-count body)))
      (let [b (primitive/code-nth bs i)
            nm (primitive/code-nth b 0)
            init (primitive/code-nth b 1)]
        `(let [~nm ~(rt--expr init)]
           (gc-root ~nm)
           ~(rt--binds-sequential bs (primitive/iadd i 1) n body)))))

;; Surface Scheme binders are a list of two-element binding lists. Forms already
;; lowered to Coil use a flat vector instead; indexing one of its symbols as a
;; pair is a metaprogram crash, so distinguish the representations explicitly.
(defn rt--binding-pairs? [(bs Code) (i i64) (n i64)] (-> bool)
  (if (primitive/icmp-ge i n)
      true
      (let [b (primitive/code-nth bs i)]
        (and (primitive/code-list? b)
             (and (primitive/icmp-ge (primitive/code-count b) 2)
                  (rt--binding-pairs? bs (primitive/iadd i 1) n))))))

(defn rt--expr [(e Code)] (-> Code)
  (if (not (primitive/code-list? e))
      e
      (if (primitive/icmp-eq (primitive/code-count e) 0)
          e
          (let [h (primitive/code-nth e 0)]
            ;; `quote-data` is forms.coil's lowered quote. Its argument is still raw
            ;; datum syntax until the ordinary macro expander materializes it, so it
            ;; must be shielded exactly like surface `quote`. Descending here turned
            ;; `(quote (a b c))` into a call to an undefined procedure `a`.
            (if (or (primitive/code-eq h `quote) (primitive/code-eq h `quote-data))
                e
                ; syntax: rewrite the subexpressions, never the head or a binder
                ;
                ; ⚠ `scm-let` BELONGS HERE TOO, AND LEAVING IT OUT SILENTLY DELETED
                ; EVERY SCHEME `let` BINDING. Element 1 of both `let` and `scm-let` is
                ; a BINDER LIST, not an expression. `let` was special-cased to copy it
                ; verbatim; `scm-let` fell through to the generic syntax branch below,
                ; which rewrites elements 1..n as expressions — so `((a 1) (b 2))` was
                ; walked as if it were code, and what reached the macro was an empty
                ; binding list.
                ;
                ; The symptom was `unbound variable 'a'` pointing at the user's own
                ; source, with the bindings simply gone from the expansion. Nothing
                ; named the pass responsible, and the two obvious suspects — the
                ; dialect rewriter and `forms.coil` — were both innocent and both
                ; investigated at length.
                ;; `scm-case` and `cond` are CLAUSE forms: every element after the head
                ;; (after the key, for `case`) is a `(pattern body …)` clause whose
                ;; element 0 is data or a test, never a callee. Walking them as
                ;; expressions rewrites the datum list into a call and the macro then
                ;; reports a malformed clause — pointing at THIS file, which is at
                ;; least honest but is still a bug here.
                ;;
                ;; The clauses are left alone entirely. That costs rooting inside a
                ;; clause body, which is a real gap rather than a silent one: a value
                ;; allocated in a `case` arm is not rooted. Correct handling needs the
                ;; walk to descend into each clause's BODY while preserving its head,
                ;; which is the next piece of work here.
                (if (and (primitive/code-eq h `scm-case) (primitive/icmp-ge (primitive/code-count e) 2))
                    `(~h ~(rt--expr (primitive/code-nth e 1))
                        ~@(rt--case-clauses e 2 (primitive/code-count e)))
                    (if (and (primitive/code-eq h `cond) (primitive/icmp-ge (primitive/code-count e) 1))
                        `(~h ~@(rt--verbatim e 1 (primitive/code-count e)))
                        ;; Procedure constructors carry raw function-pointer expressions and
                        ;; arity metadata. Neither is a Scheme Val that may be pushed onto the
                        ;; GC shadow stack; the constructed procedure is rooted by its caller.
                        (if (or (primitive/code-eq h `make-procedure)
                                (or (primitive/code-eq h `make-reducer)
                                    (primitive/code-eq h `make-list-procedure)))
                            e
                            (if (and (primitive/code-eq h `scm-quasiquote)
                                     (= (primitive/code-count e) 2))
                                e
                                ;; `scm-do`'s termination clause is a LIST OF EXPRESSIONS, not one
                                ;; application. Preserve that container while rooting each test/result
                                ;; independently; treating it as a call makes the lowered test's `let`
                                ;; become a callee and eventually emits a vector in expression position.
                                (if (and (primitive/code-eq h `scm-do) (primitive/icmp-ge (primitive/code-count e) 3))
                                    `(~h ~(primitive/code-nth e 1)
                                        (~@(rt--all (primitive/code-nth e 2)
                                                    0
                                                    (primitive/code-count (primitive/code-nth e 2))))
                                        ~@(rt--all e 3 (primitive/code-count e)))
                                    (if (and (or (primitive/code-eq h `let)
                                                 (primitive/code-eq h `scm-let))
                                             (primitive/icmp-ge (primitive/code-count e) 2))
                                        (let [bs (primitive/code-nth e 1)
                                              bn (primitive/code-count bs)]
                                          (if (rt--binding-pairs? bs 0 bn)
                                              (rt--binds h
                                                         bs
                                                         0
                                                         bn
                                                         `()
                                                         (rt--verbatim e 2 (primitive/code-count e)))
                                              `(~h ~bs ~@(rt--all e 2 (primitive/code-count e)))))
                                        (if (and (primitive/code-eq h `let*)
                                                 (primitive/icmp-ge (primitive/code-count e) 2))
                                            (let [bs (primitive/code-nth e 1)
                                                  bn (primitive/code-count bs)]
                                              (if (rt--binding-pairs? bs 0 bn)
                                                  (rt--binds-sequential bs
                                                                        0
                                                                        bn
                                                                        (rt--verbatim e 2 (primitive/code-count e)))
                                                  `(~h ~bs ~@(rt--all e 2 (primitive/code-count e)))))
                                            (if (and (rt--binder-list-form? h)
                                                     (primitive/icmp-ge (primitive/code-count e) 2))
                                                `(~h ~(primitive/code-nth e 1)
                                                    ~@(rt--all e 2 (primitive/code-count e)))
                                                (if (rt--syntax? h)
                                                    `(~h ~@(rt--all e 1 (primitive/code-count e)))
                                                    ; a bool-returning predicate: rewrite the arguments but do NOT lift
                                                    ; them into a rooted `let`, or the call's type escapes as a bool
                                                    ; where a Val is required (see rt--bool-head?)
                                                    (if (rt--bool-head? h)
                                                        `(~h ~@(rt--all e 1 (primitive/code-count e)))
                                                        ; an ordinary call: A-normalize the arguments
                                                        (rt--args h e 1 (primitive/code-count e) `()))))))))))))))))

;; ── TAIL POSITION: RESET THE SHADOW STACK BEFORE THE CALL ───────────────────
;;
;; A Scheme tail call is compiled as a native call, so without this the caller's
;; frame — and every root it pushed — stays live for the entire recursion. At
;; depth 8000 that is 8000 frames of roots held at once, which makes `mark-roots`
;; walk a shadow stack in the hundreds of thousands on every collection and the
;; program appear to hang.
;;
;; The reset is sound for ANY call in TAIL position, and the argument does not
;; depend on which procedure is called: the callee's result is returned directly
;; to OUR caller, so control never comes back to a point that could read our
;; roots. Nothing after the call can observe them, so they are dead the moment
;; the arguments are evaluated.
;;
;; ⚠ AN EARLIER VERSION RESTRICTED THIS TO SELF-CALLS, on the grounds that "a call
;; to another procedure may return here". That is wrong, and it is worth being
;; precise about why: a call in tail position does NOT return here by definition —
;; its value IS this function's value. The self/non-self distinction matters for
;; whether the BACKEND can reuse the frame (see `tail-call-ok` in codegen.coil),
;; not for whether these roots are dead. Keeping the restriction meant every
;; mutual tail call kept `(gc-sp-set! …)` AFTER the call, which both leaked roots
;; and — because the call was then not syntactically last — silently cost the
;; `musttail` that makes mutual recursion constant-space at all.
;;
;; ⚠ ORDER IS THE WHOLE CORRECTNESS ARGUMENT. The arguments must be evaluated and
;; rooted FIRST — evaluating them can allocate and therefore collect — and only
;; then does the stack reset, immediately before the call. Resetting first would
;; drop roots while argument evaluation still needs them, which is precisely the
;; use-after-free this pass exists to prevent. So the emitted shape binds every
;; argument to a rooted temporary, then pops, then calls:
;;
;;     (let [$a ARG1] (gc-root $a)
;;       (let [$b ARG2] (gc-root $b)
;;         (do (gc-sp-set! $sp) (f $a $b))))
;;
;; The arguments survive the pop because they are passed in registers, and the
;; callee's own prologue re-roots them.
(defn rt--tail-call [(e Code) (sp Code)] (-> Code)
  (rt--tail-args (primitive/code-nth e 0) e 1 (primitive/code-count e) `() sp))

(defn rt--tail-args [(head Code) (e Code) (i i64) (n i64) (placed Code) (sp Code)] (-> Code)
  (if (primitive/icmp-ge i n)
      ; every argument is evaluated and rooted: NOW the frame's roots are dead
      `(do (gc-sp-set! ~sp) (~head ~@placed))
      (let [orig (primitive/code-nth e i)
            arg (rt--expr orig)]
        (if (rt--allocates? orig)
            (let [g (primitive/gensym)]
              `(let [~g ~arg]
                 (gc-root ~g)
                 ~(rt--tail-args head e (primitive/iadd i 1) n `(~@placed ~g) sp)))
            (rt--tail-args head e (primitive/iadd i 1) n `(~@placed ~arg) sp)))))

;; ⚠ THE EPILOGUE GOES ON THE EXITS, NOT AROUND THE BODY. This is the whole
;; reason `rt--tail` exists in this shape, and getting it wrong silently costs
;; tail-call elimination.
;;
;; The obvious frame wraps the body and pops once on the way out:
;;
;;     (let [$r (do BODY)] (gc-sp-set! $sp) $r)      ; ← DO NOT DO THIS
;;
;; It is correct, and it defeats TCO completely. The pop has to run AFTER the
;; call returns, so the call is no longer the last thing the function does —
;; `musttail` cannot apply and codegen emits an ordinary call. Coil GUARANTEES
;; constant stack for self-recursion (codegen.coil emits `musttail`), and this
;; shape throws that guarantee away for every Scheme procedure.
;;
;; MEASURED: `(count 50000000 0)` — 50M-deep self tail recursion — returns
;; 50000000 in plain Coil and SIGSEGVs under the wrapping frame. Verified against
;; a hand-written Coil function in the wrapping shape, so it is the SHAPE and not
;; anything about the dialect. The benchmarks did not catch it because they
;; recurse 8000-12000 deep, which fits in an 8MB stack.
;;
;; So every exit carries its own epilogue instead:
;;
;;   returning a value   (let [$r VALUE] (gc-sp-set! $sp) $r)   pop, then return
;;   self tail call      (do (gc-sp-set! $sp) (f ARGS…))        pop, then JUMP
;;
;; The tail call is syntactically last in its branch, so `musttail` applies and
;; the frame is reused. Roots are popped BEFORE the jump, which is sound for the
;; reason given at `rt--tail-call`: the callee returns to OUR caller, so nothing
;; can read our roots again.

(defn rt--dynamic-call-name? [(name (slice u8))
                              (bare (slice u8))
                              (qualified (slice u8))] (-> bool)
  (or (str-eq name bare) (str-eq name qualified)))

(defn rt--dynamic-tail? [(h Code)] (-> bool)
  ;; Lambda lifting introduces these heads hygienically, so their stored name is
  ;; normally the canonical stdproc identity rather than the source spelling.
  ;; `code-eq` against a rooting-module literal therefore misses exactly the
  ;; generated closure calls this predicate exists to trampoline.
  (if (not (primitive/code-sym? h))
      false
      (let [name (primitive/code-str h)]
        (or (rt--dynamic-call-name? name "call--0" "coil.scheme.stdproc.call--0")
            (or (rt--dynamic-call-name? name "call--1" "coil.scheme.stdproc.call--1")
                (or (rt--dynamic-call-name? name "call--2" "coil.scheme.stdproc.call--2")
                    (or (rt--dynamic-call-name? name "call--3" "coil.scheme.stdproc.call--3")
                        (or (rt--dynamic-call-name? name "call--4" "coil.scheme.stdproc.call--4")
                            (or (rt--dynamic-call-name? name "call--5" "coil.scheme.stdproc.call--5")
                                (rt--dynamic-call-name? name
                                                        "call--6"
                                                        "coil.scheme.stdproc.call--6"))))))))))
(defn rt--tail-arg-list [(e Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n)
      `(s-nil)
      `(cons ~(primitive/code-nth e i)
             ~(rt--tail-arg-list e (primitive/iadd i 1) n))))
(defn rt--dynamic-request [(e Code) (sp Code)] (-> Code)
  ;; `(call--N proc arg...)` -> a traced `(proc . args)` request. Feed the new
  ;; call back through rt--tail-call so allocation in the argument list is
  ;; A-normalized/rooted before this frame is dropped.
  (rt--tail-call `(scm-tail-request-list ~(primitive/code-nth e 1)
                                         ~(rt--tail-arg-list e 2 (primitive/code-count e)))
                 sp))

;; Rewrite `e` in TAIL position. Only the forms that PROPAGATE tail position are
;; descended into as tail — `if`'s branches (not its test), and the last form of
;; a `do`. Surface `scm-let` is deliberately excluded: at this phase a locally
;; bound call has not yet been lowered to dynamic dispatch, so treating its head
;; as a statically known tail callee changes variadic argument packaging.
(defn rt--tail-mode [(e Code) (sp Code) (requests bool)] (-> Code)
  (if (not (primitive/code-list? e))
      (rt--return e sp)
      (if (primitive/icmp-eq (primitive/code-count e) 0)
          (rt--return e sp)
          (let [h (primitive/code-nth e 0)]
            ; `if`: the TEST is not in tail position, both BRANCHES are
            (if (and requests (rt--dynamic-tail? h))
                (rt--dynamic-request e sp)
                (if (and requests (primitive/code-eq h `scm-apply-args))
                    (rt--tail-call `(scm-tail-request-apply-args ~(primitive/code-nth e 1)) sp)
                    (if (and requests (primitive/code-eq h `call-with-values))
                        (rt--tail-call `(scm-tail-call-with-values ~(primitive/code-nth e 1)
                                                                   ~(primitive/code-nth e 2))
                                       sp)
                        ;; Lambda lifting uses host-vector lets for variadic/rest bindings and
                        ;; captured-environment setup. Their final body expression is still a
                        ;; Scheme tail context; preserving the vector verbatim avoids treating
                        ;; `(name init)` metadata as calls.
                        (if (and (primitive/code-eq h `let)
                                 (and (primitive/icmp-ge (primitive/code-count e) 3)
                                      (primitive/code-vector? (primitive/code-nth e 1))))
                            `(let ~(primitive/code-nth e 1)
                               ~@(rt--body-tail-mode sp e 2 (primitive/code-count e) requests))
                            (if (and (primitive/code-eq h `if) (primitive/icmp-ge (primitive/code-count e) 3))
                                (if (primitive/icmp-ge (primitive/code-count e) 4)
                                    `(if ~(rt--expr (primitive/code-nth e 1))
                                         ~(rt--tail-mode (primitive/code-nth e 2) sp requests)
                                         ~(rt--tail-mode (primitive/code-nth e 3) sp requests))
                                    ;; A one-armed `if` in tail position: the implicit false branch
                                    ;; yields the unspecified value and must ALSO pop, or that path
                                    ;; leaks the frame's roots for the rest of the program.
                                    `(if ~(rt--expr (primitive/code-nth e 1))
                                         ~(rt--tail-mode (primitive/code-nth e 2) sp requests)
                                         ~(rt--return `(s-unspecified) sp)))
                                ;; `do` in tail position: only its LAST form is tail.
                                (if (and (primitive/code-eq h `do) (primitive/icmp-ge (primitive/code-count e) 2))
                                    `(do ~@(rt--body-tail-mode sp e 1 (primitive/code-count e) requests))
                                    ;; ANY ordinary call in tail position — self or not — pops before it
                                    ;; jumps. Syntax forms and bool-returning predicates are excluded:
                                    ;; the former are not calls, and the latter yield a raw `bool` that
                                    ;; is not this function's Val result.
                                    (if (and (primitive/code-sym? h)
                                             (and (not (rt--syntax? h))
                                                  (and (not (rt--bool-head? h))
                                                       (and (not (primitive/code-eq h `quote))
                                                            (not (primitive/code-eq h `quote-data))))))
                                        (rt--tail-call e sp)
                                        (rt--return e sp))))))))))))

(defn rt--tail [(e Code) (sp Code)] (-> Code)
  (rt--tail-mode e sp false))

;; A non-tail-call exit: evaluate the value, pop the frame, return the value.
;; The binding is required — `(do VALUE (gc-sp-set! $sp))` would return the pop's
;; result instead of the function's, and popping before evaluating would free
;; roots the evaluation still needs.
(defn rt--return [(e Code) (sp Code)] (-> Code)
  (let [r (primitive/gensym)]
    `(let [~r ~(rt--expr e)] (gc-sp-set! ~sp) ~r)))

;; Wrap one `defn` in a frame: root the parameters on entry, pop on the way out.
;;
;; Popping needs the body's value bound FIRST — `(do body (gc-sp-set! sp))` would
;; return the pop's value instead of the function's, and `(gc-sp-set! sp)` after
;; the value is computed is exactly when the value is still needed.
(defn rt--params [(ps Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n)
      `()
      (let [p (primitive/code-nth ps i)]
        ; ⚠ A parameter vector is not uniformly `(name type)` pairs: a variadic
        ; `defn` writes a bare `&` before its rest parameter, and reading element 0
        ; of that symbol is a comptime crash with no source location. Root only the
        ; well-formed Scheme-word pairs and skip anything else. Native helpers in
        ; a dialect module can legitimately accept Code or pointer values; those
        ; are not managed Scheme heap references and must not enter this stack.
        (if (and (primitive/code-list? p)
                 (and (primitive/icmp-ge (primitive/code-count p) 2)
                      (primitive/code-eq (primitive/code-nth p 1) `i64)))
            `((gc-root ~(primitive/code-nth p 0)) ~@(rt--params ps (primitive/iadd i 1) n))
            (rt--params ps (primitive/iadd i 1) n)))))

;; Already framed? A before-expand pass is re-run on its own output until nothing
;; changes, so `rt--defn` must be a fixed point of itself: without this it wraps
;; each round in another `(let [$sp (gc-sp)] …)` and never converges, which the
;; compiler reports as "did not reach a fixpoint after 16 rounds".
;;
;; The marker is the body's own shape — a `let` whose first init is `(gc-sp)` is
;; one this pass emitted, and nothing else produces it.
(defn rt--defn-cc? [(f Code)] (-> bool)
  (and (primitive/icmp-ge (primitive/code-count f) 4)
       (primitive/code-eq (primitive/code-nth f 2) `:cc)))
(defn rt--defn-params-at [(f Code)] (-> i64)
  (if (rt--defn-cc? f) 4 2))
(defn rt--defn-body-at [(f Code)] (-> i64)
  (if (rt--defn-cc? f) 6 4))

(defn rt--framed? [(f Code)] (-> bool)
  (let [bi (rt--defn-body-at f)]
    (and (primitive/icmp-eq (primitive/code-count f) (primitive/iadd bi 1))
         (let [b (primitive/code-nth f bi)]
           (and (primitive/code-list? b)
                (and (primitive/icmp-ge (primitive/code-count b) 2)
                     (and (primitive/code-eq (primitive/code-nth b 0) `let)
                          (let [bs (primitive/code-nth b 1)]
                            (and (primitive/code-list? bs)
                                 (and (primitive/icmp-ge (primitive/code-count bs) 2)
                                      (let [v (primitive/code-nth bs 1)]
                                        (and (primitive/code-list? v)
                                             (and (primitive/icmp-gt (primitive/code-count v) 0)
                                                  (primitive/code-eq (primitive/code-nth v 0) `gc-sp))))))))))))))

(defn rt--defn [(f Code)] (-> Code)
  (let [name (primitive/code-nth f 1)
        pi (rt--defn-params-at f)
        bi (rt--defn-body-at f)
        ps (primitive/code-nth f pi)
        ret (primitive/code-nth f (primitive/isub bi 1))
        sp (primitive/gensym)
        marked (primitive/code-nth f bi)
        closure-body?
          (and (primitive/code-list? marked)
               (and (primitive/icmp-gt (primitive/code-count marked) 0)
                    (primitive/code-eq (primitive/code-nth marked 0) `scm-closure-body)))
        ;; Same exit-carried epilogue as `rt--define`, and for the same reason: a
        ;; wrapping `let` would put every self-call out of tail position and cost
        ;; the `musttail` guarantee. `defn`'s name is element 1.
        body
          (if closure-body?
              (rt--body-tail-mode sp marked 1 (primitive/code-count marked) true)
              (rt--body-tail sp f bi (primitive/code-count f)))]
    (if (rt--defn-cc? f)
        `(defn ~name
           :cc
           ~(primitive/code-nth f 3)
           ~ps
           ~ret
           (let [~sp (gc-sp)]
             ~@(rt--params ps 0 (primitive/code-count ps))
             ~@body))
        `(defn ~name
           ~ps
           ~ret
           (let [~sp (gc-sp)]
             ~@(rt--params ps 0 (primitive/code-count ps))
             ~@body)))))

;; ── WHY `define` IS HANDLED SEPARATELY, AND NOT VIA `defn` ──────────────────
;;
;; `define` is an ordinary MACRO (core.coil) that expands to `defn`. Macros run in
;; the expansion phase; this pass is `:phase before-expand`, so it runs STRICTLY
;; EARLIER — every Scheme procedure is still a `define` form when it gets here, and
;; a pass that matches only `defn` frames none of them.
;;
;; That is not a hypothetical ordering concern: it is what made this pass emit
;; nothing useful. `(defn main …)` — hand-written Coil — was framed correctly,
;; while every `(define (f …) …)` was passed straight through, so the benchmark's
;; `make-tree` kept its raw `(cons (make-tree …) (make-tree …))` and the second
;; collection swept the half-built tree. The frames that DID appear made it look
;; like the pass was working.
;;
;; Framing the `define` in place — rather than expanding it here — keeps the macro
;; the single owner of the `define` -> `defn` translation, including the variadic
;; and the `(define x e)` global-cell shapes this pass has no business duplicating.
(defn rt--define [(f Code)] (-> Code)
  (let [sig (primitive/code-nth f 1)
        sp (primitive/gensym)
        ;; The LAST body form is in tail position, so a self-call there can drop
        ;; this frame's roots before recursing (see rt--tail). Earlier forms are
        ;; ordinary expressions: their values are discarded, but anything they
        ;; allocate must stay rooted for the forms that follow.
        body (rt--body-tail sp f 2 (primitive/code-count f))]
    ;; Parameters come from the SIGNATURE's tail: `(f a b)` -> a, b. Element 0 is
    ;; the procedure name and must not be rooted — it is a binder, not a value.
    ;;
    ;; ⚠ NO EPILOGUE HERE. `rt--body-tail` has already placed a `gc-sp-set!` on
    ;; every exit, which is what keeps a tail call syntactically last so codegen
    ;; can emit `musttail`. Wrapping the body in `(let [$r (do …)] (gc-sp-set! …)
    ;; $r)` — the obvious shape — is correct but destroys TCO for every Scheme
    ;; procedure; see the note above `rt--tail`.
    `(define ~sig
             (let [~sp (gc-sp)]
               ~@(rt--sig-params sig 1 (primitive/code-count sig))
               ~@body))))

;; A `define` signature holds BARE NAMES, not `(name type)` pairs — so this is not
;; `rt--params`. The dotted rest marker is skipped: `.` is punctuation, and the
;; rest parameter after it is a fresh list the callee owns.
(defn rt--sig-params [(sig Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n)
      `()
      (let [p (primitive/code-nth sig i)]
        (if (and (primitive/code-sym? p) (not (primitive/code-eq p `.)))
            `((gc-root ~p) ~@(rt--sig-params sig (primitive/iadd i 1) n))
            (rt--sig-params sig (primitive/iadd i 1) n)))))

;; Already framed, for the `define` shape: same fixpoint requirement as
;; `rt--framed?`, keyed on the body rather than element 4.
(defn rt--define-framed? [(f Code)] (-> bool)
  (and (primitive/icmp-eq (primitive/code-count f) 3)
       (let [b (primitive/code-nth f 2)]
         (and (primitive/code-list? b)
              (and (primitive/icmp-ge (primitive/code-count b) 2)
                   (and (primitive/code-eq (primitive/code-nth b 0) `let)
                        (let [bs (primitive/code-nth b 1)]
                          (and (primitive/code-list? bs)
                               (and (primitive/icmp-ge (primitive/code-count bs) 2)
                                    (let [v (primitive/code-nth bs 1)]
                                      (and (primitive/code-list? v)
                                           (and (primitive/icmp-gt (primitive/code-count v) 0)
                                                (primitive/code-eq (primitive/code-nth v 0) `gc-sp)))))))))))))

;; A procedure `define`: `(define (f a…) body…)`. The VARIABLE form
;; `(define x e)` has a symbol head and is left alone — it lowers to a global cell
;; the collector already traces as a permanent root, so it needs no frame.
(defn rt--define-proc? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (primitive/icmp-ge (primitive/code-count f) 3)
            (and (primitive/code-sym? (primitive/code-nth f 0))
                 (and (primitive/code-eq (primitive/code-nth f 0) `define)
                      (and (primitive/code-list? (primitive/code-nth f 1))
                           (primitive/icmp-gt (primitive/code-count (primitive/code-nth f 1))
                                              0)))))))

;; Both function shapes are framed: `define` for Scheme source, and `defn` for the
;; hand-written Coil (a `main`, a helper) that a dialect module may also contain
;; and which holds Scheme values across the same allocations.
(defn rt--form [(f Code)] (-> Code)
  (if (rt--define-proc? f)
      (if (rt--define-framed? f) f (rt--define f))
      (if (and (primitive/code-list? f)
               (and (primitive/icmp-ge (primitive/code-count f) 5)
                    (and (primitive/code-sym? (primitive/code-nth f 0))
                         (primitive/code-eq (primitive/code-nth f 0) `defn))))
          (if (rt--framed? f) f (rt--defn f))
          f)))

(defn rt--forms [(forms Code) (i i64)] (-> Code)
  (if (primitive/code-null? forms)
      `()
      (let [form (primitive/code-car forms)
            entered (rt--trace-form "enter" i form)
            rewritten (rt--form form)
            finished (rt--trace-form "leave" i rewritten)
            rest (rt--forms (primitive/code-cdr forms) (primitive/iadd i 1))]
        (primitive/code-cons rewritten rest))))

;; The pass over a module list, for `coil.scheme.dialect` to compose. Like the
;; other passes it takes and returns the BARE list — only the outermost transform
;; result carries the `do` wrapper.
;; Entry point: takes the module list and computes its OWN length. Passing a
;; caller-supplied count invites the composition bug where the count belongs to a
;; different list than the one being walked — the earlier passes may add or drop
;; forms.
;; Same opt-in as the other passes: a module is Scheme iff it imports
;; `coil.scheme`, and the dialect's own modules are excluded by name.
(defn rt--imports-scheme? [(m Code) (i i64) (n i64)] (-> bool)
  (if (primitive/icmp-ge i n)
      false
      (let [f (primitive/code-nth m i)]
        (if (and (primitive/code-list? f)
                 (and (primitive/icmp-ge (primitive/code-count f) 2)
                      (and (primitive/code-eq (primitive/code-nth f 0) `import)
                           (str-eq (primitive/code-str (primitive/code-nth f 1))
                                   "coil.scheme"))))
            true
            (rt--imports-scheme? m (primitive/iadd i 1) n)))))

(defn rt--rewritable? [(m Code)] (-> bool)
  (and (primitive/code-list? m)
       (and (primitive/icmp-gt (primitive/code-count m) 1)
            (and (not (starts-with (primitive/code-str (primitive/code-nth m 0))
                                   "coil.scheme"))
                 (rt--imports-scheme? m 1 (primitive/code-count m))))))

(defn rooting-mods [(ms Code)] (-> Code)
  (rooting--go ms 0 (primitive/code-count ms)))

(defn rooting--go [(ms Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n)
      `()
      (let [m (primitive/code-nth ms i)]
        ; A module record is `(name form…)`. Anything else is passed through: this
        ; pass runs third, and being defensive about the shape the earlier passes
        ; hand over is cheaper than a comptime crash with no location.
        ;
        ; ⚠ Scoped exactly like the other two passes: only a module that imported
        ; `coil.scheme`, and never `coil.scheme.*` itself. The dialect's own runtime
        ; is ordinary Coil — framing heap.coil's functions would push roots around
        ; the collector itself.
        `(~(if (and (rt--rewritable? m)
                    (and (primitive/code-list? m) (primitive/icmp-gt (primitive/code-count m) 0)))
               `(~(primitive/code-nth m 0) ~@(rt--forms (primitive/code-cdr m) 1))
               m) ~@(rooting--go ms (primitive/iadd i 1) n)))))
