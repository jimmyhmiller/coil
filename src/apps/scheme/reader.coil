(module coil.scheme.reader)

(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-len subslice])
(import "coil.str" :use [str-eq])

(defn path-suffix? [(path (slice u8)) (suffix (slice u8))] (-> bool)
  (let [pn (slice-len path) sn (slice-len suffix)]
    (and (>= pn sn) (str-eq (subslice path (- pn sn) pn) suffix))))

;; A read provider receives `(read-context PATH SOURCE KIND)`. It owns the
;; decision about which files it handles and delegates actual s-expression
;; parsing to the configurable built-in reader. Returning Code rather than a
;; ReaderConfig leaves the phase open to non-s-expression frontends later.
(defn scheme-read [(context Code)] (-> Code)
  (let [path (primitive/code-str (primitive/code-nth context 1))
        source (primitive/code-nth context 2)]
    (if (or (path-suffix? path ".scm") (path-suffix? path ".ss"))
        (primitive/code-read source
          `(reader-config :unquote #\, :splice #\@ :keywords false))
        (primitive/code-read source
          `(reader-config :unquote #\~ :splice #\@ :keywords true)))))
