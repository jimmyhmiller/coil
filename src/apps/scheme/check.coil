(module coil.scheme.check)
(import "coil.assert" :use *)
(import "coil.scheme.value" :use *)

;; Assertions for Scheme-dialect test modules.
;;
;; ⚠ THIS MODULE EXISTS BECAUSE `coil.assert` CANNOT BE USED INSIDE THE DIALECT,
;; and both halves of that are non-obvious enough to be worth stating.
;;
;; 1. `assert-eq` IS SILENTLY NEUTRALIZED. It expands to `(if (= x y) 0 (fail))`,
;;    and inside a rewritten module that `=` becomes Scheme's `=`, which returns a
;;    TAGGED VAL, while the `if` test gets wrapped in `truthy?`. Every Val except
;;    `#f` is truthy, so the success branch is taken UNCONDITIONALLY. A test suite
;;    written with `assert-eq` inside the dialect asserts NOTHING — verified by
;;    mutation: `(assert-eq (fixnum-value x) 12345)` passed.
;;
;; 2. STRING LITERALS DO NOT SURVIVE EITHER. The dialect lowers every string
;;    literal in a rewritten module to a heap Scheme string, so a failure message
;;    typed `(slice u8)` arrives as an i64, and a `fmt` format string fails at
;;    comptime with "str-bytes expects a string".
;;
;; The module name starts with `coil.scheme`, which is exactly the prefix both
;; dialect passes SKIP — so this file is ordinary Coil and its `=`, its `if` and
;; its string literals all mean what they say. That is the whole trick: the
;; checking code lives outside the dialect, and the dialect code calls into it.
;;
;; `id` is an integer label rather than a message because the CALLER is inside the
;; dialect, where a string literal would be lowered before it ever arrived here.

;; `v` is a Scheme BOOLEAN Val. Only `#f` fails — the R5RS rule — and the
;; comparison is a plain i64 equality that no rewrite can turn into a tautology.
(defn check [(v i64) (id i64)] (-> i64)
  (if (val-eq? v (s-false))
      (do (assert-fail "scheme dialect check failed (see id)"
                       "src/apps/scheme/dialect_test.coil" id)
          0)
    0))

;; For structural facts that are host bools rather than Scheme booleans.
(defn check-host [(b bool) (id i64)] (-> i64)
  (if b 0
    (do (assert-fail "scheme dialect check failed (see id)"
                     "src/apps/scheme/dialect_test.coil" id)
        0)))

;; Keep host boolean negation outside rewritten test modules. Scheme source owns
;; the reserved spelling `not`, which the dialect correctly routes to scm-not.
(defn host-not [(b bool)] (-> bool) (not b))
