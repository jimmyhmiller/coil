(module coil.scheme.dialect)
(import "coil.primitive" :as primitive)
(import "coil.str" :use *)

;; The dialect seam: a `:phase before-expand` transform that rewrites the Scheme
;; spellings of forms Coil reserves.
;;
;; Six names cannot be shadowed — the compiler rejects `defn` on a built-in form:
;; `let`, `and`, `or`, `if`, `do`, `quote`. For most that is fine, because Coil's
;; version means what Scheme's means. `let` is the exception and it is the whole
;; reason this file exists:
;;
;;     scheme:  (let ((a 1) (b 2)) body)     bindings are a LIST OF PAIRS
;;     coil:    (let [a 1 b 2] body)         bindings are a VECTOR
;;
;; Those shapes are disjoint, so the rewrite is unambiguous — no heuristic, no
;; guessing at intent. A `let` whose second element is a list gets rewritten to
;; `scm-let`; a `let` whose second element is a vector is Coil's and is left
;; alone. Both dialects coexist in one file.
;;
;; Running before expansion is what makes this work: the transform sees the
;; author's surface syntax, before macros have run and before `let` has been
;; parsed as a built-in form. That is exactly the window the reserved-name check
;; closes later.

;; A Scheme `let` binding list: `((a 1) (b 2))` — a list whose FIRST ELEMENT IS A
;; LIST. Coil's is `[a 1 b 2]`, whose first element is a symbol.
;;
;; ⚠ `code-list?` answers true for a vector too — the reader distinguishes `list`
;; from `vec`, but the Code predicate does not — so emptiness cannot be the test.
;; An earlier version treated an empty binding form as Scheme's `()`, which also
;; matched `defn`'s empty parameter vector `[]` and rewrote every zero-argument
;; function's return type into a `let`. The nesting check is what actually
;; discriminates, and it never fires on a well-formed Coil binding vector.
;;
;; The cost is that Scheme's `(let () body)` is not recognized. That form is rare,
;; means "no bindings", and `(begin body)` says the same thing — a smaller price
;; than misreading every `[]` in the file.
(defn scheme-bindings? [(e Code)] (-> bool)
  (and (primitive/code-list? e)
       (and (> (primitive/code-count e) 0)
            (primitive/code-list? (primitive/code-nth e 0)))))

(defn dia--rewrite-all [(e Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    `(~(dia--rewrite (primitive/code-nth e i)) ~@(dia--rewrite-all e (+ i 1) n))))

;; Forms whose second element is a BINDER, not an expression. `defn`'s parameter
;; vector `[(bs Code) (body Code)]` is a list whose first element is a list —
;; structurally identical to Scheme's `((a 1) (b 2))`. No shape test can separate
;; them, so position is what disambiguates: a binder is never rewritten, and
;; rewriting resumes in the body after it.
;;
;; This is the principled version of a rule that a shape heuristic cannot express.
;; Descending blindly turned every `(defn f [(x T)] …)` into a `let`.
;; How many leading elements of a binder form are NOT body. `defn` is
;; `(defn name params ret body…)` so its body starts at 3; the others are
;; `(kw name binder)` with no body to rewrite at all.
(defn dia--body-start [(h Code)] (-> i64)
  (if (primitive/code-eq h `defn) 4 3))

;; Copy elements [i, stop) verbatim — no rewriting inside a binder or a type.
(defn dia--verbatim [(e Code) (i i64) (stop i64) (n i64)] (-> Code)
  (if (or (>= i stop) (>= i n)) `()
    `(~(primitive/code-nth e i) ~@(dia--verbatim e (+ i 1) stop n))))

(defn dia--binder-form? [(h Code)] (-> bool)
  (or (primitive/code-eq h `defn)
      (or (primitive/code-eq h `defstruct)
          (or (primitive/code-eq h `defsum)
              (or (primitive/code-eq h `deftrait)
                  (or (primitive/code-eq h `impl)
                      (primitive/code-eq h `defcc)))))))

;; Rewrite one node, bottom-up. Anything not recognized passes through untouched,
;; which is what lets a file mix Scheme and ordinary Coil.
(defn dia--rewrite [(e Code)] (-> Code)
  (if (not (primitive/code-list? e)) e
    (if (= (primitive/code-count e) 0) e
      (let [h (primitive/code-nth e 0)]
        ; `quote` shields its argument: (quote (let ((a 1)))) is data, not code
        (if (primitive/code-eq h `quote) e
          ; A binder form: copy the name, the binder and the return type verbatim,
          ; and rewrite only the body after them.
          ;
          ; `dia--verbatim` copies a fixed prefix; the count guard is >= 2 rather
          ; than >= 3 because `(defn main [] …)` has an EMPTY parameter vector.
          ; Requiring three elements let that shape fall through to the generic
          ; branch, which descended into `(-> i64)` and read it as a `let` — so
          ; every zero-argument function in the file broke.
          (if (dia--binder-form? h)
              `(~h ~@(dia--verbatim e 1 (dia--body-start h) (primitive/code-count e))
                   ~@(dia--rewrite-all e (dia--body-start h) (primitive/code-count e)))
            (if (and (primitive/code-eq h `let)
                     (and (>= (primitive/code-count e) 2)
                          (scheme-bindings? (primitive/code-nth e 1))))
                ; Scheme's: rewrite the inits, and hand the whole thing to scm-let
                `(scm-let ~@(dia--rewrite-all e 1 (primitive/code-count e)))
              ; Coil's `let [x 7]`: the bindings are a VECTOR, and a quasiquote
              ; rebuilds any sequence as a LIST — so descending here would emit
              ; `(x 7)` and the parser would reject its own binding form. Copy the
              ; binding vector verbatim and rewrite only the body.
              (if (primitive/code-eq h `let)
                  `(~h ~(primitive/code-nth e 1)
                       ~@(dia--rewrite-all e 2 (primitive/code-count e)))
                `(~h ~@(dia--rewrite-all e 1 (primitive/code-count e)))))))))))

;; Opt-in, by the module's own declaration: a module is Scheme iff it imports
;; `coil.scheme`. That is a marker the author writes and a reader can see, and it
;; scopes the rewrite to exactly the files that asked for it — the stdlib, the
;; dialect's own runtime, and any ordinary Coil in the project are untouched
;; because none of them import it.
;;
;; This works because the loader keeps `(import …)` in the form list. It used to
;; process the import and drop the form, which made this question unanswerable
;; from a metaprogram and forced a guess based on authorship instead.
(defn dia--imports-scheme? [(m Code) (i i64) (n i64)] (-> bool)
  (if (>= i n) false
    (let [f (primitive/code-nth m i)]
      ; the import target is a STRING node, so compare its text
      (if (and (primitive/code-list? f)
               (and (>= (primitive/code-count f) 2)
                    (and (primitive/code-eq (primitive/code-nth f 0) `import)
                         (str-eq (primitive/code-str (primitive/code-nth f 1))
                                 "coil.scheme"))))
          true
        (dia--imports-scheme? m (+ i 1) n)))))

;; The dialect's own runtime is written in ordinary Coil, not Scheme, so it must
;; never be rewritten even though it lives under the same prefix.
(defn dia--self? [(m Code)] (-> bool)
  (starts-with (primitive/code-str (primitive/code-nth m 0)) "coil.scheme"))

(defn dia--rewritable? [(m Code)] (-> bool)
  (and (> (primitive/code-count m) 1)
       (and (not (dia--self? m))
            (dia--imports-scheme? m 1 (primitive/code-count m)))))

(defn dia--mods [(ms Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    (let [m (primitive/code-nth ms i)]
      `(~(if (dia--rewritable? m)
             `(~(primitive/code-nth m 0) ~@(dia--rewrite-all m 1 (primitive/code-count m)))
           m)
        ~@(dia--mods ms (+ i 1) n)))))

(defn scheme-dialect [(prog Code)] (-> Code)
  `(do ~@(dia--mods prog 0 (primitive/code-count prog))))

(transform scheme-dialect :phase before-expand)
