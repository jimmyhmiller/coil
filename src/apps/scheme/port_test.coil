(module coil.scheme.port-test)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.io" :as io)
(import "coil.os" :as os)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.bignum" :use *)
(import "coil.scheme.symbol" :use *)
(import "coil.scheme.port" :use *)
(import "coil.scheme.stdproc" :as stdproc)
(import "coil.scheme.stdproc" :use [fnptr0 fnptr1])

(defn port-test-first [(p i64)] (-> i64) (scm-read-char p))
(defn port-test-write-q [(p i64)] (-> i64)
  (scm-write-char-port (mk-char 81) p))
(defn port-test-current-first [] (-> i64)
  (scm-read-char (current-input-port)))
(defn port-test-current-write [] (-> i64)
  (scm-write-char-port (mk-char 82) (current-output-port)))
(defn port-test-has-name? [(xs i64) (name i64)] (-> bool)
  (if (is-null xs) false
    (if (truthy? (stdproc/scm-string=? (car xs) name)) true
      (port-test-has-name? (cdr xs) name))))

(deftest memory-string-ports-grow-round-trip-and-close
  (let [sp (gc-sp)
        out (open-output-string)]
    (gc-root out)
    ;; Exceeds the initial native buffer so the reallocating writer path is
    ;; covered, then confirms that only written bytes appear in the result.
    (for [i 0 300] (put-string out (stdproc/string-from-slice "x")))
    (put-string out (stdproc/string-from-slice "λ"))
    (let [s (get-output-string out)]
      (gc-root s)
      (assert-eq (stdproc/string-length-raw s) 301)
      (assert-eq (stdproc/string-code s 0) 120)
      (assert-eq (stdproc/string-code s 300) 955)
      (let [in (open-input-string s)]
        (gc-root in)
        (assert (val-eq? (scm-read-char in) (mk-char 120)))
        (for [i 1 300] (scm-read-char in))
        (assert (val-eq? (scm-read-char in) (mk-char 955)))
        (assert (val-eq? (scm-read-char in) (s-eof)))
        (close-input-port in)))
    (close-output-port out)
    (assert (not (port-open? out)))
    (gc-sp-set! sp)))

(deftest directory-list-delete-and-file-length
  (let [dir (stdproc/string-from-slice "/tmp/coil-scheme-dir-unit")
        a (stdproc/string-from-slice "/tmp/coil-scheme-dir-unit/a")
        b (stdproc/string-from-slice "/tmp/coil-scheme-dir-unit/b")]
    (scm-delete-file a) (scm-delete-file b) (delete-directory dir)
    (assert (truthy? (mkdir dir)))
    (let [p (open-output-file a)]
      (put-string p (stdproc/string-from-slice "abcd"))
      (close-output-port p))
    (let [p (open-output-file b)] (close-output-port p))
    (let [p (open-input-file a)]
      (assert-eq (fixnum-value (file-length p)) 4)
      (close-input-port p))
    (let [names (directory-list dir)]
      (assert (port-test-has-name? names (stdproc/string-from-slice "a")))
      (assert (port-test-has-name? names (stdproc/string-from-slice "b"))))
    (assert (truthy? (scm-delete-file a)))
    (assert (truthy? (scm-delete-file b)))
    (assert (truthy? (delete-directory dir)))))

(deftest file-input-port-peek-read-eof-and-close
  (let [p (open-input-file (stdproc/string-from-slice "tests/scheme/fixtures/input.txt"))]
    (assert (port-input? p))
    (assert (val-eq? (scm-peek-char p) (mk-char 97)))
    (assert (val-eq? (scm-peek-char p) (mk-char 97)))
    (assert (val-eq? (scm-read-char p) (mk-char 97)))
    (assert (val-eq? (scm-read-char p) (mk-char 98)))
    (assert (val-eq? (scm-read-char p) (mk-char 10)))
    (assert (val-eq? (scm-peek-char p) (s-eof)))
    (assert (val-eq? (scm-read-char p) (s-eof)))
    (close-input-port p)
    (assert (not (port-open? p)))
    (assert (truthy? (input-port? p)))
    ; R5RS: closing an already closed port has no effect.
    (close-input-port p)
    (assert (not (port-open? p)))))

(deftest port-predicates-and-eof-object
  (let [p (open-input-file (stdproc/string-from-slice "tests/scheme/fixtures/input.txt"))]
    (assert (truthy? (input-port? p)))
    (assert (not (truthy? (output-port? p))))
    (assert (truthy? (eof-object? (s-eof))))
    (assert (not (truthy? (eof-object? (mk-char 1)))))
    (close-input-port p)))

(deftest char-ready-is-nonblocking-and-preserves-lookahead
  (let [fds (alloc/stack (array i32 2))
        writer (alloc/stack io/Writer)
        byte (alloc/stack i8)]
    (assert-eq (os/pipe (primitive/cast (ptr i32) fds)) 0)
    (let [input-fd (primitive/cast i64 (load (primitive/index fds 0)))
          output-fd (primitive/cast i64 (load (primitive/index fds 1)))
          p (make-input-port input-fd)]
      ; An empty pipe would block, so readiness must return immediately as false.
      (assert (not (truthy? (scm-char-ready? p))))
      (store! byte (primitive/cast i8 90))
      (io/fd-writer writer output-fd)
      (assert
        (match (io/write-all writer byte 1)
          (Ok [_] true)
          (Err [_] false)))
      ; Probing consumes the OS byte only into the port's lookahead cell.
      (assert (truthy? (scm-char-ready? p)))
      (assert (val-eq? (scm-read-char p) (mk-char 90)))
      (close-input-port p)
      (assert-eq (os/close (primitive/cast i32 output-fd)) 0))))

(deftest file-output-port-round-trips-through-input-port
  (let [path (stdproc/string-from-slice "/tmp/coil-scheme-port-unit.txt")
        out (open-output-file path)]
    (assert (port-output? out))
    (scm-display-port (stdproc/string-from-slice "ab") out)
    (scm-write-char-port (mk-char 10) out)
    (close-output-port out)
    (assert (not (port-open? out)))
    (assert (truthy? (output-port? out)))
    (close-output-port out)
    (let [in (open-input-file path)]
      (assert (val-eq? (scm-read-char in) (mk-char 97)))
      (assert (val-eq? (scm-read-char in) (mk-char 98)))
      (assert (val-eq? (scm-read-char in) (mk-char 10)))
      (assert (val-eq? (scm-read-char in) (s-eof)))
      (close-input-port in))))

(deftest r5rs-file-combinators-close-and-restore-ambient-ports
  (let [input-path (stdproc/string-from-slice "tests/scheme/fixtures/input.txt")]
    (assert (val-eq?
              (call-with-input-file input-path (stdproc/scm-procedure port-test-first 1))
              (mk-char 97)))
    (let [before (current-input-port)]
      (assert (val-eq?
                (with-input-from-file input-path (stdproc/scm-procedure port-test-current-first 0))
                (mk-char 97)))
      (assert (val-eq? before (current-input-port)))))
  (let [output-path (stdproc/string-from-slice "/tmp/coil-scheme-port-combinator.txt")]
    (call-with-output-file output-path (stdproc/scm-procedure port-test-write-q 1))
    (let [in (open-input-file output-path)]
      (assert (val-eq? (scm-read-char in) (mk-char 81)))
      (close-input-port in)))
  (let [output-path (stdproc/string-from-slice "/tmp/coil-scheme-port-ambient.txt")
        before (current-output-port)]
    (with-output-to-file output-path (stdproc/scm-procedure port-test-current-write 0))
    (assert (val-eq? before (current-output-port)))
    (let [in (open-input-file output-path)]
      (assert (val-eq? (scm-read-char in) (mk-char 82)))
      (close-input-port in))))

(deftest transcript-records-current-output-and-consumed-input
  (let [transcript-path (stdproc/string-from-slice "/tmp/coil-scheme-transcript.txt")
        output-path (stdproc/string-from-slice "/tmp/coil-scheme-transcript-output.txt")
        input-path (stdproc/string-from-slice "tests/scheme/fixtures/input.txt")]
    (transcript-on transcript-path)
    (with-output-to-file output-path (stdproc/scm-procedure port-test-current-write 0))
    (assert (val-eq?
              (with-input-from-file input-path
                (stdproc/scm-procedure port-test-current-first 0))
              (mk-char 97)))
    (transcript-off)
    (let [p (open-input-file transcript-path)]
      (assert (val-eq? (scm-read-char p) (mk-char 82)))
      (assert (val-eq? (scm-read-char p) (mk-char 97)))
      (assert (val-eq? (scm-read-char p) (s-eof)))
      (close-input-port p))))

(deftest datum-read-is-sequential-and-preserves-r5rs-types
  (let [p (open-input-file (stdproc/string-from-slice "tests/scheme/fixtures/datums.scm"))]
    (assert (val-eq? (scm-read p) (mk-fixnum 42)))
    (assert (val-eq? (scm-read p) (intern "foo")))
    (assert (val-eq? (scm-read p) (s-true)))
    (assert (val-eq? (scm-read p) (s-false)))
    (assert (val-eq? (scm-read p) (mk-char 32)))
    (let [s (scm-read p)]
      (assert (is-string s))
      (assert (= (stdproc/string-length-raw s) 3))
      (assert (= (stdproc/string-code s 1) 10)))
    (let [d (scm-read p)]
      (assert (val-eq? (car d) (mk-fixnum 1)))
      (assert (val-eq? (car (cdr d)) (mk-fixnum 2)))
      (assert (val-eq? (cdr (cdr d)) (mk-fixnum 3))))
    (let [v (scm-read p)]
      (assert (is-vector v))
      (assert (= (stdproc/vector-length-raw v) 2))
      (assert (val-eq? (stdproc/scm-vector-ref v (mk-fixnum 0)) (mk-fixnum 4)))
      (assert (val-eq? (stdproc/scm-vector-ref v (mk-fixnum 1)) (intern "x"))))
    (let [q (scm-read p)]
      (assert (val-eq? (car q) (intern "quote")))
      (assert (val-eq? (car (cdr q)) (intern "q"))))
    (let [q (scm-read p)]
      (assert (val-eq? (car q) (intern "quasiquote")))
      (let [body (car (cdr q))]
        (assert (val-eq? (car body) (intern "a")))
        (assert (val-eq? (car (car (cdr body))) (intern "unquote")))
        (assert (val-eq? (car (car (cdr (cdr body)))) (intern "unquote-splicing")))))
    (let [r (scm-read p)]
      (assert (is-ratnum r))
      (assert-eq (ratnum-numerator r) 3)
      (assert-eq (ratnum-denominator r) 4))
    (let [x (scm-read p)]
      (assert (is-flonum x))
      (assert (primitive/fcmp-eq (flonum-value x) 1.25)))
    (let [n (scm-read p)]
      (assert (is-bignum n))
      (assert-eq (big-sign n) 1)
      (assert-eq (mag-length (big-limbs n)) 4))
    (let [r (scm-read p)]
      (assert (is-ratnum r))
      (assert (is-bignum (ratnum-numerator-val r)))
      (assert (val-eq? (ratnum-denominator-val r) (mk-fixnum 3))))
    (assert (val-eq? (scm-read p) (mk-fixnum 42)))
    (let [r (scm-read p)]
      (assert (is-ratnum r))
      (assert-eq (ratnum-numerator r) 5)
      (assert-eq (ratnum-denominator r) 4))
    (let [x (scm-read p)]
      (assert (is-flonum x))
      (assert (primitive/fcmp-eq (flonum-value x) 5.0)))
    (assert (val-eq? (scm-read p) (intern "+")))
    (assert (val-eq? (scm-read p) (intern "-")))
    (assert (val-eq? (scm-read p) (intern "...")))
    (assert (val-eq? (scm-read p) (intern "a1!")))
    (assert (val-eq? (scm-read p) (intern "_name")))
    (assert (val-eq? (scm-read p) (intern "<=?")))
    (assert (val-eq? (scm-read p) (intern "a@b")))
    (assert (val-eq? (scm-read p) (mk-char 65)))
    (assert (val-eq? (scm-read p) (mk-char 32)))
    (assert (val-eq? (scm-read p) (s-eof)))
    (close-input-port p)))

(deftest datum-read-keeps-partial-list-rooted-across-collection
  ;; Park the heap immediately below its collection threshold. The first pair
  ;; enters the partial reverse list; the next allocation collects while that
  ;; list exists only inside the reader. Missing explicit roots corrupt it.
  (let [sp (gc-sp)
        p (open-input-file (stdproc/string-from-slice "tests/scheme/fixtures/gc-list.scm"))]
    (gc-root p)
    (loop
      (if (>= (gc-live) 499999) (break)
        (cons (mk-fixnum 0) (s-nil))))
    (let [before (gc-collections)
          v (scm-read p)]
      (assert (> (gc-collections) before))
      (assert (truthy? (stdproc/scm-list? v)))
      (assert-eq (stdproc/list--length v 0) 5)
      (assert-eq (fixnum-value (car v)) 1)
      (assert-eq (fixnum-value (car (cdr (cdr (cdr (cdr v)))))) 5))
    (close-input-port p)
    (gc-sp-set! sp)))
