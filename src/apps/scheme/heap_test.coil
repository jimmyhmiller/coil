(module coil.scheme.heap-test)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use *)
(import "coil.control" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.bignum" :use *)

;; These tests are about the collector, so they allocate enough to actually
;; collect. A GC test that never triggers a collection tests nothing.

(deftest pairs-round-trip
  (let [p (cons (mk-fixnum 1) (mk-fixnum 2))]
    (assert (is-pair p))
    (assert (is-heap p))
    (assert-eq (fixnum-value (car p)) 1)
    (assert-eq (fixnum-value (cdr p)) 2)))

(deftest mutation-is-visible
  (let [p (cons (mk-fixnum 1) (s-nil))]
    (set-car! p (mk-fixnum 99))
    (set-cdr! p (mk-fixnum 100))
    (assert-eq (fixnum-value (car p)) 99)
    (assert-eq (fixnum-value (cdr p)) 100)))

(deftest rooted-flonum-survives-collection
  ; A flonum payload is raw IEEE bits, not a tagged Scheme value. The marker must
  ; treat the object as atomic instead of following those bits as a pointer.
  (let [sp (gc-sp)
        x (mk-flonum 3.25)]
    (gc-root x)
    (collect)
    (assert (is-flonum x))
    (assert (primitive/fcmp-eq (flonum-value x) 3.25))
    (gc-sp-set! sp)))

(deftest symbol-raw-id-is-not-traced-as-a-pointer
  ; Interned symbols store a raw table index in `a`. ID 64 is especially
  ; dangerous because its low tag bits look like a heap pointer (0x40).
  (let [sp (gc-sp)
        x (allocate (tag-symbol) 64 0 0)]
    (gc-root x)
    (collect)
    (assert (is-symbol x))
    (assert-eq (load (field (obj-of x) a)) 64)
    (gc-sp-set! sp)))

(deftest rooted-rational-survives-collection
  (let [sp (gc-sp)
        x (mk-ratnum -6 8)]
    (gc-root x)
    (collect)
    (assert (is-ratnum x))
    (assert-eq (ratnum-numerator x) -3)
    (assert-eq (ratnum-denominator x) 4)
    (gc-sp-set! sp)))

(deftest rooted-bignum-survives-collection
  (let [sp (gc-sp)
        x (integer-mul (mk-fixnum 1073741824) (mk-fixnum 1073741824))]
    (gc-root x)
    (collect)
    (assert (is-bignum x))
    (assert-eq (big-sign x) 1)
    (assert-eq (big-length x) 3)
    (assert-eq (mag-length (big-limbs x)) 3)
    (gc-sp-set! sp)))

(deftest rooted-complex-traces-both-components
  (let [sp (gc-sp)
        real (mk-ratnum -6 8)
        imag (integer-mul (mk-fixnum 1073741824) (mk-fixnum 1073741824))]
    (gc-root real)
    (gc-root imag)
    (let [z (make-complex real imag)]
      (gc-root z)
      (collect)
      (assert (is-complex-number z))
      (assert (is-ratnum (complex-real z)))
      (assert-eq (ratnum-numerator (complex-real z)) -3)
      (assert (is-bignum (complex-imag z))))
    (gc-sp-set! sp)))

(deftest immediates-do-not-allocate
  ; The whole point of immediate fixnums/nil/booleans: a loop over them must not
  ; touch the heap at all. This is the property that took the predecessor from
  ; 233M allocations to 21.5M.
  (let [before (gc-total)]
    (for [i 0 1000]
      (let [v (mk-fixnum i)]
        (assert (truthy? (mk-bool true)))
        (assert (is-null (s-nil)))
        (assert-eq (fixnum-value v) i)))
    (assert-eq (gc-total) before)))

(deftest a-rooted-list-survives-collection
  ; Build a list, root it, then allocate hard enough to force collections. If the
  ; tracer misses a link the list is corrupted and the sum comes out wrong — which
  ; is precisely the failure the precise-rooting design exists to prevent.
  (let [sp (gc-sp)
        (mut lst) (s-nil)]
    (for [i 0 100]
      (store! (mut lst) (cons (mk-fixnum i) (load (mut lst)))))
    (gc-root (load (mut lst)))
    (let [before (gc-collections)]
      (for [i 0 2000000] (cons (mk-fixnum i) (s-nil)))   ; all immediately garbage
      (assert (> (gc-collections) before)))
    (let [(mut sum) 0
          (mut p) (load (mut lst))]
      (loop
        (if (is-null (load (mut p))) (break)
          (do
            (store! (mut sum)
                    (+ (load (mut sum))
                       (fixnum-value (car (load (mut p))))))
            (store! (mut p) (cdr (load (mut p)))))))
      (assert-eq (load (mut sum)) 4950))       ; 0+1+…+99
    (gc-sp-set! sp)))

(deftest collection-bounds-the-heap
  ; 2M allocations retaining nothing must not grow the live set without bound —
  ; that is the difference between a collector and an arena.
  (let [sp (gc-sp)
        before (gc-total)]
    (for [i 0 2000000] (cons (mk-fixnum i) (s-nil)))
    ; 2M allocated, but the live set stays bounded by the collection threshold —
    ; an arena would be sitting at 2M here.
    (assert-eq (gc-total) (+ before 2000000))
    (assert (< (gc-live) 600000))
    (assert (> (gc-collections) 0))
    (gc-sp-set! sp)))
