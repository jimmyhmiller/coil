(module coil.scheme.forms)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.str" :use *)
(import "coil.slice" :use [slice-len subslice])
(import "coil.io" :as io)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.symbol" :use *)
(import "coil.scheme.core" :use *)
(import "coil.scheme.lambda" :use *)
(import "coil.scheme.port" :use [scm-display-port scm-write-port scm-newline-port])
(import "coil.scheme.stdproc"
        :use [scm-append scm-map1 scm-map2 scm-map-n
              scm-for-each1 scm-for-each2 scm-for-each-n
              scm-apply-list scm-apply1 scm-apply2 scm-apply3 scm-values-list
              scm-make-string scm-make-string-fill scm-string-append
              scm-make-vector scm-make-vector-fill scm-list->vector
              string-from-slice])

(import "coil.scheme.numeric"
        :use [scm-max scm-min scm-gcd scm-lcm scm-prefixed-number-literal
              scm-complex-literal])

(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))
(defn fm--current-index [] (-> (ptr i64)) (alloc/static i64))
(defn fm--trace-form [(event (slice u8)) (i i64) (form Code)] (-> i64)
  (let [enabled (getenv c"COIL_SCHEME_TRACE")]
    (if (= (primitive/cast i64 enabled) 0) 0
      (let [w (io/stderr)]
        (io/print-str w "scheme-forms  ")
        (io/print-str w event)
        (io/print-str w "  top-level=")
        (io/print-int w i)
        (io/print-str w "  head=")
        (if (and (primitive/code-list? form) (> (primitive/code-count form) 0))
            (io/print-str w (primitive/code-str (primitive/code-nth form 0)))
          (io/print-str w "<atom>"))
        (io/print-str w "  count=")
        (io/print-int w (if (primitive/code-list? form) (primitive/code-count form) -1))
        (when (and (primitive/code-list? form)
                   (and (>= (primitive/code-count form) 2)
                        (or (fm--name? (primitive/code-nth form 0) "define")
                            (fm--name? (primitive/code-nth form 0) "defn"))))
          (let [target (primitive/code-nth form 1)]
            (io/print-str w "  name=")
            (if (and (primitive/code-list? target) (> (primitive/code-count target) 0))
                (io/print-str w (primitive/code-str (primitive/code-nth target 0)))
              (io/print-str w (primitive/code-str target)))
            0))
        (io/write-byte w (primitive/cast u8 10))
        0))))

(defn fm--trace-problem [(kind (slice u8))] (-> i64)
  (let [enabled (getenv c"COIL_SCHEME_TRACE")]
    (if (= (primitive/cast i64 enabled) 0) 0
      (let [w (io/stderr)]
        (io/print-str w "scheme-forms  malformed=")
        (io/print-str w kind)
        (io/print-str w "  top-level=")
        (io/print-int w (primitive/load (fm--current-index)))
        (io/write-byte w (primitive/cast u8 10))
        0))))

;; Stable owner for string-literal lowering. Generated code refers to this
;; module-local function rather than an imported implementation name, so the
;; reference remains resolvable when the Scheme lowering pass runs in an
;; isolated compile-time phase program.
(defn scm-string-literal [(s (slice u8))] (-> i64) (string-from-slice s))

;; The irreducible core: `quote` as runtime data, the R5RS-spelled arithmetic,
;; the literals, and the surface lowering that makes them reachable — everything
;; in R5RS §4.1 that `core.coil` did not already carry.
;;
;; ⚠ THIS MODULE BINDS `+ - * < > =` AS MACROS, WHICH SHADOWS COIL'S OPERATORS
;; INSIDE THIS FILE. Every internal arithmetic and comparison is therefore
;; written as an explicit `primitive/iadd` / `primitive/icmp-ge` / … call. That
;; is not a style choice — a bare `(+ i 1)` here resolves to the Scheme `+` macro
;; and fails to compile with an arity error from inside the metaprogram engine.
;; Any new helper in this file must follow the same discipline.
;;
;; Two facts about the host shape the rest, and both are load-bearing:
;;
;; 1. `defn` has no runtime rest parameter — `&` exists only for macros. So a
;;    variadic Scheme procedure cannot be one function that inspects its argument
;;    count; the collection has to happen at the CALL SITE.
;;
;; 2. `defn` is a top-level form and the compiler rejects one in expression
;;    position. Anything that needs a new top-level definition therefore cannot
;;    be an ordinary expression macro — it needs a whole-module pass.

; ---- literals ---------------------------------------------------------------
;; `#t`, `#f` and `#\c` all read as SYMBOLS — the reader hands them through as
;; names whose text begins with `#`, and there is no `code-char?` predicate. So
;; classification is a text test on `code-str`, and it is the same test `quote`
;; uses to materialize that syntax as data.

(defn lit--true? [(e Code)] (-> bool)
  (and (primitive/code-sym? e)
       (or (str-eq (primitive/code-str e) "#t")
           (str-eq (primitive/code-str e) "#T"))))
(defn lit--false? [(e Code)] (-> bool)
  (and (primitive/code-sym? e)
       (or (str-eq (primitive/code-str e) "#f")
           (str-eq (primitive/code-str e) "#F"))))
;; `#\a`, `#\space`, `#\newline` — a char literal is any `#\`-prefixed name.
(defn lit--char? [(e Code)] (-> bool)
  (and (primitive/code-sym? e) (starts-with (primitive/code-str e) "#\\")))

(defn lit--ascii-down [(c i64)] (-> i64)
  (if (and (>= c 65) (<= c 90)) (+ c 32) c))
(defn lit--ci-eq-at [(a (slice u8)) (b (slice u8)) (i i64)] (-> bool)
  (if (>= i (slice-len a)) true
    (and (= (lit--ascii-down (primitive/cast i64 (char-at a i)))
            (lit--ascii-down (primitive/cast i64 (char-at b i))))
         (lit--ci-eq-at a b (+ i 1)))))
(defn lit--ci-eq [(a (slice u8)) (b (slice u8))] (-> bool)
  (and (= (slice-len a) (slice-len b)) (lit--ci-eq-at a b 0)))

(defn lit--hex-digit [(c i64)] (-> i64)
  (cond (and (>= c 48) (<= c 57)) (primitive/isub c 48)
        (and (>= c 97) (<= c 102)) (primitive/iadd (primitive/isub c 97) 10)
        (and (>= c 65) (<= c 70)) (primitive/iadd (primitive/isub c 65) 10)
        :else -1))
(defn lit--hex-code [(s (slice u8)) (i i64) (v i64)] (-> i64)
  (if (>= i (slice-len s)) v
    (let [d (lit--hex-digit (primitive/cast i64 (char-at s i)))]
      (if (< d 0) -1
        (lit--hex-code s (primitive/iadd i 1) (primitive/iadd (primitive/imul v 16) d))))))

;; The code point a `#\…` literal denotes. R5RS names `space` and `newline`;
;; everything else is the single character after the prefix. Multi-byte UTF-8 is
;; NOT decoded — the reader hands over bytes, not code points, so a non-ASCII
;; char literal would yield its first byte. ASCII-only, and honest about it.
(defn lit--char-code [(s (slice u8))] (-> i64)
  (cond (lit--ci-eq s "#\\space") 32
        (lit--ci-eq s "#\\alarm") 7
        (or (lit--ci-eq s "#\\newline") (lit--ci-eq s "#\\linefeed")) 10
        (lit--ci-eq s "#\\tab") 9
        (lit--ci-eq s "#\\vtab") 11
        (lit--ci-eq s "#\\return") 13
        (or (lit--ci-eq s "#\\nul") (lit--ci-eq s "#\\null")) 0
        (lit--ci-eq s "#\\backspace") 8
        (or (lit--ci-eq s "#\\formfeed") (lit--ci-eq s "#\\page")) 12
        (lit--ci-eq s "#\\esc") 27
        (or (lit--ci-eq s "#\\delete") (lit--ci-eq s "#\\rubout")) 127
        (and (> (slice-len s) 3)
             (or (= (primitive/cast i64 (char-at s 2)) 120)
                 (= (primitive/cast i64 (char-at s 2)) 117)))
          (lit--hex-code s 3 0)
        :else (primitive/cast i64 (char-at s 2))))

;; The host reader intentionally leaves `3/4` as a symbol. Scheme gives it
;; numeric meaning, so identify one slash with valid signed decimal integers on
;; both sides and lower it to the same normalized runtime representation as `/`.
(defn lit--slash-index [(s (slice u8)) (i i64) (found i64)] (-> i64)
  (if (>= i (slice-len s)) found
    (if (= (primitive/cast i64 (char-at s i)) 47)
        (if (>= found 0) -2 (lit--slash-index s (+ i 1) i))
      (lit--slash-index s (+ i 1) found))))
(defn lit--digit-span? [(s (slice u8)) (start i64) (end i64) (i i64)] (-> bool)
  (if (>= i end) true
    (let [c (primitive/cast i64 (char-at s i))]
      (and (and (>= c 48) (<= c 57))
           (lit--digit-span? s start end (+ i 1))))))
(defn lit--signed-decimal-span? [(s (slice u8)) (start i64) (end i64)] (-> bool)
  (if (>= start end) false
    (let [c (primitive/cast i64 (char-at s start))
          digits (if (or (= c 43) (= c 45)) (+ start 1) start)]
      (and (< digits end) (lit--digit-span? s digits end digits)))))
(defn lit--nonzero-decimal-span? [(s (slice u8)) (start i64) (end i64)] (-> bool)
  (if (>= start end) false
    (let [c (primitive/cast i64 (char-at s start))
          digits (if (or (= c 43) (= c 45)) (+ start 1) start)]
      (if (>= digits end) false
        (let [d (primitive/cast i64 (char-at s digits))]
          (if (and (>= d 49) (<= d 57)) true
            (lit--nonzero-decimal-span? s (+ digits 1) end)))))))
(defn lit--rational? [(e Code)] (-> bool)
  (if (not (primitive/code-sym? e)) false
    (let [s (primitive/code-str e) slash (lit--slash-index s 0 -1)]
      (if (or (<= slash 0) (>= slash (- (slice-len s) 1))) false
        (and (lit--signed-decimal-span? s 0 slash)
             (and (lit--signed-decimal-span? s (+ slash 1) (slice-len s))
                  (lit--nonzero-decimal-span? s (+ slash 1) (slice-len s))))))))
(defn lit--rational-code [(e Code)] (-> Code)
  `(scm-rational-literal ~(primitive/code-str e)))

(defn lit--has-digit? [(s (slice u8)) (i i64)] (-> bool)
  (if (>= i (slice-len s)) false
    (let [c (primitive/cast i64 (char-at s i))]
      (if (and (>= c 48) (<= c 57)) true (lit--has-digit? s (+ i 1))))))
(defn lit--has-at? [(s (slice u8)) (i i64)] (-> bool)
  (if (>= i (slice-len s)) false
    (if (= (primitive/cast i64 (char-at s i)) 64) true
      (lit--has-at? s (+ i 1)))))
(defn lit--complex? [(e Code)] (-> bool)
  (if (not (primitive/code-sym? e)) false
    (let [s (primitive/code-str e) n (slice-len s)]
      (and (>= n 2)
           (and (not (= (primitive/cast i64 (char-at s 0)) 35))
           (and (or (lit--has-at? s 0)
                    (or (= (primitive/cast i64 (char-at s (- n 1))) 105)
                        (= (primitive/cast i64 (char-at s (- n 1))) 73)))
                (lit--has-digit? s 0)))))))
(defn lit--complex-code [(e Code)] (-> Code)
  `(scm-complex-literal ~(primitive/code-str e)))

(defn lit--decimal-digits? [(s (slice u8)) (i i64)] (-> bool)
  (if (>= i (slice-len s)) true
    (let [c (primitive/cast i64 (char-at s i))]
      (and (and (>= c 48) (<= c 57)) (lit--decimal-digits? s (+ i 1))))))
(defn lit--big-integer? [(e Code)] (-> bool)
  (if (not (primitive/code-sym? e)) false
    (let [s (primitive/code-str e) n (slice-len s)]
      (if (= n 0) false
        (let [c (primitive/cast i64 (char-at s 0))
              start (if (or (= c 43) (= c 45)) 1 0)]
          (and (< start n) (lit--decimal-digits? s start)))))))
(defn lit--big-integer-code [(e Code)] (-> Code)
  `(scm-integer-literal ~(primitive/code-str e)))
(defn lit--prefix-char? [(c i64)] (-> bool)
  (or (= c 98) (or (= c 66) (or (= c 111) (or (= c 79)
  (or (= c 100) (or (= c 68) (or (= c 120) (or (= c 88)
  (or (= c 101) (or (= c 69) (or (= c 105) (= c 73)))))))))))))
(defn lit--prefixed-number? [(e Code)] (-> bool)
  (if (not (primitive/code-sym? e)) false
    (let [s (primitive/code-str e)]
      (and (>= (slice-len s) 2)
           (and (= (primitive/cast i64 (char-at s 0)) 35)
                (lit--prefix-char? (primitive/cast i64 (char-at s 1))))))))
(defn lit--prefixed-number-code [(e Code)] (-> Code)
  `(scm-prefixed-number-literal ~(primitive/code-str e)))

;; `#t` / `#f` as expressions. Macros, not functions, so they cost nothing at
;; runtime and so `quote` and the expression reader agree on spelling.
(defn scm-true [] (-> Code) `(s-true))
(defn scm-false [] (-> Code) `(s-false))

;; `'()` bottoms out here; `nil` is the same value under a name needing no quote.
(defn nil [] (-> Code) `(s-nil))

; ---- quote ------------------------------------------------------------------
;; `quote` turns a compile-time Code tree into a RUNTIME Val.
;;
;; This is the form that most repays care. `dialect.coil` already shields a
;; quoted form from the dialect rewrite, but shielding only stops the syntax
;; being read as code — it does not make the data exist. `(display '(a b c))`
;; needs three interned symbols spine-linked by two conses, built by code this
;; macro emits, because nothing at runtime otherwise knows the shape.
;;
;; Interning is what makes `(eq? 'a 'a)` true.  Literal sites use the pointer-keyed
;; cache in symbol.coil so a hot quote does not linearly search the symbol table on
;; every evaluation; the cache's first miss still reaches the canonical interner.
(defn quo--data [(e Code)] (-> Code)
  (if (primitive/code-int? e) `(mk-fixnum ~e)
    (if (primitive/code-float? e) `(mk-flonum-bits ~(primitive/code-float-bits e))
    (if (lit--complex? e) (lit--complex-code e)
    (if (lit--prefixed-number? e) (lit--prefixed-number-code e)
    (if (lit--big-integer? e) (lit--big-integer-code e)
    (if (lit--rational? e) (lit--rational-code e)
    (if (primitive/code-vector? e)
        `(scm-list->vector ~(quo--list e 0 (primitive/code-count e)))
      (if (primitive/code-list? e)
        (quo--list e 0 (primitive/code-count e))
      ; the literals that read as symbols, `#`-prefixed spellings before names
      (if (lit--true? e) `(s-true)
        (if (lit--false? e) `(s-false)
          (if (lit--char? e) `(mk-char ~(lit--char-code (primitive/code-str e)))
            (if (primitive/code-sym? e) `(intern-literal ~(primitive/code-str e))
              ; Lists, vectors, numbers, symbols, and characters were exhausted
              ; above, so the remaining reader datum kind is a string literal.
              `(scm-string-literal ~(primitive/code-str e)))))))))))))))

;; A quoted list becomes a right-nested chain of conses ending in nil — the
;; proper-list spine. Recursion builds it back-to-front, so `'()` falls out as
;; the base case rather than needing a branch of its own.
;;
;; A dotted `(a . b)` is NOT handled: the reader keeps the `.` as an ordinary
;; symbol, so it would intern as one. Quoted improper lists are unsupported.
(defn quo--list [(e Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `(s-nil)
    `(cons ~(quo--data (primitive/code-nth e i))
           ~(quo--list e (primitive/iadd i 1) n))))

(defn quote-data [(e Code)] (-> Code) (quo--data e))

; ---- lifting a literal to a Val ---------------------------------------------
;; A bare `42` in Scheme source is a NUMBER; in Coil it is a raw i64 whose low
;; tag bits read as "heap pointer", so handing it to `scm-display` prints
;; `#<object>` and handing it to `scm-add` shifts it into garbage. Every literal
;; that reaches a Scheme operator has to become `(mk-fixnum 42)` first.
;;
;; ⚠ THIS IS DONE PER-ARGUMENT BY EACH MACRO, NOT BY A WHOLE-TREE TRANSFORM, and
;; the reason is a hard constraint of the host. A `before-expand` transform must
;; reach a FIXPOINT: it is re-run on its own output until the output stops
;; changing, and the compiler aborts with "did not reach a fixpoint after 16
;; rounds" if it never does. Rewriting `1` into `(mk-fixnum 1)` re-presents the
;; literal `1` to the next round, so such a pass never settles — it was tried,
;; and the observable symptom is not an error but SILENCE: the rewrite is
;; discarded and raw i64s reach `scm-add`, which shifts them into garbage.
;; Lifting at the point of use is local, runs once during ordinary macro
;; expansion, and cannot diverge.
;;
;; The cost: a literal becomes a Val only where a form in this file puts it
;; there. `(scm-display 42)` called directly still prints `#<object>` — the
;; lifting is a property of the Scheme surface, not of the whole language.
;; ── FORMS WHOSE ELEMENT 1 IS A BINDER LIST, NOT AN EXPRESSION ────────────────
;;
;; ⚠ AN OMISSION HERE DELETES CODE RATHER THAN FAILING. The generic walk treats
;; element 1 as an expression, so `((a 1) (b 2))` is rewritten as if it were a
;; call and the macro receives an empty binding list — the program then fails
;; with `unbound variable 'a'` against the USER's source, bindings silently gone.
;;
;; `scm-let` was special-cased here and its siblings were not, which is why
;; `let*`, `letrec` and `do` all lost their bindings. Kept as one predicate so a
;; new binding form is added in one place; `rooting.coil` carries the same list
;; for the same reason.
(defn fm--name? [(h Code) (want (slice u8))] (-> bool)
  (if (not (primitive/code-sym? h)) false
    (let [name (primitive/code-str h) n (slice-len name) wn (slice-len want)]
      (or (str-eq name want)
          (and (> n wn)
               (and (= (subslice name (- n wn) n) want)
                    (= (subslice name (- (- n wn) 1) (- n wn)) ".")))))))

(defn fm--binder-list-form? [(h Code)] (-> bool)
  (or (fm--name? h "scm-let")
      (or (fm--name? h "let*")
          (or (fm--name? h "letrec")
              (or (fm--name? h "letrec*")
                  (fm--name? h "scm-do"))))))

;; A head that is a literal rather than a name. Only these are lifted in head
;; position; anything else there is a procedure being applied. See the note at
;; the generic call branch for why this exception exists.
(defn fm--literal-head? [(e Code)] (-> bool)
  (or (primitive/code-int? e)
      (or (primitive/code-float? e)
          (or (lit--complex? e)
          (or (lit--prefixed-number? e)
          (or (lit--big-integer? e)
              (or (lit--rational? e)
              (or (lit--true? e) (or (lit--false? e) (lit--char? e))))))))))

(defn lift [(e Code)] (-> Code)
  (if (primitive/code-int? e) `(mk-fixnum ~e)
    (if (primitive/code-float? e) `(mk-flonum-bits ~(primitive/code-float-bits e))
    (if (lit--complex? e) (lit--complex-code e)
    (if (lit--prefixed-number? e) (lit--prefixed-number-code e)
    (if (lit--big-integer? e) (lit--big-integer-code e)
    (if (lit--rational? e) (lit--rational-code e)
    (if (lit--true? e) `(s-true)
      (if (lit--false? e) `(s-false)
        (if (lit--char? e) `(mk-char ~(lit--char-code (primitive/code-str e)))
          e))))))))))

; ---- arithmetic and comparison ----------------------------------------------
;; R5RS spells these `+ - * < > =` and they are VARIADIC. `core.coil` has the
;; binary core; these fold onto it left-associatively, which is what `-` requires
;; (`(- 10 1 2)` is 7, not 11) and what makes comparisons chain.
;;
;; Nothing was bound under these names before, so every conformance case failed
;; on its first line without them.

(defn arith--binary [(op Code) (a Code) (b Code)] (-> Code)
  (let [ta (primitive/gensym) tb (primitive/gensym)]
    (if (primitive/code-eq op `scm-add)
        `(let [~ta ~a ~tb ~b]
           (if (and (is-fixnum ~ta) (is-fixnum ~tb))
               (scm-fixnum-add ~ta ~tb)
             (scm-add-slow ~ta ~tb)))
      (if (primitive/code-eq op `scm-sub)
          `(let [~ta ~a ~tb ~b]
             (if (and (is-fixnum ~ta) (is-fixnum ~tb))
                 (scm-fixnum-sub ~ta ~tb)
               (scm-sub-slow ~ta ~tb)))
        `(~op ~a ~b)))))

(defn arith--fold [(op Code) (es Code) (i i64) (n i64) (acc Code)] (-> Code)
  (if (primitive/icmp-ge i n) acc
    (arith--fold op es (primitive/iadd i 1) n
                 (arith--binary op acc (lift (primitive/code-nth es i))))))

;; `(+)` is 0 and `(*)` is 1 — R5RS gives both an identity, and a fold over no
;; arguments has to produce it.
(defn + [& (es Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count es) 0) `(mk-fixnum 0)
    (arith--fold `scm-add es 1 (primitive/code-count es)
                 (lift (primitive/code-nth es 0)))))

(defn * [& (es Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count es) 0) `(mk-fixnum 1)
    (arith--fold `scm-mul es 1 (primitive/code-count es)
                 (lift (primitive/code-nth es 0)))))

;; `-` is the asymmetric one: with ONE argument it negates rather than folds.
;; `(- 5)` is -5, not 5.
(defn - [& (es Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count es) 1)
      `(scm-sub (mk-fixnum 0) ~(lift (primitive/code-nth es 0)))
    (arith--fold `scm-sub es 1 (primitive/code-count es)
                 (lift (primitive/code-nth es 0)))))

;; Exact operands produce normalized exact rationals. A one-argument division is
;; the reciprocal; mixed/inexact operands promote through `scm-div`.
(defn / [& (es Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count es) 1)
      `(scm-div (mk-fixnum 1) ~(lift (primitive/code-nth es 0)))
    (arith--fold `scm-div es 1 (primitive/code-count es)
                 (lift (primitive/code-nth es 0)))))

;; A chained comparison must evaluate each operand ONCE — `(< a b c)` means
;; `(and (< a b) (< b c))`, in which `b` appears twice, so every operand is bound
;; to a temporary first. Getting this wrong stays invisible until an operand has
;; a side effect.
(defn cmp--chain [(op Code) (tmps Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i (primitive/isub n 1)) `(s-true)
    (if (primitive/icmp-eq i (primitive/isub n 2))
        (cmp--binary op (primitive/code-nth tmps i)
                         (primitive/code-nth tmps (primitive/iadd i 1)))
      `(if (truthy? ~(cmp--binary op (primitive/code-nth tmps i)
                                  (primitive/code-nth tmps (primitive/iadd i 1))))
           ~(cmp--chain op tmps (primitive/iadd i 1) n)
         (s-false)))))

(defn cmp--binary [(op Code) (a Code) (b Code)] (-> Code)
  (if (primitive/code-eq op `scm-lt)
      `(if (and (is-fixnum ~a) (is-fixnum ~b))
           (scm-fixnum-lt ~a ~b)
         (scm-lt-slow ~a ~b))
    `(~op ~a ~b)))

(defn cmp--tmps [(n i64) (i i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
    `(~(primitive/gensym) ~@(cmp--tmps n (primitive/iadd i 1)))))

(defn cmp--binds [(tmps Code) (es Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `[]
    `[~(primitive/code-nth tmps i) ~(lift (primitive/code-nth es i))
      ~@(cmp--binds tmps es (primitive/iadd i 1) n)]))

(defn cmp--build [(op Code) (es Code)] (-> Code)
  (let [n (primitive/code-count es)]
    (if (primitive/icmp-lt n 2)
        (primitive/error "comparison expects at least two arguments")
      (let [tmps (cmp--tmps n 0)]
        `(let ~(cmp--binds tmps es 0 n) ~(cmp--chain op tmps 0 n))))))

(defn < [& (es Code)] (-> Code) (cmp--build `scm-lt es))
(defn > [& (es Code)] (-> Code) (cmp--build `scm-gt es))
(defn <= [& (es Code)] (-> Code) (cmp--build `scm-le es))
(defn >= [& (es Code)] (-> Code) (cmp--build `scm-ge es))
(defn = [& (es Code)] (-> Code) (cmp--build `scm-num-eq es))

; ---- list -------------------------------------------------------------------
;; `(list a b c)` — folded right so the spine ends in nil.
(defn list--build [(es Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `(s-nil)
    `(cons ~(lift (primitive/code-nth es i))
           ~(list--build es (primitive/iadd i 1) n))))
(defn list [& (es Code)] (-> Code)
  (list--build es 0 (primitive/code-count es)))

;; R5RS `string` is the character analogue of `list`.
(defn string [& (chars Code)] (-> Code)
  `(scm-list->string (list ~@chars)))

;; R5RS's list combinators are variadic, while the runtime entry points stay
;; arity-specialized so indirect calls retain precise function-pointer types.
;; These surface macros perform that dispatch at compile time. Arguments are
;; passed through unchanged: the whole-module forms pass has already lowered
;; literals and lambda lifting has already made procedure values concrete.
(defn append--build [(es Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `(s-nil)
    (if (primitive/icmp-eq i (primitive/isub n 1))
        (primitive/code-nth es i)
      `(scm-append ~(primitive/code-nth es i)
                   ~(append--build es (primitive/iadd i 1) n)))))

(defn append [& (es Code)] (-> Code)
  (append--build es 0 (primitive/code-count es)))

;; R5RS `string-append` accepts any number of strings; the runtime binary helper
;; stays the efficient primitive used by this expansion and procedure-value ABI.
(defn string-append--build [(es Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `(scm-string-literal "")
    (if (= i (- n 1)) (primitive/code-nth es i)
      `(scm-string-append ~(primitive/code-nth es i)
                          ~(string-append--build es (+ i 1) n)))))
(defn string-append [& (es Code)] (-> Code)
  (string-append--build es 0 (primitive/code-count es)))

(defn map [(p Code) & (lists Code)] (-> Code)
  (let [n (primitive/code-count lists)]
    (if (primitive/icmp-eq n 1)
        `(scm-map1 ~(lam--surface-value p) ~(primitive/code-nth lists 0))
      (if (primitive/icmp-eq n 2)
          `(scm-map2 ~(lam--surface-value p) ~(primitive/code-nth lists 0)
                       ~(primitive/code-nth lists 1))
        `(scm-map-n ~(lam--surface-value p) (list ~@lists))))))

(defn for-each [(p Code) & (lists Code)] (-> Code)
  (let [n (primitive/code-count lists)]
    (if (primitive/icmp-eq n 1)
        `(scm-for-each1 ~(lam--surface-value p) ~(primitive/code-nth lists 0))
      (if (primitive/icmp-eq n 2)
          `(scm-for-each2 ~(lam--surface-value p) ~(primitive/code-nth lists 0)
                            ~(primitive/code-nth lists 1))
        `(scm-for-each-n ~(lam--surface-value p) (list ~@lists))))))

(defn fm--apply-list [(args Code) (i i64) (last i64)] (-> Code)
  (if (= i last) (primitive/code-nth args last)
    `(cons ~(primitive/code-nth args i) ~(fm--apply-list args (+ i 1) last))))

(defn apply [(p Code) & (args Code)] (-> Code)
  (let [n (primitive/code-count args)]
    (if (= n 0) (primitive/error "apply: expected a final argument list")
      `(scm-apply-list ~(lam--surface-value p) ~(fm--apply-list args 0 (- n 1))))))

(defn values [& (es Code)] (-> Code)
  `(scm-values-list (list ~@es)))

(defn make-string [(n Code) & (fills Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count fills) 0)
      `(scm-make-string ~n)
    `(scm-make-string-fill ~n ~(primitive/code-nth fills 0))))

(defn make-vector [(n Code) & (fills Code)] (-> Code)
  (if (primitive/icmp-eq (primitive/code-count fills) 0)
      `(scm-make-vector ~n)
    `(scm-make-vector-fill ~n ~(primitive/code-nth fills 0))))
(defn vector [& (es Code)] (-> Code)
  `(scm-list->vector (list ~@es)))

;; Numeric's variadic implementations intentionally retain `scm-` names so they
;; do not shadow Coil arithmetic inside their own module. The public call-site
;; macros live here, where arithmetic is already explicitly qualified.
(defn max [& (es Code)] (-> Code) `(scm-max ~@es))
(defn min [& (es Code)] (-> Code) `(scm-min ~@es))
(defn gcd [& (es Code)] (-> Code) `(scm-gcd ~@es))
(defn lcm [& (es Code)] (-> Code) `(scm-lcm ~@es))

; ---- output under the R5RS names --------------------------------------------
;; `core.coil` has the implementations; these are the names R5RS uses.
;; `display` routes to `scm-display2` (stdproc.coil), the printer that knows
;; strings, vectors and chars. `core.coil`'s `scm-display` predates those types
;; and prints them as `#<object>`.
(defn display [(v Code) & (ports Code)] (-> Code)
  (if (= (primitive/code-count ports) 0)
      `(scm-display2 ~(lift v))
    `(scm-display-port ~(lift v) ~(primitive/code-nth ports 0))))
(defn write [(v Code) & (ports Code)] (-> Code)
  (if (= (primitive/code-count ports) 0)
      `(scm-write ~(lift v))
    `(scm-write-port ~(lift v) ~(primitive/code-nth ports 0))))
(defn newline [& (ports Code)] (-> Code)
  (if (= (primitive/code-count ports) 0) `(scm-newline)
    `(scm-newline-port ~(primitive/code-nth ports 0))))

; ---- the quote lowering ------------------------------------------------------
;; `quote` is the one form in this chunk that CANNOT be a macro: it is a reserved
;; name. `(quote X)` evaluates to a `Code` value and `defn quote` is rejected
;; outright, so the only way to reach it is to rewrite the call before expansion.
;; That is what this transform does, and it does nothing else.
;;
;; It converges — the requirement a `before-expand` transform must meet — because
;; the rewrite changes the HEAD, from `quote` to `quote-data`. The next round
;; finds no `quote` to rewrite and the output is stable. A rewrite that wrapped a
;; node in a form still containing that node (lifting `1` to `(mk-fixnum 1)`, for
;; instance) would never settle, which is exactly why literal lifting is done by
;; `lift` at each use site instead of here.
;;
;; `dialect.coil` already shields a quoted form from ITS rewrite, so the argument
;; arrives with the author's surface syntax intact — which is what `quote-data`
;; needs, since `(quote (let ((a 1))))` is data and must not have become
;; `scm-let`.

(defn fm--all [(gs Code) (vs Code) (e Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
    `(~(fm--rewrite gs vs (primitive/code-nth e i))
      ~@(fm--all gs vs e (primitive/iadd i 1) n))))

;; `case` clause heads are datum lists, not applications. After the dialect
;; lowers surface `case` to `scm-case`, preserve element 0 of every clause and
;; rewrite only its result expressions. A label such as `(if)` or `(/)` is
;; perfectly ordinary Scheme data and must never enter the `if` or arithmetic
;; expression branches below.
(defn fm--case-clauses [(gs Code) (vs Code) (e Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    (let [clause (primitive/code-nth e i)]
      (if (and (primitive/code-list? clause) (> (primitive/code-count clause) 0))
          `((~(primitive/code-nth clause 0)
             ~@(fm--all gs vs clause 1 (primitive/code-count clause)))
            ~@(fm--case-clauses gs vs e (+ i 1) n))
        `(~clause ~@(fm--case-clauses gs vs e (+ i 1) n))))))

(defn fm--arith-fold [(gs Code) (vs Code) (op Code) (es Code)
                      (i i64) (n i64) (acc Code)] (-> Code)
  (if (primitive/icmp-ge i n) acc
    (fm--arith-fold gs vs op es (primitive/iadd i 1) n
      (arith--binary op acc (fm--rewrite gs vs (primitive/code-nth es i))))))

;; Binder forms whose parameter vector and return type are not expressions —
;; the same list `dialect.coil` keeps. A `quote` cannot appear there, but
;; descending would rebuild the binding VECTOR as a list and break the parser.
(defn fm--binder? [(h Code)] (-> bool)
  (or (primitive/code-eq h `defn)
      (or (primitive/code-eq h `defstruct)
          (or (primitive/code-eq h `defsum)
              (or (primitive/code-eq h `deftrait)
                  (or (primitive/code-eq h `impl)
                      (primitive/code-eq h `defcc)))))))

(defn fm--verbatim [(e Code) (i i64) (stop i64) (n i64)] (-> Code)
  (if (or (primitive/icmp-ge i stop) (primitive/icmp-ge i n)) `()
    `(~(primitive/code-nth e i)
      ~@(fm--verbatim e (primitive/iadd i 1) stop n))))

(defn fm--body-start [(e Code)] (-> i64)
  (if (primitive/code-eq (primitive/code-nth e 0) `defn)
      (if (and (primitive/icmp-ge (primitive/code-count e) 4)
               (primitive/code-eq (primitive/code-nth e 2) `:cc)) 6 4)
    3))

;; Is this test already lowered? See the guard at the `if` case below.
(defn fm--truthy-call? [(e Code)] (-> bool)
  (and (primitive/code-list? e)
       (and (primitive/icmp-ge (primitive/code-count e) 1)
            (primitive/code-eq (primitive/code-nth e 0) `truthy?))))

;; ⚠ THE FIXPOINT RULE, STATED ONCE FOR THE THREE REWRITES BELOW THAT OBEY IT.
;;
;; A `before-expand` pass is re-run on its own output until the output stops
;; changing. A rewrite that re-presents its input is therefore not merely slow,
;; it is fatal: the compiler aborts with "did not reach a fixpoint after 16
;; rounds". Literal lifting is the case where this is easy to get wrong, because
;; `1` -> `(mk-fixnum 1)` puts a `1` right back into the tree for the next round
;; to find. The fix is not to abandon the rewrite (an earlier attempt did, and
;; fell back to per-macro lifting, which left `(sq 7)` passing a raw 7 and
;; printing 0). The fix is that the pass must not DESCEND into what it emitted:
;; `mk-fixnum` / `mk-flonum-bits` / `mk-char` / `intern` / `quote-data` are the
;; pass's own output and their arguments are raw host data, not Scheme
;; expressions. In particular, descending into an IEEE-754 payload relifts its
;; sign bit as a Scheme integer and destroys negative literals and signed zero.
;; Skipping them makes
;; the rewrite a fixed point of itself, exactly as `fm--truthy-call?` does for
;; `if`.
(defn fm--lowered? [(h Code)] (-> bool)
  (or (fm--name? h "scm-string-literal")
  (or (primitive/code-eq h `mk-fixnum)
  (or (primitive/code-eq h `mk-flonum-bits)
  (or (primitive/code-eq h `mk-char)
  (or (primitive/code-eq h `intern)
  (or (primitive/code-eq h `intern-literal)
  (or (primitive/code-eq h `quote-data)
  ;; Raw strings, code addresses, arities, and capture indexes are host metadata,
  ;; not Scheme expressions; descending would either relift or GC-root them.
  (or (primitive/code-eq h `string-from-slice)
  (or (primitive/code-eq h `make-closure)
  (or (primitive/code-eq h `make-procedure)
  (or (primitive/code-eq h `make-reducer)
  (or (primitive/code-eq h `make-list-procedure)
      (primitive/code-eq h `env-ref))))))))))))))

;; ---- global variable references ---------------------------------------------
;; `(define x 41)` lowers to a zero-argument getter (core.coil), so a REFERENCE to
;; `x` has to become the call `(x)`. Scheme writes the reference bare, so the pass
;; rewrites `x` -> `(x)` — but only for names it has actually seen defined as
;; variables in this module, because rewriting every bare symbol would turn
;; parameters, `let` bindings and procedure names into calls.
;;
;; The defined-variable set is gathered in a prepass over the module's top level
;; and threaded through the walk as a Code list of names. `(define (f …) …)` is a
;; PROCEDURE, not a variable — its head is a list — so it is deliberately excluded:
;; `f` stays a name that call syntax applies.
(defn fm--global? [(names Code) (i i64) (n i64) (s Code)] (-> bool)
  (if (primitive/icmp-ge i n) false
    (if (primitive/code-eq (primitive/code-nth names i) s) true
      (fm--global? names (primitive/iadd i 1) n s))))

(defn fm--globals-of [(m Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
    (let [f (primitive/code-nth m i)]
      (if (and (primitive/code-list? f)
               (and (primitive/icmp-ge (primitive/code-count f) 3)
                    (and (primitive/code-eq (primitive/code-nth f 0) `define)
                         (not (primitive/code-list? (primitive/code-nth f 1))))))
          `(~(primitive/code-nth f 1) ~@(fm--globals-of m (primitive/iadd i 1) n))
        (fm--globals-of m (primitive/iadd i 1) n)))))

(defn fm--rewrite [(gs Code) (vs Code) (e Code)] (-> Code)
  ;; `#\a` reads as a SYMBOL whose text is `#\a` — the reader keeps the prefix, and
  ;; nothing downstream binds that name, so an unlowered char literal reaches
  ;; codegen as `unbound variable '#\a'`. Integers are handled by the caller's
  ;; element walk and `#t`/`#f` resolve as ordinary names, but a char has no
  ;; binding to fall back on and must be turned into its `mk-char` here.
  (if (lit--char? e) `(mk-char ~(lit--char-code (primitive/code-str e)))
  (if (lit--complex? e) (lit--complex-code e)
  (if (or (lit--prefixed-number? e) (lit--big-integer? e))
      (if (lit--prefixed-number? e) (lit--prefixed-number-code e)
        (lit--big-integer-code e))
  (if (lit--rational? e) (lit--rational-code e)
  ;; Decimal literals are heap flonums. Preserve their reader-produced IEEE bits
  ;; rather than converting through text a second time.
  (if (primitive/code-float? e) `(mk-flonum-bits ~(primitive/code-float-bits e))
  ;; A bare integer is a NUMBER in Scheme but a raw i64 in Coil, whose low tag
  ;; bits read as "heap pointer". Unlifted, it reaches `scm-add` and is shifted
  ;; into garbage, or reaches `scm-display` and prints as an object — silently
  ;; wrong in both directions. Lifting here, in the whole-tree pass, is what makes
  ;; a literal work at EVERY position: user call sites `(sq 7)`, `let` inits, and
  ;; procedure arguments alike, none of which a per-macro lift can reach.
  (if (primitive/code-int? e) `(mk-fixnum ~e)
  ;; `#t` / `#f` read as ordinary symbols. Left alone they are unbound variables
  ;; in test position (`(if #f …)` failed with "unbound variable '#f'"), so they
  ;; lower to the singletons here rather than relying on a binding existing.
  (if (lit--true? e) `(s-true)
  (if (lit--false? e) `(s-false)
  ;; A string literal becomes a heap Scheme string; see `fm--string-lit?`.
  (if (fm--string-lit? e) `(scm-string-literal ~e)
  ;; A reference to a `define`d VARIABLE. `(define x 41)` lowers to a
  ;; zero-argument getter, so the bare `x` Scheme writes must become `(x)`.
  ;; Restricted to names seen defined at this module's top level, so parameters,
  ;; `let` bindings and procedure names are untouched.
  (if (and (primitive/code-sym? e)
           (fm--global? gs 0 (primitive/code-count gs) e))
      `(~e)
  ;; Vector constants are self-evaluating Scheme data, but their elements still
  ;; need ordinary literal lowering. Handle KVec before code-list?: that broad
  ;; predicate intentionally includes vectors and would otherwise rebuild one as
  ;; a call whose "head" is its first element.
  (if (primitive/code-vector? e)
      `(scm-list->vector
         (list ~@(fm--all gs vs e 0 (primitive/code-count e))))
  (if (not (primitive/code-list? e)) e
    (if (primitive/icmp-eq (primitive/code-count e) 0) e
      (let [h (primitive/code-nth e 0)]
        ;; The pass's own output: its arguments are raw host data (an i64 count, a
        ;; string, a quoted datum), NOT Scheme expressions. Descending would lift
        ;; them again and the pass would never converge.
        (if (and (fm--name? h "scm-quasiquote")
                 (primitive/icmp-eq (primitive/code-count e) 2))
            `(scm-quasiquote ~(fm--qq-template gs vs (primitive/code-nth e 1) 1))
        (if (and (fm--name? h "scm-quasiquote-vector")
                 (primitive/icmp-eq (primitive/code-count e) 2))
            (let [wrapped (primitive/code-nth e 1)]
              `(scm-quasiquote-vector
                 (quote ~(fm--qq-template gs vs (primitive/code-nth wrapped 1) 1))))
        (if (fm--lowered? h) e
        ;; `/` is a reserved host arithmetic operator, so unlike `+`/`-` its
        ;; Code-returning definition cannot win name resolution at a Scheme call
        ;; site. Lower it here, before host expansion sees the spelling. Every
        ;; operand must go back through fm--rewrite: using the ordinary macro
        ;; fold here copied later nested operands verbatim, leaving raw integers
        ;; inside `(expt 2 2000)` where tagged Scheme values were required.
        (if (primitive/code-eq h `/)
            (if (primitive/icmp-eq (primitive/code-count e) 1)
                (do (fm--trace-problem "zero-operand /")
                    (primitive/report e
                                      "`/` expects at least one operand") e)
            (if (primitive/icmp-eq (primitive/code-count e) 2)
                `(scm-div (mk-fixnum 1) ~(fm--rewrite gs vs (primitive/code-nth e 1)))
              (fm--arith-fold gs vs `scm-div e 2 (primitive/code-count e)
                              (fm--rewrite gs vs (primitive/code-nth e 1)))))
        ;; DECLARATIONS ARE NOT EXPRESSIONS. `(import "coil.scheme" :use *)` and
        ;; `(module m)` carry a string that names a NAMESPACE, not a Scheme
        ;; string object, so lifting it to `(string-from-slice "coil.scheme")` is
        ;; meaningless — there is no position here that ever evaluates.
        ;;
        ;; ⚠ It is also actively destructive, and the failure is remote from the
        ;; cause. The opt-in marker every pass in this dialect gates on is
        ;; literally the text of that import: `dia--imports-scheme?`,
        ;; `fm--imports-scheme?` and `rt--imports-scheme?` all compare
        ;; `(code-str (code-nth f 1))` against "coil.scheme". Once this pass
        ;; rewrites element 1 into a LIST, that comparison reads the list's text,
        ;; no longer matches, and every LATER pass silently concludes the module
        ;; is not Scheme and skips it.
        ;;
        ;; That is exactly how the rooting pass came to emit nothing at all: it
        ;; runs third, so it never saw an intact import and never framed a single
        ;; function, while both earlier passes — which run BEFORE the damage —
        ;; worked fine. The symptom (no gc-root anywhere) pointed at the rooting
        ;; pass; the cause was here.
        (if (or (primitive/code-eq h `import) (primitive/code-eq h `module)) e
        ;; `((lambda (a b) body) x y)` is R5RS's own definition of `let` — see
        ;; `fm--applied-lambda?`. Rewritten here, before the generic walk, so the
        ;; body and the arguments are then rewritten in their new positions.
        (if (fm--applied-lambda? e)
            ;; The ARGUMENTS are rewritten here and the result is NOT re-walked,
            ;; because re-walking a `scm-let` would descend into its `(name init)`
            ;; binding pairs and read each name as a call head. Body forms are
            ;; rewritten explicitly for the same reason.
            `(scm-let ~(fm--lam-bindings gs vs (primitive/code-nth h 1) e 0
                         (primitive/code-count (primitive/code-nth h 1)))
                      ~@(fm--all gs vs h 2 (primitive/code-count h)))
        (if (and (primitive/code-eq h `quote)
                 (primitive/icmp-ge (primitive/code-count e) 2))
            ; the argument is DATA: hand it over whole, never descend into it
            `(quote-data ~(primitive/code-nth e 1))
          (if (fm--binder? h)
              `(~h ~@(fm--verbatim e 1 (fm--body-start e)
                                    (primitive/code-count e))
                   ~@(fm--all gs vs e (fm--body-start e)
                               (primitive/code-count e)))
            ; Scheme's `if` tests TRUTHINESS; Coil's needs a bool. Every Scheme
            ; value is a nonzero tagged word, so an untouched test makes Coil's
            ; `if` take the true branch ALWAYS — silently, and at the right type,
            ; so nothing complains. `(if (< 1 2) 100 200)` and `(if (< 5 2) …)`
            ; both returned 100 until this.
            ;
            ; R5RS 6.3.1: only #f is false, so `truthy?` is the whole rule. A
            ; one-armed `(if test then)` yields the unspecified value when the
            ; test is false, which is what R5RS specifies.
            ; ⚠ Idempotent by construction: a test that is ALREADY `(truthy? …)`
            ; is left alone. Without that guard the pass wraps its own output
            ; every round — `(truthy? (truthy? …))` — and never converges, which
            ; the compiler reports as "did not reach a fixpoint after 16 rounds".
            ; Every rewrite in a before-expand pass has to be a fixed point of
            ; itself; this is the one that is easy to forget because the wrapper
            ; and the wrapped are both valid code.
            ;; `define` BINDS its first element — it is not a reference. Left to
            ;; the generic walk, the global rewrite turns `(define x 41)` into
            ;; `(define (x) 41)`, which makes `head` a list and sends `define`
            ;; down its PROCEDURE branch: the variable silently became a
            ;; zero-argument function returning its initializer, so `set!` wrote
            ;; an environment entry that nothing ever read and `x` kept its
            ;; initial value forever. Only the init is an expression.
            (if (and (primitive/code-eq h `define)
                     (primitive/icmp-ge (primitive/code-count e) 2))
                `(define ~(primitive/code-nth e 1)
                         ~@(fm--all gs vs e 2 (primitive/code-count e)))
            ;; `(set! x e)` -> `(scm-set! x e)`. Coil reserves `set!` as the
            ;; 3-argument Set trait method, so the Scheme spelling cannot bind to
            ;; it — the name cannot be rebound and the 2-argument form fails with
            ;; "'set!' expects 3 args, got 2". Routing the surface spelling to the
            ;; scm- name here is the same treatment `let` gets in dialect.coil,
            ;; and it is what lets case 01's `(set! x (+ x 1))` run as written.
            (if (and (primitive/code-sym? h)
                     (and (let [hs (primitive/code-str h)]
                            (or (str-eq hs "set!")
                                (or (str-eq hs "coil.core.set!")
                                    (str-eq hs "coil.scheme.dialect.set!"))))
                     (primitive/icmp-eq (primitive/code-count e) 3)))
                `(scm-set! ~(primitive/code-nth e 1)
                           ~(fm--rewrite gs vs (primitive/code-nth e 2)))
            (if (and (primitive/code-eq h `if)
                     (primitive/icmp-lt (primitive/code-count e) 3))
                (do (fm--trace-problem "short if")
                    (primitive/report e
                                      "`if` expects a test and consequent") e)
            (if (and (primitive/code-eq h `if)
                     (not (fm--truthy-call? (primitive/code-nth e 1))))
                (if (primitive/icmp-ge (primitive/code-count e) 4)
                    `(if (truthy? ~(fm--rewrite gs vs (primitive/code-nth e 1)))
                         ~(fm--rewrite gs vs (primitive/code-nth e 2))
                         ~(fm--rewrite gs vs (primitive/code-nth e 3)))
                  `(if (truthy? ~(fm--rewrite gs vs (primitive/code-nth e 1)))
                       ~(fm--rewrite gs vs (primitive/code-nth e 2))
                     (s-unspecified)))
              (if (and (fm--name? h "scm-case")
                       (primitive/icmp-ge (primitive/code-count e) 2))
                  `(~h ~(fm--rewrite gs vs (primitive/code-nth e 1))
                     ~@(fm--case-clauses gs vs e 2 (primitive/code-count e)))
              ;; `scm-let`'s bindings are `(name init)` PAIRS — dialect.coil has
              ;; already rewritten Scheme's `let` by the time this pass runs. The
              ;; generic walk would read each pair as a call with the NAME as its
              ;; head, so an init never got its own rewrites: a variadic call in a
              ;; `let` init was left uncollected and failed with "expects 2 args,
              ;; got 3". Only the init is an expression; the name is a binder.
              (if (and (fm--name? h "scm-let")
                       (primitive/icmp-ge (primitive/code-count e) 2))
                  `(scm-let ~(fm--let-bindings gs vs (primitive/code-nth e 1) 0
                               (primitive/code-count (primitive/code-nth e 1)))
                            ~@(fm--all gs vs e 2 (primitive/code-count e)))
              ;; The other binding forms: their element 1 is a binder list too,
              ;; but its inner shape differs per form (`do` binds a THREE-element
              ;; `(var init step)`, `letrec` a two). Rather than teach this pass
              ;; each shape, copy the binder list VERBATIM and rewrite only the
              ;; body — the owning macro knows its own shape and will rewrite the
              ;; inits itself. Descending here is what emptied them.
              (if (and (fm--name? h "scm-do")
                       (primitive/icmp-ge (primitive/code-count e) 3))
                  `(scm-do ~(fm--do-bindings gs vs (primitive/code-nth e 1) 0
                                              (primitive/code-count (primitive/code-nth e 1)))
                           (~@(fm--all gs vs (primitive/code-nth e 2) 0
                                      (primitive/code-count (primitive/code-nth e 2))))
                           ~@(fm--all gs vs e 3 (primitive/code-count e)))
              (if (and (fm--binder-list-form? h)
                       (primitive/icmp-ge (primitive/code-count e) 2))
                  `(~h ~(primitive/code-nth e 1)
                       ~@(fm--all gs vs e 2 (primitive/code-count e)))
              ; a binding vector is rebuilt as a list by quasiquote, so `let`'s
              ; second element is copied rather than rewritten
              (if (fm--name? h "let")
                  `(~h ~(primitive/code-nth e 1)
                       ~@(fm--all gs vs e 2 (primitive/code-count e)))
                ;; A call to a variadic procedure collects its surplus arguments
                ;; here; every other call just has its arguments rewritten.
                ;;
                ;; ⚠ The HEAD is never rewritten — only the arguments. That is
                ;; what keeps the global rewrite a fixed point: `x` becomes `(x)`,
                ;; and on the next round `(x)`'s head is left alone instead of
                ;; becoming `((x))`, which would never converge. It is also
                ;; correct independently: a head is a procedure name being
                ;; applied, not a variable being read.
                ;; ⚠ EXCEPT A LITERAL HEAD, WHICH IS NEVER A PROCEDURE NAME.
                ;;
                ;; The rule above is right for calls and wrong for the one shape
                ;; that is not a call: a `cond` clause is `(test body …)`, and
                ;; `test` sits in element 0. So `(cond (#f X) …)` puts the literal
                ;; `#f` where this walk expects a callee, the head rule leaves it
                ;; alone, and it reaches codegen as
                ;;
                ;;     error: call to undefined function '#f'
                ;;
                ;; `#t`/`#f`/a char/an integer can never name a procedure, so
                ;; lifting them here cannot capture a real callee. It also stays a
                ;; fixed point, which the head rule exists to protect: `#f` lowers
                ;; to `(s-false)`, whose head is `s-false` — a symbol, not a
                ;; literal — so the next round does not lower it again.
                ;;
                ;; This was hidden for a long time behind an unguarded
                ;; `(code-nth c 0)` in `scm--cond`, which crashed the metaprogram
                ;; before codegen could name the real problem.
                (if (fm--literal-head? h)
                    `(~(lift h) ~@(fm--all gs vs e 1 (primitive/code-count e)))
                (if (fm--standard-comparison? h)
                    `(~(fm--standard-comparison-target h)
                      (list ~@(fm--rest-args gs vs e 1 (primitive/code-count e))))
                  (let [k (fm--variadic-arity vs 0 (primitive/code-count vs) h)]
                    (if (and (primitive/icmp-ge k 0) (not (fm--collected? e k)))
                        (fm--variadic-call gs vs e k)
                      `(~h ~@(fm--all gs vs e 1 (primitive/code-count e)))))))))))))))))))))))))))))))))))))))

;; Walk quasiquote DATA without treating its list structure as calls. Only an
;; unquote at the active nesting level contains a Scheme expression and enters
;; the ordinary forms rewrite.
(defn fm--qq-template [(gs Code) (vs Code) (e Code) (level i64)] (-> Code)
  (if (not (primitive/code-list? e)) e
    (if (primitive/icmp-eq (primitive/code-count e) 0) e
      (let [h (primitive/code-nth e 0)]
        (if (and (primitive/code-eq h `quasiquote)
                 (primitive/icmp-eq (primitive/code-count e) 2))
            `(quasiquote ~(fm--qq-template gs vs (primitive/code-nth e 1)
                                           (primitive/iadd level 1)))
          (if (and (or (primitive/code-eq h `unquote)
                       (primitive/code-eq h `unquote-splicing))
                   (primitive/icmp-eq (primitive/code-count e) 2))
              `(~h ~(if (primitive/icmp-eq level 1)
                        (fm--rewrite gs vs (primitive/code-nth e 1))
                      (fm--qq-template gs vs (primitive/code-nth e 1)
                                       (primitive/isub level 1))))
            `(~@(fm--qq-all gs vs e 0 (primitive/code-count e) level))))))))

(defn fm--qq-all [(gs Code) (vs Code) (e Code) (i i64) (n i64) (level i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
    `(~(fm--qq-template gs vs (primitive/code-nth e i) level)
      ~@(fm--qq-all gs vs e (primitive/iadd i 1) n level))))

; ---- lambda in operator position --------------------------------------------
;; `((lambda (a b) body) 6 7)` -> `(scm-let ((a 6) (b 7)) body)`.
;;
;; This is not an optimization, it is R5RS's own definition: §4.2.2 defines `let`
;; as exactly this application, so rewriting one into the other is semantics-
;; preserving by construction, including left-to-right argument evaluation and
;; the fact that the parameters are fresh bindings.
;;
;; It is also the ONLY form of `lambda` that works here, and the reason is a host
;; constraint. A lambda in VALUE position must become a heap closure whose code is
;; a top-level function — `defn` is a top-level form and the compiler rejects one
;; in expression position — and a lifted function has no access to enclosing
;; locals, so capturing lambdas would need `lam--free` (lambda.coil has it) plus a
;; rewrite of every captured reference into an `env-ref`, plus trampolines that
;; pass an environment (stdproc.coil's `call--n` take a bare code pointer). None
;; of that exists. Applied lambdas need none of it, because the binding happens
;; at the application site where the values are already in scope.
;;
;; So: `((lambda …) …)` works; `(map (lambda (x) …) l)` does NOT — it needs a
;; procedure VALUE, and the honest answer is that it is unimplemented rather than
;; silently miscompiled. `scm-procedure` over a named `define` is the workaround.
;; Rewrite only the INIT of each `(name init)` binding pair, preserving the name.
(defn fm--let-bindings [(gs Code) (vs Code) (bs Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
    (let [b (primitive/code-nth bs i)]
      `((~(primitive/code-nth b 0)
         ~(fm--rewrite gs vs (primitive/code-nth b 1)))
        ~@(fm--let-bindings gs vs bs (primitive/iadd i 1) n)))))

(defn fm--do-bindings [(gs Code) (vs Code) (bs Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
    (let [b (primitive/code-nth bs i)]
      (if (not (and (primitive/code-list? b)
                    (primitive/icmp-ge (primitive/code-count b) 2)))
          (do
            (primitive/report b
              "a `do` binding must be (variable init) or (variable init step)")
            (fm--do-bindings gs vs bs (primitive/iadd i 1) n))
        `((~(primitive/code-nth b 0)
           ~(fm--rewrite gs vs (primitive/code-nth b 1))
           ~@(if (primitive/icmp-ge (primitive/code-count b) 3)
                 `(~(fm--rewrite gs vs (primitive/code-nth b 2))) `()))
          ~@(fm--do-bindings gs vs bs (primitive/iadd i 1) n))))))

;; Pair parameter `i` with argument `i+1` of the application (element 0 is the
;; lambda itself), rewriting each argument as it is placed — the binding pair is
;; not an expression, so the generic walk must never see it.
(defn fm--lam-bindings [(gs Code) (vs Code) (ps Code) (as Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
    `((~(primitive/code-nth ps i)
       ~(fm--rewrite gs vs (primitive/code-nth as (primitive/iadd i 1))))
      ~@(fm--lam-bindings gs vs ps as (primitive/iadd i 1) n))))

; ---- variadic define, by call-site collection -------------------------------
;; `(define (f a . rest) …)` becomes an ordinary fixed-arity `defn` of a+1
;; parameters, where the last one receives a LIST built at each CALL SITE.
;;
;; The collection has to happen at the call site because `defn` has no runtime
;; rest parameter — Coil's `&` exists only for macros, so a procedure cannot
;; inspect its own argument count. The pass therefore records each variadic
;; procedure's FIXED arity while scanning the module's top level, and rewrites
;; `(f 1 2 3)` into `(f 1 (list 2 3))`, which is precisely the value R5RS says
;; `rest` is bound to.
;;
;; The cost of that design is real and worth stating: a variadic procedure is only
;; callable through a DIRECT call the pass can see. Passing `f` as a value and
;; applying it later would deliver the uncollected arguments, so first-class use
;; of a variadic procedure is not supported.

;; Names and fixed arities of the variadic procedures defined at this top level,
;; as a list of `(name arity)` pairs.
(defn fm--dot-pos [(sig Code) (i i64) (n i64)] (-> i64)
  (if (primitive/icmp-ge i n) -1
    (if (primitive/code-eq (primitive/code-nth sig i) `.) i
      (fm--dot-pos sig (primitive/iadd i 1) n))))

(defn fm--variadics-of [(m Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
    (let [f (primitive/code-nth m i)]
      (if (and (primitive/code-list? f)
               (and (primitive/icmp-ge (primitive/code-count f) 3)
                    (and (primitive/code-eq (primitive/code-nth f 0) `define)
                         (primitive/code-list? (primitive/code-nth f 1)))))
          (let [sig (primitive/code-nth f 1)
                d (fm--dot-pos sig 1 (primitive/code-count sig))]
            (if (primitive/icmp-ge d 0)
                ; fixed arity is the number of parameters before the dot
                `((~(primitive/code-nth sig 0) ~(primitive/isub d 1))
                  ~@(fm--variadics-of m (primitive/iadd i 1) n))
              (fm--variadics-of m (primitive/iadd i 1) n)))
        (fm--variadics-of m (primitive/iadd i 1) n)))))

;; The fixed arity recorded for `s`, or -1 if `s` is not a variadic procedure.
(defn fm--variadic-arity [(vs Code) (i i64) (n i64) (s Code)] (-> i64)
  (if (primitive/icmp-ge i n) -1
    (let [p (primitive/code-nth vs i)]
      (if (primitive/code-eq (primitive/code-nth p 0) s)
          (primitive/code-int (primitive/code-nth p 1))
        (fm--variadic-arity vs (primitive/iadd i 1) n s)))))

;; A STRING literal. The reader gives it its own Code kind — not a symbol, not an
;; integer, not a list — which is the only way to recognize one, since there is no
;; `code-str?` predicate (verified by probing all three predicates: a string
;; answers false to every one). It lowers to a heap Scheme string via
;; `string-from-slice`, so `(display "seq")` prints `seq` instead of reaching
;; `scm-display` as a raw pointer.
(defn fm--string-lit? [(e Code)] (-> bool)
  (and (not (primitive/code-sym? e))
       (and (not (primitive/code-int? e))
            (and (not (primitive/code-float? e))
                 (not (primitive/code-list? e))))))

;; A call to a variadic procedure: the first `k` arguments pass through, and every
;; argument after them is collected into a single `list` — the value R5RS binds
;; the rest parameter to. `(f 1 2 3)` with k=1 becomes `(f 1 (list 2 3))`, and
;; `(f 1)` with k=1 becomes `(f 1 (list))`, which is the empty list, not nothing.
(defn fm--rest-args [(gs Code) (vs Code) (e Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
    `(~(fm--rewrite gs vs (primitive/code-nth e i))
      ~@(fm--rest-args gs vs e (primitive/iadd i 1) n))))

;; ⚠ Idempotency, and it is subtle. `(f 1 2 3)` with k=1 becomes `(f 1 (list 2 3))`
;; — which is itself a call to `f` with 2 arguments, so the next round would
;; collect again into `(f 1 (list (list 2 3)))`, and the pass would never
;; converge. The rewrite is already at its fixed point exactly when the call has
;; k+1 arguments AND the last one is a `list` call, which is the shape this rewrite
;; produces and nothing else does.
(defn fm--collected? [(e Code) (k i64)] (-> bool)
  (and (primitive/icmp-eq (primitive/code-count e) (primitive/iadd k 2))
       (let [l (primitive/code-nth e (primitive/iadd k 1))]
         (and (primitive/code-list? l)
              (and (primitive/icmp-ge (primitive/code-count l) 1)
                   (or (primitive/code-eq (primitive/code-nth l 0) `list)
                       (primitive/code-eq (primitive/code-nth l 0) `scm-collected)))))))

;; Marker used by eta-expanded wrappers for top-level variadic procedures. The
;; value is already the rest list; this prevents call-site collection from
;; wrapping it in one additional list.
(defn scm-collected [(v i64)] (-> i64) v)

(defn fm--variadic-call [(gs Code) (vs Code) (e Code) (k i64)] (-> Code)
                    `(~(primitive/code-nth e 0)
    ~@(fm--rest-args gs vs e 1 (primitive/iadd k 1))
    (list ~@(fm--rest-args gs vs e (primitive/iadd k 1)
                           (primitive/code-count e)))))

(defn fm--standard-comparison? [(h Code)] (-> bool)
  (or (primitive/code-eq h `string=?) (or (primitive/code-eq h `string<?)
  (or (primitive/code-eq h `string>?) (or (primitive/code-eq h `string<=?)
  (or (primitive/code-eq h `string>=?) (or (primitive/code-eq h `string-ci=?)
  (or (primitive/code-eq h `string-ci<?) (or (primitive/code-eq h `string-ci>?)
  (or (primitive/code-eq h `string-ci<=?) (or (primitive/code-eq h `string-ci>=?)
  (or (primitive/code-eq h `char=?) (or (primitive/code-eq h `char<?)
  (or (primitive/code-eq h `char>?) (or (primitive/code-eq h `char<=?)
  (or (primitive/code-eq h `char>=?) (or (primitive/code-eq h `char-ci=?)
  (or (primitive/code-eq h `char-ci<?) (or (primitive/code-eq h `char-ci>?)
  (or (primitive/code-eq h `char-ci<=?) (primitive/code-eq h `char-ci>=?)))))))))))))))))))))
(defn fm--standard-comparison-target [(h Code)] (-> Code)
  (cond (primitive/code-eq h `string=?) `scm-string-eq-args
        (primitive/code-eq h `string<?) `scm-string-lt-args
        (primitive/code-eq h `string>?) `scm-string-gt-args
        (primitive/code-eq h `string<=?) `scm-string-le-args
        (primitive/code-eq h `string>=?) `scm-string-ge-args
        (primitive/code-eq h `string-ci=?) `scm-string-ci-eq-args
        (primitive/code-eq h `string-ci<?) `scm-string-ci-lt-args
        (primitive/code-eq h `string-ci>?) `scm-string-ci-gt-args
        (primitive/code-eq h `string-ci<=?) `scm-string-ci-le-args
        (primitive/code-eq h `string-ci>=?) `scm-string-ci-ge-args
        (primitive/code-eq h `char=?) `scm-char-eq-args
        (primitive/code-eq h `char<?) `scm-char-lt-args
        (primitive/code-eq h `char>?) `scm-char-gt-args
        (primitive/code-eq h `char<=?) `scm-char-le-args
        (primitive/code-eq h `char>=?) `scm-char-ge-args
        (primitive/code-eq h `char-ci=?) `scm-char-ci-eq-args
        (primitive/code-eq h `char-ci<?) `scm-char-ci-lt-args
        (primitive/code-eq h `char-ci>?) `scm-char-ci-gt-args
        (primitive/code-eq h `char-ci<=?) `scm-char-ci-le-args
        :else `scm-char-ci-ge-args))

;; Is this form the application of a literal lambda?
(defn fm--applied-lambda? [(e Code)] (-> bool)
  (let [h (primitive/code-nth e 0)]
    (and (primitive/code-list? h)
         (and (primitive/icmp-ge (primitive/code-count h) 3)
              (fm--name? (primitive/code-nth h 0) "lambda")))))

(defn fm--imports-scheme? [(m Code) (i i64) (n i64)] (-> bool)
  (if (primitive/icmp-ge i n) false
    (let [f (primitive/code-nth m i)]
      (if (and (primitive/code-list? f)
               (and (primitive/icmp-ge (primitive/code-count f) 2)
                    (and (primitive/code-eq (primitive/code-nth f 0) `import)
                         (str-eq (primitive/code-str (primitive/code-nth f 1))
                                 "coil.scheme"))))
          true
        (fm--imports-scheme? m (primitive/iadd i 1) n)))))

;; Same opt-in as the dialect: a module is Scheme iff it imports `coil.scheme`,
;; and this dialect's own runtime is ordinary Coil, so it is skipped.
(defn fm--rewritable? [(m Code)] (-> bool)
  (and (primitive/icmp-gt (primitive/code-count m) 1)
       (and (not (starts-with (primitive/code-str (primitive/code-nth m 0))
                              "coil.scheme"))
            (fm--imports-scheme? m 1 (primitive/code-count m)))))

(defn fm--mods [(ms Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n) `()
    (let [m (primitive/code-nth ms i)]
      `(~(if (fm--rewritable? m)
             `(~(primitive/code-nth m 0)
               ~@(fm--top-all (fm--globals-of m 1 (primitive/code-count m))
                              (fm--variadics-of m 1 (primitive/code-count m))
                              m 1 (primitive/code-count m)))
           m)
        ~@(fm--mods ms (primitive/iadd i 1) n)))))

(defn fm--top-all [(gs Code) (vs Code) (m Code) (i i64) (n i64)] (-> Code)
  (if (>= i n) `()
    (let [form (primitive/code-nth m i)
          entered (do
      (primitive/store! (fm--current-index) i)
                    (fm--trace-form "enter" i form))
          rewritten (fm--rewrite gs vs form)
          finished (fm--trace-form "leave" i rewritten)
          rest (fm--top-all gs vs m (+ i 1) n)]
      `(~rewritten ~@rest))))

;; The pass, exported as an ordinary FUNCTION over the bare module list rather
;; than registered as a transform of its own.
;;
;; Two `before-expand` transforms cannot both wrap the program: each is re-run on
;; the other's output until nothing changes, and two passes that each rebuild
;; every module keep re-presenting work to each other until the compiler gives up
;; with "did not reach a fixpoint after 16 rounds". `coil.scheme.dialect` owns the
;; single registration and composes this pass into it, running the `let` rewrite
;; first so this one sees `scm-let` and knows its bindings are `(name init)`
;; pairs.
;;
;; Takes and returns the bare MODULE LIST — not a `do`-wrapped program. Only the
;; outermost caller wraps, which is the shape the transform contract requires.
(defn scheme-forms-mods [(ms Code)] (-> Code)
  (fm--mods ms 0 (primitive/code-count ms)))
