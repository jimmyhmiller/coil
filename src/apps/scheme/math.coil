(module coil.scheme.math)
(import "coil.primitive" :as primitive)

;; Self-contained real elementary functions. Keeping these in Coil avoids a
;; hidden `-lm` requirement on every Scheme executable. Range reduction keeps
;; the short Taylor series in their well-conditioned intervals.
(defn absf [(x f64)] (-> f64)
  (if (primitive/fcmp-lt x 0.0) (primitive/fsub 0.0 x) x))

(defn real-sqrt [(x f64)] (-> f64)
  (if (primitive/fcmp-lt x 0.0) (primitive/fdiv 0.0 0.0)
    (if (primitive/fcmp-eq x 0.0) 0.0
      (let [(mut g) (if (primitive/fcmp-gt x 1.0) x 1.0)]
        (for [i 0 24]
          (store! (mut g)
                  (primitive/fmul 0.5
                    (primitive/fadd (load (mut g))
                                    (primitive/fdiv x (load (mut g)))))))
        (load (mut g))))))

(defn real-exp [(x f64)] (-> f64)
  (let [ln2 0.6931471805599453
        q (primitive/fdiv x ln2)
        k (primitive/cast i64
            (if (primitive/fcmp-lt q 0.0)
                (primitive/fsub q 0.5) (primitive/fadd q 0.5)))
        r (primitive/fsub x (primitive/fmul (primitive/cast f64 k) ln2))
        (mut term) 1.0 (mut sum) 1.0]
    (for [i 1 25]
      (store! (mut term)
              (primitive/fdiv (primitive/fmul (load (mut term)) r)
                              (primitive/cast f64 i)))
      (store! (mut sum) (primitive/fadd (load (mut sum)) (load (mut term)))))
    (let [(mut out) (load (mut sum))]
      (if (> k 0)
          (for [i 0 k] (store! (mut out) (primitive/fmul (load (mut out)) 2.0)))
        (for [i 0 (- 0 k)] (store! (mut out) (primitive/fmul (load (mut out)) 0.5))))
      (load (mut out)))))

(defn real-log [(x f64)] (-> f64)
  (if (primitive/fcmp-le x 0.0) (primitive/fdiv 0.0 0.0)
    (let [(mut m) x (mut k) 0]
      (loop (if (primitive/fcmp-ge (load (mut m)) 2.0)
                (do (set! (mut m) (primitive/fmul (load (mut m)) 0.5))
                    (set! (mut k) (+ (load (mut k)) 1)))
              (break)))
      (loop (if (primitive/fcmp-lt (load (mut m)) 1.0)
                (do (set! (mut m) (primitive/fmul (load (mut m)) 2.0))
                    (set! (mut k) (- (load (mut k)) 1)))
              (break)))
      (let [y (primitive/fdiv (primitive/fsub (load (mut m)) 1.0)
                              (primitive/fadd (load (mut m)) 1.0))
            y2 (primitive/fmul y y)
            (mut term) y (mut sum) y]
        (for [n 1 24]
          (store! (mut term) (primitive/fmul (load (mut term)) y2))
          (store! (mut sum)
                  (primitive/fadd (load (mut sum))
                    (primitive/fdiv (load (mut term))
                                    (primitive/cast f64 (+ (* 2 n) 1))))))
        (primitive/fadd (primitive/fmul 2.0 (load (mut sum)))
                        (primitive/fmul (primitive/cast f64 (load (mut k)))
                                        0.6931471805599453))))))

(defn reduce-angle [(x f64)] (-> f64)
  (let [twopi 6.283185307179586
        k (primitive/cast i64 (primitive/fdiv x twopi))
        (mut r) (primitive/fsub x (primitive/fmul (primitive/cast f64 k) twopi))]
    (if (primitive/fcmp-gt (load (mut r)) 3.141592653589793)
        (set! (mut r) (primitive/fsub (load (mut r)) twopi)) 0)
    (if (primitive/fcmp-lt (load (mut r)) -3.141592653589793)
        (set! (mut r) (primitive/fadd (load (mut r)) twopi)) 0)
    (load (mut r))))

(defn real-sin [(x f64)] (-> f64)
  (let [r (reduce-angle x) r2 (primitive/fmul r r)
        (mut term) r (mut sum) r]
    (for [n 1 13]
      (store! (mut term)
              (primitive/fdiv (primitive/fmul (primitive/fsub 0.0 (load (mut term))) r2)
                              (primitive/cast f64 (* (* 2 n) (+ (* 2 n) 1)))))
      (store! (mut sum) (primitive/fadd (load (mut sum)) (load (mut term)))))
    (load (mut sum))))

(defn real-cos [(x f64)] (-> f64)
  (let [r (reduce-angle x) r2 (primitive/fmul r r)
        (mut term) 1.0 (mut sum) 1.0]
    (for [n 1 13]
      (store! (mut term)
              (primitive/fdiv (primitive/fmul (primitive/fsub 0.0 (load (mut term))) r2)
                              (primitive/cast f64 (* (- (* 2 n) 1) (* 2 n)))))
      (store! (mut sum) (primitive/fadd (load (mut sum)) (load (mut term)))))
    (load (mut sum))))

(defn real-tan [(x f64)] (-> f64) (primitive/fdiv (real-sin x) (real-cos x)))

(defn atan-series [(x f64)] (-> f64)
  (let [x2 (primitive/fmul x x) (mut term) x (mut sum) x]
    (for [n 1 30]
      (store! (mut term) (primitive/fmul (primitive/fsub 0.0 (load (mut term))) x2))
      (store! (mut sum)
              (primitive/fadd (load (mut sum))
                              (primitive/fdiv (load (mut term))
                                              (primitive/cast f64 (+ (* 2 n) 1))))))
    (load (mut sum))))

(defn atan-positive [(x f64)] (-> f64)
  (if (primitive/fcmp-gt x 1.0)
      (primitive/fsub 1.5707963267948966 (atan-positive (primitive/fdiv 1.0 x)))
    (if (primitive/fcmp-gt x 0.4142135623730950)
        (primitive/fadd 0.7853981633974483
          (atan-series (primitive/fdiv (primitive/fsub x 1.0) (primitive/fadd x 1.0))))
      (atan-series x))))
(defn real-atan [(x f64)] (-> f64)
  (if (primitive/fcmp-lt x 0.0) (primitive/fsub 0.0 (atan-positive (primitive/fsub 0.0 x)))
    (atan-positive x)))
(defn real-atan2 [(y f64) (x f64)] (-> f64)
  (if (primitive/fcmp-gt x 0.0) (real-atan (primitive/fdiv y x))
    (if (primitive/fcmp-lt x 0.0)
        (if (primitive/fcmp-ge y 0.0)
            (primitive/fadd (real-atan (primitive/fdiv y x)) 3.141592653589793)
          (primitive/fsub (real-atan (primitive/fdiv y x)) 3.141592653589793))
      (if (primitive/fcmp-gt y 0.0) 1.5707963267948966
        (if (primitive/fcmp-lt y 0.0) -1.5707963267948966 0.0)))))
(defn real-asin [(x f64)] (-> f64)
  (real-atan2 x (real-sqrt (primitive/fsub 1.0 (primitive/fmul x x)))))
(defn real-acos [(x f64)] (-> f64)
  (primitive/fsub 1.5707963267948966 (real-asin x)))
(defn real-pow [(x f64) (y f64)] (-> f64)
  (real-exp (primitive/fmul y (real-log x))))

(export real-sin real-cos real-tan real-asin real-acos real-atan real-atan2
        real-exp real-log real-sqrt real-pow)
