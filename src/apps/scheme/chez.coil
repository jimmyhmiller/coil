(module coil.scheme.chez)

;; Chez host capabilities used by substantial Scheme programs such as Jolt.
;; This module is deliberately separate from the R5RS implementation: it is the
;; one place where Chez's host/runtime surface is mapped onto Coil facilities.
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.args" :as args)
(import "coil.str" :use [str-eq])
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.stdproc"
        :use [string-from-slice make-time make-procedure make-list-procedure fnptr1->i64
              scm-apply-list
              scm-values-args scm-condition-args make-error
              make-message-condition make-who-condition
              make-irritants-condition])
(import "coil.scheme.port" :use [scm-delete-file scm-read])
(import "coil.scheme.symbol" :use [intern symbol-name])
(import "coil.scheme.exception-runtime" :use [exception-raise])

;; Introspection is optional in Jolt's adapter contract. Coil does not expose a
;; fake inspector object: callers receive the documented absent value and use
;; their source-table fallback.
(defn inspect/object [(v i64)] (-> i64) (let [ignored v] (s-false)))
(defn top-level-bound? [(name i64)] (-> i64) (let [ignored name] (s-false)))
(defn top-level-value [(name i64)] (-> i64) (let [ignored name] (s-false)))
(defn interaction-environment [] (-> i64) (s-false))

(defn serious-condition? [(v i64)] (-> i64) (mk-bool (is-exception-condition v)))
(defn bwp-object? [(v i64)] (-> i64) (let [ignored v] (s-false)))

;; Source annotations are metadata, not evaluation semantics. Until Coil's
;; source-object table is exposed as Scheme values, retain the datum and return
;; the port position as the second Chez value.
(defn make-source-file-descriptor [(name i64) (port i64)] (-> i64)
  (cons name (cons port (s-nil))))
(defn source-object-sfd [(source i64)] (-> i64)
  source)
(defn source-object-bfp [(source i64)] (-> i64)
  (let [ignored source] (mk-fixnum 0)))
(defn source-file-descriptor-path [(sfd i64)] (-> i64)
  (if (is-pair sfd) (car sfd) (s-false)))
(defn scm-get-datum-annotations-args [(xs i64)] (-> i64)
  (let [port (if (is-null xs) (s-false) (car xs))]
    (scm-values-args (cons (scm-read port) (cons (mk-fixnum 0) (s-nil))))))

;; A non-generational collector has generation zero. These state accessors use
;; Scheme values so they can be called through ordinary first-class procedures.
(defn chez-winders-cell [] (-> (ptr i64)) (alloc/static i64))
(defn scm-current-winders-args [(xs i64)] (-> i64)
  (let [cell (chez-winders-cell)]
    (if (= (load cell) 0) (store! cell (s-nil)) 0)
    (if (is-null xs) (load cell)
      (do (store! cell (car xs)) (s-unspecified)))))
(defn $tc [] (-> i64) (mk-fixnum 0))
(defn $tc-field [(field-name i64) (tc i64)] (-> i64)
  (let [ignored-name field-name ignored-tc tc] (mk-fixnum 0)))

(defn chez-exit-handler-default [(code i64)] (-> i64) code)
(defn chez-exit-handler-cell [] (-> (ptr i64)) (alloc/static i64))
(defn chez-exit-handler [] (-> i64)
  (let [cell (chez-exit-handler-cell)]
    (if (= (load cell) 0)
        (let [p (make-procedure (fnptr1->i64 (primitive/fnptr-of chez-exit-handler-default)) 1)]
          (gc-root-permanent p)
          (store! cell p))
      0)
    (load cell)))
(defn scm-exit-handler-args [(xs i64)] (-> i64)
  (if (is-null xs) (chez-exit-handler)
    (do (store! (chez-exit-handler-cell) (car xs)) (s-unspecified))))

(defn chez-keyboard-handler-cell [] (-> (ptr i64)) (alloc/static i64))
(defn scm-keyboard-interrupt-handler-args [(xs i64)] (-> i64)
  (if (is-null xs)
      (let [v (load (chez-keyboard-handler-cell))] (if (= v 0) (s-false) v))
    (do (gc-root-permanent (car xs))
        (store! (chez-keyboard-handler-cell) (car xs))
        (s-unspecified))))

(defn chez-option-parameter [(cell (ptr i64)) (xs i64) (fallback i64)] (-> i64)
  (if (= (load cell) 0) (store! cell fallback) 0)
  (if (is-null xs) (load cell)
    (do (store! cell (car xs)) (s-unspecified))))
(defn chez-optimize-cell [] (-> (ptr i64)) (alloc/static i64))
(defn chez-inspector-cell [] (-> (ptr i64)) (alloc/static i64))
(defn chez-source-info-cell [] (-> (ptr i64)) (alloc/static i64))
(defn chez-fasl-compressed-cell [] (-> (ptr i64)) (alloc/static i64))
(defn scm-optimize-level-args [(xs i64)] (-> i64)
  (chez-option-parameter (chez-optimize-cell) xs (mk-fixnum 2)))
(defn scm-inspector-info-args [(xs i64)] (-> i64)
  (chez-option-parameter (chez-inspector-cell) xs (s-true)))
(defn scm-source-info-args [(xs i64)] (-> i64)
  (chez-option-parameter (chez-source-info-cell) xs (s-true)))
(defn scm-fasl-compressed-args [(xs i64)] (-> i64)
  (chez-option-parameter (chez-fasl-compressed-cell) xs (s-false)))

;; These compilation/image hooks are routed through list-procedure entry points
;; because Chez gives several of them optional arguments. The implementations
;; are intentionally explicit capability failures for now; callers documented
;; by Jolt either fall back to source or surface the error. They are kept here so
;; the next step can bind them to the resident compiler without changing Scheme
;; code or introducing a process boundary.
(defn scheme-environment [] (-> i64) (s-false))
(defn suppress-greeting [(enabled i64)] (-> i64)
  (let [ignored enabled] (s-unspecified)))

(defn scm-eval-args [(xs i64)] (-> i64)
  (if (is-null xs) (s-unspecified)
    (let [expr (car xs)]
      ;; Jolt's flattened runtime snapshots Chez kernel bindings before its
      ;; portable replacements are defined. `error` is the one captured value
      ;; that remains referenced (`%chez-error`). Preserve that binding as an
      ;; ordinary first-class Scheme procedure. Other datums retain the existing
      ;; identity fallback until the resident compiler evaluator is connected.
      (if (and (is-symbol expr) (str-eq (symbol-name expr) "error"))
          (make-list-procedure
            (fnptr1->i64 (primitive/fnptr-of scm-error-args)))
        expr))))
(defn scm-error-args [(xs i64)] (-> i64)
  ;; Chez `error` is `(error who message irritant ...)`.  Construct an R6RS
  ;; compound condition and send it through the same `raise` procedure used by
  ;; source Scheme.  In particular, a surrounding `guard` must be able to catch
  ;; host accessor/type failures; aborting here turned recoverable probes into
  ;; process termination and native crashes.
  (let [sp (gc-sp)
        who (if (is-null xs) (s-false) (car xs))
        tail (if (is-null xs) (s-nil) (cdr xs))
        message (if (is-null tail) (string-from-slice "Scheme error") (car tail))
        irritants (if (is-null tail) (s-nil) (cdr tail))]
    (gc-root who) (gc-root message) (gc-root irritants)
    (let [err (make-error)]
      (gc-root err)
      (let [who-c (make-who-condition who)]
        (gc-root who-c)
        (let [message-c (make-message-condition message)]
          (gc-root message-c)
          (let [irritants-c (make-irritants-condition irritants)]
            (gc-root irritants-c)
            (let [components (cons err (cons who-c (cons message-c
                                      (cons irritants-c (s-nil)))))]
              (gc-root components)
              (let [condition (scm-condition-args components)]
                (gc-root condition)
                (gc-sp-set! sp)
                (exception-raise condition)))))))))
(defn compile-file [(source i64) (output i64)] (-> i64)
  (let [ignored-source source ignored-output output] (s-false)))
(defn scm-make-boot-file-args [(xs i64)] (-> i64)
  (let [ignored xs] (s-false)))
(defn scm-fasl-write-args [(xs i64)] (-> i64)
  (let [ignored xs] (s-false)))
(defn scm-fasl-read-args [(xs i64)] (-> i64)
  (let [ignored xs] (s-false)))

(defn scm-delete-file-args [(xs i64)] (-> i64)
  (if (is-null xs) (s-false) (scm-delete-file (car xs))))

;; Conservative compatibility values. Their complete OS-backed versions live
;; in this module rather than being scattered through dialect lowering.
(defn file-modification-time [(path i64)] (-> i64)
  (let [ignored path]
    (make-time (intern "time-utc") (mk-fixnum 0) (mk-fixnum 0))))
(defn file-symbolic-link? [(path i64)] (-> i64) (let [ignored path] (s-false)))
(defn path-parent [(path i64)] (-> i64) (let [ignored path] (s-false)))
(defn system [(command i64)] (-> i64) (let [ignored command] (mk-fixnum -1)))
(defn open-process-ports [(command i64) (buffer-mode i64) (transcoder i64)] (-> i64)
  (let [ignored-command command ignored-buffer buffer-mode ignored-transcoder transcoder]
    (s-false)))
(defn thread-join [(thread i64)] (-> i64) (let [ignored thread] (s-unspecified)))

(defn command-line-loop [(i i64) (n i64)] (-> i64)
  (if (>= i n) (s-nil)
    (cons (string-from-slice (args/args-nth i)) (command-line-loop (+ i 1) n))))
(defn command-line [] (-> i64) (command-line-loop 0 (args/args-count)))

;; Chez boot files install their executable entry with `scheme-start`. In a
;; normal Coil program the surrounding synthesized `main` is already running,
;; so invoke that entry procedure immediately with argv excluding argv[0].
(defn scheme-start [(entry i64)] (-> i64)
  (let [argv (command-line)]
    (scm-apply-list entry (if (is-null argv) argv (cdr argv)))))

(defn make-guardian [] (-> i64) (s-false))
(defn iso-instant-str-nanos [(nanos i64)] (-> i64)
  (let [ignored nanos] (string-from-slice "1970-01-01T00:00:00Z")))
(defn inst-ms [(v i64)] (-> i64) v)
