(module coil.scheme.stdproc-test)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.symbol" :use *)
(import "coil.scheme.core" :use *)
(import "coil.scheme.lambda" :use *)
(import "coil.scheme.closure" :use *)
(import "coil.scheme.stdproc" :use *)

;; The standard procedures, tested on the corners rather than the happy path. Every
;; assertion below is a place a plausible implementation gives a plausible wrong
;; answer — R5RS pins these down and the oracle Schemes agree on all of them.

; ---- helpers ----------------------------------------------------------------
;; Build a Scheme list from Coil, so a test can state its input in one line.
(defn L0 [] (-> i64) (s-nil))
(defn L1 [(a i64)] (-> i64) (cons a (s-nil)))
(defn L2 [(a i64) (b i64)] (-> i64) (cons a (cons b (s-nil))))
(defn L3 [(a i64) (b i64) (c i64)] (-> i64) (cons a (cons b (cons c (s-nil)))))
(defn fx [(n i64)] (-> i64) (mk-fixnum n))
(defn S [(s (slice u8))] (-> i64) (string-from-slice s))
(defn true? [(v i64)] (-> bool) (val-eq? v (s-true)))
(defn false? [(v i64)] (-> bool) (val-eq? v (s-false)))
(defn collect-and-symbol-name [(v i64)] (-> i64)
  (collect)
  (scm-symbol->string v))
(defn raw-zero [] (-> i64) 0)
(defn raw-aligned [] (-> i64) 64)

; ---- storage chains ---------------------------------------------------------
;; The chain is the representation everything else rests on, so it is tested
;; directly: an off-by-one in the two-elements-per-cell packing would corrupt every
;; string and vector silently.
(deftest chain-packs-two-per-cell
  (let [v (make-vector-filled 5 (fx 0))]
    (for [i 0 5] (scm-vector-set! v (fx i) (fx (* i 10))))
    ; both slots of every cell, including the odd tail element that has no partner
    (for [i 0 5] (assert-eq (fixnum-value (scm-vector-ref v (fx i))) (* i 10)))
    (assert-eq (fixnum-value (scm-vector-length v)) 5)))

(deftest empty-aggregates-have-no-storage
  ; a zero-length chain is the null link, and length/ref must not walk into it
  (let [v (make-vector-filled 0 (fx 0))]
    (assert-eq (fixnum-value (scm-vector-length v)) 0)
    (assert (true? (scm-vector? v))))
  (let [s (S "")]
    (assert-eq (fixnum-value (scm-string-length s)) 0)
    (assert (is-null (scm-string->list s)))))

; ---- vectors ----------------------------------------------------------------
(deftest vector-round-trips-through-lists
  (let [v (scm-list->vector (L3 (fx 1) (fx 2) (fx 3)))]
    (assert-eq (fixnum-value (scm-vector-length v)) 3)
    (assert-eq (fixnum-value (scm-vector-ref v (fx 0))) 1)
    (assert-eq (fixnum-value (scm-vector-ref v (fx 2))) 3)
    (let [l (scm-vector->list v)]
      (assert-eq (fixnum-value (scm-length l)) 3)
      (assert-eq (fixnum-value (scm-list-ref l (fx 1))) 2))))

(deftest vector-set-mutates-in-place
  ; vectors are mutable and `vector-set!` must write through, not copy
  (let [v (scm-list->vector (L2 (fx 1) (fx 2)))]
    (scm-vector-set! v (fx 0) (fx 99))
    (assert-eq (fixnum-value (scm-vector-ref v (fx 0))) 99)))

(deftest vector-is-not-a-list-or-a-string
  ; the tags must not collide — a vector and a string share a layout, not a type
  (let [v (scm-list->vector (L1 (fx 1)))]
    (assert (true? (scm-vector? v)))
    (assert (false? (scm-string? v)))
    (assert (false? (scm-list? v)))))

; ---- strings ----------------------------------------------------------------
(deftest string-append-and-substring
  (let [s (scm-string-append (S "abc") (S "de"))]
    (assert-eq (fixnum-value (scm-string-length s)) 5)
    (assert (true? (scm-string=? s (S "abcde"))))
    ; R5RS substring is the half-open range [start, end)
    (assert (true? (scm-string=? (scm-substring s (fx 1) (fx 3)) (S "bc"))))
    ; an empty range is legal and yields ""
    (assert (true? (scm-string=? (scm-substring s (fx 2) (fx 2)) (S ""))))))

(deftest string-comparison-is-lexicographic-not-length-first
  ; "abc" < "b" even though it is longer — comparing lengths first is the classic bug
  (assert (true? (scm-string<? (S "abc") (S "b"))))
  ; a prefix sorts before its extension
  (assert (true? (scm-string<? (S "ab") (S "abc"))))
  (assert (true? (scm-string=? (S "ab") (S "ab"))))
  (assert (false? (scm-string=? (S "ab") (S "abc"))))
  ; case matters: 'A' (65) is below 'a' (97)
  (assert (true? (scm-string<? (S "A") (S "a")))))

(deftest strings-are-equal-by-content-not-identity
  ; two separately built strings are NOT eqv?, but ARE equal? — the single most
  ; important difference between the two predicates
  (let [a (S "hi") b (S "hi")]
    (assert (false? (scm-eq? a b)))
    (assert (false? (scm-eqv? a b)))
    (assert (true? (scm-equal? a b)))))

(deftest string-list-round-trip
  (let [l (scm-string->list (S "ab"))]
    (assert-eq (fixnum-value (scm-length l)) 2)
    ; the elements are CHARACTERS, not fixnums
    (assert (is-char (car l)))
    (assert-eq (char-value (car l)) 97)
    (assert (true? (scm-string=? (scm-list->string l) (S "ab"))))))

(deftest string-symbol-round-trip
  ; interning is what makes this work: both paths must reach the same object, or
  ; (eq? (string->symbol "hi") 'hi) would be false
  (let [s (scm-string->symbol (S "hi"))]
    (assert (is-symbol s))
    (assert (true? (scm-eq? s (intern "hi"))))
    (assert (true? (scm-string=? (scm-symbol->string s) (S "hi"))))))

; ---- characters -------------------------------------------------------------
(deftest char-conversions
  (assert-eq (fixnum-value (scm-char->integer (mk-char 65))) 65)
  (assert-eq (char-value (scm-integer->char (fx 65))) 65)
  (assert-eq (char-value (scm-char-upcase (mk-char 97))) 65)
  (assert-eq (char-value (scm-char-downcase (mk-char 65))) 97))

(deftest char-case-is-identity-when-there-is-no-counterpart
  ; R5RS: char-upcase is the identity on a character with no upper-case form. A
  ; naive (- c 32) would turn '0' into a control character.
  (assert-eq (char-value (scm-char-upcase (mk-char 48))) 48)
  (assert-eq (char-value (scm-char-downcase (mk-char 48))) 48)
  (assert-eq (char-value (scm-char-upcase (mk-char 65))) 65))

(deftest char-ordering
  (assert (true? (scm-char<? (mk-char 97) (mk-char 98))))
  (assert (false? (scm-char<? (mk-char 98) (mk-char 97))))
  (assert (false? (scm-char<? (mk-char 97) (mk-char 97))))
  (assert (true? (scm-char=? (mk-char 97) (mk-char 97))))
  ; a char is not a fixnum, even with the same numeric value
  (assert (false? (scm-eqv? (mk-char 65) (fx 65)))))

; ---- lists ------------------------------------------------------------------
(deftest cxr-family-reads-right-to-left
  ; cadr is the car OF the cdr — getting the direction backwards still typechecks
  (let [l (L3 (fx 1) (fx 2) (fx 3))]
    (assert-eq (fixnum-value (scm-cadr l)) 2)
    (assert-eq (fixnum-value (scm-caddr l)) 3)
    (assert-eq (fixnum-value (car (scm-cddr l))) 3))
  ; caar / cdar reach into the FIRST element
  (let [l (L2 (L2 (fx 1) (fx 2)) (fx 3))]
    (assert-eq (fixnum-value (scm-caar l)) 1)
    (assert-eq (fixnum-value (car (scm-cdar l))) 2)))

(deftest append-shares-the-last-argument
  ; R5RS: append copies all but the last argument, and the result's tail IS the
  ; last argument — not a copy. `eq?` on the tail is the observable consequence.
  (let [tail (L2 (fx 3) (fx 4))
        r (scm-append (L1 (fx 1)) tail)]
    (assert-eq (fixnum-value (scm-length r)) 3)
    (assert (true? (scm-eq? (cdr r) tail))))
  ; appending to nil returns the argument itself
  (let [tail (L1 (fx 1))]
    (assert (true? (scm-eq? (scm-append (L0) tail) tail)))))

(deftest length-reverse-tail-ref
  (let [l (L3 (fx 1) (fx 2) (fx 3))]
    (assert-eq (fixnum-value (scm-length l)) 3)
    (assert-eq (fixnum-value (scm-length (L0))) 0)
    (let [r (scm-reverse l)]
      (assert-eq (fixnum-value (car r)) 3)
      (assert-eq (fixnum-value (scm-list-ref r (fx 2))) 1)
      ; reverse must not mutate its argument
      (assert-eq (fixnum-value (car l)) 1))
    ; list-tail drops k elements; k = 0 is the list itself, k = length is nil
    (assert (true? (scm-eq? (scm-list-tail l (fx 0)) l)))
    (assert (is-null (scm-list-tail l (fx 3))))))

(deftest list-predicate-rejects-improper-and-circular
  ; a proper list ends in nil
  (assert (true? (scm-list? (L2 (fx 1) (fx 2)))))
  (assert (true? (scm-list? (L0))))
  ; (1 . 2) is a pair but NOT a list
  (assert (false? (scm-list? (cons (fx 1) (fx 2)))))
  (assert (false? (scm-list? (fx 1))))
  ; and a circular list must terminate with #f rather than hang
  (let [l (L2 (fx 1) (fx 2))]
    (set-cdr! (cdr l) l)
    (assert (false? (scm-list? l)))))

; ---- equivalence ------------------------------------------------------------
(deftest eqv-is-shallow-equal-is-structural
  ; the defining difference: equal? recurses, eqv? does not
  (let [a (L2 (fx 1) (L1 (fx 2)))
        b (L2 (fx 1) (L1 (fx 2)))]
    (assert (false? (scm-eqv? a b)))
    (assert (true? (scm-equal? a b))))
  ; fixnums and symbols are eqv? by value/interning
  (assert (true? (scm-eqv? (fx 1) (fx 1))))
  (assert (true? (scm-eq? (intern "a") (intern "a"))))
  ; and equal? agrees with eqv? on everything it does not recurse into
  (assert (true? (scm-equal? (fx 1) (fx 1))))
  (assert (false? (scm-equal? (fx 1) (fx 2)))))

(deftest equal-recurses-into-vectors-and-strings
  (let [a (scm-list->vector (L2 (fx 1) (S "x")))
        b (scm-list->vector (L2 (fx 1) (S "x")))]
    (assert (false? (scm-eqv? a b)))
    ; recursion has to reach a string INSIDE a vector, not just compare lengths
    (assert (true? (scm-equal? a b))))
  ; different lengths are not equal, and neither are different contents
  (assert (false? (scm-equal? (scm-list->vector (L1 (fx 1)))
                              (scm-list->vector (L2 (fx 1) (fx 2))))))
  (assert (false? (scm-equal? (scm-list->vector (L1 (fx 1)))
                              (scm-list->vector (L1 (fx 2))))))
  ; a vector and a list with the same elements are NOT equal? — different types
  (assert (false? (scm-equal? (scm-list->vector (L1 (fx 1))) (L1 (fx 1))))))

(deftest searches-return-the-tail-not-a-boolean
  ; R5RS: memq returns the SUBLIST beginning with the match, which is what makes
  ; (cdr (assq k alist)) idiomatic. Returning #t would typecheck and be wrong.
  (let [l (L3 (intern "a") (intern "b") (intern "c"))
        r (scm-memq (intern "b") l)]
    (assert (true? (scm-eq? (car r) (intern "b"))))
    (assert-eq (fixnum-value (scm-length r)) 2))
  ; a miss is #f, not nil
  (assert (false? (scm-memq (intern "z") (L1 (intern "a")))))
  (assert (false? (scm-memq (intern "z") (L0)))))

(deftest memq-and-member-differ-on-strings
  ; the whole reason three variants exist: memq compares with eq?, member with
  ; equal?, so a freshly built string is found by one and not the other
  (let [l (L2 (S "a") (S "b"))]
    (assert (false? (scm-memq (S "b") l)))
    (assert (true? (scm-eq? (car (scm-member (S "b") l)) (scm-cadr l))))))

(deftest assoc-family
  (let [al (L2 (L2 (intern "a") (fx 1)) (L2 (intern "b") (fx 2)))
        hit (scm-assq (intern "b") al)]
    ; the ENTRY is returned, so its cdr is the value
    (assert-eq (fixnum-value (scm-cadr hit)) 2)
    (assert (false? (scm-assq (intern "z") al))))
  ; 05 needs assv specifically, on numeric keys
  (let [al (L2 (L2 (fx 1) (intern "one")) (L2 (fx 2) (intern "two")))]
    (assert (true? (scm-eq? (scm-cadr (scm-assv (fx 2) al)) (intern "two"))))
    (assert (false? (scm-assv (fx 9) al))))
  ; assoc uses equal?, so a string key matches by content where assq would not
  (let [al (L1 (L2 (S "k") (fx 7)))]
    (assert (false? (scm-assq (S "k") al)))
    (assert-eq (fixnum-value (scm-cadr (scm-assoc (S "k") al))) 7)))

; ---- predicates -------------------------------------------------------------
(deftest type-predicates-are-disjoint
  (assert (true? (scm-number? (fx 1))))
  (assert (false? (scm-number? (S "1"))))
  (assert (true? (scm-string? (S "a"))))
  (assert (false? (scm-string? (intern "a"))))
  (assert (true? (scm-symbol? (intern "a"))))
  (assert (false? (scm-symbol? (S "a"))))
  (assert (true? (scm-boolean? (s-true))))
  (assert (true? (scm-boolean? (s-false))))
  ; nil is NOT a boolean, however C-like the intuition
  (assert (false? (scm-boolean? (s-nil))))
  (assert (false? (scm-boolean? (fx 0)))))

(deftest not-follows-the-only-false-rule
  ; R5RS 6.3.1: #f is the ONLY false value, so (not 0) and (not '()) are both #f
  (assert (true? (scm-not (s-false))))
  (assert (false? (scm-not (s-true))))
  (assert (false? (scm-not (fx 0))))
  (assert (false? (scm-not (s-nil)))))

; ---- procedures, map, apply -------------------------------------------------
(defn plus2 [(a i64) (b i64)] (-> i64) (scm-add a b))
(defn inc1 [(a i64)] (-> i64) (scm-add a (mk-fixnum 1)))
(defn closure-add-env [(env i64) (x i64)] (-> i64)
  (mk-fixnum (+ (fixnum-value (env-ref env 0)) (fixnum-value x))))
(defn produce2 [] (-> i64) (scm-values-list (L2 (mk-fixnum 1) (mk-fixnum 2))))
(defn produce1 [] (-> i64) (scm-values-list (L1 (mk-fixnum 7))))

(deftest procedures-are-values
  (let [p (scm-procedure inc1 1)]
    (assert (true? (scm-procedure? p)))
    (assert (false? (scm-procedure? (fx 1))))
    (assert-eq (fixnum-value (call--1 p (fx 41))) 42)))

(deftest closures-dispatch-with-their-captured-environment
  (let [env (L1 (fx 40))
        p (make-closure (closure-fnptr1 closure-add-env) env 1)]
    (assert (is-closure p))
    (assert (= (procedure-arity p) 1))
    (assert (true? (scm-procedure? p)))
    (assert (val-eq? (call--1 p (fx 2)) (fx 42)))))

(deftest map-over-two-lists-stops-at-the-shorter
  (let [p (scm-procedure plus2 2)]
    ; the 09 case: (map + '(1 2 3) '(10 20 30))
    (let [r (scm-map2 p (L3 (fx 1) (fx 2) (fx 3)) (L3 (fx 10) (fx 20) (fx 30)))]
      (assert-eq (fixnum-value (scm-length r)) 3)
      (assert-eq (fixnum-value (car r)) 11)
      (assert-eq (fixnum-value (scm-caddr r)) 33))
    ; R5RS: with lists of different lengths the result is as long as the shortest
    (let [r (scm-map2 p (L3 (fx 1) (fx 2) (fx 3)) (L1 (fx 10)))]
      (assert-eq (fixnum-value (scm-length r)) 1)
      (assert-eq (fixnum-value (car r)) 11))
    (assert (is-null (scm-map2 p (L1 (fx 1)) (L0)))))
  ; map over one list preserves order and length
  (let [r (scm-map1 (scm-procedure inc1 1) (L2 (fx 1) (fx 2)))]
    (assert-eq (fixnum-value (car r)) 2)
    (assert-eq (fixnum-value (scm-cadr r)) 3)))

(deftest for-each-runs-left-to-right
  ; unlike map, R5RS DOES specify for-each's order, so the accumulated result
  ; pins the sequence and not just the set
  (let [p (scm-procedure inc1 1)]
    (assert (val-eq? (scm-for-each1 p (L2 (fx 1) (fx 2))) (s-unspecified)))
    (assert (val-eq? (scm-for-each1 p (L0)) (s-unspecified)))))

(deftest apply-spreads-only-the-last-argument
  (let [p (scm-procedure plus2 2)]
    ; (apply + '(1 2))
    (assert-eq (fixnum-value (scm-apply1 p (L2 (fx 1) (fx 2)))) 3)
    ; (apply + 1 '(2)) — one fixed argument, then the spread list
    (assert-eq (fixnum-value (scm-apply2 p (fx 1) (L1 (fx 2)))) 3))
  ; a wrong-arity application is refused rather than corrupting the stack
  (let [p (scm-procedure plus2 2)]
    (assert (val-eq? (scm-apply1 p (L1 (fx 1))) (s-unspecified)))))

(deftest reducer-folds-any-number-of-arguments
  ;; R5RS `+` is variadic, so it cannot be a fixed-arity value. A reducer folds
  ;; left-to-right over however many arguments arrive, which is what makes
  ;; `(apply + 1 2 '(3 4))` produce 10 rather than an arity error — the exact line
  ;; the 09 case pins down.
  (let [p (scm-reducer plus2 (fx 0))]
    (assert (true? (scm-procedure? p)))
    ; (apply + 1 2 '(3 4)) = 10
    (assert-eq (fixnum-value (scm-apply3 p (fx 1) (fx 2) (L2 (fx 3) (fx 4)))) 10)
    ; (+ 1 2) = 3, and (+ 5) = 5 — one argument is returned unchanged
    (assert-eq (fixnum-value (scm-apply1 p (L2 (fx 1) (fx 2)))) 3)
    (assert-eq (fixnum-value (scm-apply1 p (L1 (fx 5)))) 5)
    ; (+) is the identity, which R5RS fixes at 0
    (assert-eq (fixnum-value (scm-apply1 p (L0))) 0)
    ; and a reducer works wherever a procedure does, including map
    (let [r (scm-map2 p (L2 (fx 1) (fx 2)) (L2 (fx 10) (fx 20)))]
      (assert-eq (fixnum-value (car r)) 11)
      (assert-eq (fixnum-value (scm-cadr r)) 22))))

(deftest values-of-one-is-not-wrapped
  ; (values x) must be indistinguishable from x, so a lone value is NOT packaged
  (assert-eq (fixnum-value (scm-values-list (L1 (fx 7)))) 7)
  (assert (not (values-package? (scm-values-list (L1 (fx 7))))))
  ; several values do get a package, which only call-with-values may unpack
  (assert (values-package? (scm-values-list (L2 (fx 1) (fx 2))))))

(deftest call-with-values-connects-producer-to-consumer
  ; the 09 case: (call-with-values (lambda () (values 1 2)) +)
  (assert-eq (fixnum-value
               (scm-call-with-values (scm-procedure produce2 0) (scm-procedure plus2 2)))
             3)
  ; a producer returning a single value feeds a one-argument consumer
  (assert-eq (fixnum-value
               (scm-call-with-values (scm-procedure produce1 0) (scm-procedure inc1 1)))
             8))

(deftest tail-trampoline-distinguishes-requests-from-raw-aligned-values
  ;; Native helpers can return raw aligned i64 values. Low tag bits alone must
  ;; never make the trampoline dereference one as a request object.
  (assert-eq (call--0 (scm-procedure raw-zero 0)) 0)
  (assert-eq (call--0 (scm-procedure raw-aligned 0)) 64)
  (assert-eq
    (fixnum-value
      (scm-apply-list (scm-procedure plus2 2) (L2 (fx 19) (fx 23))))
    42))

; ---- the collector sees through the new types -------------------------------
;; The representation's whole claim is that mark/sweep reaches vector and string
;; elements through the existing three-slot path. If that is wrong, a collection
;; frees live elements and the contents come back corrupted — so force one and read
;; everything back.
(deftest gc-traces-vector-and-string-contents
  (let [v (scm-list->vector (L3 (fx 11) (fx 22) (fx 33)))
        s (S "abc")
        nested (scm-list->vector (L1 (S "deep")))]
    (gc-root v) (gc-root s) (gc-root nested)
    (collect)
    ; every element must survive, including a string nested inside a vector
    (assert-eq (fixnum-value (scm-vector-ref v (fx 0))) 11)
    (assert-eq (fixnum-value (scm-vector-ref v (fx 2))) 33)
    (assert (true? (scm-string=? s (S "abc"))))
    (assert (true? (scm-string=? (scm-vector-ref nested (fx 0)) (S "deep"))))))

(deftest interned-symbols-survive-after-the-creating-frame-is-gone
  ; The intern table is outside the managed heap. Its cached values therefore need
  ; true permanent roots, not entries on a caller's restorable shadow stack.
  (scm-string->symbol (S "permanent-only"))
  (collect)
  (assert (true? (scm-string=?
                   (scm-symbol->string (scm-string->symbol (S "permanent-only")))
                   (S "permanent-only")))))

(deftest map-keeps-inputs-and-results-live-across-callback-collection
  ; `map` invokes arbitrary Scheme code. That code may collect before map has
  ; advanced its input or attached its computed head to the result list.
  (let [symbols (L3 (intern "alpha") (intern "beta") (intern "gamma"))
        names (scm-map1 (scm-procedure collect-and-symbol-name 1) symbols)]
    (assert (true? (scm-string=? (car names) (S "alpha"))))
    (assert (true? (scm-string=? (scm-caddr names) (S "gamma"))))))
