(module scheme-dialect-test)
;; ⚠ NOT NAMED `coil.scheme.*`. Both dialect passes deliberately SKIP any module
;; whose name starts with `coil.scheme`, because the dialect's own runtime is
;; ordinary Coil and must never be rewritten. A test suite under that prefix is
;; therefore silently excluded from the transform — `(let ((a 1)) …)` fails with
;; "let: expected binding vector" — which would make this file test nothing.
(import "coil.scheme.check" :use *)
(import "coil.scheme" :use *)

;; The dialect end-to-end, through the actual before-expand transform.
;;
;; Every other suite exercises its module as a MACRO surface — it calls `+` or
;; `quote-data` directly, which bypasses the transform entirely. That leaves the
;; whole surface lowering untested: literal lifting at call sites, `define` of a
;; variable, `set!`, applied `lambda` and variadic call-site collection are all
;; rewrites the transform performs, and none of them can be reached by calling a
;; macro by hand. This module imports `coil.scheme`, which is the dialect's opt-in
;; marker, so the code below is rewritten exactly as user code is.
;;
;; ⚠⚠ ASSERTIONS COME FROM `coil.scheme.check`, NOT `coil.assert`, and that is not
;; a style preference. `assert-eq` is SILENTLY NEUTRALIZED inside the dialect: it
;; expands to `(if (= x y) 0 (fail))`, the rewrite turns that `=` into Scheme's
;; `=` (a tagged Val) and wraps the test in `truthy?`, and every Val except `#f`
;; is truthy — so the success branch is taken unconditionally. Found by mutation,
;; not by reading: `(assert-eq (fixnum-value x) 12345)` PASSED. String literals do
;; not survive either (they are lowered to heap Scheme strings), which is why the
;; failure label is an integer id. `check.coil` sits outside the dialect on
;; purpose; see its header.

;; Walk a Scheme list, so list structure can be checked without the printer.
;;
;; ⚠ `pair?` / `null?` (heap.coil, value.coil) return a HOST bool, but the dialect
;; lowers every `if` test through `truthy?`, which takes a Val. The Val-returning
;; spellings are `scm-pair?` / `scm-null?`, and Scheme code must use those. Mixing
;; them is a type error at compile time, not a silent wrong answer.
(define (llen v) (if (scm-pair? v) (+ 1 (llen (cdr v))) 0))

(deftest the-assertion-mechanism-itself-fails-on-a-false-claim
  ;; The guard on the guard. `check` is handed a definitely-false Scheme boolean
  ;; and must NOT abort only because the value is false — it must abort. This
  ;; cannot assert its own failure, so it is verified by mutation: replacing
  ;; `(= 1 2)` with `(= 1 1)` here must make the suite still pass, while any test
  ;; below that is broken must make the suite FAIL. Both were confirmed by hand.
  ;;
  ;; What it CAN assert positively is that `check` passes a true claim through and
  ;; that the two branches are distinguishable at all.
  (check (= 1 1) 1)
  (check-host (val-eq? (= 1 2) (s-false)) 2)
  (check-host (not (val-eq? (= 1 1) (s-false))) 3))

(deftest literals-lift-at-user-call-sites
  ;; The regression this pins: a bare `7` is a raw i64 whose low tag bits read as
  ;; "heap pointer". Before the whole-tree lift, `(sq 7)` passed the raw word and
  ;; `(* 7 7)` shifted it into garbage — the observable symptom was `0`, silently.
  ;; A per-macro lift cannot reach this, because `sq` is a USER procedure and no
  ;; macro in the dialect sees its arguments.
  (check (= (sq 7) 49) 4)
  (check (= (sq 12) 144) 5))
(define (sq n) (* n n))

(deftest literals-lift-in-let-inits
  ;; `let` inits are another position no per-macro lift reaches.
  (check (= (let ((a 1) (b 2)) (+ a b)) 3) 6))

(deftest false-is-usable-as-a-value-and-a-test
  ;; `#f` reads as an ordinary symbol, so before it was lowered to the singleton
  ;; it reached codegen as "unbound variable '#f'".
  (check-host (val-eq? (if #f 1 (s-false)) (s-false)) 7)
  ;; R5RS 6.3.1: ONLY #f is false. 0 and '() are both TRUE, which is the corner
  ;; that separates Scheme from most languages.
  (check (= (if 0 1 2) 1) 8)
  (check (= (if (quote ()) 1 2) 1) 9))

(deftest if-tests-truthiness-not-bit-pattern
  ;; Every Scheme value is a nonzero tagged word, so an unlowered test makes Coil's
  ;; `if` take the true branch ALWAYS — at the right type, so nothing complains.
  ;; Both directions are checked because only the false one can fail.
  (check (= (if (< 1 2) 100 200) 100) 10)
  (check (= (if (< 5 2) 100 200) 200) 11))

; ---- define / set! ----------------------------------------------------------
(define counter 41)

(deftest define-of-a-variable-is-readable-and-settable
  ;; `(define x e)` lowers to a getter over the global environment, and a bare `x`
  ;; is rewritten into that call. An assignment must be visible to every later
  ;; read — that is what makes this a variable and not a constant-returning
  ;; function, which is what an earlier version silently produced.
  (check (= counter 41) 12)
  (set! counter (+ counter 1))
  (check (= counter 42) 13)
  (set! counter 7)
  (check (= counter 7) 14))

(define a-global 1)
(define b-global 2)

(deftest globals-do-not-alias
  ;; Every global must have its OWN storage. Two ways to get this wrong: a shared
  ;; `alloc-static` (one cell per CALL SITE, so a shared helper hands every global
  ;; the same word) and a shared environment key.
  ;;
  ;; ⚠ THE DISTINGUISHING OBSERVATION IS A WRITE TO ONE GLOBAL FOLLOWED BY A READ
  ;; OF THE OTHER, inside a SINGLE deftest. Reading `b-global` and expecting 2
  ;; proves nothing on its own: with a shared key `b-global` finds no entry under
  ;; its own name and falls back to RETURNING ITS OWN INIT — the right answer for
  ;; the wrong reason. And each `deftest` starts from a fresh heap, so splitting
  ;; the write and the read across two tests hides the bug entirely.
  (check (= a-global 1) 15)
  (check (= b-global 2) 16)
  (set! a-global 99)
  (check (= a-global 99) 17)
  ;; the load-bearing line: a write to `a` must not be visible through `b`
  (check (= b-global 2) 18)
  (set! b-global 7)
  (check (= a-global 99) 19)
  (check (= b-global 7) 20))

(define holds-a-list (list 1 2 3))

(deftest a-global-holding-a-list-is-stable-and-survives-collection
  ;; Two properties at once, because both need the same setup.
  ;;
  ;; STABILITY: the init expression is evaluated on every read but STORED only on
  ;; the first, so re-reading must return the SAME object. If it rebuilt the list
  ;; each time, `eq?` would be false and any `set!` would be silently undone.
  ;;
  ;; SURVIVAL: the environment lives in heap.coil's `globals` cell, the permanent
  ;; root `mark-roots` traces. A plain `alloc/static` word is invisible to the
  ;; tracer, so this list would be swept while still reachable from Scheme.
  (check-host (val-eq? holds-a-list holds-a-list) 21)
  (check (= (llen holds-a-list) 3) 22)
  (collect)
  (check (= (llen holds-a-list) 3) 23)
  (check (= (car holds-a-list) 1) 24))

; ---- lambda -----------------------------------------------------------------
(deftest applied-lambda-binds-its-parameters
  ;; R5RS §4.2.2 defines `let` as exactly this application, so the rewrite is
  ;; semantics-preserving by construction. Only APPLIED lambdas work — one in
  ;; value position would need a real closure, which is not implemented.
  (check (= ((lambda (a b) (* a b)) 6 7) 42) 25)
  (check (= ((lambda (n) (+ n 1)) 41) 42) 26))

(deftest applied-lambda-arguments-are-evaluated
  ;; Arguments must be rewritten in their new binding positions, not copied
  ;; verbatim: an early version bound the FIRST parameter to a raw literal while
  ;; lifting the rest, which produced 0 for a product.
  (check (= ((lambda (a b) (+ a b)) (* 2 3) (* 4 5)) 26) 27))

; ---- variadic define --------------------------------------------------------
(define (rest-only . rest) rest)
(define (one-then-rest a . rest) (list a rest))

(deftest variadic-collects-surplus-arguments
  ;; `defn` has no runtime rest parameter, so collection happens at the CALL SITE:
  ;; `(rest-only 1 2 3)` is rewritten to `(rest-only (list 1 2 3))`.
  (check (= (llen (rest-only 1 2 3)) 3) 28)
  (check (= (car (rest-only 1 2 3)) 1) 29))

(deftest variadic-with-no-surplus-gets-the-empty-list
  ;; The boundary: zero rest arguments must bind `rest` to '(), not to nothing and
  ;; not to the unspecified value.
  (check (= (llen (rest-only)) 0) 30)
  (check (scm-null? (rest-only)) 31))

(deftest variadic-keeps-its-fixed-arguments-separate
  ;; `(one-then-rest 1 2 3)` is `(1 (2 3))`. An off-by-one at the fixed/rest
  ;; boundary produces `((1 2 3))` or `(1 2 3)` instead, which is what a mutation
  ;; of the boundary index actually did.
  (check (= (llen (one-then-rest 1 2 3)) 2) 32)
  (check (= (car (one-then-rest 1 2 3)) 1) 33)
  (check (= (llen (car (cdr (one-then-rest 1 2 3)))) 2) 34))

(deftest variadic-call-inside-a-let-init-is-also-collected
  ;; A `let` init is rewritten through a different path than an ordinary argument
  ;; — `scm-let`'s bindings are `(name init)` PAIRS, and the generic walk read the
  ;; name as a call head, so the init never got its own rewrites. The symptom was
  ;; a compile error: "expects 2 args, got 3".
  (check (= (let ((r (one-then-rest 1 2 3))) (llen r)) 2) 35))

; ---- quote and strings ------------------------------------------------------
(deftest quote-materializes-interned-data
  (check (= (llen (quote (a b c))) 3) 36)
  ;; Interning is what makes this true: both sites emit the same symbol object.
  (check-host (val-eq? (quote a) (quote a)) 37)
  (check-host (not (val-eq? (quote a) (quote b))) 38))

(deftest string-literals-become-scheme-strings
  ;; A string literal has its own Code kind — not a symbol, not an integer, not a
  ;; list — and lowers to a heap string. Unlowered it reached the printer as a raw
  ;; pointer.
  (check (scm-string? "seq") 39)
  (check (= (scm-string-length "seq") 3) 40))
