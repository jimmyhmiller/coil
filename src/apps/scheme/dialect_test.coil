(module scheme-dialect-test)
;; ⚠ NOT NAMED `coil.scheme.*`. Both dialect passes deliberately SKIP any module
;; whose name starts with `coil.scheme`, because the dialect's own runtime is
;; ordinary Coil and must never be rewritten. A test suite under that prefix is
;; therefore silently excluded from the transform — `(let ((a 1)) …)` fails with
;; "let: expected binding vector" — which would make this file test nothing.
(import "coil.assert" :use *)
(import "coil.scheme" :use *)

;; The dialect end-to-end, through the actual before-expand transform.
;;
;; Every other suite exercises its module as a MACRO surface — it calls `+` or
;; `quote-data` directly, which bypasses the transform entirely. That leaves the
;; whole surface lowering untested: literal lifting at call sites, `define` of a
;; variable, `set!`, applied `lambda` and variadic call-site collection are all
;; rewrites the transform performs, and none of them can be reached by calling a
;; macro by hand. This module imports `coil.scheme`, which is the dialect's opt-in
;; marker, so the code below is rewritten exactly as user code is.
;;
;; ⚠ THE ASSERTIONS COMPARE `fixnum-value`, NOT THE RAW WORD. A Scheme value is a
;; tagged word, so `(assert-eq (+ 1 2) 3)` would compare a tagged 3 against a raw
;; 3 and fail even when everything is correct.

;; Walk a Scheme list, so list structure can be asserted without depending on the
;; printer.
;; ⚠ `pair?` and `null?` (heap.coil/value.coil) return a HOST bool, but the
;; dialect lowers every `if` test through `truthy?`, which takes a Val. The
;; Val-returning spellings are `scm-pair?` / `scm-null?`, and they are what Scheme
;; code must use. Mixing the two is a type error, not a silent wrong answer.
(define (llen v) (if (scm-pair? v) (+ 1 (llen (cdr v))) 0))

(deftest literals-lift-at-user-call-sites
  ;; The regression this pins: a bare `7` is a raw i64 whose low tag bits read as
  ;; "heap pointer". Before the whole-tree lift, `(sq 7)` passed the raw word and
  ;; `(* 7 7)` shifted it into garbage — the observable symptom was `0`, silently.
  ;; A per-macro lift cannot fix this, because `sq` is a USER procedure and no
  ;; macro in the dialect sees its argument.
  (assert-eq (fixnum-value (sq 7)) 49)
  (assert-eq (fixnum-value (sq 12)) 144))
(define (sq n) (* n n))

(deftest literals-lift-in-let-inits
  ;; `let` inits are another position no per-macro lift reaches.
  (assert-eq (fixnum-value (let ((a 1) (b 2)) (+ a b))) 3))

(deftest false-is-usable-as-a-value-and-a-test
  ;; `#f` reads as an ordinary symbol, so before it was lowered to the singleton
  ;; it reached codegen as `unbound variable '#f'`.
  (assert (val-eq? (if #f 1 (s-false)) (s-false)))
  ;; R5RS 6.3.1: only #f is false. 0 and '() are both TRUE.
  (assert-eq (fixnum-value (if 0 1 2)) 1)
  (assert-eq (fixnum-value (if (quote ()) 1 2)) 1))

(deftest if-tests-truthiness-not-bit-pattern
  ;; Every Scheme value is a nonzero tagged word, so an unlowered test makes
  ;; Coil's `if` take the true branch ALWAYS — at the right type, so nothing
  ;; complains. Both directions are asserted because only the false one fails.
  (assert-eq (fixnum-value (if (< 1 2) 100 200)) 100)
  (assert-eq (fixnum-value (if (< 5 2) 100 200)) 200))

; ---- define / set! ----------------------------------------------------------
(define counter 41)

(deftest define-of-a-variable-is-readable-and-settable
  ;; `(define x e)` lowers to a getter over the global environment; a bare `x` is
  ;; rewritten into the call. Assigning must be visible to every later read, which
  ;; is what makes this a variable rather than a constant-returning function.
  (assert-eq (fixnum-value counter) 41)
  (set! counter (+ counter 1))
  (assert-eq (fixnum-value counter) 42)
  (set! counter 7)
  (assert-eq (fixnum-value counter) 7)
  (set! counter 41))

(define a-global 1)
(define b-global 2)

(deftest globals-do-not-alias
  ;; The hazard this guards: `alloc-static` allocates ONE cell per CALL SITE, so
  ;; an implementation that allocated global storage inside a single shared helper
  ;; would give every global the same word. Two globals with different values, and
  ;; a `set!` to one, would then be indistinguishable.
  (assert-eq (fixnum-value a-global) 1)
  (assert-eq (fixnum-value b-global) 2)
  (set! a-global 99)
  (assert-eq (fixnum-value a-global) 99)
  (assert-eq (fixnum-value b-global) 2)
  (set! a-global 1))

(define holds-a-list (list 1 2 3))

(deftest a-global-is-initialized-once-not-per-read
  ;; The init expression is evaluated on every read but STORED only on the first,
  ;; so re-reading must return the SAME object. If it rebuilt the list each time,
  ;; `eq?` would be false and any `set!` would be silently undone.
  (assert (val-eq? holds-a-list holds-a-list))
  (assert-eq (llen holds-a-list) 3))

(deftest a-global-survives-collection
  ;; The environment lives in heap.coil's `globals` cell, the permanent root the
  ;; collector traces. A plain `alloc/static` word would be invisible to the
  ;; tracer, so this list would be swept while still reachable from Scheme.
  (assert-eq (llen holds-a-list) 3)
  (collect)
  (assert-eq (llen holds-a-list) 3)
  (assert-eq (fixnum-value (car holds-a-list)) 1))

; ---- lambda -----------------------------------------------------------------
(deftest applied-lambda-binds-its-parameters
  ;; R5RS §4.2.2 defines `let` as exactly this application, so the rewrite is
  ;; semantics-preserving. Only APPLIED lambdas work — a lambda in value position
  ;; would need a real closure, which is not implemented.
  (assert-eq (fixnum-value ((lambda (a b) (* a b)) 6 7)) 42)
  (assert-eq (fixnum-value ((lambda (n) (+ n 1)) 41)) 42))

(deftest applied-lambda-arguments-are-evaluated
  ;; Arguments must be rewritten in their new binding positions, not copied
  ;; verbatim: an early version bound the first parameter to a RAW literal while
  ;; the rest were lifted, which printed 0 for a product.
  (assert-eq (fixnum-value ((lambda (a b) (+ a b)) (* 2 3) (* 4 5))) 26))

; ---- variadic define --------------------------------------------------------
(define (rest-only . rest) rest)
(define (one-then-rest a . rest) (list a rest))

(deftest variadic-collects-surplus-arguments
  ;; `defn` has no runtime rest parameter, so the collection happens at the CALL
  ;; SITE: `(rest-only 1 2 3)` is rewritten to `(rest-only (list 1 2 3))`.
  (assert-eq (llen (rest-only 1 2 3)) 3)
  (assert-eq (fixnum-value (car (rest-only 1 2 3))) 1))

(deftest variadic-with-no-surplus-gets-the-empty-list
  ;; The boundary case: zero rest arguments must bind `rest` to '(), not to
  ;; nothing and not to the unspecified value.
  (assert-eq (llen (rest-only)) 0)
  (assert (scm-null? (rest-only))))

(deftest variadic-keeps-its-fixed-arguments-separate
  ;; `(one-then-rest 1 2 3)` is `(1 (2 3))` — an off-by-one in the fixed/rest
  ;; boundary would produce `((1 2 3))` or `(1 2 3)` instead.
  (let ((r (one-then-rest 1 2 3)))
    (assert-eq (llen r) 2)
    (assert-eq (fixnum-value (car r)) 1)
    (assert-eq (llen (car (cdr r))) 2)))

; ---- quote and strings ------------------------------------------------------
(deftest quote-materializes-interned-data
  (assert-eq (llen (quote (a b c))) 3)
  ;; Interning is what makes this true: both sites emit the same symbol object.
  (assert (val-eq? (quote a) (quote a)))
  (assert (not (val-eq? (quote a) (quote b)))))

(deftest string-literals-become-scheme-strings
  ;; A string literal has its own Code kind — not a symbol, not an integer, not a
  ;; list — and lowers to a heap string. Unlowered it reached the printer as a raw
  ;; pointer.
  (assert (scm-string? "seq"))
  (assert-eq (fixnum-value (scm-string-length "seq")) 3))
