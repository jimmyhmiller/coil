(module coil.scheme.port)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.io" :as io)
(import "coil.os" :as os)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :as reader)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.symbol" :use *)
(import "coil.scheme.core" :use *)
(import "coil.scheme.stdproc" :as stdproc)
(import "coil.scheme.numeric" :as numeric)
(import "coil.scheme.ffi" :as ffi)
(extern opendir :cc c [(ptr i8)] (-> (ptr i8)))
(extern readdir :cc c [(ptr i8)] (-> (ptr i8)))
(extern closedir :cc c [(ptr i8)] (-> i32))
(extern c.mkdir :cc c [(ptr i8) i32] (-> i32))
(extern rename :cc c [(ptr i8) (ptr i8)] (-> i32))
(extern unlink :cc c [(ptr i8)] (-> i32))
(extern rmdir :cc c [(ptr i8)] (-> i32))
(extern lseek :cc c [i32 i64 i32] (-> i64))
(extern strlen :cc c [(ptr i8)] (-> i64))
(extern realloc :cc c [(ptr u8) i64] (-> (ptr u8)))
(extern memcpy :cc c [(ptr i8) (ptr i8) i64] (-> (ptr i8)))

(defn get-process-id [] (-> i64) (mk-fixnum (primitive/cast i64 (os/getpid))))
(defn current-directory [] (-> i64)
  (let [a (alloc/malloc-allocator)]
    (match (os/current-dir a)
      (Err [_] (s-false))
      (Ok [owned]
        (let [(mut value) owned
              out (stdproc/string-from-slice (os/owned-string-slice value))]
          (os/owned-string-free a (mut value))
          out)))))
(defn console-error-port [] (-> i64) (current-error-port))
(defn native-transcoder [] (-> i64) (s-false))
(defn make-transcoder [(codec i64)] (-> i64)
  ;; Ports are UTF-8 internally; retain the codec token as the transcoder value
  ;; so callers can pass it through `transcoded-port` without hidden state.
  codec)

;; R5RS input ports over Coil's existing Reader/file-descriptor layer.
;;
;; A port is a traced Scheme Obj:
;;   a = tagged fd
;;   b = tagged flags (1=input, 2=output, 4=open)
;;   c = one-character lookahead, `undefined` when empty, `eof` at EOF
;; All payload words are valid Vals, so the collector can trace the generic Obj
;; without knowing that the fixnums encode operating-system state.
(defn port-input-flag [] (-> i64) 1)
(defn port-output-flag [] (-> i64) 2)
(defn port-open-flag [] (-> i64) 4)
(defn port-memory-string-flag [] (-> i64) 8)
(defn port-memory-binary-flag [] (-> i64) 16)
(defn port-custom-flag [] (-> i64) 32)
(defn port-object? [(p i64)] (-> bool)
  (or (has-tag? p (tag-port))
      (or (has-tag? p (tag-memory-port)) (has-tag? p (tag-custom-port)))))

(defn port-flags [(p i64)] (-> i64)
  (fixnum-value (primitive/load (primitive/field (obj-of p) b))))
(defn port-fd [(p i64)] (-> i64)
  (fixnum-value (primitive/load (primitive/field (obj-of p) a))))
(defn port-open? [(p i64)] (-> bool)
  (and (port-object? p) (!= (primitive/iand (port-flags p) (port-open-flag)) 0)))
(defn port-input-kind? [(p i64)] (-> bool)
  (and (port-object? p)
       (!= (primitive/iand (port-flags p) (port-input-flag)) 0)))
(defn port-output-kind? [(p i64)] (-> bool)
  (and (port-object? p)
       (!= (primitive/iand (port-flags p) (port-output-flag)) 0)))
(defn port-input? [(p i64)] (-> bool)
  (and (port-open? p) (port-input-kind? p)))
(defn port-output? [(p i64)] (-> bool)
  (and (port-open? p) (port-output-kind? p)))

(defn make-input-port [(fd i64)] (-> i64)
  (allocate (tag-port)
            (mk-fixnum fd)
            (mk-fixnum (primitive/ior (port-input-flag) (port-open-flag)))
            (s-undefined)))
(defn make-output-port [(fd i64)] (-> i64)
  (allocate (tag-port)
            (mk-fixnum fd)
            (mk-fixnum (primitive/ior (port-output-flag) (port-open-flag)))
            (s-undefined)))

(defn make-memory-port [(payload i64) (flags i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root payload)
    (let [state (stdproc/make-vector-filled 3 (s-undefined))]
      (gc-root state)
      (stdproc/scm-vector-set! state (mk-fixnum 0) payload)
      (stdproc/scm-vector-set! state (mk-fixnum 1) (mk-fixnum 0))
      (let [p (allocate (tag-memory-port) state
                (mk-fixnum (primitive/ior flags (port-open-flag)))
                (s-undefined))]
        (gc-sp-set! sp)
        (gc-root p)
        p))))
(defn memory-port-state [(p i64)] (-> i64)
  (primitive/load (primitive/field (obj-of p) a)))
(defn memory-port-payload [(p i64)] (-> i64)
  (stdproc/scm-vector-ref (memory-port-state p) (mk-fixnum 0)))
(defn memory-port-position [(p i64)] (-> i64)
  (fixnum-value (stdproc/scm-vector-ref (memory-port-state p) (mk-fixnum 1))))
(defn memory-port-position-set! [(p i64) (n i64)] (-> i64)
  (stdproc/scm-vector-set! (memory-port-state p) (mk-fixnum 1) (mk-fixnum n)))
(defn port-held [(p i64)] (-> i64)
  (if (or (has-tag? p (tag-memory-port)) (has-tag? p (tag-custom-port)))
      (stdproc/scm-vector-ref (memory-port-state p) (mk-fixnum 2))
    (primitive/load (primitive/field (obj-of p) c))))
(defn port-held-set! [(p i64) (v i64)] (-> i64)
  (if (or (has-tag? p (tag-memory-port)) (has-tag? p (tag-custom-port)))
      (stdproc/scm-vector-set! (memory-port-state p) (mk-fixnum 2) v)
    (do (primitive/store! (primitive/field (obj-of p) c) v) (s-unspecified))))

(defn make-custom-port [(id i64) (callback i64) (get-position i64)
                        (set-position i64) (close-proc i64) (direction i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root id) (gc-root callback) (gc-root get-position)
    (gc-root set-position) (gc-root close-proc)
    (let [state (stdproc/make-vector-filled 6 (s-false))]
      (gc-root state)
      (stdproc/scm-vector-set! state (mk-fixnum 0) id)
      (stdproc/scm-vector-set! state (mk-fixnum 1) callback)
      (stdproc/scm-vector-set! state (mk-fixnum 2) (s-undefined))
      (stdproc/scm-vector-set! state (mk-fixnum 3) get-position)
      (stdproc/scm-vector-set! state (mk-fixnum 4) set-position)
      (stdproc/scm-vector-set! state (mk-fixnum 5) close-proc)
      (let [p (allocate (tag-custom-port) state
                (mk-fixnum (primitive/ior direction
                  (primitive/ior (port-open-flag)
                    (primitive/ior (port-memory-binary-flag) (port-custom-flag)))))
                (s-undefined))]
        (gc-sp-set! sp)
        (gc-root p)
        p))))
(defn make-custom-binary-input-port [(id i64) (read-proc i64) (get-position i64)
                                     (set-position i64) (close-proc i64)] (-> i64)
  (make-custom-port id read-proc get-position set-position close-proc (port-input-flag)))
(defn make-custom-binary-output-port [(id i64) (write-proc i64) (get-position i64)
                                      (set-position i64) (close-proc i64)] (-> i64)
  (make-custom-port id write-proc get-position set-position close-proc (port-output-flag)))
(defn open-input-string [(s i64)] (-> i64)
  (make-memory-port s (primitive/ior (port-input-flag) (port-memory-string-flag))))
(defn open-output-string [] (-> i64)
  (let [sp (gc-sp)
        bv (ffi/make-bytevector-raw 256 0)]
    (gc-root bv)
    (let [p (make-memory-port bv
              (primitive/ior (port-output-flag) (port-memory-string-flag)))]
      (gc-sp-set! sp)
      (gc-root p)
      p)))
(defn open-bytevector-input-port [(bv i64)] (-> i64)
  (make-memory-port bv (primitive/ior (port-input-flag) (port-memory-binary-flag))))
(defn open-bytevector-output-port [] (-> i64)
  (let [sp (gc-sp)
        bv (ffi/make-bytevector-raw 256 0)]
    (gc-root bv)
    (let [p (make-memory-port bv
              (primitive/ior (port-output-flag) (port-memory-binary-flag)))]
      (gc-sp-set! sp)
      (gc-root p)
      p)))

(defn port-fail [(msg (ptr i8))] (-> i64)
  (oom-puts c"coil.scheme: ")
  (oom-puts msg)
  (oom-puts c"\n")
  (abort)
  (s-unspecified))

;; The global environment is already a permanent GC root. Using it for the
;; ambient port makes repeated `(current-input-port)` calls share lookahead and
;; close state, rather than allocating a fresh wrapper around fd 0 each time.
(defn current-input-port [] (-> i64)
  (scm--global-read (intern "#%current-input-port") (make-input-port 0)))
(defn current-output-port [] (-> i64)
  (scm--global-read (intern "#%current-output-port") (make-output-port 1)))
(defn current-error-port [] (-> i64)
  (scm--global-read (intern "#%current-error-port") (make-output-port 2)))

(defn port-set-current-input! [(p i64)] (-> i64)
  (scm--global-write (intern "#%current-input-port") p))
(defn port-set-current-output! [(p i64)] (-> i64)
  (scm--global-write (intern "#%current-output-port") p))

(defn transcript-port [] (-> i64)
  (scm--global-read (intern "#%transcript-port") (s-false)))
(defn transcript-active? [] (-> bool)
  (port-output? (transcript-port)))
(defn transcript-on [(path i64)] (-> i64)
  (if (transcript-active?) (close-output-port (transcript-port)) (s-unspecified))
  (scm--global-write (intern "#%transcript-port") (open-output-file path))
  (s-unspecified))
(defn transcript-off [] (-> i64)
  (if (transcript-active?)
      (do (close-output-port (transcript-port))
          (scm--global-write (intern "#%transcript-port") (s-false))
          (s-unspecified))
    (s-unspecified)))

(defn input-port? [(p i64)] (-> i64) (mk-bool (port-input-kind? p)))
(defn output-port? [(p i64)] (-> i64)
  (mk-bool (port-output-kind? p)))
(defn eof-object? [(v i64)] (-> i64) (mk-bool (val-eq? v (s-eof))))

(defn port-nonblocking-flag [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) `2048 `4))
(defn port-would-block-errno [(which Code)] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) `11 `35))
(defn port-would-block [(errno i64)] (-> bool)
  (= errno (port-would-block-errno h)))

;; R5RS `char-ready?` must never block. Preserve the descriptor's flags, perform
;; one nonblocking byte read, and retain a successful byte in the port's normal
;; lookahead cell so this observation does not consume input.
(defn scm-char-ready? [(p i64)] (-> i64)
  (if (not (port-input? p)) (port-fail c"char-ready?: expected an open input port")
    (let [held (port-held p)]
      (if (not (undefined? held)) (s-true)
        (if (has-tag? p (tag-memory-port))
            (mk-bool (< (memory-port-position p)
                        (if (!= (primitive/iand (port-flags p) (port-memory-string-flag)) 0)
                            (stdproc/string-length-raw (memory-port-payload p))
                          (fixnum-value (ffi/bytevector-length (memory-port-payload p))))))
        (let [fd (primitive/cast i32 (port-fd p))
              old (os/fcntl fd 3 0)]
          (if (< old 0) (port-fail c"char-ready?: fcntl failed")
            (do
              (if (< (os/fcntl fd 4 (primitive/ior (primitive/cast i64 old)
                                                   (port-nonblocking-flag))) 0)
                  (port-fail c"char-ready?: cannot enable nonblocking input") 0)
              (let [r (alloc/stack io/Reader)
                    byte (alloc/stack i8)
                    result
                      (match (io/read-some (io/fd-reader r (port-fd p)) byte 1)
                        (Ok [n]
                          (do
                            (port-held-set! p
                              (if (= n 0) (s-eof)
                                (mk-char (primitive/cast i64 (primitive/load byte)))))
                            (s-true)))
                        (Err [e]
                          (match e
                            (io/Errno [code]
                              (if (port-would-block code) (s-false)
                                (port-fail c"char-ready?: input error")))
                            (_ (port-fail c"char-ready?: input error")))))]
                (if (< (os/fcntl fd 4 old) 0)
                    (port-fail c"char-ready?: cannot restore descriptor flags") 0)
                result)))))))))

(defn port-path-cstr [(a (ptr Allocator)) (path i64)] (-> (ptr i8))
  (let [n (stdproc/string-length-raw path)
        out (unwrap-ptr [i8] (raw-alloc a (+ n 1) 1))]
    (for [i 0 n]
      (primitive/store! (primitive/index out i)
                        (primitive/cast i8 (stdproc/string-code path i))))
    (primitive/store! (primitive/index out n) (primitive/cast i8 0))
    out))

(defn open-input-file [(path i64)] (-> i64)
  (let [a (malloc-allocator)
        n (stdproc/string-length-raw path)
        cp (port-path-cstr a path)]
    (if (= (primitive/cast i64 cp) 0)
        (port-fail c"open-input-file: out of memory")
      (let [fd (primitive/cast i64 (os/open cp (primitive/cast i32 0) 0))]
        (raw-free a (primitive/cast (ptr i8) cp) (+ n 1) 1)
        (if (< fd 0)
            (port-fail c"open-input-file: cannot open file")
          (make-input-port fd))))))

;; Chez exposes the R6RS filesystem predicate in `(chezscheme)`.  Jolt's boot
;; checks its vendored sources before loading anything else, so this is part of
;; the compatibility floor rather than an optional file API.  `access(F_OK)`
;; also handles directories, unlike probing with `open-input-file`.
(defn file-exists? [(path i64)] (-> i64)
  (let [a (malloc-allocator)
        n (stdproc/string-length-raw path)
        cp (port-path-cstr a path)]
    (if (= (primitive/cast i64 cp) 0)
        (mk-bool false)
      (let [exists (= (os/access cp 0) 0)]
        (raw-free a (primitive/cast (ptr i8) cp) (+ n 1) 1)
        (mk-bool exists)))))

(defn exit [(status i64)] (-> i64)
  (os/_exit (primitive/cast i32 (fixnum-value status)))
  (s-unspecified))

;; O_WRONLY | O_CREAT | O_TRUNC. The latter two differ between Linux and Darwin.
(defn port-output-open-flags [] (-> Code)
  (if (primitive/code-eq (primitive/target-os) `linux) `577 `1537))

(defn open-output-file [(path i64)] (-> i64)
  (let [a (malloc-allocator)
        n (stdproc/string-length-raw path)
        cp (port-path-cstr a path)]
    (if (= (primitive/cast i64 cp) 0)
        (port-fail c"open-output-file: out of memory")
      (let [fd (primitive/cast i64
                 (os/open cp (primitive/cast i32 (port-output-open-flags)) 420))]
        (raw-free a (primitive/cast (ptr i8) cp) (+ n 1) 1)
        (if (< fd 0)
            (port-fail c"open-output-file: cannot open file")
          (make-output-port fd))))))

(defn close-input-port [(p i64)] (-> i64)
  (if (not (port-input-kind? p)) (port-fail c"close-input-port: expected an input port")
    (if (not (port-open? p)) (s-unspecified)
    (do
      (if (has-tag? p (tag-custom-port))
          (let [closer (stdproc/scm-vector-ref (memory-port-state p) (mk-fixnum 5))]
            (if (is-procedure closer) (do (stdproc/call--0 closer) 0) 0))
        (if (has-tag? p (tag-memory-port)) 0
        (if (< (os/close (primitive/cast i32 (port-fd p))) (primitive/cast i32 0))
            (port-fail c"close-input-port: close failed")
          0)))
      (primitive/store! (primitive/field (obj-of p) b)
                        (mk-fixnum (primitive/iand (port-flags p)
                                                   (primitive/inot (port-open-flag)))))
      (s-unspecified)))))

(defn close-output-port [(p i64)] (-> i64)
  (if (not (port-output-kind? p)) (port-fail c"close-output-port: expected an output port")
    (if (not (port-open? p)) (s-unspecified)
    (do
      (if (has-tag? p (tag-custom-port))
          (let [closer (stdproc/scm-vector-ref (memory-port-state p) (mk-fixnum 5))]
            (if (is-procedure closer) (do (stdproc/call--0 closer) 0) 0))
        (if (has-tag? p (tag-memory-port)) 0
        (if (< (os/close (primitive/cast i32 (port-fd p))) (primitive/cast i32 0))
            (port-fail c"close-output-port: close failed")
          0)))
      (primitive/store! (primitive/field (obj-of p) b)
                        (mk-fixnum (primitive/iand (port-flags p)
                                                   (primitive/inot (port-open-flag)))))
      (s-unspecified)))))
(defn port? [(p i64)] (-> i64) (mk-bool (port-object? p)))
(defn close-port [(p i64)] (-> i64)
  (if (port-input-kind? p) (close-input-port p) (close-output-port p)))
;; Port writes are issued directly to their file descriptor; there is no Scheme
;; buffering layer to drain. The compatibility operation is therefore complete
;; once all preceding writes have returned.
(defn flush-output-port [(p i64)] (-> i64) (s-unspecified))
(defn file-directory? [(path i64)] (-> i64)
  (let [a (malloc-allocator) n (stdproc/string-length-raw path)
        cp (port-path-cstr a path)]
    (if (= (primitive/cast i64 cp) 0) (s-false)
        (let [dir (opendir cp)]
          (raw-free a (primitive/cast (ptr i8) cp) (+ n 1) 1)
          (if (= (primitive/cast i64 dir) 0) (s-false)
              (do (closedir dir) (s-true)))))))
(defn directory-name-offset [] (-> Code)
  ;; Linux: ino(8), off(8), reclen(2), type(1). Darwin adds namlen(1)
  ;; before type, placing d_name at byte 21.
  (if (primitive/code-eq (primitive/target-os) `macos) `21 `19))
(defn directory-dot-entry? [(name (ptr i8)) (n i64)] (-> bool)
  (and (> n 0)
       (= (primitive/cast i64 (primitive/load name)) 46)
       (or (= n 1)
           (and (= n 2)
                (= (primitive/cast i64 (primitive/load (primitive/index name 1))) 46)))))
(defn directory-list [(path i64)] (-> i64)
  (let [a (malloc-allocator)
        pn (stdproc/string-length-raw path)
        cp (port-path-cstr a path)]
    (if (= (primitive/cast i64 cp) 0) (s-nil)
      (let [dir (opendir cp)]
        (raw-free a (primitive/cast (ptr i8) cp) (+ pn 1) 1)
        (if (= (primitive/cast i64 dir) 0) (s-nil)
          (let [sp (gc-sp)
                holder (cons (s-nil) (s-nil))]
            (gc-root holder)
            (loop
              (let [entry (readdir dir)]
                (if (= (primitive/cast i64 entry) 0) (break)
                  (let [name (primitive/index entry (directory-name-offset))
                        n (strlen name)]
                    (if (directory-dot-entry? name n) 0
                      (let [s (stdproc/string-from-slice
                                (slice-new [u8] (primitive/cast (ptr u8) name) n))]
                        (gc-root s)
                        (set-car! holder (cons s (car holder)))))))))
            (closedir dir)
            (let [result (stdproc/scm-reverse (car holder))]
              (gc-root result)
              (gc-sp-set! sp)
              (gc-root result)
              result)))))))
(defn delete-directory [(path i64)] (-> i64)
  (let [a (malloc-allocator) n (stdproc/string-length-raw path)
        cp (port-path-cstr a path)]
    (if (= (primitive/cast i64 cp) 0) (s-false)
      (let [rc (rmdir cp)]
        (raw-free a (primitive/cast (ptr i8) cp) (+ n 1) 1)
        (mk-bool (= rc 0))))))
(defn file-length [(p i64)] (-> i64)
  (if (has-tag? p (tag-memory-port))
      (if (port-output-kind? p) (mk-fixnum (memory-port-position p))
        (if (!= (primitive/iand (port-flags p) (port-memory-string-flag)) 0)
            (mk-fixnum (stdproc/string-length-raw (memory-port-payload p)))
          (ffi/bytevector-length (memory-port-payload p))))
    (let [fd (primitive/cast i32 (port-fd p))
          here (lseek fd 0 1)
          end (lseek fd 0 2)]
      (if (>= here 0) (lseek fd here 0) 0)
      (if (< end 0) (s-false) (mk-fixnum end)))))
(defn mkdir [(path i64)] (-> i64)
  (let [a (malloc-allocator) n (stdproc/string-length-raw path)
        cp (port-path-cstr a path)]
    (if (= (primitive/cast i64 cp) 0) (s-false)
        (let [rc (c.mkdir cp 493)]
          (raw-free a (primitive/cast (ptr i8) cp) (+ n 1) 1)
          (mk-bool (= rc 0))))))
(defn rename-file [(from i64) (to i64)] (-> i64)
  (let [a (malloc-allocator) nf (stdproc/string-length-raw from)
        nt (stdproc/string-length-raw to) cf (port-path-cstr a from)
        ct (port-path-cstr a to)]
    (if (or (= (primitive/cast i64 cf) 0) (= (primitive/cast i64 ct) 0))
        (s-false)
        (let [rc (rename cf ct)]
          (raw-free a (primitive/cast (ptr i8) cf) (+ nf 1) 1)
          (raw-free a (primitive/cast (ptr i8) ct) (+ nt 1) 1)
          (mk-bool (= rc 0))))))
(defn scm-delete-file [(path i64)] (-> i64)
  (let [a (malloc-allocator) n (stdproc/string-length-raw path)
        cp (port-path-cstr a path)]
    (if (= (primitive/cast i64 cp) 0) (s-false)
        (let [rc (unlink cp)]
          (raw-free a (primitive/cast (ptr i8) cp) (+ n 1) 1)
          (mk-bool (= rc 0))))))
(defn scm-open-file-input-port [(path i64) (options i64) (buffer i64)] (-> i64)
  (open-input-file path))
(defn scm-open-file-output-port [(path i64) (options i64) (buffer i64)] (-> i64)
  (open-output-file path))

(defn port-read-raw [(p i64)] (-> i64)
  (if (not (port-input? p)) (port-fail c"read-char: expected an open input port")
    (if (has-tag? p (tag-custom-port))
        (let [sp (gc-sp)]
          (gc-root p)
          (let [bv (ffi/make-bytevector-raw 1 0)]
            (gc-root bv)
            (let [reader-proc (stdproc/scm-vector-ref (memory-port-state p) (mk-fixnum 1))]
              (gc-root reader-proc)
              (let [n (stdproc/call--3 reader-proc bv (mk-fixnum 0) (mk-fixnum 1))]
                (gc-root n)
                (let [result (if (or (val-eq? n (s-eof))
                                     (and (is-fixnum n) (= (fixnum-value n) 0)))
                                  (s-eof)
                                (mk-char (fixnum-value
                                  (ffi/bytevector-u8-ref bv (mk-fixnum 0)))))]
                  (gc-sp-set! sp)
                  result)))))
    (if (has-tag? p (tag-memory-port))
        (let [payload (memory-port-payload p)
              pos (memory-port-position p)
              string? (!= (primitive/iand (port-flags p) (port-memory-string-flag)) 0)
              n (if string? (stdproc/string-length-raw payload)
                    (fixnum-value (ffi/bytevector-length payload)))]
          (if (>= pos n) (s-eof)
            (let [code (if string? (stdproc/string-code payload pos)
                          (fixnum-value (ffi/bytevector-u8-ref payload (mk-fixnum pos))))]
              (memory-port-position-set! p (+ pos 1))
              (mk-char code))))
      (let [r (alloc/stack io/Reader)
            byte (alloc/stack i8)]
        (match (io/read-some (io/fd-reader r (port-fd p)) byte 1)
          (Err [e] (port-fail c"read-char: input error"))
          (Ok [n] (if (= n 0) (s-eof)
                    (mk-char (primitive/cast i64 (primitive/load byte)))))))))))

(defn scm-peek-char [(p i64)] (-> i64)
  (let [held (port-held p)]
    (if (undefined? held)
        (let [v (port-read-raw p)]
          (port-held-set! p v)
          v)
      held)))

(defn scm-read-char [(p i64)] (-> i64)
  (let [held (port-held p)]
    (let [v (if (undefined? held) (port-read-raw p)
              (do
                (port-held-set! p (s-undefined))
                held))]
      ; A transcript records input only when it is consumed, never when peeked.
      (if (and (transcript-active?)
               (and (val-eq? p (current-input-port)) (is-char v)))
          (match (io/write-byte
                   (port-writer (transcript-port) (alloc/stack io/Writer))
                   (primitive/cast u8 (char-value v)))
            (Err [_] (port-fail c"transcript: input echo failed"))
            (Ok [_] 0))
        0)
      v)))

; ---- datum reader ----------------------------------------------------------
;; This is the Scheme lexical adapter over a port. It intentionally does not
;; feed Scheme text through `coil.reader/read-all`: Coil character and vector
;; spellings are `\a` and `[...]`, whereas R5RS requires `#\a` and `#(...)`, and
;; Coil's Sexp tree deliberately erases the integer/character distinction.
;; Parsing directly from `read-char` also gives R5RS's required sequential-read
;; behavior without reading past the next datum.
(defn datum-space? [(c i64)] (-> bool)
  (or (= c 32) (or (= c 9) (or (= c 10) (or (= c 13) (or (= c 11) (= c 12)))))))
(defn datum-delim? [(c i64)] (-> bool)
  (or (datum-space? c)
      (or (= c 40) (or (= c 41) (or (= c 34) (or (= c 59)
          (or (= c 39) (or (= c 96) (= c 44)))))))))

(defn datum-skip-space [(p i64)] (-> i64)
  (let [(mut done) false]
    (loop (if (load done) (break)
      (let [v (scm-peek-char p)]
        (if (val-eq? v (s-eof)) (store! done true)
          (let [c (char-value v)]
            (if (datum-space? c) (do (scm-read-char p) 0)
              (if (= c 59)
                  (do
                    (scm-read-char p)
                    (loop (let [x (scm-read-char p)]
                            (if (or (val-eq? x (s-eof)) (= (char-value x) 10)) (break) 0)))
                  0)
                (store! done true))))))))
  0))

(defn datum-read-token [(p i64) (a (ptr Allocator))] (-> (slice u8))
  (let [(mut out) (al-new [u8] a)
        (mut done) false]
    (loop (if (load done) (break)
      (let [v (scm-peek-char p)]
        (if (val-eq? v (s-eof)) (store! done true)
          (let [c (char-value v)]
            (if (datum-delim? c) (store! done true)
              (do (scm-read-char p) (al-push! (mut out) (primitive/cast u8 c)) 0)))))))
    (al-slice [u8] (load out))))

(defn datum-reverse-onto [(rev i64) (tail i64)] (-> i64)
  (if (is-null rev) tail
    (let [sp (gc-sp)]
      (gc-root rev) (gc-root tail)
      (let [next (cons (car rev) tail)]
        (gc-root next)
        (let [out (datum-reverse-onto (cdr rev) next)]
          (gc-sp-set! sp) (gc-root out) out)))))

(defn datum-read-list [(p i64)] (-> i64)
  (let [sp (gc-sp)
        (mut rev) (s-nil)
        (mut out) (s-nil)
        (mut done) false]
    (loop (if (load done) (break)
      (do
        (datum-skip-space p)
        (let [v (scm-peek-char p)]
          (if (val-eq? v (s-eof))
              (do (store! out (port-fail c"read: unterminated list")) (store! done true))
            (if (= (char-value v) 41)
                (do (scm-read-char p)
                    (store! out (datum-reverse-onto (load rev) (s-nil)))
                    (store! done true))
              (let [item (datum-read-one p)]
                (gc-root item)
                (if (and (is-symbol item) (val-eq? item (intern ".")))
                    (if (is-null (load rev))
                        (do (store! out (port-fail c"read: dot before list element")) (store! done true))
                      (let [tail (datum-read-one p)]
                        (gc-root tail)
                        (if (and (is-symbol tail) (val-eq? tail (intern ".")))
                            (port-fail c"read: dot cannot be a dotted-list datum")
                          0)
                        (datum-skip-space p)
                        (let [close (scm-read-char p)]
                          (if (or (val-eq? close (s-eof)) (!= (char-value close) 41))
                              (store! out (port-fail c"read: dotted list needs closing parenthesis"))
                            (store! out (datum-reverse-onto (load rev) tail))))
                        (store! done true)))
                  (do
                    (store! rev (cons item (load rev)))
                    (gc-root (load rev)))))))))))
    (let [result (load out)]
      (gc-sp-set! sp) (gc-root result) result)))

(defn datum-string-escape [(c i64)] (-> i64)
  (if (= c 110) 10
    (if (= c 116) 9
      (if (= c 114) 13
        (if (or (= c 34) (= c 92)) c -1)))))

(defn datum-read-string [(p i64) (a (ptr Allocator))] (-> i64)
  (let [(mut out) (al-new [u8] a)
        (mut done) false]
    (loop
      (if (load done) (break)
        (let [v (scm-read-char p)]
          (if (val-eq? v (s-eof))
              (do (port-fail c"read: unterminated string") 0)
            (let [c (char-value v)]
              (if (= c 34)
                  (store! done true)
                (if (= c 92)
                    (let [e (scm-read-char p)]
                      (if (val-eq? e (s-eof))
                          (do (port-fail c"read: unterminated string escape") 0)
                        (let [ec (datum-string-escape (char-value e))]
                          (if (< ec 0)
                              (port-fail c"read: unknown string escape")
                            (al-push! (mut out) (primitive/cast u8 ec))))))
                  (al-push! (mut out) (primitive/cast u8 c)))))))))
    (stdproc/string-from-slice (al-slice [u8] (load out)))))

(defn datum-char-name [(s (slice u8))] (-> i64)
  (cond (= s "space") 32
        (= s "alarm") 7
        (or (= s "newline") (= s "linefeed")) 10
        (= s "tab") 9
        (= s "vtab") 11
        (= s "return") 13
        (or (= s "nul") (= s "null")) 0
        (= s "backspace") 8
        (or (= s "formfeed") (= s "page")) 12
        (= s "esc") 27
        (or (= s "delete") (= s "rubout")) 127
        (= (slice-len s) 1) (primitive/cast i64 (slice-get s 0))
        :else -1))

(defn datum-ascii-downcase! [(s (slice u8))] (-> i64)
  (for [i 0 (slice-len s)]
    (let [c (primitive/cast i64 (slice-get s i))]
      (if (and (>= c 65) (<= c 90))
          (primitive/store! (primitive/index (slice-data s) i)
                            (primitive/cast u8 (+ c 32)))
        0)))
  0)

;; R5RS 7.1.1 identifiers are deliberately narrower than Coil symbols. Keeping
;; this check in the runtime reader prevents malformed numeric-looking tokens
;; such as `12abc` from silently becoming identifiers and then failing much
;; later as unbound variables.
(defn datum-ascii-letter? [(c i64)] (-> bool)
  (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))))
(defn datum-identifier-initial? [(c i64)] (-> bool)
  (or (datum-ascii-letter? c)
      (or (= c 33) (or (= c 36) (or (= c 37) (or (= c 38)
      (or (= c 42) (or (= c 47) (or (= c 58) (or (= c 60)
      (or (= c 61) (or (= c 62) (or (= c 63) (or (= c 94)
      (or (= c 95) (= c 126))))))))))))))))
(defn datum-identifier-subsequent? [(c i64)] (-> bool)
  (or (datum-identifier-initial? c)
      (or (and (>= c 48) (<= c 57))
          (or (= c 43) (or (= c 45) (or (= c 46) (= c 64)))))))
(defn datum-identifier-rest? [(s (slice u8)) (i i64)] (-> bool)
  (if (>= i (slice-len s)) true
    (and (datum-identifier-subsequent? (primitive/cast i64 (slice-get s i)))
         (datum-identifier-rest? s (+ i 1)))))
(defn datum-valid-identifier? [(s (slice u8))] (-> bool)
  ;; `.` is recognized internally as the dotted-list marker. A top-level dot is
  ;; rejected by scm-read below; `+`, `-`, and `...` are R5RS's peculiar ids.
  (if (= s "+") true
    (if (= s "-") true
      (if (= s "...") true
        (if (= s ".") true
          (and (> (slice-len s) 0)
               (and (datum-identifier-initial? (primitive/cast i64 (slice-get s 0)))
                    (datum-identifier-rest? s 1))))))))

(defn datum-read-character [(p i64) (a (ptr Allocator))] (-> i64)
  (let [first (scm-read-char p)]
    (if (val-eq? first (s-eof)) (port-fail c"read: incomplete character literal")
      (let [c (char-value first)]
        ;; A delimiter can itself be the character (`#\)`, `#\"`). Otherwise
        ;; collect the alphabetic R5RS name or single-character token.
        (if (datum-delim? c) (mk-char c)
          (let [(mut bs) (al-new [u8] a)
                (mut done) false]
            (al-push! (mut bs) (primitive/cast u8 c))
            (loop (if (load done) (break)
              (let [next (scm-peek-char p)]
                (if (or (val-eq? next (s-eof)) (datum-delim? (char-value next)))
                    (store! done true)
                  (do (scm-read-char p)
                      (al-push! (mut bs) (primitive/cast u8 (char-value next)))
                      0)))))
            (let [name (al-slice [u8] (load bs))]
              ;; Character *names* are case-insensitive, but a one-character
              ;; literal preserves that character: `#\A` is uppercase A, not
              ;; the lower-case character produced by normalizing `space`.
              (if (= (slice-len name) 1)
                  (mk-char (primitive/cast i64 (slice-get name 0)))
                (do
                  (datum-ascii-downcase! name)
                  (let [code (datum-char-name name)]
                    (if (< code 0) (port-fail c"read: unknown character name") (mk-char code))))))))))))

(defn datum-sharp-terminated? [(p i64)] (-> bool)
  (let [next (scm-peek-char p)]
    (or (val-eq? next (s-eof)) (datum-delim? (char-value next)))))

(defn datum-read-vector [(p i64)] (-> i64)
  (let [sp (gc-sp)
        l (datum-read-list p)]
    (gc-root l)
    (if (not (truthy? (stdproc/scm-list? l)))
        (port-fail c"read: vector cannot contain dotted tail")
      (let [n (stdproc/list--length l 0)
            v (stdproc/make-vector-filled n (s-unspecified))
            (mut xs) l]
        (gc-root v)
        (for [i 0 n]
          (stdproc/scm-vector-set! v (mk-fixnum i) (car (load xs)))
          (store! xs (cdr (load xs))))
        (gc-sp-set! sp) (gc-root v) v))))

;; Chez implementation primitives use identifiers such as
;; `#%$current-winders` and `#3%$tc`. Preserve the full spelling and let the
;; compatibility environment supply their behavior.
(defn datum-read-sharp-symbol [(p i64) (a (ptr Allocator)) (level3 bool)] (-> i64)
  (let [(mut bs) (al-new [u8] a)]
    (al-push! (mut bs) (primitive/cast u8 35))
    (when level3 (al-push! (mut bs) (primitive/cast u8 51)) 0)
    (al-push! (mut bs) (primitive/cast u8 37))
    (let [tail (datum-read-token p a)]
      (for [i 0 (slice-len tail)]
        (al-push! (mut bs) (slice-get [u8] tail i)))
      (intern (al-slice [u8] (load bs))))))

(defn datum-read-sharp [(p i64) (a (ptr Allocator))] (-> i64)
  (let [v (scm-read-char p)]
    (if (val-eq? v (s-eof)) (port-fail c"read: incomplete # syntax")
      (let [c (char-value v)]
        (if (or (= c 116) (= c 84))
            (if (datum-sharp-terminated? p) (s-true) (port-fail c"read: boolean must end at delimiter"))
          (if (or (= c 102) (= c 70))
              (if (datum-sharp-terminated? p) (s-false) (port-fail c"read: boolean must end at delimiter"))
            (if (= c 40) (datum-read-vector p)
              (if (= c 92)
                  (datum-read-character p a)
                (if (= c 37) (datum-read-sharp-symbol p a false)
                (if (= c 51)
                    (let [percent (scm-read-char p)]
                      (if (and (not (val-eq? percent (s-eof)))
                               (= (char-value percent) 37))
                          (datum-read-sharp-symbol p a true)
                        (port-fail c"read: unsupported #3 syntax")))
                (if (or (= c 98) (or (= c 66) (or (= c 111) (or (= c 79)
                    (or (= c 100) (or (= c 68) (or (= c 120) (or (= c 88)
                    (or (= c 101) (or (= c 69) (or (= c 105) (= c 73))))))))))))
                    (let [number (numeric/parse-prefixed-number-tail
                                   (datum-read-token p a) c)]
                      (if (val-eq? number (s-false))
                          (port-fail c"read: malformed prefixed number")
                        number))
                  (port-fail c"read: unsupported # syntax"))))))))))))

(defn datum-read-atom [(p i64) (a (ptr Allocator))] (-> i64)
  (let [s (datum-read-token p a)]
    (if (= (slice-len s) 0) (port-fail c"read: expected datum")
      (match (reader/parse-int s)
        (Some [n] (mk-fixnum n))
        (None []
          (let [number (numeric/parse-number-slice s 10)]
            (if (val-eq? number (s-false))
                (if (datum-valid-identifier? s)
                    (do (datum-ascii-downcase! s) (intern s))
                  (port-fail c"read: invalid R5RS identifier or number"))
              number)))))))

(defn datum-prefixed [(name (slice u8)) (p i64)] (-> i64)
  (let [sp (gc-sp)
        v (datum-read-one p)]
    (gc-root v)
    (if (val-eq? v (s-eof))
        (port-fail c"read: datum abbreviation missing datum")
      (let [tail (cons v (s-nil))]
        (gc-root tail)
        (let [out (cons (intern name) tail)]
          (gc-sp-set! sp) (gc-root out) out)))))

(defn datum-read-one [(p i64)] (-> i64)
  (datum-skip-space p)
  (let [v (scm-peek-char p)]
    (if (val-eq? v (s-eof)) (s-eof)
      (let [c (char-value v)
            a (malloc-allocator)]
        (if (= c 40) (do (scm-read-char p) (datum-read-list p))
          (if (= c 41) (port-fail c"read: unexpected closing parenthesis")
            (if (= c 34) (do (scm-read-char p) (datum-read-string p a))
              (if (= c 39) (do (scm-read-char p) (datum-prefixed "quote" p))
                (if (= c 96) (do (scm-read-char p) (datum-prefixed "quasiquote" p))
                  (if (= c 44)
                      (do (scm-read-char p)
                          (let [next (scm-peek-char p)]
                            (if (and (not (val-eq? next (s-eof))) (= (char-value next) 64))
                                (do (scm-read-char p) (datum-prefixed "unquote-splicing" p))
                              (datum-prefixed "unquote" p))))
                    (if (= c 35) (do (scm-read-char p) (datum-read-sharp p a))
                      (datum-read-atom p a))))))))))))

(defn scm-read [(p i64)] (-> i64)
  (if (not (port-input? p)) (port-fail c"read: expected an open input port")
    (let [sp (gc-sp)]
      (gc-root p)
      (let [v (datum-read-one p)]
        (gc-root v)
        (if (and (is-symbol v) (val-eq? v (intern ".")))
            (port-fail c"read: dot outside list")
          (do (gc-sp-set! sp) (gc-root v) v))))))

(defn port-writer [(p i64) (w (ptr io/Writer))] (-> (ptr io/Writer))
  (if (not (port-output? p)) (do (port-fail c"output: expected an open output port") w)
    (if (has-tag? p (tag-custom-port))
        (do
          (primitive/store! (primitive/field w write-fn)
                            (primitive/fnptr-of custom-port-write))
          (primitive/store! (primitive/field w ctx)
                            (primitive/cast (ptr i8) (obj-of p)))
          w)
    (if (has-tag? p (tag-memory-port))
        (do
          (primitive/store! (primitive/field w write-fn)
                            (primitive/fnptr-of memory-port-write))
          (primitive/store! (primitive/field w ctx)
                            (primitive/cast (ptr i8) (obj-of p)))
          w)
      (io/fd-writer w (port-fd p))))))

(defn custom-port-write [(ctx (ptr i8)) (src (ptr i8)) (len i64)]
  (-> (Result i64 io/IoError))
  (let [sp (gc-sp)
        p (primitive/cast i64 (primitive/cast (ptr Obj) ctx))]
    (gc-root p)
    (let [bv (ffi/make-bytevector-raw len 0)]
      (gc-root bv)
      (memcpy (primitive/cast (ptr i8) (ffi/ffi-pointer-address bv)) src len)
      (let [writer-proc (stdproc/scm-vector-ref (memory-port-state p) (mk-fixnum 1))]
        (gc-root writer-proc)
        (let [n (stdproc/call--3 writer-proc bv (mk-fixnum 0) (mk-fixnum len))]
          (gc-root n)
          (let [written (if (is-fixnum n) (fixnum-value n) len)]
            (gc-sp-set! sp)
            (Ok written)))))))

;; The writer callback performs only native realloc/copy operations.  It cannot
;; trigger a Scheme collection while its context is an untagged Obj pointer.
;; The bytevector wrapper remains traced through the memory-port's `a` field.
(defn memory-port-write [(ctx (ptr i8)) (src (ptr i8)) (len i64)]
  (-> (Result i64 io/IoError))
  (let [o (primitive/cast (ptr Obj) ctx)
        p (primitive/cast i64 o)
        bv (memory-port-payload p)
        used (memory-port-position p)
        cap (fixnum-value (primitive/load (primitive/field (obj-of bv) b)))
        need (+ used len)
        next-cap (memory-port-capacity cap need)]
    (if (> next-cap cap)
        (let [old (primitive/cast (ptr u8)
                    (primitive/load (primitive/field (obj-of bv) a)))
              fresh (realloc old next-cap)]
          (if (= (primitive/cast i64 fresh) 0)
              (Err (io/OutOfMemory))
            (do
              (primitive/store! (primitive/field (obj-of bv) a)
                                (primitive/cast i64 fresh))
              (primitive/store! (primitive/field (obj-of bv) b)
                                (mk-fixnum next-cap))
              (memcpy (primitive/cast (ptr i8) (primitive/index fresh used)) src len)
              (memory-port-position-set! p need)
              (Ok len))))
      (do
        (memcpy
          (primitive/index
            (primitive/cast (ptr i8)
              (primitive/load (primitive/field (obj-of bv) a))) used)
          src len)
        (memory-port-position-set! p need)
        (Ok len)))))

(defn memory-port-capacity [(cap i64) (need i64)] (-> i64)
  (if (>= cap need) cap
    (memory-port-capacity (* cap 2) need)))

(defn get-output-string [(p i64)] (-> i64)
  (if (not (and (has-tag? p (tag-memory-port))
                (!= (primitive/iand (port-flags p) (port-memory-string-flag)) 0)))
      (port-fail c"get-output-string: expected a string output port")
    (let [sp (gc-sp)]
      (gc-root p)
      (let [bv (memory-port-payload p)
            cap (primitive/load (primitive/field (obj-of
                   (memory-port-payload p)) b))]
        (gc-root bv)
        (primitive/store! (primitive/field (obj-of bv) b)
                          (mk-fixnum (memory-port-position p)))
        (let [s (ffi/utf8->string bv)]
          (gc-root s)
          (primitive/store! (primitive/field (obj-of bv) b) cap)
          (gc-sp-set! sp)
          (gc-root s)
          s)))))

(defn put-string [(p i64) (s i64)] (-> i64)
  (scm-display-port s p))

(defn put-bytevector-range [(p i64) (bv i64) (start i64) (count i64)] (-> i64)
  (match (io/write-all (port-writer p (alloc/stack io/Writer))
           (primitive/index
             (primitive/cast (ptr i8) (ffi/ffi-pointer-address bv)) start)
           count)
    (Err [_] (port-fail c"put-bytevector: output error"))
    (Ok [_] (s-unspecified))))
(defn put-bytevector [(p i64) (bv i64)] (-> i64)
  (put-bytevector-range p bv 0 (fixnum-value (ffi/bytevector-length bv))))

(defn get-output-bytevector [(p i64)] (-> i64)
  (if (not (and (has-tag? p (tag-memory-port))
                (!= (primitive/iand (port-flags p) (port-memory-binary-flag)) 0)))
      (port-fail c"get-output-bytevector: expected a bytevector output port")
    (let [sp (gc-sp)]
      (gc-root p)
      (let [src (memory-port-payload p)
            n (memory-port-position p)]
        (gc-root src)
        (let [dst (ffi/make-bytevector-raw n 0)]
          (gc-root dst)
          (memcpy (primitive/cast (ptr i8) (ffi/ffi-pointer-address dst))
                  (primitive/cast (ptr i8) (ffi/ffi-pointer-address src)) n)
          (gc-sp-set! sp)
          (gc-root dst)
          dst)))))

(defn get-u8 [(p i64)] (-> i64)
  (let [v (scm-read-char p)]
    (if (val-eq? v (s-eof)) v (mk-fixnum (char-value v)))))
(defn get-char [(p i64)] (-> i64) (scm-read-char p))
(defn put-char [(p i64) (c i64)] (-> i64) (scm-write-char-port c p))

(defn put-u8 [(p i64) (byte i64)] (-> i64)
  (match (io/write-byte (port-writer p (alloc/stack io/Writer))
                        (primitive/cast u8 (fixnum-value byte)))
    (Err [_] (port-fail c"put-u8: output error"))
    (Ok [_] (s-unspecified))))

(defn get-bytevector-n!-loop [(p i64) (bv i64) (start i64) (count i64)
                              (got i64)] (-> i64)
  (if (>= got count) (mk-fixnum got)
      (let [v (get-u8 p)]
        (if (val-eq? v (s-eof))
            (if (= got 0) (s-eof) (mk-fixnum got))
            (do (ffi/bytevector-u8-set! bv (mk-fixnum (+ start got)) v)
                (get-bytevector-n!-loop p bv start count (+ got 1)))))))
(defn get-bytevector-n! [(p i64) (bv i64) (start i64) (count i64)] (-> i64)
  (get-bytevector-n!-loop p bv (fixnum-value start) (fixnum-value count) 0))
(defn get-bytevector-n [(p i64) (count i64)] (-> i64)
  (let [sp (gc-sp) n (fixnum-value count)]
    (gc-root p) (gc-root count)
    (let [buf (ffi/make-bytevector-raw n 0)]
      (gc-root buf)
      (let [got (get-bytevector-n! p buf (mk-fixnum 0) count)]
        (gc-root got)
        (if (val-eq? got (s-eof))
            (do (gc-sp-set! sp) (s-eof))
            (if (= (fixnum-value got) n)
                (do (gc-sp-set! sp) (gc-root buf) buf)
                (let [out (ffi/make-bytevector-raw (fixnum-value got) 0)]
                  (gc-root out)
                  (ffi/bytevector-copy! buf (mk-fixnum 0) out (mk-fixnum 0) got)
                  (gc-sp-set! sp) (gc-root out) out)))))))
(defn get-bytevector-some [(p i64)] (-> i64)
  (get-bytevector-n p (mk-fixnum 4096)))
(defn call-with-bytevector-output-port [(proc i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root proc)
    (let [p (open-bytevector-output-port)]
      (gc-root p)
      (stdproc/call--1 proc p)
      (let [out (get-output-bytevector p)]
        (gc-root out)
        (gc-sp-set! sp)
        (gc-root out)
        out))))

(defn get-bytevector-all [(p i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root p)
    (let [out (open-bytevector-output-port)]
      (gc-root out)
      (let [(mut any) false]
        (loop
          (let [v (get-u8 p)]
            (if (val-eq? v (s-eof)) (break)
              (do
                (store! any true)
                (match (io/write-byte (port-writer out (alloc/stack io/Writer))
                                      (primitive/cast u8 (fixnum-value v)))
                  (Err [_] (port-fail c"get-bytevector-all: output error"))
                  (Ok [_] 0))))))
        (if (not (load any))
            (do (gc-sp-set! sp) (s-eof))
          (let [result (get-output-bytevector out)]
            (gc-root result)
            (gc-sp-set! sp)
            (gc-root result)
            result))))))

(defn get-string-all [(p i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root p)
    (let [out (open-output-string)]
      (gc-root out)
      (let [(mut any) false]
        (loop
          (let [v (scm-read-char p)]
            (if (val-eq? v (s-eof)) (break)
              (do (store! any true) (scm-write-char-port v out) 0))))
        (if (not (load any))
            (do (gc-sp-set! sp) (s-eof))
          (let [result (get-output-string out)]
            (gc-root result)
            (gc-sp-set! sp)
            (gc-root result)
            result))))))

(defn get-string-some-loop [(p i64) (out i64) (n i64)] (-> i64)
  (if (>= n 4096) (mk-fixnum n)
    (let [v (scm-read-char p)]
      (if (val-eq? v (s-eof))
          (if (= n 0) (s-eof) (mk-fixnum n))
        (do (scm-write-char-port v out)
            (get-string-some-loop p out (+ n 1)))))))
(defn get-string-some [(p i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root p)
    (let [out (open-output-string)]
      (gc-root out)
      (let [read-result (get-string-some-loop p out 0)]
        (if (val-eq? read-result (s-eof))
            (do (gc-sp-set! sp) (s-eof))
          (let [result (get-output-string out)]
            (gc-root result)
            (gc-sp-set! sp)
            (gc-root result)
            result))))))

(defn get-line [(p i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root p)
    (let [out (open-output-string)]
      (gc-root out)
      (let [(mut any) false
            (mut hit-eof) false]
        (loop
          (let [v (scm-read-char p)]
            (if (val-eq? v (s-eof)) (do (store! hit-eof true) (break))
              (if (= (char-value v) 10) (break)
                (do (store! any true) (scm-write-char-port v out) 0)))))
        (if (and (not (load any)) (load hit-eof))
            (do (gc-sp-set! sp) (s-eof))
          (if (not (load any))
            (let [result (get-output-string out)]
              (gc-root result)
              (gc-sp-set! sp)
              (gc-root result)
              result)
          (let [result (get-output-string out)]
            (gc-root result)
            (gc-sp-set! sp)
            (gc-root result)
              result)))))))

(defn scm-fprintf-args [(args i64)] (-> i64)
  (if (or (is-null args) (is-null (cdr args))) (s-unspecified)
    (let [sp (gc-sp)
          port (car args)
          format-args (cons (s-false) (cdr args))]
      (gc-root args) (gc-root port) (gc-root format-args)
      (let [rendered (stdproc/scm-format-args format-args)]
        (gc-root rendered)
        (put-string port rendered)
        (gc-sp-set! sp)
        (s-unspecified)))))
(defn scm-display-condition2 [(c i64) (port i64)] (-> i64)
  (if (truthy? (stdproc/message-condition? c))
      (scm-display-port (stdproc/condition-message c) port)
    (scm-write-port c port)))
(defn scm-display-condition1 [(c i64)] (-> i64)
  (scm-display-condition2 c (current-output-port)))

(defn textual-port? [(p i64)] (-> i64)
  (mk-bool (or (has-tag? p (tag-port))
               (!= (primitive/iand (port-flags p) (port-memory-string-flag)) 0))))
(defn binary-port? [(p i64)] (-> i64)
  (mk-bool (and (or (has-tag? p (tag-memory-port)) (has-tag? p (tag-custom-port)))
                (and (= (primitive/iand (port-flags p) (port-memory-string-flag)) 0)
                     (!= (primitive/iand (port-flags p) (port-memory-binary-flag)) 0)))))
(defn transcoded-port [(p i64) (transcoder i64)] (-> i64)
  (let [ignored transcoder]
    (primitive/store! (primitive/field (obj-of p) b)
      (mk-fixnum (primitive/ior (port-flags p) (port-memory-string-flag))))
    p))
(defn port-position [(p i64)] (-> i64)
  (if (has-tag? p (tag-custom-port))
      (let [getter (stdproc/scm-vector-ref (memory-port-state p) (mk-fixnum 3))]
        (if (is-procedure getter) (stdproc/call--0 getter) (s-false)))
    (if (has-tag? p (tag-memory-port)) (mk-fixnum (memory-port-position p))
      (let [at (lseek (primitive/cast i32 (port-fd p)) 0 1)]
        (if (< at 0) (s-false) (mk-fixnum at))))))
(defn set-port-position! [(p i64) (position i64)] (-> i64)
  (if (has-tag? p (tag-custom-port))
      (let [setter (stdproc/scm-vector-ref (memory-port-state p) (mk-fixnum 4))]
        (if (is-procedure setter) (stdproc/call--1 setter position) (s-false)))
    (if (has-tag? p (tag-memory-port))
        (do (memory-port-position-set! p (fixnum-value position)) (s-unspecified))
      (if (< (lseek (primitive/cast i32 (port-fd p)) (fixnum-value position) 0) 0)
          (s-false) (s-unspecified)))))
(defn port-name [(p i64)] (-> i64)
  (if (has-tag? p (tag-custom-port))
      (stdproc/scm-vector-ref (memory-port-state p) (mk-fixnum 0))
    (stdproc/string-from-slice "file-port")))
(defn port-closed? [(p i64)] (-> i64) (mk-bool (not (port-open? p))))

(defn scm-display-port [(v i64) (p i64)] (-> i64)
  (let [result (stdproc/display--val (port-writer p (alloc/stack io/Writer)) v)]
    (if (and (transcript-active?) (val-eq? p (current-output-port)))
        (stdproc/display--val
          (port-writer (transcript-port) (alloc/stack io/Writer)) v)
      (s-unspecified))
    result))
(defn scm-write-port [(v i64) (p i64)] (-> i64)
  (let [result (stdproc/write--val (port-writer p (alloc/stack io/Writer)) v)]
    (if (and (transcript-active?) (val-eq? p (current-output-port)))
        (stdproc/write--val
          (port-writer (transcript-port) (alloc/stack io/Writer)) v)
      (s-unspecified))
    result))
(defn scm-newline-port [(p i64)] (-> i64)
  (match (io/write-byte (port-writer p (alloc/stack io/Writer)) (primitive/cast u8 10))
    (Err [e] (port-fail c"newline: output error"))
    (Ok [n]
      (do
        (if (and (transcript-active?) (val-eq? p (current-output-port)))
            (match (io/write-byte
                     (port-writer (transcript-port) (alloc/stack io/Writer))
                     (primitive/cast u8 10))
              (Err [_] (port-fail c"transcript: newline failed"))
              (Ok [_] 0))
          0)
        (s-unspecified)))))
(defn scm-write-char-port [(c i64) (p i64)] (-> i64)
  (if (not (is-char c)) (port-fail c"write-char: expected a character")
    (match (io/write-byte (port-writer p (alloc/stack io/Writer))
                          (primitive/cast u8 (char-value c)))
      (Err [e] (port-fail c"write-char: output error"))
      (Ok [n]
        (do
          (if (and (transcript-active?) (val-eq? p (current-output-port)))
              (match (io/write-byte
                       (port-writer (transcript-port) (alloc/stack io/Writer))
                       (primitive/cast u8 (char-value c)))
                (Err [_] (port-fail c"transcript: character failed"))
                (Ok [_] 0))
            0)
          (s-unspecified))))))

;; R5RS's file combinators. There is no exception system in the current Scheme
;; subset, so restoration is guaranteed on ordinary return; non-local exits are
;; part of the explicitly deferred continuation/dynamic-wind work.
(defn call-with-input-file [(path i64) (proc i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root path)
    (gc-root proc)
    (let [p (open-input-file path)]
      (gc-root p)
      (let [result (stdproc/call--1 proc p)]
        (gc-root result)
        (close-input-port p)
        (gc-sp-set! sp)
        result))))
(defn call-with-output-file [(path i64) (proc i64)] (-> i64)
  (let [sp (gc-sp)]
    (gc-root path)
    (gc-root proc)
    (let [p (open-output-file path)]
      (gc-root p)
      (let [result (stdproc/call--1 proc p)]
        (gc-root result)
        (close-output-port p)
        (gc-sp-set! sp)
        result))))
(defn with-input-from-file [(path i64) (thunk i64)] (-> i64)
  (let [old (current-input-port)
        p (open-input-file path)]
    (port-set-current-input! p)
    (let [result (stdproc/call--0 thunk)]
      (port-set-current-input! old)
      (close-input-port p)
      result)))
(defn with-output-to-file [(path i64) (thunk i64)] (-> i64)
  (let [old (current-output-port)
        p (open-output-file path)]
    (port-set-current-output! p)
    (let [result (stdproc/call--0 thunk)]
      (port-set-current-output! old)
      (close-output-port p)
      result)))
(defn with-output-to-string [(thunk i64)] (-> i64)
  (let [sp (gc-sp)
        old (current-output-port)
        p (open-output-string)]
    (gc-root old)
    (gc-root p)
    (port-set-current-output! p)
    (stdproc/call--0 thunk)
    (port-set-current-output! old)
    (let [result (get-output-string p)]
      (gc-root result)
      (close-output-port p)
      (gc-sp-set! sp)
      (gc-root result)
      result)))

;; R5RS makes the port argument optional. Coil runtime functions have fixed
;; arity, so the surface macros select the ambient port at expansion time.
(defn read-char [& (args Code)] (-> Code)
  (if (= (primitive/code-count args) 0)
      `(scm-read-char (current-input-port))
    `(scm-read-char ~(primitive/code-nth args 0))))
(defn peek-char [& (args Code)] (-> Code)
  (if (= (primitive/code-count args) 0)
      `(scm-peek-char (current-input-port))
    `(scm-peek-char ~(primitive/code-nth args 0))))
(defn char-ready? [& (args Code)] (-> Code)
  (if (= (primitive/code-count args) 0)
      `(scm-char-ready? (current-input-port))
    `(scm-char-ready? ~(primitive/code-nth args 0))))
(defn read [& (args Code)] (-> Code)
  (if (= (primitive/code-count args) 0)
      `(scm-read (current-input-port))
    `(scm-read ~(primitive/code-nth args 0))))
(defn write-char [(c Code) & (ports Code)] (-> Code)
  (if (= (primitive/code-count ports) 0)
      `(scm-write-char-port ~c (current-output-port))
    `(scm-write-char-port ~c ~(primitive/code-nth ports 0))))

;; Argument-list entry points make the optional-port procedures genuine values.
(defn scm-read-char-args [(args i64)] (-> i64)
  (if (is-null args) (scm-read-char (current-input-port))
    (if (is-null (cdr args)) (scm-read-char (car args)) (s-unspecified))))
(defn scm-peek-char-args [(args i64)] (-> i64)
  (if (is-null args) (scm-peek-char (current-input-port))
    (if (is-null (cdr args)) (scm-peek-char (car args)) (s-unspecified))))
(defn scm-char-ready-args [(args i64)] (-> i64)
  (if (is-null args) (scm-char-ready? (current-input-port))
    (if (is-null (cdr args)) (scm-char-ready? (car args)) (s-unspecified))))
(defn scm-read-args [(args i64)] (-> i64)
  (if (is-null args) (scm-read (current-input-port))
    (if (is-null (cdr args)) (scm-read (car args)) (s-unspecified))))
(defn scm-display-args [(args i64)] (-> i64)
  (if (is-null args) (s-unspecified)
    (let [rest (cdr args)]
      (if (is-null rest) (scm-display-port (car args) (current-output-port))
        (if (is-null (cdr rest)) (scm-display-port (car args) (car rest))
          (s-unspecified))))))
(defn scm-write-args [(args i64)] (-> i64)
  (if (is-null args) (s-unspecified)
    (let [rest (cdr args)]
      (if (is-null rest) (scm-write-port (car args) (current-output-port))
        (if (is-null (cdr rest)) (scm-write-port (car args) (car rest))
          (s-unspecified))))))
(defn scm-newline-args [(args i64)] (-> i64)
  (if (is-null args) (scm-newline-port (current-output-port))
    (if (is-null (cdr args)) (scm-newline-port (car args)) (s-unspecified))))
(defn scm-write-char-args [(args i64)] (-> i64)
  (if (is-null args) (s-unspecified)
    (let [rest (cdr args)]
      (if (is-null rest) (scm-write-char-port (car args) (current-output-port))
        (if (is-null (cdr rest)) (scm-write-char-port (car args) (car rest))
          (s-unspecified))))))

