(module coil.scheme.derived)
(import "coil.primitive" :as primitive)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)

;; The derived forms. R5RS §7.3 defines these with `syntax-rules`; until that
;; exists they are hand-written macros, which is fine because they expand to the
;; same thing either way — `if`, `let` and procedure application over the core.
;;
;; Scheme's binding forms map almost exactly onto Coil's, which is the payoff of
;; the dialect model: `let` is a `let`, not an environment structure to allocate
;; and search. What is left is shape translation — Scheme writes `((n v) …)` where
;; Coil writes `[n v …]`.

; ---- let / let* -------------------------------------------------------------
;; ((a 1) (b 2)) -> [a 1 b 2]
;; ⚠ A BINDING MUST BE CHECKED FOR SHAPE BEFORE IT IS INDEXED. R5RS says a `let`
;; binding is `(name init)`, and this used to index element 0 and 1 on faith. A
;; binding that is not a two-element list therefore killed the metaprogram with
;;
;;     error: comptime: code-nth expects a list/vector
;;
;; located at the module's `import` line and naming nothing — so `(let ((a 1)
;; (b 2)) …)`, ordinary Scheme, failed with a diagnostic that pointed at the
;; user's file and blamed no one. Reporting the malformed binding instead is both
;; a better error and the difference between a five-minute fix and a long hunt.
(defn scm--bindings [(bs Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `[]
      (let [b (primitive/code-nth bs i)]
        (if (not (and (primitive/code-list? b) (>= (primitive/code-count b) 2)))
            (do
              (primitive/report bs
                                "a `let` binding must be a list of the form (name init)")
              `[])
            `[~(primitive/code-nth b 0)
              ~(primitive/code-nth b 1)
              ~@(scm--bindings bs (+ i 1) n)]))))

;; R5RS `let` evaluates every init in the OUTER scope, which is exactly Coil's
;; `let`, so this is a shape change and nothing more.
(defn scm-let [(bs Code) & (body Code)] (-> Code)
  `(let ~(scm--bindings bs 0 (primitive/code-count bs)) ~@body))

;; `let*` binds sequentially — each init sees the previous bindings. Built by
;; nesting one-binding lets, which is how R5RS itself defines it.
(defn scm--let*-nest [(bs Code) (i i64) (n i64) (body Code)] (-> Code)
  (if (>= i n)
      `(do ~@body)
      (let [b (primitive/code-nth bs i)]
        ;; Same guard as `scm--bindings`, for the same reason.
        (if (not (and (primitive/code-list? b) (>= (primitive/code-count b) 2)))
            (do
              (primitive/report b
                                "a `let*` binding must be a list of the form (name init)")
              `(do ~@body))
            `(let [~(primitive/code-nth b 0) ~(primitive/code-nth b 1)]
               ~(scm--let*-nest bs (+ i 1) n body))))))
(defn let* [(bs Code) & (body Code)] (-> Code)
  (scm--let*-nest bs 0 (primitive/code-count bs) body))

; ---- cond -------------------------------------------------------------------
;; Clauses are (test body…), plus `else`, plus the `=>` receiver form.
;;
;; `=>` is the one with a trap: `(cond (f => g))` must evaluate `f` ONCE and pass
;; the result to `g`. Expanding it as `(if (f) (g (f)) …)` would evaluate it
;; twice, which is wrong whenever the test has an effect — so the value is bound
;; to a temporary first.
;; ⚠ A CLAUSE MUST BE CHECKED FOR LISTNESS BEFORE IT IS INDEXED.
;;
;; `(code-nth c 0)` used to run unconditionally. When anything hands this macro a
;; clause that is not a list, that call dies inside the metaprogram engine with
;;
;;     error: comptime: code-nth expects a list/vector
;;
;; reported against the module's `import` line — the transform's own source
;; position — rather than against the clause. That diagnostic is what made this
;; look like a bug in the dialect rewriter for a long time: the error names
;; neither the form nor the file that contains it.
;;
;; Reporting the malformed clause is strictly better than crashing on it: R5RS
;; requires every `cond` clause to be `(test body …)`, so a non-list clause is a
;; program error that deserves a located message.
(defn scm--cond [(cs Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `(s-unspecified)  ; no clause matched: unspecified
      (let [c (primitive/code-nth cs i)]
        (if (not (primitive/code-list? c))
            (do
              (primitive/report c
                                "a `cond` clause must be a list of the form (test body …)")
              `(s-unspecified))
            (let [test (primitive/code-nth c 0)]
              (if (primitive/code-eq test `else)
                  `(do ~@(scm--rest c 1 (primitive/code-count c)))
                  (if (and (>= (primitive/code-count c) 3)
                           (primitive/code-eq (primitive/code-nth c 1) `=>))
                      ; (test => recv): bind once, then apply
                      (let [tmp (primitive/gensym)]
                        `(let [~tmp ~test]
                           (if (truthy? ~tmp)
                               (~(primitive/code-nth c 2) ~tmp)
                               ~(scm--cond cs (+ i 1) n))))
                      (if (= (primitive/code-count c) 1)
                          ; (test) with no body: the test's own value is the result
                          (let [tmp (primitive/gensym)]
                            `(let [~tmp ~test]
                               (if (truthy? ~tmp) ~tmp ~(scm--cond cs (+ i 1) n))))
                          `(if (truthy? ~test)
                               (do ~@(scm--rest c 1 (primitive/code-count c)))
                               ~(scm--cond cs (+ i 1) n))))))))))

(defn scm--rest [(e Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      (primitive/code-cons (primitive/code-nth e i) (scm--rest e (+ i 1) n))))

(defn cond [& (cs Code)] (-> Code)
  (scm--cond cs 0 (primitive/code-count cs)))

; ---- and / or ---------------------------------------------------------------
;; R5RS: `(and)` is #t, `(or)` is #f, and both return the VALUE that decided the
;; result rather than a boolean — `(or #f 2)` is 2, not #t. That is why these
;; bind a temporary instead of testing twice.
(defn scm--and [(es Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `(s-true)
      (if (= i (- n 1))
          (primitive/code-nth es i)
          (let [tmp (primitive/gensym)]
            `(let [~tmp ~(primitive/code-nth es i)]
               (if (truthy? ~tmp) ~(scm--and es (+ i 1) n) ~tmp))))))
(defn scm-and [& (es Code)] (-> Code)
  (scm--and es 0 (primitive/code-count es)))

(defn scm--or [(es Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `(s-false)
      (if (= i (- n 1))
          (primitive/code-nth es i)
          (let [tmp (primitive/gensym)]
            `(let [~tmp ~(primitive/code-nth es i)]
               (if (truthy? ~tmp) ~tmp ~(scm--or es (+ i 1) n)))))))
(defn scm-or [& (es Code)] (-> Code)
  (scm--or es 0 (primitive/code-count es)))

; ---- when / unless (not R5RS, but universally present) ----------------------
(defn when [(test Code) & (body Code)] (-> Code)
  `(if (truthy? ~test) (do ~@body) (s-unspecified)))
(defn unless [(test Code) & (body Code)] (-> Code)
  `(if (truthy? ~test) (s-unspecified) (do ~@body)))

; ---- begin ------------------------------------------------------------------
(defn begin [& (body Code)] (-> Code)
  `(do ~@body))

;; ⚠ EXPORT ONLY THE R5RS-SPELLED SURFACE.
;;
;; This module's `scm-` names are implementation spellings. If they were exported
;; they would reach every Scheme program through the umbrella, and `(scm-append
;; a b)` would compile — at which point the language being written is a lookalike
;; rather than Scheme. `coil.scheme.r5rs` reaches them through a qualified alias
;; and re-binds each under its standard name.
;; Everything below is exported for this module's own _test.coil and for macros
;; that expand to these names. `coil.scheme.lint` still rejects any `scm-` name
;; written by hand in Scheme source, so this does not widen the Scheme surface.
(export begin
        scm--and
        scm--bindings
        scm--cond
        scm--let*-nest
        scm--or
        scm--rest
        scm-and
        scm-let
        scm-or
        when
        begin
        cond
        let*
        unless
        when)
