(module coil.scheme.heap)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.scheme.value" :use *)
(import "coil.sync" :as sync)

;; The Scheme heap: fixed-size objects, bump-allocated out of big slabs, with a
;; free list rebuilt by a linear sweep.
;;
;; Every object is the same size (an `Obj`), which is what makes this simple: no
;; size classes, no fragmentation, and a sweep that walks a slab linearly instead
;; of chasing a per-object list. The predecessor measured that linear sweep as the
;; single biggest collector win — it removed both malloc/free from the hot path and
;; the live-list threading that came with it.
;;
;; Collection is precise, not conservative: roots come from the shadow stack the
;; GC transform maintains, so the tracer never guesses whether a word is a pointer.
;; Immediates are skipped outright (see value.coil) — an immediate has a non-zero
;; low tag and is never dereferenced.
;;
(extern malloc :cc c [i64] (-> (ptr u8)))
(extern free :cc c [(ptr u8)] (-> void))

;; Object size and slab size. 40 bytes = 5 i64 fields (tag, mark, a, b, c).
(defn obj-size [] (-> i64) 40)
;; 1M objects per slab. Big enough that slab allocation is rare, small enough that
;; a program with a tiny live set does not commit hundreds of MB up front.
(defn slab-bytes [] (-> i64) 41943040)

; --- collector state --------------------------------------------------------
(defn g-slabs [] (-> (ptr (array i64 4096))) (alloc/static (array i64 4096)))
(defn g-nslabs [] (-> (ptr i64)) (alloc/static i64))
(defn g-free [] (-> (ptr i64)) (alloc/static i64))    ; free-list head, 0 = empty
(defn g-cur [] (-> (ptr i64)) (alloc/static i64))     ; bump cursor into the newest slab
(defn g-end [] (-> (ptr i64)) (alloc/static i64))     ; end of the newest slab
(defn g-live [] (-> (ptr i64)) (alloc/static i64))
(defn g-peak [] (-> (ptr i64)) (alloc/static i64))
(defn g-collections [] (-> (ptr i64)) (alloc/static i64))
(defn g-total [] (-> (ptr i64)) (alloc/static i64))
(defn g-next-collection [] (-> (ptr i64)) (alloc/static i64))

;; The shadow stack. The GC transform emits `gc-root`/`gc-sp`/`gc-sp-set!` around
;; managed values so collection points always see a consistent root set — which is
;; why no safepoint machinery is needed: a collection can only happen inside
;; `allocate`, and the roots are correct there by construction.
(defn g-roots [] (-> (ptr (array i64 1048576))) (alloc/static (array i64 1048576)))
(defn g-rtop [] (-> (ptr i64)) (alloc/static i64))

(defn gc-sp [] (-> i64) (primitive/load (g-rtop)))
(defn gc-sp-set! [(n i64)] (-> i64) (primitive/store! (g-rtop) n) 0)
(defn gc-root [(v i64)] (-> i64)
  (let [t (primitive/load (g-rtop))]
    (primitive/store! (primitive/index (g-roots) t) v)
    (primitive/store! (g-rtop) (+ t 1))
    0))

;; Permanent roots: the global environment and the symbol table live for the whole
;; program, so they are traced from a fixed cell rather than the shadow stack.
(defn g-globals [] (-> (ptr i64)) (alloc/static i64))
(defn g-permanent-roots [] (-> (ptr (array i64 1048576)))
  (alloc/static (array i64 1048576)))
(defn g-permanent-top [] (-> (ptr i64)) (alloc/static i64))
(defn gc-root-permanent [(v i64)] (-> i64)
  (let [t (primitive/load (g-permanent-top))]
    (primitive/store! (primitive/index (g-permanent-roots) t) v)
    (primitive/store! (g-permanent-top) (+ t 1))
    0))
(defn set-globals! [(v i64)] (-> i64) (primitive/store! (g-globals) v) 0)
(defn globals [] (-> i64) (primitive/load (g-globals)))

; --- mark -------------------------------------------------------------------
;; Low tag bits alone cannot prove that an i64 is one of our objects: aligned raw
;; values such as native function pointers have the same 000 suffix. Generated
;; code can conservatively place such values in a root slot, so validate the
;; address against the allocator-owned slabs before dereferencing it.
(defn managed-address? [(v i64)] (-> bool)
  (let [n (primitive/load (g-nslabs))
        cur (primitive/load (g-cur))
        (mut found) false]
    (for [i 0 n]
      (let [base (primitive/load (primitive/index (g-slabs) i))
            limit (if (= i (- n 1)) cur (+ base 41943040))]
        (if (and (>= v base) (< v limit))
            (primitive/store! (mut found) true)
          0)))
    (primitive/load (mut found))))

;; Trace one object. Most shapes contain Vals in all three payload slots. The two
;; atomic/raw exceptions must be dispatched by tag: a flonum's `a` is IEEE bits,
;; and a symbol's `a` is its raw intern-table index (while a fresh hygienic
;; symbol's `b` still points at its source symbol).
(defn raw-payload-tag? [(tag i64)] (-> bool)
  (or (= tag (tag-flonum))
      (or (= tag (tag-syntax))
          (or (= tag (tag-foreign-pointer))
              (or (= tag (tag-bytevector))
                  (or (= tag (tag-mutex)) (= tag (tag-condition))))))))
(defn mark-enqueue [(v i64) (work (ptr i64)) (top (ptr i64))] (-> i64)
  (if (not (is-heap v)) 0                    ; immediates are never traced
    (if (= v 0) 0                            ; null
      (if (not (managed-address? v)) 0       ; aligned raw values are not objects
        (let [o (obj-of v)]
          (if (= (primitive/load (primitive/field o mark)) 1) 0
            (let [i (primitive/load top)]
              ;; Mark on enqueue, not dequeue. Cycles and multiply-referenced
              ;; objects therefore occupy exactly one worklist slot.
              (primitive/store! (primitive/field o mark) 1)
              (primitive/store! (primitive/index work i) v)
              (primitive/store! top (+ i 1))
              0)))))))

(defn mark-roots [] (-> i64)
  ;; Recursive marking makes the native stack proportional to Scheme graph
  ;; depth. A saved continuation root list (and ordinary long lists) can be
  ;; thousands of pairs deep, so use a bounded explicit worklist instead. One
  ;; slot per allocator-owned object is sufficient because mark-enqueue marks an
  ;; object before pushing it.
  (let [capacity (* (primitive/load (g-nslabs)) 1048576)
        bytes (* (if (= capacity 0) 1 capacity) 8)
        raw (malloc bytes)
        work (primitive/cast (ptr i64) raw)
        (mut top) 0]
    (mark-enqueue (globals) work (mut top))
    (let [n (primitive/load (g-permanent-top))]
      (for [i 0 n]
        (mark-enqueue (primitive/load (primitive/index (g-permanent-roots) i))
                      work (mut top))))
    (let [n (primitive/load (g-rtop))]
      (for [i 0 n]
        (mark-enqueue (primitive/load (primitive/index (g-roots) i))
                      work (mut top))))
    (loop
      (if (= (primitive/load (mut top)) 0) (break)
        (do
          (primitive/store! (mut top) (- (primitive/load (mut top)) 1))
          (let [v (primitive/load
                    (primitive/index work (primitive/load (mut top))))
                o (obj-of v)
                tag (primitive/load (primitive/field o tag))]
            ;; Flonum `a` is raw IEEE bits and syntax `a` is an opaque compiler
            ;; handle. Symbol `a` is its raw intern-table index.
            (if (raw-payload-tag? tag) 0
              (if (= tag (tag-symbol))
                  (mark-enqueue (primitive/load (primitive/field o b))
                                work (mut top))
                (do
                  (mark-enqueue (primitive/load (primitive/field o a))
                                work (mut top))
                  (mark-enqueue (primitive/load (primitive/field o b))
                                work (mut top))
                  (mark-enqueue (primitive/load (primitive/field o c))
                                work (mut top))
                  0)))))))
    (free raw)
    0))

; --- sweep ------------------------------------------------------------------
;; Walk one slab linearly: unmark what survived, and thread everything else onto
;; the free list. Linear because the objects are uniform — no list to chase, and
;; the access pattern is cache-friendly.
(defn sweep-slab [(base i64) (limit i64)] (-> i64)
  (let [(mut p) base]
    (loop
      (if (>= (primitive/load p) limit) (break)
        (let [o (primitive/cast (ptr Obj) (primitive/load p))]
          (if (= (primitive/load (primitive/field o mark)) 1)
              (do (primitive/store! (primitive/field o mark) 0)
                  (primitive/store! (g-live) (+ (primitive/load (g-live)) 1)) 0)
            ; Release native storage owned by an unreachable atomic wrapper,
            ; then reuse the `a` slot as the free-list link. Explicit release
            ; clears the ownership slot, so sweep cannot double-free it.
            (do
                (if (and (= (primitive/load (primitive/field o tag)) (tag-foreign-pointer))
                         (= (primitive/load (primitive/field o b)) 1))
                    (do (free (primitive/cast (ptr u8) (primitive/load (primitive/field o a)))) 0)
                  (if (and (= (primitive/load (primitive/field o tag)) (tag-bytevector))
                           (= (primitive/load (primitive/field o c)) 1))
                      (do (free (primitive/cast (ptr u8) (primitive/load (primitive/field o a)))) 0)
                    (if (= (primitive/load (primitive/field o tag)) (tag-mutex))
                        (do
                          (sync/mutex-destroy!
                            (primitive/cast (ptr sync/Mutex)
                              (primitive/load (primitive/field o a))))
                          (free (primitive/cast (ptr u8) (primitive/load (primitive/field o a))))
                          0)
                      (if (= (primitive/load (primitive/field o tag)) (tag-condition))
                          (do
                            (sync/condition-destroy!
                              (primitive/cast (ptr sync/Condition)
                                (primitive/load (primitive/field o a))))
                            (free (primitive/cast (ptr u8) (primitive/load (primitive/field o a))))
                            0)
                        0))))
                (primitive/store! (primitive/field o a) (primitive/load (g-free)))
                (primitive/store! (g-free) (primitive/cast i64 o)) 0))
          (primitive/store! p (+ (primitive/load p) 40)))))
    0))

(defn collect [] (-> i64)
  ; peak is sampled before the sweep, when the live set is at its largest
  (if (> (primitive/load (g-live)) (primitive/load (g-peak)))
      (primitive/store! (g-peak) (primitive/load (g-live))) 0)
  (mark-roots)
  (primitive/store! (g-free) 0)     ; the free list is rebuilt entirely by the sweep
  (primitive/store! (g-live) 0)     ; and live is recounted by it
  (let [n (primitive/load (g-nslabs)) cur (primitive/load (g-cur))]
    (for [i 0 n]
      (let [base (primitive/load (primitive/index (g-slabs) i))]
        ; the newest slab is only filled up to the bump cursor; the rest are full
        (sweep-slab base (if (= i (- n 1)) cur (+ base 41943040))))))
  ;; A fixed threshold becomes a collection-on-every-allocation trap whenever
  ;; the genuine live set itself exceeds that threshold. Give the surviving
  ;; graph one live-set worth of headroom (with the original 500k floor).
  (let [live (primitive/load (g-live))]
    (primitive/store! (g-next-collection)
      (if (< (* live 2) 500000) 500000 (* live 2))))
  (primitive/store! (g-collections) (+ (primitive/load (g-collections)) 1))
  0)

; --- allocate ---------------------------------------------------------------
;; Collect when the live set crosses the threshold. Sized so a program with a small
;; working set never collects at all, and a heavy allocator collects rarely enough
;; that mark cost stays a small share of runtime.
(defn gc-threshold [] (-> i64)
  (let [n (primitive/load (g-next-collection))]
    (if (= n 0) 500000 n)))

(defn new-slab [] (-> i64)
  (let [s (primitive/cast i64 (malloc 41943040))
        n (primitive/load (g-nslabs))]
    (primitive/store! (primitive/index (g-slabs) n) s)
    (primitive/store! (g-nslabs) (+ n 1))
    (primitive/store! (g-cur) (+ s 40))
    (primitive/store! (g-end) (+ s 41943040))
    s))

;; The only place a collection can be triggered. Everything the transform roots is
;; rooted precisely because of this: an allocation is the one point where the
;; machine can lose a value it still needs.
(defn allocate [(tag i64) (a i64) (b i64) (c i64)] (-> i64)
  ;; Collection happens before the payload is installed, so the payload
  ;; arguments themselves are the allocator's responsibility. Relying on a
  ;; caller frame worked accidentally until a legitimate tail-call reset popped
  ;; that frame; a collection during `cons` then swept an argument before it was
  ;; stored. Root only Val-bearing slots: flonum bits and symbol ids are raw.
  (let [sp (gc-sp)]
  (if (raw-payload-tag? tag) 0
    (if (= tag (tag-symbol)) (gc-root b)
      (do (gc-root a) (gc-root b) (gc-root c) 0)))
  (if (>= (primitive/load (g-live)) (gc-threshold)) (collect) 0)
  (let [fl (primitive/load (g-free))
        addr (if (not (= fl 0))
                 (do (primitive/store! (g-free)
                                       (primitive/load (primitive/field (primitive/cast (ptr Obj) fl) a)))
                     fl)
               (let [cur (primitive/load (g-cur))]
                 (if (< cur (primitive/load (g-end)))
                     (do (primitive/store! (g-cur) (+ cur 40)) cur)
                   (new-slab))))
        o (primitive/cast (ptr Obj) addr)]
    (primitive/store! (primitive/field o tag) tag)
    (primitive/store! (primitive/field o mark) 0)
    (primitive/store! (primitive/field o a) a)
    (primitive/store! (primitive/field o b) b)
    (primitive/store! (primitive/field o c) c)
    (primitive/store! (g-total) (+ (primitive/load (g-total)) 1))
    (primitive/store! (g-live) (+ (primitive/load (g-live)) 1))
    (gc-sp-set! sp)
    addr)))

;; Specialized one-pass chain construction for base-10^9 exact-integer limbs.
;; The caller roots SRC before entering. Collection happens once up front; each
;; cell is then allocated, filled, and linked exactly once, with aggregate
;; accounting after the loop. Keeping this beside the allocator avoids exposing
;; unchecked allocation state to the rest of the Scheme runtime.
(defn allocate-limb-product [(src i64) (n i64) (digit i64) (initial-carry i64)
                             (out-count (ptr i64))] (-> i64)
  (if (>= (+ (primitive/load (g-live)) (+ n 1)) (gc-threshold)) (collect) 0)
  (let [(mut input) src (mut carry) initial-carry
        (mut head) (s-nil) (mut tail) (s-nil) (mut count) 0]
    (loop
      (if (is-null (primitive/load (mut input))) (break)
        (let [p (+ (* (fixnum-value (car (primitive/load (mut input)))) digit)
                   (primitive/load (mut carry)))
              fl (primitive/load (g-free))
              addr (if (not (= fl 0))
                       (do (primitive/store!
                             (g-free)
                             (primitive/load
                               (primitive/field (primitive/cast (ptr Obj) fl) a)))
                           fl)
                     (let [cur (primitive/load (g-cur))]
                       (if (< cur (primitive/load (g-end)))
                           (do (primitive/store! (g-cur) (+ cur 40)) cur)
                         (new-slab))))
              o (primitive/cast (ptr Obj) addr)]
          (primitive/store! (primitive/field o tag) (tag-pair))
          (primitive/store! (primitive/field o mark) 0)
          (primitive/store! (primitive/field o a) (mk-fixnum (% p 1000000000)))
          (primitive/store! (primitive/field o b) (s-nil))
          (primitive/store! (primitive/field o c) 0)
          (if (is-null (primitive/load (mut head)))
              (primitive/store! (mut head) addr)
            (primitive/store!
              (primitive/field (obj-of (primitive/load (mut tail))) b) addr))
          (primitive/store! (mut tail) addr)
          (primitive/store! (mut carry) (/ p 1000000000))
          (primitive/store! (mut input) (cdr (primitive/load (mut input))))
          (primitive/store! (mut count) (+ (primitive/load (mut count)) 1)))))
    (if (not (= (primitive/load (mut carry)) 0))
        (let [fl (primitive/load (g-free))
              addr (if (not (= fl 0))
                       (do (primitive/store!
                             (g-free)
                             (primitive/load
                               (primitive/field (primitive/cast (ptr Obj) fl) a)))
                           fl)
                     (let [cur (primitive/load (g-cur))]
                       (if (< cur (primitive/load (g-end)))
                           (do (primitive/store! (g-cur) (+ cur 40)) cur)
                         (new-slab))))
              o (primitive/cast (ptr Obj) addr)]
          (primitive/store! (primitive/field o tag) (tag-pair))
          (primitive/store! (primitive/field o mark) 0)
          (primitive/store! (primitive/field o a)
                            (mk-fixnum (primitive/load (mut carry))))
          (primitive/store! (primitive/field o b) (s-nil))
          (primitive/store! (primitive/field o c) 0)
          (if (is-null (primitive/load (mut head)))
              (primitive/store! (mut head) addr)
            (primitive/store!
              (primitive/field (obj-of (primitive/load (mut tail))) b) addr))
          (primitive/store! (mut count) (+ (primitive/load (mut count)) 1)))
      0)
    (primitive/store! (g-total) (+ (primitive/load (g-total))
                                   (primitive/load (mut count))))
    (primitive/store! (g-live) (+ (primitive/load (g-live))
                                  (primitive/load (mut count))))
    (primitive/store! out-count (primitive/load (mut count)))
    (primitive/load (mut head))))

; --- constructors -----------------------------------------------------------
(defn cons [(a i64) (d i64)] (-> i64) (allocate (tag-pair) a d 0))
(defn car [(v i64)] (-> i64) (primitive/load (primitive/field (obj-of v) a)))
(defn cdr [(v i64)] (-> i64) (primitive/load (primitive/field (obj-of v) b)))
(defn set-car! [(v i64) (x i64)] (-> i64) (primitive/store! (primitive/field (obj-of v) a) x) 0)
(defn set-cdr! [(v i64) (x i64)] (-> i64) (primitive/store! (primitive/field (obj-of v) b) x) 0)

; --- complex numbers -------------------------------------------------------
;; Rectangular components are ordinary numeric Vals, so exactness is retained
;; independently and the generic marker traces both slots.
(defn make-complex [(real i64) (imag i64)] (-> i64)
  (allocate (tag-complex) real imag 0))
(defn complex-real [(v i64)] (-> i64)
  (primitive/load (primitive/field (obj-of v) a)))
(defn complex-imag [(v i64)] (-> i64)
  (primitive/load (primitive/field (obj-of v) b)))

; --- flonums ---------------------------------------------------------------
;; Store the exact IEEE bits in an atomic object. The tag-aware marker above is
;; what makes arbitrary bit patterns safe here.
(defn f64->raw-bits [(x f64)] (-> i64)
  (primitive/llvm-ir i64 [x] "%r = bitcast double $0 to i64\nret i64 %r"))
(defn raw-bits->f64 [(bits i64)] (-> f64)
  (primitive/llvm-ir f64 [bits] "%r = bitcast i64 $0 to double\nret double %r"))
(defn mk-flonum-bits [(bits i64)] (-> i64)
  (allocate (tag-flonum) bits 0 0))
(defn mk-flonum [(x f64)] (-> i64) (mk-flonum-bits (f64->raw-bits x)))
(defn flonum-value [(v i64)] (-> f64)
  (raw-bits->f64 (primitive/load (primitive/field (obj-of v) a))))
(defn number->f64 [(v i64)] (-> f64)
  (if (is-fixnum v) (primitive/cast f64 (fixnum-value v))
    (if (is-ratnum v)
        (primitive/fdiv (primitive/cast f64 (ratnum-numerator v))
                        (primitive/cast f64 (ratnum-denominator v)))
      (flonum-value v))))

; --- exact rationals -------------------------------------------------------
;; Normalized numerator/denominator fixnums. Their payloads are ordinary Vals,
;; so the generic collector traces them safely without another atomic-tag case.
(defn rat-gcd [(a i64) (b i64)] (-> i64)
  (if (= b 0) a (rat-gcd b (% a b))))
(defn rat-abs [(x i64)] (-> i64) (if (< x 0) (- 0 x) x))
(defn mk-ratnum [(num i64) (den i64)] (-> i64)
  (let [sn (if (< den 0) (- 0 num) num)
        sd (if (< den 0) (- 0 den) den)
        g (rat-gcd (rat-abs sn) sd)
        n (/ sn g)
        d (/ sd g)]
    (if (= d 1) (mk-fixnum n)
      (allocate (tag-ratnum) (mk-fixnum n) (mk-fixnum d) 0))))
(defn ratnum-numerator [(v i64)] (-> i64)
  (fixnum-value (ratnum-numerator-val v)))
(defn ratnum-denominator [(v i64)] (-> i64)
  (fixnum-value (ratnum-denominator-val v)))
(defn ratnum-numerator-val [(v i64)] (-> i64)
  (primitive/load (primitive/field (obj-of v) a)))
(defn ratnum-denominator-val [(v i64)] (-> i64)
  (primitive/load (primitive/field (obj-of v) b)))
(defn exact-numerator [(v i64)] (-> i64)
  (if (is-fixnum v) (fixnum-value v) (ratnum-numerator v)))
(defn exact-denominator [(v i64)] (-> i64)
  (if (is-fixnum v) 1 (ratnum-denominator v)))

; --- statistics -------------------------------------------------------------
(defn gc-live [] (-> i64) (primitive/load (g-live)))
(defn gc-peak [] (-> i64) (primitive/load (g-peak)))
(defn gc-collections [] (-> i64) (primitive/load (g-collections)))
(defn gc-total [] (-> i64) (primitive/load (g-total)))

;; Chez-compatible collector observations. Coil's Scheme collector is a single
;; generation of fixed-size cells, so generation zero is both the minimum and
;; maximum and its byte counts are exact multiples of obj-bytes.
(defn collect-maximum-generation [] (-> i64) (mk-fixnum 0))
(defn bytes-allocated [] (-> i64) (mk-fixnum (* (gc-live) (obj-size))))
(defn current-memory-bytes [] (-> i64) (mk-fixnum (slab-bytes)))
(defn maximum-memory-bytes [] (-> i64) (mk-fixnum 1152921504606846975))
(defn collect-trip-bytes [(n i64)] (-> i64)
  ;; The current collector's threshold is cell-based and static. This remains a
  ;; tuning hint, as it is in Chez, while ordinary collection stays active.
  (let [ignored n] (s-unspecified)))
(defn weak-cons [(a i64) (b i64)] (-> i64)
  ;; Weak edges are not encoded by the precise collector yet; retain strongly.
  ;; This is the documented compatibility degradation used by weak hash tables.
  (cons a b))
