(module coil.scheme.syntax)
(import "coil.primitive" :as primitive)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use [cons car cdr])
(import "coil.scheme.symbol" :use [intern symbol-name])
(import "coil.scheme.stdproc" :use [string-from-slice scm-list->vector scm-vector->list])
(import "coil.scheme.numeric" :as num :use [string-slice])
(extern malloc :cc c [i64] (-> (ptr u8)))

;; Native phase-1 syntax objects. The Scheme-visible value is a normal tagged
;; Val, while its payload retains the exact compiler Code node (including source
;; location and hygiene identity). This is the boundary used by compiled
;; procedural transformers; it is deliberately independent of Jolt and Chez.
(defn syntax-object-from-code [(form Code)] (-> i64)
  ;; Phase wrappers are deliberately outside the runtime Scheme heap. They live
  ;; for one compiler process and point into the compiler-owned Code arena; the
  ;; runtime collector therefore neither owns nor traces them.
  (let [mem (malloc 40)
        raw (primitive/cast i64 mem)
        stx (obj-of raw)]
    (primitive/store! (primitive/field stx tag) (tag-syntax))
    (primitive/store! (primitive/field stx mark) 0)
    (primitive/store! (primitive/field stx a) (primitive/code-opaque form))
    (primitive/store! (primitive/field stx b) 0)
    (primitive/store! (primitive/field stx c) 0)
    raw))

(defn syntax-object-code [(stx i64)] (-> Code)
  (if (not (is-syntax stx))
      (primitive/error "expected a syntax object")
    (primitive/code-from-opaque
      (primitive/load (primitive/field (obj-of stx) a)))))

(defn syntax-object? [(v i64)] (-> i64)
  (mk-bool (is-syntax v)))

(defn syntax-list-items [(form Code) (i i64) (n i64)] (-> i64)
  (if (>= i n) (s-nil)
    (cons (syntax-object-from-code (primitive/code-nth form i))
          (syntax-list-items form (+ i 1) n))))

;; Chez returns #f when STX does not contain a proper list. Coil's reader Code
;; represents only proper lists, so list shape is sufficient here.
(defn syntax->list [(stx i64)] (-> i64)
  (let [form (syntax-object-code stx)]
    (if (or (not (primitive/code-list? form))
            (primitive/code-vector? form))
        (s-false)
      (syntax-list-items form 0 (primitive/code-count form)))))

(defn syntax-datum-list [(form Code) (i i64) (n i64)] (-> i64)
  (if (>= i n) (s-nil)
    (cons (syntax-code->datum (primitive/code-nth form i))
          (syntax-datum-list form (+ i 1) n))))

(defn syntax-code->datum [(form Code)] (-> i64)
  (if (primitive/code-int? form) (mk-fixnum (primitive/code-int form))
    (if (primitive/code-sym? form) (intern (primitive/code-str form))
      (if (primitive/code-string? form) (string-from-slice (primitive/code-str form))
        (if (primitive/code-vector? form)
            (scm-list->vector
              (syntax-datum-list form 0 (primitive/code-count form)))
          (if (primitive/code-list? form)
              (syntax-datum-list form 0 (primitive/code-count form))
            (primitive/error "syntax->datum: unsupported syntax datum")))))))

(defn syntax->datum [(stx i64)] (-> i64)
  (syntax-code->datum (syntax-object-code stx)))

(defn datum-code-items [(datum i64) (proto Code)] (-> Code)
  (if (is-null datum) `()
    `(~(datum-code (car datum) proto)
      ~@(datum-code-items (cdr datum) proto))))

(defn datum-code [(datum i64) (proto Code)] (-> Code)
  (if (is-syntax datum) (syntax-object-code datum)
    (if (is-fixnum datum) `~(fixnum-value datum)
      (if (is-symbol datum)
          (primitive/code-symbol-context proto (symbol-name datum))
        (if (is-string datum) `~(string-slice datum)
          (if (is-pair datum) `(~@(datum-code-items datum proto))
            (if (is-vector datum)
                `#(~@(datum-code-items (scm-vector->list datum) proto))
                (if (val-eq? datum (s-nil)) `()
                  (if (val-eq? datum (s-true)) `#t
                    (if (val-eq? datum (s-false)) `#f
                    (primitive/error "datum->syntax: unsupported datum")))))))))))

(defn datum->syntax [(context i64) (datum i64)] (-> i64)
  (if (not (is-syntax context))
      (primitive/error "datum->syntax: expected syntax-object context")
    (syntax-object-from-code (datum-code datum (syntax-object-code context)))))

(defn syntax? [(v i64)] (-> i64) (syntax-object? v))

;; A successful procedural-pattern match is retained as Code in a syntax-object
;; wrapper. Failure is Scheme #f. Keeping the native binding table intact lets
;; template expansion preserve the exact source and hygiene identity of every
;; captured identifier.
(defn syntax-bindings-from-code [(bindings Code)] (-> i64)
  (if (primitive/code-eq bindings `sr-no-match) (s-false)
    (syntax-object-from-code bindings)))

(defn syntax-object-from-handle [(handle i64)] (-> i64)
  (syntax-object-from-code (primitive/code-from-opaque handle)))

(defn syntax-bindings-from-handle [(handle i64)] (-> i64)
  (syntax-bindings-from-code (primitive/code-from-opaque handle)))

(defn syntax-bindings-append-h [(left Code) (i i64) (n i64)
                                (right Code)] (-> i64)
  (if (>= i n) (primitive/code-opaque right)
    (let [rest (primitive/code-from-opaque
                 (syntax-bindings-append-h left (+ i 1) n right))]
      (primitive/code-opaque `(~(primitive/code-nth left i) ~@rest)))))

(defn syntax-bindings-merge [(left i64) (right i64)] (-> i64)
  (syntax-object-from-handle
    (syntax-bindings-append-h (syntax-object-code left) 0
                              (primitive/code-count (syntax-object-code left))
                              (syntax-object-code right))))

(defn syntax-binding-depth-values [(values Code) (i i64) (n i64)] (-> i64)
  (if (>= i n) (s-nil)
    (cons (syntax-object-from-code (primitive/code-nth values i))
          (syntax-binding-depth-values values (+ i 1) n))))

(defn syntax-binding-at [(bindings i64) (index i64)] (-> i64)
  ;; INDEX is a Scheme fixnum because this function is called by the compiled
  ;; transformer procedure, not by its native Code wrapper.
  (let [raw-index (fixnum-value index)
        bs (syntax-object-code bindings)]
    (if (or (< raw-index 0) (>= raw-index (primitive/code-count bs)))
        (if (= raw-index 0)
            (primitive/error "syntax-case: missing pattern binding at index 0")
          (primitive/error "syntax-case: missing pattern binding after index 0"))
      (let [b (primitive/code-nth bs raw-index)]
        (if (!= (primitive/code-count b) 3)
            (primitive/error "syntax-case: malformed native pattern binding")
          (let [depth (primitive/code-int (primitive/code-nth b 1))
                value (primitive/code-nth b 2)]
            (if (= depth 0) (syntax-object-from-code value)
              (syntax-binding-depth-values value 0
                                            (primitive/code-count value)))))))))

(defn syntax-case-failure [] (-> i64)
  (primitive/error "syntax-case: no matching clause"))

(export syntax-object-from-code syntax-object-code syntax-object?
        syntax? syntax->list syntax->datum datum->syntax
        syntax-object-from-handle syntax-bindings-from-code
        syntax-bindings-from-handle syntax-bindings-merge
        syntax-binding-at syntax-case-failure)
