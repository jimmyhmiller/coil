(module coil.scheme.derived2-test)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.assert" :use *)
(import "coil.control" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.symbol" :use *)
(import "coil.scheme.core" :use *)
(import "coil.scheme.derived2" :use *)

;; These test the four places R5RS's derived forms diverge from the obvious
;; expansion. A happy-path test passes against a wrong implementation for every
;; one of them, so each test below is built around the specific input that
;; separates the correct semantics from the plausible-but-wrong one.

;; Walk a Scheme list into a Coil-side count, so list structure can be asserted
;; without the list chunk's procedures existing yet.
(defn len [(v i64)] (-> i64) (if (pair? v) (+ 1 (len (cdr v))) 0))
(defn nth [(v i64) (i i64)] (-> i64) (if (= i 0) (car v) (nth (cdr v) (- i 1))))
;; The tail past the last pair: nil for a proper list, the atom for a dotted one.
(defn tail-of [(v i64)] (-> i64) (if (pair? v) (tail-of (cdr v)) v))

; ---- letrec -----------------------------------------------------------------

(deftest letrec-binds-before-evaluating
  ;; The property that distinguishes letrec from let*: a LATER binding is already
  ;; IN SCOPE while an EARLIER init runs. Under `let*` this would not compile at
  ;; all — `b` would be an unbound name — so the fact that `a`'s init can mention
  ;; `b` is itself the test. It reads the hole, because b's init has not run yet.
  (letrec [(a b)
           (b (mk-fixnum 7))]
    (assert (undefined? a))
    (assert-eq (fixnum-value b) 7)))

(deftest letrec-inits-run-left-to-right
  ;; letrec* semantics, which this expansion also provides: `b`'s init sees `a`
  ;; already assigned, so it is a real value and not the hole.
  (letrec [(a (mk-fixnum 3))
           (b (mk-fixnum (+ (fixnum-value a) 1)))]
    (assert-eq (fixnum-value b) 4)))

(deftest letrec-hole-is-detectable
  ;; The hole must never leak silently — a program that reads a letrec variable
  ;; before its init has run has to be able to tell.
  (letrec [(x y)
           (y (mk-fixnum 1))]
    (assert (letrec-hole? x))
    (assert (not (letrec-hole? y)))))

(deftest letrec-init-can-reference-any-binding
  ;; Every name is in scope for every init, not just the ones before it. This is
  ;; the shape mutual recursion needs: `f`'s init mentions `g`, which is defined
  ;; after it. Without a lambda to defer the reference the value read is the hole,
  ;; but the SCOPING — which is what letrec provides — is what is asserted here.
  (letrec [(f g)
           (g h)
           (h (mk-fixnum 1))]
    (assert (undefined? f))
    (assert (undefined? g))
    (assert-eq (fixnum-value h) 1)))

(deftest letrec-body-sees-final-values
  (letrec [(a (mk-fixnum 10)) (b (mk-fixnum 20))]
    (assert-eq (+ (fixnum-value a) (fixnum-value b)) 30)))

; ---- do ---------------------------------------------------------------------

(deftest do-counts-and-returns-result
  (assert-eq (fixnum-value
               (scm-do ((i (mk-fixnum 0) (mk-fixnum (+ (fixnum-value i) 1))))
                       ((scm-num-eq i (mk-fixnum 5)) i)))
             5))

(deftest do-steps-are-parallel-not-sequential
  ;; THE test for `do`. `acc`'s step mentions `i`, so a sequential update — store
  ;; i, then compute acc from the new i — conses 1,2,3,4,5 instead of 0,1,2,3,4.
  ;; R5RS evaluates every step before rebinding any, so `acc` must see the value
  ;; `i` had at the TOP of the iteration.
  (let [r (scm-do ((i (mk-fixnum 0) (mk-fixnum (+ (fixnum-value i) 1)))
                   (acc (s-nil) (cons i acc)))
                  ((scm-num-eq i (mk-fixnum 5)) acc))]
    (assert-eq (len r) 5)
    ; built by consing, so it comes out reversed: 4 3 2 1 0
    (assert-eq (fixnum-value (nth r 0)) 4)
    (assert-eq (fixnum-value (nth r 4)) 0)))

(deftest do-with-zero-iterations
  ;; The test is checked BEFORE the body, so a loop whose test is true at entry
  ;; runs its body zero times.
  (let [(mut n) 0]
    (let [r (scm-do ((i (mk-fixnum 0) (mk-fixnum (+ (fixnum-value i) 1))))
                    ((scm-num-eq i (mk-fixnum 0)) (mk-fixnum 99))
                    (primitive/store! (mut n) (+ (primitive/load (mut n)) 1)))]
      (assert-eq (fixnum-value r) 99)
      (assert-eq (primitive/load (mut n)) 0))))

(deftest do-variable-without-step-is-held
  ;; A two-element spec `(var init)` has no step, and R5RS keeps the value.
  (assert-eq (fixnum-value
               (scm-do ((i (mk-fixnum 0) (mk-fixnum (+ (fixnum-value i) 1)))
                        (k (mk-fixnum 42)))
                       ((scm-num-eq i (mk-fixnum 3)) k)))
             42))

(deftest do-body-runs-each-iteration
  (let [(mut n) 0]
    (scm-do ((i (mk-fixnum 0) (mk-fixnum (+ (fixnum-value i) 1))))
            ((scm-num-eq i (mk-fixnum 4)) (s-nil))
            (primitive/store! (mut n) (+ (primitive/load (mut n)) 1)))
    (assert-eq (primitive/load (mut n)) 4)))

(deftest do-empty-result-is-unspecified
  ;; `(do (…) (test))` — no result expressions — is unspecified, NOT the test's
  ;; own value.
  (let [r (scm-do ((i (mk-fixnum 0) (mk-fixnum (+ (fixnum-value i) 1))))
                  ((scm-num-eq i (mk-fixnum 2))))]
    (assert (val-eq? r (s-unspecified)))))

; ---- case -------------------------------------------------------------------

(deftest case-selects-the-matching-clause
  (assert (val-eq? (scm-case (mk-fixnum 3)
                     ((1 2) (intern "low"))
                     ((3 4) (intern "mid"))
                     (else (intern "high")))
                   (intern "mid"))))

(deftest case-falls-through-to-else
  (assert (val-eq? (scm-case (mk-fixnum 9)
                     ((1 2) (intern "low"))
                     (else (intern "high")))
                   (intern "high"))))

(deftest case-without-else-is-unspecified
  ;; R5RS: no clause matches and there is no else, so the value is unspecified.
  (assert (val-eq? (scm-case (mk-fixnum 9) ((1 2) (intern "low")))
                   (s-unspecified))))

(deftest case-key-is-evaluated-once
  ;; The key goes into a temporary. Comparing it against each datum by
  ;; re-evaluating the key expression would run a side effect once per datum.
  (let [(mut n) 0]
    (scm-case (do (primitive/store! (mut n) (+ (primitive/load (mut n)) 1))
                  (mk-fixnum 5))
      ((1 2 3 4) (s-false))
      ((5) (s-true))
      (else (s-false)))
    (assert-eq (primitive/load (mut n)) 1)))

(deftest case-matches-symbols-by-identity
  ;; Symbols are interned, so eqv? on them is an id compare — a datum symbol in a
  ;; case clause has to intern to the same object as the key.
  (assert (val-eq? (scm-case (intern "b")
                     ((a) (mk-fixnum 1))
                     ((b c) (mk-fixnum 2))
                     (else (mk-fixnum 3)))
                   (mk-fixnum 2))))

(deftest case-uses-eqv-not-equal
  ;; The distinction the cases README documents. Two separately-allocated pairs
  ;; are `equal?` but not `eqv?`, so a case key that is a fresh pair must NOT
  ;; match a datum list — an implementation built on structural comparison would
  ;; wrongly match here.
  (let [k (cons (mk-fixnum 1) (s-nil))]
    (assert (val-eq? (scm-case k
                       (((1)) (intern "matched"))
                       (else (intern "not-matched")))
                     (intern "not-matched")))))

; ---- delay / force ----------------------------------------------------------

;; A counter the delayed expressions below bump, so "ran exactly once" is
;; observable. It is a global because the thunk is a top-level function and
;; cannot close over a local.
(defn side-effects [] (-> (ptr i64)) (alloc/static i64))

(define-promise p-simple (mk-fixnum 42))
(define-promise p-effect
  (do (primitive/store! (side-effects) (+ (primitive/load (side-effects)) 1))
      (mk-fixnum 42)))
;; Used by exactly one test, which needs it still unforced so it can trace an
;; unforced promise through a real collection. Forcing this anywhere else would
;; silently turn that test into a no-op.
(define-promise p-uncollected (mk-fixnum 7))

(deftest force-returns-the-value
  (assert (promise? (p-simple)))
  (assert-eq (fixnum-value (force (p-simple))) 42))

(deftest force-memoizes
  ;; THE test for promises. The delayed expression has a side effect, and forcing
  ;; repeatedly must run it ONCE — this is what the conformance case pins down by
  ;; printing (42 42) from a single evaluation.
  ;;
  ;; Referencing the promise does NOT evaluate it: the counter is still 0 after
  ;; `(p-effect)` hands back the object.
  (let [p (p-effect)]
    (assert (promise? p))
    (assert-eq (primitive/load (side-effects)) 0)
    (assert-eq (fixnum-value (force p)) 42)
    (assert-eq (primitive/load (side-effects)) 1)
    (assert-eq (fixnum-value (force p)) 42)
    (assert-eq (fixnum-value (force p)) 42)
    (assert-eq (primitive/load (side-effects)) 1)
    ; and forcing it through a FRESH reference to the same promise still does not
    ; re-run it — memoization is on the value, not the call site
    (assert-eq (fixnum-value (force (p-effect))) 42)
    (assert-eq (primitive/load (side-effects)) 1)))

(deftest promise-is-stable-across-references
  ;; `(p-simple)` must hand back the SAME object every time, or each reference
  ;; would get a fresh unforced promise and memoization would be meaningless.
  (assert (val-eq? (p-simple) (p-simple))))

(deftest promise-is-not-forced-until-forced
  (let [p (p-simple)]
    ; p-simple may already have been forced by another test in this process, so
    ; assert the transition rather than the initial state
    (force p)
    (assert (promise-forced? p))))

(deftest force-on-a-non-promise-passes-through
  (assert-eq (fixnum-value (force (mk-fixnum 5))) 5))

(deftest unforced-promise-survives-a-collection
  ;; An unforced promise holds a CODE ADDRESS in its `a` slot, and the collector
  ;; traces all three slots of every object. Its test for "traceable" is the low
  ;; three bits being zero, which a raw 8-byte-aligned code address passes — so a
  ;; raw address makes `mark` cast the text segment to an `Obj` and write a mark
  ;; bit into it. That is a SIGSEGV, not a near miss.
  ;;
  ;; `p-uncollected` is forced nowhere else, so it is genuinely unforced when the
  ;; collection below runs. Rooting it and calling `collect` is exactly the path
  ;; that crashed before the thunk address was stored tagged.
  (let [p (p-uncollected)]
    (assert (not (promise-forced? p)))
    (gc-root p)
    (collect)
    ; survived the trace, and the thunk address still round-trips to a callable
    (assert-eq (fixnum-value (force p)) 7)
    (assert (promise-forced? p))))

; ---- quasiquote -------------------------------------------------------------

(deftest quasiquote-plain-datum-is-a-list
  (let [r (scm-quasiquote (a b c))]
    (assert-eq (len r) 3)
    (assert (val-eq? (nth r 0) (intern "a")))
    (assert (val-eq? (nth r 2) (intern "c")))))

(deftest quasiquote-unquote-evaluates
  (let [n (mk-fixnum 5)]
    (let [r (scm-quasiquote (a b (unquote n)))]
      (assert-eq (len r) 3)
      (assert (val-eq? (nth r 0) (intern "a")))
      (assert-eq (fixnum-value (nth r 2)) 5))))

(deftest quasiquote-splices
  (let [xs (cons (mk-fixnum 1) (cons (mk-fixnum 2) (s-nil)))]
    (let [r (scm-quasiquote (a (unquote-splicing xs) b))]
      (assert-eq (len r) 4)
      (assert (val-eq? (nth r 0) (intern "a")))
      (assert-eq (fixnum-value (nth r 1)) 1)
      (assert-eq (fixnum-value (nth r 2)) 2)
      (assert (val-eq? (nth r 3) (intern "b"))))))

(deftest quasiquote-splices-empty-list
  ;; `(1 ,@'() 2)` is (1 2) — an empty splice must contribute nothing rather
  ;; than a nil element.
  (let [r (scm-quasiquote (1 (unquote-splicing (s-nil)) 2))]
    (assert-eq (len r) 2)
    (assert-eq (fixnum-value (nth r 0)) 1)
    (assert-eq (fixnum-value (nth r 1)) 2)))

(deftest quasiquote-splice-does-not-mutate-its-source
  ;; The splice appends, so the list it was handed must come back unchanged. A
  ;; destructive append would corrupt a list that is spliced twice.
  (let [xs (cons (mk-fixnum 1) (cons (mk-fixnum 2) (s-nil)))]
    (scm-quasiquote ((unquote-splicing xs) tail))
    (assert-eq (len xs) 2)
    (assert (null? (cdr (cdr xs))))))

(deftest quasiquote-splices-into-a-dotted-tail
  ;; `(,@(list 1 2) . 3)` is (1 2 . 3). The last splice must cons onto the TAIL
  ;; rather than terminate with nil — the failure mode is a proper list (1 2)
  ;; with the 3 dropped.
  (let [xs (cons (mk-fixnum 1) (cons (mk-fixnum 2) (s-nil)))]
    (let [r (scm-quasiquote ((unquote-splicing xs) . 3))]
      (assert-eq (len r) 2)
      (assert-eq (fixnum-value (nth r 0)) 1)
      (assert-eq (fixnum-value (nth r 1)) 2)
      ; the improper tail is the 3 itself, not nil
      (assert (not (null? (tail-of r))))
      (assert-eq (fixnum-value (tail-of r)) 3))))

(deftest quasiquote-dotted-tail-without-splice
  (let [n (mk-fixnum 9)]
    (let [r (scm-quasiquote (1 . (unquote n)))]
      (assert-eq (len r) 1)
      (assert-eq (fixnum-value (nth r 0)) 1)
      (assert-eq (fixnum-value (tail-of r)) 9))))

(deftest quasiquote-nesting-keeps-inner-unquote-as-data
  ;; THE test for level tracking. In ``(a `(b ,(c ,n)))`` the inner quasiquote
  ;; raises the level, so `,(c ...)` is DATA — it must appear in the output as a
  ;; two-element list whose head is the symbol `unquote` — while the `,n` inside
  ;; it has descended back to level 1 and DOES evaluate.
  ;;
  ;; The expected structure is
  ;;   (a (quasiquote (b (unquote (c (unquote n))))))
  ;; with only the innermost n replaced by its value.
  (let [n (mk-fixnum 5)]
    (let [r (scm-quasiquote (a (quasiquote (b (unquote (c (unquote n)))))))]
      (assert-eq (len r) 2)
      (assert (val-eq? (nth r 0) (intern "a")))
      (let [q (nth r 1)]
        ; (quasiquote <inner>) — the symbol survived as data
        (assert-eq (len q) 2)
        (assert (val-eq? (nth q 0) (intern "quasiquote")))
        (let [inner (nth q 1)]
          ; (b <unquote-form>)
          (assert-eq (len inner) 2)
          (assert (val-eq? (nth inner 0) (intern "b")))
          (let [u (nth inner 1)]
            ; (unquote (c 5)) — the unquote symbol is data, but n evaluated
            (assert-eq (len u) 2)
            (assert (val-eq? (nth u 0) (intern "unquote")))
            (let [cform (nth u 1)]
              (assert-eq (len cform) 2)
              (assert (val-eq? (nth cform 0) (intern "c")))
              ; the innermost unquote came back down to level 1: this is a VALUE
              (assert-eq (fixnum-value (nth cform 1)) 5))))))))

(deftest quasiquote-nested-splice-stays-data
  ;; A splice below level 1 is data too, and keeps its own symbol.
  (let [r (scm-quasiquote (quasiquote ((unquote-splicing x))))]
    (assert-eq (len r) 2)
    (assert (val-eq? (nth r 0) (intern "quasiquote")))
    (let [inner (nth r 1)]
      (assert-eq (len inner) 1)
      (let [s (nth inner 0)]
        (assert-eq (len s) 2)
        (assert (val-eq? (nth s 0) (intern "unquote-splicing")))))))

(deftest quasiquote-literals
  ;; #t/#f/() read as symbols but must become the singletons, not interned names.
  (let [r (scm-quasiquote (#t #f ()))]
    (assert-eq (len r) 3)
    (assert (val-eq? (nth r 0) (s-true)))
    (assert (val-eq? (nth r 1) (s-false)))
    (assert (null? (nth r 2)))))

(deftest quasiquote-nested-list-structure
  (let [r (scm-quasiquote (a (b c) d))]
    (assert-eq (len r) 3)
    (let [sub (nth r 1)]
      (assert-eq (len sub) 2)
      (assert (val-eq? (nth sub 0) (intern "b"))))))

(deftest quasiquote-empty-is-nil
  (assert (null? (scm-quasiquote ()))))

(deftest append-is-non-destructive
  (let [xs (cons (mk-fixnum 1) (s-nil))
        ys (cons (mk-fixnum 2) (s-nil))]
    (let [r (d2-append xs ys)]
      (assert-eq (len r) 2)
      ; xs is untouched, and the result's tail IS ys (append shares the tail)
      (assert-eq (len xs) 1)
      (assert (val-eq? (cdr r) ys)))))
