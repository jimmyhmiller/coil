(module coil.scheme.closure)
(import "coil.primitive" :as primitive)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)

;; The representation layer shared by closure conversion and dynamic procedure
;; dispatch. Keeping it below both modules avoids a dependency cycle and lets
;; generated calls retain ordinary referential hygiene.
;;
;; A closure stores a tagged native code pointer in `a`, its traced environment
;; list in `b`, and a tagged arity in `c`. Raw words may not occupy traced slots.
(defn make-closure [(code i64) (env i64) (arity i64)] (-> i64)
  (allocate (tag-closure) (mk-fixnum code) env (mk-fixnum arity)))
(defn closure-code [(v i64)] (-> i64)
  (fixnum-value (primitive/load (primitive/field (obj-of v) a))))
(defn closure-env [(v i64)] (-> i64)
  (primitive/load (primitive/field (obj-of v) b)))
(defn closure-arity [(v i64)] (-> i64)
  (fixnum-value (primitive/load (primitive/field (obj-of v) c))))

(export make-closure closure-code closure-env closure-arity)
