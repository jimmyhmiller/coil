; A macro that branches on the target: `target-arch` is a compile-time value, so
; one macro can emit a different `defcc` per architecture. These conventions are
; native (`cc/Native`), so only the selection matters here; a `cc/Shim` convention would make
; the registers load-bearing (see shim.coil).
;   coil run src/examples/per-arch.coil; echo $?   => 42
(module example.per-arch)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(defn def-arch-cc [(name Code)] (-> Code)
  (match (target-arch)
    (X86_64 []
            `(defcc ~name
                    :params
                    [rax rdx]
                    :ret
                    rax
                    :clobber
                    [rax rdx rcx]
                    :lower
                    (cc/Native (cc/Fast))))
    (Aarch64 []
             `(defcc ~name
                     :params
                     [x0 x1]
                     :ret
                     x0
                     :clobber
                     [x0 x1 x2]
                     :lower
                     (cc/Native (cc/Fast))))
    (_ (primitive/error "def-arch-cc: this convention names x86_64 or aarch64 registers"))))

(def-arch-cc platform-fast)

(defn add :cc platform-fast [(a i64) (b i64)] (-> i64)
  (+ a b))

(defn main [] (-> i64)
  (add 20 22))
