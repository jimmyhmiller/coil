; A macro that branches on the target: `target-arch` is a compile-time value, so
; one macro can emit a different `defcc` per architecture. These conventions are
; `:native`, so only the selection matters here; a `:shim` convention would make
; the registers load-bearing (see shim.coil).
;   coil run src/examples/per-arch.coil; echo $?   => 42
(module example.per-arch)
(import "coil.primitive" :as primitive)

(defn def-arch-cc [(name Code)] (-> Code)
  (if (= (primitive/target-arch) `x86_64)
      `(defcc ~name
              :params
              [rax rdx]
              :ret
              rax
              :clobber
              [rax rdx rcx]
              :native
              fast)
      `(defcc ~name :params [x0 x1] :ret x0 :clobber [x0 x1 x2] :native fast)))

(def-arch-cc platform-fast)

(defn add :cc platform-fast [(a i64) (b i64)] (-> i64)
  (+ a b))

(defn main [] (-> i64)
  (add 20 22))
