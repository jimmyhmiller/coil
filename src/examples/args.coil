; Command-line arguments: `main` may take C's argc/argv.
;   coil build src/examples/args.coil -o /tmp/args && /tmp/args one two three
(module example.args)

(extern puts :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (for i
    (range 0 (cast i64 argc))
    (puts (load (index argv i))))
  0)
