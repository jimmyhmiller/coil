; `defer` guards the rest of the body it is written in: its cleanup runs, last
; registered first, however control leaves -- here an early `return-from` out of
; a `scope`, which is a `block` to hang defers on.
;   coil run src/examples/defer.coil; echo $?   => 42
(module example.defer)

(defn main [] (-> i64)
  (let [(mut n) 0]
    (scope :s
           (defer (set! n (+ n 2)))  ; registered first, runs last:  40 -> 42
           (defer (set! n (* n 2)))  ; registered second, runs first: 20 -> 40
           (set! n 20)
           (return-from :s 0))
    n))
