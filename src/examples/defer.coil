; `scope` and `defer`: cleanups run in reverse order when the scope exits,
; including an early exit through `return-from`. Both are library macros.
;   coil run src/examples/defer.coil; echo $?   => 42
(module example.defer)

(defn main [] (-> i64)
  (let [(mut n) 0]
    (scope :s
           (defer (set! n (+ n 2)))  ; registered first, runs last:  40 -> 42
           (defer (set! n (* n 2)))  ; registered second, runs first: 20 -> 40
           (set! n 20)
           (return-from :s 0))
    n))
