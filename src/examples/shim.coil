; A calling convention LLVM cannot express: integer arguments pinned to registers
; the C conventions would not use. `:lower (cc/Shim)` realizes it with a naked
; trampoline and register-constrained call sites.
;   coil run src/examples/shim.coil; echo $?   => 42
;   coil emit-ir src/examples/shim.coil          => the trampoline and inline asm
;
; Shim registers are load-bearing, so the macro picks them per target:
;   x86_64:  arguments in rax/rdx (not SysV's rdi/rsi), result in rax
;   aarch64: arguments in x9/x10 (not AAPCS64's x0/x1), result in x9
; Swapping the argument registers would turn 42 into -42.
(module example.shim)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(defn def-reg2 [(name Code)] (-> Code)
  (match (target-arch)
    (X86_64 []
            `(defcc ~name
                    :params
                    [rax rdx]
                    :ret
                    rax
                    :clobber
                    [rax rdx rcx rsi rdi r8 r9 r10 r11]
                    :lower
                    (cc/Shim)))
    (Aarch64 []
             `(defcc ~name
                     :params
                     [x9 x10]
                     :ret
                     x9
                     :clobber
                     ; every register an AAPCS64 function may change, which the body,
                     ; compiled for C, does; outside Darwin that includes x18
                     ~(match (target-os)
                        (Darwin [] `[x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17])
                        (_ `[x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17 x18]))
                     :lower
                     (cc/Shim)))
    (_ (primitive/error "def-reg2: a :shim convention names x86_64 or aarch64 registers"))))

(def-reg2 reg2)

(defn sub2 :cc reg2 [(a i64) (b i64)] (-> i64)
  (- a b))

(defn main [] (-> i64)
  (let [x (+ 40 10)]  ; computed, so the register placement is real
    (sub2 x 8)))
