; One program touching every major feature. Each `feat-*` returns a value that
; `main` checks; the first failing check's number (1..24) becomes the exit code,
; so the exit code names the broken feature. Success exits 42, after some output
; from the I/O and C demos.
;   coil run src/examples/everything.coil; echo $?   => 42
(module example.everything)
(import "coil.primitive" :as primitive)
(import "coil.alloc"
        :use
        [Allocator malloc-allocator arena-allocator box box! destroy])
(import "coil.io"
        :use
        [Writer
         IoError
         FixBuf
         fixed-buffer-writer
         print-str
         print-int
         write-byte
         write-all
         stdout])
(import "coil.closure" :use [defclosure])

(extern printf :cc c [(ptr i8) ...] (-> i32))  ; variadic

(extern putchar :cc c [i64] (-> i64))

(extern puts :cc c [(ptr i8)] (-> i32))

(extern strlen :cc c [(ptr i8)] (-> i64))

(extern div [i32 i32] (-> DivT))  ; returns a struct by value

; ---- types ------------------------------------------------------------------
(defstruct Point [(x i64) (y i64)])

(defstruct Rect [(lo Point) (hi Point)])  ; nested structs, by value

(defstruct DivT [(quot i32) (rem i32)])  ; libc div_t

(defstruct Pair [A B] [(fst A) (snd B)])  ; generic

(defstruct Px [(r u8) (g u8)])  ; narrow integer fields

(defstruct Flags [(on bool) (off bool)])

(defsum Shape
  (Circle [(r i64)])
  (Rect2 [(w i64) (h i64)]))

; Layout control, pinned down with static-assert.
(defstruct Header :layout packed
  [(magic u16) (version u8) (flags u8) (length u32)])

(static-assert (= (sizeof Header) 8) "packed header is 8 bytes")

(static-assert (= (offsetof Header length) 4) "length at byte 4")

(defstruct Line :layout (align 16) [(a i64) (b i64)])  ; over-aligned

(static-assert (= (alignof i64) 8) "i64 aligns to 8")

(defstruct Reg :layout explicit :size 16 :align 8
  [(status u32 :at 0)
   (sbytes (array u8 4) :at 0)  ; the same offset as status: a union
   (data i64 :at 8)])

(static-assert (= (sizeof Reg) 16) "Reg is 16 bytes")

(static-assert (= (offsetof Reg data) 8) "data at byte 8")

(defstruct Rgb565 :layout bits :backing i16
  [(b :bits 5) (g :bits 6) (r :bits 5)])

(static-assert (= (sizeof Rgb565) 2) "RGB565 packs into 16 bits")

; ---- macros -----------------------------------------------------------------
(defn inc1 [(x Code)] (-> Code)
  `(+ ~x 1))

;;; Variadic and recursive; a lone trailing clause is the else branch.
(defn cond2 [& (clauses Code)] (-> Code)
  (cond (= (len clauses) 0) `0
        (= (len clauses) 1) (get clauses 0)
        :else
          (let [[test then & more] clauses]
            `(if ~test ~then (cond2 ~@more)))))

(defn pow-form [(x Code) (n i64)] (-> Code)
  (if (= n 0) `1 `(* ~x ~(pow-form x (- n 1)))))

(defn pow2 [(x Code) (n Code)] (-> Code)
  (pow-form x (primitive/code-int n)))

(defn dbl [(x Code)] (-> Code)
  `(let [t ~x] (+ t t)))  ; hygienic: `t` cannot capture a caller's `t`

(defn defconst [(name Code) (v Code)] (-> Code)
  `(defn ~name [] (-> i64)
     ~v))

(defconst three 3)

; ---- calling conventions ----------------------------------------------------
;;; `:native fast` lowers to LLVM's fastcc.
(defcc fast2
  :params [rax rdx]
  :ret rax
  :clobber [rax rdx rcx]
  :preserve [rbx rbp]
  :native fast)

(defn cadd :cc fast2 [(a i64) (b i64)] (-> i64)
  (+ a b))

;;; `:lower shim` pins arguments to registers LLVM's conventions cannot express,
;;; so the registers are chosen per target.
(defn def-shimcc [(name Code)] (-> Code)
  (if (= (primitive/target-arch) `x86_64)
      `(defcc ~name
              :params
              [rax rdx]
              :ret
              rax
              :clobber
              [rax rdx rcx rsi rdi r8 r9 r10 r11]
              :lower
              shim)
      `(defcc ~name
              :params
              [x9 x10]
              :ret
              x9
              :clobber
              [x9 x10 x11 x12 x13 x14 x15]
              :lower
              shim)))

(def-shimcc shimcc)

(defn ssub :cc shimcc [(a i64) (b i64)] (-> i64)
  (- a b))

; ---- the features -----------------------------------------------------------
;; 1. Recursion on the C convention.
(defn fib :cc c [(n i64)] (-> i64)
  (if (<= n 1) n (+ (fib (- n 1)) (fib (- n 2)))))

(defn feat-fib [] (-> i64)
  (fib 10))  ; 55

;; 2. A user convention lowered to fastcc.
(defn feat-conv [] (-> i64)
  (cadd 20 22))

;; 3. A shim convention chosen per architecture.
(defn feat-shim [] (-> i64)
  (let [x (+ 40 10)] (ssub x 8)))

;; 4. Where memory comes from: heap box, static storage, frame local.
(defn feat-alloc [] (-> i64)
  (let [heap (box! (malloc-allocator) i64 10)
        global (primitive/alloc-static i64)
        (mut local) 2]
    (store! global 30)
    (let [sum (+ (load heap) (+ (load global) local))]
      (destroy (malloc-allocator) heap)
      sum)))

;; 5. The same code under two allocators.
(defn boxed-add [(a (dyn Allocator)) (x i64) (y i64)] (-> i64)
  (match (box a i64 (+ x y))
    (None [] 0)
    (Some [p] (let [v (load p)] (destroy a p) v))))

(defn feat-allocators [] (-> i64)
  (+ (boxed-add (malloc-allocator) 30 5) (boxed-add (arena-allocator 1024) 5 2)))

;; 6. Output through a Writer value, into an allocator-owned buffer, then stdout.
(defn greet [(w (ptr Writer)) (n i64)] (-> (Result i64 IoError))
  (print-str w "answer=")
  (print-int w n)
  (write-byte w #\newline))

(defn feat-io [] (-> i64)
  (let [a (malloc-allocator)
        storage (box! a (array i8 64) (zeroed (array i8 64)))
        buffer
          (box! a
                FixBuf
                (FixBuf
                  :data (cast (ptr i8) storage)
                  :len 0
                  :cap 64))
        writer (box! a Writer (zeroed Writer))]
    (greet (fixed-buffer-writer writer buffer) 42)
    (match (write-all (stdout) (.data buffer) (.len buffer))
      (Ok [_] 42)
      (Err [_] 1))))

;; 7. C interop: variadic printf, putchar, C string literals.
(defn feat-extern [] (-> i64)
  (printf c"coil: %d+%d=%d (%s)\n" 20 22 42 c"ok")
  (putchar #\!)
  (putchar #\newline)
  42)

;; 8. A struct returned by value across the C ABI.
(defn feat-structabi [] (-> i64)
  (let [d (div 47 5)]  ; {9, 2}
    (+ (* (cast i64 (.quot d)) 10) (cast i64 (.rem d)))))  ; 92

;; 9. Floats: arithmetic, ordered comparison, float <-> int conversion.
(defn feat-floats [] (-> i64)
  (let [base (* 3.0 14.0)
        adjust (+ (- 5.0 5.0) (/ 0.0 2.0))]
    (if (and (< 1.5 2.5) (>= (primitive/frem 85.0 43.0) 41.0))
        (cast i64 (cast f32 (+ base adjust)))  ; f64 -> f32 -> i64
        0)))

;; 10. Bitwise and shift operators; shifts follow the operand's signedness.
(defn feat-bitwise [] (-> i64)
  (let [hi (& 255 (| (<< 1 5) 8))  ; 40
        lo (^ 3 1)  ; 2
        shifted (cast i64 (primitive/ishr (cast u8 200) 2))  ; logical on u8: 50
        inverted
          (cast i64 (primitive/iand (cast u8 255) (primitive/inot (cast u8 7))))]  ; 248
    (+ (- (+ hi lo) (- shifted 50)) (- inverted 248))))

;; 11. bool: short-circuiting and/or/not; comparisons return bool.
(defn feat-bool [] (-> i64)
  (let [f (Flags :on true :off false)]
    (if (and (.on f) (not (.off f)))
        (if (or false true) 42 0)
        0)))

;; 12. Arbitrary-width integers with unsigned semantics.
(defn feat-widths [] (-> i64)
  (let [a (cast u8 200)
        b (cast u8 50)]
    (+ (* (cast i64 (/ a b)) 10) (cast i64 (cast u2 6)))))  ; 40 + 2

;; 13. Literals take the width of their context.
(defn channel [(base u8)] (-> u8)
  (+ base 1))  ; this 1 is a u8

(defn feat-inference [] (-> i64)
  (let [px (Px :r 40 :g (channel 1))]
    (+ (cast i64 (.r px)) (cast i64 (.g px)))))

;; 14. Structs and arrays.
(defn feat-structs [] (-> i64)
  (let [(mut p) (Point :x 0 :y 4)
        (mut a) [1 2 0]]
    (set! (.x p) 30)
    (set! (mut a) 2 5)
    (+ (+ (.x p) (.y p)) (+ (get a 0) (+ (get a 1) (get a 2))))))

;; 15. References: immutable by default, `(mut T)` to write, `(mut place)` to lend.
(defn rect-area [(r Rect)] (-> i64)
  (* (- (.x (.hi r)) (.x (.lo r)))
     (- (.y (.hi r)) (.y (.lo r)))))

(defn translate! [(p (mut Point)) (dx i64) (dy i64)] (-> void)
  (set! (.x p) (+ (.x p) dx))
  (set! (.y p) (+ (.y p) dy)))

(defn feat-refs [] (-> i64)
  (let [(mut r)
          (Rect
            :lo (Point :x 0 :y 0)
            :hi (Point :x 5 :y 5))]
    (translate! (mut (.hi r)) 1 2)
    (rect-area r)))  ; 6 * 7

;; 16. Generics, monomorphized, with inferred type arguments.
(defn id [T] [(x T)] (-> T)
  x)

(defn pair-sum [(T Add)] [(p (Pair T T))] (-> T)
  (+ (.fst p) (.snd p)))

(defn feat-generics [] (-> i64)
  (pair-sum (Pair :fst (id 40) :snd 2)))

;; 17. Sum types and match.
(defn area [(s Shape)] (-> i64)
  (match s
    (Circle [r] (* 3 (* r r)))
    (Rect2 [w h] (* w h))))

(defn feat-sum [] (-> i64)
  (+ (area (Circle 2)) (area (Rect2 5 6))))  ; 12 + 30

;; 18. Closures from the `defclosure` library macro.
(defclosure adder [(n i64)] [(x i64)] i64 (+ n x))

(defclosure scaler [(k i64)] [(x i64)] i64 (* k x))

(defn feat-closure [] (-> i64)
  (let [add5 (adder-new 5)
        triple (scaler-new 3)
        result (+ (adder-call add5 37) (- (scaler-call triple 14) 42))]
    (adder-free add5)
    (scaler-free triple)
    result))

;; 19. Function pointers in a dispatch table.
(defn op-add [(a i64) (b i64)] (-> i64)
  (+ a b))

(defn op-mul [(a i64) (b i64)] (-> i64)
  (* a b))

(defn feat-vtable [] (-> i64)
  (let [table [(fnptr-of op-add) (fnptr-of op-mul)]]
    (+ (call-ptr (get table 0) 20 20)  ; 40
       (call-ptr (get table 1) 1 2))))  ; 2

;; 20. Bitfields, read and written by value through a pointer.
(defn feat-bits [] (-> i64)
  (let [c (primitive/alloc-stack Rgb565)]
    (store! c (zeroed Rgb565))
    (primitive/bit-set! c r 20)
    (primitive/bit-set! c g 10)
    (primitive/bit-set! c b 12)
    (+ (cast i64 (primitive/bit-get c r))
       (+ (cast i64 (primitive/bit-get c g)) (cast i64 (primitive/bit-get c b))))))

;; 21. Explicit layout: a union read through overlapping fields.
(defn feat-explicit [] (-> i64)
  (let [(mut reg) (zeroed Reg)]
    (set! (.status reg) 2)
    (set! (.data reg) 40)
    (+ (cast i64 (get (.sbytes reg) 0)) (.data reg))))  ; the low byte of status is 2

;; 22. Packed and over-aligned layouts.
(defn feat-packed [] (-> i64)
  (let [h
          (Header
            :magic 0
            :version 2
            :flags 0
            :length 40)
        line (Line :a 0 :b 0)]
    (+ (+ (cast i64 (.length h)) (cast i64 (.version h))) (.a line))))

;; 23. The macros above, together.
(defn classify [(n i64)] (-> i64)
  (cond2 (< n 0) 100 (= n 0) 200 300))

(defn feat-macros [] (-> i64)
  (if (= (classify 0) 200)
      (+ (pow2 (three) 3) (dbl (inc1 6)))  ; 27 + 14
      0))

;; 24. Pointers: C strings, sizeof, null, pointer comparison.
(defn feat-ptr [] (-> i64)
  (let [values [10 19]
        null (cast (ptr i8) 0)]
    (+ (sizeof i64)  ; 8
       (+ (strlen c"coil")  ; 4
          (+ (if (= null (cast (ptr i8) 0)) 1 0)  ; 1
             (+ (get values 0) (get values 1)))))))  ; 29

; ---- main -------------------------------------------------------------------
(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (printf c"coil/everything.coil (argc=%d), running 24 checks:\n" argc)
  (puts (load (index argv 0)))  ; the program path
  (cond (!= (feat-fib) 55) 1
        (!= (feat-conv) 42) 2
        (!= (feat-shim) 42) 3
        (!= (feat-alloc) 42) 4
        (!= (feat-allocators) 42) 5
        (!= (feat-io) 42) 6
        (!= (feat-extern) 42) 7
        (!= (feat-structabi) 92) 8
        (!= (feat-floats) 42) 9
        (!= (feat-bitwise) 42) 10
        (!= (feat-bool) 42) 11
        (!= (feat-widths) 42) 12
        (!= (feat-inference) 42) 13
        (!= (feat-structs) 42) 14
        (!= (feat-refs) 42) 15
        (!= (feat-generics) 42) 16
        (!= (feat-sum) 42) 17
        (!= (feat-closure) 42) 18
        (!= (feat-vtable) 42) 19
        (!= (feat-bits) 42) 20
        (!= (feat-explicit) 42) 21
        (!= (feat-packed) 42) 22
        (!= (feat-macros) 41) 23
        (!= (feat-ptr) 42) 24
        :else 42))
