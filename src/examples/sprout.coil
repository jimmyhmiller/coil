(module sprout)
(import "coil.primitive" :as primitive)

;; Sprout is a deliberately small Lisp used to exercise Coil's metaprogram
;; staging and ownership model. A program is a list of forms:
;;
;;   ((define (square x) (* x x))
;;    (print (square (inc 6))))
;;
;; Every stage is an ordinary Code -> Code function and can be invoked with
;; `coil run --meta`. No cursor or resume command appears in returned syntax.

(defn sp-head? [(x Code) (want Code)] (-> bool)
  (and (primitive/code-list? x)
       (and (> (primitive/code-count x) 0)
            (primitive/code-eq (primitive/code-nth x 0) want))))

(defn sp-map-desugar [(x Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(sprout-desugar-expr (primitive/code-nth x i))
        ~@(sp-map-desugar x (+ i 1) n))))

;; Surface -> core:
;;   (inc x)             => (+ x 1)
;;   (unless c yes no)   => (if c no yes)
;;   (let ((x v)) body)  => ((fn (x) body) v)
(defn sprout-desugar-expr [(x Code)] (-> Code)
  (if (not (primitive/code-list? x))
      x
      (let [n (primitive/code-count x)]
        (if (= n 0)
            x
            (cond (and (sp-head? x `inc) (= n 2))
                  `(+ ~(sprout-desugar-expr (primitive/code-nth x 1)) 1)
                  (and (sp-head? x `unless) (= n 4))
                  `(if ~(sprout-desugar-expr (primitive/code-nth x 1))
                       ~(sprout-desugar-expr (primitive/code-nth x 3))
                       ~(sprout-desugar-expr (primitive/code-nth x 2)))
                  (and (sp-head? x `let) (= n 3))
                  (let [bindings (primitive/code-nth x 1)]
                    (if (and (= (primitive/code-count bindings) 1)
                             (= (primitive/code-count (primitive/code-nth bindings 0)) 2))
                        (let [binding (primitive/code-nth bindings 0)
                              name (primitive/code-nth binding 0)
                              value (primitive/code-nth binding 1)]
                          `((fn (~name) ~(sprout-desugar-expr (primitive/code-nth x 2)))
                            ~(sprout-desugar-expr value)))
                        (primitive/error "sprout: let currently requires exactly one (name value) binding")))
                  :else `(~@(sp-map-desugar x 0 n)))))))

(defn sprout-desugar [(program Code)] (-> Code)
  (sp-map-desugar program 0 (primitive/code-count program)))

(defn sp-map-fold [(x Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(sprout-fold-expr (primitive/code-nth x i))
        ~@(sp-map-fold x (+ i 1) n))))

(defn sp-two-ints? [(x Code)] (-> bool)
  (and (= (primitive/code-count x) 3)
       (and (primitive/code-int? (primitive/code-nth x 1))
            (primitive/code-int? (primitive/code-nth x 2)))))

;; Core -> optimized core. Fold children first, then fold integer arithmetic and
;; integer conditions. This produces fresh output rather than returning a
;; streaming continuation.
(defn sprout-fold-expr [(x Code)] (-> Code)
  (if (not (primitive/code-list? x))
      x
      (let [folded `(~@(sp-map-fold x 0 (primitive/code-count x)))]
        (cond (and (sp-head? folded `+) (sp-two-ints? folded))
              `~(+ (primitive/code-int (primitive/code-nth folded 1))
                   (primitive/code-int (primitive/code-nth folded 2)))
              (and (sp-head? folded `*) (sp-two-ints? folded))
              `~(* (primitive/code-int (primitive/code-nth folded 1))
                   (primitive/code-int (primitive/code-nth folded 2)))
              (and (sp-head? folded `-) (sp-two-ints? folded))
              `~(- (primitive/code-int (primitive/code-nth folded 1))
                   (primitive/code-int (primitive/code-nth folded 2)))
              (and (sp-head? folded `if)
                   (and (= (primitive/code-count folded) 4)
                        (primitive/code-int? (primitive/code-nth folded 1))))
              (if (= (primitive/code-int (primitive/code-nth folded 1)) 0)
                  (primitive/code-nth folded 3)
                  (primitive/code-nth folded 2))
              :else folded))))

(defn sprout-fold [(program Code)] (-> Code)
  (sp-map-fold program 0 (primitive/code-count program)))

;; Core expression -> Coil i64 expression.
(defn sp-lower-expr [(x Code)] (-> Code)
  (if (not (primitive/code-list? x))
      x
      (let [n (primitive/code-count x)]
        (cond (and (sp-head? x `+) (= n 3))
              `(primitive/iadd ~(sp-lower-expr (primitive/code-nth x 1))
                               ~(sp-lower-expr (primitive/code-nth x 2)))
              (and (sp-head? x `-) (= n 3))
              `(primitive/isub ~(sp-lower-expr (primitive/code-nth x 1))
                               ~(sp-lower-expr (primitive/code-nth x 2)))
              (and (sp-head? x `*) (= n 3))
              `(primitive/imul ~(sp-lower-expr (primitive/code-nth x 1))
                               ~(sp-lower-expr (primitive/code-nth x 2)))
              (and (sp-head? x `if) (= n 4))
              `(if (!= ~(sp-lower-expr (primitive/code-nth x 1)) 0)
                   ~(sp-lower-expr (primitive/code-nth x 2))
                   ~(sp-lower-expr (primitive/code-nth x 3)))
              (and (sp-head? x `fn) (= n 3))
              (primitive/error "sprout: anonymous fn must be eliminated before Coil lowering")
              :else `(~@(sp-map-lower x 0 n))))))

(defn sp-map-lower [(x Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(sp-lower-expr (primitive/code-nth x i))
        ~@(sp-map-lower x (+ i 1) n))))

(defn sp-typed-params [(params Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `((~(primitive/code-nth params i) i64)
        ~@(sp-typed-params params (+ i 1) n))))

(defn sp-definition? [(f Code)] (-> bool)
  (and (sp-head? f `define)
       (and (= (primitive/code-count f) 3)
            (primitive/code-list? (primitive/code-nth f 1)))))

(defn sp-lower-defs [(program Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      (let [f (primitive/code-nth program i)]
        (if (sp-definition? f)
            (let [sig (primitive/code-nth f 1)
                  name (primitive/code-nth sig 0)
                  params (primitive/code-cdr sig)]
              `((defn ~name [~@(sp-typed-params params 0 (primitive/code-count params))]
                  (-> i64)
                  ~(sp-lower-expr (primitive/code-nth f 2)))
                ~@(sp-lower-defs program (+ i 1) n)))
            (sp-lower-defs program (+ i 1) n)))))

(defn sp-lower-main [(program Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `0
      (let [f (primitive/code-nth program i)]
        (if (sp-definition? f)
            (sp-lower-main program (+ i 1) n)
            (if (sp-head? f `print)
                `(do (print-int (stdout) ~(sp-lower-expr (primitive/code-nth f 1)))
                     (write-byte (stdout) 10)
                     ~(sp-lower-main program (+ i 1) n))
                `(do ~(sp-lower-expr f)
                     ~(sp-lower-main program (+ i 1) n)))))))

;; Optimized core -> a complete ordinary Coil module.
(defn sprout-lower [(program Code)] (-> Code)
  `(do
     (module sprout_output)
     (import "coil.primitive" :as primitive)
     (import "coil.io" :use *)
     ~@(sp-lower-defs program 0 (primitive/code-count program))
     (defn main [] (-> i64)
       ~(sp-lower-main program 0 (primitive/code-count program)))))
