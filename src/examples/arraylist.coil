; A growable ArrayList through the collection traits: `push!` and `for`.
; Storage comes from an allocator value; there is no ambient heap.
;   coil run src/examples/arraylist.coil; echo $?   => 45
(module example.arraylist)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [al-new al-free!])

(defn main [] (-> i64)
  (let [(mut xs) (al-new [i64] (malloc-allocator))
        (mut total) 0]
    (for i (range 0 10) (push! (mut xs) i))  ; grows past the initial capacity
    (for x xs (set! total (+ total x)))
    (al-free! (mut xs))
    total))
