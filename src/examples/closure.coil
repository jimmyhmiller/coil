; Closures by hand: a closure is a code pointer plus a type-erased environment
; pointer, so closures over different environments share one `Closure` type and
; one `apply`. You allocate the environment and free it; there is no GC.
; (`defclosure` in defclosure.coil generates all of this for you.)
;   coil run src/examples/closure.coil; echo $?   => 42
(module example.closure)
(import "coil.alloc" :as alloc)
(import "coil.cc" :as cc)

(defstruct Closure
  [(code (fnptr (cc/C) [(ptr i8) i64] i64))  ; code(env, x)
   (drop (fnptr (cc/C) [(ptr i8)] i64))  ; frees env as the type it was allocated as
   (env (ptr i8))])

(defn apply [(f Closure) (x i64)] (-> i64)
  (call-ptr (.code f) (.env f) x))

;;; n + x
(defstruct AdderEnv [(n i64)])

(defn adder-code [(env (ptr i8)) (x i64)] (-> i64)
  (+ (.n (cast (ptr AdderEnv) env)) x))

(defn adder-drop [(env (ptr i8))] (-> i64)
  (alloc/destroy (alloc/malloc-allocator) (cast (ptr AdderEnv) env)))

(defn make-adder [(n i64)] (-> Closure)
  (let [env (alloc/box! (alloc/malloc-allocator) AdderEnv (AdderEnv :n n))]
    (Closure :code (fnptr-of adder-code) :drop (fnptr-of adder-drop) :env (cast (ptr i8) env))))

;;; k * x: a different environment behind the same Closure type
(defstruct MulEnv [(k i64)])

(defn mul-code [(env (ptr i8)) (x i64)] (-> i64)
  (* (.k (cast (ptr MulEnv) env)) x))

(defn mul-drop [(env (ptr i8))] (-> i64)
  (alloc/destroy (alloc/malloc-allocator) (cast (ptr MulEnv) env)))

(defn make-mul [(k i64)] (-> Closure)
  (let [env (alloc/box! (alloc/malloc-allocator) MulEnv (MulEnv :k k))]
    (Closure :code (fnptr-of mul-code) :drop (fnptr-of mul-drop) :env (cast (ptr i8) env))))

;;; Each environment is freed as the type it was allocated as, through its own drop.
(defn free-closure [(f Closure)] (-> i64)
  (call-ptr (.drop f) (.env f)))

(defn main [] (-> i64)
  (let [add5 (make-adder 5)
        triple (make-mul 3)
        a (apply add5 37)  ; 42
        b (apply triple 14)]  ; 42
    (free-closure add5)
    (free-closure triple)
    (+ a (- b 42))))
