(module example.inference)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

; Bidirectional literal inference: integer literals adopt the iN/uN type of
; their context, so the cast-noise of writing (primitive/cast :u8 ...) everywhere is gone.
; The checker inserts the casts for you (and rejects literals that don't fit).
;   coil run src/examples/inference.coil; echo $?   => 42
(defstruct Pixel [(r :u8) (g :u8) (b :u8) (a :u8)])

; `lo : u8` makes the bare 1 below infer as u8 (same width as its sibling).
(defn channel :cc c [(base :u8)] (-> :u8)
  (primitive/iadd base 1))  ; `1` is u8 here — no (primitive/cast :u8 1)

(defn main [] (-> :i64)
  (let [px (primitive/alloc-stack Pixel)]
    (set! (.r px) 40)  ; literal 40 adopts u8 from (ptr u8)
    (set! (.g px) (channel 1))  ; call arg 1 adopts u8; result 2
    (primitive/iadd (primitive/cast :i64 (.r px))
                    (primitive/cast :i64 (.g px)))))  ; 40 + 2 = 42
