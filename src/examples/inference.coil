; Literal inference: an integer literal takes the width of its context, so a u8
; field or parameter needs no casts around its constants.
;   coil run src/examples/inference.coil; echo $?   => 42
(module example.inference)

(defstruct Pixel [(r u8) (g u8) (b u8) (a u8)])

(defn channel :cc c [(base u8)] (-> u8)
  (+ base 1))  ; this `1` is a u8

(defn main [] (-> i64)
  (let [px
          (Pixel
            :r 40
            :g (channel 1)
            :b 0
            :a 255)]  ; every literal here is a u8
    (+ (cast i64 (.r px)) (cast i64 (.g px)))))
