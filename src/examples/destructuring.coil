(module example-destructuring)
(import "coil.primitive" :as primitive)

(defstruct Point [(x i64) (y i64)])

;;; Constructor patterns select fields and give them local names.
(defn total [((as point (Point :x x :y y)) Point)] (-> i64)
  (+ x y))

;;; Code sequences use the same pattern syntax as runtime slices and arrays.
(defn add-first-two [(values Code)] (-> Code)
  (let [[left right & remaining] values] `(+ ~left ~right)))

(defn main [] (-> i64)
  (let [[x y & rest] [10 20 30]
        (Point :x px :y py) (Point :x x :y y)]
    (- (+ (total
            :point (Point :x px :y py))
          (add-first-two [5 7]))
       42)))
