; Destructuring in `let`, parameters, and macros: sequence patterns with `& rest`,
; struct patterns that pick fields by name, and `as` for the whole value.
;   coil run src/examples/destructuring.coil; echo $?   => 42
(module example.destructuring)

(defstruct Point [(x i64) (y i64)])

(defn total [((as point (Point :x x :y y)) Point)] (-> i64)
  (+ x y))

;;; Code values destructure with the same patterns as slices and arrays.
(defn add-first-two [(values Code)] (-> Code)
  (let [[left right & _] values] `(+ ~left ~right)))

(defn main [] (-> i64)
  (let [[x y & _] [10 20 30]
        (Point :x px :y py) (Point :x x :y y)]
    (- (+ (total
            :point (Point :x px :y py))
          (add-first-two [5 7]))
       42)))
