; Code that runs while the image is built runs on the build machine, which has an
; operating system even though the image has none. `baked-text` reads a file
; beside this source with coil.fs during compilation and puts its text in the
; image as a string; coil.fs itself stays on the build machine, so nothing of it
; is compiled for the target or linked.
;   python3 scripts/dev.py example freestanding build_time  ->  "baked at build time"
(module example.freestanding.build_time)
(import "coil.primitive" :as primitive)
(import "coil.fs" :as fs)
(import "coil.str" :as str)
(import "coil.slice" :use [subslice])
(import "coil.meta" :use [expansion-allocator])

; Volatile byte store to the qemu virt PL011 UART data register (MMIO 0x09000000).
(defn uart-byte [(c i64)] (-> i64)
  (primitive/llvm-ir i64
                     [c]
                     "%p = inttoptr i64 150994944 to ptr
%b = trunc i64 $0 to i8
store volatile i8 %b, ptr %p
ret i64 0"))

; PSCI SYSTEM_OFF (function id 0x84000008) via `hvc` — qemu virt's conduit. Halts.
(defn poweroff [] (-> i64)
  (primitive/llvm-ir i64
                     []
                     "call void asm sideeffect \"movz x0, #0x8400, lsl #16 ; movk x0, #8 ; hvc #0\", \"~{x0}\"()
ret i64 0"))

(defn uart-puts [(s (slice u8))] (-> i64)
  (for [i 0 (len s)]
    (uart-byte (primitive/cast i64 (get s i))))
  0)

;;; FILE beside SOURCE: SOURCE's directory, then FILE.
(defn beside [(source (slice u8)) (file (slice u8))] (-> (slice u8))
  (let [(mut cut) 0]
    (for [i 0 (len source)]
      (when (= (get source i) (: 47 u8)) (set! cut (+ i 1)) 0))
    (match (str/concat (expansion-allocator) (subslice source 0 (load cut)) file)
      (Some [path] path)
      (None [] (panic "beside: out of memory")))))

;;; The text of FILE, a path relative to the file this is written in, read on the
;;; build machine while the program is compiled.
(defn baked-text [(file Code)] (-> Code)
  (let [path (beside (primitive/code-file (primitive/code-call-site)) (primitive/code-str file))]
    (match (fs/read-file (expansion-allocator) path)
      (Ok [text] `~text)
      (Err [_] (primitive/error (primitive/code-str "baked-text: cannot read " path))))))

(export-c [start :as "coil_start"])  ; called by start.s

(defn start [] (-> i64)
  (uart-puts (baked-text "build_time.txt"))
  (poweroff)
  (loop 0))
