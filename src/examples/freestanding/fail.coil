; What a failure does on bare metal. With no OS there is no stderr to report to and
; no process to abort, so the standard library hands the failure to the handler the
; program installs with `coil.fail/set-handler!`, then traps. This program installs a
; handler that reports over the PL011 UART and powers the machine off, then asks a
; 64-byte arena for 128 bytes.
;   python3 scripts/dev.py example freestanding fail
;     ->  "fatal: out of memory at box!"
; Without the handler the same failure stops at a `brk` instruction at the failing site.
(module example.freestanding.fail)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.fail" :as fail)

(defn uart-byte [(c i64)] (-> i64)
  (primitive/llvm-ir i64
                     [c]
                     "%p = inttoptr i64 150994944 to ptr
%b = trunc i64 $0 to i8
store volatile i8 %b, ptr %p
ret i64 0"))

(defn uart-write [(s (slice u8))] (-> i64)
  (for i (range 0 (len s))
    (uart-byte (primitive/cast i64 (get s i))))
  0)

(defn poweroff [] (-> i64)
  (primitive/llvm-ir i64
                     []
                     "call void asm sideeffect \"movz x0, #0x8400, lsl #16 ; movk x0, #8 ; hvc #0\", \"~{x0}\"()
ret i64 0"))

;; The board's failure handler: say what failed and where, then power off.
(defn on-fail [(what (slice u8)) (where (slice u8))] (-> i64)
  (uart-write "fatal: ")
  (uart-write what)
  (uart-write " at ")
  (uart-write where)
  (uart-byte 10)
  (poweroff))

(export-c [start :as "coil_start"])  ; called by start.s

(defn start [] (-> i64)
  (fail/set-handler! (fnptr-of on-fail))
  (let [buf (primitive/alloc-static (array u8 64))
        a (arena-over-buffer (primitive/alloc-static Arena)
                             (primitive/cast (ptr i8) (primitive/index buf 0))
                             64)]
    (box! a (array i64 16) (primitive/zeroed (array i64 16)))
    (uart-write "unreachable: box! returned\n"))
  (poweroff)
  (loop 0))
