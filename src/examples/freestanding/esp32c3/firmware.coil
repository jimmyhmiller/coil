(module esp32c3_firmware)
(import "coil.core" :use [])
(import "coil.primitive" :as primitive)

(defcc reset :lower reset)

(defsum BootProbe
  (Probe [(left u32) (right u32)])
  (Missing))

; UART0 was initialized by the boot ROM. From here on output is direct MMIO:
; FIFO 0x60000000, STATUS 0x6000001c, TXFIFO count in bits 25:16.
(defn uart-putc [(byte u8)] (-> i32)
  (let [status (primitive/volatile-load u32 (primitive/cast (ptr u32) 1610612764))
        count (primitive/iand (primitive/ishr status 16) 1023)]
    (if (primitive/icmp-lt count 127)
        (do
          (primitive/volatile-store! (primitive/cast (ptr u32) 1610612736)
                                     (primitive/cast u32 byte))
          0)
        (uart-putc byte))))

; The ROM maps flash but does not provide a C runtime. These two tail-recursive
; loops are Coil's crt0: copy initialized data into SRAM and clear BSS.
(defn copy-bytes [(src (ptr u8)) (dst (ptr u8)) (end (ptr u8))] (-> i64)
  (if (primitive/icmp-eq (primitive/cast i64 dst) (primitive/cast i64 end))
      0
      (do
        (primitive/volatile-store! dst (primitive/volatile-load u8 src))
        (copy-bytes (primitive/index src 1) (primitive/index dst 1) end))))

(defn zero-bytes [(dst (ptr u8)) (end (ptr u8))] (-> i64)
  (if (primitive/icmp-eq (primitive/cast i64 dst) (primitive/cast i64 end))
      0
      (do
        (primitive/volatile-store! dst (primitive/cast u8 0))
        (zero-bytes (primitive/index dst 1) end))))

(defn init-memory [] (-> i64)
  (do
    (copy-bytes (primitive/linker-address __data_lma)
                (primitive/linker-address __data_start)
                (primitive/linker-address __data_end))
    (zero-bytes (primitive/linker-address __bss_start)
                (primitive/linker-address __bss_end))))

(defn answer [(x i32)] (-> i32)
  (primitive/imul x (primitive/cast i32 7)))

(defn probe-answer [(probe BootProbe)] (-> u32)
  (match probe
    (Probe [left right] (primitive/iadd left right))
    (Missing [] 0)))

(defn firmware_main [] (-> i32)
  (do
    (uart-putc 99)  ; c
    (uart-putc 111)  ; o
    (uart-putc 105)  ; i
    (uart-putc 108)  ; l
    (uart-putc 32)
    (uart-putc 101)  ; e
    (uart-putc 115)  ; s
    (uart-putc 112)  ; p
    (uart-putc 51)  ; 3
    (uart-putc 50)  ; 2
    (uart-putc 45)
    (uart-putc 99)
    (uart-putc 51)
    (uart-putc 58)
    (uart-putc 32)
    ; The volatile BSS byte prevents this sum construction/match from folding
    ; away, making the emulator exercise RV32's physical sum representation.
    (if (primitive/icmp-eq (probe-answer (Probe (primitive/iadd (primitive/csr-read mhartid)
                                                                (primitive/cast u32
                                                                                (primitive/volatile-load u8
                                                                                                         (primitive/linker-address __bss_start))))
                                                42))
                           42)
        (do
          (uart-putc 111)
          (uart-putc 107)
          (uart-putc 10)
          (answer 6))
        (do
          (uart-putc 88)
          (uart-putc 10)
          0))))

(defn runtime_start [] (-> i64)
  (do
    (init-memory)
    (firmware_main)
    (loop 0)))

; Direct-boot reset entry. The `reset` convention retains it in `.text.entry`.
; Espressif's ROM supplies the temporary entry stack used by LLVM's prologue;
; this immediately switches to the application stack and never returns.
(defn _start :cc reset [] (-> i64)
  (do
    (primitive/write-register! sp (primitive/linker-address __stack_top))
    (primitive/write-register! gp (primitive/linker-address __global_pointer$))
    (runtime_start)))
