; First RV32IMC freestanding proof. This intentionally uses scalar values only:
; pointer/aggregate layout and the complete ILP32 C ABI are separate milestones.
; The assembly harness passes 6 and prints success only if Coil returns 42.
(module esp32c3_smoke)
(import "coil.core" :use [])
(import "coil.primitive" :as primitive)

(defn answer [(x i32)] (-> i32)
  (primitive/imul x (primitive/cast i32 7)))
