; First RV32IMC freestanding proof. The assembly harness passes 6 and prints
; success only if Coil returns 42.
;
; Before answering, it checks the memcpy, memmove, memset and memcmp the compiler
; supplies on a target with no C library: an aggregate copy, which LLVM lowers to a
; call, and each function called directly, with an overlapping move in both
; directions and a comparison of bytes past 127.
(module esp32c3_smoke)
(import "coil.primitive" :as primitive)

(extern memcpy :cc c [(ptr u8) (ptr u8) u32] (-> (ptr u8)))

(extern memmove :cc c [(ptr u8) (ptr u8) u32] (-> (ptr u8)))

(extern memset :cc c [(ptr u8) i32 u32] (-> (ptr u8)))

(extern memcmp :cc c [(ptr u8) (ptr u8) u32] (-> i32))

(defstruct Big [(bytes (array u8 512))])

(defn byte-at [(p (ptr u8)) (i i64)] (-> i64)
  (primitive/cast i64 (load (primitive/index p i))))

(defn mem-ok [] (-> bool)
  (let [a (primitive/alloc-static Big)
        b (primitive/alloc-static Big)
        pa (primitive/cast (ptr u8) a)
        pb (primitive/cast (ptr u8) b)
        (mut ok) true
        (mut i) 0]
    (memset pa 7 512)
    (primitive/store! b (primitive/load a))
    (unless (and (= (byte-at pb 0) 7) (= (byte-at pb 511) 7))
      (set! ok false))
    (loop (if (>= (load i) 16)
              (break)
              (do
                (store! (primitive/index pa (load i)) (primitive/cast u8 (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    ; up by two over itself: 0 1 0 1 2 … 9 12 …
    (memmove (primitive/index pa 2) pa 10)
    (unless (and (= (byte-at pa 1) 1)
                 (and (= (byte-at pa 2) 0)
                      (and (= (byte-at pa 11) 9) (= (byte-at pa 12) 12))))
      (set! ok false))
    ; back down by two: 0 1 2 … 9 8 9 12 …
    (memmove pa (primitive/index pa 2) 10)
    (unless (and (= (byte-at pa 0) 0)
                 (and (= (byte-at pa 9) 9) (= (byte-at pa 10) 8)))
      (set! ok false))
    (memcpy pb pa 4)
    (unless (and (= (byte-at pb 3) 3) (= (memcmp pa pb 4) (: 0 i32)))
      (set! ok false))
    (store! (primitive/index pb 2) (: 200 u8))
    (unless (and (< (memcmp pa pb 4) (: 0 i32)) (> (memcmp pb pa 4) (: 0 i32)))
      (set! ok false))
    (load ok)))

(defn answer [(x i32)] (-> i32)
  (if (mem-ok) (primitive/imul x (: 7 i32)) (: 0 i32)))
