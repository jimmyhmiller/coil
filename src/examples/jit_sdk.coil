; The in-process compiler SDK: compile a program, then add functions against its
; retained environment. Exit 0 means every step behaved as expected; any other
; code names the step that did not.
;   coil run src/examples/jit_sdk.coil; echo $?   => 0
(module example.jit-sdk)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :use *)

(defn main [] (-> i64)
  (let [(mut session) (jit-session-new (malloc-allocator))]
    (cond ; 1. an initial program
          (!= (jit-compile! (mut session)
                            "(defstruct Point [(x i64)]) (defn point [] (-> Point) (Point :x 42))")
              0)
            1
          ; 2. prepare a new function, gated on an entry expression, without publishing it
          (!= (jit-prepare-with-entry! (mut session)
                                       "(defn answer [] (-> i64) (let [p (point)] (.x p)))"
                                       "(if (= (answer) 42) 0 2)")
              0)
            2
          ; 3. publish the prepared candidate
          (!= (jit-commit-prepared! (mut session)) 0) 3
          ; 4. redefining an accepted function is rejected
          (= (jit-compile! (mut session) "(defn answer [] (-> i64) 99)") 0) 4
          ; 5. the original definition is still the one that runs
          (!= (jit-compile-with-entry! (mut session)
                                       ""
                                       "(if (= (answer) 42) 0 5)")
              0)
            5
          :else (jit-reset! (mut session)))))
