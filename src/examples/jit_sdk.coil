; A userland embedding of Coil's in-process compiler and hot-reloading JIT.
(module jit_sdk_example)

(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :use *)

(defn recursive-reload-regression [] (-> i64)
  (let [(mut session) (jit-session-new (malloc-allocator))
        first "(defn even [(x i64)] (-> i64) (if (= x 0) 1 (odd (- x 1))))\n(defn odd [(x i64)] (-> i64) (if (= x 0) 0 (even (- x 1))))"
        second "(defn even [(x i64)] (-> i64) (if (= x 0) 0 (odd (- x 1))))\n(defn odd [(x i64)] (-> i64) (if (= x 0) 1 (even (- x 1))))"]
    (cond (!= (jit-replace-source! (mut session) first) 0) 101
          (!= (jit-submit! (mut session) "(if (= (even 8) 1) 0 102)") 0) 102
          (!= (jit-replace-source! (mut session) second) 0) 103
          (!= (jit-submit! (mut session) "(if (= (even 8) 0) 0 104)") 0) 104
          :else 0)))

(defn trampoline-regression [] (-> i64)
  (let [(mut session) (jit-session-new (malloc-allocator))
        v1 "(defn twice [(x i64)] (-> i64) (* x 2))\n(defn frozen [] (-> (ptr (fnptr c [i64] i64))) (primitive/alloc-static (fnptr c [i64] i64)))\n(defn frozen-initialized [] (-> (ptr bool)) (primitive/alloc-static bool))\n(defn install [] (-> i64) (if (not (load (frozen-initialized))) (do (store! (frozen) twice) (store! (frozen-initialized) true) 0) 0))\n(defn frozen-call [(x i64)] (-> i64) (let [callback (load (frozen))] (primitive/call-ptr callback x)))"
        v2 "(defn twice [(x i64)] (-> i64) (* x 3))\n(defn frozen [] (-> (ptr (fnptr c [i64] i64))) (primitive/alloc-static (fnptr c [i64] i64)))\n(defn frozen-initialized [] (-> (ptr bool)) (primitive/alloc-static bool))\n(defn install [] (-> i64) (if (not (load (frozen-initialized))) (do (store! (frozen) twice) (store! (frozen-initialized) true) 0) 0))\n(defn frozen-call [(x i64)] (-> i64) (let [callback (load (frozen))] (primitive/call-ptr callback x)))"
        v3 "(defn twice [(x bool)] (-> i64) (if x 1 0))\n(defn frozen [] (-> (ptr (fnptr c [i64] i64))) (primitive/alloc-static (fnptr c [i64] i64)))\n(defn frozen-initialized [] (-> (ptr bool)) (primitive/alloc-static bool))\n(defn frozen-call [(x i64)] (-> i64) (let [callback (load (frozen))] (primitive/call-ptr callback x)))"]
    (cond (!= (jit-prepare-replace-with-entry! (mut session) v1
                 "(do (install) (if (= (frozen-call 5) 10) 0 91))") 0) 91
          (!= (jit-commit-prepared! (mut session)) 0) 92
          (!= (jit-prepare-replace-with-entry! (mut session) v2
                 "(do (install) (if (= (frozen-call 5) 15) 0 93))") 0) 93
          (!= (jit-commit-prepared! (mut session)) 0) 94
          (!= (jit-prepare-replace-with-entry! (mut session) v3
                 "(if (and (= (frozen-call 5) 15) (= (twice true) 1)) 0 95)") 0) 95
          (!= (jit-commit-prepared! (mut session)) 0) 96
          :else 0)))

(defn main [] (-> i64)
  (let [(mut session) (jit-session-new (malloc-allocator))
        recursive-status (recursive-reload-regression)
        trampoline-status (trampoline-regression)
        (mut before-reclaim) 0]
    (cond (!= recursive-status 0) recursive-status
          (!= trampoline-status 0) trampoline-status
          (!= (jit-submit! (mut session)
                           "(defn twice [(x i64)] (-> i64) (* x 2))")
              0) 1
          (!= (jit-status (mut session)) 0) 2
          (!= (jit-epoch (mut session)) 1) 3
          (!= (jit-submit! (mut session) "(twice 10)") 0) 1
          ; A rejected definition is retained as candidate state. It neither
          ; changes accepted source nor advances the accepted generation.
          (= (jit-submit! (mut session)
                          "(defn twice [(x i64)] (-> i64) \"wrong\")")
             0) 4
          (!= (jit-status (mut session)) 1) 5
          (!= (jit-epoch (mut session)) 1) 6
          (= (jit-pending (mut session)) "") 7
          (= (jit-diagnostic (mut session)) "") 8
          (!= (jit-submit! (mut session)
                           "(defn twice [(x i64)] (-> i64) (* x 3))")
              0) 1
          (!= (jit-status (mut session)) 0) 9
          (!= (jit-epoch (mut session)) 2) 10
          (!= (jit-pending (mut session)) "") 11
          (!= (jit-diagnostic (mut session)) "") 12
          (!= (jit-submit! (mut session) "(twice 10)") 0) 13
          ; A full-source transaction may change a signature because its entire
          ; caller/type dependency closure is checked and loaded together.
          (!= (jit-prepare-replace!
                (mut session)
                "(defn twice [(x bool)] (-> i64) (if x 1 0))\n(defn use-twice [] (-> i64) (twice true))")
              0) 14
          (not (jit-prepared? (mut session))) 21
          (!= (jit-epoch (mut session)) 2) 22
          (!= (jit-abort-prepared! (mut session)) 0) 23
          (jit-prepared? (mut session)) 24
          (!= (jit-submit! (mut session) "(twice 10)") 0) 25
          (!= (jit-prepare-replace-with-entry!
                (mut session)
                "(defn twice [(x bool)] (-> i64) (if x 1 0))\n(defn use-twice [] (-> i64) (twice true))"
                "1")
              0) 28
          (= (jit-commit-prepared! (mut session)) 0) 29
          (!= (jit-epoch (mut session)) 2) 30
          (!= (jit-submit! (mut session) "(twice 10)") 0) 31
          (!= (jit-prepare-replace!
                (mut session)
                "(defn twice [(x bool)] (-> i64) (if x 1 0))\n(defn use-twice [] (-> i64) (twice true))")
              0) 26
          (!= (jit-commit-prepared! (mut session)) 0) 27
          (!= (jit-epoch (mut session)) 3) 15
          (!= (jit-submit! (mut session) "(use-twice)") 0) 16
          ; Native struct layout changes use the same whole-snapshot boundary:
          ; every constructor, field access, and by-value ABI user is rebuilt
          ; before the new generation becomes current.
          (!= (jit-replace-source!
                (mut session)
                "(defstruct Point [(x i64)])\n(defn point-value [] (-> i64) (.x (Point :x 7)))")
              0) 17
          (!= (jit-submit! (mut session) "(point-value)") 0) 18
          (!= (jit-replace-source!
                (mut session)
                "(defstruct Point [(x i64) (y i64)])\n(defn point-value [] (-> i64) (let [p (Point :x 7 :y 9)] (+ (.x p) (.y p))))")
              0) 19
          (!= (jit-epoch (mut session)) 5) 20
          (<= (jit-generation-count (mut session)) 1) 32
          (do (set! before-reclaim (jit-generation-count (mut session))) false) 42
          (!= (jit-generation-retain! (mut session)) 1) 33
          (!= (jit-generation-leases (mut session)) 1) 34
          (!= (jit-reclaim-retired! (mut session)) -1) 35
          (!= (jit-reset! (mut session)) -1) 36
          (!= (jit-generation-release! (mut session)) 0) 37
          (<= (jit-reclaim-retired! (mut session)) 0) 38
          (>= (jit-generation-count (mut session)) (load before-reclaim)) 39
          :else
            (let [result (jit-submit! (mut session) "(point-value)")]
              (cond (!= result 0) result
                    (!= (jit-reset! (mut session)) 0) 40
                    (!= (jit-generation-count (mut session)) 0) 41
                    :else 0)))))
