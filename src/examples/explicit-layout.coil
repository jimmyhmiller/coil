; `:layout explicit` places each field at a byte offset. Gaps are padding and
; overlapping offsets make a union.
;   coil run src/examples/explicit-layout.coil; echo $?   => 42
(module example.explicit-layout)

(defstruct Reg :layout explicit :size 16 :align 8
  [(status u32 :at 0)
   (sbytes (array u8 4) :at 0)  ; overlaps status: a byte view of it
   (data i64 :at 8)])  ; bytes 4..7 are padding

(static-assert (= (sizeof Reg) 16) "Reg must be 16 bytes")

(static-assert (= (offsetof Reg data) 8) "data at offset 8")

(defn main [] (-> i64)
  (let [(mut r) (zeroed Reg)]
    (set! (.status r) 2)
    (set! (.data r) 40)
    (+ (cast i64 (get (.sbytes r) 0))  ; the low byte of status
       (.data r))))
