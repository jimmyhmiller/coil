; A small JSON parser and value model: a recursive sum type whose arrays and
; objects are allocator-owned ArrayList and HashMap values. Strings are views
; into the source text. Integers only, no escapes.
;   coil run src/examples/json.coil; echo $?   => 42
(module example.json)
(import "coil.alloc" :use [Allocator malloc-allocator box!])
(import "coil.arraylist" :use [ArrayList al-new])
(import "coil.hashmap" :use [HashMap hm-new])
(import "coil.slice" :use [subslice])
(import "coil.str" :use [str-keyops])

(defsum Json
  (JNull)
  (JBool [(b bool)])
  (JNum [(n i64)])
  (JStr [(s (slice u8))])
  (JArr [(items (ptr (ArrayList Json)))])  ; recursive children live behind pointers
  (JObj [(fields (ptr (HashMap (slice u8) Json)))]))

;;; The parser's cursor over the source.
(defstruct Parser [(src (slice u8)) (pos i64) (allocator (dyn Allocator))])

(defn peek [(p Parser)] (-> i64)
  (if (< (.pos p) (len (.src p))) (cast i64 (get (.src p) (.pos p))) -1))

(defn advance! [(p (mut Parser)) (n i64)] (-> i64)
  (set! (.pos p) (+ (.pos p) n)))

(defn skip-whitespace! [(p (mut Parser))] (-> i64)
  (while (let [c (peek p)]
           (or (= c #\space)
               (or (= c #\newline) (or (= c #\tab) (= c #\return)))))
    (advance! (mut p) 1)))

(defn digit? [(c i64)] (-> bool)
  (and (>= c #\0) (<= c #\9)))

(defn parse-number [(p (mut Parser))] (-> Json)
  (let [negative (= (peek p) #\-)
        (mut n) 0]
    (when negative (advance! (mut p) 1))
    (while (digit? (peek p))
      (set! n (+ (* n 10) (- (peek p) #\0)))
      (advance! (mut p) 1))
    (JNum (if negative (- n) n))))

;;; A "..." string, as a view into the source.
(defn parse-string [(p (mut Parser))] (-> (slice u8))
  (advance! (mut p) 1)  ; opening quote
  (let [start (.pos p)]
    (while (!= (peek p) #\") (advance! (mut p) 1))
    (advance! (mut p) 1)  ; closing quote
    (subslice (.src p) start (- (.pos p) 1))))

(defn parse-value [(p (mut Parser))] (-> Json)
  (skip-whitespace! (mut p))
  (let [c (peek p)]
    (cond (= c #\n) (do (advance! (mut p) 4) (JNull))
          (= c #\t) (do (advance! (mut p) 4) (JBool true))
          (= c #\f) (do (advance! (mut p) 5) (JBool false))
          (= c #\") (JStr (parse-string (mut p)))
          (= c #\[) (parse-array (mut p))
          (= c #\{) (parse-object (mut p))
          :else (parse-number (mut p)))))

;;; After an element: consume `,` and continue, or consume the closer and stop.
(defn more-elements? [(p (mut Parser))] (-> bool)
  (skip-whitespace! (mut p))
  (let [comma (= (peek p) #\,)]
    (advance! (mut p) 1)
    comma))

(defn parse-array [(p (mut Parser))] (-> Json)
  (advance! (mut p) 1)  ; [
  (let [items
          (box! (.allocator p) (ArrayList Json) (al-new [Json] (.allocator p)))]
    (skip-whitespace! (mut p))
    (if (= (peek p) #\])
        (advance! (mut p) 1)
        (loop (push! (mut items) (parse-value (mut p)))
          (unless (more-elements? (mut p)) (break))))
    (JArr items)))

(defn parse-object [(p (mut Parser))] (-> Json)
  (advance! (mut p) 1)  ; {
  (let [fields
          (box! (.allocator p)
                (HashMap (slice u8) Json)
                (hm-new [(slice u8) Json] (.allocator p) (str-keyops)))]
    (skip-whitespace! (mut p))
    (if (= (peek p) #\})
        (advance! (mut p) 1)
        (loop (skip-whitespace! (mut p))
          (let [key (parse-string (mut p))]
            (skip-whitespace! (mut p))
            (advance! (mut p) 1)  ; :
            (set! (mut fields) key (parse-value (mut p))))
          (unless (more-elements? (mut p)) (break))))
    (JObj fields)))

(defn parse [(a (dyn Allocator)) (src (slice u8))] (-> Json)
  (let [(mut p)
          (Parser
            :src src
            :pos 0
            :allocator a)]
    (parse-value (mut p))))

;;; Queries: `_` covers every variant a query does not care about.
(defn as-num [(j Json)] (-> i64)
  (match j
    (JNum [n] n)
    (JBool [b] (if b 1 0))
    (_ 0)))

(defn at [(j Json) (i i64)] (-> Json)
  (match j
    (JArr [items] (get items i))
    (_ (JNull))))

(defn member [(j Json) (key (slice u8))] (-> Json)
  (match j
    (JObj [fields] (match (get fields key) (Some [v] v) (None [] (JNull))))
    (_ (JNull))))

(defn main [] (-> i64)
  (let [doc
          (parse (malloc-allocator)
                 "{\"nums\": [10, 20, 12], \"meta\": {\"k\": 40}}")
        nums (member doc "nums")]
    ; nums[0] + nums[2] + meta.k - nums[1] = 10 + 12 + 40 - 20
    (- (+ (as-num (at nums 0))
          (as-num (at nums 2))
          (as-num (member (member doc "meta") "k")))
       (as-num (at nums 1)))))
