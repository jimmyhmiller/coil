; A JSON parser + value model — the Phase-2 dogfood. Exercises, at scale:
;   - (slice u8) strings (source, string values, object keys) + str-keyops
;   - a RECURSIVE sum (Json) with collection pointers for arrays/objects
;   - generic containers: ArrayList<Json>, HashMap<(slice u8), Json>
;   - recursion, references/aggregates, the allocator value, control-flow macros
; Integers only (no float/escape parsing) — a deliberate v1 scope.
;   coil run src/examples/json.coil; echo $?   => 42
(module example.json)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.control" :use *)

(defsum Json
  (JNull [])
  (JBool [(b i64)])  ; 0 / 1
  (JNum [(n i64)])
  (JStr [(s (slice u8))])
  (JArr [(a (ptr (ArrayList Json)))])  ; recursion via the heap
  (JObj [(o (ptr (HashMap (slice u8) Json)))]))

; ---- the parser cursor over a (slice u8) source ----------------------------
(defstruct P [(src (slice u8)) (pos i64) (alc (dyn Allocator))])

(defn p-peek [(p (ptr P))] (-> i64)
  (if (>= (.pos p) (slice-len (.src p)))
      -1
      (primitive/cast i64 (slice-get (.src p) (.pos p)))))
(defn p-adv [(p (ptr P))] (-> i64)
  (set! (.pos p) (primitive/iadd (.pos p) 1))
  0)

(defn ws? [(c i64)] (-> bool)
  (or (= c (cast i64 32)) (or (= c (cast i64 10)) (or (= c (cast i64 9)) (= c (cast i64 13))))))
(defn skip-ws [(p (ptr P))] (-> i64)
  (loop (if (ws? (p-peek p)) (p-adv p) (break)))
  0)

(defn digit? [(c i64)] (-> bool)
  (and (>= c (cast i64 48)) (<= c (cast i64 57))))

; ---- scalars ---------------------------------------------------------------
; advance over a known literal of `len` bytes
(defn eat [(p (ptr P)) (len i64)] (-> i64)
  (for [i 0 len] (p-adv p))
  0)

(defn parse-number [(p (ptr P))] (-> Json)
  (let [(mut neg) 0
        (mut v) 0]
    (if (= (p-peek p) (cast i64 45)) (do (set! neg 1) (p-adv p)) 0)  ; '-'
    (loop (let [c (p-peek p)]
            (if (digit? c)
                (do (set! v (primitive/iadd (primitive/imul (load v) 10) (primitive/isub c 48))) (p-adv p))
                (break))))
    (JNum (if (= (load neg) (cast i64 1)) (primitive/isub 0 (load v)) (load v)))))

; parse a "..." string into a (slice u8) VIEW over the source (no escapes in v1)
(defn parse-str-slice [(p (ptr P))] (-> (slice u8))
  (p-adv p)  ; opening quote
  (let [start (.pos p)]
    (loop (if (= (p-peek p) (cast i64 34)) (break) (p-adv p)))  ; until closing quote
    (let [s (subslice (.src p) start (.pos p))]
      (p-adv p)  ; closing quote
      s)))

; ---- recursive value -------------------------------------------------------
(defn parse-value [(p (ptr P))] (-> Json)
  (skip-ws p)
  (let [c (p-peek p)]
    (cond (= c (cast i64 110)) (do (eat p 4) (JNull))
          ; 'n'ull
          (= c (cast i64 116)) (do (eat p 4) (JBool 1))
          ; 't'rue
          (= c (cast i64 102)) (do (eat p 5) (JBool 0))
          ; 'f'alse
          (= c (cast i64 34)) (JStr (parse-str-slice p))
          ; '"'
          (= c (cast i64 91)) (parse-array p)
          ; '['
          (= c (cast i64 123)) (parse-object p)
          :else  ; '{'
            (parse-number p))))

(defn parse-array [(p (ptr P))] (-> Json)
  (p-adv p)  ; '['
  (let [arr (box! (load (field p alc)) (ArrayList Json) (al-new [Json] (load (field p alc))))]
    (skip-ws p)
    (if (= (p-peek p) (cast i64 93))
        (p-adv p)  ; empty []
        (loop (al-push! [Json] (mut arr) (parse-value p))
          (skip-ws p)
          (if (= (p-peek p) (cast i64 44)) (p-adv p) (do (p-adv p) (break)))))  ; ',' or ']'
    (JArr arr)))

(defn parse-object [(p (ptr P))] (-> Json)
  (p-adv p)  ; '{'
  (let [obj
          (box! (load (field p alc))
               (HashMap (slice u8) Json)
               (hm-new [(slice u8) Json] (load (field p alc)) (str-keyops)))]
    (skip-ws p)
    (if (= (p-peek p) (cast i64 125))
        (p-adv p)  ; empty {}
        (loop (skip-ws p)
          (let [key (parse-str-slice p)]
            (skip-ws p)
            (p-adv p)  ; ':'
            (hm-put! [(slice u8) Json] (mut obj) key (parse-value p)))
          (skip-ws p)
          (if (= (p-peek p) (cast i64 44)) (p-adv p) (do (p-adv p) (break)))))
    (JObj obj)))

(defn parse [(a (dyn Allocator)) (src (slice u8))] (-> Json)
  (let [p (primitive/alloc-stack P)]
    (set! (.src p) src)
    (set! (.pos p) 0)
    (set! (.alc p) a)
    (parse-value p)))

; ---- queries over the value model ------------------------------------------
; The catch-all arm `(_ …)` collapses the 5 not-of-interest variants into one
; default — no longer spelling out all 6 of Json's variants in every query.
(defn as-num [(j Json)] (-> i64)
  (match j (JNum [n] n) (JBool [b] b) (_ 0)))
(defn arr-get [(j Json) (i i64)] (-> Json)
  (match j (JArr [a] (al-get (load a) i)) (_ (JNull))))
(defn obj-get [(j Json) (key (slice u8))] (-> Json)
  (match j (JObj [o] (match (hm-get [(slice u8) Json] (load o) key) (None [] (JNull)) (Some [v] v))) (_ (JNull))))

(defn main [] (-> :i64)
  (let [a (malloc-allocator)
        doc (parse a "{\"nums\": [10, 20, 12], \"meta\": {\"k\": 40}}")]
    ; sum the array + a nested object field = 10 + 20 + 12 ... pick to total 42:
    ; nums[0]+nums[2] = 10+12 = 22, meta.k = 40 -> 22 + 40 - 20 = 42
    (let [nums (obj-get doc "nums")
          meta (obj-get doc "meta")]
      (primitive/isub (primitive/iadd (primitive/iadd (as-num (arr-get nums 0)) (as-num (arr-get nums 2)))
                                      (as-num (obj-get meta "k")))
                      (as-num (arr-get nums 1))))))
