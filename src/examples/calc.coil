; DOGFOOD: a tiny expression-language interpreter — the Phase-1 capstone. Exercises

; ArrayList (tokens), a recursive AST sum + match, HashMap (variable env), explicit
; allocator, loops/break, and fmt — all together.
;
; Language: `;`-separated statements; a statement is `v=EXPR` (assign single-letter
; var) or an EXPR. EXPR = +,-,*,/ with precedence and parens; operands are integer
; literals and variables. The program prints each statement's value.
;   coil run src/examples/calc.coil   =>  3 / 13 / 26 / 27
(module example.calc)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)  ; (slice u8) source text: slice-len / slice-get

(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.fmt" :use *)
(import "coil.io" :use *)

; ---- tokens ----------------------------------------------------------------
(defsum Tok
  (TNum [(v i64)])
  (TVar [(nm i64)])
  (TOp [(op i64)])  ; op = char code of + - * /
  (TLP)
  (TRP)
  (TEq)
  (TSemi)
  (TEnd))

(defn digit? [(c i64)] (-> bool)
  (and (>= c (cast i64 48)) (<= c (cast i64 57))))

(defn alpha? [(c i64)] (-> bool)
  (and (>= c (cast i64 97)) (<= c (cast i64 122))))

; ---- lexer: source C-string -> ArrayList<Tok> ------------------------------
(defn lex [(a (dyn Allocator)) (s (slice u8))] (-> (ArrayList Tok))
  (let [(mut toks) (al-new [Tok] a)
        (mut i) 0
        n (slice-len s)]
    (loop (if (>= (load i) n)
              (do (push! (mut toks) (TEnd)) (break))
              (let [c (primitive/cast :i64 (slice-get s (load i)))]
                (cond (= c (cast i64 32)) (set! i (primitive/iadd (load i) 1))
                      ; skip space
                      (digit? c)
                        (let [(mut v) 0]
                          (loop (if (>= (load i) n)
                                    (break)
                                    (let [d (primitive/cast :i64 (slice-get s (load i)))]
                                      (if (digit? d)
                                          (do
                                            (set! v (primitive/iadd (primitive/imul (load v) 10) (primitive/isub d 48)))
                                            (set! i (primitive/iadd (load i) 1)))
                                          (break)))))
                          (push! (mut toks) (TNum (load v))))
                      (alpha? c) (do (push! (mut toks) (TVar c)) (set! i (primitive/iadd (load i) 1)))
                      :else
                        (do
                          (push! (mut toks)
                                 (if (= c (cast i64 40))
                                     (TLP)
                                     (if (= c (cast i64 41))
                                         (TRP)
                                         (if (= c (cast i64 61))
                                             (TEq)
                                             (if (= c (cast i64 59)) (TSemi) (TOp c))))))
                          (set! i (primitive/iadd (load i) 1)))))))
    (load toks)))

; ---- AST (recursive sum via (ptr Ast)) -------------------------------------
(defsum Ast
  (Num [(v i64)])
  (Var [(nm i64)])
  (Bin [(op i64) (l (ptr Ast)) (r (ptr Ast))])
  (Set [(nm i64) (e (ptr Ast))]))

(defn ast [(a (dyn Allocator)) (x Ast)] (-> (ptr Ast))
  (box! a Ast x))

; ---- parser: a cursor over the token array ---------------------------------
(defstruct P [(t (ptr Tok)) (pos i64) (a (dyn Allocator))])

(defn peek [(p (ptr P))] (-> Tok)
  (load (primitive/index (load (field p t))
                         (.pos p))))

(defn adv [(p (ptr P))] (-> i64)
  (set! (.pos p)
        (primitive/iadd (.pos p)
                        1))
  0)

; primary = NUM | VAR | '(' expr ')'
(defn parse-primary [(p (ptr P))] (-> (ptr Ast))
  (match (peek p)
    (TNum [v] (do (adv p) (ast (.a p) (Num v))))
    (TVar [nm] (do (adv p) (ast (.a p) (Var nm))))
    (TLP []
         (do
           (adv p)
           (let [e (parse-expr p)]
             (adv p)  ; consume ')'
             e)))
    (TOp [_] (ast (.a p) (Num 0)))  ; malformed; degrade to 0
    (TRP [] (ast (.a p) (Num 0)))
    (TEq [] (ast (.a p) (Num 0)))
    (TSemi [] (ast (.a p) (Num 0)))
    (TEnd [] (ast (.a p) (Num 0)))))

; term = primary (('*'|'/') primary)*
(defn parse-term [(p (ptr P))] (-> (ptr Ast))
  (let [(mut acc) (parse-primary p)]
    (loop (match (peek p)
            (TOp [op]
                 (if (or (= op (cast i64 42)) (= op (cast i64 47)))
                     (do
                       (adv p)
                       (set! acc
                             (ast (.a p)
                                  (Bin
                                    :op op
                                    :l (load acc)
                                    :r (parse-primary p)))))
                     (break)))  ; the (break) branch is Never — unifies with the (ptr Ast) branch
            (TNum [_] (break))
            (TVar [_] (break))
            (TLP [] (break))
            (TRP [] (break))
            (TEq [] (break))
            (TSemi [] (break))
            (TEnd [] (break))))
    (load acc)))

; expr = term (('+'|'-') term)*
(defn parse-expr [(p (ptr P))] (-> (ptr Ast))
  (let [(mut acc) (parse-term p)]
    (loop (match (peek p)
            (TOp [op]
                 (if (or (= op (cast i64 43)) (= op (cast i64 45)))
                     (do
                       (adv p)
                       (set! acc
                             (ast (.a p)
                                  (Bin
                                    :op op
                                    :l (load acc)
                                    :r (parse-term p)))))
                     (break)))
            (TNum [_] (break))
            (TVar [_] (break))
            (TLP [] (break))
            (TRP [] (break))
            (TEq [] (break))
            (TSemi [] (break))
            (TEnd [] (break))))
    (load acc)))

; stmt = VAR '=' expr | expr   (lookahead: a TVar immediately followed by TEq)
(defn parse-stmt [(p (ptr P))] (-> (ptr Ast))
  (match (peek p)
    (TVar [nm]
          (if (is-eq (load (primitive/index (load (field p t))
                                            (primitive/iadd (load (field p
                                                                         pos))
                                                            1))))
              (do
                (adv p)
                (adv p)  ; consume VAR and '='
                (ast (.a p) (Set nm (parse-expr p))))
              (parse-expr p)))
    (TNum [_] (parse-expr p))
    (TOp [_] (parse-expr p))
    (TLP [] (parse-expr p))
    (TRP [] (parse-expr p))
    (TEq [] (parse-expr p))
    (TSemi [] (parse-expr p))
    (TEnd [] (parse-expr p))))

(defn is-eq [(t Tok)] (-> bool)
  (match t
    (TEq [] true)
    (TNum [_] false)
    (TVar [_] false)
    (TOp [_] false)
    (TLP [] false)
    (TRP [] false)
    (TSemi [] false)
    (TEnd [] false)))

; ---- eval ------------------------------------------------------------------
(defn ev [(n (ptr Ast)) (env (mut (HashMap i64 i64)))] (-> i64)
  (match (load n)
    (Num [v] v)
    (Var [nm] (match (get env nm) (None [] 0) (Some [v] v)))
    (Bin [op l r]
         (let [x (ev l (mut env))
               y (ev r (mut env))]
           (cond (= op (cast i64 43)) (primitive/iadd x y)
                 (= op (cast i64 45)) (primitive/isub x y)
                 (= op (cast i64 42)) (primitive/imul x y)
                 :else (primitive/idiv x y))))
    (Set [nm e]
         (let [v (ev e (mut env))]
           (set! (mut env) nm v)
           v))))

; ---- driver: lex, then parse+eval each ';'-separated statement, printing each --
(defn at-end [(p (ptr P))] (-> bool)
  (match (peek p)
    (TEnd [] true)
    (TNum [_] false)
    (TVar [_] false)
    (TOp [_] false)
    (TLP [] false)
    (TRP [] false)
    (TEq [] false)
    (TSemi [] false)))

(defn run [(a (dyn Allocator)) (w (ptr Writer)) (src (slice u8))] (-> i64)
  (let [(mut toks) (lex a src)
        pstate (primitive/alloc-stack P)]  ; a real (ptr P) the parser cursor shares
    (set! (.t pstate) (al-slice-data (mut toks)))
    (set! (.pos pstate) 0)
    (set! (.a pstate) a)
    (let [(mut env) (hm-new-scalar [i64 i64] a)
          (mut last) 0]
      (loop (if (at-end pstate)
                (break)
                (do
                  (set! last (ev (parse-stmt pstate) (mut env)))
                  (fmt w "{}\n" (load last))
                  (match (peek pstate)  ; consume a trailing ';' if present
                    (TSemi [] (adv pstate))
                    (TNum [_] 0)
                    (TVar [_] 0)
                    (TOp [_] 0)
                    (TLP [] 0)
                    (TRP [] 0)
                    (TEq [] 0)
                    (TEnd [] 0)))))
      (load last))))

; expose the ArrayList's element pointer for the parser cursor.
(defn al-slice-data [(l (mut (ArrayList Tok)))] (-> (ptr Tok))
  (.data l))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        w (stdout)]
    (run a w "1+2; 3+2*5; (3+10)*2; x=27; x")
    0))
