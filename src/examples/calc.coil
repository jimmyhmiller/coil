; A tiny calculator language: a lexer into an ArrayList of tokens, a
; recursive-descent parser into a boxed AST sum, and an evaluator with a HashMap
; of variables.
;
; A program is `;`-separated statements. A statement is `v=EXPR` (assign a
; single-letter variable) or EXPR, where EXPR is + - * / over integers, variables
; and parentheses, with the usual precedence. Each statement's value is printed.
;   coil run src/examples/calc.coil   => prints 3 / 13 / 26 / 27 / 27
(module example.calc)
(import "coil.alloc" :use [Allocator malloc-allocator box!])
(import "coil.arraylist" :use [ArrayList al-new al-free!])
(import "coil.hashmap" :use [HashMap hm-new-scalar hm-free!])

(defsum Tok
  (Number [(value i64)])
  (Name [(name i64)])  ; a single letter
  (Op [(op i64)])  ; the operator's character
  (Open)
  (Close)
  (Assign)
  (Semi)
  (End))

(defn digit? [(c i64)] (-> bool)
  (and (>= c #\0) (<= c #\9)))

(defn letter? [(c i64)] (-> bool)
  (and (>= c #\a) (<= c #\z)))

(defn lex [(a (dyn Allocator)) (s (slice u8))] (-> (ArrayList Tok))
  (let [(mut tokens) (al-new [Tok] a)
        (mut i) 0]
    (while (< i (len s))
      (let [c (cast i64 (get s i))]
        (cond (= c #\space) (set! i (+ i 1))
              (digit? c)
                (let [(mut value) 0]
                  (while (and (< i (len s)) (digit? (cast i64 (get s i))))
                    (set! value (+ (* value 10) (- (cast i64 (get s i)) #\0)))
                    (set! i (+ i 1)))
                  (push! (mut tokens) (Number value)))
              :else
                (do
                  (push! (mut tokens)
                         (cond (letter? c) (Name c)
                               (= c #\() (Open)
                               (= c #\)) (Close)
                               (= c #\=) (Assign)
                               (= c #\;) (Semi)
                               :else (Op c)))
                  (set! i (+ i 1))))))
    (push! (mut tokens) (End))
    tokens))

(defsum Ast
  (Lit [(value i64)])
  (Var [(name i64)])
  (Bin [(op i64) (left (ptr Ast)) (right (ptr Ast))])
  (Let [(name i64) (value (ptr Ast))]))

(defstruct Parser
  [(tokens (ArrayList Tok)) (pos i64) (allocator (dyn Allocator))])

(defn node [(p Parser) (x Ast)] (-> (ptr Ast))
  (box! (.allocator p) Ast x))

(defn peek [(p Parser)] (-> Tok)
  (get (.tokens p) (.pos p)))

(defn peek-next [(p Parser)] (-> Tok)
  (get (.tokens p) (+ (.pos p) 1)))

(defn advance! [(p (mut Parser))] (-> i64)
  (set! (.pos p) (+ (.pos p) 1)))

;;; The next token's operator character if it is `a` or `b`, else 0.
(defn peek-op [(p Parser) (a i64) (b i64)] (-> i64)
  (match (peek p)
    (Op [op] (if (or (= op a) (= op b)) op 0))
    (_ 0)))

;;; primary = NUMBER | NAME | '(' expr ')'
(defn parse-primary [(p (mut Parser))] (-> (ptr Ast))
  (let [token (peek p)]
    (advance! (mut p))
    (match token
      (Number [v] (node p (Lit v)))
      (Name [n] (node p (Var n)))
      (Open []
            (let [e (parse-expr (mut p))]
              (advance! (mut p))  ; )
              e))
      (_ (node p (Lit 0))))))  ; malformed input evaluates to 0

;;; term = primary (('*' | '/') primary)*
(defn parse-term [(p (mut Parser))] (-> (ptr Ast))
  (let [(mut left) (parse-primary (mut p))]
    (loop (let [op (peek-op p #\* #\/)]
            (when (= op 0) (break))
            (advance! (mut p))
            (set! left
                  (node p
                        (Bin
                          :op op
                          :left left
                          :right (parse-primary (mut p)))))))
    left))

;;; expr = term (('+' | '-') term)*
(defn parse-expr [(p (mut Parser))] (-> (ptr Ast))
  (let [(mut left) (parse-term (mut p))]
    (loop (let [op (peek-op p #\+ #\-)]
            (when (= op 0) (break))
            (advance! (mut p))
            (set! left
                  (node p
                        (Bin
                          :op op
                          :left left
                          :right (parse-term (mut p)))))))
    left))

;;; stmt = NAME '=' expr | expr
(defn parse-statement [(p (mut Parser))] (-> (ptr Ast))
  (match (peek p)
    (Name [n]
          (match (peek-next p)
            (Assign []
                    (advance! (mut p))
                    (advance! (mut p))
                    (node p (Let :name n :value (parse-expr (mut p)))))
            (_ (parse-expr (mut p)))))
    (_ (parse-expr (mut p)))))

(defn eval [(n (ptr Ast)) (env (mut (HashMap i64 i64)))] (-> i64)
  (match (load n)
    (Lit [v] v)
    (Var [name] (match (get env name) (Some [v] v) (None [] 0)))
    (Bin [op left right]
         (let [x (eval left (mut env))
               y (eval right (mut env))]
           (cond (= op #\+) (+ x y)
                 (= op #\-) (- x y)
                 (= op #\*) (* x y)
                 :else (/ x y))))
    (Let [name value]
         (let [v (eval value (mut env))]
           (set! (mut env) name v)
           v))))

(defn end? [(p Parser)] (-> bool)
  (match (peek p) (End [] true) (_ false)))

(defn run [(a (dyn Allocator)) (src (slice u8))] (-> i64)
  (let [(mut p)
          (Parser
            :tokens (lex a src)
            :pos 0
            :allocator a)
        (mut env) (hm-new-scalar [i64 i64] a)
        (mut last) 0]
    (while (not (end? p))
      (set! last (eval (parse-statement (mut p)) (mut env)))
      (println "{}" last)
      (match (peek p) (Semi [] (advance! (mut p))) (_ 0)))
    (hm-free! (mut env))
    (al-free! (mut (.tokens p)))
    last))

(defn main [] (-> i64)
  (run (malloc-allocator) "1+2; 3+2*5; (3+10)*2; x=27; x")
  0)
