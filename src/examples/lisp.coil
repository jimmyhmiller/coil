; A mini-Lisp interpreter with closures, `define`, and recursion. Parsing is one
; call to `coil.reader`, the same s-expression reader the compiler uses, so only
; eval is written here.
;
;   (define fact (lambda (n) (if (= n 0) 1 (* n (fact (- n 1)))))) (fact 10)
;
;   coil run src/examples/lisp.coil   => fact 10 = 3628800 / fib 15 = 610 / sq 9 = 81
(module example.lisp)
(import "coil.alloc" :use [Allocator malloc-allocator box!])
(import "coil.arraylist" :use [ArrayList al-new al-elem])
(import "coil.hashmap" :use [HashMap hm-new])
(import "coil.str" :use [str-keyops])
(import "coil.io" :use [stderr])
(import "coil.reader"
        :use
        [Sexp
         Diag
         read-all
         sexp-int?
         sexp-int
         sexp-sym?
         sexp-sym
         sexp-sym-is
         sexp-nth
         sexp-count])

(defsum Value
  (VNum [(v i64)])
  (VClosure [(params (ptr (ArrayList (slice u8))))
             (body (ptr Sexp))
             (env (ptr Env))])
  (VNil))

(defstruct Env [(vars (HashMap (slice u8) Value)) (parent (ptr Env))])

(defn no-env [] (-> (ptr Env))
  (cast (ptr Env) 0))

(defn env-new [(a (dyn Allocator)) (parent (ptr Env))] (-> (ptr Env))
  (box! a
        Env
        (Env :vars (hm-new [(slice u8) Value] a (str-keyops)) :parent parent)))

(defn lookup [(e (ptr Env)) (name (slice u8))] (-> Value)
  (if (= e (no-env))
      (VNil)
      (match (get (.vars e) name)
        (Some [v] v)
        (None [] (lookup (.parent e) name)))))

(defn define! [(e (ptr Env)) (name (slice u8)) (v Value)] (-> i64)
  (set! (mut (.vars e)) name v))

(defn num-of [(v Value)] (-> i64)
  (match v (VNum [n] n) (_ 0)))

(defn eval [(x (ptr Sexp)) (env (ptr Env)) (a (dyn Allocator))] (-> Value)
  (cond (sexp-int? x) (VNum (sexp-int x))
        (sexp-sym? x) (lookup env (sexp-sym x))
        :else
        ; A list: a special form, or a call. `sexp-sym-is` is false for a non-symbol
        ; head, so `((lambda …) …)` falls through to `apply`.
        (let [head (sexp-nth x 0)]
          (case-by head
                   sexp-sym-is
                   "if"
                   (if (= (num-of (eval (sexp-nth x 1) env a)) 0)
                       (eval (sexp-nth x 3) env a)
                       (eval (sexp-nth x 2) env a))
                   "lambda"
                   (make-closure (sexp-nth x 1) (sexp-nth x 2) env a)
                   "define"
                   (do
                     (define! env
                              (sexp-sym (sexp-nth x 1))
                              (eval (sexp-nth x 2) env a))
                     (VNil))
                   (apply head x env a)))))

(defn make-closure [(params (ptr Sexp))
                    (body (ptr Sexp))
                    (env (ptr Env))
                    (a (dyn Allocator))] (-> Value)
  (let [(mut names) (al-new [(slice u8)] a)]
    (for i
      (range 0 (sexp-count params))
      (push! (mut names) (sexp-sym (sexp-nth params i))))
    (VClosure
      :params (box! a (ArrayList (slice u8)) names)
      :body body
      :env env)))

(defn arg [(x (ptr Sexp)) (i i64) (env (ptr Env)) (a (dyn Allocator))] (-> i64)
  (num-of (eval (sexp-nth x i) env a)))

(defn apply [(head (ptr Sexp))
             (x (ptr Sexp))
             (env (ptr Env))
             (a (dyn Allocator))] (-> Value)
  (case-by head
           sexp-sym-is
           "+"
           (VNum (+ (arg x 1 env a) (arg x 2 env a)))
           "-"
           (VNum (- (arg x 1 env a) (arg x 2 env a)))
           "*"
           (VNum (* (arg x 1 env a) (arg x 2 env a)))
           "/"
           (VNum (/ (arg x 1 env a) (arg x 2 env a)))
           "="
           (VNum (if (= (arg x 1 env a) (arg x 2 env a)) 1 0))
           "<"
           (VNum (if (< (arg x 1 env a) (arg x 2 env a)) 1 0))
           (call-closure (eval head env a) x env a)))

(defn call-closure [(f Value)
                    (x (ptr Sexp))
                    (env (ptr Env))
                    (a (dyn Allocator))] (-> Value)
  (match f
    (VClosure [params body closure-env]
              (let [frame (env-new a closure-env)]
                (for i
                  (range 0 (len params))
                  (define! frame
                           (get params i)
                           (eval (sexp-nth x (+ i 1)) env a)))
                (eval body frame a)))
    (_ (VNil))))

;;; Read every top-level form, evaluate each, and return the last value.
(defn run [(src (slice u8)) (a (dyn Allocator))] (-> i64)
  (match (read-all a src 0)
    (Err [d]
         (fmt (stderr) "read error: {}\n" (.msg d))
         0)
    (Ok [forms]
        (let [globals (env-new a (no-env))
              (mut result) 0]
          (for i
            (range 0 (len forms))
            (set! result (num-of (eval (al-elem [Sexp] forms i) globals a))))
          result))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)]
    (println "fact 10 = {}"
             (run "(define fact (lambda (n) (if (= n 0) 1 (* n (fact (- n 1)))))) (fact 10)"
                  a))
    (println "fib 15  = {}"
             (run "(define fib (lambda (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))) (fib 15)"
                  a))
    (println "sq 9    = {}" (run "((lambda (x) (* x x)) 9)" a))
    0))
