; Arbitrary-width integers: iN / uN for any N, with real unsigned semantics.
;   coil run src/examples/widths.coil; echo $?   => 42
(module example.widths)

(defstruct Pixel [(r u8) (g u8) (b u8) (a u8)])

(defn main [] (-> i64)
  (let [px
          (Pixel
            :r 200
            :g 50
            :b 0
            :a 255)
        ratio (/ (.r px) (.g px))]  ; u8 division: 200 / 50 = 4
    (+ (* (cast i64 ratio) 10)
       (cast i64 (cast u2 6)))))  ; a u2 holds 6 mod 4 = 2
