(module example.widths)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
; Zig-style arbitrary-width integers: iN / uN for any N, with real signed and
; unsigned semantics (sext vs zext, sdiv vs udiv, signed vs unsigned compare).
;   coil run src/examples/widths.coil; echo $?   => 42

(defstruct Pixel [(r :u8) (g :u8) (b :u8) (a :u8)])  ; four 8-bit channels

(defn main [] (-> :i64)
  (let [px (primitive/alloc-stack Pixel)]
    (set! (.r px) (primitive/cast :u8 200))
    (set! (.g px) (primitive/cast :u8 50))
    (let [ratio (primitive/idiv (.r px) (.g px))]  ; unsigned 200/50 = 4
      (primitive/iadd (primitive/imul (primitive/cast :i64 ratio) 10)  ; 40
                      (primitive/cast :i64 (primitive/cast :u2 6))))))  ; u2: 6 mod 4 = 2  -> 42
