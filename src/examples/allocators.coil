; Allocators are values. `boxed-add` takes a `(dyn Allocator)`, so its signature
; says it allocates, and the caller picks the strategy. Failure is an Option.
;   coil run src/examples/allocators.coil; echo $?   => 42
(module example.allocators)
(import "coil.alloc"
        :use
        [Allocator malloc-allocator arena-allocator box destroy])

(defn boxed-add [(a (dyn Allocator)) (x i64) (y i64)] (-> i64)
  (match (box a i64 (+ x y))
    (None [] 0)  ; out of memory
    (Some [p]
          (let [v (load p)]
            (destroy a p)
            v))))

(defn main [] (-> i64)
  (+ (boxed-add (malloc-allocator) 30 5)  ; libc malloc: 35
     (boxed-add (arena-allocator 1024) 5 2)))  ; a bump arena: 7
