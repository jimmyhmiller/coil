(module example.jit-expose.demo)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
(import "coil.jit.environment" :as env)
(import "example.jit-expose.app" :as app)
(import "example.jit-expose.expose" :use [expose-app])

;;; Hands a program's own definitions to a JIT session, then compiles new code
;;; against them. Run it with:
;;;   coil run src/examples/jit_expose/demo.coil
;;; Exit 0 means every step behaved as expected.
(transform expose-app)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        text (app-environment)
        adopted (jit/jit-session-set-environment! (mut session) text)]
    (env/environment-free! text)
    (println "1. the session adopts the program as its environment: status {}" adopted)
    (cond
      (!= adopted 0) (do (println "   {}" (jit/jit-diagnostic (mut session))) 1)

      ; New code calls the program's own functions and uses its type. It type
      ; checks against their real signatures, and running it runs the real code.
      (!= (jit/jit-compile-with-entry! (mut session)
            "(module example.jit-expose.app)
             (defn demo [] (-> i64) (clamp (area (scaled (Point :x 3 :y 4) 10))))"
            "(if (= (example.jit-expose.app.demo) 100) 0 1)") 0)
        (do (println "   new code failed: {}" (jit/jit-diagnostic (mut session))) 2)
      :else
        (do
          (println "2. new code calls scaled, area and clamp: ok (3x4 scaled by 10 is 1200, clamped to 100)")
          (println "   the program's own counter saw the call: calls = {}" (get app/calls))
          (cond
            (!= (get app/calls) 1) 3

            ; The type checker holds the new code to the real signatures.
            (= (jit/jit-compile! (mut session)
                 "(module example.jit-expose.app)
                  (defn wrong-type [] (-> i64) (area 5))") 0)
              4
            :else
              (do
                (println "3. a call with the wrong type is rejected:")
                (println "{}" (jit/jit-diagnostic (mut session)))
                (cond
                  ; So is a call to something that does not exist.
                  (= (jit/jit-compile! (mut session)
                       "(module example.jit-expose.app)
                        (defn missing [] (-> i64) (no-such-function 1))") 0)
                    5
                  :else
                    (do
                      (println "4. a call to a function the program does not have is rejected:")
                      (println "{}" (jit/jit-diagnostic (mut session)))
                      (cond
                        ; Storage is shared: a write in the session is seen by the program.
                        (!= (jit/jit-compile-with-entry! (mut session)
                              "(module example.jit-expose.app)
                               (defn reset-calls [] (-> i64) (set calls 41) 0)"
                              "(example.jit-expose.app.reset-calls)") 0)
                          6
                        (!= (get app/calls) 41) 7
                        :else
                          (do
                            (println "5. the session wrote calls = 41 and the program reads {}" (get app/calls))
                            (jit/jit-reset! (mut session))
                            0))))))))))
