(module example.jit-expose.app)
(import "coil.var" :use [var-static])

;;; A small application. Nothing here mentions the JIT: the types, functions and
;;; globals are ordinary, and expose.coil decides what to hand to a session.

(defstruct Point [(x i64) (y i64)])

;;; A global that changes, and one that does not.
(def calls (var-static i64 0))
(def limit 100)

(defn area [(p Point)] (-> i64)
  (set calls (+ (get calls) 1))
  (* (.x p) (.y p)))

(defn scaled [(p Point) (k i64)] (-> Point)
  (Point :x (* (.x p) k) :y (* (.y p) k)))

(defn clamp [(n i64)] (-> i64) (if (> n limit) limit n))
