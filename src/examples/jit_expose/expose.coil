(module example.jit-expose.expose)
(import "coil.meta" :as meta)

;;; The metaprogram. It hands the application's top-level definitions to the host
;;; module, which gives them to a JIT session. All of the policy is here. `coil.meta`
;;; only answers questions about the program and offers `embed-environment` to build
;;; the text, and the compiler does nothing with either unless this calls them.
;;;
;;; `(meta/definitions app)` lists every definition of the module, so everything is
;;; handed over. To hand over less, pass a smaller list: `(list (a b))` of names.
(defn expose-app [(modules Code)] (-> Code)
  (let [app `example.jit-expose.app]
    (meta/transform-result
      (meta/embed-environment modules `example.jit-expose.demo "app-environment"
                              `(~app) (meta/definitions app)))))
