; `nl`, number lines. Reader and Writer are ordinary records of a function
; pointer and a context, so a program can add its own backends and compose them:
;   * a Reader over an in-memory byte slice;
;   * a Writer that wraps another Writer and counts the bytes through it.
;   coil run src/examples/nl.coil   => prints 1  alpha / 2  beta / 3  gamma, exits 3
(module example.nl)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.io" :use [Reader Writer IoError read-some write-some stdout])
(import "coil.slice" :use [slice-data slice-new subslice])
(import "coil.str" :use [StrBuf sb-new sb-push-str! sb-str])

(extern memcpy :cc c [(ptr i8) (ptr i8) i64] (-> (ptr i8)))

;;; A Reader backend: the context is a cursor into a byte slice.
(defstruct SliceReader [(bytes (slice u8)) (pos i64)])

(defn slice-read [(ctx (ptr i8)) (buf (ptr i8)) (n i64)] (-> (Result i64
                                                                     IoError))
  (let [sr (cast (ptr SliceReader) ctx)
        available (- (len (.bytes sr)) (.pos sr))
        k (if (< n available) n available)]
    (when (> k 0)
      (memcpy buf (cast (ptr i8) (index (slice-data (.bytes sr)) (.pos sr))) k)
      (set! (.pos sr) (+ (.pos sr) k)))
    (Ok k)))  ; 0 is end of input

(defn slice-reader [(sr (ptr SliceReader))] (-> Reader)
  (Reader :read-fn (fnptr-of slice-read) :ctx (cast (ptr i8) sr)))

;;; A Writer backend that decorates another Writer.
(defstruct CountWriter [(inner (ptr Writer)) (count i64)])

(defn count-write [(ctx (ptr i8)) (buf (ptr i8)) (n i64)] (-> (Result i64
                                                                      IoError))
  (let [cw (cast (ptr CountWriter) ctx)]
    (match (write-some (.inner cw) buf n)
      (Ok [k] (set! (.count cw) (+ (.count cw) k)) (Ok k))
      (Err [e] (Err e)))))

(defn count-writer [(cw (ptr CountWriter))] (-> Writer)
  (Writer :write-fn (fnptr-of count-write) :ctx (cast (ptr i8) cw)))

;;; Drain a Reader into an allocator-backed buffer, 64 bytes at a time.
(defn read-all [(a (dyn Allocator)) (r (ptr Reader))] (-> StrBuf)
  (let [(mut text) (sb-new a)
        (mut chunk) (zeroed (array u8 64))
        bytes (: (mut chunk) (slice u8))]
    (loop (match (read-some r (cast (ptr i8) (mut chunk)) 64)
            (Ok [k]
                (if (> k 0)
                    (sb-push-str! (mut text) (subslice bytes 0 k))
                    (break)))
            (Err [_] (break))))
    text))

(defn emit-line [(w (ptr Writer)) (number i64) (line (slice u8))] (-> i64)
  (fmt w "{}  {}\n" number line)
  number)

;;; Write each line of `text` with its number; returns how many lines there were.
(defn number-lines [(w (ptr Writer)) (text (slice u8))] (-> i64)
  (let [(mut start) 0
        (mut lines) 0]
    (for i
      (range 0 (len text))
      (when (= (get text i) #\newline)
        (set! lines (emit-line w (+ lines 1) (subslice text start i)))
        (set! start (+ i 1))))
    (when (> (len text) start)  ; a final line with no newline
      (set! lines (emit-line w (+ lines 1) (subslice text start (len text)))))
    lines))

(defn main [] (-> i64)
  (let [(mut source) (SliceReader :bytes "alpha\nbeta\ngamma" :pos 0)
        (mut counter) (CountWriter :inner (stdout) :count 0)
        (mut reader) (slice-reader (mut source))
        (mut writer) (count-writer (mut counter))
        text (read-all (malloc-allocator) (mut reader))]
    (number-lines (mut writer) (sb-str text))))
