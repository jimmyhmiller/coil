; Four threads each atomically increment one shared counter 100,000 times. The
; total is exactly 400,000 only if `atomic/add` really synchronizes.
;   coil run src/examples/threads.coil; echo $?   => 0
(module example.threads)
(import "coil.alloc" :as alloc)
(import "coil.atomic" :use [add read])
(import "coil.thread" :use [Thread])

(defn worker [(arg (ptr i8))] (-> (ptr i8))
  (let [counter (cast (ptr i64) arg)]
    (for _ (range 0 100000) (add counter 1)))
  (cast (ptr i8) 0))

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        ; Shared state lives on the heap: every thread gets the same address.
        counter (alloc/box! a i64 0)
        threads (alloc/box! a (array Thread 4) (zeroed (array Thread 4)))]
    (for i
      (range 0 4)
      (Thread::spawn (index threads i) (fnptr-of worker) (cast (ptr i8) counter)))
    (for i
      (range 0 4)
      (join (index threads i)))
    (let [total (read counter)]
      (alloc/destroy a threads)
      (alloc/destroy a counter)
      (- total 400000))))
