; Concurrency dogfood: N worker threads each do M atomic increments on a SHARED

; counter. The result is exactly N·M — race-free — proving the atomic library (over
; llvm-ir, zero core feature) genuinely synchronizes across real threads. A plain
; load+add+store would race and lose updates (shown in tests/threads.rs as a
; demonstration — non-deterministic, so NOT an asserted test).
;   coil run src/examples/threads.coil; echo $?   => 0   (counter == 4 * 100000)
(module example.threads)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.atomic" :use *)
(import "coil.thread" :use *)

(defn worker [(arg (ptr i8))] (-> (ptr i8))
  (let [counter (primitive/cast (ptr i64) arg)
        (mut i) 0]
    (loop (if (>= (load i) (cast i64 100000))
              (break)
              (do
                (atomic-add counter 1)  ; the atomic fetch-add
                (set! i (primitive/iadd (load i) 1))))))
  (primitive/cast (ptr i8) 0))

(defn main [] (-> :i64)
  (let [counter (primitive/alloc-stack i64)
        threads (primitive/alloc-stack (array Thread 4))
        (mut i) 0]
    (set! counter 0)
    ; spawn 4 workers, all sharing `counter`
    (loop (if (>= (load i) (cast i64 4))
              (break)
              (do
                (thread-spawn (primitive/index threads (load i))
                              (primitive/fnptr-of worker)
                              (primitive/cast (ptr i8) counter))
                (set! i (primitive/iadd (load i) 1)))))
    ; join them all
    (set! i 0)
    (loop (if (>= (load i) (cast i64 4))
              (break)
              (do
                (thread-join (primitive/index threads (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (primitive/isub (load counter) 400000)))  ; 0 iff race-free (4 threads x 100k)
