; A calling convention LLVM implements is a coil.cc.NativeCc value: a function
; names it with `:cc` and needs no defcc. `count-down` is tailcc, so its call in
; tail position is a guaranteed jump however deep it recurses; `add` is fastcc.
;   coil emit-ir src/examples/conventions.coil   => `add` is fastcc, `count-down` tailcc
;   coil run src/examples/conventions.coil; echo $?   => 42
(module example.conventions)
(import "coil.cc" :as cc)

(defn add :cc (cc/Fast) [(a i64) (b i64)] (-> i64)
  (+ a b))

(defn count-down :cc (cc/Tail) [(n i64) (acc i64)] (-> i64)
  (if (= n 0) acc (count-down (- n 1) (+ acc 1))))

(defn main [] (-> i64)
  (add 20 (count-down 22 0)))
