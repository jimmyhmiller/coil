; A user-defined calling convention. `:lower (cc/Native (cc/Fast))` lowers it to LLVM's fastcc;
; the register lists are recorded but LLVM places the arguments itself.
;   coil emit-ir src/examples/conventions.coil   => `add` is a fastcc function
;   coil run src/examples/conventions.coil; echo $?   => 42
(module example.conventions)
(import "coil.cc" :as cc)

(defcc fast2
  :params [rax rdx]
  :ret rax
  :clobber [rax rdx rcx]
  :preserve [rbx rbp]
  :lower (cc/Native (cc/Fast)))

(defn add :cc fast2 [(a i64) (b i64)] (-> i64)
  (+ a b))

(defn main [] (-> i64)
  (add 20 22))
