; Structs and arrays: named construction, `.field` reads, `set!` writes, and
; arrays through the collection traits.
;   coil run src/examples/structs.coil; echo $?   => 42
(module example.structs)

(defstruct Point [(x i64) (y i64)])

(defn main [] (-> i64)
  (let [(mut p) (Point :x 0 :y 4)
        (mut a) [1 2 0]]
    (set! (.x p) 30)
    (set! (mut a) 2 5)
    (+ (.x p) (.y p) (fold (fn [total x] (+ total x)) 0 a))))
