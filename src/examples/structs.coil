(module example.structs)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
; Structs and arrays. A struct field or array element is reached as a *pointer*
; (via `field` / `index`), then read/written with `load` / `store!`.
;   coil run src/examples/structs.coil; echo $?   => 42

(defstruct Point [(x :i64) (y :i64)])

(defn main [] (-> :i64)
  (let [p (alloc/stack Point)            ; pointer to a stack Point
        a (alloc/stack (array i64 3))]   ; pointer to a stack [3 x i64]
    (store! (field p x) 30)
    (store! (field p y) 4)
    (store! (primitive/index a 0) 1)
    (store! (primitive/index a 1) 2)
    (store! (primitive/index a 2) 5)
    (primitive/iadd (primitive/iadd (load (field p x)) (load (field p y)))         ; 30 + 4
          (primitive/iadd (load (primitive/index a 0))
                (primitive/iadd (load (primitive/index a 1)) (load (primitive/index a 2))))))) ; 1 + 2 + 5
