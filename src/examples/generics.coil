; Generics are monomorphized: each instantiation gets its own copy (see
; `coil emit-ir`). Type arguments are inferred from the value arguments.
;   coil run src/examples/generics.coil; echo $?   => 42
(module example.generics)

(defn id [T] [(x T)] (-> T)
  x)

(defstruct Pair [A B] [(fst A) (snd B)])

(defn pair-sum [(T Add)] [(p (Pair T T))] (-> T)
  (+ (.fst p) (.snd p)))

(defn main [] (-> i64)
  (let [p (Pair :fst (id 40) :snd 2)]  ; A = B = i64, inferred
    (pair-sum p)))  ; T = i64, inferred
