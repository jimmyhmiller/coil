(module example.allocation)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

; Allocation is an OPERATION, not part of the pointer type (Zig/C-style).
; `(ptr T)` is region-less -- just a pointer. *Where* memory comes from is the
; choice: initialized mutable local, explicit low-level static storage, or an
; allocator-owned box. No regions, lifetimes, or escape checks.
;   coil run src/examples/allocation.coil; echo $?  =>  42
(defn make [(v :i64)] (-> (ptr i64))
  (alloc/box! (alloc/malloc-allocator) i64 v))

(defn main [] (-> :i64)
  (let [h (make 10)  ; heap pointer from another function
        s (primitive/alloc-static i64)  ; a global
        (mut f) 2]  ; initialized frame storage
    (set! s 30)
    (let [sum (primitive/iadd (load h) (primitive/iadd (load s) (load f)))]
      (alloc/destroy [i64] (alloc/malloc-allocator) h)
      sum)))  ; 10 + 30 + 2 = 42
