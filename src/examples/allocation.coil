; Where memory comes from is an operation, not part of the pointer type: an
; allocator-owned box, low-level static storage, or an initialized local.
;   coil run src/examples/allocation.coil; echo $?   => 42
(module example.allocation)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)

(defn make [(v i64)] (-> (ptr i64))
  (alloc/box! (alloc/malloc-allocator) i64 v))

(defn main [] (-> i64)
  (let [heap (make 10)  ; outlives the function that made it
        global
          (primitive/alloc-static i64)  ; static storage, lives for the program
        (mut local) 2]  ; frame storage
    (store! global 30)
    (let [sum (+ (load heap) (+ (load global) local))]
      (alloc/destroy (alloc/malloc-allocator) heap)
      sum)))
