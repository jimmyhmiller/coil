; Calling real C libraries across the C ABI:
;   * qsort with a Coil comparator that C calls back into;
;   * libm sqrt/pow (f64 arguments and results);
;   * libc div, which returns a struct by value;
;   * libc strtol, which takes a C string.
; Each computes 42 independently; main returns 42 only if they all agree.
;   coil run src/examples/cinterop.coil; echo $?   => 42
(module example.cinterop)

(extern qsort
        :cc
        c
        [(ptr i8) i64 i64 (fnptr c [(ptr i8) (ptr i8)] i32)]
        (-> void))

(extern sqrt :cc c [f64] (-> f64))

(extern pow :cc c [f64 f64] (-> f64))

(extern strtol :cc c [(ptr i8) (ptr i8) i32] (-> i64))

(defstruct DivT [(quot i32) (rem i32)])

(extern div :cc c [i32 i32] (-> DivT))

;;; The comparator C's qsort calls back into.
(defn compare-i64 [(a (ptr i8)) (b (ptr i8))] (-> i32)
  (let [x (load (cast (ptr i64) a))
        y (load (cast (ptr i64) b))]
    (cond (< x y) -1
          (> x y) 1
          :else 0)))

(defn sorted? [(xs (slice i64))] (-> bool)
  (let [(mut ok) true]
    (for i
      (range 1 (len xs))
      (when (> (get xs (- i 1)) (get xs i)) (set! ok false)))
    ok))

(defn main [] (-> i64)
  (let [(mut values) (zeroed (array i64 6))
        xs (: (mut values) (slice i64))]
    ; Filled element by element: the direct x86-64 backend cannot yet lower an
    ; array literal (initialized static storage), and this example is in its corpus.
    (set! (mut values) 0 30)
    (set! (mut values) 1 10)
    (set! (mut values) 2 50)
    (set! (mut values) 3 42)
    (set! (mut values) 4 20)
    (set! (mut values) 5 40)
    (qsort (cast (ptr i8) (mut values)) (len xs) 8 (fnptr-of compare-i64))
    (let [root (cast i64 (sqrt 1764.0))  ; 42.0
          power (cast i64 (pow 6.0 1.0))  ; 6.0, times 7 below
          parsed (strtol c"42" (cast (ptr i8) 0) 10)
          d (div 84 2)]  ; {quot 42, rem 0}
      (if (and (sorted? xs)
               (= (get xs 4) 42)  ; sorted: [10 20 30 40 42 50]
               (= root 42)
               (= (* power 7) 42)
               (= parsed 42)
               (= (cast i64 (.quot d)) 42))
          42
          0))))
