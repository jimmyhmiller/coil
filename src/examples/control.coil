; Control-flow macros: `inline-for` unrolls at compile time; `when`, `unless` and
; `cond` are ordinary library macros over `if`.
;   coil run src/examples/control.coil; echo $?   => 46
(module example.control)

(defn main [] (-> i64)
  (let [(mut acc) 0]
    (inline-for [i 0 4] (set! acc (+ acc i)))  ; i is the literal 0, 1, 2, 3 -> 6
    (when (= acc 6) (set! acc (+ acc 10)))  ; -> 16
    (unless (= acc 0) (set! acc (+ acc 5)))  ; -> 21
    (let [bucket
            (cond (< acc 10) 1
                  (< acc 30) 2
                  :else 3)]
      (+ (* (+ acc 1) 2) bucket))))  ; (21 + 1) * 2 + 2
