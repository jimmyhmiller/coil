; Control-flow sugar from src/stdlib/control.coil — all pure macros, nothing in the
; compiler knows about them.
;   coil run src/examples/control.coil; echo $?   => 46
(module app)
(import "coil.primitive" :as primitive)
(import "coil.control" :use *)

(defn main [] (-> :i64)
  (let [(mut acc) 0]
    ; `inline-for` fully unrolls at compile time: i = 0,1,2,3 as literals.
    (inline-for [i 0 4] (store! acc (primitive/iadd (load acc) i)))  ; 0+1+2+3 = 6
    ; `when` / `unless` desugar to `if` over `do`.
    (when (= (load acc) (cast i64 6)) (store! acc (primitive/iadd (load acc) 10)))  ; -> 16
    (unless (= (load acc) (cast i64 0)) (store! acc (primitive/iadd (load acc) 5)))  ; -> 21
    ; `cond` desugars to nested `if`s; a lone trailing clause is the else.
    (let [c
            (cond (< (load acc) (cast i64 10)) 1
                  (< (load acc) (cast i64 30)) 2
                  3)]  ; 21 -> 2
      (primitive/iadd (primitive/imul (primitive/iadd (load acc) 1) 2) c))))  ; (21+1)*2 + 2 = 46
