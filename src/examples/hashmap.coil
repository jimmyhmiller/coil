; HashMap[K V] — open-addressing map as a library over the allocator + src/stdlib/mem.
; Hashing/equality are explicit capability values (a KeyOps vtable); hm-new-scalar
; supplies the safe byte-wise ops for scalar keys.
;   coil run src/examples/hashmap.coil; echo $?   => 42
(module example.hashmap)
(import "coil.primitive" :as primitive)
(import "coil.hashmap" :use *)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.control" :use *)

(defn main [] (-> :i64)
  (let [a (malloc-allocator)
        (mut m) (hm-new-scalar [i64 i64] a)]
    (for [i 0 30] (set! (mut m) i i))  ; 0..29, several resizes/rehashes
    (set! (mut m) 13 9)  ; update key 13 -> 9
    (hm-remove! (mut m) 1)  ; tombstone key 1
    (let [r
            (primitive/iadd (match (get m 13) (None [] -1) (Some [v] v))  ; 9
                            (len m))]  ; 29 -> 38? 9+29=38
      (hm-free! (mut m))
      (primitive/iadd r 4))))  ; 38 + 4 = 42
