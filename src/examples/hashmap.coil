; HashMap through the collection traits: three-argument `set!` inserts or
; updates, `get` returns an Option, `len` counts entries.
;   coil run src/examples/hashmap.coil; echo $?   => 42
(module example.hashmap)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.hashmap" :use [hm-new-scalar hm-remove! hm-free!])

(defn main [] (-> i64)
  (let [(mut m) (hm-new-scalar [i64 i64] (malloc-allocator))]
    (for i (range 0 30) (set! (mut m) i i))  ; forces several resizes
    (set! (mut m) 13 9)  ; update
    (hm-remove! (mut m) 1)
    (let [result
            (+ (match (get m 13) (Some [v] v) (None [] -1))  ; 9
               (len m))]  ; 29 entries
      (hm-free! (mut m))
      (+ result 4))))
