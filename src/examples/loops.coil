; Loops. `loop`/`break`/`continue` are the primitives; `for` and `while` are
; macros over them.
;   coil run src/examples/loops.coil; echo $?   => 55
(module example.loops)

;;; 1 + 2 + … + n with the primitive loop; `break` carries the loop's value.
(defn sum-to [(n i64)] (-> i64)
  (let [(mut i) 1
        (mut acc) 0]
    (loop (if (> i n)
              (break acc)
              (do
                (set! acc (+ acc i))
                (set! i (+ i 1)))))))

(defn count-evens [(n i64)] (-> i64)
  (let [(mut evens) 0]
    (for i
      (range 0 n)
      (when (= (% i 2) 1) (continue))
      (set! evens (+ evens 1)))
    evens))

(defn main [] (-> i64)
  (if (= (count-evens 10) 5) (sum-to 10) 0))
