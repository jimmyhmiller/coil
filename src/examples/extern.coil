; Calling C: `extern` declares a foreign function's convention and signature, and
; calls to it are type-checked like any other.
;   coil run src/examples/extern.coil   => prints: 12345
(module example.extern)
(import "coil.cc" :as cc)

(extern putchar :cc (cc/C) [i64] (-> i64))

(defn print-digits [(n i64)] (-> i64)
  (when (>= n 10) (print-digits (/ n 10)))
  (putchar (+ #\0 (% n 10))))

(defn main [] (-> i64)
  (print-digits 12345)
  (putchar #\newline)
  0)
