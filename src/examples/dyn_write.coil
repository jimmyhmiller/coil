; Trait objects: one `greet` writes to either a file descriptor or an in-memory
; buffer, chosen at run time, through `(dyn Write)`. A `(ptr T)` to any
; implementer converts to the trait object; the compiler builds the vtable.
;   coil run src/examples/dyn_write.coil   => prints: Hello, world! / Hello, memory!
(module example.dyn-write)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-data])

(extern write :cc c [i32 (ptr i8) isize] (-> isize))

(extern memcpy :cc c [(ptr i8) (ptr i8) i64] (-> (ptr i8)))

;;; Object-safe: the receiver is `(ptr Self)` and nothing else mentions Self.
(deftrait Write [Self]
  (emit [(self (ptr Self)) (bytes (slice u8))] (-> i64)))

(defstruct File [(fd i32)])

(impl Write File
  (emit [(self (ptr File)) (bytes (slice u8))]
        (-> i64)
        (cast i64
              (write (.fd self)
                     (cast (ptr i8) (slice-data bytes))
                     (cast isize (len bytes))))))

(defstruct MemBuf [(data (ptr u8)) (len i64) (cap i64)])

(impl Write MemBuf
  (emit [(self (ptr MemBuf)) (bytes (slice u8))]
        (-> i64)
        (let [n (len bytes)]
          (memcpy (cast (ptr i8) (index (.data self) (.len self)))
                  (cast (ptr i8) (slice-data bytes))
                  n)
          (set! (.len self) (+ (.len self) n))
          n)))

;;; Written once, against any Write.
(defn greet [(w (dyn Write)) (name (slice u8))] (-> i64)
  (emit w "Hello, ")
  (emit w name)
  (emit w "!\n"))

(defn main [] (-> i64)
  ; The implementers are boxed: converting to a trait object needs a pointer, and
  ; a `(mut local)` borrow is not accepted.
  (let [a (alloc/malloc-allocator)
        screen (alloc/box! a File (File :fd 1))
        storage (alloc/box! a (array u8 256) (zeroed (array u8 256)))
        memory
          (alloc/box! a
                      MemBuf
                      (MemBuf
                        :data (index storage 0)
                        :len 0
                        :cap 256))]
    (greet screen "world")
    (greet memory "memory")
    (write 1 (cast (ptr i8) (.data memory)) (cast isize (.len memory)))  ; show what was buffered
    (alloc/destroy a memory)
    (alloc/destroy a storage)
    (alloc/destroy a screen)
    0))
