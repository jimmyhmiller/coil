(module dyn_write)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
; Demo: one `greet` function that writes to either the screen (a File over an fd)
; or an in-memory buffer (MemBuf) — chosen at RUNTIME — via a `dyn Write` trait
; object. No hand-written vtables: `defdyn`/`dyn-impl` generate them by reflecting
; the trait. See src/stdlib/dyn.coil.

(import "coil.dyn" :use *)  ; bundled like the rest of the stdlib
(import "coil.slice" :use *)  ; slice-data / slice-len for (slice u8)

(extern write :cc c [i32 (ptr i8) isize] (-> isize))  ; ssize_t write(int fd, const void*, size_t)
(extern memcpy :cc c [(ptr i8) (ptr i8) :i64] (-> (ptr i8)))

; ---- the capability ---------------------------------------------------------
(deftrait Write [Self]
  (emit [(self (ptr Self)) (bytes (slice u8))] (-> i64)))

(defdyn Write)  ; => Write-vtable, Write-dyn, (impl Write Write-dyn ...)

; ---- an implementer: a file descriptor -------------------------------------
(defstruct File [(fd i64)])

(impl Write File
  (emit [(self (ptr File)) (bytes (slice u8))]
        (-> i64)
        (write (primitive/cast i32 (.fd self))
               (primitive/cast (ptr i8) (slice-data bytes))
               (primitive/cast isize (slice-len bytes)))))

; ---- another implementer: an in-memory buffer ------------------------------
(defstruct MemBuf [(data (ptr u8)) (len i64) (cap i64)])

(impl Write MemBuf
  (emit [(self (ptr MemBuf)) (bytes (slice u8))]
        (-> i64)
        (let [n (slice-len bytes)
              len (.len self)
              end (primitive/index (load (field self data)) len)]
          (memcpy (primitive/cast (ptr i8) end) (primitive/cast (ptr i8) (slice-data bytes)) n)
          (set! (.len self) (primitive/iadd len n))
          n)))

; ---- code written ONCE, against any Write ----------------------------------
(defn greet [(w (dyn Write)) (name (slice u8))] (-> i64)
  (emit w "Hello, ")
  (emit w name)
  (emit w "!\n"))

(defn main [] (-> i64)
  ; 1) write to the screen — a (ptr File) auto-erases to the (dyn Write) param
  (let [f (alloc/stack File)]
    (set! (.fd f) 1)
    (greet f "world"))
  
  ; 2) write the SAME greeting into memory, then flush it to the screen to prove
  (let [buf (alloc/stack (array u8 256))
        mb (alloc/stack MemBuf)]
    (set! (.data mb) (primitive/index buf 0))
    (set! (.len mb) 0)
    (set! (.cap mb) 256)
    (greet mb "memory")  ; (ptr MemBuf) auto-erases too
    ; flush the buffer to fd 1
    (write 1 (primitive/cast (ptr i8) (primitive/index buf 0)) (.len mb)))
  0)
