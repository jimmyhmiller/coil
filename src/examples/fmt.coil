; Type-directed formatting to an explicit Writer: `{}` uses Display, `{:x}` uses
; LowerHex, and `{{ }}` escape literal braces.
;   coil run src/examples/fmt.coil   => prints: n=-42 hex=ff ok=true
(module example.fmt)
(import "coil.io" :use [stdout])

(defn main [] (-> i64)
  (fmt (stdout) "n={} hex={:x} ok={}\n" -42 255 true)
  0)
