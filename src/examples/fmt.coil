; src/stdlib/fmt.coil — formatting over the explicit IO Writer (no ambient stdout).

;   coil run src/examples/fmt.coil    => prints: n=-42 hex=ff ok=true
(module example.fmt)
(import "coil.fmt" :use *)
(import "coil.io" :use *)
(import "coil.result" :use *)

(defn main [] (-> :i64)
  (let [w (stdout)]  ; the IO capability is passed in, not ambient
    ; `fmt` is a compile-time macro: {} dispatches Display by static type,
    ; {:x} dispatches LowerHex, and {{ }} escape literal braces.
    (fmt w "n={} hex={:x} ok={}\n" -42 255 true)
    0))
