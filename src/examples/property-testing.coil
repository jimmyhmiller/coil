(module example.property-testing)
(import "coil.prop" :use *)
(import "coil.arraylist" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.primitive" :as primitive)
; Property-based testing: state a law, and let the machine hunt for the smallest
; input that breaks it.
;
;   coil test src/examples/property-testing.coil
;
; Every property here HOLDS, so the file is green. The interesting part is what
; happens when one does not — see the bottom of the file for a transcript.

; ---------------------------------------------------------------- the basics
;
; Arguments are generated from each type's `Arbitrary` impl. Nothing to wire up,
; and — the part that matters — nothing to write for shrinking.

(defprop addition-commutes
         [(a i64) (b i64)]
         (= (primitive/iadd a b) (primitive/iadd b a)))

;; The arguments are `i32` widened to `i64` for a reason worth knowing about.
;;
;; Written over two `i64`s, this "law" is FALSE, and the first draft of this file
;; shipped it. The tool answered in under a second:
;;
;;     counterexample:
;;       a = -6181344920
;;       b = -1492130298
;;
;; — a product just past 2^63, where the multiply wraps and the division cannot
;; undo it. Note how close the shrunk values sit to the overflow boundary: that
;; is the shrinker reporting WHERE the law stops holding, not merely that it did.
;; Two i32s cannot overflow an i64 product, so the law below is true.
(defprop division-is-the-inverse-of-multiplication
         [(a i32) (b i32)]
         ; `assume` discards a case that does not meet the precondition. Prefer
         ; generating valid inputs to filtering invalid ones — the runner warns if too
         ; many cases are being thrown away, because a suite that discards 99% of what
         ; it generates is testing almost nothing.
         (assume (!= (primitive/cast i64 b) 0))
         (let [a64 (primitive/cast i64 a)
               b64 (primitive/cast i64 b)]
           (= (primitive/idiv (primitive/imul a64 b64) b64) a64)))

; ------------------------------------------------------------- collections
;
; A list argument is generated element by element, each element in its own span,
; which is what lets the shrinker delete elements one at a time — and delete runs
; of them at a time when that keeps working.

(defn list-sum [(xs (ArrayList i64))] (-> i64)
  (let [(mut total) 0
        (mut i) 0]
    (loop (if (>= (load i) (al-len [i64] xs))
              (break)
              (do
                (store! total (primitive/iadd (load total) (al-get [i64] xs (load i))))
                (store! i (primitive/iadd (load i) 1)))))
    (load total)))

(defn list-reverse [(xs (ArrayList i64))] (-> (ArrayList i64))
  (let [(mut out) (al-new [i64] (malloc-allocator))
        n (al-len [i64] xs)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! [i64] (mut out) (al-get [i64] xs (primitive/isub (primitive/isub n 1) (load i))))
                (store! i (primitive/iadd (load i) 1)))))
    (load out)))

(defn list-eq [(a (ArrayList i64)) (b (ArrayList i64))] (-> bool)
  (if (!= (al-len [i64] a) (al-len [i64] b))
      false
      (let [(mut i) 0
            (mut ok) true]
        (loop (if (or (>= (load i) (al-len [i64] a)) (not (load ok)))
                  (break)
                  (do
                    (if (= (al-get [i64] a (load i)) (al-get [i64] b (load i))) 0 (store! ok false))
                    (store! i (primitive/iadd (load i) 1)))))
        (load ok))))

(defprop reverse-is-its-own-inverse
         [(xs (ArrayList i64))]
         (list-eq (list-reverse (list-reverse xs)) xs))

(defprop reverse-preserves-the-sum
         [(xs (ArrayList i64))]
         ; `classify` records how often something was true. Run with COIL_PBT_VERBOSE=1
         ; to see the distribution — and find out that your "lists up to 60 elements"
         ; generator has been producing empty lists a third of the time.
         (classify "empty" (= (al-len [i64] xs) 0))
         (= (list-sum (list-reverse xs)) (list-sum xs)))

; ------------------------------------------------------- your own generator
;
; When the default distribution for a type is wrong for one property, draw the
; value yourself. `(prop-src)` is the Source this case is drawing from; every
; draw is recorded, so a hand-drawn value shrinks exactly like a generated one.

(defprop sorted-insert-keeps-it-sorted
         [(seed i64)]
         (let [s (prop-src)
               n (draw-len! s 0 20)
               (mut xs) (al-new [i64] (src-alloc s))
               (mut prev) 0
               (mut i) 0]
           ; a sorted list, built sorted — the invariant is established by the
           ; GENERATOR, so shrinking cannot break it. That is the whole argument for
           ; shrinking the choices instead of the value: a hand-written shrinker over
           ; the list would happily hand the property an unsorted counterexample.
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (store! prev (primitive/iadd (load prev) (draw-int! s 0 10)))
                       (al-push! [i64] (mut xs) (load prev))
                       (store! i (primitive/iadd (load i) 1)))))
           (let [(mut j) 1
                 (mut ok) true]
             (loop (if (or (>= (load j) (al-len [i64] (load xs))) (not (load ok)))
                       (break)
                       (do
                         (if (<= (al-get [i64] (load xs) (primitive/isub (load j) 1))
                                 (al-get [i64] (load xs) (load j)))
                             0
                             (store! ok false))
                         (store! j (primitive/iadd (load j) 1)))))
             (load ok))))

; ------------------------------------------------------------ targeted search
;
; `prop-target!` reports a number the search should MAXIMIZE. The runner stops
; sampling uniformly and starts hill-climbing the tape toward it, which reaches
; inputs that uniform generation would need orders of magnitude more cases to
; find (Löscher & Sagonas, "Targeted Property-Based Testing", ISSTA 2017).
;
; Here the law is true, so the search runs its full budget and finds nothing —
; which is exactly what a passing targeted property looks like.

(defprop byte-sums-cannot-exceed-their-length-times-255
         [(xs (ArrayList u8))]
         (let [(mut total) 0
               (mut i) 0]
           (loop (if (>= (load i) (al-len [u8] xs))
                     (break)
                     (do
                       (store! total (primitive/iadd (load total) (primitive/cast i64 (al-get [u8] xs (load i)))))
                       (store! i (primitive/iadd (load i) 1)))))
           (prop-target! (primitive/cast f64 (load total)))
           (<= (load total) (primitive/imul (al-len [u8] xs) 255))))

; ---------------------------------------------------------------------------
;
; WHAT A FAILURE LOOKS LIKE. Given a false property —
;
;     (defprop no-list-sums-to-five [(xs (ArrayList u8))]
;       (!= (list-sum-u8 xs) 5))
;
; — the report is the SHRUNK input, not the random one that happened to trip it:
;
;     test no-list-sums-to-five ...
;     FAILED after 1 cases (4 shrinks, 15 shrink calls)
;
;       counterexample:
;         xs = (5)
;
;       property no-list-sums-to-five
;            at src/examples/property-testing.coil:143
;
;       reproduce:  COIL_PBT_SEED=-321964957710234055 COIL_PBT_CASES=200 coil test …
;
; And if the property CRASHES rather than returning false, the run survives it:
; generation happens in a forked child, the runner bisects to find which case
; killed it, and then minimizes the crash with every candidate in its own child.
;
;     CRASHED (signal 11) on case 0
;     FAILED after 0 cases (29 shrinks, 35 shrink calls)
;
;       counterexample:
;         a = 10
;
;       the property CRASHED on this input (signal 11).
;
; Knobs (all optional): COIL_PBT_CASES, COIL_PBT_SEED, COIL_PBT_SIZE,
; COIL_PBT_SHRINK, COIL_PBT_TARGET, COIL_PBT_VERBOSE, COIL_PBT_NOFORK.
