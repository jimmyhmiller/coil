; Property-based testing: state a law and let the runner hunt for the smallest
; input that breaks it. Every property here holds, so the file is green; the end
; of the file shows what a failure looks like.
;   coil test src/examples/property-testing.coil
(module example.property-testing)
(import "coil.prop" :use *)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList al-new])

; ---- the basics ---------------------------------------------------------------
; Arguments come from each type's `Arbitrary` impl. There is nothing to wire up,
; and no shrinker to write.
(defprop addition-commutes
         [(a i64) (b i64)]
         (= (+ a b) (+ b a)))

;; Over two i64s this law is false: a product just past 2^63 wraps, and the
;; division cannot undo it. The runner finds that in under a second, with shrunk
;; values sitting right at the overflow boundary. Two i32s cannot overflow an i64
;; product, so this version holds.
(defprop division-is-the-inverse-of-multiplication
         [(a i32) (b i32)]
         ; `assume` discards a case that misses a precondition. Prefer generating valid
         ; inputs to filtering: the runner warns when it discards too many.
         (assume (!= (cast i64 b) 0))
         (let [a64 (cast i64 a)
               b64 (cast i64 b)]
           (= (/ (* a64 b64) b64) a64)))

; ---- collections --------------------------------------------------------------
; A list is generated element by element, so the shrinker can delete elements one
; at a time, or in runs.
(defn list-sum [(xs (ArrayList i64))] (-> i64)
  (fold (fn [total x] (+ total x)) 0 xs))

(defn list-reverse [(xs (ArrayList i64))] (-> (ArrayList i64))
  (let [(mut out) (al-new [i64] (malloc-allocator))]
    (for i
      (range 0 (len xs))
      (push! (mut out) (get xs (- (- (len xs) 1) i))))
    out))

(defn list-eq [(a (ArrayList i64)) (b (ArrayList i64))] (-> bool)
  (if (!= (len a) (len b))
      false
      (let [(mut same) true]
        (for i
          (range 0 (len a))
          (when (!= (get a i) (get b i)) (set! same false)))
        same)))

(defprop reverse-is-its-own-inverse
         [(xs (ArrayList i64))]
         (list-eq (list-reverse (list-reverse xs)) xs))

(defprop reverse-preserves-the-sum
         [(xs (ArrayList i64))]
         ; `classify` records how often something was true. Run with --verbose=1 to see
         ; the distribution.
         (classify "empty" (= (len xs) 0))
         (= (list-sum (list-reverse xs)) (list-sum xs)))

; ---- your own generator -------------------------------------------------------
; When a type's default distribution is wrong for one property, draw the value
; yourself from `(prop-src)`. Every draw is recorded, so a hand-drawn value shrinks
; like a generated one.
(defprop sorted-insert-keeps-it-sorted
         [(seed i64)]
         (let [s (prop-src)
               (mut xs) (al-new [i64] (src-alloc s))
               (mut prev) 0]
           ; The list is built sorted, so the generator establishes the invariant and
           ; shrinking cannot break it. A shrinker over the finished list could.
           (for _
             (range 0 (draw-len! s 0 20))
             (set! prev (+ prev (draw-int! s 0 10)))
             (push! (mut xs) prev))
           (let [(mut sorted) true]
             (for j
               (range 1 (len xs))
               (when (> (get xs (- j 1)) (get xs j)) (set! sorted false)))
             sorted)))

; ---- targeted search ----------------------------------------------------------
; `prop-target!` names a number to maximize: the runner hill-climbs toward it
; instead of sampling uniformly (Löscher & Sagonas, "Targeted Property-Based
; Testing", ISSTA 2017). This law holds, so the search runs its full budget.
(defprop byte-sums-cannot-exceed-their-length-times-255
         [(xs (ArrayList u8))]
         (let [total (fold (fn [total x] (+ total (cast i64 x))) 0 xs)]
           (prop-target! (cast f64 total))
           (<= total (* (len xs) 255))))

; ---- what a failure looks like ------------------------------------------------
; Given a false property:
;
;     (defprop no-list-sums-to-five [(xs (ArrayList u8))]
;       (!= (list-sum-u8 xs) 5))
;
; the report shows the shrunk input, not the random one that tripped it:
;
;     test no-list-sums-to-five ...
;     FAILED after 1 cases (4 shrinks, 15 shrink calls)
;
;       counterexample:
;         xs = (5)
;
;       reproduce:  coil test … --seed -321964957710234055 --cases 200
;
; A property that crashes or hangs is minimized the same way: each case runs in
; a worker process, and every shrink candidate gets a process of its own.
