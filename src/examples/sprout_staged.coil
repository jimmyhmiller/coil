(module sprout_staged)
(import "coil.primitive" :as primitive)
(import "sprout" :as sp)

;; A real `(stage MARKER ...)` driver for Sprout. The visible tags are transform
;; fixpoint markers only; native stage calls replace them on the following round.
(defn ss-head? [(x Code) (want Code)] (-> bool)
  (and (primitive/code-list? x)
       (and (> (primitive/code-count x) 0)
            (primitive/code-eq (primitive/code-nth x 0) want))))

(defn ss-kind [(x Code)] (-> i64)
  (cond (ss-head? x `sprout-program) 1
        (ss-head? x `sprout-desugared) 2
        (ss-head? x `sprout-folded) 3
        :else 0))

(defn ss-module-kind [(m Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (let [kind (ss-kind (primitive/code-nth m i))]
        (if (!= kind 0) kind (ss-module-kind m (+ i 1) n)))))

(defn ss-raw-tail [(x Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(primitive/code-nth x i) ~@(ss-raw-tail x (+ i 1) n))))

(defn ss-rewrite-form [(f Code) (kind i64) (marker Code)] (-> Code)
  (if (!= (ss-kind f) kind)
      f
      (if (= kind 1)
          `(~marker "sprout_staged_test.sprout-stage-desugar"
                    (~@(ss-raw-tail f 1 (primitive/code-count f))))
          (if (= kind 2)
              `(~marker "sprout_staged_test.sprout-stage-fold" ~f)
              `(~marker "sprout_staged_test.sprout-stage-lower" ~f)))))

(defn ss-rewrite-forms [(m Code) (i i64) (n i64) (kind i64) (marker Code)] (-> Code)
  (if (>= i n)
      `()
      `(~(ss-rewrite-form (primitive/code-nth m i) kind marker)
        ~@(ss-rewrite-forms m (+ i 1) n kind marker))))

(defn ss-stage-declaration [(kind i64) (marker Code)] (-> Code)
  (if (= kind 1)
      `(stage ~marker
         (import "coil.primitive" :as primitive)
         (import "sprout" :as sp)
         ;; Kept in cumulative phase state and called by both later stages.
         (defn sprout-stage-payload [(tagged Code)] (-> Code)
           (primitive/code-nth tagged 1))
         (defn sprout-stage-desugar [(program Code)] (-> Code)
           (primitive/code-cons
             `sprout-desugared
             (primitive/code-cons (call sp/sprout-desugar program) `()))))
      (if (= kind 2)
          `(stage ~marker
             (defn sprout-stage-fold [(tagged Code)] (-> Code)
               (primitive/code-cons
                 `sprout-folded
                 (primitive/code-cons
                   (call sp/sprout-fold (call sprout-stage-payload tagged))
                   `()))))
          `(stage ~marker
             (defn sprout-stage-runtime-tail [(lowered Code) (i i64) (n i64)] (-> Code)
               (if (>= i n)
                   `()
                   (primitive/code-cons
                     (primitive/code-nth lowered i)
                     (sprout-stage-runtime-tail lowered (+ i 1) n))))
             (defn sprout-stage-lower [(tagged Code)] (-> Code)
               (let [lowered (call sp/sprout-lower (call sprout-stage-payload tagged))]
                 ;; Drop `(do (module ...))`; this result is already being spliced
                 ;; into sprout_staged_test's module record.
                 (primitive/code-cons
                   `do
                   (sprout-stage-runtime-tail lowered 2
                                              (primitive/code-count lowered)))))))))

(defn ss-module [(m Code)] (-> Code)
  (if (or (= (primitive/code-count m) 0)
          (not (primitive/code-eq (primitive/code-nth m 0) `sprout_staged_test)))
      m
      (let [kind (ss-module-kind m 1 (primitive/code-count m))]
        (if (= kind 0)
            m
            (let [marker (primitive/gensym)]
              `(~(primitive/code-nth m 0)
                ~@(ss-rewrite-forms m 1 (primitive/code-count m) kind marker)
                ~(ss-stage-declaration kind marker)))))))

(defn ss-modules [(mods Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(ss-module (primitive/code-nth mods i))
        ~@(ss-modules mods (+ i 1) n))))

(defn sprout-staged [(mods Code)] (-> Code)
  `(do ~@(ss-modules mods 0 (primitive/code-count mods))))

(transform sprout-staged :phase before-expand)
