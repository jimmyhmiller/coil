; Growable collections on bump allocators: a list that is the arena's top block
; grows in place, and one that is not falls back to allocate-and-copy without
; losing elements.
;   coil test src/examples/arena-growth.coil
(module example.arena-growth)
(import "coil.alloc"
        :use
        [malloc-allocator arena-allocator overflow-arena-allocator box!])
(import "coil.arraylist" :use [al-new al-free! al-extend!])

;;; The top block grows by moving the bump pointer, so 100,000 pushes fit in a
;;; 4 MiB arena. If every doubling allocated a fresh block instead, the stranded
;;; blocks would add up to about twice the final capacity.
(deftest arena-top-block-grows-in-place
         (let [(mut xs) (al-new [i64] (arena-allocator 4194304))]
           (for i (range 0 100000) (push! (mut xs) i))
           (assert-eq (len xs) 100000)
           (assert-eq (get xs 0) 0)
           (assert-eq (get xs 99999) 99999)))

;;; Two lists growing in lockstep: neither is the top block when it grows, so each
;;; growth takes the copy path.
(deftest arena-interleaved-lists-keep-their-elements
         (let [a (arena-allocator 65536)
               (mut xs) (al-new [i64] a)
               (mut ys) (al-new [i64] a)]
           (for i
             (range 0 64)
             (push! (mut xs) i)
             (push! (mut ys) (* i 10)))
           (assert-eq (len xs) 64)
           (assert-eq (len ys) 64)
           (assert-eq (get xs 0) 0)
           (assert-eq (get ys 0) 0)
           (assert-eq (get xs 63) 63)
           (assert-eq (get ys 63) 630)))

;;; `al-extend!` appends in bulk and lands the same elements as repeated `push!`.
(deftest al-extend-appends-in-bulk
         (let [a (malloc-allocator)
               src
                 (cast (ptr i64)
                       (box! a
                             (array i64 300)
                             (zeroed (array i64 300))))
               (mut xs) (al-new [i64] a)]
           (for i (range 0 300) (store! (index src i) i))
           (push! (mut xs) -1)  ; an existing element to append after
           (al-extend! [i64] (mut xs) src 300)  ; grows from capacity 4 to 301
           (al-extend! [i64] (mut xs) src 300)  ; and again, to 601
           (assert-eq (len xs) 601)
           (assert-eq (get xs 0) -1)
           (assert-eq (get xs 1) 0)
           (assert-eq (get xs 300) 299)
           (assert-eq (get xs 301) 0)
           (assert-eq (get xs 600) 299)))

;;; An overflow arena has no capacity cliff: past its region it falls back to malloc.
(deftest overflow-arena-outlives-its-region
         (let [(mut xs) (al-new [i64] (overflow-arena-allocator 4096))]
           (for i (range 0 50000) (push! (mut xs) (* i 3)))  ; about 400 KB into a 4 KB region
           (assert-eq (len xs) 50000)
           (assert-eq (get xs 0) 0)
           (assert-eq (get xs 49999) 149997)))

;;; Small allocations still come from the region. A list's first growth resizes a
;;; null pointer, the path that would leak to malloc if it answered realloc(NULL, n).
(deftest overflow-arena-actually-bumps
         (let [(mut xs) (al-new [i64] (overflow-arena-allocator 65536))]
           (for i (range 1 6) (push! (mut xs) i))  ; grows 2 -> 4 -> 8, in place
           (assert-eq (get xs 4) 5)))

;;; Freeing an overflow block really frees it, while freeing an in-region block is a
;;; no-op. A double free, or a free of an interior arena pointer, would abort here.
(deftest overflow-arena-frees-only-overflow-blocks
         (let [a (overflow-arena-allocator 256)
               (mut in-region) (al-new [i64] a)
               (mut overflow) (al-new [i64] a)]
           (push! (mut in-region) 42)
           (for i (range 0 2000) (push! (mut overflow) i))  ; forced past the 256-byte region
           (al-free! (mut overflow))
           (al-free! (mut in-region))
           (assert-eq (len overflow) 0)
           (assert-eq (len in-region) 0)))

;;; A zero-length extend changes nothing.
(deftest al-extend-of-nothing-changes-nothing
         (let [(mut xs) (al-new [i64] (malloc-allocator))]
           (push! (mut xs) 7)
           (al-extend! [i64] (mut xs) (cast (ptr i64) 0) 0)
           (assert-eq (len xs) 1)
           (assert-eq (get xs 0) 7)))
