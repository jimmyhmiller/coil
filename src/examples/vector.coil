; A generic growable vector written from scratch, as a user collection:
;   * storage comes from an allocator value the vector carries;
;   * it implements the prelude's Len/Get/Push traits, so `len`, `get` and `push!`
;     work on it exactly as they do on a built-in collection;
;   * `get` is bounds-checked and returns an Option.
;   coil run src/examples/vector.coil   => prints the vector, exits 42
(module example.vector)
(import "coil.alloc" :use [Allocator malloc-allocator alloc reallocate free])
(import "coil.slice" :use [slice-new])

(defstruct Vec [T] [(items (slice T)) (count i64) (allocator (dyn Allocator))])

(defn vec-new [T] [(a (dyn Allocator))] (-> (Vec T))
  (Vec
    :items (slice-new [T] (cast (ptr T) 0) 0)
    :count 0
    :allocator a))

;;; Grow to double the capacity (at least 4). Returns false when out of memory.
(defn vec-grow! [T] [(v (mut (Vec T)))] (-> bool)
  (let [capacity (len (.items v))
        grown
          (if (= capacity 0)
              (alloc [T] (.allocator v) 4)
              (reallocate [T] (.allocator v) (.items v) (* capacity 2)))]
    (match grown
      (Some [items] (set! (.items v) items) true)
      (None [] false))))

(defn vec-free! [T] [(v (mut (Vec T)))] (-> i64)
  (if (= (len (.items v)) 0) 0 (free [T] (.allocator v) (.items v))))

(impl [T] Len (Vec T)
  (len [(v (Vec T))] (-> i64) (.count v)))

(impl [T] Get (Vec T)
  (get [(v (Vec T)) (i i64)]
       (-> (Option T))
       (if (and (>= i 0) (< i (.count v)))
           (Some (get (.items v) i))
           (None))))

(impl [T] Push (Vec T)
  (push! [(v (mut (Vec T))) (x T)]
         (-> i64)
         (if (or (< (.count v) (len (.items v))) (vec-grow! (mut v)))
             (do
               (set! (mut (.items v)) (.count v) x)
               (set! (.count v) (+ (.count v) 1))
               (.count v))
             -1)))  ; out of memory

(defn show-at [(v (Vec i64)) (i i64)] (-> i64)
  (match (get v i)
    (Some [x] (println "v[{}] = {}" i x))
    (None [] (println "v[{}] = out of range" i)))
  0)

(defn main [] (-> i64)
  (let [(mut v) (vec-new [i64] (malloc-allocator))
        (mut total) 0]
    (push! (mut v) 10)  ; the first push allocates
    (push! (mut v) 20)
    (push! (mut v) 12)
    (print "vec = [ ")
    (for i
      (range 0 (len v))
      (let [x (get (.items v) i)]  ; unchecked: i is in range
        (print "{} " x)
        (set! total (+ total x))))
    (println "]")
    (show-at v 1)  ; in range
    (show-at v 9)  ; past the end
    (vec-free! (mut v))
    total))
