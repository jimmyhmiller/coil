(module example.simd)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])

;; Count ASCII digits in an external buffer, including a short final chunk.
;; N is a compile-time choice; changing it does not change the result.
(defn count-digits [N] [(input (slice u8))] (-> i64)
  (let [(mut offset) 0 (mut count) 0
        fill (v/vzero [u8 N]) width (v/vlanes fill)]
    (loop
      (if (>= (load offset) (len input)) (break)
        (let [remaining (- (len input) (load offset))
              bytes (v/vload-partial [u8 N] (p/index (slice-data input) (load offset)) remaining fill)
              digits (v/vand (v/ascii-digit? bytes) (v/mask-low [N] remaining))]
          (set! count (+ (load count) (v/mask-count digits)))
          (set! offset (+ (load offset) (if (< remaining width) remaining width))))))
    (load count)))

(defn main [] (-> i64)
  (let [text "Order 12345: 7 boxes, 89 items."]
    (assert-eq (count-digits [(const 16)] text) 8)
    (assert-eq (count-digits [(const 32)] text) 8)
    (assert-eq (count-digits [(const 3)] text) 8)
    (assert-eq (count-digits [(const 16)] "") 0))
  0)
