; Portable SIMD: count ASCII digits a vector at a time, with a masked final chunk.
; The vector width N is a compile-time parameter; the answer does not depend on it.
;   coil run src/examples/simd.coil; echo $?   => 0
(module example.simd)
(import "coil.simd" :as v)
(import "coil.slice" :use [slice-data])

(defn count-digits [(const N i64)] [(input (slice u8))] (-> i64)
  (let [(mut offset) 0
        (mut count) 0
        fill (v/vzero [u8 N])
        width (v/vlanes fill)]
    (while (< offset (len input))
      (let [remaining (- (len input) offset)
            bytes
              (v/vload-partial [u8 N]
                               (index (slice-data input) offset)
                               remaining
                               fill)
            digits (v/vand (v/ascii-digit? bytes) (v/mask-low [N] remaining))]
        (set! count (+ count (v/mask-count digits)))
        (set! offset (+ offset (if (< remaining width) remaining width)))))
    count))

(defn main [] (-> i64)
  (let [text "Order 12345: 7 boxes, 89 items."]
    (assert-eq (count-digits [(const 16)] text) 8)
    (assert-eq (count-digits [(const 32)] text) 8)
    (assert-eq (count-digits [(const 3)] text) 8)
    (assert-eq (count-digits [(const 16)] "") 0))
  0)
