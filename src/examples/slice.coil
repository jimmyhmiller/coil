; Slices are {data, len} views. A subslice shares its parent's storage, so a
; write through the view is visible in the array underneath.
;   coil run src/examples/slice.coil; echo $?   => 32
(module example.slice)
(import "coil.slice" :use [subslice])

(defn main [] (-> i64)
  (let [(mut arr) [1 2 3 4 5]
        (mut mid) (subslice (: (mut arr) (slice i64)) 1 4)  ; a view of [2 3 4]
        (mut total) 0]
    (set! (mut mid) 0 20)  ; writes arr[1]
    (for x mid (set! total (+ total x)))  ; 20 + 3 + 4 = 27
    (+ total (len arr) (- (get arr 1) 20))))  ; + 5, and arr[1] really is 20
