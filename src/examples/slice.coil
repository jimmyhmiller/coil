; `(Slice T)` — a fat-pointer view over an array, as a generic-struct library
; (src/stdlib/slice.coil); the compiler has no notion of slices. Subslices share storage;
; slice-set! writes through.
;   coil run src/examples/slice.coil; echo $?   => 32
(module app)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use *)

(defn main [] (-> :i64)
  (let [arr (alloc/stack (array i64 5))]
    (store! (primitive/index arr 0) 1)
    (store! (primitive/index arr 1) 2)
    (store! (primitive/index arr 2)
            3)
    (store! (primitive/index arr 3) 4)
    (store! (primitive/index arr 4) 5)
    (let [s (slice-of arr 5)
          mid (subslice s 1 4)  ; view of [2 3 4], same memory
          (mut acc) 0]
      (slice-set! mid 0 20)  ; writes through: arr[1] becomes 20
      (slice-for [x mid] (store! acc (primitive/iadd (load acc) x)))  ; 20 + 3 + 4 = 27
      (primitive/iadd (load acc) (slice-len s)))))  ; + len 5 = 32
