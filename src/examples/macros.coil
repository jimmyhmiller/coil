; Macros are ordinary functions from Code to Code, run at compile time and
; expanded where they are called. Templates are hygienic: a name a template
; introduces never captures the caller's names.
;   coil run src/examples/macros.coil; echo $?   => 41
(module example.macros)
(import "coil.primitive" :as primitive)

;;; Quasiquote and unquote.
(defn inc [(x Code)] (-> Code)
  `(+ ~x 1))

;;; A recursive, variadic macro: clauses destructure like any sequence, and a
;;; lone trailing clause is the else branch.
(defn my-cond [& (clauses Code)] (-> Code)
  (cond (= (len clauses) 0) `0
        (= (len clauses) 1) (get clauses 0)
        :else
          (let [[test then & more] clauses]
            `(if ~test ~then (my-cond ~@more)))))

;;; Ordinary compile-time computation: unroll x^n into nested multiplies.
(defn pow-form [(x Code) (n i64)] (-> Code)
  (if (= n 0) `1 `(* ~x ~(pow-form x (- n 1)))))

(defn pow [(x Code) (n Code)] (-> Code)
  (pow-form x (primitive/code-int n)))

;;; Hygiene: `t` here cannot collide with a `t` at the call site, and `x` is
;;; evaluated once.
(defn double [(x Code)] (-> Code)
  `(let [t ~x] (+ t t)))

;;; A macro can emit a top-level definition.
(defn defconst [(name Code) (v Code)] (-> Code)
  `(defn ~name [] (-> i64)
     ~v))

(defconst base 3)

(defn classify [(n i64)] (-> i64)
  (my-cond (< n 0)
           100
           (= n 0)
           200
           300))

(defn main [] (-> i64)
  (if (= (classify 0) 200)
      (+ (pow (base) 3)  ; 3^3 = 27
         (double (inc 6)))  ; (6 + 1) * 2 = 14
      0))
