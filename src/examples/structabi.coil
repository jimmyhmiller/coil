; A struct returned by value across the C ABI: libc's `div` returns
; `div_t { int quot; int rem; }`. div(47, 5) = {9, 2}; the exit code is 9*10 + 2.
;   coil run src/examples/structabi.coil; echo $?   => 92
(module example.structabi)

(defstruct DivT [(quot i32) (rem i32)])

(extern div [i32 i32] (-> DivT))

(defn main [] (-> i64)
  (let [d (div 47 5)]
    (+ (* (cast i64 (.quot d)) 10) (cast i64 (.rem d)))))
