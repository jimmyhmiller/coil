; Iteration: `for` walks anything `Iterable` — a range, an array, a slice.
;   coil run src/examples/iter.coil; echo $?   => 60
(module example.iter)

; Filled element by element: the direct x86-64 backend cannot yet lower an array
; literal (initialized static storage), and this example is in its test corpus.
(defn main [] (-> i64)
  (let [(mut values) (zeroed (array i64 3))
        (mut total) 0]
    (set! (mut values) 0 10)
    (set! (mut values) 1 20)
    (set! (mut values) 2 30)
    (for i (range 0 0) (set! total (+ total i)))  ; an empty range runs no iterations
    (for x (iter values) (set! total (+ total x)))
    total))
