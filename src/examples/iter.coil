; `for-in` — iterate a collection, binding each element. A macro over `for`
; (itself a macro over loop/break/continue); the compiler knows nothing about it.
;   coil run src/examples/iter.coil; echo $?   => 60
(module example.iter)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.control" :use *)

(defn main [] (-> :i64)
  (let [arr (primitive/alloc-stack (array i64 3))]
    (set! (primitive/index arr 0) 10)
    (set! (primitive/index arr 1) 20)
    (set! (primitive/index arr 2) 30)
    (let [(mut acc) 0]
      ; iterate a range...
      (for-in [i (range 0 0)] (store! acc (primitive/iadd (load acc) i)))  ; empty range, no-op
      ; ...and a fixed array's elements: 10+20+30 = 60.
      (for-in [x (over arr 3)] (store! acc (primitive/iadd (load acc) x)))
      (load acc))))
