; Output is a capability value: a function that writes takes a Writer, so its
; signature shows it does I/O, and the caller picks the sink. Here an allocator
; supplies a buffer, a fixed-buffer Writer formats into it, and the result is
; flushed to stdout.
;   coil run src/examples/io.coil   => prints: answer=42
(module example.io)
(import "coil.alloc" :as alloc)
(import "coil.io"
        :use
        [Writer
         IoError
         FixBuf
         fixed-buffer-writer
         print-str
         print-int
         write-byte
         write-all
         stdout])

(defn greet [(w (ptr Writer)) (n i64)] (-> (Result i64 IoError))
  (print-str w "answer=")
  (print-int w n)
  (write-byte w #\newline))

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        storage (alloc/box! a (array i8 64) (zeroed (array i8 64)))
        buffer
          (alloc/box! a
                      FixBuf
                      (FixBuf
                        :data (cast (ptr i8) storage)
                        :len 0
                        :cap 64))
        writer (alloc/box! a Writer (zeroed Writer))]
    (greet (fixed-buffer-writer writer buffer) 42)
    (match (write-all (stdout) (.data buffer) (.len buffer))
      (Ok [_] 0)
      (Err [_] 1))))
