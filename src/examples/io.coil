; IO as a capability value, Zig-style: a `Writer` is passed in, so a function's

; type shows that it does output -- and you choose the sink at the call site.
; This also composes the two interfaces: an Allocator hands out a buffer, a
; fixed-buffer Writer formats into it, then we flush that buffer to stdout.
;   coil run src/examples/io.coil   prints: answer=42   => 0
(module example.io)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.io" :use *)
(import "coil.result" :use *)  ; Ok/Err used in the match below

; Polymorphic over the sink: works with stdout, a buffer, or a null writer.
(defn greet [(w (ptr Writer)) (n :i64)] (-> (Result :i64 IoError))
  (do
    (print-str w "answer=")
    (print-int w n)
    (write-byte w (primitive/cast :u8 10))))

(defn main [] (-> :i64)
  (let [a (malloc-allocator)
        buf
          (primitive/cast (ptr i8) (box! a (array i8 64) (primitive/zeroed (array i8 64))))  ; allocator provides storage
        fb (primitive/alloc-static FixBuf)]
    (set! (.data fb) buf)
    (set! (.cap fb) 64)
    (greet (fixed-buffer-writer (primitive/alloc-stack Writer) fb) 42)  ; format into the buffer
    (match (write-all (stdout)  ; flush the captured bytes
                      (.data fb)
                      (.len fb))
      (Ok [n] 0)
      (Err [e] 1))))
