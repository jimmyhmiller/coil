; References instead of pointers:
;   * a struct parameter `(r Rect)` is an immutable reference;
;   * `(mut Point)` is a mutable reference, and the caller sees the writes;
;   * `(mut place)` at the call site marks exactly where a write can escape.
;   coil run src/examples/references.coil; echo $?   => 42
(module example.references)

(defstruct Point [(x i64) (y i64)])

(defstruct Rect [(lo Point) (hi Point)])

(defn area [(r Rect)] (-> i64)
  (* (- (.x (.hi r)) (.x (.lo r)))
     (- (.y (.hi r)) (.y (.lo r)))))

(defn translate! [(p (mut Point)) (dx i64) (dy i64)] (-> void)
  (set! (.x p) (+ (.x p) dx))
  (set! (.y p) (+ (.y p) dy)))

(defn main [] (-> i64)
  (let [(mut r)
          (Rect
            :lo (Point :x 0 :y 0)
            :hi (Point :x 5 :y 5))]
    (translate! (mut (.hi r)) 1 2)  ; borrow a nested field mutably
    (area r)))  ; hi is now (6, 7): 6 * 7
