; coil.mem: typed bulk memory operations (fill, copy, compare) over pointers.
;   coil run src/examples/mem.coil; echo $?   => 107
(module example.mem)
(import "coil.mem" :use [mem-fill mem-copy mem-eql])
(import "coil.slice" :use [slice-data])

(defn main [] (-> i64)
  (let [(mut src) (zeroed (array i64 4))
        (mut dst) (zeroed (array i64 4))
        s (slice-data (: (mut src) (slice i64)))
        d (slice-data (: (mut dst) (slice i64)))]
    (mem-fill s 7 4)  ; src = [7 7 7 7]
    (mem-copy d s 4)  ; dst = [7 7 7 7]
    (+ (get dst 3) (if (mem-eql s d 4) 100 0))))
