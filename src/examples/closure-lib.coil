; Closures from the `defclosure` library macro, used through an import.
;   coil run src/examples/closure-lib.coil; echo $?   => 42
(module example.closure-lib)
(import "coil.closure" :use [defclosure])

(defclosure adder [(n i64)] [(x i64)] i64 (+ n x))

(defclosure scaler [(k i64)] [(x i64)] i64 (* k x))

(defn main [] (-> i64)
  (let [add5 (adder-new 5)
        triple (scaler-new 3)
        result (+ (adder-call add5 37) (- (scaler-call triple 14) 42))]
    (adder-free add5)
    (scaler-free triple)
    result))
