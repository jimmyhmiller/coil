; A lock-free (Treiber) stack built on compare-and-swap. Four threads push
; disjoint ranges of pre-allocated nodes onto one shared head; draining the stack
; must then find all 4,000.
;
; This sidesteps ABA by construction: nodes are never freed or reused, and nothing
; pops while the pushes run. A production stack with concurrent pop and
; reclamation needs tagged or hazard pointers.
;   coil run src/examples/lockfree.coil; echo $?   => 0
(module example.lockfree)
(import "coil.alloc" :as alloc)
(import "coil.atomic" :use [atomic-load atomic-cas])
(import "coil.thread" :use [Thread thread-spawn thread-join])

;;; `next` is the next node's address as an i64 (0 = end), so the head can be
;;; swapped with the integer `atomic-cas`.
(defstruct Node [(val i64) (next i64)])

(defstruct WorkerArgs
  [(head (ptr i64)) (pool (ptr Node)) (start i64) (count i64)])

(defn push! [(head (ptr i64)) (node (ptr Node))] (-> i64)
  (let [address (cast i64 node)]
    (loop (let [old (atomic-load head)]
            (set! (.next node) old)
            (when (= (atomic-cas head old address) old) (break))))
    address))

;;; The top node's address, or 0 when the stack is empty.
(defn pop! [(head (ptr i64))] (-> i64)
  (loop (let [old (atomic-load head)]
          (when (= old 0) (break 0))
          (when (= (atomic-cas head old (.next (cast (ptr Node) old))) old)
            (break old)))))

(defn worker [(arg (ptr i8))] (-> (ptr i8))
  (let [w (cast (ptr WorkerArgs) arg)]
    (for i
      (range 0 (.count w))
      (let [k (+ (.start w) i)
            node (index (.pool w) k)]
        (set! (.val node) k)
        (push! (.head w) node))))
  (cast (ptr i8) 0))

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        head (alloc/box! a i64 0)
        pool (alloc/box! a (array Node 4000) (zeroed (array Node 4000)))
        args
          (alloc/box! a
                      (array WorkerArgs 4)
                      (zeroed (array WorkerArgs 4)))
        threads (alloc/box! a (array Thread 4) (zeroed (array Thread 4)))]
    (for i
      (range 0 4)
      (store! (index args i)
              (WorkerArgs
                :head head
                :pool (index pool 0)
                :start (* i 1000)
                :count 1000))
      (thread-spawn (index threads i)
                    (fnptr-of worker)
                    (cast (ptr i8) (index args i))))
    (for i
      (range 0 4)
      (thread-join (index threads i)))
    (let [(mut count) 0]
      (while (!= (pop! head) 0)
        (set! count (+ count 1)))
      (alloc/destroy a threads)
      (alloc/destroy a args)
      (alloc/destroy a pool)
      (alloc/destroy a head)
      (- count 4000))))
