; Struct layout control: `:layout packed`, `c`, or `(align N)`, pinned down with
; compile-time `sizeof`/`offsetof` and `static-assert`, so layout drift is a
; compile error.
;   coil run src/examples/layout.coil; echo $?   => 42
(module example.layout)

;;; A byte-exact network header: no padding.
(defstruct Header :layout packed
  [(magic u16)  ; offset 0
   (version u8)  ; offset 2
   (flags u8)  ; offset 3
   (length u32)])  ; offset 4, 8 bytes in all

(static-assert (= (sizeof Header) 8) "header must be 8 bytes")

(static-assert (= (offsetof Header length) 4) "length at offset 4")

;;; The same fields under the C layout happen to need no padding either.
(defstruct HeaderC [(magic u16) (version u8) (flags u8) (length u32)])

(static-assert (= (sizeof HeaderC) 8) "this one happens to also be 8")

(defn main [] (-> i64)
  (let [h
          (Header
            :magic 0
            :version 2
            :flags 0
            :length 40)]
    (+ (cast i64 (.length h)) (cast i64 (.version h)))))
