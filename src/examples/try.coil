; src/stdlib/try.coil — `?`/try-style early exit for Result, a pure library macro over

; block/return-from (no core support). No more match pyramids.
;   coil run src/examples/try.coil; echo $?   => 6   (8 -> 4 -> 2, Ok 4+2)
(module example.try)
(import "coil.primitive" :as primitive)
(import "coil.try" :use *)
(import "coil.result" :use *)

(defn half [(n i64)] (-> (Result i64 i64))
  (if (= (primitive/irem n 2) (cast i64 0)) (Ok (primitive/idiv n 2)) (Err n)))

; Without try: two nested matches. With try!: linear, errors short-circuit.
(defn sum-halves [(n i64)] (-> (Result i64 i64))
  (try (let [a (try! (half n))  ; if half errors, sum-halves returns that Err
             b (try! (half a))]
         (Ok (primitive/iadd a b)))))

(defn main [] (-> :i64)
  (match (sum-halves 8) (Ok [v] v) (Err [e] e)))  ; 8->4->2 => Ok 6
