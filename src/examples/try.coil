; Early exit for Result: inside `try`, `try!` unwraps an Ok or returns the Err.
;   coil run src/examples/try.coil; echo $?   => 6   (8 -> 4 -> 2; 4 + 2)
(module example.try)
(import "coil.try" :use [try try!])

(defn half [(n i64)] (-> (Result i64 i64))
  (if (= (% n 2) 0) (Ok (/ n 2)) (Err n)))

(defn sum-halves [(n i64)] (-> (Result i64 i64))
  (try (let [a (try! (half n))
             b (try! (half a))]
         (Ok (+ a b)))))

(defn main [] (-> i64)
  (match (sum-halves 8)
    (Ok [v] v)
    (Err [e] e)))
