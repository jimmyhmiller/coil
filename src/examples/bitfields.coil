(module example.bitfields)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
; Bitfields: a :layout bits struct packs sub-byte fields into one backing int.
; Fields are accessed by value with bit-get/bit-set! (bits have no address), and each
; a numeric width gives a uN field; spelling iN/uN makes signedness explicit.
;   coil run src/examples/bitfields.coil; echo $?   => 42

; An RGB565 colour packed into 16 bits.
(defstruct Rgb565 :layout bits :backing :i16
  [(b :bits 5)  ; bits 0-4
   (g :bits 6)  ; bits 5-10
   (r :bits 5)])  ; bits 11-15
(defstruct SignedBits :layout bits :backing :u16
  [(delta :bits i9) (rest :bits 7)])

(static-assert (= (primitive/sizeof Rgb565) (cast i64 2)) "RGB565 is exactly 16 bits")

(defn main [] (-> :i64)
  (let [c (primitive/alloc-stack Rgb565)
        s (primitive/alloc-stack SignedBits)]
    (primitive/bit-set! c r (primitive/cast :u5 20))
    (primitive/bit-set! c g (primitive/cast :u6 10))  ; setting g must not disturb r
    (primitive/bit-set! c b (primitive/cast :u5 12))
    (primitive/bit-set! s delta (primitive/cast i9 -100))
    (primitive/iadd
      (primitive/iadd (primitive/imul (primitive/cast :i64 (primitive/bit-get c r)) 1)  ; 20
                      (primitive/iadd (primitive/cast :i64 (primitive/bit-get c g))  ; 10
                                      (primitive/cast :i64 (primitive/bit-get c b))))  ; 12
      (primitive/iadd (primitive/cast i64 (primitive/bit-get s delta)) 100))))  ; signed roundtrip, net 0 -> 42
