; Bitfields: `:layout bits` packs sub-byte fields into one backing integer.
; Bits have no address, so fields are read and written by value with
; `bit-get`/`bit-set!`. A width `N` is a uN field; `iN` makes it signed.
;   coil run src/examples/bitfields.coil; echo $?   => 42
(module example.bitfields)
(import "coil.primitive" :as primitive)

;;; An RGB565 colour in 16 bits.
(defstruct Rgb565 :layout bits :backing i16
  [(b :bits 5)  ; bits 0-4
   (g :bits 6)  ; bits 5-10
   (r :bits 5)])  ; bits 11-15

(defstruct SignedBits :layout bits :backing u16
  [(delta :bits i9) (rest :bits 7)])

(static-assert (= (sizeof Rgb565) 2) "RGB565 is exactly 16 bits")

(defn main [] (-> i64)
  ; bit-get/bit-set! take a pointer, and a `(mut local)` borrow is not accepted,
  ; so the backing storage comes from alloc-stack.
  (let [c (primitive/alloc-stack Rgb565)
        s (primitive/alloc-stack SignedBits)]
    (store! c (zeroed Rgb565))
    (store! s (zeroed SignedBits))
    (primitive/bit-set! c r 20)
    (primitive/bit-set! c g 10)  ; must not disturb r
    (primitive/bit-set! c b 12)
    (primitive/bit-set! s delta -100)
    (+ (+ (cast i64 (primitive/bit-get c r))  ; 20
          (+ (cast i64 (primitive/bit-get c g))  ; 10
             (cast i64 (primitive/bit-get c b))))  ; 12
       (+ (cast i64 (primitive/bit-get s delta)) 100))))  ; the signed field round-trips
