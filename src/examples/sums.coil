; Sum types and exhaustive `match`, including a generic sum.
;   coil run src/examples/sums.coil; echo $?   => 42
(module example.sums)

(defsum Maybe [T] (Nothing) (Just [(val T)]))

(defn unwrap-or [T] [(m (Maybe T)) (default T)] (-> T)
  (match m
    (Nothing [] default)
    (Just [v] v)))

(defsum Shape
  (Circle [(r i64)])
  (Rect [(w i64) (h i64)]))

(defn area [(s Shape)] (-> i64)
  (match s
    (Circle [r] (* 3 (* r r)))
    (Rect [w h] (* w h))))

(defn main [] (-> i64)
  (+ (unwrap-or (Just 30) 0)  ; 30
     (area (Rect :w 4 :h 3))))  ; 12
