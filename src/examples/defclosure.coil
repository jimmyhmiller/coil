; `defclosure` is a library macro: one form generates the environment struct, the
; code function, the closure struct, and new/call/free helpers.
;   coil run src/examples/defclosure.coil; echo $?   => 42
(module example.defclosure)
(import "coil.closure" :use [defclosure])

(defclosure adder [(n i64)] [(x i64)] i64 (+ n x))

(defclosure scaler [(k i64)] [(x i64)] i64 (* k x))

(defn main [] (-> i64)
  (let [add5 (adder-new 5)
        triple (scaler-new 3)
        result
          (+ (adder-call add5 37)  ; 5 + 37 = 42
             (- (scaler-call triple 14) 42))]  ; 3 * 14 - 42 = 0
    (adder-free add5)
    (scaler-free triple)
    result))
