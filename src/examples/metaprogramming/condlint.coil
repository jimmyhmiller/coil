; A lint with a fix: a chain of three or more nested `if`s becomes a `cond`.
;
;   (if (= x 1) "one"                 (cond (= x 1) "one"
;     (if (= x 2) "two"        =>           (= x 2) "two"
;       (if (= x 3) "three"                 (= x 3) "three"
;         "other")))                        :else "other")
;
; `primitive/suggest` reports the rewrite as a Code value built from the author's
; own test and branch nodes, so `coil lint --fix` reprints those as their original
; source text and keeps the comments inside them.
;   coil lint condlint_test.coil --use condlint [--diff | --fix]
(module condlint)
(import "coil.primitive" :as primitive)
(import "coil.meta" :use [user-forms])

;;; A hand-written `(if TEST THEN ELSE)`. Checkers see the program after macro
;;; expansion, where every `cond`/`when` has become nested ifs; `code-macro?`
;;; tells the expander's ifs from the author's.
(defn hand-if? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (= (len f) 4)
       (= (get f 0) `if)
       (not (primitive/code-macro? f))))

(defn chain-length [(f Code)] (-> i64)
  (if (hand-if? f) (+ 1 (chain-length (get f 3))) 0))

(defn as-cond [(f Code)] (-> Code)
  (let [(mut clauses) (primitive/code-list-new)
        (mut at) f]
    (while (hand-if? at)
      (push! (mut clauses) (get at 1))
      (push! (mut clauses) (get at 2))
      (set! at (get at 3)))
    (push! (mut clauses) `:else)
    (push! (mut clauses) at)
    `(cond ~@clauses)))

(defn walk [(f Code)] (-> void)
  (when (>= (chain-length f) 3)
    (primitive/suggest f
                       "three or more nested ifs read better as a cond"
                       (as-cond f)))
  (for child f (walk child)))

(defn nested-ifs [(modules Code)] (-> Code)
  (for form (user-forms modules) (walk form))
  `0)

(checker nested-ifs)
