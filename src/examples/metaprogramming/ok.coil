(module example.metaprogramming.ok)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "checker" :use *)
(defstruct Node [(val :i64)])
(defn use-ok [(p (ptr Node))] (-> :i64)
  (check-uaf (store! (field p val) 7)
             (load (field p val))  ; used BEFORE free — fine
             (primitive/free p)  ; free last, nothing after
             0))
(defn main [] (-> :i64)
  (let [n (alloc/box! (alloc/malloc-allocator) Node (primitive/zeroed Node))] (do (use-ok n) 42)))
