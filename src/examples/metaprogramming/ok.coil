; Frees its node last, so the use-after-free checker accepts it.
;   coil run src/examples/metaprogramming/ok.coil; echo $?   => 42
(module example.metaprogramming.ok)
(import "coil.alloc" :use [Allocator malloc-allocator box! destroy])
(import "checker")

(defstruct Node [(val i64)])

(defn use-ok [(a (dyn Allocator)) (p (ptr Node))] (-> i64)
  (set! (.val p) 7)
  (let [v (.val p)]  ; read before the free: fine
    (destroy a p)
    v))

(defn main [] (-> i64)
  (let [a (malloc-allocator)]
    (+ (use-ok a (box! a Node (Node :val 0))) 35)))
