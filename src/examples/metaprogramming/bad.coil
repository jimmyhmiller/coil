; Reads its node after freeing it, so the use-after-free checker rejects the
; program at compile time.
;   coil run src/examples/metaprogramming/bad.coil   => error: use after free …
(module example.metaprogramming.bad)
(import "coil.alloc" :use [Allocator malloc-allocator box! destroy])
(import "checker")

(defstruct Node [(val i64)])

(defn use-bad [(a (dyn Allocator)) (p (ptr Node))] (-> i64)
  (set! (.val p) 7)
  (destroy a p)  ; freed here
  (.val p))  ; and read afterwards

(defn main [] (-> i64)
  (let [a (malloc-allocator)]
    (use-bad a (box! a Node (Node :val 0)))))
