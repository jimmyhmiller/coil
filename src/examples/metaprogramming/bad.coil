(module example.metaprogramming.bad)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "checker" :use *)

(defstruct Node [(val :i64)])

(defn use-bad [(p (ptr Node))] (-> :i64)
  (check-uaf (store! (field p val) 7)
             (primitive/free p)  ; freed here
             (load (field p val))))  ; ← USE AFTER FREE

(defn main [] (-> :i64)
  (let [n (alloc/box! (alloc/malloc-allocator) Node (primitive/zeroed Node))] (use-bad n)))
