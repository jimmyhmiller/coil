; Input for condlint.coil. `classify` is a three-test staircase and is flagged;
; `sign` has only two tests and `already-cond` is already a cond, so neither is.
;   coil lint condlint_test.coil --use condlint
(module example.metaprogramming.condlint-test)

(defn classify [(x i64)] (-> i64)
  (if (= x 1)
      100
      (if (= x 2)
          200  ; a comment the fix keeps
          (if (= x 3) 300 999))))

;;; Two tests: a cond would be no improvement.
(defn sign [(x i64)] (-> i64)
  (if (< x 0) -1 (if (> x 0) 1 0)))

;;; Expands to nested ifs before the checker runs, and must not be reported.
(defn already-cond [(x i64)] (-> i64)
  (cond (= x 1) 10
        (= x 2) 20
        (= x 3) 30
        :else 99))

(defn main [] (-> i64)
  (+ (classify 3) (+ (sign -5) (already-cond 2))))
