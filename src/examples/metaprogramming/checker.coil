; A whole-program checker that refuses to compile a use after free. For every
; sequence of forms (a function body, a `do`, a `let` body) it finds a call that
; resolves to `coil.alloc/destroy`, then reports any later form in that sequence
; that mentions the same local.
;
; Importing this module is what turns it on: `ok.coil` and `bad.coil` import it.
; It is deliberately simple: it does not follow control flow or aliases.
(module checker)
(import "coil.primitive" :as primitive)

;;; The local a form frees, as a binding id, or 0. `code-decl` names the exact
;;; function the checker resolved, so a local helper that happens to be called
;;; `destroy` is not mistaken for this one.
(defn freed-binding [(f Code)] (-> i64)
  (if (and (primitive/code-list? f) (= (len f) 3))
      (let [decl (primitive/code-decl f)]
        (if (and (primitive/code-list? decl)
                 (>= (len decl) 4)
                 (= (get decl 3) `coil.alloc.destroy))
            (primitive/binding-of (get f 2))
            0))
      0))

(defn mentions? [(f Code) (binding i64)] (-> bool)
  (if (primitive/code-sym? f)
      (= (primitive/binding-of f) binding)
      (let [(mut found) false]
        (for child
          (iter f)
          (when (mentions? child binding) (set! found true)))
        found)))

;;; Check each sibling sequence, then recurse into every child.
(defn walk [(f Code)] (-> i64)
  (let [(mut freed) 0]
    (for child
      (iter f)
      (when (and (> freed 0) (mentions? child freed))
        ; `when` wants an i64 body (see coil-bugs), hence the trailing 0.
        (primitive/report child
                          "use after free: this reads a pointer freed earlier in the sequence")
        0)
      (let [b (freed-binding child)]
        (when (> b 0) (set! freed b)))
      (walk child)))
  0)

(defn use-after-free [(modules Code)] (-> Code)
  (for m
    (iter modules)
    (for form
      (iter m)
      (when (primitive/code-from-user? form) (walk form))))
  `0)

(checker use-after-free)
