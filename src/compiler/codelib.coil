(module codelib)
(import "coil.primitive" :as primitive)
; The `code-*` vocabulary as ORDINARY COIL FUNCTIONS over `(ptr Sexp)`.
;
; This is the metaprogram API for the compile-and-run design (see
; tests/metaprogramming/compile-and-run/README.md). Today the same vocabulary exists as
; `ECodeOp` special forms that ONLY the comptime interpreter can execute
; (comptime.coil:1309+), and `Code`/`ECodeOp` hard-fail in every backend
; (codegen.coil:730, codegen_a64.coil:1508). That is the whole reason a
; metaprogram is not a normal program: a different engine runs it.
;
; Nothing here needs a special form, a `Code` type, or an interpreter. `Sexp` is
; already an ordinary struct and `sx-tag`/`sx-items`/`sx-sval` are already ordinary
; functions, so the entire pure vocabulary is just... functions. A metaprogram that
; imports this module compiles like any other program.
;
; Semantics mirror the interpreter's ops EXACTLY (op numbers in comments refer to
; the `code-op` dispatch in comptime.coil), so the two agree while both exist.
;
; RESERVED NAMES, and why that does NOT force an atomic swap. Every name below is a
; special form at PARSE time: parser.coil:411 maps ~29 `code-*` heads to opcodes
; before resolution runs, so `(primitive/code-nth c i)` becomes ECodeOp regardless of what is
; in scope, and these functions cannot be called from SOURCE while that holds. That
; does not matter, because the lowering belongs in CODEGEN, not in source: ECodeOp
; stays exactly as it is and gains a codegen case emitting a call to the matching
; function here (exported by the compiler as `coil_code_*`, bound at dlopen -- see
; mechanism 1 in tests/metaprogramming/compile-and-run/). The interpreter keeps executing
; ECodeOp; compiled metaprograms execute the same op through this library. Both
; engines coexist, so the migration is incremental and each step stays gate-safe.
; For the same parse-time reason, nothing here calls a reserved name internally --
; it would become an ECodeOp. Hence code-tag/code-listish? as the internal spine.

(import "coil.alloc" :use *)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.control" :use *)
(import "coil.reader" :use *)
(import "parser" :use *)
(import "ast" :use *)
(import "comptime" :use *)

; A metaprogram that misuses the vocabulary is a bug in the metaprogram. Fail HARD
; and say exactly what happened; never return a sentinel that turns a type error at
; the call site into a mystery ten frames away.
(defn code-die [(msg (slice u8))] (-> i64)
  (fmt (stderr) "metaprogram error: {s}\n" msg)
  (abort))

; `Code` is a `(ptr Sexp)`. `sx-tag` exposes the stable public tag mapping;
; representation variants themselves stay private.
(defn code-tag [(c (ptr Sexp))] (-> i64)
  (sx-tag (load c)))
(defn code-proper-list? [(c (ptr Sexp))] (-> bool)
  (match (load (field c kind))
    (KNil [] true)
    (KPair [root]
           (if (!= (primitive/cast i64 (load (field root flat))) 0)
               true
               (let [(mut cur) (load c)
                     p (alloc/stack Sexp)
                     (mut proper) false]
                 (loop
                   (store! p (load cur))
                   (match (load (field p kind))
                     (KNil [] (do (store! proper true) (break)))
                     (KPair [pair] (store! cur (load (field pair tail))))
                     (_ (break))))
                 (load proper))))
    (_ false)))
(defn code-listish? [(c (ptr Sexp))] (-> bool)
  (or (code-proper-list? c) (= (code-tag c) (primitive/cast i64 7))))

; op 0
(defn code-list? [(c (ptr Sexp))] (-> bool)
  (code-proper-list? c))
; op 51 — unlike code-list?, discriminate the reader's vector node.
(defn code-vector? [(c (ptr Sexp))] (-> bool)
  (= (code-tag c) (primitive/cast i64 7)))
; ops 52/53 — float literals retain their exact IEEE-754 bit pattern.
(defn code-float? [(c (ptr Sexp))] (-> bool)
  (= (code-tag c) (primitive/cast i64 1)))
(defn code-float-bits [(c (ptr Sexp))] (-> i64)
  (if (!= (code-tag c) (primitive/cast i64 1))
      (code-die "code-float-bits expects a float literal")
      (sx-ival (load c))))
; op 1
(defn code-sym? [(c (ptr Sexp))] (-> bool)
  (= (code-tag c) (primitive/cast i64 2)))
; op 2
(defn code-int? [(c (ptr Sexp))] (-> bool)
  (= (code-tag c) (primitive/cast i64 0)))
; op 11
(defn code-keyword? [(c (ptr Sexp))] (-> bool)
  (= (code-tag c) (primitive/cast i64 3)))

; op 3
(defn code-count [(c (ptr Sexp))] (-> i64)
  (match (load (field c kind))
    (KVec [items] (sx-len items))
    (KNil [] 0)
    (KPair [_]
           (let [(mut cur) c
                 (mut n) 0
                 (mut done) false
                 (mut proper) false]
             (loop (if (load done)
                       (break)
                       (match (load (field (load cur) kind))
                         (KPair [pair]
                                (do
                                  (store! n (primitive/iadd (load n) 1))
                                  (store! cur (field pair tail))))
                         (KNil [] (do (store! proper true) (store! done true)))
                         (_ (store! done true)))))
             (if (load proper)
                 (load n)
                 (code-die "code-count expects a proper list/vector"))))
    (_ (code-die "code-count expects a list/vector"))))

; op 5
(defn code-sym [(c (ptr Sexp))] (-> (slice u8))
  (if (!= (code-tag c) (primitive/cast i64 2))
      (do (code-die "code-sym expects a symbol") "")
      (sx-sval (load c))))

; op 6
(defn code-int [(c (ptr Sexp))] (-> i64)
  (if (!= (code-tag c) (primitive/cast i64 0))
      (code-die "code-int expects an integer")
      (sx-ival (load c))))

; op 4 — bounds-checked, like the interpreter's.
(defn code-nth [(c (ptr Sexp)) (i i64)] (-> (ptr Sexp))
  (if (< i (primitive/cast i64 0))
      (do (code-die "code-nth index out of range") (primitive/cast (ptr Sexp) 0))
      (match (load (field c kind))
        (KVec [items]
              (if (>= i (sx-len items))
                  (do (code-die "code-nth index out of range") (primitive/cast (ptr Sexp) 0))
                  (al-elem [Sexp] items i)))
        (KPair [_]
               (let [(mut cur) c
                     (mut j) 0
                     (mut out) (primitive/cast (ptr Sexp) 0)
                     (mut done) false]
                 (loop (if (load done)
                           (break)
                           (match (load (field (load cur) kind))
                             (KPair [pair]
                                    (if (= (load j) i)
                                        (do (store! out (field pair head)) (store! done true))
                                        (do
                                          (store! j (primitive/iadd (load j) 1))
                                          (store! cur (field pair tail)))))
                             (_ (store! done true)))))
                 (if (= (primitive/cast i64 (load out)) 0)
                     (do (code-die "code-nth index out of range")
                         (primitive/cast (ptr Sexp) 0))
                     (load out))))
        (_ (do (code-die "code-nth expects a list/vector")
               (primitive/cast (ptr Sexp) 0))))))

; op 7 — every element but the head, as a fresh list.
(defn code-rest [(c (ptr Sexp))] (-> (ptr Sexp))
  (if (not (sexp-list? c))
      (do (code-die "code-rest expects a list") (primitive/cast (ptr Sexp) 0))
      (match (load (field c kind))
        (KPair [pair] (field pair tail))
        (KNil [] c)
        (_ (do (code-die "code-rest expects a list") (primitive/cast (ptr Sexp) 0))))))

; Persistent-list API. Every cons cell is O(1) and retains the exact head/tail nodes.
(defn code-null? [(c (ptr Sexp))] (-> bool)
  (match (load (field c kind))
    (KNil [] true)
    (_ false)))
(defn code-pair? [(c (ptr Sexp))] (-> bool)
  (match (load (field c kind))
    (KPair [_] true)
    (_ false)))
(defn code-car [(c (ptr Sexp))] (-> (ptr Sexp))
  (match (load (field c kind))
    (KPair [pair] (field pair head))
    (_ (do (code-die "code-car expects a non-empty list") (primitive/cast (ptr Sexp) 0)))))
(defn code-cdr [(c (ptr Sexp))] (-> (ptr Sexp))
  (match (load (field c kind))
    (KPair [pair] (field pair tail))
    (_ (do (code-die "code-cdr expects a pair") (primitive/cast (ptr Sexp) 0)))))
(defn code-cons-like [(prototype (ptr Sexp)) (head (ptr Sexp)) (tail (ptr Sexp))] (-> (ptr Sexp))
  (let [a (malloc-allocator)
            pair (unwrap-ptr [SexpPair] (create [SexpPair] a))
            p (unwrap-ptr [Sexp] (create [Sexp] a))]
        (store! (field pair head) (load head))
        (store! (field pair tail) (load tail))
        (store! (field pair owner) a)
        (store! (field pair flat) (primitive/zeroed (ptr (ArrayList Sexp))))
        (store! p (mk-sexp-src (KPair pair) prototype))
        p))
(defn code-cons [(head (ptr Sexp)) (tail (ptr Sexp))] (-> (ptr Sexp))
  ; Convenience construction is deliberately synthetic; use code-cons-like when
  ; diagnostics or hygiene must be authored by a particular source node.
  (let [p (code-cons-like head head tail)]
    (store! (field p lo) -1)
    (store! (field p hi) -1)
    (store! (field p source) -1)
    (store! (field p ctxt) 0)
    p))
(defn code-nil-like [(prototype (ptr Sexp))] (-> (ptr Sexp))
  (let [a (malloc-allocator)
        p (unwrap-ptr [Sexp] (create [Sexp] a))]
    (store! p (mk-sexp-src (KNil) prototype))
    p))

; op 10 — structural equality; shares the interpreter's sexp-eq rather than
; growing a second implementation of it.
(defn code-eq [(x (ptr Sexp)) (y (ptr Sexp))] (-> bool)
  (sexp-eq (load x) (load y)))

; op 12 — build a symbol by concatenating a symbol's name with a suffix. A generic
; instantiation `(Gen A B)` — the same shape `code-field-count` accepts — is mangled
; deterministically (inst-node-mangle), so `derive` can mint a name over a generic
; instance instead of failing here.
(defn code-symbol [(c (ptr Sexp)) (suffix (slice u8))] (-> (ptr Sexp))
  (let [a (malloc-allocator)
        base
          (if (= (code-tag c) (primitive/cast i64 2))
              (sx-sval (load c))
              (if (= (code-tag c) (primitive/cast i64 4))
                  (sx-sval (load c))
                  (if (or (= (code-tag c) (primitive/cast i64 6)) (= (code-tag c) (primitive/cast i64 7)))
                      (let [m (inst-node-mangle a (load c))]
                        (if (= m "")
                            (do (code-die "code-symbol expects a symbol, string, or type instantiation (Gen …)") "")
                            m))
                      (do (code-die "code-symbol expects a symbol, string, or type instantiation (Gen …)") ""))))
        p (unwrap-ptr [Sexp] (create [Sexp] a))]
    (store! p (mk-sexp (KSym (sconcat a base suffix)) -1 -1))
    p))

; op 8 — a fresh hygienic name. Shares the interpreter's counter so the two agree.
(defn code-gensym [] (-> (ptr Sexp))
  (let [a (malloc-allocator)
        p (unwrap-ptr [Sexp] (create [Sexp] a))]
    (store! p (mk-sexp (KSym (sconcat a "$g" (dec->str a (next-gensym)))) -1 -1))
    p))

; ---- constructors (what quasiquote lowers to) -------------------------------
(defn code-mk-int [(v i64)] (-> (ptr Sexp))
  (let [a (malloc-allocator)
        p (unwrap-ptr [Sexp] (create [Sexp] a))]
    (store! p (mk-sexp (KInt v) -1 -1))
    p))
(defn code-mk-sym [(s (slice u8))] (-> (ptr Sexp))
  (let [a (malloc-allocator)
        p (unwrap-ptr [Sexp] (create [Sexp] a))]
    (store! p (mk-sexp (KSym s) -1 -1))
    p))
(defn code-mk-str [(s (slice u8))] (-> (ptr Sexp))
  (let [a (malloc-allocator)
        p (unwrap-ptr [Sexp] (create [Sexp] a))]
    (store! p (mk-sexp (KStr s) -1 -1))
    p))

; A growable list under construction, so quasiquote and code-walking metaprograms
; can build forms without reaching into ArrayList generics at every call site.
(defstruct CodeList [(items (ptr (ArrayList Sexp)))])
(defn code-list-new [] (-> (ptr CodeList))
  (let [a (malloc-allocator)
        p (unwrap-ptr [CodeList] (create [CodeList] a))]
    (store! (field p items) (box-al [Sexp] a (al-new [Sexp] a)))
    p))
(defn code-list-push! [(l (ptr CodeList)) (c (ptr Sexp))] (-> i64)
  (al-push! [Sexp] (load (field l items)) (load c))
  0)
(defn code-list-done [(l (ptr CodeList))] (-> (ptr Sexp))
  (let [a (malloc-allocator)
        p (unwrap-ptr [Sexp] (create [Sexp] a))]
    (store! p (sexp-linked-from-items a (load (field l items)) -1 -1))
    p))
