; src/compiler/main.coil — self-host Coil compiler ENTRY, FULL build (LLVM +
; native arm64 backends). The CLI dispatch / pipeline orchestration lives in the
; shared, backend-agnostic src/compiler/driver.coil; this file adds the LLVM
; backend entry points (dump-ir-program / build-object / build-ir-program /
; do-normalize) and injects them into driver-main as function pointers. The
; LLVM-free build is src/compiler/main_a64.coil (arm64 backend only).
; Imports are FILE-RELATIVE (tool-1): sibling compiler modules resolve against
; THIS file's directory (src/compiler), so the compiler builds from any CWD; bare
; stdlib names (alloc.coil, …) resolve to the bundled library from anywhere.
(module coil.compiler.main)
(import "coil.primitive" :as primitive)
(import "coil.os" :as os)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.ffi" :as ffi :use *)
(import "coil.reader" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.astdump" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.compiler.check" :use *)
(import "coil.compiler.mono" :use *)
(import "coil.compiler.codegen" :use *)
(import "coil.compiler.normalize" :use *)
(import "coil.compiler.diag" :use *)
(import "coil.compiler.trace" :as tr)
(import "coil.compiler.comptime" :use *)
(import "coil.compiler.metaengine" :as me :use *)
(import "coil.compiler.expander" :use *)
(import "coil.compiler.comptime_eval" :use *)  ; compiled comptime/const fold (interp deletion step 1)

(import "coil.compiler.codegen_a64" :use *)
(import "coil.compiler.macho" :use *)  ; MObj — for the in-memory comptime builder below

(import "coil.compiler.codegen_x64" :use *)  ; the native x86-64 backend, for the same thing on an ELF host

(import "coil.scratch" :as scratch)
(import "coil.compiler.unit_state" :use [unit-defer-available? unit-defer!])
(import "coil.compiler.elf" :use *)  ; EObj — what it builds

(import "coil.compiler.driver" :use *)
(import "coil.compiler.wide_ints" :use [expr-kids-into!])

; Import the sibling implementation directly so a self-host rebuild uses the
; compiler sources being rebuilt, not the prior installed SDK bundle.
(import "coil.compiler.jit_api" :as public-jit)
(import "coil.compiler.repl-app" :as repl-app)
(import "coil.compiler.cimport" :as ci)  ; `coil cimport` — qualified, no name leak

; ---- LLVM backend entry points (the only libLLVM-dependent code) ----

; Returns 1 if the pipeline succeeded (IR printed), 0 if a diagnostic was reported.
;
; TWO writers, and the split matters: stdout carries the IR and NOTHING else, while
; diagnostics go to stderr like every other subcommand's (every `run-pipeline` caller
; in driver.coil already passes `(stderr)`; this one passed its stdout writer).
;
; With one shared writer, `coil emit-ir f.coil > f.ll` wrote the error text INTO f.ll,
; and a failed run still produced a few hundred bytes on stdout. That is not just
; untidy — it silently defeats the obvious way to test for failure. Two independent
; attempts to write a correct shell check were beaten by it: `cmd | grep -q needle`
; sees error prose rather than the empty output it expects, so an absence-test passes
; for the wrong reason. A target-os probe check in a shell gate reported `ok` for
; months on that basis. Guarding on the exit status is the reliable fix on the shell side; this is
; the fix on ours.
(defn dump-ir-program [(a (dyn Allocator))
                       (src (slice u8))
                       (cwd (slice u8))
                       (triple (ptr i8))
                       (path (slice u8))] (-> i64)
  (let [(mut bout) (zeroed BufferedOutput)
        w (BufferedOutput::init (mut bout) (stdout))
        diagw (stderr)
        (mut sp0) (ArrayList::new [(slice u8)] a)
        (mut st0) (ArrayList::new [(slice u8)] a)
        result
          (match (run-pipeline a src cwd diagw path (mut sp0) (mut st0))
            (Some [mp]
                  (if (> (generated-unit-count) 0)
                      (do
                        (ps diagw
                            "error: emit-ir requires one module; generated-module sessions have multiple independent IR artifacts; use check or emit-obj\n")
                        0)
                      (do
                        (emit-ir-normalized a
                                            w
                                            mp
                                            triple
                                            (sanitize-mode)
                                            (debug-checks?))
                        1)))
            (None [] 0))]
    (flush (mut bout))
    result))

; Optimization plus the selected sanitizer pass. UBSan checks are emitted during
; lowering because LLVM has no general UBSan IR pass (Clang normally inserts them
; in its language frontend).
(defn opt-pipeline [(sanitize i64) (n i64)] (-> (ptr i8))
  (do
    (cond (= sanitize 1)
            (cond (= n 0) c"default<O0>,asan"
                  (= n 1) c"default<O1>,asan"
                  (= n 2) c"default<O2>,asan"
                  :else c"default<O3>,asan")
          (= sanitize 2)
            (cond (= n 0) c"default<O0>,tsan-module,tsan"
                  (= n 1) c"default<O1>,tsan-module,tsan"
                  (= n 2) c"default<O2>,tsan-module,tsan"
                  :else c"default<O3>,tsan-module,tsan")
          (= sanitize 3)
            (cond (= n 0) c"default<O0>,msan"
                  (= n 1) c"default<O1>,msan"
                  (= n 2) c"default<O2>,msan"
                  :else c"default<O3>,msan")
          (= n 0) c"default<O0>"
          (= n 1) c"default<O1>"
          (= n 2) c"default<O2>"
          :else c"default<O3>")))

; Reject malformed modules before they enter LLVM's optimizer or target emitter.
; LLVMReturnStatusAction = 2 makes the verifier return its message instead of
; printing or aborting, so an internal codegen bug is a deterministic CLI error.
(defn verify-module! [(m (ptr i8)) (phase (slice u8))] (-> i64)
  (let [(mut message) (primitive/cast (ptr i8) 0)]
    (let [failed
            (!= (LLVMVerifyModule m 2 (mut message)) (: 0 i32))
          msg message]
      (when failed
        (ps (stderr) "error: LLVM module verification failed ")
        (ps (stderr) phase)
        (ps (stderr) ":\n")
        (unless (= (primitive/cast i64 msg) 0)
          (ps (stderr) (from-cstr msg))
          0)
        0)
      (unless (= (primitive/cast i64 msg) 0) (LLVMDisposeMessage msg) 0)
      (if failed 0 1))))

; One independently-owned LLVM partition: a context and module of its own, so
; concurrent workers never share an LLVMContext, Module, pass options, or
; TargetMachine.
(defstruct LLVMPartitionJob
  [(context (ptr i8))
   (module (ptr i8))
   (path (ptr i8))
   (triple (ptr i8))
   (cpu (ptr i8))
   (features (ptr i8))
   (optlvl i32)
   (status i32)
   (error (ptr i8))])

(defn llvm-local-linkage? [(linkage i32)] (-> bool)
  ; LLVMInternalLinkage=8, LLVMPrivateLinkage=9.  A local definition referenced
  ; from another object must be promoted to one hidden program-private symbol.
  (or (= linkage (: 8 i32)) (= linkage (: 9 i32))))

;;; The partition that keeps a definition every partition's session made: a
;;; static or an export thunk.
(defn llvm-partition-index [(value (ptr i8))] (-> i64)
  ; Eight is deliberately a power of two: FNV's low bits give a stable mapping
  ; without signed-remainder behavior.
  (& (hash (from-cstr (LLVMGetValueName value))) 7))

(defn llvm-promote-local! [(value (ptr i8))] (-> i64)
  (when (llvm-local-linkage? (LLVMGetLinkage value))
    (LLVMSetLinkage value (: 0 i32))  ; LLVMExternalLinkage
    (LLVMSetVisibility value (: 1 i32))  ; LLVMHiddenVisibility
    0)
  0)

; Copy the attributes at one index (-1 the function, 0 the result, k parameter k).
(defn llvm-copy-attributes! [(a (dyn Allocator))
                             (from (ptr i8))
                             (to (ptr i8))
                             (index i32)] (-> i64)
  (let [n (primitive/cast i64 (LLVMGetAttributeCountAtIndex from index))]
    (when (> n 0)
      (let [stack (primitive/alloc-stack (array (ptr i8) 64))
            attrs
              (if (<= n 64)
                  (primitive/cast (ptr (ptr i8)) stack)
                  (match (alloc-bytes a (primitive/imul n 8) 8)
                    (Some [s] (primitive/cast (ptr (ptr i8)) (primitive/cast (ptr i8) (data s))))
                    (None []
                          (do
                            (ps (stderr) "codegen: out of memory copying LLVM attributes\n")
                            (exit 1)
                            (primitive/cast (ptr (ptr i8)) stack)))))]
        (LLVMGetAttributesAtIndex from index attrs)
        (for [k 0 n]
          (LLVMAddAttributeAtIndex to index (load (index attrs k))))
        0))
    0))

; A definition another partition owns becomes a declaration here: a fresh
; declaration of the same type, calling convention and attributes takes over its
; uses, and the definition is deleted.
(defn llvm-redeclare-function! [(a (dyn Allocator))
                                (module (ptr i8))
                                (fn (ptr i8))] (-> i64)
  (let [name (to-cstr a (from-cstr (LLVMGetValueName fn)))
        decl (LLVMAddFunction module c"" (LLVMGlobalGetValueType fn))
        params (primitive/cast i64 (LLVMCountParams fn))
        section (LLVMGetSection fn)]
    (LLVMSetFunctionCallConv decl (LLVMGetFunctionCallConv fn))
    (LLVMSetVisibility decl (LLVMGetVisibility fn))
    (LLVMSetUnnamedAddress decl (LLVMGetUnnamedAddress fn))
    (LLVMSetAlignment decl (LLVMGetAlignment fn))
    (unless (= (primitive/cast i64 section) 0) (LLVMSetSection decl section) 0)
    (for [k -1 (+ params 1)]
      (llvm-copy-attributes! a fn decl (primitive/cast i32 k)))
    (LLVMReplaceAllUsesWith fn decl)
    (LLVMDeleteFunction fn)
    (LLVMSetValueName2 decl name (len (from-cstr name)))
    0))

(defn pad-decimal [(a (dyn Allocator)) (n i64) (width i64)] (-> (slice u8))
  (let [digits (i64->str a n)
        (mut out) digits]
    (for [k (len digits) width]
      (set! out (sconcat a "0" (load out))))
    (load out)))

;;; The order partitions are cut from: by source file, then position in it, then
;;; name. Neighbouring definitions call each other far more than distant ones do,
;;; and a generic instance sorts beside its template, so a contiguous run keeps
;;; most calls inside one partition, where each worker's own inliner can reach them.
(defn partition-sort-key [(a (dyn Allocator)) (f (ptr Func))] (-> (slice u8))
  (cat3-d a
          (pad-decimal a (+ (.source f) 1) 6)
          (cat3-d a (pad-decimal a (+ (.lo f) 1) 10) (.name f))))

;;; A function's share of a partition: the expressions in its body, which track
;;; the IR it lowers to closely enough to balance eight partitions. (Its source
;;; span does not: an impl method's is its whole impl block's, and a string
;;; literal is long and lowers to nothing.) `stack` is the walk's own worklist.
(defn partition-weight [(stack (mut (ArrayList (ptr Expr)))) (f (ptr Func))] (-> i64)
  (let [body (.body f)
        (mut weight) 1]
    (unless (= (primitive/cast i64 body) 0)
      (for [k 0 (len (load body))]
        (push! (mut stack) (elem body k))))
    (loop (if (= (len (load stack)) 0)
              (break)
              (match (pop! (mut stack))
                (Some [e] (do (set! weight (+ (load weight) 1)) (expr-kids-into! (mut stack) e)))
                (None [] 0))))
    (load weight)))

(defstruct LLVMParts
  [(count i64)
   (parts (array CgPartition 8))])

;;; The partition-weight up to which a function another partition defines is
;;; copied into a partition that uses it. See codegen-partition-import!. 25 body
;;; expressions picks out functions that lower to at most 30 instructions: on
;;; the compiler's own build it chose 98% such ones and 87% of them. Measured
;;; there by that instruction count: with no copies the compiler it built was
;;; 2.3x slower; at 30 instructions slightly faster than one inlined across the
;;; whole module first, for less total work than that inline cost; at 60 the
;;; copies' own optimization cost 30% more.
(defn partition-import-limit [] (-> i64) 25)

;;; Lower the program into eight modules, each in its own context, ready for the
;;; parallel -O3 workers. Partition k defines the k-th contiguous run of
;;; definitions in partition-sort-key order, cut so the runs weigh about the
;;; same, and takes copies of the small functions it uses from the others. Each
;;; partition needs only the program and the weights, not another partition.
(defn lower-partitions [(a (dyn Allocator))
                        (mp (ptr Program))
                        (sanitize i64)
                        (out (ptr LLVMParts))] (-> i64)
  (let [lower-span (tr/span-begin "backend.llvm-lower")
        fs (load (field mp funcs))
        n (len (load fs))
        (mut keys) (ArrayList::new [(slice u8)] a)
        (mut defined) (ArrayList::new [i64] a)
        ; the partition defining each function; -1 for one another unit defines
        (mut owner) (ArrayList::new [i64] a)
        (mut weights) (ArrayList::new [i64] a)
        (mut runs) (ArrayList::new [(ArrayList i64)] a)
        (mut stack) (ArrayList::new [(ptr Expr)] a)
        weights-span (tr/span-begin "backend.partition.weights")]
    (for [i 0 n]
      (let [fp (elem fs i)]
        (push! (mut owner) -1)
        (push! (mut weights) (if (.declared fp) 0 (partition-weight (mut stack) fp)))
        (unless (.declared fp)
          (push! (mut defined) i)
          (push! (mut keys) (partition-sort-key a fp)))
        0))
    (let [ord (sort-index-by-name a (load keys))
          m (len ord)
          (mut total) 0
          (mut cursor) 0
          (mut weight) 0]
      (for [k 0 m]
        (set! total
              (+ (load total)
                 (get (load weights) (get (load defined) (get ord k))))))
      (tr/span-end weights-span)
      (for [part 0 8]
        (let [(mut which) (ArrayList::new [i64] a)
              goal (/ (* (load total) (+ part 1)) 8)]
          (loop (if (or (>= (load cursor) m)
                        (and (< part 7) (>= (load weight) goal)))
                    (break)
                    (let [fi (get (load defined) (get ord (load cursor)))]
                      (push! (mut which) fi)
                      (set! (mut owner) fi part)
                      (set! weight (+ (load weight) (get (load weights) fi)))
                      (set! cursor (+ (load cursor) 1)))))
          (push! (mut runs) (load which)))))
    ; these modules only become objects: their local value names go unread
    (set! (codegen-discard-names-cell) true)
    (for [part 0 8]
      (let [slot (index (field out parts) part)
            open-span (tr/span-begin "backend.partition.open")]
        (set! slot
              (codegen-partition-open a mp (primitive/cast (ptr i8) 0) sanitize (debug-checks?)))
        (tr/span-end open-span)
        (let [lower-own-span (tr/span-begin "backend.partition.lower")]
          (codegen-partition-lower! slot mp (slice (get (load runs) part)))
          (tr/span-end lower-own-span))
        (let [import-span (tr/span-begin "backend.partition.import")]
          (codegen-partition-import! slot
                                     mp
                                     (slice (load owner))
                                     part
                                     (slice (load weights))
                                     (partition-import-limit))
          (tr/span-end import-span))
        (tr/count "backend.partition.copies" (len (.copies slot)))
        (codegen-partition-finish! slot)))
    (set! (codegen-discard-names-cell) false)
    (set! (.count out) 8)
    (let [link-span (tr/span-begin "backend.partition.link")]
      (link-partitions! a out)
      (tr/span-end link-span))
    (tr/span-end lower-span)
    (for [part 0 8]
      (profile-llvm-module (.module (index (field out parts) part))))
    0))

;;; Every partition's session made the same statics and export thunks. Exactly one
;;; partition keeps each definition; the others keep a declaration, so references
;;; stay well-typed.
(defn drop-foreign-open-definitions! [(a (dyn Allocator))
                                      (part (ptr CgPartition))
                                      (partition i64)] (-> i64)
  (let [module (.module part)
        functions (field part open_functions)
        globals (field part open_globals)]
    (for [k 0 (len (load functions))]
      (let [fn (get (load functions) k)]
        (when (!= (llvm-partition-index fn) partition)
          (llvm-redeclare-function! a module fn)
          0)
        0))
    (for [k 0 (len (load globals))]
      (let [global (get (load globals) k)]
        (when (!= (llvm-partition-index global) partition)
          (LLVMSetInitializer global (primitive/cast (ptr i8) 0))
          ; A declaration can only be external: a linkonce_odr or weak
          ; definition that this partition merely references keeps its
          ; merging linkage only where it is defined.
          (LLVMSetLinkage global (: 0 i32))
          0)
        0)))
  0)

;;; Note every name a partition declares and uses: another partition defines it.
;;; The definitions a partition's copies stand for are noted from its `copies`.
(defn note-partition-imports! [(part (ptr CgPartition))
                               (needed (mut (HashMap (slice u8) bool)))] (-> i64)
  (let [(mut fn) (LLVMGetFirstFunction (.module part))]
    (loop (if (= (primitive/cast i64 (load fn)) 0)
              (break)
              (do
                (when (and (!= (LLVMIsDeclaration (load fn)) (: 0 i32))
                           (!= (primitive/cast i64 (LLVMGetFirstUse (load fn))) 0))
                  (set! (mut needed) (from-cstr (LLVMGetValueName (load fn))) true)
                  0)
                (set! fn (LLVMGetNextFunction (load fn)))))))
  (let [(mut global) (LLVMGetFirstGlobal (.module part))]
    (loop (if (= (primitive/cast i64 (load global)) 0)
              (break)
              (do
                (when (and (!= (LLVMIsDeclaration (load global)) (: 0 i32))
                           (!= (primitive/cast i64 (LLVMGetFirstUse (load global))) 0))
                  (set! (mut needed) (from-cstr (LLVMGetValueName (load global))) true)
                  0)
                (set! global (LLVMGetNextGlobal (load global)))))))
  0)

;;; A local definition another partition uses becomes one hidden program-private
;;; symbol; one nothing else uses stays local, so the optimizer still sees all of
;;; its callers. A local declaration is not valid IR at all: it becomes external.
(defn export-partition-uses! [(part (ptr CgPartition))
                              (needed (mut (HashMap (slice u8) bool)))] (-> i64)
  (let [(mut fn) (LLVMGetFirstFunction (.module part))]
    (loop (if (= (primitive/cast i64 (load fn)) 0)
              (break)
              (do
                (when (or (!= (LLVMIsDeclaration (load fn)) (: 0 i32))
                          (contains? (load needed) (from-cstr (LLVMGetValueName (load fn)))))
                  (llvm-promote-local! (load fn)))
                (set! fn (LLVMGetNextFunction (load fn)))))))
  (let [(mut global) (LLVMGetFirstGlobal (.module part))]
    (loop (if (= (primitive/cast i64 (load global)) 0)
              (break)
              (do
                (when (or (!= (LLVMIsDeclaration (load global)) (: 0 i32))
                          (contains? (load needed) (from-cstr (LLVMGetValueName (load global)))))
                  (llvm-promote-local! (load global)))
                (set! global (LLVMGetNextGlobal (load global)))))))
  0)

(defn link-partitions! [(a (dyn Allocator)) (parts (ptr LLVMParts))] (-> i64)
  (let [n (.count parts)
        (mut needed) (HashMap::new [(slice u8) bool] a (keyops))]
    (for [k 0 n]
      (drop-foreign-open-definitions! a (index (field parts parts) k) k))
    (for [k 0 n]
      (note-partition-imports! (index (field parts parts) k) (mut needed))
      (let [copies (field (index (field parts parts) k) copies)]
        (for [c 0 (len (load copies))]
          (set! (mut needed) (get (load copies) c) true))))
    (for [k 0 n]
      (export-partition-uses! (index (field parts parts) k) (mut needed)))
    0))

(defn llvm-partition-worker [(raw (ptr i8))] (-> (ptr i8))
  (let [job (primitive/cast (ptr LLVMPartitionJob) raw)
        context (.context job)
        module (.module job)]
    (let [(mut target-out) (zeroed (ptr i8))
          (mut target-error) (zeroed (ptr i8))]
      (let [(mut verify-error) (primitive/cast (ptr i8) 0)]
        (when (!= (LLVMVerifyModule module 2 (mut verify-error))
                  (: 0 i32))
          (set! (.status job) 5)
          (set! (.error job) verify-error)
          0))
      (if (!= (.status job) (: -1 i32))
          0
          (if (!= (LLVMGetTargetFromTriple (.triple job)
                                           (mut target-out)
                                           (mut target-error))
                  (: 0 i32))
              (do (set! (.status job) 2) (set! (.error job) target-error) 0)
              (let [tm
                      (LLVMCreateTargetMachine target-out
                                               (.triple job)
                                               (.cpu job)
                                               (.features job)
                                               (.optlvl job)
                                               2
                                               0)
                    pbo (LLVMCreatePassBuilderOptions)
                    optimize-span
                      (tr/span-begin "backend.parallel.worker.optimize")
                    pass-error (LLVMRunPasses module c"default<O3>" tm pbo)
                    _optimize-end (tr/span-end optimize-span)]
                (LLVMDisposePassBuilderOptions pbo)
                (if (!= (primitive/cast i64 pass-error) 0)
                    (do
                      (set! (.status job) 3)
                      (set! (.error job) (LLVMGetErrorMessage pass-error)))
                    (let [_grouped (llvm-group-definitions! module
                                                            (from-cstr (.triple job)))
                          (mut emit-error) (zeroed (ptr i8))
                          emit-span
                            (tr/span-begin "backend.parallel.worker.emit")
                          rc
                            (LLVMTargetMachineEmitToFile tm
                                                         module
                                                         (.path job)
                                                         1
                                                         (mut emit-error))
                          _emit-end (tr/span-end emit-span)]
                      (if (!= rc (: 0 i32))
                          (do
                            (set! (.status job) 4)
                            (set! (.error job) emit-error))
                          (set! (.status job) 0))))
                (LLVMDisposeTargetMachine tm)
                0)))
      (LLVMDisposeModule module)
      (LLVMContextDispose context)
      (primitive/cast (ptr i8) 0))))

; Initialize an attr only when both requested protections took effect. On any
; failure, destroy what was initialized and tell the caller to run inline on the
; pipeline's established deep stack rather than silently use a small host default.
(defn llvm-worker-attr-init! [(attr (ptr i8))] (-> i32)
  (let [init-status (pthread_attr_init attr)]
    (if (!= init-status (: 0 i32))
        init-status
        (let [stack-status
                (pthread_attr_setstacksize attr (llvm-worker-stack-size))]
          (if (!= stack-status (: 0 i32))
              (do (pthread_attr_destroy attr) stack-status)
              (let [guard-status
                      (pthread_attr_setguardsize attr (worker-guard-size))]
                (if (!= guard-status (: 0 i32))
                    (do (pthread_attr_destroy attr) guard-status)
                    (: 0 i32))))))))

(defn llvm-partition-path [(a (dyn Allocator))
                           (prefix (ptr i8))
                           (partition i64)] (-> (ptr i8))
  (to-cstr a
           (cat3-d a
                   (from-cstr prefix)
                   (cat3-d a ".part-" (cat3-d a (i64->str a partition) ".o")))))

;;; Optimize and emit lower-partitions' modules on one thread each, as
;;; `<obj-prefix>.part-<k>.o`. Each worker receives exclusive ownership of its
;;; partition's context and module and disposes them; no LLVM object crosses
;;; between workers. Returns the number of objects written.
(defn emit-partitions! [(a (dyn Allocator))
                        (parts (ptr LLVMParts))
                        (obj-prefix (ptr i8))
                        (triple (ptr i8))] (-> i64)
  (let [n (.count parts)
        jobs (primitive/alloc-stack (array LLVMPartitionJob 8))
        tids (primitive/alloc-stack (array (ptr i8) 8))
        started (primitive/alloc-stack (array i32 8))]
    (llvm-initialize-emitters!)
    (for [i 0 n]
      (let [job (index jobs i)
            part (.module (index (field parts parts) i))]
        (set! (.context job) (LLVMGetModuleContext part))
        (set! (.module job) part)
        (set! (.path job) (llvm-partition-path a obj-prefix i))
        (set! (.triple job) triple)
        (set! (.cpu job) (llvm-cpu triple))
        (set! (.features job) (llvm-cpu-features triple))
        (set! (.optlvl job) (: 3 i32))
        (set! (.status job) -1)
        (set! (.error job) (primitive/cast (ptr i8) 0))
        0))
    (let [workers-span (tr/span-begin "backend.parallel.workers")
          (mut  ; LLVM's optimizers recurse deeply on large, heavily-inlined modules.
               ; A null pthread attr gives these codegen threads the host's small
               ; default stack (512 KiB on macOS). Keep their explicit stack separate
               ; from the much larger stack reserved for the compiler pipeline.
               attr)
            (zeroed (array i8 64))
          attr-status
            (llvm-worker-attr-init! (primitive/cast (ptr i8) (mut attr)))]
      (for [i 0 n]
        (let [rc
                (if (= attr-status (: 0 i32))
                    (pthread_create (primitive/cast (ptr i8) (index tids i))
                                    (primitive/cast (ptr i8) (mut attr))
                                    (fnptr-of llvm-partition-worker)
                                    (primitive/cast (ptr i8) (index jobs i)))
                    attr-status)]
          (set! (index started i) rc)
          ; Resource exhaustion must not turn into a join of an
          ; uninitialized handle. Execute that partition inline.
          (when (!= rc (: 0 i32))
            (llvm-partition-worker (primitive/cast (ptr i8) (index jobs i)))
            0)
          0))
      (when (= attr-status (: 0 i32))
        (pthread_attr_destroy (primitive/cast (ptr i8) (mut attr)))
        0)
      (for [i 0 n]
        (when (= (load (index started i)) (: 0 i32))
          (pthread_join (load (index tids i)) (primitive/cast (ptr i8) 0))
          0))
      (tr/span-end workers-span))
    (for [i 0 n]
      (let [job (index jobs i)]
        (when (!= (.status job) (: 0 i32))
          (ps (stderr) "codegen: LLVM partition ")
          (dump-dec (stderr) i)
          (ps (stderr) " failed")
          (when (!= (primitive/cast i64 (.error job)) 0)
            (ps (stderr) ": ")
            (ps (stderr) (from-cstr (.error job)))
            (if (= (.status job) (: 3 i32))
                (LLVMDisposeErrorMessage (.error job))
                (LLVMDisposeMessage (.error job)))
            0)
          (wb (stderr) 10)
          (for [k 0 n] (ffi/unlink (.path (index jobs k))))
          (exit 1)
          0)
        0))
    n))

(defn llvm-function-count [(m (ptr i8))] (-> i64)
  (let [(mut count) 0
        (mut fn) (LLVMGetFirstFunction m)]
    (loop (if (= (primitive/cast i64 (load fn)) 0)
              (break)
              (do
                (when (= (LLVMIsDeclaration (load fn)) (: 0 i32))
                  (set! count (+ (load count) 1))
                  0)
                (set! fn (LLVMGetNextFunction (load fn))))))
    (load count)))

(defn profile-llvm-module [(m (ptr i8))] (-> i64)
  (when (tr/trace-env?)
    (let [(mut globals) 0
          (mut instructions) 0
          (mut g) (LLVMGetFirstGlobal m)
          (mut f) (LLVMGetFirstFunction m)]
      (loop (if (= (primitive/cast i64 (load g)) 0)
                (break)
                (do
                  (set! globals (+ (load globals) 1))
                  (set! g (LLVMGetNextGlobal (load g))))))
      (loop (if (= (primitive/cast i64 (load f)) 0)
                (break)
                (do
                  (let [(mut b) (LLVMGetFirstBasicBlock (load f))]
                    (loop (if (= (primitive/cast i64 (load b)) 0)
                              (break)
                              (do
                                (let [(mut inst)
                                        (LLVMGetFirstInstruction (load b))]
                                  (loop (if (= (primitive/cast i64 (load inst))
                                               0)
                                            (break)
                                            (do
                                              (set! instructions
                                                    (+ (load instructions) 1))
                                              (set! inst
                                                    (LLVMGetNextInstruction (load inst)))))))
                                (set! b (LLVMGetNextBasicBlock (load b)))))))
                  (set! f (LLVMGetNextFunction (load f))))))
      (tr/count "llvm.functions" (llvm-function-count m))
      (tr/count "llvm.globals" (load globals))
      (tr/count "llvm.instructions" (load instructions)))
    0)
  0)

; mono'd Program -> native object file. Mirrors
; (the release/`src_path = None` path): build the module (codegen-module already
; sets target + datalayout), create a host target machine (cpu "generic", no
; features, reloc PIC=2, codemodel Default=0) at CodeGenOptLevel `optlvl`, run the
; matching `default<On>` pipeline through the new pass manager, then EmitToFile.
; `optlvl` is passed in rather than read from the global because the PROGRAM object
; and the METAPROGRAM object can be built at different levels (-O vs --meta-opt=).
(defn build-object [(a (dyn Allocator))
                    (mp (ptr Program))
                    (obj-cstr (ptr i8))
                    (triple-override (ptr i8))
                    (sanitize i64)
                    (optlvl i64)] (-> i64)
  (emit-lowered-object a
                       (lower-object a mp triple-override sanitize)
                       obj-cstr
                       triple-override
                       sanitize
                       optlvl))

(defn lower-object [(a (dyn Allocator))
                    (mp (ptr Program))
                    (triple-override (ptr i8))
                    (sanitize i64)] (-> (ptr i8))
  (let [lower-span (tr/span-begin "backend.llvm-lower")
        ; this module only becomes an object: its local value names go unread
        _names (set! (codegen-discard-names-cell) true)
        m (codegen-module a mp triple-override sanitize (debug-checks?))]
    (set! (codegen-discard-names-cell) false)
    (tr/span-end lower-span)
    (profile-llvm-module m)
    m))

;;; The object emitters of every target a build may name.
(defn llvm-initialize-emitters! [] (-> i64)
  (LLVMInitializeAArch64AsmPrinter)
  (LLVMInitializeX86AsmPrinter)
  (LLVMInitializeRISCVAsmPrinter)
  (LLVMInitializeWebAssemblyAsmPrinter)
  (LLVMInitializeAArch64AsmParser)
  (LLVMInitializeX86AsmParser)
  (LLVMInitializeRISCVAsmParser)
  0)

;;; Verify, optimize and emit a lowered module, then dispose it. Nothing here reads
;;; the checked program: `a` serves only this function's own small allocations.
(defn emit-lowered-object [(a (dyn Allocator))
                           (m (ptr i8))
                           (obj-cstr (ptr i8))
                           (triple-override (ptr i8))
                           (sanitize i64)
                           (optlvl i64)] (-> i64)
  (let [triple
          (if (= (primitive/cast i64 triple-override) 0)
              (host-target-triple a)
              triple-override)
        (mut targetout) (zeroed (ptr i8))
        (mut errout) (zeroed (ptr i8))
        result
          (block :compile
                 (unless (= (verify-module! m "after lowering") 1)
                   (return-from :compile 0))
                 (llvm-initialize-emitters!)
                 (when (!= (LLVMGetTargetFromTriple triple
                                                    (mut targetout)
                                                    (mut errout))
                           (: 0 i32))
                   (ps (stderr) "error: unsupported --target '")
                   (ps (stderr) (from-cstr triple))
                   (ps (stderr) "': ")
                   (ps (stderr) (from-cstr errout))
                   (wb (stderr) 10)
                   (LLVMDisposeMessage errout)
                   (return-from :compile 0))
                 (let [tm
                         (LLVMCreateTargetMachine targetout
                                                  triple
                                                  (llvm-cpu triple)
                                                  (llvm-cpu-features triple)
                                                  (primitive/cast i32 optlvl)
                                                  (llvm-reloc-model triple)
                                                  0)
                       pbo (LLVMCreatePassBuilderOptions)
                       emitted
                         (block :emit
                                (when (= (primitive/cast i64 tm) 0)
                                  (ps (stderr)
                                      "error: LLVM could not create target machine\n")
                                  (return-from :emit 0))
                                (let [optimize-span
                                        (tr/span-begin "backend.llvm-optimize")
                                      rp
                                        (LLVMRunPasses m
                                                       (opt-pipeline sanitize optlvl)
                                                       tm
                                                       pbo)
                                      _optimize-end (tr/span-end optimize-span)]
                                  (unless (= (primitive/cast i64 rp) 0)
                                    (let [message (LLVMGetErrorMessage rp)]
                                      (ps (stderr)
                                          "codegen: LLVMRunPasses failed: ")
                                      (ps (stderr) (from-cstr message))
                                      (wb (stderr) 10)
                                      (LLVMDisposeErrorMessage message))
                                    (return-from :emit 0)))
                                (unless (= (verify-module! m
                                                           "after optimization")
                                           1)
                                  (return-from :emit 0))
                                (llvm-group-definitions! m (from-cstr triple))
                                (let [(mut emiterr) (primitive/cast (ptr i8) 0)
                                      tmp-cstr
                                        (to-cstr a
                                                 (sconcat a
                                                          (from-cstr obj-cstr)
                                                          ".tmp"))]
                                  (ffi/unlink tmp-cstr)
                                  (let [emit-span
                                          (tr/span-begin "backend.object-emit")
                                        rc
                                          (LLVMTargetMachineEmitToFile tm
                                                                       m
                                                                       tmp-cstr
                                                                       1
                                                                       (mut emiterr))
                                        _emit-end (tr/span-end emit-span)]
                                    (when (!= rc (: 0 i32))
                                      (ps (stderr)
                                          "error: could not write object file '")
                                      (ps (stderr) (from-cstr obj-cstr))
                                      (ps (stderr) "': ")
                                      (unless (= (primitive/cast i64 emiterr) 0)
                                        (ps (stderr) (from-cstr emiterr))
                                        (LLVMDisposeMessage emiterr)
                                        0)
                                      (wb (stderr) 10)
                                      (ps (stderr)
                                          "  the output path is not writable — give `-o` a writable path, or use `coil check <file>` to typecheck without emitting an object\n")
                                      (ffi/unlink tmp-cstr)
                                      (return-from :emit 0)))
                                  (when (!= (me/rename tmp-cstr obj-cstr)
                                            (: 0 i32))
                                    (ps (stderr)
                                        "error: could not finalize object file '")
                                    (ps (stderr) (from-cstr obj-cstr))
                                    (ps (stderr) "'\n")
                                    (ffi/unlink tmp-cstr)
                                    (return-from :emit 0)))
                                1)]
                   (LLVMDisposePassBuilderOptions pbo)
                   (unless (= (primitive/cast i64 tm) 0)
                     (LLVMDisposeTargetMachine tm)
                     0)
                   emitted))]
    (codegen-dispose-module! m)
    (when (= (primitive/cast i64 triple-override) 0)
      (LLVMDisposeMessage triple)
      0)
    result))

; Returns 1 if the pipeline succeeded (object emitted), 0 if a diagnostic was
; reported. build-cmd checks this and HALTS before linking on failure (mirroring
; the object build fails before `cc` is ever invoked).
(defn build-ir-program [(a (dyn Allocator))
                        (src (slice u8))
                        (cwd (slice u8))
                        (obj-cstr (ptr i8))
                        (triple (ptr i8))
                        (path (slice u8))] (-> i64)
  (let [w (stderr)
        (mut sp0) (ArrayList::new [(slice u8)] a)
        (mut st0) (ArrayList::new [(slice u8)] a)]
    (match (run-pipeline a src cwd w path (mut sp0) (mut st0))
      (Some [mp]
            (let [req (cg-debug-req)
                  _req (do (set! (.on req) (native-emit-dwarf?))
                           (set! (.mainpath req) path)
                           (set! (.compdir req) cwd)
                           (set! (.paths req) (box-al [(slice u8)] a (load sp0)))
                           (set! (.texts req) (box-al [(slice u8)] a (load st0))))
                  parts (primitive/alloc-stack LLVMParts)
                  ; partitions are lowered without debug info: one module carries it
                  partitioned
                    (and (parallel-codegen?)
                         (and (= (generated-unit-count) 0)
                              (and (= (sanitize-mode) 0)
                                   (and (= (opt-level) 3)
                                        (and (= (primitive/cast i64 triple) 0)
                                             (and (not (.on req))
                                                  (>= (len (load (field mp funcs)))
                                                      (ffi-decimal-env c"COIL_PARALLEL_CODEGEN_MIN_FUNCTIONS"
                                                                       256))))))))
                  m (if partitioned
                        (do (lower-partitions a mp (sanitize-mode) parts)
                            (primitive/cast (ptr i8) 0))
                        (do (set! (.count parts) 0)
                            (lower-object a mp triple (sanitize-mode))))
                  _off (set! (.on req) false)]
              (if (unit-defer-available?)
                  (defer-object-emission! m
                                          parts
                                          obj-cstr
                                          triple
                                          (sanitize-mode)
                                          (opt-level))
                  (emit-lowered a m parts obj-cstr triple (sanitize-mode) (opt-level)))))
      (None [] 0))))

;;; Emit what build-ir-program lowered: lower-partitions' modules when `parts`
;;; holds any, otherwise the one module `m`.
(defn emit-lowered [(a (dyn Allocator))
                    (m (ptr i8))
                    (parts (ptr LLVMParts))
                    (obj-cstr (ptr i8))
                    (triple-override (ptr i8))
                    (sanitize i64)
                    (optlvl i64)] (-> i64)
  (if (> (.count parts) 0)
      (let [triple (host-target-triple a)
            result (emit-partitions! a parts obj-cstr triple)]
        (LLVMDisposeMessage triple)
        result)
      (emit-lowered-object a m obj-cstr triple-override sanitize optlvl)))

;;; A lowered module waiting for its unit to be released. The record, and copies of
;;; the strings it borrowed from the command, live in its own arena, which then
;;; serves emission.
(defstruct DeferredObject
  [(arena (ptr scratch/ScratchArena))
   (module (ptr i8))
   (parts LLVMParts)
   (obj (ptr i8))
   (triple (ptr i8))
   (sanitize i64)
   (optlvl i64)])

;;; Returns 1: the unit succeeded, and the command's result comes from the
;;; deferred emission (unit-defer-finish!).
(defn defer-object-emission! [(m (ptr i8))
                              (parts (ptr LLVMParts))
                              (obj-cstr (ptr i8))
                              (triple-override (ptr i8))
                              (sanitize i64)
                              (optlvl i64)] (-> i64)
  (let [arena
          (box! (malloc-allocator)
                scratch/ScratchArena
                (zeroed scratch/ScratchArena))
        _init
          (scratch/ScratchArena::init-with-capacity arena
                                                    (malloc-allocator)
                                                    65536)
        d (allocator arena)
        record
          (box! d
                DeferredObject
                (DeferredObject
                  :arena arena
                  :module m
                  :parts (load parts)
                  :obj (to-cstr d (from-cstr obj-cstr))
                  :triple
                    (if (= (primitive/cast i64 triple-override) 0)
                        triple-override
                        (to-cstr d (from-cstr triple-override)))
                  :sanitize sanitize
                  :optlvl optlvl))]
    (unit-defer! (fnptr-of finish-deferred-object)
                 (primitive/cast (ptr i8) record))
    1))

(defn finish-deferred-object [(raw (ptr i8))] (-> i64)
  (let [record (primitive/cast (ptr DeferredObject) raw)
        arena (.arena record)
        result
          (emit-lowered (allocator arena)
                        (.module record)
                        (field record parts)
                        (.obj record)
                        (.triple record)
                        (.sanitize record)
                        (.optlvl record))]
    (close! arena)
    (destroy (malloc-allocator) arena)
    result))

; `__normalize` debug subcommand: print normalized textual LLVM IR of `src`.
(defn do-normalize [(a (dyn Allocator)) (src (slice u8))] (-> i64)
  (let [w (stdout)] (ps w (normalize-ir a src)) 0))

; Inject the LLVM backend entry points into the shared driver as function pointers.
; default-backend = 1 (LLVM) — a bare `build` uses the LLVM backend, `--backend arm64`
; switches to the native backend.
(defn do-cimport [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (ci/cimport-cli a argc argv 2))

; `coil build-unit`'s object builder: a mono'd unit Program -> ONE object file at
; the program's optimization level. One object, not a partition set: a
; partitioned build promotes every internal symbol to a hidden external so the
; parts can reach each other, and two units built that way would define the
; same hidden names and collide at link.
(defn build-unit-obj-llvm [(a (dyn Allocator))
                           (mp (ptr Program))
                           (obj (ptr i8))] (-> i64)
  (build-object a
                mp
                obj
                (primitive/cast (ptr i8) 0)
                (sanitize-mode)
                (opt-level)))

; the compiled-metaprogram engine's object builder (metaengine.coil): a mono'd
; metaprogram Program -> object file, via the LLVM backend (host triple).
(defn meta-build-obj-llvm [(a (dyn Allocator))
                           (mp (ptr Program))
                           (obj (ptr i8))] (-> i64)
  ; NEVER sanitize the metaprogram dylib: it is dlopen'd into the compiler, and an
  ; ASan-instrumented dylib loaded that late aborts the process (mem-7).
  (do
    (build-object a mp obj (primitive/cast (ptr i8) 0) 0 (meta-opt-level))
    0))

; The comptime object, handed back IN MEMORY so comptime_eval can load it straight
; into executable pages (jit.coil) instead of forking `cc -dynamiclib` per site.
;
; This uses the ARM64 backend even in the LLVM build, for two reasons. A comptime
; thunk always runs in THIS process on THIS machine, and the self-host always lowers
; for the arm64 host regardless of --target, so host code is arm64 either way.
; And the readback (comptime_eval.coil::cte-ty-size) walks the natural C layout that
; codegen_a64's g-natural-layout! emits — so building the object with the arm64
; backend puts the writer and the reader on the same layout, which the LLVM path
; was not guaranteed to be (see the type-bytes / g-type-bytes divergence in
; docs/archive/INTERP_DELETION.md).
(defn meta-build-mobj-llvm [(a (dyn Allocator)) (mp (ptr Program))] (-> MObj)
  (cga64-build-mobj a
                    mp
                    ""
                    ""
                    (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                    (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                    false))

; The in-memory fast path JITs machine code straight into this process, so the
; builder registered has to match the host: an arm64 host gets the MObj/Mach-O pair
; above, an x86-64 host the EObj/ELF pair below. A host that is neither keeps
; comptime_eval's dylib route.
;
; The x86-64 sibling of meta-build-mobj-llvm. Same reasoning applies: a comptime
; thunk runs in THIS process on THIS machine, and comptime_eval's readback walks the
; natural C layout the native backends emit, so building the in-memory object with
; codegen_x64 puts the writer and the reader on the same layout. This backend is
; already linked into the LLVM build (driver.coil imports cgx64 for `--backend x64`),
; so registering it here costs no new dependency.
(defn meta-build-eobj-llvm [(a (dyn Allocator)) (mp (ptr Program))] (-> EObj)
  (cgx64-build-eobj a
                    mp
                    ""
                    ""
                    (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                    (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                    false))

(defn host-arm64? [] (-> bool)
  (match (find (from-cstr (LLVMGetDefaultTargetTriple)) "aarch64")
    (Some [i0] true)
    (None []
          (match (find (from-cstr (LLVMGetDefaultTargetTriple)) "arm64")
            (Some [i1] true)
            (None [] false)))))

(defn host-x86-64? [] (-> bool)
  (match (find (from-cstr (LLVMGetDefaultTargetTriple)) "x86_64")
    (Some [i0] true)
    (None [] false)))

; The compiler spawns the linker driver directly (spawn-wait -> os/spawn), and
; posix_spawn takes the child environment EXPLICITLY: whatever `os/spawn-envp`
; returns is all the child gets. Nothing published one, so it returned NULL and
; every linker child ran with an EMPTY environment.
;
; Apple's /usr/bin/cc locates `ld` without consulting PATH, so ordinary builds
; never noticed. The sanitizer path uses the clang beside the LLVM that inserted
; the pass -- Homebrew's -- and that one finds `ld` ON PATH, so `--sanitize=...`
; died as `clang: error: unable to execute command: posix_spawn failed: No such
; file or directory`, which names neither the environment nor the linker.
;
; coil.os says main's third C argument is the portable way to get it and that
; whoever owns `main` publishes it once. This is that owner.
(defn main [(argc i32) (argv (ptr (ptr i8))) (envp (ptr (ptr i8)))] (-> i64)
  (os/publish-envp! envp)  ; the linker child inherits this; see above
  (set-meta-build-obj! (fnptr-of meta-build-obj-llvm))
  (set-unit-build-obj! (fnptr-of build-unit-obj-llvm))
  ; Register the in-memory object builder this host can actually execute, and make
  ; it the default: metaprograms then go straight into memory instead of through
  ; `cc -dynamiclib` + dlopen + the on-disk cache. A host that is neither arm64 nor
  ; x86-64 registers neither and keeps the dylib route.
  (if (host-arm64?)
      (do
        (set-meta-build-mobj! (fnptr-of meta-build-mobj-llvm))
        (meta-jit-default-on!))
      (when (host-x86-64?)
        (set-meta-build-eobj! (fnptr-of meta-build-eobj-llvm))
        (meta-jit-default-on!)
        0))
  (select-meta-interp-from-env!)  ; COIL_META_INTERP=1: the interpreted engine
  (register-comptime-fold!)  ; route comptime/const sites the interpreter can't fold through the compiled engine (mac-8)
  (driver-main argc
               argv
               (fnptr-of build-ir-program)
               (fnptr-of dump-ir-program)
               (fnptr-of do-normalize)
               (fnptr-of do-cimport)
               (fnptr-of repl-app/repl-main)
               1))
