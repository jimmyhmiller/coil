; src/compiler/main.coil — self-host Coil compiler ENTRY, FULL build (LLVM +
; native arm64 backends). The CLI dispatch / pipeline orchestration lives in the
; shared, backend-agnostic src/compiler/driver.coil; this file adds the LLVM
; backend entry points (dump-ir-program / build-object / build-ir-program /
; do-normalize) and injects them into driver-main as function pointers. The
; LLVM-free build is src/compiler/main_a64.coil (arm64 backend only).
; Imports are FILE-RELATIVE (tool-1): sibling compiler modules resolve against
; THIS file's directory (src/compiler), so the compiler builds from any CWD; bare
; stdlib names (alloc.coil, …) resolve to the bundled library from anywhere.
(module main)
(import "coil.primitive" :as primitive)
(import "coil.os" :as os)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "ffi" :as ffi :use *)
(import "coil.reader" :use *)
(import "ast" :use *)
(import "astdump" :use *)
(import "parser" :use *)
(import "loader" :use *)
(import "resolve" :use *)
(import "check" :use *)
(import "mono" :use *)
(import "codegen" :use *)
(import "normalize" :use *)
(import "diag" :use *)
(import "trace" :as tr)
(import "comptime" :use *)
(import "metaengine" :as me :use *)
(import "expander" :use *)
(import "comptime_eval" :use *)  ; compiled comptime/const fold (interp deletion step 1)
(import "cga64" :use *)
(import "macho" :use *)  ; MObj — for the in-memory comptime builder below
(import "cgx64" :use *)  ; the native x86-64 backend, for the same thing on an ELF host
(import "elf" :use *)  ; EObj — what it builds
(import "driver" :use *)
; Import the sibling implementation directly so a self-host rebuild uses the
; compiler sources being rebuilt, not the prior installed SDK bundle.
(import "jit_api" :as public-jit)
(import "cimport" :as ci)  ; `coil cimport` — qualified, no name leak

; ---- LLVM backend entry points (the only libLLVM-dependent code) ----

; Returns 1 if the pipeline succeeded (IR printed), 0 if a diagnostic was reported.
;
; TWO writers, and the split matters: stdout carries the IR and NOTHING else, while
; diagnostics go to stderr like every other subcommand's (every `run-pipeline` caller
; in driver.coil already passes `(stderr)`; this one passed its stdout writer).
;
; With one shared writer, `coil emit-ir f.coil > f.ll` wrote the error text INTO f.ll,
; and a failed run still produced a few hundred bytes on stdout. That is not just
; untidy — it silently defeats the obvious way to test for failure. Two independent
; attempts to write a correct shell check were beaten by it: `cmd | grep -q needle`
; sees error prose rather than the empty output it expects, so an absence-test passes
; for the wrong reason. gate-target-os's probe check reported `ok` for months on that
; basis. Guarding on the exit status is the reliable fix on the shell side; this is
; the fix on ours.
(defn dump-ir-program [(a (dyn Allocator)) (src (slice u8)) (cwd (slice u8)) (triple (ptr i8)) (path (slice u8))] (-> i64)
  (let [bout (primitive/alloc-stack BufferedOutput)
        w (buffered-output-writer bout (stdout))
        diagw (stderr)
        (mut sp0) (al-new [(slice u8)] a)
        (mut st0) (al-new [(slice u8)] a)
        result
          (match (run-pipeline a src cwd diagw path (mut sp0) (mut st0))
            (Some [mp] (do (emit-ir-normalized a w mp triple (sanitize-mode) (debug-checks?)) 1))
            (None [] 0))]
    (buffered-output-flush bout)
    result))

; Optimization plus the selected sanitizer pass. UBSan checks are emitted during
; lowering because LLVM has no general UBSan IR pass (Clang normally inserts them
; in its language frontend).
(defn opt-pipeline [(sanitize i64) (n i64)] (-> (ptr i8))
  (do
    (cond (= sanitize (primitive/cast i64 1))
            (cond (= n (primitive/cast i64 0)) c"default<O0>,asan"
                  (= n (primitive/cast i64 1)) c"default<O1>,asan"
                  (= n (primitive/cast i64 2)) c"default<O2>,asan"
                  :else c"default<O3>,asan")
          (= sanitize (primitive/cast i64 2))
            (cond (= n (primitive/cast i64 0)) c"default<O0>,tsan-module,tsan"
                  (= n (primitive/cast i64 1)) c"default<O1>,tsan-module,tsan"
                  (= n (primitive/cast i64 2)) c"default<O2>,tsan-module,tsan"
                  :else c"default<O3>,tsan-module,tsan")
          (= sanitize (primitive/cast i64 3))
            (cond (= n (primitive/cast i64 0)) c"default<O0>,msan"
                  (= n (primitive/cast i64 1)) c"default<O1>,msan"
                  (= n (primitive/cast i64 2)) c"default<O2>,msan"
                  :else c"default<O3>,msan")
          (= n (primitive/cast i64 0)) c"default<O0>"
          (= n (primitive/cast i64 1)) c"default<O1>"
          (= n (primitive/cast i64 2)) c"default<O2>"
          :else c"default<O3>")))

; Reject malformed modules before they enter LLVM's optimizer or target emitter.
; LLVMReturnStatusAction = 2 makes the verifier return its message instead of
; printing or aborting, so an internal codegen bug is a deterministic CLI error.
(defn verify-module! [(m (ptr i8)) (phase (slice u8))] (-> i64)
  (let [message (primitive/alloc-stack (ptr i8))]
    (store! message (primitive/cast (ptr i8) 0))
    (when (!= (LLVMVerifyModule m 2 message) (primitive/cast i32 0))
      (let [w (stderr)
            msg (load message)]
        (ps w "error: LLVM module verification failed ")
        (ps w phase)
        (ps w ":\n")
        (when (!= (primitive/cast i64 msg) (primitive/cast i64 0))
          (ps w (cstr->slice msg))
          (LLVMDisposeMessage msg)
          0)
        (exit 1)
        0))
    0))

; One independently-owned LLVM partition. The coordinator reparses the complete
; module into a fresh context and prunes it; concurrent workers therefore never
; share an LLVMContext, Module, pass options, or TargetMachine.
(defstruct LLVMPartitionJob
  [(context (ptr i8))
   (module (ptr i8))
   (path (ptr i8))
   (triple (ptr i8))
   (cpu (ptr i8))
   (features (ptr i8))
   (optlvl i32)
   (status i32)
   (error (ptr i8))])

(defn llvm-local-linkage? [(linkage i32)] (-> bool)
  ; LLVMInternalLinkage=8, LLVMPrivateLinkage=9.  A local definition referenced
  ; from another object must be promoted to one hidden program-private symbol.
  (or (= linkage (primitive/cast i32 8)) (= linkage (primitive/cast i32 9))))

(defn llvm-partition-index [(value (ptr i8))] (-> i64)
  ; Eight is deliberately a power of two: FNV's low bits give a stable mapping
  ; without signed-remainder behavior. LLVM-generated definitions are named.
  (primitive/iand (str-hash (cstr->slice (LLVMGetValueName value))) 7))

(defn llvm-promote-local! [(value (ptr i8))] (-> i64)
  (when (llvm-local-linkage? (LLVMGetLinkage value))
    (LLVMSetLinkage value (primitive/cast i32 0)) ; LLVMExternalLinkage
    (LLVMSetVisibility value (primitive/cast i32 1)) ; LLVMHiddenVisibility
    0)
  0)

(defn llvm-declare-function! [(fn (ptr i8))] (-> i64)
  (let [(mut bb) (LLVMGetFirstBasicBlock fn)]
    (loop (if (= (primitive/cast i64 (load bb)) 0)
              (break)
              (let [next (LLVMGetNextBasicBlock (load bb))]
                (LLVMDeleteBasicBlock (load bb))
                (store! bb next)))))
  0)

(defn llvm-prune-partition! [(part (ptr i8)) (partition i64)] (-> i64)
  (let [(mut fn) (LLVMGetFirstFunction part)]
    (loop (if (= (primitive/cast i64 (load fn)) 0)
              (break)
              (let [next (LLVMGetNextFunction (load fn))]
                (when (= (LLVMIsDeclaration (load fn)) (primitive/cast i32 0))
                  (llvm-promote-local! (load fn))
                  (when (!= (llvm-partition-index (load fn)) partition)
                    (llvm-declare-function! (load fn))
                    0))
                (store! fn next))))
    ; A global initializer is its definition. Exactly one partition retains it;
    ; the other clones retain a declaration so references remain well-typed.
    (let [(mut global) (LLVMGetFirstGlobal part)]
      (loop (if (= (primitive/cast i64 (load global)) 0)
                (break)
                (let [next (LLVMGetNextGlobal (load global))
                      initializer (LLVMGetInitializer (load global))]
                  (when (!= (primitive/cast i64 initializer) 0)
                    (llvm-promote-local! (load global))
                    (when (!= (llvm-partition-index (load global)) partition)
                      (LLVMSetInitializer (load global) (primitive/cast (ptr i8) 0))
                      0))
                  (store! global next)))))
    0))

(defn llvm-partition-worker [(raw (ptr i8))] (-> (ptr i8))
  (let [job (primitive/cast (ptr LLVMPartitionJob) raw)
        context (.context job)
        module (.module job)]
    (let [
              target-out (primitive/alloc-stack (ptr i8))
              target-error (primitive/alloc-stack (ptr i8))]
          (let [verify-error (primitive/alloc-stack (ptr i8))]
            (store! verify-error (primitive/cast (ptr i8) 0))
            (when (!= (LLVMVerifyModule module 2 verify-error) (primitive/cast i32 0))
              (set! (.status job) 5)
              (set! (.error job) (load verify-error))
              0))
          (if (!= (.status job) (primitive/cast i32 -1))
              0
              (if (!= (LLVMGetTargetFromTriple (.triple job) target-out target-error)
                  (primitive/cast i32 0))
              (do
                (set! (.status job) 2)
                (set! (.error job) (load target-error))
                0)
              (let [tm (LLVMCreateTargetMachine (load target-out)
                                                (.triple job)
                                                (.cpu job)
                                                (.features job)
                                                (.optlvl job)
                                                2
                                                0)
                    pbo (LLVMCreatePassBuilderOptions)
                    optimize-span (tr/span-begin "backend.parallel.worker.optimize")
                    pass-error (LLVMRunPasses module c"default<O3>" tm pbo)
                    _optimize-end (tr/span-end optimize-span)]
                (LLVMDisposePassBuilderOptions pbo)
                (if (!= (primitive/cast i64 pass-error) 0)
                    (do
                      (set! (.status job) 3)
                      (set! (.error job) (LLVMGetErrorMessage pass-error)))
                    (let [emit-error (primitive/alloc-stack (ptr i8))
                          emit-span (tr/span-begin "backend.parallel.worker.emit")
                          rc (LLVMTargetMachineEmitToFile tm module (.path job) 1 emit-error)
                          _emit-end (tr/span-end emit-span)]
                      (if (!= rc (primitive/cast i32 0))
                          (do (set! (.status job) 4) (set! (.error job) (load emit-error)))
                          (set! (.status job) 0))))
                (LLVMDisposeTargetMachine tm)
                0)))
          (LLVMDisposeModule module)
          (LLVMContextDispose context)
          (primitive/cast (ptr i8) 0))))

; Initialize an attr only when both requested protections took effect. On any
; failure, destroy what was initialized and tell the caller to run inline on the
; pipeline's established deep stack rather than silently use a small host default.
(defn llvm-worker-attr-init! [(attr (ptr i8))] (-> i32)
  (let [init-status (pthread_attr_init attr)]
    (if (!= init-status (primitive/cast i32 0))
        init-status
        (let [stack-status (pthread_attr_setstacksize attr (llvm-worker-stack-size))]
          (if (!= stack-status (primitive/cast i32 0))
              (do (pthread_attr_destroy attr) stack-status)
              (let [guard-status (pthread_attr_setguardsize attr (worker-guard-size))]
                (if (!= guard-status (primitive/cast i32 0))
                    (do (pthread_attr_destroy attr) guard-status)
                    (primitive/cast i32 0))))))))

(defn llvm-partition-path [(a (dyn Allocator)) (prefix (ptr i8)) (partition i64)] (-> (ptr i8))
  (str->cstr a (cat3-d a (cstr->slice prefix)
                         (cat3-d a ".part-" (cat3-d a (i64->str a partition) ".o")))))

(defn emit-parallel-o3! [(a (dyn Allocator))
                         (m (ptr i8))
                         (obj-prefix (ptr i8))
                         (triple (ptr i8))
                         (tm (ptr i8))] (-> i64)
  (let [pbo (LLVMCreatePassBuilderOptions)
        inline-span (tr/span-begin "backend.parallel.whole-module-inline")
        inline-error (LLVMRunPasses m c"module-inline" tm pbo)
        _inline-end (tr/span-end inline-span)]
    (LLVMDisposePassBuilderOptions pbo)
    (when (!= (primitive/cast i64 inline-error) 0)
      (ps (stderr) "codegen: LLVM whole-module inline failed: ")
      (ps (stderr) (cstr->slice (LLVMGetErrorMessage inline-error)))
      (wb (stderr) 10)
      (exit 1)
      0)
    (let [jobs (primitive/alloc-stack (array LLVMPartitionJob 8))
          tids (primitive/alloc-stack (array (ptr i8) 8))
          started (primitive/alloc-stack (array i32 8))
          split-span (tr/span-begin "backend.parallel.partition")
          complete-bitcode (LLVMWriteBitcodeToMemoryBuffer m)
          (mut i) 0]
      ; Parse and prune serially, but into a fresh context per partition. The
      ; worker receives exclusive ownership of that context+module pair; no LLVM
      ; object crosses between workers once optimization starts.
      (loop (if (>= (load i) 8)
                (break)
                (let [job (primitive/index jobs (load i))
                      context (LLVMContextCreate)
                      module-out (primitive/alloc-stack (ptr i8))]
                  (store! module-out (primitive/cast (ptr i8) 0))
                  (when (!= (LLVMParseBitcodeInContext2 context complete-bitcode module-out)
                            (primitive/cast i32 0))
                    (ps (stderr) "codegen: could not parse LLVM partition bitcode\n")
                    (exit 1)
                    0)
                  (llvm-prune-partition! (load module-out) (load i))
                  (set! (.context job) context)
                  (set! (.module job) (load module-out))
                  (set! (.path job) (llvm-partition-path a obj-prefix (load i)))
                  (set! (.triple job) triple)
                  (set! (.cpu job) (llvm-cpu triple))
                  (set! (.features job) (llvm-cpu-features triple))
                  (set! (.optlvl job) (primitive/cast i32 3))
                  (set! (.status job) -1)
                  (set! (.error job) (primitive/cast (ptr i8) 0))
                  (set! i (+ (load i) 1)))))
      (LLVMDisposeMemoryBuffer complete-bitcode)
      (tr/span-end split-span)
      (let [workers-span (tr/span-begin "backend.parallel.workers")
            ; LLVM's optimizers recurse deeply on large, heavily-inlined modules.
            ; A null pthread attr gives these codegen threads the host's small
            ; default stack (512 KiB on macOS). Keep their explicit stack separate
            ; from the much larger stack reserved for the compiler pipeline.
            attr (primitive/alloc-stack (array i8 64))
            attr-status (llvm-worker-attr-init! (primitive/cast (ptr i8) attr))]
        (set! i 0)
        (loop (if (>= (load i) 8)
                  (break)
                  (let [rc (if (= attr-status (primitive/cast i32 0))
                                (pthread_create (primitive/cast (ptr i8) (primitive/index tids (load i)))
                                                (primitive/cast (ptr i8) attr)
                                                (primitive/fnptr-of llvm-partition-worker)
                                                (primitive/cast (ptr i8) (primitive/index jobs (load i))))
                                attr-status)]
                    (store! (primitive/index started (load i)) rc)
                    ; Resource exhaustion must not turn into a join of an
                    ; uninitialized handle. Execute that partition inline.
                    (when (!= rc (primitive/cast i32 0))
                      (llvm-partition-worker (primitive/cast (ptr i8) (primitive/index jobs (load i))))
                      0)
                    (set! i (+ (load i) 1)))))
        (when (= attr-status (primitive/cast i32 0))
          (pthread_attr_destroy (primitive/cast (ptr i8) attr))
          0)
        (set! i 0)
        (loop (if (>= (load i) 8)
                  (break)
                  (do
                    (when (= (load (primitive/index started (load i))) (primitive/cast i32 0))
                      (pthread_join (load (primitive/index tids (load i))) (primitive/cast (ptr i8) 0))
                      0)
                    (set! i (+ (load i) 1)))))
        (tr/span-end workers-span))
      (set! i 0)
      (loop (if (>= (load i) 8)
                (break)
                (let [job (primitive/index jobs (load i))]
                  (when (!= (.status job) (primitive/cast i32 0))
                    (ps (stderr) "codegen: LLVM partition ")
                    (dump-dec (stderr) (load i))
                    (ps (stderr) " failed")
                    (when (!= (primitive/cast i64 (.error job)) 0)
                      (ps (stderr) ": ")
                      (ps (stderr) (cstr->slice (.error job)))
                      (if (= (.status job) (primitive/cast i32 3))
                          (LLVMDisposeErrorMessage (.error job))
                          (LLVMDisposeMessage (.error job)))
                      0)
                    (wb (stderr) 10)
                    (let [(mut cleanup-index) 0]
                      (loop (if (>= (load cleanup-index) 8)
                                (break)
                                (do
                                  (ffi/unlink (.path (primitive/index jobs (load cleanup-index))))
                                  (set! cleanup-index (+ (load cleanup-index) 1))))))
                    (exit 1)
                    0)
                  (set! i (+ (load i) 1)))))
      8)))

(defn llvm-function-count [(m (ptr i8))] (-> i64)
  (let [(mut count) 0
        (mut fn) (LLVMGetFirstFunction m)]
    (loop (if (= (primitive/cast i64 (load fn)) 0)
              (break)
              (do
                (when (= (LLVMIsDeclaration (load fn)) (primitive/cast i32 0))
                  (set! count (+ (load count) 1))
                  0)
                (set! fn (LLVMGetNextFunction (load fn))))))
    (load count)))

; mono'd Program -> native object file. Mirrors
; (the release/`src_path = None` path): build the module (codegen-module already
; sets target + datalayout), create a host target machine (cpu "generic", no
; features, reloc PIC=2, codemodel Default=0) at CodeGenOptLevel `optlvl`, run the
; matching `default<On>` pipeline through the new pass manager, then EmitToFile.
; `optlvl` is passed in rather than read from the global because the PROGRAM object
; and the METAPROGRAM object can be built at different levels (-O vs --meta-opt=).
(defn build-object [(a (dyn Allocator))
                    (mp (ptr Program))
                    (obj-cstr (ptr i8))
                    (triple-override (ptr i8))
                    (sanitize i64)
                    (optlvl i64)
                    (allow-multiple bool)] (-> i64)
  (let [lower-span (tr/span-begin "backend.llvm-lower")
        m (codegen-module a mp triple-override sanitize (debug-checks?))
        _lower-end (tr/span-end lower-span)
        triple
          (if (!= (primitive/cast i64 triple-override) (primitive/cast i64 0))
              triple-override
              (LLVMGetDefaultTargetTriple))
        targetout (primitive/alloc-stack (ptr i8))
        errout (primitive/alloc-stack (ptr i8))]
    (verify-module! m "after lowering")
    (do
          ; AsmPrinter init (targets themselves were initialized inside codegen-module).
          (LLVMInitializeAArch64AsmPrinter)
          (LLVMInitializeX86AsmPrinter)
          (LLVMInitializeRISCVAsmPrinter)
          (LLVMInitializeWebAssemblyAsmPrinter)
          ; AsmParser init: `:lower shim` conventions emit inline asm, which LLVM cannot
          ; stream without a parser for the target — it hard-errors and aborts the process.
          (LLVMInitializeAArch64AsmParser)
          (LLVMInitializeX86AsmParser)
          (LLVMInitializeRISCVAsmParser)
          ; see codegen-module: the status and errout are load-bearing, not decoration.
          (when (!= (LLVMGetTargetFromTriple triple targetout errout) (primitive/cast i32 0))
            (let [w (stderr)]
              (ps w "error: unsupported --target '")
              (ps w (cstr->slice triple))
              (ps w "': ")
              (ps w (cstr->slice (load errout)))
              (wb w 10)
              (exit 1)
              0))
          (let [tm
                  (LLVMCreateTargetMachine (load targetout)
                                           triple
                                           (llvm-cpu triple)
                                           (llvm-cpu-features triple)
                                           (primitive/cast i32 optlvl)
                                           (llvm-reloc-model triple)
                                           0)
                parallel (and allow-multiple
                              (and (= sanitize 0)
                                   (and (= optlvl 3)
                                        (and (= (primitive/cast i64 triple-override) 0)
                                             (>= (llvm-function-count m)
                                                 (ffi-decimal-env c"COIL_PARALLEL_CODEGEN_MIN_FUNCTIONS" 256))))))
                pbo (LLVMCreatePassBuilderOptions)
                ; --sanitize=address (mem-7): append LLVM's AddressSanitizer module pass to
                ; the O3 pipeline so the emitted object is instrumented. Only the PROGRAM
                ; object takes this path — the metaprogram dylib passes sanitize=false, so
                ; the compiler never dlopen's an ASan-instrumented object.
                optimize-span (tr/span-begin "backend.llvm-optimize")
                rp (if parallel
                       (primitive/cast (ptr i8) 0)
                       (LLVMRunPasses m (opt-pipeline sanitize optlvl) tm pbo))
                _optimize-end (tr/span-end optimize-span)]
            (when (not (= (primitive/cast i64 rp) (primitive/cast i64 0)))
              (ps (stderr) "codegen: LLVMRunPasses failed: ")
              (ps (stderr) (cstr->slice (LLVMGetErrorMessage rp)))
              (wb (stderr) 10)
              (abort)
              0)
            (verify-module! m "after optimization")
            (if parallel
                (emit-parallel-o3! a m obj-cstr triple tm)
                (do
                  (let [emiterr (primitive/alloc-stack (ptr i8))
                  tmp-s (sconcat a (cstr->slice obj-cstr) ".tmp")
                  tmp-cstr (str->cstr a tmp-s)]
              ; LLVM opens with truncation, so never point it at the user's final path.
              ; A stale temp from an interrupted prior invocation is safe to discard.
              (ffi/unlink tmp-cstr)
              (let [emit-span (tr/span-begin "backend.object-emit")
                    rc (LLVMTargetMachineEmitToFile tm m tmp-cstr 1 emiterr)
                    _emit-end (tr/span-end emit-span)]
                ; A non-writable object destination (e.g. a read-only dir, or `-o /dev/null`
                ; whose `.o` lands in unwritable `/dev`) used to SIGABRT here with a bare
                ; `Operation not permitted`, naming neither the path nor a remedy. Report a clear
                ; located error and exit 1 — a usage mistake, not a compiler panic. `-o /dev/null`
                ; itself is intercepted earlier and routed to `check` (diag-12).
                (when (!= rc (primitive/cast i32 0))
                  (let [w (stderr)]
                    (ps w "error: could not write object file '")
                    (ps w (cstr->slice obj-cstr))
                    (ps w "': ")
                    (ps w (cstr->slice (load emiterr)))
                    (wb w 10)
                    (ps w
                        "  the output path is not writable — give `-o` a writable path, or use `coil check <file>` to typecheck without emitting an object\n")
                    (ffi/unlink tmp-cstr)
                    (exit 1)
                    0))
                (when (!= (me/rename tmp-cstr obj-cstr) (primitive/cast i32 0))
                  (let [w (stderr)]
                    (ps w "error: could not finalize object file '")
                    (ps w (cstr->slice obj-cstr))
                    (ps w "'\n")
                    (ffi/unlink tmp-cstr)
                    (exit 1)
                    0))))
                  1))))))

; Returns 1 if the pipeline succeeded (object emitted), 0 if a diagnostic was
; reported. build-cmd checks this and HALTS before linking on failure (mirroring
; the object build fails before `cc` is ever invoked).
(defn build-ir-program [(a (dyn Allocator))
                        (src (slice u8))
                        (cwd (slice u8))
                        (obj-cstr (ptr i8))
                        (triple (ptr i8))
                        (path (slice u8))] (-> i64)
  (let [w (stderr)
        (mut sp0) (al-new [(slice u8)] a)
        (mut st0) (al-new [(slice u8)] a)]
    (match (run-pipeline a src cwd w path (mut sp0) (mut st0))
      (Some [mp] (build-object a mp obj-cstr triple (sanitize-mode) (opt-level) (parallel-codegen?)))
      (None [] 0))))

; `__normalize` debug subcommand: print normalized textual LLVM IR of `src`.
(defn do-normalize [(a (dyn Allocator)) (src (slice u8))] (-> i64)
  (let [w (stdout)] (ps w (normalize-ir a src)) 0))

; Inject the LLVM backend entry points into the shared driver as function pointers.
; default-backend = 1 (LLVM) — a bare `build` uses the LLVM backend, `--backend arm64`
; switches to the native backend.
(defn do-cimport [(a (dyn Allocator)) (argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (ci/cimport-cli a argc argv 2))

; the compiled-metaprogram engine's object builder (metaengine.coil): a mono'd
; metaprogram Program -> object file, via the LLVM backend (host triple).
(defn meta-build-obj-llvm [(a (dyn Allocator)) (mp (ptr Program)) (obj (ptr i8))] (-> i64)
  ; NEVER sanitize the metaprogram dylib: it is dlopen'd into the compiler, and an
  ; ASan-instrumented dylib loaded that late aborts the process (mem-7).
  (do (build-object a mp obj (primitive/cast (ptr i8) 0) 0 (meta-opt-level) false) 0))

; The comptime object, handed back IN MEMORY so comptime_eval can load it straight
; into executable pages (jit.coil) instead of forking `cc -dynamiclib` per site.
;
; This uses the ARM64 backend even in the LLVM build, for two reasons. A comptime
; thunk always runs in THIS process on THIS machine, and the self-host always lowers
; for the arm64 host regardless of --target, so host code is arm64 either way.
; And the readback (comptime_eval.coil::cte-ty-size) walks the natural C layout that
; codegen_a64's g-natural-layout! emits — so building the object with the arm64
; backend puts the writer and the reader on the same layout, which the LLVM path
; was not guaranteed to be (see the type-bytes / g-type-bytes divergence in
; docs/archive/INTERP_DELETION.md).
(defn meta-build-mobj-llvm [(a (dyn Allocator)) (mp (ptr Program))] (-> MObj)
  (cga64-build-mobj a
                    mp
                    ""
                    ""
                    (box-al [(slice u8)] a (al-new [(slice u8)] a))
                    (box-al [(slice u8)] a (al-new [(slice u8)] a))
                    false))

; The in-memory fast path JITs machine code straight into this process, so the
; builder registered has to match the host: an arm64 host gets the MObj/Mach-O pair
; above, an x86-64 host the EObj/ELF pair below. A host that is neither keeps
; comptime_eval's dylib route.
;
; The x86-64 sibling of meta-build-mobj-llvm. Same reasoning applies: a comptime
; thunk runs in THIS process on THIS machine, and comptime_eval's readback walks the
; natural C layout the native backends emit, so building the in-memory object with
; codegen_x64 puts the writer and the reader on the same layout. This backend is
; already linked into the LLVM build (driver.coil imports cgx64 for `--backend x64`),
; so registering it here costs no new dependency.
(defn meta-build-eobj-llvm [(a (dyn Allocator)) (mp (ptr Program))] (-> EObj)
  (cgx64-build-eobj a
                    mp
                    ""
                    ""
                    (box-al [(slice u8)] a (al-new [(slice u8)] a))
                    (box-al [(slice u8)] a (al-new [(slice u8)] a))
                    false))

(defn host-arm64? [] (-> bool)
  (match (str-find (cstr->slice (LLVMGetDefaultTargetTriple)) "aarch64")
    (Some [i0] true)
    (None []
          (match (str-find (cstr->slice (LLVMGetDefaultTargetTriple)) "arm64")
            (Some [i1] true)
            (None [] false)))))

(defn host-x86-64? [] (-> bool)
  (match (str-find (cstr->slice (LLVMGetDefaultTargetTriple)) "x86_64")
    (Some [i0] true)
    (None [] false)))

; The compiler spawns the linker driver directly (spawn-wait -> os/spawn), and
; posix_spawn takes the child environment EXPLICITLY: whatever `os/spawn-envp`
; returns is all the child gets. Nothing published one, so it returned NULL and
; every linker child ran with an EMPTY environment.
;
; Apple's /usr/bin/cc locates `ld` without consulting PATH, so ordinary builds
; never noticed. The sanitizer path uses the clang beside the LLVM that inserted
; the pass -- Homebrew's -- and that one finds `ld` ON PATH, so `--sanitize=...`
; died as `clang: error: unable to execute command: posix_spawn failed: No such
; file or directory`, which names neither the environment nor the linker.
;
; coil.os says main's third C argument is the portable way to get it and that
; whoever owns `main` publishes it once. This is that owner.
(defn main [(argc i32) (argv (ptr (ptr i8))) (envp (ptr (ptr i8)))] (-> i64)
  (os/publish-envp! envp)  ; the linker child inherits this; see above
  (set-meta-build-obj! (primitive/fnptr-of meta-build-obj-llvm))
  ; Register the in-memory object builder this host can actually execute, and make
  ; it the default: metaprograms then go straight into memory instead of through
  ; `cc -dynamiclib` + dlopen + the on-disk cache. A host that is neither arm64 nor
  ; x86-64 registers neither and keeps the dylib route.
  (if (host-arm64?)
      (do (set-meta-build-mobj! (primitive/fnptr-of meta-build-mobj-llvm))
          (meta-jit-default-on!))
      (when (host-x86-64?)
        (set-meta-build-eobj! (primitive/fnptr-of meta-build-eobj-llvm))
        (meta-jit-default-on!)
        0))
  (register-comptime-fold!)  ; route comptime/const sites the interpreter can't fold through the compiled engine (mac-8)
  (driver-main argc
               argv
               (primitive/fnptr-of build-ir-program)
               (primitive/fnptr-of dump-ir-program)
               (primitive/fnptr-of do-normalize)
               (primitive/fnptr-of do-cimport)
               (primitive/fnptr-of public-jit/jit-repl-main)
               1))
