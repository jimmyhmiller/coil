(module coil.compiler.vector_ops)
(import "coil.compiler.ast" :use *)
(import "coil.str" :use *)

;;; Stable source opcode spelling, shared by diagnostics and reflection.
(defn vector-op-name [(op VectorOp)] (-> (slice u8))
  (match op
    (VectorScanAdd [] "vector-scan-add")
    (VectorScanXor [] "vector-scan-xor")
    (VectorScanOr [] "vector-scan-or")
    (VectorScanMax [] "vector-scan-max")
    (VectorZero [] "vector-zero")
    (VectorWidenLow [] "vector-widen-low")
    (VectorWidenHigh [] "vector-widen-high")
    (VectorNarrow [] "vector-narrow")
    (VectorNarrowSat [] "vector-narrow-saturating")
    (VectorCompress [] "vector-compress")
    (VectorCompressStore [] "vector-compress-store")
    (VectorExpandLoad [] "vector-expand-load")
    (VectorIota [] "vector-iota")
    (VectorMaskLow [] "vector-mask-low")
    (VectorSplat [] "vector-splat")
    (VectorExtract [] "vector-extract")
    (VectorInsert [] "vector-insert")
    (VectorLanes [] "vector-lanes")
    (VectorLoad [] "vector-load")
    (VectorStore [] "vector-store")
    (VectorLoadAligned [] "vector-load-aligned")
    (VectorStoreAligned [] "vector-store-aligned")
    (VectorAdd [] "vector-add")
    (VectorSub [] "vector-sub")
    (VectorMul [] "vector-mul")
    (VectorDiv [] "vector-div")
    (VectorAnd [] "vector-and")
    (VectorOr [] "vector-or")
    (VectorXor [] "vector-xor")
    (VectorNot [] "vector-not")
    (VectorShl [] "vector-shl")
    (VectorShr [] "vector-shr")
    (VectorAShr [] "vector-ashr")
    (VectorEq [] "vector-eq")
    (VectorNe [] "vector-ne")
    (VectorLt [] "vector-lt")
    (VectorLe [] "vector-le")
    (VectorGt [] "vector-gt")
    (VectorGe [] "vector-ge")
    (VectorSelect [] "vector-select")
    (VectorMaskBits [] "vector-mask-bits")
    (VectorBitsMask [] "vector-bits-mask")
    (VectorBitcast [] "vector-bitcast")
    (VectorConvert [] "vector-convert")
    (VectorShuffle [] "vector-shuffle")
    (VectorTable [] "vector-table")
    (VectorReduceAdd [] "vector-reduce-add")
    (VectorReduceOr [] "vector-reduce-or")
    (VectorReduceAnd [] "vector-reduce-and")
    (VectorReduceXor [] "vector-reduce-xor")
    (VectorReduceMin [] "vector-reduce-min")
    (VectorReduceMax [] "vector-reduce-max")
    (VectorPopcount [] "vector-popcount")
    (VectorClz [] "vector-clz")
    (VectorCtz [] "vector-ctz")
    (VectorBswap [] "vector-bswap")
    (VectorBitReverse [] "vector-bit-reverse")
    (VectorAddSat [] "vector-add-saturating")
    (VectorSubSat [] "vector-sub-saturating")
    (VectorMin [] "vector-min")
    (VectorMax [] "vector-max")
    (VectorAbs [] "vector-abs")
    (VectorNeg [] "vector-neg")
    (VectorRotl [] "vector-rotate-left")
    (VectorRotr [] "vector-rotate-right")
    (VectorMaskedLoad [] "vector-load-masked")
    (VectorMaskedStore [] "vector-store-masked")
    (VectorGather [] "vector-gather")
    (VectorScatter [] "vector-scatter")
    (VectorFma [] "vector-fma")
    (VectorSqrt [] "vector-sqrt")
    (VectorFloor [] "vector-floor")
    (VectorCeil [] "vector-ceil")
    (VectorTrunc [] "vector-trunc")
    (VectorRound [] "vector-round")
    (VectorIsNan [] "vector-is-nan")
    (VectorIsFinite [] "vector-is-finite")))

;;; Only called after the parser has resolved an ordinary primitive binding.
(defn vector-op-from-name [(name (slice u8))] (-> (Option VectorOp))
  (cond
    (= name "vector-zero") (Some (VectorZero))
    (= name "vector-widen-low") (Some (VectorWidenLow))
    (= name "vector-widen-high") (Some (VectorWidenHigh))
    (= name "vector-narrow") (Some (VectorNarrow))
    (= name "vector-narrow-saturating") (Some (VectorNarrowSat))
    (= name "vector-compress") (Some (VectorCompress))
    (= name "vector-compress-store") (Some (VectorCompressStore))
    (= name "vector-expand-load") (Some (VectorExpandLoad))
    (= name "vector-scan-add") (Some (VectorScanAdd))
    (= name "vector-scan-xor") (Some (VectorScanXor))
    (= name "vector-scan-or") (Some (VectorScanOr))
    (= name "vector-scan-max") (Some (VectorScanMax))
    (= name "vector-iota") (Some (VectorIota))
    (= name "vector-mask-low") (Some (VectorMaskLow))
    (= name "vector-splat") (Some (VectorSplat))
    (= name "vector-extract") (Some (VectorExtract))
    (= name "vector-insert") (Some (VectorInsert))
    (= name "vector-lanes") (Some (VectorLanes))
    (= name "vector-load") (Some (VectorLoad))
    (= name "vector-store") (Some (VectorStore))
    (= name "vector-load-aligned") (Some (VectorLoadAligned))
    (= name "vector-store-aligned") (Some (VectorStoreAligned))
    (= name "vector-add") (Some (VectorAdd))
    (= name "vector-sub") (Some (VectorSub))
    (= name "vector-mul") (Some (VectorMul))
    (= name "vector-div") (Some (VectorDiv))
    (= name "vector-and") (Some (VectorAnd))
    (= name "vector-or") (Some (VectorOr))
    (= name "vector-xor") (Some (VectorXor))
    (= name "vector-not") (Some (VectorNot))
    (= name "vector-shl") (Some (VectorShl))
    (= name "vector-shr") (Some (VectorShr))
    (= name "vector-ashr") (Some (VectorAShr))
    (= name "vector-eq") (Some (VectorEq))
    (= name "vector-ne") (Some (VectorNe))
    (= name "vector-lt") (Some (VectorLt))
    (= name "vector-le") (Some (VectorLe))
    (= name "vector-gt") (Some (VectorGt))
    (= name "vector-ge") (Some (VectorGe))
    (= name "vector-select") (Some (VectorSelect))
    (= name "vector-mask-bits") (Some (VectorMaskBits))
    (= name "vector-bits-mask") (Some (VectorBitsMask))
    (= name "vector-bitcast") (Some (VectorBitcast))
    (= name "vector-convert") (Some (VectorConvert))
    (= name "vector-shuffle") (Some (VectorShuffle))
    (= name "vector-table") (Some (VectorTable))
    (= name "vector-reduce-add") (Some (VectorReduceAdd))
    (= name "vector-reduce-or") (Some (VectorReduceOr))
    (= name "vector-reduce-and") (Some (VectorReduceAnd))
    (= name "vector-reduce-xor") (Some (VectorReduceXor))
    (= name "vector-reduce-min") (Some (VectorReduceMin))
    (= name "vector-reduce-max") (Some (VectorReduceMax))
    (= name "vector-popcount") (Some (VectorPopcount))
    (= name "vector-clz") (Some (VectorClz))
    (= name "vector-ctz") (Some (VectorCtz))
    (= name "vector-bswap") (Some (VectorBswap))
    (= name "vector-bit-reverse") (Some (VectorBitReverse))
    (= name "vector-add-saturating") (Some (VectorAddSat))
    (= name "vector-sub-saturating") (Some (VectorSubSat))
    (= name "vector-min") (Some (VectorMin))
    (= name "vector-max") (Some (VectorMax))
    (= name "vector-abs") (Some (VectorAbs))
    (= name "vector-neg") (Some (VectorNeg))
    (= name "vector-rotate-left") (Some (VectorRotl))
    (= name "vector-rotate-right") (Some (VectorRotr))
    (= name "vector-load-masked") (Some (VectorMaskedLoad))
    (= name "vector-store-masked") (Some (VectorMaskedStore))
    (= name "vector-gather") (Some (VectorGather))
    (= name "vector-scatter") (Some (VectorScatter))
    (= name "vector-fma") (Some (VectorFma))
    (= name "vector-sqrt") (Some (VectorSqrt))
    (= name "vector-floor") (Some (VectorFloor))
    (= name "vector-ceil") (Some (VectorCeil))
    (= name "vector-trunc") (Some (VectorTrunc))
    (= name "vector-round") (Some (VectorRound))
    (= name "vector-is-nan") (Some (VectorIsNan))
    (= name "vector-is-finite") (Some (VectorIsFinite))
    :else (None [VectorOp])))
