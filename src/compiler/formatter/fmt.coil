; src/compiler/formatter/fmt.coil — the Coil formatter CLI.
;
;   coil run src/compiler/formatter/fmt.coil -- <file.coil>            print the formatted source
;   coil run src/compiler/formatter/fmt.coil -- --check <file.coil>    exit 1 if not already formatted
;   coil run src/compiler/formatter/fmt.coil -- --write <file.coil>    reformat the file in place
;
; Prettier-style layout at width 120, Clojure indentation conventions. Comments,
; blank lines, and every atom/string are preserved verbatim; only whitespace and
; line breaks change.
(module app)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "cst" :use *)
(import "doc" :use *)
(import "rules" :use *)

(extern open :cc c [(ptr i8) i32 ...] (-> i32))
(extern close :cc c [i32] (-> i32))
(extern fopen :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern fwrite :cc c [(ptr i8) i64 i64 (ptr i8)] (-> i64))
(extern fclose :cc c [(ptr i8)] (-> i32))

(defn read-file [(a (dyn Allocator)) (path (ptr i8))] (-> (slice u8))
  (let [fd (open path 0)
        buf (primitive/cast (ptr i8) (slice-data [u8] (match (alloc-bytes a 65536 1) (Some [s] s) (None [] (do (oom-at c"compiler formatter" 65536) (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))))))
        (mut bytes) (al-new [u8] a)]
    (loop (let [n (read fd buf 65536)]
            (if (<= n (primitive/cast i64 0))
                (break)
                (let [(mut i) 0]
                  (loop (if (>= (load i) n)
                            (break)
                            (do
                              (al-push! (mut bytes) (primitive/cast u8 (load (primitive/index buf (load i)))))
                              (store! i (primitive/iadd (load i) 1)))))))))
    (close fd)
    (al-slice [u8] (load bytes))))

(defn s->cstr [(a (dyn Allocator)) (s (slice u8))] (-> (ptr i8))
  (let [n (slice-len s)
        buf (primitive/cast (ptr i8) (slice-data [u8] (match (alloc-bytes a (primitive/iadd n 1) 1) (Some [s] s) (None [] (do (oom-at c"compiler formatter" (primitive/iadd n 1)) (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0))))))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (store! (primitive/index buf (load i)) (primitive/cast i8 (slice-get s (load i))))
                (store! i
                        (primitive/iadd (load i) 1)))))
    (store! (primitive/index buf n) (primitive/cast i8 0))
    buf))

(defn cstr->slice [(p (ptr i8))] (-> (slice u8))
  (let [(mut n) 0]
    (loop (if (= (primitive/cast i64 (load (primitive/index p (load n)))) (primitive/cast i64 0))
              (break)
              (store! n
                      (primitive/iadd (load n) 1))))
    (slice-new [u8] (primitive/cast (ptr u8) p) (load n))))

; overwrite `path` (truncating) with `data`; returns 0, or -1 on open failure.
(defn write-file [(a (dyn Allocator)) (path (ptr i8)) (data (slice u8))] (-> i64)
  (let [f (fopen path (s->cstr a "w"))]
    (if (= (primitive/cast i64 f) (primitive/cast i64 0))
        -1
        (do
          (fwrite (primitive/cast (ptr i8) (slice-data data)) 1 (slice-len data) f)
          (fclose f)
          0))))

(defn format-src [(a (dyn Allocator)) (src (slice u8)) (width i64)] (-> (slice u8))
  (render-doc a (doc->doc a (read-doc a src)) width))

; NOTE: io.coil's (stdout)/(stderr) share ONE static Writer, so we must never
; hold both live — fetch the one we need right before writing to it.
(defn main [(argc :i32) (argv (ptr (ptr i8)))] (-> :i64)
  (let [a (malloc-allocator)
        n (primitive/cast i64 argc)]
    (if (< n (primitive/cast i64 2))
        (do (print-str (stderr) "usage: fmt [--check|--write] <file.coil>\n") 1)
        (let [arg1 (cstr->slice (load (primitive/index argv 1)))
              check (= arg1 "--check")
              write (= arg1 "--write")]
          (if (and (or check write) (< n (primitive/cast i64 3)))
              (do (print-str (stderr) "usage: fmt [--check|--write] <file.coil>\n") 1)
              (let [path (if (or check write) (load (primitive/index argv 2)) (load (primitive/index argv 1)))
                    src (read-file a path)
                    out (format-src a src 120)
                    same (= src out)]
                (if check
                    (if same
                        0
                        (do
                          (print-str (stderr) "not formatted: ")
                          (print-cstr (stderr) path)
                          (print-str (stderr) "\n")
                          1))
                    (if write
                        (if same 0 (do (write-file a path out) 0))
                        (do (print-str (stdout) out) 0)))))))))
