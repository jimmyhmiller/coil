; src/compiler/formatter/cst.coil — Concrete Syntax Tree for the Coil formatter.
;
; A byte-level recursive reader that, unlike the compiler's reader, preserves the
; things a formatter must never lose: comments (as first-class nodes, so they keep
; their position in a form), blank lines (an nl-before count on every node), and
; the verbatim text of every atom/string (we never reformat a number or string's
; insides). Delimiters (), [] are kept distinct. Prefix reader macros ' ` ~ ~@ are
; nodes that wrap their target so they print glued to it.
(module cst)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)

; ---- node model ------------------------------------------------------------
; NAtom    — any verbatim token: int, float, symbol, keyword, "string", c"cstr".
; NList    — open is the delimiter byte: 40 '(' or 91 '['. items are children in
;            source order (comments interleaved).
; NComment — a "; ..." line, verbatim (trailing spaces trimmed, no newline).
; NPrefix  — a reader-macro glyph glued to the form it wraps.
(defsum NodeKind
  (NAtom [(raw (slice u8))])
  (NList [(open i64) (items (ptr (ArrayList (ptr Node))))])
  (NComment [(raw (slice u8))])
  (NPrefix [(op (slice u8)) (inner (ptr Node))]))

; nl-before: count of newlines between the previous token and this node's start.
;   0   => same line as the previous node
;   1   => next line
;   >=2 => blank line(s) before it (we later preserve exactly one)
(defstruct Node [(kind NodeKind) (nl-before i64)])

(defn box-node [(a (ptr Allocator)) (k NodeKind) (nl i64)] (-> (ptr Node))
  (let [p (unwrap-ptr [Node] (create [Node] a))]
    (store! (field p kind) k)
    (store! (field p nl-before) nl)
    p))

; ---- reader cursor ---------------------------------------------------------
(defstruct Rdr [(src (slice u8)) (pos i64) (a (ptr Allocator))])

(defn r-end? [(r (ptr Rdr))] (-> bool)
  (>= (load (field r pos)) (slice-len (load (field r src)))))
(defn r-peek [(r (ptr Rdr))] (-> i64)
  (if (r-end? r)
      -1
      (primitive/cast i64
                      (slice-get (load (field r src))
                                 (load (field r
                                              pos))))))
(defn r-peek2 [(r (ptr Rdr))] (-> i64)
  (let [p (primitive/iadd (load (field r pos)) 1)]
    (if (>= p (slice-len (load (field r src))))
        -1
        (primitive/cast i64 (slice-get (load (field r src)) p)))))
(defn r-adv [(r (ptr Rdr))] (-> i64)
  (store! (field r pos) (primitive/iadd (load (field r pos)) 1))
  0)

; ---- character classes -----------------------------------------------------
(defn is-ws [(c i64)] (-> bool)
  (or (= c (primitive/cast i64 32))
      (or (= c (primitive/cast i64 9))
          (or (= c (primitive/cast i64 10))
              (or (= c (primitive/cast i64 13)) (or (= c (primitive/cast i64 11)) (= c (primitive/cast i64 12))))))))

; INVARIANT: this set and `is-ws` above MUST agree with coil.reader's `tokenize`
; ( `(` `)` `[` `]` `;` `"` `'` backtick `~`, and ws 32/9/10/13/11/12 ). They are
; separate on purpose — a CST captures atoms VERBATIM and never decodes, so it has
; no escape table and cannot reuse `read-string-body` — but if the two ever disagree
; on where a token ENDS, `coil fmt` and `coil lint --fix` will rewrite source into
; something the compiler reads differently. Change one, change the other.
;
; (Only escape VALIDATION differs, harmlessly: the reader rejects `"\q"`, this scanner
; passes it through untouched. Both end the literal at the same byte, which is all
; that affects output.)
;
; a byte that ends an atom run: whitespace, any delimiter, comment, string, or a
; reader-macro glyph, or EOF.
(defn is-atom-delim [(c i64)] (-> bool)
  (if (or (= c (primitive/cast i64 -1)) (is-ws c))
      true
      (or (= c (primitive/cast i64 40))
          (or (= c (primitive/cast i64 41))
              (or (= c (primitive/cast i64 91))
                  (or (= c (primitive/cast i64 93))
                      (or (= c (primitive/cast i64 59))
                          (or (= c (primitive/cast i64 34))
                              (or (= c (primitive/cast i64 39))
                                  (or (= c (primitive/cast i64 96)) (= c (primitive/cast i64 126))))))))))))

; ---- whitespace ------------------------------------------------------------
; skip spaces/tabs/newlines (NOT comments — those are nodes); return newline count.
(defn skip-ws [(r (ptr Rdr))] (-> i64)
  (let [(mut nl) 0]
    (loop (let [c (r-peek r)]
            (if (is-ws c)
                (do (when (= c (primitive/cast i64 10)) (store! nl (primitive/iadd (load nl) 1))) (r-adv r))
                (break))))
    (load nl)))

; trim trailing spaces/tabs off a slice (used for comment text)
(defn trim-trailing [(s (slice u8))] (-> (slice u8))
  (let [(mut n) (slice-len s)]
    (loop (if (<= (load n) (primitive/cast i64 0))
              (break)
              (let [c (primitive/cast i64 (slice-get s (primitive/isub (load n) 1)))]
                (if (or (= c (primitive/cast i64 32)) (= c (primitive/cast i64 9)))
                    (store! n (primitive/isub (load n) 1))
                    (break)))))
    (subslice s 0 (load n))))

; ---- token readers ---------------------------------------------------------
; a "; ..." comment, verbatim to end of line (newline not consumed).
(defn read-comment [(r (ptr Rdr))] (-> (slice u8))
  (let [start (load (field r pos))]
    (loop (let [c (r-peek r)]
            (if (or (= c (primitive/cast i64 -1)) (= c (primitive/cast i64 10))) (break) (r-adv r))))
    (trim-trailing (subslice (load (field r src)) start (load (field r pos))))))

; a "..."/c"..." string literal, verbatim INCLUDING the quotes (and any leading c).
(defn read-string [(r (ptr Rdr)) (start i64)] (-> (slice u8))
  (r-adv r)  ; consume opening quote
  (loop (let [c (r-peek r)]
          (if (= c (primitive/cast i64 -1))
              (break)
              (do
                (r-adv r)
                (if (= c (primitive/cast i64 92))  ; backslash: skip escaped char
                    (when (!= (r-peek r) (primitive/cast i64 -1)) (r-adv r))
                    (when (= c (primitive/cast i64 34)) (break)))))))  ; closing quote
  (subslice (load (field r src)) start (load (field r pos))))

; a run of non-delimiter bytes; folds the c"..." case (a lone `c` before a quote).
(defn read-atom [(r (ptr Rdr))] (-> (slice u8))
  (let [start (load (field r pos))]
    (loop (if (is-atom-delim (r-peek r)) (break) (r-adv r)))
    (let [end (load (field r pos))]
      (if (and (= (primitive/isub end start) (primitive/cast i64 1))
               (and (= (primitive/cast i64 (slice-get (load (field r src)) start)) (primitive/cast i64 99))
                    (= (r-peek r) (primitive/cast i64 34))))
          (read-string r start)  ; c"..." — extend over the string
          (subslice (load (field r src)) start end)))))

; A legacy `\c` or canonical `#\c` character literal, captured verbatim.
(defn cl-alpha [(c i64)] (-> bool)
  (or (and (>= c (primitive/cast i64 97)) (<= c (primitive/cast i64 122)))
      (and (>= c (primitive/cast i64 65)) (<= c (primitive/cast i64 90)))))
(defn cl-alnum [(c i64)] (-> bool)
  (or (cl-alpha c) (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57)))))
(defn read-char-lit [(r (ptr Rdr))] (-> (slice u8))
  (let [start (load (field r pos))]
    (when (= (r-peek r) (primitive/cast i64 35)) (r-adv r) 0)
    (r-adv r)  ; consume backslash
    (when (!= (r-peek r) (primitive/cast i64 -1))
      (let [first (r-peek r)]
        (r-adv r)  ; consume the char after backslash
        (when (cl-alpha first) (loop (if (cl-alnum (r-peek r)) (r-adv r) (break))) 0)))
    (subslice (load (field r src)) start (load (field r pos)))))

; ---- node reader -----------------------------------------------------------
; Read one node. Returns a null (ptr Node) at EOF or when the next byte is a close
; delimiter (the caller consumes the close). nl-before is stamped from the run of
; whitespace skipped just before the node.
(defn read-node [(r (ptr Rdr))] (-> (ptr Node))
  (let [nl (skip-ws r)
        c (r-peek r)
        a (load (field r a))]
    (cond (= c (primitive/cast i64 -1)) (primitive/cast (ptr Node) 0)
          (or (= c (primitive/cast i64 41)) (= c (primitive/cast i64 93))) (primitive/cast (ptr Node) 0)
          ; close delim
          (= c (primitive/cast i64 59)) (box-node a (NComment (read-comment r)) nl)
          (or (= c (primitive/cast i64 40)) (= c (primitive/cast i64 91))) (box-node a (read-list r c) nl)
          (or (= c (primitive/cast i64 39)) (or (= c (primitive/cast i64 96)) (= c (primitive/cast i64 126))))
            (box-node a (read-prefix r c) nl)
          (= c (primitive/cast i64 34)) (box-node a (NAtom (read-string r (load (field r pos)))) nl)
          (and (= c (primitive/cast i64 35)) (= (r-peek2 r) (primitive/cast i64 92)))
            (box-node a (NAtom (read-char-lit r)) nl)
          (= c (primitive/cast i64 92)) (box-node a (NAtom (read-char-lit r)) nl)
          :else (box-node a (NAtom (read-atom r)) nl))))

(defn read-prefix [(r (ptr Rdr)) (c i64)] (-> NodeKind)
  (let [a (load (field r a))]
    (r-adv r)
    (let [op
            (cond (= c (primitive/cast i64 39)) "'"
                  (= c (primitive/cast i64 96)) "`"
                  (and (= c (primitive/cast i64 126)) (= (r-peek r) (primitive/cast i64 64))) (do (r-adv r) "~@")
                  :else "~")
          inner (read-node r)]
      (NPrefix op
               (if (= (primitive/cast i64 inner) (primitive/cast i64 0))
                   (box-node a (NAtom "") 0)  ; dangling prefix (best-effort)
                   inner)))))

(defn read-list [(r (ptr Rdr)) (open i64)] (-> NodeKind)
  (let [a (load (field r a))
        close (if (= open (primitive/cast i64 40)) 41 93)
        (mut items) (al-new [(ptr Node)] a)]
    (r-adv r)  ; consume open
    (loop (let [child (read-node r)]
            (if (!= (primitive/cast i64 child) (primitive/cast i64 0))
                (al-push! (mut items) child)
                (let [c (r-peek r)]
                  (if (= c close)
                      (do (r-adv r) (break))
                      (if (= c (primitive/cast i64 -1))
                          (break)  ; unterminated — tolerate
                          (do (r-adv r) (break))))))))  ; mismatched — tolerate
    (NList open
           (let [p
                   (unwrap-ptr [(ArrayList (ptr Node))]
                               (create [(ArrayList (ptr Node))] a))]
             (store! p (load items))
             p))))

; ---- entry point -----------------------------------------------------------
; Parse the whole source into a top-level list of nodes (forms + comments), in
; order, each carrying nl-before.
(defn read-doc [(a (ptr Allocator)) (src (slice u8))] (-> (ptr (ArrayList (ptr Node))))
  (let [r (alloc/stack Rdr)
        (mut forms) (al-new [(ptr Node)] a)]
    (store! (field r src) src)
    (store! (field r pos) 0)
    (store! (field r
                   a)
            a)
    (loop (let [f (read-node r)]
            (if (!= (primitive/cast i64 f) (primitive/cast i64 0))
                (al-push! (mut forms) f)
                (if (= (r-peek r) (primitive/cast i64 -1))
                    (break)
                    (r-adv r)))))  ; skip stray close delim
    (let [p (unwrap-ptr [(ArrayList (ptr Node))] (create [(ArrayList (ptr Node))] a))]
      (store! p (load forms))
      p)))

; ---- accessors -------------------------------------------------------------
(defn node-kind [(n (ptr Node))] (-> NodeKind)
  (load (field n kind)))
(defn node-nl [(n (ptr Node))] (-> i64)
  (load (field n nl-before)))

(defn node-atom? [(n (ptr Node))] (-> bool)
  (match (node-kind n) (NAtom [_] true) (NList [_ _] false) (NComment [_] false) (NPrefix [_ _] false)))
(defn node-list? [(n (ptr Node))] (-> bool)
  (match (node-kind n) (NList [_ _] true) (NAtom [_] false) (NComment [_] false) (NPrefix [_ _] false)))
(defn node-comment? [(n (ptr Node))] (-> bool)
  (match (node-kind n) (NComment [_] true) (NAtom [_] false) (NList [_ _] false) (NPrefix [_ _] false)))

(defn node-raw [(n (ptr Node))] (-> (slice u8))
  (match (node-kind n) (NAtom [s] s) (NComment [s] s) (NList [_ _] "") (NPrefix [_ _] "")))
(defn node-items [(n (ptr Node))] (-> (ptr (ArrayList (ptr Node))))
  (match (node-kind n)
    (NList [_ items] items)
    (NAtom [_] (primitive/cast (ptr (ArrayList (ptr Node))) 0))
    (NComment [_] (primitive/cast (ptr (ArrayList (ptr Node))) 0))
    (NPrefix [_ _] (primitive/cast (ptr (ArrayList (ptr Node))) 0))))
(defn node-open [(n (ptr Node))] (-> i64)
  (match (node-kind n) (NList [o _] o) (NAtom [_] 40) (NComment [_] 40) (NPrefix [_ _] 40)))
(defn node-count [(n (ptr Node))] (-> i64)
  (when (node-list? n) (al-len [(ptr Node)] (load (node-items n)))))
(defn node-nth [(n (ptr Node)) (i i64)] (-> (ptr Node))
  (al-get [(ptr Node)] (load (node-items n)) i))

; head symbol of a list: raw text of item 0 if it is an atom, else "".
(defn head-sym [(n (ptr Node))] (-> (slice u8))
  (if (<= (node-count n) (primitive/cast i64 0))
      ""
      (let [h (node-nth n 0)] (if (node-atom? h) (node-raw h) ""))))
