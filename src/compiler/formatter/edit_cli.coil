; src/compiler/formatter/edit_cli.coil — the standalone `coil edit` CLI.
;
;   coil edit f.coil --form 'defn parse-args' --show
;   coil edit f.coil --form 'defn parse-args' --replace --write < new-form.coil
;   coil edit f.coil --in 'impl Show Point' --form 'show' --replace < new-method.coil
;   coil edit f.coil --form 'defn old' --delete --write
;   coil edit f.coil --form 'defn main' --insert-before --write < helper.coil
;
; The replacement is read from stdin and must be complete, balanced forms or nothing
; is written. Exit: 0 done, 1 address not found or ambiguous, 2 bad input or I/O.
(module coil.compiler.formatter.edit_cli)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.fs" :use *)
(import "coil.result" :use *)
(import "coil.compiler.formatter.formedit" :use *)

(defn usage [] (-> i64)
  (let [w (stderr)]
    (print-str w
               "usage: coil edit <file.coil> [--in ADDR]... --form ADDR OP [--write]\n\n")
    (print-str w
               "  --form ADDR       the form to act on, e.g. 'defn parse-args', 'impl Show Point'\n")
    (print-str w
               "  --in ADDR         descend into this form first (repeatable, outermost first)\n")
    (print-str w
               "  --replace         replace it with the forms on stdin (default)\n")
    (print-str w
               "  --insert-before   insert stdin's forms before it (top-level only)\n")
    (print-str w
               "  --insert-after    insert stdin's forms after it (top-level only)\n")
    (print-str w "  --delete          remove it\n")
    (print-str w "  --show            print it and change nothing\n")
    (print-str w
               "  --list            list the addressable forms (no --form needed)\n")
    (print-str w
               "  --write           rewrite the file (default: print the result)\n")
    2))

(defn apply-outcome [(a (dyn Allocator))
                     (path (slice u8))
                     (out EditOutcome)
                     (op i64)
                     (write bool)] (-> i64)
  (match out
    (EText [text]
           (if (or (= op OP-SHOW) (not write))
               (try (let [_
                            (try-or! (print-str (stdout) text)
                                     (do
                                       (print-str (stderr)
                                                  "error: cannot write standard output\n")
                                       1))]
                      0))
               (try (let [_
                            (try-or! (write-file a path text)
                                     (do
                                       (print-str (stderr)
                                                  "error: cannot write file\n")
                                       2))]
                      0))))
    (ENotFound [listing]
               (let [w (stderr)]
                 (print-str w
                            "error: no form matches that address. This file contains:\n")
                 (print-str w listing)
                 1))
    (EAmbiguous [listing n]
                (let [w (stderr)]
                  (fmt w
                       "error: that address matches {} forms; add items to narrow it:\n"
                       n)
                  (print-str w listing)
                  1))
    (EBadInput [why]
               (let [w (stderr)]
                 (print-str w "error: ")
                 (print-str w why)
                 (print-str w "\n")
                 2))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (malloc-allocator)
        n (primitive/cast i64 argc)
        (mut ins) (ArrayList::new [(slice u8)] a)
        (mut addr) ""
        (mut path) ""
        (mut op) OP-REPLACE
        (mut write) false
        (mut nfiles) 0
        (mut bad) false
        (mut i) 1]
    (loop (if (>= (load i) n)
              (break)
              (let [arg (from-cstr (load (index argv (load i))))
                    nextv
                      (if (< (primitive/iadd (load i) 1) n)
                          (from-cstr (load (index argv
                                                  (primitive/iadd (load i)
                                                                  1))))
                          "")]
                (cond (= arg "--form")
                        (do
                          (set! addr nextv)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (= arg "--in")
                        (do
                          (push! (mut ins) nextv)
                          (set! i (primitive/iadd (load i) 1))
                          0)
                      (= arg "--replace") (set! op OP-REPLACE)
                      (= arg "--insert-before") (set! op OP-BEFORE)
                      (= arg "--insert-after") (set! op OP-AFTER)
                      (= arg "--delete") (set! op OP-DELETE)
                      (= arg "--show") (set! op OP-SHOW)
                      (= arg "--list") (set! op OP-LIST)
                      (= arg "--write") (set! write true)
                      (and (>= (len arg) 2)
                           (and (= (primitive/cast i64 (get arg 0)) #\-)
                                (= (primitive/cast i64 (get arg 1)) #\-)))
                        (do
                          (print-str (stderr) "error: unknown flag\n")
                          (set! bad true)
                          0)
                      :else
                        (do
                          (set! path arg)
                          (set! nfiles (primitive/iadd (load nfiles) 1))
                          0))
                (set! i (primitive/iadd (load i) 1))
                0)))
    (if (or (load bad)
            (!= (load nfiles) 1)
            (and (= (load addr) "") (!= (load op) OP-LIST)))
        (usage)
        (try (let [src
                     (try-or! (read-file a (load path))
                              (let [w (stderr)]
                                (print-str w "error: cannot read ")
                                (print-str w (load path))
                                (print-str w "\n")
                                2))]
               (let [content
                       (if (or (= (load op) OP-DELETE)
                               (= (load op) OP-SHOW)
                               (= (load op) OP-LIST))
                           ""
                           ; the replacement arrives on stdin: it is multi-line
                           ; source, and shell quoting is a poor place for Lisp
                           (OwnedBytes::slice
                             (try-or! (read-to-end a (stdin))
                                      (do
                                        (print-str (stderr)
                                                   "error: cannot read standard input\n")
                                        2))))]
                 (apply-outcome a
                                (load path)
                                (edit-src a
                                          src
                                          (load ins)
                                          (load addr)
                                          (load op)
                                          content)
                                (load op)
                                (load write))))))))
