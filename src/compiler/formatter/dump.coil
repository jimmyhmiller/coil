; src/compiler/formatter/dump.coil — validate the CST reader: print the node tree, indented, with
; each node's kind, nl-before, and raw text.
;   ./target/release/coil run src/compiler/formatter/dump.coil <file.coil>
(module coil.compiler.formatter.dump)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.compiler.formatter.cst" :use *)
(import "coil.cc" :as cc)

(extern open :cc (cc/C) [(ptr i8) i32 ...] (-> i32))

(extern close :cc (cc/C) [i32] (-> i32))

(defn read-file [(a (dyn Allocator)) (path (ptr i8))] (-> (slice u8))
  (let [fd (open path 0)
        buf
          (primitive/cast (ptr i8)
                          (data (match (alloc-bytes a 65536 1)
                                  (Some [s] s)
                                  (None []
                                        (do
                                          (oom-at c"compiler formatter"
                                                  65536)
                                          (slice::new (primitive/cast (ptr u8)
                                                                      0)
                                                      0))))))
        (mut bytes) (ArrayList::new [u8] a)]
    (loop (let [n (read fd buf 65536)]
            (if (<= n 0)
                (break)
                (let [(mut i) 0]
                  (loop (if (>= (load i) n)
                            (break)
                            (do
                              (push! (mut bytes)
                                     (primitive/cast u8
                                                     (load (index buf (load i)))))
                              (set! i (primitive/iadd (load i) 1)))))))))
    (close fd)
    (slice (load bytes))))

(defn indent [(w (ptr Writer)) (d i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) d)
              (break)
              (do (print-str w "  ") (set! i (primitive/iadd (load i) 1))))))
  0)

(defn dump-node [(w (ptr Writer)) (n (ptr Node)) (d i64)] (-> i64)
  (indent w d)
  (print-str w "[nl=")
  (print-int w (node-nl n))
  (print-str w "] ")
  (if (node-comment? n)
      (do
        (print-str w "COMMENT ")
        (print-str w (node-raw n))
        (print-str w "\n")
        0)
      (if (node-atom? n)
          (do
            (print-str w "ATOM ")
            (print-str w (node-raw n))
            (print-str w "\n")
            0)
          (if (node-list? n)
              (do
                (print-str w
                           (if (= (node-open n) 40)
                               "( LIST\n"
                               "[ VEC\n"))
                (let [(mut i) 0
                      c (node-count n)]
                  (loop (if (>= (load i) c)
                            (break)
                            (do
                              (dump-node w
                                         (node-nth n (load i))
                                         (primitive/iadd d 1))
                              (set! i (primitive/iadd (load i) 1))))))
                0)
              (do (print-str w "PREFIX\n") 0))))
  0)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (malloc-allocator)
        w (stdout)]
    (if (< (primitive/cast i64 argc) 2)
        (do (print-str w "usage: dump <file.coil>\n") 1)
        (let [src (read-file a (load (index argv 1)))
              doc (read-doc a src)
              n (len (load doc))]
          (print-str w "forms: ")
          (print-int w n)
          (print-str w "\n")
          (for [i 0 n]
            (dump-node w (get (load doc) i) 0))
          0))))
