; src/compiler/formatter/doc.coil — a Wadler/Prettier "Doc" algebra and a width-driven renderer.
;
; A Doc describes layout without committing to line breaks; the renderer, given a
; target width, decides which groups break. Two indentation primitives cover Lisp
; needs:
;   DNest  — indent := indent + N   (relative; body indent "+2")
;   DAlign — indent := current-column + delta   (absolute to the cursor; every
;            list re-anchors to its own open-paren column, so alignment survives
;            whatever indentation an ancestor chose)
; A DGroup renders flat if its flattened width fits the remaining columns, else it
; breaks. A hardline (or a forced group) has "infinite" flat width, so it forces
; every enclosing group to break — the standard break-propagation trick.
(module doc)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)

; line kinds: 0 = line (space | newline), 1 = softline ('' | newline),
;             2 = hardline (always newline; unflattenable)
(defsum Doc
  (DNil [])
  (DText [(s (slice u8))])
  (DConcat [(items (ptr (ArrayList (ptr Doc))))])
  (DLine [(kind i64)])
  (DNest [(amount i64) (doc (ptr Doc))])
  (DAlign [(delta i64) (doc (ptr Doc))])
  (DGroup [(doc (ptr Doc)) (forced i64)]))

; "infinite" flat width — anything at least this wide can never be laid out flat.
(defn doc-inf [] (-> i64)
  1000000000)

(defn box-doc [(a (dyn Allocator)) (k Doc)] (-> (ptr Doc))
  (box! a Doc k))

; ---- constructors ----------------------------------------------------------
(defn d-nil [(a (dyn Allocator))] (-> (ptr Doc))
  (box-doc a (DNil)))
(defn d-text [(a (dyn Allocator)) (s (slice u8))] (-> (ptr Doc))
  (box-doc a (DText s)))
(defn d-line [(a (dyn Allocator))] (-> (ptr Doc))
  (box-doc a (DLine 0)))
(defn d-softline [(a (dyn Allocator))] (-> (ptr Doc))
  (box-doc a (DLine 1)))
(defn d-hardline [(a (dyn Allocator))] (-> (ptr Doc))
  (box-doc a (DLine 2)))
(defn d-nest [(a (dyn Allocator)) (n i64) (x (ptr Doc))] (-> (ptr Doc))
  (box-doc a (DNest n x)))
(defn d-align [(a (dyn Allocator)) (n i64) (x (ptr Doc))] (-> (ptr Doc))
  (box-doc a (DAlign n x)))
(defn d-group [(a (dyn Allocator)) (x (ptr Doc))] (-> (ptr Doc))
  (box-doc a (DGroup x 0)))
(defn d-group-forced [(a (dyn Allocator)) (x (ptr Doc))] (-> (ptr Doc))
  (box-doc a (DGroup x 1)))

; ---- concat builder --------------------------------------------------------
; A growable list of child docs; `dl-done` seals it into a DConcat.
(defn dl-new [(a (dyn Allocator))] (-> (ptr (ArrayList (ptr Doc))))
  (box! a (ArrayList (ptr Doc)) (al-new [(ptr Doc)] a)))
(defn dl-push! [(dl (ptr (ArrayList (ptr Doc)))) (x (ptr Doc))] (-> i64)
  (al-push! [(ptr Doc)] dl x)
  0)
(defn dl-done [(a (dyn Allocator)) (dl (ptr (ArrayList (ptr Doc))))] (-> (ptr Doc))
  (box-doc a (DConcat dl)))

; ---- flat width ------------------------------------------------------------
; Width if `d` were laid out entirely flat, capped at doc-inf. A hardline or a
; forced group yields doc-inf, so any group containing one cannot be flat.
(defn flat-width [(d (ptr Doc))] (-> i64)
  (match (load d)
    (DNil [] 0)
    (DText [s] (slice-len s))
    (DLine [k] (if (= k (primitive/cast i64 0)) 1 (unless (= k (primitive/cast i64 1)) (doc-inf))))
    (DNest [n x] (flat-width x))
    (DAlign [n x] (flat-width x))
    (DGroup [x f] (if (!= f (primitive/cast i64 0)) (doc-inf) (flat-width x)))
    (DConcat [items]
             (let [n (al-len [(ptr Doc)] (load items))
                   (mut i) 0
                   (mut acc) 0]
               (loop (if (>= (load i) n)
                         (break)
                         (let [wp (flat-width (al-get [(ptr Doc)] (load items) (load i)))]
                           (if (>= wp (doc-inf))
                               (do (set! acc (doc-inf)) (break))
                               (do (set! acc (primitive/iadd (load acc) wp)) (set! i (primitive/iadd (load i) 1)))))))
               (load acc)))))

; ---- output helpers --------------------------------------------------------
(defn sb-emit [(sb (ptr StrBuf)) (s (slice u8))] (-> i64)
  (let [(mut i) 0
        n (slice-len s)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.bytes sb)) (slice-get s (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn sb-spaces [(sb (ptr StrBuf)) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (al-push! (mut (.bytes sb)) (primitive/cast u8 32)) (set! i (primitive/iadd (load i) 1))))))
  0)

; Indentation is emitted eagerly after a break. If the next document is another
; break (a preserved blank line), remove that unused indentation before writing
; the newline so formatted files never contain whitespace-only lines.
(defn sb-trim-line-spaces! [(sb (ptr StrBuf))] (-> i64)
  (let [bytes (field sb bytes)]
    (loop (let [n (.len bytes)]
            (if (and (> n (primitive/cast i64 0))
                     (= (load (primitive/index (load (field bytes data)) (primitive/isub n 1)))
                        (primitive/cast u8 32)))
                (set! (.len bytes) (primitive/isub n 1))
                (break)))))
  0)

; ---- renderer --------------------------------------------------------------
; mode: 0 = FLAT, 1 = BREAK. Returns the new column.
(defn render [(sb (ptr StrBuf)) (w i64) (col i64) (ind i64) (mode i64) (d (ptr Doc))] (-> i64)
  (match (load d)
    (DNil [] col)
    (DText [s] (sb-emit sb s) (primitive/iadd col (slice-len s)))
    (DLine [k]
           (if (= mode (primitive/cast i64 0))
               (if (= k (primitive/cast i64 0))
                   (do (sb-emit sb " ") (primitive/iadd col 1))
                   (if (= k (primitive/cast i64 1))
                       col
                       (do (sb-trim-line-spaces! sb) (sb-emit sb "\n") (sb-spaces sb ind) ind)))  ; hardline breaks even flat
               (do (sb-trim-line-spaces! sb) (sb-emit sb "\n") (sb-spaces sb ind) ind)))
    (DNest [n x] (render sb w col (primitive/iadd ind n) mode x))
    (DAlign [n x] (render sb w col (primitive/iadd col n) mode x))
    (DGroup [x f]
            (let [fw (if (!= f (primitive/cast i64 0)) (doc-inf) (flat-width x))]
              (if (and (< fw (doc-inf)) (<= (primitive/iadd col fw) w))
                  (render sb w col ind 0 x)
                  (render sb w col ind 1 x))))
    (DConcat [items]
             (let [n (al-len [(ptr Doc)] (load items))
                   (mut i) 0
                   (mut c) col]
               (loop (if (>= (load i) n)
                         (break)
                         (do
                           (set! c (render sb w (load c) ind mode (al-get [(ptr Doc)] (load items) (load i))))
                           (set! i (primitive/iadd (load i) 1)))))
               (load c)))))

; ---- entry -----------------------------------------------------------------
; Render a Doc to a fresh (slice u8) at the given width.
(defn render-doc [(a (dyn Allocator)) (d (ptr Doc)) (w i64)] (-> (slice u8))
  (let [sb (box! a StrBuf (primitive/zeroed StrBuf))]
    (set! (.bytes sb) (al-new [u8] a))
    (render sb w 0 0 1 d)
    (al-slice [u8] (.bytes sb))))
