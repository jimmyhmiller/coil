; src/compiler/formatter/balance_cli.coil — the standalone `balance` CLI.

;
;   coil run src/compiler/formatter/balance_cli.coil -- <file.coil>            print repaired source
;   coil run src/compiler/formatter/balance_cli.coil -- --check <file.coil>    exit 1 if unbalanced
;   coil run src/compiler/formatter/balance_cli.coil -- --write <file.coil>    repair in place
;
; Equivalent to the built-in `coil balance`; kept because it builds in seconds, so
; the repair rules can be iterated on without rebuilding the whole compiler.
;
; Exit: 0 balanced (or repaired), 1 unbalanced under --check, 2 refused or I/O error.
(module coil.compiler.formatter.balance_cli)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.fs" :use *)
(import "coil.result" :use *)
(import "coil.compiler.formatter.balance" :use *)

(defn usage [] (-> i64)
  (print-str (stderr) "usage: balance [--check|--write] [--strict] [--dump-delims] <file.coil>\n")
  2)

; One byte offset per line: every ()/[] the scanner counts as structure. The mutation
; harness reads this to damage only real delimiters — a `)` inside a string or comment
; is not a defect, and mutating one would make the harness measure nothing.
(defn dump-delims [(a (dyn Allocator)) (src (slice u8))] (-> i64)
  (let [ds (code-delims a src)
        n (len ds)
        w (stdout)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (fmt w "{}\n" (get ds (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn run [(a (dyn Allocator)) (path (slice u8)) (check bool) (write bool) (dump bool) (strict bool)] (-> i64)
  (try (let [src
               (try-or! (read-file a path)
                        (let [w (stderr)]
                          (print-str w "error: cannot read ")
                          (print-str w path)
                          (print-str w "\n")
                          2))]
         (if dump (dump-delims a src) (repair a path src check write strict)))))

(defn emit [(a (dyn Allocator)) (path (slice u8)) (text (slice u8)) (write bool)] (-> i64)
  (if write
      (try (let [_ (try-or! (write-file a path text) (do (print-str (stderr) "error: cannot write file\n") 2))] 0))
      (do (print-str (stdout) text) 0)))

(defn repair [(a (dyn Allocator)) (path (slice u8)) (src (slice u8)) (check bool) (write bool) (strict bool)] (-> i64)
  (match (balance-src a src strict)
    (BClean [] (if (or write check) 0 (do (print-str (stdout) src) 0)))
    (BRefused [_code why line col]
              (let [w (stderr)]
                (fmt w "error: {}\n  --> {}:{}:{}\n" why path line col)
                2))
    (BFixed [text ins del guessed guess-line]
            (if check
                (let [w (stderr)]
                  (fmt w "unbalanced: {} ({} closer(s) missing, {} stray)\n" path ins del)
                  1)
                (do
                  ; Say which closers the indent rule derived and which it did not. Reporting
                  ; a guess as a derivation is how a repair tool loses the right to be trusted.
                  (when (> guessed (primitive/cast i64 0))
                    (fmt (stderr)
                         "note: {}: {} closer(s) placed inside a single line, where indentation cannot say where they belong; first at line {}\n"
                         path
                         guessed
                         guess-line)
                    0)
                  (emit a path text write))))))

; Flags may appear in any order and `--strict` combines with the others, so scan the
; whole argv rather than reading argv[1] and hoping.
(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (malloc-allocator)
        n (primitive/cast i64 argc)
        (mut check) false
        (mut write) false
        (mut dump) false
        (mut strict) false
        (mut path) ""
        (mut nfiles) 0
        (mut bad) false
        (mut i) 1]
    (loop (if (>= (load i) n)
              (break)
              (let [arg (cstr->str (load (primitive/index argv (load i))))]
                (cond (= arg "--check") (store! check true)
                      (= arg "--write") (store! write true)
                      (= arg "--strict") (store! strict true)
                      (= arg "--dump-delims") (store! dump true)
                      (and (>= (len arg) (primitive/cast i64 2))
                           (and (= (primitive/cast i64 (get arg 0)) #\-)
                                (= (primitive/cast i64 (get arg 1)) #\-)))
                        (do (print-str (stderr) "error: unknown flag\n") (store! bad true) 0)
                      :else (do (store! path arg) (store! nfiles (primitive/iadd (load nfiles) 1)) 0))
                (set! i (primitive/iadd (load i) 1))
                0)))
    (if (or (load bad) (!= (load nfiles) (primitive/cast i64 1)))
        (usage)
        (run a (load path) (load check) (load write) (load dump) (load strict)))))
