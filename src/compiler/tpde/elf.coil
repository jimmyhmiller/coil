; Ported to Coil from TPDE (commit 9779acf) and modified; see NOTICE.
;;; ELF64 relocatable-object writer for x86-64 (TPDE's AssemblerElfX64).
;;; Serializes a `tpde.asm` Asm.
;;;
;;; Every Asm section becomes an ELF section (.text, .rodata, .rodata.str1.1,
;;; .data, .data.rel.ro, .bss), each with a .rela section when it has
;;; relocations. Symbols are ordered locals then globals, as ELF requires. A
;;; PC-relative relocation's addend is the symbol addend minus 4: the field is
;;; the last four bytes of the instruction.
(module tpde.elf)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "tpde.buf" :as buf :use [Buf])
(import "tpde.asm" :as asm :use [Asm Section Symbol Reloc])

(const R-X86-64-64 1)

(const R-X86-64-PC32 2)

(const R-X86-64-PLT32 4)

(const R-X86-64-32 10)

(const R-X86-64-REX-GOTPCRELX 42)

(const SHT-PROGBITS 1)

(const SHT-SYMTAB 2)

(const SHT-STRTAB 3)

(const SHT-RELA 4)

(const SHT-NOBITS 8)

(const SHF-WRITE 1)

(const SHF-ALLOC 2)

(const SHF-EXEC 4)

(const SHF-MERGE 0x10)

(const SHF-STRINGS 0x20)

(const SHF-INFO-LINK 0x40)

(defn u8! [(out (ptr Buf)) (x i64)] (-> void)
  (buf/emit8! out (primitive/cast u8 x)))

(defn u16! [(out (ptr Buf)) (x i64)] (-> void)
  (buf/emit16! out (primitive/cast u16 x)))

(defn u32! [(out (ptr Buf)) (x i64)] (-> void)
  (buf/emit32! out (primitive/cast u32 x)))

(defn u64! [(out (ptr Buf)) (x i64)] (-> void)
  (buf/emit64! out (primitive/cast u64 x)))

(defn align-up [(v i64) (align i64)] (-> i64)
  (& (+ v (- align 1)) (- 0 align)))

(defn pad! [(out (ptr Buf)) (align i64)] (-> void)
  (buf/emit-zeros! out (- (align-up (.len out) align) (.len out))))

;;; Add `s` (and a NUL) to a string table; returns its offset.
(defn str! [(t (ptr Buf)) (s (slice u8))] (-> i64)
  (let [o (.len t)]
    (buf/emit-slice! t s)
    (buf/emit8! t (: 0 u8))
    o))

(defn sect-name [(i i64)] (-> (slice u8))
  (case i
    0 ".text"
    1 ".rodata"
    2 ".rodata.str1.1"
    3 ".data"
    4 ".data.rel.ro"
    ".bss"))

(defn sect-flags [(i i64)] (-> i64)
  (case i
    0 (| SHF-ALLOC SHF-EXEC)
    1 SHF-ALLOC
    2 (| SHF-ALLOC (| SHF-MERGE SHF-STRINGS))
    (| SHF-ALLOC SHF-WRITE)))

(defn reloc-type [(kind u8)] (-> i64)
  (case (cast i64 kind)
    5 R-X86-64-64
    6 R-X86-64-PC32
    7 R-X86-64-PLT32
    8 R-X86-64-REX-GOTPCRELX
    9 R-X86-64-32
    -1))

(defn pcrel? [(kind u8)] (-> bool)
  (or (= kind (: 6 u8)) (= kind (: 7 u8)) (= kind (: 8 u8))))

(defstruct Shdr
  [(name i64)
   (type i64)
   (flags i64)
   (offset i64)
   (size i64)
   (link i64)
   (info i64)
   (align i64)
   (entsize i64)])

;;; Serialize `a` as an ELF64 x86-64 relocatable object into `out`.
(defn write-object! [(a (ptr Asm)) (out (ptr Buf))] (-> void)
  (let [al (malloc-allocator)
        nsect (len (.sects a))
        nsym (cast i64 (asm/sym-count a))
        nrel (len (.relocs a))
        (mut order) (ArrayList::new [i64] al)
        (mut perm) (ArrayList::new [i64] al)
        (mut nlocal) 1
        (mut strtab) (Buf::new)
        (mut shstr) (Buf::new)
        (mut shdrs) (ArrayList::new [Shdr] al)
        st (cast (ptr Buf) (mut strtab))
        sh (cast (ptr Buf) (mut shstr))]
    (extend-zeroed! (mut perm) nsym)
    (buf/emit8! st (: 0 u8))
    (buf/emit8! sh (: 0 u8))
    ; ---- symbol order: locals, then globals (index 0 is the null symbol)
    (for pass (range 0 2)
      (for i (range 0 nsym)
        (let [s (asm/sym-at a (cast u32 i))
              local (and (= (.binding s) (: 0 u8)) (>= (.sect s) 0))]
          (when (= local (= pass 0))
            (set! (mut perm) i (+ (len order) 1))
            (push! (mut order) i)
            (when local (set! nlocal (+ nlocal 1)))))))
    ; ---- header (written last into its place) and section contents
    (buf/emit-zeros! out 64)
    (push! (mut shdrs)
           (Shdr
             :name 0
             :type 0
             :flags 0
             :offset 0
             :size 0
             :link 0
             :info 0
             :align 0
             :entsize 0))
    (for i (range 0 nsect)
      (let [s (asm/sect-at a i)
            zf (= i asm/SEC-BSS)
            al2 (<< 1 (.align s))]
        (pad! out al2)
        (let [o (.len out)]
          (unless zf (buf/emit-bytes! out (.data (.data s)) (.len (.data s))))
          (push! (mut shdrs)
                 (Shdr
                   :name (str! sh (sect-name i))
                   :type (if zf SHT-NOBITS SHT-PROGBITS)
                   :flags (sect-flags i)
                   :offset o
                   :size (if zf (.zsize s) (.len (.data s)))
                   :link 0
                   :info 0
                   :align al2
                   :entsize (if (= i 2) 1 0))))))
    ; .note.GNU-stack: no executable stack
    (push! (mut shdrs)
           (Shdr
             :name (str! sh ".note.GNU-stack")
             :type SHT-PROGBITS
             :flags 0
             :offset (.len out)
             :size 0
             :link 0
             :info 0
             :align 1
             :entsize 0))
    ; ---- symbol table (its index is fixed once we know the rela count)
    (let [(mut nrela) 0]
      (for i (range 0 nsect)
        (let [(mut any) false]
          (for ri (range 0 nrel)
            (when (= (.sect (get (.relocs a) ri)) i) (set! any true)))
          (when any (set! nrela (+ nrela 1)))))
      (let [symtab-idx (+ (len shdrs) nrela)]
        ; ---- relocation sections
        (for i (range 0 nsect)
          (let [(mut cnt) 0]
            (for ri (range 0 nrel)
              (when (= (.sect (get (.relocs a) ri)) i) (set! cnt (+ cnt 1))))
            (when (> cnt 0)
              (pad! out 8)
              (let [o (.len out)]
                (for ri (range 0 nrel)
                  (let [r (get (.relocs a) ri)]
                    (when (= (.sect r) i)
                      (u64! out (.off r))
                      (u64! out
                            (| (<< (get perm (cast i64 (.sym r))) 32)
                               (reloc-type (.kind r))))
                      (u64! out
                            (if (pcrel? (.kind r))
                                (- (.addend r) 4)
                                (.addend r))))))
                (push! (mut shdrs)
                       (Shdr
                         :name (str! sh (cat ".rela" (sect-name i)))
                         :type SHT-RELA
                         :flags SHF-INFO-LINK
                         :offset o
                         :size (* 24 cnt)
                         :link symtab-idx
                         :info (+ i 1)
                         :align 8
                         :entsize 24))))))
        (pad! out 8)
        (let [symoff (.len out)]
          (buf/emit-zeros! out 24)
          (for k (range 0 nsym)
            (let [i (get order k)
                  s (asm/sym-at a (cast u32 i))
                  defined (>= (.sect s) 0)
                  bind
                    (cond (= (.binding s) (: 2 u8)) 2
                          (and (= (.binding s) (: 0 u8)) defined) 0
                          :else 1)
                  type
                    (cond (not defined) 0 (= (.sect s) asm/SEC-TEXT) 2 :else 1)]
              (u32! out (if (= (len (.name s)) 0) 0 (str! st (.name s))))
              (u8! out (| (<< bind 4) type))
              (u8! out 0)
              (u16! out (if defined (+ (.sect s) 1) 0))
              (u64! out (if defined (.off s) 0))
              (u64! out (if defined (.size s) 0))))
          (push! (mut shdrs)
                 (Shdr
                   :name (str! sh ".symtab")
                   :type SHT-SYMTAB
                   :flags 0
                   :offset symoff
                   :size (* 24 (+ nsym 1))
                   :link (+ symtab-idx 1)
                   :info nlocal
                   :align 8
                   :entsize 24))
          (let [stroff (.len out)]
            (buf/emit-bytes! out (.data strtab) (.len strtab))
            (push! (mut shdrs)
                   (Shdr
                     :name (str! sh ".strtab")
                     :type SHT-STRTAB
                     :flags 0
                     :offset stroff
                     :size (.len strtab)
                     :link 0
                     :info 0
                     :align 1
                     :entsize 0))
            (let [shname (str! sh ".shstrtab")
                  shstroff (.len out)]
              (buf/emit-bytes! out (.data shstr) (.len shstr))
              (push! (mut shdrs)
                     (Shdr
                       :name shname
                       :type SHT-STRTAB
                       :flags 0
                       :offset shstroff
                       :size (.len shstr)
                       :link 0
                       :info 0
                       :align 1
                       :entsize 0))
              (pad! out 8)
              (let [shoff (.len out)
                    nsh (len shdrs)]
                (for i (range 0 nsh)
                  (let [h (get shdrs i)]
                    (u32! out (.name h))
                    (u32! out (.type h))
                    (u64! out (.flags h))
                    (u64! out 0)
                    (u64! out (.offset h))
                    (u64! out (.size h))
                    (u32! out (.link h))
                    (u32! out (.info h))
                    (u64! out (.align h))
                    (u64! out (.entsize h))))
                ; ---- the header
                (let [(mut h) (Buf::new)
                      hp (cast (ptr Buf) (mut h))]
                  (u8! hp 0x7F)
                  (u8! hp 0x45)
                  (u8! hp 0x4C)
                  (u8! hp 0x46)
                  (u8! hp 2)
                  (u8! hp 1)
                  (u8! hp 1)
                  (u8! hp 0)
                  (buf/emit-zeros! hp 8)
                  (u16! hp 1)  ; ET_REL
                  (u16! hp 62)  ; EM_X86_64
                  (u32! hp 1)
                  (u64! hp 0)
                  (u64! hp 0)
                  (u64! hp shoff)
                  (u32! hp 0)
                  (u16! hp 64)
                  (u16! hp 0)
                  (u16! hp 0)
                  (u16! hp 64)
                  (u16! hp nsh)
                  (u16! hp (- nsh 1))
                  (for i (range 0 64)
                    (buf/patch8! out i (load (buf/buf-at hp i))))
                  (buf/buf-free! hp))))))))
    (buf/buf-free! st)
    (buf/buf-free! sh)
    (free! (mut order))
    (free! (mut perm))))

(defn cat [(x (slice u8)) (y (slice u8))] (-> (slice u8))
  (let [(mut b) (Buf::new)
        bp (cast (ptr Buf) (mut b))]
    (buf/emit-slice! bp x)
    (buf/emit-slice! bp y)
    (buf/as-slice bp)))
