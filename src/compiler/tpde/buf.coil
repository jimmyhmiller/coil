; Ported to Coil from TPDE (commit 9779acf) and modified; see NOTICE.
;;; A growable byte buffer with direct little-endian writes, for code and data.
;;; It grows with `realloc` and never shrinks; `clear!` keeps the storage.
(module tpde.buf)
(import "coil.cc" :as cc)

(extern malloc :cc (cc/C) [i64] (-> (ptr u8)))

(extern realloc :cc (cc/C) [(ptr u8) i64] (-> (ptr u8)))

(extern free :cc (cc/C) [(ptr u8)] (-> void))

(extern memcpy :cc (cc/C) [(ptr u8) (ptr u8) i64] (-> (ptr u8)))

(extern memset :cc (cc/C) [(ptr u8) i32 i64] (-> (ptr u8)))

(extern memmove :cc (cc/C) [(ptr u8) (ptr u8) i64] (-> (ptr u8)))

(defstruct Buf [(data (ptr u8)) (len i64) (cap i64)])

(impl Buf
  (new [] (-> Buf)
    (Buf
      :data (cast (ptr u8) 0)
      :len 0
      :cap 0)))

(defn buf-reserve! [(b (ptr Buf)) (extra i64)] (-> void)
  (let [need (+ (.len b) extra)]
    (when (> need (.cap b))
      (let [(mut cap) (if (= (.cap b) 0) 256 (* (.cap b) 2))]
        (while (< cap need) (set! cap (* cap 2)))
        (set! (.data b) (realloc (.data b) cap))
        (set! (.cap b) cap)))))

(defn buf-clear! [(b (ptr Buf))] (-> void)
  (set! (.len b) 0))

(defn buf-free! [(b (ptr Buf))] (-> void)
  (when (!= (cast i64 (.data b)) 0) (free (.data b)))
  (set! (.data b) (cast (ptr u8) 0))
  (set! (.len b) 0)
  (set! (.cap b) 0))

(defn buf-at [(b (ptr Buf)) (off i64)] (-> (ptr u8))
  (index (.data b) off))

(defn emit8! [(b (ptr Buf)) (x u8)] (-> void)
  (buf-reserve! b 1)
  (set! (buf-at b (.len b)) x)
  (set! (.len b) (+ (.len b) 1)))

(defn emit16! [(b (ptr Buf)) (x u16)] (-> void)
  (buf-reserve! b 2)
  (set! (cast (ptr u16) (buf-at b (.len b))) x)
  (set! (.len b) (+ (.len b) 2)))

(defn emit32! [(b (ptr Buf)) (x u32)] (-> void)
  (buf-reserve! b 4)
  (set! (cast (ptr u32) (buf-at b (.len b))) x)
  (set! (.len b) (+ (.len b) 4)))

(defn emit64! [(b (ptr Buf)) (x u64)] (-> void)
  (buf-reserve! b 8)
  (set! (cast (ptr u64) (buf-at b (.len b))) x)
  (set! (.len b) (+ (.len b) 8)))

(defn emit-bytes! [(b (ptr Buf)) (p (ptr u8)) (n i64)] (-> void)
  (when (> n 0)
    (buf-reserve! b n)
    (memcpy (buf-at b (.len b)) p n)
    (set! (.len b) (+ (.len b) n))))

(defn emit-slice! [(b (ptr Buf)) (s (slice u8))] (-> void)
  (emit-bytes! b (data s) (len s)))

(defn emit-zeros! [(b (ptr Buf)) (n i64)] (-> void)
  (when (> n 0)
    (buf-reserve! b n)
    (memset (buf-at b (.len b)) 0 n)
    (set! (.len b) (+ (.len b) n))))

(defn align-to! [(b (ptr Buf)) (align i64)] (-> void)
  (let [pad (- (& (+ (.len b) (- align 1)) (- 0 align)) (.len b))]
    (emit-zeros! b pad)))

(defn read32 [(b (ptr Buf)) (off i64)] (-> u32)
  (load (cast (ptr u32) (buf-at b off))))

(defn patch32! [(b (ptr Buf)) (off i64) (x u32)] (-> void)
  (set! (cast (ptr u32) (buf-at b off)) x))

(defn patch64! [(b (ptr Buf)) (off i64) (x u64)] (-> void)
  (set! (cast (ptr u64) (buf-at b off)) x))

(defn patch8! [(b (ptr Buf)) (off i64) (x u8)] (-> void)
  (set! (buf-at b off) x))

;;; Remove `n` bytes at `off`, shifting the rest down.
(defn cut! [(b (ptr Buf)) (off i64) (n i64)] (-> void)
  (when (> n 0)
    (memmove (buf-at b off) (buf-at b (+ off n)) (- (.len b) (+ off n)))
    (set! (.len b) (- (.len b) n))))

(defn as-slice [(b (ptr Buf))] (-> (slice u8))
  (slice::new (.data b) (.len b)))

(defn uleb! [(b (ptr Buf)) (v0 u64)] (-> void)
  (let [(mut v) v0]
    (loop (let [byte (cast u8 (& v (: 0x7f u64)))]
            (set! v (>> v (: 7 u64)))
            (if (= v (: 0 u64))
                (do (emit8! b byte) (break))
                (emit8! b (| byte (: 0x80 u8))))))))

(defn sleb! [(b (ptr Buf)) (v0 i64)] (-> void)
  (let [(mut v) v0]
    (loop (let [byte (cast u8 (& v 0x7f))]
            (set! v (>> v 7))
            (if (or (and (= v 0) (= (& byte (: 0x40 u8)) (: 0 u8)))
                    (and (= v -1) (!= (& byte (: 0x40 u8)) (: 0 u8))))
                (do (emit8! b byte) (break))
                (emit8! b (| byte (: 0x80 u8))))))))
