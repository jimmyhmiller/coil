; Ported to Coil from TPDE (commit 9779acf) and modified; see NOTICE.
;;; The interface an IR's code generator provides to the compiler core, beside
;;; `tpde.adaptor/IRAdaptor`: how each value splits into register-sized parts,
;;; which values are constants, and the instruction selector itself. TPDE puts
;;; these on the derived compiler class.
(module tpde.codegen)
(import "tpde.core" :use [Compiler])

;;; How a value is materialized. A normal value has an assignment; the others
;;; are recomputed at each use and take no part in liveness.
(const VAL-NORMAL 0)

(const VAL-CONST 1)  ; `val-const-part` gives each part's bits

(const VAL-SYM 2)  ; the address of symbol `val-sym` + `val-sym-addend`

(deftrait IRCompiler [Self]
  ;;; Number of parts of `v` (at least 1).
  (val-part-count [(self (ptr Self)) (v u32)] (-> u32))
  ;;; Size in bytes of a part: 1, 2, 4, 8 or 16.
  (val-part-size [(self (ptr Self)) (v u32) (part u32)] (-> u32))
  ;;; Register bank of a part: 0 general purpose, 1 floating point/vector.
  (val-part-bank [(self (ptr Self)) (v u32) (part u32)] (-> u8))
  (val-kind [(self (ptr Self)) (v u32)] (-> u8))
  ;;; For VAL-CONST: the low (word 0) and high (word 1) 8 bytes of a part.
  (val-const-word [(self (ptr Self)) (v u32) (part u32) (word u32)] (-> u64))
  ;;; For VAL-SYM: the symbol (an index into the assembler's symbols) and addend.
  (val-sym [(self (ptr Self)) (c (ptr (Compiler Self))) (v u32)] (-> u32))
  (val-sym-addend [(self (ptr Self)) (v u32)] (-> i64))
  ;;; Flags of argument `i` (as for call operands): bits 16..23 say how many
  ;;; following arguments must stay with it in consecutive registers.
  (cur-arg-flags [(self (ptr Self)) (i u32)] (-> u32))
  ;;; Whether the current function may contain calls (TPDE's
  ;;; cur_func_may_emit_calls); a function that cannot is a leaf.
  (cur-may-emit-calls? [(self (ptr Self))] (-> bool))
  ;;; Whether the current function has tail calls. A function whose only calls
  ;;; are tail calls is a leaf (nothing is live across a tail call), but its
  ;;; fixed registers must then stay clear of the argument registers.
  (cur-has-tail-calls? [(self (ptr Self))] (-> bool))
  ;;; Whether to try hard for a fixed register for `v`.
  (force-fixed? [(self (ptr Self)) (v u32)] (-> bool))
  ;;; Whether `v` may receive a fixed register at all.
  (allow-fixed? [(self (ptr Self)) (v u32)] (-> bool))
  ;;; Compile one instruction. False is a failure.
  (compile-inst! [(self (ptr Self)) (c (ptr (Compiler Self))) (inst u32)]
    (-> bool))
  ;;; Called once per function before its body, to set up function-level state
  ;;; (after the frame and arguments). False is a failure.
  (begin-func! [(self (ptr Self)) (c (ptr (Compiler Self))) (f u32)] (-> bool)))
