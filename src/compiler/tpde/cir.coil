; SPDX-FileCopyrightText: 2026 Jimmy Miller
; SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
;;; CIR: a small, low-level SSA IR that tpde compiles; the Coil compiler lowers
;;; to it. One function at a time is built, compiled and reset.
;;;
;;; Types are register shapes, not source types: I64 (integers, pointers and
;;; bools, kept extended to 64 bits by the producer), I128 (two GP parts), F32,
;;; F64, V128. Memory accesses say their width.
;;;
;;; Every value has a dense id (its local index for tpde). Constants, symbol
;;; addresses and allocas are values without an instruction. Instructions live in
;;; blocks; a block is filled while it is current and terminated once.
;;;
;;; SSA construction is Braun et al.'s ("Simple and Efficient Construction of
;;; Static Single Assignment Form", CC 2013): `def-var!`/`use-var!` per block,
;;; `seal!` once a block's predecessors are all known. A trivial PHI is replaced
;;; by forwarding (`fwd`); `finish!` removes the rest to a fixpoint and rewrites
;;; operands through the forwards.
(module tpde.cir)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])

; ---- types ----
(const T-VOID 0)

(const T-I64 1)

(const T-I128 2)

(const T-F32 3)

(const T-F64 4)

(const T-V128 5)

; ---- ops ----
; values without instructions
(const OP-CONST 1)  ; imm = low bits, imm2 = high bits

(const OP-SYM 2)  ; imm = symbol, imm2 = addend

(const OP-ARG 3)  ; imm = index

(const OP-ALLOCA 4)  ; imm = size, imm2 = align (a stack variable)

(const OP-CALLRES 5)  ; an extra result of the call operand 0; imm = result index

; integer arithmetic (I64, or I128 where noted)
(const OP-ADD 10)

(const OP-SUB 11)

(const OP-MUL 12)

(const OP-AND 13)

(const OP-OR 14)

(const OP-XOR 15)

(const OP-SHL 16)

(const OP-LSHR 17)

(const OP-ASHR 18)

(const OP-SDIV 19)

(const OP-UDIV 20)

(const OP-SREM 21)

(const OP-UREM 22)

(const OP-ROTL 23)

(const OP-ROTR 24)  ; imm = width

(const OP-NEG 25)

(const OP-NOT 26)

(const OP-SMULH 27)

(const OP-UMULH 28)

(const OP-SEXT 29)  ; sign-extend from imm bits (I64), or I64 -> I128

(const OP-ZEXT 30)  ; zero-extend from imm bits (I64), or I64 -> I128

(const OP-LO 31)  ; low 64 bits of an I128

(const OP-HI 32)  ; high 64 bits of an I128

(const OP-PAIR 33)  ; I128 from (lo, hi)

(const OP-CLZ 34)

(const OP-CTZ 35)

(const OP-POPCNT 36)

(const OP-BSWAP 37)  ; imm = width

(const OP-ICMP 38)  ; imm = predicate; result I64 0/1

(const OP-SELECT 39)  ; (cond, a, b)

(const OP-ADDO 40)

(const OP-SUBO 41)

(const OP-MULO 42)  ; overflow? imm = width, imm2 = signed

(const OP-BITREV 43)

; floating point
(const OP-FADD 50)

(const OP-FSUB 51)

(const OP-FMUL 52)

(const OP-FDIV 53)

(const OP-FNEG 54)

(const OP-FABS 55)

(const OP-FSQRT 56)

(const OP-FMIN 57)

(const OP-FMAX 58)

(const OP-FMINNM 59)

(const OP-FMAXNM 60)

(const OP-FRINT 61)  ; imm = mode: 0 nearest-even, 1 +inf, 2 -inf, 3 zero, 4 away

(const OP-FMA 62)  ; a*b + c

(const OP-FCMP 63)  ; imm = predicate; result I64 0/1

(const OP-FPEXT 64)

(const OP-FPTRUNC 65)

(const OP-SITOFP 66)

(const OP-UITOFP 67)

(const OP-FPTOSI 68)

(const OP-FPTOUI 69)  ; imm = result width (32/64)

(const OP-BITCAST 70)  ; same-size reinterpretation between banks

(const OP-COPY 71)

; memory
(const OP-LOAD 80)  ; (ptr) imm = offset, imm2 = bytes | signed<<8

(const OP-STORE 81)  ; (ptr, val) imm = offset, imm2 = bytes

(const OP-PTRADD 82)  ; (ptr, idx) ptr + idx*imm + imm2

(const OP-ADDI 83)  ; (ptr) ptr + imm

(const OP-MEMCPY 84)  ; (dst, src) imm = bytes

(const OP-MEMZERO 85)  ; (dst) imm = bytes

(const OP-DYNALLOCA 86)  ; (bytes) imm = align

(const OP-ATOMIC-RMW 87)  ; (ptr, val) imm = op, imm2 = bytes

(const OP-CMPXCHG 88)  ; (ptr, expected, desired) imm2 = bytes; result old value

(const OP-ATOMIC-LOAD 89)  ; (ptr) imm2 = bytes

(const OP-ATOMIC-STORE 90)  ; (ptr, val) imm2 = bytes

(const OP-FENCE 91)

(const OP-MEMCPYV 92)  ; (dst, src, bytes)

(const OP-MEMMOVEV 93)  ; (dst, src, bytes)

(const OP-MEMSETV 94)  ; (dst, byte, bytes)

(const OP-VLOAD-LANE 95)

; calls
(const OP-CALL 100)  ; imm = symbol or -1 (operand 0 is the callee); args follow

(const OP-RET 101)  ; operands = returned values, in register order

(const OP-TAILCALL 102)

(const OP-MACHINE 103)  ; inline bytes: imm = index into the byte pool

;; A call under a register-pinned convention: argument i in register
;; argflags[i]; imm = symbol (-1: inline bytes `block`..`block+next` of the byte
;; pool), imm2 = clobbered-register mask, aux = result register (255: none).
(const OP-SHIMCALL 104)

; control
(const OP-BR 110)

(const OP-CONDBR 111)  ; (cond) then, else

(const OP-SWITCH 112)  ; (value) default, cases...; imm = first case in `case-values`

(const OP-UNREACHABLE 113)

(const OP-PHI 114)

; integer compare predicates
(const P-EQ 0)

(const P-NE 1)

(const P-SLT 2)

(const P-SLE 3)

(const P-SGT 4)

(const P-SGE 5)

(const P-ULT 6)

(const P-ULE 7)

(const P-UGT 8)

(const P-UGE 9)

; float predicates
(const F-OEQ 0)

(const F-ONE 1)

(const F-OLT 2)

(const F-OLE 3)

(const F-OGT 4)

(const F-OGE 5)

(const F-UNE 6)

(const F-UEQ 7)

(const F-ORD 8)

(const F-UNO 9)

(const F-ULT 10)

(const F-ULE 11)

(const F-UGT 12)

(const F-UGE 13)

; argument flags (for call operands)
(const AF-SEXT 0x80)  ; with the low 7 bits the source width

(const AF-SRET 0x100)

(const AF-VARIADIC 0x200)

(const AF-ZEXT 0x400)

;; a copy of the pointed-to aggregate goes on the stack (System V MEMORY
;; class); its size is in bits 12..31 (the other flag fields do not apply)
(const AF-BYVAL 0x800)

(defn af-byval [(size i64)] (-> u32)
  (| (: 0x800 u32) (<< (cast u32 size) (: 12 u32))))

(defn af-byval-size [(flags u32)] (-> u32)
  (>> flags (: 12 u32)))

(defn af-byval? [(flags u32)] (-> bool)
  (!= (& flags (: 0x800 u32)) (: 0 u32)))

;; System V: this part and the next (a group of two) are in different register
;; banks, one GP and one XMM; both must be free or both go on the stack
(const AF-MIXED 0x1000)

;; bits 24..26: log2 of an integer argument's C size plus one (Apple lays
;; stack arguments out at that size); 0 for the part's own size
(defn af-size [(bytes i64)] (-> u32)
  (cond (= bytes 1) (: 0x1000000 u32)
        (= bytes 2) (: 0x2000000 u32)
        (= bytes 4) (: 0x3000000 u32)
        :else (: 0 u32)))

; bits 16..23: how many following arguments must stay in consecutive registers

(defstruct Value
  [(op u8)
   (ty u8)
   (flags u8)
   (aux u8)
   ; value operands; block operands (terminators, PHIs) follow them
   (nops u32)
   (ntotal u32)
   (opb u32)
   (imm i64)
   (imm2 i64)
   ; PHIs: the block; others: unused
   (block u32)
   ; PHIs: next PHI of the block (before `finish!`)
   (next u32)])

(defstruct Block
  [(ibegin u32)
   (iend u32)
   (phi-first u32)
   (phi-begin u32)
   (phi-count u32)
   (term u32)
   (pred-first u32)
   (npred u32)
   (sealed bool)
   (info u32)
   (info2 u32)])

(defstruct Edge [(from u32) (next u32)])

;; A PHI created in an unsealed block, completed when the block is sealed.
(defstruct IncompletePhi [(block u32) (var u32) (phi u32)])

(defstruct VarDef [(block u32) (value u32)])

;;; A slot of the (variable, block) -> definition table. A slot is live only
;;; when its `gen` is the function's: starting a function bumps the generation
;;; instead of zeroing the table, which only ever grows to the largest function.
(defstruct DefSlot [(key u64) (value u32) (gen u32)])

(defstruct Func
  [(name (slice u8))
   (values (ArrayList Value))
   (operands (ArrayList u32))
   (argflags (ArrayList u32))
   (insts (ArrayList u32))
   (blocks (ArrayList Block))
   (edges (ArrayList Edge))
   (args (ArrayList u32))
   (arg-sret (ArrayList bool))
   (arg-flags (ArrayList u32))
   (allocas (ArrayList u32))
   (phis (ArrayList u32))
   (case-values (ArrayList u64))
   (fwd (ArrayList u32))
   (bytes (ArrayList u8))
   (cur u32)
   (has-calls bool)
   (has-tail-calls bool)
   (has-dynamic-alloca bool)
   ; the address of a stack slot escaped: no pointer-argument tail calls
   (frame-escapes bool)
   ; ---- SSA construction
   (var-types (ArrayList u8))
   (last-def (ArrayList VarDef))
   (def-slots (ArrayList DefSlot))
   (def-gen u32)
   (def-count i64)
   (incomplete (ArrayList IncompletePhi))
   (undef-i64 u32)
   ; i64 constants -16..47 already made in this function (constants are
   ; materialized at each use, so one value serves every use)
   (small-consts (ArrayList u32))
   ; drop-dead!'s use counts and spare instruction list
   (scratch-uses (ArrayList u32))
   (scratch-insts (ArrayList u32))
   ; ---- debug info: each value's source position (`cur-loc` when it was
   ; made; 0 for none), and how many debug marks the function has
   (locs (ArrayList u64))
   (cur-loc u64)
   ; debug marks (dbg-mark!): mark id -> the instruction it precedes (NONE if
   ; none followed), and how many marks wait for the next instruction
   (mark-insts (ArrayList u32))
   (pending-marks u32)])

(defn none [] (-> u32)
  (: 0xFFFFFFFF u32))

(defn i64-of [(x u32)] (-> i64)
  (cast i64 x))

(defn u32-of [(x i64)] (-> u32)
  (cast u32 x))

(impl Func
  (new [] (-> Func)
    (let [a (malloc-allocator)]
      (Func
        :name ""
        :values (ArrayList::new [Value] a)
        :operands (ArrayList::new [u32] a)
        :argflags (ArrayList::new [u32] a)
        :insts (ArrayList::new [u32] a)
        :blocks (ArrayList::new [Block] a)
        :edges (ArrayList::new [Edge] a)
        :args (ArrayList::new [u32] a)
        :arg-sret (ArrayList::new [bool] a)
        :arg-flags (ArrayList::new [u32] a)
        :allocas (ArrayList::new [u32] a)
        :phis (ArrayList::new [u32] a)
        :case-values (ArrayList::new [u64] a)
        :fwd (ArrayList::new [u32] a)
        :bytes (ArrayList::new [u8] a)
        :cur (none)
        :has-calls false
        :has-tail-calls false
        :has-dynamic-alloca false
        :frame-escapes false
        :var-types (ArrayList::new [u8] a)
        :last-def (ArrayList::new [VarDef] a)
        :def-slots (ArrayList::new [DefSlot] a)
        :def-gen (: 1 u32)
        :def-count 0
        :incomplete (ArrayList::new [IncompletePhi] a)
        :undef-i64 (none)
        :small-consts
          (let [(mut xs) (ArrayList::new [u32] a)]
            (for _ (range 0 64) (push! (mut xs) (none)))
            xs)
        :scratch-uses (ArrayList::new [u32] a)
        :scratch-insts (ArrayList::new [u32] a)
        :locs (ArrayList::new [u64] a)
        :cur-loc (: 0 u64)
        :mark-insts (ArrayList::new [u32] a)
        :pending-marks (: 0 u32)))))

;;; Release the function's storage (it is not used again).
(defn func-free! [(f (ptr Func))] (-> void)
  (free! (mut (.values f)))
  (free! (mut (.operands f)))
  (free! (mut (.argflags f)))
  (free! (mut (.insts f)))
  (free! (mut (.blocks f)))
  (free! (mut (.edges f)))
  (free! (mut (.args f)))
  (free! (mut (.arg-sret f)))
  (free! (mut (.arg-flags f)))
  (free! (mut (.allocas f)))
  (free! (mut (.phis f)))
  (free! (mut (.case-values f)))
  (free! (mut (.fwd f)))
  (free! (mut (.bytes f)))
  (free! (mut (.var-types f)))
  (free! (mut (.last-def f)))
  (free! (mut (.def-slots f)))
  (free! (mut (.incomplete f)))
  (free! (mut (.small-consts f)))
  (free! (mut (.scratch-uses f)))
  (free! (mut (.scratch-insts f)))
  (free! (mut (.locs f)))
  (free! (mut (.mark-insts f))))

;;; Start a new function (keeps the storage).
(defn reset! [(f (ptr Func)) (name (slice u8))] (-> void)
  (set! (.name f) name)
  (clear! (mut (.values f)))
  (clear! (mut (.operands f)))
  (clear! (mut (.argflags f)))
  (clear! (mut (.insts f)))
  (clear! (mut (.blocks f)))
  (clear! (mut (.edges f)))
  (clear! (mut (.args f)))
  (clear! (mut (.arg-sret f)))
  (clear! (mut (.arg-flags f)))
  (clear! (mut (.allocas f)))
  (clear! (mut (.locs f)))
  (set! (.cur-loc f) (: 0 u64))
  (clear! (mut (.mark-insts f)))
  (set! (.pending-marks f) (: 0 u32))
  (clear! (mut (.phis f)))
  (clear! (mut (.case-values f)))
  (clear! (mut (.fwd f)))
  (clear! (mut (.bytes f)))
  (clear! (mut (.var-types f)))
  (clear! (mut (.last-def f)))
  (defs-reset! f)
  (clear! (mut (.incomplete f)))
  (set! (.cur f) (none))
  (set! (.has-calls f) false)
  (set! (.has-tail-calls f) false)
  (set! (.has-dynamic-alloca f) false)
  (set! (.frame-escapes f) false)
  (set! (.undef-i64 f) (none))
  (for i (range 0 64) (set! (mut (.small-consts f)) i (none))))

(defn val [(f (ptr Func)) (v u32)] (-> (ptr Value))
  (elem (mut (.values f)) (i64-of v)))

; ---- frame escapes ----
; Value.flags bit 2: the value is the address of (or into) this frame. If one
; reaches a call argument, a stored value, a return or a variable, the frame
; escapes, and pointer-argument tail calls are demoted (LLVM's musttail rule).
(defn frame-derived? [(f (ptr Func)) (v u32)] (-> bool)
  (!= (& (.flags (val f v)) (: 4 u8)) (: 0 u8)))

(defn mark-frame-derived! [(f (ptr Func)) (v u32)] (-> void)
  (set! (.flags (val f v)) (| (.flags (val f v)) (: 4 u8))))

(defn note-escape! [(f (ptr Func)) (v u32)] (-> void)
  (when (frame-derived? f v) (set! (.frame-escapes f) true)))

(defn blk [(f (ptr Func)) (b u32)] (-> (ptr Block))
  (elem (mut (.blocks f)) (i64-of b)))

(defn value-count [(f (ptr Func))] (-> u32)
  (u32-of (len (.values f))))

(defn block-count [(f (ptr Func))] (-> u32)
  (u32-of (len (.blocks f))))

(defn operand [(f (ptr Func)) (v (ptr Value)) (i u32)] (-> u32)
  (get (.operands f) (i64-of (+ (.opb v) i))))

(defn push-value! [(f (ptr Func)) (op i64) (ty i64) (imm i64) (imm2 i64)]
  (-> u32)
  (let [id (value-count f)]
    (push! (mut (.values f))
           (Value
             :op (cast u8 op)
             :ty (cast u8 ty)
             :flags (: 0 u8)
             :aux (: 0 u8)
             :nops (: 0 u32)
             :ntotal (: 0 u32)
             :opb (u32-of (len (.operands f)))
             :imm imm
             :imm2 imm2
             :block (none)
             :next (none)))
    (push! (mut (.fwd f)) (none))
    (push! (mut (.locs f)) (.cur-loc f))
    id))

;;; The source position the instructions made from here on belong to (an
;;; opaque nonzero number the client decodes; 0 for none).
(defn set-loc! [(f (ptr Func)) (loc u64)] (-> void)
  (set! (.cur-loc f) loc))

;;; A debug mark here (where a variable comes into scope, say): it marks the
;;; next instruction, whose code offset the compiler records (Value.flags bit
;;; 5, Compiler.dbg-marks). Returns its id. No instruction is added.
(defn dbg-mark! [(f (ptr Func))] (-> u32)
  (let [id (u32-of (len (.mark-insts f)))]
    (push! (mut (.mark-insts f)) (none))
    (set! (.pending-marks f) (+ (.pending-marks f) (: 1 u32)))
    id))

(defn nmarks [(f (ptr Func))] (-> i64)
  (len (.mark-insts f)))

;;; Whether instruction `v` carries debug marks.
(defn dbg-marked? [(f (ptr Func)) (v u32)] (-> bool)
  (!= (& (.flags (val f v)) (: 0x20 u8)) (: 0 u8)))

(defn push-operand! [(f (ptr Func)) (x u32) (flags u32)] (-> void)
  (push! (mut (.operands f)) x)
  (push! (mut (.argflags f)) flags))

; ---- values without instructions ----

(defn const! [(f (ptr Func)) (ty i64) (lo u64) (hi u64)] (-> u32)
  (push-value! f OP-CONST ty (cast i64 lo) (cast i64 hi)))

(defn iconst! [(f (ptr Func)) (v i64)] (-> u32)
  (if (and (>= v -16) (< v 48))
      (let [have (get (.small-consts f) (+ v 16))]
        (if (!= have (none))
            have
            (let [c (push-value! f OP-CONST T-I64 v 0)]
              (set! (mut (.small-consts f)) (+ v 16) c)
              c)))
      (push-value! f OP-CONST T-I64 v 0)))

(defn sym! [(f (ptr Func)) (sym u32) (addend i64)] (-> u32)
  (push-value! f OP-SYM T-I64 (i64-of sym) addend))

(defn arg! [(f (ptr Func)) (ty i64) (sret bool)] (-> u32)
  (arg-flagged! f ty sret (: 0 u32)))

;;; An argument with flags (see the AF-… constants and bits 16..23).
(defn arg-flagged! [(f (ptr Func)) (ty i64) (sret bool) (flags u32)] (-> u32)
  (let [v (push-value! f OP-ARG ty (len (.args f)) 0)]
    (push! (mut (.args f)) v)
    (push! (mut (.arg-sret f)) sret)
    (push! (mut (.arg-flags f)) flags)
    v))

;;; A stack slot of `size` bytes; its value is the slot's address.
;;; A static stack slot; its `next` is its ordinal in `allocas`.
(defn alloca! [(f (ptr Func)) (size i64) (align i64)] (-> u32)
  (let [v
          (push-value! f
                       OP-ALLOCA
                       T-I64
                       (if (< size 1) 1 size)
                       (if (< align 1) 1 align))]
    (set! (.next (val f v)) (u32-of (len (.allocas f))))
    (push! (mut (.allocas f)) v)
    (mark-frame-derived! f v)
    v))

; ---- blocks ----

(defn new-block! [(f (ptr Func))] (-> u32)
  (let [b (block-count f)]
    (push! (mut (.blocks f))
           (Block
             :ibegin (: 0 u32)
             :iend (: 0 u32)
             :phi-first (none)
             :phi-begin (: 0 u32)
             :phi-count (: 0 u32)
             :term (none)
             :pred-first (none)
             :npred (: 0 u32)
             :sealed false
             :info (: 0 u32)
             :info2 (: 0 u32)))
    b))

;;; Make `b` the block instructions go to. The previous block must be terminated.
(defn set-block! [(f (ptr Func)) (b u32)] (-> void)
  (set! (.cur f) b)
  (let [bb (blk f b)
        at (u32-of (len (.insts f)))]
    (set! (.ibegin bb) at)
    (set! (.iend bb) at)))

(defn cur-block [(f (ptr Func))] (-> u32)
  (.cur f))

(defn terminated? [(f (ptr Func))] (-> bool)
  (or (= (.cur f) (none)) (!= (.term (blk f (.cur f))) (none))))

(defn add-edge! [(f (ptr Func)) (from u32) (to u32)] (-> void)
  (let [e (u32-of (len (.edges f)))
        tb (blk f to)]
    (push! (mut (.edges f)) (Edge :from from :next (.pred-first tb)))
    (set! (.pred-first tb) e)
    (set! (.npred tb) (+ (.npred tb) (: 1 u32)))))

; ---- instructions ----

(defn inst! [(f (ptr Func)) (op i64) (ty i64) (imm i64) (imm2 i64)] (-> u32)
  (let [v (push-value! f op ty imm imm2)]
    (push! (mut (.insts f)) v)
    (set! (.iend (blk f (.cur f))) (u32-of (len (.insts f))))
    (when (> (.pending-marks f) (: 0 u32))
      (let [n (len (.mark-insts f))]
        (for k (range (- n (i64-of (.pending-marks f))) n)
          (set! (mut (.mark-insts f)) k v)))
      (set! (.flags (val f v)) (| (.flags (val f v)) (: 0x20 u8)))
      (set! (.pending-marks f) (: 0 u32)))
    v))

(defn set-ops! [(f (ptr Func)) (v u32) (nops u32) (ntotal u32)] (-> void)
  (let [x (val f v)]
    (set! (.nops x) nops)
    (set! (.ntotal x) ntotal)))

(defn op0! [(f (ptr Func)) (op i64) (ty i64) (imm i64) (imm2 i64)] (-> u32)
  (inst! f op ty imm imm2))

(defn op1! [(f (ptr Func)) (op i64) (ty i64) (a u32) (imm i64) (imm2 i64)]
  (-> u32)
  (let [x (val f a)]
    ; an i64 constant extended within i64 is a constant
    (if (and (or (= op OP-SEXT) (= op OP-ZEXT))
             (= ty T-I64)
             (= (cast i64 (.op x)) OP-CONST)
             (= (cast i64 (.ty x)) T-I64)
             (> imm 0)
             (< imm 64))
        (let [sh (- 64 imm)
              c
                (if (= op OP-SEXT)
                    (>> (<< (.imm x) sh) sh)
                    (cast i64
                          (>> (<< (cast u64 (.imm x)) (cast u64 sh))
                              (cast u64 sh))))]
          (iconst! f c))
        (op1-inst! f op ty a imm imm2))))

(defn op1-inst! [(f (ptr Func)) (op i64) (ty i64) (a u32) (imm i64) (imm2 i64)]
  (-> u32)
  (let [v (inst! f op ty imm imm2)]
    (push-operand! f a (: 0 u32))
    (set-ops! f v (: 1 u32) (: 1 u32))
    (when (or (= op OP-DYNALLOCA)
              (and (or (= op OP-ADDI) (= op OP-COPY)) (frame-derived? f a)))
      (mark-frame-derived! f v))
    v))

(defn op2! [(f (ptr Func))
            (op i64)
            (ty i64)
            (a u32)
            (b u32)
            (imm i64)
            (imm2 i64)] (-> u32)
  (let [v (inst! f op ty imm imm2)]
    (push-operand! f a (: 0 u32))
    (push-operand! f b (: 0 u32))
    (set-ops! f v (: 2 u32) (: 2 u32))
    (cond (and (or (= op OP-PTRADD)
                   (= op OP-ADD)
                   (= op OP-SUB)
                   (= op OP-OR)
                   (= op OP-AND))
               (or (frame-derived? f a) (frame-derived? f b)))
            (mark-frame-derived! f v)
          ; a stored pointer to this frame escapes
          (= op OP-STORE) (note-escape! f b)
          (or (= op OP-ATOMIC-STORE) (= op OP-ATOMIC-RMW)) (note-escape! f b)
          :else 0)
    v))

(defn op3! [(f (ptr Func))
            (op i64)
            (ty i64)
            (a u32)
            (b u32)
            (c u32)
            (imm i64)
            (imm2 i64)] (-> u32)
  (let [v (inst! f op ty imm imm2)]
    (push-operand! f a (: 0 u32))
    (push-operand! f b (: 0 u32))
    (push-operand! f c (: 0 u32))
    (set-ops! f v (: 3 u32) (: 3 u32))
    (when (and (= op OP-SELECT) (or (frame-derived? f b) (frame-derived? f c)))
      (mark-frame-derived! f v))
    (when (= op OP-CMPXCHG) (note-escape! f c))
    v))

;;; The base of address `p` once the constant offsets of ADDIs are folded into
;;; the access's own (`addr-off` gives the total): `ldr x, [base, #off]`
;;; instead of an add before every field access. An ADDI left without uses is
;;; dropped by `finish!`.
(defn addr-base [(f (ptr Func)) (p u32)] (-> u32)
  (let [(mut b) p]
    (while (= (cast i64 (.op (val f b))) OP-ADDI)
      (set! b (operand f (val f b) (: 0 u32))))
    b))

(defn addr-off [(f (ptr Func)) (p u32) (off i64)] (-> i64)
  (let [(mut b) p
        (mut o) off]
    (while (= (cast i64 (.op (val f b))) OP-ADDI)
      (set! o (+ o (.imm (val f b))))
      (set! b (operand f (val f b) (: 0 u32))))
    o))

(defn load-mem! [(f (ptr Func))
                 (ty i64)
                 (p u32)
                 (off i64)
                 (bytes i64)
                 (signed bool)] (-> u32)
  (op1! f
        OP-LOAD
        ty
        (addr-base f p)
        (addr-off f p off)
        (| bytes (if signed 256 0))))

(defn store-mem! [(f (ptr Func)) (p u32) (v u32) (off i64) (bytes i64)] (-> u32)
  (op2! f OP-STORE T-VOID (addr-base f p) v (addr-off f p off) bytes))

(defn addi! [(f (ptr Func)) (p u32) (off i64)] (-> u32)
  (if (= off 0) p (op1! f OP-ADDI T-I64 p off 0)))

;;; Terminators.
(defn br! [(f (ptr Func)) (target u32)] (-> void)
  (let [b (.cur f)
        v (inst! f OP-BR T-VOID 0 0)]
    (push-operand! f target (: 0 u32))
    (set-ops! f v (: 0 u32) (: 1 u32))
    (set! (.term (blk f b)) v)
    (add-edge! f b target)))

(defn condbr! [(f (ptr Func)) (c u32) (t u32) (e u32)] (-> void)
  (let [b (.cur f)
        v (inst! f OP-CONDBR T-VOID 0 0)]
    (push-operand! f c (: 0 u32))
    (push-operand! f t (: 0 u32))
    (push-operand! f e (: 0 u32))
    (set-ops! f v (: 1 u32) (: 3 u32))
    (set! (.term (blk f b)) v)
    (add-edge! f b t)
    (when (!= t e) (add-edge! f b e))))

;;; A switch on `x` (I64): `values[i]` goes to `targets[i]`, anything else to
;;; `default`. Values must be distinct.
(defn switch! [(f (ptr Func))
               (x u32)
               (default u32)
               (values (ptr (ArrayList u64)))
               (targets (ptr (ArrayList u32)))] (-> void)
  (let [b (.cur f)
        n (len (load values))
        v (inst! f OP-SWITCH T-VOID (len (.case-values f)) 0)]
    (push-operand! f x (: 0 u32))
    (push-operand! f default (: 0 u32))
    (for i (range 0 n)
      (push! (mut (.case-values f)) (get (load values) i))
      (push-operand! f (get (load targets) i) (: 0 u32)))
    (set-ops! f v (: 1 u32) (u32-of (+ n 2)))
    (set! (.term (blk f b)) v)
    ; one edge per distinct target
    (add-edge! f b default)
    (for i (range 0 n)
      (let [t (get (load targets) i)
            (mut seen) (= t default)]
        (for j (range 0 i) (when (= (get (load targets) j) t) (set! seen true)))
        (when (not seen) (add-edge! f b t))))))

(defn ret! [(f (ptr Func)) (vals (ptr (ArrayList u32)))] (-> void)
  (let [b (.cur f)
        n (len (load vals))
        v (inst! f OP-RET T-VOID 0 0)]
    (for i (range 0 n)
      (note-escape! f (get (load vals) i))
      (push-operand! f (get (load vals) i) (: 0 u32)))
    (set-ops! f v (u32-of n) (u32-of n))
    (set! (.term (blk f b)) v)))

(defn ret0! [(f (ptr Func))] (-> void)
  (let [b (.cur f)
        v (inst! f OP-RET T-VOID 0 0)]
    (set! (.term (blk f b)) v)))

(defn ret1! [(f (ptr Func)) (x u32)] (-> void)
  (note-escape! f x)
  (let [b (.cur f)
        v (inst! f OP-RET T-VOID 0 0)]
    (push-operand! f x (: 0 u32))
    (set-ops! f v (: 1 u32) (: 1 u32))
    (set! (.term (blk f b)) v)))

(defn unreachable! [(f (ptr Func))] (-> void)
  (let [b (.cur f)
        v (inst! f OP-UNREACHABLE T-VOID 0 0)]
    (set! (.term (blk f b)) v)))

; ---- calls ----

;;; A call: `target` is a symbol, or NONE with `callee` the pointer. `args` and
;;; `flags` are parallel. Results beyond the first become OP-CALLRES values;
;;; returns the call (its first result).
(defn call! [(f (ptr Func))
             (target u32)
             (callee u32)
             (args (ptr (ArrayList u32)))
             (flags (ptr (ArrayList u32)))
             (rtypes (ptr (ArrayList u8)))
             (tail bool)] (-> u32)
  ; nothing is live across a tail call, so it does not make the function a
  ; non-leaf (which would put its values in callee-saved registers); one that
  ; compiles as an ordinary call evicts what it clobbers like any call
  (if tail (set! (.has-tail-calls f) true) (set! (.has-calls f) true))
  (let [nr (len (load rtypes))
        rty (if (> nr 0) (cast i64 (get (load rtypes) 0)) T-VOID)
        v
          (inst! f
                 (if tail OP-TAILCALL OP-CALL)
                 rty
                 (if (= target (none)) -1 (i64-of target))
                 0)
        n (len (load args))]
    (when (!= callee (none)) (push-operand! f callee (: 0 u32)))
    (for i (range 0 n)
      (note-escape! f (get (load args) i))
      (push-operand! f (get (load args) i) (get (load flags) i)))
    (let [nops (+ (u32-of n) (if (= callee (none)) (: 0 u32) (: 1 u32)))]
      (set-ops! f v nops nops))
    (set! (.aux (val f v)) (cast u8 nr))
    (for i (range 1 nr)
      (let [r
              (push-value! f
                           OP-CALLRES
                           (cast i64 (get (load rtypes) i))
                           (- i 1)
                           0)]
        (set! (.block (val f r)) v)))
    (when tail (set! (.term (blk f (.cur f))) v))
    v))

;;; A call under a :shim convention (see OP-SHIMCALL).
(defn shimcall! [(f (ptr Func))
                 (target u32)
                 (args (ptr (ArrayList u32)))
                 (regs (ptr (ArrayList u32)))
                 (ret-reg u32)
                 (clobber u64)
                 (bytes (slice u8))
                 (rty i64)] (-> u32)
  (set! (.has-calls f) true)
  (let [v
          (inst! f
                 OP-SHIMCALL
                 rty
                 (if (= target (none)) -1 (i64-of target))
                 (cast i64 clobber))
        n (len (load args))]
    (for i (range 0 n)
      (note-escape! f (get (load args) i))
      (push-operand! f (get (load args) i) (get (load regs) i)))
    (set-ops! f v (u32-of n) (u32-of n))
    (let [x (val f v)]
      (set! (.aux x) (cast u8 ret-reg))
      (set! (.block x) (u32-of (len (.bytes f))))
      (set! (.next x) (u32-of (len bytes))))
    (for i (range 0 (len bytes)) (push! (mut (.bytes f)) (get bytes i)))
    v))

;;; The i-th result of a call (0 is the call itself).
(defn call-result [(f (ptr Func)) (call u32) (i i64)] (-> u32)
  (if (= i 0) call (+ call (u32-of i))))

; ============================ SSA construction ==============================

;;; A new variable of type `ty`.
(defn new-var! [(f (ptr Func)) (ty i64)] (-> u32)
  (let [v (u32-of (len (.var-types f)))]
    (push! (mut (.var-types f)) (cast u8 ty))
    (push! (mut (.last-def f)) (VarDef :block (none) :value (none)))
    v))

(defn def-key [(var u32) (block u32)] (-> u64)
  (| (<< (cast u64 var) (: 32 u64)) (cast u64 block)))

;; ---- the definition table (open addressing, linear probing) ----

(defn defs-reset! [(f (ptr Func))] (-> void)
  (set! (.def-count f) 0)
  (set! (.def-gen f) (+ (.def-gen f) (: 1 u32)))
  (when (= (.def-gen f) (: 0 u32))
    ; the generation wrapped: stale slots could look live again
    (for i (range 0 (len (.def-slots f)))
      (set! (.gen (elem (mut (.def-slots f)) i)) (: 0 u32)))
    (set! (.def-gen f) (: 1 u32))))

(defn defs-home [(f (ptr Func)) (k u64)] (-> i64)
  (let [h (* k (: 0x9E3779B97F4A7C15 u64))]
    (& (cast i64 (>> h (: 32 u64))) (- (len (.def-slots f)) 1))))

(defn defs-put! [(f (ptr Func)) (k u64) (v u32)] (-> void)
  (let [gen (.def-gen f)
        mask (- (len (.def-slots f)) 1)
        (mut i) (defs-home f k)]
    (while (and (= (.gen (get (.def-slots f) i)) gen)
                (!= (.key (get (.def-slots f) i)) k))
      (set! i (& (+ i 1) mask)))
    (let [sl (elem (mut (.def-slots f)) i)]
      (when (!= (.gen sl) gen) (set! (.def-count f) (+ (.def-count f) 1)))
      (set! (.key sl) k)
      (set! (.value sl) v)
      (set! (.gen sl) gen))))

(defn defs-grow! [(f (ptr Func))] (-> void)
  (let [gen (.def-gen f)
        old (len (.def-slots f))
        (mut live) (ArrayList::new [DefSlot] (malloc-allocator))]
    (for i (range 0 old)
      (let [sl (get (.def-slots f) i)]
        (when (= (.gen sl) gen) (push! (mut live) sl))))
    (extend-zeroed! (mut (.def-slots f)) (if (= old 0) 64 old))
    (for i (range 0 (len (.def-slots f)))
      (set! (.gen (elem (mut (.def-slots f)) i)) (: 0 u32)))
    (set! (.def-count f) 0)
    (for i (range 0 (len live))
      (let [sl (get live i)] (defs-put! f (.key sl) (.value sl))))
    (free! (mut live))))

(defn defs-set! [(f (ptr Func)) (k u64) (v u32)] (-> void)
  (when (>= (* (+ (.def-count f) 1) 2) (len (.def-slots f))) (defs-grow! f))
  (defs-put! f k v))

(defn defs-get [(f (ptr Func)) (k u64)] (-> u32)
  (if (= (len (.def-slots f)) 0)
      (none)
      (let [gen (.def-gen f)
            mask (- (len (.def-slots f)) 1)
            (mut i) (defs-home f k)]
        (block :found
          (while (= (.gen (get (.def-slots f) i)) gen)
            (when (= (.key (get (.def-slots f) i)) k)
              (return-from :found (.value (get (.def-slots f) i))))
            (set! i (& (+ i 1) mask)))
          (none)))))

(defn write-var! [(f (ptr Func)) (var u32) (block u32) (v u32)] (-> void)
  (let [ld (elem (mut (.last-def f)) (i64-of var))]
    (when (and (!= (.block ld) (none)) (!= (.block ld) block))
      ; the cache moves on: keep the old definition in the map
      (defs-set! f (def-key var (.block ld)) (.value ld)))
    (set! (.block ld) block)
    (set! (.value ld) v)))

(defn def-var! [(f (ptr Func)) (var u32) (v u32)] (-> void)
  (note-escape! f v)
  (write-var! f var (.cur f) v))

(defn lookup-def [(f (ptr Func)) (var u32) (block u32)] (-> u32)
  (let [ld (get (.last-def f) (i64-of var))]
    (if (= (.block ld) block)
        (.value ld)
        (defs-get f (def-key var block)))))

(defn new-phi! [(f (ptr Func)) (block u32) (ty i64)] (-> u32)
  (let [v (push-value! f OP-PHI ty 0 0)
        bb (blk f block)
        x (val f v)]
    (set! (.block x) block)
    (set! (.next x) (.phi-first bb))
    (set! (.phi-first bb) v)
    v))

(defn resolve [(f (ptr Func)) (v0 u32)] (-> u32)
  (let [(mut v) v0]
    (while (!= (get (.fwd f) (i64-of v)) (none))
      (set! v (get (.fwd f) (i64-of v))))
    v))

(defn undef! [(f (ptr Func)) (ty i64)] (-> u32)
  (cond (= ty T-I128) (const! f T-I128 (: 0 u64) (: 0 u64))
        (= ty T-F32) (const! f T-F32 (: 0 u64) (: 0 u64))
        (= ty T-F64) (const! f T-F64 (: 0 u64) (: 0 u64))
        (= ty T-V128) (const! f T-V128 (: 0 u64) (: 0 u64))
        :else (iconst! f 0)))

;; Whether the PHI's operands are all itself or one other value; forwards it then.
(defn try-remove-trivial-phi! [(f (ptr Func)) (phi u32)] (-> u32)
  (let [x (val f phi)
        n (.nops x)
        (mut same) (none)
        (mut trivial) true]
    (for i (range 0 (i64-of n))
      (let [op (resolve f (operand f x (u32-of i)))]
        (when (and trivial (!= op phi) (!= op same))
          (if (!= same (none))
              (set! trivial false)
              (set! same op)))))
    (if (not trivial)
        phi
        (let [s
                (if (= same (none))
                    (undef! f (cast i64 (.ty (val f phi))))
                    same)]
          (set! (mut (.fwd f)) (i64-of phi) s)
          s))))

(defn add-phi-operands! [(f (ptr Func)) (var u32) (phi u32)] (-> u32)
  (let [block (.block (val f phi))
        bb (load (blk f block))
        n (.npred bb)
        opb (u32-of (len (.operands f)))]
    ; reserve 2n slots: values, then blocks
    (for _ (range 0 (* 2 (i64-of n))) (push-operand! f (: 0 u32) (: 0 u32)))
    (let [x (val f phi)]
      (set! (.opb x) opb)
      (set! (.nops x) n)
      (set! (.ntotal x) (* (: 2 u32) n)))
    (let [(mut e) (.pred-first bb)
          (mut i) (: 0 u32)]
      (while (!= e (none))
        (let [edge (get (.edges f) (i64-of e))
              v (read-var! f var (.from edge))]
          (set! (mut (.operands f)) (i64-of (+ opb i)) v)
          (set! (mut (.operands f)) (i64-of (+ (+ opb n) i)) (.from edge))
          (set! i (+ i (: 1 u32)))
          (set! e (.next edge)))))
    (try-remove-trivial-phi! f phi)))

(defn read-var-recursive! [(f (ptr Func)) (var u32) (block u32)] (-> u32)
  (let [bb (load (blk f block))
        ty (cast i64 (get (.var-types f) (i64-of var)))
        v
          (cond (not (.sealed bb))
                  (let [phi (new-phi! f block ty)]
                    (push! (mut (.incomplete f))
                           (IncompletePhi
                             :block block
                             :var var
                             :phi phi))
                    phi)
                (= (.npred bb) (: 1 u32))
                  (read-var! f
                             var
                             (.from (get (.edges f) (i64-of (.pred-first bb)))))
                (= (.npred bb) (: 0 u32)) (undef! f ty)
                :else
                  (let [phi (new-phi! f block ty)]
                    (write-var! f var block phi)
                    (add-phi-operands! f var phi)))]
    (write-var! f var block v)
    v))

(defn read-var! [(f (ptr Func)) (var u32) (block u32)] (-> u32)
  (let [d (lookup-def f var block)]
    (if (!= d (none)) (resolve f d) (read-var-recursive! f var block))))

;;; The current value of `var` in the current block.
(defn use-var! [(f (ptr Func)) (var u32)] (-> u32)
  (read-var! f var (.cur f)))

;;; All predecessors of `b` are known.
(defn seal! [(f (ptr Func)) (b u32)] (-> void)
  (when (not (.sealed (blk f b)))
    (let [(mut i) 0]
      (while (< i (len (.incomplete f)))
        (let [ip (get (.incomplete f) i)]
          (if (= (.block ip) b)
              (do
                (add-phi-operands! f (.var ip) (.phi ip))
                (let [last (- (len (.incomplete f)) 1)]
                  (set! (mut (.incomplete f)) i (get (.incomplete f) last))
                  (pop! (mut (.incomplete f)))))
              (set! i (+ i 1))))))
    (set! (.sealed (blk f b)) true)))

;;; Finish construction: seal every block, remove trivial PHIs to a fixpoint,
;;; rewrite operands through forwards and lay out each block's PHIs.
;;; Instructions with no effect besides their result.
(defn pure-op? [(op i64)] (-> bool)
  (or (and (>= op OP-ADD) (<= op OP-ASHR))
      (and (>= op OP-ROTL) (<= op OP-SELECT))
      (and (>= op OP-ADDO) (<= op OP-BITREV))
      (and (>= op OP-FADD) (<= op OP-COPY))
      (= op OP-PTRADD)
      (= op OP-ADDI)))

;;; Remove pure instructions whose results are unused (address arithmetic the
;;; access folded, results lowering computed and dropped), and with them uses
;;; that kept others alive.
;;; Instructions the isel compiles to a call of a runtime function: the
;;; function is not a leaf.
(defn runtime-call-op? [(x (ptr Value))] (-> bool)
  (let [op (cast i64 (.op x))]
    (or (= op OP-MEMCPYV)
        (= op OP-MEMMOVEV)
        (= op OP-MEMSETV)
        (and (>= op OP-SDIV) (<= op OP-UREM) (= (cast i64 (.ty x)) T-I128)))))

(defn drop-dead! [(f (ptr Func))] (-> void)
  (let [nv (len (.values f))
        (mut uses) (.scratch-uses f)]
    (clear! (mut uses))
    (extend-zeroed! (mut uses) nv)
    (for vi (range 0 nv)
      (let [x (val f (u32-of vi))]
        (when (and (!= (cast i64 (.op x)) OP-CONST)
                   (= (get (.fwd f) vi) (none)))
          (for k (range 0 (i64-of (.nops x)))
            (let [o (i64-of (get (.operands f) (+ (i64-of (.opb x)) k)))]
              (set! (mut uses) o (+ (get uses o) (: 1 u32))))))))
    (for i (range 0 (len (.args f)))
      (let [a (i64-of (get (.args f) i))]
        (set! (mut uses) a (+ (get uses a) (: 1 u32)))))
    (for i (range 0 (len (.insts f)))
      (when (runtime-call-op? (val f (get (.insts f) i)))
        (set! (.has-calls f) true)))
    ; newest first: a dead instruction's operands were made before it
    (let [(mut dead) 0
          ni (len (.insts f))
          (mut i) (- ni 1)]
      (while (>= i 0)
        (let [v (get (.insts f) i)
              x (val f v)]
          (when (and (pure-op? (cast i64 (.op x)))
                     (= (get uses (i64-of v)) (: 0 u32)))
            (set! (.flags x) (| (.flags x) (: 8 u8)))
            (set! dead (+ dead 1))
            (for k (range 0 (i64-of (.nops x)))
              (let [o (i64-of (get (.operands f) (+ (i64-of (.opb x)) k)))]
                (set! (mut uses) o (- (get uses o) (: 1 u32)))))))
        (set! i (- i 1)))
      (set! (.scratch-uses f) uses)
      (when (> dead 0)
        ; rebuild `insts` without them, block by block (a block's range need
        ; not follow the previous block's: blocks are made before they are filled)
        ; A dead instruction's debug marks move to the next live one in its
        ; block (a terminator at the latest), recorded as (dead, live) pairs.
        (let [(mut out) (.scratch-insts f)
              (mut moved) (ArrayList::new [u32] (malloc-allocator))]
          (clear! (mut out))
          (for b (range 0 (len (.blocks f)))
            (let [bb (blk f (u32-of b))
                  lo (i64-of (.ibegin bb))
                  hi (i64-of (.iend bb))
                  (mut pending) (len moved)]
              (set! (.ibegin bb) (u32-of (len out)))
              (for j (range lo hi)
                (let [v (get (.insts f) j)
                      x (val f v)]
                  (if (= (& (.flags x) (: 8 u8)) (: 0 u8))
                      (do
                        (push! (mut out) v)
                        (when (< pending (len moved))
                          (set! (.flags x) (| (.flags x) (: 0x20 u8)))
                          (for k (range pending (len moved))
                            (when (= (% k 2) 1) (set! (mut moved) k v)))
                          (set! pending (len moved))))
                      (when (!= (& (.flags x) (: 0x20 u8)) (: 0 u8))
                        (push! (mut moved) v)
                        (push! (mut moved) (none))))))
              (set! (.iend bb) (u32-of (len out)))))
          (when (> (len moved) 0)
            (for m (range 0 (len (.mark-insts f)))
              (let [mv (get (.mark-insts f) m)]
                (for k (range 0 (/ (len moved) 2))
                  (when (= (get moved (* k 2)) mv)
                    (set! (mut (.mark-insts f)) m (get moved (+ (* k 2) 1))))))))
          (free! (mut moved))
          (set! (.scratch-insts f) (.insts f))
          (set! (.insts f) out))))))

;;; Whether the function calls anything, runtime calls its instructions
;;; become included (before finish!, which marks those).
(defn calls-anything? [(f (ptr Func))] (-> bool)
  (or (.has-calls f)
      (let [(mut r) false]
        (for i (range 0 (len (.insts f)))
          (when (runtime-call-op? (val f (get (.insts f) i))) (set! r true)))
        r)))

;;; Remove the stores whose address is alloca `a`, and `a` itself (debug info
;;; dropping a frame only it would need).
(defn drop-alloca! [(f (ptr Func)) (a u32)] (-> void)
  (let [(mut out) (.scratch-insts f)]
    (clear! (mut out))
    (for b (range 0 (len (.blocks f)))
      (let [bb (blk f (u32-of b))
            lo (i64-of (.ibegin bb))
            hi (i64-of (.iend bb))]
        (set! (.ibegin bb) (u32-of (len out)))
        (for j (range lo hi)
          (let [v (get (.insts f) j)
                x (val f v)]
            (unless (and (= (cast i64 (.op x)) OP-STORE)
                         (= (operand f x (: 0 u32)) a))
              (push! (mut out) v))))
        (set! (.iend bb) (u32-of (len out)))))
    (set! (.scratch-insts f) (.insts f))
    (set! (.insts f) out))
  (let [(mut k) 0]
    (for i (range 0 (len (.allocas f)))
      (let [v (get (.allocas f) i)]
        (when (!= v a)
          (set! (.next (val f v)) (u32-of k))
          (set! (mut (.allocas f)) k v)
          (set! k (+ k 1)))))
    (set! (.len (.allocas f)) k)))

(defn finish! [(f (ptr Func))] (-> void)
  (for b (range 0 (len (.blocks f))) (seal! f (u32-of b)))
  ; trivial PHIs: repeat until nothing changes
  (let [(mut changed) true]
    (while changed
      (set! changed false)
      (for b (range 0 (len (.blocks f)))
        (let [(mut p) (.phi-first (blk f (u32-of b)))]
          (while (!= p (none))
            (let [next (.next (val f p))]
              (when (= (get (.fwd f) (i64-of p)) (none))
                (when (!= (try-remove-trivial-phi! f p) p) (set! changed true)))
              (set! p next)))))))
  ; rewrite all value operands through the forwards
  (for vi (range 0 (len (.values f)))
    (let [x (val f (u32-of vi))]
      (for k (range 0 (i64-of (.nops x)))
        (let [at (+ (i64-of (.opb x)) k)
              o (get (.operands f) at)]
          (when (!= (get (.fwd f) (i64-of o)) (none))
            (set! (mut (.operands f)) at (resolve f o)))))))
  (drop-dead! f)
  ; per-block PHI arrays, in creation order
  (clear! (mut (.phis f)))
  (for b (range 0 (len (.blocks f)))
    (let [bb (blk f (u32-of b))
          begin (u32-of (len (.phis f)))]
      (let [(mut p) (.phi-first bb)]
        (while (!= p (none))
          (when (= (get (.fwd f) (i64-of p)) (none)) (push! (mut (.phis f)) p))
          (set! p (.next (val f p)))))
      ; the list was built newest first
      (let [n (- (len (.phis f)) (i64-of begin))]
        (for i (range 0 (/ n 2))
          (let [a (+ (i64-of begin) i)
                z (- (+ (i64-of begin) (- n 1)) i)
                t (get (.phis f) a)]
            (set! (mut (.phis f)) a (get (.phis f) z))
            (set! (mut (.phis f)) z t))))
      (set! (.phi-begin bb) begin)
      (set! (.phi-count bb) (- (u32-of (len (.phis f))) begin)))))
