; Ported to Coil from TPDE (commit 9779acf) and modified; see NOTICE.
;;; The IR adaptor for TIR (TPDE's `TestIRAdaptor`). Every handle is an index:
;;; a function into `funcs`, a block into `blocks`, a value or instruction into
;;; `values`.
(module tpde.tir.adaptor)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "tpde.adaptor" :use [IRAdaptor invalid-ref])
(import "tpde.tir.ir"
        :as
        tir
        :use
        [Tir TirValue TirBlock TirFunc value-at block-at func-at operand-at])

(defstruct TirAdaptor
  [(ir (ptr Tir))
   (cur-func u32)
   (highest-val-idx u32)
   (static-allocas (ArrayList u32))])

(impl TirAdaptor
  (new [(ir (ptr Tir))] (-> TirAdaptor)
    (TirAdaptor
      :ir ir
      :cur-func (: 0 u32)
      :highest-val-idx (: 0 u32)
      :static-allocas (ArrayList::new [u32] (malloc-allocator)))))

(defn cur [(self (ptr TirAdaptor))] (-> (ptr TirFunc))
  (func-at (.ir self) (.cur-func self)))

(defn val [(self (ptr TirAdaptor)) (v u32)] (-> (ptr TirValue))
  (value-at (.ir self) v))

(defn blk [(self (ptr TirAdaptor)) (b u32)] (-> (ptr TirBlock))
  (block-at (.ir self) b))

(impl IRAdaptor TirAdaptor
  (func-count [(self (ptr TirAdaptor))] (-> u32)
    (cast u32 (len (.funcs (.ir self)))))
  (func-at [(self (ptr TirAdaptor)) (i u32)] (-> u32)
    i)
  (func-link-name [(self (ptr TirAdaptor)) (f u32)] (-> (slice u8))
    (.name (func-at (.ir self) f)))
  (func-extern? [(self (ptr TirAdaptor)) (f u32)] (-> bool)
    (.declaration (func-at (.ir self) f)))
  (func-only-local? [(self (ptr TirAdaptor)) (f u32)] (-> bool)
    (.local-only (func-at (.ir self) f)))
  (func-weak? [(self (ptr TirAdaptor)) (f u32)] (-> bool)
    false)
  (switch-func [(self (ptr TirAdaptor)) (f u32)] (-> bool)
    (set! (.cur-func self) f)
    (let [info (func-at (.ir self) f)
          last (blk self (- (.block-end info) (: 1 u32)))
          (mut h) (- (.inst-end last) (.arg-begin info))]
      (when (> h (: 0 u32)) (set! h (- h (: 1 u32))))
      (set! (.highest-val-idx self) h)
      (clear! (mut (.static-allocas self)))
      (let [entry (blk self (.block-begin info))]
        (for v (range (cast i64 (.inst-begin entry))
                      (cast i64 (.inst-end entry)))
          (when (= (.op (val self (cast u32 v))) (: 5 u8))
            (push! (mut (.static-allocas self)) (cast u32 v)))))
      true))

  (cur-highest-val-idx [(self (ptr TirAdaptor))] (-> u32)
    (.highest-val-idx self))
  (liveness-visit-args? [(self (ptr TirAdaptor))] (-> bool)
    true)
  (cur-is-vararg? [(self (ptr TirAdaptor))] (-> bool)
    false)
  (cur-needs-unwind-info? [(self (ptr TirAdaptor))] (-> bool)
    false)
  (cur-arg-count [(self (ptr TirAdaptor))] (-> u32)
    (let [f (cur self)] (- (.arg-end f) (.arg-begin f))))
  (cur-arg [(self (ptr TirAdaptor)) (i u32)] (-> u32)
    (+ (.arg-begin (cur self)) i))
  (cur-arg-byval? [(self (ptr TirAdaptor)) (i u32)] (-> bool)
    false)
  (cur-arg-byval-size [(self (ptr TirAdaptor)) (i u32)] (-> u32)
    (: 0 u32))
  (cur-arg-byval-align [(self (ptr TirAdaptor)) (i u32)] (-> u32)
    (: 0 u32))
  (cur-arg-sret? [(self (ptr TirAdaptor)) (i u32)] (-> bool)
    false)
  (cur-static-alloca-count [(self (ptr TirAdaptor))] (-> u32)
    (cast u32 (len (.static-allocas self))))
  (cur-static-alloca [(self (ptr TirAdaptor)) (i u32)] (-> u32)
    (get (.static-allocas self) (cast i64 i)))
  (cur-has-dynamic-alloca? [(self (ptr TirAdaptor))] (-> bool)
    false)
  (cur-entry-block [(self (ptr TirAdaptor))] (-> u32)
    (.block-begin (cur self)))
  (cur-block-count [(self (ptr TirAdaptor))] (-> u32)
    (let [f (cur self)] (- (.block-end f) (.block-begin f))))
  (cur-block [(self (ptr TirAdaptor)) (i u32)] (-> u32)
    (+ (.block-begin (cur self)) i))

  (block-succ-count [(self (ptr TirAdaptor)) (b u32)] (-> u32)
    (let [info (blk self b)] (- (.succ-end info) (.succ-begin info))))
  (block-succ [(self (ptr TirAdaptor)) (b u32) (i u32)] (-> u32)
    (operand-at (.ir self) (+ (.succ-begin (blk self b)) i)))
  (block-inst-count [(self (ptr TirAdaptor)) (b u32)] (-> u32)
    (let [info (blk self b)] (- (.inst-end info) (.phi-end info))))
  (block-inst [(self (ptr TirAdaptor)) (b u32) (i u32)] (-> u32)
    (+ (.phi-end (blk self b)) i))
  (block-phi-count [(self (ptr TirAdaptor)) (b u32)] (-> u32)
    (let [info (blk self b)] (- (.phi-end info) (.inst-begin info))))
  (block-phi [(self (ptr TirAdaptor)) (b u32) (i u32)] (-> u32)
    (+ (.inst-begin (blk self b)) i))
  (block-info [(self (ptr TirAdaptor)) (b u32)] (-> u32)
    (.info (blk self b)))
  (block-set-info! [(self (ptr TirAdaptor)) (b u32) (v u32)] (-> void)
    (set! (.info (blk self b)) v))
  (block-info2 [(self (ptr TirAdaptor)) (b u32)] (-> u32)
    (.info2 (blk self b)))
  (block-set-info2! [(self (ptr TirAdaptor)) (b u32) (v u32)] (-> void)
    (set! (.info2 (blk self b)) v))
  (block-name [(self (ptr TirAdaptor)) (b u32)] (-> (slice u8))
    (.name (blk self b)))

  (val-local-idx [(self (ptr TirAdaptor)) (v u32)] (-> u32)
    (- v (.arg-begin (cur self))))
  (val-ignore-in-liveness? [(self (ptr TirAdaptor)) (v u32)] (-> bool)
    (= (.op (val self v)) (: 5 u8)))
  (val-phi? [(self (ptr TirAdaptor)) (v u32)] (-> bool)
    (= (.kind (val self v)) (: 2 u8)))
  (val-alloca-size [(self (ptr TirAdaptor)) (v u32)] (-> u32)
    (operand-at (.ir self) (.op-begin (val self v))))
  (val-alloca-align [(self (ptr TirAdaptor)) (v u32)] (-> u32)
    (operand-at (.ir self) (+ (.op-begin (val self v)) (: 1 u32))))
  (val-name [(self (ptr TirAdaptor)) (v u32)] (-> (slice u8))
    (.name (val self v)))

  (phi-incoming-count [(self (ptr TirAdaptor)) (phi u32)] (-> u32)
    (.op-count (val self phi)))
  (phi-incoming-val [(self (ptr TirAdaptor)) (phi u32) (slot u32)] (-> u32)
    (operand-at (.ir self) (+ (.op-begin (val self phi)) slot)))
  (phi-incoming-block [(self (ptr TirAdaptor)) (phi u32) (slot u32)] (-> u32)
    (let [v (val self phi)]
      (operand-at (.ir self) (+ (+ (.op-begin v) (.op-count v)) slot))))
  (phi-incoming-val-for-block [(self (ptr TirAdaptor)) (phi u32) (b u32)]
    (-> u32)
    (let [v (val self phi)
          n (.op-count v)
          base (.op-begin v)]
      (block :found
        (for i (range 0 (cast i64 n))
          (let [slot (cast u32 i)]
            (when (= (operand-at (.ir self) (+ (+ base n) slot)) b)
              (return-from :found (operand-at (.ir self) (+ base slot))))))
        (invalid-ref))))

  (inst-operand-count [(self (ptr TirAdaptor)) (inst u32)] (-> u32)
    (.op-count (val self inst)))
  (inst-operand [(self (ptr TirAdaptor)) (inst u32) (i u32)] (-> u32)
    (operand-at (.ir self) (+ (.op-begin (val self inst)) i)))
  (inst-result-count [(self (ptr TirAdaptor)) (inst u32)] (-> u32)
    (if (tir/op-def? (.op (val self inst))) (: 1 u32) (: 0 u32)))
  (inst-result [(self (ptr TirAdaptor)) (inst u32) (i u32)] (-> u32)
    inst)
  (inst-fused? [(self (ptr TirAdaptor)) (inst u32)] (-> bool)
    false)
  (inst-loc [(self (ptr TirAdaptor)) (inst u32)] (-> u64)
    (: 0 u64))
  (inst-marked? [(self (ptr TirAdaptor)) (inst u32)] (-> bool)
    false)
  (inst-name [(self (ptr TirAdaptor)) (inst u32)] (-> (slice u8))
    (.name (val self inst))))
