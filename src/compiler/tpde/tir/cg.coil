; Ported to Coil from TPDE (commit 9779acf) and modified; see NOTICE.
;;; Code generation for TIR (TPDE's TestIRCompilerA64 and TestIRCompilerX64):
;;; every value is one 8-byte general-purpose part. The x86-64 selection
;;; follows TPDE's instruction for instruction, so that `tpde-check codegen`
;;; can compare it with the C++ reference.
(module tpde.tir.cg)
(import "coil.primitive" :as primitive)
(import "tpde.adaptor" :use [IRAdaptor])
(import "tpde.codegen" :use [IRCompiler])
(import "tpde.core"
        :as
        core
        :use
        [Compiler ValuePart ValueRef Single CCAssignment Scratch Jump])
(import "tpde.a64" :as a64)
(import "tpde.a64.enc" :as e)
(import "tpde.x64" :as x64)
(import "tpde.x64.enc" :as xe)
(import "tpde.asm" :as asm :use [Asm])
(import "tpde.buf" :as buf)
(import "tpde.tir.ir" :as tir :use [Tir TirValue])
(import "tpde.tir.adaptor" :use [TirAdaptor])

(defn tv [(ad (ptr TirAdaptor)) (v u32)] (-> (ptr TirValue))
  (tir/value-at (.ir ad) v))

(defn operand [(ad (ptr TirAdaptor)) (v (ptr TirValue)) (i u32)] (-> u32)
  (tir/operand-at (.ir ad) (+ (.op-begin v) i)))

(defn r5 [(r u8)] (-> u32)
  (& (cast u32 r) (: 31 u32)))

(defn cond-code [(c u32)] (-> u8)
  (case (cast i64 c)
    0 (: 0 u8)
    1 (: 1 u8)
    2 (: 2 u8)
    3 (: 8 u8)
    4 (: 9 u8)
    5 (: 3 u8)
    6 (: 10 u8)
    7 (: 12 u8)
    8 (: 13 u8)
    9 (: 11 u8)
    (: 255 u8)))

(defn binop! [(c (ptr (Compiler TirAdaptor))) (inst u32) (sub bool)] (-> bool)
  (let [ad (.ad c)
        v (tv ad inst)
        (mut l) (core/val-ref-single! c (operand ad v (: 0 u32)))
        (mut r) (core/val-ref-single! c (operand ad v (: 1 u32)))
        (mut res) (core/result-ref-single! c inst)
        lr (core/vp-load-to-reg! c (mut (.vp l)))
        rr (core/vp-load-to-reg! c (mut (.vp r)))
        dr (core/vp-alloc-try-reuse! c (mut (.vp res)) (mut (.vp l)))]
    (core/emit! c
                (if sub
                    (e/sub-reg true (r5 dr) (r5 lr) (r5 rr))
                    (e/add-reg true (r5 dr) (r5 lr) (r5 rr))))
    (core/vp-set-modified! c (cast (ptr ValuePart) (mut (.vp res))))
    (core/single-reset! c (mut res))
    (core/single-reset! c (mut r))
    (core/single-reset! c (mut l))
    true))

(defn condselect! [(c (ptr (Compiler TirAdaptor))) (inst u32)] (-> bool)
  (let [ad (.ad c)
        v (tv ad inst)]
    (let [(mut a) (core/val-ref-single! c (operand ad v (: 0 u32)))
          (mut b) (core/val-ref-single! c (operand ad v (: 1 u32)))
          ar (core/vp-load-to-reg! c (mut (.vp a)))
          br (core/vp-load-to-reg! c (mut (.vp b)))]
      (core/emit! c (e/cmp-reg true (r5 ar) (r5 br)))
      (core/single-reset! c (mut b))
      (core/single-reset! c (mut a)))
    (let [(mut l) (core/val-ref-single! c (operand ad v (: 2 u32)))
          (mut r) (core/val-ref-single! c (operand ad v (: 3 u32)))
          (mut res) (core/result-ref-single! c inst)
          lr (core/vp-load-to-reg! c (mut (.vp l)))
          rr (core/vp-load-to-reg! c (mut (.vp r)))
          dr (core/vp-alloc-try-reuse! c (mut (.vp res)) (mut (.vp l)))
          cc (cond-code (operand ad v (: 4 u32)))]
      (core/emit! c (e/csel true (r5 dr) (r5 lr) (r5 rr) (cast u32 cc)))
      (core/vp-set-modified! c (cast (ptr ValuePart) (mut (.vp res))))
      (core/single-reset! c (mut res))
      (core/single-reset! c (mut r))
      (core/single-reset! c (mut l))
      (!= cc (: 255 u8)))))

(defn ret! [(c (ptr (Compiler TirAdaptor))) (v (ptr TirValue))] (-> bool)
  (let [regs
          (if (= (.op-count v) (: 1 u32))
              (core/ret-value! c (operand (.ad c) v (: 0 u32)))
              (do (core/arch-cc-reset! c) (: 0 u64)))]
    (core/ret-finish! c regs)
    true))

(defn zerofill! [(c (ptr (Compiler TirAdaptor))) (v (ptr TirValue))] (-> bool)
  (let [n0 (cast i64 (operand (.ad c) v (: 0 u32)))
        (mut size) (+ (& (- n0 4) -4) 4)]
    (while (> size 0x1000)
      (core/emit! c (e/b (/ 0x1000 4)))
      (buf/emit-zeros! (.text c) (- 0x1000 4))
      (set! size (- size 0x1000))
      (core/arch-maybe-veneer! c))
    (core/emit! c (e/b (/ size 4)))
    (buf/emit-zeros! (.text c) (- size 4))
    true))

(defn condbr! [(c (ptr (Compiler TirAdaptor))) (v (ptr TirValue)) (tbz bool)]
  (-> bool)
  (let [ad (.ad c)
        t (operand ad v (: 1 u32))
        f (operand ad v (: 2 u32))
        (mut s) (core/val-ref-single! c (operand ad v (: 0 u32)))
        r (core/vp-load-to-reg! c (mut (.vp s)))]
    (if (not tbz)
        (do
          (core/emit! c (e/cmp-imm true (r5 r) 0))
          (core/single-reset! c (mut s))
          (core/generate-cond-branch! c (core/jump (: 1 u8)) t f))
        ; as TPDE: the value stays locked in `r` across the branch
        (let [bitn (cast u8 (operand ad v (: 3 u32)))]
          (core/generate-cond-branch! c (a64/tbz-jump false r bitn) t f)
          (core/single-reset! c (mut s))))
    true))

(defn call! [(c (ptr (Compiler TirAdaptor))) (inst u32) (v (ptr TirValue))]
  (-> bool)
  (let [ad (.ad c)
        (mut res) (core/result-ref! c inst)
        (mut arg-regs) (: 0 u64)]
    (if (core/x64? c) (x64/call-begin! c false) (a64/call-begin! c true))
    (for i (range 0 (cast i64 (.op-count v)))
      (let [(mut vr) (core/val-ref! c (operand ad v (cast u32 i)))
            (mut vp) (core/vr-part c (cast (ptr ValueRef) (mut vr)) (: 0 u32))
            (mut cca) (core/cca-new)]
        (core/call-add-arg-part! c (mut vp) (mut cca) (mut arg-regs))
        (vr-reset-tir! c (mut vr))))
    (if (core/x64? c)
        (x64/call-sym! c
                       (get (.func-syms c) (cast i64 (.call-func v)))
                       arg-regs)
        (a64/call-sym! c
                       (get (.func-syms c) (cast i64 (.call-func v)))
                       arg-regs))
    (let [(mut vp) (core/vr-part c (cast (ptr ValueRef) (mut res)) (: 0 u32))
          (mut cca) (core/cca-new)]
      (core/call-add-ret-part! c (mut vp) (mut cca))
      (core/vp-reset! c (mut vp)))
    (core/vr-reset! c (mut res))
    true))

;; ---- x86-64 ----

(defn xt [(c (ptr (Compiler TirAdaptor)))] (-> (ptr buf/Buf))
  (.text c))

(defn x-cond-code [(c u32)] (-> i64)
  (case (cast i64 c)
    0 xe/CC-E
    1 xe/CC-NE
    2 xe/CC-AE
    3 xe/CC-A
    4 xe/CC-BE
    5 xe/CC-B
    6 xe/CC-GE
    7 xe/CC-G
    8 xe/CC-LE
    9 xe/CC-L
    -1))

(defn x-add! [(c (ptr (Compiler TirAdaptor))) (inst u32)] (-> bool)
  (let [ad (.ad c)
        v (tv ad inst)
        (mut l) (core/val-ref-single! c (operand ad v (: 0 u32)))
        (mut r) (core/val-ref-single! c (operand ad v (: 1 u32)))
        (mut res) (core/result-ref-single! c inst)
        lr (core/vp-load-to-reg! c (mut (.vp l)))
        rr (core/vp-load-to-reg! c (mut (.vp r)))
        dr (core/vp-alloc-try-reuse! c (mut (.vp res)) (mut (.vp l)))]
    (if (= dr lr)
        (xe/alu-rr! (xt c) xe/ALU-ADD true dr rr)
        (xe/lea! (xt c) dr (xe/mem-idx lr rr (: 1 u8) 0)))
    (core/vp-set-modified! c (cast (ptr ValuePart) (mut (.vp res))))
    (core/single-reset! c (mut res))
    (core/single-reset! c (mut r))
    (core/single-reset! c (mut l))
    true))

(defn x-sub! [(c (ptr (Compiler TirAdaptor))) (inst u32)] (-> bool)
  (let [ad (.ad c)
        v (tv ad inst)
        (mut l) (core/val-ref-single! c (operand ad v (: 0 u32)))
        (mut r) (core/val-ref-single! c (operand ad v (: 1 u32)))
        (mut tmp) (core/vp-into-temporary! c (mut (.vp l)))
        rr (core/vp-load-to-reg! c (mut (.vp r)))]
    (xe/alu-rr! (xt c) xe/ALU-SUB true (.reg tmp) rr)
    (let [(mut res) (core/result-ref-single! c inst)]
      (core/vp-set-value! c (mut (.vp res)) (mut tmp))
      (core/vp-reset! c (mut tmp))
      (core/single-reset! c (mut res)))
    (core/single-reset! c (mut r))
    (core/single-reset! c (mut l))
    true))

(defn x-condselect! [(c (ptr (Compiler TirAdaptor))) (inst u32)] (-> bool)
  (let [ad (.ad c)
        v (tv ad inst)]
    (let [(mut a) (core/val-ref-single! c (operand ad v (: 0 u32)))
          (mut b) (core/val-ref-single! c (operand ad v (: 1 u32)))
          ar (core/vp-load-to-reg! c (mut (.vp a)))
          br (core/vp-load-to-reg! c (mut (.vp b)))]
      (xe/alu-rr! (xt c) xe/ALU-CMP true ar br)
      (core/single-reset! c (mut b))
      (core/single-reset! c (mut a)))
    (let [(mut l) (core/val-ref-single! c (operand ad v (: 2 u32)))
          (mut r) (core/val-ref-single! c (operand ad v (: 3 u32)))
          (mut res) (core/result-ref-single! c inst)
          (mut tmp) (core/vp-into-temporary! c (mut (.vp l)))
          rr (core/vp-load-to-reg! c (mut (.vp r)))
          cc (x-cond-code (operand ad v (: 4 u32)))]
      (when (>= cc 0) (xe/cmovcc! (xt c) (xe/invert-cc cc) true (.reg tmp) rr))
      (core/vp-set-value! c (mut (.vp res)) (mut tmp))
      (core/vp-reset! c (mut tmp))
      (core/single-reset! c (mut res))
      (core/single-reset! c (mut r))
      (core/single-reset! c (mut l))
      (>= cc 0))))

(defn x-zerofill! [(c (ptr (Compiler TirAdaptor))) (v (ptr TirValue))] (-> bool)
  ; as TPDE: a jump to start + size, then `size` zero bytes
  (let [size (cast i64 (operand (.ad c) v (: 0 u32)))]
    (if (xe/fits8? (- size 2))
        (xe/jmp8! (xt c) (- size 2))
        (xe/jmp32! (xt c) (- size 5)))
    (buf/emit-zeros! (.text c) size)
    true))

(defn x-condbr! [(c (ptr (Compiler TirAdaptor))) (v (ptr TirValue)) (tbz bool)]
  (-> bool)
  (let [ad (.ad c)
        t (operand ad v (: 1 u32))
        f (operand ad v (: 2 u32))
        (mut s) (core/val-ref-single! c (operand ad v (: 0 u32)))
        r (core/vp-load-to-reg! c (mut (.vp s)))
        (mut cc) xe/CC-NE]
    (if (not tbz)
        (xe/test-rr! (xt c) true r r)
        (let [bitn (cast i64 (operand ad v (: 3 u32)))]
          (if (<= bitn 32)
              (xe/test-ri! (xt c) false r (<< 1 (& bitn 31)))
              (do (xe/bt-ri! (xt c) true r bitn) (set! cc xe/CC-B)))))
    (core/generate-cond-branch! c (core/jump (cast u8 cc)) t f)
    (core/single-reset! c (mut s))
    true))

(defn compile-inst-x64! [(c (ptr (Compiler TirAdaptor))) (inst u32)] (-> bool)
  (let [ad (.ad c)
        v (tv ad inst)
        op (cast i64 (.op v))]
    (cond (= op tir/OP-ADD) (x-add! c inst)
          (= op tir/OP-SUB) (x-sub! c inst)
          (= op tir/OP-CONDSELECT) (x-condselect! c inst)
          (or (= op tir/OP-TERMINATE) (= op tir/OP-RET)) (ret! c v)
          (= op tir/OP-TRAP)
            (do (xe/ud2! (xt c)) (core/release-regs-after-return! c) true)
          (= op tir/OP-ALLOCA) true
          (= op tir/OP-BR)
            (do (core/generate-uncond-branch! c (operand ad v (: 0 u32))) true)
          (= op tir/OP-ZEROFILL) (x-zerofill! c v)
          (= op tir/OP-CONDBR) (x-condbr! c v false)
          (= op tir/OP-TBZ) (x-condbr! c v true)
          (= op tir/OP-CALL) (call! c inst v)
          :else false)))

(defn vr-reset-tir! [(c (ptr (Compiler TirAdaptor))) (vr (mut ValueRef))]
  (-> void)
  (core/vr-reset! c (mut vr)))

(impl IRCompiler TirAdaptor
  (val-part-count [(self (ptr TirAdaptor)) (v u32)] (-> u32)
    (: 1 u32))
  (val-part-size [(self (ptr TirAdaptor)) (v u32) (part u32)] (-> u32)
    (: 8 u32))
  (val-part-bank [(self (ptr TirAdaptor)) (v u32) (part u32)] (-> u8)
    (: 0 u8))
  (val-kind [(self (ptr TirAdaptor)) (v u32)] (-> u8)
    (: 0 u8))
  (val-const-word [(self (ptr TirAdaptor)) (v u32) (part u32) (word u32)]
    (-> u64)
    (: 0 u64))
  (val-sym [(self (ptr TirAdaptor)) (c (ptr (Compiler TirAdaptor))) (v u32)]
    (-> u32)
    (: 0 u32))
  (val-sym-addend [(self (ptr TirAdaptor)) (v u32)] (-> i64)
    0)
  (cur-arg-flags [(self (ptr TirAdaptor)) (i u32)] (-> u32)
    (: 0 u32))
  (cur-has-tail-calls? [(self (ptr TirAdaptor))] (-> bool)
    false)
  (cur-may-emit-calls? [(self (ptr TirAdaptor))] (-> bool)
    (.has-call (tir/func-at (.ir self) (.cur-func self))))
  (force-fixed? [(self (ptr TirAdaptor)) (v u32)] (-> bool)
    (.force-fixed (tv self v)))
  (allow-fixed? [(self (ptr TirAdaptor)) (v u32)] (-> bool)
    true)
  (begin-func! [(self (ptr TirAdaptor)) (c (ptr (Compiler TirAdaptor))) (f u32)]
    (-> bool)
    true)
  (compile-inst! [(self (ptr TirAdaptor))
                  (c (ptr (Compiler TirAdaptor)))
                  (inst u32)] (-> bool)
    (if (core/x64? c)
        (compile-inst-x64! c inst)
        (compile-inst-a64! self c inst))))

(defn compile-inst-a64! [(self (ptr TirAdaptor))
                         (c (ptr (Compiler TirAdaptor)))
                         (inst u32)] (-> bool)
  (let [v (tv self inst)
        op (cast i64 (.op v))]
    (cond (= op tir/OP-ADD) (binop! c inst false)
          (= op tir/OP-SUB) (binop! c inst true)
          (= op tir/OP-CONDSELECT) (condselect! c inst)
          (or (= op tir/OP-TERMINATE) (= op tir/OP-RET)) (ret! c v)
          (= op tir/OP-TRAP)
            (do
              (core/emit! c (e/brk (: 1 u32)))
              (core/release-regs-after-return! c)
              true)
          (= op tir/OP-ALLOCA) true
          (= op tir/OP-BR)
            (do
              (core/generate-uncond-branch! c (operand self v (: 0 u32)))
              true)
          (= op tir/OP-ZEROFILL) (zerofill! c v)
          (= op tir/OP-CONDBR) (condbr! c v false)
          (= op tir/OP-TBZ) (condbr! c v true)
          (= op tir/OP-CALL) (call! c inst v)
          :else false)))

;;; Compile every function of `ir` into `a`. Returns false on failure.
(defn compile-module! [(ir (ptr Tir)) (a (ptr Asm)) (no-fixed bool) (arch u8)]
  (-> bool)
  (let [(mut ad) (TirAdaptor::new ir)
        adp (cast (ptr TirAdaptor) (mut ad))
        (mut c) (Compiler::new [TirAdaptor] adp a arch)
        cp (cast (ptr (Compiler TirAdaptor)) (mut c))
        nf (func-count adp)]
    (set! (.no-fixed c) no-fixed)
    (for i (range 0 (cast i64 nf))
      (let [f (cast u32 i)
            name (func-link-name adp f)
            bind (if (func-only-local? adp f) (: 0 u8) (: 1 u8))
            sym
              (if (func-extern? adp f)
                  (asm/sym-add-undef! a name bind)
                  (asm/sym-add-def! a name -2 0 0 bind))]
        (push! (mut (.func-syms c)) sym)))
    (let [ok
            (block :all
              (for i (range 0 (cast i64 nf))
                (let [f (cast u32 i)]
                  (when (not (func-extern? adp f))
                    (when (not (core/compile-func! cp f (get (.func-syms c) i)))
                      (return-from :all false)))))
              true)]
      (core/compiler-free! cp)
      ok)))
