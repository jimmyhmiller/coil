;;; CIR as a tpde IR: the adaptor (one function per module) and the codegen
;;; description. Instruction selection is in `tpde.cir.a64`.
(module tpde.cir.adaptor)
(import "tpde.adaptor" :use [IRAdaptor invalid-ref])
(import "tpde.codegen" :use [IRCompiler])
(import "tpde.core" :as core :use [Compiler])
(import "tpde.cir" :as cir :use [Func Value Block])
(import "tpde.cir.a64" :as isel)
(import "tpde.cir.x64" :as xisel)

(defn u32-of [(x i64)] (-> u32)
  (cast u32 x))

(defn i64-of [(x u32)] (-> i64)
  (cast i64 x))

(defn term [(f (ptr Func)) (b u32)] (-> (ptr Value))
  (cir/val f (.term (cir/blk f b))))

(impl IRAdaptor Func
  (func-count [(self (ptr Func))] (-> u32)
    (: 1 u32))
  (func-at [(self (ptr Func)) (i u32)] (-> u32)
    i)
  (func-link-name [(self (ptr Func)) (f u32)] (-> (slice u8))
    (.name self))
  (func-extern? [(self (ptr Func)) (f u32)] (-> bool)
    false)
  (func-only-local? [(self (ptr Func)) (f u32)] (-> bool)
    false)
  (func-weak? [(self (ptr Func)) (f u32)] (-> bool)
    false)
  (switch-func [(self (ptr Func)) (f u32)] (-> bool)
    true)

  (cur-highest-val-idx [(self (ptr Func))] (-> u32)
    (let [n (cir/value-count self)]
      (if (= n (: 0 u32)) (: 0 u32) (- n (: 1 u32)))))
  (liveness-visit-args? [(self (ptr Func))] (-> bool)
    true)
  (cur-is-vararg? [(self (ptr Func))] (-> bool)
    false)
  (cur-needs-unwind-info? [(self (ptr Func))] (-> bool)
    false)
  (cur-arg-count [(self (ptr Func))] (-> u32)
    (u32-of (len (.args self))))
  (cur-arg [(self (ptr Func)) (i u32)] (-> u32)
    (get (.args self) (i64-of i)))
  (cur-arg-byval? [(self (ptr Func)) (i u32)] (-> bool)
    (cir/af-byval? (get (.arg-flags self) (i64-of i))))
  (cur-arg-byval-size [(self (ptr Func)) (i u32)] (-> u32)
    (cir/af-byval-size (get (.arg-flags self) (i64-of i))))
  (cur-arg-byval-align [(self (ptr Func)) (i u32)] (-> u32)
    (: 8 u32))
  (cur-arg-sret? [(self (ptr Func)) (i u32)] (-> bool)
    (get (.arg-sret self) (i64-of i)))
  (cur-static-alloca-count [(self (ptr Func))] (-> u32)
    (u32-of (len (.allocas self))))
  (cur-static-alloca [(self (ptr Func)) (i u32)] (-> u32)
    (get (.allocas self) (i64-of i)))
  (cur-has-dynamic-alloca? [(self (ptr Func))] (-> bool)
    (.has-dynamic-alloca self))
  (cur-entry-block [(self (ptr Func))] (-> u32)
    (: 0 u32))
  (cur-block-count [(self (ptr Func))] (-> u32)
    (cir/block-count self))
  (cur-block [(self (ptr Func)) (i u32)] (-> u32)
    i)

  (block-succ-count [(self (ptr Func)) (b u32)] (-> u32)
    (let [t (.term (cir/blk self b))]
      (if (= t (cir/none))
          (: 0 u32)
          (let [v (cir/val self t)
                op (cast i64 (.op v))]
            (cond (= op cir/OP-BR) (: 1 u32)
                  (= op cir/OP-CONDBR) (: 2 u32)
                  (= op cir/OP-SWITCH) (- (.ntotal v) (: 1 u32))
                  :else (: 0 u32))))))
  (block-succ [(self (ptr Func)) (b u32) (i u32)] (-> u32)
    (let [v (term self b)]
      (get (.operands self) (i64-of (+ (+ (.opb v) (.nops v)) i)))))
  (block-inst-count [(self (ptr Func)) (b u32)] (-> u32)
    (let [bb (cir/blk self b)] (- (.iend bb) (.ibegin bb))))
  (block-inst [(self (ptr Func)) (b u32) (i u32)] (-> u32)
    (get (.insts self) (i64-of (+ (.ibegin (cir/blk self b)) i))))
  (block-phi-count [(self (ptr Func)) (b u32)] (-> u32)
    (.phi-count (cir/blk self b)))
  (block-phi [(self (ptr Func)) (b u32) (i u32)] (-> u32)
    (get (.phis self) (i64-of (+ (.phi-begin (cir/blk self b)) i))))
  (block-info [(self (ptr Func)) (b u32)] (-> u32)
    (.info (cir/blk self b)))
  (block-set-info! [(self (ptr Func)) (b u32) (v u32)] (-> void)
    (set! (.info (cir/blk self b)) v))
  (block-info2 [(self (ptr Func)) (b u32)] (-> u32)
    (.info2 (cir/blk self b)))
  (block-set-info2! [(self (ptr Func)) (b u32) (v u32)] (-> void)
    (set! (.info2 (cir/blk self b)) v))
  (block-name [(self (ptr Func)) (b u32)] (-> (slice u8))
    "block")

  (val-local-idx [(self (ptr Func)) (v u32)] (-> u32)
    v)
  (val-ignore-in-liveness? [(self (ptr Func)) (v u32)] (-> bool)
    (let [op (cast i64 (.op (cir/val self v)))]
      (or (= op cir/OP-CONST) (= op cir/OP-SYM) (= op cir/OP-ALLOCA))))
  (val-phi? [(self (ptr Func)) (v u32)] (-> bool)
    (= (cast i64 (.op (cir/val self v))) cir/OP-PHI))
  (val-alloca-size [(self (ptr Func)) (v u32)] (-> u32)
    (u32-of (.imm (cir/val self v))))
  (val-alloca-align [(self (ptr Func)) (v u32)] (-> u32)
    (u32-of (.imm2 (cir/val self v))))
  (val-name [(self (ptr Func)) (v u32)] (-> (slice u8))
    "value")

  (phi-incoming-count [(self (ptr Func)) (phi u32)] (-> u32)
    (.nops (cir/val self phi)))
  (phi-incoming-val [(self (ptr Func)) (phi u32) (slot u32)] (-> u32)
    (cir/operand self (cir/val self phi) slot))
  (phi-incoming-block [(self (ptr Func)) (phi u32) (slot u32)] (-> u32)
    (let [v (cir/val self phi)] (cir/operand self v (+ (.nops v) slot))))
  (phi-incoming-val-for-block [(self (ptr Func)) (phi u32) (b u32)] (-> u32)
    (let [v (cir/val self phi)
          n (.nops v)]
      (block :found
        (for i (range 0 (i64-of n))
          (when (= (cir/operand self v (+ n (u32-of i))) b)
            (return-from :found (cir/operand self v (u32-of i)))))
        (invalid-ref))))

  (inst-operand-count [(self (ptr Func)) (inst u32)] (-> u32)
    (.nops (cir/val self inst)))
  (inst-operand [(self (ptr Func)) (inst u32) (i u32)] (-> u32)
    (cir/operand self (cir/val self inst) i))
  (inst-result-count [(self (ptr Func)) (inst u32)] (-> u32)
    (let [v (cir/val self inst)
          op (cast i64 (.op v))]
      (cond (= (cast i64 (.ty v)) cir/T-VOID) (: 0 u32)
            (or (= op cir/OP-CALL) (= op cir/OP-TAILCALL)) (cast u32 (.aux v))
            :else (: 1 u32))))
  (inst-result [(self (ptr Func)) (inst u32) (i u32)] (-> u32)
    (+ inst i))
  (inst-fused? [(self (ptr Func)) (inst u32)] (-> bool)
    (!= (& (.flags (cir/val self inst)) (: 1 u8)) (: 0 u8)))
  (inst-loc [(self (ptr Func)) (inst u32)] (-> u64)
    (get (.locs self) (i64-of inst)))
  (inst-marked? [(self (ptr Func)) (inst u32)] (-> bool)
    (cir/dbg-marked? self inst))
  (inst-name [(self (ptr Func)) (inst u32)] (-> (slice u8))
    (isel/op-name (cast i64 (.op (cir/val self inst))))))

(defn ty-of [(f (ptr Func)) (v u32)] (-> i64)
  (cast i64 (.ty (cir/val f v))))

(impl IRCompiler Func
  (val-part-count [(self (ptr Func)) (v u32)] (-> u32)
    (if (= (ty-of self v) cir/T-I128) (: 2 u32) (: 1 u32)))
  (val-part-size [(self (ptr Func)) (v u32) (part u32)] (-> u32)
    (let [t (ty-of self v)]
      (cond (= t cir/T-F32) (: 4 u32)
            (= t cir/T-V128) (: 16 u32)
            :else (: 8 u32))))
  (val-part-bank [(self (ptr Func)) (v u32) (part u32)] (-> u8)
    (let [t (ty-of self v)]
      (if (or (= t cir/T-F32) (= t cir/T-F64) (= t cir/T-V128))
          (: 1 u8)
          (: 0 u8))))
  (val-kind [(self (ptr Func)) (v u32)] (-> u8)
    (let [op (cast i64 (.op (cir/val self v)))]
      (cond (= op cir/OP-CONST) (: 1 u8)
            (= op cir/OP-SYM) (: 2 u8)
            :else (: 0 u8))))
  (val-const-word [(self (ptr Func)) (v u32) (part u32) (word u32)] (-> u64)
    (let [x (cir/val self v)]
      (cond (= (ty-of self v) cir/T-I128)
              (if (= part (: 0 u32))
                  (if (= word (: 0 u32)) (cast u64 (.imm x)) (: 0 u64))
                  (if (= word (: 0 u32)) (cast u64 (.imm2 x)) (: 0 u64)))
            (= word (: 0 u32)) (cast u64 (.imm x))
            :else (cast u64 (.imm2 x)))))
  (val-sym [(self (ptr Func)) (c (ptr (Compiler Func))) (v u32)] (-> u32)
    (u32-of (.imm (cir/val self v))))
  (val-sym-addend [(self (ptr Func)) (v u32)] (-> i64)
    (.imm2 (cir/val self v)))
  (cur-arg-flags [(self (ptr Func)) (i u32)] (-> u32)
    (get (.arg-flags self) (i64-of i)))
  (cur-may-emit-calls? [(self (ptr Func))] (-> bool)
    (.has-calls self))
  (cur-has-tail-calls? [(self (ptr Func))] (-> bool)
    (.has-tail-calls self))
  (force-fixed? [(self (ptr Func)) (v u32)] (-> bool)
    false)
  (allow-fixed? [(self (ptr Func)) (v u32)] (-> bool)
    true)
  (begin-func! [(self (ptr Func)) (c (ptr (Compiler Func))) (f u32)] (-> bool)
    (isel/begin-func! c)
    (when (core/x64? c) (xisel/fuse-addresses! c))
    true)
  (compile-inst! [(self (ptr Func)) (c (ptr (Compiler Func))) (inst u32)]
    (-> bool)
    (if (core/x64? c) (xisel/compile-inst! c inst) (isel/compile-inst! c inst))))
