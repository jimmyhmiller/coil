; Ported to Coil from TPDE (commit 9779acf) and modified; see NOTICE.
;;; The interface an IR implements to be compiled by tpde (TPDE's `IRAdaptor`).
;;;
;;; Every reference is an opaque `u32` handle whose meaning belongs to the
;;; adaptor; `INVALID-REF` is reserved. Where TPDE returns a range, the adaptor
;;; gives a count and an indexed accessor, so walking one allocates nothing.
;;;
;;; The compiler works on one function at a time: `switch-func` selects it and
;;; every `cur-…` method answers for it. Values have a dense index local to that
;;; function, `val-local-idx`, from 0 to `cur-highest-val-idx`; per-value tables
;;; are indexed by it. Each block carries two `u32` scratch slots
;;; (`block-info`, `block-info2`) that the analyzer owns while a function compiles.
(module tpde.adaptor)

(const INVALID-REF 0xFFFFFFFF)

(defn invalid-ref [] (-> u32)
  (: 0xFFFFFFFF u32))

(deftrait IRAdaptor [Self]
  ; ---- module ----
  (func-count [(self (ptr Self))] (-> u32))
  (func-at [(self (ptr Self)) (i u32)] (-> u32))
  (func-link-name [(self (ptr Self)) (f u32)] (-> (slice u8)))
  (func-extern? [(self (ptr Self)) (f u32)] (-> bool))
  (func-only-local? [(self (ptr Self)) (f u32)] (-> bool))
  (func-weak? [(self (ptr Self)) (f u32)] (-> bool))
  ; Select the function the `cur-…` methods describe. False skips it.
  (switch-func [(self (ptr Self)) (f u32)] (-> bool))

  ; ---- current function ----
  (cur-highest-val-idx [(self (ptr Self))] (-> u32))
  ; Whether liveness counts the arguments as defined in the entry block
  ; (TPDE's TPDE_LIVENESS_VISIT_ARGS).
  (liveness-visit-args? [(self (ptr Self))] (-> bool))
  (cur-is-vararg? [(self (ptr Self))] (-> bool))
  (cur-needs-unwind-info? [(self (ptr Self))] (-> bool))
  (cur-arg-count [(self (ptr Self))] (-> u32))
  (cur-arg [(self (ptr Self)) (i u32)] (-> u32))
  (cur-arg-byval? [(self (ptr Self)) (i u32)] (-> bool))
  (cur-arg-byval-size [(self (ptr Self)) (i u32)] (-> u32))
  (cur-arg-byval-align [(self (ptr Self)) (i u32)] (-> u32))
  (cur-arg-sret? [(self (ptr Self)) (i u32)] (-> bool))
  (cur-static-alloca-count [(self (ptr Self))] (-> u32))
  (cur-static-alloca [(self (ptr Self)) (i u32)] (-> u32))
  (cur-has-dynamic-alloca? [(self (ptr Self))] (-> bool))
  (cur-entry-block [(self (ptr Self))] (-> u32))
  (cur-block-count [(self (ptr Self))] (-> u32))
  (cur-block [(self (ptr Self)) (i u32)] (-> u32))

  ; ---- blocks ----
  (block-succ-count [(self (ptr Self)) (b u32)] (-> u32))
  (block-succ [(self (ptr Self)) (b u32) (i u32)] (-> u32))
  (block-inst-count [(self (ptr Self)) (b u32)] (-> u32))
  (block-inst [(self (ptr Self)) (b u32) (i u32)] (-> u32))
  (block-phi-count [(self (ptr Self)) (b u32)] (-> u32))
  (block-phi [(self (ptr Self)) (b u32) (i u32)] (-> u32))
  (block-info [(self (ptr Self)) (b u32)] (-> u32))
  (block-set-info! [(self (ptr Self)) (b u32) (v u32)] (-> void))
  (block-info2 [(self (ptr Self)) (b u32)] (-> u32))
  (block-set-info2! [(self (ptr Self)) (b u32) (v u32)] (-> void))
  (block-name [(self (ptr Self)) (b u32)] (-> (slice u8)))

  ; ---- values ----
  (val-local-idx [(self (ptr Self)) (v u32)] (-> u32))
  (val-ignore-in-liveness? [(self (ptr Self)) (v u32)] (-> bool))
  (val-phi? [(self (ptr Self)) (v u32)] (-> bool))
  (val-alloca-size [(self (ptr Self)) (v u32)] (-> u32))
  (val-alloca-align [(self (ptr Self)) (v u32)] (-> u32))
  (val-name [(self (ptr Self)) (v u32)] (-> (slice u8)))

  ; ---- PHIs ----
  (phi-incoming-count [(self (ptr Self)) (phi u32)] (-> u32))
  (phi-incoming-val [(self (ptr Self)) (phi u32) (slot u32)] (-> u32))
  (phi-incoming-block [(self (ptr Self)) (phi u32) (slot u32)] (-> u32))
  (phi-incoming-val-for-block [(self (ptr Self)) (phi u32) (b u32)] (-> u32))

  ; ---- instructions ----
  (inst-operand-count [(self (ptr Self)) (inst u32)] (-> u32))
  (inst-operand [(self (ptr Self)) (inst u32) (i u32)] (-> u32))
  (inst-result-count [(self (ptr Self)) (inst u32)] (-> u32))
  (inst-result [(self (ptr Self)) (inst u32) (i u32)] (-> u32))
  (inst-fused? [(self (ptr Self)) (inst u32)] (-> bool))
  ; the source position debug info maps the instruction's code to: an opaque
  ; nonzero number recorded with the code offset (Compiler.dbg-rows); 0 for none
  (inst-loc [(self (ptr Self)) (inst u32)] (-> u64))
  ; whether debug info wants the code offset of the instruction (recorded in
  ; Compiler.dbg-marks with the instruction, fused or not)
  (inst-marked? [(self (ptr Self)) (inst u32)] (-> bool))
  (inst-name [(self (ptr Self)) (inst u32)] (-> (slice u8))))
