; SPDX-FileCopyrightText: 2026 Jimmy Miller
; SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
; Ported to Coil from TPDE (commit 9779acf) and modified; see NOTICE.
;;; x86-64 instruction encoders: each appends one instruction to a `Buf`. This
;;; plays the part of fadec in TPDE.
;;;
;;; Registers are 0..15: rax rcx rdx rbx rsp rbp rsi rdi r8..r15 for general
;;; purpose operands, xmm0..xmm15 for SSE operands (the core numbers XMM
;;; registers 32..47; only the low four bits are used here). `w` selects the
;;; 64-bit form (REX.W); otherwise the 32-bit one. Sizes are in bytes.
(module tpde.x64.enc)
(import "coil.primitive" :as primitive)
(import "tpde.buf" :as buf :use [Buf])

(const RAX 0)

(const RCX 1)

(const RDX 2)

(const RBX 3)

(const RSP 4)

(const RBP 5)

(const RSI 6)

(const RDI 7)

(const R8 8)

(const R9 9)

(const R10 10)

(const R11 11)

(const R12 12)

(const R13 13)

(const R14 14)

(const R15 15)

;; a memory operand without an index register, or a RIP-relative one
(const NOREG 255)

(const RIP 254)

; condition codes: the low nibble of Jcc, SETcc and CMOVcc
(const CC-O 0)

(const CC-NO 1)

(const CC-B 2)

(const CC-AE 3)

(const CC-E 4)

(const CC-NE 5)

(const CC-BE 6)

(const CC-A 7)

(const CC-S 8)

(const CC-NS 9)

(const CC-P 10)

(const CC-NP 11)

(const CC-L 12)

(const CC-GE 13)

(const CC-LE 14)

(const CC-G 15)

(defn invert-cc [(cc i64)] (-> i64)
  (^ cc 1))

; ALU group (the /r of 0x81 and the row of the two-operand forms)
(const ALU-ADD 0)

(const ALU-OR 1)

(const ALU-ADC 2)

(const ALU-SBB 3)

(const ALU-AND 4)

(const ALU-SUB 5)

(const ALU-XOR 6)

(const ALU-CMP 7)

; group 3 (0xF7 /n)
(const G3-NOT 2)

(const G3-NEG 3)

(const G3-MUL 4)

(const G3-IMUL 5)

(const G3-DIV 6)

(const G3-IDIV 7)

; shift group (0xD3 /n, 0xC1 /n)
(const SH-ROL 0)

(const SH-ROR 1)

(const SH-SHL 4)

(const SH-SHR 5)

(const SH-SAR 7)

; SSE arithmetic (0F xx with F3 for single, F2 for double precision)
(const SSE-SQRT 0x51)

(const SSE-ADD 0x58)

(const SSE-MUL 0x59)

(const SSE-SUB 0x5C)

(const SSE-MIN 0x5D)

(const SSE-DIV 0x5E)

(const SSE-MAX 0x5F)

; SSE logic (0F xx; 66 for the pd form)
(const SSE-AND 0x54)

(const SSE-ANDN 0x55)

(const SSE-OR 0x56)

(const SSE-XOR 0x57)

(defstruct Mem [(base u8) (index u8) (scale u8) (disp i32)])

(defn mem [(base u8) (disp i64)] (-> Mem)
  (Mem
    :base base
    :index (: 255 u8)
    :scale (: 1 u8)
    :disp (primitive/cast i32 disp)))

(defn mem-idx [(base u8) (index u8) (scale u8) (disp i64)] (-> Mem)
  (Mem
    :base base
    :index index
    :scale scale
    :disp (primitive/cast i32 disp)))

;;; [rip + disp]: `disp` is relative to the end of the instruction.
(defn mem-rip [(disp i64)] (-> Mem)
  (Mem
    :base (: 254 u8)
    :index (: 255 u8)
    :scale (: 1 u8)
    :disp (primitive/cast i32 disp)))

(defn i [(r u8)] (-> i64)
  (primitive/cast i64 r))

(defn e8! [(b (ptr Buf)) (x i64)] (-> void)
  (buf/emit8! b (primitive/cast u8 x)))

(defn e16! [(b (ptr Buf)) (x i64)] (-> void)
  (buf/emit16! b (primitive/cast u16 x)))

(defn e32! [(b (ptr Buf)) (x i64)] (-> void)
  (buf/emit32! b (primitive/cast u32 x)))

(defn e64! [(b (ptr Buf)) (x i64)] (-> void)
  (buf/emit64! b (primitive/cast u64 x)))

(defn fits8? [(x i64)] (-> bool)
  (and (>= x -128) (< x 128)))

(defn fits32? [(x i64)] (-> bool)
  (and (>= x -2147483648) (< x 2147483648)))

;; 1, 2 or 3 opcode bytes, most significant first (0x0FAF is 0F AF).
(defn op! [(b (ptr Buf)) (op i64)] (-> void)
  (cond (> op 0xFFFF)
          (do (e8! b (>> op 16)) (e8! b (& (>> op 8) 0xFF)) (e8! b (& op 0xFF)))
        (> op 0xFF) (do (e8! b (>> op 8)) (e8! b (& op 0xFF)))
        :else (e8! b op)))

(defn ext? [(r u8)] (-> bool)
  (and (< r (: 254 u8)) (!= (& r (: 8 u8)) (: 0 u8))))

;; A byte register that needs a REX prefix to be spl/bpl/sil/dil, not ah..bh.
(defn rex-byte? [(r u8)] (-> bool)
  (and (>= r (: 4 u8)) (< r (: 8 u8))))

;; REX = 0100WRXB, emitted when any bit is set or `force`.
(defn rex! [(b (ptr Buf)) (w bool) (reg u8) (index u8) (base u8) (force bool)]
  (-> void)
  (let [v
          (| 0x40
             (if w 8 0)
             (if (ext? reg) 4 0)
             (if (ext? index) 2 0)
             (if (ext? base) 1 0))]
    (when (or force (!= v 0x40)) (e8! b v))))

;; ModRM (and SIB and displacement) for a memory operand.
(defn modrm-mem! [(b (ptr Buf)) (reg u8) (m Mem)] (-> void)
  (let [r (& (i reg) 7)
        base (.base m)
        idx (.index m)
        disp (primitive/cast i64 (.disp m))]
    (if (= base (: 254 u8))
        (do (e8! b (| (<< r 3) 5)) (e32! b disp))
        (let [b7 (& (i base) 7)
              sib (or (!= idx (: 255 u8)) (= b7 4))
              md (cond (and (= disp 0) (!= b7 5)) 0 (fits8? disp) 1 :else 2)]
          (e8! b (| (<< md 6) (<< r 3) (if sib 4 b7)))
          (when sib
            (let [ss (case (i (.scale m)) 1 0 2 1 4 2 3)
                  ix (if (= idx (: 255 u8)) 4 (& (i idx) 7))]
              (e8! b (| (<< ss 6) (<< ix 3) b7))))
          (cond (= md 1) (e8! b disp)
                (= md 2) (e32! b disp)
                :else 0)))))

(defn modrm-rr! [(b (ptr Buf)) (reg u8) (rm u8)] (-> void)
  (e8! b (| 0xC0 (<< (& (i reg) 7) 3) (& (i rm) 7))))

;;; [pfx] REX op ModRM(reg, rm) with a register operand.
(defn rr! [(b (ptr Buf))
           (pfx i64)
           (w bool)
           (op i64)
           (reg u8)
           (rm u8)
           (byte bool)] (-> void)
  (when (!= pfx 0) (e8! b pfx))
  (rex! b w reg (: 255 u8) rm (and byte (or (rex-byte? reg) (rex-byte? rm))))
  (op! b op)
  (modrm-rr! b reg rm))

;;; [pfx] REX op ModRM(reg, m) with a memory operand.
(defn rm! [(b (ptr Buf))
           (pfx i64)
           (w bool)
           (op i64)
           (reg u8)
           (m Mem)
           (byte bool)] (-> void)
  (when (!= pfx 0) (e8! b pfx))
  (rex! b w reg (.index m) (.base m) (and byte (rex-byte? reg)))
  (op! b op)
  (modrm-mem! b reg m))

(defn u8-of [(x i64)] (-> u8)
  (primitive/cast u8 x))

; ============================ moves ==========================================

(defn mov-rr! [(b (ptr Buf)) (w bool) (dst u8) (src u8)] (-> void)
  (rr! b 0 w 0x89 src dst false))

;;; dst = imm: the shortest of mov r32 (zero-extends), mov r64 sign-extending
;;; imm32, and movabs.
(defn mov-ri! [(b (ptr Buf)) (dst u8) (imm i64)] (-> void)
  (cond (and (>= imm 0) (< imm 4294967296))
          (do
            (rex! b false (: 0 u8) (: 255 u8) dst false)
            (e8! b (+ 0xB8 (& (i dst) 7)))
            (e32! b imm))
        (fits32? imm)
          (do
            (rex! b true (: 0 u8) (: 255 u8) dst false)
            (e8! b 0xC7)
            (modrm-rr! b (: 0 u8) dst)
            (e32! b imm))
        :else
          (do
            (rex! b true (: 0 u8) (: 255 u8) dst false)
            (e8! b (+ 0xB8 (& (i dst) 7)))
            (e64! b imm))))

;;; dst = [m], `size` bytes, zero- or sign-extended to 64 bits.
(defn load-m! [(b (ptr Buf)) (dst u8) (m Mem) (size i64) (sext bool)] (-> void)
  (cond (= size 8) (rm! b 0 true 0x8B dst m false)
        (= size 4)
          (if sext
              (rm! b 0 true 0x63 dst m false)
              (rm! b 0 false 0x8B dst m false))
        (= size 2)
          (if sext
              (rm! b 0 true 0x0FBF dst m false)
              (rm! b 0 false 0x0FB7 dst m false))
        :else
          (if sext
              (rm! b 0 true 0x0FBE dst m false)
              (rm! b 0 false 0x0FB6 dst m false))))

;;; [m] = src, the low `size` bytes.
(defn store-m! [(b (ptr Buf)) (m Mem) (src u8) (size i64)] (-> void)
  (cond (= size 8) (rm! b 0 true 0x89 src m false)
        (= size 4) (rm! b 0 false 0x89 src m false)
        (= size 2) (rm! b 0x66 false 0x89 src m false)
        :else (rm! b 0 false 0x88 src m true)))

;;; [m] = imm (sign-extended imm32 for 8 bytes).
(defn store-mi! [(b (ptr Buf)) (m Mem) (imm i64) (size i64)] (-> void)
  (cond (= size 8) (do (rm! b 0 true 0xC7 (: 0 u8) m false) (e32! b imm))
        (= size 4) (do (rm! b 0 false 0xC7 (: 0 u8) m false) (e32! b imm))
        (= size 2) (do (rm! b 0x66 false 0xC7 (: 0 u8) m false) (e16! b imm))
        :else (do (rm! b 0 false 0xC6 (: 0 u8) m false) (e8! b imm))))

(defn lea! [(b (ptr Buf)) (dst u8) (m Mem)] (-> void)
  (rm! b 0 true 0x8D dst m false))

;;; dst = src zero-extended from `from` bytes (1, 2 or 4).
(defn movzx! [(b (ptr Buf)) (dst u8) (src u8) (from i64)] (-> void)
  (cond (= from 1) (rr! b 0 false 0x0FB6 dst src true)
        (= from 2) (rr! b 0 false 0x0FB7 dst src false)
        :else (mov-rr! b false dst src)))

;;; dst = src sign-extended from `from` bytes (1, 2 or 4) to 64 bits.
(defn movsx! [(b (ptr Buf)) (dst u8) (src u8) (from i64)] (-> void)
  (cond (= from 1) (rr! b 0 true 0x0FBE dst src true)
        (= from 2) (rr! b 0 true 0x0FBF dst src false)
        :else (rr! b 0 true 0x63 dst src false)))

(defn xchg! [(b (ptr Buf)) (w bool) (x u8) (y u8)] (-> void)
  (rr! b 0 w 0x87 x y false))

; ============================ arithmetic =====================================

;;; dst op= src (op: ALU-…).
(defn alu-rr! [(b (ptr Buf)) (op i64) (w bool) (dst u8) (src u8)] (-> void)
  (rr! b 0 w (| (<< op 3) 1) src dst false))

;;; dst op= imm (sign-extended imm8 or imm32).
(defn alu-ri! [(b (ptr Buf)) (op i64) (w bool) (dst u8) (imm i64)] (-> void)
  (if (fits8? imm)
      (do (rr! b 0 w 0x83 (u8-of op) dst false) (e8! b imm))
      (do (rr! b 0 w 0x81 (u8-of op) dst false) (e32! b imm))))

;;; dst op= [m].
(defn alu-rm! [(b (ptr Buf)) (op i64) (w bool) (dst u8) (m Mem)] (-> void)
  (rm! b 0 w (| (<< op 3) 3) dst m false))

;;; [m] op= imm, `size` bytes.
(defn alu-mi! [(b (ptr Buf)) (op i64) (m Mem) (imm i64) (size i64)] (-> void)
  (cond (= size 1) (do (rm! b 0 false 0x80 (u8-of op) m false) (e8! b imm))
        (fits8? imm)
          (do
            (rm! b (if (= size 2) 0x66 0) (= size 8) 0x83 (u8-of op) m false)
            (e8! b imm))
        (= size 2) (do (rm! b 0x66 false 0x81 (u8-of op) m false) (e16! b imm))
        :else (do (rm! b 0 (= size 8) 0x81 (u8-of op) m false) (e32! b imm))))

(defn test-rr! [(b (ptr Buf)) (w bool) (x u8) (y u8)] (-> void)
  (rr! b 0 w 0x85 y x false))

(defn test-ri! [(b (ptr Buf)) (w bool) (x u8) (imm i64)] (-> void)
  (rr! b 0 w 0xF7 (: 0 u8) x false)
  (e32! b imm))

(defn test8-ri! [(b (ptr Buf)) (x u8) (imm i64)] (-> void)
  (rr! b 0 false 0xF6 (: 0 u8) x true)
  (e8! b imm))

(defn imul-rr! [(b (ptr Buf)) (w bool) (dst u8) (src u8)] (-> void)
  (rr! b 0 w 0x0FAF dst src false))

(defn imul-rri! [(b (ptr Buf)) (w bool) (dst u8) (src u8) (imm i64)] (-> void)
  (if (fits8? imm)
      (do (rr! b 0 w 0x6B dst src false) (e8! b imm))
      (do (rr! b 0 w 0x69 dst src false) (e32! b imm))))

;;; Group 3 on a register (G3-…): not, neg, mul, imul, div, idiv.
(defn g3! [(b (ptr Buf)) (op i64) (w bool) (r u8)] (-> void)
  (rr! b 0 w 0xF7 (u8-of op) r false))

;;; rdx:rax = sign extension of rax (cqo), or edx:eax of eax (cdq).
(defn cqo! [(b (ptr Buf)) (w bool)] (-> void)
  (when w (e8! b 0x48))
  (e8! b 0x99))

(defn shift-cl! [(b (ptr Buf)) (op i64) (w bool) (r u8)] (-> void)
  (rr! b 0 w 0xD3 (u8-of op) r false))

(defn shift-ri! [(b (ptr Buf)) (op i64) (w bool) (r u8) (imm i64)] (-> void)
  (rr! b 0 w 0xC1 (u8-of op) r false)
  (e8! b imm))

;;; shld/shrd dst, src, imm (the double shifts of 128-bit values).
(defn shld-ri! [(b (ptr Buf)) (dst u8) (src u8) (imm i64)] (-> void)
  (rr! b 0 true 0x0FA4 src dst false)
  (e8! b imm))

(defn shrd-ri! [(b (ptr Buf)) (dst u8) (src u8) (imm i64)] (-> void)
  (rr! b 0 true 0x0FAC src dst false)
  (e8! b imm))

(defn shld-cl! [(b (ptr Buf)) (dst u8) (src u8)] (-> void)
  (rr! b 0 true 0x0FA5 src dst false))

(defn shrd-cl! [(b (ptr Buf)) (dst u8) (src u8)] (-> void)
  (rr! b 0 true 0x0FAD src dst false))

(defn setcc! [(b (ptr Buf)) (cc i64) (r u8)] (-> void)
  (rr! b 0 false (+ 0x0F90 cc) (: 0 u8) r true))

(defn cmovcc! [(b (ptr Buf)) (cc i64) (w bool) (dst u8) (src u8)] (-> void)
  (rr! b 0 w (+ 0x0F40 cc) dst src false))

(defn bswap! [(b (ptr Buf)) (w bool) (r u8)] (-> void)
  (rex! b w (: 0 u8) (: 255 u8) r false)
  (e8! b 0x0F)
  (e8! b (+ 0xC8 (& (i r) 7))))

(defn lzcnt! [(b (ptr Buf)) (w bool) (dst u8) (src u8)] (-> void)
  (rr! b 0xF3 w 0x0FBD dst src false))

(defn tzcnt! [(b (ptr Buf)) (w bool) (dst u8) (src u8)] (-> void)
  (rr! b 0xF3 w 0x0FBC dst src false))

(defn popcnt! [(b (ptr Buf)) (w bool) (dst u8) (src u8)] (-> void)
  (rr! b 0xF3 w 0x0FB8 dst src false))

(defn bsr! [(b (ptr Buf)) (w bool) (dst u8) (src u8)] (-> void)
  (rr! b 0 w 0x0FBD dst src false))

(defn bsf! [(b (ptr Buf)) (w bool) (dst u8) (src u8)] (-> void)
  (rr! b 0 w 0x0FBC dst src false))

;;; CF = bit `imm` of r.
(defn bt-ri! [(b (ptr Buf)) (w bool) (r u8) (imm i64)] (-> void)
  (rr! b 0 w 0x0FBA (: 4 u8) r false)
  (e8! b imm))

; ============================ atomics ========================================

(defn lock! [(b (ptr Buf))] (-> void)
  (e8! b 0xF0))

;;; lock cmpxchg [m], src (compares with rax/eax/ax/al).
(defn lock-cmpxchg! [(b (ptr Buf)) (m Mem) (src u8) (size i64)] (-> void)
  (lock! b)
  (cond (= size 1) (rm! b 0 false 0x0FB0 src m true)
        (= size 2) (rm! b 0x66 false 0x0FB1 src m false)
        :else (rm! b 0 (= size 8) 0x0FB1 src m false)))

;;; lock xadd [m], src.
(defn lock-xadd! [(b (ptr Buf)) (m Mem) (src u8) (size i64)] (-> void)
  (lock! b)
  (cond (= size 1) (rm! b 0 false 0x0FC0 src m true)
        (= size 2) (rm! b 0x66 false 0x0FC1 src m false)
        :else (rm! b 0 (= size 8) 0x0FC1 src m false)))

;;; xchg [m], src (implicitly locked).
(defn xchg-m! [(b (ptr Buf)) (m Mem) (src u8) (size i64)] (-> void)
  (cond (= size 1) (rm! b 0 false 0x86 src m true)
        (= size 2) (rm! b 0x66 false 0x87 src m false)
        :else (rm! b 0 (= size 8) 0x87 src m false)))

(defn mfence! [(b (ptr Buf))] (-> void)
  (e8! b 0x0F)
  (e8! b 0xAE)
  (e8! b 0xF0))

; ============================ control flow ===================================

;;; Jcc rel32 (6 bytes; `rel` from the end of the instruction).
(defn jcc32! [(b (ptr Buf)) (cc i64) (rel i64)] (-> void)
  (e8! b 0x0F)
  (e8! b (+ 0x80 cc))
  (e32! b rel))

;;; Jcc rel8 (2 bytes).
(defn jcc8! [(b (ptr Buf)) (cc i64) (rel i64)] (-> void)
  (e8! b (+ 0x70 cc))
  (e8! b rel))

(defn jmp32! [(b (ptr Buf)) (rel i64)] (-> void)
  (e8! b 0xE9)
  (e32! b rel))

(defn jmp8! [(b (ptr Buf)) (rel i64)] (-> void)
  (e8! b 0xEB)
  (e8! b rel))

(defn jmp-r! [(b (ptr Buf)) (r u8)] (-> void)
  (rr! b 0 false 0xFF (: 4 u8) r false))

(defn jmp-m! [(b (ptr Buf)) (m Mem)] (-> void)
  (rm! b 0 false 0xFF (: 4 u8) m false))

(defn call32! [(b (ptr Buf)) (rel i64)] (-> void)
  (e8! b 0xE8)
  (e32! b rel))

(defn call-r! [(b (ptr Buf)) (r u8)] (-> void)
  (rr! b 0 false 0xFF (: 2 u8) r false))

(defn call-m! [(b (ptr Buf)) (m Mem)] (-> void)
  (rm! b 0 false 0xFF (: 2 u8) m false))

(defn ret! [(b (ptr Buf))] (-> void)
  (e8! b 0xC3))

(defn push! [(b (ptr Buf)) (r u8)] (-> void)
  (when (ext? r) (e8! b 0x41))
  (e8! b (+ 0x50 (& (i r) 7))))

(defn pop! [(b (ptr Buf)) (r u8)] (-> void)
  (when (ext? r) (e8! b 0x41))
  (e8! b (+ 0x58 (& (i r) 7))))

(defn ud2! [(b (ptr Buf))] (-> void)
  (e8! b 0x0F)
  (e8! b 0x0B))

(defn int3! [(b (ptr Buf))] (-> void)
  (e8! b 0xCC))

(defn nop! [(b (ptr Buf))] (-> void)
  (e8! b 0x90))

;;; `n` bytes of the SDM's multi-byte NOPs (fadec's fe64_NOP).
(defn nop-n! [(b (ptr Buf)) (n i64)] (-> void)
  (let [(mut rem) n]
    (while (> rem 9) (nop-k! b 9) (set! rem (- rem 9)))
    (nop-k! b rem)))

(defn nop-k! [(b (ptr Buf)) (k i64)] (-> void)
  (cond (= k 1) (e8! b 0x90)
        (= k 2) (do (e8! b 0x66) (e8! b 0x90))
        (= k 3) (do (e8! b 0x0F) (e8! b 0x1F) (e8! b 0x00))
        (= k 4) (do (e8! b 0x0F) (e8! b 0x1F) (e8! b 0x40) (e8! b 0))
        (= k 5) (do (e8! b 0x0F) (e8! b 0x1F) (e8! b 0x44) (e8! b 0) (e8! b 0))
        (= k 6)
          (do
            (e8! b 0x66)
            (e8! b 0x0F)
            (e8! b 0x1F)
            (e8! b 0x44)
            (e8! b 0)
            (e8! b 0))
        (= k 7) (do (e8! b 0x0F) (e8! b 0x1F) (e8! b 0x80) (e32! b 0))
        (= k 8) (do (e8! b 0x0F) (e8! b 0x1F) (e8! b 0x84) (e8! b 0) (e32! b 0))
        (= k 9)
          (do
            (e8! b 0x66)
            (e8! b 0x0F)
            (e8! b 0x1F)
            (e8! b 0x84)
            (e8! b 0)
            (e32! b 0))
        :else 0))

; ============================ SSE ============================================
; XMM operands are register numbers 0..15 (or the core's 32..47).

(defn x [(r u8)] (-> u8)
  (& r (: 15 u8)))

(defn sse-rr! [(b (ptr Buf)) (pfx i64) (w bool) (op i64) (reg u8) (rm u8)]
  (-> void)
  (rr! b pfx w op (x reg) (x rm) false))

(defn sse-rm! [(b (ptr Buf)) (pfx i64) (w bool) (op i64) (reg u8) (m Mem)]
  (-> void)
  (rm! b pfx w op (x reg) m false))

;;; xmm = [m]: 4 (movss), 8 (movsd), 16 (movups) bytes.
(defn sse-load! [(b (ptr Buf)) (dst u8) (m Mem) (size i64)] (-> void)
  (cond (= size 4) (sse-rm! b 0xF3 false 0x0F10 dst m)
        (= size 8) (sse-rm! b 0xF2 false 0x0F10 dst m)
        :else (sse-rm! b 0 false 0x0F10 dst m)))

(defn sse-store! [(b (ptr Buf)) (m Mem) (src u8) (size i64)] (-> void)
  (cond (= size 4) (sse-rm! b 0xF3 false 0x0F11 src m)
        (= size 8) (sse-rm! b 0xF2 false 0x0F11 src m)
        :else (sse-rm! b 0 false 0x0F11 src m)))

;;; xmm = xmm (all 128 bits).
(defn movaps! [(b (ptr Buf)) (dst u8) (src u8)] (-> void)
  (sse-rr! b 0 false 0x0F28 dst src))

;;; xmm = gp (movd/movq, upper bits zeroed).
(defn movq-xg! [(b (ptr Buf)) (w bool) (dst u8) (src u8)] (-> void)
  (rr! b 0x66 w 0x0F6E (x dst) src false))

;;; gp = xmm (movd/movq).
(defn movq-gx! [(b (ptr Buf)) (w bool) (dst u8) (src u8)] (-> void)
  (rr! b 0x66 w 0x0F7E (x src) dst false))

;;; Scalar arithmetic (SSE-ADD …): `double` selects sd over ss.
(defn sse-arith! [(b (ptr Buf)) (op i64) (double bool) (dst u8) (src u8)]
  (-> void)
  (sse-rr! b (if double 0xF2 0xF3) false (+ 0x0F00 op) dst src))

;;; Packed logic (SSE-AND …): the ps form, or pd with `double`.
(defn sse-logic! [(b (ptr Buf)) (op i64) (double bool) (dst u8) (src u8)]
  (-> void)
  (sse-rr! b (if double 0x66 0) false (+ 0x0F00 op) dst src))

;;; ucomiss/ucomisd a, b.
(defn ucomis! [(b (ptr Buf)) (double bool) (a u8) (c u8)] (-> void)
  (sse-rr! b (if double 0x66 0) false 0x0F2E a c))

;;; xmm = (float/double) gp; `w` for a 64-bit integer.
(defn cvtsi2s! [(b (ptr Buf)) (double bool) (w bool) (dst u8) (src u8)]
  (-> void)
  (rr! b (if double 0xF2 0xF3) w 0x0F2A (x dst) src false))

;;; gp = truncate xmm; `w` for a 64-bit integer.
(defn cvtts2si! [(b (ptr Buf)) (double bool) (w bool) (dst u8) (src u8)]
  (-> void)
  (rr! b (if double 0xF2 0xF3) w 0x0F2C dst (x src) false))

;;; double = float (cvtss2sd), or float = double with `to-double` false.
(defn cvt-ss-sd! [(b (ptr Buf)) (to-double bool) (dst u8) (src u8)] (-> void)
  (sse-rr! b (if to-double 0xF3 0xF2) false 0x0F5A dst src))

;;; roundss/roundsd (SSE4.1): mode 0 nearest even, 1 down, 2 up, 3 toward zero.
(defn rounds! [(b (ptr Buf)) (double bool) (dst u8) (src u8) (mode i64)]
  (-> void)
  (sse-rr! b 0x66 false (if double 0x0F3A0B 0x0F3A0A) dst src)
  (e8! b mode))
