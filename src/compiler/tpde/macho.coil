; Ported to Coil from TPDE (commit 9779acf) and modified; see NOTICE.
;;; Mach-O MH_OBJECT writer for arm64 and x86-64 (TPDE only has ELF).
;;; Serializes a `tpde.asm` Asm.
;;;
;;; Symbols get the C `_` prefix; anonymous ones become local `ltmpN`. The symbol
;;; table is ordered locals, external definitions, undefined, as LC_DYSYMTAB
;;; requires, and relocations are renumbered to match. A PAGE21/PAGEOFF12/
;;; BRANCH26 relocation with an addend is preceded by ARM64_RELOC_ADDEND; an
;;; ABS64 addend is stored in the data, Mach-O's implicit addend. On x86-64
;;; every addend is implicit: it goes into the relocated field.
(module tpde.macho)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "tpde.buf" :as buf :use [Buf])
(import "tpde.asm" :as asm :use [Asm Section Symbol Reloc])

; arm64 relocation types
(const ARM64-RELOC-UNSIGNED 0)

(const ARM64-RELOC-BRANCH26 2)

(const ARM64-RELOC-PAGE21 3)

(const ARM64-RELOC-PAGEOFF12 4)

(const ARM64-RELOC-GOT-LOAD-PAGE21 5)

(const ARM64-RELOC-GOT-LOAD-PAGEOFF12 6)

(const ARM64-RELOC-ADDEND 10)

(defn align-up [(v i64) (align i64)] (-> i64)
  (& (+ v (- align 1)) (- 0 align)))

(defn name16! [(out (ptr Buf)) (s (slice u8))] (-> void)
  (let [n (if (> (len s) 16) 16 (len s))]
    (buf/emit-bytes! out (data s) n)
    (buf/emit-zeros! out (- 16 n))))

(defn u32! [(out (ptr Buf)) (x i64)] (-> void)
  (buf/emit32! out (primitive/cast u32 x)))

(defn u64! [(out (ptr Buf)) (x i64)] (-> void)
  (buf/emit64! out (primitive/cast u64 x)))

; x86-64 relocation types
(const X86-64-RELOC-UNSIGNED 0)

(const X86-64-RELOC-SIGNED 1)

(const X86-64-RELOC-BRANCH 2)

(const X86-64-RELOC-GOT-LOAD 3)

(defn reloc-type-x64 [(kind u8)] (-> i64)
  (case (cast i64 kind)
    5 X86-64-RELOC-UNSIGNED
    6 X86-64-RELOC-SIGNED
    7 X86-64-RELOC-BRANCH
    8 X86-64-RELOC-GOT-LOAD
    -1))

(defn reloc-type [(kind u8)] (-> i64)
  (case (cast i64 kind)
    0 ARM64-RELOC-BRANCH26
    1 ARM64-RELOC-PAGE21
    2 ARM64-RELOC-PAGEOFF12
    3 ARM64-RELOC-GOT-LOAD-PAGE21
    4 ARM64-RELOC-GOT-LOAD-PAGEOFF12
    5 ARM64-RELOC-UNSIGNED
    -1))

(defn reloc-pcrel? [(kind u8)] (-> bool)
  (or (= kind (: 0 u8)) (= kind (: 1 u8)) (= kind (: 3 u8))))

(defn reloc-word [(symnum i64) (pcrel bool) (length i64) (ext bool) (rtype i64)]
  (-> i64)
  (| (& symnum 0xFFFFFF)
     (if pcrel (<< 1 24) 0)
     (<< length 25)
     (if ext (<< 1 27) 0)
     (<< rtype 28)))

(defn emit-sym-name! [(strtab (ptr Buf)) (s (ptr Symbol)) (idx i64)] (-> void)
  (if (empty? (.name s))
      (do
        (buf/emit-slice! strtab "ltmp")
        (let [(mut digits)
                [(: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)
                 (: 0 u8)]
              (mut n) 0
              (mut v) idx]
          (loop (set! (mut digits) n (cast u8 (+ (% v 10) 48)))
            (set! n (+ n 1))
            (set! v (/ v 10))
            (when (= v 0) (break)))
          (let [(mut i) (- n 1)]
            (while (>= i 0)
              (buf/emit8! strtab (get digits i))
              (set! i (- i 1))))))
      (do
        (buf/emit8! strtab #\_)
        (buf/emit-slice! strtab (.name s))))
  (buf/emit8! strtab (: 0 u8)))

;;; Serialize `a` as a Mach-O object into `out`. Writes ABS64 addends into the
;;; section data.
(defn write-object! [(a (ptr Asm)) (out (ptr Buf))] (-> void)
  (write! a out false))

;;; The same for an x86-64 object.
(defn write-object-x64! [(a (ptr Asm)) (out (ptr Buf))] (-> void)
  (write! a out true))

(defn write! [(a (ptr Asm)) (out (ptr Buf)) (x64 bool)] (-> void)
  (let [al (malloc-allocator)
        nsect (len (.sects a))
        nsym (cast i64 (asm/sym-count a))
        nrel (len (.relocs a))
        (mut order) (ArrayList::new [i64] al)
        (mut perm) (ArrayList::new [i64] al)
        (mut nlocal) 0
        (mut nextdef) 0
        (mut nundef) 0]
    (extend-zeroed! (mut perm) nsym)
    ; ---- symbol order: locals, external definitions, undefined
    (for pass (range 0 3)
      (for i (range 0 nsym)
        (let [s (asm/sym-at a (cast u32 i))
              defined (>= (.sect s) 0)
              ext (!= (.binding s) (: 0 u8))
              take
                (case pass
                  0 (and defined (not ext))
                  1 (and defined ext)
                  (not defined))]
          (when take
            (set! (mut perm) i (len order))
            (push! (mut order) i)
            (case pass
              0 (set! nlocal (+ nlocal 1))
              1 (set! nextdef (+ nextdef 1))
              (set! nundef (+ nundef 1)))))))
    ; ---- implicit ABS64 addends go into the data (on x86-64, every addend)
    (for ri (range 0 nrel)
      (let [r (get (.relocs a) ri)]
        (cond (= (.kind r) (: 5 u8))
                (buf/patch64! (asm/sect-buf a (.sect r))
                              (.off r)
                              (cast u64 (.addend r)))
              x64
                (buf/patch32! (asm/sect-buf a (.sect r))
                              (.off r)
                              (cast u32 (.addend r)))
              :else 0)))
    ; ---- section addresses (zero-fill sections last) and file offsets
    (let [(mut addrs) (ArrayList::new [i64] al)
          (mut sizes) (ArrayList::new [i64] al)
          (mut foffs) (ArrayList::new [i64] al)
          (mut vm) 0
          ncmds 4
          sizeofcmds (+ (+ 72 (* 80 nsect)) (+ 24 (+ 24 80)))
          hdrend (+ 32 sizeofcmds)
          (mut fo) hdrend]
      (extend-zeroed! (mut addrs) nsect)
      (extend-zeroed! (mut sizes) nsect)
      (extend-zeroed! (mut foffs) nsect)
      (for zpass (range 0 2)
        (for i (range 0 nsect)
          (let [s (asm/sect-at a i)
                zf (= (& (.flags s) (: 0xFF u32)) (: 1 u32))]
            (when (= zf (= zpass 1))
              (let [size (if zf (.zsize s) (.len (.data s)))]
                (set! vm (align-up vm (<< 1 (.align s))))
                (set! (mut addrs) i vm)
                (set! (mut sizes) i size)
                (set! vm (+ vm size))
                (when (not zf)
                  (set! fo (align-up fo (<< 1 (.align s))))
                  (set! (mut foffs) i fo)
                  (set! fo (+ fo size))))))))
      (let [file-end-sections fo
            first-foff (get foffs 0)]
        ; ---- relocations per section: count entries, ADDEND pairs included
        (set! fo (align-up fo 8))
        (let [(mut reloffs) (ArrayList::new [i64] al)
              (mut nrelocs) (ArrayList::new [i64] al)]
          (extend-zeroed! (mut reloffs) nsect)
          (extend-zeroed! (mut nrelocs) nsect)
          (for ri (range 0 nrel)
            (let [r (get (.relocs a) ri)
                  extra
                    (if (and (not x64)
                             (!= (.addend r) 0)
                             (!= (.kind r) (: 5 u8)))
                        2
                        1)]
              (set! (mut nrelocs) (.sect r) (+ (get nrelocs (.sect r)) extra))))
          (for i (range 0 nsect)
            (when (> (get nrelocs i) 0)
              (set! (mut reloffs) i fo)
              (set! fo (+ fo (* 8 (get nrelocs i))))))
          (let [symoff (align-up fo 8)
                stroff (+ symoff (* 16 nsym))
                (mut strtab) (Buf::new)
                (mut strx) (ArrayList::new [i64] al)]
            (buf/emit8! (cast (ptr Buf) (mut strtab)) (: 0 u8))
            (for i (range 0 nsym)
              (let [ci (get order i)]
                (push! (mut strx) (.len strtab))
                (emit-sym-name! (cast (ptr Buf) (mut strtab))
                                (asm/sym-at a (cast u32 ci))
                                ci)))
            (buf/buf-reserve! out (+ stroff (.len strtab)))
            ; ---- header
            (u32! out 0xFEEDFACF)
            (u32! out (if x64 0x01000007 0x0100000C))  ; CPU_TYPE_X86_64 / ARM64
            (u32! out (if x64 3 0))  ; CPU_SUBTYPE_X86_64_ALL
            (u32! out 1)  ; MH_OBJECT
            (u32! out ncmds)
            (u32! out sizeofcmds)
            (u32! out 0x2000)  ; MH_SUBSECTIONS_VIA_SYMBOLS
            (u32! out 0)
            ; ---- LC_SEGMENT_64
            (u32! out 25)
            (u32! out (+ 72 (* 80 nsect)))
            (name16! out "")
            (u64! out 0)
            (u64! out vm)
            (u64! out first-foff)
            (u64! out (- file-end-sections first-foff))
            (u32! out 7)
            (u32! out 7)
            (u32! out nsect)
            (u32! out 0)
            (for i (range 0 nsect)
              (let [s (asm/sect-at a i)
                    zf (= (& (.flags s) (: 0xFF u32)) (: 1 u32))]
                (name16! out (.sectname s))
                (name16! out (.segname s))
                (u64! out (get addrs i))
                (u64! out (get sizes i))
                (u32! out (if zf 0 (get foffs i)))
                (u32! out (.align s))
                (u32! out (get reloffs i))
                (u32! out (get nrelocs i))
                (u32! out (cast i64 (.flags s)))
                (u32! out 0)
                (u32! out 0)
                (u32! out 0)))
            ; ---- LC_BUILD_VERSION (macOS 11.0)
            (u32! out 50)
            (u32! out 24)
            (u32! out 1)
            (u32! out 0x000B0000)
            (u32! out 0)
            (u32! out 0)
            ; ---- LC_SYMTAB
            (u32! out 2)
            (u32! out 24)
            (u32! out symoff)
            (u32! out nsym)
            (u32! out stroff)
            (u32! out (.len strtab))
            ; ---- LC_DYSYMTAB
            (u32! out 11)
            (u32! out 80)
            (u32! out 0)
            (u32! out nlocal)
            (u32! out nlocal)
            (u32! out nextdef)
            (u32! out (+ nlocal nextdef))
            (u32! out nundef)
            (buf/emit-zeros! out (* 4 12))
            ; ---- section contents
            (for i (range 0 nsect)
              (let [s (asm/sect-at a i)
                    zf (= (& (.flags s) (: 0xFF u32)) (: 1 u32))]
                (when (not zf)
                  (buf/emit-zeros! out (- (get foffs i) (.len out)))
                  (buf/emit-bytes! out (.data (.data s)) (.len (.data s))))))
            ; ---- relocations
            (buf/emit-zeros! out (- (align-up (.len out) 8) (.len out)))
            (for si (range 0 nsect)
              (for ri (range 0 nrel)
                (let [r (get (.relocs a) ri)]
                  (when (= (.sect r) si)
                    (let [rt
                            (if x64
                                (reloc-type-x64 (.kind r))
                                (reloc-type (.kind r)))
                          pc
                            (if x64
                                (!= (.kind r) (: 5 u8))
                                (reloc-pcrel? (.kind r)))
                          length (if (= (.kind r) (: 5 u8)) 3 2)
                          symnum (get perm (cast i64 (.sym r)))]
                      (when (and (not x64)
                                 (!= (.addend r) 0)
                                 (!= (.kind r) (: 5 u8)))
                        (u32! out (.off r))
                        (u32! out
                              (reloc-word (& (.addend r) 0xFFFFFF)
                                          false
                                          2
                                          false
                                          ARM64-RELOC-ADDEND)))
                      (u32! out (.off r))
                      (u32! out (reloc-word symnum pc length true rt)))))))
            ; ---- nlist symbols
            (buf/emit-zeros! out (- symoff (.len out)))
            (for i (range 0 nsym)
              (let [ci (get order i)
                    s (asm/sym-at a (cast u32 ci))]
                (u32! out (get strx i))
                (if (< (.sect s) 0)
                    (do
                      (buf/emit8! out (: 1 u8))
                      (buf/emit8! out (: 0 u8))
                      (buf/emit16! out (: 0 u16))
                      (u64! out 0))
                    (do
                      (buf/emit8! out
                                  (if (= (.binding s) (: 0 u8))
                                      (: 14 u8)
                                      (: 15 u8)))
                      (buf/emit8! out (cast u8 (+ (.sect s) 1)))
                      (buf/emit16! out
                                   (if (= (.binding s) (: 2 u8))
                                       (: 128 u16)
                                       (: 0 u16)))
                      (u64! out (+ (get addrs (.sect s)) (.off s)))))))
            (buf/emit-bytes! out (.data strtab) (.len strtab))
            (buf/buf-free! (cast (ptr Buf) (mut strtab)))))))
    (free! (mut order))
    (free! (mut perm))))
