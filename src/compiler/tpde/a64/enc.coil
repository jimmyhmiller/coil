; SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
; Ported to Coil from TPDE (commit 9779acf) and modified; see NOTICE.
;;; AArch64 instruction encoders. Each function returns the 32-bit instruction
;;; word; registers are 0–31 (31 is SP or ZR, by instruction). This plays the
;;; part of disarm64 in TPDE. `sf` selects the 64-bit form.
(module tpde.a64.enc)
(import "coil.primitive" :as primitive)

; ---- condition codes ----
(const EQ 0)

(const NE 1)

(const CS 2)

(const CC 3)

(const MI 4)

(const PL 5)

(const VS 6)

(const VC 7)

(const HI 8)

(const LS 9)

(const GE 10)

(const LT 11)

(const GT 12)

(const LE 13)

(const AL 14)

(const SP 31)

(const ZR 31)

(const FP 29)

(const LR 30)

(defn u [(x i64)] (-> u32)
  (primitive/cast u32 x))

(defn sfb [(sf bool)] (-> u32)
  (if sf (: 0x80000000 u32) (: 0 u32)))

(defn r [(x u32)] (-> u32)
  (& x (: 31 u32)))

(defn invert-cond [(c u32)] (-> u32)
  (^ c (: 1 u32)))

; ---- add/sub immediate ----
;; Whether `imm` is encodable as an add/sub immediate (12 bits, optionally << 12).
(defn addsub-imm? [(imm i64)] (-> bool)
  (or (and (>= imm 0) (< imm 4096))
      (and (>= imm 0) (= (& imm 0xfff) 0) (< imm 0x1000000))))

(defn addsub-imm-bits [(imm i64)] (-> u32)
  (if (< imm 4096)
      (<< (u imm) (: 10 u32))
      (| (: 0x400000 u32) (<< (u (>> imm 12)) (: 10 u32)))))

(defn add-imm [(sf bool) (rd u32) (rn u32) (imm i64)] (-> u32)
  (| (sfb sf)
     (: 0x11000000 u32)
     (addsub-imm-bits imm)
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn sub-imm [(sf bool) (rd u32) (rn u32) (imm i64)] (-> u32)
  (| (sfb sf)
     (: 0x51000000 u32)
     (addsub-imm-bits imm)
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn adds-imm [(sf bool) (rd u32) (rn u32) (imm i64)] (-> u32)
  (| (sfb sf)
     (: 0x31000000 u32)
     (addsub-imm-bits imm)
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn subs-imm [(sf bool) (rd u32) (rn u32) (imm i64)] (-> u32)
  (| (sfb sf)
     (: 0x71000000 u32)
     (addsub-imm-bits imm)
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn cmp-imm [(sf bool) (rn u32) (imm i64)] (-> u32)
  (subs-imm sf (: 31 u32) rn imm))

(defn cmn-imm [(sf bool) (rn u32) (imm i64)] (-> u32)
  (adds-imm sf (: 31 u32) rn imm))

;; mov to/from sp
(defn mov-sp [(rd u32) (rn u32)] (-> u32)
  (add-imm true rd rn 0))

; ---- add/sub shifted register (shift: 0 lsl, 1 lsr, 2 asr) ----
(defn addsub-reg [(base u32)
                  (sf bool)
                  (rd u32)
                  (rn u32)
                  (rm u32)
                  (shift u32)
                  (amt u32)] (-> u32)
  (| (sfb sf)
     base
     (<< shift (: 22 u32))
     (<< (r rm) (: 16 u32))
     (<< amt (: 10 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn add-reg [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (addsub-reg (: 0x0B000000 u32) sf rd rn rm (: 0 u32) (: 0 u32)))

(defn sub-reg [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (addsub-reg (: 0x4B000000 u32) sf rd rn rm (: 0 u32) (: 0 u32)))

(defn adds-reg [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (addsub-reg (: 0x2B000000 u32) sf rd rn rm (: 0 u32) (: 0 u32)))

(defn subs-reg [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (addsub-reg (: 0x6B000000 u32) sf rd rn rm (: 0 u32) (: 0 u32)))

(defn add-lsl [(sf bool) (rd u32) (rn u32) (rm u32) (amt u32)] (-> u32)
  (addsub-reg (: 0x0B000000 u32) sf rd rn rm (: 0 u32) amt))

(defn sub-lsl [(sf bool) (rd u32) (rn u32) (rm u32) (amt u32)] (-> u32)
  (addsub-reg (: 0x4B000000 u32) sf rd rn rm (: 0 u32) amt))

(defn cmp-reg [(sf bool) (rn u32) (rm u32)] (-> u32)
  (subs-reg sf (: 31 u32) rn rm))

(defn cmn-reg [(sf bool) (rn u32) (rm u32)] (-> u32)
  (adds-reg sf (: 31 u32) rn rm))

(defn neg-reg [(sf bool) (rd u32) (rm u32)] (-> u32)
  (sub-reg sf rd (: 31 u32) rm))

(defn negs-reg [(sf bool) (rd u32) (rm u32)] (-> u32)
  (subs-reg sf rd (: 31 u32) rm))

(defn adc [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (| (sfb sf)
     (: 0x1A000000 u32)
     (<< (r rm) (: 16 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn adcs [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (| (sfb sf)
     (: 0x3A000000 u32)
     (<< (r rm) (: 16 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn sbc [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (| (sfb sf)
     (: 0x5A000000 u32)
     (<< (r rm) (: 16 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn sbcs [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (| (sfb sf)
     (: 0x7A000000 u32)
     (<< (r rm) (: 16 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

; ---- add/sub extended register (option: 2 uxtw, 3 uxtx, 6 sxtw, 7 sxtx) ----
(defn add-ext [(sf bool) (rd u32) (rn u32) (rm u32) (option u32) (amt u32)]
  (-> u32)
  (| (sfb sf)
     (: 0x0B200000 u32)
     (<< (r rm) (: 16 u32))
     (<< option (: 13 u32))
     (<< amt (: 10 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn sub-ext [(sf bool) (rd u32) (rn u32) (rm u32) (option u32) (amt u32)]
  (-> u32)
  (| (sfb sf)
     (: 0x4B200000 u32)
     (<< (r rm) (: 16 u32))
     (<< option (: 13 u32))
     (<< amt (: 10 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

; ---- logical shifted register ----
(defn logic-reg [(base u32)
                 (sf bool)
                 (rd u32)
                 (rn u32)
                 (rm u32)
                 (shift u32)
                 (amt u32)] (-> u32)
  (| (sfb sf)
     base
     (<< shift (: 22 u32))
     (<< (r rm) (: 16 u32))
     (<< amt (: 10 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn and-reg [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (logic-reg (: 0x0A000000 u32) sf rd rn rm (: 0 u32) (: 0 u32)))

(defn bic-reg [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (logic-reg (: 0x0A200000 u32) sf rd rn rm (: 0 u32) (: 0 u32)))

(defn orr-reg [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (logic-reg (: 0x2A000000 u32) sf rd rn rm (: 0 u32) (: 0 u32)))

(defn orn-reg [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (logic-reg (: 0x2A200000 u32) sf rd rn rm (: 0 u32) (: 0 u32)))

(defn eor-reg [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (logic-reg (: 0x4A000000 u32) sf rd rn rm (: 0 u32) (: 0 u32)))

(defn eon-reg [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (logic-reg (: 0x4A200000 u32) sf rd rn rm (: 0 u32) (: 0 u32)))

(defn ands-reg [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (logic-reg (: 0x6A000000 u32) sf rd rn rm (: 0 u32) (: 0 u32)))

(defn tst-reg [(sf bool) (rn u32) (rm u32)] (-> u32)
  (ands-reg sf (: 31 u32) rn rm))

(defn mov-reg [(sf bool) (rd u32) (rm u32)] (-> u32)
  (orr-reg sf rd (: 31 u32) rm))

(defn mvn-reg [(sf bool) (rd u32) (rm u32)] (-> u32)
  (orn-reg sf rd (: 31 u32) rm))

(defn orr-lsl [(sf bool) (rd u32) (rn u32) (rm u32) (amt u32)] (-> u32)
  (logic-reg (: 0x2A000000 u32) sf rd rn rm (: 0 u32) amt))

(defn orr-lsr [(sf bool) (rd u32) (rn u32) (rm u32) (amt u32)] (-> u32)
  (logic-reg (: 0x2A000000 u32) sf rd rn rm (: 1 u32) amt))

; ---- logical immediate ----
(defn rotr-n [(x u64) (n u64) (size u64)] (-> u64)
  (if (= n (: 0 u64))
      x
      (let [m
              (if (= size (: 64 u64))
                  (: 0xFFFFFFFFFFFFFFFF u64)
                  (- (<< (: 1 u64) size) (: 1 u64)))]
        (& (| (>> x n) (<< x (- size n))) m))))

;; The N:immr:imms bits (N<<12 | immr<<6 | imms) of `val` as a bitmask
;; immediate, or -1 when it has none.
(defn logical-imm [(val0 u64) (sf bool)] (-> i64)
  (let [val
          (if sf
              val0
              (| (& val0 (: 0xFFFFFFFF u64))
                 (<< (& val0 (: 0xFFFFFFFF u64)) (: 32 u64))))]
    (if (or (= val (: 0 u64)) (= val (: 0xFFFFFFFFFFFFFFFF u64)))
        -1
        (let [(mut size) (: 64 u64)]
          (block :shrink
            (while (> size (: 2 u64))
              (let [half (>> size (: 1 u64))
                    m (- (<< (: 1 u64) half) (: 1 u64))]
                (when (!= (& val m) (& (>> val half) m))
                  (return-from :shrink 0))
                (set! size half)))
            0)
          (let [mask
                  (if (= size (: 64 u64))
                      (: 0xFFFFFFFFFFFFFFFF u64)
                      (- (<< (: 1 u64) size) (: 1 u64)))
                elem (& val mask)
                ones (primitive/popcount elem)
                ; rotate the run of ones down to bit 0
                rot
                  (if (= (& elem (: 1 u64)) (: 0 u64))
                      (primitive/ctz elem)
                      (let [z (primitive/ctz (& (^ elem mask) mask))]
                        (% (+ z (- size ones)) size)))
                low (rotr-n elem rot size)
                want (- (<< (: 1 u64) ones) (: 1 u64))]
            (if (!= low want)
                -1
                (let [immr (% (- size rot) size)
                      imms
                        (& (| (<< (^ (- size (: 1 u64))
                                     (: 0xFFFFFFFFFFFFFFFF u64))
                                  (: 1 u64))
                              (- ones (: 1 u64)))
                           (: 0x3F u64))
                      n (if (= size (: 64 u64)) (: 1 u64) (: 0 u64))]
                  (primitive/cast i64
                                  (| (<< n (: 12 u64)) (<< immr (: 6 u64)) imms)))))))))

(defn logic-imm [(base u32) (sf bool) (rd u32) (rn u32) (bits i64)] (-> u32)
  (| (sfb sf) base (<< (u bits) (: 10 u32)) (<< (r rn) (: 5 u32)) (r rd)))

(defn and-imm [(sf bool) (rd u32) (rn u32) (bits i64)] (-> u32)
  (logic-imm (: 0x12000000 u32) sf rd rn bits))

(defn orr-imm [(sf bool) (rd u32) (rn u32) (bits i64)] (-> u32)
  (logic-imm (: 0x32000000 u32) sf rd rn bits))

(defn eor-imm [(sf bool) (rd u32) (rn u32) (bits i64)] (-> u32)
  (logic-imm (: 0x52000000 u32) sf rd rn bits))

(defn ands-imm [(sf bool) (rd u32) (rn u32) (bits i64)] (-> u32)
  (logic-imm (: 0x72000000 u32) sf rd rn bits))

; ---- move wide ----
(defn movz [(sf bool) (rd u32) (imm16 u32) (hw u32)] (-> u32)
  (| (sfb sf)
     (: 0x52800000 u32)
     (<< hw (: 21 u32))
     (<< (& imm16 (: 0xFFFF u32)) (: 5 u32))
     (r rd)))

(defn movn [(sf bool) (rd u32) (imm16 u32) (hw u32)] (-> u32)
  (| (sfb sf)
     (: 0x12800000 u32)
     (<< hw (: 21 u32))
     (<< (& imm16 (: 0xFFFF u32)) (: 5 u32))
     (r rd)))

(defn movk [(sf bool) (rd u32) (imm16 u32) (hw u32)] (-> u32)
  (| (sfb sf)
     (: 0x72800000 u32)
     (<< hw (: 21 u32))
     (<< (& imm16 (: 0xFFFF u32)) (: 5 u32))
     (r rd)))

; ---- data processing (2 source) ----
(defn dp2 [(base u32) (sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (| (sfb sf) base (<< (r rm) (: 16 u32)) (<< (r rn) (: 5 u32)) (r rd)))

(defn udiv [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (dp2 (: 0x1AC00800 u32) sf rd rn rm))

(defn sdiv [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (dp2 (: 0x1AC00C00 u32) sf rd rn rm))

(defn lslv [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (dp2 (: 0x1AC02000 u32) sf rd rn rm))

(defn lsrv [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (dp2 (: 0x1AC02400 u32) sf rd rn rm))

(defn asrv [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (dp2 (: 0x1AC02800 u32) sf rd rn rm))

(defn rorv [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (dp2 (: 0x1AC02C00 u32) sf rd rn rm))

; ---- data processing (3 source) ----
(defn madd [(sf bool) (rd u32) (rn u32) (rm u32) (ra u32)] (-> u32)
  (| (sfb sf)
     (: 0x1B000000 u32)
     (<< (r rm) (: 16 u32))
     (<< (r ra) (: 10 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn msub [(sf bool) (rd u32) (rn u32) (rm u32) (ra u32)] (-> u32)
  (| (sfb sf)
     (: 0x1B008000 u32)
     (<< (r rm) (: 16 u32))
     (<< (r ra) (: 10 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn mul [(sf bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (madd sf rd rn rm (: 31 u32)))

(defn smulh [(rd u32) (rn u32) (rm u32)] (-> u32)
  (| (: 0x9B407C00 u32) (<< (r rm) (: 16 u32)) (<< (r rn) (: 5 u32)) (r rd)))

(defn umulh [(rd u32) (rn u32) (rm u32)] (-> u32)
  (| (: 0x9BC07C00 u32) (<< (r rm) (: 16 u32)) (<< (r rn) (: 5 u32)) (r rd)))

(defn smull [(rd u32) (rn u32) (rm u32)] (-> u32)
  (| (: 0x9B207C00 u32) (<< (r rm) (: 16 u32)) (<< (r rn) (: 5 u32)) (r rd)))

(defn umull [(rd u32) (rn u32) (rm u32)] (-> u32)
  (| (: 0x9BA07C00 u32) (<< (r rm) (: 16 u32)) (<< (r rn) (: 5 u32)) (r rd)))

; ---- data processing (1 source) ----
(defn dp1 [(base u32) (sf bool) (rd u32) (rn u32)] (-> u32)
  (| (sfb sf) base (<< (r rn) (: 5 u32)) (r rd)))

(defn rbit [(sf bool) (rd u32) (rn u32)] (-> u32)
  (dp1 (: 0x5AC00000 u32) sf rd rn))

(defn rev16 [(sf bool) (rd u32) (rn u32)] (-> u32)
  (dp1 (: 0x5AC00400 u32) sf rd rn))

(defn rev [(sf bool) (rd u32) (rn u32)] (-> u32)
  (if sf
      (dp1 (: 0x5AC00C00 u32) true rd rn)
      (dp1 (: 0x5AC00800 u32) false rd rn)))

(defn rev32 [(rd u32) (rn u32)] (-> u32)
  (dp1 (: 0x5AC00800 u32) true rd rn))

(defn clz [(sf bool) (rd u32) (rn u32)] (-> u32)
  (dp1 (: 0x5AC01000 u32) sf rd rn))

(defn cls [(sf bool) (rd u32) (rn u32)] (-> u32)
  (dp1 (: 0x5AC01400 u32) sf rd rn))

; ---- conditional select ----
(defn csel-base [(base u32) (sf bool) (rd u32) (rn u32) (rm u32) (cond u32)]
  (-> u32)
  (| (sfb sf)
     base
     (<< (r rm) (: 16 u32))
     (<< cond (: 12 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn csel [(sf bool) (rd u32) (rn u32) (rm u32) (cond u32)] (-> u32)
  (csel-base (: 0x1A800000 u32) sf rd rn rm cond))

(defn csinc [(sf bool) (rd u32) (rn u32) (rm u32) (cond u32)] (-> u32)
  (csel-base (: 0x1A800400 u32) sf rd rn rm cond))

(defn csinv [(sf bool) (rd u32) (rn u32) (rm u32) (cond u32)] (-> u32)
  (csel-base (: 0x5A800000 u32) sf rd rn rm cond))

(defn csneg [(sf bool) (rd u32) (rn u32) (rm u32) (cond u32)] (-> u32)
  (csel-base (: 0x5A800400 u32) sf rd rn rm cond))

(defn cset [(sf bool) (rd u32) (cond u32)] (-> u32)
  (csinc sf rd (: 31 u32) (: 31 u32) (invert-cond cond)))

(defn csetm [(sf bool) (rd u32) (cond u32)] (-> u32)
  (csinv sf rd (: 31 u32) (: 31 u32) (invert-cond cond)))

; ---- bitfield ----
(defn bfm-base [(base u32) (sf bool) (rd u32) (rn u32) (immr u32) (imms u32)]
  (-> u32)
  (| (sfb sf)
     base
     (if sf (: 0x400000 u32) (: 0 u32))
     (<< immr (: 16 u32))
     (<< imms (: 10 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn sbfm [(sf bool) (rd u32) (rn u32) (immr u32) (imms u32)] (-> u32)
  (bfm-base (: 0x13000000 u32) sf rd rn immr imms))

(defn bfm [(sf bool) (rd u32) (rn u32) (immr u32) (imms u32)] (-> u32)
  (bfm-base (: 0x33000000 u32) sf rd rn immr imms))

(defn ubfm [(sf bool) (rd u32) (rn u32) (immr u32) (imms u32)] (-> u32)
  (bfm-base (: 0x53000000 u32) sf rd rn immr imms))

(defn bits-of [(sf bool)] (-> u32)
  (if sf (: 64 u32) (: 32 u32)))

(defn lsl-imm [(sf bool) (rd u32) (rn u32) (s u32)] (-> u32)
  (let [n (bits-of sf)] (ubfm sf rd rn (% (- n s) n) (- (- n (: 1 u32)) s))))

(defn lsr-imm [(sf bool) (rd u32) (rn u32) (s u32)] (-> u32)
  (ubfm sf rd rn s (- (bits-of sf) (: 1 u32))))

(defn asr-imm [(sf bool) (rd u32) (rn u32) (s u32)] (-> u32)
  (sbfm sf rd rn s (- (bits-of sf) (: 1 u32))))

(defn ubfx [(sf bool) (rd u32) (rn u32) (lsb u32) (width u32)] (-> u32)
  (ubfm sf rd rn lsb (- (+ lsb width) (: 1 u32))))

(defn sbfx [(sf bool) (rd u32) (rn u32) (lsb u32) (width u32)] (-> u32)
  (sbfm sf rd rn lsb (- (+ lsb width) (: 1 u32))))

(defn bfi [(sf bool) (rd u32) (rn u32) (lsb u32) (width u32)] (-> u32)
  (let [n (bits-of sf)] (bfm sf rd rn (% (- n lsb) n) (- width (: 1 u32)))))

(defn bfxil [(sf bool) (rd u32) (rn u32) (lsb u32) (width u32)] (-> u32)
  (bfm sf rd rn lsb (- (+ lsb width) (: 1 u32))))

(defn ubfiz [(sf bool) (rd u32) (rn u32) (lsb u32) (width u32)] (-> u32)
  (let [n (bits-of sf)] (ubfm sf rd rn (% (- n lsb) n) (- width (: 1 u32)))))

(defn sxtb [(sf bool) (rd u32) (rn u32)] (-> u32)
  (sbfm sf rd rn (: 0 u32) (: 7 u32)))

(defn sxth [(sf bool) (rd u32) (rn u32)] (-> u32)
  (sbfm sf rd rn (: 0 u32) (: 15 u32)))

(defn sxtw [(rd u32) (rn u32)] (-> u32)
  (sbfm true rd rn (: 0 u32) (: 31 u32)))

(defn uxtb [(rd u32) (rn u32)] (-> u32)
  (ubfm false rd rn (: 0 u32) (: 7 u32)))

(defn uxth [(rd u32) (rn u32)] (-> u32)
  (ubfm false rd rn (: 0 u32) (: 15 u32)))

(defn extr [(sf bool) (rd u32) (rn u32) (rm u32) (lsb u32)] (-> u32)
  (| (sfb sf)
     (: 0x13800000 u32)
     (if sf (: 0x400000 u32) (: 0 u32))
     (<< (r rm) (: 16 u32))
     (<< lsb (: 10 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn ror-imm [(sf bool) (rd u32) (rn u32) (s u32)] (-> u32)
  (extr sf rd rn rn s))

; ---- loads and stores ----
; size: 0 byte, 1 half, 2 word, 3 dword. opc: 0 store, 1 load, 2 load signed (x), 3 load signed (w)
(defn ldst-uimm [(size u32) (opc u32) (vec bool) (rt u32) (rn u32) (scaled u32)]
  (-> u32)
  (| (<< size (: 30 u32))
     (if vec (: 0x3D000000 u32) (: 0x39000000 u32))
     (<< opc (: 22 u32))
     (<< (& scaled (: 0xFFF u32)) (: 10 u32))
     (<< (r rn) (: 5 u32))
     (r rt)))

(defn ldst-imm9 [(size u32)
                 (opc u32)
                 (vec bool)
                 (rt u32)
                 (rn u32)
                 (imm i64)
                 (mode u32)] (-> u32)
  (| (<< size (: 30 u32))
     (if vec (: 0x3C000000 u32) (: 0x38000000 u32))
     (<< opc (: 22 u32))
     (<< (& (u imm) (: 0x1FF u32)) (: 12 u32))
     (<< mode (: 10 u32))
     (<< (r rn) (: 5 u32))
     (r rt)))

(defn ldst-reg [(size u32)
                (opc u32)
                (vec bool)
                (rt u32)
                (rn u32)
                (rm u32)
                (scaled bool)] (-> u32)
  (| (<< size (: 30 u32))
     (if vec (: 0x3C200800 u32) (: 0x38200800 u32))
     (<< opc (: 22 u32))
     (<< (r rm) (: 16 u32))
     (<< (: 3 u32) (: 13 u32))
     (if scaled (: 0x1000 u32) (: 0 u32))
     (<< (r rn) (: 5 u32))
     (r rt)))

;; log2 of a power-of-two access size (1, 2, 4, 8, 16)
(defn size-log2 [(bytes u32)] (-> u32)
  (primitive/cast u32 (primitive/ctz bytes)))

;; Whether `off` fits a scaled unsigned 12-bit offset for an access of `bytes`.
(defn uimm-ok? [(off i64) (bytes i64)] (-> bool)
  (and (>= off 0) (= (% off bytes) 0) (< (/ off bytes) 4096)))

(defn simm9-ok? [(off i64)] (-> bool)
  (and (>= off -256) (< off 256)))

;; Load `bytes` from [rn + off] into GP `rt`, zero-extending (or sign-extending
;; into 64 bits when `signed`). Requires (uimm-ok? off bytes) or (simm9-ok? off).
(defn ldr-gp [(rt u32) (rn u32) (off i64) (bytes u32) (signed bool)] (-> u32)
  (let [size (size-log2 bytes)
        opc (if (and signed (< bytes (: 8 u32))) (: 2 u32) (: 1 u32))]
    (if (uimm-ok? off (cast i64 bytes))
        (ldst-uimm size opc false rt rn (u (/ off (cast i64 bytes))))
        (ldst-imm9 size opc false rt rn off (: 0 u32)))))

(defn str-gp [(rt u32) (rn u32) (off i64) (bytes u32)] (-> u32)
  (let [size (size-log2 bytes)]
    (if (uimm-ok? off (cast i64 bytes))
        (ldst-uimm size (: 0 u32) false rt rn (u (/ off (cast i64 bytes))))
        (ldst-imm9 size (: 0 u32) false rt rn off (: 0 u32)))))

;; FP/SIMD load/store of 1, 2, 4, 8 or 16 bytes.
(defn fp-size-opc [(bytes u32) (load bool)] (-> u32)
  (if (= bytes (: 16 u32))
      (| (<< (: 0 u32) (: 2 u32)) (if load (: 3 u32) (: 2 u32)))
      (| (<< (size-log2 bytes) (: 2 u32)) (if load (: 1 u32) (: 0 u32)))))

(defn ldr-fp [(rt u32) (rn u32) (off i64) (bytes u32)] (-> u32)
  (let [so (fp-size-opc bytes true)
        size (>> so (: 2 u32))
        opc (& so (: 3 u32))]
    (if (uimm-ok? off (cast i64 bytes))
        (ldst-uimm size opc true rt rn (u (/ off (cast i64 bytes))))
        (ldst-imm9 size opc true rt rn off (: 0 u32)))))

(defn str-fp [(rt u32) (rn u32) (off i64) (bytes u32)] (-> u32)
  (let [so (fp-size-opc bytes false)
        size (>> so (: 2 u32))
        opc (& so (: 3 u32))]
    (if (uimm-ok? off (cast i64 bytes))
        (ldst-uimm size opc true rt rn (u (/ off (cast i64 bytes))))
        (ldst-imm9 size opc true rt rn off (: 0 u32)))))

;; Register-offset forms: [rn, rm] (or [rn, rm, lsl #log2(bytes)] when scaled).
(defn ldr-gp-reg [(rt u32)
                  (rn u32)
                  (rm u32)
                  (bytes u32)
                  (signed bool)
                  (scaled bool)] (-> u32)
  (ldst-reg (size-log2 bytes)
            (if (and signed (< bytes (: 8 u32))) (: 2 u32) (: 1 u32))
            false
            rt
            rn
            rm
            scaled))

(defn str-gp-reg [(rt u32) (rn u32) (rm u32) (bytes u32) (scaled bool)] (-> u32)
  (ldst-reg (size-log2 bytes) (: 0 u32) false rt rn rm scaled))

(defn ldr-fp-reg [(rt u32) (rn u32) (rm u32) (bytes u32) (scaled bool)] (-> u32)
  (let [so (fp-size-opc bytes true)]
    (ldst-reg (>> so (: 2 u32)) (& so (: 3 u32)) true rt rn rm scaled)))

(defn str-fp-reg [(rt u32) (rn u32) (rm u32) (bytes u32) (scaled bool)] (-> u32)
  (let [so (fp-size-opc bytes false)]
    (ldst-reg (>> so (: 2 u32)) (& so (: 3 u32)) true rt rn rm scaled)))

; ---- load/store pair ----
; kind: 0 w, 1 x, 2 d, 3 q ; mode: 1 post, 2 offset, 3 pre
(defn ldstp [(kind u32)
             (load bool)
             (mode u32)
             (rt u32)
             (rt2 u32)
             (rn u32)
             (off i64)] (-> u32)
  (let [scale (case kind 0 4 1 8 2 8 16)
        opc (case kind 0 (: 0 u32) 1 (: 2 u32) 2 (: 1 u32) (: 2 u32))
        vec (>= kind (: 2 u32))
        imm7 (& (u (/ off scale)) (: 0x7F u32))]
    (| (<< opc (: 30 u32))
       (if vec (: 0x2C000000 u32) (: 0x28000000 u32))
       (<< mode (: 23 u32))
       (if load (: 0x400000 u32) (: 0 u32))
       (<< imm7 (: 15 u32))
       (<< (r rt2) (: 10 u32))
       (<< (r rn) (: 5 u32))
       (r rt))))

(defn stp-x [(rt u32) (rt2 u32) (rn u32) (off i64)] (-> u32)
  (ldstp (: 1 u32) false (: 2 u32) rt rt2 rn off))

(defn ldp-x [(rt u32) (rt2 u32) (rn u32) (off i64)] (-> u32)
  (ldstp (: 1 u32) true (: 2 u32) rt rt2 rn off))

(defn stp-x-pre [(rt u32) (rt2 u32) (rn u32) (off i64)] (-> u32)
  (ldstp (: 1 u32) false (: 3 u32) rt rt2 rn off))

(defn ldp-x-post [(rt u32) (rt2 u32) (rn u32) (off i64)] (-> u32)
  (ldstp (: 1 u32) true (: 1 u32) rt rt2 rn off))

(defn stp-d [(rt u32) (rt2 u32) (rn u32) (off i64)] (-> u32)
  (ldstp (: 2 u32) false (: 2 u32) rt rt2 rn off))

(defn ldp-d [(rt u32) (rt2 u32) (rn u32) (off i64)] (-> u32)
  (ldstp (: 2 u32) true (: 2 u32) rt rt2 rn off))

(defn stp-q [(rt u32) (rt2 u32) (rn u32) (off i64)] (-> u32)
  (ldstp (: 3 u32) false (: 2 u32) rt rt2 rn off))

(defn ldp-q [(rt u32) (rt2 u32) (rn u32) (off i64)] (-> u32)
  (ldstp (: 3 u32) true (: 2 u32) rt rt2 rn off))

; ---- branches ----
(defn b [(words i64)] (-> u32)
  (| (: 0x14000000 u32) (& (u words) (: 0x3FFFFFF u32))))

(defn bl [(words i64)] (-> u32)
  (| (: 0x94000000 u32) (& (u words) (: 0x3FFFFFF u32))))

(defn b-cond [(cond u32) (words i64)] (-> u32)
  (| (: 0x54000000 u32) (<< (& (u words) (: 0x7FFFF u32)) (: 5 u32)) cond))

(defn cbz [(sf bool) (rt u32) (words i64)] (-> u32)
  (| (sfb sf)
     (: 0x34000000 u32)
     (<< (& (u words) (: 0x7FFFF u32)) (: 5 u32))
     (r rt)))

(defn cbnz [(sf bool) (rt u32) (words i64)] (-> u32)
  (| (sfb sf)
     (: 0x35000000 u32)
     (<< (& (u words) (: 0x7FFFF u32)) (: 5 u32))
     (r rt)))

(defn tbz [(rt u32) (bit u32) (words i64)] (-> u32)
  (| (<< (>> bit (: 5 u32)) (: 31 u32))
     (: 0x36000000 u32)
     (<< (& bit (: 31 u32)) (: 19 u32))
     (<< (& (u words) (: 0x3FFF u32)) (: 5 u32))
     (r rt)))

(defn tbnz [(rt u32) (bit u32) (words i64)] (-> u32)
  (| (<< (>> bit (: 5 u32)) (: 31 u32))
     (: 0x37000000 u32)
     (<< (& bit (: 31 u32)) (: 19 u32))
     (<< (& (u words) (: 0x3FFF u32)) (: 5 u32))
     (r rt)))

(defn br [(rn u32)] (-> u32)
  (| (: 0xD61F0000 u32) (<< (r rn) (: 5 u32))))

(defn blr [(rn u32)] (-> u32)
  (| (: 0xD63F0000 u32) (<< (r rn) (: 5 u32))))

(defn ret [] (-> u32)
  (: 0xD65F03C0 u32))

(defn brk [(imm u32)] (-> u32)
  (| (: 0xD4200000 u32) (<< (& imm (: 0xFFFF u32)) (: 5 u32))))

(defn nop [] (-> u32)
  (: 0xD503201F u32))

(defn dmb-ish [] (-> u32)
  (: 0xD5033BBF u32))

(defn adr [(rd u32) (bytes i64)] (-> u32)
  (let [x (u bytes)]
    (| (: 0x10000000 u32)
       (<< (& x (: 3 u32)) (: 29 u32))
       (<< (& (>> x (: 2 u32)) (: 0x7FFFF u32)) (: 5 u32))
       (r rd))))

(defn adrp [(rd u32) (pages i64)] (-> u32)
  (let [x (u pages)]
    (| (: 0x90000000 u32)
       (<< (& x (: 3 u32)) (: 29 u32))
       (<< (& (>> x (: 2 u32)) (: 0x7FFFF u32)) (: 5 u32))
       (r rd))))

(defn ldr-literal-x [(rt u32) (words i64)] (-> u32)
  (| (: 0x58000000 u32) (<< (& (u words) (: 0x7FFFF u32)) (: 5 u32)) (r rt)))

; ---- floating point (ty: 0 single, 1 double) ----
(defn ftype [(dbl bool)] (-> u32)
  (if dbl (: 0x400000 u32) (: 0 u32)))

(defn fp2 [(base u32) (dbl bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (| base (ftype dbl) (<< (r rm) (: 16 u32)) (<< (r rn) (: 5 u32)) (r rd)))

(defn fadd [(dbl bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (fp2 (: 0x1E202800 u32) dbl rd rn rm))

(defn fsub [(dbl bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (fp2 (: 0x1E203800 u32) dbl rd rn rm))

(defn fmul [(dbl bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (fp2 (: 0x1E200800 u32) dbl rd rn rm))

(defn fdiv [(dbl bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (fp2 (: 0x1E201800 u32) dbl rd rn rm))

(defn fmax [(dbl bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (fp2 (: 0x1E204800 u32) dbl rd rn rm))

(defn fmin [(dbl bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (fp2 (: 0x1E205800 u32) dbl rd rn rm))

(defn fmaxnm [(dbl bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (fp2 (: 0x1E206800 u32) dbl rd rn rm))

(defn fminnm [(dbl bool) (rd u32) (rn u32) (rm u32)] (-> u32)
  (fp2 (: 0x1E207800 u32) dbl rd rn rm))

(defn fp1 [(base u32) (dbl bool) (rd u32) (rn u32)] (-> u32)
  (| base (ftype dbl) (<< (r rn) (: 5 u32)) (r rd)))

(defn fmov-reg [(dbl bool) (rd u32) (rn u32)] (-> u32)
  (fp1 (: 0x1E204000 u32) dbl rd rn))

(defn fabs [(dbl bool) (rd u32) (rn u32)] (-> u32)
  (fp1 (: 0x1E20C000 u32) dbl rd rn))

(defn fneg [(dbl bool) (rd u32) (rn u32)] (-> u32)
  (fp1 (: 0x1E214000 u32) dbl rd rn))

(defn fsqrt [(dbl bool) (rd u32) (rn u32)] (-> u32)
  (fp1 (: 0x1E21C000 u32) dbl rd rn))

(defn frintn [(dbl bool) (rd u32) (rn u32)] (-> u32)
  (fp1 (: 0x1E244000 u32) dbl rd rn))

(defn frintp [(dbl bool) (rd u32) (rn u32)] (-> u32)
  (fp1 (: 0x1E24C000 u32) dbl rd rn))

(defn frintm [(dbl bool) (rd u32) (rn u32)] (-> u32)
  (fp1 (: 0x1E254000 u32) dbl rd rn))

(defn frintz [(dbl bool) (rd u32) (rn u32)] (-> u32)
  (fp1 (: 0x1E25C000 u32) dbl rd rn))

(defn frinta [(dbl bool) (rd u32) (rn u32)] (-> u32)
  (fp1 (: 0x1E264000 u32) dbl rd rn))

(defn frintx [(dbl bool) (rd u32) (rn u32)] (-> u32)
  (fp1 (: 0x1E274000 u32) dbl rd rn))

(defn frinti [(dbl bool) (rd u32) (rn u32)] (-> u32)
  (fp1 (: 0x1E27C000 u32) dbl rd rn))

;; fcvt to double from single, or to single from double
(defn fcvt-s2d [(rd u32) (rn u32)] (-> u32)
  (| (: 0x1E22C000 u32) (<< (r rn) (: 5 u32)) (r rd)))

(defn fcvt-d2s [(rd u32) (rn u32)] (-> u32)
  (| (: 0x1E624000 u32) (<< (r rn) (: 5 u32)) (r rd)))

(defn fcmp [(dbl bool) (rn u32) (rm u32)] (-> u32)
  (| (: 0x1E202000 u32)
     (ftype dbl)
     (<< (r rm) (: 16 u32))
     (<< (r rn) (: 5 u32))))

(defn fcmp-zero [(dbl bool) (rn u32)] (-> u32)
  (| (: 0x1E202008 u32) (ftype dbl) (<< (r rn) (: 5 u32))))

(defn fcsel [(dbl bool) (rd u32) (rn u32) (rm u32) (cond u32)] (-> u32)
  (| (: 0x1E200C00 u32)
     (ftype dbl)
     (<< (r rm) (: 16 u32))
     (<< cond (: 12 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn fmadd [(dbl bool) (rd u32) (rn u32) (rm u32) (ra u32)] (-> u32)
  (| (: 0x1F000000 u32)
     (ftype dbl)
     (<< (r rm) (: 16 u32))
     (<< (r ra) (: 10 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

(defn fmsub [(dbl bool) (rd u32) (rn u32) (rm u32) (ra u32)] (-> u32)
  (| (: 0x1F008000 u32)
     (ftype dbl)
     (<< (r rm) (: 16 u32))
     (<< (r ra) (: 10 u32))
     (<< (r rn) (: 5 u32))
     (r rd)))

;; integer <-> fp conversions; sf selects the integer width
(defn fcvt-int [(base u32) (sf bool) (dbl bool) (rd u32) (rn u32)] (-> u32)
  (| (sfb sf) base (ftype dbl) (<< (r rn) (: 5 u32)) (r rd)))

(defn scvtf [(sf bool) (dbl bool) (rd u32) (rn u32)] (-> u32)
  (fcvt-int (: 0x1E220000 u32) sf dbl rd rn))

(defn ucvtf [(sf bool) (dbl bool) (rd u32) (rn u32)] (-> u32)
  (fcvt-int (: 0x1E230000 u32) sf dbl rd rn))

(defn fcvtzs [(sf bool) (dbl bool) (rd u32) (rn u32)] (-> u32)
  (fcvt-int (: 0x1E380000 u32) sf dbl rd rn))

(defn fcvtzu [(sf bool) (dbl bool) (rd u32) (rn u32)] (-> u32)
  (fcvt-int (: 0x1E390000 u32) sf dbl rd rn))

;; fmov between GP and FP registers: w<-s, x<-d, s<-w, d<-x
(defn fmov-to-gp [(dbl bool) (rd u32) (rn u32)] (-> u32)
  (if dbl
      (| (: 0x9E660000 u32) (<< (r rn) (: 5 u32)) (r rd))
      (| (: 0x1E260000 u32) (<< (r rn) (: 5 u32)) (r rd))))

(defn fmov-from-gp [(dbl bool) (rd u32) (rn u32)] (-> u32)
  (if dbl
      (| (: 0x9E670000 u32) (<< (r rn) (: 5 u32)) (r rd))
      (| (: 0x1E270000 u32) (<< (r rn) (: 5 u32)) (r rd))))

;; fmov dN, xM to/from the upper 64 bits of a vector: v.d[1]
(defn fmov-to-gp-hi [(rd u32) (rn u32)] (-> u32)
  (| (: 0x9EAE0000 u32) (<< (r rn) (: 5 u32)) (r rd)))

(defn fmov-from-gp-hi [(rd u32) (rn u32)] (-> u32)
  (| (: 0x9EAF0000 u32) (<< (r rn) (: 5 u32)) (r rd)))

;; 128-bit register copy: orr vd.16b, vn.16b, vn.16b
(defn mov-v [(rd u32) (rn u32)] (-> u32)
  (| (: 0x4EA01C00 u32) (<< (r rn) (: 16 u32)) (<< (r rn) (: 5 u32)) (r rd)))

;; movi dN, #0 (clears the whole vector register)
(defn movi-zero [(rd u32)] (-> u32)
  (| (: 0x6F00E400 u32) (r rd)))

;; The 8-bit FMOV immediate for `bits` (an f32 when not dbl), or -1.
(defn fp-imm8 [(bits u64) (dbl bool)] (-> i64)
  (if dbl
      (let [low (& bits (: 0xFFFFFFFFFFFF u64))
            exp (& (>> bits (: 52 u64)) (: 0x7FF u64))
            frac-hi (& (>> bits (: 48 u64)) (: 0xF u64))
            sign (>> bits (: 63 u64))]
        ; exponent must be 0b1xxxxxxxx (eh) with bits 61..54 all equal to not(bit 62)
        (if (!= low (: 0 u64))
            -1
            (let [e62 (& (>> exp (: 10 u64)) (: 1 u64))
                  e-mid (& (>> exp (: 2 u64)) (: 0xFF u64))
                  e-low (& exp (: 3 u64))]
              (if (!= e-mid (if (= e62 (: 1 u64)) (: 0 u64) (: 0xFF u64)))
                  -1
                  (primitive/cast i64
                                  (| (<< sign (: 7 u64))
                                     (<< (^ e62 (: 1 u64)) (: 6 u64))
                                     (<< e-low (: 4 u64))
                                     frac-hi))))))
      (let [b32 (& bits (: 0xFFFFFFFF u64))
            low (& b32 (: 0x7FFFF u64))
            exp (& (>> b32 (: 23 u64)) (: 0xFF u64))
            frac-hi (& (>> b32 (: 19 u64)) (: 0xF u64))
            sign (>> b32 (: 31 u64))]
        (if (!= low (: 0 u64))
            -1
            (let [e7 (& (>> exp (: 7 u64)) (: 1 u64))
                  e-mid (& (>> exp (: 2 u64)) (: 0x1F u64))
                  e-low (& exp (: 3 u64))]
              (if (!= e-mid (if (= e7 (: 1 u64)) (: 0 u64) (: 0x1F u64)))
                  -1
                  (primitive/cast i64
                                  (| (<< sign (: 7 u64))
                                     (<< (^ e7 (: 1 u64)) (: 6 u64))
                                     (<< e-low (: 4 u64))
                                     frac-hi))))))))

(defn fmov-imm [(dbl bool) (rd u32) (imm8 i64)] (-> u32)
  (| (: 0x1E201000 u32) (ftype dbl) (<< (u imm8) (: 13 u32)) (r rd)))

; ---- atomics (LSE, acquire-release) ; size 0 b, 1 h, 2 w, 3 x ----
(defn lse [(base u32) (size u32) (rs u32) (rt u32) (rn u32)] (-> u32)
  (| (<< size (: 30 u32))
     base
     (<< (r rs) (: 16 u32))
     (<< (r rn) (: 5 u32))
     (r rt)))

(defn ldaddal [(size u32) (rs u32) (rt u32) (rn u32)] (-> u32)
  (lse (: 0x38E00000 u32) size rs rt rn))

(defn ldclral [(size u32) (rs u32) (rt u32) (rn u32)] (-> u32)
  (lse (: 0x38E01000 u32) size rs rt rn))

(defn ldeoral [(size u32) (rs u32) (rt u32) (rn u32)] (-> u32)
  (lse (: 0x38E02000 u32) size rs rt rn))

(defn ldsetal [(size u32) (rs u32) (rt u32) (rn u32)] (-> u32)
  (lse (: 0x38E03000 u32) size rs rt rn))

(defn ldsmaxal [(size u32) (rs u32) (rt u32) (rn u32)] (-> u32)
  (lse (: 0x38E04000 u32) size rs rt rn))

(defn ldsminal [(size u32) (rs u32) (rt u32) (rn u32)] (-> u32)
  (lse (: 0x38E05000 u32) size rs rt rn))

(defn ldumaxal [(size u32) (rs u32) (rt u32) (rn u32)] (-> u32)
  (lse (: 0x38E06000 u32) size rs rt rn))

(defn lduminal [(size u32) (rs u32) (rt u32) (rn u32)] (-> u32)
  (lse (: 0x38E07000 u32) size rs rt rn))

(defn swpal [(size u32) (rs u32) (rt u32) (rn u32)] (-> u32)
  (lse (: 0x38E08000 u32) size rs rt rn))

(defn casal [(size u32) (rs u32) (rt u32) (rn u32)] (-> u32)
  (| (<< size (: 30 u32))
     (: 0x08E0FC00 u32)
     (<< (r rs) (: 16 u32))
     (<< (r rn) (: 5 u32))
     (r rt)))

(defn ldar [(size u32) (rt u32) (rn u32)] (-> u32)
  (| (<< size (: 30 u32)) (: 0x08DFFC00 u32) (<< (r rn) (: 5 u32)) (r rt)))

(defn stlr [(size u32) (rt u32) (rn u32)] (-> u32)
  (| (<< size (: 30 u32)) (: 0x089FFC00 u32) (<< (r rn) (: 5 u32)) (r rt)))

;;; Instructions that materialize `val` into GP `rd`, written to `out`
;;; (up to 4 words); returns the count. 32-bit forms are used when the value
;;; fits in 32 bits, which zero-extends.
(defn mov-const [(out (ptr u32)) (rd u32) (val u64)] (-> i64)
  (let [w32 (= (>> val (: 32 u64)) (: 0 u64))
        sf (not w32)
        nhalves (if w32 2 4)
        (mut zeros) 0
        (mut ones) 0]
    (for i (range 0 nhalves)
      (let [h (& (>> val (cast u64 (* i 16))) (: 0xFFFF u64))]
        (when (= h (: 0 u64)) (set! zeros (+ zeros 1)))
        (when (= h (: 0xFFFF u64)) (set! ones (+ ones 1)))))
    (cond (= val (: 0 u64))
            (do (set! out (movz false rd (: 0 u32) (: 0 u32))) 1)
          (>= zeros (- nhalves 1))
            (let [(mut n) 0]
              (for i (range 0 nhalves)
                (let [h
                        (cast u32
                              (& (>> val (cast u64 (* i 16))) (: 0xFFFF u64)))]
                  (when (!= h (: 0 u32)) (set! out (movz sf rd h (cast u32 i))))))
              1)
          (and (>= ones (- nhalves 1)))
            (let [(mut done) false]
              (for i (range 0 nhalves)
                (let [h
                        (cast u32
                              (& (>> val (cast u64 (* i 16))) (: 0xFFFF u64)))]
                  (when (and (not done) (!= h (: 0xFFFF u32)))
                    (set! out (movn sf rd (^ h (: 0xFFFF u32)) (cast u32 i)))
                    (set! done true))))
              (when (not done) (set! out (movn sf rd (: 0 u32) (: 0 u32))))
              1)
          :else
            (let [li (logical-imm val sf)]
              (if (>= li 0)
                  (do (set! out (orr-imm sf rd (: 31 u32) li)) 1)
                  (let [use-n (> ones zeros)
                        (mut n) 0]
                    (for i (range 0 nhalves)
                      (let [h
                              (cast u32
                                    (& (>> val (cast u64 (* i 16)))
                                       (: 0xFFFF u64)))
                            skip (if use-n (= h (: 0xFFFF u32)) (= h (: 0 u32)))]
                        (when (not skip)
                          (store! (index out n)
                                  (cond (and (= n 0) use-n)
                                          (movn sf
                                                rd
                                                (^ h (: 0xFFFF u32))
                                                (cast u32 i))
                                        (= n 0) (movz sf rd h (cast u32 i))
                                        :else (movk sf rd h (cast u32 i))))
                          (set! n (+ n 1)))))
                    n))))))

; ---- a few SIMD forms (popcount) ----
;; cnt vd.8b, vn.8b
(defn cnt-8b [(rd u32) (rn u32)] (-> u32)
  (| (: 0x0E205800 u32) (<< (r rn) (: 5 u32)) (r rd)))

;; addv bd, vn.8b
(defn addv-8b [(rd u32) (rn u32)] (-> u32)
  (| (: 0x0E31B800 u32) (<< (r rn) (: 5 u32)) (r rd)))

;; fmov xd, dn / umov wd, vn.b[0] etc. are covered by fmov-to-gp
