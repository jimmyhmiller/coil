(module coil.compiler.digest)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.slice" :as sl)
(import "coil.str" :as str)

(export Sha256 sha256-init! sha256-update! sha256-finish sha256-hex)

;; Streaming SHA-256 for artifact identities, FIPS 180-4 sections 4.1.2,
;; 4.2.2 and 6.2. The state owns no heap storage and may be copied to fork a hash.
(defstruct Sha256
  [(words (array u32 8)) (tail (array u8 64)) (used i64) (bytes u64)])

(defn constants [] (-> (ptr (array u32 64)))
  (p/alloc-static (array u32 64)
                  [0x428a2f98
                   0x71374491
                   0xb5c0fbcf
                   0xe9b5dba5
                   0x3956c25b
                   0x59f111f1
                   0x923f82a4
                   0xab1c5ed5
                   0xd807aa98
                   0x12835b01
                   0x243185be
                   0x550c7dc3
                   0x72be5d74
                   0x80deb1fe
                   0x9bdc06a7
                   0xc19bf174
                   0xe49b69c1
                   0xefbe4786
                   0x0fc19dc6
                   0x240ca1cc
                   0x2de92c6f
                   0x4a7484aa
                   0x5cb0a9dc
                   0x76f988da
                   0x983e5152
                   0xa831c66d
                   0xb00327c8
                   0xbf597fc7
                   0xc6e00bf3
                   0xd5a79147
                   0x06ca6351
                   0x14292967
                   0x27b70a85
                   0x2e1b2138
                   0x4d2c6dfc
                   0x53380d13
                   0x650a7354
                   0x766a0abb
                   0x81c2c92e
                   0x92722c85
                   0xa2bfe8a1
                   0xa81a664b
                   0xc24b8b70
                   0xc76c51a3
                   0xd192e819
                   0xd6990624
                   0xf40e3585
                   0x106aa070
                   0x19a4c116
                   0x1e376c08
                   0x2748774c
                   0x34b0bcb5
                   0x391c0cb3
                   0x4ed8aa4a
                   0x5b9cca4f
                   0x682e6ff3
                   0x748f82ee
                   0x78a5636f
                   0x84c87814
                   0x8cc70208
                   0x90befffa
                   0xa4506ceb
                   0xbef9a3f7
                   0xc67178f2]))

(defn sha256-init! [(state (ptr Sha256))] (-> i64)
  (store! state (p/zeroed Sha256))
  (store! (field state words)
          [0x6a09e667
           0xbb67ae85
           0x3c6ef372
           0xa54ff53a
           0x510e527f
           0x9b05688c
           0x1f83d9ab
           0x5be0cd19])
  0)

(defn sigma0 [(x u32)] (-> u32)
  (p/ixor (p/ixor (p/rotr x (cast u32 7)) (p/rotr x (cast u32 18)))
          (p/ishr x (cast u32 3))))

(defn sigma1 [(x u32)] (-> u32)
  (p/ixor (p/ixor (p/rotr x (cast u32 17)) (p/rotr x (cast u32 19)))
          (p/ishr x (cast u32 10))))

(defn sum0 [(x u32)] (-> u32)
  (p/ixor (p/ixor (p/rotr x (cast u32 2)) (p/rotr x (cast u32 13)))
          (p/rotr x (cast u32 22))))

(defn sum1 [(x u32)] (-> u32)
  (p/ixor (p/ixor (p/rotr x (cast u32 6)) (p/rotr x (cast u32 11)))
          (p/rotr x (cast u32 25))))

(defn compress! [(state (ptr Sha256)) (bytes (ptr u8))] (-> i64)
  (let [schedule (p/alloc-stack (array u32 64))
        w (cast (ptr u32) schedule)
        h (cast (ptr u32) (field state words))
        k (cast (ptr u32) (constants))]
    (for [i 0 16]
      (let [(mut value) (cast u32 0)]
        (for [j 0 4]
          (store! value
                  (p/ior (p/ishl (load value) (cast u32 8))
                         (cast u32 (load (index bytes (+ (* i 4) j))))))
          0)
        (store! (index w i) (load value)))
      0)
    (for [i 16 64]
      (store! (index w i)
              (+ (+ (sigma1 (load (index w (- i 2)))) (load (index w (- i 7))))
                 (+ (sigma0 (load (index w (- i 15))))
                    (load (index w (- i 16))))))
      0)
    (let [(mut a) (load (index h 0))
          (mut b) (load (index h 1))
          (mut c) (load (index h 2))
          (mut d) (load (index h 3))
          (mut e) (load (index h 4))
          (mut f) (load (index h 5))
          (mut g) (load (index h 6))
          (mut last) (load (index h 7))]
      (for [i 0 64]
        (let [choose
                (p/ixor (p/iand (load e) (load f))
                        (p/iand (p/inot (load e)) (load g)))
              majority
                (p/ixor (p/ixor (p/iand (load a) (load b))
                                (p/iand (load a) (load c)))
                        (p/iand (load b) (load c)))
              t1
                (+ (+ (load last) (sum1 (load e)))
                   (+ choose (+ (load (index k i)) (load (index w i)))))
              t2 (+ (sum0 (load a)) majority)]
          (store! last (load g))
          (store! g (load f))
          (store! f (load e))
          (store! e (+ (load d) t1))
          (store! d (load c))
          (store! c (load b))
          (store! b (load a))
          (store! a (+ t1 t2)))
        0)
      (store! (index h 0) (+ (load (index h 0)) (load a)))
      (store! (index h 1) (+ (load (index h 1)) (load b)))
      (store! (index h 2) (+ (load (index h 2)) (load c)))
      (store! (index h 3) (+ (load (index h 3)) (load d)))
      (store! (index h 4) (+ (load (index h 4)) (load e)))
      (store! (index h 5) (+ (load (index h 5)) (load f)))
      (store! (index h 6) (+ (load (index h 6)) (load g)))
      (store! (index h 7) (+ (load (index h 7)) (load last))))
    0))

;; Whole blocks bypass the tail buffer. Input storage is borrowed for this call.
;; SHA-256's byte-oriented input limit is 2^61-1 bytes; reject overflow.
(defn sha256-update! [(state (ptr Sha256)) (bytes (slice u8))] (-> bool)
  (let [n (sl/slice-len bytes)
        data (sl/slice-data bytes)
        tail (cast (ptr u8) (field state tail))
        (mut at) 0]
    (if (> (cast u64 n) (- (cast u64 0x1fffffffffffffff) (.bytes state)))
        false
        (do
          (store! (field state bytes) (+ (.bytes state) (cast u64 n)))
          (loop (if (or (= (.used state) 0) (>= (load at) n)) (break) 0)
            (store! (index tail (.used state)) (load (index data (load at))))
            (store! (field state used) (+ (.used state) 1))
            (store! at (+ (load at) 1))
            (when (= (.used state) 64)
              (compress! state tail)
              (store! (field state used) 0)
              0))
          (loop (if (> (+ (load at) 64) n) (break) 0)
            (compress! state (index data (load at)))
            (store! at (+ (load at) 64)))
          (loop (if (>= (load at) n) (break) 0)
            (store! (index tail (.used state)) (load (index data (load at))))
            (store! (field state used) (+ (.used state) 1))
            (store! at (+ (load at) 1)))
          true))))

;; Finish a copy; callers can obtain a prefix digest and continue updating.
(defn sha256-finish [(state (ptr Sha256))] (-> (array u8 32))
  (let [copy (p/alloc-stack Sha256)
        result (p/alloc-stack (array u8 32))
        out (cast (ptr u8) result)]
    (store! copy (load state))
    (let [tail (cast (ptr u8) (field copy tail))
          bits (p/ishl (.bytes copy) (cast u64 3))]
      (store! (index tail (.used copy)) (cast u8 128))
      (store! (field copy used) (+ (.used copy) 1))
      (when (> (.used copy) 56)
        (for [i (.used copy) 64] (store! (index tail i) (cast u8 0)) 0)
        (compress! copy tail)
        (store! (field copy used) 0)
        0)
      (for [i (.used copy) 56] (store! (index tail i) (cast u8 0)) 0)
      (for [i 0 8]
        (store! (index tail (+ 56 i))
                (cast u8 (p/ishr bits (cast u64 (* (- 7 i) 8)))))
        0)
      (compress! copy tail))
    (let [h (cast (ptr u32) (field copy words))]
      (for [i 0 32]
        (store! (index out i)
                (cast u8
                      (p/ishr (load (index h (p/idiv i 4)))
                              (cast u32 (* (- 3 (p/irem i 4)) 8)))))
        0))
    (load result)))

(defn sha256-hex [(a (dyn alloc/Allocator)) (state (ptr Sha256))] (-> (slice u8))
  (let [digest (p/alloc-stack (array u8 32))
        digits "0123456789abcdef"
        (mut text) (str/sb-new a)]
    (store! digest (sha256-finish state))
    (for [i 0 32]
      (let [byte (cast i64 (load (index (cast (ptr u8) digest) i)))]
        (str/sb-push-byte! (mut text) (sl/slice-get digits (p/ishr byte 4)))
        (str/sb-push-byte! (mut text) (sl/slice-get digits (p/iand byte 15))))
      0)
    (str/sb-str (load (mut text)))))
