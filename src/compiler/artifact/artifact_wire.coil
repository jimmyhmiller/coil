(module coil.compiler.artifact_wire)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.result" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.artifact_identity" :use *)

;; Artifact metadata has a versioned, endian-independent representation. Pointers,
;; allocator vtables and native padding are never written. Decoded strings borrow
;; the immutable input; lists/nodes belong to the caller's artifact-lifetime arena.
(defstruct ArtifactReader
  [(a (dyn Allocator))
   (bytes (slice u8))
   (at i64)
   (error (slice u8))
   (budget i64)])

(defn wire-reader [(a (dyn Allocator)) (bytes (slice u8))] (-> ArtifactReader)
  (ArtifactReader
    :a a
    :bytes bytes
    :at 0
    :error ""
    :budget 1000000))

(defn wire-fail! [(r (ptr ArtifactReader)) (message (slice u8))] (-> i64)
  (when (= (.error r) "") (set! (.error r) message) 0)
  0)

(defn wire-put-i64! [(w (mut StrBuf)) (v i64)] (-> i64)
  (for [i 0 8] (push! (mut w) (cast u8 (>> v (* i 8)))) 0)
  0)

(defn wire-put-str! [(w (mut StrBuf)) (v (slice u8))] (-> i64)
  (wire-put-i64! (mut w) (len v))
  (push-str! (mut w) v)
  0)

(defn wire-i64 [(r (ptr ArtifactReader))] (-> i64)
  (if (or (!= (.error r) "") (< (- (len (.bytes r)) (.at r)) 8))
      (do (wire-fail! r "truncated provider artifact integer") 0)
      (let [(mut out) 0]
        (for [i 0 8]
          (set! out
                (| (load out)
                   (<< (cast i64 (get (.bytes r) (+ (.at r) i))) (* i 8))))
          0)
        (set! (.at r) (+ (.at r) 8))
        (load out))))

(defn wire-str [(r (ptr ArtifactReader))] (-> (slice u8))
  (let [n (wire-i64 r)]
    (if (or (!= (.error r) "") (< n 0) (> n (- (len (.bytes r)) (.at r))))
        (do (wire-fail! r "invalid provider artifact string length") "")
        (let [out (subslice (.bytes r) (.at r) (+ (.at r) n))]
          (set! (.at r) (+ (.at r) n))
          out))))

;; Every counted item encodes at least one integer. Check before allocation or
;; iteration, and charge a total item budget so nested lists cannot inflate RSS.
(defn wire-count [(r (ptr ArtifactReader))] (-> i64)
  (let [n (wire-i64 r)]
    (if (or (!= (.error r) "")
            (< n 0)
            (> n (.budget r))
            (> n (/ (- (len (.bytes r)) (.at r)) 8)))
        (do (wire-fail! r "invalid provider artifact collection count") 0)
        (do (set! (.budget r) (- (.budget r) n)) n))))

(defn wire-put-names! [(w (mut StrBuf)) (names (ptr (ArrayList (slice u8))))]
  (-> i64)
  (let [n (if (= (cast i64 names) 0) 0 (len (load names)))]
    (wire-put-i64! (mut w) n)
    (for [i 0 n] (wire-put-str! (mut w) (get (load names) i)) 0))
  0)

(defn wire-names [(r (ptr ArtifactReader))] (-> (ptr (ArrayList (slice u8))))
  (let [n (wire-count r)
        (mut xs) (ArrayList::new [(slice u8)] (.a r))]
    (for [i 0 n] (push! (mut xs) (wire-str r)) 0)
    (box-al (.a r) (load xs))))

(defn wire-put-node! [(w (mut StrBuf)) (s (ptr Sexp)) (depth i64)] (-> bool)
  (if (> depth 256)
      false
      (do
        (wire-put-i64! (mut w) (.lo s))
        (wire-put-i64! (mut w) (.hi s))
        (wire-put-i64! (mut w) (.source s))
        (wire-put-i64! (mut w) (.ctxt s))
        (wire-put-i64! (mut w) (.hyg s))
        (wire-put-str! (mut w) (hmod-name (.hmod s)))
        (wire-put-i64! (mut w) (.horigin s))
        (wire-put-i64! (mut w) (.hflags s))
        ;; Node ids are serialized for diagnostics/testing; the loader allocates a
        ;; fresh domain before using them in compiler semantic tables.
        (wire-put-i64! (mut w) (.node-id s))
        (match (.kind s)
          (KInt [v] (wire-put-i64! (mut w) 0) (wire-put-i64! (mut w) v) true)
          (KFloat [v] (wire-put-i64! (mut w) 1) (wire-put-i64! (mut w) v) true)
          (KSym [v] (wire-put-i64! (mut w) 2) (wire-put-str! (mut w) v) true)
          (KKw [v] (wire-put-i64! (mut w) 3) (wire-put-str! (mut w) v) true)
          (KStr [v] (wire-put-i64! (mut w) 4) (wire-put-str! (mut w) v) true)
          (KCStr [v] (wire-put-i64! (mut w) 5) (wire-put-str! (mut w) v) true)
          (KList [xs]
                 (wire-put-i64! (mut w) 6)
                 (wire-put-nodes! (mut w) xs 0 (len (load xs)) depth))
          (KVec [xs]
                (wire-put-i64! (mut w) 7)
                (wire-put-nodes! (mut w) xs 0 (len (load xs)) depth))
          (KView [dc]
                 (let [xs (.items dc)
                       off (.off dc)
                       n (.len dc)]
                   (wire-put-i64! (mut w) 6)
                   (wire-put-nodes! (mut w) xs off n depth)))
          (KSeg [dc]
                (let [parts (.parts dc)
                      n (.len dc)
                      flat (.flat dc)]
                  (wire-put-i64! (mut w) 6)
                  (wire-put-nodes! (mut w) (seg-force parts n flat) 0 n depth)))))))

(defn wire-put-nodes! [(w (mut StrBuf))
                       (xs (ptr (ArrayList Sexp)))
                       (off i64)
                       (n i64)
                       (depth i64)] (-> bool)
  (wire-put-i64! (mut w) n)
  (block :nodes
    (for [i 0 n]
      (unless (wire-put-node! (mut w)
                              (elem xs (+ off i))
                              (+ depth 1))
        (return-from :nodes false))
      0)
    true))

(defn wire-node [(r (ptr ArtifactReader)) (depth i64)] (-> Sexp)
  (if (or (> depth 256) (!= (.error r) ""))
      (do
        (wire-fail! r "provider artifact syntax nesting exceeds 256")
        (mk-sexp (KInt 0) -1 -1))
      (let [(mut s) (: (zeroed Sexp) Sexp)]
        (set! (.lo s) (wire-i64 r))
        (set! (.hi s) (wire-i64 r))
        (set! (.source s) (wire-i64 r))
        (set! (.ctxt s) (wire-i64 r))
        (set! (.hyg s) (wire-i64 r))
        (set! (.hmod s) (hmod-intern (wire-str r)))
        (set! (.horigin s) (wire-i64 r))
        (set! (.hflags s) (wire-i64 r))
        (set! (.node-id s) (wire-i64 r))
        (let [tag (wire-i64 r)]
          (set! (.kind s)
                (cond (= tag 0) (KInt (wire-i64 r))
                      (= tag 1) (KFloat (wire-i64 r))
                      (= tag 2) (KSym (wire-str r))
                      (= tag 3) (KKw (wire-str r))
                      (= tag 4) (KStr (wire-str r))
                      (= tag 5) (KCStr (wire-str r))
                      (= tag 6) (KList (wire-nodes r (+ depth 1)))
                      (= tag 7) (KVec (wire-nodes r (+ depth 1)))
                      :else
                        (do
                          (wire-fail! r "invalid provider artifact syntax tag")
                          (KInt 0)))))
        s)))

(defn wire-nodes [(r (ptr ArtifactReader)) (depth i64)]
  (-> (ptr (ArrayList Sexp)))
  (let [n (wire-count r)
        (mut xs) (ArrayList::new [Sexp] (.a r))]
    (for [i 0 n]
      (when (!= (.error r) "") (break))
      (push! (mut xs) (wire-node r depth))
      0)
    (box-al (.a r) (load xs))))

(defn wire-put-use! [(w (mut StrBuf)) (u (ptr Use))] (-> i64)
  (wire-put-str! (mut w) (.target u))
  (match (.spec u)
    (UAll [] (wire-put-i64! (mut w) 0))
    (UNames [xs] (wire-put-i64! (mut w) 1) (wire-put-names! (mut w) xs)))
  (wire-put-names! (mut w) (.exclude u))
  (let [rs (.renames u)
        n (if (= (cast i64 rs) 0) 0 (len (load rs)))]
    (wire-put-i64! (mut w) n)
    (for [i 0 n]
      (let [rename (elem rs i)]
        (wire-put-str! (mut w) (.from rename))
        (wire-put-str! (mut w) (.to rename)))
      0))
  0)

(defn wire-use [(r (ptr ArtifactReader))] (-> Use)
  (let [(mut u) (zeroed Use)
        (mut renames) (ArrayList::new [Rename] (.a r))]
    (set! (.target u) (wire-str r))
    (let [tag (wire-i64 r)]
      (set! (.spec u)
            (cond (= tag 0) (UAll)
                  (= tag 1) (UNames (wire-names r))
                  :else
                    (do
                      (wire-fail! r "invalid provider artifact use tag")
                      (UAll)))))
    (set! (.exclude u) (wire-names r))
    (let [n (wire-count r)]
      (for [i 0 n]
        (let [from (wire-str r)
              to (wire-str r)]
          (push! (mut renames) (Rename :from from :to to)))
        0))
    (set! (.renames u) (box-al (.a r) (load renames)))
    u))

(defn wire-put-imports! [(w (mut StrBuf)) (xs (ptr (ArrayList ImpEntry)))]
  (-> i64)
  (wire-put-i64! (mut w) (len (load xs)))
  (for [i 0 (len (load xs))]
    (let [entry (elem xs i)
          imp (field entry imp)]
      (wire-put-str! (mut w) (.name entry))
      (wire-put-i64! (mut w) (len (.aliases imp)))
      (for [j 0 (len (.aliases imp))]
        (let [alias (elem (field imp aliases) j)]
          (wire-put-str! (mut w) (.alias alias))
          (wire-put-str! (mut w) (.target alias)))
        0)
      (wire-put-i64! (mut w) (len (.uses imp)))
      (for [j 0 (len (.uses imp))]
        (wire-put-use! (mut w) (elem (field imp uses) j))
        0)
      (wire-put-i64! (mut w) (len (.reexports imp)))
      (for [j 0 (len (.reexports imp))]
        (wire-put-use! (mut w) (elem (field imp reexports) j))
        0)
      (wire-put-use! (mut w) (field imp core))
      (wire-put-i64! (mut w) (if (.core_set imp) 1 0)))
    0)
  0)

(defn wire-imports [(r (ptr ArtifactReader))] (-> (ptr (ArrayList ImpEntry)))
  (let [n (wire-count r)
        (mut xs) (ArrayList::new [ImpEntry] (.a r))
        entry (p/alloc-stack ImpEntry)]
    (for [i 0 n]
      (let [imp (field entry imp)
            na (do (set! (.name entry) (wire-str r)) (wire-count r))]
        (set! imp (zeroed ModImports))
        (set! (.aliases imp) (ArrayList::new [Alias] (.a r)))
        (set! (.uses imp) (ArrayList::new [Use] (.a r)))
        (set! (.forms imp) (ArrayList::new [Sexp] (.a r)))
        (for [j 0 na]
          (let [name (wire-str r)
                target (wire-str r)]
            (push! (field imp aliases) (Alias :alias name :target target)))
          0)
        (let [nu (wire-count r)]
          (for [j 0 nu] (push! (field imp uses) (wire-use r)) 0))
        (set! (.reexports imp) (ArrayList::new [Use] (.a r)))
        (let [nr (wire-count r)]
          (for [j 0 nr] (push! (field imp reexports) (wire-use r)) 0))
        (set! (.core imp) (wire-use r))
        (let [flag (wire-i64 r)]
          (unless (or (= flag 0) (= flag 1))
            (wire-fail! r "invalid provider artifact boolean")
            0)
          (set! (.core_set imp) (= flag 1)))
        (push! (mut xs) (load entry)))
      0)
    (box-al (.a r) (load xs))))

(defn wire-put-exports! [(w (mut StrBuf)) (xs (ptr (ArrayList ExpEntry)))]
  (-> i64)
  (wire-put-i64! (mut w) (len (load xs)))
  (for [i 0 (len (load xs))]
    (let [entry (elem xs i)]
      (wire-put-str! (mut w) (.name entry))
      (wire-put-names! (mut w) (field entry names)))
    0)
  0)

(defn wire-exports [(r (ptr ArtifactReader))] (-> (ptr (ArrayList ExpEntry)))
  (let [n (wire-count r)
        (mut xs) (ArrayList::new [ExpEntry] (.a r))]
    (for [i 0 n]
      (let [name (wire-str r)
            names (wire-names r)]
        (push! (mut xs)
               (ExpEntry
                 :name name
                 :names (load names)
                 :forms (ArrayList::new [Sexp] (.a r)))))
      0)
    (box-al (.a r) (load xs))))

(defn wire-finish [(r (ptr ArtifactReader))] (-> (Result i64 Diag))
  (cond (!= (.error r) "") (Err (artifact-error (.error r)))
        (!= (.at r) (len (.bytes r)))
          (Err (artifact-error "trailing provider artifact metadata"))
        :else (Ok 0)))

(defn wire-put-sources! [(w (mut StrBuf)) (s (ptr LS))] (-> i64)
  (wire-put-i64! (mut w) (len (.sources s)))
  (for [i 0 (len (.sources s))]
    (let [source (elem (field s sources) i)]
      (wire-put-str! (mut w) (.name source))
      (wire-put-str! (mut w) (.text source)))
    0)
  (wire-put-i64! (mut w) (len (.expansions s)))
  (for [i 0 (len (.expansions s))]
    (let [e (elem (field s expansions) i)]
      (wire-put-str! (mut w) (.macro_name e))
      (wire-put-i64! (mut w) (.call_source e))
      (wire-put-i64! (mut w) (.call_lo e))
      (wire-put-i64! (mut w) (.call_hi e))
      (wire-put-i64! (mut w) (.call_ctxt e))
      (wire-put-i64! (mut w) (.def_source e))
      (wire-put-i64! (mut w) (.def_lo e))
      (wire-put-i64! (mut w) (.def_hi e))
      (wire-put-i64! (mut w) (.def_ctxt e))
      (wire-put-i64! (mut w) (.parent e)))
    0)
  0)

(defn wire-sources! [(r (ptr ArtifactReader)) (s (mut LS))] (-> i64)
  (let [n (wire-count r)
        (mut e) (zeroed Expansion)]
    (for [i 0 n]
      (let [name (wire-str r)
            text (wire-str r)]
        (register-source! (mut s) name text))
      0)
    (set! (.srccount s) n)
    (let [contexts (wire-count r)]
      (for [i 0 contexts]
        (set! (.macro_name e) (wire-str r))
        (set! (.call_source e) (wire-i64 r))
        (set! (.call_lo e) (wire-i64 r))
        (set! (.call_hi e) (wire-i64 r))
        (set! (.call_ctxt e) (wire-i64 r))
        (set! (.def_source e) (wire-i64 r))
        (set! (.def_lo e) (wire-i64 r))
        (set! (.def_hi e) (wire-i64 r))
        (set! (.def_ctxt e) (wire-i64 r))
        (set! (.parent e) (wire-i64 r))
        (when (or (< (.call_source e) -1)
                  (>= (.call_source e) n)
                  (< (.def_source e) -1)
                  (>= (.def_source e) n)
                  (< (.parent e) 0)
                  (> (.parent e) i))
          (wire-fail! r "invalid provider artifact expansion provenance")
          0)
        (push! (mut (.expansions s)) e)
        0)))
  0)

(defstruct ProviderMetadata
  [(provider (slice u8))
   (entry (slice u8))
   (symbol (slice u8))
   (sdk (slice u8))
   (host (slice u8))
   (target (slice u8))
   (options (slice u8))
   (key (slice u8))
   (image_digest (slice u8))
   (inputs (ptr (ArrayList ArtifactInput)))
   (setup (ptr LS))
   (names (ptr (ArrayList (slice u8))))
   (registry (ptr (ArrayList (ptr Sexp))))])

(defn wire-put-provider [(a (dyn Allocator)) (m (ptr ProviderMetadata))]
  (-> (Result (slice u8) Diag))
  (let [(mut w) (StrBuf::new a)]
    (wire-put-str! (mut w) "coil-syntax-provider-v2")
    (wire-put-str! (mut w) (.provider m))
    (wire-put-str! (mut w) (.entry m))
    (wire-put-str! (mut w) (.symbol m))
    (wire-put-str! (mut w) (.sdk m))
    (wire-put-str! (mut w) (.host m))
    (wire-put-str! (mut w) (.target m))
    (wire-put-str! (mut w) (.options m))
    (wire-put-str! (mut w) (.key m))
    (wire-put-str! (mut w) (.image_digest m))
    (wire-put-i64! (mut w) (len (load (.inputs m))))
    (for [i 0 (len (load (.inputs m)))]
      (let [input (elem (.inputs m) i)]
        (wire-put-str! (mut w) (.path input))
        (wire-put-str! (mut w) (.digest input)))
      0)
    (wire-put-sources! (mut w) (.setup m))
    (wire-put-imports! (mut w) (field (.setup m) imports))
    (wire-put-exports! (mut w) (field (.setup m) exports))
    (wire-put-names! (mut w) (.names m))
    (wire-put-i64! (mut w) (len (load (.registry m))))
    (block :encode
      (for [i 0 (len (load (.registry m)))]
        (unless (wire-put-node! (mut w) (get (load (.registry m)) i) 0)
          (return-from
            :encode
              (Err [(slice u8) Diag]
                   (artifact-error "provider artifact quote nesting exceeds 256"))))
        0)
      (Ok [(slice u8) Diag] (str (load w))))))

(defn wire-provider [(a (dyn Allocator)) (bytes (slice u8))]
  (-> (Result (ptr ProviderMetadata) Diag))
  (let [(mut r) (wire-reader a bytes)
        m (box! a ProviderMetadata (zeroed ProviderMetadata))
        s (box! a LS (zeroed LS))
        (mut inputs) (ArrayList::new [ArtifactInput] a)
        (mut registry) (ArrayList::new [(ptr Sexp)] a)]
    (ls-init! (mut s) a)
    (unless (= (wire-str (mut r)) "coil-syntax-provider-v2")
      (wire-fail! (mut r) "unsupported provider artifact metadata format")
      0)
    (set! (.provider m) (wire-str (mut r)))
    (set! (.entry m) (wire-str (mut r)))
    (set! (.symbol m) (wire-str (mut r)))
    (set! (.sdk m) (wire-str (mut r)))
    (set! (.host m) (wire-str (mut r)))
    (set! (.target m) (wire-str (mut r)))
    (set! (.options m) (wire-str (mut r)))
    (set! (.key m) (wire-str (mut r)))
    (set! (.image_digest m) (wire-str (mut r)))
    (let [n (wire-count (mut r))]
      (for [i 0 n]
        (let [path (wire-str (mut r))
              digest (wire-str (mut r))]
          (push! (mut inputs) (ArtifactInput :path path :digest digest)))
        0))
    (set! (.inputs m) (box-al a (load inputs)))
    (wire-sources! (mut r) (mut s))
    (set! (.imports s) (load (wire-imports (mut r))))
    (set! (.exports s) (load (wire-exports (mut r))))
    (set! (.names m) (wire-names (mut r)))
    (let [n (wire-count (mut r))]
      (for [i 0 n] (push! (mut registry) (box-sexp a (wire-node (mut r) 0))) 0))
    (set! (.registry m) (box-al a (load registry)))
    (set! (.setup m) s)
    (match (wire-finish (mut r)) (Err [d] (Err d)) (Ok [_] (Ok m)))))

;; A checker profile: a fixed module's registered checkers compiled into one
;; native image. `phase` 0 is a `:phase (phase/BeforeExpand)` checker, 1 a plain one.
(defstruct ProfileEntry [(name (slice u8)) (symbol (slice u8)) (phase i64)])

(defstruct ProfileMetadata
  [(profile (slice u8))
   (sdk (slice u8))
   (host (slice u8))
   (target (slice u8))
   (options (slice u8))
   (key (slice u8))
   (image_digest (slice u8))
   (inputs (ptr (ArrayList ArtifactInput)))
   ;; How many sources and macro contexts the compilation that built the image
   ;; had: the bounds of the provenance its quoted syntax carries.
   (source_count i64)
   (context_count i64)
   (entries (ptr (ArrayList ProfileEntry)))
   (names (ptr (ArrayList (slice u8))))
   (registry (ptr (ArrayList (ptr Sexp))))])

(defn wire-put-profile [(a (dyn Allocator)) (m (ptr ProfileMetadata))]
  (-> (Result (slice u8) Diag))
  (let [(mut w) (StrBuf::new a)]
    (wire-put-str! (mut w) "coil-checker-profile-v1")
    (wire-put-str! (mut w) (.profile m))
    (wire-put-str! (mut w) (.sdk m))
    (wire-put-str! (mut w) (.host m))
    (wire-put-str! (mut w) (.target m))
    (wire-put-str! (mut w) (.options m))
    (wire-put-str! (mut w) (.key m))
    (wire-put-str! (mut w) (.image_digest m))
    (wire-put-i64! (mut w) (len (load (.inputs m))))
    (for [i 0 (len (load (.inputs m)))]
      (let [input (elem (.inputs m) i)]
        (wire-put-str! (mut w) (.path input))
        (wire-put-str! (mut w) (.digest input)))
      0)
    (wire-put-i64! (mut w) (.source_count m))
    (wire-put-i64! (mut w) (.context_count m))
    (wire-put-i64! (mut w) (len (load (.entries m))))
    (for [i 0 (len (load (.entries m)))]
      (let [entry (elem (.entries m) i)]
        (wire-put-str! (mut w) (.name entry))
        (wire-put-str! (mut w) (.symbol entry))
        (wire-put-i64! (mut w) (.phase entry)))
      0)
    (wire-put-names! (mut w) (.names m))
    (wire-put-i64! (mut w) (len (load (.registry m))))
    (block :encode
      (for [i 0 (len (load (.registry m)))]
        (unless (wire-put-node! (mut w) (get (load (.registry m)) i) 0)
          (return-from
            :encode
              (Err [(slice u8) Diag]
                   (artifact-error "checker profile quote nesting exceeds 256"))))
        0)
      (Ok [(slice u8) Diag] (str (load w))))))

(defn wire-profile [(a (dyn Allocator)) (bytes (slice u8))]
  (-> (Result (ptr ProfileMetadata) Diag))
  (let [(mut r) (wire-reader a bytes)
        m (box! a ProfileMetadata (zeroed ProfileMetadata))
        (mut inputs) (ArrayList::new [ArtifactInput] a)
        (mut entries) (ArrayList::new [ProfileEntry] a)
        (mut registry) (ArrayList::new [(ptr Sexp)] a)]
    (unless (= (wire-str (mut r)) "coil-checker-profile-v1")
      (wire-fail! (mut r) "unsupported checker profile metadata format")
      0)
    (set! (.profile m) (wire-str (mut r)))
    (set! (.sdk m) (wire-str (mut r)))
    (set! (.host m) (wire-str (mut r)))
    (set! (.target m) (wire-str (mut r)))
    (set! (.options m) (wire-str (mut r)))
    (set! (.key m) (wire-str (mut r)))
    (set! (.image_digest m) (wire-str (mut r)))
    (let [n (wire-count (mut r))]
      (for [i 0 n]
        (let [path (wire-str (mut r))
              digest (wire-str (mut r))]
          (push! (mut inputs) (ArtifactInput :path path :digest digest)))
        0))
    (set! (.inputs m) (box-al a (load inputs)))
    (set! (.source_count m) (wire-i64 (mut r)))
    (set! (.context_count m) (wire-i64 (mut r)))
    (let [n (wire-count (mut r))]
      (for [i 0 n]
        (let [name (wire-str (mut r))
              symbol (wire-str (mut r))
              phase (wire-i64 (mut r))]
          (unless (or (= phase 0) (= phase 1))
            (wire-fail! (mut r) "invalid checker profile phase")
            0)
          (push! (mut entries)
                 (ProfileEntry
                   :name name
                   :symbol symbol
                   :phase phase)))
        0))
    (set! (.entries m) (box-al a (load entries)))
    (set! (.names m) (wire-names (mut r)))
    (let [n (wire-count (mut r))]
      (for [i 0 n] (push! (mut registry) (box-sexp a (wire-node (mut r) 0))) 0))
    (set! (.registry m) (box-al a (load registry)))
    (match (wire-finish (mut r)) (Err [d] (Err d)) (Ok [_] (Ok m)))))

;; A compile-time unit: one library module's compile-time code -- its macros and
;; the functions only compile-time code calls -- compiled once into a native
;; image. A program that loads the module declares those functions and links
;; them from the image instead of compiling them. ENTRIES are its macros, run
;; through the engine; EXPORTS its functions under their own names, each with
;; the `declare` form a program puts in place of its definition. SOURCES and
;; EXPANSIONS are the build's own tables, which its registry's syntax refers to
;; by index; a loader maps them onto its own.
(defstruct CtUnitExport [(name (slice u8)) (declaration (slice u8))])

(defstruct CtUnitMetadata
  [(module (slice u8))
   (sdk (slice u8))
   (host (slice u8))
   (target (slice u8))
   (options (slice u8))
   (key (slice u8))
   (image_digest (slice u8))
   (inputs (ptr (ArrayList ArtifactInput)))
   (entries (ptr (ArrayList ProfileEntry)))
   (exports (ptr (ArrayList CtUnitExport)))
   (sources (ptr (ArrayList (slice u8))))
   (expansions (ptr (ArrayList Expansion)))
   (registry (ptr (ArrayList (ptr Sexp))))])

(defn wire-put-ct-unit [(a (dyn Allocator)) (m (ptr CtUnitMetadata))]
  (-> (Result (slice u8) Diag))
  (let [(mut w) (StrBuf::new a)]
    (wire-put-str! (mut w) "coil-ct-unit-v1")
    (wire-put-str! (mut w) (.module m))
    (wire-put-str! (mut w) (.sdk m))
    (wire-put-str! (mut w) (.host m))
    (wire-put-str! (mut w) (.target m))
    (wire-put-str! (mut w) (.options m))
    (wire-put-str! (mut w) (.key m))
    (wire-put-str! (mut w) (.image_digest m))
    (wire-put-i64! (mut w) (len (load (.inputs m))))
    (for [i 0 (len (load (.inputs m)))]
      (let [input (elem (.inputs m) i)]
        (wire-put-str! (mut w) (.path input))
        (wire-put-str! (mut w) (.digest input)))
      0)
    (wire-put-i64! (mut w) (len (load (.entries m))))
    (for [i 0 (len (load (.entries m)))]
      (let [entry (elem (.entries m) i)]
        (wire-put-str! (mut w) (.name entry))
        (wire-put-str! (mut w) (.symbol entry)))
      0)
    (wire-put-i64! (mut w) (len (load (.exports m))))
    (for [i 0 (len (load (.exports m)))]
      (let [export (elem (.exports m) i)]
        (wire-put-str! (mut w) (.name export))
        (wire-put-str! (mut w) (.declaration export)))
      0)
    (wire-put-names! (mut w) (.sources m))
    (wire-put-i64! (mut w) (len (load (.expansions m))))
    (for [i 0 (len (load (.expansions m)))]
      (let [e (elem (.expansions m) i)]
        (wire-put-str! (mut w) (.macro_name e))
        (wire-put-i64! (mut w) (.call_source e))
        (wire-put-i64! (mut w) (.call_lo e))
        (wire-put-i64! (mut w) (.call_hi e))
        (wire-put-i64! (mut w) (.call_ctxt e))
        (wire-put-i64! (mut w) (.def_source e))
        (wire-put-i64! (mut w) (.def_lo e))
        (wire-put-i64! (mut w) (.def_hi e))
        (wire-put-i64! (mut w) (.def_ctxt e))
        (wire-put-i64! (mut w) (.parent e)))
      0)
    (wire-put-i64! (mut w) (len (load (.registry m))))
    (block :encode
      (for [i 0 (len (load (.registry m)))]
        (unless (wire-put-node! (mut w) (get (load (.registry m)) i) 0)
          (return-from
            :encode
              (Err [(slice u8) Diag]
                   (artifact-error "compile-time unit quote nesting exceeds 256"))))
        0)
      (Ok [(slice u8) Diag] (str (load w))))))

(defn wire-ct-unit [(a (dyn Allocator)) (bytes (slice u8))]
  (-> (Result (ptr CtUnitMetadata) Diag))
  (let [(mut r) (wire-reader a bytes)
        m (box! a CtUnitMetadata (zeroed CtUnitMetadata))
        (mut inputs) (ArrayList::new [ArtifactInput] a)
        (mut entries) (ArrayList::new [ProfileEntry] a)
        (mut exports) (ArrayList::new [CtUnitExport] a)
        (mut expansions) (ArrayList::new [Expansion] a)
        (mut registry) (ArrayList::new [(ptr Sexp)] a)
        (mut e) (zeroed Expansion)]
    (unless (= (wire-str (mut r)) "coil-ct-unit-v1")
      (wire-fail! (mut r) "unsupported compile-time unit metadata format")
      0)
    (set! (.module m) (wire-str (mut r)))
    (set! (.sdk m) (wire-str (mut r)))
    (set! (.host m) (wire-str (mut r)))
    (set! (.target m) (wire-str (mut r)))
    (set! (.options m) (wire-str (mut r)))
    (set! (.key m) (wire-str (mut r)))
    (set! (.image_digest m) (wire-str (mut r)))
    (let [n (wire-count (mut r))]
      (for [i 0 n]
        (let [path (wire-str (mut r))
              digest (wire-str (mut r))]
          (push! (mut inputs) (ArtifactInput :path path :digest digest)))
        0))
    (set! (.inputs m) (box-al a (load inputs)))
    (let [n (wire-count (mut r))]
      (for [i 0 n]
        (let [name (wire-str (mut r))
              symbol (wire-str (mut r))]
          (push! (mut entries)
                 (ProfileEntry
                   :name name
                   :symbol symbol
                   :phase 1)))
        0))
    (set! (.entries m) (box-al a (load entries)))
    (let [n (wire-count (mut r))]
      (for [i 0 n]
        (let [name (wire-str (mut r))
              declaration (wire-str (mut r))]
          (push! (mut exports)
                 (CtUnitExport :name name :declaration declaration)))
        0))
    (set! (.exports m) (box-al a (load exports)))
    (set! (.sources m) (wire-names (mut r)))
    (let [n (wire-count (mut r))
          sources (len (load (.sources m)))]
      (for [i 0 n]
        (set! (.macro_name e) (wire-str (mut r)))
        (set! (.call_source e) (wire-i64 (mut r)))
        (set! (.call_lo e) (wire-i64 (mut r)))
        (set! (.call_hi e) (wire-i64 (mut r)))
        (set! (.call_ctxt e) (wire-i64 (mut r)))
        (set! (.def_source e) (wire-i64 (mut r)))
        (set! (.def_lo e) (wire-i64 (mut r)))
        (set! (.def_hi e) (wire-i64 (mut r)))
        (set! (.def_ctxt e) (wire-i64 (mut r)))
        (set! (.parent e) (wire-i64 (mut r)))
        (when (or (< (.call_source e) -1)
                  (>= (.call_source e) sources)
                  (< (.def_source e) -1)
                  (>= (.def_source e) sources)
                  (< (.parent e) 0)
                  (> (.parent e) n))
          (wire-fail! (mut r) "invalid compile-time unit expansion provenance")
          0)
        (push! (mut expansions) e)
        0))
    (set! (.expansions m) (box-al a (load expansions)))
    (let [n (wire-count (mut r))]
      (for [i 0 n] (push! (mut registry) (box-sexp a (wire-node (mut r) 0))) 0))
    (set! (.registry m) (box-al a (load registry)))
    (match (wire-finish (mut r)) (Err [d] (Err d)) (Ok [_] (Ok m)))))
