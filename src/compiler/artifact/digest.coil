(module coil.compiler.digest)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.str" :as str)

(export Sha256 sha256-init! sha256-update! sha256-finish sha256-hex)

;; Streaming SHA-256 for artifact identities, FIPS 180-4 sections 4.1.2,
;; 4.2.2 and 6.2. The state owns no heap storage and may be copied to fork a hash.
(defstruct Sha256
  [(words (array u32 8)) (tail (array u8 64)) (used i64) (bytes u64)])

;; The round constants, FIPS 180-4 section 4.2.2: static read-only data, indexed in
;; place rather than rebuilt for every block.
(def K [(: 0x428a2f98 u32)
        0x71374491
        0xb5c0fbcf
        0xe9b5dba5
        0x3956c25b
        0x59f111f1
        0x923f82a4
        0xab1c5ed5
        0xd807aa98
        0x12835b01
        0x243185be
        0x550c7dc3
        0x72be5d74
        0x80deb1fe
        0x9bdc06a7
        0xc19bf174
        0xe49b69c1
        0xefbe4786
        0x0fc19dc6
        0x240ca1cc
        0x2de92c6f
        0x4a7484aa
        0x5cb0a9dc
        0x76f988da
        0x983e5152
        0xa831c66d
        0xb00327c8
        0xbf597fc7
        0xc6e00bf3
        0xd5a79147
        0x06ca6351
        0x14292967
        0x27b70a85
        0x2e1b2138
        0x4d2c6dfc
        0x53380d13
        0x650a7354
        0x766a0abb
        0x81c2c92e
        0x92722c85
        0xa2bfe8a1
        0xa81a664b
        0xc24b8b70
        0xc76c51a3
        0xd192e819
        0xd6990624
        0xf40e3585
        0x106aa070
        0x19a4c116
        0x1e376c08
        0x2748774c
        0x34b0bcb5
        0x391c0cb3
        0x4ed8aa4a
        0x5b9cca4f
        0x682e6ff3
        0x748f82ee
        0x78a5636f
        0x84c87814
        0x8cc70208
        0x90befffa
        0xa4506ceb
        0xbef9a3f7
        0xc67178f2])

(defn sha256-init! [(state (ptr Sha256))] (-> i64)
  (set! state (zeroed Sha256))
  (set! (.words state)
        [0x6a09e667 0xbb67ae85 0x3c6ef372 0xa54ff53a 0x510e527f 0x9b05688c
         0x1f83d9ab 0x5be0cd19])
  0)

;; `x` rotated right by `bits`, 0 < bits < 32. Every count below is a constant, so
;; the two shifts fold into one rotate instruction where the target has one.
(defn rotate-right :inline (Always) [(x u32) (bits u32)] (-> u32)
  (| (>> x bits) (<< x (p/isub (: 32 u32) bits))))

(defn sigma0 :inline (Always) [(x u32)] (-> u32)
  (^ (rotate-right x (: 7 u32)) (rotate-right x (: 18 u32)) (>> x (: 3 u32))))

(defn sigma1 :inline (Always) [(x u32)] (-> u32)
  (^ (rotate-right x (: 17 u32)) (rotate-right x (: 19 u32)) (>> x (: 10 u32))))

(defn sum0 :inline (Always) [(x u32)] (-> u32)
  (^ (rotate-right x (: 2 u32))
     (rotate-right x (: 13 u32))
     (rotate-right x (: 22 u32))))

(defn sum1 :inline (Always) [(x u32)] (-> u32)
  (^ (rotate-right x (: 6 u32))
     (rotate-right x (: 11 u32))
     (rotate-right x (: 25 u32))))

;; The big-endian word at `bytes`, read as one load where the target can.
(defn big-endian-word :inline (Always) [(bytes (ptr u8))] (-> u32)
  (| (<< (cast u32 (load bytes)) (: 24 u32))
     (<< (cast u32 (load (index bytes 1))) (: 16 u32))
     (<< (cast u32 (load (index bytes 2))) (: 8 u32))
     (cast u32 (load (index bytes 3)))))

;; Word T+J of the message schedule, FIPS 180-4 section 6.2.2 step 1, kept in a
;; ring of sixteen with T a multiple of 16, so word T+J lives in slot J. With
;; EXPAND it is computed first, replacing word T+J-16 in that slot. Expanding inside
;; the rounds, rather than in a pass of its own beforehand, gives the processor
;; independent work to do beside the rounds' long dependency chain.
(defn schedule-word! :inline (Always) [(w (ptr u32)) (j i64) (expand bool)]
  (-> u32)
  (let [slot (index w j)]
    (when expand
      (set! slot
            (+ (+ (sigma1 (load (index w (& (+ j 14) 15))))
                  (load (index w (& (+ j 9) 15))))
               (+ (sigma0 (load (index w (& (+ j 1) 15))))
                  (load slot))))
      0)
    (load slot)))

;; Round T+J, FIPS 180-4 section 6.2.2 step 3. Instead of shifting all eight working
;; variables along, the caller renames them: the round writes only the two that
;; change (d gains T1, h becomes T1 + T2), and the next round is called with every
;; argument moved one place to the right.
(defn round! :inline (Always) [(a u32)
                               (b u32)
                               (c u32)
                               (d (ptr u32))
                               (e u32)
                               (f u32)
                               (g u32)
                               (h (ptr u32))
                               (w (ptr u32))
                               (t i64)
                               (j i64)
                               (expand bool)]
  (-> i64)
  (let [t1
          (+ (+ (load h) (sum1 e))
             (+ (^ g (& e (^ f g)))
                (+ (get K (+ t j)) (schedule-word! w j expand))))
        t2 (+ (sum0 a) (| (& a b) (& c (| a b))))]
    (set! d (+ (load d) t1))
    (set! h (+ t1 t2))
    0))

;; Rounds T to T+15; every variable is back under its own name after each eight.
(defn sixteen-rounds! :inline (Always) [(a (ptr u32))
                                        (b (ptr u32))
                                        (c (ptr u32))
                                        (d (ptr u32))
                                        (e (ptr u32))
                                        (f (ptr u32))
                                        (g (ptr u32))
                                        (h (ptr u32))
                                        (w (ptr u32))
                                        (t i64)
                                        (expand bool)]
  (-> i64)
  (do
    (round! (load a)
            (load b)
            (load c)
            d
            (load e)
            (load f)
            (load g)
            h
            w
            t
            0
            expand)
    (round! (load h)
            (load a)
            (load b)
            c
            (load d)
            (load e)
            (load f)
            g
            w
            t
            1
            expand)
    (round! (load g)
            (load h)
            (load a)
            b
            (load c)
            (load d)
            (load e)
            f
            w
            t
            2
            expand)
    (round! (load f)
            (load g)
            (load h)
            a
            (load b)
            (load c)
            (load d)
            e
            w
            t
            3
            expand)
    (round! (load e)
            (load f)
            (load g)
            h
            (load a)
            (load b)
            (load c)
            d
            w
            t
            4
            expand)
    (round! (load d)
            (load e)
            (load f)
            g
            (load h)
            (load a)
            (load b)
            c
            w
            t
            5
            expand)
    (round! (load c)
            (load d)
            (load e)
            f
            (load g)
            (load h)
            (load a)
            b
            w
            t
            6
            expand)
    (round! (load b)
            (load c)
            (load d)
            e
            (load f)
            (load g)
            (load h)
            a
            w
            t
            7
            expand)
    (round! (load a)
            (load b)
            (load c)
            d
            (load e)
            (load f)
            (load g)
            h
            w
            t
            8
            expand)
    (round! (load h)
            (load a)
            (load b)
            c
            (load d)
            (load e)
            (load f)
            g
            w
            t
            9
            expand)
    (round! (load g)
            (load h)
            (load a)
            b
            (load c)
            (load d)
            (load e)
            f
            w
            t
            10
            expand)
    (round! (load f)
            (load g)
            (load h)
            a
            (load b)
            (load c)
            (load d)
            e
            w
            t
            11
            expand)
    (round! (load e)
            (load f)
            (load g)
            h
            (load a)
            (load b)
            (load c)
            d
            w
            t
            12
            expand)
    (round! (load d)
            (load e)
            (load f)
            g
            (load h)
            (load a)
            (load b)
            c
            w
            t
            13
            expand)
    (round! (load c)
            (load d)
            (load e)
            f
            (load g)
            (load h)
            (load a)
            b
            w
            t
            14
            expand)
    (round! (load b)
            (load c)
            (load d)
            e
            (load f)
            (load g)
            (load h)
            a
            w
            t
            15
            expand)
    0))

(defn compress! [(state (ptr Sha256)) (bytes (ptr u8))] (-> i64)
  (let [(mut schedule) (zeroed (array u32 16))
        w (cast (ptr u32) (mut schedule))
        hs (cast (ptr u32) (field state words))]
    (for [i 0 16]
      (set! (index w i) (big-endian-word (index bytes (* i 4))))
      0)
    (let [(mut a) (load (index hs 0))
          (mut b) (load (index hs 1))
          (mut c) (load (index hs 2))
          (mut d) (load (index hs 3))
          (mut e) (load (index hs 4))
          (mut f) (load (index hs 5))
          (mut g) (load (index hs 6))
          (mut h) (load (index hs 7))]
      (sixteen-rounds! (mut a)
                       (mut b)
                       (mut c)
                       (mut d)
                       (mut e)
                       (mut f)
                       (mut g)
                       (mut h)
                       w
                       0
                       false)
      (for [i 1 4]
        (sixteen-rounds! (mut a)
                         (mut b)
                         (mut c)
                         (mut d)
                         (mut e)
                         (mut f)
                         (mut g)
                         (mut h)
                         w
                         (* i 16)
                         true)
        0)
      (set! (index hs 0) (+ (load (index hs 0)) (load a)))
      (set! (index hs 1) (+ (load (index hs 1)) (load b)))
      (set! (index hs 2) (+ (load (index hs 2)) (load c)))
      (set! (index hs 3) (+ (load (index hs 3)) (load d)))
      (set! (index hs 4) (+ (load (index hs 4)) (load e)))
      (set! (index hs 5) (+ (load (index hs 5)) (load f)))
      (set! (index hs 6) (+ (load (index hs 6)) (load g)))
      (set! (index hs 7) (+ (load (index hs 7)) (load h))))
    0))

;; Whole blocks bypass the tail buffer. Input storage is borrowed for this call.
;; SHA-256's byte-oriented input limit is 2^61-1 bytes; reject overflow.
(defn sha256-update! [(state (ptr Sha256)) (bytes (slice u8))] (-> bool)
  (let [n (len bytes)
        data (data bytes)
        tail (cast (ptr u8) (field state tail))
        (mut at) 0]
    (if (> (cast u64 n)
           (p/iadd (: 0x1fffffffffffffff u64)
                   (p/iadd (p/inot (.bytes state)) (: 1 u64))))
        false
        (do
          (set! (.bytes state) (+ (.bytes state) (cast u64 n)))
          (loop (if (or (= (.used state) 0) (>= (load at) n)) (break) 0)
            (set! (index tail (.used state)) (load (index data (load at))))
            (set! (.used state) (+ (.used state) 1))
            (set! at (+ (load at) 1))
            (when (= (.used state) 64)
              (compress! state tail)
              (set! (.used state) 0)
              0))
          (loop (if (> (+ (load at) 64) n) (break) 0)
            (compress! state (index data (load at)))
            (set! at (+ (load at) 64)))
          (loop (if (>= (load at) n) (break) 0)
            (set! (index tail (.used state)) (load (index data (load at))))
            (set! (.used state) (+ (.used state) 1))
            (set! at (+ (load at) 1)))
          true))))

;; Finish a copy; callers can obtain a prefix digest and continue updating.
(defn sha256-finish [(state (ptr Sha256))] (-> (array u8 32))
  (let [copy (p/alloc-stack Sha256)
        result (p/alloc-stack (array u8 32))
        out (cast (ptr u8) result)]
    (set! copy (load state))
    (let [tail (cast (ptr u8) (field copy tail))
          bits (<< (.bytes copy) (: 3 u64))]
      (set! (index tail (.used copy)) (: 128 u8))
      (set! (.used copy) (+ (.used copy) 1))
      (when (> (.used copy) 56)
        (for [i (.used copy) 64] (set! (index tail i) (: 0 u8)) 0)
        (compress! copy tail)
        (set! (.used copy) 0)
        0)
      (for [i (.used copy) 56] (set! (index tail i) (: 0 u8)) 0)
      (for [i 0 8]
        (set! (index tail (+ 56 i))
              (cast u8 (>> bits (cast u64 (* (+ 7 (* i -1)) 8)))))
        0)
      (compress! copy tail))
    (let [h (cast (ptr u32) (field copy words))]
      (for [i 0 32]
        (set! (index out i)
              (cast u8
                    (>> (load (index h (/ i 4)))
                        (cast u32 (* (+ 3 (* (% i 4) -1)) 8)))))
        0))
    (load result)))

(defn sha256-hex [(a (dyn alloc/Allocator)) (state (ptr Sha256))]
  (-> (slice u8))
  (let [(mut digest) (: (sha256-finish state) (array u8 32))
        digits "0123456789abcdef"
        (mut text) (str/StrBuf::new a)]
    (for [i 0 32]
      (let [byte (cast i64 (load (index (cast (ptr u8) (mut digest)) i)))]
        (push! (mut text) (get digits (>> byte 4)))
        (push! (mut text) (get digits (& byte 15))))
      0)
    (str (load (mut text)))))
