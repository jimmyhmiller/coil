;;; Finding the coil.jit unit the toolchain ships, and whether a unit is fresh:
;;; shared by the commands that build and link units and by `coil.jit`, which
;;; reads a program's sources as a build would.
(module coil.compiler.shipped_unit)
(import "coil.primitive" :as primitive)
(import "coil.compiler.unit_state" :use *)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :as str :use * :exclude [parse-int])
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.ffi" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.metastate" :use *)
(import "coil.compiler.pipeline" :use [unit-backend-name])
(import "coil.compiler.artifact_identity" :as artifact-id)
(import "declarative.cir" :as declarative)
(import "coil.project" :use [m-realpath])
(import "coil.text" :use *)
(import "coil.fs" :use [access])

(defn unit-first-space [(s (slice u8))] (-> i64)
  (let [(mut r) -1]
    (for [i 0 (len s)]
      (when (and (< (load r) 0)
                 (= (primitive/cast i64 (get s i)) 32))
        (set! r i)
        0)
      0)
    (load r)))

; The first lines of a unit's key: the compiler binary, target, optimization level
; and backend. unit-write-key! records them and unit-fresh-for? compares them.
(defn unit-key-header [(a (dyn Allocator)) (backend i64) (opt i64)]
  (-> (slice u8))
  (let [(mut key) (StrBuf::new a)]
    (try (let [d
                 (try-or! (artifact-id/compiler-identity a
                                                         (self-command-path a))
                          (push-str! (mut key) "?"))]
           (push-str! (mut key) d)))
    (push! (mut key) (: 10 u8))
    (push-str! (mut key) (target-arch-str))
    (push! (mut key) (: 45 u8))
    (push-str! (mut key) (target-os-str))
    (push! (mut key) (: 10 u8))
    (push-str! (mut key) (i64->str a opt))
    (push! (mut key) (: 10 u8))
    (push-str! (mut key) "backend ")
    (push-str! (mut key) (unit-backend-name backend))
    (push! (mut key) (: 10 u8))
    ; a module may expand differently for each (`primitive/jit-implementation`)
    (push-str! (mut key) "jit ")
    (push-str! (mut key) (jit-implementation-name (jit-implementation)))
    (push! (mut key) (: 10 u8))
    ; The declarative backend generates different code under different
    ; DECLARATIVE_* settings; it renders those that change the code.
    (when (= backend 9)
      (push-str! (mut key) "declarative-settings ")
      (push-str! (mut key) (declarative/settings-key a))
      (push! (mut key) (: 10 u8)))
    ; Sources are recorded by their library-relative names and checked by
    ; content (unit.sources), so where the library sits is no part of the key:
    ; a copied or moved toolchain keeps its unit.
    (push-str! (mut key) "sources-v3\n")
    (str (load key))))


; True when the unit in `dir` was built by this compiler for this target,
; optimization level and backend, and every source it recorded still hashes the
; same. A unit whose key predates backends is never fresh, so it is rebuilt.
(defn unit-fresh-for? [(a (dyn Allocator))
                       (dir (slice u8))
                       (backend i64)
                       (opt i64)] (-> bool)
  (and (unit-files? a dir)
       (and (= (read-file a (to-cstr a (path-join a dir "unit.key")))
               (unit-key-header a backend opt))
            (unit-sources-current? a dir))))

;;; Is the interface of the unit in DIR the one its module has now, for this
;;; target, BACKEND, optimization level OPT and coil.jit implementation, made
;;; by whichever compiler: its key but the compiler's identity matches, and
;;; every source it recorded hashes the same. What a reader of the interface
;;; alone asks, as a program that embeds the compiler does: that program is
;;; not the compiler binary the key names, and links none of the unit.
(defn unit-interface-current? [(a (dyn Allocator))
                               (dir (slice u8))
                               (backend i64)
                               (opt i64)] (-> bool)
  (and (unit-files? a dir)
       (and (= (key-after-identity (read-file a
                                              (to-cstr a
                                                       (path-join a
                                                                  dir
                                                                  "unit.key"))))
               (key-after-identity (unit-key-header a backend opt)))
            (unit-sources-current? a dir))))

;;; A unit key without its first line, the identity of the compiler that made it.
(defn key-after-identity [(key (slice u8))] (-> (slice u8))
  (let [(mut at) (len key)]
    (block :found
      (for [i 0 (len key)]
        (when (= (get key i) (: 10 u8))
          (set! at (+ i 1))
          (break :found 0)))
      0)
    (subslice key (load at) (len key))))

(defn unit-files? [(a (dyn Allocator)) (dir (slice u8))] (-> bool)
  (and (> (len dir) 0)
       (and (= (access (to-cstr a (path-join a dir "unit.key")) 0) (: 0 i32))
            (= (access (to-cstr a (path-join a dir "unit.sources")) 0)
               (: 0 i32)))))

;;; Does every source the unit in DIR recorded still hash the same? A missing
;;; or changed one is stale.
(defn unit-sources-current? [(a (dyn Allocator)) (dir (slice u8))] (-> bool)
  (let [text (read-file a (to-cstr a (path-join a dir "unit.sources")))
        lines (split a text "\n")
        (mut ok) true]
    (for [i 0 (len (load lines))]
      (let [line (get (load lines) i)]
        (when (> (len line) 0)
          (let [sp (unit-first-space line)]
            (if (< sp 0)
                (set! ok false)
                (let [want-sha (subslice line 0 sp)
                      fpath (subslice line (+ sp 1) (len line))]
                  (try (let [d
                               (try-or! (artifact-id/artifact-file-digest-once (library-input-path a
                                                                                                   fpath))
                                        (set! ok false))]
                         (unless (= d want-sha) (set! ok false) 0))))))))
      0)
    (load ok)))


; ---- the shipped coil.jit units ---------------------------------------------
; The toolchain provides one coil.jit unit PER BACKEND AND PER IMPLEMENTATION
; (`--jit=`) beside its library,
; `<prefix>/lib/coil/units/<backend>/jit-<implementation>/coil.compiler.jit_api`,
; each emitted by its own backend. `dev.py install` warms the llvm unit of the
; default backend (a release build's) and, where the native backend compiles for
; the host, of the native backend (a debug build's); any other is built the first
; time a program built that way imports
; coil.jit, and is linked from then on. Only in an installed layout -- in a checkout the compiler
; sources are what is being edited, and a stale unit must never shadow them
; (unit-fresh-for? re-hashes every recorded source, so an edited installed
; source makes the unit stale too).
(defn shipped-unit-dir [(a (dyn Allocator)) (ns (slice u8)) (backend i64)]
  (-> (slice u8))
  (let [layout (stdlib-layout a)]
    (if (not (stdlib-installed? layout))
        ""
        (shipped-unit-path a
                           (path-join a (dirname (.libs layout)) "units")
                           ns
                           backend))))

; ROOT/<backend>/jit-<implementation>/NS: one unit per backend and per coil.jit
; implementation, so building for one never replaces the other's.
(defn shipped-unit-path [(a (dyn Allocator))
                         (root (slice u8))
                         (ns (slice u8))
                         (backend i64)] (-> (slice u8))
  (path-join a
             (path-join a
                        (path-join a root (unit-backend-name backend))
                        (sconcat a
                                 "jit-"
                                 (jit-implementation-name (jit-implementation))))
             ns))

; Where an on-demand shipped unit goes when the installed library is not
; writable (a system-wide install): `$XDG_CACHE_HOME/coil`, else `~/.cache/coil`,
; again by backend. "" when neither variable is set.
(defn user-unit-dir [(a (dyn Allocator)) (ns (slice u8)) (backend i64)]
  (-> (slice u8))
  (let [xdg (unit-getenv c"XDG_CACHE_HOME")
        home (unit-getenv c"HOME")
        root
          (cond (!= (primitive/cast i64 xdg) 0)
                  (path-join a (from-cstr xdg) "coil")
                (!= (primitive/cast i64 home) 0)
                  (path-join a (from-cstr home) ".cache/coil")
                :else "")]
    (if (= (len root) 0)
        ""
        (shipped-unit-path a (path-join a root "units") ns backend))))


; Every consumer optimization level shares one shipped unit, built at -O3. (The
; SDK must never be built at -O0, where LLVM rejects its guaranteed tail calls.)
(const SHIPPED-UNIT-OPT 3)


;;; The shipped unit of NS for BACKEND whose interface is current
;;; (`unit-interface-current?`), beside the library or in the user cache, as a
;;; prebuilt unit that stands in for NS's source; nothing when neither is. Only
;;; its interface is read: nothing is loaded or linked.
(defn fresh-shipped-unit [(a (dyn Allocator)) (ns (slice u8)) (backend i64)]
  (-> (Option PrebuiltUnit))
  (let [lib-dir (shipped-unit-dir a ns backend)
        user-dir (user-unit-dir a ns backend)
        dir
          (cond (unit-interface-current? a lib-dir backend SHIPPED-UNIT-OPT)
                  lib-dir
                (unit-interface-current? a user-dir backend SHIPPED-UNIT-OPT)
                  user-dir
                :else "")
        iface (path-join a dir "interface.coil")]
    (if (or (= (len dir) 0) (!= (access (to-cstr a iface) 0) (: 0 i32)))
        (None [PrebuiltUnit])
        (Some (PrebuiltUnit
                :module ns
                :dir dir
                :object (path-join a dir "unit.o")
                :dylib ""
                :used false
                :pending false
                :backend backend
                :source
                  (Resolved
                    :text (read-file a (to-cstr a iface))
                    :incdir dir
                    :disp (sconcat3 a "<unit:" ns ">")))))))

; Whether this build's own namespace roots contain the toolchain's SDK sources.
; Such a program IS the toolchain -- a compiler candidate built against a staged
; layout whose library is the checkout being edited -- so it compiles those
; sources; a unit made from them must never stand in for them.
(defn unit-sdk-in-roots? [(a (dyn Allocator))] (-> bool)
  (let [layout (stdlib-layout a)
        env (unit-getenv c"COIL_NAMESPACE_ROOTS")]
    (if (= (primitive/cast i64 env) 0)
        false
        (match (m-realpath a (.sdk layout))
          (None [] false)
          (Some [sdk]
                (let [dirs (split a (from-cstr env) ":")
                      (mut found) false]
                  (for [i 0 (len (load dirs))]
                    (match (m-realpath a (get (load dirs) i))
                      (Some [p] (when (= p sdk) (set! found true) 0))
                      (None [] 0))
                    0)
                  (load found)))))))
