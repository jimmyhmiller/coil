;;; Immutable source payloads shared by accepted compiler snapshots. Loader
;;; slots remain private; only their read-only name, text, and line table share.
(module coil.compiler.retained_source)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.slice" :use *)
(import "coil.mem" :use [mem-copy])
(import "coil.io" :as io)

(defstruct SourcePayload
  [(references i64) (name (slice u8)) (text (slice u8))
   (lines (ArrayList i64)) (bytes i64)])
(defstruct SourceStore
  [(a (dyn Allocator)) (index (HashMap i64 (ptr SourcePayload)))
   (live-bytes i64) (copies i64) (copied-bytes i64) (reuses i64)
   ; An immutable store whose payloads outlive this one, used without holding them.
   (external (ptr SourceStore))])

(defn store-new [(a (dyn Allocator))] (-> SourceStore)
  (SourceStore :a a :index (hm-new [i64 (ptr SourcePayload)] a (i64-keyops))
    :live-bytes 0 :copies 0 :copied-bytes 0 :reuses 0
    :external (p/cast (ptr SourceStore) 0)))

;;; The external store's payload whose line table is `lines`, or null.
(defn find-external [(store (ptr SourceStore)) (lines (ptr (ArrayList i64)))] (-> (ptr SourcePayload))
  (if (= (p/cast i64 (.external store)) 0)
      (p/cast (ptr SourcePayload) 0)
      (match (get (.index (.external store)) (p/cast i64 lines))
        (Some [source] source)
        (None [] (p/cast (ptr SourcePayload) 0)))))
(defn copy-bytes [(a (dyn Allocator)) (value (slice u8))] (-> (slice u8))
  (if (= (len value) 0) (slice-new [u8] (p/cast (ptr u8) 0) 0)
    (match (alloc [u8] a (len value))
      (None [] (do (oom-at c"retained source" (len value)) value))
      (Some [owned]
        (do (mem-copy [u8] (slice-data owned) (slice-data value) (len value)) owned)))))

;;; The lookup key is the immutable line-table header's address. Source slots
;;; may be reused, and equal source text does not imply equal provenance.
(defn acquire! [(store (ptr SourceStore)) (name (slice u8)) (text (slice u8))
                (lines (ptr (ArrayList i64)))] (-> (ptr SourcePayload))
  (match (get (.index store) (p/cast i64 lines))
    (Some [source]
      (do (set! (.references source) (+ (.references source) 1))
        (set! (.reuses store) (+ (.reuses store) 1)) source))
    (None []
      (let [a (.a store) source (box! a SourcePayload (p/zeroed SourcePayload))]
        (set! (.references source) 1)
        (set! (.name source) (copy-bytes a name))
        (set! (.text source) (copy-bytes a text))
        (set! (.lines source) (al-new [i64] a))
        (unless (= (p/cast i64 lines) 0)
          (for [i 0 (len (load lines))]
            (push! (mut (.lines source)) (get (load lines) i))) 0)
        (set! (.bytes source) (+ (p/sizeof SourcePayload)
          (+ (len name) (+ (len text) (* (.cap (.lines source)) (p/sizeof i64))))))
        (set! (.live-bytes store) (+ (.live-bytes store) (.bytes source)))
        (set! (.copies store) (+ (.copies store) 1))
        (set! (.copied-bytes store) (+ (.copied-bytes store) (.bytes source)))
        (set! (mut (.index store)) (p/cast i64 (field source lines)) source)
        source))))

(defn release! [(store (ptr SourceStore)) (source (ptr SourcePayload))] (-> i64)
  (assert (> (.references source) 0))
  (set! (.references source) (- (.references source) 1))
  (when (= (.references source) 0)
    (let [a (.a store)]
      (hm-remove! (mut (.index store)) (p/cast i64 (field source lines)))
      (set! (.live-bytes store) (- (.live-bytes store) (.bytes source)))
      (when (> (len (.name source)) 0) (free [u8] a (.name source)) 0)
      (when (> (len (.text source)) 0) (free [u8] a (.text source)) 0)
      (al-free! (mut (.lines source)))
      (free [SourcePayload] a (slice-new source 1))) 0)
  0)
;;; Release the store's index. Every payload must already be released.
(defn store-free! [(store (ptr SourceStore))] (-> i64)
  (unless (= (len (.index store)) 0)
    (io/print-str (io/stderr) "retained source store freed with live payloads\n")
    (abort)
    0)
  (hm-free! (mut (.index store)))
  0)

(defn release-list! [(store (ptr SourceStore))
                     (owners (mut (ArrayList (ptr SourcePayload))))] (-> i64)
  (for [i 0 (len (load owners))] (release! store (get (load owners) i)))
  (al-free! (mut owners))
  0)
