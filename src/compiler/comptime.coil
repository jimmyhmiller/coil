; src/compiler/comptime.coil — self-host Coil compiler, comptime module.
(module comptime)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)  ; the module_fns set index (module-fns-has)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "mtrace" :use *)
(import "ast" :use *)
(import "ctval" :use *)  ; CtVal / EnvBind / CtCtx — the value model, now on its own
(import "check" :use *)
(import "expander" :use *)
(import "loader" :use *)
(import "parser" :use *)
(import "coil.reader" :use *)
(import "resolve" :use *)

(defn is-aggregate [(c (ptr CtVal))] (-> bool)
  (match (load c)
    (CStruct [name fields] true)
    (CArray [elem cells] true)
    (CSum [variant fields] true)
    (CInt [v] false)
    (CBool [b] false)
    (CFloat [x] false)
    (CStr [s] false)
    (CCode [f] false)
    (CRef [cell] false)))
(defn clone-cells [(cells (ptr (ArrayList (ptr CtVal))))] (-> (ptr (ArrayList (ptr CtVal))))
  (let [a (malloc-allocator)
        n (al-len [(ptr CtVal)] (load cells))
        (mut out) (al-new [(ptr CtVal)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out)
                          (new-cell (deep-clone (al-get [(ptr CtVal)] (load cells) (load i)))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(ptr CtVal)] a (load out))))
(defn deep-clone [(c (ptr CtVal))] (-> CtVal)
  (match (load c)
    (CStruct [name fields] (CStruct name (clone-cells fields)))
    (CArray [elem cells] (CArray elem (clone-cells cells)))
    (CSum [variant fields] (CSum variant (clone-cells fields)))
    (CInt [v] (CInt v))
    (CBool [b] (CBool b))
    (CFloat [x] (CFloat x))
    (CStr [s] (CStr s))
    (CCode [f] (CCode f))
    (CRef [cell] (CRef cell))))
(defn to-content [(c (ptr CtVal))] (-> CtVal)
  (match (load c)
    (CRef [cell] (deep-clone cell))
    (CInt [v] (CInt v))
    (CBool [b] (CBool b))
    (CFloat [x] (CFloat x))
    (CStr [s] (CStr s))
    (CCode [f] (CCode f))
    (CStruct [name fields] (CStruct name fields))
    (CArray [elem cells] (CArray elem cells))
    (CSum [variant fields] (CSum variant fields))))
(defn cell-value [(cell (ptr CtVal))] (-> CtVal)
  (if (is-aggregate cell) (CRef cell) (load cell)))
(defsum Flow
  (FVal [(v CtVal)])
  (FBrk [(value (Option CtVal)) (label (Option (slice u8)))])
  (FCont [(label (Option (slice u8)))]))
(defstruct CtFoldHook [(isset i64) (fp (fnptr c [(ref (dyn Allocator)) (ptr Expr) (ptr CtCtx)] (ptr i8)))])
(defn ct-fold-hook [] (-> (ptr CtFoldHook))
  (primitive/alloc-static CtFoldHook))
(defn set-comptime-fold-hook! [(fp (fnptr c [(ref (dyn Allocator)) (ptr Expr) (ptr CtCtx)] (ptr i8)))] (-> i64)
  (let [b (ct-fold-hook)] (set! (.fp b) fp) (set! (.isset b) 1) 0))
; A CAPABILITY gap — the interpreter says "isn't supported yet" for a construct real
; codegen CAN do (sizeof/alignof/offsetof, a generic call, a string, a bitfield op, a
; function pointer, an aggregate-const ref, a trait call, …). ONLY those are routed to
; the compiled engine; a genuine SEMANTIC error (division by zero, an arithmetic type
; mismatch, a non-place target) must stand exactly as the interpreter reported it — the
; compiled engine would silently compute a target-specific value (arm64 idiv-by-0 = 0)
; or crash, masking the bug. The "supported yet" wording is the interpreter's own
; convention for "valid code I can't evaluate", so it is a reliable discriminator.
(defn ct-tag [(v CtVal)] (-> i64)
  (match v
    (CInt [n] 0)
    (CBool [b] 1)
    (CFloat [x] 2)
    (CStr [s] 3)
    (CCode [f] 4)
    (CStruct [a b] 5)
    (CArray [a b] 6)
    (CSum [a b] 7)
    (CRef [c] 8)))
(defn cint-of [(v CtVal)] (-> i64)
  (match v
    (CInt [n] n)
    (CBool [b] 0)
    (CFloat [x] 0)
    (CStr [s] 0)
    (CCode [f] 0)
    (CStruct [a b] 0)
    (CArray [a b] 0)
    (CSum [a b] 0)
    (CRef [c] 0)))
(defn cfloat-of [(v CtVal)] (-> f64)
  (match v
    (CFloat [x] x)
    (CInt [n] 0.0)
    (CBool [b] 0.0)
    (CStr [s] 0.0)
    (CCode [f] 0.0)
    (CStruct [a b] 0.0)
    (CArray [a b] 0.0)
    (CSum [a b] 0.0)
    (CRef [c] 0.0)))
(defn cbool-of [(v CtVal)] (-> bool)
  (match v
    (CBool [b] b)
    (CInt [n] false)
    (CFloat [x] false)
    (CStr [s] false)
    (CCode [f] false)
    (CStruct [a b] false)
    (CArray [a b] false)
    (CSum [a b] false)
    (CRef [c] false)))
; bits->f64 moved to coil.mem (it was defined identically here and in interp.coil).
(defn trunc [(n i64) (bits i64) (signed bool)] (-> i64)
  (if (>= bits (primitive/cast i64 64))
      n
      (let [mask (primitive/isub (primitive/ishl 1 bits) 1)
            masked (primitive/iand n mask)]
        (if (and signed (!= (primitive/iand masked (primitive/ishl 1 (primitive/isub bits 1))) (primitive/cast i64 0)))
            (primitive/isub masked (primitive/ishl 1 bits))
            masked))))
(defn icmp-ord [(x i64) (y i64)] (-> i64)
  (if (< x y) -1 (when (> x y) 1)))
(defn fcmp-ord [(x f64) (y f64)] (-> i64)
  (cond (primitive/fcmp-lt x y) -1 (primitive/fcmp-eq x y) 0 (primitive/fcmp-gt x y) 1 :else -1))
(defn bool-ord [(x bool) (y bool)] (-> i64)
  (if (and (not x) y) -1 (when (and x (not y)) 1)))
(defn cmp-apply [(op i64) (ord i64)] (-> bool)
  (cond (= op (primitive/cast i64 0)) (= ord (primitive/cast i64 -1))
        (= op (primitive/cast i64 1)) (!= ord (primitive/cast i64 1))
        (= op (primitive/cast i64 2)) (= ord (primitive/cast i64 1))
        (= op (primitive/cast i64 3)) (!= ord (primitive/cast i64 -1))
        (= op (primitive/cast i64 4)) (= ord (primitive/cast i64 0))
        :else (!= ord (primitive/cast i64 0))))
(defn ct-divzero-msg [(rem bool)] (-> (slice u8))
  (if rem "comptime: remainder by zero" "comptime: division by zero"))
(defn wrap-mut [(v CtVal)] (-> CtVal)
  (if (= (ct-tag v) (primitive/cast i64 8)) v (CRef (new-cell v))))
(defn cast-trunc [(n i64) (ty Type)] (-> CtVal)
  (match ty
    (TInt [bits signed] (CInt (trunc n bits signed)))
    (TFloat [b] (CInt n))
    (TBool [] (CInt n))
    (TVoid [] (CInt n))
    (TPtr [i] (CInt n))
    (TRef [m i] (CInt n))
    (TStruct [nm] (CInt n))
    (TArray [e k] (CInt n))
    (TSlice [e] (CInt n))
    (TVec [e k] (CInt n))
    (TFn [c p r] (CInt n))
    (TApp [nm ar] (CInt n))
    (TNever [] (CInt n))
    (TCode [] (CInt n))
    (TCodeBuilder [] (CInt n))
    (TExternRef [] (CInt n))))
(defn cref-cell [(v CtVal)] (-> (ptr CtVal))
  (match v (CRef [c] c) (_ (primitive/cast (ptr CtVal) 0))))
(defn cstruct-name [(v CtVal)] (-> (slice u8))
  (match v (CStruct [nm f] nm) (_ "")))
(defn cstruct-fields [(v CtVal)] (-> (ptr (ArrayList (ptr CtVal))))
  (match v (CStruct [nm f] f) (_ (primitive/cast (ptr (ArrayList (ptr CtVal))) 0))))
(defn carray-cells [(v CtVal)] (-> (ptr (ArrayList (ptr CtVal))))
  (match v (CArray [el c] c) (_ (primitive/cast (ptr (ArrayList (ptr CtVal))) 0))))
(defn csum-variant [(v CtVal)] (-> (slice u8))
  (match v (CSum [vr f] vr) (_ "")))
(defn csum-fields [(v CtVal)] (-> (ptr (ArrayList (ptr CtVal))))
  (match v (CSum [vr f] f) (_ (primitive/cast (ptr (ArrayList (ptr CtVal))) 0))))
(defn is-aggregate-v [(c CtVal)] (-> bool)
  (let [t (ct-tag c)] (or (= t (primitive/cast i64 5)) (or (= t (primitive/cast i64 6)) (= t (primitive/cast i64 7))))))
(defn to-content-v [(v CtVal)] (-> CtVal)
  (to-content (new-cell v)))
(defn opt-ctval-or [(o (Option CtVal))] (-> CtVal)
  (match o (Some [v] v) (None [] (CInt 0))))
(defn lbl-match [(l (Option (slice u8))) (label (Option (slice u8)))] (-> bool)
  (match l
    (None [] true)
    (Some [ls] (match label (None [] false) (Some [lab] (= ls lab))))))
(defn diag-some? [(o (Option Diag))] (-> bool)
  (match o (Some [d] true) (None [] false)))
(defn dec->str [(a (dyn Allocator)) (n i64)] (-> (slice u8))
  (if (= n (primitive/cast i64 0))
      "0"
      (let [neg (< n (primitive/cast i64 0))
            (mut m) (if neg (primitive/isub 0 n) n)
            tmp (primitive/cast (ptr u8) (primitive/cast (ptr i8) (slice-data (match (alloc-bytes a 24 1) (Some [s] s) (None [] (do (oom-at c"compiler allocation" 24) (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0)))))))
            (mut cnt) 0]
        (loop (if (= (load m) (primitive/cast i64 0))
                  (break)
                  (do
                    (set! (primitive/index tmp (load cnt))
                          (primitive/cast u8 (primitive/iadd (primitive/urem (load m) 10) 48)))
                    (set! cnt (primitive/iadd (load cnt) 1))
                    (set! m (primitive/udiv (load m) 10)))))
        (let [extra (when neg 1)
              total (primitive/iadd (load cnt) extra)
              out (primitive/cast (ptr u8) (primitive/cast (ptr i8) (slice-data (match (alloc-bytes a total 1) (Some [s] s) (None [] (do (oom-at c"compiler allocation" total) (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0)))))))
              (mut j) (when neg 1)
              (mut k) (load cnt)]
          (when neg (store! (primitive/index out 0) (primitive/cast u8 45)) 0)
          (loop (if (= (load k) (primitive/cast i64 0))
                    (break)
                    (do
                      (set! k (primitive/isub (load k) 1))
                      (set! (primitive/index out (load j)) (load (primitive/index tmp (load k))))
                      (set! j (primitive/iadd (load j) 1)))))
          (slice-new [u8] out total)))))
(defn ct-struct-find [(cx (ptr CtCtx)) (name (slice u8))] (-> (ptr StructDef))
  (let [lst (load (field cx structs))
        n (al-len [StructDef] (load lst))
        (mut i) 0
        (mut r) (primitive/cast (ptr StructDef) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [StructDef] lst (load i)) name)) name)
                  (store! r (al-elem [StructDef] lst (load i)))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (if (!= (primitive/cast i64 (load r)) (primitive/cast i64 0))
        (load r)
        (let [p (sem-model)]
          (if (= (primitive/cast i64 p) (primitive/cast i64 0))
              (load r)
              (let [model-lst (load (field p structs))
                    model-n (al-len [StructDef] model-lst)
                    (mut j) 0]
                (loop (if (>= (load j) model-n)
                          (break)
                          (do
                            (when (= (load (field (al-elem [StructDef] model-lst (load j)) name)) name)
                              (store! r (al-elem [StructDef] model-lst (load j)))
                              0)
                            (set! j (primitive/iadd (load j) 1)))))
                (load r)))))))
(defn is-u8 [(t Type)] (-> bool)
  (match t (TInt [bits signed] (= bits (primitive/cast i64 8))) (_ false)))
(defn zeroed-struct-cells [(flds (ptr (ArrayList Field))) (cx (ptr CtCtx))] (-> (Result (ptr (ArrayList (ptr CtVal)))
                                                                                        Diag))
  (let [a (load (field cx a))
        nf (al-len [Field] (load flds))
        (mut out) (al-new [(ptr CtVal)] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) nf))
              (break)
              (do
                (match (zeroed-content (.ty (al-elem [Field] flds (load i)))
                                       cx)
                  (Err [d] (do (set! errf (Some d)) 0))
                  (Ok [c] (do (al-push! (mut out) (new-cell c)) 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList (ptr CtVal))) Diag] d))
      (None [] (Ok [(ptr (ArrayList (ptr CtVal))) Diag] (box-al [(ptr CtVal)] a (load out)))))))
(defn zeroed-array-cells [(el Type) (k i64) (cx (ptr CtCtx))] (-> (Result (ptr (ArrayList (ptr CtVal))) Diag))
  (let [a (load (field cx a))
        (mut out) (al-new [(ptr CtVal)] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) k))
              (break)
              (do
                (match (zeroed-content el cx)
                  (Err [d] (do (set! errf (Some d)) 0))
                  (Ok [c] (do (al-push! (mut out) (new-cell c)) 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList (ptr CtVal))) Diag] d))
      (None [] (Ok [(ptr (ArrayList (ptr CtVal))) Diag] (box-al [(ptr CtVal)] a (load out)))))))
; T := concrete substitution built from a generic def's type params and the type
; args of an application, so `(ArrayList i64)` can be zeroed by zeroing ArrayList's
; fields with T bound to i64.
(defn subst-from-targs [(a (dyn Allocator)) (tps (ptr (ArrayList (slice u8)))) (targs (ptr (ArrayList Type)))] (-> (ptr (ArrayList SubstEntry)))
  (let [s (subst-new a)
        ntp (al-len [(slice u8)] (load tps))
        nta (al-len [Type] (load targs))
        (mut i) 0]
    (loop (if (>= (load i) ntp)
              (break)
              (do
                (when (< (load i) nta)
                  (subst-insert! s
                                 (al-get [(slice u8)] (load tps) (load i))
                                 (al-elem [Type] targs (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    s))
(defn zeroed-struct-cells-subst [(flds (ptr (ArrayList Field))) (subst (ptr (ArrayList SubstEntry))) (cx (ptr CtCtx))] (-> (Result (ptr (ArrayList (ptr CtVal)))
                                                                                                                                   Diag))
  (let [a (load (field cx a))
        nf (al-len [Field] (load flds))
        (mut out) (al-new [(ptr CtVal)] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) nf))
              (break)
              (do
                (match (zeroed-content (subst-apply a
                                                    (field (al-elem [Field] flds (load i)) ty)
                                                    subst)
                                       cx)
                  (Err [d] (do (set! errf (Some d)) 0))
                  (Ok [c] (do (al-push! (mut out) (new-cell c)) 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList (ptr CtVal))) Diag] d))
      (None [] (Ok [(ptr (ArrayList (ptr CtVal))) Diag] (box-al [(ptr CtVal)] a (load out)))))))
(defn zeroed-content [(ty Type) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))]
    (match ty
      (TInt [bits signed] (Ok [CtVal Diag] (CInt 0)))
      (TBool [] (Ok [CtVal Diag] (CBool false)))
      (TFloat [bits] (Ok [CtVal Diag] (CFloat 0.0)))
      (TSlice [el]
              (if (is-u8 (load el))
                  (Ok [CtVal Diag] (CStr ""))
                  (Err [CtVal Diag] (derr "comptime: `zeroed` of this type isn't supported yet"))))
      (TStruct [n]
               (let [sd (ct-struct-find cx n)]
                 (if (= (primitive/cast i64 sd) (primitive/cast i64 0))
                     (Err [CtVal Diag] (derr (sconcat3 a "comptime: unknown struct '" n "'")))
                     (match (zeroed-struct-cells (load (field sd fields)) cx)
                       (Err [d] (Err [CtVal Diag] d))
                       (Ok [cells] (Ok [CtVal Diag] (CStruct n cells)))))))
      (TArray [el k]
              (match (zeroed-array-cells (load el) k cx)
                (Err [d] (Err [CtVal Diag] d))
                (Ok [cells] (Ok [CtVal Diag] (CArray (load el) cells)))))
      (TVoid [] (Err [CtVal Diag] (derr "comptime: `zeroed` of this type isn't supported yet")))
      ; A zeroed pointer is NULL. Represented as CInt 0 — the interpreter models a
      ; live pointer as CRef (a cell), which a null pointer by definition has not got.
      ; Needed because every generic container has a `(ptr T)` data field.
      (TPtr [i] (Ok [CtVal Diag] (CInt 0)))
      (TRef [m i] (Err [CtVal Diag] (derr "comptime: `zeroed` of this type isn't supported yet")))
      (TVec [e k] (Err [CtVal Diag] (derr "comptime: `zeroed` of this type isn't supported yet")))
      ; A zeroed function pointer is NULL, same as TPtr. `Allocator` is a struct of
      ; fnptr fields, so every allocator-shaped value needs this to be zeroable.
      (TFn [c p r] (Ok [CtVal Diag] (CInt 0)))
      ; A generic struct application, e.g. (ArrayList i64): find the generic def and
      ; zero its fields under T := the type args.
      (TApp [nm ar]
            (let [sd (ct-struct-find cx nm)]
              (if (= (primitive/cast i64 sd) (primitive/cast i64 0))
                  (Err [CtVal Diag] (derr (sconcat3 a "comptime: unknown generic struct '" nm "'")))
                  (match (zeroed-struct-cells-subst (load (field sd fields))
                                                    (subst-from-targs a
                                                                      (load (field sd type_params))
                                                                      ar)
                                                    cx)
                    (Err [d] (Err [CtVal Diag] d))
                    (Ok [cells] (Ok [CtVal Diag] (CStruct nm cells)))))))
      (TNever [] (Err [CtVal Diag] (derr "comptime: `zeroed` of this type isn't supported yet")))
      (TCode [] (Err [CtVal Diag] (derr "comptime: `zeroed` of this type isn't supported yet")))
      (TCodeBuilder [] (Err [CtVal Diag] (derr "comptime: `zeroed` of this type isn't supported yet")))
      (TExternRef [] (Err [CtVal Diag] (derr "comptime: `zeroed` of this type isn't supported yet"))))))
(defn zeroed-value [(ty Type) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (match (zeroed-content ty cx)
    (Err [d] (Err [CtVal Diag] d))
    (Ok [c] (Ok [CtVal Diag] (if (is-aggregate-v c) (CRef (new-cell c)) c)))))
(defn vals->cells [(vals (ptr (ArrayList CtVal))) (a (dyn Allocator))] (-> (ptr (ArrayList (ptr CtVal))))
  (let [n (al-len [CtVal] (load vals))
        (mut out) (al-new [(ptr CtVal)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (new-cell (to-content-v (al-get [CtVal] (load vals) (load i)))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(ptr CtVal)] a (load out))))
(defn match-arm-find [(arms (ptr (ArrayList Arm))) (variant (slice u8))] (-> (ptr Arm))
  (let [n (al-len [Arm] (load arms))
        (mut i) 0
        (mut r) (primitive/cast (ptr Arm) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [Arm] arms (load i)) variant)) variant)
                  (store! r (al-elem [Arm] arms (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defsum ArgsOut
  (AOK [(vals (ptr (ArrayList CtVal)))])
  (AFlow [(f Flow)]))
(defsum LoopStep
  (LSAgain [])
  (LSDone [(v CtVal)])
  (LSProp [(f Flow)]))
(defstruct GsCell [(n i64)])
(defn gensym-cell [] (-> (ptr GsCell))
  (primitive/alloc-static GsCell))
(defn next-gensym [] (-> i64)
  (let [c (gensym-cell)
        v (.n c)]
    (set! (.n c) (primitive/iadd v 1))
    v))
; Append "in <metaprogram>" to a comptime error when one is executing. The bare
; message names neither the macro nor the form, and its location is the point the
; engine was ENTERED from — a module's import line — so it reads as though the
; user's file is at fault when the bug is inside a macro they cannot see. One
; word fixes that, and it is the single most useful word in the message.
(defn ct-in-meta [(a (dyn Allocator)) (msg (slice u8))] (-> (slice u8))
  (let [who (mtrace-current)]
    (if (= (slice-len [u8] who) (primitive/cast i64 0))
        msg
        (sconcat3 a msg ", raised inside metaprogram " who))))
; ── CLI parameters for lint/checker metaprograms.
; Values stay strings intentionally: the checker owns its schema, parsing, validation,
; and default. Keys are conventionally qualified by rule namespace so independently
; loaded rules cannot accidentally share configuration.
(defstruct LintParam [(key (slice u8)) (value (slice u8)) (spec (slice u8))])
(defstruct LintParamBox [(init i64) (lst (ptr (ArrayList LintParam)))])
(defn lint-param-box [] (-> (ptr LintParamBox))
  (primitive/alloc-static LintParamBox))
(defn lint-params [] (-> (ptr (ArrayList LintParam)))
  (let [b (lint-param-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b lst)
              (box! (malloc-allocator) (ArrayList LintParam) (primitive/zeroed (ArrayList LintParam))))
      (store! (load (field b lst)) (al-new [LintParam] (malloc-allocator)))
      (store! (field b init) 1)
      0)
    (load (field b lst))))
(defn lint-param-add-spec [(spec (slice u8))] (-> bool)
  (let [n (slice-len [u8] spec)
        (mut split) -1
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get [u8] spec (load i))) 61)
                  (store! split (load i))
                  (break)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (if (or (<= (load split) 0) (>= (load split) (primitive/isub n 1)))
        false
        (let [p (primitive/alloc-stack LintParam)]
          (set! (.key p) (subslice spec 0 (load split)))
          (set! (.value p) (subslice spec (primitive/iadd (load split) 1) n))
          (set! (.spec p) spec)
          (al-push! (lint-params) (load p))
          true))))
(defn lint-param-get [(key (slice u8)) (fallback (slice u8))] (-> (slice u8))
  (let [params (lint-params)
        (mut i) (primitive/isub (al-len [LintParam] (load params)) 1)
        (mut out) fallback]
    (loop (if (< (load i) 0)
              (break)
              (let [p (al-get [LintParam] (load params) (load i))]
                (if (= (.key p) key)
                    (do (set! out (.value p)) (break))
                    (set! i (primitive/isub (load i) 1))))))
    (load out)))
(defn cop-lint-param [(args (ptr (ArrayList CtVal)))] (-> (Result CtVal Diag))
  (match (cv-get args 0)
    (None [] (Err [CtVal Diag] (derr "lint-param: expects (primitive/lint-param KEY DEFAULT)")))
    (Some [key]
          (match (cv-get args 1)
            (None [] (Err [CtVal Diag] (derr "lint-param: expects (primitive/lint-param KEY DEFAULT)")))
            (Some [fallback]
                  (if (and (is-cstr key) (is-cstr fallback))
                      (Ok [CtVal Diag] (CStr (lint-param-get (cstr-of key) (cstr-of fallback))))
                      (Err [CtVal Diag] (derr "lint-param: KEY and DEFAULT must be strings"))))))))
; ── compile-time diagnostic collector for `(primitive/warn …)`/`(primitive/report …)` from checkers.
; Both COLLECT (non-aborting) so a checker surfaces EVERY warning and error in one
; run; the build fails afterward iff any error-severity diagnostic was reported.
(defstruct WarnBox [(init i64) (lst (ptr (ArrayList Diag))) (errs i64)])
(defn warn-box [] (-> (ptr WarnBox))
  (primitive/alloc-static WarnBox))
(defn warn-list [] (-> (ptr (ArrayList Diag)))
  (let [b (warn-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b lst) (box! (malloc-allocator) (ArrayList Diag) (primitive/zeroed (ArrayList Diag))))
      (store! (load (field b lst)) (al-new [Diag] (malloc-allocator)))
      (store! (field b init) 1)
      0)
    (load (field b lst))))
(defn warn-push [(d Diag)] (-> i64)
  (al-push! (warn-list) d)
  0)

; ── ownership at the metaprogram boundary (docs/design/META_MEMORY.md) ─────────
; Under COIL_META_ARENA a metaprogram's allocations live in a per-expansion
; arena that is reset when the expansion returns. Anything recorded into a
; GLOBAL list from inside one — warnings, reports, suggested fixes — must OWN
; its bytes, not borrow the arena's. Diagnostics are rare, so the unconditional
; copy is noise, and it is the difference between a lint finding and a
; use-after-reset.
(defn sexp-own-str-into [(a (dyn Allocator)) (s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        dst (slice-data (match (alloc [u8] a (if (> n (primitive/cast i64 0)) n 1)) (Some [s] s) (None [] (do (oom-at c"compiler comptime" -1) (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0)))))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (set! (primitive/index dst (load i)) (slice-get s (load i)))
                  (set! i (primitive/iadd (load i) 1)))))
    (slice-new dst n)))
(defn ct-own-str [(s (slice u8))] (-> (slice u8))
  (sexp-own-str-into (malloc-allocator) s))

; Deep copy INCLUDING string payloads — meta-copy-sexp copies structure but
; deliberately shares leaves, which is exactly wrong across an arena reset.
; KView nodes (tag 8) are FLATTENED to KList here: promotion is the boundary
; past which no view may survive (docs/design/META_MEMORY.md phase 5).
(defn sexp-own-into [(a (dyn Allocator)) (x (ptr Sexp))] (-> Sexp)
  (let [tg (sx-tag (load x))]
    (if (or (= tg (primitive/cast i64 6))
            (or (= tg (primitive/cast i64 7)) (= tg (primitive/cast i64 8))))
        (let [n (code-node-len (load x))
              (mut out) (al-new [Sexp] a)
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (let [e (primitive/alloc-stack Sexp)]
                        (set! e (code-node-at (load x) (load i)))
                        (al-push! (mut out) (sexp-own-into a e)))
                      (set! i (primitive/iadd (load i) 1)))))
          (mk-sexp-src (if (= tg (primitive/cast i64 7))
                           (KVec (box-al [Sexp] a (load out)))
                           (KList (box-al [Sexp] a (load out))))
                       x))
        (if (or (= tg (primitive/cast i64 2))
                (or (= tg (primitive/cast i64 3))
                    (or (= tg (primitive/cast i64 4)) (= tg (primitive/cast i64 5)))))
            (let [s2 (sexp-own-str-into a (sx-sval (load x)))]
              (mk-sexp-src (cond (= tg (primitive/cast i64 2)) (KSym s2)
                                 (= tg (primitive/cast i64 3)) (KKw s2)
                                 (= tg (primitive/cast i64 4)) (KStr s2)
                                 :else (KCStr s2))
                           x))
            (load x)))))
(defn ct-own-sexp [(x (ptr Sexp))] (-> Sexp)
  (sexp-own-into (malloc-allocator) x))
(defn diag-errs [] (-> i64)
  (let [b (warn-box)]
    (unless (= (load (field b init)) (primitive/cast i64 0)) (load (field b errs)))))
(defn diag-err-bump [] (-> i64)
  (let [_ (warn-list)
        b (warn-box)]
    (set! (.errs b) (primitive/iadd (.errs b) 1))
    0))
; ── source table for `(primitive/code-file NODE)` — lets a checker tell WHICH file a node is
; from (a real path = user code; "<bundled …>"/"<prelude>" = stdlib) so a linter can
; scope itself. Set once before checkers run.
; `own` holds the table BY VALUE and `lst` points at it. The caller's `ArrayList`
; header lives in an `LS` on the pipeline's stack — and the pipeline runs on its own
; pthread, so that stack is gone the moment it returns. Keeping the caller's pointer
; therefore left a dangling read for anything that consults the table AFTER a run,
; which is exactly what `coil lint --fix` does when it goes to write the files back.
; The lint target compiler uses a per-round arena, so this boundary must own the
; elements and their payloads as well as the header. Suggestions are rendered after
; that target compiler returns; borrowing its source table kept every multi-gigabyte
; target arena alive across the whole fixpoint loop.
(defstruct SrcBox [(lst (ptr (ArrayList Source))) (own (ArrayList Source))])
(defn src-box [] (-> (ptr SrcBox))
  (primitive/alloc-static SrcBox))
(defn set-cli-sources [(ss (ptr (ArrayList Source)))] (-> i64)
  (let [b (src-box)
        a (malloc-allocator)
        n (al-len [Source] (load ss))
        (mut own) (al-new [Source] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [old (al-elem [Source] ss (load i))
                    fresh (primitive/alloc-stack Source)
                    starts (load (field old line_starts))
                    ns (al-len [i64] starts)
                    (mut copied-starts) (al-new [i64] a)
                    (mut j) 0]
                (loop (if (>= (load j) ns)
                          (break)
                          (do
                            (al-push! (mut copied-starts) (al-get [i64] starts (load j)))
                            (set! j (primitive/iadd (load j) 1)))))
                (set! (.name fresh) (ct-own-str (.name old)))
                (set! (.text fresh) (ct-own-str (.text old)))
                (set! (.line_starts fresh) (box-al [i64] a (load copied-starts)))
                (al-push! (mut own) (load fresh))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.own b) (load own))
    (set! (.lst b) (field b own))
    0))
(defn code-file-of [(node Sexp)] (-> (slice u8))
  (let [b (src-box)
        lst (load (field b lst))]
    (if (= (primitive/cast i64 lst) (primitive/cast i64 0))
        ""
        (let [sid (sx-source node)]
          (if (or (< sid (primitive/cast i64 0)) (>= sid (al-len [Source] (load lst))))
              ""
              (let [sp (primitive/alloc-stack Source)]
                (set! sp (al-get [Source] (load lst) sid))
                (.name sp)))))))
; `(primitive/code-from-user? NODE)` — is this node from a real file the user wrote, rather than
; the bundled stdlib/prelude? Those are registered under a `<…>` pseudo-name, so the
; test is "has a name that doesn't start with `<`". One definition: op 34 answers with
; it, and the autofix filter refuses to edit anything it says false to.
(defn code-from-user-node? [(node Sexp)] (-> bool)
  (let [nm (code-file-of node)]
    (and (> (slice-len [u8] nm) (primitive/cast i64 0))
         (!= (primitive/cast i64 (slice-get [u8] nm 0)) (primitive/cast i64 60)))))
; `(primitive/code-line NODE)` — the 1-based source LINE of a node's span, so a macro (e.g.
; src/stdlib/assert.coil) can bake `file:line` into the code it emits, matching the span
; machinery diag.coil's `locate` uses. Same source table as `code-file-of` (set once
; before expansion/checkers run); 0 when the node has no known source.
(defn ct-line-at [(src (slice u8)) (off0 i64)] (-> i64)
  (let [n (slice-len [u8] src)
        off (if (> off0 n) n off0)
        (mut line) 1
        (mut k) 0]
    (loop (if (>= (load k) off)
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get [u8] src (load k))) (primitive/cast i64 10))
                  (store! line (primitive/iadd (load line) 1)))
                (set! k (primitive/iadd (load k) 1)))))
    (load line)))
(defn code-line-of [(node Sexp)] (-> i64)
  (let [b (src-box)
        lst (load (field b lst))]
    (unless (= (primitive/cast i64 lst) (primitive/cast i64 0))
      (let [sid (sx-source node)]
        (unless (or (< sid (primitive/cast i64 0)) (>= sid (al-len [Source] (load lst))))
          (let [sp (primitive/alloc-stack Source)]
            (store! sp (al-get [Source] (load lst) sid))
            (ct-line-at (load (field sp text)) (sx-lo node))))))))
; `(primitive/code-col NODE)` — the 1-based source COLUMN of a node's span (chars since the last
; newline before `lo`). Mirrors code-line; together they give `file:line:col` for a node.
(defn ct-col-at [(src (slice u8)) (off0 i64)] (-> i64)
  (let [n (slice-len [u8] src)
        off (if (> off0 n) n off0)
        (mut col) 1
        (mut k) 0]
    (loop (if (>= (load k) off)
              (break)
              (do
                (if (= (primitive/cast i64 (slice-get [u8] src (load k))) (primitive/cast i64 10))
                    (set! col 1)
                    (set! col (primitive/iadd (load col) 1)))
                (set! k (primitive/iadd (load k) 1)))))
    (load col)))
(defn code-col-of [(node Sexp)] (-> i64)
  (let [b (src-box)
        lst (load (field b lst))]
    (unless (= (primitive/cast i64 lst) (primitive/cast i64 0))
      (let [sid (sx-source node)]
        (unless (or (< sid (primitive/cast i64 0)) (>= sid (al-len [Source] (load lst))))
          (let [sp (primitive/alloc-stack Source)]
            (store! sp (al-get [Source] (load lst) sid))
            (ct-col-at (load (field sp text)) (sx-lo node))))))))
; `(primitive/code-src NODE)` — the raw SOURCE TEXT of a node's span (lo..hi), so a macro can
; show the user exactly what they wrote.
; Empty when the node has no known source or a dummy span.
(defn code-src-of [(node Sexp)] (-> (slice u8))
  (let [b (src-box)
        lst (load (field b lst))]
    (if (= (primitive/cast i64 lst) (primitive/cast i64 0))
        ""
        (let [sid (sx-source node)
              lo (sx-lo node)
              hi (sx-hi node)]
          (if (or (< sid (primitive/cast i64 0)) (>= sid (al-len [Source] (load lst))))
              ""
              (let [sp (primitive/alloc-stack Source)]
                (set! sp (al-get [Source] (load lst) sid))
                (let [txt (.text sp)
                      n (slice-len [u8] txt)]
                  (if (or (< lo (primitive/cast i64 0)) (or (> hi n) (> lo hi)))
                      ""
                      (subslice [u8] txt lo hi)))))))))
; ---- doc comments (`;;`) ------------------------------------------------------
; A DOC COMMENT is a run of lines whose first non-blank characters are `;;`,
; immediately above a form. A single `;` stays an ordinary throwaway comment, so
; documenting something is opt-in and an incidental note never becomes API docs.
; The reader discards all comments, so the doc is recovered from the SOURCE TEXT by
; scanning backwards from the node's `lo` — no new AST field, one definition of a
; doc (the source itself), and nothing to keep in sync.

; Offset of the first byte of the line containing `off` (0 if on line 1).
(defn ct-line-start [(src (slice u8)) (off i64)] (-> i64)
  (let [(mut k) off]
    (loop (if (or (<= (load k) (primitive/cast i64 0))
                  (= (primitive/cast i64 (slice-get [u8] src (primitive/isub (load k) 1))) (primitive/cast i64 10)))
              (break)
              (set! k (primitive/isub (load k) 1))))
    (load k)))

; If the line starting at `ls` is a `;;` doc line, return the offset just past its
; `;;` (and one optional following space); otherwise -1. A line of only whitespace,
; or one holding code, is not a doc line.
(defn ct-doc-line-body [(src (slice u8)) (ls i64)] (-> i64)
  (let [n (slice-len [u8] src)
        (mut k) ls]
    (loop (if (>= (load k) n)
              (break)
              (let [c (primitive/cast i64 (slice-get [u8] src (load k)))]
                (if (or (= c (primitive/cast i64 32)) (= c (primitive/cast i64 9)))
                    (set! k (primitive/iadd (load k) 1))
                    (break)))))
    (if (or (>= (primitive/iadd (load k) 1) n)
            (not (and (= (primitive/cast i64 (slice-get [u8] src (load k))) (primitive/cast i64 59))
                      (= (primitive/cast i64 (slice-get [u8] src (primitive/iadd (load k) 1))) (primitive/cast i64 59)))))
        -1
        (let [(mut b) (primitive/iadd (load k) 2)]
          ; a third `;` is still a doc line (`;;;` banners); skip the run
          (loop (if (>= (load b) n)
                    (break)
                    (if (= (primitive/cast i64 (slice-get [u8] src (load b))) (primitive/cast i64 59))
                        (set! b (primitive/iadd (load b) 1))
                        (break))))
          (if (and (< (load b) n)
                   (= (primitive/cast i64 (slice-get [u8] src (load b))) (primitive/cast i64 32)))
              (primitive/iadd (load b) 1)
              (load b))))))

; End offset (exclusive) of the line starting at `ls`, not counting its newline.
(defn ct-line-end [(src (slice u8)) (ls i64)] (-> i64)
  (let [n (slice-len [u8] src)
        (mut k) ls]
    (loop (if (or (>= (load k) n)
                  (= (primitive/cast i64 (slice-get [u8] src (load k))) (primitive/cast i64 10)))
              (break)
              (set! k (primitive/iadd (load k) 1))))
    (load k)))

; The doc comment attached to `off`: the contiguous `;;` block ending on the line
; directly above it, joined with newlines. "" when there is none.
(defn ct-doc-at [(a (dyn Allocator)) (src (slice u8)) (off i64)] (-> (slice u8))
  (let [n (slice-len [u8] src)]
    (if (or (< off (primitive/cast i64 0)) (> off n))
        ""
        (let [(mut ls) (ct-line-start src off)
              (mut lines) (al-new [(slice u8)] a)]
          ; walk upwards while the previous line is a doc line
          (loop (if (<= (load ls) (primitive/cast i64 0))
                    (break)
                    (let [pls (ct-line-start src (primitive/isub (load ls) 1))
                          body (ct-doc-line-body src pls)]
                      (if (< body (primitive/cast i64 0))
                          (break)
                          (do
                            (al-push! (mut lines) (subslice [u8] src body (ct-line-end src pls)))
                            (set! ls pls))))))
          (let [cnt (al-len [(slice u8)] lines)]
            (if (= cnt (primitive/cast i64 0))
                ""
                ; collected bottom-up; emit top-down
                (let [(mut out) (sb-new a)
                      (mut i) cnt]
                  (loop (if (<= (load i) (primitive/cast i64 0))
                            (break)
                            (do
                              (set! i (primitive/isub (load i) 1))
                              (sb-push-str! (mut out) (al-get [(slice u8)] lines (load i)))
                              (when (> (load i) (primitive/cast i64 0))
                                (sb-push-byte! (mut out) (primitive/cast u8 10))))))
                  (sb-str (load out)))))))))

; `(primitive/code-doc NODE)` — the `;;` doc comment written above NODE, or "" if it has none
; (including any macro-generated node, which has no source of its own).
(defn code-doc-of [(node Sexp)] (-> (slice u8))
  (let [b (src-box)
        lst (load (field b lst))]
    (if (= (primitive/cast i64 lst) (primitive/cast i64 0))
        ""
        (let [sid (sx-source node)]
          (if (or (< sid (primitive/cast i64 0)) (>= sid (al-len [Source] (load lst))))
              ""
              (let [sp (primitive/alloc-stack Source)]
                (set! sp (al-get [Source] (load lst) sid))
                (ct-doc-at (malloc-allocator) (.text sp) (sx-lo node))))))))

; ── autofix: `(primitive/suggest NODE MSG REPLACEMENT)` ─────────────────────────────────
; A checker only ever RECORDS a proposed rewrite; nothing here opens a file, and
; every build that is not `coil lint --fix` drops this table on the floor. That
; keeps `coil build` pure by construction rather than by convention. The suggestion
; also emits an ordinary `(primitive/warn …)`, so the `help: try:` line shows up whether or
; not anyone ever runs `--fix`. See docs/archive/AUTOFIX.md.
;
; `diag` is the index of that warning in `warn-list`, which is how the printer
; pairs a suggestion with the diagnostic it belongs under.
;
; `del` distinguishes the two shapes a proposed fix can have. 0 = REPLACE: splice
; `repl` over [lo,hi). 1 = DELETE: the node goes away entirely and `repl` is unused.
; Deletion is not expressible as a replacement, because there is no `Code` value that
; renders as nothing — and because a delete legitimately takes source the node's own
; span does not cover (the comment block written above it), which a replacement never
; may. So the two stay distinct all the way to `lint-edits`.
; `locals` is the hygiene half: the spellings of identifiers this replacement
; transported out of the author's program that the type-checker resolved to a
; LOCAL binding. It is captured at RECORD time because owning the replacement
; renumbers node ids, and the binding map is keyed by them. See the renderer's
; identifier-hygiene note for what it is used for.
(defstruct Suggestion
  [(source i64) (lo i64) (hi i64) (col i64) (repl Sexp)
   (rendered (slice u8)) (help (slice u8)) (msg (slice u8)) (diag i64) (del i64)
   (locals (ptr (ArrayList (slice u8))))])
(defstruct SugBox [(init i64) (lst (ptr (ArrayList Suggestion)))])
(defn sug-box [] (-> (ptr SugBox))
  (primitive/alloc-static SugBox))
(defn sug-list [] (-> (ptr (ArrayList Suggestion)))
  (let [b (sug-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b lst) (box! (malloc-allocator) (ArrayList Suggestion) (primitive/zeroed (ArrayList Suggestion))))
      (store! (load (field b lst)) (al-new [Suggestion] (malloc-allocator)))
      (store! (field b init) 1)
      0)
    (load (field b lst))))
(defn sug-push [(s Suggestion)] (-> i64)
  (al-push! (sug-list) s)
  0)
(defn sug-count [] (-> i64)
  (al-len [Suggestion] (load (sug-list))))
(defn sug-at [(i i64)] (-> Suggestion)
  (al-get [Suggestion] (load (sug-list)) i))
; `coil lint --fix` re-analyses the program after every round; both collectors are
; per-round state, so a round starts from empty rather than re-reporting the last one.
(defn sug-reset [] (-> i64)
  (let [b (sug-box)]
    (unless (= (load (field b init)) (primitive/cast i64 0))
      (store! (load (field b lst)) (al-new [Suggestion] (malloc-allocator)))
      0)))
; `coil lint --fix` re-analyses the program once per round; printing every round's
; diagnostics would repeat the same list N times and bury the one that matters. The
; rounds run quiet and the final pass reports.
(defstruct DiagQuietCell [(on i64)])
(defn diag-quiet-cell [] (-> (ptr DiagQuietCell))
  (primitive/alloc-static DiagQuietCell))
(defn set-diag-quiet [(on bool)] (-> i64)
  (set! (.on (diag-quiet-cell)) (if on (do 1) 0))
  0)
(defn diag-quiet? [] (-> bool)
  (!= (.on (diag-quiet-cell)) (primitive/cast i64 0)))
(defn diag-reset [] (-> i64)
  (let [b (warn-box)]
    (unless (= (load (field b init)) (primitive/cast i64 0))
      (store! (load (field b lst)) (al-new [Diag] (malloc-allocator)))
      (store! (field b errs) 0)
      0)))

; The text of the source file a node came from, or "" — the raw material both the
; column lookup and the verbatim printer below work over.
(defn sug-file-text [(source i64)] (-> (slice u8))
  (let [b (src-box)
        lst (load (field b lst))]
    (if (or (= (primitive/cast i64 lst) (primitive/cast i64 0))
            (or (< source (primitive/cast i64 0)) (>= source (al-len [Source] (load lst)))))
        ""
        (let [sp (primitive/alloc-stack Source)]
          (set! sp (al-get [Source] (load lst) source))
          (.text sp)))))

; The path of the source file a node came from, or "" — what `coil lint --fix`
; writes back to.
(defn sug-file-name [(source i64)] (-> (slice u8))
  (let [b (src-box)
        lst (load (field b lst))]
    (if (or (= (primitive/cast i64 lst) (primitive/cast i64 0))
            (or (< source (primitive/cast i64 0)) (>= source (al-len [Source] (load lst)))))
        ""
        (let [sp (primitive/alloc-stack Source)]
          (set! sp (al-get [Source] (load lst) source))
          (.name sp)))))

; 0-based column of byte `off` in `txt` — how far it sits past the last newline.
(defn sug-col-at [(txt (slice u8)) (off i64)] (-> i64)
  (let [n (slice-len [u8] txt)
        (mut i) (if (> off n) n off)
        (mut c) 0]
    (loop (if (or (<= (load i) (primitive/cast i64 0))
                  (= (primitive/cast i64 (slice-get [u8] txt (primitive/isub (load i) 1))) (primitive/cast i64 10)))
              (break)
              (do
                (set! c (primitive/iadd (load c) 1))
                (set! i (primitive/isub (load i) 1)))))
    (load c)))

; ---- identifier hygiene in a rendered replacement ---------------------------
; A replacement is written back as SOURCE TEXT, and source text carries no
; lexical scope. Inside the `Code` value an identifier the rule introduced (a
; template literal, or a `fresh-identifier`) and one transported out of the
; author's own program are distinct syntax objects even when they print the
; same; flattening both to one spelling is exactly the capture the hygiene model
; exists to stop. A rule that wraps the author's `tmp` in its own `(let [tmp …])`
; would otherwise rebind it silently, and the rewritten file still compiles.
;
; So the renderer disambiguates first. Whether a collision can actually capture
; anything is answered by the type-checker's binding map, not by guessing at
; binder shapes: only a transported identifier the checker resolved to a LOCAL is
; capturable, so only a spelling shared with one of those is renamed. Heads,
; globals and qualified names collide harmlessly and keep their spelling, which
; is what leaves `cond`/`if`-shaped rewrites byte-identical.
;
; The author's syntax always keeps its text; each rule-introduced identity, keyed
; by its scope, becomes `name__N` numbered in first-appearance order — so a
; rendering is deterministic, and two rule identities never merge into one name.
; Identities the rule deliberately stripped of context (`code-symbol` data,
; `datum->syntax` use-site capture, `syntax->datum`) are asking for the bare
; spelling and are left alone.
(defstruct SugRen [(spelling (slice u8)) (hyg i64) (name (slice u8))])
(defstruct SugRenBox [(init i64) (lst (ptr (ArrayList SugRen)))])
(defn sug-ren-box [] (-> (ptr SugRenBox))
  (primitive/alloc-static SugRenBox))
(defn sug-ren-list [] (-> (ptr (ArrayList SugRen)))
  (let [b (sug-ren-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b lst)
              (box! (malloc-allocator) (ArrayList SugRen) (primitive/zeroed (ArrayList SugRen))))
      (store! (load (field b lst)) (al-new [SugRen] (malloc-allocator)))
      (store! (field b init) 1)
      0)
    (load (field b lst))))
(defn sug-ren-clear [] (-> i64)
  (let [lst (sug-ren-list)]
    (store! lst (al-new [SugRen] (malloc-allocator)))
    0))

; origin 1 = template/definition-site syntax, 2 = a generated fresh identifier:
; the two a rule mints itself. 0 is the author's own syntax and 3/4/5 are the
; explicit context operations, which all mean "this exact spelling".
(defn sug-introduced? [(x Sexp)] (-> bool)
  (and (= (sx-tag x) (primitive/cast i64 2))
       (or (= (sx-horigin x) (primitive/cast i64 1))
           (= (sx-horigin x) (primitive/cast i64 2)))))

; A transported reference the type-checker bound to a local — the only thing a
; flattened rule identifier can capture.
(defn sug-capturable? [(x Sexp)] (-> bool)
  (and (= (sx-tag x) (primitive/cast i64 2))
       (and (= (sx-horigin x) (primitive/cast i64 0))
            (!= (bind-map-lookup (sx-nid x)) (primitive/cast i64 0)))))

(defn sug-str-member? [(lst (ptr (ArrayList (slice u8)))) (s (slice u8))] (-> bool)
  (let [n (al-len [(slice u8)] (load lst))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (if (= (al-get [(slice u8)] (load lst) (load i)) s)
                  (do (store! r true) (break))
                  (store! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn sug-str-add! [(lst (ptr (ArrayList (slice u8)))) (s (slice u8))] (-> i64)
  (unless (sug-str-member? lst s) (al-push! lst s) 0))

; The capturable spellings in a replacement, collected while its nodes still
; carry the ids the binding map is keyed by (i.e. before `ct-own-sexp`).
(defn sug-scan-locals! [(locals (ptr (ArrayList (slice u8)))) (x Sexp)] (-> i64)
  (let [tg (sx-tag x)]
    (when (and (= tg (primitive/cast i64 2)) (sug-capturable? x))
      (sug-str-add! locals (sx-sval x))
      0)
    (when (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
      (let [items (sx-items x)
            n (sx-len items)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (sug-scan-locals! locals (sx-at items (load i)))
                    (store! i (primitive/iadd (load i) 1))))))
      0)
    0))

; Every symbol spelling the replacement already uses, so a minted name cannot
; land on one of them.
(defn sug-scan-seen! [(seen (ptr (ArrayList (slice u8)))) (x Sexp)] (-> i64)
  (let [tg (sx-tag x)]
    (when (= tg (primitive/cast i64 2)) (sug-str-add! seen (sx-sval x)) 0)
    (when (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
      (let [items (sx-items x)
            n (sx-len items)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (sug-scan-seen! seen (sx-at items (load i)))
                    (store! i (primitive/iadd (load i) 1))))))
      0)
    0))

; The record-time half: own the capturable spellings alongside the replacement.
(defn sug-locals-of [(repl (ptr Sexp))] (-> (ptr (ArrayList (slice u8))))
  (let [ma (malloc-allocator)
        locals (box-al [(slice u8)] ma (al-new [(slice u8)] ma))]
    (sug-scan-locals! locals (load repl))
    locals))

(defn sug-ren-find [(spelling (slice u8)) (hyg i64)] (-> (slice u8))
  (let [lst (sug-ren-list)
        n (al-len [SugRen] (load lst))
        (mut i) 0
        (mut r) ""]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [e (al-elem [SugRen] lst (load i))]
                  (when (and (= (load (field e spelling)) spelling)
                             (= (load (field e hyg)) hyg))
                    (store! r (load (field e name)))
                    (break)))
                (store! i (primitive/iadd (load i) 1)))))
    (load r)))

; `spelling__1`, `__2`, … skipping anything the replacement already spells, so a
; disambiguated name cannot collide with the text around it either.
(defn sug-ren-mint [(a (dyn Allocator))
                    (seen (ptr (ArrayList (slice u8))))
                    (spelling (slice u8))] (-> (slice u8))
  (let [(mut k) 1
        (mut out) ""]
    (loop (let [cand (sconcat3 a spelling "__" (dec->str a (load k)))]
            (if (sug-str-member? seen cand)
                (store! k (primitive/iadd (load k) 1))
                (do (store! out cand) (break)))))
    (sug-str-add! seen (load out))
    (load out)))

(defn sug-ren-assign! [(a (dyn Allocator))
                       (locals (ptr (ArrayList (slice u8))))
                       (seen (ptr (ArrayList (slice u8))))
                       (x Sexp)] (-> i64)
  (let [tg (sx-tag x)]
    (when (and (sug-introduced? x)
               (and (sug-str-member? locals (sx-sval x))
                    (= (sug-ren-find (sx-sval x) (sx-hyg x)) "")))
      (let [e (primitive/alloc-stack SugRen)]
        (store! (field e spelling) (sx-sval x))
        (store! (field e hyg) (sx-hyg x))
        (store! (field e name) (sug-ren-mint a seen (sx-sval x)))
        (al-push! (sug-ren-list) (load e))
        0))
    (when (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
      (let [items (sx-items x)
            n (sx-len items)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (sug-ren-assign! a locals seen (sx-at items (load i)))
                    (store! i (primitive/iadd (load i) 1))))))
      0)
    0))

(defn sug-ren-build! [(a (dyn Allocator))
                      (repl Sexp)
                      (locals (ptr (ArrayList (slice u8))))] (-> i64)
  (sug-ren-clear)
  (unless (or (= (primitive/cast i64 locals) (primitive/cast i64 0))
              (= (al-len [(slice u8)] (load locals)) (primitive/cast i64 0)))
    (let [seen (box-al [(slice u8)] a (al-new [(slice u8)] a))]
      (sug-scan-seen! seen repl)
      (sug-ren-assign! a locals seen repl))
    0))

; The spelling `x` must render as, or "" when its own spelling stands.
(defn sug-ren-of [(x Sexp)] (-> (slice u8))
  (if (not (sug-introduced? x))
      ""
      (sug-ren-find (sx-sval x) (sx-hyg x))))

; ---- rendering a replacement back to source text ----------------------------
; THE rule that makes a fix surgical: a node that CAME FROM THE AUTHOR'S SOURCE is
; emitted as its ORIGINAL bytes, and only a freshly-built/rule-owned node is pretty-
; printed. So a fix that reuses the author's subexpressions preserves them byte-for-
; byte — comments, string escapes, line breaks and all — and only what actually
; changed is new text. `ctxt == 0` alone is insufficient: checker templates are
; authored syntax too, but their spans belong to the rule, not the file being fixed.
; Quasiquote marks unquoted/spliced input with hflags bit 0, which is the durable
; provenance that distinguishes transported author syntax from a template node even
; when the metaprogram engine's source IDs are local and collide numerically.
;
; This is a different job from `sx-emit` (expander.coil), which reprints the whole
; expanded program for `coil expand`: that one is a debugging view with no source to
; be faithful to, this one edits a file the author has to keep reading.
(defn sug-verbatim [(node Sexp)] (-> (slice u8))
  (if (or (!= (sx-ctxt node) (primitive/cast i64 0))
          (or (= (primitive/iand (sx-hflags node) 1) (primitive/cast i64 0))
              (or (not (code-from-user-node? node)) (rule-src? (sx-source node)))))
      ""
      (code-src-of node)))

(defn sug-has-nl [(s (slice u8))] (-> bool)
  (let [n (slice-len [u8] s)
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (if (= (primitive/cast i64 (slice-get [u8] s (load i))) (primitive/cast i64 10))
                  (do (set! r true) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; `coil fmt`'s line budget, and therefore the largest useful indentation for a
; replacement. Source columns are not layout widths: generated and minified input
; can put a form hundreds of thousands of bytes into one physical line. Letting that
; column become a continuation indent makes a tiny lint fix manufacture enormous
; padding strings. The first line is still spliced at its exact source offset; only
; lines introduced by the renderer use this bounded layout column.
(defn sug-width-budget [] (-> i64)
  120)
(defn sug-layout-col [(col i64)] (-> i64)
  (if (> col (sug-width-budget)) (sug-width-budget) col))

; Width of `x` rendered on one line. Verbatim text that already spans lines can
; never be flattened, so it reports a width nothing fits in — the same trick
; src/compiler/formatter/doc.coil's `doc-inf` uses to force every enclosing form to break.
(defn sug-width [(a (dyn Allocator)) (x Sexp)] (-> i64)
  (let [rn (sug-ren-of x)
        v (if (> (slice-len [u8] rn) (primitive/cast i64 0)) "" (sug-verbatim x))]
    (if (> (slice-len [u8] v) (primitive/cast i64 0))
        (if (sug-has-nl v) 1000000000 (slice-len [u8] v))
        (let [tg (sx-tag x)]
          ; NOTE: written with cond's flat trailing-else, NOT `:else` — the bootstrap
          ; seed predates `:else`, and compiler source has to build under it.
          (cond (= tg (primitive/cast i64 0)) (slice-len [u8] (i64->str a (sx-ival x)))
                (= tg (primitive/cast i64 2))
                  (if (> (slice-len [u8] rn) (primitive/cast i64 0))
                      (slice-len [u8] rn)
                      (slice-len [u8] (sx-sval x)))
                (= tg (primitive/cast i64 3)) (primitive/iadd 1 (slice-len [u8] (sx-sval x)))
                (= tg (primitive/cast i64 4)) (primitive/iadd 2 (slice-len [u8] (sx-sval x)))
                (= tg (primitive/cast i64 5)) (primitive/iadd 3 (slice-len [u8] (sx-sval x)))
                (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
                  (let [items (sx-items x)
                        n (sx-len items)
                        (mut w) 2
                        (mut i) 0]
                    (loop (if (>= (load i) n)
                              (break)
                              (do
                                (store! w
                                        (primitive/iadd (primitive/iadd (load w)
                                                                        (when (> (load i) (primitive/cast i64 0))
                                                                          1))
                                                        (sug-width a (sx-at items (load i)))))
                                (store! i (primitive/iadd (load i) 1)))))
                    (load w))
                3)))))

(defn sug-spaces! [(buf (mut (ArrayList u8))) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut buf) (primitive/cast u8 32))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; Copy verbatim text that was written at column `from` into a form now sitting at
; column `to`. Lisp alignment is column-based, so every line after the first is
; shifted by the difference: a form that moves left (an `if` chain collapsing into
; a `cond`) takes its whole body with it instead of stranding it at the old indent.
; A leftward shift only ever removes SPACES, so it can't eat code.
(defn sug-put-reindent! [(buf (mut (ArrayList u8))) (s (slice u8)) (from i64) (to i64)] (-> i64)
  (let [n (slice-len [u8] s)
        delta (primitive/isub (sug-layout-col to) from)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get [u8] s (load i)))]
                (al-push! (mut buf) (primitive/cast u8 c))
                (set! i (primitive/iadd (load i) 1))
                (when (= c (primitive/cast i64 10))
                  (if (> delta (primitive/cast i64 0))
                      (sug-spaces! (mut buf) delta)
                      (let [drop (primitive/isub 0 delta)
                            (mut k) 0]
                        (loop (if (>= (load k) drop)
                                  (break)
                                  (if (and (< (load i) n)
                                           (= (primitive/cast i64 (slice-get [u8] s (load i))) (primitive/cast i64 32)))
                                      (do
                                        (store! i (primitive/iadd (load i) 1))
                                        (store! k (primitive/iadd (load k) 1)))
                                      (break))))
                        0))))))
    0))

(defn sug-atom! [(a (dyn Allocator)) (buf (mut (ArrayList u8))) (x Sexp)] (-> i64)
  (let [tg (sx-tag x)]
    (cond (= tg (primitive/cast i64 0)) (append-bytes! (mut buf) (i64->str a (sx-ival x)))
          (= tg (primitive/cast i64 2))
            (let [rn (sug-ren-of x)]
              (append-bytes! (mut buf)
                             (if (> (slice-len [u8] rn) (primitive/cast i64 0)) rn (sx-sval x))))
          (= tg (primitive/cast i64 3))
            (do (al-push! (mut buf) (primitive/cast u8 58)) (append-bytes! (mut buf) (sx-sval x)))
          (= tg (primitive/cast i64 4))
            (do
              (al-push! (mut buf) (primitive/cast u8 34))
              (append-bytes! (mut buf) (sx-sval x))
              (al-push! (mut buf) (primitive/cast u8 34)))
          (= tg (primitive/cast i64 5))
            (do
              (al-push! (mut buf) (primitive/cast u8 99))
              (al-push! (mut buf) (primitive/cast u8 34))
              (append-bytes! (mut buf) (sx-sval x))
              (al-push! (mut buf) (primitive/cast u8 34)))
          (append-bytes! (mut buf) "<?>"))
    0))

; The head symbol of a list, or "" — the one thing layout dispatches on.
; The bytes the head will actually RENDER as. Emission prefers a node's verbatim
; source spelling, and macro hygiene may have rewritten the sval to a qualified
; name (`coil.core.cond`) while the span still points at the template's own
; `cond` — so layout and clause pairing must measure the verbatim bytes, or the
; continuation indent drifts by exactly the qualifier's length and the result is
; no longer fmt-clean.
(defn sug-head-display [(x Sexp)] (-> (slice u8))
  (let [items (sx-items x)]
    (if (= (sx-len items) (primitive/cast i64 0))
        ""
        (let [h (sx-at items 0)
              rn (sug-ren-of h)
              v (if (> (slice-len [u8] rn) (primitive/cast i64 0)) "" (sug-verbatim h))]
          (if (> (slice-len [u8] rn) (primitive/cast i64 0))
              rn
              (if (> (slice-len [u8] v) (primitive/cast i64 0))
                  v
                  (if (= (sx-tag h) (primitive/cast i64 2)) (sx-sval h) "")))))))

; `cond`/`case` lay their tail out as test/body PAIRS, one clause per line, aligned
; past the head — the same shape `coil fmt` gives them (src/compiler/formatter/rules.coil layout-clauses,
; nest = headlen + 2), so a fixed file is already fmt-clean.
(defn sug-clause-style? [(h (slice u8))] (-> bool)
  (or (= h "cond") (or (= h "case") (= h "case-by"))))

(defn sug-newline! [(buf (mut (ArrayList u8))) (col i64)] (-> i64)
  (al-push! (mut buf) (primitive/cast u8 10))
  (sug-spaces! (mut buf) (sug-layout-col col))
  0)

; The column the NEXT byte written to `buf` will land in, given that the buffer's own
; first byte sits at column `start`. Derived from the buffer rather than threaded
; through the recursion: a node's true column depends on everything already written
; before it, and passing an estimate down is how re-indentation silently goes wrong.
(defn sug-cur-col [(buf (ArrayList u8)) (start i64)] (-> i64)
  (let [s (al-slice [u8] buf)
        n (slice-len [u8] s)
        (mut i) n]
    (loop (if (or (<= (load i) (primitive/cast i64 0))
                  (= (primitive/cast i64 (slice-get [u8] s (primitive/isub (load i) 1))) (primitive/cast i64 10)))
              (break)
              (set! i (primitive/isub (load i) 1))))
    (if (= (load i) (primitive/cast i64 0)) (primitive/iadd start n) (primitive/isub n (load i)))))

; ---- carrying the author's comments across a rewrite ------------------------
; A replacement is assembled from the author's own nodes, so anything INSIDE a node
; is copied verbatim and survives on its own. What no Code value records is the text
; BETWEEN nodes — and in a Lisp the text between two nodes is the comments. Closing
; an `if` staircase into a `cond` closes exactly those gaps, so left alone the
; rewrite would quietly delete them.
;
; So the renderer walks the ORIGINAL span alongside the replacement it is building:
; a cursor tracks how far into the source the nodes emitted so far have reached, and
; whenever the next node starts past the cursor, the comments in the text skipped
; over are written out first. Every fix that reuses the author's nodes emits them in
; source order, so the cursor only moves forward; a node that would move it backwards
; carries nothing rather than duplicating text that was already written.
(defstruct SugGap [(on i64) (source i64) (at i64) (end i64) (brk i64)])
(defn sug-gap-cell [] (-> (ptr SugGap))
  (primitive/alloc-static SugGap))
(defn sug-gap-begin [(source i64) (lo i64) (hi i64)] (-> i64)
  (let [g (sug-gap-cell)
        src (sug-file-text source)
        n (slice-len [u8] src)
        span
          (if (or (< lo (primitive/cast i64 0)) (or (> hi n) (> lo hi)))
              ""
              (subslice [u8] src lo hi))]
    (set! (.on g) 1)
    (set! (.source g) source)
    (set! (.at g) lo)
    (set! (.end g) hi)
    ; A comment ends its line, so a replacement carrying one CANNOT be laid out flat.
    ; The width pass runs before the carry and would never find out on its own, so the
    ; whole rendering is put in broken layout up front — the same thing verbatim text
    ; containing a newline already does by reporting an unfittable width.
    (set! (.brk g) (if (> (sug-comment-marks span) (primitive/cast i64 0)) (do 1) 0))
    0))
(defn sug-gap-end [] (-> i64)
  (set! (.on (sug-gap-cell)) 0)
  0)
(defn sug-gap-break? [] (-> bool)
  (let [g (sug-gap-cell)]
    (and (!= (.on g) (primitive/cast i64 0))
         (!= (.brk g) (primitive/cast i64 0)))))

; Write every comment in `s` into `buf`, each on its own line at column `col`. A `;`
; in the gap between two nodes can only start a comment: a string or a char literal
; is a node in its own right and would never sit loose in a gap.
;
; `lead` says which side the line break goes on. Mid-form the buffer is already
; indented and waiting for the node that follows, so the break comes AFTER each
; comment (leaving that indent behind for it). After the form there is nothing to
; follow, so the break comes BEFORE — otherwise the edit ends in trailing blanks.
(defn sug-put-comments! [(buf (mut (ArrayList u8))) (s (slice u8)) (col i64) (lead bool)] (-> i64)
  (let [n (slice-len [u8] s)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (if (!= (primitive/cast i64 (slice-get [u8] s (load i))) (primitive/cast i64 59))
                  (set! i (primitive/iadd (load i) 1))
                  (let [start (load i)
                        (mut e) (load i)]
                    (when lead (sug-newline! (mut buf) col))
                    ; a comment runs to end of line
                    (loop (if (or (>= (load e) n)
                                  (= (primitive/cast i64 (slice-get [u8] s (load e))) (primitive/cast i64 10)))
                              (break)
                              (set! e (primitive/iadd (load e) 1))))
                    ; ...minus any trailing blanks, which would become dangling
                    ; whitespace once the line is re-laid-out somewhere else
                    (let [(mut t) (load e)]
                      (loop (if (<= (load t) start)
                                (break)
                                (let [c (primitive/cast i64 (slice-get [u8] s (primitive/isub (load t) 1)))]
                                  (if (or (= c (primitive/cast i64 32))
                                          (or (= c (primitive/cast i64 9)) (= c (primitive/cast i64 13))))
                                      (set! t (primitive/isub (load t) 1))
                                      (break)))))
                      (append-bytes! (mut buf) (subslice [u8] s start (load t))))
                    (unless lead (sug-newline! (mut buf) col))
                    (set! i (load e))))))
    0))

; The source text between where the cursor stopped and where `x` begins: the gap the
; rewrite is about to close, and the only place the author's text can go missing.
; Empty when `x` sits behind the cursor — a fix that reordered the author's nodes,
; where carrying would re-emit text already written.
(defn sug-gap-before [(x Sexp)] (-> (slice u8))
  (let [g (sug-gap-cell)]
    (if (or (= (.on g) (primitive/cast i64 0))
            (!= (sx-source x) (.source g)))
        ""
        (let [lo (sx-lo x)
              at (.at g)
              src (sug-file-text (.source g))
              n (slice-len [u8] src)]
          ; The node must lie INSIDE the span being replaced. A replacement also
          ; contains nodes from the RULE's own quasiquote — the `if`/`cond` head it
          ; writes — and when a rule is applied to the very file it is written in,
          ; those share a source id with the target while sitting somewhere else
          ; entirely. Without this test the cursor would "catch up" to one of them and
          ; dump every comment in between into the middle of the replacement.
          (if (or (< lo at)
                  (or (> (sx-hi x) (.end g))
                      (or (> lo n) (> at n))))
              ""
              (subslice [u8] src at lo))))))

(defn sug-gap-commented? [(x Sexp)] (-> bool)
  (> (sug-comment-marks (sug-gap-before x)) (primitive/cast i64 0)))

; Carry the comments sitting in front of `x`, leaving the buffer indented at `col` for
; `x` itself, and move the cursor past `x` so nothing is written twice.
(defn sug-carry-at! [(buf (mut (ArrayList u8))) (x Sexp) (col i64)] (-> i64)
  (let [g (sug-gap-cell)]
    (sug-put-comments! (mut buf) (sug-gap-before x) col false)
    ; Only a node from INSIDE the replaced span may move the cursor. One borrowed from
    ; elsewhere in the same file — the rule's own quasiquoted head — would otherwise
    ; shove it past the end of the span and silence every carry after it.
    (when (and (and (!= (load (field g on)) (primitive/cast i64 0))
                    (and (= (sx-source x) (load (field g source)))
                         (<= (sx-hi x) (load (field g end)))))
               (> (sx-hi x) (load (field g at))))
      (store! (field g at) (sx-hi x)))
    0))

; Comments inside the replaced span but after the last node the replacement reused
; would otherwise go out with the closing parens. They are written after the rendered
; form, on their own line — the one place left that is still inside the edit.
(defn sug-carry-tail! [(buf (mut (ArrayList u8))) (hi i64) (col i64)] (-> i64)
  (let [g (sug-gap-cell)]
    (unless (= (load (field g on)) (primitive/cast i64 0))
      (let [at (load (field g at))
            src (sug-file-text (load (field g source)))
            n (slice-len [u8] src)]
        (unless (or (>= at hi) (> hi n))
          (sug-put-comments! (mut buf) (subslice [u8] src at hi) col true))))))

; Render `x` into `buf` as source text. `start` is the column `buf`'s first byte
; occupies, which is all the renderer needs to know about the text around it.
(defn sug-emit! [(a (dyn Allocator)) (buf (mut (ArrayList u8))) (x Sexp) (start i64)] (-> i64)
  ; A disambiguated identifier has no source text to be faithful to: the bytes at
  ; its span are the RULE's spelling, which is the one being renamed.
  (let [rn (sug-ren-of x)
        v (if (> (slice-len [u8] rn) (primitive/cast i64 0)) "" (sug-verbatim x))]
    (if (> (slice-len [u8] v) (primitive/cast i64 0))
        ; A node that came from source. Carry the comments skipped over on the way to
        ; it FIRST — that may open a new line, so its landing column has to be read
        ; from the buffer afterwards rather than before.
        (do
          (sug-carry-at! (mut buf) x (sug-cur-col (load buf) start))
          (sug-put-reindent! (mut buf)
                             v
                             (sug-col-at (sug-file-text (sx-source x)) (sx-lo x))
                             (sug-cur-col (load buf) start)))
        (let [col (sug-cur-col (load buf) start)
              tg (sx-tag x)]
          (if (not (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7))))
              (sug-atom! a (mut buf) x)
              (let [items (sx-items x)
                    n (sx-len items)
                    open (if (= tg (primitive/cast i64 7)) 91 40)
                    close (if (= tg (primitive/cast i64 7)) 93 41)]
                (if (= n (primitive/cast i64 0))
                    (do (al-push! (mut buf) (primitive/cast u8 open)) (al-push! (mut buf) (primitive/cast u8 close)) 0)
                    (do
                      (al-push! (mut buf) (primitive/cast u8 open))
                      (if (and (not (sug-gap-break?))
                               (<= (primitive/iadd col (sug-width a x)) (sug-width-budget)))
                          ; fits: one line, single spaces
                          (let [(mut i) 0]
                            (loop (if (>= (load i) n)
                                      (break)
                                      (do
                                        (when (> (load i) (primitive/cast i64 0))
                                          (al-push! (mut buf) (primitive/cast u8 32)))
                                        (sug-emit! a (mut buf) (sx-at items (load i)) start)
                                        (set! i (primitive/iadd (load i) 1))))))
                          ; breaks: the head (or a vector's first element) stays on this
                          ; line and everything after aligns under the first argument —
                          ; fmt's CALL shape. `cond`/`case` additionally pair up.
                          (let [h (if (= tg (primitive/cast i64 6)) (sug-head-display x) "")
                                pairs (and (= tg (primitive/cast i64 6)) (sug-clause-style? h))
                                ind
                                  (if (= tg (primitive/cast i64 7))
                                      (primitive/iadd col 1)
                                      (primitive/iadd (primitive/iadd col (slice-len [u8] h)) 2))
                                step (if pairs 2 1)]
                            (sug-emit! a (mut buf) (sx-at items 0) start)
                            (let [(mut i) 1]
                              (loop (if (>= (load i) n)
                                        (break)
                                        (do
                                          (if (= (load i) (primitive/cast i64 1))
                                              (al-push! (mut buf) (primitive/cast u8 32))
                                              (sug-newline! (mut buf) ind))
                                          ; one clause: test, then its body — on the same
                                          ; line if it still fits, else broken onto the
                                          ; next one indented two past the clause column,
                                          ; which is where fmt puts a body it cannot fit
                                          ; (src/compiler/formatter/rules.coil layout-clauses).
                                          (let [(mut k) 0]
                                            (loop (if (or (>= (load k) step)
                                                          (>= (primitive/iadd (load i)
                                                                              (load k))
                                                              n))
                                                      (break)
                                                      (let [it
                                                              (sx-at items
                                                                     (primitive/iadd (load i)
                                                                                     (load k)))]
                                                        (when (> (load k) (primitive/cast i64 0))
                                                          (if (sug-gap-commented? it)
                                                              ; src/compiler/formatter/rules.coil: a comment BETWEEN a clause
                                                              ; test and its body forces the hang — two
                                                              ; spaces, the comment, then the body alone on
                                                              ; the next line. Nothing may share that line.
                                                              (do
                                                                (al-push! (mut buf) (primitive/cast u8 32))
                                                                (al-push! (mut buf) (primitive/cast u8 32))
                                                                (sug-carry-at! (mut buf) it (primitive/iadd ind 2)))
                                                              (if (<= (primitive/iadd (primitive/iadd (sug-cur-col (load buf)
                                                                                                                   start)
                                                                                                      1)
                                                                                      (sug-width a it))
                                                                      (sug-width-budget))
                                                                  (al-push! (mut buf) (primitive/cast u8 32))
                                                                  (sug-newline! (mut buf) (primitive/iadd ind 2)))))
                                                        (sug-emit! a (mut buf) it start)
                                                        (set! k (primitive/iadd (load k) 1))))))
                                          (set! i (primitive/iadd (load i) step))))))))
                      (al-push! (mut buf) (primitive/cast u8 close))
                      0)))))))
  0)
; ---- the comment guard ------------------------------------------------------
; A replacement is assembled from the author's own nodes, so anything INSIDE a node
; survives. What does not survive is text between nodes — and in a Lisp the text
; between two nodes is a comment. Nothing in a Code value records it, so a rule that
; drops a clause boundary would delete the author's comment with it.
;
; Rather than let that happen quietly, the fix is checked before it is applied: count
; the comment marks in the span being replaced and in the text replacing it, and if
; any went missing the rewrite is not a rewrite the author would accept. `;` inside a
; string literal is not a comment, so string state is tracked.
(defn sug-comment-marks [(s (slice u8))] (-> i64)
  (let [n (slice-len [u8] s)
        (mut i) 0
        (mut instr) false
        (mut count) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (slice-get [u8] s (load i)))]
                (if (load instr)
                    (if (= c (primitive/cast i64 92))
                        (set! i (primitive/iadd (load i) 2))  ; escape: skip the escaped byte
                        (do
                          (when (= c (primitive/cast i64 34)) (store! instr false))
                          (set! i (primitive/iadd (load i) 1))))
                    (do
                      (if (= c (primitive/cast i64 34))
                          (set! instr true)
                          (when (= c (primitive/cast i64 59))
                            (store! count (primitive/iadd (load count) 1))))
                      (set! i (primitive/iadd (load i) 1)))))))
    (load count)))

; Would splicing `repl` over [lo,hi) of `src` lose a comment?
(defn sug-drops-comment? [(src (slice u8)) (lo i64) (hi i64) (repl (slice u8))] (-> bool)
  (let [n (slice-len [u8] src)]
    (if (or (< lo (primitive/cast i64 0)) (or (> hi n) (> lo hi)))
        false
        (> (sug-comment-marks (subslice [u8] src lo hi)) (sug-comment-marks repl)))))

; ── the files that supply the RULES are not targets ──────────────────────────
; A rule loaded with `--use` is an INPUT to the analysis, and `--fix` re-analyses
; after every round. If a rule matches its own source, the first round rewrites the
; file the rule was compiled from; the Code literals its replacements are built out of
; (the `if`/`and` heads in its own quasiquotes) still carry spans into the text as it
; was BEFORE that edit. Rendering then reads the right byte count at the wrong offset
; and splices mangled identifiers into the file — which is exactly the failure a
; source-rewriting tool must not have. Caught here, at the same place as the other
; filters, so such a fix is never even recorded.
(defstruct RuleSrcBox [(init i64) (lst (ptr (ArrayList i64)))])
(defn rule-src-box [] (-> (ptr RuleSrcBox))
  (primitive/alloc-static RuleSrcBox))
(defn rule-srcs [] (-> (ptr (ArrayList i64)))
  (let [b (rule-src-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b lst) (box! (malloc-allocator) (ArrayList i64) (primitive/zeroed (ArrayList i64))))
      (store! (load (field b lst)) (al-new [i64] (malloc-allocator)))
      (store! (field b init) 1)
      0)
    (load (field b lst))))
(defn rule-src-add [(sid i64)] (-> i64)
  (unless (< sid (primitive/cast i64 0)) (al-push! (rule-srcs) sid) 0))
(defn rule-src-reset [] (-> i64)
  (let [b (rule-src-box)]
    (unless (= (load (field b init)) (primitive/cast i64 0))
      (store! (load (field b lst)) (al-new [i64] (malloc-allocator)))
      0)))
(defn rule-src? [(sid i64)] (-> bool)
  (let [l (rule-srcs)
        n (al-len [i64] (load l))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (if (= (al-get [i64] (load l) (load i)) sid)
                  (do (set! r true) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; Record a proposed rewrite. The filters live HERE rather than at apply time, so a
; node a fix could never legally touch never advertises one either:
;   * ctxt ≠ 0     — macro-generated. Its span points at the macro or the call site,
;                    so "fixing" it would write nonsense into an unrelated form. This
;                    filter is not optional and not configurable.
;   * not user code — a bundled stdlib node has no file on disk to edit.
;   * a rule's own source — see above; the analysis may not rewrite its own input.
(defn cop-record-fix [(node Sexp) (repl Sexp) (msg (slice u8)) (di i64) (del i64)] (-> i64)
  (unless (or (!= (sx-ctxt node) (primitive/cast i64 0))
              (or (not (code-from-user-node? node)) (rule-src? (sx-source node))))
    (let [s (primitive/alloc-stack Suggestion)
          rp (primitive/alloc-stack Sexp)]
      (store! rp repl)
      (store! (field s source) (sx-source node))
      (store! (field s lo) (sx-lo node))
      (store! (field s hi) (sx-hi node))
      (store! (field s col) (sug-col-at (sug-file-text (sx-source node)) (sx-lo node)))
      ; The replacement remains borrowed until the checker invocation returns.
      ; `sug-freeze-from!` then renders it before that invocation's arena closes.
      (store! (field s locals) (sug-locals-of rp))
      (store! (field s repl) repl)
      (store! (field s rendered) "")
      (store! (field s help) "")
      (store! (field s msg) (ct-own-str msg))
      (store! (field s diag) di)
      (store! (field s del) del)
      (sug-push (load s))
      0)))

; ops 32 `(primitive/warn NODE MSG)`, 44 `(primitive/suggest NODE MSG REPLACEMENT)` and
; 58 `(primitive/delete NODE MSG)`. All three record a located, non-fatal warning at
; NODE — that half is identical, so it is written once — and the latter two additionally
; record the fix they propose: a rewrite, or the node's removal.
(defn cop-warn-or-suggest [(a (dyn Allocator)) (op i64) (args (ptr (ArrayList CtVal)))] (-> (Result CtVal Diag))
  (let [fixing (= op (primitive/cast i64 44))
        deleting (= op (primitive/cast i64 58))
        nm (cond fixing "suggest" deleting "delete" :else "warn")
        usage
          (cond fixing "suggest: expects (primitive/suggest NODE MSG REPLACEMENT), REPLACEMENT a Code value"
                deleting "delete: expects (primitive/delete NODE MSG)"
                :else "warn: expects (primitive/warn NODE MSG)")
        repl
          (if fixing
              (match (cv-get args 2)
                (None [] (None [Sexp]))
                (Some [rv] (if (is-ccode rv) (Some (ccode-of rv)) (None [Sexp]))))
              (None [Sexp]))]
    (if (and fixing (not (some? [Sexp] repl)))
        (Err [CtVal Diag] (derr usage))
        (match (cv-get args 0)
          (None [] (Err [CtVal Diag] (derr usage)))
          (Some [nodev]
                (if (not (is-ccode nodev))
                    (Err [CtVal Diag] (derr (sconcat a nm ": first arg must be a Code node")))
                    (match (cv-get args 1)
                      (None [] (Err [CtVal Diag] (derr usage)))
                      (Some [msgv]
                            (if (not (is-cstr msgv))
                                (Err [CtVal Diag] (derr (sconcat a nm ": message must be a string")))
                                (let [node (ccode-of nodev)
                                      d (primitive/alloc-stack Diag)
                                      di (al-len [Diag] (load (warn-list)))]
                                  (set! (.lo d) (sx-lo node))
                                  (set! (.hi d) (sx-hi node))
                                  ; malloc, not `a`: the warn list outlives the
                                  ; expansion arena `a` may be (COIL_META_ARENA)
                                  (set! (.msg d) (sconcat (malloc-allocator) "warning: " (cstr-of msgv)))
                                  (set! (.source d) (sx-source node))
                                  (set! (.ctxt d) 0)
                                  (warn-push (load d))
                                  ; a delete carries no replacement, so `node` stands in
                                  ; for the unused `repl` slot rather than widening the
                                  ; record with an Option nobody reads.
                                  (if deleting
                                      (cop-record-fix node node (cstr-of msgv) di 1)
                                      (match repl
                                        (None [] 0)
                                        (Some [r] (cop-record-fix node r (cstr-of msgv) di 0))))
                                  (Ok [CtVal Diag] (CInt 0))))))))))))

; A suggestion's replacement as text, laid out as if it began at column `col`.
(defn sug-render-tree-at [(a (dyn Allocator)) (s Suggestion) (col i64)] (-> (slice u8))
  (let [sp (primitive/alloc-stack Suggestion)
        (mut buf) (al-new [u8] a)
        start (sug-layout-col col)]
    (set! sp s)
    ; the cursor runs over the span being replaced, so the comments in the gaps the
    ; rewrite closes come along with the nodes it reuses
    (sug-gap-begin (.source sp)
                   (.lo sp)
                   (.hi sp))
    (sug-ren-build! a (.repl sp) (.locals sp))
    (sug-emit! a (mut buf) (.repl sp) start)
    (sug-carry-tail! (mut buf) (.hi sp) start)
    (sug-ren-clear)
    (sug-gap-end)
    (al-slice [u8] (load buf))))

; Freeze suggestions recorded by one completed checker before its expansion arena
; is released. Waiting until the checker returns matters: rendering uses the
; suggestion-hygiene table, which is also active while the checker is still building
; later replacements. The old lifetime boundary deep-copied every overlapping AST;
; this one owns only the bytes lint will actually print or splice.
(defn sug-freeze-from! [(a (dyn Allocator)) (start i64)] (-> i64)
  (let [lst (sug-list)
        n (al-len [Suggestion] (load lst))
        (mut i) start]
    (loop (if (>= (load i) n)
              (break)
              (let [sp (al-elem [Suggestion] lst (load i))]
                (when (= (.del sp) (primitive/cast i64 0))
                  (set! (.rendered sp)
                        (ct-own-str (sug-render-tree-at a (load sp) (.col sp))))
                  (set! (.help sp)
                        (ct-own-str (sug-render-tree-at a (load sp) 11)))
                  0)
                (set! (.repl sp) (primitive/zeroed Sexp))
                (set! i (primitive/iadd (load i) 1)))))
    0))

; Persistent suggestions own rendered bytes, not an overlapping replacement AST.
(defn sug-render-at [(a (dyn Allocator)) (s Suggestion) (col i64)] (-> (slice u8))
  (let [sp (primitive/alloc-stack Suggestion)]
    (set! sp s)
    (if (> (slice-len [u8] (.rendered sp)) (primitive/cast i64 0))
        (if (= col (primitive/cast i64 11)) (.help sp) (.rendered sp))
        (sug-render-tree-at a s col))))

; The text that would be spliced over the suggestion's own span.
(defn sug-render [(a (dyn Allocator)) (s Suggestion)] (-> (slice u8))
  (let [sp (primitive/alloc-stack Suggestion)]
    (set! sp s)
    (.rendered sp)))

; Print `help: try: …` for any suggestion attached to warning `di`. This is where
; most of autofix's value lands: the proposed rewrite is visible from an ordinary
; build, whether or not anyone ever runs `coil lint --fix`. Continuation lines are
; laid out to align under the start of the replacement, past the `help: try: ` label.
(defn sug-print-help [(w (ptr Writer)) (a (dyn Allocator)) (di i64)] (-> i64)
  (let [n (sug-count)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (primitive/alloc-stack Suggestion)]
                  (set! sp (sug-at (load i)))
                  (when (= (load (field sp diag)) di)
                    ; A deletion has no replacement text to show, so it says what it
                    ; would do instead of printing an empty `try:` line.
                    (if (= (load (field sp del)) (primitive/cast i64 0))
                        (do
                          (ps w "help: try: ")
                          (ps w (sug-render-at a (load sp) 11))
                          0)
                        (ps w "help: `coil lint --fix` deletes this form"))
                    (wb w 10)
                    0))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; case it exists for: cross-compiling. A macro branching on it baked the host branch
; into a wasm build, silently. The arch is one value per compile, set from the resolved
; --target triple before expansion runs (like the nid/gensym counters, it is a
; per-process global — the compiler builds one target per invocation).
; C `access(path, 0)` — F_OK. Module-qualified so the name cannot collide;
; the backends link the LAST dot component, i.e. the C symbol `access`.
(extern comptime.access :cc c [(ptr i8) i64] (-> i32))
(defstruct TargetArchCell [(set i64) (arch (slice u8)) (os (slice u8))])
(defn target-arch-cell [] (-> (ptr TargetArchCell))
  (primitive/alloc-static TargetArchCell))

(defn arch-of-triple [(triple (ptr i8))] (-> (slice u8))
  (if (= (primitive/cast i64 triple) (primitive/cast i64 0))
      "aarch64"  ; null = host default
      (let [t (cstr->slice triple)]
        (cond (starts-with t "wasm32") "wasm32"
              (starts-with t "wasm64") "wasm64"
              (starts-with t "x86_64") "x86_64"
              (starts-with t "aarch64") "aarch64"
              (starts-with t "arm64") "aarch64"
              "aarch64"))))  ; unknown → host default

; The OS half of the same story, and it exists for the same reason the arch does:
; a library that branches on the platform — open() flags, dylib suffixes, syscall
; numbers — must branch on the platform being COMPILED FOR, not the one running
; the compiler. Without this a `const` folded at compile time silently records
; the build host, so cross-compiling to darwin from Linux bakes in Linux answers.
; (src/stdlib/fs.coil hit exactly that: 512 is O_CREAT on darwin and O_TRUNC on Linux.)
;
; Kept in the same cell as the arch: one target per compiler invocation, set from
; the resolved --target triple before expansion runs.
(defn has-sub? [(hay (slice u8)) (needle (slice u8))] (-> bool)
  (match (str-find hay needle) (Some [i] true) (None [] false)))

(defn os-of-triple [(triple (ptr i8))] (-> (slice u8))
  (if (= (primitive/cast i64 triple) (primitive/cast i64 0))
      (host-os-str)  ; null = "no --target", i.e. build for the host
      (let [t (cstr->slice triple)]
        ; match on the triple's os field, which is the component after the vendor
        ; ("x86_64-pc-linux-gnu", "aarch64-apple-darwin24.0.0", "wasm64-unknown-unknown").
        (cond (has-sub? t "linux") "linux"
              (has-sub? t "darwin") "darwin"
              (has-sub? t "macos") "darwin"
              (starts-with t "wasm") "wasm"
              (host-os-str)))))  ; unknown → assume the host

; The HOST os, for when no --target was given. /proc/self/maps exists on every
; Linux and never on macOS — the same probe metaengine.coil uses to pick the
; dylib extension and link command.
(defn host-os-str [] (-> (slice u8))
  (if (= (primitive/cast i64 (comptime.access c"/proc/self/maps" 0)) (primitive/cast i64 0)) "linux" "darwin"))

(defn set-target-arch! [(triple (ptr i8))] (-> i64)
  (let [c (target-arch-cell)]
    (set! (.arch c) (arch-of-triple triple))
    (set! (.os c) (os-of-triple triple))
    (set! (.set c) 1)
    0))

(defn target-arch-str [] (-> (slice u8))
  (let [c (target-arch-cell)]
    (if (= (.set c) (primitive/cast i64 0))
        "aarch64"
        (.arch c))))

(defn target-os-str [] (-> (slice u8))
  (let [c (target-arch-cell)]
    (if (= (.set c) (primitive/cast i64 0))
        (host-os-str)
        (.os c))))

; `(primitive/debug-checks?)` — the --debug-checks build-mode predicate (mem-2/6/7/8), a code op
; (39) so it works in BOTH engines with no seed refresh: the interpreter answers it here
; in `code-op`, and the compiled engine routes back through `code-op` via metahost. Set
; from the driver before expansion (like the target arch); off (false) by default, so a
; library's `(if (primitive/debug-checks?) …checked… …plain…)` guard MACRO expands to the plain
; form and costs nothing. Per-process global — one build mode per compile.
(defstruct DebugChecksCell [(on i64)])
(defn debug-checks-cell [] (-> (ptr DebugChecksCell))
  (primitive/alloc-static DebugChecksCell))
(defn set-debug-checks! [(on i64)] (-> i64)
  (set! (.on (debug-checks-cell)) on)
  0)
(defn debug-checks-on? [] (-> bool)
  (!= (.on (debug-checks-cell)) (primitive/cast i64 0)))

; One sanitizer per program object: 0=off, 1=address, 2=thread, 3=memory,
; 4=undefined. ASan/TSan/MSan runtimes are mutually incompatible, so the driver
; rejects attempts to select more than one instead of silently choosing an order.
(defstruct SanitizeCell [(mode i64)])
(defn sanitize-cell [] (-> (ptr SanitizeCell))
  (primitive/alloc-static SanitizeCell))
(defn set-sanitize-mode! [(mode i64)] (-> i64)
  (set! (.mode (sanitize-cell)) mode)
  0)
(defn sanitize-mode [] (-> i64)
  (.mode (sanitize-cell)))
(defn set-sanitize-address! [] (-> i64)
  (set-sanitize-mode! 1))
(defn sanitize-address-on? [] (-> bool)
  (= (sanitize-mode) (primitive/cast i64 1)))

; ── S1 semantic layer for `(primitive/code-decl NODE)`: read the compiler's AUTHORITATIVE
; work. Checkers run AFTER resolve + typecheck (see expander.coil::run-registered-
; checkers and driver.coil::run-pipeline), so a checker reads the real checked
; Program — fully-qualified names and real signatures — NOT a parallel resolver.
; `set-sem-model` stashes that Program before checkers run; `code-decl` answers
; WHERE a name is defined (its module) and, for a function, its SIGNATURE.
(defstruct SemModelBox [(init i64) (prog (ptr Program))])
(defn sem-model-box [] (-> (ptr SemModelBox))
  (primitive/alloc-static SemModelBox))
(defn set-sem-model [(p (ptr Program))] (-> i64)
  (let [b (sem-model-box)]
    (set! (.prog b) p)
    (set! (.init b) 1)
    (variant-owner-build! p)
    0))
; No authoritative program available this round (the current program does not yet
; typecheck) — `code-decl` and friends then answer `:unresolved`. A transform can
; still rewrite syntactically until the program becomes valid.
(defn clear-sem-model [] (-> i64)
  (set-sem-model (primitive/cast (ptr Program) 0)))
(defn sem-model [] (-> (ptr Program))
  (let [b (sem-model-box)]
    (if (= (.init b) (primitive/cast i64 0))
        (primitive/cast (ptr Program) 0)
        (load (field b prog)))))
; Raw project lint intentionally does not expand application macros. Preserve the
; semantic distinction between "this authored node is a macro call" and "this node
; was generated by expansion" so checkers can choose whether to enter its arguments.
(defstruct MacroCallBox
  [(init i64) (index (ptr (HashMap i64 bool)))])
(defn macro-call-box [] (-> (ptr MacroCallBox))
  (primitive/alloc-static MacroCallBox))
(defn macro-call-reset [] (-> i64)
  (let [b (macro-call-box)
        a (malloc-allocator)]
    (store! (field b index)
            (box! a (HashMap i64 bool) (hm-new [i64 bool] a (scalar-keyops [i64]))))
    (set! (.init b) 1)
    0))
(defn macro-call-record [(nid i64)] (-> i64)
  (when (> nid (primitive/cast i64 0))
    (let [b (macro-call-box)]
      (when (= (load (field b init)) (primitive/cast i64 0)) (macro-call-reset) 0)
      (hm-put! [i64 bool] (mut (load (field b index))) nid true))
    0)
  0)
(defn macro-call-lookup [(nid i64)] (-> bool)
  (let [b (macro-call-box)]
    (if (or (<= nid (primitive/cast i64 0))
            (= (.init b) (primitive/cast i64 0)))
        false
        (match (hm-get [i64 bool] (load (load (field b index))) nid)
          (Some [v] v)
          (None [] false)))))
; ── S2: the TYPE MAP — per-expression inferred types for `(primitive/type-of NODE)`.
; The type-checker records, at `do-synth` (its single per-expression entry), the
; inferred Type keyed by the expression's source span. A metaprogram then asks
; `(primitive/type-of NODE)` for the type of any expression it sees (the surface Code node
; shares the span the checker recorded). Reset at the start of each check pass.
(defstruct TypeMapEntry [(nid i64) (ty Type)])
(defstruct TypeMapBox [(init i64) (lst (ptr (ArrayList TypeMapEntry)))])
(defn type-map-box [] (-> (ptr TypeMapBox))
  (primitive/alloc-static TypeMapBox))
(defn type-map-list [] (-> (ptr (ArrayList TypeMapEntry)))
  (let [b (type-map-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b lst)
              (box! (malloc-allocator) (ArrayList TypeMapEntry) (primitive/zeroed (ArrayList TypeMapEntry))))
      (store! (load (field b lst)) (al-new [TypeMapEntry] (malloc-allocator)))
      (store! (field b init) 1)
      0)
    (load (field b lst))))
(defn type-map-reset [] (-> i64)
  (let [_ (type-map-list)
        b (type-map-box)]
    (set! (load (field b lst)) (al-new [TypeMapEntry] (malloc-allocator)))
    0))
(defn type-map-record [(nid i64) (ty Type)] (-> i64)
  (unless (<= nid (primitive/cast i64 0))
    ; skip synthesized nodes (nid -1) / the "no id" sentinel
    (let [e (primitive/alloc-stack TypeMapEntry)]
      (store! (field e nid) nid)
      (store! (field e ty) ty)
      (al-push! (type-map-list) (load e))
      0)))
; Look up a node id's type; scan from the END so the last (most-refined) record wins.
(defn type-map-lookup [(nid i64)] (-> (Option Type))
  (if (<= nid (primitive/cast i64 0))
      (None [Type])
      (let [lst (type-map-list)
            n (al-len [TypeMapEntry] (load lst))
            (mut i) (primitive/isub n 1)
            (mut r) (None [Type])]
        (loop (if (< (load i) (primitive/cast i64 0))
                  (break)
                  (do
                    (let [e (al-elem [TypeMapEntry] lst (load i))]
                      (when (= (load (field e nid)) nid)
                        (store! r (Some (load (field e ty))))
                        (break)))
                    (set! i (primitive/isub (load i) 1)))))
        (load r))))
; ── S3: the BINDING MAP — per-reference local-binding identity for a borrow/
; ownership checker. The type-checker records, at every resolved `EVar`, the ID
; of the LET-binding or parameter it resolves to (0 = a global const/function or
; unbound). Two references with the same positive id name the SAME local — so
; shadowing is exact, which name-matching cannot do. `(primitive/binding-of NODE)` reads it.
; The counter is monotonic and reset per check pass, so ids are deterministic
; across identical rebuilds (the fixpoint holds).
(defstruct BidCell [(n i64)])
(defn bid-cell [] (-> (ptr BidCell))
  (primitive/alloc-static BidCell))
(defn next-bid [] (-> i64)
  (let [c (bid-cell)
        v (primitive/iadd (.n c) 1)]
    (set! (.n c) v)
    v))
(defstruct BindMapEntry [(nid i64) (bid i64)])
(defstruct BindMapBox [(init i64) (lst (ptr (ArrayList BindMapEntry)))])
(defn bind-map-box [] (-> (ptr BindMapBox))
  (primitive/alloc-static BindMapBox))
(defn bind-map-list [] (-> (ptr (ArrayList BindMapEntry)))
  (let [b (bind-map-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b lst)
              (box! (malloc-allocator) (ArrayList BindMapEntry) (primitive/zeroed (ArrayList BindMapEntry))))
      (store! (load (field b lst)) (al-new [BindMapEntry] (malloc-allocator)))
      (store! (field b init) 1)
      0)
    (load (field b lst))))
(defn bind-map-reset [] (-> i64)
  (let [_ (bind-map-list)
        b (bind-map-box)
        c (bid-cell)]
    (set! (load (field b lst)) (al-new [BindMapEntry] (malloc-allocator)))
    (set! (.n c) 0)
    0))
(defn bind-map-record [(nid i64) (bid i64)] (-> i64)
  (unless (<= nid (primitive/cast i64 0))
    (let [e (primitive/alloc-stack BindMapEntry)]
      (store! (field e nid) nid)
      (store! (field e bid) bid)
      (al-push! (bind-map-list) (load e))
      0)))
(defn bind-map-lookup [(nid i64)] (-> i64)
  (unless (<= nid (primitive/cast i64 0))
    (let [lst (bind-map-list)
          n (al-len [BindMapEntry] (load lst))
          (mut i) (primitive/isub n 1)
          (mut r) 0]
      (loop (if (< (load i) (primitive/cast i64 0))
                (break)
                (do
                  (let [e (al-elem [BindMapEntry] lst (load i))]
                    (when (= (load (field e nid)) nid)
                      (store! r (load (field e bid)))
                      (break)))
                  (store! i (primitive/isub (load i) 1)))))
      (load r))))
(defn cop-binding-of [(args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (match (cv-get args 0)
    (Some [v]
          (if (is-ccode v)
              (Ok [CtVal Diag] (CInt (bind-map-lookup (sx-nid (ccode-of v)))))
              (Err [CtVal Diag] (derr "binding-of: expects a Code node"))))
    (None [] (Err [CtVal Diag] (derr "binding-of: expects (primitive/binding-of NODE)")))))
(defn cop-type-of [(args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))]
    (match (cv-get args 0)
      (None [] (Err [CtVal Diag] (derr "type-of: expects (primitive/type-of NODE)")))
      (Some [nodev]
            (if (not (is-ccode nodev))
                (Err [CtVal Diag] (derr "type-of: expects a Code node"))
                (let [node (ccode-of nodev)]
                  (match (type-map-lookup (sx-nid node))
                    (None [] (Ok [CtVal Diag] (CCode (mk-sexp (KKw "unknown") -1 -1))))
                    (Some [t] (Ok [CtVal Diag] (CCode (ty->sexp a (box-type a t))))))))))))
; ── S0/S1: the RESOLUTION MAP — call node id → the callee's fully-qualified name,
; recorded at do-synth once the checker has the resolved ECall. Lets `(primitive/code-decl NODE)`
; on a CALL answer with the EXACT callee (the one resolution actually picked), instead
; of a name-based lookup that goes `:ambiguous` when the simple name lives in >1 module.
(defstruct ResMapEntry [(nid i64) (name (slice u8))])
(defstruct ResMapBox
  [(init i64)
   (lst (ptr (ArrayList ResMapEntry)))
   (index (ptr (HashMap i64 (slice u8))))])
(defn res-map-box [] (-> (ptr ResMapBox))
  (primitive/alloc-static ResMapBox))
(defn res-map-list [] (-> (ptr (ArrayList ResMapEntry)))
  (let [b (res-map-box)]
    (when (= (load (field b init)) (primitive/cast i64 0))
      (store! (field b lst)
              (box! (malloc-allocator) (ArrayList ResMapEntry) (primitive/zeroed (ArrayList ResMapEntry))))
      (store! (load (field b lst)) (al-new [ResMapEntry] (malloc-allocator)))
      (store! (field b index)
              (box! (malloc-allocator)
                   (HashMap i64 (slice u8))
                   (hm-new [i64 (slice u8)] (malloc-allocator) (scalar-keyops [i64]))))
      (store! (field b init) 1)
      0)
    (load (field b lst))))
(defn res-map-reset [] (-> i64)
  (let [_ (res-map-list)
        b (res-map-box)]
    (set! (load (field b lst)) (al-new [ResMapEntry] (malloc-allocator)))
    (set! (load (field b index)) (hm-new [i64 (slice u8)] (malloc-allocator) (scalar-keyops [i64])))
    0))
(defn res-map-record [(nid i64) (name (slice u8))] (-> i64)
  (unless (<= nid (primitive/cast i64 0))
    (let [e (primitive/alloc-stack ResMapEntry)]
      (store! (field e nid) nid)
      (store! (field e name) name)
      (al-push! (res-map-list) (load e))
      (hm-put! [i64 (slice u8)] (mut (load (field (res-map-box) index))) nid name)
      0)))
; ── semantic-map snapshots ────────────────────────────────────────────────────
; check-program resets the S0-S3 maps at entry — right for a real check pass,
; WRONG when a scratch closure check runs while the authoritative maps are
; still being served: lazily staging a metaprogram (stage-one-macro!) checks
; its pruned closure, and without protection that wipes the maps the semantic
; model reads, so type-of / code-decl / binding-of silently go :unknown for
; the rest of the invocation. The resets replace the boxed values without
; freeing the old backing stores, so a value snapshot restores them exactly.
(defstruct SemMapsSnap
  [(tlist (ArrayList TypeMapEntry))
   (blist (ArrayList BindMapEntry))
   (bnext i64)
   (rlist (ArrayList ResMapEntry))
   (rindex (HashMap i64 (slice u8)))])
(defn sem-maps-save [(out (ptr SemMapsSnap))] (-> i64)
  (set! (.tlist out) (load (type-map-list)))
  (set! (.blist out) (load (bind-map-list)))
  (set! (.bnext out) (.n (bid-cell)))
  (set! (.rlist out) (load (res-map-list)))
  (set! (.rindex out) (load (load (field (res-map-box) index))))
  0)
(defn sem-maps-restore [(snap (ptr SemMapsSnap))] (-> i64)
  (set! (type-map-list) (.tlist snap))
  (set! (bind-map-list) (.blist snap))
  (set! (.n (bid-cell)) (.bnext snap))
  (set! (res-map-list) (.rlist snap))
  (set! (load (field (res-map-box) index)) (.rindex snap))
  0)

(defn res-map-lookup [(nid i64)] (-> (slice u8))
  (if (<= nid (primitive/cast i64 0))
      ""
      (match (hm-get [i64 (slice u8)]
                     (load (load (field (res-map-box) index)))
                     nid)
        (Some [name] name)
        (None [] ""))))
; The module part of a fully-qualified name `mod.simple` → "mod" (before last dot), else "".
(defn qual-module-of [(name (slice u8))] (-> (slice u8))
  (let [n (slice-len [u8] name)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get name (load i))) (primitive/cast i64 46))
                  (store! at (load i))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (if (< (load at) (primitive/cast i64 0)) "" (subslice [u8] name 0 (load at)))))
; The simple (module-stripped, alias-stripped) name a query symbol refers to.
(defn decl-simple-name [(q (slice u8))] (-> (slice u8))
  (let [sl (find-slash q)]
    (after-last-dot (if (>= sl (primitive/cast i64 0)) (subslice [u8] q (primitive/iadd sl 1) (slice-len [u8] q)) q))))
; If the query was module-qualified (`mod.name`, no alias slash), the module part.
(defn decl-qual-module [(q (slice u8))] (-> (slice u8))
  (if (>= (find-slash q) (primitive/cast i64 0)) "" (qual-module-of q)))
; Does an authoritative qualified name match the queried simple name (+ optional module)?
(defn cp-name-match [(qname (slice u8)) (simple (slice u8)) (wantmod (slice u8))] (-> bool)
  (and (= (after-last-dot qname) simple)
       (or (= (slice-len [u8] wantmod) (primitive/cast i64 0)) (= (qual-module-of qname) wantmod))))
; The symbol a Code node names: a bare symbol is itself; a call/list uses its head.
(defn decl-node-name [(node Sexp)] (-> (slice u8))
  (if (= (sx-tag node) (primitive/cast i64 2))
      (sx-sval node)
      (if (= (sx-tag node) (primitive/cast i64 6))
          (let [it (sx-items node)]
            (if (>= (sx-len it) (primitive/cast i64 1))
                (let [h (sx-at it 0)] (if (= (sx-tag h) (primitive/cast i64 2)) (sx-sval h) ""))
                ""))
          "")))
; Reconstruct a Type as Code (the inverse of parse-type); mirrors ty-str's spelling.
(defn ty-list2 [(a (dyn Allocator)) (head (slice u8)) (x Sexp)] (-> Sexp)
  (let [(mut it) (al-new [Sexp] a)]
    (al-push! (mut it) (sx-sym head))
    (al-push! (mut it) x)
    (mk-sexp (KList (box-al [Sexp] a (load it))) -1 -1)))
(defn ty-list3 [(a (dyn Allocator)) (head (slice u8)) (x Sexp) (y Sexp)] (-> Sexp)
  (let [(mut it) (al-new [Sexp] a)]
    (al-push! (mut it) (sx-sym head))
    (al-push! (mut it) x)
    (al-push! (mut it) y)
    (mk-sexp (KList (box-al [Sexp] a (load it))) -1 -1)))
(defn ty-app-sexp [(a (dyn Allocator)) (t (ptr Type))] (-> Sexp)
  (let [(mut it) (al-new [Sexp] a)
        args (t-fn-params t)
        n (al-len [Type] (load args))
        (mut i) 0]
    (al-push! (mut it) (sx-sym (t-app-name t)))
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut it) (ty->sexp a (al-elem [Type] args (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (mk-sexp (KList (box-al [Sexp] a (load it))) -1 -1)))
(defn ty-fn-sexp [(a (dyn Allocator)) (t (ptr Type))] (-> Sexp)
  (let [(mut it) (al-new [Sexp] a)
        ps (t-fn-params t)
        n (al-len [Type] (load ps))
        (mut i) 0
        (mut pv) (al-new [Sexp] a)]
    (al-push! (mut it) (sx-sym "fnptr"))
    (al-push! (mut it) (sx-sym (t-fn-cc t)))
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut pv) (ty->sexp a (al-elem [Type] ps (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (al-push! (mut it) (mk-sexp (KVec (box-al [Sexp] a (load pv))) -1 -1))
    (al-push! (mut it) (ty->sexp a (t-fn-ret t)))
    (mk-sexp (KList (box-al [Sexp] a (load it))) -1 -1)))
(defn ty->sexp [(a (dyn Allocator)) (t (ptr Type))] (-> Sexp)
  (let [tg (type-tag t)]
    (cond (= tg (primitive/cast i64 0)) (sx-sym (sconcat a (if (t-int-signed t) "i" "u") (i64->str a (t-int-bits t))))
          (= tg (primitive/cast i64 1)) (sx-sym (sconcat a "f" (i64->str a (t-int-bits t))))
          (= tg (primitive/cast i64 2)) (sx-sym "bool")
          (= tg (primitive/cast i64 3)) (sx-sym "void")
          (= tg (primitive/cast i64 4)) (ty-list2 a "ptr" (ty->sexp a (t-inner t)))
          (= tg (primitive/cast i64 5)) (ty-list2 a (if (t-ref-mut t) "mut" "ref") (ty->sexp a (t-inner t)))
          (= tg (primitive/cast i64 6)) (sx-sym (type-struct-name t))
          (= tg (primitive/cast i64 7)) (ty-list3 a "array" (ty->sexp a (t-inner t)) (sx-mkint (t-arrn t)))
          (= tg (primitive/cast i64 8)) (ty-list2 a "slice" (ty->sexp a (t-inner t)))
          (= tg (primitive/cast i64 9)) (ty-list3 a "vec" (ty->sexp a (t-inner t)) (sx-mkint (t-arrn t)))
          (= tg (primitive/cast i64 12)) (sx-sym "!")
          (= tg (primitive/cast i64 13)) (sx-sym "code")
          (= tg (primitive/cast i64 14)) (sx-sym "externref")
          (= tg (primitive/cast i64 15)) (sx-sym "codebuilder")
          (= tg (primitive/cast i64 11)) (ty-app-sexp a t)
          (= tg (primitive/cast i64 10)) (ty-fn-sexp a t)
          :else (sx-sym "?"))))
; The params-vector `[T…]` of a function's signature, as Code.
(defn fn-params-vec [(a (dyn Allocator)) (fp (ptr Func))] (-> Sexp)
  (let [ps (load (field fp params))
        n (al-len [Param] (load ps))
        (mut items) (al-new [Sexp] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut items) (ty->sexp a (field (al-elem [Param] ps (load i)) ty)))
                (set! i (primitive/iadd (load i) 1)))))
    (mk-sexp (KVec (box-al [Sexp] a (load items))) -1 -1)))
; The `(decl MODULE fn [param-types] ret)` record for a checked function.
(defn fn-decl-record [(a (dyn Allocator)) (fp (ptr Func))] (-> Sexp)
  (let [(mut items) (al-new [Sexp] a)]
    (al-push! (mut items) (sx-sym "decl"))
    (al-push! (mut items) (sx-sym (qual-module-of (.name fp))))
    (al-push! (mut items) (sx-sym "fn"))
    (al-push! (mut items) (fn-params-vec a fp))
    (al-push! (mut items) (ty->sexp a (field fp ret)))
    (mk-sexp (KList (box-al [Sexp] a (load items))) -1 -1)))
; The `(decl MODULE KIND)` record for a struct/sum/trait/const/extern.
(defn kind-decl-record [(a (dyn Allocator)) (module (slice u8)) (kind (slice u8))] (-> Sexp)
  (let [(mut items) (al-new [Sexp] a)]
    (al-push! (mut items) (sx-sym "decl"))
    (al-push! (mut items) (sx-sym module))
    (al-push! (mut items) (sx-sym kind))
    (mk-sexp (KList (box-al [Sexp] a (load items))) -1 -1)))
; Dedicated AST primitives are not Program functions. Give their checked source
; nodes a declaration record so semantic tools need not trust surface spelling.
(defn primitive-decl-record [(a (dyn Allocator)) (qualified (slice u8))] (-> Sexp)
  (let [(mut items) (al-new [Sexp] a)]
    (al-push! (mut items) (sx-sym "decl"))
    (al-push! (mut items) (sx-sym "coil.primitive"))
    (al-push! (mut items) (sx-sym "primitive"))
    (al-push! (mut items) (sx-sym (decl-simple-name qualified)))
    (mk-sexp (KList (box-al [Sexp] a (load items))) -1 -1)))
; Variant constructions include the exact qualified variant as a fourth element.
; The first three elements intentionally retain the ordinary owning-sum record,
; so existing kind checks remain source-compatible while semantic tools can tell
; which payload declaration the checker selected.
(defn variant-decl-record [(a (dyn Allocator)) (sumq (slice u8)) (variantq (slice u8))] (-> Sexp)
  (let [(mut items) (al-new [Sexp] a)]
    (al-push! (mut items) (sx-sym "decl"))
    (al-push! (mut items) (sx-sym (qual-module-of sumq)))
    (al-push! (mut items) (sx-sym "sum"))
    (al-push! (mut items) (sx-sym variantq))
    (mk-sexp (KList (box-al [Sexp] a (load items))) -1 -1)))
; Search the checked Program for a FUNCTION by simple name (+ optional module).
; status 0 found (fn set), 1 none, 2 ambiguous.
(defstruct CpFn [(status i64) (fn (ptr Func))])
(defn cp-find-fn [(p (ptr Program)) (simple (slice u8)) (wantmod (slice u8))] (-> CpFn)
  (let [fs (load (field p funcs))
        n (al-len [Func] fs)
        (mut i) 0
        (mut cnt) 0
        (mut first) (primitive/cast (ptr Func) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [f (al-elem [Func] fs (load i))]
                  (when (cp-name-match (load (field f name)) simple wantmod)
                    (when (= (primitive/cast i64 (load first)) (primitive/cast i64 0))
                      (store! first f)
                      0)
                    (store! cnt (primitive/iadd (load cnt) 1))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (let [r (primitive/alloc-stack CpFn)]
      (set! (.fn r) (load first))
      (store! (field r status)
              (if (= (load cnt) (primitive/cast i64 0))
                  1
                  (unless (= (load cnt) (primitive/cast i64 1)) 2)))
      (load r))))
; Find a function by its EXACT fully-qualified name (what resolution recorded).
(defn cp-find-fn-exact [(p (ptr Program)) (qname (slice u8))] (-> (ptr Func))
  (let [fs (load (field p funcs))
        n (al-len [Func] fs)
        (mut i) 0
        (mut r) (primitive/cast (ptr Func) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [f (al-elem [Func] fs (load i))]
                  (when (= (load (field f name)) qname) (store! r f) (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
; The qualified name of the SUM that owns a variant whose qualified name is `qname`,
; or "" if none. (Variant constructions resolve their ECall.func to the variant.)
(defn cp-sum-of-variant [(p (ptr Program)) (qname (slice u8))] (-> (slice u8))
  (let [sums (load (field p sums))
        n (al-len [SumDef] sums)
        (mut i) 0
        (mut r) ""]
    (loop (if (or (> (slice-len [u8] (load r)) (primitive/cast i64 0)) (>= (load i) n))
              (break)
              (do
                (let [sd (al-elem [SumDef] sums (load i))
                      vs (load (field sd variants))
                      nv (al-len [Variant] vs)
                      (mut j) 0]
                  (loop (if (>= (load j) nv)
                            (break)
                            (do
                              (when (= (load (field (al-elem [Variant] vs (load j)) name)) qname)
                                (store! r (load (field sd name)))
                                (break))
                              (set! j (primitive/iadd (load j) 1))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
; A resolved decl: found=false → not in cp (caller falls back to name-based lookup).
(defstruct CpDecl [(found bool) (rec Sexp)])
; Exact variant reflection is a common semantic-checker query. Index it once per
; semantic model; repeatedly walking every sum for each constructor made a generic
; Code traversal quadratic in the size of the checked program.
(defstruct VariantOwnerBox
  [(init i64) (index (ptr (HashMap (slice u8) (slice u8))))])
(defn variant-owner-box [] (-> (ptr VariantOwnerBox))
  (primitive/alloc-static VariantOwnerBox))
(defn variant-owner-build! [(p (ptr Program))] (-> i64)
  (let [b (variant-owner-box)
        a (malloc-allocator)
        (mut idx) (hm-new [(slice u8) (slice u8)] a (str-keyops))]
    (set! (.init b) 1)
    (unless (= (primitive/cast i64 p) (primitive/cast i64 0))
      (let [sums (load (field p sums))
            n (al-len [SumDef] sums)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [sd (al-elem [SumDef] sums (load i))
                          vs (load (field sd variants))
                          nv (al-len [Variant] vs)
                          (mut j) 0]
                      (loop (if (>= (load j) nv)
                                (break)
                                (do
                                  (hm-put! [(slice u8) (slice u8)]
                                           (mut idx)
                                           (load (field (al-elem [Variant] vs (load j)) name))
                                           (load (field sd name)))
                                  (store! j (primitive/iadd (load j) 1))))))
                    (store! i (primitive/iadd (load i) 1)))))))
    (store! (field b index) (box! a (HashMap (slice u8) (slice u8)) (load idx)))
    0))
(defn variant-owner [(qname (slice u8))] (-> (slice u8))
  (let [b (variant-owner-box)]
    (if (= (.init b) (primitive/cast i64 0))
        ""
        (match (hm-get [(slice u8) (slice u8)] (load (load (field b index))) qname)
          (Some [sumq] sumq)
          (None [] "")))))
; Build the decl record for the entity whose EXACT qualified name resolution recorded.
; Searches functions, then struct/sum/trait/const/extern, then sum variants.
(defn cp-find-exact-decl [(a (dyn Allocator)) (p (ptr Program)) (qname (slice u8))] (-> CpDecl)
  (let [r (primitive/alloc-stack CpDecl)
        sumq (variant-owner qname)
        fn
          (if (> (slice-len [u8] sumq) (primitive/cast i64 0))
              (primitive/cast (ptr Func) 0)
              (cp-find-fn-exact p qname))]
    (set! (.found r) false)
    (if (> (slice-len [u8] sumq) (primitive/cast i64 0))
        (do
          (set! (.found r) true)
          (set! (.rec r) (variant-decl-record a sumq qname))
          0)
        (if (!= (primitive/cast i64 fn) (primitive/cast i64 0))
            (do
              (set! (.found r) true)
              (set! (.rec r) (fn-decl-record a fn))
              0)
            (let [nks (cp-kind-decls a p)
                  n (al-len [NamedKind] (load nks))
                  (mut i) 0]
              (loop (if (or (.found r) (>= (load i) n))
                        (break)
                        (do
                          (let [e (al-elem [NamedKind] nks (load i))]
                            (when (= (load (field e name)) qname)
                              (store! (field r found) true)
                              (store! (field r rec)
                                      (kind-decl-record a
                                                        (qual-module-of qname)
                                                        (load (field e kind))))
                              0))
                          (set! i (primitive/iadd (load i) 1)))))
              (unless (load (field r found))
                (let [sq (cp-sum-of-variant p qname)]  ; variant construction → its sum
                  (when (> (slice-len [u8] sq) (primitive/cast i64 0))
                    (store! (field r found) true)
                    (store! (field r rec) (variant-decl-record a sq qname))
                    0))))))
    (load r)))
; A (qualified-name, kind) pair, for the non-function declaration kinds.
(defstruct NamedKind [(name (slice u8)) (kind (slice u8))])
(defn nk-push [(dst (ptr (ArrayList NamedKind))) (name (slice u8)) (kind (slice u8))] (-> i64)
  (let [e (primitive/alloc-stack NamedKind)]
    (set! (.name e) name)
    (set! (.kind e) kind)
    (al-push! dst (load e))
    0))
; Collect every struct/sum/trait/const/extern as a (qualified-name, kind) pair.
(defn cp-kind-decls [(a (dyn Allocator)) (p (ptr Program))] (-> (ptr (ArrayList NamedKind)))
  (let [(mut out) (al-new [NamedKind] a)
        ss (load (field p structs))
        sums (load (field p sums))
        tr (load (field p traits))
        cs (load (field p consts))
        ex (load (field p externs))
        (mut i) 0]
    (set! i 0)
    (loop (if (>= (load i) (al-len [StructDef] ss))
              (break)
              (do
                (nk-push (mut out)
                         (.name (al-elem [StructDef] ss (load i)))
                         "struct")
                (set! i (primitive/iadd (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (al-len [SumDef] sums))
              (break)
              (do
                (nk-push (mut out)
                         (.name (al-elem [SumDef] sums (load i)))
                         "sum")
                (set! i (primitive/iadd (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (al-len [TraitDef] tr))
              (break)
              (do
                (nk-push (mut out)
                         (.name (al-elem [TraitDef] tr (load i)))
                         "trait")
                (set! i (primitive/iadd (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (al-len [Const] cs))
              (break)
              (do
                (nk-push (mut out)
                         (.name (al-elem [Const] cs (load i)))
                         "const")
                (set! i (primitive/iadd (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (al-len [Extern] ex))
              (break)
              (do
                (nk-push (mut out)
                         (.name (al-elem [Extern] ex (load i)))
                         "extern")
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [NamedKind] a (load out))))
(defn cop-decl [(args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))
        p (sem-model)]
    (match (cv-get args 0)
      (None [] (Err [CtVal Diag] (derr "code-decl: expects (primitive/code-decl NODE)")))
      (Some [nodev]
            (if (not (is-ccode nodev))
                (Err [CtVal Diag] (derr "code-decl: expects a Code node"))
                (if (= (primitive/cast i64 p) (primitive/cast i64 0))
                    (Ok [CtVal Diag] (CCode (mk-sexp (KKw "unresolved") -1 -1)))
                    ; EXACT path first: if this node is a reference the checker resolved — an
                    ; expression ref (call, fn-ptr, variant) via its node id, or a TYPE ref via
                    ; its (module, raw-name) → use the recorded qualified name. No ambiguity,
                    ; cross-module correct.
                    (let [node (ccode-of nodev)
                          rq0 (res-map-lookup (sx-nid node))
                          rqn
                            (if (> (slice-len [u8] rq0) (primitive/cast i64 0))
                                rq0
                                (type-res-lookup (src-mod-lookup (sx-source node)) (decl-node-name node)))
                          rd (primitive/alloc-stack CpDecl)]
                      (set! rd
                            (if (or (= rqn "coil.primitive.field")
                                    (or (= rqn "coil.primitive.load")
                                        (= rqn "coil.primitive.store!")))
                                (let [z (primitive/alloc-stack CpDecl)]
                                  (set! (.found z) true)
                                  (set! (.rec z) (primitive-decl-record a rqn))
                                  (load z))
                                (if (and (> (slice-len [u8] rqn) (primitive/cast i64 0))
                                         (not (= rqn "$unresolved")))
                                    (cp-find-exact-decl a p rqn)
                                    (let [z (primitive/alloc-stack CpDecl)]
                                      (set! (.found z) false)
                                      (load z)))))
                      (if (= rqn "$unresolved")
                          (Ok [CtVal Diag] (CCode (mk-sexp (KKw "unresolved") -1 -1)))
                          (if (.found rd)
                              (Ok [CtVal Diag] (CCode (.rec rd)))
                              (let [nm (decl-node-name (ccode-of nodev))]
                                (if (= (slice-len [u8] nm) (primitive/cast i64 0))
                                    (Ok [CtVal Diag] (CCode (mk-sexp (KKw "unresolved") -1 -1)))
                                    (let [simple (decl-simple-name nm)
                                          wantmod (decl-qual-module nm)
                                          fr (primitive/alloc-stack CpFn)]
                                      (set! fr (cp-find-fn p simple wantmod))
                                      (if (= (.status fr) (primitive/cast i64 2))
                                          (Ok [CtVal Diag] (CCode (mk-sexp (KKw "ambiguous") -1 -1)))
                                          (if (= (.status fr) (primitive/cast i64 0))
                                              (Ok [CtVal Diag]
                                                  (CCode (fn-decl-record a (load (field fr fn)))))
                                              ; not a function — scan the kind-only declarations
                                              (let [nks (cp-kind-decls a p)
                                                    n (al-len [NamedKind] (load nks))
                                                    (mut i) 0
                                                    (mut cnt) 0
                                                    (mut fk) ""
                                                    (mut fm) ""]
                                                (loop (if (>= (load i) n)
                                                          (break)
                                                          (do
                                                            (let [e (al-elem [NamedKind] nks (load i))]
                                                              (when (cp-name-match (load (field e name))
                                                                                   simple
                                                                                   wantmod)
                                                                (when (= (load cnt) (primitive/cast i64 0))
                                                                  (store! fk (load (field e kind)))
                                                                  (store! fm
                                                                          (qual-module-of (load (field e
                                                                                                       name))))
                                                                  0)
                                                                (store! cnt (primitive/iadd (load cnt) 1))
                                                                0))
                                                            (set! i (primitive/iadd (load i) 1)))))
                                                (if (= (load cnt) (primitive/cast i64 0))
                                                    (Ok [CtVal Diag] (CCode (mk-sexp (KKw "unresolved") -1 -1)))
                                                    (if (> (load cnt) (primitive/cast i64 1))
                                                        (Ok [CtVal Diag] (CCode (mk-sexp (KKw "ambiguous") -1 -1)))
                                                        (Ok [CtVal Diag]
                                                            (CCode (kind-decl-record a
                                                                                     (load fm)
                                                                                     (load fk)))))))))))))))))))))
(defn ct-sum-find [(cx (ptr CtCtx)) (name (slice u8))] (-> (ptr SumDef))
  (let [lst (load (field cx sums))
        n (al-len [SumDef] (load lst))
        (mut i) 0
        (mut r) (primitive/cast (ptr SumDef) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [SumDef] lst (load i)) name)) name)
                  (store! r (al-elem [SumDef] lst (load i)))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (if (!= (primitive/cast i64 (load r)) (primitive/cast i64 0))
        (load r)
        (let [p (sem-model)]
          (if (= (primitive/cast i64 p) (primitive/cast i64 0))
              (load r)
              (let [model-lst (load (field p sums))
                    model-n (al-len [SumDef] model-lst)
                    (mut j) 0]
                (loop (if (>= (load j) model-n)
                          (break)
                          (do
                            (when (= (load (field (al-elem [SumDef] model-lst (load j)) name)) name)
                              (store! r (al-elem [SumDef] model-lst (load j)))
                              0)
                            (set! j (primitive/iadd (load j) 1)))))
                (load r)))))))
(defn ct-trait-find [(cx (ptr CtCtx)) (name (slice u8))] (-> (ptr TraitDef))
  (let [lst (load (field cx traits))
        n (al-len [TraitDef] (load lst))
        (mut i) 0
        (mut r) (primitive/cast (ptr TraitDef) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [TraitDef] lst (load i)) name)) name)
                  (store! r (al-elem [TraitDef] lst (load i)))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn cstr-of [(v CtVal)] (-> (slice u8))
  (match v (CStr [s] s) (_ "")))
(defn is-cstr [(v CtVal)] (-> bool)
  (match v (CStr [s] true) (_ false)))
(defn is-ccode [(v CtVal)] (-> bool)
  (match v (CCode [c] true) (_ false)))
(defn ccode-of [(v CtVal)] (-> Sexp)
  (match v (CCode [c] c) (_ (primitive/zeroed Sexp))))
(defn sx-sym [(s (slice u8))] (-> Sexp)
  (mk-sexp (KSym s) -1 -1))
(defn sx-mkstr [(s (slice u8))] (-> Sexp)
  (mk-sexp (KStr s) -1 -1))
(defn sx-mkint [(n i64)] (-> Sexp)
  (mk-sexp (KInt n) -1 -1))
(defn sx-mklist [(items (ptr (ArrayList Sexp)))] (-> Sexp)
  (mk-sexp (KList items) -1 -1))
(defn reader-config-char [(node Sexp)] (-> i64)
  (if (= (sx-tag node) (primitive/cast i64 0))
      (sx-ival node)
      (if (and (= (sx-tag node) (primitive/cast i64 2))
               (let [s (sx-sval node)]
                 (and (>= (slice-len s) 3)
                      (and (= (primitive/cast i64 (slice-get s 0)) 35)
                           (= (primitive/cast i64 (slice-get s 1)) 92)))))
          (let [s (sx-sval node)
                body (subslice s 2 (slice-len s))]
            (if (= (slice-len body) 1)
                (primitive/cast i64 (slice-get body 0))
                (char-name-code body)))
          -1)))
(defn intw-name [(a (dyn Allocator)) (pre (slice u8)) (b i64)] (-> (slice u8))
  (sconcat a pre (dec->str a b)))
(defn type-kind-tag [(t Type) (cx (ptr CtCtx))] (-> i64)
  (match t
    (TInt [b s] 0)
    (TFloat [b] 1)
    (TBool [] 2)
    (TStruct [n]
             (if (!= (primitive/cast i64 (ct-struct-find cx n)) (primitive/cast i64 0))
                 3
                 (if (!= (primitive/cast i64 (ct-sum-find cx n)) (primitive/cast i64 0)) 4 8)))
    (TApp [n a]
          (if (!= (primitive/cast i64 (ct-struct-find cx n)) (primitive/cast i64 0))
              3
              (if (!= (primitive/cast i64 (ct-sum-find cx n)) (primitive/cast i64 0)) 4 8)))
    (TPtr [i] 5)
    (TRef [m i] 5)
    (TArray [e k] 6)
    (TSlice [e] 7)
    (_ 8)))
; The type's name for CODE GENERATION: nominal types keep their qualification, so a
; symbol built from it (`Inner-eq`, `Inner-hash`) resolves wherever the generated code
; lands. `type-name-str` strips it, which is right for the display/dispatch uses and
; wrong here: `(derive Eq Outer)` over a field typed from an `:as` import emitted a call
; to a bare `Inner-eq` that existed only as `qlib.Inner-eq`.
(defn qual-type-name-str [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (match (load t) (TStruct [n] n) (TApp [n ar] n) (_ (type-name-str a t))))

(defn type-name-str [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TInt [b s] (if s (intw-name a "i" b) (intw-name a "u" b)))
    (TFloat [b] (intw-name a "f" b))
    (TBool [] "bool")
    (TStruct [n] (after-last-dot n))
    (TApp [n ar] (after-last-dot n))
    (TPtr [i] "ptr")
    (TRef [m i] "ptr")
    (TArray [e k] "array")
    (TSlice [e] "slice")
    (_ (do (unimplemented "comptime/type_name_str: Debug form of exotic type") ""))))
(defn type->code [(t (ptr Type))] (-> Sexp)
  (let [a (malloc-allocator)]
    (match (load t)
      (TInt [b s] (sx-sym (if s (intw-name a "i" b) (intw-name a "u" b))))
      (TFloat [b] (sx-sym (intw-name a "f" b)))
      (TBool [] (sx-sym "bool"))
      (TVoid [] (sx-sym "void"))
      (TCode [] (sx-sym "Code"))
      (TCodeBuilder [] (sx-sym "CodeBuilder"))
      (TExternRef [] (sx-sym "externref"))
      (TNever [] (sx-sym "Never"))
      (TStruct [n] (sx-sym n))
      (TPtr [i]
            (let [(mut xs) (al-new [Sexp] a)]
              (al-push! (mut xs) (sx-sym "ptr"))
              (al-push! (mut xs) (type->code i))
              (sx-mklist (box-al [Sexp] a (load xs)))))
      (TRef [m i]
            (let [(mut xs) (al-new [Sexp] a)]
              (al-push! (mut xs) (sx-sym (if m "mut" "ref")))
              (al-push! (mut xs) (type->code i))
              (sx-mklist (box-al [Sexp] a (load xs)))))
      (TSlice [i]
              (let [(mut xs) (al-new [Sexp] a)]
                (al-push! (mut xs) (sx-sym "slice"))
                (al-push! (mut xs) (type->code i))
                (sx-mklist (box-al [Sexp] a (load xs)))))
      (TArray [i n]
              (let [(mut xs) (al-new [Sexp] a)]
                (al-push! (mut xs) (sx-sym "array"))
                (al-push! (mut xs) (type->code i))
                (al-push! (mut xs) (sx-mkint n))
                (sx-mklist (box-al [Sexp] a (load xs)))))
      (TVec [i n]
            (let [(mut xs) (al-new [Sexp] a)]
              (al-push! (mut xs) (sx-sym "vec"))
              (al-push! (mut xs) (type->code i))
              (al-push! (mut xs) (sx-mkint n))
              (sx-mklist (box-al [Sexp] a (load xs)))))
      (TFn [cc p r]
           (let [(mut pv) (al-new [Sexp] a)
                 np (al-len [Type] (load p))
                 (mut j) 0]
             (loop (if (>= (load j) np)
                       (break)
                       (do
                         (al-push! (mut pv) (type->code (al-elem [Type] p (load j))))
                         (set! j (primitive/iadd (load j) 1)))))
             (let [(mut xs) (al-new [Sexp] a)]
               (al-push! (mut xs) (sx-sym "fnptr"))
               (al-push! (mut xs) (sx-sym cc))
               (al-push! (mut xs) (mk-sexp (KVec (box-al [Sexp] a (load pv))) -1 -1))
               (al-push! (mut xs) (type->code r))
               (sx-mklist (box-al [Sexp] a (load xs))))))
      (TApp [n ar]
            (let [(mut xs) (al-new [Sexp] a)
                  na (al-len [Type] (load ar))
                  (mut j) 0]
              (al-push! (mut xs) (sx-sym n))
              (loop (if (>= (load j) na)
                        (break)
                        (do
                          (al-push! (mut xs) (type->code (al-elem [Type] ar (load j))))
                          (set! j (primitive/iadd (load j) 1)))))
              (sx-mklist (box-al [Sexp] a (load xs))))))))
(defn ty-is-named [(t Type)] (-> bool)
  (match t (TStruct [n] true) (TApp [n a] true) (_ false)))
(defn ty-name-opt [(t Type)] (-> (slice u8))
  (match t (TStruct [n] n) (TApp [n a] n) (_ "")))
(defn type-query [(q i64) (ty Type) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [named (ty-is-named ty)
        nm (ty-name-opt ty)]
    (cond (= q (primitive/cast i64 0))
            (let [sd (if named (ct-struct-find cx nm) (primitive/cast (ptr StructDef) 0))]
              (if (= (primitive/cast i64 sd) (primitive/cast i64 0))
                  (Err [CtVal Diag] (derr "field-count: type is not a struct"))
                  (Ok [CtVal Diag] (CInt (al-len [Field] (load (field sd fields)))))))
          (= q (primitive/cast i64 1))
            (let [sd (if named (ct-sum-find cx nm) (primitive/cast (ptr SumDef) 0))]
              (if (= (primitive/cast i64 sd) (primitive/cast i64 0))
                  (Err [CtVal Diag] (derr "variant-count: type is not a sum"))
                  (Ok [CtVal Diag] (CInt (al-len [Variant] (load (field sd variants)))))))
          (= q (primitive/cast i64 2))
            (Ok [CtVal Diag]
                (CBool (and named (!= (primitive/cast i64 (ct-struct-find cx nm)) (primitive/cast i64 0)))))
          (= q (primitive/cast i64 3))
            (Ok [CtVal Diag] (CBool (and named (!= (primitive/cast i64 (ct-sum-find cx nm)) (primitive/cast i64 0)))))
          (= q (primitive/cast i64 4)) (Ok [CtVal Diag] (CBool (match ty (TInt [b s] true) (_ false))))
          (= q (primitive/cast i64 5)) (Ok [CtVal Diag] (CBool (match ty (TFloat [b] true) (_ false))))
          (= q (primitive/cast i64 6)) (Ok [CtVal Diag] (CBool (match ty (TPtr [i] true) (TRef [m i] true) (_ false))))
          :else (Ok [CtVal Diag] (CBool (match ty (TArray [e k] true) (_ false)))))))
(defn field-meta [(meta i64) (ty Type) (i i64) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))]
    (if (not (ty-is-named ty))
        (Err [CtVal Diag] (derr "field reflection: type is not a struct"))
        (let [sd (ct-struct-find cx (ty-name-opt ty))]
          (if (= (primitive/cast i64 sd) (primitive/cast i64 0))
              (Err [CtVal Diag] (derr "field reflection: not a struct"))
              (let [flds (load (field sd fields))
                    nf (al-len [Field] (load flds))]
                (if (or (< i (primitive/cast i64 0)) (>= i nf))
                    (Err [CtVal Diag] (derr "field reflection: index out of range"))
                    (let [fp (al-elem [Field] flds i)
                          fname (.name fp)
                          ftyp (field fp ty)]
                      (if (= meta (primitive/cast i64 0))
                          (Ok [CtVal Diag] (CStr fname))
                          (if (= meta (primitive/cast i64 1))
                              (Ok [CtVal Diag] (CInt (type-kind-tag (load ftyp) cx)))
                              (Ok [CtVal Diag] (CStr (type-name-str a ftyp)))))))))))))
(defn find-field-index [(ty Type) (want (slice u8)) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))]
    (if (not (ty-is-named ty))
        (Err [CtVal Diag] (derr "field-index: type is not a struct"))
        (let [sd (ct-struct-find cx (ty-name-opt ty))]
          (if (= (primitive/cast i64 sd) (primitive/cast i64 0))
              (Err [CtVal Diag] (derr "field-index: not a struct"))
              (let [flds (load (field sd fields))
                    nf (al-len [Field] (load flds))
                    (mut i) 0
                    (mut r) -1]
                (loop (if (>= (load i) nf)
                          (break)
                          (do
                            (when (= (load (field (al-elem [Field] flds (load i)) name)) want)
                              (store! r (load i))
                              (break))
                            (set! i (primitive/iadd (load i) 1)))))
                (if (< (load r) (primitive/cast i64 0))
                    (Err [CtVal Diag] (derr (sconcat3 a "field-index: struct has no field '" want "'")))
                    (Ok [CtVal Diag] (CInt (load r))))))))))
(defn sexp-list-eq [(xs (ptr (ArrayList Sexp))) (ys (ptr (ArrayList Sexp)))] (-> bool)
  (let [nx (al-len [Sexp] (load xs))
        ny (al-len [Sexp] (load ys))]
    (if (!= nx ny)
        false
        (let [(mut i) 0
              (mut ok) true]
          (loop (if (or (not (load ok)) (>= (load i) nx))
                    (break)
                    (do
                      (unless (sexp-eq (al-get [Sexp] (load xs) (load i))
                                       (al-get [Sexp] (load ys) (load i)))
                        (store! ok false)
                        0)
                      (set! i (primitive/iadd (load i) 1)))))
          (load ok)))))
(defn sexp-eq [(x Sexp) (y Sexp)] (-> bool)
  ; a KView (tag 8) compares as the LIST it denotes (docs/design/META_MEMORY.md
  ; phase 5): code-rest of a list must equal the equal literal list
  (let [tx0 (sx-tag x)
        ty0 (sx-tag y)
        tx (if (= tx0 (primitive/cast i64 8)) (primitive/cast i64 6) tx0)
        ty (if (= ty0 (primitive/cast i64 8)) (primitive/cast i64 6) ty0)]
    (cond (!= tx ty) false
          (or (= tx (primitive/cast i64 0)) (= tx (primitive/cast i64 1))) (= (sx-ival x) (sx-ival y))
          (or (= tx (primitive/cast i64 2))
              (or (= tx (primitive/cast i64 3)) (or (= tx (primitive/cast i64 4)) (= tx (primitive/cast i64 5)))))
            (= (sx-sval x) (sx-sval y))
          (or (= tx (primitive/cast i64 6)) (= tx (primitive/cast i64 7))) (sexp-eq-nodes x y)
          :else false)))
(defn ctval->sexp [(v CtVal)] (-> (Result Sexp Diag))
  (match v
    (CCode [c] (Ok [Sexp Diag] c))
    (CInt [n] (Ok [Sexp Diag] (sx-mkint n)))
    (CFloat [x] (Ok [Sexp Diag] (mk-sexp (KFloat (f64-bits x)) -1 -1)))
    (CBool [b] (Ok [Sexp Diag] (sx-sym (if b "true" "false"))))
    (CStr [s] (Ok [Sexp Diag] (sx-mkstr s)))
    (_ (Err [Sexp Diag] (derr "comptime: can't unquote an aggregate value into code")))))
(defstruct FindS [(p (ptr StructDef)) (status i64)])
(defn find-struct-flex [(cx (ptr CtCtx)) (tname (slice u8))] (-> FindS)
  (let [r (primitive/alloc-stack FindS)
        exact (ct-struct-find cx tname)]
    (if (!= (primitive/cast i64 exact) (primitive/cast i64 0))
        (do
          (set! (.p r) exact)
          (set! (.status r) 0)
          (load r))
        (let [lst (load (field cx structs))
              n (al-len [StructDef] (load lst))
              (mut i) 0
              (mut cnt) 0
              (mut first) (primitive/cast (ptr StructDef) 0)]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (let [sp (al-elem [StructDef] lst (load i))]
                        (when (= (after-last-dot (load (field sp name))) (after-last-qualifier tname))
                          (when (= (load cnt) (primitive/cast i64 0)) (store! first sp) 0)
                          (store! cnt (primitive/iadd (load cnt) 1))))
                      (set! i (primitive/iadd (load i) 1)))))
          (if (= (load cnt) (primitive/cast i64 0))
              (do (set! (.status r) 1) (load r))
              (if (= (load cnt) (primitive/cast i64 1))
                  (do
                    (set! (.p r) (load first))
                    (set! (.status r) 0)
                    (load r))
                  (do (set! (.status r) 2) (load r))))))))
(defstruct FindSum [(p (ptr SumDef)) (status i64)])
(defn find-sum-flex [(cx (ptr CtCtx)) (tname (slice u8))] (-> FindSum)
  (let [r (primitive/alloc-stack FindSum)
        exact (ct-sum-find cx tname)]
    (if (!= (primitive/cast i64 exact) (primitive/cast i64 0))
        (do
          (set! (.p r) exact)
          (set! (.status r) 0)
          (load r))
        (let [lst (load (field cx sums))
              n (al-len [SumDef] (load lst))
              (mut i) 0
              (mut cnt) 0
              (mut first) (primitive/cast (ptr SumDef) 0)]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (let [sp (al-elem [SumDef] lst (load i))]
                        (when (= (after-last-dot (load (field sp name))) (after-last-qualifier tname))
                          (when (= (load cnt) (primitive/cast i64 0)) (store! first sp) 0)
                          (store! cnt (primitive/iadd (load cnt) 1))))
                      (set! i (primitive/iadd (load i) 1)))))
          (if (= (load cnt) (primitive/cast i64 0))
              (do (set! (.status r) 1) (load r))
              (if (= (load cnt) (primitive/cast i64 1))
                  (do
                    (set! (.p r) (load first))
                    (set! (.status r) 0)
                    (load r))
                  (do (set! (.status r) 2) (load r))))))))
(defstruct FindTr [(p (ptr TraitDef)) (status i64)])
(defn find-trait-flex [(cx (ptr CtCtx)) (tname (slice u8))] (-> FindTr)
  (let [r (primitive/alloc-stack FindTr)
        exact (ct-trait-find cx tname)]
    (if (!= (primitive/cast i64 exact) (primitive/cast i64 0))
        (do
          (set! (.p r) exact)
          (set! (.status r) 0)
          (load r))
        (let [lst (load (field cx traits))
              n (al-len [TraitDef] (load lst))
              (mut i) 0
              (mut cnt) 0
              (mut first) (primitive/cast (ptr TraitDef) 0)]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (let [sp (al-elem [TraitDef] lst (load i))]
                        (when (= (after-last-dot (load (field sp name))) (after-last-qualifier tname))
                          (when (= (load cnt) (primitive/cast i64 0)) (store! first sp) 0)
                          (store! cnt (primitive/iadd (load cnt) 1))))
                      (set! i (primitive/iadd (load i) 1)))))
          (if (= (load cnt) (primitive/cast i64 0))
              (do (set! (.status r) 1) (load r))
              (if (= (load cnt) (primitive/cast i64 1))
                  (do
                    (set! (.p r) (load first))
                    (set! (.status r) 0)
                    (load r))
                  (do (set! (.status r) 2) (load r))))))))
(defstruct FindVS [(name (slice u8)) (status i64)])
(defn sum-has-variant [(sd (ptr SumDef)) (want (slice u8))] (-> bool)
  (let [vs (load (field sd variants))
        n (al-len [Variant] (load vs))
        (mut i) 0
        (mut r) false]
    (loop (if (or (load r) (>= (load i) n))
              (break)
              (do
                (when (= (after-last-dot (load (field (al-elem [Variant] vs (load i)) name))) want)
                  (store! r true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn find-variant-sum [(cx (ptr CtCtx)) (want (slice u8))] (-> FindVS)
  (let [r (primitive/alloc-stack FindVS)
        lst (load (field cx sums))
        n (al-len [SumDef] (load lst))
        (mut i) 0
        (mut cnt) 0
        (mut first) ""]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (al-elem [SumDef] lst (load i))]
                  (when (sum-has-variant sp want)
                    (when (= (load cnt) (primitive/cast i64 0))
                      (store! first (load (field sp name)))
                      0)
                    (store! cnt (primitive/iadd (load cnt) 1))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (= (load cnt) (primitive/cast i64 0))
        (do (set! (.status r) 1) (load r))
        (if (= (load cnt) (primitive/cast i64 1))
            (do
              (set! (.name r) (load first))
              (set! (.status r) 0)
              (load r))
            (do (set! (.status r) 2) (load r))))))
(defn cv-get [(args (ptr (ArrayList CtVal))) (i i64)] (-> (Option CtVal))
  (if (or (< i (primitive/cast i64 0)) (>= i (al-len [CtVal] (load args))))
      (None [CtVal])
      (Some (al-get [CtVal] (load args) i))))
(defn code-symname [(args (ptr (ArrayList CtVal)))] (-> (slice u8))
  ; first arg as a Code symbol name (for code-field-*/code-variant-*/code-trait-*).
  (match (cv-get args 0)
    (Some [v] (if (is-ccode v) (let [c (ccode-of v)] (if (= (sx-tag c) (primitive/cast i64 2)) (sx-sval c) "")) ""))
    (None [] "")))
(defn append-bytes! [(buf (mut (ArrayList u8))) (s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut buf) (slice-get s (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn cop-concat-finish [(op i64) (name (slice u8)) (errf (Option Diag))] (-> (Result CtVal Diag))
  (match errf
    (Some [d] (Err [CtVal Diag] d))
    (None []
          (if (= op (primitive/cast i64 12))
              (let [p (primitive/alloc-stack Sexp)]
                (set! p (sx-sym name))
                ; Datum construction has no lexical context. A negative marker
                ; keeps it distinct from source syntax until an explicit context
                ; operation classifies it.
                (set! (.hyg p) -1)
                (set! (.horigin p) 3)
                (Ok [CtVal Diag] (CCode (load p))))
              (Ok [CtVal Diag] (CStr name))))))
; A type reference in Code — a bare type symbol `Point`, or a generic instantiation
; `(Gen A B)` — mangled to ONE valid symbol so a macro can mint a name for a derived
; helper over a generic instance (the same shape `code-field-count` accepts). Mirrors
; the monomorphizer's naming scheme: base, then `__` and each argument's own mangle;
; an int (an array size) is its decimal digits. Deterministic, valid symbol characters
; only. Returns "" for a shape that is not a nameable type — the caller errors.
(defn inst-node-mangle [(a (dyn Allocator)) (node Sexp)] (-> (slice u8))
  (let [tg (sx-tag node)]
    (cond (or (= tg (primitive/cast i64 2)) (= tg (primitive/cast i64 4))) (sx-sval node)
          (= tg (primitive/cast i64 0)) (dec->str a (sx-ival node))
          (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
            (let [items (sx-items node)
                  n (sx-len items)]
              (if (or (= n (primitive/cast i64 0)) (!= (sx-tag (sx-at items 0)) (primitive/cast i64 2)))
                  ""
                  (let [(mut s) (sx-sval (sx-at items 0))
                        (mut i) 1]
                    (loop (if (>= (load i) n)
                              (break)
                              (let [part (inst-node-mangle a (sx-at items (load i)))]
                                (if (= part "")
                                    (do (store! s "") (break))
                                    (do
                                      (store! s (sconcat a (load s) (sconcat a "__" part)))
                                      (store! i (primitive/iadd (load i) 1)))))))
                    (load s))))
          :else "")))
(defn concat-one! [(a (dyn Allocator)) (buf (mut (ArrayList u8))) (v CtVal) (tg i64)] (-> (Option Diag))
  (cond (= tg (primitive/cast i64 3)) (do (append-bytes! (mut buf) (cstr-of v)) (None [Diag]))
        (= tg (primitive/cast i64 0)) (do (append-bytes! (mut buf) (dec->str a (cint-of v))) (None [Diag]))
        (= tg (primitive/cast i64 4))
          (let [c (ccode-of v)
                ctg (sx-tag c)]
            (cond (or (= ctg (primitive/cast i64 2)) (= ctg (primitive/cast i64 4)))
                    (do (append-bytes! (mut buf) (sx-sval c)) (None [Diag]))
                  (= ctg (primitive/cast i64 0)) (do (append-bytes! (mut buf) (dec->str a (sx-ival c))) (None [Diag]))
                  (or (= ctg (primitive/cast i64 6)) (= ctg (primitive/cast i64 7)))
                    (let [m (inst-node-mangle a c)]
                      (if (= m "")
                          (Some (derr "comptime: code-symbol/str part is not a nameable type (expected a symbol, string, int, or instantiation (Gen …))"))
                          (do (append-bytes! (mut buf) m) (None [Diag]))))
                  :else (Some (derr "comptime: code-symbol/str part must be a symbol/string/int"))))
        :else (Some (derr "comptime: code-symbol/str part must be a string/int/code"))))
(defn concat-into! [(args (ptr (ArrayList CtVal))) (i i64) (n i64) (a (dyn Allocator)) (buf (mut (ArrayList u8)))] (-> (Option Diag))
  (if (>= i n)
      (None [Diag])
      (let [v (al-get [CtVal] (load args) i)]
        (match (concat-one! a (mut buf) v (ct-tag v))
          (Some [d] (Some d))
          (None [] (concat-into! args (primitive/iadd i 1) n a (mut buf)))))))
(defn cop-concat [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))
        (mut buf) (al-new [u8] a)
        e (concat-into! args 0 (al-len [CtVal] (load args)) a (mut buf))]
    (cop-concat-finish op (al-slice [u8] (load buf)) e)))

; ---- scope-bearing identifier operations ----------------------------------
(defn ct-ident-name [(v CtVal)] (-> (Result (slice u8) Diag))
  (cond (= (ct-tag v) (primitive/cast i64 3)) (Ok (cstr-of v))
        (is-ccode v)
          (let [s (ccode-of v) tg (sx-tag s)]
            (if (or (= tg (primitive/cast i64 2)) (= tg (primitive/cast i64 4)))
                (Ok (sx-sval s))
                (Err (derr "identifier name must be a string or symbol Code"))))
        :else (Err (derr "identifier name must be a string or symbol Code"))))
(defn ident-copy-with [(a (dyn Allocator)) (orig Sexp) (name (slice u8)) (hyg i64)] (-> Sexp)
  (let [p (box! a Sexp (primitive/zeroed Sexp))]
    (set! p orig)
    (set! (.kind p) (KSym name))
    (set! (.hyg p) hyg)
    (set! (.nid p) (next-nid))
    (load p)))
(defn cop-hygiene [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))]
    (cond (= op (primitive/cast i64 66))
            (match (cv-get args 0)
              (Some [nv]
                    (match (ct-ident-name nv)
                      (Err [d] (Err [CtVal Diag] d))
                      (Ok [name]
                          (let [s (mk-sexp (KSym name) -1 -1)
                                p (primitive/alloc-stack Sexp)]
                            (set! p s)
                            (let [scope (primitive/iadd (next-gensym) 1)]
                              (set! (.hyg p) scope)
                              (set! (.horigin p) 2)
                              ; Fresh lexical identity is deliberately
                              ; module-neutral. Definition-site module context
                              ; belongs to template literals, not generated
                              ; binders that may be transported into a target.
                              (set! (.hmod p) ""))
                            (Ok [CtVal Diag] (CCode (load p)))))))
              (None [] (Err [CtVal Diag] (derr "fresh-identifier: expects a display name"))))
          (= op (primitive/cast i64 67))
            (match (cv-get args 0)
              (Some [pv]
                    (match (cv-get args 1)
                      (Some [nv]
                            (if (not (is-ccode pv))
                                (Err [CtVal Diag] (derr "datum->syntax: prototype must be Code"))
                                (match (ct-ident-name nv)
                                  (Err [d] (Err [CtVal Diag] d))
                                  (Ok [name]
                                      (let [out (ident-copy-with a
                                                                 (ccode-of pv)
                                                                 name
                                                                 (sx-hyg (ccode-of pv)))
                                            p (primitive/alloc-stack Sexp)]
                                        (set! p out)
                                        (set! (.horigin p) 4)
                                        (Ok [CtVal Diag] (CCode (load p))))))))
                      (None [] (Err [CtVal Diag] (derr "datum->syntax: expects prototype and name")))))
              (None [] (Err [CtVal Diag] (derr "datum->syntax: expects prototype and name"))))
          (= op (primitive/cast i64 68))
            (match (cv-get args 0)
              (Some [iv]
                    (if (and (is-ccode iv) (= (sx-tag (ccode-of iv)) (primitive/cast i64 2)))
                        (Ok [CtVal Diag]
                            (let [out (ident-copy-with a (ccode-of iv) (sx-sval (ccode-of iv)) 0)
                                  p (primitive/alloc-stack Sexp)]
                              (set! p out)
                              (set! (.hmod p) "")
                              (set! (.horigin p) 5)
                              (CCode (load p))))
                        (Err [CtVal Diag] (derr "syntax->datum: expects identifier Code"))))
              (None [] (Err [CtVal Diag] (derr "syntax->datum: expects identifier Code"))))
          :else
            (match (cv-get args 0)
              (Some [xv]
                    (match (cv-get args 1)
                      (Some [yv]
                            (if (and (is-ccode xv)
                                     (and (is-ccode yv)
                                          (and (= (sx-tag (ccode-of xv)) (primitive/cast i64 2))
                                               (= (sx-tag (ccode-of yv)) (primitive/cast i64 2)))))
                                (Ok [CtVal Diag]
                                    (let [xh (sx-hyg (ccode-of xv))
                                          yh (sx-hyg (ccode-of yv))
                                          xm (sx-hmod (ccode-of xv))
                                          ym (sx-hmod (ccode-of yv))]
                                      (CBool
                                        (and (= (sx-sval (ccode-of xv)) (sx-sval (ccode-of yv)))
                                             (if (= op (primitive/cast i64 69))
                                                 ; Free equality follows a canonical definition-site
                                                 ; global even across separate template evaluations.
                                                 (or (= xh yh)
                                                     (and (> (slice-len [u8] xm) (primitive/cast i64 0))
                                                          (= xm ym)))
                                                 ; Bound equality is exact lexical identity.
                                                 (= xh yh))))))
                                (Err [CtVal Diag] (derr "identifier equality expects two identifier Code values"))))
                      (None [] (Err [CtVal Diag] (derr "identifier equality expects two arguments")))))
              (None [] (Err [CtVal Diag] (derr "identifier equality expects two arguments")))))))

; substitute type-parameter symbols in a type Code tree with the given arg forms:
; `(ptr T)` with T->i64 becomes `(ptr i64)`. The engine of GENERIC REFLECTION —
; `code-field-type` on an instantiation `(Gen A B)` reports concrete field types.
(defn subst-type-code [(node Sexp) (params (ptr (ArrayList (slice u8)))) (targs (ptr (ArrayList Sexp)))] (-> Sexp)
  (let [tg (sx-tag node)]
    (if (= tg (primitive/cast i64 2))
        (let [nm (sx-sval node)
              np (al-len [(slice u8)] (load params))
              nt (al-len [Sexp] (load targs))
              (mut idx) -1
              (mut i) 0]
          (loop (if (or (>= (load idx) (primitive/cast i64 0)) (>= (load i) np))
                    (break)
                    (do
                      (when (and (= (al-get [(slice u8)] (load params) (load i)) nm)
                                 (< (load i) nt))
                        (store! idx (load i)))
                      (set! i (primitive/iadd (load i) 1)))))
          (if (>= (load idx) (primitive/cast i64 0))
              (al-get [Sexp] (load targs) (load idx))
              node))
        (if (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
            (let [a (malloc-allocator)
                  items (sx-items node)
                  n (sx-len items)
                  (mut xs) (al-new [Sexp] a)
                  (mut i) 0]
              (loop (if (>= (load i) n)
                        (break)
                        (do
                          (al-push! (mut xs) (subst-type-code (sx-at items (load i)) params targs))
                          (set! i (primitive/iadd (load i) 1)))))
              (mk-sexp (if (= tg (primitive/cast i64 7))
                           (KVec (box-al [Sexp] a (load xs)))
                           (KList (box-al [Sexp] a (load xs))))
                       -1
                       -1))
            node))))
; ── the DERIVE REGISTRY ──────────────────────────────────────────────────────
; A function is a deriver because a `(register-derive …)` form NAMED it. It is
; never a deriver because of what it is called: there is no spelling you can give
; an ordinary `defn` that makes `(derive Eq T)` find it, and `defderive` is sugar
; that writes the registration for you rather than a second, implicit path.
;
; That is the whole reason this table exists instead of a name convention. A
; convention makes every `[Code] -> Code` function in the program a potential
; deriver by accident, and makes the answer to "what derives Eq here?" a question
; about spelling rather than about a declaration you can grep for.
;
; The names stored are QUALIFIED (the registration resolves them through
; `resolve-macro` before calling `derive-reg-put!`), so the call a macro emits
; resolves wherever the expansion lands — the hazard `code-variant-qname` and
; `code-field-qtype` exist to fix.

;; One registered trait. An arm is "" when the deriver does not support that
;; shape, which is a DECLARATION — it is what lets `(derive Hash SomeSum)` fail
;; with a sentence about Hash instead of a reflection error from inside a macro.
(defstruct DeriveEnt
  [(trait (slice u8)) (arm_struct (slice u8)) (arm_sum (slice u8)) (owner (slice u8))])
(defstruct DeriveReg [(items (ArrayList DeriveEnt)) (init i64)])
(defn derive-reg [] (-> (ptr DeriveReg))
  (primitive/alloc-static DeriveReg))
;; Invalidated at the top of every `run-expand`, for the same reason the macro
;; index is: a second run in one process must not inherit the first one's table.
(defn derive-reg-reset! [] (-> i64)
  (let [r (derive-reg)]
    (set! (.items r) (al-new [DeriveEnt] (malloc-allocator)))
    (set! (.init r) 1)
    0))
(defn derive-reg-ready [] (-> (ptr DeriveReg))
  (let [r (derive-reg)]
    (when (= (load (field r init)) (primitive/cast i64 0))
      (derive-reg-reset!)
      0)
    r))
;; Traits are matched on their LAST SEGMENT: a registration naming `Eq` and a use
;; site that wrote `p/Eq` under an alias import are the same trait, and comparing
;; the whole spelling would answer "unregistered" for every qualified mention.
(defn derive-reg-find [(trait (slice u8))] (-> (ptr DeriveEnt))
  (let [r (derive-reg-ready)
        lst (field r items)
        n (al-len [DeriveEnt] (load lst))
        (mut i) 0
        (mut found) (primitive/cast (ptr DeriveEnt) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [e (al-elem [DeriveEnt] lst (load i))]
                  (when (= (after-last-qualifier (load (field e trait))) (after-last-qualifier trait))
                    (store! found e)
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))
;; Duplicate registration is an ERROR, not last-wins: two modules each claiming to
;; derive `Eq` is an ambiguity the program has to resolve, and silently picking one
;; would make which impl you get depend on load order.
(defn derive-reg-put! [(trait (slice u8))
                       (astruct (slice u8))
                       (asum (slice u8))
                       (owner (slice u8))] (-> (Option Diag))
  (let [a (malloc-allocator)
        prev (derive-reg-find trait)]
    (if (!= (primitive/cast i64 prev) (primitive/cast i64 0))
        (Some (derr (sconcat3 a
                              "register-derive: trait '"
                              trait
                              (sconcat3 a "' already has a deriver, registered in '" (.owner prev) "'"))))
        (let [r (derive-reg-ready)
              e (primitive/alloc-stack DeriveEnt)]
          (set! (.trait e) trait)
          (set! (.arm_struct e) astruct)
          (set! (.arm_sum e) asum)
          (set! (.owner e) owner)
          (al-push! (mut (.items r)) (load e))
          (None [Diag])))))

;; The base name of the type argument at `idx`: `Node`, or the head of `(Gen A B)`.
;; `refl-type-inst` answers this for arg0 only and also collects type arguments;
;; the deriver lookup needs neither, so it does not pay for them.
(defn refl-type-name-at [(args (ptr (ArrayList CtVal))) (idx i64)] (-> (slice u8))
  (match (cv-get args idx)
    (None [] "")
    (Some [v]
          (if (not (is-ccode v))
              ""
              (let [node (ccode-of v)
                    tg (sx-tag node)]
                (if (and (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
                         (and (>= (sx-len (sx-items node)) (primitive/cast i64 1))
                              (= (sx-tag (sx-at (sx-items node) 0)) (primitive/cast i64 2))))
                    (sx-sval (sx-at (sx-items node) 0))
                    (if (= tg (primitive/cast i64 2)) (sx-sval node) "")))))))

;; `(primitive/code-deriver TRAIT TYPE)` — the registered deriver for TRAIT,
;; already chosen for TYPE's shape.
;;
;; Taking the TYPE as well as the trait is what keeps `code-struct?`/`code-sum?`
;; out of the language: the compiler already knows which shape `TYPE` is, so the
;; arm choice and the diagnostic for a missing arm both live here, in one place,
;; instead of being re-derived by every `derive` implementation.
(defn cop-deriver [(args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))
        trait (refl-type-name-at args 0)
        tname (refl-type-name-at args 1)]
    (if (or (= trait "") (= tname ""))
        (Err [CtVal Diag] (derr "code-deriver: expects (primitive/code-deriver TRAIT TYPE) with two type symbols"))
        (let [ent (derive-reg-find trait)]
          (if (= (primitive/cast i64 ent) (primitive/cast i64 0))
              (Err [CtVal Diag]
                   (derr (sconcat3 a
                                   "derive: no deriver is registered for trait '"
                                   trait
                                   "' — declare one with (defderive …), and check that the module declaring it is imported here")))
              (let [fsp (primitive/alloc-stack FindS)
                    fup (primitive/alloc-stack FindSum)]
                (set! fsp (find-struct-flex cx tname))
                (set! fup (find-sum-flex cx tname))
                (cond (= (load (field fsp status)) (primitive/cast i64 0))
                        (if (= (load (field ent arm_struct)) "")
                            (Err [CtVal Diag]
                                 (derr (sconcat3 a
                                                 "derive: trait '"
                                                 trait
                                                 "' has no deriver for structs (its registration declares no `struct` arm); write the impl by hand")))
                            (Ok [CtVal Diag] (CCode (sx-sym (load (field ent arm_struct))))))
                      (= (load (field fup status)) (primitive/cast i64 0))
                        (if (= (load (field ent arm_sum)) "")
                            (Err [CtVal Diag]
                                 (derr (sconcat3 a
                                                 "derive: trait '"
                                                 trait
                                                 "' has no deriver for sums (its registration declares no `sum` arm); write the impl by hand")))
                            (Ok [CtVal Diag] (CCode (sx-sym (load (field ent arm_sum))))))
                      :else
                        (Err [CtVal Diag]
                             (derr (sconcat3 a "derive: '" tname "' is neither a struct nor a sum"))))))))))

; arg0 of a reflection op: a bare type symbol `Node` OR an instantiation `(Gen A B)`.
; Returns the base name; fills `targs` with the type-argument forms (empty if none).
(defn refl-type-inst [(args (ptr (ArrayList CtVal))) (targs (ptr (ArrayList Sexp)))] (-> (slice u8))
  (match (cv-get args 0)
    (None [] "")
    (Some [v]
          (if (not (is-ccode v))
              ""
              (let [node (ccode-of v)
                    tg (sx-tag node)]
                (if (and (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))
                         (and (>= (sx-len (sx-items node)) (primitive/cast i64 1))
                              (= (sx-tag (sx-at (sx-items node) 0)) (primitive/cast i64 2))))
                    (let [items (sx-items node)
                          n (sx-len items)
                          (mut i) 1]
                      (loop (if (>= (load i) n)
                                (break)
                                (do
                                  (al-push! [Sexp] targs (sx-at items (load i)))
                                  (set! i (primitive/iadd (load i) 1)))))
                      (sx-sval (sx-at items 0)))
                    (if (= tg (primitive/cast i64 2)) (sx-sval node) "")))))))
(defn cop-field [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))
        targs (box-al [Sexp] a (al-new [Sexp] a))
        tname (refl-type-inst args targs)]
    (if (= tname "")
        (Err [CtVal Diag] (derr "comptime: code-field-* expects a type symbol or instantiation (Gen …)"))
        (let [fsp (primitive/alloc-stack FindS)]
          (set! fsp (find-struct-flex cx tname))
          (if (= (.status fsp) (primitive/cast i64 1))
              (Err [CtVal Diag]
                   (derr (sconcat3 a
                                   "comptime: '"
                                   tname
                                   "' is not a struct (primitive/field reflection needs a struct; sums unsupported)")))
              (if (= (.status fsp) (primitive/cast i64 2))
                  (Err [CtVal Diag]
                       (derr (sconcat3 a
                                       "comptime: ambiguous type '"
                                       tname
                                       "' — multiple modules define it; field reflection can't disambiguate (qualify the type)")))
                  (let [sd (load (field fsp p))]
                    (if (= op (primitive/cast i64 14))
                        (Ok [CtVal Diag] (CInt (al-len [Field] (load (field sd fields)))))
                        (match (cv-get args 1)
                          (None [] (Err [CtVal Diag] (derr "comptime: code-field-* index must be an integer")))
                          (Some [iv]
                                (if (!= (ct-tag iv) (primitive/cast i64 0))
                                    (Err [CtVal Diag] (derr "comptime: code-field-* index must be an integer"))
                                    (let [i (cint-of iv)
                                          flds (load (field sd fields))
                                          nf (al-len [Field] (load flds))]
                                      (if (or (< i (primitive/cast i64 0)) (>= i nf))
                                          (Err [CtVal Diag]
                                               (derr (sconcat3 a
                                                               "comptime: field index "
                                                               (dec->str a i)
                                                               " out of range")))
                                          (let [fp (al-elem [Field] flds i)
                                                fname (.name fp)
                                                ftyp (field fp ty)
                                                hasargs (> (al-len [Sexp] (load targs)) (primitive/cast i64 0))]
                                            (cond (= op (primitive/cast i64 15))
                                                    (Ok [CtVal Diag] (CCode (sx-sym fname)))
                                                  (= op (primitive/cast i64 16))  ; kind: substituted when an instantiation was given, else EXACTLY as before
                                                    (if (not hasargs)
                                                        (Ok [CtVal Diag]
                                                            (CInt (type-kind-tag (load ftyp) cx)))
                                                        (match (parse-type a
                                                                           (subst-type-code (type->code ftyp)
                                                                                            (load (field sd
                                                                                                         type_params))
                                                                                            targs))
                                                          (Ok [st] (Ok [CtVal Diag] (CInt (type-kind-tag st cx))))
                                                          (Err [d]
                                                               (Ok [CtVal Diag]
                                                                   (CInt (type-kind-tag (load ftyp) cx))))))
                                                  ; type: structured & substituted for a generic instantiation,
                                                  ; else the historical bare-name symbol (byte-identical to before)
                                                  hasargs
                                                    (Ok [CtVal Diag]
                                                        (CCode (subst-type-code (type->code ftyp)
                                                                                (load (field sd type_params))
                                                                                targs)))
                                                  :else
                                                    (if (= op (primitive/cast i64 50))
                                                        (Ok [CtVal Diag] (CCode (sx-sym (qual-type-name-str a ftyp))))
                                                        (Ok [CtVal Diag] (CCode (sx-sym (type-name-str a ftyp))))))))))))))))))))
; The bare variant name, stripped of EITHER qualifier form. `after-last-dot` handles
; the fully-qualified `coil.socket.Closed`, but a variant reached through an alias
; import is written `socket/Closed`, and a slash is just as much a qualifier. Without
; this, a reflected variant name spelled `socket/Closed` failed with "'socket/Closed'
; is not a known variant" while the very same spelling worked in a plain `match` —
; reflection was the only part of the language that could not read an alias-qualified
; name.
(defn after-last-qualifier [(s (slice u8))] (-> (slice u8))
  (let [t (after-last-dot s)
        n (slice-len [u8] t)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get t (load i))) (primitive/cast i64 47))
                  (store! at (load i))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (if (< (load at) (primitive/cast i64 0)) t (subslice [u8] t (primitive/iadd (load at) 1) n))))

(defn cop-variant [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))
        arg (code-symname args)]
    (if (= arg "")
        (Err [CtVal Diag] (derr "comptime: code-variant-* expects a symbol"))
        (if (= op (primitive/cast i64 18))
            (let [vsp (primitive/alloc-stack FindVS)]
              (set! vsp (find-variant-sum cx (after-last-qualifier arg)))
              (if (= (.status vsp) (primitive/cast i64 1))
                  (Err [CtVal Diag] (derr (sconcat3 a "comptime: '" arg "' is not a known variant")))
                  (if (= (.status vsp) (primitive/cast i64 2))
                      (Err [CtVal Diag]
                           (derr (sconcat3 a
                                           "comptime: ambiguous variant '"
                                           arg
                                           "' — declared in multiple sums; reflection can't disambiguate")))
                      (Ok [CtVal Diag] (CCode (sx-sym (.name vsp)))))))
            (let [fsp (primitive/alloc-stack FindSum)]
              (set! fsp (find-sum-flex cx arg))
              (if (= (.status fsp) (primitive/cast i64 1))
                  (Err [CtVal Diag] (derr (sconcat3 a "comptime: '" arg "' is not a known sum")))
                  (if (= (.status fsp) (primitive/cast i64 2))
                      (Err [CtVal Diag]
                           (derr (sconcat3 a
                                           "comptime: ambiguous sum '"
                                           arg
                                           "' — multiple modules define it; reflection can't disambiguate (qualify it)")))
                      (let [sd (load (field fsp p))]
                        (if (= op (primitive/cast i64 19))
                            (Ok [CtVal Diag] (CInt (al-len [Variant] (load (field sd variants)))))
                            (match (cv-get args 1)
                              (None [] (Err [CtVal Diag] (derr "comptime: code-variant-* index must be an integer")))
                              (Some [iv]
                                    (if (!= (ct-tag iv) (primitive/cast i64 0))
                                        (Err [CtVal Diag] (derr "comptime: code-variant-* index must be an integer"))
                                        (let [i (cint-of iv)
                                              vs (load (field sd variants))
                                              nv (al-len [Variant] (load vs))]
                                          (if (or (< i (primitive/cast i64 0)) (>= i nv))
                                              (Err [CtVal Diag]
                                                   (derr (sconcat3 a
                                                                   "comptime: variant index "
                                                                   (dec->str a i)
                                                                   " out of range")))
                                              (let [vp (al-elem [Variant] vs i)]
                                                (cond (= op (primitive/cast i64 20))
                                                        (Ok [CtVal Diag]
                                                            (CCode (sx-sym (after-last-dot (load (field vp name))))))
                                                      ; 49: the name as STORED — fully
                                                      ; qualified, so generated code
                                                      ; resolves under any import style
                                                      (= op (primitive/cast i64 49))
                                                        (Ok [CtVal Diag] (CCode (sx-sym (load (field vp name)))))
                                                      (= op (primitive/cast i64 21))
                                                        (Ok [CtVal Diag]
                                                            (CInt (al-len [Field]
                                                                          (load (field vp fields)))))
                                                      ; ops 47/48: a third argument selects the payload field
                                                      :else
                                                        (match (cv-get args 2)
                                                          (None []
                                                                (Err [CtVal Diag]
                                                                     (derr "comptime: code-variant-field-* takes (SUM VARIANT-INDEX FIELD-INDEX)")))
                                                          (Some [fv]
                                                                (if (!= (ct-tag fv) (primitive/cast i64 0))
                                                                    (Err [CtVal Diag]
                                                                         (derr "comptime: code-variant-field-* field index must be an integer"))
                                                                    (let [fi (cint-of fv)
                                                                          fs (load (field vp fields))
                                                                          nf (al-len [Field] (load fs))]
                                                                      (if (or (< fi (primitive/cast i64 0)) (>= fi nf))
                                                                          (Err [CtVal Diag]
                                                                               (derr (sconcat3 a
                                                                                               "comptime: variant field index "
                                                                                               (dec->str a fi)
                                                                                               " out of range")))
                                                                          (let [fp (al-elem [Field] fs fi)]
                                                                            (if (= op (primitive/cast i64 47))
                                                                                (Ok [CtVal Diag]
                                                                                    (CCode (sx-sym (load (field fp name)))))
                                                                                ; 48: the STRUCTURED type ((Option (slice u8)), not a bare head)
                                                                                (Ok [CtVal Diag]
                                                                                    (CCode (type->code (field fp ty)))))))))))))))))))))))))))
(defn cop-trait [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))
        tname (code-symname args)]
    (if (= tname "")
        (Err [CtVal Diag] (derr "comptime: code-trait-* expects a trait symbol"))
        (let [ftp (primitive/alloc-stack FindTr)]
          (set! ftp (find-trait-flex cx tname))
          (if (= (.status ftp) (primitive/cast i64 1))
              (Err [CtVal Diag] (derr (sconcat3 a "comptime: '" tname "' is not a known trait")))
              (if (= (.status ftp) (primitive/cast i64 2))
                  (Err [CtVal Diag]
                       (derr (sconcat3 a
                                       "comptime: ambiguous trait '"
                                       tname
                                       "' — multiple modules define it; reflection can't disambiguate (qualify it)")))
                  (let [td (load (field ftp p))]
                    (if (= op (primitive/cast i64 22))
                        (Ok [CtVal Diag] (CInt (al-len [TraitMethod] (load (field td methods)))))
                        (match (cv-get args 1)
                          (None [] (Err [CtVal Diag] (derr "comptime: code-trait-* method index must be an integer")))
                          (Some [mv]
                                (if (!= (ct-tag mv) (primitive/cast i64 0))
                                    (Err [CtVal Diag] (derr "comptime: code-trait-* method index must be an integer"))
                                    (let [mi (cint-of mv)
                                          ms (load (field td methods))
                                          nm (al-len [TraitMethod] (load ms))]
                                      (if (or (< mi (primitive/cast i64 0)) (>= mi nm))
                                          (Err [CtVal Diag]
                                               (derr (sconcat3 a
                                                               "comptime: trait method index "
                                                               (dec->str a mi)
                                                               " out of range")))
                                          (let [m (al-elem [TraitMethod] ms mi)]
                                            (cop-trait-method op args m cx)))))))))))))))
(defn cop-trait-method [(op i64) (args (ptr (ArrayList CtVal))) (m (ptr TraitMethod)) (cx (ptr CtCtx))] (-> (Result CtVal
                                                                                                                    Diag))
  (let [a (load (field cx a))]
    (cond (= op (primitive/cast i64 23)) (Ok [CtVal Diag] (CCode (sx-sym (load (field m name)))))
          (= op (primitive/cast i64 24)) (Ok [CtVal Diag] (CInt (al-len [Param] (load (field m params)))))
          (= op (primitive/cast i64 27)) (Ok [CtVal Diag] (CCode (type->code (field m ret))))
          :else
            (match (cv-get args 2)
              (None []
                    (Err [CtVal Diag] (derr "comptime: code-trait-param-* needs a method index and a param index")))
              (Some [pv]
                    (if (!= (ct-tag pv) (primitive/cast i64 0))
                        (Err [CtVal Diag]
                             (derr "comptime: code-trait-param-* needs a method index and a param index"))
                        (let [pj (cint-of pv)
                              ps (load (field m params))
                              np (al-len [Param] (load ps))]
                          (if (or (< pj (primitive/cast i64 0)) (>= pj np))
                              (Err [CtVal Diag]
                                   (derr (sconcat3 a "comptime: trait param index " (dec->str a pj) " out of range")))
                              (let [p (al-elem [Param] ps pj)]
                                (if (= op (primitive/cast i64 25))
                                    (Ok [CtVal Diag] (CCode (sx-sym (load (field p name)))))
                                    (Ok [CtVal Diag] (CCode (type->code (field p ty))))))))))))))
(defn cop-strbytes [(args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))]
    (match (cv-get args 0)
      (None [] (Err [CtVal Diag] (derr "comptime: str-bytes expects a string")))
      (Some [v]
            (let [ok (or (is-cstr v) (and (is-ccode v) (= (sx-tag (ccode-of v)) (primitive/cast i64 4))))]
              (if (not ok)
                  (Err [CtVal Diag] (derr "comptime: str-bytes expects a string"))
                  (let [s (if (is-cstr v) (cstr-of v) (sx-sval (ccode-of v)))
                        n (slice-len s)
                        (mut xs) (al-new [Sexp] a)
                        (mut i) 0]
                    (loop (if (>= (load i) n)
                              (break)
                              (do
                                (al-push! (mut xs) (sx-mkint (primitive/cast i64 (slice-get s (load i)))))
                                (set! i (primitive/iadd (load i) 1)))))
                    (Ok [CtVal Diag] (CCode (sx-mklist (box-al [Sexp] a (load xs))))))))))))
(defn cop-bytestostr [(args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))]
    (match (cv-get args 0)
      (None [] (Err [CtVal Diag] (derr "comptime: bytes->str expects a list")))
      (Some [v]
            (let [islist
                    (and (is-ccode v)
                         (let [tg (sx-tag (ccode-of v))]
                           (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 7)))))]
              (if (not islist)
                  (Err [CtVal Diag] (derr "comptime: bytes->str expects a list"))
                  (let [items (sx-items (ccode-of v))
                        n (sx-len items)
                        (mut buf) (al-new [u8] a)
                        (mut errf) (None [Diag])
                        (mut i) 0]
                    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
                              (break)
                              (do
                                (let [it (sx-at items (load i))]
                                  (if (= (sx-tag it) (primitive/cast i64 0))
                                      (do (al-push! (mut buf) (primitive/cast u8 (sx-ival it))) 0)
                                      (do
                                        (set! errf (Some (derr "comptime: bytes->str list must be all ints")))
                                        0)))
                                (set! i (primitive/iadd (load i) 1)))))
                    (match (load errf)
                      (Some [d] (Err [CtVal Diag] d))
                      (None [] (Ok [CtVal Diag] (CCode (sx-mkstr (al-slice [u8] (load buf))))))))))))))
; op 38 — int->str: an integer (or int Code) to its decimal (slice u8), so name
; generation from a counter/index is a one-liner instead of round-tripping bytes->str.
(defn cop-inttostr [(args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))]
    (match (cv-get args 0)
      (None [] (Err [CtVal Diag] (derr "comptime: int->str expects an integer")))
      (Some [v]
            (if (= (ct-tag v) (primitive/cast i64 0))
                (Ok [CtVal Diag] (CStr (i64->str a (cint-of v))))
                (if (and (is-ccode v) (= (sx-tag (ccode-of v)) (primitive/cast i64 0)))
                    (Ok [CtVal Diag] (CStr (i64->str a (sx-ival (ccode-of v)))))
                    (Err [CtVal Diag] (derr "comptime: int->str expects an integer"))))))))

; ---- KView node accessors (docs/design/META_MEMORY.md phase 5) ----------------
; The ONLY code allowed inside a KView. A view is an O(1) window into another
; list's items (what code-rest/code-slice return); sx-info deliberately reports
; it with NULL items so compiler-plane code cannot silently read the parent at
; the wrong offset. Everything at the code-op layer reads through these instead,
; and promotion at the expansion boundary flattens views back to KList.
(defstruct ViewInfo [(items (ptr (ArrayList Sexp))) (off i64) (len i64)])
(defn code-node-parts [(s Sexp)] (-> ViewInfo)
  (let [p (primitive/alloc-stack ViewInfo)
        sp (primitive/alloc-stack Sexp)]
    (set! sp s)
    (set! (.items p) (primitive/cast (ptr (ArrayList Sexp)) 0))
    (set! (.off p) 0)
    (set! (.len p) 0)
    (match (.kind sp)
      (KView [it off len]
             (do (set! (.items p) it)
                 (set! (.off p) off)
                 (set! (.len p) len)
                 0))
      (KList [it]
             (do (set! (.items p) it)
                 (set! (.len p) (sx-len it))
                 0))
      (KVec [it]
            (do (set! (.items p) it)
                (set! (.len p) (sx-len it))
                0))
      (_ 0))
    (load p)))
(defn code-node-listish? [(s Sexp)] (-> bool)
  (let [tg (sx-tag s)]
    (or (= tg (primitive/cast i64 6))
        (or (= tg (primitive/cast i64 7)) (= tg (primitive/cast i64 8))))))
(defn code-node-len [(s Sexp)] (-> i64)
  (let [p (primitive/alloc-stack ViewInfo)]
    (set! p (code-node-parts s))
    (.len p)))
;; caller bounds-checks against code-node-len
(defn code-node-at [(s Sexp) (i i64)] (-> Sexp)
  (let [p (primitive/alloc-stack ViewInfo)]
    (set! p (code-node-parts s))
    (sx-at (load (field p items)) (primitive/iadd (.off p) i))))
;; an O(1) sub-window [lo, hi) of a listish node; composes so a view of a view
;; stays one level deep. Result is list-typed (as code-rest always was, even of
;; a vector).
(defn code-node-window [(s Sexp) (lo i64) (hi i64)] (-> Sexp)
  (let [p (primitive/alloc-stack ViewInfo)
        sp (primitive/alloc-stack Sexp)]
    (set! p (code-node-parts s))
    (set! sp s)
    (mk-sexp-src (KView :items
                        (load (field p items))
                        :off
                        (primitive/iadd (.off p) lo)
                        :len
                        (primitive/isub hi lo))
                 sp)))
;; view-aware structural equality: a view compares as the list it denotes
(defn sexp-eq-nodes [(x Sexp) (y Sexp)] (-> bool)
  (let [n (code-node-len x)]
    (if (!= n (code-node-len y))
        false
        (let [(mut i) 0
              (mut r) true]
          (loop (if (>= (load i) n)
                    (break)
                    (if (sexp-eq (code-node-at x (load i)) (code-node-at y (load i)))
                        (set! i (primitive/iadd (load i) 1))
                        (do (set! r false) (break)))))
          (load r)))))

(defn cop-codearg [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (load (field cx a))]
    (match (cv-get args 0)
      (None [] (Err [CtVal Diag] (derr "comptime: code op expects a Code value")))
      (Some [v0]
            (if (not (is-ccode v0))
                (Err [CtVal Diag] (derr "comptime: code op expects a Code value"))
                (let [code (ccode-of v0)
                      tg (sx-tag code)]
                  (cond (= op (primitive/cast i64 0))
                          (Ok [CtVal Diag] (CBool (code-node-listish? code)))
                        (= op (primitive/cast i64 1)) (Ok [CtVal Diag] (CBool (= tg (primitive/cast i64 2))))
                        (= op (primitive/cast i64 2)) (Ok [CtVal Diag] (CBool (= tg (primitive/cast i64 0))))
                        (= op (primitive/cast i64 11)) (Ok [CtVal Diag] (CBool (= tg (primitive/cast i64 3))))
                        (= op (primitive/cast i64 54)) (Ok [CtVal Diag] (CBool (= tg (primitive/cast i64 7))))
                        (= op (primitive/cast i64 55)) (Ok [CtVal Diag] (CBool (= tg (primitive/cast i64 1))))
                        (= op (primitive/cast i64 73)) (Ok [CtVal Diag] (CBool (= tg (primitive/cast i64 4))))
                        (= op (primitive/cast i64 56))
                          (if (= tg (primitive/cast i64 1))
                              (Ok [CtVal Diag] (CInt (sx-ival code)))
                              (Err [CtVal Diag] (derr "comptime: code-float-bits expects a float literal")))
                        (= op (primitive/cast i64 3))
                          (if (code-node-listish? code)
                              (Ok [CtVal Diag] (CInt (code-node-len code)))
                              (Err [CtVal Diag] (derr (ct-in-meta a "comptime: code-count expects a list/vector"))))
                        (= op (primitive/cast i64 5))
                          (if (= tg (primitive/cast i64 2))
                              (Ok [CtVal Diag] (CStr (sx-sval code)))
                              (Err [CtVal Diag] (derr "comptime: code-sym expects a symbol")))
                        (= op (primitive/cast i64 6))
                          (if (= tg (primitive/cast i64 0))
                              (Ok [CtVal Diag] (CInt (sx-ival code)))
                              (Err [CtVal Diag] (derr "comptime: code-int expects an integer")))
                        (= op (primitive/cast i64 7))
                          ; O(1) VIEW of the tail, not a copy — cdr-recursion over
                          ; an n-form list used to allocate n²/2 nodes this way
                          ; (docs/design/META_MEMORY.md phase 5)
                          (if (code-node-listish? code)
                              (let [n (code-node-len code)]
                                (Ok [CtVal Diag]
                                    (CCode (code-node-window code
                                                             (if (> n (primitive/cast i64 0)) 1 0)
                                                             n))))
                              (Err [CtVal Diag] (derr "comptime: code-rest expects a list")))
                        (= op (primitive/cast i64 4))
                          (match (cv-get args 1)
                            (None []
                                  (Err [CtVal Diag]
                                       (derr "comptime: code-nth index must be an integer")))
                            (Some [iv]
                                  (if (!= (ct-tag iv) (primitive/cast i64 0))
                                      (Err [CtVal Diag]
                                           (derr "comptime: code-nth index must be an integer"))
                                      (if (code-node-listish? code)
                                          (let [i (cint-of iv)]
                                            (if (or (< i (primitive/cast i64 0))
                                                    (>= i (code-node-len code)))
                                                (Err [CtVal Diag]
                                                     (derr (sconcat3 a
                                                                     "comptime: code-nth index "
                                                                     (dec->str a i)
                                                                     " out of range")))
                                                (Ok [CtVal Diag] (CCode (code-node-at code i)))))
                                          (Err [CtVal Diag]
                                               (derr (ct-in-meta a "comptime: code-nth expects a list/vector")))))))
                        :else
                          (match (cv-get args 1)
                            (None []
                                  (Err [CtVal Diag]
                                       (derr "comptime: code-eq expects two Code values")))
                            (Some [v1]
                                  (if (not (is-ccode v1))
                                      (Err [CtVal Diag]
                                           (derr "comptime: code-eq expects two Code values"))
                                      (Ok [CtVal Diag] (CBool (sexp-eq code (ccode-of v1))))))))))))))
;; Compilation-scoped opaque Code handles (ops 71/72). Native phase programs —
;; staged-metacompilation entries such as compiled Scheme transformers — need to
;; retain exact syntax nodes inside their own tagged data structures, but Code
;; intentionally has no runtime representation. A checked table index crosses
;; that boundary without exposing an arena pointer or letting an arbitrary
;; integer become one. The boxed node lives in the INVOCATION's allocator, so a
;; handle is valid for the expansion that made it — keeping one across
;; invocations is the same use-after-reset any borrowed Code suffers, and
;; COIL_META_ARENA=poison makes it loud.
(defn code-opaque-items [] (-> (ptr (array i64 1048576)))
  (primitive/alloc-static (array i64 1048576)))
(defn code-opaque-count [] (-> (ptr i64))
  (primitive/alloc-static i64))
(defn code-opaque-add [(a (dyn Allocator)) (code Sexp)] (-> i64)
  (let [i (load (code-opaque-count))]
    (if (>= i (primitive/cast i64 1048576))
        0
        (do
          (store! (primitive/index (code-opaque-items) i)
                  (primitive/cast i64 (box-sexp a code)))
          (store! (code-opaque-count) (+ i 1))
          (+ i 1)))))
(defn code-opaque-get [(handle i64)] (-> (ptr Sexp))
  (let [i (- handle 1)
        n (load (code-opaque-count))]
    (if (or (< i 0) (>= i n))
        (primitive/cast (ptr Sexp) 0)
        (primitive/cast (ptr Sexp) (load (primitive/index (code-opaque-items) i))))))

(defn code-op [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  ; The structural ops a metaprogram actually spends its life on — code-list? (0),
  ; code-sym? (1), code-int? (2), code-count (3), code-nth (4), code-sym (5),
  ; code-int (6), code-rest (7), code-keyword? (11) — are handled by cop-codearg,
  ; which is this chain's FALLTHROUGH. Without this guard they pay every icmp below
  ; before reaching it. None of them is matched by any test in the chain, so routing
  ; them straight there is exactly the same dispatch, minus the search.
  (if (or (<= op (primitive/cast i64 7))
          (or (= op (primitive/cast i64 11))
              (or (= op (primitive/cast i64 54))
                  (or (= op (primitive/cast i64 55))
                      (or (= op (primitive/cast i64 56)) (= op (primitive/cast i64 73)))))))
      (cop-codearg op args cx)
      (let [a (load (field cx a))]
        (cond (= op (primitive/cast i64 60))
                (if (= (al-len [CtVal] (load args)) (primitive/cast i64 0))
                    (Ok [CtVal Diag]
                        (CCode (sx-mklist (box-al [Sexp] a (al-new [Sexp] a)))))
                    (Err [CtVal Diag]
                         (derr "code-list-new: expects no arguments")))
              (= op (primitive/cast i64 61))
                (match (cv-get args 0)
                  (Some [lv]
                    (match (cv-get args 1)
                      (Some [vv]
                        (if (and (is-ccode lv) (is-ccode vv))
                            (let [list (ccode-of lv)]
                              (if (= (sx-tag list) (primitive/cast i64 6))
                                  (do
                                    (al-push! [Sexp] (sx-items list) (ccode-of vv))
                                    (Ok [CtVal Diag] (CCode list)))
                                  (Err [CtVal Diag]
                                       (derr "code-list-push!: first argument must be a Code list"))))
                            (Err [CtVal Diag]
                                 (derr "code-list-push!: expects two Code values"))))
                      (None [] (Err [CtVal Diag]
                                    (derr "code-list-push!: expects two arguments")))))
                  (None [] (Err [CtVal Diag]
                                (derr "code-list-push!: expects two arguments"))))
              ; op 62 code-list-done — freeze a builder into Code. Identity at
              ; runtime (same node); the TCodeBuilder/TCode split in the checker
              ; is the point (docs/design/META_MEMORY.md phase 4).
              (= op (primitive/cast i64 62))
                (match (cv-get args 0)
                  (Some [lv]
                    (if (is-ccode lv)
                        (Ok [CtVal Diag] (CCode (ccode-of lv)))
                        (Err [CtVal Diag] (derr "code-list-done: expects a Code builder"))))
                  (None [] (Err [CtVal Diag] (derr "code-list-done: expects one argument"))))
              ; op 63 code-slice — O(1) view of [lo, hi) of a list/vector
              ; (docs/design/META_MEMORY.md phase 5)
              (= op (primitive/cast i64 63))
                (match (cv-get args 0)
                  (Some [cv]
                    (match (cv-get args 1)
                      (Some [lov]
                        (match (cv-get args 2)
                          (Some [hiv]
                            (if (and (is-ccode cv)
                                     (and (= (ct-tag lov) (primitive/cast i64 0))
                                          (= (ct-tag hiv) (primitive/cast i64 0))))
                                (let [code (ccode-of cv)
                                      lo (cint-of lov)
                                      hi (cint-of hiv)]
                                  (if (not (code-node-listish? code))
                                      (Err [CtVal Diag] (derr "code-slice: expects a list/vector"))
                                      (if (or (< lo (primitive/cast i64 0))
                                              (or (> hi (code-node-len code)) (> lo hi)))
                                          (Err [CtVal Diag] (derr "code-slice: bounds out of range"))
                                          (Ok [CtVal Diag] (CCode (code-node-window code lo hi))))))
                                (Err [CtVal Diag] (derr "code-slice: expects (primitive/code-slice CODE LO HI)"))))
                          (None [] (Err [CtVal Diag] (derr "code-slice: expects (primitive/code-slice CODE LO HI)")))))
                      (None [] (Err [CtVal Diag] (derr "code-slice: expects (primitive/code-slice CODE LO HI)")))))
                  (None [] (Err [CtVal Diag] (derr "code-slice: expects (primitive/code-slice CODE LO HI)"))))
              ; op 64 code-copy — THE deep copy, named as one: fresh structure and
              ; string payloads in the engine allocator, views flattened
              (= op (primitive/cast i64 64))
                (match (cv-get args 0)
                  (Some [cv]
                    (if (is-ccode cv)
                        (let [sp (primitive/alloc-stack Sexp)]
                          (store! sp (ccode-of cv))
                          (Ok [CtVal Diag] (CCode (sexp-own-into a sp))))
                        (Err [CtVal Diag] (derr "code-copy: expects a Code value"))))
                  (None [] (Err [CtVal Diag] (derr "code-copy: expects one Code argument"))))
              ; op 65 code-concat — explicit O(n+m) build of a fresh list from two
              ; listish values (elements shared, like every list constructor)
              (= op (primitive/cast i64 65))
                (match (cv-get args 0)
                  (Some [xv]
                    (match (cv-get args 1)
                      (Some [yv]
                        (if (and (is-ccode xv) (is-ccode yv))
                            (let [cx2 (ccode-of xv)
                                  cy (ccode-of yv)]
                              (if (not (and (code-node-listish? cx2) (code-node-listish? cy)))
                                  (Err [CtVal Diag] (derr "code-concat: expects two lists/vectors"))
                                  (let [(mut xs) (al-new [Sexp] a)
                                        nx (code-node-len cx2)
                                        ny (code-node-len cy)
                                        (mut i) 0
                                        (mut j) 0]
                                    (loop (if (>= (load i) nx)
                                              (break)
                                              (do (al-push! (mut xs) (code-node-at cx2 (load i)))
                                                  (store! i (primitive/iadd (load i) 1)))))
                                    (loop (if (>= (load j) ny)
                                              (break)
                                              (do (al-push! (mut xs) (code-node-at cy (load j)))
                                                  (store! j (primitive/iadd (load j) 1)))))
                                    (Ok [CtVal Diag] (CCode (sx-mklist (box-al [Sexp] a (load xs))))))))
                            (Err [CtVal Diag] (derr "code-concat: expects two Code values"))))
                      (None [] (Err [CtVal Diag] (derr "code-concat: expects two Code arguments")))))
                  (None [] (Err [CtVal Diag] (derr "code-concat: expects two Code arguments"))))
              ; op 74 code-list-like — replace children but retain the original
              ; container's source/hygiene context. This is the declaration-safe
              ; counterpart to constructing a fresh list.
              (= op (primitive/cast i64 74))
                (match (cv-get args 0)
                  (Some [pv]
                    (match (cv-get args 1)
                      (Some [iv]
                        (if (and (is-ccode pv) (is-ccode iv))
                            (let [proto (ccode-of pv)
                                  items (ccode-of iv)]
                              (if (not (and (code-node-listish? proto)
                                            (code-node-listish? items)))
                                  (Err [CtVal Diag]
                                       (derr "code-list-like: expects two lists/vectors"))
                                  (let [pp (box-sexp a proto)]
                                    (Ok [CtVal Diag]
                                        (CCode
                                          (mk-sexp-src
                                            (if (= (sx-tag items) (primitive/cast i64 7))
                                                (KVec (sx-items items))
                                                (KList (sx-items items)))
                                            pp))))))
                            (Err [CtVal Diag]
                                 (derr "code-list-like: expects two Code values"))))
                      (None []
                            (Err [CtVal Diag]
                                 (derr "code-list-like: expects two Code arguments")))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-list-like: expects two Code arguments"))))
              ; op 71 code-opaque — Code -> compilation-scoped i64 handle
              (= op (primitive/cast i64 71))
                (match (cv-get args 0)
                  (Some [cv]
                    (if (is-ccode cv)
                        (let [handle (code-opaque-add a (ccode-of cv))]
                          (if (= handle (primitive/cast i64 0))
                              (Err [CtVal Diag]
                                   (derr "code-opaque: compilation handle table exhausted"))
                              (Ok [CtVal Diag] (CInt handle))))
                        (Err [CtVal Diag] (derr "code-opaque: expects a Code value"))))
                  (None [] (Err [CtVal Diag] (derr "code-opaque: expects one Code argument"))))
              ; op 72 code-from-opaque — handle -> the exact Code node it named
              (= op (primitive/cast i64 72))
                (match (cv-get args 0)
                  (Some [v]
                    (if (= (ct-tag v) (primitive/cast i64 0))
                        (let [node (code-opaque-get (cint-of v))]
                          (if (= (primitive/cast i64 node) (primitive/cast i64 0))
                              (Err [CtVal Diag]
                                   (derr "code-from-opaque: invalid or expired Code handle"))
                              (Ok [CtVal Diag] (CCode (load node)))))
                        (Err [CtVal Diag] (derr "code-from-opaque: expects an opaque Code handle"))))
                  (None [] (Err [CtVal Diag] (derr "code-from-opaque: expects an opaque Code handle"))))
              (= op (primitive/cast i64 59))
                (match (cv-get args 0)
                  (Some [sv]
                    (match (cv-get args 1)
                      (Some [mv]
                        (if (and (or (is-cstr sv)
                                     (and (is-ccode sv)
                                          (= (sx-tag (ccode-of sv)) (primitive/cast i64 4))))
                                 (and (is-ccode mv)
                                      (= (sx-tag (ccode-of mv)) (primitive/cast i64 6))))
                            (let [source (if (is-cstr sv) (cstr-of sv) (sx-sval (ccode-of sv)))
                                  config-form (ccode-of mv)
                                  config-items (sx-items config-form)
                                  config (primitive/alloc-stack ReaderConfig)]
                              (store! config (default-reader-config))
                              (when (and (= (sx-len config-items) 5)
                                         (and (>= (reader-config-char (sx-at config-items 2)) 0)
                                              (>= (reader-config-char (sx-at config-items 4)) 0)))
                                (store! (field config unquote)
                                        (reader-config-char (sx-at config-items 2)))
                                (store! (field config alternate-unquote) -1)
                                (store! (field config unquote-splicing)
                                        (reader-config-char (sx-at config-items 4)))
                                0)
                              (match (read-all-with a source -1 (load config))
                                (Err [d] (Err [CtVal Diag] d))
                                (Ok [forms]
                                  (let [(mut items) (al-new [Sexp] a)]
                                    (al-push! (mut items) (sx-sym "do"))
                                    (for [i 0 (sx-len forms)]
                                      (al-push! (mut items) (sx-at forms i)))
                                    (Ok [CtVal Diag]
                                        (CCode (sx-mklist (box-al [Sexp] a (load items)))))))))
                            (Err [CtVal Diag]
                                 (derr "code-read: expects a string or string Code and reader-config Code"))))
                      (None [] (Err [CtVal Diag]
                                    (derr "code-read: expects a string or string Code and reader-config Code")))))
                  (None [] (Err [CtVal Diag]
                                (derr "code-read: expects a string or string Code and reader-config Code"))))
              (= op (primitive/cast i64 8))
                (let [scope (primitive/iadd (next-gensym) 1)
                      p (primitive/alloc-stack Sexp)]
                  (set! p (sx-sym (sconcat a "$g" (dec->str a scope))))
                  (set! (.hyg p) scope)
                  (set! (.horigin p) 2)
                  ; `gensym` is the anonymous-spelling form of
                  ; fresh-identifier and obeys the same module-neutral rule.
                  (set! (.hmod p) "")
                  (Ok [CtVal Diag] (CCode (load p))))
              (= op (primitive/cast i64 30)) (Ok [CtVal Diag] (CCode (sx-sym (target-arch-str))))
              (= op (primitive/cast i64 46)) (Ok [CtVal Diag] (CCode (sx-sym (target-os-str))))
              (= op (primitive/cast i64 57))
                (match (cv-get args 0)
                  (Some [nv]
                        (match (cv-get args 1)
                          (Some [mv]
                                (if (and (is-ccode nv) (is-ccode mv))
                                    (let [ns (ccode-of nv)
                                          ms (ccode-of mv)]
                                      (if (and (= (sx-tag ns) (primitive/cast i64 2))
                                               (= (sx-tag ms) (primitive/cast i64 2)))
                                          (Ok [CtVal Diag]
                                              (CBool (explicitly-exported? cx (sx-sval ns) (sx-sval ms))))
                                          (Err [CtVal Diag]
                                               (derr "comptime: code-exported? expects name and module symbols"))))
                                    (Err [CtVal Diag]
                                         (derr "comptime: code-exported? expects two Code values"))))
                          (None []
                                (Err [CtVal Diag]
                                     (derr "comptime: code-exported? expects two Code values")))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "comptime: code-exported? expects two Code values"))))
              (= op (primitive/cast i64 39)) (Ok [CtVal Diag] (CBool (debug-checks-on?)))
              (= op (primitive/cast i64 52)) (cop-lint-param args)
              (= op (primitive/cast i64 53))
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag] (CBool (macro-call-lookup (sx-nid (ccode-of nodev)))))
                            (Err [CtVal Diag] (derr "code-macro-call?: expects a Code node"))))
                  (None [] (Err [CtVal Diag] (derr "code-macro-call?: expects a Code node"))))
              (= op (primitive/cast i64 9))
                (match (cv-get args 0)
                  (Some [v]
                        (if (is-cstr v)
                            (Err [CtVal Diag] (derr (cstr-of v)))
                            (Err [CtVal Diag] (derr "error: message must be a string"))))
                  (None [] (Err [CtVal Diag] (derr "error: message must be a string"))))
              (= op (primitive/cast i64 31))
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (match (cv-get args 1)
                              (Some [msgv]
                                    (if (is-cstr msgv)
                                        (let [node (ccode-of nodev)
                                              d (primitive/alloc-stack Diag)]
                                          (store! (field d lo) (sx-lo node))
                                          (store! (field d hi) (sx-hi node))
                                          ; malloc, not `a`: the warn list
                                          ; outlives the expansion arena
                                          (store! (field d msg) (sconcat (malloc-allocator) "error: " (cstr-of msgv)))
                                          (store! (field d source) (sx-source node))
                                          (store! (field d ctxt) 0)
                                          (warn-push (load d))
                                          (diag-err-bump)
                                          (Ok [CtVal Diag] (CInt 0)))
                                        (Err [CtVal Diag] (derr "report: message must be a string"))))
                              (None [] (Err [CtVal Diag] (derr "report: expects (primitive/report NODE MSG)"))))
                            (Err [CtVal Diag] (derr "report: first arg must be a Code node"))))
                  (None [] (Err [CtVal Diag] (derr "report: expects (primitive/report NODE MSG)"))))
              (or (= op (primitive/cast i64 32))
                  (or (= op (primitive/cast i64 44)) (= op (primitive/cast i64 58))))
                (cop-warn-or-suggest a op args)
              (= op (primitive/cast i64 33))
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag] (CStr (code-file-of (ccode-of nodev))))
                            (Err [CtVal Diag] (derr "code-file: expects a Code node"))))
                  (None [] (Err [CtVal Diag] (derr "code-file: expects (primitive/code-file NODE)"))))
              (= op (primitive/cast i64 40))
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag] (CInt (code-line-of (ccode-of nodev))))
                            (Err [CtVal Diag] (derr "code-line: expects a Code node"))))
                  (None [] (Err [CtVal Diag] (derr "code-line: expects (primitive/code-line NODE)"))))
              (= op (primitive/cast i64 41))
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag] (CStr (code-src-of (ccode-of nodev))))
                            (Err [CtVal Diag] (derr "code-src: expects a Code node"))))
                  (None [] (Err [CtVal Diag] (derr "code-src: expects (primitive/code-src NODE)"))))
              (= op (primitive/cast i64 42))
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag] (CInt (code-col-of (ccode-of nodev))))
                            (Err [CtVal Diag] (derr "code-col: expects a Code node"))))
                  (None []
                        (Err [CtVal Diag] (derr "code-col: expects (primitive/code-col NODE)"))))
              (= op (primitive/cast i64 43))
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag] (CStr (code-doc-of (ccode-of nodev))))
                            (Err [CtVal Diag]
                                 (derr "code-doc: expects a Code node"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-doc: expects (primitive/code-doc NODE)"))))
              (or (= op (primitive/cast i64 34)) (= op (primitive/cast i64 45)))
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag]
                                (CBool (if (= op (primitive/cast i64 45))
                                           (!= (sx-ctxt (ccode-of nodev)) (primitive/cast i64 0))
                                           (code-from-user-node? (ccode-of nodev)))))
                            (Err [CtVal Diag]
                                 (derr "code-from-user?: expects a Code node"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-from-user?: expects (primitive/code-from-user? NODE)"))))
              (or (= op (primitive/cast i64 12)) (= op (primitive/cast i64 13))) (cop-concat op args cx)
              (or (= op (primitive/cast i64 66))
                  (or (= op (primitive/cast i64 67))
                      (or (= op (primitive/cast i64 68))
                          (or (= op (primitive/cast i64 69)) (= op (primitive/cast i64 70))))))
                (cop-hygiene op args cx)
              (or (= op (primitive/cast i64 14))
                  (or (= op (primitive/cast i64 15))
                      (or (= op (primitive/cast i64 16))
                          (or (= op (primitive/cast i64 17)) (= op (primitive/cast i64 50))))))
                (cop-field op args cx)
              (or (= op (primitive/cast i64 18))
                  (or (= op (primitive/cast i64 19))
                      (or (= op (primitive/cast i64 20))
                          (or (= op (primitive/cast i64 21))
                              (or (= op (primitive/cast i64 47))
                                  (or (= op (primitive/cast i64 48)) (= op (primitive/cast i64 49))))))))
                (cop-variant op args cx)
              (or (= op (primitive/cast i64 22))
                  (or (= op (primitive/cast i64 23))
                      (or (= op (primitive/cast i64 24))
                          (or (= op (primitive/cast i64 25))
                              (or (= op (primitive/cast i64 26))
                                  (= op (primitive/cast i64 27)))))))
                (cop-trait op args cx)
              (= op (primitive/cast i64 51)) (cop-deriver args cx)
              (= op (primitive/cast i64 28)) (cop-strbytes args cx)
              (= op (primitive/cast i64 29)) (cop-bytestostr args cx)
              (= op (primitive/cast i64 38)) (cop-inttostr args cx)
              (= op (primitive/cast i64 35)) (cop-decl args cx)
              (= op (primitive/cast i64 36)) (cop-type-of args cx)
              (= op (primitive/cast i64 37)) (cop-binding-of args cx)
              :else (cop-codearg op args cx)))))

;; Read the loader's explicit export table during syntax transformation. Missing
;; metadata returns false: this query authorizes a rewrite, so uncertainty must
;; preserve the original identifier for ordinary resolution to diagnose.
(defn explicitly-exported? [(cx (ptr CtCtx)) (name (slice u8)) (m (slice u8))] (-> bool)
  (let [xs (load (field cx qexports))
        n
          (if (= (primitive/cast i64 xs) (primitive/cast i64 0))
              0
              (al-len [ExpEntry] (load xs)))
        (mut i) 0
        (mut result) false]
    (loop (if (>= (load i) n)
              (break)
              (let [e (al-elem [ExpEntry] xs (load i))]
                (when (= (load (field e name)) m)
                  (store! result (set-contains (field e names) name))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load result)))
(defn type-is-code [(t (ptr Type))] (-> bool)
  (match (load t) (TCode [] true) (_ false)))
(defn cc-push! [(out (ptr SBox)) (names (ptr (ArrayList (slice u8)))) (func (slice u8))] (-> i64)
  (when (set-contains names func) (al-push! (mut (field out items)) func) 0))
(defn cc-list [(es (ptr (ArrayList Expr))) (names (ptr (ArrayList (slice u8)))) (out (ptr SBox))] (-> i64)
  (let [n (al-len [Expr] (load es))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (collect-calls (al-elem [Expr] es (load i)) names out)
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn cc-opt [(o (Option (ptr Expr))) (names (ptr (ArrayList (slice u8)))) (out (ptr SBox))] (-> i64)
  (match o (Some [e] (collect-calls e names out)) (None [] 0)))
(defn cc-binds [(bs (ptr (ArrayList Bind))) (names (ptr (ArrayList (slice u8)))) (out (ptr SBox))] (-> i64)
  (let [n (al-len [Bind] (load bs))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (collect-calls (field (al-elem [Bind] bs (load i)) value) names out)
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn cc-arms [(as (ptr (ArrayList Arm))) (names (ptr (ArrayList (slice u8)))) (out (ptr SBox))] (-> i64)
  (let [n (al-len [Arm] (load as))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (collect-calls (field (al-elem [Arm] as (load i)) body) names out)
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn cc-quasi-list [(items (ptr (ArrayList Quasi))) (names (ptr (ArrayList (slice u8)))) (out (ptr SBox))] (-> i64)
  (let [n (al-len [Quasi] (load items))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (cc-quasi (al-elem [Quasi] items (load i)) names out)
                (set! i (primitive/iadd (load i) 1))))))
  0)
(defn cc-quasi [(q (ptr Quasi)) (names (ptr (ArrayList (slice u8)))) (out (ptr SBox))] (-> i64)
  (match (load q)
    (QUnquote [e] (collect-calls e names out))
    (QSplice [e] (collect-calls e names out))
    (QList [items] (cc-quasi-list items names out))
    (QVector [items] (cc-quasi-list items names out))
    (_ 0)))
(defn collect-calls [(e (ptr Expr)) (names (ptr (ArrayList (slice u8)))) (out (ptr SBox))] (-> i64)
  (match (.kind e)
    (ECall [func ta args] (do (cc-push! out names func) (cc-list args names out)))
    ; A function reached ONLY through `fnptr-of` is just as reachable as one that is
    ; called: `malloc-allocator` builds its vtable with (primitive/fnptr-of ma-alloc) and never
    ; calls ma-alloc directly. Missing this leaves the target out of the comptime
    ; sub-program and checking it fails with "fnptr-of unknown function".
    (EFnPtrOf [name] (cc-push! out names name))
    (EBorrow [m place] (collect-calls place names out))
    (ESpillRef [x] (collect-calls x names out))
    (ENot [x] (collect-calls x names out))
    (ELoad [x] (collect-calls x names out))
    (EFree [x] (collect-calls x names out))
    (EComptime [x] (collect-calls x names out))
    (EErase [tn inner] (collect-calls inner names out))
    (EMakeDyn [ds vs ms inner] (collect-calls inner names out))
    (EDynDispatch [ds vs mi cc ps r recv args] (do (collect-calls recv names out) (cc-list args names out)))
    (ECast [ty x] (collect-calls x names out))
    (EAscribe [ty x] (collect-calls x names out))
    (EBin [op l r] (do (collect-calls l names out) (collect-calls r names out)))
    (ECmp [op l r] (do (collect-calls l names out) (collect-calls r names out)))
    (EIf [c t el] (do (collect-calls c names out) (collect-calls t names out) (collect-calls el names out)))
    (EDo [es] (cc-list es names out))
    (ELoop [lbl es] (cc-list es names out))
    (EBreak [lbl v] (cc-opt v names out))
    (ELet [bs body] (do (cc-binds bs names out) (cc-list body names out)))
    (EField [p fn] (collect-calls p names out))
    (EBitGet [p fn] (collect-calls p names out))
    (EStore [p v] (do (collect-calls p names out) (collect-calls v names out)))
    (EIndex [p idx] (do (collect-calls p names out) (collect-calls idx names out)))
    (EBitSet [p fn v] (do (collect-calls p names out) (collect-calls v names out)))
    (EConstruct [sm vr args] (cc-list args names out))
    (ECodeOp [op args] (cc-list args names out))
    ; Generic trait calls are resolved only after closure selection, in mono. Keep
    ; the method head reachable here so closure-impl-wanted? retains the candidate
    ; impl and metalower can give its erased Code receiver a dispatchable name.
    (ETraitCall [tn m stp args] (do (cc-push! out names m) (cc-list args names out)))
    (ELlvmIr [r args body] (cc-list args names out))
    (ECallPtr [fp args] (do (collect-calls fp names out) (cc-list args names out)))
    (EMatch [scrut arms] (do (collect-calls scrut names out) (cc-arms arms names out)))
    (EFieldMeta [meta ty idx] (collect-calls idx names out))
    (EFieldIndex [ty nm] (collect-calls nm names out))
    (EQuasi [q] (let [qp (primitive/alloc-stack Quasi)] (set! qp q) (cc-quasi qp names out)))
    (_ 0)))
(defn prog-fn-names [(p (ptr Program)) (a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [fs (load (field p funcs))
        n (al-len [Func] (load fs))
        (mut out) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (.name (al-elem [Func] fs (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    ; Keep method heads in the call-name universe too. They have no ordinary
    ; Func entry yet, but seeing one in a reachable body tells closure selection
    ; which structural/primitive impl families can actually dispatch.
    (let [is (load (field p impls))
          ni (al-len [ImplDef] (load is))
          (mut ii) 0]
      (loop (if (>= (load ii) ni)
                (break)
                (do
                  (let [ms (load (field (al-elem [ImplDef] is (load ii)) methods))
                        nm (al-len [Func] (load ms))
                        (mut mi) 0]
                    (loop (if (>= (load mi) nm)
                              (break)
                              (do
                                (let [name (.name (al-elem [Func] ms (load mi)))]
                                  (unless (set-contains (mut out) name)
                                    (al-push! (mut out) name)))
                                (set! mi (primitive/iadd (load mi) 1))))))
                  (set! ii (primitive/iadd (load ii) 1))))))
    ; Externs participate in reachability too. Closure sub-programs used to retain
    ; every extern in the application, and the in-memory object builder consequently
    ; emitted every one as an undefined symbol even when the selected macro never
    ; referenced it.
    (let [es (load (field p externs))
          ne (al-len [Extern] (load es))
          (mut ei) 0]
      (loop (if (>= (load ei) ne)
                (break)
                (do
                  (let [name (.name (al-elem [Extern] es (load ei)))]
                    (unless (set-contains (mut out) name)
                      (al-push! (mut out) name)))
                  (set! ei (primitive/iadd (load ei) 1))))))
    (box-al [(slice u8)] a (load out))))
(defn prog-fn-find [(p (ptr Program)) (name (slice u8))] (-> (ptr Func))
  (let [fs (load (field p funcs))
        n (al-len [Func] (load fs))
        (mut i) 0
        (mut r) (primitive/cast (ptr Func) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [Func] fs (load i)) name)) name)
                  (store! r (al-elem [Func] fs (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; A macro-engine closure needs impls owned by modules that are actually in that
; closure, plus structural/primitive impls (whose target has no module). Pulling
; every application impl into every compiler invocation both exposed bodies to a
; pre-expansion scope and defeated dead-code reachability.
(defn closure-module-wanted? [(wanted (ptr (ArrayList (slice u8)))) (m (slice u8))] (-> bool)
  (if (= (slice-len m) (primitive/cast i64 0))
      true
      (let [n (al-len [(slice u8)] (load wanted))
            (mut i) 0
            (mut found) false]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (when (= (qual-module-of (al-get [(slice u8)] (load wanted) (load i))) m)
                      (store! found true)
                      (break))
                    (set! i (primitive/iadd (load i) 1)))))
        (load found))))
(defn closure-impl-wanted? [(a (dyn Allocator)) (wanted (ptr (ArrayList (slice u8)))) (ip (ptr ImplDef))] (-> bool)
  (let [m (qual-module-of (impl-base-name a (field ip self_type)))
        ms (load (field ip methods))
        n (al-len [Func] (load ms))
        (mut i) 0
        (mut called) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (set-contains wanted
                                    (load (field (al-elem [Func] ms (load i)) name)))
                  (store! called true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (and (load called) (closure-module-wanted? wanted m))))
(defn closure-drain! [(p (ptr Program))
                      (names (ptr (ArrayList (slice u8))))
                      (stackb (ptr SBox))
                      (wantedb (ptr SBox))] (-> i64)
  (loop (if (= (al-len [(slice u8)] (.items stackb)) (primitive/cast i64 0))
            (break)
            (do
              (let [sl (.items stackb)
                    top (al-len [(slice u8)] sl)
                    nm (al-get [(slice u8)] sl (primitive/isub top 1))]
                (set! (.len (.items stackb)) (primitive/isub top 1))
                (unless (set-contains (field wantedb items) nm)
                  (al-push! (mut (field wantedb items)) nm)
                  (let [f (prog-fn-find p nm)]
                    (unless (= (primitive/cast i64 f) (primitive/cast i64 0))
                      (cc-list (load (field f body)) names stackb))))))))
  0)
(defn closure-funcs [(p (ptr Program)) (seeds (ptr (ArrayList (slice u8)))) (a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [names (prog-fn-names p a)
        stackb (box! a SBox (primitive/zeroed SBox))
        wantedb (box! a SBox (primitive/zeroed SBox))]
    (set! (.items stackb) (al-new [(slice u8)] a))
    (set! (.items wantedb) (al-new [(slice u8)] a))
    (let [ns (al-len [(slice u8)] (load seeds))
          (mut si) 0]
      (loop (if (>= (load si) ns)
                (break)
                (do
                  (al-push! (mut (.items stackb))
                            (al-get [(slice u8)] (load seeds) (load si)))
                  (set! si (primitive/iadd (load si) 1))))))
    ; The sub-program keeps EVERY const (closure-subprogram), and a const's value is a
    ; compile-time computation that check/finish folds. A const that calls an ordinary
    ; function would otherwise report that callee "undefined" here — exactly like an
    ; impl method's callees above — so seed the const-value callees too.
    (let [cs (load (field p consts))
          nc (al-len [Const] (load cs))
          (mut ci) 0]
      (loop (if (>= (load ci) nc)
                (break)
                (do
                  (collect-calls (field (al-elem [Const] cs (load ci)) value) names stackb)
                  (set! ci (primitive/iadd (load ci) 1))))))
    (closure-drain! p names stackb wantedb)
    ; Module reachability can grow through an impl body, so repeat to a bounded
    ; fixpoint. Re-seeding an already-wanted callee is harmless.
    (let [is (load (field p impls))
          ni (al-len [ImplDef] (load is))
          (mut selected) (al-new [i64] a)
          (mut init) 0
          (mut pass) 0]
      (loop (if (>= (load init) ni)
                (break)
                (do (al-push! (mut selected) 0) (set! init (primitive/iadd (load init) 1)))))
      (loop (if (> (load pass) ni)
                (break)
                (let [(mut ii) 0
                      (mut added) false]
                  (loop (if (>= (load ii) ni)
                            (break)
                            (do
                              (let [ip (al-elem [ImplDef] is (load ii))]
                                (when (and (= (al-get [i64]
                                                      (load selected)
                                                      (load ii))
                                              (primitive/cast i64 0))
                                           (closure-impl-wanted? a (field wantedb items) ip))
                                  (al-set! (mut selected) (load ii) 1)
                                  (store! added true)
                                  (let [ms (load (field ip methods))
                                        nm (al-len [Func] (load ms))
                                        (mut mi) 0]
                                    (loop (if (>= (load mi) nm)
                                              (break)
                                              (do
                                                (cc-list (load (field (al-elem [Func]
                                                                               ms
                                                                               (load mi))
                                                                      body))
                                                         names
                                                         stackb)
                                                (store! mi (primitive/iadd (load mi) 1))))))))
                              (set! ii (primitive/iadd (load ii) 1)))))
                  (closure-drain! p names stackb wantedb)
                  (unless (load added) (break))
                  (set! pass (primitive/iadd (load pass) 1)))))
      0)
    (field wantedb items)))
; ---- pruned closure (macro STAGING, interp deletion step 5 Phase B) ---------------
; closure-funcs minus the impl-method and const-value seeding: only the seeds'
; transitive callees ride along. Used by the per-qual staging prepass, where the
; whole point is that closure-funcs' unconditional impl/const seeding drags in
; functions whose bodies still hold unexpanded macro calls (slice-get's
; dbg-slice-get) and poisons every check. Measured 2026-07-21: with this pruning,
; 100% of the compiler's own macro quals and 99.6% of the corpus's check standalone.
(defn closure-funcs-pruned [(p (ptr Program)) (seeds (ptr (ArrayList (slice u8)))) (a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (let [names (prog-fn-names p a)
        stackb (box! a SBox (primitive/zeroed SBox))
        wantedb (box! a SBox (primitive/zeroed SBox))]
    (set! (.items stackb) (al-new [(slice u8)] a))
    (set! (.items wantedb) (al-new [(slice u8)] a))
    (let [ns (al-len [(slice u8)] (load seeds))
          (mut si) 0]
      (loop (if (>= (load si) ns)
                (break)
                (do
                  (al-push! (mut (.items stackb))
                            (al-get [(slice u8)] (load seeds) (load si)))
                  (set! si (primitive/iadd (load si) 1))))))
    (loop (if (= (al-len [(slice u8)] (.items stackb)) (primitive/cast i64 0))
              (break)
              (do
                (let [sl (.items stackb)
                      top (al-len [(slice u8)] sl)
                      nm (al-get [(slice u8)] sl (primitive/isub top 1))]
                  (set! (.len (.items stackb)) (primitive/isub top 1))
                  (unless (set-contains (field wantedb items) nm)
                    (al-push! (mut (field wantedb items)) nm)
                    (let [f (prog-fn-find p nm)]
                      (unless (= (primitive/cast i64 f) (primitive/cast i64 0))
                        (cc-list (load (field f body)) names stackb))))))))
    (field wantedb items)))
; Keep only extern declarations that a reachable body calls or takes the address of.
; `prog-fn-names` includes extern names, so `collect-calls` puts those references in
; `wanted` alongside ordinary functions.
(defn closure-externs [(p (ptr Program)) (wanted (ptr (ArrayList (slice u8)))) (a (dyn Allocator))] (-> (ptr (ArrayList Extern)))
  (let [es (load (field p externs))
        n (al-len [Extern] (load es))
        (mut keep) (al-new [Extern] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (al-elem [Extern] es (load i))]
                  (when (set-contains wanted (load (field ep name)))
                    (al-push! (mut keep) (load ep))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Extern] a (load keep))))
; closure-subprogram with impls and consts PRUNED (companion of the above): a
; macro whose callees genuinely need trait impls fails this check and simply
; stays unstaged — the ordinary full-closure batch path picks it up later.
(defn closure-subprogram-pruned [(p (ptr Program)) (wanted (ptr (ArrayList (slice u8)))) (a (dyn Allocator))] (-> (ptr Program))
  (let [pp (box! a Program (primitive/zeroed Program))
        fs (load (field p funcs))
        n (al-len [Func] (load fs))
        (mut keep) (al-new [Func] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] fs (load i))]
                  (when (set-contains wanted (load (field fp name)))
                    (al-push! (mut keep) (load fp))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.annotation_defs pp) (load (field p annotation_defs)))
    (set! (.conventions pp) (load (field p conventions)))
    (set! (.structs pp) (load (field p structs)))
    (set! (.sums pp) (load (field p sums)))
    (set! (.externs pp) (closure-externs p wanted a))
    (set! (.funcs pp) (box-al [Func] a (load keep)))
    (set! (.asserts pp) (box-al [StaticAssert] a (al-new [StaticAssert] a)))
    (set! (.consts pp) (box-al [Const] a (al-new [Const] a)))
    (set! (.traits pp) (load (field p traits)))
    (set! (.impls pp) (box-al [ImplDef] a (al-new [ImplDef] a)))
    (set! (.metas pp) (box-al [Expr] a (al-new [Expr] a)))
    (set! (.exports pp) (box-al [ExportC] a (al-new [ExportC] a)))
    pp))

(defn closure-subprogram [(p (ptr Program)) (wanted (ptr (ArrayList (slice u8)))) (a (dyn Allocator))] (-> (ptr Program))
  (let [pp (box! a Program (primitive/zeroed Program))
        fs (load (field p funcs))
        n (al-len [Func] (load fs))
        (mut keep) (al-new [Func] a)
        (mut keepi) (al-new [ImplDef] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] fs (load i))]
                  (when (set-contains wanted (load (field fp name)))
                    (al-push! (mut keep) (load fp))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (let [is (load (field p impls))
          ni (al-len [ImplDef] (load is))
          (mut ii) 0]
      (loop (if (>= (load ii) ni)
                (break)
                (do
                  (let [ip (al-elem [ImplDef] is (load ii))]
                    (when (closure-impl-wanted? a wanted ip) (al-push! (mut keepi) (load ip)) 0))
                  (set! ii (primitive/iadd (load ii) 1))))))
    (set! (.annotation_defs pp) (load (field p annotation_defs)))
    (set! (.conventions pp) (load (field p conventions)))
    (set! (.structs pp) (load (field p structs)))
    (set! (.sums pp) (load (field p sums)))
    (set! (.externs pp) (closure-externs p wanted a))
    (set! (.funcs pp) (box-al [Func] a (load keep)))
    (set! (.asserts pp) (box-al [StaticAssert] a (al-new [StaticAssert] a)))
    (set! (.consts pp) (load (field p consts)))
    (set! (.traits pp) (load (field p traits)))
    (set! (.impls pp) (box-al [ImplDef] a (load keepi)))
    (set! (.metas pp) (box-al [Expr] a (al-new [Expr] a)))
    (set! (.exports pp) (box-al [ExportC] a (al-new [ExportC] a)))
    pp))
(defn is-meta-form [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) (primitive/cast i64 6))
       (let [it (sx-items (load f))]
         (and (>= (sx-len it) (primitive/cast i64 1))
              (and (= (sx-tag (sx-at it 0)) (primitive/cast i64 2)) (= (sx-sval (sx-at it 0)) "meta"))))))
; ============================ comptime::fold_program ========================
; The comptime FOLD pass:
; walk every checked function body (and static-assert cond) and replace each
; `(comptime E)` node with the literal E evaluates to. Runs the SAME interpreter
; `eval` used for (meta …). Implemented as an IN-PLACE mutating walk (like
; qualify-expr): non-comptime nodes are recursed but left byte-identical, so the
; pass is a NO-OP for comptime-free programs (the exhaustive IR corpus + bootstrap
; stay unchanged); only `(comptime …)` nodes — currently a hard mono error — get
; folded. build_value reconstructs the literal-back (scalars → literals, a sum →
; a variant call, a struct/array → an imperative alloc+store+load).
(defn f64->bits [(x f64)] (-> i64)
  (let [p (primitive/alloc-stack f64)] (set! p x) (load (primitive/cast (ptr i64) p))))
; NB: CtVal (a sum) is threaded BY POINTER through this mutual recursion — a
; by-value aggregate into recursion miscompiles (musttail TCE failure).
(defn build-content [(a (dyn Allocator)) (vp (ptr CtVal)) (lo i64) (hi i64) (src i64) (ctxt i64) (cx (ptr CtCtx))] (-> (Result Expr
                                                                                                                               Diag))
  (match (load vp)
    ; wrap the cross-recursion in a let so the call is NOT in tail position — a
    ; musttail'd aggregate-returning mutual tail call fails LLVM's TCE.
    (CInt [n] (let [r (build-value a vp lo hi src ctxt cx)] r))
    (CBool [b] (let [r (build-value a vp lo hi src ctxt cx)] r))
    (CFloat [x] (let [r (build-value a vp lo hi src ctxt cx)] r))
    (CStr [s] (let [r (build-value a vp lo hi src ctxt cx)] r))
    (CCode [f] (let [r (build-value a vp lo hi src ctxt cx)] r))
    (CRef [cell] (let [r (build-content a cell lo hi src ctxt cx)] r))
    (CSum [variant fields]
          ; pre-mono, a sum value is a call to the variant name
          (let [nf (al-len [(ptr CtVal)] (load fields))
                (mut args) (al-new [Expr] a)
                (mut i) 0
                (mut errf) (None [Diag])]
            (loop (if (or (diag-some? (load errf)) (>= (load i) nf))
                      (break)
                      (do
                        (match (build-value a
                                            (new-cell (cell-value (al-get [(ptr CtVal)]
                                                                          (load fields)
                                                                          (load i))))
                                            lo
                                            hi
                                            src
                                            ctxt
                                            cx)
                          (Err [d] (do (set! errf (Some d)) 0))
                          (Ok [ev] (do (al-push! (mut args) ev) 0)))
                        (set! i (primitive/iadd (load i) 1)))))
            (match (load errf)
              (Some [d] (Err [Expr Diag] d))
              (None []
                    (Ok [Expr Diag]
                        (mk-expr (ECall
                                   :func variant
                                   :type_args (box-items-type a)
                                   :args (box-al [Expr] a (load args)))
                                 lo
                                 hi
                                 src
                                 ctxt))))))
    (CStruct [name fields]
             (let [sd (ct-struct-find cx name)]
               (if (= (primitive/cast i64 sd) (primitive/cast i64 0))
                   (Err [Expr Diag] (derr (sconcat3 a "comptime: unknown struct '" name "'")))
                   (let [n (.gensym cx)
                         _b (set! (.gensym cx) (primitive/iadd n 1))
                         t (sconcat a "$ct" (i64->str a n))
                         sfs (load (field sd fields))
                         nfl (al-len [Field] (load sfs))
                         (mut body) (al-new [Expr] a)
                         (mut i) 0
                         (mut errf) (None [Diag])]
                     (loop (if (or (diag-some? (load errf)) (>= (load i) nfl))
                               (break)
                               (do
                                 (match (build-value a
                                                     (new-cell (cell-value (al-get [(ptr CtVal)]
                                                                                   (load fields)
                                                                                   (load i))))
                                                     lo
                                                     hi
                                                     src
                                                     ctxt
                                                     cx)
                                   (Err [d] (do (set! errf (Some d)) 0))
                                   (Ok [ev]
                                       (let [fname (.name (al-elem [Field] sfs (load i)))
                                             fld
                                               (mk-expr (EField (box-expr a (mk-expr (EVar t) lo hi src ctxt)) fname)
                                                        lo
                                                        hi
                                                        src
                                                        ctxt)]
                                         (do
                                           (al-push! (mut body)
                                                     (mk-expr (EStore (box-expr a fld) (box-expr a ev)) lo hi src ctxt))
                                           0))))
                                 (set! i (primitive/iadd (load i) 1)))))
                     (match (load errf)
                       (Some [d] (Err [Expr Diag] d))
                       (None []
                             (do
                               (al-push! (mut body)
                                         (mk-expr (ELoad (box-expr a (mk-expr (EVar t) lo hi src ctxt))) lo hi src ctxt))
                               (let [(mut binds) (al-new [Bind] a)
                                     bp (primitive/alloc-stack Bind)]
                                 (set! (.name bp) t)
                                 (set! (.mutable bp) false)
                                 (set! (.value bp) (mk-expr (EAlloc 0 (TStruct name) (primitive/cast (ptr Expr) 0)) lo hi src ctxt))
                                 (al-push! (mut binds) (load bp))
                                 (Ok [Expr Diag]
                                     (mk-expr (ELet (box-al [Bind] a (load binds))
                                                    (box-al [Expr] a (load body)))
                                              lo
                                              hi
                                              src
                                              ctxt))))))))))
    (CArray [elem cells]
            (let [n (.gensym cx)
                  _b (set! (.gensym cx) (primitive/iadd n 1))
                  t (sconcat a "$ct" (i64->str a n))
                  nc (al-len [(ptr CtVal)] (load cells))
                  (mut body) (al-new [Expr] a)
                  (mut i) 0
                  (mut errf) (None [Diag])]
              (loop (if (or (diag-some? (load errf)) (>= (load i) nc))
                        (break)
                        (do
                          (match (build-value a
                                              (new-cell (cell-value (al-get [(ptr CtVal)]
                                                                            (load cells)
                                                                            (load i))))
                                              lo
                                              hi
                                              src
                                              ctxt
                                              cx)
                            (Err [d] (do (set! errf (Some d)) 0))
                            (Ok [ev]
                                (let [idxe
                                        (mk-expr (EIndex (box-expr a (mk-expr (EVar t) lo hi src ctxt))
                                                         (box-expr a (mk-expr (EInt (load i)) lo hi src ctxt)))
                                                 lo
                                                 hi
                                                 src
                                                 ctxt)]
                                  (do
                                    (al-push! (mut body)
                                              (mk-expr (EStore (box-expr a idxe) (box-expr a ev)) lo hi src ctxt))
                                    0))))
                          (set! i (primitive/iadd (load i) 1)))))
              (match (load errf)
                (Some [d] (Err [Expr Diag] d))
                (None []
                      (do
                        (al-push! (mut body)
                                  (mk-expr (ELoad (box-expr a (mk-expr (EVar t) lo hi src ctxt))) lo hi src ctxt))
                        (let [(mut binds) (al-new [Bind] a)
                              bp (primitive/alloc-stack Bind)]
                          (set! (.name bp) t)
                          (set! (.mutable bp) false)
                          (set! (.value bp) (mk-expr (EAlloc 0 (TArray (box-type a elem) nc) (primitive/cast (ptr Expr) 0)) lo hi src ctxt))
                          (al-push! (mut binds) (load bp))
                          (Ok [Expr Diag]
                              (mk-expr (ELet (box-al [Bind] a (load binds))
                                             (box-al [Expr] a (load body)))
                                       lo
                                       hi
                                       src
                                       ctxt))))))))))
(defn build-value [(a (dyn Allocator)) (vp (ptr CtVal)) (lo i64) (hi i64) (src i64) (ctxt i64) (cx (ptr CtCtx))] (-> (Result Expr
                                                                                                                             Diag))
  (match (load vp)
    (CInt [n] (Ok [Expr Diag] (mk-expr (EInt n) lo hi src ctxt)))
    (CBool [b] (Ok [Expr Diag] (mk-expr (EBool b) lo hi src ctxt)))
    (CFloat [x] (Ok [Expr Diag] (mk-expr (EFloat (f64->bits x)) lo hi src ctxt)))
    (CStr [s] (Ok [Expr Diag] (mk-expr (EStr s) lo hi src ctxt)))
    (CCode [f]
           (Err [Expr Diag]
                (derr "comptime: a Code value can't be used as a runtime value (it's only meaningful at compile time)")))
    (CRef [cell] (let [r (build-content a cell lo hi src ctxt cx)] r))
    (CStruct [nm fs] (let [r (build-content a vp lo hi src ctxt cx)] r))
    (CArray [el cs] (let [r (build-content a vp lo hi src ctxt cx)] r))
    (CSum [vn fs] (let [r (build-content a vp lo hi src ctxt cx)] r))))
(defn fold-expr-list [(es (ptr (ArrayList Expr))) (cx (ptr CtCtx))] (-> (Result i64 Diag))
  (let [n (al-len [Expr] (load es))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (fold-expr (al-elem [Expr] es (load i)) cx)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn fold-bind-list [(binds (ptr (ArrayList Bind))) (cx (ptr CtCtx))] (-> (Result i64 Diag))
  (let [n (al-len [Bind] (load binds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (fold-expr (field (al-elem [Bind] binds (load i)) value) cx)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn fold-arm-list [(arms (ptr (ArrayList Arm))) (cx (ptr CtCtx))] (-> (Result i64 Diag))
  (let [n (al-len [Arm] (load arms))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (fold-expr (field (al-elem [Arm] arms (load i)) body) cx)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn fold-quasi-list [(items (ptr (ArrayList Quasi))) (cx (ptr CtCtx))] (-> (Result i64 Diag))
  (let [n (al-len [Quasi] (load items))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (fold-quasi (al-elem [Quasi] items (load i)) cx)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))
(defn fold-quasi [(qp (ptr Quasi)) (cx (ptr CtCtx))] (-> (Result i64 Diag))
  (match (load qp)
    (QLit [_] (Ok [i64 Diag] 0))
    (QUnquote [e] (fold-expr e cx))
    (QSplice [e] (fold-expr e cx))
    (QList [items] (fold-quasi-list items cx))
    (QVector [items] (fold-quasi-list items cx))))
; Checked literal constants are already materialized values. Routing them through
; the native comptime hook built, linked and dlopen'd a dedicated dylib for every
; `(const NAME 1)` / string / bool in the graph. Preserve the outer node's source
; metadata and copy only the value kind in place.
(defn fold-direct-literal! [(dst (ptr Expr)) (src (ptr Expr))] (-> bool)
  (match (.kind src)
    (EInt [_] (do (set! (.kind dst) (.kind src)) true))
    (EFloat [_] (do (set! (.kind dst) (.kind src)) true))
    (EBool [_] (do (set! (.kind dst) (.kind src)) true))
    (EStr [_] (do (set! (.kind dst) (.kind src)) true))
    (ECStr [_] (do (set! (.kind dst) (.kind src)) true))
    (_ false)))
(defn fold-expr [(ep (ptr Expr)) (cx (ptr CtCtx))] (-> (Result i64 Diag))
  (let [a (load (field cx a))]
    (try (do
           (match (load (field ep kind))
             (EArrayLit [items] (try! (fold-expr-list items cx)))
             (EMakeSlice [data _ _] (try! (fold-expr data cx)))
             (EComptime [inner]
                        ; Evaluate the inner directly (eval handles nested comptime/reflection
                        ; with the proper environment) and splice the literal-back IN PLACE,
                        ; keeping this node's span. When
                        ; the tree-walk interpreter REJECTS the site (a generic call, sizeof, a
                        ; string — the mac-8 weaknesses), route it through the compiled metaprogram
                        ; engine via the registered hook (interp deletion step 1); the hook returns
                        ; null (declined) for anything it can't read back, leaving the interp error.
                        (if (fold-direct-literal! ep inner)
                            0
                            (let [lo (load (field ep lo))
                                  hi (load (field ep hi))
                                  hk (ct-fold-hook)]
                              ; the compiled engine is THE comptime evaluator (the tree-walking
                              ; interpreter is gone — decision 7). A hook decline (null) is a
                              ; located hard error; an unregistered hook means this compiler build
                              ; cannot evaluate comptime at all and says so.
                              (if (= (load (field hk isset)) (primitive/cast i64 0))
                                  (return-from :try
                                                 (Err (derr-at lo
                                                               hi
                                                               "comptime: this compiler build has no comptime engine registered (compiler bug)")))
                                  (let [r (primitive/call-ptr (load (field hk fp)) a inner cx)]
                                    (if (= (primitive/cast i64 r) (primitive/cast i64 0))
                                        (return-from :try
                                                       (Err (derr-at lo
                                                                     hi
                                                                     "comptime: this expression's value cannot be materialized as a compile-time literal")))
                                        (match (load (primitive/cast (ptr (Result Expr Diag)) r))
                                          (Err [d2] (return-from :try (Err d2)))
                                          (Ok [lit]
                                              (do
                                                (store! (field ep kind) (load (field (box-expr a lit) kind)))
                                                0)))))))))
             (EInt [_] 0)
             (EFloat [_] 0)
             (EBool [_] 0)
             (EStr [_] 0)
             (ECStr [_] 0)
             (EVar [_] 0)
             (EZeroed [_] 0)
             (ESizeOf [_] 0)
             (EAlignOf [_] 0)
             (EOffsetOf [_ _] 0)
             (EFnPtrOf [_] 0)
             (EAlloc [_ _ init]
                     (if (= (primitive/cast i64 init) 0) 0 (do (try! (fold-expr init cx)) 0)))
             (EContinue [_] 0)
             (EQuote [_] 0)
             (EStaticRef [_] 0)
             (ETraitCall [_ _ _ _] 0)
             (ETypeQuery [_ _] 0)
             (EBorrow [mu place] (do (try! (fold-expr place cx)) 0))
             (ESpillRef [x] (do (try! (fold-expr x cx)) 0))
             (ENot [x] (do (try! (fold-expr x cx)) 0))
             (ELoad [x] (do (try! (fold-expr x cx)) 0))
             (EFree [x] (do (try! (fold-expr x cx)) 0))
             (EErase [tn x] (do (try! (fold-expr x cx)) 0))
             (EMakeDyn [ds vt ms inner] (do (try! (fold-expr inner cx)) 0))
             (EDynDispatch [ds vt mi cc ps rt recv args]
                           (do (try! (fold-expr recv cx)) (try! (fold-expr-list args cx)) 0))
             (ECast [t x] (do (try! (fold-expr x cx)) 0))
             (EAscribe [t x] (do (try! (fold-expr x cx)) 0))
             (EBin [op l r] (do (try! (fold-expr l cx)) (try! (fold-expr r cx)) 0))
             (ECmp [op l r] (do (try! (fold-expr l cx)) (try! (fold-expr r cx)) 0))
             (EIf [c t e] (do (try! (fold-expr c cx)) (try! (fold-expr t cx)) (try! (fold-expr e cx)) 0))
             (EDo [body] (do (try! (fold-expr-list body cx)) 0))
             (ELoop [label body] (do (try! (fold-expr-list body cx)) 0))
             (EBreak [label value] (do (match value (Some [vp] (try! (fold-expr vp cx))) (None [] 0)) 0))
             (ELet [binds body] (do (try! (fold-bind-list binds cx)) (try! (fold-expr-list body cx)) 0))
             (ECall [func type_args args] (do (try! (fold-expr-list args cx)) 0))
             (ENamedCall [func type_args names args] (do (try! (fold-expr-list args cx)) 0))
             (EField [p fname] (do (try! (fold-expr p cx)) 0))
             (EStore [p val] (do (try! (fold-expr p cx)) (try! (fold-expr val cx)) 0))
             (EIndex [p idx] (do (try! (fold-expr p cx)) (try! (fold-expr idx cx)) 0))
             (EBitGet [p fname] (do (try! (fold-expr p cx)) 0))
             (EBitSet [p fname val] (do (try! (fold-expr p cx)) (try! (fold-expr val cx)) 0))
             (EConstruct [sum variant args] (do (try! (fold-expr-list args cx)) 0))
             (EMatch [scrut arms] (do (try! (fold-expr scrut cx)) (try! (fold-arm-list arms cx)) 0))
             (ECallPtr [fp args] (do (try! (fold-expr fp cx)) (try! (fold-expr-list args cx)) 0))
             (ELlvmIr [result args body] (do (try! (fold-expr-list args cx)) 0))
             (ECodeOp [op args] (do (try! (fold-expr-list args cx)) 0))
             (EQuasi [q]
                     (do
                       (let [qp (primitive/alloc-stack Quasi)]
                         (store! qp q)
                         (try! (fold-quasi qp cx))
                         (store! (field ep kind) (EQuasi (load qp))))
                       0))
             (EFieldMeta [meta t idx] (do (try! (fold-expr idx cx)) 0))
             (EFieldIndex [t nm] (do (try! (fold-expr nm cx)) 0)))
           (Ok [i64 Diag] 0)))))
; Build the comptime CtCtx from a checked Program (mirrors fold_program's ctx).
(defn mk-ctctx [(checked (ptr Program)) (a (dyn Allocator))] (-> (ptr CtCtx))
  (let [cx (box! a CtCtx (primitive/zeroed CtCtx))]
    (set! (.a cx) a)
    (set! (.fns cx) (load (field checked funcs)))
    (set! (.structs cx) (load (field checked structs)))
    (set! (.sums cx) (load (field checked sums)))
    (set! (.variants cx) (all-variant-names (load (field checked sums)) a))
    (set! (.traits cx) (load (field checked traits)))
    (set! (.fuel cx) 50000000)
    (set! (.depth cx) 0)
    (set! (.gensym cx) 0)
    (set! (.qmodule cx) (None [(slice u8)]))
    (set! (.module_fns cx) (primitive/cast (ptr (ArrayList (slice u8))) 0))
    (set! (.qimports cx) (primitive/cast (ptr ModImports) 0))
    (set! (.qexports cx) (primitive/cast (ptr (ArrayList ExpEntry)) 0))
    (set! (.prog cx) checked)
    cx))
; fold_program: fold every function body (int place) and every static-assert cond.
(defn fold-program [(checked (ptr Program)) (asserts (ptr (ArrayList StaticAssert))) (a (dyn Allocator))] (-> (Result i64
                                                                                                                      Diag))
  (let [cx (mk-ctctx checked a)
        fns (load (field checked funcs))
        nf (al-len [Func] (load fns))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) nf)
              (break)
              (do
                (let [fp (al-elem [Func] fns (load i))
                      anns (load (field fp annotations))
                      an (al-len [Annotation] (load anns))
                      (mut ai) 0]
                  (loop (if (>= (load ai) an)
                            (break)
                            (do
                              (match (fold-expr (field (al-elem [Annotation] anns (load ai)) value) cx)
                                (Err [d] (do (set! err d) (set! failed true) (break)))
                                (Ok [_] 0))
                              (set! ai (primitive/iadd (load ai) 1)))))
                  (when (load failed) (break))
                  (match (fold-expr-list (load (field fp body))
                                         cx)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [_] 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err (load err))
        (let [na (al-len [StaticAssert] (load asserts))
              (mut j) 0
              (mut e2) (primitive/zeroed Diag)
              (mut f2) false]
          (loop (if (>= (load j) na)
                    (break)
                    (do
                      (match (fold-expr (field (al-elem [StaticAssert] asserts (load j)) cnd) cx)
                        (Err [d] (do (set! e2 d) (set! f2 true) (break)))
                        (Ok [_] 0))
                      (set! j (primitive/iadd (load j) 1)))))
          (if (load f2) (Err [i64 Diag] (load e2)) (Ok [i64 Diag] 0))))))

; ---- comptime::run_metas — evaluate each (meta …) form (checked/elaborated) via the
;      comptime interpreter to a Code value, splice a `(do …)` result, else push it.
;      Returns the generated top-level forms as raw Sexp (re-resolved by the caller).
(defn ls-has-meta [(s (mut LS))] (-> bool)
  (let [a (load (field s a))
        out (box-al [TaggedForm] a (.out s))
        n (al-len [TaggedForm] (load out))
        (mut i) 0
        (mut r) false]
    (loop (if (or (load r) (>= (load i) n))
              (break)
              (do
                (when (is-meta-form (field (al-elem [TaggedForm] out (load i)) form))
                  (store! r true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
; Return meta modules in evaluation order, parallel to Program.metas.
(defn meta-form-modules [(s (mut LS)) (a (dyn Allocator))] (-> (ptr (ArrayList (Option (slice u8)))))
  (let [(mut mods) (al-new [(Option (slice u8))] a)
        n (al-len [TaggedForm] (.out s))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tf (al-elem [TaggedForm] (field s out) (load i))]
                  (when (is-meta-form (field tf form))
                    (al-push! (mut mods) (load (field tf module)))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(Option (slice u8))] a (load mods))))

; Rebuild s.out = (tagged forms sans meta) ++ generated forms. Generated forms
; retain the module of the particular meta expression that produced them.
(defn splice-metas [(s (mut LS))
                    (gen (ptr (ArrayList Sexp)))
                    (genmods (ptr (ArrayList (Option (slice u8)))))
                    (a (dyn Allocator))] (-> i64)
  (let [old (box-al [TaggedForm] a (.out s))
        n (al-len [TaggedForm] (load old))
        (mut newout) (al-new [TaggedForm] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tf (al-elem [TaggedForm] old (load i))]
                  (unless (is-meta-form (field tf form))
                    (al-push! (mut newout) (load tf))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (let [ng (al-len [Sexp] (load gen))
          (mut j) 0]
      (loop (if (>= (load j) ng)
                (break)
                (do
                  (let [tf (primitive/alloc-stack TaggedForm)]
                    (set! (.form tf) (al-get [Sexp] (load gen) (load j)))
                    (set! (.module tf) (al-get [(Option (slice u8))] (load genmods) (load j)))
                    (al-push! (mut newout) (load tf)))
                  (set! j (primitive/iadd (load j) 1))))))
    (set! (.out s) (load newout))
    0))
; — the (meta …) staged-macro loop. `prog` is the
; NON-STRICT first resolve (metas non-empty): check the generator closure, run the
; metas, splice the generated forms, then STRICT re-resolve + final check.
