;;; Semantic declaration graph. Built once per checked-model publication, before
;;; monomorphization or physical lowering; names denote source declarations.
(module coil.compiler.dependencies)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.str" :use [str-keyops str-cmp])
(import "coil.reader" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.checked_base" :as base)
(import "coil.compiler.check" :use [tmfn inherent-fn-name impl-mangle-key trait-self-key])
(import "coil.compiler.retained_graph" :use [GraphKey graph-keyops])
(import "coil.compiler.type_references" :as refs)
(import "coil.compiler.dep_index" :as deps)
(import "coil.pmap" :use [pm-iter])
(import "coil.compiler.resolve" :use [dependency-reads! dependency-function-reads! dependency-current? qualify-in-module])

(defstruct DependencyGraph
  [(forward (HashMap (slice u8) (ptr (HashMap (slice u8) i64))))
   (reverse (HashMap (slice u8) (ptr (HashMap (slice u8) i64))))])

(defn names-new [(a (dyn Allocator))] (-> (ptr (HashMap (slice u8) i64)))
  (box! a (HashMap (slice u8) i64) (hm-new [(slice u8) i64] a (str-keyops))))

(defn declare! [(a (dyn Allocator)) (g (ptr DependencyGraph)) (name (slice u8))]
  (-> (ptr (HashMap (slice u8) i64)))
  (let [names (names-new a)]
    (set! (mut (.forward g)) name names)
    names))

(defn build [(a (dyn Allocator)) (program (ptr Program)) (accepted (ptr base/CheckedBase)) (accepted-edges (ptr deps/DepBase))]
  (-> (ptr DependencyGraph))
  (let [g (box! a DependencyGraph
             (DependencyGraph :forward (hm-new [(slice u8) (ptr (HashMap (slice u8) i64))] a (str-keyops))
                              :reverse (hm-new [(slice u8) (ptr (HashMap (slice u8) i64))] a (str-keyops))))
        (mut functions) (al-new [Func] a)]
    (base/checked-base-functions! accepted (mut functions))
    (for f (iter functions)
      (let [names (declare! a g (.name f))
            (mut seen) (hm-new [GraphKey i64] a (graph-keyops))]
        (refs/func-value! names (mut seen) f)
        (dependency-function-reads! (box! a Func f) names)))
    ; Current definitions replace accepted records with the same identity.
    (for f (iter (load (.funcs program)))
      (let [names (declare! a g (.name f))
            (mut seen) (hm-new [GraphKey i64] a (graph-keyops))]
        (refs/func-value! names (mut seen) f)
        (dependency-function-reads! (box! a Func f) names)))
    (for d (iter (load (.structs program)))
      (let [names (declare! a g (.name d))
            (mut seen) (hm-new [GraphKey i64] a (graph-keyops))]
        (refs/struct-value! names (mut seen) d)))
    (for d (iter (load (.sums program)))
      (let [names (declare! a g (.name d))
            (mut seen) (hm-new [GraphKey i64] a (graph-keyops))]
        (refs/sum-value! names (mut seen) d)
        (for variant (iter (load (.variants d)))
          (let [variant-reads (declare! a g (.name variant))
                (mut variant-seen) (hm-new [GraphKey i64] a (graph-keyops))]
            (refs/variant-value! variant-reads (mut variant-seen) variant)
            (set! variant-reads (.name d) 0)))))
    (for d (iter (load (.consts program)))
      (let [names (declare! a g (.name d))
            (mut seen) (hm-new [GraphKey i64] a (graph-keyops))]
        (refs/const-value! names (mut seen) d)))
    (for d (iter (load (.traits program)))
      (let [names (declare! a g (.name d))
            (mut seen) (hm-new [GraphKey i64] a (graph-keyops))]
        (refs/trait-value! names (mut seen) d)
        (for name (iter (load (.requires d))) (set! names name 0))
        (for method (iter (load (.methods d)))
          (let [method-reads (declare! a g (tmfn a (.name d) (trait-self-key) (.name method)))
                (mut method-seen) (hm-new [GraphKey i64] a (graph-keyops))]
            (refs/trait-method-value! method-reads (mut method-seen) method)
            (set! method-reads (.name d) 0)))))
    (for d (iter (load (.externs program)))
      (let [names (declare! a g (.name d))
            (mut seen) (hm-new [GraphKey i64] a (graph-keyops))]
        (refs/extern-value! names (mut seen) d)))
    (for [im-index 0 (len (load (.impls program)))]
      (let [im (al-elem [ImplDef] (.impls program) im-index)]
      (for method (iter (load (.methods im)))
        (let [name (if (impl-is-trait im)
                      (tmfn a (impl-trait-name im)
                        (impl-mangle-key a (field im self_type) (.type_params im)) (.name method))
                      (inherent-fn-name a im (.name method)))
              names (declare! a g name)
              (mut seen) (hm-new [GraphKey i64] a (graph-keyops))]
          (refs/func-value! names (mut seen) method)
          (dependency-reads! name names)
          (dependency-function-reads! (box! a Func method) names)
          (when (impl-is-trait im)
            (set! names (impl-trait-name im) 0) 0)))))
    ; The loader merges newest aliases first; match the resolver's first-wins rule.
    (let [(mut aliases) (hm-new [(slice u8) i64] a (str-keyops))]
      (for d (iter (load (.aliases program)))
        (let [module (src-mod-lookup (.source d)) name (qualify-in-module a module (.name d))]
          (unless (hm-contains? [(slice u8) i64] aliases name)
            (set! (mut aliases) name 0)
            (let [names (declare! a g name)]
              (set! names (qualify-in-module a module (.target d)) 0)) 0))))
    ; Accepted edge lists retain expansion/resolution provenance that is absent
    ; from an already-folded AST. Current definitions replace their old edges.
    (unless (= accepted-edges (deps/dep-no-base))
      (let [(mut it) (pm-iter (field accepted-edges reads))]
        (loop
          (match (next (mut it))
            (None [] (break))
            (Some [entry]
              (unless (dependency-current? (.key entry))
                (let [names (match (get (.forward g) (.key entry))
                              (Some [existing] existing)
                              (None [] (declare! a g (.key entry))))]
                  (for name (iter (.reads (.val entry)))
                    (unless (hm-contains? [(slice u8) (ptr (HashMap (slice u8) i64))] (.forward g) name)
                      (declare! a g name) 0)
                    (set! names name 0)))
                0)))))
      0)
    ; Only semantic declaration identities become edges. Local variables and
    ; primitive scalar types are not declarations. Reverse sets deduplicate.
    (for [i 0 (.cap (.forward g))]
      (let [entry (p/index (.slots (.forward g)) i)]
        (when (= (.state entry) 1)
          (let [names (.val entry) (mut remove) (al-new [(slice u8)] a)]
            (dependency-reads! (.key entry) names)
            (for [j 0 (.cap (load names))]
              (let [edge (p/index (.slots (load names)) j)]
                (when (= (.state edge) 1)
                  (if (not (hm-contains? [(slice u8) (ptr (HashMap (slice u8) i64))] (.forward g) (.key edge)))
                      (push! (mut remove) (.key edge))
                      (let [readers (match (get (.reverse g) (.key edge))
                                      (Some [existing] existing)
                                      (None [] (let [fresh (names-new a)]
                                                 (set! (mut (.reverse g)) (.key edge) fresh) fresh)))]
                        (set! readers (.key entry) 0))) 0)))
            (for name (iter remove) (hm-remove! [(slice u8) i64] names name) 0)) 0)))
    g))

(defn known? [(g (ptr DependencyGraph)) (name (slice u8))] (-> bool)
  (hm-contains? [(slice u8) (ptr (HashMap (slice u8) i64))] (.forward g) name))

(defn query [(a (dyn Allocator)) (g (ptr DependencyGraph)) (name (slice u8))
             (reverse bool) (transitive bool)] (-> Sexp)
  (if (not (hm-contains? [(slice u8) (ptr (HashMap (slice u8) i64))] (.forward g) name))
      (mk-sexp (KKw "unresolved") -1 -1)
      (let [edges (if reverse (.reverse g) (.forward g))
            (mut visited) (hm-new [(slice u8) i64] a (str-keyops))
            (mut queue) (al-new [(slice u8)] a)
            (mut index) 0]
        (when transitive (set! (mut visited) name 0) 0)
        (push! (mut queue) name)
        (loop
          (when (>= index (len queue)) (break))
          (match (get edges (get queue index))
            (None [] 0)
            (Some [names]
              (for [i 0 (.cap (load names))]
                (let [entry (p/index (.slots (load names)) i)]
                  (when (and (= (.state entry) 1)
                             (not (hm-contains? [(slice u8) i64] visited (.key entry))))
                    (set! (mut visited) (.key entry) 0)
                    (push! (mut queue) (.key entry)) 0))) 0))
          (set! index (+ index 1))
          (unless transitive (break)))
        ; The queried root is an implementation detail of the traversal.
        (let [(mut result) (al-new [Sexp] a)]
          (for [i 1 (len queue)]
            (let [value (get queue i) (mut j) i]
              (loop
                (when (or (<= j 1) (>= (str-cmp value (get queue (- j 1))) 0)) (break))
                (store! (al-elem [(slice u8)] (mut queue) j) (get queue (- j 1)))
                (set! j (- j 1)))
              (store! (al-elem [(slice u8)] (mut queue) j) value)))
          (for [i 1 (len queue)] (push! (mut result) (mk-sexp (KSym (get queue i)) -1 -1)))
          (mk-sexp (KList (box! a (ArrayList Sexp) (load result))) -1 -1)))))
