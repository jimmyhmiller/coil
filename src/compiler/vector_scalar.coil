(module coil.compiler.vector_scalar)
(import "coil.primitive" :as primitive)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.vector" :use *)
(import "coil.compiler.vector_ops" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)
(import "coil.try" :use *)
(import "coil.reader" :use *)
(import "coil.mem" :use [f64-bits])

; Backends evaluate every source operand BEFORE installing these private bindings.
; The generated body contains no user expressions, so these names cannot capture
; user bindings (including source expressions that deliberately use these names).
(defn vs-argument-name [(a (dyn Allocator)) (i i64)] (-> (slice u8))
  (sconcat a "!coil.vector.argument." (i64->str a i)))

(defn vs-pointer-name [(a (dyn Allocator)) (i i64)] (-> (slice u8))
  (sconcat a "!coil.vector.pointer." (i64->str a i)))

(defn vs-expr [(a (dyn Allocator)) (kind ExprKind)] (-> (ptr Expr))
  (box-expr a (mk-expr kind -1 -1 -1 0)))

(defn vs-int [(a (dyn Allocator)) (n i64)] (-> (ptr Expr)) (vs-expr a (EInt n)))
(defn vs-var [(a (dyn Allocator)) (name (slice u8))] (-> (ptr Expr)) (vs-expr a (EVar name)))
(defn vs-arg [(a (dyn Allocator)) (i i64)] (-> (ptr Expr)) (vs-var a (vs-argument-name a i)))
(defn vs-cast [(a (dyn Allocator)) (ty Type) (value (ptr Expr))] (-> (ptr Expr))
  (vs-expr a (ECast ty value)))
(defn vs-bin [(a (dyn Allocator)) (op i64) (left (ptr Expr)) (right (ptr Expr))] (-> (ptr Expr))
  (vs-expr a (EBin op left right)))
(defn vs-cmp [(a (dyn Allocator)) (op i64) (left (ptr Expr)) (right (ptr Expr))] (-> (ptr Expr))
  (vs-expr a (ECmp op left right)))
(defn vs-not [(a (dyn Allocator)) (value (ptr Expr))] (-> (ptr Expr))
  (vs-cmp a 4 value (vs-expr a (EBool false))))
(defn vs-nan? [(a (dyn Allocator)) (value (ptr Expr))] (-> (ptr Expr))
  (vs-not a (vs-cmp a 4 value value)))
(defn vs-if [(a (dyn Allocator)) (test (ptr Expr)) (yes (ptr Expr)) (no (ptr Expr))] (-> (ptr Expr))
  (vs-expr a (EIf test yes no)))
(defn vs-load [(a (dyn Allocator)) (pointer (ptr Expr)) (index (ptr Expr))] (-> (ptr Expr))
  (vs-expr a (ELoad (vs-expr a (EIndex pointer index)))))
(defn vs-lane [(a (dyn Allocator)) (operand i64) (index (ptr Expr))] (-> (ptr Expr))
  (vs-load a (vs-var a (vs-pointer-name a operand)) index))
(defn vs-store [(a (dyn Allocator)) (pointer (ptr Expr)) (index (ptr Expr)) (value (ptr Expr))] (-> (ptr Expr))
  (vs-expr a (EStore (vs-expr a (EIndex pointer index)) value)))
(defn vs-output [(a (dyn Allocator)) (lane (ptr Type))] (-> (ptr Expr))
  (vs-cast a (TPtr lane) (vs-var a "!coil.vector.output")))
(defn vs-bitcast [(a (dyn Allocator)) (ty Type) (value (ptr Expr))] (-> (ptr Expr))
  (vs-expr a (ELoad (vs-cast a (TPtr (box-type a ty)) (vs-expr a (ESpillRef value))))))
(defn vs-bind [(name (slice u8)) (value (ptr Expr))] (-> Bind)
  (Bind :name name :mutable false :value (load value) :bid 0 :owned_type (cast (ptr Type) 0)))

(defn vs-operation [(op VectorOp)] (-> i64)
  (match op
    (VectorAdd [] 0) (VectorSub [] 1) (VectorMul [] 2) (VectorDiv [] 3)
    (VectorAnd [] 7) (VectorOr [] 8) (VectorXor [] 9)
    (VectorReduceAdd [] 0) (VectorReduceOr [] 8) (VectorReduceAnd [] 7) (VectorReduceXor [] 9)
    (_ -1)))

(defn vs-comparison [(op VectorOp)] (-> i64)
  (match op (VectorLt [] 0) (VectorLe [] 1) (VectorGt [] 2)
    (VectorGe [] 3) (VectorEq [] 4) (VectorNe [] 5) (_ -1)))

(defn vs-float [(a (dyn Allocator)) (lane Type) (value f64)] (-> (ptr Expr))
  (vs-cast a lane (vs-expr a (EFloat (f64-bits value)))))

(defn vs-libm [(a (dyn Allocator)) (name (slice u8)) (lane Type)
               (args (ptr (ArrayList Expr)))] (-> (ptr Expr))
  (let [(mut types) (al-new [Type] a)
        symbol (if (= (vector-lane-bits (box-type a lane)) 32) (sconcat a name "f") name)]
    (for [i 0 (len (load args))] (push! (mut types) lane))
    (vs-expr a (ECallPtr
      (vs-expr a (ELlvmIr (TFn "c" (box-al [Type] a (load types)) (box-type a lane))
        (box-al [Expr] a (al-new [Expr] a)) (sconcat a "coil.arch.linker-address:" symbol))) args))))

(defn vs-libm-unary [(a (dyn Allocator)) (name (slice u8)) (lane Type) (value (ptr Expr))] (-> (ptr Expr))
  (let [(mut args) (al-new [Expr] a)]
    (push! (mut args) (load value))
    (vs-libm a name lane (box-al [Expr] a (load args)))))

(defn vs-float-minmax [(a (dyn Allocator)) (maximum bool) (lane Type)
                       (left (ptr Expr)) (right (ptr Expr))] (-> (ptr Expr))
  (let [integer (TInt (vector-lane-bits (box-type a lane)) false)
        equal (vs-bitcast a lane (vs-bin a (if maximum 7 8)
                  (vs-bitcast a integer left) (vs-bitcast a integer right)))]
    (vs-if a (vs-nan? a left) left
      (vs-if a (vs-nan? a right) right
        (vs-if a (vs-cmp a 4 left right) equal
          (vs-if a (vs-cmp a (if maximum 2 0) left right) left right))))))

(defn vs-saturating [(a (dyn Allocator)) (op VectorOp) (lane Type)
                     (left (ptr Expr)) (right (ptr Expr))] (-> (ptr Expr))
  (let [lt (box-type a lane) bits (vector-lane-bits lt)
        signed (match lane (TInt [_ s] s) (_ false))
        add (match op (VectorAddSat [] true) (_ false))
        zero (vs-cast a lane (vs-int a 0))
        value (vs-cast a lane (vs-bin a (if add 0 1) left right))
        sign (primitive/ishl (cast i64 1) (- bits 1))
        minimum (vs-cast a lane (vs-int a sign))
        maximum (vs-cast a lane (vs-int a (if signed (primitive/isub sign 1) -1)))]
    (if signed
      (let [overflow (vs-cmp a 0
              (vs-bin a 7 (vs-bin a 9 left value)
                           (vs-bin a 9 (if add right left) (if add value right))) zero)]
        (vs-if a overflow (vs-if a (vs-cmp a 0 left zero) minimum maximum) value))
      (vs-if a (vs-cmp a 0 (if add value left) (if add left right))
               (if add maximum zero) value))))

(defn vs-reverse-bits [(a (dyn Allocator)) (lane Type) (value (ptr Expr))] (-> (ptr Expr))
  (let [bits (vector-lane-bits (box-type a lane)) unsigned (TInt bits false)
        (mut binds) (al-new [Bind] a) (mut body) (al-new [Expr] a)
        (mut current) (vs-cast a unsigned value) (mut step) 1]
    (loop
      (if (>= (load step) bits) (break)
        (let [shift (load step)
              mask (cond (= shift 1) 0x5555555555555555
                         (= shift 2) 0x3333333333333333
                         (= shift 4) 0x0f0f0f0f0f0f0f0f
                         (= shift 8) 0x00ff00ff00ff00ff
                         (= shift 16) 0x0000ffff0000ffff
                         :else 0x00000000ffffffff)
              m (vs-cast a unsigned (vs-int a mask))
              s (vs-cast a unsigned (vs-int a shift))
              name (sconcat a "!coil.vector.reverse." (i64->str a shift))]
          (push! (mut binds) (vs-bind name (vs-bin a 8
            (vs-bin a 10 (vs-bin a 7 (load current) m) s)
            (vs-bin a 7 (vs-bin a 11 (load current) s) m))))
          (set! current (vs-var a name))
          (set! step (* shift 2)))))
    (push! (mut body) (load (vs-cast a lane (load current))))
    (vs-expr a (ELet (box-al [Bind] a (load binds)) (box-al [Expr] a (load body))))))

(defn vs-convert [(a (dyn Allocator)) (source Type) (target Type) (value (ptr Expr))] (-> (ptr Expr))
  (if (and (= (type-tag (box-type a source)) 1) (= (type-tag (box-type a target)) 0))
    (let [bits (vector-lane-bits (box-type a target))
          signed (match target (TInt [_ s] s) (_ false))
          sign (primitive/ishl (cast i64 1) (- bits 1))
          upper (if signed (cast f64 (cast u64 sign))
                    (if (= bits 64) 18446744073709551616.0 (cast f64 (primitive/ishl (cast i64 1) bits))))
          minimum (vs-cast a target (vs-int a (if signed sign 0)))
          maximum (vs-cast a target (vs-int a (if signed (primitive/isub sign 1) -1)))
          zero (vs-cast a target (vs-int a 0))]
      (vs-if a (vs-nan? a value) zero
        (vs-if a (vs-cmp a 3 value (vs-float a source upper)) maximum
          (vs-if a (vs-cmp a 1 value (vs-float a source (if signed (primitive/fsub 0.0 upper) 0.0))) minimum
            (vs-cast a target value)))))
    (vs-cast a target value)))

(defn vs-resize-lane [(a (dyn Allocator)) (op VectorOp) (result (ptr Type))
                       (types (ptr (ArrayList Type))) (i i64)] (-> (ptr Expr))
  (let [source (al-elem [Type] types 0) src (load (t-inner source)) dst (load (t-inner result))
        widening (vector-widening? op) n (t-arrn source)
        operand (if (or widening (< i n)) 0 1)
        index (if widening (+ i (match op (VectorWidenHigh [] (t-arrn result)) (_ 0)))
                            (if (< i n) i (- i n)))
        value (vs-lane a operand (vs-int a index))]
    (if (match op (VectorNarrowSat [] true) (_ false))
      (let [db (vector-lane-bits (t-inner result))
            signed (match src (TInt [_ s] s) (_ false))
            dsigned (match dst (TInt [_ s] s) (_ false))
            upper (- (primitive/ishl (cast i64 1) (if dsigned (- db 1) db)) 1)
            lower (if (and signed dsigned) (- 0 (primitive/ishl (cast i64 1) (- db 1))) 0)
            lo (vs-cast a src (vs-int a lower)) hi (vs-cast a src (vs-int a upper))]
        (vs-cast a dst (vs-if a (vs-cmp a 0 value lo) lo (vs-if a (vs-cmp a 2 value hi) hi value))))
      (vs-convert a src dst value))))

(defn vs-round-even [(a (dyn Allocator)) (lane Type) (value (ptr Expr))] (-> (ptr Expr))
  (let [bits (vector-lane-bits (box-type a lane)) integer (TInt bits false)
        mantissa (if (= bits 32) 23 52) bias (if (= bits 32) 127 1023)
        exponent-mask (if (= bits 32) 255 2047)
        (mut binds) (al-new [Bind] a) (mut body) (al-new [Expr] a)
        raw (vs-var a "!coil.vector.round.bits")
        exponent (vs-var a "!coil.vector.round.exponent")
        shift (vs-bin a 1 (vs-cast a integer (vs-int a (+ bias mantissa))) exponent)
        one (vs-cast a integer (vs-int a 1))
        zero (vs-cast a integer (vs-int a 0))
        unit (vs-bin a 10 one shift)
        fraction-mask (vs-bin a 1 unit one)
        fraction (vs-bin a 7 raw fraction-mask)
        half (vs-bin a 11 unit one)
        integral (vs-bin a 7 raw (vs-bin a 9 fraction-mask (vs-cast a integer (vs-int a -1))))
        signmask (vs-cast a integer (vs-int a (primitive/ishl (cast i64 1) (- bits 1))))
        sign (vs-bin a 7 raw signmask)
        magnitude (vs-bin a 7 raw (vs-cast a integer (vs-int a (primitive/isub (primitive/ishl (cast i64 1) (- bits 1)) 1))))
        half-bits (vs-cast a integer (vs-int a (primitive/ishl (- bias 1) mantissa)))
        one-bits (vs-cast a integer (vs-int a (primitive/ishl bias mantissa)))
        odd (vs-cmp a 5 (vs-bin a 7 (vs-bin a 11 integral shift) one) zero)
        increment (vs-if a (vs-cmp a 2 fraction half) (vs-expr a (EBool true))
                      (vs-if a (vs-cmp a 4 fraction half) odd (vs-expr a (EBool false))))]
    (push! (mut binds) (vs-bind "!coil.vector.round.bits" (vs-bitcast a integer value)))
    (push! (mut binds) (vs-bind "!coil.vector.round.exponent"
      (vs-bin a 7 (vs-bin a 11 raw (vs-cast a integer (vs-int a mantissa)))
                   (vs-cast a integer (vs-int a exponent-mask)))))
    (push! (mut body) (load (vs-bitcast a lane
      (vs-if a (vs-cmp a 3 exponent (vs-cast a integer (vs-int a (+ bias mantissa)))) raw
        (vs-if a (vs-cmp a 0 exponent (vs-cast a integer (vs-int a bias)))
          (vs-bin a 8 sign (vs-if a (vs-cmp a 2 magnitude half-bits) one-bits zero))
          (vs-if a increment (vs-bin a 0 integral unit) integral))))))
    (vs-expr a (ELet (box-al [Bind] a (load binds)) (box-al [Expr] a (load body))))))

(defn vs-rotate [(a (dyn Allocator)) (op VectorOp) (lane Type)
                 (value (ptr Expr)) (count (ptr Expr))] (-> (ptr Expr))
  (let [bits (vector-lane-bits (box-type a lane)) integer (TInt bits false)
        mask (vs-cast a integer (vs-int a (- bits 1)))
        c (vs-bin a 7 (vs-cast a integer count) mask)
        other (vs-bin a 7 (vs-bin a 1 (vs-cast a integer (vs-int a 0)) c) mask)
        left (match op (VectorRotl [] true) (_ false))
        v (vs-cast a integer value)]
    (vs-cast a lane (vs-bin a 8 (vs-bin a 10 v (if left c other))
                                (vs-bin a 11 v (if left other c))))))

(defn vs-scalar-op [(a (dyn Allocator)) (op VectorOp) (lane Type)
                    (left (ptr Expr)) (right (ptr Expr))] (-> (Result (ptr Expr) Diag))
  (let [binary (vs-operation op) comparison (vs-comparison op)
        lt (box-type a lane) bits (vector-lane-bits lt)
        zero (vs-expr a (EZeroed lane))]
    (cond
      (>= binary 0) (Ok (vs-bin a binary left right))
      (>= comparison 0) (Ok (if (and (= comparison 5) (= (type-tag lt) 1))
                                (vs-not a (vs-cmp a 4 left right))
                                (vs-cmp a comparison left right)))
      :else
        (match op
          (VectorNot []
            (Ok (vs-bin a 9 left (vs-cast a lane (vs-int a (if (= (type-tag lt) 2) 1 -1))))))
          (VectorNeg [] (Ok (if (= (type-tag lt) 1)
            (vs-bitcast a lane (vs-bin a 9 (vs-bitcast a (TInt bits false) left)
              (vs-cast a (TInt bits false) (vs-int a (primitive/ishl (cast i64 1) (- bits 1))))))
            (vs-bin a 1 zero left))))
          (VectorIsNan [] (Ok (vs-nan? a left)))
          (VectorMin [] (Ok (if (= (type-tag lt) 1) (vs-float-minmax a false lane left right)
            (vs-if a (vs-cmp a 0 left right) left right))))
          (VectorMax [] (Ok (if (= (type-tag lt) 1) (vs-float-minmax a true lane left right)
            (vs-if a (vs-cmp a 2 left right) left right))))
          (VectorReduceMin [] (vs-scalar-op a (VectorMin) lane left right))
          (VectorReduceMax [] (vs-scalar-op a (VectorMax) lane left right))
          (VectorAbs []
            (Ok (if (= (type-tag lt) 1)
              (vs-bitcast a lane (vs-bin a 7 (vs-bitcast a (TInt bits false) left)
                (vs-cast a (TInt bits false) (vs-int a (primitive/isub (primitive/ishl (cast i64 1) (- bits 1)) 1)))))
              (vs-if a (vs-cmp a 0 left zero) (vs-bin a 1 zero left) left))))
          (VectorIsFinite []
            (let [integer (TInt bits false) exponent (if (= bits 32) 0x7f800000 0x7ff0000000000000)
                  mask (vs-cast a integer (vs-int a exponent))]
              (Ok (vs-cmp a 5 (vs-bin a 7 (vs-bitcast a integer left) mask) mask))))
          (VectorAddSat [] (Ok (vs-saturating a op lane left right)))
          (VectorSubSat [] (Ok (vs-saturating a op lane left right)))
          (VectorBitReverse [] (Ok (vs-reverse-bits a lane left)))
          (VectorSqrt [] (Ok (vs-libm-unary a "sqrt" lane left)))
          (VectorFloor [] (Ok (vs-libm-unary a "floor" lane left)))
          (VectorCeil [] (Ok (vs-libm-unary a "ceil" lane left)))
          (VectorTrunc [] (Ok (vs-libm-unary a "trunc" lane left)))
          (VectorRound [] (Ok (vs-round-even a lane left)))
          (VectorRotl [] (Ok (vs-rotate a op lane left right)))
          (VectorRotr [] (Ok (vs-rotate a op lane left right)))
          (VectorPopcount [] (Ok (vs-cast a lane (vs-expr a (EIntUnary 3 left)))))
          (VectorClz [] (Ok (vs-cast a lane (vs-expr a (EIntUnary 1 left)))))
          (VectorCtz [] (Ok (vs-cast a lane (vs-expr a (EIntUnary 2 left)))))
          (VectorBswap [] (Ok (if (= bits 8) left (vs-expr a (EIntUnary 4 left)))))
          (VectorShl [] (Ok (vs-bin a 10 left (vs-bin a 7 right (vs-cast a lane (vs-int a (- bits 1)))))))
          (VectorShr []
            (Ok (vs-cast a lane (vs-bin a 11 (vs-cast a (TInt bits false) left)
                  (vs-cast a (TInt bits false) (vs-bin a 7 right (vs-cast a lane (vs-int a (- bits 1)))))))))
          (VectorAShr []
            (Ok (vs-cast a lane (vs-bin a 11 (vs-cast a (TInt bits true) left)
                  (vs-cast a (TInt bits true) (vs-bin a 7 right (vs-cast a lane (vs-int a (- bits 1)))))))))
          (_ (Err [(ptr Expr) Diag] (derr (sconcat a "scalar vector lowering is not implemented: " (vector-op-name op)))))))))

(defn vs-scan [(a (dyn Allocator)) (op VectorOp) (result (ptr Type))] (-> (Result Expr Diag))
  (try
    (let [(mut binds) (al-new [Bind] a) (mut body) (al-new [Expr] a)
          lane (t-inner result) output (vs-output a lane) n (t-arrn result)
          (mut distance) 1]
      (push! (mut binds) (vs-bind "!coil.vector.output" (vs-expr a (ESpillRef (vs-arg a 0)))))
      (loop
        (if (>= (load distance) n) (break)
          (do
            ; Descending stores read only values from the previous tree stage.
            (for [j 0 (- n (load distance))]
              (let [i (- (- n 1) j)
                    value (try! (vs-scalar-op a (vector-scan-operation op) (load lane)
                      (vs-load a output (vs-int a i))
                      (vs-load a output (vs-int a (- i (load distance))))))]
                (push! (mut body) (load (vs-store a output (vs-int a i) value)))))
            (set! distance (* (load distance) 2)))))
      (push! (mut body) (load (vs-expr a (ELoad (vs-var a "!coil.vector.output")))))
      (Ok (mk-expr (ELet (box-al [Bind] a (load binds)) (box-al [Expr] a (load body))) -1 -1 -1 0)))))

(defn scalarize-vector [(a (dyn Allocator)) (op VectorOp) (result (ptr Type))
                         (types (ptr (ArrayList Type)))] (-> (Result Expr Diag))
  (try
    (when (vector-scan? op) (break :try (vs-scan a op result)))
    (let [(mut binds) (al-new [Bind] a) (mut body) (al-new [Expr] a)
          vector-result (= (type-tag result) 9)
          (mut answer) (vs-int a 0)]
      (for [i 0 (len (load types))]
        (let [ty (al-elem [Type] types i)]
          (match (load ty)
            (TVec [lane _]
              (push! (mut binds) (vs-bind (vs-pointer-name a i)
                (vs-cast a (TPtr lane) (vs-expr a (ESpillRef (vs-arg a i)))))))
            (_ 0))))
      (when vector-result
        (push! (mut binds) (vs-bind "!coil.vector.output"
          (vs-expr a (ESpillRef (vs-expr a (EZeroed (load result))))))))
      (match op
        (VectorCompress []
          (let [lane (t-inner result) output (vs-output a lane)
                count (vs-var a "!coil.vector.count")
                rank (vs-expr a (ELoad count))]
            (push! (mut binds) (vs-bind "!coil.vector.count" (vs-expr a (ESpillRef (vs-int a 0)))))
            (for [i 0 (t-arrn result)]
              (push! (mut body) (load (vs-store a output (vs-int a i) (vs-lane a 2 (vs-int a i))))))
            (for [i 0 (t-arrn result)]
              (let [(mut actions) (al-new [Expr] a) idx (vs-int a i)]
                (push! (mut actions) (load (vs-store a output rank (vs-lane a 0 idx))))
                (push! (mut actions) (load (vs-expr a (EStore count (vs-bin a 0 rank (vs-int a 1))))))
                (push! (mut body) (load (vs-if a (vs-lane a 1 idx)
                  (vs-expr a (EDo (box-al [Expr] a (load actions)))) (vs-int a 0))))))
            (set! answer (vs-expr a (ELoad (vs-var a "!coil.vector.output"))))))
        (VectorCompressStore []
          (let [count (vs-var a "!coil.vector.count") rank (vs-expr a (ELoad count))]
            (push! (mut binds) (vs-bind "!coil.vector.count" (vs-expr a (ESpillRef (vs-int a 0)))))
            (for [i 0 (t-arrn (al-elem [Type] types 2))]
              (let [(mut actions) (al-new [Expr] a) idx (vs-int a i)]
                (push! (mut actions) (load (vs-store a (vs-arg a 0) rank (vs-lane a 2 idx))))
                (push! (mut actions) (load (vs-expr a (EStore count (vs-bin a 0 rank (vs-int a 1))))))
                (push! (mut body) (load (vs-if a (vs-lane a 1 idx)
                  (vs-expr a (EDo (box-al [Expr] a (load actions)))) (vs-int a 0))))))))
        (VectorExpandLoad []
          (let [count (vs-var a "!coil.vector.count") rank (vs-expr a (ELoad count))
                output (vs-output a (t-inner result))]
            (push! (mut binds) (vs-bind "!coil.vector.count" (vs-expr a (ESpillRef (vs-int a 0)))))
            (for [i 0 (t-arrn result)]
              (let [(mut actions) (al-new [Expr] a) idx (vs-int a i)]
                (push! (mut actions) (load (vs-store a output idx (vs-load a (vs-arg a 0) rank))))
                (push! (mut actions) (load (vs-expr a (EStore count (vs-bin a 0 rank (vs-int a 1))))))
                (push! (mut body) (load (vs-if a (vs-lane a 1 idx)
                  (vs-expr a (EDo (box-al [Expr] a (load actions))))
                  (vs-store a output idx (vs-lane a 2 idx)))))))
            (set! answer (vs-expr a (ELoad (vs-var a "!coil.vector.output"))))))
        (VectorLanes [] (set! answer (vs-int a (t-arrn (al-elem [Type] types 0)))))
        (VectorExtract []
          (let [index (vs-cast a (TInt 64 false) (vs-arg a 1))
                n (t-arrn (al-elem [Type] types 0))]
            (set! answer (vs-if a (vs-cmp a 0 index (vs-cast a (TInt 64 false) (vs-int a n)))
              (vs-lane a 0 index) (vs-expr a (EZeroed (load result)))))))
        (VectorMaskBits []
          (for [i 0 (t-arrn (al-elem [Type] types 0))]
            (set! answer (vs-bin a 8 (vs-cast a (TInt 64 false) (load answer))
              (vs-bin a 10 (vs-cast a (TInt 64 false) (vs-lane a 0 (vs-int a i)))
                           (vs-cast a (TInt 64 false) (vs-int a i)))))))
        (_
          (if vector-result
            (let [lane (load (t-inner result))
                  output (vs-cast a (TPtr (t-inner result)) (vs-var a "!coil.vector.output"))]
              (for [i 0 (t-arrn result)]
                (let [idx (vs-int a i) zero (vs-expr a (EZeroed lane))
                      value
                        (try! (match op
                          (VectorZero [] (Ok [(ptr Expr) Diag] zero))
                          (VectorWidenLow [] (Ok [(ptr Expr) Diag] (vs-resize-lane a op result types i)))
                          (VectorWidenHigh [] (Ok [(ptr Expr) Diag] (vs-resize-lane a op result types i)))
                          (VectorNarrow [] (Ok [(ptr Expr) Diag] (vs-resize-lane a op result types i)))
                          (VectorNarrowSat [] (Ok [(ptr Expr) Diag] (vs-resize-lane a op result types i)))
                          (VectorIota [] (Ok [(ptr Expr) Diag] (vs-cast a lane idx)))
                          (VectorMaskLow [] (Ok [(ptr Expr) Diag] (vs-cmp a 2 (vs-arg a 0) idx)))
                          (VectorSplat [] (Ok [(ptr Expr) Diag] (vs-arg a 0)))
                          (VectorInsert [] (Ok [(ptr Expr) Diag] (vs-if a (vs-cmp a 4 (vs-cast a (TInt 64 false) (vs-arg a 1))
                              (vs-cast a (TInt 64 false) idx)) (vs-arg a 2) (vs-lane a 0 idx))))
                          (VectorSelect [] (Ok [(ptr Expr) Diag] (vs-if a (vs-lane a 0 idx) (vs-lane a 1 idx) (vs-lane a 2 idx))))
                          (VectorLoad [] (Ok [(ptr Expr) Diag] (vs-load a (vs-arg a 0) idx)))
                          (VectorLoadAligned [] (Ok [(ptr Expr) Diag] (vs-load a (vs-arg a 0) idx)))
                          (VectorMaskedLoad [] (Ok [(ptr Expr) Diag] (vs-if a (vs-lane a 1 idx) (vs-load a (vs-arg a 0) idx) (vs-lane a 2 idx))))
                          (VectorGather [] (Ok [(ptr Expr) Diag] (vs-if a (vs-lane a 2 idx) (vs-load a (vs-arg a 0) (vs-lane a 1 idx)) (vs-lane a 3 idx))))
                          (VectorBitsMask [] (Ok [(ptr Expr) Diag] (vs-cmp a 5
                            (vs-bin a 7 (vs-bin a 11 (vs-arg a 0) (vs-cast a (TInt 64 false) idx))
                                         (vs-cast a (TInt 64 false) (vs-int a 1)))
                            (vs-cast a (TInt 64 false) (vs-int a 0)))))
                          (VectorConvert [] (Ok [(ptr Expr) Diag]
                            (vs-convert a (load (t-inner (al-elem [Type] types 0))) lane (vs-lane a 0 idx))))
                          (VectorFma []
                            (let [(mut operands) (al-new [Expr] a)]
                              (for [j 0 3] (push! (mut operands) (load (vs-lane a j idx))))
                              (Ok [(ptr Expr) Diag] (vs-libm a "fma" lane (box-al [Expr] a (load operands))))))
                          (VectorBitcast [] (Ok [(ptr Expr) Diag]
                            (vs-load a (vs-cast a (TPtr (box-type a lane)) (vs-var a (vs-pointer-name a 0))) idx)))
                          (VectorTable []
                            (let [index (vs-cast a (TInt 64 false) (vs-lane a 1 idx))
                                  n (vs-cast a (TInt 64 false) (vs-int a (t-arrn (al-elem [Type] types 0))))]
                              (Ok [(ptr Expr) Diag] (vs-if a (vs-cmp a 0 index n) (vs-lane a 0 index) zero))))
                          (VectorShuffle []
                            (let [index (vs-cast a (TInt 64 false) (vs-lane a 2 idx))
                                  n (vs-cast a (TInt 64 false) (vs-int a (t-arrn (al-elem [Type] types 0))))
                                  twice (vs-bin a 0 n n)]
                              (Ok [(ptr Expr) Diag] (vs-if a (vs-cmp a 0 index n) (vs-lane a 0 index)
                                (vs-if a (vs-cmp a 0 index twice) (vs-lane a 1 (vs-bin a 1 index n)) zero)))))
                          (_ (vs-scalar-op a op (load (t-inner (al-elem [Type] types 0)))
                                (vs-lane a 0 idx) (if (> (len (load types)) 1) (vs-lane a 1 idx) zero)))))]
                  (push! (mut body) (load (vs-expr a (EStore (vs-expr a (EIndex output idx)) value))))))
              (set! answer (vs-expr a (ELoad (vs-var a "!coil.vector.output")))))
            (if (vector-memory-store? op)
              (let [vi (- (len (load types)) 1) masked (vector-memory-masked? op)
                    indexed (vector-memory-indexed? op)]
                (for [i 0 (t-arrn (al-elem [Type] types vi))]
                  (let [idx (vs-int a i)
                        store (vs-expr a (EStore (vs-expr a (EIndex (vs-arg a 0)
                                          (if indexed (vs-lane a 1 idx) idx)))
                                          (vs-lane a vi idx)))]
                    (push! (mut body) (load (if masked
                      (vs-if a (vs-lane a (if indexed 2 1) idx) store (vs-int a 0)) store))))))
              (if (vector-reduction? op)
                (let [accumulator (vs-var a "!coil.vector.accumulator")]
                  (push! (mut binds) (vs-bind "!coil.vector.accumulator"
                    (vs-expr a (ESpillRef (vs-lane a 0 (vs-int a 0))))))
                  (for [i 1 (t-arrn (al-elem [Type] types 0))]
                    (push! (mut body) (load (vs-expr a (EStore accumulator
                      (try! (vs-scalar-op a op (load result) (vs-expr a (ELoad accumulator)) (vs-lane a 0 (vs-int a i)))))))))
                  (set! answer (vs-expr a (ELoad accumulator))))
                (break :try (Err [Expr Diag] (derr (sconcat a "scalar vector lowering is not implemented: " (vector-op-name op))))))))))
      (push! (mut body) (load (load answer)))
      (Ok (mk-expr (ELet (box-al [Bind] a (load binds)) (box-al [Expr] a (load body))) -1 -1 -1 0)))))
