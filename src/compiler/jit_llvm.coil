;;; LLVM JIT with one session-wide ORC linker and independently owned objects.
;;; LLVM modules, contexts, target machines, and compiler scratch are temporary.
(module coil.compiler.jit_llvm)
(import "coil.hashmap" :use *)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use [starts-with str-concat str->cstr])
(import "coil.io" :use [stderr print-str write-byte])
(import "coil.scratch" :as scratch)
(import "coil.sync" :as sync)
(import "coil.compiler.ast" :use [Program])
(import "coil.compiler.codegen" :use [codegen-module codegen-dispose-module! llvm-cpu llvm-cpu-features llvm-reloc-model])
(import "coil.compiler.ffi" :use *)
(import "coil.compiler.orc" :use *)
(import "coil.compiler.parser" :use [sconcat i64->str])
(import "coil.compiler.loader" :use [cstr->slice ls-copy-list])

(defstruct LLVMJitSym [(name (slice u8)) (addr (ptr i8)) (owner (ptr i8))])
(defstruct LLVMJitGeneration
  [(tracker (ptr i8)) (dylib (ptr i8)) (pinned bool) (current bool)
   (leases i64) (dependencies (ArrayList (ptr i8)))
   (metadata-root bool) (marked bool) (scanned bool)])
(defstruct LLVMJitState
  [(jit (ptr i8)) (next-id i64) (spare-dylibs (ArrayList (ptr i8)))
   (generations (ArrayList LLVMJitGeneration)) (syms (ArrayList LLVMJitSym))])
(defstruct LLVMJitPublication [(name (slice u8)) (is-static bool)])

(defn llvm-jit-error? [(error (ptr i8))] (-> bool)
  (if (= (primitive/cast i64 error) 0) false
    (let [message (LLVMGetErrorMessage error)]
      (print-str (stderr) "error: LLVM JIT: ")
      (print-str (stderr) (cstr->slice message))
      (write-byte (stderr) (primitive/cast u8 10))
      (LLVMDisposeErrorMessage message)
      true)))
(defn llvm-jit-demand! [(error (ptr i8))] (-> i64)
  (when (llvm-jit-error? error) (abort) 0) 0)

(defn llvm-jit-state [(a (dyn Allocator)) (slot (ptr (ptr i8)))] (-> (ptr LLVMJitState))
  (when (= (primitive/cast i64 (load slot)) 0)
    (LLVMInitializeAArch64AsmPrinter)
    (LLVMInitializeAArch64AsmParser)
    (LLVMInitializeX86AsmPrinter)
    (LLVMInitializeX86AsmParser)
    (let [s (box! a LLVMJitState (primitive/zeroed LLVMJitState))]
      (llvm-jit-demand! (LLVMOrcCreateLLJIT (field s jit) (primitive/cast (ptr i8) 0)))
      (set! (.generations s) (al-new [LLVMJitGeneration] a))
      (set! (.syms s) (al-new [LLVMJitSym] a))
      (set! (.spare-dylibs s) (al-new [(ptr i8)] a))
      (set! slot (primitive/cast (ptr i8) s))) 0)
  (primitive/cast (ptr LLVMJitState) (load slot)))
(defn llvm-jit-sym-lookup [(s (ptr LLVMJitState)) (name (slice u8))] (-> (ptr i8))
  (let [n (len (.syms s))
        (mut i) (- n 1)
        (mut result) (primitive/cast (ptr i8) 0)]
    (loop (if (< (load i) 0)
              (break)
              (do
                (let [sym (al-elem [LLVMJitSym] (field s syms) (load i))]
                  (when (= (load (field sym name)) name)
                    (store! result (load (field sym addr)))
                    (break)))
                (set! i (- (load i) 1)))))
    (load result)))

(defn llvm-jit-externalize-prior! [(module (ptr i8))
                                   (state (ptr LLVMJitState))] (-> i64)
  (let [(mut global) (LLVMGetFirstGlobal module)]
    (loop (if (= (primitive/cast i64 (load global)) (primitive/cast i64 0))
              (break)
              (do
                (let [name (cstr->slice (LLVMGetValueName (load global)))]
                  (when (starts-with name "repl_static.")
                    ; Static cells cross object boundaries and must be visible to
                    ; the object linker, even on their defining submission.
                    (LLVMSetLinkage (load global) (primitive/cast i32 0))
                    (unless (= (primitive/cast i64 (llvm-jit-sym-lookup state name)) 0)
                      (LLVMSetInitializer (load global) (primitive/cast (ptr i8) 0)) 0)
                    0))
                (set! global (LLVMGetNextGlobal (load global))))))
    0))

(defn llvm-jit-required? [(state (ptr LLVMJitState)) (owner (ptr i8))] (-> bool)
  (block :found
    (for [i 0 (len (.generations state))]
      (let [generation (al-elem [LLVMJitGeneration] (field state generations) i)]
        (for [j 0 (len (.dependencies generation))]
          (when (= (primitive/cast i64 (get (.dependencies generation) j)) (primitive/cast i64 owner))
            (break :found true)))))
    false))

(defn llvm-jit-forget-symbols! [(state (ptr LLVMJitState)) (owner (ptr i8))] (-> i64)
  (let [(mut write) 0]
    (for [i 0 (len (.syms state))]
      (let [symbol (al-elem [LLVMJitSym] (field state syms) i)]
        (if (= (primitive/cast i64 (.owner symbol)) (primitive/cast i64 owner))
            (do (free [u8] (.alc (.syms state)) (.name symbol)) 0)
            (do
              (set! (al-elem [LLVMJitSym] (field state syms) (load write)) (load symbol))
              (set! write (+ (load write) 1)) 0))))
    (set! (.len (.syms state)) (load write)))
  0)

(defn llvm-jit-generation-count [(slot (ptr (ptr i8)))] (-> i64)
  (if (= (primitive/cast i64 (load slot)) 0)
      0
      (len (.generations (primitive/cast (ptr LLVMJitState) (load slot))))))

(defn llvm-jit-retain-current! [(slot (ptr (ptr i8)))] (-> i64)
  (if (= (primitive/cast i64 (load slot)) 0)
      -1
      (let [state (primitive/cast (ptr LLVMJitState) (load slot))
            (mut token) -1]
        (for [i 0 (len (.generations state))]
          (let [generation
                  (al-elem [LLVMJitGeneration] (field state generations) i)]
            (if (.current generation)
                (do
                  (set! (.leases generation) (+ (.leases generation) 1))
                  (set! token (primitive/cast i64 (.tracker generation))))
                0)))
        (load token))))

(defn llvm-jit-release-token! [(slot (ptr (ptr i8))) (token i64)] (-> i64)
  (if (= (primitive/cast i64 (load slot)) 0)
      -1
      (let [state (primitive/cast (ptr LLVMJitState) (load slot))
            (mut result) -1]
        (for [i 0 (len (.generations state))]
          (let [generation
                  (al-elem [LLVMJitGeneration] (field state generations) i)]
            (if (= (primitive/cast i64 (.tracker generation)) token)
                (if (> (.leases generation) 0)
                    (do
                      (set! (.leases generation) (- (.leases generation) 1))
                      (set! result (.leases generation)))
                    0)
                0)))
        (load result))))

(defn llvm-jit-token-leases [(slot (ptr (ptr i8)))] (-> i64)
  (if (= (primitive/cast i64 (load slot)) 0)
      0
      (let [state (primitive/cast (ptr LLVMJitState) (load slot))
            (mut total) 0]
        (for [i 0 (len (.generations state))]
          (set! total
                (+ (load total)
                   (.leases (al-elem [LLVMJitGeneration]
                                     (field state generations)
                                     i)))))
        (load total))))

(defn llvm-jit-reclaim! [(slot (ptr (ptr i8))) (all bool)] (-> i64)
  (if (= (primitive/cast i64 (load slot)) 0)
      0
      (let [state (primitive/cast (ptr LLVMJitState) (load slot))
            (mut read) 0
            (mut write) 0
            (mut reclaimed) 0
            n (len (.generations state))]
        (unless all (llvm-jit-mark-images! state) 0)
        (loop (if (>= (load read) n)
                  (break)
                  (let [generation
                          (al-elem [LLVMJitGeneration]
                                   (field state generations)
                                   (load read))
                        remove (or all (not (.marked generation)))]
                    (if remove
                        (do
                          (llvm-jit-forget-symbols! state (.tracker generation))
                          (llvm-jit-demand! (LLVMOrcResourceTrackerRemove (.tracker generation)))
                          (LLVMOrcReleaseResourceTracker (.tracker generation))
                          (llvm-jit-demand! (LLVMOrcJITDylibClear (.dylib generation)))
                          (push! (mut (.spare-dylibs state)) (.dylib generation))
                          (al-free! [(ptr i8)] (mut (.dependencies generation)))
                          (set! reclaimed (+ (load reclaimed) 1)))
                        (do
                          (if (!= (load write) (load read))
                              (set! (primitive/index (load (field (field state
                                                                         generations)
                                                                  data))
                                                     (load write))
                                    (load generation))
                              0)
                          (set! write (+ (load write) 1))))
                    (set! read (+ (load read) 1)))))
        (set! (field (field state generations) len) (load write))
        (if all
            (do
              (let [a (.alc (.generations state))]
                (llvm-jit-demand! (LLVMOrcDisposeLLJIT (.jit state)))
                (al-free! [LLVMJitGeneration] (mut (.generations state)))
                (al-free! [LLVMJitSym] (mut (.syms state)))
                (al-free! [(ptr i8)] (mut (.spare-dylibs state)))
                (free [LLVMJitState] a (slice-new state 1)))
              (set! slot (primitive/cast (ptr i8) 0)))
            0)
        (load reclaimed))))

(defn llvm-jit-verify [(module (ptr i8))] (-> bool)
  (let [message (primitive/alloc-stack (ptr i8))]
    (set! message (primitive/cast (ptr i8) 0))
    (if (= (LLVMVerifyModule module 2 message) (primitive/cast i32 0))
        true
        (do
          (print-str (stderr)
                     "error: REPL JIT produced an invalid LLVM module: ")
          (unless (= (primitive/cast i64 (load message)) (primitive/cast i64 0))
            (print-str (stderr) (cstr->slice (load message)))
            (LLVMDisposeMessage (load message))
            0)
          (write-byte (stderr) (primitive/cast u8 10))
          false))))


(defn llvm-jit-copy-name [(a (dyn Allocator)) (name (slice u8))] (-> (slice u8))
  (match (str-concat a name "") (Some [copy] copy) (None [] (do (abort) ""))))
(defn llvm-jit-sync! [T] [(result (Result T sync/SyncError))] (-> T)
  (match result (Ok [value] value) (Err [_] (do (abort) (primitive/zeroed T)))))
(defstruct LLVMJitLookup
  [(mutex sync/Mutex) (condition sync/Condition) (done bool) (address i64) (error (ptr i8))])
(defn llvm-jit-found [(error (ptr i8)) (symbols (ptr SymbolPair)) (count i64) (raw (ptr i8))] (-> void)
  (let [result (primitive/cast (ptr LLVMJitLookup) raw)]
    (llvm-jit-sync! (sync/mutex-lock! (field result mutex)))
    (set! (.error result) error)
    (when (and (= (primitive/cast i64 error) 0) (= count 1))
      (set! (.address result) (.address (.symbol symbols))) 0)
    (set! (.done result) true)
    (llvm-jit-sync! (sync/condition-notify-one! (field result condition)))
    (llvm-jit-sync! (sync/mutex-unlock! (field result mutex))))
  (do))
(defn llvm-jit-lookup [(a (dyn Allocator)) (state (ptr LLVMJitState))
                       (dylib (ptr i8)) (name (slice u8))] (-> i64)
  (let [result (box! a LLVMJitLookup (primitive/zeroed LLVMJitLookup))
        order (primitive/alloc-stack SearchOrder)
        symbol (primitive/alloc-stack LookupSymbol)]
    (llvm-jit-sync! (sync/mutex-init-with-allocator (field result mutex) a))
    (llvm-jit-sync! (sync/condition-init-with-allocator (field result condition) a))
    (set! order (SearchOrder :dylib dylib :flags (primitive/cast i32 1)))
    (set! symbol (LookupSymbol
      :name (LLVMOrcLLJITMangleAndIntern (.jit state) (str->cstr a name))
      :flags (primitive/cast i32 0)))
    (LLVMOrcExecutionSessionLookup (LLVMOrcLLJITGetExecutionSession (.jit state))
      (primitive/cast i32 0) order 1 symbol 1 (primitive/fnptr-of llvm-jit-found)
      (primitive/cast (ptr i8) result))
    (llvm-jit-sync! (sync/mutex-lock! (field result mutex)))
    (loop (if (.done result) (break)
      (llvm-jit-sync! (sync/condition-wait! (field result condition) (field result mutex)))))
    (llvm-jit-sync! (sync/mutex-unlock! (field result mutex)))
    (llvm-jit-sync! (sync/condition-destroy! (field result condition)))
    (llvm-jit-sync! (sync/mutex-destroy! (field result mutex)))
    (if (llvm-jit-error? (.error result)) 0 (.address result))))

(defn llvm-jit-dylib [(a (dyn Allocator)) (state (ptr LLVMJitState))] (-> (ptr i8))
  (if (> (len (.spare-dylibs state)) 0)
    (let [i (- (len (.spare-dylibs state)) 1) jd (get (.spare-dylibs state) i)]
      (set! (.len (field state spare-dylibs)) i) jd)
    (let [name (sconcat a "submission." (i64->str a (.next-id state)))
          jd (LLVMOrcExecutionSessionCreateBareJITDylib
            (LLVMOrcLLJITGetExecutionSession (.jit state)) (str->cstr a name))
          generator (primitive/alloc-stack (ptr i8))]
      (set! (.next-id state) (+ (.next-id state) 1))
      (llvm-jit-demand! (LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess generator
        (LLVMOrcLLJITGetGlobalPrefix (.jit state))
        (primitive/cast (ptr i8) 0) (primitive/cast (ptr i8) 0)))
      (LLVMOrcJITDylibAddGenerator jd (load generator))
      jd)))

;;; Only imported symbols referenced by the new object establish dependencies.
(defn llvm-jit-import! [(a (dyn Allocator)) (state (ptr LLVMJitState)) (name (slice u8))
                         (symbols (mut (ArrayList SymbolPair)))
                         (dependencies (mut (ArrayList (ptr i8))))] (-> i64)
  (block :found
    (let [(mut i) (len (.syms state))]
      (loop (if (= (load i) 0) (break)
        (do (set! i (- (load i) 1))
          (let [symbol (al-elem [LLVMJitSym] (field state syms) (load i))]
            (when (= (.name symbol) name)
              (push! (mut symbols) (SymbolPair
                :name (LLVMOrcLLJITMangleAndIntern (.jit state) (str->cstr a name))
                :symbol (EvaluatedSymbol :address (primitive/cast i64 (.addr symbol))
                  :flags (SymbolFlags :generic (primitive/cast u8 1) :target (primitive/cast u8 0)))))
              (let [(mut found) false]
                (for [j 0 (len (load dependencies))]
                  (when (= (primitive/cast i64 (get (load dependencies) j)) (primitive/cast i64 (.owner symbol)))
                    (set! found true) 0))
                (unless (load found) (push! (mut dependencies) (.owner symbol)) 0))
              (return-from :found 0)) 0)))))
    0))

(defn llvm-jit-module-symbols! [(a (dyn Allocator)) (module (ptr i8)) (state (ptr LLVMJitState))
                                 (dylib (ptr i8)) (publications (mut (ArrayList LLVMJitPublication)))
                                 (dependencies (mut (ArrayList (ptr i8))))] (-> bool)
  (let [(mut aliases) (al-new [SymbolPair] a) (mut function) (LLVMGetFirstFunction module)]
    (loop (if (= (primitive/cast i64 (load function)) 0) (break)
      (do
        (let [f (load function) name (cstr->slice (LLVMGetValueName f))]
          (if (= (LLVMIsDeclaration f) (primitive/cast i32 0))
            (unless (or (= (LLVMGetLinkage f) (primitive/cast i32 8))
                        (= (LLVMGetLinkage f) (primitive/cast i32 9)))
              (push! (mut publications) (LLVMJitPublication :name (llvm-jit-copy-name a name) :is-static false)) 0)
            (unless (= (primitive/cast i64 (LLVMGetFirstUse f)) 0)
              (llvm-jit-import! a state name (mut aliases) (mut dependencies)) 0)))
        (set! function (LLVMGetNextFunction (load function))))))
    (let [(mut global) (LLVMGetFirstGlobal module)]
      (loop (if (= (primitive/cast i64 (load global)) 0) (break)
        (do
          (let [g (load global) name (cstr->slice (LLVMGetValueName g))]
            (if (= (LLVMIsDeclaration g) (primitive/cast i32 0))
              (when (starts-with name "repl_static.")
                (push! (mut publications) (LLVMJitPublication :name (llvm-jit-copy-name a name) :is-static true)) 0)
              (unless (= (primitive/cast i64 (LLVMGetFirstUse g)) 0)
                (llvm-jit-import! a state name (mut aliases) (mut dependencies)) 0)))
          (set! global (LLVMGetNextGlobal (load global)))))))
    (if (= (len (load aliases)) 0) true
      (let [mu (LLVMOrcAbsoluteSymbols (.data aliases) (len (load aliases)))
            error (LLVMOrcJITDylibDefine dylib mu)]
        (if (llvm-jit-error? error)
          (do (LLVMOrcDisposeMaterializationUnit mu) false)
          true)))))

(defn llvm-jit-emit-object [(module (ptr i8))] (-> (ptr i8))
  (let [triple (LLVMGetDefaultTargetTriple) target (primitive/alloc-stack (ptr i8))
        error (primitive/alloc-stack (ptr i8)) object (primitive/alloc-stack (ptr i8))]
    (set! object (primitive/cast (ptr i8) 0))
    (set! error (primitive/cast (ptr i8) 0))
    (if (!= (LLVMGetTargetFromTriple triple target error) (primitive/cast i32 0))
      (do (LLVMDisposeMessage (load error)) 0)
      (let [machine (LLVMCreateTargetMachine (load target) triple (llvm-cpu triple)
                       (llvm-cpu-features triple) 0 (llvm-reloc-model triple) 0)]
        (when (!= (LLVMTargetMachineEmitToMemoryBuffer machine module (primitive/cast i32 1) error object)
                  (primitive/cast i32 0))
          (print-str (stderr) (cstr->slice (load error)))
          (LLVMDisposeMessage (load error))
          (set! object (primitive/cast (ptr i8) 0)) 0)
        (LLVMDisposeTargetMachine machine) 0))
    (LLVMDisposeMessage triple)
    (codegen-dispose-module! module)
    (load object)))

(defn jit-llvm-run-scratch [(scratch-a (dyn Allocator)) (a (dyn Allocator)) (mp (ptr Program))
                             (state-slot (ptr (ptr i8)))
                             (entry-symbol (slice u8))] (-> i64)
  (let [module (codegen-module scratch-a mp (primitive/cast (ptr i8) 0) 0 false)
        state (llvm-jit-state a state-slot)
        jd (llvm-jit-dylib scratch-a state)
        tracker (LLVMOrcJITDylibCreateResourceTracker jd)
        (mut publications) (al-new [LLVMJitPublication] scratch-a)
        (mut dependencies) (al-new [(ptr i8)] scratch-a)
        (mut addresses) (al-new [i64] scratch-a)
        (mut pinned) false
        status
          (block :candidate
            (llvm-jit-externalize-prior! module state)
            (unless (llvm-jit-verify module)
              (codegen-dispose-module! module) (return-from :candidate 1))
            (unless (llvm-jit-module-symbols! scratch-a module state jd (mut publications) (mut dependencies))
              (codegen-dispose-module! module) (return-from :candidate 1))
            (let [object (llvm-jit-emit-object module)]
              (when (= (primitive/cast i64 object) 0) (return-from :candidate 1))
              (when (llvm-jit-error? (LLVMOrcLLJITAddObjectFileWithRT (.jit state) tracker object))
                (return-from :candidate 1)))
            ; Materialize and resolve every exported address before executing the
            ; transaction. Nothing below references a compiler or LLVM IR object.
            (for [i 0 (len (load publications))]
              (let [publication (al-elem [LLVMJitPublication] (mut publications) i)
                    address (llvm-jit-lookup scratch-a state jd (.name publication))]
                (when (= address 0) (return-from :candidate 1))
                (push! (mut addresses) address)
                (when (.is-static publication) (set! pinned true) 0)))
            (let [entry (llvm-jit-lookup scratch-a state jd entry-symbol)]
              (if (= entry 0) 1
                (primitive/call-ptr (primitive/cast (fnptr c [] i64) (primitive/cast (ptr i8) entry))))))]
    (if (!= status 0)
      (do
        (llvm-jit-demand! (LLVMOrcResourceTrackerRemove tracker))
        (LLVMOrcReleaseResourceTracker tracker)
        (llvm-jit-demand! (LLVMOrcJITDylibClear jd))
        (push! (mut (.spare-dylibs state)) jd)
        status)
      (do
        (for [i 0 (len (.generations state))]
          (set! (.current (al-elem [LLVMJitGeneration] (field state generations) i)) false))
        (for [i 0 (len (load publications))]
          (let [publication (al-elem [LLVMJitPublication] (mut publications) i)]
            (push! (mut (.syms state)) (LLVMJitSym :name (llvm-jit-copy-name a (.name publication))
              :addr (primitive/cast (ptr i8) (get (load addresses) i)) :owner tracker))))
        (push! (mut (.generations state)) (LLVMJitGeneration :tracker tracker :dylib jd
          :pinned (load pinned) :current true :leases 0
          :dependencies (ls-copy-list [(ptr i8)] a (load dependencies))
          :metadata-root false :marked false :scanned false))
        0))))

(defn jit-llvm-run [(a (dyn Allocator)) (mp (ptr Program))
                     (paths (ptr (ArrayList (slice u8)))) (texts (ptr (ArrayList (slice u8))))
                     (state-slot (ptr (ptr i8)))
                     (entry-symbol (slice u8))] (-> i64)
  (let [arena (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap arena a 65536)
    (let [result (jit-llvm-run-scratch (scratch/scratch-allocator arena) a mp state-slot entry-symbol)]
      (scratch/scratch-close! arena)
      result)))

(defn jit-llvm-build-object [(a (dyn Allocator))
                             (mp (ptr Program))
                             (out (ptr i8))] (-> i64)
  (let [module (codegen-module a mp (primitive/cast (ptr i8) 0) 0 false)
        triple (LLVMGetDefaultTargetTriple)
        target-out (primitive/alloc-stack (ptr i8))
        error-out (primitive/alloc-stack (ptr i8))]
    (LLVMInitializeAArch64AsmPrinter)
    (LLVMInitializeAArch64AsmParser)
    (LLVMInitializeX86AsmPrinter)
    (LLVMInitializeX86AsmParser)
    (set! error-out (primitive/cast (ptr i8) 0))
    (if (!= (LLVMGetTargetFromTriple triple target-out error-out)
            (primitive/cast i32 0))
        (do
          (print-str (stderr) "error: REPL LLVM target initialization failed\n")
          (unless (= (primitive/cast i64 (load error-out)) 0)
            (LLVMDisposeMessage (load error-out))
            0)
          (LLVMDisposeMessage triple)
          (codegen-dispose-module! module)
          1)
        (let [machine
                (LLVMCreateTargetMachine (load target-out)
                                         triple
                                         (llvm-cpu triple)
                                         (llvm-cpu-features triple)
                                         0
                                         (llvm-reloc-model triple)
                                         0)
              emit-error (primitive/alloc-stack (ptr i8))
              rc (LLVMTargetMachineEmitToFile machine module out 1 emit-error)]
          (when (!= rc (primitive/cast i32 0))
            (print-str (stderr)
                       "error: REPL metaprogram object emission failed: ")
            (unless (= (primitive/cast i64 (load emit-error))
                       (primitive/cast i64 0))
              (print-str (stderr) (cstr->slice (load emit-error)))
              (LLVMDisposeMessage (load emit-error))
              0)
            (write-byte (stderr) (primitive/cast u8 10))
            0)
          (LLVMDisposeTargetMachine machine)
          (LLVMDisposeMessage triple)
          (codegen-dispose-module! module)
          (primitive/cast i64 rc)))))

(defn llvm-jit-set-roots! [(slot (ptr (ptr i8))) (names (ptr (HashMap (slice u8) i64)))] (-> i64)
  (unless (= (primitive/cast i64 (load slot)) 0)
    (let [state (primitive/cast (ptr LLVMJitState) (load slot))]
      (for [i 0 (len (.generations state))]
        (let [g (al-elem [LLVMJitGeneration] (field state generations) i)]
          (set! (.metadata-root g) false)
          (for [j 0 (len (.syms state))]
            (let [symbol (al-elem [LLVMJitSym] (field state syms) j)]
              (when (and (= (.owner symbol) (.tracker g))
                         (hm-contains? [(slice u8) i64] (load names) (.name symbol)))
                (set! (.metadata-root g) true) 0)))))) 0)
  0)
(defn llvm-jit-mark-images! [(state (ptr LLVMJitState))] (-> i64)
  (for [i 0 (len (.generations state))]
    (let [g (al-elem [LLVMJitGeneration] (field state generations) i)]
      (set! (.marked g) (or (.current g) (or (.pinned g) (or (.metadata-root g) (> (.leases g) 0)))))
      (set! (.scanned g) false)))
  (loop
    (let [(mut progress) false]
      (for [i 0 (len (.generations state))]
        (let [g (al-elem [LLVMJitGeneration] (field state generations) i)]
          (when (and (.marked g) (not (.scanned g)))
            (set! (.scanned g) true) (set! progress true)
            (for [j 0 (len (.dependencies g))]
              (for [k 0 (len (.generations state))]
                (let [dependency (al-elem [LLVMJitGeneration] (field state generations) k)]
                  (when (= (.tracker dependency) (get (.dependencies g) j))
                    (set! (.marked dependency) true) 0)))) 0)))
      (unless (load progress) (break))))
  0)
