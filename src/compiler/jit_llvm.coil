; Linux/x86-64 in-process JIT backed by LLVM MCJIT.

;
; Each successful submission owns an execution engine. Later modules import
; retained functions with their original Coil ABI and reuse stable static storage.
; Symbol ownership and engine dependencies keep borrowed code mapped until its
; dependents and caller/compiler leases have retired.
(module coil.compiler.jit_llvm)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [Allocator box!])
(import "coil.arraylist" :use [ArrayList al-elem al-len al-new al-push!])
(import "coil.slice" :use [slice-len])
(import "coil.str" :use [starts-with])
(import "coil.io" :use [stderr print-str write-byte])
(import "coil.compiler.ast" :use [Program])
(import "coil.compiler.codegen"
        :use
        [codegen-module
         codegen-dispose-module!
         llvm-cpu
         llvm-cpu-features
         llvm-reloc-model])
(import "coil.compiler.ffi" :use *)
(import "coil.compiler.loader" :use [cstr->slice])

(defstruct LLVMJitSym [(name (slice u8)) (addr (ptr i8)) (owner (ptr i8))])

(defstruct LLVMJitGeneration
  [(engine (ptr i8))
   (context (ptr i8))
   (pinned bool)
   (current bool)
   (leases i64)
   (dependencies (ArrayList (ptr i8)))])

(defstruct LLVMJitState
  [(generations (ArrayList LLVMJitGeneration))
   (syms (ArrayList LLVMJitSym))])

(defn llvm-jit-state [(a (dyn Allocator)) (slot (ptr (ptr i8)))] (-> (ptr LLVMJitState))
  (if (= (primitive/cast i64 (load slot)) (primitive/cast i64 0))
      (let [s (box! a LLVMJitState (primitive/zeroed LLVMJitState))]
        (set! (.generations s) (al-new [LLVMJitGeneration] a))
        (set! (.syms s) (al-new [LLVMJitSym] a))
        (set! slot (primitive/cast (ptr i8) s))
        s)
      (primitive/cast (ptr LLVMJitState) (load slot))))

(defn llvm-jit-sym-lookup [(s (ptr LLVMJitState)) (name (slice u8))] (-> (ptr i8))
  (let [n (len (.syms s))
        (mut i) (- n 1)
        (mut result) (primitive/cast (ptr i8) 0)]
    (loop (if (< (load i) 0)
              (break)
              (do
                (let [sym (al-elem [LLVMJitSym] (field s syms) (load i))]
                  (when (= (load (field sym name)) name)
                    (store! result (load (field sym addr)))
                    (break)))
                (set! i (- (load i) 1)))))
    (load result)))

(defn llvm-jit-map-prior! [(module (ptr i8))
                           (engine (ptr i8))
                           (state (ptr LLVMJitState))
                           (dependencies (ptr (ArrayList (ptr i8))))] (-> i64)
  (let [(mut global) (LLVMGetFirstGlobal module)]
    (loop (if (= (primitive/cast i64 (load global)) (primitive/cast i64 0))
              (break)
              (do
                (let [name (cstr->slice (LLVMGetValueName (load global)))]
                  (when (starts-with name "repl_static.")
                    (let [prior (llvm-jit-sym-lookup state name)]
                      (unless (= (primitive/cast i64 prior)
                                 (primitive/cast i64 0))
                        (LLVMAddGlobalMapping engine (load global) prior)
                        0))))
                (set! global (LLVMGetNextGlobal (load global))))))
    (let [(mut function) (LLVMGetFirstFunction module)]
      (loop (if (= (primitive/cast i64 (load function)) 0) (break)
        (do
          (when (!= (LLVMIsDeclaration (load function)) (primitive/cast i32 0))
            (let [name (cstr->slice (LLVMGetValueName (load function)))
                  prior (llvm-jit-sym-lookup state name)]
              (unless (= (primitive/cast i64 prior) 0)
                (LLVMAddGlobalMapping engine (load function) prior)
                (for [i 0 (len (.syms state))]
                  (let [symbol (al-elem [LLVMJitSym] (field state syms) i)]
                    (when (= (primitive/cast i64 (.addr symbol)) (primitive/cast i64 prior))
                      (push! dependencies (.owner symbol))
                      0)))
                0))
            0)
          (set! function (LLVMGetNextFunction (load function)))))))
    0))

; A prior alloc-static is storage owned by the previous engine. Turn this module's
; duplicate definition into a declaration before MCJIT sees it; the subsequent
; global mapping then supplies the declaration's stable address.
(defn llvm-jit-externalize-prior! [(module (ptr i8))
                                   (state (ptr LLVMJitState))] (-> i64)
  (let [(mut global) (LLVMGetFirstGlobal module)]
    (loop (if (= (primitive/cast i64 (load global)) (primitive/cast i64 0))
              (break)
              (do
                (let [name (cstr->slice (LLVMGetValueName (load global)))]
                  (when (and (starts-with name "repl_static.")
                             (!= (primitive/cast i64
                                                 (llvm-jit-sym-lookup state
                                                                      name))
                                 (primitive/cast i64 0)))
                    (LLVMSetInitializer (load global)
                                        (primitive/cast (ptr i8) 0))
                    0))
                (set! global (LLVMGetNextGlobal (load global))))))
    0))

(defn llvm-jit-record-statics! [(module (ptr i8))
                                (engine (ptr i8))
                                (state (ptr LLVMJitState))] (-> i64)
  (let [(mut global) (LLVMGetFirstGlobal module)
        (mut added) 0]
    (loop (if (= (primitive/cast i64 (load global)) (primitive/cast i64 0))
              (break)
              (do
                (let [namec (LLVMGetValueName (load global))
                      name (cstr->slice namec)]
                  (when (and (starts-with name "repl_static.")
                             (= (primitive/cast i64
                                                (llvm-jit-sym-lookup state name))
                                (primitive/cast i64 0)))
                    (let [addr (LLVMGetGlobalValueAddress engine namec)]
                      (unless (= addr (primitive/cast i64 0))
                        (let [sym (primitive/alloc-stack LLVMJitSym)]
                          (set! (.name sym) name)
                          (set! (.addr sym) (primitive/cast (ptr i8) addr))
                          (set! (.owner sym) engine)
                          (push! [LLVMJitSym]
                                 (mut (field state syms))
                                 (load sym))
                          (set! added (+ (load added) 1)))))))
                (set! global (LLVMGetNextGlobal (load global))))))
    (load added)))

(defn llvm-jit-record-functions! [(module (ptr i8)) (engine (ptr i8)) (state (ptr LLVMJitState))] (-> i64)
  (let [(mut function) (LLVMGetFirstFunction module)]
    (loop (if (= (primitive/cast i64 (load function)) 0) (break)
      (do
        (when (= (LLVMIsDeclaration (load function)) (primitive/cast i32 0))
          (let [namec (LLVMGetValueName (load function))
                address (LLVMGetFunctionAddress engine namec)]
            (unless (= address 0)
              (push! (mut (.syms state))
                (LLVMJitSym :name (cstr->slice namec) :addr (primitive/cast (ptr i8) address) :owner engine))
              0))
          0)
        (set! function (LLVMGetNextFunction (load function)))))))
  0)

; Retained engines own both instructions and their resolved imports.
(defn llvm-jit-required? [(state (ptr LLVMJitState)) (owner (ptr i8))] (-> bool)
  (block :found
    (for [i 0 (len (.generations state))]
      (let [generation (al-elem [LLVMJitGeneration] (field state generations) i)]
        (for [j 0 (len (.dependencies generation))]
          (when (= (primitive/cast i64 (get (.dependencies generation) j)) (primitive/cast i64 owner))
            (break :found true)))))
    false))

(defn llvm-jit-forget-symbols! [(state (ptr LLVMJitState)) (owner (ptr i8))] (-> i64)
  (let [(mut write) 0]
    (for [i 0 (len (.syms state))]
      (let [symbol (al-elem [LLVMJitSym] (field state syms) i)]
        (unless (= (primitive/cast i64 (.owner symbol)) (primitive/cast i64 owner))
          (set! (al-elem [LLVMJitSym] (field state syms) (load write)) (load symbol))
          (set! write (+ (load write) 1)))))
    (set! (.len (.syms state)) (load write)))
  0)

(defn llvm-jit-generation-count [(slot (ptr (ptr i8)))] (-> i64)
  (if (= (primitive/cast i64 (load slot)) 0)
      0
      (len (.generations (primitive/cast (ptr LLVMJitState) (load slot))))))

(defn llvm-jit-retain-current! [(slot (ptr (ptr i8)))] (-> i64)
  (if (= (primitive/cast i64 (load slot)) 0)
      -1
      (let [state (primitive/cast (ptr LLVMJitState) (load slot))
            (mut token) -1]
        (for [i 0 (len (.generations state))]
          (let [generation
                  (al-elem [LLVMJitGeneration] (field state generations) i)]
            (if (.current generation)
                (do
                  (set! (.leases generation) (+ (.leases generation) 1))
                  (set! token (primitive/cast i64 (.engine generation))))
                0)))
        (load token))))

(defn llvm-jit-release-token! [(slot (ptr (ptr i8))) (token i64)] (-> i64)
  (if (= (primitive/cast i64 (load slot)) 0)
      -1
      (let [state (primitive/cast (ptr LLVMJitState) (load slot))
            (mut result) -1]
        (for [i 0 (len (.generations state))]
          (let [generation
                  (al-elem [LLVMJitGeneration] (field state generations) i)]
            (if (= (primitive/cast i64 (.engine generation)) token)
                (if (> (.leases generation) 0)
                    (do
                      (set! (.leases generation) (- (.leases generation) 1))
                      (set! result (.leases generation)))
                    0)
                0)))
        (load result))))

(defn llvm-jit-token-leases [(slot (ptr (ptr i8)))] (-> i64)
  (if (= (primitive/cast i64 (load slot)) 0)
      0
      (let [state (primitive/cast (ptr LLVMJitState) (load slot))
            (mut total) 0]
        (for [i 0 (len (.generations state))]
          (set! total
                (+ (load total)
                   (.leases (al-elem [LLVMJitGeneration]
                                     (field state generations)
                                     i)))))
        (load total))))

(defn llvm-jit-reclaim! [(slot (ptr (ptr i8))) (all bool)] (-> i64)
  (if (= (primitive/cast i64 (load slot)) 0)
      0
      (let [state (primitive/cast (ptr LLVMJitState) (load slot))
            (mut read) 0
            (mut write) 0
            (mut reclaimed) 0
            n (len (.generations state))]
        (loop (if (>= (load read) n)
                  (break)
                  (let [generation
                          (al-elem [LLVMJitGeneration]
                                   (field state generations)
                                   (load read))
                        remove
                          (or all
                              (and (not (.current generation))
                                   (and (not (.pinned generation))
                                        (and (= (.leases generation) 0)
                                             (not (llvm-jit-required? state (.engine generation)))))))]
                    (if remove
                        (do
                          (llvm-jit-forget-symbols! state (.engine generation))
                          (LLVMDisposeExecutionEngine (.engine generation))
                          (LLVMContextDispose (.context generation))
                          (set! reclaimed (+ (load reclaimed) 1)))
                        (do
                          (if (!= (load write) (load read))
                              (set! (primitive/index (load (field (field state
                                                                         generations)
                                                                  data))
                                                     (load write))
                                    (load generation))
                              0)
                          (set! write (+ (load write) 1))))
                    (set! read (+ (load read) 1)))))
        (set! (field (field state generations) len) (load write))
        (if all
            (do
              (set! (field (field state syms) len) 0)
              (set! slot (primitive/cast (ptr i8) 0)))
            0)
        (load reclaimed))))

(defn llvm-jit-verify [(module (ptr i8))] (-> bool)
  (let [message (primitive/alloc-stack (ptr i8))]
    (set! message (primitive/cast (ptr i8) 0))
    (if (= (LLVMVerifyModule module 2 message) (primitive/cast i32 0))
        true
        (do
          (print-str (stderr)
                     "error: REPL JIT produced an invalid LLVM module: ")
          (unless (= (primitive/cast i64 (load message)) (primitive/cast i64 0))
            (print-str (stderr) (cstr->slice (load message)))
            (LLVMDisposeMessage (load message))
            0)
          (write-byte (stderr) (primitive/cast u8 10))
          false))))

;;; Driver runner: compile one checked Program, reuse prior static cells, invoke
;;; coil_repl_entry, and retain the engine for frozen function pointers.
(defn jit-llvm-run [(a (dyn Allocator))
                    (mp (ptr Program))
                    (paths (ptr (ArrayList (slice u8))))
                    (texts (ptr (ArrayList (slice u8))))
                    (state-slot (ptr (ptr i8)))] (-> i64)
  (do
    ; Source tables are already consumed by the front end; LLVM debug emission is
    ; deliberately disabled for short-lived REPL generations.
    (primitive/cast i64 paths)
    (primitive/cast i64 texts)
    (let [module (codegen-module a mp (primitive/cast (ptr i8) 0) 0 false)
          context (LLVMGetModuleContext module)]
      (if (not (llvm-jit-verify module))
          (do (codegen-dispose-module! module) 1)
          (do
            (LLVMLinkInMCJIT)
            (LLVMInitializeX86AsmPrinter)
            (LLVMInitializeX86AsmParser)
            (let [engine-out (primitive/alloc-stack (ptr i8))
                  error-out (primitive/alloc-stack (ptr i8))
                  state (llvm-jit-state a state-slot)]
              (set! engine-out (primitive/cast (ptr i8) 0))
              (set! error-out (primitive/cast (ptr i8) 0))
              (llvm-jit-externalize-prior! module state)
              (if (!= (LLVMCreateMCJITCompilerForModule engine-out
                                                        module
                                                        (primitive/cast (ptr i8)
                                                                        0)
                                                        0
                                                        error-out)
                      (primitive/cast i32 0))
                  (do
                    (print-str (stderr)
                               "error: REPL LLVM JIT initialization failed: ")
                    (unless (= (primitive/cast i64 (load error-out))
                               (primitive/cast i64 0))
                      (print-str (stderr) (cstr->slice (load error-out)))
                      (LLVMDisposeMessage (load error-out))
                      0)
                    (write-byte (stderr) (primitive/cast u8 10))
                    (codegen-dispose-module! module)
                    1)
                  (let [engine (load engine-out)]
                    (let [(mut dependencies) (al-new [(ptr i8)] a)]
                    (llvm-jit-map-prior! module engine state (mut dependencies))
                    (let [entry
                            (LLVMGetFunctionAddress engine c"coil_repl_entry")]
                      (if (= entry (primitive/cast i64 0))
                          (do
                            (print-str (stderr)
                                       "error: REPL LLVM JIT entry is missing\n")
                            (LLVMDisposeExecutionEngine engine)
                            (LLVMContextDispose context)
                            1)
                          (let [rc
                                  (primitive/call-ptr (primitive/cast (fnptr c
                                                                             []
                                                                             i64)
                                                                      (primitive/cast (ptr i8)
                                                                                      entry)))]
                            (if (= rc 0)
                                (do
                                  ; Publication happens only after the staged
                                  ; entry succeeds. Before this point the new
                                  ; engine is absent from both the persistent
                                  ; symbol map and retained-generation list.
                                  (llvm-jit-record-functions! module engine state)
                                  (let [added
                                          (llvm-jit-record-statics! module
                                                                    engine
                                                                    state)]
                                    (for [i 0 (len (.generations state))]
                                      (set! (.current (al-elem [LLVMJitGeneration]
                                                               (field state
                                                                      generations)
                                                               i))
                                            false))
                                    (push! [LLVMJitGeneration]
                                           (mut (.generations state))
                                           (LLVMJitGeneration
                                             :engine engine
                                             :context context
                                             :pinned (> added 0)
                                             :current true
                                             :leases 0
                                             :dependencies (load dependencies))))
                                  0)
                                (do
                                  (LLVMDisposeExecutionEngine engine)
                                  (LLVMContextDispose context)
                                  rc))))))))))))))

;;; Metaprogram object builder used by coil.jit on LLVM hosts. This keeps macro and
;;; transform compilation compatible with Linux ELF while runtime submissions stay
;;; entirely in-process through jit-llvm-run.
(defn jit-llvm-build-object [(a (dyn Allocator))
                             (mp (ptr Program))
                             (out (ptr i8))] (-> i64)
  (let [module (codegen-module a mp (primitive/cast (ptr i8) 0) 0 false)
        triple (LLVMGetDefaultTargetTriple)
        target-out (primitive/alloc-stack (ptr i8))
        error-out (primitive/alloc-stack (ptr i8))]
    (LLVMInitializeX86AsmPrinter)
    (LLVMInitializeX86AsmParser)
    (set! error-out (primitive/cast (ptr i8) 0))
    (if (!= (LLVMGetTargetFromTriple triple target-out error-out)
            (primitive/cast i32 0))
        (do
          (print-str (stderr) "error: REPL LLVM target initialization failed\n")
          (unless (= (primitive/cast i64 (load error-out)) 0)
            (LLVMDisposeMessage (load error-out))
            0)
          (LLVMDisposeMessage triple)
          (codegen-dispose-module! module)
          1)
        (let [machine
                (LLVMCreateTargetMachine (load target-out)
                                         triple
                                         (llvm-cpu triple)
                                         (llvm-cpu-features triple)
                                         0
                                         (llvm-reloc-model triple)
                                         0)
              emit-error (primitive/alloc-stack (ptr i8))
              rc (LLVMTargetMachineEmitToFile machine module out 1 emit-error)]
          (when (!= rc (primitive/cast i32 0))
            (print-str (stderr)
                       "error: REPL metaprogram object emission failed: ")
            (unless (= (primitive/cast i64 (load emit-error))
                       (primitive/cast i64 0))
              (print-str (stderr) (cstr->slice (load emit-error)))
              (LLVMDisposeMessage (load emit-error))
              0)
            (write-byte (stderr) (primitive/cast u8 10))
            0)
          (LLVMDisposeTargetMachine machine)
          (LLVMDisposeMessage triple)
          (codegen-dispose-module! module)
          (primitive/cast i64 rc)))))
