(module coil.compiler.program_query)

;;; Queries over a compiled program, for describing it to another compilation
;;; unit: most of all a JIT session running inside the program itself.
;;;
;;; A description is ordinary Coil source. A function the program compiled is a
;;; `declare` of its exact calling signature, a `def` is a `declare` of its
;;; storage, a concrete record or sum is printed from the checked program with
;;; every type qualified, and what a consumer instantiates or expands itself (a
;;; generic, a macro, a trait, a constant, an extern) is its own source. A
;;; consumer compiling that source binds each declared name to the program's own
;;; symbol.
;;;
;;; Every answer comes from the compiler's tables: the declaration table names a
;;; module's definitions, the checker's signatures and constants give their
;;; types, and the compilation's top-level forms give the source of what is
;;; copied. Nothing here walks a caller's code.
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use [sx-tag sx-sval sx-items sx-at sx-len sexp-display sconcat sconcat3])
(import "coil.compiler.loader" :use [TaggedForm Source RetainedForm l-list-head])
(import "coil.compiler.resolve" :use [DefEntry Defs table-find qualify-in-module])
(import "coil.compiler.check" :use [Cx Sig ConstEntry sig-find const-find last-component])
(import "coil.compiler.checked_base" :as checkedbase)
(import "coil.compiler.unit" :use [unit-write-declare! unit-write-struct! unit-write-sum!
                                   unit-write-trait! unit-ty-str])

(export ProgramModel
        program-modules module-definitions definition-kind definitions-of-kind definition-kind-name definition-declaration
        definition-annotations definition-source module-header module-impls
        defining-form defining-forms-index retained-defining-index)

; What a definition is, as a description needs to know it, is coil.primitive's
; DefinitionKind: the `definition-kind` primitive answers with it, and the
; declarations below are chosen by it.

;;; The tables a query reads. `forms` are this compilation's top-level forms and
;;; `retained` those of the submissions a retained session accepted before it;
;;; `sources` holds both's texts. Earlier submissions' functions, signatures and
;;; constants are reached through `checked_base` and the checker's own tables.
(defstruct ProgramModel
  [(program (ptr Program))
   (checked_base (ptr checkedbase/CheckedBase))
   (checker (ptr Cx))
   (declarations (ptr (ArrayList DefEntry)))
   (forms (ptr (ArrayList TaggedForm)))
   (retained (ptr (ArrayList RetainedForm)))
   (sources (ptr (ArrayList Source)))
   ; Every definition of `forms`, by qualified name (defining-forms-index), and
   ; the newest retained form defining each name: a definition is a lookup.
   (defining (ptr (HashMap (slice u8) (ptr Sexp))))
   (retained_defining (ptr (HashMap (slice u8) (ptr RetainedForm))))])

(defn retained-text [(m (ptr ProgramModel)) (rf (ptr RetainedForm))] (-> (slice u8))
  (if (> (len (.text rf)) 0)
      (.text rf)
      (subslice (.text (elem (.sources m) (.source rf))) (.lo rf) (.hi rf))))

;;; The newest retained form defining QUALIFIED, or null.
(defn retained-defining-form [(a (dyn Allocator)) (m (ptr ProgramModel)) (qualified (slice u8))] (-> (ptr RetainedForm))
  (if (= (primitive/cast i64 (.retained_defining m)) 0)
      (primitive/cast (ptr RetainedForm) 0)
      (match (get (load (.retained_defining m)) qualified)
        (Some [rf] rf)
        (None [] (primitive/cast (ptr RetainedForm) 0)))))

;;; Every name a retained session's accepted forms define, mapped to the newest form
;;; defining it, so a lookup answers what the newest-first scan did.
(defn retained-defining-index [(a (dyn Allocator)) (rs (ptr (ArrayList RetainedForm)))]
  (-> (ptr (HashMap (slice u8) (ptr RetainedForm))))
  (let [out (box! a (HashMap (slice u8) (ptr RetainedForm))
                  (HashMap::new [(slice u8) (ptr RetainedForm)] a (keyops)))]
    (unless (= (primitive/cast i64 rs) 0)
      (for [i 0 (len (load rs))]
        (let [rf (elem rs i)]
          (when (and (defining-head? (.head rf)) (> (len (.name rf)) 0))
            (set! out (.name rf) rf)
            (set! out (qualify-in-module a (.module rf) (.name rf)) rf)
            0)))
      0)
    out))

;;; Every module of the program, the library's included, in table order.
(defn program-modules [(a (dyn Allocator)) (m (ptr ProgramModel))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] a)]
    (unless (= (primitive/cast i64 (.declarations m)) 0)
      (for [i 0 (len (load (.declarations m)))]
        (let [module (.module (elem (.declarations m) i))]
          (when (> (len module) 0) (push! (mut out) module) 0)))
      0)
    out))

(defn names-push-new! [(out (mut (ArrayList (slice u8)))) (name (slice u8))] (-> i64)
  (let [(mut seen) false]
    (for [i 0 (len out)] (when (= (get out i) name) (set! seen true) 0))
    (unless seen (push! (mut out) name) 0))
  0)

;;; Is QUALIFIED a variant of one of the program's sums? A variant is declared by
;;; its sum, not on its own.
(defn variant-name? [(p (ptr Program)) (qualified (slice u8))] (-> bool)
  (block :found
    (for [i 0 (len (load (.sums p)))]
      (let [d (elem (.sums p) i)]
        (for [j 0 (len (load (.variants d)))]
          (when (= (.name (elem (.variants d) j)) qualified) (break :found true)))))
    false))

(defn push-qualified! [(a (dyn Allocator)) (out (mut (ArrayList (slice u8)))) (module (slice u8))
                       (names (ptr (ArrayList (slice u8))))] (-> i64)
  (for [i 0 (len (load names))]
    (names-push-new! (mut out) (qualify-in-module a module (get (load names) i))))
  0)

;;; MODULE's definitions, qualified, or None when the program has no such module.
(defn module-definitions [(a (dyn Allocator)) (m (ptr ProgramModel)) (module (slice u8))]
  (-> (Option (ArrayList (slice u8))))
  (if (= (primitive/cast i64 (.declarations m)) 0)
      (None [(ArrayList (slice u8))])
      (let [entry (table-find (.declarations m) module)]
        (if (= (primitive/cast i64 entry) 0)
            (None [(ArrayList (slice u8))])
            (let [d (field entry defs)
                  (mut out) (ArrayList::new [(slice u8)] a)]
              (for [i 0 (len (load (field d callables)))]
                (let [q (qualify-in-module a module (get (load (field d callables)) i))]
                  (unless (variant-name? (.program m) q) (names-push-new! (mut out) q) 0)))
              (push-qualified! a (mut out) module (field d types))
              (push-qualified! a (mut out) module (field d traits))
              (push-qualified! a (mut out) module (field d consts))
              (push-qualified! a (mut out) module (field d externs))
              (for [i 0 (/ (len (load (field d aliases))) 2)]
                (names-push-new! (mut out) (qualify-in-module a module (get (load (field d aliases)) (* i 2)))))
              (Some out))))))

;;; The function the program defines (or declares) as QUALIFIED, in this
;;; compilation or an earlier one of its session.
(defn model-function [(m (ptr ProgramModel)) (qualified (slice u8))] (-> (Option (ptr Func)))
  (let [fs (.funcs (.program m))
        (mut found) (None [(ptr Func)])]
    (for [i 0 (len (load fs))]
      (when (= (.name (elem fs i)) qualified) (set! found (Some (elem fs i))) 0))
    (match (load found)
      (Some [f] (Some f))
      (None [] (checkedbase/checked-base-get (.checked_base m) qualified)))))

(defn code-type? [(t (ptr Type))] (-> bool)
  (match (load t) (TCode [] true) (TCodeBuilder [] true) (_ false)))

(defn find-struct [(p (ptr Program)) (q (slice u8))] (-> (ptr StructDef))
  (let [(mut r) (primitive/cast (ptr StructDef) 0)]
    (for [i 0 (len (load (.structs p)))]
      (when (= (.name (elem (.structs p) i)) q) (set! r (elem (.structs p) i)) 0))
    (load r)))

(defn find-sum [(p (ptr Program)) (q (slice u8))] (-> (ptr SumDef))
  (let [(mut r) (primitive/cast (ptr SumDef) 0)]
    (for [i 0 (len (load (.sums p)))]
      (when (= (.name (elem (.sums p) i)) q) (set! r (elem (.sums p) i)) 0))
    (load r)))

(defn find-trait [(p (ptr Program)) (q (slice u8))] (-> (ptr TraitDef))
  (let [(mut r) (primitive/cast (ptr TraitDef) 0)]
    (for [i 0 (len (load (.traits p)))]
      (when (= (.name (elem (.traits p) i)) q) (set! r (elem (.traits p) i)) 0))
    (load r)))

(defn find-extern [(p (ptr Program)) (q (slice u8))] (-> (ptr Extern))
  (let [(mut r) (primitive/cast (ptr Extern) 0)]
    (for [i 0 (len (load (.externs p)))]
      (when (= (.name (elem (.externs p) i)) q) (set! r (elem (.externs p) i)) 0))
    (load r)))

;;; The target QUALIFIED aliases, when it is an alias.
(defn alias-target [(m (ptr ProgramModel)) (qualified (slice u8))] (-> (Option (slice u8)))
  (let [module (before-last-dot qualified)
        leaf (last-component qualified)]
    (if (= (primitive/cast i64 (.declarations m)) 0)
        (None [(slice u8)])
        (let [entry (table-find (.declarations m) module)]
          (if (= (primitive/cast i64 entry) 0)
              (None [(slice u8)])
              (let [pairs (field (field entry defs) aliases)]
                (block :found
                  (for [i 0 (/ (len (load pairs)) 2)]
                    (when (= (get (load pairs) (* i 2)) leaf)
                      (break :found (Some (get (load pairs) (+ (* i 2) 1))))))
                  (None [(slice u8)]))))))))

(defn before-last-dot [(name (slice u8))] (-> (slice u8))
  (let [(mut cut) -1]
    (for [i 0 (len name)] (when (= (primitive/cast i64 (get name i)) 46) (set! cut i) 0))
    (if (< cut 0) "" (subslice name 0 cut))))

;;; What QUALIFIED is, or None when the program defines nothing by that name.
(defn definition-kind [(m (ptr ProgramModel)) (qualified (slice u8))] (-> (Option primitive/DefinitionKind))
  (let [p (.program m)]
    (cond (some? [(slice u8)] (alias-target m qualified)) (Some (primitive/Alias))
          (!= (primitive/cast i64 (find-struct p qualified)) 0) (Some (primitive/Struct))
          (!= (primitive/cast i64 (find-sum p qualified)) 0) (Some (primitive/Sum))
          (!= (primitive/cast i64 (find-trait p qualified)) 0) (Some (primitive/Trait))
          (!= (primitive/cast i64 (find-extern p qualified)) 0) (Some (primitive/Extern))
          :else
            (match (model-function m qualified)
              (Some [f] (Some (function-kind f)))
              (None []
                (let [c (if (= (primitive/cast i64 (.checker m)) 0)
                            (primitive/cast (ptr ConstEntry) 0)
                            (const-find (.checker m) qualified))]
                  (cond (= (primitive/cast i64 c) 0) (None [primitive/DefinitionKind])
                        (.runtime c) (Some (primitive/Def))
                        :else (Some (primitive/Const)))))))))

;;; What the function F is: a Generic, a Macro (Code in or out) or a Function.
(defn function-kind [(f (ptr Func))] (-> primitive/DefinitionKind)
  (cond (> (len (load (.type_params f))) 0) (primitive/Generic)
        (code-type? (field f ret)) (primitive/Macro)
        :else
          (let [(mut macro) false]
            (for [i 0 (len (load (.params f)))]
              (when (code-type? (field (elem (.params f) i) ty)) (set! macro true) 0))
            (if macro (primitive/Macro) (primitive/Function)))))

;;; Every definition of this compilation that `definition-kind` calls KIND (a
;;; DefinitionKind's variant name), qualified, in table order: read from the table
;;; that holds that kind, so the answer costs that table, not the program.
(defn definitions-of-kind [(a (dyn Allocator)) (m (ptr ProgramModel)) (kind (slice u8))] (-> (ArrayList (slice u8)))
  (let [p (.program m)
        (mut out) (ArrayList::new [(slice u8)] a)]
    (cond
      (= kind "Struct") (for [i 0 (len (load (.structs p)))] (push! (mut out) (.name (elem (.structs p) i))))
      (= kind "Sum") (for [i 0 (len (load (.sums p)))] (push! (mut out) (.name (elem (.sums p) i))))
      (= kind "Trait") (for [i 0 (len (load (.traits p)))] (push! (mut out) (.name (elem (.traits p) i))))
      (= kind "Extern") (for [i 0 (len (load (.externs p)))] (push! (mut out) (.name (elem (.externs p) i))))
      (or (= kind "Function") (= kind "Macro") (= kind "Generic"))
        (for [i 0 (len (load (.funcs p)))]
          (let [f (elem (.funcs p) i)]
            (when (= (definition-kind-name (function-kind f)) kind) (push! (mut out) (.name f)) 0)))
      (or (= kind "Def") (= kind "Const"))
        (unless (= (primitive/cast i64 (.checker m)) 0)
          (for c (iter (.consts (load (.checker m))))
            (when (= (if (.runtime c) "Def" "Const") kind) (push! (mut out) (.name c)) 0))
          0)
      (= kind "Alias")
        (unless (= (primitive/cast i64 (.declarations m)) 0)
          (for [i 0 (len (load (.declarations m)))]
            (let [entry (elem (.declarations m) i)
                  pairs (field (field entry defs) aliases)]
              (for [j 0 (/ (len (load pairs)) 2)]
                (push! (mut out) (qualify-in-module a (.module entry) (get (load pairs) (* j 2)))))))
          0)
      :else 0)
    out))

(defn definition-kind-name [(k primitive/DefinitionKind)] (-> (slice u8))
  (match k
    (primitive/Function [] "Function") (primitive/Macro [] "Macro") (primitive/Generic [] "Generic")
    (primitive/Def [] "Def") (primitive/Const [] "Const") (primitive/Struct [] "Struct")
    (primitive/Sum [] "Sum") (primitive/Trait [] "Trait") (primitive/Alias [] "Alias")
    (primitive/Extern [] "Extern")))

;;; A top-level form's text: its authored source when it has one, so a `defn` is
;;; copied as written (its macros expand again where it is read), or the printed
;;; form. Expansion stamps the call's span on what it produces, so the text at a
;;; span is the form's own only when it reads back as a definition of the same
;;; name; a macro call that produced several definitions is printed instead.
(defn form-text [(a (dyn Allocator)) (m (ptr ProgramModel)) (f (ptr Sexp))] (-> (slice u8))
  (match (authored-text a m f)
    (Some [text] text)
    (None [] (sexp-display a (load f)))))

(defn authored-text [(a (dyn Allocator)) (m (ptr ProgramModel)) (f (ptr Sexp))] (-> (Option (slice u8)))
  (let [source (.source f) ss (.sources m)]
    (if (or (< (.lo f) 0)
            (or (= (primitive/cast i64 ss) 0)
                (or (< source 0) (>= source (len (load ss))))))
        (None [(slice u8)])
        (let [whole (.text (elem ss source))]
          (if (> (.hi f) (len whole))
              (None [(slice u8)])
              (let [text (subslice whole (.lo f) (.hi f))]
                (match (read-all a text -1)
                  (Err [_] (None [(slice u8)]))
                  (Ok [forms]
                    (if (and (= (len (load forms)) 1)
                             (same-name? (form-defined-name (elem forms 0)) (form-defined-name f)))
                        (Some text)
                        (None [(slice u8)]))))))))))

(defn same-name? [(x (Option (slice u8))) (y (Option (slice u8)))] (-> bool)
  (match x
    (Some [a] (match y (Some [b] (= a b)) (None [] false)))
    (None [] false)))

(defn form-head [(f (ptr Sexp))] (-> (slice u8))
  (match (l-list-head f) (Some [h] h) (None [] "")))

;;; The name a top-level definition form introduces.
(defn form-defined-name [(f (ptr Sexp))] (-> (Option (slice u8)))
  (if (and (= (sx-tag (load f)) 6) (> (sx-len (sx-items (load f))) 1))
      (let [second (sx-at (sx-items (load f)) 1)]
        (if (= (sx-tag second) 2) (Some (sx-sval second)) (None [(slice u8)])))
      (None [(slice u8)])))

(defn defining-head? [(h (slice u8))] (-> bool)
  (or (= h "defn") (or (= h "defn*") (or (= h "defstruct") (or (= h "defsum")
    (or (= h "deftrait") (or (= h "const") (or (= h "def") (or (= h "extern") (= h "declare"))))))))))

;;; The top-level form of this compilation that defines QUALIFIED, or null.
(defn defining-form [(a (dyn Allocator)) (m (ptr ProgramModel)) (qualified (slice u8))] (-> (ptr Sexp))
  (if (= (primitive/cast i64 (.defining m)) 0)
      (primitive/cast (ptr Sexp) 0)
      (match (get (load (.defining m)) qualified)
        (Some [f] f)
        (None [] (primitive/cast (ptr Sexp) 0)))))

;;; Every definition FORMS make, by qualified name, looking inside `do` forms a macro
;;; spliced several definitions into. The first form defining a name wins, as the
;;; scan this replaces answered.
(defn defining-forms-index [(a (dyn Allocator)) (fs (ptr (ArrayList TaggedForm)))]
  (-> (ptr (HashMap (slice u8) (ptr Sexp))))
  (let [out (box! a (HashMap (slice u8) (ptr Sexp)) (HashMap::new [(slice u8) (ptr Sexp)] a (keyops)))]
    (unless (= (primitive/cast i64 fs) 0)
      (for [i 0 (len (load fs))]
        (let [tf (elem fs i)
              module (match (.module tf) (Some [x] x) (None [] ""))]
          (defining-forms-into! a (field tf form) module out)))
      0)
    out))

(defn defining-forms-into! [(a (dyn Allocator)) (f (ptr Sexp)) (module (slice u8))
                            (out (ptr (HashMap (slice u8) (ptr Sexp))))] (-> i64)
  (let [h (form-head f)]
    (cond (= h "do")
            (let [items (sx-items (load f))]
              (for [i 1 (sx-len items)] (defining-forms-into! a (elem items i) module out))
              0)
          (defining-head? h)
            (match (form-defined-name f)
              (Some [name]
                (do (unless (contains? (load out) name) (set! out name f) 0)
                    (let [q (qualify-in-module a module name)]
                      (unless (contains? (load out) q) (set! out q f) 0))
                    0))
              (None [] 0))
          :else 0)))

;;; QUALIFIED's own source, from this compilation's forms; or, for a function an
;;; earlier submission of a session defined, from its recorded span.
(defn definition-source [(a (dyn Allocator)) (m (ptr ProgramModel)) (qualified (slice u8))]
  (-> (Result (slice u8) (slice u8)))
  (let [f (defining-form a m qualified)
        rf (retained-defining-form a m qualified)]
    (cond
      (!= (primitive/cast i64 f) 0) (Ok [(slice u8) (slice u8)] (form-text a m f))
      (!= (primitive/cast i64 rf) 0) (Ok [(slice u8) (slice u8)] (retained-text m rf))
      :else
        (match (model-function m qualified)
          (Some [fun]
            (let [ss (.sources m) source (.source fun)]
              (if (and (!= (primitive/cast i64 ss) 0)
                       (and (>= source 0) (and (< source (len (load ss))) (>= (.lo fun) 0))))
                  (Ok [(slice u8) (slice u8)]
                      (subslice (.text (elem ss source)) (.lo fun) (.hi fun)))
                  (Err [(slice u8) (slice u8)]
                       (sconcat3 a "the source of '" qualified "' is not retained")))))
          (None []
            (Err [(slice u8) (slice u8)]
                 (sconcat3 a "the source of '" qualified "' is not retained by this compilation")))))))

;;; The form that declares QUALIFIED to another compilation unit, as source text,
;;; written in its own module (`(module …)` is the caller's).
(defn definition-declaration [(a (dyn Allocator)) (m (ptr ProgramModel)) (qualified (slice u8))]
  (-> (Result (slice u8) (slice u8)))
  (let [module (before-last-dot qualified)
        leaf (last-component qualified)
        (mut out) (StrBuf::new a)
        (mut mods) (ArrayList::new [(slice u8)] a)
        (mut work) (ArrayList::new [(slice u8)] a)
        p (.program m)]
    (match (definition-kind m qualified)
      (None [] (Err [(slice u8) (slice u8)] (sconcat3 a "the program defines no '" qualified "'")))
      (Some [kind]
        (match kind
          ; Linked against: the exact signature the program compiled.
          (primitive/Function []
            (let [sig (if (= (primitive/cast i64 (.checker m)) 0)
                          (primitive/cast (ptr Sig) 0)
                          (sig-find (.checker m) qualified))]
              (if (= (primitive/cast i64 sig) 0)
                  (Err [(slice u8) (slice u8)] (sconcat3 a "no checked signature for '" qualified "'"))
                  (let [surface (primitive/alloc-stack Extern)]
                    (set! (.name surface) qualified)
                    (set! (.symbol surface) (None [(slice u8)]))
                    (set! (.cc surface) (CcResolved (.cc sig)))
                    (set! (.params surface) (.params sig))
                    (set! (.variadic surface) (.variadic sig))
                    (set! (.ret surface) (.ret sig))
                    (set! (.span_source surface) -1)
                    (unit-write-declare! a (mut out) surface (.param_names sig) leaf module (mut mods) (mut work))
                    (Ok [(slice u8) (slice u8)] (str (load out)))))))
          ; Storage the program holds: its type.
          (primitive/Def []
            (let [c (const-find (.checker m) qualified)]
              (Ok [(slice u8) (slice u8)]
                  (sconcat a (sconcat3 a "(declare " leaf " ")
                           (sconcat a (unit-ty-str a (field c ty)) ")\n")))))
          (primitive/Alias []
            (match (alias-target m qualified)
              (Some [target] (Ok [(slice u8) (slice u8)] (sconcat a (sconcat3 a "(defalias " leaf " ") (sconcat a target ")\n"))))
              (None [] (Err [(slice u8) (slice u8)] "internal: alias without a target"))))
          ; A concrete record or sum: its checked layout, every type qualified.
          (primitive/Struct []
            (let [d (find-struct p qualified)]
              (if (= (len (load (.type_params d))) 0)
                  (do (unit-write-struct! a (mut out) d leaf module (mut mods) (mut work))
                      (Ok [(slice u8) (slice u8)] (str (load out))))
                  (definition-source a m qualified))))
          (primitive/Sum []
            (let [d (find-sum p qualified)]
              (if (= (len (load (.type_params d))) 0)
                  (do (unit-write-sum! a (mut out) d leaf module (mut mods) (mut work))
                      (Ok [(slice u8) (slice u8)] (str (load out))))
                  (definition-source a m qualified))))
          ; A trait a metaprogram produced has no source: its checked signature.
          (primitive/Trait []
            (match (definition-source a m qualified)
              (Ok [text] (Ok [(slice u8) (slice u8)] text))
              (Err [_]
                (match (unit-write-trait! a (mut out) (find-trait p qualified) module (mut mods) (mut work))
                  (Some [problem] (Err [(slice u8) (slice u8)] problem))
                  (None [] (Ok [(slice u8) (slice u8)] (str (load out))))))))
          ; Instantiated, expanded or evaluated where it is read: its source.
          (_ (definition-source a m qualified)))))))

;;; The annotations a function or `def` carries, as the source text of its `:key
;;; value` pairs in the order written. Any other definition carries none.
(defn definition-annotations [(a (dyn Allocator)) (m (ptr ProgramModel)) (qualified (slice u8))]
  (-> (Result (slice u8) (slice u8)))
  (let [(mut annotations) (primitive/cast (ptr (ArrayList Annotation)) 0)
        consts (.consts (.program m))]
    (match (model-function m qualified)
      (Some [f] (do (set! annotations (.annotations f)) 0))
      (None []
        (do (for [i 0 (len (load consts))]
              (let [c (elem consts i)]
                (when (and (.runtime c) (= (.name c) qualified))
                  (set! annotations (.annotations c)) 0)))
            0)))
    (if (= (primitive/cast i64 (load annotations)) 0)
        (Ok [(slice u8) (slice u8)] "")
        (let [(mut out) (StrBuf::new a)
              ss (.sources m)]
          (block :done
            (for [i 0 (len (load (load annotations)))]
              (let [annotation (elem (load annotations) i)
                    value (field annotation value)
                    source (.source value)]
                (unless (and (!= (primitive/cast i64 ss) 0)
                             (and (>= source 0) (and (< source (len (load ss))) (>= (.lo value) 0))))
                  (return-from :done
                    (Err [(slice u8) (slice u8)]
                         (sconcat3 a "the source of an annotation of '" qualified "' is not retained"))))
                (push-str! (mut out) (sconcat a (if (> i 0) " :" ":") (.key annotation)))
                (push! (mut out) (: 32 u8))
                (push-str! (mut out)
                  (subslice (.text (elem ss source)) (.lo value) (.hi value)))
                0))
            (Ok [(slice u8) (slice u8)] (str (load out))))))))

;;; `(module M)` and the module's own `import` and `export` forms, which a copied
;;; source form reads its names through.
(defn module-header [(a (dyn Allocator)) (m (ptr ProgramModel)) (module (slice u8))] (-> (slice u8))
  (let [(mut texts) (ArrayList::new [(slice u8)] a)
        (mut out) (StrBuf::new a)]
    (module-forms-with! a m module "import" (mut texts))
    (module-forms-with! a m module "export" (mut texts))
    (push-str! (mut out) (sconcat3 a "(module " module ")\n"))
    (for t (iter texts)
      (push-str! (mut out) t)
      (push! (mut out) (: 10 u8)))
    (str (load out))))

;;; The texts of MODULE's top-level forms with HEAD, from earlier submissions and
;;; this compilation, each once (every submission repeats a module's imports).
(defn module-forms-with! [(a (dyn Allocator)) (m (ptr ProgramModel)) (module (slice u8)) (head (slice u8))
                          (out (mut (ArrayList (slice u8))))] (-> i64)
  (let [rs (.retained m)]
    (unless (= (primitive/cast i64 rs) 0)
      (for [i 0 (len (load rs))]
        (let [rf (elem rs i)]
          (when (and (= (.module rf) module) (= (.head rf) head))
            (names-push-new! (mut out) (retained-text m rf)) 0)))
      0))
  (let [fs (.forms m)]
    (unless (= (primitive/cast i64 fs) 0)
      (for [i 0 (len (load fs))]
        (let [tf (elem fs i)]
          (when (= (match (.module tf) (Some [x] x) (None [] "")) module)
            (forms-with-head! a m (field tf form) head (mut out)) 0)))
      0))
  0)

(defn forms-with-head! [(a (dyn Allocator)) (m (ptr ProgramModel)) (f (ptr Sexp)) (head (slice u8))
                        (out (mut (ArrayList (slice u8))))] (-> i64)
  (let [h (form-head f)]
    (cond (= h "do")
            (let [items (sx-items (load f))]
              (for [i 1 (sx-len items)] (forms-with-head! a m (elem items i) head (mut out))))
          (= h head) (names-push-new! (mut out) (form-text a m f))
          :else 0))
  0)

;;; The module's `impl` and `derive` forms, from earlier submissions and this
;;; compilation. A consumer compiles its own copy, and the names a method reaches
;;; are the program's own declarations.
(defn module-impls [(a (dyn Allocator)) (m (ptr ProgramModel)) (module (slice u8))] (-> (slice u8))
  (let [(mut texts) (ArrayList::new [(slice u8)] a)
        (mut out) (StrBuf::new a)]
    (module-forms-with! a m module "impl" (mut texts))
    (module-forms-with! a m module "derive" (mut texts))
    (for t (iter texts)
      (push-str! (mut out) t)
      (push! (mut out) (: 10 u8)))
    (str (load out))))
