; src/compiler/comptime/comptime.coil — self-host Coil compiler, comptime module.

(module coil.compiler.comptime)
(import "coil.compiler.ast_map" :use [visit-expr-children])
(import "coil.compiler.text" :as text)
(import "coil.primitive" :as primitive)
(import "coil.compiler.unit_state" :use *)
(import "coil.compiler.ffi" :as ffi)

;;; The impl methods of the current semantic model, by the name a checked call to one
;;; resolves to. Built the first time a declaration query misses the function list, so
;;; a compilation that never asks pays nothing.
(defstruct MethodDeclBox
  [(init i64)
   (prog (ptr Program))
   ; resolved method name -> impl index * 65536 + method index for an impl's method,
   ; or -(trait index * 65536 + method index) - 1 for a trait's own declaration
   (index (ptr (HashMap (slice u8) i64)))])

; Declaration lookup indexes belong to one semantic-model publication. Values
; are list positions, not pointers into a growable function list. Negative
; positions encode ambiguity as -(first position + 1), preserving the first
; match as well as lookup status.
(defstruct FunctionDeclIndex
  [(init i64)
   (program (ptr Program))
   (count i64)
   (exact (HashMap (slice u8) i64))
   (qualified (HashMap (slice u8) i64))
   (simple (HashMap (slice u8) i64))])

(defstruct KindDeclIndex
  [(init i64)
   (program (ptr Program))
   (items (ptr (ArrayList NamedKind)))
   (exact (HashMap (slice u8) i64))])

;;; The source view's facts filed under the key each query asks by, so a query
;;; is a lookup the size of its answer (docs/design/PROGRAM_FACTS.md). Filled in
;;; the one walk that builds the view; every list is the view's own, handed out
;;; in place.
(defstruct SourceIndex
  ; The reference indexes hold each reference by its position in the view's
  ; `source_references`, and a query builds the list it answers: a record copied
  ; into each index it is filed in was most of what the view cost.
  ; MODULE -> its authored references
  [(by_module (HashMap (slice u8) (ptr (ArrayList i64))))
   ; `MODULE TARGET` -> the references of MODULE that resolved through its import
   ; of TARGET
   (by_import (HashMap (slice u8) (ptr (ArrayList i64))))
   ; a qualified name, or `#ID` for a local -> the references that resolve to it
   (by_target (HashMap (slice u8) (ptr (ArrayList i64))))
   ; MODULE -> its authored imports, and its `let` binders
   (imports (HashMap (slice u8) (ptr (ArrayList Sexp))))
   (binders (HashMap (slice u8) (ptr (ArrayList Sexp))))
   ; MODULE -> its authored module record
   (modules (HashMap (slice u8) Sexp))
   ; a reference's occurrence -> the form it heads (the call, the match arm)
   (forms (HashMap (slice u8) Sexp))
   ; `SOURCE:LO` -> the authored top-level form written there
   (written (HashMap (slice u8) Sexp))
   ; SOURCE -> its authored top-level forms in source order (code-path)
   (tops (HashMap i64 (ptr (ArrayList Sexp))))
   ; `MODULE HEAD` -> the module's authored forms headed by core syntax spelled
   ; HEAD: a head no declaration answers, which has the one spelling everywhere
   (by_head (HashMap (slice u8) (ptr (ArrayList Sexp))))])

(defn source-index-new [(a (dyn Allocator))] (-> SourceIndex)
  (SourceIndex
    :by_module (HashMap::new [(slice u8) (ptr (ArrayList i64))] a (keyops))
    :by_import (HashMap::new [(slice u8) (ptr (ArrayList i64))] a (keyops))
    :by_target (HashMap::new [(slice u8) (ptr (ArrayList i64))] a (keyops))
    :imports (HashMap::new [(slice u8) (ptr (ArrayList Sexp))] a (keyops))
    :binders (HashMap::new [(slice u8) (ptr (ArrayList Sexp))] a (keyops))
    :modules (HashMap::new [(slice u8) Sexp] a (keyops))
    :forms (HashMap::new [(slice u8) Sexp] a (keyops))
    :written (HashMap::new [(slice u8) Sexp] a (keyops))
    :tops (HashMap::new [i64 (ptr (ArrayList Sexp))] a (i64-keyops))
    :by_head (HashMap::new [(slice u8) (ptr (ArrayList Sexp))] a (keyops))))

;;; File ITEM under KEY in TABLE.
(defn source-index-add! [(a (dyn Allocator))
                         (table (mut (HashMap (slice u8) (ptr (ArrayList Sexp)))))
                         (key (slice u8))
                         (item Sexp)] (-> i64)
  (match (get table key)
    (Some [items] (push! items item))
    (None []
          (let [items (new-boxed-list [Sexp] a)]
            (push! items item)
            (set! (mut table) key items))))
  0)

;;; File the reference at position AT of the view's references under KEY in TABLE.
(defn source-index-add-reference! [(a (dyn Allocator))
                                   (table (mut (HashMap (slice u8)
                                                        (ptr (ArrayList i64)))))
                                   (key (slice u8))
                                   (at i64)] (-> i64)
  (match (get table key)
    (Some [items] (push! items at))
    (None []
          (let [items (new-boxed-list [i64] a)]
            (push! items at)
            (set! (mut table) key items))))
  0)

;;; The references TABLE files under KEY, as a list built for the asker.
(defn source-index-references [(a (dyn Allocator))
                               (table (ptr (HashMap (slice u8)
                                                    (ptr (ArrayList i64)))))
                               (key (slice u8))] (-> Sexp)
  (let [(mut out) (ArrayList::new [Sexp] a)
        all (sx-items (.source_references (comptime-unit-state)))]
    (match (get (load table) key)
      (Some [items]
            (reserve! (mut out) (len (load items)))
            (for [i 0 (len (load items))]
              (push! (mut out) (sx-at all (get (load items) i)))
              0))
      (None [] 0))
    (sx-mklist (box-al a (load out)))))

;;; What TABLE files under KEY, as a list: the stored list itself, or an empty one.
(defn source-index-list [(a (dyn Allocator))
                         (table (ptr (HashMap (slice u8) (ptr (ArrayList Sexp)))))
                         (key (slice u8))] (-> Sexp)
  (match (get (load table) key)
    (Some [items] (sx-mklist items))
    (None [] (sx-mklist (new-boxed-list [Sexp] a)))))

;;; `SOURCE:LO`, where a form was written.
(defn source-written-key [(a (dyn Allocator)) (source i64) (lo i64)]
  (-> (slice u8))
  (text/format a "{}:{}" (i64->str a source) (i64->str a lo)))

(defstruct ComptimeUnitState
  [(gensym GsCell)
   (lint_parameters LintParamBox)
   (warnings WarnBox)
   (sources SrcBox)
   (suggestions SugBox)
   (diagnostic_quiet DiagQuietCell)
   (suggestion_renames SugRenBox)
   (suggestion_gap SugGap)
   (rule_sources RuleSrcBox)
   (protected_rule_sources (ptr (ArrayList i64)))
   (target TargetArchCell)
   (debug_checks DebugChecksCell)
   (sanitizer SanitizeCell)
   (semantic_model SemModelBox)
   (macro_calls MacroCallBox)
   (types TypeMapBox)
   (binding_ids BidCell)
   (bindings BindMapBox)
   (resolutions ResMapBox)
   ; Results of earlier compilations that this pass reads through to, never writes.
   (semantic_base (ptr SemBase))
   (variant_owners VariantOwnerBox)
   (derivations DeriveReg)
   (opaque_items (ptr (array i64 1048576)))
   (opaque_count i64)
   ; Appended. See `method-decl-index`.
   (method_decls MethodDeclBox)
   ; Appended. The accepted checked functions of the session this compilation
   ; extends (null outside a retained session). A metaprogram closure reads
   ; through to it for a callee the candidate did not re-check -- a prelude
   ; impl method, say, that no earlier metaprogram needed.
   (closure_base (ptr checkedbase/CheckedBase))
   ; The same session's accepted signatures, a coil.compiler.sig_base SigBase
   ; (opaque here: the checker reads it).
   (closure_sigs (ptr i8))
   ; Appended. The session's accepted metaprogram environment: functions only
   ; compile-time code uses (the metaprogram shim, say) are checked there, not
   ; in the application base above. Null when there is none.
   (closure_meta_base (ptr checkedbase/CheckedBase))
   (closure_meta_sigs (ptr i8))
   (function_decls FunctionDeclIndex)
   (kind_decls KindDeclIndex)
   (dependency_graph (ptr dependencies/DependencyGraph))
   (source_modules Sexp)
   (source_references Sexp)
   ; Each authored occurrence the view recorded, by its occurrence key.
   (source_occurrences (HashMap (slice u8) SourceOccurrence))
   (source_ready bool)
   ; A publication not built yet: the view is built by calling SOURCE_BUILD on
   ; SOURCE_BUILD_CX the first time a query needs it (`source-view-ready?`).
   (source_build (fnptr (cc/C) [(ptr i8)] i64))
   (source_build_cx (ptr i8))
   (source_imports Sexp)
   (source_import_table (ptr (ArrayList ImpEntry)))
   (source_export_table (ptr (ArrayList ExpEntry)))
   (source_coverage_unknown Sexp)
   ; The unknown identifier above is inside a quasiquote template.
   (source_coverage_template bool)
   ; The caller asked to treat an imported name written in a quasiquote template as
   ; a free reference to the import, which is true unless the template itself binds
   ; that spelling. Set per `qualify-import` call.
   (source_assume_free bool)
   ; Appended. Where located diagnostics are written as they are drained, or null
   ; for stderr. A retained JIT session points it at the session's own diagnostic
   ; text, so its client reads every located error as data.
   (diagnostic_sink (ptr Writer))
   ; Appended. The source view's facts, by the key each query asks with.
   (source_index SourceIndex)
   ; Appended. The checked program's facts, by the key each query asks with.
   (program_facts ProgramFacts)])

;;; Send drained diagnostics to `w` instead of stderr; null restores stderr.
(defn diag-sink-set! [(w (ptr Writer))] (-> i64)
  (set! (.diagnostic_sink (comptime-unit-state)) w)
  0)

;;; The writer drained diagnostics go to.
(defn diag-out [] (-> (ptr Writer))
  (let [w (.diagnostic_sink (comptime-unit-state))]
    (if (= (primitive/cast i64 w) 0) (stderr) w)))

(defn set-closure-checked-base! [(base (ptr checkedbase/CheckedBase))
                                 (sigs (ptr i8))
                                 (meta-base (ptr checkedbase/CheckedBase))
                                 (meta-sigs (ptr i8))] (-> i64)
  (set! (.closure_base (comptime-unit-state)) base)
  (set! (.closure_sigs (comptime-unit-state)) sigs)
  (set! (.closure_meta_base (comptime-unit-state)) meta-base)
  (set! (.closure_meta_sigs (comptime-unit-state)) meta-sigs)
  0)

(defn closure-sigs-raw [] (-> (ptr i8))
  (.closure_sigs (comptime-unit-state)))

(defn closure-meta-sigs-raw [] (-> (ptr i8))
  (.closure_meta_sigs (comptime-unit-state)))

;;; Names of the accepted functions a closure may read through to whose names
;;; start with `prefix`, pushed onto `out`.
(defn closure-base-names-with-prefix! [(a (dyn Allocator))
                                       (prefix (slice u8))
                                       (out (mut (ArrayList (slice u8))))]
  (-> i64)
  (checked-base-names-with-prefix! a
                                   (.closure_base (comptime-unit-state))
                                   prefix
                                   (mut out))
  (checked-base-names-with-prefix! a
                                   (.closure_meta_base (comptime-unit-state))
                                   prefix
                                   (mut out)))

(defn checked-base-names-with-prefix! [(a (dyn Allocator))
                                       (base (ptr checkedbase/CheckedBase))
                                       (prefix (slice u8))
                                       (out (mut (ArrayList (slice u8))))]
  (-> i64)
  (let [(mut functions) (ArrayList::new [Func] a)]
    (checkedbase/checked-base-functions! base (mut functions))
    (for i (range 0 (len functions))
      (let [name (.name (elem (mut functions) i))]
        (when (starts-with name prefix) (push! (mut out) name) 0)))
    0))

;;; Whether `f` is the accepted checked function the closure read through to:
;;; the same body, not merely the same name.
(defn closure-base-accepted? [(f (ptr Func))] (-> bool)
  (match (closure-base-func (.name f))
    (Some [g] (= (primitive/cast i64 (.body g)) (primitive/cast i64 (.body f))))
    (None [] false)))

;;; The accepted checked body of `name` a closure may read through to, or None:
;;; the application's, else the metaprogram environment's.
(defn closure-base-func [(name (slice u8))] (-> (Option (ptr Func)))
  (match (checkedbase/checked-base-get (.closure_base (comptime-unit-state))
                                       name)
    (Some [function] (Some function))
    (None []
          (checkedbase/checked-base-get (.closure_meta_base (comptime-unit-state))
                                        name))))

(defn comptime-unit-state-cell [] (-> (ptr (ptr ComptimeUnitState)))
  (primitive/alloc-static (ptr ComptimeUnitState)))

(defn comptime-unit-state [] (-> (ptr ComptimeUnitState))
  (let [active (load (comptime-unit-state-cell))]
    (if (= (primitive/cast i64 active) 0)
        (primitive/alloc-static ComptimeUnitState)
        active)))

(defn comptime-unit-bind! [(next (ptr ComptimeUnitState))]
  (-> (ptr ComptimeUnitState))
  (let [prior (comptime-unit-state)]
    (set! (comptime-unit-state-cell) next)
    prior))

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)  ; the module_fns set index (module-fns-has)

(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.scratch" :as scratch)
(import "coil.compiler.mtrace" :use *)
(import "coil.compiler.trace" :as tr)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.sem_base" :use *)
(import "coil.compiler.checked_base" :as checkedbase)
(import "coil.compiler.dependencies" :as dependencies)
(import "coil.compiler.program_query" :as pq)
(import "coil.compiler.dep_index" :as deps)
(import "coil.compiler.type_references" :as type-refs)
(import "coil.compiler.retained_graph" :use [GraphKey graph-keyops])
(import "coil.compiler.ctval" :use *)  ; CtVal / EnvBind / CtCtx — the value model, now on its own

(import "coil.compiler.check" :use *)
(import "coil.compiler.expander" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.diag" :as diag)  ; locate-source: line/col by the source's line-start table

(import "coil.compiler.parser" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.cc" :as cc)

(defstruct CodeSessionRepairAnnotation [(key (slice u8)) (value i64)])

(defstruct CodeSessionRepair
  [(function (slice u8))
   (diagnostic (slice u8))
   (annotations (ArrayList CodeSessionRepairAnnotation))])

; One immutable Code value retained by a compiler SDK session. Candidate state
; lives in a separate arena until native publication succeeds; commit swaps the
; arenas in O(1), while abort releases only candidate allocations.
(defstruct CodeSessionState
  [(accepted_arena scratch/ScratchArena)
   (staged_arena scratch/ScratchArena)
   ; Retained independently so the source metaprogram can generate a typed
   ; condition transaction from original candidate Code after checking fails.
   (rejected_arena scratch/ScratchArena)
   (accepted Sexp)
   (staged Sexp)
   (rejected Sexp)
   (accepted_monomorphs Sexp)
   (staged_monomorphs Sexp)
   (has_accepted bool)
   (has_staged bool)
   (has_rejected bool)
   (has_accepted_monomorphs bool)
   (has_staged_monomorphs bool)
   ; Structured rejection selected by the source metaprogram. This survives a
   ; failed candidate abort so the SDK client can classify the pending branch
   ; without scraping rendered diagnostic text. The next transaction clears it.
   (pending_condition_kind i64)
   ; Structured function-owned checker failures for the rejected candidate.
   (repairs (ArrayList CodeSessionRepair))
   ; How many compilations this session has begun, including this one: a number
   ; that only grows, for `primitive/code-session-submission`.
   (submission i64)])

(defn code-session-new [(a (dyn Allocator))] (-> (ptr CodeSessionState))
  (let [state (box! a CodeSessionState (zeroed CodeSessionState))]
    (scratch/ScratchArena::init (field state accepted_arena) a)
    (scratch/ScratchArena::init (field state staged_arena) a)
    (scratch/ScratchArena::init (field state rejected_arena) a)
    (set! (.repairs state) (ArrayList::new [CodeSessionRepair] a))
    state))

(defn code-session-clear-repairs! [(state (ptr CodeSessionState))] (-> i64)
  (let [a (.alc (.repairs state))]
    (for [i 0 (len (.repairs state))]
      (let [repair (elem (field state repairs) i)]
        (free a (.function repair))
        (free a (.diagnostic repair))
        (for [j 0 (len (.annotations repair))]
          (let [annotation (elem (field repair annotations) j)]
            (free a (.key annotation))))
        (free! (field repair annotations))))
    (set! (field (field state repairs) len) 0))
  0)

(defn code-session-begin! [(state (ptr CodeSessionState))] (-> i64)
  (set! (.submission state) (+ (.submission state) 1))
  (reset! (field state staged_arena))
  (set! (.has_staged state) false)
  (set! (.has_staged_monomorphs state) false)
  (set! (.pending_condition_kind state) 0)
  (code-session-clear-repairs! state)
  0)

; Preserve client identity annotations from the exact rejected declaration.
; This reads the existing resolved form cache; it never reparses accepted bodies.
(defn code-session-append-repair-annotations! [(a (dyn Allocator))
                                               (out (ptr (ArrayList CodeSessionRepairAnnotation)))
                                               (f (ptr Func))] (-> i64)
  (for [i 0 (len (load (.annotations f)))]
    (let [annotation (elem (.annotations f) i)]
      (match (.kind (.value annotation))
        (EInt [value]
              (push! out
                     (CodeSessionRepairAnnotation
                       :key (text/format a "{}" (.key annotation))
                       :value value)))
        (_ 0))))
  0)

(defn code-session-repair-annotations [(a (dyn Allocator))
                                       (ws (ptr SemanticWorkspace))
                                       (owner (slice u8))]
  (-> (ArrayList CodeSessionRepairAnnotation))
  (let [(mut out) (ArrayList::new [CodeSessionRepairAnnotation] a)]
    (for [i 0 (len (.resolved_revisions ws))]
      (let [revision (elem (field ws resolved_revisions) i)]
        (match (get (.revision_heads ws) (.form_id (.revision revision)))
          (None [] 0)
          (Some [head]
                (do
                  (when (and (= head i)
                             (!= (primitive/cast i64 (.prog revision)) 0))
                    (let [functions (.funcs (.prog revision))]
                      (for [j 0 (len (load functions))]
                        (let [f (elem functions j)]
                          (when (= (.name f) owner)
                            (code-session-append-repair-annotations! a
                                                                     (mut out)
                                                                     f))))))
                  0)))))
    (load out)))

(defn code-session-record-check-repairs! [(state (ptr CodeSessionState))
                                          (s (mut LS))] (-> i64)
  (code-session-clear-repairs! state)
  (let [a (.alc (.repairs state))
        diags (load (field s check_diags))
        owners (load (field s check_diag_owners))
        n (len (load diags))]
    (for [i 0 n]
      (let [owner (if (< i (len (load owners))) (get (load owners) i) "")]
        (if (> (len owner) 0)
            (let [(mut dp) (: (get (load diags) i) Diag)
                  annotations
                    (code-session-repair-annotations a
                                                     (semantic-workspace (mut s))
                                                     owner)]
              (push! (mut (.repairs state))
                     (CodeSessionRepair
                       :function (text/format a "{}" owner)
                       :diagnostic (text/format a "{}" (.msg dp))
                       :annotations (load annotations))))
            0)))
    0))

(defn code-session-repair-count [(state (ptr CodeSessionState))] (-> i64)
  (len (.repairs state)))

(defn code-session-repair-function [(state (ptr CodeSessionState))
                                    (index i64)] (-> (slice u8))
  (if (or (< index 0) (>= index (len (.repairs state))))
      ""
      (.function (elem (field state repairs) index))))

(defn code-session-repair-diagnostic [(state (ptr CodeSessionState))
                                      (index i64)] (-> (slice u8))
  (if (or (< index 0) (>= index (len (.repairs state))))
      ""
      (.diagnostic (elem (field state repairs) index))))

(defn code-session-repair-annotation-i64! [(state (ptr CodeSessionState))
                                           (index i64)
                                           (key (slice u8))
                                           (value (ptr i64))] (-> bool)
  (block :found
    (when (or (< index 0) (>= index (len (.repairs state))))
      (break :found false))
    (let [repair (elem (field state repairs) index)]
      (for [i 0 (len (.annotations repair))]
        (let [annotation (elem (field repair annotations) i)]
          (when (= (.key annotation) key)
            (set! value (.value annotation))
            (break :found true)))))
    false))

(defn code-session-abort! [(state (ptr CodeSessionState))] (-> i64)
  ; Rotate the staged arena into rejected ownership before clearing the failed
  ; compiler transaction. The next candidate receives the old, reset rejected
  ; arena, so no Code value borrows storage that expansion can overwrite.
  (if (.has_staged state)
      (do
        (reset! (field state rejected_arena))
        (let [empty (.rejected_arena state)]
          (set! (.rejected_arena state) (.staged_arena state))
          (set! (.staged_arena state) empty))
        (set! (.rejected state) (.staged state))
        (set! (.has_rejected state) true))
      0)
  (reset! (field state staged_arena))
  (set! (.has_staged state) false)
  (set! (.has_staged_monomorphs state) false)
  0)

(defn code-session-reset! [(state (ptr CodeSessionState))] (-> i64)
  (reset! (field state accepted_arena))
  (reset! (field state staged_arena))
  (reset! (field state rejected_arena))
  (set! (.has_accepted state) false)
  (set! (.has_staged state) false)
  (set! (.has_rejected state) false)
  (set! (.has_accepted_monomorphs state) false)
  (set! (.has_staged_monomorphs state) false)
  (set! (.pending_condition_kind state) 0)
  (code-session-clear-repairs! state)
  0)

;;; Release a session state and its arenas. The state must not be used again.
(defn code-session-free! [(state (ptr CodeSessionState))] (-> i64)
  (let [a (.alc (.repairs state))]
    (code-session-reset! state)
    (free! (mut (.repairs state)))
    (close! (field state accepted_arena))
    (close! (field state staged_arena))
    (close! (field state rejected_arena))
    (free [CodeSessionState] a (slice::new state 1))
    0))

(defn code-session-commit! [(state (ptr CodeSessionState))] (-> i64)
  (if (not (.has_staged state))
      0
      (do
        ; Reset before copying the reusable arena header. Copying first retains
        ; the old segment pointer in the value copy; reset then frees that
        ; segment, and installing the stale copy as `staged_arena` makes the
        ; next transaction free it a second time.
        (reset! (field state accepted_arena))
        (let [old-accepted (.accepted_arena state)]
          (set! (.accepted_arena state) (.staged_arena state))
          (set! (.staged_arena state) old-accepted)
          (set! (.accepted state) (.staged state))
          (set! (.has_accepted state) true)
          (if (.has_staged_monomorphs state)
              (do
                (set! (.accepted_monomorphs state) (.staged_monomorphs state))
                (set! (.has_accepted_monomorphs state) true))
              0)
          (set! (.has_staged state) false)
          (set! (.has_staged_monomorphs state) false)
          (reset! (field state rejected_arena))
          (set! (.has_rejected state) false)
          (set! (.pending_condition_kind state) 0)
          (code-session-clear-repairs! state)
          0))))

(defn code-session-condition-kind [(state (ptr CodeSessionState))] (-> i64)
  (.pending_condition_kind state))

(defn cop-code-session-state [(op i64)
                              (args (ptr (ArrayList CtVal)))
                              (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [raw (load (field cx code_session_state))]
    (if (= (primitive/cast i64 raw) 0)
        (Err [CtVal Diag]
             (derr "retained Code state is only available inside a compiler SDK session"))
        (let [state (primitive/cast (ptr CodeSessionState) raw)]
          (cond (= op 76)
                  (match (cv-get args 0)
                    (None []
                          (Err [CtVal Diag]
                               (derr "code-session-state: expects one default Code value")))
                    (Some [fallback]
                          (if (not (is-ccode fallback))
                              (Err [CtVal Diag]
                                   (derr "code-session-state: default must be Code"))
                              (if (.has_accepted state)
                                  (let [(mut stored) (: (.accepted state) Sexp)]
                                    (Ok [CtVal Diag]
                                        (CCode (sexp-own-into (.a cx)
                                                              (mut stored)))))
                                  (Ok [CtVal Diag] fallback)))))
                (= op 78)
                  (if (.has_accepted_monomorphs state)
                      (let [(mut stored) (: (.accepted_monomorphs state) Sexp)]
                        (Ok [CtVal Diag]
                            (CCode (sexp-own-into (.a cx)
                                                  (mut stored)))))
                      (let [(mut empty) (ArrayList::new [Sexp] (.a cx))]
                        (push! (mut empty) (sx-sym "monomorph-artifacts"))
                        (Ok [CtVal Diag]
                            (CCode (sx-mklist (box-al (.a cx)
                                                      (load empty)))))))
                (= op 80)
                  (match (cv-get args 0)
                    (None []
                          (Err [CtVal Diag]
                               (derr "code-session-rejected-state: expects one default Code value")))
                    (Some [fallback]
                          (if (not (is-ccode fallback))
                              (Err [CtVal Diag]
                                   (derr "code-session-rejected-state: default must be Code"))
                              (if (.has_rejected state)
                                  (let [(mut stored) (: (.rejected state) Sexp)]
                                    (Ok [CtVal Diag]
                                        (CCode (sexp-own-into (.a cx)
                                                              (mut stored)))))
                                  (Ok [CtVal Diag] fallback)))))
                (= op 82)
                  (match (cv-get args 0)
                    (None []
                          (Err [CtVal Diag]
                               (derr "code-session-staged-state: expects one default Code value")))
                    (Some [fallback]
                          (if (not (is-ccode fallback))
                              (Err [CtVal Diag]
                                   (derr "code-session-staged-state: default must be Code"))
                              (if (.has_staged state)
                                  (let [(mut stored) (: (.staged state) Sexp)]
                                    (Ok [CtVal Diag]
                                        (CCode (sexp-own-into (.a cx)
                                                              (mut stored)))))
                                  (Ok [CtVal Diag] fallback)))))
                (= op 79)
                  (match (cv-get args 0)
                    (None []
                          (Err [CtVal Diag]
                               (derr "code-session-condition!: expects one integer condition kind")))
                    (Some [kind]
                          (match kind
                            (CInt [value]
                                  (if (<= value 0)
                                      (Err [CtVal Diag]
                                           (derr "code-session-condition!: condition kind must be positive"))
                                      (do
                                        (set! (.pending_condition_kind state)
                                              value)
                                        (Ok [CtVal Diag] (CInt 0)))))
                            (_ (Err [CtVal Diag]
                                    (derr "code-session-condition!: condition kind must be an integer"))))))
                :else
                  (match (cv-get args 0)
                    (None []
                          (Err [CtVal Diag]
                               (derr "code-session-stage!: expects one Code value")))
                    (Some [value]
                          (if (not (is-ccode value))
                              (Err [CtVal Diag]
                                   (derr "code-session-stage!: value must be Code"))
                              (do
                                (reset! (field state
                                               staged_arena))
                                (let [(mut source) (ccode-of value)]
                                  (set! (.staged state)
                                        (sexp-own-into (allocator (field state
                                                                         staged_arena))
                                                       (mut source))))
                                (set! (.has_staged state) true)
                                (Ok [CtVal Diag] (CInt 0)))))))))))

(defn is-aggregate [(c (ptr CtVal))] (-> bool)
  (match (load c)
    (CStruct [name fields] true)
    (CArray [elem cells] true)
    (CSlice [elem cells] true)
    (CSum [variant fields] true)
    (CInt [v] false)
    (CWideInt [_ _ _] false)
    (CBool [b] false)
    (CFloat [x] false)
    (CStr [s] false)
    (CCode [f] false)
    (CRef [cell] false)))

(defn clone-cells [(cells (ptr (ArrayList (ptr CtVal))))]
  (-> (ptr (ArrayList (ptr CtVal))))
  (let [a (unit-allocator)
        n (len (load cells))
        (mut out) (ArrayList::new [(ptr CtVal)] a)]
    (for [i 0 n]
      (push! (mut out)
             (new-cell (deep-clone (get (load cells) i)))))
    (box-al a (load out))))

(defn deep-clone [(c (ptr CtVal))] (-> CtVal)
  (match (load c)
    (CStruct [name fields] (CStruct name (clone-cells fields)))
    (CArray [elem cells] (CArray elem (clone-cells cells)))
    (CSlice [elem cells] (CSlice elem (clone-cells cells)))
    (CSum [variant fields] (CSum variant (clone-cells fields)))
    (CInt [v] (CInt v))
    (CWideInt [t lo hi]
              (CWideInt
                :ty t
                :lo lo
                :hi hi))
    (CBool [b] (CBool b))
    (CFloat [x] (CFloat x))
    (CStr [s] (CStr s))
    (CCode [f] (CCode f))
    (CRef [cell] (CRef cell))))

(defn to-content [(c (ptr CtVal))] (-> CtVal)
  (match (load c)
    (CRef [cell] (deep-clone cell))
    (CInt [v] (CInt v))
    (CWideInt [t lo hi]
              (CWideInt
                :ty t
                :lo lo
                :hi hi))
    (CBool [b] (CBool b))
    (CFloat [x] (CFloat x))
    (CStr [s] (CStr s))
    (CCode [f] (CCode f))
    (CStruct [name fields] (CStruct name fields))
    (CArray [elem cells] (CArray elem cells))
    (CSlice [elem cells] (CSlice elem cells))
    (CSum [variant fields] (CSum variant fields))))

(defn cell-value [(cell (ptr CtVal))] (-> CtVal)
  (if (is-aggregate cell) (CRef cell) (load cell)))

(defsum Flow
  (FVal [(v CtVal)])
  (FBrk [(value (Option CtVal)) (label (Option (slice u8)))])
  (FCont [(label (Option (slice u8)))]))

(defstruct CtFoldHook
  [(isset i64)
   (fp (fnptr (cc/C) [(ref (dyn Allocator)) (ptr Expr) (ptr CtCtx)] (ptr i8)))])

(defn ct-fold-hook [] (-> (ptr CtFoldHook))
  (primitive/alloc-static CtFoldHook))

(defn set-comptime-fold-hook! [(fp (fnptr (cc/C)
                                          [(ref (dyn Allocator))
                                           (ptr Expr)
                                           (ptr CtCtx)]
                                          (ptr i8)))] (-> i64)
  (let [b (ct-fold-hook)] (set! (.fp b) fp) (set! (.isset b) 1) 0))

; A CAPABILITY gap — the interpreter says "isn't supported yet" for a construct real
; codegen CAN do (sizeof/alignof/offsetof, a generic call, a string, a bitfield op, a
; function pointer, an aggregate-const ref, a trait call, …). ONLY those are routed to
; the compiled engine; a genuine SEMANTIC error (division by zero, an arithmetic type
; mismatch, a non-place target) must stand exactly as the interpreter reported it — the
; compiled engine would silently compute a target-specific value (arm64 idiv-by-0 = 0)
; or crash, masking the bug. The "supported yet" wording is the interpreter's own
; convention for "valid code I can't evaluate", so it is a reliable discriminator.
(defn ct-tag [(v CtVal)] (-> i64)
  (match v
    (CInt [n] 0)
    (CBool [b] 1)
    (CFloat [x] 2)
    (CStr [s] 3)
    (CCode [f] 4)
    (CStruct [a b] 5)
    (CArray [a b] 6)
    (CSlice [a b] 9)
    (CSum [a b] 7)
    (CRef [c] 8)
    (CWideInt [_ _ _] 10)))

(defn cint-of [(v CtVal)] (-> i64)
  (match v
    (CInt [n] n)
    (CBool [b] 0)
    (CFloat [x] 0)
    (CStr [s] 0)
    (CCode [f] 0)
    (CStruct [a b] 0)
    (CArray [a b] 0)
    (CSlice [a b] 0)
    (CSum [a b] 0)
    (CRef [c] 0)
    ; every reader asks ct-tag first; a wide value read as an i64 is a bug
    (CWideInt [_ _ _]
              (unimplemented "comptime: a 128-bit value read as a 64-bit integer"))))

(defn cfloat-of [(v CtVal)] (-> f64)
  (match v
    (CFloat [x] x)
    (CInt [n] 0.0)
    (CBool [b] 0.0)
    (CStr [s] 0.0)
    (CCode [f] 0.0)
    (CStruct [a b] 0.0)
    (CArray [a b] 0.0)
    (CSlice [a b] 0.0)
    (CSum [a b] 0.0)
    (CRef [c] 0.0)
    (CWideInt [_ _ _] 0.0)))

(defn cbool-of [(v CtVal)] (-> bool)
  (match v
    (CBool [b] b)
    (CInt [n] false)
    (CFloat [x] false)
    (CStr [s] false)
    (CCode [f] false)
    (CStruct [a b] false)
    (CArray [a b] false)
    (CSlice [a b] false)
    (CSum [a b] false)
    (CRef [c] false)
    (CWideInt [_ _ _] false)))

; bits->f64 moved to coil.mem (it was defined identically here and in interp.coil).
(defn trunc [(n i64) (bits i64) (signed bool)] (-> i64)
  (if (>= bits 64)
      n
      (let [mask (primitive/isub (<< 1 bits) 1)
            masked (& n mask)]
        (if (and signed
                 (!= (& masked (<< 1 (primitive/isub bits 1)))
                     0))
            (primitive/isub masked (<< 1 bits))
            masked))))

(defn icmp-ord [(x i64) (y i64)] (-> i64)
  (if (< x y) -1 (when (> x y) 1)))

(defn fcmp-ord [(x f64) (y f64)] (-> i64)
  (cond (< x y) -1
        (= x y) 0
        (> x y) 1
        :else -1))

(defn bool-ord [(x bool) (y bool)] (-> i64)
  (if (and (not x) y) -1 (when (and x (not y)) 1)))

(defn cmp-apply [(op i64) (ord i64)] (-> bool)
  (cond (= op 0) (= ord -1)
        (= op 1) (!= ord 1)
        (= op 2) (= ord 1)
        (= op 3) (!= ord -1)
        (= op 4) (= ord 0)
        :else (!= ord 0)))

(defn ct-divzero-msg [(rem bool)] (-> (slice u8))
  (if rem "comptime: remainder by zero" "comptime: division by zero"))

(defn wrap-mut [(v CtVal)] (-> CtVal)
  (if (= (ct-tag v) 8) v (CRef (new-cell v))))

(defn cast-trunc [(n i64) (ty Type)] (-> CtVal)
  (match ty
    (TConst [_] (do (abort) (CInt 0)))
    (TInt [bits signed] (CInt (trunc n bits signed)))
    (TFloat [b] (CInt n))
    (TBool [] (CInt n))
    (TVoid [] (CInt n))
    (TPtr [i] (CInt n))
    (TRef [m i] (CInt n))
    (TStruct [nm] (CInt n))
    (TArray [e k] (CInt n))
    (TSlice [e] (CInt n))
    (TVec [e k] (CInt n))
    (TFn [c p r] (CInt n))
    (TApp [nm ar] (CInt n))
    (TNever [] (CInt n))
    (TError [] (CInt n))
    (TCode [] (CInt n))
    (TCodeBuilder [] (CInt n))
    (TExternRef [] (CInt n))))

(defn cref-cell [(v CtVal)] (-> (ptr CtVal))
  (match v (CRef [c] c) (_ (primitive/cast (ptr CtVal) 0))))

(defn cstruct-name [(v CtVal)] (-> (slice u8))
  (match v (CStruct [nm f] nm) (_ "")))

(defn cstruct-fields [(v CtVal)] (-> (ptr (ArrayList (ptr CtVal))))
  (match v
    (CStruct [nm f] f)
    (_ (primitive/cast (ptr (ArrayList (ptr CtVal))) 0))))

(defn carray-cells [(v CtVal)] (-> (ptr (ArrayList (ptr CtVal))))
  (match v
    (CArray [el c] c)
    (_ (primitive/cast (ptr (ArrayList (ptr CtVal))) 0))))

(defn csum-variant [(v CtVal)] (-> (slice u8))
  (match v (CSum [vr f] vr) (_ "")))

(defn csum-fields [(v CtVal)] (-> (ptr (ArrayList (ptr CtVal))))
  (match v (CSum [vr f] f) (_ (primitive/cast (ptr (ArrayList (ptr CtVal))) 0))))

(defn is-aggregate-v [(c CtVal)] (-> bool)
  (let [t (ct-tag c)]
    (or (= t 5) (= t 6) (= t 7))))

(defn to-content-v [(v CtVal)] (-> CtVal)
  (to-content (new-cell v)))

(defn opt-ctval-or [(o (Option CtVal))] (-> CtVal)
  (match o (Some [v] v) (None [] (CInt 0))))

(defn lbl-match [(l (Option (slice u8))) (label (Option (slice u8)))] (-> bool)
  (match l
    (None [] true)
    (Some [ls] (match label (None [] false) (Some [lab] (= ls lab))))))

(defn diag-some? [(o (Option Diag))] (-> bool)
  (match o (Some [d] true) (None [] false)))

(defn dec->str [(a (dyn Allocator)) (n i64)] (-> (slice u8))
  (if (= n 0)
      "0"
      (let [neg (< n 0)
            (mut m) (if neg (primitive/isub 0 n) n)
            tmp
              (primitive/cast (ptr u8)
                              (primitive/cast (ptr i8)
                                              (data (match (alloc-bytes a
                                                                        24
                                                                        1)
                                                      (Some [s] s)
                                                      (None []
                                                            (do
                                                              (oom-at c"compiler allocation"
                                                                      24)
                                                              (slice::new (primitive/cast (ptr u8)
                                                                                          0)
                                                                          0)))))))
            (mut cnt) 0]
        (loop (if (= (load m) 0)
                  (break)
                  (do
                    (set! (index tmp (load cnt))
                          (primitive/cast u8
                                          (primitive/iadd (primitive/urem (load m)
                                                                          10)
                                                          48)))
                    (set! cnt (primitive/iadd (load cnt) 1))
                    (set! m (primitive/udiv (load m) 10)))))
        (let [extra (when neg 1)
              total (primitive/iadd (load cnt) extra)
              out
                (primitive/cast (ptr u8)
                                (primitive/cast (ptr i8)
                                                (data (match (alloc-bytes a
                                                                          total
                                                                          1)
                                                        (Some [s] s)
                                                        (None []
                                                              (do
                                                                (oom-at c"compiler allocation"
                                                                        total)
                                                                (slice::new (primitive/cast (ptr u8)
                                                                                            0)
                                                                            0)))))))
              (mut j) (when neg 1)
              (mut k) (load cnt)]
          (when neg (set! (index out 0) (: 45 u8)) 0)
          (loop (if (= (load k) 0)
                    (break)
                    (do
                      (set! k (primitive/isub (load k) 1))
                      (set! (index out (load j))
                            (load (index tmp (load k))))
                      (set! j (primitive/iadd (load j) 1)))))
          (slice::new [u8] out total)))))

; The last struct named NAME in LST (null for a null list), or null.
(defn ct-struct-scan [(lst (ptr (ArrayList StructDef))) (name (slice u8))]
  (-> (ptr StructDef))
  (let [(mut r) (primitive/cast (ptr StructDef) 0)]
    (unless (= (primitive/cast i64 lst) 0)
      (for [i 0 (len (load lst))]
        (when (= (.name (elem lst i)) name)
          (set! r (elem lst i))
          0))
      0)
    (load r)))

; The last sum named NAME in LST (null for a null list), or null.
(defn ct-sum-scan [(lst (ptr (ArrayList SumDef))) (name (slice u8))]
  (-> (ptr SumDef))
  (let [(mut r) (primitive/cast (ptr SumDef) 0)]
    (unless (= (primitive/cast i64 lst) 0)
      (for [i 0 (len (load lst))]
        (when (= (.name (elem lst i)) name)
          (set! r (elem lst i))
          0))
      0)
    (load r)))

;;; Every struct a metaprogram can reflect on: the program's, then the ones the
;;; expansion walk generated that the program does not define. The program's
;;; own list, uncopied, when the walk generated none. For a reflection that
;;; enumerates; a lookup by name reads the two lists in turn instead.
(defn ct-structs-visible [(cx (ptr CtCtx))] (-> (ptr (ArrayList StructDef)))
  (let [base (load (field cx structs))
        gen (.gen_structs cx)]
    (if (or (= (primitive/cast i64 gen) 0) (= (len (load gen)) 0))
        base
        (let [a (.a cx)
              (mut out) (ArrayList::new [StructDef] a)
              (mut have) (HashMap::new [(slice u8) i64] a (keyops-borrowed))]
          (for [i 0 (len (load base))]
            (push! (mut out) (get (load base) i))
            (set! (mut have) (.name (elem base i)) 0)
            0)
          (for [j 0 (len (load gen))]
            (unless (contains? have (.name (elem gen j)))
              (push! (mut out) (get (load gen) j))
              0)
            0)
          (box-al a (load out))))))

;;; The sums counterpart of `ct-structs-visible`.
(defn ct-sums-visible [(cx (ptr CtCtx))] (-> (ptr (ArrayList SumDef)))
  (let [base (load (field cx sums))
        gen (.gen_sums cx)]
    (if (or (= (primitive/cast i64 gen) 0) (= (len (load gen)) 0))
        base
        (let [a (.a cx)
              (mut out) (ArrayList::new [SumDef] a)
              (mut have) (HashMap::new [(slice u8) i64] a (keyops-borrowed))]
          (for [i 0 (len (load base))]
            (push! (mut out) (get (load base) i))
            (set! (mut have) (.name (elem base i)) 0)
            0)
          (for [j 0 (len (load gen))]
            (unless (contains? have (.name (elem gen j)))
              (push! (mut out) (get (load gen) j))
              0)
            0)
          (box-al a (load out))))))

;;; The struct named NAME a metaprogram sees: the program's (the last of that
;;; name), else one the expansion walk generated, else the semantic model's.
(defn ct-struct-find [(cx (ptr CtCtx)) (name (slice u8))] (-> (ptr StructDef))
  (let [own (ct-struct-scan (load (field cx structs)) name)
        (mut r)
          (if (= (primitive/cast i64 own) 0)
              (ct-struct-scan (.gen_structs cx) name)
              own)]
    (if (!= (primitive/cast i64 (load r)) 0)
        (load r)
        (let [p (sem-model)]
          (if (= (primitive/cast i64 p) 0)
              (load r)
              (let [model-lst (load (field p structs))
                    model-n (len model-lst)]
                (for [j 0 model-n]
                  (when (= (.name (elem model-lst
                                        j))
                           name)
                    (set! r (elem model-lst j))
                    0))
                (load r)))))))

(defn is-u8 [(t Type)] (-> bool)
  (match t (TInt [bits signed] (= bits 8)) (_ false)))

(defn zeroed-struct-cells [(flds (ptr (ArrayList Field))) (cx (ptr CtCtx))]
  (-> (Result (ptr (ArrayList (ptr CtVal))) Diag))
  (let [a (.a cx)
        nf (len (load flds))
        (mut out) (ArrayList::new [(ptr CtVal)] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) nf))
              (break)
              (do
                (match (zeroed-content (.ty (elem flds (load i)))
                                       cx)
                  (Err [d] (do (set! errf (Some d)) 0))
                  (Ok [c] (do (push! (mut out) (new-cell c)) 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList (ptr CtVal))) Diag] d))
      (None []
            (Ok [(ptr (ArrayList (ptr CtVal))) Diag]
                (box-al a (load out)))))))

(defn zeroed-array-cells [(el Type) (k i64) (cx (ptr CtCtx))]
  (-> (Result (ptr (ArrayList (ptr CtVal))) Diag))
  (let [a (.a cx)
        (mut out) (ArrayList::new [(ptr CtVal)] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) k))
              (break)
              (do
                (match (zeroed-content el cx)
                  (Err [d] (do (set! errf (Some d)) 0))
                  (Ok [c] (do (push! (mut out) (new-cell c)) 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList (ptr CtVal))) Diag] d))
      (None []
            (Ok [(ptr (ArrayList (ptr CtVal))) Diag]
                (box-al a (load out)))))))

; T := concrete substitution built from a generic def's type params and the type
; args of an application, so `(ArrayList i64)` can be zeroed by zeroing ArrayList's
; fields with T bound to i64.
(defn subst-from-targs [(a (dyn Allocator))
                        (tps (ptr (ArrayList (slice u8))))
                        (targs (ptr (ArrayList Type)))]
  (-> (ptr (ArrayList SubstEntry)))
  (let [s (subst-new a)
        ntp (len (load tps))
        nta (len (load targs))]
    (for [i 0 ntp]
      (when (< i nta)
        (subst-insert! s
                       (get (load tps) i)
                       (elem targs i))))
    s))

(defn zeroed-struct-cells-subst [(flds (ptr (ArrayList Field)))
                                 (subst (ptr (ArrayList SubstEntry)))
                                 (cx (ptr CtCtx))]
  (-> (Result (ptr (ArrayList (ptr CtVal))) Diag))
  (let [a (.a cx)
        nf (len (load flds))
        (mut out) (ArrayList::new [(ptr CtVal)] a)
        (mut i) 0
        (mut errf) (None [Diag])]
    (loop (if (or (diag-some? (load errf)) (>= (load i) nf))
              (break)
              (do
                (match (zeroed-content (subst-apply a
                                                    (field (elem flds
                                                                 (load i))
                                                           ty)
                                                    subst)
                                       cx)
                  (Err [d] (do (set! errf (Some d)) 0))
                  (Ok [c] (do (push! (mut out) (new-cell c)) 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (match (load errf)
      (Some [d] (Err [(ptr (ArrayList (ptr CtVal))) Diag] d))
      (None []
            (Ok [(ptr (ArrayList (ptr CtVal))) Diag]
                (box-al a (load out)))))))

(defn zeroed-content [(ty Type) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (.a cx)]
    (match ty
      (TConst [_]
              (Err [CtVal Diag]
                   (derr "a constant generic argument is not a runtime type")))
      (TInt [bits signed] (Ok [CtVal Diag] (CInt 0)))
      (TBool [] (Ok [CtVal Diag] (CBool false)))
      (TFloat [bits] (Ok [CtVal Diag] (CFloat 0.0)))
      (TSlice [el]
              (if (is-u8 (load el))
                  (Ok [CtVal Diag] (CStr ""))
                  (Err [CtVal Diag]
                       (derr "comptime: `zeroed` of this type isn't supported yet"))))
      (TStruct [n]
               (let [sd (ct-struct-find cx n)]
                 (if (= (primitive/cast i64 sd) 0)
                     (Err [CtVal Diag]
                          (derr (text/format a
                                             "comptime: unknown struct '{}'"
                                             n)))
                     (match (zeroed-struct-cells (load (field sd fields)) cx)
                       (Err [d] (Err [CtVal Diag] d))
                       (Ok [cells] (Ok [CtVal Diag] (CStruct n cells)))))))
      (TArray [el k-extent]
              (let [k (extent-value k-extent)]
                (match (zeroed-array-cells (load el) k cx)
                  (Err [d] (Err [CtVal Diag] d))
                  (Ok [cells] (Ok [CtVal Diag] (CArray (load el) cells))))))
      (TVoid []
             (Err [CtVal Diag]
                  (derr "comptime: `zeroed` of this type isn't supported yet")))
      ; A zeroed pointer is NULL. Represented as CInt 0 — the interpreter models a
      ; live pointer as CRef (a cell), which a null pointer by definition has not got.
      ; Needed because every generic container has a `(ptr T)` data field.
      (TPtr [i] (Ok [CtVal Diag] (CInt 0)))
      (TRef [m i]
            (Err [CtVal Diag]
                 (derr "comptime: `zeroed` of this type isn't supported yet")))
      (TVec [e k]
            (Err [CtVal Diag]
                 (derr "comptime: `zeroed` of this type isn't supported yet")))
      ; A zeroed function pointer is NULL, same as TPtr. `Allocator` is a struct of
      ; fnptr fields, so every allocator-shaped value needs this to be zeroable.
      (TFn [c p r] (Ok [CtVal Diag] (CInt 0)))
      ; A generic struct application, e.g. (ArrayList i64): find the generic def and
      ; zero its fields under T := the type args.
      (TApp [nm ar]
            (let [sd (ct-struct-find cx nm)]
              (if (= (primitive/cast i64 sd) 0)
                  (Err [CtVal Diag]
                       (derr (text/format a
                                          "comptime: unknown generic struct '{}'"
                                          nm)))
                  (match (zeroed-struct-cells-subst (load (field sd fields))
                                                    (subst-from-targs a
                                                                      (load (field sd
                                                                                   type_params))
                                                                      ar)
                                                    cx)
                    (Err [d] (Err [CtVal Diag] d))
                    (Ok [cells] (Ok [CtVal Diag] (CStruct nm cells)))))))
      (TNever []
              (Err [CtVal Diag]
                   (derr "comptime: `zeroed` of this type isn't supported yet")))
      (TError []
              (Err [CtVal Diag]
                   (derr "comptime: `zeroed` of an unchecked type")))
      (TCode []
             (Err [CtVal Diag]
                  (derr "comptime: `zeroed` of this type isn't supported yet")))
      (TCodeBuilder []
                    (Err [CtVal Diag]
                         (derr "comptime: `zeroed` of this type isn't supported yet")))
      (TExternRef []
                  (Err [CtVal Diag]
                       (derr "comptime: `zeroed` of this type isn't supported yet"))))))

(defn zeroed-value [(ty Type) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (match (zeroed-content ty cx)
    (Err [d] (Err [CtVal Diag] d))
    (Ok [c] (Ok [CtVal Diag] (if (is-aggregate-v c) (CRef (new-cell c)) c)))))

(defn vals->cells [(vals (ptr (ArrayList CtVal))) (a (dyn Allocator))]
  (-> (ptr (ArrayList (ptr CtVal))))
  (let [n (len (load vals))
        (mut out) (ArrayList::new [(ptr CtVal)] a)]
    (for [i 0 n]
      (push! (mut out)
             (new-cell (to-content-v (get (load vals) i)))))
    (box-al a (load out))))

(defn match-arm-find [(arms (ptr (ArrayList Arm))) (variant (slice u8))]
  (-> (ptr Arm))
  (let [n (len (load arms))
        (mut r) (primitive/cast (ptr Arm) 0)]
    (for [i 0 n]
      (when (= (.variant (elem arms i))
               variant)
        (set! r (elem arms i))
        (break)))
    (load r)))

(defsum ArgsOut
  (AOK [(vals (ptr (ArrayList CtVal)))])
  (AFlow [(f Flow)]))

(defsum LoopStep
  (LSAgain [])
  (LSDone [(v CtVal)])
  (LSProp [(f Flow)]))

(defstruct GsCell [(n i64)])

(defn gensym-cell [] (-> (ptr GsCell))
  (field (comptime-unit-state) gensym))

(defn next-gensym [] (-> i64)
  (let [c (gensym-cell)
        v (.n c)]
    (set! (.n c) (primitive/iadd v 1))
    v))

; Append "in <metaprogram>" to a comptime error when one is executing. The bare
; message names neither the macro nor the form, and its location is the point the
; engine was ENTERED from — a module's import line — so it reads as though the
; user's file is at fault when the bug is inside a macro they cannot see. One
; word fixes that, and it is the single most useful word in the message.
(defn ct-in-meta [(a (dyn Allocator)) (msg (slice u8))] (-> (slice u8))
  (let [who (mtrace-current)]
    (if (= (len who) 0)
        msg
        (text/format a "{}, raised inside metaprogram {}" msg who))))

; ── CLI parameters for lint/checker metaprograms.
; Values stay strings intentionally: the checker owns its schema, parsing, validation,
; and default. Keys are conventionally qualified by rule namespace so independently
; loaded rules cannot accidentally share configuration.
(defstruct LintParam [(key (slice u8)) (value (slice u8)) (spec (slice u8))])

(defstruct LintParamBox [(init i64) (lst (ptr (ArrayList LintParam)))])

(defn lint-param-box [] (-> (ptr LintParamBox))
  (field (comptime-unit-state) lint_parameters))

(defn lint-params [] (-> (ptr (ArrayList LintParam)))
  (let [b (lint-param-box)]
    (when (= (.init b) 0)
      (store! (field b lst)
              (box! (unit-allocator)
                    (ArrayList LintParam)
                    (zeroed (ArrayList LintParam))))
      (set! (load (field b lst)) (ArrayList::new [LintParam] (unit-allocator)))
      (set! (.init b) 1)
      0)
    (load (field b lst))))

(defn lint-param-add-spec [(spec (slice u8))] (-> bool)
  (let [n (len spec)
        (mut split) -1]
    (for [i 0 n]
      (when (= (primitive/cast i64 (get spec i)) 61)
        (set! split i)
        (break)
        0))
    (if (or (<= (load split) 0) (>= (load split) (primitive/isub n 1)))
        false
        (let [(mut p) (zeroed LintParam)]
          (set! (.key p) (subslice spec 0 (load split)))
          (set! (.value p) (subslice spec (primitive/iadd (load split) 1) n))
          (set! (.spec p) spec)
          (push! (lint-params) p)
          true))))

(defn lint-param-get [(key (slice u8)) (fallback (slice u8))] (-> (slice u8))
  (let [params (lint-params)
        (mut i) (primitive/isub (len (load params)) 1)
        (mut out) fallback]
    (loop (if (< (load i) 0)
              (break)
              (let [p (get (load params) (load i))]
                (if (= (.key p) key)
                    (do (set! out (.value p)) (break))
                    (set! i (primitive/isub (load i) 1))))))
    (load out)))

(defn cop-lint-param [(args (ptr (ArrayList CtVal)))] (-> (Result CtVal Diag))
  (match (cv-get args 0)
    (None []
          (Err [CtVal Diag]
               (derr "lint-param: expects (primitive/lint-param KEY DEFAULT)")))
    (Some [key]
          (match (cv-get args 1)
            (None []
                  (Err [CtVal Diag]
                       (derr "lint-param: expects (primitive/lint-param KEY DEFAULT)")))
            (Some [fallback]
                  (if (and (is-cstr key) (is-cstr fallback))
                      (Ok [CtVal Diag]
                          (CStr (lint-param-get (cstr-of key)
                                                (cstr-of fallback))))
                      (Err [CtVal Diag]
                           (derr "lint-param: KEY and DEFAULT must be strings"))))))))

; ── compile-time diagnostic collector for `(primitive/warn …)`/`(primitive/report …)` from checkers.
; Both COLLECT (non-aborting) so a checker surfaces EVERY warning and error in one
; run; the build fails afterward iff any error-severity diagnostic was reported.
(defstruct WarnBox
  [(init i64) (lst (ptr (ArrayList Diag))) (errs i64) (drained i64)])

(defn warn-box [] (-> (ptr WarnBox))
  (field (comptime-unit-state) warnings))

(defn warn-list [] (-> (ptr (ArrayList Diag)))
  (let [b (warn-box)]
    (when (= (.init b) 0)
      (store! (field b lst)
              (box! (unit-allocator)
                    (ArrayList Diag)
                    (zeroed (ArrayList Diag))))
      (set! (load (field b lst)) (ArrayList::new [Diag] (unit-allocator)))
      (set! (.init b) 1)
      0)
    (load (field b lst))))

(defn warn-push [(d Diag)] (-> i64)
  (push! (warn-list) d)
  0)

; ── ownership at the metaprogram boundary (docs/design/META_MEMORY.md) ─────────
; Under COIL_META_ARENA a metaprogram's allocations live in a per-expansion
; arena that is reset when the expansion returns. Anything recorded into a
; GLOBAL list from inside one — warnings, reports, suggested fixes — must OWN
; its bytes, not borrow the arena's. Diagnostics are rare, so the unconditional
; copy is noise, and it is the difference between a lint finding and a
; use-after-reset.
(defn sexp-own-str-into [(a (dyn Allocator)) (s (slice u8))] (-> (slice u8))
  (let [n (len s)
        dst
          (data (match (alloc [u8]
                              a
                              (if (> n 0) n 1))
                  (Some [s] s)
                  (None []
                        (do
                          (oom-at c"compiler comptime" -1)
                          (slice::new (primitive/cast (ptr u8)
                                                      0)
                                      0)))))]
    (for [i 0 n]
      (set! (index dst i) (get s i)))
    (slice::new dst n)))

(defn ct-own-str [(s (slice u8))] (-> (slice u8))
  (sexp-own-str-into (unit-allocator) s))

; Deep copy INCLUDING string payloads — meta-copy-sexp copies structure but
; deliberately shares leaves, which is exactly wrong across an arena reset.
; KView nodes (tag 8) and joined lists (which read as lists) are FLATTENED to
; KList here: promotion is the boundary past which neither may survive
; (docs/design/META_MEMORY.md phase 5).
(defn sexp-own-into [(a (dyn Allocator)) (x (ptr Sexp))] (-> Sexp)
  (let [tg (sx-tag (load x))
        (mut owned)
          (: (if (or (= tg 6) (= tg 7) (= tg 8))
                 (let [n (code-node-len (load x))
                       (mut out) (ArrayList::new [Sexp] a)]
                   (reserve! (mut out) n)
                   (for [i 0 n]
                     (let [(mut e) (code-node-at (load x) i)]
                       (push! (mut out) (sexp-own-into a (mut e)))))
                   (mk-sexp-src (if (= tg 7)
                                    (KVec (box-al a (load out)))
                                    (KList (box-al a (load out))))
                                x))
                 (if (or (= tg 2) (= tg 3) (= tg 4) (= tg 5))
                     (let [s2 (sexp-own-str-into a (sx-sval (load x)))]
                       (mk-sexp-src (cond (= tg 2) (KSym s2)
                                          (= tg 3) (KKw s2)
                                          (= tg 4) (KStr s2)
                                          :else (KCStr s2))
                                    x))
                     (load x)))
             Sexp)]
    ; mk-sexp-src preserves source and hygiene metadata by value. The hygiene
    ; module is itself a string, and may belong to the compiler unit being
    ; released after this Code value is staged.
    (set! (.hmod owned)
          (.hmod x))
    owned))

(defn ct-own-sexp [(x (ptr Sexp))] (-> Sexp)
  (sexp-own-into (unit-allocator) x))

(defn diag-errs [] (-> i64)
  (let [b (warn-box)]
    (unless (= (.init b) 0)
      (.errs b))))

(defn diag-err-bump [] (-> i64)
  (let [_ (warn-list)
        b (warn-box)]
    (set! (.errs b) (primitive/iadd (.errs b) 1))
    0))

; ── source table for `(primitive/code-file NODE)` — lets a checker tell WHICH file a node is
; from (a real path = user code; "<bundled …>"/"<prelude>" = stdlib) so a linter can
; scope itself. Set once before checkers run.
; `own` holds the table BY VALUE and `lst` points at it. The caller's `ArrayList`
; header lives in an `LS` on the pipeline's stack — and the pipeline runs on its own
; pthread, so that stack is gone the moment it returns. Keeping the caller's pointer
; therefore left a dangling read for anything that consults the table AFTER a run,
; which is exactly what `coil lint --fix` does when it goes to write the files back.
; The lint target compiler uses a per-round arena, so this boundary must own the
; elements and their payloads as well as the header. Suggestions are rendered after
; that target compiler returns; borrowing its source table kept every multi-gigabyte
; target arena alive across the whole fixpoint loop.
(defstruct SrcBox [(lst (ptr (ArrayList Source))) (own (ArrayList Source))])

(defn src-box [] (-> (ptr SrcBox))
  (field (comptime-unit-state) sources))

(defn set-cli-sources [(ss (ptr (ArrayList Source)))] (-> i64)
  (let [b (src-box)
        a (unit-allocator)
        n (len (load ss))
        (mut own) (ArrayList::new [Source] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [old (elem ss (load i))
                    (mut fresh) (zeroed Source)
                    starts (load (field old line_starts))
                    ns (len starts)
                    (mut copied-starts) (ArrayList::new [i64] a)]
                (for [j 0 ns]
                  (push! (mut copied-starts) (get starts j)))
                (set! (.name fresh) (ct-own-str (.name old)))
                (set! (.text fresh) (ct-own-str (.text old)))
                (set! (.line_starts fresh)
                      (box-al a (load copied-starts)))
                (push! (mut own) fresh)
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.own b) (load own))
    (set! (.lst b) (field b own))
    0))

(defn code-file-of [(node Sexp)] (-> (slice u8))
  (let [b (src-box)
        lst (load (field b lst))]
    (if (= (primitive/cast i64 lst) 0)
        ""
        (let [sid (sx-source node)]
          (if (or (< sid 0) (>= sid (len (load lst))))
              ""
              (let [(mut sp) (: (get (load lst) sid) Source)] (.name sp)))))))

; `(primitive/code-from-user? NODE)` — is this node from a real file the user wrote, rather than
; the bundled stdlib/prelude? Those are registered under a `<…>` pseudo-name, so the
; test is "has a name that doesn't start with `<`". One definition: op 34 answers with
; it, and the autofix filter refuses to edit anything it says false to.
(defn code-from-user-node? [(node Sexp)] (-> bool)
  (let [nm (code-file-of node)]
    (and (> (len nm) 0)
         (!= (primitive/cast i64 (get nm 0)) 60))))

; `(primitive/code-line NODE)` — the 1-based source LINE of a node's span, so a macro (e.g.
; src/stdlib/assert.coil) can bake `file:line` into the code it emits, matching the span
; machinery diag.coil's `locate-source` uses. Same source table as `code-file-of` (set once
; before expansion/checkers run); 0 when the node has no known source.
(defn code-line-of [(node Sexp)] (-> i64)
  (let [b (src-box)
        lst (load (field b lst))]
    (unless (= (primitive/cast i64 lst) 0)
      (let [sid (sx-source node)]
        (unless (or (< sid 0) (>= sid (len (load lst))))
          (let [(mut sp) (: (get (load lst) sid) Source)]
            (.line (diag/locate-source (mut sp) (sx-lo node)))))))))

; `(primitive/code-col NODE)` — the 1-based source COLUMN of a node's span (chars since the last
; newline before `lo`). Mirrors code-line; together they give `file:line:col` for a node.
(defn code-col-of [(node Sexp)] (-> i64)
  (let [b (src-box)
        lst (load (field b lst))]
    (unless (= (primitive/cast i64 lst) 0)
      (let [sid (sx-source node)]
        (unless (or (< sid 0) (>= sid (len (load lst))))
          (let [(mut sp) (: (get (load lst) sid) Source)]
            (.col (diag/locate-source (mut sp) (sx-lo node)))))))))

; `(primitive/code-src NODE)` — the raw SOURCE TEXT of a node's span (lo..hi), so a macro can
; show the user exactly what they wrote.
; Empty when the node has no known source or a dummy span.
(defn code-src-of [(node Sexp)] (-> (slice u8))
  (let [b (src-box)
        lst (load (field b lst))]
    (if (= (primitive/cast i64 lst) 0)
        ""
        (let [sid (sx-source node)
              lo (sx-lo node)
              hi (sx-hi node)]
          (if (or (< sid 0) (>= sid (len (load lst))))
              ""
              (let [(mut sp) (: (get (load lst) sid) Source)]
                (let [txt (.text sp)
                      n (len txt)]
                  (if (or (< lo 0) (> hi n) (> lo hi))
                      ""
                      (subslice [u8] txt lo hi)))))))))

; ---- doc comments (`;;;`) -----------------------------------------------------
; A DOC COMMENT is a run of lines whose first non-blank characters are `;;;`,
; immediately above a form. `;` and `;;` stay ordinary comments, so documenting
; something is opt-in and an incidental note never becomes API docs.
; The reader discards all comments, so the doc is recovered from the SOURCE TEXT by
; scanning backwards from the node's `lo` — no new AST field, one definition of a
; doc (the source itself), and nothing to keep in sync.

; Offset of the first byte of the line containing `off` (0 if on line 1).
(defn ct-line-start [(src (slice u8)) (off i64)] (-> i64)
  (let [(mut k) off]
    (loop (if (or (<= (load k) 0)
                  (= (primitive/cast i64 (get src (primitive/isub (load k) 1)))
                     10))
              (break)
              (set! k (primitive/isub (load k) 1))))
    (load k)))

; If the line starting at `ls` is a `;;;` doc line, return the offset just past its
; `;;;` (and one optional following space); otherwise -1. A line of only whitespace,
; or one holding code, is not a doc line.
(defn ct-doc-line-body [(src (slice u8)) (ls i64)] (-> i64)
  (let [n (len src)
        (mut k) ls]
    (loop (if (>= (load k) n)
              (break)
              (let [c (primitive/cast i64 (get src (load k)))]
                (if (or (= c 32)
                        (= c 9))
                    (set! k (primitive/iadd (load k) 1))
                    (break)))))
    (if (or (>= (primitive/iadd (load k) 2) n)
            (not (and (= (primitive/cast i64 (get src (load k)))
                         59)
                      (and (= (primitive/cast i64
                                              (get src
                                                   (primitive/iadd (load k) 1)))
                              59)
                           (= (primitive/cast i64
                                              (get src
                                                   (primitive/iadd (load k) 2)))
                              59)))))
        -1
        (let [(mut b) (primitive/iadd (load k) 3)]
          ; a fourth `;` is still a doc line (`;;;;` banners); skip the run
          (loop (if (>= (load b) n)
                    (break)
                    (if (= (primitive/cast i64 (get src (load b)))
                           59)
                        (set! b (primitive/iadd (load b) 1))
                        (break))))
          (if (and (< (load b) n)
                   (= (primitive/cast i64 (get src (load b)))
                      32))
              (primitive/iadd (load b) 1)
              (load b))))))

; End offset (exclusive) of the line starting at `ls`, not counting its newline.
(defn ct-line-end [(src (slice u8)) (ls i64)] (-> i64)
  (let [n (len src)
        (mut k) ls]
    (loop (if (or (>= (load k) n)
                  (= (primitive/cast i64 (get src (load k)))
                     10))
              (break)
              (set! k (primitive/iadd (load k) 1))))
    (load k)))

; The doc comment attached to `off`: the contiguous `;;;` block ending on the line
; directly above it, joined with newlines. "" when there is none.
(defn ct-doc-at [(a (dyn Allocator)) (src (slice u8)) (off i64)] (-> (slice u8))
  (let [n (len src)]
    (if (or (< off 0) (> off n))
        ""
        (let [(mut ls) (ct-line-start src off)
              (mut lines) (ArrayList::new [(slice u8)] a)]
          ; walk upwards while the previous line is a doc line
          (loop (if (<= (load ls) 0)
                    (break)
                    (let [pls (ct-line-start src (primitive/isub (load ls) 1))
                          body (ct-doc-line-body src pls)]
                      (if (< body 0)
                          (break)
                          (do
                            (push! (mut lines)
                                   (subslice [u8]
                                             src
                                             body
                                             (ct-line-end src pls)))
                            (set! ls pls))))))
          (let [cnt (len lines)]
            (if (= cnt 0)
                ""
                ; collected bottom-up; emit top-down
                (let [(mut out) (StrBuf::new a)
                      (mut i) cnt]
                  (loop (if (<= (load i) 0)
                            (break)
                            (do
                              (set! i (primitive/isub (load i) 1))
                              (push-str! (mut out) (get lines (load i)))
                              (when (> (load i) 0)
                                (push! (mut out) (: 10 u8))))))
                  (str (load out)))))))))

; `(primitive/code-doc NODE)` — the `;;;` doc comment written above NODE, or "" if it has none
; (including any macro-generated node, which has no source of its own).
(defn code-doc-of [(node Sexp)] (-> (slice u8))
  (let [b (src-box)
        lst (load (field b lst))]
    (if (= (primitive/cast i64 lst) 0)
        ""
        (let [sid (sx-source node)]
          (if (or (< sid 0) (>= sid (len (load lst))))
              ""
              (let [(mut sp) (: (get (load lst) sid) Source)]
                (ct-doc-at (unit-allocator) (.text sp) (sx-lo node))))))))

; ── autofix: `(primitive/suggest NODE MSG REPLACEMENT)` ─────────────────────────────────
; A checker only ever RECORDS a proposed rewrite; nothing here opens a file, and
; every build that is not `coil lint --fix` drops this table on the floor. That
; keeps `coil build` pure by construction rather than by convention. The suggestion
; also emits an ordinary `(primitive/warn …)`, so the `help: try:` line shows up whether or
; not anyone ever runs `--fix`. See docs/archive/AUTOFIX.md.
;
; `diag` is the index of that warning in `warn-list`, which is how the printer
; pairs a suggestion with the diagnostic it belongs under.
;
; `del` distinguishes the two shapes a proposed fix can have. 0 = REPLACE: splice
; `repl` over [lo,hi). 1 = DELETE: the node goes away entirely and `repl` is unused.
; Deletion is not expressible as a replacement, because there is no `Code` value that
; renders as nothing — and because a delete legitimately takes source the node's own
; span does not cover (the comment block written above it), which a replacement never
; may. So the two stay distinct all the way to `lint-edits`.
; `locals` is the hygiene half: the spellings of identifiers this replacement
; transported out of the author's program that the type-checker resolved to a
; LOCAL binding. It is captured at RECORD time because owning the replacement
; renumbers node ids, and the binding map is keyed by them. See the renderer's
; identifier-hygiene note for what it is used for.
(defstruct Suggestion
  [(source i64)
   (lo i64)
   (hi i64)
   (col i64)
   (repl Sexp)
   (rendered (slice u8))
   (help (slice u8))
   ; The rendering that also carries its checker's rewrites of the nodes inside
   ; it, and the suggestions those were ("" and null when it carries none). See
   ; SugBatch.
   (composed (slice u8))
   (absorbs (ptr (ArrayList i64)))
   (msg (slice u8))
   (diag i64)
   (del i64)
   (locals (ptr (ArrayList (slice u8))))
   ; The checker invocation (or compiler repair) that suggested this edit. Edits
   ; of one group are applied together or not at all. 0 = ungrouped.
   (group i64)])

(defstruct SugBox [(init i64) (lst (ptr (ArrayList Suggestion)))])

(defn sug-box [] (-> (ptr SugBox))
  (field (comptime-unit-state) suggestions))

(defn sug-list [] (-> (ptr (ArrayList Suggestion)))
  (let [b (sug-box)]
    (when (= (.init b) 0)
      (store! (field b lst)
              (box! (unit-allocator)
                    (ArrayList Suggestion)
                    (zeroed (ArrayList Suggestion))))
      (set! (load (field b lst)) (ArrayList::new [Suggestion] (unit-allocator)))
      (set! (.init b) 1)
      0)
    (load (field b lst))))

(defn sug-push [(s Suggestion)] (-> i64)
  (push! (sug-list) s)
  0)

(defn sug-count [] (-> i64)
  (len (load (sug-list))))

(defn sug-at [(i i64)] (-> Suggestion)
  (get (load (sug-list)) i))

; `coil lint --fix` re-analyses the program after every round; both collectors are
; per-round state, so a round starts from empty rather than re-reporting the last one.
(defn sug-reset [] (-> i64)
  (set! (sug-repair-cell) 0)
  (let [b (sug-box)]
    (unless (= (.init b) 0)
      (clear! (mut (load (field b lst))))
      0)))

;;; Repairs are suggestions a compiler ERROR attaches: a migration that makes a
;;; program compile again (a user extern brought back in line with the library's
;;; C signature). `lint --fix` applies them even when the analysis failed.

;;; Open a new suggestion group; later suggestions join it until the next one. A
;;; group is one transaction: `lint --fix` applies all of it or none of it. Every
;;; checker run opens one, so by default a checker's suggestions land together;
;;; `(primitive/suggest-transaction)` lets a checker open more, and a checker whose
;;; suggestions are independent opens one per suggestion, so that a fix which does
;;; not compile is dropped alone.
(defn sug-group-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn sug-begin-group! [] (-> i64)
  (set! (sug-group-cell) (+ (load (sug-group-cell)) 1))
  (load (sug-group-cell)))

(defn sug-current-group [] (-> i64)
  (load (sug-group-cell)))

(defn sug-repair-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn sug-push-repair! [(s Suggestion)] (-> void)
  (sug-push s)
  (set! (sug-repair-cell) (+ (load (sug-repair-cell)) 1)))

(defn sug-repairs [] (-> i64)
  (load (sug-repair-cell)))

; `coil lint --fix` re-analyses the program once per round; printing every round's
; diagnostics would repeat the same list N times and bury the one that matters. The
; rounds run quiet and the final pass reports.
(defstruct DiagQuietCell [(on i64)])

(defn diag-quiet-cell [] (-> (ptr DiagQuietCell))
  (field (comptime-unit-state) diagnostic_quiet))

(defn set-diag-quiet [(on bool)] (-> i64)
  (set! (.on (diag-quiet-cell)) (if on (do 1) 0))
  0)

(defn diag-quiet? [] (-> bool)
  (!= (.on (diag-quiet-cell)) 0))

(defn diag-reset [] (-> i64)
  (let [b (warn-box)]
    (unless (= (.init b) 0)
      (clear! (mut (load (field b lst))))
      (set! (.errs b) 0)
      (set! (.drained b) 0)
      0)))

; The text of the source file a node came from, or "" — the raw material both the
; column lookup and the verbatim printer below work over.
(defn sug-file-text [(source i64)] (-> (slice u8))
  (let [b (src-box)
        lst (load (field b lst))]
    (if (or (= (primitive/cast i64 lst) 0)
            (< source 0)
            (>= source (len (load lst))))
        ""
        (let [(mut sp) (: (get (load lst) source) Source)] (.text sp)))))

; The path of the source file a node came from, or "" — what `coil lint --fix`
; writes back to.
(defn sug-file-name [(source i64)] (-> (slice u8))
  (let [b (src-box)
        lst (load (field b lst))]
    (if (or (= (primitive/cast i64 lst) 0)
            (< source 0)
            (>= source (len (load lst))))
        ""
        (let [(mut sp) (: (get (load lst) source) Source)] (.name sp)))))

; 0-based column of byte `off` in `txt` — how far it sits past the last newline.
(defn sug-col-at [(txt (slice u8)) (off i64)] (-> i64)
  (let [n (len txt)
        (mut i) (if (> off n) n off)
        (mut c) 0]
    (loop (if (or (<= (load i) 0)
                  (= (primitive/cast i64 (get txt (primitive/isub (load i) 1)))
                     10))
              (break)
              (do
                (set! c (primitive/iadd (load c) 1))
                (set! i (primitive/isub (load i) 1)))))
    (load c)))

; ---- identifier hygiene in a rendered replacement ---------------------------
; A replacement is written back as SOURCE TEXT, and source text carries no
; lexical scope. Inside the `Code` value an identifier the rule introduced (a
; template literal, or a `fresh-identifier`) and one transported out of the
; author's own program are distinct syntax objects even when they print the
; same; flattening both to one spelling is exactly the capture the hygiene model
; exists to stop. A rule that wraps the author's `tmp` in its own `(let [tmp …])`
; would otherwise rebind it silently, and the rewritten file still compiles.
;
; So the renderer disambiguates first. Whether a collision can actually capture
; anything is answered by the type-checker's binding map, not by guessing at
; binder shapes: only a transported identifier the checker resolved to a LOCAL is
; capturable, so only a spelling shared with one of those is renamed. Heads,
; globals and qualified names collide harmlessly and keep their spelling, which
; is what leaves `cond`/`if`-shaped rewrites byte-identical.
;
; The author's syntax always keeps its text; each rule-introduced identity, keyed
; by its scope, becomes `name__N` numbered in first-appearance order — so a
; rendering is deterministic, and two rule identities never merge into one name.
; Identities the rule deliberately stripped of context (`code-symbol` data,
; `datum->syntax` use-site capture, `syntax->datum`) are asking for the bare
; spelling and are left alone.
(defstruct SugRen [(spelling (slice u8)) (hyg i64) (name (slice u8))])

(defstruct SugRenBox [(init i64) (lst (ptr (ArrayList SugRen)))])

(defn sug-ren-box [] (-> (ptr SugRenBox))
  (field (comptime-unit-state) suggestion_renames))

(defn sug-ren-list [] (-> (ptr (ArrayList SugRen)))
  (let [b (sug-ren-box)]
    (when (= (.init b) 0)
      (store! (field b lst)
              (box! (unit-allocator)
                    (ArrayList SugRen)
                    (zeroed (ArrayList SugRen))))
      (set! (load (field b lst)) (ArrayList::new [SugRen] (unit-allocator)))
      (set! (.init b) 1)
      0)
    (load (field b lst))))

(defn sug-ren-clear [] (-> i64)
  (let [lst (sug-ren-list)]
    (clear! (mut lst))
    0))

; origin 1 = template/definition-site syntax, 2 = a generated fresh identifier:
; the two a rule mints itself. 0 is the author's own syntax and 3/4/5 are the
; explicit context operations, which all mean "this exact spelling".
(defn sug-introduced? [(x Sexp)] (-> bool)
  (and (= (sx-tag x) 2)
       (or (= (sx-horigin x) 1)
           (= (sx-horigin x) 2))))

; A transported reference the type-checker bound to a local — the only thing a
; flattened rule identifier can capture.
(defn sug-capturable? [(x Sexp)] (-> bool)
  (and (= (sx-tag x) 2)
       (and (= (sx-horigin x) 0)
            (!= (bind-map-lookup (sx-node-id x)) 0))))

(defn sug-str-member? [(lst (ptr (ArrayList (slice u8)))) (s (slice u8))]
  (-> bool)
  (let [n (len (load lst))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (if (= (get (load lst) (load i)) s)
                  (do (set! r true) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn sug-str-add! [(lst (ptr (ArrayList (slice u8)))) (s (slice u8))] (-> i64)
  (unless (sug-str-member? lst s) (push! lst s) 0))

; The capturable spellings in a replacement, collected while its nodes still
; carry the ids the binding map is keyed by (i.e. before `ct-own-sexp`).
(defn sug-scan-locals! [(locals (ptr (ArrayList (slice u8)))) (x Sexp)] (-> i64)
  (let [tg (sx-tag x)]
    (when (and (= tg 2) (sug-capturable? x))
      (sug-str-add! locals (sx-sval x))
      0)
    (when (or (= tg 6) (= tg 7))
      (let [items (sx-items x)
            n (sx-len items)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (sug-scan-locals! locals (sx-at items (load i)))
                    (set! i (primitive/iadd (load i) 1))))))
      0)
    0))

; Every symbol spelling the replacement already uses, so a minted name cannot
; land on one of them.
(defn sug-scan-seen! [(seen (ptr (ArrayList (slice u8)))) (x Sexp)] (-> i64)
  (let [tg (sx-tag x)]
    (when (= tg 2) (sug-str-add! seen (sx-sval x)) 0)
    (when (or (= tg 6) (= tg 7))
      (let [items (sx-items x)
            n (sx-len items)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (sug-scan-seen! seen (sx-at items (load i)))
                    (set! i (primitive/iadd (load i) 1))))))
      0)
    0))

; The record-time half: own the capturable spellings alongside the replacement.
(defn sug-locals-of [(repl (ptr Sexp))] (-> (ptr (ArrayList (slice u8))))
  (let [ma (unit-allocator)
        locals (new-boxed-list [(slice u8)] ma)]
    (sug-scan-locals! locals (load repl))
    locals))

(defn sug-ren-find [(spelling (slice u8)) (hyg i64)] (-> (slice u8))
  (let [lst (sug-ren-list)
        n (len (load lst))
        (mut r) ""]
    (for [i 0 n]
      (let [e (elem lst i)]
        (when (and (= (.spelling e) spelling)
                   (= (.hyg e) hyg))
          (set! r (.name e))
          (break))))
    (load r)))

; `spelling__1`, `__2`, … skipping anything the replacement already spells, so a
; disambiguated name cannot collide with the text around it either.
(defn sug-ren-mint [(a (dyn Allocator))
                    (seen (ptr (ArrayList (slice u8))))
                    (spelling (slice u8))] (-> (slice u8))
  (let [(mut k) 1
        (mut out) ""]
    (loop (let [cand (text/format a "{}__{}" spelling (dec->str a (load k)))]
            (if (sug-str-member? seen cand)
                (set! k (primitive/iadd (load k) 1))
                (do (set! out cand) (break)))))
    (sug-str-add! seen (load out))
    (load out)))

(defn sug-ren-assign! [(a (dyn Allocator))
                       (locals (ptr (ArrayList (slice u8))))
                       (seen (ptr (ArrayList (slice u8))))
                       (x Sexp)] (-> i64)
  (let [tg (sx-tag x)]
    (when (and (sug-introduced? x)
               (and (sug-str-member? locals (sx-sval x))
                    (= (sug-ren-find (sx-sval x) (sx-hyg x)) "")))
      (let [(mut e) (zeroed SugRen)]
        (set! (.spelling e) (sx-sval x))
        (set! (.hyg e) (sx-hyg x))
        (set! (.name e) (sug-ren-mint a seen (sx-sval x)))
        (push! (sug-ren-list) e)
        0))
    (when (or (= tg 6) (= tg 7))
      (let [items (sx-items x)
            n (sx-len items)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (sug-ren-assign! a locals seen (sx-at items (load i)))
                    (set! i (primitive/iadd (load i) 1))))))
      0)
    0))

(defn sug-ren-build! [(a (dyn Allocator))
                      (repl Sexp)
                      (locals (ptr (ArrayList (slice u8))))] (-> i64)
  (sug-ren-clear)
  (unless (or (= (primitive/cast i64 locals) 0)
              (= (len (load locals)) 0))
    (let [seen (new-boxed-list [(slice u8)] a)]
      (sug-scan-seen! seen repl)
      (sug-ren-assign! a locals seen repl))
    0))

; The spelling `x` must render as, or "" when its own spelling stands.
(defn sug-ren-of [(x Sexp)] (-> (slice u8))
  (if (not (sug-introduced? x))
      ""
      (sug-ren-find (sx-sval x) (sx-hyg x))))

;;; ---- composing one checker's nested rewrites ------------------------------
;;; A checker often suggests a rewrite of a form AND of a form inside it:
;;; `(primitive/ior a (primitive/ior b c))` is one suggestion per `ior`. The two
;;; edits overlap, so only the outer one could be applied and the inner one waited
;;; for the next `lint --fix` round — one more whole-program analysis per level of
;;; nesting. While one checker's suggestions are rendered together (the batch
;;; `sug-freeze-from!` freezes), each also gets a COMPOSED rendering, in which a
;;; node its replacement reuses verbatim is rendered as the batch's own rewrite of
;;; that node, so the outer edit carries the whole nested rewrite. It records the
;;; suggestions it absorbed: `lint --fix` writes the composed text only when no other
;;; suggestion touches one of them (`lint-sug-text`), since another checker's
;;; rewrite of the same node would otherwise lose its turn. The plain rendering
;;; stays what `help: try:` shows.
;;;
;;; Only a rewrite that stands alone is composed: the sole suggestion for that node,
;;; the only edit of its group (a group is applied whole or not at all), with no
;;; comment inside the node, and with no identifier renamed on either side — the
;;; table that disambiguates a rule's identifiers from the locals is built per
;;; replacement (sug-ren-build!).
;;;  - `index`: (source, lo) of each batch suggestion -> its index; -2 when two share
;;;    it.
;;;  - `groups`: how many batch suggestions each group has.
;;;  - `on`: whether the rendering in progress is the composed one.
;;;  - `open`: the suggestions being rendered, outermost first.
;;;  - `absorbed`: every batch suggestion the composed rendering in progress used.
;;;  - `plain`: whether the outermost one renames nothing.
(defstruct SugBatch
  [(on bool)
   (index (HashMap i64 i64))
   (groups (HashMap i64 i64))
   (open (ArrayList i64))
   (absorbed (ArrayList i64))
   (plain bool)])

(defn sug-batch-cell [] (-> (ptr SugBatch))
  (primitive/alloc-static SugBatch))

(defn sug-batch-key [(source i64) (lo i64)] (-> i64)
  (+ (* source 4294967296) lo))

;;; Would rendering X alone rename one of its identifiers? Only an identifier the
;;; rule introduced whose spelling is one of the LOCALS it could capture is renamed.
(defn sug-renames? [(x Sexp) (locals (ptr (ArrayList (slice u8))))] (-> bool)
  (let [tg (sx-tag x)]
    (cond (and (sug-introduced? x) (sug-str-member? locals (sx-sval x))) true
          (or (= tg 6) (= tg 7))
            (block :found
              (let [items (sx-items x)]
                (for [i 0 (sx-len items)]
                  (when (sug-renames? (sx-at items i) locals)
                    (break :found true))))
              false)
          :else false)))

(defn sug-plain? [(sp (ptr Suggestion))] (-> bool)
  (or (= (primitive/cast i64 (.locals sp)) 0)
      (not (sug-renames? (.repl sp) (.locals sp)))))

(defn sug-batch-begin! [(a (dyn Allocator)) (start i64) (end i64)] (-> i64)
  (let [b (sug-batch-cell)
        lst (sug-list)]
    (set! (.index b) (HashMap::new-scalar [i64 i64] a))
    (set! (.groups b) (HashMap::new-scalar [i64 i64] a))
    (set! (.open b) (ArrayList::new [i64] a))
    (set! (.absorbed b) (ArrayList::new [i64] a))
    (for [i start end]
      (let [sp (elem lst i)
            key (sug-batch-key (.source sp) (.lo sp))]
        (set! (mut (.index b))
              key
              (match (get (.index b) key) (Some [_] -2) (None [] i)))
        (set! (mut (.groups b))
              (.group sp)
              (+ (match (get (.groups b) (.group sp)) (Some [k] k) (None [] 0))
                 1))))
    0))

(defn sug-batch-end! [] (-> i64)
  (set! (.on (sug-batch-cell)) false)
  0)

;;; The batch suggestion whose rewrite replaces X wherever a replacement reuses it
;;; verbatim, or -1.
(defn sug-batch-subst [(x Sexp)] (-> i64)
  (let [b (sug-batch-cell)]
    (if (or (not (.on b)) (not (.plain b)))
        -1
        (match (get (.index b) (sug-batch-key (sx-source x) (sx-lo x)))
          (None [] -1)
          (Some [j]
                (if (< j 0)
                    -1
                    (let [sp (elem (sug-list) j)]
                      (if (and (= (.hi sp) (sx-hi x))
                               (= (.del sp) 0)
                               (sug-plain? sp)
                               (or (= (.group sp) 0)
                                   (match (get (.groups b) (.group sp))
                                     (Some [k] (= k 1))
                                     (None [] false)))
                               (not (block :open
                                      (for k (.open b)
                                        (when (= k j) (break :open true)))
                                      false))
                               (= (sug-comment-marks (sug-verbatim x)) 0))
                          j
                          -1))))))))

(defn sug-batch-push! [(j i64)] (-> i64)
  (push! (mut (.open (sug-batch-cell))) j)
  0)

;;; The composed rendering in progress uses suggestion J.
(defn sug-batch-absorb! [(j i64)] (-> i64)
  (let [b (sug-batch-cell)]
    (unless (block :seen
              (for k (.absorbed b) (when (= k j) (break :seen true)))
              false)
      (push! (mut (.absorbed b)) j)
      0)
    0))

(defn sug-batch-pop! [] (-> i64)
  (let [b (sug-batch-cell)]
    (pop! (mut (.open b)))
    0))

; ---- rendering a replacement back to source text ----------------------------
; THE rule that makes a fix surgical: a node that CAME FROM THE AUTHOR'S SOURCE is
; emitted as its ORIGINAL bytes, and only a freshly-built/rule-owned node is pretty-
; printed. So a fix that reuses the author's subexpressions preserves them byte-for-
; byte — comments, string escapes, line breaks and all — and only what actually
; changed is new text. `ctxt == 0` alone is insufficient: checker templates are
; authored syntax too, but their spans belong to the rule, not the file being fixed.
; Quasiquote marks unquoted/spliced input with hflags bit 0, which is the durable
; provenance that distinguishes transported author syntax from a template node even
; when the metaprogram engine's source IDs are local and collide numerically.
;
; This is a different job from `sx-emit` (expander.coil), which reprints the whole
; expanded program for `coil expand`: that one is a debugging view with no source to
; be faithful to, this one edits a file the author has to keep reading.
(defn sug-verbatim [(node Sexp)] (-> (slice u8))
  (if (or (!= (sx-ctxt node) 0)
          (= (& (sx-hflags node) 1) 0)
          (not (code-from-user-node? node))
          (rule-src? (sx-source node)))
      ""
      (code-src-of node)))

(defn sug-has-nl [(s (slice u8))] (-> bool)
  (let [n (len s)
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (if (= (primitive/cast i64 (get s (load i)))
                     10)
                  (do (set! r true) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; `coil fmt`'s line budget, and therefore the largest useful indentation for a
; replacement. Source columns are not layout widths: generated and minified input
; can put a form hundreds of thousands of bytes into one physical line. Letting that
; column become a continuation indent makes a tiny lint fix manufacture enormous
; padding strings. The first line is still spliced at its exact source offset; only
; lines introduced by the renderer use this bounded layout column.
(defn sug-width-budget [] (-> i64)
  120)

(defn sug-layout-col [(col i64)] (-> i64)
  (if (> col (sug-width-budget)) (sug-width-budget) col))

; Width of `x` rendered on one line. Verbatim text that already spans lines can
; never be flattened, so it reports a width nothing fits in — the same trick
; src/compiler/formatter/doc.coil's `doc-inf` uses to force every enclosing form to break.
(defn sug-width [(a (dyn Allocator)) (x Sexp)] (-> i64)
  (let [rn (sug-ren-of x)
        v (if (> (len rn) 0) "" (sug-verbatim x))]
    (if (> (len v) 0)
        (let [subst (sug-batch-subst x)]
          (cond (>= subst 0)
                  (do
                    (sug-batch-push! subst)
                    (let [w (sug-width a (.repl (elem (sug-list) subst)))]
                      (sug-batch-pop!)
                      w))
                (sug-has-nl v) 1000000000
                ; a comment carried in front of it ends its line
                (sug-gap-commented? x) 1000000000
                :else (len v)))
        (let [tg (sx-tag x)]
          (cond (= tg 0) (len (i64->str a (sx-ival x)))
                (= tg 2)
                  (if (> (len rn) 0)
                      (len rn)
                      (len (sx-sval x)))
                (= tg 3) (primitive/iadd 1 (len (sx-sval x)))
                (= tg 4) (primitive/iadd 2 (len (sx-sval x)))
                (= tg 5) (primitive/iadd 3 (len (sx-sval x)))
                (or (= tg 6) (= tg 7))
                  (let [items (sx-items x)
                        n (sx-len items)
                        (mut w) 2]
                    (for [i 0 n]
                      (store! w
                              (primitive/iadd (primitive/iadd (load w)
                                                              (when (> i
                                                                       0)
                                                                1))
                                              (sug-width a
                                                         (sx-at items
                                                                i)))))
                    (load w))
                3)))))

(defn sug-spaces! [(buf (mut (ArrayList u8))) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut buf) (: 32 u8))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; Copy verbatim text that was written at column `from` into a form now sitting at
; column `to`. Lisp alignment is column-based, so every line after the first is
; shifted by the difference: a form that moves left (an `if` chain collapsing into
; a `cond`) takes its whole body with it instead of stranding it at the old indent.
; A leftward shift only ever removes SPACES, so it can't eat code.
(defn sug-put-reindent! [(buf (mut (ArrayList u8)))
                         (s (slice u8))
                         (from i64)
                         (to i64)] (-> i64)
  (let [n (len s)
        delta (primitive/isub (sug-layout-col to) from)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (get s (load i)))]
                (push! (mut buf) (primitive/cast u8 c))
                (set! i (primitive/iadd (load i) 1))
                (when (= c 10)
                  (if (> delta 0)
                      (sug-spaces! (mut buf) delta)
                      (let [drop (primitive/isub 0 delta)
                            (mut k) 0]
                        (loop (if (>= (load k) drop)
                                  (break)
                                  (if (and (< (load i) n)
                                           (= (primitive/cast i64
                                                              (get s (load i)))
                                              32))
                                      (do
                                        (set! i (primitive/iadd (load i) 1))
                                        (set! k (primitive/iadd (load k) 1)))
                                      (break))))
                        0))))))
    0))

(defn sug-atom! [(a (dyn Allocator)) (buf (mut (ArrayList u8))) (x Sexp)]
  (-> i64)
  (let [tg (sx-tag x)]
    (cond (= tg 0) (append-bytes! (mut buf) (i64->str a (sx-ival x)))
          ; the shortest decimal that reads back as the same f64
          (= tg 1) (append-bytes! (mut buf) (f64-debug a (sx-ival x)))
          (= tg 2)
            (let [rn (sug-ren-of x)]
              (append-bytes! (mut buf)
                             (if (> (len rn) 0)
                                 rn
                                 (sx-sval x))))
          (= tg 3)
            (do
              (push! (mut buf) (: 58 u8))
              (append-bytes! (mut buf) (sx-sval x)))
          (= tg 4)
            (do
              (push! (mut buf) (: 34 u8))
              (append-bytes! (mut buf) (sx-sval x))
              (push! (mut buf) (: 34 u8)))
          (= tg 5)
            (do
              (push! (mut buf) (: 99 u8))
              (push! (mut buf) (: 34 u8))
              (append-bytes! (mut buf) (sx-sval x))
              (push! (mut buf) (: 34 u8)))
          (append-bytes! (mut buf) "<?>"))
    0))

; The head symbol of a list, or "" — the one thing layout dispatches on.
; The bytes the head will actually RENDER as. Emission prefers a node's verbatim
; source spelling, and macro hygiene may have rewritten the sval to a qualified
; name (`coil.core.cond`) while the span still points at the template's own
; `cond` — so layout and clause pairing must measure the verbatim bytes, or the
; continuation indent drifts by exactly the qualifier's length and the result is
; no longer fmt-clean.
(defn sug-head-display [(x Sexp)] (-> (slice u8))
  (let [items (sx-items x)]
    (if (= (sx-len items) 0)
        ""
        (let [h (sx-at items 0)
              rn (sug-ren-of h)
              v (if (> (len rn) 0) "" (sug-verbatim h))]
          (if (> (len rn) 0)
              rn
              (if (> (len v) 0)
                  v
                  (if (= (sx-tag h) 2) (sx-sval h) "")))))))

; `cond`/`case` lay their tail out as test/body PAIRS, one clause per line, aligned
; past the head — the same shape `coil fmt` gives them (src/compiler/formatter/rules.coil layout-clauses,
; nest = headlen + 2), so a fixed file is already fmt-clean.
(defn sug-clause-style? [(h (slice u8))] (-> bool)
  (or (= h "cond") (= h "case") (= h "case-by")))

(defn sug-newline! [(buf (mut (ArrayList u8))) (col i64)] (-> i64)
  (push! (mut buf) (: 10 u8))
  (sug-spaces! (mut buf) (sug-layout-col col))
  0)

; The column the NEXT byte written to `buf` will land in, given that the buffer's own
; first byte sits at column `start`. Derived from the buffer rather than threaded
; through the recursion: a node's true column depends on everything already written
; before it, and passing an estimate down is how re-indentation silently goes wrong.
(defn sug-cur-col [(buf (ArrayList u8)) (start i64)] (-> i64)
  (let [s (slice buf)
        n (len s)
        (mut i) n]
    (loop (if (or (<= (load i) 0)
                  (= (primitive/cast i64 (get s (primitive/isub (load i) 1)))
                     10))
              (break)
              (set! i (primitive/isub (load i) 1))))
    (if (= (load i) 0)
        (primitive/iadd start n)
        (primitive/isub n (load i)))))

; ---- carrying the author's comments across a rewrite ------------------------
; A replacement is assembled from the author's own nodes, so anything INSIDE a node
; is copied verbatim and survives on its own. What no Code value records is the text
; BETWEEN nodes — and in a Lisp the text between two nodes is the comments. Closing
; an `if` staircase into a `cond` closes exactly those gaps, so left alone the
; rewrite would quietly delete them.
;
; A comment belongs to the node it sits in front of. Before rendering, the renderer
; records which of the author's nodes the replacement keeps (`emitted`). The comments
; that LEAD a kept node X are the ones after the last kept node ending before X:
; between them and X there is only text the rewrite drops — delimiters, a wrapper's
; head — so X is what they were written about, and they are written out in front of
; X wherever the replacement puts it, in whatever order. A comment that leads a node
; the rewrite drops altogether has nowhere to go: it is not moved onto an unrelated
; node, and the comment guard below withholds the fix instead.
(defstruct SugGap
  [(on i64)
   (source i64)
   (lo i64)
   (end i64)
   ; [lo hi) pairs, flattened, of the author's nodes the replacement keeps
   (emitted (ArrayList i64))
   ; source offsets of the comments already written
   (carried (ArrayList i64))])

(defn sug-gap-cell [] (-> (ptr SugGap))
  (field (comptime-unit-state) suggestion_gap))

(defn sug-gap-begin [(a (dyn Allocator))
                     (source i64)
                     (lo i64)
                     (hi i64)
                     (repl Sexp)] (-> i64)
  (let [g (sug-gap-cell)]
    (set! (.on g) 1)
    (set! (.source g) source)
    (set! (.lo g) lo)
    (set! (.end g) hi)
    (set! (.emitted g) (ArrayList::new [i64] a))
    (set! (.carried g) (ArrayList::new [i64] a))
    ; A comment ends its line, so a node carrying one cannot be laid out flat;
    ; sug-width reports such a node as too wide to fit, which breaks exactly the
    ; forms around it and no others.
    (sug-collect-emitted! repl)
    0))

(defn sug-gap-end [] (-> i64)
  (set! (.on (sug-gap-cell)) 0)
  0)

;;; Is `x` one of the author's nodes inside the span being replaced? A replacement
;;; also contains nodes from the RULE's own quasiquote, and when a rule is applied to
;;; the very file it is written in, those share a source id with the target while
;;; sitting somewhere else entirely.
(defn sug-in-span? [(x Sexp)] (-> bool)
  (let [g (sug-gap-cell)]
    (and (!= (.on g) 0)
         (= (sx-source x) (.source g))
         (>= (sx-lo x) (.lo g))
         (<= (sx-hi x) (.end g))
         (< (sx-lo x) (sx-hi x)))))

;;; Record the author's nodes rendering `x` writes, the way sug-emit! decides it: a
;;; node with source text of its own is written whole, a node the rule built is
;;; written through its children, and a renamed identifier is the rule's spelling.
(defn sug-collect-emitted! [(x Sexp)] (-> i64)
  (let [g (sug-gap-cell)
        rn (sug-ren-of x)
        v (if (> (len rn) 0) "" (sug-verbatim x))
        tg (sx-tag x)]
    (cond (> (len rn) 0) 0
          (> (len v) 0)
            (when (sug-in-span? x)
              (push! (mut (.emitted g)) (sx-lo x))
              (push! (mut (.emitted g)) (sx-hi x))
              0)
          (or (= tg 6) (= tg 7))
            (let [items (sx-items x)]
              (for [i 0 (sx-len items)] (sug-collect-emitted! (sx-at items i)))
              0)
          :else 0)))

;;; Where the comments leading the author's node at [lo,hi) begin: just past the last
;;; kept node that ends at or before it, or the start of the span. -1 when the node
;;; lies inside a kept node, whose verbatim text already carries its comments.
(defn sug-lead-start [(lo i64) (hi i64)] (-> i64)
  (let [g (sug-gap-cell)
        es (.emitted g)
        (mut start) (.lo g)]
    (block :lead
      (for [i 0 (/ (len es) 2)]
        (let [elo (get es (* i 2))
              ehi (get es (+ (* i 2) 1))]
          (cond (and (<= ehi lo) (> ehi start)) (set! start ehi)
                (and (<= elo lo) (>= ehi hi) (or (< elo lo) (> ehi hi)))
                  (return-from :lead -1))))
      start)))

;;; The next comment in src[from, to), or -1. The text between kept nodes can hold
;;; dropped nodes too, so a `;` inside a string or a character literal there is not
;;; a comment. `from` is never inside a string: it is the end of a node or the start
;;; of the span.
(defn sug-next-comment [(src (slice u8)) (from i64) (to i64)] (-> i64)
  (let [(mut i) from
        (mut instr) false]
    (block :scan
      (while (< i to)
        (let [c (primitive/cast i64 (get src i))]
          (cond instr
                  (cond (= c 92) (set! i (+ i 2))
                        (= c 34) (do (set! instr false) (set! i (+ i 1)))
                        :else (set! i (+ i 1)))
                (= c 34) (do (set! instr true) (set! i (+ i 1)))
                (= c 92)
                  (set! i (+ i 2))  ; a character literal: \; is not a comment
                (= c 59) (return-from :scan i)
                :else (set! i (+ i 1)))))
      -1)))

(defn sug-carried? [(at i64)] (-> bool)
  (block :seen
    (for c (.carried (sug-gap-cell)) (when (= c at) (return-from :seen true)))
    false))

;;; The comment starting at `at`, to the end of its line, without trailing blanks
;;; (they would dangle once the line is laid out somewhere else).
(defn sug-comment-text [(src (slice u8)) (at i64)] (-> (slice u8))
  (let [n (len src)
        (mut e) at]
    (while (and (< e n) (!= (get src e) (: 10 u8))) (set! e (+ e 1)))
    (while (and (> e at)
                (let [c (get src (- e 1))]
                  (or (= c (: 32 u8))
                      (= c (: 9 u8))
                      (= c (: 13 u8)))))
      (set! e (- e 1)))
    (subslice [u8] src at e)))

;;; Write the comments in src[from, to) not yet written, each on its own line at
;;; column `col`, and mark them written. `lead` says which side the line break goes
;;; on. Mid-form the buffer is already indented and waiting for the node that
;;; follows, so the break comes AFTER each comment (leaving that indent behind for
;;; it). After the form there is nothing to follow, so the break comes BEFORE —
;;; otherwise the edit ends in trailing blanks.
(defn sug-put-comments! [(buf (mut (ArrayList u8)))
                         (src (slice u8))
                         (from i64)
                         (to i64)
                         (col i64)
                         (lead bool)] (-> i64)
  (let [g (sug-gap-cell)
        (mut at) (sug-next-comment src from to)]
    (while (>= at 0)
      (unless (sug-carried? at)
        (push! (mut (.carried g)) at)
        (when lead (sug-newline! (mut buf) col))
        (append-bytes! (mut buf) (sug-comment-text src at))
        (unless lead (sug-newline! (mut buf) col)))
      (let [(mut e) at]
        (while (and (< e to) (!= (get src e) (: 10 u8))) (set! e (+ e 1)))
        (set! at (sug-next-comment src e to))))
    0))

;;; Does the author's node `x` have comments leading it that are not written yet?
(defn sug-gap-commented? [(x Sexp)] (-> bool)
  (and (sug-in-span? x)
       (let [g (sug-gap-cell)
             src (sug-file-text (.source g))
             from (sug-lead-start (sx-lo x) (sx-hi x))]
         (and (>= from 0)
              (block :found
                (let [(mut at) (sug-next-comment src from (sx-lo x))]
                  (while (>= at 0)
                    (unless (sug-carried? at) (return-from :found true))
                    (let [(mut e) at]
                      (while (and (< e (sx-lo x)) (!= (get src e) (: 10 u8)))
                        (set! e (+ e 1)))
                      (set! at (sug-next-comment src e (sx-lo x))))))
                false)))))

; Carry the comments leading `x`, leaving the buffer indented at `col` for `x` itself.
(defn sug-carry-at! [(buf (mut (ArrayList u8))) (x Sexp) (col i64)] (-> i64)
  (when (sug-in-span? x)
    (let [g (sug-gap-cell)
          from (sug-lead-start (sx-lo x) (sx-hi x))]
      (when (>= from 0)
        (sug-put-comments! (mut buf)
                           (sug-file-text (.source g))
                           from
                           (sx-lo x)
                           col
                           false))))
  0)

; Comments inside the replaced span after the last node the replacement kept would
; otherwise go out with the closing parens. They are written after the rendered form,
; on their own line — the one place left that is still inside the edit.
(defn sug-carry-tail! [(buf (mut (ArrayList u8))) (hi i64) (col i64)] (-> i64)
  (let [g (sug-gap-cell)]
    (unless (= (.on g) 0)
      (let [src (sug-file-text (.source g))
            from (sug-lead-start hi hi)]
        (unless (or (< from 0) (> hi (len src)))
          (sug-put-comments! (mut buf) src from hi col true))))
    0))

; Render `x` into `buf` as source text. `start` is the column `buf`'s first byte
; occupies, which is all the renderer needs to know about the text around it.
(defn sug-emit! [(a (dyn Allocator))
                 (buf (mut (ArrayList u8)))
                 (x Sexp)
                 (start i64)] (-> i64)
  ; A disambiguated identifier has no source text to be faithful to: the bytes at
  ; its span are the RULE's spelling, which is the one being renamed.
  (let [rn (sug-ren-of x)
        v (if (> (len rn) 0) "" (sug-verbatim x))]
    (if (> (len v) 0)
        ; A node that came from source. Carry the comments skipped over on the way to
        ; it FIRST — that may open a new line, so its landing column has to be read
        ; from the buffer afterwards rather than before. A node this checker also
        ; rewrites is emitted as that rewrite (see SugBatch); its span holds no
        ; comment of its own.
        (let [subst (sug-batch-subst x)]
          (sug-carry-at! (mut buf) x (sug-cur-col (load buf) start))
          (if (>= subst 0)
              (do
                (sug-batch-absorb! subst)
                (sug-batch-push! subst)
                (sug-emit! a (mut buf) (.repl (elem (sug-list) subst)) start)
                (sug-batch-pop!))
              (sug-put-reindent! (mut buf)
                                 v
                                 (sug-col-at (sug-file-text (sx-source x))
                                             (sx-lo x))
                                 (sug-cur-col (load buf) start))))
        (let [col (sug-cur-col (load buf) start)
              tg (sx-tag x)]
          (if (not (or (= tg 6)
                       (= tg 7)))
              (sug-atom! a (mut buf) x)
              (let [items (sx-items x)
                    n (sx-len items)
                    open (if (= tg 7) 91 40)
                    close (if (= tg 7) 93 41)]
                (if (= n 0)
                    (do
                      (push! (mut buf) (primitive/cast u8 open))
                      (push! (mut buf) (primitive/cast u8 close))
                      0)
                    (do
                      (push! (mut buf) (primitive/cast u8 open))
                      (if (<= (primitive/iadd col (sug-width a x))
                              (sug-width-budget))
                          ; fits: one line, single spaces
                          (let [(mut i) 0]
                            (loop (if (>= (load i) n)
                                      (break)
                                      (do
                                        (when (> (load i)
                                                 0)
                                          (push! (mut buf)
                                                 (: 32 u8)))
                                        (sug-emit! a
                                                   (mut buf)
                                                   (sx-at items (load i))
                                                   start)
                                        (set! i (primitive/iadd (load i) 1))))))
                          ; breaks: the head (or a vector's first element) stays on this
                          ; line and everything after aligns under the first argument —
                          ; fmt's CALL shape. `cond`/`case` additionally pair up.
                          (let [h
                                  (if (= tg 6)
                                      (sug-head-display x)
                                      "")
                                pairs
                                  (and (= tg 6)
                                       (sug-clause-style? h))
                                ind
                                  (if (= tg 7)
                                      (primitive/iadd col 1)
                                      (primitive/iadd (primitive/iadd col
                                                                      (len h))
                                                      2))
                                step (if pairs 2 1)]
                            (sug-emit! a (mut buf) (sx-at items 0) start)
                            (let [(mut i) 1]
                              (loop (if (>= (load i) n)
                                        (break)
                                        (do
                                          (if (= (load i)
                                                 1)
                                              (push! (mut buf)
                                                     (: 32 u8))
                                              (sug-newline! (mut buf) ind))
                                          ; one clause: test, then its body — on the same
                                          ; line if it still fits, else broken onto the
                                          ; next one indented two past the clause column,
                                          ; which is where fmt puts a body it cannot fit
                                          ; (src/compiler/formatter/rules.coil layout-clauses).
                                          (let [(mut k) 0]
                                            (loop (if (or (>= (load k) step)
                                                          (>= (primitive/iadd (load i)
                                                                              (load k))
                                                              n))
                                                      (break)
                                                      (let [it
                                                              (sx-at items
                                                                     (primitive/iadd (load i)
                                                                                     (load k)))]
                                                        (when (> (load k)
                                                                 0)
                                                          (if (sug-gap-commented? it)
                                                              ; src/compiler/formatter/rules.coil: a comment BETWEEN a clause
                                                              ; test and its body forces the hang — two
                                                              ; spaces, the comment, then the body alone on
                                                              ; the next line. Nothing may share that line.
                                                              (do
                                                                (push! (mut buf)
                                                                       (: 32 u8))
                                                                (push! (mut buf)
                                                                       (: 32 u8))
                                                                (sug-carry-at! (mut buf)
                                                                               it
                                                                               (primitive/iadd ind
                                                                                               2)))
                                                              (if (<= (primitive/iadd (primitive/iadd (sug-cur-col (load buf)
                                                                                                                   start)
                                                                                                      1)
                                                                                      (sug-width a
                                                                                                 it))
                                                                      (sug-width-budget))
                                                                  (push! (mut buf)
                                                                         (: 32
                                                                            u8))
                                                                  (sug-newline! (mut buf)
                                                                                (primitive/iadd ind
                                                                                                2)))))
                                                        (sug-emit! a
                                                                   (mut buf)
                                                                   it
                                                                   start)
                                                        (set! k
                                                              (primitive/iadd (load k)
                                                                              1))))))
                                          (set! i
                                                (primitive/iadd (load i) step))))))))
                      (push! (mut buf) (primitive/cast u8 close))
                      0)))))))
  0)

; ---- the comment guard ------------------------------------------------------
; A replacement is assembled from the author's own nodes, so anything INSIDE a node
; survives. What does not survive is text between nodes — and in a Lisp the text
; between two nodes is a comment. Nothing in a Code value records it, so a rule that
; drops a clause boundary would delete the author's comment with it.
;
; Rather than let that happen quietly, the fix is checked before it is applied: count
; the comment marks in the span being replaced and in the text replacing it, and if
; any went missing the rewrite is not a rewrite the author would accept. `;` inside a
; string literal is not a comment, so string state is tracked.
(defn sug-comment-marks [(s (slice u8))] (-> i64)
  (let [n (len s)
        (mut i) 0
        (mut instr) false
        (mut count) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [c (primitive/cast i64 (get s (load i)))]
                (if (load instr)
                    (if (= c 92)
                        (set! i (primitive/iadd (load i) 2))  ; escape: skip the escaped byte
                        (do
                          (when (= c 34)
                            (set! instr false))
                          (set! i (primitive/iadd (load i) 1))))
                    (do
                      (if (= c 34)
                          (set! instr true)
                          (when (= c 59)
                            (set! count (primitive/iadd (load count) 1))))
                      (set! i (primitive/iadd (load i) 1)))))))
    (load count)))

; Would splicing `repl` over [lo,hi) of `src` lose a comment?
(defn sug-drops-comment? [(src (slice u8)) (lo i64) (hi i64) (repl (slice u8))]
  (-> bool)
  (let [n (len src)]
    (if (or (< lo 0) (> hi n) (> lo hi))
        false
        (> (sug-comment-marks (subslice [u8] src lo hi))
           (sug-comment-marks repl)))))

; ── the files that supply the RULES are not targets ──────────────────────────
; A rule loaded with `--use` is an INPUT to the analysis, and `--fix` re-analyses
; after every round. If a rule matches its own source, the first round rewrites the
; file the rule was compiled from; the Code literals its replacements are built out of
; (the `if`/`and` heads in its own quasiquotes) still carry spans into the text as it
; was BEFORE that edit. Rendering then reads the right byte count at the wrong offset
; and splices mangled identifiers into the file — which is exactly the failure a
; source-rewriting tool must not have. Caught here, at the same place as the other
; filters, so such a fix is never even recorded.
(defstruct RuleSrcBox [(init i64) (lst (ptr (ArrayList i64)))])

(defn rule-src-box [] (-> (ptr RuleSrcBox))
  (field (comptime-unit-state) rule_sources))

(defn rule-srcs [] (-> (ptr (ArrayList i64)))
  (let [b (rule-src-box)]
    (when (= (.init b) 0)
      (store! (field b lst)
              (box! (unit-allocator)
                    (ArrayList i64)
                    (zeroed (ArrayList i64))))
      (set! (load (field b lst)) (ArrayList::new [i64] (unit-allocator)))
      (set! (.init b) 1)
      0)
    (load (field b lst))))

(defn rule-src-add [(sid i64)] (-> i64)
  (unless (< sid 0) (push! (rule-srcs) sid) 0))

(defn rule-src-reset [] (-> i64)
  (let [b (rule-src-box)]
    (unless (= (.init b) 0)
      (clear! (mut (load (field b lst))))
      0)))

(defn rule-src? [(sid i64)] (-> bool)
  (let [protected (.protected_rule_sources (comptime-unit-state))
        l (rule-srcs)
        n (len (load l))
        (mut i) 0
        (mut r) false]
    (unless (= (primitive/cast i64 protected) 0)
      (for [j 0 (len (load protected))]
        (when (= (get (load protected) j) sid) (set! r true) 0)
        0)
      0)
    (loop (if (>= (load i) n)
              (break)
              (if (= (get (load l) (load i)) sid)
                  (do (set! r true) (break))
                  (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; Record a proposed rewrite. The filters live HERE rather than at apply time, so a
; node a fix could never legally touch never advertises one either:
;   * ctxt ≠ 0     — macro-generated. Its span points at the macro or the call site,
;                    so "fixing" it would write nonsense into an unrelated form. This
;                    filter is not optional and not configurable.
;   * not user code — a bundled stdlib node has no file on disk to edit.
;   * a rule's own source — see above; the analysis may not rewrite its own input.
(defn cop-record-fix [(node Sexp)
                      (repl Sexp)
                      (msg (slice u8))
                      (di i64)
                      (del i64)] (-> i64)
  (unless (or (!= (sx-ctxt node) 0)
              (not (code-from-user-node? node))
              (rule-src? (sx-source node)))
    (let [(mut s) (zeroed Suggestion)
          (mut rp) (: repl Sexp)]
      (set! (.source s) (sx-source node))
      (set! (.lo s) (sx-lo node))
      (set! (.hi s) (sx-hi node))
      (set! (.col s) (sug-col-at (sug-file-text (sx-source node)) (sx-lo node)))
      ; The replacement remains borrowed until the checker invocation returns.
      ; `sug-freeze-from!` then renders it before that invocation's arena closes.
      (set! (.locals s)
            (sug-locals-of (mut rp)))
      (set! (.repl s) repl)
      (init-fields! s "" [rendered help composed])
      (set! (.absorbs s) (primitive/cast (ptr (ArrayList i64)) 0))
      (set! (.msg s) (ct-own-str msg))
      (set! (.diag s) di)
      (set! (.del s) del)
      (set! (.group s) (sug-current-group))
      (sug-push s)
      0)))

; Is `x` the very node `form` is, or one of its nodes? A rule that replaces a form
; with a piece of it -- `(cast i64 5)` with its `5` -- hands `suggest` the author's
; own node with no quasiquote around it, so nothing marked it transported (hflags
; bit 0) and `sug-verbatim` would reprint it rather than keep its bytes. Identity is
; the node id together with the source and span: ids are unique only within one
; identity domain, and a rule's own template atom carries the rule's source.
(defn sug-node-of? [(x Sexp) (form Sexp)] (-> bool)
  (or (and (!= (sx-node-id x) 0)
           (= (sx-node-id x) (sx-node-id form))
           (= (sx-source x) (sx-source form))
           (= (sx-lo x) (sx-lo form))
           (= (sx-hi x) (sx-hi form)))
      (and (code-node-listish? form)
           (block :found
             (for [i 0 (code-node-len form)]
               (when (sug-node-of? x (code-node-at form i)) (break :found true)))
             false))))

; ops 32 `(primitive/warn NODE MSG)`, 44 `(primitive/suggest NODE MSG REPLACEMENT)` and
; 58 `(primitive/delete NODE MSG)`. All three record a located, non-fatal warning at
; NODE — that half is identical, so it is written once — and the latter two additionally
; record the fix they propose: a rewrite, or the node's removal.
(defn cop-warn-or-suggest [(a (dyn Allocator))
                           (op i64)
                           (args (ptr (ArrayList CtVal)))]
  (-> (Result CtVal Diag))
  (let [fixing (= op 44)
        deleting (= op 58)
        nm (cond fixing "suggest" deleting "delete" :else "warn")
        usage
          (cond fixing
                  "suggest: expects (primitive/suggest NODE MSG REPLACEMENT), REPLACEMENT a Code value"
                deleting "delete: expects (primitive/delete NODE MSG)"
                :else "warn: expects (primitive/warn NODE MSG)")
        repl
          (if fixing
              (match (cv-get args 2)
                (None [] (None [Sexp]))
                (Some [rv]
                      (if (is-ccode rv) (Some (ccode-of rv)) (None [Sexp]))))
              (None [Sexp]))]
    (if (and fixing (not (some? [Sexp] repl)))
        (Err [CtVal Diag] (derr usage))
        (match (cv-get args 0)
          (None [] (Err [CtVal Diag] (derr usage)))
          (Some [nodev]
                (if (not (is-ccode nodev))
                    (Err [CtVal Diag]
                         (derr (text/format a
                                            "{}: first arg must be a Code node"
                                            nm)))
                    (match (cv-get args 1)
                      (None [] (Err [CtVal Diag] (derr usage)))
                      (Some [msgv]
                            (if (not (is-cstr msgv))
                                (Err [CtVal Diag]
                                     (derr (text/format a
                                                        "{}: message must be a string"
                                                        nm)))
                                (let [node (ccode-of nodev)
                                      (mut d) (zeroed Diag)
                                      di (len (load (warn-list)))]
                                  (set! (.lo d) (sx-lo node))
                                  (set! (.hi d) (sx-hi node))
                                  ; malloc, not `a`: the warn list outlives the
                                  ; expansion arena `a` may be (COIL_META_ARENA)
                                  (set! (.msg d)
                                        (text/format (unit-allocator)
                                                     "warning: {}"
                                                     (cstr-of msgv)))
                                  (set! (.source d) (sx-source node))
                                  (set! (.ctxt d) 0)
                                  (warn-push d)
                                  ; a delete carries no replacement, so `node` stands in
                                  ; for the unused `repl` slot rather than widening the
                                  ; record with an Option nobody reads.
                                  (if deleting
                                      (cop-record-fix node
                                                      node
                                                      (cstr-of msgv)
                                                      di
                                                      1)
                                      (match repl
                                        (None [] 0)
                                        (Some [r]
                                              (cop-record-fix node
                                                              ; a template's own list is never one
                                                              (if (and (!= (sx-horigin r)
                                                                           1)
                                                                       (sug-node-of? r
                                                                                     node))
                                                                  (sexp-transported r)
                                                                  r)
                                                              (cstr-of msgv)
                                                              di
                                                              0))))
                                  (Ok [CtVal Diag] (CInt 0))))))))))))

; A suggestion's replacement as text, laid out as if it began at column `col`.
(defn sug-render-tree-at [(a (dyn Allocator)) (s Suggestion) (col i64)]
  (-> (slice u8))
  (let [(mut sp) (: s Suggestion)
        (mut buf) (ArrayList::new [u8] a)
        start (sug-layout-col col)]
    ; the cursor runs over the span being replaced, so the comments in the gaps the
    ; rewrite closes come along with the nodes it reuses
    (sug-ren-build! a
                    (.repl sp)
                    (.locals sp))
    (sug-gap-begin a (.source sp) (.lo sp) (.hi sp) (.repl sp))
    (set! (.plain (sug-batch-cell)) (= (len (load (sug-ren-list))) 0))
    (sug-emit! a (mut buf) (.repl sp) start)
    ; With no node kept from the replaced span, there is no surviving source
    ; anchor for its comments. Do not move them after an unrelated new form: the
    ; comment guard will withhold the suggestion instead.
    (when (> (len (.emitted (sug-gap-cell))) 0)
      (sug-carry-tail! (mut buf) (.hi sp) start)
      0)
    (sug-ren-clear)
    (sug-gap-end)
    (slice (load buf))))

; Freeze suggestions recorded by one completed checker before its expansion arena
; is released. Waiting until the checker returns matters: rendering uses the
; suggestion-hygiene table, which is also active while the checker is still building
; later replacements. The old lifetime boundary deep-copied every overlapping AST;
; this one owns only the bytes lint will actually print or splice.
(defn sug-freeze-from! [(a (dyn Allocator)) (start i64)] (-> i64)
  (let [lst (sug-list)
        n (len (load lst))]
    ; Every replacement is rendered before any is dropped: one may stand inside
    ; another (see SugBatch), whichever order the checker suggested them in.
    (sug-batch-begin! a start n)
    (for [i start n]
      (let [sp (elem lst i)
            b (sug-batch-cell)]
        (when (= (.del sp) 0)
          (sug-batch-push! i)
          (set! (.rendered sp)
                (ct-own-str (sug-render-tree-at a (load sp) (.col sp))))
          (set! (.help sp)
                (ct-own-str (sug-render-tree-at a (load sp) 11)))
          (clear! (mut (.absorbed b)))
          (set! (.on b) true)
          (let [composed (sug-render-tree-at a (load sp) (.col sp))]
            (set! (.on b) false)
            (when (> (len (.absorbed b)) 0)
              (let [ua (unit-allocator)
                    (mut owned) (ArrayList::new [i64] ua)]
                (for j (.absorbed b) (push! (mut owned) j))
                (set! (.composed sp) (ct-own-str composed))
                (set! (.absorbs sp) (box-al ua (load owned))))
              0))
          (sug-batch-pop!)
          0)))
    (sug-batch-end!)
    (for [i start n]
      (set! (.repl (elem lst i)) (zeroed Sexp)))
    0))

; Persistent suggestions own rendered bytes, not an overlapping replacement AST.
(defn sug-render-at [(a (dyn Allocator)) (s Suggestion) (col i64)]
  (-> (slice u8))
  (let [(mut sp) (: s Suggestion)]
    (if (> (len (.rendered sp)) 0)
        (if (= col 11) (.help sp) (.rendered sp))
        (sug-render-tree-at a s col))))

; The text that would be spliced over the suggestion's own span.
(defn sug-render [(a (dyn Allocator)) (s Suggestion)] (-> (slice u8))
  (let [(mut sp) (: s Suggestion)] (.rendered sp)))

; Print `help: try: …` for any suggestion attached to warning `di`. This is where
; most of autofix's value lands: the proposed rewrite is visible from an ordinary
; build, whether or not anyone ever runs `coil lint --fix`. Continuation lines are
; laid out to align under the start of the replacement, past the `help: try: ` label.
(defn sug-print-help [(w (ptr Writer)) (a (dyn Allocator)) (di i64)] (-> i64)
  (let [n (sug-count)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [(mut sp) (sug-at (load i))]
                  (when (= (.diag sp) di)
                    ; A deletion has no replacement text to show, so it says what it
                    ; would do instead of printing an empty `try:` line.
                    (if (= (.del sp) 0)
                        (do
                          (ps w "help: try: ")
                          (ps w (sug-render-at a sp 11))
                          0)
                        (ps w "help: `coil lint --fix` deletes this form"))
                    (wb w 10)
                    0))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; case it exists for: cross-compiling. A macro branching on it baked the host branch
; into a wasm build, silently. The arch is one value per compile, set from the resolved
; --target triple before expansion runs (like the node-id/gensym counters, it is a
; per-process global — the compiler builds one target per invocation).
; C `access(path, 0)` — F_OK. Module-qualified so the name cannot collide;
; the backends link the LAST dot component, i.e. the C symbol `access`.
(extern comptime.access :cc (cc/C) [(ptr i8) i32] (-> i32))

(defstruct TargetArchCell
  [(set i64) (arch (slice u8)) (os (slice u8)) (triple (ptr i8))])

(defn target-arch-cell [] (-> (ptr TargetArchCell))
  (field (comptime-unit-state) target))

;;; Set when a compiler built for WebAssembly (the portable seed, run through
;;; wasm2c) is told to emit native code with no --target: the program is then for
;;; the machine it runs on, not for the wasm the compiler itself is. Without it,
;;; `(target-arch)` answered wasm64 while the arm64 backend built the program, so
;;; the seed built a compiler whose machine code was the wasm fallback.
(defstruct NativeDefault [(on bool)])

(defn native-default-cell [] (-> (ptr NativeDefault))
  (primitive/alloc-static NativeDefault))

(defn arch-of-triple [(triple (ptr i8))] (-> (slice u8))
  (if (= (primitive/cast i64 triple) 0)
      ; null = "no --target", i.e. build for the host
      (if (.on (native-default-cell)) (native-arch-str) (host-arch-str))
      (let [t (from-cstr triple)]
        (cond (starts-with t "wasm32") "wasm32"
              (starts-with t "wasm64") "wasm64"
              (starts-with t "x86_64") "x86_64"
              (starts-with t "aarch64") "aarch64"
              (starts-with t "arm64") "aarch64"
              (starts-with t "riscv32") "riscv32"
              ""))))  ; unknown: set-target-arch! refuses the triple

; The OS half of the same story, and it exists for the same reason the arch does:
; a library that branches on the platform — open() flags, dylib suffixes, syscall
; numbers — must branch on the platform being COMPILED FOR, not the one running
; the compiler. Without this a `const` folded at compile time silently records
; the build host, so cross-compiling to darwin from Linux bakes in Linux answers.
; (src/stdlib/fs.coil hit exactly that: 512 is O_CREAT on darwin and O_TRUNC on Linux.)
;
; Kept in the same cell as the arch: one target per compiler invocation, set from
; the resolved --target triple before expansion runs.
(defn has-sub? [(hay (slice u8)) (needle (slice u8))] (-> bool)
  (match (find hay needle) (Some [i] true) (None [] false)))

;;; An Apple OS other than macOS: `arm64-apple-ios18.0`, `arm64-apple-ios18.0-simulator`,
;;; `arm64-apple-tvos`, `arm64-apple-watchos`, `arm64-apple-xros`.
(defn apple-embedded-os? [(t (slice u8))] (-> bool)
  (and (has-sub? t "-apple-")
       (or (has-sub? t "-ios")
           (has-sub? t "-tvos")
           (has-sub? t "-watchos")
           (has-sub? t "-xros"))))

(defn os-of-triple [(triple (ptr i8))] (-> (slice u8))
  (if (= (primitive/cast i64 triple) 0)
      (host-os-str)  ; null = "no --target", i.e. build for the host
      (let [t (from-cstr triple)]
        ; match on the triple's os field, which is the component after the vendor
        ; ("x86_64-pc-linux-gnu", "aarch64-apple-darwin24.0.0", "wasm64-unknown-unknown").
        (cond (has-sub? t "linux") "linux"
              (has-sub? t "darwin") "darwin"
              (has-sub? t "macos") "darwin"
              ; iOS (and its simulator), tvOS, watchOS and visionOS run the same
              ; Darwin userland: libc, errno and open(2) numbers are macOS's.
              (apple-embedded-os? t) "darwin"
              (starts-with t "wasm") "wasm"
              (has-sub? t "-none") "none"  ; bare metal: no operating system
              ; An OS Coil does not know is still the target's: a per-OS choice
              ; reports that it has nothing for it, instead of building for the host.
              (triple-os-field t)))))

;;; The OS component of an `arch-vendor-os[-env]` triple, or of an `arch-os` pair.
(defn triple-os-field [(t (slice u8))] (-> (slice u8))
  (match (find t "-")
    (None [] t)
    (Some [a]
          (let [rest (subslice t (+ a 1) (len t))]
            (match (find rest "-")
              (None [] rest)  ; arch-os
              (Some [b]
                    (let [os (subslice rest (+ b 1) (len rest))]
                      (match (find os "-")
                        (None [] os)
                        (Some [c] (subslice os 0 c))))))))))

; The HOST os, for when no --target was given. /proc/self/maps exists on every
; Linux and never on macOS — the same probe metaengine.coil uses to pick the
; dylib extension and link command.
(defn host-os-str [] (-> (slice u8))
  (if (= (primitive/cast i64 (comptime.access c"/proc/self/maps" 0))
         0)
      "linux"
      "darwin"))

;;; `native` in a compiler built for a native machine, the wasm arch in one built
;;; for wasm.
(defn host-arch-pick [(native Code) (wasm32 Code) (wasm64 Code)] (-> Code)
  (match (target-arch)
    (Wasm32 [] wasm32)
    (Wasm64 [] wasm64)
    (X86_64 [] native)
    (Aarch64 [] native)
    (Riscv32 [] native)))

;; uname(2). Module-qualified like `access` above; the backends link `uname`.
(extern comptime.uname :cc (cc/C) [(ptr i8)] (-> i32))

;;; The machine this compiler is running on, from uname(2). Asked at run time, like
;;; host-os-str: what a compiler was told at its own build is only what the
;;; compiler that built it believed, and a compiler built with no `--target` by
;;; one that took every host for aarch64 believed that too, and passed it on.
(defn native-arch-str [] (-> (slice u8))
  (let [cell (primitive/alloc-static i64)]
    (when (= (load cell) 0)
      ; struct utsname: five (Darwin, 256 bytes) or six (Linux, 65 bytes) fixed
      ; fields; `machine` is the fifth either way.
      (let [buf (primitive/alloc-stack (array u8 1536))
            machine (if (= (host-os-str) "linux") 260 1024)]
        (store! cell
                (if (!= (comptime.uname (primitive/cast (ptr i8) buf))
                        (: 0 i32))
                    3
                    (let [m
                            (from-cstr (primitive/cast (ptr i8)
                                                       (index buf machine)))]
                      (cond (= m "x86_64") 1
                            (or (= m "arm64") (= m "aarch64")) 2
                            :else 3))))
        0))
    (cond (= (load cell) 1) "x86_64"
          (= (load cell) 2) "aarch64"
          :else
            (do
              (unimplemented "comptime: uname(2) reports a machine this compiler does not know")
              ""))))

;;; The architecture of the machine running this compiler, as arch-of-triple
;;; spells it.
(defn host-arch-str [] (-> (slice u8))
  (host-arch-pick (native-arch-str) "wasm32" "wasm64"))

;;; Whether target questions answer, right now, for a different platform from the
;;; one the compiler runs on. Only then do the program and the code that runs
;;; inside the compiler (macros, `(meta …)` generators, transforms) need separate
;;; expansions; otherwise every target question has the same answer in both. False
;;; while the host compilation of a cross build is being expanded.
(defn cross-build? [] (-> bool)
  (let [c (target-arch-cell)]
    (and (!= (.set c) 0)
         (or (!= (.arch c) (host-arch-str)) (!= (.os c) (host-os-str))))))

;;; The cell's answers for the host: no triple, this compiler's own arch, the OS it
;;; runs on.
(defn host-target-cell [] (-> TargetArchCell)
  (let [(mut c) (zeroed TargetArchCell)]
    (set! (.set c) 1)
    (set! (.triple c) (primitive/cast (ptr i8) 0))
    (set! (.arch c) (host-arch-str))
    (set! (.os c) (host-os-str))
    (load c)))

;;; Make `next` the platform target questions answer for and return the one it
;;; replaces, for the caller to put back. This is how one compilation expands
;;; code that runs inside the compiler for the host and the program for its
;;; target: the questions answer for the code being produced at that moment.
(defn target-cell-swap! [(next TargetArchCell)] (-> TargetArchCell)
  (let [c (target-arch-cell)
        prior (load c)]
    (set! c next)
    prior))

;;; Is T a WebAssembly triple naming no vendor or system: `wasm32`, or its
;;; architecture followed only by `-unknown` parts?
(defn wasm-triple-plain? [(t (slice u8))] (-> bool)
  (let [(mut at) 0
        (mut ok) true]
    (while (and (< (load at) (len t)) (!= (get t (load at)) (: 45 u8)))
      (set! at (+ (load at) 1)))
    (while (and (load ok) (< (load at) (len t)))
      ; at a '-': the part after it must be `unknown`
      (let [start (+ (load at) 1)
            (mut end) start]
        (while (and (< (load end) (len t)) (!= (get t (load end)) (: 45 u8)))
          (set! end (+ (load end) 1)))
        (unless (= (subslice t start (load end)) "unknown") (set! ok false))
        (set! at (load end))))
    (load ok)))

(defn set-target-arch! [(triple (ptr i8))] (-> i64)
  (let [c (target-arch-cell)]
    ; Refuse an architecture no backend knows before anything expands, rather than
    ; answering for the host's and building that.
    (when (= (arch-of-triple triple) "")
      (ps (stderr) "error: unsupported --target '")
      (ps (stderr) (from-cstr triple))
      (ps (stderr)
          "': Coil targets aarch64, x86_64, riscv32, wasm32 and wasm64\n")
      (ffi/exit 1))
    ; A WebAssembly program's C functions come from the host that loads it; no
    ; system interface (WASI, Emscripten) is linked in, so naming one built a
    ; module that imports `env.write` and never runs there.
    (when (and (or (= (arch-of-triple triple) "wasm32")
                   (= (arch-of-triple triple) "wasm64"))
               (not (wasm-triple-plain? (from-cstr triple))))
      (ps (stderr) "error: unsupported --target '")
      (ps (stderr) (from-cstr triple))
      (ps (stderr)
          "': Coil's WebAssembly targets are wasm32-unknown-unknown and wasm64-unknown-unknown, whose host provides the C functions the program imports\n")
      (ffi/exit 1))
    (set! (.triple c) triple)
    (set! (.arch c) (arch-of-triple triple))
    (set! (.os c) (os-of-triple triple))
    (set! (.set c) 1)
    ; The loader refuses header probes when this is not the host platform.
    (set! (.cross_target (loader-unit-state))
          (if (or (= (primitive/cast i64 triple) 0)
                  (and (= (.os c) (host-os-str)) (= (.arch c) (host-arch-str))))
              ""
              (from-cstr triple)))
    0))

(defn target-triple [] (-> (ptr i8))
  (.triple (target-arch-cell)))

(defn target-arch-str [] (-> (slice u8))
  (let [c (target-arch-cell)]
    (if (= (.set c) 0)
        (host-arch-str)
        (.arch c))))

(defn target-os-str [] (-> (slice u8))
  (let [c (target-arch-cell)]
    (if (= (.set c) 0)
        (host-os-str)
        (.os c))))

;;; The identity of the toolchain compiling this program: the source digest its
;;; build recorded in `<compiler>.toolchain`, which names the compiler and library
;;; sources and so the calling convention every declaration assumes. None for an
;;; unstamped compiler, whose ABI nothing can vouch for. A JIT session's compiler
;;; is the toolchain it was given (`set-self-command!`), not the host binary.
(defn toolchain-digest [(a (dyn Allocator))] (-> (Option (slice u8)))
  (match (read-file-opt a
                        (to-cstr a
                                 (text/format a
                                              "{}.toolchain"
                                              (self-command-path a))))
    (None [] (None [(slice u8)]))
    (Some [stamp]
          (let [line
                  (match (find stamp "\n")
                    (Some [i] (subslice stamp 0 i))
                    (None [] stamp))]
            (if (= (len line) 0) (None [(slice u8)]) (Some line))))))

(defn toolchain-target [(a (dyn Allocator))] (-> (slice u8))
  (text/format a "{}-{}" (target-arch-str) (target-os-str)))

;;; `(toolchain :compiler "<digest>" :target "<arch>-<os>")`, the header of a
;;; program description; :compiler is :unknown for an unstamped compiler.
(defn toolchain-form [(a (dyn Allocator))] (-> Sexp)
  (let [(mut items) (ArrayList::new [Sexp] a)]
    (push! (mut items) (mk-sexp (KSym "toolchain") -1 -1))
    (push! (mut items) (mk-sexp (KKw "compiler") -1 -1))
    (push! (mut items)
           (match (toolchain-digest a)
             (Some [d] (mk-sexp (KStr d) -1 -1))
             (None [] (mk-sexp (KKw "unknown") -1 -1))))
    (push! (mut items) (mk-sexp (KKw "target") -1 -1))
    (push! (mut items) (mk-sexp (KStr (toolchain-target a)) -1 -1))
    (mk-sexp (KList (box-al a (load items))) -1 -1)))

; `(primitive/debug-checks?)` — the --debug-checks build-mode predicate (mem-2/6/7/8), a code op
; (39) so it works in BOTH engines with no seed refresh: the interpreter answers it here
; in `code-op`, and the compiled engine routes back through `code-op` via metahost. Set
; from the driver before expansion (like the target arch); off (false) by default, so a
; library's `(if (primitive/debug-checks?) …checked… …plain…)` guard MACRO expands to the plain
; form and costs nothing. Per-process global — one build mode per compile.
(defstruct DebugChecksCell [(on i64)])

(defn debug-checks-cell [] (-> (ptr DebugChecksCell))
  (field (comptime-unit-state) debug_checks))

(defn set-debug-checks! [(on i64)] (-> i64)
  (set! (.on (debug-checks-cell)) on)
  0)

(defn debug-checks-on? [] (-> bool)
  (!= (.on (debug-checks-cell)) 0))

; One sanitizer per program object: 0=off, 1=address, 2=thread, 3=memory,
; 4=undefined. ASan/TSan/MSan runtimes are mutually incompatible, so the driver
; rejects attempts to select more than one instead of silently choosing an order.
(defstruct SanitizeCell [(mode i64)])

(defn sanitize-cell [] (-> (ptr SanitizeCell))
  (field (comptime-unit-state) sanitizer))

(defn set-sanitize-mode! [(mode i64)] (-> i64)
  (set! (.mode (sanitize-cell)) mode)
  0)

(defn sanitize-mode [] (-> i64)
  (.mode (sanitize-cell)))

(defn set-sanitize-address! [] (-> i64)
  (set-sanitize-mode! 1))

(defn sanitize-address-on? [] (-> bool)
  (= (sanitize-mode) 1))

; ── S1 semantic layer for `(primitive/code-decl NODE)`: read the compiler's AUTHORITATIVE
; work. Checkers run AFTER resolve + typecheck (see expander.coil::run-registered-
; checkers and driver.coil::run-pipeline), so a checker reads the real checked
; Program — fully-qualified names and real signatures — NOT a parallel resolver.
; `set-sem-model` stashes that Program before checkers run; `code-decl` answers
; the exact canonical declaration identity and, for a function, its SIGNATURE.
;;; STATUS: 0 no model, 1 partial (some declarations or functions failed; `diags`
;;; lists why), 2 complete. A partial model answers every query the checker could
;;; establish; failed nodes answer `:unknown`/`:unresolved`.
(defstruct SemModelBox
  [(init i64)
   (prog (ptr Program))
   (checked_base (ptr checkedbase/CheckedBase))
   (status i64)
   (diags (ptr (ArrayList Diag)))
   (dependency_base (ptr deps/DepBase))
   ; The loader's tables the model's names were resolved
   ; against, for `resolve-at`. Null when the model did not
   ; come from a loader.
   (imports (ptr (ArrayList ImpEntry)))
   (exports (ptr (ArrayList ExpEntry)))
   (declarations (ptr (ArrayList DefEntry)))
   ; the checker's context for the model (loader `checker_context`)
   (checker (ptr Cx))
   ; The compilation's top-level forms, for the source of a
   ; definition (`program-interface` queries). Null when the
   ; model did not come from a loader.
   (forms (ptr (ArrayList TaggedForm)))
   ; The top-level forms of the submissions a retained
   ; session accepted before this one (loader.coil).
   (retained (ptr (ArrayList RetainedForm)))])

(defn sem-model-box [] (-> (ptr SemModelBox))
  (field (comptime-unit-state) semantic_model))

(defn set-sem-model [(p (ptr Program))] (-> i64)
  (let [b (sem-model-box)]
    (set! (.dependency_graph (comptime-unit-state))
          (primitive/cast (ptr dependencies/DependencyGraph) 0))
    (set! (.prog b) p)
    (set! (.checked_base b) (checkedbase/checked-no-base))
    (set! (.dependency_base b) (deps/dep-no-base))
    (set! (.init b) 1)
    (set! (.status b) (if (= (primitive/cast i64 p) 0) 0 2))
    (set! (.diags b) (primitive/cast (ptr (ArrayList Diag)) 0))
    (set! (.imports b) (primitive/cast (ptr (ArrayList ImpEntry)) 0))
    (set! (.exports b) (primitive/cast (ptr (ArrayList ExpEntry)) 0))
    (set! (.declarations b) (primitive/cast (ptr (ArrayList DefEntry)) 0))
    (set! (.checker b) (primitive/cast (ptr Cx) 0))
    (set! (.forms b) (primitive/cast (ptr (ArrayList TaggedForm)) 0))
    (set! (.retained b) (primitive/cast (ptr (ArrayList RetainedForm)) 0))
    (variant-owner-build! p)
    ; Whatever was indexed belonged to the previous model.
    (set! (.init (field (comptime-unit-state) method_decls)) 0)
    (set! (.init (field (comptime-unit-state) function_decls)) 0)
    (set! (.init (field (comptime-unit-state) kind_decls)) 0)
    0))

; Incremental semantic models carry only the candidate's checked overlay.
; Accepted function records remain in the immutable checked index.
(defn set-sem-model-checked-base! [(base (ptr checkedbase/CheckedBase))]
  (-> i64)
  (set! (.checked_base (sem-model-box)) base)
  0)

;;; A model of a program that does not fully check: everything the checker
;;; established, plus the diagnostics explaining what it could not.
(defn set-partial-sem-model [(p (ptr Program)) (diags (ptr (ArrayList Diag)))]
  (-> i64)
  (set-sem-model p)
  (mark-sem-model-partial! diags))

;;; Mark the installed model partial: DIAGS say what did not check.
(defn mark-sem-model-partial! [(diags (ptr (ArrayList Diag)))] (-> i64)
  (let [b (sem-model-box)]
    (set! (.status b) 1)
    (set! (.diags b) diags))
  0)

(defn sem-model-status [] (-> i64)
  (let [b (sem-model-box)] (if (= (.init b) 0) 0 (.status b))))

;;; The diagnostic located exactly at NODE's source span in the current model.
(defn sem-model-error-at [(node Sexp)] (-> (Option (slice u8)))
  (let [b (sem-model-box)]
    (block :found
      (when (or (= (.init b) 0) (= (primitive/cast i64 (.diags b)) 0))
        (break :found (None [(slice u8)])))
      (when (or (< (sx-source node) 0) (< (sx-lo node) 0))
        (break :found (None [(slice u8)])))
      (for [i 0 (len (load (.diags b)))]
        (let [d (elem (.diags b) i)]
          (when (and (= (.source d) (sx-source node))
                     (and (= (.lo d) (sx-lo node)) (= (.hi d) (sx-hi node))))
            (break :found (Some (.msg d))))))
      (None [(slice u8)]))))

; No authoritative program available this round (the current program does not yet
; typecheck) — `code-decl` and friends then answer `:unresolved`. A transform can
; still rewrite syntactically until the program becomes valid.
(defn clear-sem-model [] (-> i64)
  (set-sem-model (primitive/cast (ptr Program) 0)))

(defn sem-model [] (-> (ptr Program))
  (let [b (sem-model-box)]
    (if (= (.init b) 0)
        (primitive/cast (ptr Program) 0)
        (load (field b prog)))))

; Raw project lint intentionally does not expand application macros. Preserve the
; semantic distinction between "this authored node is a macro call" and "this node
; was generated by expansion" so checkers can choose whether to enter its arguments.
(defstruct MacroCallBox
  [(init i64) (index (ptr (HashMap i64 bool)))])

;;; The macro call being expanded, while a macro runs: what
;;; `(primitive/code-call-site)` answers. `present` is 0 outside an expansion.
(defstruct MacroCallSite [(present i64) (node Sexp)])

(defn macro-call-site-cell [] (-> (ptr MacroCallSite))
  (primitive/alloc-static MacroCallSite))

;;; Make NODE the call site for the duration of one expansion; returns the site
;;; it replaces, for `macro-call-site-restore!`. Expansions nest when a macro's
;;; result is itself expanded, never while a macro runs, but restoring keeps the
;;; answer right either way.
(defn macro-call-site-enter! [(node Sexp)] (-> MacroCallSite)
  (let [cell (macro-call-site-cell)
        before (load cell)]
    (set! (.present cell) 1)
    (set! (.node cell) node)
    before))

(defn macro-call-site-restore! [(before MacroCallSite)] (-> i64)
  (set! (macro-call-site-cell) before)
  0)

;;; `(primitive/code-call-site)`: the macro call being expanded.
(defn cop-call-site [(args (ptr (ArrayList CtVal)))] (-> (Result CtVal Diag))
  (let [cell (macro-call-site-cell)]
    (cond (> (len (load args)) 0)
            (Err [CtVal Diag]
                 (derr "code-call-site: expects no arguments: (primitive/code-call-site)"))
          (= (.present cell) 0)
            (Err [CtVal Diag]
                 (derr "code-call-site: there is no call site outside a macro's expansion"))
          :else (Ok [CtVal Diag] (CCode (.node cell))))))

(defn macro-call-box [] (-> (ptr MacroCallBox))
  (field (comptime-unit-state) macro_calls))

(defn macro-call-reset [] (-> i64)
  (let [b (macro-call-box)]
    (if (= (.init b) 0)
        (let [a (unit-allocator)]
          (store! (field b index)
                  (box! a
                        (HashMap i64 bool)
                        (HashMap::new [i64 bool] a (i64-keyops)))))
        (clear! (mut (load (field b index)))))
    (set! (.init b) 1)
    0))

(defn macro-call-record [(node-id i64)] (-> i64)
  (when (> node-id 0)
    (let [b (macro-call-box)]
      (when (= (.init b) 0)
        (macro-call-reset)
        0)
      (set! (mut (load (field b index))) node-id true))
    0)
  0)

(defn macro-call-lookup [(node-id i64)] (-> bool)
  (let [b (macro-call-box)]
    (if (or (<= node-id 0)
            (= (.init b) 0))
        false
        (match (get (load (load (field b index))) node-id)
          (Some [v] v)
          (None [] false)))))

; ── The read-through base under the three maps below ──────────────────────────
; A pass records into its own mutable maps and, on a miss, reads the results of
; earlier compilations from a persistent `SemBase`. It never writes the base, so
; whoever supplied it can keep using it, and nothing is copied to build on it.
(defn semantic-base [] (-> (ptr SemBase))
  (.semantic_base (comptime-unit-state)))

(defn semantic-base-set! [(base (ptr SemBase))] (-> i64)
  (set! (.semantic_base (comptime-unit-state)) base)
  0)

; ── S2: the TYPE MAP — per-expression inferred types for `(primitive/type-of NODE)`.
; The type-checker records, at `do-synth` (its single per-expression entry), the
; inferred Type keyed by the expression's source span. A metaprogram then asks
; `(primitive/type-of NODE)` for the type of any expression it sees (the surface Code node
; shares the span the checker recorded). Reset at the start of each check pass.
(defstruct TypeMapEntry [(node-id i64) (ty Type)])

;;; Where the semantic side tables (type, binding and resolved-name maps, and the
;;; declaration indexes of a model) keep their entries. Each check resets them, and a snapshot may still borrow the old
;;; tables, so a reset abandons them rather than freeing them: in the unit's
;;; allocator they stay until the unit ends. A command that runs many compilations
;;; in one unit (`lint --fix`, an analysis per round) points this at the current
;;; compilation's own arena, so each analysis's tables go with it.
(defstruct SemMapsAllocatorCell [(set bool) (a (dyn Allocator))])

(defn sem-maps-allocator-cell [] (-> (ptr SemMapsAllocatorCell))
  (primitive/alloc-static SemMapsAllocatorCell))

(defn sem-maps-allocator [] (-> (dyn Allocator))
  (let [cell (sem-maps-allocator-cell)]
    (if (.set cell) (.a cell) (unit-allocator))))

;;; Keep the semantic tables in A until sem-maps-allocator-clear!. A must outlive
;;; every check that runs meanwhile, and the tables must be reset before A goes.
(defn sem-maps-allocator-set! [(a (dyn Allocator))] (-> i64)
  (let [cell (sem-maps-allocator-cell)]
    (set! (.a cell) a)
    (set! (.set cell) true))
  0)

(defn sem-maps-allocator-clear! [] (-> i64)
  (set! (.set (sem-maps-allocator-cell)) false)
  0)

;;; Where the next reset of the type, binding and resolution maps puts its tables,
;;; when that is narrower than `sem-maps-allocator`. A check whose tables are dead
;;; once it is done (a closure check that only feeds an engine build, a tower
;;; generation the next generation replaces) gives them its own arena, so that
;;; each such check does not leave tables sized for its whole closure in the
;;; unit until the unit ends. Only the three maps follow it: the declaration
;;; indexes built beside them are cached by program and must outlive the check.
(defstruct SemTablesAllocatorCell [(set bool) (a (dyn Allocator))])

(defn sem-tables-allocator-cell [] (-> (ptr SemTablesAllocatorCell))
  (primitive/alloc-static SemTablesAllocatorCell))

(defn sem-tables-allocator [] (-> (dyn Allocator))
  (let [cell (sem-tables-allocator-cell)]
    (if (.set cell) (.a cell) (sem-maps-allocator))))

;;; Route table resets to A until `sem-tables-allocator-leave!` with the value
;;; returned here. Whoever owns A must restore maps that outlive it (with
;;; `sem-maps-restore`) before A goes.
(defn sem-tables-allocator-enter! [(a (dyn Allocator))]
  (-> SemTablesAllocatorCell)
  (let [cell (sem-tables-allocator-cell)
        prior (load cell)]
    (set! (.a cell) a)
    (set! (.set cell) true)
    prior))

(defn sem-tables-allocator-leave! [(prior SemTablesAllocatorCell)] (-> i64)
  (set! (sem-tables-allocator-cell) prior)
  0)

(defstruct TypeMapBox
  [(init i64)
   (lst (ptr (ArrayList TypeMapEntry)))
   (index (ptr (HashMap i64 i64)))])

(defn type-map-box [] (-> (ptr TypeMapBox))
  (field (comptime-unit-state) types))

(defn type-map-list [] (-> (ptr (ArrayList TypeMapEntry)))
  (let [b (type-map-box)]
    (when (= (.init b) 0)
      (store! (field b lst)
              (box! (unit-allocator)
                    (ArrayList TypeMapEntry)
                    (zeroed (ArrayList TypeMapEntry))))
      (set! (load (field b lst))
            (ArrayList::new [TypeMapEntry] (unit-allocator)))
      (store! (field b index)
              (box! (unit-allocator)
                    (HashMap i64 i64)
                    (HashMap::new [i64 i64] (unit-allocator) (i64-keyops))))
      (set! (.init b) 1)
      0)
    (load (field b lst))))

(defn type-map-reset [] (-> i64)
  (let [_ (type-map-list)
        b (type-map-box)]
    (set! (load (field b lst))
          (ArrayList::new [TypeMapEntry] (sem-tables-allocator)))
    (set! (load (field b index))
          (HashMap::new [i64 i64] (sem-tables-allocator) (i64-keyops)))
    0))

(defn type-map-record [(node-id i64) (ty Type)] (-> i64)
  (unless (<= node-id 0)
    ; skip synthesized nodes (node-id -1) / the "no id" sentinel
    (let [(mut e) (zeroed TypeMapEntry)]
      (set! (.node-id e) node-id)
      (set! (.ty e) ty)
      (push! (type-map-list) e)
      (set! (mut (load (field (type-map-box) index)))
            node-id
            (primitive/isub (len (load (type-map-list))) 1))
      0)))

;;; The number of type records so far: a position to hand to `type-map-reinstate!`.
(defn type-map-mark [] (-> i64)
  (len (load (type-map-list))))

;;; Make the records made between positions `from` and `to` the current ones for
;;; their nodes again, the later of two for one node winning as it did. Nothing is
;;; added: each node's index entry points back at its earlier record.
(defn type-map-reinstate! [(from i64) (to i64)] (-> i64)
  (when (<= to (len (load (type-map-list))))
    (for [i from to]
      (set! (mut (load (field (type-map-box) index)))
            (.node-id (elem (type-map-list) i))
            i)))
  0)

; Look up a node id's type; scan from the END so the last (most-refined) record wins.
(defn type-map-lookup [(node-id i64)] (-> (Option Type))
  (if (<= node-id 0)
      (None [Type])
      (match (get (load (load (field (type-map-box) index))) node-id)
        (None [] (sem-base-type (semantic-base) node-id))
        (Some [i]
              (Some (.ty (elem (type-map-list) i)))))))

; ── S3: the BINDING MAP — per-reference local-binding identity for a borrow/
; ownership checker. The type-checker records, at every resolved `EVar`, the ID
; of the LET-binding or parameter it resolves to (0 = a global const/function or
; unbound). Two references with the same positive id name the SAME local — so
; shadowing is exact, which name-matching cannot do. `(primitive/binding-of NODE)` reads it.
; The counter is monotonic and reset per check pass, so ids are deterministic
; across identical rebuilds (the fixpoint holds).
(defstruct BidCell [(n i64)])

(defn bid-cell [] (-> (ptr BidCell))
  (field (comptime-unit-state) binding_ids))

(defn next-bid [] (-> i64)
  (let [c (bid-cell)
        v (primitive/iadd (.n c) 1)]
    (set! (.n c) v)
    v))

(defstruct BindMapEntry [(node-id i64) (bid i64)])

(defstruct BindMapBox
  [(init i64)
   (lst (ptr (ArrayList BindMapEntry)))
   (index (ptr (HashMap i64 i64)))])

(defn bind-map-box [] (-> (ptr BindMapBox))
  (field (comptime-unit-state) bindings))

(defn bind-map-list [] (-> (ptr (ArrayList BindMapEntry)))
  (let [b (bind-map-box)]
    (when (= (.init b) 0)
      (store! (field b lst)
              (box! (unit-allocator)
                    (ArrayList BindMapEntry)
                    (zeroed (ArrayList BindMapEntry))))
      (set! (load (field b lst))
            (ArrayList::new [BindMapEntry] (unit-allocator)))
      (store! (field b index)
              (box! (unit-allocator)
                    (HashMap i64 i64)
                    (HashMap::new [i64 i64] (unit-allocator) (i64-keyops))))
      (set! (.init b) 1)
      0)
    (load (field b lst))))

(defn bind-map-reset [] (-> i64)
  (let [_ (bind-map-list)
        b (bind-map-box)
        c (bid-cell)]
    (set! (load (field b lst))
          (ArrayList::new [BindMapEntry] (sem-tables-allocator)))
    (set! (load (field b index))
          (HashMap::new [i64 i64] (sem-tables-allocator) (i64-keyops)))
    (set! (.n c) 0)
    0))

(defn bind-map-record [(node-id i64) (bid i64)] (-> i64)
  (unless (<= node-id 0)
    (let [(mut e) (zeroed BindMapEntry)]
      (set! (.node-id e) node-id)
      (set! (.bid e) bid)
      (push! (bind-map-list) e)
      (set! (mut (load (field (bind-map-box) index)))
            node-id
            (primitive/isub (len (load (bind-map-list))) 1))
      0)))

(defn bind-map-lookup [(node-id i64)] (-> i64)
  (unless (<= node-id 0)
    (match (get (load (load (field (bind-map-box) index))) node-id)
      (None []
            (match (sem-base-bid (semantic-base) node-id)
              (Some [bid] bid)
              (None [] 0)))
      (Some [i]
            (.bid (elem (bind-map-list) i))))))

(defn sym-value [(q (slice u8))] (-> CtVal)
  (CCode (mk-sexp (KSym q) -1 -1)))

;;; ---- answers: the values of the sums a primitive declares ---------------------
;;;
;;; A code operation whose `defprimitive` names a sum, `(-> Resolution)`, answers
;;; with a value of it. The host builds the value with unqualified variant names,
;;; `(answer-value a "ResolvesTo" fields)`, and `answer` qualifies each variant in
;;; the module of the sum its field is declared as, so the compiler spells each
;;; variant once and the declaration decides the rest. A variant or field the
;;; declaration lacks is an internal error: the compiler and coil.primitive disagree.

;;; A variant named NAME with FIELDS, before `answer` qualifies it.
(defn answer-value [(a (dyn Allocator))
                    (name (slice u8))
                    (fields (ArrayList CtVal))] (-> CtVal)
  (let [(mut cells) (ArrayList::new [(ptr CtVal)] a)]
    (for v (iter fields) (push! (mut cells) (new-cell v)))
    (CSum name (box-al a (load cells)))))

(defn answer0 [(a (dyn Allocator)) (name (slice u8))] (-> CtVal)
  (answer-value a name (ArrayList::new [CtVal] a)))

(defn answer1 [(a (dyn Allocator)) (name (slice u8)) (x CtVal)] (-> CtVal)
  (let [(mut fields) (ArrayList::new [CtVal] a)]
    (push! (mut fields) x)
    (answer-value a name (load fields))))

;;; Code operation OP's answer VALUE, qualified and checked against the sum OP's
;;; primitive declares.
(defn answer [(op i64) (value CtVal) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (match (codeop-answer op)
    (None []
          (Err [CtVal Diag]
               (derr (text/format (.a cx)
                                  "internal error: code operation {} answers with a sum, but its defprimitive declares none"
                                  (dec->str (.a cx) op)))))
    (Some [sum] (answer-in sum value cx))))

(defn answer-internal [(a (dyn Allocator)) (sum (slice u8)) (what (slice u8))]
  (-> Diag)
  (derr (text/format a
                     "internal error: an answer of '{}' {}: the compiler and coil.primitive disagree"
                     sum
                     what)))

(defn answer-in [(sum (slice u8)) (value CtVal) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)
        sd (ct-sum-find cx sum)]
    (if (= (primitive/cast i64 sd) 0)
        (Err [CtVal Diag]
             (answer-internal a
                              sum
                              "names a sum this compilation does not have"))
        (match value
          (CSum [name cells]
                (let [qualified
                        (text/format a "{}.{}" (before-last-dot sum) name)
                      variant (answer-variant sd qualified)]
                  (cond (= (primitive/cast i64 variant) 0)
                          (Err [CtVal Diag]
                               (answer-internal a
                                                sum
                                                (text/format a
                                                             "uses the variant '{}' it does not declare"
                                                             name)))
                        (!= (len (load (.fields variant))) (len (load cells)))
                          (Err [CtVal Diag]
                               (answer-internal a
                                                sum
                                                (text/format a
                                                             "gives '{}' the wrong number of fields"
                                                             name)))
                        :else
                          (try (let [(mut out) (ArrayList::new [(ptr CtVal)] a)]
                                 (for [i 0 (len (load cells))]
                                   (let [cell (load (load (elem cells i)))]
                                     (push! (mut out)
                                            (new-cell (match (.ty (elem (.fields variant)
                                                                        i))
                                                        (TCode []
                                                               (if (is-ccode cell)
                                                                   cell
                                                                   (break
                                                                     :try
                                                                       (Err [CtVal
                                                                             Diag]
                                                                            (answer-internal a
                                                                                             sum
                                                                                             (text/format a
                                                                                                          "gives '{}' a field that is not Code"
                                                                                                          name))))))
                                                        (TStruct [inner]
                                                                 (try! (answer-in inner
                                                                                  cell
                                                                                  cx)))
                                                        (_ (break
                                                             :try
                                                               (Err [CtVal Diag]
                                                                    (answer-internal a
                                                                                     sum
                                                                                     (text/format a
                                                                                                  "declares '{}' with a field that is neither Code nor a sum"
                                                                                                  name))))))))))
                                 (Ok (CSum qualified
                                           (box-al a (load out)))))))))
          (_ (Err [CtVal Diag] (answer-internal a sum "is not a variant")))))))

(defn answer-variant [(sd (ptr SumDef)) (qualified (slice u8))]
  (-> (ptr Variant))
  (block :found
    (for [i 0 (len (load (.variants sd)))]
      (when (= (.name (elem (.variants sd) i)) qualified)
        (break :found (elem (.variants sd) i))))
    (primitive/cast (ptr Variant) 0)))

;;; VALUE, an answer of SUM, as Code a compiled metaprogram decodes: the list
;;; `(K FIELD…)`, K the variant's position in SUM's declaration, each Code field as
;;; itself and each sum field encoded the same way. metalower's decoder reads it.
(defn answer->sexp [(sum (slice u8)) (value CtVal) (cx (ptr CtCtx))]
  (-> (Result Sexp Diag))
  (let [a (.a cx)
        sd (ct-sum-find cx sum)]
    (if (= (primitive/cast i64 sd) 0)
        (Err [Sexp Diag]
             (answer-internal a
                              sum
                              "names a sum this compilation does not have"))
        (match value
          (CSum [qualified cells]
                (let [k
                        (block :found
                          (for [i 0 (len (load (.variants sd)))]
                            (when (= (.name (elem (.variants sd) i)) qualified)
                              (break :found i)))
                          -1)]
                  (if (< k 0)
                      (Err [Sexp Diag]
                           (answer-internal a
                                            sum
                                            (text/format a
                                                         "uses the variant '{}' it does not declare"
                                                         qualified)))
                      (try (let [variant (elem (.variants sd) k)
                                 (mut items) (ArrayList::new [Sexp] a)]
                             (push! (mut items) (mk-sexp (KInt k) -1 -1))
                             (for [i 0 (len (load cells))]
                               (let [cell (load (load (elem cells i)))]
                                 (push! (mut items)
                                        (match (.ty (elem (.fields variant) i))
                                          (TStruct [inner]
                                                   (try! (answer->sexp inner
                                                                       cell
                                                                       cx)))
                                          (_ (ccode-of cell))))))
                             (Ok (sx-mklist (box-al a (load items)))))))))
          (_ (Err [Sexp Diag] (answer-internal a sum "is not a variant")))))))

;;; `(primitive/resolve-at NODE NAME)`: what NAME would denote if it were written as
;;; a call head at NODE, a coil.primitive.Resolution. The local half is the
;;; resolver's own scope at NODE (ast.coil, ScopeAtBox); the global half is the
;;; resolver's call-head lookup, so the answer is the one compiling it would give.
(defn cop-resolve-at [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [usage
          "resolve-at: expects (primitive/resolve-at NODE NAME), NAME a symbol"]
    (match (cv-get args 0)
      (None [] (Err [CtVal Diag] (derr usage)))
      (Some [node]
            (match (cv-get args 1)
              (None [] (Err [CtVal Diag] (derr usage)))
              (Some [namec]
                    (if (or (not (is-ccode node))
                            (not (is-ccode namec))
                            (!= (sx-tag (ccode-of namec)) 2))
                        (Err [CtVal Diag] (derr usage))
                        (answer op
                                (resolve-at-answer (.a cx)
                                                   (ccode-of node)
                                                   (sx-sval (ccode-of namec)))
                                cx))))))))

(defn resolve-at-answer [(a (dyn Allocator)) (node Sexp) (name (slice u8))]
  (-> CtVal)
  (let [b (sem-model-box)
        cx (.checker b)]
    (match (scope-at-lookup (source-checked-id (sx-node-id node)
                                               (sx-source node)
                                               (sx-lo node)
                                               (sx-hi node)
                                               (sx-ctxt node)))
      (None [] (answer0 a "ResolutionUnknown"))
      (Some [at]
            (cond (scope-binds? (.tip at) name) (answer0 a "ResolvesLocal")
                  (or (= (primitive/cast i64 (.declarations b)) 0)
                      (= (primitive/cast i64 cx) 0))
                    (answer0 a "ResolutionUnknown")
                  :else
                    (let [m (scope-module-at (.module at))]
                      ; a spelling the parser takes as a primitive is that primitive
                      (match (source-primitive-at m name)
                        (Some [q] (answer1 a "ResolvesTo" (sym-value q)))
                        (None []
                              (try (let [q
                                           (try-or! (resolve-call-head-in a
                                                                          m
                                                                          (.imports b)
                                                                          (.exports b)
                                                                          (.declarations b)
                                                                          name)
                                                    (answer0 a
                                                             "ResolvesNothing"))]
                                     (cond (!= (primitive/cast i64
                                                               (sig-find cx q))
                                               0)
                                             (answer1 a
                                                      "ResolvesTo"
                                                      (sym-value q))
                                           ; A `T::method` head comes back with its qualifier
                                           ; resolved, which names no function: ask for the method.
                                           (and (!= q name)
                                                (none? (find q "::")))
                                             (answer1 a
                                                      "ResolvesTo"
                                                      (sym-value q))
                                           :else
                                             (match (head-trait-method a cx q m)
                                               (None []
                                                     (answer0 a
                                                              "ResolvesNothing"))
                                               (Some [me]
                                                     (answer1 a
                                                              "ResolvesTo"
                                                              (sym-value (text/format a
                                                                                      "{}.{}"
                                                                                      (before-last-dot (.trait me))
                                                                                      (.name me)))))))))))))))))

;;; ---- describing the program to another unit (program_query.coil) ------------
;;;
;;; 96 code-source CODE: the source text of a form.
;;; 98 program-modules: every module of the program.
;;; 99 module-definitions MODULE: MODULE's definitions, qualified.
;;; 100 definition-kind NAME: a coil.primitive.DefinitionKind.
;;; 101 definition-declaration NAME: the form declaring NAME to another unit.
;;; 102 module-header MODULE: `(module M)` and its import and export forms.
;;; 103 module-impls MODULE: its `impl` and `derive` forms.
;;; 104 toolchain: `(toolchain :compiler "<digest>" :target "<arch>-<os>")`.
;;; 111 definition-annotations NAME: a function's or `def`'s `:key value` pairs,
;;;     as one list; empty for a definition that carries none.
;;; 112 definition-source NAME: the form that defines NAME, as written.
;;; 129 definitions-of-kind KIND: every definition definition-kind calls KIND, a
;;;     DefinitionKind variant's name as a symbol.
;;; Names are qualified symbols. A query answers with coil.primitive.ProgramAnswer
;;; (definition-kind with KindAnswer): NotInProgram for something the program does
;;; not define, NoProgram with no compiled program to ask.
(defn program-model [] (-> (Option pq/ProgramModel))
  (let [b (sem-model-box)]
    (if (or (= (.init b) 0) (= (primitive/cast i64 (.prog b)) 0))
        (None [pq/ProgramModel])
        (let [facts (program-facts)]
          (Some (pq/ProgramModel
                  :program (.prog b)
                  :checked_base (.checked_base b)
                  :checker (.checker b)
                  :declarations (.declarations b)
                  :forms (.forms b)
                  :retained (.retained b)
                  :sources (.lst (src-box))
                  :defining (.defining facts)
                  :retained_defining (.retained_defining facts)))))))

;;; Facts about the checked program the queries above look up, each built once for
;;; the program it describes and rebuilt only when that program is a different one
;;; (docs/design/PROGRAM_FACTS.md).
(defstruct ProgramFacts
  [(forms (ptr (ArrayList TaggedForm)))
   (forms_n i64)
   (defining (ptr (HashMap (slice u8) (ptr Sexp))))
   (retained (ptr (ArrayList RetainedForm)))
   (retained_n i64)
   (retained_defining (ptr (HashMap (slice u8) (ptr RetainedForm))))
   ; how many checked uses resolve to each declaration (the resolution map)
   (resolved_n i64)
   (resolved (ptr (HashMap (slice u8) i64)))])

;;; The program facts of the current semantic model, brought up to date.
(defn program-facts [] (-> (ptr ProgramFacts))
  (let [b (sem-model-box)
        facts (field (comptime-unit-state) program_facts)
        a (unit-allocator)
        fs (.forms b)
        fn (if (= (primitive/cast i64 fs) 0) 0 (len (load fs)))
        rs (.retained b)
        rn (if (= (primitive/cast i64 rs) 0) 0 (len (load rs)))
        resolutions (res-map-list)]
    (when (or (= (primitive/cast i64 (.defining facts)) 0)
              (!= (primitive/cast i64 (.forms facts)) (primitive/cast i64 fs))
              (!= (.forms_n facts) fn))
      (set! (.defining facts) (pq/defining-forms-index a fs))
      (set! (.forms facts) fs)
      (set! (.forms_n facts) fn)
      0)
    (when (or (= (primitive/cast i64 (.retained_defining facts)) 0)
              (!= (primitive/cast i64 (.retained facts))
                  (primitive/cast i64 rs))
              (!= (.retained_n facts) rn))
      (set! (.retained_defining facts) (pq/retained-defining-index a rs))
      (set! (.retained facts) rs)
      (set! (.retained_n facts) rn)
      0)
    (when (or (= (primitive/cast i64 (.resolved facts)) 0)
              (!= (.resolved_n facts) (len (load resolutions))))
      (let [counts
              (box! a
                    (HashMap (slice u8) i64)
                    (HashMap::new [(slice u8) i64] a (keyops)))]
        (for e (iter (load resolutions))
          (set! counts
                (.name e)
                (+ 1
                   (match (get (load counts) (.name e))
                     (Some [n] n)
                     (None [] 0)))))
        (set! (.resolved facts) counts)
        (set! (.resolved_n facts) (len (load resolutions))))
      0)
    facts))

(defn sym-list [(a (dyn Allocator)) (names (ArrayList (slice u8)))] (-> Sexp)
  (let [(mut items) (ArrayList::new [Sexp] a)]
    (for n (iter names) (push! (mut items) (mk-sexp (KSym n) -1 -1)))
    (mk-sexp (KList (box-al a (load items))) -1 -1)))

;;; The forms of TEXT, which program_query rendered.
(defn forms-of [(a (dyn Allocator)) (what (slice u8)) (text (slice u8))]
  (-> (Result Sexp Diag))
  (match (read-all a text -1)
    (Err [d]
         (Err [Sexp Diag]
              (derr (text/format a
                                 "{}: internal: rendered source does not read: {}"
                                 what
                                 (.msg d)))))
    (Ok [forms] (Ok [Sexp Diag] (mk-sexp (KList forms) -1 -1)))))

(defn cop-program-query [(op i64)
                         (args (ptr (ArrayList CtVal)))
                         (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (.a cx)
        name-arg
          (match (cv-get args 0)
            (Some [v]
                  (if (and (is-ccode v) (= (sx-tag (ccode-of v)) 2))
                      (Some (sx-sval (ccode-of v)))
                      (None [(slice u8)])))
            (None [] (None [(slice u8)])))]
    (cond (= op 96)
            (match (cv-get args 0)
              (Some [v]
                    (if (is-ccode v)
                        (Ok [CtVal Diag] (CStr (sexp-display a (ccode-of v))))
                        (Err [CtVal Diag]
                             (derr "code-source: expects a Code form"))))
              (None []
                    (Err [CtVal Diag]
                         (derr "code-source: expects (primitive/code-source CODE)"))))
          (= op 104) (Ok [CtVal Diag] (CCode (toolchain-form a)))
          :else
            (match (program-model)
              (None []
                    (answer op
                            (answer0 a
                                     (if (= op 100) "KindNoProgram" "NoProgram"))
                            cx))
              (Some [model0]
                    (let [(mut model) model0]
                      (if (= op 98)
                          (answer op
                                  (answer1 a
                                           "Answer"
                                           (CCode (sym-list a
                                                            (pq/program-modules a
                                                                                (mut model)))))
                                  cx)
                          (match name-arg
                            (None []
                                  (Err [CtVal Diag]
                                       (derr (text/format a
                                                          "{}: expects a qualified symbol"
                                                          (program-query-name op)))))
                            (Some [name]
                                  (try (let [value
                                               (cond (= op 129)
                                                       (answer1 a
                                                                "Answer"
                                                                (CCode (sym-list a
                                                                                 (pq/definitions-of-kind a
                                                                                                         (mut model)
                                                                                                         name))))
                                                     (= op 99)
                                                       (match (pq/module-definitions a
                                                                                     (mut model)
                                                                                     name)
                                                         (None []
                                                               (answer0 a
                                                                        "NotInProgram"))
                                                         (Some [names]
                                                               (answer1 a
                                                                        "Answer"
                                                                        (CCode (sym-list a
                                                                                         names)))))
                                                     (= op 100)
                                                       (match (pq/definition-kind (mut model)
                                                                                  name)
                                                         (None []
                                                               (answer0 a
                                                                        "KindNotInProgram"))
                                                         (Some [k]
                                                               (answer1 a
                                                                        "KindIs"
                                                                        (answer0 a
                                                                                 (definition-kind-variant k)))))
                                                     (= op 101)
                                                       (match (pq/definition-kind (mut model)
                                                                                  name)
                                                         (None []
                                                               (answer0 a
                                                                        "NotInProgram"))
                                                         (Some [_]
                                                               (match (pq/definition-declaration a
                                                                                                 (mut model)
                                                                                                 name)
                                                                 (Err [msg]
                                                                      (break
                                                                        :try
                                                                          (Err [CtVal
                                                                                Diag]
                                                                               (derr (text/format a
                                                                                                  "definition-declaration: {}"
                                                                                                  msg)))))
                                                                 (Ok [text]
                                                                     (answer1 a
                                                                              "Answer"
                                                                              (CCode (get (load (sx-items (try! (forms-of a
                                                                                                                          "definition-declaration"
                                                                                                                          text))))
                                                                                          0)))))))
                                                     (= op 112)
                                                       (match (pq/definition-kind (mut model)
                                                                                  name)
                                                         (None []
                                                               (answer0 a
                                                                        "NotInProgram"))
                                                         (Some [_]
                                                               (match (pq/definition-source a
                                                                                            (mut model)
                                                                                            name)
                                                                 (Err [msg]
                                                                      (break
                                                                        :try
                                                                          (Err [CtVal
                                                                                Diag]
                                                                               (derr (text/format a
                                                                                                  "definition-source: {}"
                                                                                                  msg)))))
                                                                 (Ok [text]
                                                                     (answer1 a
                                                                              "Answer"
                                                                              (CCode (get (load (sx-items (try! (forms-of a
                                                                                                                          "definition-source"
                                                                                                                          text))))
                                                                                          0)))))))
                                                     (= op 111)
                                                       (match (pq/definition-kind (mut model)
                                                                                  name)
                                                         (None []
                                                               (answer0 a
                                                                        "NotInProgram"))
                                                         (Some [_]
                                                               (match (pq/definition-annotations a
                                                                                                 (mut model)
                                                                                                 name)
                                                                 (Err [msg]
                                                                      (break
                                                                        :try
                                                                          (Err [CtVal
                                                                                Diag]
                                                                               (derr (text/format a
                                                                                                  "definition-annotations: {}"
                                                                                                  msg)))))
                                                                 (Ok [text]
                                                                     (answer1 a
                                                                              "Answer"
                                                                              (CCode (try! (forms-of a
                                                                                                     "definition-annotations"
                                                                                                     text))))))))
                                                     (= op 102)
                                                       (answer1 a
                                                                "Answer"
                                                                (CCode (try! (forms-of a
                                                                                       "module-header"
                                                                                       (pq/module-header a
                                                                                                         (mut model)
                                                                                                         name)))))
                                                     :else
                                                       (answer1 a
                                                                "Answer"
                                                                (CCode (try! (forms-of a
                                                                                       "module-impls"
                                                                                       (pq/module-impls a
                                                                                                        (mut model)
                                                                                                        name))))))]
                                         (answer op value cx))))))))))))

;;; K's variant in coil.primitive.DefinitionKind, by name, for its answer.
(defn definition-kind-variant [(k primitive/DefinitionKind)] (-> (slice u8))
  (pq/definition-kind-name k))

(defn program-query-name [(op i64)] (-> (slice u8))
  (cond (= op 99) "module-definitions"
        (= op 100) "definition-kind"
        (= op 129) "definitions-of-kind"
        (= op 101) "definition-declaration"
        (= op 102) "module-header"
        (= op 111) "definition-annotations"
        (= op 112) "definition-source"
        :else "module-impls"))

;;; `(primitive/code-macro-of NODE)`: the macro whose expansion produced NODE. A
;;; node's context names its expansion, and the expansion records the macro.
(defn cop-macro-of [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (match (cv-get args 0)
    (None []
          (Err [CtVal Diag]
               (derr "code-macro-of: expects (primitive/code-macro-of NODE)")))
    (Some [nodev]
          (if (not (is-ccode nodev))
              (Err [CtVal Diag] (derr "code-macro-of: expects a Code node"))
              (let [a (.a cx)
                    ctxt (sx-ctxt (ccode-of nodev))
                    table (.expansions cx)]
                (answer op
                        (cond (= ctxt 0) (answer0 a "Handwritten")
                              (or (= (primitive/cast i64 table) 0)
                                  (> ctxt (len (load table))))
                                (answer0 a "ProvenanceUnknown")
                              :else
                                (let [name (.macro_name (elem table (- ctxt 1)))]
                                  ; A slot the provenance prune freed names nothing.
                                  (if (= (len name) 0)
                                      (answer0 a "ProvenanceUnknown")
                                      (answer1 a "ExpandedBy" (sym-value name)))))
                        cx))))))

;;; `(primitive/code-alias-of NODE)`: the `defalias` the reference NODE resolves
;;; through. The scope is the resolver's own at NODE, as for `resolve-at`, and the
;;; lookup is the one qualification performs.
(defn cop-alias-of [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [usage
          "code-alias-of: expects (primitive/code-alias-of NODE), NODE a symbol or a call"]
    (match (cv-get args 0)
      (None [] (Err [CtVal Diag] (derr usage)))
      (Some [nodev]
            (if (not (is-ccode nodev))
                (Err [CtVal Diag] (derr usage))
                (let [node (ccode-of nodev)
                      spelled
                        (cond (= (sx-tag node) 2) (Some (sx-sval node))
                              (and (= (sx-tag node) 6)
                                   (and (> (sx-len (sx-items node)) 0)
                                        (= (sx-tag (sx-at (sx-items node) 0)) 2)))
                                (Some (sx-sval (sx-at (sx-items node) 0)))
                              :else (None [(slice u8)]))]
                  (match spelled
                    (None [] (Err [CtVal Diag] (derr usage)))
                    (Some [name]
                          (let [b (sem-model-box)
                                a (.a cx)]
                            (answer op
                                    (match (scope-at-lookup (sx-node-id node))
                                      (None [] (answer0 a "AliasUnknown"))
                                      (Some [at]
                                            (cond (scope-binds? (.tip at) name)
                                                    (answer0 a "NoAlias")
                                                  (= (primitive/cast i64
                                                                     (.declarations b))
                                                     0)
                                                    (answer0 a "AliasUnknown")
                                                  :else
                                                    (match (resolve-alias-in a
                                                                             (scope-module-at (.module at))
                                                                             (.imports b)
                                                                             (.exports b)
                                                                             (.declarations b)
                                                                             name)
                                                      (None []
                                                            (answer0 a
                                                                     "NoAlias"))
                                                      (Some [alias]
                                                            (answer1 a
                                                                     "ThroughAlias"
                                                                     (sym-value alias)))))))
                                    cx))))))))))

(defn cop-binding-of [(args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (match (cv-get args 0)
    (Some [v]
          (if (is-ccode v)
              (Ok [CtVal Diag]
                  (CInt (bind-map-lookup (source-checked-node (ccode-of v)))))
              (Err [CtVal Diag] (derr "binding-of: expects a Code node"))))
    (None []
          (Err [CtVal Diag]
               (derr "binding-of: expects (primitive/binding-of NODE)")))))

(defn cop-type-of [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)]
    (match (cv-get args 0)
      (None []
            (Err [CtVal Diag]
                 (derr "type-of: expects (primitive/type-of NODE)")))
      (Some [nodev]
            (if (not (is-ccode nodev))
                (Err [CtVal Diag] (derr "type-of: expects a Code node"))
                (let [node (ccode-of nodev)]
                  (answer op
                          (match (let [id
                                         (source-checked-id (sx-node-id node)
                                                            (sx-source node)
                                                            (sx-lo node)
                                                            (sx-hi node)
                                                            (sx-ctxt node))]
                                   (match (source-context-type id)
                                     (Some [t] (Some t))
                                     (None [] (type-map-lookup id))))
                            (None [] (answer0 a "TypeUnknown"))
                            (Some [t]
                                  (answer1 a
                                           "TypeIs"
                                           (CCode (ty->sexp a (box-type a t))))))
                          cx)))))))

; ── S0/S1: the RESOLUTION MAP — call node id → the callee's fully-qualified name,
; recorded at do-synth once the checker has the resolved ECall. Lets `(primitive/code-decl NODE)`
; on a CALL answer with the EXACT callee (the one resolution actually picked), instead
; of a name-based lookup that goes `:ambiguous` when the simple name lives in >1 module.
(defstruct ResMapEntry [(node-id i64) (name (slice u8))])

(defstruct ResMapBox
  [(init i64)
   (lst (ptr (ArrayList ResMapEntry)))
   (index (ptr (HashMap i64 (slice u8))))])

(defn res-map-box [] (-> (ptr ResMapBox))
  (field (comptime-unit-state) resolutions))

(defn res-map-list [] (-> (ptr (ArrayList ResMapEntry)))
  (let [b (res-map-box)]
    (when (= (.init b) 0)
      (store! (field b lst)
              (box! (unit-allocator)
                    (ArrayList ResMapEntry)
                    (zeroed (ArrayList ResMapEntry))))
      (set! (load (field b lst))
            (ArrayList::new [ResMapEntry] (unit-allocator)))
      (store! (field b index)
              (box! (unit-allocator)
                    (HashMap i64 (slice u8))
                    (HashMap::new [i64 (slice u8)]
                                  (unit-allocator)
                                  (i64-keyops))))
      (set! (.init b) 1)
      0)
    (load (field b lst))))

(defn res-map-reset [] (-> i64)
  (let [_ (res-map-list)
        b (res-map-box)]
    (set! (load (field b lst))
          (ArrayList::new [ResMapEntry] (sem-tables-allocator)))
    (set! (load (field b index))
          (HashMap::new [i64 (slice u8)] (sem-tables-allocator) (i64-keyops)))
    0))

(defn res-map-record [(node-id i64) (name (slice u8))] (-> i64)
  (unless (<= node-id 0)
    (let [(mut e) (zeroed ResMapEntry)]
      (set! (.node-id e) node-id)
      (set! (.name e) name)
      (push! (res-map-list) e)
      (set! (mut (load (field (res-map-box) index))) node-id name)
      0)))

; A check pass knows its function count before synthesis. Reserve the semantic
; side tables once so large generated programs do not repeatedly copy their
; node lists and rehash three maps while walking the AST. Type, binding, and
; resolved-call records have different densities; each estimate is only initial
; capacity and normal growth handles programs with denser expression trees.
(defn semantic-map-capacity [(expected i64)] (-> i64)
  (let [(mut cap) 8]
    (loop (if (>= (* (load cap) 3) (* expected 4))
              (break)
              (set! cap (* (load cap) 2))))
    (load cap)))

(defn semantic-maps-reset-reserved [(type-expected i64)
                                    (binding-expected i64)
                                    (resolved-expected i64)] (-> i64)
  (type-map-reset)
  (bind-map-reset)
  (res-map-reset)
  (semantic-base-set! (sem-no-base))
  (when (> type-expected 0)
    (reserve! (type-map-list) type-expected)
    (grow! (mut (load (field (type-map-box) index)))
           (semantic-map-capacity type-expected)))
  (when (> binding-expected 0)
    (reserve! (bind-map-list) binding-expected)
    (grow! (mut (load (field (bind-map-box) index)))
           (semantic-map-capacity binding-expected)))
  (when (> resolved-expected 0)
    (reserve! (res-map-list) resolved-expected)
    (grow! (mut (load (field (res-map-box) index)))
           (semantic-map-capacity resolved-expected)))
  0)

; ── semantic-map snapshots ────────────────────────────────────────────────────
; check-program resets the S0-S3 maps at entry — right for a real check pass,
; WRONG when a scratch closure check runs while the authoritative maps are
; still being served: lazily staging a metaprogram (stage-one-macro!) checks
; its pruned closure, and without protection that wipes the maps the semantic
; model reads, so type-of / code-decl / binding-of silently go :unknown for
; the rest of the invocation. The resets replace the boxed values without
; freeing the old backing stores, so a value snapshot restores them exactly.
(defstruct SemMapsSnap
  [(tlist (ArrayList TypeMapEntry))
   (tindex (HashMap i64 i64))
   (blist (ArrayList BindMapEntry))
   (bindex (HashMap i64 i64))
   (bnext i64)
   (rlist (ArrayList ResMapEntry))
   (rindex (HashMap i64 (slice u8)))
   ; Borrowed: whoever supplied the base keeps it alive while this snapshot is used.
   (base (ptr SemBase))])

(defn sem-maps-save [(out (ptr SemMapsSnap))] (-> i64)
  (set! (.tlist out) (load (type-map-list)))
  (set! (.tindex out) (load (load (field (type-map-box) index))))
  (set! (.blist out) (load (bind-map-list)))
  (set! (.bindex out) (load (load (field (bind-map-box) index))))
  (set! (.bnext out) (.n (bid-cell)))
  (set! (.rlist out) (load (res-map-list)))
  (set! (.rindex out) (load (load (field (res-map-box) index))))
  (set! (.base out) (semantic-base))
  0)

;;; Read through to the base a snapshot carries. Two different bases cannot both be
;;; read through; a pass that needs entries from a second one takes them with
;;; `sem-maps-inherit-under!` from a snapshot that lists them.
(defn sem-maps-adopt-base! [(snap (ptr SemMapsSnap))] (-> i64)
  (let [theirs (.base snap)
        ours (semantic-base)]
    (cond (= theirs (sem-no-base)) 0
          (= ours (sem-no-base)) (semantic-base-set! theirs)
          (= ours theirs) 0
          :else
            (do
              (ps (stderr)
                  "error: two persistent semantic bases cannot be read through at once (compiler bug)\n")
              (abort)
              0))))

;;; Whether position `i` of a snapshot's history list is the entry that counts for its
;;; node. The index is the live hash the snapshot was copied from, so it can name a
;;; position past the length the snapshot recorded: the node was recorded again after
;;; the snapshot was taken. Then the newest entry the snapshot holds is the last one
;;; listed for that node, and a reader that keeps only `latest == i` would drop the
;;; node altogether. Readers apply entries in list order, so the last such one wins.
(defn sem-snapshot-entry-live? [(latest i64) (i i64) (len i64)] (-> bool)
  (or (= latest i) (>= latest len)))

;;; Seed fresh mutable maps from an immutable retained snapshot. Copy entries,
;;; not container headers: checking a candidate must never mutate its parent.
(defn sem-maps-inherit! [(snap (ptr SemMapsSnap))] (-> i64)
  ; Lists are append-only refinement histories. Only the index-selected value
  ; for each node is live; inheriting the history duplicates old compiler work
  ; in every accepted revision even when no old body is checked again.
  (for [i 0 (len (.tlist snap))]
    (let [e (elem (field snap tlist) i)]
      (match (get (.tindex snap) (.node-id e))
        (Some [latest]
              (when (sem-snapshot-entry-live? latest i (len (.tlist snap)))
                (match (get (load (load (field (type-map-box) index)))
                            (.node-id e))
                  (Some [at] (set! (.ty (elem (type-map-list) at)) (.ty e)) 0)
                  (None [] (type-map-record (.node-id e) (.ty e))))
                0))
        (None [] 0))))
  (for [i 0 (len (.blist snap))]
    (let [e (elem (field snap blist) i)]
      (match (get (.bindex snap) (.node-id e))
        (Some [latest]
              (when (sem-snapshot-entry-live? latest i (len (.blist snap)))
                (match (get (load (load (field (bind-map-box) index)))
                            (.node-id e))
                  (Some [at] (set! (.bid (elem (bind-map-list) at)) (.bid e)) 0)
                  (None [] (bind-map-record (.node-id e) (.bid e))))
                0))
        (None [] 0))))
  ; The resolution index stores values directly, rather than list positions.
  (for [i 0 (.cap (field snap rindex))]
    (let [entry (index (.slots (field snap rindex)) i)]
      (when (= (.state entry) 1)
        (res-map-record (.key entry) (.val entry))
        0)))
  (when (> (.bnext snap) (.n (bid-cell)))
    (set! (.n (bid-cell)) (.bnext snap))
    0)
  (sem-maps-adopt-base! snap)
  0)

(defn sem-known-node-id? [(node-id i64)] (-> bool)
  (or (contains? (load (load (field (type-map-box) index))) node-id)
      (contains? (load (load (field (bind-map-box) index))) node-id)
      (contains? (load (load (field (res-map-box) index))) node-id)
      (sem-base-has? (semantic-base) node-id)))

;;; Take a snapshot's listed entries at LOWER priority than everything already
;;; known, the base included: an entry is recorded only for a node nothing here
;;; has an entry for. Its base is not read through.
(defn sem-maps-inherit-under! [(snap (ptr SemMapsSnap))] (-> i64)
  (for [i 0 (len (.tlist snap))]
    (let [e (elem (field snap tlist) i)]
      (when (and (sem-snapshot-entry-live? (match (get (.tindex snap)
                                                       (.node-id e))
                                             (Some [latest] latest)
                                             (None [] -1))
                                           i
                                           (len (.tlist snap)))
                 (not (sem-known-node-id? (.node-id e))))
        (type-map-record (.node-id e) (.ty e))
        0)))
  (for [i 0 (len (.blist snap))]
    (let [e (elem (field snap blist) i)]
      (when (and (sem-snapshot-entry-live? (match (get (.bindex snap)
                                                       (.node-id e))
                                             (Some [latest] latest)
                                             (None [] -1))
                                           i
                                           (len (.blist snap)))
                 (not (contains? (load (load (field (bind-map-box) index)))
                                 (.node-id e))))
        (match (sem-base-bid (semantic-base) (.node-id e))
          (Some [_] 0)
          (None [] (bind-map-record (.node-id e) (.bid e))))
        0)))
  (for [i 0 (.cap (field snap rindex))]
    (let [entry (index (.slots (field snap rindex)) i)]
      (when (and (= (.state entry) 1)
                 (not (contains? (load (load (field (res-map-box) index)))
                                 (.key entry))))
        (match (sem-base-name (semantic-base) (.key entry))
          (Some [_] 0)
          (None [] (res-map-record (.key entry) (.val entry))))
        0)))
  (when (> (.bnext snap) (.n (bid-cell)))
    (set! (.n (bid-cell)) (.bnext snap))
    0)
  0)

(defn sem-maps-restore [(snap (ptr SemMapsSnap))] (-> i64)
  (set! (type-map-list) (.tlist snap))
  (set! (load (field (type-map-box) index)) (.tindex snap))
  (set! (bind-map-list) (.blist snap))
  (set! (load (field (bind-map-box) index)) (.bindex snap))
  (set! (.n (bid-cell)) (.bnext snap))
  (set! (res-map-list) (.rlist snap))
  (set! (load (field (res-map-box) index)) (.rindex snap))
  (semantic-base-set! (.base snap))
  0)

(defn res-map-lookup [(node-id i64)] (-> (slice u8))
  (if (<= node-id 0)
      ""
      (match (get (load (load (field (res-map-box) index))) node-id)
        (Some [name] name)
        (None []
              (match (sem-base-name (semantic-base) node-id)
                (Some [name] name)
                (None [] ""))))))

; The module part of a fully-qualified name `mod.simple` → "mod" (before last dot), else "".
(defn qual-module-of [(name (slice u8))] (-> (slice u8))
  (let [n (len name)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) 0)
              (break)
              (do
                (when (= (primitive/cast i64 (get name (load i)))
                         46)
                  (set! at (load i))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (if (< (load at) 0)
        ""
        (subslice [u8] name 0 (load at)))))

; The simple (module-stripped, alias-stripped) name a query symbol refers to.
(defn decl-simple-name [(q (slice u8))] (-> (slice u8))
  (let [sl (find-slash q)]
    (after-last-dot (if (>= sl 0)
                        (subslice [u8] q (primitive/iadd sl 1) (len q))
                        q))))

; If the query was module-qualified (`mod.name`, no alias slash), the module part.
(defn decl-qual-module [(q (slice u8))] (-> (slice u8))
  (if (>= (find-slash q) 0) "" (qual-module-of q)))

; Does an authoritative qualified name match the queried simple name (+ optional module)?
(defn cp-name-match [(qname (slice u8))
                     (simple (slice u8))
                     (wantmod (slice u8))] (-> bool)
  (and (= (after-last-dot qname) simple)
       (or (= (len wantmod) 0)
           (= (qual-module-of qname) wantmod))))

; The symbol a Code node names: a bare symbol is itself; a call/list uses its head.
(defn decl-node-name [(a (dyn Allocator)) (node Sexp)] (-> (slice u8))
  (if (= (sx-tag node) 2)
      (lexical-name a node)
      (if (= (sx-tag node) 6)
          (let [it (sx-items node)]
            (if (>= (sx-len it) 1)
                (let [h (sx-at it 0)]
                  (if (= (sx-tag h) 2) (lexical-name a h) ""))
                ""))
          "")))

; Reconstruct a Type as Code (the inverse of parse-type); mirrors ty-str's spelling.
(defn ty-list2 [(a (dyn Allocator)) (head (slice u8)) (x Sexp)] (-> Sexp)
  (let [(mut it) (ArrayList::new [Sexp] a)]
    (push! (mut it) (sx-sym head))
    (push! (mut it) x)
    (mk-sexp (KList (box-al a (load it))) -1 -1)))

(defn ty-list3 [(a (dyn Allocator)) (head (slice u8)) (x Sexp) (y Sexp)]
  (-> Sexp)
  (let [(mut it) (ArrayList::new [Sexp] a)]
    (push! (mut it) (sx-sym head))
    (push! (mut it) x)
    (push! (mut it) y)
    (mk-sexp (KList (box-al a (load it))) -1 -1)))

(defn ty-app-sexp [(a (dyn Allocator)) (t (ptr Type))] (-> Sexp)
  (let [(mut it) (ArrayList::new [Sexp] a)
        args (t-fn-params t)
        n (len (load args))]
    (push! (mut it) (sx-sym (t-app-name t)))
    (for [i 0 n]
      (push! (mut it) (ty->sexp a (elem args i))))
    (mk-sexp (KList (box-al a (load it))) -1 -1)))

(defn ty-fn-sexp [(a (dyn Allocator)) (t (ptr Type))] (-> Sexp)
  (let [(mut it) (ArrayList::new [Sexp] a)
        ps (t-fn-params t)
        n (len (load ps))
        (mut pv) (ArrayList::new [Sexp] a)]
    (push! (mut it) (sx-sym "fnptr"))
    (push! (mut it) (sx-sym (t-fn-cc t)))
    (for [i 0 n]
      (push! (mut pv) (ty->sexp a (elem ps i))))
    (push! (mut it) (mk-sexp (KVec (box-al a (load pv))) -1 -1))
    (push! (mut it) (ty->sexp a (t-fn-ret t)))
    (mk-sexp (KList (box-al a (load it))) -1 -1)))

(defn ty->sexp [(a (dyn Allocator)) (t (ptr Type))] (-> Sexp)
  (let [tg (type-tag t)]
    (cond (= tg 0)
            (sx-sym (sconcat a
                             (if (t-int-signed t) "i" "u")
                             (i64->str a (t-int-bits t))))
          (= tg 1) (sx-sym (text/format a "f{}" (i64->str a (t-int-bits t))))
          (= tg 2) (sx-sym "bool")
          (= tg 3) (sx-sym "void")
          (= tg 4) (ty-list2 a "ptr" (ty->sexp a (t-inner t)))
          (= tg 5)
            (ty-list2 a (if (t-ref-mut t) "mut" "ref") (ty->sexp a (t-inner t)))
          (= tg 6) (sx-sym (type-struct-name t))
          (= tg 7)
            (ty-list3 a
                      "array"
                      (ty->sexp a (t-inner t))
                      (match (array-extent-of-type t)
                        (FixedExtent [n] (sx-mkint n))
                        (ParamExtent [name] (sx-sym name))))
          (= tg 8) (ty-list2 a "slice" (ty->sexp a (t-inner t)))
          (= tg 9)
            (ty-list3 a
                      "vec"
                      (ty->sexp a (t-inner t))
                      (match (vector-width-of-type t)
                        (FixedExtent [n] (sx-mkint n))
                        (ParamExtent [name] (sx-sym name))))
          (= tg 16)
            (match (load t)
              (TConst [v] (ty-list2 a "const" (const-value-sexp v)))
              (_ (sx-sym "?")))
          (= tg 12) (sx-sym "!")
          (= tg 13) (sx-sym "code")
          (= tg 14) (sx-sym "externref")
          (= tg 15) (sx-sym "codebuilder")
          (= tg 11) (ty-app-sexp a t)
          (= tg 10) (ty-fn-sexp a t)
          :else (sx-sym "?"))))

; The params-vector `[T…]` of a function's signature, as Code.
(defn fn-params-vec [(a (dyn Allocator)) (fp (ptr Func))] (-> Sexp)
  (let [ps (load (field fp params))
        n (len (load ps))
        (mut items) (ArrayList::new [Sexp] a)]
    (for [i 0 n]
      (push! (mut items)
             (ty->sexp a (field (elem ps i) ty))))
    (mk-sexp (KVec (box-al a (load items))) -1 -1)))

;;; What `code-decl` answers a node resolved to: the module that declares it, its
;;; kind, its exact qualified name, and for a function or method its signature.
;;; Canonical identity is the name the checker resolved, so semantic tools never
;;; reconstruct a binding from its authored spelling. `code-decl` answers it as
;;; coil.primitive.DeclAnswer's `(Declared MODULE KIND NAME SIGNATURE)`.
(defstruct DeclRecord
  [(module (slice u8))
   (kind primitive/DeclKind)
   (name (slice u8))
   (signature Sexp)])

(defn decl-record [(a (dyn Allocator))
                   (module (slice u8))
                   (kind primitive/DeclKind)
                   (name (slice u8))
                   (signature (ArrayList Sexp))] (-> DeclRecord)
  (DeclRecord
    :module module
    :kind kind
    :name name
    :signature (mk-sexp (KList (box-al a signature)) -1 -1)))

;;; A function's signature: `([PARAM-TYPE…] RET)`.
(defn fn-decl-record [(a (dyn Allocator)) (fp (ptr Func))] (-> DeclRecord)
  (let [(mut items) (ArrayList::new [Sexp] a)]
    (push! (mut items) (fn-params-vec a fp))
    (push! (mut items) (ty->sexp a (field fp ret)))
    (decl-record a
                 (qual-module-of (.name fp))
                 (primitive/FunctionDecl)
                 (.name fp)
                 (load items))))

;;; A struct, sum, trait, const or extern: no signature.
(defn kind-decl-record [(a (dyn Allocator))
                        (module (slice u8))
                        (kind primitive/DeclKind)
                        (qname (slice u8))] (-> DeclRecord)
  (decl-record a module kind qname (ArrayList::new [Sexp] a)))

; Dedicated AST primitives are not Program functions. Give their checked source
; nodes a declaration record so semantic tools need not trust surface spelling.
(defn primitive-decl-record [(a (dyn Allocator)) (qualified (slice u8))]
  (-> DeclRecord)
  (decl-record a
               (before-last-dot qualified)
               (primitive/PrimitiveDecl)
               qualified
               (ArrayList::new [Sexp] a)))

; A variant construction names the exact qualified variant the checker selected,
; in the module of the sum that owns it.
(defn variant-decl-record [(a (dyn Allocator))
                           (sumq (slice u8))
                           (variantq (slice u8))] (-> DeclRecord)
  (decl-record a
               (qual-module-of sumq)
               (primitive/VariantDecl)
               variantq
               (ArrayList::new [Sexp] a)))

;;; K's variant in coil.primitive.DeclKind, by name, for its answer.
(defn decl-kind-variant [(k primitive/DeclKind)] (-> (slice u8))
  (match k
    (primitive/FunctionDecl [] "FunctionDecl")
    (primitive/MethodDecl [] "MethodDecl")
    (primitive/StructDecl [] "StructDecl")
    (primitive/SumDecl [] "SumDecl")
    (primitive/VariantDecl [] "VariantDecl")
    (primitive/TraitDecl [] "TraitDecl")
    (primitive/ConstDecl [] "ConstDecl")
    (primitive/ExternDecl [] "ExternDecl")
    (primitive/PrimitiveDecl [] "PrimitiveDecl")))

(defn decl-answer [(a (dyn Allocator)) (r DeclRecord)] (-> CtVal)
  (let [(mut fields) (ArrayList::new [CtVal] a)]
    (push! (mut fields) (sym-value (.module r)))
    (push! (mut fields) (answer0 a (decl-kind-variant (.kind r))))
    (push! (mut fields) (sym-value (.name r)))
    (push! (mut fields) (CCode (.signature r)))
    (answer-value a "Declared" (load fields))))

; Search the checked Program for a FUNCTION by simple name (+ optional module).
; status 0 found (fn set), 1 none, 2 ambiguous.
(defstruct CpFn [(status i64) (fn (ptr Func))])

(defn declaration-index-add! [(index (mut (HashMap (slice u8) i64)))
                              (name (slice u8))
                              (position i64)] (-> i64)
  (let [next
          (match (get index name)
            (None [] position)
            (Some [first] (if (< first 0) first (- (- 0 first) 1))))]
    (set! (mut index) name next)
    0))

(defn function-decl-index [(p (ptr Program))] (-> (ptr FunctionDeclIndex))
  (let [b (field (comptime-unit-state) function_decls)
        fs (load (field p funcs))]
    (when (or (= (.init b) 0) (!= (.program b) p) (!= (.count b) (len fs)))
      (let [a (sem-maps-allocator)]
        (init-fields! b
                      (HashMap::new [(slice u8) i64] a (keyops-borrowed))
                      [exact simple qualified])
        (for [i 0 (len fs)]
          (let [name (.name (elem fs i))
                simple (after-last-dot name)]
            (unless (contains? (.exact b) name)
              (set! (mut (.exact b)) name i)
              0)
            (declaration-index-add! (mut (.qualified b)) name i)
            (declaration-index-add! (mut (.simple b)) simple i)))
        (set! (.program b) p)
        (set! (.count b) (len fs))
        (set! (.init b) 1))
      0)
    b))

(defn cp-find-fn [(p (ptr Program)) (simple (slice u8)) (wantmod (slice u8))]
  (-> CpFn)
  (let [b (function-decl-index p)
        (mut r) (zeroed CpFn)
        found
          (if (= (len wantmod) 0)
              (get (.simple b) simple)
              (get (.qualified b)
                   (sconcat (unit-allocator)
                            (text/format (unit-allocator) "{}." wantmod)
                            simple)))]
    (set! (.fn r) (primitive/cast (ptr Func) 0))
    (set! (.status r) 1)
    (match found
      (Some [i]
            (let [position (if (< i 0) (- (- 0 i) 1) i)]
              (set! (.fn r) (elem (.funcs p) position))
              (set! (.status r) (if (< i 0) 2 0))))
      (None [] 0))
    r))

; Find a function by its EXACT fully-qualified name (what resolution recorded).
(defn cp-find-fn-exact [(p (ptr Program)) (qname (slice u8))] (-> (ptr Func))
  (match (get (.exact (function-decl-index p)) qname)
    (Some [i] (elem (.funcs p) i))
    (None [] (primitive/cast (ptr Func) 0))))

; The qualified name of the SUM that owns a variant whose qualified name is `qname`,
; or "" if none. (Variant constructions resolve their ECall.func to the variant.)
(defn cp-sum-of-variant [(p (ptr Program)) (qname (slice u8))] (-> (slice u8))
  (let [sums (load (field p sums))
        n (len sums)
        (mut i) 0
        (mut r) ""]
    (loop (if (or (> (len (load r)) 0) (>= (load i) n))
              (break)
              (do
                (let [sd (elem sums (load i))
                      vs (load (field sd variants))
                      nv (len vs)
                      (mut j) 0]
                  (loop (if (>= (load j) nv)
                            (break)
                            (do
                              (when (= (.name (elem vs
                                                    (load j)))
                                       qname)
                                (set! r (.name sd))
                                (break))
                              (set! j (primitive/iadd (load j) 1))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; A resolved decl: found=false → not in cp (caller falls back to name-based lookup).
(defstruct CpDecl [(found bool) (rec DeclRecord)])

;;; The checker resolves a call that dispatches to an impl method -- inherent or
;;; trait -- to that method's own function name, and an impl's methods are not in the
;;; program's function list, so a lookup there finds nothing and the call used to be
;;; reported `:unresolved` although the checker had chosen exactly one method. This
;;; indexes every impl method of `p` under that name.
(defn method-decl-index [(p (ptr Program))] (-> (ptr (HashMap (slice u8) i64)))
  (let [b (field (comptime-unit-state) method_decls)
        ; an index of one model, kept with the model's other side tables
        a (sem-maps-allocator)]
    (unless (and (= (.init b) 1) (= (.prog b) p))
      (let [(mut idx) (HashMap::new [(slice u8) i64] a (keyops))
            is (load (field p impls))]
        (for [i 0 (len (load is))]
          (let [im (elem is i)
                ms (load (field im methods))]
            (for [j 0 (len (load ms))]
              (let [mname (.name (elem ms j))
                    resolved
                      (if (impl-is-trait im)
                          (tmfn a
                                (impl-trait-name im)
                                (impl-mangle-key a
                                                 (field im self_type)
                                                 (.type_params im))
                                mname)
                          (inherent-fn-name a im mname))]
                ; The first impl to claim a name keeps it; a second would be a
                ; duplicate impl, which the checker has already refused.
                (unless (contains? (load idx) resolved)
                  (set! (mut idx)
                        resolved
                        (primitive/iadd (primitive/imul i 65536) j))
                  0)))))
        ; A call through a type parameter reaches the trait's declaration, no impl
        ; having been chosen. The checker records it under this key.
        (for [t 0 (len (load (.traits p)))]
          (let [td (elem (.traits p) t)]
            (for [j 0 (len (load (.methods td)))]
              (set! (mut idx)
                    (tmfn a
                          (.name td)
                          (trait-self-key)
                          (.name (elem (.methods td) j)))
                    (primitive/isub (primitive/isub 0
                                                    (primitive/iadd (primitive/imul t
                                                                                    65536)
                                                                    j))
                                    1)))))
        (set! (.index b) (box! a (HashMap (slice u8) i64) (load idx)))
        (set! (.prog b) p)
        (set! (.init b) 1)
        0))
    (.index b)))

;;; A method's signature: `([PARAM-TYPE…] RET OWNER-TYPE [TRAIT])`.
;;;
;;; It begins exactly like a function's signature, so a tool that treats calls
;;; uniformly can ignore the difference. MODULE is
;;; the module that declares the type the impl is for, `coil.arraylist` for an impl
;;; on `(ArrayList T)`, which is where a selector like `myapp.jobs/*` expects to find
;;; the type's methods; it is empty for a type no module declares (`i64`,
;;; `(ptr T)`). QUALIFIED-NAME is that module and the method's own name. OWNER-TYPE is the type the selected impl is for; TRAIT
;;; is present only for a trait method and names the trait, so the pair identifies
;;; the impl the checker chose.
(defn method-decl-record [(a (dyn Allocator))
                          (im (ptr ImplDef))
                          (fp (ptr Func))] (-> DeclRecord)
  (let [(mut items) (ArrayList::new [Sexp] a)
        ; From the type's declared name, not its printed form: `(coil.arraylist.ArrayList
        ; T)` printed and cut at its last dot gave the module `(coil.arraylist`.
        module (qual-module-of (impl-base-name a (field im self_type)))]
    (push! (mut items) (fn-params-vec a fp))
    (push! (mut items) (ty->sexp a (field fp ret)))
    (push! (mut items) (ty->sexp a (field im self_type)))
    (when (impl-is-trait im)
      (push! (mut items) (sx-sym (impl-trait-name im)))
      0)
    (decl-record a
                 module
                 (primitive/MethodDecl)
                 (if (= (len module) 0)
                     (decl-simple-name (.name fp))
                     (text/format a
                                  "{}.{}"
                                  module
                                  (decl-simple-name (.name fp))))
                 (load items))))

;;; The same record for a call whose receiver is a type parameter: the trait's own
;;; declaration, with the trait's Self parameter where the owning type would be,
;;; since which type that is depends on how the enclosing function is specialised.
(defn trait-method-decl-record [(a (dyn Allocator))
                                (td (ptr TraitDef))
                                (tm (ptr TraitMethod))] (-> DeclRecord)
  (let [(mut items) (ArrayList::new [Sexp] a)
        (mut params) (ArrayList::new [Sexp] a)
        module (qual-module-of (.name td))]
    (for [i 0 (len (load (.params tm)))]
      (push! (mut params)
             (ty->sexp a (field (elem (load (field tm params)) i) ty))))
    (push! (mut items) (mk-sexp (KVec (box-al a (load params))) -1 -1))
    (push! (mut items) (ty->sexp a (field tm ret)))
    (push! (mut items) (sx-sym (.self_param td)))
    (push! (mut items) (sx-sym (.name td)))
    (decl-record a
                 module
                 (primitive/MethodDecl)
                 (if (= (len module) 0)
                     (decl-simple-name (.name tm))
                     (text/format a
                                  "{}.{}"
                                  module
                                  (decl-simple-name (.name tm))))
                 (load items))))

; Exact variant reflection is a common semantic-checker query. Index it once per
; semantic model; repeatedly walking every sum for each constructor made a generic
; Code traversal quadratic in the size of the checked program.
(defstruct VariantOwnerBox
  [(init i64) (index (ptr (HashMap (slice u8) (slice u8))))])

(defn variant-owner-box [] (-> (ptr VariantOwnerBox))
  (field (comptime-unit-state) variant_owners))

(defn variant-owner-build! [(p (ptr Program))] (-> i64)
  (let [b (variant-owner-box)
        a (unit-allocator)
        (mut idx) (HashMap::new [(slice u8) (slice u8)] a (keyops))]
    (set! (.init b) 1)
    (unless (= (primitive/cast i64 p) 0)
      (let [sums (load (field p sums))
            n (len sums)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [sd (elem sums (load i))
                          vs (load (field sd variants))
                          nv (len vs)
                          (mut j) 0]
                      (loop (if (>= (load j) nv)
                                (break)
                                (do
                                  (set! (mut idx)
                                        (.name (elem vs
                                                     (load j)))
                                        (.name sd))
                                  (set! j (primitive/iadd (load j) 1))))))
                    (set! i (primitive/iadd (load i) 1)))))))
    (store! (field b index) (box! a (HashMap (slice u8) (slice u8)) (load idx)))
    0))

(defn variant-owner [(qname (slice u8))] (-> (slice u8))
  (let [b (variant-owner-box)]
    (if (= (.init b) 0)
        ""
        (match (get (load (load (field b index))) qname)
          (Some [sumq] sumq)
          (None [] "")))))

; Build the decl record for the entity whose EXACT qualified name resolution recorded.
; Searches functions, then struct/sum/trait/const/extern, then sum variants.
(defn cp-find-exact-decl [(a (dyn Allocator))
                          (p (ptr Program))
                          (qname (slice u8))] (-> CpDecl)
  (let [(mut r) (zeroed CpDecl)
        sumq (variant-owner qname)
        ; A checked program also lists each impl method as a function under its
        ; resolved name. Asked for as a method first, so that it is reported as the
        ; method it is, with its type and trait, not as a function of that name.
        fn
          (if (or (> (len sumq) 0)
                  (contains? (load (method-decl-index p)) qname))
              (primitive/cast (ptr Func) 0)
              (cp-find-fn-exact p qname))]
    (set! (.found r) false)
    (if (> (len sumq) 0)
        (do
          (set! (.found r) true)
          (set! (.rec r) (variant-decl-record a sumq qname))
          0)
        (if (!= (primitive/cast i64 fn) 0)
            (do (set! (.found r) true) (set! (.rec r) (fn-decl-record a fn)) 0)
            (if (contains? (load (method-decl-index p)) qname)
                (let [at
                        (match (get (load (method-decl-index p)) qname)
                          (Some [v] v)
                          (None [] 0))]
                  (set! (.found r) true)
                  (set! (.rec r)
                        (if (>= at 0)
                            (let [im
                                    (elem (load (field p impls))
                                          (/ at 65536))]
                              (method-decl-record a
                                                  im
                                                  (elem (load (field im methods))
                                                        (% at 65536))))
                            (let [code (primitive/isub (primitive/isub 0 at) 1)
                                  td
                                    (elem (load (field p traits))
                                          (/ code 65536))]
                              (trait-method-decl-record a
                                                        td
                                                        (elem (load (field td
                                                                           methods))
                                                              (% code 65536))))))
                  0)
                (let [kinds (kind-decl-index p)]
                  (match (get (.exact kinds) qname)
                    (Some [i]
                          (let [e (elem (.items kinds) i)]
                            (set! (.found r) true)
                            (set! (.rec r)
                                  (kind-decl-record a
                                                    (qual-module-of qname)
                                                    (.kind e)
                                                    qname))
                            0))
                    (None [] 0))
                  (unless (.found r)
                    (let [sq (cp-sum-of-variant p qname)]
                      ; variant construction → its sum
                      (when (> (len sq) 0)
                        (set! (.found r) true)
                        (set! (.rec r) (variant-decl-record a sq qname))
                        0)))))))
    r))

; A (qualified-name, kind) pair, for the non-function declaration kinds.
(defstruct NamedKind [(name (slice u8)) (kind primitive/DeclKind)])

(defn nk-push [(dst (ptr (ArrayList NamedKind)))
               (name (slice u8))
               (kind primitive/DeclKind)] (-> i64)
  (let [(mut e) (zeroed NamedKind)]
    (set! (.name e) name)
    (set! (.kind e) kind)
    (push! dst e)
    0))

; Collect every struct/sum/trait/const/extern as a (qualified-name, kind) pair.
; Kind records also belong to a publication: repeated negative code-decl
; queries must not allocate and rescan all type/constant/extern declarations.
(defn kind-decl-index [(p (ptr Program))] (-> (ptr KindDeclIndex))
  (let [b (field (comptime-unit-state) kind_decls)]
    (when (or (= (.init b) 0) (!= (.program b) p))
      (let [a (sem-maps-allocator)
            items (cp-kind-decls-build a p)]
        (set! (.items b) items)
        (set! (.exact b) (HashMap::new [(slice u8) i64] a (keyops-borrowed)))
        (for [i 0 (len (load items))]
          (let [name (.name (elem items i))]
            (unless (contains? (.exact b) name)
              (set! (mut (.exact b)) name i)
              0)))
        (set! (.program b) p)
        (set! (.init b) 1))
      0)
    b))

(defn cp-kind-decls [(a (dyn Allocator)) (p (ptr Program))]
  (-> (ptr (ArrayList NamedKind)))
  (.items (kind-decl-index p)))

(defn cp-kind-decls-build [(a (dyn Allocator)) (p (ptr Program))]
  (-> (ptr (ArrayList NamedKind)))
  (let [(mut out) (ArrayList::new [NamedKind] a)
        ss (load (field p structs))
        sums (load (field p sums))
        tr (load (field p traits))
        cs (load (field p consts))
        ex (load (field p externs))
        (mut i) 0]
    (set! i 0)
    (loop (if (>= (load i) (len ss))
              (break)
              (do
                (nk-push (mut out)
                         (.name (elem ss (load i)))
                         (primitive/StructDecl))
                (set! i (primitive/iadd (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (len sums))
              (break)
              (do
                (nk-push (mut out)
                         (.name (elem sums (load i)))
                         (primitive/SumDecl))
                (set! i (primitive/iadd (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (len tr))
              (break)
              (do
                (nk-push (mut out)
                         (.name (elem tr (load i)))
                         (primitive/TraitDecl))
                (set! i (primitive/iadd (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (len cs))
              (break)
              (do
                (nk-push (mut out)
                         (.name (elem cs (load i)))
                         (primitive/ConstDecl))
                (set! i (primitive/iadd (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) (len ex))
              (break)
              (do
                (nk-push (mut out)
                         (.name (elem ex (load i)))
                         (primitive/ExternDecl))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al a (load out))))

(defn cop-dependencies [(op i64)
                        (args (ptr (ArrayList CtVal)))
                        (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (if (!= (len (load args)) 1)
      (Err [CtVal Diag]
           (derr "dependency query: expects one Code declaration reference"))
      (match (cv-get args 0)
        (None []
              (Err [CtVal Diag]
                   (derr "dependency query: expects a Code declaration reference")))
        (Some [value]
              (if (not (is-ccode value))
                  (Err [CtVal Diag]
                       (derr "dependency query: expects a Code declaration reference"))
                  (let [p (sem-model)]
                    (if (= (primitive/cast i64 p) 0)
                        (answer op (answer0 (.a cx) "NoProgram") cx)
                        (let [state (comptime-unit-state)]
                          (when (= (primitive/cast i64
                                                   (.dependency_graph state))
                                   0)
                            (set! (.dependency_graph state)
                                  (dependencies/build (unit-allocator)
                                                      p
                                                      (.checked_base (sem-model-box))
                                                      (.dependency_base (sem-model-box))))
                            0)
                          (let [node (ccode-of value)
                                raw
                                  (scoped-ident-raw (decl-node-name (.a cx)
                                                                    node))
                                resolved
                                  (res-map-lookup (source-checked-node node))
                                module (src-mod-lookup (sx-source node))
                                value-name (value-res-lookup module raw)
                                type-name (type-res-lookup module raw)
                                name
                                  (cond (dependencies/known? (.dependency_graph state)
                                                             raw)
                                          raw
                                        (> (len resolved) 0) resolved
                                        (> (len value-name) 0) value-name
                                        (> (len type-name) 0) type-name
                                        :else raw)]
                            (answer op
                                    (match (dependencies/query (.a cx)
                                                               (.dependency_graph state)
                                                               name
                                                               (or (= op 88)
                                                                   (= op 90))
                                                               (>= op 89))
                                      (Some [names]
                                            (answer1 (.a cx)
                                                     "Answer"
                                                     (CCode names)))
                                      (None [] (answer0 (.a cx) "NotInProgram")))
                                    cx))))))))))

;;; `(primitive/code-module-uses MODULE)`: the declarations MODULE uses outside
;;; its own declarations, sorted (dependencies/module-uses).
(defn cop-module-uses [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (match (cv-get args 0)
    (Some [value]
          (if (and (is-ccode value)
                   (= (sx-tag (ccode-of value)) 2)
                   (= (len (load args)) 1))
              (let [p (sem-model)]
                (if (= (primitive/cast i64 p) 0)
                    (answer op (answer0 (.a cx) "NoProgram") cx)
                    (let [state (comptime-unit-state)
                          module (sx-sval (ccode-of value))]
                      (when (= (primitive/cast i64 (.dependency_graph state)) 0)
                        (set! (.dependency_graph state)
                              (dependencies/build (unit-allocator)
                                                  p
                                                  (.checked_base (sem-model-box))
                                                  (.dependency_base (sem-model-box))))
                        0)
                      (answer op
                              (if (or (= (primitive/cast i64
                                                         (.declarations (sem-model-box)))
                                         0)
                                      (= (primitive/cast i64
                                                         (table-find (.declarations (sem-model-box))
                                                                     module))
                                         0))
                                  (answer0 (.a cx) "NotInProgram")
                                  (answer1 (.a cx)
                                           "Answer"
                                           (CCode (dependencies/module-uses (.a cx)
                                                                            (.dependency_graph state)
                                                                            p
                                                                            module))))
                              cx))))
              (Err [CtVal Diag]
                   (derr "code-module-uses: expects one module name, a Code symbol"))))
    (None []
          (Err [CtVal Diag]
               (derr "code-module-uses: expects one module name, a Code symbol")))))

(defn cop-decl [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)
        p (sem-model)]
    (match (cv-get args 0)
      (None []
            (Err [CtVal Diag]
                 (derr "code-decl: expects (primitive/code-decl NODE)")))
      (Some [nodev]
            (if (not (is-ccode nodev))
                (Err [CtVal Diag] (derr "code-decl: expects a Code node"))
                (if (= (primitive/cast i64 p) 0)
                    (answer op (answer0 a "DeclUnresolved") cx)
                    ; EXACT path first: if this node is a reference the checker resolved — an
                    ; expression ref (call, fn-ptr, variant) via its node id, or a TYPE ref via
                    ; its (module, raw-name) → use the recorded qualified name. No ambiguity,
                    ; cross-module correct.
                    ; A list the checker recorded no resolution for is not a
                    ; reference by its head's spelling: `(open bool)` in a field
                    ; or parameter list is a binding, not a call of `open`. Only
                    ; a type application such as `(ArrayList T)` answers through
                    ; its head, which resolves in its module as a type; the
                    ; value and by-name lookups are for bare symbols.
                    (let [node (ccode-of nodev)
                          is-list (= (sx-tag node) 6)
                          rq0 (res-map-lookup (source-checked-node node))
                          source-module (src-mod-lookup (sx-source node))
                          raw-name (decl-node-name a node)
                          value-rq
                            (if is-list
                                ""
                                (value-res-lookup source-module raw-name))
                          rqn
                            (if (> (len rq0) 0)
                                rq0
                                (if (> (len value-rq) 0)
                                    value-rq
                                    (type-res-lookup source-module raw-name)))
                          (mut rd)
                            (: (if (or (= rqn "coil.primitive.cast")
                                       (= rqn "coil.primitive.field")
                                       (= rqn "coil.primitive.load")
                                       (= rqn "coil.primitive.store!"))
                                   (let [(mut z) (zeroed CpDecl)]
                                     (set! (.found z) true)
                                     (set! (.rec z)
                                           (primitive-decl-record a rqn))
                                     z)
                                   (if (and (> (len rqn) 0)
                                            (not (= rqn "$unresolved")))
                                       (let [found (cp-find-exact-decl a p rqn)]
                                         (if (.found found)
                                             found
                                             (match (checkedbase/checked-base-get (.checked_base (sem-model-box))
                                                                                  rqn)
                                               (Some [function]
                                                     (let [(mut z)
                                                             (zeroed CpDecl)]
                                                       (set! (.found z) true)
                                                       (set! (.rec z)
                                                             (fn-decl-record a
                                                                             function))
                                                       z))
                                               (None [] found))))
                                       (let [(mut z) (zeroed CpDecl)]
                                         (set! (.found z) false)
                                         z)))
                               CpDecl)]
                      (if (= rqn "$unresolved")
                          (answer op (answer0 a "DeclUnresolved") cx)
                          (if (.found rd)
                              (answer op (decl-answer a (.rec rd)) cx)
                              (let [nm
                                      (if is-list
                                          ""
                                          (decl-node-name a (ccode-of nodev)))]
                                (if (= (len nm) 0)
                                    (answer op (answer0 a "DeclUnresolved") cx)
                                    (let [simple (decl-simple-name nm)
                                          wantmod (decl-qual-module nm)
                                          fr (primitive/alloc-stack CpFn)]
                                      (set! fr (cp-find-fn p simple wantmod))
                                      (if (= (.status fr)
                                             2)
                                          (answer op
                                                  (answer0 a "DeclAmbiguous")
                                                  cx)
                                          (if (= (.status fr)
                                                 0)
                                              (answer op
                                                      (decl-answer a
                                                                   (fn-decl-record a
                                                                                   (load (field fr
                                                                                                fn))))
                                                      cx)
                                              ; not a function — scan the kind-only declarations
                                              (let [nks (cp-kind-decls a p)
                                                    (mut cnt) 0
                                                    (mut first)
                                                      (None [NamedKind])]
                                                (for [i 0 (len (load nks))]
                                                  (let [e (elem nks i)]
                                                    (when (cp-name-match (.name e)
                                                                         simple
                                                                         wantmod)
                                                      (when (= (load cnt) 0)
                                                        (set! first
                                                              (Some (load e)))
                                                        0)
                                                      (set! cnt
                                                            (+ (load cnt) 1))
                                                      0)))
                                                (match (load first)
                                                  (None []
                                                        (answer op
                                                                (answer0 a
                                                                         "DeclUnresolved")
                                                                cx))
                                                  (Some [e]
                                                        (if (> (load cnt) 1)
                                                            (answer op
                                                                    (answer0 a
                                                                             "DeclAmbiguous")
                                                                    cx)
                                                            (answer op
                                                                    (decl-answer a
                                                                                 (kind-decl-record a
                                                                                                   (qual-module-of (.name e))
                                                                                                   (.kind e)
                                                                                                   (.name e)))
                                                                    cx)))))))))))))))))))

;;; The sum named NAME a metaprogram sees; `ct-struct-find`'s order.
(defn ct-sum-find [(cx (ptr CtCtx)) (name (slice u8))] (-> (ptr SumDef))
  (let [own (ct-sum-scan (load (field cx sums)) name)
        (mut r)
          (if (= (primitive/cast i64 own) 0)
              (ct-sum-scan (.gen_sums cx) name)
              own)]
    (if (!= (primitive/cast i64 (load r)) 0)
        (load r)
        (let [p (sem-model)]
          (if (= (primitive/cast i64 p) 0)
              (load r)
              (let [model-lst (load (field p sums))
                    model-n (len model-lst)]
                (for [j 0 model-n]
                  (when (= (.name (elem model-lst
                                        j))
                           name)
                    (set! r (elem model-lst j))
                    0))
                (load r)))))))

;;; Is Q the qualified name of a struct or sum CX sees (`ct-struct-find`)?
(defn ct-type-declared? [(cx (ptr CtCtx)) (q (slice u8))] (-> bool)
  (or (!= (primitive/cast i64 (ct-struct-find cx q)) 0)
      (!= (primitive/cast i64 (ct-sum-find cx q)) 0)))

(defn ct-trait-find [(cx (ptr CtCtx)) (name (slice u8))] (-> (ptr TraitDef))
  (let [lst (load (field cx traits))
        n (len (load lst))
        (mut r) (primitive/cast (ptr TraitDef) 0)]
    (for [i 0 n]
      (when (= (.name (elem lst i))
               name)
        (set! r (elem lst i))
        0))
    (load r)))

(defn cstr-of [(v CtVal)] (-> (slice u8))
  (match v (CStr [s] s) (_ "")))

(defn is-cstr [(v CtVal)] (-> bool)
  (match v (CStr [s] true) (_ false)))

(defn is-ccode [(v CtVal)] (-> bool)
  (match v (CCode [c] true) (_ false)))

(defn ccode-of [(v CtVal)] (-> Sexp)
  (match v (CCode [c] c) (_ (zeroed Sexp))))

(defn sx-sym [(s (slice u8))] (-> Sexp)
  (mk-sexp (KSym s) -1 -1))

(defn sx-mkstr [(s (slice u8))] (-> Sexp)
  (mk-sexp (KStr s) -1 -1))

(defn sx-mkint [(n i64)] (-> Sexp)
  (mk-sexp (KInt n) -1 -1))

(defn sx-mklist [(items (ptr (ArrayList Sexp)))] (-> Sexp)
  (mk-sexp (KList items) -1 -1))

; The source form of a generic constant: an integer, `true`/`false`, or a keyword.
(defn const-value-sexp [(v ConstValue)] (-> Sexp)
  (match v
    (ConstInt [n] (sx-mkint n))
    (ConstBool [b] (sx-sym (if b "true" "false")))
    (ConstKeyword [name] (mk-sexp (KKw name) -1 -1))
    (ConstRef [name]
              (sx-mklist (let [(mut items)
                                 (ArrayList::new [Sexp] (unit-allocator))]
                           (push! (mut items) (sx-sym "const"))
                           (push! (mut items) (sx-sym name))
                           (box-al (unit-allocator) (load items)))))))

(defn reader-config-char [(node Sexp)] (-> i64)
  (if (= (sx-tag node) 0)
      (sx-ival node)
      (if (and (= (sx-tag node) 2)
               (let [s (sx-sval node)]
                 (and (>= (len s) 3)
                      (and (= (primitive/cast i64 (get s 0)) 35)
                           (= (primitive/cast i64 (get s 1)) 92)))))
          (let [s (sx-sval node)
                body (subslice s 2 (len s))]
            (if (= (len body) 1)
                (primitive/cast i64 (get body 0))
                (char-name-code body)))
          -1)))

(defn intw-name [(a (dyn Allocator)) (pre (slice u8)) (b i64)] (-> (slice u8))
  (sconcat a pre (dec->str a b)))

(defn type-kind-tag [(t Type) (cx (ptr CtCtx))] (-> i64)
  (match t
    (TInt [b s] 0)
    (TFloat [b] 1)
    (TBool [] 2)
    (TStruct [n]
             (if (!= (primitive/cast i64 (ct-struct-find cx n))
                     0)
                 3
                 (if (!= (primitive/cast i64 (ct-sum-find cx n))
                         0)
                     4
                     8)))
    (TApp [n a]
          (if (!= (primitive/cast i64 (ct-struct-find cx n))
                  0)
              3
              (if (!= (primitive/cast i64 (ct-sum-find cx n))
                      0)
                  4
                  8)))
    (TPtr [i] 5)
    (TRef [m i] 5)
    (TArray [e k] 6)
    (TSlice [e] 7)
    (_ 8)))

; The type's name for CODE GENERATION: nominal types keep their qualification, so a
; symbol built from it (`Inner-eq`, `Inner-hash`) resolves wherever the generated code
; lands. `type-name-str` strips it, which is right for the display/dispatch uses and
; wrong here: `(derive Eq Outer)` over a field typed from an `:as` import emitted a call
; to a bare `Inner-eq` that existed only as `qlib.Inner-eq`.
(defn qual-type-name-str [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (match (load t) (TStruct [n] n) (TApp [n ar] n) (_ (type-name-str a t))))

(defn type-name-str [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TInt [b s] (if s (intw-name a "i" b) (intw-name a "u" b)))
    (TFloat [b] (intw-name a "f" b))
    (TBool [] "bool")
    (TStruct [n] (after-last-dot n))
    (TApp [n ar] (after-last-dot n))
    (TPtr [i] "ptr")
    (TRef [m i] "ptr")
    (TArray [e k] "array")
    (TSlice [e] "slice")
    (_ (do
         (unimplemented "comptime/type_name_str: Debug form of exotic type")
         ""))))

(defn type->code [(t (ptr Type))] (-> Sexp)
  (let [a (unit-allocator)]
    (match (load t)
      (TInt [b s] (sx-sym (if s (intw-name a "i" b) (intw-name a "u" b))))
      (TFloat [b] (sx-sym (intw-name a "f" b)))
      (TBool [] (sx-sym "bool"))
      (TVoid [] (sx-sym "void"))
      (TCode [] (sx-sym (builtin-code-type-name (load t))))
      (TCodeBuilder [] (sx-sym (builtin-code-type-name (load t))))
      (TExternRef [] (sx-sym "externref"))
      (TNever [] (sx-sym "Never"))
      (TError [] (sx-sym "error"))
      (TStruct [n] (sx-sym n))
      (TPtr [i]
            (let [(mut xs) (ArrayList::new [Sexp] a)]
              (push! (mut xs) (sx-sym "ptr"))
              (push! (mut xs) (type->code i))
              (sx-mklist (box-al a (load xs)))))
      (TRef [m i]
            (let [(mut xs) (ArrayList::new [Sexp] a)]
              (push! (mut xs) (sx-sym (if m "mut" "ref")))
              (push! (mut xs) (type->code i))
              (sx-mklist (box-al a (load xs)))))
      (TSlice [i]
              (let [(mut xs) (ArrayList::new [Sexp] a)]
                (push! (mut xs) (sx-sym "slice"))
                (push! (mut xs) (type->code i))
                (sx-mklist (box-al a (load xs)))))
      (TArray [i n]
              (let [(mut xs) (ArrayList::new [Sexp] a)]
                (push! (mut xs) (sx-sym "array"))
                (push! (mut xs) (type->code i))
                (push! (mut xs)
                       (match n
                         (FixedExtent [k] (sx-mkint k))
                         (ParamExtent [name] (sx-sym name))))
                (sx-mklist (box-al a (load xs)))))
      (TVec [i n]
            (let [(mut xs) (ArrayList::new [Sexp] a)]
              (push! (mut xs) (sx-sym "vec"))
              (push! (mut xs) (type->code i))
              (push! (mut xs)
                     (match n
                       (FixedExtent [k] (sx-mkint k))
                       (ParamExtent [name] (sx-sym name))))
              (sx-mklist (box-al a (load xs)))))
      (TConst [v] (ty-list2 a "const" (const-value-sexp v)))
      (TFn [cc p r]
           (let [(mut pv) (ArrayList::new [Sexp] a)
                 np (len (load p))]
             (for [j 0 np]
               (push! (mut pv)
                      (type->code (elem p j))))
             (let [(mut xs) (ArrayList::new [Sexp] a)]
               (push! (mut xs) (sx-sym "fnptr"))
               ; a native convention is its constructor call, a defcc its name
               (push! (mut xs) (cc->code a cc))
               (push! (mut xs)
                      (mk-sexp (KVec (box-al a (load pv))) -1 -1))
               (push! (mut xs) (type->code r))
               (sx-mklist (box-al a (load xs))))))
      (TApp [n ar]
            (let [(mut xs) (ArrayList::new [Sexp] a)
                  na (len (load ar))]
              (push! (mut xs) (sx-sym n))
              (for [j 0 na]
                (push! (mut xs)
                       (type->code (elem ar j))))
              (sx-mklist (box-al a (load xs))))))))

; Attach authoritative mono provenance to the same unpublished Code-state
; transaction staged by a source metaprogram.  The next edit can therefore
; invalidate concrete artifacts from the previously accepted program without
; parsing a mangled spelling or asking the controller to mirror compiler state.
;;; A structural hash that agrees with sexp-eq: equal syntax hashes equally.
(defn sexp-structural-hash [(x Sexp)] (-> i64)
  (let [tag0 (sx-tag x)
        tag (if (= tag0 8) 6 tag0)
        (mut h)
          (^ -3750763034362895579 (primitive/imul (+ tag 1) 1099511628211))]
    (cond (or (= tag 0) (= tag 1))
            (set! h
                  (primitive/imul (^ (load h) (sx-ival x))
                                  1099511628211))
          (or (= tag 2) (= tag 3) (= tag 4) (= tag 5))
            (let [s (sx-sval x)]
              (for [i 0 (len s)]
                (set! h
                      (primitive/imul (^ (load h)
                                         (primitive/cast i64
                                                         (get s i)))
                                      1099511628211))))
          (or (= tag 6) (= tag 7))
            (for [i 0 (code-node-len x)]
              (set! h
                    (primitive/imul (^ (load h)
                                       (sexp-structural-hash (code-node-at x
                                                                           i)))
                                    1099511628211)))
          :else 0)
    (load h)))

;;; The report with a structural index, so adding an artifact costs one hash
;;; lookup instead of a scan of every accepted artifact.
(defstruct MonomorphReport
  [(items (ArrayList Sexp)) (index (HashMap i64 i64)) (chain (ArrayList i64))])

(defn monomorph-report-push-unique! [(report (mut MonomorphReport)) (item Sexp)]
  (-> i64)
  (let [h (sexp-structural-hash item)
        (mut at) (match (get (.index report) h) (Some [i] i) (None [] -1))
        (mut found) false]
    (loop (if (< (load at) 0)
              (break)
              (if (sexp-eq (get (.items report) (load at)) item)
                  (do (set! found true) (break))
                  (set! at (get (.chain report) (load at))))))
    (unless (load found)
      (push! (mut (.chain report))
             (match (get (.index report) h) (Some [i] i) (None [] -1)))
      (set! (mut (.index report)) h (len (.items report)))
      (push! (mut (.items report)) item)
      0)
    0))

(defn code-session-stage-monomorphs! [(state (ptr CodeSessionState))
                                      (program (ptr Program))] (-> i64)
  (if (not (.has_staged state))
      0
      (let [a (unit-allocator)
            (mut report) (zeroed MonomorphReport)
            origins (load (field program mono_origins))]
        (set! (.items report) (ArrayList::new [Sexp] a))
        (set! (.index report) (HashMap::new [i64 i64] a (i64-keyops)))
        (set! (.chain report) (ArrayList::new [i64] a))
        ; Element zero is the `monomorph-artifacts` report tag.
        (push! (mut (.items report)) (sx-sym "monomorph-artifacts"))
        (push! (mut (.chain report)) -1)
        ; The native program is authoritative: monomorphize-reusing already
        ; carries every still-retained origin and trait-use record. Unioning
        ; the previous Code report here resurrects artifacts retired from that
        ; program and grows an otherwise bounded session on every schema edit.
        ; Native leases retain executable images, not current semantic reports.
        (if (!= (primitive/cast i64 origins) 0)
            (let [n (len (load origins))]
              (for [i 0 n]
                (let [origin (elem origins i)
                      (mut args) (ArrayList::new [Sexp] a)
                      concrete (load (field origin args))]
                  (for [j 0 (len (load concrete))]
                    (push! (mut args) (type->code (elem concrete j))))
                  (let [(mut item) (ArrayList::new [Sexp] a)]
                    (push! (mut item) (sx-sym "monomorph"))
                    (push! (mut item) (sx-mkint (.kind origin)))
                    ; The compiler performs qualification removal while it still
                    ; owns declaration identity. Consumers compare this reported
                    ; source artifact with their registry descriptor; they never
                    ; parse a mangled or module-qualified spelling.
                    (push! (mut item)
                           (sx-mkstr (after-last-dot (.source origin))))
                    (push! (mut item)
                           (mk-sexp (KVec (box-al a (load args))) -1 -1))
                    (push! (mut item)
                           (sx-mkstr (after-last-dot (.generated origin))))
                    (push! (mut item) (sx-mkstr (.trait_name origin)))
                    (push! (mut item) (sx-mkstr (.impl_source origin)))
                    (monomorph-report-push-unique! (mut report)
                                                   (sx-mklist (box-al a
                                                                      (load item))))))))
            0)
        (let [uses (load (field program mono_trait_uses))]
          (if (!= (primitive/cast i64 uses) 0)
              (for [i 0 (len (load uses))]
                (let [use (elem uses i)
                      (mut item) (ArrayList::new [Sexp] a)]
                  (push! (mut item) (sx-sym "trait-use"))
                  (push! (mut item)
                         (sx-mkstr (after-last-dot (.caller_source use))))
                  (push! (mut item)
                         (sx-mkstr (after-last-dot (.trait_name use))))
                  (push! (mut item)
                         (sx-mkstr (after-last-dot (.impl_source use))))
                  (push! (mut item) (sx-mkstr (.method_name use)))
                  (push! (mut item)
                         (sx-mkstr (after-last-dot (.generated_artifact use))))
                  (monomorph-report-push-unique! (mut report)
                                                 (sx-mklist (box-al a
                                                                    (load item))))))
              0))
        (let [(mut source) (sx-mklist (box-al a (.items report)))]
          ; type->code and origin names can borrow the compilation unit. Own
          ; the entire report before that unit is released; an outer list in
          ; the retained arena alone leaves its nested syntax dangling.
          (set! (.staged_monomorphs state)
                (sexp-own-into (allocator (field state staged_arena))
                               (mut source))))
        (set! (.has_staged_monomorphs state) true)
        0)))

(defn ty-is-named [(t Type)] (-> bool)
  (match t (TStruct [n] true) (TApp [n a] true) (_ false)))

(defn ty-name-opt [(t Type)] (-> (slice u8))
  (match t (TStruct [n] n) (TApp [n a] n) (_ "")))

(defn type-query [(q i64) (ty Type) (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [named (ty-is-named ty)
        nm (ty-name-opt ty)]
    (cond (= q 0)
            (let [sd
                    (if named
                        (ct-struct-find cx nm)
                        (primitive/cast (ptr StructDef) 0))]
              (if (= (primitive/cast i64 sd) 0)
                  (Err [CtVal Diag] (derr "field-count: type is not a struct"))
                  (Ok [CtVal Diag] (CInt (len (load (field sd fields)))))))
          (= q 1)
            (let [sd
                    (if named
                        (ct-sum-find cx nm)
                        (primitive/cast (ptr SumDef) 0))]
              (if (= (primitive/cast i64 sd) 0)
                  (Err [CtVal Diag] (derr "variant-count: type is not a sum"))
                  (Ok [CtVal Diag] (CInt (len (load (field sd variants)))))))
          (= q 2)
            (Ok [CtVal Diag]
                (CBool (and named
                            (!= (primitive/cast i64 (ct-struct-find cx nm))
                                0))))
          (= q 3)
            (Ok [CtVal Diag]
                (CBool (and named
                            (!= (primitive/cast i64 (ct-sum-find cx nm))
                                0))))
          (= q 4)
            (Ok [CtVal Diag] (CBool (match ty (TInt [b s] true) (_ false))))
          (= q 5)
            (Ok [CtVal Diag] (CBool (match ty (TFloat [b] true) (_ false))))
          (= q 6)
            (Ok [CtVal Diag]
                (CBool (match ty (TPtr [i] true) (TRef [m i] true) (_ false))))
          :else
            (Ok [CtVal Diag] (CBool (match ty (TArray [e k] true) (_ false)))))))

(defn field-meta [(meta i64) (ty Type) (i i64) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)]
    (if (not (ty-is-named ty))
        (Err [CtVal Diag] (derr "field reflection: type is not a struct"))
        (let [sd (ct-struct-find cx (ty-name-opt ty))]
          (if (= (primitive/cast i64 sd) 0)
              (Err [CtVal Diag] (derr "field reflection: not a struct"))
              (let [flds (load (field sd fields))
                    nf (len (load flds))]
                (if (or (< i 0) (>= i nf))
                    (Err [CtVal Diag]
                         (derr "field reflection: index out of range"))
                    (let [fp (elem flds i)
                          fname (.name fp)
                          ftyp (field fp ty)]
                      (if (= meta 0)
                          (Ok [CtVal Diag] (CStr fname))
                          (if (= meta 1)
                              (Ok [CtVal Diag]
                                  (CInt (type-kind-tag (load ftyp) cx)))
                              (Ok [CtVal Diag] (CStr (type-name-str a ftyp)))))))))))))

(defn find-field-index [(ty Type) (want (slice u8)) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)]
    (if (not (ty-is-named ty))
        (Err [CtVal Diag] (derr "field-index: type is not a struct"))
        (let [sd (ct-struct-find cx (ty-name-opt ty))]
          (if (= (primitive/cast i64 sd) 0)
              (Err [CtVal Diag] (derr "field-index: not a struct"))
              (let [flds (load (field sd fields))
                    nf (len (load flds))
                    (mut r) -1]
                (for [i 0 nf]
                  (when (= (.name (elem flds
                                        i))
                           want)
                    (set! r i)
                    (break)))
                (if (< (load r) 0)
                    (Err [CtVal Diag]
                         (derr (text/format a
                                            "field-index: struct has no field '{}'"
                                            want)))
                    (Ok [CtVal Diag] (CInt (load r))))))))))

(defn sexp-list-eq [(xs (ptr (ArrayList Sexp))) (ys (ptr (ArrayList Sexp)))]
  (-> bool)
  (let [nx (len (load xs))
        ny (len (load ys))]
    (if (!= nx ny)
        false
        (let [(mut i) 0
              (mut ok) true]
          (loop (if (or (not (load ok)) (>= (load i) nx))
                    (break)
                    (do
                      (unless (sexp-eq (get (load xs) (load i))
                                       (get (load ys) (load i)))
                        (set! ok false)
                        0)
                      (set! i (primitive/iadd (load i) 1)))))
          (load ok)))))

(defn sexp-eq [(x Sexp) (y Sexp)] (-> bool)
  ; a KView (tag 8) compares as the LIST it denotes (docs/design/META_MEMORY.md
  ; phase 5): code-rest of a list must equal the equal literal list
  (let [tx0 (sx-tag x)
        ty0 (sx-tag y)
        tx (if (= tx0 8) 6 tx0)
        ty (if (= ty0 8) 6 ty0)]
    (cond (!= tx ty) false
          (or (= tx 0) (= tx 1)) (= (sx-ival x) (sx-ival y))
          (or (= tx 2) (= tx 3) (= tx 4) (= tx 5)) (= (sx-sval x) (sx-sval y))
          (or (= tx 6) (= tx 7)) (sexp-eq-nodes x y)
          :else false)))

(defn ctval->sexp [(v CtVal)] (-> (Result Sexp Diag))
  (match v
    (CCode [c] (Ok [Sexp Diag] c))
    (CInt [n] (Ok [Sexp Diag] (sx-mkint n)))
    (CWideInt [_ _ _]
              (Err [Sexp Diag]
                   (derr "comptime: a 128-bit integer has no Code literal; an integer in Code is an i64")))
    (CFloat [x] (Ok [Sexp Diag] (mk-sexp (KFloat (f64-bits x)) -1 -1)))
    (CBool [b] (Ok [Sexp Diag] (sx-sym (if b "true" "false"))))
    ; a copy, as the compiled engine's unquote makes (metahost.coil mh-unq-str): the
    ; string is the metaprogram's, and the Code outlives it
    (CStr [s] (Ok [Sexp Diag] (sx-mkstr (text/format (unit-allocator) "{}" s))))
    (_ (Err [Sexp Diag]
            (derr "comptime: can't unquote an aggregate value into code")))))

; ── reflected names ───────────────────────────────────────────────────────────
; A type, a trait or a variant a metaprogram reflects on is a name written in
; some module, and names what it names there (`resolve-in-space`): never a
; declaration elsewhere that merely shares its last segment.

;;; The import and export tables a reflected name is resolved against: every
;;; module's, while macros expand. A context with none (a comptime fold) resolves
;;; only the resolver's recorded answers, exact declaration names, and the
;;; writing module's own declarations.
(defn ct-imports [(cx (ptr CtCtx))] (-> (ptr (ArrayList ImpEntry)))
  (if (= (primitive/cast i64 (.all_imports cx)) 0)
      (box-al (.a cx) (ArrayList::new [ImpEntry] (.a cx)))
      (.all_imports cx)))

(defn ct-exports [(cx (ptr CtCtx))] (-> (ptr (ArrayList ExpEntry)))
  (if (= (primitive/cast i64 (.all_exports cx)) 0)
      (box-al (.a cx) (ArrayList::new [ExpEntry] (.a cx)))
      (.all_exports cx)))

;;; Is Q the name LEAF qualified by MODULE (`module.leaf`)?
(defn qualified-as? [(q (slice u8)) (module (slice u8)) (leaf (slice u8))]
  (-> bool)
  (let [ml (len module)]
    (and (> ml 0)
         (and (= (len q) (+ ml (+ 1 (len leaf))))
              (and (= (subslice q 0 ml) module)
                   (and (= (get q ml) (: 46 u8))
                        (= (subslice q (+ ml 1) (len q)) leaf)))))))

;;; Does the sum SD declare the variant Q (a qualified name)? A generated sum's
;;; variants may be unqualified; they belong to the sum's module.
(defn sum-declares-variant? [(sd (ptr SumDef)) (q (slice u8))] (-> bool)
  (let [vs (load (field sd variants))
        owner (qual-module-of (.name sd))]
    (block :found
      (for [i 0 (len (load vs))]
        (let [vn (.name (elem vs i))]
          (when (or (= vn q)
                    (and (not (has-dot vn)) (qualified-as? q owner vn)))
            (break :found true))))
      false)))

;;; The sum CX sees that declares the variant Q, or null.
(defn ct-variant-sum [(cx (ptr CtCtx)) (q (slice u8))] (-> (ptr SumDef))
  (block :found
    (let [lst (ct-sums-visible cx)]
      (unless (= (primitive/cast i64 lst) 0)
        (for [i 0 (len (load lst))]
          (when (sum-declares-variant? (elem lst i) q)
            (break :found (elem lst i))))
        0))
    (let [p (sem-model)]
      (unless (= (primitive/cast i64 p) 0)
        (let [ms (load (field p sums))]
          (for [i 0 (len (load ms))]
            (when (sum-declares-variant? (elem ms i) q)
              (break :found (elem ms i)))))
        0))
    (primitive/cast (ptr SumDef) 0)))

;;; A struct or sum CX sees whose name ends in the segment SPELLED, or "": what a
;;; diagnostic about a name not in scope can point at.
(defn ct-type-named-elsewhere [(cx (ptr CtCtx)) (spelled (slice u8))]
  (-> (slice u8))
  (let [leaf (after-last-qualifier spelled)]
    (block :found
      (let [ss (ct-structs-visible cx)]
        (unless (= (primitive/cast i64 ss) 0)
          (for [i 0 (len (load ss))]
            (when (= (after-last-dot (.name (elem ss i))) leaf)
              (break :found (.name (elem ss i)))))
          0))
      (let [us (ct-sums-visible cx)]
        (unless (= (primitive/cast i64 us) 0)
          (for [i 0 (len (load us))]
            (when (= (after-last-dot (.name (elem us i))) leaf)
              (break :found (.name (elem us i)))))
          0))
      (let [p (sem-model)]
        (unless (= (primitive/cast i64 p) 0)
          (for [i 0 (len (load (load (field p structs))))]
            (let [sd (elem (load (field p structs)) i)]
              (when (= (after-last-dot (.name sd)) leaf)
                (break :found (.name sd)))))
          (for [i 0 (len (load (load (field p sums))))]
            (let [ud (elem (load (field p sums)) i)]
              (when (= (after-last-dot (.name ud)) leaf)
                (break :found (.name ud)))))
          0))
      "")))

;;; "'X' names no WHAT in scope in module 'M'".
(defn ct-not-in-scope-msg [(a (dyn Allocator))
                           (spelled (slice u8))
                           (what (slice u8))
                           (module (Option (slice u8)))] (-> (slice u8))
  (text/format a
               "comptime: '{}' names no {}{}"
               spelled
               what
               (match module
                 (Some [m] (text/format a " in scope in module '{}'" m))
                 (None [] " in scope here"))))

;;; The struct or sum the type symbol NODE names where it was written: the
;;; resolver's recorded answer for that spelling in that module when it names
;;; one, a declaration whose exact name it is (a generated one keeps its lexical
;;; key), or what `resolve-type-ref` finds in scope there.
(defn ct-resolve-type-ref [(cx (ptr CtCtx)) (node Sexp)]
  (-> (Result (slice u8) Diag))
  (let [a (.a cx)
        raw (lexical-name a node)
        module (ct-node-module node)
        recorded (type-res-lookup (match module (Some [m] m) (None [] "")) raw)]
    ; A recorded answer that names no declaration is the resolver's "not found",
    ; given before a macro declared the type; it does not settle the question.
    (cond (and (> (len recorded) 0) (ct-type-declared? cx recorded))
            (Ok [(slice u8) Diag] recorded)
          (ct-type-declared? cx raw) (Ok [(slice u8) Diag] raw)
          :else
            (match (resolve-type-ref (sx-sval node)
                                     module
                                     cx
                                     (ct-imports cx)
                                     (ct-exports cx)
                                     a)
              (Err [d] (Err [(slice u8) Diag] d))
              (Ok [found]
                  (match found
                    (Some [q] (Ok [(slice u8) Diag] q))
                    (None []
                          (let [msg
                                  (ct-not-in-scope-msg a
                                                       (sx-sval node)
                                                       "struct or sum"
                                                       module)
                                elsewhere
                                  (ct-type-named-elsewhere cx (sx-sval node))]
                            (Err [(slice u8) Diag]
                                 (derr (if (= elsewhere "")
                                           msg
                                           (text/format a
                                                        "{}; {} is not imported there"
                                                        msg
                                                        elsewhere))))))))))))

;;; The trait the symbol NODE names where it was written, for reflection.
(defn ct-resolve-trait-ref [(cx (ptr CtCtx)) (node Sexp)]
  (-> (Result (slice u8) Diag))
  (let [module (ct-node-module node)]
    (match (resolve-trait-ref (sx-sval node)
                              module
                              cx
                              (ct-imports cx)
                              (ct-exports cx)
                              (.a cx))
      (Err [d] (Err [(slice u8) Diag] d))
      (Ok [found]
          (match found
            (Some [q] (Ok [(slice u8) Diag] q))
            (None []
                  (Err [(slice u8) Diag]
                       (derr (ct-not-in-scope-msg (.a cx)
                                                  (sx-sval node)
                                                  "trait"
                                                  module)))))))))

;;; The sum declaring the variant the symbol NODE names where it was written.
(defn ct-resolve-variant-ref [(cx (ptr CtCtx)) (node Sexp)]
  (-> (Result (ptr SumDef) Diag))
  (let [module (ct-node-module node)]
    (match (resolve-variant-ref (sx-sval node)
                                module
                                cx
                                (ct-imports cx)
                                (ct-exports cx)
                                (.a cx))
      (Err [d] (Err [(ptr SumDef) Diag] d))
      (Ok [found]
          (match found
            (Some [q] (Ok [(ptr SumDef) Diag] (ct-variant-sum cx q)))
            (None []
                  (Err [(ptr SumDef) Diag]
                       (derr (ct-not-in-scope-msg (.a cx)
                                                  (sx-sval node)
                                                  "variant"
                                                  module)))))))))

;;; `(primitive/code-variant-ref NODE)`: the variant the constructor symbol NODE
;;; names where it was written, through that module's imports and aliases, as a
;;; VariantRef.
(defn cop-variant-ref [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (match (code-symnode args)
    (None []
          (Err [CtVal Diag]
               (derr "code-variant-ref: expects (primitive/code-variant-ref SYMBOL)")))
    (Some [node]
          (match (resolve-variant-ref (sx-sval node)
                                      (ct-node-module node)
                                      cx
                                      (ct-imports cx)
                                      (ct-exports cx)
                                      (.a cx))
            (Err [d] (Err [CtVal Diag] d))
            (Ok [found]
                (answer op
                        (match found
                          (Some [q]
                                (answer1 (.a cx)
                                         "NamesVariant"
                                         (CCode (sx-sym q))))
                          (None [] (answer0 (.a cx) "NamesNoVariant")))
                        cx))))))

;;; `(primitive/code-type-ref NODE)`: the struct or sum the type symbol NODE names
;;; where it was written, as a TypeRef. A type with no declaration (`i64`, a type
;;; parameter) names none.
(defn cop-type-ref [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (match (code-symnode args)
    (None []
          (Err [CtVal Diag]
               (derr "code-type-ref: expects (primitive/code-type-ref SYMBOL)")))
    (Some [node]
          (let [a (.a cx)
                raw (lexical-name a node)
                module (ct-node-module node)
                recorded
                  (type-res-lookup (match module (Some [m] m) (None [] "")) raw)
                found
                  (cond (and (> (len recorded) 0)
                             (ct-type-declared? cx recorded))
                          (Ok [(Option (slice u8)) Diag] (Some recorded))
                        (ct-type-declared? cx raw)
                          (Ok [(Option (slice u8)) Diag] (Some raw))
                        :else
                          (resolve-type-ref (sx-sval node)
                                            module
                                            cx
                                            (ct-imports cx)
                                            (ct-exports cx)
                                            a))]
            (match found
              (Err [d] (Err [CtVal Diag] d))
              (Ok [q]
                  (answer op
                          (match q
                            (Some [name]
                                  (answer1 a "NamesType" (CCode (sx-sym name))))
                            (None [] (answer0 a "NamesNoType")))
                          cx)))))))

;;; `(NAME)`: a constructor call with no arguments.
(defn sx-unit-call [(a (dyn Allocator)) (name (slice u8))] (-> Sexp)
  (let [(mut items) (ArrayList::new [Sexp] a)]
    (push! (mut items) (sx-sym name))
    (mk-sexp (KList (box-al a (load items))) -1 -1)))

;;; Convention REF as the syntax that writes it: `(coil.cc.C)`, or a defcc's name.
(defn cc->code [(a (dyn Allocator)) (ref CcRef)] (-> Sexp)
  (match ref
    (CcResolved [q] (if (native-cc-identity? q) (sx-unit-call a q) (sx-sym q)))
    (CcWrittenValue [n] (sx-unit-call a n))
    (CcWrittenName [n] (sx-sym n))))

(defn cv-get [(args (ptr (ArrayList CtVal))) (i i64)] (-> (Option CtVal))
  (if (or (< i 0) (>= i (len (load args))))
      (None [CtVal])
      (Some (get (load args) i))))

;;; The first argument as a Code symbol, for code-variant-sum and code-trait-*.
(defn code-symnode [(args (ptr (ArrayList CtVal)))] (-> (Option Sexp))
  (match (cv-get args 0)
    (Some [v]
          (if (and (is-ccode v) (= (sx-tag (ccode-of v)) 2))
              (Some (ccode-of v))
              (None [Sexp])))
    (None [] (None [Sexp]))))

(defn append-bytes! [(buf (mut (ArrayList u8))) (s (slice u8))] (-> i64)
  (let [n (len s)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut buf) (get s (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn cop-concat-finish [(op i64) (name (slice u8)) (errf (Option Diag))]
  (-> (Result CtVal Diag))
  (match errf
    (Some [d] (Err [CtVal Diag] d))
    (None []
          (if (= op 12)
              (let [(mut p)
                      (: (if (and (> (len name) 0)
                                  (= (primitive/cast i64 (get name 0)) 58))
                             (mk-sexp (KKw (subslice [u8] name 1 (len name)))
                                      -1
                                      -1)
                             (sx-sym name))
                         Sexp)]
                ; Datum construction has no lexical context. A negative marker
                ; keeps it distinct from source syntax until an explicit context
                ; operation classifies it.
                (set! (.hyg p)
                      -1)
                (set! (.horigin p) 3)
                (Ok [CtVal Diag] (CCode p)))
              (Ok [CtVal Diag] (CStr name))))))

; A type reference in Code — a bare type symbol `Point`, or a generic instantiation
; `(Gen A B)` — mangled to ONE valid symbol so a macro can mint a name for a derived
; helper over a generic instance (the same shape `code-field-count` accepts). Mirrors
; the monomorphizer's naming scheme: base, then `__` and each argument's own mangle;
; an int (an array size) is its decimal digits. Deterministic, valid symbol characters
; only. Returns "" for a shape that is not a nameable type — the caller errors.
(defn inst-node-mangle [(a (dyn Allocator)) (node Sexp)] (-> (slice u8))
  (let [tg (sx-tag node)]
    (cond (or (= tg 2) (= tg 4)) (sx-sval node)
          (= tg 0) (dec->str a (sx-ival node))
          ; A keyword constant argument, `(Quantity :meters)`.
          (= tg 3) (text/format a "kw_{}" (sx-sval node))
          (or (= tg 6) (= tg 7))
            (let [items (sx-items node)
                  n (sx-len items)]
              (if (or (= n 0)
                      (!= (sx-tag (sx-at items 0)) 2))
                  ""
                  (let [(mut s) (sx-sval (sx-at items 0))
                        (mut i) 1]
                    (loop (if (>= (load i) n)
                              (break)
                              (let [part
                                      (inst-node-mangle a
                                                        (sx-at items (load i)))]
                                (if (= part "")
                                    (do (set! s "") (break))
                                    (do
                                      (set! s
                                            (text/format a
                                                         "{}__{}"
                                                         (load s)
                                                         part))
                                      (set! i (primitive/iadd (load i) 1)))))))
                    (load s))))
          :else "")))

(defn concat-one! [(a (dyn Allocator))
                   (buf (mut (ArrayList u8)))
                   (v CtVal)
                   (tg i64)] (-> (Option Diag))
  (cond (= tg 3) (do (append-bytes! (mut buf) (cstr-of v)) (None [Diag]))
        (= tg 0)
          (do (append-bytes! (mut buf) (dec->str a (cint-of v))) (None [Diag]))
        (= tg 4)
          (let [c (ccode-of v)
                ctg (sx-tag c)]
            ; A symbol or string is its text, and so is a keyword, without
            ; the colon: `(code-str :initial)` is "initial".
            (cond (or (= ctg 2)
                      (= ctg 3)
                      (= ctg 4))
                    (do (append-bytes! (mut buf) (sx-sval c)) (None [Diag]))
                  (= ctg 0)
                    (do
                      (append-bytes! (mut buf) (dec->str a (sx-ival c)))
                      (None [Diag]))
                  (or (= ctg 6)
                      (= ctg 7))
                    (let [m (inst-node-mangle a c)]
                      (if (= m "")
                          (Some (derr "comptime: code-symbol/str part is not a nameable type (expected a symbol, string, int, or instantiation (Gen …))"))
                          (do (append-bytes! (mut buf) m) (None [Diag]))))
                  :else
                    (Some (derr (text/format a
                                             "comptime: code-symbol/str part must be a symbol, keyword, string, int or instantiation, got {}"
                                             (cond (= ctg 1) "a float"
                                                   (= ctg 5)
                                                     (text/format a
                                                                  "the C string c\"{}\""
                                                                  (sx-sval c))
                                                   :else "another kind of Code"))))))
        :else
          (Some (derr (text/format a
                                   "comptime: code-symbol/str part must be a string, int or Code, got {}"
                                   (cond (= tg 1) "a bool"
                                         (= tg 2) "a float"
                                         :else "an aggregate value"))))))

(defn concat-into! [(args (ptr (ArrayList CtVal)))
                    (i i64)
                    (n i64)
                    (a (dyn Allocator))
                    (buf (mut (ArrayList u8)))] (-> (Option Diag))
  (if (>= i n)
      (None [Diag])
      (let [v (get (load args) i)]
        (match (concat-one! a (mut buf) v (ct-tag v))
          (Some [d] (Some d))
          (None [] (concat-into! args (primitive/iadd i 1) n a (mut buf)))))))

(defn cop-concat [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)
        (mut buf) (ArrayList::new [u8] a)
        e (concat-into! args 0 (len (load args)) a (mut buf))]
    (cop-concat-finish op (slice (load buf)) e)))

; ---- scope-bearing identifier operations ----------------------------------
(defn ct-ident-name [(v CtVal)] (-> (Result (slice u8) Diag))
  (cond (= (ct-tag v) 3) (Ok (cstr-of v))
        (is-ccode v)
          (let [s (ccode-of v)
                tg (sx-tag s)]
            (if (or (= tg 2) (= tg 4))
                (Ok (sx-sval s))
                (Err (derr "identifier name must be a string or symbol Code"))))
        :else (Err (derr "identifier name must be a string or symbol Code"))))

(defn ident-copy-with [(a (dyn Allocator))
                       (orig Sexp)
                       (name (slice u8))
                       (hyg i64)] (-> Sexp)
  (let [p (box! a Sexp (zeroed Sexp))]
    (set! p orig)
    (set! (.kind p) (KSym name))
    (set! (.hyg p) hyg)
    (set! (.node-id p) (next-node-id))
    (load p)))

(defn cop-hygiene [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)]
    (cond (= op 66)
            (match (cv-get args 0)
              (Some [nv]
                    (match (ct-ident-name nv)
                      (Err [d] (Err [CtVal Diag] d))
                      (Ok [name]
                          (let [s (mk-sexp (KSym name) -1 -1)
                                (mut p) (: s Sexp)]
                            (let [scope (primitive/iadd (next-gensym) 1)]
                              (set! (.hyg p) scope)
                              (set! (.horigin p) 2)
                              ; Fresh lexical identity is deliberately
                              ; module-neutral. Definition-site module context
                              ; belongs to template literals, not generated
                              ; binders that may be transported into a target.
                              (set! (.hmod p)
                                    (no-hmod)))
                            (Ok [CtVal Diag] (CCode p))))))
              (None []
                    (Err [CtVal Diag]
                         (derr "fresh-identifier: expects a display name"))))
          (= op 67)
            (match (cv-get args 0)
              (Some [pv]
                    (match (cv-get args 1)
                      (Some [nv]
                            (if (not (is-ccode pv))
                                (Err [CtVal Diag]
                                     (derr "datum->syntax: prototype must be Code"))
                                (match (ct-ident-name nv)
                                  (Err [d] (Err [CtVal Diag] d))
                                  (Ok [name]
                                      (let [out
                                              (ident-copy-with a
                                                               (ccode-of pv)
                                                               name
                                                               (sx-hyg (ccode-of pv)))
                                            (mut p) (: out Sexp)]
                                        ; A derived name keeps the fresh scope of its prototype.
                                        ; Source emission must rename it with that identity too.
                                        (set! (.horigin p)
                                              (if (= (sx-horigin (ccode-of pv))
                                                     2)
                                                  2
                                                  4))
                                        (Ok [CtVal Diag] (CCode p)))))))
                      (None []
                            (Err [CtVal Diag]
                                 (derr "datum->syntax: expects prototype and name")))))
              (None []
                    (Err [CtVal Diag]
                         (derr "datum->syntax: expects prototype and name"))))
          (= op 68)
            (match (cv-get args 0)
              (Some [iv]
                    (if (and (is-ccode iv)
                             (= (sx-tag (ccode-of iv)) 2))
                        (Ok [CtVal Diag]
                            (let [out
                                    (ident-copy-with a
                                                     (ccode-of iv)
                                                     (sx-sval (ccode-of iv))
                                                     0)
                                  (mut p) (: out Sexp)]
                              (set! (.hmod p) (no-hmod))
                              (set! (.horigin p) 5)
                              (CCode p)))
                        (Err [CtVal Diag]
                             (derr "syntax->datum: expects identifier Code"))))
              (None []
                    (Err [CtVal Diag]
                         (derr "syntax->datum: expects identifier Code"))))
          :else
            (match (cv-get args 0)
              (Some [xv]
                    (match (cv-get args 1)
                      (Some [yv]
                            (if (and (is-ccode xv)
                                     (and (is-ccode yv)
                                          (and (= (sx-tag (ccode-of xv))
                                                  2)
                                               (= (sx-tag (ccode-of yv))
                                                  2))))
                                (Ok [CtVal Diag]
                                    (let [xh (sx-hyg (ccode-of xv))
                                          yh (sx-hyg (ccode-of yv))
                                          xm (sx-hmod (ccode-of xv))
                                          ym (sx-hmod (ccode-of yv))]
                                      (CBool (and (= (sx-sval (ccode-of xv))
                                                     (sx-sval (ccode-of yv)))
                                                  (if (= op
                                                         69)
                                                      ; Free equality follows a canonical definition-site
                                                      ; global even across separate template evaluations.
                                                      (or (= xh yh)
                                                          (and (> (len xm)
                                                                  0)
                                                               (= xm ym)))
                                                      ; Bound equality is exact lexical identity.
                                                      (= xh yh))))))
                                (Err [CtVal Diag]
                                     (derr "identifier equality expects two identifier Code values"))))
                      (None []
                            (Err [CtVal Diag]
                                 (derr "identifier equality expects two arguments")))))
              (None []
                    (Err [CtVal Diag]
                         (derr "identifier equality expects two arguments")))))))

; substitute type-parameter symbols in a type Code tree with the given arg forms:
; `(ptr T)` with T->i64 becomes `(ptr i64)`. The engine of GENERIC REFLECTION —
; `code-field-type` on an instantiation `(Gen A B)` reports concrete field types.
(defn subst-type-code [(node Sexp)
                       (params (ptr (ArrayList (slice u8))))
                       (targs (ptr (ArrayList Sexp)))] (-> Sexp)
  (let [tg (sx-tag node)]
    (if (= tg 2)
        (let [nm (sx-sval node)
              np (len (load params))
              nt (len (load targs))
              (mut idx) -1
              (mut i) 0]
          (loop (if (or (>= (load idx) 0) (>= (load i) np))
                    (break)
                    (do
                      (when (and (= (get (load params) (load i)) nm)
                                 (< (load i) nt))
                        (set! idx (load i)))
                      (set! i (primitive/iadd (load i) 1)))))
          (if (>= (load idx) 0)
              (get (load targs) (load idx))
              node))
        (if (or (= tg 6) (= tg 7))
            (let [a (unit-allocator)
                  items (sx-items node)
                  n (sx-len items)
                  (mut xs) (ArrayList::new [Sexp] a)]
              (for [i 0 n]
                (push! (mut xs)
                       (subst-type-code (sx-at items i)
                                        params
                                        targs)))
              (mk-sexp (if (= tg 7)
                           (KVec (box-al a (load xs)))
                           (KList (box-al a (load xs))))
                       -1
                       -1))
            node))))

; ── the DERIVE REGISTRY ──────────────────────────────────────────────────────
; A function is a deriver because a `(register-derive …)` form NAMED it. It is
; never a deriver because of what it is called: there is no spelling you can give
; an ordinary `defn` that makes `(derive Eq T)` find it, and `defderive` is sugar
; that writes the registration for you rather than a second, implicit path.
;
; That is the whole reason this table exists instead of a name convention. A
; convention makes every `[Code] -> Code` function in the program a potential
; deriver by accident, and makes the answer to "what derives Eq here?" a question
; about spelling rather than about a declaration you can grep for.
;
; Every name stored is QUALIFIED. A registration's trait is resolved where the
; registration was written (`resolve-trait-ref`), and so is the trait a `derive`
; names, so `Eq` in a module that declares its own `Eq` is that module's trait,
; and two modules' `Show` are two traits. The arms are resolved through
; `resolve-macro`, so the call a macro emits resolves wherever the expansion
; lands — the hazard `code-variant-qname` and `code-field-qtype` exist to fix.

;;; One registered trait. An arm is "" when the deriver does not support that
;;; shape, which is a DECLARATION — it is what lets `(derive Hash SomeSum)` fail
;;; with a sentence about Hash instead of a reflection error from inside a macro.
;;; TRAIT is "" while the trait SPELLED (in module OWNER) names is not declared
;;; yet: a macro may generate it later in the expansion.
(defstruct DeriveEnt
  [(trait (slice u8))
   (arm_struct (slice u8))
   (arm_sum (slice u8))
   (owner (slice u8))
   (spelled (slice u8))])

(defstruct DeriveReg [(items (ArrayList DeriveEnt)) (init i64)])

(defn derive-reg [] (-> (ptr DeriveReg))
  (field (comptime-unit-state) derivations))

;;; Invalidated at the top of every `run-expand`, for the same reason the macro
;;; index is: a second run in one process must not inherit the first one's table.
(defn derive-reg-reset! [] (-> i64)
  (let [r (derive-reg)]
    (if (= (.init r) 0)
        (set! (.items r) (ArrayList::new [DeriveEnt] (unit-allocator)))
        (clear! (mut (.items r))))
    (set! (.init r) 1)
    0))

(defn derive-reg-ready [] (-> (ptr DeriveReg))
  (let [r (derive-reg)]
    (when (= (.init r) 0)
      (derive-reg-reset!)
      0)
    r))

(defn derive-owner-module [(owner (slice u8))] (-> (Option (slice u8)))
  (if (= owner "") (None [(slice u8)]) (Some owner)))

;;; The settled registration for the trait TRAIT (a qualified name), or null.
(defn derive-reg-settled [(trait (slice u8))] (-> (ptr DeriveEnt))
  (let [lst (field (derive-reg-ready) items)]
    (block :found
      (for [i 0 (len (load lst))]
        (let [e (elem lst i)]
          (when (and (!= (.trait e) "") (= (.trait e) trait))
            (break :found e))))
      (primitive/cast (ptr DeriveEnt) 0))))

;;; Duplicate registration is an ERROR, not last-wins: two modules each claiming to
;;; derive `Eq` is an ambiguity the program has to resolve, and silently picking one
;;; would make which impl you get depend on load order.
(defn derive-reg-duplicate [(trait (slice u8))] (-> (Option Diag))
  (let [prev (derive-reg-settled trait)]
    (if (= (primitive/cast i64 prev) 0)
        (None [Diag])
        (Some (derr (text/format (unit-allocator)
                                 "register-derive: trait '{}{}"
                                 trait
                                 (text/format (unit-allocator)
                                              "' already has a deriver, registered in '{}'"
                                              (.owner prev))))))))

;;; Register the deriver arms ASTRUCT and ASUM for the trait SPELLED names in
;;; MODULE. A spelling that names no trait yet is kept pending (see DeriveEnt).
(defn derive-reg-put! [(spelled (slice u8))
                       (astruct (slice u8))
                       (asum (slice u8))
                       (module (Option (slice u8)))
                       (impb (ptr (ArrayList ImpEntry)))
                       (expb (ptr (ArrayList ExpEntry)))
                       (a (dyn Allocator))] (-> (Option Diag))
  (match (resolve-trait-ref spelled
                            module
                            (primitive/cast (ptr CtCtx) 0)
                            impb
                            expb
                            a)
    (Err [d] (Some d))
    (Ok [found]
        (let [trait (match found (Some [q] (ct-own-str q)) (None [] ""))]
          (match (if (= trait "") (None [Diag]) (derive-reg-duplicate trait))
            (Some [d] (Some d))
            (None []
                  (let [(mut e) (zeroed DeriveEnt)]
                    (set! (.trait e) trait)
                    (set! (.arm_struct e) (ct-own-str astruct))
                    (set! (.arm_sum e) (ct-own-str asum))
                    (set! (.owner e)
                          (ct-own-str (match module (Some [m] m) (None [] ""))))
                    (set! (.spelled e) (ct-own-str spelled))
                    (push! (mut (.items (derive-reg-ready))) e)
                    (None [Diag]))))))))

;;; Resolve every pending registration whose trait is declared now.
(defn derive-reg-settle! [(impb (ptr (ArrayList ImpEntry)))
                          (expb (ptr (ArrayList ExpEntry)))
                          (a (dyn Allocator))] (-> (Option Diag))
  (let [lst (field (derive-reg-ready) items)]
    (block :settle
      (for [i 0 (len (load lst))]
        (let [e (elem lst i)]
          (when (= (.trait e) "")
            (match (resolve-trait-ref (.spelled e)
                                      (derive-owner-module (.owner e))
                                      (primitive/cast (ptr CtCtx) 0)
                                      impb
                                      expb
                                      a)
              (Err [d] (break :settle (Some d)))
              (Ok [found]
                  (match found
                    (None [] 0)
                    (Some [q]
                          (match (derive-reg-duplicate q)
                            (Some [d] (break :settle (Some d)))
                            (None [] (do (set! (.trait e) (ct-own-str q)) 0))))))))))
      (None [Diag]))))

;;; At the end of an expansion: a registration whose trait was never declared is
;;; an error at last.
(defn derive-reg-finish! [(impb (ptr (ArrayList ImpEntry)))
                          (expb (ptr (ArrayList ExpEntry)))
                          (a (dyn Allocator))] (-> (Option Diag))
  (match (derive-reg-settle! impb expb a)
    (Some [d] (Some d))
    (None []
          (let [lst (field (derive-reg-ready) items)]
            (block :pending
              (for [i 0 (len (load lst))]
                (let [e (elem lst i)]
                  (when (= (.trait e) "")
                    (break
                      :pending
                        (Some (derr (text/format a
                                                 "register-derive: '{}' in module '{}' does not name a trait"
                                                 (.spelled e)
                                                 (.owner e))))))))
              (None [Diag]))))))

;;; The registration for TRAIT (a qualified name), or null.
(defn derive-reg-find [(trait (slice u8))
                       (impb (ptr (ArrayList ImpEntry)))
                       (expb (ptr (ArrayList ExpEntry)))
                       (a (dyn Allocator))] (-> (Result (ptr DeriveEnt) Diag))
  (match (derive-reg-settle! impb expb a)
    (Some [d] (Err [(ptr DeriveEnt) Diag] d))
    (None [] (Ok [(ptr DeriveEnt) Diag] (derive-reg-settled trait)))))

;;; The module whose scope the symbol NODE was written in: its hygiene module when
;;; a macro template wrote it (None for a fresh identifier, which names nothing
;;; global), else the module its source belongs to (None when that is unknown).
(defn ct-node-module [(node Sexp)] (-> (Option (slice u8)))
  (if (> (sx-hyg node) 0)
      (let [m (sx-hmod node)]
        (if (= (len m) 0) (None [(slice u8)]) (Some m)))
      (let [m (src-mod-lookup (sx-source node))]
        (if (= (len m) 0) (None [(slice u8)]) (Some m)))))

;;; The trait the type argument at IDX names where it was written: its qualified
;;; name, None when no trait of that spelling is in scope there.
(defn ct-trait-arg [(args (ptr (ArrayList CtVal))) (idx i64) (cx (ptr CtCtx))]
  (-> (Result (Option (slice u8)) Diag))
  (match (cv-get args idx)
    (None []
          (Err [(Option (slice u8)) Diag]
               (derr "code-deriver: expects (primitive/code-deriver TRAIT TYPE) with two type symbols")))
    (Some [v]
          (if (or (not (is-ccode v)) (!= (sx-tag (ccode-of v)) 2))
              (Err [(Option (slice u8)) Diag]
                   (derr "code-deriver: expects (primitive/code-deriver TRAIT TYPE) with two type symbols"))
              (if (or (= (primitive/cast i64 (.all_imports cx)) 0)
                      (= (primitive/cast i64 (.all_exports cx)) 0))
                  (Err [(Option (slice u8)) Diag]
                       (derr "code-deriver: a trait is resolved only while macros expand"))
                  (let [node (ccode-of v)]
                    (resolve-trait-ref (sx-sval node)
                                       (ct-node-module node)
                                       (primitive/cast (ptr CtCtx) 0)
                                       (.all_imports cx)
                                       (.all_exports cx)
                                       (.a cx))))))))

;;; The type symbol a reflection op's argument IDX names: `Node`, or the head of
;;; the instantiation `(Gen A B)`, whose arguments are pushed onto TARGS unless it
;;; is null. None when the argument is neither.
(defn refl-type-node [(args (ptr (ArrayList CtVal)))
                      (idx i64)
                      (targs (ptr (ArrayList Sexp)))] (-> (Option Sexp))
  (match (cv-get args idx)
    (None [] (None [Sexp]))
    (Some [v]
          (if (not (is-ccode v))
              (None [Sexp])
              (let [node (ccode-of v)
                    tg (sx-tag node)]
                (cond (and (or (= tg 6) (= tg 7))
                           (and (>= (sx-len (sx-items node)) 1)
                                (= (sx-tag (sx-at (sx-items node) 0)) 2)))
                        (do
                          (unless (= (primitive/cast i64 targs) 0)
                            (for [i 1 (sx-len (sx-items node))]
                              (push! [Sexp] targs (sx-at (sx-items node) i)))
                            0)
                          (Some (sx-at (sx-items node) 0)))
                      (= tg 2) (Some node)
                      :else (None [Sexp])))))))

;;; Was the derive target written as a bare name, `Pair`, rather than `(Pair T)`?
(defn derive-target-bare? [(args (ptr (ArrayList CtVal)))] (-> bool)
  (match (cv-get args 1)
    (Some [v] (and (is-ccode v) (= (sx-tag (ccode-of v)) 2)))
    (None [] false)))

;;; The type-parameter count of the struct SD or the sum UD (0 when both are null).
(defn derive-target-type-params [(sd (ptr StructDef)) (ud (ptr SumDef))]
  (-> i64)
  (cond (!= (primitive/cast i64 sd) 0)
          (len (load (load (field sd type_params))))
        (!= (primitive/cast i64 ud) 0)
          (len (load (load (field ud type_params))))
        :else 0))

;;; `(primitive/code-deriver TRAIT TYPE)` — the registered deriver for TRAIT,
;;; already chosen for TYPE's shape.
;;;
;;; Taking the TYPE as well as the trait is what keeps `code-struct?`/`code-sum?`
;;; out of the language: the compiler already knows which shape `TYPE` is, so the
;;; arm choice and the diagnostic for a missing arm both live here, in one place,
;;; instead of being re-derived by every `derive` implementation.
(defn cop-deriver [(args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (match (ct-trait-arg args 0 cx)
    (Err [d] (Err [CtVal Diag] d))
    (Ok [found]
        (match found
          (Some [trait] (cop-deriver-for trait args cx))
          (None []
                (Err [CtVal Diag]
                     (derr (text/format (.a cx)
                                        "derive: '{}' does not name a trait in scope here"
                                        (sx-sval (ccode-of (get (load args) 0)))))))))))

;;; `cop-deriver` once its trait argument has resolved to TRAIT.
(defn cop-deriver-for [(trait (slice u8))
                       (args (ptr (ArrayList CtVal)))
                       (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (.a cx)]
    (match (derive-reg-find trait (ct-imports cx) (ct-exports cx) a)
      (Err [d] (Err [CtVal Diag] d))
      (Ok [ent]
          (cond (= (primitive/cast i64 ent) 0)
                  (Err [CtVal Diag]
                       (derr (text/format a
                                          "derive: no deriver is registered for trait '{}' — declare one with (defderive …), and check that the module declaring it is imported here"
                                          trait)))
                :else
                  (match (refl-type-node args
                                         1
                                         (primitive/cast (ptr (ArrayList Sexp))
                                                         0))
                    (None []
                          (Err [CtVal Diag]
                               (derr "code-deriver: expects (primitive/code-deriver TRAIT TYPE) with two type symbols")))
                    (Some [node]
                          (match (ct-resolve-type-ref cx node)
                            (Err [d] (Err [CtVal Diag] d))
                            (Ok [tname]
                                (let [sd (ct-struct-find cx tname)
                                      ud (ct-sum-find cx tname)]
                                  (cond (and (derive-target-bare? args)
                                             (> (derive-target-type-params sd
                                                                           ud)
                                                0))
                                          (Err [CtVal Diag]
                                               (derr (text/format a
                                                                  "derive: '{}' is generic; name its parameters, as in (derive Trait (Type T))"
                                                                  tname)))
                                        (!= (primitive/cast i64 sd) 0)
                                          (if (= (.arm_struct ent) "")
                                              (Err [CtVal Diag]
                                                   (derr (text/format a
                                                                      "derive: trait '{}' has no deriver for structs (its registration declares no `struct` arm); write the impl by hand"
                                                                      trait)))
                                              (Ok [CtVal Diag]
                                                  (CCode (sx-sym (.arm_struct ent)))))
                                        (!= (primitive/cast i64 ud) 0)
                                          (if (= (.arm_sum ent) "")
                                              (Err [CtVal Diag]
                                                   (derr (text/format a
                                                                      "derive: trait '{}' has no deriver for sums (its registration declares no `sum` arm); write the impl by hand"
                                                                      trait)))
                                              (Ok [CtVal Diag]
                                                  (CCode (sx-sym (.arm_sum ent)))))
                                        :else
                                          (Err [CtVal Diag]
                                               (derr (text/format a
                                                                  "derive: '{}' is neither a struct nor a sum"
                                                                  tname))))))))))))))

;;; The struct or sum arg0 of a reflection op names: a type symbol `Node` or the
;;; head of an instantiation `(Gen A B)`, whose type-argument forms are pushed
;;; onto TARGS. "" when arg0 is neither form; an error when it names nothing in
;;; scope where it was written.
(defn refl-type-inst [(cx (ptr CtCtx))
                      (args (ptr (ArrayList CtVal)))
                      (targs (ptr (ArrayList Sexp)))]
  (-> (Result (slice u8) Diag))
  (match (refl-type-node args 0 targs)
    (None [] (Ok [(slice u8) Diag] ""))
    (Some [node] (ct-resolve-type-ref cx node))))

(defn cop-field [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)
        targs (new-boxed-list [Sexp] a)]
    (match (refl-type-inst cx args targs)
      (Err [d] (Err [CtVal Diag] d))
      (Ok [tname]
          (if (= tname "")
              (Err [CtVal Diag]
                   (derr (match (cv-get args 0)
                           (None []
                                 "comptime: code-field-* expects a type symbol or instantiation (Gen …); received no value")
                           (Some [v]
                                 (if (is-ccode v)
                                     (text/format a
                                                  "comptime: code-field-* expects a type symbol or instantiation (Gen …); received {}"
                                                  (sexp-display a (ccode-of v)))
                                     "comptime: code-field-* expects a type symbol or instantiation (Gen …); received a non-Code value")))))
              (let [sd (ct-struct-find cx tname)]
                (if (= (primitive/cast i64 sd) 0)
                    (Err [CtVal Diag]
                         (derr (text/format a
                                            "comptime: '{}' is not a struct (primitive/field reflection needs a struct; sums unsupported)"
                                            tname)))
                    (if (= op 14)
                        (Ok [CtVal Diag] (CInt (len (load (field sd fields)))))
                        (match (cv-get args 1)
                          (None []
                                (Err [CtVal Diag]
                                     (derr "comptime: code-field-* index must be an integer")))
                          (Some [iv]
                                (if (!= (ct-tag iv) 0)
                                    (Err [CtVal Diag]
                                         (derr "comptime: code-field-* index must be an integer"))
                                    (let [i (cint-of iv)
                                          flds (load (field sd fields))
                                          nf (len (load flds))]
                                      (if (or (< i 0)
                                              (>= i nf))
                                          (Err [CtVal Diag]
                                               (derr (text/format a
                                                                  "comptime: field index {} out of range"
                                                                  (dec->str a i))))
                                          (let [fp (elem flds i)
                                                fname (.name fp)
                                                ftyp (field fp ty)
                                                hasargs
                                                  (> (len (load targs))
                                                     0)]
                                            (cond (= op 15)
                                                    (Ok [CtVal Diag]
                                                        (CCode (sx-sym fname)))
                                                  (= op 16)  ; kind: substituted when an instantiation was given, else EXACTLY as before
                                                    (if (not hasargs)
                                                        (Ok [CtVal Diag]
                                                            (CInt (type-kind-tag (load ftyp)
                                                                                 cx)))
                                                        (match (parse-type a
                                                                           (subst-type-code (type->code ftyp)
                                                                                            (load (field sd
                                                                                                         type_params))
                                                                                            targs))
                                                          (Ok [st]
                                                              (Ok [CtVal Diag]
                                                                  (CInt (type-kind-tag st
                                                                                       cx))))
                                                          (Err [d]
                                                               (Ok [CtVal Diag]
                                                                   (CInt (type-kind-tag (load ftyp)
                                                                                        cx))))))
                                                  ; Preserve the complete field type syntax.  Returning only
                                                  ; `type-name-str` here discarded arguments from fields such as
                                                  ; `(ArrayList i64)`, preventing structural derivers from
                                                  ; recursively selecting a policy for the actual field type.
                                                  hasargs
                                                    (Ok [CtVal Diag]
                                                        (CCode (subst-type-code (type->code ftyp)
                                                                                (load (field sd
                                                                                             type_params))
                                                                                targs)))
                                                  :else
                                                    (if (= op
                                                           50)
                                                        ; Nominal types answer with their qualified
                                                        ; name; structural types (pointers, function
                                                        ; pointers, vectors) with their complete syntax.
                                                        (Ok [CtVal Diag]
                                                            (match (load ftyp)
                                                              (TStruct [n]
                                                                       (CCode (sx-sym n)))
                                                              (TApp [n ar]
                                                                    (CCode (sx-sym n)))
                                                              (_ (CCode (type->code ftyp)))))
                                                        (Ok [CtVal Diag]
                                                            (CCode (type->code ftyp)))))))))))))))))))

;;; `(code-type-traits TYPE)`: the traits TYPE implements, as a list of their
;;; qualified names. TYPE is a type as `type-of` reports it. A trait counts when
;;; the checker would accept a use of it at TYPE: an impl is selected and its
;;; bounds hold there (`impl-holds?`). A generic impl such as `(impl [T] Eq (ptr T))`
;;; covers every pointer, and `(impl [(T Debug)] Debug (Option T))` covers
;;; `(Option S)` only when S has Debug. Reads the checked program, so it answers
;;; `:unresolved` where there is none (a macro expanding before checking).
(defn cop-type-traits [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)
        p (sem-model)
        checker (.checker (sem-model-box))]
    (match (cv-get args 0)
      (None []
            (Err [CtVal Diag]
                 (derr "code-type-traits: expects (primitive/code-type-traits TYPE)")))
      (Some [v]
            (cond (not (is-ccode v))
                    (Err [CtVal Diag]
                         (derr "code-type-traits: expects a type as Code"))
                  (or (= (primitive/cast i64 p) 0)
                      (= (primitive/cast i64 checker) 0))
                    (answer op (answer0 a "TraitsUnknown") cx)
                  :else
                    ; TYPE names its types qualified, as type-of reports them, so the
                    ; lexical context a template gave them has nothing to add, and
                    ; parsed with it a quasiquoted `coil.core.Option` named no type.
                    (match (parse-type a (stage-datum-sexp a (ccode-of v)))
                      (Err [d] (Err [CtVal Diag] d))
                      (Ok [t]
                          (let [tp (box-type a t)
                                impls (load (field p impls))
                                (mut names) (ArrayList::new [(slice u8)] a)
                                (mut items) (ArrayList::new [Sexp] a)]
                            (for [i 0 (len (load impls))]
                              (let [im (elem impls i)]
                                (when (impl-is-trait im)
                                  (let [name (impl-trait-name im)
                                        (mut seen) false]
                                    (for [j 0 (len names)]
                                      (when (= (get names j) name)
                                        (set! seen true)))
                                    (unless seen
                                      (push! (mut names) name)
                                      (when (impl-holds? a checker name tp)
                                        (push! (mut items) (sx-sym name))
                                        0)
                                      0)))))
                            (answer op
                                    (answer1 a
                                             "TraitsAre"
                                             (CCode (mk-sexp (KList (box-al a
                                                                            (load items)))
                                                             -1
                                                             -1)))
                                    cx)))))))))

(defn cop-type-shape [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)]
    (match (refl-type-node args 0 (primitive/cast (ptr (ArrayList Sexp)) 0))
      (None []
            (Err [CtVal Diag]
                 (derr "comptime: code-type-shape expects a type symbol or instantiation (Gen …)")))
      (Some [node]
            ; A name that is no struct or sum in scope (`i64`, a type parameter, a
            ; type of a module not imported) has an unknown shape.
            (answer op
                    (try (let [tname
                                 (try-or! (ct-resolve-type-ref cx node)
                                          (answer0 a "UnknownShape"))]
                           (cond (!= (primitive/cast i64
                                                     (ct-struct-find cx tname))
                                     0)
                                   (answer0 a "StructShape")
                                 (!= (primitive/cast i64 (ct-sum-find cx tname))
                                     0)
                                   (answer0 a "SumShape")
                                 :else (answer0 a "UnknownShape"))))
                    cx)))))

; The bare variant name, stripped of EITHER qualifier form. `after-last-dot` handles
; the fully-qualified `coil.socket.Closed`, but a variant reached through an alias
; import is written `socket/Closed`, and a slash is just as much a qualifier. Without
; this, a reflected variant name spelled `socket/Closed` failed with "'socket/Closed'
; is not a known variant" while the very same spelling worked in a plain `match` —
; reflection was the only part of the language that could not read an alias-qualified
; name.
(defn after-last-qualifier [(s (slice u8))] (-> (slice u8))
  (let [t (after-last-dot s)
        n (len t)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) 0)
              (break)
              (do
                (when (= (primitive/cast i64 (get t (load i)))
                         47)
                  (set! at (load i))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (if (< (load at) 0)
        t
        (subslice [u8] t (primitive/iadd (load at) 1) n))))

(defn cop-variant [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)
        targs (new-boxed-list [Sexp] a)]
    (if (= op 18)
        (match (code-symnode args)
          (None []
                (Err [CtVal Diag]
                     (derr "comptime: code-variant-* expects a symbol")))
          (Some [node]
                (match (ct-resolve-variant-ref cx node)
                  (Err [d] (Err [CtVal Diag] d))
                  (Ok [sd] (Ok [CtVal Diag] (CCode (sx-sym (.name sd))))))))
        (match (refl-type-inst cx args targs)
          (Err [d] (Err [CtVal Diag] d))
          (Ok [arg]
              (if (= arg "")
                  (Err [CtVal Diag]
                       (derr "comptime: code-variant-* expects a symbol"))
                  (let [sd (ct-sum-find cx arg)]
                    (if (= (primitive/cast i64 sd) 0)
                        (Err [CtVal Diag]
                             (derr (text/format a
                                                "comptime: '{}' is not a known sum"
                                                arg)))
                        (if (= op 19)
                            (Ok [CtVal Diag]
                                (CInt (len (load (field sd variants)))))
                            (match (cv-get args 1)
                              (None []
                                    (Err [CtVal Diag]
                                         (derr "comptime: code-variant-* index must be an integer")))
                              (Some [iv]
                                    (if (!= (ct-tag iv) 0)
                                        (Err [CtVal Diag]
                                             (derr "comptime: code-variant-* index must be an integer"))
                                        (let [i (cint-of iv)
                                              vs (load (field sd variants))
                                              nv (len (load vs))]
                                          (if (or (< i 0)
                                                  (>= i nv))
                                              (Err [CtVal Diag]
                                                   (derr (text/format a
                                                                      "comptime: variant index {} out of range"
                                                                      (dec->str a
                                                                                i))))
                                              (let [vp (elem vs i)]
                                                (cond (= op
                                                         20)
                                                        (Ok [CtVal Diag]
                                                            (CCode (sx-sym (after-last-dot (.name vp)))))
                                                      ; 49: the name as STORED — fully
                                                      ; qualified, so generated code
                                                      ; resolves under any import style
                                                      (= op
                                                         49)
                                                        (Ok [CtVal Diag]
                                                            (CCode (sx-sym (.name vp))))
                                                      (= op
                                                         21)
                                                        (Ok [CtVal Diag]
                                                            (CInt (len (load (field vp
                                                                                    fields)))))
                                                      ; ops 47/48: a third argument selects the payload field
                                                      :else
                                                        (match (cv-get args 2)
                                                          (None []
                                                                (Err [CtVal Diag]
                                                                     (derr "comptime: code-variant-field-* takes (SUM VARIANT-INDEX FIELD-INDEX)")))
                                                          (Some [fv]
                                                                (if (!= (ct-tag fv)
                                                                        0)
                                                                    (Err [CtVal
                                                                          Diag]
                                                                         (derr "comptime: code-variant-field-* field index must be an integer"))
                                                                    (let [fi
                                                                            (cint-of fv)
                                                                          fs
                                                                            (load (field vp
                                                                                         fields))
                                                                          nf
                                                                            (len (load fs))]
                                                                      (if (or (< fi
                                                                                 0)
                                                                              (>= fi
                                                                                  nf))
                                                                          (Err [CtVal
                                                                                Diag]
                                                                               (derr (text/format a
                                                                                                  "comptime: variant field index {} out of range"
                                                                                                  (dec->str a
                                                                                                            fi))))
                                                                          (let [fp
                                                                                  (elem fs
                                                                                        fi)]
                                                                            (if (= op
                                                                                   47)
                                                                                (Ok [CtVal
                                                                                     Diag]
                                                                                    (CCode (sx-sym (.name fp))))
                                                                                ; 48: the structured type with the
                                                                                ; reflected sum's arguments applied.
                                                                                (Ok [CtVal
                                                                                     Diag]
                                                                                    (CCode (if (> (len (load targs))
                                                                                                  0)
                                                                                               (subst-type-code (type->code (field fp
                                                                                                                                   ty))
                                                                                                                (load (field sd
                                                                                                                             type_params))
                                                                                                                targs)
                                                                                               (type->code (field fp
                                                                                                                  ty))))))))))))))))))))))))))))

(defn cop-trait [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)]
    (match (code-symnode args)
      (None []
            (Err [CtVal Diag]
                 (derr "comptime: code-trait-* expects a trait symbol")))
      (Some [node]
            (match (ct-resolve-trait-ref cx node)
              (Err [d] (Err [CtVal Diag] d))
              (Ok [tname]
                  (let [td (ct-trait-find cx tname)]
                    (if (= (primitive/cast i64 td) 0)
                        (Err [CtVal Diag]
                             (derr (text/format a
                                                "comptime: '{}' is not a known trait"
                                                tname)))
                        (if (= op 22)
                            (Ok [CtVal Diag]
                                (CInt (len (load (field td methods)))))
                            (match (cv-get args 1)
                              (None []
                                    (Err [CtVal Diag]
                                         (derr "comptime: code-trait-* method index must be an integer")))
                              (Some [mv]
                                    (if (!= (ct-tag mv) 0)
                                        (Err [CtVal Diag]
                                             (derr "comptime: code-trait-* method index must be an integer"))
                                        (let [mi (cint-of mv)
                                              ms (load (field td methods))
                                              nm (len (load ms))]
                                          (if (or (< mi 0)
                                                  (>= mi nm))
                                              (Err [CtVal Diag]
                                                   (derr (text/format a
                                                                      "comptime: trait method index {} out of range"
                                                                      (dec->str a
                                                                                mi))))
                                              (let [m (elem ms mi)]
                                                (cop-trait-method op args m cx))))))))))))))))

(defn cop-trait-method [(op i64)
                        (args (ptr (ArrayList CtVal)))
                        (m (ptr TraitMethod))
                        (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [a (.a cx)]
    (cond (= op 23) (Ok [CtVal Diag] (CCode (sx-sym (.name m))))
          (= op 24) (Ok [CtVal Diag] (CInt (len (load (field m params)))))
          (= op 27) (Ok [CtVal Diag] (CCode (type->code (field m ret))))
          :else
            (match (cv-get args 2)
              (None []
                    (Err [CtVal Diag]
                         (derr "comptime: code-trait-param-* needs a method index and a param index")))
              (Some [pv]
                    (if (!= (ct-tag pv) 0)
                        (Err [CtVal Diag]
                             (derr "comptime: code-trait-param-* needs a method index and a param index"))
                        (let [pj (cint-of pv)
                              ps (load (field m params))
                              np (len (load ps))]
                          (if (or (< pj 0) (>= pj np))
                              (Err [CtVal Diag]
                                   (derr (text/format a
                                                      "comptime: trait param index {} out of range"
                                                      (dec->str a pj))))
                              (let [p (elem ps pj)]
                                (if (= op 25)
                                    (Ok [CtVal Diag]
                                        (CCode (sx-sym (.name p))))
                                    (Ok [CtVal Diag]
                                        (CCode (type->code (field p ty))))))))))))))

(defn cop-strbytes [(args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)]
    (match (cv-get args 0)
      (None [] (Err [CtVal Diag] (derr "comptime: str-bytes expects a string")))
      (Some [v]
            (let [ok
                    (or (is-cstr v)
                        (and (is-ccode v)
                             (= (sx-tag (ccode-of v)) 4)))]
              (if (not ok)
                  (Err [CtVal Diag]
                       (derr "comptime: str-bytes expects a string"))
                  (let [s (if (is-cstr v) (cstr-of v) (sx-sval (ccode-of v)))
                        n (len s)
                        (mut xs) (ArrayList::new [Sexp] a)]
                    (for [i 0 n]
                      (push! (mut xs)
                             (sx-mkint (primitive/cast i64
                                                       (get s
                                                            i)))))
                    (Ok [CtVal Diag]
                        (CCode (sx-mklist (box-al a (load xs))))))))))))

(defn cop-bytestostr [(args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)]
    (match (cv-get args 0)
      (None [] (Err [CtVal Diag] (derr "comptime: bytes->str expects a list")))
      (Some [v]
            (let [islist
                    (and (is-ccode v)
                         (let [tg (sx-tag (ccode-of v))]
                           (or (= tg 6)
                               (= tg 7))))]
              (if (not islist)
                  (Err [CtVal Diag]
                       (derr "comptime: bytes->str expects a list"))
                  (let [items (sx-items (ccode-of v))
                        n (sx-len items)
                        (mut buf) (ArrayList::new [u8] a)
                        (mut errf) (None [Diag])
                        (mut i) 0]
                    (loop (if (or (diag-some? (load errf)) (>= (load i) n))
                              (break)
                              (do
                                (let [it (sx-at items (load i))]
                                  (if (= (sx-tag it) 0)
                                      (do
                                        (push! (mut buf)
                                               (primitive/cast u8 (sx-ival it)))
                                        0)
                                      (do
                                        (set! errf
                                              (Some (derr "comptime: bytes->str list must be all ints")))
                                        0)))
                                (set! i (primitive/iadd (load i) 1)))))
                    (match (load errf)
                      (Some [d] (Err [CtVal Diag] d))
                      (None []
                            (Ok [CtVal Diag]
                                (CCode (sx-mkstr (slice (load buf))))))))))))))

; op 38 — int->str: an integer (or int Code) to its decimal (slice u8), so name
; generation from a counter/index is a one-liner instead of round-tripping bytes->str.
(defn cop-inttostr [(args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)]
    (match (cv-get args 0)
      (None []
            (Err [CtVal Diag] (derr "comptime: int->str expects an integer")))
      (Some [v]
            (if (= (ct-tag v) 0)
                (Ok [CtVal Diag] (CStr (i64->str a (cint-of v))))
                (if (and (is-ccode v)
                         (= (sx-tag (ccode-of v)) 0))
                    (Ok [CtVal Diag] (CStr (i64->str a (sx-ival (ccode-of v)))))
                    (Err [CtVal Diag]
                         (derr "comptime: int->str expects an integer"))))))))

; ---- KView node accessors (docs/design/META_MEMORY.md phase 5) ----------------
; The ONLY code allowed inside a KView. A view is an O(1) window into another
; list's items (what code-rest/code-slice return); sx-info deliberately reports
; it with NULL items so compiler-plane code cannot silently read the parent at
; the wrong offset. Everything at the code-op layer reads through these instead,
; and promotion at the expansion boundary flattens views back to KList.
(defstruct ViewInfo [(items (ptr (ArrayList Sexp))) (off i64) (len i64)])

(defn code-node-parts [(s Sexp)] (-> ViewInfo)
  (let [(mut p) (zeroed ViewInfo)
        (mut sp) (: s Sexp)]
    (set! (.items p) (primitive/cast (ptr (ArrayList Sexp)) 0))
    (set! (.off p) 0)
    (set! (.len p) 0)
    (match (.kind sp)
      (KView [dc]
             (let [it (.items dc)
                   off (.off dc)
                   len (.len dc)]
               (do
                 (set! (.items p) it)
                 (set! (.off p) off)
                 (set! (.len p) len)
                 0)))
      (KList [it] (do (set! (.items p) it) (set! (.len p) (sx-len it)) 0))
      (KVec [it] (do (set! (.items p) it) (set! (.len p) (sx-len it)) 0))
      ; a joined list reads as a list laid out once: the first read lays out its
      ; parts into its own cache and every later read finds them there
      (KSeg [dc]
            (let [parts (.parts dc)
                  n (.len dc)
                  flat (.flat dc)]
              (do
                (set! (.items p) (seg-force parts n flat))
                (set! (.len p) n)
                0)))
      (_ 0))
    p))

(defn code-node-listish? [(s Sexp)] (-> bool)
  (let [tg (sx-tag s)]
    (or (= tg 6) (= tg 7) (= tg 8))))

;;; How many items a list node holds. A joined list knows without laying itself
;;; out, which is what lets recursion that only joins and counts stay cheap.
(defn code-node-len [(s Sexp)] (-> i64)
  (match (.kind s)
    (KSeg [dc] (let [n (.len dc)] n))
    (_ (let [(mut p) (code-node-parts s)] (.len p)))))

;;; caller bounds-checks against code-node-len
(defn code-node-at [(s Sexp) (i i64)] (-> Sexp)
  (let [p (primitive/alloc-stack ViewInfo)]
    (set! p (code-node-parts s))
    (sx-at (load (field p items)) (primitive/iadd (.off p) i))))

;;; The live element `code-node-at` would copy. Item arrays of a finished node are
;;; never written again, so the pointer stays valid as long as the node's storage;
;;; caller bounds-checks against code-node-len.
(defn code-node-at-ref [(s Sexp) (i i64)] (-> (ptr Sexp))
  (let [p (primitive/alloc-stack ViewInfo)]
    (set! p (code-node-parts s))
    (elem (load (field p items)) (primitive/iadd (.off p) i))))

;;; an O(1) sub-window [lo, hi) of a listish node; composes so a view of a view
;;; stays one level deep. Result is list-typed (as code-rest always was, even of
;;; a vector).
(defn code-node-window [(s Sexp) (lo i64) (hi i64)] (-> Sexp)
  (let [p (primitive/alloc-stack ViewInfo)
        sp (primitive/alloc-stack Sexp)]
    (set! p (code-node-parts s))
    (set! sp s)
    (mk-sexp-src (KView (box! (unit-allocator)
                              SexpView
                              (SexpView
                                :items (load (field p items))
                                :off (primitive/iadd (.off p) lo)
                                :len (primitive/isub hi lo))))
                 sp)))

;;; view-aware structural equality: a view compares as the list it denotes
(defn sexp-eq-nodes [(x Sexp) (y Sexp)] (-> bool)
  (let [n (code-node-len x)]
    (if (!= n (code-node-len y))
        false
        (let [(mut i) 0
              (mut r) true]
          (loop (if (>= (load i) n)
                    (break)
                    (if (sexp-eq (code-node-at x (load i))
                                 (code-node-at y (load i)))
                        (set! i (primitive/iadd (load i) 1))
                        (do (set! r false) (break)))))
          (load r)))))

(defn cop-codearg [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)]
    (match (cv-get args 0)
      (None []
            (Err [CtVal Diag] (derr "comptime: code op expects a Code value")))
      (Some [v0]
            (if (not (is-ccode v0))
                (Err [CtVal Diag]
                     (derr "comptime: code op expects a Code value"))
                (let [code (ccode-of v0)
                      tg (sx-tag code)]
                  (cond (= op 0)
                          (Ok [CtVal Diag] (CBool (code-node-listish? code)))
                        (= op 1)
                          (Ok [CtVal Diag]
                              (CBool (= tg 2)))
                        (= op 2)
                          (Ok [CtVal Diag]
                              (CBool (= tg 0)))
                        (= op 11)
                          (Ok [CtVal Diag]
                              (CBool (= tg 3)))
                        (= op 54)
                          (Ok [CtVal Diag]
                              (CBool (= tg 7)))
                        (= op 55)
                          (Ok [CtVal Diag]
                              (CBool (= tg 1)))
                        (= op 73)
                          (Ok [CtVal Diag]
                              (CBool (= tg 4)))
                        (= op 56)
                          (if (= tg 1)
                              (Ok [CtVal Diag] (CInt (sx-ival code)))
                              (Err [CtVal Diag]
                                   (derr "comptime: code-float-bits expects a float literal")))
                        (= op 3)
                          (if (code-node-listish? code)
                              (Ok [CtVal Diag] (CInt (code-node-len code)))
                              (Err [CtVal Diag]
                                   (derr (ct-in-meta a
                                                     "comptime: code-count expects a list/vector"))))
                        (= op 81)
                          (if (= tg 3)
                              (Ok (CStr (sx-sval code)))
                              (Err (derr "code-keyword-name: expected a keyword")))
                        (= op 5)
                          (if (= tg 2)
                              (Ok [CtVal Diag] (CStr (sx-sval code)))
                              (Err [CtVal Diag]
                                   (derr "comptime: code-sym expects a symbol")))
                        (= op 6)
                          (if (= tg 0)
                              (Ok [CtVal Diag] (CInt (sx-ival code)))
                              (Err [CtVal Diag]
                                   (derr "comptime: code-int expects an integer")))
                        (= op 7)
                          ; O(1) VIEW of the tail, not a copy — cdr-recursion over
                          ; an n-form list used to allocate n²/2 nodes this way
                          ; (docs/design/META_MEMORY.md phase 5)
                          (if (code-node-listish? code)
                              (let [n (code-node-len code)]
                                (Ok [CtVal Diag]
                                    (CCode (code-node-window code
                                                             (if (> n
                                                                    0)
                                                                 1
                                                                 0)
                                                             n))))
                              (Err [CtVal Diag]
                                   (derr "comptime: code-rest expects a list")))
                        (= op 4)
                          (match (cv-get args 1)
                            (None []
                                  (Err [CtVal Diag]
                                       (derr "comptime: code-nth index must be an integer")))
                            (Some [iv]
                                  (if (!= (ct-tag iv) 0)
                                      (Err [CtVal Diag]
                                           (derr "comptime: code-nth index must be an integer"))
                                      (if (code-node-listish? code)
                                          (let [i (cint-of iv)]
                                            (if (or (< i 0)
                                                    (>= i (code-node-len code)))
                                                (Err [CtVal Diag]
                                                     (derr (text/format a
                                                                        "comptime: code-nth index {} out of range"
                                                                        (dec->str a
                                                                                  i))))
                                                (Ok [CtVal Diag]
                                                    (CCode (code-node-at code i)))))
                                          (Err [CtVal Diag]
                                               (derr (ct-in-meta a
                                                                 "comptime: code-nth expects a list/vector")))))))
                        :else
                          (match (cv-get args 1)
                            (None []
                                  (Err [CtVal Diag]
                                       (derr "comptime: code-eq expects two Code values")))
                            (Some [v1]
                                  (if (not (is-ccode v1))
                                      (Err [CtVal Diag]
                                           (derr "comptime: code-eq expects two Code values"))
                                      (Ok [CtVal Diag]
                                          (CBool (sexp-eq code (ccode-of v1))))))))))))))

;;; Compilation-scoped opaque Code handles (ops 71/72). Native phase programs —
;;; staged-metacompilation entries such as compiled Scheme transformers — need to
;;; retain exact syntax nodes inside their own tagged data structures, but Code
;;; intentionally has no runtime representation. A checked table index crosses
;;; that boundary without exposing an arena pointer or letting an arbitrary
;;; integer become one. The boxed node lives in the INVOCATION's allocator, so a
;;; handle is valid for the expansion that made it — keeping one across
;;; invocations is the same use-after-reset any borrowed Code suffers, and
;;; COIL_META_ARENA=poison makes it loud.
(defn code-opaque-items [] (-> (ptr (array i64 1048576)))
  (let [cell (field (comptime-unit-state) opaque_items)]
    (when (= (primitive/cast i64 (load cell)) 0)
      ; Only indices below opaque_count are read; each is written before it is
      ; published. Avoid an eight-megabyte aggregate initializer on the stack.
      (match (alloc [i64] (unit-allocator) 1048576)
        (Some [items]
              (set! cell
                    (primitive/cast (ptr (array i64 1048576))
                                    (data items))))
        (None [] (oom-at c"opaque Code registry" 8388608)))
      0)
    (load cell)))

(defn code-opaque-count [] (-> (ptr i64))
  (field (comptime-unit-state) opaque_count))

(defn code-opaque-add [(a (dyn Allocator)) (code Sexp)] (-> i64)
  (let [i (load (code-opaque-count))]
    (if (>= i 1048576)
        0
        (do
          (set! (index (code-opaque-items) i)
                (primitive/cast i64 (box-sexp a code)))
          (set! (code-opaque-count) (+ i 1))
          (+ i 1)))))

(defn code-opaque-get [(handle i64)] (-> (ptr Sexp))
  (let [i (- handle 1)
        n (load (code-opaque-count))]
    (if (or (< i 0) (>= i n))
        (primitive/cast (ptr Sexp) 0)
        (primitive/cast (ptr Sexp)
                        (load (index (code-opaque-items) i))))))

(defn code-op [(op i64) (args (ptr (ArrayList CtVal))) (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (when (and (.observing (source-facts))
             ; Only structural transport/predicates are transparent to spelling.
             ; Reflection, concatenation, opaque handles and hygiene operations
             ; may inspect or derive an identifier; conservatively retain them.
             ; Location and display queries do not derive anything from a spelling:
             ; code-file, code-line and code-col read only the span, and code-src
             ; shows the user what they wrote, so it shows the edited text after an
             ; edit, as an assertion's failure message should.
             (cond (= op 0) false
                   (= op 1) false
                   (= op 2) false
                   (= op 3) false
                   (= op 33) false
                   (= op 40) false
                   (= op 41) false
                   (= op 42) false
                   (= op 4) false
                   (= op 6) false
                   (= op 7) false
                   (= op 11) false
                   (= op 54) false
                   (= op 55) false
                   (= op 56) false
                   (= op 73) false
                   (= op 60) false
                   (= op 61) false
                   (= op 62) false
                   (= op 63) false
                   (= op 64) false
                   (= op 65) false
                   (= op 74) false
                   :else true))
    (for value (load args)
      (when (is-ccode value) (source-observe! (ccode-of value)) 0))
    0)
  ; The structural ops a metaprogram actually spends its life on — code-list? (0),
  ; code-sym? (1), code-int? (2), code-count (3), code-nth (4), code-sym (5),
  ; code-int (6), code-rest (7), code-keyword? (11) — are handled by cop-codearg,
  ; which is this chain's FALLTHROUGH. Without this guard they pay every icmp below
  ; before reaching it. None of them is matched by any test in the chain, so routing
  ; them straight there is exactly the same dispatch, minus the search.
  (if (or (= op 81) (<= op 7) (= op 11) (= op 54) (= op 55) (= op 56) (= op 73))
      (cop-codearg op args cx)
      (let [a (.a cx)]
        (cond (= op 85)
                (Ok [CtVal Diag]
                    (CBool (!= (primitive/cast i64
                                               (load (field cx
                                                            code_session_state)))
                               0)))
              ; op 93 code-session-submission: this compilation's number in its
              ; session (only grows), or 0 outside a retained session
              (= op 93)
                (let [raw (load (field cx code_session_state))]
                  (Ok [CtVal Diag]
                      (CInt (if (= (primitive/cast i64 raw) 0)
                                0
                                (.submission (primitive/cast (ptr CodeSessionState)
                                                             raw))))))
              (or (= op 76) (= op 77) (= op 78) (= op 79) (= op 80) (= op 82))
                (cop-code-session-state op args cx)
              ; op 83 check-error: a CheckOutcome, the checker's message located at NODE
              (= op 83)
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (not (is-ccode nodev))
                            (Err [CtVal Diag]
                                 (derr "check-error: expects a Code node"))
                            (answer op
                                    (match (sem-model-error-at (ccode-of nodev))
                                      (Some [msg]
                                            (answer1 a
                                                     "FailsAt"
                                                     (CCode (sx-mkstr msg))))
                                      (None [] (answer0 a "ChecksClean")))
                                    cx)))
                  (None []
                        (Err [CtVal Diag]
                             (derr "check-error: expects (primitive/check-error NODE)"))))
              ; op 84 model-status: a ModelStatus
              (= op 84)
                (let [status (sem-model-status)]
                  (answer op
                          (answer0 a
                                   (cond (= status 2) "ModelComplete"
                                         (= status 1) "ModelPartial"
                                         :else "NoModel"))
                          cx))
              (= op 60)
                (if (= (len (load args)) 0)
                    (Ok [CtVal Diag]
                        (CCode (sx-mklist (new-boxed-list [Sexp] a))))
                    (Err [CtVal Diag]
                         (derr "code-list-new: expects no arguments")))
              (= op 61)
                (match (cv-get args 0)
                  (Some [lv]
                        (match (cv-get args 1)
                          (Some [vv]
                                (if (and (is-ccode lv) (is-ccode vv))
                                    (let [list (ccode-of lv)]
                                      (if (= (sx-tag list)
                                             6)
                                          (do
                                            (push! [Sexp]
                                                   (sx-items list)
                                                   (ccode-of vv))
                                            (Ok [CtVal Diag] (CCode list)))
                                          (Err [CtVal Diag]
                                               (derr "code-list-push!: first argument must be a Code list"))))
                                    (Err [CtVal Diag]
                                         (derr "code-list-push!: expects two Code values"))))
                          (None []
                                (Err [CtVal Diag]
                                     (derr "code-list-push!: expects two arguments")))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-list-push!: expects two arguments"))))
              ; op 62 code-list-done — freeze a builder into Code. Identity at
              ; runtime (same node); the TCodeBuilder/TCode split in the checker
              ; is the point (docs/design/META_MEMORY.md phase 4).
              (= op 62)
                (match (cv-get args 0)
                  (Some [lv]
                        (if (is-ccode lv)
                            (Ok [CtVal Diag] (CCode (ccode-of lv)))
                            (Err [CtVal Diag]
                                 (derr "code-list-done: expects a Code builder"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-list-done: expects one argument"))))
              ; op 63 code-slice — O(1) view of [lo, hi) of a list/vector
              ; (docs/design/META_MEMORY.md phase 5)
              (= op 63)
                (match (cv-get args 0)
                  (Some [cv]
                        (match (cv-get args 1)
                          (Some [lov]
                                (match (cv-get args 2)
                                  (Some [hiv]
                                        (if (and (is-ccode cv)
                                                 (and (= (ct-tag lov)
                                                         0)
                                                      (= (ct-tag hiv)
                                                         0)))
                                            (let [code (ccode-of cv)
                                                  lo (cint-of lov)
                                                  hi (cint-of hiv)]
                                              (if (not (code-node-listish? code))
                                                  (Err [CtVal Diag]
                                                       (derr "code-slice: expects a list/vector"))
                                                  (if (or (< lo
                                                             0)
                                                          (> hi
                                                             (code-node-len code))
                                                          (> lo hi))
                                                      (Err [CtVal Diag]
                                                           (derr "code-slice: bounds out of range"))
                                                      (Ok [CtVal Diag]
                                                          (CCode (code-node-window code
                                                                                   lo
                                                                                   hi))))))
                                            (Err [CtVal Diag]
                                                 (derr "code-slice: expects (primitive/code-slice CODE LO HI)"))))
                                  (None []
                                        (Err [CtVal Diag]
                                             (derr "code-slice: expects (primitive/code-slice CODE LO HI)")))))
                          (None []
                                (Err [CtVal Diag]
                                     (derr "code-slice: expects (primitive/code-slice CODE LO HI)")))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-slice: expects (primitive/code-slice CODE LO HI)"))))
              ; op 64 code-copy — THE deep copy, named as one: fresh structure and
              ; string payloads in the engine allocator, views flattened
              (= op 64)
                (match (cv-get args 0)
                  (Some [cv]
                        (if (is-ccode cv)
                            (let [(mut sp) (ccode-of cv)]
                              (Ok [CtVal Diag]
                                  (CCode (sexp-own-into a (mut sp)))))
                            (Err [CtVal Diag]
                                 (derr "code-copy: expects a Code value"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-copy: expects one Code argument"))))
              ; op 65 code-concat — explicit O(n+m) build of a fresh list from two
              ; listish values (elements shared, like every list constructor)
              (= op 65)
                (match (cv-get args 0)
                  (Some [xv]
                        (match (cv-get args 1)
                          (Some [yv]
                                (if (and (is-ccode xv) (is-ccode yv))
                                    (let [cx2 (ccode-of xv)
                                          cy (ccode-of yv)]
                                      (if (not (and (code-node-listish? cx2)
                                                    (code-node-listish? cy)))
                                          (Err [CtVal Diag]
                                               (derr "code-concat: expects two lists/vectors"))
                                          (let [(mut xs)
                                                  (ArrayList::new [Sexp] a)
                                                nx (code-node-len cx2)
                                                ny (code-node-len cy)]
                                            (for [i 0 nx]
                                              (push! (mut xs)
                                                     (code-node-at cx2
                                                                   i)))
                                            (for [j 0 ny]
                                              (push! (mut xs)
                                                     (code-node-at cy
                                                                   j)))
                                            (Ok [CtVal Diag]
                                                (CCode (sx-mklist (box-al a
                                                                          (load xs))))))))
                                    (Err [CtVal Diag]
                                         (derr "code-concat: expects two Code values"))))
                          (None []
                                (Err [CtVal Diag]
                                     (derr "code-concat: expects two Code arguments")))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-concat: expects two Code arguments"))))
              ; op 74 code-list-like — replace children but retain the original
              ; container's source/hygiene context. This is the declaration-safe
              ; counterpart to constructing a fresh list.
              (= op 74)
                (match (cv-get args 0)
                  (Some [pv]
                        (match (cv-get args 1)
                          (Some [iv]
                                (if (and (is-ccode pv) (is-ccode iv))
                                    (let [proto (ccode-of pv)
                                          items (ccode-of iv)]
                                      (if (not (and (code-node-listish? proto)
                                                    (code-node-listish? items)))
                                          (Err [CtVal Diag]
                                               (derr "code-list-like: expects two lists/vectors"))
                                          (let [pp (box-sexp a proto)
                                                n (code-node-len items)
                                                (mut kids)
                                                  (ArrayList::new [Sexp] a)]
                                            ; read through the shared accessors: a view or
                                            ; a joined list has no items array of its own
                                            (for [i 0 n]
                                              (push! (mut kids)
                                                     (code-node-at items i)))
                                            (Ok [CtVal Diag]
                                                ; The prototype decides list vs vector:
                                                ; only the children are replaced.
                                                (CCode (mk-sexp-src (if (= (sx-tag proto)
                                                                           7)
                                                                        (KVec (box-al a
                                                                                      (load kids)))
                                                                        (KList (box-al a
                                                                                       (load kids))))
                                                                    pp))))))
                                    (Err [CtVal Diag]
                                         (derr "code-list-like: expects two Code values"))))
                          (None []
                                (Err [CtVal Diag]
                                     (derr "code-list-like: expects two Code arguments")))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-list-like: expects two Code arguments"))))
              ; op 71 code-opaque — Code -> compilation-scoped i64 handle
              (= op 71)
                (match (cv-get args 0)
                  (Some [cv]
                        (if (is-ccode cv)
                            (let [handle (code-opaque-add a (ccode-of cv))]
                              (if (= handle 0)
                                  (Err [CtVal Diag]
                                       (derr "code-opaque: compilation handle table exhausted"))
                                  (Ok [CtVal Diag] (CInt handle))))
                            (Err [CtVal Diag]
                                 (derr "code-opaque: expects a Code value"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-opaque: expects one Code argument"))))
              ; op 72 code-from-opaque — handle -> the exact Code node it named
              (= op 72)
                (match (cv-get args 0)
                  (Some [v]
                        (if (= (ct-tag v) 0)
                            (let [node (code-opaque-get (cint-of v))]
                              (if (= (primitive/cast i64 node)
                                     0)
                                  (Err [CtVal Diag]
                                       (derr "code-from-opaque: invalid or expired Code handle"))
                                  (Ok [CtVal Diag] (CCode (load node)))))
                            (Err [CtVal Diag]
                                 (derr "code-from-opaque: expects an opaque Code handle"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-from-opaque: expects an opaque Code handle"))))
              (= op 59)
                (match (cv-get args 0)
                  (Some [sv]
                        (match (cv-get args 1)
                          (Some [mv]
                                (if (and (or (is-cstr sv)
                                             (and (is-ccode sv)
                                                  (= (sx-tag (ccode-of sv))
                                                     4)))
                                         (and (is-ccode mv)
                                              (= (sx-tag (ccode-of mv))
                                                 6)))
                                    ; The forms' names and strings are slices of the
                                    ; text they were read from, so read a copy the
                                    ; Code owns: a string argument is the caller's,
                                    ; and may be freed while the Code lives on.
                                    (let [source
                                            (text/format a
                                                         "{}"
                                                         (if (is-cstr sv)
                                                             (cstr-of sv)
                                                             (sx-sval (ccode-of sv))))
                                          config-form (ccode-of mv)
                                          config-items (sx-items config-form)
                                          (mut config)
                                            (: (default-reader-config)
                                               ReaderConfig)]
                                      (when (and (= (sx-len config-items) 5)
                                                 (and (>= (reader-config-char (sx-at config-items
                                                                                     2))
                                                          0)
                                                      (>= (reader-config-char (sx-at config-items
                                                                                     4))
                                                          0)))
                                        (set! (.unquote config)
                                              (reader-config-char (sx-at config-items
                                                                         2)))
                                        (set! (.alternate-unquote config) -1)
                                        (set! (.unquote-splicing config)
                                              (reader-config-char (sx-at config-items
                                                                         4)))
                                        0)
                                      (match (read-all-with a source -1 config)
                                        (Err [d] (Err [CtVal Diag] d))
                                        (Ok [forms]
                                            (let [(mut items)
                                                    (ArrayList::new [Sexp] a)]
                                              (push! (mut items) (sx-sym "do"))
                                              (for [i 0 (sx-len forms)]
                                                (push! (mut items)
                                                       (sx-at forms i)))
                                              (Ok [CtVal Diag]
                                                  (CCode (sx-mklist (box-al a
                                                                            (load items)))))))))
                                    (Err [CtVal Diag]
                                         (derr "code-read: expects a string or string Code and reader-config Code"))))
                          (None []
                                (Err [CtVal Diag]
                                     (derr "code-read: expects a string or string Code and reader-config Code")))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-read: expects a string or string Code and reader-config Code"))))
              (= op 8)
                (let [scope (primitive/iadd (next-gensym) 1)
                      (mut p) (sx-sym (text/format a "$g{}" (dec->str a scope)))]
                  (set! (.hyg p) scope)
                  (set! (.horigin p) 2)
                  ; `gensym` is the anonymous-spelling form of
                  ; fresh-identifier and obeys the same module-neutral rule.
                  (set! (.hmod p)
                        (no-hmod))
                  (Ok [CtVal Diag] (CCode p)))
              (= op 30) (Ok [CtVal Diag] (CCode (sx-sym (target-arch-str))))
              (= op 46) (Ok [CtVal Diag] (CCode (sx-sym (target-os-str))))
              (= op 57)
                (match (cv-get args 0)
                  (Some [nv]
                        (match (cv-get args 1)
                          (Some [mv]
                                (if (and (is-ccode nv) (is-ccode mv))
                                    (let [ns (ccode-of nv)
                                          ms (ccode-of mv)]
                                      (if (and (= (sx-tag ns)
                                                  2)
                                               (= (sx-tag ms)
                                                  2))
                                          (Ok [CtVal Diag]
                                              (CBool (explicitly-exported? cx
                                                                           (sx-sval ns)
                                                                           (sx-sval ms))))
                                          (Err [CtVal Diag]
                                               (derr "comptime: code-exported? expects name and module symbols"))))
                                    (Err [CtVal Diag]
                                         (derr "comptime: code-exported? expects two Code values"))))
                          (None []
                                (Err [CtVal Diag]
                                     (derr "comptime: code-exported? expects two Code values")))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "comptime: code-exported? expects two Code values"))))
              (= op 39) (Ok [CtVal Diag] (CBool (debug-checks-on?)))
              (= op 52) (cop-lint-param args)
              (= op 53)
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag]
                                (CBool (macro-call-lookup (sx-node-id (ccode-of nodev)))))
                            (Err [CtVal Diag]
                                 (derr "code-macro-call?: expects a Code node"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-macro-call?: expects a Code node"))))
              (= op 9)
                (match (cv-get args 0)
                  (Some [v]
                        (if (is-cstr v)
                            ; a copy: the message is the caller's string, and the
                            ; diagnostic is printed after the caller is gone
                            (Err [CtVal Diag]
                                 (derr (text/format (unit-allocator)
                                                    "{}"
                                                    (cstr-of v))))
                            (Err [CtVal Diag]
                                 (derr "error: message must be a string"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "error: message must be a string"))))
              (= op 31)
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (match (cv-get args 1)
                              (Some [msgv]
                                    (if (is-cstr msgv)
                                        (let [node (ccode-of nodev)
                                              (mut d) (zeroed Diag)]
                                          (set! (.lo d) (sx-lo node))
                                          (set! (.hi d) (sx-hi node))
                                          ; malloc, not `a`: the warn list
                                          ; outlives the expansion arena
                                          (set! (.msg d)
                                                (text/format (unit-allocator)
                                                             "error: {}"
                                                             (cstr-of msgv)))
                                          (set! (.source d) (sx-source node))
                                          (set! (.ctxt d) 0)
                                          (warn-push d)
                                          (diag-err-bump)
                                          (Ok [CtVal Diag] (CInt 0)))
                                        (Err [CtVal Diag]
                                             (derr "report: message must be a string"))))
                              (None []
                                    (Err [CtVal Diag]
                                         (derr "report: expects (primitive/report NODE MSG)"))))
                            (Err [CtVal Diag]
                                 (derr "report: first arg must be a Code node"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "report: expects (primitive/report NODE MSG)"))))
              (or (= op 32) (= op 44) (= op 58)) (cop-warn-or-suggest a op args)
              (= op 33)
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag]
                                (CStr (code-file-of (ccode-of nodev))))
                            (Err [CtVal Diag]
                                 (derr "code-file: expects a Code node"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-file: expects (primitive/code-file NODE)"))))
              (= op 40)
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag]
                                (CInt (code-line-of (ccode-of nodev))))
                            (Err [CtVal Diag]
                                 (derr "code-line: expects a Code node"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-line: expects (primitive/code-line NODE)"))))
              (= op 41)
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag]
                                (CStr (code-src-of (ccode-of nodev))))
                            (Err [CtVal Diag]
                                 (derr "code-src: expects a Code node"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-src: expects (primitive/code-src NODE)"))))
              (= op 42)
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag]
                                (CInt (code-col-of (ccode-of nodev))))
                            (Err [CtVal Diag]
                                 (derr "code-col: expects a Code node"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-col: expects (primitive/code-col NODE)"))))
              (= op 43)
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag]
                                (CStr (code-doc-of (ccode-of nodev))))
                            (Err [CtVal Diag]
                                 (derr "code-doc: expects a Code node"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-doc: expects (primitive/code-doc NODE)"))))
              (or (= op 34) (= op 45))
                (match (cv-get args 0)
                  (Some [nodev]
                        (if (is-ccode nodev)
                            (Ok [CtVal Diag]
                                (CBool (if (= op 45)
                                           (!= (sx-ctxt (ccode-of nodev))
                                               0)
                                           (code-from-user-node? (ccode-of nodev)))))
                            (Err [CtVal Diag]
                                 (derr "code-from-user?: expects a Code node"))))
                  (None []
                        (Err [CtVal Diag]
                             (derr "code-from-user?: expects (primitive/code-from-user? NODE)"))))
              (or (= op 12) (= op 13)) (cop-concat op args cx)
              (or (= op 66) (= op 67) (= op 68) (= op 69) (= op 70))
                (cop-hygiene op args cx)
              (or (= op 14) (= op 15) (= op 16) (= op 17) (= op 50))
                (cop-field op args cx)
              (= op 75) (cop-type-shape op args cx)
              (= op 86) (cop-type-traits op args cx)
              (or (= op 18)
                  (= op 19)
                  (= op 20)
                  (= op 21)
                  (= op 47)
                  (= op 48)
                  (= op 49))
                (cop-variant op args cx)
              (or (= op 22) (= op 23) (= op 24) (= op 25) (= op 26) (= op 27))
                (cop-trait op args cx)
              (= op 51) (cop-deriver args cx)
              (= op 28) (cop-strbytes args cx)
              (= op 29) (cop-bytestostr args cx)
              (= op 38) (cop-inttostr args cx)
              (= op 109) (cop-qualify-import op args cx)
              (= op 110) (cop-suggest-edits op args cx)
              (and (>= op 105) (<= op 108)) (cop-source-query op args cx)
              (and (>= op 87) (<= op 90)) (cop-dependencies op args cx)
              (= op 35) (cop-decl op args cx)
              (= op 36) (cop-type-of op args cx)
              (= op 37) (cop-binding-of args cx)
              (= op 91) (cop-resolve-at op args cx)
              (= op 94) (cop-macro-of op args cx)
              (= op 95) (cop-alias-of op args cx)
              (or (and (>= op 96) (<= op 104))
                  (= op 111)
                  (= op 112)
                  (= op 129))
                (cop-program-query op args cx)
              ; `(primitive/suggest-transaction)`: later suggestions form a new
              ; transaction (see sug-begin-group!)
              (= op 92) (Ok [CtVal Diag] (CInt (sug-begin-group!)))
              (= op 113) (cop-call-site args)
              (= op 114) (cop-variant-ref op args cx)
              (= op 115) (cop-type-ref op args cx)
              (= op 116) (cop-module-uses op args cx)
              (and (>= op 117) (<= op 128)) (cop-program-facts op args cx)
              :else (cop-codearg op args cx)))))

;;; Read the loader's explicit export table during syntax transformation. Missing
;;; metadata returns false: this query authorizes a rewrite, so uncertainty must
;;; preserve the original identifier for ordinary resolution to diagnose.
(defn explicitly-exported? [(cx (ptr CtCtx)) (name (slice u8)) (m (slice u8))]
  (-> bool)
  (let [xs (load (field cx qexports))
        n
          (if (= (primitive/cast i64 xs) 0)
              0
              (len (load xs)))
        (mut i) 0
        (mut result) false]
    (loop (if (>= (load i) n)
              (break)
              (let [e (elem xs (load i))]
                (when (= (.name e) m)
                  (set! result (set-contains (field e names) name))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load result)))

(defn type-is-code [(t (ptr Type))] (-> bool)
  (match (load t) (TCode [] true) (_ false)))

;;; The names a call may be resolved against: the program's functions, its impl
;;; method heads and its externs. It is asked one question -- is this callee one of
;;; them -- once per call site in every body a closure reaches, so it answers from an
;;; index. As a bare list scanned per question, that was the largest single cost of
;;; keeping a retained session current: every edit re-asks it of the whole program.
;;;
;;; `index` maps each name to where the first function of that name sits in the
;;; function list the set was built from, or to -1 for a name that is not a function
;;; there (a method head, an extern). `fn-names-func` answers from it.
(defstruct FnNames
  [(items (ArrayList (slice u8)))
   (index (HashMap (slice u8) i64))
   ; The program the positions refer to and how many functions it had. A set is
   ; built for one closure computation, over a program nothing changes meanwhile;
   ; the count catches a set that outlived that, and the scan then answers.
   (program (ptr Program))
   (functions i64)])

(defn fn-names-new [(a (dyn Allocator))] (-> (ptr FnNames))
  (box! a
        FnNames
        (FnNames
          :items (ArrayList::new [(slice u8)] a)
          :index (HashMap::new [(slice u8) i64] a (keyops-borrowed))
          :program (primitive/cast (ptr Program) 0)
          :functions 0)))

;;; Add `name`, which must outlive the set: its bytes are not copied. `position` is
;;; its place in the function list, or -1. The first position recorded for a name
;;; stands, as the first function of a name is the one a lookup finds.
(defn fn-names-add! [(names (ptr FnNames)) (name (slice u8)) (position i64)]
  (-> i64)
  (push! (mut (.items names)) name)
  (unless (contains? (.index names) name)
    (set! (mut (.index names)) name position)
    0)
  0)

(defn fn-names-has? [(names (ptr FnNames)) (name (slice u8))] (-> bool)
  (or (contains? (.index names) name)
      (match (closure-base-func name) (Some [_] true) (None [] false))))

;;; The first function named `name` in `p`, or null: what `prog-fn-find` answers,
;;; from the index when `names` was built from `p` as it now stands, and from the
;;; scan otherwise.
(defn fn-names-func [(names (ptr FnNames)) (p (ptr Program)) (name (slice u8))]
  (-> (ptr Func))
  (let [found (fn-names-func-local names p name)]
    (if (!= (primitive/cast i64 found) 0)
        found
        (match (closure-base-func name)
          (Some [function] function)
          (None [] (primitive/cast (ptr Func) 0))))))

(defn fn-names-func-local [(names (ptr FnNames))
                           (p (ptr Program))
                           (name (slice u8))] (-> (ptr Func))
  (let [fs (load (field p funcs))]
    (if (and (= (.program names) p) (= (.functions names) (len (load fs))))
        (match (get (.index names) name)
          (None [] (primitive/cast (ptr Func) 0))
          (Some [position]
                (if (< position 0)
                    (primitive/cast (ptr Func) 0)
                    (let [candidate (elem fs position)]
                      (if (= (.name candidate) name)
                          candidate
                          (prog-fn-find p name))))))
        (prog-fn-find p name))))

(defn cc-push! [(out (ptr SBox))
                (names (ptr FnNames))
                (func (slice u8))] (-> i64)
  (when (fn-names-has? names func) (push! (mut (.items out)) func) 0))

;;; Record the trait-method heads a call may select. A known function is direct
;;; evidence for impls of its name. `Trait::method`, and a callable value called as
;;; `(f x)` (which is `Callable::call`), name no function. They are recorded as
;;; `Trait::method` and retain only structural impls such as Callable on a function
;;; pointer, whose receiver has no owning module to establish reachability.
(defn cc-push-trait-head! [(heads (ptr SBox))
                           (names (ptr FnNames))
                           (func (slice u8))] (-> i64)
  (cond (fn-names-has? names func) (push! (mut (.items heads)) func)
        (some? (find func "::")) (push! (mut (.items heads)) func)
        :else
          ; Neither a function nor `Owner::method`: a local callable value, or a
          ; method of an inherent impl such as `(get cell)` on a `Var`. The checker
          ; decides which; keep both candidate families.
          (do
            (push! (mut (.items heads)) func)
            (push! (mut (.items heads)) "Callable::call")))
  0)

(defn cc-list [(es (ptr (ArrayList Expr)))
               (names (ptr FnNames))
               (out (ptr SBox))
               (trait-heads (ptr SBox))] (-> i64)
  (let [n (len (load es))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (collect-calls (elem es (load i))
                               names
                               out
                               trait-heads)
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn cc-quasi-list [(items (ptr (ArrayList Quasi)))
                     (names (ptr FnNames))
                     (out (ptr SBox))
                     (trait-heads (ptr SBox))] (-> i64)
  (let [n (len (load items))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (cc-quasi (elem items (load i))
                          names
                          out
                          trait-heads)
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn cc-quasi [(q (ptr Quasi))
                (names (ptr FnNames))
                (out (ptr SBox))
                (trait-heads (ptr SBox))] (-> i64)
  (match (load q)
    (QUnquote [e] (collect-calls e names out trait-heads))
    (QSplice [e] (collect-calls e names out trait-heads))
    (QList [items] (cc-quasi-list items names out trait-heads))
    (QVector [items] (cc-quasi-list items names out trait-heads))
    (_ 0)))

(defn collect-calls [(e (ptr Expr))
                     (names (ptr FnNames))
                     (out (ptr SBox))
                     (trait-heads (ptr SBox))] (-> i64)
  (match (.kind e)
    (ECall [func ta args]
           (do
             (cc-push! out names func)
             ; Ordinary calls can still name trait-method functions before the
             ; checker rewrites them to ETraitCall (notably Code-returning macros).
             ; Record them as impl-selection evidence; EMakeDyn deliberately does
             ; not, because its method list is only a concrete vtable reference.
             (when (!= (primitive/cast i64 trait-heads) 0)
               (cc-push-trait-head! trait-heads names func))
             (cc-list args names out trait-heads)))
    ; A function reached ONLY through `fnptr-of` is just as reachable as one that is
    ; called: `malloc-allocator` builds its vtable with (primitive/fnptr-of ma-alloc) and never
    ; calls ma-alloc directly. Missing this leaves the target out of the comptime
    ; sub-program and checking it fails with "fnptr-of unknown function".
    ; `(Type :field value …)` before checking lowers it. Its head is a constructor
    ; (or a named-argument function call) and its arguments are ordinary
    ; expressions that may call anything.
    (ENamedCall [func ta names-list args]
                (do
                  (cc-push! out names func)
                  (when (!= (primitive/cast i64 trait-heads) 0)
                    (cc-push-trait-head! trait-heads names func))
                  (cc-list args names out trait-heads)))
    (EFnPtrOf [name] (cc-push! out names name))
    (EFnPtrInst [name _] (cc-push! out names name))
    ; Vtable entries are function-pointer references just like EFnPtrOf. A
    ; closure that keeps the constructor must keep every method it installs;
    ; otherwise native emission sees the EMakeDyn but not its relocated symbols.
    (EMakeDyn [ds vs ms inner]
              (do
                (for [i 0 (len (load ms))]
                  (cc-push! out names (get (load ms) i)))
                (collect-calls inner names out trait-heads)))
    (EPattern [pattern-op ty x pattern-index]
              (do
                ; Checking selects Code or slice helpers after the staging closure has
                ; been discovered. Keep both candidate edges until that selection.
                (when (or (= pattern-op 0) (= pattern-op 4))
                  (cc-push! out names "coil.binding.runtime.check-struct"))
                (when (= pattern-op 5)
                  (cc-push! out names "coil.binding.runtime.match-fail"))
                (when (and (> pattern-op 0) (< pattern-op 4))
                  (cc-push! out
                            names
                            (cond (= pattern-op 1)
                                    "coil.binding.runtime.require-code"
                                  (= pattern-op 2)
                                    "coil.binding.runtime.code-nth"
                                  :else "coil.binding.runtime.code-rest"))
                  (cc-push! out
                            names
                            (cond (= pattern-op 1)
                                    "coil.binding.runtime.require-slice"
                                  (= pattern-op 2)
                                    "coil.binding.runtime.slice-nth"
                                  :else "coil.binding.runtime.slice-rest")))
                (collect-calls x names out trait-heads)))
    ; Generic trait calls are resolved only after closure selection, in mono. Keep
    ; the method head reachable here so closure-impl-wanted? retains the candidate
    ; impl and metalower can give its erased Code receiver a dispatchable name.
    (ETraitCall [tn m stp args]
                (do
                  (cc-push! out names m)
                  (when (!= (primitive/cast i64 trait-heads) 0)
                    (cc-push! trait-heads names m))
                  (cc-list args names out trait-heads)))
    (EQuasi [q]
            (let [(mut qp) q] (cc-quasi (mut qp) names out trait-heads)))
    ; Ownership elaboration's output calls functions too: drop glue and the
    ; cleanups of defers.
    ; A source anonymous function (a constant's value, before the check lifts
    ; it) calls what its body calls.
    (_ (visit-expr-children [child e :except [EBracketCall]]
                            (collect-calls child names out trait-heads)))))

(defn prog-fn-names [(p (ptr Program)) (a (dyn Allocator))] (-> (ptr FnNames))
  (let [fs (load (field p funcs))
        n (len (load fs))
        out (fn-names-new a)
        (mut i) 0]
    (set! (.program out) p)
    (set! (.functions out) n)
    (loop (if (>= (load i) n)
              (break)
              (do
                (fn-names-add! out (.name (elem fs (load i))) (load i))
                (set! i (primitive/iadd (load i) 1)))))
    ; Keep method heads in the call-name universe too. They have no ordinary
    ; Func entry yet, but seeing one in a reachable body tells closure selection
    ; which structural/primitive impl families can actually dispatch.
    (let [is (load (field p impls))
          ni (len (load is))
          (mut ii) 0]
      (loop (if (>= (load ii) ni)
                (break)
                (do
                  (let [ip (elem is (load ii))
                        ms (load (field ip methods))
                        nm (len (load ms))
                        (mut mi) 0]
                    (loop (if (>= (load mi) nm)
                              (break)
                              (do
                                ; This list is queried only for membership. A
                                ; duplicate does not change its meaning, while
                                ; probing the growing function list here made
                                ; construction quadratic in methods x functions.
                                (let [method-name (.name (elem ms (load mi)))]
                                  (fn-names-add! out method-name -1)
                                  ; A resolved call uses the lexical module of
                                  ; the trait method (`coil.fmt.display-fmt`),
                                  ; while an unchecked ImplDef still stores only
                                  ; its declaration label (`display-fmt`). Keep
                                  ; both spellings in the membership universe so
                                  ; collect-calls does not discard the call before
                                  ; trait-family normalization can see it.
                                  (when (impl-is-trait ip)
                                    (let [tm
                                            (qual-module-of (impl-trait-name ip))]
                                      (when (> (len tm) 0)
                                        (fn-names-add! out
                                                       (text/format a
                                                                    "{}.{}"
                                                                    tm
                                                                    method-name)
                                                       -1)))))
                                (set! mi (primitive/iadd (load mi) 1))))))
                  (set! ii (primitive/iadd (load ii) 1))))))
    ; Externs participate in reachability too. Closure sub-programs used to retain
    ; every extern in the application, and the in-memory object builder consequently
    ; emitted every one as an undefined symbol even when the selected macro never
    ; referenced it.
    (let [es (load (field p externs))
          ne (len (load es))
          (mut ei) 0]
      (loop (if (>= (load ei) ne)
                (break)
                (do
                  (fn-names-add! out (.name (elem es (load ei))) -1)
                  (set! ei (primitive/iadd (load ei) 1))))))
    ; Constructing a struct or sum value makes its type, and so its module,
    ; reachable: a macro that builds a `Cell` and calls its inherent methods needs
    ; that module's impls even though it calls no function defined there.
    (for i (range 0 (len (load (field p structs))))
      (fn-names-add! out (.name (elem (load (field p structs)) i)) -1))
    (for i (range 0 (len (load (field p sums))))
      (fn-names-add! out (.name (elem (load (field p sums)) i)) -1))
    out))

;;; The function lists `prog-fn-find` indexed last, each by its program, buffer
;;; and length: the expander asks for a macro's function at every expansion, and
;;; a scan of every function per call was quadratic in a program's macro calls.
;;; The tower asks of several programs in turn (the whole program, a closure, a
;;; probe), so a few are kept; the least recently built one makes room. A list
;;; that grew, moved or belongs to another program is indexed afresh, and every
;;; answer is checked against the function it names.
(defstruct ProgFnIndex
  [(ready bool)
   (program i64)
   (buf i64)
   (count i64)
   (first (HashMap (slice u8) i64))])

(defstruct ProgFnIndexes [(slots (array ProgFnIndex 8)) (next i64)])

(defn prog-fn-indexes [] (-> (ptr ProgFnIndexes))
  (primitive/alloc-static ProgFnIndexes))

(defn prog-fn-index-for [(p (ptr Program)) (fs (ptr (ArrayList Func)))]
  (-> (ptr ProgFnIndex))
  (let [ixs (prog-fn-indexes)
        n (len (load fs))
        slots (primitive/cast (ptr ProgFnIndex) (field ixs slots))]
    (block :found
      (for [k 0 8]
        (let [ix (index slots k)]
          (when (and (.ready ix)
                     (and (= (.program ix) (primitive/cast i64 p))
                          (and (= (.buf ix) (primitive/cast i64 (.data fs)))
                               (= (.count ix) n))))
            (break :found ix))))
      (let [ix (index slots (.next ixs))]
        (set! (.next ixs) (% (+ (.next ixs) 1) 8))
        (if (.ready ix)
            (clear! (mut (.first ix)))
            (do
              (set! (.first ix)
                    (HashMap::new [(slice u8) i64] (malloc-allocator) (keyops)))
              (set! (.ready ix) true)))
        (for [i 0 n]
          ; the first function of a name answers, as the scan's did
          (unless (contains? (.first ix) (.name (elem fs i)))
            (set! (mut (.first ix)) (.name (elem fs i)) i)
            0))
        (set! (.program ix) (primitive/cast i64 p))
        (set! (.buf ix) (primitive/cast i64 (.data fs)))
        (set! (.count ix) n)
        ix))))

(defn prog-fn-find [(p (ptr Program)) (name (slice u8))] (-> (ptr Func))
  (let [fs (load (field p funcs))
        n (len (load fs))]
    (if (< n 32)
        (prog-fn-scan fs name)
        (let [ix (prog-fn-index-for p fs)]
          (match (get (.first ix) name)
            (Some [i]
                  (if (and (< i n) (= (.name (elem fs i)) name))
                      (elem fs i)
                      ; renamed in place: answer by scanning, as before
                      (prog-fn-scan fs name)))
            ; a program built where an indexed one lived can have its buffer and
            ; length: a miss is checked, and a function the index lacks rebuilds it
            (None []
                  (let [found (prog-fn-scan fs name)]
                    (unless (= (primitive/cast i64 found) 0)
                      (set! (.count ix) -1)
                      0)
                    found)))))))

(defn prog-fn-scan [(fs (ptr (ArrayList Func))) (name (slice u8))]
  (-> (ptr Func))
  (block :found
    (for [i 0 (len (load fs))]
      (when (= (.name (elem fs i)) name) (break :found (elem fs i))))
    (primitive/cast (ptr Func) 0)))

; A macro-engine closure needs impls owned by modules that are actually in that
; closure, plus structural/primitive impls (whose target has no module). Pulling
; every application impl into every compiler invocation both exposed bodies to a
; pre-expansion scope and defeated dead-code reachability.
(defn closure-module-wanted? [(wanted (ptr (ArrayList (slice u8))))
                              (m (slice u8))] (-> bool)
  (if (= (len m) 0)
      true
      (let [n (len (load wanted))
            (mut found) false]
        (for [i 0 n]
          (when (= (qual-module-of (get (load wanted) i)) m)
            (set! found true)
            (break)))
        (load found))))

(defn closure-trait-head-key [(a (dyn Allocator)) (head (slice u8))]
  (-> (slice u8))
  ; Calls have already been qualified when collect-calls sees them, while methods
  ; inside a still-unchecked ImplDef retain their declaration's simple name. Trait
  ; identity disambiguates equal method names during checking; closure reachability
  ; only needs to retain the candidate family, so compare the shared simple head.
  ; An `Owner::method` head keeps its owner, reduced to its simple name so that
  ; `coil.var.Var::new`, `var/Var::new` and `Var::new` are one head. A head a
  ; macro template wrote carries its hygienic scope (`$scope7@coil.hashmap$valid?`),
  ; which is not part of the name.
  (let [name (scoped-ident-raw head)]
    (match (find name "::")
      (Some [at]
            (text/format a
                         "$trait-head${}{}"
                         (after-last-qualifier (subslice [u8] name 0 at))
                         (subslice [u8] name at (len name))))
      (None [] (text/format a "$trait-head${}" (after-last-dot name))))))

;;; The wanted set of a closure calculation: the ordered names it returns, plus
;;; hash indexes of those names and their modules, so membership stays constant
;;; time as the closure grows to a whole program.
(defstruct ClosureWanted
  [(names (HashMap (slice u8) i64))
   (modules (HashMap (slice u8) i64))
   (heads-done i64)])

(defn closure-wanted-new [(a (dyn Allocator))] (-> (ptr ClosureWanted))
  (let [w (box! a ClosureWanted (zeroed ClosureWanted))]
    (set! (.names w) (HashMap::new [(slice u8) i64] a (keyops-borrowed)))
    (set! (.modules w) (HashMap::new [(slice u8) i64] a (keyops-borrowed)))
    w))

(defn closure-wanted? [(index (ptr ClosureWanted)) (name (slice u8))] (-> bool)
  (contains? (.names index) name))

(defn closure-want! [(wanted (ptr SBox))
                     (index (ptr ClosureWanted))
                     (name (slice u8))] (-> i64)
  (unless (closure-wanted? index name)
    (set! (mut (.names index)) name 1)
    (set! (mut (.modules index)) (qual-module-of name) 1)
    (push! (mut (.items wanted)) name)
    0)
  0)

(defn closure-mark-trait-heads! [(a (dyn Allocator))
                                 (wanted (ptr SBox))
                                 (trait-heads (ptr SBox))
                                 (index (ptr ClosureWanted))] (-> i64)
  (for [i (.heads-done index) (len (.items trait-heads))]
    (closure-want! wanted
                   index
                   (closure-trait-head-key a (get (.items trait-heads) i))))
  (set! (.heads-done index) (len (.items trait-heads)))
  0)

(defn closure-impl-key [(a (dyn Allocator)) (ip (ptr ImplDef))] (-> (slice u8))
  (text/format a
               "$impl${}${}"
               (impl-base-name a (field ip self_type))
               (if (impl-is-trait ip) (impl-trait-name ip) "$inherent")))

;;; The wanted-set entry of method NAME of inherent impl IP, once it is retained.
(defn closure-method-key [(a (dyn Allocator))
                          (ip (ptr ImplDef))
                          (name (slice u8))] (-> (slice u8))
  (text/format a "$kept${}" (inherent-fn-name a ip name)))

;;; Is method NAME of impl IP called: by its simple head, or as `Owner::NAME`?
(defn closure-method-wanted? [(a (dyn Allocator))
                              (index (ptr ClosureWanted))
                              (ip (ptr ImplDef))
                              (name (slice u8))] (-> bool)
  (or (closure-wanted? index (closure-trait-head-key a name))
      (closure-wanted? index
                       (closure-trait-head-key a
                                               (text/format a
                                                            "{}::{}"
                                                            (after-last-qualifier (impl-base-name a
                                                                                                  (field ip
                                                                                                         self_type)))
                                                            (after-last-dot name))))))

;;; WANTED as a set, for the per-impl and per-method lookups of a sub-program.
(defn closure-name-set [(a (dyn Allocator))
                        (wanted (ptr (ArrayList (slice u8))))]
  (-> (ptr (HashMap (slice u8) i64)))
  (let [(mut set) (HashMap::new [(slice u8) i64] a (keyops-borrowed))]
    (for name (iter (load wanted)) (set! (mut set) name 1))
    (box! a (HashMap (slice u8) i64) (load set))))

;;; Impl IP as a sub-program keeps it, or null when it keeps none of it. A trait
;;; impl is kept whole. An inherent impl's methods are independent functions, so it
;;; keeps the ones the closure retained (see closure-retain-methods!): one called method
;;; of a large impl does not bring every other method and all they call.
(defn closure-impl-kept [(a (dyn Allocator))
                         (wanted (ptr (HashMap (slice u8) i64)))
                         (ip (ptr ImplDef))] (-> (ptr ImplDef))
  (cond (not (contains? (load wanted) (closure-impl-key a ip)))
          (primitive/cast (ptr ImplDef) 0)
        (impl-is-trait ip) ip
        :else
          (let [(mut methods) (ArrayList::new [Func] a)]
            (for method (iter (load (field ip methods)))
              (when (contains? (load wanted)
                               (closure-method-key a ip (.name method)))
                (push! (mut methods) method)
                0))
            (if (= (len methods) 0)
                (primitive/cast (ptr ImplDef) 0)
                (let [copy (box! a ImplDef (load ip))]
                  (set! (.methods copy) (box-al a (load methods)))
                  copy)))))

;;; Does a method of impl IP still call a macro (a function returning Code)? Its
;;; body has not been expanded yet, and the expansion may call any method of IP.
(defn closure-impl-calls-macro? [(a (dyn Allocator))
                                 (p (ptr Program))
                                 (names (ptr FnNames))
                                 (ip (ptr ImplDef))] (-> bool)
  (let [calls (box! a SBox (zeroed SBox))]
    (set! (.items calls) (ArrayList::new [(slice u8)] a))
    (for [mi 0 (len (load (load (field ip methods))))]
      (cc-list (load (field (elem (load (field ip methods)) mi) body))
               names
               calls
               (primitive/cast (ptr SBox) 0)))
    (block :found
      (for [i 0 (len (.items calls))]
        (let [f (fn-names-func names p (get (.items calls) i))]
          (when (and (!= (primitive/cast i64 f) 0)
                     (match (.ret f) (TCode [] true) (_ false)))
            (break :found true))))
      false)))

;;; Retain the methods of wanted impl IP that the calls seen so far reach; true
;;; when that added any. A trait impl is retained whole, when it is first selected
;;; (FRESH), and so is an inherent impl that is still unexpanded (WHOLE, see
;;; closure-impl-calls-macro?). Any other inherent impl is retained method by
;;; method: each one whose head is called joins, and later passes add the ones its
;;; body (or anything else) calls. CHECKED also roots each retained method's
;;; checked function.
(defn closure-retain-methods! [(a (dyn Allocator))
                               (names (ptr FnNames))
                               (stackb (ptr SBox))
                               (wantedb (ptr SBox))
                               (trait-heads (ptr SBox))
                               (index (ptr ClosureWanted))
                               (ip (ptr ImplDef))
                               (fresh bool)
                               (whole bool)
                               (checked bool)] (-> bool)
  (let [trait (impl-is-trait ip)
        (mut added) false]
    (when (or fresh (not trait))
      (for [mi 0 (len (load (load (field ip methods))))]
        (let [method (elem (load (field ip methods)) mi)
              name (.name method)
              key (closure-method-key a ip name)]
          (when (or trait
                    (and (not (closure-wanted? index key))
                         (or whole (closure-method-wanted? a index ip name))))
            (unless trait
              (closure-want! wantedb index key)
              (set! added true)
              0)
            ; The checker may select a structural/primitive impl only after seeing
            ; a generic bound. Make the selected method itself a closure root as
            ; well as traversing its callees, so mono and native emission retain
            ; the implementation they selected.
            (unless (closure-wanted? index name)
              (push! (mut (.items stackb)) name)
              0)
            ; The checked function of that method is named for its impl, not by the
            ; label the unchecked ImplDef keeps. A generic body that calls `+` on its
            ; parameter reaches the impl only once mono selects it, so the selected
            ; impl's checked functions must be in the closure, or the specialization
            ; calls one that was left out.
            (when checked
              (let [fname
                      (if trait
                          (tmfn a
                                (impl-trait-name ip)
                                (impl-mangle-key a
                                                 (field ip self_type)
                                                 (load (field ip type_params)))
                                name)
                          (inherent-fn-name a ip name))]
                (unless (closure-wanted? index fname)
                  (push! (mut (.items stackb)) fname)
                  0))
              0)
            (cc-list (load (field method body)) names stackb trait-heads))
          0))
      0)
    added))

(defn closure-mark-impl! [(a (dyn Allocator))
                          (p (ptr Program))
                          (wanted (ptr SBox))
                          (ip (ptr ImplDef))
                          (index (ptr ClosureWanted))] (-> i64)
  (closure-want! wanted index (closure-impl-key a ip))
  ; A selected impl makes its owner type reachable, so that type's module now
  ; counts for its other impls: retaining `coil.alloc`'s inherent `Var::new`
  ; must also let `coil.var`'s own `get`/`set` in.
  (let [base (impl-base-name a (field ip self_type))
        owner (qual-module-of base)]
    (unless (= (len owner) 0)
      (set! (mut (.modules index)) owner 1)
      0)
    ; So are the types its values hold: a derived `Eq` on a sum compares each
    ; payload through that payload type's own `Eq`, which lives in its module.
    (for [i 0 (len (load (field p structs)))]
      (let [sd (elem (load (field p structs)) i)]
        (when (= (.name sd) base)
          (closure-mark-field-modules! (.fields sd) index)
          0)))
    (for [i 0 (len (load (field p sums)))]
      (let [sd (elem (load (field p sums)) i)]
        (when (= (.name sd) base)
          (for [v 0 (len (load (.variants sd)))]
            (closure-mark-field-modules! (.fields (elem (.variants sd) v))
                                         index))
          0))))
  0)

(defn closure-mark-field-modules! [(fields (ptr (ArrayList Field)))
                                   (index (ptr ClosureWanted))] (-> i64)
  (for [i 0 (len (load fields))]
    (closure-mark-type-modules! (field (elem fields i) ty) index))
  0)

(defn closure-mark-type-modules! [(t (ptr Type)) (index (ptr ClosureWanted))]
  (-> i64)
  (match (load t)
    (TStruct [n]
             (let [m (qual-module-of n)]
               (unless (= (len m) 0) (set! (mut (.modules index)) m 1) 0)))
    (TApp [n args]
          (do
            (let [m (qual-module-of n)]
              (unless (= (len m) 0) (set! (mut (.modules index)) m 1) 0))
            (for [i 0 (len (load args))]
              (closure-mark-type-modules! (elem args i) index))
            0))
    (TArray [e _] (closure-mark-type-modules! e index))
    (_ 0))
  0)

;;; The wanted-set entry of trait TR as a bound some wanted function holds.
(defn closure-bound-trait-key [(a (dyn Allocator)) (tr (slice u8))]
  (-> (slice u8))
  (closure-trait-head-key a (text/format a "{}::" tr)))

(defn closure-impl-wanted? [(a (dyn Allocator))
                            (index (ptr ClosureWanted))
                            (ip (ptr ImplDef))] (-> bool)
  (let [m (qual-module-of (impl-base-name a (field ip self_type)))
        ms (load (field ip methods))
        n (len (load ms))
        (mut i) 0
        ; an impl of a trait a wanted function is bounded by is reached as if
        ; a method of it were called
        (mut called)
          (and (impl-is-trait ip)
               (closure-wanted? index
                                (closure-bound-trait-key a (impl-trait-name ip))))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (closure-wanted? index
                                       (closure-trait-head-key a
                                                               (.name (elem ms
                                                                            (load i)))))
                  (set! called true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    ; Primitive and structural targets have no owning source module. Their
    ; methods may not appear as direct calls until trait selection during the
    ; scratch check, so retain those impls unconditionally. Source-owned impls
    ; remain restricted to a reachable method and owner module.
    ; An explicit `Type::method` head names an inherent impl directly, whichever
    ; module defines it (an inherent impl may extend a type from another module).
    ; With no owning module, a qualified head keeps only an impl on a structural
    ; receiver: `(ptr adder)` belongs to adder's module and waits for it.
    (cond (and (not (impl-is-trait ip))
               (closure-qualified-head-wanted? a index ip))
            true
          (= (len m) 0)
            (or (load called)
                (and (not (type-names-nominal? (field ip self_type)
                                               (load (field ip type_params))))
                     (closure-qualified-head-wanted? a index ip)))
          :else
            (and (or (load called) (closure-qualified-head-wanted? a index ip))
                 (contains? (.modules index) m)))))

;;; Whether `t` names a nominal (struct or sum) type anywhere inside it, other than
;;; the impl's own type parameters and compiler pack markers. `(ptr adder)` does, so
;;; a Callable impl on it is owned by adder's module even though its head is `ptr`.
(defn type-names-nominal? [(t (ptr Type)) (params (ptr (ArrayList (slice u8))))]
  (-> bool)
  (match (load t)
    (TStruct [n]
             (not (or (set-contains params n) (closure-name-prefix? n "$"))))
    (TApp [n args]
          (if (closure-name-prefix? n "$")
              (types-name-nominal? args params)
              (not (set-contains params n))))
    (TPtr [e] (type-names-nominal? e params))
    (TRef [_ e] (type-names-nominal? e params))
    (TSlice [e] (type-names-nominal? e params))
    (TArray [e _] (type-names-nominal? e params))
    (TVec [e _] (type-names-nominal? e params))
    (TFn [_ ps r]
         (or (types-name-nominal? ps params) (type-names-nominal? r params)))
    (_ false)))

(defn types-name-nominal? [(ts (ptr (ArrayList Type)))
                           (params (ptr (ArrayList (slice u8))))] (-> bool)
  (let [(mut found) false]
    (for i (range 0 (len (load ts)))
      (when (type-names-nominal? (elem ts i) params) (set! found true)))
    (load found)))

(defn closure-name-prefix? [(s (slice u8)) (prefix (slice u8))] (-> bool)
  (and (>= (len s) (len prefix)) (= (subslice s 0 (len prefix)) prefix)))

;;; Whether a `Trait::method` call (see cc-push-trait-head!) names a method of this
;;; trait impl, or a `Type::method` call names a method of this inherent impl.
(defn closure-qualified-head-wanted? [(a (dyn Allocator))
                                      (index (ptr ClosureWanted))
                                      (ip (ptr ImplDef))] (-> bool)
  (let [owner
          (if (impl-is-trait ip)
              (after-last-dot (impl-trait-name ip))
              (after-last-qualifier (impl-base-name a (field ip self_type))))
        (mut found) false]
    (for entry (iter (load (field ip methods)))
      (let [method entry
            head (text/format a "{}::{}" owner (after-last-dot (.name method)))]
        (when (closure-wanted? index (closure-trait-head-key a head))
          (set! found true))))
    (load found)))

(defn closure-drain! [(p (ptr Program))
                      (names (ptr FnNames))
                      (stackb (ptr SBox))
                      (wantedb (ptr SBox))
                      (trait-heads (ptr SBox))
                      (index (ptr ClosureWanted))] (-> i64)
  (loop (if (= (len (.items stackb)) 0)
            (break)
            (do
              (let [sl (.items stackb)
                    top (len sl)
                    nm (get sl (primitive/isub top 1))]
                (set! (.len (.items stackb)) (primitive/isub top 1))
                (unless (closure-wanted? index nm)
                  (closure-want! wantedb index nm)
                  (let [f (fn-names-func names p nm)]
                    ; a body the tower's resolve left unparsed is parsed now; one
                    ; that does not parse is skipped, as an unparsed definition is
                    (unless (or (= (primitive/cast i64 f) 0)
                                (not (lazy-body-force! f)))
                      (cc-push-bound-heads! p
                                            (load (field f bounds))
                                            trait-heads)
                      (cc-list (load (field f body)) names stackb trait-heads))))))))
  0)

;;; A call of a generic function is checked against its bounds, so the impls that
;;; satisfy them are needed even when no method of theirs is called: `(h 3)` with
;;; `h [(T Hash)]` needs Hash's impl for i64. Every bounded trait, and every
;;; supertrait those require (an impl is accepted only beside its supertraits'
;;; impls), becomes a trait head of its own (`Trait::`, see closure-bound-trait-key),
;;; and so does each of their methods.
(defn cc-push-bound-heads! [(p (ptr Program))
                            (bounds (ptr (ArrayList Bound)))
                            (heads (ptr SBox))] (-> i64)
  (unless (= (primitive/cast i64 bounds) 0)
    (for [i 0 (len (load bounds))]
      (let [bp (elem bounds i)]
        (unless (= (primitive/cast i64 (.traits bp)) 0)
          (for [k 0 (len (load (.traits bp)))]
            (cc-push-trait-heads! p (.name (elem (.traits bp) k)) heads 0))
          0))))
  0)

(defn cc-push-trait-heads! [(p (ptr Program))
                            (tr (slice u8))
                            (heads (ptr SBox))
                            (depth i64)] (-> i64)
  (let [ts (load (field p traits))]
    ; a supertrait cycle is refused when traits are checked; the depth only keeps
    ; this walk finite on the way there
    (when (< depth (len (load ts)))
      (for [i 0 (len (load ts))]
        (let [td (elem ts i)]
          (when (= (.name td) tr)
            ; the trait itself: a trait with no methods is still a bound
            (push! (mut (.items heads))
                   (text/format (unit-allocator) "{}::" tr))
            (for [m 0 (len (load (.methods td)))]
              (push! (mut (.items heads))
                     (text/format (unit-allocator)
                                  "{}::{}"
                                  tr
                                  (.name (elem (.methods td) m)))))
            (for [r 0 (len (load (.requires td)))]
              (cc-push-trait-heads! p
                                    (get (load (.requires td)) r)
                                    heads
                                    (+ depth 1)))
            0)))
      0))
  0)

(defn closure-funcs-known [(p (ptr Program))
                           (names (ptr FnNames))
                           (seeds (ptr (ArrayList (slice u8))))
                           (a (dyn Allocator))]
  (-> (ptr (ArrayList (slice u8))))
  (let [stackb (box! a SBox (zeroed SBox))
        wantedb (box! a SBox (zeroed SBox))
        trait-heads (box! a SBox (zeroed SBox))
        index (closure-wanted-new a)]
    (set! (.items stackb) (ArrayList::new [(slice u8)] a))
    (set! (.items wantedb) (ArrayList::new [(slice u8)] a))
    (set! (.items trait-heads) (ArrayList::new [(slice u8)] a))
    (let [ns (len (load seeds))
          (mut si) 0]
      (loop (if (>= (load si) ns)
                (break)
                (do
                  (push! (mut (.items stackb)) (get (load seeds) (load si)))
                  (set! si (primitive/iadd (load si) 1))))))
    ; Match closure-subprogram's roots: compile-time constants need their
    ; callees, but runtime defs and their initializers belong to the target.
    ; Seeding runtime initializers here can pull target Var callers into a
    ; metaprogram object that deliberately contains no runtime static cells.
    (let [cs (load (field p consts))
          nc (len (load cs))
          (mut ci) 0]
      (loop (if (>= (load ci) nc)
                (break)
                (do
                  (let [definition (elem cs (load ci))]
                    (unless (.runtime definition)
                      (collect-calls (field definition value)
                                     names
                                     stackb
                                     trait-heads)
                      0))
                  (set! ci (primitive/iadd (load ci) 1))))))
    (closure-drain! p names stackb wantedb trait-heads index)
    (closure-mark-trait-heads! a wantedb trait-heads index)
    ; Module reachability can grow through an impl body, so repeat to a bounded
    ; fixpoint. Re-seeding an already-wanted callee is harmless.
    (let [is (load (field p impls))
          ni (len (load is))
          (mut selected) (ArrayList::new [i64] a)
          (mut pass) 0]
      (for [init 0 ni]
        (push! (mut selected) 0))
      (loop (if (> (load pass) ni)
                (break)
                (let [(mut added) false]
                  (for [ii 0 ni]
                    (let [ip (elem is ii)
                          fresh (= (get (load selected) ii) 0)]
                      (when (and (or fresh (not (impl-is-trait ip)))
                                 (closure-impl-wanted? a index ip))
                        (when fresh
                          (set! (mut selected)
                                ii
                                (if (and (not (impl-is-trait ip))
                                         (closure-impl-calls-macro? a
                                                                    p
                                                                    names
                                                                    ip))
                                    2
                                    1))
                          (closure-mark-impl! a p wantedb ip index)
                          (set! added true))
                        (when (closure-retain-methods! a
                                                       names
                                                       stackb
                                                       wantedb
                                                       trait-heads
                                                       index
                                                       ip
                                                       fresh
                                                       (= (get (load selected)
                                                               ii)
                                                          2)
                                                       true)
                          (set! added true)
                          0))))
                  (closure-drain! p names stackb wantedb trait-heads index)
                  (closure-mark-trait-heads! a wantedb trait-heads index)
                  (unless (load added) (break))
                  (set! pass (primitive/iadd (load pass) 1)))))
      0)
    (field wantedb items)))

(defn closure-funcs [(p (ptr Program))
                     (seeds (ptr (ArrayList (slice u8))))
                     (a (dyn Allocator))] (-> (ptr (ArrayList (slice u8))))
  (closure-funcs-known p (prog-fn-names p a) seeds a))

; ---- pruned closure (macro STAGING, interp deletion step 5 Phase B) ---------------
; closure-funcs minus the impl-method and const-value seeding: only the seeds'
; transitive callees ride along. Used by the per-qual staging prepass, where the
; whole point is that closure-funcs' unconditional impl/const seeding drags in
; functions whose bodies still hold unexpanded macro calls (a slice `get`'s
; dbg-get) and poisons every check. Measured 2026-07-21: with this pruning,
; 100% of the compiler's own macro quals and 99.6% of the corpus's check standalone.
; NAMES is `(prog-fn-names p …)`: a caller staging many quals against one
; program builds it once.
(defn closure-funcs-pruned [(p (ptr Program))
                            (names (ptr FnNames))
                            (seeds (ptr (ArrayList (slice u8))))
                            (a (dyn Allocator))]
  (-> (ptr (ArrayList (slice u8))))
  (let [stackb (box! a SBox (zeroed SBox))
        wantedb (box! a SBox (zeroed SBox))
        trait-heads (box! a SBox (zeroed SBox))
        index (closure-wanted-new a)]
    (set! (.items stackb) (ArrayList::new [(slice u8)] a))
    (set! (.items wantedb) (ArrayList::new [(slice u8)] a))
    (set! (.items trait-heads) (ArrayList::new [(slice u8)] a))
    (let [ns (len (load seeds))
          (mut si) 0]
      (loop (if (>= (load si) ns)
                (break)
                (do
                  (push! (mut (.items stackb)) (get (load seeds) (load si)))
                  (set! si (primitive/iadd (load si) 1))))))
    (closure-drain! p names stackb wantedb trait-heads index)
    (closure-mark-trait-heads! a wantedb trait-heads index)
    ; Generic operators in an otherwise pruned macro closure are selected only
    ; during the scratch check. Retain their reachable impl methods before that
    ; check so both signatures and bodies survive. An impl body can expose another
    ; trait head (Debug commonly delegates to Display), so selection must reach a
    ; fixpoint just like the ordinary closure calculation. Application impls stay
    ; excluded unless both their method head and owning module are reachable.
    (let [is (load (field p impls))
          ni (len (load is))
          (mut selected) (ArrayList::new [i64] a)
          (mut pass) 0]
      (for [init 0 ni]
        (push! (mut selected) 0))
      (loop (if (> (load pass) ni)
                (break)
                (let [(mut added) false]
                  (for [ii 0 ni]
                    (let [ip (elem is ii)
                          fresh (= (get (load selected) ii) 0)]
                      (when (and (or fresh (not (impl-is-trait ip)))
                                 (closure-impl-wanted? a index ip))
                        (when fresh
                          (set! (mut selected)
                                ii
                                (if (and (not (impl-is-trait ip))
                                         (closure-impl-calls-macro? a
                                                                    p
                                                                    names
                                                                    ip))
                                    2
                                    1))
                          (closure-mark-impl! a p wantedb ip index)
                          (set! added true))
                        (when (closure-retain-methods! a
                                                       names
                                                       stackb
                                                       wantedb
                                                       trait-heads
                                                       index
                                                       ip
                                                       fresh
                                                       (= (get (load selected)
                                                               ii)
                                                          2)
                                                       false)
                          (set! added true)
                          0))))
                  (closure-drain! p names stackb wantedb trait-heads index)
                  (closure-mark-trait-heads! a wantedb trait-heads index)
                  (unless (load added) (break))
                  (set! pass (primitive/iadd (load pass) 1)))))
      0)
    (field wantedb items)))

; A later-phase Code entry (currently a reader provider) may call same-module
; helpers as ordinary runtime functions, including mixed-signature adapters such as
; `(Code, slice u8) -> Code`. Reserve that module-local call graph from definition-
; time staging, but stop at module boundaries so imported APIs still receive normal
; macro expansion (for example coil.control.scope).
(defn closure-module-funcs-pruned [(p (ptr Program))
                                   (seeds (ptr (ArrayList (slice u8))))
                                   (a (dyn Allocator))]
  (-> (ptr (ArrayList (slice u8))))
  (let [names (prog-fn-names p a)
        stackb (box! a SBox (zeroed SBox))
        wantedb (box! a SBox (zeroed SBox))
        (mut owner-modules) (ArrayList::new [(slice u8)] a)]
    (set! (.items stackb) (ArrayList::new [(slice u8)] a))
    (set! (.items wantedb) (ArrayList::new [(slice u8)] a))
    (let [ns (len (load seeds))
          (mut si) 0]
      (loop (if (>= (load si) ns)
                (break)
                (do
                  (let [seed (get (load seeds) (load si))
                        owner (qual-module-of seed)]
                    (push! (mut (.items stackb)) seed)
                    (unless (set-contains (mut owner-modules) owner)
                      (push! (mut owner-modules) owner)))
                  (set! si (primitive/iadd (load si) 1))))))
    ; A later-phase provider owns its whole implementation module. Code-signed
    ; siblings that are not statically reachable from the entry can still be
    ; selected dynamically by the provider, and—more importantly—must never be
    ; executed as definition-time macros against their own declaration syntax.
    ; Every sibling in the provider module is reserved. Imported libraries are
    ; not swept wholesale, but helpers statically reachable from those siblings
    ; belong to the same later-phase computation and must follow it across the
    ; module boundary.
    (for [ni 0 (len (.items names))]
      (let [nm (get (.items names) ni)]
        (when (set-contains (mut owner-modules) (qual-module-of nm))
          (unless (set-contains (field wantedb items) nm)
            (push! (mut (.items wantedb)) nm)
            0)
          0))
      0)
    (loop (if (= (len (.items stackb)) 0)
              (break)
              (let [sl (.items stackb)
                    top (len sl)
                    nm (get sl (primitive/isub top 1))]
                (set! (.len (.items stackb)) (primitive/isub top 1))
                (when (not (set-contains (field wantedb items) nm))
                  (push! (mut (.items wantedb)) nm)
                  (let [f (fn-names-func names p nm)]
                    (when (and (!= (primitive/cast i64 f) 0)
                               (lazy-body-force! f))
                      (cc-list (load (field f body))
                               names
                               stackb
                               (primitive/cast (ptr SBox) 0))
                      0))))))
    (field wantedb items)))

; Keep only extern declarations that a reachable body calls or takes the address of.
; `prog-fn-names` includes extern names, so `collect-calls` puts those references in
; `wanted` alongside ordinary functions.
(defn closure-externs [(p (ptr Program))
                       (wanted (ptr (ArrayList (slice u8))))
                       (a (dyn Allocator))] (-> (ptr (ArrayList Extern)))
  (let [es (load (field p externs))
        n (len (load es))
        (mut keep) (ArrayList::new [Extern] a)]
    (for [i 0 n]
      (let [ep (elem es i)]
        (when (set-contains wanted (.name ep))
          (push! (mut keep) (load ep))
          0)))
    (box-al a (load keep))))

; closure-subprogram with consts PRUNED (companion of the above). Trait impls are
; retained only when a reachable call head and owning module select them; unrelated
; application impls still stay out of the early staging check.
;;; Add the accepted checked body of every wanted function `p` lacks. A
;;; retained session's candidate program carries only what it re-checked.
(defn closure-keep-base-funcs! [(a (dyn Allocator))
                                (wanted (ptr (ArrayList (slice u8))))
                                (keep (mut (ArrayList Func)))] (-> i64)
  (unless (and (= (.closure_base (comptime-unit-state))
                  (checkedbase/checked-no-base))
               (= (.closure_meta_base (comptime-unit-state))
                  (checkedbase/checked-no-base)))
    (let [(mut kept) (HashMap::new [(slice u8) i64] a (keyops-borrowed))]
      (for i (range 0 (len (load keep)))
        (set! (mut kept) (.name (elem keep i)) 1))
      (for name (iter (load wanted))
        (unless (contains? kept name)
          (match (closure-base-func name)
            (Some [function] (push! (mut keep) (load function)))
            (None [] 0))))))
  0)

;;; The declarations a closure sub-program reaches, as they are found. See
;;; `closure-prune-declarations!`.
(defstruct ClosureDecls
  [(a (dyn Allocator))
   ; every name a kept declaration mentions; `type-refs` adds to it
   (refs (HashMap (slice u8) i64))
   (seen (HashMap GraphKey i64))
   (structs (ptr (ArrayList StructDef)))
   (sums (ptr (ArrayList SumDef)))
   (traits (ptr (ArrayList TraitDef)))
   (struct-at (HashMap (slice u8) i64))
   ; a sum by its name and by each of its variants'
   (sum-at (HashMap (slice u8) i64))
   ; a trait by its name and by the names of its `dyn` and vtable structs
   (trait-at (HashMap (slice u8) i64))
   (kept-structs (ArrayList bool))
   (kept-sums (ArrayList bool))
   (kept-traits (ArrayList bool))])

(defn closure-keep-struct! [(d (ptr ClosureDecls)) (i i64)] (-> i64)
  (unless (get (.kept-structs d) i)
    (set! (mut (.kept-structs d)) i true)
    (let [sd (elem (.structs d) i)]
      (type-refs/struct! (mut (.refs d)) (mut (.seen d)) sd)
      (match (.layout sd)
        (LayoutWritten [_ _] (do (set! (mut (.refs d)) (layout-sum) 0) 0))
        (_ 0)))
    0)
  0)

(defn closure-keep-sum! [(d (ptr ClosureDecls)) (i i64)] (-> i64)
  (unless (get (.kept-sums d) i)
    (set! (mut (.kept-sums d)) i true)
    (type-refs/sum! (mut (.refs d)) (mut (.seen d)) (elem (.sums d) i))
    0)
  0)

;;; A kept trait brings its method signatures, its supertraits, and the `dyn` and
;;; vtable structs declared with it.
(defn closure-keep-trait! [(d (ptr ClosureDecls)) (i i64)] (-> i64)
  (unless (get (.kept-traits d) i)
    (set! (mut (.kept-traits d)) i true)
    (let [td (elem (.traits d) i)]
      (type-refs/trait! (mut (.refs d)) (mut (.seen d)) td)
      (for required (iter (load (.requires td)))
        (set! (mut (.refs d)) required 0))
      (set! (mut (.refs d)) (text/format (.a d) "{}-dyn" (.name td)) 0)
      (set! (mut (.refs d)) (text/format (.a d) "{}-vtable" (.name td)) 0))
    0)
  0)

(defn closure-keep-name! [(d (ptr ClosureDecls)) (name (slice u8))] (-> i64)
  (match (get (.struct-at d) name)
    (Some [i] (closure-keep-struct! d i))
    (None [] 0))
  (match (get (.sum-at d) name)
    (Some [i] (closure-keep-sum! d i))
    (None [] 0))
  (match (get (.trait-at d) name)
    (Some [i] (closure-keep-trait! d i))
    (None [] 0))
  0)

;;; Does the closure call a method of trait TD (by its head, or as `Trait::method`),
;;; or hold a bound on it? The test `closure-impl-wanted?` makes of an impl.
(defn closure-trait-reached? [(a (dyn Allocator))
                              (wanted (ptr (HashMap (slice u8) i64)))
                              (td (ptr TraitDef))] (-> bool)
  (block :reached
    (when (contains? (load wanted) (closure-bound-trait-key a (.name td)))
      (break :reached true))
    (let [owner (after-last-dot (.name td))]
      (for method (iter (load (.methods td)))
        (when (or (contains? (load wanted)
                             (closure-trait-head-key a (.name method)))
                  (contains? (load wanted)
                             (closure-trait-head-key a
                                                     (text/format a
                                                                  "{}::{}"
                                                                  owner
                                                                  (after-last-dot (.name method))))))
          (break :reached true))))
    false))

;;; The structs, sums, traits and aliases of the closure sub-program PP a macro is
;;; staged with: those of P that its functions, impls, externs and constants
;;; reach. A name they mention keeps the struct, sum (also through one of its
;;; variants) or trait it names, and what a kept declaration mentions is kept in
;;; turn: the fields and variants of a kept type, a kept trait's method
;;; signatures, supertraits and `dyn` structs. A trait is also reached by a call of
;;; one of its methods, a bound on it, or a kept impl of it. What the checker
;;; names itself is kept too: the whole prelude (`Copy`, `Drop`, `Callable`), the
;;; sum a written `:layout` or `:lower` value is checked against, and the
;;; annotation schemas and conventions, which the closure keeps whole. WANTED is
;;; the closure's wanted set (see closure-funcs).
;;;
;;; Staging checks a macro's own code, so a declaration it never reaches -- a
;;; struct elsewhere whose field names an unknown convention -- cannot stop it;
;;; carrying every declaration let one failure stop every macro, `defn` included,
;;; and the program's own error was never reached. The other closures keep every
;;; declaration: compile-time code reflects on the program through them
;;; (`code-trait-*`, a generator asking for a struct) and a `comptime` entry they
;;; host may name any type.
(defn closure-prune-declarations! [(a (dyn Allocator))
                                   (p (ptr Program))
                                   (pp (ptr Program))
                                   (wanted (ptr (HashMap (slice u8) i64)))]
  (-> i64)
  (let [structs (load (field p structs))
        sums (load (field p sums))
        traits (load (field p traits))
        prelude (unit-prelude-name)
        d
          (box! a
                ClosureDecls
                (ClosureDecls
                  :a a
                  :refs (HashMap::new [(slice u8) i64] a (keyops-borrowed))
                  :seen (HashMap::new [GraphKey i64] a (graph-keyops))
                  :structs structs
                  :sums sums
                  :traits traits
                  :struct-at (HashMap::new [(slice u8) i64] a (keyops-borrowed))
                  :sum-at (HashMap::new [(slice u8) i64] a (keyops-borrowed))
                  :trait-at (HashMap::new [(slice u8) i64] a (keyops-borrowed))
                  :kept-structs (ArrayList::new [bool] a)
                  :kept-sums (ArrayList::new [bool] a)
                  :kept-traits (ArrayList::new [bool] a)))]
    (for [i 0 (len (load structs))]
      (set! (mut (.struct-at d)) (.name (elem structs i)) i)
      (push! (mut (.kept-structs d)) false))
    (for [i 0 (len (load sums))]
      (let [sd (elem sums i)]
        (set! (mut (.sum-at d)) (.name sd) i)
        (for variant (iter (load (.variants sd)))
          (set! (mut (.sum-at d)) (.name variant) i)))
      (push! (mut (.kept-sums d)) false))
    (for [i 0 (len (load traits))]
      (let [name (.name (elem traits i))]
        (set! (mut (.trait-at d)) name i)
        (set! (mut (.trait-at d)) (text/format a "{}-dyn" name) i)
        (set! (mut (.trait-at d)) (text/format a "{}-vtable" name) i))
      (push! (mut (.kept-traits d)) false))
    ; what the closure's code mentions
    (for f (iter (load (.funcs pp)))
      (type-refs/func-value! (mut (.refs d)) (mut (.seen d)) f))
    (for [i 0 (len (load (.impls pp)))]
      (let [ip (elem (.impls pp) i)]
        (type-refs/impl! (mut (.refs d)) (mut (.seen d)) ip)
        (when (impl-is-trait ip)
          (set! (mut (.refs d)) (impl-trait-name ip) 0)
          0)))
    (for e (iter (load (.externs pp)))
      (type-refs/extern-value! (mut (.refs d)) (mut (.seen d)) e))
    (for c (iter (load (.consts pp)))
      (type-refs/const-value! (mut (.refs d)) (mut (.seen d)) c))
    (for ad (iter (load (.annotation_defs pp)))
      (type-refs/annotation-def-value! (mut (.refs d)) (mut (.seen d)) ad))
    (for c (iter (load (.conventions pp)))
      (type-refs/convention-value! (mut (.refs d)) (mut (.seen d)) c)
      (match (.lowering c)
        (LowerWritten [_] (do (set! (mut (.refs d)) (lowering-sum) 0) 0))
        (_ 0)))
    ; the prelude, and the traits whose methods the closure calls
    (for [i 0 (len (load structs))]
      (when (= (qual-module-of (.name (elem structs i))) prelude)
        (closure-keep-struct! d i)
        0))
    (for [i 0 (len (load sums))]
      (when (= (qual-module-of (.name (elem sums i))) prelude)
        (closure-keep-sum! d i)
        0))
    (for [i 0 (len (load traits))]
      (when (or (= (qual-module-of (.name (elem traits i))) prelude)
                (closure-trait-reached? a wanted (elem traits i)))
        (closure-keep-trait! d i)
        0))
    ; Every name mentioned keeps what it names, which may mention more.
    (let [(mut done) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
          (mut pending) (ArrayList::new [(slice u8)] a)]
      (loop (set! (.len pending) 0)
        (for name (iter (.refs d))
          (unless (contains? done name)
            (push! (mut pending) name)
            0))
        (when (= (len pending) 0) (break))
        (for name (iter pending)
          (set! (mut done) name 0)
          (closure-keep-name! d name))))
    (let [(mut kept-structs) (ArrayList::new [StructDef] a)
          (mut kept-sums) (ArrayList::new [SumDef] a)
          (mut kept-traits) (ArrayList::new [TraitDef] a)
          (mut kept-aliases) (ArrayList::new [AliasDef] a)]
      (for [i 0 (len (load structs))]
        (when (get (.kept-structs d) i)
          (push! (mut kept-structs) (get (load structs) i))
          0))
      (for [i 0 (len (load sums))]
        (when (get (.kept-sums d) i)
          (push! (mut kept-sums) (get (load sums) i))
          0))
      (for [i 0 (len (load traits))]
        (when (get (.kept-traits d) i)
          (push! (mut kept-traits) (get (load traits) i))
          0))
      ; an alias goes with its target
      (for alias (iter (load (.aliases p)))
        (when (or (contains? (.refs d) (.target alias))
                  (closure-declaration-kept? d (.target alias)))
          (push! (mut kept-aliases) alias)
          0))
      (set! (.structs pp) (box-al a kept-structs))
      (set! (.sums pp) (box-al a kept-sums))
      (set! (.traits pp) (box-al a kept-traits))
      (set! (.aliases pp) (box-al a kept-aliases)))
    0))

(defn closure-declaration-kept? [(d (ptr ClosureDecls)) (name (slice u8))]
  (-> bool)
  (or (match (get (.struct-at d) name)
        (Some [i] (get (.kept-structs d) i))
        (None [] false))
      (match (get (.sum-at d) name)
        (Some [i] (get (.kept-sums d) i))
        (None [] false))
      (match (get (.trait-at d) name)
        (Some [i] (get (.kept-traits d) i))
        (None [] false))))

(defn closure-subprogram-pruned [(p (ptr Program))
                                 (wanted (ptr (ArrayList (slice u8))))
                                 (a (dyn Allocator))] (-> (ptr Program))
  (let [pp (box! a Program (zeroed Program))
        fs (load (field p funcs))
        n (len (load fs))
        (mut keep) (ArrayList::new [Func] a)
        (mut keepi) (ArrayList::new [ImplDef] a)
        wanted-set (closure-name-set a wanted)]
    (for [i 0 n]
      (let [fp (elem fs i)]
        (when (and (set-contains wanted (.name fp))
                   (lazy-body-force! fp))
          (push! (mut keep) (load fp))
          0)))
    (closure-keep-base-funcs! a wanted (mut keep))
    (let [is (load (field p impls))]
      (for [ii 0 (len (load is))]
        (let [kept (closure-impl-kept a wanted-set (elem is ii))]
          (unless (= (primitive/cast i64 kept) 0)
            (push! (mut keepi) (load kept))
            0))))
    (set! (.annotation_defs pp) (load (field p annotation_defs)))
    (set! (.conventions pp) (load (field p conventions)))
    (set! (.externs pp) (closure-externs p wanted a))
    (set! (.funcs pp) (box-al a (load keep)))
    (set! (.asserts pp)
          (new-boxed-list [StaticAssert] a))
    (set! (.consts pp) (new-boxed-list [Const] a))
    (set! (.impls pp) (box-al a (load keepi)))
    (set! (.metas pp) (new-boxed-list [Expr] a))
    (set! (.exports pp) (new-boxed-list [ExportC] a))
    (set! (.function_abis pp) (load (field p function_abis)))
    (set! (.unit_exports pp) (load (field p unit_exports)))
    (set! (.unit_build pp) (.unit_build p))
    (set! (.retirements pp) (.retirements p))
    (set! (.retired_functions pp) (.retired_functions p))
    (closure-prune-declarations! a p pp wanted-set)
    ; A pre-expansion context still lacks the types pending macro calls declare,
    ; so leave out the structs and sums that name one, and their impls
    ; (reflection keeps seeing them in the context itself).
    (drop-undeclared-type-dependents! a pp)
    pp))

(defn closure-subprogram [(p (ptr Program))
                          (wanted (ptr (ArrayList (slice u8))))
                          (a (dyn Allocator))] (-> (ptr Program))
  (let [pp (box! a Program (zeroed Program))
        fs (load (field p funcs))
        n (len (load fs))
        (mut keep) (ArrayList::new [Func] a)
        (mut keepi) (ArrayList::new [ImplDef] a)]
    (for [i 0 n]
      (let [fp (elem fs i)]
        (when (and (set-contains wanted (.name fp))
                   (lazy-body-force! fp))
          (push! (mut keep) (load fp))
          0)))
    (closure-keep-base-funcs! a wanted (mut keep))
    (let [is (load (field p impls))
          wanted-set (closure-name-set a wanted)]
      (for [ii 0 (len (load is))]
        (let [kept (closure-impl-kept a wanted-set (elem is ii))]
          (unless (= (primitive/cast i64 kept) 0)
            (push! (mut keepi) (load kept))
            0))))
    (set! (.annotation_defs pp) (load (field p annotation_defs)))
    (set! (.conventions pp) (load (field p conventions)))
    (set! (.structs pp) (load (field p structs)))
    (set! (.sums pp) (load (field p sums)))
    (set! (.externs pp) (closure-externs p wanted a))
    (set! (.funcs pp) (box-al a (load keep)))
    (set! (.asserts pp)
          (new-boxed-list [StaticAssert] a))
    ; Runtime defs belong to the target program, never to the executable
    ; metaprogram closure. In particular their initializers may themselves
    ; contain macro calls which have not been expanded yet.
    (let [cs (load (field p consts))
          (mut keepc) (ArrayList::new [Const] a)]
      (for [ci 0 (len (load cs))]
        (let [cp (elem cs ci)]
          (unless (.runtime cp)
            (push! (mut keepc) (load cp))
            0)))
      (set! (.consts pp) (box-al a (load keepc))))
    (set! (.traits pp) (load (field p traits)))
    (set! (.impls pp) (box-al a (load keepi)))
    (set! (.metas pp) (new-boxed-list [Expr] a))
    (set! (.exports pp) (new-boxed-list [ExportC] a))
    (set! (.function_abis pp) (load (field p function_abis)))
    (set! (.unit_exports pp) (load (field p unit_exports)))
    (set! (.unit_build pp) (.unit_build p))
    (set! (.aliases pp) (load (field p aliases)))
    (set! (.retirements pp) (.retirements p))
    (set! (.retired_functions pp) (.retired_functions p))
    ; A pre-expansion context still lacks the types pending macro calls declare,
    ; so leave out the structs and sums that name one, and their impls
    ; (reflection keeps seeing them in the context itself).
    (drop-undeclared-type-dependents! a pp)
    pp))

(defn is-meta-form [(f (ptr Sexp))] (-> bool)
  (and (= (sx-tag (load f)) 6)
       (let [it (sx-items (load f))]
         (and (>= (sx-len it) 1)
              (and (= (sx-tag (sx-at it 0)) 2)
                   (= (sx-sval (sx-at it 0)) "meta"))))))

; ============================ comptime::fold_program ========================
; The comptime FOLD pass:
; walk every checked function body (and static-assert cond) and replace each
; `(comptime E)` node with the literal E evaluates to. Runs the SAME interpreter
; `eval` used for (meta …). Implemented as an IN-PLACE mutating walk (like
; qualify-expr): non-comptime nodes are recursed but left byte-identical, so the
; pass is a NO-OP for comptime-free programs (the exhaustive IR corpus + bootstrap
; stay unchanged); only `(comptime …)` nodes — currently a hard mono error — get
; folded. build_value reconstructs the literal-back (scalars → literals, a sum →
; a variant call, a struct/array → an imperative alloc+store+load).
(defn f64->bits [(x f64)] (-> i64)
  (let [(mut p) x] (load (primitive/cast (ptr i64) (mut p)))))

; NB: CtVal (a sum) is threaded BY POINTER through this mutual recursion — a
; by-value aggregate into recursion miscompiles (musttail TCE failure).
(defn build-content [(a (dyn Allocator))
                     (vp (ptr CtVal))
                     (span SourceSpan)
                     (cx (ptr CtCtx))] (-> (Result Expr Diag))
  (match (load vp)
    ; wrap the cross-recursion in a let so the call is NOT in tail position — a
    ; musttail'd aggregate-returning mutual tail call fails LLVM's TCE.
    (CInt [n] (let [r (build-value a vp span cx)] r))
    (CWideInt [_ _ _] (let [r (build-value a vp span cx)] r))
    (CBool [b] (let [r (build-value a vp span cx)] r))
    (CFloat [x] (let [r (build-value a vp span cx)] r))
    (CStr [s] (let [r (build-value a vp span cx)] r))
    (CCode [f] (let [r (build-value a vp span cx)] r))
    (CRef [cell] (let [r (build-content a cell span cx)] r))
    (CSum [variant fields]
          ; pre-mono, a sum value is a call to the variant name
          (let [nf (len (load fields))
                (mut args) (ArrayList::new [Expr] a)
                (mut i) 0
                (mut errf) (None [Diag])]
            (loop (if (or (diag-some? (load errf)) (>= (load i) nf))
                      (break)
                      (do
                        (match (build-value a
                                            (new-cell (cell-value (get (load fields)
                                                                       (load i))))
                                            span
                                            cx)
                          (Err [d] (do (set! errf (Some d)) 0))
                          (Ok [ev] (do (push! (mut args) ev) 0)))
                        (set! i (primitive/iadd (load i) 1)))))
            (match (load errf)
              (Some [d] (Err [Expr Diag] d))
              (None []
                    (Ok [Expr Diag]
                        (expr-from-span (ECall
                                          :func variant
                                          :type_args (box-items-type a)
                                          :args (box-al a (load args)))
                                        span))))))
    (CStruct [name fields]
             (let [sd (ct-struct-find cx name)]
               (if (= (primitive/cast i64 sd) 0)
                   (Err [Expr Diag]
                        (derr (text/format a
                                           "comptime: unknown struct '{}'"
                                           name)))
                   (let [n (.gensym cx)
                         _b (set! (.gensym cx) (primitive/iadd n 1))
                         t (text/format a "$ct{}" (i64->str a n))
                         sfs (load (field sd fields))
                         nfl (len (load sfs))
                         (mut body) (ArrayList::new [Expr] a)
                         (mut i) 0
                         (mut errf) (None [Diag])]
                     (loop (if (or (diag-some? (load errf)) (>= (load i) nfl))
                               (break)
                               (do
                                 (match (build-value a
                                                     (new-cell (cell-value (get (load fields)
                                                                                (load i))))
                                                     span
                                                     cx)
                                   (Err [d] (do (set! errf (Some d)) 0))
                                   (Ok [ev]
                                       (let [fname
                                               (.name (elem sfs
                                                            (load i)))
                                             fld
                                               (expr-from-span (EField (box-expr a
                                                                                 (expr-from-span (EVar t)
                                                                                                 span))
                                                                       fname)
                                                               span)]
                                         (do
                                           (push! (mut body)
                                                  (expr-from-span (EInitStore (box-expr a
                                                                                        fld)
                                                                              (box-expr a
                                                                                        ev))
                                                                  span))
                                           0))))
                                 (set! i (primitive/iadd (load i) 1)))))
                     (match (load errf)
                       (Some [d] (Err [Expr Diag] d))
                       (None []
                             (do
                               (push! (mut body)
                                      (expr-from-span (ELoad (box-expr a
                                                                       (expr-from-span (EVar t)
                                                                                       span)))
                                                      span))
                               (let [(mut binds) (ArrayList::new [Bind] a)
                                     bp (primitive/alloc-stack Bind)]
                                 (set! (.name bp) t)
                                 (set! (.mutable bp) false)
                                 (set! (.bid bp) 0)
                                 (set! (.owned_type bp)
                                       (primitive/cast (ptr Type) 0))
                                 (set! (.value bp)
                                       (expr-from-span (EAlloc
                                                         :symbol (None)
                                                         :storage 0
                                                         :ty (TStruct name)
                                                         :init
                                                           (primitive/cast (ptr Expr)
                                                                           0))
                                                       span))
                                 (push! (mut binds) (load bp))
                                 (Ok [Expr Diag]
                                     (expr-from-span (ELet (box-al a
                                                                   (load binds))
                                                           (box-al a
                                                                   (load body)))
                                                     span))))))))))
    ; A slice's elements live in static storage the literal owns: the value may
    ; outlive any frame it is used in. The slice points at that storage.
    (CSlice [elem cells]
            (let [nc (len (load cells))
                  (mut indices) (ArrayList::new [i64] a)
                  (mut items) (ArrayList::new [Expr] a)
                  (mut errf) (None [Diag])]
              (for [i 0 nc]
                (unless (diag-some? (load errf))
                  (match (build-value a
                                      (new-cell (cell-value (get (load cells) i)))
                                      span
                                      cx)
                    (Err [d] (do (set! errf (Some d)) 0))
                    (Ok [ev]
                        (do (push! (mut indices) i) (push! (mut items) ev) 0)))
                  0))
              (match (load errf)
                (Some [d] (Err [Expr Diag] d))
                (None []
                      (let [storage
                              (expr-from-span (EAlloc
                                                :storage 1
                                                :ty
                                                  (TArray (box-type a elem)
                                                          (FixedExtent nc))
                                                :init
                                                  (box-expr a
                                                            (expr-from-span (EStaticArray (box-al a
                                                                                                  (load indices))
                                                                                          (box-al a
                                                                                                  (load items)))
                                                                            span))
                                                :symbol (None [(slice u8)]))
                                              span)]
                        (Ok [Expr Diag]
                            (expr-from-span (EMakeSlice
                                              :data (box-expr a storage)
                                              :elem elem
                                              :len (FixedExtent nc))
                                            span)))))))
    (CArray [elem cells]
            (let [n (.gensym cx)
                  _b (set! (.gensym cx) (primitive/iadd n 1))
                  t (text/format a "$ct{}" (i64->str a n))
                  nc (len (load cells))
                  (mut body) (ArrayList::new [Expr] a)
                  (mut i) 0
                  (mut errf) (None [Diag])]
              (loop (if (or (diag-some? (load errf)) (>= (load i) nc))
                        (break)
                        (do
                          (match (build-value a
                                              (new-cell (cell-value (get (load cells)
                                                                         (load i))))
                                              span
                                              cx)
                            (Err [d] (do (set! errf (Some d)) 0))
                            (Ok [ev]
                                (let [idxe
                                        (expr-from-span (EIndex (box-expr a
                                                                          (expr-from-span (EVar t)
                                                                                          span))
                                                                (box-expr a
                                                                          (expr-from-span (EInt (load i))
                                                                                          span)))
                                                        span)]
                                  (do
                                    (push! (mut body)
                                           (expr-from-span (EInitStore (box-expr a
                                                                                 idxe)
                                                                       (box-expr a
                                                                                 ev))
                                                           span))
                                    0))))
                          (set! i (primitive/iadd (load i) 1)))))
              (match (load errf)
                (Some [d] (Err [Expr Diag] d))
                (None []
                      (do
                        (push! (mut body)
                               (expr-from-span (ELoad (box-expr a
                                                                (expr-from-span (EVar t)
                                                                                span)))
                                               span))
                        (let [(mut binds) (ArrayList::new [Bind] a)
                              bp (primitive/alloc-stack Bind)]
                          (set! (.name bp) t)
                          (set! (.mutable bp) false)
                          (set! (.bid bp) 0)
                          (set! (.owned_type bp) (primitive/cast (ptr Type) 0))
                          (set! (.value bp)
                                (expr-from-span (EAlloc
                                                  :symbol (None)
                                                  :storage 0
                                                  :ty
                                                    (fixed-array (box-type a
                                                                           elem)
                                                                 nc)
                                                  :init
                                                    (primitive/cast (ptr Expr)
                                                                    0))
                                                span))
                          (push! (mut binds) (load bp))
                          (Ok [Expr Diag]
                              (expr-from-span (ELet (box-al a
                                                            (load binds))
                                                    (box-al a
                                                            (load body)))
                                              span))))))))))

(defn build-value [(a (dyn Allocator))
                   (vp (ptr CtVal))
                   (span SourceSpan)
                   (cx (ptr CtCtx))] (-> (Result Expr Diag))
  (match (load vp)
    (CInt [n] (Ok [Expr Diag] (expr-from-span (EInt n) span)))
    ; a wide integer keeps its type: an i128's arithmetic is not a u128's
    (CWideInt [t wlo whi]
              (Ok [Expr Diag]
                  (expr-from-span (ECast t
                                         (box-expr a
                                                   (expr-from-span (EWideInt
                                                                     :neg false
                                                                     :lo wlo
                                                                     :hi whi
                                                                     :radix true
                                                                     :text "")
                                                                   span)))
                                  span)))
    (CBool [b] (Ok [Expr Diag] (expr-from-span (EBool b) span)))
    (CFloat [x]
            (Ok [Expr Diag] (expr-from-span (EFloat (f64->bits x)) span)))
    (CStr [s] (Ok [Expr Diag] (expr-from-span (EStr s) span)))
    (CCode [f]
           (Err [Expr Diag]
                (derr "comptime: a Code value can't be used as a runtime value (it's only meaningful at compile time)")))
    (CRef [cell] (let [r (build-content a cell span cx)] r))
    (CStruct [nm fs] (let [r (build-content a vp span cx)] r))
    (CArray [el cs] (let [r (build-content a vp span cx)] r))
    (CSlice [el cs] (let [r (build-content a vp span cx)] r))
    (CSum [vn fs] (let [r (build-content a vp span cx)] r))))

(defn fold-expr-list [(es (ptr (ArrayList Expr))) (cx (ptr CtCtx))]
  (-> (Result i64 Diag))
  (try (let [n (len (load es))]
         (for [i 0 n] (try! (fold-expr (elem es i) cx)))
         (Ok [i64 Diag] 0))))

(defn fold-quasi-list [(items (ptr (ArrayList Quasi))) (cx (ptr CtCtx))]
  (-> (Result i64 Diag))
  (try (let [n (len (load items))]
         (for [i 0 n] (try! (fold-quasi (elem items i) cx)))
         (Ok [i64 Diag] 0))))

(defn fold-quasi [(qp (ptr Quasi)) (cx (ptr CtCtx))] (-> (Result i64 Diag))
  (match (load qp)
    (QLit [_] (Ok [i64 Diag] 0))
    (QUnquote [e] (fold-expr e cx))
    (QSplice [e] (fold-expr e cx))
    (QList [items] (fold-quasi-list items cx))
    (QVector [items] (fold-quasi-list items cx))))

; Checked literal constants are already materialized values. Routing them through
; the native comptime hook built, linked and dlopen'd a dedicated dylib for every
; `(const NAME 1)` / string / bool in the graph. Preserve the outer node's source
; metadata and copy only the value kind in place.
(defn fold-direct-literal! [(dst (ptr Expr)) (src (ptr Expr))] (-> bool)
  (match (.kind src)
    (EInt [_] (do (set! (.kind dst) (.kind src)) true))
    (EFloat [_] (do (set! (.kind dst) (.kind src)) true))
    (EBool [_] (do (set! (.kind dst) (.kind src)) true))
    (EStr [_] (do (set! (.kind dst) (.kind src)) true))
    (ECStr [_] (do (set! (.kind dst) (.kind src)) true))
    (_ false)))

;;; A sum variant with no fields is likewise already a value: there is nothing to
;;; evaluate, and what evaluating it would hand back is fully determined. Build that
;;; through `build-value`, the same path a value read back from the engine takes, so
;;; the node ends up exactly as it would have.
;;;
;;; This is not a corner. `:inline (Always)` is such an expression, the annotation on
;;; every SIMD and `Callable` method, and each one used to cost a program of its own:
;;; monomorphize, emit, and under the interpreted engine link and `dlopen` a dylib.
;;; One build of `src/examples/simd.coil` did that 129 times, 38 of its 39 seconds.
(defn fold-fieldless-variant! [(dst (ptr Expr))
                               (src (ptr Expr))
                               (cx (ptr CtCtx))] (-> bool)
  (let [a (.a cx)
        spelled
          (match (.kind src)
            (ECall [func type-args args]
                   (if (and (= (len (load args)) 0)
                            (= (len (load type-args)) 0))
                       func
                       ""))
            (EConstruct [_ variant args]
                        (if (= (len (load args)) 0) variant ""))
            (_ ""))
        (mut known) ""]
    (when (and (> (len spelled) 0) (!= (primitive/cast i64 (.sums cx)) 0))
      (let [sums (ct-sums-visible cx)]
        (for [i 0 (len (load sums))]
          (let [variants (.variants (elem sums i))]
            (for [j 0 (len (load variants))]
              (let [v (elem variants j)]
                (when (and (= (.name v) spelled) (= (len (load (.fields v))) 0))
                  (set! known (.name v))
                  0))))))
      0)
    (if (= (len (load known)) 0)
        false
        (try (let [(mut value)
                     (try-or! (build-value a
                                           (new-cell (CSum (load known)
                                                           (new-boxed-list [(ptr CtVal)]
                                                                           a)))
                                           (expr-span dst)
                                           cx)
                              false)]
               (set! (.kind dst) (.kind value))
               true)))))

(defn fold-expr [(ep (ptr Expr)) (cx (ptr CtCtx))] (-> (Result i64 Diag))
  (let [a (.a cx)]
    (try (do
           (match (.kind ep)
             (EComptime [inner]
                        ; Evaluate the inner directly (eval handles nested comptime/reflection
                        ; with the proper environment) and splice the literal-back IN PLACE,
                        ; keeping this node's span. When
                        ; the tree-walk interpreter REJECTS the site (a generic call, sizeof, a
                        ; string — the mac-8 weaknesses), route it through the compiled metaprogram
                        ; engine via the registered hook (interp deletion step 1); the hook returns
                        ; null (declined) for anything it can't read back, leaving the interp error.
                        (if (or (fold-direct-literal! ep inner)
                                (fold-fieldless-variant! ep inner cx))
                            0
                            (let [lo (.lo ep)
                                  hi (.hi ep)
                                  hk (ct-fold-hook)]
                              ; the compiled engine is THE comptime evaluator (the tree-walking
                              ; interpreter is gone — decision 7). A hook decline (null) is a
                              ; located hard error; an unregistered hook means this compiler build
                              ; cannot evaluate comptime at all and says so.
                              (if (= (.isset hk)
                                     0)
                                  (return-from
                                    :try
                                      (Err (derr-at lo
                                                    hi
                                                    "comptime: this compiler build has no comptime engine registered (compiler bug)")))
                                  (let [r
                                          (call-ptr (.fp hk)
                                                    a
                                                    inner
                                                    cx)]
                                    (if (= (primitive/cast i64 r)
                                           0)
                                        (return-from
                                          :try
                                            (Err (derr-at-src (.source ep)
                                                              lo
                                                              hi
                                                              "comptime: this expression's value cannot be materialized as a compile-time literal")))
                                        (match (load (primitive/cast (ptr (Result Expr
                                                                                  Diag))
                                                                     r))
                                          (Err [d2] (return-from :try (Err d2)))
                                          (Ok [lit]
                                              (do
                                                (set! (.kind ep)
                                                      (.kind (box-expr a
                                                                       lit)))
                                                0)))))))))
             (ETraitCall [_ _ _ _] 0)
             (EAccessorField [p fname]
                             (do
                               (try! (fold-expr p cx))
                               (set! (.kind ep) (EField p fname))
                               0))
             (EQuasi [q]
                     ; Folding reaches the unquoted expressions through the template's
                     ; pointers and never changes the template value itself, so there is
                     ; nothing to write back into this node.
                     (do
                       (let [(mut qp) q] (try! (fold-quasi (mut qp) cx)))
                       0))
             (_ (visit-expr-children [child ep]
                                     (try! (fold-expr child cx)))))
           (Ok [i64 Diag] 0)))))

; Build the comptime CtCtx from a checked Program (mirrors fold_program's ctx).
(defn mk-ctctx [(checked (ptr Program)) (a (dyn Allocator))] (-> (ptr CtCtx))
  (let [cx (box! a CtCtx (zeroed CtCtx))]
    (set! (.a cx) a)
    (set! (.fns cx) (load (field checked funcs)))
    (set! (.structs cx) (load (field checked structs)))
    (set! (.sums cx) (load (field checked sums)))
    (set! (.traits cx) (load (field checked traits)))
    (set! (.fuel cx) 50000000)
    (set! (.depth cx) 0)
    (set! (.gensym cx) 0)
    (set! (.qmodule cx) (None [(slice u8)]))
    (set! (.module_fns cx) (primitive/cast (ptr (ArrayList (slice u8))) 0))
    (set! (.qimports cx) (primitive/cast (ptr ModImports) 0))
    (set! (.qexports cx) (primitive/cast (ptr (ArrayList ExpEntry)) 0))
    (set! (.prog cx) checked)
    (set! (.expansions cx) (primitive/cast (ptr (ArrayList Expansion)) 0))
    cx))

; A template needs folding only where an unquoted expression does: quoted syntax
; holds nothing to evaluate. Mutually recursive with `fold-needed?`.
(defn fold-quasi-needed? [(q Quasi)] (-> bool)
  (match q
    (QLit [_] false)
    (QUnquote [e] (fold-needed? e))
    (QSplice [e] (fold-needed? e))
    (QList [items] (fold-quasi-list-needed? items))
    (QVector [items] (fold-quasi-list-needed? items))))

(defn fold-quasi-list-needed? [(items (ptr (ArrayList Quasi)))] (-> bool)
  (let [(mut i) 0
        (mut yes) false]
    (loop (if (or (load yes) (>= (load i) (len (load items))))
              (break)
              (do
                (when (fold-quasi-needed? (load (elem items (load i))))
                  (set! yes true)
                  0)
                (set! i (+ (load i) 1)))))
    (load yes)))

; A cheap post-substitution test. Const replacement happens in finish before
; fold-program, so this sees EComptime introduced by a constant as well as one
; authored in the function. Forms that previously took the conservative fallback
; remain explicit true cases below; structural runtime forms inspect children.
(defn fold-list-needed? [(xs (ptr (ArrayList Expr)))] (-> bool)
  (let [(mut i) 0
        (mut yes) false]
    (loop (if (or (load yes) (>= (load i) (len (load xs))))
              (break)
              (do
                (when (fold-needed? (elem xs (load i)))
                  (set! yes true)
                  0)
                (set! i (+ (load i) 1)))))
    (load yes)))

(defn fold-binds-needed? [(xs (ptr (ArrayList Bind)))] (-> bool)
  (let [(mut i) 0
        (mut yes) false]
    (loop (if (or (load yes) (>= (load i) (len (load xs))))
              (break)
              (do
                (when (fold-needed? (field (elem xs (load i)) value))
                  (set! yes true)
                  0)
                (set! i (+ (load i) 1)))))
    (load yes)))

(defn fold-arms-needed? [(xs (ptr (ArrayList Arm)))] (-> bool)
  (let [(mut i) 0
        (mut yes) false]
    (loop (if (or (load yes) (>= (load i) (len (load xs))))
              (break)
              (do
                (when (fold-needed? (field (elem xs (load i)) body))
                  (set! yes true)
                  0)
                (set! i (+ (load i) 1)))))
    (load yes)))

(defn fold-needed? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EComptime [_] true)
    ; Quasiquote may contain unquotes with arbitrary expressions. It is rare in
    ; runtime output, so retain the full fold rather than duplicate its walker.
    (EQuasi [q] (fold-quasi-needed? q))
    (ETraitCall [_ _ _ _] false)
    (EAnonFn [_ _] true)
    (EBracketCall [_ _ _ _] true)
    (EConstParam [_ _] true)
    (EFnPtrInst [_ _] true)
    (_ (block :found
         (visit-expr-children [child e :except [EAnonFn EBracketCall]]
                              (when (fold-needed? child) (break :found true)))
         false))))

; fold_program: fold every function body (int place) and every static-assert cond.
(defn fold-program [(checked (ptr Program))
                    (asserts (ptr (ArrayList StaticAssert)))
                    (a (dyn Allocator))] (-> (Result i64 Diag))
  (let [cx (mk-ctctx checked a)
        fns (load (field checked funcs))
        nf (len (load fns))
        (mut err) (Ok [i64 Diag] 0)]
    (for [i 0 nf]
      (let [fp (elem fns i)
            anns (load (field fp annotations))
            an (len (load anns))]
        (for [ai 0 an]
          (match (fold-expr (field (elem anns
                                         ai)
                                   value)
                            cx)
            (Err [d]
                 (do
                   (set! err (Err d))
                   (break)))
            (Ok [_] 0)))
        (when (err? err) (break))
        (when (fold-list-needed? (load (field fp body)))
          (match (fold-expr-list (load (field fp body))
                                 cx)
            (Err [d] (do (set! err (Err d)) (break)))
            (Ok [_] 0))
          0)))
    ; A runtime `def` initializer is lowered as a link-time constant, so a
    ; `(comptime …)` inside it is folded here like one in a function body.
    (unless (err? err)
      (let [cs (load (field checked consts))]
        (for [ci 0 (len (load cs))]
          (let [cp (elem cs ci)]
            (when (and (.runtime cp) (not (err? err)))
              (match (fold-expr (field cp value) cx)
                (Err [d] (do (set! err (Err d)) 0))
                (Ok [_] 0)))
            0)))
      0)
    (match (load err)
      (Err [d] (Err d))
      (Ok [_]
          (let [na (len (load asserts))]
            (try
              (for [j 0 na]
                (match (fold-expr (field (elem asserts
                                               j)
                                         cnd)
                                  cx)
                  (Err [d] (break :try (Err d)))
                  (Ok [_] 0)))
              (Ok [i64 Diag] 0)))))))

; ---- comptime::run_metas — evaluate each (meta …) form (checked/elaborated) via the
;      comptime interpreter to a Code value, splice a `(do …)` result, else push it.
;      Returns the generated top-level forms as raw Sexp (re-resolved by the caller).
(defn ls-has-meta [(s (mut LS))] (-> bool)
  (let [a (.a s)
        out (box-al a (.out s))
        n (len (load out))
        (mut i) 0
        (mut r) false]
    (loop (if (or (load r) (>= (load i) n))
              (break)
              (do
                (when (is-meta-form (field (elem out (load i))
                                           form))
                  (set! r true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; Return meta modules in evaluation order, parallel to Program.metas.
(defn meta-form-modules [(s (mut LS)) (a (dyn Allocator))]
  (-> (ptr (ArrayList (Option (slice u8)))))
  (let [(mut mods) (ArrayList::new [(Option (slice u8))] a)
        n (len (.out s))]
    (for [i 0 n]
      (let [tf (elem (field s out) i)]
        (when (is-meta-form (field tf form))
          (push! (mut mods) (.module tf))
          0)))
    (box-al a (load mods))))

;;; Rebuild s.out without the (meta …) forms of the generators PICKED (indexes among
;;; the program's (meta …) forms), every other form in place, then GEN, the forms
;;; they generated, each in the module of the (meta …) form that produced it.
(defn splice-metas [(s (mut LS))
                    (gen (ptr (ArrayList Sexp)))
                    (genmods (ptr (ArrayList (Option (slice u8)))))
                    (picked (ptr (ArrayList i64)))
                    (a (dyn Allocator))] (-> i64)
  (let [old (box-al a (.out s))
        (mut newout) (ArrayList::new [TaggedForm] a)
        (mut c) 0]
    (for [i 0 (len (load old))]
      (let [tf (elem old i)]
        (if (is-meta-form (field tf form))
            (do
              (unless (block :hit
                        (for [k 0 (len (load picked))]
                          (when (= (get (load picked) k) (load c))
                            (break :hit true)))
                        false)
                (push! (mut newout) (load tf))
                0)
              (set! c (+ (load c) 1))
              0)
            (do (push! (mut newout) (load tf)) 0))))
    (for [j 0 (len (load gen))]
      (push! (mut newout) (mk-tagged (get (load gen) j) (get (load genmods) j))))
    (set! (.out s) (load newout))
    0))

; — the (meta …) staged-macro loop. `prog` is the
; NON-STRICT first resolve (metas non-empty): check the generator closure, run the
; metas, splice the generated forms, then STRICT re-resolve + final check.

; Source reflection is a revision-scoped publication. No declaration-name
; fallback is permitted: absence of occurrence evidence is explicitly unknown.
;
; Publishing builds nothing. The view holds a record per authored reference, and
; most rules never ask for it: `coil lint`'s standard profile asks nothing, and
; built eagerly it was hundreds of MB and a whole walk of the program on every
; analysis. The publisher leaves a builder, and the first query runs it.
(defn source-view-defer! [(build (fnptr (cc/C) [(ptr i8)] i64)) (cx (ptr i8))]
  (-> i64)
  (let [state (comptime-unit-state)]
    (set! (.source_ready state) false)
    (set! (.source_build state) build)
    (set! (.source_build_cx state) cx)
    0))

;;; Withdraw the publication, built or not: what it was built from is going away.
(defn source-view-discard! [] (-> i64)
  (let [state (comptime-unit-state)]
    (set! (.source_ready state) false)
    (set! (.source_build_cx state) (primitive/cast (ptr i8) 0))
    0))

;;; Is the source view available? Builds a deferred publication first.
(defn source-view-ready? [] (-> bool)
  (let [state (comptime-unit-state)
        cx (.source_build_cx state)]
    (when (and (not (.source_ready state)) (!= (primitive/cast i64 cx) 0))
      (set! (.source_build_cx state) (primitive/cast (ptr i8) 0))
      (let [span (tr/span-begin "lint.source-view")]
        (call-ptr (.source_build state) cx)
        (tr/span-end span))
      0)
    (.source_ready state)))

;;; How an authored occurrence binds, as the source view records it:
;;; `code-source-binding` answers with it as a coil.primitive.SourceBinding.
(defsum SourceBindingFact
  (FactGlobal [(name (slice u8))])
  (FactLocal [(id i64)])
  ;;; A local with no checked identity, or more than one.
  (FactLocalUnknown)
  (FactLocalAmbiguous)
  (FactUnknown)
  (FactAmbiguous))

;;; What the source view recorded of one authored occurrence: how it binds, and
;;; when it is a reference, its record's index in `source_references` (else -1).
(defstruct SourceOccurrence [(binding SourceBindingFact) (reference i64)])

;;; The source view's record of the authored reference NODE.
(defn source-occurrence-reference [(a (dyn Allocator)) (node Sexp)]
  (-> (Option Sexp))
  (let [state (comptime-unit-state)]
    (match (get (.source_occurrences state) (source-occurrence-key a node))
      (Some [occurrence]
            (if (< (.reference occurrence) 0)
                (None [Sexp])
                (Some (sx-at (sx-items (.source_references state))
                             (.reference occurrence)))))
      (None [] (None [Sexp])))))

(defn source-binding-answer [(a (dyn Allocator)) (fact SourceBindingFact)]
  (-> CtVal)
  (match fact
    (FactGlobal [name] (answer1 a "BindsGlobal" (sym-value name)))
    (FactLocal [id] (answer1 a "BindsLocal" (CCode (sx-mkint id))))
    (FactLocalUnknown [] (answer0 a "LocalUnknown"))
    (FactLocalAmbiguous [] (answer0 a "LocalAmbiguous"))
    (FactUnknown [] (answer0 a "BindingUnknown"))
    (FactAmbiguous [] (answer0 a "BindingAmbiguous"))))

(defn cop-source-query [(op i64)
                        (args (ptr (ArrayList CtVal)))
                        (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [state (comptime-unit-state)
        a (.a cx)]
    (if (= op 107)
        (match (cv-get args 0)
          (Some [v]
                (if (and (is-ccode v) (= (len (load args)) 1))
                    (answer op
                            (if (not (source-view-ready?))
                                (answer0 a "BindingUnknown")
                                (match (get (.source_occurrences state)
                                            (source-occurrence-key a
                                                                   (ccode-of v)))
                                  (Some [occurrence]
                                        (source-binding-answer a
                                                               (.binding occurrence)))
                                  (None [] (answer0 a "BindingUnknown"))))
                            cx)
                    (Err [CtVal Diag]
                         (derr "source-binding: expects one Code node"))))
          (None []
                (Err [CtVal Diag]
                     (derr "source-binding: expects one Code node"))))
        (if (!= (len (load args)) 0)
            (Err [CtVal Diag]
                 (derr (if (= op 105)
                           "source-modules: expects no arguments"
                           (if (= op 108)
                               "source-imports: expects no arguments"
                               "source-references: expects no arguments"))))
            (answer op
                    (if (not (source-view-ready?))
                        (answer0 a "SourceUnavailable")
                        (answer1 a
                                 "SourceIs"
                                 (CCode (cond (= op 105) (.source_modules state)
                                              (= op 108) (.source_imports state)
                                              :else (.source_references state)))))
                    cx)))))

;;; The node id the compiler worked on for NODE: its own, or, for an authored node a
;;; macro rebuilt, its expanded twin's (ast.coil, source-checked-id).
(defn source-checked-node [(node Sexp)] (-> i64)
  (source-checked-id (sx-node-id node)
                     (sx-source node)
                     (sx-lo node)
                     (sx-hi node)
                     (sx-ctxt node)))

;;; The indexed queries of the source view and the checked program
;;; (docs/design/PROGRAM_FACTS.md). Each is a lookup the size of its answer.
;;;
;;; 117 code-module-references MODULE   its authored references
;;; 118 code-import-references IMPORT   the references that resolved through IMPORT,
;;;                                     a `code-source-imports` record
;;; 119 code-references-to TARGET       references to TARGET: a qualified symbol, or a
;;;                                     local's identity (an integer)
;;; 120 code-module-binders MODULE      its `let` binders, `(binder MODULE NAME ID FORM VALUE)`
;;; 121 code-module-imports MODULE      its authored imports
;;; 122 code-reference-form REF         the form the reference heads
;;; 123 code-definition-form NAME       the authored form that defines NAME
;;; 124 code-resolved-uses NAME         how many checked uses resolve to NAME
;;; 125 code-field-uses STRUCT          the fields of STRUCT the program uses
;;; 126 code-cast-structs               the structs a pointer cast converts
;;; 127 code-path NODE                  `((FORM INDEX) …)`: the authored forms around
;;;                                     NODE, outermost first, each with the index
;;;                                     of the next step
;;; 128 code-module-forms MODULE HEAD   MODULE's authored forms headed by the core
;;;                                     syntax HEAD
(defn cop-program-facts [(op i64)
                         (args (ptr (ArrayList CtVal)))
                         (cx (ptr CtCtx))]
  (-> (Result CtVal Diag))
  (let [a (.a cx)
        state (comptime-unit-state)
        index (field state source_index)
        arg
          (match (cv-get args 0)
            (Some [v] (if (is-ccode v) (Some (ccode-of v)) (None [Sexp])))
            (None [] (None [Sexp])))
        name
          (match arg
            (Some [c]
                  (cond (= (sx-tag c) 2) (sx-sval c)
                        (= (sx-tag c) 0)
                          (text/format a "#{}" (i64->str a (sx-ival c)))
                        :else ""))
            (None [] ""))]
    (cond (and (>= op 117) (<= op 121))
            (if (and (!= op 118) (= (len name) 0))
                (Err [CtVal Diag]
                     (derr (text/format a
                                        "{}: expects a symbol"
                                        (program-facts-name op))))
                (answer op
                        (if (not (source-view-ready?))
                            (answer0 a "SourceUnavailable")
                            (answer1 a
                                     "SourceIs"
                                     (CCode (cond (= op 117)
                                                    (source-index-references a
                                                                             (field index
                                                                                    by_module)
                                                                             name)
                                                  (= op 119)
                                                    (source-index-references a
                                                                             (field index
                                                                                    by_target)
                                                                             name)
                                                  (= op 120)
                                                    (source-index-list a
                                                                       (field index
                                                                              binders)
                                                                       name)
                                                  (= op 121)
                                                    (source-index-list a
                                                                       (field index
                                                                              imports)
                                                                       name)
                                                  :else
                                                    (match arg
                                                      (Some [import]
                                                            (if (and (= (sx-tag import)
                                                                        6)
                                                                     (>= (sx-len (sx-items import))
                                                                         4))
                                                                (source-index-references a
                                                                                         (field index
                                                                                                by_import)
                                                                                         (text/format a
                                                                                                      "{} {}"
                                                                                                      (sx-sval (sx-at (sx-items import)
                                                                                                                      1))
                                                                                                      (sx-sval (sx-at (sx-items import)
                                                                                                                      3))))
                                                                (source-index-references a
                                                                                         (field index
                                                                                                by_import)
                                                                                         "")))
                                                      (None []
                                                            (source-index-references a
                                                                                     (field index
                                                                                            by_import)
                                                                                     "")))))))
                        cx))
          (= op 122)
            (answer op
                    (if (not (source-view-ready?))
                        (answer0 a "NoProgram")
                        (match arg
                          (Some [ref]
                                (let [node
                                        (if (and (= (sx-tag ref) 6)
                                                 (> (sx-len (sx-items ref)) 2)
                                                 (= (sx-head-name (sx-items ref))
                                                    "reference"))
                                            (sx-at (sx-items ref) 2)
                                            ref)]
                                  (match (get (.forms index)
                                              (source-occurrence-key a node))
                                    (Some [f] (answer1 a "Answer" (CCode f)))
                                    (None [] (answer0 a "NotInProgram")))))
                          (None [] (answer0 a "NotInProgram"))))
                    cx)
          (= op 127)
            (answer op
                    (if (not (source-view-ready?))
                        (answer0 a "NoProgram")
                        (match arg
                          (Some [node]
                                (let [(mut path) (ArrayList::new [Enclosing] a)]
                                  (if (and (source-path index node (mut path))
                                           (> (len path) 0))
                                      (let [(mut steps)
                                              (ArrayList::new [Sexp] a)]
                                        (for step (iter path)
                                          (let [(mut pair)
                                                  (ArrayList::new [Sexp] a)]
                                            (push! (mut pair) (.form step))
                                            (push! (mut pair)
                                                   (mk-sexp (KInt (.index step))
                                                            -1
                                                            -1))
                                            (push! (mut steps)
                                                   (sx-mklist (box-al a
                                                                      (load pair))))))
                                        (answer1 a
                                                 "Answer"
                                                 (CCode (sx-mklist (box-al a
                                                                           (load steps))))))
                                      (answer0 a "NotInProgram"))))
                          (None [] (answer0 a "NotInProgram"))))
                    cx)
          (= op 128)
            (match (cv-get args 1)
              (Some [hv]
                    (if (and (is-ccode hv)
                             (= (sx-tag (ccode-of hv)) 2)
                             (> (len name) 0))
                        (answer op
                                (if (not (source-view-ready?))
                                    (answer0 a "SourceUnavailable")
                                    (answer1 a
                                             "SourceIs"
                                             (CCode (source-index-list a
                                                                       (field index
                                                                              by_head)
                                                                       (text/format a
                                                                                    "{} {}"
                                                                                    name
                                                                                    (sx-sval (ccode-of hv)))))))
                                cx)
                        (Err [CtVal Diag]
                             (derr "module-forms: expects a module and a head, both symbols"))))
              (None []
                    (Err [CtVal Diag]
                         (derr "module-forms: expects a module and a head, both symbols"))))
          (= op 123)
            (answer op
                    (match (program-model)
                      (None [] (answer0 a "NoProgram"))
                      (Some [model0]
                            (let [(mut model) model0]
                              (let [f (pq/defining-form a (mut model) name)]
                                (if (or (= (primitive/cast i64 f) 0)
                                        (not (source-view-ready?)))
                                    (answer0 a "NotInProgram")
                                    (match (get (.written index)
                                                (source-written-key a
                                                                    (sx-source (load f))
                                                                    (sx-lo (load f))))
                                      (Some [written]
                                            (answer1 a "Answer" (CCode written)))
                                      (None [] (answer0 a "NotInProgram"))))))))
                    cx)
          (= op 124)
            (answer op
                    (if (= (primitive/cast i64 (sem-model)) 0)
                        (answer0 a "NoProgram")
                        (answer1 a
                                 "Answer"
                                 (CCode (mk-sexp (KInt (match (get (load (.resolved (program-facts)))
                                                                   name)
                                                         (Some [n] n)
                                                         (None [] 0)))
                                                 -1
                                                 -1))))
                    cx)
          :else
            (answer op
                    (if (or (not (source-view-ready?))
                            (not (.storage_open (source-facts))))
                        (answer0 a "NoProgram")
                        (let [(mut items) (ArrayList::new [Sexp] a)]
                          (if (= op 125)
                              (match (get (.field_uses (source-facts)) name)
                                (Some [fields]
                                      (for f (iter (load fields))
                                        (push! (mut items) (sx-sym f))))
                                (None [] 0))
                              (for st (iter (.cast_structs (source-facts)))
                                (push! (mut items) (sx-sym st))))
                          (answer1 a
                                   "Answer"
                                   (CCode (sx-mklist (box-al a
                                                             (load items)))))))
                    cx))))

;;; Where an authored node sits: the form directly containing it, and its index.
(defstruct Enclosing [(form Sexp) (index i64)])

;;; Is the span of NODE inside the span of FORM?
(defn span-within? [(node Sexp) (form Sexp)] (-> bool)
  (and (= (sx-source node) (sx-source form))
       (>= (sx-lo node) (sx-lo form))
       (<= (sx-hi node) (sx-hi form))))

(defn span-same? [(x Sexp) (y Sexp)] (-> bool)
  (and (= (sx-source x) (sx-source y))
       (= (sx-lo x) (sx-lo y))
       (= (sx-hi x) (sx-hi y))))

;;; The last of ITEMS, in source order, that starts at or before NODE, or -1.
(defn span-search [(items (ptr (ArrayList Sexp))) (node Sexp)] (-> i64)
  (let [(mut low) 0
        (mut high) (len (load items))]
    (loop (when (>= low high) (break))
      (let [mid (+ low (/ (- high low) 2))]
        (if (<= (sx-lo (get (load items) mid)) (sx-lo node))
            (set! low (+ mid 1))
            (set! high mid))))
    (- low 1)))

;;; The path to NODE: every authored form around it, outermost first, each with the
;;; index of the next step in it. Find its top-level form by where it was written,
;;; then descend through whichever child's span holds it. The cost is the depth of
;;; the path, not the size of the program. Empty for a top-level form, or a node no
;;; authored form holds.
(defn source-path [(index (ptr SourceIndex))
                   (node Sexp)
                   (out (mut (ArrayList Enclosing)))] (-> bool)
  (block :found
    (when (< (sx-source node) 0) (return-from :found false))
    (let [tops
            (match (get (.tops index) (sx-source node))
              (Some [forms] forms)
              (None [] (return-from :found false)))
          at (span-search tops node)]
      (when (< at 0) (return-from :found false))
      (let [(mut form) (get (load tops) at)]
        (when (or (not (span-within? node form)) (span-same? node form))
          (return-from :found false))
        (loop (unless (or (= (sx-tag form) 6) (= (sx-tag form) 7))
                (return-from :found false))
          (let [items (sx-items form)
                k (span-search items node)]
            (when (< k 0) (return-from :found false))
            (push! (mut out) (Enclosing :form form :index k))
            (let [child (sx-at items k)]
              (cond (span-same? child node) (return-from :found true)
                    (span-within? node child) (set! form child)
                    :else (return-from :found false)))))))))

(defn program-facts-name [(op i64)] (-> (slice u8))
  (cond (= op 117) "module-references"
        (= op 118) "import-references"
        (= op 119) "references-to"
        (= op 120) "module-binders"
        (= op 121) "module-imports"
        (= op 122) "reference-form"
        (= op 123) "definition-form"
        (= op 124) "resolved-uses"
        (= op 125) "field-uses"
        (= op 126) "cast-structs"
        (= op 127) "path"
        :else "module-forms"))

;;; MODULE's authored record, as a list of zero or one records.
(defn source-module-records [(a (dyn Allocator)) (module (slice u8))]
  (-> (ArrayList Sexp))
  (let [(mut out) (ArrayList::new [Sexp] a)]
    (match (get (.modules (field (comptime-unit-state) source_index)) module)
      (Some [record] (push! (mut out) record))
      (None [] 0))
    out))

(defn source-plan-refused [(a (dyn Allocator)) (reason (slice u8))]
  (-> (Result Sexp (slice u8)))
  (Err [Sexp (slice u8)] reason))

(defn source-plan-edit [(a (dyn Allocator)) (node Sexp) (replacement Sexp)]
  (-> Sexp)
  (let [(mut parts) (ArrayList::new [Sexp] a)]
    (push! (mut parts) (sx-sym "edit"))
    (push! (mut parts) node)
    (push! (mut parts) replacement)
    (sx-mklist (box-al a (load parts)))))

(defn source-alias-valid? [(alias (slice u8))] (-> bool)
  (let [(mut valid) (> (len alias) 0)]
    (for [i 0 (len alias)]
      (let [b (primitive/cast i64 (get alias i))
            letter (or (and (>= b 65) (<= b 90)) (and (>= b 97) (<= b 122)))]
        (unless (or letter
                    (= b 95)
                    (and (> i 0)
                         (or (= b 46) (= b 45) (and (>= b 48) (<= b 57)))))
          (set! valid false)
          0)))
    (load valid)))

; Imported-name matching is used ONLY to establish complete coverage. It never
; supplies ownership: every replacement must have a recorded successful route.
(defn source-visible-export-in? [(module (slice u8))
                                 (name (slice u8))
                                 (depth i64)] (-> bool)
  (block :done
    (let [state (comptime-unit-state)]
      (when (or (>= depth 64)
                (not (exports-check (.source_export_table state) module name)))
        (return-from :done false))
      (when (contains? (.declarations (source-facts))
                       (source-name-probe module name 0))
        (return-from :done true))
      (let [imports (imports-find (.source_import_table state) module)]
        (unless (= (primitive/cast i64 imports) 0)
          (for [i 0 (len (.reexports (.imp imports)))]
            (let [edge (elem (field (field imports imp) reexports) i)]
              (match (use-refers edge name)
                (Some [exported]
                      (when (source-visible-export-in? (.target edge)
                                                       exported
                                                       (+ depth 1))
                        (return-from :done true)))
                (None [] 0)))))))
    false))

(defn source-visible-export? [(use (ptr Use)) (name (slice u8))] (-> bool)
  (source-visible-export-in? (.target use) name 0))

(defn source-import-candidate? [(node Sexp)
                                (use (ptr Use))
                                (old-alias (slice u8))
                                (exports (ptr (ArrayList ExpEntry)))] (-> bool)
  (let [name (sx-sval node)
        slash (find-slash name)]
    (if (>= slash 0)
        (= (subslice name 0 slash) old-alias)
        (match (use-refers use name)
          (None [] false)
          (Some [exported] (source-visible-export? use exported))))))

; All potentially affected authored identifiers must have explicit evidence.
; Inert quotes are skipped; active unquotes are checked at their real depth.
; An identifier in a quasiquote template is not inert: the code the template
; generates resolves it where the macro is defined, so a template that names
; something this import brings in depends on the import. No evidence records how
; such a name binds, so the edit is refused instead of leaving it unqualified,
; unless the caller assumes template names are free references (see
; `source-template-edits!`).
(defn source-import-coverage? [(a (dyn Allocator))
                               (node Sexp)
                               (depth i64)
                               (use (ptr Use))
                               (old-alias (slice u8))
                               (exports (ptr (ArrayList ExpEntry)))] (-> bool)
  (block
    :done
      (let [tag (sx-tag node)
            head (if (= (sx-tag node) 6) (sx-head-name (sx-items node)) "")]
        (when (and (= depth 0)
                   (or (= head "quote") (= head "import") (= head "export")))
          (return-from :done true))
        (when (or (= tag 6) (= tag 7))
          (let [next-depth
                  (cond (= head "quasiquote") (+ depth 1)
                        (and (> depth 0)
                             (or (= head "unquote") (= head "unquote-splicing")))
                          (- depth 1)
                        :else depth)
                items (sx-items node)]
            (for [i 0 (sx-len items)]
              (unless (source-import-coverage? a
                                               (sx-at items i)
                                               next-depth
                                               use
                                               old-alias
                                               exports)
                (return-from :done false))))
          (return-from :done true))
        (when (and (> depth 0)
                   (and (= tag 2)
                        (source-import-candidate? node use old-alias exports)))
          (when (.source_assume_free (comptime-unit-state))
            (return-from :done true))
          (set! (.source_coverage_unknown (comptime-unit-state)) node)
          (set! (.source_coverage_template (comptime-unit-state)) true)
          (return-from :done false))
        (when (and (= depth 0)
                   (= tag 2)
                   (source-import-candidate? node use old-alias exports))
          (match (match (get (.source_occurrences (comptime-unit-state))
                             (source-occurrence-key a node))
                   (Some [occurrence] (Some (.binding occurrence)))
                   (None [] (None [SourceBindingFact])))
            (None []
                  (unless (match (get (.nonreferences (source-facts))
                                      (source-expression-key a
                                                             (sx-source node)
                                                             (sx-lo node)
                                                             (sx-hi node)
                                                             0
                                                             0))
                            (Some [_] true)
                            (None [] false))
                    (set! (.source_coverage_unknown (comptime-unit-state)) node)
                    (return-from :done false)))
            (Some [binding]
                  (match binding
                    ; a local is covered by its own binding
                    (FactLocal [_] 0)
                    (FactLocalUnknown [] 0)
                    (FactLocalAmbiguous [] 0)
                    (FactGlobal [qualified]
                                (match (source-occurrence-reference a node)
                                  (None []
                                        (do
                                          (set! (.source_coverage_unknown (comptime-unit-state))
                                                node)
                                          (return-from :done false)))
                                  (Some [reference]
                                        (let [record (sx-items reference)
                                              own-prefix
                                                (text/format a
                                                             "{}."
                                                             (sx-sval (sx-at record
                                                                             1)))]
                                          ; a reference that resolved through an import records it
                                          (unless (or (> (sx-len record) 4)
                                                      (and (>= (len qualified)
                                                               (len own-prefix))
                                                           (= (subslice qualified
                                                                        0
                                                                        (len own-prefix))
                                                              own-prefix)))
                                            (set! (.source_coverage_unknown (comptime-unit-state))
                                                  node)
                                            (return-from :done false))
                                          0))))
                    (_ (do
                         (set! (.source_coverage_unknown (comptime-unit-state))
                               node)
                         (return-from :done false)))))))
        true)))

; Under `assume-no-shadow`: every identifier in a quasiquote template that the
; import supplies is rewritten as a reference to it. Nothing here knows whether the
; template binds the same spelling itself; the caller has said none does, and the
; fix loop still reverts a round that stops compiling. This mirrors the depth
; discipline of `source-import-coverage?`, which is what let these names through.
(defn source-template-edits! [(a (dyn Allocator))
                              (node Sexp)
                              (depth i64)
                              (use (ptr Use))
                              (old-alias (slice u8))
                              (exports (ptr (ArrayList ExpEntry)))
                              (alias (slice u8))
                              (edits (mut (ArrayList Sexp)))] (-> bool)
  (block
    :done
      (let [tag (sx-tag node)
            head (if (= (sx-tag node) 6) (sx-head-name (sx-items node)) "")]
        (when (and (= depth 0)
                   (or (= head "quote") (= head "import") (= head "export")))
          (return-from :done true))
        (when (or (= tag 6) (= tag 7))
          (let [next-depth
                  (cond (= head "quasiquote") (+ depth 1)
                        (and (> depth 0)
                             (or (= head "unquote") (= head "unquote-splicing")))
                          (- depth 1)
                        :else depth)
                items (sx-items node)]
            (for [i 0 (sx-len items)]
              (unless (source-template-edits! a
                                              (sx-at items i)
                                              next-depth
                                              use
                                              old-alias
                                              exports
                                              alias
                                              (mut edits))
                (return-from :done false))))
          (return-from :done true))
        (when (and (> depth 0)
                   (and (= tag 2)
                        (source-import-candidate? node use old-alias exports)))
          (unless (and (= (sx-ctxt node) 0) (code-from-user-node? node))
            (set! (.source_coverage_unknown (comptime-unit-state)) node)
            (return-from :done false))
          (let [name (sx-sval node)
                slash (find-slash name)
                leaf
                  (if (>= slash 0)
                      (subslice name (+ slash 1) (len name))
                      (match (use-refers use name)
                        (Some [exported] exported)
                        (None [] name)))
                replacement (sx-sym (text/format a "{}/{}" alias leaf))]
            (unless (= (sx-sval node) (sx-sval replacement))
              (push! (mut edits) (source-plan-edit a node replacement))
              0)))
        true)))

(defn source-qualified-import [(a (dyn Allocator)) (form Sexp) (alias Sexp)]
  (-> Sexp)
  (let [items (sx-items form)
        (mut out) (ArrayList::new [Sexp] a)
        (mut i) 2]
    (push! (mut out) (sx-at items 0))
    (push! (mut out) (sx-at items 1))
    (push! (mut out) (mk-sexp (KKw "as") -1 -1))
    (push! (mut out) alias)
    (while (< (load i) (sx-len items))
      (let [part (sx-at items (load i))
            key (if (= (sx-tag part) 3) (sx-sval part) "")]
        (if (or (= key "as") (= key "use") (= key "exclude") (= key "rename"))
            (set! i (+ (load i) 2))
            (do (push! (mut out) part) (set! i (+ (load i) 1))))))
    (sx-mklist (box-al a (load out)))))

;;; The edits that qualify the import RECORD's references through ALIAS-NODE, as a
;;; list of `(edit NODE REPLACEMENT)`, or why there are none.
(defn source-qualify-import [(a (dyn Allocator))
                             (record Sexp)
                             (alias-node Sexp)
                             (assume-free bool)] (-> (Result Sexp (slice u8)))
  (block
    :done
      (let [state (comptime-unit-state)]
        (unless (source-view-ready?)
          (return-from
            :done (source-plan-refused a "authored source model is unavailable")))
        (unless (and (= (sx-tag record) 6)
                     (and (= (sx-head-name (sx-items record)) "source-import")
                          (= (sx-len (sx-items record)) 4)))
          (return-from
            :done
              (source-plan-refused a "expected an import record from imports")))
        (unless (and (= (sx-tag alias-node) 2)
                     (source-alias-valid? (sx-sval alias-node)))
          (return-from
            :done
              (source-plan-refused a
                                   "alias must start with a letter or underscore and contain letters, digits, underscores, hyphens or dots")))
        (let [parts (sx-items record)
              module (sx-sval (sx-at parts 1))
              form (sx-at parts 2)
              target (sx-sval (sx-at parts 3))
              alias (sx-sval alias-node)
              imp (imports-find (.source_import_table state) module)
              (mut recognized) false
              (mut matching) 0
              (mut old-alias) target
              (mut spec) (UNames (empty-names a))
              (mut exclude) (empty-names a)
              (mut renames) (empty-renames a)
              (mut reexport) false]
          (for item (load (sx-items (source-index-list a
                                                       (field (field state
                                                                     source_index)
                                                              imports)
                                                       module)))
            (let [items (sx-items item)]
              (when (and (= (sx-sval (sx-at items 1)) module)
                         (= (sx-sval (sx-at items 3)) target))
                (set! matching (+ (load matching) 1))
                0)
              (when (and (= (source-occurrence-key a (sx-at items 2))
                            (source-occurrence-key a form))
                         (sexp-eq item record))
                (set! recognized true)
                0)))
          (unless (and (load recognized) (= (load matching) 1))
            (return-from
              :done
                (source-plan-refused a
                                     "import is stale or its module has multiple imports of this target")))
          (unless (and (= (sx-ctxt form) 0) (code-from-user-node? form))
            (return-from
              :done
                (source-plan-refused a "import has no editable authored source")))
          (when (= (primitive/cast i64 imp) 0)
            (return-from
              :done (source-plan-refused a "import environment is unavailable")))
          (for existing (.aliases (.imp imp))
            (when (and (= (.alias existing) alias)
                       (!= (.target existing) target))
              (return-from
                :done
                  (source-plan-refused a
                                       "alias is already bound to another module"))))
          (let [items (sx-items form)
                (mut i) 2]
            (while (< (load i) (sx-len items))
              (let [part (sx-at items (load i))
                    key (if (= (sx-tag part) 3) (sx-sval part) "")]
                (cond (= key "as")
                        (do
                          (set! old-alias
                                (sx-sval (sx-at items (+ (load i) 1))))
                          (set! i (+ (load i) 2)))
                      (= key "use")
                        (let [names (sx-at items (+ (load i) 1))]
                          (set! spec
                                (if (= (sx-tag names) 7)
                                    (UNames (collect-syms a (sx-items names)))
                                    (UAll)))
                          (set! i (+ (load i) 2)))
                      (= key "exclude")
                        (do
                          (set! exclude
                                (collect-syms a
                                              (sx-items (sx-at items
                                                               (+ (load i) 1)))))
                          (set! i (+ (load i) 2)))
                      (= key "rename")
                        (do
                          (set! renames
                                (collect-renames a
                                                 (sx-items (sx-at items
                                                                  (+ (load i) 1)))))
                          (set! i (+ (load i) 2)))
                      (= key "reexport")
                        (do (set! reexport true) (set! i (+ (load i) 1)))
                      :else (set! i (+ (load i) 1))))))
          ; A reexport publishes bare names as part of this module's interface.
          ; Keep it explicit until qualification has an export-preserving plan.
          (when (load reexport)
            (return-from
              :done
                (source-plan-refused a
                                     "reexported imports require preserving the public export surface")))
          (let [use
                  (box! a
                        Use
                        (mk-use a
                                target
                                (load spec)
                                (load exclude)
                                (load renames)))
                (mut edits) (ArrayList::new [Sexp] a)]
            (let [replacement (source-qualified-import a form alias-node)]
              (unless (sexp-eq form replacement)
                (push! (mut edits) (source-plan-edit a form replacement))
                0))
            (set! (.source_coverage_template state) false)
            (set! (.source_assume_free state) assume-free)
            (for m (source-module-records a module)
              (when (= (sx-sval (sx-at (sx-items m) 0)) module)
                (let [forms (sx-items m)]
                  (for [i 1 (sx-len forms)]
                    (unless (source-import-coverage? a
                                                     (sx-at forms i)
                                                     0
                                                     use
                                                     (load old-alias)
                                                     (.source_export_table state))
                      (let [unknown (.source_coverage_unknown state)
                            where
                              (text/format a
                                           "{}:{}"
                                           (code-file-of unknown)
                                           (i64->str a
                                                     (code-line-of unknown)))]
                        (return-from
                          :done
                            (source-plan-refused a
                                                 (if (.source_coverage_template state)
                                                     (text/format a
                                                                  "a quasiquote template names '{}' at {}; code a template generates resolves its names where the macro is defined, which an edit cannot see"
                                                                  (sx-sval unknown)
                                                                  where)
                                                     (text/format a
                                                                  "source binding is incomplete for '{}' at {}"
                                                                  (sx-sval unknown)
                                                                  where))))))))
                0))
            (when assume-free
              (for m (source-module-records a module)
                (when (= (sx-sval (sx-at (sx-items m) 0)) module)
                  (let [forms (sx-items m)]
                    (for [i 1 (sx-len forms)]
                      (unless (source-template-edits! a
                                                      (sx-at forms i)
                                                      0
                                                      use
                                                      (load old-alias)
                                                      (.source_export_table state)
                                                      alias
                                                      (mut edits))
                        (return-from
                          :done
                            (source-plan-refused a
                                                 (text/format a
                                                              "a template name has no editable authored source: {}"
                                                              (sx-sval (.source_coverage_unknown state)))))))))))
            (for ref (load (sx-items (source-index-references a
                                                              (field (field state
                                                                            source_index)
                                                                     by_import)
                                                              (text/format a
                                                                           "{} {}"
                                                                           module
                                                                           target))))
              (let [ref-parts (sx-items ref)
                    ref-module (sx-sval (sx-at ref-parts 1))
                    node (sx-at ref-parts 2)
                    routed (> (sx-len ref-parts) 4)]
                (when (= ref-module module)
                  (when (and routed (= (sx-sval (sx-at ref-parts 4)) target))
                    (when (source-observed? node)
                      (return-from
                        :done
                          (source-plan-refused a
                                               "a macro inspected the spelling of an affected identifier")))
                    (unless (and (= (sx-ctxt node) 0)
                                 (code-from-user-node? node))
                      (return-from
                        :done
                          (source-plan-refused a
                                               "a reference has no editable authored source")))
                    (let [replacement
                            (sx-sym (text/format a
                                                 "{}/{}"
                                                 alias
                                                 (sx-sval (sx-at ref-parts 5))))]
                      (unless (= (sx-sval node) (sx-sval replacement))
                        (push! (mut edits)
                               (source-plan-edit a node replacement))
                        0)))
                  0)))
            (Ok [Sexp (slice u8)] (sx-mklist (box-al a (load edits)))))))))

(defn import-plan-answer [(a (dyn Allocator)) (plan (Result Sexp (slice u8)))]
  (-> CtVal)
  (match plan
    (Ok [edits] (answer1 a "PlanEdits" (CCode edits)))
    (Err [reason]
         (answer1 a "PlanRefused" (CCode (mk-sexp (KStr reason) -1 -1))))))

(defn cop-qualify-import [(op i64)
                          (args (ptr (ArrayList CtVal)))
                          (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (let [usage
          "qualify-import: expects an import record, an alias symbol and a mode, `strict or `assume-no-shadow"]
    (if (!= (len (load args)) 3)
        (Err [CtVal Diag] (derr usage))
        (let [record (get (load args) 0)
              alias (get (load args) 1)
              mode (get (load args) 2)]
          (if (and (is-ccode record) (and (is-ccode alias) (is-ccode mode)))
              (let [m (ccode-of mode)]
                (cond (and (= (sx-tag m) 2) (= (sx-sval m) "strict"))
                        (answer op
                                (import-plan-answer (.a cx)
                                                    (source-qualify-import (.a cx)
                                                                           (ccode-of record)
                                                                           (ccode-of alias)
                                                                           false))
                                cx)
                      (and (= (sx-tag m) 2) (= (sx-sval m) "assume-no-shadow"))
                        (answer op
                                (import-plan-answer (.a cx)
                                                    (source-qualify-import (.a cx)
                                                                           (ccode-of record)
                                                                           (ccode-of alias)
                                                                           true))
                                cx)
                      :else (Err [CtVal Diag] (derr usage))))
              (Err [CtVal Diag] (derr usage)))))))

(defn cop-suggest-edits [(op i64)
                         (args (ptr (ArrayList CtVal)))
                         (cx (ptr CtCtx))] (-> (Result CtVal Diag))
  (try (do
         (unless (= (len (load args)) 2)
           (break
             :try
               (Err [CtVal Diag]
                    (derr "suggest-edits: expects the edits of a plan and a message"))))
         (let [planv (get (load args) 0)
               msg (get (load args) 1)]
           (unless (and (is-ccode planv) (is-cstr msg))
             (break
               :try
                 (Err [CtVal Diag]
                      (derr "suggest-edits: expects Code and string"))))
           (let [plan (ccode-of planv)]
             (unless (= (sx-tag plan) 6)
               (break
                 :try
                   (Err [CtVal Diag]
                        (derr "suggest-edits: expects a list of (edit NODE REPLACEMENT)"))))
             (let [items (sx-items plan)]
               ; Validate every member before publishing any member of the group.
               (for [i 0 (sx-len items)]
                 (let [edit (sx-at items i)]
                   (unless (and (= (sx-tag edit) 6)
                                (and (= (sx-len (sx-items edit)) 3)
                                     (= (sx-head-name (sx-items edit)) "edit")))
                     (break
                       :try
                         (Err [CtVal Diag]
                              (derr "suggest-edits: malformed edit plan"))))
                   (let [node (sx-at (sx-items edit) 1)]
                     (unless (and (= (sx-ctxt node) 0)
                                  (and (code-from-user-node? node)
                                       (not (rule-src? (sx-source node)))))
                       (break
                         :try
                           (answer op (answer0 (.a cx) "SuggestionRefused") cx))))))
               (sug-begin-group!)
               (for [i 0 (sx-len items)]
                 (let [edit (sx-items (sx-at items i))
                       (mut call-args) (ArrayList::new [CtVal] (.a cx))]
                   (push! (mut call-args) (CCode (sx-at edit 1)))
                   (push! (mut call-args) msg)
                   (push! (mut call-args) (CCode (sx-at edit 2)))
                   (try! (cop-warn-or-suggest (.a cx)
                                              44
                                              (box-al (.a cx)
                                                      (load call-args))))))
               (sug-begin-group!)
               (answer op (answer0 (.a cx) "Suggested") cx)))))))
