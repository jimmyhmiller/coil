; src/compiler/comptime/interp.coil — a BYTECODE interpreter for the self-host Coil
; compiler. It consumes the SAME monomorphized Program the native backends
; consume (parse -> resolve -> check -> mono), compiles each mono'd function to a
; compact stack-bytecode ISA, and executes it on a small VM with a REAL memory
; model: pointers are genuine host addresses, `alloc-stack` bumps a malloc-backed
; per-frame buffer, heap allocations call real malloc, and loads/stores read and
; write actual process memory. FFI extern calls dispatch to real native libc
; functions through a builtin table, so a program that prints via `putchar` /
; `write` / `puts` actually prints.
;
; This module is strictly ADDITIVE: nothing here is wired into the compile
; pipeline. The driver's new `coil interp <file>` subcommand is the only entry
; point (driver.coil). The native backends are byte-unchanged.
;
; See docs/reference/BYTECODE_INTERP.md for the ISA, value/memory model, frame layout, and
; FFI dispatch.
;
; SCOPE: the slice implemented end-to-end is integer + float arithmetic,
; locals/let/mut, if/loop/while, direct calls + recursion, casts, pointer
; load/store + alloc, and libc FFI. Everything not yet implemented HARD-ERRORS
; with a clear message (idie) — never a silent no-op or sentinel.
(module coil.compiler.interp)
(import "coil.compiler.text" :as text)
(import "coil.primitive" :as primitive)
(import "coil.compiler.ir_syntax" :as irs)
(import "coil.compiler.vector_scalar" :use *)
(import "coil.compiler.float_math" :use *)
(import "coil.compiler.resolve" :use [ty-str])
(import "coil.compiler.unit_state" :use *)

(defstruct InterpUnitState
  [(arguments IArgs)
   (extern_hook InterpExternHook)
   (abort_hook InterpAbortHook)])

(defn interp-unit-state-cell [] (-> (ptr (ptr InterpUnitState)))
  (primitive/alloc-static (ptr InterpUnitState)))

(defn interp-unit-state [] (-> (ptr InterpUnitState))
  (let [p (load (interp-unit-state-cell))]
    (if (= (primitive/cast i64 p) 0) (primitive/alloc-static InterpUnitState) p)))

(defn interp-unit-bind! [(next (ptr InterpUnitState))]
  (-> (ptr InterpUnitState))
  (let [prior (interp-unit-state)]
    (set! (interp-unit-state-cell) next)
    prior))

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.wide_ints" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.layoutdb" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.compiler.native_call" :use *)
(import "coil.compiler.jit" :use [jit-exit-registration jit-run-exit-handlers!])
(import "coil.atomic" :as atomic)
(import "coil.cc" :as cc)

; libc functions the interpreter itself uses + the FFI builtin table. Names are
; module-qualified so the C SYMBOL is the last dot component (g-last-component),
; matching the cga64.* pattern; this avoids Coil-scope collisions with the same
; extern declared elsewhere while still linking to the real libc symbol.
; Signatures MUST match any other declaration of the same C symbol elsewhere in
; the compiler (one C symbol, one signature): `exit`/`write`/`malloc` are already
; declared in ffi/io/alloc, so these mirror those exactly, and `puts` mirrors
; llvm_probe's. Do not assume a symbol is unique to the interpreter — the check
; that catches a divergence only runs on a program that loads both declarations,
; which for a compiler module means `coil lint` over the whole package.
(extern interp.malloc [isize] (-> (ptr i8)))  ; size_t — mirror alloc.malloc (isize, not i64)

(extern interp.free [(ptr i8)] (-> void))

(defn interp-release-owned [(p (ptr i8))] (-> i64)
  (interp.free p)
  0)

(defn interp-owned-alloc [(size isize)] (-> (ptr i8))
  (let [p (interp.malloc size)]
    (unit-resource-kinded! p
                           (fnptr-of interp-release-owned)
                           UNIT-RESOURCE-INTERPRETER)
    p))

(extern interp.exit [i32] (-> void))

(extern interp.putchar [i32] (-> i32))

(extern interp.write [i32 (ptr i8) isize] (-> isize))

(extern interp.puts [(ptr i8)] (-> i32))

(extern interp.realloc [(ptr i8) isize] (-> (ptr i8)))

(extern interp.calloc [isize isize] (-> (ptr i8)))

(extern interp.memcpy [(ptr i8) (ptr i8) isize] (-> (ptr i8)))

(extern interp.memmove [(ptr i8) (ptr i8) isize] (-> (ptr i8)))

(extern interp.memset [(ptr i8) i32 isize] (-> (ptr i8)))

(extern interp.memcmp [(ptr i8) (ptr i8) isize] (-> i32))

(extern interp.strlen [(ptr i8)] (-> isize))

(extern interp.strcmp [(ptr i8) (ptr i8)] (-> i32))

(extern interp.read [i32 (ptr i8) isize] (-> isize))

(extern interp.abort [] (-> void))

(extern interp.fmod [f64 f64] (-> f64))

(extern interp.fmodf [f32 f32] (-> f32))

(extern interp.sqrt [f64] (-> f64))

(extern interp.sqrtf [f32] (-> f32))

(extern interp.floorf [f32] (-> f32))

(extern interp.ceilf [f32] (-> f32))

(extern interp.truncf [f32] (-> f32))

(extern interp.trunc [f64] (-> f64))

(extern interp.fmaf [f32 f32 f32] (-> f32))

(extern interp.fma [f64 f64 f64] (-> f64))

(extern interp.pow [f64 f64] (-> f64))

(extern interp.fabs [f64] (-> f64))

(extern interp.floor [f64] (-> f64))

(extern interp.ceil [f64] (-> f64))

; the libm functions behind coil.math's intrinsics (interp-float-math). The f32
; roundings, fabs and copysign go through f64, which is exact for them; the
; transcendentals call the f32 function the native backends call. Ties-to-even
; is nearbyint: C23 roundeven does not exist in macOS libm.
(extern interp.round [f64] (-> f64))

(extern interp.nearbyint [f64] (-> f64))

(extern interp.copysign [f64 f64] (-> f64))

(extern interp.sin [f64] (-> f64))

(extern interp.cos [f64] (-> f64))

(extern interp.tan [f64] (-> f64))

(extern interp.asin [f64] (-> f64))

(extern interp.acos [f64] (-> f64))

(extern interp.atan [f64] (-> f64))

(extern interp.atan2 [f64 f64] (-> f64))

(extern interp.sinh [f64] (-> f64))

(extern interp.cosh [f64] (-> f64))

(extern interp.tanh [f64] (-> f64))

(extern interp.exp [f64] (-> f64))

(extern interp.exp2 [f64] (-> f64))

(extern interp.log [f64] (-> f64))

(extern interp.log2 [f64] (-> f64))

(extern interp.log10 [f64] (-> f64))

(extern interp.sinf [f32] (-> f32))

(extern interp.cosf [f32] (-> f32))

(extern interp.tanf [f32] (-> f32))

(extern interp.asinf [f32] (-> f32))

(extern interp.acosf [f32] (-> f32))

(extern interp.atanf [f32] (-> f32))

(extern interp.atan2f [f32 f32] (-> f32))

(extern interp.sinhf [f32] (-> f32))

(extern interp.coshf [f32] (-> f32))

(extern interp.tanhf [f32] (-> f32))

(extern interp.expf [f32] (-> f32))

(extern interp.exp2f [f32] (-> f32))

(extern interp.logf [f32] (-> f32))

(extern interp.log2f [f32] (-> f32))

(extern interp.log10f [f32] (-> f32))

(extern interp.powf [f32 f32] (-> f32))

(extern interp.strtol [(ptr i8) (ptr (ptr i8)) i32] (-> i64))

(extern interp.atoi [(ptr i8)] (-> i32))

; Variadic forwarding. We always pass a fixed tail of 6 word-sized varargs; a
; real printf/snprintf reads only as many as the format string names, so extra
; (unused) trailing words are harmless. This is correct for integer / string /
; char / pointer conversions (the corpus' usage); %f-family (v-register)
; variadics are NOT supported and are not exercised.
(extern interp.printf [(ptr i8) ...] (-> i32))

(extern interp.snprintf [(ptr i8) i64 (ptr i8) ...] (-> i32))

(extern interp.dprintf [i32 (ptr i8) ...] (-> i32))

; address of element i of an ArrayList given by pointer (local copy of the a64
; helper, renamed to avoid a duplicate generic instantiation clash).
(defn ial-at [T] [(p (ptr (ArrayList T))) (i i64)] (-> (ptr T))
  (index (load (field p data)) i))

; ============================ hard-error helpers =============================
(defn idie [(msg (slice u8))] (-> i64)
  (let [w (stderr)]
    (ps w "interp: ")
    (ps w msg)
    (wb w 10)
    (interp.exit (: 1 i32))
    0))

(defn idie2 [(msg (slice u8)) (x (slice u8))] (-> i64)
  (let [w (stderr)]
    (ps w "interp: ")
    (ps w msg)
    (ps w x)
    (wb w 10)
    (interp.exit (: 1 i32))
    0))

; ============================ bytecode data model ============================
; One instruction: op + three immediate operands. See docs/reference/BYTECODE_INTERP.md
; for the opcode legend (mirrored in the VM `case` below).
(defstruct Instr [(op i64) (a i64) (b i64) (c i64)])

(defstruct BFunc
  [(name (slice u8))
   (nparams i64)
   (nlocals i64)
   (code (ptr (ArrayList Instr)))
   (retty Type)
   (state i64)])  ; 0 = body not yet compiled, 1 = compiled (lazy: only funcs reachable from main are compiled)

; a compile-time scope entry: local slot index + static type.
(defstruct CScope [(name (slice u8)) (slot i64) (ty Type) (next (ptr CScope))])

; a lexically-open loop during compilation.
(defstruct CLoop
  [(contlabel i64)
   (breaklabel i64)
   (resultlocal i64)
   (label (Option (slice u8)))
   (has_res bool)
   (resty Type)
   ; Operand-stack depth at loop entry. A break or continue may leave from the
   ; middle of an expression that has already pushed operands (the destination
   ; of an enclosing store, say); it restores this depth before jumping.
   (stacklocal i64)])

; per-function bytecode builder.
(defstruct FB
  [(cx (ptr Interp))
   (code (ArrayList Instr))
   (loops (ArrayList CLoop))
   (labels (ArrayList i64))
   (nlocals i64)
   (env (ptr CScope))
   (term bool)])

; a parsed inline-LLVM-IR body (see ELlvmIr): the raw text + the arg types,
; interpreted at runtime against the VM's real memory. `result` is the IR's $ret.
; `intrinsic` is the EIntrinsic it runs instead of text, for those the
; interpreter carries out at run time.
(defstruct IIr
  [(body (slice u8))
   (argtys (ArrayList Type))
   (result Type)
   (intrinsic (Option Intrinsic))])

; the interpreter context: the mono'd program + compiled functions + layouts.
;;; A runtime `def`'s static storage: allocated and initialized once, on its
;;; first reference, like the data a native build lays into its binary.
(defstruct IStatic [(name (slice u8)) (addr i64)])

(defstruct Interp
  [(a (dyn Allocator))
   (mp (ptr Program))
   (externs (ptr (ArrayList Extern)))
   (bfuncs (ArrayList BFunc))
   (layouts LayoutDb)
   (irs (ArrayList IIr))
   (statics (ArrayList IStatic))
   ; `(alloc-static T :as "sym")` cells by symbol: one per symbol, as a link
   (named_statics (ArrayList IStatic))
   ; native calls and callbacks (interp-ffi); null until first needed
   (ffi (ptr IFfiCtx))
   ; which functions compute with integers wider than 64 bits; null until a
   ; function is first compiled
   (wide (ptr WideScan))
   ; running a metaprogram or comptime fold for the compiler, which changes what
   ; a refusal tells the user to do instead
   (metaprogram bool)])

;;; The zeroed cell behind `(alloc-static T :as "symbol")`. There is no linker
;;; here, but the symbol still names exactly one cell: a second definition of it
;;; is the same error native linking reports.
(defn interp-named-static! [(cx (ptr Interp)) (symbol (slice u8)) (size i64)]
  (-> i64)
  (for [i 0 (len (.named_statics cx))]
    (when (= (.name (get (.named_statics cx) i)) symbol)
      (idie2 "duplicate static storage symbol: " symbol)))
  (let [addr
          (primitive/cast i64 (interp-owned-alloc (primitive/cast isize size)))]
    (memzero addr size)
    (push! (mut (.named_statics cx)) (IStatic :name symbol :addr addr))
    addr))

;; ============================ native calls ===================================
; On a host with native calls (native_call.coil) an extern is the real C
; function, found with dlsym, called under the host C ABI; a call-ptr to an
; address that is not an interpreted function is a native call too; and an
; interpreted function's pointer is a native thunk, so C can call it back.
; Without native calls (a wasm build of the compiler) externs go through the
; built-in table in extern-call and function pointers stay (fnptr-base + index).

;;; A call site that goes to native code: an extern, or a call-ptr whose target
;;; turns out not to be an interpreted function.
(defstruct IFfiCall [(addr i64) (plan NcPlan)])

;;; How C calls interpreted function i: `state` 0 = not yet asked, 1 = `plan`,
;;; 2 = its signature has types C cannot express.
(defstruct ICallback [(state i64) (plan NcPlan)])

;;; What a callback thunk carries: the context and the function it enters.
(defstruct ICallbackTarget [(ctx (ptr IFfiCtx)) (fidx i64)])

;;; An interpreter's native-call state. It is malloc-backed, and an Interp holds
;;; it by a pointer a retained snapshot shares rather than copies: compiled
;;; bytecode names call sites by index and function pointers by thunk address,
;;; so a copy of the interpreter must reach this same state. `cx` is whichever
;;; interpreter last entered it; a callback runs there.
(defstruct IFfiCtx
  [(cx (ptr Interp))
   (calls (ArrayList IFfiCall))
   (callbacks (ArrayList ICallback))
   (targets (ptr ICallbackTarget))
   (thunks i64)
   (nthunks i64)])

;;; Run the exit handlers interpreted code registered: those whose code is one of
;;; this context's callback thunks. They run before anything the unit releases
;;; with the context is gone (the prepare step of its unit resource), and at the
;;; latest before the thunks are unmapped.
(defn interp-ffi-run-exit-handlers [(p (ptr i8))] (-> i64)
  (let [ctx (primitive/cast (ptr IFfiCtx) p)]
    (unless (= (.thunks ctx) 0)
      (jit-run-exit-handlers! (.thunks ctx)
                              (+ (.thunks ctx) (nc-thunks-size (.nthunks ctx))))
      0))
  0)

(defn interp-ffi-release [(p (ptr i8))] (-> i64)
  (interp-ffi-run-exit-handlers p)
  (let [ctx (primitive/cast (ptr IFfiCtx) p)]
    (nc-release-code (.thunks ctx) (nc-thunks-size (.nthunks ctx)))
    (unless (= (primitive/cast i64 (.targets ctx)) 0)
      (interp.free (primitive/cast (ptr i8) (.targets ctx))))
    (for [i 0 (len (.calls ctx))]
      (nc-plan-free! (field (ial-at [IFfiCall] (field ctx calls) i) plan)))
    (for [i 0 (len (.callbacks ctx))]
      (when (= (.state (get (.callbacks ctx) i)) 1)
        (nc-plan-free! (field (ial-at [ICallback] (field ctx callbacks) i) plan))))
    (free! (mut (.calls ctx)))
    (free! (mut (.callbacks ctx)))
    (interp.free p)
    0))

(defn interp-ffi [(cx (ptr Interp))] (-> (ptr IFfiCtx))
  (when (= (primitive/cast i64 (.ffi cx)) 0)
    (let [a (malloc-allocator)
          ctx
            (primitive/cast (ptr IFfiCtx)
                            (interp.malloc (primitive/cast isize
                                                           (sizeof IFfiCtx))))]
      (set! ctx
            (IFfiCtx
              :cx cx
              :calls (ArrayList::new [IFfiCall] a)
              :callbacks (ArrayList::new [ICallback] a)
              :targets (primitive/cast (ptr ICallbackTarget) 0)
              :thunks 0
              :nthunks 0))
      (unit-resource-prepared! (primitive/cast (ptr i8) ctx)
                               (fnptr-of interp-ffi-run-exit-handlers)
                               (fnptr-of interp-ffi-release)
                               UNIT-RESOURCE-INTERPRETER)
      (set! (.ffi cx) ctx)))
  (.ffi cx))

;;; `cx` is about to run: callbacks through its (possibly shared) context land here.
(defn interp-ffi-enter! [(cx (ptr Interp))] (-> i64)
  (unless (= (primitive/cast i64 (.ffi cx)) 0)
    (set! (.cx (.ffi cx)) cx))
  0)

;;; Can C express this type? (Compile-time-only types cannot be laid out.)
(defn ffi-c-type? [(t (ptr Type))] (-> bool)
  (match (load t)
    (TInt [_ _] true)
    (TFloat [_] true)
    (TBool [] true)
    (TPtr [_] true)
    (TRef [_ _] true)
    (TFn [_ _ _] true)
    (TStruct [_] true)
    (TSlice [_] true)
    (TVoid [] true)
    (TNever [] true)
    (TArray [e _] (ffi-c-type? e))
    (TVec [e _] (ffi-c-type? e))
    (_ false)))

(defn ffi-c-types? [(ts (ptr (ArrayList Type))) (ret (ptr Type))] (-> bool)
  (let [(mut ok) (ffi-c-type? ret)]
    (for [i 0 (len (load ts))]
      (unless (ffi-c-type? (ial-at [Type] ts i)) (set! ok false)))
    ok))

;;; Register a native call site; returns its index for CALLNATIVE/CALLPTR.
(defn ffi-register-call! [(cx (ptr Interp))
                          (addr i64)
                          (types (ptr (ArrayList Type)))
                          (nfixed i64)
                          (ret (ptr Type))] (-> i64)
  (let [ctx (interp-ffi cx)
        plan (nc-plan (malloc-allocator) (field cx layouts) types nfixed ret)
        idx (len (.calls ctx))]
    (push! (mut (.calls ctx)) (IFfiCall :addr addr :plan plan))
    idx))

;;; Run native call site `site` on the argument cells at `argv`; `fm` holds an
;;; aggregate result.
(defn ffi-run-call [(cx (ptr Interp))
                    (site i64)
                    (addr i64)
                    (argv (ptr i64))
                    (fm (ptr FrameMem))] (-> i64)
  (let [call (ial-at [IFfiCall] (field (.ffi cx) calls) site)
        plan (field call plan)
        r (.ret plan)
        retbuf
          (if (and (not (.ret_void plan)) (>= (.kind r) 2))
              (frame-alloc fm (if (> (.size r) 0) (.size r) 1) 16)
              0)]
    (nc-invoke! (malloc-allocator) plan addr argv retbuf)))

;;; Interpreted function `fi` as a function pointer value.
(defn interp-fnptr [(cx (ptr Interp)) (fi i64)] (-> i64)
  (if (not (nc-available?))
      (primitive/iadd (fnptr-base) fi)
      (let [ctx (interp-ffi cx)]
        (when (= (.thunks ctx) 0)
          (let [n (len (.bfuncs cx))
                targets
                  (primitive/cast (ptr ICallbackTarget)
                                  (interp.malloc (primitive/cast isize
                                                                 (* (if (> n 0)
                                                                        n
                                                                        1)
                                                                    (sizeof ICallbackTarget)))))]
            (for [i 0 n]
              (set! (index targets i)
                    (ICallbackTarget :ctx ctx :fidx i))
              (push! (mut (.callbacks ctx))
                     (ICallback :state 0 :plan (zeroed NcPlan))))
            (set! (.targets ctx) targets)
            (set! (.nthunks ctx) n)
            (set! (.thunks ctx)
                  (nc-make-thunks (malloc-allocator)
                                  n
                                  (primitive/cast i64 targets)
                                  (sizeof ICallbackTarget)
                                  (nc-callback-stub (malloc-allocator)
                                                    (primitive/cast i64
                                                                    (primitive/cast (ptr i8)
                                                                                    (fnptr-of interp-callback-dispatch))))))))
        ; decide now, while only the compiling thread runs, how C would call it
        (let [cb (ial-at [ICallback] (field ctx callbacks) fi)]
          (when (= (.state cb) 0)
            (let [fd
                    (ial-at [Func] (load (field (load (field cx mp)) funcs)) fi)
                  (mut types) (interp-c-params cx fd)
                  ret (box-type (.a cx) (.ret fd))]
              (if (ffi-c-types? (mut types) ret)
                  (do
                    (set! (.plan cb)
                          (nc-plan (malloc-allocator)
                                   (field cx layouts)
                                   (mut types)
                                   (len types)
                                   ret))
                    (set! (.state cb) 1))
                  (set! (.state cb) 2)))))
        (+ (.thunks ctx) (* fi (nc-thunk-bytes))))))

;;; The parameter types C sees for function `fd`. A C entry the checker made
;;; for `fnptr-of` (or export-c) takes each struct by value while the function
;;; itself takes its address; the interpreter passes an aggregate by address
;;; either way, so the C types are what the callback must read.
(defn interp-c-params [(cx (ptr Interp)) (fd (ptr Func))] (-> (ArrayList Type))
  (let [(mut types) (ArrayList::new [Type] (.a cx))
        exports (load (field (load (field cx mp)) exports))
        (mut entry) (primitive/cast (ptr ExportC) 0)]
    (for [i 0 (len (load exports))]
      (let [e (ial-at [ExportC] exports i)]
        (when (= (.name e) (.name fd)) (set! entry e))))
    (if (= (primitive/cast i64 entry) 0)
        (for [i 0 (len (load (field fd params)))]
          (push! (mut types) (.ty (ial-at [Param] (load (field fd params)) i))))
        (for [i 0 (len (load (.params entry)))]
          (push! (mut types) (load (ial-at [Type] (.params entry) i)))))
    types))

;;; The interpreted function a function pointer value denotes, or -1 for any
;;; other address (a native function, when native calls are available).
(defn interp-fnptr-index [(cx (ptr Interp)) (v i64)] (-> i64)
  (if (nc-available?)
      (let [ctx (.ffi cx)]
        (if (or (= (primitive/cast i64 ctx) 0) (= (.thunks ctx) 0))
            -1
            (let [off (- v (.thunks ctx))
                  tb (nc-thunk-bytes)]
              (if (and (>= off 0)
                       (< off (* (.nthunks ctx) tb))
                       (= (% off tb) 0))
                  (/ off tb)
                  -1))))
      (let [fi (primitive/isub v (fnptr-base))]
        (if (and (>= fi 0) (< fi (len (.bfuncs cx)))) fi -1))))

;;; A native caller entered interpreted code through a thunk: read its arguments
;;; under the function's C signature, run it, and leave the result in the frame
;;; for the callback stub to return.
(defn interp-callback-dispatch [(frame (ptr NativeFrame))] (-> i64)
  (let [target (primitive/cast (ptr ICallbackTarget) (.nvec frame))
        ctx (.ctx target)
        cx (.cx ctx)
        fi (.fidx target)
        cb (ial-at [ICallback] (field ctx callbacks) fi)]
    (unless (= (.state cb) 1)
      (idie2 "C called a function whose signature C cannot express: "
             (.name (ial-at [BFunc] (field cx bfuncs) fi))))
    (let [plan (field cb plan)
          n (len (.args plan))
          (mut fm) (frame-new)
          cells
            (primitive/cast (ptr i64)
                            (frame-alloc (mut fm) (* (if (> n 0) n 1) 8) 8))]
      (for [i 0 n]
        (let [arg (get (.args plan) i)
              dst
                (if (>= (.kind arg) 2)
                    (frame-alloc (mut fm)
                                 (if (> (.size arg) 0) (.size arg) 1)
                                 16)
                    0)]
          (set! (index cells i) (nc-receive-arg frame plan i dst))))
      (let [r (.ret plan)
            retbuf
              (if (and (not (.ret_void plan)) (>= (.kind r) 2))
                  (frame-alloc (mut fm) (if (> (.size r) 0) (.size r) 1) 16)
                  0)
            v (vm-exec cx fi cells n retbuf)]
        (nc-return! frame plan v)
        (frame-free! (mut fm))
        0))))

; ============================ scope helpers ==================================
(defn cs-cons [(a (dyn Allocator))
               (nm (slice u8))
               (slot i64)
               (ty Type)
               (nx (ptr CScope))] (-> (ptr CScope))
  (let [p (box! a CScope (zeroed CScope))]
    (set! (.name p) nm)
    (set! (.slot p) slot)
    (set! (.ty p) ty)
    (set! (.next p) nx)
    p))

(defn cs-find [(s (ptr CScope)) (nm (slice u8))] (-> (ptr CScope))
  (if (= (primitive/cast i64 s) 0)
      (primitive/cast (ptr CScope) 0)
      (if (= (.name s) nm) s (cs-find (load (field s next)) nm))))

; ============================ struct/sum layout ==============================
; The VM retains these names because they describe bytecode operations at call
; sites, but all layout facts come from the same database as every backend.
(defn istruct-idx [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (struct-index (field cx layouts) nm))

(defn isum-idx [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (sum-index (field cx layouts) nm))

(defn isize-of [(cx (ptr Interp)) (tp (ptr Type))] (-> i64)
  ; Bytecode compilation uses zero as the return size of a void function.
  (match (load tp) (TVoid [] 0) (_ (size (field cx layouts) tp))))

(defn ialign-of [(cx (ptr Interp)) (tp (ptr Type))] (-> i64)
  (align (field cx layouts) tp))

(defn ifield-off [(cx (ptr Interp)) (si i64) (fi i64)] (-> i64)
  (field-offset (field cx layouts) si fi))

(defn ifield-idx [(cx (ptr Interp)) (si i64) (fname (slice u8))] (-> i64)
  (field-number (field cx layouts) si fname))

(defn itype-bytes [(cx (ptr Interp)) (tp (ptr Type))] (-> i64)
  (type-bytes (field cx layouts) tp))

(defn isum-words-def [(cx (ptr Interp)) (variants (ptr (ArrayList Variant)))]
  (-> i64)
  (sum-words (field cx layouts) variants))

(defn inatural-off [(cx (ptr Interp)) (fs (ptr (ArrayList Field))) (fi i64)]
  (-> i64)
  (natural-offset (field cx layouts) fs fi))

(defn ivariant-idx [(cx (ptr Interp)) (su i64) (vname (slice u8))] (-> i64)
  (variant-number (field cx layouts) su vname))

(defn iregister-types! [(cx (ptr Interp)) (mp (ptr Program))] (-> i64)
  (set! (.layouts cx) (LayoutDb::new (.a cx) mp "interp" 8 8))
  0)

; Bit-struct access needs the declared bit offsets and field types in addition
; to ordinary byte layout, so it reads the shared entry directly. Returns the
; byte offset of the window the field is reached through (bits-window!).
(defn ibits-info [(cx (ptr Interp))
                  (nm (slice u8))
                  (fname (slice u8))
                  (lowp (ptr i64))
                  (widthp (ptr i64))
                  (signedp (ptr bool))
                  (backbytesp (ptr i64))] (-> i64)
  (let [si (istruct-idx cx nm)]
    (when (< si 0)
      (idie2 "bit access on unknown struct: " nm))
    (let [e (struct-at (field cx layouts) si)]
      (match (.layout e)
        (LBits [backing offs]
               (let [fi (ifield-idx cx si fname)
                     (mut back) backing]
                 (set! lowp (get (load offs) fi))
                 (match (.ty (ial-at [Field] (load (field e fields)) fi))
                   (TInt [bits sg] (do (set! widthp bits) (set! signedp sg) 0))
                   (TBool [] (do (set! widthp 1) (set! signedp false) 0))
                   (_ (do (idie "bit-struct field with non-int type") 0)))
                 ; a wider backing is reached through the 64-bit word holding
                 ; the field: the byte offset of that word is the result
                 (let [wb (bits-window! lowp (mut back))]
                   (set! backbytesp (/ (load back) 8))
                   wb)))
        (_ (do (idie2 "bit access on non-bits struct: " nm) 0))))))

; Bytecode type classification is interpreter policy, not physical layout.
(defn signed-of [(tp (ptr Type))] (-> bool)
  (match (load tp) (TInt [b sg] sg) (_ false)))

(defn ty-is-agg [(tp (ptr Type))] (-> bool)
  (match (load tp)
    (TStruct [nm] true)
    (TSlice [e0] true)
    (TArray [e1 n0] true)
    (TVec [e2 n1] true)
    (_ false)))

(defn ty-is-float2 [(tp (ptr Type))] (-> bool)
  (match (load tp) (TFloat [b] true) (_ false)))

(defn fbytes-of [(tp (ptr Type))] (-> i64)
  (match (load tp) (TFloat [b] (/ b 8)) (_ 8)))

(defn isbool01 [(t Type)] (-> i64)
  (match t (TBool [] 1) (_ 0)))

(defn ty-pointee2 [(tp (ptr Type))] (-> Type)
  (match (load tp)
    (TPtr [inner] (load inner))
    (TRef [m2 inner] (load inner))
    (_ (do (idie "load/deref of a non-pointer value") (TInt 64 true)))))

(defn tmode [(tp (ptr Type))] (-> i64)
  (match (load tp)
    (TFloat [bits] (if (= bits 32) 1 2))
    (_ 0)))

(defn tsignbits [(tp (ptr Type))] (-> i64)
  (match (load tp)
    (TInt [bits sg] (| (when sg 1) (<< bits 1)))
    (TBool [] (<< 1 1))
    (_ (<< 64 1))))

(defn tsigned [(tp (ptr Type))] (-> i64)
  (match (load tp) (TInt [bits sg] (when sg 1)) (TBool [] 0) (_ 1)))

(defn tsize [(cx (ptr Interp)) (t Type)] (-> i64)
  (let [(mut tp) (: t Type)] (isize-of cx (mut tp))))

; ============================ bytecode emit ==================================
(defn femit [(fb (ptr FB)) (op i64) (a i64) (b i64) (c i64)] (-> i64)
  (let [(mut ins) (zeroed Instr)]
    (set! (.op ins) op)
    (set! (.a ins) a)
    (set! (.b ins) b)
    (set! (.c ins) c)
    (push! (mut (.code fb)) ins)
    0))

(defn fnew-label [(fb (ptr FB))] (-> i64)
  (let [id (len (.labels fb))]
    (push! (mut (.labels fb)) -1)
    id))

(defn fbind-label [(fb (ptr FB)) (id i64)] (-> i64)
  (set! (mut (.labels fb)) id (len (.code fb)))
  0)

(defn fb-local! [(fb (ptr FB))] (-> i64)
  (let [n (.nlocals fb)] (set! (.nlocals fb) (primitive/iadd n 1)) n))

; rewrite every JMP(11)/JZ(12) target from label-id to instruction index.
(defn resolve-labels [(fb (ptr FB))] (-> i64)
  (let [n (len (.code fb))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ins (ial-at [Instr] (field fb code) (load i))
                      op (.op ins)]
                  (when (or (= op 11)
                            (= op 12))
                    (set! (.a ins)
                          (get (.labels fb)
                               (.a ins)))))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; ============================ compile-time helpers ===========================
(defn find-func [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (let [n (len (.bfuncs cx))
        (mut r) -1]
    (for [i 0 n]
      (when (= (.name (ial-at [BFunc]
                              (field cx bfuncs)
                              i))
               nm)
        (set! r i)
        (break)))
    (load r)))

(defn find-extern [(cx (ptr Interp)) (nm (slice u8))] (-> i64)
  (let [es (load (field cx externs))
        n (len (load es))
        (mut r) -1]
    (for [i 0 n]
      (when (= (.name (ial-at [Extern] es i)) nm)
        (set! r i)
        (break)))
    (load r)))

; loop index (labeled search from innermost, else innermost). Mirrors g-loop-index.
(defn cloop-index [(fb (ptr FB)) (label (Option (slice u8)))] (-> i64)
  (let [n (len (.loops fb))]
    (match label
      (None []
            (do
              (when (= n 0)
                (idie "break/continue outside a loop"))
              (primitive/isub n 1)))
      (Some [want]
            (let [(mut i) (primitive/isub n 1)
                  (mut r) -1]
              (loop (if (< (load i) 0)
                        (break)
                        (do
                          (match (.label (ial-at [CLoop]
                                                 (field fb loops)
                                                 (load i)))
                            (None [] 0)
                            (Some [have]
                                  (when (and (< (load r) 0)
                                             (= have want))
                                    (set! r (load i))
                                    0)))
                          (set! i (primitive/isub (load i) 1)))))
              (when (< (load r) 0)
                (idie2 "no such loop label: " want))
              (load r))))))

; A Coil function pointer is encoded as (fnptr-base + fidx): a large, nonzero,
; distinctive tag so a valid fnptr never collides with 0 (null) or small ints,
; and ECallPtr decodes the fidx back. (Real C function addresses are not
; supported as call targets — only Coil functions taken with fnptr-of.)
(defn fnptr-base [] (-> i64)
  2251799813685248)  ; 2^51

; the (TFn …) type of function fidx, built from its params + ret (for ECallPtr).
(defn func-fn-type [(cx (ptr Interp)) (fi i64)] (-> Type)
  (let [a (.a cx)
        fd (ial-at [Func] (load (field (load (field cx mp)) funcs)) fi)
        ps (load (field fd params))
        np (len (load ps))
        (mut ptys) (ArrayList::new [Type] a)]
    (for [i 0 np]
      (push! (mut ptys) (.ty (ial-at [Param] ps i))))
    (TFn
      :cc (cc-c)
      :params (box-al [Type] a ptys)
      :ret (box-type a (.ret fd)))))

; the last dot component of a name (extern "io.write" -> C symbol "write").
(defn last-component2 [(nm (slice u8))] (-> (slice u8))
  (let [n (len nm)
        (mut dot) -1]
    (for [i 0 n]
      (when (= (primitive/cast i64 (get nm i))
               46)
        (set! dot i)))
    (if (>= (load dot) 0)
        (subslice nm (primitive/iadd (load dot) 1) n)
        nm)))

; intern a string literal into a persistent, NUL-terminated malloc region and
; return its address. String literals are compile-time constants, so the pointer
; is baked into the bytecode as an immediate.
(defn intern-bytes [(sv (slice u8))] (-> i64)
  (let [n (len sv)
        addr
          (primitive/cast i64
                          (interp-owned-alloc (primitive/cast isize
                                                              (primitive/iadd n
                                                                              1))))]
    (for [i 0 n]
      (set! (primitive/cast (ptr u8) (primitive/iadd addr i))
            (get sv i)))
    (set! (primitive/cast (ptr u8) (primitive/iadd addr n))
          (: 0 u8))
    addr))

; ============================ compile ========================================
(defn compile-args [(fb (ptr FB)) (args (ptr (ArrayList Expr)))] (-> i64)
  (let [n (len (load args))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (compile-expr fb (ial-at [Expr] args (load i)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn compile-linked-call [(fb (ptr FB))
                           (fp (ptr Expr))
                           (args (ptr (ArrayList Expr)))] (-> (Option Type))
  (match (.kind fp)
    (EIntrinsic [op ty operands]
                (match op
                  (ILinkerAddress [symbol]
                                  (match ty
                                    (TFn [cc params ret]
                                         (let [cx (.cx fb)
                                               a (.a cx)
                                               name
                                                 (text/format a
                                                              "!linked:{}{}"
                                                              symbol
                                                              (ty-str a
                                                                      (box-type a
                                                                                ty)))]
                                           ; A constant linker-address call is a direct extern call. Intern
                                           ; its complete signature, then use the interpreter's normal FFI
                                           ; dispatch (including its explicit unsupported-symbol diagnostics).
                                           (when (< (find-extern cx name) 0)
                                             (push! [Extern]
                                                    (.externs cx)
                                                    (Extern
                                                      :name name
                                                      :symbol (Some symbol)
                                                      :cc cc
                                                      :params params
                                                      :variadic false
                                                      :ret (load ret)
                                                      :span_source -1
                                                      :params_lo 0
                                                      :params_hi 0
                                                      :ret_lo 0
                                                      :ret_hi 0)))
                                           (Some (compile-call fb name args))))
                                    (_ (None))))
                  (_ (None))))
    (_ (None))))

(defn compile-call [(fb (ptr FB))
                    (func (slice u8))
                    (args (ptr (ArrayList Expr)))] (-> Type)
  (let [cx (load (field fb cx))
        fi (find-func cx func)]
    (if (>= fi 0)
        (do
          (compile-args fb args)
          (femit fb 13 fi (len (load args)) 0)
          (ensure-compiled cx fi)
          (.retty (ial-at [BFunc] (field cx bfuncs) fi)))
        (let [ei (find-extern cx func)
              ; A C symbol this program defines with export-c is bound to that
              ; definition, not to the native library's function of the same name.
              interposer
                (if (>= ei 0)
                    (export-c-interposer (.mp cx)
                                         (extern-link-name (ial-at [Extern]
                                                                   (load (field cx
                                                                                externs))
                                                                   ei)))
                    (None [(slice u8)]))]
          (if (match interposer (Some [_] true) (None [] false))
              (compile-call fb
                            (match interposer (Some [f] f) (None [] ""))
                            args)
              (if (>= ei 0)
                  (let [ep (ial-at [Extern] (load (field cx externs)) ei)
                        addr (if (nc-available?) (interp-native-target cx ep) 0)]
                    (if (!= addr 0)
                        (compile-native-call fb
                                             addr
                                             args
                                             (if (.variadic ep)
                                                 (len (load (.params ep)))
                                                 (len (load args)))
                                             ep)
                        (compile-table-call fb ei args)))
                  (do (idie2 "call to unknown function: " func) (TInt 64 true))))))))

;;; Threads an interpreted program creates run interpreted code, whose native
;;; frames are far larger than the compiled program's would be; they get at
;;; least the stack the compiler gives its own deep pipeline (worker-stack-size).
(defn interp-thread-stack-size [] (-> i64)
  268435456)

(extern interp.pthread_create
        :as
        "pthread_create"
        :cc
        (cc/C)
        [(ptr i8) (ptr i8) (fnptr (cc/C) [(ptr i8)] (ptr i8)) (ptr i8)]
        (-> i32))

(extern interp.pthread_attr_init
        :as
        "pthread_attr_init"
        :cc
        (cc/C)
        [(ptr i8)]
        (-> i32))

(extern interp.pthread_attr_destroy
        :as
        "pthread_attr_destroy"
        :cc
        (cc/C)
        [(ptr i8)]
        (-> i32))

(extern interp.pthread_attr_setstacksize
        :as
        "pthread_attr_setstacksize"
        :cc
        (cc/C)
        [(ptr i8) i64]
        (-> i32))

(extern interp.pthread_attr_getstacksize
        :as
        "pthread_attr_getstacksize"
        :cc
        (cc/C)
        [(ptr i8) (ptr i64)]
        (-> i32))

;;; What an interpreted program's pthread_create calls: the real one, with the
;;; requested stack raised to interp-thread-stack-size when it is smaller. A
;;; caller's attributes are restored afterwards (pthread_create copies them).
(defn interp-pthread-create [(thread (ptr i8))
                             (attr (ptr i8))
                             (start (fnptr (cc/C) [(ptr i8)] (ptr i8)))
                             (arg (ptr i8))] (-> i32)
  (let [want (interp-thread-stack-size)]
    (if (= (primitive/cast i64 attr) 0)
        ; pthread_attr_t is 64 bytes on Darwin and 56 on glibc, 8-aligned
        (let [(mut own) (zeroed (array i64 16))
              ap (primitive/cast (ptr i8) (mut own))
              init (interp.pthread_attr_init ap)]
          (if (!= init (: 0 i32))
              init
              (let [_ (interp.pthread_attr_setstacksize ap want)
                    r (interp.pthread_create thread ap start arg)]
                (interp.pthread_attr_destroy ap)
                r)))
        (let [(mut have) 0]
          (interp.pthread_attr_getstacksize attr (mut have))
          (if (>= have want)
              (interp.pthread_create thread attr start arg)
              (let [_ (interp.pthread_attr_setstacksize attr want)
                    r (interp.pthread_create thread attr start arg)]
                (interp.pthread_attr_setstacksize attr have)
                r))))))

;;; The native address an extern call goes to: the C symbol, except that
;;; pthread_create goes through interp-pthread-create, and `atexit` and
;;; `__cxa_atexit` register with the JIT's exit handlers, which run before the
;;; callback thunk a handler points to is unmapped. 0 when this process has no
;;; such symbol, and for a symbol the extern hook owns: that call goes to the
;;; hook even when another loaded image exports the same name.
(defn interp-native-target [(cx (ptr Interp)) (ep (ptr Extern))] (-> i64)
  (let [name (extern-link-name ep)
        exit-registration (primitive/cast i64 (jit-exit-registration name))]
    (cond (interp-hook-owns? name) 0
          (= name "pthread_create")
            (primitive/cast i64
                            (primitive/cast (ptr i8)
                                            (fnptr-of interp-pthread-create)))
          (!= exit-registration 0) exit-registration
          :else (nc-symbol (.a cx) name))))

;;; The native address of extern `ep` (for fnptr-of). Without native calls there
;;; is no address to take.
(defn interp-extern-address [(cx (ptr Interp)) (ep (ptr Extern))] (-> i64)
  (unless (nc-available?)
    (idie2 "fnptr-of an extern needs native calls, which this host lacks: "
           (.name ep)))
  (when (interp-hook-owns? (extern-link-name ep))
    (idie2 "fnptr-of: a host callback has no address in this process: "
           (extern-link-name ep)))
  (let [addr (interp-native-target cx ep)]
    (when (= addr 0)
      (idie2 "fnptr-of: no C symbol in this process: " (extern-link-name ep)))
    addr))

;;; An extern with a native address: the arguments' types (the declared ones for
;;; named parameters, the expressions' own for variadic ones) plan the C call.
(defn compile-native-call [(fb (ptr FB))
                           (addr i64)
                           (args (ptr (ArrayList Expr)))
                           (nfixed i64)
                           (ep (ptr Extern))] (-> Type)
  (let [cx (load (field fb cx))
        (mut types) (ArrayList::new [Type] (.a cx))]
    (for [i 0 (len (load args))]
      (let [t (compile-expr fb (ial-at [Expr] args i))]
        (push! (mut types)
               (if (< i nfixed) (load (ial-at [Type] (.params ep) i)) t))))
    (let [ret (box-type (.a cx) (.ret ep))
          site (ffi-register-call! cx addr (mut types) nfixed ret)]
      (femit fb 47 site (len (load args)) 0)  ; CALLNATIVE
      (.ret ep))))

;;; An extern the process has no symbol for: the built-in table (and the
;;; metaprogram host hook) in extern-call.
(defn compile-table-call [(fb (ptr FB)) (ei i64) (args (ptr (ArrayList Expr)))]
  (-> Type)
  (let [cx (load (field fb cx))]
    (do
      (compile-args fb args)
      (femit fb 14 ei (len (load args)) 0)
      (let [rt (.ret (ial-at [Extern] (load (field cx externs)) ei))
            (mut rtp) rt]
        ; a by-value aggregate C return (<=8 bytes, e.g. div's div_t in
        ; x0) comes back as a packed word; box it into a frame slot so it
        ; behaves as an aggregate value (an address) like any other.
        (when (ty-is-agg (mut rtp))
          (femit fb 43 (isize-of cx (mut rtp)) (ialign-of cx (mut rtp)) 0))
        rt))))

; compile a sequence, POPping all but the last; returns the last expr's type
; (the sequence's value). Used for do / let body / function body.
(defn compile-seq [(fb (ptr FB)) (body (ptr (ArrayList Expr)))] (-> Type)
  (let [n (len (load body))
        (mut i) 0
        ; An EMPTY sequence has type VOID (check.coil's synth-let-body agrees; the
        ; checker rejects an empty body against any non-void return type). This used
        ; to default to i64, the same wrong assumption the checker carried.
        (mut last) (TVoid)]
    ; The push STAYS: `RET` below always pops the body's value, so every body must
    ; leave exactly one stack slot. Only the TYPE was wrong, not the stack discipline.
    (when (= n 0) (femit fb 1 0 0 0) 0)  ; empty body -> push 0
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (.term fb) (break))
                (set! last (compile-expr fb (ial-at [Expr] body (load i))))
                (when (and (< (load i) (primitive/isub n 1))
                           (not (.term fb)))
                  (femit fb 4 0 0 0))  ; POP intermediate result
                (set! i (primitive/iadd (load i) 1)))))
    (load last)))

; compile a statement sequence, POPping EVERY produced value (used for loop bodies).
(defn compile-stmts [(fb (ptr FB)) (body (ptr (ArrayList Expr)))] (-> i64)
  (let [n (len (load body))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (.term fb) (break))
                (compile-expr fb (ial-at [Expr] body (load i)))
                (unless (.term fb) (femit fb 4 0 0 0))  ; POP
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn compile-binds [(fb (ptr FB)) (binds (ptr (ArrayList Bind)))] (-> i64)
  (let [n (len (load binds))
        (mut i) 0
        cx (load (field fb cx))
        a (.a cx)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [b (ial-at [Bind] binds (load i))
                      t (compile-expr fb (field b value))]
                  (if (.mutable b)
                      ; mutable: spill to a frame cell, bind name -> pointer to it
                      (let [(mut tp) t
                            l (fb-local! fb)]
                        (femit fb
                               21
                               l
                               (isize-of cx (mut tp))
                               (when (ty-is-agg (mut tp)) 1))
                        ; MUTCELL
                        (set! (.env fb)
                              (cs-cons a
                                       (.name b)
                                       l
                                       (TPtr (box-type a t))
                                       (load (field fb
                                                    env)))))
                      ; immutable: bind name -> a plain local holding the value
                      (let [l (fb-local! fb)]
                        (femit fb 3 l 0 0)  ; SETLOCAL
                        (set! (.env fb)
                              (cs-cons a (.name b) l t (load (field fb env)))))))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; compile ONE expression; emit its bytecode (leaving exactly one value on the
; operand stack unless the path terminated) and RETURN its static type. This is
; the interpreter analogue of codegen_a64's emit-expr returning an AVal.
(defn compile-expr [(fb (ptr FB)) (e (ptr Expr))] (-> Type)
  (let [cx (load (field fb cx))
        a (.a cx)]
    (match (.kind e)
      (EInt [v] (do (femit fb 1 v 0 0) (TInt 64 true)))
      (EFloat [bits] (do (femit fb 1 bits 0 0) (TFloat 64)))
      (EBool [b] (do (femit fb 1 (when b 1) 0 0) (TBool)))
      (EVar [name]
            (let [node (cs-find (load (field fb env)) name)]
              (if (= (primitive/cast i64 node) 0)
                  (do (idie2 "unbound variable: " name) (TInt 64 true))
                  (do
                    (femit fb 2 (.slot node) 0 0)
                    (.ty node)))))
      (ELet [binds body]
            (let [sv (load (field fb env))]
              (compile-binds fb binds)
              (let [bt (compile-seq fb body)] (set! (.env fb) sv) bt)))
      (EDo [body] (compile-seq fb body))
      (EDefer [_ _]
              (do
                (idie "a (defer …) region reached the backend before ownership elaboration lowered it")
                (TVoid)))
      (ECleanup [body cleanups]
                ; Preserve the body's value while the cleanup calls consume their
                ; own operand-stack results. Aggregate interpreter values are
                ; addresses, so a plain local preserves the same representation.
                (let [bt (compile-expr fb body)]
                  (if (.term fb)
                      bt
                      (let [result (fb-local! fb)]
                        (femit fb 3 result 0 0)  ; SETLOCAL result
                        (compile-stmts fb cleanups)
                        (unless (.term fb) (femit fb 2 result 0 0))  ; GETLOCAL result
                        bt))))
      (EBin [op lhs rhs]
            (let [(mut tp) (: (compile-expr fb lhs) Type)]
              (compile-expr fb rhs)
              (femit fb 8 op (tmode (mut tp)) (tsignbits (mut tp)))
              tp))
      (ECmp [op lhs rhs]
            (let [(mut tp) (: (compile-expr fb lhs) Type)]
              (compile-expr fb rhs)
              (femit fb 9 op (tmode (mut tp)) (tsigned (mut tp)))
              (TBool)))
      (EIntUnary [op inner]
                 (let [t (compile-expr fb inner)]
