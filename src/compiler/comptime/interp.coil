                                                      (mut tp))]
                                (match tp
                                  (TVec [elem lanes]
                                        (let [lb (isize-of cx elem)
                                              bits (ir-int-bits elem)
                                              dslot
                                                (frame-alloc fm
                                                             (primitive/imul (extent-value lanes)
                                                                             lb)
                                                             (ialign-of cx elem))]
                                          (for [k 0 (extent-value lanes)]
                                            (let [le
                                                    (mem-load (primitive/iadd lv
                                                                              (primitive/imul k
                                                                                              lb))
                                                              lb
                                                              false)
                                                  re
                                                    (mem-load (primitive/iadd rv
                                                                              (primitive/imul k
                                                                                              lb))
                                                              lb
                                                              false)]
                                              (mem-store (primitive/iadd dslot
                                                                         (primitive/imul k
                                                                                         lb))
                                                         (do-bin binop
                                                                 0
                                                                 (| (<< bits
                                                                        1)
                                                                    1)
                                                                 le
                                                                 re)
                                                         lb)))
                                          (ir-env-put! names vals t0 dslot)
                                          0))
                                  (_ (do
                                       (ir-env-put! names
                                                    vals
                                                    t0
                                                    (do-bin binop
                                                            0
                                                            (| (<< (ir-int-bits (mut tp))
                                                                   1)
                                                               1)
                                                            lv
                                                            rv))
                                       0)))))
                          (or (= op "sdiv")
                              (= op "udiv")
                              (= op "srem")
                              (= op "urem"))
                            ; %r = OP TY V0, V1 (scalar only)
                            (let [(mut tokp) 3
                                  (mut tp)
                                    (: (ir-parse-type2 irctx toks (mut tokp))
                                       Type)
                                  binop
                                    (cond (= op "sdiv") 3
                                          (= op "srem") 4
                                          (= op "udiv") 5
                                          :else 6)]
                              (match tp
                                (TVec [_ _]
                                      (do
                                        (idie2 "llvm-ir: vector int div/rem not supported: "
                                               op)
                                        0))
                                (_ (let [lv
                                           (ir-value2-adv! irctx
                                                           toks
                                                           (mut tokp)
                                                           (mut tp))
                                         rv
                                           (ir-value2-adv! irctx
                                                           toks
                                                           (mut tokp)
                                                           (mut tp))]
                                     (ir-env-put! names
                                                  vals
                                                  t0
                                                  (do-bin binop
                                                          0
                                                          (| (<< (ir-int-bits (mut tp))
                                                                 1)
                                                             1)
                                                          lv
                                                          rv))
                                     0))))
                          (= op "getelementptr")  ; %r = getelementptr ELEMTY, ptr BASE, IDXTY IDX
                            (let [(mut tokp) 3
                                  (mut etp)
                                    (: (ir-parse-type2 irctx toks (mut tokp))
                                       Type)]
                              (set! tokp (primitive/iadd tokp 1))
                              ; skip "ptr"
                              (let [(mut ptp)
                                      (: (TPtr (box-type a (TInt 8 true))) Type)]
                                (let [base
                                        (ir-value2-adv! irctx
                                                        toks
                                                        (mut tokp)
                                                        (mut ptp))
                                      esz (isize-of cx (mut etp))
                                      (mut itp)
                                        (: (ir-parse-type2 irctx
                                                           toks
                                                           (mut tokp))
                                           Type)]
                                  (match itp
                                    (TVec [ielem lanes]
                                          (let [ilb (isize-of cx ielem)
                                                idxaddr
                                                  (ir-value2-adv! irctx
                                                                  toks
                                                                  (mut tokp)
                                                                  (mut itp))
                                                dslot
                                                  (frame-alloc fm
                                                               (primitive/imul (extent-value lanes)
                                                                               8)
                                                               8)]
                                            (for [k 0 (extent-value lanes)]
                                              (let [iv
                                                      (mem-load (primitive/iadd idxaddr
                                                                                (primitive/imul k
                                                                                                ilb))
                                                                ilb
                                                                (signed-of ielem))]
                                                (mem-store (primitive/iadd dslot
                                                                           (primitive/imul k
                                                                                           8))
                                                           (primitive/iadd base
                                                                           (primitive/imul iv
                                                                                           esz))
                                                           8)))
                                            (ir-env-put! names vals t0 dslot)
                                            0))
                                    (_ (let [idx
                                               (ir-value2-adv! irctx
                                                               toks
                                                               (mut tokp)
                                                               (mut itp))]
                                         (ir-env-put! names
                                                      vals
                                                      t0
                                                      (primitive/iadd base
                                                                      (primitive/imul idx
                                                                                      esz)))
                                         0))))))
                          (= op "call") (ir-call! irctx toks t0 line)
                          :else (do (idie2 "llvm-ir: unsupported op: " op) 0)))
                :else (do (idie2 "llvm-ir: unsupported line: " line) 0)))))))

; intrinsic calls: @llvm.fma.v4f32 and @llvm.vector.reduce.fadd.v4f32
; IEEE minimum/maximum: NaN propagates (x+y is that quiet NaN); for equal
; operands the bit patterns are OR'd (minimum: -0 wins) or AND'd (maximum: +0).
(defn interp-minmax64 [(maximum bool) (x f64) (y f64)] (-> f64)
  (cond (or (not (= x x)) (not (= y y))) (+ x y)
        (< x y) (if maximum y x)
        (> x y) (if maximum x y)
        maximum (bits->f64 (& (f64-bits x) (f64-bits y)))
        :else (bits->f64 (| (f64-bits x) (f64-bits y)))))

(defn interp-minmax32 [(maximum bool) (x f32) (y f32)] (-> f32)
  (cond (or (not (= x x)) (not (= y y))) (+ x y)
        (< x y) (if maximum y x)
        (> x y) (if maximum x y)
        maximum (bits->f32 (& (f32->bits x) (f32->bits y)))
        :else (bits->f32 (| (f32->bits x) (f32->bits y)))))

(defn interp-float-math64 [(op FloatMathOp) (x f64) (y f64) (z f64)] (-> f64)
  (match op
    (FloatSqrt [] (interp.sqrt x))
    (FloatAbs [] (interp.fabs x))
    (FloatFloor [] (interp.floor x))
    (FloatCeil [] (interp.ceil x))
    (FloatTrunc [] (interp.trunc x))
    (FloatRound [] (interp.round x))
    (FloatRoundEven [] (interp.nearbyint x))
    (FloatFma [] (interp.fma x y z))
    (FloatMinimum [] (interp-minmax64 false x y))
    (FloatMaximum [] (interp-minmax64 true x y))
    (FloatCopysign [] (interp.copysign x y))
    (FloatSin [] (interp.sin x))
    (FloatCos [] (interp.cos x))
    (FloatTan [] (interp.tan x))
    (FloatAsin [] (interp.asin x))
    (FloatAcos [] (interp.acos x))
    (FloatAtan [] (interp.atan x))
    (FloatAtan2 [] (interp.atan2 x y))
    (FloatSinh [] (interp.sinh x))
    (FloatCosh [] (interp.cosh x))
    (FloatTanh [] (interp.tanh x))
    (FloatExp [] (interp.exp x))
    (FloatExp2 [] (interp.exp2 x))
    (FloatLog [] (interp.log x))
    (FloatLog2 [] (interp.log2 x))
    (FloatLog10 [] (interp.log10 x))
    (FloatPow [] (interp.pow x y))))

(defn interp-float-math32 [(op FloatMathOp) (x f32) (y f32) (z f32)] (-> f32)
  (do
    (match op
      (FloatSqrt [] (interp.sqrtf x))
      (FloatAbs [] (cast f32 (interp.fabs (cast f64 x))))
      (FloatFloor [] (interp.floorf x))
      (FloatCeil [] (interp.ceilf x))
      (FloatTrunc [] (interp.truncf x))
      (FloatRound [] (cast f32 (interp.round (cast f64 x))))
      (FloatRoundEven [] (cast f32 (interp.nearbyint (cast f64 x))))
      (FloatFma [] (interp.fmaf x y z))
      (FloatMinimum [] (interp-minmax32 false x y))
      (FloatMaximum [] (interp-minmax32 true x y))
      (FloatCopysign [] (cast f32 (interp.copysign (cast f64 x) (cast f64 y))))
      (FloatSin [] (interp.sinf x))
      (FloatCos [] (interp.cosf x))
      (FloatTan [] (interp.tanf x))
      (FloatAsin [] (interp.asinf x))
      (FloatAcos [] (interp.acosf x))
      (FloatAtan [] (interp.atanf x))
      (FloatAtan2 [] (interp.atan2f x y))
      (FloatSinh [] (interp.sinhf x))
      (FloatCosh [] (interp.coshf x))
      (FloatTanh [] (interp.tanhf x))
      (FloatExp [] (interp.expf x))
      (FloatExp2 [] (interp.exp2f x))
      (FloatLog [] (interp.logf x))
      (FloatLog2 [] (interp.log2f x))
      (FloatLog10 [] (interp.log10f x))
      (FloatPow [] (interp.powf x y)))))

; A scalar float math intrinsic (src/compiler/backend/float_math.coil), `tokp` at the
; callee. Scalar float SSA values are their bit patterns.
(defn ir-float-math! [(irctx (ref IrContext))
                      (toks (ptr (ArrayList (slice u8))))
                      (tokp (ptr i64))
                      (t0 (slice u8))
                      (fi FloatIntrinsic)] (-> i64)
  (let [names (.names irctx)
        vals (.vals irctx)]
    (let [(mut operands) (zeroed (array i64 3))
          (mut at) (zeroed Type)]
      (for [i 0 3]
        (set! (index (primitive/cast (ptr i64) (mut operands)) i) 0))
      (set! tokp (primitive/iadd (load tokp) 2))
      ; skip callee, "("
      (for [i 0 (.arity fi)]
        (set! at (ir-parse-type2 irctx toks tokp))
        (set! (index (primitive/cast (ptr i64) (mut operands)) i)
              (ir-value2-adv! irctx toks tokp (mut at))))
      (let [x (load (index (primitive/cast (ptr i64) (mut operands)) 0))
            y (load (index (primitive/cast (ptr i64) (mut operands)) 1))
            z (load (index (primitive/cast (ptr i64) (mut operands)) 2))
            r
              (if (= (.bits fi) 32)
                  (f32->bits (interp-float-math32 (.op fi)
                                                  (bits->f32 x)
                                                  (bits->f32 y)
                                                  (bits->f32 z)))
                  (f64-bits (interp-float-math64 (.op fi)
                                                 (bits->f64 x)
                                                 (bits->f64 y)
                                                 (bits->f64 z))))]
        (ir-env-put! names vals t0 r)
        0))))

(defn ir-call! [(irctx (ref IrContext))
                (toks (ptr (ArrayList (slice u8))))
                (t0 (slice u8))
                (line (slice u8))] (-> i64)
  (let [cx (.cx irctx)
        a (.a irctx)
        names (.names irctx)
        vals (.vals irctx)
        result (.result irctx)
        fm (.fm irctx)]
    (let [(mut tokp) 3
          (mut rtp) (: (ir-parse-type2 irctx toks (mut tokp)) Type)]
      (let [callee (irtok toks tokp)]
        (match (float-intrinsic callee)
          (Some [fi]
                (ir-float-math! irctx toks (mut tokp) t0 fi))
          (None []
                (if (= callee "@llvm.fma.v4f32")
                    (let [(mut t1) (zeroed Type)
                          (mut t2) (zeroed Type)
                          (mut t3) (zeroed Type)]
                      (set! tokp (primitive/iadd tokp 2))
                      (set! t1
                            ; skip name + "("
                            (ir-parse-type2 irctx toks (mut tokp)))
                      (let [av (ir-value2 irctx (irtok toks tokp) (mut t1))]
                        (set! tokp (primitive/iadd tokp 1))
                        (set! t2
                              (ir-parse-type2 irctx toks (mut tokp)))
                        (let [bv (ir-value2 irctx (irtok toks tokp) (mut t2))]
                          (set! tokp (primitive/iadd tokp 1))
                          (set! t3
                                (ir-parse-type2 irctx toks (mut tokp)))
                          (let [cv (ir-value2 irctx (irtok toks tokp) (mut t3))]
                            (match result
                              (TVec [elem lanes]
                                    (let [lb (isize-of cx elem)
                                          dslot
                                            (frame-alloc fm
                                                         (isize-of cx
                                                                   (box-type a
                                                                             result))
                                                         (ialign-of cx
                                                                    (box-type a
                                                                              result)))]
                                      (for [k 0 (extent-value lanes)]
                                        (let [ai
                                                (mem-load (primitive/iadd av
                                                                          (primitive/imul k
                                                                                          lb))
                                                          lb
                                                          false)
                                              bi
                                                (mem-load (primitive/iadd bv
                                                                          (primitive/imul k
                                                                                          lb))
                                                          lb
                                                          false)
                                              ci
                                                (mem-load (primitive/iadd cv
                                                                          (primitive/imul k
                                                                                          lb))
                                                          lb
                                                          false)
                                              rv
                                                (if (= lb
                                                       4)
                                                    (f32->bits (interp.fmaf (bits->f32 ai)
                                                                            (bits->f32 bi)
                                                                            (bits->f32 ci)))
                                                    (f64-bits (interp.fma (bits->f64 ai)
                                                                          (bits->f64 bi)
                                                                          (bits->f64 ci))))]
                                          (mem-store (primitive/iadd dslot
                                                                     (primitive/imul k
                                                                                     lb))
                                                     rv
                                                     lb)))
                                      (ir-env-put! names vals t0 dslot)
                                      0))
                              (_ (do (idie "llvm-ir: fma on non-vector") 0)))))))
                    (if (= callee "@llvm.vector.reduce.fadd.v4f32")
                        (let [(mut vtp) (zeroed Type)]
                          (set! tokp (primitive/iadd tokp 2))
                          ; skip name + "("
                          (ir-parse-type2 irctx toks (mut tokp))
                          ; float
                          (unless (= (irtok toks tokp) "0.0")
                            (idie2 "llvm-ir: reduce.fadd start must be 0.0: "
                                   line))
                          (set! tokp (primitive/iadd tokp 1))
                          (set! vtp
                                (ir-parse-type2 irctx toks (mut tokp)))
                          (let [v (ir-value2 irctx (irtok toks tokp) (mut vtp))]
                            (match vtp
                              (TVec [elem lanes]
                                    (let [lb (isize-of cx elem)
                                          (mut acc)
                                            (if (= lb 4)
                                                (f32->bits (primitive/cast f32
                                                                           0))
                                                (f64-bits (primitive/cast f64 0)))]
                                      (for [k 0 (extent-value lanes)]
                                        (let [li
                                                (mem-load (primitive/iadd v
                                                                          (primitive/imul k
                                                                                          lb))
                                                          lb
                                                          false)]
                                          (set! acc
                                                (if (= lb
                                                       4)
                                                    (f32->bits (+ (bits->f32 (load acc))
                                                                  (bits->f32 li)))
                                                    (f64-bits (+ (bits->f64 (load acc))
                                                                 (bits->f64 li)))))))
                                      (ir-env-put! names vals t0 (load acc))
                                      0))
                              (_ (do (idie "llvm-ir: reduce on non-vector") 0)))))
                        (if (= callee "@llvm.sqrt.v4f32")
                            ; ( $ret $0 ) -> per-lane sqrt (via f64 — sqrt's "double
                            ; rounding is safe" property makes this bit-exact for f32
                            ; too, since f64 has far more precision).
                            (let [(mut at) (zeroed Type)]
                              (set! tokp (primitive/iadd tokp 2))
                              (set! at
                                    ; skip name, "("
                                    (ir-parse-type2 irctx toks (mut tokp)))
                              (let [av
                                      (ir-value2-adv! irctx
                                                      toks
                                                      (mut tokp)
                                                      (mut at))]
                                (match rtp
                                  (TVec [elem lanes]
                                        (let [lb (isize-of cx elem)
                                              dslot
                                                (frame-alloc fm
                                                             (isize-of cx
                                                                       (mut rtp))
                                                             (ialign-of cx
                                                                        (mut rtp)))]
                                          (for [k 0 (extent-value lanes)]
                                            (let [li
                                                    (mem-load (primitive/iadd av
                                                                              (primitive/imul k
                                                                                              lb))
                                                              lb
                                                              false)
                                                  rv
                                                    (if (= lb
                                                           4)
                                                        (f32->bits (primitive/cast f32
                                                                                   (interp.sqrt (primitive/cast f64
                                                                                                                (bits->f32 li)))))
                                                        (f64-bits (interp.sqrt (bits->f64 li))))]
                                              (mem-store (primitive/iadd dslot
                                                                         (primitive/imul k
                                                                                         lb))
                                                         rv
                                                         lb)))
                                          (ir-env-put! names vals t0 dslot)
                                          0))
                                  (_ (do (idie "llvm-ir: sqrt on non-vector") 0)))))
                            (if (= callee "@llvm.masked.gather.v4i8.v4p0")
                                ; ( <N x ptr> PTRS, i32 ALIGN, <N x i1> MASK, <N x T> PASSTHRU )
                                (let [(mut ptrsty) (zeroed Type)]
                                  (set! tokp (primitive/iadd tokp 2))
                                  (set! ptrsty
                                        ; skip name, "("
                                        (ir-parse-type2 irctx toks (mut tokp)))
                                  (let [ptrsaddr
                                          (ir-value2-adv! irctx
                                                          toks
                                                          (mut tokp)
                                                          (mut ptrsty))]
                                    (ir-parse-type2 irctx toks (mut tokp))
                                    (set! tokp
                                          ; i32 (immarg align)
                                          (primitive/iadd tokp
                                                          1))
                                    ; skip its literal
                                    (let [(mut maskty)
                                            (: (ir-parse-type2 irctx
                                                               toks
                                                               (mut tokp))
                                               Type)]
                                      (let [maskaddr
                                              (ir-value2-adv! irctx
                                                              toks
                                                              (mut tokp)
                                                              (mut maskty))
                                            (mut passty)
                                              (: (ir-parse-type2 irctx
                                                                 toks
                                                                 (mut tokp))
                                                 Type)]
                                        (let [passaddr
                                                (ir-value2-adv! irctx
                                                                toks
                                                                (mut tokp)
                                                                (mut passty))]
                                          (match rtp
                                            (TVec [relem lanes]
                                                  (let [relb (isize-of cx relem)
                                                        dslot
                                                          (frame-alloc fm
                                                                       (isize-of cx
                                                                                 (mut rtp))
                                                                       (ialign-of cx
                                                                                  (mut rtp)))]
                                                    (for [k
                                                          0
                                                          (extent-value lanes)]
                                                      (let [m
                                                              (mem-load (primitive/iadd maskaddr
                                                                                        k)
                                                                        1
                                                                        false)]
                                                        (if (!= m
                                                                0)
                                                            (let [p
                                                                    (mem-load (primitive/iadd ptrsaddr
                                                                                              (primitive/imul k
                                                                                                              8))
                                                                              8
                                                                              false)]
                                                              (mem-store (primitive/iadd dslot
                                                                                         (primitive/imul k
                                                                                                         relb))
                                                                         (mem-load p
                                                                                   relb
                                                                                   false)
                                                                         relb))
                                                            (mem-store (primitive/iadd dslot
                                                                                       (primitive/imul k
                                                                                                       relb))
                                                                       (mem-load (primitive/iadd passaddr
                                                                                                 (primitive/imul k
                                                                                                                 relb))
                                                                                 relb
                                                                                 false)
                                                                       relb))))
                                                    (ir-env-put! names
                                                                 vals
                                                                 t0
                                                                 dslot)
                                                    0))
                                            (_ (do
                                                 (idie "llvm-ir: masked.gather on non-vector result")
                                                 0))))))))
                                (do
                                  (idie2 "llvm-ir: unsupported intrinsic: "
                                         callee)
                                  0)))))))))))

; Volatile accesses must preserve the hardware access width. The ordinary VM
; memory helpers deliberately access bytes to support packed structs, so they
; cannot implement a volatile register access.
(defn volatile-read-cell [(addr i64) (size i64) (signed bool)] (-> i64)
  (let [value
          (cond (= size 1)
                  (primitive/cast i64
                                  (primitive/volatile-load u8
                                                           (primitive/cast (ptr u8)
                                                                           addr)))
                (= size 2)
                  (primitive/cast i64
                                  (primitive/volatile-load u16
                                                           (primitive/cast (ptr u16)
                                                                           addr)))
                (= size 4)
                  (primitive/cast i64
                                  (primitive/volatile-load u32
                                                           (primitive/cast (ptr u32)
                                                                           addr)))
                (= size 8)
                  (primitive/cast i64
                                  (primitive/volatile-load u64
                                                           (primitive/cast (ptr u64)
                                                                           addr)))
                :else (do (idie "volatile-load: unsupported scalar size") 0))]
    (canon-int value (* size 8) signed)))

(defn volatile-write-cell [(addr i64) (value i64) (size i64)] (-> i64)
  (cond (= size 1)
          (primitive/volatile-store! (primitive/cast (ptr u8) addr)
                                     (primitive/cast u8 value))
        (= size 2)
          (primitive/volatile-store! (primitive/cast (ptr u16) addr)
                                     (primitive/cast u16 value))
        (= size 4)
          (primitive/volatile-store! (primitive/cast (ptr u32) addr)
                                     (primitive/cast u32 value))
        (= size 8)
          (primitive/volatile-store! (primitive/cast (ptr u64) addr)
                                     (primitive/cast u64 value))
        :else (do (idie "volatile-store!: unsupported scalar size") 0)))

; run a whole IR body; returns the result cell.
;;; Run an intrinsic the interpreter carries out itself. Alias accesses are
;;; plain ones here: the interpreter reorders no memory access.
(defn ir-run-intrinsic [(cx (ptr Interp))
                        (irp (ptr IIr))
                        (op Intrinsic)
                        (args (ptr i64))] (-> i64)
  (match op
    (IVolatileLoad [] (ir-read-scalar cx irp args "volatile-load"))
    (IAliasLoad [] (ir-read-scalar cx irp args "alias-load"))
    (IVolatileStore [] (ir-write-scalar cx irp args "volatile-store!"))
    (IAliasStore [] (ir-write-scalar cx irp args "alias-store!"))
    ; the interpreter runs on one thread
    (IFence [] 0)
    (ILinkerAddress [symbol]
                    (do
                      (idie2 "the bytecode interpreter reaches a linker symbol only by calling it, and this program takes the address of "
                             symbol)
                      0))
    (IStackBytes []
                 (do
                   (idie "alloc-stack-bytes is compiled to ALLOCDYN, never run as IR (interpreter bug)")
                   0))
    (_ (do
         (idie "the bytecode interpreter runs no machine code, and this program calls a machine-code function")
         0))))

(defn ir-read-scalar [(cx (ptr Interp))
                      (irp (ptr IIr))
                      (args (ptr i64))
                      (what (slice u8))] (-> i64)
  (let [(mut type) (.result irp)]
    (when (ty-is-agg (mut type))
      (idie2 what ": expected a scalar"))
    (volatile-read-cell (load args)
                        (isize-of cx (mut type))
                        (signed-of (mut type)))))

(defn ir-write-scalar [(cx (ptr Interp))
                       (irp (ptr IIr))
                       (args (ptr i64))
                       (what (slice u8))] (-> i64)
  (let [(mut type) (get (.argtys irp) 1)]
    (when (ty-is-agg (mut type))
      (idie2 what ": expected a scalar"))
    (volatile-write-cell (load args)
                         (load (index args 1))
                         (isize-of cx (mut type)))))

(defn ir-run [(cx (ptr Interp))
              (irp (ptr IIr))
              (args (ptr i64))
              (fm (ptr FrameMem))] (-> i64)
  (match (.intrinsic irp)
    (Some [op] (ir-run-intrinsic cx irp op args))
    (None []
          ; Everything the run allocates (its name table, parsed types, token lists) is
          ; scratch that dies with it; a per-run arena keeps runs from growing the
          ; interpreter's allocator and from sharing it across threads.
          (let [(mut arena) (zeroed ScratchArena)
                _ (ScratchArena::init (mut arena) (malloc-allocator))
                a (allocator (mut arena))
                names (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                vals (box-al [i64] a (ArrayList::new [i64] a))
                argtys (field irp argtys)
                result (.result irp)
                irctx
                  (IrContext
                    :cx cx
                    :a a
                    :names names
                    :vals vals
                    :args args
                    :argtys argtys
                    :result result
                    :fm fm)
                body (.body irp)
                blen (len body)
                (mut pos) 0
                (mut retvalp) 0
                (mut donep) (: false bool)]
            (loop (if (>= (load pos) blen)
                      (break)
                      (do
                        (let [(mut eol) (load pos)]
                          (loop (if (or (>= (load eol) blen)
                                        (= (primitive/cast i64
                                                           (get body (load eol)))
                                           10))
                                    (break)
                                    (set! eol (primitive/iadd (load eol) 1))))
                          (let [line (subslice body (load pos) (load eol))]
                            (set! pos (primitive/iadd (load eol) 1))
                            (unless (= (len line) 0)
                              (if donep
                                  (idie2 "llvm-ir: code after ret: " line)
                                  (ir-line! irctx
                                            (mut retvalp)
                                            (mut donep)
                                            line)))))
                        0)))
            (unless donep (idie "llvm-ir: body did not ret"))
            (close! (mut arena))
            retvalp))))

; ============================ the VM ========================================
; A call's operand stack, grown by doubling when an expression nests deeper
; than it has room for.
(defstruct VStack [(buf (ptr i64)) (cap i64)])

(defn vpush [(ops (ptr VStack)) (spc (ptr i64)) (v i64)] (-> i64)
  (when (>= (load spc) (.cap ops))
    (let [cap (* (.cap ops) 2)
          grown
            (interp.realloc (primitive/cast (ptr i8) (.buf ops))
                            (primitive/cast isize (* cap 8)))]
      (when (= (primitive/cast i64 grown) 0)
        (idie "operand stack: realloc failed"))
      (set! (.buf ops) (primitive/cast (ptr i64) grown))
      (set! (.cap ops) cap)))
  (set! (index (.buf ops) (load spc)) v)
  (set! spc (primitive/iadd (load spc) 1))
  0)

;;; Pop the top `n` values at once, returning where they sit, in push order:
;;; a call's arguments, read by the callee before this stack is pushed again.
(defn vpop-n [(ops (ptr VStack)) (spc (ptr i64)) (n i64)] (-> (ptr i64))
  (set! spc (- (load spc) n))
  (index (.buf ops) (load spc)))

(defn vpop [(ops (ptr VStack)) (spc (ptr i64))] (-> i64)
  (let [t (primitive/isub (load spc) 1)]
    (set! spc t)
    (load (index (.buf ops) t))))

; execute compiled function `fidx` with `argc` i64 arguments; return its i64
; result. Recursion uses the host call stack (one vm-exec activation per call),
; except a call in tail position (TAILCALL), which ends its caller's activation
; and runs in this loop instead: a loop written as tail recursion runs in
; constant host stack, as it does compiled.
(defn vm-exec [(cx (ptr Interp))
               (fidx i64)
               (argv (ptr i64))
               (argc i64)
               (retbuf i64)] (-> i64)
  (let [(mut tail) (zeroed VmTail)
        (mut callee) fidx
        (mut args) argv
        (mut nargs) argc
        (mut owned) (primitive/cast (ptr i64) 0)
        (mut result) 0
        (mut running) true]
    (while (= running true)
      (set! (.fidx tail) -1)
      (set! result (vm-run cx callee args nargs retbuf (mut tail)))
      ; the activation copied its arguments into its locals first thing
      (unless (= (primitive/cast i64 owned) 0)
        (interp.free (primitive/cast (ptr i8) owned))
        0)
      (if (>= (.fidx tail) 0)
          (do
            (set! callee (.fidx tail))
            (set! args (.args tail))
            (set! nargs (.argc tail))
            (set! owned (.args tail))
            0)
          (do (set! running false) 0)))
    result))

;;; The call an activation ended with in tail position: the function, and its
;;; arguments in a buffer of their own (the operand stack they were on is freed
;;; with the activation). `fidx` is -1 when it returned instead.
(defstruct VmTail [(fidx i64) (args (ptr i64)) (argc i64)])

; one activation of compiled function `fidx`
(defn vm-run [(cx (ptr Interp))
              (fidx i64)
              (argv (ptr i64))
              (argc i64)
              (retbuf i64)
              (tail (ptr VmTail))] (-> i64)
  (let [bf (ial-at [BFunc] (field cx bfuncs) fidx)
        nl (.nlocals bf)
        nlb (if (<= nl 1) 1 nl)
        locals
          (primitive/cast (ptr i64)
                          (interp.malloc (primitive/cast isize
                                                         (primitive/imul nlb 8))))
        (mut framemem) (frame-new)
        (mut ops)
          (VStack :buf (primitive/cast (ptr i64) (interp.malloc 512)) :cap 64)
        (mut spc) (zeroed i64)
        code (load (field bf code))
        (mut retp) (: (.retty bf) Type)
        (mut pc) 0
        (mut halt) false
        (mut retval) 0]
    (let [retagg (ty-is-agg (mut retp))
          retsz (when (ty-is-agg (mut retp)) (isize-of cx (mut retp)))]
      (set! spc 0)
      (let [(mut i) 0]
        (loop (if (>= (load i) argc)
                  (break)
                  (do
                    (set! (index locals (load i))
                          (load (index argv (load i))))
                    (set! i (primitive/iadd (load i) 1))))))
      (loop  ; interp-aborting? is false (one field load) unless a metaprogram-level (primitive/error …)
        ; requested an abort; when it fires, every vm-exec frame breaks here and unwinds,
        ; freeing its frame memory below — no pthread_exit, no (loop 0) spin.
        (if (or (load halt) (interp-aborting?))
            (break)
            (let [ins (ial-at [Instr] code (load pc))
                  op (.op ins)
                  a (.a ins)
                  b (.b ins)
                  c (.c ins)]
              (set! pc (primitive/iadd (load pc) 1))
              (case op
                1 (vpush (mut ops) (mut spc) a)
                2 (vpush (mut ops) (mut spc) (load (index locals a)))
                3 (set! (index locals a) (vpop (mut ops) (mut spc)))
                4 (do (vpop (mut ops) (mut spc)) 0)
                5 (vpush (mut ops) (mut spc) (frame-alloc (mut framemem) a b))
                6
                  (let [addr (vpop (mut ops) (mut spc))]
                    (vpush (mut ops) (mut spc) (mem-load addr a (!= b 0))))
                7
                  (let [v (vpop (mut ops) (mut spc))
                        addr (vpop (mut ops) (mut spc))]
                    (do (mem-store addr v a) (vpush (mut ops) (mut spc) 0)))
                8
                  (let [r (vpop (mut ops) (mut spc))
                        l (vpop (mut ops) (mut spc))]
                    (vpush (mut ops) (mut spc) (do-bin a b c l r)))
                9
                  (let [r (vpop (mut ops) (mut spc))
                        l (vpop (mut ops) (mut spc))]
                    (vpush (mut ops) (mut spc) (do-cmp a b c l r)))
                10
                  (let [v (vpop (mut ops) (mut spc))]
                    (vpush (mut ops)
                           (mut spc)
                           (cond (= a 0) (^ v -1)
                                 (= a 1) (when (= v 0) 1)
                                 :else (do-int-unary a b v))))
                11 (set! pc a)
                12
                  (let [v (vpop (mut ops) (mut spc))]
                    (when (= v 0) (set! pc a)))
                13
                  (if (and (= c 1) (= (.chunk framemem) 0))
                      ; marked by mark-tail-calls!: pointer arguments, and this
                      ; activation holds no frame memory they could address, so it
                      ; ends here as TAILCALL (48) does
                      (let [argbuf (vpop-n (mut ops) (mut spc) b)
                            own
                              (primitive/cast (ptr i64)
                                              (interp.malloc (primitive/cast isize
                                                                             (* (if (< b
                                                                                       1)
                                                                                    1
                                                                                    b)
                                                                                8))))]
                        (for [k 0 b]
                          (set! (index own k)
                                (load (index argbuf k))))
                        (set! (.fidx tail) a)
                        (set! (.args tail) own)
                        (set! (.argc tail) b)
                        (set! halt true)
                        0)
                      (let [argbuf (vpop-n (mut ops) (mut spc) b)]
                        (let [(mut crp)
                                (: (.retty (ial-at [BFunc]
                                                   (field cx bfuncs)
                                                   a))
                                   Type)]
                          (let [rb
                                  (when (ty-is-agg (mut crp))
                                    (frame-alloc (mut framemem)
                                                 (isize-of cx (mut crp))
                                                 16))]
                            (vpush (mut ops)
                                   (mut spc)
                                   (vm-exec cx
                                            a
                                            (primitive/cast (ptr i64) argbuf)
                                            b
                                            rb))))))
                14
                  (let [argbuf (vpop-n (mut ops) (mut spc) b)]
                    (vpush (mut ops)
                           (mut spc)
                           (extern-call cx
                                        a
                                        (primitive/cast (ptr i64) argbuf)
                                        b)))
                15
                  (let [v (vpop (mut ops) (mut spc))]
                    (if retagg
                        (do (memcopy retbuf v retsz) (set! retval retbuf))
                        (set! retval v))
                    (set! halt true)
                    0)
                16
                  (let [v (vpop (mut ops) (mut spc))]
                    (vpush (mut ops) (mut spc) (canon-int v a (!= b 0))))
                17
                  (let [v (vpop (mut ops) (mut spc))]
                    (vpush (mut ops) (mut spc) (i2f v a b)))
                18
                  (let [v (vpop (mut ops) (mut spc))]
                    (vpush (mut ops) (mut spc) (f2i v a b c)))
                19
                  (let [v (vpop (mut ops) (mut spc))]
                    (vpush (mut ops) (mut spc) (f2f v a b)))
                21
                  (let [src (vpop (mut ops) (mut spc))
                        addr
                          (frame-alloc (mut framemem)
                                       b
                                       (if (!= c 0) 16 8))]
                    (do
                      (if (!= c 0)
                          (memcopy addr src b)
                          (mem-store addr src b))
                      (set! (index locals a) addr)))
                22
                  (let [addr (vpop (mut ops) (mut spc))]
                    (do
                      (interp.free (primitive/cast (ptr i8) addr))
                      (vpush (mut ops) (mut spc) 0)))
                23
                  (vpush (mut ops)
                         (mut spc)
                         (primitive/cast i64
                                         (interp.malloc (primitive/cast isize
                                                                        a))))
                24
                  (let [addr
                          (primitive/cast i64
                                          (interp.malloc (primitive/cast isize
                                                                         a)))]
                    (do (memzero addr a) (vpush (mut ops) (mut spc) addr)))
                30
                  (let [addr (frame-alloc (mut framemem) 16 8)]
                    (do
                      (mem-store addr a 8)
                      (mem-store (primitive/iadd addr 8) b 8)
                      (vpush (mut ops) (mut spc) addr)))
                31
                  (let [addr (frame-alloc (mut framemem) a b)]
                    (do (memzero addr a) (vpush (mut ops) (mut spc) addr)))
                32
                  (let [src (vpop (mut ops) (mut spc))
                        dst (frame-alloc (mut framemem) a b)]
                    (do (memcopy dst src a) (vpush (mut ops) (mut spc) dst)))  ; LOADAGG (fresh copy)
                33
                  (let [src (vpop (mut ops) (mut spc))
                        dst (vpop (mut ops) (mut spc))]
                    (do (memcopy dst src a) (vpush (mut ops) (mut spc) 0)))  ; STOREAGG
                34
                  (let [addr (vpop (mut ops) (mut spc))]
                    (vpush (mut ops) (mut spc) (primitive/iadd addr a)))  ; FIELDPTR
                35
                  (let [idx (vpop (mut ops) (mut spc))
                        base (vpop (mut ops) (mut spc))]
                    (vpush (mut ops)
                           (mut spc)
                           (primitive/iadd base (primitive/imul idx a))))  ; INDEX
                36
                  (do
                    (idie "match: no variant matched (non-exhaustive match reached at runtime)")
                    0)  ; TRAP
                37
                  (let [addr (vpop (mut ops) (mut spc))
                        low a
                        width b
                        sg (& c 1)
                        bb (>> c 1)]
                    (let [cont (mem-load addr bb false)
                          v
                            (primitive/cast i64
                                            (>> (primitive/cast u64
                                                                cont)
                                                (primitive/cast u64
                                                                low)))]
                      (vpush (mut ops)
                             (mut spc)
                             (if (< width 64)
                                 (canon-int v
                                            width
                                            (!= sg 0))
                                 v))))  ; BITGET
                38
                  (let [val (vpop (mut ops) (mut spc))
                        addr (vpop (mut ops) (mut spc))
                        low a
                        width b
                        bb c]
                    (let [fieldmask
                            (if (>= width 64)
                                -1
                                (primitive/isub (<< 1 width) 1))
                          cont (mem-load addr bb false)
                          cleared (& cont (^ (<< fieldmask low) -1))
                          merged (| cleared (<< (& val fieldmask) low))]
                      (mem-store addr merged bb)
                      (vpush (mut ops) (mut spc) val)))  ; BITSET
                40
                  (let [argbuf (vpop-n (mut ops) (mut spc) b)]
                    (vpush (mut ops)
                           (mut spc)
                           (ir-run cx
                                   (ial-at [IIr] (field cx irs) a)
                                   (primitive/cast (ptr i64) argbuf)
                                   (mut framemem))))  ; LLVMIR
                43
                  (let [val (vpop (mut ops) (mut spc))
                        slot (frame-alloc (mut framemem) a b)]
                    (when (> a 8)
                      (idie "BOXEXT: a built-in table function returned an aggregate over 8 bytes (none does)"))
                    (memzero slot a)
                    (mem-store slot val a)
                    (vpush (mut ops) (mut spc) slot))  ; box extern agg return
                42
                  (let [argbuf (vpop-n (mut ops) (mut spc) a)]
                    (let [fpv (vpop (mut ops) (mut spc))
                          fi (interp-fnptr-index cx fpv)]
                      (if (< fi 0)
                          ; not an interpreted function: a native one, called
                          ; through call site b's plan
                          (do
                            (when (< b 0)
                              (idie "call-ptr: not a function pointer"))
                            (vpush (mut ops)
                                   (mut spc)
                                   (ffi-run-call cx b fpv argbuf (mut framemem))))
                          (let [(mut crp)
                                  (: (.retty (ial-at [BFunc]
                                                     (field cx bfuncs)
                                                     fi))
                                     Type)]
                            (let [rb
                                    (when (ty-is-agg (mut crp))
                                      (frame-alloc (mut framemem)
                                                   (isize-of cx (mut crp))
                                                   16))]
                              (vpush (mut ops)
                                     (mut spc)
                                     (vm-exec cx
                                              fi
                                              (primitive/cast (ptr i64) argbuf)
                                              a
                                              rb)))))))  ; CALLPTR
                44 (do (set! (index locals a) spc) 0)  ; SAVESP
                45 (do (set! spc (load (index locals a))) 0)  ; RESTORESP
                47
                  ; CALLNATIVE: a = call site, b = argument count
                  (let [argbuf (vpop-n (mut ops) (mut spc) b)]
                    (vpush (mut ops)
                           (mut spc)
                           (ffi-run-call cx
                                         a
                                         (.addr (ial-at [IFfiCall]
                                                        (field (.ffi cx) calls)
                                                        a))
                                         argbuf
                                         (mut framemem))))
                46
                  ; ALLOCDYN: n = pop; push a fresh 16-aligned block of n bytes that
                  ; lives until this call returns (alloc-stack-bytes)
                  (let [n (vpop (mut ops) (mut spc))]
                    (vpush (mut ops)
                           (mut spc)
                           (frame-alloc (mut framemem) (align-up n 16) 16)))
                48
                  ; TAILCALL: a = funcidx, b = argument count. Hand the call to vm-exec,
                  ; which runs it once this activation's storage is released.
                  (let [argbuf (vpop-n (mut ops) (mut spc) b)
                        own
                          (primitive/cast (ptr i64)
                                          (interp.malloc (primitive/cast isize
                                                                         (* (if (< b
                                                                                   1)
                                                                                1
                                                                                b)
                                                                            8))))]
                    (for [k 0 b]
                      (set! (index own k)
                            (load (index argbuf k))))
                    (set! (.fidx tail) a)
                    (set! (.args tail) own)
                    (set! (.argc tail) b)
                    (set! halt true)
                    0)
                (do (idie "VM: bad opcode") 0))))))
    (interp.free (primitive/cast (ptr i8) locals))
    (frame-free! (mut framemem))
    (interp.free (primitive/cast (ptr i8) (.buf ops)))
    (load retval)))

; ============================ top-level entry ================================
; The program's argc/argv (set by the driver's `interp` subcommand before the
; pipeline runs), delivered to a `main` that declares parameters. argv points at
; the real OS char** (so argv[i] are genuine C strings).
(defstruct IArgs [(argc i64) (argv i64)])

(defn iargs-box [] (-> (ptr IArgs))
  (field (interp-unit-state) arguments))

(defn set-interp-args [(argc i64) (argv i64)] (-> i64)
  (let [b (iargs-box)] (set! (.argc b) argc) (set! (.argv b) argv) 0))

; ============================ META execution hooks ==========================
; The metaengine can run a metaprogram (or a comptime fold thunk) by INTERPRETING
; its mono'd sub-program in-process — no dylib/JIT/side-module. Two registered hooks
; make that work without interp.coil depending on the metahost:
;   (1) an EXTERN HOOK: the metaprogram's metashim wrappers call `mh_*` externs
;       (metashim_wasm), which are not libc — dispatch them to the compiler's real
;       mh_* via a registered callback keyed by the extern's C symbol. The hook
;       also says which symbols it owns, and those bind to it ahead of any C
;       symbol: a process can hold a second copy of the compiler (a prebuilt
;       coil.jit unit dlopen'd RTLD_GLOBAL exports its own mh_*), and a metaprogram
;       bound to that copy would run against the copy's state, not this engine's.
;   (2) an ABORT CHECK: a metaprogram-level `(primitive/error …)` cannot pthread_exit (that would
;       kill the whole in-process pipeline) and must not spin on metalower's (loop 0).
;       mh-halt sets a flag; vm-exec polls this hook and unwinds every frame cleanly.
; Both unset ⇒ the interpreter behaves exactly as `coil interp` (gate-interp green).
(defstruct InterpExternHook
  [(isset i64)
   (fp (fnptr (cc/C) [(ptr u8) i64 (ptr i64) i64] i64))
   (owns (fnptr (cc/C) [(ptr u8) i64] i64))])

(defn interp-extern-hook [] (-> (ptr InterpExternHook))
  (field (interp-unit-state) extern_hook))

;;; Register the extern hook: `fp` performs a call to a symbol `owns` claims.
(defn set-interp-extern-hook! [(fp (fnptr (cc/C)
                                          [(ptr u8) i64 (ptr i64) i64]
                                          i64))
                               (owns (fnptr (cc/C) [(ptr u8) i64] i64))]
  (-> i64)
  (let [b (interp-extern-hook)]
    (set! (.fp b) fp)
    (set! (.owns b) owns)
    (set! (.isset b) 1)
    0))

;;; Whether the registered extern hook owns C symbol `name`.
(defn interp-hook-owns? [(name (slice u8))] (-> bool)
  (let [b (interp-extern-hook)]
    (and (!= (.isset b) 0)
         (!= (call-ptr (.owns b) (data name) (len name))
             0))))

(defstruct InterpAbortHook [(isset i64) (fp (fnptr (cc/C) [] i64))])

(defn interp-abort-hook [] (-> (ptr InterpAbortHook))
  (field (interp-unit-state) abort_hook))

(defn set-interp-abort-check! [(fp (fnptr (cc/C) [] i64))] (-> i64)
  (let [b (interp-abort-hook)] (set! (.fp b) fp) (set! (.isset b) 1) 0))

(defn interp-aborting? [] (-> bool)
  (let [b (interp-abort-hook)]
    (if (= (.isset b) 0)
        false
        (!= (call-ptr (.fp b))
            0))))

; Build a persistent (heap) interpreter context for a mono'd Program WITHOUT running
; main: same registration as interp-program, so entries can be called repeatedly (one
; per macro invocation). Reachable functions compile lazily on first call.
(defn interp-build [(a (dyn Allocator)) (mp (ptr Program))] (-> (ptr Interp))
  (let [cx (box! a Interp (zeroed Interp))]
    (set! (.a cx) a)
    (set! (.mp cx) mp)
    (set! (.externs cx) (load (field mp externs)))
    (set! (.bfuncs cx) (ArrayList::new [BFunc] a))
    (set! (.statics cx) (ArrayList::new [IStatic] a))
    (set! (.named_statics cx) (ArrayList::new [IStatic] a))
    (set! (.irs cx) (ArrayList::new [IIr] a))
    (iregister-types! cx mp)
    (let [fs (load (field mp funcs))
          n (len (load fs))
          (mut i) 0
          (mut bf0) (zeroed BFunc)]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [fd (ial-at [Func] fs (load i))]
                    (set! (.name bf0) (.name fd))
                    (set! (.nparams bf0) (len (load (field fd params))))
                    (set! (.nlocals bf0) 0)
                    (set! (.code bf0)
                          (primitive/cast (ptr (ArrayList Instr)) 0))
                    (set! (.retty bf0) (.ret fd))
                    (set! (.state bf0) 0)
                    (push! (mut (.bfuncs cx)) bf0))
                  (set! i (primitive/iadd (load i) 1))))))
    cx))

;;; An interpreter context for the compiler's own metaprograms and comptime folds.
(defn interp-build-metaprogram [(a (dyn Allocator)) (mp (ptr Program))]
  (-> (ptr Interp))
  (let [cx (interp-build a mp)]
    (set! (.metaprogram cx) true)
    cx))

; Run entry `nm` with `argc` already-boxed argument cells; returns the i64 result cell
; (a metaprogram entry returns a Code/Sexp handle as a pointer-in-a-cell). A missing
; entry is a hard error.
(defn interp-call-entry [(cx (ptr Interp))
                         (nm (slice u8))
                         (argv (ptr i64))
                         (argc i64)] (-> i64)
  (let [fi (find-func cx nm)]
    (if (< fi 0)
        (do (idie2 "interp meta: no such entry function: " nm) 0)
        (do
          (ensure-compiled cx fi)
          (interp-ffi-enter! cx)
          (vm-exec cx fi argv argc 0)))))

; Does the context define an entry with this coil function name? (e.g. the comptime
; div-by-zero guard's coil.ct.status is present only when the sub-program had a div/rem.)
(defn interp-has-entry? [(cx (ptr Interp)) (nm (slice u8))] (-> bool)
  (>= (find-func cx nm) 0))

; Compile every mono'd function to bytecode, then run `main` and return its i64
; (the process exit code). Registration happens BEFORE compilation so calls
; resolve by name regardless of order.
(defn interp-program [(a (dyn Allocator)) (mp (ptr Program))] (-> i64)
  (let [cx (interp-build a mp)]
    ; lazily compile from main (transitively compiles exactly the reachable set),
    ; then run it. main's i64 return is the process exit code.
    (let [mi (find-func cx "main")]
      (if (< mi 0)
          (do (idie "no `main` function in program") 1)
          (do
            (ensure-compiled cx mi)
            (let [np (.nparams (ial-at [BFunc] (field cx bfuncs) mi))
                  ib (iargs-box)
                  (mut argbuf) (zeroed (array i64 4))]
              ; main receives as many of (argc, argv) as it declares: argc widens
              ; into the first cell, argv (a char**) the second. A main declaring
              ; only argc used to be called with none, and read 0.
              (set! (index (primitive/cast (ptr i64) (mut argbuf)) 0)
                    (.argc ib))
              (set! (index (primitive/cast (ptr i64) (mut argbuf)) 1)
                    (.argv ib))
              (vm-exec cx
                       mi
                       (primitive/cast (ptr i64) (mut argbuf))
                       (if (> np 2) 2 np)
                       0)))))))
