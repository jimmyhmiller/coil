                            (interp-fnptr cx mfi))))
                  (femit fb 31 16 8 0)
                  (femit fb 3 l 0 0)  ; ALLOCZ 16 -> local l
                  (femit fb 2 l 0 0)
                  (compile-expr fb inner)
                  (femit fb 7 8 0 0)
                  (femit fb 4 0 0 0)  ; l[0] = data
                  (femit fb 2 l 0 0)
                  (femit fb 34 8 0 0)
                  (femit fb 1 vt 0 0)
                  (femit fb 7 8 0 0)
                  (femit fb 4 0 0 0)  ; l[8] = vtable
                  (femit fb 2 l 0 0)  ; push the dyn object
                  (TStruct ds)))
      (EDynDispatch [dc]
                    (let [ds (.dyn_struct dc)
                          vtn (.vtable_struct dc)
                          mi (.method_index dc)
                          cc (.cc dc)
                          params (.params dc)
                          ret (.ret dc)
                          recv (.recv dc)
                          args (.args dc)]
                      (let [r (fb-local! fb)]
                        (compile-expr fb recv)
                        (femit fb 3 r 0 0)  ; r = receiver dyn object addr
                        ; fnptr = *( *(r+8) + mi*8 )
                        (femit fb 2 r 0 0)
                        (femit fb 34 8 0 0)
                        (femit fb 6 8 0 0)  ; vtable addr
                        (when (!= (primitive/imul mi 8) 0)
                          (femit fb 34 (primitive/imul mi 8) 0 0))
                        (femit fb 6 8 0 0)  ; fnptr (encoded)
                        (femit fb 2 r 0 0)
                        (femit fb 6 8 0 0)  ; data ptr (first arg)
                        (compile-args fb args)
                        (femit fb 42 (primitive/iadd 1 (len (load args))) -1 0)  ; CALLPTR (always a method)
                        ret)))
      (EErase [tn inner]
              (do
                (idie2 "EErase reached the interpreter (checker bug): " tn)
                (TInt 64 true)))
      (ETypeQuery [q t]
                  (do
                    (idie "ETypeQuery reached the interpreter (checker bug)")
                    (TInt 64 true)))
      (EVector [op result types args]
               (let [saved (.env fb)
                     (mut slots) (ArrayList::new [i64] a)]
                 (for [i 0 (len (load args))]
                   (compile-expr fb (ial-at [Expr] args i))
                   (let [slot (fb-local! fb)]
                     (femit fb 3 slot 0 0)
                     (push! (mut slots) slot)))
                 (for [i 0 (len (load args))]
                   (set! (.env fb)
                         (cs-cons a
                                  (vs-argument-name a i)
                                  (get (load slots) i)
                                  (get (load types) i)
                                  (.env fb))))
                 (let [lowered
                         (match (scalarize-vector a
                                                  op
                                                  (box-type a result)
                                                  types)
                           (Ok [expr] expr)
                           (Err [d]
                                (let [diag d]
                                  (idie (.msg diag))
                                  (mk-expr (EInt 0) -1 -1 -1 0))))
                       value (compile-expr fb (box-expr a lowered))]
                   (set! (.env fb) saved)
                   value)))
      (EStaticRef [name]
                  (let [cp (interp-runtime-def cx name)]
                    (femit fb 1 (interp-static-addr! cx name) 0 0)
                    (match (.ty cp)
                      (Some [ty] (TPtr (box-type a ty)))
                      (None []
                            (do
                              (idie2 "internal: checked def has no type: " name)
                              (TInt 64 true))))))
      (EMakeSlice [data elem extent]
                  (let [l (fb-local! fb)]
                    (femit fb 31 16 8 0)
                    (femit fb 3 l 0 0)  ; ALLOCZ 16 -> local l
                    (femit fb 2 l 0 0)
                    (compile-expr fb data)
                    (femit fb 7 8 0 0)
                    (femit fb 4 0 0 0)  ; l[0] = data
                    (femit fb 2 l 0 0)
                    (femit fb 34 8 0 0)
                    (femit fb 1 (extent-value extent) 0 0)
                    (femit fb 7 8 0 0)
                    (femit fb 4 0 0 0)  ; l[8] = length
                    (femit fb 2 l 0 0)  ; push the slice
                    (TSlice (box-type a elem))))
      (EAccessorField [p fname]
                      (compile-expr fb
                                    (box-expr a
                                              (expr-at e (EField p fname)))))
      (_ (do
           (idie "unimplemented expression kind reached the interpreter compiler")
           (TInt 64 true))))))

;;; The runtime `def` named `name`.
(defn interp-runtime-def [(cx (ptr Interp)) (name (slice u8))] (-> (ptr Const))
  (let [cs (load (field (.mp cx) consts))
        (mut found) (primitive/cast (ptr Const) 0)]
    (for i (range 0 (len (load cs)))
      (let [cp (ial-at [Const] cs i)]
        (when (and (.runtime cp) (= (.name cp) name)) (set! found cp))))
    (when (= (primitive/cast i64 (load found)) 0)
      (idie2 "static-ref references an unknown def: " name))
    ; Its storage is in another unit's object, which the interpreter cannot
    ; reach; a fresh zero here would silently be different storage.
    (when (.declared (load found))
      (idie2 "declared storage is defined in another unit, which the interpreter cannot reach: "
             name))
    (load found)))

;;; The address of `name`'s static storage, allocated and initialized on first use.
(defn interp-static-addr! [(cx (ptr Interp)) (name (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for i (range 0 (len (.statics cx)))
      (let [st (ial-at [IStatic] (field cx statics) i)]
        (when (= (.name st) name) (set! found (.addr st)))))
    (if (>= found 0)
        found
        (let [cp (interp-runtime-def cx name)
              tp
                (box-type (.a cx)
                          (match (.ty cp) (Some [t] t) (None [] (TInt 64 true))))
              sz (isize-of cx tp)
              addr
                (primitive/cast i64
                                (interp-owned-alloc (primitive/cast isize sz)))]
          (memzero addr sz)
          ; Recorded before writing: an initializer may name this def's address.
          (push! (mut (.statics cx)) (IStatic :name name :addr addr))
          (interp-static-write! cx tp (field cp value) addr)
          addr))))

(defn interp-field-ty [(cx (ptr Interp)) (si i64) (fi i64)] (-> (ptr Type))
  (field (ial-at [Field]
                 (load (field (struct-at (field cx layouts) si) fields))
                 fi)
         ty))

;;; Lay the link-time constant `e` of type `t` into memory at `addr`: the same
;;; initializers a native backend writes into its data section.
(defn interp-static-write! [(cx (ptr Interp))
                            (t (ptr Type))
                            (e (ptr Expr))
                            (addr i64)] (-> i64)
  (match (.kind e)
    (EInt [n] (mem-store addr n (isize-of cx t)))
    ; `(sizeof K)` and its kin are constants, as the LLVM backend folds them.
    (ESizeOf [ty]
             (let [(mut tp) ty]
               (mem-store addr (isize-of cx (mut tp)) (isize-of cx t))))
    (EAlignOf [ty]
              (let [(mut tp) ty]
                (mem-store addr (ialign-of cx (mut tp)) (isize-of cx t))))
    (EOffsetOf [ty fname]
               (match ty
                 (TStruct [nm]
                          (let [si (istruct-idx cx nm)]
                            (when (< si 0)
                              (idie2 "offset-of on non-struct: " nm))
                            (mem-store addr
                                       (ifield-off cx
                                                   si
                                                   (ifield-idx cx si fname))
                                       (isize-of cx t))))
                 (_ (idie "offset-of on non-struct"))))
    (EBool [v] (mem-store addr (if v 1 0) 1))
    (EFloat [bits]
            (match (load t)
              (TFloat [width]
                      (if (= width 32)
                          (mem-store addr (f64-bits->f32-bits bits) 4)
                          (mem-store addr bits 8)))
              (_ (mem-store addr bits 8))))
    (EStr [sv]
          (do
            (mem-store addr (intern-bytes sv) 8)
            (mem-store (+ addr 8) (len sv) 8)))
    (ECStr [sv] (mem-store addr (intern-bytes sv) 8))
    (EConstruct [sum variant args]
                (let [su (isum-idx cx sum)]
                  (when (< su 0) (idie2 "def initializer: unknown sum " sum))
                  (let [vidx (ivariant-idx cx su variant)
                        vs
                          (load (field (sum-at (field cx layouts) su) variants))
                        vfields (load (field (ial-at [Variant] vs vidx) fields))]
                    (mem-store addr vidx 4)
                    (for i (range 0 (len (load args)))
                      (interp-static-write! cx
                                            (field (ial-at [Field] vfields i)
                                                   ty)
                                            (ial-at [Expr] args i)
                                            (+ addr
                                               (+ 8 (inatural-off cx vfields i)))))
                    0)))
    (EZeroed [_] 0)
    (ERecordInit [_] 0)
    (EStaticArray [indices items]
                  (match (load t)
                    (TArray [elem _]
                            (do
                              (for i (range 0 (len (load items)))
                                (interp-static-write! cx
                                                      elem
                                                      (ial-at [Expr] items i)
                                                      (+ addr
                                                         (* (get (load indices)
                                                                 i)
                                                            (isize-of cx elem)))))
                              0))
                    (_ (idie "static :elements requires an array allocation"))))
    (EFnPtrOf [name]
              (let [fi (find-func cx name)]
                (when (< fi 0)
                  (idie2 "def initializer: unknown function " name))
                (ensure-compiled cx fi)
                (mem-store addr (interp-fnptr cx fi) 8)))
    (EAlloc [storage ty init symbol]
            (if (!= storage 1)
                (idie "def initializer: only alloc-static storage is a link-time constant")
                (let [tp (box-type (.a cx) ty)
                      sz (isize-of cx tp)
                      inner
                        (match symbol
                          (Some [name] (interp-named-static! cx name sz))
                          (None []
                                (let [cell
                                        (primitive/cast i64
                                                        (interp-owned-alloc (primitive/cast isize
                                                                                            sz)))]
                                  (memzero cell sz)
                                  cell)))]
                  (unless (= (primitive/cast i64 init) 0)
                    (interp-static-write! cx tp init inner))
                  (mem-store addr inner 8))))
    (EStaticRef [name] (mem-store addr (interp-static-addr! cx name) 8))
    (EMakeSlice [data elem len]
                (do
                  (interp-static-write! cx
                                        (box-type (.a cx)
                                                  (TPtr (box-type (.a cx) elem)))
                                        data
                                        addr)
                  (mem-store (+ addr 8) (extent-value len) 8)))
    (ECast [_ inner] (interp-static-write! cx t inner addr))
    (ELoad [inner] (interp-static-write! cx t inner addr))
    (ELet [_ body]
          (match (load t)
            (TStruct [name]
                     (let [si (istruct-idx cx name)]
                       (when (< si 0)
                         (idie2 "def initializer: unknown struct " name))
                       (for i (range 0 (len (load body)))
                         (let [item (ial-at [Expr] body i)
                               place (static-store-place item)]
                           (if (= (primitive/cast i64 place) 0)
                               (if (static-body-result? body i)
                                   0
                                   (idie "def initializer: expected a materialized aggregate"))
                               (match (.kind place)
                                 (EField [_ fname]
                                         (let [fi (ifield-idx cx si fname)]
                                           (when (< fi 0)
                                             (idie2 "def initializer: unknown field "
                                                    fname))
                                           (interp-static-write! cx
                                                                 (interp-field-ty cx
                                                                                  si
                                                                                  fi)
                                                                 (static-store-value item)
                                                                 (+ addr
                                                                    (ifield-off cx
                                                                                si
                                                                                fi)))))
                                 (_ (idie "def initializer: a store that is not to a field of the aggregate"))))))
                       0))
            (TArray [elem count-extent]
                    (let [count (extent-value count-extent)]
                      (for i (range 0 (len (load body)))
                        (let [store (ial-at [Expr] body i)
                              place (static-store-place store)]
                          (if (= (primitive/cast i64 place) 0)
                              (if (static-body-result? body i)
                                  0
                                  (idie "def initializer: expected a materialized array"))
                              (match (.kind place)
                                (EIndex [_ index]
                                        (match (.kind index)
                                          (EInt [item]
                                                (if (or (< item 0)
                                                        (>= item count))
                                                    (idie "alloc-static initializer: array index is out of bounds")
                                                    (interp-static-write! cx
                                                                          elem
                                                                          (static-store-value store)
                                                                          (+ addr
                                                                             (* item
                                                                                (isize-of cx
                                                                                          elem))))))
                                          (_ (idie "alloc-static initializer: array index is not constant"))))
                                (_ (idie "def initializer: a store that is not to an element of the array"))))))
                      0))
            (_ (idie "def initializer: materialized aggregate has the wrong type"))))
    (_ (idie "def initializer is not a link-time constant"))))

; compile function `fi` on first reference (self-recursion is guarded by marking
; state=1 BEFORE compiling the body). Only functions reachable from main are ever
; compiled, so unused stdlib functions using not-yet-implemented features never
; force a hard error.
(defn ensure-compiled [(cx (ptr Interp)) (fi i64)] (-> i64)
  (let [bf (ial-at [BFunc] (field cx bfuncs) fi)]
    (when (= (.state bf) 0)
      (set! (.state bf) 1)
      (compile-func cx
                    (ial-at [Func] (load (field (load (field cx mp)) funcs)) fi)
                    fi))))

; compile one mono'd function into cx.bfuncs[fidx] (name/nparams/retty were set
; by pre-registration so calls resolve regardless of compile order).
(defn compile-func [(cx (ptr Interp)) (fd (ptr Func)) (fidx i64)] (-> i64)
  ; A cell holds 64 bits, so an integer wider than that would lose its high word.
  (when (= (primitive/cast i64 (.wide cx)) 0)
    (set! (.wide cx) (box! (.a cx) WideScan (wide-scan-new (.a cx) (.mp cx))))
    0)
  (when (wide-func? (.wide cx) fd)
    (idie (if (.metaprogram cx)
              (wide-int-refused (.a cx)
                                "interpreted metaprogram engine"
                                (.name fd)
                                "unset COIL_META_INTERP to run it on the native engine")
              (wide-int-unsupported (.a cx) "interpreter" (.name fd)))))
  ; A `declare`d function's definition is machine code in another unit's
  ; object. The interpreter has no object to link, so running one here would
  ; silently return 0 from an empty body.
  (when (.declared fd)
    (idie (text/format (.a cx)
                       "declared function '{}' has no body in this unit; the interpreter cannot run a function defined in a prebuilt object"
                       (.name fd)))
    0)
  (let [a (.a cx)
        fb (primitive/alloc-stack FB)]
    (set! (.cx fb) cx)
    (set! (.code fb) (ArrayList::new [Instr] a))
    (set! (.loops fb) (ArrayList::new [CLoop] a))
    (set! (.labels fb) (ArrayList::new [i64] a))
    (set! (.nlocals fb) 0)
    (set! (.env fb) (primitive/cast (ptr CScope) 0))
    (set! (.term fb) false)
    (let [ps (load (field fd params))
          np (len (load ps))
          (mut i) 0]
      (loop (if (>= (load i) np)
                (break)
                (do
                  (let [p (ial-at [Param] ps (load i))
                        slot (fb-local! fb)]
                    (set! (.env fb)
                          (cs-cons a
                                   (.name p)
                                   slot
                                   (.ty p)
                                   (load (field fb
                                                env)))))
                  (set! i (primitive/iadd (load i) 1))))))
    (compile-seq fb (load (field fd body)))
    (femit fb 15 0 0 0)  ; RET (pops the body's value)
    (resolve-labels fb)
    (mark-tail-calls! cx fb fd)
    (let [bf (ial-at [BFunc] (field cx bfuncs) fidx)]
      (set! (.nlocals bf) (.nlocals fb))
      (set! (.code bf) (box-al [Instr] a (.code fb))))
    0))

; A type a tail call can carry: a value with no storage of its own behind it, so
; nothing it holds can point into the frame the call releases. (An aggregate is
; passed by the address of storage in that frame, and a pointer may point into it.)
(defn tail-scalar? [(t (ptr Type))] (-> bool)
  (match (load t)
    (TInt [bits _] (<= bits 64))
    (TBool [] true)
    (TFloat [_] true)
    (TFn [_ _ _] true)
    (_ false)))

;;; A pointer argument may address the caller's frame, which a tail call
;;; releases. Such a call is marked to become a tail call only when, as it runs,
;;; the frame holds no memory at all (`frame-alloc` never ran), so nothing a
;;; pointer could address is released.
(defn tail-pointer? [(t (ptr Type))] (-> bool)
  (match (load t)
    (TPtr [_] true)
    (TRef [_ _] true)
    (_ (tail-scalar? t))))

(defn tail-result? [(t (ptr Type))] (-> bool)
  (or (tail-scalar? t) (match (load t) (TVoid [] true) (_ false))))

;;; Does control starting at AT never leave: past the dead value a statement
;;; drops (POP) and an empty loop's stack save (SAVESP), only jumps that come
;;; back to themselves? That is what `(loop)` compiles to after a call.
(defn diverges-after? [(code (ptr (ArrayList Instr))) (at i64)] (-> bool)
  (let [n (len (load code))
        (mut j) at
        (mut steps) 0]
    (while (and (< j n)
                (or (= (.op (ial-at [Instr] code j)) 4)
                    (= (.op (ial-at [Instr] code j)) 44)))
      (set! j (+ j 1)))
    ; a jump to itself, or a cycle of jumps: either way the jumps never leave
    (while (and (< j n)
                (and (= (.op (ial-at [Instr] code j)) 11)
                     (and (< steps n) (!= (.a (ial-at [Instr] code j)) j))))
      (set! j (.a (ial-at [Instr] code j)))
      (set! steps (+ steps 1)))
    (and (< j n) (= (.op (ial-at [Instr] code j)) 11))))

;;; A CALL immediately followed by RET -- through nothing but jumps -- is in tail
;;; position. So is a call of a void function followed by jumps that only loop:
;;; the checker follows every call that never returns with `(loop)` (ast.coil,
;;; diverging-call), so control never comes back to this frame. It becomes a
;;; TAILCALL when the call can release the caller's frame: every argument and
;;; both results are scalars (the rule the LLVM backend's `musttail` follows), so
;;; no argument can be an address in that frame.
(defn mark-tail-calls! [(cx (ptr Interp)) (fb (ptr FB)) (fd (ptr Func))]
  (-> i64)
  (let [code (field fb code)
        n (len (load code))
        funcs (load (field (load (field cx mp)) funcs))]
    (when (tail-result? (field fd ret))
      (for [i 0 n]
        (let [ins (ial-at [Instr] code i)]
          (when (= (.op ins) 13)
            (let [(mut j) (+ i 1)
                  (mut steps) 0]
              (while (and (< j n)
                          (and (= (.op (ial-at [Instr] code j)) 11) (< steps n)))
                (set! j (.a (ial-at [Instr] code j)))
                (set! steps (+ steps 1)))
              (let [callee (ial-at [Func] funcs (.a ins))
                    returns (and (< j n) (= (.op (ial-at [Instr] code j)) 15))
                    diverges
                      (and (match (.ret callee)
                             (TVoid [] true)
                             (_ false))
                           (diverges-after? code (+ i 1)))]
                (when (or returns diverges)
                  (let [ps (load (field callee params))]
                    (when (tail-result? (field callee ret))
                      (cond (block :all
                              (for [k 0 (len (load ps))]
                                (unless (tail-scalar? (field (ial-at [Param]
                                                                     ps
                                                                     k)
                                                             ty))
                                  (break :all false)))
                              true)
                              (set! (.op ins) 48)
                            (block :all
                              (for [k 0 (len (load ps))]
                                (unless (tail-pointer? (field (ial-at [Param]
                                                                      ps
                                                                      k)
                                                              ty))
                                  (break :all false)))
                              true)
                              ; a tail call if the frame is empty when it runs
                              (set! (.c ins) 1)
                            :else 0)
                      0))
                  0)))
            0)))
      0)
    0))

; ============================ real memory model ==============================
(defn mem-load [(addr i64) (sz i64) (signed bool)] (-> i64)
  (if (not (or (= sz 1) (= sz 2) (= sz 4) (= sz 8)))
      (do (idie "mem-load: bad size") 0)
      ; Interpreter addresses may point into packed structs.  Typed multi-byte
      ; loads would assert alignment that those fields deliberately do not have.
      (let [(mut v) 0]
        (for [i 0 sz]
          (let [b
                  (primitive/cast i64
                                  (load (primitive/cast (ptr u8)
                                                        (primitive/iadd addr
                                                                        i))))]
            (set! v
                  (| (load v)
                     (<< b
                         (primitive/imul i
                                         8))))))
        (if (and signed (< sz 8))
            (let [shift (primitive/isub 64 (primitive/imul sz 8))]
              (>> (<< (load v) shift) shift))
            (load v)))))

(defn mem-store [(addr i64) (v i64) (sz i64)] (-> i64)
  (if (not (or (= sz 1) (= sz 2) (= sz 4) (= sz 8)))
      (do (idie "mem-store: bad size") 0)
      (let []
        (for [i 0 sz]
          (set! (primitive/cast (ptr u8)
                                (primitive/iadd addr i))
                (primitive/cast u8
                                (& (>> v
                                       (primitive/imul i
                                                       8))
                                   255))))
        0)))

(defn memzero [(addr i64) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (primitive/cast (ptr u8) (primitive/iadd addr (load i)))
                      (: 0 u8))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; copy n bytes dst<-src (word-at-a-time then byte tail). src/dst are real addrs.
(defn memcopy [(dst i64) (src i64) (n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (> (primitive/iadd (load i) 8) n)
              (break)
              (do
                (set! (primitive/cast (ptr i64) (primitive/iadd dst (load i)))
                      (load (primitive/cast (ptr i64)
                                            (primitive/iadd src (load i)))))
                (set! i (primitive/iadd (load i) 8)))))
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (primitive/cast (ptr u8) (primitive/iadd dst (load i)))
                      (load (primitive/cast (ptr u8)
                                            (primitive/iadd src (load i)))))
                (set! i (primitive/iadd (load i) 1))))))
  0)

; A call's frame memory: `alloc-stack` slots, aggregate temporaries and
; `alloc-stack-bytes` blocks, all living until the call returns. It is a chain of
; malloc'd chunks bump-allocated in order; a request that does not fit the current
; chunk starts a new one (at least as large as the request), so an address handed
; out never moves and a frame has no size limit. Each chunk begins with the
; address of the one before it, which is how `frame-free!` walks them.
;
; Every interpreted call has a frame, and most never allocate in it (a loop
; written as a self tail call makes a call per iteration), so a frame starts with
; no chunk at all: the first allocation makes one. Chunks start small and double,
; up to frame-chunk-max, so a frame that needs a few slots pays for a small block,
; not a 64 KiB one per call.
(defstruct FrameMem [(chunk i64) (off i64) (cap i64)])

(defn frame-chunk-min [] (-> i64)
  1024)

(defn frame-chunk-max [] (-> i64)
  65536)

(defn frame-new-chunk! [(fm (ptr FrameMem)) (need i64)] (-> i64)
  (let [grown
          (cond (= (.cap fm) 0) (frame-chunk-min)
                (>= (.cap fm) (frame-chunk-max)) (frame-chunk-max)
                :else (* (.cap fm) 2))
        cap (if (> (+ need 16) grown) (+ need 16) grown)
        chunk (primitive/cast i64 (interp.malloc (primitive/cast isize cap)))]
    (when (= chunk 0)
      (idie "frame memory: malloc failed"))
    (set! (primitive/cast (ptr i64) chunk) (.chunk fm))
    (set! (.chunk fm) chunk)
    (set! (.off fm) 16)
    (set! (.cap fm) cap)
    chunk))

(defn frame-new [] (-> FrameMem)
  (FrameMem
    :chunk 0
    :off 0
    :cap 0))

; `size` bytes aligned to `align`, a real host address valid until the frame ends.
(defn frame-alloc [(fm (ptr FrameMem)) (size i64) (align i64)] (-> i64)
  (let [al (if (<= align 1) 1 align)]
    (when (or (= (.chunk fm) 0) (> (+ (align-up (.off fm) al) size) (.cap fm)))
      (frame-new-chunk! fm (+ size al)))
    (let [off (align-up (.off fm) al)]
      (set! (.off fm) (+ off size))
      (+ (.chunk fm) off))))

(defn frame-free! [(fm (ptr FrameMem))] (-> i64)
  (loop (if (= (.chunk fm) 0)
            (break)
            (let [prev (load (primitive/cast (ptr i64) (.chunk fm)))]
              (interp.free (primitive/cast (ptr i8) (.chunk fm)))
              (set! (.chunk fm) prev))))
  0)

; ============================ float bit-casts ================================
; The f64 pair (`bits->f64` / `f64->bits`) moved to coil.mem as `bits->f64` /
; `f64-bits`; this file had a third spelling of the same three lines. The f32
; pair stays: it is a NARROWING round-trip (i32 slot, u32-widened result), not
; the same operation.
(defn bits->f32 [(b i64)] (-> f32)
  (let [(mut p) (: (primitive/cast i32 b) i32)]
    (load (primitive/cast (ptr f32) (mut p)))))

(defn f32->bits [(x f32)] (-> i64)
  (let [(mut p) x]
    (primitive/cast i64
                    (primitive/cast u32
                                    (load (primitive/cast (ptr i32) (mut p)))))))

; ============================ VM arithmetic =================================
; canonicalize `v` to exact iN width (container invariant: values are sign/zero
; extended from bit N-1). No-op for 64-bit — the common case.
(defn canon-int [(v i64) (bits i64) (signed bool)] (-> i64)
  (if (>= bits 64)
      v
      (if signed
          (let [sh (primitive/isub 64 bits)]
            (>> (<< v sh) sh))
          (& v (primitive/isub (<< 1 bits) 1)))))

(defn ult [(a i64) (b i64)] (-> bool)
  (< (^ a (<< 1 63))
     (^ b (<< 1 63))))

(defn ule [(a i64) (b i64)] (-> bool)
  (<= (^ a (<< 1 63))
      (^ b (<< 1 63))))

(defn ugt [(a i64) (b i64)] (-> bool)
  (> (^ a (<< 1 63))
     (^ b (<< 1 63))))

(defn uge [(a i64) (b i64)] (-> bool)
  (>= (^ a (<< 1 63))
      (^ b (<< 1 63))))

(defn b01 [(x bool)] (-> i64)
  (when x 1))

(defn do-int-unary [(op i64) (signbits i64) (v i64)] (-> i64)
  (let [bits (>> signbits 1)
        (mut n) 0
        (mut x) (canon-int v (>> signbits 1) false)]
    (cond (= op 2)
            (do
              (loop (if (or (>= (load n) bits)
                            (!= (& (load x)
                                   (<< 1
                                       (primitive/isub bits
                                                       1)))
                                0))
                        (break)
                        (do
                          (set! n (primitive/iadd (load n) 1))
                          (set! x (<< (load x) 1)))))
              (load n))
          (= op 3)
            (do
              (loop (if (or (>= (load n) bits)
                            (!= (& (load x) 1) 0))
                        (break)
                        (do
                          (set! n (primitive/iadd (load n) 1))
                          (set! x
                                (primitive/cast i64
                                                (>> (primitive/cast u64
                                                                    (load x))
                                                    1))))))
              (load n))
          (= op 4)
            (do
              (set! n 0)
              (loop (if (= (load x) 0)
                        (break)
                        (do
                          (set! x
                                (& (load x) (primitive/isub (load x) 1)))
                          (set! n (primitive/iadd (load n) 1)))))
              (load n))
          :else
            (let [(mut out) 0
                  (mut i) 0]
              (loop (if (>= (primitive/imul (load i) 8) bits)
                        (break)
                        (do
                          (set! out
                                (| (<< (load out) 8)
                                   (& (>> (load x)
                                          (primitive/imul (load i)
                                                          8))
                                      255)))
                          (set! i (primitive/iadd (load i) 1)))))
              (canon-int (load out) bits (!= (& signbits 1) 0))))))

(defn interp-umulhi [(l i64) (r i64) (bits i64)] (-> i64)
  (let [(mut lo) 0
        (mut hi) 0
        (mut xlo) (canon-int l bits false)
        (mut xhi) 0
        (mut y) (canon-int r bits false)]
    (for [i 0 bits]
      (when (!= (& (load y) 1) 0)
        (let [old (load lo)]
          (set! lo
                (canon-int (primitive/iadd (load lo) (load xlo))
                           bits
                           false))
          (set! hi
                (canon-int (primitive/iadd (primitive/iadd (load hi)
                                                           (load xhi))
                                           (when (ult (load lo) old)
                                             1))
                           bits
                           false))))
      (set! xhi
            (canon-int (| (<< (load xhi) 1)
                          (primitive/cast i64
                                          (>> (primitive/cast u64
                                                              (load xlo))
                                              (primitive/cast u64
                                                              (primitive/isub bits
                                                                              1)))))
                       bits
                       false))
      (set! xlo (canon-int (<< (load xlo) 1) bits false))
      (set! y
            (primitive/cast i64
                            (>> (primitive/cast u64
                                                (load y))
                                (: 1 u64)))))
    (load hi)))

(defn interp-mulhi [(l i64) (r i64) (bits i64) (signed bool)] (-> i64)
  (let [(mut h) (interp-umulhi l r bits)]
    (when signed
      (let [sign (<< 1 (primitive/isub bits 1))
            ul (canon-int l bits false)
            ur (canon-int r bits false)]
        (when (!= (& ul sign) 0)
          (set! h (canon-int (primitive/isub (load h) ur) bits false)))
        (when (!= (& ur sign) 0)
          (set! h (canon-int (primitive/isub (load h) ul) bits false)))))
    (canon-int (load h) bits signed)))

(defn interp-overflow? [(op i64) (l i64) (r i64) (bits i64) (signed bool)]
  (-> i64)
  (let [ul (canon-int l bits false)
        ur (canon-int r bits false)
        result
          (canon-int (cond (= op 15) (primitive/iadd ul ur)
                           (= op 16) (primitive/isub ul ur)
                           :else (primitive/imul ul ur))
                     bits
                     false)]
    (if signed
        (let [sign (<< 1 (primitive/isub bits 1))
              ls (!= (& ul sign) 0)
              rs (!= (& ur sign) 0)
              os (!= (& result sign) 0)]
          (if (= op 15)
              (b01 (and (= ls rs) (!= os ls)))
              (if (= op 16)
                  (b01 (and (!= ls rs) (!= os ls)))
                  (let [high (interp-mulhi l r bits true)
                        expected (if os -1 0)]
                    (b01 (!= (canon-int high bits true)
                             (canon-int expected bits true)))))))
        (if (= op 15)
            (b01 (ult result ul))
            (if (= op 16)
                (b01 (ult ul ur))
                (b01 (!= (interp-umulhi ul ur bits) 0)))))))

(defn do-bin [(op i64) (mode i64) (c i64) (l i64) (r i64)] (-> i64)
  (if (= mode 0)
      (let [signed (!= (& c 1) 0)
            bits (>> c 1)
            v
              (cond (= op 0) (primitive/iadd l r)
                    (= op 1) (primitive/isub l r)
                    (= op 2) (primitive/imul l r)
                    (= op 3) (if signed (/ l r) (primitive/udiv l r))
                    (= op 4) (if signed (% l r) (primitive/urem l r))
                    (= op 5) (primitive/udiv l r)
                    (= op 6) (primitive/urem l r)
                    (= op 7) (& l r)
                    (= op 8) (| l r)
                    (= op 9) (^ l r)
                    (= op 10) (<< l r)
                    (= op 11)
                      (if signed
                          (>> l r)
                          (primitive/cast i64
                                          (>> (primitive/cast u64 l)
                                              (primitive/cast u64 r))))
                    (or (= op 12)
                        (= op 13))
                      (let [n (primitive/urem r bits)]
                        (if (= n 0)
                            (canon-int l bits signed)
                            (if (= op 12)
                                (| (<< l n)
                                   (>> (canon-int l
                                                  bits
                                                  false)
                                       (primitive/isub bits
                                                       n)))
                                (| (>> (canon-int l
                                                  bits
                                                  false)
                                       n)
                                   (<< l
                                       (primitive/isub bits
                                                       n))))))
                    (= op 14) (interp-mulhi l r bits signed)
                    (>= op 15) (interp-overflow? op l r bits signed)
                    :else (idie "do-bin: bad integer op"))]
        (if (>= op 15) v (canon-int v bits signed)))
      (if (= mode 2)
          (let [lf (bits->f64 l)
                rf (bits->f64 r)]
            (f64-bits (cond (= op 0) (+ lf rf)
                            (= op 1) (- lf rf)
                            (= op 2) (* lf rf)
                            (= op 3) (/ lf rf)
                            (interp.fmod lf rf))))
          (let [lf (bits->f32 l)
                rf (bits->f32 r)]
            (f32->bits (cond (= op 0) (+ lf rf)
                             (= op 1) (- lf rf)
                             (= op 2) (* lf rf)
                             (= op 3) (/ lf rf)
                             (interp.fmodf lf rf)))))))

(defn do-cmp [(op i64) (mode i64) (signed i64) (l i64) (r i64)] (-> i64)
  (if (= mode 0)
      (if (!= signed 0)
          (cond (= op 0) (b01 (< l r))
                (= op 1) (b01 (<= l r))
                (= op 2) (b01 (> l r))
                (= op 3) (b01 (>= l r))
                (= op 4) (b01 (= l r))
                (b01 (!= l r)))
          (cond (= op 0) (b01 (ult l r))
                (= op 1) (b01 (ule l r))
                (= op 2) (b01 (ugt l r))
                (= op 3) (b01 (uge l r))
                (= op 4) (b01 (= l r))
                (b01 (!= l r))))
      (if (= mode 2)
          (let [lf (bits->f64 l)
                rf (bits->f64 r)]
            (cond (= op 0) (b01 (< lf rf))
                  (= op 1) (b01 (<= lf rf))
                  (= op 2) (b01 (> lf rf))
                  (= op 3) (b01 (>= lf rf))
                  (= op 4) (b01 (= lf rf))
                  (b01 (primitive/fcmp-ne lf rf))))
          (let [lf (bits->f32 l)
                rf (bits->f32 r)]
            (cond (= op 0) (b01 (< lf rf))
                  (= op 1) (b01 (<= lf rf))
                  (= op 2) (b01 (> lf rf))
                  (= op 3) (b01 (>= lf rf))
                  (= op 4) (b01 (= lf rf))
                  (b01 (primitive/fcmp-ne lf rf)))))))

(defn i2f [(v i64) (fbytes i64) (srcsigned i64)] (-> i64)
  (if (!= srcsigned 0)
      (if (= fbytes 4)
          (f32->bits (primitive/cast f32 v))
          (f64-bits (primitive/cast f64 v)))
      (if (= fbytes 4)
          (f32->bits (primitive/cast f32 (primitive/cast u64 v)))
          (f64-bits (primitive/cast f64 (primitive/cast u64 v))))))

(defn f2i [(v i64) (destbits i64) (destsigned i64) (srcfbytes i64)] (-> i64)
  (let [x
          (if (= srcfbytes 4)
              (primitive/cast f64 (bits->f32 v))
              (bits->f64 v))]
    (canon-int (primitive/cast i64 x)
               destbits
               (!= destsigned 0))))

(defn f2f [(v i64) (destbytes i64) (srcbytes i64)] (-> i64)
  (if (= destbytes srcbytes)
      v
      (if (= destbytes 8)
          (f64-bits (primitive/cast f64 (bits->f32 v)))
          (f32->bits (primitive/cast f32 (bits->f64 v))))))

; qsort(base, n, size, cmp): sort in place, invoking the Coil comparator fnptr
; through the VM (C-calls-back-into-Coil). A stable insertion sort — for the
; corpus' distinct keys the final order equals libc qsort's. cmp returns i32
; (<0 / 0 / >0); we sign-extend it. Ascending: swap while prev > cur.
(defn interp-qsort [(cx (ptr Interp)) (base i64) (n i64) (size i64) (cmpfp i64)]
  (-> i64)
  (let [fi (interp-fnptr-index cx cmpfp)
        tmp
          (primitive/cast i64
                          (interp.malloc (primitive/cast isize
                                                         (if (< size
                                                                1)
                                                             1
                                                             size))))
        (mut argbuf) (zeroed (array i64 2))]
    (when (or (< fi 0)
              (>= fi (len (.bfuncs cx))))
      (idie "qsort: comparator is not a Coil function pointer"))
    (for [i 1 n]
      (let [(mut j) i]
        (loop (if (<= (load j) 0)
                  (break)
                  (let [pa
                          (primitive/iadd base
                                          (primitive/imul (primitive/isub (load j)
                                                                          1)
                                                          size))
                        pb
                          (primitive/iadd base
                                          (primitive/imul (load j)
                                                          size))]
                    (set! (index (primitive/cast (ptr i64)
                                                 (mut argbuf))
                                 0)
                          pa)
                    (set! (index (primitive/cast (ptr i64)
                                                 (mut argbuf))
                                 1)
                          pb)
                    (if (> (canon-int (vm-exec cx
                                               fi
                                               (primitive/cast (ptr i64)
                                                               (mut argbuf))
                                               2
                                               0)
                                      32
                                      true)
                           0)
                        (do
                          (memcopy tmp pa size)
                          (memcopy pa pb size)
                          (memcopy pb tmp size)
                          (set! j (primitive/isub (load j) 1)))
                        (set! j 0))))))
      ; in order -> stop inner loop
    )
    (interp.free (primitive/cast (ptr i8) tmp))
    0))

; ============================ FFI dispatch ==================================
; Builtin table: dispatch an extern call to the REAL native libc function by its
; C symbol name. This is self-contained (no dlsym) and every entry is a genuine
; native call with the correct signature. An extern not in the table hard-errors
; — never a silent no-op.
(defn extern-call [(cx (ptr Interp)) (ei i64) (buf (ptr i64)) (n i64)] (-> i64)
  (let [nm (extern-link-name (ial-at [Extern] (load (field cx externs)) ei))]
    (cond (= nm "putchar")
            (primitive/cast i64
                            (interp.putchar (primitive/cast i32
                                                            (load (index buf 0)))))
          (= nm "putc")
            (primitive/cast i64
                            (interp.putchar (primitive/cast i32
                                                            (load (index buf 0)))))
          (= nm "write")
            (primitive/cast i64
                            (interp.write (primitive/cast i32
                                                          (load (index buf 0)))
                                          (primitive/cast (ptr i8)
                                                          (load (index buf 1)))
                                          (primitive/cast isize
                                                          (load (index buf 2)))))
          (= nm "puts")
            (primitive/cast i64
                            (interp.puts (primitive/cast (ptr i8)
                                                         (load (index buf 0)))))
          (= nm "exit")
            (do
              (interp.exit (primitive/cast i32 (load (index buf 0))))
              0)
          (= nm "malloc")
            (primitive/cast i64
                            (interp.malloc (primitive/cast isize
                                                           (load (index buf 0)))))
          (= nm "free")
            (do
              (interp.free (primitive/cast (ptr i8)
                                           (load (index buf 0))))
              0)
          (= nm "realloc")
            (primitive/cast i64
                            (interp.realloc (primitive/cast (ptr i8)
                                                            (load (index buf 0)))
                                            (primitive/cast isize
                                                            (load (index buf 1)))))
          (= nm "calloc")
            (primitive/cast i64
                            (interp.calloc (primitive/cast isize
                                                           (load (index buf 0)))
                                           (primitive/cast isize
                                                           (load (index buf 1)))))
          (= nm "memcpy")
            (primitive/cast i64
                            (interp.memcpy (primitive/cast (ptr i8)
                                                           (load (index buf 0)))
                                           (primitive/cast (ptr i8)
                                                           (load (index buf 1)))
                                           (primitive/cast isize
                                                           (load (index buf 2)))))
          (= nm "memmove")
            (primitive/cast i64
                            (interp.memmove (primitive/cast (ptr i8)
                                                            (load (index buf 0)))
                                            (primitive/cast (ptr i8)
                                                            (load (index buf 1)))
                                            (primitive/cast isize
                                                            (load (index buf 2)))))
          (= nm "memset")
            (primitive/cast i64
                            (interp.memset (primitive/cast (ptr i8)
                                                           (load (index buf 0)))
                                           (primitive/cast i32
                                                           (load (index buf 1)))
                                           (primitive/cast isize
                                                           (load (index buf 2)))))
          (= nm "memcmp")
            (primitive/cast i64
                            (interp.memcmp (primitive/cast (ptr i8)
                                                           (load (index buf 0)))
                                           (primitive/cast (ptr i8)
                                                           (load (index buf 1)))
                                           (primitive/cast isize
                                                           (load (index buf 2)))))
          (= nm "strlen")
            (primitive/cast i64
                            (interp.strlen (primitive/cast (ptr i8)
                                                           (load (index buf 0)))))
          (= nm "strcmp")
            (primitive/cast i64
                            (interp.strcmp (primitive/cast (ptr i8)
                                                           (load (index buf 0)))
                                           (primitive/cast (ptr i8)
                                                           (load (index buf 1)))))
          (= nm "read")
            (primitive/cast i64
                            (interp.read (primitive/cast i32
                                                         (load (index buf 0)))
                                         (primitive/cast (ptr i8)
                                                         (load (index buf 1)))
                                         (primitive/cast isize
                                                         (load (index buf 2)))))
          (= nm "abort") (do (interp.abort) 0)
          (= nm "printf")
            (primitive/cast i64
                            (interp.printf (primitive/cast (ptr i8)
                                                           (load (index buf 0)))
                                           (load (index buf 1))
                                           (load (index buf 2))
                                           (load (index buf 3))
                                           (load (index buf 4))
                                           (load (index buf 5))
                                           (load (index buf 6))))
          (= nm "dprintf")
            (primitive/cast i64
                            (interp.dprintf (primitive/cast i32
                                                            (load (index buf 0)))
                                            (primitive/cast (ptr i8)
                                                            (load (index buf 1)))
                                            (load (index buf 2))
                                            (load (index buf 3))
                                            (load (index buf 4))
                                            (load (index buf 5))
                                            (load (index buf 6))
                                            (load (index buf 7))))
          (= nm "snprintf")
            (primitive/cast i64
                            (interp.snprintf (primitive/cast (ptr i8)
                                                             (load (index buf 0)))
                                             (load (index buf 1))
                                             (primitive/cast (ptr i8)
                                                             (load (index buf 2)))
                                             (load (index buf 3))
                                             (load (index buf 4))
                                             (load (index buf 5))
                                             (load (index buf 6))
                                             (load (index buf 7))
                                             (load (index buf 8))))
          ; div_t div(int,int): {quot@0, rem@4}, returned in x0 (quot low, rem high).
          ; Computed directly (avoids a struct-return extern declaration); the caller
          ; boxes this packed word into a div_t slot (opcode 43).
          (= nm "div")
            (let [x (load (index buf 0))
                  y (load (index buf 1))]
              (| (& (/ x y) 4294967295) (<< (% x y) 32)))
          (= nm "qsort")
            (interp-qsort cx
                          (load (index buf 0))
                          (load (index buf 1))
                          (load (index buf 2))
                          (load (index buf 3)))
          ; pthread_create(handle, attr, start, arg): run the Coil start routine
          ; SYNCHRONOUSLY (the interpreter is single-threaded; sequential execution of
          ; the workers' atomic ops yields the same race-free final state as genuine
          ; concurrency for the corpus' contention-free dogfoods). *handle gets a
          ; nonzero id so join has something; the routine's return is discarded.
          (= nm "pthread_create")
            (let [fi (interp-fnptr-index cx (load (index buf 2)))
                  (mut wargs) (zeroed (array i64 1))]
              (when (or (< fi 0)
                        (>= fi (len (.bfuncs cx))))
                (idie "pthread_create: start routine is not a Coil function pointer"))
              (set! (index (primitive/cast (ptr i64) (mut wargs)) 0)
                    (load (index buf 3)))
              (vm-exec cx fi (primitive/cast (ptr i64) (mut wargs)) 1 0)
              (mem-store (load (index buf 0)) 1 8)
              0)
          (= nm "pthread_join") 0
          (= nm "sqrt")
            (f64-bits (interp.sqrt (bits->f64 (load (index buf 0)))))
          (= nm "sqrtf")
            (f32->bits (interp.sqrtf (bits->f32 (load (index buf 0)))))
          (= nm "floorf")
            (f32->bits (interp.floorf (bits->f32 (load (index buf 0)))))
          (= nm "ceilf")
            (f32->bits (interp.ceilf (bits->f32 (load (index buf 0)))))
          (= nm "truncf")
            (f32->bits (interp.truncf (bits->f32 (load (index buf 0)))))
          (= nm "trunc")
            (f64-bits (interp.trunc (bits->f64 (load (index buf 0)))))
          (= nm "fmaf")
            (f32->bits (interp.fmaf (bits->f32 (load (index buf 0)))
                                    (bits->f32 (load (index buf 1)))
                                    (bits->f32 (load (index buf 2)))))
          (= nm "fma")
            (f64-bits (interp.fma (bits->f64 (load (index buf 0)))
                                  (bits->f64 (load (index buf 1)))
                                  (bits->f64 (load (index buf 2)))))
          (= nm "pow")
            (f64-bits (interp.pow (bits->f64 (load (index buf 0)))
                                  (bits->f64 (load (index buf 1)))))
          (= nm "fabs")
            (f64-bits (interp.fabs (bits->f64 (load (index buf 0)))))
          (= nm "floor")
            (f64-bits (interp.floor (bits->f64 (load (index buf 0)))))
          (= nm "ceil")
            (f64-bits (interp.ceil (bits->f64 (load (index buf 0)))))
          (= nm "strtol")
            (interp.strtol (primitive/cast (ptr i8)
                                           (load (index buf 0)))
                           (primitive/cast (ptr (ptr i8))
                                           (load (index buf 1)))
                           (primitive/cast i32 (load (index buf 2))))
          (= nm "atoi")
            (primitive/cast i64
                            (interp.atoi (primitive/cast (ptr i8)
                                                         (load (index buf 0)))))
          ; not a libc builtin: if a meta extern hook is registered (meta execution), let
          ; it dispatch (e.g. the metashim mh_* callbacks into the compiler). Otherwise a
          ; genuinely unsupported extern is a hard error, as before.
          (let [hk (interp-extern-hook)]
            (if (!= (.isset hk) 0)
                (call-ptr (.fp hk) (data nm) (len nm) buf n)
                (do
                  (idie2 (if (nc-available?)
                             "extern has no C symbol in this process: "
                             "extern is not in the interpreter's built-in table (no native calls on this host): ")
                         nm)
                  0))))))

;; ============================ real atomics ===================================
; Interpreted programs run real threads (pthread_create goes to the native
; function), so the IR's atomics are performed atomically. Every width is done
; on the naturally aligned 8-byte word that contains it, with a compare-and-swap
; loop: correct for any mix of widths, since the hardware's atomics are
; coherent per byte. An aligned word never crosses a page, so reading the
; bytes beside a value is always safe.

(defn ia-word [(p i64)] (-> i64)
  (& p -8))

(defn ia-mask [(size i64)] (-> i64)
  (if (>= size 8) -1 (- (<< 1 (* size 8)) 1)))

;;; The `size`-byte value at `p` inside `word`'s bits, extended like mem-load.
(defn ia-extract [(word i64) (p i64) (size i64) (signed bool)] (-> i64)
  (if (>= size 8)
      word
      (let [shift (* (- p (ia-word p)) 8)
            v (& (>> word shift) (ia-mask size))
            bits (* size 8)]
        (if signed (>> (<< v (- 64 bits)) (- 64 bits)) v))))

(defn ia-insert [(word i64) (p i64) (size i64) (v i64)] (-> i64)
  (if (>= size 8)
      v
      (let [shift (* (- p (ia-word p)) 8)
            m (<< (ia-mask size) shift)]
        (| (& word (^ m -1)) (& (<< v shift) m)))))

(defn ia-load [(p i64) (size i64) (signed bool)] (-> i64)
  (ia-extract (atomic/read (primitive/cast (ptr i64) (ia-word p)))
              p
              size
              signed))

;;; Atomically replace the value at `p` with (f old v) and return the old value.
;;; `op` is an atomicrmw operation; `float` says the operands are f32/f64 bits.
(defn ia-rmw [(op (slice u8))
              (p i64)
              (v i64)
              (size i64)
              (signed bool)
              (float bool)] (-> i64)
  (let [wp (primitive/cast (ptr i64) (ia-word p))
        (mut result) 0]
    (loop (let [w (atomic/read wp)
                old (ia-extract w p size signed)
                new (ia-combine op old v size float)]
            (when (= (atomic/cas wp w (ia-insert w p size new)) w)
              (set! result old)
              (break))))
    result))

(defn ia-combine [(op (slice u8)) (old i64) (v i64) (size i64) (float bool)]
  (-> i64)
  (let [m (ia-mask size)
        uold (& old m)
        uv (& v m)
        bits (* size 8)
        sold (if (>= size 8) old (>> (<< old (- 64 bits)) (- 64 bits)))
        sv (if (>= size 8) v (>> (<< v (- 64 bits)) (- 64 bits)))]
    (cond float (ia-float-combine op old v size)
          (= op "xchg") v
          (= op "add") (+ old v)
          (= op "sub") (- old v)
          (= op "and") (& old v)
          (= op "or") (| old v)
          (= op "xor") (^ old v)
          (= op "nand") (^ (& old v) -1)
          (= op "max") (if (> sold sv) old v)
          (= op "min") (if (< sold sv) old v)
          ; unsigned: compare with the sign bit flipped
          (= op "umax") (if (> (^ uold (<< 1 63)) (^ uv (<< 1 63))) old v)
          (= op "umin") (if (< (^ uold (<< 1 63)) (^ uv (<< 1 63))) old v)
          (= op "uinc_wrap")
            (if (>= (^ uold (<< 1 63)) (^ uv (<< 1 63))) 0 (+ old 1))
          (= op "udec_wrap")
            (if (or (= uold 0) (> (^ uold (<< 1 63)) (^ uv (<< 1 63))))
                v
                (- old 1))
          :else (do (idie2 "llvm-ir: unsupported atomicrmw op: " op) 0))))

(defn ia-float-combine [(op (slice u8)) (old i64) (v i64) (size i64)] (-> i64)
  (if (= size 4)
      (let [a (bits->f32 old)
            b (bits->f32 v)]
        (f32->bits (cond (= op "xchg") b
                         (= op "fadd") (+ a b)
                         (= op "fsub") (- a b)
                         (= op "fmax") (interp-minmax32 true a b)
                         (= op "fmin") (interp-minmax32 false a b)
                         :else
                           (do
                             (idie2 "llvm-ir: unsupported atomicrmw op: " op)
                             a))))
      (let [a (bits->f64 old)
            b (bits->f64 v)]
        (f64-bits (cond (= op "xchg") b
                        (= op "fadd") (+ a b)
                        (= op "fsub") (- a b)
                        (= op "fmax") (interp-minmax64 true a b)
                        (= op "fmin") (interp-minmax64 false a b)
                        :else
                          (do
                            (idie2 "llvm-ir: unsupported atomicrmw op: " op)
                            a))))))

;;; cmpxchg: if the value at `p` equals `expected`, store `desired`. Returns the
;;; observed value; the caller compares it with `expected` for success.
(defn ia-cmpxchg [(p i64) (expected i64) (desired i64) (size i64) (signed bool)]
  (-> i64)
  (let [wp (primitive/cast (ptr i64) (ia-word p))
        m (ia-mask size)
        (mut result) 0]
    (loop (let [w (atomic/read wp)
                old (ia-extract w p size signed)]
            (if (!= (& old m) (& expected m))
                (do (set! result old) (break))
                (when (= (atomic/cas wp w (ia-insert w p size desired)) w)
                  (set! result old)
                  (break)))))
    result))

; ============================ inline LLVM-IR interpreter ====================
; The corpus' (primitive/llvm-ir …) bodies are straight-line SSA (slice / atomic / simd /
; mmio helpers). We INTERPRET them at runtime against the VM's real memory,
; mirroring codegen_a64's structural lowering exactly (same offsets, same lane
; math). Anything outside the implemented subset HARD-ERRORS with the line.
(defstruct InterpIrErrors [])

(impl irs/IrErrors InterpIrErrors
  (ir-error [(self InterpIrErrors) (message (slice u8)) (token (slice u8))]
    (-> i64)
    (idie2 message token)))

(defn istr->i64 [(s (slice u8))] (-> i64)
  (irs/integer (zeroed InterpIrErrors) s))

; parse a (possibly negative) plain-decimal float token — llvm-ir literals
; (`<float 0.0, float 1.0, ...>`). The corpus never uses exponents, so a small
; hand-rolled parser avoids pulling in an extra extern declaration.
(defn istr->f64 [(s (slice u8))] (-> f64)
  (irs/floating (zeroed InterpIrErrors) s))

; bit width of an int-ish Type, for canon-int/do-bin's packed `c` argument.
(defn ir-int-bits [(tp (ptr Type))] (-> i64)
  (match (load tp) (TInt [b _] b) (TBool [] 1) (_ 64)))

; scalar icmp: maps the llvm predicate onto a canon-int'd comparison. Values
; read from memory may carry stale bits above `bits` (mem-load reads raw
; bytes), so canon-int first re-derives the correct sign/zero-extended i64
; view before comparing — this also makes the unsigned predicates correct for
; narrower-than-64-bit values without needing register tricks.
(defn ir-icmp-scalar2! [(pred (slice u8)) (bits i64) (l i64) (r i64)] (-> i64)
  (let [sl (canon-int l bits true)
        sr (canon-int r bits true)]
    (cond (= pred "eq") (b01 (= sl sr))
          (= pred "ne") (b01 (!= sl sr))
          (= pred "slt") (b01 (< sl sr))
          (= pred "sle") (b01 (<= sl sr))
          (= pred "sgt") (b01 (> sl sr))
          (= pred "sge") (b01 (>= sl sr))
          (or (= pred "ult") (= pred "ule") (= pred "ugt") (= pred "uge"))
            (if (>= bits 64)
                (cond (= pred "ult") (b01 (ult l r))
                      (= pred "ule") (b01 (ule l r))
                      (= pred "ugt") (b01 (ugt l r))
                      :else (b01 (uge l r)))
                (let [ul (canon-int l bits false)
                      ur (canon-int r bits false)]
                  (cond (= pred "ult") (b01 (< ul ur))
                        (= pred "ule") (b01 (<= ul ur))
                        (= pred "ugt") (b01 (> ul ur))
                        :else (b01 (>= ul ur)))))
          :else (do (idie2 "llvm-ir: unsupported icmp predicate: " pred) 0))))

; i128 (our synthetic 16-byte TSlice blob, represented as an address here)
; only supports eq/ne, via a plain 16-byte memory compare.
(defn ir-icmp-i128-2! [(pred (slice u8)) (laddr i64) (raddr i64)] (-> i64)
  (unless (or (= pred "eq") (= pred "ne"))
    (idie2 "llvm-ir: unsupported i128 icmp predicate (only eq/ne supported): "
           pred))
  (let [eq
          (and (= (mem-load laddr 8 false) (mem-load raddr 8 false))
               (= (mem-load (primitive/iadd laddr 8) 8 false)
                  (mem-load (primitive/iadd raddr 8) 8 false)))]
    (b01 (if (= pred "eq") eq (not eq)))))

; scalar fcmp: only the ordered predicates (nothing in the corpus needs
; unordered/ord/uno). "one" (ordered-not-equal) = lt or gt, both of which are
; already false when either operand is NaN.
(defn ir-fcmp-scalar2! [(pred (slice u8)) (bits i64) (l i64) (r i64)] (-> i64)
  (if (= bits 32)
      (let [lf (bits->f32 l)
            rf (bits->f32 r)]
        (cond (= pred "oeq") (b01 (= lf rf))
              (= pred "one") (b01 (or (< lf rf) (> lf rf)))
              (= pred "olt") (b01 (< lf rf))
              (= pred "ole") (b01 (<= lf rf))
              (= pred "ogt") (b01 (> lf rf))
              (= pred "oge") (b01 (>= lf rf))
              :else (do (idie2 "llvm-ir: unsupported fcmp predicate: " pred) 0)))
      (let [lf (bits->f64 l)
            rf (bits->f64 r)]
        (cond (= pred "oeq") (b01 (= lf rf))
              (= pred "one") (b01 (or (< lf rf) (> lf rf)))
              (= pred "olt") (b01 (< lf rf))
              (= pred "ole") (b01 (<= lf rf))
              (= pred "ogt") (b01 (> lf rf))
              (= pred "oge") (b01 (>= lf rf))
              :else (do (idie2 "llvm-ir: unsupported fcmp predicate: " pred) 0)))))

; shared core for sext(0)/zext(1)/trunc(2): sext/zext widen by canonicalizing
; from the SOURCE width+signedness (a value already correctly sign/zero
; extended from bit srcbits-1 is automatically the correct wider-width
; representation too); trunc narrows to the destination width.
(defn ir-extend-op2! [(mode i64) (srcbits i64) (v i64) (dstbits i64)] (-> i64)
  (cond (= mode 0) (canon-int v srcbits true)
        (= mode 1) (canon-int v srcbits false)
        :else (canon-int v dstbits true)))

; shared core for fptosi/fptoui/sitofp/uitofp/fptrunc/fpext.
(defn ir-floatconv2! [(op (slice u8))
                      (v i64)
                      (slb i64)
                      (dlb i64)] (-> i64)
  (cond (= op "fptosi") (f2i v (primitive/imul dlb 8) 1 slb)
        (= op "fptoui") (f2i v (primitive/imul dlb 8) 0 slb)
        (= op "sitofp") (i2f (canon-int v (primitive/imul slb 8) true) dlb 1)
        (= op "uitofp") (i2f v dlb 0)
        :else (f2f v dlb slb)))

; bind an SSA name to a fresh value in ir-line!'s environment.
(defn ir-bind2! [(names (ptr (ArrayList (slice u8))))
                 (vals (ptr (ArrayList i64)))
                 (nm (slice u8))
                 (v i64)] (-> i64)
  (ir-env-put! names vals nm v))

; shufflevector's <N x i32> mask: either `zeroinitializer` (all N indices 0,
; a splat) or an explicit `<i32 IDX0, i32 IDX1, ...>` literal — indices are
; always compile-time-known integer literals in the corpus, never a %name.
(defn ir-shuffle-mask2! [(a (dyn Allocator))
                         (toks (ptr (ArrayList (slice u8))))
                         (tokp (ptr i64))
                         (n i64)]
  (-> (ptr (ArrayList i64)))
  (irs/read-mask a (zeroed InterpIrErrors) toks tokp n))

; tokenizer: split on whitespace and commas; '{','}','<','>','(',')' self-delimit.
(defn ir-tokens2 [(a (dyn Allocator)) (line (slice u8))]
  (-> (ptr (ArrayList (slice u8))))
  (irs/tokenize a line))

(defn irtok [(toks (ptr (ArrayList (slice u8)))) (i i64)] (-> (slice u8))
  (get (load toks) i))

; All state for one inline-IR invocation. Syntax reads stay interleaved with
; value resolution and allocation; helpers borrow this context and its original
; mutable environment rather than reconstructing a parameter bundle per call.
(defstruct IrContext
  [(cx (ptr Interp))
   (a (dyn Allocator))
   (names (ptr (ArrayList (slice u8))))
   (vals (ptr (ArrayList i64)))
   (args (ptr i64))
   (argtys (ptr (ArrayList Type)))
   (result Type)
   (fm (ptr FrameMem))])

; parse an IR type token (context: result + arg types); advances *tokp past it.
(defn ir-parse-type2 [(irctx (ref IrContext))
                      (toks (ptr (ArrayList (slice u8))))
                      (tokp (ptr i64))] (-> Type)
  (let [a (.a irctx)
        result (.result irctx)
        argtys (.argtys irctx)]
    (let [context
            (irs/TypeContext
              :allocator a
              :result result
              :arguments argtys
              :errors (zeroed InterpIrErrors))]
      (irs/read-type context toks tokp))))

; aggregate element (offset, elem type) for extract/insert.
(defn ir-agg-elem2 [(cx (ptr Interp))
                    (tp (ptr Type))
                    (idx i64)
                    (offp (ptr i64))] (-> Type)
  (match (load tp)
    (TSlice [elem]
            (if (= idx 0)
                (do (set! offp 0) (TPtr elem))
                (do
                  (set! offp 8)
                  (TInt 64 true))))
    (TStruct [nm]
             (let [si (istruct-idx cx nm)]
               (when (< si 0)
                 (idie2 "llvm-ir: extract from unknown struct " nm)
                 0)
               (set! offp (ifield-off cx si idx))
               (.ty (ial-at [Field]
                            (load (field (struct-at (field cx layouts) si)
                                         fields))
                            idx))))
    (_ (do
         (idie "llvm-ir: extract/insert on unsupported aggregate")
         (TInt 64 true)))))

; resolve a VALUE token: %name (env), $N (arg), undef/zeroinitializer (fresh slot),
; integer literal. `tp` is the value's type context (for undef/zero slot sizing).
(defn ir-value2 [(irctx (ref IrContext)) (tk (slice u8)) (tp (ptr Type))]
  (-> i64)
  (let [cx (.cx irctx)
        names (.names irctx)
        vals (.vals irctx)
        args (.args irctx)
        fm (.fm irctx)]
    (let [c0 (primitive/cast i64 (get tk 0))]
      (cond (= c0 37)  ; %
              (ir-env-get names vals tk)
            (= c0 36)  ; $N  (value arg)
              (load (index args (istr->i64 (subslice tk 1 (len tk)))))
            (or (= tk "undef") (= tk "poison"))
              (frame-alloc fm (isize-of cx tp) (ialign-of cx tp))
            ; fresh, uninitialized slot (poison is a stricter undef; a fresh
            ; garbage slot is a valid choice for both here)
            (= tk "zeroinitializer")
              (let [addr (frame-alloc fm (isize-of cx tp) (ialign-of cx tp))]
                (do (memzero addr (isize-of cx tp)) addr))
            (= tk "true") 1  ; i1 literal, e.g. inside a <...> mask
            (= tk "false") 0
            (ty-is-float2 tp)  ; float literal, e.g. `float 1.0` inside a <...> literal
              (if (= (isize-of cx tp) 4)
                  (f32->bits (primitive/cast f32 (istr->f64 tk)))
                  (f64-bits (istr->f64 tk)))
            :else
              ; A bare integer literal against a type wider than 8 bytes (the i128
              ; marker) is a memory value: the literal in the low word and its sign
              ; extension in every byte above it.
              (if (> (isize-of cx tp) 8)
                  (let [size (isize-of cx tp)
                        value (istr->i64 tk)
                        addr (frame-alloc fm size (ialign-of cx tp))]
                    (memzero addr size)
                    (mem-store addr value 8)
                    (when (< value 0)
                      (for at (range 8 size) (mem-store (+ addr at) -1 1)))
                    addr)
                  (istr->i64 tk))))))

; an inline vector-constant literal: `< TY V0, TY V1, ... >`, tokp on entry
; pointing at "<". Used pervasively as an operand throughout the corpus (icmp/
; select/shl/or/fadd comparands and shuffle index masks) — always homogeneous,
; always plain per-element literals (never %name/$N).
(defn ir-lit-vec2! [(irctx (ref IrContext))
                    (toks (ptr (ArrayList (slice u8))))
                    (tokp (ptr i64))
                    (tp (ptr Type))] (-> i64)
  (let [cx (.cx irctx)
        fm (.fm irctx)]
    (set! tokp (primitive/iadd (load tokp) 1))  ; skip "<"
    (match (load tp)
      (TVec [elemp lanes]
            (let [lb (isize-of cx elemp)
                  dslot (frame-alloc fm (isize-of cx tp) (ialign-of cx tp))]
              (for [k 0 (extent-value lanes)]
                (let [(mut etp)
                        (: (ir-parse-type2 irctx toks tokp)
                           Type)]
                  (let [ev
                          (ir-value2 irctx
                                     (irtok toks (load tokp))
                                     (mut etp))]
                    (set! tokp (primitive/iadd (load tokp) 1))
                    (mem-store (primitive/iadd dslot
                                               (primitive/imul k
                                                               lb))
                               ev
                               lb))))
              (set! tokp (primitive/iadd (load tokp) 1))  ; skip ">"
              dslot))
      (_ (do (idie "llvm-ir: vector literal on non-vector type") 0)))))

; resolve a value token at the current stream position, advancing tokp past
; it — either a single token (the common case, same as ir-value2) or a whole
; inline vector literal (ir-lit-vec2!, several tokens).
(defn ir-value2-adv! [(irctx (ref IrContext))
                      (toks (ptr (ArrayList (slice u8))))
                      (tokp (ptr i64))
                      (tp (ptr Type))] (-> i64)
  (if (= (irtok toks (load tokp)) "<")
      (ir-lit-vec2! irctx toks tokp tp)
      (let [v (ir-value2 irctx (irtok toks (load tokp)) tp)]
        (set! tokp (primitive/iadd (load tokp) 1))
        v)))

(defn ir-env-get [(names (ptr (ArrayList (slice u8))))
                  (vals (ptr (ArrayList i64)))
                  (nm (slice u8))] (-> i64)
  (let [n (len (load names))
        (mut i) (primitive/isub n 1)
        (mut r) 0]
    (loop (if (< (load i) 0)
              (break)
              (do
                (when (= (get (load names) (load i)) nm)
                  (set! r (get (load vals) (load i)))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (load r)))

(defn ir-env-put! [(names (ptr (ArrayList (slice u8))))
                   (vals (ptr (ArrayList i64)))
                   (nm (slice u8))
                   (v i64)] (-> i64)
  (push! (mut names) nm)
  (push! (mut vals) v)
  0)

; store scalar/aggregate cell `v` of type tp at absolute address `dst`.
(defn ir-store-at [(cx (ptr Interp)) (dst i64) (v i64) (tp (ptr Type))] (-> i64)
  (if (ty-is-agg tp)
      (memcopy dst v (isize-of cx tp))
      (mem-store dst v (isize-of cx tp)))
  0)

; per-lane float binop over vec addresses (op 0 add 1 sub 2 mul). lb = lane bytes.
(defn ir-vec-fbin [(op i64)
                   (dst i64)
                   (asrc i64)
                   (bsrc i64)
                   (lanes i64)
                   (lb i64)] (-> i64)
  (let []
    (for [k 0 lanes]
      (let [av
              (mem-load (primitive/iadd asrc
                                        (primitive/imul k lb))
                        lb
                        false)
            bv
              (mem-load (primitive/iadd bsrc
                                        (primitive/imul k lb))
                        lb
                        false)
            rv
              (if (= lb 4)
                  (f32->bits (cond (= op 0) (+ (bits->f32 av) (bits->f32 bv))
                                   (= op 1) (- (bits->f32 av) (bits->f32 bv))
                                   (= op 2) (* (bits->f32 av) (bits->f32 bv))
                                   (/ (bits->f32 av) (bits->f32 bv))))
                  (f64-bits (cond (= op 0) (+ (bits->f64 av) (bits->f64 bv))
                                  (= op 1) (- (bits->f64 av) (bits->f64 bv))
                                  (= op 2) (* (bits->f64 av) (bits->f64 bv))
                                  (/ (bits->f64 av) (bits->f64 bv)))))]
        (mem-store (primitive/iadd dst (primitive/imul k lb))
                   rv
                   lb)))
    0))

; interpret ONE IR line; on `ret` writes *retvalp and sets *donep.
(defn ir-line! [(irctx (ref IrContext))
                (retvalp (ptr i64))
                (donep (ptr bool))
                (line (slice u8))] (-> i64)
  (let [cx (.cx irctx)
        a (.a irctx)
        names (.names irctx)
        vals (.vals irctx)
        fm (.fm irctx)]
    (let [toks (ir-tokens2 a line)
          ntk (len (load toks))]
      (unless (= ntk 0)
        (let [t0 (irtok toks 0)]
          (cond (= t0 "declare") 0
                ; `call void @llvm.trap()` then `unreachable`: stop at a trap instruction.
                (and (= t0 "call")
                     (and (>= ntk 3) (= (irtok toks 2) "@llvm.trap")))
                  (do (idie "llvm.trap: the program reached a trap") 0)
                (= t0 "unreachable") (do (set! donep true) 0)
                (= t0 "ret")
                  (let [(mut tokp) 1
                        (mut rtp)
                          (: (ir-parse-type2 irctx toks (mut tokp))
                             Type)]
                    (set! retvalp
                          (ir-value2 irctx (irtok toks tokp) (mut rtp)))
                    (set! donep true)
                    0)
                (= t0 "store")  ; store atomic TYPE VAL, ptr PTR seq_cst, align N   (sequential model)
                  (if (and (>= ntk 7)
                           (= (irtok toks 1) "atomic"))
                      (let [(mut tokp) 2
                            (mut vtp)
                              (: (ir-parse-type2 irctx toks (mut tokp))
                                 Type)]
                        (let [v (ir-value2 irctx (irtok toks tokp) (mut vtp))
                              (mut ptp)
                                (: (TPtr (box-type a (TInt 8 true))) Type)]
                          (let [p
                                  (ir-value2 irctx
                                             (irtok toks
                                                    (primitive/iadd tokp 2))
                                             (mut ptp))]
                            (ia-rmw "xchg"
                                    p
                                    v
                                    (isize-of cx (mut vtp))
                                    false
                                    false)
                            0)))
                      ; plain (non-atomic) form: store TYPE VAL, ptr PTR, align N
                      (let [(mut tokp) 1
                            (mut vtp)
                              (: (ir-parse-type2 irctx toks (mut tokp))
                                 Type)]
                        (let [v (ir-value2-adv! irctx toks (mut tokp) (mut vtp))]
                          (set! tokp (primitive/iadd tokp 1))
                          ; skip "ptr"
                          (let [(mut ptp)
                                  (: (TPtr (box-type a (TInt 8 true))) Type)]
                            (let [p
                                    (ir-value2-adv! irctx
                                                    toks
                                                    (mut tokp)
                                                    (mut ptp))]
                              (ir-store-at cx p v (mut vtp))
                              0)))))
                (and (>= ntk 3)
                     (= (primitive/cast i64 (get t0 0)) 37))
                  (let [op (irtok toks 2)]
                    (cond (= op "extractvalue")
                            (let [(mut tokp) 3
                                  (mut aggtp)
                                    (: (ir-parse-type2 irctx toks (mut tokp))
                                       Type)]
                              (let [aggv
                                      (ir-value2 irctx
                                                 (irtok toks tokp)
                                                 (mut aggtp))
                                    idx
                                      (istr->i64 (irtok toks
                                                        (primitive/iadd tokp 1)))
                                    (mut offp) (zeroed i64)
                                    (mut etp)
                                      (: (ir-agg-elem2 cx
                                                       (mut aggtp)
                                                       idx
                                                       (mut offp))
                                         Type)]
                                (if (ty-is-agg (mut etp))
                                    (let [ns
                                            (frame-alloc fm
                                                         (isize-of cx (mut etp))
                                                         (ialign-of cx
                                                                    (mut etp)))]
                                      (memcopy ns
                                               (primitive/iadd aggv offp)
                                               (isize-of cx (mut etp)))
                                      (ir-env-put! names vals t0 ns))
                                    (ir-env-put! names
                                                 vals
                                                 t0
                                                 (mem-load (primitive/iadd aggv
                                                                           offp)
                                                           (isize-of cx
                                                                     (mut etp))
                                                           (signed-of (mut etp)))))
                                0))
                          (= op "insertvalue")
                            (let [(mut tokp) 3
                                  (mut aggtp)
                                    (: (ir-parse-type2 irctx toks (mut tokp))
                                       Type)]
                              (let [aggtk (irtok toks tokp)]
                                (set! tokp (primitive/iadd tokp 1))
                                (let [aggv (ir-value2 irctx aggtk (mut aggtp))
                                      (mut eltp)
                                        (: (ir-parse-type2 irctx
                                                           toks
                                                           (mut tokp))
                                           Type)]
                                  (let [elv
                                          (ir-value2 irctx
                                                     (irtok toks tokp)
                                                     (mut eltp))
                                        idx
                                          (istr->i64 (irtok toks
                                                            (primitive/iadd tokp
                                                                            1)))
                                        dslot
                                          (frame-alloc fm
                                                       (isize-of cx (mut aggtp))
                                                       (ialign-of cx
                                                                  (mut aggtp)))
                                        (mut offp) (zeroed i64)]
