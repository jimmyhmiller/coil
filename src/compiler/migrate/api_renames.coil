(defn api-renames [] (-> (slice ApiRename))
  API-RENAMES)

;;; A removed name its module provided to coil.core. See the header.
(defstruct ApiAmbient [(module (slice u8)) (old (slice u8))])

(def API-AMBIENT [(ApiAmbient :module "coil.fmt" :old "formatter-write")
                  (ApiAmbient :module "coil.fmt" :old "formatter-writer")
                  (ApiAmbient :module "coil.fmt" :old "formatter-pretty?")
                  (ApiAmbient :module "coil.fmt" :old "formatter-disarm!")
                  (ApiAmbient :module "coil.fmt" :old "formatter-take-spec!")])

(defn api-ambient [] (-> (slice ApiAmbient))
  API-AMBIENT)

;;; Where a fully dotted name, `coil.mod.name`, divides its module from its name:
;;; the index of its last `.`, or -1 for any other symbol. A template writes a
;;; module's function this way to name it from whatever module expands it, with no
;;; import there. A `/`-qualified name, an `Owner::name`, a field accessor `.x`
;;; and a name ending in `.` are not dotted names.
(defn api-module-dot [(text (slice u8))] (-> i64)
  (let [n (len text)
        (mut dot) -1
        (mut other) false]
    (for [i 0 n]
      (let [c (cast i64 (get text i))]
        (cond (= c 46) (set! dot i)
              (= c 47) (set! other true)
              (and (= c 58) (< (+ i 1) n) (= (cast i64 (get text (+ i 1))) 58))
                (set! other true)
              :else 0))
      0)
    (if (or other (<= dot 0) (= dot (- n 1))) -1 dot)))

;;; The row of the removed name TEXT spells fully dotted (`api-module-dot`), or -1.
(defn api-dotted-rename-index [(text (slice u8))] (-> i64)
  (let [dot (api-module-dot text)]
    (if (< dot 0)
        -1
        (api-rename-index (subslice text 0 dot)
                          (subslice text (+ dot 1) (len text))))))

;;; The row for MODULE's removed NAME, as an index into `api-renames`, or -1.
(defn api-rename-index [(module (slice u8)) (name (slice u8))] (-> i64)
  (let [rows (api-renames)
        (mut at) -1]
    (for [i 0 (len rows)]
      (let [r (get rows i)]
        (when (and (< at 0)
                   (= (.old r) name)
                   (api-module-reaches? module (.module r) name))
          (set! at i)
          0))
      0)
    at))

;;; A module that re-exports another's names. See the header.
(defstruct ApiReexport
  [(module (slice u8)) (from (slice u8)) (names (slice (slice u8)))])

;; BEGIN GENERATED API-REEXPORTS -- regenerate with scripts/compiler/gen-stdlib-manifest.py
(def API-REEXPORTS [(ApiReexport
                      :module "coil.debug"
                      :from "coil.fmt"
                      :names [])
                    (ApiReexport
                      :module "coil.debug"
                      :from "coil.derive"
                      :names [])
                    (ApiReexport
                      :module "coil.http.parser"
                      :from "coil.http.parser.types"
                      :names ["Parser" "Settings"])
                    (ApiReexport
                      :module "coil.jit"
                      :from "coil.compiler.jit_api"
                      :names [])
                    (ApiReexport
                      :module "coil.process"
                      :from "coil.subprocess"
                      :names [])
                    (ApiReexport
                      :module "coil.prop"
                      :from "coil.prop.source"
                      :names
                        ["Source"
                         "src-alloc"
                         "src-size"
                         "src-depth"
                         "src-max-depth"
                         "src-fuel"
                         "src-spend-fuel!"
                         "src-restore-fuel!"
                         "src-reject!"
                         "src-target!"
                         "src-showing?"
                         "span-open!"
                         "span-close!"
                         "draw-int!"
                         "draw-int-origin!"
                         "draw-int-any!"
                         "draw-len!"
                         "draw-tag!"
                         "draw-bool!"
                         "draw-bool-p!"
                         "draw-float!"
                         "SPAN-PLAIN"
                         "SPAN-ELEM"
                         "SPAN-NODE"
                         "SPAN-ATOMIC"])
                    (ApiReexport
                      :module "coil.prop"
                      :from "coil.prop.arbitrary"
                      :names [])
                    (ApiReexport
                      :module "coil.prop"
                      :from "coil.prop.stateful"
                      :names ["defprop-stateful"])
                    (ApiReexport
                      :module "coil.prop.derive"
                      :from "coil.derive"
                      :names
                        ["derive-impl" "derive-type-name" "derive-type-param?"])
                    (ApiReexport
                      :module "coil.serde.derive"
                      :from "coil.derive"
                      :names ["derive-impl" "derive-type-name"])])

;; END GENERATED API-REEXPORTS

;;; Does the re-export R pass on FROM's NAME?
(defn api-reexport-passes? [(r ApiReexport) (name (slice u8))] (-> bool)
  (let [(mut passes) (= (len (.names r)) 0)]
    (for [i 0 (len (.names r))]
      (when (= (get (.names r) i) name) (set! passes true) 0)
      0)
    passes))

;;; A module whose names a migrated call writes through an alias. See the header.
(defstruct ApiAlias [(module (slice u8)) (alias (slice u8))])

(def API-ALIASES [(ApiAlias :module "coil.prop.gen" :alias "gen")])

;;; The alias MODULE's names are written through when an import has to be added for
;;; them, or "" for a module whose names are brought in by name.
(defn api-module-alias [(module (slice u8))] (-> (slice u8))
  (let [(mut out) ""]
    (for [i 0 (len API-ALIASES)]
      (let [r (get API-ALIASES i)]
        (when (and (= (len out) 0) (= (.module r) module))
          (set! out (.alias r))
          0))
      0)
    out))

;;; Does an import of MODULE reach TARGET's NAME: is MODULE TARGET, or a module that
;;; re-exports NAME from it?
(defn api-module-reaches? [(module (slice u8))
                           (target (slice u8))
                           (name (slice u8))] (-> bool)
  (let [(mut reaches) (= module target)]
    (for [i 0 (len API-REEXPORTS)]
      (let [r (get API-REEXPORTS i)]
        (when (and (= (.module r) module)
                   (= (.from r) target)
                   (api-reexport-passes? r name))
          (set! reaches true)
          0))
      0)
    reaches))

;;; The modules that lost names, each once.
(defn api-renamed-modules [(a (dyn Allocator))]
  (-> (ptr (ArrayList (slice u8))))
  (let [out (box! a (ArrayList (slice u8)) (ArrayList::new [(slice u8)] a))
        rows (api-renames)]
    (for [i 0 (len rows)]
      (let [m (.module (get rows i))
            (mut seen) false]
        ; rows come grouped by module, so the last one seen is nearly always it
        (for [k 0 (len (load out))]
          (when (and (not seen)
                     (= (get (load out) (- (- (len (load out)) 1) k)) m))
            (set! seen true)
            0)
          0)
        (unless seen (push! out m) 0))
      0)
    ; and the modules that re-export one of the removed names
    (for [i 0 (len API-REEXPORTS)]
      (let [r (get API-REEXPORTS i)
            (mut lost) false]
        (for [k 0 (len rows)]
          (let [row (get rows k)]
            (when (and (= (.module row) (.from r))
                       (api-reexport-passes? r (.old row)))
              (set! lost true)
              0))
          0)
        (when lost (push! out (.module r)) 0))
      0)
    out))

;;; What the removed name is now, for messages.
(defn api-rename-describe [(a (dyn Allocator)) (row ApiRename)] (-> (slice u8))
  (match (.change row)
    (Renamed [name] (sconcat3 a "`" name "`"))
    (TraitCall [_ trait name]
               (sconcat3 a
                         (sconcat3 a "`" name "`, the method of the ")
                         trait
                         " trait"))
    (MethodCall [_ type name]
                (sconcat3 a (sconcat3 a "`" name "`, a method on ") type ""))
    (TypeCall [_ type name] (sconcat3 a (sconcat3 a "`" type "::") name "`"))
    (FunctionCall [home name]
                  (sconcat3 a (sconcat3 a "`" name "` from ") home ""))))

(defn api-rename-note [(a (dyn Allocator)) (row ApiRename)] (-> (slice u8))
  (sconcat3 a
            (sconcat3 a "`" (.old row) "` was removed from ")
            (.module row)
            (sconcat a "; it is " (api-rename-describe a row))))

;;; The note a diagnostic about MODULE's missing NAME adds when the table says it was
;;; removed, or "". An empty MODULE matches a removed NAME of any module, and a NAME
;;; written fully dotted (`coil.mod.old`) the module it names.
(defn api-rename-hint [(a (dyn Allocator))
                       (module (slice u8))
                       (name (slice u8))] (-> (slice u8))
  (let [rows (api-renames)
        dotted (if (= (len module) 0) (api-dotted-rename-index name) -1)
        (mut at) dotted]
    (for [i 0 (len rows)]
      (let [r (get rows i)]
        (when (and (< at 0)
                   (= (.old r) name)
                   (or (= (len module) 0)
                       (api-module-reaches? module (.module r) name)))
          (set! at i)
          0))
      0)
    (if (< at 0)
        ""
        (sconcat a
                 (api-rename-note a (get rows at))
                 "; `coil lint --fix` rewrites the program to use it"))))
