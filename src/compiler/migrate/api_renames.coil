; The standard-library names that were removed when a namespace's module-prefixed
; functions became methods and traits (`hm-put!` -> `set!`), and what each became.
; It is data: coil.compiler.api_migration rewrites a program from it (the syntax
; preflight of `coil lint --fix`), breaking_changes.coil asks it whether a build
; should point at that fix, and the resolver's diagnostics for a missing name say
; what replaced it.
;
; ---- Renaming a stdlib API? Add rows to API-RENAMES below. ----------------------
;
; One row per public name the namespace no longer has, and nothing else: nothing
; outside this table changes. A row says which module the old name lived in, what a
; call to it becomes, and whether an explicit type-argument vector written right
; after the old name is dropped:
;
;   ["coil.hashmap"
;     ["hm-put!" :trait "coil.core" "Set" "set!" true]]
;
; Groups start with the former module. Each row is [OLD KIND ... DROP-TYPE-ARGS]:
;   :trait, :method, :type: [OLD KIND HOME OWNER NAME DROP] or
;                          [OLD KIND OWNER NAME DROP] when HOME is this module.
;   :renamed:              [OLD :renamed NAME DROP]
;   :function:             [OLD :function HOME NAME DROP]
;
; The change is one of:
;
;   (TraitCall HOME TRAIT NAME)  a trait method: `(hm-put! m k v)` -> `(set! m k v)`.
;   (MethodCall HOME TYPE NAME)  a method on a type: `(hm-free! (mut m))` -> `(free! (mut m))`.
;   (TypeCall HOME TYPE NAME)    a method with no receiver: `(hm-new [K V] a ops)` ->
;                                `(HashMap::new [K V] a ops)`. TYPE is brought into
;                                scope where it is needed.
;   (Renamed NAME)               the same function or macro under a new name in the
;                                same module: `(hm-for [k v m] …)` -> `(for-entries [k v m] …)`.
;   (FunctionCall HOME NAME)     a function, macro or type another module declares:
;                                `(al-empty? xs)` -> `(empty? xs)`. NAME is brought into
;                                scope where it is needed, and is written the same way
;                                where the old name is a value or a type.
;
; HOME is the module that declares TRAIT, TYPE or NAME ("coil.core" for the ambient
; traits and functions), or "" for a built-in type such as `slice`, which no module
; declares and every module can name. A trait or method call is written with the bare NAME, which the receiver
; dispatches; where a binding around the call, a definition of the file's own, or
; an import could capture that name, it is written `TRAIT::NAME` or `TYPE::NAME`.
; Set the final DROP-TYPE-ARGS flag when the old function took explicit type arguments that the
; receiver now supplies (trait and method calls of a generic function, or a generic
; function that infers them); leave it false for a TypeCall, whose type takes them,
; for a Renamed function, and for a macro, whose first argument may be a vector.
;
; A removed name its module provided to coil.core (its `provide-core` list) was in
; every module's scope with no import. List it in API-AMBIENT as well as giving it a
; row, so that the migration rewrites its bare uses in files that never import the
; module.
;
; A module that re-exports another's names (`(import "FROM" … :reexport)`) gives a
; file that imports it the removed names of FROM as well, and the rows of FROM apply
; through it. API-REEXPORTS records every such import in the library: a re-export
; passes on only what its import refers, so a row holds the import's `:use` list in
; `names`, empty for `:use *` or no `:use`, which pass on every name. It is
; generated from the library's own imports: after changing a `:reexport`, run
; `python3 scripts/compiler/gen-stdlib-manifest.py` (COMPREHENSIVE checks it).
;
; A module whose replacement names are generic words (`int`, `map`) is listed in
; API-ALIASES with the alias it reads best through. Where a migrated call needs one
; of its names and no import of the module reaches it, the migration adds
; `(import "MODULE" :as ALIAS)` and writes `ALIAS/NAME`, rather than an import that
; lists NAME, which would shadow core's function of that name in the whole file.
;
; A name that was removed with no public replacement has no row: there is nothing to
; rewrite it to. When a namespace's names are removed, also delete any
; coil.lint.modernize rule that rewrites them: this table replaces it.
;
; Check a new batch by running the candidate's `coil lint --fix` on code written
; against the old names (`git show <commit>^:<file>`) and building the result.
(module coil.compiler.api_renames)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [Allocator box!])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "coil.compiler.parser" :use [sconcat sconcat3])

;;; What a call to a removed name becomes. See the header.
(defsum ApiChange
  (TraitCall [(home (slice u8)) (trait (slice u8)) (name (slice u8))])
  (MethodCall [(home (slice u8)) (type (slice u8)) (name (slice u8))])
  (TypeCall [(home (slice u8)) (type (slice u8)) (name (slice u8))])
  (Renamed [(name (slice u8))])
  (FunctionCall [(home (slice u8)) (name (slice u8))]))

;;; One removed public name. See the header.
(defstruct ApiRename
  [(module (slice u8))
   (old (slice u8))
   (change ApiChange)
   (drop-type-args bool)])

; The authoring table groups names by their former module. Optional HOME in
; method/type/trait rows defaults to that module; the expanded value remains a
; flat array of ApiRename records for every consumer.
(defn api-rename-string [(value Code)] (-> Code)
  (if (not (p/code-string? value))
      (p/error "api-renames-table: expected a string literal")
      0)
  value)

(defn api-rename-row [(module Code) (row Code)] (-> Code)
  (if (or (not (p/code-vector? row)) (< (p/code-count row) 4))
      (p/error "api-renames-table: expected [OLD KIND ... DROP-TYPE-ARGS]")
      0)
  (let [n (p/code-count row)
        old (api-rename-string (p/code-nth row 0))
        kind (p/code-nth row 1)
        drop (p/code-nth row (- n 1))
        change
          (cond (= kind `:renamed)
                  (do
                    (if (not (= n 4))
                        (p/error "api-renames-table: expected [OLD :renamed NAME DROP]")
                        0)
                    (let [name (api-rename-string (p/code-nth row 2))]
                      `(Renamed ~name)))
                (= kind `:function)
                  (do
                    (if (not (= n 5))
                        (p/error "api-renames-table: expected [OLD :function HOME NAME DROP]")
                        0)
                    (let [home (api-rename-string (p/code-nth row 2))
                          name (api-rename-string (p/code-nth row 3))]
                      `(FunctionCall :home ~home :name ~name)))
                (or (= kind `:method) (= kind `:type) (= kind `:trait))
                  (do
                    (if (not (or (= n 5) (= n 6)))
                        (p/error "api-renames-table: expected [OLD KIND [HOME] OWNER NAME DROP]")
                        0)
                    (let [home
                            (if (= n 6)
                                (api-rename-string (p/code-nth row 2))
                                module)
                          owner (api-rename-string (p/code-nth row (- n 3)))
                          name (api-rename-string (p/code-nth row (- n 2)))]
                      (cond (= kind `:method)
                              `(MethodCall
                                 :home ~home
                                 :type ~owner
                                 :name ~name)
                            (= kind `:type)
                              `(TypeCall
                                 :home ~home
                                 :type ~owner
                                 :name ~name)
                            :else
                              `(TraitCall
                                 :home ~home
                                 :trait ~owner
                                 :name ~name))))
                :else
                  (do
                    (p/error "api-renames-table: unknown replacement kind")
                    `0))]
    (if (not (or (= drop `true) (= drop `false)))
        (p/error "api-renames-table: DROP must be true or false")
        0)
    `(ApiRename
       :module ~module
       :old ~old
       :change ~change
       :drop-type-args ~drop)))

(defn api-renames-table [& (groups Code)] (-> Code)
  (let [rows (p/code-list-new)]
    (for [i 0 (p/code-count groups)]
      (let [group (p/code-nth groups i)]
        (if (or (not (p/code-vector? group)) (< (p/code-count group) 2))
            (p/error "api-renames-table: expected [MODULE ROW ...]")
            0)
        (let [module (api-rename-string (p/code-nth group 0))]
          (for [j 1 (p/code-count group)]
            (p/code-list-push! rows
                               (api-rename-row module (p/code-nth group j)))))))
    `[~@(p/code-list-done rows)]))

(def API-RENAMES
  (api-renames-table ["coil.hashmap"
                      ; ---- coil.hashmap (05ef88ca) ----
                      ["hm-new" :type "HashMap" "new" false]
                      ["hm-new-scalar" :type "HashMap" "new-scalar" false]
                      ["hm-put!" :trait "coil.core" "Set" "set!" true]
                      ["hm-get" :trait "coil.core" "Get" "get" true]
                      ["hm-len" :trait "coil.core" "Len" "len" true]
                      ["hm-contains?" :method "HashMap" "contains?" true]
                      ["hm-remove!" :method "HashMap" "remove!" true]
                      ["hm-clear!" :method "HashMap" "clear!" true]
                      ["hm-free!" :method "HashMap" "free!" true]
