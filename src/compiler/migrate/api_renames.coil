                      ["al-push!" :trait "coil.core" "Push" "push!" true]
                      ["al-pop!" :trait "coil.core" "Pop" "pop!" true]
                      ["al-empty?" :function "coil.core" "empty?" true]
                      ["al-for" :function "coil.core" "for-in" false]
                      ["al-cap" :method "ArrayList" "cap" true]
                      ["al-elem" :method "ArrayList" "elem" true]
                      ["al-reserve!" :method "ArrayList" "reserve!" true]
