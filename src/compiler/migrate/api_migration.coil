; Source migration for standard-library names that were removed when a namespace's
; module-prefixed functions became methods and traits. The table of what was
; removed, and how to add to it, is coil.compiler.api_renames; this is the rewrite.
;
; A program that still calls a removed name does not load, so this works on read
; syntax, before loading: `prelint-run` in driver.coil applies the edits as part of
; `coil lint --fix`, and breaking_changes.coil asks `ar-breaking?` so that building
; such a project points at the fix.
;
; What the migration does with a file (`ar-migrate`): every spelling of an old name
; (bare through `:use [names]`, `:use *` or `:rename`; `alias/name`; `module/name`)
; is rewritten, and the lines aligned with a rewritten call's arguments move with
; them. Old names leave `:use`, `:exclude` and `:rename` lists, a type a call needs
; is added to the `:use` list it came through (or to a new import), and an import
; left with nothing to bring in is deleted. A removed name its module provided to
; coil.core (the table's API-AMBIENT) is also rewritten where it is written bare with
; no import, as every file reached it. So is an old name written fully dotted,
; `coil.mod.old`, which reaches the module with no import: a macro's template names
; a function that way so that it resolves from whatever module expands it, and its
; replacement is written so that it needs no import either (`ar-dotted-head`). A
; renamed function reached through a `:use [names]` list whose new name the file
; already uses for something else (core's `count`, a local) is written qualified,
; `coil.args/count`, and does not join the list, which would take that name from
; the file's other uses. A use it cannot rewrite (an old name passed as a value, or
; called with named arguments) is a finding, and the file is left for the author.
; Quoted data names nothing and is left alone. Quasiquoted code is migrated as
; code, but a symbol there that only a hand could rewrite is a note, not a finding:
; a macro often compares the names it finds rather than calling them, and if the
; template does emit it, compiling the expansion says so.
(module coil.compiler.api_migration)
(import "coil.compiler.text" :as text)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use [subslice])
(import "coil.reader" :use *)
(import "coil.compiler.parser"
        :use
        [sx-lo sx-hi box-al new-boxed-list sconcat sconcat3])
(import "coil.compiler.api_renames"
        :use
        [ApiRename ApiChange ApiAmbient api-ambient api-renames api-rename-index
         api-dotted-rename-index api-module-dot api-module-reaches?
         api-module-alias api-renamed-modules api-rename-note])
(import "coil.hashmap" :use [HashMap])
(import "coil.str" :use [keyops-borrowed])
(import "coil.compiler.generic_migration"
        :use
        [GmFile GmImport gm-read-file gm-refers gm-local-of gm-names-contain?
         gm-head gm-count gm-at gm-text gm-list? gm-vec? gm-sym? gm-kw?
         gm-find-slash])

(defn ar-row [(i i64)] (-> ApiRename)
  (get (api-renames) i))

; ---- results ----------------------------------------------------------------------

;;; Replace source bytes [lo, hi) with `text`. `note` is the warning the preflight
;;; prints for it, "" for an edit that only follows from another (a dropped type
;;; argument vector, the re-indented lines of a call whose head changed length).
(defstruct ArEdit [(lo i64) (hi i64) (text (slice u8)) (note (slice u8))])

;;; A use of a removed name the migration cannot rewrite (a finding), or one it
;;; leaves as written without knowing that it must (a note).
(defstruct ArFinding [(lo i64) (message (slice u8))])

;;; `findings` stop the file's migration: the file cannot load as written, and the
;;; rewrite cannot make it. `notes` do not: each is a symbol in quasiquoted code
;;; that names a removed function only if the template emits it as code.
(defstruct ArResult
  [(edits (ptr (ArrayList ArEdit)))
   (findings (ptr (ArrayList ArFinding)))
   (notes (ptr (ArrayList ArFinding)))])

; ---- one file -----------------------------------------------------------------------

;;; A name a migrated call needs in scope: added to the `:use` list of import
;;; `import`, or, when that is -1, brought in by a new import of `module`.
(defstruct ArAdd [(import i64) (module (slice u8)) (name (slice u8))])

;;; A rewritten call whose arguments moved by `delta` columns: its continuation lines
;;; indented at least `col` (the old column of its first argument) move with them.
(defstruct ArShift [(lo i64) (hi i64) (col i64) (delta i64)])

;;; One enclosing form on the walk's path, and which of its children holds the node.
(defstruct ArStep [(form (ptr Sexp)) (index i64)])

;;; How a symbol reaches a removed name: the row, the import it comes through (an
;;; index into the file's imports, -1 for none), the qualifier it was written with
;;; ("" when bare) and the name after the qualifier. A `dotted` one is written
;;; `coil.mod.old` (`api-module-dot`), which needs no import: its qualifier is the
;;; module.
(defstruct ArRef
  [(row i64)
   (import i64)
   (qualifier (slice u8))
   (local (slice u8))
   (dotted bool)])

(defstruct ArCx
  [(a (dyn Allocator))
   (src (slice u8))
   (file (ptr GmFile))
   ; names this file defines at top level: bare, they are its own and not the
   ; removed ones, and a migrated call must not be captured by them
   (own (ptr (ArrayList (slice u8))))
   ; the imports of a module that lost names, and every local spelling (after any
   ; qualifier) that could reach one of them: a symbol not in `spellings` is
   ; answered without looking further
   (renamed (ptr (ArrayList i64)))
   (spellings (ptr (HashMap (slice u8) bool)))
   ; every symbol the file writes outside its import, module and export forms
   (mentions (ptr (HashMap (slice u8) bool)))
   ; renamed functions written qualified (`ar-qualify?`): import and new name
   (qualified (ptr (ArrayList ArAdd)))
   ; the forms enclosing the node being walked, each with the index of the child
   ; the walk is in
   (path (ptr (ArrayList ArStep)))
   ; per import: an old name was reached through it or listed in it
   (touched (ptr (ArrayList bool)))
   ; per import: after the rewrite, some symbol is still qualified through it
   (referenced (ptr (ArrayList bool)))
   (adds (ptr (ArrayList ArAdd)))
   (shifts (ptr (ArrayList ArShift)))
   (edits (ptr (ArrayList ArEdit)))
   (findings (ptr (ArrayList ArFinding)))
   (notes (ptr (ArrayList ArFinding)))
   ; how many quasiquotes enclose the node, less the unquotes inside them: above 0
   ; the walk is in a template, the code a macro builds
   (quasi i64)
   ; inside a quote: data, which names nothing; only an unquote within it is code
   (data bool)])

(defn ar-import [(cx (ptr ArCx)) (i i64)] (-> (ptr GmImport))
  (elem (.imports (.file cx)) i))

(defn ar-import-count [(cx (ptr ArCx))] (-> i64)
  (len (load (.imports (.file cx)))))

(defn ar-edit! [(cx (ptr ArCx))
                (lo i64)
                (hi i64)
                (text (slice u8))
                (note (slice u8))] (-> i64)
  (push! (.edits cx)
         (ArEdit
           :lo lo
           :hi hi
           :text text
           :note note))
  0)

(defn ar-finding! [(cx (ptr ArCx)) (at (ptr Sexp)) (message (slice u8))]
  (-> i64)
  (push! (.findings cx) (ArFinding :lo (sx-lo (load at)) :message message))
  0)

(defn ar-note! [(cx (ptr ArCx)) (at (ptr Sexp)) (message (slice u8))] (-> i64)
  (push! (.notes cx) (ArFinding :lo (sx-lo (load at)) :message message))
  0)

(defn ar-mark! [(flags (ptr (ArrayList bool))) (i i64)] (-> i64)
  (when (>= i 0) (set! (elem flags i) true) 0))

;;; The removed name TEXT denotes in this file, if any.
(defn ar-resolve [(cx (ptr ArCx)) (text (slice u8))] (-> (Option ArRef))
  (let [slash (gm-find-slash text)
        dotted (api-dotted-rename-index text)
        (mut out) (None [ArRef])
        (mut found) false]
    (cond ; written `coil.mod.old`, it names the module's removed name with or
          ; without an import of it
          (>= dotted 0)
            (let [dot (api-module-dot text)]
              (set! out
                    (Some (ArRef
                            :row dotted
                            :import -1
                            :qualifier (subslice text 0 dot)
                            :local (subslice text (+ dot 1) (len text))
                            :dotted true)))
              0)
          (not (contains? (load (.spellings cx))
                          (if (> slash 0)
                              (subslice text (+ slash 1) (len text))
                              text)))
            0
          (> slash 0)
            (let [q (subslice text 0 slash)
                  name (subslice text (+ slash 1) (len text))]
              (for [k 0 (len (load (.renamed cx)))]
                (let [i (get (load (.renamed cx)) k)
                      imp (ar-import cx i)]
                  (when (and (not found)
                             (or (= (.alias imp) q) (= (.module imp) q)))
                    (let [row (api-rename-index (.module imp) name)]
                      (when (>= row 0)
                        (set! out
                              (Some (ArRef
                                      :row row
                                      :import i
                                      :qualifier q
                                      :local name
                                      :dotted false)))
                        (set! found true)
                        0)))))
              0)
          (not (gm-names-contain? (.own cx) text))
            (do
              (for [k 0 (len (load (.renamed cx)))]
                (let [i (get (load (.renamed cx)) k)
                      imp (ar-import cx i)]
                  (when (not found)
                    (match (gm-refers imp text)
                      (Some [exported]
                            (let [row (api-rename-index (.module imp) exported)]
                              (when (>= row 0)
                                (set! out
                                      (Some (ArRef
                                              :row row
                                              :import i
                                              :qualifier ""
                                              :local text
                                              :dotted false)))
                                (set! found true)
                                0)))
                      (None [] 0))
                    0)))
              ; no import brings it in: a name core provided reaches every file
              (unless found
                (let [row (ar-ambient-row (.file cx) text)]
                  (when (>= row 0)
                    (set! out
                          (Some (ArRef
                                  :row row
                                  :import -1
                                  :qualifier ""
                                  :local text
                                  :dotted false)))
                    0))))
          :else 0)
    out))

;;; A symbol survives the rewrite as TEXT: if it is qualified through an import, that
;;; import is still needed.
(defn ar-note-ref! [(cx (ptr ArCx)) (text (slice u8))] (-> i64)
  (let [slash (gm-find-slash text)]
    (when (> slash 0)
      (let [q (subslice text 0 slash)]
        (for [k 0 (len (load (.renamed cx)))]
          (let [i (get (load (.renamed cx)) k)
                imp (ar-import cx i)]
            (when (or (= (.alias imp) q) (= (.module imp) q))
              (ar-mark! (.referenced cx) i)
              0))))
      0)))

;;; Does NAME occur in F anywhere but as the head of a list or a field name? A
;;; binder, a parameter, or a value reference to NAME would capture a call written
;;; `(NAME …)`; the field of `(field x NAME)` or `(.. x NAME)` binds nothing.
(defn ar-mentions-nonhead? [(f (ptr Sexp)) (name (slice u8))] (-> bool)
  (cond (gm-sym? f) (= (gm-text f) name)
        (gm-list? f)
          (let [h (gm-head f)
                ; past the object of a field access come only field names
                n
                  (if (or (= h "field")
                          (= h "primitive/field")
                          (= h "..")
                          (= h "offsetof")
                          (= h "primitive/offsetof"))
                      (if (> (gm-count f) 2) 2 (gm-count f))
                      (gm-count f))
                (mut found) false]
            (for [i 0 n]
              (let [child (gm-at f i)]
                (when (and (not found)
                           (or (> i 0) (not (gm-sym? child)))
                           (ar-mentions-nonhead? child name))
                  (set! found true)
                  0)))
            found)
        (gm-vec? f)
          (let [(mut found) false]
            (for [i 0 (gm-count f)]
              (when (and (not found) (ar-mentions-nonhead? (gm-at f i) name))
                (set! found true)
                0))
            found)
        :else false))

;;; Does parameter vector V declare NAME? A parameter `(NAME T)` holds its binder where
;;; a call holds its head, which `ar-mentions-nonhead?` passes over.
(defn ar-params-bind? [(v (ptr Sexp)) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (gm-count v)]
      (when (= (gm-head (gm-at v i)) name) (set! found true) 0))
    found))

;;; Is the step at path index K a form whose vectors are parameter lists: a function
;;; definition or an anonymous function, or a method of an `impl`?
(defn ar-params-form? [(path (ptr (ArrayList ArStep))) (k i64)] (-> bool)
  (let [h (gm-head (.form (get (load path) k)))]
    (or (= h "defn")
        (= h "defn*")
        (= h "defmacro")
        (= h "fn")
        (= h "fn*")
        (and (> k 0) (= (gm-head (.form (get (load path) (- k 1)))) "impl")))))

;;; Could a binding written before the node being walked, in a form enclosing it,
;;; name NAME? A binder (a `let` or `for` vector, a parameter list, a pattern) comes
;;; before the forms it scopes over, so only the children before the walk's own are
;;; read. In a `let` vector an initializer sees only the binders before its own, so
;;; only those are read, and an earlier sibling that scopes its own bindings (a `let`,
;;; a `for`, a `match` …, an earlier arm of a `match`, or an earlier method of an
;;; `impl`) binds nothing after it. This over-approximates: any other mention counts,
;;; binding or not.
(defn ar-path-binds? [(cx (ptr ArCx)) (name (slice u8))] (-> bool)
  (let [path (.path cx)
        (mut found) false]
    (for [k 0 (len (load path))]
      (let [step (get (load path) k)
            f (.form step)
            at (.index step)
            ; an initializer of a `let`-style binding vector
            init
              (and (gm-vec? f)
                   (= (% at 2) 1)
                   (> k 0)
                   (let [up (get (load path) (- k 1))]
                     (and (= (.index up) 1) (ar-let-head? (gm-head (.form up))))))
            ; past its scrutinee a `match` holds arms, each scoping its own pattern
            arms (= (gm-head f) "match")
            ; an `impl` holds its type and methods, each method scoping its own
            methods (= (gm-head f) "impl")
            params (ar-params-form? path k)]
        (for [j 0 at]
          (let [child (gm-at f j)]
            (when (and (not found)
                       (or (> j 0) (gm-vec? f) (not (gm-sym? child)))
                       (or (not init) (= (% j 2) 0))
                       (not (and init (= j (- at 1))))
                       (not (and arms (>= j 2)))
                       (not (and methods (gm-list? child)))
                       (not (ar-scoping-head? (gm-head child)))
                       (or (ar-mentions-nonhead? child name)
                           (and params
                                (gm-vec? child)
                                (ar-params-bind? child name))))
              (set! found true)
              0))))
      0)
    found))

;;; Forms whose bindings scope over their own body and end with it.
(defn ar-scoping-head? [(h (slice u8))] (-> bool)
  (or (ar-let-head? h)
      (= h "for")
      (= h "fn")
      (= h "fn*")
      (= h "match")
      (= h "loop")
      (= h "while")
      (= h "block")
      (= h "scope")
      (= h "try")
      (= h "do")
      (= h "when")
      (= h "unless")
      (= h "if")
      (= h "cond")
      (= h "case")))

;;; Forms whose second element is a vector of binder/initializer pairs.
(defn ar-let-head? [(h (slice u8))] (-> bool)
  (or (= h "let")
      (= h "let*")
      (= h "if-let")
      (= h "when-let")
      (= h "while-let")))

;;; Could a call written `(NAME …)` here reach something other than the method its
;;; receiver dispatches to: a binding around it, a definition of this file's, or a
;;; name an import lists?
(defn ar-captured? [(cx (ptr ArCx)) (name (slice u8))] (-> bool)
  (let [(mut taken)
          (or (gm-names-contain? (.own cx) name) (ar-path-binds? cx name))]
    (for [i 0 (ar-import-count cx)]
      (let [imp (ar-import cx i)]
        (cond ; an explicit core import states core's names in full
              (= (.module imp) "coil.core")
                (match (gm-refers imp name)
                  (Some [_] 0)
                  (None [] (do (set! taken true) 0)))
              (not (.use_all imp))
                (match (gm-refers imp name)
                  (Some [_] (do (set! taken true) 0))
                  (None [] 0))
              :else 0))
      0)
    taken))

;;; An import that reaches MODULE's NAME, preferring import PREFER: one of MODULE or
;;; of a module that re-exports NAME from it. -1 when there is none.
(defn ar-import-of [(cx (ptr ArCx))
                    (module (slice u8))
                    (name (slice u8))
                    (prefer i64)] (-> i64)
  (if (and (>= prefer 0)
           (api-module-reaches? (.module (ar-import cx prefer)) module name))
      prefer
      (let [(mut at) -1]
        (for [i 0 (ar-import-count cx)]
          (when (and (< at 0)
                     (api-module-reaches? (.module (ar-import cx i))
                                          module
                                          name))
            (set! at i)
            0))
        at)))

;;; The vector after KEY in an import form, or null.
(defn ar-option-vector [(form (ptr Sexp)) (key (slice u8))] (-> (ptr Sexp))
  (let [n (gm-count form)
        (mut out) (primitive/cast (ptr Sexp) 0)]
    (for [i 2 (- n 1)]
      (let [k (gm-at form i)
            v (gm-at form (+ i 1))]
        (when (and (gm-kw? k) (= (gm-text k) key) (gm-vec? v)) (set! out v) 0)))
    out))

(defn ar-null? [(p (ptr Sexp))] (-> bool)
  (= (primitive/cast i64 p) 0))

(defn ar-add! [(cx (ptr ArCx))
               (import i64)
               (module (slice u8))
               (name (slice u8))] (-> i64)
  (let [(mut present) false]
    (for [i 0 (len (load (.adds cx)))]
      (let [x (get (load (.adds cx)) i)]
        (when (and (= (.import x) import)
                   (= (.module x) module)
                   (= (.name x) name))
          (set! present true)
          0)))
    (unless present
      (push! (.adds cx)
             (ArAdd
               :import import
               :module module
               :name name))
      0)))

;;; How to write OWNER (a trait or type declared in HOME) for `OWNER::name` in a call
;;; that reached its removed name through REF. `(None)` after a finding when no
;;; spelling is available. A built-in type (HOME "") is written bare. Where no import
;;; reaches HOME, one is added: through the alias API-ALIASES gives HOME, or else
;;; listing OWNER.
(defn ar-owner-spelling [(cx (ptr ArCx))
                         (at (ptr Sexp))
                         (ref ArRef)
                         (row ApiRename)
                         (home (slice u8))
                         (owner (slice u8))] (-> (Option (slice u8)))
  (let [a (.a cx)
        q (.qualifier ref)
        alias (api-module-alias home)
        j (ar-import-of cx home owner (.import ref))]
    (cond (= (len home) 0) (ar-unless-own cx at row owner)
          (and (> (len q) 0) (= home (.module row)))
            (Some (text/format a "{}/{}" q owner))
          (>= j 0)
            (let [imp (ar-import cx j)]
              (ar-unless-own cx
                             at
                             row
                             (match (gm-local-of imp owner)
                               (Some [local] local)
                               (None []
                                     (cond (> (len (.alias imp)) 0)
                                             (text/format a
                                                          "{}/{}"
                                                          (.alias imp)
                                                          owner)
                                           (not (ar-null? (ar-option-vector (.form imp)
                                                                            "use")))
                                             (do
                                               (ar-add! cx j home owner)
                                               owner)
                                           :else
                                             (text/format a
                                                          "{}/{}"
                                                          (.module imp)
                                                          owner))))))
          (= home "coil.core") (ar-unless-own cx at row owner)
          (= (len alias) 0)
            (do (ar-add! cx -1 home owner) (ar-unless-own cx at row owner))
          (ar-alias-taken? cx home alias)
            (do
              (ar-finding! cx
                           at
                           (text/format a
                                        "{}, which is written `{}/…`, and another import here is already aliased `{}`; rewrite it by hand"
                                        (api-rename-note a row)
                                        alias
                                        alias))
              (None [(slice u8)]))
          :else
            (do
              (ar-add! cx -1 home owner)
              (Some (text/format a "{}/{}" alias owner))))))

;;; SPELLED, unless it is a bare name this file defines itself: then a finding.
(defn ar-unless-own [(cx (ptr ArCx))
                     (at (ptr Sexp))
                     (row ApiRename)
                     (spelled (slice u8))] (-> (Option (slice u8)))
  (let [a (.a cx)]
    (if (and (< (gm-find-slash spelled) 0)
             (gm-names-contain? (.own cx) spelled))
        (do
          (ar-finding! cx
                       at
                       (text/format a
                                    "`{}` was removed from {}, and this file defines its own `{}`, so the replacement cannot name it bare; import the module with an alias and rewrite the call by hand"
                                    (.old row)
                                    (.module row)
                                    spelled))
          (None [(slice u8)]))
        (Some spelled))))

;;; Does an import here other than one of HOME already use ALIAS as its alias?
(defn ar-alias-taken? [(cx (ptr ArCx)) (home (slice u8)) (alias (slice u8))]
  (-> bool)
  (let [(mut taken) false]
    (for [i 0 (ar-import-count cx)]
      (let [imp (ar-import cx i)]
        (when (and (= (.alias imp) alias) (!= (.module imp) home))
          (set! taken true)
          0)))
    taken))

;;; The text that replaces the head of a call to a removed name, or `(None)` after a
;;; finding.
(defn ar-new-head [(cx (ptr ArCx)) (at (ptr Sexp)) (ref ArRef)]
  (-> (Option (slice u8)))
  (if (.dotted ref)
      (ar-dotted-head cx at (ar-row (.row ref)))
      (ar-imported-head cx at ref)))

;;; `ar-new-head` for a removed name reached through an import, or written bare.
(defn ar-imported-head [(cx (ptr ArCx)) (at (ptr Sexp)) (ref ArRef)]
  (-> (Option (slice u8)))
  (let [a (.a cx)
        row (ar-row (.row ref))
        q (.qualifier ref)]
    (match (.change row)
      (Renamed [name]
               (cond (> (len q) 0) (Some (text/format a "{}/{}" q name))
                     ; reached through a `:rename`: the local name stays
                     (!= (.local ref) (.old row)) (Some (.local ref))
                     ; written bare, the new name must still reach the renamed function
                     (or (gm-names-contain? (.own cx) name)
                         (ar-shadowed? cx (.module row) name))
                       (do
                         (ar-finding! cx
                                      at
                                      (text/format a
                                                   "{}, and a binding, a definition of this file's or another import here is also named `{}`, so the call cannot name it; rewrite it by hand"
                                                   (api-rename-note a row)
                                                   name))
                         (None [(slice u8)]))
                     (and (>= (.import ref) 0)
                          (ar-qualify? cx (.import ref) name))
                       (Some (ar-qualified! cx (.import ref) name))
                     :else (Some name)))
      (TraitCall [home trait name]
                 (if (ar-captured? cx name)
                     (match (ar-owner-spelling cx at ref row home trait)
                       (Some [o] (Some (text/format a "{}::{}" o name)))
                       (None [] (None [(slice u8)])))
                     (Some name)))
      (MethodCall [home type name]
                  (if (ar-captured? cx name)
                      (match (ar-owner-spelling cx at ref row home type)
                        (Some [o] (Some (text/format a "{}::{}" o name)))
                        (None [] (None [(slice u8)])))
                      (Some name)))
      (TypeCall [home type name]
                (match (ar-owner-spelling cx at ref row home type)
                  (Some [o] (Some (text/format a "{}::{}" o name)))
                  (None [] (None [(slice u8)]))))
      (FunctionCall [home name]
                    (match (ar-owner-spelling cx at ref row home name)
                      (Some [o]
                            (if (and (< (gm-find-slash o) 0)
                                     (ar-shadowed? cx home o))
                                (do
                                  (ar-finding! cx
                                               at
                                               (text/format a
                                                            "{}, and a binding or another import here is also named `{}`, so the call cannot name it; rewrite it by hand"
                                                            (api-rename-note a
                                                                             row)
                                                            o))
                                  (None [(slice u8)]))
                                (Some o)))
                      (None [] (None [(slice u8)])))))))

;;; The text that replaces a removed name of ROW written fully dotted, `coil.mod.old`,
;;; or `(None)` after a finding. Like the old name, the new one needs no import
;;; where it is written, so it is dotted too: a renamed or moved function
;;; `coil.mod.new`, a type's function `coil.mod.Type::new`. A trait or method call
;;; is the bare method name, which its receiver dispatches from any module, or
;;; `coil.mod.Owner::name` where a binding, a definition or an import here would
;;; capture it. What coil.core or the language provides is written bare, as it is
;;; reached from every module, and is a finding where this file takes that name.
(defn ar-dotted-head [(cx (ptr ArCx)) (at (ptr Sexp)) (row ApiRename)]
  (-> (Option (slice u8)))
  (let [a (.a cx)]
    (match (.change row)
      (Renamed [name] (Some (text/format a "{}.{}" (.module row) name)))
      (TraitCall [home trait name]
                 (if (ar-captured? cx name)
                     (ar-dotted-member cx at row home trait name)
                     (Some name)))
      (MethodCall [home type name]
                  (if (ar-captured? cx name)
                      (ar-dotted-member cx at row home type name)
                      (Some name)))
      (TypeCall [home type name] (ar-dotted-member cx at row home type name))
      (FunctionCall [home name]
                    (if (ar-ambient-home? home)
                        (match (ar-unless-own cx at row name)
                          (Some [o]
                                (if (ar-shadowed? cx home o)
                                    (do
                                      (ar-finding! cx
                                                   at
                                                   (text/format a
                                                                "{}, and a binding or another import here is also named `{}`, so the call cannot name it; rewrite it by hand"
                                                                (api-rename-note a
                                                                                 row)
                                                                o))
                                      (None [(slice u8)]))
                                    (Some o)))
                          (None [] (None [(slice u8)])))
                        (Some (text/format a "{}.{}" home name)))))))

;;; Is HOME reached from every module with no import: coil.core, or the language
;;; itself ("", a built-in type such as `slice`)?
(defn ar-ambient-home? [(home (slice u8))] (-> bool)
  (or (= (len home) 0) (= home "coil.core")))

;;; `OWNER::NAME` for a dotted rewrite, OWNER declared in HOME (ar-dotted-head).
(defn ar-dotted-member [(cx (ptr ArCx))
                        (at (ptr Sexp))
                        (row ApiRename)
                        (home (slice u8))
                        (owner (slice u8))
                        (name (slice u8))] (-> (Option (slice u8)))
  (let [a (.a cx)]
    (if (ar-ambient-home? home)
        (match (ar-unless-own cx at row owner)
          (Some [o] (Some (text/format a "{}::{}" o name)))
          (None [] (None [(slice u8)])))
        (Some (text/format a "{}.{}::{}" home owner name)))))

;;; Should a renamed function reached bare through import I be written qualified as
;;; NAME? Only when I lists its names: added to that list, NAME would take every other
;;; symbol `NAME` in the file (a call to core's or coil.iter's function of that name,
;;; say) from what it means now. A `:use *` import brings NAME in either way.
(defn ar-qualify? [(cx (ptr ArCx)) (i i64) (name (slice u8))] (-> bool)
  (and (not (.use_all (ar-import cx i))) (contains? (load (.mentions cx)) name)))

;;; NAME qualified through import I, its alias or else its module, recorded so that
;;; I's `:use` list drops the old name without taking NAME.
(defn ar-qualified! [(cx (ptr ArCx)) (i i64) (name (slice u8))] (-> (slice u8))
  (let [imp (ar-import cx i)]
    (unless (ar-qualified-name? cx i name)
      (push! (.qualified cx)
             (ArAdd
               :import i
               :module (.module imp)
               :name name))
      0)
    (text/format (.a cx)
                 "{}/{}"
                 (if (> (len (.alias imp)) 0) (.alias imp) (.module imp))
                 name)))

(defn ar-qualified-name? [(cx (ptr ArCx)) (i i64) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for [k 0 (len (load (.qualified cx)))]
      (let [x (get (load (.qualified cx)) k)]
        (when (and (= (.import x) i) (= (.name x) name)) (set! found true) 0)))
    found))

;;; Would a call written `(NAME …)` here, meaning the function HOME declares, reach
;;; something else: a binding around it, or a name another module's import lists?
(defn ar-shadowed? [(cx (ptr ArCx)) (home (slice u8)) (name (slice u8))]
  (-> bool)
  (let [(mut taken) (ar-path-binds? cx name)]
    (for [i 0 (ar-import-count cx)]
      (let [imp (ar-import cx i)]
        (when (and (!= (.module imp) home) (not (.use_all imp)))
          (match (gm-refers imp name)
            (Some [_] (do (set! taken true) 0))
            (None [] 0))
          0)))
    taken))

;;; A call `(OLD …)` to a removed name.
(defn ar-call! [(cx (ptr ArCx)) (f (ptr Sexp)) (ref ArRef)] (-> i64)
  (let [a (.a cx)
        row (ar-row (.row ref))
        head (gm-at f 0)
        n (gm-count f)
        renamed (match (.change row) (Renamed [_] true) (_ false))
        drop (and (.drop-type-args row) (> n 1) (gm-vec? (gm-at f 1)))
        first-arg (if drop 2 1)]
    (ar-mark! (.touched cx) (.import ref))
    (if (and (not renamed) (< first-arg n) (gm-kw? (gm-at f first-arg)))
        (do
          (ar-finding! cx
                       head
                       (text/format a
                                    "{}, whose parameters are not the removed function's; this call names its arguments, so rewrite it by hand"
                                    (api-rename-note a row)))
          (ar-note-ref! cx (gm-text head))
          (for [i 1 n] (ar-walk-child! cx f i) 0))
        (match (ar-new-head cx head ref)
          (Some [text]
                (do
                  (when (!= text (gm-text head))
                    (ar-edit! cx
                              (sx-lo (load head))
                              (sx-hi (load head))
                              text
                              (api-rename-note a row))
                    0)
                  (ar-note-ref! cx text)
                  (ar-shift! cx f head text drop first-arg)
                  (when drop
                    (let [v (gm-at f 1)]
                      (if (> n 2)
                          (ar-edit! cx
                                    (sx-lo (load v))
                                    (sx-lo (load (gm-at f 2)))
                                    ""
                                    "")
                          (ar-edit! cx
                                    (sx-hi (load head))
                                    (sx-hi (load v))
                                    ""
                                    "")))
                    0)
                  (for [i first-arg n] (ar-walk-child! cx f i) 0)))
          (None []
                (do
                  (ar-note-ref! cx (gm-text head))
                  (for [i 1 n] (ar-walk-child! cx f i) 0)))))
    0))

;;; Where the line holding byte AT starts.
(defn ar-line-start [(src (slice u8)) (at i64)] (-> i64)
  (let [(mut p) at]
    (loop (if (and (> p 0) (!= (cast i64 (get src (- p 1))) 10))
              (set! p (- p 1))
              (break)))
    p))

(defn ar-column [(src (slice u8)) (at i64)] (-> i64)
  (- at (ar-line-start src at)))

;;; Call F's head becomes TEXT (and its type arguments go when DROP): remember how
;;; far its first argument moves, so the lines aligned with it can follow.
(defn ar-shift! [(cx (ptr ArCx))
                 (f (ptr Sexp))
                 (head (ptr Sexp))
                 (text (slice u8))
                 (drop bool)
                 (first-arg i64)] (-> i64)
  (let [src (.src cx)]
    (when (< first-arg (gm-count f))
      (let [arg (sx-lo (load (gm-at f first-arg)))
            ; where the first argument lands: the dropped vector's place, or its own
            moved (if drop (sx-lo (load (gm-at f 1))) arg)
            head-line (ar-line-start src (sx-lo (load head)))
            grow (- (len text) (len (gm-text head)))
            new-col
              (+ (ar-column src moved)
                 (if (= (ar-line-start src moved) head-line) grow 0))
            old-col (ar-column src arg)
            delta (- new-col old-col)]
        (when (!= delta 0)
          (push! (.shifts cx)
                 (ArShift
                   :lo (sx-lo (load f))
                   :hi (sx-hi (load f))
                   :col old-col
                   :delta delta))
          0)))))

;;; The lines that start inside a shifted call, outside strings, each with the sum of
;;; the shifts that move it, as indentation edits. A line some other edit already
;;; rewrites (a dropped vector that ended a line) is left to that edit.
(defn ar-shift-edits! [(cx (ptr ArCx))] (-> i64)
  (let [a (.a cx)
        src (.src cx)
        lines (new-boxed-list [i64] a)
        moves (new-boxed-list [i64] a)]
    (for [k 0 (len (load (.shifts cx)))]
      (let [sh (get (load (.shifts cx)) k)
            (mut p) (.lo sh)
            (mut in-string) false
            (mut in-comment) false]
        (loop (if (>= p (.hi sh))
                  (break)
                  (let [c (cast i64 (get src p))]
                    (cond in-comment
                            (do (when (= c 10) (set! in-comment false) 0))
                          in-string
                            (cond (= c 92) (do (set! p (+ p 1)) 0)
                                  (= c 34) (do (set! in-string false) 0)
                                  :else 0)
                          (= c 59) (do (set! in-comment true) 0)
                          (= c 34) (do (set! in-string true) 0)
                          (and (= c 35)
                               (< (+ p 1) (len src))
                               (= (cast i64 (get src (+ p 1))) 92))
                            (do (set! p (+ p 2)) 0)
                          :else 0)
                    (when (and (= c 10) (not in-string) (< (+ p 1) (.hi sh)))
                      (let [ls (+ p 1)
                            (mut k2) 0]
                        (loop (if (and (< (+ ls k2) (len src))
                                       (= (cast i64 (get src (+ ls k2))) 32))
                                  (set! k2 (+ k2 1))
                                  (break)))
                        (when (and (>= k2 (.col sh))
                                   (< (+ ls k2) (len src))
                                   (!= (cast i64 (get src (+ ls k2))) 10))
                          (let [(mut found) -1]
                            (for [i 0 (len (load lines))]
                              (when (= (get (load lines) i) ls)
                                (set! found i)
                                0))
                            (if (< found 0)
                                (do
                                  (push! lines ls)
                                  (push! moves (.delta sh))
                                  0)
                                (do
                                  (set! (elem moves found)
                                        (+ (get (load moves) found)
                                           (.delta sh)))
                                  0))))))
                    (set! p (+ p 1))))))
      0)
    (for [i 0 (len (load lines))]
      (let [ls (get (load lines) i)
            delta (get (load moves) i)
            (mut covered) false
            (mut indent) 0]
        (for [k 0 (len (load (.edits cx)))]
          (let [e (get (load (.edits cx)) k)]
            (when (and (<= (.lo e) ls) (< ls (.hi e))) (set! covered true) 0)))
        (loop (if (and (< (+ ls indent) (len src))
                       (= (cast i64 (get src (+ ls indent))) 32))
                  (set! indent (+ indent 1))
                  (break)))
        (unless covered
          (cond (> delta 0)
                  (let [(mut pad) ""]
                    (for [k 0 delta] (set! pad (text/format a "{} " pad)) 0)
                    (ar-edit! cx ls ls pad ""))
                (< delta 0)
                  (ar-edit! cx
                            ls
                            (+ ls (if (< indent (- delta)) indent (- delta)))
                            ""
                            "")
                :else 0)
          0)))
    0))

;;; A symbol anywhere but a call head. A renamed name, or one another module now
;;; declares, is spelled as a call to it would be; a method or trait call needs its
;;; receiver, so a value use of one is a finding.
(defn ar-value! [(cx (ptr ArCx)) (s (ptr Sexp))] (-> i64)
  (let [a (.a cx)
        text (gm-text s)]
    (match (ar-resolve cx text)
      (Some [ref]
            (let [row (ar-row (.row ref))
                  named
                    (match (.change row)
                      (Renamed [_] true)
                      (FunctionCall [_ _] true)
                      (_ false))]
              (ar-mark! (.touched cx) (.import ref))
              (if named
                  (match (ar-new-head cx s ref)
                    (Some [new]
                          (do
                            (when (!= new text)
                              (ar-edit! cx
                                        (sx-lo (load s))
                                        (sx-hi (load s))
                                        new
                                        (api-rename-note a row))
                              0)
                            (ar-note-ref! cx new)))
                    (None [] (ar-note-ref! cx text)))
                  (do
                    ; in a template, see ar-walk!
                    (if (> (.quasi cx) 0)
                        (ar-note! cx
                                  s
                                  (text/format a
                                               "{}, which a call reaches through its receiver; here the old name is a symbol in quasiquoted code, so it is left as written: if the template emits it as code, rewrite it by hand"
                                               (api-rename-note a row)))
                        (ar-finding! cx
                                     s
                                     (text/format a
                                                  "{}, which a call reaches through its receiver; here the old name is used as a value, so rewrite it by hand"
                                                  (api-rename-note a row))))
                    (ar-note-ref! cx text)))))
      (None [] (ar-note-ref! cx text)))))

;;; Walk child I of F, with F on the path.
(defn ar-walk-child! [(cx (ptr ArCx)) (f (ptr Sexp)) (i i64)] (-> i64)
  (push! (.path cx) (ArStep :form f :index i))
  (ar-walk! cx (gm-at f i))
  (pop! (.path cx))
  0)

;;; Walk the children of F from I on with the quasiquote depth at QUASI and the
;;; data flag at DATA, then put both back.
(defn ar-walk-quoted! [(cx (ptr ArCx))
                       (f (ptr Sexp))
                       (i i64)
                       (quasi i64)
                       (data bool)] (-> i64)
  (let [outer-quasi (.quasi cx)
        outer-data (.data cx)]
    (set! (.quasi cx) quasi)
    (set! (.data cx) data)
    (for [k i (gm-count f)] (ar-walk-child! cx f k) 0)
    (set! (.quasi cx) outer-quasi)
    (set! (.data cx) outer-data)
    0))

;;; Quoted data names nothing, so no symbol in it is a use of a removed name. A
;;; quasiquote is a template: the code it builds is migrated as code, except that a
;;; symbol it cannot rewrite is a note, not a finding (`ar-value!`). An unquote
;;; inside either is code again.
(defn ar-walk! [(cx (ptr ArCx)) (f (ptr Sexp))] (-> i64)
  (let [head-text
          (if (and (gm-list? f) (> (gm-count f) 0) (gm-sym? (gm-at f 0)))
              (gm-text (gm-at f 0))
              "")]
    (cond (= head-text "quote")
            (if (> (.quasi cx) 0) (ar-walk-quoted! cx f 1 (.quasi cx) true) 0)
          (= head-text "quasiquote")
            (ar-walk-quoted! cx f 1 (+ (.quasi cx) 1) (.data cx))
          (and (> (.quasi cx) 0)
               (or (= head-text "unquote") (= head-text "unquote-splicing")))
            (let [inner (- (.quasi cx) 1)]
              (ar-walk-quoted! cx f 1 inner (and (.data cx) (> inner 0))))
          (.data cx)
            (if (or (gm-list? f) (gm-vec? f))
                (ar-walk-quoted! cx f 0 (.quasi cx) true)
                0)
          :else (ar-walk-code! cx f))))

(defn ar-walk-code! [(cx (ptr ArCx)) (f (ptr Sexp))] (-> i64)
  (cond (gm-list? f)
          (let [n (gm-count f)]
            (when (> n 0)
              (let [head (gm-at f 0)]
                (if (gm-sym? head)
                    (match (ar-resolve cx (gm-text head))
                      (Some [ref] (ar-call! cx f ref))
                      (None []
                            (do
                              (ar-note-ref! cx (gm-text head))
                              (for [i 1 n] (ar-walk-child! cx f i) 0)
                              0)))
                    (do (for [i 0 n] (ar-walk-child! cx f i) 0) 0)))
              0))
        (gm-vec? f) (do (for [i 0 (gm-count f)] (ar-walk-child! cx f i) 0) 0)
        (gm-sym? f) (ar-value! cx f)
        :else 0))

; ---- imports ---------------------------------------------------------------------------

;;; The text of vector V with item i replaced by `texts[i]`, or dropped where that is
;;; "", and `extra` appended. The separators and comments before each kept item stay.
;;; "" when nothing is left.
(defn ar-vector-text [(a (dyn Allocator))
                      (src (slice u8))
                      (v (ptr Sexp))
                      (texts (ptr (ArrayList (slice u8))))
                      (extra (ptr (ArrayList (slice u8))))] (-> (slice u8))
  (let [n (gm-count v)
        lo (sx-lo (load v))
        hi (sx-hi (load v))
        (mut out) "["
        (mut any) false]
    (for [i 0 n]
      (let [t (get (load texts) i)
            item (gm-at v i)]
        (when (> (len t) 0)
          (let [gap
                  (if any
                      (subslice src
                                (sx-hi (load (gm-at v (- i 1))))
                                (sx-lo (load item)))
                      (subslice src (+ lo 1) (sx-lo (load (gm-at v 0)))))]
            (set! out (sconcat3 a out gap t))
            (set! any true))
          0)))
    (for [i 0 (len (load extra))]
      (set! out (sconcat3 a out (if any " " "") (get (load extra) i)))
      (set! any true)
      0)
    (if (not any)
        ""
        (text/format a
                     "{}{}]"
                     out
                     (if (> n 0)
                         (subslice src
                                   (sx-hi (load (gm-at v (- n 1))))
                                   (- hi 1))
                         "")))))

;;; The `:use` (or `:exclude`) vector of import IMPORT, of MODULE, without its removed
;;; names; a Renamed one becomes its new name unless its calls were written
;;; qualified. `extra` are names to add.
(defn ar-names-text [(cx (ptr ArCx))
                     (import i64)
                     (module (slice u8))
                     (v (ptr Sexp))
                     (rename-to-new bool)
                     (extra (ptr (ArrayList (slice u8))))] (-> (slice u8))
  (let [a (.a cx)
        texts (new-boxed-list [(slice u8)] a)
        present (new-boxed-list [(slice u8)] a)
        n (gm-count v)]
    (for [i 0 n]
      (let [item (gm-at v i)
            text (subslice (.src cx) (sx-lo (load item)) (sx-hi (load item)))
            row (if (gm-sym? item) (api-rename-index module (gm-text item)) -1)
            t
              (if (< row 0)
                  text
                  (match (.change (ar-row row))
                    (Renamed [name]
                             (if (and rename-to-new
                                      (not (gm-names-contain? present name))
                                      (not (ar-qualified-name? cx import name)))
                                 name
                                 ""))
                    (_ "")))]
        (push! texts t)
        (when (> (len t) 0) (push! present t) 0)))
    (let [more (new-boxed-list [(slice u8)] a)]
      (for [i 0 (len (load extra))]
        (let [x (get (load extra) i)]
          (unless (gm-names-contain? present x)
            (push! more x)
            (push! present x)
            0)))
      (ar-vector-text a (.src cx) v texts more))))

;;; The `:rename` vector of an import of MODULE: a pair renaming a removed name goes,
;;; or, for a Renamed one, renames the new name instead.
(defn ar-renames-text [(cx (ptr ArCx)) (module (slice u8)) (v (ptr Sexp))]
  (-> (slice u8))
  (let [a (.a cx)
        src (.src cx)
        texts (new-boxed-list [(slice u8)] a)]
    (for [i 0 (gm-count v)]
      (let [pair (gm-at v i)
            text (subslice src (sx-lo (load pair)) (sx-hi (load pair)))
            from
              (if (and (gm-vec? pair)
                       (= (gm-count pair) 2)
                       (gm-sym? (gm-at pair 0)))
                  (gm-at pair 0)
                  (primitive/cast (ptr Sexp) 0))
            row (if (ar-null? from) -1 (api-rename-index module (gm-text from)))]
        (push! texts
               (if (< row 0)
                   text
                   (match (.change (ar-row row))
                     (Renamed [name]
                              (sconcat3 a
                                        (subslice src
                                                  (sx-lo (load pair))
                                                  (sx-lo (load from)))
                                        name
                                        (subslice src
                                                  (sx-hi (load from))
                                                  (sx-hi (load pair)))))
                     (_ "")))))
      0)
    (ar-vector-text a
                    src
                    v
                    texts
                    (new-boxed-list [(slice u8)] a))))

;;; The byte range that deletes form F: its whole line when nothing else is on it
;;; but blanks and a trailing comment, else just the form.
(defn ar-form-range [(src (slice u8)) (f (ptr Sexp))] (-> (array i64 2))
  (let [lo (sx-lo (load f))
        hi (sx-hi (load f))
        n (len src)
        (mut start) lo
        (mut end) hi]
    (loop (if (and (> start 0)
                   (let [c (cast i64 (get src (- start 1)))]
                     (or (= c 32) (= c 9))))
              (set! start (- start 1))
              (break)))
    (when (or (= start 0) (= (cast i64 (get src (- start 1))) 10))
      (loop (if (and (< end n)
                     (let [c (cast i64 (get src end))] (or (= c 32) (= c 9))))
                (set! end (+ end 1))
                (break)))
      (when (and (< end n) (= (cast i64 (get src end)) 59))
        (loop (if (and (< end n) (!= (cast i64 (get src end)) 10))
                  (set! end (+ end 1))
                  (break)))
        0))
    (if (and (or (= start 0) (= (cast i64 (get src (- start 1))) 10))
             (or (= end n) (= (cast i64 (get src end)) 10)))
        [start (if (< end n) (+ end 1) end)]
        [lo hi])))

;;; Rewrite or delete import I once the walk has decided what the file still needs.
(defn ar-import-edit! [(cx (ptr ArCx)) (i i64)] (-> i64)
  (let [a (.a cx)
        src (.src cx)
        imp (ar-import cx i)
        form (.form imp)
        module (.module imp)
        extra (new-boxed-list [(slice u8)] a)
        n (gm-count form)
        use-v (ar-option-vector form "use")
        exclude-v (ar-option-vector form "exclude")
        rename-v (ar-option-vector form "rename")
        note (text/format a "the import names what {} no longer has" module)]
    (for [k 0 (len (load (.adds cx)))]
      (let [x (get (load (.adds cx)) k)]
        (when (= (.import x) i) (push! extra (.name x)) 0)))
    (let [use-text
            (if (ar-null? use-v)
                ""
                (ar-names-text cx i module use-v true extra))
          exclude-text
            (if (ar-null? exclude-v)
                ""
                (ar-names-text cx
                               i
                               module
                               exclude-v
                               false
                               (new-boxed-list [(slice u8)] a)))
          rename-text
            (if (ar-null? rename-v) "" (ar-renames-text cx module rename-v))
          changed
            (or (and (not (ar-null? use-v))
                     (!= use-text
                         (subslice src
                                   (sx-lo (load use-v))
                                   (sx-hi (load use-v)))))
                (and (not (ar-null? exclude-v))
                     (!= exclude-text
                         (subslice src
                                   (sx-lo (load exclude-v))
                                   (sx-hi (load exclude-v)))))
                (and (not (ar-null? rename-v))
                     (!= rename-text
                         (subslice src
                                   (sx-lo (load rename-v))
                                   (sx-hi (load rename-v))))))
          touched (or changed (get (load (.touched cx)) i))
          needed
            (or (.use_all imp)
                (> (len use-text) 0)
                (> (len rename-text) 0)
                (get (load (.referenced cx)) i)
                (.reexport imp))]
      (cond (not touched) 0
            (not needed)
              (let [r (ar-form-range src form)]
                (ar-edit! cx (get r 0) (get r 1) "" note))
            changed
              ; Rebuild the form from its own text: each kept element after the gap
              ; that preceded it, an emptied option without its keyword.
              (let [(mut out)
                      (subslice src
                                (sx-lo (load form))
                                (sx-hi (load (gm-at form 0))))
                    (mut j) 1]
                (loop (if (>= j n)
                          (break)
                          (let [el (gm-at form j)
                                gap
                                  (subslice src
                                            (sx-hi (load (gm-at form (- j 1))))
                                            (sx-lo (load el)))
                                v
                                  (if (< (+ j 1) n)
                                      (gm-at form (+ j 1))
                                      (primitive/cast (ptr Sexp) 0))
                                vtext
                                  (cond (= v use-v) use-text
                                        (= v exclude-v) exclude-text
                                        (= v rename-v) rename-text
                                        :else "")
                                option
                                  (and (gm-kw? el)
                                       (not (ar-null? v))
                                       (or (= v use-v)
                                           (= v exclude-v)
                                           (= v rename-v)))]
                            (cond (and option (= (len vtext) 0))
                                    (set! j (+ j 2))
                                  option
                                    (do
                                      (set! out
                                            (sconcat3 a
                                                      out
                                                      (sconcat a
                                                               gap
                                                               (ar-text-of src
                                                                           el))
                                                      (sconcat a
                                                               (subslice src
                                                                         (sx-hi (load el))
                                                                         (sx-lo (load v)))
                                                               vtext)))
                                      (set! j (+ j 2)))
                                  :else
                                    (do
                                      (set! out
                                            (sconcat3 a
                                                      out
                                                      gap
                                                      (ar-text-of src el)))
                                      (set! j (+ j 1)))))))
                (ar-edit! cx
                          (sx-lo (load form))
                          (sx-hi (load form))
                          (sconcat a
                                   out
                                   (subslice src
                                             (sx-hi (load (gm-at form (- n 1))))
                                             (sx-hi (load form))))
                          note))
            :else 0))
    0))

(defn ar-text-of [(src (slice u8)) (p (ptr Sexp))] (-> (slice u8))
  (subslice src (sx-lo (load p)) (sx-hi (load p))))

;;; Imports of modules the file did not import, for names a migrated call needs. They
;;; go after `(module …)`, or first when there is none.
(defn ar-new-imports-edit! [(cx (ptr ArCx))] (-> i64)
  (let [a (.a cx)
        modules (new-boxed-list [(slice u8)] a)
        (mut lines) ""]
    (for [k 0 (len (load (.adds cx)))]
      (let [x (get (load (.adds cx)) k)]
        (when (and (< (.import x) 0)
                   (not (gm-names-contain? modules (.module x))))
          (push! modules (.module x))
          0)))
    (for [m 0 (len (load modules))]
      (let [module (get (load modules) m)
            (mut names) ""]
        (for [k 0 (len (load (.adds cx)))]
          (let [x (get (load (.adds cx)) k)]
            (when (and (< (.import x) 0) (= (.module x) module))
              (set! names
                    (sconcat3 a names (if (> (len names) 0) " " "") (.name x)))
              0)))
        (set! lines
              (sconcat3 a
                        lines
                        (if (> (len lines) 0) "\n" "")
                        (let [alias (api-module-alias module)]
                          (if (> (len alias) 0)
                              (text/format a
                                           "(import \"{}\" :as {})"
                                           module
                                           alias)
                              (text/format a
                                           "(import \"{}\" :use [{}])"
                                           module
                                           names))))))
      0)
    (when (> (len lines) 0)
      (let [forms (.forms (.file cx))
            note "a migrated call needs a name this file does not import"
            (mut at) -1]
        (for [i 0 (len (load forms))]
          (when (and (< at 0) (= (gm-head (elem forms i)) "module"))
            (set! at (sx-hi (load (elem forms i))))
            0))
        (if (>= at 0)
            (ar-edit! cx at at (text/format a "\n{}" lines) note)
            (ar-edit! cx 0 0 (text/format a "{}\n" lines) note)))
      0)))

;;; Order EDITS by descending start, as `lint-apply` takes them.
(defn ar-sort-desc! [(edits (ptr (ArrayList ArEdit)))] (-> i64)
  (for [i 1 (len (load edits))]
    (let [(mut j) i]
      (loop (if (<= j 0)
                (break)
                (let [x (get (load edits) (- j 1))
                      y (get (load edits) j)]
                  (if (or (> (.lo x) (.lo y))
                          (and (= (.lo x) (.lo y)) (>= (.hi x) (.hi y))))
                      (break)
                      (do
                        (set! (elem edits j) x)
                        (set! (elem edits (- j 1)) y)
                        (set! j (- j 1))))))))
    0)
  0)

;;; Every symbol the file writes outside its import, module and export forms.
(defn ar-mentions [(a (dyn Allocator)) (forms (ptr (ArrayList Sexp)))]
  (-> (ptr (HashMap (slice u8) bool)))
  (let [out
          (box! a
                (HashMap (slice u8) bool)
                (HashMap::new [(slice u8) bool] a (keyops-borrowed)))]
    (for [i 0 (len (load forms))]
      (let [f (elem forms i)
            h (gm-head f)]
        (unless (or (= h "import") (= h "module") (= h "export"))
          (ar-mention! out f)
          0)))
    out))

(defn ar-mention! [(out (ptr (HashMap (slice u8) bool))) (f (ptr Sexp))]
  (-> i64)
  (cond (gm-sym? f) (do (set! out (gm-text f) true) 0)
        (or (gm-list? f) (gm-vec? f))
          (do (for [i 0 (gm-count f)] (ar-mention! out (gm-at f i)) 0) 0)
        :else 0))

;;; Which names does the file define at top level?
(defn ar-own-names [(a (dyn Allocator)) (forms (ptr (ArrayList Sexp)))]
  (-> (ptr (ArrayList (slice u8))))
  (let [out (new-boxed-list [(slice u8)] a)]
    (for [i 0 (len (load forms))]
      (let [f (elem forms i)
            h (gm-head f)]
        (when (and (or (= h "defn")
                       (= h "defn*")
                       (= h "defmacro")
                       (= h "def")
                       (= h "const")
                       (= h "defstruct")
                       (= h "defsum")
                       (= h "deftrait")
                       (= h "defalias")
                       (= h "extern")
                       (= h "declare"))
                   (> (gm-count f) 1)
                   (gm-sym? (gm-at f 1)))
          (push! out (gm-text (gm-at f 1)))
          0)))
    out))

(defn ar-false-flags [(a (dyn Allocator)) (n i64)] (-> (ptr (ArrayList bool)))
  (let [out (new-boxed-list [bool] a)]
    (for [i 0 n] (push! out false) 0)
    out))

;;; The imports of a module that lost names (one of MODULES), as indices.
(defn ar-renamed-imports [(a (dyn Allocator))
                          (file (ptr GmFile))
                          (modules (ptr (ArrayList (slice u8))))]
  (-> (ptr (ArrayList i64)))
  (let [out (new-boxed-list [i64] a)]
    (for [i 0 (len (load (.imports file)))]
      (when (gm-names-contain? modules (.module (elem (.imports file) i)))
        (push! out i)
        0))
    out))

;;; Every name after its qualifier that could reach a removed name in this file: the
;;; removed names of the modules RENAMED imports, and the local names their
;;; `:rename`s give. Every symbol of the file is looked up here, so it is a set.
(defn ar-spellings [(a (dyn Allocator))
                    (file (ptr GmFile))
                    (renamed (ptr (ArrayList i64)))]
  (-> (ptr (HashMap (slice u8) bool)))
  (let [out
          (box! a
                (HashMap (slice u8) bool)
                (HashMap::new [(slice u8) bool] a (keyops-borrowed)))
        imported (new-boxed-list [(slice u8)] a)
        rows (api-renames)]
    (for [k 0 (len (load renamed))]
      (let [imp (elem (.imports file) (get (load renamed) k))]
        (push! imported (.module imp))
        (for [j 0 (len (load (.renames imp)))]
          (set! out (.to (get (load (.renames imp)) j)) true)
          0))
      0)
    (for [r 0 (len rows)]
      (let [(mut reached) false]
        (for [k 0 (len (load imported))]
          (when (api-module-reaches? (get (load imported) k)
                                     (.module (get rows r))
                                     (.old (get rows r)))
            (set! reached true)
            0))
        (when reached (set! out (.old (get rows r)) true) 0)))
    (for [r 0 (len (api-ambient))]
      (set! out (.old (get (api-ambient) r)) true)
      0)
    out))

;;; The row of NAME when it is a removed name its module provided to coil.core and
;;; FILE reaches core's names bare: it has no import of coil.core, or an explicit one
;;; that refers to NAME. -1 otherwise.
(defn ar-ambient-row [(file (ptr GmFile)) (name (slice u8))] (-> i64)
  (let [names (api-ambient)
        (mut row) -1]
    (for [i 0 (len names)]
      (let [x (get names i)]
        (when (and (< row 0) (= (.old x) name) (ar-core-reaches? file name))
          (set! row (api-rename-index (.module x) name))
          0)))
    row))

(defn ar-core-reaches? [(file (ptr GmFile)) (name (slice u8))] (-> bool)
  (let [(mut explicit) false
        (mut reaches) false]
    (for [i 0 (len (load (.imports file)))]
      (let [imp (elem (.imports file) i)]
        (when (= (.module imp) "coil.core")
          (set! explicit true)
          (match (gm-refers imp name)
            (Some [_] (do (set! reaches true) 0))
            (None [] 0))
          0)))
    (or (not explicit) reaches)))

;;; Does F write, anywhere, a removed name that no import reaches: one its module
;;; provided to coil.core, or one written fully dotted, `coil.mod.old`?
(defn ar-names-unimported? [(f (ptr Sexp))] (-> bool)
  (cond (gm-sym? f)
          (let [names (api-ambient)
                text (gm-text f)
                (mut hit) (>= (api-dotted-rename-index text) 0)]
            (for [i 0 (len names)]
              (when (= (.old (get names i)) text) (set! hit true) 0))
            hit)
        (or (gm-list? f) (gm-vec? f))
          (let [(mut hit) false]
            (for [i 0 (gm-count f)]
              (when (and (not hit) (ar-names-unimported? (gm-at f i)))
                (set! hit true)
                0))
            hit)
        :else false))

(defn ar-forms-name-unimported? [(forms (ptr (ArrayList Sexp)))] (-> bool)
  (let [(mut hit) false]
    (for [i 0 (len (load forms))]
      (let [f (elem forms i)
            h (gm-head f)]
        (when (and (not hit)
                   (not (or (= h "import") (= h "module") (= h "export")))
                   (ar-names-unimported? f))
          (set! hit true)
          0)))
    hit))

;;; The migration of one read file: its edits in descending source order, the
;;; uses of removed names it cannot rewrite, and the ones it leaves as written.
(defn ar-migrate [(a (dyn Allocator))
                  (forms (ptr (ArrayList Sexp)))
                  (src (slice u8))] (-> ArResult)
  (let [file (primitive/alloc-stack GmFile)
        edits (new-boxed-list [ArEdit] a)
        findings (new-boxed-list [ArFinding] a)
        notes (new-boxed-list [ArFinding] a)]
    (set! file (gm-read-file a forms))
    ; A removed name is reachable only through an import of its module, or, when
    ; its module provided it to coil.core, written bare, or written fully dotted.
    (let [renamed (ar-renamed-imports a file (api-renamed-modules a))]
      (when (or (> (len (load renamed)) 0) (ar-forms-name-unimported? forms))
        (let [n (len (load (.imports file)))
              (mut cx)
                (ArCx
                  :a a
                  :src src
                  :file file
                  :own (ar-own-names a forms)
                  :path (new-boxed-list [ArStep] a)
                  :touched (ar-false-flags a n)
                  :referenced (ar-false-flags a n)
                  :adds (new-boxed-list [ArAdd] a)
                  :renamed renamed
                  :spellings (ar-spellings a file renamed)
                  :mentions (ar-mentions a forms)
                  :qualified (new-boxed-list [ArAdd] a)
                  :shifts (new-boxed-list [ArShift] a)
                  :edits edits
                  :findings findings
                  :notes notes
                  :quasi 0
                  :data false)]
          (for [i 0 (len (load forms))]
            (let [f (elem forms i)
                  h (gm-head f)]
              (unless (or (= h "import") (= h "module") (= h "export"))
                (ar-walk! (mut cx) f)
                0)))
          (ar-shift-edits! (mut cx))
          (for [k 0 (len (load renamed))]
            (ar-import-edit! (mut cx) (get (load renamed) k))
            0)
          (ar-new-imports-edit! (mut cx))
          (ar-sort-desc! edits)
          (for [k 1 (len (load edits))]
            (when (> (.hi (get (load edits) k))
                     (.lo (get (load edits) (- k 1))))
              (panic "coil.compiler.api_migration: overlapping edits at byte {}"
                     (.lo (get (load edits) k))))
            0)
          0)))
    (ArResult
      :edits edits
      :findings findings
      :notes notes)))

;;; Does this source use a name the table says was removed?
(defn ar-breaking? [(a (dyn Allocator))
                    (forms (ptr (ArrayList Sexp)))
                    (src (slice u8))] (-> bool)
  (let [r (ar-migrate a forms src)]
    (or (> (len (load (.edits r))) 0) (> (len (load (.findings r))) 0))))
