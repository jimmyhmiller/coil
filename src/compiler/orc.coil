;;; The typed C boundary to LLVM's resource-tracked object linker.
(module coil.compiler.orc)
(import "coil.primitive" :as p)

(defstruct SymbolFlags [(generic u8) (target u8)])
(defstruct EvaluatedSymbol [(address i64) (flags SymbolFlags)])
(defstruct SymbolPair [(name (ptr i8)) (symbol EvaluatedSymbol)])
(defstruct SearchOrder [(dylib (ptr i8)) (flags i32)])
(defstruct LookupSymbol [(name (ptr i8)) (flags i32)])

(extern LLVMOrcCreateLLJIT :cc c [(ptr (ptr i8)) (ptr i8)] (-> (ptr i8)))
(extern LLVMOrcDisposeLLJIT :cc c [(ptr i8)] (-> (ptr i8)))
(extern LLVMOrcLLJITGetExecutionSession :cc c [(ptr i8)] (-> (ptr i8)))
(extern LLVMOrcLLJITGetGlobalPrefix :cc c [(ptr i8)] (-> i8))
(extern LLVMOrcLLJITGetDataLayoutStr :cc c [(ptr i8)] (-> (ptr i8)))
(extern LLVMOrcLLJITMangleAndIntern :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern LLVMOrcExecutionSessionCreateBareJITDylib :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern LLVMOrcJITDylibCreateResourceTracker :cc c [(ptr i8)] (-> (ptr i8)))
(extern LLVMOrcReleaseResourceTracker :cc c [(ptr i8)] (-> void))
(extern LLVMOrcResourceTrackerRemove :cc c [(ptr i8)] (-> (ptr i8)))
(extern LLVMOrcJITDylibClear :cc c [(ptr i8)] (-> (ptr i8)))
(extern LLVMOrcJITDylibDefine :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern LLVMOrcAbsoluteSymbols :cc c [(ptr SymbolPair) i64] (-> (ptr i8)))
(extern LLVMOrcDisposeMaterializationUnit :cc c [(ptr i8)] (-> void))
(extern LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess :cc c
  [(ptr (ptr i8)) i8 (ptr i8) (ptr i8)] (-> (ptr i8)))
(extern LLVMOrcJITDylibAddGenerator :cc c [(ptr i8) (ptr i8)] (-> void))
(extern LLVMOrcLLJITAddObjectFileWithRT :cc c [(ptr i8) (ptr i8) (ptr i8)] (-> (ptr i8)))
(extern LLVMOrcExecutionSessionLookup :cc c
  [(ptr i8) i32 (ptr SearchOrder) i64 (ptr LookupSymbol) i64
   (fnptr c [(ptr i8) (ptr SymbolPair) i64 (ptr i8)] void) (ptr i8)] (-> void))
(extern LLVMTargetMachineEmitToMemoryBuffer :cc c
  [(ptr i8) (ptr i8) i32 (ptr (ptr i8)) (ptr (ptr i8))] (-> i32))
(extern LLVMGetFirstUse :cc c [(ptr i8)] (-> (ptr i8)))
