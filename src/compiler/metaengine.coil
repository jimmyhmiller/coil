; src/compiler/metaengine.coil — the compiled metaprogram ENGINE.
;
; expand-stage3 (expander.coil) uses this module to turn the checked metaprogram
; sub-program into a dylib and run metaprogram entries as native code. It is THE
; engine — the tree-walking interpreter was deleted (decision 7):
;
;   metalower-program  (metalower.coil: Code -> (ptr i8), code ops -> metashim calls)
;   -> monomorphize -> the injected backend object builder -> cc -dynamiclib
;      -Wl,-undefined,dynamic_lookup   (coil_meta_* stay undefined until dlopen)
;   -> dlopen against the compiler process (linked -Wl,-export_dynamic, so the
;      metahost.coil exports resolve) -> dlsym each coil_mp_<k> entry.
;
; Every entry call runs on ITS OWN pthread: metahost's mh-halt implements
; `(primitive/error ...)` as record-the-Diag + pthread_exit, so the pipeline thread just
; joins, reads the Diag, and reports it as a located build error.
(module metaengine)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.io" :use *)
(import "coil.reader" :use *)
(import "parser" :use *)
(import "loader" :use *)
(import "ast" :use *)
(import "ctval" :use *)  ; CtVal / EnvBind / CtCtx (was reached via comptime.coil)
(import "astdump" :use *)
(import "resolve" :use *)
(import "comptime" :use *)
(import "mono" :use *)
(import "metalower" :use *)
(import "metahost" :use *)
(import "ffi" :use *)
(import "macho" :use *)  ; MObj — the in-memory object handed to jit.coil
(import "jit" :use *)

(extern dlopen :cc c [(ptr i8) i64] (-> (ptr i8)))
(extern dlsym :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern access :cc c [(ptr i8) i64] (-> i32))  ; F_OK=0: does the path exist
(extern rename :cc c [(ptr i8) (ptr i8)] (-> i32))
(extern unlink :cc c [(ptr i8)] (-> i32))
(extern malloc :cc c [isize] (-> (ptr i8)))
(extern pthread_mutex_init :cc c [(ptr i8) (ptr i8)] (-> i32))
(extern pthread_mutex_lock :cc c [(ptr i8)] (-> i32))
(extern pthread_mutex_unlock :cc c [(ptr i8)] (-> i32))
(extern pthread_cond_init :cc c [(ptr i8) (ptr i8)] (-> i32))
(extern pthread_cond_wait :cc c [(ptr i8) (ptr i8)] (-> i32))
(extern pthread_cond_signal :cc c [(ptr i8)] (-> i32))

; ---- portable counting semaphore --------------------------------------------------
; pthread mutex+condvar, replacing Darwin's dispatch_semaphore_* (which does not
; exist on ELF hosts). Same contract as the GCD trio it replaces: create(n),
; wait(sem, -1) = wait forever (the only timeout ever passed), signal(sem).
; The mutex/cond buffers are malloc'd oversized: pthread_mutex_t is 40 bytes on
; glibc and 64 on Darwin, pthread_cond_t 48 on both — 64 covers every host.
(defstruct MESem [(mtx (ptr i8)) (cnd (ptr i8)) (count i64)])
(defn me-sem-create [(value i64)] (-> (ptr i8))
  (let [s (primitive/cast (ptr MESem) (malloc (primitive/cast isize (primitive/sizeof MESem))))]
    (store! (field s mtx) (malloc 64))
    (store! (field s cnd) (malloc 64))
    (pthread_mutex_init (load (field s mtx)) (primitive/cast (ptr i8) 0))
    (pthread_cond_init (load (field s cnd)) (primitive/cast (ptr i8) 0))
    (store! (field s count) value)
    (primitive/cast (ptr i8) s)))
(defn me-sem-wait [(sp (ptr i8)) (timeout i64)] (-> i64)
  (let [s (primitive/cast (ptr MESem) sp)]
    (pthread_mutex_lock (load (field s mtx)))
    (loop (if (> (load (field s count)) (primitive/cast i64 0))
              (break)
              (do (pthread_cond_wait (load (field s cnd)) (load (field s mtx))) 0)))
    (store! (field s count) (primitive/isub (load (field s count)) 1))
    (pthread_mutex_unlock (load (field s mtx)))
    0))
(defn me-sem-signal [(sp (ptr i8))] (-> i64)
  (let [s (primitive/cast (ptr MESem) sp)]
    (pthread_mutex_lock (load (field s mtx)))
    (store! (field s count) (primitive/iadd (load (field s count)) 1))
    (pthread_cond_signal (load (field s cnd)))
    (pthread_mutex_unlock (load (field s mtx)))
    0))

; ---- host-OS probe ----------------------------------------------------------------
; The dylibs this module builds are dlopen'd into THIS process, so the link line and
; suffix follow the HOST, never --target. /proc/self/maps exists on every Linux and
; never on macOS; on macOS the probe is false and every branch below is exactly the
; historical mach-o one.
(defn me-host-linux? [] (-> bool)
  (= (primitive/cast i64 (access c"/proc/self/maps" 0)) (primitive/cast i64 0)))
(defn me-dylib-ext [] (-> (slice u8))
  (if (me-host-linux?) ".so" ".dylib"))
(defn me-dylib-link-cmd [] (-> (slice u8))
  (if (me-host-linux?) "cc -shared " "cc -dynamiclib "))
; ELF `-shared` allows undefined symbols by default; Mach-O needs the explicit opt-in.
(defn me-dylib-undef-flag [] (-> (slice u8))
  (if (me-host-linux?) "" " -Wl,-undefined,dynamic_lookup"))

; ---- the engine flag ------------------------------------------------------------
; True when a backend object builder is registered (main.coil registers the LLVM
; one; main_a64.coil registers the arm64 one since mac-12). The compiled engine is
; THE engine — the tree-walking interpreter and its COIL_META flag are gone
; (decision 7). A build with no registered builder cannot expand macros and fails
; loudly at engine setup.
(defn meta-compiled? [] (-> bool)
  (!= (load (field (meta-build-box) isset)) (primitive/cast i64 0)))

; ---- engine state ----------------------------------------------------------------
; An entry carries ITS build's quasiquote registry: the engine grows ADDITIVELY
; (per-qual staged builds + the final batch build), and each dylib's compiled code
; indexes into the registry of the metalower run that produced it.
; fp is the native dlsym'd entry (dylib path). For the wasm path fp=0 and the entry
; is (symbol, modbytes) instead: the coil_mp_<k> export name plus the side-module
; bytes (shared by every entry from one build), run via meta_run_wasm.
(defstruct MEEntry
  [(name (slice u8))
   (fp (ptr i8))
   (registry (ptr (ArrayList (ptr Sexp))))
   (symbol (slice u8))
   (modbytes (slice u8))
   (interpcx (ptr i8))])  ; interp path: the shared (ptr Interp) built for this batch
(defstruct MetaEngine
  [(active i64)
   (entries (ptr (ArrayList MEEntry)))])
(defn meta-engine [] (-> (ptr MetaEngine))
  (alloc/static MetaEngine))
(defn meta-engine-active? [] (-> bool)
  (!= (load (field (meta-engine) active)) (primitive/cast i64 0)))
; entry lookup by qual name; null when unknown. Deliberately NOT gated on `active`:
; a staged entry serves finish-macro during the tower rounds BEFORE the batch
; engine comes up (with staging off, entries only ever exist once active=1, so the
; behavior is unchanged there).
(defn meta-engine-entry [(name (slice u8))] (-> (ptr MEEntry))
  (let [b (meta-engine)
        es (load (field b entries))
        (mut r) (primitive/cast (ptr MEEntry) 0)]
    (if (= (primitive/cast i64 es) (primitive/cast i64 0))
        (load r)
        (let [n (al-len [MEEntry] (load es))
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (when (= (load (field (al-elem [MEEntry] es (load i)) name)) name)
                        (store! r (al-elem [MEEntry] es (load i)))
                        (break))
                      (store! i (primitive/iadd (load i) 1)))))
          (load r)))))

; ---- MAIN-THREAD execution (COIL_META_MAIN=1) --------------------------------------
; AppKit windows only work on the process main thread, so a GUI metaprogram cannot
; run on the engine's per-call worker thread. With COIL_META_MAIN=1, the driver's
; main thread (normally parked in pthread_join) runs this job loop instead, and
; every metaprogram entry is dispatched to it. The trade: `(primitive/error ...)` in this
; mode prints its diagnostic and exits the process (there is no thread to end),
; which is behaviorally the same failed build, minus multi-metaprogram continuation.
(defn meta-main? [] (-> bool)
  (let [v (getenv c"COIL_META_MAIN")]
    (if (= (primitive/cast i64 v) (primitive/cast i64 0)) false (= (cstr->slice v) "1"))))
(defstruct MainSvc [(isinit i64) (jobsem (ptr i8)) (donesem (ptr i8)) (finished i64) (call (ptr i8))])
(defn main-svc [] (-> (ptr MainSvc))
  (alloc/static MainSvc))
(defn main-svc-init! [] (-> i64)
  (let [b (main-svc)]
    (unless (!= (load (field b isinit)) (primitive/cast i64 0))
      (store! (field b jobsem) (me-sem-create 0))
      (store! (field b donesem) (me-sem-create 0))
      (store! (field b isinit) 1)
      0)))
; the driver's main thread sits here servicing metaprogram calls until the
; pipeline thread signals it is done (no-op unless main-svc-init! ran)
(defn main-svc-loop [] (-> i64)
  (let [b (main-svc)]
    (unless (= (load (field b isinit)) (primitive/cast i64 0))
      (loop (do
              (me-sem-wait (load (field b jobsem)) -1)
              (when (!= (load (field b finished)) (primitive/cast i64 0)) (break 0))
              (me-tramp (load (field b call)))
              (me-sem-signal (load (field b donesem))))))))
(defn main-svc-finish! [] (-> i64)
  (let [b (main-svc)]
    (unless (= (load (field b isinit)) (primitive/cast i64 0))
      (store! (field b finished) 1)
      (me-sem-signal (load (field b
                                  jobsem)))
      0)))
(defn main-svc-run [(c (ptr i8))] (-> i64)
  (let [b (main-svc)]
    (store! (field b call) c)
    (me-sem-signal (load (field b jobsem)))
    (me-sem-wait (load (field b donesem)) -1)
    0))

; ---- the program's --link-flag list (set by the driver) ----------------------------
; A metaprogram doing FFI needs the same frameworks/libraries the program would
; link (the dylib binds them at ITS link, not against the compiler process). They
; are part of the dylib cache key.
(defstruct MetaLinkBox [(isset i64) (flags (ptr (ArrayList (slice u8))))])
(defn meta-link-box [] (-> (ptr MetaLinkBox))
  (alloc/static MetaLinkBox))
(defn set-meta-link-flags! [(fl (ptr (ArrayList (slice u8))))] (-> i64)
  (let [b (meta-link-box)] (store! (field b flags) fl) (store! (field b isset) 1) 0))

; ---- backend object-builder injection (main.coil / main_a64.coil register one) ---
(defstruct MetaBuildBox [(isset i64) (fp (fnptr c [(ptr Allocator) (ptr Program) (ptr i8)] i64))])
(defn meta-build-box [] (-> (ptr MetaBuildBox))
  (alloc/static MetaBuildBox))

; ---- the -O level (driver sets it from -O0/-O1/-O2/-O3, default 3) -----------------
; One value per process, like the sanitize flag. main.coil::build-object reads it for
; BOTH the `default<On>` pass pipeline and the target machine's CodeGenOptLevel.
;
; It lives HERE rather than in driver.coil because the metaprogram dylib is built
; through that same build-object, so a metaprogram is compiled at whatever -O the
; command line asked for — and the content-addressed dylib cache below must therefore
; key on the level too, or a -O3 build silently reuses a dylib somebody compiled at
; -O0 and runs its macros in unoptimized code.
;
; `default<O3>` over the compiler's own ~11 MB of IR is the single largest phase of a
; build. -O0 trades the emitted program's speed for compile time: the right trade for
; a build you are about to throw away, the wrong one for anything you intend to run.
; LLVM-backend only — `--backend arm64` does its own codegen and never runs a pass
; pipeline, so -O is inert there, as it is for the comptime MObj path (which is arm64
; even in the LLVM build; see main.coil::meta-build-mobj-llvm).
(defstruct OptLevelBox [(isset i64) (level i64)])
(defn opt-level-box [] (-> (ptr OptLevelBox))
  (alloc/static OptLevelBox))
(defn set-opt-level! [(n i64)] (-> i64)
  (let [b (opt-level-box)] (store! (field b level) n) (store! (field b isset) 1) 0))
(defn opt-level [] (-> i64)
  (let [b (opt-level-box)]
    (if (= (load (field b isset)) (primitive/cast i64 0))
        3
        (load (field b
                     level)))))
; `--meta-opt=<n>` — the level for METAPROGRAM objects (the dylib built below, and the
; comptime objects comptime_eval builds through the same hook), independent of the -O
; the program itself gets. Unset = follow -O, so this changes nothing unless asked for.
;
; Worth separating because the two have opposite economics. A metaprogram is small but
; is REBUILT every time you edit it (the cache below is keyed on its own content), and
; then it RUNS over the whole program — so its level trades its compile time against
; its run time, on every iteration. The program object is the opposite: big, built once,
; and its level trades build time against a runtime you may not care about at all.
(defstruct MetaOptBox [(isset i64) (level i64)])
(defn meta-opt-box [] (-> (ptr MetaOptBox))
  (alloc/static MetaOptBox))
(defn set-meta-opt-level! [(n i64)] (-> i64)
  (let [b (meta-opt-box)] (store! (field b level) n) (store! (field b isset) 1) 0))
(defn meta-opt-level [] (-> i64)
  (let [b (meta-opt-box)]
    (if (= (load (field b isset)) (primitive/cast i64 0))
        (opt-level)
        (load (field b
                     level)))))
(defn opt-level-tag [] (-> (slice u8))
  (let [n (meta-opt-level)]
    (cond (= n (primitive/cast i64 0)) "O0|"
          (= n (primitive/cast i64 1)) "O1|"
          (= n (primitive/cast i64 2)) "O2|"
          :else "O3|")))
(defn set-meta-build-obj! [(fp (fnptr c [(ptr Allocator) (ptr Program) (ptr i8)] i64))] (-> i64)
  (let [b (meta-build-box)] (store! (field b fp) fp) (store! (field b isset) 1) 0))

; ---- in-memory object builder (the JIT path) --------------------------------------
; A backend that can hand back the object as an MObj instead of a file lets
; comptime_eval skip the whole serialize / fork `cc -dynamiclib` / dlopen round
; trip and load it straight into executable memory (jit.coil). The arm64 backend
; registers one (main_a64.coil); the LLVM backend has no MObj to give — it emits
; through LLVMTargetMachineEmitToFile — so with LLVM this stays unset and the
; dylib path below is used. Whichever runs, the CODEGEN is identical; only the way
; the bytes reach memory differs.
(defstruct MetaMobjBox [(isset i64) (fp (fnptr c [(ptr Allocator) (ptr Program)] MObj))])
(defn meta-mobj-box [] (-> (ptr MetaMobjBox))
  (alloc/static MetaMobjBox))
(defn set-meta-build-mobj! [(fp (fnptr c [(ptr Allocator) (ptr Program)] MObj))] (-> i64)
  (let [b (meta-mobj-box)] (store! (field b fp) fp) (store! (field b isset) 1) 0))
(defn meta-mobj-available? [] (-> bool)
  (!= (load (field (meta-mobj-box) isset)) (primitive/cast i64 0)))

; ---- WASM meta path: side-module builder + entry runner (registered by main_wasm) --
; When this compiler is itself hosted in a wasm sandbox it cannot dlopen a dylib or
; spawn a pthread. main_wasm.coil registers two hooks:
;   build : a mono'd metaprogram Program -> codegen_wasm side-module bytes (a module
;           that imports the compiler's memory + the exported mh_* callbacks).
;   run   : instantiate that side-module against the compiler instance and run one
;           coil_mp_<k> entry SYNCHRONOUSLY — via the host import meta_run_wasm, with
;           the side-module bytes, the entry symbol, and up to 8 boxed Sexp args.
; Both unset ⇒ the native dylib + pthread path. Keeping the wasm-only extern
; (meta_run_wasm) and the codegen_wasm import in main_wasm (not here) means the native
; main.coil / main_a64.coil builds never reference either.
; run-ct runs a compiled COMPTIME fold thunk (comptime_eval.coil): the same
; side-module mechanism, but the entry is coil_ct_thunk (no Sexp args). The host
; writes the scalar result bits into a caller cell (or, for an aggregate, the thunk
; writes through the buf pointer directly in shared memory) and returns the div-by-zero
; status code. Args: bytes, len, thunk-sym, status-sym, kind, cell/buf.
(defstruct MetaWasmBox
  [(isset i64)
   (build (fnptr c [(ptr Allocator) (ptr Program)] (slice u8)))
   (run (fnptr c
               [(ptr u8)
                i64
                (ptr i8)
                i64
                (ptr i8)
                (ptr i8)
                (ptr i8)
                (ptr i8)
                (ptr i8)
                (ptr i8)
                (ptr i8)
                (ptr i8)]
               (ptr i8)))
   (run-ct (fnptr c [(ptr u8) i64 (ptr i8) (ptr i8) i64 (ptr i8)] i64))])
(defn meta-wasm-box [] (-> (ptr MetaWasmBox))
  (alloc/static MetaWasmBox))
(defn set-meta-wasm! [(build (fnptr c [(ptr Allocator) (ptr Program)] (slice u8)))
                      (run (fnptr c
                                  [(ptr u8)
                                   i64
                                   (ptr i8)
                                   i64
                                   (ptr i8)
                                   (ptr i8)
                                   (ptr i8)
                                   (ptr i8)
                                   (ptr i8)
                                   (ptr i8)
                                   (ptr i8)
                                   (ptr i8)]
                                  (ptr i8)))
                      (run-ct (fnptr c [(ptr u8) i64 (ptr i8) (ptr i8) i64 (ptr i8)] i64))] (-> i64)
  (let [b (meta-wasm-box)]
    (store! (field b build) build)
    (store! (field b run) run)
    (store! (field b run-ct) run-ct)
    (store! (field b isset) 1)
    0))
(defn meta-wasm-active? [] (-> bool)
  (!= (load (field (meta-wasm-box) isset)) (primitive/cast i64 0)))

; ---- INTERPRETER meta path (registered by main*, gated on COIL_META_INTERP) ---------
; The simplest execution option: run a metaprogram by INTERPRETING its mono'd
; sub-program in-process (interp.coil) — no dylib, no JIT, no wasm side-module. `build`
; turns a mono'd Program into a persistent interpreter context (ptr Interp); `run`
; calls one coil_mp_<k> entry in that context with boxed Sexp arg cells and returns the
; result Code handle. The metashim mh_* callbacks the interpreter makes are dispatched
; back into the compiler via interp.coil's registered extern hook (main wires it).
; Registered only in the interp-mode entry ⇒ native dylib/wasm builds never reference it.
; run-ct interprets a COMPTIME fold context (comptime_eval.coil): given a built Interp
; cx, run coil.ct.thunk (scalar → bits into cell; aggregate → written through cell as a
; buf for kind 0) and coil.ct.status if present, returning the div-by-zero status.
(defstruct MetaInterpBox
  [(isset i64)
   (build (fnptr c [(ptr Allocator) (ptr Program)] (ptr i8)))
   (run (fnptr c [(ptr i8) (ptr i8) (ptr i64) i64] (ptr i8)))
   (run-ct (fnptr c [(ptr i8) i64 (ptr i8)] i64))])
(defn meta-interp-box [] (-> (ptr MetaInterpBox))
  (alloc/static MetaInterpBox))
(defn set-meta-interp! [(build (fnptr c [(ptr Allocator) (ptr Program)] (ptr i8)))
                        (run (fnptr c [(ptr i8) (ptr i8) (ptr i64) i64] (ptr i8)))
                        (run-ct (fnptr c [(ptr i8) i64 (ptr i8)] i64))] (-> i64)
  (let [b (meta-interp-box)]
    (store! (field b build) build)
    (store! (field b run) run)
    (store! (field b run-ct) run-ct)
    (store! (field b isset) 1)
    0))
(defn meta-interp-active? [] (-> bool)
  (!= (load (field (meta-interp-box) isset)) (primitive/cast i64 0)))

; Compile metaprograms with the ordinary arm64 backend and load the resulting
; object directly into executable memory. Unlike the interpreter this preserves
; native recursive-walk performance; unlike the dylib path it does not fork cc or
; touch the filesystem. The environment flag remains a CLI/debug opt-in; embedded
; JIT sessions enable the same engine directly, without mutating process environment.
(defstruct MetaJitBox [(on i64)])
(defn meta-jit-box [] (-> (ptr MetaJitBox))
  (alloc/static MetaJitBox))
(defn set-meta-jit! [(on bool)] (-> i64)
  (store! (field (meta-jit-box) on) (if on 1 0)))
(defn meta-jit-active? [] (-> bool)
  (let [v (getenv c"COIL_META_JIT")]
    (and (meta-mobj-available?)
         (or (!= (load (field (meta-jit-box) on)) (primitive/cast i64 0))
             (and (!= (primitive/cast i64 v) 0) (= (cstr->slice v) "1"))))))

; ---- wasm-sandbox flag: no pthread. Set by the wasm-hosted entry (main_wasm); makes
; run-on-big-stack run the pipeline inline (the sandbox is single-threaded and the
; shadow stack is the whole reserved stack). Distinct from meta-interp-active?, which
; a NATIVE build may set (COIL_META_INTERP=1) while still wanting the 512 MiB pthread.
(defstruct WasmSandboxBox [(on i64)])
(defn wasm-sandbox-box [] (-> (ptr WasmSandboxBox))
  (alloc/static WasmSandboxBox))
(defn set-wasm-sandbox! [(v i64)] (-> i64)
  (store! (field (wasm-sandbox-box) on) v)
  0)
(defn wasm-sandbox? [] (-> bool)
  (!= (load (field (wasm-sandbox-box) on)) (primitive/cast i64 0)))

; ---- unique scratch paths ---------------------------------------------------------
; per-process uniqueness from the static box's (ASLR-randomized) address, plus a
; counter for multiple engine builds in one process. No extra libc externs needed.
(defstruct MECounter [(n i64)])
(defn me-counter [] (-> (ptr MECounter))
  (alloc/static MECounter))
(defn me-unique [(a (ptr Allocator))] (-> (slice u8))
  (let [c (me-counter)
        k (load (field c n))]
    (store! (field c n) (primitive/iadd k 1))
    (sconcat3 a (dec->str a (primitive/udiv (primitive/cast i64 (me-counter)) 16)) "-" (dec->str a k))))

; ---- the sub-program's form list (BEFORE its resolve) ------------------------------
; ALWAYS a FRESH list: both the shim (compiled engine) and the definition-time
; expansion tower (expander.coil) replace entries/subtrees for the SUB-PROGRAM
; only — s.out and its buffer must stay untouched (box-al shares the buffer, and
; growing or writing through the copy corrupts the main program's forms).
; Under the compiled engine, metashim.coil's forms (module tag "metashim") are
; appended so metalower's rewritten code ops resolve; the embedded text is
; registered as a real source (id from srccount, exactly like the loader) so spans
; in shim diagnostics point somewhere meaningful.
(defn meta-copy-sexp [(a (ptr Allocator)) (x (ptr Sexp))] (-> Sexp)
  (let [tag (sx-tag (load x))]
    (if (or (= tag (primitive/cast i64 6)) (= tag (primitive/cast i64 7)))
        (let [items (sx-items (load x))
              n (sx-len items)
              (mut out) (al-new [Sexp] a)
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (al-push! (mut out) (meta-copy-sexp a (al-elem [Sexp] items (load i))))
                      (store! i (primitive/iadd (load i) 1)))))
          (mk-sexp-src (if (= tag (primitive/cast i64 6))
                           (KList (box-al [Sexp] a (load out)))
                           (KVec (box-al [Sexp] a (load out))))
                       x))
        (load x))))

(defn meta-sub-forms [(a (ptr Allocator)) (s (mut LS)) (base (ptr (ArrayList TaggedForm)))] (-> (Result (ptr (ArrayList TaggedForm))
                                                                                                        Diag))
  (let [(mut out) (al-new [TaggedForm] a)
        nb (al-len [TaggedForm] (load base))
        (mut k) 0]
    (loop (if (>= (load k) nb)
              (break)
              (do
                (let [src (al-elem [TaggedForm] base (load k))
                      dst (alloc/stack TaggedForm)]
                  (store! (field dst form) (meta-copy-sexp a (field src form)))
                  (store! (field dst module) (load (field src module)))
                  (al-push! (mut out) (load dst)))
                (store! k (primitive/iadd (load k) 1)))))
    (if (not (meta-compiled?))
        (Ok [(ptr (ArrayList TaggedForm)) Diag] (box-al [TaggedForm] a (load out)))
        ; The wasm AND interpreter meta paths inject metashim_wasm.coil (mp-* call the
        ; mh_* callbacks as externs — env imports in wasm, interp-hook dispatch in the
        ; interpreter) instead of metashim.coil (mp-* call through the in-process vtable).
        (let [text
                (if (or (meta-wasm-active?) (meta-interp-active?))
                    (include-str "metashim_wasm.coil")
                    (include-str "metashim.coil"))
              sid (load (field s srccount))]
          (store! (field s srccount) (primitive/iadd sid 1))
          (register-source! (mut s) "<metashim>" text)
          (match (read-all a text sid)
            (Err [d] (Err [(ptr (ArrayList TaggedForm)) Diag] d))
            (Ok [forms]
                (let [n (al-len [Sexp] (load forms))
                      (mut i) 0]
                  (loop (if (>= (load i) n)
                            (break)
                            (do
                              (let [f (al-elem [Sexp] forms (load i))
                                    head (l-list-head f)
                                    ismod (match head (Some [h] (= h "module")) (None [] false))
                                    isimport (match head (Some [h] (= h "import")) (None [] false))]
                                (if isimport
                                    (process-import (mut s) f (bundled-base) (Some "metashim"))
                                    (unless ismod (al-push! (mut out) (mk-tagged (load f) (Some "metashim"))) 0)))
                              (store! i (primitive/iadd (load i) 1)))))
                  (Ok [(ptr (ArrayList TaggedForm)) Diag] (box-al [TaggedForm] a (load out))))))))))

; closure seeds for the engine: the metaprogram entries PLUS every metashim
; function (the lowering's calls to them are created after the closure walk runs).
(defn meta-shim-seeds [(a (ptr Allocator)) (macroctx (ptr Program)) (quals (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (al-new [(slice u8)] a)
        nq (al-len [(slice u8)] (load quals))
        (mut i) 0]
    (loop (if (>= (load i) nq)
              (break)
              (do
                (al-push! (mut out) (al-get [(slice u8)] (load quals) (load i)))
                (store! i
                        (primitive/iadd (load i) 1)))))
    (let [fs (load (field macroctx funcs))
          nf (al-len [Func] (load fs))
          (mut j) 0]
      (loop (if (>= (load j) nf)
                (break)
                (do
                  (let [nm (func-name (al-get [Func] (load fs) (load j)))]
                    (when (starts-with nm "metashim.") (al-push! (mut out) nm) 0))
                  (store! j (primitive/iadd (load j) 1))))))
    (box-al [(slice u8)] a (load out))))

; ---- the content-addressed dylib cache ---------------------------------------------
; Key = FNV-1a over the DUMPED mono'd metaprogram program (astdump's d-program, the
; deterministic oracle dumper) + the entry symbol map. SELF-VALIDATING against
; compiler changes: any change that alters what would be compiled alters the dump;
; a change that leaves the dump identical produces an identical dylib anyway.
; Location: $HOME/.cache/coil/metaprog/. Kill switch: COIL_META_CACHE=0.
(defstruct FnvCell [(h i64)])
(defn me-fnv-write [(ctx (ptr i8)) (buf (ptr i8)) (n i64)] (-> (Result i64 IoError))
  (let [c (primitive/cast (ptr FnvCell) ctx)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (store! (field c h)
                        (primitive/imul (primitive/ixor (load (field c h))
                                                        (primitive/iand (primitive/cast i64
                                                                                        (load (primitive/index buf
                                                                                                               (load i))))
                                                                        255))
                                        1099511628211))
                (store! i (primitive/iadd (load i) 1)))))
    (Ok [i64 IoError] n)))
(defn me-fnv-str [(c (ptr FnvCell)) (s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (store! (field c h)
                        (primitive/imul (primitive/ixor (load (field c h)) (primitive/cast i64 (slice-get s (load i))))
                                        1099511628211))
                (store! i (primitive/iadd (load i) 1)))))
    0))
(defn me-hex [(a (ptr Allocator)) (v i64)] (-> (slice u8))
  (let [buf (primitive/cast (ptr u8) (unwrap-ptr [i8] (raw-alloc a 16 1)))
        (mut i) 0]
    (loop (if (>= (load i) (primitive/cast i64 16))
              (break)
              (do
                (let [d (primitive/iand (primitive/ishr v (primitive/imul (primitive/isub 15 (load i)) 4)) 15)]
                  (store! (primitive/index buf (load i))
                          (primitive/cast u8
                                          (if (< d (primitive/cast i64 10)) (primitive/iadd 48 d) (primitive/iadd 87 d)))))
                (store! i (primitive/iadd (load i) 1)))))
    (slice-new buf 16)))
(defn me-program-key [(a (ptr Allocator)) (mp (ptr Program)) (entries (ptr (ArrayList MLEntry)))] (-> (slice u8))
  (let [c (alloc/stack FnvCell)
        w (alloc/stack Writer)]
    (store! (field c h) -3750763034362895579)  ; FNV-1a offset basis
    (me-fnv-str c "coil-metaprog-v1|")
    (me-fnv-str c (opt-level-tag))  ; same program at a different -O is a different dylib
    (store! (field w write-fn) (primitive/fnptr-of me-fnv-write))
    (store! (field w ctx) (primitive/cast (ptr i8) c))
    (d-program w mp a)
    (let [n (al-len [MLEntry] (load entries))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (me-fnv-str c (load (field (al-elem [MLEntry] entries (load i)) name)))
                  (me-fnv-str c "=")
                  (me-fnv-str c (load (field (al-elem [MLEntry] entries (load i)) symbol)))
                  (me-fnv-str c ";")
                  (store! i (primitive/iadd (load i) 1))))))
    ; the link flags are part of what the dylib IS (frameworks a metaprogram binds)
    (let [lb (meta-link-box)]
      (unless (= (load (field lb isset)) (primitive/cast i64 0))
        (let [fl (load (field lb flags))
              n (al-len [(slice u8)] (load fl))
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (me-fnv-str c (al-get [(slice u8)] (load fl) (load i)))
                      (me-fnv-str c "|")
                      (store! i (primitive/iadd (load i) 1)))))
          0)))
    (me-hex a (load (field c h)))))
; the program's --link-flag list, space-joined (empty string if none)
(defn me-link-flags-str [(a (ptr Allocator))] (-> (slice u8))
  (let [lb (meta-link-box)]
    (if (= (load (field lb isset)) (primitive/cast i64 0))
        ""
        (let [fl (load (field lb flags))
              n (al-len [(slice u8)] (load fl))
              (mut out) ""
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (store! out (sconcat a (sconcat a (load out) " ") (al-get [(slice u8)] (load fl) (load i))))
                      (store! i (primitive/iadd (load i) 1)))))
          (load out)))))
(defn me-cache-on? [] (-> bool)
  (let [v (getenv c"COIL_META_CACHE")]
    (if (= (primitive/cast i64 v) (primitive/cast i64 0)) true (not (= (cstr->slice v) "0")))))
(defn me-cache-dir [(a (ptr Allocator))] (-> (Option (slice u8)))
  (let [h (getenv c"HOME")]
    (if (= (primitive/cast i64 h) (primitive/cast i64 0))
        (None [(slice u8)])
        (Some (sconcat a (cstr->slice h) "/.cache/coil/metaprog")))))

; dlopen + the vtable handshake (hand the dylib the host callbacks BEFORE any
; entry can run — see metashim.coil coil_mp_init)
(defn me-open-dylib [(a (ptr Allocator)) (path (slice u8))] (-> (Result (ptr i8) Diag))
  (let [h (dlopen (str->cstr a path) 2)]
    (if (= (primitive/cast i64 h) (primitive/cast i64 0))
        (Err [(ptr i8) Diag] (derr "metaengine: dlopen of the metaprogram dylib failed"))
        (let [ini (dlsym h (str->cstr a "coil_mp_init"))]
          (if (= (primitive/cast i64 ini) (primitive/cast i64 0))
              (Err [(ptr i8) Diag] (derr "metaengine: coil_mp_init missing from the metaprogram dylib (compiler bug)"))
              (do
                (primitive/call-ptr (primitive/cast (fnptr c [(ptr i8)] i64) ini) (meta-vtable))
                (Ok [(ptr i8) Diag] h)))))))

; ---- build the metaprogram dylib ---------------------------------------------------
(defn meta-build-dylib [(a (ptr Allocator)) (lowered (ptr Program)) (entries (ptr (ArrayList MLEntry)))] (-> (Result (ptr i8)
                                                                                                                     Diag))
  (try (do
         (let [bb (meta-build-box)]
           (when (= (load (field bb isset)) (primitive/cast i64 0))
             (break :try
                      (Err [(ptr i8) Diag]
                           (derr "metaengine: this compiler build has no backend object builder registered, so it cannot compile metaprograms (compiler bug)"))))
           (let [mp (try! (monomorphize a lowered))]
             (sort-mono-program a mp)
             (let [cdir (if (me-cache-on?) (me-cache-dir a) (None [(slice u8)]))
                   cpath
                     (match cdir
                       (None [] (None [(slice u8)]))
                       (Some [d] (Some (sconcat a (sconcat3 a d "/" (me-program-key a mp entries)) (me-dylib-ext)))))]
               ; cache hit: the dylib for this exact program already exists
               (match cpath
                 (Some [p]
                       (when (= (primitive/cast i64 (access (str->cstr a p) 0)) (primitive/cast i64 0))
                         (break :try (me-open-dylib a p))))
                 (None [] 0))
               (let [id (me-unique a)
                     obj-s (sconcat3 a "/tmp/coil-mp-" id ".o")
                     tmp-s (sconcat3 a "/tmp/coil-mp-" id (me-dylib-ext))]
                 (primitive/call-ptr (load (field bb fp)) a mp (str->cstr a obj-s))
                 (let [cmd
                         (sconcat a
                                  (sconcat a
                                           (sconcat3 a (me-dylib-link-cmd) obj-s " -o ")
                                           (sconcat a tmp-s (me-dylib-undef-flag)))
                                  (me-link-flags-str a))]
                   (if (!= (primitive/cast i64 (system (str->cstr a cmd))) (primitive/cast i64 0))
                       (Err [(ptr i8) Diag] (derr "metaengine: linking the metaprogram dylib failed"))
                       (do
                         (unlink (str->cstr a obj-s))
                         ; move into the cache (mkdir -p once; rename is atomic on one fs)
                         (match cpath
                           (Some [p]
                                 (match cdir
                                   (Some [d]
                                         (do
                                           (system (str->cstr a (sconcat a "mkdir -p " d)))
                                           (when (= (primitive/cast i64
                                                                    (rename (str->cstr a tmp-s) (str->cstr a p)))
                                                    (primitive/cast i64 0))
                                             (break :try (me-open-dylib a p)))))
                                   (None [] 0)))
                           (None [] 0))
                         ; no cache (or rename failed): open the temp dylib directly
                         (me-open-dylib a tmp-s)))))))))))

; ---- entry-set construction: native dylib path ------------------------------------
; monomorphize+build+dlopen the metaprogram dylib, then dlsym each coil_mp_<k> entry
; into an MEEntry carrying its native function pointer.
(defn me-setup-native [(a (ptr Allocator)) (mo (ptr MLOut))] (-> (Result (ptr (ArrayList MEEntry)) Diag))
  (match (meta-build-dylib a (load (field mo prog)) (load (field mo entries)))
    (Err [d] (Err [(ptr (ArrayList MEEntry)) Diag] d))
    (Ok [h]
        (let [es (load (field mo entries))
              n (al-len [MLEntry] (load es))
              (mut out) (al-new [MEEntry] a)
              (mut i) 0
              (mut failed) (None [Diag])]
          (loop (if (or (diag-some? (load failed)) (>= (load i) n))
                    (break)
                    (do
                      (let [ep (al-elem [MLEntry] es (load i))
                            fp (dlsym h (str->cstr a (load (field ep symbol))))]
                        (if (= (primitive/cast i64 fp) (primitive/cast i64 0))
                            (do
                              (store! failed
                                      (Some (derr (sconcat3 a
                                                            "metaengine: entry '"
                                                            (load (field ep name))
                                                            "' missing from the metaprogram dylib (compiler bug)"))))
                              0)
                            (let [me (alloc/stack MEEntry)]
                              (store! (field me name) (load (field ep name)))
                              (store! (field me fp) fp)
                              (store! (field me registry) (load (field mo registry)))
                              (store! (field me symbol) (load (field ep symbol)))
                              (store! (field me modbytes) "")
                              (store! (field me interpcx) (primitive/cast (ptr i8) 0))
                              (al-push! (mut out) (load me))
                              0)))
                      (store! i (primitive/iadd (load i) 1)))))
          (match (load failed)
            (Some [d] (Err [(ptr (ArrayList MEEntry)) Diag] d))
            (None [] (Ok [(ptr (ArrayList MEEntry)) Diag] (box-al [MEEntry] a (load out)))))))))

; ---- entry-set construction: wasm side-module path ---------------------------------
; monomorphize + codegen_wasm into ONE side-module (bytes shared by every entry of
; this build); each MEEntry carries its coil_mp_<k> export symbol and those bytes,
; run later via meta_run_wasm. No dlopen, no fp.
(defn me-setup-wasm [(a (ptr Allocator)) (mo (ptr MLOut))] (-> (Result (ptr (ArrayList MEEntry)) Diag))
  (try (do
         (let [mp (try! (monomorphize a (load (field mo prog))))]
           (sort-mono-program a mp)
           (let [bytes (primitive/call-ptr (load (field (meta-wasm-box) build)) a mp)
                 es (load (field mo entries))
                 n (al-len [MLEntry] (load es))
                 (mut out) (al-new [MEEntry] a)
                 (mut i) 0]
             (loop (if (>= (load i) n)
                       (break)
                       (do
                         (let [ep (al-elem [MLEntry] es (load i))
                               me (alloc/stack MEEntry)]
                           (store! (field me name) (load (field ep name)))
                           (store! (field me fp) (primitive/cast (ptr i8) 0))
                           (store! (field me registry) (load (field mo registry)))
                           (store! (field me symbol) (load (field ep symbol)))
                           (store! (field me modbytes) bytes)
                           (store! (field me interpcx) (primitive/cast (ptr i8) 0))
                           (al-push! (mut out) (load me)))
                         (store! i (primitive/iadd (load i) 1)))))
             (Ok [(ptr (ArrayList MEEntry)) Diag] (box-al [MEEntry] a (load out))))))))

; ---- entry-set construction: interpreter path --------------------------------------
; monomorphize + sort, then build ONE persistent interpreter context (shared by every
; entry of this build). Each MEEntry carries its coil_mp_<k> symbol and that context;
; the entry is run by interpreting it. No dylib, no side-module, no fp.
(defn me-setup-interp [(a (ptr Allocator)) (mo (ptr MLOut))] (-> (Result (ptr (ArrayList MEEntry)) Diag))
  (try (do
         (let [mp (try! (monomorphize a (load (field mo prog))))]
           (sort-mono-program a mp)
           (let [cx (primitive/call-ptr (load (field (meta-interp-box) build)) a mp)
                 es (load (field mo entries))
                 n (al-len [MLEntry] (load es))
                 (mut out) (al-new [MEEntry] a)
                 (mut i) 0]
             (loop (if (>= (load i) n)
                       (break)
                       (do
                         (let [ep (al-elem [MLEntry] es (load i))
                               me (alloc/stack MEEntry)]
                           (store! (field me name) (load (field ep name)))
                           (store! (field me fp) (primitive/cast (ptr i8) 0))
                           (store! (field me registry) (load (field mo registry)))
                           (store! (field me symbol) (load (field ep symbol)))
                           (store! (field me modbytes) "")
                           (store! (field me interpcx) cx)
                           (al-push! (mut out) (load me)))
                         (store! i (primitive/iadd (load i) 1)))))
             (Ok [(ptr (ArrayList MEEntry)) Diag] (box-al [MEEntry] a (load out))))))))

(defn me-setup-jit [(a (ptr Allocator)) (mo (ptr MLOut))] (-> (Result (ptr (ArrayList MEEntry)) Diag))
  (try (do
         (let [mp (try! (monomorphize a (load (field mo prog))))]
           (sort-mono-program a mp)
           (let [(mut obj) (primitive/call-ptr (load (field (meta-mobj-box) fp)) a mp)]
             (match (jit-load a (mut obj))
               (Err [e0]
                    (let [e (alloc/stack JitErr)]
                      (store! e e0)
                      (Err [(ptr (ArrayList MEEntry)) Diag] (derr (load (field e msg))))))
               (Ok [img0]
                   (let [img (unwrap-ptr [JitImage] (create [JitImage] a))
                         es (load (field mo entries))
                         n (al-len [MLEntry] (load es))
                         (mut out) (al-new [MEEntry] a)
                         (mut i) 0]
                     (store! img img0)
                     (let [init (jit-lookup img "coil_mp_init")]
                       (when (= (primitive/cast i64 init) 0)
                         (return-from :try
                                        (Err [(ptr (ArrayList MEEntry)) Diag]
                                             (derr "metaengine: JIT image is missing coil_mp_init"))))
                       (primitive/call-ptr (primitive/cast (fnptr c [(ptr i8)] i64) init)
                                           (meta-vtable)))
                     (loop (if (>= (load i) n)
                               (break)
                               (do
                                 (let [ep (al-elem [MLEntry] es (load i))
                                       me (alloc/stack MEEntry)
                                       fp (jit-lookup img (load (field ep symbol)))]
                                   (when (= (primitive/cast i64 fp) 0)
                                     (return-from :try
                                                    (Err [(ptr (ArrayList MEEntry)) Diag]
                                                         (derr "metaengine: JIT image is missing a metaprogram entry"))))
                                   (store! (field me name) (load (field ep name)))
                                   (store! (field me fp) fp)
                                   (store! (field me registry) (load (field mo registry)))
                                   (store! (field me symbol) (load (field ep symbol)))
                                   (store! (field me modbytes) "")
                                   (store! (field me interpcx) (primitive/cast (ptr i8) 0))
                                   (al-push! (mut out) (load me)))
                                 (store! i (primitive/iadd (load i) 1)))))
                     (Ok [(ptr (ArrayList MEEntry)) Diag] (box-al [MEEntry] a (load out)))))))))))

; ---- one-time engine setup (from expand-stage3, after check-program) ----------------
(defn meta-engine-setup [(a (ptr Allocator)) (checked (ptr Program)) (quals (ptr (ArrayList (slice u8))))] (-> (Option Diag))
  (match (metalower-program a checked quals)
    (Err [d] (Some d))
    (Ok [mo]
        (match (if (meta-jit-active?)
                   (me-setup-jit a mo)
                   (if (meta-interp-active?)
                       (me-setup-interp a mo)
                       (if (meta-wasm-active?) (me-setup-wasm a mo) (me-setup-native a mo))))
          (Err [d] (Some d))
          (Ok [outl]
              (let [out (load outl)]
                ; ADDITIVE: append entries whose name isn't served yet (staged
                ; per-qual builds land first; the batch build fills in the rest).
                ; An existing entry wins — it is the same macro, already compiled.
                (let [b (meta-engine)]
                  (when (= (primitive/cast i64 (load (field b entries))) (primitive/cast i64 0))
                    (store! (field b entries) (box-al [MEEntry] a (al-new [MEEntry] a)))
                    0)
                  (let [no (al-len [MEEntry] out)
                        (mut k) 0]
                    (loop (if (>= (load k) no)
                              (break)
                              (do
                                (let [mev (al-get [MEEntry] out (load k))
                                      mep (alloc/stack MEEntry)]
                                  (store! mep mev)
                                  (when (= (primitive/cast i64
                                                           (meta-engine-entry (load (field mep
                                                                                           name))))
                                           (primitive/cast i64 0))
                                    (al-push! (mut (load (field b entries))) (load mep))
                                    0))
                                (store! k (primitive/iadd (load k) 1))))))
                  (store! (field b active) 1)
                  (None [Diag]))))))))

; ---- invoking an entry ---------------------------------------------------------------
; The call runs on its own 32 MiB pthread (mirroring run-on-big-stack): metaprograms
; recurse like the pipeline does, and mh-halt ends only THIS thread on a
; metaprogram-level failure.
(defstruct MPCall
  [(fp (ptr i8))
   (argc i64)
   (ret (ptr i8))
   (a0 (ptr i8))
   (a1 (ptr i8))
   (a2 (ptr i8))
   (a3 (ptr i8))
   (a4 (ptr i8))
   (a5 (ptr i8))
   (a6 (ptr i8))
   (a7 (ptr i8))])
(defn me-tramp [(arg (ptr i8))] (-> (ptr i8))
  (let [c (primitive/cast (ptr MPCall) arg)
        fp (load (field c fp))
        n (load (field c argc))]
    (store! (field c ret)
            (if (= n (primitive/cast i64 0))
                (primitive/call-ptr (primitive/cast (fnptr c [] (ptr i8)) fp))
                (if (= n (primitive/cast i64 1))
                    (primitive/call-ptr (primitive/cast (fnptr c [(ptr i8)] (ptr i8)) fp)
                                        (load (field c
                                                     a0)))
                    (if (= n (primitive/cast i64 2))
                        (primitive/call-ptr (primitive/cast (fnptr c [(ptr i8) (ptr i8)] (ptr i8)) fp)
                                            (load (field c
                                                         a0))
                                            (load (field c
                                                         a1)))
                        (if (= n (primitive/cast i64 3))
                            (primitive/call-ptr (primitive/cast (fnptr c [(ptr i8) (ptr i8) (ptr i8)] (ptr i8)) fp)
                                                (load (field c a0))
                                                (load (field c a1))
                                                (load (field c a2)))
                            (if (= n (primitive/cast i64 4))
                                (primitive/call-ptr (primitive/cast (fnptr c
                                                                           [(ptr i8) (ptr i8) (ptr i8) (ptr i8)]
                                                                           (ptr i8))
                                                                    fp)
                                                    (load (field c a0))
                                                    (load (field c a1))
                                                    (load (field c a2))
                                                    (load (field c a3)))
                                (if (= n (primitive/cast i64 5))
                                    (primitive/call-ptr (primitive/cast (fnptr c
                                                                               [(ptr i8)
                                                                                (ptr i8)
                                                                                (ptr i8)
                                                                                (ptr i8)
                                                                                (ptr i8)]
                                                                               (ptr i8))
                                                                        fp)
                                                        (load (field c a0))
                                                        (load (field c a1))
                                                        (load (field c a2))
                                                        (load (field c a3))
                                                        (load (field c a4)))
                                    (if (= n (primitive/cast i64 6))
                                        (primitive/call-ptr (primitive/cast (fnptr c
                                                                                   [(ptr i8)
                                                                                    (ptr i8)
                                                                                    (ptr i8)
                                                                                    (ptr i8)
                                                                                    (ptr i8)
                                                                                    (ptr i8)]
                                                                                   (ptr i8))
                                                                            fp)
                                                            (load (field c a0))
                                                            (load (field c a1))
                                                            (load (field c a2))
                                                            (load (field c a3))
                                                            (load (field c a4))
                                                            (load (field c a5)))
                                        (if (= n (primitive/cast i64 7))
                                            (primitive/call-ptr (primitive/cast (fnptr c
                                                                                       [(ptr i8)
                                                                                        (ptr i8)
                                                                                        (ptr i8)
                                                                                        (ptr i8)
                                                                                        (ptr i8)
                                                                                        (ptr i8)
                                                                                        (ptr i8)]
                                                                                       (ptr i8))
                                                                                fp)
                                                                (load (field c a0))
                                                                (load (field c a1))
                                                                (load (field c a2))
                                                                (load (field c a3))
                                                                (load (field c a4))
                                                                (load (field c a5))
                                                                (load (field c a6)))
                                            (primitive/call-ptr (primitive/cast (fnptr c
                                                                                       [(ptr i8)
                                                                                        (ptr i8)
                                                                                        (ptr i8)
                                                                                        (ptr i8)
                                                                                        (ptr i8)
                                                                                        (ptr i8)
                                                                                        (ptr i8)
                                                                                        (ptr i8)]
                                                                                       (ptr i8))
                                                                                fp)
                                                                (load (field c a0))
                                                                (load (field c a1))
                                                                (load (field c a2))
                                                                (load (field c a3))
                                                                (load (field c a4))
                                                                (load (field c a5))
                                                                (load (field c a6))
                                                                (load (field c a7))))))))))))
    (primitive/cast (ptr i8) 0)))

; One native metaprogram runs at a time, so a process-wide worker can reuse both
; its pthread and its reserved deep stack. The old path created/joined a 256 MiB
; worker for every macro/checker invocation. A metaprogram error still exits only
; this worker: mh-halt wakes the caller through the abort hook, and the next call
; lazily starts a replacement.
(defstruct MEWorker
  [(ready i64)
   (alive i64)
   (request (ptr i8))
   (done (ptr i8))
   (tid (ptr i8))
   (call (ptr MPCall))])
(defn me-worker [] (-> (ptr MEWorker))
  (alloc/static MEWorker))
(defn me-worker-abort-wake [(ctx (ptr i8))] (-> i64)
  (me-sem-signal (load (field (primitive/cast (ptr MEWorker) ctx) done))))
(defn me-worker-entry [(arg (ptr i8))] (-> (ptr i8))
  (let [w (primitive/cast (ptr MEWorker) arg)]
    (loop (do
            (me-sem-wait (load (field w request)) -1)
            (me-tramp (primitive/cast (ptr i8) (load (field w call))))
            (me-sem-signal (load (field w done))))))
  (primitive/cast (ptr i8) 0))
(defn me-worker-start! [(w (ptr MEWorker))] (-> i64)
  (when (= (load (field w ready)) (primitive/cast i64 0))
    (store! (field w request) (me-sem-create 0))
    (store! (field w done) (me-sem-create 0))
    (store! (field w ready) 1)
    0)
  (let [attr (alloc/stack (array i8 64))
        tid (alloc/stack (ptr i8))]
    (pthread_attr_init (primitive/cast (ptr i8) attr))
    (pthread_attr_setstacksize (primitive/cast (ptr i8) attr) (worker-stack-size))
    (pthread_attr_setguardsize (primitive/cast (ptr i8) attr) (worker-guard-size))
    (pthread_create (primitive/cast (ptr i8) tid)
                    (primitive/cast (ptr i8) attr)
                    (primitive/fnptr-of me-worker-entry)
                    (primitive/cast (ptr i8) w))
    (pthread_attr_destroy (primitive/cast (ptr i8) attr))
    (store! (field w tid) (load tid))
    (store! (field w alive) 1)
    0))
(defn me-worker-call [(c (ptr MPCall))] (-> bool)
  (let [w (me-worker)]
    (when (= (load (field w alive)) (primitive/cast i64 0)) (me-worker-start! w) 0)
    (store! (field w call) c)
    (meta-host-abort-hook! (primitive/cast (ptr i8) (primitive/fnptr-of me-worker-abort-wake))
                           (primitive/cast (ptr i8) w))
    (me-sem-signal (load (field w request)))
    (me-sem-wait (load (field w done)) -1)
    (meta-host-abort-hook! (primitive/cast (ptr i8) 0) (primitive/cast (ptr i8) 0))
    (match (meta-host-err)
      (Some [_]
            (do
              ; mh-halt exited the worker. Reap its stack now; the next call starts
              ; a clean replacement instead of reusing corrupted control state.
              (pthread_join (load (field w tid)) (primitive/cast (ptr i8) 0))
              (store! (field w alive) 0)
              true))
      (None [] false))))

(defn me-box-arg [(a (ptr Allocator)) (s Sexp)] (-> (ptr i8))
  (let [p (unwrap-ptr [Sexp] (create [Sexp] a))] (store! p s) (primitive/cast (ptr i8) p)))

; run one metaprogram entry by INTERPRETING it (in-process, single-threaded). The
; boxed Sexp arg pointers go into an i64 arg-cell buffer; the interpreter runs the
; entry, its metashim mh_* callbacks dispatched back into this process. A
; metaprogram-level (primitive/error …) sets mh-halt's abort flag, which the VM polls and
; unwinds cleanly — errset then carries the diagnostic (meta-host-err), reported here.
(defn meta-engine-invoke-interp [(a (ptr Allocator))
                                 (symbol (slice u8))
                                 (interpcx (ptr i8))
                                 (reg (ptr (ArrayList (ptr Sexp))))
                                 (cx (ptr CtCtx))
                                 (argv (ptr (ArrayList Sexp)))] (-> (Result Sexp Diag))
  (let [n (al-len [Sexp] (load argv))]
    (if (> n (primitive/cast i64 8))
        (Err [Sexp Diag] (derr "metaengine: metaprogram entries with more than 8 parameters are not supported yet"))
        (do
          (meta-host-set! cx reg)
          (meta-host-interp! 1)  ; enable interp-mode mh-halt + clear the abort flag
          (let [argbuf (alloc/stack (array i64 8))
                (mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (store! (primitive/index (primitive/cast (ptr i64) argbuf) (load i))
                                (primitive/cast i64 (me-box-arg a (al-get [Sexp] (load argv) (load i)))))
                        (store! i (primitive/iadd (load i) 1)))))
            (let [rp
                    (primitive/call-ptr (load (field (meta-interp-box) run))
                                        interpcx
                                        (str->cstr a symbol)
                                        (primitive/cast (ptr i64) argbuf)
                                        n)]
              (match (meta-host-err)
                (Some [d] (do (meta-host-interp! 0) (Err [Sexp Diag] d)))
                (None []
                      (do
                        (meta-host-interp! 0)
                        (if (= (primitive/cast i64 rp) (primitive/cast i64 0))
                            (Err [Sexp Diag]
                                 (derr "metaengine: interpreted metaprogram returned a null Code handle (compiler bug)"))
                            (Ok [Sexp Diag] (load (primitive/cast (ptr Sexp) rp)))))))))))))

; run one metaprogram entry as a wasm side-module (single-threaded, no pthread).
; The side-module bytes + entry symbol come from the MEEntry; args are boxed Sexp
; handles into THIS compiler's memory, which the host-instantiated side-module shares
; (its mp-* wrappers call back into the exported mh_* running here). Returns the
; result Sexp handle the entry produced, dereferenced out of that shared memory.
(defn meta-engine-invoke-wasm [(a (ptr Allocator))
                               (symbol (slice u8))
                               (modbytes (slice u8))
                               (reg (ptr (ArrayList (ptr Sexp))))
                               (cx (ptr CtCtx))
                               (argv (ptr (ArrayList Sexp)))] (-> (Result Sexp Diag))
  (let [n (al-len [Sexp] (load argv))]
    (if (> n (primitive/cast i64 8))
        (Err [Sexp Diag] (derr "metaengine: metaprogram entries with more than 8 parameters are not supported yet"))
        (do
          (meta-host-set! cx reg)
          (let [a0
                  (if (> n (primitive/cast i64 0))
                      (me-box-arg a (al-get [Sexp] (load argv) 0))
                      (primitive/cast (ptr i8) 0))
                a1
                  (if (> n (primitive/cast i64 1))
                      (me-box-arg a (al-get [Sexp] (load argv) 1))
                      (primitive/cast (ptr i8) 0))
                a2
                  (if (> n (primitive/cast i64 2))
                      (me-box-arg a (al-get [Sexp] (load argv) 2))
                      (primitive/cast (ptr i8) 0))
                a3
                  (if (> n (primitive/cast i64 3))
                      (me-box-arg a (al-get [Sexp] (load argv) 3))
                      (primitive/cast (ptr i8) 0))
                a4
                  (if (> n (primitive/cast i64 4))
                      (me-box-arg a (al-get [Sexp] (load argv) 4))
                      (primitive/cast (ptr i8) 0))
                a5
                  (if (> n (primitive/cast i64 5))
                      (me-box-arg a (al-get [Sexp] (load argv) 5))
                      (primitive/cast (ptr i8) 0))
                a6
                  (if (> n (primitive/cast i64 6))
                      (me-box-arg a (al-get [Sexp] (load argv) 6))
                      (primitive/cast (ptr i8) 0))
                a7
                  (if (> n (primitive/cast i64 7))
                      (me-box-arg a (al-get [Sexp] (load argv) 7))
                      (primitive/cast (ptr i8) 0))
                rp
                  (primitive/call-ptr (load (field (meta-wasm-box) run))
                                      (slice-data modbytes)
                                      (slice-len modbytes)
                                      (str->cstr a symbol)
                                      n
                                      a0
                                      a1
                                      a2
                                      a3
                                      a4
                                      a5
                                      a6
                                      a7)]
            (if (= (primitive/cast i64 rp) (primitive/cast i64 0))
                (match (meta-host-err)
                  (Some [d] (Err [Sexp Diag] d))
                  (None []
                        (Err [Sexp Diag]
                             (derr "metaengine: wasm metaprogram returned a null Code handle (compiler bug)"))))
                (Ok [Sexp Diag] (load (primitive/cast (ptr Sexp) rp)))))))))

(defn meta-engine-invoke [(a (ptr Allocator))
                          (fp (ptr i8))
                          (reg (ptr (ArrayList (ptr Sexp))))
                          (cx (ptr CtCtx))
                          (argv (ptr (ArrayList Sexp)))] (-> (Result Sexp Diag))
  (let [n (al-len [Sexp] (load argv))]
    (if (> n (primitive/cast i64 8))
        (Err [Sexp Diag] (derr "metaengine: metaprogram entries with more than 8 parameters are not supported yet"))
        (let [c (alloc/stack MPCall)]
          (meta-host-set! cx reg)
          (store! (field c fp) fp)
          (store! (field c argc) n)
          (store! (field c ret) (primitive/cast (ptr i8) 0))
          (store! (field c a0)
                  (if (> n (primitive/cast i64 0))
                      (me-box-arg a (al-get [Sexp] (load argv) 0))
                      (primitive/cast (ptr i8) 0)))
          (store! (field c a1)
                  (if (> n (primitive/cast i64 1))
                      (me-box-arg a (al-get [Sexp] (load argv) 1))
                      (primitive/cast (ptr i8) 0)))
          (store! (field c a2)
                  (if (> n (primitive/cast i64 2))
                      (me-box-arg a (al-get [Sexp] (load argv) 2))
                      (primitive/cast (ptr i8) 0)))
          (store! (field c a3)
                  (if (> n (primitive/cast i64 3))
                      (me-box-arg a (al-get [Sexp] (load argv) 3))
                      (primitive/cast (ptr i8) 0)))
          (store! (field c a4)
                  (if (> n (primitive/cast i64 4))
                      (me-box-arg a (al-get [Sexp] (load argv) 4))
                      (primitive/cast (ptr i8) 0)))
          (store! (field c a5)
                  (if (> n (primitive/cast i64 5))
                      (me-box-arg a (al-get [Sexp] (load argv) 5))
                      (primitive/cast (ptr i8) 0)))
          (store! (field c a6)
                  (if (> n (primitive/cast i64 6))
                      (me-box-arg a (al-get [Sexp] (load argv) 6))
                      (primitive/cast (ptr i8) 0)))
          (store! (field c a7)
                  (if (> n (primitive/cast i64 7))
                      (me-box-arg a (al-get [Sexp] (load argv) 7))
                      (primitive/cast (ptr i8) 0)))
          (let [failed
                  (if (meta-main?)
                      ; COIL_META_MAIN=1: run on the process MAIN thread (AppKit
                      ; metaprograms); an (primitive/error ...) there prints and exits.
                      (do (meta-host-onmain! 1) (main-svc-run (primitive/cast (ptr i8) c)) false)
                      (me-worker-call c))]
            (if failed
                (match (meta-host-err)
                  (Some [d] (Err [Sexp Diag] d))
                  (None []
                        (Err [Sexp Diag]
                             (derr "metaengine: metaprogram thread failed without recording a diagnostic (compiler bug)"))))
                (let [ret (load (field c ret))]
                  (if (= (primitive/cast i64 ret) (primitive/cast i64 0))
                      (Err [Sexp Diag] (derr "metaengine: metaprogram returned a null Code handle (compiler bug)"))
                      (Ok [Sexp Diag] (load (primitive/cast (ptr Sexp) ret)))))))))))

; ---- the finish-macro fast path -------------------------------------------------------
; The interpreter's env (param -> CCode arg, variadic already packed) IS the packed
; argument list; extract it and run the compiled entry instead of eval-seq.
(defn meta-engine-run-env [(a (ptr Allocator)) (e (ptr MEEntry)) (cx (ptr CtCtx)) (env (ptr (ArrayList EnvBind)))] (-> (Result Sexp
                                                                                                                               Diag))
  (let [n (al-len [EnvBind] (load env))
        (mut argv) (al-new [Sexp] a)
        (mut i) 0
        (mut bad) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [v (load (field (al-elem [EnvBind] env (load i)) val))]
                  (if (is-ccode v) (do (al-push! (mut argv) (ccode-of v)) 0) (do (store! bad true) (break))))
                (store! i (primitive/iadd (load i) 1)))))
    (cond (load bad) (Err [Sexp Diag] (derr "metaengine: non-Code value in a metaprogram argument env (compiler bug)"))
          (!= (primitive/cast i64 (load (field e interpcx))) 0)
          ; the interpreter looks the entry up by its coil FUNCTION name (the qual
          ; name), not the export-c symbol (coil_mp_<k>) the compiled backends emit.
          (meta-engine-invoke-interp a
                                     (load (field e name))
                                     (load (field e interpcx))
                                     (load (field e registry))
                                     cx
                                     (box-al [Sexp] a (load argv)))
            (> (slice-len [u8] (load (field e modbytes))) 0)
          (meta-engine-invoke-wasm a
                                   (load (field e symbol))
                                   (load (field e modbytes))
                                   (load (field e registry))
                                   cx
                                   (box-al [Sexp] a (load argv)))
            :else
          (meta-engine-invoke a (load (field e fp)) (load (field e registry)) cx (box-al [Sexp] a (load argv))))))
