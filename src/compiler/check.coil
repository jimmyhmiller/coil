; src/compiler/check.coil — self-host Coil compiler, check module.

(module coil.compiler.check)
(import "coil.compiler.vector" :use *)
(import "coil.primitive" :as primitive)
(import "coil.compiler.unit_state" :use [unit-allocator core-name core-name? core-name-prefix? unit-prelude-name])
(import "coil.alloc" :as alloc :use *)
(import "coil.scratch" :as scratch)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.reader" :use *)
(import "coil.cc" :as cc)
(import "coil.layout" :as layout)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.astdump" :use *)
(import "coil.compiler.comptime" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.hashmap" :use *)  ; the signature-name index (sig-find)
(import "coil.compiler.sig_base" :as sigbase)
(import "coil.pmap" :use *)
(import "coil.compiler.retained_heap" :as retainedheap)
(import "coil.compiler.type_references" :as type-refs)  ; the constants an initializer names
(import "coil.compiler.retained_graph" :use [GraphKey graph-keyops])

(import "coil.compiler.trace" :as tr)
(import "coil.compiler.api_renames" :use [api-rename-hint])  ; what replaced a removed stdlib name

; the last `.`-separated component of a qualified name (the link/C symbol).
; Lives here (not in codegen.coil) so check has no codegen/LLVM dependency and
; the frontend can be built LLVM-free; codegen imports check and reuses it.
(defn last-component [(s (slice u8))] (-> (slice u8))
  (let [n (len s)
        (mut i) (primitive/isub n 1)
        (mut start) 0]
    (loop (if (< (load i) 0)
              (break)
              (if (= (primitive/cast i64 (get s (load i)))
                     46)
                  (do (set! start (primitive/iadd (load i) 1)) (set! i -1))
                  (set! i (primitive/isub (load i) 1)))))
    (substr s (load start) n)))

(defstruct Sig
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))
   ; Empty for externs, whose declarations carry types but no parameter names.
   (param_names (ptr (ArrayList (slice u8))))
   (params (ptr (ArrayList Type)))
   (ret Type)
   (is_extern bool)
   (variadic bool)
   (cc (slice u8))
   (fnptr_ok bool)
   ; The callable type exposed by fnptr-of. Ordinary Coil functions use the
   ; reference-model params above; export-c functions expose their source params
   ; because fnptr-of names the public C ABI entry.
   (fnptr_params (ptr (ArrayList Type)))])

(defstruct StructInfo
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))
   (fields (ptr (ArrayList Field)))
   (is_bits bool)])

(defstruct SumInfo
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))
   (variants (ptr (ArrayList Variant)))])

(defstruct VtoS [(variant (slice u8)) (sum (slice u8))])

;;; `source_node_id` is the node id of the `Const.value` this entry was computed from, as
;;; the constant stands once it is set up. A later compilation that is handed the very
;;; same constant recognizes it by that id and takes this entry as it is, the way an
;;; accepted function keeps its checked body. Appended field.
(defstruct ConstEntry
  [(name (slice u8)) (value Expr) (ty Type) (runtime bool) (source_node_id i64)
   ; The names a `:params` annotation declares for the callable the constant
   ; holds, in parameter order; None when the declaration has no `:params`.
   (param_names (Option (ptr (ArrayList (slice u8)))))])

(defstruct ConstPersistentEntry
  [(value (ptr ConstEntry)) (artifact (ptr retainedheap/Artifact))
   (owner (ptr retainedheap/Heap))])

(impl Clone ConstPersistentEntry
  (clone [(self (ref ConstPersistentEntry))] (-> ConstPersistentEntry)
    (do
      (retainedheap/artifact-retain! (.artifact self))
      (ConstPersistentEntry :value (.value self) :artifact (.artifact self)
        :owner (.owner self)))))

(impl Drop ConstPersistentEntry
  (drop [(self (mut ConstPersistentEntry))] (-> void)
    (retainedheap/artifact-release! (.owner self) (.artifact self))))

(defstruct NativeConstPersistentEntry
  [(value (ptr Const)) (artifact (ptr retainedheap/Artifact))
   (owner (ptr retainedheap/Heap))])

(impl Clone NativeConstPersistentEntry
  (clone [(self (ref NativeConstPersistentEntry))]
    (-> NativeConstPersistentEntry)
    (do
      (retainedheap/artifact-retain! (.artifact self))
      (NativeConstPersistentEntry :value (.value self) :artifact (.artifact self)
        :owner (.owner self)))))

(impl Drop NativeConstPersistentEntry
  (drop [(self (mut NativeConstPersistentEntry))] (-> void)
    (retainedheap/artifact-release! (.owner self) (.artifact self))))

(defn const-base-lease-noop [(state (ptr i8))] (-> i64) 0)
(defn const-base-lease [(a (dyn Allocator))] (-> AllocatorLease)
  (unsafe-allocator-lease-new a (primitive/cast (ptr i8) 0)
    (primitive/fnptr-of const-base-lease-noop)
    (primitive/fnptr-of const-base-lease-noop)))

(defstruct ConstBase
  [(refs i64) (a (dyn Allocator))
   (entries (PMap (slice u8) ConstPersistentEntry))
   (native_entries (PMap (slice u8) NativeConstPersistentEntry))])

(defn const-no-base [] (-> (ptr ConstBase))
  (primitive/cast (ptr ConstBase) 0))

(defn const-base-new [(a (dyn Allocator))] (-> (ptr ConstBase))
  (let [base (box! a ConstBase (primitive/zeroed ConstBase))]
    (set! (.refs base) 1) (set! (.a base) a)
    (set! (.entries base)
      (PMap::new [(slice u8) ConstPersistentEntry] (const-base-lease a)
        (keyops-borrowed)))
    (set! (.native_entries base)
      (PMap::new [(slice u8) NativeConstPersistentEntry] (const-base-lease a)
        (keyops-borrowed)))
    base))

(defn const-base-derive [(a (dyn Allocator)) (parent (ptr ConstBase))]
  (-> (ptr ConstBase))
  (if (= parent (const-no-base)) (const-base-new a)
    (let [base (box! a ConstBase (primitive/zeroed ConstBase))]
      (set! (.refs base) 1) (set! (.a base) a)
      (set! (.entries base)
        (clone (load (field parent entries))))
      (set! (.native_entries base)
        (clone (load (field parent native_entries))))
      base)))

(defn const-base-release! [(base (ptr ConstBase))] (-> i64)
  (unless (= base (const-no-base))
    (let [remaining (- (.refs base) 1)]
      (set! (.refs base) remaining)
      (when (= remaining 0)
        (let [entries (take! [(PMap (slice u8) ConstPersistentEntry)]
                        (field base entries))] 0)
        (let [entries (take! [(PMap (slice u8) NativeConstPersistentEntry)]
                        (field base native_entries))] 0)
        (free [ConstBase] (.a base) (slice::new base 1)) 0)) 0)
  0)

(defn const-base-get [(base (ptr ConstBase)) (name (slice u8))]
  (-> (ptr ConstEntry))
  (if (= base (const-no-base)) (primitive/cast (ptr ConstEntry) 0)
    (match (get-ptr (field base entries) name)
      (None [] (primitive/cast (ptr ConstEntry) 0))
      (Some [entry] (.value entry)))))

(defn const-base-put! [(base (ptr ConstBase)) (owner (ptr retainedheap/Heap))
                       (value (ptr ConstEntry))
                       (artifact (ptr retainedheap/Artifact))] (-> i64)
  (retainedheap/artifact-retain! artifact)
  (set! (mut (.entries base)) (.name value)
    (ConstPersistentEntry :value value :artifact artifact :owner owner)))

;;; Forget NAME, as a checked and as a native constant.
(defn const-base-remove! [(base (ptr ConstBase)) (name (slice u8))] (-> i64)
  (unless (= base (const-no-base))
    (dissoc! (mut (.entries base)) name)
    (dissoc! (mut (.native_entries base)) name)
    0)
  0)

(defn const-base-native-get [(base (ptr ConstBase)) (name (slice u8))]
  (-> (ptr Const))
  (if (= base (const-no-base)) (primitive/cast (ptr Const) 0)
    (match (get-ptr (field base native_entries) name)
      (None [] (primitive/cast (ptr Const) 0))
      (Some [entry] (.value entry)))))

(defn const-base-native-put! [(base (ptr ConstBase))
                              (owner (ptr retainedheap/Heap))
                              (value (ptr Const))
                              (artifact (ptr retainedheap/Artifact))] (-> i64)
  (retainedheap/artifact-retain! artifact)
  (set! (mut (.native_entries base)) (.name value)
    (NativeConstPersistentEntry :value value :artifact artifact :owner owner)))

(defn const-base-names! [(base (ptr ConstBase))
                         (out (mut (ArrayList (slice u8))))] (-> i64)
  (unless (= base (const-no-base))
    (let [(mut it) (iter (field base entries))]
      (loop (match (next (mut it))
        (None [] (break))
        (Some [entry] (push! (mut out) (.key entry))))))
    0)
  0)

(defstruct MethodEntry [(name (slice u8)) (trait (slice u8)) (self_idx i64)])

; NOTE: registered impls are stored as plain `ImplDef`s (see `Cx.impls`). There used to
; be a cut-down `ImplPair {trait, for_type, self_type, type_params}` here — a strict
; SUBSET of ImplDef — and having two record types for one concept forced two copies of
; everything that reasons about impls (specificity, selection), one per type. Mono
; already had `ImplDef`; check now uses it too, so those functions exist once and both
; phases share them.
; `place_breaks` holds the value of every break so far whose type is the place
; recorded in `break_ty`. A later break that joins it at the value re-types the loop
; and loads each of them in place (see `join-branch-types`).
(defstruct LoopFrame
  [(label (Option (slice u8)))
   (break_ty (Option Type))
   (expected (Option Type))
   (place_breaks (ArrayList (ptr Expr)))
   ; `Cx.defer_depth` when the loop was entered: a break to it from deeper runs
   ; the cleanups of the defers in between.
   (defers i64)
   ; Break values that need the loop's type to be checked, `(return-from :try (Err
   ; e))` before the block's tail has said what that type is.
   (pending (ArrayList PendingBreak))])

;;; A break value checked once its loop's type is known. `slot` is the value the
;;; break carries, patched in place; `env` is the scope it was written in.
(defstruct PendingBreak
  [(value (ptr Expr))
   (slot (ptr Expr))
   (env (ptr (ArrayList EnvEntry)))
   (err Diag)
   ; its `pending-break-count`, which orders it among the others
   (seq i64)])

; `bid` is the local-binding identity (see comptime.coil binding-map): a fresh id
; per let-binding / parameter, so `(primitive/binding-of REF)` distinguishes shadows.
(defstruct EnvEntry [(name (slice u8)) (ty Type) (bid i64)])

(defstruct EvalPair [(e Expr) (t Type)])

(defstruct SynPair [(e (ptr Expr)) (t (ptr Type))])

; A shared syntax node may be checked under distinct expected types or lexical
; depths. Those are separate synthesis contexts; exact pointers deliberately
; keep separately allocated but equal expected types conservative cache misses.
(defstruct SynthKey [(expr i64) (expected i64) (env_len i64)])

(defstruct FBox [(items (ArrayList Func))])

(defstruct ImplBucket [(items (ArrayList i64))])

(defstruct Cx
  [(a (dyn Allocator))
   ; where impl selection builds its lookup keys, kept for the checker's
   ; lifetime and rewound after each selection (cx-impl-keys)
   (impl_keys (ptr scratch/ScratchArena))
   (annotation_defs (ptr (ArrayList AnnotationDef)))
   ; annotation key -> index into `annotation_defs`
   (annotation_idx (HashMap (slice u8) i64))
   (sigs (ArrayList Sig))
   ; name -> index into `sigs` of the LAST signature declared under it; see sig-find
   (sigidx (HashMap (slice u8) i64))
   (structs (ArrayList StructInfo))
   (sums (ArrayList SumInfo))
   (variant_to_sum (ArrayList VtoS))
   (consts (ArrayList ConstEntry))
   (static_consts (ArrayList (slice u8)))
   (trait_defs (ArrayList TraitDef))
   (methods (ArrayList MethodEntry))
   (impls (ArrayList ImplDef))
   ; Candidate buckets contain indices into `impls`. Dispatch hashes directly to
   ; the relevant trait/type or method/type bucket instead of scanning every impl.
   (trait_impl_idx (HashMap (slice u8) (ptr ImplBucket)))
   (inherent_impl_idx (HashMap (slice u8) (ptr ImplBucket)))
   (inherent_name_idx (HashMap (slice u8) (ptr ImplBucket)))
   ; Exact concrete trait selections made by the checker. Deferred generic
   ; selections are appended by mono to the same structural report.
   (trait_uses (ArrayList MonoTraitUse))
   (imports (ptr (ArrayList ImpEntry)))
   (exports (ptr (ArrayList ExpEntry)))
   (conventions (ptr (ArrayList Convention)))
   (cur_bounds (ArrayList Bound))
   (loops (ArrayList LoopFrame))
   (synth_cache_active bool)
   (synth_cache (HashMap SynthKey SynPair))
   ; The entry file's module — the module `main` was written in. `main` is never
   ; renamed, so it is the one function whose own name cannot say where it lives.
   (entry_module (slice u8))
   ; Checked functions lifted from non-capturing `(fn ...)` expressions.
   (anon_funcs (ArrayList Func))
   ; The by-value C entries (unpublished ExportC) of the anon_funcs that a `c`
   ; function pointer calls with an aggregate by value.
   (anon_c_entries (ArrayList ExportC))
   (anon_counter i64)
   ; Non-null only while checking an anonymous body. It lets missing locals be
   ; diagnosed as forbidden captures instead of misleading undefined names.
   (anon_outer_env (ptr (ArrayList EnvEntry)))
   (validate_anon_ownership bool)
   ; A provisional check that continues past errors records every error after
   ; the first here; the function's result carries the first. Appended field.
   (recovered_diags (ArrayList Diag))
   (recover_statements bool)
   ; Checking a metaprogram closure against the retained compile-time
   ; environment. That environment is replaced wholesale by each submission, so a
   ; constant this closure declares replaces the retained one of the same name
   ; instead of redeclaring it. The authoritative program check stays strict.
   (replaces_meta_consts bool)
   ; Expressions typed TError by recovery so far. A failure while this grows is a
   ; consequence of an earlier error and is not reported again.
   (error_count i64)
   ; Nesting depth of `(comptime …)` being checked. Comptime folds a generic
   ; template once, so a value parameter has no value there. Appended field.
   (comptime_depth i64)
   ; name -> index into `consts`. Entries are only ever appended, so an index never
   ; moves. A constant is looked up once per reference to it and once per constant
   ; being set up; as a scan that made setup quadratic in constants. Appended field.
   (constidx (HashMap (slice u8) i64))
   (const_base (ptr ConstBase))
   ; Persistent accepted signatures. `sigs`/`sigidx` are this candidate's overlay.
   (sig_base (ptr sigbase/SigBase))
   (new_sig_names (HashMap (slice u8) i64))
   ; Non-null only while mono ownership-checks one generic instance: the
   ; instance's type parameters bound to their semantic types (see
   ; `ownership-node-type`). Appended field.
   (ownership_subst (ptr (ArrayList SubstEntry)))
   ; The functions this submission retired. Their accepted signatures are still
   ; in `sig_base` until publication; the candidate does not see them. Null when
   ; there are none. Appended field.
   (retired_sigs (ptr (ArrayList (slice u8))))
   ; How many `(defer* …)` bodies enclose the expression being checked.
   ; Appended field.
   (defer_depth i64)
   ; The module whose imports govern the code being checked, or "" to read it
   ; off the function name (`caller-module-of`). Set for a function, a
   ; constant's value and a static assertion's condition, whose names (a mangled
   ; `Trait$Type$method`, `const m.N`, `static-assert`) do not say. Appended field.
   (caller_module (slice u8))])

(defn mk-evalpair [(e Expr) (t Type)] (-> EvalPair)
  (let [p (primitive/alloc-stack EvalPair)]
    (set! (.e p) e)
    (set! (.t p) t)
    (load p)))

;;; The value a synthesized expression yields: a place (a constructor's
;;; storage, a reference) is read, anything else is itself.
(defn place-as-value [(a (dyn Allocator)) (sp SynPair)] (-> EvalPair)
  (let [e (.e sp)]
    (match (load (.t sp))
      (TRef [_ inner]
            (mk-evalpair (mk-expr (ELoad e) (.lo e) (.hi e) (.source e) (.ctxt e))
                         (load inner)))
      (_ (mk-evalpair (load e) (load (.t sp)))))))

(defn env-new [(a (dyn Allocator))] (-> (ptr (ArrayList EnvEntry)))
  (box-al [EnvEntry] a (ArrayList::new [EnvEntry] a)))

; Length-prefix the left component so `(ab,c)` cannot alias `(a,bc)`.
;;; `<len left>:<left><right>`, built in one allocation: every impl lookup
;;; makes one.
(defn impl-index-key [(a (dyn Allocator)) (left (slice u8)) (right (slice u8))] (-> (slice u8))
  (let [n (len left)
        (mut digits) 1
        (mut rest) (/ n 10)]
    (loop (if (= (load rest) 0)
              (break)
              (do (set! digits (+ (load digits) 1))
                  (set! rest (/ (load rest) 10)))))
    (let [total (+ (+ (load digits) 1) (+ n (len right)))
          out (match (alloc-bytes a total 1)
                (Some [bytes] bytes)
                (None []
                      (do
                        (oom-at c"compiler check" total)
                        (slice::new (primitive/cast (ptr u8) 0) 0))))
          p (data out)
          (mut v) n]
      (for [i 0 (load digits)]
        (set! (primitive/index p (- (load digits) (+ i 1)))
              (primitive/cast u8 (+ 48 (% (load v) 10))))
        (set! v (/ (load v) 10))
        0)
      (set! (primitive/index p (load digits)) (: 58 u8))
      (for [i 0 n]
        (set! (primitive/index p (+ (+ (load digits) 1) i)) (get left i))
        0)
      (for [i 0 (len right)]
        (set! (primitive/index p (+ (+ (+ (load digits) 1) n) i)) (get right i))
        0)
      out)))

(defn impl-index-add! [(a (dyn Allocator))
                       (idx (mut (HashMap (slice u8) (ptr ImplBucket))))
                       (key (slice u8))
                       (value i64)] (-> i64)
  (match (get (load idx) key)
    (Some [bucket] (push! (mut (.items bucket)) value))
    (None []
          (let [bucket (box! a ImplBucket (primitive/zeroed ImplBucket))]
            (set! (.items bucket) (ArrayList::new [i64] a))
            (push! (mut (.items bucket)) value)
            (set! (mut idx) key bucket))))
  0)

(defn impl-index-get [(idx (ptr (HashMap (slice u8) (ptr ImplBucket))))
                      (key (slice u8))] (-> (ptr ImplBucket))
  (match (get (load idx) key)
    (Some [bucket] bucket)
    (None [] (primitive/cast (ptr ImplBucket) 0))))

;;; The trait uses a checker has recorded, as one key each, for the list whose
;;; buffer and length it was built over: a use is recorded once per distinct key,
;;; and a scan of every recorded use per call was quadratic in a program's trait
;;; method calls. Rebuilt when another list, or a shorter one, is asked about.
(defstruct TraitUseIndex
  [(ready bool)
   (buf i64)
   (len i64)
   (keys (HashMap (slice u8) bool))
   (key StrBuf)])

(defn trait-use-index [] (-> (ptr TraitUseIndex))
  (primitive/alloc-static TraitUseIndex))

(defn trait-use-key! [(ix (ptr TraitUseIndex)) (use (ptr MonoTraitUse))] (-> (slice u8))
  (set! (.len (field (field ix key) bytes)) 0)
  (push-str! (mut (.key ix)) (.caller_source use))
  (push! (mut (.key ix)) (: 1 u8))
  (push-str! (mut (.key ix)) (.trait_name use))
  (push! (mut (.key ix)) (: 1 u8))
  (push-str! (mut (.key ix)) (.impl_source use))
  (push! (mut (.key ix)) (: 1 u8))
  (push-str! (mut (.key ix)) (.method_name use))
  (push! (mut (.key ix)) (: 1 u8))
  (push-str! (mut (.key ix)) (.generated_artifact use))
  (str (.key ix)))

(defn trait-use-index-for [(uses (ptr (ArrayList MonoTraitUse)))] (-> (ptr TraitUseIndex))
  (let [ix (trait-use-index)
        n (len (load uses))]
    (unless (.ready ix)
      (set! (.keys ix) (HashMap::new [(slice u8) bool] (malloc-allocator) (keyops)))
      (set! (.key ix) (StrBuf::new (malloc-allocator)))
      (set! (.ready ix) true)
      0)
    (when (or (!= (.buf ix) (primitive/cast i64 (.data uses))) (< n (.len ix)))
      (clear! (mut (.keys ix)))
      (set! (.len ix) 0)
      (set! (.buf ix) (primitive/cast i64 (.data uses)))
      0)
    (for [i (.len ix) n]
      (set! (mut (.keys ix)) (trait-use-key! ix (elem uses i)) true)
      0)
    (set! (.len ix) n)
    ix))

(defn checker-trait-use-record! [(cx (ptr Cx))
                                 (caller-source (slice u8))
                                 (trait-name (slice u8))
                                 (impl-source (slice u8))
                                 (method-name (slice u8))
                                 (generated (slice u8))] (-> i64)
  (let [use (primitive/alloc-stack MonoTraitUse)]
    (set! (.caller_source use) caller-source)
    (set! (.trait_name use) trait-name)
    (set! (.impl_source use) impl-source)
    (set! (.method_name use) method-name)
    (set! (.generated_artifact use) generated)
    (let [ix (trait-use-index-for (field cx trait_uses))]
      (unless (contains? (.keys ix) (trait-use-key! ix use))
        (push! (mut (.trait_uses cx)) (load use))
        ; the index follows the list; a push that moved the buffer rebuilds it next time
        (when (= (.buf ix) (primitive/cast i64 (.data (field cx trait_uses))))
          (set! (mut (.keys ix)) (str (.key ix)) true)
          (set! (.len ix) (len (load (field cx trait_uses))))
          0)
        0)))
  0)

; ---- Cx table lookups (return a live (ptr T) or null) ----------------------
; Record that the signature just appended is the one `name` now resolves to. Overwriting
; is the point: on a duplicate name the LAST one declared wins, which is exactly what a
; map insert does — the behaviour the old scan spelled out by deliberately NOT breaking
; on a match and running to the end of the list every time.
(defn sig-index-put! [(cx (ptr Cx)) (name (slice u8))] (-> i64)
  (set! (mut (.sigidx cx))
        name
        (primitive/isub (len (.sigs cx))
                        1))
  0)

(defn sig-find-local [(cx (ptr Cx)) (name (slice u8))] (-> (ptr Sig))
  (match (get (.sigidx cx) name)
    (None [] (primitive/cast (ptr Sig) 0))
    (Some [i] (elem (field cx sigs) i))))

(defn sig-materialize-base! [(cx (ptr Cx)) (stored (ptr sigbase/CallableSig))]
  (-> (ptr Sig))
  ; Checker expressions retain pointers into signatures. Materialize a deep
  ; candidate-owned copy so those edges belong to its snapshot graph; only the
  ; immutable index itself may point into the persistent owner arena.
  (let [copy (sigbase/sig-copy (.a cx) stored)
        sg (primitive/alloc-stack Sig)]
    (set! (.name sg) (.name copy))
    (set! (.type_params sg) (.type_params copy))
    (set! (.bounds sg) (.bounds copy))
    (set! (.param_names sg) (.param_names copy))
    (set! (.params sg) (.params copy))
    (set! (.ret sg) (.ret copy))
    (set! (.is_extern sg) (.is_extern copy))
    (set! (.variadic sg) (.variadic copy))
    (set! (.cc sg) (.cc copy))
    (set! (.fnptr_ok sg) (.fnptr_ok copy))
    (set! (.fnptr_params sg) (.fnptr_params copy))
    (push! (mut (.sigs cx)) (load sg))
    (sig-index-put! cx (.name sg))
    (elem (field cx sigs) (- (len (.sigs cx)) 1))))

; The signature `name` resolves to, or null. This is asked once per CALL SITE against
; every signature in the program; as a str-eq scan that ran to completion (see above) it
; was O(calls × functions) — quadratic in program size, and the largest single cost left
; in `check`. The index gives the identical answer in one probe.
(defn sig-retired? [(cx (ptr Cx)) (name (slice u8))] (-> bool)
  (let [retired (.retired_sigs cx)]
    (and (!= (primitive/cast i64 retired) 0)
         (block :found
           (for r (iter (load retired)) (when (= r name) (break :found true)))
           false))))

;;; Append the accepted signatures' names this candidate can see to OUT.
(defn sig-base-visible-names! [(a (dyn Allocator)) (cx (ptr Cx)) (out (mut (ArrayList (slice u8))))] (-> i64)
  (if (= (primitive/cast i64 (.retired_sigs cx)) 0)
    (sigbase/sig-base-append-names! (.sig_base cx) (mut out))
    (let [(mut all) (ArrayList::new [(slice u8)] a)]
      (sigbase/sig-base-append-names! (.sig_base cx) (mut all))
      (for name (iter all) (unless (sig-retired? cx name) (push! (mut out) name) 0))
      0)))

(defn sig-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr Sig))
  (let [local (sig-find-local cx name)]
    (if (or (!= (primitive/cast i64 local) 0) (sig-retired? cx name))
      local
      (match (sigbase/sig-base-get (.sig_base cx) name)
        (Some [stored] (sig-materialize-base! cx stored))
        ; A metaprogram closure may carry an accepted function of the session
        ; it extends; its signature is the session's.
        (None []
          (match (sigbase/sig-base-get
                   (primitive/cast (ptr sigbase/SigBase) (closure-sigs-raw)) name)
            (Some [stored] (sig-materialize-base! cx stored))
            (None []
              (match (sigbase/sig-base-get
                       (primitive/cast (ptr sigbase/SigBase) (closure-meta-sigs-raw)) name)
                (Some [stored] (sig-materialize-base! cx stored))
                (None [] (primitive/cast (ptr Sig) 0))))))))))

;;; Drop signatures materialized from the immutable base after checking. They are
;;; a candidate-local lookup cache, not owned snapshot data; the published state
;;; reads them from `sig_base` again. Keep only this candidate's overlay.
(defn sig-retain-overlay! [(cx (ptr Cx))] (-> i64)
  (let [(mut kept) (ArrayList::new [Sig] (.a cx))]
    (for [i 0 (len (.sigs cx))]
      (let [sg (elem (field cx sigs) i)]
        (when (contains? (.new_sig_names cx) (.name sg))
          (push! (mut kept) (load sg)) 0)))
    (set! (.sigs cx) (load kept))
    (set! (.sigidx cx)
          (HashMap::new [(slice u8) i64] (.a cx) (keyops-borrowed)))
    (for [i 0 (len (.sigs cx))]
      (set! (mut (.sigidx cx)) (.name (elem (field cx sigs) i)) i))
    ; Publication removes the retired functions from the base itself.
    (set! (.retired_sigs cx) (primitive/cast (ptr (ArrayList (slice u8))) 0))
    0))

(defn sig-clear-program-abis! [(cx (ptr Cx)) (prog (ptr Program))] (-> i64)
  ; The persistent signature base is now the accepted callable ABI authority.
  ; `function_abis` is a pass result used through codegen, not published state.
  (set! (.function_abis prog)
        (box-al [Extern] (.a cx) (ArrayList::new [Extern] (.a cx))))
  0)

; Levenshtein edit distance between two byte slices. Cold path (only computed
; when a call is already known-undefined), so a straightforward two-rolling-rows
; DP in scratch heap memory is fine.
(defn edit-dist [(a (dyn Allocator)) (s (slice u8)) (t (slice u8))] (-> i64)
  (let [m (len s)
        n (len t)]
    (if (= m 0)
        n
        (if (= n 0)
            m
            (let [prev
                    (data (match (alloc [i64] a (primitive/iadd n 1))
                            (Some [s] s)
                            (None []
                                  (do
                                    (oom-at c"compiler check" -1)
                                    (slice::new (primitive/cast (ptr i64)
                                                                0)
                                                0)))))
                  cur
                    (data (match (alloc [i64] a (primitive/iadd n 1))
                            (Some [s] s)
                            (None []
                                  (do
                                    (oom-at c"compiler check" -1)
                                    (slice::new (primitive/cast (ptr i64)
                                                                0)
                                                0)))))
                  (mut j) 0]
              (loop (if (> (load j) n)
                        (break)
                        (do
                          (set! (primitive/index prev (load j)) (load j))
                          (set! j (primitive/iadd (load j) 1)))))
              (let [(mut i) 1]
                (loop (if (> (load i) m)
                          (break)
                          (do
                            (set! (primitive/index cur 0) (load i))
                            (let [(mut jj) 1]
                              (loop (if (> (load jj) n)
                                        (break)
                                        (let [cost
                                                (unless (= (primitive/cast i64
                                                                           (get s
                                                                                (primitive/isub (load i)
                                                                                                1)))
                                                           (primitive/cast i64
                                                                           (get t
                                                                                (primitive/isub (load jj)
                                                                                                1))))
                                                  1)
                                              del
                                                (primitive/iadd (load (primitive/index prev
                                                                                       (load jj)))
                                                                1)
                                              ins
                                                (primitive/iadd (load (primitive/index cur
                                                                                       (primitive/isub (load jj)
                                                                                                       1)))
                                                                1)
                                              sub
                                                (primitive/iadd (load (primitive/index prev
                                                                                       (primitive/isub (load jj)
                                                                                                       1)))
                                                                cost)
                                              mn (if (< del ins) del ins)
                                              best (if (< mn sub) mn sub)]
                                          (do
                                            (set! (primitive/index cur
                                                                   (load jj))
                                                  best)
                                            (set! jj
                                                  (primitive/iadd (load jj) 1)))))))
                            (let [(mut k) 0]
                              (loop (if (> (load k) n)
                                        (break)
                                        (do
                                          (set! (primitive/index prev (load k))
                                                (load (primitive/index cur
                                                                       (load k))))
                                          (set! k (primitive/iadd (load k) 1))))))
                            (set! i (primitive/iadd (load i) 1)))))
                (load (primitive/index prev n))))))))

; The closest name in `cands` to `name` within a length-scaled edit budget (short
; names need a near-exact match, long names tolerate more), or None when even the
; nearest is too far to be a plausible typo. THE one "did you mean" ranking — both
; the check-time (`suggest-callable`) and resolve-time undefined-name hints route
; through it, so there is a single definition of what counts as a suggestion.
(defn nearest-name [(a (dyn Allocator))
                    (cands (ptr (ArrayList (slice u8))))
                    (name (slice u8))] (-> (Option (slice u8)))
  (let [n (len (load cands))
        (mut i) 0
        (mut best) -1
        (mut bestnm) name
        budget
          (let [l (len name)
                t (primitive/udiv l 3)]
            (if (< t 1) 1 t))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [cand (last-component (get (load cands) (load i)))]
                  (unless (or (= (len cand) 0)
                              (= cand name))
                    (let [d (edit-dist a name cand)]
                      (when (or (< (load best) 0)
                                (< d (load best)))
                        (store! best d)
                        (store! bestnm cand)
                        0))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (and (>= (load best) 0) (<= (load best) budget))
        (Some (load bestnm))
        (None [(slice u8)]))))

; A "did you mean" suggestion for an undefined call `name`: the closest surface
; name among all known signatures — the auto-referred core/stdlib (`println`/
; `print`/…) is always among them, so a typo of a bundled name gets a hint even
; with no explicit import.
(defn suggest-callable [(a (dyn Allocator)) (cx (ptr Cx)) (name (slice u8))] (-> (Option (slice u8)))
  (let [sigs (field cx sigs)
        n (len (load sigs))
        (mut names) (ArrayList::new [(slice u8)] a)
        (mut i) 0]
    (sig-base-visible-names! a cx (mut names))
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut names) (.name (elem sigs (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (nearest-name a (box-al [(slice u8)] a (load names)) name)))

; Everything BEFORE the last '.' of a qualified name — the module it lives in.
; Empty when the name is unqualified. (`last-component` is the other half.)
(defn module-prefix [(s (slice u8))] (-> (slice u8))
  (let [n (len s)
        (mut i) (primitive/isub n 1)
        (mut cut) -1]
    (loop (if (< (load i) 0)
              (break)
              (if (= (primitive/cast i64 (get s (load i)))
                     46)
                  (do (set! cut (load i)) (set! i -1))
                  (set! i (primitive/isub (load i) 1)))))
    (if (< (load cut) 0) "" (substr s 0 (load cut)))))

;;; What a diagnostic about the unknown NAME written in the function FNAME (a
;;; qualified name, or "" outside any function, which reads it through no module's
;;; imports) adds: `unknown-name-hint`, the removed-name hint or the modules that
;;; define and export NAME, the loaded ones read from this checker's tables.
(defn fn-unknown-hint [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (fname (slice u8))
                       (name (slice u8))] (-> (slice u8))
  (let [m (if (= (len fname) 0)
              ""
              (if (= (len (module-prefix fname)) 0) (.entry_module cx) (module-prefix fname)))]
    (unknown-name-hint a
                       m
                       (if (= (len m) 0)
                           (primitive/cast (ptr ImpEntry) 0)
                           (imports-find (load (field cx imports)) m))
                       (load (field cx exports))
                       (check-definers a cx name)
                       name)))

;;; The modules whose checked declarations, a generated one included, define NAME:
;;; a function, type, trait, variant or constant.
(defn check-definers [(a (dyn Allocator)) (cx (ptr Cx)) (name (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [out (box! a (ArrayList (slice u8)) (ArrayList::new [(slice u8)] a))
        (mut sigs) (ArrayList::new [(slice u8)] a)]
    (sig-base-visible-names! a cx (mut sigs))
    (for [j 0 (len sigs)] (check-definer-add! out (get sigs j) name) 0)
    (for [i 0 (len (.sigs cx))] (check-definer-add! out (.name (elem (field cx sigs) i)) name) 0)
    (for [i 0 (len (.structs cx))] (check-definer-add! out (.name (elem (field cx structs) i)) name) 0)
    (for [i 0 (len (.sums cx))] (check-definer-add! out (.name (elem (field cx sums) i)) name) 0)
    (for [i 0 (len (.variant_to_sum cx))]
      (check-definer-add! out (.variant (elem (field cx variant_to_sum) i)) name)
      0)
    (for [i 0 (len (.trait_defs cx))] (check-definer-add! out (.name (elem (field cx trait_defs) i)) name) 0)
    (for [i 0 (len (.consts cx))] (check-definer-add! out (.name (elem (field cx consts) i)) name) 0)
    out))

;;; Add QUALIFIED's module to OUT when its last component is NAME.
(defn check-definer-add! [(out (ptr (ArrayList (slice u8)))) (qualified (slice u8)) (name (slice u8))] (-> i64)
  (when (= (last-component qualified) name)
    (let [m (module-prefix qualified)]
      (when (and (> (len m) 0) (not (set-contains out m))) (push! out m) 0)
      0))
  0)

; The undefined-call message. A standard-library name that was removed says what
; replaced it; a name a module the program could import defines and exports names
; that module and the import; otherwise a "; did you mean 'X'?" tail when a
; plausibly intended name exists. One definition, used by every call-check site
; below.
(defn undefined-call-msg [(a (dyn Allocator))
                          (cx (ptr Cx))
                          (fname (slice u8))
                          (func (slice u8))] (-> (slice u8))
  (let [base
          (sconcat3 a
                    (sconcat3 a "in '" fname "': call to undefined function '")
                    func
                    "'")
        hint (fn-unknown-hint a cx fname func)]
    (if (> (len hint) 0)
        (sconcat3 a base "; " hint)
        (match (suggest-callable a cx func)
          (None [] base)
          (Some [s] (sconcat3 a base "; did you mean '" (sconcat a s "'?")))))))

(defn struct-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr StructInfo))
  (let [n (len (.structs cx))
        (mut i) 0
        (mut r) (primitive/cast (ptr StructInfo) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem (field cx structs)
                                            (load i))
                                      name))
                         name)
                  (store! r (elem (field cx structs) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn sum-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr SumInfo))
  (let [n (len (.sums cx))
        (mut i) 0
        (mut r) (primitive/cast (ptr SumInfo) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem (field cx sums)
                                            (load i))
                                      name))
                         name)
                  (store! r (elem (field cx sums) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn vts-find [(cx (ptr Cx)) (variant (slice u8))] (-> (ptr VtoS))
  (let [n (len (.variant_to_sum cx))
        (mut i) 0
        (mut r) (primitive/cast (ptr VtoS) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem (field cx variant_to_sum)
                                            (load i))
                                      variant))
                         variant)
                  (store! r (elem (field cx variant_to_sum) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn trait-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr TraitDef))
  (let [n (len (.trait_defs cx))
        (mut i) 0
        (mut r) (primitive/cast (ptr TraitDef) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem (field cx trait_defs)
                                            (load i))
                                      name))
                         name)
                  (store! r (elem (field cx trait_defs) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn const-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr ConstEntry))
  (match (get (.constidx cx) name)
    (None [] (const-base-get (.const_base cx) name))
    (Some [i] (elem (field cx consts) i))))

;;; The entry an earlier compilation computed for this very constant, or null. "This
;;; very constant" is the record that compilation left, handed back unchanged: a
;;; constant written again, even identically, is parsed into new nodes and is not it.
(defn const-accepted-entry [(parent (ptr LS)) (cp (ptr Const))] (-> (ptr ConstEntry))
  (if (= (primitive/cast i64 parent) 0)
      (primitive/cast (ptr ConstEntry) 0)
      (let [raw (.checker_context parent)]
        (if (= (primitive/cast i64 raw) 0)
            (primitive/cast (ptr ConstEntry) 0)
            (let [entry (const-find (primitive/cast (ptr Cx) raw) (.name cp))]
              (if (and (!= (primitive/cast i64 entry) 0)
                       ; A node the checker made has no id of its own, and two of
                       ; those are not thereby the same node.
                       (and (and (> (.source_node_id entry) 0)
                                 (= (.source_node_id entry) (.node-id (field cp value))))
                            (= (.runtime entry) (.runtime cp))))
                  entry
                  (primitive/cast (ptr ConstEntry) 0)))))))

;;; Stage 3 can elaborate an unchanged compiler-phase form again with fresh
;;; node IDs. Its accepted source location still identifies the form that owns
;;; the name. Recheck that form (macros may have changed its result), but do not
;;; confuse it with a new declaration submitted from another source.
(defn const-same-accepted-origin-in-program?
  [(program (ptr Program)) (cp (ptr Const))] (-> bool)
  (if (= (primitive/cast i64 program) 0) false
    (block :found
      (for [i 0 (len (load (.consts program)))]
        (let [old (elem (.consts program) i)]
          (when (and (= (.name old) (.name cp))
                     (and (= (.source (field old value))
                             (.source (field cp value)))
                          (and (= (.lo (field old value))
                                  (.lo (field cp value)))
                               (= (.hi (field old value))
                                  (.hi (field cp value))))))
            (break :found true))))
      false)))

(defn const-same-accepted-origin? [(parent (ptr LS)) (cp (ptr Const))]
  (-> bool)
  (if (= (primitive/cast i64 parent) 0) false
    (or (const-same-accepted-origin-in-program? (.checked parent) cp)
        (let [meta (.meta_environment parent)]
          (and (!= (primitive/cast i64 meta) 0)
               (const-same-accepted-origin-in-program? (.checked meta) cp))))))

(defn impl-has [(cx (ptr Cx)) (tr (slice u8)) (forty (slice u8))] (-> bool)
  (!= (primitive/cast i64
                      (impl-index-get (field cx trait_impl_idx)
                                      (impl-index-key (.a cx) tr forty)))
      0))

; ============================ pure type helpers ====================
(defn type-is-void [(t (ptr Type))] (-> bool)
  (match (load t) (TVoid [] true) (_ false)))

(defn type-is-never [(t (ptr Type))] (-> bool)
  (match (load t) (TNever [] true) (_ false)))

;;; void and never name no value, so they are valid only as a return type.
(defn type-is-return-only [(t (ptr Type))] (-> bool)
  (or (type-is-void t) (type-is-never t)))

(defn type-is-int [(t (ptr Type))] (-> bool)
  (match (load t) (TInt [_ _] true) (_ false)))

(defn type-is-float [(t (ptr Type))] (-> bool)
  (match (load t) (TFloat [_] true) (_ false)))

(defn type-is-ptr [(t (ptr Type))] (-> bool)
  (match (load t) (TPtr [_] true) (_ false)))

; type_mentions
(defn type-list-mentions [(v (ptr (ArrayList Type))) (name (slice u8))] (-> bool)
  (let [n (len (load v))
        (mut i) 0
        (mut f) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (type-mentions (elem v (load i)) name)
                  (store! f true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load f)))

(defn type-mentions [(t (ptr Type)) (name (slice u8))] (-> bool)
  (match (load t)
    (TStruct [n] (= n name))
    (TRef [m p] (type-mentions p name))
    (TPtr [p] (type-mentions p name))
    (TSlice [p] (type-mentions p name))
    (TArray [p k] (or (type-mentions p name)
                      (match k (ParamExtent [n] (= n name)) (_ false))))
    (TVec [p k] (or (type-mentions p name)
                    (match k (ParamExtent [n] (= n name)) (_ false))))
    (TApp [n args] (type-list-mentions args name))
    (TFn [cc ps r] (or (type-list-mentions ps name) (type-mentions r name)))
    (_ false)))

; typename_to_type
(defn typename-to-type [(name (slice u8))] (-> Type)
  (cond (= name "bool") (TBool)
        (= name "externref") (TExternRef)
        (= name "f32") (TFloat 32)
        (= name "f64") (TFloat 64)
        :else
          (let [n (len name)]
            (if (< n 2)
                (TStruct name)
                (let [c0 (primitive/cast i64 (get name 0))]
                  (if (or (= c0 105)
                          (= c0 117))
                      (let [(mut ok) true
                            (mut val) 0
                            (mut j) 1]
                        (loop (if (>= (load j) n)
                                  (break)
                                  (do
                                    (let [ch
                                            (primitive/cast i64
                                                            (get name (load j)))]
                                      (if (and (>= ch 48)
                                               (<= ch 57))
                                          (do
                                            (store! val
                                                    (primitive/iadd (primitive/imul (load val)
                                                                                    10)
                                                                    (primitive/isub ch
                                                                                    48)))
                                            0)
                                          (do (store! ok false) (break))))
                                    (store! j (primitive/iadd (load j) 1)))))
                        (if (load ok)
                            (TInt (load val) (= c0 105))
                            (TStruct name)))
                      (TStruct name)))))))

; subst_self
(defn subst-self-list [(a (dyn Allocator))
                       (v (ptr (ArrayList Type)))
                       (selfp (slice u8))
                       (concrete (ptr Type))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (ArrayList::new [Type] a)
        n (len (load v))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out)
                       (subst-self a (elem v (load i)) selfp concrete))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn subst-self [(a (dyn Allocator))
                  (t (ptr Type))
                  (selfp (slice u8))
                  (concrete (ptr Type))] (-> Type)
  (match (load t)
    (TStruct [n] (if (= n selfp) (load concrete) (TStruct n)))
    (TRef [m p] (TRef m (box-type a (subst-self a p selfp concrete))))
    (TPtr [p] (TPtr (box-type a (subst-self a p selfp concrete))))
    (TSlice [p] (TSlice (box-type a (subst-self a p selfp concrete))))
    (TArray [p k] (TArray (box-type a (subst-self a p selfp concrete)) k))
    (TVec [p k] (TVec (box-type a (subst-self a p selfp concrete)) k))
    (TApp [n args] (TApp n (subst-self-list a args selfp concrete)))
    (TFn [cc ps r]
         (TFn
           :cc cc
           :params (subst-self-list a ps selfp concrete)
           :ret (box-type a (subst-self a r selfp concrete))))
    (_ (load t))))

; erase_refs
(defn erase-refs-list [(a (dyn Allocator)) (v (ptr (ArrayList Type)))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (ArrayList::new [Type] a)
        n (len (load v))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out) (erase-refs a (elem v (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn erase-refs [(a (dyn Allocator)) (t (ptr Type))] (-> Type)
  (match (load t)
    (TRef [m p] (TPtr (box-type a (erase-refs a p))))
    (TPtr [p] (TPtr (box-type a (erase-refs a p))))
    (TArray [e k] (TArray (box-type a (erase-refs a e)) k))
    (TFn [cc ps r]
         (TFn
           :cc cc
           :params (erase-refs-list a ps)
           :ret (box-type a (erase-refs a r))))
    (_ (load t))))

; param_ref_type
(defn is-aggregate-name [(cx (ptr Cx))
                         (name (slice u8))
                         (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (and (not (set-contains tps name))
       (or (!= (primitive/cast i64 (struct-find cx name))
               0)
           (!= (primitive/cast i64 (sum-find cx name))
               0))))

;;; Does a by-value parameter of type `t` own what it is passed? It does when `t`
;;; is affine, or when it holds one of the function's own type parameters `tps`
;;; by value, so that substitution decides (`binding-may-own?`). Only `tps` can
;;; defer the answer: any other name here is a concrete type.
(defn param-may-own? [(a (dyn Allocator))
                      (cx (ptr Cx))
                      (t (ptr Type))
                      (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (or (type-is-affine a cx t)
      (and (block :mentions
             (for [i 0 (len (load tps))]
               (when (type-mentions t (get (load tps) i))
                 (break :mentions true)))
             false)
           (type-ownership-deferred? a cx t))))

(defn param-ref-type [(cx (ptr Cx))
                      (t (ptr Type))
                      (tps (ptr (ArrayList (slice u8))))] (-> Type)
  (let [a (.a cx)]
    (match (load t)
      (TRef [m p] (load t))
      (TPtr [p] (load t))
      ; Legacy aggregates keep Coil's implicit immutable-reference ABI. An affine
      ; aggregate, however, must preserve a by-value ownership boundary: spelling
      ; `T` consumes it, while `(ref T)` and `(mut T)` explicitly borrow it. So
      ; must one that may turn out affine: `(Option T)` instantiated at an owner
      ; consumes it exactly as a bare `T` does, which the call site decides from
      ; the instance (`ownership-call-param-types`).
      (TStruct [name]
               (if (is-aggregate-name cx name tps)
                   (if (param-may-own? a cx t tps)
                       (load t)
                       (TRef false (box-type a (load t))))
                   (load t)))
      (TApp [name args]
            (if (is-aggregate-name cx name tps)
                (if (param-may-own? a cx t tps)
                    (load t)
                    (TRef false (box-type a (load t))))
                (load t)))
      (TArray [e k]
              (if (param-may-own? a cx t tps)
                  (load t)
                  (TRef false (box-type a (load t)))))
      (_ (load t)))))

; Runtime aggregate parameters are still represented by an immutable pointer in a
; function body and in the lowered ABI. This is deliberately separate from the
; semantic call signature above: a plain affine `T` consumes ownership at the call
; boundary, then the callee receives a place containing that owner; explicit `(ref
; T)` remains a non-consuming borrow at both layers.
(defn param-body-ref-type [(cx (ptr Cx))
                           (t (ptr Type))
                           (tps (ptr (ArrayList (slice u8))))] (-> Type)
  (let [a (.a cx)]
    (match (load t)
      (TRef [_ _] (load t))
      (TPtr [_] (load t))
      (TStruct [name]
               (if (is-aggregate-name cx name tps)
                   (TRef false (box-type a (load t)))
                   (load t)))
      (TApp [name _]
            (if (is-aggregate-name cx name tps)
                (TRef false (box-type a (load t)))
                (load t)))
      (TArray [_ _] (TRef false (box-type a (load t))))
      (_ (load t)))))

; is_literal, is_literal_value (2827), numeric/is_cond/etc.
(defn al-last-expr [(v (ptr (ArrayList Expr)))] (-> (ptr Expr))
  (let [n (len (load v))]
    (if (<= n 0)
        (primitive/cast (ptr Expr) 0)
        (elem v (primitive/isub n 1)))))

(defn is-literal [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EInt [_] true)
    (EFloat [_] true)
    (EBin [op lhs rhs] (and (is-literal lhs) (is-literal rhs)))
    (EIf [cnd thn els] (and (is-literal thn) (is-literal els)))
    (EDo [body]
         (let [l (al-last-expr body)]
           (if (= (primitive/cast i64 l) 0)
               false
               (is-literal l))))
    (ELet [binds body]
          (let [l (al-last-expr body)]
            (if (= (primitive/cast i64 l) 0)
                false
                (is-literal l))))
    (_ false)))

(defn is-literal-value [(e (ptr Expr))] (-> bool)
  (match (.kind e) (EInt [_] true) (EFloat [_] true) (EBool [_] true) (_ false)))

;;; A folded const can become a canonical i64/f64 literal after checking. Keep
;;; the declared width in the expression tree, not only in the checker's type
;;; pair, so every backend sees the same narrowed value at each use.
(defn const-use-preserve-type [(a (dyn Allocator))
                              (value Expr)
                              (ty Type)
                              (lo i64)
                              (hi i64)
                              (src i64)
                              (ctxt i64)] (-> Expr)
  (let [narrow
          (match ty
            (TInt [bits signed] (or (!= bits 64) (not signed)))
            (TFloat [bits] (!= bits 64))
            (_ false))]
    (if narrow
        (mk-expr (ECast ty (box-expr a value)) lo hi src ctxt)
        value)))

(defn numeric [(t (ptr Type)) (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (match (load t)
    (TInt [_ _] true)
    (TFloat [_] true)
    (TStruct [n] (set-contains tps n))
    (_ false)))

(defn is-cond [(t (ptr Type))] (-> bool)
  (match (load t) (TBool [] true) (TInt [_ _] true) (_ false)))

(defn same-number-kind [(x (ptr Type)) (y (ptr Type))] (-> bool)
  (or (and (type-is-int x) (type-is-int y))
      (and (type-is-float x) (type-is-float y))))

(defn arg-ok [(got (ptr Type)) (want (ptr Type)) (is_extern bool)] (-> bool)
  (if (type-eq got want)
      true
      (and is_extern (and (type-is-ptr got) (type-is-ptr want)))))

; fits
(defn fits [(n i64) (bits i64) (signed bool)] (-> bool)
  (cond (>= bits 64) true
        signed
          (let [lo (primitive/isub 0 (primitive/ishl 1 (primitive/isub bits 1)))
                hi (primitive/isub (primitive/ishl 1 (primitive/isub bits 1)) 1)]
            (and (>= n lo) (<= n hi)))
        (>= bits 63) (>= n 0)
        :else (and (>= n 0) (< n (primitive/ishl 1 bits)))))

;;; Is the 128-bit magnitude (`hi`, `lo`) below 2^k?
(defn wide-below-pow2? [(lo i64) (hi i64) (k i64)] (-> bool)
  (cond (>= k 128) true
        (> k 64) (= (>> (primitive/cast u64 hi) (primitive/cast u64 (- k 64))) (: 0 u64))
        (= k 64) (= hi 0)
        :else (and (= hi 0) (= (>> (primitive/cast u64 lo) (primitive/cast u64 k)) (: 0 u64)))))

;;; Is the magnitude exactly 2^k?
(defn wide-is-pow2? [(lo i64) (hi i64) (k i64)] (-> bool)
  (cond (>= k 128) false
        (>= k 64) (and (= lo 0) (= hi (primitive/ishl 1 (- k 64))))
        :else (and (= hi 0) (= lo (primitive/ishl 1 k)))))

;;; Does a wide literal -- sign `neg`, magnitude (`hi`, `lo`) -- fit an integer
;;; of `bits` bits? A hex, octal or binary literal fills an unsigned or signed
;;; type alike as a bit pattern, as a narrower one always has.
(defn wide-fits? [(neg bool) (lo i64) (hi i64) (radix bool) (bits i64) (signed bool)] (-> bool)
  (cond (and radix (not neg)) (wide-below-pow2? lo hi bits)
        (and neg signed) (or (wide-below-pow2? lo hi (- bits 1)) (wide-is-pow2? lo hi (- bits 1)))
        neg false
        signed (wide-below-pow2? lo hi (- bits 1))
        :else (wide-below-pow2? lo hi bits)))

;;; A literal no i64 holds takes its type from where it stands. One of 64 bits or
;;; fewer becomes an ordinary literal of that type; a wider one keeps its value's
;;; two's-complement bits for the backend.
(defn synth-wide-int [(a (dyn Allocator))
                      (neg bool)
                      (lo i64)
                      (hi i64)
                      (radix bool)
                      (text (slice u8))
                      (expected (ptr Type))
                      (fname (slice u8))
                      (elo i64)
                      (ehi i64)
                      (esrc i64)
                      (ectxt i64)] (-> (Result EvalPair Diag))
  (let [want (if (expected-some? expected) (peel-refs expected) (null-type))
        suggestion (cond neg "i128"
                         (= hi 0) "u64"
                         :else "u128")]
    (match (if (expected-some? want) (load want) (TVoid))
      (TInt [bits signed]
            (if (not (wide-fits? neg lo hi radix bits signed))
                (err-ep (derr-at-src esrc elo ehi
                                     (sconcat a
                                              (sconcat5 a "in '" fname "': literal " text " does not fit in ")
                                              (ty-str a want))))
                (let [vlo (if neg (- 0 lo) lo)
                      ; negating 128 bits: invert the high word, and carry into it
                      ; only when the low word was zero
                      vhi (if neg (+ (primitive/ixor hi -1) (if (= lo 0) 1 0)) hi)
                      value (if (<= bits 64)
                                (mk-expr (EInt vlo) elo ehi esrc ectxt)
                                (mk-expr (EWideInt :neg false :lo vlo :hi vhi :radix true :text text)
                                         elo ehi esrc ectxt))]
                  (ok-ep (mk-expr (ECast (load want) (box-expr a value)) elo ehi esrc ectxt)
                         (load want)))))
      (_ (err-ep (derr-at-src esrc elo ehi
                              (sconcat a
                                       (sconcat5 a "in '" fname "': literal " text " does not fit in i64; give it a type that holds it, e.g. (: ")
                                       (sconcat3 a text " " (sconcat a suggestion ")")))))))))

(defn prefix-diag [(a (dyn Allocator)) (d Diag) (pre (slice u8))] (-> Diag)
  (let [dp (primitive/alloc-stack Diag)]
    (set! dp d)
    ; the place the diagnostic names, if it has one, stays
    (set! (.msg dp) (sconcat a pre (.msg dp)))
    (load dp)))

; ============================ coerce =============================
; coerce_lit
(defn coerce-lit [(a (dyn Allocator))
                  (e Expr)
                  (target (ptr Type))
                  (fname (slice u8))] (-> (Result Expr Diag))
  (let [ep (primitive/alloc-stack Expr)]
    (set! ep e)
    ; A literal, or an operation on literals alone, has the type its context gives
    ; it, not its default: that is the type `type-of` answers for it.
    (source-context-type! ep (load target))
    (let [wrap
            (mk-expr (ECast (load target) (box-expr a (load ep)))
                     (.lo ep)
                     (.hi ep)
                     (.source ep)
                     (.ctxt ep))]
      (match (.kind ep)
        (EInt [n]
              (match (load target)
                (TInt [bits signed]
                      (if (not (fits n bits signed))
                          (Err [Expr Diag]
                               (derr (sconcat a
                                              (sconcat a
                                                       (sconcat3 a
                                                                 "in '"
                                                                 fname
                                                                 "': literal ")
                                                       (i64->str a n))
                                              (sconcat a
                                                       " does not fit in "
                                                       (ty-str a target)))))
                          (Ok wrap)))
                (_ (Ok wrap))))
        (_ (Ok wrap))))))

; coerce
(defn coerce-fail [(a (dyn Allocator))
                   (et (ptr Type))
                   (target (ptr Type))
                   (fname (slice u8))
                   (what (slice u8))] (-> (Result Expr
                                                  Diag))
  (Err [Expr Diag]
       (derr (sconcat a
                      (sconcat a
                               (sconcat a
                                        (sconcat a
                                                 (sconcat3 a "in '" fname "': ")
                                                 (sconcat a what " has type "))
                                        (ty-str a et))
                               " but expected ")
                      (ty-str a target)))))

; The array -> slice borrow shared by `coerce`'s two array cases. `arr` is the
; `(array T N)` type being borrowed (reached directly or through a place
; reference), `data` the already-addressable expression to index, and `et` the
; expression's own type so a mismatch is reported as the user wrote it.
;;; The address of static storage holding the value of `e` (of type `t`): a
;;; zeroed static cell the value is stored into when the expression runs.
(defn static-spill [(a (dyn Allocator)) (e Expr) (t (ptr Type))] (-> Expr)
  (let [lo (.lo e) hi (.hi e) src (.source e) ctxt (.ctxt e)
        name (sconcat3 a "$const-spill." (i64->str a lo) (sconcat a "." (i64->str a (.node-id e))))
        cell (mk-expr (EVar name) lo hi src ctxt)
        b (primitive/alloc-stack Bind)
        (mut binds) (ArrayList::new [Bind] a)
        (mut body) (ArrayList::new [Expr] a)]
    (set! (.name b) name)
    (set! (.mutable b) false)
    (set! (.bid b) 0)
    (set! (.owned_type b) (primitive/cast (ptr Type) 0))
    (set! (.value b)
          (mk-expr (EAlloc :storage 1 :ty (load t) :init (primitive/cast (ptr Expr) 0)
                           :symbol (None [(slice u8)]))
                   lo hi src ctxt))
    (push! (mut binds) (load b))
    (push! (mut body) (mk-expr (EStore (box-expr a cell) (box-expr a e)) lo hi src ctxt))
    (push! (mut body) cell)
    (mk-expr (ELet (box-al [Bind] a (load binds)) (box-al [Expr] a (load body)))
             lo hi src ctxt)))

(defn coerce-array-to-slice [(a (dyn Allocator))
                             (ep (ptr Expr))
                             (data Expr)
                             (arr (ptr Type))
                             (et (ptr Type))
                             (target (ptr Type))
                             (fname (slice u8))
                             (what (slice u8))] (-> (Result Expr Diag))
  (match (load arr)
    (TArray [ee n]
            (match (load target)
              (TSlice [te]
                      (if (not (type-eq ee te))
                          (coerce-fail a et target fname what)
                          (Ok (mk-expr (EMakeSlice
                                         :data
                                           (box-expr a
                                                     (mk-expr (EIndex (box-expr a
                                                                                data)
                                                                      (box-expr a
                                                                                (mk-expr (EInt 0)
                                                                                         (load (field ep
                                                                                                      lo))
                                                                                         (load (field ep
                                                                                                      hi))
                                                                                         (load (field ep
                                                                                                      source))
                                                                                         (load (field ep
                                                                                                      ctxt)))))
                                                              (load (field ep
                                                                           lo))
                                                              (load (field ep
                                                                           hi))
                                                              (load (field ep
                                                                           source))
                                                              (load (field ep
                                                                           ctxt))))
                                         :elem (load ee)
                                         :len n)
                                       (load (field ep lo))
                                       (load (field ep hi))
                                       (load (field ep source))
                                       (load (field ep ctxt))))))
              (_ (coerce-fail a et target fname what))))
    (_ (coerce-fail a et target fname what))))

;;; The address a value is borrowed through: as a slice of an array, or as a
;;; `(ref T)` argument. A value read out of a place, `(.cells g)` checking to
;;; `(load (field g cells))` or `(load p)` through a pointer, borrows that place:
;;; the load's operand is already its address. Spilling the loaded value instead
;;; copies it into a frame temporary at every borrow. For an array, that copied
;;; the whole array, and a slice returned from the frame pointed into it after it
;;; was gone. For a value with a Drop impl, the temporary is an owner of its own
;;; and is dropped when the borrow ends: `(clone (load p))` released a reference
;;; it never took. Any other value is an rvalue, and the spill is its storage.
(defn borrow-address [(a (dyn Allocator)) (ep (ptr Expr))] (-> Expr)
  (match (.kind ep)
    (ELoad [place] (load place))
    (_ (mk-expr (ESpillRef (box-expr a (load ep)))
                (load (field ep lo))
                (load (field ep hi))
                (load (field ep source))
                (load (field ep ctxt))))))

;;; `(do)`: what an arm written with no body holds.
(defn empty-do? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EDo [body] (= (len (load body)) 0))
    (_ false)))

(defn coerce [(a (dyn Allocator))
              (e Expr)
              (et (ptr Type))
              (target (ptr Type))
              (is_extern bool)
              (fname (slice u8))
              (what (slice u8))] (-> (Result Expr Diag))
  (let [ep (primitive/alloc-stack Expr)]
    (set! ep e)
    (cond (type-eq et target) (Ok (load ep))
          ; An expression recovery already reported coerces silently anywhere.
          (match (load et) (TError [] true) (_ false)) (Ok (load ep))
          (type-is-void target) (Ok (load ep))
          (type-is-void et)
            (Err [Expr Diag]
                 (derr (sconcat a
                                (sconcat3 a "in '" fname "': ")
                                (sconcat a
                                         what
                                         (if (empty-do? ep)
                                             " has no body, so it yields no value; give it one, or use the result only as a statement"
                                             " uses a void value (a (-> void) call yields nothing)")))))
          (type-is-never et) (Ok (load ep))
          (and (same-number-kind et target) (is-literal ep))
            (coerce-lit a (load ep) target fname)
          ; A fixed array borrows as a slice: point the slice at element zero and
          ; carry the array's static length. `data` is the ADDRESS to index — a
          ; spill for an rvalue array, the place itself for an array read out of
          ; one (`borrow-address`), the reference itself for an array place.
          (and (= (type-tag et) 7)
               (= (type-tag target) 8))
            (coerce-array-to-slice a
                                   ep
                                   (if (> (.const_value_depth (ast-unit-state)) 0)
                                       (static-spill a (load ep) et)
                                       (borrow-address a ep))
                                   et
                                   et
                                   target
                                   fname
                                   what)
          ; An array PLACE, one indirection out. A named `let` of array type has
          ; type `(ref (array T N))`, not `(array T N)`, so the branch above never
          ; sees it; a `(ptr (array T N))` is the same shape, one indirection out.
          ; Spilling either would store the REFERENCE in a frame slot and hand the
          ; slice a pointer to a pointer, so index it directly: it is already the
          ; address the slice needs.
          (and (and (or (= (type-tag et) 4)
                        (= (type-tag et) 5))
                    (= (type-tag (t-inner et)) 7))
               (= (type-tag target) 8))
            (coerce-array-to-slice a
                                   ep
                                   (load ep)
                                   (t-inner et)
                                   et
                                   target
                                   fname
                                   what)
          (arg-ok et target is_extern) (Ok (load ep))
          :else
            (match (load et)
              (TRef [m inner]
                    (if (type-eq inner target)
                        (Ok (mk-expr (ELoad (box-expr a (load ep)))
                                     (load (field ep lo))
                                     (load (field ep hi))
                                     (load (field ep source))
                                     (load (field ep ctxt))))
                        (coerce-fail a et target fname what)))
              (TInt [_ _] (coerce-fail a et target fname what))
              (TFloat [_] (coerce-fail a et target fname what))
              (TBool [] (coerce-fail a et target fname what))
              (TVoid [] (coerce-fail a et target fname what))
              (TPtr [_] (coerce-fail a et target fname what))
              (TStruct [_] (coerce-fail a et target fname what))
              (TArray [_ _] (coerce-fail a et target fname what))
              (TSlice [_] (coerce-fail a et target fname what))
              (TVec [_ _] (coerce-fail a et target fname what))
              (TFn [_ _ _] (coerce-fail a et target fname what))
              (TApp [_ _] (coerce-fail a et target fname what))
              (TNever [] (coerce-fail a et target fname what))
              (TError [] (coerce-fail a et target fname what))
              (TCode [] (coerce-fail a et target fname what))
              (TCodeBuilder [] (coerce-fail a et target fname what))
              (TConst [_] (coerce-fail a et target fname what))
              (TExternRef [] (coerce-fail a et target fname what))))))

; const_entry
(defn const-entry [(a (dyn Allocator)) (cp (ptr Const))] (-> (Result EvalPair
                                                                     Diag))
  (let [nm (.name cp)]
    (match (.kind (.value cp))
      (EInt [n]
            (match (.ty cp)
              (None []
                    (Ok (mk-evalpair (mk-expr (EInt n) -1 -1 -1 0)
                                     (TInt 64 true))))
              (Some [wt]
                    (match wt
                      (TInt [bits signed]
                            (if (not (fits n bits signed))
                                (Err [EvalPair Diag]
                                     (derr (sconcat a
                                                    (sconcat a
                                                             (sconcat3 a
                                                                       "const '"
                                                                       nm
                                                                       "': literal ")
                                                             (i64->str a n))
                                                    (sconcat a
                                                             " does not fit in "
                                                             (ty-str a
                                                                     (box-type a
                                                                               wt))))))
                                (Ok (mk-evalpair (mk-expr (EInt n) -1 -1 -1 0)
                                                 (TInt bits signed)))))
                      (_ (Err [EvalPair Diag]
                              (derr (sconcat a
                                             (sconcat3 a
                                                       "const '"
                                                       nm
                                                       "': integer value cannot have type ")
                                             (ty-str a (box-type a wt))))))))))
      (EFloat [bits]
              (match (.ty cp)
                (None []
                      (Ok (mk-evalpair (mk-expr (EFloat bits) -1 -1 -1 0)
                                       (TFloat 64))))
                (Some [wt]
                      (match wt
                        (TFloat [b]
                                (Ok (mk-evalpair (mk-expr (EFloat bits)
                                                          -1
                                                          -1
                                                          -1
                                                          0)
                                                 (TFloat b))))
                        (_ (Err [EvalPair Diag]
                                (derr (sconcat a
                                               (sconcat3 a
                                                         "const '"
                                                         nm
                                                         "': float value cannot have type ")
                                               (ty-str a (box-type a wt))))))))))
      (EBool [b]
             (match (.ty cp)
               (None []
                     (Ok (mk-evalpair (mk-expr (EBool b) -1 -1 -1 0) (TBool))))
               (Some [wt]
                     (match wt
                       (TBool []
                              (Ok (mk-evalpair (mk-expr (EBool b) -1 -1 -1 0)
                                               (TBool))))
                       (_ (Err [EvalPair Diag]
                               (derr (sconcat a
                                              (sconcat3 a
                                                        "const '"
                                                        nm
                                                        "': boolean value cannot have type ")
                                              (ty-str a (box-type a wt))))))))))
      (_ (do
           (unimplemented "check/const-entry called on non-literal (unreachable)")
           (Err [EvalPair Diag] (derr "")))))))

; ============================ validate_type ========================
(defn validate-type-list [(v (ptr (ArrayList Type)))
                          (cx (ptr Cx))
                          (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                          Diag))
  (let [n (len (load v))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (validate-type (elem v (load i)) cx tps)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))


; ---- value generic parameters ------------------------------------------------
; A generic parameter's kind comes from its declaration: `(const N T)` records the
; value type on the parameter's Bound, and every other parameter is a type.

(defn bound-value-type [(bounds (ptr (ArrayList Bound))) (name (slice u8))] (-> (Option Type))
  (let [(mut found) (None [Type])]
    (for [i 0 (len (load bounds))]
      (let [bp (elem bounds i)]
        (when (= (.name bp) name)
          (match (.value_type bp)
            (Some [vt] (do (set! found (Some vt)) 0))
            (None [] 0)))))
    (load found)))

; The declared value type of NAME when it is a value parameter of the generic
; scope being checked (`tps`, with its declarations in `cur_bounds`).
(defn scope-value-type [(cx (ptr Cx)) (tps (ptr (ArrayList (slice u8)))) (name (slice u8))] (-> (Option Type))
  (if (set-contains tps name)
      (bound-value-type (field cx cur_bounds) name)
      (None [Type])))

(defn scope-value-param? [(cx (ptr Cx)) (tps (ptr (ArrayList (slice u8)))) (name (slice u8))] (-> bool)
  (match (scope-value-type cx tps name) (Some [_] true) (None [] false)))

(defn keyword-type? [(t (ptr Type))] (-> bool)
  (match (load t) (TStruct [name] (core-name? name "Keyword")) (_ false)))

; Value parameters are integers, booleans or keywords: values the compiler can
; compare and spell in instance names.
(defn value-param-type-ok? [(t (ptr Type))] (-> bool)
  (match (load t)
    (TInt [_ _] true)
    (TBool [] true)
    (_ (keyword-type? t))))

(defn int-const-fits? [(n i64) (bits i64) (signed bool)] (-> bool)
  (if signed
      (if (>= bits 64)
          true
          (let [half (primitive/ishl 1 (- bits 1))]
            (and (>= n (- 0 half)) (< n half))))
      (if (< n 0)
          false
          (if (>= bits 64) true (< n (primitive/ishl 1 bits))))))

(defn const-value-kind-ok? [(v ConstValue) (vt (ptr Type))] (-> bool)
  (match v
    (ConstInt [_] (match (load vt) (TInt [_ _] true) (_ false)))
    (ConstBool [_] (match (load vt) (TBool [] true) (_ false)))
    (ConstKeyword [_] (keyword-type? vt))
    ; replaced by its constant's value before any kind is asked of it
    (ConstRef [_] false)))

;;; Explicit generic arguments with each `(const NAME)` replaced by the value
;;; of the constant it names. An integer constant's value was put in place
;;; before the check (see `run-constant-lengths!`); a bool or keyword must be
;;; written as a literal (or a macro that expands to one).
(defn explicit-type-args [(a (dyn Allocator))
                          (cx (ptr Cx))
                          (written (ptr (ArrayList Type)))
                          (fname (slice u8))] (-> (Result (ptr (ArrayList Type)) Diag))
  (if (not (block :found
             (for [i 0 (len (load written))]
               (match (load (elem written i))
                 (TConst [v] (match v (ConstRef [_] (break :found true)) (_ 0)))
                 (_ 0)))
             false))
      (Ok written)
      (try (let [(mut out) (ArrayList::new [Type] a)]
             (for [i 0 (len (load written))]
               (let [t (load (elem written i))]
                 (push! (mut out)
                        (match t
                          (TConst [v]
                                  (match v
                                    (ConstRef [name] (TConst (try! (const-ref-value a cx name fname))))
                                    (_ t)))
                          (_ t)))))
             (Ok (box-al [Type] a (load out)))))))

;;; The value of the constant `name` names as a generic argument.
(defn const-ref-value [(a (dyn Allocator)) (cx (ptr Cx)) (name (slice u8)) (fname (slice u8))] (-> (Result ConstValue Diag))
  (let [ce (const-find cx name)
        shown (unqualified-tail (display-ident name))
        what (sconcat3 a "in '" fname (sconcat3 a "': the generic argument (const " shown ") "))]
    (if (= (primitive/cast i64 ce) 0)
        (Err (derr (sconcat a what "does not name a constant")))
        (match (const-literal-value (field ce value))
          (Some [v] (Ok v))
          (None [] (Err (derr (sconcat a what "names a constant whose value is computed and is not an integer; a generic argument is an integer constant, or a bool or keyword written as its value"))))))))

;;; A constant's value as a generic argument, when it is a literal.
(defn const-literal-value [(e (ptr Expr))] (-> (Option ConstValue))
  (match (.kind e)
    (EInt [n] (Some (ConstInt n)))
    (EBool [b] (Some (ConstBool b)))
    ; a narrow integer constant keeps its declared width in a cast
    (ECast [_ inner] (match (.kind inner) (EInt [n] (Some (ConstInt n))) (_ (None [ConstValue]))))
    (ECall [func _ args]
           (if (and (core-name? func "KeywordValue") (= (len (load args)) 1))
               (match (.kind (elem args 0))
                 (EStr [text] (Some (ConstKeyword text)))
                 (_ (None [ConstValue])))
               (None [ConstValue])))
    (_ (None [ConstValue]))))

(defn validate-value-param-decls [(a (dyn Allocator))
                                  (bounds (ptr (ArrayList Bound)))
                                  (owner (slice u8))] (-> (Result i64 Diag))
  (let [(mut result) (Ok [i64 Diag] 0)]
    (for [i 0 (len (load bounds))]
      (let [bp (elem bounds i)]
        (match (.value_type bp)
          (Some [vt]
            (let [cell (primitive/alloc-stack Type)]
              (store! cell vt)
              (unless (value-param-type-ok? cell)
                (set! result
                      (Err [i64 Diag]
                           (derr (sconcat a
                                          (sconcat4 a "'" owner "': value parameter '" (.name bp))
                                          (sconcat3 a "' has type " (ty-str a cell)
                                                    "; value parameters must be an integer type, bool or Keyword")))))
                0)))
          (None [] 0))))
    (load result)))

(defn generic-arg-describe [(a (dyn Allocator)) (cx (ptr Cx))
                            (tps (ptr (ArrayList (slice u8)))) (t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TConst [_] (sconcat a "constant " (ty-str a t)))
    (TStruct [name]
      (if (scope-value-param? cx tps name)
          (sconcat3 a "value parameter '" name "'")
          (sconcat a "type " (ty-str a t))))
    (_ (sconcat a "type " (ty-str a t)))))

; Checks one generic argument against its parameter's declared kind. DECL is the
; parameter's value type for a value parameter, `(None)` for a type parameter.
;;; Why `(const NAME)` in a type was not replaced by the constant's value.
(defn const-ref-type-message [(a (dyn Allocator)) (cx (ptr Cx)) (name (slice u8))] (-> (slice u8))
  (sconcat3 a "(const " (unqualified-tail (display-ident name))
            (if (= (primitive/cast i64 (const-find cx name)) 0)
                ") names no constant"
                ") names a constant whose value is computed by running code; in a type, a constant is an integer, or a bool or keyword written as its value")))

(defn const-ref-name [(v ConstValue)] (-> (slice u8))
  (match v (ConstRef [name] name) (_ "")))

(defn check-generic-arg-kind [(a (dyn Allocator))
                              (cx (ptr Cx))
                              (tps (ptr (ArrayList (slice u8))))
                              (owner (slice u8))
                              (param (slice u8))
                              (decl (Option Type))
                              (arg (ptr Type))] (-> (Result i64 Diag))
  (let [prefix (sconcat4 a "generic parameter '" param "' of '" (sconcat a (display-name owner) "'"))]
    (match decl
      (Some [vt0]
        (let [vt (primitive/alloc-stack Type)]
          (store! vt vt0)
          (let [expects (sconcat3 a " expects a constant of type " (ty-str a vt) ", got ")
                kind-error (Err [i64 Diag] (derr (sconcat3 a prefix expects (generic-arg-describe a cx tps arg))))]
            (match (load arg)
              (TConst [v]
                (cond (match v (ConstRef [_] true) (_ false))
                        (Err [i64 Diag] (derr (sconcat3 a prefix ": " (const-ref-type-message a cx (const-ref-name v)))))
                      (not (const-value-kind-ok? v vt))
                    kind-error
                    :else
                    (match v
                      (ConstInt [n]
                        (match (load vt)
                          (TInt [bits signed]
                            (if (int-const-fits? n bits signed)
                                (Ok [i64 Diag] 0)
                                (Err [i64 Diag]
                                     (derr (sconcat4 a prefix expects (ty-str a arg) " (out of range)")))))
                          (_ kind-error)))
                      (_ (Ok [i64 Diag] 0)))))
              (TStruct [name]
                (match (scope-value-type cx tps name)
                  (Some [avt0]
                    (let [avt (primitive/alloc-stack Type)]
                      (store! avt avt0)
                      (if (type-eq vt avt)
                          (Ok [i64 Diag] 0)
                          (Err [i64 Diag]
                               (derr (sconcat4 a prefix expects
                                               (generic-arg-describe a cx tps arg)
                                               (sconcat a " of type " (ty-str a avt))))))))
                  (None []
                    (if (set-contains tps name)
                        ; An undeclared width parameter from before value parameters.
                        (Err [i64 Diag]
                             (derr (sconcat4 a prefix expects (generic-arg-describe a cx tps arg)
                                             (sconcat3 a "; declare it as a value parameter, (const " name " i64), or run `coil lint --fix`"))))
                        kind-error))))
              (_ kind-error)))))
      (None []
        (match (load arg)
          (TConst [_]
            (Err [i64 Diag] (derr (sconcat3 a prefix " expects a type, got " (generic-arg-describe a cx tps arg)))))
          (TStruct [name]
            (if (scope-value-param? cx tps name)
                (Err [i64 Diag] (derr (sconcat3 a prefix " expects a type, got " (generic-arg-describe a cx tps arg))))
                (Ok [i64 Diag] 0)))
          (_ (Ok [i64 Diag] 0)))))))

; A generic argument in isolation: a constant, a value parameter in scope, or a
; valid type. Whether it suits its position is `check-generic-arg-kind`.
(defn validate-generic-arg [(t (ptr Type)) (cx (ptr Cx))
                           (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (match (load t)
    (TConst [_] (Ok [i64 Diag] 0))
    (TStruct [name]
      (if (scope-value-param? cx tps name)
          (Ok [i64 Diag] 0)
          (validate-type t cx tps)))
    (_ (validate-type t cx tps))))

(defn validate-generic-args [(args (ptr (ArrayList Type))) (cx (ptr Cx))
                            (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (try
    (let [(mut i) 0]
      (loop (if (>= (load i) (len (load args))) (break)
        (do
          (try! (validate-generic-arg (elem args (load i)) cx tps))
          (set! i (+ (load i) 1))))))
    (Ok [i64 Diag] 0)))

;;; The trait's associated parameters as this impl binds them, written in the
;;; impl's own type parameters: `Self` is the impl's (possibly generic) self type,
;;; so a receiver-dependent impl parameter such as `New` in `(ArrayList New)` does
;;; not stop the unification before it reaches an associated parameter. Callers
;;; substitute the receiver's impl bindings into the result.
(defn impl-associated-bindings [(a (dyn Allocator))
                                (im (ptr ImplDef))
                                (td (ptr TraitDef))] (-> (ptr (ArrayList SubstEntry)))
  (let [cty (field im self_type)
        selfp (.self_param td)
        extras (load (field td type_params))
        (mut binds) (ArrayList::new [SubstEntry] a)
        tms (load (field td methods))]
    (for [i 0 (len (load tms))]
      (let [tm (elem tms i)
            method (impl-find-method im (.name tm))]
        (unless (= (primitive/cast i64 method) 0)
          (let [want (subst-self-params a tm selfp cty)
                wantret (subst-self a (field tm ret) selfp cty)]
            (unify-extras-params a want method extras (mut binds))
            (unify-trait-extras a
                                (box-type a wantret)
                                (field method ret)
                                extras
                                (mut binds))
            0))))
    (box-al [SubstEntry] a (load binds))))

(defn validate-struct-name [(a (dyn Allocator))
                            (cx (ptr Cx))
                            (name (slice u8))
                            (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                            Diag))
  (if (set-contains tps name)
      (if (scope-value-param? cx tps name)
          (Err [i64 Diag]
               (derr (sconcat3 a "'" name "' is a value parameter, not a type")))
          (Ok [i64 Diag] 0))
      (let [si (struct-find cx name)]
        (if (!= (primitive/cast i64 si) 0)
            (let [np (len (load (field si type_params)))]
              (if (= np 0)
                  (Ok [i64 Diag] 0)
                  (Err [i64 Diag]
                       (derr (sconcat a
                                      (sconcat a
                                               (sconcat3 a
                                                         "generic type '"
                                                         name
                                                         "' expects ")
                                               (i64->str a np))
                                      " type arguments, got 0")))))
            (let [su (sum-find cx name)]
              (if (!= (primitive/cast i64 su) 0)
                  (let [np (len (load (field su type_params)))]
                    (if (= np 0)
                        (Ok [i64 Diag] 0)
                        (Err [i64 Diag]
                             (derr (sconcat a
                                            (sconcat a
                                                     (sconcat3 a
                                                               "generic type '"
                                                               name
                                                               "' expects ")
                                                     (i64->str a np))
                                            " type arguments, got 0")))))
                  ; No function is at hand to say which module's imports to read.
                  (Err [i64 Diag]
                       (derr (with-removed-hint a
                                                (sconcat3 a "unknown type '" name "'")
                                                (fn-unknown-hint a cx "" name))))))))))

; index of `nm` in a name list, or -1.
(defn name-index [(lst (ptr (ArrayList (slice u8)))) (nm (slice u8))] (-> i64)
  (let [n (len (load lst))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (get (load lst) (load i)) nm)
                  (store! r (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; Enforce the declared bounds of a generic struct/sum at a use site `(Box f64)`. The
; bound `[(T Eq)]` means every instantiation's T must implement Eq. Checked only when
; the argument is CONCRETE: inside a generic body `(Box T)` the argument is itself an
; in-scope type param (abstract) and cannot be checked here — that instantiation is
; verified when the enclosing generic is itself instantiated with a concrete type.
(defn tapp-arg-abstract? [(t (ptr Type)) (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (match (load t) (TStruct [nm] (set-contains tps nm)) (_ false)))

(defn check-app-bounds [(a (dyn Allocator))
                        (cx (ptr Cx))
                        (name (slice u8))
                        (bounds (ptr (ArrayList Bound)))
                        (params (ptr (ArrayList (slice u8))))
                        (args (ptr (ArrayList Type)))
                        (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                        Diag))
  (let [nb (len (load bounds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) nb)
              (break)
              (do
                (let [bp (elem bounds (load i))
                      idx (name-index params (.name bp))]
                  (when (and (>= idx 0)
                             (< idx (len (load args))))
                    (let [arg (elem args idx)]
                      (unless (tapp-arg-abstract? arg tps)
                        (let [trs (load (field bp traits))
                              nt (len (load trs))
                              (mut k) 0]
                          (loop (if (>= (load k) nt)
                                    (break)
                                    (do
                                      (let [tr
                                              (.name (elem trs
                                                           (load k)))]
                                        (unless (impl-match a cx tr arg)
                                          (store! err
                                                  (derr (sconcat a
                                                                 (sconcat a
                                                                          (sconcat a
                                                                                   (sconcat4 a
                                                                                             "'"
                                                                                             (ty-str a
                                                                                                     arg)
                                                                                             "' does not implement '"
                                                                                             (sconcat a
                                                                                                      (display-name tr)
                                                                                                      "' (required by '"))
                                                                                   name)
                                                                          "' bound on '")
                                                                 (sconcat a
                                                                          (load (field bp
                                                                                       name))
                                                                          "')"))))
                                          (store! failed true)
                                          0))
                                      (if (load failed)
                                          (break)
                                          (store! k (primitive/iadd (load k) 1))))))))
                      0)))
                (if (load failed) (break) (set! i (primitive/iadd (load i) 1))))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn check-app-kinds [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (name (slice u8))
                       (bounds (ptr (ArrayList Bound)))
                       (params (ptr (ArrayList (slice u8))))
                       (args (ptr (ArrayList Type)))
                       (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [(mut result) (Ok [i64 Diag] 0)]
    (for [i 0 (len (load args))]
      (when (match (load result) (Ok [_] true) (Err [_] false))
        (set! result
              (check-generic-arg-kind a cx tps name
                                      (get (load params) i)
                                      (bound-value-type bounds (get (load params) i))
                                      (elem args i)))
        0))
    (load result)))

(defn validate-app [(a (dyn Allocator))
                    (cx (ptr Cx))
                    (name (slice u8))
                    (args (ptr (ArrayList Type)))
                    (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (try
    (let [_args-ok (try! (validate-generic-args args cx tps))
          si (struct-find cx name)
          su (sum-find cx name)
          is-struct (!= (primitive/cast i64 si) 0)
          is-sum (!= (primitive/cast i64 su) 0)]
      (when (not (or is-struct is-sum))
        (break :try (Err [i64 Diag] (derr (sconcat3 a "unknown generic type '" name "'")))))
      (let [params (if is-struct (load (field si type_params)) (load (field su type_params)))
            bounds (if is-struct (load (field si bounds)) (load (field su bounds)))
            arity (len (load params))
            na (len (load args))]
        ; `(B)` for a type with no parameters is an application of nothing:
        ; arities agree, but no instance of it exists for mono to resolve.
        (when (and (= arity 0) (= na 0))
          (let [short (unqualified-tail (display-ident name))]
            (break :try
                     (Err [i64 Diag]
                          (derr (sconcat4 a "'" short "' is not generic; write "
                                          (sconcat4 a short ", not (" short ")")))))))
        (when (!= arity na)
          (break :try
                   (Err [i64 Diag]
                        (derr (sconcat a
                                       (sconcat a
                                                (sconcat a
                                                         (sconcat3 a "generic type '" name "' expects ")
                                                         (i64->str a arity))
                                                " type arguments, got ")
                                       (i64->str a na))))))
        (try! (check-app-kinds a cx name bounds params args tps))
        ; arity and kinds ok — now enforce the type's declared bounds on concrete args.
        (check-app-bounds a cx name bounds params args tps)))))

; A literal extent is positive -- or zero, for an array (`zero`) -- and a generic
; one names an integer value parameter.
(defn extent-valid? [(cx (ptr Cx)) (tps (ptr (ArrayList (slice u8)))) (k Extent) (zero bool)] (-> bool)
  (match k
    (FixedExtent [n] (or (> n 0) (and zero (= n 0))))
    (ParamExtent [name]
      (match (scope-value-type cx tps name)
        (Some [vt] (match vt (TInt [_ _] true) (_ false)))
        (None [] false)))))

(defn extent-error [(a (dyn Allocator)) (cx (ptr Cx)) (tps (ptr (ArrayList (slice u8))))
                    (k Extent) (what (slice u8)) (zero bool)] (-> (slice u8))
  (let [want (if zero
                 " must be a non-negative integer, an integer constant or an integer value parameter"
                 " must be a positive integer or an integer value parameter")]
    (match k
      (ParamExtent [name]
        (cond (and (set-contains tps name) (not (scope-value-param? cx tps name)))
                (sconcat4 a what " '" name
                          (sconcat3 a "' is a type parameter; declare it as a value parameter, (const " name " i64), or run `coil lint --fix`"))
              (and zero (not (set-contains tps name)))
                (sconcat3 a what " '" (sconcat a (unqualified-tail (display-ident name))
                                                (if (= (primitive/cast i64 (const-find cx name)) 0)
                                                    "' names neither an integer constant nor an integer value parameter"
                                                    ; left by a metaprogram's closure (see `run-constant-lengths!`)
                                                    "' names a constant computed by running code; code that runs at compile time (a macro and the functions it calls) cannot have such a length")))
              :else (sconcat a what want)))
      (FixedExtent [_] (sconcat a what want)))))

;;; MSG about the extent K, at the place K's name was written when it names
;;; a constant (a qualified name, written in one place; a parameter's name is
;;; written in many).
(defn extent-diag [(msg (slice u8)) (tps (ptr (ArrayList (slice u8)))) (k Extent)] (-> Diag)
  (match k
    (ParamExtent [name] (if (set-contains tps name) (derr msg) (ce-site-diag name msg)))
    (FixedExtent [_] (derr msg))))

;;; An externref is a wasm reference value. It lives in wasm locals, parameters
;;; and results, never in linear memory, so it cannot be a field, an element, a
;;; pointee, or a type argument that some generic might store.
(defn externref-storage-message [(position (slice u8))] (-> (slice u8))
  (cond (= position "a field")
          "externref cannot be a field: it cannot be stored in linear memory; keep it in a local, parameter or result, or hand it to a host table and store the index"
        (= position "an element")
          "externref cannot be an array, slice or vec element: it cannot be stored in linear memory; hand it to a host table and store the index"
        (= position "a pointee")
          "externref cannot be behind a pointer or reference: it cannot be stored in linear memory; pass the externref itself"
        :else
          "externref cannot be a type argument: a generic may store it in linear memory; hand it to a host table and pass the index"))

(defn externref? [(t (ptr Type))] (-> bool)
  (match (load t) (TExternRef [] true) (_ false)))

(defn externref-in-list? [(v (ptr (ArrayList Type)))] (-> bool)
  (let [(mut found) false]
    (for i (range 0 (len (load v)))
      (when (externref? (elem v i)) (set! found true)))
    (load found)))

(defn validate-type [(t (ptr Type))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [a (.a cx)]
    (match (load t)
      (TNever [] (Err [i64 Diag] (derr "'never' is only valid as a return type")))
      (TError [] (Ok [i64 Diag] 0))
      (TCode [] (Ok [i64 Diag] 0))
      (TCodeBuilder [] (Ok [i64 Diag] 0))
      (TConst [v]
        (Err [i64 Diag]
             (derr (match v
                     (ConstKeyword [name]
                       (match (prim-type a name)
                         (Ok [_] (sconcat4 a ":" name " is a Keyword constant, not a type; write the type as " (sconcat a name ", or run `coil lint --fix`")))
                         (Err [_] (sconcat3 a "the constant :" name " is not a runtime type"))))
                     (ConstRef [name] (const-ref-type-message a cx name))
                     (_ (sconcat3 a "the constant " (ty-str a t) " is not a runtime type"))))))
      (TExternRef [] (Ok [i64 Diag] 0))
      (TVoid [] (Err [i64 Diag] (derr "'void' is only valid as a return type")))
      (TInt [_ _] (Ok [i64 Diag] 0))
      (TFloat [_] (Ok [i64 Diag] 0))
      (TBool [] (Ok [i64 Diag] 0))
      (TPtr [p]
            (if (externref? p)
                (Err [i64 Diag] (derr (externref-storage-message "a pointee")))
                (validate-type p cx tps)))
      (TRef [m p]
            (if (externref? p)
                (Err [i64 Diag] (derr (externref-storage-message "a pointee")))
                (validate-type p cx tps)))
      (TArray [e k]
            (cond (not (extent-valid? cx tps k true))
                    (Err [i64 Diag] (extent-diag (extent-error a cx tps k "array length" true) tps k))
                  (externref? e)
                    (Err [i64 Diag] (derr (externref-storage-message "an element")))
                  :else (validate-type e cx tps)))
      (TSlice [e]
            (if (externref? e)
                (Err [i64 Diag] (derr (externref-storage-message "an element")))
                (validate-type e cx tps)))
      (TVec [e k]
            (if (not (extent-valid? cx tps k false))
                (Err [i64 Diag] (derr (extent-error a cx tps k "vec width" false)))
                (match (load e)
                  (TBool [] (Ok [i64 Diag] 0))
                  (TInt [_ _] (Ok [i64 Diag] 0))
                  (TFloat [_] (Ok [i64 Diag] 0))
                  (TStruct [p]
                           (if (set-contains tps p)
                               (Ok [i64 Diag] 0)
                               (Err [i64 Diag]
                                    (derr (sconcat a
                                                   "vec element must be a scalar int/float, got "
                                                   (ty-str a e))))))
                  (_ (Err [i64 Diag]
                          (derr (sconcat a
                                         "vec element must be a scalar int/float, got "
                                         (ty-str a e))))))))
      (TStruct [name] (validate-struct-name a cx name tps))
      (TFn [cc params ret]
           (if (= (primitive/cast i64 (conv-find cx (cc-identity cc))) 0)
               (Err [i64 Diag]
                    (derr (sconcat3 a
                                    "fnptr type: unknown convention '"
                                    (cc-text a cc)
                                    (unknown-convention-hint cc))))
               (match (validate-type-list params cx tps)
                 (Err [d] (Err [i64 Diag] d))
                 (Ok [_]
                     (if (type-is-return-only ret)
                         (Ok [i64 Diag] 0)
                         (validate-type ret cx tps))))))
      (TApp [name args]
            (if (= name "$pack-var")
                (if (and (= (len (load args)) 1)
                         (set-contains tps
                                       (type-struct-name (elem args 0))))
                    (Ok [i64 Diag] 0)
                    (Err [i64 Diag]
                         (derr "type pack is not declared in this generic scope")))
                (cond (= name "$pack") (validate-type-list args cx tps)
                      (externref-in-list? args)
                        (Err [i64 Diag] (derr (externref-storage-message "a type argument")))
                      :else (validate-app a cx name args tps)))))))

; ============================ setup (Phase 1) ======================
(defn layout-is-bits [(l (ptr Layout))] (-> bool)
  (match (load l) (LBits [b o] true) (_ false)))

;;; A checked expression with no arguments that applies the constructor NAME.
(defn conv-unit-constructor? [(e (ptr Expr)) (name (slice u8))] (-> bool)
  (match (.kind e)
    (ECall [f _ args] (and (= f name) (= (len (load args)) 0)))
    (EConstruct [_ variant args] (and (= variant name) (= (len (load args)) 0)))
    (_ false)))

;;; The lowering a checked `:lower` value names: a `coil.cc.Lowering` constructor.
(defn conv-lowering-of [(e (ptr Expr))] (-> (Option Lowering))
  (cond (conv-unit-constructor? e "coil.cc.Shim") (Some (LShim))
        (conv-unit-constructor? e "coil.cc.Reset") (Some (LReset))
        :else (None)))

;;; Why convention C cannot be a shim on ARCH: the first register it names that
;;; is not one of ARCH's general-purpose registers, or None when every one is. A
;;; function under the convention is refused with it, so a convention for another
;;; architecture is an error where it is used, as a function is.
(defn conv-non-register [(a (dyn Allocator)) (c (ptr Convention)) (arch (slice u8))] (-> (Option (slice u8)))
  (let [(mut found) (None [(slice u8)])]
    (for i (range 0 (len (load (load (field c params)))))
      (let [r (get (load (load (field c params))) i)]
        (when (and (none? [(slice u8)] (load found)) (not (arch-gpr? arch r)))
          (set! found (Some (sconcat3 a "': :params names '" r "'"))))))
    (match (.ret c)
      (Some [r]
            (when (and (none? [(slice u8)] (load found)) (not (arch-gpr? arch r)))
              (set! found (Some (sconcat3 a "': :ret names '" r "'")))))
      (None [] 0))
    (for i (range 0 (len (load (load (field c clobber)))))
      (let [r (get (load (load (field c clobber))) i)]
        (when (and (none? [(slice u8)] (load found)) (not (arch-gpr? arch r)))
          (set! found (Some (sconcat3 a "': :clobber names '" r "'"))))))
    (match (load found)
      (Some [what]
            (Some (sconcat a
                           what
                           (sconcat3 a
                                     ", which is not a general-purpose register of "
                                     arch
                                     "; declare the convention per architecture (see src/examples/shim.coil)"))))
      (None [] (None [(slice u8)])))))

;;; The sums a written `:lower` and `:layout` value is checked against. A program
;;; holding one depends on that sum though it may never name it.
(defn lowering-sum [] (-> (slice u8)) "coil.cc.Lowering")

(defn layout-sum [] (-> (slice u8)) "coil.layout.Layout")

;;; Decide each `defcc`'s `:lower` value: check it as a `coil.cc.Lowering`, then
;;; read the constructors the checked value applies. A decided convention is
;;; left alone, so checking a program twice decides nothing twice.
(defn setup-conventions [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (try (let [cs (load (field prog conventions))]
         (for [i 0 (len (load cs))]
           (let [cp (elem cs i)]
             (match (.lowering cp)
               (LowerWritten [value]
                         (let [owner (display-ident (.name cp))
                               wrong (derr-at-src (.source value)
                                                  (.lo value)
                                                  (.hi value)
                                                  (sconcat3 a
                                                            "defcc '"
                                                            owner
                                                            "': :lower takes a coil.cc.Lowering, (cc/Shim) or (cc/Reset), with coil.cc imported :as cc; a convention LLVM implements is written directly, :cc (cc/Fast)"))]
                           (when (= (primitive/cast i64 (sum-find cx (lowering-sum))) 0)
                             (break :try (Err [i64 Diag] wrong)))
                           (let [checked (match (check-to a
                                                          value
                                                          (box-type a (TStruct (lowering-sum)))
                                                          (env-new a)
                                                          cx
                                                          (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                                                          owner
                                                          (sconcat3 a "defcc '" owner "' :lower value"))
                                           (Ok [e] e)
                                           (Err [d] (break :try (Err [i64 Diag]
                                                                     (dwspan d (.source value) (.lo value) (.hi value) (.ctxt value))))))]
                             (match (conv-lowering-of (box-expr a checked))
                               (Some [lowering] (set! (.lowering cp) lowering))
                               (None [] (break :try (Err [i64 Diag] wrong)))))))
               (_ 0))))
         (Ok 0))))

;;; The `coil.layout.Layout` a checked `:layout` value names: a constructor, and
;;; for `Align` an integer literal that is a power of two.
(defn struct-layout-kind-of [(e (ptr Expr))] (-> (Option layout/Layout))
  (cond (conv-unit-constructor? e "coil.layout.C") (Some (layout/C))
        (conv-unit-constructor? e "coil.layout.Packed") (Some (layout/Packed))
        (conv-unit-constructor? e "coil.layout.Explicit") (Some (layout/Explicit))
        (conv-unit-constructor? e "coil.layout.Bits") (Some (layout/Bits))
        :else
          (let [bytes
                  (match (.kind e)
                    (EConstruct [_ variant args]
                                (if (and (= variant "coil.layout.Align") (= (len (load args)) 1))
                                    (match (.kind (elem args 0)) (EInt [v] v) (_ -1))
                                    -1))
                    (ECall [f _ args]
                           (if (and (= f "coil.layout.Align") (= (len (load args)) 1))
                               (match (.kind (elem args 0)) (EInt [v] v) (_ -1))
                               -1))
                    (_ -1))]
            (if (and (> bytes 0) (= (& bytes (- bytes 1)) 0))
                (Some (layout/Align bytes))
                (None [layout/Layout])))))

;;; Decide each struct's written `:layout` value: check it as a
;;; `coil.layout.Layout`, read the constructor, and lay the struct out by it. A
;;; decided struct is left alone, so checking a program twice decides nothing
;;; twice.
(defn setup-layouts [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (try (let [ss (load (field prog structs))]
         (for [i 0 (len (load ss))]
           (let [sp (elem ss i)]
             (match (.layout sp)
               (LayoutWritten [value pending]
                         (let [owner (display-ident (.name sp))
                               wrong (derr-at-src (.source value)
                                                  (.lo value)
                                                  (.hi value)
                                                  (sconcat3 a
                                                            "defstruct '"
                                                            owner
                                                            "': :layout takes a coil.layout.Layout, such as (layout/Packed) or (layout/Align 16), the alignment a power-of-two literal, with coil.layout imported :as layout"))]
                           (when (= (primitive/cast i64 (sum-find cx (layout-sum))) 0)
                             (break :try (Err [i64 Diag] wrong)))
                           (let [checked (match (check-to a
                                                          value
                                                          (box-type a (TStruct (layout-sum)))
                                                          (env-new a)
                                                          cx
                                                          (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                                                          owner
                                                          (sconcat3 a "defstruct '" owner "' :layout value"))
                                           (Ok [e] e)
                                           (Err [d] (break :try (Err [i64 Diag]
                                                                     (dwspan d (.source value) (.lo value) (.hi value) (.ctxt value))))))
                                 kind (match (struct-layout-kind-of (box-expr a checked))
                                        (Some [k] k)
                                        (None [] (break :try (Err [i64 Diag] wrong))))
                                 layout (match (finalize-layout a owner (Some kind) pending (load (field sp fields)))
                                          (Ok [l] l)
                                          (Err [d] (break :try (Err [i64 Diag]
                                                                    (dwspan d (.source value) (.lo value) (.hi value) (.ctxt value))))))]
                             (set! (.layout sp) layout)
                             (let [info (struct-find cx (.name sp))]
                               (unless (= (primitive/cast i64 info) 0)
                                 (set! (.is_bits info) (layout-is-bits (field sp layout))))))))
               (_ 0))))
         (Ok 0))))

;;; Check each struct's and sum's annotations against their schemas. The values
;;; are declaration-time data the compiler reads as written, so the checked
;;; forms are not kept.
(defn setup-type-annotations [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (try (do
         (for [i 0 (len (load (load (field prog structs))))]
           (let [sp (elem (load (field prog structs)) i)]
             (try! (check-annotations a cx (.annotations sp) (.name sp) (.type_params sp) (OnType)))))
         (for [i 0 (len (load (load (field prog sums))))]
           (let [sp (elem (load (field prog sums)) i)]
             (try! (check-annotations a cx (.annotations sp) (.name sp) (.type_params sp) (OnType)))))
         (Ok 0))))

;;; The end of an unknown-convention error: Coil once spelled the C convention
;;; `c`, so a convention by that name is told what replaced it.
(defn unknown-convention-hint [(ref CcRef)] (-> (slice u8))
  (if (= (scoped-ident-raw (cc-identity ref)) "c")
      "'; the C convention is (cc/C), with (import \"coil.cc\" :as cc)"
      "'"))

(defn conv-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr Convention))
  (let [cv (field cx conventions)
        n (len (load (load (field cx conventions))))
        (mut i) 0
        (mut r) (primitive/cast (ptr Convention) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (conv-name (get (load (load cv)) (load i))) name)
                  (store! r (elem (load cv) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn conv-is-shim [(c (ptr Convention))] (-> bool)
  (match (.lowering c) (LShim [] true) (_ false)))

(defn conv-is-reset [(c (ptr Convention))] (-> bool)
  (match (.lowering c) (LReset [] true) (_ false)))

(defn conv-is-native [(cx (ptr Cx)) (name (slice u8))] (-> bool)
  (let [c (conv-find cx name)]
    (and (!= (primitive/cast i64 c) 0)
         (not (conv-is-shim c)))))

(defn conv-ret-none [(c (ptr Convention))] (-> bool)
  (match (.ret c) (None [] true) (_ false)))

(defn conv-params-len [(c (ptr Convention))] (-> i64)
  (len (load (field c params))))

(defn cx-init-tables [(cx (ptr Cx)) (a (dyn Allocator))] (-> i64)
  ; a context may be built where an earlier one lived: forget what that one knew
  (set! (.cx (drop-memo)) 0)
  (set! (.buf (trait-use-index)) 0)
  (set! (.a cx) a)
  (set! (.annotation_idx cx) (HashMap::new [(slice u8) i64] a (keyops)))
  (set! (.sigs cx) (ArrayList::new [Sig] a))
  (set! (.sigidx cx) (HashMap::new [(slice u8) i64] a (keyops-borrowed)))
  (set! (.sig_base cx) (sigbase/sig-no-base))
  (set! (.retired_sigs cx) (primitive/cast (ptr (ArrayList (slice u8))) 0))
  (set! (.new_sig_names cx) (HashMap::new [(slice u8) i64] a (keyops-borrowed)))
  (set! (.structs cx) (ArrayList::new [StructInfo] a))
  (set! (.sums cx) (ArrayList::new [SumInfo] a))
  (set! (.variant_to_sum cx) (ArrayList::new [VtoS] a))
  (set! (.consts cx) (ArrayList::new [ConstEntry] a))
  (set! (.constidx cx) (HashMap::new [(slice u8) i64] a (keyops-borrowed)))
  (set! (.const_base cx) (const-no-base))
  (set! (.static_consts cx) (ArrayList::new [(slice u8)] a))
  (set! (.trait_defs cx) (ArrayList::new [TraitDef] a))
  (set! (.methods cx) (ArrayList::new [MethodEntry] a))
  (set! (.impls cx) (ArrayList::new [ImplDef] a))
  (set! (.trait_impl_idx cx)
        (HashMap::new [(slice u8) (ptr ImplBucket)] a (keyops)))
  (set! (.inherent_impl_idx cx)
        (HashMap::new [(slice u8) (ptr ImplBucket)] a (keyops)))
  (set! (.inherent_name_idx cx)
        (HashMap::new [(slice u8) (ptr ImplBucket)] a (keyops)))
  (set! (.cur_bounds cx) (ArrayList::new [Bound] a))
  (set! (.loops cx) (ArrayList::new [LoopFrame] a))
  0)

(defn annotation-def-find [(cx (ptr Cx)) (key (slice u8))] (-> (ptr AnnotationDef))
  (match (get (.annotation_idx cx) key)
    (Some [i] (elem (load (field cx annotation_defs)) i))
    (None [] (primitive/cast (ptr AnnotationDef) 0))))

(defn setup-structs [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64
                                                                                         Diag))
  (let [fs (load (field prog structs))
        n (len (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (elem fs (load i))
                      nm (.name sp)]
                  (if (!= (primitive/cast i64 (struct-find cx nm))
                          0)
                      (do
                        (set! err
                              (derr (sconcat3 a "struct '" nm "' defined twice")))
                        (set! failed true)
                        (break))
                      (let [info (primitive/alloc-stack StructInfo)]
                        (set! (.name info) nm)
                        (set! (.type_params info) (load (field sp type_params)))
                        (set! (.bounds info) (load (field sp bounds)))
                        (set! (.fields info) (load (field sp fields)))
                        (set! (.is_bits info)
                              (layout-is-bits (field sp layout)))
                        (push! (mut (.structs cx)) (load info)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn setup-sums [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64
                                                                                      Diag))
  (let [fs (load (field prog sums))
        n (len (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (elem fs (load i))
                      nm (.name sp)]
                  (if (!= (primitive/cast i64 (sum-find cx nm))
                          0)
                      (do
                        (set! err
                              (derr (sconcat3 a "sum '" nm "' defined twice")))
                        (set! failed true)
                        (break))
                      (do
                        (let [info (primitive/alloc-stack SumInfo)]
                          (set! (.name info) nm)
                          (set! (.type_params info)
                                (load (field sp type_params)))
                          (set! (.bounds info) (load (field sp bounds)))
                          (set! (.variants info) (load (field sp variants)))
                          (push! (mut (.sums cx)) (load info)))
                        (let [vs (load (field sp variants))
                              vn (len (load vs))
                              (mut j) 0]
                          (loop (if (>= (load j) vn)
                                    (break)
                                    (do
                                      (let [vp (elem vs (load j))
                                            vnm (.name vp)]
                                        (if (!= (primitive/cast i64
                                                                (vts-find cx
                                                                          vnm))
                                                0)
                                            (do
                                              (set! err
                                                    (derr (sconcat3 a
                                                                    "variant '"
                                                                    vnm
                                                                    "' is declared in two sum types")))
                                              (set! failed true)
                                              (break))
                                            (let [ve
                                                    (primitive/alloc-stack VtoS)]
                                              (set! (.variant ve) vnm)
                                              (set! (.sum ve) nm)
                                              (push! (mut (.variant_to_sum cx))
                                                     (load ve)))))
                                      (set! j (primitive/iadd (load j) 1)))))
                          (when (load failed) (break))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn trait-method-self-idx [(tp (ptr TraitMethod)) (selfp (slice u8))] (-> i64)
  (let [ps (load (field tp params))
        n (len (load ps))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (type-mentions (field (elem ps (load i)) ty)
                                     selfp)
                  (store! r (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn setup-traits [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64
                                                                                        Diag))
  (let [ts (load (field prog traits))
        n (len (load ts))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tp (elem ts (load i))
                      tnm (.name tp)
                      selfp (.self_param tp)]
                  (let [ms (load (field tp methods))
                        mn (len (load ms))
                        (mut j) 0]
                    (loop (if (>= (load j) mn)
                              (break)
                              (do
                                (let [mp (elem ms (load j))
                                      mnm (.name mp)
                                      idx (trait-method-self-idx mp selfp)]
                                  (if (< idx 0)
                                      (do
                                        (set! err
                                              (derr (sconcat a
                                                             (sconcat a
                                                                      (sconcat3 a
                                                                                "trait '"
                                                                                tnm
                                                                                "' method '")
                                                                      (sconcat3 a
                                                                                mnm
                                                                                "': needs a "
                                                                                selfp))
                                                             " (Self) parameter")))
                                        (set! failed true)
                                        (break))
                                      (let [me
                                              (primitive/alloc-stack MethodEntry)]
                                        (set! (.name me) mnm)
                                        (set! (.trait me) tnm)
                                        (set! (.self_idx me) idx)
                                        (push! (mut (.methods cx)) (load me)))))
                                (set! j (primitive/iadd (load j) 1))))))
                  (if (load failed)
                      (break)
                      (if (!= (primitive/cast i64 (trait-find cx tnm))
                              0)
                          (do
                            (set! err
                                  (derr (sconcat3 a
                                                  "trait '"
                                                  tnm
                                                  "' defined twice")))
                            (set! failed true)
                            (break))
                          (push! (mut (.trait_defs cx)) (load tp)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn copy-funcs [(a (dyn Allocator)) (fb (ptr FBox)) (prog (ptr Program))] (-> i64)
  (let [fs (load (field prog funcs))
        n (len (load fs))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut (.items fb)) (get (load fs) (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

;;; The type key a trait method is recorded under when no impl has been selected,
;;; because the receiver is a type parameter. No type is spelled this way.
(defn trait-self-key [] (-> (slice u8)) "$Self")

(defn tmfn [(a (dyn Allocator)) (tr (slice u8)) (ty (slice u8)) (m (slice u8))] (-> (slice u8))
  (sconcat3 a (sconcat3 a tr "$" ty) "$" m))

(defn inherent-fn-name [(a (dyn Allocator)) (im (ptr ImplDef)) (m (slice u8))] (-> (slice u8))
  (tmfn a
        "inherent"
        (impl-mangle-key a (field im self_type) (load (field im type_params)))
        m))

; ---- impl mangling: one symbol per IMPL, not per (trait, key) ----------------
; Several impls can now share a dispatch key — `(Pair A B)` and `(Pair i64 i64)` both
; key to "Pair" — so `Trait$key$method` no longer names a unique function. The `ty`
; passed to `tmfn` is therefore the IMPL's key (`impl-mangle-key`), not the bare
; dispatch key.
;
; A faithful, injective rendering of a Type. Deterministic and independent of
; declaration order, so the rebootstrap fixpoint holds.
(defn ty-mangle-list [(a (dyn Allocator)) (v (ptr (ArrayList Type)))] (-> (slice u8))
  (let [n (len (load v))
        (mut i) 0
        (mut s) ""]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) 0)
                  (store! s (sconcat a (load s) ","))
                  0)
                (set! s
                      (sconcat a
                               (load s)
                               (ty-mangle a (elem v (load i)))))
                (set! i (primitive/iadd (load i) 1)))))
    (load s)))

(defn ty-mangle [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TInt [b s] (sconcat a (if s "i" "u") (i64->str a b)))
    (TFloat [b] (sconcat a "f" (i64->str a b)))
    (TBool [] "bool")
    (TVoid [] "void")
    (TStruct [n] n)
    (TApp [n args] (sconcat a n (sconcat3 a "<" (ty-mangle-list a args) ">")))
    (TPtr [i] (sconcat3 a "ptr<" (ty-mangle a i) ">"))
    (TSlice [i] (sconcat3 a "slice<" (ty-mangle a i) ">"))
    (TRef [m i] (sconcat3 a (if m "mut<" "ref<") (ty-mangle a i) ">"))
    (TArray [i n]
            (sconcat a
                     "array<"
                     (sconcat a
                              (ty-mangle a i)
                              (sconcat3 a "," (extent-str a n) ">"))))
    (TVec [i n]
          (sconcat a
                   "vec<"
                   (sconcat a
                            (ty-mangle a i)
                            (sconcat3 a "," (extent-str a n) ">"))))
    (TConst [v] (sconcat a "const:" (const-value-str a v)))
    (TFn [cc ps r]
         (sconcat a
                  "fn<"
                  (sconcat a
                           (cc-identity cc)
                           (sconcat a
                                    ","
                                    (sconcat a
                                             (ty-mangle-list a ps)
                                             (sconcat3 a
                                                       ","
                                                       (ty-mangle a r)
                                                       ">"))))))
    (_ "?")))

(defn is-tparam? [(t (ptr Type)) (params (ptr (ArrayList (slice u8))))] (-> bool)
  (if (= (type-tag t) 6)
      (set-contains params (type-struct-name t))
      false))

; every arg a type param, and no param used twice (so `(Pair A A)` is NOT general —
; it is a diagonal specialization of `(Pair A B)`)
(defn args-distinct-params? [(a (dyn Allocator))
                             (v (ptr (ArrayList Type)))
                             (params (ptr (ArrayList (slice u8))))] (-> bool)
  (let [n (len (load v))
        (mut i) 0
        (mut ok) true]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (not (load ok)) (break))
                (let [e (elem v (load i))]
                  (if (not (is-tparam? e params))
                      (do (set! ok false) (break))
                      ; distinct: no EARLIER arg names the same param (all earlier args are
                      ; known tparams — we'd have bailed otherwise, so type-struct-name is safe)
                      (let [nm (type-struct-name e)
                            (mut j) 0]
                        (loop (if (>= (load j) (load i))
                                  (break)
                                  (do
                                    (when (= (type-struct-name (elem v
                                                                     (load j)))
                                             nm)
                                      (store! ok false)
                                      (break))
                                    (set! j (primitive/iadd (load j) 1))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load ok)))

; Is this impl the CANONICAL GENERAL one for its key — the head constructor applied to
; distinct type params, with nothing concrete anywhere? Those keep the plain,
; undecorated key. That is what makes this change symbol-compatible: every impl that
; existed before (scalars, plain structs, `(slice T)`, `(ArrayList T)`, `(ptr T)`, …)
; is general, so its mangled name is byte-identical to before and the blessed IR
; snapshots still match. Only genuinely specialized impls get a decorated name.
(defn impl-general? [(a (dyn Allocator))
                     (t (ptr Type))
                     (params (ptr (ArrayList (slice u8))))] (-> bool)
  (match (load t)
    (TInt [_ _] true)
    (TFloat [_] true)
    (TBool [] true)
    (TStruct [n] (not (set-contains params n)))
    (TPtr [i] (is-tparam? i params))
    (TSlice [i] (is-tparam? i params))
    (TApp [_ args] (args-distinct-params? a args params))
    ; array/vec carry a length and fn a signature — always part of the pattern, so
    ; these are never "the general impl" and always get a decorated name.
    (_ false)))

(defn impl-mangle-key [(a (dyn Allocator))
                       (t (ptr Type))
                       (params (ptr (ArrayList (slice u8))))] (-> (slice u8))
  (cond (match (load t) (TStruct [n] (set-contains params n)) (_ false)) BLANKET-IMPL-KEY
        (impl-general? a t params) (impl-base-name a t)
        :else (ty-mangle a t)))

(defn impl-find-method [(im (ptr ImplDef)) (mname (slice u8))] (-> (ptr Func))
  (let [ms (load (field im methods))
        n (len (load ms))
        (mut i) 0
        (mut r) (primitive/cast (ptr Func) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (func-name (get (load ms) (load i))) mname)
                  (store! r (elem ms (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn subst-self-params [(a (dyn Allocator))
                         (tm (ptr TraitMethod))
                         (selfp (slice u8))
                         (cty (ptr Type))] (-> (ptr (ArrayList Type)))
  (let [ps (load (field tm params))
        (mut out) (ArrayList::new [Type] a)
        n (len (load ps))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out)
                       (subst-self a
                                   (field (elem ps (load i)) ty)
                                   selfp
                                   cty))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn param-types [(a (dyn Allocator)) (ps (ptr (ArrayList Param)))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (ArrayList::new [Type] a)
        n (len (load ps))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out) (.ty (elem ps (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn impl-prefix [(a (dyn Allocator)) (tr (slice u8)) (forty (slice u8))] (-> (slice u8))
  (sconcat a (sconcat3 a "impl " tr " for ") (sconcat a forty ": ")))

; ---- trait-extras unification --------------
; Match a trait-declared type (`want`, the trait's EXTRA type parameters open)
; against an impl method's declared type (`got`): bind each extra on first
; sight, require consistency after; everything else must match exactly. The
; impl's own type params appear as plain nominal names on both sides.
(defn extras-has [(extras (ptr (ArrayList (slice u8)))) (n (slice u8))] (-> bool)
  (let [k (len (load extras))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) k)
              (break)
              (do
                (when (= (get (load extras) (load i)) n)
                  (store! r true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn pack-var? [(t (ptr Type))] (-> bool)
  (match (load t)
    (TApp [n xs] (and (= n "$pack-var") (= (len (load xs)) 1)))
    (_ false)))

(defn pack-value? [(t (ptr Type))] (-> bool)
  (match (load t) (TApp [n _] (= n "$pack")) (_ false)))

(defn pack-var-name [(t (ptr Type))] (-> (slice u8))
  (match (load t) (TApp [_ xs] (type-struct-name (elem xs 0))) (_ "")))

(defn make-pack [(a (dyn Allocator))
                 (xs (ptr (ArrayList Type)))
                 (lo i64)
                 (hi i64)] (-> Type)
  (let [(mut out) (ArrayList::new [Type] a)
        (mut i) lo]
    (loop (if (>= (load i) hi)
              (break)
              (do
                (push! (mut out) (get (load xs) (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (TApp "$pack" (box-al [Type] a (load out)))))

(defn flatten-associated-types [(a (dyn Allocator))
                                (td (ptr TraitDef))
                                (assoc (ptr (ArrayList SubstEntry)))
                                (impl-binds (ptr (ArrayList SubstEntry)))] (-> (ptr (ArrayList Type)))
  (let [params (load (field td type_params))
        (mut out) (ArrayList::new [Type] a)]
    (for [i 0 (len (load params))]
      (let [actual0 (subst-get assoc (get (load params) i))]
        (if (= (primitive/cast i64 actual0) 0)
            (push! (mut out) (TStruct "<unknown>"))
            (let [actual (subst-apply a actual0 impl-binds)
                  ap (box-type a actual)]
              (if (pack-value? ap)
                  (let [items (t-fn-params ap)]
                    (for [j 0 (len (load items))]
                      (push! (mut out) (get (load items) j))))
                  (push! (mut out) actual))))))
    (box-al [Type] a (load out))))

(defn list-pack-index [(xs (ptr (ArrayList Type)))] (-> i64)
  (let [n (len (load xs))
        (mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (pack-var? (elem xs (load i)))
                  (store! found (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn unify-extras-list [(a (dyn Allocator))
                         (w (ptr (ArrayList Type)))
                         (g (ptr (ArrayList Type)))
                         (extras (ptr (ArrayList (slice u8))))
                         (binds (ptr (ArrayList SubstEntry)))] (-> bool)
  (let [nw (len (load w))
        ng (len (load g))
        pi (list-pack-index w)
        (mut i) 0
        (mut ok) (if (< pi 0) (= nw ng) (>= ng (primitive/isub nw 1)))]
    (when (and (load ok) (>= pi 0))
      (let [tail (primitive/isub nw (primitive/iadd pi 1))
            count (primitive/isub ng (primitive/iadd pi tail))
            pn (pack-var-name (elem w pi))
            packed (make-pack a g pi (primitive/iadd pi count))
            prev (subst-get binds pn)]
        (if (= (primitive/cast i64 prev) 0)
            (subst-insert! binds pn (box-type a packed))
            (unless (type-eq prev (box-type a packed)) (store! ok false)))
        (store! i 0)
        (loop (if (or (not (load ok)) (>= (load i) pi))
                  (break)
                  (do
                    (unless (unify-trait-extras a
                                                (elem w (load i))
                                                (elem g (load i))
                                                extras
                                                binds)
                      (store! ok false))
                    (store! i (primitive/iadd (load i) 1)))))
        (store! i 0)
        (loop (if (or (not (load ok)) (>= (load i) tail))
                  (break)
                  (do
                    (unless (unify-trait-extras a
                                                (elem w
                                                      (primitive/iadd (primitive/iadd pi
                                                                                      1)
                                                                      (load i)))
                                                (elem g
                                                      (primitive/iadd (primitive/iadd pi
                                                                                      count)
                                                                      (load i)))
                                                extras
                                                binds)
                      (store! ok false))
                    (store! i (primitive/iadd (load i) 1)))))))
    (when (>= pi 0) (store! i nw))
    (loop (if (or (not (load ok)) (>= (load i) nw))
              (break)
              (do
                (unless (unify-trait-extras a
                                            (elem w (load i))
                                            (elem g (load i))
                                            extras
                                            binds)
                  (store! ok false)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load ok)))

(defn unify-trait-extras [(a (dyn Allocator))
                          (want (ptr Type))
                          (got (ptr Type))
                          (extras (ptr (ArrayList (slice u8))))
                          (binds (ptr (ArrayList SubstEntry)))] (-> bool)
  (match (load want)
    (TStruct [n]
             (if (extras-has extras n)
                 (let [b (subst-get binds n)]
                   (if (= (primitive/cast i64 b) 0)
                       (do (subst-insert! binds n got) true)
                       (type-eq b got)))
                 (type-eq want got)))
    (TRef [mw pw]
          (match (load got)
            (TRef [mg pg]
                  (and (if mw mg (not mg))
                       (unify-trait-extras a pw pg extras binds)))
            (_ false)))
    (TPtr [pw]
          (match (load got)
            (TPtr [pg] (unify-trait-extras a pw pg extras binds))
            (_ false)))
    (TSlice [pw]
            (match (load got)
              (TSlice [pg] (unify-trait-extras a pw pg extras binds))
              (_ false)))
    (TArray [pw nw]
            (match (load got)
              (TArray [pg ng]
                      (and (unify-trait-extras a
                             (box-type a (extent-type nw))
                             (box-type a (extent-type ng)) extras binds)
                           (unify-trait-extras a pw pg extras binds)))
              (_ false)))
    (TVec [pw nw]
          (match (load got)
            (TVec [pg ng]
                  (and (unify-trait-extras a
                          (box-type a (extent-type nw))
                          (box-type a (extent-type ng)) extras binds)
                       (unify-trait-extras a pw pg extras binds)))
            (_ false)))
    (TApp [nw aw]
          (match (load got)
            (TApp [ng ag]
                  (and (= nw ng) (unify-extras-list a aw ag extras binds)))
            (_ false)))
    (TFn [cw pw rw]
         (match (load got)
           (TFn [cg pg rg]
                (and (cc-same? cw cg)
                     (and (unify-extras-list a pw pg extras binds)
                          (unify-trait-extras a rw rg extras binds))))
           (_ false)))
    (_ (type-eq want got))))

(defn unify-extras-params [(a (dyn Allocator))
                           (want (ptr (ArrayList Type)))
                           (m (ptr Func))
                           (extras (ptr (ArrayList (slice u8))))
                           (binds (ptr (ArrayList SubstEntry)))] (-> bool)
  (let [got (param-types a (load (field m params)))]
    (unify-extras-list a want got extras binds)))

; Is `t` a struct, sum or array, the types an ordinary parameter receives by
; immutable reference?
(defn impl-borrowable-aggregate? [(cx (ptr Cx))
                                  (t (ptr Type))
                                  (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (match (load t)
    (TStruct [name] (is-aggregate-name cx name tps))
    (TApp [name _] (is-aggregate-name cx name tps))
    (TArray [_ _] true)
    (_ false)))

; An impl method may borrow, as `(ref T)`, a struct, sum or array parameter the
; trait declares by value as `T`. For plain data the two are one parameter: a
; by-value aggregate already travels as an immutable reference. For an owner the
; trait's `T` lets an implementation consume the argument, and an implementation
; that only reads it (`Len` on a persistent map) borrows instead, so a call
; leaves the caller's owner alive. Read the borrowed spelling as the trait's.
(defn impl-params-as-declared [(a (dyn Allocator))
                               (cx (ptr Cx))
                               (want (ptr (ArrayList Type)))
                               (m (ptr Func))
                               (tps (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList Type)))
  (let [got (param-types a (load (field m params)))]
    (for [i 0 (len (load got))]
      (when (< i (len (load want)))
        (let [w (elem want i)]
          (match (load (elem got i))
            (TRef [mu inner]
                  (when (and (not mu)
                             (and (impl-borrowable-aggregate? cx inner tps)
                                  (type-eq w inner)))
                    (set! (elem got i) (load inner))
                    0))
            (_ 0)))
        0)
      0)
    got))

(defn unify-call-params [(a (dyn Allocator))
                         (want (ptr (ArrayList Type)))
                         (m (ptr Func))
                         (self (ptr Type))
                         (tps (ptr (ArrayList (slice u8))))
                         (extras (ptr (ArrayList (slice u8))))
                         (binds (ptr (ArrayList SubstEntry)))] (-> bool)
  (let [got (param-types a (load (field m params)))
        n (len (load got))]
    (if (= n 0)
        false
        (if (not (call-receiver-matches? a self (elem got 0) tps))
            false
            (do
              (match (load (elem got 0))
                (TRef [_ inner] (set! (elem got 0) (load inner)))
                (_ 0))
              (unify-extras-list a want got extras binds))))))

(defn check-impl-methods [(a (dyn Allocator))
                          (cx (ptr Cx))
                          (im (ptr ImplDef))
                          (td (ptr TraitDef))
                          (cty (ptr Type))] (-> (Result i64
                                                        Diag))
  (let [tr (impl-trait-name im)
        forty (.for_type im)
        selfp (.self_param td)
        extras (load (field td type_params))
        (mut binds) (ArrayList::new [SubstEntry] a)
        tms (load (field td methods))
        n (len (load tms))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tm (elem tms (load i))
                      tmn (.name tm)
                      m (impl-find-method im tmn)]
                  (if (= (primitive/cast i64 m) 0)
                      (do
                        (set! err
                              (derr (sconcat a
                                             (impl-prefix a tr forty)
                                             (sconcat3 a
                                                       "missing method '"
                                                       tmn
                                                       "'"))))
                        (set! failed true)
                        (break))
                      (let [want (subst-self-params a tm selfp cty)
                            wantret (subst-self a (field tm ret) selfp cty)
                            ok-params
                              (if (= tmn "call")
                                  (unify-call-params a
                                                     want
                                                     m
                                                     cty
                                                     (load (field im
                                                                  type_params))
                                                     extras
                                                     (mut binds))
                                  (unify-extras-list a
                                                     want
                                                     (impl-params-as-declared a
                                                                              cx
                                                                              want
                                                                              m
                                                                              (load (field im
                                                                                           type_params)))
                                                     extras
                                                     (mut binds)))
                            ok-ret
                              (unify-trait-extras a
                                                  (box-type a wantret)
                                                  (field m ret)
                                                  extras
                                                  (mut binds))]
                        (when (or (not ok-params) (not ok-ret))
                          (store! err
                                  (derr (sconcat a
                                                 (impl-prefix a tr forty)
                                                 (sconcat3 a
                                                           "method '"
                                                           tmn
                                                           "' signature doesn't match the trait"))))
                          (store! failed true)
                          (break)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

; A trait impl may expose its value through call syntax by defining a `call` method.
; `call` is an ordinary namespaced impl member, not owned by a compiler-known trait.
; Its call-syntax receiver may be the implementing type or an immutable reference
; to it. The latter lets affine callable values be invoked without consuming a
; hidden by-value copy of their owner.
(defn call-receiver-matches? [(a (dyn Allocator))
                              (self (ptr Type))
                              (recv (ptr Type))
                              (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (if (and (pat-matches? a self tps recv)
           (pat-matches? a recv tps self))
      true
      (match (load recv)
        (TRef [mutable inner]
              (and (not mutable)
                   (and (pat-matches? a self tps inner)
                        (pat-matches? a inner tps self))))
        (_ false))))

(defn check-call-method [(a (dyn Allocator)) (im (ptr ImplDef))] (-> (Result i64
                                                                             Diag))
  (let [m (impl-find-method im "call")
        forty (.for_type im)]
    (if (= (primitive/cast i64 m) 0)
        (Ok [i64 Diag] 0)
        (let [ps (load (field m params))]
          (if (= (len (load ps)) 0)
              (Err [i64 Diag]
                   (derr (sconcat a
                                  (impl-prefix a (impl-trait-name im) forty)
                                  "'call' must take the callable value as its first parameter")))
              (let [recv (field (elem ps 0) ty)
                    self (field im self_type)
                    tps (load (field im type_params))]
                (if (call-receiver-matches? a self recv tps)
                    (Ok [i64 Diag] 0)
                    (Err [i64 Diag]
                         (derr (sconcat a
                                        (impl-prefix a
                                                     (impl-trait-name im)
                                                     forty)
                                        "'call' first parameter must be the implementing type"))))))))))

; Trait-method annotations are defaults inherited by every implementation. An
; implementation may not silently replace a trait-level contract such as Always.
(defn annotation-origin-present? [(xs (ptr (ArrayList Annotation)))
                                  (wanted (ptr Annotation))
                                  (i i64)] (-> bool)
  (if (>= i (len (load xs)))
      false
      (let [candidate (elem xs i)
            cv (field candidate value)
            wv (field wanted value)]
        (if (and (= (load (field candidate key)) (load (field wanted key)))
                 (and (= (load (field cv source)) (load (field wv source)))
                      (and (= (load (field cv lo)) (load (field wv lo)))
                           (= (load (field cv hi)) (load (field wv hi))))))
            true
            (annotation-origin-present? xs wanted (primitive/iadd i 1))))))

(defn inherit-trait-method-annotations! [(im (ptr ImplDef)) (td (ptr TraitDef))] (-> i64)
  (let [tms (load (field td methods))
        n (len (load tms))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tm (elem tms (load i))
                      m (impl-find-method im (.name tm))]
                  (unless (= (primitive/cast i64 m) 0)
                    (let [src (load (field tm annotations))
                          sn (len (load src))
                          dst (load (field m annotations))
                          (mut j) 0]
                      (loop (if (>= (load j) sn)
                                (break)
                                (do
                                  (let [ap (elem src (load j))]
                                    (unless (annotation-origin-present? dst
                                                                        ap
                                                                        0)
                                      (push! [Annotation] dst (load ap))))
                                  (store! j (primitive/iadd (load j) 1))))))))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn append-impl-methods [(a (dyn Allocator))
                           (im (ptr ImplDef))
                           (fb (ptr FBox))] (-> i64)
  ; the IMPL's key, not the bare dispatch key — several impls can share the latter
  (let [tr (impl-trait-name im)
        forty
          (impl-mangle-key a (field im self_type) (load (field im type_params)))
        ms (load (field im methods))
        n (len (load ms))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [lf (primitive/alloc-stack Func)]
                  (set! lf (get (load ms) (load i)))
                  (set! (.name lf) (tmfn a tr forty (.name lf)))
                  (push! (mut (.items fb)) (load lf)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn append-inherent-methods [(a (dyn Allocator))
                               (im (ptr ImplDef))
                               (fb (ptr FBox))] (-> i64)
  (let [ms (load (field im methods))
        n (len (load ms))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [lf (primitive/alloc-stack Func)]
                  (set! lf (get (load ms) (load i)))
                  (set! (.name lf) (inherent-fn-name a im (.name lf)))
                  (push! (mut (.items fb)) (load lf)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn register-impl! [(a (dyn Allocator)) (cx (ptr Cx)) (im (ptr ImplDef))] (-> i64)
  (let [slot (len (.impls cx))]
    (push! (mut (.impls cx)) (load im))
    (if (impl-is-trait im)
        (impl-index-add! a
                         (mut (.trait_impl_idx cx))
                         (impl-index-key a (impl-trait-name im) (.for_type im))
                         slot)
        (let [ms (load (field im methods))
              n (len (load ms))
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (let [name (.name (elem ms (load i)))]
                        (impl-index-add! a
                                         (mut (.inherent_impl_idx cx))
                                         (impl-index-key a name (.for_type im))
                                         slot)
                        (impl-index-add! a
                                         (mut (.inherent_name_idx cx))
                                         name
                                         slot))
                      (set! i (primitive/iadd (load i) 1)))))))
    0))

; An inherent method is receiver-dispatched when its first parameter, after
; peeling ptr/ref, is the impl target pattern. Otherwise it is an associated
; function and must be called as `Type::name` because no argument identifies its
; owner. Parameter names carry no semantics; `(db (ptr LayoutDb))` works as well
; as `(self (ptr LayoutDb))`.
(defn inherent-receiver? [(a (dyn Allocator)) (im (ptr ImplDef)) (m (ptr Func))] (-> bool)
  (let [ps (load (field m params))]
    (if (= (len (load ps)) 0)
        false
        (let [pt (field (elem ps 0) ty)
              base (peel-ref-ptr pt)
              tps (load (field im type_params))]
          (or (and (pat-matches? a (field im self_type) tps pt)
                   (pat-matches? a pt tps (field im self_type)))
              (and (pat-matches? a (field im self_type) tps base)
                   (pat-matches? a base tps (field im self_type))))))))

(defn inherent-method-duplicate? [(a (dyn Allocator))
                                  (cx (ptr Cx))
                                  (im (ptr ImplDef))
                                  (m (ptr Func))] (-> bool)
  (let [name (.name m)
        recv (inherent-receiver? a im m)
        bucket
          (impl-index-get (field cx inherent_impl_idx)
                          (impl-index-key a name (.for_type im)))
        n
          (if (= (primitive/cast i64 bucket) 0)
              0
              (len (.items bucket)))
        (mut i) 0
        (mut dup) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [old
                        (elem (field cx impls)
                              (get (.items bucket) (load i)))
                      om (impl-find-method old name)]
                  (unless (= (primitive/cast i64 om) 0)
                    (let [orecv (inherent-receiver? a old om)]
                      ; Associated functions have no receiver to select a
                      ; specialization, so one owner/name is the limit.
                      ; Every exact-pattern duplicate collides after
                      ; lowering, including receiver-vs-associated. Ordered
                      ; receiver specializations remain legal.
                      (when (or (and (pat-matches? a
                                                   (field old self_type)
                                                   (load (field old type_params))
                                                   (field im self_type))
                                     (pat-matches? a
                                                   (field im self_type)
                                                   (load (field im type_params))
                                                   (field old self_type)))
                                (and (not recv)
                                     (and (not orecv)
                                          (= (load (field old for_type))
                                             (load (field im for_type))))))
                        (store! dup true)
                        (break)))))
                (set! i (primitive/iadd (load i) 1)))))
    (load dup)))

(defn setup-one-inherent [(a (dyn Allocator))
                          (cx (ptr Cx))
                          (im (ptr ImplDef))
                          (fb (ptr FBox))] (-> (Result i64 Diag))
  (try (do
         (let [ms (load (field im methods))
               n (len (load ms))
               (mut i) 0]
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (let [m (elem ms (load i))]
                         (let [(mut j) 0]
                           (loop (if (>= (load j) (load i))
                                     (break)
                                     (do
                                       (when (= (load (field (elem ms
                                                                   (load j))
                                                             name))
                                                (load (field m name)))
                                         (break :try
                                                  (Err [i64 Diag]
                                                       (derr (sconcat3 a
                                                                       "duplicate inherent method '"
                                                                       (load (field m
                                                                                    name))
                                                                       "' in one impl")))))
                                       (store! j (primitive/iadd (load j) 1))))))
                         (when (inherent-method-duplicate? a cx im m)
                           (break :try
                                    (Err [i64 Diag]
                                         (derr (sconcat a
                                                        (sconcat3 a
                                                                  "duplicate inherent method '"
                                                                  (load (field m
                                                                               name))
                                                                  "' for '")
                                                        (sconcat a
                                                                 (ty-str a
                                                                         (field im
                                                                                self_type))
                                                                 "'")))))))
                       (store! i (primitive/iadd (load i) 1))))))
         (register-impl! a cx im)
         (append-inherent-methods a im fb)
         (Ok 0))))

(defn setup-one-impl [(a (dyn Allocator))
                      (cx (ptr Cx))
                      (im (ptr ImplDef))
                      (fb (ptr FBox))] (-> (Result i64 Diag))
  (if (impl-is-inherent im)
      (setup-one-inherent a cx im fb)
      (try (do
             (let [tr (impl-trait-name im)
                   forty (load (field im for_type))]
               (when (= (primitive/cast i64 (trait-find cx tr))
                        0)
                 (break :try
                          (Err [i64 Diag]
                               (derr (with-removed-hint a
                                                        (sconcat3 a "impl: unknown trait '" tr "'")
                                                        (fn-unknown-hint a cx "" tr))))))
               ; Several impls may share a dispatch key — `(Pair A B)` and `(Pair i64 i64)` both
               ; key to "Pair" — so a key clash is no longer a duplicate. Only two impls with the
               ; SAME PATTERN (each matching the other) are. Overlaps that are neither disjoint
               ; nor ordered (`(Pair i64 B)` vs `(Pair A bool)`) are reported at the use site
               ; that actually instantiates the overlap, not banned here.
               (when (impl-dup? a
                                cx
                                tr
                                forty
                                (field im self_type)
                                (load (field im type_params)))
                 (break :try
                          (Err [i64 Diag]
                               (impl-located (derr (sconcat a
                                              (sconcat3 a
                                                        "duplicate impl of '"
                                                        tr
                                                        "' for '")
                                              (sconcat a
                                                       (ty-str a
                                                               (field im
                                                                      self_type))
                                                       (if (blanket-impl? im)
                                                           "': a trait has at most one blanket impl, or a type could get it two ways"
                                                           "'"))))
                                             im))))
               (register-impl! a cx im)
               (let [td (trait-find cx tr)
                     cty (box-type a (load (field im self_type)))]
                 (try! (check-call-method a im))
                 (try! (check-impl-methods a cx im td cty))
                 (inherit-trait-method-annotations! im td))
               (append-impl-methods a im fb)
               (Ok 0))))))

; Accepted impl methods already occur in the retained checked function catalog.
; Identify the accepted impl, including a filtered metaprogram closure's copy of it.
(defn retained-impl? [(parent (ptr LS)) (impl (ptr ImplDef))] (-> bool)
  (if (= (primitive/cast i64 parent) 0)
      false
      (let [impls (.impls (.checked parent))]
        (block :found
          (for [i 0 (len (load impls))]
            (when (impl-of? impl (elem impls i))
              (break :found true)))
          false))))

;;; A retained impl's methods are usually in the parent's checked catalog. A
;;; metaprogram environment retains every impl but only the functions its earlier
;;; closures needed, so a method a new metaprogram reaches -- the prelude's
;;; `Mul i64`, say -- comes from the session's accepted functions instead.
(defn retained-impl-methods! [(a (dyn Allocator))
                              (im (ptr ImplDef))
                              (fb (ptr FBox))
                              (parent (ptr LS))] (-> i64)
  (let [ms (load (field im methods))]
    (for i (range 0 (len (load ms)))
      (let [method (.name (elem ms i))
            name (if (impl-is-inherent im)
                     (inherent-fn-name a im method)
                     (tmfn a
                           (impl-trait-name im)
                           (impl-mangle-key a (field im self_type) (load (field im type_params)))
                           method))]
        ; Each metaprogram image is compiled from its own closure, and a retained
        ; impl carries no method bodies, so every method it may select comes
        ; from the session's accepted functions -- including one the parent
        ; environment also holds, which only that environment's images contain.
        (match (closure-base-func name)
          (Some [function] (push! (mut (.items fb)) (load function)))
          (None [] 0)))))
  0)

(defn setup-impls [(a (dyn Allocator))
                   (cx (ptr Cx))
                   (prog (ptr Program))
                   (fb (ptr FBox))
                   (parent (ptr LS))] (-> (Result i64 Diag))
  (let [is (load (field prog impls))
        n (len (load is))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (if (retained-impl? parent (elem is (load i)))
                           (do (register-impl! a cx (elem is (load i)))
                               (retained-impl-methods! a (elem is (load i)) fb parent)
                               (Ok [i64 Diag] 0))
                           (setup-one-impl a cx (elem is (load i)) fb))
                  (Err [d] (do (set! err (impl-located d (elem is (load i)))) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

; Copy is safe only when no destructor can be skipped by bitwise duplication.
; Validate after every impl has been registered so declaration order cannot hide
; a Drop implementation. Generic Copy impls must state a Copy bound for every
; parameter: otherwise `(impl [T] Copy (Box T))` would silently make
; `Box<Droppable>` copyable.
(defn copy-impl-generic-bounds? [(im (ptr ImplDef))] (-> bool)
  (if (match (.self_type im)
        ; These representations never own or destroy their element/pointee type.
        ; Requiring `T: Copy` for `(ptr T)` or `(slice T)` would incorrectly make
        ; a pointer's copyability depend on what it merely points at.
        (TPtr [_] true)
        (TRef [_ _] true)
        (TSlice [_] true)
        (TFn [_ _ _] true)
        (_ false))
      true
      (let [ps (load (field im type_params))
            n (len (load ps))
            (mut i) 0
            (mut valid) true]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (unless (bounds-has (load (field im bounds))
                                        (get (load ps) (load i))
                                        (core-name "Copy"))
                      (store! valid false)
                      (break))
                    (set! i (primitive/iadd (load i) 1)))))
        (load valid))))

(defn check-copy-impls [(a (dyn Allocator)) (cx (ptr Cx))] (-> (Result i64 Diag))
  (try (let [is (field cx impls)
             n (len (load is))
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (let [im (elem is (load i))]
                       (when (and (impl-is-trait im)
                                  (core-name? (impl-trait-name im) "Copy"))
                         (when (or (not (copy-impl-generic-bounds? im))
                                   (type-needs-drop a cx (field im self_type)))
                           (break :try
                                    (Err [i64 Diag]
                                         (derr (sconcat a
                                                        (sconcat3 a
                                                                  "impl: Copy for '"
                                                                  (ty-str a
                                                                          (field im
                                                                                 self_type))
                                                                  "' is unsafe")
                                                        ": every generic parameter must be Copy and the type must not contain or implement Drop")))))))
                     (store! i (primitive/iadd (load i) 1)))))
         (Ok [i64 Diag] 0))))

; gen-8 supertrait enforcement. A `(deftrait Derived [Self] :requires [Base …])` makes
; `Base` a SUPERTRAIT: every `(impl Derived T)` must be accompanied by an `(impl Base T)`
; for the same implementing type. Run this AFTER `setup-impls` has registered every impl,
; so the required impl may appear anywhere in source order (impl-match sees the whole set).
(defn check-supertraits [(a (dyn Allocator)) (cx (ptr Cx))] (-> (Result i64
                                                                        Diag))
  (let [is (field cx impls)
        n (len (load is))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [im (elem is (load i))]
                  (when (impl-is-trait im)
                    (let [tr (impl-trait-name im)
                          td (trait-find cx tr)]
                      (when (!= (primitive/cast i64 td) 0)
                        (let [reqs (load (field td requires))
                              nr (len (load reqs))
                              (mut k) 0]
                          (loop (if (>= (load k) nr)
                                    (break)
                                    (do
                                      (let [req (get (load reqs) (load k))]
                                        (when (not (impl-match a
                                                               cx
                                                               req
                                                               (field im
                                                                      self_type)))
                                          (store! err
                                                  (impl-located
                                                   (derr (sconcat a
                                                                 (impl-prefix a
                                                                              (display-name tr)
                                                                              (ty-str a
                                                                                      (field im
                                                                                             self_type)))
                                                                 (sconcat a
                                                                          "requires an impl of supertrait '"
                                                                          (sconcat a
                                                                                   (display-name req)
                                                                                   "' for the same type (declared by ':requires' on the trait)"))))
                                                   im))
                                          (store! failed true)
                                          (break)))
                                      (if (load failed)
                                          (break)
                                          (store! k (primitive/iadd (load k) 1)))))))))))
                (if (load failed) (break) (set! i (primitive/iadd (load i) 1))))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn setup-one-sig [(a (dyn Allocator)) (cx (ptr Cx)) (fp (ptr Func))] (-> i64)
  (let [cc (cc-identity (.cc fp))
        tps (load (field fp type_params))
        native (conv-is-native cx cc)
        sg (primitive/alloc-stack Sig)]
    (set! (.name sg) (.name fp))
    (set! (.type_params sg) tps)
    (set! (.bounds sg) (load (field fp bounds)))
    (let [(mut names) (ArrayList::new [(slice u8)] a)
          ps (load (field fp params))
          n (len (load ps))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [param (elem ps (load i))]
                    (push! (mut names)
                           (if (.positional_only param) "" (.name param))))
                  (set! i (primitive/iadd (load i) 1)))))
      (set! (.param_names sg) (box-al [(slice u8)] a (load names))))
    ; Whether a parameter may own depends on the function's own bounds (`T: Copy`
    ; never owns), as it does when the body is checked.
    (let [saved (load (field cx cur_bounds))]
      (store! (field cx cur_bounds) (load (load (field fp bounds))))
      (set! (.params sg) (param-ref-types a cx (load (field fp params)) tps))
      (store! (field cx cur_bounds) saved))
    (set! (.fnptr_params sg) (load (field sg params)))
    (set! (.ret sg) (.ret fp))
    (set! (.is_extern sg) false)
    (set! (.variadic sg) false)
    (set! (.cc sg) cc)
    ; A generic function's pointer is to one of its instances, `(fnptr-of f [T…])`.
    (set! (.fnptr_ok sg) native)
    (push! (mut (.sigs cx)) (load sg))
    (sig-index-put! cx (.name sg))
    (set! (mut (.new_sig_names cx)) (.name sg) 0)
    0))

(defn param-ref-types [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (ps (ptr (ArrayList Param)))
                       (tps (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (ArrayList::new [Type] a)
        n (len (load ps))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out)
                       (param-ref-type cx
                                       (field (elem ps (load i)) ty)
                                       tps))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn setup-sigs [(a (dyn Allocator))
                  (cx (ptr Cx))
                  (allf (ptr (ArrayList Func)))] (-> i64)
  (let [n (len (load allf))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (setup-one-sig a cx (elem allf (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn setup-retained-sigs [(a (dyn Allocator)) (cx (ptr Cx))
                           (allf (ptr (ArrayList Func))) (parent (ptr LS))] (-> i64)
  (for [i 0 (len (load allf))]
    (let [f (elem allf i)]
      (when (and (or (= (primitive/cast i64 parent) 0)
                     (not (ls-same-function? parent f)))
                 (not (closure-base-accepted? f)))
        (setup-one-sig a cx f) 0)))
  0)

;; Restore the CHECKED callable surface for a Program that has already been checked.
;;
;; `fnptr-of` reports a function's type from its signature, and a checked Program has
;; erased its aggregate parameters to pointers -- so re-checking one produced
;; `(fnptr (cc/C) [(ptr T)] R)` where every other part of the compiler says
;; `(fnptr (cc/C) [(ref T)] R)`, and any place holding that function pointer rejected it.
;; The REPL hit this on every reload of a definition taking a struct by value: the
;; retained declaration types the cell `(ref T)` while `fnptr-of` on the retained
;; implementation typed it `(ptr T)`, so the session died on a program that compiles
;; perfectly well ahead of time.
;;
;; `function_abis` is that surface, recorded when the Program was checked and carried
;; through mono, so it is the authority here. Exports keep their own repair below:
;; theirs is the C signature, which is a different question from the Coil call ABI.
(defn setup-checked-fnptr-sigs [(a (dyn Allocator))
                                (cx (ptr Cx))
                                (prog (ptr Program))] (-> i64)
  (let [surfaces (load (field prog function_abis))
        n (len (load surfaces))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [surface (elem surfaces (load i))
                  sg (sig-find-local cx (.name surface))]
                  (when (and (!= (primitive/cast i64 sg) 0)
                             (not (load (field sg is_extern))))
                    ; The call surface too: a constant's initializer is checked
                    ; again from source whenever the checked Program is set up
                    ; (mono does, for its tables), and a call in it that passes
                    ; an aggregate must meet `(ref T)`, not the lowered pointer.
                    (set! (.params sg) (load (field surface params)))
                    (set! (.fnptr_params sg) (load (field surface params)))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn setup-export-fnptr-sigs [(a (dyn Allocator))
                               (cx (ptr Cx))
                               (prog (ptr Program))] (-> i64)
  (let [es (load (field prog exports))
        n (len (load es))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (elem es (load i))
                      sg (sig-find-local cx (load (field ep name)))
                      fp (prog-fn-find prog (load (field ep name)))]
                  (when (and (!= (primitive/cast i64 sg) 0)
                             (!= (primitive/cast i64 fp) 0))
                    ; A checked Program already erased aggregate function parameters
                    ; to pointers, but its ExportC retains the source C signature.
                    (set! (.fnptr_params sg)
                          (if (> (len (load (.params ep))) 0)
                              (.params ep)
                              (param-types a (load (field fp params)))))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    0))

;;; `module.name [params] -> ret`, naming which module declared an extern and how.
(defn extern-signature-text [(a (dyn Allocator)) (e (ptr Extern))] (-> (slice u8))
  (sconcat3 a
            (sconcat3 a (.name e) " [" (ty-str-join a (.params e)))
            (if (.variadic e) " ...] -> " "] -> ")
            (ty-str a (field e ret))))

;;; Two declarations of one C symbol side by side, with their conventions when
;;; that is where they differ.
(defn extern-pair-text [(a (dyn Allocator)) (x (ptr Extern)) (y (ptr Extern))] (-> (slice u8))
  (if (cc-same? (.cc x) (.cc y))
      (sconcat3 a (extern-signature-text a x) " and " (extern-signature-text a y))
      (sconcat3 a
                (sconcat3 a (extern-signature-text a x) " :cc " (cc-text a (.cc x)))
                " and "
                (sconcat3 a (extern-signature-text a y) " :cc " (cc-text a (.cc y))))))

;;; A diagnostic about an extern declaration points at its signature.
(defn extern-located [(ep (ptr Extern)) (d Diag)] (-> Diag)
  (if (< (.span_source ep) 0)
      d
      (dwspan d (.span_source ep) (.params_lo ep) (.ret_hi ep) 0)))

(defn setup-externs [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))]
  (-> (Result i64
                                                                                         Diag))
  (let [es (load (field prog externs))
        (mut linker-names) (HashMap::new [(slice u8) i64] a (keyops))
        n (len (load es))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (elem es (load i))
                      nm (.name ep)
                      c (conv-find cx (cc-identity (.cc ep)))]
                  ; An unknown convention first: compared with another declaration
                  ; of the symbol, it reads as a mismatch nothing on screen shows.
                  (when (= (primitive/cast i64 c) 0)
                    (set! err
                          (derr (sconcat3 a
                                          (sconcat3 a
                                                    "extern '"
                                                    nm
                                                    "': unknown convention '")
                                          (cc-text a (.cc ep))
                                          (unknown-convention-hint (.cc ep)))))
                    (set! failed true)
                    (break))
                  (match (get (load linker-names) (extern-link-name ep))
                    (Some [prior]
                          (unless (extern-abi-compatible (elem es prior) ep)
                            (set! err
                                  (derr (sconcat a
                                                 (sconcat3 a
                                                           "C symbol '"
                                                           (extern-link-name ep)
                                                           "' is declared twice with incompatible signatures: ")
                                                 (extern-pair-text a (elem es prior) ep))))
                            (set! failed true)
                            0))
                    (None []
                          (set! (mut linker-names)
                                (extern-link-name ep)
                                (load i))))
                  (when (load failed) (break) 0)
                  ; validate the signature's types up front, so an unknown type in an extern
                  ; declaration is a clean diagnostic instead of a later codegen crash.
                  (match (validate-type-list (load (field ep params))
                                             cx
                                             (empty-strs a))
                    (Err [d] (do (set! err d) (set! failed true) 0))
                    (Ok [_]
                        (unless (type-is-return-only (field ep ret))
                          ; void and never are valid in return position
                          (match (validate-type (field ep ret)
                                                cx
                                                (empty-strs a))
                            (Err [d] (do (store! err d) (store! failed true) 0))
                            (Ok [_] 0)))))
                  (if (load failed)
                      (break)
                      (if (!= (primitive/cast i64 (sig-find-local cx nm))
                              0)
                          (do
                            (set! err
                                  (derr (sconcat3 a
                                                  "'"
                                                  nm
                                                  "' is declared more than once")))
                            (set! failed true)
                            (break))
                          (if (conv-is-shim c)
                              (do
                                (set! err
                                      (derr (sconcat3 a
                                                      "extern '"
                                                      nm
                                                      "': shim conventions for externs are not supported yet")))
                                (set! failed true)
                                (break))
                              (let [sg (primitive/alloc-stack Sig)]
                                (set! (.name sg) nm)
                                (set! (.type_params sg) (empty-strs a))
                                (set! (.bounds sg)
                                      (box-al [Bound]
                                              a
                                              (ArrayList::new [Bound] a)))
                                (set! (.param_names sg) (empty-strs a))
                                (set! (.params sg)
                                      (load (field ep params)))
                                (set! (.fnptr_params sg)
                                      (load (field ep params)))
                                (set! (.ret sg) (.ret ep))
                                (set! (.is_extern sg) true)
                                (set! (.variadic sg)
                                      (.variadic ep))
                                (set! (.cc sg) (cc-identity (.cc ep)))
                                (set! (.fnptr_ok sg) true)
                                (push! (mut (.sigs cx)) (load sg))
                                (sig-index-put! cx (.name sg))
                                (match (sigbase/sig-base-get (.sig_base cx) (.name sg))
                                  (None []
                                    (set! (mut (.new_sig_names cx)) (.name sg) 0))
                                  (Some [_] 0)))))))
                (set! i (primitive/iadd (load i) 1)))))
    ; the loop stops at the extern it failed on
    (if (load failed)
        (Err (extern-located (elem es (load i)) (load err)))
        (Ok [i64 Diag] 0))))

(defn opt-type-some? [(o (ptr (Option Type)))] (-> bool)
  (match (load o) (Some [t] true) (_ false)))

(defn opt-type-val [(o (ptr (Option Type)))] (-> Type)
  (match (load o) (Some [t] t) (_ (TVoid))))

(defn type-is-aggregate-static [(t (ptr Type))] (-> bool)
  (match (load t) (TStruct [_] true) (TApp [_ _] true) (TArray [_ _] true) (_ false)))

;;; A constant's value, and a `def`'s, is checked with static spills (see
;;; static-spill): either may be computed at compile time and read back after
;;; the frame that computed it is gone.
(defn compute-const-entry [(a (dyn Allocator)) (cx (ptr Cx)) (cp (ptr Const))] (-> (Result EvalPair
                                                                                           Diag))
  (let [u (ast-unit-state)
        saved (.const_value_depth u)
        ; Before checking: does the initializer itself ask for storage or an
        ; address (`alloc-static`, `fnptr-of`, `fn`, a C string)?
        linked (expr-names-link-address? a (field cp value) true)]
    (set! (.const_value_depth u) (+ saved 1))
    (let [r (compute-const-entry-value a cx cp)]
      (set! (.const_value_depth u) saved)
      (if (or (not (.runtime cp)) (.declared cp))
          r
          (try (let [ev (try! r)
                     value (try! (def-initializer a cx (box-expr a (.e ev)) (box-type a (.t ev)) linked))]
                 (Ok (mk-evalpair value (.t ev)))))))))

;;; Does `e` hold an address only the linker knows: static storage's, a
;;; function's, a C string's, another def's? `source` is true for an unchecked
;;; initializer, where an anonymous fn asks for one too. In a checked tree an
;;; allocation a let binds is not one: array literals allocate statics of their
;;; own, which computing the value at compile time replaces.
(defn expr-names-link-address? [(a (dyn Allocator)) (e (ptr Expr)) (source bool)] (-> bool)
  (match (.kind e)
    (EFnPtrOf [_] true)
    (EFnPtrInst [_ _] true)
    (ECStr [_] true)
    (EStaticRef [_] true)
    (EAnonFn [_ _] true)
    (EAlloc [storage _ _ _] (= storage 1))
    (ELet [binds body]
          (block :found
            (for [i 0 (len (load binds))]
              (let [value (field (elem binds i) value)]
                (when (match (.kind value)
                        (EAlloc [_ _ init _]
                                (if source
                                    true
                                    (and (!= (primitive/cast i64 init) 0)
                                         (expr-names-link-address? a init source))))
                        (_ (expr-names-link-address? a value source)))
                  (break :found true))))
            (for [i 0 (len (load body))]
              (when (expr-names-link-address? a (elem body i) source)
                (break :found true)))
            false))
    (_ (let [(mut kids) (ArrayList::new [(ptr Expr)] a)]
         (ownership-children! e (mut kids))
         (block :found
           (for [i 0 (len kids)]
             (when (expr-names-link-address? a (get kids i) source)
               (break :found true)))
           false)))))

;;; The first part of a checked initializer that is not a link-time constant,
;;; or null when all of it is one: the shapes every backend lays into a
;;; static's data. Literals, sums of them, function and static addresses, and
;;; aggregates built field by field or element by element.
(defn static-unlinkable-part [(cx (ptr Cx)) (e (ptr Expr))] (-> (ptr Expr))
  (let [none (primitive/cast (ptr Expr) 0)]
    (match (.kind e)
      (EInt [_] none)
      (EFloat [_] none)
      (EBool [_] none)
      (EStr [_] none)
      (ECStr [_] none)
      (EZeroed [_] none)
      (ERecordInit [_] none)
      (EFnPtrOf [_] none)
      (EFnPtrInst [_ _] none)
      ; computed at compile time, before any backend sees it
      (EComptime [_] none)
      (EConstruct [_ _ args] (static-unlinkable-in cx args))
      ; a variant's constructor, which checking leaves a call
      (ECall [func _ args]
             (if (= (primitive/cast i64 (vts-find cx func)) 0) e (static-unlinkable-in cx args)))
      (EStaticArray [_ items] (static-unlinkable-in cx items))
      (EAlloc [storage _ init _]
              (cond (!= storage 1) e
                    (= (primitive/cast i64 init) 0) none
                    :else (static-unlinkable-part cx init)))
      (EMakeSlice [data _ _] (static-unlinkable-part cx data))
      (ELoad [inner] (static-unlinkable-part cx inner))
      (ECast [ty inner]
             (match ty
               ; an absolute address, written as an integer
               (TPtr [_] (if (static-address? inner) none e))
               (TFn [_ _ _]
                    (match (.kind inner)
                      (EFnPtrOf [_] none)
                      (EFnPtrInst [_ _] none)
                      (_ (if (static-address? inner) none e))))
               (TInt [_ _] (match (.kind inner) (EInt [_] none) (EWideInt [_ _ _ _ _] none) (_ e)))
               (TFloat [_] (match (.kind inner) (EFloat [_] none) (_ e)))
               (_ e)))
      (ELet [_ body]
            (let [n (len (load body))]
              (block :found
                (for [i 0 n]
                  (let [item (elem body i)
                        value
                          (match (.kind item)
                            (EStore [place value] (if (static-element-place? place) value item))
                            (EInitStore [place value] (if (static-element-place? place) value item))
                            ; the aggregate itself, after its elements
                            (EVar [_] (if (= i (- n 1)) none item))
                            (ELoad [inner]
                                   (match (.kind inner)
                                     (EVar [_] (if (= i (- n 1)) none item))
                                     (_ item)))
                            (_ item))]
                    (unless (= (primitive/cast i64 value) 0)
                      (let [part (if (= value item) item (static-unlinkable-part cx value))]
                        (unless (= (primitive/cast i64 part) 0)
                          (break :found part))
                        0))
                    0))
                none)))
      (_ e))))

;;; Is `e` an integer literal, possibly under further casts, that a pointer
;;; cast makes an absolute address?
(defn static-address? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EInt [_] true)
    (ECast [_ inner] (static-address? inner))
    (_ false)))

(defn static-unlinkable-in [(cx (ptr Cx)) (items (ptr (ArrayList Expr)))] (-> (ptr Expr))
  (block :found
    (for [i 0 (len (load items))]
      (let [part (static-unlinkable-part cx (elem items i))]
        (unless (= (primitive/cast i64 part) 0) (break :found part))
        0))
    (primitive/cast (ptr Expr) 0)))

;;; Is `place` a field of the aggregate being built, or an element of it at a
;;; constant index?
(defn static-element-place? [(place (ptr Expr))] (-> bool)
  (match (.kind place)
    (EField [base _] (match (.kind base) (EVar [_] true) (_ false)))
    (EIndex [base index]
            (and (match (.kind base) (EVar [_] true) (_ false))
                 (match (.kind index) (EInt [_] true) (_ false))))
    (_ false)))

;;; A `def`'s initializer as its storage is laid out: a link-time constant as
;;; it stands; otherwise its value computed at compile time. When the value
;;; holds addresses -- `linked` says the source asked for one -- they stay for
;;; the linker, and each part between them that is not yet a constant is
;;; computed at compile time on its own.
(defn def-initializer [(a (dyn Allocator)) (cx (ptr Cx)) (e (ptr Expr)) (t (ptr Type)) (linked bool)] (-> (Result Expr Diag))
  (try (let [value (try! (if (or linked (expr-names-link-address? a e false))
                             (static-link-parts a cx e)
                             (Ok [Expr Diag] (computed-at-compile-time a cx e))))]
         ; Built field by field or element by element, the value must be a
         ; struct or an array: a let yielding anything else (a pointer to the
         ; storage it binds) is not laid out from its stores.
         (match (.kind (static-value-core value))
           (ELet [_ _]
                 (unless (type-is-aggregate-static t)
                   (break :try (Err (static-link-diag a e)))))
           (_ 0))
         (Ok value))))

;;; `e` under the reads that a static's value passes through.
(defn static-value-core [(e Expr)] (-> Expr)
  (match (.kind e)
    (ELoad [inner] (static-value-core (load inner)))
    (_ e)))

;;; `e` as a constant: itself when it is one, and otherwise its value
;;; computed at compile time.
(defn computed-at-compile-time [(a (dyn Allocator)) (cx (ptr Cx)) (e (ptr Expr))] (-> Expr)
  (if (= (primitive/cast i64 (static-unlinkable-part cx e)) 0)
      (load e)
      (mk-expr (EComptime e) (.lo e) (.hi e) (.source e) (.ctxt e))))

(defn static-link-parts [(a (dyn Allocator)) (cx (ptr Cx)) (e (ptr Expr))] (-> (Result Expr Diag))
  (try
    (cond (= (primitive/cast i64 (static-unlinkable-part cx e)) 0) (Ok (load e))
          (not (expr-names-link-address? a e false)) (Ok (computed-at-compile-time a cx e))
          :else
            (let [rebuilt (box-expr a (load e))]
              (match (.kind e)
                (EConstruct [sum variant args]
                            (set! (.kind rebuilt) (EConstruct sum variant (try! (static-link-list a cx args)))))
                (ECall [func targs args]
                       (if (= (primitive/cast i64 (vts-find cx func)) 0)
                           (break :try (Err (static-link-diag a e)))
                           (set! (.kind rebuilt) (ECall func targs (try! (static-link-list a cx args))))))
                (EStaticArray [indices items]
                              (set! (.kind rebuilt) (EStaticArray indices (try! (static-link-list a cx items)))))
                (EAlloc [storage ty init symbol]
                        (set! (.kind rebuilt)
                              (EAlloc :storage storage :ty ty :symbol symbol
                                      :init (box-expr a (try! (static-link-parts a cx init))))))
                (EMakeSlice [data elem n]
                            (set! (.kind rebuilt) (EMakeSlice (box-expr a (try! (static-link-parts a cx data))) elem n)))
                (ELoad [inner]
                       (set! (.kind rebuilt) (ELoad (box-expr a (try! (static-link-parts a cx inner))))))
                (ECast [ty inner]
                       (set! (.kind rebuilt) (ECast ty (box-expr a (try! (static-link-parts a cx inner))))))
                (ELet [binds body]
                      (if (named-args-let? binds body)
                          ; A constructor whose arguments were bound in source
                          ; order: at link time there is no order, so each value
                          ; goes straight into the store that reads it.
                          (break :try (static-link-parts a cx (named-args-inlined a binds body)))
                      (let [(mut out) (ArrayList::new [Expr] a)]
                        (for [i 0 (len (load body))]
                          (let [item (elem body i)]
                            (push! (mut out)
                                   (match (.kind item)
                                     (EStore [place value]
                                             (if (static-element-place? place)
                                                 (mk-expr (EStore place (box-expr a (try! (static-link-parts a cx value))))
                                                          (.lo item) (.hi item) (.source item) (.ctxt item))
                                                 (break :try (Err (static-link-diag a item)))))
                                     (EInitStore [place value]
                                                 (if (static-element-place? place)
                                                     (mk-expr (EInitStore place (box-expr a (try! (static-link-parts a cx value))))
                                                              (.lo item) (.hi item) (.source item) (.ctxt item))
                                                     (break :try (Err (static-link-diag a item)))))
                                     (_ (load item))))))
                        (set! (.kind rebuilt) (ELet binds (box-al [Expr] a (load out)))))))
                (_ (break :try (Err (static-link-diag a e)))))
              ; what is left must now be laid out by the linker
              (let [part (static-unlinkable-part cx rebuilt)]
                (if (= (primitive/cast i64 part) 0)
                    (Ok (load rebuilt))
                    (Err (static-link-diag a part))))))))

;;; Is this the let a constructor written out of declaration order binds its
;;; arguments in (see named-source-binds), around the constructor itself?
(defn named-args-let? [(binds (ptr (ArrayList Bind))) (body (ptr (ArrayList Expr)))] (-> bool)
  (and (= (len (load body)) 1)
       (> (len (load binds)) 0)
       (block :found
         (for [i 0 (len (load binds))]
           (unless (named-temp-name? (.name (elem binds i))) (break :found false)))
         true)))

;;; The constructor under a named-args let, with each store of an argument
;;; temporary storing the argument's value instead.
(defn named-args-inlined [(a (dyn Allocator)) (binds (ptr (ArrayList Bind))) (body (ptr (ArrayList Expr)))] (-> (ptr Expr))
  (let [ctor (elem body 0)]
    (match (.kind ctor)
      (ELoad [inner]
             (box-expr a (mk-expr (ELoad (named-args-inlined-ctor a binds inner))
                                  (.lo ctor) (.hi ctor) (.source ctor) (.ctxt ctor))))
      (_ (named-args-inlined-ctor a binds ctor)))))

(defn named-args-inlined-ctor [(a (dyn Allocator)) (binds (ptr (ArrayList Bind))) (ctor (ptr Expr))] (-> (ptr Expr))
  (match (.kind ctor)
    (ELet [cbinds cbody]
          (let [(mut out) (ArrayList::new [Expr] a)]
            (for [i 0 (len (load cbody))]
              (let [item (elem cbody i)
                    value (static-store-value item)
                    bound (if (= (primitive/cast i64 value) 0)
                              (primitive/cast (ptr Expr) 0)
                              (named-arg-bound binds value))]
                (push! (mut out)
                       (if (= (primitive/cast i64 bound) 0)
                           (load item)
                           (mk-expr (match (.kind item)
                                      (EStore [place _] (EStore place bound))
                                      (_ (EInitStore (static-store-place item) bound)))
                                    (.lo item) (.hi item) (.source item) (.ctxt item))))))
            (box-expr a (mk-expr (ELet cbinds (box-al [Expr] a (load out)))
                                 (.lo ctor) (.hi ctor) (.source ctor) (.ctxt ctor)))))
    (_ ctor)))

;;; The value bound to the argument temporary `e` reads, or null.
(defn named-arg-bound [(binds (ptr (ArrayList Bind))) (e (ptr Expr))] (-> (ptr Expr))
  (let [name (match (.kind e)
               (EVar [n] n)
               (ELoad [inner] (match (.kind inner) (EVar [n] n) (_ "")))
               (_ ""))]
    (block :found
      (for [i 0 (len (load binds))]
        (let [b (elem binds i)]
          (when (and (!= (len name) 0) (= (.name b) name))
            (break :found (owned-place-initializer (field b value))))))
      (primitive/cast (ptr Expr) 0))))

;;; The value a binding is initialized with: for one bind-owned-place! gave
;;; its own slot, `(do (init-store slot value) slot)`, that value.
(defn owned-place-initializer [(e (ptr Expr))] (-> (ptr Expr))
  (match (.kind e)
    (EDo [body]
         (if (= (len (load body)) 2)
             (match (.kind (elem body 0))
               (EInitStore [place value]
                           (match (.kind place) (EVar [_] value) (_ e)))
               (_ e))
             e))
    (_ e)))

(defn static-link-list [(a (dyn Allocator)) (cx (ptr Cx)) (items (ptr (ArrayList Expr)))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (try (let [(mut out) (ArrayList::new [Expr] a)]
         (for [i 0 (len (load items))]
           (push! (mut out) (try! (static-link-parts a cx (elem items i)))))
         (Ok (box-al [Expr] a (load out))))))

(defn static-link-diag [(a (dyn Allocator)) (part (ptr Expr))] (-> Diag)
  (let [read (first-static-ref a part)]
    (if (!= (primitive/cast i64 read) 0)
        (derr-at-src (.source read) (.lo read) (.hi read)
                     (match (.kind read)
                       (EStaticRef [name]
                                   (sconcat3 a
                                             "a def's initializer cannot read the def '"
                                             (unqualified-tail (display-ident name))
                                             "': defs are laid out when the program is linked, before any of them holds a value; make it a const"))
                       (_ "")))
        (derr-at-src (.source part) (.lo part) (.hi part)
                     "a def's value is laid out when the program is linked, because it holds an address (a function, a C string or static storage); this part of it is neither a constant nor computable on its own at compile time"))))

;;; The first reference to a def inside `e`, or null.
(defn first-static-ref [(a (dyn Allocator)) (e (ptr Expr))] (-> (ptr Expr))
  (match (.kind e)
    (EStaticRef [_] e)
    (_ (let [(mut kids) (ArrayList::new [(ptr Expr)] a)]
         (ownership-children! e (mut kids))
         (block :found
           (for [i 0 (len kids)]
             (let [found (first-static-ref a (get kids i))]
               (unless (= (primitive/cast i64 found) 0) (break :found found))
               0))
           (primitive/cast (ptr Expr) 0))))))

(defn compute-const-entry-value [(a (dyn Allocator)) (cx (ptr Cx)) (cp (ptr Const))] (-> (Result EvalPair
                                                                                                 Diag))
  ; A const is already evaluated at compile time, so `(const X (comptime E))`
  ; means `(const X E)`. Kept, the `EComptime` each use wraps around the value
  ; nested a second one that no fold reached. A runtime `def` keeps it: there the
  ; comptime is what makes the initializer a link-time constant.
  (unless (.runtime cp)
    (loop
      (match (.kind (field cp value))
        (EComptime [inner] (set! (.value cp) (load inner)))
        (_ (break))))
    0)
  (cond
    ; Storage another unit defines: its declared type is all there is to check.
    (.declared cp)
      (match (.ty cp)
        (Some [want]
          (match (validate-type (box-type a want) cx (empty-strs a))
            (Err [d] (Err [EvalPair Diag] d))
            (Ok [_] (Ok (mk-evalpair (load (field cp value)) want)))))
        (None [] (Err [EvalPair Diag] (derr (sconcat3 a "declare '" (.name cp) "': a declaration needs a type")))))
    (is-literal-value (field cp value))
      (const-entry a cp)
    :else
      ; non-literal const value = a compile-time computation:
      ; synth the value (fname "const <name>"), then—if the const declares a
      ; type—coerce to it; report (value, declared|synth type). A const reference
      ; later elaborates to `(comptime value)` for the fold pass (see synth EVar).
      (let [nm (.name cp)
            env (env-new a)
            tps (empty-strs a)
            ; Runtime definitions initialize storage with a value. Synthesize
            ; independently first, then coerce below: aggregate constructors may
            ; initially produce a mutable place, which must be loaded into the
            ; global rather than required to already have the declared value type.
            expected
              (if (.runtime cp)
                  (null-type)
                  (if (opt-type-some? (field cp ty))
                      (box-type a (opt-type-val (field cp ty)))
                      (null-type)))]
        (match (let [prior (with-caller-module cx (module-prefix nm))
                     r (do-synth a
                                 (field cp value)
                                 expected
                                 env
                                 cx
                                 tps
                                 (sconcat a "const " nm))]
                 (set! (.caller_module cx) prior)
                 r)
          (Err [d] (Err [EvalPair Diag] d))
          (Ok [sp0]
              (let [sp (primitive/alloc-stack SynPair)
                    value (place-as-value a sp0)]
                ; A constructor synthesizes to the place it builds; the
                ; constant is that place's value.
                (set! (.e sp) (box-expr a (.e value)))
                (set! (.t sp) (box-type a (.t value)))
                (match (.ty cp)
                  (Some [want]
                        (let [wt (box-type a want)
                              tstr (ty-str a (load (field sp t)))]
                          (try (let [ev
                                       (try-or! (coerce a
                                                        (load (load (field sp e)))
                                                        (load (field sp
                                                                     t))
                                                        wt
                                                        false
                                                        nm
                                                        "const value")
                                                (Err [EvalPair Diag]
                                                     (derr (sconcat a
                                                                    (sconcat5 a
                                                                              "const '"
                                                                              nm
                                                                              "': value has type "
                                                                              tstr
                                                                              " but declared ")
                                                                    (ty-str a
                                                                            wt)))))]
                                 (Ok (mk-evalpair ev want))))))
                  (None []
                        (Ok (mk-evalpair (load (load (field sp e)))
                                         (load (load (field sp
                                                            t)))))))))))))

;;; Record `entry` as the checked form of the constant it names.
(defn const-entry-add! [(cx (ptr Cx)) (entry (ptr ConstEntry))] (-> i64)
  (when (.runtime entry) (push! (mut (.static_consts cx)) (.name entry)) 0)
  (push! (mut (.consts cx)) (load entry))
  (set! (mut (.constidx cx)) (.name entry) (primitive/isub (len (.consts cx)) 1))
  0)

;;; The parameter names a `def`'s `:params` annotation declares, after checking
;;; all of the def's annotations against their schemas. Like `:inline`, the
;;; compiler reads the value from its literal form: a vector of keywords.
(defn const-param-names [(a (dyn Allocator)) (cx (ptr Cx)) (cp (ptr Const))]
  (-> (Result (Option (ptr (ArrayList (slice u8)))) Diag))
  (try (let [anns (.annotations cp)
             no-tps (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
             _checked (try! (check-annotations a cx anns (.name cp) no-tps (OnDef)))
             (mut found) (None [(ptr (ArrayList (slice u8)))])]
         (for [i 0 (len (load anns))]
           (let [ap (elem anns i)]
             (when (= (.key ap) "params")
               (let [bad (derr (sconcat3 a
                                         "annotation ':params' on '"
                                         (display-ident (.name cp))
                                         "' must be a literal vector of keywords, e.g. [:x :y]"))
                     (mut names) (ArrayList::new [(slice u8)] a)]
                 (match (.kind (.value ap))
                   (EArrayLit [items]
                     (for [k 0 (len (load items))]
                       (let [item (get (load items) k)
                             name
                               (match (.kind item)
                                 (ECall [func _ args]
                                   (if (and (core-name? func "KeywordValue")
                                            (= (len (load args)) 1))
                                       (match (.kind (elem args 0))
                                         (EStr [text] text)
                                         (_ (break :try (Err bad))))
                                       (break :try (Err bad))))
                                 (_ (break :try (Err bad))))]
                         (when (>= (name-index (box-al [(slice u8)] a (load names)) name) 0)
                           (break :try
                                    (Err (derr (sconcat3 a
                                                         "annotation ':params' on '"
                                                         (display-ident (.name cp))
                                                         (sconcat3 a "' names :" name " twice"))))))
                         (push! (mut names) name)
                         0)))
                   (_ (break :try (Err bad))))
                 (set! found (Some (box-al [(slice u8)] a (load names))))
                 0))
             0))
         (Ok (load found)))))

;;; Is NAME exactly MODULE "." LEAF?
(defn qualified-as? [(name (slice u8)) (module (slice u8)) (leaf (slice u8))] (-> bool)
  (let [m (len module)]
    (and (= (len name) (+ m (+ 1 (len leaf))))
         (and (= (subslice name 0 m) module)
              (and (= (primitive/cast i64 (get name m)) 46)
                   (= (subslice name (+ m 1) (len name)) leaf))))))

;;; Does PROG's submission retire the constant or `def` qualified as NAME?
(defn program-retires-const? [(prog (ptr Program)) (name (slice u8))] (-> bool)
  (let [rs (.retirements prog)]
    (and (!= (primitive/cast i64 rs) 0)
         (block :found
           (for [i 0 (len (load rs))]
             (let [r (elem rs i)]
               (when (and (or (= (.kind r) 7) (= (.kind r) 8))
                          (qualified-as? name (.module r) (.name r)))
                 (break :found true))))
           false))))

;;; The order to check `cs` in: every constant after the constants of `cs` its
;;; initializer names. Source order already is one, but constants a retained
;;; session hands back arrive in whatever order its persistent index iterates, and
;;; checking `K2` before the `K` it reads reports `K` unbound. CYCLE receives the
;;; first cycle found, as the constants along it (empty when there is none).
(defn const-check-order [(a (dyn Allocator)) (cs (ptr (ArrayList Const)))
                         (cycle (mut (ArrayList i64)))] (-> (ArrayList i64))
  (let [n (len (load cs))
        (mut index) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        (mut state) (ArrayList::new [i64] a)
        (mut order) (ArrayList::new [i64] a)
        (mut path) (ArrayList::new [i64] a)]
    (for [i 0 n]
      (set! (mut index) (.name (elem cs i)) i)
      (push! (mut state) 0))
    (for [i 0 n]
      (const-order-visit! a cs (load index) (mut state) (mut order) (mut path) (mut cycle) i))
    order))

;;; Place const `i` after what it reads. STATE: 0 unvisited, 1 on the path, 2
;;; placed; PATH holds the constants on the path, so meeting one again closes a
;;; cycle.
(defn const-order-visit! [(a (dyn Allocator)) (cs (ptr (ArrayList Const)))
                          (index (HashMap (slice u8) i64))
                          (state (mut (ArrayList i64))) (order (mut (ArrayList i64)))
                          (path (mut (ArrayList i64))) (cycle (mut (ArrayList i64)))
                          (i i64)] (-> i64)
  (when (= (get state i) 0)
    (set! (mut state) i 1)
    (push! (mut path) i)
    (let [(mut refs) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
          (mut seen) (HashMap::new [GraphKey i64] a (graph-keyops))]
      (type-refs/const! (mut refs) (mut seen) (elem cs i))
      (for [k 0 (.cap refs)]
        (let [e (primitive/index (.slots refs) k)]
          (when (= (.state e) 1)
            (match (get index (.key e))
              (Some [j]
                (cond (= (get state j) 0)
                        (do (const-order-visit! a cs index (mut state) (mut order) (mut path) (mut cycle) j)
                            0)
                      (and (= (get state j) 1) (= (len cycle) 0))
                        (let [(mut on) false]
                          (for [p 0 (len path)]
                            (when (= (get path p) j) (set! on true))
                            (when (load on) (push! (mut cycle) (get path p))))
                          (push! (mut cycle) j)
                          0)
                      :else 0))
              (None [] 0))
            0))))
    (pop! (mut path))
    (set! (mut state) i 2)
    (push! (mut order) i)
    0)
  0)

;;; The constants of CYCLE depend on their own values.
(defn const-cycle-diag [(a (dyn Allocator)) (cs (ptr (ArrayList Const)))
                        (cycle (ArrayList i64))] (-> Diag)
  (let [first (elem cs (get cycle 0))
        (mut chain) ""]
    (for [k 0 (len cycle)]
      (set! chain (sconcat3 a (load chain) (if (= k 0) "" " -> ")
                            (unqualified-tail (display-ident (.name (elem cs (get cycle k))))))))
    (let [msg (sconcat3 a (sconcat3 a "constant '" (unqualified-tail (display-ident (.name first)))
                                    "' depends on its own value (")
                        (load chain) ")")
          v (field first value)]
      (if (< (.lo v) 0) (derr msg) (derr-at-src (.source v) (.lo v) (.hi v) msg)))))

;;; A diagnostic about a constant as a whole points at its initializer.
(defn const-located [(cp (ptr Const)) (d Diag)] (-> Diag)
  (let [v (field cp value)]
    (dwspan d (.source v) (.lo v) (.hi v) (.ctxt v))))

(defn setup-consts [(a (dyn Allocator))
                    (cx (ptr Cx))
                    (prog (ptr Program))
                    (parent (ptr LS))] (-> (Result i64 Diag))
  (let [cs (load (field prog consts))
        n (len (load cs))
        (mut cycle) (ArrayList::new [i64] a)
        order (const-check-order a cs (mut cycle))
        (mut i) 0
        (mut accepted) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (when (> (len cycle) 0)
      (set! err (const-cycle-diag a cs (load cycle)))
      (set! failed true)
      (set! i n))
    (loop (if (>= (load i) n)
              (do
                (tr/count "check.constants" n)
                (tr/count "check.constants-accepted" (load accepted))
                (break))
              (do
                (let [cp (elem cs (get order (load i)))
                      nm (.name cp)
                      accepted-entry (const-accepted-entry parent cp)]
                  ; Persistent accepted entries coexist with their exact syntax
                  ; only in the compiler-phase facade, which must be able to
                  ; re-elaborate that syntax. It is not a redeclaration.
                  (if (and (= (primitive/cast i64 accepted-entry) 0)
                           (or (!= (primitive/cast i64 (sig-find cx nm))
                                   0)
                               (match (get (.constidx cx) nm)
                                 (Some [_] true)
                                 ; A constant this submission retired may be
                                 ; declared again.
                                 (None []
                                   (and (not (.replaces_meta_consts cx))
                                        (!= (primitive/cast i64
                                                (const-base-get (.const_base cx) nm)) 0)
                                        (not (const-same-accepted-origin? parent cp))
                                        (not (program-retires-const? prog nm)))))))
                      (do
                        (set! err
                              (const-located cp (derr (sconcat3 a
                                              "'"
                                              nm
                                              "' is declared more than once"))))
                        (set! failed true)
                        (break))
                    ; A constant an earlier compilation already checked, handed back
                    ; as it left it, keeps that result. Checking it again would type
                    ; its whole initializer on every edit of anything, and would put a
                    ; newly built tree in place of the accepted one each time, so that
                    ; no two states ever shared a constant.
                    (if (!= (primitive/cast i64 accepted-entry) 0)
                      (do (set! accepted (primitive/iadd (load accepted) 1))
                          (const-entry-add! cx accepted-entry))
                      (match (const-param-names a cx cp)
                        (Err [d] (do (set! err (const-located cp d)) (set! failed true) (break)))
                        (Ok [declared]
                      (match (compute-const-entry a cx cp)
                        (Err [d] (do (set! err (const-located cp d)) (set! failed true) (break)))
                        (Ok [epv]
                            (let [ep (primitive/alloc-stack EvalPair)
                                  ; the authored initializer's identity, which a
                                  ; later compilation handed this record back
                                  ; recognizes it by
                                  authored-id (.node-id (field cp value))]
                              (set! ep epv)
                              (do
                                (when (.runtime cp)
                                  ; A checked node inherits its input's id, as
                                  ; every other checked expression does.
                                  (let [checked (primitive/alloc-stack Expr)]
                                    (set! checked (.e ep))
                                    (set! (.node-id checked) authored-id)
                                    (set! (.value cp) (load checked)))
                                  (set! (.ty cp) (Some (.t ep)))
                                  0)
                                ; An aggregate-typed const used to be classified as a
                                ; STATIC, and a reference to one elaborated to
                                ; `EStaticRef` — which NO backend can lower, because not
                                ; one of the four ever pushes to `cg.statics`. Statics
                                ; were a half-built representation with no consumer.
                                ;
                                ; Drop the classification entirely and let an aggregate
                                ; const take the path a non-literal const already takes:
                                ; `EComptime` of its value, materialized by the comptime
                                ; engine at each use. That machinery already handles
                                ; structs, sums and arrays, so the feature falls out of a
                                ; DELETION rather than four backends learning to emit
                                ; constant-initialized globals with each aggregate's
                                ; exact layout.
                                ;
                                ; The trade is that the value is materialized per use
                                ; rather than referenced once. That is what every other
                                ; non-literal const already does, and correctness before
                                ; a shared global for a `const`.
                                (let [ce (primitive/alloc-stack ConstEntry)]
                                  (set! (.name ce) nm)
                                  (set! (.value ce) (.e ep))
                                  (set! (.ty ce) (.t ep))
                                  (set! (.runtime ce) (.runtime cp))
                                  (set! (.source_node_id ce) authored-id)
                                  (set! (.param_names ce) declared)
                                  (const-entry-add! cx ce)))))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn setup-validate-const-types [(a (dyn Allocator))
                                  (cx (ptr Cx))
                                  (prog (ptr Program))] (-> (Result i64 Diag))
  (let [cs (load (field prog consts))
        n (len (load cs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [cp (elem cs (load i))
                      nm (.name cp)]
                  (when (opt-type-some? (field cp ty))
                    (match (validate-type (box-type a
                                                    (opt-type-val (field cp ty)))
                                          cx
                                          (empty-strs a))
                      (Err [d]
                           (do
                             (store! err
                                     (const-located cp
                                                    (prefix-diag a
                                                                 d
                                                                 (sconcat3 a
                                                                           "const '"
                                                                           nm
                                                                           "': "))))
                             (store! failed true)
                             (break)))
                      (Ok [_] 0))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

; A field holding a reference has no representation: codegen reaches it as a value
; and cannot take its address. Store a `(ptr T)` instead, whose validity rules are
; explicit.
(defn field-reference-error [(a (dyn Allocator)) (t (ptr Type))] (-> (Option Diag))
  (match (load t)
    (TRef [_ _]
      (Some (derr (sconcat3 a
                            "a field cannot hold a reference type "
                            (ty-str a t)
                            "; store a pointer instead"))))
    (TExternRef [] (Some (derr (externref-storage-message "a field"))))
    (_ (None [Diag]))))

(defn validate-one-struct-fields [(a (dyn Allocator))
                                  (cx (ptr Cx))
                                  (sp (ptr StructDef))] (-> (Result i64 Diag))
  (let [nm (.name sp)
        tps (load (field sp type_params))
        fs (load (field sp fields))
        n (len (load fs))
        (mut i) 0
        (mut seen) (ArrayList::new [(slice u8)] a)
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (store! (field cx cur_bounds) (bounds-with-supertraits a cx (load (field sp bounds))))
    (match (validate-value-param-decls a (load (field sp bounds)) nm)
      (Err [d] (do (set! err d) (set! failed true) 0))
      (Ok [_] 0))
    (loop (if (or (load failed) (>= (load i) n))
              (break)
              (do
                (let [fp (elem fs (load i))
                      fnm (.name fp)]
                  (if (set-contains (box-al [(slice u8)] a (load seen)) fnm)
                      (do
                        (set! err
                              (derr (sconcat a
                                             (sconcat3 a
                                                       "struct '"
                                                       nm
                                                       "': duplicate field '")
                                             (sconcat a fnm "'"))))
                        (set! failed true)
                        (break))
                      (do
                        (push! (mut seen) fnm)
                        (match (field-reference-error a (field fp ty))
                          (Some [d]
                            (do (set! err
                                      (prefix-diag a d
                                                   (sconcat a
                                                            (sconcat3 a "struct '" nm "' field '")
                                                            (sconcat a fnm "': "))))
                                (set! failed true)
                                (break)))
                          (None [] 0))
                        (match (validate-type (field fp ty) cx tps)
                          (Err [d]
                               (do
                                 (set! err
                                       (prefix-diag a
                                                    d
                                                    (sconcat a
                                                             (sconcat3 a
                                                                       "struct '"
                                                                       nm
                                                                       "' field '")
                                                             (sconcat a
                                                                      fnm
                                                                      "': "))))
                                 (set! failed true)
                                 (break)))
                          (Ok [_] 0)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

;;; A diagnostic about a struct or sum declaration points at the declaration,
;;; when it was written: a field's type carries no span of its own.
(defn declaration-located [(source i64) (lo i64) (hi i64) (d Diag)] (-> Diag)
  (if (< lo hi) (dwspan d source lo hi 0) d))

(defn setup-validate-struct-fields [(a (dyn Allocator))
                                    (cx (ptr Cx))
                                    (prog (ptr Program))] (-> (Result i64 Diag))
  (let [fs (load (field prog structs))
        n (len (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (validate-one-struct-fields a
                                                   cx
                                                   (elem fs
                                                         (load i)))
                  (Err [d]
                       (let [sp (elem fs (load i))]
                         (set! err (declaration-located (.span_source sp) (.span_lo sp) (.span_hi sp) d))
                         (set! failed true)
                         (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn validate-one-variant-fields [(a (dyn Allocator))
                                   (cx (ptr Cx))
                                   (sumnm (slice u8))
                                   (tps (ptr (ArrayList (slice u8))))
                                   (vp (ptr Variant))] (-> (Result i64 Diag))
  (let [vnm (.name vp)
        fs (load (field vp fields))
        n (len (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (elem fs (load i))
                      fnm (.name fp)]
                  (match (field-reference-error a (field fp ty))
                    (Some [d]
                      (do (set! err
                                (prefix-diag a d
                                             (sconcat a
                                                      (sconcat3 a "sum '" sumnm "' variant '")
                                                      (sconcat3 a vnm "' field '" (sconcat a fnm "': ")))))
                          (set! failed true)
                          (break)))
                    (None [] 0))
                  (match (validate-type (field fp ty) cx tps)
                    (Err [d]
                         (do
                           (set! err
                                 (prefix-diag a
                                              d
                                              (sconcat a
                                                       (sconcat a
                                                                (sconcat3 a
                                                                          "sum '"
                                                                          sumnm
                                                                          "' variant '")
                                                                (sconcat3 a
                                                                          vnm
                                                                          "' field '"
                                                                          fnm))
                                                       "': ")))
                           (set! failed true)
                           (break)))
                    (Ok [_] 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn validate-one-sum-fields [(a (dyn Allocator))
                               (cx (ptr Cx))
                               (sp (ptr SumDef))] (-> (Result i64 Diag))
  (let [sumnm (.name sp)
        tps (load (field sp type_params))
        vs (load (field sp variants))
        n (len (load vs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (store! (field cx cur_bounds) (bounds-with-supertraits a cx (load (field sp bounds))))
    (match (validate-value-param-decls a (load (field sp bounds)) sumnm)
      (Err [d] (do (set! err d) (set! failed true) 0))
      (Ok [_] 0))
    (loop (if (or (load failed) (>= (load i) n))
              (break)
              (do
                (match (validate-one-variant-fields a
                                                    cx
                                                    sumnm
                                                    tps
                                                    (elem vs
                                                          (load i)))
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn setup-validate-sum-fields [(a (dyn Allocator))
                                 (cx (ptr Cx))
                                 (prog (ptr Program))] (-> (Result i64 Diag))
  (let [fs (load (field prog sums))
        n (len (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (validate-one-sum-fields a
                                                cx
                                                (elem fs (load i)))
                  (Err [d]
                       (let [sp (elem fs (load i))]
                         (set! err (declaration-located (.span_source sp) (.span_lo sp) (.span_hi sp) d))
                         (set! failed true)
                         (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

;;; A struct or sum that contains itself by value -- as a field, an array
;;; element, a variant payload, or through other structs, sums and generic
;;; instances -- would need infinite size. A pointer, reference, slice or
;;; function breaks the chain. The walk follows type instances (`(G H)` is G's
;;; fields with H substituted), so a cycle through a generic is found here
;;; rather than when its instance is laid out.
(defstruct Containment
  [(a (dyn Allocator))
   (cx (ptr Cx))
   (structs (HashMap (slice u8) i64))
   (sums (HashMap (slice u8) i64))
   (done (HashMap (slice u8) i64))
   (keys (ArrayList (slice u8)))
   (names (ArrayList (slice u8)))
   ; the declaration whose instance repeats: where a cycle is reported
   (culprit (slice u8))])

;;; A generic instance can grow on every step (`(L (array T 1))` in L);
;;; past this depth the walk stops and specialization's runaway limit decides.
(defn containment-depth-limit [] (-> i64) 64)

;;; The cycle through `t`, as "A -> B -> A", or None.
(defn containment-visit [(c (ptr Containment)) (t (ptr Type))] (-> (Option (slice u8)))
  (match (load t)
    (TArray [e _] (containment-visit c e))
    (TStruct [n] (containment-nominal c t n (primitive/cast (ptr (ArrayList Type)) 0)))
    (TApp [n args] (containment-nominal c t n args))
    (_ (None))))

(defn containment-fields [(c (ptr Containment))
                          (fs (ptr (ArrayList Field)))] (-> (Option (slice u8)))
  (let [(mut found) (None [(slice u8)])]
    (for [i 0 (len (load fs))]
      (when (none? found)
        (set! found (containment-visit c (field (elem fs i) ty)))
        0))
    (load found)))

(defn containment-nominal [(c (ptr Containment))
                           (t (ptr Type))
                           (name (slice u8))
                           (args (ptr (ArrayList Type)))] (-> (Option (slice u8)))
  (let [a (.a c)
        si (match (get (.structs c) name) (Some [i] i) (None [] -1))
        ui (match (get (.sums c) name) (Some [i] i) (None [] -1))
        generic (!= (primitive/cast i64 args) 0)]
    (if (or (and (< si 0) (< ui 0))
            (>= (len (.keys c)) (containment-depth-limit)))
        (None)
        (let [key (if generic (ty-str a t) name)]
          (if (contains? (.done c) key)
              (None)
              (let [(mut at) -1]
                (for [i 0 (len (.keys c))]
                  (when (and (< (load at) 0) (= (get (.keys c) i) key)) (set! at i) 0))
                (if (>= (load at) 0)
                    (let [(mut msg) (get (.names c) (load at))]
                      (set! (.culprit c) name)
                      (for [i (primitive/iadd (load at) 1) (len (.names c))]
                        (set! msg (sconcat3 a (load msg) " -> " (get (.names c) i))))
                      (Some (sconcat3 a (load msg) " -> " (get (.names c) (load at)))))
                    (do
                      (push! (mut (.keys c)) key)
                      (push! (mut (.names c)) (if generic (ty-str a t) name))
                      (let [found
                              (if (>= si 0)
                                  (let [info (elem (field (.cx c) structs) si)]
                                    (containment-fields c
                                                        (if generic
                                                            (fields-subst a info args)
                                                            (load (field info fields)))))
                                  (let [info (elem (field (.cx c) sums) ui)
                                        vs (if generic
                                               (variants-subst a info args)
                                               (load (field info variants)))
                                        (mut r) (None [(slice u8)])]
                                    (for [v 0 (len (load vs))]
                                      (when (none? r)
                                        (set! r (containment-fields c (load (field (elem vs v) fields))))
                                        0))
                                    (load r)))]
                        (when (none? found)
                          (pop! (mut (.keys c)))
                          (pop! (mut (.names c)))
                          (set! (mut (.done c)) key 0)
                          0)
                        found)))))))))

(defn containment-diag [(a (dyn Allocator)) (what (slice u8)) (name (slice u8)) (cycle (slice u8))] (-> Diag)
  (derr (sconcat4 a
                  what
                  (sconcat3 a " '" name "' contains itself by value (")
                  cycle
                  "), so it would have no finite size; hold the inner one through a pointer, e.g. (ptr ...)")))

(defn containment-start [(a (dyn Allocator)) (name (slice u8)) (tps (ptr (ArrayList (slice u8))))] (-> (ptr Type))
  (if (= (len (load tps)) 0)
      (box-type a (TStruct name))
      (let [(mut targs) (ArrayList::new [Type] a)]
        (for [j 0 (len (load tps))] (push! (mut targs) (TStruct (get (load tps) j))))
        (box-type a (TApp name (box-al [Type] a (load targs)))))))

;;; The cycle reported at the declaration of the nominal whose instance repeats.
(defn containment-located [(a (dyn Allocator)) (prog (ptr Program)) (name (slice u8)) (cycle (slice u8))] (-> Diag)
  (let [(mut d) (containment-diag a "sum" name cycle)
        ss (load (field prog structs))
        us (load (field prog sums))]
    (for [i 0 (len (load ss))]
      (let [sd (elem ss i)]
        (when (= (.name sd) name)
          (set! d (declaration-located (.span_source sd) (.span_lo sd) (.span_hi sd)
                                       (containment-diag a "struct" name cycle)))
          0)))
    (for [i 0 (len (load us))]
      (let [sd (elem us i)]
        (when (= (.name sd) name)
          (set! d (declaration-located (.span_source sd) (.span_lo sd) (.span_hi sd) (load d)))
          0)))
    (load d)))

(defn setup-validate-containment [(a (dyn Allocator))
                                  (cx (ptr Cx))
                                  (prog (ptr Program))] (-> (Result i64 Diag))
  (try (let [c (primitive/alloc-stack Containment)]
         (set! (.a c) a)
         (set! (.cx c) cx)
         (set! (.structs c) (HashMap::new [(slice u8) i64] a (keyops)))
         (set! (.sums c) (HashMap::new [(slice u8) i64] a (keyops)))
         (set! (.done c) (HashMap::new [(slice u8) i64] a (keyops)))
         (set! (.keys c) (ArrayList::new [(slice u8)] a))
         (set! (.names c) (ArrayList::new [(slice u8)] a))
         (set! (.culprit c) "")
         (for [i 0 (len (.structs cx))]
           (set! (mut (.structs c)) (.name (elem (field cx structs) i)) i))
         (for [i 0 (len (.sums cx))]
           (set! (mut (.sums c)) (.name (elem (field cx sums) i)) i))
         ; A generic declaration is walked at its own parameters, which are
         ; leaves: `(defstruct L [T] [(next (L T))])` is a cycle for every T.
         (let [ss (load (field prog structs))]
           (for [i 0 (len (load ss))]
             (let [sd (elem ss i)]
               (match (containment-visit c (containment-start a (.name sd) (load (field sd type_params))))
                 (Some [cycle] (break :try (Err [i64 Diag] (containment-located a prog (.culprit c) cycle))))
                 (None [] 0)))))
         (let [ss (load (field prog sums))]
           (for [i 0 (len (load ss))]
             (let [sd (elem ss i)]
               (match (containment-visit c (containment-start a (.name sd) (load (field sd type_params))))
                 (Some [cycle] (break :try (Err [i64 Diag] (containment-located a prog (.culprit c) cycle))))
                 (None [] 0)))))
         (Ok [i64 Diag] 0))))

;;; The annotation schemas the checker installs itself. Core's own source cannot
;;; declare them: `:inline` must exist before stage-0 understands `defannotation`
;;; in core, and the compiler reads both by key.
;;;   :inline  InlinePolicy     — functions; mapped to LLVM inlining attributes
;;;   :params  (slice Keyword)  — defs; parameter names of the callable a def
;;;                               holds, so named calls can be ordered
(defn compiler-annotation-defs [(a (dyn Allocator))] (-> (ptr (ArrayList AnnotationDef)))
  (let [(mut out) (ArrayList::new [AnnotationDef] a)
        inline (primitive/alloc-stack AnnotationDef)
        params (primitive/alloc-stack AnnotationDef)]
    (set! (.key inline) "inline")
    (set! (.value_type inline) (TStruct (core-name "InlinePolicy")))
    (set! (.compiler_owned inline) true)
    (push! (mut out) (load inline))
    (set! (.key params) "params")
    (set! (.value_type params) (TSlice (box-type a (TStruct (core-name "Keyword")))))
    (set! (.compiler_owned params) true)
    (push! (mut out) (load params))
    (box-al [AnnotationDef] a (load out))))

(defn compiler-annotation-key? [(key (slice u8))] (-> bool)
  (or (= key "inline") (= key "params")))

(defn setup-retained [(a (dyn Allocator))
             (cx (ptr Cx))
             (prog (ptr Program))
             (impb (ptr (ArrayList ImpEntry)))
             (expb (ptr (ArrayList ExpEntry)))
             (parent (ptr LS))] (-> (Result (ptr (ArrayList Func))
                                                            Diag))
  (try (do
         (cx-init-tables cx a)
         (unless (= (primitive/cast i64 parent) 0)
           (set! (.sig_base cx)
             (primitive/cast (ptr sigbase/SigBase) (.persistent_sigs parent)))
           (set! (.retired_sigs cx) (.retired_functions prog))
           (let [prior (primitive/cast (ptr Cx) (.checker_context parent))]
             (unless (= (primitive/cast i64 prior) 0)
               (set! (.const_base cx) (.const_base prior)) 0)) 0)
         ; Install the compiler-owned annotation schemas without requiring the
         ; stage-0 compiler to understand `defannotation` in core's own source.
         ;
         ; ⚠ This APPENDS to the caller's `prog`, so `setup` must be idempotent: a
         ; program that already carries the compiler's own entries is being
         ; checked for the SECOND time, not redefining anything. Metaprogram
         ; staging is exactly that case — it copies `annotation_defs` from an
         ; already-checked program into the sub-program it builds
         ; (comptime.coil:3768, metalower.coil:894) and checks that — and without
         ; this the second pass tripped the redefinition guard below, reported as
         ; "macro 'coil.control.when' could not be compiled into the metaprogram
         ; engine: annotation ':inline' is compiler-defined and cannot be
         ; redefined". Which points at the metaprogram engine, where the bug is not.
         (let [defs (load (field prog annotation_defs))
               dn (len (load defs))]
           (for [di 0 dn]
             (let [ent (elem defs di)
                   key (.key ent)]
               (when (and (compiler-annotation-key? key) (not (.compiler_owned ent)))
                 (break :try
                          (Err [(ptr (ArrayList Func)) Diag]
                               (derr (sconcat3 a
                                               "annotation ':"
                                               key
                                               "' is compiler-defined and cannot be redefined")))))
               (when (contains? (.annotation_idx cx) key)
                 ; A compiler schema seen twice is ours from a previous `setup`
                 ; of this very program (see above); anything else is a
                 ; user declaring one key twice.
                 (unless (.compiler_owned ent)
                   (break :try
                            (Err [(ptr (ArrayList Func)) Diag]
                                 (derr (sconcat3 a
                                                 "duplicate annotation definition ':"
                                                 key
                                                 "'")))))
                 0)
               (set! (mut (.annotation_idx cx)) key di)
               0))
           (let [builtin (compiler-annotation-defs a)]
             (for [bi 0 (len (load builtin))]
               (let [ad (elem builtin bi)]
                 (unless (contains? (.annotation_idx cx) (.key ad))
                   (set! (mut (.annotation_idx cx)) (.key ad) (len (load defs)))
                   (push! [AnnotationDef] defs (load ad))
                   0)
                 0))))
         (store! (field cx annotation_defs) (load (field prog annotation_defs)))
         (store! (field cx imports) impb)
         (store! (field cx exports) expb)
         (store! (field cx conventions) (load (field prog conventions)))
         (try! (setup-structs a cx prog))
         (try! (setup-sums a cx prog))
         (try! (setup-conventions a cx prog))
         (try! (setup-layouts a cx prog))
         (try! (setup-type-annotations a cx prog))
         (try! (setup-traits a cx prog))
         (let [fb (box! a FBox (primitive/zeroed FBox))]
           (store! (field fb items) (ArrayList::new [Func] a))
           (copy-funcs a fb prog)
           (try! (setup-impls a cx prog fb parent))
           (try! (check-supertraits a cx))
           (try! (check-copy-impls a cx))
           (setup-retained-sigs a cx (field fb items) parent)
           (setup-checked-fnptr-sigs a cx prog)
           (setup-export-fnptr-sigs a cx prog)
           (try! (setup-externs a cx prog))
           (try! (setup-consts a cx prog parent))
           (try! (setup-validate-const-types a cx prog))
           (try! (setup-validate-struct-fields a cx prog))
           (try! (setup-validate-sum-fields a cx prog))
           (try! (setup-validate-containment a cx prog))
           (Ok (field fb items))))))

(defn setup [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))
             (impb (ptr (ArrayList ImpEntry))) (expb (ptr (ArrayList ExpEntry)))]
             (-> (Result (ptr (ArrayList Func)) Diag))
  (setup-retained a cx prog impb expb (primitive/cast (ptr LS) 0)))

; ============================ check_func (Phase 2) =================
(defn validate-params [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (ps (ptr (ArrayList Param)))
                       (tps (ptr (ArrayList (slice u8))))
                       (fnm (slice u8))] (-> (Result i64 Diag))
  (let [n (len (load ps))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pp (elem ps (load i))
                      pnm (.name pp)]
                  (match (validate-type (field pp ty) cx tps)
                    (Err [d]
                         (do
                           (set! err
                                 (prefix-diag a
                                              d
                                              (sconcat a
                                                       (sconcat3 a
                                                                 "function '"
                                                                 fnm
                                                                 "' param '")
                                                       (sconcat a pnm "': "))))
                           (set! failed true)
                           (break)))
                    (Ok [_] 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn build-param-env [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (ps (ptr (ArrayList Param)))
                       (tps (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList EnvEntry)))
  (let [(mut out) (ArrayList::new [EnvEntry] a)
        n (len (load ps))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pp (elem ps (load i))
                      ee (primitive/alloc-stack EnvEntry)
                      bid (next-bid)]
                  (set! (.name ee) (.name pp))
                  (set! (.ty ee) (param-body-ref-type cx (field pp ty) tps))
                  (set! (.bid ee) bid)
                  (push! (mut out) (load ee)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [EnvEntry] a (load out))))

;;; The checked function's parameters: erased types, plus the binding identity and
;;; owner type the checker assigns. Those are written here, into the copy. The
;;; checker used to store them into the input Param records, so a program it had
;;; checked once was no longer what resolution produced, and a cached revision
;;; reused in a later check carried the earlier check's answers.
(defn erase-param-types [(a (dyn Allocator))
                         (cx (ptr Cx))
                         (ps (ptr (ArrayList Param)))
                         (env (ptr (ArrayList EnvEntry)))
                         (tps (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList Param)))
  (let [(mut out) (ArrayList::new [Param] a)
        n (len (load ps))
        (mut i) 0]
    (reserve! (mut out) n)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pp (elem ps (load i))
                      np (primitive/alloc-stack Param)]
                  (set! (.name np) (.name pp))
                  (set! (.positional_only np) (.positional_only pp))
                  (set! (.ty np)
                        (erase-refs a
                                    (box-type a
                                              (param-body-ref-type cx
                                                                   (field pp ty)
                                                                   tps))))
                  (set! (.bid np) (.bid (elem env (load i))))
                  ; A by-value parameter owns what it is passed exactly as a `let`
                  ; binding owns its value: now, or once substitution decides.
                  ; `(Option T)` instantiated at an owner is an owner, just as a
                  ; bare `T` is; mono drops the mark for an instance that is Copy.
                  (set! (.owned_type np)
                        (if (param-may-own? a cx (field pp ty) tps)
                            (box-type a (.ty pp))
                            (primitive/cast (ptr Type) 0)))
                  (push! (mut out) (load np)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Param] a (load out))))

; check one body, accumulator-style (NO return-from inside the loop — gotcha #1).
(defn check-body [(a (dyn Allocator))
                  (cx (ptr Cx))
                  (fp (ptr Func))
                  (env (ptr (ArrayList EnvEntry)))
                  (tps (ptr (ArrayList (slice u8))))
                  (fnm (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [body (load (field fp body))
        bn (len (load body))
        (mut out) (ArrayList::new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (reserve! (mut out) bn)
    (loop (if (>= (load i) bn)
              (break)
              (do
                (let [ep (elem body (load i))
                      istail (= (primitive/iadd (load i) 1) bn)]
                  ; Body statements are recorded like every nested expression, so
                  ; `type-of`/`code-decl` answer for a function's own statements too.
                  (if istail
                      (match (do-synth-recorded a ep (field fp ret) env cx tps fnm)
                        (Err [d]
                             (do
                               (if (load failed)
                                   (do (push! (mut (.recovered_diags cx)) d) 0)
                                   (do (set! err d) 0))
                               (set! failed true)
                               ; A provisional model keeps checking later statements,
                               ; so their types and resolutions are still recorded.
                               (unless (.recover_statements cx) (break))
                               0))
                        (Ok [sp]
                            (let [pair (primitive/alloc-stack SynPair)
                                  _pair (store! pair sp)
                                  r (primitive/alloc-stack EvalPair)]
                              (set! r (mk-evalpair (load (.e pair)) (load (.t pair))))
                              (try (let [; point at the TAIL expression: `ep` is it, and its span was right
                                         ; here unused. Without it the message names a type mismatch but not
                                         ; which of a 60-line body's expressions is the offending tail —
                                         ; exactly the question the reader is asking.
                                         ee
                                           (try-or! (coerce a
                                                            (load (field r e))
                                                            (box-type a
                                                                      (load (field r
                                                                                   t)))
                                                            (field fp ret)
                                                            false
                                                            fnm
                                                            "body")
                                                    (do
                                                      (store! err
                                                              (dwspan (derr (if (type-is-never (field fp ret))
                                                                                (sconcat a
                                                                                         (sconcat3 a
                                                                                                   "function '"
                                                                                                   fnm
                                                                                                   "' is declared (-> never) but can return: its body ends in a value of type ")
                                                                                         (sconcat a
                                                                                                  (ty-str a (box-type a (load (field r t))))
                                                                                                  "; end it with a call that does not return, such as (panic …)"))
                                                                                (sconcat a
                                                                                     (sconcat a
                                                                                              (sconcat a
                                                                                                       (sconcat3 a
                                                                                                                 "function '"
                                                                                                                 fnm
                                                                                                                 "': body has type ")
                                                                                                       (ty-str a
                                                                                                               (box-type a
                                                                                                                         (load (field r
                                                                                                                                      t)))))
                                                                                              " but the declared return type is ")
                                                                                     (ty-str a
                                                                                             (field fp
                                                                                                    ret)))))
                                                                      (load (field ep
                                                                                   source))
                                                                      (load (field ep
                                                                                   lo))
                                                                      (load (field ep
                                                                                   hi))
                                                                      (load (field ep
                                                                                   ctxt))))
                                                      (store! failed true)
                                                      (break)))]
                                     (push! (mut out) ee))))))
                      (match (do-synth-recorded a
                                    ep
                                    (discard-expected a)
                                    env
                                    cx
                                    tps
                                    fnm)
                        (Err [d]
                             (do
                               (if (load failed)
                                   (do (push! (mut (.recovered_diags cx)) d) 0)
                                   (do (set! err d) 0))
                               (set! failed true)
                               ; A provisional model keeps checking later statements,
                               ; so their types and resolutions are still recorded.
                               (unless (.recover_statements cx) (break))
                               0))
                        (Ok [sp]
                            (let [pair (primitive/alloc-stack SynPair)]
                              (store! pair sp)
                              (push! (mut out) (load (.e pair))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok (box-al [Expr] a (load out))))))

;;; A diagnostic about an annotation points at it: at its value, which the reader
;;; records where its key was written.
(defn annotation-located [(ap (ptr Annotation)) (d Diag)] (-> Diag)
  (let [v (field ap value)]
    (dwspan d (.source v) (.lo v) (.hi v) (.ctxt v))))

;;; Check a declaration's annotations against their schemas. `on-def` says the
;;; owner is a `def` rather than a function; the compiler's own keys apply to
;;; exactly one of the two, and saying so beats silently ignoring the key.
;;; What a declaration annotation is written on. The compiler's own keys apply
;;; to one kind each: `:inline` to functions, `:params` to defs.
(defsum AnnotationOwner (OnFunction) (OnDef) (OnType))

(defn annotation-owner-noun [(o AnnotationOwner)] (-> (slice u8))
  (match o (OnFunction [] "functions") (OnDef [] "def") (OnType [] "types")))

(defn annotation-owner= [(x AnnotationOwner) (y AnnotationOwner)] (-> bool)
  (match x
    (OnFunction [] (match y (OnFunction [] true) (_ false)))
    (OnDef [] (match y (OnDef [] true) (_ false)))
    (OnType [] (match y (OnType [] true) (_ false)))))

(defn check-annotations [(a (dyn Allocator))
                         (cx (ptr Cx))
                         (src (ptr (ArrayList Annotation)))
                         (owner (slice u8))
                         (tps (ptr (ArrayList (slice u8))))
                         (on AnnotationOwner)] (-> (Result (ptr (ArrayList Annotation))
                                                    Diag))
  (try (let [n (len (load src))
             (mut out) (ArrayList::new [Annotation] a)
             env (env-new a)
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (let [ap (elem src (load i))
                         key (load (field ap key))
                         def (annotation-def-find cx key)]
                     (when (= (primitive/cast i64 def) 0)
                       (break :try
                                (Err [(ptr (ArrayList Annotation)) Diag]
                                     (annotation-located
                                       ap
                                       (derr (sconcat3 a
                                                       "unknown annotation ':"
                                                       key
                                                       "'"))))))
                     (when (.compiler_owned def)
                       (let [applies (if (= key "params") (OnDef) (OnFunction))]
                         (unless (annotation-owner= applies on)
                           (break :try
                                    (Err [(ptr (ArrayList Annotation)) Diag]
                                         (annotation-located
                                           ap
                                           (derr (sconcat3 a
                                                           "annotation ':"
                                                           key
                                                           (sconcat a
                                                                    (sconcat3 a "' applies to " (annotation-owner-noun applies) ", not ")
                                                                    (annotation-owner-noun on))))))))))
                     (let [(mut j) 0]
                       (loop (if (>= (load j) (load i))
                                 (break)
                                 (do
                                   (when (= (load (field (elem src
                                                               (load j))
                                                         key))
                                            key)
                                     (break :try
                                              (Err [(ptr (ArrayList Annotation))
                                                    Diag]
                                                   (annotation-located
                                                     ap
                                                     (derr (sconcat3 a
                                                                     "duplicate annotation ':"
                                                                     key
                                                                     "'"))))))
                                   (store! j (primitive/iadd (load j) 1))))))
                     (let [checked
                             (match (check-to a
                                              (field ap value)
                                              (field def value_type)
                                              env
                                              cx
                                              tps
                                              owner
                                              (sconcat3 a
                                                        "annotation ':"
                                                        key
                                                        "' value"))
                               (Err [d] (break :try (Err [(ptr (ArrayList Annotation)) Diag]
                                                         (annotation-located ap d))))
                               (Ok [e] e))
                           np (primitive/alloc-stack Annotation)]
                       (store! (field np key) key)
                       ; Annotation values use the full expression language but
                       ; are declaration-time data, never runtime work. Mark the
                       ; checked expression for the ordinary comptime fold.
                       (store! (field np value)
                               (mk-expr (EComptime (box-expr a checked))
                                        (load (field (field ap value) lo))
                                        (load (field (field ap value) hi))
                                        (load (field (field ap value) source))
                                        (load (field (field ap value) ctxt))))
                       (push! (mut out) (load np)))
                     (store! i (primitive/iadd (load i) 1)))))
         (Ok (box-al [Annotation] a (load out))))))

;;; Check one function. A diagnostic about the function as a whole -- a parameter's
;;; type, its convention, an annotation -- has no expression to point at; it points
;;; at the function.
;;; Make CALLER the module whose imports govern the code checked next
;;; (`caller_module`); the previous one is returned for the caller to restore.
(defn with-caller-module [(cx (ptr Cx)) (caller (slice u8))] (-> (slice u8))
  (let [prior (.caller_module cx)]
    (set! (.caller_module cx) caller)
    prior))

;;; The module F's source belongs to, or "" when it has no source position: the
;;; module whose imports its body was written under.
(defn func-caller-module [(fp (ptr Func))] (-> (slice u8))
  (if (< (.source fp) 0) "" (src-mod-lookup (.source fp))))

(defn check-func [(a (dyn Allocator)) (cx (ptr Cx)) (fp (ptr Func))] (-> (Result Func
                                                                                 Diag))
  (match (let [prior (with-caller-module cx (func-caller-module fp))
               r (check-func-unlocated a cx fp)]
           (set! (.caller_module cx) prior)
           r)
    ; the declaration as written: not the `defn` macro's expansion it came out of
    (Err [d] (Err (dwspan d (.source fp) (.lo fp) (.hi fp) 0)))
    (Ok [f] (Ok f))))

(defn machine-code-diag [(operand (ptr Expr)) (message (slice u8))] (-> Diag)
  (derr-at-src (.source operand) (.lo operand) (.hi operand) message))

; A machine-code body, checked. Its operand is the `coil.core.Arch` value naming
; the machine the bytes are for: a variant of it, one with machine code, whose
; instructions the bytes are a whole number of, and the machine this code is
; built for. The checked body spells that architecture into its tag and has the
; declared return type, which is how a backend knows whether the bytes return at
; all once `never` has become `void` in the function's own signature.
(defn machine-code-checked-body [(a (dyn Allocator))
                                 (cx (ptr Cx))
                                 (fp (ptr Func))
                                 (env (ptr (ArrayList EnvEntry)))
                                 (tps (ptr (ArrayList (slice u8))))
                                 (fnm (slice u8))] (-> (Result (ptr (ArrayList Expr))
                                                               Diag))
  (try (let [(mut e) (load (elem (load (field fp body)) 0))
             (mut out) (ArrayList::new [Expr] a)]
         (match (.kind e)
           (EIntrinsic [(IMachineCodeSource [source]) _ args]
                    (let [operand (elem args 0)
                          checked
                            (try! (do-synth a
                                            operand
                                            (box-type a (TStruct (core-name "Arch")))
                                            env
                                            cx
                                            tps
                                            fnm))
                          arch (machine-code-variant-arch (field checked e))
                          bytes source]
                      (when (= (len arch) 0)
                        (break :try
                                 (Err [(ptr (ArrayList Expr)) Diag]
                                      (machine-code-diag operand
                                                         "machine-code: the architecture is a coil.core.Arch variant, written as one, such as (Riscv32)"))))
                      (unless (machine-code-arch-has-code? arch)
                        (break :try
                                 (Err [(ptr (ArrayList Expr)) Diag]
                                      (machine-code-diag operand
                                                         (sconcat3 a "machine-code: " arch " has no machine code")))))
                      (unless (machine-code-whole-instructions? arch bytes)
                        (break :try
                                 (Err [(ptr (ArrayList Expr)) Diag]
                                      (machine-code-diag operand
                                                         (sconcat3 a
                                                                   (sconcat3 a "machine-code: " (i64->str a (len (load bytes))) " bytes are not a whole number of ")
                                                                   arch
                                                                   " instructions")))))
                      (match (machine-code-target-error a (display-ident fnm) arch (target-arch-str))
                        (Some [message]
                              (break :try
                                       (Err [(ptr (ArrayList Expr)) Diag]
                                            (machine-code-diag operand message))))
                        (None [] 0))
                      (set! (.kind e)
                            (EIntrinsic
                              :op (IMachineCode arch bytes)
                              :result (erase-refs a (field fp ret))
                              :args (box-al [Expr] a (ArrayList::new [Expr] a))))
                      0))
           (_ 0))
         (push! (mut out) (load e))
         (Ok (box-al [Expr] a (load out))))))

(defn check-func-unlocated [(a (dyn Allocator)) (cx (ptr Cx)) (fp (ptr Func))] (-> (Result Func
                                                                                           Diag))
  (compiler-work! "check" (.name fp))
  (try (do
         (let [tps (load (field fp type_params))
               fnm (load (field fp name))]
           (store! (field cx cur_bounds) (bounds-with-supertraits a cx (load (field fp bounds))))
           (try! (validate-value-param-decls a (load (field fp bounds)) fnm))
           (let [conv (conv-find cx (cc-identity (load (field fp cc))))]
             (if (= (primitive/cast i64 conv) 0)
                 (return-from :try
                                (Err [Func Diag]
                                     (derr (sconcat3 a
                                                     (sconcat3 a
                                                               "function '"
                                                               fnm
                                                               "': unknown convention '")
                                                     (cc-text a (load (field fp cc)))
                                                     (unknown-convention-hint (load (field fp cc)))))))
                 (do
                   (when (conv-is-shim conv)
                     ; with no :ret register a function has nowhere to leave
                     ; a result, and none to change for one it does not have
                     (when (and (conv-ret-none conv)
                                (not (type-is-return-only (field fp ret))))
                       (break :try
                                (Err [Func Diag]
                                     (derr (sconcat3 a
                                                     (sconcat3 a
                                                               "function '"
                                                               fnm
                                                               "' returns a value, but its shim convention '")
                                                     (cc-identity (load (field fp cc)))
                                                     "' names no :ret register to return it in")))))
                     (when (< (conv-params-len conv)
                              (len (load (load (field fp
                                                      params)))))
                       (break :try
                                (Err [Func Diag]
                                     (derr (sconcat a
                                                    (sconcat a
                                                             (sconcat a
                                                                      (sconcat a
                                                                               (sconcat3 a
                                                                                         "function '"
                                                                                         fnm
                                                                                         "': convention '")
                                                                               (sconcat a
                                                                                        (cc-identity (load (field fp
                                                                                                                  cc)))
                                                                                        "' provides "))
                                                                      (i64->str a
                                                                                (conv-params-len conv)))
                                                             (sconcat a
                                                                      " param registers but the function has "
                                                                      (i64->str a
                                                                                (len (load (load (field fp
                                                                                                        params)))))))
                                                    " parameters"))))))
                   (when (conv-is-reset conv)
                     (when (match (load (field conv ret))
                             (Some [_] true)
                             (None [] false))
                       (break :try
                                (Err [Func Diag]
                                     (derr (sconcat3 a
                                                     "function '"
                                                     fnm
                                                     "': reset convention cannot name a return register")))))
                     (when (> (conv-params-len conv)
                              (len (load (load (field fp params)))))
                       (break :try
                                (Err [Func Diag]
                                     (derr (sconcat3 a
                                                     "function '"
                                                     fnm
                                                     "': reset convention has more register parameters than the function"))))))
                   0)))
           (try! (validate-params a cx (load (field fp params)) tps fnm))
           (unless (type-is-return-only (field fp ret))
             (match (validate-type (field fp ret) cx tps)
               (Err [d]
                    (return-from :try
                                   (Err [Func Diag]
                                        (prefix-diag a
                                                     d
                                                     (sconcat3 a
                                                               "function '"
                                                               fnm
                                                               "' return type: ")))))
               (Ok [_] 0)))
           (let [env (build-param-env a cx (load (field fp params)) tps)
                 body (load (field fp body))
                 bn (len (load body))]
             ; An empty body has type VOID. `check-body`'s loop never runs when bn = 0,
             ; so this is the ONLY place an empty body is type-checked. It used to
             ; whitelist an i64 return type here (and report "body has type i64"),
             ; which let `(defn f [] (-> i64))` compile and return an undefined value.
             ; Worded as the ORDINARY return-type mismatch, and located like one. A body
             ; with no forms has type void; that it happens to be empty is not a special
             ; kind of error and saying so sent readers down the wrong repair. The shape
             ; that lands here is nearly always a C-style forward declaration, and
             ; "your body is empty" invites changing the RETURN TYPE to void — which
             ; compiles and leaves a useless function — when the fix is to delete the
             ; line, because Coil resolves references within a file in any order,
             ; mutual recursion included. It also had no span at all, alone among the
             ; type errors, so it could not be jumped to.
             ; A `declare`d function has no body ON PURPOSE: its definition is in
             ; another unit's object. Its signature was set up like any other, so
             ; callers get the ordinary errors; only the body is absent.
             (when (and (= bn 0)
                        (and (not (load (field fp declared)))
                             (not (type-is-void (field fp ret)))))
               (break :try
                        (Err [Func Diag]
                             (derr-at-src (load (field fp source))
                                          (load (field fp lo))
                                          (load (field fp hi))
                                          (sconcat a
                                                   (sconcat3 a
                                                             "function '"
                                                             fnm
                                                             "': body has type void but the declared return type is ")
                                                   (ty-str a (field fp ret)))))))
             (let [checked-annotations (try! (check-annotations a cx (load (field fp annotations)) fnm tps (OnFunction)))
                   machine-code (func-machine-code-body? fp)
                   ; Inlined bytes keep their call's contract, so the contract
                   ; must say which registers they read, write and change: a
                   ; :shim convention's :params, :ret and :clobber.
                   ; A shim pins the values to the registers it names, so each must
                   ; be one of the architecture this is built for.
                   _registers
                     (let [conv (conv-find cx (cc-identity (.cc fp)))]
                       (when (and (!= (primitive/cast i64 conv) 0) (conv-is-shim conv))
                         (match (conv-non-register a conv (target-arch-str))
                           (Some [message]
                                 (break :try
                                          (Err [Func Diag]
                                               (derr (sconcat3 a
                                                               (sconcat3 a "function '" fnm "' uses convention '")
                                                               (display-ident (cc-identity (.cc fp)))
                                                               message)))))
                           (None [] 0))))
                   _inline
                     (when (func-machine-code-inlined? fp)
                       (let [conv (conv-find cx (cc-identity (.cc fp)))]
                         (unless (and (!= (primitive/cast i64 conv) 0)
                                      (conv-is-shim conv))
                           (break :try
                                    (Err [Func Diag]
                                         (derr (sconcat3 a
                                                         "function '"
                                                         fnm
                                                         "' is machine code under a convention that does not name its registers, so it cannot be inlined; give it a (coil.cc.Shim) convention, whose :params, :ret and :clobber its bytes keep, or remove its :inline annotation")))))))
                   ; A Coil body behind a :shim convention is compiled for the C
                   ; convention and reached through a trampoline, so the registers
                   ; C lets it change are ones the convention must say it changes.
                   _clobbers
                     (if machine-code
                       0
                       (do
                             (let [conv (conv-find cx (cc-identity (.cc fp)))]
                               (when (and (!= (primitive/cast i64 conv) 0)
                                          (conv-is-shim conv))
                                 (let [arch (target-arch-str)
                                       missing
                                         (shim-unlisted-clobbers a
                                                                 arch
                                                                 (c-caller-saved-gprs a arch (target-os-str))
                                                                 (match (.ret conv) (Some [r] r) (None [] ""))
                                                                 (load (field conv clobber)))]
                                   (when (> (len missing) 0)
                                     (break :try
                                              (Err [Func Diag]
                                                   (derr (sconcat3 a
                                                                   (sconcat3 a
                                                                             "function '"
                                                                             fnm
                                                                             "' has a Coil body under the (coil.cc.Shim) convention '")
                                                                   (cc-identity (.cc fp))
                                                                   (sconcat a
                                                                            "', which compiles it for the C convention: its :clobber must name every register a C function may change, and leaves out "
                                                                            missing)))))))))))
                   out-body
                     (cond (load (field fp declared))
                             (box-al [Expr] a (ArrayList::new [Expr] a))
                           ; machine code has nothing to check: its bytes are
                           ; its convention's contract, and parsing validated them
                           machine-code
                             (try! (machine-code-checked-body a cx fp env tps fnm))
                           :else
                             (try! (check-body a
                                               cx
                                               fp
                                               env
                                               (assoc-body-tps a
                                                               cx
                                                               (load (field fp
                                                                            bounds))
                                                               tps)
                                               fnm)))
                   outf (primitive/alloc-stack Func)]
               (store! (field outf name) fnm)
               (store! (field outf type_params) tps)
               (store! (field outf bounds) (load (field fp bounds)))
               (store! (field outf cc) (load (field fp cc)))
               (store! (field outf annotations) checked-annotations)
               (store! (field outf params)
                       (erase-param-types a cx (load (field fp params)) env tps))
               (store! (field outf ret) (erase-refs a (field fp ret)))
               (store! (field outf body) out-body)
               (store! (field outf macro_variadic)
                       (load (field fp macro_variadic)))
               (store! (field outf lo) (load (field fp lo)))
               (store! (field outf hi) (load (field fp hi)))
               (store! (field outf source) (load (field fp source)))
               (store! (field outf ctxt) (load (field fp ctxt)))
               (store! (field outf declared) (load (field fp declared)))
               (store! (field outf lazy) (load (field fp lazy)))
               (Ok (load outf))))))))

; ============================ synth helpers =======================
(defstruct SubstEntry [(name (slice u8)) (ty Type)])

(defstruct ArgSlot [(present bool) (e (ptr Expr)) (t (ptr Type))])

(defstruct Deferred [(idx i64) (err Diag)])

(defstruct SumVars
  [(found bool) (name (slice u8)) (variants (ptr (ArrayList Variant)))])

(defstruct TargsOpt [(found bool) (targs (ptr (ArrayList Type)))])

(defstruct Branch [(e (ptr Expr)) (t (ptr Type))])

(defn sconcat1 [(a (dyn Allocator)) (x (slice u8))] (-> (slice u8))
  x)

(defn sconcat4 [(a (dyn Allocator))
                (w (slice u8))
                (x (slice u8))
                (y (slice u8))
                (z (slice u8))] (-> (slice u8))
  (sconcat a (sconcat3 a w x y) z))

(defn sconcat5 [(a (dyn Allocator))
                (v (slice u8))
                (w (slice u8))
                (x (slice u8))
                (y (slice u8))
                (z (slice u8))] (-> (slice u8))
  (sconcat a (sconcat4 a v w x y) z))

; Scoped resolver keys are internal. User diagnostics retain the identifier's
; source spelling and never expose deterministic-but-unstable scope numbers.
(defn display-ident [(name (slice u8))] (-> (slice u8))
  (scoped-ident-raw name))

(defn unscoped-datum-ident? [(name (slice u8))] (-> bool)
  (and (>= (len name) 6)
       (= (subslice name 0 6) "$datum")))

(defn mk-synpair [(a (dyn Allocator)) (e (ptr Expr)) (t (ptr Type))] (-> SynPair)
  (let [p (primitive/alloc-stack SynPair)]
    (set! (.e p) e)
    (set! (.t p) t)
    (load p)))

(defn ok-ep [(e Expr) (t Type)] (-> (Result EvalPair Diag))
  (Ok [EvalPair Diag] (mk-evalpair e t)))

(defn err-ep [(d Diag)] (-> (Result EvalPair Diag))
  (Err [EvalPair Diag] d))

;;; Record a recovered diagnostic once, however often recovery revisits it.
(defn recover-diag! [(cx (ptr Cx)) (d Diag)] (-> i64)
  (let [dp (primitive/alloc-stack Diag) (mut seen) false]
    (store! dp d)
    (for [i 0 (len (.recovered_diags cx))]
      (let [other (elem (field cx recovered_diags) i)]
        (when (and (= (.source other) (.source dp))
                   (and (= (.lo other) (.lo dp))
                        (and (= (.hi other) (.hi dp)) (= (.msg other) (.msg dp)))))
          (set! seen true) 0)))
    (unless (load seen) (push! (mut (.recovered_diags cx)) (load dp)) 0))
  0)

(defn recover-child! [(a (dyn Allocator)) (child (ptr Expr)) (env (ptr (ArrayList EnvEntry)))
                      (cx (ptr Cx)) (tps (ptr (ArrayList (slice u8)))) (fname (slice u8))] (-> i64)
  ; A child already typed in its real context keeps that type.
  (when (and (!= (primitive/cast i64 child) 0)
             (match (type-map-lookup (.node-id child)) (Some [_] false) (None [] true)))
    (do-synth a child (primitive/cast (ptr Type) 0) env cx tps fname)
    0)
  0)

(defn recover-list! [(a (dyn Allocator)) (items (ptr (ArrayList Expr))) (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx)) (tps (ptr (ArrayList (slice u8)))) (fname (slice u8))] (-> i64)
  (unless (= (primitive/cast i64 items) 0)
    (for [i 0 (len (load items))]
      (recover-child! a (elem items i) env cx tps fname)) 0)
  0)

;;; Check the subexpressions of a failed expression that do not introduce
;;; bindings, so a provisional model types every part of an expression that
;;; does not depend on the failure. Binding forms carry TError bindings forward
;;; through their own checking instead.
(defn recover-children! [(a (dyn Allocator)) (e (ptr Expr)) (env (ptr (ArrayList EnvEntry)))
                         (cx (ptr Cx)) (tps (ptr (ArrayList (slice u8)))) (fname (slice u8))] (-> i64)
  (match (.kind e)
    (ECall [_ _ args] (recover-list! a args env cx tps fname))
    (ENamedCall [_ _ _ args] (recover-list! a args env cx tps fname))
    (EBin [_ l r] (do (recover-child! a l env cx tps fname) (recover-child! a r env cx tps fname)))
    (ECmp [_ l r] (do (recover-child! a l env cx tps fname) (recover-child! a r env cx tps fname)))
    (EIf [c th el] (do (recover-child! a c env cx tps fname) (recover-child! a th env cx tps fname)
                       (recover-child! a el env cx tps fname)))
    (EDo [body] (recover-list! a body env cx tps fname))
    (EDefer [cleanup body]
            (do (recover-child! a cleanup env cx tps fname) (recover-list! a body env cx tps fname)))
    (EField [p _] (recover-child! a p env cx tps fname))
    (EAccessorField [p _] (recover-child! a p env cx tps fname))
    (ELoad [x] (recover-child! a x env cx tps fname))
    (EStore [p v] (do (recover-child! a p env cx tps fname) (recover-child! a v env cx tps fname)))
    (EIndex [p i] (do (recover-child! a p env cx tps fname) (recover-child! a i env cx tps fname)))
    (ECast [_ x] (recover-child! a x env cx tps fname))
    (EAscribe [_ x] (recover-child! a x env cx tps fname))
    (EBorrow [_ place] (recover-child! a place env cx tps fname))
    (EIntUnary [_ x] (recover-child! a x env cx tps fname))
    (ESpillRef [x] (recover-child! a x env cx tps fname))
    (_ 0))
  0)

(defn do-synth-recorded [(a (dyn Allocator))
                         (e (ptr Expr))
                         (expected (ptr Type))
                         (env (ptr (ArrayList EnvEntry)))
                         (cx (ptr Cx))
                         (tps (ptr (ArrayList (slice u8))))
                         (fname (slice u8))] (-> (Result SynPair Diag))
  (let [errors-before (.error_count cx)]
  (match (synth a e expected env cx tps fname)
    (Err [d]
         (if (not (.recover_statements cx))
             (Err [SynPair Diag] d)
             ; A provisional check types the failing expression as TError and
             ; continues, so every sibling and enclosing expression that does not
             ; depend on it keeps its real type. Only a failure not caused by an
             ; earlier TError is an error of its own.
             (do
               (when (= (.error_count cx) errors-before)
                 (recover-diag! cx d)
                 0)
               (set! (.error_count cx) (+ (.error_count cx) 1))
               ; The failure may have stopped before later subexpressions were
               ; checked; check them now so they still get types.
               (recover-children! a e env cx tps fname)
               (Ok (mk-synpair a e (box-type a (TError)))))))
    (Ok [rv]
        (let [r (primitive/alloc-stack EvalPair)]
          (set! r rv)
          ; S2: record this expression's inferred type, keyed by its NODE ID, so a
          ; metaprogram can ask `(primitive/type-of NODE)` for any expression's exact type.
          (type-map-record (.node-id e) (.t r))
          ; The checked output node inherits the INPUT node's id (never dumped, so
          ; oracles are unaffected): metalower reads the type map through the
          ; checked AST, and without this every rebuilt node would be node-id -1.
          (set! (.node-id (.e r)) (.node-id e))
          ; S1: record a reference's RESOLVED entity (qualified name) by node id, so
          ; `(primitive/code-decl NODE)` answers with the exact function/variant/etc. it picked.
          (match (.kind e)
            (ECall [func targs args] (res-map-record (.node-id e) func))
            (ENamedCall [func targs names args] (res-map-record (.node-id e) func))
            (EFnPtrOf [name] (res-map-record (.node-id e) name))
            (EFnPtrInst [name _] (res-map-record (.node-id e) name))
            ; Dedicated memory nodes still have declarations. Lints use these
            ; authoritative identities so an alias or lookalike user function
            ; cannot be mistaken for a primitive operation.
            (ECast [_ _] (res-map-record (.node-id e) "coil.primitive.cast"))
            (EField [_ _] (res-map-record (.node-id e) "coil.primitive.field"))
            (ELoad [_] (res-map-record (.node-id e) "coil.primitive.load"))
            (EStore [_ _] (res-map-record (.node-id e) "coil.primitive.store!"))
            ; S3: record which LOCAL binding a reference resolves to, so
            ; `(primitive/binding-of NODE)` distinguishes shadowed locals for a borrow checker.
            (EVar [name]
              (let [binding (env-get-bid env name)]
                (bind-map-record (.node-id e) binding)
                (source-local-answer! e binding)))
            (_ 0))
          ; A call that dispatches to an impl method is written with the method's
          ; name and checked into a call of the one function the checker chose for
          ; it. That choice is the declaration the call reaches, so it replaces the
          ; authored name recorded above; otherwise every method call answers
          ; `:unresolved`, the authored name being no function at all. With a
          ; generic receiver no impl is chosen until the function is specialised,
          ; and the call reaches the trait's method: that is recorded under the
          ; name the trait's own declaration is indexed by.
          (let [authored
                  (match (.kind e)
                    (ECall [func _ _] func)
                    (ENamedCall [func _ _ _] func)
                    (_ ""))]
            (when (> (len authored) 0)
              (match (.kind (.e r))
                (ECall [chosen _ _]
                       (when (!= chosen authored)
                         (res-map-record (.node-id e) chosen)
                         (source-dispatch-answer! a cx e authored chosen)
                         0))
                (ETraitCall [trait_name method _ _]
                            (do (res-map-record (.node-id e)
                                                (tmfn a trait_name (trait-self-key) method))
                                (source-expression-answer! e (sconcat3 a (before-last-dot trait_name) "." method) false)))
                (_ 0))
              0))
          ; Qualified primitive calls elaborate into dedicated memory nodes. Record
          ; that checked identity as the final answer for the authored call node.
          (match (.kind (.e r))
            (EField [_ _] (res-map-record (.node-id e) "coil.primitive.field"))
            (ELoad [_] (res-map-record (.node-id e) "coil.primitive.load"))
            (EStore [_ _] (res-map-record (.node-id e) "coil.primitive.store!"))
            (_ 0))
          ; A global value can elaborate into a static load or a literal. Its
          ; authored reference still names the global, not that implementation
          ; operation. Locals explicitly have no declaration, so name fallback
          ; cannot mistake a shadowed local for a same-named global.
          (match (.kind e)
            (EVar [name]
              (res-map-record (.node-id e)
                (if (!= (primitive/cast i64 (env-get env name))
                        0) "$unresolved" name)))
            (_ 0))
          (Ok (mk-synpair a (box-expr a (.e r)) (box-type a (.t r)))))))))

;;; How many break values have waited for their loop's type. A synthesis that
;;; recorded one is not cached: the value is patched when the loop is popped, and
;;; a loop whose check fails never patches it, so reusing that result after the
;;; loop is checked again would reuse an unchecked value.
(defn pending-break-count [] (-> (ptr i64))
  (primitive/alloc-static i64))

;;; A synthesis that failed is discarded with every break value it left waiting:
;;; the loops still open keep only the ones recorded before it began.
(defn drop-pending-breaks-since! [(cx (ptr Cx)) (since i64)] (-> i64)
  (for [i 0 (len (.loops cx))]
    (let [fr (elem (field cx loops) i)
          (mut keep) 0]
      (for [j 0 (len (field fr pending))]
        (when (<= (.seq (elem (field fr pending) j)) since)
          (set! (field fr pending) (load keep) (load (elem (field fr pending) j)))
          (set! keep (+ (load keep) 1))
          0))
      (set! (.len (field fr pending)) (load keep))
      0))
  0)

(defn do-synth [(a (dyn Allocator))
                (e (ptr Expr))
                (expected (ptr Type))
                (env (ptr (ArrayList EnvEntry)))
                (cx (ptr Cx))
                (tps (ptr (ArrayList (slice u8))))
                (fname (slice u8))] (-> (Result SynPair Diag))
  (let [pending (load (pending-break-count))]
    (match (do-synth-cached a e expected env cx tps fname)
      (Ok [sp] (Ok [SynPair Diag] sp))
      (Err [d]
           (do
             (when (!= (load (pending-break-count)) pending)
               (drop-pending-breaks-since! cx pending))
             (Err [SynPair Diag] d))))))

(defn do-synth-cached [(a (dyn Allocator))
                (e (ptr Expr))
                (expected (ptr Type))
                (env (ptr (ArrayList EnvEntry)))
                (cx (ptr Cx))
                (tps (ptr (ArrayList (slice u8))))
                (fname (slice u8))] (-> (Result SynPair Diag))
  (let [expected (effective-expected e expected)
        cacheable
          (match (.kind e)
            (EInt [_] true)
            (EFloat [_] true)
            (EBool [_] true)
            (EVar [_] true)
            (EBin [_ _ _] true)
            (ECmp [_ _ _] true)
            (ECall [_ _ _] true)
            (ECast [_ _] true)
            (EIndex [_ _] true)
            (EField [_ _] true)
            (ELoad [_] true)
            (_ false))]
    (if (or (not (.synth_cache_active cx)) (not cacheable))
        (do-synth-recorded a e expected env cx tps fname)
        (let [key (primitive/alloc-stack SynthKey)]
          (store! (field key expr) (primitive/cast i64 e))
          (store! (field key expected) (primitive/cast i64 expected))
          (store! (field key env_len) (len (load env)))
          (match (get (.synth_cache cx) (load key))
            (Some [sp] (Ok [SynPair Diag] sp))
            (None []
                  (let [pending (load (pending-break-count))]
                    (match (do-synth-recorded a e expected env cx tps fname)
                      (Err [d] (Err [SynPair Diag] d))
                      (Ok [sp]
                          (do
                            (when (= (load (pending-break-count)) pending)
                              (set! (mut (.synth_cache cx)) (load key) sp))
                            (Ok [SynPair Diag] sp)))))))))))

(defn expected-some? [(expected (ptr Type))] (-> bool)
  (!= (primitive/cast i64 expected) 0))

(defn null-type [] (-> (ptr Type))
  (primitive/cast (ptr Type) 0))

; A statement's value is discarded, so a statement is checked against void: the
; "discard" expectation. Only the forms that route a value through branches or a
; body — if, match, loop, do, let — use it, so their branches need not agree and a
; loop may end with a bare (break). Every other expression is synthesized with no
; expectation (void carries nothing to infer from; unifying a generic result with
; it would make void a type argument) and its value is then dropped by `coerce`.
(defn discard-expected [(a (dyn Allocator))] (-> (ptr Type))
  (box-type a (TVoid)))

(defn discard-carrier? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EIf [_ _ _] true)
    (EMatch [_ _] true)
    (ELoop [_ _] true)
    (EDo [_] true)
    (ELet [_ _] true)
    (EDefer [_ _] true)
    (_ false)))

(defn effective-expected [(e (ptr Expr)) (expected (ptr Type))] (-> (ptr Type))
  (if (and (expected-some? expected)
           (and (type-is-void expected) (not (discard-carrier? e))))
      (null-type)
      expected))

; A literal made entirely of constants supported by every static-data backend
; can be materialized from static data. The receiving array is still a fresh
; stack place on every evaluation.
(defn array-static-element? [(item (ptr Expr))] (-> bool)
  (match (.kind item)
    (EInt [_] true)
    (EBool [_] true)
    (EZeroed [_] true)
    (ERecordInit [_] true)
    (_ false)))

;;; `[]`: it has no element to take a type from, so the type comes from where it
;;; stands -- a `(slice T)` or `(array T 0)` an ascription, parameter or return
;;; type asks for. An empty slice points nowhere and has length 0.
(defn synth-empty-array-literal [(a (dyn Allocator))
                                 (expected (ptr Type))
                                 (fname (slice u8))
                                 (lo i64)
                                 (hi i64)
                                 (src i64)
                                 (ctxt i64)] (-> (Result EvalPair Diag))
  (let [missing (derr-at-src src lo hi
                             (sconcat3 a
                                       "in '"
                                       fname
                                       "': an empty array literal needs an element type from where it stands; write (: [] (slice T)) or (: [] (array T 0))"))]
    (if (not (expected-some? expected))
        (err-ep missing)
        (match (load expected)
          (TArray [_ en]
                  (if (extent-eq en (FixedExtent 0))
                      (ok-ep (mk-expr (EZeroed (load expected)) lo hi src ctxt) (load expected))
                      (err-ep (derr-at-src src lo hi
                                           (sconcat a
                                                    (sconcat3 a "in '" fname "': array literal has 0 elements but expected ")
                                                    (extent-str a en))))))
          (TSlice [et]
                  (ok-ep (mk-expr (EMakeSlice
                                    :data (box-expr a (mk-expr (ECast (TPtr et) (box-expr a (mk-expr (EInt 0) lo hi src ctxt)))
                                                               lo hi src ctxt))
                                    :elem (load et)
                                    :len (FixedExtent 0))
                                  lo hi src ctxt)
                         (load expected)))
          (_ (err-ep missing))))))

; Lower `[a b ...]` after element checking. The temporary is a normal mutable
; aggregate let-place, which already has the entry-block allocation and lifetime
; semantics array literals need; no backend-specific literal node is required.
(defn synth-array-literal [(a (dyn Allocator))
                           (items (ptr (ArrayList Expr)))
                           (expected (ptr Type))
                           (env (ptr (ArrayList EnvEntry)))
                           (cx (ptr Cx))
                           (tps (ptr (ArrayList (slice u8))))
                           (fname (slice u8))
                           (lo i64)
                           (hi i64)
                           (src i64)
                           (ctxt i64)] (-> (Result EvalPair Diag))
  (try (let [n (len (load items))]
         (when (= n 0)
           (break :try (synth-empty-array-literal a expected fname lo hi src ctxt)))
         (let [(mut elem-ty) (primitive/zeroed Type)
               (mut inferred_place_element) false
               (mut checked) (ArrayList::new [Expr] a)
               (mut i) 0]
           (match (if (expected-some? expected)
                      (match (load expected)
                        (TArray [et en]
                                (if (extent-eq en (FixedExtent n))
                                    (check-to a
                                              (elem items 0)
                                              et
                                              env
                                              cx
                                              tps
                                              fname
                                              "array element")
                                    (Err [Expr Diag]
                                         (derr (sconcat a
                                                        (sconcat3 a
                                                                  "in '"
                                                                  fname
                                                                  "': array literal has ")
                                                        (sconcat a
                                                                 (i64->str a n)
                                                                 (sconcat a
                                                                          " elements but expected "
                                                                          (extent-str a
                                                                                      en))))))))
                        (TSlice [et]
                                (check-to a
                                          (elem items 0)
                                          et
                                          env
                                          cx
                                          tps
                                          fname
                                          "array element"))
                        (_ (match (do-synth a
                                            (elem items 0)
                                            (null-type)
                                            env
                                            cx
                                            tps
                                            fname)
                             (Err [d] (Err [Expr Diag] d))
                             (Ok [sp]
                                 (let [p (primitive/alloc-stack SynPair)]
                                   (store! p sp)
                                   (Ok [Expr Diag] (load (load (field p e)))))))))
                      (match (do-synth a
                                       (elem items 0)
                                       (null-type)
                                       env
                                       cx
                                       tps
                                       fname)
                        (Err [d] (Err [Expr Diag] d))
                        (Ok [sp]
                            (let [p (primitive/alloc-stack SynPair)]
                              (store! p sp)
                              (Ok [Expr Diag] (load (load (field p e))))))))
             (Err [d] (break :try (err-ep d)))
             (Ok [first]
                 (do
                   (if (and (expected-some? expected)
                            (or (= (type-tag expected) 7)
                                (= (type-tag expected) 8)))
                       (match (load expected)
                         (TArray [et _] (store! elem-ty (load et)))
                         (TSlice [et] (store! elem-ty (load et)))
                         (_ 0))
                       (let [sp
                               (try! (do-synth a
                                               (elem items 0)
                                               (null-type)
                                               env
                                               cx
                                               tps
                                               fname))
                             p (primitive/alloc-stack SynPair)]
                         (store! p sp)
                         (store! elem-ty (load (load (field p t))))
                         ; Aggregate constructors synthesize to places because
                         ; Coil represents them with backing storage. An inferred
                         ; array literal owns the values copied from those places;
                         ; it is not an array of references to constructor
                         ; temporaries. Preserve an explicitly requested `(ref
                         ; T)` element type, but strip this inferred place wrapper.
                         (match (load elem-ty)
                           (TRef [_ pointee]
                                 (do
                                   (store! elem-ty (load pointee))
                                   (store! inferred_place_element true)))
                           (_ 0))))
                   (push! (mut checked)
                          (if (load inferred_place_element)
                              (mk-expr (ELoad (box-expr a first))
                                       lo
                                       hi
                                       src
                                       ctxt)
                              first)))))
           (when (externref? (mut elem-ty))
             (break :try
                      (err-ep (derr (sconcat3 a
                                              "in '"
                                              fname
                                              (sconcat a
                                                       "': "
                                                       (externref-storage-message "an element")))))))
           ; void has no values to store: an element that produces none (a
           ; call returning void) is a mistake, not an array of nothing. An
           ; expected element type says so through `coerce`; an inferred one
           ; says the same here.
           (when (match (load elem-ty) (TVoid [] true) (_ false))
             (break :try
                    (err-ep (dwspan (derr (sconcat3 a
                                                    "in '"
                                                    fname
                                                    "': array element uses a void value (a (-> void) call yields nothing)"))
                                    (.source (elem items 0))
                                    (.lo (elem items 0))
                                    (.hi (elem items 0))
                                    (.ctxt (elem items 0))))))
           (store! i 1)
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (push! (mut checked)
                              (match (check-to a
                                               (elem items (load i))
                                               (mut elem-ty)
                                               env
                                               cx
                                               tps
                                               fname
                                               "array element")
                                (Ok [temporary] temporary)
                                (Err [temporary] (break :try (Err temporary)))))
                       (store! i (+ (load i) 1)))))
           (let [aty (fixed-array (box-type a (load elem-ty)) n)
                 nm (sconcat a "$arraylit" (i64->str a lo))
                 static-nm (sconcat a "$arraylit.const" (i64->str a lo))
                 (mut binds) (ArrayList::new [Bind] a)
                 (mut body) (ArrayList::new [Expr] a)
                 (mut all-static) true]
             (for [j 0 n]
               (unless (array-static-element? (elem (mut checked) j))
                 (set! all-static false)
                 0)
               0)
             (when (load all-static)
               (let [(mut indices) (ArrayList::new [i64] a)]
                 (for [j 0 n] (push! (mut indices) j) 0)
                 (push! (mut binds)
                        (mk-bind static-nm
                                 false
                                 (mk-expr (EAlloc
                                            :symbol (None)
                                            :storage 1
                                            :ty aty
                                            :init (box-expr a
                                                            (mk-expr (EStaticArray
                                                                       (box-al [i64]
                                                                               a
                                                                               (load indices))
                                                                       (box-al [Expr]
                                                                               a
                                                                               (load checked)))
                                                                     lo hi src ctxt)))
                                          lo hi src ctxt)))
                 0))
             (push! (mut binds)
                    (mk-bind nm
                             false
                             (mk-expr (EAlloc
                                        :symbol (None)
                                        ; a constant's array may be borrowed as a
                                        ; slice the fold reads back after this
                                        ; frame is gone: give it static storage
                                        :storage (if (> (.const_value_depth (ast-unit-state)) 0) 1 3)
                                        :ty aty
                                        :init (primitive/cast (ptr Expr) 0))
                                      lo
                                      hi
                                      src
                                      ctxt)))
             (if (load all-static)
                 (push! (mut body)
                        (mk-expr (EStore
                                   (box-expr a (mk-expr (EVar nm) lo hi src ctxt))
                                   (box-expr a
                                             (mk-expr (ELoad
                                                        (box-expr a
                                                                  (mk-expr (EVar static-nm)
                                                                           lo hi src ctxt)))
                                                      lo hi src ctxt)))
                                 lo hi src ctxt))
                 (do
                   (store! i 0)
                   (loop (if (>= (load i) n)
                       (break)
                       (do
                         (push! (mut body)
                                (mk-expr (EStore (box-expr a
                                                           (mk-expr (EIndex (box-expr a
                                                                                      (mk-expr (EVar nm)
                                                                                               lo
                                                                                               hi
                                                                                               src
                                                                                               ctxt))
                                                                            (box-expr a
                                                                                      (mk-expr (EInt (load i))
                                                                                               lo
                                                                                               hi
                                                                                               src
                                                                                               ctxt)))
                                                                    lo
                                                                    hi
                                                                    src
                                                                    ctxt))
                                                 (box-expr a
                                                           (get (load checked)
                                                                (load i))))
                                         lo
                                         hi
                                         src
                                         ctxt))
                         (store! i (+ (load i) 1)))))
                   0))
             (push! (mut body)
                    (if (and (expected-some? expected)
                             (= (type-tag expected) 8))
                        (mk-expr (EMakeSlice
                                   :data
                                     (box-expr a
                                               (mk-expr (EIndex (box-expr a
                                                                          (mk-expr (EVar nm)
                                                                                   lo
                                                                                   hi
                                                                                   src
                                                                                   ctxt))
                                                                (box-expr a
                                                                          (mk-expr (EInt 0)
                                                                                   lo
                                                                                   hi
                                                                                   src
                                                                                   ctxt)))
                                                        lo
                                                        hi
                                                        src
                                                        ctxt))
                                   :elem (load elem-ty)
                                   :len (FixedExtent n))
                                 lo
                                 hi
                                 src
                                 ctxt)
                        (mk-expr (ELoad (box-expr a
                                                  (mk-expr (EVar nm)
                                                           lo
                                                           hi
                                                           src
                                                           ctxt)))
                                 lo
                                 hi
                                 src
                                 ctxt)))
             (ok-ep (mk-expr (ELet (box-al [Bind] a (load binds))
                                   (box-al [Expr] a (load body)))
                             lo
                             hi
                             src
                             ctxt)
                    (if (and (expected-some? expected)
                             (= (type-tag expected) 8))
                        (TSlice (box-type a (load elem-ty)))
                        aty)))))))

; ---- env --------------------------------------------------------------------
(defn env-get [(env (ptr (ArrayList EnvEntry))) (name (slice u8))] (-> (ptr Type))
  (let [n (len (load env))
        (mut i) (primitive/isub n 1)
        (mut r) (primitive/cast (ptr Type) 0)]
    (loop (if (< (load i) 0)
              (break)
              (do
                (when (= (load (field (elem env (load i)) name))
                         name)
                  (store! r (field (elem env (load i)) ty))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (load r)))

(defn env-insert! [(env (ptr (ArrayList EnvEntry)))
                   (name (slice u8))
                   (ty (ptr Type))] (-> i64)
  (let [ee (primitive/alloc-stack EnvEntry)
        bid (next-bid)]
    (set! (.name ee) name)
    (set! (.ty ee) (load ty))
    (set! (.bid ee) bid)
    (push! [EnvEntry] env (load ee))
    bid))

; the binding id a name resolves to in the current env (0 = not a local)
(defn env-get-bid [(env (ptr (ArrayList EnvEntry))) (name (slice u8))] (-> i64)
  (let [n (len (load env))
        (mut i) (primitive/isub n 1)
        (mut r) 0]
    (loop (if (< (load i) 0)
              (break)
              (do
                (when (= (load (field (elem env (load i)) name))
                         name)
                  (store! r
                          (load (field (elem env (load i)) bid)))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (load r)))

(defn env-truncate! [(env (ptr (ArrayList EnvEntry))) (newlen i64)] (-> i64)
  (set! (.len env) newlen)
  0)

; ---- substitution map -------------------------------------------------------
(defn subst-new [(a (dyn Allocator))] (-> (ptr (ArrayList SubstEntry)))
  (box-al [SubstEntry] a (ArrayList::new [SubstEntry] a)))

(defn subst-get [(s (ptr (ArrayList SubstEntry))) (name (slice u8))] (-> (ptr Type))
  (let [n (len (load s))
        (mut i) 0
        (mut r) (primitive/cast (ptr Type) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem s (load i)) name))
                         name)
                  (store! r (field (elem s (load i)) ty))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

;;; Whether inference bound any of `tparams` to externref, which a generic
;;; aggregate would have to store in linear memory.
(defn externref-inferred? [(s (ptr (ArrayList SubstEntry)))
                           (tparams (ptr (ArrayList (slice u8))))] (-> bool)
  (let [(mut found) false]
    (for name (iter (load tparams))
      (let [t (subst-get s name)]
        (when (and (!= (cast i64 t) 0) (externref? t)) (set! found true))))
    (load found)))

(defn subst-has [(s (ptr (ArrayList SubstEntry))) (name (slice u8))] (-> bool)
  (!= (primitive/cast i64 (subst-get s name)) 0))

(defn subst-insert! [(s (ptr (ArrayList SubstEntry)))
                     (name (slice u8))
                     (ty (ptr Type))] (-> i64)
  (let [se (primitive/alloc-stack SubstEntry)]
    (set! (.name se) name)
    (set! (.ty se) (load ty))
    (push! [SubstEntry] s (load se))))

; ---- pure type helpers ------------------------------------------------------
; The module part of a qualified name: `hyglib5.Mine` -> `hyglib5`. Empty when the
; name carries no dot. Companion to `after-last-dot`, which returns the tail.
(defn before-last-dot [(s (slice u8))] (-> (slice u8))
  (let [n (len s)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) 0)
              (break)
              (do
                (when (= (primitive/cast i64 (get s (load i)))
                         46)
                  (store! at (load i))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (if (< (load at) 0) "" (subslice [u8] s 0 (load at)))))

(defn after-last-dot [(s (slice u8))] (-> (slice u8))
  (let [n (len s)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) 0)
              (break)
              (do
                (when (= (primitive/cast i64 (get s (load i)))
                         46)
                  (store! at (load i))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (if (< (load at) 0)
        s
        (subslice [u8] s (primitive/iadd (load at) 1) n))))

(defn is-struct-or-app [(t (ptr Type))] (-> bool)
  (let [tg (type-tag t)]
    (or (= tg 6) (= tg 11))))

(defn struct-name [(t (ptr Type))] (-> (slice u8))
  (let [tg (type-tag t)]
    (if (= tg 6)
        (type-struct-name t)
        (if (= tg 11) (t-app-name t) ""))))

(defn place-pointee [(t (ptr Type))] (-> (ptr Type))
  (let [tg (type-tag t)]
    (if (or (= tg 4) (= tg 5))
        (t-inner t)
        (primitive/cast (ptr Type) 0))))

(defn is-writable [(t (ptr Type))] (-> bool)
  (let [tg (type-tag t)]
    (or (= tg 4)
        (and (= tg 5) (t-ref-mut t)))))

(defn replace-pointee [(a (dyn Allocator)) (place (ptr Type)) (new (ptr Type))] (-> Type)
  (if (= (type-tag place) 5)
      (TRef (t-ref-mut place) (box-type a (load new)))
      (TPtr (box-type a (load new)))))

(defn is-place-value-type [(t (ptr Type)) (cx (ptr Cx))] (-> bool)
  (let [tg (type-tag t)]
    (cond (= tg 6)
            (!= (primitive/cast i64 (struct-find cx (type-struct-name t)))
                0)
          (= tg 11)
            (!= (primitive/cast i64 (struct-find cx (t-app-name t)))
                0)
          (= tg 7) true
          :else false)))

; The dispatch key. There is exactly ONE definition of it — `parser.coil::impl-base-name`
; — and check/mono both delegate here. This used to be three hand-synced copies (here,
; the parser, and `mono.coil::mono-impl-name`); adding pointers to two of the three
; shipped a compiler that type-checked `(!= p q)` and then died in mono. One key, one
; place. "" = the type can't carry an impl.
(defn type-impl-name [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (impl-base-name a t))

(defn has-impl-name [(a (dyn Allocator)) (t (ptr Type))] (-> bool)
  (!= (len (impl-base-name a t)) 0))

; ---- impl selection ---------------------------------------------------------
; The key (type-impl-name) names only the head constructor, so a key hit alone would
; answer "yes" for EVERY instantiation of it — `impl Len (Pair i64 i64)` would claim
; `(Pair u8 bool)`, and the mismatch would only surface later as a confusing
; argument-type error rather than "does not implement Len". So the key merely narrows
; the candidates; selection then matches the receiver against each candidate's own
; self_type pattern, binding that impl's type params (unify-trait-extras).

; Does pattern `pt` (with variables `pp`) match the type `t`? One-way: only `pp`'s
; names bind. Used both to test a receiver and to compare two impls' generality.
(defn pat-matches? [(a (dyn Allocator))
                    (pt (ptr Type))
                    (pp (ptr (ArrayList (slice u8))))
                    (t (ptr Type))] (-> bool)
  (unify-trait-extras a pt t pp (subst-new a)))

; Is `x` at least as specific as `y`? Exactly: y's pattern matches x's self_type, so
; every type x accepts, y accepts too. `(Pair i64 i64)` <= `(Pair A B)` because
; `(Pair A B)` matches `(Pair i64 i64)` but not conversely. `(Pair A A)` <= `(Pair A B)`
; for the same reason (A binds twice, and the second binding must agree).
(defn impl-le? [(a (dyn Allocator)) (x (ptr ImplDef)) (y (ptr ImplDef))] (-> bool)
  (pat-matches? a
                (field y self_type)
                (load (field y type_params))
                (field x self_type)))

; The impls of `tr` whose pattern accepts `recv`, reduced to the single most specific
; one. `ambiguous` = two candidates matched and neither is more specific than the other
; (e.g. `(Pair i64 B)` and `(Pair A bool)` at `(Pair i64 bool)`), which is reported at
; the use site rather than forbidden at definition — disjoint or ordered impls are fine,
; only an actually-instantiated overlap is an error.
(defstruct ImplSel [(ip (ptr ImplDef)) (ambiguous bool)])

;;; The dispatch key of a blanket impl, `(impl [(T Hash)] Key T)`: one for every
;;; type, which no type's own key can equal.
(const BLANKET-IMPL-KEY "*")

(defn blanket-impl? [(ip (ptr ImplDef))] (-> bool)
  (= (.for_type ip) BLANKET-IMPL-KEY))

; Does candidate `ip` of `tr` accept `recv`? (`key` narrows by head constructor first)
; A blanket impl accepts exactly the types that satisfy its bounds on Self.
(defn impl-cand? [(a (dyn Allocator))
                  (cx (ptr Cx))
                  (tr (slice u8))
                  (key (slice u8))
                  (recv (ptr Type))
                  (ip (ptr ImplDef))] (-> bool)
  (and (and (impl-is-trait ip) (= (impl-trait-name ip) tr))
       (if (blanket-impl? ip)
           (blanket-applies? a cx ip recv)
           (and (= (.for_type ip) key)
                (pat-matches? a (field ip self_type) (load (field ip type_params)) recv)))))

;;; The blanket impls whose bounds are being decided, as `impl-address:type`, so
;;; a cycle of blanket impls bounded by each other's traits ends: a bound that
;;; holds only if it already holds is not established.
(defstruct BlanketProgress [(init bool) (keys (ArrayList (slice u8)))])

(defn blanket-in-progress [] (-> (ptr (ArrayList (slice u8))))
  (let [cell (primitive/alloc-static BlanketProgress)]
    (unless (.init cell)
      (set! (.keys cell) (ArrayList::new [(slice u8)] (unit-allocator)))
      (set! (.init cell) true)
      0)
    (field cell keys)))

;;; Does a blanket impl give type parameter `tp` the trait `tr`, by bounds `tp`
;;; is declared with here -- `(K Hash Eq)` has `Key` through
;;; `(impl [(T Hash Eq)] Key T)`? A trait with associated types is not given
;;; this way: nothing would state them.
(defn blanket-entails? [(a (dyn Allocator)) (cx (ptr Cx)) (tp (slice u8)) (tr (slice u8))] (-> bool)
  (let [td (trait-find cx tr)
        bucket (impl-index-get (field cx trait_impl_idx) (impl-index-key a tr BLANKET-IMPL-KEY))
        key (sconcat3 a tp ":" tr)
        active (blanket-in-progress)]
    (if (or (or (= (primitive/cast i64 bucket) 0) (= (primitive/cast i64 td) 0))
            (or (> (len (load (field td type_params))) 0) (set-contains active key)))
        false
        (do
          (push! active key)
          (let [ok (block :found
                     (for [i 0 (len (.items bucket))]
                       (let [ip (elem (field cx impls) (get (.items bucket) i))
                             self-name (type-struct-name (field ip self_type))
                             bounds (load (field ip bounds))]
                         (when (block :all
                                 (for [j 0 (len (load bounds))]
                                   (let [b (elem bounds j)]
                                     (when (= (.name b) self-name)
                                       (for [k 0 (len (load (field b traits)))]
                                         (let [need (.name (elem (.traits b) k))]
                                           (unless (or (bounds-has (field cx cur_bounds) tp need)
                                                       (blanket-entails? a cx tp need))
                                             (break :all false)))))))
                                 true)
                           (break :found true))))
                     false)]
            (pop! active)
            ok)))))

;;; For a "does not implement" error: which bound of the trait's blanket impl
;;; `recv` lacks, or "" when the trait has none.
(defn blanket-unmet-note [(a (dyn Allocator)) (cx (ptr Cx)) (tr (slice u8)) (recv (ptr Type))] (-> (slice u8))
  (let [bucket (impl-index-get (field cx trait_impl_idx) (impl-index-key a tr BLANKET-IMPL-KEY))]
    (if (= (primitive/cast i64 bucket) 0)
        ""
        (let [ip (elem (field cx impls) (get (.items bucket) 0))
              self-name (type-struct-name (field ip self_type))
              bounds (load (field ip bounds))]
          (block :found
            (for [i 0 (len (load bounds))]
              (let [b (elem bounds i)]
                (when (= (.name b) self-name)
                  (for [k 0 (len (load (field b traits)))]
                    (let [need (.name (elem (.traits b) k))]
                      (unless (impl-match a cx need recv)
                        (break :found (sconcat3 a "; its blanket impl covers only types that implement '"
                                                (display-name need) "'"))))))))
            "")))))

;;; Does `recv` satisfy blanket impl `ip`'s bounds on its Self parameter?
(defn blanket-applies? [(a (dyn Allocator)) (cx (ptr Cx)) (ip (ptr ImplDef)) (recv (ptr Type))] (-> bool)
  (let [self-name (type-struct-name (field ip self_type))
        key (sconcat3 a (i64->str a (primitive/cast i64 ip)) ":" (ty-str a recv))
        active (blanket-in-progress)]
    (if (set-contains active key)
        false
        (do
          (push! active key)
          (let [ok (block :holds
                     (let [bounds (load (field ip bounds))]
                       (for [i 0 (len (load bounds))]
                         (let [b (elem bounds i)]
                           (when (= (.name b) self-name)
                             (for [k 0 (len (load (field b traits)))]
                               (unless (impl-match a cx (.name (elem (.traits b) k)) recv)
                                 (break :holds false)))))))
                     true)]
            (pop! active)
            ok)))))

; Takes an impl list plus its precomputed candidate buckets -- the receiver's head
; constructor's and the trait's blanket impls' -- so check and mono share one
; specificity algorithm without either phase scanning unrelated impls. A blanket
; impl's pattern, a bare type parameter, matches every type, so it is less
; specific than any other impl that accepts the receiver and is chosen only when
; none does.
(defn impl-select-indexed [(a (dyn Allocator))
                           (cx (ptr Cx))
                           (impls (ptr (ArrayList ImplDef)))
                           (bucket (ptr ImplBucket))
                           (blanket (ptr ImplBucket))
                           (tr (slice u8))
                           (recv (ptr Type))] (-> ImplSel)
  (let [r (primitive/alloc-stack ImplSel)]
    (set! (.ip r) (primitive/cast (ptr ImplDef) 0))
    (set! (.ambiguous r) false)
    (if (not (has-impl-name a recv))
        (load r)
        (let [key (type-impl-name a recv)
              nb (if (= (primitive/cast i64 bucket) 0) 0 (len (.items bucket)))
              n (+ nb (if (= (primitive/cast i64 blanket) 0) 0 (len (.items blanket))))]
          ; pass 1 — greedy minimum under the specificity order
          (for [i 0 n]
            (let [ip (elem impls (if (< i nb) (get (.items bucket) i) (get (.items blanket) (- i nb))))]
              (when (impl-cand? a cx tr key recv ip)
                (let [best (load (field r ip))]
                  (when (or (= (primitive/cast i64 best) 0)
                            (impl-le? a ip best))
                    (store! (field r ip) ip)
                    0)))))
          ; pass 2 — the winner must be at least as specific as EVERY candidate, not just
          ; the ones it happened to be compared against. A single greedy scan would let
          ; `(Pair i64 B)` and `(Pair A bool)` at `(Pair i64 bool)` silently pick whichever
          ; came last instead of reporting the overlap.
          (let [best (load (field r ip))]
            (unless (= (primitive/cast i64 best) 0)
              (block :done
                (for [j 0 n]
                  (let [ip (elem impls (if (< j nb) (get (.items bucket) j) (get (.items blanket) (- j nb))))]
                    (when (impl-cand? a cx tr key recv ip)
                      (unless (impl-le? a best ip)
                        (store! (field r ambiguous) true)
                        (break :done))))))
              0))
          (load r)))))

;;; Does an inherent impl for OWNER answer a call qualified `QUAL::m`? Resolution
;;; has already turned the qualifier into the name of the type it denotes in the
;;; caller's scope, so it must be that name exactly; matching its last component
;;; also selected types the caller never imported.
(defn inherent-owner-matches? [(owner (slice u8)) (qual (slice u8))] (-> bool)
  (or (= (len qual) 0) (= owner qual)))

;;; Does QUAL, the resolved qualifier of a `QUAL::m` head, name a type or trait:
;;; a type parameter, a struct, sum or trait, a built-in scalar, or any type an
;;; impl is written for? Resolution leaves a qualifier that names nothing in the
;;; caller's scope as written, and then nothing declares it under that name.
(defn method-qualifier-known? [(cx (ptr Cx))
                               (qual (slice u8))
                               (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (or (set-contains tps qual)
      (or (!= (primitive/cast i64 (struct-find cx qual)) 0)
          (or (!= (primitive/cast i64 (sum-find cx qual)) 0)
              (or (!= (primitive/cast i64 (trait-find cx qual)) 0)
                  (or (is-scalar-typename qual)
                      (block :found
                        (for ip (iter (load (field cx impls)))
                          (when (= (.for_type ip) qual) (break :found true)))
                        false)))))))

(defn inherent-cand? [(a (dyn Allocator))
                      (name (slice u8))
                      (qual (slice u8))
                      (key (slice u8))
                      (recv (ptr Type))
                      (ip (ptr ImplDef))] (-> bool)
  (if (or (impl-is-trait ip)
          (or (not (= (.for_type ip) key))
              (not (inherent-owner-matches? (.for_type ip) qual))))
      false
      (let [m (impl-find-method ip name)]
        (and (!= (primitive/cast i64 m) 0)
             (and (inherent-receiver? a ip m)
                  (pat-matches? a
                                (field ip self_type)
                                (load (field ip type_params))
                                recv))))))

; Receiver-method selection is the trait specialization order restricted to
; inherent impls that actually define `name`. A generic `(impl [T] (Box T) …)`
; and a concrete `(impl (Box i64) …)` may coexist; the concrete method wins for
; Box<i64>, while unordered overlaps are diagnosed at the call site.
(defn inherent-select [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (name (slice u8))
                       (qual (slice u8))
                       (recv (ptr Type))] (-> ImplSel)
  (let [r (primitive/alloc-stack ImplSel)]
    (set! (.ip r) (primitive/cast (ptr ImplDef) 0))
    (set! (.ambiguous r) false)
    (if (not (has-impl-name a recv))
        (load r)
        (let [key (type-impl-name a recv)
              bucket
                (impl-index-get (field cx inherent_impl_idx)
                                (impl-index-key a name key))
              n
                (if (= (primitive/cast i64 bucket) 0)
                    0
                    (len (.items bucket)))
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (let [ip
                              (elem (field cx impls)
                                    (get (.items bucket) (load i)))]
                        (when (inherent-cand? a name qual key recv ip)
                          (let [best (load (field r ip))]
                            (when (or (= (primitive/cast i64 best)
                                         0)
                                      (impl-le? a ip best))
                              (store! (field r ip) ip)
                              0))))
                      (set! i (primitive/iadd (load i) 1)))))
          (let [best (load (field r ip))
                (mut j) 0]
            (unless (= (primitive/cast i64 best) 0)
              (loop (if (>= (load j) n)
                        (break)
                        (do
                          (let [ip
                                  (elem (field cx impls)
                                        (get (load (field bucket items))
                                             (load j)))]
                            (when (inherent-cand? a name qual key recv ip)
                              (unless (impl-le? a best ip)
                                (store! (field r ambiguous) true)
                                (break))))
                          (store! j (primitive/iadd (load j) 1)))))))
          (load r)))))

; Like trait autoderef, try the receiver's own type before peeling. This matters
; now that structural types can carry extension methods: an impl on `(ptr T)` must
; win over a method on T when the argument itself is a pointer.
(defn inherent-select-deref [(a (dyn Allocator))
                             (cx (ptr Cx))
                             (name (slice u8))
                             (qual (slice u8))
                             (recv0 (ptr Type))] (-> ImplSel)
  (let [out (primitive/alloc-stack ImplSel)
        (mut recv) recv0
        (mut done) false]
    (set! (.ip out) (primitive/cast (ptr ImplDef) 0))
    (set! (.ambiguous out) false)
    (loop (if (load done)
              (break)
              (let [one (primitive/alloc-stack ImplSel)]
                (set! one (inherent-select a cx name qual (load recv)))
                (if (or (.ambiguous one)
                        (!= (primitive/cast i64 (load (field one ip)))
                            0))
                    (do (set! out (load one)) (set! done true) 0)
                    (let [tg (type-tag (load recv))]
                      (cond (or (= tg 4) (= tg 5))
                              (set! recv (t-inner (load recv)))
                            ; A fixed array borrows as a slice, as it does for
                            ; trait dispatch (`deref-to-impl`): after the array's
                            ; own impls, the slice's inherent methods apply, and
                            ; the call's coercion inserts that borrow.
                            (= tg 7)
                              (set! recv (box-type a (TSlice (t-inner (load recv)))))
                            :else (set! done true)))))))
    (load out)))

; Associated functions have no receiver from which to choose a specialization.
; Setup rejects duplicate owner/name definitions, so more than one match here can
; only be a short-name ambiguity between modules and is reported as such.
(defn inherent-associated-select [(a (dyn Allocator))
                                  (cx (ptr Cx))
                                  (name (slice u8))
                                  (qual (slice u8))] (-> ImplSel)
  (let [r (primitive/alloc-stack ImplSel)
        bucket (impl-index-get (field cx inherent_name_idx) name)
        n
          (if (= (primitive/cast i64 bucket) 0)
              0
              (len (.items bucket)))
        (mut i) 0]
    (set! (.ip r) (primitive/cast (ptr ImplDef) 0))
    (set! (.ambiguous r) false)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ip
                        (elem (field cx impls)
                              (get (.items bucket) (load i)))]
                  (when (and (impl-is-inherent ip)
                             (inherent-owner-matches? (load (field ip for_type))
                                                      qual))
                    (let [m (impl-find-method ip name)]
                      (when (and (!= (primitive/cast i64 m)
                                     0)
                                 (not (inherent-receiver? a ip m)))
                        (if (= (primitive/cast i64 (load (field r ip)))
                               0)
                            (store! (field r ip) ip)
                            (store! (field r ambiguous) true))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn inherent-has-name [(cx (ptr Cx)) (name (slice u8))] (-> bool)
  (!= (primitive/cast i64 (impl-index-get (field cx inherent_name_idx) name))
      0))

;;; The impl of trait TR for RECV. Selection only reads: its index keys, type
;;; names and candidate substitutions die with the query, and the answer points
;;; into the program's impl list. They used to go to the caller's allocator, the
;;; compilation's arena, where checking src/compiler/main.coil left ~300 MB of
;;; them. A query that recurses (a blanket impl's bounds) opens its own arena.
;;; The arena impl selection builds its keys in. Each selection used to open an
;;; arena of its own, a fresh segment every time: 624,000 of them checking
;;; src/compiler, most from the ownership queries. Its first segment, from the
;;; checker's own allocator, is never released, so a rewind reuses it.
(defn cx-impl-keys [(cx (ptr Cx))] (-> (ptr scratch/ScratchArena))
  (when (= (primitive/cast i64 (.impl_keys cx)) 0)
    (let [arena (box! (.a cx) scratch/ScratchArena (primitive/zeroed scratch/ScratchArena))]
      (scratch/ScratchArena::init-with-capacity arena (.a cx) 4096)
      (alloc-bytes (allocator arena) 1 1)
      (set! (.impl_keys cx) arena))
    0)
  (.impl_keys cx))

(defn cx-impl-select [(a (dyn Allocator))
                      (cx (ptr Cx))
                      (tr (slice u8))
                      (recv (ptr Type))] (-> ImplSel)
  (let [work (cx-impl-keys cx)
        start (scratch/ScratchArena::mark work)
        qa (allocator work)
        key (type-impl-name qa recv)
        selected
          (impl-select-indexed qa
                               cx
                               (field cx impls)
                               (impl-index-get (field cx trait_impl_idx)
                                               (impl-index-key qa tr key))
                               (impl-index-get (field cx trait_impl_idx)
                                               (impl-index-key qa tr BLANKET-IMPL-KEY))
                               tr
                               recv)]
    (scratch/ScratchArena::reset-to! work start)
    selected))

(defn impl-match [(a (dyn Allocator))
                  (cx (ptr Cx))
                  (tr (slice u8))
                  (recv (ptr Type))] (-> bool)
  (let [s (primitive/alloc-stack ImplSel)]
    (set! s (cx-impl-select a cx tr recv))
    (!= (primitive/cast i64 (load (field s ip))) 0)))

;;; Can a use rely on RECV implementing TR? `impl-match` only selects: it picks
;;; `(impl [(T Debug)] Debug (Option T))` for every `(Option S)`, and the bound is
;;; checked where the impl is used. This also holds the selected impl's bounds
;;; against what its pattern binds in RECV, so `(Option S)` has Debug exactly when
;;; S does. Each bound is asked of a part of RECV, so the recursion ends; a blanket
;;; impl's bounds were already held by selecting it (`blanket-applies?`).
(defn impl-holds? [(a (dyn Allocator))
                   (cx (ptr Cx))
                   (tr (slice u8))
                   (recv (ptr Type))] (-> bool)
  (let [s (primitive/alloc-stack ImplSel)]
    (set! s (cx-impl-select a cx tr recv))
    (let [ip (load (field s ip))]
      (cond (= (primitive/cast i64 ip) 0) false
            (load (field s ambiguous)) false
            (blanket-impl? ip) true
            :else
              (let [binds (subst-new a)]
                (and (unify-trait-extras a (field ip self_type) recv (load (field ip type_params)) binds)
                     (block :holds
                       (for b (iter (load (field ip bounds)))
                         (let [bound (subst-get binds (.name b))]
                           (unless (= (primitive/cast i64 bound) 0)
                             (for t (iter (.traits b))
                               (unless (impl-holds? a cx (.name t) bound)
                                 (break :holds false))))))
                       true)))))))

; ---- ownership type properties ---------------------------------------------
; These are deliberately semantic properties rather than representation guesses.
; A raw pointer/reference/view is Copy regardless of its pointee, while an aggregate
; is Copy only when explicitly implemented or every value it contains is Copy. Drop
; propagates through contained values. Recursive values necessarily cross a pointer,
; which stops the structural walk.
(defn ownership-bound-has [(cx (ptr Cx)) (t (ptr Type)) (tr (slice u8))] (-> bool)
  (match (load t)
    (TStruct [name] (bounds-has (field cx cur_bounds) name tr))
    (_ false)))

(defn ownership-field-list-all-copy [(a (dyn Allocator))
                                     (cx (ptr Cx))
                                     (fs (ptr (ArrayList Field)))] (-> bool)
  (let [n (len (load fs))
        (mut i) 0
        (mut yes) true]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (not (type-is-copy a
                                         cx
                                         (field (elem fs (load i))
                                                ty)))
                  (store! yes false)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load yes)))

(defn ownership-field-list-needs-drop [(a (dyn Allocator))
                                       (cx (ptr Cx))
                                       (fs (ptr (ArrayList Field)))] (-> bool)
  (let [n (len (load fs))
        (mut i) 0
        (mut yes) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (type-needs-drop a
                                       cx
                                       (field (elem fs (load i)) ty))
                  (store! yes true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load yes)))

(defn ownership-sum-all-copy [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (let [sv (primitive/alloc-stack SumVars)]
    (set! sv (sum-variants a t cx))
    (if (not (.found sv))
        false
        (let [vs (.variants sv)
              n (len (load vs))
              (mut i) 0
              (mut yes) true]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (when (not (ownership-field-list-all-copy a
                                                                cx
                                                                (.fields (elem vs
                                                                               (load i)))))
                        (store! yes false)
                        (break))
                      (set! i (primitive/iadd (load i) 1)))))
          (load yes)))))

(defn ownership-sum-needs-drop [(a (dyn Allocator))
                                (cx (ptr Cx))
                                (t (ptr Type))] (-> bool)
  (let [sv (primitive/alloc-stack SumVars)]
    (set! sv (sum-variants a t cx))
    (if (not (.found sv))
        false
        (let [vs (.variants sv)
              n (len (load vs))
              (mut i) 0
              (mut yes) false]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (when (ownership-field-list-needs-drop a
                                                             cx
                                                             (.fields (elem vs
                                                                            (load i))))
                        (store! yes true)
                        (break))
                      (set! i (primitive/iadd (load i) 1)))))
          (load yes)))))

(defn ownership-struct-all-copy [(a (dyn Allocator))
                                 (cx (ptr Cx))
                                 (t (ptr Type))] (-> bool)
  (try (let [fs (try-or! (struct-fields a t cx) false)]
         (ownership-field-list-all-copy a cx fs))))

(defn ownership-struct-needs-drop [(a (dyn Allocator))
                                   (cx (ptr Cx))
                                   (t (ptr Type))] (-> bool)
  (try (let [fs (try-or! (struct-fields a t cx) false)]
         (ownership-field-list-needs-drop a cx fs))))

(defn type-is-copy [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (if (or (ownership-bound-has cx t (core-name "Copy"))
          (impl-match a cx (core-name "Copy") t))
      true
      (match (load t)
        (TInt [_ _] true)
        (TFloat [_] true)
        (TBool [] true)
        (TPtr [_] true)
        (TRef [_ _] true)
        (TSlice [_] true)
        (TFn [_ _ _] true)
        (TVec [_ _] true)
        (TExternRef [] true)
        (TArray [elem _] (type-is-copy a cx elem))
        (TStruct [_]
                 (if (ownership-sum-all-copy a cx t)
                     true
                     (ownership-struct-all-copy a cx t)))
        (TApp [_ _]
              (if (ownership-sum-all-copy a cx t)
                  true
                  (ownership-struct-all-copy a cx t)))
        (_ false))))

;;; `type-needs-drop` of the nominal types a checker asks about, for one Cx and
;;; impl table: the answer for a concrete struct or sum depends only on the
;;; program's types and Drop impls, and the walk over every variant and field
;;; was repeated at every ownership question about a value of the type. Only
;;; answers given outside a generic body are kept, where no name is a parameter.
(defstruct DropMemo
  [(ready bool)
   (cx i64)
   (impls i64)
   (known (HashMap (slice u8) bool))
   (key StrBuf)])

(defn drop-memo [] (-> (ptr DropMemo))
  (primitive/alloc-static DropMemo))

;;; A key naming T in KEY, when T is a struct or sum (applied to such types or
;;; scalars) whose answer can be kept; false otherwise.
(defn drop-memo-key! [(key (mut StrBuf)) (t (ptr Type)) (depth i64)] (-> bool)
  (if (> depth 8)
      false
      (match (load t)
        (TStruct [name] (do (push-str! (mut key) name) true))
        (TApp [name args]
          (do (push-str! (mut key) name)
              (push! (mut key) (: 40 u8))
              (let [(mut ok) true]
                (for [i 0 (len (load args))]
                  (when ok
                    (push! (mut key) (: 32 u8))
                    (unless (drop-memo-key! (mut key) (elem args i) (+ depth 1)) (set! ok false))
                    0))
                (push! (mut key) (: 41 u8))
                ok)))
        (TInt [bits signed]
          (do (push! (mut key) (if signed (: 105 u8) (: 117 u8))) (push-i64! (mut key) bits) true))
        (TFloat [bits] (do (push! (mut key) (: 102 u8)) (push-i64! (mut key) bits) true))
        (TBool [] (do (push-str! (mut key) "bool") true))
        (_ false))))

(defn type-needs-drop [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (let [nominal (match (load t) (TStruct [_] true) (TApp [_ _] true) (_ false))]
    (if (or (not nominal)
            (or (> (len (.cur_bounds cx)) 0)
                (!= (primitive/cast i64 (.ownership_subst cx)) 0)))
        (type-needs-drop-walk a cx t)
        (let [m (drop-memo)]
          (unless (.ready m)
            (set! (.known m) (HashMap::new [(slice u8) bool] (malloc-allocator) (keyops)))
            (set! (.key m) (StrBuf::new (malloc-allocator)))
            (set! (.ready m) true)
            0)
          (when (or (!= (.cx m) (primitive/cast i64 cx)) (!= (.impls m) (len (.impls cx))))
            (clear! (mut (.known m)))
            (set! (.cx m) (primitive/cast i64 cx))
            (set! (.impls m) (len (.impls cx)))
            0)
          (set! (.len (field (field m key) bytes)) 0)
          (if (not (drop-memo-key! (mut (.key m)) t 0))
              (type-needs-drop-walk a cx t)
              (match (get (.known m) (str (.key m)))
                (Some [v] v)
                (None []
                  ; the walk asks about field types, which reuse the key buffer
                  (let [key (sconcat a (str (.key m)) "")
                        v (type-needs-drop-walk a cx t)]
                    (set! (mut (.known m)) key v)
                    v))))))))

(defn type-needs-drop-walk [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (if (match (load t)
        (TApp [name _] (core-name? name "ManuallyDrop"))
        (_ false))
      false
      (if (or (ownership-bound-has cx t (core-name "Drop"))
              (impl-match a cx (core-name "Drop") t))
          true
          (match (load t)
            (TArray [elem _] (type-needs-drop a cx elem))
            (TStruct [_]
                     (if (ownership-sum-needs-drop a cx t)
                         true
                         (ownership-struct-needs-drop a cx t)))
            (TApp [_ _]
                  (if (ownership-sum-needs-drop a cx t)
                      true
                      (ownership-struct-needs-drop a cx t)))
            (_ false)))))

(defn type-is-affine [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (or (type-needs-drop a cx t)
      (match (load t)
        ; An unconstrained generic is not implicitly copyable. Bounds can prove
        ; Copy, otherwise ownership is deferred until concrete substitution.
        (TStruct [name]
                 (and (= (primitive/cast i64 (struct-find cx name))
                         0)
                      (= (primitive/cast i64 (sum-find cx name))
                         0)
                      (not (ownership-bound-has cx t (core-name "Copy")))))
        (TApp [name _] (core-name? name "ManuallyDrop"))
        (_ false))))

; Does this value type hold an unconstrained generic parameter by value, so that
; whether it owns anything is only known once the parameter is substituted?
; `type-is-affine` answers that for a bare `T`, but `(Option T)`, `(Box T)` or a
; user sum over `T` contain `T` without being one, and their Drop impl lookup and
; structural walk both see only the abstract field. Pointers, references and
; slices stop the walk: they never own their pointee.
(defn ownership-field-list-defers [(a (dyn Allocator))
                                   (cx (ptr Cx))
                                   (fs (ptr (ArrayList Field)))] (-> bool)
  (let [n (len (load fs))
        (mut i) 0
        (mut yes) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (type-ownership-deferred? a
                                                cx
                                                (field (elem fs (load i))
                                                       ty))
                  (store! yes true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load yes)))

(defn ownership-aggregate-defers [(a (dyn Allocator))
                                  (cx (ptr Cx))
                                  (t (ptr Type))] (-> bool)
  (let [sv (primitive/alloc-stack SumVars)]
    (set! sv (sum-variants a t cx))
    (if (.found sv)
        (let [vs (.variants sv)
              n (len (load vs))
              (mut i) 0
              (mut yes) false]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (when (ownership-field-list-defers a
                                                         cx
                                                         (.fields (elem vs
                                                                        (load i))))
                        (store! yes true)
                        (break))
                      (set! i (primitive/iadd (load i) 1)))))
          (load yes))
        (try (let [fs (try-or! (struct-fields a t cx) false)]
               (ownership-field-list-defers a cx fs))))))

(defn type-ownership-deferred? [(a (dyn Allocator))
                                (cx (ptr Cx))
                                (t (ptr Type))] (-> bool)
  (if (or (ownership-bound-has cx t (core-name "Copy"))
          (impl-match a cx (core-name "Copy") t))
      false
      (match (load t)
        (TStruct [name]
                 (if (and (= (primitive/cast i64 (struct-find cx name))
                             0)
                          (= (primitive/cast i64 (sum-find cx name))
                             0))
                     true
                     (ownership-aggregate-defers a cx t)))
        (TApp [_ _] (ownership-aggregate-defers a cx t))
        (TArray [elem _] (type-ownership-deferred? a cx elem))
        (_ false))))

; A binding of this type must be an owning place: it is affine now, or it may be
; once generic substitution decides. Mono re-asks `type-is-affine` of the concrete
; type and discards the owner when the instance turns out to be Copy.
(defn binding-may-own? [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (or (type-is-affine a cx t) (type-ownership-deferred? a cx t)))

; Is an impl of `tr` with this exact pattern already registered? Two patterns are the
; same iff each matches the other (`(Pair A B)` and `(Pair X Y)` are the same impl
; modulo renaming, and must still collide).
(defn impl-dup? [(a (dyn Allocator))
                 (cx (ptr Cx))
                 (tr (slice u8))
                 (forty (slice u8))
                 (st (ptr Type))
                 (params (ptr (ArrayList (slice u8))))] (-> bool)
  (let [bucket
          (impl-index-get (field cx trait_impl_idx) (impl-index-key a tr forty))
        n
          (if (= (primitive/cast i64 bucket) 0)
              0
              (len (.items bucket)))
        (mut i) 0
        (mut f) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ip
                        (elem (field cx impls)
                              (get (.items bucket) (load i)))]
                  (when (and (pat-matches? a
                                           (field ip self_type)
                                           (load (field ip type_params))
                                           st)
                             (pat-matches? a st params (field ip self_type)))
                    (store! f true)
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load f)))

(defn subst-apply-list [(a (dyn Allocator))
                        (v (ptr (ArrayList Type)))
                        (subst (ptr (ArrayList SubstEntry)))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (ArrayList::new [Type] a)
        n (len (load v))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [rt (subst-apply a (elem v (load i)) subst)
                      rtp (box-type a rt)]
                  (if (pack-value? rtp)
                      (let [items (t-fn-params rtp)
                            nn (len (load items))
                            (mut j) 0]
                        (loop (if (>= (load j) nn)
                                  (break)
                                  (do
                                    (push! (mut out)
                                           (get (load items) (load j)))
                                    (set! j (primitive/iadd (load j) 1))))))
                      (push! (mut out) rt)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn subst-apply [(a (dyn Allocator))
                   (t (ptr Type))
                   (subst (ptr (ArrayList SubstEntry)))] (-> Type)
  (match (load t)
    (TPtr [p] (TPtr (box-type a (subst-apply a p subst))))
    (TRef [m p] (TRef m (box-type a (subst-apply a p subst))))
    (TArray [e k]
      (TArray (box-type a (subst-apply a e subst))
              (generic-extent
                (box-type a (subst-apply a (box-type a (extent-type k)) subst)))))
    (TSlice [e] (TSlice (box-type a (subst-apply a e subst))))
    (TVec [e k]
      (TVec (box-type a (subst-apply a e subst))
            (generic-extent
              (box-type a (subst-apply a (box-type a (extent-type k)) subst)))))
    (TStruct [n]
             (let [r (subst-get subst n)]
               (if (= (primitive/cast i64 r) 0)
                   (TStruct n)
                   (load r))))
    (TApp [n args]
          (if (= n "$pack-var")
              (let [r
                      (subst-get subst
                                 (type-struct-name (elem args 0)))]
                (if (= (primitive/cast i64 r) 0)
                    (TApp n args)
                    (load r)))
              (TApp n (subst-apply-list a args subst))))
    (TFn [cc ps r]
         (TFn
           :cc cc
           :params (subst-apply-list a ps subst)
           :ret (box-type a (subst-apply a r subst))))
    (_ (load t))))

(defn fields-subst [(a (dyn Allocator))
                    (si (ptr StructInfo))
                    (args (ptr (ArrayList Type)))] (-> (ptr (ArrayList Field)))
  (let [subst (subst-new a)
        tparams (load (field si type_params))
        np (len (load tparams))
        (mut i) 0]
    (loop (if (>= (load i) np)
              (break)
              (do
                (subst-insert! subst
                               (get (load tparams) (load i))
                               (elem args (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (let [fs (load (field si fields))
          nf (len (load fs))
          (mut out) (ArrayList::new [Field] a)
          (mut j) 0]
      (loop (if (>= (load j) nf)
                (break)
                (do
                  (let [fp (elem fs (load j))
                        nf2 (primitive/alloc-stack Field)]
                    (set! (.name nf2) (.name fp))
                    (set! (.ty nf2) (subst-apply a (field fp ty) subst))
                    (push! (mut out) (load nf2)))
                  (set! j (primitive/iadd (load j) 1)))))
      (box-al [Field] a (load out)))))

(defn struct-fields [(a (dyn Allocator)) (t (ptr Type)) (cx (ptr Cx))] (-> (Result (ptr (ArrayList Field))
                                                                                   Diag))
  (let [tg (type-tag t)]
    (if (= tg 6)
        (let [si (struct-find cx (type-struct-name t))]
          (if (= (primitive/cast i64 si) 0)
              (Err [(ptr (ArrayList Field)) Diag]
                   (derr (sconcat3 a
                                   "unknown struct '"
                                   (type-struct-name t)
                                   "'")))
              (Ok (load (field si fields)))))
        (if (= tg 11)
            (let [si (struct-find cx (t-app-name t))]
              (if (= (primitive/cast i64 si) 0)
                  (Err [(ptr (ArrayList Field)) Diag]
                       (derr (sconcat3 a
                                       "unknown generic struct '"
                                       (t-app-name t)
                                       "'")))
                  (Ok (fields-subst a si (t-fn-params t)))))
            (Err [(ptr (ArrayList Field)) Diag]
                 (derr (sconcat a "not a struct: " (ty-str a t))))))))

(defn mk-sumvars [(found bool)
                  (name (slice u8))
                  (variants (ptr (ArrayList Variant)))] (-> SumVars)
  (let [p (primitive/alloc-stack SumVars)]
    (set! (.found p) found)
    (set! (.name p) name)
    (set! (.variants p) variants)
    (load p)))

(defn variants-subst [(a (dyn Allocator))
                      (si (ptr SumInfo))
                      (args (ptr (ArrayList Type)))] (-> (ptr (ArrayList Variant)))
  (let [subst (subst-new a)
        tparams (load (field si type_params))
        np (len (load tparams))
        (mut i) 0]
    (loop (if (>= (load i) np)
              (break)
              (do
                (subst-insert! subst
                               (get (load tparams) (load i))
                               (elem args (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (let [vs (load (field si variants))
          nv (len (load vs))
          (mut out) (ArrayList::new [Variant] a)
          (mut j) 0]
      (loop (if (>= (load j) nv)
                (break)
                (do
                  (let [vp (elem vs (load j))
                        fs (load (field vp fields))
                        nf (len (load fs))
                        (mut fout) (ArrayList::new [Field] a)
                        (mut k) 0
                        nv2 (primitive/alloc-stack Variant)]
                    (loop (if (>= (load k) nf)
                              (break)
                              (do
                                (let [fp (elem fs (load k))
                                      nf2 (primitive/alloc-stack Field)]
                                  (set! (.name nf2) (.name fp))
                                  (set! (.ty nf2)
                                        (subst-apply a (field fp ty) subst))
                                  (push! (mut fout) (load nf2)))
                                (set! k (primitive/iadd (load k) 1)))))
                    (set! (.name nv2) (.name vp))
                    (set! (.fields nv2) (box-al [Field] a (load fout)))
                    (push! (mut out) (load nv2)))
                  (set! j (primitive/iadd (load j) 1)))))
      (box-al [Variant] a (load out)))))

(defn sum-variants [(a (dyn Allocator)) (t (ptr Type)) (cx (ptr Cx))] (-> SumVars)
  (let [tg (type-tag t)]
    (if (= tg 6)
        (let [si (sum-find cx (type-struct-name t))]
          (if (= (primitive/cast i64 si) 0)
              (mk-sumvars false "" (primitive/cast (ptr (ArrayList Variant)) 0))
              (mk-sumvars true (type-struct-name t) (load (field si variants)))))
        (if (= tg 11)
            (let [si (sum-find cx (t-app-name t))]
              (if (= (primitive/cast i64 si) 0)
                  (mk-sumvars false
                              ""
                              (primitive/cast (ptr (ArrayList Variant)) 0))
                  (mk-sumvars true
                              (t-app-name t)
                              (variants-subst a si (t-fn-params t)))))
            (mk-sumvars false "" (primitive/cast (ptr (ArrayList Variant)) 0))))))

(defn expected-sum-targs [(a (dyn Allocator))
                          (expected (ptr Type))
                          (sumname (slice u8))
                          (arity i64)] (-> TargsOpt)
  (let [p (primitive/alloc-stack TargsOpt)
        tg (type-tag expected)]
    (set! (.found p) false)
    (set! (.targs p) (primitive/cast (ptr (ArrayList Type)) 0))
    (if (= tg 11)
        (when (and (= (t-app-name expected) sumname)
                   (= (len (load (t-fn-params expected))) arity))
          (store! (field p found) true)
          (store! (field p targs) (t-fn-params expected))
          0)
        (when (and (= tg 6)
                   (and (= (type-struct-name expected) sumname)
                        (= arity 0)))
          (store! (field p found) true)
          (store! (field p targs) (box-items-type a))
          0))
    (load p)))

(defn mismatch-msg [(a (dyn Allocator))
                    (x (ptr Type))
                    (y (ptr Type))
                    (fname (slice u8))
                    (what (slice u8))] (-> Diag)
  (if (and (type-is-int x) (type-is-int y))
      (if (not (= (t-int-bits x) (t-int-bits y)))
          (derr (sconcat a
                         (sconcat a
                                  (sconcat a
                                           (sconcat3 a "in '" fname "': ")
                                           (sconcat a what " on mixed widths ("))
                                  (i64->str a (t-int-bits x)))
                         (sconcat a
                                  " and "
                                  (sconcat a
                                           (i64->str a (t-int-bits y))
                                           " bits)"))))
          (derr (sconcat a
                         (sconcat a
                                  (sconcat a
                                           (sconcat3 a "in '" fname "': ")
                                           (sconcat a
                                                    what
                                                    " on mixed signedness ("))
                                  (ty-str a x))
                         (sconcat a " and " (sconcat a (ty-str a y) ")")))))
      (derr (sconcat a
                     (sconcat a
                              (sconcat a
                                       (sconcat3 a "in '" fname "': ")
                                       (sconcat a what " on different types ("))
                              (ty-str a x))
                     (sconcat a " vs " (sconcat a (ty-str a y) ")"))))))

; A place `(ref T)`/`(mut T)` joined with a value `T` joins at the value, and so do
; two places that disagree only in mutability. An owning aggregate `let` is a
; `(ref T)` place and a constructed temporary a `(mut T)` one, so
; `(if c (let [x (make)] x) (make))` has one of each; so does a `block` whose tail
; names a local while a `return-from` carries a fresh value, which is how `try-or!`
; over an aggregate `Ok` payload used to fail. A place side is loaded, exactly as
; `coerce` does when an annotation supplies `T`, so an owner moves out and a
; borrowed owner is still rejected by the affine pass. Null means no join.
(defn place-decays-to? [(place (ptr Type)) (value (ptr Type))] (-> bool)
  (and (= (type-tag place) 5)
       (and (!= (type-tag value) 5)
            (type-eq (t-inner place) value))))

(defn join-branch-types [(x (ptr Type)) (y (ptr Type))] (-> (ptr Type))
  (cond (type-eq x y) x
        (place-decays-to? x y) y
        (place-decays-to? y x) x
        (and (and (= (type-tag x) 5)
                  (= (type-tag y) 5))
             (type-eq (t-inner x) (t-inner y)))
          (t-inner x)
        :else (primitive/cast (ptr Type) 0)))

(defn load-place-expr [(a (dyn Allocator)) (e (ptr Expr))] (-> Expr)
  (mk-expr (ELoad (box-expr a (load e)))
           (load (field e lo))
           (load (field e hi))
           (load (field e source))
           (load (field e ctxt))))

; unify_branches: fill `out` with coerced exprs, return target type.
(defn unify-branches [(a (dyn Allocator))
                      (branches (ptr (ArrayList Branch)))
                      (out (ptr (ArrayList Expr)))
                      (fname (slice u8))
                      (what (slice u8))] (-> (Result Type Diag))
  (let [n (len (load branches))
        (mut i) 0
        (mut have) false
        (mut concrete) (primitive/cast (ptr Type) 0)
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [bp (elem branches (load i))
                      be (load (field bp e))
                      bt (load (field bp t))]
                  (when (and (not (is-literal be)) (not (type-is-never bt)))
                    (if (not (load have))
                        (do (store! have true) (store! concrete bt) 0)
                        (let [joined (join-branch-types (load concrete) bt)]
                          (if (= (primitive/cast i64 joined)
                                 0)
                              (do
                                (store! err
                                        (mismatch-msg a
                                                      (load concrete)
                                                      bt
                                                      fname
                                                      what))
                                (store! failed true)
                                (break))
                              (do (store! concrete joined) 0))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [Type Diag] (load err))
        (let [(mut target) (primitive/cast (ptr Type) 0)]
          (if (load have)
              (do (set! target (load concrete)) 0)
              (let [(mut j) 0
                    (mut done) false]
                (loop (if (or (load done) (>= (load j) n))
                          (break)
                          (do
                            (let [bp (elem branches (load j))]
                              (when (not (type-is-never (load (field bp t))))
                                (store! target (load (field bp t)))
                                (store! done true)
                                0))
                            (set! j (primitive/iadd (load j) 1)))))
                (when (not (load done))
                  (store! target (box-type a (TInt 64 true)))
                  0)))
          ; A literal branch is a value, never a place, so a join that also
          ; names a place (`(if c 1 n)` over a `(mut i64)` local) is a value
          ; join: the target decays to the place's type and the place branch
          ; is loaded below.
          (when (= (type-tag (load target)) 5)
            (let [(mut q) 0]
              (loop (if (>= (load q) n)
                        (break)
                        (do
                          (let [bp (elem branches (load q))]
                            (when (and (is-literal (load (field bp e)))
                                       (not (type-is-never (load (field bp t)))))
                              (set! target (t-inner (load target)))
                              (break)))
                          (set! q (primitive/iadd (load q) 1)))))))
          (let [(mut k) 0
                (mut err2) (primitive/zeroed Diag)
                (mut failed2) false]
            (loop (if (>= (load k) n)
                      (break)
                      (do
                        (let [bp (elem branches (load k))
                              be (load (field bp e))
                              bt (load (field bp t))]
                          (cond (or (type-eq bt (load target)) (type-is-never bt))
                                  (push! [Expr] out (load be))
                                (place-decays-to? bt (load target))
                                  (push! [Expr] out (load-place-expr a be))
                                :else
                                  (if (and (same-number-kind bt (load target))
                                           (is-literal be))
                                      (match (coerce-lit a
                                                         (load be)
                                                         (load target)
                                                         fname)
                                        (Err [d]
                                             (do
                                               (set! err2 d)
                                               (set! failed2 true)
                                               (break)))
                                        (Ok [ce] (push! [Expr] out ce)))
                                      (do
                                        (set! err2
                                              (mismatch-msg a
                                                            bt
                                                            (load target)
                                                            fname
                                                            what))
                                        (set! failed2 true)
                                        (break)))))
                        (set! k (primitive/iadd (load k) 1)))))
            (if (load failed2)
                (Err [Type Diag] (load err2))
                (Ok (load (load target)))))))))

; coerce_arg
; The offending argument's own span, so an argument-type error underlines the
; argument (`"hello"`) not the whole call. dwspan only fills an unset (lo<0)
; span, so once attached here the enclosing call's synth won't overwrite it.
(defn coerce-arg-inner [(a (dyn Allocator))
                        (is_mut_borrow bool)
                        (ae Expr)
                        (at (ptr Type))
                        (want (ptr Type))
                        (is_extern bool)
                        (fname (slice u8))
                        (what (slice u8))] (-> (Result Expr Diag))
  (let [aep (primitive/alloc-stack Expr)]
    (set! aep ae)
    (let [wtg (type-tag want)]
      (cond (= wtg 5)
              (let [wp (t-inner want)
                    want_mut (t-ref-mut want)
                    ap (place-pointee at)]
                (cond (= (primitive/cast i64 ap) 0)
                        (if want_mut
                            (Err [Expr Diag]
                                 (derr (sconcat a
                                                (sconcat a
                                                         (sconcat3 a
                                                                   "in '"
                                                                   fname
                                                                   "': ")
                                                         (sconcat a
                                                                  what
                                                                  " is a (mut "))
                                                (sconcat a
                                                         (ty-str a wp)
                                                         ") parameter; pass a mutable place as (mut …)"))))
                            (if (not (type-eq at wp))
                                ; A numeric literal lent to a `(ref u64)` takes that
                                ; type, as it would passed by value; an array value
                                ; lent to a `(ref (slice T))` borrows as a slice, as
                                ; it would passed by value, and the slice is spilled.
                                (cond (and (same-number-kind at wp) (is-literal aep))
                                        (match (coerce-lit a (load aep) wp fname)
                                          (Err [d] (Err [Expr Diag] d))
                                          (Ok [lit] (Ok (mk-expr (ESpillRef (box-expr a lit))
                                                                 (load (field aep lo))
                                                                 (load (field aep hi))
                                                                 (load (field aep source))
                                                                 (load (field aep ctxt))))))
                                      (and (= (type-tag at) 7)
                                           (= (type-tag wp) 8))
                                        (match (coerce a (load aep) at wp is_extern fname what)
                                          (Err [d] (Err [Expr Diag] d))
                                          (Ok [se] (Ok (mk-expr (ESpillRef (box-expr a se))
                                                                (load (field aep lo))
                                                                (load (field aep hi))
                                                                (load (field aep source))
                                                                (load (field aep ctxt))))))
                                      :else
                                        (Err [Expr Diag]
                                             (derr (sconcat a
                                                            (sconcat a
                                                                     (sconcat a
                                                                              (sconcat3 a
                                                                                        "in '"
                                                                                        fname
                                                                                        "': ")
                                                                              (sconcat a
                                                                                       what
                                                                                       " expects a reference to "))
                                                                     (ty-str a wp))
                                                            (sconcat a
                                                                     ", got "
                                                                     (ty-str a at))))))
                                (Ok (borrow-address a aep))))
                      ; A fixed-array place against a `(slice T)` REFERENCE
                      ; parameter — `Set::set!`'s `(mut Self)` receiver is the one
                      ; that matters, and it is what `(set! xs i v)` on an array
                      ; reaches. Build the slice over the array place and spill it:
                      ; the callee gets an address, and the writes land in the
                      ; ARRAY, because only the temporary slice HEADER lives in the
                      ; spill slot while its data pointer is the array's own.
                      (and (= (type-tag ap) 7)
                           (= (type-tag wp) 8))
                        (let [explicitly_mut (or is_mut_borrow (type-is-ptr at))]
                          (cond (and want_mut (not explicitly_mut))
                                  (Err [Expr Diag]
                                       (derr (sconcat a
                                                      (sconcat a
                                                               (sconcat3 a
                                                                         "in '"
                                                                         fname
                                                                         "': ")
                                                               (sconcat a
                                                                        what
                                                                        " is a (mut "))
                                                      (sconcat a
                                                               (ty-str a wp)
                                                               ") parameter; pass a mutable place as (mut …)"))))
                                (and want_mut (not (is-writable at)))
                                  (Err [Expr Diag]
                                       (derr (sconcat a
                                                      (sconcat3 a
                                                                "in '"
                                                                fname
                                                                "': ")
                                                      (sconcat a
                                                               what
                                                               " cannot be mutably borrowed (it is immutable)"))))
                                :else
                                  (match (coerce-array-to-slice a
                                                                aep
                                                                (load aep)
                                                                ap
                                                                at
                                                                wp
                                                                fname
                                                                what)
                                    (Err [d] (Err [Expr Diag] d))
                                    (Ok [se]
                                        (Ok (mk-expr (ESpillRef (box-expr a se))
                                                     (load (field aep lo))
                                                     (load (field aep hi))
                                                     (load (field aep source))
                                                     (load (field aep ctxt))))))))
                      ; A raw pointer is a place of its pointee, but it is also
                      ; a value in its own right: a `(ref (ptr V))` parameter
                      ; borrows that value, so spill it like any other rvalue.
                      (and (not (type-eq ap wp))
                           (and (type-eq at wp) (not want_mut)))
                        (Ok (mk-expr (ESpillRef (box-expr a (load aep)))
                                     (load (field aep lo))
                                     (load (field aep hi))
                                     (load (field aep source))
                                     (load (field aep ctxt))))
                      (not (type-eq ap wp))
                        (Err [Expr Diag]
                             (derr (sconcat a
                                            (sconcat a
                                                     (sconcat a
                                                              (sconcat3 a
                                                                        "in '"
                                                                        fname
                                                                        "': ")
                                                              (sconcat a
                                                                       what
                                                                       " has type "))
                                                     (ty-str a at))
                                            (sconcat a
                                                     " but expected a reference to "
                                                     (ty-str a wp)))))
                      want_mut
                        (let [explicitly_mut (or is_mut_borrow (type-is-ptr at))]
                          (if (not explicitly_mut)
                              (Err [Expr Diag]
                                   (derr (sconcat a
                                                  (sconcat a
                                                           (sconcat3 a
                                                                     "in '"
                                                                     fname
                                                                     "': ")
                                                           (sconcat a
                                                                    what
                                                                    " is a (mut "))
                                                  (sconcat a
                                                           (ty-str a wp)
                                                           ") parameter; pass a mutable place as (mut …)"))))
                              (if (not (is-writable at))
                                  (Err [Expr Diag]
                                       (derr (sconcat a
                                                      (sconcat3 a
                                                                "in '"
                                                                fname
                                                                "': ")
                                                      (sconcat a
                                                               what
                                                               " cannot be mutably borrowed (it is immutable)"))))
                                  (Ok (load aep)))))
                      :else (Ok (load aep))))
            (= wtg 6)
              (if (type-eq at want)
                  (Ok (load aep))
                  (if is_extern
                      (let [pp (place-pointee at)]
                        (if (and (!= (primitive/cast i64 pp)
                                     0)
                                 (= (struct-name pp)
                                    (type-struct-name want)))
                            (Ok (load aep))
                            (coerce a (load aep) at want is_extern fname what)))
                      (coerce a (load aep) at want is_extern fname what)))
            (= wtg 4)
              (let [wp (t-inner want)
                    pp (place-pointee at)]
                (if (and (!= (primitive/cast i64 pp) 0)
                         (and (type-eq pp wp) (is-writable at)))
                    (Ok (load aep))
                    (coerce a (load aep) at want is_extern fname what)))
            :else (coerce a (load aep) at want is_extern fname what)))))

;;; A diverging argument fits any parameter but a `Code` one. Compile-time code
;;; tells a call to a function over `Code` from a use of it as a macro by whether
;;; the arguments check as values. A `never` argument -- `(panic …)`, a
;;; `(-> never)` call -- would check against anything, so a macro use whose
;;; arguments all diverge was taken for a call and left unexpanded.
(defn never-code-arg-message [(a (dyn Allocator)) (fname (slice u8)) (what (slice u8))] (-> (slice u8))
  (sconcat a
           (sconcat3 a "in '" fname "': ")
           (sconcat a
                    what
                    " never produces a value, so it cannot be passed as Code; a function over Code is a macro, and its arguments are syntax")))

(defn coerce-arg [(a (dyn Allocator))
                  (is_mut_borrow bool)
                  (ae Expr)
                  (at (ptr Type))
                  (want (ptr Type))
                  (is_extern bool)
                  (fname (slice u8))
                  (what (slice u8))] (-> (Result Expr Diag))
  (let [aep (primitive/alloc-stack Expr)]
    (set! aep ae)
    (match (if (and (type-is-never at)
                    (match (load want) (TCode [] true) (_ false)))
               (Err [Expr Diag] (derr (never-code-arg-message a fname what)))
               (coerce-arg-inner a is_mut_borrow ae at want is_extern fname what))
      (Ok [e] (Ok [Expr Diag] e))
      (Err [d]
           (Err [Expr Diag]
                (dwspan d
                        (.source aep)
                        (.lo aep)
                        (.hi aep)
                        (.ctxt aep)))))))

;;; A call argument synthesized against `exp`, its parameter's type or, for a
;;; reference parameter (`by-ref`), the type the reference is to. A reference
;;; parameter takes a value of `exp`, which it borrows, or a place of `exp`, which
;;; it is lent as it is (coerce-arg-inner). `exp` still guides the argument, so a
;;; literal or a constructor infers from it, but the tail of a compound argument,
;;; `(do … p)` or `(if c p q)`, is held to it, and a place of `exp` does not meet
;;; it: `(show (do p))` was refused where `(show p)` was not. So when synthesizing
;;; against `exp` fails, an argument that synthesizes on its own to a place of
;;; `exp` is that place; anything else keeps the first error. A borrowed value is
;;; left in exactly this form -- `(load (do p))` lent to `(ref S)` checks to `(do
;;; p)` (borrow-address) -- so a checked call can be checked again
;;; (synth-rechecked) only if this reads it back.
(defn synth-arg [(a (dyn Allocator))
                 (arg (ptr Expr))
                 (exp (ptr Type))
                 (by-ref bool)
                 (env (ptr (ArrayList EnvEntry)))
                 (cx (ptr Cx))
                 (tps (ptr (ArrayList (slice u8))))
                 (fname (slice u8))] (-> (Result SynPair Diag))
  (match (do-synth a arg exp env cx tps fname)
    (Ok [sp] (Ok [SynPair Diag] sp))
    (Err [d]
         (if (not by-ref)
             (Err [SynPair Diag] d)
             (match (do-synth a arg (null-type) env cx tps fname)
               (Ok [sp0]
                   (let [sp (primitive/alloc-stack SynPair)]
                     (set! sp sp0)
                     (let [pp (place-pointee (load (field sp t)))]
                       (if (and (!= (primitive/cast i64 pp) 0) (type-eq pp exp))
                           (Ok [SynPair Diag] sp0)
                           (Err [SynPair Diag] d)))))
               (Err [_] (Err [SynPair Diag] d)))))))

(defn check-to [(a (dyn Allocator))
                (e (ptr Expr))
                (want (ptr Type))
                (env (ptr (ArrayList EnvEntry)))
                (cx (ptr Cx))
                (tps (ptr (ArrayList (slice u8))))
                (fname (slice u8))
                (what (slice u8))] (-> (Result Expr Diag))
  (match (do-synth a e want env cx tps fname)
    (Err [d] (Err [Expr Diag] d))
    (Ok [sp0]
        (let [sp (primitive/alloc-stack SynPair)]
          (set! sp sp0)
          (match (coerce a
                         (load (load (field sp e)))
                         (load (field sp t))
                         want
                         false
                         fname
                         what)
            (Err [d] (Err [Expr Diag] d))
            (Ok [ce]
                (if (discarded-value? want (load (field sp t)))
                    (Ok (discard-value a ce))
                    (Ok ce))))))))

; A value checked against void is discarded (a statement, or a branch of one).
; Its branches may have different types, so each becomes `(do value (do))`: the
; value is evaluated for effect and the branch yields the canonical unit, which
; is what every backend already produces for an empty body.
(defn discarded-value? [(want (ptr Type)) (actual (ptr Type))] (-> bool)
  (and (expected-some? want)
       (and (type-is-void want)
            (not (or (type-is-void actual)
                     (or (type-is-never actual)
                         (match (load actual) (TError [] true) (_ false))))))))

(defn discard-value [(a (dyn Allocator)) (e Expr)] (-> Expr)
  (let [(mut items) (ArrayList::new [Expr] a)]
    (push! (mut items) e)
    (push! (mut items)
           (mk-expr (EDo (box-al [Expr] a (ArrayList::new [Expr] a)))
                    (.lo e) (.hi e) (.source e) (.ctxt e)))
    (mk-expr (EDo (box-al [Expr] a (load items)))
             (.lo e) (.hi e) (.source e) (.ctxt e))))

 ; Function-pointer return positions describe an ABI, not a value argument.
 ; R may denote void here; the ordinary unifier still rejects a void expression
 ; passed as a generic value. Keep the exception local to the return position.
(defn unify-return [(a (dyn Allocator)) (decl (ptr Type)) (actual (ptr Type))
                     (tpset (ptr (ArrayList (slice u8))))
                     (subst (ptr (ArrayList SubstEntry))) (fname (slice u8))]
                     (-> (Result i64 Diag))
  (if (and (type-is-void actual)
           (and (= (type-tag decl) 6) (set-contains tpset (type-struct-name decl))))
    (let [name (type-struct-name decl) previous (subst-get subst name)]
      (if (= (primitive/cast i64 previous) 0)
        (do (subst-insert! subst name actual) (Ok [i64 Diag] 0))
        (unify a previous actual tpset subst fname)))
    (unify a decl actual tpset subst fname)))

;;; The type a call argument `e` of type `actual` is unified with `decl` as.
;;; Reading a `(mut p)` local that holds a pointer types as the mutable place,
;;; and for a `(ptr T)` parameter `unify` reads a mutable place as its address
;;; (T := the pointer), which is what a written `(mut p)` means. A bare `p` means
;;; the pointer it holds, as the final coercion passes it, so T is its pointee.
(defn arg-unify-type [(decl (ptr Type)) (actual (ptr Type)) (e (ptr Expr))
                      (tpset (ptr (ArrayList (slice u8))))] (-> (ptr Type))
  (if (and (!= (primitive/cast i64 e) 0)
           (and (match (.kind e) (EBorrow [_ _] false) (_ true))
                (and (= (type-tag decl) 4)
                     (and (= (type-tag (t-inner decl)) 6)
                          (and (set-contains tpset (type-struct-name (t-inner decl)))
                               (and (= (type-tag actual) 5)
                                    (and (t-ref-mut actual)
                                         (= (type-tag (t-inner actual)) 4))))))))
      (t-inner actual)
      actual))

; unify
(defn unify [(a (dyn Allocator))
             (decl (ptr Type))
             (actual (ptr Type))
             (tpset (ptr (ArrayList (slice u8))))
             (subst (ptr (ArrayList SubstEntry)))
             (fname (slice u8))] (-> (Result i64 Diag))
  ; An inference hole is a part nothing has determined: it agrees with anything
  ; and binds nothing.
  (if (or (and (type-is-void decl) (type-is-void actual)) (inference-hole? actual))
      (Ok [i64 Diag] 0)
      (if (or (type-is-void decl) (type-is-void actual))
          (Err [i64 Diag]
               (derr (sconcat3 a
                               "in '"
                               fname
                               "': a void value cannot be used as a type argument (a (-> void) call yields nothing)")))
          (if (and (= (type-tag decl) 6)
                   (set-contains tpset (type-struct-name decl)))
              (let [p (type-struct-name decl)
                    act
                      (if (= (type-tag actual) 5)
                          (t-inner actual)
                          actual)
                    prev (subst-get subst p)]
                (if (!= (primitive/cast i64 prev) 0)
                    ; An expression that never yields fits any type, so `never`
                    ; agrees with every other binding and yields to it.
                    (if (and (not (type-eq prev act))
                             (and (not (type-is-never act))
                                  (if (type-is-never prev)
                                      (do (store! prev (load act)) false)
                                      true)))
                        (Err [i64 Diag]
                             (derr (sconcat a
                                            (sconcat a
                                                     (sconcat a
                                                              (sconcat4 a
                                                                        "in '"
                                                                        fname
                                                                        "': conflicting types for parameter '"
                                                                        (sconcat a
                                                                                 p
                                                                                 "' ("))
                                                              (ty-str a prev))
                                                     " vs ")
                                            (sconcat a (ty-str a act) ")"))))
                        (Ok [i64 Diag] 0))
                    (do (subst-insert! subst p act) (Ok [i64 Diag] 0))))
              (let [dt (type-tag decl)
                    at2 (type-tag actual)]
                (cond (and (= dt 4)
                           (= at2 4))
                        (unify a
                               (t-inner decl)
                               (t-inner actual)
                               tpset
                               subst
                               fname)
                      ; a mutable place that holds a pointer, given to a `(ptr P)`
                      ; parameter whose pointee P is neither a pointer nor a bare type
                      ; parameter, can only mean the pointer it holds (as `coerce`
                      ; reads it when the type arguments are written), so P binds
                      ; against that pointer's pointee
                      (and (= dt 4)
                           (and (= at2 5)
                                (and (t-ref-mut actual)
                                     (and (= (type-tag (t-inner actual)) 4)
                                          (and (!= (type-tag (t-inner decl)) 4)
                                               (not (and (= (type-tag (t-inner decl)) 6)
                                                         (set-contains tpset
                                                                       (type-struct-name (t-inner decl))))))))))
                        (unify a decl (t-inner actual) tpset subst fname)
                      ; a `(mut x)` borrow passes the place's address to a `(ptr T)`
                      ; parameter, so it binds T to the place's type
                      (and (= dt 4)
                           (and (= at2 5) (t-ref-mut actual)))
                        (unify a
                               (t-inner decl)
                               (t-inner actual)
                               tpset
                               subst
                               fname)
                      ; a (ptr T) argument satisfies a (mut T)/(ref T) parameter — see through
                      ; BOTH wrappers; a BARE type-parameter pointee keeps the
                      ; general Ref-arm reading below (T := the whole pointer)
                      ; A `(ref (ptr T))` parameter borrows a pointer VALUE, so a
                      ; `(ptr V)` whose pointee is no pointer binds T := V through
                      ; the general Ref arm below rather than through its pointee.
                      (and (and (and (= dt 5)
                                     (= at2 4))
                                (not (and (= (type-tag (t-inner decl))
                                             4)
                                          (!= (type-tag (t-inner actual))
                                              4))))
                           (not (and (= (type-tag (t-inner decl))
                                        6)
                                     (set-contains tpset
                                                   (type-struct-name (t-inner decl))))))
                        (unify a
                               (t-inner decl)
                               (t-inner actual)
                               tpset
                               subst
                               fname)
                      ; ... but when T is already known to be the pointee, the
                      ; pointer IS the reference, exactly as it is for a
                      ; concrete `(ref T)` parameter.
                      (and (and (= dt 5)
                                (= at2 4))
                           (and (= (type-tag (t-inner decl)) 6)
                                (let [prev (subst-get subst (type-struct-name (t-inner decl)))]
                                  (and (!= (primitive/cast i64 prev) 0)
                                       (type-eq prev (t-inner actual))))))
                        (Ok [i64 Diag] 0)
                      (= dt 5)
                        (unify a (t-inner decl) actual tpset subst fname)
                      (= at2 5)
                        (unify a decl (t-inner actual) tpset subst fname)
                      (and (= dt 7)
                           (= at2 7))
                        (match (unify a
                                 (box-type a (extent-type (array-extent-of-type decl)))
                                 (box-type a (extent-type (array-extent-of-type actual)))
                                 tpset subst fname)
                          (Err [d] (Err [i64 Diag] d))
                          (Ok [_] (unify a (t-inner decl) (t-inner actual) tpset subst fname)))
                      ; Two constants in the same position must be equal: nothing
                      ; later can convert `(vec T 4)` into `(vec T 8)`.
                      (and (= dt 16)
                           (= at2 16))
                        (if (const-type-eq decl actual)
                            (Ok [i64 Diag] 0)
                            (Err [i64 Diag]
                                 (derr (sconcat a
                                                (sconcat4 a "in '" fname "': conflicting constants " (ty-str a decl))
                                                (sconcat a " vs " (ty-str a actual))))))
                      ; TVec(9), same as the array arm above. Absent until structural impls made
                      ; `(impl [T] Trait (vec T N))` expressible: nothing had ever been generic over
                      ; a vector, so `(vec T 4)` vs `(vec i64 4)` fell through and T went unsolved.
                      (and (= dt 9)
                           (= at2 9))
                        (match (unify a
                                 (box-type a (extent-type (vector-width-of-type decl)))
                                 (box-type a (extent-type (vector-width-of-type actual)))
                                 tpset subst fname)
                          (Err [d] (Err [i64 Diag] d))
                          (Ok [_] (unify a (t-inner decl) (t-inner actual) tpset subst fname)))
                      ; A fixed array BORROWS as a slice at a call (coerce), so a
                      ; `(slice T)` parameter must infer T from an `(array T N)`
                      ; argument as well — otherwise the borrow is reachable only
                      ; when some other argument already pinned T, and `(len xs)`
                      ; on an array fails with "cannot infer T" rather than
                      ; performing the borrow the checker is about to insert.
                      (and (= dt 8)
                           (= at2 7))
                        (unify a
                               (t-inner decl)
                               (t-inner actual)
                               tpset
                               subst
                               fname)
                      ; The same borrow through a raw pointer to the array, which
                      ; is how method dispatch reaches it (deref-to-impl peels a
                      ; pointer that carries no impl of its own).
                      (and (and (= dt 8)
                                (= at2 4))
                           (= (type-tag (t-inner actual))
                              7))
                        (unify a
                               (t-inner decl)
                               (t-inner (t-inner actual))
                               tpset
                               subst
                               fname)
                      (and (= dt 8)
                           (= at2 8))
                        (unify a
                               (t-inner decl)
                               (t-inner actual)
                               tpset
                               subst
                               fname)
                      (and (and (= dt 11)
                                (= at2 11))
                           (and (= (t-app-name decl) (t-app-name actual))
                                (= (len (load (t-fn-params decl)))
                                   (len (load (t-fn-params actual))))))
                        (unify-list a
                                    (t-fn-params decl)
                                    (t-fn-params actual)
                                    tpset
                                    subst
                                    fname)
                      (and (and (= dt 10)
                                (= at2 10))
                           (let [dp (t-fn-params decl)
                                 ap (t-fn-params actual)]
                             (if (>= (list-pack-index dp) 0)
                                 (>= (len (load ap))
                                     (primitive/isub (len (load dp)) 1))
                                 (= (len (load dp)) (len (load ap))))))
                        (match (unify-list a
                                           (t-fn-params decl)
                                           (t-fn-params actual)
                                           tpset
                                           subst
                                           fname)
                          (Err [d] (Err [i64 Diag] d))
                          (Ok [_]
                              (unify-return a
                                     (t-fn-ret decl)
                                     (t-fn-ret actual)
                                     tpset
                                     subst
                                     fname)))
                      :else (Ok [i64 Diag] 0)))))))

(defn unify-list [(a (dyn Allocator))
                  (xs (ptr (ArrayList Type)))
                  (ys (ptr (ArrayList Type)))
                  (tpset (ptr (ArrayList (slice u8))))
                  (subst (ptr (ArrayList SubstEntry)))
                  (fname (slice u8))] (-> (Result i64 Diag))
  (unify-list-mode a xs ys tpset subst fname (primitive/cast (ptr (ArrayList bool)) 0)))

;;; A call's argument types against its declared parameter list. Unlike two type
;;; lists, a pack an earlier parameter already bound (a Callable's `self` binds
;;; `Args` from the function pointer's type) is what the arguments must be passed
;;; as, not a second equation: an argument fits when the final coercion can pass
;;; it, so a constructor temporary `(mut T)` fits a `T` or `(ref T)` slot, and a
;;; numeric literal (`literals` marks them) fits any numeric slot it could be.
(defn unify-arg-list [(a (dyn Allocator))
                      (xs (ptr (ArrayList Type)))
                      (ys (ptr (ArrayList Type)))
                      (literals (ptr (ArrayList bool)))
                      (tpset (ptr (ArrayList (slice u8))))
                      (subst (ptr (ArrayList SubstEntry)))
                      (fname (slice u8))] (-> (Result i64 Diag))
  (unify-list-mode a xs ys tpset subst fname literals))

;;; Can an argument of type `got` be passed where `want` is expected? The final
;;; coercion decides for real; this only keeps inference from rejecting it.
(defn arg-fits-pack-slot? [(got (ptr Type)) (want (ptr Type))] (-> bool)
  (or (type-eq got want)
      (let [g5 (= (type-tag got) 5)
            w5 (= (type-tag want) 5)]
        (cond (and g5 w5) (type-eq (t-inner got) (t-inner want))
              g5 (type-eq (t-inner got) want)
              w5 (type-eq got (t-inner want))
              :else false))))

; A numeric literal argument is a weak constraint: its default type is only what it
; is when nothing else decides, so it fits a slot of any numeric type it can become
; (an integer literal an integer or a float, a float literal a float). The final
; coercion checks that the value is representable there.
(defn literal-fits-pack-slot? [(got (ptr Type)) (want (ptr Type))] (-> bool)
  (let [slot (if (= (type-tag want) 5) (t-inner want) want)]
    (match (load got)
      (TInt [_ _] (match (load slot) (TInt [_ _] true) (TFloat [_] true) (_ false)))
      (TFloat [_] (match (load slot) (TFloat [_] true) (_ false)))
      (_ false))))

; `packed` is the arguments' pack, built from the argument types from index
; `first` on; `literals`, indexed like those arguments, marks the numeric literals.
(defn pack-args-fit? [(prev (ptr Type))
                      (packed (ptr Type))
                      (literals (ptr (ArrayList bool)))
                      (first i64)] (-> bool)
  (match (load prev)
    (TApp [pn pargs]
          (match (load packed)
            (TApp [qn qargs]
                  (and (= (len (load pargs)) (len (load qargs)))
                       (block :fit
                         (for [i 0 (len (load pargs))]
                           (let [got (elem qargs i)
                                 want (elem pargs i)
                                 literal (and (< (+ first i) (len (load literals)))
                                              (get (load literals) (+ first i)))]
                             (unless (or (arg-fits-pack-slot? got want)
                                         (and literal (literal-fits-pack-slot? got want)))
                               (break :fit false))))
                         true)))
            (_ false)))
    (_ false)))

(defn unify-list-mode [(a (dyn Allocator))
                       (xs (ptr (ArrayList Type)))
                       (ys (ptr (ArrayList Type)))
                       (tpset (ptr (ArrayList (slice u8))))
                       (subst (ptr (ArrayList SubstEntry)))
                       (fname (slice u8))
                       (literals (ptr (ArrayList bool)))] (-> (Result i64 Diag))
  (let [args (!= (primitive/cast i64 literals) 0)
        n (len (load xs))
        ny (len (load ys))
        pi (list-pack-index xs)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (when (>= pi 0)
      (let [tail (primitive/isub n (primitive/iadd pi 1))]
        (if (< ny (primitive/isub n 1))
            (do
              (store! err
                      (derr (sconcat3 a
                                      "in '"
                                      fname
                                      "': not enough arguments for parameter pack")))
              (store! failed true))
            (let [count (primitive/isub ny (primitive/iadd pi tail))
                  pn (pack-var-name (elem xs pi))
                  packed (make-pack a ys pi (primitive/iadd pi count))]
              ; Arguments bind the pack after the parameters around it, so a
              ; pack those determine is the one the arguments are checked by.
              (unless args (bind-pack! a pn packed subst fname literals pi err failed) 0)
              (store! i 0)
              (loop (if (or (load failed) (>= (load i) pi))
                        (break)
                        (do
                          (match (unify a
                                        (elem xs (load i))
                                        (elem ys (load i))
                                        tpset
                                        subst
                                        fname)
                            (Err [d] (do (store! err d) (store! failed true)))
                            (Ok [_] 0))
                          (store! i (primitive/iadd (load i) 1)))))
              (store! i 0)
              (loop (if (or (load failed) (>= (load i) tail))
                        (break)
                        (do
                          (match (unify a
                                        (elem xs
                                              (primitive/iadd (primitive/iadd pi
                                                                              1)
                                                              (load i)))
                                        (elem ys
                                              (primitive/iadd (primitive/iadd pi
                                                                              count)
                                                              (load i)))
                                        tpset
                                        subst
                                        fname)
                            (Err [d] (do (store! err d) (store! failed true)))
                            (Ok [_] 0))
                          (store! i (primitive/iadd (load i) 1)))))
              (when (and args (not (load failed)))
                (bind-pack! a pn packed subst fname literals pi err failed))
              0))))
    (when (>= pi 0) (store! i n))
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (unify a
                              (elem xs (load i))
                              (elem ys (load i))
                              tpset
                              subst
                              fname)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn bind-pack! [(a (dyn Allocator))
                  (pn (slice u8))
                  (packed Type)
                  (subst (ptr (ArrayList SubstEntry)))
                  (fname (slice u8))
                  (literals (ptr (ArrayList bool)))
                  (first i64)
                  (err (ptr Diag))
                  (failed (ptr bool))] (-> i64)
  (let [args (!= (primitive/cast i64 literals) 0)
        prev (subst-get subst pn)
        pk (box-type a packed)]
    (cond (= (primitive/cast i64 prev) 0)
            (do (subst-insert! subst pn pk) 0)
          (or (type-eq prev pk) (and args (pack-args-fit? prev pk literals first))) 0
          :else
            (do (store! err
                        (derr (sconcat3 a
                                        "in '"
                                        fname
                                        "': conflicting types for parameter pack")))
                (store! failed true)
                0))))

; Does `ty` carry every trait a bound requires?
(defn bound-satisfied? [(a (dyn Allocator))
                        (cx (ptr Cx))
                        (bp (ptr Bound))
                        (ty (ptr Type))] (-> bool)
  (let [trs (load (field bp traits))
        (mut ok) true]
    (for [k 0 (len (load trs))]
      (unless (impl-match a cx (.name (elem trs k)) ty)
        (store! ok false)))
    (load ok)))

; The bundled collection traits are implemented on slices, not arrays, so a bounded
; type parameter inferred as `(array T N)` fails the bound unless the program wrote
; its own `(impl [T (const N i64)] … (array T N))`. An array
; borrows as a slice, though, so rebind it to `(slice T)` whenever the slice
; satisfies the bound the array does not — the monomorphized parameter then reads `(slice T)`,
; the associated types below resolve off the slice's impls, and `coerce` inserts
; the same array->slice borrow a written-out `(slice T)` parameter already gets.
; The array is tested first, so nothing changes for a bound it does satisfy.
(defn bounds-borrow-arrays! [(a (dyn Allocator))
                             (cx (ptr Cx))
                             (bounds (ptr (ArrayList Bound)))
                             (subst (ptr (ArrayList SubstEntry)))] (-> i64)
  (for [bi 0 (len (load bounds))]
    (let [bp (elem bounds bi)
          ty (subst-get subst (.name bp))]
      (unless (= (primitive/cast i64 ty) 0)
        (when (= (type-tag ty) 7)
          (let [sl (box-type a (TSlice (t-inner ty)))]
            (when (and (not (bound-satisfied? a cx bp ty))
                       (bound-satisfied? a cx bp sl))
              (store! ty (load sl))))))))
  0)

;;; Is every parameter that mentions type parameter `name` exactly `(ref name)`?
(defn only-borrowed-as? [(declared (ptr (ArrayList Type))) (name (slice u8))] (-> bool)
  (let [(mut ok) true]
    (for [j 0 (len (load declared))]
      (let [d (elem declared j)]
        (when (type-mentions d name)
          (match (load d)
            (TRef [m inner]
                  (match (load inner)
                    (TStruct [n] (when (or m (!= n name)) (set! ok false) 0))
                    (_ (set! ok false))))
            (_ (set! ok false)))
          0))
      0)
    (load ok)))

;;; A pointer-typed binding for a bounded parameter that is only ever borrowed,
;;; `(ref C)`, binds to its pointee when the pointer does not satisfy the bound and
;;; the pointee does: a raw pointer is a place of its pointee, and a `(ref T)`
;;; parameter accepts one as that place. So `(empty? (field s items))` asks the
;;; list, as `(len (field s items))` does, rather than the pointer.
(defn bounds-borrow-pointers! [(a (dyn Allocator))
                               (cx (ptr Cx))
                               (bounds (ptr (ArrayList Bound)))
                               (declared (ptr (ArrayList Type)))
                               (subst (ptr (ArrayList SubstEntry)))] (-> i64)
  (for [bi 0 (len (load bounds))]
    (let [bp (elem bounds bi)
          ty (subst-get subst (.name bp))]
      (unless (= (primitive/cast i64 ty) 0)
        (when (and (= (type-tag ty) 4)
                   (only-borrowed-as? declared (.name bp)))
          (let [pointee (t-inner ty)]
            (when (and (not (bound-satisfied? a cx bp ty))
                       (bound-satisfied? a cx bp pointee))
              (store! ty (load pointee))))))))
  0)

; solve_type_args
; Check generic argument kinds before constructing substituted vector types.
; The generic parameter's use determines its kind: a vector width is an integer,
; while an element, parameter, or return type must be a runtime type.
; After the kinds of a call's generic arguments are checked, a substituted vector
; width must still be positive.
(defn validate-substitution-width [(a (dyn Allocator)) (t (ptr Type))
                                   (subst (ptr (ArrayList SubstEntry)))] (-> (Result i64 Diag))
  (try
    (match (load t)
      (TVec [elem width]
        (do
          (try! (validate-substitution-width a elem subst))
          (let [actual (subst-apply a (box-type a (extent-type width)) subst)]
            (match actual
              (TConst [v]
                (match v
                  (ConstInt [n]
                    (if (> n 0) (Ok [i64 Diag] 0)
                        (Err [i64 Diag] (derr "vector width must be positive"))))
                  (_ (Err [i64 Diag] (derr "vector width requires an integer generic argument")))))
              (_ (Ok [i64 Diag] 0))))))
      (TPtr [inner] (validate-substitution-width a inner subst))
      (TRef [_ inner] (validate-substitution-width a inner subst))
      (TArray [elem width]
        (do
          (try! (validate-substitution-width a elem subst))
          (let [actual (subst-apply a (box-type a (extent-type width)) subst)]
            (match actual
              (TConst [v]
                (match v
                  (ConstInt [n]
                    (if (>= n 0) (Ok [i64 Diag] 0)
                        (Err [i64 Diag] (derr "array length cannot be negative"))))
                  (_ (Err [i64 Diag] (derr "array length requires an integer generic argument")))))
              (_ (Ok [i64 Diag] 0))))))
      (TSlice [inner] (validate-substitution-width a inner subst))
      (TApp [_ args] (validate-substitution-widths a args subst))
      (TFn [_ params ret]
        (do (try! (validate-substitution-widths a params subst))
            (validate-substitution-width a ret subst)))
      (_ (Ok [i64 Diag] 0)))))

(defn validate-substitution-widths [(a (dyn Allocator)) (types (ptr (ArrayList Type)))
                                    (subst (ptr (ArrayList SubstEntry)))] (-> (Result i64 Diag))
  (try
    (for [i 0 (len (load types))]
      (try! (validate-substitution-width a (elem types i) subst)))
    (Ok [i64 Diag] 0)))

(defn solve-type-args [(a (dyn Allocator))
                       (type_params (ptr (ArrayList (slice u8))))
                       (bounds (ptr (ArrayList Bound)))
                       (declared (ptr (ArrayList Type)))
                       (type_args (ptr (ArrayList Type)))
                       (arglist (ptr (ArrayList ArgSlot)))
                       (ret_tmpl (ptr Type)) (expected (ptr Type))
                       (cx (ptr Cx)) (tps (ptr (ArrayList (slice u8))))
                       (fname (slice u8)) (what (slice u8)) (allow-missing bool)]
                       (-> (Result (ptr (ArrayList SubstEntry)) Diag))
  (try
    (let [subst (try! (solve-type-args-infer a type_params bounds declared type_args
                         arglist ret_tmpl expected cx tps fname what allow-missing))]
      (for [i 0 (len (load type_params))]
        (let [p (get (load type_params) i)
              bound (subst-get subst p)]
          (unless (or (type-param-pack-name? p) (= (primitive/cast i64 bound) 0))
            (match (check-generic-arg-kind a cx tps what p (bound-value-type bounds p) bound)
              (Err [d] (break :try (Err [(ptr (ArrayList SubstEntry)) Diag]
                                        (prefix-diag a d (sconcat3 a "in '" fname "': ")))))
              (Ok [_] 0)))))
      (try! (validate-substitution-widths a declared subst))
      (try! (validate-substitution-width a ret_tmpl subst))
      (Ok subst))))

;;; Do the arguments alone, with no context, solve a generic call's return
;;; type to never? Only asked when an argument's type mentions never.
(defn returns-never-from-arguments? [(a (dyn Allocator))
                                     (type_params (ptr (ArrayList (slice u8))))
                                     (bounds (ptr (ArrayList Bound)))
                                     (declared (ptr (ArrayList Type)))
                                     (arglist (ptr (ArrayList ArgSlot)))
                                     (ret_tmpl (ptr Type))
                                     (cx (ptr Cx))
                                     (tps (ptr (ArrayList (slice u8))))
                                     (fname (slice u8))
                                     (what (slice u8))] (-> bool)
  (and (block :mentions
         (for [j 0 (len (load arglist))]
           (let [slot (elem arglist j)]
             (when (and (.present slot) (type-mentions-never? (.t slot)))
               (break :mentions true))))
         false)
       (match (solve-type-args-infer a type_params bounds declared
                                     (box-al [Type] a (ArrayList::new [Type] a))
                                     arglist ret_tmpl (null-type) cx tps fname what true)
         (Ok [subst] (type-is-never (box-type a (subst-apply a ret_tmpl subst))))
         (Err [_] false))))

(defn type-mentions-never? [(t (ptr Type))] (-> bool)
  (match (load t)
    (TNever [] true)
    (TRef [_ p] (type-mentions-never? p))
    (TPtr [p] (type-mentions-never? p))
    (TApp [_ args] (block :found
                     (for [i 0 (len (load args))]
                       (when (type-mentions-never? (elem args i)) (break :found true)))
                     false))
    (TFn [_ ps r] (or (type-mentions-never? r)
                      (block :found
                        (for [i 0 (len (load ps))]
                          (when (type-mentions-never? (elem ps i)) (break :found true)))
                        false)))
    (_ false)))

(defn solve-type-args-infer [(a (dyn Allocator))
                       (type_params (ptr (ArrayList (slice u8))))
                       (bounds (ptr (ArrayList Bound)))
                       (declared (ptr (ArrayList Type)))
                       (written-type-args (ptr (ArrayList Type)))
                       (arglist (ptr (ArrayList ArgSlot)))
                       (ret_tmpl (ptr Type))
                       (expected (ptr Type))
                       (cx (ptr Cx))
                       (tps (ptr (ArrayList (slice u8))))
                       (fname (slice u8))
                       (what (slice u8))
                       (allow-missing bool)] (-> (Result (ptr (ArrayList SubstEntry))
                                                         Diag))
  (match (explicit-type-args a cx written-type-args fname)
    (Err [d] (Err [(ptr (ArrayList SubstEntry)) Diag] d))
    (Ok [type_args]
  (let [subst (subst-new a)
        np (len (load type_params))]
    (if (> (len (load type_args)) 0)
        (if (not (= (len (load type_args)) np))
            (Err [(ptr (ArrayList SubstEntry)) Diag]
                 (derr (sconcat a
                                (sconcat a
                                         (sconcat a
                                                  (sconcat4 a
                                                            "in '"
                                                            fname
                                                            "': '"
                                                            (sconcat a
                                                                     what
                                                                     "' expects "))
                                                  (i64->str a np))
                                         " type arguments, got ")
                                (i64->str a (len (load type_args))))))
            (let [(mut i) 0
                  (mut err) (primitive/zeroed Diag)
                  (mut failed) false]
              (loop (if (>= (load i) np)
                        (break)
                        (do
                          (match (validate-generic-arg (elem type_args
                                                             (load i))
                                                cx
                                                tps)
                            (Err [d]
                                 (do
                                   (set! err
                                         (prefix-diag a
                                                      d
                                                      (sconcat3 a
                                                                "in '"
                                                                fname
                                                                "': type argument: ")))
                                   (set! failed true)
                                   (break)))
                            (Ok [_] 0))
                          (subst-insert! subst
                                         (get (load type_params) (load i))
                                         (elem type_args (load i)))
                          (set! i (primitive/iadd (load i) 1)))))
              (if (load failed)
                  (Err [(ptr (ArrayList SubstEntry)) Diag] (load err))
                  (Ok subst))))
        (let [(mut err) (primitive/zeroed Diag)
              (mut failed) false]
          ; The call's context is a weaker constraint than its arguments, and
          ; one whose arguments make it return never -- a pointer to a function
          ; that does not return -- takes no type from its context: it fits any.
          (when (and (expected-some? expected)
                     (not (returns-never-from-arguments? a type_params bounds declared
                                                         arglist ret_tmpl cx tps fname what)))
            (match (unify a ret_tmpl expected type_params subst fname)
              (Err [d] (do (store! err d) (store! failed true) 0))
              (Ok [_] 0)))
          (if (load failed)
              (Err [(ptr (ArrayList SubstEntry)) Diag] (load err))
              (let [nd (len (load declared))
                    na (len (load arglist))]
                ; A context-dependent argument such as an inline `fn` may fail its
                ; first synthesis pass and be deferred. Still use every other
                ; positional argument to infer its corresponding type parameters;
                ; those bindings are exactly what the deferred argument needs on
                ; the second pass. Previously one deferred argument discarded all
                ; independently known argument types.
                (if (= nd na)
                    ; Numeric literals are weak constraints. Infer from typed
                    ; operands first, independent of argument order, then use
                    ; literal defaults only for parameters still unconstrained.
                    ; Final coercion checks representability in the chosen type.
                    (for [pass 0 2]
                      (for [j 0 na]
                        (let [slot (elem arglist j)]
                          (when (load (field slot present))
                            (let [literal (is-literal (load (field slot e)))
                                  ; `(Some 5)`: a constructor of literals is as weak
                                  ; a constraint as the literal, and is checked
                                  ; again at the type the other arguments choose
                                  ; (`ca-resynth-weak-literals`).
                                  weak (and (not literal) (weak-literal-arg? cx (load (field slot e))))
                                  decl (elem declared j)
                                  applied (box-type a (subst-apply a decl subst))]
                              (when (and (= (or literal weak) (= pass 1))
                                         ; a literal lent to a `(ref T)` parameter is a
                                         ; weak constraint on T just the same
                                         (not (and literal (numeric (peel-refs applied) tps)))
                                         (not (and weak (type-params-bound? decl type_params subst))))
                                (match (unify a decl
                                              (arg-unify-type decl (load (field slot t))
                                                              (load (field slot e)) type_params)
                                              type_params subst fname)
                                  (Err [d] (do (store! err d) (store! failed true)))
                                  (Ok [_] 0))))))))
                    ; Variadic/type-pack calls retain their list-level inference.
                    ; They cannot align a partial argument list positionally until
                    ; the pack has been expanded.
                    (let [(mut actuals) (ArrayList::new [Type] a)
                          (mut literals) (ArrayList::new [bool] a)
                          (mut complete) true]
                      (for [j 0 na]
                        (let [slot (elem arglist j)]
                          (if (load (field slot present))
                              (do (push! (mut actuals)
                                         ; positions before a pack align with
                                         ; their parameters
                                         (load (if (and (< j nd)
                                                        (let [pi (list-pack-index declared)]
                                                          (or (< pi 0) (< j pi))))
                                                   (arg-unify-type (elem declared j)
                                                                   (load (field slot t))
                                                                   (load (field slot e))
                                                                   type_params)
                                                   (load (field slot t)))))
                                  (push! (mut literals) (is-literal (load (field slot e))))
                                  0)
                              (store! complete false))))
                      (when (load complete)
                        (match (unify-arg-list a
                                           declared
                                           (box-al [Type] a (load actuals))
                                           (box-al [bool] a (load literals))
                                           type_params
                                           subst
                                           fname)
                          (Err [d] (do (store! err d) (store! failed true)))
                          (Ok [_] 0)))))
                ; An array-typed binding for a bounded parameter borrows as a
                ; slice before anything reads the bound's impls.
                (unless (load failed)
                  (bounds-borrow-arrays! a cx bounds subst)
                  (bounds-borrow-pointers! a cx bounds declared subst))
                ; A supplied associated-type argument is also an inference equation.
                ; Once the bounded receiver is known, read the selected impl's
                ; associated type and unify it with the bound template.
                (unless (load failed)
                  (for [bi 0 (len (load bounds))]
                    (let [bp (elem bounds bi)
                          recv (subst-get subst (.name bp))]
                      (unless (= (primitive/cast i64 recv) 0)
                        (for [bti 0 (len (load (field bp traits)))]
                          (let [bt
                                  (elem (load (field bp traits))
                                        bti)
                                td (trait-find cx (.name bt))
                                sel (primitive/alloc-stack ImplSel)]
                            (set! sel (cx-impl-select a cx (.name bt) recv))
                            (let [ip (load (field sel ip))]
                              (unless (or (= (primitive/cast i64 td) 0)
                                          (= (primitive/cast i64 ip) 0))
                                (let [assoc
                                        (impl-associated-bindings a ip td)
                                      impl-binds (subst-new a)
                                      (mut actuals)
                                        (primitive/cast (ptr (ArrayList Type))
                                                        0)]
                                  (unify-trait-extras a
                                                      (field ip self_type)
                                                      recv
                                                      (load (field ip
                                                                   type_params))
                                                      impl-binds)
                                  (store! actuals
                                          (flatten-associated-types a
                                                                    td
                                                                    assoc
                                                                    impl-binds))
                                  (when (= (len (load (field bt args)))
                                           (len (load actuals)))
                                    (for [pi 0 (len (load actuals))]
                                      (match (unify a
                                                    (elem (load (field bt
                                                                       args))
                                                          pi)
                                                    (elem actuals pi)
                                                    type_params
                                                    subst
                                                    fname)
                                        (Err [d]
                                             (do
                                               (store! err d)
                                               (store! failed true)))
                                        (Ok [_] 0)))))))))))))
                (if (load failed)
                    (Err [(ptr (ArrayList SubstEntry)) Diag] (load err))
                    (let [(mut k) 0
                          (mut missing) false
                          (mut mp) ""]
                      (loop (if (>= (load k) np)
                                (break)
                                (do
                                  (let [pn (get (load type_params) (load k))]
                                    (when (not (subst-has subst pn))
                                      (store! missing true)
                                      (store! mp pn)
                                      (break)))
                                  (set! k (primitive/iadd (load k) 1)))))
                      (if (and (load missing) (not allow-missing))
                          (Err [(ptr (ArrayList SubstEntry)) Diag]
                               (match (argument-shape-mismatch a declared arglist (load mp) subst fname what)
                                 (Some [d] d)
                                 (None []
                                   (derr (sconcat a
                                              (sconcat a
                                                       (sconcat4 a
                                                                 "in '"
                                                                 fname
                                                                 "': cannot infer type argument '"
                                                                 (sconcat a
                                                                          (load mp)
                                                                          "' for '"))
                                                       (sconcat a
                                                                what
                                                                "'; provide it explicitly: ("))
                                              (sconcat a what " [<types>] ...)"))))))
                          (Ok subst))))))))))))

;;; When an argument whose parameter type mentions type parameter `p` left `p`
;;; unbound, its value has the wrong shape for the parameter -- a string for a
;;; `(ptr T)` -- and that mismatch, not the inference, is the error.
(defn argument-shape-mismatch [(a (dyn Allocator))
                               (declared (ptr (ArrayList Type)))
                               (arglist (ptr (ArrayList ArgSlot)))
                               (p (slice u8))
                               (subst (ptr (ArrayList SubstEntry)))
                               (fname (slice u8))
                               (what (slice u8))] (-> (Option Diag))
  (block :found
    (for [j 0 (if (< (len (load declared)) (len (load arglist))) (len (load declared)) (len (load arglist)))]
      (let [sl (elem arglist j)
            decl (elem declared j)]
        (when (and (.present sl) (type-mentions decl p))
          (let [applied (subst-apply a decl subst)
                want (box-type a (match applied
                                   (TRef [_ inner] (load inner))
                                   (_ applied)))]
            (match (coerce a (load (.e sl)) (.t sl) want false fname
                           (sconcat a (sconcat3 a "argument " (i64->str a (+ j 1)) " to '") (sconcat a what "'")))
              (Err [d] (break :found (Some d)))
              (Ok [_] 0))))))
    (None [Diag])))

; bit_field_type
(defn bit-field-type [(a (dyn Allocator))
                      (ptr (ptr Expr))
                      (field (slice u8))
                      (env (ptr (ArrayList EnvEntry)))
                      (cx (ptr Cx))
                      (tps (ptr (ArrayList (slice u8))))
                      (fname (slice u8))] (-> (Result SynPair Diag))
  (match (do-synth a ptr (null-type) env cx tps fname)
    (Err [d] (Err [SynPair Diag] d))
    (Ok [sp0]
        (let [sp (primitive/alloc-stack SynPair)]
          (set! sp sp0)
          (let [pt (load (field sp t))]
            (if (not (type-is-ptr pt))
                (Err [SynPair Diag]
                     (derr (sconcat a
                                    (sconcat3 a
                                              "in '"
                                              fname
                                              "': get/set! needs a pointer, got ")
                                    (ty-str a pt))))
                (let [pointee (t-inner pt)
                      s (struct-name pointee)
                      si (struct-find cx s)]
                  (if (and (is-struct-or-app pointee)
                           (and (!= (primitive/cast i64 si)
                                    0)
                                (.is_bits si)))
                      (try (let [fs
                                   (try-or! (struct-fields a pointee cx)
                                            (Err [SynPair Diag]
                                                 (derr (sconcat a
                                                                (sconcat a
                                                                         (sconcat5 a
                                                                                   "in '"
                                                                                   fname
                                                                                   "': bit struct '"
                                                                                   s
                                                                                   "' has no field '")
                                                                         field)
                                                                "'"))))]
                             (let [n (len (load fs))
                                   (mut i) 0
                                   (mut fty) (primitive/cast (ptr Type) 0)]
                               (loop (if (>= (load i) n)
                                         (break)
                                         (do
                                           (when (= (load (field (elem fs
                                                                       (load i))
                                                                 name))
                                                    field)
                                             (store! fty
                                                     (field (elem fs
                                                                  (load i))
                                                            ty))
                                             (break))
                                           (store! i
                                                   (primitive/iadd (load i) 1)))))
                               (if (= (primitive/cast i64 (load fty))
                                      0)
                                   (Err [SynPair Diag]
                                        (derr (sconcat a
                                                       (sconcat a
                                                                (sconcat5 a
                                                                          "in '"
                                                                          fname
                                                                          "': bit struct '"
                                                                          s
                                                                          "' has no field '")
                                                                field)
                                                       "'")))
                                   (Ok (mk-synpair a
                                                   (load (field sp e))
                                                   (load fty)))))))
                      (Err [SynPair Diag]
                           (derr (sconcat a
                                          (sconcat a
                                                   (sconcat3 a
                                                             "in '"
                                                             fname
                                                             "': get/set! needs a pointer to a (coil.layout.Bits) struct, got (ptr ")
                                                   (ty-str a pointee))
                                          ")")))))))))))

; check_quasi
(defn check-quasi [(a (dyn Allocator))
                   (qp (ptr Quasi))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))] (-> (Result Quasi Diag))
  (match (load qp)
    (QLit [form] (Ok [Quasi Diag] (QLit form)))
    (QUnquote [e]
              (match (do-synth a e (null-type) env cx tps fname)
                (Err [d] (Err [Quasi Diag] d))
                (Ok [sp0]
                    (let [sp (primitive/alloc-stack SynPair)]
                      (set! sp sp0)
                      (Ok (QUnquote (load (field sp
                                                 e))))))))
    (QSplice [e]
             (match (do-synth a e (null-type) env cx tps fname)
               (Err [d] (Err [Quasi Diag] d))
               (Ok [sp0]
                   (let [sp (primitive/alloc-stack SynPair)]
                     (set! sp sp0)
                     (Ok (QSplice (load (field sp
                                               e))))))))
    (QList [items]
           (match (check-quasi-list a items env cx tps fname)
             (Err [d] (Err [Quasi Diag] d))
             (Ok [nl] (Ok (QList nl)))))
    (QVector [items]
             (match (check-quasi-list a items env cx tps fname)
               (Err [d] (Err [Quasi Diag] d))
               (Ok [nl] (Ok (QVector nl)))))
    (_ (Ok [Quasi Diag] (load qp)))))

(defn check-quasi-list [(a (dyn Allocator))
                        (items (ptr (ArrayList Quasi)))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))] (-> (Result (ptr (ArrayList Quasi))
                                                        Diag))
  (let [n (len (load items))
        (mut out) (ArrayList::new [Quasi] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (check-quasi a
                                    (elem items (load i))
                                    env
                                    cx
                                    tps
                                    fname)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [q] (push! (mut out) q)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Quasi)) Diag] (load err))
        (Ok (box-al [Quasi] a (load out))))))

; ---- dyn / trait helpers ----------------------------------------------------
(defn dyn-struct-trait [(cx (ptr Cx)) (name (slice u8))] (-> (slice u8))
  (let [n (len name)]
    (if (< n 4)
        ""
        (let [base (subslice [u8] name 0 (primitive/isub n 4))
              suf (subslice [u8] name (primitive/isub n 4) n)]
          (if (and (= suf "-dyn")
                   (!= (primitive/cast i64 (trait-find cx base))
                       0))
              base
              "")))))

(defn is-dyn-target [(t (ptr Type)) (cx (ptr Cx))] (-> bool)
  (let [tg (type-tag t)]
    (if (= tg 6)
        (> (len (dyn-struct-trait cx (type-struct-name t)))
           0)
        (if (= tg 5)
            (let [inner (t-inner t)]
              (if (= (type-tag inner) 6)
                  (> (len (dyn-struct-trait cx (type-struct-name inner)))
                     0)
                  false))
            false))))

;;; NAME, a trait the resolver qualified, when it is one; "" when it names no
;;; trait.
(defn resolve-trait-name [(cx (ptr Cx)) (name (slice u8))] (-> (slice u8))
  (if (!= (primitive/cast i64 (trait-find cx name)) 0) name ""))

; Has the CALLER explicitly taken this trait method out of scope?
;
; Deliberately NOT the same question as `trait-visible` below, which only breaks ties
; between several traits declaring one method name. A method whose declaring trait is
; unique is callable today with no import at all, so the ABSENCE of an import cannot
; suppress it — only a deliberate statement can:
;
;   * `:exclude`/`:rename` naming the trait or the method, on any import; or
;   * an explicit `(import "coil.core" …)`, which states core's refer set in full and is
;     therefore authoritative — `:use [Eq]` really does mean "no Ord".
;
; This is the surface that makes `:exclude [<]` bite. Hiding the NAME in the resolver
; while leaving the trait method callable would be worse than not having the feature.
(defn method-suppressed? [(cx (ptr Cx))
                          (tr (slice u8))
                          (method (slice u8))
                          (caller (slice u8))
                          (has_caller bool)] (-> bool)
  (method-suppressed-in? (load (field cx imports)) (.a cx) tr method caller has_caller))

;;; `method-suppressed?` against the import table IMPORTS (null when there is
;;; none, which suppresses nothing).
(defn method-suppressed-in? [(imports (ptr (ArrayList ImpEntry)))
                             (a (dyn Allocator))
                             (tr (slice u8))
                             (method (slice u8))
                             (caller (slice u8))
                             (has_caller bool)] (-> bool)
  (if (or (not has_caller) (or (not (has-dot tr)) (= (primitive/cast i64 imports) 0)))
      false
      (let [tmod (subslice [u8] tr 0 (find-slash-dot tr))
            tname (after-last-dot tr)
            imp (imports-find imports caller)]
        (if (= tmod (implicit-prelude-name a))
            (if (or (core-drops? imp tname) (core-drops? imp method))
                true
                ; an explicit core import grants only what it names — referring the
                ; TRAIT brings its methods, and referring a method brings that one.
                (and (core-explicit? imp)
                     (and (opt-str-none? (core-refers imp tname))
                          (opt-str-none? (core-refers imp method)))))
            (let [up (use-for-target imp tmod)]
              (if (= (primitive/cast i64 up) 0)
                  false
                  (or (use-drops? up tname) (use-drops? up method))))))))

(defn opt-str-none? [(o (Option (slice u8)))] (-> bool)
  (match o (Some [_] false) (None [] true)))

; Was ANY trait declaring `func` dropped by this module's imports? Distinguishes
; "you excluded this" from "no trait in scope declares it", which need different advice.
(defn method-any-suppressed? [(cx (ptr Cx))
                              (func (slice u8))
                              (caller (slice u8))
                              (has_caller bool)] (-> bool)
  (let [ms (field cx methods)
        n (len (.methods cx))
        (mut i) 0
        (mut r) false]
    (loop (if (or (load r) (>= (load i) n))
              (break)
              (do
                (let [me (elem ms (load i))]
                  (when (and (= (load (field me name)) func)
                             (method-suppressed? cx
                                                 (load (field me trait))
                                                 func
                                                 caller
                                                 has_caller))
                    (store! r true)
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; The module whose import dropped it, for the message ("coil.core" for the prelude).
(defn method-suppressor [(a (dyn Allocator))
                         (cx (ptr Cx))
                         (func (slice u8))
                         (caller (slice u8))
                         (has_caller bool)] (-> (slice u8))
  (let [ms (field cx methods)
        n (len (.methods cx))
        (mut i) 0
        (mut r) "it"]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [me (elem ms (load i))
                      tr (.trait me)]
                  (when (and (= (load (field me name)) func)
                             (method-suppressed? cx tr func caller has_caller))
                    (store! r
                            (sconcat3 a
                                      "'"
                                      (subslice [u8] tr 0 (find-slash-dot tr))
                                      "'"))
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn trait-visible [(cx (ptr Cx))
                     (tr (slice u8))
                     (caller (slice u8))
                     (has_caller bool)] (-> bool)
  (if (not (has-dot tr))
      true
      (let [tmod (subslice [u8] tr 0 (find-slash-dot tr))
            tname (after-last-dot tr)]
        (if (or (= tmod (implicit-prelude-name (.a cx)))
                (and has_caller (= tmod caller)))
            true
            (if (not has_caller)
                false
                (let [imp (imports-find (load (field cx imports)) caller)]
                  (if (= (primitive/cast i64 imp) 0)
                      false
                      (let [uses (field (field imp imp) uses)
                            (mut vis) false]
                        (for [i 0 (len (load uses))]
                          (unless vis
                            (let [up (elem uses i)]
                              (match (trait-published-as cx (.target up) tmod tname 0)
                                (Some [published]
                                      (when (some? (use-local-of up published))
                                        (set! vis true)
                                        0))
                                (None [] 0)))
                            0)
                          0)
                        vis))))))))

;;; The name under which MODULE publishes the trait TNAME of TMOD: its own name when
;;; MODULE is TMOD, or the name a reexport edge passes it on by. A trait reached
;;; through a facade is in scope exactly as if it had been imported directly.
(defn trait-published-as [(cx (ptr Cx))
                          (module (slice u8))
                          (tmod (slice u8))
                          (tname (slice u8))
                          (depth i64)] (-> (Option (slice u8)))
  (block :found
    (when (>= depth 64) (return-from :found (None [(slice u8)])))
    (when (= module tmod)
      (return-from :found
                   (if (exports-check (load (field cx exports)) module tname)
                       (Some tname)
                       (None [(slice u8)]))))
    (let [ie (imports-find (load (field cx imports)) module)]
      (unless (= (primitive/cast i64 ie) 0)
        (let [edges (field (field ie imp) reexports)]
          (for [i 0 (len (load edges))]
            (let [edge (elem edges i)]
              (match (trait-published-as cx (.target edge) tmod tname (+ depth 1))
                (Some [inner]
                      (match (use-local-of edge inner)
                        (Some [local]
                              (when (exports-check (load (field cx exports)) module local)
                                (return-from :found (Some local))))
                        (None [] 0)))
                (None [] 0)))
            0))
        0))
    (None [(slice u8)])))

(defn find-slash-dot [(s (slice u8))] (-> i64)
  (let [n (len s)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) 0)
              (break)
              (do
                (when (= (primitive/cast i64 (get s (load i)))
                         46)
                  (store! at (load i))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (load at)))

; The recoverable-collision hint (gen-6): every trait declaring `func`, rendered as
; the qualified call `Trait::func` (Trait by display-name), joined with " or ". So a
; same-name collision is now fixable — `(A::go x)` names the trait explicitly — and the
; error stops telling you to `:use` a module (useless when the traits are your own).
(defn method-qual-suggestions [(a (dyn Allocator))
                               (cx (ptr Cx))
                               (func (slice u8))] (-> (slice u8))
  (let [ms (field cx methods)
        n (len (.methods cx))
        (mut i) 0
        (mut out) ""
        (mut first) true]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [me (elem ms (load i))]
                  (when (= (load (field me name)) func)
                    (let [q
                            (sconcat4 a
                                      "`"
                                      (display-name (load (field me trait)))
                                      "::"
                                      (sconcat a func "`"))]
                      (if (load first)
                          (do (store! out q) (store! first false) 0)
                          (do (store! out (sconcat3 a (load out) " or " q)) 0)))))
                (set! i (primitive/iadd (load i) 1)))))
    (load out)))

; Qualified `Trait::method` resolution (gen-6): pin the method to the named trait,
; bypassing in-scope ambiguity (an explicit trait name IS the disambiguation).
; Resolution has already turned `qual` into the trait's full name, from the caller's
; scope, so `A::go` and `app.A::go` both arrive as `app.A::go` and it is matched
; exactly; a trait the caller cannot name is not selected. An empty `qual` delegates
; to the ordinary in-scope resolution.
; A method call whose head was MODULE-qualified by macro hygiene (`coil.core.=`).
; The module names where the template was written, so it selects among traits that
; declare the method — the lexical-scope answer to "which `=` did the macro mean?".
;
; `mod` empty means no module qualifier, and this is exactly `resolve-method-qual`.
; A module that matches no candidate also falls back to the unqualified path rather
; than erroring: hygiene may qualify a name whose trait lives elsewhere (a re-export,
; or a method reached through an import), and being stricter there would reject
; working code to enforce a rule the programmer never wrote.
(defn resolve-method-mod [(a (dyn Allocator))
                          (cx (ptr Cx))
                          (func (slice u8))
                          (qual (slice u8))
                          (mod (slice u8))
                          (fname (slice u8))] (-> (Result MethodEntry Diag))
  (if (or (!= (len qual) 0)
          (= (len mod) 0))
      (resolve-method-qual a cx func qual fname)
      (let [ms (field cx methods)
            n (len (.methods cx))
            (mut i) 0
            (mut cnt) 0
            (mut only) (primitive/cast (ptr MethodEntry) 0)]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [me (elem ms (load i))]
                      (when (and (= (load (field me name)) func)
                                 (= (before-last-dot (load (field me trait)))
                                    mod))
                        (store! cnt (primitive/iadd (load cnt) 1))
                        (store! only me)
                        0))
                    (set! i (primitive/iadd (load i) 1)))))
        (if (= (load cnt) 1)
            (Ok (load (load only)))
            (resolve-method-qual a cx func qual fname)))))

;;; The trait method a call head spelled FUNC names for a caller in module CALLER,
;;; before any argument is looked at: the three head shapes `synth` accepts (bare,
;;; `Trait::m`, and hygiene's `module.m`), split as `synth` splits them and resolved
;;; by the same `resolve-method-mod`. None when FUNC names a function, or when no
;;; trait in scope declares it. A real call can still go elsewhere once its
;;; arguments are known — the arity-directed fallback, an inherent method of the
;;; receiver's type — so this answers for the name alone (`primitive/resolve-at`).
;;; The authored call E, written AUTHORED, dispatched to CHOSEN: answer its source
;;; occurrence with the declaration it reaches. A trait's method is named as the
;;; trait declares it (`coil.core.|`, as `resolve-at` answers), whichever impl was
;;; chosen; an inherent method by the function chosen. A name the resolver already
;;; qualified was answered there.
(defn source-dispatch-answer! [(a (dyn Allocator)) (cx (ptr Cx)) (e (ptr Expr))
                               (authored (slice u8)) (chosen (slice u8))] (-> i64)
  (when (and (.enabled (source-facts)) (none? (find authored ".")))
    (match (head-trait-method a cx authored (src-mod-lookup (.source e)))
      (Some [me] (source-expression-answer! e (sconcat3 a (before-last-dot (.trait me)) "." (.name me)) false))
      (None [] (source-expression-answer! e chosen false)))
    0)
  0)

(defn head-trait-method [(a (dyn Allocator))
                         (cx (ptr Cx))
                         (func (slice u8))
                         (caller (slice u8))] (-> (Option MethodEntry))
  (let [cc (find-coloncolon func)
        dotted-m (if (>= cc 0) "" (after-last-dot func))
        dotted? (and (< cc 0)
                     (and (!= (len dotted-m) (len func))
                          (and (methods-has cx dotted-m)
                               (= (primitive/cast i64 (sig-find cx func)) 0))))
        qual (if (>= cc 0) (subslice [u8] func 0 cc) "")
        mname (cond (>= cc 0) (subslice [u8] func (+ cc 2) (len func))
                    dotted? dotted-m
                    :else func)
        dotted-mod (if dotted? (subslice [u8] func 0 (- (len func) (+ (len dotted-m) 1))) "")]
    (if (not (methods-has cx mname))
        (None [MethodEntry])
        (let [prior (.caller_module cx)
              _caller (set! (.caller_module cx) caller)
              r (resolve-method-mod a cx mname qual dotted-mod (sconcat3 a caller "." "resolve-at"))]
          (set! (.caller_module cx) prior)
          (match r
            (Ok [me] (Some me))
            (Err [_] (None [MethodEntry])))))))

(defn resolve-method-qual [(a (dyn Allocator))
                           (cx (ptr Cx))
                           (func (slice u8))
                           (qual (slice u8))
                           (fname (slice u8))] (-> (Result MethodEntry
                                                           Diag))
  (if (= (len qual) 0)
      (resolve-method a cx func fname)
      (let [ms (field cx methods)
            n (len (.methods cx))
            (mut i) 0
            (mut cnt) 0
            (mut only) (primitive/cast (ptr MethodEntry) 0)]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [me (elem ms (load i))]
                      (when (and (= (load (field me name)) func)
                                 (= (load (field me trait)) qual))
                        (store! cnt (primitive/iadd (load cnt) 1))
                        (store! only me)
                        0))
                    (set! i (primitive/iadd (load i) 1)))))
        (if (= (load cnt) 1)
            (Ok (load (load only)))
            (if (= (load cnt) 0)
                (Err [MethodEntry Diag]
                     (derr (sconcat a
                                    (sconcat5 a
                                              "in '"
                                              fname
                                              "': no trait '"
                                              qual
                                              "' declares method '")
                                    (sconcat a func "'"))))
                (let [head
                        (sconcat a
                                 (sconcat5 a
                                           "in '"
                                           fname
                                           "': qualifier '"
                                           qual
                                           "' is ambiguous — ")
                                 (i64->str a (load cnt)))]
                  (Err [MethodEntry Diag]
                       (derr (sconcat3 a
                                       head
                                       " traits named '"
                                       (sconcat a
                                                qual
                                                "' declare this method; qualify with the module-prefixed trait name"))))))))))

; resolve_method — returns a chosen MethodEntry.
;;; The module `caller_module` names, when this context holds that module's
;;; import record, else "". A context checking code again without the program's
;;; import tables (mono's ownership context re-checks every constant) cannot
;;; apply a module's refer control, and reads the caller off the name as before.
(defn caller-module-known [(cx (ptr Cx))] (-> (slice u8))
  (let [m (.caller_module cx)
        imports (load (field cx imports))]
    (if (or (= (len m) 0)
            (or (= (primitive/cast i64 imports) 0)
                (= (primitive/cast i64 (imports-find imports m)) 0)))
        ""
        m)))

(defn resolve-method [(a (dyn Allocator))
                      (cx (ptr Cx))
                      (func (slice u8))
                      (fname (slice u8))] (-> (Result MethodEntry
                                                      Diag))
  (let [ms (field cx methods)
        n (len (.methods cx))
        ; `main` keeps its bare name, so fall back to the entry file's module for it —
        ; otherwise refer control silently stops applying inside `main`, which is where
        ; a small program keeps most of its code.
        entrym (.entry_module cx)
        given (caller-module-known cx)
        hc0 (or (> (len given) 0) (or (has-dot fname) (> (len entrym) 0)))
        caller0
          (cond (> (len given) 0) given
                (has-dot fname) (subslice [u8] fname 0 (find-slash-dot fname))
                :else entrym)
        (mut i) 0
        (mut cnt) 0
        (mut only) (primitive/cast (ptr MethodEntry) 0)]
    ; An explicitly excluded method is not a candidate at all — including when its trait
    ; is the only one declaring it, which is the case for every operator.
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [me (elem ms (load i))]
                  (when (and (= (load (field me name)) func)
                             (not (method-suppressed? cx
                                                      (load (field me trait))
                                                      func
                                                      caller0
                                                      hc0)))
                    (store! cnt (primitive/iadd (load cnt) 1))
                    (store! only me)
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (= (load cnt) 1)
        (Ok (load (load only)))
        (let [has_caller hc0
              caller caller0
              (mut j) 0
              (mut vcnt) 0
              (mut vonly) (primitive/cast (ptr MethodEntry) 0)]
          (loop (if (>= (load j) n)
                    (break)
                    (do
                      (let [me (elem ms (load j))]
                        (when (and (and (= (load (field me name)) func)
                                        (not (method-suppressed? cx
                                                                 (load (field me
                                                                              trait))
                                                                 func
                                                                 caller
                                                                 has_caller)))
                                   (trait-visible cx
                                                  (load (field me trait))
                                                  caller
                                                  has_caller))
                          (store! vcnt (primitive/iadd (load vcnt) 1))
                          (store! vonly me)
                          0))
                      (set! j (primitive/iadd (load j) 1)))))
          (if (= (load vcnt) 1)
              (Ok (load (load vonly)))
              (if (= (load vcnt) 0)
                  ; Every candidate the module deliberately dropped is reported as such.
                  ; Suggesting `Ord::<` to someone who just wrote `:exclude [<]` reads as
                  ; the compiler not having noticed.
                  (if (method-any-suppressed? cx func caller has_caller)
                      (Err [MethodEntry Diag]
                           (derr (sconcat a
                                          (sconcat4 a
                                                    "in '"
                                                    fname
                                                    "': trait method '"
                                                    (sconcat a
                                                             func
                                                             "' is not in scope — this module's import of "))
                                          (sconcat a
                                                   (method-suppressor a
                                                                      cx
                                                                      func
                                                                      caller
                                                                      has_caller)
                                                   " does not refer it. Add it to :use, drop it from :exclude/:rename, or call it qualified"))))
                      (Err [MethodEntry Diag]
                           (derr (sconcat a
                                          (sconcat a
                                                   (sconcat a
                                                            (sconcat4 a
                                                                      "in '"
                                                                      fname
                                                                      "': trait method '"
                                                                      (sconcat a
                                                                               func
                                                                               "' is declared in "))
                                                            (i64->str a
                                                                      (load cnt)))
                                                   " traits, none in scope here — call it qualified: ")
                                          (method-qual-suggestions a cx func)))))
                  (Err [MethodEntry Diag]
                       (derr (sconcat a
                                      (sconcat a
                                               (sconcat a
                                                        (sconcat4 a
                                                                  "in '"
                                                                  fname
                                                                  "': trait method '"
                                                                  (sconcat a
                                                                           func
                                                                           "' is ambiguous — "))
                                                        (i64->str a (load vcnt)))
                                               " in-scope traits declare it; call it qualified: ")
                                      (method-qual-suggestions a cx func))))))))))

;;; The bounds a generic body is checked under: each declared bound, with every
;;; supertrait its traits require, transitively. A `(T Pet)` bound carries `Animal`
;;; when `Pet` is declared `:requires [Animal]`, because every implementation of
;;; `Pet` is accompanied by one of `Animal` (check-supertraits enforces it), so the
;;; body may call `Animal`'s methods and pass `T` where `Animal` is required.
(defn bounds-with-supertraits [(a (dyn Allocator))
                               (cx (ptr Cx))
                               (bounds (ptr (ArrayList Bound)))] (-> (ArrayList Bound))
  (let [(mut out) (ArrayList::new [Bound] a)]
    (for [i 0 (len (load bounds))]
      (let [b (get (load bounds) i)
            (mut traits) (ArrayList::new [BoundTrait] a)]
        (unless (= (primitive/cast i64 (.traits b)) 0)
          (for [k 0 (len (load (.traits b)))]
            (push! (mut traits) (get (load (.traits b)) k)))
          0)
        ; a worklist: a supertrait appended here is expanded in its turn
        (let [(mut k) 0]
          (while (< k (len traits))
            (let [td (trait-find cx (.name (get traits k)))]
              (unless (= (primitive/cast i64 td) 0)
                (let [reqs (load (field td requires))]
                  (for [r 0 (len (load reqs))]
                    (let [req (get (load reqs) r)]
                      (unless (block :present
                                (for [j 0 (len traits)]
                                  (when (= (.name (get traits j)) req) (break :present true)))
                                false)
                        (push! (mut traits)
                               (BoundTrait :name req :args (box-al [Type] a (ArrayList::new [Type] a))))
                        0))))
                0))
            (set! k (+ k 1))))
        (push! (mut out)
               (Bound :name (.name b)
                      :traits (box-al [BoundTrait] a (load traits))
                      :value_type (.value_type b)))))
    out))

(defn bounds-has [(bounds (ptr (ArrayList Bound)))
                  (tp (slice u8))
                  (tr (slice u8))] (-> bool)
  (let [n (len (load bounds))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [bp (elem bounds (load i))]
                  (when (= (load (field bp name)) tp)
                    (let [trs (load (field bp traits))
                          m (len (load trs))
                          (mut k) 0]
                      (loop (if (>= (load k) m)
                                (break)
                                (do
                                  (when (= (.name (elem trs
                                                        (load k)))
                                           tr)
                                    (store! r
                                            true)
                                    (break))
                                  (store! k (primitive/iadd (load k) 1))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn bound-trait-find [(bounds (ptr (ArrayList Bound)))
                        (tp (slice u8))
                        (tr (slice u8))] (-> (ptr BoundTrait))
  (let [(mut found) (primitive/cast (ptr BoundTrait) 0)]
    (for [i 0 (len (load bounds))]
      (let [bp (elem bounds i)]
        (when (= (.name bp) tp)
          (for [j 0 (len (load (field bp traits)))]
            (let [bt (elem (load (field bp traits)) j)]
              (when (= (.name bt) tr)
                (set! found bt)))))))
    (load found)))

; build_make_dyn / dyn dispatch — not yet ported (hard error, never reached by
; non-dyn programs because maybe-coerce-dyn/is-dyn-target gate on a -dyn struct).
(defn dyn-method-names [(a (dyn Allocator))
                        (td (ptr TraitDef))
                        (tr (slice u8))
                        (tn (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [ms (load (field td methods))
        n (len (load ms))
        (mut out) (ArrayList::new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out)
                       (tmfn a
                             tr
                             tn
                             (.name (elem ms (load i)))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load out))))

(defn build-make-dyn [(a (dyn Allocator))
                      (cx (ptr Cx))
                      (trait_name (slice u8))
                      (inner (ptr Expr))
                      (inner_ty (ptr Type))
                      (lo i64)
                      (hi i64)
                      (src i64)
                      (ctxt i64)
                      (fname (slice u8))] (-> (Result SynPair Diag))
  (let [tr (resolve-trait-name cx trait_name)]
    (if (= (len tr) 0)
        (Err [SynPair Diag]
             (derr-at-src src
                          lo
                          hi
                          (sconcat1 a
                                    (sconcat4 a
                                              "in '"
                                              fname
                                              "': make-dyn: unknown trait '"
                                              (sconcat a
                                                       trait_name
                                                       (with-removed-hint a
                                                                          "'"
                                                                          (fn-unknown-hint a cx fname trait_name)))))))
        (if (not (type-is-ptr inner_ty))
            (Err [SynPair Diag]
                 (derr-at-src src
                              lo
                              hi
                              (sconcat a
                                       (sconcat3 a
                                                 "in '"
                                                 fname
                                                 "': make-dyn expects a pointer to an implementer, got ")
                                       (ty-str a inner_ty))))
            (let [pointee (t-inner inner_ty)]
              (if (not (has-impl-name a pointee))
                  (Err [SynPair Diag]
                       (derr-at-src src
                                    lo
                                    hi
                                    (sconcat a
                                             (sconcat a
                                                      (sconcat4 a
                                                                "in '"
                                                                fname
                                                                "': make-dyn: "
                                                                (ty-str a
                                                                        pointee))
                                                      " cannot implement a trait")
                                             "")))
                  ; the vtable must point at the SELECTED impl's functions — a specialized
                  ; impl on the pointee has a decorated name, so the bare key would name a
                  ; function that doesn't exist
                  (let [sel (primitive/alloc-stack ImplSel)]
                    (set! sel (cx-impl-select a cx tr pointee))
                    (if (= (primitive/cast i64 (load (field sel ip)))
                           0)
                        (Err [SynPair Diag]
                             (derr-at-src src
                                          lo
                                          hi
                                          (sconcat a
                                                   (sconcat a
                                                            (sconcat a
                                                                     (sconcat5 a
                                                                               "in '"
                                                                               fname
                                                                               "': '"
                                                                               (ty-str a
                                                                                       pointee)
                                                                               "' does not implement '")
                                                                     (display-name tr))
                                                            "' (needed for (dyn ")
                                                   (sconcat a
                                                            (display-name tr)
                                                            "))"))))
                        (if (.ambiguous sel)
                            (Err [SynPair Diag]
                                 (derr-at-src src
                                              lo
                                              hi
                                              (sconcat a
                                                       (sconcat a
                                                                (sconcat5 a
                                                                          "in '"
                                                                          fname
                                                                          "': ambiguous impls of '"
                                                                          (display-name tr)
                                                                          "' for '")
                                                                (ty-str a
                                                                        pointee))
                                                       "' — several match and none is more specific")))
                            (let [dyn_struct (sconcat a tr "-dyn")
                                  vtable_struct (sconcat a tr "-vtable")]
                              (if (= (primitive/cast i64
                                                     (struct-find cx dyn_struct))
                                     0)
                                  (Err [SynPair Diag]
                                       (derr-at-src src
                                                    lo
                                                    hi
                                                    (sconcat a
                                                             (sconcat a
                                                                      (sconcat5 a
                                                                                "in '"
                                                                                fname
                                                                                "': trait '"
                                                                                (display-name tr)
                                                                                "' has no trait object — call (defdyn ")
                                                                      (display-name tr))
                                                             ") after the trait")))
                                  (let [ipp (load (field sel ip))]
                                    ; A GENERIC impl's methods are generic functions: the vtable would
                                    ; have to reference a per-instantiation mangled name (e.g. Box__i64),
                                    ; but the trait object erases the concrete type and mono only
                                    ; instantiates via direct trait calls — so the vtable ends up naming
                                    ; the un-instantiated `Trait$Box$method`, which codegen can't resolve
                                    ; (it used to SIGABRT there). Reject it here, located, until dyn
                                    ; coercion learns to monomorphize the vtable.
                                    (if (> (len (load (field ipp type_params)))
                                           0)
                                        (Err [SynPair Diag]
                                             (derr-at-src src
                                                          lo
                                                          hi
                                                          (sconcat a
                                                                   (sconcat a
                                                                            (sconcat5 a
                                                                                      "in '"
                                                                                      fname
                                                                                      "': cannot make a trait object of '"
                                                                                      (ty-str a
                                                                                              pointee)
                                                                                      "': its impl of '")
                                                                            (display-name tr))
                                                                   "' is generic, and a (dyn Trait) vtable needs a concrete impl; erase a fully-concrete type instead")))
                                        (let [td (trait-find cx tr)
                                              methods
                                                (dyn-method-names a
                                                                  td
                                                                  tr
                                                                  (impl-mangle-key a
                                                                                   (field ipp
                                                                                          self_type)
                                                                                   (load (field ipp
                                                                                                type_params))))]
                                          (Ok (mk-synpair a
                                                          (box-expr a
                                                                    (mk-expr (EMakeDyn
                                                                               :dyn_struct
                                                                                 dyn_struct
                                                                               :vtable_struct
                                                                                 vtable_struct
                                                                               :methods
                                                                                 methods
                                                                               :inner
                                                                                 inner)
                                                                             lo
                                                                             hi
                                                                             src
                                                                             ctxt))
                                                          (box-type a
                                                                    (TStruct dyn_struct))))))))))))))))))

(defn maybe-coerce-dyn [(a (dyn Allocator))
                        (cx (ptr Cx))
                        (ae (ptr Expr))
                        (at (ptr Type))
                        (want (ptr Type))
                        (lo i64)
                        (hi i64)
                        (src i64)
                        (ctxt i64)
                        (fname (slice u8))] (-> (Result SynPair Diag))
  (let [wtg (type-tag want)
        wdname
          (if (= wtg 6)
              (type-struct-name want)
              (if (and (= wtg 5)
                       (= (type-tag (t-inner want)) 6))
                  (type-struct-name (t-inner want))
                  ""))]
    (if (= (len wdname) 0)
        (Ok (mk-synpair a ae at))
        (let [tr (dyn-struct-trait cx wdname)
              at-tag (type-tag at)
              is-self-dyn (and (or (= at-tag 4)
                                   (= at-tag 5))
                               (and (= (type-tag (t-inner at)) 6)
                                    (= (type-struct-name (t-inner at)) wdname)))]
          (cond (or (= (len tr) 0) is-self-dyn)
                  (Ok (mk-synpair a ae at))
                (type-is-ptr at)
                  (build-make-dyn a cx tr ae at lo hi src ctxt fname)
                ; A mutable borrow of a place is the same address a pointer would
                ; be, so `(mut local)` erases to a trait object too. The methods
                ; receive `(ptr Self)` and may write through it, which is why an
                ; immutable borrow does not.
                (= at-tag 5)
                  (match (load at)
                    (TRef [mutable pointee]
                          (if mutable
                              (build-make-dyn a cx tr ae (box-type a (TPtr pointee)) lo hi src ctxt fname)
                              (Err [SynPair Diag]
                                   (derr-at-src src
                                                lo
                                                hi
                                                (sconcat a
                                                         (sconcat5 a
                                                                   "in '"
                                                                   fname
                                                                   "': a (dyn "
                                                                   (display-name tr)
                                                                   ") can write through its receiver, so it needs a mutable borrow: pass (mut …) instead of ")
                                                         (ty-str a at))))))
                    (_ (Ok (mk-synpair a ae at))))
                :else (Ok (mk-synpair a ae at)))))))

; synth_construct
(defn variant-in-sum [(si (ptr SumInfo)) (variant (slice u8))] (-> (ptr Variant))
  (let [vs (load (field si variants))
        n (len (load vs))
        (mut i) 0
        (mut r) (primitive/cast (ptr Variant) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem vs (load i)) name))
                         variant)
                  (store! r (elem vs (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn field-types-of [(a (dyn Allocator)) (v (ptr Variant))] (-> (ptr (ArrayList Type)))
  (let [fs (load (field v fields))
        n (len (load fs))
        (mut out) (ArrayList::new [Type] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out) (.ty (elem fs (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn all-tparams-bound [(tparams (ptr (ArrayList (slice u8))))
                         (subst (ptr (ArrayList SubstEntry)))] (-> bool)
  (let [n (len (load tparams))
        (mut i) 0
        (mut all) true]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (not (subst-has subst (get (load tparams) (load i))))
                  (store! all
                          false)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load all)))

(defn synth-construct [(a (dyn Allocator))
                       (variant (slice u8))
                       (written-type-args (ptr (ArrayList Type)))
                       (args (ptr (ArrayList Expr)))
                       (expected (ptr Type))
                       (env (ptr (ArrayList EnvEntry)))
                       (cx (ptr Cx))
                       (tps (ptr (ArrayList (slice u8))))
                       (fname (slice u8))
                       (lo i64)
                       (hi i64)
                       (src i64)
                       (ctxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [type_args (try! (explicit-type-args a cx written-type-args fname))
               sumname (load (field (vts-find cx variant) sum))
               si (sum-find cx (load (field (vts-find cx variant) sum)))
               v (variant-in-sum si variant)]
           (when (not (= (len (load (field v fields))) (len (load args))))
             (break :try
                      (err-ep (derr (sconcat a
                                             (sconcat a
                                                      (sconcat a
                                                               (sconcat4 a
                                                                         "in '"
                                                                         fname
                                                                         "': variant '"
                                                                         (sconcat a
                                                                                  variant
                                                                                  "' takes "))
                                                               (i64->str a
                                                                         (len (load (field v
                                                                                           fields)))))
                                                      " field(s), got ")
                                             (i64->str a (len (load args))))))))
           (let [tparams (load (field si type_params))
                 field_types (field-types-of a v)
                 subst (subst-new a)
                 np (len (load tparams))]
             (if (> (len (load type_args)) 0)
                 (do
                   (when (not (= (len (load type_args)) np))
                     (break :try
                              (err-ep (derr (sconcat a
                                                     (sconcat a
                                                              (sconcat a
                                                                       (sconcat4 a
                                                                                 "in '"
                                                                                 fname
                                                                                 "': '"
                                                                                 (sconcat a
                                                                                          variant
                                                                                          "' expects "))
                                                                       (i64->str a
                                                                                 np))
                                                              " type arguments, got ")
                                                     (i64->str a
                                                               (len (load type_args))))))))
                   (try! (validate-targs a cx type_args tps fname))
                   (build-subst! subst tparams type_args))
                 (when (expected-some? expected)
                   (let [to (alloc-stack-store-targs a expected sumname np)]
                     (when (load (field to found))
                       (build-subst! subst
                                     tparams
                                     (load (field to
                                                  targs)))))))
             (let [new_args
                     (if (all-tparams-bound tparams subst)
                         (try! (construct-check-args a
                                                     field_types
                                                     args
                                                     subst
                                                     variant
                                                     env
                                                     cx
                                                     tps
                                                     fname))
                         (try! (construct-infer-args a
                                                     field_types
                                                     args
                                                     subst
                                                     tparams
                                                     variant
                                                     env
                                                     cx
                                                     tps
                                                     fname)))]
               (if (= np 0)
                   (ok-ep (mk-expr (ECall
                                     :func variant
                                     :type_args (box-items-type a)
                                     :args new_args)
                                   lo
                                   hi
                                   src
                                   ctxt)
                          (TStruct sumname))
                   (let [out_targs (subst-targs a tparams subst)]
                     (ok-ep (mk-expr (ECall
                                       :func variant
                                       :type_args out_targs
                                       :args new_args)
                                     lo
                                     hi
                                     src
                                     ctxt)
                            (TApp sumname out_targs))))))))))

; Validate and reorder `:field value` constructor arguments to declaration order.
; The resolved variant owns the authoritative field list for both structs and sums.
(defn named-constructor-args [(a (dyn Allocator))
                              (variant (slice u8))
                              (fields (ptr (ArrayList Field)))
                              (names (ptr (ArrayList (slice u8))))
                              (args (ptr (ArrayList Expr)))] (-> (Result (ptr (ArrayList Expr))
                                                                         Diag))
  (try (let [nn (len (load names))
             nf (len (load fields))]
         (when (not (= nn (len (load args))))
           (break :try
                    (Err [(ptr (ArrayList Expr)) Diag]
                         (derr "internal: named constructor name/value count mismatch"))))
         (let [(mut i) 0]
           (loop (if (>= (load i) nn)
                     (break)
                     (do
                       (let [name (get (load names) (load i))
                             (mut known) false
                             (mut j) 0]
                         (loop (if (>= (load j) nf)
                                   (break)
                                   (do
                                     (when (= name
                                              (load (field (elem fields
                                                                 (load j))
                                                           name)))
                                       (store! known true)
                                       (break))
                                     (store! j (primitive/iadd (load j) 1)))))
                         (when (not (load known))
                           (break :try
                                    (Err [(ptr (ArrayList Expr)) Diag]
                                         (derr (sconcat a
                                                        (sconcat3 a
                                                                  "constructor '"
                                                                  variant
                                                                  "' has no field :")
                                                        name)))))
                         (let [(mut k) 0]
                           (loop (if (>= (load k) (load i))
                                     (break)
                                     (do
                                       (when (= name
                                                (get (load names) (load k)))
                                         (break :try
                                                  (Err [(ptr (ArrayList Expr))
                                                        Diag]
                                                       (derr (sconcat a
                                                                      (sconcat3 a
                                                                                "constructor '"
                                                                                variant
                                                                                "' repeats field :")
                                                                      name)))))
                                       (store! k (primitive/iadd (load k) 1)))))))
                       (store! i (primitive/iadd (load i) 1))))))
         (let [(mut out) (ArrayList::new [Expr] a)
               (mut fi) 0]
           (loop (if (>= (load fi) nf)
                     (break)
                     (let [field-name
                             (load (field (elem fields (load fi))
                                          name))
                           (mut found) -1
                           (mut ai) 0]
                       (loop (if (>= (load ai) nn)
                                 (break)
                                 (do
                                   (when (= field-name
                                            (get (load names) (load ai)))
                                     (store! found (load ai))
                                     (break))
                                   (store! ai (primitive/iadd (load ai) 1)))))
                       (when (< (load found) 0)
                         (break :try
                                  (Err [(ptr (ArrayList Expr)) Diag]
                                       (derr (sconcat a
                                                      (sconcat3 a
                                                                "constructor '"
                                                                variant
                                                                "' is missing field :")
                                                      field-name)))))
                       (push! (mut out) (get (load args) (load found)))
                       (store! fi (primitive/iadd (load fi) 1)))))
           (Ok (box-al [Expr] a (load out)))))))

; Validate function argument names and return the expressions in parameter order.
; Extern and variadic signatures deliberately have no usable name list.
(defn named-function-args [(a (dyn Allocator))
                           (func (slice u8))
                           (params (ptr (ArrayList (slice u8))))
                           (names (ptr (ArrayList (slice u8))))
                           (args (ptr (ArrayList Expr)))] (-> (Result (ptr (ArrayList Expr))
                                                                      Diag))
  (try (let [nn (len (load names))
             np (len (load params))]
         (when (not (= nn (len (load args))))
           (break :try
                    (Err [(ptr (ArrayList Expr)) Diag]
                         (derr "internal: named function name/value count mismatch"))))
         (let [(mut i) 0]
           (loop (if (>= (load i) nn)
                     (break)
                     (do
                       (let [name (get (load names) (load i))]
                         (when (< (name-index params name)
                                  0)
                           (break :try
                                    (Err [(ptr (ArrayList Expr)) Diag]
                                         (derr (sconcat a
                                                        (sconcat3 a
                                                                  "function '"
                                                                  func
                                                                  "' has no parameter :")
                                                        name)))))
                         (let [(mut k) 0]
                           (loop (if (>= (load k) (load i))
                                     (break)
                                     (do
                                       (when (= name
                                                (get (load names) (load k)))
                                         (break :try
                                                  (Err [(ptr (ArrayList Expr))
                                                        Diag]
                                                       (derr (sconcat a
                                                                      (sconcat3 a
                                                                                "function '"
                                                                                func
                                                                                "' repeats parameter :")
                                                                      name)))))
                                       (store! k (primitive/iadd (load k) 1)))))))
                       (store! i (primitive/iadd (load i) 1))))))
         (let [(mut out) (ArrayList::new [Expr] a)
               (mut pi) 0]
           (loop (if (>= (load pi) np)
                     (break)
                     (let [pname (get (load params) (load pi))
                           ai (name-index names pname)]
                       (when (= (len pname) 0)
                         (break :try
                                  (Err [(ptr (ArrayList Expr)) Diag]
                                       (derr (sconcat3 a
                                                       "function '"
                                                       func
                                                       "' has a positional-only parameter, so it cannot be called with named arguments")))))
                       (when (< ai 0)
                         (break :try
                                  (Err [(ptr (ArrayList Expr)) Diag]
                                       (derr (sconcat a
                                                      (sconcat3 a
                                                                "function '"
                                                                func
                                                                "' is missing parameter :")
                                                      pname)))))
                       (push! (mut out) (get (load args) ai))
                       (store! pi (primitive/iadd (load pi) 1)))))
           (Ok (box-al [Expr] a (load out)))))))

;;; Does evaluating each of `es` neither do anything nor depend on when it is
;;; done, so that their order cannot be observed?
(defn all-effect-free? [(cx (ptr Cx)) (es (ptr (ArrayList Expr)))] (-> bool)
  (block :found
    (for [i 0 (len (load es))]
      (unless (effect-free? cx (elem es i)) (break :found false)))
    true))

(defn effect-free? [(cx (ptr Cx)) (e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EInt [_] true)
    (EFloat [_] true)
    (EBool [_] true)
    (EStr [_] true)
    (ECStr [_] true)
    (EFnPtrOf [_] true)
    (EFnPtrInst [_ _] true)
    (EZeroed [_] true)
    (ERecordInit [_] true)
    (ESizeOf [_] true)
    (EAlignOf [_] true)
    (EOffsetOf [_ _] true)
    (EComptime [_] true)
    (EConstruct [_ _ args] (all-effect-free? cx args))
    ; a variant's constructor, which checking leaves a call
    (ECall [func _ args]
           (and (!= (primitive/cast i64 (vts-find cx func)) 0) (all-effect-free? cx args)))
    (ECast [_ inner] (effect-free? cx inner))
    (_ false)))

(defn named-temp-name [(a (dyn Allocator)) (lo i64) (i i64)] (-> (slice u8))
  (sconcat3 a "$named-arg." (i64->str a lo) (sconcat a "." (i64->str a i))))

(defn named-temp-name? [(name (slice u8))] (-> bool)
  (and (>= (len name) 11) (= (subslice name 0 11) "$named-arg.")))

(defn named-same-order? [(decl-names (ptr (ArrayList (slice u8))))
                         (source-names (ptr (ArrayList (slice u8))))
                         (i i64)
                         (n i64)] (-> bool)
  (if (>= i n)
      true
      (if (= (get (load decl-names) i)
             (get (load source-names) i))
          (named-same-order? decl-names source-names (+ i 1) n)
          false)))

; The checked expressions arrive in declaration order. Bind them in the order in
; which their names occurred at the call site, then expose variables in declaration
; order for the ABI-level positional call or constructor lowering.
(defn named-source-binds [(a (dyn Allocator))
                          (decl-names (ptr (ArrayList (slice u8))))
                          (source-names (ptr (ArrayList (slice u8))))
                          (checked (ptr (ArrayList Expr)))
                          (lo i64)] (-> (ptr (ArrayList Bind)))
  (let [(mut out) (ArrayList::new [Bind] a)
        n (len (load source-names))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [di
                      (name-index decl-names (get (load source-names) (load i)))]
                (push! (mut out)
                       (mk-bind (named-temp-name a lo (load i))
                                false
                                (get (load checked) di)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Bind] a (load out))))

(defn named-decl-vars [(a (dyn Allocator))
                       (decl-names (ptr (ArrayList (slice u8))))
                       (source-names (ptr (ArrayList (slice u8))))
                       (lo i64)
                       (hi i64)
                       (src i64)
                       (ctxt i64)] (-> (ptr (ArrayList Expr)))
  (let [(mut out) (ArrayList::new [Expr] a)
        n (len (load decl-names))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [si
                      (name-index source-names (get (load decl-names) (load i)))]
                (push! (mut out)
                       (mk-expr (EVar (named-temp-name a lo si)) lo hi src ctxt))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Expr] a (load out))))

(defn field-types [(a (dyn Allocator)) (fields (ptr (ArrayList Field)))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (ArrayList::new [Type] a)
        n (len (load fields))
        (mut i) 0]
    (reserve! (mut out) n)
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out) (.ty (elem fields (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn field-names [(a (dyn Allocator)) (fields (ptr (ArrayList Field)))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (ArrayList::new [(slice u8)] a)
        n (len (load fields))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out) (.name (elem fields (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load out))))

; Materialize a struct constructor as ordinary checked language operations: one
; zeroed aggregate place followed by a typed store into every field. This keeps a
; single layout/codegen path for structs instead of teaching every backend a
; second aggregate representation.
(defn struct-constructor-source [(a (dyn Allocator))
                                 (ty Type)
                                 (fields (ptr (ArrayList Field)))
                                 (args (ptr (ArrayList Expr)))
                                 (lo i64)
                                 (hi i64)
                                 (src i64)
                                 (ctxt i64)] (-> Expr)
  (let [tmp (sconcat a "$named-ctor." (i64->str a lo))
        (mut binds) (ArrayList::new [Bind] a)
        (mut body) (ArrayList::new [Expr] a)
        n (len (load fields))
        (mut i) 0]
    (push! (mut binds) (mk-bind tmp true (mk-expr (ERecordInit ty) lo hi src ctxt)))
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut body)
                       (mk-expr (EInitStore (box-expr a
                                                      (mk-expr (EField (box-expr a
                                                                                 (mk-expr (EVar tmp)
                                                                                          lo
                                                                                          hi
                                                                                          src
                                                                                          ctxt))
                                                                       (.name (elem fields
                                                                                    (load i))))
                                                               lo
                                                               hi
                                                               src
                                                               ctxt))
                                            (box-expr a
                                                      (get (load args) (load i))))
                                lo
                                hi
                                src
                                ctxt))
                (set! i (primitive/iadd (load i) 1)))))
    (push! (mut body) (mk-expr (EVar tmp) lo hi src ctxt))
    (mk-expr (ELet (box-al [Bind] a (load binds)) (box-al [Expr] a (load body)))
             lo
             hi
             src
             ctxt)))

(defn synth-named-struct [(a (dyn Allocator))
                          (name (slice u8))
                          (st (ptr StructInfo))
                          (type-args (ptr (ArrayList Type)))
                          (source-names (ptr (ArrayList (slice u8))))
                          (args (ptr (ArrayList Expr)))
                          (expected (ptr Type))
                          (env (ptr (ArrayList EnvEntry)))
                          (cx (ptr Cx))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))
                          (lo i64)
                          (hi i64)
                          (src i64)
                          (ctxt i64)] (-> (Result EvalPair Diag))
  (try (let [type-args (try! (explicit-type-args a cx type-args fname))
             params (load (field st type_params))
             fields (load (field st fields))
             ftypes (field-types a fields)
             subst (subst-new a)
             np (len (load params))
             mark (type-map-mark)]
         (if (> (len (load type-args)) 0)
             (do
               (when (not (= (len (load type-args)) np))
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat3 a
                                                           "in '"
                                                           fname
                                                           "': wrong number of type arguments for struct '")
                                                 (sconcat a name "'"))))))
               (try! (validate-targs a cx type-args tps fname))
               (build-subst! subst params type-args))
             (when (expected-some? expected)
               (let [to (alloc-stack-store-targs a expected name np)]
                 (when (load (field to found))
                   (build-subst! subst params (load (field to targs)))))))
         (let [checked
                 (if (all-tparams-bound params subst)
                     (try! (construct-check-args a
                                                 ftypes
                                                 args
                                                 subst
                                                 name
                                                 env
                                                 cx
                                                 tps
                                                 fname))
                     (try! (construct-infer-args a
                                                 ftypes
                                                 args
                                                 subst
                                                 params
                                                 name
                                                 env
                                                 cx
                                                 tps
                                                 fname)))
               out-args
                 (if (= np 0)
                     (box-items-type a)
                     (subst-targs a params subst))
               out-ty
                 (if (= np 0)
                     (TStruct name)
                     (TApp name out-args))
               decl-names (field-names a fields)]
           ; Arguments that do nothing when evaluated may as well be evaluated in
           ; declaration order, which leaves a constant constructor in the shape
           ; a static's initializer is laid out from.
           (if (or (named-same-order? decl-names
                                      source-names
                                      0
                                      (len (load decl-names)))
                   (all-effect-free? cx checked))
               (let [source
                       (struct-constructor-source a
                                                  out-ty
                                                  fields
                                                  checked
                                                  lo
                                                  hi
                                                  src
                                                  ctxt)]
                 (synth-rechecked a source mark expected env cx tps fname))
               (let [binds
                       (named-source-binds a decl-names source-names checked lo)
                     vars
                       (named-decl-vars a
                                        decl-names
                                        source-names
                                        lo
                                        hi
                                        src
                                        ctxt)
                     inner
                       (struct-constructor-source a
                                                  out-ty
                                                  fields
                                                  vars
                                                  lo
                                                  hi
                                                  src
                                                  ctxt)
                     (mut body) (ArrayList::new [Expr] a)]
                 (push! (mut body) inner)
                 (let [source
                         (mk-expr (ELet binds (box-al [Expr] a (load body)))
                                  lo
                                  hi
                                  src
                                  ctxt)]
                   (synth-rechecked a source mark expected env cx tps fname))))))))

(defn synth-named-construct [(a (dyn Allocator))
                             (variant (slice u8))
                             (type-args (ptr (ArrayList Type)))
                             (names (ptr (ArrayList (slice u8))))
                             (args (ptr (ArrayList Expr)))
                             (expected (ptr Type))
                             (env (ptr (ArrayList EnvEntry)))
                             (cx (ptr Cx))
                             (tps (ptr (ArrayList (slice u8))))
                             (fname (slice u8))
                             (lo i64)
                             (hi i64)
                             (src i64)
                             (ctxt i64)] (-> (Result EvalPair Diag))
  (try (let [vt (vts-find cx variant)
             st (struct-find cx variant)]
         (if (!= (primitive/cast i64 vt) 0)
             (let [si (sum-find cx (load (field vt sum)))
                   v (variant-in-sum si variant)
                   fields (load (field v fields))
                   ordered
                     (try! (named-constructor-args a variant fields names args))
                   mark (type-map-mark)
                   ep
                     (try! (synth-construct a
                                            variant
                                            type-args
                                            ordered
                                            expected
                                            env
                                            cx
                                            tps
                                            fname
                                            lo
                                            hi
                                            src
                                            ctxt))]
               (source-order-named-call a
                                        (field-names a fields)
                                        names
                                        ep
                                        mark
                                        expected
                                        env
                                        cx
                                        tps
                                        fname
                                        lo
                                        hi
                                        src
                                        ctxt))
             (if (!= (primitive/cast i64 st) 0)
                 (let [ordered
                         (try! (named-constructor-args a
                                                       variant
                                                       (load (field st fields))
                                                       names
                                                       args))]
                   (synth-named-struct a
                                       variant
                                       st
                                       type-args
                                       names
                                       ordered
                                       expected
                                       env
                                       cx
                                       tps
                                       fname
                                       lo
                                       hi
                                       src
                                       ctxt))
                 (err-ep (derr (sconcat a
                                        (sconcat3 a
                                                  "in '"
                                                  fname
                                                  "': named arguments require a struct or sum constructor; '")
                                        (with-removed-hint a
                                                           (sconcat a variant "' is not one")
                                                           (fn-unknown-hint a cx fname variant))))))))))

;;; Synthesize `source`, built around arguments that were already checked from
;;; type-map position `mark` on. Checking them again records the types of their
;;; checked forms under the source nodes' ids -- a `(mut x)` local written through
;;; reads as a pointer -- so the records of their first check are made current
;;; again: `(primitive/type-of NODE)` answers what it does for the same code
;;; anywhere else.
(defn synth-rechecked [(a (dyn Allocator))
                       (source Expr)
                       (mark i64)
                       (expected (ptr Type))
                       (env (ptr (ArrayList EnvEntry)))
                       (cx (ptr Cx))
                       (tps (ptr (ArrayList (slice u8))))
                       (fname (slice u8))] (-> (Result EvalPair Diag))
  (let [checked-end (type-map-mark)
        result (synth a (box-expr a source) expected env cx tps fname)]
    (type-map-reinstate! mark checked-end)
    result))

; Replace the declaration-ordered checked arguments with temporaries whose
; initializers occur in source order. The inner call remains positional, so every
; later compiler phase and every calling convention stays unchanged.
(defn source-order-named-call [(a (dyn Allocator))
                               (decl-names (ptr (ArrayList (slice u8))))
                               (source-names (ptr (ArrayList (slice u8))))
                               (ep EvalPair)
                               (mark i64)
                               (expected (ptr Type))
                               (env (ptr (ArrayList EnvEntry)))
                               (cx (ptr Cx))
                               (tps (ptr (ArrayList (slice u8))))
                               (fname (slice u8))
                               (lo i64)
                               (hi i64)
                               (src i64)
                               (ctxt i64)] (-> (Result EvalPair Diag))
  (if (named-same-order? decl-names source-names 0 (len (load decl-names)))
      (Ok [EvalPair Diag] ep)
      (match (.kind (.e ep))
        (ECall [func targs checked]
               (let [binds
                       (named-source-binds a decl-names source-names checked lo)
                     vars
                       (named-decl-vars a
                                        decl-names
                                        source-names
                                        lo
                                        hi
                                        src
                                        ctxt)
                     inner
                       (mk-expr (ECall
                                  :func func
                                  :type_args targs
                                  :args vars)
                                lo
                                hi
                                src
                                ctxt)
                     (mut body) (ArrayList::new [Expr] a)]
                 (push! (mut body) inner)
                 (let [source
                         (mk-expr (ELet binds (box-al [Expr] a (load body)))
                                  lo
                                  hi
                                  src
                                  ctxt)]
                   (synth-rechecked a source mark expected env cx tps fname))))
        (_ (err-ep (derr "internal: named call did not lower to a direct call"))))))

;;; The names a global `def`'s `:params` annotation declares for `name`, unless
;;; a local of that name shadows it or the def has no `:params`.
(defn declared-param-names [(cx (ptr Cx))
                            (env (ptr (ArrayList EnvEntry)))
                            (name (slice u8))] (-> (Option (ptr (ArrayList (slice u8)))))
  (let [ce (const-find cx name)]
    (if (or (!= (primitive/cast i64 (env-get env name)) 0)
            (= (primitive/cast i64 ce) 0))
        (None [(ptr (ArrayList (slice u8)))])
        (.param_names ce))))

;;; A named call on a `def` annotated with `:params`. The value has
;;; no signature to order checked arguments against, so the reordering happens
;;; on source: the call becomes the positional call a caller would have written,
;;; with source-order temporaries when the order differs, and that call takes
;;; the ordinary callable-value path.
(defn synth-named-value-call [(a (dyn Allocator))
                              (func (slice u8))
                              (type-args (ptr (ArrayList Type)))
                              (decl-names (ptr (ArrayList (slice u8))))
                              (names (ptr (ArrayList (slice u8))))
                              (args (ptr (ArrayList Expr)))
                              (expected (ptr Type))
                              (env (ptr (ArrayList EnvEntry)))
                              (cx (ptr Cx))
                              (tps (ptr (ArrayList (slice u8))))
                              (fname (slice u8))
                              (lo i64)
                              (hi i64)
                              (src i64)
                              (ctxt i64)] (-> (Result EvalPair Diag))
  (try (let [ordered (try! (named-function-args a func decl-names names args))
             source
               (if (named-same-order? decl-names names 0 (len (load decl-names)))
                   (mk-expr (ECall :func func :type_args type-args :args ordered)
                            lo
                            hi
                            src
                            ctxt)
                   (let [binds (named-source-binds a decl-names names ordered lo)
                         vars (named-decl-vars a decl-names names lo hi src ctxt)
                         (mut body) (ArrayList::new [Expr] a)]
                     (push! (mut body)
                            (mk-expr (ECall :func func :type_args type-args :args vars)
                                     lo
                                     hi
                                     src
                                     ctxt))
                     (mk-expr (ELet binds (box-al [Expr] a (load body)))
                              lo
                              hi
                              src
                              ctxt)))]
         (synth a (box-expr a source) expected env cx tps fname))))

;;; The :name labels a call to FUNC may use: a constructor's fields, a function's
;;; parameters, or a callable def's :params. None when FUNC takes no named arguments.
(defn named-call-labels [(a (dyn Allocator))
                         (cx (ptr Cx))
                         (env (ptr (ArrayList EnvEntry)))
                         (func (slice u8))] (-> (Option (ptr (ArrayList (slice u8)))))
  (let [vt (vts-find cx func)
        st (struct-find cx func)
        sig (sig-find cx func)]
    (cond (!= (cast i64 vt) 0)
            (let [v (variant-in-sum (sum-find cx (load (field vt sum))) func)]
              (Some (field-names a (load (field v fields)))))
          (!= (cast i64 st) 0) (Some (field-names a (load (field st fields))))
          (!= (cast i64 sig) 0)
            (if (or (.is_extern sig) (.variadic sig))
                (None)
                (Some (load (field sig param_names))))
          :else (declared-param-names cx env func))))

;;; `(f :k v)` reads as a named call. When none of its keywords label anything FUNC
;;; accepts, the keywords are ordinary Keyword arguments and the call is positional.
;;; A struct has no positional constructor, so its named form always stands.
(defn keyword-arguments-call? [(a (dyn Allocator))
                               (cx (ptr Cx))
                               (env (ptr (ArrayList EnvEntry)))
                               (func (slice u8))
                               (names (ptr (ArrayList (slice u8))))] (-> bool)
  (if (!= (cast i64 (struct-find cx func)) 0)
      false
      (keyword-arguments-for? (named-call-labels a cx env func) names)))

(defn keyword-arguments-for? [(accepted (Option (ptr (ArrayList (slice u8)))))
                              (names (ptr (ArrayList (slice u8))))] (-> bool)
  (match accepted
    (None [] true)
    (Some [labels]
          (let [(mut labelled) false]
            (for name (iter (load names))
              (when (>= (name-index labels name) 0) (set! labelled true)))
            (not (load labelled))))))

;;; The positional argument list of a named call read as keyword arguments:
;;; each :name becomes a Keyword value before its paired argument.
(defn keyword-positional-args [(a (dyn Allocator))
                               (names (ptr (ArrayList (slice u8))))
                               (args (ptr (ArrayList Expr)))
                               (lo i64)
                               (hi i64)
                               (src i64)
                               (ctxt i64)] (-> (ptr (ArrayList Expr)))
  (let [(mut out) (ArrayList::new [Expr] a)]
    (for i (range 0 (len (load names)))
      (let [(mut text) (ArrayList::new [Expr] a)]
        (push! (mut text) (mk-expr (EStr (get (load names) i)) lo hi src ctxt))
        (push! (mut out)
               (mk-expr (ECall
                          :func (core-name "KeywordValue")
                          :type_args (box-al [Type] a (ArrayList::new [Type] a))
                          :args (box-al [Expr] a (load text)))
                        lo
                        hi
                        src
                        ctxt))
        (push! (mut out) (get (load args) i))))
    (box-al [Expr] a (load out))))

(defn synth-named-call [(a (dyn Allocator))
                        (func (slice u8))
                        (type-args (ptr (ArrayList Type)))
                        (names (ptr (ArrayList (slice u8))))
                        (args (ptr (ArrayList Expr)))
                        (expected (ptr Type))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))
                        (lo i64)
                        (hi i64)
                        (src i64)
                        (ctxt i64)] (-> (Result EvalPair Diag))
  (if (or (!= (primitive/cast i64 (vts-find cx func)) 0)
          (!= (primitive/cast i64 (struct-find cx func)) 0))
      (synth-named-construct a
                             func
                             type-args
                             names
                             args
                             expected
                             env
                             cx
                             tps
                             fname
                             lo
                             hi
                             src
                             ctxt)
      (let [sig (sig-find cx func)]
        (if (= (primitive/cast i64 sig) 0)
            (match (declared-param-names cx env func)
              (Some [decl-names]
                    (synth-named-value-call a
                                            func
                                            type-args
                                            decl-names
                                            names
                                            args
                                            expected
                                            env
                                            cx
                                            tps
                                            fname
                                            lo
                                            hi
                                            src
                                            ctxt))
              (None []
                    (err-ep (derr (sconcat a
                                           (sconcat3 a
                                                     "in '"
                                                     fname
                                                     "': named arguments require a function, a struct or sum constructor, or a def annotated with :params; '")
                                           (with-removed-hint a
                                                              (sconcat a func "' is not one")
                                                              (fn-unknown-hint a cx fname func)))))))
            (if (or (.is_extern sig) (.variadic sig))
                (err-ep (derr (sconcat3 a
                                        "named arguments are not supported for extern or variadic function '"
                                        func
                                        "'")))
                (try (let [decl-names (load (field sig param_names))
                           ordered
                             (try! (named-function-args a
                                                        func
                                                        decl-names
                                                        names
                                                        args))
                           mark (type-map-mark)
                           ep
                             (try! (synth-call-general a
                                                       func
                                                       func
                                                       type-args
                                                       ordered
                                                       expected
                                                       env
                                                       cx
                                                       tps
                                                       fname
                                                       lo
                                                       hi
                                                       src
                                                       ctxt))]
                       (source-order-named-call a
                                                decl-names
                                                names
                                                ep
                                                mark
                                                expected
                                                env
                                                cx
                                                tps
                                                fname
                                                lo
                                                hi
                                                src
                                                ctxt))))))))

(defn validate-targs [(a (dyn Allocator))
                      (cx (ptr Cx))
                      (type_args (ptr (ArrayList Type)))
                      (tps (ptr (ArrayList (slice u8))))
                      (fname (slice u8))] (-> (Result i64 Diag))
  (let [n (len (load type_args))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (validate-generic-arg (elem type_args (load i))
                                      cx
                                      tps)
                  (Err [d]
                       (do
                         (set! err
                               (prefix-diag a
                                            d
                                            (sconcat3 a
                                                      "in '"
                                                      fname
                                                      "': type argument: ")))
                         (set! failed true)
                         (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

; A type argument still holding an inference hole binds nothing: the
; constructor infers that parameter from its arguments instead.
(defn build-subst! [(subst (ptr (ArrayList SubstEntry)))
                    (tparams (ptr (ArrayList (slice u8))))
                    (targs (ptr (ArrayList Type)))] (-> i64)
  (let [n (len (load tparams))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (unless (type-has-hole? (elem targs (load i)))
                  (subst-insert! subst
                                 (get (load tparams) (load i))
                                 (elem targs (load i)))
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn alloc-stack-store-targs [(a (dyn Allocator))
                               (expected (ptr Type))
                               (sumname (slice u8))
                               (np i64)] (-> (ptr TargsOpt))
  (box! a TargsOpt (expected-sum-targs a expected sumname np)))

(defn subst-targs [(a (dyn Allocator))
                   (tparams (ptr (ArrayList (slice u8))))
                   (subst (ptr (ArrayList SubstEntry)))] (-> (ptr (ArrayList Type)))
  (let [n (len (load tparams))
        (mut out) (ArrayList::new [Type] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out)
                       (load (subst-get subst (get (load tparams) (load i)))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn construct-check-args [(a (dyn Allocator))
                            (field_types (ptr (ArrayList Type)))
                            (args (ptr (ArrayList Expr)))
                            (subst (ptr (ArrayList SubstEntry)))
                            (variant (slice u8))
                            (env (ptr (ArrayList EnvEntry)))
                            (cx (ptr Cx))
                            (tps (ptr (ArrayList (slice u8))))
                            (fname (slice u8))] (-> (Result (ptr (ArrayList Expr))
                                                            Diag))
  (let [n (len (load args))
        (mut out) (ArrayList::new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (reserve! (mut out) n)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [want
                        (subst-apply a
                                     (elem field_types (load i))
                                     subst)
                      wp (box-type a want)
                      what
                        (sconcat a
                                 (sconcat a
                                          (sconcat3 a "'" variant "' field ")
                                          (i64->str a
                                                    (primitive/iadd (load i) 1)))
                                 "")]
                  (match (check-to a
                                   (elem args (load i))
                                   wp
                                   env
                                   cx
                                   tps
                                   fname
                                   what)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [ce] (push! (mut out) ce))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Expr)) Diag] (load err))
        (Ok (box-al [Expr] a (load out))))))

(defn construct-infer-args [(a (dyn Allocator))
                            (field_types (ptr (ArrayList Type)))
                            (args (ptr (ArrayList Expr)))
                            (subst (ptr (ArrayList SubstEntry)))
                            (tparams (ptr (ArrayList (slice u8))))
                            (variant (slice u8))
                            (env (ptr (ArrayList EnvEntry)))
                            (cx (ptr Cx))
                            (tps (ptr (ArrayList (slice u8))))
                            (fname (slice u8))] (-> (Result (ptr (ArrayList Expr))
                                                            Diag))
  (let [n (len (load args))
        (mut argl) (ArrayList::new [ArgSlot] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (do-synth a
                                 (elem args (load i))
                                 (null-type)
                                 env
                                 cx
                                 tps
                                 fname)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [sp0]
                      (let [sp (primitive/alloc-stack SynPair)
                            sl (primitive/alloc-stack ArgSlot)]
                        (set! sp sp0)
                        (set! (.present sl) true)
                        (set! (.e sl) (load (field sp e)))
                        (set! (.t sl) (load (field sp t)))
                        (push! (mut argl) (load sl)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Expr)) Diag] (load err))
        (let [argl2 (box-al [ArgSlot] a (load argl))
              (mut j) 0
              (mut err2) (primitive/zeroed Diag)
              (mut failed2) false]
          (loop (if (>= (load j) n)
                    (break)
                    (do
                      (match (unify a
                                    (elem field_types (load j))
                                    (arg-unify-type (elem field_types (load j))
                                                    (load (field (elem argl2 (load j)) t))
                                                    (load (field (elem argl2 (load j)) e))
                                                    tparams)
                                    tparams
                                    subst
                                    fname)
                        (Err [d] (do (set! err2 d) (set! failed2 true) (break)))
                        (Ok [_] 0))
                      (set! j (primitive/iadd (load j) 1)))))
          (if (load failed2)
              (Err [(ptr (ArrayList Expr)) Diag] (load err2))
              (let [npm (len (load tparams))
                    (mut k) 0
                    (mut missing) false
                    (mut mp) ""]
                (loop (if (>= (load k) npm)
                          (break)
                          (do
                            (when (not (subst-has subst
                                                  (get (load tparams) (load k))))
                              (store! missing true)
                              (store! mp (get (load tparams) (load k)))
                              (break))
                            (set! k (primitive/iadd (load k) 1)))))
                (if (load missing)
                    ; A field whose type mentions the parameter left it unbound
                    ; only when its argument has the wrong shape -- `(mut x)` for a
                    ; `(ptr T)` field -- and that mismatch is the error to report.
                    (Err [(ptr (ArrayList Expr)) Diag]
                         (block :mismatch
                           (for [j 0 n]
                             (when (type-mentions (elem field_types j) (load mp))
                               (let [sl (elem argl2 j)]
                                 (match (coerce a
                                                (load (load (field sl e)))
                                                (load (field sl t))
                                                (box-type a (subst-apply a (elem field_types j) subst))
                                                false
                                                fname
                                                (sconcat a (sconcat3 a "'" variant "' field ")
                                                         (i64->str a (+ j 1))))
                                   (Err [d] (break :mismatch d))
                                   (Ok [_] 0)))))
                           (derr (sconcat a
                                          (sconcat a
                                                   (sconcat4 a
                                                             "in '"
                                                             fname
                                                             "': cannot infer type argument '"
                                                             (sconcat a
                                                                      (load mp)
                                                                      "' for '"))
                                                   (sconcat a
                                                            variant
                                                            "'; provide it explicitly: ("))
                                          (sconcat a variant " [<types>] ...)")))))
                    (if (externref-inferred? subst tparams)
                        (Err [(ptr (ArrayList Expr)) Diag]
                             (derr (sconcat4 a
                                             "in '"
                                             fname
                                             "': "
                                             (externref-storage-message "a type argument"))))
                    (let [(mut m) 0
                          (mut out2) (ArrayList::new [Expr] a)
                          (mut err3) (primitive/zeroed Diag)
                          (mut failed3) false]
                      (loop (if (>= (load m) n)
                                (break)
                                (do
                                  (let [sl (elem argl2 (load m))
                                        want
                                          (subst-apply a
                                                       (elem field_types
                                                             (load m))
                                                       subst)
                                        wp (box-type a want)
                                        what
                                          (sconcat a
                                                   (sconcat3 a
                                                             "'"
                                                             variant
                                                             "' field ")
                                                   (i64->str a
                                                             (primitive/iadd (load m)
                                                                             1)))]
                                    (match (coerce a
                                                   (load (load (field sl e)))
                                                   (load (field sl
                                                                t))
                                                   wp
                                                   false
                                                   fname
                                                   what)
                                      (Err [d]
                                           (do
                                             (set! err3 d)
                                             (set! failed3 true)
                                             (break)))
                                      (Ok [ce] (push! (mut out2) ce))))
                                  (set! m (primitive/iadd (load m) 1)))))
                      (if (load failed3)
                          (Err [(ptr (ArrayList Expr)) Diag] (load err3))
                          (Ok (box-al [Expr] a (load out2)))))))))))))

; ---- ECall ----

(defn methods-has [(cx (ptr Cx)) (func (slice u8))] (-> bool)
  (let [n (len (.methods cx))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem (field cx methods)
                                            (load i))
                                      name))
                         func)
                  (store! r true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn trait-method-find [(td (ptr TraitDef)) (func (slice u8))] (-> (ptr TraitMethod))
  (let [ms (load (field td methods))
        n (len (load ms))
        (mut i) 0
        (mut r) (primitive/cast (ptr TraitMethod) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem ms (load i)) name))
                         func)
                  (store! r (elem ms (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; Can this signature take `nargs` arguments at all? The gate for the
; arity-directed fallback below — variadic counts as "yes" from nparams up.
(defn sig-arity-ok? [(sig (ptr Sig)) (nargs i64)] (-> bool)
  (let [np (len (load (field sig params)))]
    (if (.variadic sig) (>= nargs np) (= nargs np))))

; Does ANY declared trait method named `simple` accept exactly `nargs` args?
; Scope and ambiguity are NOT judged here — that stays with the ordinary
; method-resolution path, which has its own diagnostics for both.
(defn method-arity-matches? [(cx (ptr Cx)) (simple (slice u8)) (nargs i64)] (-> bool)
  (let [ms (field cx methods)
        n (len (load ms))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [me (elem ms (load i))]
                  (when (= (load (field me name)) simple)
                    (let [td (trait-find cx (load (field me trait)))]
                      (unless (= (primitive/cast i64 td) 0)
                        (let [tm (trait-method-find td simple)]
                          (unless (= (primitive/cast i64 tm)
                                     0)
                            (when (= (len (load (field tm params))) nargs)
                              (store! r true)
                              (break))
                            0))
                        0))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; The declaring trait of the first method named `simple`, for diagnostics.
(defn method-trait-of [(cx (ptr Cx)) (simple (slice u8))] (-> (slice u8))
  (let [ms (field cx methods)
        n (len (load ms))
        (mut i) 0
        (mut r) ""]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem ms (load i)) name))
                         simple)
                  (store! r
                          (load (field (elem ms (load i))
                                       trait)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn is-mut-borrow [(e (ptr Expr))] (-> bool)
  (match (.kind e) (EBorrow [mu place] mu) (_ false)))

(defn peel-ref-ptr [(t (ptr Type))] (-> (ptr Type))
  (let [(mut r) t]
    (loop (let [tg (type-tag (load r))]
            (if (or (= tg 4) (= tg 5))
                (do (set! r (t-inner (load r))) 0)
                (break))))
    (load r)))

; Can a call to a `tr` method dispatch on a receiver of type `t`? Either an impl
; matches it, `t` is a (bounded) type parameter, or it's a `(dyn Trait)` receiver.
(defn dispatch-here? [(a (dyn Allocator))
                      (cx (ptr Cx))
                      (tr (slice u8))
                      (t (ptr Type))
                      (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (if (not (has-impl-name a t))
      false
      (let [nm (type-impl-name a t)]
        (or (set-contains tps nm)
            (or (> (len (dyn-struct-trait cx nm)) 0)
                (impl-match a cx tr t))))))

; Method-dispatch autoderef. This was a single full `peel-ref-ptr`, which was fine
; while pointers couldn't carry impls — the pointee was the only possible receiver.
; Now that they can, a pointer's OWN impl must win: `(< p q)` with `Ord (ptr T)` in
; scope compares ADDRESSES, and must not silently peel to the pointee's `Ord`. So we
; try the receiver's own type first and peel one ptr/ref layer at a time, stopping at
; the first level that dispatches (the receiver type is tried before any
; autoderef step). `(len xs)` on `(ptr (ArrayList T))` still works: "ptr" has no `Len`
; impl, so the chain peels to the ArrayList exactly as before. If nothing in the chain
; dispatches, fall back to the fully-peeled type so existing diagnostics are unchanged.
;;; The type a receiver that cannot type itself takes from its peers: that of
;;; the first other argument the method also declares as Self, when that
;;; argument is not a literal itself. A numeric literal receiver takes only a
;;; numeric peer's type (`numeric-only`), keeping its default otherwise; a
;;; receiver such as `(None)`, which has no type of its own, takes any.
;;; Null when no peer has one.
(defn receiver-peer-type [(a (dyn Allocator))
                          (cx (ptr Cx))
                          (tm (ptr TraitMethod))
                          (self_pname (slice u8))
                          (self_idx i64)
                          (args (ptr (ArrayList Expr)))
                          (env (ptr (ArrayList EnvEntry)))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))
                          (numeric-only bool)] (-> (ptr Type))
  (let [params (load (field tm params))
        n (if (< (len (load params)) (len (load args))) (len (load params)) (len (load args)))]
    (block :found
      (for [j 0 n]
        (let [arg (elem args j)
              declared (load (field (elem params j) ty))]
          (when (and (!= j self_idx)
                     (not (is-literal arg))
                     (match declared (TStruct [nm] (= nm self_pname)) (_ false)))
            (match (do-synth a arg (null-type) env cx tps fname)
              (Ok [sp]
                  (let [t (peel-refs (.t sp))]
                    (when (or (not numeric-only)
                              (match (load t) (TInt [_ _] true) (TFloat [_] true) (_ false)))
                      (break :found t))))
              (Err [_] 0))
            0)))
      (null-type))))

; `t` under any references (not raw pointers) to it.
(defn peel-refs [(t (ptr Type))] (-> (ptr Type))
  (match (load t)
    (TRef [_ inner] (peel-refs inner))
    (_ t)))

(defn deref-to-impl [(a (dyn Allocator))
                     (cx (ptr Cx))
                     (tr (slice u8))
                     (t0 (ptr Type))
                     (tps (ptr (ArrayList (slice u8))))] (-> (ptr Type))
  (let [(mut r) t0
        (mut found) false]
    (loop (if (dispatch-here? a cx tr (load r) tps)
              (do (set! found true) (break))
              (let [tg (type-tag (load r))]
                (cond (or (= tg 4)
                          (= tg 5))
                        (do (set! r (t-inner (load r))) 0)
                      ; A fixed array borrows as a slice, so it dispatches on the
                      ; SLICE impls: `Len`, `Get`, `Set`, `Iterable` and the rest
                      ; apply to `(array T N)` without an impl over the length
                      ; parameter. This step is the receiver-position
                      ; form of the array->slice borrow `coerce` already performs on
                      ; a call argument, and synth-call-general inserts exactly that
                      ; borrow once the slice impl is selected. Tried only AFTER the
                      ; array's own type, so an `impl Len (array i64 3)` still wins,
                      ; exactly like a pointer's own impl.
                      (= tg 7)
                        (do (set! r (box-type a (TSlice (t-inner (load r))))) 0)
                      :else (break)))))
    (if (load found) (load r) (peel-ref-ptr t0))))

; ---- associated-type bounds (gen-1) ----------------------------------------
; A PARAMETERIZED trait `(deftrait Get [Self K E] …)` can be used as a bound
; `(C Get)`: its non-Self params (K, E) are ASSOCIATED TYPES — determined by C's
; impl, one impl per type. Inside the bounded generic they are unknown, so each is
; represented as a synthetic abstract type param `<C>$assoc$<Trait>$<K>` — a spelling
; no user identifier can produce (`$` isn't an identifier char), so it never collides
; with a real type. These names are added to the body's tps (so a call whose
; result/arg mentions one type-checks) and resolved to the impl's concrete type at
; monomorphization (mono reads them off the receiver's impl, exactly as it already
; reads a generic impl's own type params).
(defn assoc-tp-name [(a (dyn Allocator))
                     (base (slice u8))
                     (tr (slice u8))
                     (p (slice u8))] (-> (slice u8))
  (sconcat3 a base "$assoc$" (sconcat3 a (display-name tr) "$" p)))

(defn type-param-pack-name? [(name (slice u8))] (-> bool)
  (let [n (len name)]
    (and (>= n 3) (= (subslice name (- n 3) n) "..."))))

(defn type-param-pack-index [(params (ptr (ArrayList (slice u8))))] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (len (load params))]
      (when (type-param-pack-name? (get (load params) i))
        (store! found i)))
    (load found)))

; The deferred-call substitution: the trait method's `Self` -> the bounded type
; param `C`, and each extra trait param -> its associated type. `subst-apply` over
; this turns the trait method signature into the concrete-in-C signature the body
; is checked against.
(defn build-trait-subst [(a (dyn Allocator))
                         (self_pname (slice u8))
                         (self_name (slice u8))
                         (trait_name (slice u8))
                         (td (ptr TraitDef))
                         (bound-args (ptr (ArrayList Type)))] (-> (ptr (ArrayList SubstEntry)))
  (let [s (subst-new a)]
    (subst-insert! s self_pname (box-type a (TStruct self_name)))
    (let [tps2 (load (field td type_params))
          np (len (load tps2))
          na (len (load bound-args))
          pack-index (type-param-pack-index tps2)
          pack-count (if (< pack-index 0) 0 (- na (- np 1)))
          (mut i) 0]
      (loop (if (>= (load i) np)
                (break)
                (do
                  (let [p (get (load tps2) (load i))]
                    (if (= (load i) pack-index)
                        (subst-insert! s
                                       p
                                       (box-type a
                                                 (make-pack a
                                                            bound-args
                                                            pack-index
                                                            (+ pack-index
                                                               pack-count))))
                        (let [arg-index
                                (if (and (>= pack-index 0)
                                         (> (load i) pack-index))
                                    (+ (load i) (- pack-count 1))
                                    (load i))]
                          (if (< arg-index na)
                              (subst-insert! s
                                             p
                                             (elem bound-args
                                                   arg-index))
                              (subst-insert! s
                                             p
                                             (box-type a
                                                       (TStruct (assoc-tp-name a
                                                                               self_name
                                                                               trait_name
                                                                               p))))))))
                  (set! i (primitive/iadd (load i) 1))))))
    s))

; `base` (the function's declared type params) extended with the associated-type
; names of every bound over a parameterized trait — the tps the BODY is checked
; against. The stored func `type_params` are unchanged: associated types are
; internal, never named by a caller.
(defn assoc-body-tps [(a (dyn Allocator))
                      (cx (ptr Cx))
                      (bounds (ptr (ArrayList Bound)))
                      (base (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (ArrayList::new [(slice u8)] a)
        nb (len (load base))
        (mut i) 0]
    (loop (if (>= (load i) nb)
              (break)
              (do
                (push! (mut out) (get (load base) (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (let [nbd (len (load bounds))
          (mut j) 0]
      (loop (if (>= (load j) nbd)
                (break)
                (do
                  (let [bp (elem bounds (load j))
                        trs (load (field bp traits))
                        m (len (load trs))
                        (mut k) 0]
                    (loop (if (>= (load k) m)
                              (break)
                              (do
                                (let [tr
                                        (.name (elem trs
                                                     (load k)))
                                      td (trait-find cx tr)]
                                  (when (!= (primitive/cast i64 td)
                                            0)
                                    (let [tps2 (load (field td type_params))
                                          np (len (load tps2))
                                          (mut p) 0]
                                      (loop (if (>= (load p) np)
                                                (break)
                                                (do
                                                  (push! (mut out)
                                                         (assoc-tp-name a
                                                                        (load (field bp
                                                                                     name))
                                                                        tr
                                                                        (get (load tps2)
                                                                             (load p))))
                                                  (store! p
                                                          (primitive/iadd (load p)
                                                                          1))))))))
                                (set! k (primitive/iadd (load k) 1))))))
                  (set! j (primitive/iadd (load j) 1))))))
    (box-al [(slice u8)] a (load out))))

; trait type-parameter Self deferred args. `subst` maps Self -> the
; bounded param and every associated type -> its synthetic name (build-trait-subst).
(defn trait-subst-param-types [(a (dyn Allocator))
                               (tm (ptr TraitMethod))
                               (subst (ptr (ArrayList SubstEntry)))] (-> (ptr (ArrayList Type)))
  (let [params (load (field tm params))
        (mut raw) (ArrayList::new [Type] a)]
    (for [i 0 (len (load params))]
      (push! (mut raw) (load (field (elem params i) ty))))
    (subst-apply-list a (box-al [Type] a (load raw)) subst)))

(defn trait-tp-args [(a (dyn Allocator))
                     (tm (ptr TraitMethod))
                     (subst (ptr (ArrayList SubstEntry)))
                     (args (ptr (ArrayList Expr)))
                     (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))
                     (func (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [ps (trait-subst-param-types a tm subst)
        n (len (load args))
        (mut out) (ArrayList::new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (when (not (= n (len (load ps))))
      (store! err
              (derr (sconcat a
                             (sconcat3 a "in '" fname "': trait call expects ")
                             (sconcat a
                                      (i64->str a (len (load ps)))
                                      (sconcat3 a
                                                " args, got "
                                                (i64->str a n)
                                                "")))))
      (store! failed true))
    (loop (if (or (load failed) (>= (load i) n))
              (break)
              (do
                (let [want (load (elem ps (load i)))
                      wp (box-type a want)
                      ismut (is-mut-borrow (elem args (load i)))
                      exp
                        (if (= (type-tag wp) 5)
                            (t-inner wp)
                            wp)
                      what
                        (sconcat a
                                 (sconcat a
                                          (sconcat3 a
                                                    "argument "
                                                    (i64->str a
                                                              (primitive/iadd (load i)
                                                                              1))
                                                    " to '")
                                          func)
                                 "'")]
                  (match (synth-arg a
                                   (elem args (load i))
                                   exp
                                   (= (type-tag wp) 5)
                                   env
                                   cx
                                   tps
                                   fname)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)]
                          (set! sp sp0)
                          (match (coerce-arg a
                                             ismut
                                             (load (load (field sp e)))
                                             (load (field sp
                                                          t))
                                             wp
                                             false
                                             fname
                                             what)
                            (Err [d]
                                 (do (set! err d) (set! failed true) (break)))
                            (Ok [ce] (push! (mut out) ce)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Expr)) Diag] (load err))
        (Ok (box-al [Expr] a (load out))))))

; non-generic call args
(defn ca-nongeneric [(a (dyn Allocator))
                     (sig (ptr Sig))
                     (args (ptr (ArrayList Expr)))
                     (func (slice u8))
                     (elo i64)
                     (ehi i64)
                     (esrc i64)
                     (ectxt i64)
                     (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))] (-> (Result (ptr (ArrayList Expr))
                                                     Diag))
  (let [params (load (field sig params))
        nparams (len (load params))
        is_extern (.is_extern sig)
        n (len (load args))
        (mut out) (ArrayList::new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (reserve! (mut out) n)
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (>= (load i) nparams)
                    (match (do-synth a
                                     (elem args (load i))
                                     (null-type)
                                     env
                                     cx
                                     tps
                                     fname)
                      (Err [d] (do (set! err d) (set! failed true) (break)))
                      (Ok [sp0]
                          (let [sp (primitive/alloc-stack SynPair)]
                            (set! sp sp0)
                            (if (type-is-void (load (field sp t)))
                                (do
                                  (set! err
                                        (derr (sconcat3 a
                                                        "in '"
                                                        fname
                                                        "': variadic argument uses a void value (a (-> void) call yields nothing)")))
                                  (set! failed true)
                                  (break))
                                (if (= (type-tag (load (field sp t)))
                                       5)
                                    (let [ae (elem args (load i))
                                          nm
                                            (match (.kind ae)
                                              (EVar [n] n)
                                              (_ "…"))]
                                      (do
                                        (set! err
                                              (derr-at (.lo ae)
                                                       (.hi ae)
                                                       (sconcat3 a
                                                                 (sconcat5 a
                                                                           "in '"
                                                                           fname
                                                                           "': cannot pass "
                                                                           (ty-str a
                                                                                   (load (field sp
                                                                                                t)))
                                                                           " to a variadic parameter — it would pass the address; write (load ")
                                                                 nm
                                                                 ") for the value")))
                                        (set! failed true)
                                        (break)))
                                    (push! (mut out) (load (load (field sp e)))))))))
                    (let [want (elem params (load i))
                          ismut (is-mut-borrow (elem args (load i)))
                          exp
                            (if (= (type-tag want) 5)
                                (t-inner want)
                                want)
                          what
                            (sconcat a
                                     (sconcat a
                                              (sconcat3 a
                                                        "argument "
                                                        (i64->str a
                                                                  (primitive/iadd (load i)
                                                                                  1))
                                                        " to '")
                                              func)
                                     "'")]
                      (match (synth-arg a
                                       (elem args (load i))
                                       exp
                                       (= (type-tag want) 5)
                                       env
                                       cx
                                       tps
                                       fname)
                        (Err [d] (do (set! err d) (set! failed true) (break)))
                        (Ok [sp0]
                            (let [sp (primitive/alloc-stack SynPair)]
                              (set! sp sp0)
                              (match (maybe-coerce-dyn a
                                                       cx
                                                       (load (field sp e))
                                                       (load (field sp t))
                                                       want
                                                       elo
                                                       ehi
                                                       esrc
                                                       ectxt
                                                       fname)
                                (Err [d]
                                     (do
                                       (set! err d)
                                       (set! failed true)
                                       (break)))
                                (Ok [mp0]
                                    (let [mp (primitive/alloc-stack SynPair)]
                                      (set! mp mp0)
                                      (match (coerce-arg a
                                                         ismut
                                                         (load (load (field mp
                                                                            e)))
                                                         (load (field mp t))
                                                         want
                                                         is_extern
                                                         fname
                                                         what)
                                        (Err [d]
                                             (do
                                               (set! err d)
                                               (set! failed true)
                                               (break)))
                                        (Ok [ce] (push! (mut out) ce)))))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Expr)) Diag] (load err))
        (Ok (box-al [Expr] a (load out))))))

; generic call. Returns the elaborated ECall as EvalPair.
(defn ca-build-arglist [(a (dyn Allocator))
                        (args (ptr (ArrayList Expr)))
                        (defs (ptr (ArrayList Deferred)))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))] (-> (ptr (ArrayList ArgSlot)))
  (let [n (len (load args))
        (mut out) (ArrayList::new [ArgSlot] a)
        (mut i) 0]
    (reserve! (mut out) n)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [saved (len (load env))]
                  (match (do-synth a
                                   (elem args (load i))
                                   (null-type)
                                   env
                                   cx
                                   tps
                                   fname)
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)
                              sl (primitive/alloc-stack ArgSlot)]
                          (set! sp sp0)
                          (set! (.present sl) true)
                          (set! (.e sl) (load (field sp e)))
                          (set! (.t sl) (load (field sp t)))
                          (push! (mut out) (load sl))))
                    (Err [d]
                         (do
                           (env-truncate! env saved)
                           (let [sl (primitive/alloc-stack ArgSlot)
                                 df (primitive/alloc-stack Deferred)]
                             (set! (.present sl) false)
                             (set! (.e sl) (primitive/cast (ptr Expr) 0))
                             (set! (.t sl) (primitive/cast (ptr Type) 0))
                             (push! (mut out) (load sl))
                             (set! (.idx df) (load i))
                             (set! (.err df) d)
                             (push! [Deferred] defs (load df)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [ArgSlot] a (load out))))

(defn bound-param-argument-index [(sig (ptr Sig)) (param (slice u8))] (-> i64)
  (let [params (load (field sig params))
        (mut found) -1]
    (for [i 0 (len (load params))]
      (match (load (elem params i))
        (TStruct [name] (when (= name param) (store! found i)))
        (_ 0)))
    (load found)))

; A call from one generic body may discharge the callee's bound with the
; caller's declared bound. `impl-match` only answers for concrete types, so using
; it alone incorrectly rejects `helper [T]` inside a body already checked under
; `(T Trait)`. Associated arguments are part of the entailment: `(T (Get K V))`
; cannot satisfy `(T (Get X Y))` unless the substituted arguments agree.
(defn current-bound-entails? [(a (dyn Allocator))
                              (cx (ptr Cx))
                              (ty (ptr Type))
                              (required (ptr BoundTrait))
                              (subst (ptr (ArrayList SubstEntry)))] (-> bool)
  (match (load ty)
    (TStruct [name]
      (let [available (bound-trait-find (field cx cur_bounds)
                                        name
                                        (.name required))]
        (if (= (primitive/cast i64 available) 0)
          ; a trait given by a blanket impl, from bounds declared here
          (and (= (len (load (field required args))) 0)
               (blanket-entails? a cx name (.name required)))
          (let [have (load (field available args))
                want (load (field required args))
                (mut ok) (= (len (load have)) (len (load want)))]
            (when (load ok)
              (for [i 0 (len (load have))]
                (let [expected (box-type a
                                  (subst-apply a
                                    (elem want i)
                                    subst))]
                  (unless (type-eq (elem have i) expected)
                    (store! ok false)))))
            (load ok)))))
    (_ false)))

(defn ca-check-bounds [(a (dyn Allocator))
                       (sig (ptr Sig))
                       (subst (ptr (ArrayList SubstEntry)))
                       (func (slice u8))
                       (args (ptr (ArrayList Expr)))
                       (cx (ptr Cx))
                       (fname (slice u8))
                       (elo i64)
                       (ehi i64)
                       (esrc i64)
                       (ectxt i64)] (-> (Result i64 Diag))
  (let [bounds (load (field sig bounds))
        n (len (load bounds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [bp (elem bounds (load i))
                      param (.name bp)
                      tyr (subst-get subst (.name bp))]
                  (when (!= (primitive/cast i64 tyr) 0)
                    (let [trs (load (field bp traits))
                          m (len (load trs))
                          (mut k) 0]
                      (loop (if (>= (load k) m)
                                (break)
                                (do
                                  (let [bt (elem trs (load k))
                                        tr (.name bt)
                                        concrete (impl-match a cx tr tyr)
                                        ok (or concrete
                                               (current-bound-entails? a
                                                                        cx
                                                                        tyr
                                                                        bt
                                                                        subst))]
                                    (when (not ok)
                                      (let [argi
                                              (bound-param-argument-index sig
                                                                          param)
                                            ep
                                              (if (and (>= argi 0)
                                                       (< argi
                                                          (len (load args))))
                                                  (elem args argi)
                                                  (primitive/cast (ptr Expr) 0))
                                            message
                                              (if (= (primitive/cast i64 ep) 0)
                                                  (sconcat a
                                                           (sconcat a
                                                                    (sconcat a
                                                                             (sconcat a
                                                                                      (sconcat4 a
                                                                                                "in '"
                                                                                                fname
                                                                                                "': '"
                                                                                                (sconcat a
                                                                                                         (ty-str a
                                                                                                                 tyr)
                                                                                                         "' does not implement '"))
                                                                                      (display-name tr))
                                                                             "' (required by '")
                                                                    func)
                                                           (sconcat a
                                                                    "' bound on '"
                                                                    (sconcat a
                                                                             param
                                                                             "')")))
                                                  (sconcat a
                                                           (sconcat a
                                                                    (sconcat a
                                                                             (sconcat4 a
                                                                                       "in '"
                                                                                       fname
                                                                                       "': argument "
                                                                                       (i64->str a
                                                                                                 (primitive/iadd argi
                                                                                                                 1)))
                                                                             (sconcat a
                                                                                      " to '"
                                                                                      (sconcat a
                                                                                               func
                                                                                               "' has type '")))
                                                                    (sconcat a
                                                                             (ty-str a
                                                                                     tyr)
                                                                             "', which does not implement '"))
                                                           (sconcat a
                                                                    (display-name tr)
                                                                    "'")))]
                                        (store! err
                                                (if (= (primitive/cast i64 ep)
                                                       0)
                                                    (dwspan (derr message)
                                                            esrc
                                                            elo
                                                            ehi
                                                            ectxt)
                                                    (dwspan (derr message)
                                                            (.source ep)
                                                            (.lo ep)
                                                            (.hi ep)
                                                            (.ctxt ep)))))
                                      (store! failed true)
                                      (break))
                                    (when (and concrete
                                               (> (len (load (field bt args)))
                                                  0))
                                      (let [td (trait-find cx tr)
                                            sel (primitive/alloc-stack ImplSel)]
                                        (set! sel (cx-impl-select a cx tr tyr))
                                        (let [ip (load (field sel ip))
                                              assoc
                                                (impl-associated-bindings a
                                                                          ip
                                                                          td)
                                              impl-binds (subst-new a)
                                              _extras
                                                (unify-trait-extras a
                                                                    (field ip
                                                                           self_type)
                                                                    tyr
                                                                    (load (field ip
                                                                                 type_params))
                                                                    impl-binds)
                                              actuals
                                                (flatten-associated-types a
                                                                          td
                                                                          assoc
                                                                          impl-binds)]
                                          (when (!= (len (load (field bt args)))
                                                    (len (load actuals)))
                                            (store! err
                                                    (derr (sconcat a
                                                                   (sconcat3 a
                                                                             "bound '"
                                                                             (display-name tr)
                                                                             "' expects ")
                                                                   (sconcat a
                                                                            (i64->str a
                                                                                      (len (load actuals)))
                                                                            (sconcat a
                                                                                     " associated type arguments, got "
                                                                                     (i64->str a
                                                                                               (len (load (field bt
                                                                                                                 args)))))))))
                                            (store! failed true)
                                            (break))
                                          (for [pi 0 (len (load actuals))]
                                            (let [actual
                                                    (elem actuals pi)
                                                  expected0
                                                    (subst-apply a
                                                                 (elem (load (field bt
                                                                                    args))
                                                                       pi)
                                                                 subst)
                                                  expected
                                                    (box-type a expected0)]
                                              ; An impl parameter the receiver does not
                                              ; determine (`From` in an associated
                                              ; `(ArrayList From)`) is bound by the type the
                                              ; bound asks for.
                                              (when (not (unify-trait-extras a
                                                                             actual
                                                                             expected
                                                                             (load (field ip
                                                                                          type_params))
                                                                             impl-binds))
                                                (store! err
                                                        (dwspan (derr (sconcat a
                                                                               (sconcat3 a
                                                                                         "in '"
                                                                                         fname
                                                                                         "': associated type mismatch for '")
                                                                               (sconcat a
                                                                                        (display-name tr)
                                                                                        (sconcat a
                                                                                                 "': expected "
                                                                                                 (sconcat a
                                                                                                          (ty-str a
                                                                                                                  expected)
                                                                                                          (sconcat a
                                                                                                                   ", got "
                                                                                                                   (ty-str a
                                                                                                                           actual)))))))
                                                                esrc
                                                                elo
                                                                ehi
                                                                ectxt))
                                                (store! failed true)
                                                (break))))))))
                                  (store! k (primitive/iadd (load k) 1)))))
                      0)))
                (if (load failed) (break) (set! i (primitive/iadd (load i) 1))))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn with-inference-holes [(a (dyn Allocator))
                            (tparams (ptr (ArrayList (slice u8))))
                            (subst (ptr (ArrayList SubstEntry)))] (-> (ptr (ArrayList SubstEntry)))
  (let [out (subst-new a)]
    (for [i 0 (len (load subst))]
      (push! [SubstEntry] out (get (load subst) i)))
    (for [i 0 (len (load tparams))]
      (let [tp (get (load tparams) i)]
        (unless (subst-has subst tp)
          (subst-insert! out tp (box-type a (inference-hole a tp)))
          0)))
    out))

;;; Is this checked argument a literal, or a variant built only of literals
;;; (`(Some 5)`, `(Ok (Some 2))`)? Its type is the literals' defaults, which say
;;; nothing about what the call wants.
(defn weak-literal-arg? [(cx (ptr Cx)) (e (ptr Expr))] (-> bool)
  (if (is-literal e)
      true
      (match (.kind e)
        (ECall [func _ args]
               (and (!= (primitive/cast i64 (vts-find cx func)) 0)
                    (> (len (load args)) 0)
                    (block :strong
                      (for [i 0 (len (load args))]
                        (unless (weak-literal-arg? cx (elem args i))
                          (break :strong false)))
                      true)))
        (_ false))))

;;; Does every one of `tparams` that `t` mentions already have a binding?
(defn type-params-bound? [(t (ptr Type))
                          (tparams (ptr (ArrayList (slice u8))))
                          (subst (ptr (ArrayList SubstEntry)))] (-> bool)
  (block :open
    (for [i 0 (len (load tparams))]
      (let [tp (get (load tparams) i)]
        (when (and (type-mentions t tp) (not (subst-has subst tp)))
          (break :open false))))
    true))

;;; A literal-built argument (`weak-literal-arg?`) was typed by its literals'
;;; defaults and did not bind the parameter the others bound. Check it again at the
;;; parameter's type, so `(= (f) (Some 5))` with `f` an `(Option u32)` makes the 5
;;; a u32, as a bare literal argument already is.
(defn ca-resynth-weak-literals [(a (dyn Allocator))
                                (argl (ptr (ArrayList ArgSlot)))
                                (sig (ptr Sig))
                                (subst (ptr (ArrayList SubstEntry)))
                                (args (ptr (ArrayList Expr)))
                                (env (ptr (ArrayList EnvEntry)))
                                (cx (ptr Cx))
                                (tps (ptr (ArrayList (slice u8))))
                                (fname (slice u8))] (-> (Result i64 Diag))
  (try (let [params (subst-apply-list a (load (field sig params)) subst)
             n (if (< (len (load params)) (len (load argl)))
                   (len (load params))
                   (len (load argl)))]
         (for [i 0 n]
           (let [sl (elem argl i)]
             (when (and (.present sl)
                        (not (is-literal (.e sl)))
                        (weak-literal-arg? cx (.e sl)))
               (let [want (elem params i)
                     wp (match (load want)
                          (TRef [_ inner] inner)
                          (_ want))]
                 (unless (type-eq (peel-refs (.t sl)) wp)
                   (let [sp (primitive/alloc-stack SynPair)]
                     (set! sp (try! (do-synth a (elem args i) wp env cx tps fname)))
                     (set! (.e sl) (load (field sp e)))
                     (set! (.t sl) (load (field sp t)))
                     0))
                 0))
             0))
         (Ok [i64 Diag] 0))))

(defn ca-resynth-deferred [(a (dyn Allocator))
                           (defs (ptr (ArrayList Deferred)))
                           (argl (ptr (ArrayList ArgSlot)))
                           (sig (ptr Sig))
                           (subst (ptr (ArrayList SubstEntry)))
                           (args (ptr (ArrayList Expr)))
                           (env (ptr (ArrayList EnvEntry)))
                           (cx (ptr Cx))
                           (tps (ptr (ArrayList (slice u8))))
                           (fname (slice u8))] (-> (Result i64 Diag))
  ; A type parameter no other argument bound is an inference hole in the
  ; parameter type, not the callee's own name for it: the deferred argument
  ; supplies that part (`(map-err r (fn [e] (W e)))` binds F from the body).
  (let [params (subst-apply-list a
                                 (load (field sig params))
                                 (with-inference-holes a (load (field sig type_params)) subst))
        n (len (load defs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [df (elem defs (load i))
                      idx (.idx df)
                      want (load (elem params idx))
                      ; A by-value struct or sum parameter is declared `(ref T)`;
                      ; the argument is a value of `T`, as ca-nongeneric expects.
                      wp (match want
                           (TRef [_ inner] inner)
                           (_ (box-type a want)))]
                  (match (let [arg (elem args idx)]
                           (match (.kind arg)
                             (EAnonFn [anon_params anon_body]
                                      (let [decl
                                              (elem (load (field sig params))
                                                    idx)]
                                        (match (load decl)
                                          (TStruct [pname]
                                                   (let [bounds
                                                           (load (field sig
                                                                        bounds))
                                                         (mut found)
                                                           (primitive/cast (ptr BoundTrait)
                                                                           0)]
                                                     (for [bi
                                                           0
                                                           (len (load bounds))]
                                                       (let [bp
                                                               (elem bounds
                                                                     bi)]
                                                         (when (= (.name bp)
                                                                  pname)
                                                           (for [ti
                                                                 0
                                                                 (len (load (field bp
                                                                                   traits)))]
                                                             (let [bt
                                                                     (elem (load (field bp
                                                                                        traits))
                                                                           ti)]
                                                               (when (core-name? (.name bt) "Callable")
                                                                 (store! found
                                                                         bt)))))))
                                                     (if (= (primitive/cast i64
                                                                            (load found))
                                                            0)
                                                         (do-synth a
                                                                   arg
                                                                   wp
                                                                   env
                                                                   cx
                                                                   tps
                                                                   fname)
                                                         (let [raw_args
                                                                 (load (field (load found)
                                                                              args))
                                                               applied
                                                                 (subst-apply-list a
                                                                                   raw_args
                                                                                   subst)
                                                               count
                                                                 (len (load applied))]
                                                           (if (< count
                                                                  1)
                                                               (do-synth a
                                                                         arg
                                                                         wp
                                                                         env
                                                                         cx
                                                                         tps
                                                                         fname)
                                                               (let [(mut aps)
                                                                       (ArrayList::new [Type]
                                                                                       a)
                                                                     raw_ret
                                                                       (elem raw_args
                                                                             (primitive/isub count
                                                                                             1))
                                                                     applied_ret
                                                                       (elem applied
                                                                             (primitive/isub count
                                                                                             1))
                                                                     retp
                                                                       (match (load raw_ret)
                                                                         (TStruct [rn]
                                                                                  (if (and (set-contains (load (field sig
                                                                                                                      type_params))
                                                                                                         rn)
                                                                                           (= (primitive/cast i64
                                                                                                              (subst-get subst
                                                                                                                         rn))
                                                                                              0))
                                                                                      (null-type)
                                                                                      applied_ret))
                                                                         (_ applied_ret))]
                                                                 (for [ai
                                                                       0
                                                                       (primitive/isub count
                                                                                       1)]
                                                                   (push! (mut aps)
                                                                          (load (elem applied
                                                                                      ai))))
                                                                 (synth-anon-fn-syn a
                                                                                    anon_params
                                                                                    anon_body
                                                                                    (box-al [Type]
                                                                                            a
                                                                                            (load aps))
                                                                                    retp
                                                                                    env
                                                                                    cx
                                                                                    tps
                                                                                    fname
                                                                                    (.lo arg)
                                                                                    (.hi arg)
                                                                                    (.source arg)
                                                                                    (.ctxt arg))))))))
                                          (_ (do-synth a
                                                       arg
                                                       wp
                                                       env
                                                       cx
                                                       tps
                                                       fname)))))
                             (_ (do-synth a arg wp env cx tps fname))))
                    (Err [d] (do (store! err d) (store! failed true)))
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)
                              sl (elem argl idx)]
                          (store! sp sp0)
                          (store! (field sl present) true)
                          (store! (field sl e) (load (field sp e)))
                          (store! (field sl t) (load (field sp t)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

;;; A `(fnptr-of f)` argument was synthesized before inference knew the pointer
;;; type it must have, so it is `f`'s own pointer, which takes a struct or sum
;;; `(ref T)`. When the parameter, now that its type arguments are known, is a `c`
;;; pointer taking that `T` by value, take the pointer again against that type:
;;; it is then a forwarder with the by-value C entry, as it would be had the
;;; parameter type been written out.
(defn ca-resynth-fnptr-entries [(a (dyn Allocator))
                                (argl (ptr (ArrayList ArgSlot)))
                                (sig (ptr Sig))
                                (subst (ptr (ArrayList SubstEntry)))
                                (args (ptr (ArrayList Expr)))
                                (env (ptr (ArrayList EnvEntry)))
                                (cx (ptr Cx))
                                (tps (ptr (ArrayList (slice u8))))
                                (fname (slice u8))] (-> (Result i64 Diag))
  (try (let [params (subst-apply-list a (load (field sig params)) subst)
             n (if (< (len (load params)) (len (load argl)))
                   (len (load params))
                   (len (load argl)))]
         (for [i 0 n]
           (let [sl (elem argl i)
                 arg (elem args i)
                 wp (elem params i)]
             (when (and (.present sl)
                        (match (.kind arg) (EFnPtrOf [_] true) (_ false)))
               (when (fnptr-wants-by-value-c-entry? cx (.t sl) wp)
                 (let [sp (primitive/alloc-stack SynPair)]
                   (set! sp (try! (do-synth a arg wp env cx tps fname)))
                   (set! (.e sl) (load (field sp e)))
                   (set! (.t sl) (load (field sp t)))
                   0))
               0)
             0))
         (Ok [i64 Diag] 0))))

(defn ca-final-coerce [(a (dyn Allocator))
                       (argl (ptr (ArrayList ArgSlot)))
                       (sig (ptr Sig))
                       (subst (ptr (ArrayList SubstEntry)))
                       (args (ptr (ArrayList Expr)))
                       (func (slice u8))
                       (fname (slice u8))] (-> (Result (ptr (ArrayList Expr))
                                                       Diag))
  (let [params (subst-apply-list a (load (field sig params)) subst)
        is_extern (.is_extern sig)
        n (len (load args))
        (mut out) (ArrayList::new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (reserve! (mut out) n)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sl (elem argl (load i))
                      want (load (elem params (load i)))
                      wp (box-type a want)
                      ismut (is-mut-borrow (elem args (load i)))
                      what
                        (sconcat a
                                 (sconcat a
                                          (sconcat3 a
                                                    "argument "
                                                    (i64->str a
                                                              (primitive/iadd (load i)
                                                                              1))
                                                    " to '")
                                          func)
                                 "'")]
                  (match (coerce-arg a
                                     ismut
                                     (load (load (field sl e)))
                                     (load (field sl
                                                  t))
                                     wp
                                     is_extern
                                     fname
                                     what)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [ce] (push! (mut out) ce))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Expr)) Diag] (load err))
        (Ok (box-al [Expr] a (load out))))))

(defn method-index-of [(td (ptr TraitDef)) (func (slice u8))] (-> i64)
  (let [ms (load (field td methods))
        n (len (load ms))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem ms (load i)) name))
                         func)
                  (store! r
                          (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn dyn-dispatch-args [(a (dyn Allocator))
                         (tm (ptr TraitMethod))
                         (self_idx i64)
                         (func (slice u8))
                         (args (ptr (ArrayList Expr)))
                         (env (ptr (ArrayList EnvEntry)))
                         (cx (ptr Cx))
                         (tps (ptr (ArrayList (slice u8))))
                         (fname (slice u8))
                         (elo i64)
                         (ehi i64)
                         (esrc i64)
                         (ectxt i64)
                         (params (ptr (ArrayList Type)))
                         (newargs (ptr (ArrayList Expr)))] (-> (Result i64 Diag))
  (let [ps (load (field tm params))
        n (len (load args))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (unless (= (load i) self_idx)
                  (let [raw (field (elem ps (load i)) ty)
                        want (box-type a (param-ref-type cx raw tps))
                        exp
                          (if (= (type-tag raw) 5)
                              (t-inner raw)
                              raw)
                        ismut (is-mut-borrow (elem args (load i)))
                        what (sconcat1 a (sconcat3 a "argument to '" func "'"))]
                    (match (synth-arg a
                                     (elem args (load i))
                                     exp
                                     (= (type-tag want) 5)
                                     env
                                     cx
                                     tps
                                     fname)
                      (Err [d] (do (store! err d) (store! failed true) (break)))
                      (Ok [sp0]
                          (let [sp (primitive/alloc-stack SynPair)]
                            (store! sp sp0)
                            (match (maybe-coerce-dyn a
                                                     cx
                                                     (load (field sp e))
                                                     (load (field sp t))
                                                     raw
                                                     elo
                                                     ehi
                                                     esrc
                                                     ectxt
                                                     fname)
                              (Err [d]
                                   (do
                                     (store! err d)
                                     (store! failed true)
                                     (break)))
                              (Ok [mp0]
                                  (let [mp (primitive/alloc-stack SynPair)]
                                    (store! mp mp0)
                                    (match (coerce-arg a
                                                       ismut
                                                       (load (load (field mp e)))
                                                       (load (field mp t))
                                                       want
                                                       false
                                                       fname
                                                       what)
                                      (Err [d]
                                           (do
                                             (store! err d)
                                             (store! failed true)
                                             (break)))
                                      (Ok [ce]
                                          (do
                                            (push! [Expr] newargs ce)
                                            (push! [Type]
                                                   params
                                                   (erase-refs a want))
                                            0)))))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn synth-dyn-dispatch [(a (dyn Allocator))
                          (cx (ptr Cx))
                          (func (slice u8))
                          (self_name (slice u8))
                          (self_idx i64)
                          (td (ptr TraitDef))
                          (tm (ptr TraitMethod))
                          (args (ptr (ArrayList Expr)))
                          (env (ptr (ArrayList EnvEntry)))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))
                          (elo i64)
                          (ehi i64)
                          (esrc i64)
                          (ectxt i64)] (-> (Result EvalPair Diag))
  (let [mi (method-index-of td func)
        dyn_ty (box-type a (TStruct self_name))]
    (match (do-synth a (elem args self_idx) dyn_ty env cx tps fname)
      (Err [d] (err-ep d))
      (Ok [rsp0]
          (let [rsp (primitive/alloc-stack SynPair)]
            (set! rsp rsp0)
            (match (coerce a
                           (load (load (field rsp e)))
                           (load (field rsp t))
                           dyn_ty
                           false
                           fname
                           "trait-object receiver")
              (Err [d] (err-ep d))
              (Ok [recv]
                  (let [params (box-al [Type] a (ArrayList::new [Type] a))
                        newargs (box-al [Expr] a (ArrayList::new [Expr] a))]
                    (push! [Type] params (TPtr (box-type a (TInt 8 false))))
                    (match (dyn-dispatch-args a
                                              tm
                                              self_idx
                                              func
                                              args
                                              env
                                              cx
                                              tps
                                              fname
                                              elo
                                              ehi
                                              esrc
                                              ectxt
                                              params
                                              newargs)
                      (Err [d] (err-ep d))
                      (Ok [_]
                          (let [vtable_struct
                                  (sconcat a
                                           (subslice [u8]
                                                     self_name
                                                     0
                                                     (primitive/isub (len self_name)
                                                                     4))
                                           "-vtable")]
                            (ok-ep (mk-expr (EDynDispatch (box! a DynCall (DynCall :dyn_struct self_name
                                              :vtable_struct vtable_struct
                                              :method_index mi
                                              :cc (c-convention)
                                              :params params
                                              :ret (.ret tm)
                                              :recv (box-expr a recv)
                                              :args newargs)))
                                            elo
                                            ehi
                                            esrc
                                            ectxt)
                                   (.ret tm)))))))))))))

(defn synth-call-general [(a (dyn Allocator))
                          (func (slice u8))
                          (call_func (slice u8))
                          (type_args (ptr (ArrayList Type)))
                          (args (ptr (ArrayList Expr)))
                          (expected (ptr Type))
                          (env (ptr (ArrayList EnvEntry)))
                          (cx (ptr Cx))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))
                          (elo i64)
                          (ehi i64)
                          (esrc i64)
                          (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [sig (sig-find cx call_func)]
           (when (= (primitive/cast i64 sig) 0)
             (break :try (err-ep (derr (undefined-call-msg a cx fname func)))))
           (let [nparams (len (load (field sig params)))
                 nargs (len (load args))
                 variadic (load (field sig variadic))
                 arity_ok (sig-takes-arity? sig nargs)]
             (when (not arity_ok)
               ; If a trait method shares this function's simple name, say so —
               ; the arity-directed fallback rescues arity MISmatches, so getting
               ; here with a colliding method in scope means the arities tie (or
               ; another path bypassed the dispatch), and `Trait::method` is the
               ; explicit spelling that resolves it.
               (let [simple (after-last-dot func)
                     coll
                       (if (methods-has cx simple)
                           (method-trait-of cx simple)
                           "")
                     hint
                       (if (= (len coll) 0)
                           ""
                           (sconcat a
                                    (sconcat4 a
                                              "; trait '"
                                              (display-name coll)
                                              "' also declares '"
                                              (sconcat a simple "' — write "))
                                    (sconcat3 a
                                              (after-last-dot coll)
                                              "::"
                                              (sconcat a simple " to call it"))))]
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat a
                                                          (sconcat a
                                                                   (sconcat a
                                                                            (sconcat4 a
                                                                                      "in '"
                                                                                      fname
                                                                                      "': '"
                                                                                      (sconcat a
                                                                                               func
                                                                                               "' expects "))
                                                                            (if variadic
                                                                                "at least "
                                                                                ""))
                                                                   (i64->str a
                                                                             nparams))
                                                          (sconcat a
                                                                   " args, got "
                                                                   (i64->str a
                                                                             nargs)))
                                                 hint))))))
             (if (= (len (load (field sig type_params))) 0)
                 (do
                   (when (> (len (load type_args)) 0)
                     (break :try
                              (err-ep (derr (sconcat1 a
                                                      (sconcat5 a
                                                                "in '"
                                                                fname
                                                                "': '"
                                                                func
                                                                "' is not generic but got type arguments"))))))
                   (let [new_args
                           (try! (ca-nongeneric a
                                                sig
                                                args
                                                func
                                                elo
                                                ehi
                                                esrc
                                                ectxt
                                                env
                                                cx
                                                tps
                                                fname))]
                     (return-from :try
                                    (ok-ep (mk-expr (ECall
                                                      :func call_func
                                                      :type_args
                                                        (box-items-type a)
                                                      :args new_args)
                                                    elo
                                                    ehi
                                                    esrc
                                                    ectxt)
                                           (load (field sig ret))))))
                 (let [defs (box-al [Deferred] a (ArrayList::new [Deferred] a))
                       argl (ca-build-arglist a args defs env cx tps fname)
                       partial-subst
                         (try! (solve-type-args a
                                                (load (field sig type_params))
                                                (load (field sig bounds))
                                                (load (field sig params))
                                                type_args
                                                argl
                                                (field sig ret)
                                                expected
                                                cx
                                                tps
                                                fname
                                                func
                                                true))]
                   (try! (ca-check-bounds a
                                          sig
                                          partial-subst
                                          func
                                          args
                                          cx
                                          fname
                                          elo
                                          ehi
                                          esrc
                                          ectxt))
                   (try! (ca-resynth-deferred a
                                              defs
                                              argl
                                              sig
                                              partial-subst
                                              args
                                              env
                                              cx
                                              tps
                                              fname))
                   (try! (ca-resynth-fnptr-entries a
                                                   argl
                                                   sig
                                                   partial-subst
                                                   args
                                                   env
                                                   cx
                                                   tps
                                                   fname))
                   ; Deferred arguments now have concrete types. Re-solve from the
                   ; complete positional list so callback/container parameters and
                   ; return types all participate, then require every type argument.
                   (let [subst
                           (try! (solve-type-args a
                                                  (load (field sig type_params))
                                                  (load (field sig bounds))
                                                  (load (field sig params))
                                                  type_args
                                                  argl
                                                  (field sig ret)
                                                  expected
                                                  cx
                                                  tps
                                                  fname
                                                  func
                                                  false))]
                     (try! (ca-check-bounds a
                                            sig
                                            subst
                                            func
                                            args
                                            cx
                                            fname
                                            elo
                                            ehi
                                            esrc
                                            ectxt))
                     (try! (ca-resynth-weak-literals a
                                                     argl
                                                     sig
                                                     subst
                                                     args
                                                     env
                                                     cx
                                                     tps
                                                     fname))
                     (let [new_args
                             (try! (ca-final-coerce a
                                                    argl
                                                    sig
                                                    subst
                                                    args
                                                    func
                                                    fname))
                           out_targs
                             (subst-targs a
                                          (load (field sig type_params))
                                          subst)
                           ret (subst-apply a (field sig ret) subst)]
                       ; call_func, not func: a trait-method call on a concrete receiver
                       ; was rewritten to the impl's lowered function — GENERIC for a
                       ; generic impl, so it lands here.
                       (ok-ep (mk-expr (ECall
                                         :func call_func
                                         :type_args out_targs
                                         :args new_args)
                                       elo
                                       ehi
                                       esrc
                                       ectxt)
                              ret))))))))))

(defn synth-inherent-general [(a (dyn Allocator))
                              (func (slice u8))
                              (call-func (slice u8))
                              (type-args (ptr (ArrayList Type)))
                              (args (ptr (ArrayList Expr)))
                              (expected (ptr Type))
                              (env (ptr (ArrayList EnvEntry)))
                              (cx (ptr Cx))
                              (tps (ptr (ArrayList (slice u8))))
                              (fname (slice u8))
                              (elo i64)
                              (ehi i64)
                              (esrc i64)
                              (ectxt i64)] (-> (Result (Option EvalPair) Diag))
  (match (synth-call-general a
                             func
                             call-func
                             type-args
                             args
                             expected
                             env
                             cx
                             tps
                             fname
                             elo
                             ehi
                             esrc
                             ectxt)
    (Err [d] (Err [(Option EvalPair) Diag] d))
    (Ok [ep] (Ok [(Option EvalPair) Diag] (Some [EvalPair] ep)))))

; Try inherent dispatch without stealing ordinary or trait calls. A qualified
; `Type::name` first considers receiverless associated functions, then receiver
; methods. A bare `name` considers receiver methods only and infers the owner from
; argument zero. None means "not an inherent call" and the existing trait/general
; resolution continues unchanged.
(defn synth-inherent-call [(a (dyn Allocator))
                           (func (slice u8))
                           (mname (slice u8))
                           (qual (slice u8))
                           (qualified bool)
                           (type-args (ptr (ArrayList Type)))
                           (args (ptr (ArrayList Expr)))
                           (expected (ptr Type))
                           (env (ptr (ArrayList EnvEntry)))
                           (cx (ptr Cx))
                           (tps (ptr (ArrayList (slice u8))))
                           (fname (slice u8))
                           (elo i64)
                           (ehi i64)
                           (esrc i64)
                           (ectxt i64)] (-> (Result (Option EvalPair) Diag))
  (try (do
         (when qualified
           (let [asel (primitive/alloc-stack ImplSel)]
             (store! asel (inherent-associated-select a cx mname qual))
             (when (load (field asel ambiguous))
               (break :try
                        (Err [(Option EvalPair) Diag]
                             (derr (sconcat a
                                            (sconcat5 a
                                                      "in '"
                                                      fname
                                                      "': inherent method qualifier '"
                                                      qual
                                                      "' is ambiguous for '")
                                            (sconcat a mname "'"))))))
             (let [aip (load (field asel ip))]
               (unless (= (primitive/cast i64 aip) 0)
                 (return-from :try
                                (synth-inherent-general a
                                                        func
                                                        (inherent-fn-name a
                                                                          aip
                                                                          mname)
                                                        type-args
                                                        args
                                                        expected
                                                        env
                                                        cx
                                                        tps
                                                        fname
                                                        elo
                                                        ehi
                                                        esrc
                                                        ectxt))))))
         (when (and (> (len (load args)) 0)
                    (inherent-has-name cx mname))
           (let [sp0
                   (try! (do-synth a
                                   (elem args 0)
                                   (null-type)
                                   env
                                   cx
                                   tps
                                   fname))
                 sp (primitive/alloc-stack SynPair)]
             (store! sp sp0)
             (let [recv (load (field sp t))
                   sel (primitive/alloc-stack ImplSel)]
               (store! sel
                       (inherent-select-deref a
                                              cx
                                              mname
                                              (if qualified qual "")
                                              recv))
               (when (load (field sel ambiguous))
                 (break :try
                          (Err [(Option EvalPair) Diag]
                               (derr (sconcat a
                                              (sconcat5 a
                                                        "in '"
                                                        fname
                                                        "': ambiguous inherent method '"
                                                        mname
                                                        "' for '")
                                              (sconcat a (ty-str a recv) "'"))))))
               (let [ip (load (field sel ip))]
                 (unless (= (primitive/cast i64 ip) 0)
                   (return-from :try
                                  (synth-inherent-general a
                                                          func
                                                          (inherent-fn-name a
                                                                            ip
                                                                            mname)
                                                          type-args
                                                          args
                                                          expected
                                                          env
                                                          cx
                                                          tps
                                                          fname
                                                          elo
                                                          ehi
                                                          esrc
                                                          ectxt)))))))
         (Ok [(Option EvalPair) Diag] (None [EvalPair])))))

;;; The trait that gives a value of type `t` its `call` when `t` (or what it
;;; borrows) is a type parameter: the one trait among the parameter's bounds,
;;; supertraits included, that declares a `call` method. None when `t` is not a
;;; type parameter or no bound declares one; an error when two do.
(defn bound-call-trait [(a (dyn Allocator))
                        (cx (ptr Cx))
                        (t (ptr Type))
                        (tps (ptr (ArrayList (slice u8))))] (-> (Result (Option (slice u8)) Diag))
  (let [target (match (load t) (TRef [_ inner] inner) (TPtr [inner] inner) (_ t))]
    (match (load target)
      (TStruct [n]
               (if (not (set-contains tps n))
                   (Ok (None [(slice u8)]))
                   (let [bounds (field cx cur_bounds)
                         (mut found) (None [(slice u8)])
                         (mut twice) false]
                     (for [i 0 (len (load bounds))]
                       (let [bp (elem bounds i)]
                         (when (= (.name bp) n)
                           (for [k 0 (len (load (.traits bp)))]
                             (let [tr (.name (elem (.traits bp) k))
                                   td (trait-find cx tr)]
                               (when (and (!= (primitive/cast i64 td) 0)
                                          (!= (primitive/cast i64 (trait-method-find td "call")) 0))
                                 (match (load found)
                                   (Some [prior] (unless (= prior tr) (set! twice true) 0))
                                   (None [] (set! found (Some tr))))
                                 0)))
                           0)))
                     (if (load twice)
                         (Err (derr (sconcat3 a "type parameter '" n
                                              "' has more than one bound that declares 'call'; call it qualified, as (Trait::call f …)")))
                         (Ok (load found))))))
      (_ (Ok (None [(slice u8)]))))))

; A symbol in call-head position may name a value instead of a global function.
; Find an ordinary trait impl that defines `call`, prepend the receiver, and lower
; directly to that impl method. No trait name or namespace is privileged here.
(defn synth-callable-value [(a (dyn Allocator))
                            (name (slice u8))
                            (node-id i64)
                            (args (ptr (ArrayList Expr)))
                            (expected (ptr Type))
                            (env (ptr (ArrayList EnvEntry)))
                            (cx (ptr Cx))
                            (tps (ptr (ArrayList (slice u8))))
                            (fname (slice u8))
                            (elo i64)
                            (ehi i64)
                            (esrc i64)
                            (ectxt i64)] (-> (Result EvalPair Diag))
  (try (let [head (box-expr a (mk-expr (EVar name) elo ehi esrc ectxt))
             hsp0 (try! (do-synth a head (null-type) env cx tps fname))
             hsp (primitive/alloc-stack SynPair)]
         (store! hsp hsp0)
         ; A value whose type is a type parameter is called through the bound that
         ; gives it `call`: `(f x)` is `(Callable::call f x)` there, a deferred trait
         ; call that specialization resolves to the instance's impl.
         (match (bound-call-trait a cx (load (field hsp t)) tps)
           (Err [d] (break :try (err-ep d)))
           (Ok [found]
               (match found
                 (Some [tr]
                       (let [(mut all) (ArrayList::new [Expr] a)]
                         (push! (mut all) (mk-expr (EVar name) elo ehi esrc ectxt))
                         (for [i 0 (len (load args))] (push! (mut all) (get (load args) i)))
                         (break :try
                                  (synth a
                                            (box-expr a
                                                      (mk-expr (ECall :func (sconcat3 a tr "::" "call")
                                                                      :type_args (box-items-type a)
                                                                      :args (box-al [Expr] a (load all)))
                                                               elo ehi esrc ectxt))
                                            expected env cx tps fname))))
                 (None [] 0))))
         (let [recv (load (field hsp t))
               traits (field cx trait_defs)
               nt (len (load traits))
               (mut ti) 0
               (mut found) (primitive/cast (ptr ImplDef) 0)
               (mut ambiguous) false]
           (loop (if (>= (load ti) nt)
                     (break)
                     (do
                       (let [tr0
                               (load (field (elem traits
                                                  (load ti))
                                            name))
                             self0 (deref-to-impl a cx tr0 recv tps)
                             sel0 (primitive/alloc-stack ImplSel)]
                         (store! sel0 (cx-impl-select a cx tr0 self0))
                         (let [ip0 (load (field sel0 ip))]
                           (when (and (!= (primitive/cast i64 ip0)
                                          0)
                                      (!= (primitive/cast i64
                                                          (impl-find-method ip0
                                                                            "call"))
                                          0))
                             (if (= (primitive/cast i64 (load found))
                                    0)
                                 (store! found ip0)
                                 (when (!= (primitive/cast i64 (load found))
                                           (primitive/cast i64 ip0))
                                   (store! ambiguous true))))))
                       (store! ti (primitive/iadd (load ti) 1)))))
           (when (= (primitive/cast i64 (load found)) 0)
             (break :try
                      (err-ep (derr (if (shadowed-call? esrc node-id)
                                        (sconcat a
                                                 (sconcat4 a
                                                           "in '"
                                                           fname
                                                           "': '"
                                                           name)
                                                 "' is a local binding here, so it names the local rather than the macro of that name; the local is not callable")
                                        (sconcat a
                                                 (sconcat4 a
                                                           "in '"
                                                           fname
                                                           "': value of type '"
                                                           (ty-str a recv))
                                                 "' is not callable"))))))
           (when (load ambiguous)
             (break :try
                      (err-ep (derr (sconcat a
                                             (sconcat4 a
                                                       "in '"
                                                       fname
                                                       "': ambiguous call implementations for '"
                                                       (ty-str a recv))
                                             "'")))))
           (let [ip (load found)
                 tr (impl-trait-name ip)
                 method (impl-find-method ip "call")]
             (let [(mut all) (ArrayList::new [Expr] a)
                   n (len (load args))
                   (mut i) 0]
               (push! (mut all) (load (load (field hsp e))))
               (loop (if (>= (load i) n)
                         (break)
                         (do
                           (push! (mut all) (get (load args) (load i)))
                           (store! i (primitive/iadd (load i) 1)))))
               (synth-call-general a
                                   name
                                   (tmfn a
                                         tr
                                         (impl-mangle-key a
                                                          (field ip self_type)
                                                          (load (field ip
                                                                       type_params)))
                                         "call")
                                   (box-items-type a)
                                   (box-al [Expr] a (load all))
                                   expected
                                   env
                                   cx
                                   tps
                                   fname
                                   elo
                                   ehi
                                   esrc
                                   ectxt)))))))

;;; Core's associative arithmetic and bitwise operators, which accept any number of
;;; operands past two by folding left. A macro template names them qualified,
;;; `coil.core.+`, since its names resolve where it was written.
(defn variadic-operator? [(func (slice u8))] (-> bool)
  (or (core-operator? func "+") (core-operator? func "-") (core-operator? func "*")
      (core-operator? func "/") (core-operator? func "&") (core-operator? func "|")
      (core-operator? func "^")))

;;; Is `func` core's operator `op`, as the resolver leaves it or qualified?
(defn core-operator? [(func (slice u8)) (op (slice u8))] (-> bool)
  (or (= func op) (core-name? func op)))

;;; `(op a b c …)` as `(op (op a b) c) …`, and `(- x)` as `(neg x)`. Nil when the
;;; call is already binary. Only core's operators, which the resolver leaves
;;; unqualified, are rewritten; a local or module definition of the name is not.
(defn operator-call-rewrite [(a (dyn Allocator))
                             (func (slice u8))
                             (args (ptr (ArrayList Expr)))
                             (env (ptr (ArrayList EnvEntry)))
                             (elo i64)
                             (ehi i64)
                             (esrc i64)
                             (ectxt i64)] (-> (Option Expr))
  (let [n (len (load args))]
    (cond (!= (cast i64 (env-get env func)) 0) (None)
          (and (core-operator? func "-") (= n 1))
            (Some (mk-expr (ECall
                             :func (if (= func "-") "neg" (core-name "neg"))
                             :type_args (box-al [Type] a (ArrayList::new [Type] a))
                             :args args)
                           elo
                           ehi
                           esrc
                           ectxt))
          (and (variadic-operator? func) (> n 2))
            (let [(mut acc) (get (load args) 0)]
              (for i (range 1 n)
                (let [(mut pair) (ArrayList::new [Expr] a)]
                  (push! (mut pair) (load acc))
                  (push! (mut pair) (get (load args) i))
                  (set! acc
                        (mk-expr (ECall
                                   :func func
                                   :type_args (box-al [Type] a (ArrayList::new [Type] a))
                                   :args (box-al [Expr] a (load pair)))
                                 elo
                                 ehi
                                 esrc
                                 ectxt))))
              (Some (load acc)))
          :else (None))))

(defn synth-call [(a (dyn Allocator))
                  (func (slice u8))
                  (node-id i64)
                  (type_args (ptr (ArrayList Type)))
                  (args (ptr (ArrayList Expr)))
                  (expected (ptr Type))
                  (env (ptr (ArrayList EnvEntry)))
                  (cx (ptr Cx))
                  (tps (ptr (ArrayList (slice u8))))
                  (fname (slice u8))
                  (elo i64)
                  (ehi i64)
                  (esrc i64)
                  (ectxt i64)] (-> (Result EvalPair Diag))
  (match (operator-call-rewrite a func args env elo ehi esrc ectxt)
    (Some [rewritten] (synth a (box-expr a rewritten) expected env cx tps fname))
    (None [] (synth-call-direct a func node-id type_args args expected env cx tps fname elo ehi esrc ectxt))))

(defn synth-call-direct [(a (dyn Allocator))
                         (func (slice u8))
                         (node-id i64)
                         (type_args (ptr (ArrayList Type)))
                         (args (ptr (ArrayList Expr)))
                         (expected (ptr Type))
                         (env (ptr (ArrayList EnvEntry)))
                         (cx (ptr Cx))
                         (tps (ptr (ArrayList (slice u8))))
                         (fname (slice u8))
                         (elo i64)
                         (ehi i64)
                         (esrc i64)
                         (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [outer (load (field cx anon_outer_env))]
           (when (and (= (primitive/cast i64 (env-get env func))
                         0)
                      (and (!= (primitive/cast i64 outer)
                               0)
                           (!= (primitive/cast i64 (env-get outer func))
                               0)))
             (break :try
                      (err-ep (derr-at-src esrc
                                           elo
                                           ehi
                                           (sconcat a
                                                    (sconcat4 a
                                                              "anonymous fn cannot capture local '"
                                                              (display-ident func)
                                                              "' from enclosing function '"
                                                              fname)
                                                    "'; pass it as an explicit parameter or use coil.closure/defclosure"))))))
         ; Locals shadow global function names in call-head position. A global
         ; const is also a value head when no local of that name exists.
         (when (or (!= (primitive/cast i64 (env-get env func))
                       0)
                   (and (= (primitive/cast i64 (sig-find cx func))
                           0)
                        (!= (primitive/cast i64 (const-find cx func))
                            0)))
           ; A def annotated with :params knows its arity; say so rather than
           ; letting the Callable pack report a type conflict.
           (match (declared-param-names cx env func)
             (None [] 0)
             (Some [decl-names]
             (when (!= (len (load decl-names)) (len (load args)))
               (break :try
                        (err-ep (derr-at-src esrc
                                             elo
                                             ehi
                                             (sconcat a
                                                      (sconcat4 a
                                                                "in '"
                                                                fname
                                                                "': '"
                                                                (display-ident func))
                                                      (sconcat4 a
                                                                "' expects "
                                                                (i64->str a (len (load decl-names)))
                                                                " argument(s), got "
                                                                (i64->str a (len (load args)))))))))
             0))
           (return-from :try
                          (synth-callable-value a
                                                func
                                                node-id
                                                args
                                                expected
                                                env
                                                cx
                                                tps
                                                fname
                                                elo
                                                ehi
                                                esrc
                                                ectxt)))
         (when (!= (primitive/cast i64 (vts-find cx func))
                   0)
           (break :try
                    (synth-construct a
                                     func
                                     type_args
                                     args
                                     expected
                                     env
                                     cx
                                     tps
                                     fname
                                     elo
                                     ehi
                                     esrc
                                     ectxt)))
         ; A `Trait::method` head (gen-6) splits into the qualifier and the bare method
         ; name; `resolve-method-qual` then pins dispatch to the named trait. A plain call
         ; has no `::`, so `qual` is "" and `mname` is `func` — the original path, unchanged.
         (let [cc (find-coloncolon func)
               ;; A head may reach here in three shapes, and all three name the same
               ;; thing when the tail is a trait method:
               ;;
               ;;   =                 bare — resolved from the use site's scope
               ;;   Eq::=             explicit trait qualifier (gen-6)
               ;;   coil.core.=       MODULE-qualified, written by macro hygiene
               ;;
               ;; The third is new. Referential hygiene qualifies a macro template's
               ;; symbols to the macro's own module so they cannot be captured by the
               ;; caller, and trait methods must take part in that like every other
               ;; name — otherwise a template's `(= x y)` binds to whatever `=` the
               ;; CALLER happens to have, which is how `(assert-eq 1 999)` came to
               ;; pass. See docs/design/TRAIT_METHOD_HYGIENE.md.
               ;;
               ;; Splitting on the last dot recovers the method name. The prefix is a
               ;; MODULE, not a trait, so it is deliberately NOT used as `qual` —
               ;; that would ask "which trait is named coil.core?" and find none.
               ;; Which impl runs is still decided by the argument's type below; this
               ;; only recovers which NAME was meant.
               dotted-m
                 (if (>= cc 0) "" (after-last-dot func))
               ;; …but a dotted head that names a REAL function or extern is a
               ;; RESOLVER-qualified reference, not a hygiene-qualified method.
               ;; `coil.io.read` (the POSIX extern, qualified by resolve inside
               ;; coil.io itself) must stay a function call even when some
               ;; unrelated module declares a trait method named `read` — without
               ;; this guard that program stopped compiling with an arity error
               ;; from the hijacked trait. A hygiene-qualified method never
               ;; collides here: `coil.core.=` names no defn or extern, so
               ;; sig-find misses and the method interpretation proceeds.
               dotted?
                 (and (< cc 0)
                      (and (!= (len dotted-m) (len func))
                           (and (methods-has cx dotted-m)
                                (= (primitive/cast i64 (sig-find cx func))
                                   0))))
               ;; The ARITY-DIRECTED FALLBACK — the same guard's other direction.
               ;; The head names a real function, but that function cannot take
               ;; this many arguments, and a declared trait method with the same
               ;; simple name can. The canonical collision is POSIX names:
               ;; `(read c)` in a module whose trait declares a 1-arg `read`,
               ;; while `:use *` of coil.io resolver-qualified the head to the
               ;; 3-arg extern. The function still wins whenever its arity fits,
               ;; so no compiling program changes meaning — only calls that were
               ;; hard arity errors gain the method reading. WHICH trait, and
               ;; whether the use site really has it in scope, is judged by the
               ;; ordinary method-resolution path this routes into. And it only
               ;; applies when the RESOLVER wrote the qualification: a user who
               ;; typed `(coil.io.read c)` or `(io/read c)` named that function
               ;; explicitly, so a wrong arity there stays a hard error
               ;; (head-was-implicit?, recorded at the resolver's ECall rewrite).
               arity-fb?
                 (and (< cc 0)
                      (and (not dotted?)
                           (and (!= (len dotted-m) (len func))
                                (and (methods-has cx dotted-m)
                                     (let [sg (sig-find cx func)]
                                       (and (!= (primitive/cast i64 sg)
                                                0)
                                            (and (not (sig-arity-ok? sg
                                                                     (len (load args))))
                                                 (and (method-arity-matches? cx
                                                                             dotted-m
                                                                             (len (load args)))
                                                      (head-was-implicit? node-id)))))))))
               ;; The module prefix DISAMBIGUATES. `MethodEntry.trait` is the fully
               ;; qualified trait name (`hyglib5.Mine`), so a head of
               ;; `hyglib5.mine` selects the trait declared in that module — which
               ;; is exactly what lexical scope should mean: the macro's module
               ;; decides which trait its template named, even when the caller has
               ;; a same-named method of its own in scope. Without this the call is
               ;; reported ambiguous, which is the old capture bug wearing a
               ;; diagnostic instead of silently choosing wrong.
               ;; NOT set for arity-fb?: there the prefix names the module of the
               ;; FUNCTION the call is falling away from, which must not steer
               ;; trait selection — the use site's ordinary scope decides.
               dotted-mod
                 (if dotted?
                     (subslice [u8]
                               func
                               0
                               (primitive/isub (len func)
                                               (primitive/iadd (len dotted-m) 1)))
                     "")
               qual
                 (if (>= cc 0)
                     (subslice [u8] func 0 cc)
                     "")
               mname
                 (if (>= cc 0)
                     (subslice [u8] func (primitive/iadd cc 2) (len func))
                     (if (or dotted? arity-fb?) dotted-m func))]
           (when (and (>= cc 0)
                      (not (method-qualifier-known? cx qual tps)))
             (break :try
                      (err-ep (derr (sconcat a
                                             (sconcat5 a
                                                       "in '"
                                                       fname
                                                       "': unknown type '"
                                                       qual
                                                       "' in '")
                                             (with-removed-hint a
                                                                (sconcat a func "'; import the module that declares it")
                                                                (fn-unknown-hint a cx fname qual)))))))
           ; An unresolved template identifier keeps its scoped key for lexical
           ; lookup. Once local values have been handled above, an inherent call
           ; can use its definition-site spelling for receiver-based dispatch.
           ; Prefer an exact generated method key, and never strip a module-neutral
           ; fresh identifier: its spelling alone does not establish a binding.
           (let [inherent-name
                   (if (and (scoped-ident? mname)
                            (and (!= (scoped-ident-module mname) "")
                                 (not (inherent-has-name cx mname))))
                       (scoped-ident-raw mname)
                       mname)
                 inh
                   (try! (synth-inherent-call a
                                              func
                                              inherent-name
                                              qual
                                              (>= cc 0)
                                              type_args
                                              args
                                              expected
                                              env
                                              cx
                                              tps
                                              fname
                                              elo
                                              ehi
                                              esrc
                                              ectxt))]
             (match inh
               (Some [ep] (return-from :try (Ok [EvalPair Diag] ep)))
               (None [] 0)))
           (when (methods-has cx mname)
             (return-from :try
                            (synth-trait-method-call a
                                                     func
                                                     mname
                                                     qual
                                                     dotted-mod
                                                     type_args
                                                     args
                                                     expected
                                                     env
                                                     cx
                                                     tps
                                                     fname
                                                     elo
                                                     ehi
                                                     esrc
                                                     ectxt)))
           ; `mname` is neither an inherent nor trait method. A bare call falls
           ; through to the general path; a qualified head promised a method.
           ; Resolution qualified the head's type; name it by its last component.
           (when (>= cc 0)
             (break :try
                      (err-ep (derr (sconcat a
                                             (sconcat5 a
                                                       "in '"
                                                       fname
                                                       "': '"
                                                       (sconcat3 a (after-last-dot qual) "::" mname)
                                                       "' names no trait method '")
                                             (sconcat3 a
                                                       mname
                                                       "' or inherent method '"
                                                       (sconcat a mname "'")))))))
           ; The head names a free function. When that function rejects the call,
           ; the methods of the first argument's type get their turn (see
           ; `synth-method-fallback`); a call it accepts is never reinterpreted.
           (match (synth-call-general a
                                      func
                                      func
                                      type_args
                                      args
                                      expected
                                      env
                                      cx
                                      tps
                                      fname
                                      elo
                                      ehi
                                      esrc
                                      ectxt)
             (Ok [ep] (Ok [EvalPair Diag] ep))
             (Err [d]
               (if (and (< cc 0) (head-was-implicit? node-id))
                   (synth-method-fallback a
                                          func
                                          d
                                          type_args
                                          args
                                          expected
                                          env
                                          cx
                                          tps
                                          fname
                                          elo
                                          ehi
                                          esrc
                                          ectxt)
                   (Err [EvalPair Diag] d))))))))

;;; A call whose head names a trait method: pick the trait, then the impl by the
;;; type of the argument in the method's Self position, and check the call against
;;; that impl's function. A receiver whose type is a type parameter makes a
;;; deferred trait call that mono resolves once the parameter is concrete.
(defn synth-trait-method-call [(a (dyn Allocator))
                               (func (slice u8))
                               (mname (slice u8))
                               (qual (slice u8))
                               (dotted-mod (slice u8))
                               (type_args (ptr (ArrayList Type)))
                               (args (ptr (ArrayList Expr)))
                               (expected (ptr Type))
                               (env (ptr (ArrayList EnvEntry)))
                               (cx (ptr Cx))
                               (tps (ptr (ArrayList (slice u8))))
                               (fname (slice u8))
                               (elo i64)
                               (ehi i64)
                               (esrc i64)
                               (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [(mut call_func) func]
         (let [me0
                 (try! (resolve-method-mod a
                                           cx
                                           mname
                                           qual
                                           dotted-mod
                                           fname))
               me (primitive/alloc-stack MethodEntry)]
           (store! me me0)
           (let [trait_name (load (field me trait))
                 self_idx (load (field me self_idx))
                 td (trait-find cx (load (field me trait)))
                 tm
                   (trait-method-find (trait-find cx
                                                  (load (field me trait)))
                                      mname)
                 self_pname (load (field td self_param))]
             ; The implementation is chosen by the type of the argument in the
             ; method's Self position, so a call too short to have one -- `(+)`,
             ; `(set!)` -- has nothing to choose by. Reading that argument anyway
             ; read past the end of the list.
             (when (>= self_idx (len (load args)))
               (break :try
                        (err-ep (derr-at-src esrc
                                             elo
                                             ehi
                                             (sconcat a
                                                      (sconcat4 a
                                                                "'"
                                                                (display-ident mname)
                                                                "' is a method of trait '"
                                                                (display-ident trait_name))
                                                      (sconcat3 a
                                                                "' and needs at least "
                                                                (i64->str a (primitive/iadd self_idx 1))
                                                                " argument(s): the implementation is chosen by that argument's type"))))))
             (let [self-arg (elem args self_idx)
                   ; A literal receiver takes its type from the operand
                   ; beside it: `(- 8 x)` with a u8 `x` is u8 subtraction.
                   peer (if (is-literal self-arg)
                            (receiver-peer-type a cx tm self_pname self_idx args env tps fname true)
                            (null-type))
                   what (sconcat3 a "argument " (i64->str a (+ self_idx 1)) "")
                   selfsp
                     (if (expected-some? peer)
                         (mk-synpair a
                                     (box-expr a (try! (check-to a self-arg peer env cx tps fname what)))
                                     peer)
                         ; A receiver with no type of its own, `(= (None) x)`,
                         ; is typed by its peer, as `(= x (None))` types `(None)`.
                         (match (do-synth a self-arg (null-type) env cx tps fname)
                           (Ok [sp] sp)
                           (Err [d]
                             (let [from-peer (receiver-peer-type a cx tm self_pname self_idx
                                                                 args env tps fname false)]
                               (if (expected-some? from-peer)
                                   (match (check-to a self-arg from-peer env cx tps fname what)
                                     (Ok [ce] (mk-synpair a (box-expr a ce) from-peer))
                                     (Err [_] (break :try (Err [EvalPair Diag] d))))
                                   (break :try (Err [EvalPair Diag] d)))))))
                   ssp (primitive/alloc-stack SynPair)]
               (store! ssp selfsp)
               (let [self_ty
                       (deref-to-impl a
                                      cx
                                      trait_name
                                      (load (field ssp t))
                                      tps)]
                 (when (not (has-impl-name a self_ty))
                   (break :try
                            (err-ep (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat4 a
                                                                      "in '"
                                                                      fname
                                                                      "': trait method '"
                                                                      (sconcat a
                                                                               mname
                                                                               "' called on a type that can't carry an impl: "))
                                                            (ty-str a
                                                                    self_ty))
                                                   "")))))
                 (let [self_name (type-impl-name a self_ty)]
                   (when (> (len (dyn-struct-trait cx self_name))
                            0)
                     (break :try
                              (synth-dyn-dispatch a
                                                  cx
                                                  mname
                                                  self_name
                                                  self_idx
                                                  td
                                                  tm
                                                  args
                                                  env
                                                  tps
                                                  fname
                                                  elo
                                                  ehi
                                                  esrc
                                                  ectxt)))
                   (if (set-contains tps self_name)
                       ; Self is a type parameter: a DEFERRED trait call. The bound must
                       ; carry the trait (definition-time check). A parameterized trait's
                       ; extra params become associated types (build-trait-subst); the
                       ; method sig, substituted, types the call — mono resolves it to the
                       ; impl once Self is concrete.
                       (if (not (or (bounds-has (field cx cur_bounds)
                                                self_name
                                                trait_name)
                                    (blanket-entails? a cx self_name trait_name)))
                           (return-from :try
                                          (err-ep (derr (sconcat a
                                                                 (sconcat a
                                                                          (sconcat a
                                                                                   (sconcat4 a
                                                                                             "in '"
                                                                                             fname
                                                                                             "': type parameter '"
                                                                                             (sconcat a
                                                                                                      self_name
                                                                                                      "' is not bounded by '"))
                                                                                   (display-name trait_name))
                                                                          "' (required to call '")
                                                                 (sconcat a
                                                                          mname
                                                                          "')")))))
                           (let [bt
                                   (bound-trait-find (field cx cur_bounds)
                                                     self_name
                                                     trait_name)
                                 subst
                                   (build-trait-subst a
                                                      self_pname
                                                      self_name
                                                      trait_name
                                                      td
                                                      ; through a blanket impl: no
                                                      ; associated types stated
                                                      (if (= (primitive/cast i64 bt) 0)
                                                          (box-items-type a)
                                                          (load (field bt args))))
                                 new_args
                                   (try! (trait-tp-args a
                                                        tm
                                                        subst
                                                        args
                                                        env
                                                        cx
                                                        tps
                                                        fname
                                                        mname))
                                 ret (subst-apply a (field tm ret) subst)]
                             (return-from :try
                                            (ok-ep (mk-expr (ETraitCall
                                                              :trait_name
                                                                trait_name
                                                              :method
                                                                mname
                                                              :self_tp
                                                                self_name
                                                              :args
                                                                new_args)
                                                            elo
                                                            ehi
                                                            esrc
                                                            ectxt)
                                                   ret))))
                       ; Pick the most specific impl accepting this receiver, and call
                       ; THAT impl's function. Errors name the RECEIVER TYPE, not the
                       ; dispatch key: selection matches type arguments, so `(Pair u8 bool)`
                       ; can fail while `(Pair i64 i64)` succeeds — "'app.Pair' does not
                       ; implement" would be a lie in exactly the case this catches.
                       (let [sel (primitive/alloc-stack ImplSel)]
                         (store! sel
                                 (cx-impl-select a cx trait_name self_ty))
                         (when (= (primitive/cast i64
                                                  (load (field sel ip)))
                                  0)
                           (break :try
                                    (err-ep (derr (sconcat a
                                                           (sconcat a
                                                                    (sconcat5 a
                                                                              "in '"
                                                                              fname
                                                                              "': '"
                                                                              (ty-str a
                                                                                      self_ty)
                                                                              "' does not implement '")
                                                                    (display-name trait_name))
                                                           (sconcat a "'" (blanket-unmet-note a cx trait_name self_ty)))))))
                         (when (load (field sel ambiguous))
                           (break :try
                                    (err-ep (derr (sconcat a
                                                           (sconcat a
                                                                    (sconcat5 a
                                                                              "in '"
                                                                              fname
                                                                              "': ambiguous impls of '"
                                                                              (display-name trait_name)
                                                                              "' for '")
                                                                    (ty-str a
                                                                            self_ty))
                                                           "' — several match and none is more specific")))))
                         (let [ipp (load (field sel ip))]
                           (let [impl-source
                                   (impl-mangle-key a
                                                    (field ipp self_type)
                                                    (load (field ipp
                                                                 type_params)))
                                 generated
                                   (tmfn a trait_name impl-source mname)]
                             (store! call_func generated)
                             (checker-trait-use-record! cx
                                                        fname
                                                        trait_name
                                                        impl-source
                                                        mname
                                                        generated)
                             0)))))))))
           (synth-call-general a
                               func
                               (load call_func)
                               type_args
                               args
                               expected
                               env
                               cx
                               tps
                               fname
                               elo
                               ehi
                               esrc
                               ectxt)))))

;;; Can SIG take NARGS arguments? A variadic signature takes its parameters and
;;; any more; a list pack stands for any number of arguments, none included.
(defn sig-takes-arity? [(sig (ptr Sig)) (nargs i64)] (-> bool)
  (let [nparams (len (load (field sig params)))]
    (cond (.variadic sig) (>= nargs nparams)
          (>= (list-pack-index (load (field sig params))) 0) (>= nargs (- nparams 1))
          :else (= nargs nparams))))

;;; Could the call's context still make generic SIG accept ARGS? Only a type
;;; parameter of the return type takes a type from the context, so a call whose
;;; arguments alone leave one of those unsolved, none of them the wrong shape for
;;; it, has not been rejected: a `let` or a peer argument that expects a type
;;; checks it again with that type. A call that has an expected type has had its
;;; context.
(defn call-awaits-context? [(a (dyn Allocator))
                            (sig (ptr Sig))
                            (func (slice u8))
                            (type_args (ptr (ArrayList Type)))
                            (args (ptr (ArrayList Expr)))
                            (expected (ptr Type))
                            (env (ptr (ArrayList EnvEntry)))
                            (cx (ptr Cx))
                            (tps (ptr (ArrayList (slice u8))))
                            (fname (slice u8))] (-> bool)
  (let [tparams (load (field sig type_params))]
    (and (not (expected-some? expected))
         (> (len (load tparams)) 0)
         (= (len (load type_args)) 0)
         (sig-takes-arity? sig (len (load args)))
         (let [defs (box-al [Deferred] a (ArrayList::new [Deferred] a))
               argl (ca-build-arglist a args defs env cx tps fname)]
           (match (solve-type-args-infer a
                                         tparams
                                         (load (field sig bounds))
                                         (load (field sig params))
                                         type_args
                                         argl
                                         (field sig ret)
                                         (null-type)
                                         cx
                                         tps
                                         fname
                                         func
                                         true)
             (Err [_] false)
             (Ok [subst]
               (block :open
                 (for [i 0 (len (load tparams))]
                   (let [p (get (load tparams) i)]
                     (when (and (type-mentions (field sig ret) p)
                                (not (subst-has subst p))
                                (match (argument-shape-mismatch a
                                                                (load (field sig params))
                                                                argl
                                                                p
                                                                subst
                                                                fname
                                                                func)
                                  (Some [_] false)
                                  (None [] true)))
                       (break :open true))))
                 false)))))))

;;; Does a value of type T carry trait TR's methods here? An impl of TR for T, a
;;; type parameter bounded by TR, or TR's own dyn type.
(defn receiver-carries-trait? [(a (dyn Allocator))
                               (cx (ptr Cx))
                               (tr (slice u8))
                               (t (ptr Type))
                               (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (and (has-impl-name a t)
       (let [nm (type-impl-name a t)]
         (cond (set-contains tps nm)
                 (or (bounds-has (field cx cur_bounds) nm tr) (blanket-entails? a cx nm tr))
               (> (len (dyn-struct-trait cx nm)) 0) (= (dyn-struct-trait cx nm) tr)
               :else (impl-match a cx tr t)))))

;;; D, a free function's rejection of a call, with a note naming CANDIDATE, the
;;; method the call was tried against next, and WHY it does not fit either.
(defn method-fallback-note [(a (dyn Allocator))
                            (d Diag)
                            (fname (slice u8))
                            (candidate (slice u8))
                            (why (slice u8))] (-> Diag)
  (let [lead (sconcat3 a "in '" fname "': ")
        reason (if (starts-with why lead) (subslice [u8] why (len lead) (len why)) why)
        dp (primitive/alloc-stack Diag)]
    (set! dp d)
    (set! (.msg dp) (sconcat5 a (.msg d) "; note: " candidate " was tried too and does not fit: " reason))
    (load dp)))

;;; `(m x …)` whose head names a free function `m` is that function's call while
;;; the function accepts it. When it rejects the arguments -- their number, a type
;;; that does not coerce, a failed bound or unification, reported as D -- the
;;; methods named `m` of the first argument's type are tried, chosen as a bare
;;; method call chooses them: an inherent method of that type, looking through
;;; ptr and ref, and otherwise the trait method `m` when the type carries its
;;; trait with Self first. A method that accepts the call takes it. Otherwise D
;;; stands, with a note on the method that was tried.
;;;
;;; The attempt is speculative, so it records no recovered diagnostics: the call
;;; either checks as the method's or reports D.
(defn synth-method-fallback [(a (dyn Allocator))
                             (func (slice u8))
                             (d Diag)
                             (type_args (ptr (ArrayList Type)))
                             (args (ptr (ArrayList Expr)))
                             (expected (ptr Type))
                             (env (ptr (ArrayList EnvEntry)))
                             (cx (ptr Cx))
                             (tps (ptr (ArrayList (slice u8))))
                             (fname (slice u8))
                             (elo i64)
                             (ehi i64)
                             (esrc i64)
                             (ectxt i64)] (-> (Result EvalPair Diag))
  (let [m (after-last-dot func)
        sig (sig-find cx func)]
    (if (or (= (len (load args)) 0)
            (= (primitive/cast i64 sig) 0)
            (not (or (inherent-has-name cx m) (methods-has cx m))))
        (Err [EvalPair Diag] d)
        (let [recovering (.recover_statements cx)
              _off (set! (.recover_statements cx) false)
              r (if (call-awaits-context? a sig func type_args args expected env cx tps fname)
                    (Err [EvalPair Diag] d)
                    (method-fallback-attempt a m d type_args args expected env cx tps fname
                                             elo ehi esrc ectxt))]
          (set! (.recover_statements cx) recovering)
          r))))

(defn method-fallback-attempt [(a (dyn Allocator))
                               (m (slice u8))
                               (d Diag)
                               (type_args (ptr (ArrayList Type)))
                               (args (ptr (ArrayList Expr)))
                               (expected (ptr Type))
                               (env (ptr (ArrayList EnvEntry)))
                               (cx (ptr Cx))
                               (tps (ptr (ArrayList (slice u8))))
                               (fname (slice u8))
                               (elo i64)
                               (ehi i64)
                               (esrc i64)
                               (ectxt i64)] (-> (Result EvalPair Diag))
  (match (do-synth a (elem args 0) (null-type) env cx tps fname)
    (Err [_] (Err [EvalPair Diag] d))
    (Ok [rsp]
      (let [recv (.t rsp)
            isel (if (inherent-has-name cx m)
                     (inherent-select-deref a cx m "" recv)
                     (ImplSel :ip (primitive/cast (ptr ImplDef) 0) :ambiguous false))
            ip (.ip isel)]
        (cond (.ambiguous isel)
                (Err [EvalPair Diag]
                     (method-fallback-note a d fname
                                           (sconcat5 a "the inherent method '" m "' of '" (ty-str a recv) "'")
                                           "several impls define it and none is more specific"))
              (!= (primitive/cast i64 ip) 0)
                (match (synth-call-general a m (inherent-fn-name a ip m) type_args args expected
                                           env cx tps fname elo ehi esrc ectxt)
                  (Ok [ep] (Ok [EvalPair Diag] ep))
                  (Err [why]
                    (Err [EvalPair Diag]
                         (method-fallback-note a d fname
                                               (sconcat5 a "the method '" m "' of '"
                                                         (ty-str a (field ip self_type)) "'")
                                               (.msg why)))))
              (not (methods-has cx m)) (Err [EvalPair Diag] d)
              :else
                (match (resolve-method-mod a cx m "" "" fname)
                  (Err [_] (Err [EvalPair Diag] d))
                  (Ok [me]
                    (let [self_ty (deref-to-impl a cx (.trait me) recv tps)]
                      (if (or (!= (.self_idx me) 0)
                              (not (receiver-carries-trait? a cx (.trait me) self_ty tps)))
                          (Err [EvalPair Diag] d)
                          (match (synth-trait-method-call a m m "" "" type_args args expected
                                                          env cx tps fname elo ehi esrc ectxt)
                            (Ok [ep] (Ok [EvalPair Diag] ep))
                            (Err [why]
                              (Err [EvalPair Diag]
                                   (method-fallback-note a d fname
                                                         (sconcat a
                                                                  (sconcat5 a "the method '" m "' of '"
                                                                            (ty-str a self_ty) "' from trait '")
                                                                  (sconcat a (display-name (.trait me)) "'"))
                                                         (.msg why))))))))))))))

; ELet
(defn mk-bind [(name (slice u8)) (mutable bool) (value Expr)] (-> Bind)
  (let [p (primitive/alloc-stack Bind)]
    (set! (.name p) name)
    (set! (.mutable p) mutable)
    (set! (.value p) value)
    (set! (.bid p) 0)
    (set! (.owned_type p) (primitive/cast (ptr Type) 0))
    (load p)))

; Materialize one owning aggregate binding in its own frame slot. `value` is a
; by-value expression; for a move from an existing place it is an ELoad of that
; place, which the affine pass recognizes as the ownership transfer. The local
; remains represented as a TRef place for field access and eventual in-place drop.
(defn bind-owned-place! [(a (dyn Allocator))
                         (name (slice u8))
                         (mutable bool)
                         (value Expr)
                         (ty (ptr Type))
                         (is_owner bool)
                         (nbinds (ptr (ArrayList Bind)))
                         (env (ptr (ArrayList EnvEntry)))
                         (elo i64)
                         (ehi i64)
                         (esrc i64)
                         (ectxt i64)] (-> i64)
  (let [slot (sconcat a name ".slot")
        bid
          (env-insert! env
                       name
                       (box-type a (TRef mutable (box-type a (load ty)))))
        (mut initdo) (ArrayList::new [Expr] a)]
    ; The slot has never held a value and `value` cannot name it: an
    ; initialization, which a backend may build in place.
    (push! (mut initdo)
           (mk-expr (EInitStore (box-expr a
                                          (mk-expr (EVar slot) elo ehi esrc ectxt))
                                (box-expr a value))
                    elo
                    ehi
                    esrc
                    ectxt))
    (push! (mut initdo) (mk-expr (EVar slot) elo ehi esrc ectxt))
    (push! [Bind]
           nbinds
           (mk-bind slot
                    false
                    (mk-expr (EAlloc
                               :symbol (None)
                               :storage 3
                               :ty (erase-refs a ty)
                               :init (primitive/cast (ptr Expr) 0))
                             elo
                             ehi
                             esrc
                             ectxt)))
    (let [owned (primitive/alloc-stack Bind)]
      (set! owned
            (mk-bind name
                     false
                     (mk-expr (EDo (box-al [Expr] a (load initdo)))
                              elo
                              ehi
                              esrc
                              ectxt)))
      (set! (.bid owned) bid)
      (set! (.owned_type owned)
            (if is_owner (box-type a (load ty)) (primitive/cast (ptr Type) 0)))
      (push! [Bind] nbinds (load owned)))
    0))

(defn synth-let-body [(a (dyn Allocator))
                      (body (ptr (ArrayList Expr)))
                      (expected (ptr Type))
                      (out (ptr (ArrayList Expr)))
                      (env (ptr (ArrayList EnvEntry)))
                      (cx (ptr Cx))
                      (tps (ptr (ArrayList (slice u8))))
                      (fname (slice u8))
                      (what (slice u8))] (-> (Result Type Diag))
  ; An EMPTY body has type void, not i64. The old `(TInt 64 true)` default was
  ; never overwritten when n = 0, so `(do)` silently typed as i64 and a function
  ; declared `(-> i64)` with an empty body passed the return check and returned
  ; whatever was in the return register. void makes the mismatch a type error and
  ; makes an empty body legal exactly where it is meaningful — a `(-> void)` fn.
  (let [n (len (load body))
        (mut i) 0
        (mut last) (TVoid)
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (reserve! [Expr] out (+ (len (load out)) n))
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (= (primitive/iadd (load i) 1) n)
                    (if (expected-some? expected)
                        (match (check-to a
                                         (elem body (load i))
                                         expected
                                         env
                                         cx
                                         tps
                                         fname
                                         what)
                          (Err [d] (do (set! err d) (set! failed true) (break)))
                          (Ok [ce]
                              (do
                                (push! [Expr] out ce)
                                (set! last (load expected))
                                0)))
                        (match (do-synth a
                                         (elem body (load i))
                                         (null-type)
                                         env
                                         cx
                                         tps
                                         fname)
                          (Err [d] (do (set! err d) (set! failed true) (break)))
                          (Ok [sp0]
                              (let [sp (primitive/alloc-stack SynPair)]
                                (set! sp sp0)
                                (set! last (load (load (field sp t))))
                                (push! [Expr] out (load (load (field sp e))))))))
                    (match (do-synth a
                                     (elem body (load i))
                                     (discard-expected a)
                                     env
                                     cx
                                     tps
                                     fname)
                      (Err [d] (do (set! err d) (set! failed true) (break)))
                      (Ok [sp0]
                          (let [sp (primitive/alloc-stack SynPair)]
                            (set! sp sp0)
                            (push! [Expr] out (load (load (field sp e))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [Type Diag] (load err)) (Ok (load last)))))

; The let body's tail variable — if the body's last expression is a bare `(EVar nm)`
; and the let has an expected type, that binding IS the let's result, so its value can
; be checked against the expected type. "" when there is no such tail or no expectation.
(defn let-tail-var [(body (ptr (ArrayList Expr))) (expected (ptr Type))] (-> (slice u8))
  (if (not (expected-some? expected))
      ""
      (let [l (al-last-expr body)]
        (if (= (primitive/cast i64 l) 0)
            ""
            (match (.kind l) (EVar [nm] nm) (_ ""))))))

; Synthesize a let binding's value. Try WITHOUT an expectation first — every value that
; already infers is checked exactly as before, so nothing that compiled changes. Only if
; that STRANDS inference (an Err) and this binding is the let's returned tail (`bexp` is
; the let's expected type, else null) do we retry with the expected type, letting a type
; argument flow BACK from the return position (gen-9: `(let [r (Okk 5)] r)` returned as a
; `(Result i64 E)` — E is undetermined at the binding but fixed by the return).
(defn synth-bind-value [(a (dyn Allocator))
                        (bp (ptr Bind))
                        (bexp (ptr Type))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))] (-> (Result SynPair Diag))
  (match (do-synth a (field bp value) (null-type) env cx tps fname)
    (Ok [vsp] (Ok [SynPair Diag] vsp))
    (Err [d0]
         (if (expected-some? bexp)
             (try (let [vsp
                          (try-or! (do-synth a
                                             (field bp value)
                                             bexp
                                             env
                                             cx
                                             tps
                                             fname)
                                   (Err [SynPair Diag] d0))]
                    (Ok [SynPair Diag] vsp)))
             (Err [SynPair Diag] d0)))))

(defn take-binding-value? [(value (ptr Expr))] (-> bool)
  (match (.kind value)
    (ECall [func _ _]
           (or (= func "take!")
               (or (core-name? func "take!")
                   (core-name-prefix? func "take!__"))))
    (_ false)))

(defn checked-take-in-list? [(items (ptr (ArrayList Expr))) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (checked-take-value? (elem items i))
          true
          (checked-take-in-list? items (+ i 1) n))))

(defn checked-take-value? [(value (ptr Expr))] (-> bool)
  (match (.kind value)
    (ECall [func _ _]
           (or (= func "take!")
               (or (core-name? func "take!")
                   (core-name-prefix? func "take!__"))))
    (EDo [items]
         (checked-take-in-list? items 0 (len (load items))))
    (EDefer [_ items]
            (checked-take-in-list? items 0 (len (load items))))
    (EStore [_ inner] (checked-take-value? inner))
    (EInitStore [_ inner] (checked-take-value? inner))
    (ESpillRef [inner] (checked-take-value? inner))
    (_ false)))

(defn process-let-bind [(a (dyn Allocator))
                        (bp (ptr Bind))
                        (bexp (ptr Type))
                        (nbinds (ptr (ArrayList Bind)))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))
                        (elo i64)
                        (ehi i64)
                        (esrc i64)
                        (ectxt i64)] (-> (Result i64 Diag))
  (let [name (.name bp)
        mutable (.mutable bp)]
    (match (synth-bind-value a bp bexp env cx tps fname)
      (Err [d] (Err [i64 Diag] d))
      (Ok [vsp]
          (let [sp (primitive/alloc-stack SynPair)]
            (set! sp vsp)
            (let [ve (load (load (field sp e)))
                  vt (load (field sp t))]
              (cond (type-is-void vt)
                      (Err [i64 Diag]
                           (derr (sconcat1 a
                                           (sconcat4 a
                                                     "in '"
                                                     fname
                                                     "': cannot bind '"
                                                     (sconcat a
                                                              name
                                                              "' to a void value (a (-> void) call yields nothing)")))))
                    (= (type-tag vt) 5)
                    ; The initializer is already a reference, so this binding either
                    ; ALIASES that place or reads a value out of it. Which one it is
                    ; follows the same rule as a call argument (see coerce-arg-inner):
                    ; an alias must be spelled `(mut …)`; a bare name is a value.
                    (let [borrowed (is-mut-borrow (field bp value))
                          src_mut (t-ref-mut vt)
                          pointee (t-inner vt)]
                      (cond ; A bare affine owner moves out of its old place and is
                            ; materialized in a fresh owning slot. Legacy aggregate
                            ; places retain Coil's historical view semantics.
                            (and (not borrowed) (binding-may-own? a cx pointee))
                              (do
                                (bind-owned-place! a
                                                   name
                                                   mutable
                                                   (mk-expr (ELoad (box-expr a
                                                                             ve))
                                                            elo
                                                            ehi
                                                            esrc
                                                            ectxt)
                                                   pointee
                                                   true
                                                   nbinds
                                                   env
                                                   elo
                                                   ehi
                                                   esrc
                                                   ectxt)
                                (Ok [i64 Diag] 0))
                            ; `(let [(mut x) (mut place)])` asks for an alias, and a
                            ; writable alias of a place the source cannot write is
                            ; not one it can have.
                            (and mutable (and borrowed (not src_mut)))
                              (Err [i64 Diag]
                                   (derr (sconcat1 a
                                                   (sconcat4 a
                                                             "in '"
                                                             fname
                                                             "': cannot make a mutable alias '"
                                                             (sconcat a
                                                                      name
                                                                      "' of an immutable reference; bind it without (mut …) to take a copy")))))
                            ; A bare mutable binding of plain data is a COPY: its own
                            ; slot, initialized by a bitwise load of the source, as in
                            ; Zig or Swift. The source may be a fresh value, a local, or
                            ; a parameter that arrived by immutable reference — none of
                            ; them is aliased, so a store through the new name is never
                            ; seen through the old. Owners never get here: they moved
                            ; above. Aliasing a place is spelled `(mut place)`.
                            (and mutable (not borrowed))
                              (do
                                (bind-owned-place! a
                                                   name
                                                   mutable
                                                   (mk-expr (ELoad (box-expr a ve))
                                                            elo
                                                            ehi
                                                            esrc
                                                            ectxt)
                                                   pointee
                                                   false
                                                   nbinds
                                                   env
                                                   elo
                                                   ehi
                                                   esrc
                                                   ectxt)
                                (Ok [i64 Diag] 0))
                            ; A bare name reads the place, the value coercion a call
                            ; argument gets. Non-affine struct/array places stay
                            ; references — binding one remains a legacy view.
                            (and (not borrowed)
                                 (not (is-place-value-type pointee cx)))
                              (do
                                (env-insert! env
                                             name
                                             (box-type a (load pointee)))
                                (push! [Bind]
                                       nbinds
                                       (mk-bind name
                                                false
                                                (mk-expr (ELoad (box-expr a ve))
                                                         elo
                                                         ehi
                                                         esrc
                                                         ectxt)))
                                (Ok [i64 Diag] 0))
                            :else
                              (do
                                (env-insert! env
                                             name
                                             (box-type a (TRef mutable pointee)))
                                (push! [Bind] nbinds (mk-bind name false ve))
                                (Ok [i64 Diag] 0))))
                      (or mutable
                          (or (is-place-value-type vt cx)
                              (or (binding-may-own? a cx vt)
                                  (or (take-binding-value? (field bp value))
                                      (checked-take-value? (load (field sp e)))))))
                    (do
                      (bind-owned-place! a
                                         name
                                         mutable
                                         ve
                                         vt
                                         (or (binding-may-own? a cx vt)
                                             (or (take-binding-value? (field bp
                                                                             value))
                                                 (checked-take-value? (load (field sp
                                                                                   e)))))
                                         nbinds
                                         env
                                         elo
                                         ehi
                                         esrc
                                         ectxt)
                      (Ok [i64 Diag] 0))
                      :else
                    (do
                      (env-insert! env name (box-type a (load vt)))
                      (push! [Bind] nbinds (mk-bind name false ve))
                      (Ok [i64 Diag] 0)))))))))

(defn process-let-binds [(a (dyn Allocator))
                         (binds (ptr (ArrayList Bind)))
                         (nbinds (ptr (ArrayList Bind)))
                         (tailvar (slice u8))
                         (expected (ptr Type))
                         (env (ptr (ArrayList EnvEntry)))
                         (cx (ptr Cx))
                         (tps (ptr (ArrayList (slice u8))))
                         (fname (slice u8))
                         (elo i64)
                         (ehi i64)
                         (esrc i64)
                         (ectxt i64)] (-> (Result i64 Diag))
  (let [nb (len (load binds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (reserve! [Bind] nbinds (+ (len (load nbinds)) nb))
    (loop (if (>= (load i) nb)
              (break)
              (do
                (let [bp (elem binds (load i))
                      ; the let's returned tail binding gets the let's expected type as a
                      ; fallback (only used if it fails to infer on its own — see synth-bind-value)
                      bexp
                        (if (and (> (len tailvar) 0)
                                 (= (.name bp) tailvar))
                            expected
                            (null-type))]
                  (match (process-let-bind a
                                           bp
                                           bexp
                                           nbinds
                                           env
                                           cx
                                           tps
                                           fname
                                           elo
                                           ehi
                                           esrc
                                           ectxt)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    ; the binder's identity is the one its name resolves to now,
                    ; the same a read of it records (source-local-answer!)
                    (Ok [_] (source-binder-identity! (.node-id (field bp value))
                                                     (env-get-bid env (.name bp))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn synth-let [(a (dyn Allocator))
                 (binds (ptr (ArrayList Bind)))
                 (body (ptr (ArrayList Expr)))
                 (expected (ptr Type))
                 (env (ptr (ArrayList EnvEntry)))
                 (cx (ptr Cx))
                 (tps (ptr (ArrayList (slice u8))))
                 (fname (slice u8))
                 (elo i64)
                 (ehi i64)
                 (esrc i64)
                 (ectxt i64)] (-> (Result EvalPair Diag))
  (let [saved (len (load env))
        nbinds (box-al [Bind] a (ArrayList::new [Bind] a))
        tailvar (let-tail-var body expected)]
    (match (process-let-binds a
                              binds
                              nbinds
                              tailvar
                              expected
                              env
                              cx
                              tps
                              fname
                              elo
                              ehi
                              esrc
                              ectxt)
      (Err [d] (err-ep d))
      (Ok [_]
          (let [outl (box-al [Expr] a (ArrayList::new [Expr] a))]
            (match (synth-let-body a
                                   body
                                   expected
                                   outl
                                   env
                                   cx
                                   tps
                                   fname
                                   "let body")
              (Err [d] (err-ep d))
              (Ok [last]
                  (do
                    (env-truncate! env saved)
                    (ok-ep (mk-expr (ELet nbinds outl) elo ehi esrc ectxt) last)))))))))

; EMatch
(defn variant-by-name [(variants (ptr (ArrayList Variant))) (name (slice u8))] (-> (ptr Variant))
  (let [n (len (load variants))
        (mut i) 0
        (mut r) (primitive/cast (ptr Variant) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (elem variants (load i))
                                      name))
                         name)
                  (store! r (elem variants (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

;;; The variant an arm names. An arm can only name a variant of the scrutinee's
;;; sum, so a name that is not one is looked up among the scrutinee's own variants
;;; by its last segment: a match on an `IoError` can name `Errno` without
;;; importing it, as the sum already says which `Errno` it means, and a `Malformed`
;;; arm on a `DeErrorKind` means that sum's `Malformed` even where another sum's
;;; `Malformed` is in scope. A name no variant of the scrutinee ends with is
;;; returned as written, and reported.
(defn arm-variant-name [(variants (ptr (ArrayList Variant))) (name (slice u8))] (-> (slice u8))
  (if (!= (primitive/cast i64 (variant-by-name variants name)) 0)
      name
      (let [tail (unqualified-tail name)
            (mut found) name]
        (for vp (iter (load variants))
          (when (= (unqualified-tail (.name vp)) tail)
            (set! found (.name vp))
            0))
        found)))

;;; The text after the last `.` of a qualified name.
(defn unqualified-tail [(name (slice u8))] (-> (slice u8))
  (let [(mut start) 0]
    (for i (range 0 (len name))
      (when (= (primitive/cast i64 (get name i)) 46)
        (set! start (+ i 1))
        0))
    (subslice name (load start) (len name))))

(defn covered-has [(cov (ptr (ArrayList (slice u8)))) (name (slice u8))] (-> bool)
  (set-contains cov name))

; the variant names in `variants` not present in `covered`, formatted as
; "`Blue`" / "`Blue`, `Yellow`" / "`Blue`, `Yellow`, `Cyan` … and 4 more".
(defn missing-variants-str [(a (dyn Allocator))
                            (variants (ptr (ArrayList Variant)))
                            (covered (ptr (ArrayList (slice u8))))] (-> (slice u8))
  (let [n (len (load variants))
        (mut i) 0
        (mut out) ""
        (mut shown) 0
        (mut extra) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [nm (.name (elem variants (load i)))]
                  (unless (set-contains covered nm)
                    (if (< (load shown) 5)
                        (do
                          (when (> (load shown) 0)
                            (store! out (sconcat a (load out) ", "))
                            0)
                          (store! out
                                  (sconcat a (load out) (sconcat3 a "`" nm "`")))
                          (store! shown (primitive/iadd (load shown) 1))
                          0)
                        (store! extra (primitive/iadd (load extra) 1)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (> (load extra) 0)
        (sconcat a
                 (load out)
                 (sconcat3 a " … and " (i64->str a (load extra)) " more"))
        (load out))))

(defn match-arms-loop [(a (dyn Allocator))
                       (arms (ptr (ArrayList Arm)))
                       (variants (ptr (ArrayList Variant)))
                       (sumname (slice u8))
                       (expected (ptr Type))
                       (covered (ptr (ArrayList (slice u8))))
                       (checked (ptr (ArrayList Arm)))
                       (synb (ptr (ArrayList Branch)))
                       (metav (ptr (ArrayList (slice u8))))
                       (metab (ptr (ArrayList (ptr (ArrayList (slice u8))))))
                       (env (ptr (ArrayList EnvEntry)))
                       (cx (ptr Cx))
                       (tps (ptr (ArrayList (slice u8))))
                       (fname (slice u8))
                       (borrow-kind i64)] (-> (Result i64 Diag))
  (let [narms (len (load arms))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) narms)
              (break)
              (do
                (let [arm (elem arms (load i))
                      av (arm-variant-name variants (.variant arm))
                      abinds (load (field arm binds))
                      wild (arm-wildcard? arm)
                      v (variant-by-name variants av)]
                  (cond (and (not wild)
                             (= (primitive/cast i64 v) 0))
                          (do
                            (store! err
                                    (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat4 a
                                                                      "in '"
                                                                      fname
                                                                      "': sum '"
                                                                      (sconcat a
                                                                               sumname
                                                                               "' has no variant '"))
                                                            av)
                                                   "'")))
                            (store! failed true)
                            (break))
                        (and (not wild) (set-contains covered av))
                          (do
                            (store! err
                                    (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat4 a
                                                                      "in '"
                                                                      fname
                                                                      "': duplicate match arm for '"
                                                                      av)
                                                            "'")
                                                   "")))
                            (store! failed true)
                            (break))
                        (and (not wild)
                             (not (= (len (load abinds))
                                     (len (load (field v fields))))))
                          (do
                            (store! err
                                    (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat a
                                                                     (sconcat a
                                                                              (sconcat4 a
                                                                                        "in '"
                                                                                        fname
                                                                                        "': arm '"
                                                                                        (sconcat a
                                                                                                 av
                                                                                                 "' binds "))
                                                                              (i64->str a
                                                                                        (len (load abinds))))
                                                                     " name(s) but the variant has ")
                                                            (i64->str a
                                                                      (len (load (field v
                                                                                        fields)))))
                                                   " field(s)")))
                            (store! failed true)
                            (break))
                        :else
                          (do
                            ; the catch-all covers whatever is left, so it contributes
                            ; no name to `covered` and binds nothing — which also keeps
                            ; the (null) `v` below out of reach, since the bind loop
                            ; that reads its fields runs zero times.
                            (unless wild (push! [(slice u8)] covered av))
                            (let [saved (len (load env))
                                  nbn (len (load abinds))
                                  (mut runtime-binds) (ArrayList::new [(slice u8)] a)
                                  (mut owner-binds) (ArrayList::new [Bind] a)
                                  (mut k) 0]
                              (loop (if (>= (load k) nbn)
                                        (break)
                                        (do
                                          (let [name
                                                  (get (load abinds) (load k))
                                                ty
                                                  (field (elem (load (field v
                                                                            fields))
                                                               (load k))
                                                         ty)]
                                            (cond (and (> borrow-kind
                                                          0)
                                                       (binding-may-own? a cx ty))
                                                    (let [raw
                                                            (sconcat a
                                                                     "$match.ref."
                                                                     (sconcat a
                                                                              name
                                                                              (i64->str a
                                                                                        (next-bid))))
                                                          ref-ty
                                                            (box-type a
                                                                      (TRef (= borrow-kind
                                                                               2)
                                                                            (box-type a
                                                                                      (load ty))))]
                                                      (push! (mut runtime-binds)
                                                             raw)
                                                      (env-insert! env
                                                                   raw
                                                                   ref-ty)
                                                      (env-insert! env
                                                                   name
                                                                   ref-ty)
                                                      (push! (mut owner-binds)
                                                             (mk-bind name
                                                                      false
                                                                      (mk-expr (EVar raw)
                                                                               (.lo (field arm
                                                                                           body))
                                                                               (.hi (field arm
                                                                                           body))
                                                                               (.source (field arm
                                                                                               body))
                                                                               (.ctxt (field arm
                                                                                             body)))))
                                                      0)
                                                  (binding-may-own? a cx ty)
                                                    (let [raw
                                                            (sconcat a
                                                                     "$match.in."
                                                                     (sconcat a
                                                                              name
                                                                              (i64->str a
                                                                                        (next-bid))))]
                                                      (push! (mut runtime-binds)
                                                             raw)
                                                      (env-insert! env raw ty)
                                                      (bind-owned-place! a
                                                                         name
                                                                         false
                                                                         (mk-expr (EVar raw)
                                                                                  (.lo (field arm
                                                                                              body))
                                                                                  (.hi (field arm
                                                                                              body))
                                                                                  (.source (field arm
                                                                                                  body))
                                                                                  (.ctxt (field arm
                                                                                                body)))
                                                                         ty
                                                                         true
                                                                         (mut owner-binds)
                                                                         env
                                                                         (.lo (field arm
                                                                                     body))
                                                                         (.hi (field arm
                                                                                     body))
                                                                         (.source (field arm
                                                                                         body))
                                                                         (.ctxt (field arm
                                                                                       body)))
                                                      0)
                                                  :else
                                                    (do
                                                      (push! (mut runtime-binds)
                                                             name)
                                                      (env-insert! env name ty)
                                                      0)))
                                          (store! k (primitive/iadd (load k) 1)))))
                              (if (expected-some? expected)
                                  (match (check-to a
                                                   (field arm body)
                                                   expected
                                                   env
                                                   cx
                                                   tps
                                                   fname
                                                   "match arm")
                                    (Err [d]
                                         (do
                                           (env-truncate! env saved)
                                           (store! err d)
                                           (store! failed true)
                                           (break)))
                                    (Ok [be]
                                        (do
                                          (let [na (primitive/alloc-stack Arm)]
                                            (store! (field na variant) av)
                                            (store! (field na binds)
                                                    (box-al [(slice u8)]
                                                            a
                                                            (load runtime-binds)))
                                            (store! (field na body)
                                                    (if (= (len (load owner-binds))
                                                           0)
                                                        be
                                                        (let [(mut wrapped-body)
                                                                (ArrayList::new [Expr]
                                                                                a)]
                                                          (push! [Expr]
                                                                 (mut wrapped-body)
                                                                 be)
                                                          (mk-expr (ELet (box-al [Bind]
                                                                                 a
                                                                                 (load owner-binds))
                                                                         (box-al [Expr]
                                                                                 a
                                                                                 (load wrapped-body)))
                                                                   (.lo (field arm
                                                                               body))
                                                                   (.hi (field arm
                                                                               body))
                                                                   (.source (field arm
                                                                                   body))
                                                                   (.ctxt (field arm
                                                                                 body))))))
                                            (push! [Arm] checked (load na)))
                                          (env-truncate! env saved)
                                          0)))
                                  (match (do-synth a
                                                   (field arm body)
                                                   (null-type)
                                                   env
                                                   cx
                                                   tps
                                                   fname)
                                    (Err [d]
                                         (do
                                           (env-truncate! env saved)
                                           (store! err d)
                                           (store! failed true)
                                           (break)))
                                    (Ok [sp0]
                                        (let [sp (primitive/alloc-stack SynPair)
                                              br (primitive/alloc-stack Branch)]
                                          (store! sp sp0)
                                          (store! (field br e)
                                                  (if (= (len (load owner-binds))
                                                         0)
                                                      (load (field sp e))
                                                      (let [(mut wrapped-body)
                                                              (ArrayList::new [Expr] a)]
                                                        (push! [Expr]
                                                               (mut wrapped-body)
                                                               (load (load (field sp
                                                                                  e))))
                                                        (box-expr a
                                                                  (mk-expr (ELet (box-al [Bind]
                                                                                         a
                                                                                         (load owner-binds))
                                                                                 (box-al [Expr]
                                                                                         a
                                                                                         (load wrapped-body)))
                                                                           (.lo (field arm
                                                                                       body))
                                                                           (.hi (field arm
                                                                                       body))
                                                                           (.source (field arm
                                                                                           body))
                                                                           (.ctxt (field arm
                                                                                         body)))))))
                                          (store! (field br t)
                                                  (load (field sp t)))
                                          (push! [Branch] synb (load br))
                                          (push! [(slice u8)] metav av)
                                          (push! [(ptr (ArrayList (slice u8)))]
                                                 metab
                                                 (box-al [(slice u8)]
                                                         a
                                                         (load runtime-binds)))
                                          (env-truncate! env saved)
                                          0)))))))
                  (set! i (primitive/iadd (load i) 1))))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn build-newarms [(a (dyn Allocator))
                     (metav (ptr (ArrayList (slice u8))))
                     (metab (ptr (ArrayList (ptr (ArrayList (slice u8))))))
                     (outl (ptr (ArrayList Expr)))] (-> (ptr (ArrayList Arm)))
  (let [nm (len (load metav))
        (mut newarms) (ArrayList::new [Arm] a)
        (mut j) 0]
    (loop (if (>= (load j) nm)
              (break)
              (do
                (let [na (primitive/alloc-stack Arm)]
                  (set! (.variant na) (get (load metav) (load j)))
                  (set! (.binds na) (get (load metab) (load j)))
                  (set! (.body na) (get (load outl) (load j)))
                  (push! (mut newarms) (load na)))
                (set! j (primitive/iadd (load j) 1)))))
    (box-al [Arm] a (load newarms))))

(defn synth-match [(a (dyn Allocator))
                   (scrut (ptr Expr))
                   (arms (ptr (ArrayList Arm)))
                   (expected (ptr Type))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [ssp0 (try! (do-synth a scrut (null-type) env cx tps fname))
               ssp (primitive/alloc-stack SynPair)]
           (store! ssp ssp0)
           (let [(mut se) (load (field ssp e))
                 st0 (load (field ssp t))
                 (mut st) st0
                 (mut borrow-kind) 0]
             (when (= (type-tag st0) 5)
               (let [inner (t-inner st0)]
                 (when (load (field (alloc-stack-store-sumvars a inner cx)
                                    found))
                   (match (load st0)
                     (TRef [mutable _]
                           (store! borrow-kind
                                   (if mutable
                                       2
                                       1)))
                     (_ (store! se
                                (box-expr a
                                          (mk-expr (ELoad (load se))
                                                   elo
                                                   ehi
                                                   esrc
                                                   ectxt)))))
                   (store! st inner)
                   0)))
             (let [svp (alloc-stack-store-sumvars a (load st) cx)]
               (when (not (load (field svp found)))
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat3 a
                                                           "in '"
                                                           fname
                                                           "': match expects a sum value, got ")
                                                 (ty-str a (load st)))))))
               (let [sumname (load (field svp name))
                     variants (load (field svp variants))
                     arms (settle-default-arm a arms variants)]
                 (when (= (len (load arms)) 0)
                   (break :try
                            (err-ep (derr (sconcat3 a
                                                    "in '"
                                                    fname
                                                    "': empty match")))))
                 (let [covered (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                       checked (box-al [Arm] a (ArrayList::new [Arm] a))
                       synb (box-al [Branch] a (ArrayList::new [Branch] a))
                       metav (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
                       metab
                         (box-al [(ptr (ArrayList (slice u8)))]
                                 a
                                 (ArrayList::new [(ptr (ArrayList (slice u8)))] a))]
                   (try! (match-arms-loop a
                                          arms
                                          variants
                                          sumname
                                          expected
                                          covered
                                          checked
                                          synb
                                          metav
                                          metab
                                          env
                                          cx
                                          tps
                                          fname
                                          (load borrow-kind)))
                   (when (and (not (arms-have-wildcard arms))
                              (not (= (len (load covered))
                                      (len (load variants)))))
                     (break  ; the exhaustiveness check already knows WHICH variants are uncovered —
                            ; name them instead of just counting. For a 20-variant sum, "18 of 20"
                            ; told you nothing you didn't already know.
                            :try
                            (err-ep (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat4 a
                                                                      "in '"
                                                                      fname
                                                                      "': non-exhaustive match on '"
                                                                      (sconcat a
                                                                               sumname
                                                                               "': "))
                                                            (missing-variants-str a
                                                                                  variants
                                                                                  covered))
                                                   " not covered")))))
                   (if (expected-some? expected)
                       (ok-ep (mk-expr (EMatch (load se) checked)
                                       elo
                                       ehi
                                       esrc
                                       ectxt)
                              (load expected))
                       (let [outl (box-al [Expr] a (ArrayList::new [Expr] a))
                             t
                               (try! (unify-branches a
                                                     synb
                                                     outl
                                                     fname
                                                     "match arms"))]
                         (ok-ep (mk-expr (EMatch (load se)
                                                 (build-newarms a
                                                                metav
                                                                metab
                                                                outl))
                                         elo
                                         ehi
                                         esrc
                                         ectxt)
                                t)))))))))))

;;; A lowered match ends in `(_ (primitive/pattern-default body))` for the
;;; variants its other arms do not name. When they name every variant of the
;;; sum the arm can never run, and `body` -- the rows that remain once no
;;; variant matched, which need not be exhaustive -- is dropped unchecked;
;;; otherwise the arm is an ordinary catch-all holding `body`.
(defn settle-default-arm [(a (dyn Allocator))
                          (arms (ptr (ArrayList Arm)))
                          (variants (ptr (ArrayList Variant)))] (-> (ptr (ArrayList Arm)))
  (let [n (len (load arms))]
    (if (or (= n 0) (not (arms-have-wildcard arms)))
        arms
        (let [last (elem arms (- n 1))]
          (match (.kind (field last body))
            (EPattern [op _ inner _]
                      (if (!= op 6)
                          arms
                          (let [(mut named) 0
                                (mut out) (ArrayList::new [Arm] a)]
                            (for vp (iter (load variants))
                              (let [(mut found) false]
                                (for i (range 0 (- n 1))
                                  (when (= (arm-variant-name variants
                                                             (.variant (elem arms i)))
                                           (.name vp))
                                    (set! found true)
                                    0))
                                (when (load found) (set! named (+ (load named) 1)) 0)))
                            (for i (range 0 (- n 1))
                              (push! (mut out) (load (elem arms i))))
                            (when (< (load named) (len (load variants)))
                              (let [kept (primitive/alloc-stack Arm)]
                                (store! kept (load last))
                                (store! (field kept body) (load inner))
                                (push! (mut out) (load kept))))
                            (box-al [Arm] a (load out)))))
            (_ arms))))))

(defn alloc-stack-store-sumvars [(a (dyn Allocator))
                                 (t (ptr Type))
                                 (cx (ptr Cx))] (-> (ptr SumVars))
  (box! a SumVars (sum-variants a t cx)))

; ---- loop / break / continue (cx.loops frames) ----
(defn loops-len [(cx (ptr Cx))] (-> i64)
  (len (.loops cx)))

(defn loops-rpos-label [(cx (ptr Cx)) (l (slice u8))] (-> i64)
  (let [n (loops-len cx)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) 0)
              (break)
              (do
                (match (.label (elem (field cx loops) (load i)))
                  (Some [fl] (when (= fl l) (store! at (load i)) (break)))
                  (_ 0))
                (set! i (primitive/isub (load i) 1)))))
    (load at)))

(defn label-some? [(label (Option (slice u8)))] (-> bool)
  (match label (Some [l] true) (_ false)))

(defn label-val [(label (Option (slice u8)))] (-> (slice u8))
  (match label (Some [l] l) (_ "")))

(defn run-loop-body [(a (dyn Allocator))
                     (label (Option (slice u8)))
                     (body (ptr (ArrayList Expr)))
                     (expected (ptr Type))
                     (out (ptr (ArrayList Expr)))
                     (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))] (-> (Result Type Diag))
  (let [fr (primitive/alloc-stack LoopFrame)]
    (set! (.label fr) label)
    (set! (.break_ty fr) (None [Type]))
    (set! (.expected fr)
          (if (expected-some? expected) (Some (load expected)) (None [Type])))
    (set! (.place_breaks fr) (ArrayList::new [(ptr Expr)] a))
    (set! (.defers fr) (.defer_depth cx))
    (set! (.pending fr) (ArrayList::new [PendingBreak] a))
    (push! [LoopFrame] (field cx loops) (load fr)))
  (let [n (len (load body))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (do-synth a
                                 (elem body (load i))
                                 (discard-expected a)
                                 env
                                 cx
                                 tps
                                 fname)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [sp0]
                      (let [sp (primitive/alloc-stack SynPair)]
                        (set! sp sp0)
                        (push! [Expr]
                               out
                               (load (load (field sp
                                                  e)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (let [(mut popped) (pop! [LoopFrame] (field cx loops))]
      (when (not (load failed))
        (match (load popped)
          (Some [pf]
                (let [pfp (primitive/alloc-stack LoopFrame)]
                  (set! pfp pf)
                  (match (check-pending-breaks! a pfp cx tps fname)
                    (Err [d] (do (set! err d) (set! failed true) 0))
                    (Ok [_] (do (set! popped (Some (load pfp))) 0)))))
          (None [] 0)))
      (if (load failed)
          (Err [Type Diag] (load err))
          (let [(mut lty) (TNever)]
            (if (expected-some? expected)
                (set! lty (load expected))
                (match (load popped)
                  (Some [pf]
                        (let [pfp (primitive/alloc-stack LoopFrame)]
                          (set! pfp pf)
                          (match (.break_ty pfp)
                            (Some [bt] (set! lty bt))
                            (_ (set! lty (TNever))))))
                  (_ (set! lty (TNever)))))
            (Ok (load lty)))))))

(defn synth-loop [(a (dyn Allocator))
                  (label (Option (slice u8)))
                  (body (ptr (ArrayList Expr)))
                  (expected (ptr Type))
                  (env (ptr (ArrayList EnvEntry)))
                  (cx (ptr Cx))
                  (tps (ptr (ArrayList (slice u8))))
                  (fname (slice u8))
                  (elo i64)
                  (ehi i64)
                  (esrc i64)
                  (ectxt i64)] (-> (Result EvalPair Diag))
  ; Loop labels are lexical: an inner loop may reuse an enclosing loop's label, and
  ; break/continue resolve to the innermost loop carrying it, as a let shadows.
  (let [outl (box-al [Expr] a (ArrayList::new [Expr] a))]
    (match (run-loop-body a label body expected outl env cx tps fname)
      (Err [d] (err-ep d))
      (Ok [lty] (ok-ep (mk-expr (ELoop label outl) elo ehi esrc ectxt) lty)))))

; A value-carrying break whose type is a place is remembered, so that a later
; break joining the loop at the value can load it (see `join-branch-types`).
(defn record-place-break! [(cx (ptr Cx))
                           (idx i64)
                           (have_val bool)
                           (vty (ptr Type))
                           (valexpr (ptr Expr))] (-> i64)
  (when (and have_val (= (type-tag vty) 5))
    (push! [(ptr Expr)]
           (field (elem (field cx loops) idx) place_breaks)
           valexpr)
    0))

; The value type a break into a loop of type `bt` delivers: a loop that has only
; carried places so far joins a value at the place's type.
(defn break-value-type [(bt Type)] (-> Type)
  (match bt (TRef [_ inner] (load inner)) (_ bt)))

(defn env-snapshot [(a (dyn Allocator)) (env (ptr (ArrayList EnvEntry)))] (-> (ptr (ArrayList EnvEntry)))
  (let [(mut out) (ArrayList::new [EnvEntry] a)]
    (for [i 0 (len (load env))]
      (push! (mut out) (get (load env) i)))
    (box-al [EnvEntry] a (load out))))

;;; Does checking `e` reach a break or continue? A pending break value is checked
;;; after its loop's frame is gone, so only one that leaves no loop may wait.
(defn expr-leaves-loop? [(a (dyn Allocator)) (e (ptr Expr))] (-> bool)
  (let [(mut work) (ArrayList::new [(ptr Expr)] a)
        (mut found) false]
    (push! (mut work) e)
    (loop (if (or (load found) (= (len (load work)) 0))
              (break)
              (let [x (match (pop! (mut work)) (Some [p] p) (None [] e))]
                (match (.kind x)
                  (EBreak [_ _] (store! found true))
                  (EContinue [_] (store! found true))
                  ; a lifted function's body is its own
                  (EAnonFn [_ _] 0)
                  (_ (ownership-children! x (mut work))))
                0)))
    (load found)))

;;; Check the break values that waited for the loop's type, now that its other
;;; breaks have given it. With none, the first one's own error stands.
(defn check-pending-breaks! [(a (dyn Allocator))
                             (fr (ptr LoopFrame))
                             (cx (ptr Cx))
                             (tps (ptr (ArrayList (slice u8))))
                             (fname (slice u8))] (-> (Result i64 Diag))
  (try (let [n (len (field fr pending))]
         (when (> n 0)
           (match (load (field fr break_ty))
             (None [] (break :try (Err [i64 Diag] (.err (elem (field fr pending) 0)))))
             (Some [bt]
                   (let [vt (box-type a (break-value-type bt))]
                     (for [i 0 n]
                       (let [pb (elem (field fr pending) i)
                             ve (try! (check-to a (.value pb) vt (.env pb) cx tps fname "break value"))]
                         (store! (.slot pb) ve)))
                     ; The loop now also carries a value: earlier place breaks load
                     ; theirs, as `join-branch-types` does for a value break.
                     (when (not (type-eq (box-type a bt) vt))
                       (for p (iter (field fr place_breaks))
                         (store! p (load-place-expr a p)))
                       (clear! (field fr place_breaks))
                       (store! (field fr break_ty) (Some (load vt)))
                       0)
                     0))))
         (Ok [i64 Diag] 0))))

(defn synth-break [(a (dyn Allocator))
                   (label (Option (slice u8)))
                   (value (Option (ptr Expr)))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (when (= (loops-len cx) 0)
           (break :try
                    (err-ep (derr (sconcat3 a
                                            "in '"
                                            fname
                                            "': break outside of a loop")))))
         (let [idx
                 (match label
                   (Some [l] (loops-rpos-label cx l))
                   (_ (primitive/isub (loops-len cx) 1)))]
           (match label
             (Some [l]
                   (when (< idx 0)
                     (break :try
                              (err-ep (derr (sconcat a
                                                     (sconcat4 a
                                                               "in '"
                                                               fname
                                                               "': break to unknown loop label ':"
                                                               l)
                                                     "'"))))))
             (_ 0))
           (let [fr (elem (field cx loops) idx)
                 texp (field fr expected)]
             (let [valpair (primitive/alloc-stack SynPair)
                   (mut have_val) false
                   (mut valexpr) (primitive/cast (ptr Expr) 0)
                   (mut vty) (box-type a (TInt 64 true))]
               (match value
                 (Some [vp]
                       (do
                         (store! have_val true)
                         (match (load texp)
                           (Some [exp]
                                 (let [ve
                                         (try! (check-to a
                                                         vp
                                                         (box-type a exp)
                                                         env
                                                         cx
                                                         tps
                                                         fname
                                                         "break value"))]
                                   (store! valexpr (box-expr a ve))
                                   (store! vty (box-type a exp))
                                   0))
                           (_ (let [saved (len (load env))]
                                (match (do-synth a vp (null-type) env cx tps fname)
                                  (Ok [vsp]
                                      (do
                                        (store! valpair vsp)
                                        (store! valexpr (load (field valpair e)))
                                        (store! vty (load (field valpair t)))
                                        0))
                                  (Err [d]
                                       (do
                                         (env-truncate! env saved)
                                         ; The value may need the loop's type, which
                                         ; a break still to come may give: `(Err e)`
                                         ; under a `try!` before the block's tail.
                                         (match (load (field fr break_ty))
                                           (Some [bt]
                                                 (let [vt (box-type a (break-value-type bt))
                                                       ve (try! (check-to a vp vt env cx tps fname "break value"))]
                                                   (store! valexpr (box-expr a ve))
                                                   (store! vty vt)
                                                   0))
                                           (None []
                                                 (if (expr-leaves-loop? a vp)
                                                     (break :try (Err [EvalPair Diag] d))
                                                     (let [slot (box-expr a (load vp))]
                                                       (store! (pending-break-count)
                                                               (+ (load (pending-break-count)) 1))
                                                       (push! [PendingBreak]
                                                              (field fr pending)
                                                              (PendingBreak :value vp
                                                                            :slot slot
                                                                            :env (env-snapshot a env)
                                                                            :err d
                                                                            :seq (load (pending-break-count))))
                                                       (break :try
                                                              (ok-ep (mk-expr (EBreak label (Some slot))
                                                                              elo
                                                                              ehi
                                                                              esrc
                                                                              ectxt)
                                                                     (TNever)))))))
                                         0))))))
                         0))
                 (None []
                       (match (load texp)
                         ; A bare (break) leaves a loop whose value is discarded.
                         (Some [exp]
                               (when (type-is-void (box-type a exp))
                                 (store! vty (box-type a exp))
                                 0)
                               (when (not (type-eq (box-type a exp) (load vty)))
                                 (break :try
                                          (err-ep (derr (sconcat a
                                                                 (sconcat a
                                                                          (sconcat3 a
                                                                                    "in '"
                                                                                    fname
                                                                                    "': break value has type i64 but expected ")
                                                                          (ty-str a
                                                                                  (box-type a
                                                                                            exp)))
                                                                 "; use (break value) when the loop is in value position"))))))
                         (_ 0))))
               ; A break that leaves defers delivers its value after their cleanups
               ; run, and a cleanup may write the place it names: read a place
               ; here, so the break carries the value it had when it was taken.
               (when (and (load have_val)
                          (and (= (type-tag (load vty)) 5)
                               (> (.defer_depth cx)
                                  (.defers (elem (field cx loops) idx)))))
                 (store! valexpr (box-expr a (load-place-expr a (load valexpr))))
                 (store! vty (t-inner (load vty)))
                 0)
               (when (not (type-is-never (load vty)))
                 (match (load (field (elem (field cx loops) idx)
                                     break_ty))
                   (Some [prev]
                         (let [pt (box-type a prev)
                               joined (join-branch-types pt (load vty))]
                           (when (= (primitive/cast i64 joined)
                                    0)
                             (break :try
                                      (err-ep (derr (sconcat a
                                                             (sconcat a
                                                                      (sconcat a
                                                                               (sconcat4 a
                                                                                         "in '"
                                                                                         fname
                                                                                         "': loop breaks with different value types ("
                                                                                         (ty-str a
                                                                                                 pt))
                                                                               " vs ")
                                                                      (ty-str a
                                                                              (load vty)))
                                                             ")")))))
                           ; Earlier breaks were places and the loop now joins at
                           ; the value: load each of them where it stands.
                           (when (not (type-eq joined pt))
                             (let [fp (elem (field cx loops) idx)]
                               (for p (iter (field fp place_breaks))
                                 (store! p (load-place-expr a p)))
                               (clear! (field fp place_breaks))
                               (store! (field fp break_ty) (Some (load joined)))
                               0))
                           (if (place-decays-to? (load vty) joined)
                               (do
                                 (store! valexpr
                                         (box-expr a
                                                   (load-place-expr a
                                                                    (load valexpr))))
                                 (store! vty joined)
                                 0)
                               (record-place-break! cx
                                                    idx
                                                    (load have_val)
                                                    (load vty)
                                                    (load valexpr)))))
                   (None []
                         (do
                           (store! (field (elem (field cx loops)
                                                idx)
                                          break_ty)
                                   (Some (load (load vty))))
                           (record-place-break! cx
                                                    idx
                                                    (load have_val)
                                                    (load vty)
                                                    (load valexpr))))))
               ; A void value carries nothing: evaluate it, then leave bare.
               (if (and (load have_val) (type-is-void (load vty)))
                   (let [(mut seq) (ArrayList::new [Expr] a)]
                     (push! (mut seq) (load (load valexpr)))
                     (push! (mut seq)
                            (mk-expr (EBreak label (None [(ptr Expr)]))
                                     elo
                                     ehi
                                     esrc
                                     ectxt))
                     (ok-ep (mk-expr (EDo (box-al [Expr] a (load seq)))
                                     elo
                                     ehi
                                     esrc
                                     ectxt)
                            (TNever)))
                   (ok-ep (mk-expr (EBreak label
                                           (if (load have_val)
                                               (Some (load valexpr))
                                               (None [(ptr Expr)])))
                                   elo
                                   ehi
                                   esrc
                                   ectxt)
                          (TNever)))))))))

(defn synth-continue [(a (dyn Allocator))
                      (label (Option (slice u8)))
                      (cx (ptr Cx))
                      (fname (slice u8))
                      (elo i64)
                      (ehi i64)
                      (esrc i64)
                      (ectxt i64)] (-> (Result EvalPair Diag))
  (if (= (loops-len cx) 0)
      (err-ep (derr (sconcat3 a "in '" fname "': continue outside of a loop")))
      (match label
        (Some [l]
              (if (< (loops-rpos-label cx l) 0)
                  (err-ep (derr (sconcat a
                                         (sconcat4 a
                                                   "in '"
                                                   fname
                                                   "': continue to unknown loop label ':"
                                                   l)
                                         "'")))
                  (ok-ep (mk-expr (EContinue label) elo ehi esrc ectxt)
                         (TNever))))
        (_ (ok-ep (mk-expr (EContinue label) elo ehi esrc ectxt) (TNever))))))

; ---- bin/cmp ----
(defn mk-branch [(e (ptr Expr)) (t (ptr Type))] (-> Branch)
  (let [p (primitive/alloc-stack Branch)]
    (set! (.e p) e)
    (set! (.t p) t)
    (load p)))

;;; A primitive operand is a value. A reference-typed operand — a `(mut x)` local
;;; or a by-reference parameter — is read, the way an ordinary call's argument is.
;;; Without this a primitive received the reference itself: arithmetic reported
;;; "i64 vs (mut i64)", and `(primitive/code-nth m k)` with a `(mut k)` indexed
;;; with the reference and failed "index out of range" on a correct program.
(defn primitive-operand [(a (dyn Allocator)) (sp SynPair)] (-> SynPair)
  (if (= (type-tag (.t sp)) 5)
      (let [e (.e sp)]
        (mk-synpair a
                    (box-expr a (mk-expr (ELoad e) (.lo e) (.hi e) (.source e) (.ctxt e)))
                    (t-inner (.t sp))))
      sp))

(defn synth-binop [(a (dyn Allocator))
                   (op i64)
                   (lhs (ptr Expr))
                   (rhs (ptr Expr))
                   (iscmp bool)
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [lsp (primitive-operand a (try! (do-synth a lhs (null-type) env cx tps fname)))
               lp (primitive/alloc-stack SynPair)]
           (store! lp lsp)
           (let [rsp (primitive-operand a (try! (do-synth a rhs (null-type) env cx tps fname)))
                 rp (primitive/alloc-stack SynPair)]
             (store! rp rsp)
             (let [(mut brs) (ArrayList::new [Branch] a)
                   outl (box-al [Expr] a (ArrayList::new [Expr] a))]
               (push! (mut brs)
                      (mk-branch (load (field lp e)) (load (field lp t))))
               (push! (mut brs)
                      (mk-branch (load (field rp e)) (load (field rp t))))
               (let [t
                       (try! (unify-branches a
                                             (box-al [Branch] a (load brs))
                                             outl
                                             fname
                                             (if iscmp
                                                 "comparison"
                                                 "arithmetic")))
                     tp (box-type a t)]
                 (if (not (numeric tp tps))
                     (return-from :try
                                    (err-ep (derr (sconcat a
                                                           (sconcat3 a
                                                                     "in '"
                                                                     fname
                                                                     "': ")
                                                           (sconcat a
                                                                    (if iscmp
                                                                        "comparison requires integers, got "
                                                                        "arithmetic requires integers, got ")
                                                                    (ty-str a
                                                                            tp))))))
                     (if (and (not iscmp)
                              (and (>= op 12)
                                   (type-is-float tp)))
                         (err-ep (derr (sconcat a
                                                (sconcat3 a
                                                          "in '"
                                                          fname
                                                          "': integer primitive requires an integer, got ")
                                                (ty-str a tp))))
                         (if iscmp
                             (ok-ep (mk-expr (ECmp
                                               :op op
                                               :lhs (elem outl 0)
                                               :rhs (elem outl 1))
                                             elo
                                             ehi
                                             esrc
                                             ectxt)
                                    (TBool))
                             (ok-ep (mk-expr (EBin
                                               :op op
                                               :lhs (elem outl 0)
                                               :rhs (elem outl 1))
                                             elo
                                             ehi
                                             esrc
                                             ectxt)
                                    (if (>= op 15)
                                        (TBool)
                                        t))))))))))))

; ---- small arg-loop helpers ----
(defn synth-vector [(a (dyn Allocator)) (op VectorOp) (requested Type)
                    (args (ptr (ArrayList Expr)))
                    (env (ptr (ArrayList EnvEntry))) (cx (ptr Cx))
                    (tps (ptr (ArrayList (slice u8)))) (fname (slice u8))
                    (lo i64) (hi i64) (src i64) (ctxt i64)] (-> (Result EvalPair Diag))
  (try
    (let [requested-p (box-type a requested)
          (mut types) (ArrayList::new [Type] a)
          (mut values) (ArrayList::new [Expr] a)]
      (unless (type-is-void requested-p) (try! (validate-type requested-p cx tps)))
      (for [i 0 (len (load args))]
        (let [wanted (if (and (= i 0) (= (type-tag requested-p) 9)
                             (match op (VectorSplat [] true) (_ false)))
                         (t-inner requested-p) (null-type))
              value (try! (do-synth a (elem args i) wanted env cx tps fname))
              sp (primitive/alloc-stack SynPair)]
          (set! sp value)
          (if (= (type-tag (.t sp)) 5)
              (do
                (push! (mut types) (load (t-inner (.t sp))))
                (push! (mut values) (mk-expr (ELoad (.e sp)) lo hi src ctxt)))
              (do (push! (mut types) (load (.t sp)))
                  (push! (mut values) (load (.e sp)))))))
      (let [tp (box-al [Type] a (load types))
            vp (box-al [Expr] a (load values))
            result (try! (vector-signature a op requested-p tp vp true))]
        (ok-ep (mk-expr (EVector op result tp vp) lo hi src ctxt) result)))))

(defn synth-stack-bytes-args [(a (dyn Allocator))
                              (args (ptr (ArrayList Expr)))
                              (result (ptr Type))
                              (env (ptr (ArrayList EnvEntry)))
                              (cx (ptr Cx))
                              (tps (ptr (ArrayList (slice u8))))
                              (fname (slice u8))] (-> (Result (ptr (ArrayList Expr))
                                                              Diag))
  (let [wanted (box-type a (TInt 64 false))
        returned (box-type a (TPtr (box-type a (TInt 8 false))))]
    (if (or (!= (len (load args)) 1) (not (type-eq result returned)))
        (Err [(ptr (ArrayList Expr)) Diag]
             (derr "alloc-stack-bytes: expects one u64 byte count and returns (ptr u8)"))
        (match (do-synth a (elem args 0) wanted env cx tps fname)
          (Err [d] (Err [(ptr (ArrayList Expr)) Diag] d))
          (Ok [value]
              (let [sp (primitive/alloc-stack SynPair)
                    (mut out) (ArrayList::new [Expr] a)]
                (set! sp value)
                (if (not (type-eq (.t sp) wanted))
                    (Err [(ptr (ArrayList Expr)) Diag]
                         (mismatch-msg a
                                       (.t sp)
                                       wanted
                                       fname
                                       "alloc-stack-bytes byte count"))
                    (do
                      (push! (mut out) (load (.e sp)))
                      (Ok (box-al [Expr] a (load out)))))))))))

(defn synth-discard-args [(a (dyn Allocator))
                          (args (ptr (ArrayList Expr)))
                          (forbidvoid bool)
                          (voidmsg (slice u8))
                          (env (ptr (ArrayList EnvEntry)))
                          (cx (ptr Cx))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))] (-> (Result (ptr (ArrayList Expr))
                                                          Diag))
  (let [n (len (load args))
        (mut out) (ArrayList::new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (do-synth a
                                 (elem args (load i))
                                 (null-type)
                                 env
                                 cx
                                 tps
                                 fname)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [sp0]
                      (let [sp (primitive/alloc-stack SynPair)]
                        (set! sp sp0)
                        (if (and forbidvoid (type-is-void (load (field sp t))))
                            (do
                              (set! err (derr voidmsg))
                              (set! failed true)
                              (break))
                            (push! (mut out) (load (load (field sp e))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Expr)) Diag] (load err))
        (Ok (box-al [Expr] a (load out))))))

;;; Why code operation OP cannot answer with the sum its primitive declares, if it
;;; cannot. The answer crosses into a compiled metaprogram as Code, so each field
;;; of each variant is Code or another sum of that shape (metalower's decoder and
;;; the host's encoder follow the same declaration).
(defn codeop-answer-problem [(a (dyn Allocator)) (cx (ptr Cx)) (op i64)] (-> (Option (slice u8)))
  (match (codeop-answer op)
    (None [] (None [(slice u8)]))
    (Some [sum] (answer-sum-problem a cx sum 0))))

(defn answer-sum-problem [(a (dyn Allocator)) (cx (ptr Cx)) (sum (slice u8)) (depth i64)] (-> (Option (slice u8)))
  (let [info (sum-find cx sum)]
    (cond (= (primitive/cast i64 info) 0)
            (Some (sconcat3 a "the answer type '" sum "' is not a sum this program defines"))
          (> (len (load (.type_params info))) 0)
            (Some (sconcat3 a "the answer type '" sum "' is generic"))
          (> depth 8)
            (Some (sconcat3 a "the answer type '" sum "' nests sums more than eight deep"))
          :else
            (block :found
              (for [i 0 (len (load (.variants info)))]
                (let [v (elem (.variants info) i)]
                  (for [j 0 (len (load (.fields v)))]
                    (match (.ty (elem (.fields v) j))
                      (TCode [] 0)
                      (TStruct [inner]
                               (match (answer-sum-problem a cx inner (+ depth 1))
                                 (Some [msg] (break :found (Some msg)))
                                 (None [] 0)))
                      (_ (break :found
                                (Some (sconcat3 a
                                                (sconcat3 a "the answer type '" sum "' has a field of variant '")
                                                (.name v)
                                                "' that is neither Code nor such a sum")))))))
                0)
              (None [(slice u8)])))))

(defn codeop-rty [(op i64)] (-> Type)
  (match (codeop-answer op)
    (Some [sum] (TStruct sum))
    (None [] (codeop-scalar-rty op))))

(defn codeop-scalar-rty [(op i64)] (-> Type)
  ; code-line (40) and code-col (42) are integers alike.
  (cond (or (= op 40) (= op 42)
            (or (= op 37)
                (or (or (= op 92) (or (= op 93) (= op 97)))
                (or (= op 3)
                    (or (= op 6)
                        (or (= op 14)
                            (or (= op 16)
                                (or (= op 19)
                                    (or (= op 21)
                                        (or (= op 22)
                                            (or (= op 56)
                                                (or (= op
                                                       71)
                                                    (or (= op
                                                           77)
                                                        (= op
                                                           24))))))))))))))
          (TInt 64 true)
        (or (= op 81)
            (or (= op 96)
            (or (= op 41)
                (or (= op 43)
                    (or (= op 5)
                        (or (= op 13)
                            (or (= op
                                   33)
                                (or (= op
                                       38)
                                    (= op
                                       52)))))))))
          (TSlice (box-type (unit-allocator) (TInt 8 false)))
        (or (= op 0)
            (or (= op 1)
                (or (= op 2)
                    (or (= op 10)
                        (or (= op 11)
                            (or (= op 34)
                                (or (= op 45)
                                    (or (= op 53)
                                        (or (= op 39)
                                            (or (= op 54)
                                                (or (= op
                                                       55)
                                                    (or (= op
                                                           57)
                                                        (= op
                                                           73)))))))))))))
          (TBool)
        (or (= op 85)
            (or (= op 69) (= op 70)))
          (TBool)
        (= op 9) (TNever)
        ; docs/design/META_MEMORY.md phase 4: 60 makes a builder, 61 returns the
        ; builder it pushed onto. 62 (code-list-done) freezes one and lands in
        ; the :else TCode bucket.
        (or (= op 60) (= op 61))
          (TCodeBuilder)
        :else (TCode)))

(defn ty-is-code-builder [(t Type)] (-> bool)
  (match t (TCodeBuilder [] true) (_ false)))

;;; How many leading arguments of code operation `op` must be finished Code: the
;;; operations that take a node apart or read where it came from. Each of them
;;; reads its argument as a node, so anything else -- an integer -- would be read
;;; as one (the compiled engine calls the hot ones directly), and crashed.
(defn codeop-code-arity [(op i64)] (-> i64)
  (cond (or (= op 0) (= op 1) (= op 2) (= op 3) (= op 4) (= op 5) (= op 6) (= op 7)
            (= op 11) (= op 54) (= op 55) (= op 56) (= op 73) (= op 81)
            (= op 33) (= op 40) (= op 41) (= op 42) (= op 43))
          1
        (= op 10) 2
        :else 0))

; docs/design/META_MEMORY.md phase 4: builder discipline for the code ops.
; `code-list-push!` (61) and `code-list-done` (62) REQUIRE a builder as their
; first argument — a finished Code list cannot be mutated in place — and every
; OTHER code op takes finished Code, so a builder anywhere else is an error
; that names the fix. This lives here rather than in a general signature table
; because the builder is the one code-op type that must not unify with Code.
(defn synth-codeop-args [(a (dyn Allocator))
                         (op i64)
                         (args (ptr (ArrayList Expr)))
                         (env (ptr (ArrayList EnvEntry)))
                         (cx (ptr Cx))
                         (tps (ptr (ArrayList (slice u8))))
                         (fname (slice u8))] (-> (Result (ptr (ArrayList Expr))
                                                         Diag))
  (let [n (len (load args))
        (mut out) (ArrayList::new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false
        wants-builder
          (or (= op 61) (= op 62))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (do-synth a
                                 (elem args (load i))
                                 (null-type)
                                 env
                                 cx
                                 tps
                                 fname)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [sp0]
                      (let [sp (primitive/alloc-stack SynPair)
                            _s (set! sp (primitive-operand a sp0))
                            isb (ty-is-code-builder (load (field sp t)))
                            first-builder-slot
                              (and wants-builder
                                   (= (load i) 0))]
                        (cond (and (< (load i) (codeop-code-arity op))
                                   (not (match (load (load (field sp t)))
                                          (TCode [] true) (TNever [] true) (TError [] true) (_ false))))
                                (let [arg (elem args (load i))]
                                  (store! err
                                          (derr-at-src (.source arg) (.lo arg) (.hi arg)
                                                       (sconcat3 a
                                                                 "in '"
                                                                 fname
                                                                 (sconcat3 a
                                                                           "': this Code operation reads its argument as Code, got "
                                                                           (ty-str a (load (field sp t)))
                                                                           (if isb "; freeze the builder first with (primitive/code-list-done b)" "")))))
                                  (store! failed true)
                                  (break))
                              (and (= op 4) (= (load i) 1)
                                   (not (match (load (load (field sp t)))
                                          (TInt [_ _] true) (TNever [] true) (TError [] true) (_ false))))
                                (let [arg (elem args (load i))]
                                  (store! err
                                          (derr-at-src (.source arg) (.lo arg) (.hi arg)
                                                       (sconcat3 a
                                                                 "in '"
                                                                 fname
                                                                 (sconcat a "': code-nth's index must be an integer, got "
                                                                          (ty-str a (load (field sp t)))))))
                                  (store! failed true)
                                  (break))
                              (and first-builder-slot (not isb))
                                (do
                                  (store! err
                                          (derr (sconcat3 a
                                                          "in '"
                                                          fname
                                                          "': code-list-push!/code-list-done expect a builder from (primitive/code-list-new) — a finished Code list cannot be mutated in place")))
                                  (store! failed true)
                                  (break))
                              (and isb (not first-builder-slot))
                                (do
                                  (store! err
                                          (derr (sconcat3 a
                                                          "in '"
                                                          fname
                                                          "': this Code op reads finished Code — freeze the builder first with (primitive/code-list-done b)")))
                                  (store! failed true)
                                  (break))
                              :else (push! (mut out) (load (load (field sp e))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Expr)) Diag] (load err))
        (Ok (box-al [Expr] a (load out))))))

(defn synth-callptr-args [(a (dyn Allocator))
                          (params (ptr (ArrayList Type)))
                          (args (ptr (ArrayList Expr)))
                          (env (ptr (ArrayList EnvEntry)))
                          (cx (ptr Cx))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))] (-> (Result (ptr (ArrayList Expr))
                                                          Diag))
  (let [n (len (load args))
        (mut out) (ArrayList::new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [wp (elem params (load i))
                      ismut (is-mut-borrow (elem args (load i)))
                      ; As for a direct call, a shared `(ref T)` parameter types
                      ; its argument as a `T` place, then borrows it. A `(mut T)`
                      ; parameter keeps call-ptr's plain coercion: an indirect
                      ; call has never required the `(mut …)` spelling.
                      shared (match (load wp) (TRef [m _] (not m)) (_ false))
                      exp (if shared (t-inner wp) wp)
                      what
                        (sconcat a
                                 "call-ptr argument "
                                 (i64->str a (primitive/iadd (load i) 1)))]
                  (match (synth-arg a
                                   (elem args (load i))
                                   exp
                                   shared
                                   env
                                   cx
                                   tps
                                   fname)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)]
                          (set! sp sp0)
                          (match (if shared
                                     (coerce-arg a ismut (load (load (field sp e))) (load (field sp t))
                                                 wp false fname what)
                                     (coerce a (load (load (field sp e))) (load (field sp t))
                                             wp false fname what))
                            (Err [d]
                                 (do (set! err d) (set! failed true) (break)))
                            (Ok [ce] (push! (mut out) ce)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Expr)) Diag] (load err))
        (Ok (box-al [Expr] a (load out))))))

; ---- per-arm helpers for the complex variants ----
(defn synth-do [(a (dyn Allocator))
                (body (ptr (ArrayList Expr)))
                (expected (ptr Type))
                (env (ptr (ArrayList EnvEntry)))
                (cx (ptr Cx))
                (tps (ptr (ArrayList (slice u8))))
                (fname (slice u8))
                (elo i64)
                (ehi i64)
                (esrc i64)
                (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [outl (box-al [Expr] a (ArrayList::new [Expr] a))
               last
                 (try! (synth-let-body a
                                       body
                                       expected
                                       outl
                                       env
                                       cx
                                       tps
                                       fname
                                       "do result"))]
           (ok-ep (mk-expr (EDo outl) elo ehi esrc ectxt) last)))))

;;; `(defer* cleanup)` and the forms it guards. The cleanup is a statement; the
;;; guarded forms are a body whose value is the defer's. Ownership elaboration
;;; later places the cleanup at every exit from the body.
(defn synth-defer [(a (dyn Allocator))
                   (cleanup (ptr Expr))
                   (body (ptr (ArrayList Expr)))
                   (expected (ptr Type))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (let [csp (try! (do-synth a cleanup (discard-expected a) env cx tps fname))
             outl (box-al [Expr] a (ArrayList::new [Expr] a))
             depth (.defer_depth cx)
             body-type (do
                         (set! (.defer_depth cx) (+ depth 1))
                         (let [r (synth-let-body a body expected outl env cx tps fname "defer body")]
                           (set! (.defer_depth cx) depth)
                           r))
             (mut last) (try! body-type)]
         ; The cleanup runs after the body's value is computed; a place would be
         ; read after it. Read it first.
         (when (= (type-tag (box-type a (load last))) 5)
           (let [n (len (load outl))
                 tail (elem outl (- n 1))]
             (set! tail (load-place-expr a tail))
             (set! last (load (t-inner (box-type a (load last)))))
             0))
         (ok-ep (mk-expr (EDefer (.e csp) outl) elo ehi esrc ectxt) (load last)))))

(defn synth-if [(a (dyn Allocator))
                (cnd (ptr Expr))
                (thn (ptr Expr))
                (els (ptr Expr))
                (expected (ptr Type))
                (env (ptr (ArrayList EnvEntry)))
                (cx (ptr Cx))
                (tps (ptr (ArrayList (slice u8))))
                (fname (slice u8))
                (elo i64)
                (ehi i64)
                (esrc i64)
                (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [csp0 (try! (do-synth a cnd (null-type) env cx tps fname))
               csp (primitive/alloc-stack SynPair)]
           (store! csp csp0)
           ; A `(mut b)` local is a place; the condition reads its value, as
           ; every other value position does.
           (when (and (= (type-tag (load (field csp t))) 5)
                      (is-cond (t-inner (load (field csp t)))))
             (store! (field csp e)
                     (box-expr a (load-place-expr a (load (field csp e)))))
             (store! (field csp t) (t-inner (load (field csp t))))
             0)
           (when (not (is-cond (load (field csp t))))
             (break :try
                      (err-ep (derr (sconcat a
                                             (sconcat3 a
                                                       "in '"
                                                       fname
                                                       "': if condition must be a bool or integer, got ")
                                             (ty-str a (load (field csp t))))))))
           (if (expected-some? expected)
               (let [te
                       (try! (check-to a
                                       thn
                                       expected
                                       env
                                       cx
                                       tps
                                       fname
                                       "if branch"))
                     ee
                       (try! (check-to a
                                       els
                                       expected
                                       env
                                       cx
                                       tps
                                       fname
                                       "if branch"))]
                 (ok-ep (mk-expr (EIf
                                   :cnd (load (field csp e))
                                   :thn (box-expr a te)
                                   :els (box-expr a ee))
                                 elo
                                 ehi
                                 esrc
                                 ectxt)
                        (load expected)))
               (let [tsp0 (try! (do-synth a thn (null-type) env cx tps fname))
                     tsp (primitive/alloc-stack SynPair)]
                 (store! tsp tsp0)
                 (let [esp0 (try! (do-synth a els (null-type) env cx tps fname))
                       esp (primitive/alloc-stack SynPair)]
                   (store! esp esp0)
                   (let [(mut brs) (ArrayList::new [Branch] a)
                         outl (box-al [Expr] a (ArrayList::new [Expr] a))]
                     (push! (mut brs)
                            (mk-branch (load (field tsp e))
                                       (load (field tsp
                                                    t))))
                     (push! (mut brs)
                            (mk-branch (load (field esp e))
                                       (load (field esp
                                                    t))))
                     (let [t
                             (try! (unify-branches a
                                                   (box-al [Branch]
                                                           a
                                                           (load brs))
                                                   outl
                                                   fname
                                                   "if branches"))]
                       (ok-ep (mk-expr (EIf
                                         :cnd (load (field csp e))
                                         :thn (elem outl 0)
                                         :els (elem outl 1))
                                       elo
                                       ehi
                                       esrc
                                       ectxt)
                              t))))))))))

(defn accessor-expr? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EAccessorField [_ _] true)
    (EField [_ _] true)
    (_ false)))

; The pieces a field-trait call needs from an accessor place: the field name, the
; checked receiver, and the type the impl is written against (the pointee of a
; place, or the value's own type).
(defstruct FieldTarget
  [(ok bool) (ffld (slice u8)) (target Expr) (ty (ptr Type))])

; ---- field access through traits --------------------------------------------
; A real struct field is read, written and borrowed exactly as before. Only where
; the type HAS no such field does the checker look for an ordinary impl member —
; `get-field`, `set-field!` or `field-place` — whose Self is `(Field X :name)`.
; Existing programs never reach this path, and a type with no impl gets the same
; error it always did.
(defn field-marker-type [(a (dyn Allocator)) (target (ptr Type)) (ffld (slice u8))] (-> Type)
  (let [(mut args) (ArrayList::new [Type] a)]
    (push! (mut args) (load target))
    (push! (mut args) (TConst (ConstKeyword ffld)))
    (TApp (core-name "Field") (box-al [Type] a (load args)))))

(defstruct FieldImpl
  [(ip (ptr ImplDef)) (trait (slice u8)) (ambiguous bool)])

(defn field-impl-none [] (-> FieldImpl)
  (FieldImpl :ip (primitive/cast (ptr ImplDef) 0) :trait "" :ambiguous false))

(defn field-impl-found? [(f (ptr FieldImpl))] (-> bool)
  (!= (primitive/cast i64 (load (field f ip))) 0))

; The member name decides, exactly as `call` does for a callable value: any trait
; with a member of that name on `(Field X :name)` answers.
(defn field-impl-find [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (selfty (ptr Type))
                       (method (slice u8))
                       (tps (ptr (ArrayList (slice u8))))] (-> FieldImpl)
  (let [out (primitive/alloc-stack FieldImpl)
        traits (field cx trait_defs)]
    (store! out (field-impl-none))
    (for [i 0 (len (load traits))]
      (let [tr (load (field (elem traits i) name))
            self0 (deref-to-impl a cx tr selfty tps)
            sel (primitive/alloc-stack ImplSel)]
        (store! sel (cx-impl-select a cx tr self0))
        (let [ip (load (field sel ip))]
          (when (and (!= (primitive/cast i64 ip) 0)
                     (!= (primitive/cast i64 (impl-find-method ip method))
                         0))
            (if (field-impl-found? out)
                (when (!= (primitive/cast i64 (load (field out ip)))
                          (primitive/cast i64 ip))
                  (set! (.ambiguous out) true)
                  0)
                (do (set! (.ip out) ip) (set! (.trait out) tr) 0))
            0)))
      0)
    (load out)))

; `(METHOD (zeroed (Field X :name)) TARGET EXTRA…)`, lowered to the impl's own
; monomorphized function the way every other trait call is.
(defn synth-field-trait-call [(a (dyn Allocator))
                              (cx (ptr Cx))
                              (found (ptr FieldImpl))
                              (method (slice u8))
                              (selfty (ptr Type))
                              (target Expr)
                              (extra (ptr (ArrayList Expr)))
                              (ffld (slice u8))
                              (expected (ptr Type))
                              (env (ptr (ArrayList EnvEntry)))
                              (tps (ptr (ArrayList (slice u8))))
                              (fname (slice u8))
                              (elo i64)
                              (ehi i64)
                              (esrc i64)
                              (ectxt i64)] (-> (Result EvalPair Diag))
  (if (load (field found ambiguous))
      (err-ep (derr (sconcat a
                             (sconcat4 a "in '" fname "': ambiguous field implementations for "
                                       (ty-str a selfty))
                             "")))
      (let [ip (load (field found ip))
            (mut args) (ArrayList::new [Expr] a)]
        (push! (mut args) (mk-expr (EZeroed (load selfty)) elo ehi esrc ectxt))
        (push! (mut args) target)
        (for [i 0 (len (load extra))] (push! (mut args) (get (load extra) i)) 0)
        (synth-call-general a
                            method
                            (tmfn a
                                  (load (field found trait))
                                  (impl-mangle-key a
                                                   (field ip self_type)
                                                   (load (field ip type_params)))
                                  method)
                            (box-items-type a)
                            (box-al [Expr] a (load args))
                            expected
                            env
                            cx
                            tps
                            fname
                            elo
                            ehi
                            esrc
                            ectxt))))

(defn no-extra-args [(a (dyn Allocator))] (-> (ptr (ArrayList Expr)))
  (box-al [Expr] a (ArrayList::new [Expr] a)))

; Does this type have `ffld` as a real field? Only a struct or generic instance can.
(defn has-real-field? [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type)) (ffld (slice u8))] (-> bool)
  (if (not (is-struct-or-app t))
      false
      (match (struct-fields a t cx)
        (Err [_] false)
        (Ok [fs]
            (let [(mut found) false]
              (for [i 0 (len (load fs))]
                (when (= (load (field (elem fs i) name)) ffld)
                  (store! found true)
                  0)
                0)
              (load found))))))

(defn field-target-of [(a (dyn Allocator))
                       (pp (ptr Expr))
                       (env (ptr (ArrayList EnvEntry)))
                       (cx (ptr Cx))
                       (tps (ptr (ArrayList (slice u8))))
                       (fname (slice u8))] (-> FieldTarget)
  (let [out (primitive/alloc-stack FieldTarget)]
    (set! (.ok out) false)
    (set! (.ffld out) "")
    (set! (.ty out) (primitive/cast (ptr Type) 0))
    (match (.kind pp)
      (EAccessorField [_ ffld] (do (set! (.ffld out) ffld) (set! (.ok out) true) 0))
      (EField [_ ffld] (do (set! (.ffld out) ffld) (set! (.ok out) true) 0))
      (_ 0))
    (when (load (field out ok))
      (let [base (match (.kind pp)
                   (EAccessorField [base _] base)
                   (EField [base _] base)
                   (_ pp))]
        (match (do-synth a base (null-type) env cx tps fname)
          (Err [_] (do (set! (.ok out) false) 0))
          (Ok [bsp0]
              (let [bsp (primitive/alloc-stack SynPair)]
                (store! bsp bsp0)
                (let [bt (load (field bsp t))
                      pointee (place-pointee bt)]
                  (set! (.target out) (load (load (field bsp e))))
                  (set! (.ty out) (if (= (primitive/cast i64 pointee) 0)
                                      bt
                                      pointee))
                  (when (has-real-field? a cx (load (field out ty)) (load (field out ffld)))
                    (set! (.ok out) false)
                    0)
                  0))))
        0))
    (load out)))

;;; Is `e` a place inside a spilled temporary: `(.a (.b (f)))` checks to field
;;; projections and loads over `ESpillRef`.
(defn place-in-spilled-temporary? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EField [p _] (place-in-spilled-temporary? p))
    (ELoad [inner] (place-in-spilled-temporary? inner))
    (ESpillRef [_] true)
    (_ false)))

(defn synth-field [(a (dyn Allocator))
                   (pp (ptr Expr))
                   (ffld (slice u8))
                   (accessor bool)
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [psp (try! (do-synth a pp (null-type) env cx tps fname))
               sp (primitive/alloc-stack SynPair)]
           (store! sp psp)
           (let [(mut checked-base) (load (field sp e))
                 (mut pt) (load (field sp t))
                 (mut pointee) (place-pointee (load pt))]
             ; Place parsing preserves an accessor chain so embedded structs can
             ; project directly into their owner. If that projected field stores
             ; a pointer, however, the next accessor needs the pointer VALUE, not
             ; the address of the pointer field. This is the contextual read that
             ; makes `(.bounds (.drag-pane c))` mean what its surface spelling says.
             (when (and accessor
                        (and (!= (primitive/cast i64 (load pointee))
                                 0)
                             (!= (primitive/cast i64
                                                 (place-pointee (load pointee)))
                                 0)))
               (set! checked-base
                     (box-expr a
                               (mk-expr (ELoad (box-expr a (load checked-base)))
                                        elo
                                        ehi
                                        esrc
                                        ectxt)))
               (set! pt (load pointee))
               (set! pointee (place-pointee (load pt)))
               0)
             ; `field` needs a PLACE. The value case is almost always a collection read
             ; used inline — `(field (get l i) x)` — and the old message said what was
             ; wrong without saying what to write, which left "one by-ref accessor per
             ; field" looking like the only way out. Both remedies are one line, so name
             ; them: a `let` gives the value an address, and the containers that can hand
             ; back a live element already expose `elem`.
             (when (= (primitive/cast i64 (load pointee))
                      0)
               (let [selfty (box-type a (field-marker-type a (load pt) ffld))
                     found (primitive/alloc-stack FieldImpl)]
                 (store! found (field-impl-find a cx selfty "get-field" tps))
                 (when (field-impl-found? found)
                   (break :try
                            (synth-field-trait-call a cx found "get-field" selfty
                                                    (load (load (field sp e)))
                                                    (no-extra-args a) ffld (null-type) env tps fname
                                                    elo ehi esrc ectxt))))
               ; `(.name value)` on a struct value that is not a place: a call
               ; result, a `for` element, a match payload. Spill it to a frame
               ; temporary and read through that. The borrow is immutable, so a
               ; write through the temporary is rejected like any other.
               (when (and accessor
                          (and (is-struct-or-app (load pt))
                               (has-real-field? a cx (load pt) ffld)))
                 (let [value-type (load pt)]
                   (set! checked-base
                         (box-expr a
                                   (mk-expr (ESpillRef (box-expr a (load checked-base)))
                                            elo
                                            ehi
                                            esrc
                                            ectxt)))
                   (set! pt (box-type a (TRef false (box-type a value-type))))
                   (set! pointee (place-pointee (load pt)))
                   0)))
             (when (= (primitive/cast i64 (load pointee))
                      0)
               (break :try
                        (err-ep (derr (sconcat a
                                               (sconcat a
                                                        (sconcat3 a
                                                                  "in '"
                                                                  fname
                                                                  "': field access needs a pointer or reference, got ")
                                                        (ty-str a (load pt)))
                                               "; bind it to a `let` first and take the field of that, or read the element by reference (an ArrayList has the method `elem`, which returns a pointer to the live element)")))))
             (when (not (has-real-field? a cx (load pointee) ffld))
               (let [selfty (box-type a (field-marker-type a (load pointee) ffld))
                     found (primitive/alloc-stack FieldImpl)]
                 (store! found (field-impl-find a cx selfty "get-field" tps))
                 (when (field-impl-found? found)
                   (break :try
                            (synth-field-trait-call a cx found "get-field" selfty
                                                    (load (load checked-base))
                                                    (no-extra-args a) ffld (null-type) env tps fname
                                                    elo ehi esrc ectxt)))
                 ; no reader: the place the type hands back is the field, and a
                 ; surrounding load or `.name` step reads through it.
                 (store! found (field-impl-find a cx selfty "field-place" tps))
                 (when (field-impl-found? found)
                   (break :try
                            (synth-field-trait-call a cx found "field-place" selfty
                                                    (load (load checked-base))
                                                    (no-extra-args a) ffld (null-type) env tps fname
                                                    elo ehi esrc ectxt))))
               0)
             (when (not (is-struct-or-app (load pointee)))
               (break :try
                        (err-ep (derr (sconcat a
                                               (sconcat3 a
                                                         "in '"
                                                         fname
                                                         "': field access needs a pointer to a struct, got (ptr ")
                                               (sconcat a
                                                        (ty-str a
                                                                (load pointee))
                                                        ")"))))))
             (let [sname (struct-name (load pointee))
                   si (struct-find cx sname)]
               ; a type parameter names no struct: its field is filed under `_`
               (source-field-use! (if (= (primitive/cast i64 si) 0) "_" sname) ffld)
               (when (and (!= (primitive/cast i64 si) 0)
                          (load (field si is_bits)))
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat a
                                                          (sconcat a
                                                                   (sconcat a
                                                                            (sconcat5 a
                                                                                      "in '"
                                                                                      fname
                                                                                      "': '"
                                                                                      sname
                                                                                      "' is a (coil.layout.Bits) struct; use (primitive/bit-get p ")
                                                                            ffld)
                                                                   ") / (primitive/bit-set! p ")
                                                          ffld)
                                                 " v)")))))
               (match (struct-fields a (load pointee) cx)
                 (Err [d]
                      (return-from :try
                                     (err-ep (prefix-diag a
                                                          d
                                                          (sconcat4 a
                                                                    "in '"
                                                                    fname
                                                                    "': "
                                                                    "")))))
                 (Ok [fs]
                     (let [nf (len (load fs))
                           (mut i) 0
                           (mut fty) (primitive/cast (ptr Type) 0)]
                       (loop (if (>= (load i) nf)
                                 (break)
                                 (do
                                   (when (= (load (field (elem fs
                                                               (load i))
                                                         name))
                                            ffld)
                                     (store! fty
                                             (field (elem fs
                                                          (load i))
                                                    ty))
                                     (break))
                                   (store! i (primitive/iadd (load i) 1)))))
                       (when (= (primitive/cast i64 (load fty))
                                0)
                         (break :try
                                  (err-ep (derr (sconcat a
                                                         (sconcat a
                                                                  (sconcat4 a
                                                                            "in '"
                                                                            fname
                                                                            "': struct '"
                                                                            (sconcat a
                                                                                     sname
                                                                                     "' has no field '"))
                                                                  ffld)
                                                         "'")))))
                       (ok-ep (mk-expr (EField (load checked-base) ffld)
                                       elo
                                       ehi
                                       esrc
                                       ectxt)
                              (replace-pointee a (load pt) fty)))))))))))

; The store itself, once the place is checked: `place` is the checked place
; expression and `pt` its type. The field-place path passes a checked call here,
; which must not be synthesized again — its function name is already mangled.
(defn synth-store-checked [(a (dyn Allocator))
                           (place Expr)
                           (pt (ptr Type))
                           (val (ptr Expr))
                           (initializing bool)
                           (env (ptr (ArrayList EnvEntry)))
                           (cx (ptr Cx))
                           (tps (ptr (ArrayList (slice u8))))
                           (fname (slice u8))
                           (elo i64)
                           (ehi i64)
                           (esrc i64)
                           (ectxt i64)] (-> (Result EvalPair Diag))
  (try (let [pointee (place-pointee pt)]
         (when (= (primitive/cast i64 pointee) 0)
           (break :try
                    (err-ep (derr (sconcat a
                                           (sconcat3 a
                                                     "in '"
                                                     fname
                                                     "': store! expects a pointer or reference, got ")
                                           (ty-str a pt))))))
         (when (and (not (is-writable pt))
                    (place-in-spilled-temporary? (box-expr a place)))
           (break :try
                    (err-ep (derr (sconcat3 a
                                            "in '"
                                            fname
                                            "': cannot assign to a field of a temporary value; bind it with `(let [(mut v) …])` and assign to that")))))
         (when (not (is-writable pt))
           (break :try
                    (err-ep (derr (sconcat a
                                           (sconcat a
                                                    (sconcat4 a
                                                              "in '"
                                                              fname
                                                              "': cannot store! through immutable reference of type "
                                                              (ty-str a pt))
                                                    " (declare it `(mut …)` to make it writable)")
                                           "")))))
         (let [vsp (try! (do-synth a val pointee env cx tps fname))
               vp (primitive/alloc-stack SynPair)]
           (store! vp vsp)
           (match (coerce a
                          (load (load (field vp e)))
                          (load (field vp t))
                          pointee
                          false
                          fname
                          "store! value")
             (Err [d] (return-from :try (err-ep d)))
             ; std-12: store! is effect-only — it yields unit (canonical i64 0), not the
             ; stored value's type, so an effect-only `if`/block no longer type-mismatches.
             (Ok [ve]
                 (ok-ep (mk-expr (if initializing
                                     (EInitStore (box-expr a place) (box-expr a ve))
                                     (EStore (box-expr a place) (box-expr a ve)))
                                 elo
                                 ehi
                                 esrc
                                 ectxt)
                        (TInt 64 true)))))))) 

(defn synth-store [(a (dyn Allocator))
                   (pp (ptr Expr))
                   (val (ptr Expr))
                   (initializing bool)
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         ; `(set! (.name x) v)` where `x` has no field `name`: the write goes to
         ; the type's own `set-field!`.
         (let [ft (primitive/alloc-stack FieldTarget)]
           (store! ft (field-target-of a pp env cx tps fname))
           (when (load (field ft ok))
             (let [selfty (box-type a (field-marker-type a (load (field ft ty)) (load (field ft ffld))))
                   found (primitive/alloc-stack FieldImpl)]
               (store! found (field-impl-find a cx selfty "set-field!" tps))
               (when (field-impl-found? found)
                 (let [(mut extra) (ArrayList::new [Expr] a)]
                   (push! (mut extra) (load val))
                   (break :try
                            (synth-field-trait-call a cx found "set-field!" selfty
                                                    ; a write takes the receiver mutably
                                                    (mk-expr (EBorrow true
                                                                      (box-expr a (load (field ft target))))
                                                             elo ehi esrc ectxt)
                                                    (box-al [Expr] a (load extra))
                                                    (load (field ft ffld))
                                                    (null-type) env tps fname
                                                    elo ehi esrc ectxt))))
               ; no writer: write through the place the type hands back
               (store! found (field-impl-find a cx selfty "field-place" tps))
               (when (field-impl-found? found)
                 (match (synth-field-trait-call a cx found "field-place" selfty
                                                (load (field ft target))
                                                (no-extra-args a)
                                                (load (field ft ffld))
                                                (null-type) env tps fname
                                                elo ehi esrc ectxt)
                   (Err [d] (break :try (err-ep d)))
                   (Ok [pep]
                       (let [pp2 (primitive/alloc-stack EvalPair)]
                         (store! pp2 pep)
                         (break :try
                                  (synth-store-checked a
                                                       (load (field pp2 e))
                                                       (field pp2 t)
                                                       val
                                                       initializing
                                                       env cx tps fname elo ehi esrc ectxt))))))
               ; readable but not writable: say so, rather than complaining that
               ; the value the reader produced is not a place
               (store! found (field-impl-find a cx selfty "get-field" tps))
               (when (field-impl-found? found)
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat4 a "in '" fname "': field '"
                                                           (sconcat3 a (load (field ft ffld)) "' of " (ty-str a (load (field ft ty)))))
                                                 " is read-only: it has no `set-field!` implementation")))))
               0))
           0)
         (let [psp (try! (do-synth a pp (null-type) env cx tps fname))
               sp (primitive/alloc-stack SynPair)]
           (store! sp psp)
           (synth-store-checked a
                                (load (load (field sp e)))
                                (load (field sp t))
                                val
                                initializing
                                env cx tps fname elo ehi esrc ectxt)))))

;;; A constructor pattern may name a generic struct without its type arguments:
;;; `(Indexed :index i)` matches any `(Indexed T)`, which the value supplies.
(defn bare-generic-pattern? [(ty Type) (value-type (ptr Type))] (-> bool)
  (match ty
    (TStruct [name]
             (match (load value-type)
               (TApp [vname _] (= name vname))
               (_ false)))
    (_ false)))

(defn synth-pattern [(a (dyn Allocator))
                     (op i64)
                     (ty Type)
                     (inner (ptr Expr))
                     (index i64)
                     (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))
                     (lo i64)
                     (hi i64)
                     (src i64)
                     (ctxt i64)] (-> (Result EvalPair Diag))
  (cond (= op 5) (synth-pattern-fail a env cx tps fname lo hi src ctxt)
        (= op 6)
          (err-ep (derr-at-src src
                               lo
                               hi
                               "pattern-default is only the body of a lowered match's catch-all arm"))
        :else (synth-pattern-projection a op ty inner index env cx tps fname lo hi src ctxt)))

;;; `(primitive/pattern-fail)`: where a lowered match's exhaustiveness check
;;; proves no value arrives. It never yields: a loop around the runtime's abort.
(defn synth-pattern-fail [(a (dyn Allocator))
                          (env (ptr (ArrayList EnvEntry)))
                          (cx (ptr Cx))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))
                          (lo i64)
                          (hi i64)
                          (src i64)
                          (ctxt i64)] (-> (Result EvalPair Diag))
  (let [(mut body) (ArrayList::new [Expr] a)]
    (push! (mut body)
           (mk-expr (ECall "coil.binding.runtime.match-fail"
                           (box-al [Type] a (ArrayList::new [Type] a))
                           (box-al [Expr] a (ArrayList::new [Expr] a)))
                    lo
                    hi
                    src
                    ctxt))
    (synth a
           (box-expr a
                     (mk-expr (ELoop (None [(slice u8)]) (box-al [Expr] a (load body)))
                              lo
                              hi
                              src
                              ctxt))
           (null-type)
           env
           cx
           tps
           fname)))

(defn synth-pattern-projection [(a (dyn Allocator))
                                (op i64)
                                (ty Type)
                                (inner (ptr Expr))
                                (index i64)
                                (env (ptr (ArrayList EnvEntry)))
                                (cx (ptr Cx))
                                (tps (ptr (ArrayList (slice u8))))
                                (fname (slice u8))
                                (lo i64)
                                (hi i64)
                                (src i64)
                                (ctxt i64)] (-> (Result EvalPair Diag))
  (try (let [sp (try! (do-synth a inner (null-type) env cx tps fname))
             holder (box! a SynPair sp)
             actual (.t holder)
             place (place-pointee actual)
             value-type (if (= (primitive/cast i64 place) 0) actual place)
             checked (.e holder)]
         (if (or (= op 0) (= op 4))
             (do
               (when (and (= op 0) (not (bare-generic-pattern? ty value-type)))
                 (try! (validate-type (box-type a ty) cx tps))
                 (unless (and (match ty
                                (TStruct [name]
                                         (!= (primitive/cast i64
                                                             (struct-find cx
                                                                          name))
                                             0))
                                (TApp [name _]
                                      (!= (primitive/cast i64
                                                          (struct-find cx name))
                                          0))
                                (_ false))
                              (type-eq value-type (box-type a ty)))
                   (break :try
                            (Err (derr-at-src src
                                              lo
                                              hi
                                              (sconcat3 a
                                                        "constructor pattern requires "
                                                        (ty-str a
                                                                (box-type a ty))
                                                        (sconcat a
                                                                 ", got "
                                                                 (ty-str a
                                                                         value-type))))))))
               (when (and (= op 4) (not (or (= index 0) (= index 1))))
                 (break :try
                          (Err (derr-at-src src
                                            lo
                                            hi
                                            "invalid pattern projection mode"))))
               (if (and (= op 4) (= index 0))
                   (if (type-is-affine a cx value-type)
                       (Err (derr-at-src src
                                         lo
                                         hi
                                         "constructor pattern cannot move an owning field; borrow or clone it explicitly"))
                       (ok-ep (load checked) (load actual)))
                   (let [(mut args) (ArrayList::new [Expr] a)
                         (mut types) (ArrayList::new [Type] a)]
                     (push! (mut args) (load checked))
                     (push! (mut types) (load value-type))
                     (synth a
                            (box-expr a
                                      (mk-expr (ECall "coil.binding.runtime.check-struct"
                                                      (box-al [Type]
                                                              a
                                                              (load types))
                                                      (box-al [Expr]
                                                              a
                                                              (load args)))
                                               lo
                                               hi
                                               src
                                               ctxt))
                            (null-type)
                            env
                            cx
                            tps
                            fname))))
             (do
               (when (< index 0)
                 (break :try
                          (Err (derr-at-src src
                                            lo
                                            hi
                                            "pattern index must be nonnegative"))))
               (let [(mut args) (ArrayList::new [Expr] a)
                     (mut types) (ArrayList::new [Type] a)
                     (mut target) ""
                     (mut source) (load checked)]
                 (match (load value-type)
                   (TCode []
                          (set! target
                                (cond (= op 1)
                                        "coil.binding.runtime.require-code"
                                      (= op 2) "coil.binding.runtime.code-nth"
                                      :else "coil.binding.runtime.code-rest")))
                   (TArray [elem extent]
                           (do
                             (when (match extent
                                     (FixedExtent [count]
                                       (if (= op 2) (>= index count) (> index count)))
                                     (ParamExtent [name]
                                       (break :try
                                                (Err (derr-at-src src lo hi
                                                                  (sconcat3 a "sequence pattern requires an array of literal length, not length '" name "'"))))))
                               (break :try
                                        (Err (derr-at-src src
                                                          lo
                                                          hi
                                                          "sequence pattern requires more elements than the array contains"))))
                             (push! (mut types) (load elem))))
                   (TSlice [elem] (push! (mut types) (load elem)))
                   (_ (break :try
                               (Err (derr-at-src src
                                                 lo
                                                 hi
                                                 "sequence pattern expects Code, a slice, or a fixed array")))))
                 (when (and (= op 2) (> (len (load types)) 0))
                   (when (type-is-affine a cx (elem (mut types) 0))
                     (break :try
                              (Err (derr-at-src src
                                                lo
                                                hi
                                                "sequence pattern cannot move an owning element; borrow or clone it explicitly")))))
                 (when (= (len (load target)) 0)
                   (set! target
                         (cond (= op 1) "coil.binding.runtime.require-slice"
                               (= op 2) "coil.binding.runtime.slice-nth"
                               :else "coil.binding.runtime.slice-rest")))
                 (push! (mut args) (load source))
                 (push! (mut args) (mk-expr (EInt index) lo hi src ctxt))
                 (let [call-expr
                         (box-expr a
                                   (mk-expr (ECall (load target)
                                                   (box-al [Type]
                                                           a
                                                           (load types))
                                                   (box-al [Expr] a (load args)))
                                            lo
                                            hi
                                            src
                                            ctxt))]
                   (synth a
                          (if (and (= op 2) (> (len (load types)) 0))
                              (box-expr a
                                        (mk-expr (EBorrow false call-expr)
                                                 lo
                                                 hi
                                                 src
                                                 ctxt))
                              call-expr)
                          (null-type)
                          env
                          cx
                          tps
                          fname))))))))

; Indexing a pointer to an array steps within that array; indexing any other
; pointer steps by whole elements. The checker makes that choice, but backends
; read it from the pointee type, and in generic code a `(ptr T)` becomes
; `(ptr (array …))` after specialization. A pointer whose pointee is a bare type
; parameter is therefore indexed as a `(ptr (array T 1))`: its element is `T`
; under every specialization, and the step is `sizeof T`.
(defn generic-index-base [(a (dyn Allocator))
                          (base (ptr Expr))
                          (pt (ptr Type))
                          (pointee (ptr Type))
                          (tps (ptr (ArrayList (slice u8))))] (-> (ptr Expr))
  (if (and (= (type-tag pt) 4)
           (and (= (type-tag pointee) 6)
                (set-contains tps (type-struct-name pointee))))
      (box-expr a
                (mk-expr (ECast (TPtr (box-type a (TArray pointee (FixedExtent 1)))) base)
                         (.lo base) (.hi base) (.source base) (.ctxt base)))
      base))

(defn synth-index [(a (dyn Allocator))
                   (pp (ptr Expr))
                   (idx (ptr Expr))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [psp (try! (do-synth a pp (null-type) env cx tps fname))
               sp (primitive/alloc-stack SynPair)]
           (store! sp psp)
           (let [isp (try! (do-synth a idx (null-type) env cx tps fname))
                 ip (primitive/alloc-stack SynPair)]
             (store! ip isp)
             (let [ie
                     (match (coerce a
                                    (load (load (field ip e)))
                                    (load (field ip t))
                                    (box-type a (TInt 64 true))
                                    false
                                    fname
                                    "index")
                       (Err [_]
                            (return-from :try
                                           (err-ep (derr (sconcat3 a
                                                                   "in '"
                                                                   fname
                                                                   "': index must be i64")))))
                       (Ok [ce] ce))
                   ; A reference to a pointer -- a `(mut p)` local or parameter
                   ; holding a `(ptr T)` -- indexes the pointer it holds. Stepping
                   ; across the reference's single cell means nothing, and reading
                   ; that as `(ptr (ptr T))` handed callers a neighbouring slot.
                   held (place-pointee (load (field sp t)))
                   _deref (when (and (= (type-tag (load (field sp t))) 5)
                                     (= (type-tag held) 4))
                            (store! (field sp e)
                                    (box-expr a
                                              (mk-expr (ELoad (load (field sp e)))
                                                       (.lo pp) (.hi pp) (.source pp) (.ctxt pp))))
                            (store! (field sp t) held)
                            0)
                   pt (load (field sp t))
                   pointee (place-pointee pt)]
               (when (= (primitive/cast i64 pointee) 0)
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat3 a
                                                           "in '"
                                                           fname
                                                           "': index expects a pointer or reference, got ")
                                                 (ty-str a pt))))))
               (let [elem
                       (if (= (type-tag pointee) 7)
                           (t-inner pointee)
                           pointee)
                     base (generic-index-base a (load (field sp e)) pt pointee tps)]
                 (ok-ep (mk-expr (EIndex base (box-expr a ie))
                                 elo
                                 ehi
                                 esrc
                                 ectxt)
                        (replace-pointee a pt elem)))))))))

;;; If T points at a struct, record it as converted by a pointer cast.
(defn cast-struct-note! [(t (ptr Type))] (-> i64)
  (let [p (place-pointee t)]
    (when (and (!= (primitive/cast i64 p) 0) (is-struct-or-app p))
      (source-cast-struct! (struct-name p)) 0))
  0)

(defn synth-cast [(a (dyn Allocator))
                  (ty Type)
                  (inner (ptr Expr))
                  (env (ptr (ArrayList EnvEntry)))
                  (cx (ptr Cx))
                  (tps (ptr (ArrayList (slice u8))))
                  (fname (slice u8))
                  (elo i64)
                  (ehi i64)
                  (esrc i64)
                  (ectxt i64)] (-> (Result EvalPair Diag))
  (let [tp (box-type a ty)]
    (match (validate-type tp cx tps)
      (Err [d]
           (err-ep (prefix-diag a
                                d
                                (sconcat3 a "in '" fname "': cast target: "))))
      (Ok [_]
          ; A literal no i64 holds is read as the type it is cast to. The checker
          ; leaves one as exactly that cast, and may check its result again.
          (match (.kind inner)
            (EWideInt [neg lo hi radix text]
                      (synth-wide-int a neg lo hi radix text tp fname elo ehi esrc ectxt))
            (_
          (match (do-synth a inner (null-type) env cx tps fname)
            (Err [d] (err-ep d))
            (Ok [sp0]
                (let [sp (primitive/alloc-stack SynPair)]
                  (set! sp sp0)
                  ; a pointer cast ties both structs' layouts together
                  (cast-struct-note! tp)
                  (cast-struct-note! (load (field sp t)))
                  ; An explicit `(mut x)` borrow casts to its address. Any other operand
                  ; of reference type -- a mutable local named bare, or a reference
                  ; parameter -- whose referent is itself castable (a number or a
                  ; pointer) is read first and its VALUE converted: `(cast (ptr T) p)`
                  ; on a mutable pointer local is p, not &p. A reference to an aggregate
                  ; still casts to the aggregate's address.
                  (when (and (= (type-tag (load (field sp t))) 5)
                             (let [rt (type-tag (t-inner (load (field sp t))))]
                               (or (= rt 0) (= rt 1) (= rt 4) (= rt 10)))
                             (match (.kind (load inner)) (EBorrow [_ _] false) (_ true)))
                    (set! (.e sp) (box-expr a (load-place-expr a (load (field sp e)))))
                    (set! (.t sp) (t-inner (load (field sp t)))))
                  (let [et (load (field sp t))
                        tt (type-tag tp)
                        etg (type-tag et)
                        ok
                          (or (and (= tt 0)
                                   (= etg 0))
                              (or (and (= tt 4)
                                       (= etg 4))
                                  (or (and (= tt 0)
                                           (= etg 4))
                                      (or (and (= tt 4)
                                               (= etg 0))
                                          (or (and (= tt 1)
                                                   (= etg
                                                      1))
                                              (or (and (= tt
                                                          1)
                                                       (= etg
                                                          0))
                                                  (or (and (= tt
                                                              0)
                                                           (= etg
                                                              1))
                                                      (or (and (= tt
                                                                  10)
                                                               (= etg
                                                                  10))
                                                          (or (and (= tt
                                                                      10)
                                                                   (= etg
                                                                      4))
                                                              (or (and (= tt
                                                                          4)
                                                                       (= etg
                                                                          10))
                                                                  ; A borrow is an address. Casting one to a
                                                                  ; raw pointer is the explicit way to hand a
                                                                  ; local's storage to code that takes a
                                                                  ; `(ptr T)`, such as a C function.
                                                                  (and (= tt
                                                                          4)
                                                                       (= etg
                                                                          5))))))))))))]
                    (if ok
                        (ok-ep (mk-expr (ECast ty (load (field sp e)))
                                        elo
                                        ehi
                                        esrc
                                        ectxt)
                               ty)
                        (err-ep (derr (sconcat a
                                               (sconcat a
                                                        (sconcat a
                                                                 (sconcat4 a
                                                                           "in '"
                                                                           fname
                                                                           "': cast only converts among int, float, and ptr, or a borrow to a ptr (got "
                                                                           (ty-str a
                                                                                   et))
                                                                 " to ")
                                                        (ty-str a tp))
                                               ")"))))))))))))))

(defn synth-offsetof [(a (dyn Allocator))
                      (ty Type)
                      (ffld (slice u8))
                      (cx (ptr Cx))
                      (tps (ptr (ArrayList (slice u8))))
                      (fname (slice u8))
                      (elo i64)
                      (ehi i64)
                      (esrc i64)
                      (ectxt i64)] (-> (Result EvalPair Diag))
  (let [tp (box-type a ty)]
    (match (validate-type tp cx tps)
      (Err [d]
           (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': offsetof: "))))
      (Ok [_]
          (try (let [_use (source-field-use! (struct-name tp) ffld)
                     fs
                       (try-or! (struct-fields a tp cx)
                                (err-ep (derr (sconcat a
                                                       (sconcat3 a
                                                                 "in '"
                                                                 fname
                                                                 "': offsetof needs a struct type, got ")
                                                       (ty-str a tp)))))]
                 (let [nf (len (load fs))
                       (mut i) 0
                       (mut found) false]
                   (loop (if (>= (load i) nf)
                             (break)
                             (do
                               (when (= (load (field (elem fs
                                                           (load i))
                                                     name))
                                        ffld)
                                 (store! found true)
                                 (break))
                               (store! i (primitive/iadd (load i) 1)))))
                   (if (not (load found))
                       (err-ep (derr (sconcat a
                                              (sconcat a
                                                       (sconcat a
                                                                (sconcat4 a
                                                                          "in '"
                                                                          fname
                                                                          "': offsetof: struct '"
                                                                          (struct-name tp))
                                                                "' has no field '")
                                                       ffld)
                                              "'")))
                       (ok-ep (mk-expr (EOffsetOf ty ffld) elo ehi esrc ectxt)
                              (TInt 64 true))))))))))

(defn synth-fnptr [(a (dyn Allocator))
                   (name (slice u8))
                   (cx (ptr Cx))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (let [sig (sig-find cx name)]
    (cond (= (primitive/cast i64 sig) 0)
            (err-ep (derr (sconcat a
                                   (sconcat4 a
                                             "in '"
                                             fname
                                             "': fnptr-of unknown function '"
                                             name)
                                   (with-removed-hint a "'" (fn-unknown-hint a cx fname name)))))
          (> (len (load (field sig type_params))) 0)
            (err-ep (derr (sconcat a
                                   (sconcat4 a
                                             "in '"
                                             fname
                                             "': cannot take a function pointer to generic function '"
                                             name)
                                   "'")))
          (not (load (field sig fnptr_ok)))
            (err-ep (derr (sconcat a
                                   (sconcat4 a
                                             "in '"
                                             fname
                                             "': cannot take a function pointer to '"
                                             name)
                                   "' (shim-convention functions are not supported yet)")))
          :else
            (do
              ; an extern is the C function itself, which takes the value
              (when (and (= (load (field sig cc)) (c-convention))
                         (not (load (field sig is_extern)))
                         (fnptr-surface-needs-c-entry? cx (load (field sig fnptr_params))))
                (register-fnptr-c-entry! a cx name (load (field sig fnptr_params)) elo ehi esrc ectxt))
              (ok-ep (mk-expr (EFnPtrOf name) elo ehi esrc ectxt)
                     (TFn
                       :cc (CcResolved (load (field sig cc)))
                       :params (load (field sig fnptr_params))
                       :ret
                         (box-type a
                                   (load (field sig
                                                ret)))))))))

;;; Give `name` the by-value C entry its pointer needs (once): the pointer is
;;; then to that entry, which passes each struct or sum on to the function's
;;; reference-model body, as a lifted anonymous function's entry does.
(defn register-fnptr-c-entry! [(a (dyn Allocator))
                               (cx (ptr Cx))
                               (name (slice u8))
                               (params (ptr (ArrayList Type)))
                               (elo i64)
                               (ehi i64)
                               (esrc i64)
                               (ectxt i64)] (-> i64)
  (unless (block :seen
            (for [i 0 (len (field cx anon_c_entries))]
              (when (= (.name (elem (field cx anon_c_entries) i)) name)
                (break :seen true)))
            false)
    (push! (mut (field cx anon_c_entries))
           (ExportC :name name
                    :symbol (Some (sconcat a name ".c"))
                    :params params
                    :published false
                    :lo elo
                    :hi ehi
                    :source esrc
                    :ctxt ectxt)))
  0)

(defn synth-callptr [(a (dyn Allocator))
                     (fp (ptr Expr))
                     (args (ptr (ArrayList Expr)))
                     (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))
                     (elo i64)
                     (ehi i64)
                     (esrc i64)
                     (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [fsp (try! (do-synth a fp (null-type) env cx tps fname))
               sp (primitive/alloc-stack SynPair)]
           (store! sp fsp)
           (let [ft (load (field sp t))]
             (when (not (= (type-tag ft) 10))
               (break :try
                        (err-ep (derr (sconcat a
                                               (sconcat3 a
                                                         "in '"
                                                         fname
                                                         "': call-ptr expects a function pointer, got ")
                                               (ty-str a ft))))))
             (let [params (t-fn-params ft)
                   ret (t-fn-ret ft)]
               (when (not (= (len (load params)) (len (load args))))
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat a
                                                          (sconcat a
                                                                   (sconcat4 a
                                                                             "in '"
                                                                             fname
                                                                             "': function pointer expects "
                                                                             (i64->str a
                                                                                       (len (load params))))
                                                                   " args, got ")
                                                          (i64->str a
                                                                    (len (load args))))
                                                 "")))))
               (let [na
                       (try! (synth-callptr-args a params args env cx tps fname))]
                 (ok-ep (mk-expr (ECallPtr (load (field sp e)) na)
                                 elo
                                 ehi
                                 esrc
                                 ectxt)
                        (load ret)))))))))

;;; Is `name` a generic function?
(defn generic-sig? [(cx (ptr Cx)) (name (slice u8))] (-> bool)
  (let [sig (sig-find cx name)]
    (and (!= (primitive/cast i64 sig) 0)
         (> (len (load (field sig type_params))) 0))))

;;; `(fnptr-of f [T…])`: a pointer to the instance of the generic function `f`
;;; at the type arguments, written or, when none are, inferred from the function
;;; pointer type expected here. Type arguments may be the enclosing function's own
;;; type parameters; specialization instantiates `f` for each concrete set. The
;;; pointer's type is `f`'s, substituted: a parameter of type `T` takes the
;;; argument by value, as a `c` function pointer does, and as the instance does.
(defn synth-fnptr-inst [(a (dyn Allocator))
                        (name (slice u8))
                        (written (ptr (ArrayList Type)))
                        (expected (ptr Type))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))
                        (elo i64)
                        (ehi i64)
                        (esrc i64)
                        (ectxt i64)] (-> (Result EvalPair Diag))
  (try
    (let [sig (sig-find cx name)
          tparams (load (field sig type_params))
          targs (try! (explicit-type-args a cx written fname))
          subst (subst-new a)
          shown (display-ident name)]
      (unless (load (field sig fnptr_ok))
        (break :try (err-ep (derr-at-src esrc elo ehi
                                         (sconcat3 a "in '" fname
                                                   (sconcat3 a "': cannot take a function pointer to '" shown
                                                             "' (shim-convention functions are not supported yet)"))))))
      (if (> (len (load targs)) 0)
          (do
            (unless (= (len (load targs)) (len (load tparams)))
              (break :try (err-ep (derr-at-src esrc elo ehi
                                               (sconcat a
                                                        (sconcat3 a "in '" fname "': fnptr-of '")
                                                        (sconcat a
                                                                 (sconcat3 a shown "' expects "
                                                                           (i64->str a (len (load tparams))))
                                                                 (sconcat a " type arguments, got "
                                                                          (i64->str a (len (load targs))))))))))
            (try! (validate-targs a cx targs tps fname))
            (build-subst! subst tparams targs)
            0)
          ; No type arguments written: the pointer type expected here supplies them.
          (let [params (load (field sig fnptr_params))]
            (unless (and (expected-some? expected)
                         (and (= (type-tag expected) 10)
                              (= (len (load (t-fn-params expected))) (len (load params)))))
              (break :try (err-ep (derr-at-src esrc elo ehi
                                               (sconcat a
                                                        (sconcat3 a "in '" fname "': '")
                                                        (sconcat3 a shown "' is generic; write its type arguments, (fnptr-of "
                                                                  (sconcat a (after-last-dot name) " [T…]), or take it where a function pointer type is expected")))))))
            (for [i 0 (len (load params))]
              (try! (unify a (elem params i) (elem (t-fn-params expected) i)
                           tparams subst fname)))
            (try! (unify a (field sig ret) (t-fn-ret expected) tparams subst fname))
            (for [i 0 (len (load tparams))]
              (when (= (primitive/cast i64 (subst-get subst (get (load tparams) i))) 0)
                (break :try (err-ep (derr-at-src esrc elo ehi
                                                 (sconcat a
                                                          (sconcat3 a "in '" fname "': cannot infer type argument '")
                                                          (sconcat3 a (get (load tparams) i) "' of '"
                                                                    (sconcat3 a shown "'; write it: (fnptr-of " (sconcat a (after-last-dot name) " [T…])")))))))))
            0))
      (try! (ca-check-bounds a sig subst name (box-al [Expr] a (ArrayList::new [Expr] a)) cx fname elo ehi esrc ectxt))
      (let [targs (subst-targs a tparams subst)
            pointer (box-type a (TFn
                                  :cc (CcResolved (load (field sig cc)))
                                  :params (subst-apply-list a (load (field sig fnptr_params)) subst)
                                  :ret (box-type a (subst-apply a (field sig ret) subst))))]
        ; A `c` pointer passing by value a struct the instance takes by reference
        ; reaches it through a forwarder, as for a function that is not generic.
        (if (and (expected-some? expected) (fnptr-wants-by-value-c-entry? cx pointer expected))
            (fnptr-forwarder a name targs expected env cx tps fname elo ehi esrc ectxt)
            (ok-ep (mk-expr (EFnPtrInst name targs) elo ehi esrc ectxt) (load pointer)))))))

; Does a `c` function pointer that takes `t` by value need a by-value C entry
; to reach a Coil function? A struct or sum, generic or not, reaches a Coil
; function's body by reference -- an owner too: it is consumed at the call, but
; the callee still receives the place holding it -- while a `c` pointer passes it
; by value.
(defn by-value-c-entry-param? [(cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (let [a (.a cx)
        no-tps (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))]
    (and (or (= (type-tag t) 6)
             (or (= (type-tag t) 7)
                 (= (type-tag t) 11)))
         (= (type-tag (box-type a (param-body-ref-type cx t no-tps)))
            5))))

;;; Does a pointer to the function with this `fnptr` surface need a by-value C
;;; entry of its own? It does when the surface takes a struct or sum by value --
;;; an owner, which a call consumes -- that the body receives by reference.
(defn fnptr-surface-needs-c-entry? [(cx (ptr Cx)) (params (ptr (ArrayList Type)))] (-> bool)
  (let [(mut needed) false]
    (for [i 0 (len (load params))]
      (when (by-value-c-entry-param? cx (elem params i))
        (set! needed true)
        0))
    (load needed)))

; Does a `c` pointer of type `want` take by value a C struct that the function
; pointer `have` takes by reference, with every other part of the two the same?
(defn fnptr-wants-by-value-c-entry? [(cx (ptr Cx)) (have (ptr Type)) (want (ptr Type))] (-> bool)
  (if (not (and (= (type-tag have) 10)
                (and (= (type-tag want) 10)
                     (and (= (t-fn-cc have) (c-convention)) (= (t-fn-cc want) (c-convention))))))
      false
      (let [hp (t-fn-params have)
            wp (t-fn-params want)
            (mut by-value) false
            (mut same) (and (= (len (load hp)) (len (load wp)))
                            (type-eq (t-fn-ret have) (t-fn-ret want)))]
        (when (load same)
          (for [i 0 (len (load hp))]
            (let [h (elem hp i)
                  w (elem wp i)]
              (unless (type-eq h w)
                (match (load h)
                  (TRef [_ inner]
                        (if (and (by-value-c-entry-param? cx w) (type-eq inner w))
                            (do (set! by-value true) 0)
                            (do (set! same false) 0)))
                  (_ (do (set! same false) 0))))
              0)))
        (and (load same) (load by-value)))))

; `(fnptr-of f)` where the `c` pointer expected takes by value a C struct that
; `f` takes by reference. C passes it by value, so the pointer is to a lifted
; forwarder `(fn [p…] (f p…))`, which gets the by-value C entry an anonymous
; function has. Any other `fnptr-of` is the function's own pointer.
(defn synth-fnptr-expected [(a (dyn Allocator))
                            (name (slice u8))
                            (expected (ptr Type))
                            (env (ptr (ArrayList EnvEntry)))
                            (cx (ptr Cx))
                            (tps (ptr (ArrayList (slice u8))))
                            (fname (slice u8))
                            (elo i64)
                            (ehi i64)
                            (esrc i64)
                            (ectxt i64)] (-> (Result EvalPair Diag))
  (match (synth-fnptr a name cx fname elo ehi esrc ectxt)
    (Err [d] (err-ep d))
    (Ok [ep0]
        (let [ep (primitive/alloc-stack EvalPair)]
          (set! ep ep0)
          (if (and (expected-some? expected)
                   (fnptr-wants-by-value-c-entry? cx (field ep t) expected))
              (fnptr-forwarder a name (box-al [Type] a (ArrayList::new [Type] a)) expected env cx tps fname
                               elo ehi esrc ectxt)
              (Ok [EvalPair Diag] (load ep)))))))

;;; The pointer to `(fn [p…] (name [type-args] p…))` at the `c` pointer type
;;; `expected`: a lifted forwarder, whose by-value C entry takes by value the
;;; structs `name` takes by reference.
(defn fnptr-forwarder [(a (dyn Allocator))
                       (name (slice u8))
                       (type-args (ptr (ArrayList Type)))
                       (expected (ptr Type))
                       (env (ptr (ArrayList EnvEntry)))
                       (cx (ptr Cx))
                       (tps (ptr (ArrayList (slice u8))))
                       (fname (slice u8))
                       (elo i64)
                       (ehi i64)
                       (esrc i64)
                       (ectxt i64)] (-> (Result EvalPair Diag))
  (let [n (len (load (t-fn-params expected)))
        (mut names) (ArrayList::new [(slice u8)] a)
        (mut args) (ArrayList::new [Expr] a)
        (mut body) (ArrayList::new [Expr] a)]
    (for [i 0 n]
      (let [pn (sconcat a "forward$" (i64->str a i))]
        (push! (mut names) pn)
        (push! (mut args) (mk-expr (EVar pn) elo ehi esrc ectxt))))
    (push! (mut body)
           (mk-expr (ECall :func name
                           :type_args type-args
                           :args (box-al [Expr] a (load args)))
                    elo ehi esrc ectxt))
    (synth-anon-fn a
                   (box-al [(slice u8)] a (load names))
                   (box-al [Expr] a (load body))
                   (t-fn-params expected)
                   (t-fn-ret expected)
                   env
                   cx
                   tps
                   fname
                   elo
                   ehi
                   esrc
                   ectxt)))

; Check and lift a source anonymous function. `ret_expected` may be null when a
; higher-order generic determines only the argument types; in that case the tail
; expression determines the return type. The body receives a fresh environment
; containing only its parameters. `anon_outer_env` exists solely to turn an
; attempted reference to the caller's locals into the capture-specific error.
(defn synth-anon-fn [(a (dyn Allocator))
                     (names (ptr (ArrayList (slice u8))))
                     (body (ptr (ArrayList Expr)))
                     (param_types (ptr (ArrayList Type)))
                     (ret_expected (ptr Type))
                     (outer (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))
                     (elo i64)
                     (ehi i64)
                     (esrc i64)
                     (ectxt i64)] (-> (Result EvalPair Diag))
  (let [nn (len (load names))
        nt (len (load param_types))]
    (if (not (= nn nt))
        (err-ep (derr-at-src esrc
                             elo
                             ehi
                             (sconcat a
                                      (sconcat3 a
                                                "anonymous fn has "
                                                (i64->str a nn)
                                                " parameters but context expects ")
                                      (i64->str a nt))))
        (let [(mut ps) (ArrayList::new [Param] a)
              (mut checked_body) (ArrayList::new [Expr] a)
              ; Inside a generic function the body may use its type parameters, so
              ; the lifted function is generic over the same ones, with the same
              ; bounds, and the pointer is to its instance at them; specialization
              ; instantiates it with each instance of the enclosing function.
              generic (> (len (load tps)) 0)
              own_tps (if generic
                          (box-al [(slice u8)] a (load tps))
                          (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)))
              own_bounds (if generic
                             (box-al [Bound] a (load (field cx cur_bounds)))
                             (box-al [Bound] a (ArrayList::new [Bound] a)))
              (mut i) 0
              (mut failed) false
              (mut err) (primitive/zeroed Diag)
              (mut result_ty) (primitive/zeroed Type)]
          (loop (if (>= (load i) nn)
                    (break)
                    (let [pp (primitive/alloc-stack Param)]
                      (set! (.name pp) (get (load names) (load i)))
                      (set! (.positional_only pp) true)
                      (set! (.ty pp)
                            (load (elem param_types (load i))))
                      (set! (.bid pp) 0)
                      (set! (.owned_type pp) (primitive/cast (ptr Type) 0))
                      (push! (mut ps) (load pp))
                      (set! i (primitive/iadd (load i) 1)))))
          (let [psp (box-al [Param] a (load ps))
                local (build-param-env a cx psp own_tps)
                old_outer (load (field cx anon_outer_env))
                bn (len (load body))
                ; the body runs at run time, even when the function is a
                ; constant's value: its spills are per-call, not static
                saved_const_depth (.const_value_depth (ast-unit-state))]
            (set! (.const_value_depth (ast-unit-state)) 0)
            (store! (field cx anon_outer_env) outer)
            (set! i 0)
            (loop (if (or (load failed) (>= (load i) bn))
                      (break)
                      (let [src_expr (elem body (load i))
                            tail (= (primitive/iadd (load i) 1) bn)
                            want
                              (if (and tail
                                       (!= (primitive/cast i64 ret_expected)
                                           0))
                                  ret_expected
                                  (null-type))]
                        (match (do-synth a src_expr want local cx tps fname)
                          (Err [d] (do (set! err d) (set! failed true)))
                          (Ok [sp0]
                              (let [sp (primitive/alloc-stack SynPair)]
                                (set! sp sp0)
                                (if tail
                                    (if (= (primitive/cast i64 ret_expected)
                                           0)
                                        (do
                                          (set! result_ty
                                                (load (load (field sp t))))
                                          (push! (mut checked_body)
                                                 (load (load (field sp e)))))
                                        (match (coerce a
                                                       (load (load (field sp e)))
                                                       (load (field sp t))
                                                       ret_expected
                                                       false
                                                       fname
                                                       "anonymous fn body")
                                          (Err [d]
                                               (do
                                                 (set! err d)
                                                 (set! failed true)))
                                          (Ok [ce]
                                              (do
                                                (set! result_ty
                                                      (load ret_expected))
                                                (push! (mut checked_body) ce)))))
                                    (push! (mut checked_body)
                                           (load (load (field sp e))))))))
                        (set! i (primitive/iadd (load i) 1)))))
            (store! (field cx anon_outer_env) old_outer)
            (set! (.const_value_depth (ast-unit-state)) saved_const_depth)
            (if (load failed)
                (err-ep (load err))
                (let [counter (load (field cx anon_counter))
                      generated (sconcat a "$anon$" (i64->str a counter))
                      fp (primitive/alloc-stack Func)
                      (mut fnparams) (ArrayList::new [Type] a)]
                  (store! (field cx anon_counter) (primitive/iadd counter 1))
                  (set! (.name fp) generated)
                  (set! (.type_params fp) own_tps)
                  (set! (.bounds fp) own_bounds)
                  (set! (.cc fp) (cc-c))
                  (set! (.annotations fp)
                        (box-al [Annotation] a (ArrayList::new [Annotation] a)))
                  (set! (.params fp) (erase-param-types a cx psp local own_tps))
                  (set! (.ret fp) (erase-refs a (box-type a (load result_ty))))
                  (set! (.body fp) (box-al [Expr] a (load checked_body)))
                  (set! (.macro_variadic fp) false)
                  (set! (.lo fp) elo)
                  (set! (.hi fp) ehi)
                  (set! (.source fp) esrc)
                  (set! (.ctxt fp) ectxt)
                  (set! (.declared fp) false)
                  (set! (.lazy fp) (primitive/cast (ptr i8) 0))
                  (match (if (load (field cx validate_anon_ownership))
                             (ownership-check-func a cx fp)
                             (Ok [i64 Diag] 0))
                    (Err [d] (err-ep d))
                    (Ok [_]
                        (do
                          (push! (mut (field cx anon_funcs)) (load fp))
                          ; The pointer's surface is the one a named function's
                          ; `fnptr-of` has: an aggregate parameter is `(ref T)`.
                          ; A `c` pointer that takes a C struct by value instead
                          ; reaches the function through a by-value C entry that
                          ; marshals the C ABI into the reference-model body. A
                          ; generic one's entry records that surface for its
                          ; instances: each instance a pointer reaches gets an entry
                          ; of its own in specialization (mono `instance-c-entry!`).
                          (let [(mut c-entry) false]
                            (for [pi 0 nn]
                              (let [t (elem param_types pi)
                                    surface (param-ref-type cx t own_tps)]
                                (if (or generic (by-value-c-entry-param? cx t))
                                    (do (when (by-value-c-entry-param? cx t) (set! c-entry true) 0)
                                        (push! (mut fnparams) (load t)))
                                    (push! (mut fnparams) surface))))
                            (when (load c-entry)
                              (let [ec (primitive/alloc-stack ExportC)]
                                (store! (field ec name) generated)
                                (store! (field ec symbol)
                                        (Some [(slice u8)] (sconcat a generated ".c")))
                                (store! (field ec params) (box-al [Type] a (load fnparams)))
                                (store! (field ec published) false)
                                (store! (field ec lo) elo)
                                (store! (field ec hi) ehi)
                                (store! (field ec source) esrc)
                                (store! (field ec ctxt) ectxt)
                                (push! (mut (field cx anon_c_entries)) (load ec))))
                            0)
                          ; The lifted function is a function of the program, so
                          ; its pointer is one `fnptr-of` can name again: a
                          ; constant holding it elaborates each use to one.
                          (let [sg (primitive/alloc-stack Sig)
                                (mut pnames) (ArrayList::new [(slice u8)] a)
                                (mut surface) (ArrayList::new [Type] a)]
                            (for [pi 0 nn]
                              (push! (mut pnames) "")
                              (push! (mut surface)
                                     (param-ref-type cx (elem param_types pi) own_tps)))
                            (set! (.name sg) generated)
                            (set! (.type_params sg) own_tps)
                            (set! (.bounds sg) own_bounds)
                            (set! (.param_names sg) (box-al [(slice u8)] a (load pnames)))
                            (set! (.params sg) (box-al [Type] a (load surface)))
                            (set! (.fnptr_params sg) (box-al [Type] a (load fnparams)))
                            (set! (.ret sg) (load result_ty))
                            (set! (.is_extern sg) false)
                            (set! (.variadic sg) false)
                            (set! (.cc sg) (c-convention))
                            (set! (.fnptr_ok sg) true)
                            (push! (mut (.sigs cx)) (load sg))
                            (sig-index-put! cx generated)
                            (set! (mut (.new_sig_names cx)) generated 0))
                          (ok-ep (mk-expr (if generic
                                              (let [(mut targs) (ArrayList::new [Type] a)]
                                                (for [ti 0 (len (load own_tps))]
                                                  (push! (mut targs) (TStruct (get (load own_tps) ti))))
                                                (EFnPtrInst generated (box-al [Type] a (load targs))))
                                              (EFnPtrOf generated))
                                          elo
                                          ehi
                                          esrc
                                          ectxt)
                                 (TFn
                                   :cc (cc-c)
                                   :params (box-al [Type] a (load fnparams))
                                   :ret (box-type a (load (field fp ret)))))))))))))))

(defn synth-anon-fn-syn [(a (dyn Allocator))
                         (names (ptr (ArrayList (slice u8))))
                         (body (ptr (ArrayList Expr)))
                         (param_types (ptr (ArrayList Type)))
                         (ret_expected (ptr Type))
                         (outer (ptr (ArrayList EnvEntry)))
                         (cx (ptr Cx))
                         (tps (ptr (ArrayList (slice u8))))
                         (fname (slice u8))
                         (elo i64)
                         (ehi i64)
                         (esrc i64)
                         (ectxt i64)] (-> (Result SynPair Diag))
  (match (synth-anon-fn a
                        names
                        body
                        param_types
                        ret_expected
                        outer
                        cx
                        tps
                        fname
                        elo
                        ehi
                        esrc
                        ectxt)
    (Err [d] (Err [SynPair Diag] d))
    (Ok [ep0]
        (let [ep (primitive/alloc-stack EvalPair)]
          (set! ep ep0)
          (Ok [SynPair Diag]
              (mk-synpair a
                          (box-expr a (load (field ep e)))
                          (box-type a (load (field ep t)))))))))

; ============================ synth_inner =================
(defn synth-inner [(a (dyn Allocator))
                   (e (ptr Expr))
                   (expected (ptr Type))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))] (-> (Result EvalPair Diag))
  (let [elo (.lo e)
        ehi (.hi e)
        esrc (.source e)
        ectxt (.ctxt e)]
    (match (.kind e)
      (EInt [v] (ok-ep (mk-expr (EInt v) elo ehi esrc ectxt) (TInt 64 true)))
      (EWideInt [neg lo hi radix text]
                (synth-wide-int a neg lo hi radix text expected fname elo ehi esrc ectxt))
      (EFloat [bits]
              (ok-ep (mk-expr (EFloat bits) elo ehi esrc ectxt) (TFloat 64)))
      (EBool [b] (ok-ep (mk-expr (EBool b) elo ehi esrc ectxt) (TBool)))
      (EStr [s]
            (ok-ep (mk-expr (EStr s) elo ehi esrc ectxt)
                   (TSlice (box-type a (TInt 8 false)))))
      (ECStr [s]
             (ok-ep (mk-expr (ECStr s) elo ehi esrc ectxt)
                    (TPtr (box-type a (TInt 8 true)))))
      (EArrayLit [items]
                 (synth-array-literal a
                                      items
                                      expected
                                      env
                                      cx
                                      tps
                                      fname
                                      elo
                                      ehi
                                      esrc
                                      ectxt))
      (EStaticArray [indices items]
                    (if (not (expected-some? expected))
                        (err-ep (derr "static :elements requires an array allocation"))
                        (match (load expected)
                          (TArray [elem-ty extent]
                                  (try (let [(mut checked) (ArrayList::new [Expr] a)
                                             (mut prior) -1
                                             count (match extent
                                                     (FixedExtent [n] n)
                                                     (ParamExtent [name]
                                                       (break :try
                                                                (err-ep (derr (sconcat3 a "static :elements requires an array of literal length, not length '" name "'"))))))]
                                         (unless (= (len (load indices))
                                                    (len (load items)))
                                           (break :try
                                                    (err-ep (derr "static :elements index/value count mismatch")))
                                           0)
                                         (for [i 0 (len (load items))]
                                           (let [index (get (load indices) i)]
                                             (when (or (< index 0)
                                                       (>= index count))
                                               (break :try
                                                        (err-ep (derr "static :elements index is out of bounds")))
                                               0)
                                             (when (<= index (load prior))
                                               (break :try
                                                        (err-ep (derr "static :elements indices must be unique and increasing")))
                                               0)
                                             (set! prior index)
                                             (push! (mut checked)
                                                    (try! (check-to a
                                                                    (elem items
                                                                                     i)
                                                                    elem-ty
                                                                    env
                                                                    cx
                                                                    tps
                                                                    fname
                                                                    "static element"))))
                                           0)
                                         (ok-ep (mk-expr (EStaticArray indices
                                                                       (box-al [Expr]
                                                                               a
                                                                               (load checked)))
                                                         elo
                                                         ehi
                                                         esrc
                                                         ectxt)
                                                (load expected)))))
                          (_ (err-ep (derr "static :elements requires an array allocation"))))))
      (EAnonFn [params body]
               (if (and (expected-some? expected)
                        (= (type-tag expected) 10)
                        ; parameter types are what a lambda cannot supply itself
                        (not (block :hole
                               (for [i 0 (len (load (t-fn-params expected)))]
                                 (when (type-has-hole? (elem (t-fn-params expected) i))
                                   (break :hole true)))
                               false)))
                   (synth-anon-fn a
                                  params
                                  body
                                  (t-fn-params expected)
                                  ; a result type inference has not determined comes
                                  ; from the body
                                  (if (type-has-hole? (t-fn-ret expected))
                                      (null-type)
                                      (t-fn-ret expected))
                                  env
                                  cx
                                  tps
                                  fname
                                  elo
                                  ehi
                                  esrc
                                  ectxt)
                   (err-ep (derr-at-src esrc
                                        elo
                                        ehi
                                        "cannot infer anonymous fn parameter types from this context; pass it to a function-pointer or Callable parameter, or add a type ascription"))))
      (EMakeSlice [data elem len]
                  (match (do-synth a data (null-type) env cx tps fname)
                    (Err [d] (err-ep d))
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)]
                          (set! sp sp0)
                          ; The data is an address: a raw pointer, or — when an array
                          ; place borrowed as a slice is checked again, as a struct
                          ; constructor's arguments are — the reference its index
                          ; synthesizes to.
                          (if (or (type-is-ptr (load (field sp t)))
                                  (= (type-tag (load (field sp t))) 5))
                              (ok-ep (mk-expr (EMakeSlice
                                                :data (load (field sp e))
                                                :elem elem
                                                :len len)
                                              elo
                                              ehi
                                              esrc
                                              ectxt)
                                     (TSlice (box-type a elem)))
                              (err-ep (derr-at-src esrc elo ehi
                                                   (sconcat a "internal: make-slice data is not an address: "
                                                            (ty-str a (load (field sp t)))))))))))
      (EZeroed [ty]
               (let [tp (box-type a ty)]
                 (match (validate-type tp cx tps)
                   (Err [d]
                        (err-ep (prefix-diag a
                                             d
                                             (sconcat3 a
                                                       "in '"
                                                       fname
                                                       "': zeroed: "))))
                   (Ok [_] (ok-ep (mk-expr (EZeroed ty) elo ehi esrc ectxt) ty)))))
      (ERecordInit [ty]
               (let [tp (box-type a ty)]
                 (match (validate-type tp cx tps)
                   (Err [d]
                        (err-ep (prefix-diag a
                                             d
                                             (sconcat3 a
                                                       "in '"
                                                       fname
                                                       "': zeroed: "))))
                   (Ok [_] (ok-ep (mk-expr (ERecordInit ty) elo ehi esrc ectxt) ty)))))
      (EBorrow [mutable place]
               ; `(mut (.name x))` on a type with no field `name` borrows whatever
               ; place the type hands back.
               (let [ft (primitive/alloc-stack FieldTarget)
                     found (primitive/alloc-stack FieldImpl)
                     (mut selfty) (null-type)]
                 (store! ft (field-target-of a place env cx tps fname))
                 (store! found (field-impl-none))
                 (when (load (field ft ok))
                   (set! selfty
                         (box-type a
                                   (field-marker-type a
                                                      (load (field ft ty))
                                                      (load (field ft ffld)))))
                   (store! found (field-impl-find a cx (load selfty) "field-place" tps))
                   0)
                 (if (field-impl-found? found)
                     (synth-field-trait-call a cx found "field-place" (load selfty)
                                             (load (field ft target))
                                             (no-extra-args a)
                                             (load (field ft ffld))
                                             (null-type) env tps fname
                                             elo ehi esrc ectxt)
               (match (do-synth a place (null-type) env cx tps fname)
                 (Err [d] (err-ep d))
                 (Ok [sp0]
                     (let [sp (primitive/alloc-stack SynPair)]
                       (set! sp sp0)
                       (let [pt (load (field sp t))
                             pointee (place-pointee pt)]
                         (if (= (primitive/cast i64 pointee)
                                0)
                             (err-ep (derr (sconcat a
                                                    (sconcat3 a
                                                              "in '"
                                                              fname
                                                              "': cannot borrow a non-place of type ")
                                                    (ty-str a pt))))
                             (if (and mutable (not (is-writable pt)))
                                 (err-ep (derr (sconcat a
                                                        (sconcat a
                                                                 (sconcat4 a
                                                                           "in '"
                                                                           fname
                                                                           "': cannot take a mutable borrow of immutable '"
                                                                           (ty-str a
                                                                                   pt))
                                                                 "'")
                                                        "")))
                                 ; The checked tree keeps the borrow: a checked
                                 ; call checked again (a struct constructor's
                                 ; arguments are) still passes `(mut …)`.
                                 (ok-ep (mk-expr (EBorrow mutable (load (field sp e)))
                                                 elo ehi esrc ectxt)
                                        (TRef mutable
                                              (box-type a (load pointee)))))))))))))
      (EVar [name]
            (let [te (env-get env name)]
              (if (!= (primitive/cast i64 te) 0)
                  (ok-ep (mk-expr (EVar name) elo ehi esrc ectxt) (load te))
                  ; A local shadows a value parameter; a value parameter shadows
                  ; module constants and globals.
                  (match (scope-value-type cx tps name)
                    (Some [vt]
                      (if (> (.comptime_depth cx) 0)
                          (err-ep (derr (sconcat a
                                                 (sconcat4 a "in '" fname "': value parameter '" (display-ident name))
                                                 "' is not known inside comptime: comptime evaluates the generic definition once, before specialization")))
                          (ok-ep (mk-expr (EConstParam name vt) elo ehi esrc ectxt) vt)))
                    (None []
                  (let [outer (load (field cx anon_outer_env))]
                    (if (and (!= (primitive/cast i64 outer)
                                 0)
                             (!= (primitive/cast i64 (env-get outer name))
                                 0))
                        (err-ep (derr-at-src esrc
                                             elo
                                             ehi
                                             (sconcat a
                                                      (sconcat4 a
                                                                "anonymous fn cannot capture local '"
                                                                (display-ident name)
                                                                "' from enclosing function '"
                                                                fname)
                                                      "'; pass it as an explicit parameter or use coil.closure/defclosure")))
                        (let [ce (const-find cx name)]
                          (if (!= (primitive/cast i64 ce)
                                  0)
                              ; Runtime-ness belongs to the persistent entry.
                              ; The overlay-only name list is intentionally empty
                              ; after publication and cannot classify base hits.
                              (if (.runtime ce)
                                  (let [static (mk-expr (EStaticRef name) elo ehi esrc ectxt)
                                        vt (box-type a (.ty ce))]
                                    ; A struct or array def is an immutable place,
                                    ; as a local of that type is: indexing it,
                                    ; reading a field or borrowing it as a slice
                                    ; addresses the static itself. Read as a value
                                    ; it would be copied to the stack at every use,
                                    ; and a slice of that copy dangles once the
                                    ; frame that holds it returns.
                                    (if (is-place-value-type vt cx)
                                        (ok-ep static (TRef false vt))
                                        (ok-ep (mk-expr (ELoad (box-expr a static))
                                                        elo
                                                        ehi
                                                        esrc
                                                        ectxt)
                                               (load vt))))
                                  (if (or (is-literal-value (field ce value))
                                          ; A function pointer is a link-time
                                          ; constant: each use is the pointer.
                                          (match (.kind (.value ce))
                                            (EFnPtrOf [_] true)
                                            (EFnPtrInst [_ _] true)
                                            (_ false)))
                                      (let [lit
                                              (mk-expr (.kind (.value ce))
                                                       elo
                                                       ehi
                                                       esrc
                                                       ectxt)]
                                        (ok-ep (const-use-preserve-type a lit (.ty ce)
                                                                        elo ehi esrc ectxt)
                                               (.ty ce)))
                                      ; The fold rewrites the nodes of the expression it
                                      ; evaluates in place. The constant's value belongs to
                                      ; the constant, which a later submission may share, so
                                      ; each use folds a copy.
                                      (let [folded
                                              (mk-expr (EComptime (semantic-clone-expr-ptr a (field ce value)))
                                                       elo
                                                       ehi
                                                       esrc
                                                       ectxt)]
                                        (ok-ep (const-use-preserve-type a folded (.ty ce)
                                                                        elo ehi esrc ectxt)
                                               (.ty ce)))))
                              (if (unscoped-datum-ident? name)
                                  (err-ep (derr (sconcat a
                                                         (sconcat4 a
                                                                   "in '"
                                                                   fname
                                                                   "': unscoped generated identifier '"
                                                                   (display-ident name))
                                                         "'; use fresh-identifier or an explicit datum->syntax/syntax->datum operation")))
                                  (if (looks-numeric name)
                                      ; The reader makes a SYMBOL of anything that
                                      ; starts like a number and does not parse as
                                      ; one — an out-of-range literal, a misplaced
                                      ; `_`, `1e400`. "Unbound variable" named the
                                      ; symbol and hid the problem with the number.
                                      (err-ep (derr (sconcat a
                                                             (sconcat4 a
                                                                       "in '"
                                                                       fname
                                                                       "': malformed or out-of-range number literal '"
                                                                       (display-ident name))
                                                             "'")))
                                      (err-ep (derr (sconcat a
                                                             (sconcat4 a
                                                                       "in '"
                                                                       fname
                                                                       "': unbound variable '"
                                                                       (display-ident name))
                                                             (with-removed-hint a
                                                                                "'"
                                                                                (fn-unknown-hint a
                                                                                                 cx
                                                                                                 fname
                                                                                                 (display-ident name)))))))))))))))))
      (EVector [op result _ args]
        (synth-vector a op result args env cx tps fname elo ehi esrc ectxt))
      (EConstParam [name ty]
        (ok-ep (mk-expr (EConstParam name ty) elo ehi esrc ectxt) ty))
      (ELlvmIr [result args body]
               (let [rp (box-type a result)]
                 (match (validate-type rp cx tps)
                   (Err [d]
                        (err-ep (prefix-diag a
                                             d
                                             (sconcat3 a
                                                       "in '"
                                                       fname
                                                       "': llvm-ir result type: "))))
                   (Ok [_]
                       (match (synth-discard-args a
                                                  args
                                                  true
                                                  (sconcat3 a
                                                            "in '"
                                                            fname
                                                            "': llvm-ir operand uses a void value (a (-> void) call yields nothing)")
                                                  env
                                                  cx
                                                  tps
                                                  fname)
                         (Err [d] (err-ep d))
                         (Ok [eargs]
                             (ok-ep (mk-expr (ELlvmIr
                                               :result result
                                               :args eargs
                                               :body body)
                                             elo
                                             ehi
                                             esrc
                                             ectxt)
                                    result)))))))
      (EIntrinsic [op result args]
                  (let [rp (box-type a result)]
                    (match op
                      (IMachineCodeSource [_]
                                          (err-ep (derr-at-src esrc
                                                               elo
                                                               ehi
                                                               (sconcat3 a
                                                                         "in '"
                                                                         fname
                                                                         "': machine-code must be the entire body of a defn"))))
                      (_ (match (validate-type rp cx tps)
                           (Err [d] (err-ep d))
                           (Ok [_]
                               (match (match op
                                        (IStackBytes [] (synth-stack-bytes-args a args rp env cx tps fname))
                                        (_ (synth-discard-args a
                                                               args
                                                               true
                                                               (sconcat3 a
                                                                         "in '"
                                                                         fname
                                                                         "': a primitive's operand uses a void value (a (-> void) call yields nothing)")
                                                               env
                                                               cx
                                                               tps
                                                               fname)))
                                 (Err [d] (err-ep d))
                                 (Ok [eargs]
                                     (ok-ep (mk-expr (EIntrinsic :op op :result result :args eargs)
                                                     elo
                                                     ehi
                                                     esrc
                                                     ectxt)
                                            result)))))))))
      (ETraitCall [trait_name method self_tp args]
                  ; A Func can appear both in the program's impl table and in the
                  ; flattened function worklist. The first synthesis turns a
                  ; bound call into ETraitCall; a later authoritative synthesis
                  ; of that same internal node must be idempotent. Source syntax
                  ; and transforms cannot manufacture this AST variant.
                  (let [td (trait-find cx trait_name)]
                    (if (= (primitive/cast i64 td) 0)
                        (err-ep (derr (sconcat3 a
                                                "internal: unresolved trait '"
                                                trait_name
                                                "' in deferred call")))
                        (let [tm (trait-method-find td method)]
                          (if (= (primitive/cast i64 tm) 0)
                              (err-ep (derr (sconcat3 a
                                                      "internal: unresolved trait method '"
                                                      method
                                                      "' in deferred call")))
                              (let [bt
                                      (bound-trait-find (field cx cur_bounds)
                                                        self_tp
                                                        trait_name)]
                                (if (= (primitive/cast i64 bt)
                                       0)
                                    (err-ep (derr (sconcat a
                                                           (sconcat3 a
                                                                     "internal: deferred trait call lost bound '"
                                                                     self_tp
                                                                     " as ")
                                                           (sconcat a
                                                                    (display-name trait_name)
                                                                    "'"))))
                                    (let [subst
                                            (build-trait-subst a
                                                               (.self_param td)
                                                               self_tp
                                                               trait_name
                                                               td
                                                               (load (field bt
                                                                            args)))
                                          ret
                                            (subst-apply a (field tm ret) subst)]
                                      (ok-ep (load e) ret)))))))))
      (ECleanup [_ _]
                (err-ep (derr "internal: cleanup region appeared before ownership elaboration")))
      (EComptime [inner]
                 (match (do
                          (set! (.comptime_depth cx) (+ (.comptime_depth cx) 1))
                          (let [r (do-synth a inner expected env cx tps fname)]
                            (set! (.comptime_depth cx) (- (.comptime_depth cx) 1))
                            r))
                   (Err [d] (err-ep d))
                   (Ok [sp0]
                       ; A constructor synthesizes to the place it builds, but
                       ; the compile-time result is that place's value.
                       (let [value (place-as-value a sp0)]
                         (ok-ep (mk-expr (EComptime (box-expr a (.e value)))
                                         elo
                                         ehi
                                         esrc
                                         ectxt)
                                (.t value))))))
      ; Type ascription `(: value type)`: check `inner` against `ty` (so a stranded type
      ; arg can be supplied and any legal coercion applies), then LOWER it away — the
      ; result is the coerced inner value at `ty`, so no EAscribe node reaches mono/codegen.
      (EPattern [op ty inner index]
                (synth-pattern a
                               op
                               ty
                               inner
                               index
                               env
                               cx
                               tps
                               fname
                               elo
                               ehi
                               esrc
                               ectxt))
      (EAscribe [ty inner]
                (let [tp (box-type a ty)]
                  (match (validate-type tp cx tps)
                    (Err [d]
                         (err-ep (prefix-diag a
                                              d
                                              (sconcat3 a
                                                        "in '"
                                                        fname
                                                        "': type ascription: "))))
                    (Ok [_]
                        (match (check-to a
                                         inner
                                         tp
                                         env
                                         cx
                                         tps
                                         fname
                                         "ascribed value")
                          (Err [d] (err-ep d))
                          (Ok [ce] (ok-ep ce (load tp))))))))
      (EStaticRef [name]
                  (let [ce (const-find cx name)]
                    (if (or (= (primitive/cast i64 ce) 0)
                            (not (.runtime ce)))
                        (err-ep (derr (sconcat a
                                               (sconcat4 a
                                                         "in '"
                                                         fname
                                                         "': internal: unknown runtime def '"
                                                         name)
                                               "'")))
                        (ok-ep (load e) (TPtr (box-type a (.ty ce)))))))
      (ETypeQuery [q ty]
                  (let [tp (box-type a ty)]
                    (match (validate-type tp cx tps)
                      (Err [d]
                           (err-ep (prefix-diag a
                                                d
                                                (sconcat3 a
                                                          "in '"
                                                          fname
                                                          "': type reflection: "))))
                      (Ok [_]
                          (ok-ep (mk-expr (ETypeQuery q ty) elo ehi esrc ectxt)
                                 (if (<= q 1)
                                     (TInt 64 true)
                                     (TBool)))))))
      (EFieldMeta [meta ty idx]
                  (let [tp (box-type a ty)]
                    (match (validate-type tp cx tps)
                      (Err [d]
                           (err-ep (prefix-diag a
                                                d
                                                (sconcat3 a
                                                          "in '"
                                                          fname
                                                          "': field reflection: "))))
                      (Ok [_]
                          (match (do-synth a
                                           idx
                                           (box-type a (TInt 64 true))
                                           env
                                           cx
                                           tps
                                           fname)
                            (Err [d] (err-ep d))
                            (Ok [sp0]
                                (let [sp (primitive/alloc-stack SynPair)]
                                  (set! sp sp0)
                                  (if (not (type-is-int (load (field sp t))))
                                      (err-ep (derr (sconcat a
                                                             (sconcat3 a
                                                                       "in '"
                                                                       fname
                                                                       "': field index must be an integer, got ")
                                                             (ty-str a
                                                                     (load (field sp
                                                                                  t))))))
                                      (ok-ep (mk-expr (EFieldMeta
                                                        :meta meta
                                                        :ty ty
                                                        :idx (load (field sp e)))
                                                      elo
                                                      ehi
                                                      esrc
                                                      ectxt)
                                             (if (= meta 1)
                                                 (TInt 64 true)
                                                 (TSlice (box-type a
                                                                   (TInt 8
                                                                         false)))))))))))))
      (EQuote [form] (ok-ep (mk-expr (EQuote form) elo ehi esrc ectxt) (TCode)))
      (EQuasi [q]
              (let [qp (primitive/alloc-stack Quasi)]
                (set! qp q)
                (match (check-quasi a qp env cx tps fname)
                  (Err [d] (err-ep d))
                  (Ok [nq]
                      (ok-ep (mk-expr (EQuasi nq) elo ehi esrc ectxt) (TCode))))))
      (ECodeOp [op args]
               (match (synth-codeop-args a op args env cx tps fname)
                 (Err [d] (err-ep d))
                 (Ok [na]
                     (match (codeop-answer-problem a cx op)
                       (Some [msg] (err-ep (derr-at-src esrc elo ehi msg)))
                       (None []
                             (ok-ep (mk-expr (ECodeOp op na) elo ehi esrc ectxt)
                                    (codeop-rty op)))))))
      (EFieldIndex [ty name]
                   (let [tp (box-type a ty)]
                     (match (validate-type tp cx tps)
                       (Err [d]
                            (err-ep (prefix-diag a
                                                 d
                                                 (sconcat3 a
                                                           "in '"
                                                           fname
                                                           "': field-index: "))))
                       (Ok [_]
                           (match (do-synth a name (null-type) env cx tps fname)
                             (Err [d] (err-ep d))
                             (Ok [sp0]
                                 (let [sp (primitive/alloc-stack SynPair)]
                                   (set! sp sp0)
                                   (if (not (= (type-tag (load (field sp t)))
                                               8))
                                       (err-ep (derr (sconcat a
                                                              (sconcat3 a
                                                                        "in '"
                                                                        fname
                                                                        "': field-index name must be a string, got ")
                                                              (ty-str a
                                                                      (load (field sp
                                                                                   t))))))
                                       (ok-ep (mk-expr (EFieldIndex ty
                                                                    (load (field sp
                                                                                 e)))
                                                       elo
                                                       ehi
                                                       esrc
                                                       ectxt)
                                              (TInt 64 true))))))))))
      (EBin [op lhs rhs]
            (synth-binop a op lhs rhs false env cx tps fname elo ehi esrc ectxt))
      (EIntUnary [op inner]
                 (match (do-synth a inner (null-type) env cx tps fname)
                   (Err [d] (err-ep d))
                   (Ok [sp0]
                       (let [sp (primitive/alloc-stack SynPair)]
                         (set! sp sp0)
                         (if (not (numeric (load (field sp t)) tps))
                             (err-ep (derr (sconcat a
                                                    (sconcat3 a
                                                              "in '"
                                                              fname
                                                              "': integer unary operation requires an integer, got ")
                                                    (ty-str a
                                                            (load (field sp t))))))
                             (if (type-is-float (load (field sp t)))
                                 (err-ep (derr (sconcat a
                                                        (sconcat3 a
                                                                  "in '"
                                                                  fname
                                                                  "': integer unary operation requires an integer, got ")
                                                        (ty-str a
                                                                (load (field sp
                                                                             t))))))
                                 (match (load (load (field sp t)))
                                   (TInt [bits _]
                                         (if (and (= op 4)
                                                  (and (!= bits
                                                           8)
                                                       (!= (primitive/urem bits
                                                                           16)
                                                           0)))
                                             (err-ep (derr "bswap requires u8/i8 or an integer width divisible by 16"))
                                             (ok-ep (mk-expr (EIntUnary op
                                                                        (load (field sp
                                                                                     e)))
                                                             elo
                                                             ehi
                                                             esrc
                                                             ectxt)
                                                    (load (load (field sp t))))))
                                   (_ (ok-ep (mk-expr (EIntUnary op
                                                                 (load (field sp
                                                                              e)))
                                                      elo
                                                      ehi
                                                      esrc
                                                      ectxt)
                                             (load (load (field sp t))))))))))))
      (ECmp [op lhs rhs]
            (synth-binop a op lhs rhs true env cx tps fname elo ehi esrc ectxt))
      (ELoop [label body]
             (synth-loop a
                         label
                         body
                         expected
                         env
                         cx
                         tps
                         fname
                         elo
                         ehi
                         esrc
                         ectxt))
      (EBreak [label value]
              (synth-break a label value env cx tps fname elo ehi esrc ectxt))
      (EContinue [label] (synth-continue a label cx fname elo ehi esrc ectxt))
      (EIf [cnd thn els]
           (synth-if a cnd thn els expected env cx tps fname elo ehi esrc ectxt))
      (EDo [body]
           (synth-do a body expected env cx tps fname elo ehi esrc ectxt))
      (EDefer [cleanup body]
              (synth-defer a cleanup body expected env cx tps fname elo ehi esrc ectxt))
      (EBracketCall [_ _ _ _]
                    (err-ep (derr "internal: a bracket call reached the checker before resolution chose its reading")))
      (ELet [binds body]
            (synth-let a
                       binds
                       body
                       expected
                       env
                       cx
                       tps
                       fname
                       elo
                       ehi
                       esrc
                       ectxt))
      (ECall [func type_args args]
             (synth-call a
                         func
                         (.node-id e)
                         type_args
                         args
                         expected
                         env
                         cx
                         tps
                         fname
                         elo
                         ehi
                         esrc
                         ectxt))
      (ENamedCall [func type_args names args]
                  ; Keywords that label nothing are Keyword arguments. If that
                  ; positional reading does not check either, the author more likely
                  ; misspelled a parameter, so the named-call diagnostic is reported.
                  (match (if (keyword-arguments-call? a cx env func names)
                             (synth-call a
                                         func
                                         (.node-id e)
                                         type_args
                                         (keyword-positional-args a names args elo ehi esrc ectxt)
                                         expected
                                         env
                                         cx
                                         tps
                                         fname
                                         elo
                                         ehi
                                         esrc
                                         ectxt)
                             (err-ep (derr "")))
                    (Ok [ep] (Ok [EvalPair Diag] ep))
                    (Err [_]
                      (synth-named-call a
                                        func
                                        type_args
                                        names
                                        args
                                        expected
                                        env
                                        cx
                                        tps
                                        fname
                                        elo
                                        ehi
                                        esrc
                                        ectxt))))
      (EAlloc [storage ty init symbol]
              (let [tp (box-type a ty)]
                (match (validate-type tp cx tps)
                  (Err [d]
                       (err-ep (prefix-diag a
                                            d
                                            (sconcat3 a
                                                      "in '"
                                                      fname
                                                      "': alloc: "))))
                  (Ok [_]
                      (if (= (primitive/cast i64 init) 0)
                          (ok-ep (mk-expr (EAlloc
                                            :symbol symbol
                                            :storage storage
                                            :ty ty
                                            :init init)
                                          elo
                                          ehi
                                          esrc
                                          ectxt)
                                 (TPtr (box-type a ty)))
                          (match (check-to a
                                           init
                                           tp
                                           env
                                           cx
                                           tps
                                           fname
                                           "alloc-static initializer")
                            (Err [d]
                                 (err-ep (prefix-diag a
                                                      d
                                                      "alloc-static initializer: ")))
                            (Ok [checked]
                                (ok-ep (mk-expr (EAlloc
                                                  :symbol symbol
                                                  :storage storage
                                                  :ty ty
                                                  :init (box-expr a checked))
                                                elo
                                                ehi
                                                esrc
                                                ectxt)
                                       (TPtr (box-type a ty))))))))))
      (EField [pp ffld]
              (synth-field a pp ffld false env cx tps fname elo ehi esrc ectxt))
      (EAccessorField [pp ffld]
                      (synth-field a
                                   pp
                                   ffld
                                   true
                                   env
                                   cx
                                   tps
                                   fname
                                   elo
                                   ehi
                                   esrc
                                   ectxt))
      (ELoad [inner]
             (match (do-synth a inner (null-type) env cx tps fname)
               (Err [d] (err-ep d))
               (Ok [sp0]
                   (let [sp (primitive/alloc-stack SynPair)]
                     (set! sp sp0)
                     (let [pp (place-pointee (load (field sp t)))]
                       (cond (and (!= (primitive/cast i64 pp) 0)
                                  (and (place-in-spilled-temporary? (load (field sp e)))
                                       (type-needs-drop a cx pp)))
                               (err-ep (derr (sconcat a
                                                      (sconcat3 a
                                                                "in '"
                                                                fname
                                                                "': cannot move an owning ")
                                                      (sconcat a
                                                               (ty-str a pp)
                                                               " out of a temporary; bind the value with `let`, then clone or take! the field"))))
                             (!= (primitive/cast i64 pp) 0)
                               (ok-ep (mk-expr (ELoad (load (field sp e)))
                                               elo
                                               ehi
                                               esrc
                                               ectxt)
                                      (load pp))
                             ; `(.name x)` parses as a load of the accessor. A field
                             ; answered by an impl is already the value it read, so
                             ; there is nothing left to load.
                             (accessor-expr? inner)
                               (ok-ep (load (load (field sp e))) (load (field sp t)))
                             :else
                               (err-ep (derr (sconcat a
                                                      (sconcat3 a
                                                                "in '"
                                                                fname
                                                                "': load expects a pointer or reference, got ")
                                                      (ty-str a (load (field sp t))))))))))))
      (EStore [pp val]
              (synth-store a pp val false env cx tps fname elo ehi esrc ectxt))
      (EInitStore [pp val]
                  (synth-store a
                               pp
                               val
                               true
                               env
                               cx
                               tps
                               fname
                               elo
                               ehi
                               esrc
                               ectxt))
      (EIndex [pp idx]
              (synth-index a pp idx env cx tps fname elo ehi esrc ectxt))
      (ECast [ty inner]
             (synth-cast a ty inner env cx tps fname elo ehi esrc ectxt))
      (ESizeOf [ty]
               (let [tp (box-type a ty)]
                 (match (validate-type tp cx tps)
                   (Err [d]
                        (err-ep (prefix-diag a
                                             d
                                             (sconcat3 a
                                                       "in '"
                                                       fname
                                                       "': sizeof: "))))
                   (Ok [_]
                       (ok-ep (mk-expr (ESizeOf ty) elo ehi esrc ectxt)
                              (TInt 64 true))))))
      (EAlignOf [ty]
                (let [tp (box-type a ty)]
                  (match (validate-type tp cx tps)
                    (Err [d]
                         (err-ep (prefix-diag a
                                              d
                                              (sconcat3 a
                                                        "in '"
                                                        fname
                                                        "': alignof: "))))
                    (Ok [_]
                        (ok-ep (mk-expr (EAlignOf ty) elo ehi esrc ectxt)
                               (TInt 64 true))))))
      (EOffsetOf [ty ffld]
                 (synth-offsetof a ty ffld cx tps fname elo ehi esrc ectxt))
      (EBitGet [pp bfld]
               (match (bit-field-type a pp bfld env cx tps fname)
                 (Err [d] (err-ep d))
                 (Ok [sp0]
                     (let [sp (primitive/alloc-stack SynPair)]
                       (set! sp sp0)
                       (ok-ep (mk-expr (EBitGet (load (field sp e)) bfld)
                                       elo
                                       ehi
                                       esrc
                                       ectxt)
                              (load (load (field sp t))))))))
      (EBitSet [pp bfld val]
               (match (bit-field-type a pp bfld env cx tps fname)
                 (Err [d] (err-ep d))
                 (Ok [sp0]
                     (let [sp (primitive/alloc-stack SynPair)]
                       (set! sp sp0)
                       (let [fty (load (field sp t))]
                         (match (do-synth a val fty env cx tps fname)
                           (Err [d] (err-ep d))
                           (Ok [vsp0]
                               (let [vsp (primitive/alloc-stack SynPair)]
                                 (set! vsp vsp0)
                                 (match (coerce a
                                                (load (load (field vsp e)))
                                                (load (field vsp t))
                                                fty
                                                false
                                                fname
                                                (sconcat a
                                                         (sconcat3 a
                                                                   "set! into bitfield '"
                                                                   bfld
                                                                   "'")
                                                         ""))
                                   (Err [d] (err-ep d))
                                   (Ok [ve]
                                       (ok-ep (mk-expr (EBitSet
                                                         :p (load (field sp e))
                                                         :fname bfld
                                                         :val (box-expr a ve))
                                                       elo
                                                       ehi
                                                       esrc
                                                       ectxt)
                                              (load fty))))))))))))
      (EFree [inner]
             (match (do-synth a inner (null-type) env cx tps fname)
               (Err [d] (err-ep d))
               (Ok [sp0]
                   (let [sp (primitive/alloc-stack SynPair)]
                     (set! sp sp0)
                     (if (type-is-ptr (load (field sp t)))
                         (ok-ep (mk-expr (EFree (load (field sp e)))
                                         elo
                                         ehi
                                         esrc
                                         ectxt)
                                (TInt 64 true))
                         (err-ep (derr (sconcat a
                                                (sconcat3 a
                                                          "in '"
                                                          fname
                                                          "': free expects a pointer, got ")
                                                (ty-str a (load (field sp t)))))))))))
      (EErase [trait_name inner]
              (match (do-synth a inner (null-type) env cx tps fname)
                (Err [d] (err-ep d))
                (Ok [sp0]
                    (let [sp (primitive/alloc-stack SynPair)]
                      (set! sp sp0)
                      (match (build-make-dyn a
                                             cx
                                             trait_name
                                             (load (field sp e))
                                             (load (field sp t))
                                             elo
                                             ehi
                                             esrc
                                             ectxt
                                             fname)
                        (Err [d] (err-ep d))
                        (Ok [mp0]
                            (let [mp (primitive/alloc-stack SynPair)]
                              (set! mp mp0)
                              (ok-ep (load (load (field mp e)))
                                     (load (load (field mp
                                                        t)))))))))))
      (EMatch [scrut arms]
              (synth-match a
                           scrut
                           arms
                           expected
                           env
                           cx
                           tps
                           fname
                           elo
                           ehi
                           esrc
                           ectxt))
      (EFnPtrOf [name]
                (if (generic-sig? cx name)
                    (synth-fnptr-inst a name (box-items-type a) expected env cx tps fname elo ehi esrc ectxt)
                    (synth-fnptr-expected a name expected env cx tps fname elo ehi esrc ectxt)))
      (EFnPtrInst [name targs]
                  (if (generic-sig? cx name)
                      (synth-fnptr-inst a name targs expected env cx tps fname elo ehi esrc ectxt)
                      (err-ep (derr-at-src esrc elo ehi
                                           (sconcat3 a "fnptr-of: '" (display-ident name)
                                                     "' is not generic, so it takes no type arguments; write (fnptr-of NAME)")))))
      (ECallPtr [fp args]
                (synth-callptr a fp args env cx tps fname elo ehi esrc ectxt))
      (EConstruct [sum variant args]
                  (match (synth-construct a
                                          variant
                                          (box-items-type a)
                                          args
                                          (null-type)
                                          env
                                          cx
                                          tps
                                          fname
                                          elo
                                          ehi
                                          esrc
                                          ectxt)
                    (Err [d] (err-ep d))
                    (Ok [rv]
                        (let [r (primitive/alloc-stack EvalPair)]
                          (set! r rv)
                          (ok-ep (.e r) (TStruct sum))))))
      (EMakeDyn [dyn_struct vtable_struct methods inner]
                (ok-ep (load e) (TStruct dyn_struct)))
      (EDynDispatch [dc] (let [ds (.dyn_struct dc) vt (.vtable_struct dc) mi (.method_index dc) cc (.cc dc) params (.params dc) ret (.ret dc) recv (.recv dc) args (.args dc)] (ok-ep (load e) ret)))
      ; Named struct construction materializes checked field values inside a
      ; generated let/store tree and checks that tree once more. An aggregate
      ; call argument may already have been normalized to a spill reference, so
      ; preserve that checker-owned place while rechecking its inner value.
      (ESpillRef [inner]
                 (match (do-synth a inner (null-type) env cx tps fname)
                   (Err [d] (err-ep d))
                   (Ok [sp0]
                       (let [sp (primitive/alloc-stack SynPair)]
                         (set! sp sp0)
                         (ok-ep (mk-expr (ESpillRef (load (field sp e)))
                                         elo
                                         ehi
                                         esrc
                                         ectxt)
                                (TRef false
                                      (box-type a (load (load (field sp t))))))))))
      (EMovePlace [place]
                  (match (do-synth a
                                   (box-expr a
                                             (mk-expr (ELoad place)
                                                      elo
                                                      ehi
                                                      esrc
                                                      ectxt))
                                   expected
                                   env
                                   cx
                                   tps
                                   fname)
                    (Err [d] (err-ep d))
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)]
                          (set! sp sp0)
                          (ok-ep (load (field sp e)) (load (load (field sp t)))))))))))

; synth — span-fill + auto dyn-coercion wrapper.
(defn synth [(a (dyn Allocator))
             (e (ptr Expr))
             (expected (ptr Type))
             (env (ptr (ArrayList EnvEntry)))
             (cx (ptr Cx))
             (tps (ptr (ArrayList (slice u8))))
             (fname (slice u8))] (-> (Result EvalPair Diag))
  (let [expected (effective-expected e expected)
        dynt (if (expected-some? expected) (is-dyn-target expected cx) false)]
    (match (synth-inner a e expected env cx tps fname)
      (Err [d]
           (err-ep (dwspan d
                           (.source e)
                           (.lo e)
                           (.hi e)
                           (.ctxt e))))
      (Ok [rv0]
          (let [rv (diverge-never-call a rv0)]
          (if (not dynt)
              (Ok [EvalPair Diag] rv)
              (let [r (primitive/alloc-stack EvalPair)]
                (set! r rv)
                (match (maybe-coerce-dyn a
                                         cx
                                         (box-expr a (.e r))
                                         (box-type a (.t r))
                                         expected
                                         (.lo e)
                                         (.hi e)
                                         (.source e)
                                         (.ctxt e)
                                         fname)
                  (Err [d] (err-ep d))
                  (Ok [mp0]
                      (let [mp (primitive/alloc-stack SynPair)]
                        (set! mp mp0)
                        (ok-ep (load (load (field mp e)))
                               (load (load (field mp
                                                  t))))))))))))))

;;; A call whose type is never -- of a function declared `(-> never)` -- is
;;; followed by a loop that never exits. The loop is what every later pass reads
;;; as an expression that does not yield, the way a `break` or a breakless loop
;;; already is; specialization then gives the callee the void signature it has
;;; to a backend (mono.coil, never-returns-void).
(defn diverge-never-call [(a (dyn Allocator)) (rv EvalPair)] (-> EvalPair)
  (let [call? (match (.kind (.e rv))
                (ECall [_ _ _] true)
                (ECallPtr [_ _] true)
                (ETraitCall [_ _ _ _] true)
                (EDynDispatch [_] true)
                (_ false))]
    (if (and call? (match (.t rv) (TNever [] true) (_ false)))
        (let [e (.e rv)
              (mut body) (ArrayList::new [Expr] a)]
          (push! (mut body) e)
          (push! (mut body)
                 (mk-expr (ELoop (None [(slice u8)]) (box-al [Expr] a (ArrayList::new [Expr] a)))
                          (.lo e) (.hi e) (.source e) (.ctxt e)))
          (mk-evalpair (mk-expr (EDo (box-al [Expr] a (load body)))
                                (.lo e) (.hi e) (.source e) (.ctxt e))
                       (TNever)))
        rv)))

; ============================ finish (Phase 3) =====================
; Static-assert conditions are synth'd + is-cond-checked. The comptime fold
; (comptime::fold_program), aggregate-const statics, (meta …) elaboration, and
; export-c symbol resolution are a separate unported subsystem: finish passes
; funcs through unchanged (a no-op fold for comptime-free programs — any program
; that actually USES comptime will then mismatch the reference and fail the gate,
; never silently pass), and hard-errors on (meta …)/(export-c …) which the dump
; would otherwise misrepresent. Aggregate-const statics do not affect the dump
; (the dumper hardcodes an empty (statics) section), so static_consts are ignored.
(defn finish-asserts [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result (ptr (ArrayList StaticAssert))
                                                                                          Diag))
  (let [as (load (field prog asserts))
        n (len (load as))
        (mut out) (ArrayList::new [StaticAssert] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false
        empty-tps (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ap (elem as (load i))
                      env (env-new a)]
                  (match (let [prior (with-caller-module cx
                                                         (if (< (.source (field ap cnd)) 0)
                                                             ""
                                                             (src-mod-lookup (.source (field ap cnd)))))
                               r (do-synth a
                                           (field ap cnd)
                                           (null-type)
                                           env
                                           cx
                                           empty-tps
                                           "static-assert")]
                           (set! (.caller_module cx) prior)
                           r)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)]
                          (set! sp sp0)
                          (if (not (is-cond (load (field sp t))))
                              (do
                                (set! err
                                      (derr (sconcat a
                                                     "static-assert: condition must be a bool or integer, got "
                                                     (ty-str a
                                                             (load (field sp t))))))
                                (set! failed true)
                                (break))
                              (let [na (primitive/alloc-stack StaticAssert)]
                                (set! (.cnd na) (load (load (field sp e))))
                                (set! (.msg na) (.msg ap))
                                (push! (mut out) (load na))
                                0))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList StaticAssert)) Diag] (load err))
        (Ok (box-al [StaticAssert] a (load out))))))

; ---- finish: (meta …) elaboration + (export-c …) symbol resolution ----
; display_name: strip the auto-referred prelude prefix (`coil.core.`) in diagnostics.
(defn display-name [(n (slice u8))] (-> (slice u8))
  (let [pfx (sconcat (unit-allocator) (unit-prelude-name) ".")
        pl (len pfx)]
    (if (and (>= (len n) pl) (= (subslice n 0 pl) pfx))
        (subslice n pl (len n))
        n)))

; whether convention `cc` uses a :shim lowering (the C ABI needs a native lowering).
(defn conv-cc-is-shim [(cx (ptr Cx)) (cc (slice u8))] (-> bool)
  (let [cv (conv-find cx cc)]
    (and (!= (primitive/cast i64 cv) 0) (conv-is-shim cv))))

; a valid export-c PARAMETER type: scalars/ptr, or a C-layout struct (not a defsum).
(defn export-param-ok [(cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (let [tg (type-tag t)]  ; tg 14 = externref (a wasm reference scalar)
    (if (or (= tg 14)
            (or (= tg 0)
                (or (= tg 1)
                    (or (= tg 2)
                        (or (= tg
                               4)
                            ; A native function pointer is one C scalar pointer.
                            ; Its exact signature and calling convention remain
                            ; in TFn for call-site checking and header emission.
                            (= tg 10))))))
        true
        (if (= tg 6)
            (= (primitive/cast i64 (sum-find cx (type-struct-name t)))
               0)
            false))))

; a valid export-c RETURN type: scalars/ptr/void, or a C-layout struct/App (not a defsum).
(defn export-ret-ok [(cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (let [tg (type-tag t)]  ; tg 14 = externref (a wasm reference scalar)
    ; Function pointers are scalar C addresses in both parameter and result
    ; positions. Their call signature remains represented by TFn.
    (if (or (= tg 10)
            (or (= tg 14)
                (or (= tg 0)
                    (or (= tg 1)
                        (or (= tg 2)
                            (or (= tg
                                   3)
                                (= tg
                                   4)))))))
        true
        (if (or (= tg 6) (= tg 11))
            (= (primitive/cast i64
                               (sum-find cx
                                         (if (= tg 6)
                                             (type-struct-name t)
                                             (t-app-name t))))
               0)
            false))))

; the default C symbol: bare name (module dropped) with `-` -> `_`.
(defn default-c-symbol [(a (dyn Allocator)) (qualified (slice u8))] (-> (slice u8))
  (let [base (last-component qualified)
        n (len base)
        (mut buf) (ArrayList::new [u8] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [c (get base (load i))]
                  (push! (mut buf)
                         (if (= (primitive/cast i64 c)
                                45)
                             (: 95 u8)
                             c)))
                (set! i (primitive/iadd (load i) 1)))))
    (slice (load buf))))

(defn c-ident-char? [(c i64) (first bool)] (-> bool)
  (or (= c 95)
      (or (and (>= c 65) (<= c 90))
          (or (and (>= c 97)
                   (<= c 122))
              (and (not first)
                   (and (>= c 48)
                        (<= c 57)))))))

(defn is-c-ident [(s (slice u8))] (-> bool)
  (let [n (len s)]
    (if (= n 0)
        false
        (let [(mut ok) (c-ident-char? (primitive/cast i64 (get s 0)) true)
              (mut i) 1]
          (loop (if (or (not (load ok)) (>= (load i) n))
                    (break)
                    (do
                      (unless (c-ident-char? (primitive/cast i64
                                                             (get s (load i)))
                                             false)
                        (store! ok
                                false)
                        0)
                      (set! i (primitive/iadd (load i) 1)))))
          (load ok)))))

(defn fn-param-types [(a (dyn Allocator)) (ps (ptr (ArrayList Param)))] (-> (ptr (ArrayList Type)))
  (let [n (len (load ps))
        (mut out) (ArrayList::new [Type] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out) (.ty (elem ps (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn export-first-bad-param [(cx (ptr Cx)) (ps (ptr (ArrayList Param)))] (-> (ptr Param))
  (let [n (len (load ps))
        (mut i) 0
        (mut r) (primitive/cast (ptr Param) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pp (elem ps (load i))]
                  (when (not (export-param-ok cx (field pp ty)))
                    (store! r pp)
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn export-param-msg [(a (dyn Allocator))
                        (dn (slice u8))
                        (pname (slice u8))
                        (t (ptr Type))] (-> (slice u8))
  (sconcat a
           (sconcat3 a "export-c: '" dn "' parameter '")
           (sconcat a
                    pname
                    (sconcat a
                             "' has type "
                             (sconcat a
                                      (ty-str a t)
                                      ", which has no C representation (a slice, sum, SIMD vector, or generic instantiation can't cross the C boundary — take a `(ptr …)` or lower it to a C-layout struct)")))))

; validate ONE export and finalize its C symbol; returns the resolved ExportC.
;;; An `(export-c [f :as "S"])` and an `(extern e … :as "S")` name one C symbol. The
;;; export is the definition and every extern of S binds to it, as when C objects
;;; are linked and one defines what another declares. So the definition must be
;;; something the extern's own declaration could have called: the same register
;;; classes, arity and convention (integer widths may differ, as between any two
;;; declarations of one symbol), and no struct by value, whose C-ABI thunk an
;;; extern's Coil-side signature cannot address. "" when it is, else the error.
(defn export-extern-mismatch [(a (dyn Allocator)) (f (ptr Func)) (ec (ptr ExportC)) (e (ptr Extern))] (-> (slice u8))
  (let [sym (extern-link-name e)
        fps (load (field f params))
        eps (.params e)
        (mut same)
          (and (not (export-c-needs-thunk? ec))
               (and (not (.variadic e))
                    (and (cc-same? (.cc e) (.cc f))
                         (and (= (len (load fps)) (len (load eps)))
                              (extern-abi-class-eq (field f ret) (field e ret))))))]
    (when (load same)
      (for [i 0 (len (load eps))]
        (unless (extern-abi-class-eq (field (elem fps i) ty) (elem eps i))
          (store! same false)
          0)
        0)
      0)
    (cond (load same) ""
          (export-c-needs-thunk? ec)
            (sconcat3 a
                      (sconcat3 a "export-c defines C symbol '" sym "', which '")
                      (.name e)
                      "' also declares; a function taking a struct by value cannot stand in for an extern of that symbol. Export it under a different C symbol")
          :else
            (sconcat3 a
                      (sconcat3 a
                                (sconcat3 a "export-c defines C symbol '" sym "' as ")
                                (sconcat3 a "[" (ty-str-join a (param-types a fps)) "] -> ")
                                (ty-str a (field f ret)))
                      (sconcat3 a ", but '" (.name e) "' declares that symbol as ")
                      (extern-signature-text a e)))))

(defn validate-export [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (prog (ptr Program))
                       (s (ptr LS))
                       (ep (ptr ExportC))] (-> (Result ExportC
                                                       Diag))
  (try (let [ename (load (field ep name))
             dn (display-name ename)
             elo (load (field ep lo))
             ehi (load (field ep hi))
             esrc (load (field ep source))
             f (match (ls-function s ename)
                 (Some [function] function)
                 (None [] (prog-fn-find prog ename)))]
         (when (= (primitive/cast i64 f) 0)
           (break :try
                    (Err [ExportC Diag]
                         (derr-at-src esrc
                                      elo
                                      ehi
                                      (sconcat3 a
                                                "export-c: unknown function '"
                                                dn
                                                (with-removed-hint a
                                                                   "'"
                                                                   (fn-unknown-hint a cx "" dn)))))))
         (when (> (len (load (field f type_params))) 0)
           (break :try
                    (Err [ExportC Diag]
                         (derr-at-src esrc
                                      elo
                                      ehi
                                      (sconcat3 a
                                                "export-c: '"
                                                dn
                                                "' is generic — a generic function has no single C symbol; export a concrete wrapper instead")))))
         (when (conv-cc-is-shim cx (cc-identity (load (field f cc))))
           (break :try
                    (Err [ExportC Diag]
                         (derr-at-src esrc
                                      elo
                                      ehi
                                      (sconcat3 a
                                                "export-c: '"
                                                dn
                                                "' uses a (coil.cc.Shim) convention, which isn't the C ABI")))))
         (let [bp (export-first-bad-param cx (load (field f params)))]
           (when (!= (primitive/cast i64 bp) 0)
             (break :try
                      (Err [ExportC Diag]
                           (derr-at-src esrc
                                        elo
                                        ehi
                                        (export-param-msg a
                                                          dn
                                                          (load (field bp name))
                                                          (field bp
                                                                 ty)))))))
         (when (not (export-ret-ok cx (field f ret)))
           (break :try
                    (Err [ExportC Diag]
                         (derr-at-src esrc
                                      elo
                                      ehi
                                      (sconcat a
                                               (sconcat3 a
                                                         "export-c: '"
                                                         dn
                                                         "' returns ")
                                               (sconcat a
                                                        (ty-str a (field f ret))
                                                        ", which has no C representation"))))))
         (let [sym
                 (match (load (field ep symbol))
                   (Some [s] s)
                   (None [] (default-c-symbol a ename)))]
           (when (not (is-c-ident sym))
             (break :try
                      (Err [ExportC Diag]
                           (derr-at-src esrc
                                        elo
                                        ehi
                                        (sconcat a
                                                 (sconcat3 a
                                                           "export-c: '"
                                                           dn
                                                           "' → '")
                                                 (sconcat a
                                                          sym
                                                          "' isn't a valid C identifier; give one with :as \"name\""))))))
           (let [ec (primitive/alloc-stack ExportC)]
             (store! (field ec name) ename)
             (store! (field ec symbol) (Some [(slice u8)] sym))
             (store! (field ec params)
                     (fn-param-types a (load (field f params))))
             (store! (field ec published) true)
             (store! (field ec lo) elo)
             (store! (field ec hi) ehi)
             (store! (field ec source) (load (field ep source)))
             (store! (field ec ctxt) (load (field ep ctxt)))
             (Ok [ExportC Diag] (load ec)))))))

(defn finish-metas [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result (ptr (ArrayList Expr))
                                                                                        Diag))
  (let [ms (load (field prog metas))
        n (len (load ms))
        (mut out) (ArrayList::new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false
        empty-tps (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [mp (elem ms (load i))
                      env (env-new a)]
                  (match (do-synth a mp (null-type) env cx empty-tps "meta")
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)]
                          (set! sp sp0)
                          (if (not (= (type-tag (load (field sp t)))
                                      13))
                              (do
                                (set! err
                                      (derr (sconcat a
                                                     "meta: expression must produce Code, got "
                                                     (ty-str a
                                                             (load (field sp t))))))
                                (set! failed true)
                                (break))
                              (do
                                (push! (mut out) (load (load (field sp e))))
                                0))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Expr)) Diag] (load err))
        (Ok (box-al [Expr] a (load out))))))

(defn finish-exports [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))
                      (s (ptr LS))] (-> (Result (ptr (ArrayList ExportC))
                                                                                          Diag))
  (let [es (load (field prog exports))
        n (len (load es))
        (mut out) (ArrayList::new [ExportC] a)
        seenb (box! a SBox (primitive/zeroed SBox))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (set! (.items seenb) (ArrayList::new [(slice u8)] a))
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (validate-export a
                                        cx
                                        prog
                                        s
                                        (elem es (load i)))
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [ec0]
                      (let [ec (primitive/alloc-stack ExportC)]
                        (set! ec ec0)
                        (let [sym (match (.symbol ec) (Some [s] s) (None [] ""))]
                          (let [xs (load (field prog externs))
                                nx (len (load xs))
                                f (match (ls-function s (.name ec))
                                    (Some [function] function)
                                    (None [] (prog-fn-find prog (.name ec))))
                                (mut xi) 0
                                (mut mismatch) ""]
                            (loop (if (>= (load xi) nx)
                                      (break)
                                      (do
                                        (when (= (extern-link-name (elem xs (load xi))) sym)
                                          (store! mismatch
                                                  (export-extern-mismatch a f (mut ec) (elem xs (load xi))))
                                          (when (> (len (load mismatch)) 0) (break)))
                                        (set! xi (primitive/iadd (load xi) 1)))))
                            (when (> (len (load mismatch)) 0)
                              (set! err (derr-at-src (.source ec) (.lo ec) (.hi ec) (load mismatch)))
                              (set! failed true)
                              (break)))
                          (if (set-contains (field seenb items) sym)
                              (do
                                (set! err
                                      (derr-at-src (.source ec)
                                                   (.lo ec)
                                                   (.hi ec)
                                                   (sconcat3 a
                                                             "export-c: two functions export the same C symbol '"
                                                             sym
                                                             "'")))
                                (set! failed true)
                                (break))
                              (do
                                (push! (mut (.items seenb)) sym)
                                (push! (mut out) (load ec))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList ExportC)) Diag] (load err))
        (Ok (box-al [ExportC] a (load out))))))

(defn finish [(a (dyn Allocator))
              (cx (ptr Cx))
              (prog (ptr Program))
              (s (ptr LS))
              (funcs (ptr (ArrayList Func)))] (-> (Result (ptr Program)
                                                          Diag))
  (match (finish-asserts a cx prog)
    (Err [d] (Err [(ptr Program) Diag] d))
    (Ok [asserts]
        (match (finish-metas a cx prog)
          (Err [d] (Err [(ptr Program) Diag] d))
          (Ok [metas]
              (match (finish-exports a cx prog s)
                (Err [d] (Err [(ptr Program) Diag] d))
                (Ok [exports]
                    (let [out (box! a Program (primitive/zeroed Program))
                          (mut all_funcs) (ArrayList::new [Func] a)]
                      (for [fi 0 (len (load funcs))]
                        (push! (mut all_funcs) (get (load funcs) fi)))
                      (for [fi 0 (len (field cx anon_funcs))]
                        (push! (mut all_funcs) (get (field cx anon_funcs) fi)))
                      (set! (.annotation_defs out)
                            (load (field prog annotation_defs)))
                      (set! (.conventions out) (load (field prog conventions)))
                      (set! (.structs out) (load (field prog structs)))
                      (set! (.sums out) (load (field prog sums)))
                      (set! (.externs out) (load (field prog externs)))
                      (set! (.funcs out) (box-al [Func] a (load all_funcs)))
                      (set! (.asserts out) asserts)
                      (set! (.consts out) (load (field prog consts)))
                      (set! (.traits out) (load (field prog traits)))
                      (set! (.impls out) (load (field prog impls)))
                      (set! (.metas out) metas)
                      (set! (.exports out)
                            (let [(mut all) (ArrayList::new [ExportC] a)]
                              (for [ei 0 (len (load exports))]
                                (push! (mut all) (get (load exports) ei)))
                              ; A function exported to C already has its by-value
                              ; entry; a pointer to it reaches that one.
                              (for [ei 0 (len (field cx anon_c_entries))]
                                (let [entry (get (field cx anon_c_entries) ei)]
                                  (unless (block :exported
                                            (for [xi 0 (len (load exports))]
                                              (when (= (.name (elem exports xi))
                                                       (.name entry))
                                                (break :exported true)))
                                            false)
                                    (push! (mut all) entry))))
                              (box-al [ExportC] a (load all))))
                      (set! (.mono_trait_uses out)
                            (box-al [MonoTraitUse] a (.trait_uses cx)))
                      (let [(mut abis) (ArrayList::new [Extern] a)
                            ns (len (.sigs cx))]
                        (sigbase/sig-base-append-abis!
                          (.sig_base cx) (.new_sig_names cx) a (mut abis))
                        (for [i 0 ns]
                          (let [sig (elem (mut (.sigs cx)) i)]
                            ; Generic functions too: their checked Funcs have erased
                            ; parameters like any other, and a constant that calls
                            ; one is checked again from source when the program is
                            ; set up (setup-checked-fnptr-sigs).
                            (if (and (contains? (.new_sig_names cx)
                                                (.name sig))
                                     (not (.is_extern sig)))
                                (let [surface (primitive/alloc-stack Extern)]
                                  (set! (.name surface) (.name sig))
                                  (set! (.symbol surface) (None [(slice u8)]))
                                  (set! (.cc surface) (CcResolved (.cc sig)))
                                  (set! (.params surface) (.params sig))
                                  (set! (.variadic surface) false)
                                  (set! (.ret surface) (.ret sig))
                                  (set! (.span_source surface) -1)
                                  (push! (mut abis) (load surface)))
                                0)))
                        (set! (.function_abis out)
                              (box-al [Extern] a (load abis))))
                      (set! (.unit_exports out)
                            (load (field prog unit_exports)))
                      (set! (.unit_build out) (.unit_build prog))
                      (set! (.aliases out) (load (field prog aliases)))
                      (set! (.retirements out) (.retirements prog))
                      (set! (.retired_functions out) (.retired_functions prog))
                      ; Phase 3 comptime fold: replace every
                      ; `(comptime …)` in a function body / static-assert with its literal.
                      ; A no-op for comptime-free programs (bootstrap + IR corpus unaffected).
                      ; A provisional check -- the model a semantic transform reads --
                      ; elaborates no ownership, so its code cannot run: a comptime
                      ; thunk's `defer` reached a backend unlowered and aborted the
                      ; compiler. It keeps its (comptime …) forms; the authoritative
                      ; check after the transforms folds them.
                      (if (not (.validate_anon_ownership cx))
                          (Ok out)
                          (match (fold-program out (load (field out asserts)) a)
                            (Err [d] (Err [(ptr Program) Diag] d))
                            (Ok [_] (Ok out))))))))))))

; ============================ the check pass ===================
; check-program: setup (Phase 1, fail-fast) ->
; check_func over every function (Phase 2; FIRST error wins, matching the oracle's
; dump_error of diagnostics[0]) -> finish (Phase 3). Returns the typed/elaborated/
; LOWERED Program, or Err(diag) dumped canonically.
; Check every function body. Mirrors check_with Phase 2: it collects
; ALL body errors (checking continues past a failing function) into `diags`, so the
; build path can render every error (`N errors`). The single-Diag return keeps the
; dump-checked oracle unchanged (it reports diagnostics[0]).
; a function whose BODY failed to resolve (resolve poisoned it): its signature is in the
; table so callers resolve, but there is no point type-checking a body full of unresolved
; names — that only produces derivative noise on top of the resolve error already reported.
(defn func-poisoned? [(s (mut LS)) (nm (slice u8))] (-> bool)
  (let [pp (load (field s resolve_poisoned))]
    (if (= (primitive/cast i64 pp) 0)
        false
        (let [n (len pp)
              (mut i) 0
              (mut r) false]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (when (= (get pp (load i)) nm) (store! r true) (break))
                      (set! i (primitive/iadd (load i) 1)))))
          (load r)))))

; ============================ affine ownership validation ===================
; This first ownership pass tracks whole bindings only. It intentionally rejects
; ownership that is consumed on only one control-flow path and ownership carried
; around a loop; projection-aware partial moves and conditional drop flags are a
; later extension. Binding identity comes from the authoritative checker side map,
; so shadowed names can never alias this state accidentally.
(defstruct MoveState
  [(bid i64)
   (moved bool)
   (name (slice u8))
   (ty (ptr Type))
   (lo i64)
   (hi i64)
   (source i64)
   (ctxt i64)
   ; A `(defer* cleanup)` in scope is a state too, so its cleanup takes its place
   ; among the drops at every exit. Null for an owner. `uses` holds the owners the
   ; cleanup reads, which must still be live wherever it runs; `pinned` the names
   ; it refers to, which no binding between it and an exit may shadow.
   (cleanup (ptr Expr))
   (uses (ptr (ArrayList i64)))
   (pinned (ptr (ArrayList (slice u8))))])

(defstruct OwnershipLoop
  [(label (Option (slice u8)))
   ; Number of owners live outside the loop. Exiting to this loop drops every
   ; currently-live owner at an index greater than or equal to this depth.
   (owner_depth i64)
   ; For a block (`block*`, a loop its body always leaves), the owner states at
   ; each break to it; null for a loop that iterates.
   (block_exits (ptr (ArrayList (ptr (ArrayList MoveState)))))])

;;; Is this checked loop a `block*`: a body that is one break to its own label,
;;; so it runs once and every way out of it is a break to it?
(defn loop-is-block? [(label (Option (slice u8))) (body (ptr (ArrayList Expr)))] (-> bool)
  (and (= (len (load body)) 1)
       (match label
         (Some [l]
               (match (.kind (elem body 0))
                 (EBreak [bl _] (match bl (Some [b] (= b l)) (None [] false)))
                 (_ false)))
         (None [] false))))

;;; The block frame a break to `label` leaves, or null when that is a loop's.
(defn ownership-block-exits [(loops (ptr (ArrayList OwnershipLoop)))
                             (label (Option (slice u8)))] (-> (ptr (ArrayList (ptr (ArrayList MoveState)))))
  (let [(mut i) (primitive/isub (len (load loops)) 1)
        (mut found) (primitive/cast (ptr (ArrayList (ptr (ArrayList MoveState)))) 0)]
    (loop (if (< (load i) 0)
              (break)
              (let [lp (elem loops (load i))]
                (if (match label
                      (None [] true)
                      (Some [want]
                            (match (.label lp)
                              (Some [have] (= want have))
                              (None [] false))))
                    (do (set! found (.block_exits lp)) (break))
                    (set! i (primitive/isub (load i) 1))))))
    (load found)))

(defn ownership-register! [(states (ptr (ArrayList MoveState)))
                           (bid i64)
                           (name (slice u8))
                           (ty (ptr Type))
                           (lo i64)
                           (hi i64)
                           (source i64)
                           (ctxt i64)] (-> i64)
  (when (and (> bid 0)
             (= (primitive/cast i64 (move-state-find states bid))
                0))
    (let [st (primitive/alloc-stack MoveState)]
      (set! (.bid st) bid)
      (set! (.moved st) false)
      (set! (.name st) name)
      (set! (.ty st) ty)
      (set! (.lo st) lo)
      (set! (.hi st) hi)
      (set! (.source st) source)
      (set! (.ctxt st) ctxt)
      (set! (.cleanup st) (primitive/cast (ptr Expr) 0))
      (set! (.uses st) (primitive/cast (ptr (ArrayList i64)) 0))
      (set! (.pinned st) (primitive/cast (ptr (ArrayList (slice u8))) 0))
      (push! [MoveState] states (load st)))
    0)
  0)

(defn move-state-cleanup? [(st (ptr MoveState))] (-> bool)
  (!= (primitive/cast i64 (.cleanup st)) 0))

(defn move-states-clone [(src (ptr (ArrayList MoveState)))] (-> (ptr (ArrayList MoveState)))
  (let [a (.alc src)
        (mut out) (ArrayList::new [MoveState] a)
        n (len (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out) (get (load src) (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [MoveState] a (load out))))

;;; The first `n` owner states: those of the owners live when a scope began.
(defn move-states-prefix [(src (ptr (ArrayList MoveState)))
                          (n i64)] (-> (ptr (ArrayList MoveState)))
  (let [a (.alc src)
        (mut out) (ArrayList::new [MoveState] a)]
    (for [i 0 (if (< n (len (load src))) n (len (load src)))]
      (push! (mut out) (get (load src) i)))
    (box-al [MoveState] a (load out))))

(defn move-state-find [(states (ptr (ArrayList MoveState))) (bid i64)] (-> (ptr MoveState))
  (let [n (len (load states))
        (mut i) 0
        (mut found) (primitive/cast (ptr MoveState) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (.bid (elem states (load i))) bid)
                  (store! found (elem states (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn move-state-find-name [(states (ptr (ArrayList MoveState)))
                            (name (slice u8))] (-> (ptr MoveState))
  (let [(mut i) (primitive/isub (len (load states)) 1)
        (mut found) (primitive/cast (ptr MoveState) 0)]
    (loop (if (< (load i) 0)
              (break)
              (let [st (elem states (load i))]
                (if (= (.name st) name)
                    (do (set! found st) (break))
                    (set! i (primitive/isub (load i) 1))))))
    (load found)))

(defn move-states-merge! [(dst (ptr (ArrayList MoveState)))
                          (src (ptr (ArrayList MoveState)))] (-> i64)
  (let [n (len (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [from (elem src (load i))]
                  (when (.moved from)
                    (let [to (move-state-find dst (.bid from))]
                      (if (= (primitive/cast i64 to) 0)
                          (push! [MoveState] dst (load from))
                          (unless (.moved to)
                            (set! (.moved to) true)
                            (set! (.name to) (.name from))
                            (set! (.lo to) (.lo from))
                            (set! (.hi to) (.hi from))
                            (set! (.source to) (.source from))
                            (set! (.ctxt to) (.ctxt from))
                            0)))))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn move-state-moved? [(states (ptr (ArrayList MoveState))) (bid i64)] (-> bool)
  (let [st (move-state-find states bid)]
    (and (!= (primitive/cast i64 st) 0) (.moved st))))

(defn ownership-state-mismatch [(left (ptr (ArrayList MoveState)))
                                (right (ptr (ArrayList MoveState)))] (-> (ptr MoveState))
  (let [ln (len (load left))
        rn (len (load right))
        (mut i) 0
        (mut mismatch) (primitive/cast (ptr MoveState) 0)]
    (loop (if (>= (load i) ln)
              (break)
              (let [st (elem left (load i))]
                (when (!= (.moved st) (move-state-moved? right (.bid st)))
                  (store! mismatch st)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (when (= (primitive/cast i64 (load mismatch)) 0)
      (store! i 0)
      (loop (if (>= (load i) rn)
                (break)
                (let [st (elem right (load i))]
                  (when (!= (.moved st) (move-state-moved? left (.bid st)))
                    (store! mismatch st)
                    (break))
                  (store! i (primitive/iadd (load i) 1))))))
    (load mismatch)))

(defn ownership-require-same-states [(a (dyn Allocator))
                                     (left (ptr (ArrayList MoveState)))
                                     (right (ptr (ArrayList MoveState)))
                                     (fname (slice u8))
                                     (reason (slice u8))] (-> (Result i64 Diag))
  (let [st (ownership-state-mismatch left right)]
    (if (= (primitive/cast i64 st) 0)
        (Ok [i64 Diag] 0)
        (Err [i64 Diag]
             (derr-at-src (.source st)
                          (.lo st)
                          (.hi st)
                          (sconcat a
                                   (sconcat3 a "in '" fname "': ownership of '")
                                   (sconcat a
                                            (sconcat3 a
                                                      (.name st)
                                                      "' differs "
                                                      reason)
                                            (sconcat3 a
                                                      " (owner type "
                                                      (ty-str a (.ty st))
                                                      ")"))))))))

; The checker records each node's type once, in terms of the function it was
; written in. A generic body is ownership-checked per instance, after mono, when
; those recorded types still name the abstract parameters; `ownership_subst`
; (set by mono for the instance being elaborated) maps them to the instance's
; semantic types, so Drop is decided for the type the node really has.
(defn ownership-node-type [(a (dyn Allocator)) (cx (ptr Cx)) (node-id i64)] (-> (Option Type))
  (match (type-map-lookup node-id)
    (Some [t]
          (let [subst (.ownership_subst cx)]
            (if (= (primitive/cast i64 subst) 0)
                (Some t)
                (let [tp (primitive/alloc-stack Type)]
                  (set! tp t)
                  (Some (subst-apply a tp subst))))))
    (None [] (None [Type]))))

(defn ownership-expr-type [(a (dyn Allocator)) (cx (ptr Cx)) (e (ptr Expr))] (-> (Option Type))
  (let [by-node (ownership-node-type a cx (.node-id e))]
    (match by-node
      (Some [t] (Some t))
      (None []
            (match (.kind e)
              (ELoad [inner]
                     (match (ownership-node-type a cx (.node-id inner))
                       (Some [it]
                             (match it
                               (TRef [_ pointee] (Some (load pointee)))
                               (TPtr [pointee] (Some (load pointee)))
                               (_ (None [Type]))))
                       (None [] (None [Type]))))
              (_ (None [Type])))))))

(defn ownership-expr-needs-drop [(a (dyn Allocator))
                                 (cx (ptr Cx))
                                 (e (ptr Expr))] (-> bool)
  (match (ownership-expr-type a cx e)
    (Some [t]
          (let [tp (primitive/alloc-stack Type)]
            (set! tp t)
            (match t
              (TRef [_ inner] (type-needs-drop a cx inner))
              (_ (type-needs-drop a cx tp)))))
    (None [] false)))

(defn ownership-root-var [(e (ptr Expr))] (-> (ptr Expr))
  (match (.kind e)
    (EVar [_] e)
    (ELoad [inner] (ownership-root-var inner))
    (ESpillRef [inner] (ownership-root-var inner))
    (EMovePlace [inner] (ownership-root-var inner))
    (_ (primitive/cast (ptr Expr) 0))))

(defn ownership-place-root-var [(e (ptr Expr))] (-> (ptr Expr))
  (match (.kind e)
    (EVar [_] e)
    (ELoad [inner] (ownership-place-root-var inner))
    (ESpillRef [inner] (ownership-place-root-var inner))
    (EMovePlace [inner] (ownership-place-root-var inner))
    (EField [place _] (ownership-place-root-var place))
    (EIndex [place _] (ownership-place-root-var place))
    (_ (primitive/cast (ptr Expr) 0))))

(defn ownership-root-state [(e (ptr Expr))
                            (states (ptr (ArrayList MoveState)))] (-> (ptr MoveState))
  (let [root (ownership-place-root-var e)]
    (if (= (primitive/cast i64 root) 0)
        (primitive/cast (ptr MoveState) 0)
        (let [bid (bind-map-lookup (.node-id root))]
          (if (> bid 0)
              (move-state-find states bid)
              (match (.kind root)
                (EVar [name] (move-state-find-name states name))
                (_ (primitive/cast (ptr MoveState) 0))))))))

; Type of a place projection rooted in `root-type`. Whole-binding move checking
; rejects a move out of a projection (see `ownership-require-movable`); overwrite
; still needs the narrower projected type so it destroys exactly the replaced
; field or array element.
(defn ownership-place-type [(a (dyn Allocator))
                            (cx (ptr Cx))
                            (place (ptr Expr))
                            (root-type (ptr Type))] (-> (Option Type))
  (match (.kind place)
    (EVar [_] (Some (load root-type)))
    (ELoad [inner] (ownership-place-type a cx inner root-type))
    (ESpillRef [inner] (ownership-place-type a cx inner root-type))
    (EMovePlace [inner] (ownership-place-type a cx inner root-type))
    (EIndex [base _]
            (match (ownership-place-type a cx base root-type)
              (Some [base-type]
                    (match base-type
                      (TArray [elem _] (Some (load elem)))
                      (_ (None [Type]))))
              (None [] (None [Type]))))
    (EField [base name]
            (match (ownership-place-type a cx base root-type)
              (Some [base-type]
                    (let [bp (primitive/alloc-stack Type)]
                      (set! bp base-type)
                      (try (let [fields
                                   (try-or! (struct-fields a bp cx)
                                            (None [Type]))]
                             (let [(mut i) 0
                                   (mut result) (None [Type])]
                               (loop (if (>= (load i) (len (load fields)))
                                         (break)
                                         (let [fp
                                                 (elem fields
                                                       (load i))]
                                           (if (= (.name fp) name)
                                               (do
                                                 (set! result
                                                       (Some (load (field fp ty))))
                                                 (break))
                                               (set! i
                                                     (primitive/iadd (load i) 1))))))
                               (load result))))))
              (None [] (None [Type]))))
    (_ (None [Type]))))

(defn ownership-load-direct-place! [(a (dyn Allocator))
                                    (value (ptr Expr))
                                    (states (ptr (ArrayList MoveState)))] (-> i64)
  (match (.kind value)
    (EVar [_]
          (when (!= (primitive/cast i64 (ownership-root-state value states))
                    0)
            (let [saved (box-expr a (load value))]
              (set! (.kind value) (ELoad saved))
              0)))
    (_ 0))
  0)

; The reference twin of `ownership-load-direct-place!`. A named owner is its own
; place, so a reference to it is that place, never a spill of it. The checker
; spills a generic `T` parameter it passes to a `(ref T)`, because before
; substitution `T` has value ABI; once mono gives an affine `T` its owning slot,
; spilling that name would store the slot's ADDRESS and lend out a pointer to it.
(defn ownership-unspill-owner-place! [(spill (ptr Expr))
                                      (inner (ptr Expr))
                                      (states (ptr (ArrayList MoveState)))] (-> i64)
  (match (.kind inner)
    (EVar [_]
          (when (!= (primitive/cast i64 (ownership-root-state inner states))
                    0)
            (set! (.kind spill) (.kind inner))
            0))
    ; a read of the owner's slot (mono writes one for each use of a generic
    ; owner parameter): the slot is the place
    (ELoad [place]
           (match (.kind place)
             (EVar [_]
                   (when (!= (primitive/cast i64 (ownership-root-state place states))
                             0)
                     (set! (.kind spill) (.kind place))
                     0))
             (_ 0)))
    (_ 0))
  0)

(defn ownership-consume-root! [(a (dyn Allocator))
                               (e (ptr Expr))
                               (states (ptr (ArrayList MoveState)))
                               (fname (slice u8))] (-> (Result i64 Diag))
  (let [root (ownership-root-var e)]
    (if (= (primitive/cast i64 root) 0)
        (Ok [i64 Diag] 0)
        (let [bid (bind-map-lookup (.node-id root))
              old
                (if (> bid 0)
                    (move-state-find states bid)
                    (match (.kind root)
                      (EVar [name] (move-state-find-name states name))
                      (_ (primitive/cast (ptr MoveState) 0))))]
          (if (and (<= bid 0)
                   (= (primitive/cast i64 old) 0))
              (Ok [i64 Diag] 0)
              (let []
                (if (and (!= (primitive/cast i64 old) 0)
                         (.moved old))
                    (Err [i64 Diag]
                         (derr-at-src (.source root)
                                      (.lo root)
                                      (.hi root)
                                      (sconcat a
                                               (sconcat3 a
                                                         "in '"
                                                         fname
                                                         "': use of moved value '")
                                               (sconcat a (.name old) "'"))))
                    (do
                      ; Every affine parameter/let owner is registered at its
                      ; lexical introduction. An unregistered root is therefore
                      ; a Copy binding or non-owning compiler temporary.
                      (unless (= (primitive/cast i64 old)
                                 0)
                        (set! (.moved old) true)
                        0)
                      (Ok [i64 Diag] 0)))))))))

(defn ownership-require-live-root [(a (dyn Allocator))
                                   (e (ptr Expr))
                                   (states (ptr (ArrayList MoveState)))
                                   (fname (slice u8))] (-> (Result i64 Diag))
  (let [st (ownership-root-state e states)]
    (if (and (!= (primitive/cast i64 st) 0) (.moved st))
        (Err [i64 Diag]
             (derr-at-src (.source e)
                          (.lo e)
                          (.hi e)
                          (sconcat a
                                   (sconcat3 a
                                             "in '"
                                             fname
                                             "': use of moved value '")
                                   (sconcat a (.name st) "'"))))
        (Ok [i64 Diag] 0))))

(defn ownership-drop-call [(a (dyn Allocator))
                           (cx (ptr Cx))
                           (place (ptr Expr))
                           (ty (ptr Type))
                           (lo i64)
                           (hi i64)
                           (source i64)
                           (ctxt i64)] (-> (Option Expr))
  (if (= (primitive/cast i64 ty) 0)
      (None [Expr])
      (let [(mut args) (ArrayList::new [Expr] a)
            arg (load place)]
        (push! (mut args) arg)
        (if (ownership-bound-has cx ty (core-name "Drop"))
            (match (load ty)
              (TStruct [self]
                       (Some (mk-expr (ETraitCall
                                        :trait_name (core-name "Drop")
                                        :method "drop"
                                        :self_tp self
                                        :args (box-al [Expr] a (load args)))
                                      lo
                                      hi
                                      source
                                      ctxt)))
              (_ (None [Expr])))
            (let [sel (primitive/alloc-stack ImplSel)]
              (set! sel (cx-impl-select a cx (core-name "Drop") ty))
              (if (= (primitive/cast i64 (load (field sel ip)))
                     0)
                  (None [Expr])
                  (let [ip (load (field sel ip))
                        binds (subst-new a)]
                    ; A generic impl method is itself generic. Cleanup synthesis
                    ; bypasses ordinary call checking, so recover the impl's type
                    ; arguments from the concrete receiver exactly as trait-call
                    ; monomorphization does.
                    (unify-trait-extras a
                                        (field ip self_type)
                                        ty
                                        (load (field ip type_params))
                                        binds)
                    (Some (mk-expr (ECall
                                     :func
                                       (tmfn a
                                             (core-name "Drop")
                                             (impl-mangle-key a
                                                              (field ip
                                                                     self_type)
                                                              (load (field ip
                                                                           type_params)))
                                             "drop")
                                     :type_args
                                       (subst-targs a
                                                    (load (field ip type_params))
                                                    binds)
                                     :args (box-al [Expr] a (load args)))
                                   lo
                                   hi
                                   source
                                   ctxt)))))))))

(defn ownership-append-sum-glue! [(a (dyn Allocator))
                                  (cx (ptr Cx))
                                  (out (ptr (ArrayList Expr)))
                                  (place (ptr Expr))
                                  (ty (ptr Type))
                                  (lo i64)
                                  (hi i64)
                                  (source i64)
                                  (ctxt i64)] (-> bool)
  (let [svp (primitive/alloc-stack SumVars)]
    (set! svp (sum-variants a ty cx))
    (if (not (.found svp))
        false
        (let [variants (load (field svp variants))
              nv (len (load variants))
              (mut arms) (ArrayList::new [Arm] a)
              (mut i) 0]
          (loop (if (>= (load i) nv)
                    (break)
                    (do
                      (let [vp (elem variants (load i))
                            fields (load (field vp fields))
                            nf (len (load fields))
                            (mut names) (ArrayList::new [(slice u8)] a)
                            (mut drops) (ArrayList::new [Expr] a)
                            (mut j) 0]
                        (loop (if (>= (load j) nf)
                                  (break)
                                  (do
                                    (push! (mut names)
                                           (sconcat a
                                                    "$drop.payload."
                                                    (sconcat a
                                                             (i64->str a
                                                                       (load i))
                                                             (sconcat a
                                                                      "."
                                                                      (i64->str a
                                                                                (load j))))))
                                    (set! j (primitive/iadd (load j) 1)))))
                        (set! j (primitive/isub nf 1))
                        (loop (if (< (load j) 0)
                                  (break)
                                  (do
                                    (let [fp (elem fields (load j))]
                                      (when (type-needs-drop a cx (field fp ty))
                                        (let [payload
                                                (box-expr a
                                                          (mk-expr (ESpillRef (box-expr a
                                                                                        (mk-expr (EVar (get (load names)
                                                                                                            (load j)))
                                                                                                 lo
                                                                                                 hi
                                                                                                 source
                                                                                                 ctxt)))
                                                                   lo
                                                                   hi
                                                                   source
                                                                   ctxt))]
                                          (ownership-append-drop-glue! a
                                                                       cx
                                                                       (mut drops)
                                                                       payload
                                                                       (field fp
                                                                              ty)
                                                                       lo
                                                                       hi
                                                                       source
                                                                       ctxt)
                                          0)))
                                    (set! j (primitive/isub (load j) 1)))))
                        ; Match is emitted as an ordinary value expression by all
                        ; backends. Give every cleanup arm the same disposable
                        ; scalar result; the surrounding cleanup discards it.
                        (push! (mut drops) (mk-expr (EInt 0) lo hi source ctxt))
                        (let [ap (primitive/alloc-stack Arm)]
                          (set! (.variant ap) (.name vp))
                          (set! (.binds ap)
                                (box-al [(slice u8)] a (load names)))
                          (set! (.body ap)
                                (mk-expr (EDo (box-al [Expr] a (load drops)))
                                         lo
                                         hi
                                         source
                                         ctxt))
                          (push! (mut arms) (load ap))))
                      (set! i (primitive/iadd (load i) 1)))))
          (let [scrut
                  (box-expr a
                            (mk-expr (ELoad (box-expr a (load place)))
                                     lo
                                     hi
                                     source
                                     ctxt))]
            (push! [Expr]
                   out
                   (mk-expr (EMatch scrut (box-al [Arm] a (load arms)))
                            lo
                            hi
                            source
                            ctxt)))
          true))))

(defn ownership-append-drop-glue! [(a (dyn Allocator))
                                   (cx (ptr Cx))
                                   (out (ptr (ArrayList Expr)))
                                   (place (ptr Expr))
                                   (ty (ptr Type))
                                   (lo i64)
                                   (hi i64)
                                   (source i64)
                                   (ctxt i64)] (-> i64)
  ; User Drop runs first, while every field is still initialized. Structural
  ; field glue follows in reverse declaration order, matching lexical owners.
  (match (ownership-drop-call a cx place ty lo hi source ctxt)
    (Some [drop] (push! [Expr] out drop))
    (None [] 0))
  (if (ownership-append-sum-glue! a cx out place ty lo hi source ctxt)
      0
      (match (load ty)
        (TStruct [_]
                 (try (let [fields (try-or! (struct-fields a ty cx) 0)]
                        (let [(mut i) (primitive/isub (len (load fields)) 1)]
                          (loop (if (< (load i) 0)
                                    (break)
                                    (do
                                      (let [fp (elem fields (load i))]
                                        (when (type-needs-drop a
                                                               cx
                                                               (field fp ty))
                                          (let [field-place
                                                  (box-expr a
                                                            (mk-expr (EField (box-expr a
                                                                                       (load place))
                                                                             (.name fp))
                                                                     lo
                                                                     hi
                                                                     source
                                                                     ctxt))]
                                            (ownership-append-drop-glue! a
                                                                         cx
                                                                         out
                                                                         field-place
                                                                         (field fp
                                                                                ty)
                                                                         lo
                                                                         hi
                                                                         source
                                                                         ctxt)
                                            0)))
                                      (set! i (primitive/isub (load i) 1)))))
                          0))))
        (TApp [_ _]
              (try (let [fields (try-or! (struct-fields a ty cx) 0)]
                     (let [(mut i) (primitive/isub (len (load fields)) 1)]
                       (loop (if (< (load i) 0)
                                 (break)
                                 (do
                                   (let [fp (elem fields (load i))]
                                     (when (type-needs-drop a cx (field fp ty))
                                       (let [field-place
                                               (box-expr a
                                                         (mk-expr (EField (box-expr a
                                                                                    (load place))
                                                                          (.name fp))
                                                                  lo
                                                                  hi
                                                                  source
                                                                  ctxt))]
                                         (ownership-append-drop-glue! a
                                                                      cx
                                                                      out
                                                                      field-place
                                                                      (field fp
                                                                             ty)
                                                                      lo
                                                                      hi
                                                                      source
                                                                      ctxt)
                                         0)))
                                   (set! i (primitive/isub (load i) 1)))))
                       0))))
        (TArray [elem extent]
                ; Array length is part of the type. Emit one statically indexed drop
                ; per element in reverse order, avoiding a mutable synthesized loop
                ; and giving every backend the same simple cleanup IR.
                (let [(mut i) (primitive/isub (extent-value extent) 1)]
                  (loop (if (< (load i) 0)
                            (break)
                            (do
                              (let [element-place
                                      (box-expr a
                                                (mk-expr (EIndex (box-expr a
                                                                           (load place))
                                                                 (box-expr a
                                                                           (mk-expr (EInt (load i))
                                                                                    lo
                                                                                    hi
                                                                                    source
                                                                                    ctxt)))
                                                         lo
                                                         hi
                                                         source
                                                         ctxt))]
                                (ownership-append-drop-glue! a
                                                             cx
                                                             out
                                                             element-place
                                                             elem
                                                             lo
                                                             hi
                                                             source
                                                             ctxt)
                                0)
                              (set! i (primitive/isub (load i) 1)))))
                  0))
        (_ 0)))
  0)

; ---- cleanups placed at exits: hygiene ------------------------------------------
; Elaboration copies a cleanup -- an owner's drop glue, a defer's cleanup -- to
; every break and continue that leaves its scope. The copy names variables, and
; at the exit a binding nested between the cleanup's scope and the exit may
; spell one of those names: `(let [x (Owner)] (let [x 2] (break)))` dropped the
; inner `x` at the break and never the outer one. So every name a live cleanup
; refers to is PINNED, and a nested binding that would shadow one is renamed for
; its scope before that scope is elaborated. The new name is a scoped key, which
; diagnostics print as the source spelling.

;;; Append the expressions directly inside `e` to `out`.
(defn ownership-children! [(e (ptr Expr)) (out (ptr (ArrayList (ptr Expr))))] (-> i64)
  (match (.kind e)
    (EBorrow [_ place] (push! [(ptr Expr)] out place))
    (ELet [binds body]
          (do
            (for [i 0 (len (load binds))]
              (push! [(ptr Expr)] out (field (elem binds i) value)))
            (ownership-children-list! body out)))
    (EBin [_ l r] (do (push! [(ptr Expr)] out l) (push! [(ptr Expr)] out r)))
    (EIntUnary [_ x] (push! [(ptr Expr)] out x))
    (ECmp [_ l r] (do (push! [(ptr Expr)] out l) (push! [(ptr Expr)] out r)))
    (EIf [c t f]
         (do (push! [(ptr Expr)] out c) (push! [(ptr Expr)] out t) (push! [(ptr Expr)] out f)))
    (EDo [body] (ownership-children-list! body out))
    (ECall [_ _ args] (ownership-children-list! args out))
    (ENamedCall [_ _ _ args] (ownership-children-list! args out))
    (EAlloc [_ _ init _]
            (if (= (primitive/cast i64 init) 0)
                0
                (push! [(ptr Expr)] out init)))
    (EField [p _] (push! [(ptr Expr)] out p))
    (EAccessorField [p _] (push! [(ptr Expr)] out p))
    (ELoad [x] (push! [(ptr Expr)] out x))
    (EStore [p v] (do (push! [(ptr Expr)] out p) (push! [(ptr Expr)] out v)))
    (EInitStore [p v] (do (push! [(ptr Expr)] out p) (push! [(ptr Expr)] out v)))
    (EIndex [p i] (do (push! [(ptr Expr)] out p) (push! [(ptr Expr)] out i)))
    (ECast [_ x] (push! [(ptr Expr)] out x))
    (EBitGet [p _] (push! [(ptr Expr)] out p))
    (EBitSet [p _ v] (do (push! [(ptr Expr)] out p) (push! [(ptr Expr)] out v)))
    (EFree [x] (push! [(ptr Expr)] out x))
    (EErase [_ x] (push! [(ptr Expr)] out x))
    (EMatch [scrut arms]
            (do
              (push! [(ptr Expr)] out scrut)
              (for [i 0 (len (load arms))]
                (push! [(ptr Expr)] out (field (elem arms i) body)))))
    (ECallPtr [fp args] (do (push! [(ptr Expr)] out fp) (ownership-children-list! args out)))
    (ELoop [_ body] (ownership-children-list! body out))
    (EBreak [_ value]
            (match value
              (Some [v] (push! [(ptr Expr)] out v))
              (None [] 0)))
    (ELlvmIr [_ args _] (ownership-children-list! args out))
    (EIntrinsic [_ _ args] (ownership-children-list! args out))
    (EFieldMeta [_ _ idx] (push! [(ptr Expr)] out idx))
    (EFieldIndex [_ name] (push! [(ptr Expr)] out name))
    (ECodeOp [_ args] (ownership-children-list! args out))
    (EQuasi [q]
            (let [qp (primitive/alloc-stack Quasi)]
              (set! qp q)
              (ownership-quasi-children! qp out)))
    (EComptime [x] (push! [(ptr Expr)] out x))
    (EAscribe [_ x] (push! [(ptr Expr)] out x))
    (EArrayLit [items] (ownership-children-list! items out))
    (ESpillRef [x] (push! [(ptr Expr)] out x))
    (EMovePlace [x] (push! [(ptr Expr)] out x))
    (EMakeSlice [data _ _] (push! [(ptr Expr)] out data))
    (EConstruct [_ _ args] (ownership-children-list! args out))
    (ETraitCall [_ _ _ args] (ownership-children-list! args out))
    (EDynDispatch [dc] (let [recv (.recv dc) args (.args dc)]
                  (do (push! [(ptr Expr)] out recv) (ownership-children-list! args out))))
    (EMakeDyn [_ _ _ x] (push! [(ptr Expr)] out x))
    (ECleanup [body cleanups]
              (do (push! [(ptr Expr)] out body) (ownership-children-list! cleanups out)))
    (EAnonFn [_ body] (ownership-children-list! body out))
    (EStaticArray [_ items] (ownership-children-list! items out))
    (EPattern [_ _ x _] (push! [(ptr Expr)] out x))
    (EVector [_ _ _ args] (ownership-children-list! args out))
    (EDefer [cleanup body]
            (do (push! [(ptr Expr)] out cleanup) (ownership-children-list! body out)))
    (_ 0))
  0)

(defn ownership-children-list! [(xs (ptr (ArrayList Expr))) (out (ptr (ArrayList (ptr Expr))))] (-> i64)
  (for [i 0 (len (load xs))]
    (push! [(ptr Expr)] out (elem xs i)))
  0)

(defn ownership-quasi-children! [(q (ptr Quasi)) (out (ptr (ArrayList (ptr Expr))))] (-> i64)
  (match (load q)
    (QLit [_] 0)
    (QUnquote [e] (push! [(ptr Expr)] out e))
    (QSplice [e] (push! [(ptr Expr)] out e))
    (QList [items]
           (for [i 0 (len (load items))]
             (ownership-quasi-children! (elem items i) out)))
    (QVector [items]
             (for [i 0 (len (load items))]
               (ownership-quasi-children! (elem items i) out))))
  0)

;;; Every variable name `e` mentions, into `names`; and every binding the checker
;;; resolved one of them to, into `bids`.
(defn ownership-collect-vars! [(a (dyn Allocator))
                               (e (ptr Expr))
                               (names (ptr (ArrayList (slice u8))))
                               (bids (ptr (ArrayList i64)))] (-> i64)
  (match (.kind e)
    (EVar [name]
          (do
            (push! [(slice u8)] names name)
            (let [bid (bind-map-lookup (.node-id e))]
              (when (> bid 0) (push! [i64] bids bid) 0))
            0))
    (_ (let [(mut kids) (ArrayList::new [(ptr Expr)] a)]
         (ownership-children! e (mut kids))
         (for [i 0 (len (load kids))]
           (ownership-collect-vars! a (get (load kids) i) names bids))
         0))))

;;; Does a live cleanup refer to `name`, so that a binding of it here would capture it?
(defn ownership-pinned? [(states (ptr (ArrayList MoveState))) (name (slice u8))] (-> bool)
  (block :found
    (for [i 0 (len (load states))]
      (let [st (elem states i)]
        (if (move-state-cleanup? st)
            (for [k 0 (len (load (.pinned st)))]
              (when (= (get (load (.pinned st)) k) name) (break :found true)))
            (when (= (.name st) name) (break :found true)))))
    false))

(defn ownership-shadow-counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

;;; A fresh binding name for `name`, a scoped key no source spelling can produce.
;;; A `.slot` suffix stays a suffix, so a mutable binding's storage and pointer
;;; keep the names that tie them together.
(defn ownership-shadow-name [(a (dyn Allocator)) (prefix (slice u8)) (name (slice u8))] (-> (slice u8))
  (sconcat a prefix name))

(defn ownership-shadow-prefix [(a (dyn Allocator))] (-> (slice u8))
  (let [c (ownership-shadow-counter)]
    (set! c (+ (load c) 1))
    (sconcat3 a "$scopeshadow" (i64->str a (load c)) "@$")))

;;; Rename the free occurrences of `old` in `e` to `new`.
(defn ownership-rename! [(a (dyn Allocator)) (e (ptr Expr)) (old (slice u8)) (new (slice u8))] (-> i64)
  (match (.kind e)
    (EVar [name] (do (when (= name old) (set! (.kind e) (EVar new)) 0) 0))
    (ELet [binds body]
          (unless (ownership-rename-binds! a binds 0 old new)
            (ownership-rename-list! a body old new))
          0)
    (EMatch [scrut arms]
            (do
              (ownership-rename! a scrut old new)
              (for [i 0 (len (load arms))]
                (let [arm (elem arms i)]
                  (unless (ownership-names-contain? (.binds arm) old)
                    (ownership-rename! a (field arm body) old new))
                  0))
              0))
    (EAnonFn [params body]
             (do
               (unless (ownership-names-contain? params old)
                 (ownership-rename-list! a body old new))
               0))
    (_ (let [(mut kids) (ArrayList::new [(ptr Expr)] a)]
         (ownership-children! e (mut kids))
         (for [i 0 (len (load kids))]
           (ownership-rename! a (get (load kids) i) old new))
         0))))

(defn ownership-rename-list! [(a (dyn Allocator)) (xs (ptr (ArrayList Expr))) (old (slice u8)) (new (slice u8))] (-> i64)
  (for [i 0 (len (load xs))]
    (ownership-rename! a (elem xs i) old new))
  0)

;;; Rename `old` in the values of `binds` from `start` on, stopping at a binding
;;; that rebinds it. True when one did, so nothing after it is in scope.
(defn ownership-rename-binds! [(a (dyn Allocator))
                               (binds (ptr (ArrayList Bind)))
                               (start i64)
                               (old (slice u8))
                               (new (slice u8))] (-> bool)
  (block :shadowed
    (for [i start (len (load binds))]
      (let [bp (elem binds i)]
        (ownership-rename! a (field bp value) old new)
        (when (= (.name bp) old) (break :shadowed true))))
    false))

(defn ownership-names-contain? [(names (ptr (ArrayList (slice u8)))) (name (slice u8))] (-> bool)
  (block :found
    (for [i 0 (len (load names))]
      (when (= (get (load names) i) name) (break :found true)))
    false))

;;; Rename binding `i` of a let -- not yet elaborated -- over its scope: the later
;;; bindings' values and the body.
(defn ownership-rename-bind! [(a (dyn Allocator))
                              (binds (ptr (ArrayList Bind)))
                              (body (ptr (ArrayList Expr)))
                              (i i64)
                              (new (slice u8))] (-> i64)
  (let [bp (elem binds i)
        old (.name bp)]
    (set! (.name bp) new)
    (unless (ownership-rename-binds! a binds (+ i 1) old new)
      (ownership-rename-list! a body old new))
    0))

(defn ownership-slot-base [(name (slice u8))] (-> (Option (slice u8)))
  (let [n (len name)]
    (if (and (> n 5) (= (subslice name (- n 5) n) ".slot"))
        (Some (subslice name 0 (- n 5)))
        (None [(slice u8)]))))

;;; Before elaborating binding `i` of a let, rename it if it would shadow a name a
;;; live cleanup refers to. A `(mut x)` binding is the pair `x.slot`, `x`; the pair
;;; is renamed together so its storage and its pointer stay paired.
(defn ownership-unshadow-bind! [(a (dyn Allocator))
                                (binds (ptr (ArrayList Bind)))
                                (body (ptr (ArrayList Expr)))
                                (i i64)
                                (states (ptr (ArrayList MoveState)))] (-> i64)
  (let [name (.name (elem binds i))
        pair (match (ownership-slot-base name)
               (Some [base]
                     (and (< (+ i 1) (len (load binds)))
                          (= (.name (elem binds (+ i 1))) base)))
               (None [] false))]
    (if pair
        (let [base (.name (elem binds (+ i 1)))]
          (when (or (ownership-pinned? states name) (ownership-pinned? states base))
            (let [prefix (ownership-shadow-prefix a)]
              (ownership-rename-bind! a binds body i (ownership-shadow-name a prefix name))
              (ownership-rename-bind! a binds body (+ i 1) (ownership-shadow-name a prefix base)))
            0))
        (when (ownership-pinned? states name)
          (ownership-rename-bind! a binds body i
                                  (ownership-shadow-name a (ownership-shadow-prefix a) name))
          0))
    0))

;;; The same for the names a match arm binds, over the arm's body.
(defn ownership-unshadow-arm! [(a (dyn Allocator)) (arm (ptr Arm)) (states (ptr (ArrayList MoveState)))] (-> i64)
  (let [binds (.binds arm)
        (mut renamed) (ArrayList::new [(slice u8)] a)
        (mut changed) false]
    (for [i 0 (len (load binds))]
      (let [name (get (load binds) i)]
        (if (ownership-pinned? states name)
            (let [new (ownership-shadow-name a (ownership-shadow-prefix a) name)]
              (ownership-rename! a (field arm body) name new)
              (push! (mut renamed) new)
              (set! changed true))
            (push! (mut renamed) name))))
    ; A fresh list: arms copied by value share their binding lists.
    (when (load changed) (set! (.binds arm) (box-al [(slice u8)] a (load renamed))) 0)
    0))

; ---- cleanups placed at exits: copies ------------------------------------------
; Each exit gets its own copy of a defer's cleanup: later passes rewrite nodes in
; place, so one subtree must never sit at two places in the tree.
(defn ownership-clone [(a (dyn Allocator)) (e (ptr Expr))] (-> (ptr Expr))
  (let [out (primitive/alloc-stack Expr)]
    (set! out (load e))
    (set! (.kind out) (ownership-clone-kind a (field e kind)))
    (box-expr a (load out))))

(defn ownership-clone-list [(a (dyn Allocator)) (xs (ptr (ArrayList Expr)))] (-> (ptr (ArrayList Expr)))
  (let [(mut out) (ArrayList::new [Expr] a)]
    (for [i 0 (len (load xs))]
      (push! (mut out) (load (ownership-clone a (elem xs i)))))
    (box-al [Expr] a (load out))))

(defn ownership-clone-quasi [(a (dyn Allocator)) (q (ptr Quasi))] (-> Quasi)
  (match (load q)
    (QLit [form] (QLit form))
    (QUnquote [e] (QUnquote (ownership-clone a e)))
    (QSplice [e] (QSplice (ownership-clone a e)))
    (QList [items] (QList (ownership-clone-quasi-list a items)))
    (QVector [items] (QVector (ownership-clone-quasi-list a items)))))

(defn ownership-clone-quasi-list [(a (dyn Allocator)) (xs (ptr (ArrayList Quasi)))] (-> (ptr (ArrayList Quasi)))
  (let [(mut out) (ArrayList::new [Quasi] a)]
    (for [i 0 (len (load xs))]
      (push! (mut out) (ownership-clone-quasi a (elem xs i))))
    (box-al [Quasi] a (load out))))

(defn ownership-clone-opt [(a (dyn Allocator)) (e (ptr Expr))] (-> (ptr Expr))
  (if (= (primitive/cast i64 e) 0) e (ownership-clone a e)))

(defn ownership-clone-kind [(a (dyn Allocator)) (k (ptr ExprKind))] (-> ExprKind)
  (match (load k)
    (EInt [v] (EInt v))
    (EWideInt [neg lo hi radix text] (EWideInt neg lo hi radix text))
    (EStr [v] (EStr v))
    (ECStr [v] (ECStr v))
    (EVar [n] (EVar n))
    (EZeroed [t] (EZeroed t))
    (EBorrow [m p] (EBorrow m (ownership-clone a p)))
    (ELet [binds body]
          (let [(mut nb) (ArrayList::new [Bind] a)]
            (for [i 0 (len (load binds))]
              (let [b (primitive/alloc-stack Bind)]
                (set! b (load (elem binds i)))
                (set! (.value b) (load (ownership-clone a (field (elem binds i) value))))
                (push! (mut nb) (load b))))
            (ELet (box-al [Bind] a (load nb)) (ownership-clone-list a body))))
    (EBin [op l r] (EBin op (ownership-clone a l) (ownership-clone a r)))
    (EIntUnary [op x] (EIntUnary op (ownership-clone a x)))
    (EFloat [v] (EFloat v))
    (EBool [v] (EBool v))
    (ECmp [op l r] (ECmp op (ownership-clone a l) (ownership-clone a r)))
    (EIf [c t f] (EIf (ownership-clone a c) (ownership-clone a t) (ownership-clone a f)))
    (EDo [body] (EDo (ownership-clone-list a body)))
    (ECall [f ts args] (ECall f ts (ownership-clone-list a args)))
    (ENamedCall [f ts ns args] (ENamedCall f ts ns (ownership-clone-list a args)))
    (EAlloc [st t init sym] (EAlloc st t (ownership-clone-opt a init) sym))
    (EField [p n] (EField (ownership-clone a p) n))
    (EAccessorField [p n] (EAccessorField (ownership-clone a p) n))
    (ELoad [x] (ELoad (ownership-clone a x)))
    (EStore [p v] (EStore (ownership-clone a p) (ownership-clone a v)))
    (EInitStore [p v] (EInitStore (ownership-clone a p) (ownership-clone a v)))
    (EIndex [p i] (EIndex (ownership-clone a p) (ownership-clone a i)))
    (ECast [t x] (ECast t (ownership-clone a x)))
    (ESizeOf [t] (ESizeOf t))
    (EAlignOf [t] (EAlignOf t))
    (EOffsetOf [t n] (EOffsetOf t n))
    (EBitGet [p n] (EBitGet (ownership-clone a p) n))
    (EBitSet [p n v] (EBitSet (ownership-clone a p) n (ownership-clone a v)))
    (EFree [x] (EFree (ownership-clone a x)))
    (EErase [n x] (EErase n (ownership-clone a x)))
    (EMatch [scrut arms]
            (let [(mut na) (ArrayList::new [Arm] a)]
              (for [i 0 (len (load arms))]
                (let [arm (primitive/alloc-stack Arm)]
                  (set! arm (load (elem arms i)))
                  (set! (.body arm) (load (ownership-clone a (field (elem arms i) body))))
                  (push! (mut na) (load arm))))
              (EMatch (ownership-clone a scrut) (box-al [Arm] a (load na)))))
    (EFnPtrOf [n] (EFnPtrOf n))
    (EFnPtrInst [n ts] (EFnPtrInst n ts))
    (ECallPtr [fp args] (ECallPtr (ownership-clone a fp) (ownership-clone-list a args)))
    (ELoop [l body] (ELoop l (ownership-clone-list a body)))
    (EBreak [l v]
            (EBreak l
                    (match v
                      (Some [x] (Some (ownership-clone a x)))
                      (None [] (None [(ptr Expr)])))))
    (EContinue [l] (EContinue l))
    (ELlvmIr [t args body] (ELlvmIr t (ownership-clone-list a args) body))
    (EIntrinsic [op t args] (EIntrinsic op t (ownership-clone-list a args)))
    (ETypeQuery [q t] (ETypeQuery q t))
    (EFieldMeta [m t idx] (EFieldMeta m t (ownership-clone a idx)))
    (EFieldIndex [t n] (EFieldIndex t (ownership-clone a n)))
    (EQuote [f] (EQuote f))
    (ECodeOp [op args] (ECodeOp op (ownership-clone-list a args)))
    (EQuasi [q]
            (let [qp (primitive/alloc-stack Quasi)]
              (set! qp q)
              (EQuasi (ownership-clone-quasi a qp))))
    (EComptime [x] (EComptime (ownership-clone a x)))
    (EAscribe [t x] (EAscribe t (ownership-clone a x)))
    (EArrayLit [items] (EArrayLit (ownership-clone-list a items)))
    (ESpillRef [x] (ESpillRef (ownership-clone a x)))
    (EMovePlace [x] (EMovePlace (ownership-clone a x)))
    (EMakeSlice [data elem n] (EMakeSlice (ownership-clone a data) elem n))
    (EConstruct [sum variant args] (EConstruct sum variant (ownership-clone-list a args)))
    (ETraitCall [tr m self args] (ETraitCall tr m self (ownership-clone-list a args)))
    (EDynDispatch [dc] (let [ds (.dyn_struct dc) vs (.vtable_struct dc) idx (.method_index dc) cc (.cc dc) ps (.params dc) ret (.ret dc) recv (.recv dc) args (.args dc)]
                  (EDynDispatch (box! a DynCall (DynCall :dyn_struct ds :vtable_struct vs :method_index idx :cc cc :params ps :ret ret :recv (ownership-clone a recv) :args (ownership-clone-list a args))))))
    (EMakeDyn [ds vs ms x] (EMakeDyn ds vs ms (ownership-clone a x)))
    (ECleanup [body cleanups] (ECleanup (ownership-clone a body) (ownership-clone-list a cleanups)))
    (EStaticRef [n] (EStaticRef n))
    (EAnonFn [ps body] (EAnonFn ps (ownership-clone-list a body)))
    (EStaticArray [indices items] (EStaticArray indices (ownership-clone-list a items)))
    (EPattern [op t x idx] (EPattern op t (ownership-clone a x) idx))
    (EVector [op t ts args] (EVector op t ts (ownership-clone-list a args)))
    (EConstParam [n t] (EConstParam n t))
    (ERecordInit [t] (ERecordInit t))
    (EDefer [cleanup body] (EDefer (ownership-clone a cleanup) (ownership-clone-list a body)))
    (EBracketCall [f ts xs v]
                  (EBracketCall :func f :type_args ts :args (ownership-clone-list a xs) :vector (ownership-clone a v)))))

;;; A defer's cleanup runs at this exit: every owner it reads must still be live.
(defn ownership-require-cleanup-live [(a (dyn Allocator))
                                      (st (ptr MoveState))
                                      (states (ptr (ArrayList MoveState)))
                                      (fname (slice u8))] (-> (Result i64 Diag))
  (let [uses (.uses st)
        (mut moved) (primitive/cast (ptr MoveState) 0)]
    (for [k 0 (len (load uses))]
      (let [owner (move-state-find states (get (load uses) k))]
        (when (and (!= (primitive/cast i64 owner) 0)
                   (.moved owner))
          (set! moved owner)
          0)))
    (if (= (primitive/cast i64 (load moved)) 0)
        (Ok [i64 Diag] 0)
        (Err [i64 Diag]
             (derr-at-src (.source st)
                          (.lo st)
                          (.hi st)
                          (sconcat4 a
                                    (sconcat3 a "in '" fname "': this (defer …) cleanup reads '")
                                    (.name (load moved))
                                    "', which is moved before control leaves the forms it guards"
                                    ""))))))

;;; The cleanups an exit to depth `start` runs: drops and defer cleanups, innermost
;;; first.
(defn ownership-cleanups [(a (dyn Allocator))
                          (cx (ptr Cx))
                          (states (ptr (ArrayList MoveState)))
                          (start i64)
                          (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [(mut out) (ArrayList::new [Expr] a)
        (mut i) (primitive/isub (len (load states)) 1)
        (mut err) (None [Diag])]
    (loop (if (< (load i) start)
              (break)
              (do
                (let [st (elem states (load i))]
                  (if (move-state-cleanup? st)
                    (match (ownership-require-cleanup-live a st states fname)
                      (Err [d] (do (set! err (Some d)) (break)))
                      (Ok [_] (push! (mut out) (load (ownership-clone a (.cleanup st))))))
                  (unless (or (.moved st)
                              (not (type-needs-drop a cx (.ty st))))
                    (let [place
                            (box-expr a
                                      (mk-expr (EVar (.name st))
                                               (.lo st)
                                               (.hi st)
                                               (.source st)
                                               (.ctxt st)))]
                      (ownership-append-drop-glue! a
                                                   cx
                                                   (mut out)
                                                   place
                                                   (.ty st)
                                                   (.lo st)
                                                   (.hi st)
                                                   (.source st)
                                                   (.ctxt st))
                      0)
                    0)))
                (set! i (primitive/isub (load i) 1)))))
    (match (load err)
      (Some [d] (Err [(ptr (ArrayList Expr)) Diag] d))
      (None [] (Ok (box-al [Expr] a (load out)))))))

(defn ownership-expr-exits? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EBreak [_ _] true)
    (EContinue [_] true)
    (EDo [body]
         (let [tail (al-last-expr body)]
           (and (!= (primitive/cast i64 tail) 0)
                (ownership-expr-exits? tail))))
    (ECleanup [body _] (ownership-expr-exits? body))
    (EDefer [_ body]
            (let [tail (al-last-expr body)]
              (and (!= (primitive/cast i64 tail) 0)
                   (ownership-expr-exits? tail))))
    (EIf [_ thn els]
         (and (ownership-expr-exits? thn) (ownership-expr-exits? els)))
    (_ false)))

(defn ownership-wrap-tail-cleanup! [(a (dyn Allocator))
                                    (body (ptr (ArrayList Expr)))
                                    (cleanups (ptr (ArrayList Expr)))
                                    (lo i64)
                                    (hi i64)
                                    (source i64)
                                    (ctxt i64)] (-> i64)
  (when (> (len (load cleanups)) 0)
    (let [n (len (load body))]
      (if (= n 0)
          (let [(mut empty) (ArrayList::new [Expr] a)]
            (push! [Expr]
                   body
                   (mk-expr (ECleanup :body
                                        (box-expr a
                                                  (mk-expr (EDo (box-al [Expr]
                                                                        a
                                                                        (load empty)))
                                                           lo
                                                           hi
                                                           source
                                                           ctxt))
                              :cleanups cleanups)
                            lo
                            hi
                            source
                            ctxt)))
          (let [tail (elem body (primitive/isub n 1))]
            (unless (ownership-expr-exits? tail)
              (let [saved (box-expr a (load tail))]
                (set! (.kind tail) (ECleanup saved cleanups)))
              0))))
    0)
  0)

(defn ownership-loop-owner-depth [(loops (ptr (ArrayList OwnershipLoop)))
                                  (label (Option (slice u8)))] (-> i64)
  (let [(mut i) (primitive/isub (len (load loops)) 1)
        (mut found) -1]
    (loop (if (< (load i) 0)
              (break)
              (let [lp (elem loops (load i))]
                (if (match label
                      (None [] true)
                      (Some [want]
                            (match (.label lp)
                              (Some [have] (= want have))
                              (None [] false))))
                    (do (set! found (.owner_depth lp)) (break))
                    (set! i (primitive/isub (load i) 1))))))
    (load found)))

(defn ownership-wrap-exit! [(a (dyn Allocator))
                            (cx (ptr Cx))
                            (e (ptr Expr))
                            (states (ptr (ArrayList MoveState)))
                            (depth i64)
                            (fname (slice u8))] (-> (Result i64 Diag))
  (try (let [cleanups (try! (ownership-cleanups a cx states depth fname))]
    (when (> (len (load cleanups)) 0)
      (match (.kind e)
        (EBreak [label value]
                (match value
                  (Some [v]
                        (let [saved (box-expr a (load v))]
                          (set! (.kind v) (ECleanup saved cleanups))))
                  (None []
                        (let [(mut seq) (ArrayList::new [Expr] a)
                              saved (load e)]
                          (for [i 0 (len (load cleanups))]
                            (push! (mut seq) (get (load cleanups) i))
                            0)
                          (push! (mut seq) saved)
                          (set! (.kind e) (EDo (box-al [Expr] a (load seq))))))))
        (EContinue [_]
                   (let [(mut seq) (ArrayList::new [Expr] a)
                         saved (load e)]
                     (for [i 0 (len (load cleanups))]
                       (push! (mut seq) (get (load cleanups) i))
                       0)
                     (push! (mut seq) saved)
                     (set! (.kind e) (EDo (box-al [Expr] a (load seq))))))
        (_ 0))
      0)
    (Ok [i64 Diag] 0))))

(defn ownership-walk-list [(a (dyn Allocator))
                           (cx (ptr Cx))
                           (items (ptr (ArrayList Expr)))
                           (states (ptr (ArrayList MoveState)))
                           (loops (ptr (ArrayList OwnershipLoop)))
                           (fname (slice u8))
                           (tail-consumes bool)] (-> (Result i64 Diag))
  (try (let [n (len (load items))
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (try! (ownership-walk-expr a
                                                cx
                                                (elem items (load i))
                                                states
                                                loops
                                                fname
                                                (and tail-consumes
                                                     (= (primitive/iadd (load i)
                                                                        1)
                                                        n))))
                     (store! i (primitive/iadd (load i) 1)))))
         (Ok [i64 Diag] 0))))

;;; A call through a function pointer passes its arguments as the pointer's type
;;; says, so an owner it takes by value moves into the call, as it does into a
;;; direct call: the function at the other end (or its by-value C entry) owns it.
(defn ownership-walk-callptr-args [(a (dyn Allocator))
                                   (cx (ptr Cx))
                                   (fp (ptr Expr))
                                   (args (ptr (ArrayList Expr)))
                                   (states (ptr (ArrayList MoveState)))
                                   (loops (ptr (ArrayList OwnershipLoop)))
                                   (fname (slice u8))] (-> (Result i64 Diag))
  (try (let [params
               (match (ownership-expr-type a cx fp)
                 (Some [t]
                       (match t
                         (TFn [_ ps _] ps)
                         (_ (primitive/cast (ptr (ArrayList Type)) 0))))
                 (None [] (primitive/cast (ptr (ArrayList Type)) 0)))
             np (if (= (primitive/cast i64 params) 0)
                    0
                    (len (load params)))]
         (for [i 0 (len (load args))]
           (try! (ownership-walk-expr a
                                      cx
                                      (elem args i)
                                      states
                                      loops
                                      fname
                                      (and (< i np)
                                           (type-is-affine a cx (elem params i))))))
         (Ok [i64 Diag] 0))))

(defn ownership-walk-all [(a (dyn Allocator))
                          (cx (ptr Cx))
                          (items (ptr (ArrayList Expr)))
                          (states (ptr (ArrayList MoveState)))
                          (loops (ptr (ArrayList OwnershipLoop)))
                          (fname (slice u8))
                          (consumes bool)] (-> (Result i64 Diag))
  (try (let [n (len (load items))
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (try! (ownership-walk-expr a
                                                cx
                                                (elem items (load i))
                                                states
                                                loops
                                                fname
                                                consumes))
                     (set! i (primitive/iadd (load i) 1)))))
         (Ok [i64 Diag] 0))))

(defn ownership-walk-construct-args [(a (dyn Allocator))
                                     (cx (ptr Cx))
                                     (items (ptr (ArrayList Expr)))
                                     (states (ptr (ArrayList MoveState)))
                                     (loops (ptr (ArrayList OwnershipLoop)))
                                     (fname (slice u8))] (-> (Result i64 Diag))
  (try (let [n (len (load items))
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (let [arg (elem items (load i))]
                       (try! (ownership-walk-expr a
                                                  cx
                                                  arg
                                                  states
                                                  loops
                                                  fname
                                                  true))
                       ; A generic value parameter materialized after mono is a
                       ; place, while a constructor field always receives the
                       ; value stored in that place.
                       (match (.kind arg)
                         (EVar [_]
                               (when (!= (primitive/cast i64
                                                         (ownership-root-state arg
                                                                               states))
                                         0)
                                 (let [saved (box-expr a (load arg))]
                                   (set! (.kind arg) (ELoad saved))
                                   0)))
                         (_ 0)))
                     (set! i (primitive/iadd (load i) 1)))))
         (Ok [i64 Diag] 0))))

(defn ownership-walk-branches [(a (dyn Allocator))
                               (cx (ptr Cx))
                               (left (ptr Expr))
                               (right (ptr Expr))
                               (states (ptr (ArrayList MoveState)))
                               (loops (ptr (ArrayList OwnershipLoop)))
                               (fname (slice u8))
                               (consumes bool)] (-> (Result i64 Diag))
  (try (let [ls (move-states-clone states)
             rs (move-states-clone states)]
         (try! (ownership-walk-expr a cx left ls loops fname consumes))
         (try! (ownership-walk-expr a cx right rs loops fname consumes))
         (try! (ownership-require-same-states a ls rs fname "between branches"))
         (move-states-merge! states ls)
         (Ok [i64 Diag] 0))))

;;; The callee's parameter types at this call: its generic parameters replaced by
;;; the call's type arguments. Whether an argument moves is a question about the
;;; instance — `(Option T)` called at `T = Box` takes an owner, at `T = i64` does
;;; not — and the callee's instance decides ownership from the same concrete type.
(defn ownership-call-param-types [(a (dyn Allocator))
                                  (params (ptr (ArrayList Type)))
                                  (tparams (ptr (ArrayList (slice u8))))
                                  (targs (ptr (ArrayList Type)))] (-> (ptr (ArrayList Type)))
  (if (or (= (primitive/cast i64 params) 0)
          (= (primitive/cast i64 tparams) 0)
          (= (primitive/cast i64 targs) 0)
          (= (len (load tparams)) 0)
          (!= (len (load tparams)) (len (load targs))))
      params
      (let [subst (subst-new a)]
        (for [i 0 (len (load tparams))]
          (subst-insert! subst (get (load tparams) i) (elem targs i)))
        (subst-apply-list a params subst))))

(defn ownership-walk-call-args [(a (dyn Allocator))
                                (cx (ptr Cx))
                                (func (slice u8))
                                (targs (ptr (ArrayList Type)))
                                (args (ptr (ArrayList Expr)))
                                (states (ptr (ArrayList MoveState)))
                                (loops (ptr (ArrayList OwnershipLoop)))
                                (fname (slice u8))] (-> (Result i64 Diag))
  (try (let [sig (sig-find cx func)
             variant-entry (vts-find cx func)
             params
               (if (= (primitive/cast i64 sig) 0)
                   (if (= (primitive/cast i64 variant-entry)
                          0)
                       (primitive/cast (ptr (ArrayList Type)) 0)
                       (let [sum (sum-find cx (.sum variant-entry))]
                         (ownership-call-param-types a
                                                     (field-types-of a (variant-in-sum sum func))
                                                     (.type_params sum)
                                                     targs)))
                   (ownership-call-param-types a
                                               (load (field sig params))
                                               (load (field sig type_params))
                                               targs))
             np
               (if (= (primitive/cast i64 params) 0)
                   0
                   (len (load params)))
             n (len (load args))
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (let [arg (elem args (load i))
                           consume
                             (and (< (load i) np)
                                  (type-is-affine a
                                                  cx
                                                  (elem params
                                                        (load i))))]
                       (if (and (= (load i) 0)
                                (or (core-name? func "take!")
                                    (core-name-prefix? func "take!__")))
                           (match (.kind arg)
                             (EBorrow [_ place]
                                      (do
                                        (try! (ownership-walk-expr a
                                                                   cx
                                                                   place
                                                                   states
                                                                   loops
                                                                   fname
                                                                   false))
                                        (try! (ownership-require-whole-take a
                                                                            cx
                                                                            place
                                                                            states
                                                                            fname))
                                        (try! (ownership-consume-root! a
                                                                       place
                                                                       states
                                                                       fname))
                                        0))
                             (_ (do
                                  (try! (ownership-walk-expr a
                                                             cx
                                                             arg
                                                             states
                                                             loops
                                                             fname
                                                             false))
                                  (try! (ownership-require-whole-take a
                                                                      cx
                                                                      arg
                                                                      states
                                                                      fname))
                                  (try! (ownership-consume-root! a
                                                                 arg
                                                                 states
                                                                 fname))
                                  0)))
                           (try! (ownership-walk-expr a
                                                      cx
                                                      arg
                                                      states
                                                      loops
                                                      fname
                                                      consume)))
                       ; Preserve an explicit distinction between a consumed place
                       ; and an aggregate value. Mono resolves this marker against
                       ; the callee's actual ABI after generic substitution.
                       (when (and consume
                                  (< (load i) np)
                                  (type-needs-drop a
                                                   cx
                                                   (elem params
                                                         (load i))))
                         (match (.kind arg)
                           (ELoad [place]
                                  (when (!= (primitive/cast i64
                                                            (ownership-root-var place))
                                            0)
                                    (set! (.kind arg)
                                          (EMovePlace (box-expr a (load place))))
                                    0))
                           (ESpillRef [_] 0)
                           (_ (if (!= (primitive/cast i64
                                                      (ownership-root-state arg
                                                                            states))
                                      0)
                                  ; A direct affine parameter/local or one of its
                                  ; projections is already a place. Keep that fact
                                  ; explicit until mono selects the callee ABI.
                                  (let [saved (box-expr a (load arg))]
                                    (set! (.kind arg) (EMovePlace saved))
                                    0)
                                  ; Calls are type-checked before ownership lowering
                                  ; changes affine value parameters to their pointer
                                  ; ABI. Preserve a true rvalue in a frame temporary
                                  ; so the callee receives an owning place.
                                  (let [saved (box-expr a (load arg))]
                                    (set! (.kind arg) (ESpillRef saved))
                                    0))))
                         0))
                     (store! i (primitive/iadd (load i) 1)))))
         (Ok [i64 Diag] 0))))

; A ref/mut argument synthesized from an owning rvalue is represented as
; `ESpillRef(rvalue)`. The spill gives codegen an address, but by itself has no
; lexical owner and therefore no Drop cleanup. Materialize the same owned-place
; pair used by checked `let` bindings around the complete call expression. The
; call result is preserved by ECleanup while the temporary is destroyed after
; the borrow ends.
(defn ownership-bind-owned-spill! [(a (dyn Allocator))
                                   (cx (ptr Cx))
                                   (anchor (ptr Expr))
                                   (arg (ptr Expr))
                                   (index i64)
                                   (binds (ptr (ArrayList Bind)))
                                   (states (ptr (ArrayList MoveState)))] (-> bool)
  (match (.kind arg)
    (ESpillRef [inner]
               (if (or (!= (primitive/cast i64 (ownership-root-state inner states))
                           0)
                       (not (ownership-expr-needs-drop a cx inner)))
                   false
                   (match (ownership-expr-type a cx inner)
                     (None [] false)
                     (Some [owner-type]
                           (let [name
                                   (sconcat a
                                            (sconcat a
                                                     "$borrow.temp."
                                                     (i64->str a (.node-id anchor)))
                                            (sconcat a "." (i64->str a index)))
                                 slot (sconcat a name ".slot")
                                 bid (next-bid)
                                 ownerp (box-type a owner-type)
                                 (mut init) (ArrayList::new [Expr] a)]
                             (push! [Bind]
                                    binds
                                    (mk-bind slot
                                             false
                                             (mk-expr (EAlloc
                                                        :symbol (None)
                                                        :storage 3
                                                        :ty owner-type
                                                        :init
                                                          (primitive/cast (ptr Expr) 0))
                                                      (.lo arg)
                                                      (.hi arg)
                                                      (.source arg)
                                                      (.ctxt arg))))
                             (push! [Expr]
                                    (mut init)
                                    (mk-expr (EStore (box-expr a
                                                               (mk-expr (EVar slot)
                                                                        (.lo arg)
                                                                        (.hi arg)
                                                                        (.source arg)
                                                                        (.ctxt arg)))
                                                     (box-expr a (load inner)))
                                             (.lo arg)
                                             (.hi arg)
                                             (.source arg)
                                             (.ctxt arg)))
                             (push! [Expr]
                                    (mut init)
                                    (mk-expr (EVar slot)
                                             (.lo arg)
                                             (.hi arg)
                                             (.source arg)
                                             (.ctxt arg)))
                             (let [owner (primitive/alloc-stack Bind)]
                               (set! owner
                                     (mk-bind name
                                              false
                                              (mk-expr (EDo (box-al [Expr]
                                                                    a
                                                                    (load init)))
                                                       (.lo arg)
                                                       (.hi arg)
                                                       (.source arg)
                                                       (.ctxt arg))))
                               (set! (.bid owner) bid)
                               (set! (.owned_type owner) ownerp)
                               (push! [Bind] binds (load owner)))
                             (set! (.kind arg) (EVar name))
                             true)))))
    (_ false)))

; Wrap `e` in the let that owns the temporaries `binds` introduced, so each is
; destroyed once `e` has finished with it.
(defn ownership-wrap-in-binds! [(a (dyn Allocator))
                                (e (ptr Expr))
                                (binds (ptr (ArrayList Bind)))] (-> i64)
  (let [(mut body) (ArrayList::new [Expr] a)
        saved (load e)]
    (push! [Expr] (mut body) saved)
    (set! (.kind e)
          (ELet (box-al [Bind] a (load binds))
                (box-al [Expr] a (load body))))
    0))

(defn ownership-wrap-borrowed-rvalues! [(a (dyn Allocator))
                                        (cx (ptr Cx))
                                        (call (ptr Expr))
                                        (args (ptr (ArrayList Expr)))
                                        (states (ptr (ArrayList MoveState)))] (-> bool)
  (let [(mut binds) (ArrayList::new [Bind] a)
        (mut changed) false]
    (for [i 0 (len (load args))]
      (when (ownership-bind-owned-spill! a cx call (elem args i) i (mut binds) states)
        (set! changed true)
        0))
    (when (load changed)
      (ownership-wrap-in-binds! a call (mut binds)))
    (load changed)))

; The spilled struct value under a `.field` read, if any: `(.x (.origin (f)))`
; checks to loads and field projections over `ESpillRef(f)`.
(defn ownership-field-read-spill [(e (ptr Expr))] (-> (ptr Expr))
  (match (.kind e)
    (EField [p _] (ownership-field-read-spill p))
    (ELoad [inner] (ownership-field-read-spill inner))
    (ESpillRef [_] e)
    (_ (primitive/cast (ptr Expr) 0))))

; A field read from an owning temporary gives the temporary a lexical owner, the
; same pair a borrowed call argument gets, so it is destroyed after the read.
(defn ownership-wrap-field-read-temporary! [(a (dyn Allocator))
                                            (cx (ptr Cx))
                                            (e (ptr Expr))
                                            (states (ptr (ArrayList MoveState)))] (-> bool)
  (let [spill (ownership-field-read-spill e)]
    (if (= (primitive/cast i64 spill) 0)
        false
        (let [(mut binds) (ArrayList::new [Bind] a)]
          (if (ownership-bind-owned-spill! a cx e spill 0 (mut binds) states)
              (do (ownership-wrap-in-binds! a e (mut binds)) true)
              false)))))

; Replace the value in an initialized owning place: evaluate both operands once
; and in source order, run the old value's drop glue, then store. The replacement
; spill keeps the new value alive while the old value's glue runs.
(defn ownership-overwrite-drop! [(a (dyn Allocator))
                                 (cx (ptr Cx))
                                 (e (ptr Expr))
                                 (p (ptr Expr))
                                 (value (ptr Expr))
                                 (target-type Type)] (-> i64)
  (let [targetp (primitive/alloc-stack Type)]
    (set! targetp target-type)
    (if (not (type-needs-drop a cx targetp))
        0
        (let [place-name (sconcat a "$overwrite.place." (i64->str a (.node-id e)))
              value-name (sconcat a "$overwrite.value." (i64->str a (.node-id e)))
              (mut binds) (ArrayList::new [Bind] a)
              (mut body) (ArrayList::new [Expr] a)
              place-var
                (box-expr a
                          (mk-expr (EVar place-name)
                                   (.lo e)
                                   (.hi e)
                                   (.source e)
                                   (.ctxt e)))
              value-var
                (box-expr a
                          (mk-expr (EVar value-name)
                                   (.lo e)
                                   (.hi e)
                                   (.source e)
                                   (.ctxt e)))]
          (push! (mut binds) (mk-bind place-name false (load p)))
          (push! (mut binds)
                 (mk-bind value-name
                          false
                          (mk-expr (ESpillRef (box-expr a (load value)))
                                   (.lo e)
                                   (.hi e)
                                   (.source e)
                                   (.ctxt e))))
          (ownership-append-drop-glue! a
                                       cx
                                       (mut body)
                                       place-var
                                       targetp
                                       (.lo e)
                                       (.hi e)
                                       (.source e)
                                       (.ctxt e))
          (push! (mut body)
                 (mk-expr (EStore place-var
                                  (box-expr a
                                            (mk-expr (ELoad value-var)
                                                     (.lo e)
                                                     (.hi e)
                                                     (.source e)
                                                     (.ctxt e))))
                          (.lo e)
                          (.hi e)
                          (.source e)
                          (.ctxt e)))
          (set! (.kind e)
                (ELet (box-al [Bind] a (load binds))
                      (box-al [Expr] a (load body))))
          0))))

; The pointee type of a store target reached through a MUTABLE REFERENCE, such as
; a `(mut T)` parameter, a `(mut …)` alias, or a mutably borrowed match payload.
; A mutable borrow always denotes an initialized value, so a store through it is a
; replacement exactly as it is for the owner itself. A raw `(ptr T)` is not a
; borrow: it may address uninitialized storage that the store initializes (an
; allocator block, an element slot past a collection's length), so it stays
; unmanaged and yields (None) here.
(defn ownership-mut-borrow-place-type [(a (dyn Allocator))
                                       (cx (ptr Cx))
                                       (p (ptr Expr))] (-> (Option Type))
  (let [root (ownership-place-root-var p)]
    (if (= (primitive/cast i64 root) 0)
        (None [Type])
        (match (ownership-node-type a cx (.node-id root))
          (Some [root-type]
                (match root-type
                  (TRef [mutable pointee]
                        (if mutable
                            (ownership-place-type a cx p pointee)
                            (None [Type])))
                  (_ (None [Type]))))
          (None [] (None [Type]))))))

; A statement's value that nothing receives is discarded. When that value is a
; FRESH owner — the result of a call or a constructor, which no place holds — it
; must be dropped at the end of the statement, as `(let [_ value] …)` would.
; Rewrite such a result into the owned-place pair `let` bindings use: the value is
; stored into a frame slot registered as an owner, the slot is read back so the
; expression keeps its type (it may be one branch of an `if`), and ordinary scope
; cleanup drops it. Only fresh values qualify. Reading an existing place (a
; variable, a field, an element) is not a move, so the place keeps its value and
; its own cleanup. References, raw pointers and Copy values own nothing. The walk
; follows every position whose value is the discarded one: the tail of a `do` or
; `let`, both branches of an `if`, every `match` arm.
(defn ownership-discard-result! [(a (dyn Allocator))
                                 (cx (ptr Cx))
                                 (e (ptr Expr))] (-> i64)
  (match (.kind e)
    (EDo [items]
         (if (> (len (load items)) 0)
             (ownership-discard-result! a
                                        cx
                                        (elem items
                                              (primitive/isub (len (load items)) 1)))
             0))
    (ELet [_ body]
          (if (> (len (load body)) 0)
              (ownership-discard-result! a
                                         cx
                                         (elem body
                                               (primitive/isub (len (load body)) 1)))
              0))
    (EDefer [_ body]
            (if (> (len (load body)) 0)
                (ownership-discard-result! a
                                           cx
                                           (elem body
                                                 (primitive/isub (len (load body)) 1)))
                0))
    (EIf [_ thn els]
         (do
           (ownership-discard-result! a cx thn)
           (ownership-discard-result! a cx els)))
    (EMatch [_ arms]
            (do
              (for [i 0 (len (load arms))]
                (ownership-discard-result! a cx (field (elem arms i) body)))
              0))
    (EAscribe [_ inner] (ownership-discard-result! a cx inner))
    (ECall [_ _ _] (ownership-discard-fresh-owner! a cx e))
    (ECallPtr [_ _] (ownership-discard-fresh-owner! a cx e))
    (ETraitCall [_ _ _ _] (ownership-discard-fresh-owner! a cx e))
    (EDynDispatch [_] (ownership-discard-fresh-owner! a cx e))
    (EConstruct [_ _ _] (ownership-discard-fresh-owner! a cx e))
    (_ 0)))

(defn ownership-discard-fresh-owner! [(a (dyn Allocator))
                                      (cx (ptr Cx))
                                      (e (ptr Expr))] (-> i64)
  (match (ownership-expr-type a cx e)
    (None [] 0)
    (Some [owner-type]
          (let [ownerp (box-type a owner-type)]
            (if (not (type-needs-drop a cx ownerp))
                0
                (let [name (sconcat a "$discard." (i64->str a (next-bid)))
                      slot (sconcat a name ".slot")
                      value (box-expr a (load e))
                      (mut init) (ArrayList::new [Expr] a)
                      (mut binds) (ArrayList::new [Bind] a)
                      (mut body) (ArrayList::new [Expr] a)
                      owner (primitive/alloc-stack Bind)]
                  (push! (mut binds)
                         (mk-bind slot
                                  false
                                  (mk-expr (EAlloc
                                             :symbol (None)
                                             :storage 3
                                             :ty owner-type
                                             :init (primitive/cast (ptr Expr) 0))
                                           (.lo e)
                                           (.hi e)
                                           (.source e)
                                           (.ctxt e))))
                  (push! (mut init)
                         (mk-expr (EInitStore (box-expr a
                                                        (mk-expr (EVar slot)
                                                                 (.lo e)
                                                                 (.hi e)
                                                                 (.source e)
                                                                 (.ctxt e)))
                                              value)
                                  (.lo e)
                                  (.hi e)
                                  (.source e)
                                  (.ctxt e)))
                  (push! (mut init)
                         (mk-expr (EVar slot) (.lo e) (.hi e) (.source e) (.ctxt e)))
                  (set! owner
                        (mk-bind name
                                 false
                                 (mk-expr (EDo (box-al [Expr] a (load init)))
                                          (.lo e)
                                          (.hi e)
                                          (.source e)
                                          (.ctxt e))))
                  (set! (.bid owner) (next-bid))
                  (set! (.owned_type owner) ownerp)
                  (push! (mut binds) (load owner))
                  (push! (mut body)
                         (mk-expr (ELoad (box-expr a
                                                   (mk-expr (EVar name)
                                                            (.lo e)
                                                            (.hi e)
                                                            (.source e)
                                                            (.ctxt e))))
                                  (.lo e)
                                  (.hi e)
                                  (.source e)
                                  (.ctxt e)))
                  (set! (.kind e)
                        (ELet (box-al [Bind] a (load binds))
                              (box-al [Expr] a (load body))))
                  0))))))

; Walk a statement sequence (a function or `let` body, a `do`, a loop body).
; Every item but the tail is a discarded statement; the tail is too when
; `tail-discarded` (a loop body's value is thrown away each iteration).
(defn ownership-walk-body [(a (dyn Allocator))
                           (cx (ptr Cx))
                           (items (ptr (ArrayList Expr)))
                           (states (ptr (ArrayList MoveState)))
                           (loops (ptr (ArrayList OwnershipLoop)))
                           (fname (slice u8))
                           (tail-consumes bool)
                           (tail-discarded bool)] (-> (Result i64 Diag))
  (let [n (len (load items))]
    (for [i 0 n]
      (when (or tail-discarded (< (primitive/iadd i 1) n))
        (ownership-discard-result! a cx (elem items i))
        0))
    (ownership-walk-list a cx items states loops fname tail-consumes)))

; Ownership is tracked per binding, so an owner can move only as a whole binding
; or as an rvalue. Loading one out of a reference, or out of a field or element of
; an owner, would leave the real owner running its drop glue over the moved value:
; a double drop, and a use after drop when the moved copy is still live. A match
; on a named value binds its payload by reference, so this is also what rejects
; moving a payload out of `(match r (Ok [v] v) …)`. `take!` is the sanctioned move
; out of a mutable binding (not out of part of one: see
; `ownership-require-whole-take`), and raw pointers never own their pointees.
; Would the root owner's drop glue destroy what `place` holds? Only if every
; enclosing part on the way down has glue of its own: a `ManuallyDrop` never drops
; its field, so moving that field out is exactly what it is for.
(defn ownership-glue-reaches? [(a (dyn Allocator))
                               (cx (ptr Cx))
                               (place (ptr Expr))
                               (root-type (ptr Type))] (-> bool)
  (match (.kind place)
    (EField [base _] (ownership-glue-covers? a cx base root-type))
    (EIndex [base _] (ownership-glue-covers? a cx base root-type))
    (ELoad [inner] (ownership-glue-reaches? a cx inner root-type))
    (ESpillRef [inner] (ownership-glue-reaches? a cx inner root-type))
    (EMovePlace [inner] (ownership-glue-reaches? a cx inner root-type))
    (_ true)))

(defn ownership-glue-covers? [(a (dyn Allocator))
                              (cx (ptr Cx))
                              (place (ptr Expr))
                              (root-type (ptr Type))] (-> bool)
  (and (match (ownership-place-type a cx place root-type)
         (Some [t]
               (let [tp (primitive/alloc-stack Type)]
                 (set! tp t)
                 (type-needs-drop a cx tp)))
         (None [] true))
       (ownership-glue-reaches? a cx place root-type)))

; `take!` leaves its place uninitialized, which whole-binding tracking can record
; only for a whole binding: taking a field or element of an owner would leave the
; owner's drop glue to destroy the taken value a second time.
(defn ownership-require-whole-take [(a (dyn Allocator))
                                    (cx (ptr Cx))
                                    (place (ptr Expr))
                                    (states (ptr (ArrayList MoveState)))
                                    (fname (slice u8))] (-> (Result i64 Diag))
  (let [owner (ownership-root-state place states)]
    (if (or (= (primitive/cast i64 owner) 0)
            (!= (primitive/cast i64 (ownership-root-var place))
                0)
            (not (ownership-glue-reaches? a cx place (.ty owner))))
        (Ok [i64 Diag] 0)
        (match (ownership-place-type a cx place (.ty owner))
          (Some [t]
                (let [tp (primitive/alloc-stack Type)]
                  (set! tp t)
                  (if (type-needs-drop a cx tp)
                      (Err [i64 Diag]
                           (derr-at-src (.source place)
                                        (.lo place)
                                        (.hi place)
                                        (sconcat a
                                                 (sconcat4 a
                                                           "in '"
                                                           fname
                                                           "': cannot take! an owned field or element of '"
                                                           (.name owner))
                                                 "'; ownership is tracked per binding, so take! the whole value, or borrow or clone the part")))
                      (Ok [i64 Diag] 0))))
          (None [] (Ok [i64 Diag] 0))))))

(defn ownership-require-movable [(a (dyn Allocator))
                                 (cx (ptr Cx))
                                 (e (ptr Expr))
                                 (states (ptr (ArrayList MoveState)))
                                 (fname (slice u8))] (-> (Result i64 Diag))
  (match (.kind e)
    (ELoad [place]
           (if (or (core-name? fname "take!")
                   (core-name-prefix? fname "take!__"))
               (Ok [i64 Diag] 0)
               (ownership-require-movable-place a
                                                cx
                                                e
                                                place
                                                (box-al [(ptr (ArrayList Bind))]
                                                        a
                                                        (ArrayList::new [(ptr (ArrayList Bind))]
                                                                        a))
                                                states
                                                fname)))
    (_ (Ok [i64 Diag] 0))))

(defn ownership-require-movable-list [(a (dyn Allocator))
                                      (cx (ptr Cx))
                                      (e (ptr Expr))
                                      (body (ptr (ArrayList Expr)))
                                      (scoped (ptr (ArrayList (ptr (ArrayList Bind)))))
                                      (states (ptr (ArrayList MoveState)))
                                      (fname (slice u8))] (-> (Result i64 Diag))
  (if (= (len (load body)) 0)
      (Ok [i64 Diag] 0)
      (ownership-require-movable-place a
                                       cx
                                       e
                                       (al-last-expr body)
                                       scoped
                                       states
                                       fname)))

; `place` is what `e` loads. A compound place (a `let`, `do`, `if` or `match`
; whose result is a place) is loaded at each of its tails, so check each one.
; `scoped` holds the bindings of the `let`s entered on the way down: the walk has
; not registered them yet, so a tail naming one of their owners is recognized here.
(defn ownership-require-movable-place [(a (dyn Allocator))
                                       (cx (ptr Cx))
                                       (e (ptr Expr))
                                       (place (ptr Expr))
                                       (scoped (ptr (ArrayList (ptr (ArrayList Bind)))))
                                       (states (ptr (ArrayList MoveState)))
                                       (fname (slice u8))] (-> (Result i64 Diag))
  (match (.kind place)
    (ELet [binds body]
          (do
            (push! [(ptr (ArrayList Bind))] scoped binds)
            (let [r (ownership-require-movable-list a
                                                    cx
                                                    e
                                                    body
                                                    scoped
                                                    states
                                                    fname)]
              (pop! [(ptr (ArrayList Bind))] scoped)
              r)))
    (EDo [body]
         (ownership-require-movable-list a cx e body scoped states fname))
    (EDefer [_ body]
            (ownership-require-movable-list a cx e body scoped states fname))
    (ECleanup [body _]
              (ownership-require-movable-place a cx e body scoped states fname))
    ; `(mut x)` or `(ref x)` lends x; it never hands over ownership. Moving an
    ; owner out of the borrow would copy it, and both copies would be dropped.
    (EBorrow [_ _]
             (match (ownership-expr-type a cx e)
               (Some [t]
                     (let [tp (primitive/alloc-stack Type)]
                       (set! tp t)
                       (if (type-needs-drop a cx tp)
                           (Err [i64 Diag]
                                (derr-at-src (.source place)
                                             (.lo place)
                                             (.hi place)
                                             (sconcat a
                                                      (sconcat4 a
                                                                "in '"
                                                                fname
                                                                "': cannot move an owned "
                                                                (ty-str a tp))
                                                      " out of a borrow; this parameter takes ownership, so pass the value itself to move it, or (clone …) it")))
                           (Ok [i64 Diag] 0))))
               (None [] (Ok [i64 Diag] 0))))
    (EIf [_ thn els]
         (try (do
                (try! (ownership-require-movable-place a
                                                       cx
                                                       e
                                                       thn
                                                       scoped
                                                       states
                                                       fname))
                (ownership-require-movable-place a
                                                 cx
                                                 e
                                                 els
                                                 scoped
                                                 states
                                                 fname))))
    (EMatch [_ arms]
            (try (do
                   (for i (range 0 (len (load arms)))
                     (try! (ownership-require-movable-place a
                                                            cx
                                                            e
                                                            (field (elem arms
                                                                         i)
                                                                   body)
                                                            scoped
                                                            states
                                                            fname)))
                   (Ok [i64 Diag] 0))))
    (_ (let [root (ownership-place-root-var place)
             ; The moved value's type. A projection node may carry no recorded
             ; type; when `e` loads it directly, the load's own type is the same.
             pointee
               (match (ownership-node-type a cx (.node-id place))
                 (Some [t] (match t (TRef [_ inner] (Some (load inner))) (_ (None [Type]))))
                 (None []
                       (match (.kind e)
                         (ELoad [direct]
                                (if (= (primitive/cast i64 direct)
                                       (primitive/cast i64 place))
                                    (ownership-expr-type a cx e)
                                    (None [Type])))
                         (_ (None [Type])))))]
         (match pointee
           (Some [pt]
                 (let [ptp (primitive/alloc-stack Type)]
                   (set! ptp pt)
                   (if (or (= (primitive/cast i64 root) 0)
                           (not (type-needs-drop a cx ptp)))
                       (Ok [i64 Diag] 0)
                       (ownership-require-movable-root a
                                                       cx
                                                       e
                                                       place
                                                       root
                                                       scoped
                                                       states
                                                       fname))))
           ; Not a reference: a raw pointer never owns its pointee, and a value
           ; is not a place at all.
           (None [] (Ok [i64 Diag] 0)))))))

; Is `root` an owning binding of one of the `let`s in `scoped`? Binding identity
; comes from the checker's side map, as in `ownership-consume-root!`.
(defn ownership-scoped-owner? [(root (ptr Expr))
                               (scoped (ptr (ArrayList (ptr (ArrayList Bind)))))] (-> bool)
  (let [bid (bind-map-lookup (.node-id root))
        (mut found) false]
    (when (> bid 0)
      (for binds (iter (load scoped))
        (for i (range 0 (len (load binds)))
          (let [bp (elem binds i)]
            (when (and (= (.bid bp) bid)
                       (!= (primitive/cast i64 (.owned_type bp))
                           0))
              (set! found true)
              0))))
      0)
    found))

(defn ownership-require-movable-root [(a (dyn Allocator))
                                      (cx (ptr Cx))
                                      (e (ptr Expr))
                                      (place (ptr Expr))
                                      (root (ptr Expr))
                                      (scoped (ptr (ArrayList (ptr (ArrayList Bind)))))
                                      (states (ptr (ArrayList MoveState)))
                                      (fname (slice u8))] (-> (Result i64 Diag))
  (let [whole (!= (primitive/cast i64 (ownership-root-var place))
                  0)
        owner (ownership-root-state place states)
        name (match (.kind root) (EVar [n] n) (_ ""))]
    (cond (and whole (ownership-scoped-owner? root scoped))
            (Ok [i64 Diag] 0)
          (and whole (!= (primitive/cast i64 owner) 0))
            (Ok [i64 Diag] 0)
          (and (!= (primitive/cast i64 owner) 0)
               (not (ownership-glue-reaches? a cx place (.ty owner))))
            (Ok [i64 Diag] 0)
          (!= (primitive/cast i64 owner) 0)
            (Err [i64 Diag]
                 (derr-at-src (.source place)
                              (.lo place)
                              (.hi place)
                              (sconcat a
                                       (sconcat4 a
                                                 "in '"
                                                 fname
                                                 "': cannot move an owned value out of a field or element of '"
                                                 (.name owner))
                                       "'; ownership is tracked per binding, so borrow or clone the part, or move the whole value")))
          :else
            (Err [i64 Diag]
                 (derr-at-src (.source place)
                              (.lo place)
                              (.hi place)
                              (sconcat a
                                       (sconcat4 a
                                                 "in '"
                                                 fname
                                                 "': cannot move an owned value out of '"
                                                 name)
                                       "', which is a reference: the value is lent here, not owned. Pass it on as a reference where it goes, or (clone …) it; a match on a named value binds its payload by reference, and matching on (take! (mut …)) owns the payload"))))))

;;; `(defer* cleanup)` over `body`. The cleanup is elaborated once, here, as a
;;; statement against a copy of the states: running at every exit, it may read
;;; owners but never move one. It then becomes a state of its own, so each exit
;;; from `body` -- and its end -- runs a copy of it in order with the drops there.
(defn ownership-walk-defer [(a (dyn Allocator))
                            (cx (ptr Cx))
                            (e (ptr Expr))
                            (cleanup (ptr Expr))
                            (body (ptr (ArrayList Expr)))
                            (states (ptr (ArrayList MoveState)))
                            (loops (ptr (ArrayList OwnershipLoop)))
                            (fname (slice u8))
                            (consumes bool)] (-> (Result i64 Diag))
  (try (let [start (len (load states))
             probe (move-states-clone states)]
         (ownership-discard-result! a cx cleanup)
         (try! (ownership-walk-expr a cx cleanup probe loops fname false))
         (let [moved (ownership-state-mismatch states probe)]
           (unless (= (primitive/cast i64 moved) 0)
             (break :try
                    (Err [i64 Diag]
                         (derr-at-src (.source cleanup)
                                      (.lo cleanup)
                                      (.hi cleanup)
                                      (sconcat4 a
                                                (sconcat3 a "in '" fname "': a (defer …) cleanup cannot move '")
                                                (.name moved)
                                                "'; it runs at every exit from the forms it guards, so the owner would be moved once per exit and dropped as well"
                                                ""))))))
         (let [(mut names) (ArrayList::new [(slice u8)] a)
               (mut reads) (ArrayList::new [i64] a)
               (mut uses) (ArrayList::new [i64] a)
               st (primitive/alloc-stack MoveState)
               counter (ownership-shadow-counter)]
           (ownership-collect-vars! a cleanup (mut names) (mut reads))
           (for [k 0 (len (load reads))]
             (let [bid (get (load reads) k)]
               (unless (= (primitive/cast i64 (move-state-find states bid)) 0)
                 (push! (mut uses) bid)
                 0)))
           (set! counter (+ (load counter) 1))
           ; Owners have positive binding ids; a defer's id is negative, so no
           ; lookup by binding ever finds it.
           (set! (.bid st) (- 0 (load counter)))
           (set! (.moved st) false)
           (set! (.name st) "(defer)")
           (set! (.ty st) (primitive/cast (ptr Type) 0))
           (set! (.lo st) (.lo e))
           (set! (.hi st) (.hi e))
           (set! (.source st) (.source e))
           (set! (.ctxt st) (.ctxt e))
           (set! (.cleanup st) cleanup)
           (set! (.uses st) (box-al [i64] a (load uses)))
           (set! (.pinned st) (box-al [(slice u8)] a (load names)))
           (push! [MoveState] states (load st)))
         (try! (ownership-walk-body a cx body states loops fname consumes false))
         (ownership-wrap-tail-cleanup! a
                                       body
                                       (try! (ownership-cleanups a cx states start fname))
                                       (.lo e)
                                       (.hi e)
                                       (.source e)
                                       (.ctxt e))
         (while (> (len (load states)) start)
           (pop! [MoveState] states))
         (set! (.kind e) (EDo body))
         (Ok [i64 Diag] 0))))

(defn ownership-walk-expr [(a (dyn Allocator))
                           (cx (ptr Cx))
                           (e (ptr Expr))
                           (states (ptr (ArrayList MoveState)))
                           (loops (ptr (ArrayList OwnershipLoop)))
                           (fname (slice u8))
                           (consumes bool)] (-> (Result i64 Diag))
  (try (do
         (when consumes
           (try! (ownership-require-movable a cx e states fname))
           (try! (ownership-consume-root! a e states fname))
           0)
         (unless consumes
           (try! (ownership-require-live-root a e states fname))
           0)
         (match (.kind e)
           (EBorrow [_ place]
                    (ownership-walk-expr a cx place states loops fname false))
           (ELet [binds body]
                 (let [n (len (load binds))
                       start (len (load states))
                       (mut i) 0]
                   (loop (if (>= (load i) n)
                             (break)
                             (do
                               (ownership-unshadow-bind! a binds body (load i) states)
                               (let [bp (elem binds (load i))]
                                 (try! (ownership-walk-expr a
                                                            cx
                                                            (field bp value)
                                                            states
                                                            loops
                                                            fname
                                                            true))
                                 (unless (= (primitive/cast i64
                                                            (.owned_type bp))
                                            0)
                                   (ownership-register! states
                                                        (.bid bp)
                                                        (.name bp)
                                                        (.owned_type bp)
                                                        (.lo (field bp value))
                                                        (.hi (field bp value))
                                                        (.source (field bp
                                                                        value))
                                                        (.ctxt (field bp value)))
                                   (when (or (core-name? fname "forget")
                                             (core-name-prefix? fname "forget__"))
                                     (let [st (move-state-find states (.bid bp))]
                                       (when (!= (primitive/cast i64 st)
                                                 0)
                                         (set! (.moved st) true)
                                         0))
                                     0)
                                   0))
                               (store! i (primitive/iadd (load i) 1)))))
                   (try! (ownership-walk-body a
                                              cx
                                              body
                                              states
                                              loops
                                              fname
                                              consumes
                                              false))
                   (ownership-wrap-tail-cleanup! a
                                                 body
                                                 (try! (ownership-cleanups a
                                                                           cx
                                                                           states
                                                                           start
                                                                           fname))
                                                 (.lo e)
                                                 (.hi e)
                                                 (.source e)
                                                 (.ctxt e))
                   (loop (if (<= (len (load states)) start)
                             (break)
                             (do (pop! [MoveState] states) 0)))
                   (Ok [i64 Diag] 0)))
           (EBin [_ lhs rhs]
                 (do
                   (try! (ownership-walk-expr a cx lhs states loops fname false))
                   (ownership-walk-expr a cx rhs states loops fname false)))
           (EIntUnary [_ inner]
                      (ownership-walk-expr a cx inner states loops fname false))
           (ECmp [_ lhs rhs]
                 (do
                   (try! (ownership-walk-expr a cx lhs states loops fname false))
                   (ownership-walk-expr a cx rhs states loops fname false)))
           (EIf [cnd thn els]
                (do
                  (try! (ownership-walk-expr a cx cnd states loops fname false))
                  (ownership-walk-branches a
                                           cx
                                           thn
                                           els
                                           states
                                           loops
                                           fname
                                           consumes)))
           (EDo [body]
                (ownership-walk-body a cx body states loops fname consumes false))
           (ECall [func targs args]
                  (if (ownership-wrap-borrowed-rvalues! a cx e args states)
                      (ownership-walk-expr a cx e states loops fname consumes)
                      (ownership-walk-call-args a
                                                cx
                                                func
                                                targs
                                                args
                                                states
                                                loops
                                                fname)))
           (EAlloc [_ _ init symbol]
                   (if (= (primitive/cast i64 init) 0)
                       (Ok [i64 Diag] 0)
                       (ownership-walk-expr a cx init states loops fname true)))
           (EField [p _] (ownership-walk-expr a cx p states loops fname false))
           (ELoad [inner]
                  (if (ownership-wrap-field-read-temporary! a cx e states)
                      (ownership-walk-expr a cx e states loops fname consumes)
                  (if consumes
                      ; A direct load from a named place was consumed by the root check at
                      ; entry. For a compound place-producing expression (notably a
                      ; constructor's synthesized ELet), descend so its tail owner is moved
                      ; and the temporary is not also dropped.
                      (if (= (primitive/cast i64 (ownership-root-var inner))
                             0)
                          (ownership-walk-expr a
                                               cx
                                               inner
                                               states
                                               loops
                                               fname
                                               true)
                          (Ok [i64 Diag] 0))
                      (ownership-walk-expr a cx inner states loops fname false))))
           (EStore [p value]
                   (let [owner (ownership-root-state p states)
                         owner-bid
                           (if (= (primitive/cast i64 owner)
                                  0)
                               0
                               (.bid owner))
                         owner-type
                           (if (= (primitive/cast i64 owner)
                                  0)
                               (primitive/cast (ptr Type) 0)
                               (.ty owner))]
                     (if (= (primitive/cast i64 owner) 0)
                         (do
                           (try! (ownership-walk-expr a
                                                      cx
                                                      p
                                                      states
                                                      loops
                                                      fname
                                                      false))
                           (try! (ownership-walk-expr a
                                                      cx
                                                      value
                                                      states
                                                      loops
                                                      fname
                                                      true))
                           (ownership-load-direct-place! a value states)
                           (match (ownership-mut-borrow-place-type a cx p)
                             (Some [target-type]
                                   (ownership-overwrite-drop! a
                                                              cx
                                                              e
                                                              p
                                                              value
                                                              target-type))
                             (None [] 0))
                           (Ok [i64 Diag] 0))
                         (if (.moved owner)
                             ; A whole-owner store reinitializes a moved mutable binding.
                             ; A projection cannot be initialized while its enclosing owner
                             ; is absent; partial initialization needs drop flags.
                             (match (.kind p)
                               (EVar [_]
                                     (do
                                       (try! (ownership-walk-expr a
                                                                  cx
                                                                  value
                                                                  states
                                                                  loops
                                                                  fname
                                                                  true))
                                       (ownership-load-direct-place! a
                                                                     value
                                                                     states)
                                       (let [current
                                               (move-state-find states
                                                                owner-bid)]
                                         (unless (= (primitive/cast i64 current)
                                                    0)
                                           (set! (.moved current) false)
                                           0))
                                       (Ok [i64 Diag] 0)))
                               (_ (Err [i64 Diag]
                                       (derr-at-src (.source e)
                                                    (.lo e)
                                                    (.hi e)
                                                    (sconcat a
                                                             (sconcat3 a
                                                                       "in '"
                                                                       fname
                                                                       "': cannot initialize a field of moved value '")
                                                             (sconcat a
                                                                      (.name owner)
                                                                      "'"))))))
                             (do
                               (try! (ownership-walk-expr a
                                                          cx
                                                          p
                                                          states
                                                          loops
                                                          fname
                                                          false))
                               (try! (ownership-walk-expr a
                                                          cx
                                                          value
                                                          states
                                                          loops
                                                          fname
                                                          true))
                               (ownership-load-direct-place! a value states)
                               (match (ownership-place-type a cx p owner-type)
                                 (Some [target-type]
                                       (ownership-overwrite-drop! a
                                                                  cx
                                                                  e
                                                                  p
                                                                  value
                                                                  target-type))
                                 (None [] 0))
                               (Ok [i64 Diag] 0))))))
           (EInitStore [p value]
                       (do
                         (try! (ownership-walk-expr a
                                                    cx
                                                    p
                                                    states
                                                    loops
                                                    fname
                                                    false))
                         (try! (ownership-walk-expr a
                                                    cx
                                                    value
                                                    states
                                                    loops
                                                    fname
                                                    true))
                         (ownership-load-direct-place! a value states)
                         (Ok [i64 Diag] 0)))
           (EIndex [p idx]
                   (do
                     (try! (ownership-walk-expr a cx p states loops fname false))
                     (ownership-walk-expr a cx idx states loops fname false)))
           (ECast [_ inner]
                  (ownership-walk-expr a cx inner states loops fname false))
           (EBitGet [p _] (ownership-walk-expr a cx p states loops fname false))
           (EBitSet [p _ value]
                    (do
                      (try! (ownership-walk-expr a
                                                 cx
                                                 p
                                                 states
                                                 loops
                                                 fname
                                                 false))
                      (ownership-walk-expr a cx value states loops fname false)))
           (EFree [inner]
                  (ownership-walk-expr a cx inner states loops fname false))
           (EErase [_ inner]
                   (ownership-walk-expr a cx inner states loops fname false))
           (EMatch [scrut arms]
                   (do
                     ; A match on a named value binds its payload by reference. A match on
                     ; `(load …)` matches a copy, which is dropped after the arms: it moves the
                     ; value out of its place, so it must be an owner the function may move, not
                     ; one lent to it.
                     (try! (ownership-walk-expr a
                                                cx
                                                scrut
                                                states
                                                loops
                                                fname
                                                (match (.kind scrut) (ELoad [_] true) (_ false))))
                     (let [n (len (load arms))
                           (mut i) 0
                           (mut first)
                             (primitive/cast (ptr (ArrayList MoveState)) 0)]
                       (loop (if (>= (load i) n)
                                 (break)
                                 (do
                                   (ownership-unshadow-arm! a (elem arms (load i)) states)
                                   (let [branch (move-states-clone states)]
                                     (try! (ownership-walk-expr a
                                                                cx
                                                                (field (elem arms
                                                                             (load i))
                                                                       body)
                                                                branch
                                                                loops
                                                                fname
                                                                consumes))
                                     (if (= (load i) 0)
                                         (store! first branch)
                                         (try! (ownership-require-same-states a
                                                                              (load first)
                                                                              branch
                                                                              fname
                                                                              "between match arms"))))
                                   (store! i (primitive/iadd (load i) 1)))))
                       (when (!= (primitive/cast i64 (load first))
                                 0)
                         (move-states-merge! states (load first)))
                       (Ok [i64 Diag] 0))))
           (ECallPtr [fp args]
                     (do
                       (try! (ownership-walk-expr a
                                                  cx
                                                  fp
                                                  states
                                                  loops
                                                  fname
                                                  false))
                       (ownership-walk-callptr-args a cx fp args states loops fname)))
           (EDefer [cleanup body]
                   (ownership-walk-defer a cx e cleanup body states loops fname consumes))
           (ELoop [label body]
             (if (loop-is-block? label body)
                  ; A block runs once and is left only by its breaks: each must leave
                  ; the outer owners as the others do, and after the block they are
                  ; as every exit left them.
                  (let [exits (box-al [(ptr (ArrayList MoveState))] (.alc loops)
                                      (ArrayList::new [(ptr (ArrayList MoveState))] (.alc loops)))
                        inside (move-states-clone states)
                        frame (primitive/alloc-stack OwnershipLoop)]
                    (set! (.label frame) label)
                    (set! (.owner_depth frame) (len (load states)))
                    (set! (.block_exits frame) exits)
                    (push! [OwnershipLoop] loops (load frame))
                    (try! (ownership-walk-body a cx body inside loops fname false true))
                    (pop! [OwnershipLoop] loops)
                    (for [i 1 (len (load exits))]
                      (try! (ownership-require-same-states a
                                                           (get (load exits) 0)
                                                           (get (load exits) i)
                                                           fname
                                                           (sconcat3 a
                                                                     "between the exits of block :"
                                                                     (label-val label)
                                                                     ""))))
                    (when (> (len (load exits)) 0)
                      (move-states-merge! states (get (load exits) 0)))
                    (Ok [i64 Diag] 0))
                  (let [iteration (move-states-clone states)
                        frame (primitive/alloc-stack OwnershipLoop)]
                    (set! (.label frame) label)
                    (set! (.owner_depth frame) (len (load states)))
                    (set! (.block_exits frame)
                          (primitive/cast (ptr (ArrayList (ptr (ArrayList MoveState)))) 0))
                    (push! [OwnershipLoop] loops (load frame))
                    (try! (ownership-walk-body a
                                               cx
                                               body
                                               iteration
                                               loops
                                               fname
                                               false
                                               true))
                    (pop! [OwnershipLoop] loops)
                    (try! (ownership-require-same-states a
                                                         states
                                                         iteration
                                                         fname
                                                         "across a loop iteration"))
                    (Ok [i64 Diag] 0))))
           (EBreak [label value]
                   (do
                     (match value
                       (Some [v]
                             (try! (ownership-walk-expr a
                                                        cx
                                                        v
                                                        states
                                                        loops
                                                        fname
                                                        true)))
                       (None [] 0))
                     (let [depth (ownership-loop-owner-depth loops label)]
                       (when (>= depth 0)
                         (try! (ownership-wrap-exit! a cx e states depth fname))
                         0))
                     (let [exits (ownership-block-exits loops label)]
                       (unless (= (primitive/cast i64 exits) 0)
                         ; only the owners from outside the block: the exit drops
                         ; the rest, and nothing after the block can see them
                         (push! [(ptr (ArrayList MoveState))]
                                exits
                                (move-states-prefix states (ownership-loop-owner-depth loops label)))
                         0))
                     (Ok [i64 Diag] 0)))
           (EContinue [label]
                      (do
                        (let [depth (ownership-loop-owner-depth loops label)]
                          (when (>= depth 0)
                            (try! (ownership-wrap-exit! a cx e states depth fname))
                            0))
                        (Ok [i64 Diag] 0)))
           (ELlvmIr [_ args _]
                    (ownership-walk-list a cx args states loops fname false))
           (EIntrinsic [_ _ args]
                       (ownership-walk-list a cx args states loops fname false))
           (EVector [_ _ _ args]
                    (ownership-walk-list a cx args states loops fname false))
           (EFieldMeta [_ _ idx]
                       (ownership-walk-expr a cx idx states loops fname false))
           (EFieldIndex [_ name]
                        (ownership-walk-expr a cx name states loops fname false))
           (ECodeOp [_ args]
                    (ownership-walk-list a cx args states loops fname false))
           (EComptime [inner]
                      (ownership-walk-expr a cx inner states loops fname false))
           (EPattern [_ _ inner _]
                     (ownership-walk-expr a
                                          cx
                                          inner
                                          states
                                          loops
                                          fname
                                          consumes))
           (EAscribe [_ inner]
                     (ownership-walk-expr a
                                          cx
                                          inner
                                          states
                                          loops
                                          fname
                                          consumes))
           (EArrayLit [items]
                      (ownership-walk-all a cx items states loops fname true))
           (EStaticArray [_ items]
                         (ownership-walk-all a cx items states loops fname true))
           (ESpillRef [inner]
                      (do
                        (try! (ownership-walk-expr a cx inner states loops fname false))
                        (ownership-unspill-owner-place! e inner states)
                        (Ok [i64 Diag] 0)))
           (EMovePlace [inner]
                       (ownership-walk-expr a cx inner states loops fname false))
           (EMakeSlice [data _ _]
                       (ownership-walk-expr a cx data states loops fname false))
           (EConstruct [_ _ args]
                       (ownership-walk-construct-args a
                                                      cx
                                                      args
                                                      states
                                                      loops
                                                      fname))
           (ETraitCall [_ _ _ args]
                       (ownership-walk-list a cx args states loops fname false))
           (EDynDispatch [dc] (let [recv (.recv dc) args (.args dc)]
                         (do
                           (try! (ownership-walk-expr a
                                                      cx
                                                      recv
                                                      states
                                                      loops
                                                      fname
                                                      false))
                           (ownership-walk-list a
                                                cx
                                                args
                                                states
                                                loops
                                                fname
                                                false))))
           (EMakeDyn [_ _ _ inner]
                     (ownership-walk-expr a cx inner states loops fname false))
           (_ (Ok [i64 Diag] 0))))))

(defn ownership-check-func-work [(a (dyn Allocator)) (work (dyn Allocator)) (cx (ptr Cx)) (fp (ptr Func))] (-> (Result i64
                                                                                           Diag))
  (try (let [(mut states) (ArrayList::new [MoveState] work)
             (mut loops) (ArrayList::new [OwnershipLoop] work)
             ps (load (field fp params))
             np (len (load ps))
             (mut i) 0]
         (loop (if (>= (load i) np)
                   (break)
                   (do
                     (let [pp (elem ps (load i))]
                       (unless (= (primitive/cast i64 (.owned_type pp))
                                  0)
                         (ownership-register! (mut states)
                                              (.bid pp)
                                              (.name pp)
                                              (.owned_type pp)
                                              (.lo fp)
                                              (.hi fp)
                                              (.source fp)
                                              (.ctxt fp))
                         0))
                     (set! i (primitive/iadd (load i) 1)))))
         ; The parameter has transferred into `forget`; marking it moved is the
         ; intrinsic semantic operation that deliberately suppresses cleanup.
         (when (or (core-name? (.name fp) "forget")
                   (core-name-prefix? (.name fp) "forget__"))
           (set! i 0)
           (loop (if (>= (load i) (len (load states)))
                     (break)
                     (do
                       (set! (.moved (elem (mut states) (load i)))
                             true)
                       (set! i (primitive/iadd (load i) 1)))))
           0)
         (try! (ownership-walk-body a
                                    cx
                                    (load (field fp body))
                                    (mut states)
                                    (mut loops)
                                    (.name fp)
                                    true
                                    false))
         (ownership-wrap-tail-cleanup! a
                                       (load (field fp body))
                                       (try! (ownership-cleanups a cx (mut states) 0 (.name fp)))
                                       (.lo fp)
                                       (.hi fp)
                                       (.source fp)
                                       (.ctxt fp))
         (Ok [i64 Diag] 0))))

;;; Branch-state snapshots are temporary facts, not part of the checked program.
;;; Keep them until this function's cleanup elaboration finishes, including on an
;;; error. Expressions, types and diagnostics continue to use the caller's owner.
(defn ownership-check-func [(a (dyn Allocator)) (cx (ptr Cx)) (fp (ptr Func))] (-> (Result i64 Diag))
  (let [work (primitive/alloc-stack scratch/ScratchArena)
        _init (scratch/ScratchArena::init-with-capacity work (retainedheap/compiler-scratch-parent) 4096)
        result (ownership-check-func-work a (allocator work) cx fp)]
    (close! work)
    result))

(defn check-all-funcs [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (allf (ptr (ArrayList Func)))
                       (s (mut LS))
                       (validate-ownership bool)] (-> (Result (ptr (ArrayList Func))
                                                              Diag))
  (let [n (len (load allf))
        (mut out) (ArrayList::new [Func] a)
        (mut dgs) (ArrayList::new [Diag] a)
        (mut owners) (ArrayList::new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (elem allf (load i))]
                  (if (or (ls-accepted-function? (mut s) fp) (closure-base-accepted? fp))
                      (push! (mut out) (load fp))
                      (do
                  (unless (func-poisoned? (mut s) (load (field fp name)))
                    ; The memo contains only scalar keys and borrowed Expr/Type
                    ; pointers. No result retains the table after this function.
                    (set! (.synth_cache cx)
                          (HashMap::new [SynthKey SynPair]
                                        (malloc-allocator)
                                        (scalar-keyops [SynthKey])))
                    (set! (.synth_cache_active cx) true)
                    (when (.recover_statements cx) (set! (.len (field cx recovered_diags)) 0) 0)
                    (match (check-func a cx fp)
                      (Err [d]
                           (do
                             (push! (mut dgs) d)
                             (push! (mut owners) (load (field fp name)))
                             (for [ri 0 (len (.recovered_diags cx))]
                               (push! (mut dgs) (get (.recovered_diags cx) ri))
                               (push! (mut owners) (load (field fp name))))
                             ; A provisional model keeps the declaration: its
                             ; signature is valid even though its body is not.
                             (unless validate-ownership (push! (mut out) (load fp)) 0)
                             0))
                      (Ok [f]
                        (if (and (.recover_statements cx) (> (len (.recovered_diags cx)) 0))
                          ; Recovery typed its failures and finished the body; the
                          ; function still failed, with every error it recorded.
                          (do
                            (for [ri 0 (len (.recovered_diags cx))]
                              (push! (mut dgs) (get (.recovered_diags cx) ri))
                              (push! (mut owners) (load (field fp name))))
                            (push! (mut out) (load fp))
                            0)
                          (let [checked (primitive/alloc-stack Func)]
                            (set! checked f)
                            ; check-func leaves this function's bounds installed on Cx,
                            ; which is exactly the abstract ownership environment needed
                            ; by type-needs-drop for this pass.
                            (if (or (not validate-ownership)
                                    (> (len (load (field checked type_params)))
                                       0))
                                ; Generic cleanup is elaborated by mono after type
                                ; substitution, when structural Drop is knowable.
                                (push! (mut out) f)
                                (match (ownership-check-func a cx checked)
                                  (Err [d]
                                       (do
                                         (push! (mut dgs) d)
                                         (push! (mut owners)
                                                (load (field fp name)))
                                         0))
                                  (Ok [_] (push! (mut out) f)))))))))
                  (set! (.synth_cache_active cx) false)
                  (free! (mut (.synth_cache cx))))))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.check_diags s) (box-al [Diag] a (load dgs)))
    (set! (.check_diag_owners s)
          (box-al [(slice u8)] a (load owners)))
    ; The provisional (synthesis-only) check returns the partial function list;
    ; its diagnostics stay on the loader for the caller to install with the model.
    (if (and validate-ownership (> (len (load dgs)) 0))
        (Err (get (load dgs) 0))
        (Ok (box-al [Func] a (load out))))))

;;; Check ONE function against a checker context whose setup already ran over a
;;; program declaring the same signature. This is exactly the per-function step of
;;; `check-all-funcs`, so the diagnostic is the one a whole-program check would
;;; report for this function. (None) = the function checks.
(defn check-func-probe [(a (dyn Allocator))
                        (cx (ptr Cx))
                        (fp (ptr Func))
                        (validate-ownership bool)] (-> (Option Diag))
  (set! (.synth_cache cx)
        (HashMap::new [SynthKey SynPair] (malloc-allocator) (scalar-keyops [SynthKey])))
  (set! (.synth_cache_active cx) true)
  (let [result
          (match (check-func a cx fp)
            (Err [d] (Some d))
            (Ok [f]
                (let [checked (primitive/alloc-stack Func)]
                  (set! checked f)
                  (if (or (not validate-ownership)
                          (> (len (load (field checked type_params)))
                             0))
                      (None [Diag])
                      (match (ownership-check-func a cx checked)
                        (Err [d] (Some d))
                        (Ok [_] (None [Diag])))))))]
    (set! (.synth_cache_active cx) false)
    (free! (mut (.synth_cache cx)))
    result))

(defn check-program-mode [(a (dyn Allocator))
                          (p (ptr Program))
                          (s (mut LS))
                          (validate-ownership bool)] (-> (Result (ptr Program)
                                                                 Diag))
  (check-program-mode-into a
                           p
                           (mut s)
                           validate-ownership
                           (primitive/cast (ptr (ptr Cx)) 0)))

;;; `check-program-mode`, additionally handing back the checker context once its
;;; setup succeeded (CX-OUT may be null). The context lives in A; a caller that
;;; keeps it may run `check-func-probe` against it until A is released.
;;; A checked Func contains lowered parameter storage, not the source calling
;;; signature. Reuse the accepted checker's complete Sig (names, bounds, semantic
;;; references, and fnptr ABI) instead of trying to infer it from lowered bodies.
(defn retired-function? [(prog (ptr Program)) (name (slice u8))] (-> bool)
  (let [names (.retired_functions prog)]
    (and (!= (primitive/cast i64 names) 0)
      (block :found
        (for [i 0 (len (load names))]
          (when (= (get (load names) i) name) (break :found true)))
        false))))

;;; A replacement impl reuses its retired impl's method names; those signatures
;;; are the new declarations', never the retired ones.
;;; An inherited function keeps the signature its parent settled on: its record was
;;; normalized when it was checked, and building a signature from it again would
;;; normalize it twice. That applies only to functions this program INHERITED. One
;;; it defines itself -- recognized, as everywhere, by not sharing the parent's body
;;; -- has a signature of its own, and giving it the parent's would check every
;;; caller against a definition that no longer exists.
(defn check-inherit-signatures! [(a (dyn Allocator)) (cx (ptr Cx)) (parent (ptr LS)) (prog (ptr Program))] (-> i64)
  (unless (= (primitive/cast i64 parent) 0)
    (let [raw (.checker_context parent)]
      (unless (= (primitive/cast i64 raw) 0)
        (let [prior (primitive/cast (ptr Cx) raw)
              ; The parent is a published state; nothing of ours is allocated in it.
              (mut redefined) (HashMap::new [(slice u8) i64] a (keyops-borrowed))]
          (for [i 0 (len (load (.funcs prog)))]
            (let [f (elem (.funcs prog) i)
                  inherited (match (ls-function parent (.name f))
                              (None [] false)
                              (Some [old]
                                    (= (primitive/cast i64 (.body old))
                                       (primitive/cast i64 (.body f)))))]
              (unless inherited (set! (mut redefined) (.name f) 0) 0)))
          (for [i 0 (len (.sigs prior))]
            (let [signature (elem (field prior sigs) i)
                  current (sig-find cx (.name signature))]
              (unless (or (= (primitive/cast i64 current) 0)
                          (or (retired-function? prog (.name signature))
                              (contains? (load redefined) (.name signature))))
                (set! current (load signature))
                0)))
          (free! (mut redefined)))
        0))
    0)
  0)

(defn check-program-mode-into [(a (dyn Allocator))
                               (p (ptr Program))
                               (s (mut LS))
                               (validate-ownership bool)
                               (cx-out (ptr (ptr Cx)))] (-> (Result (ptr Program)
                                                                    Diag))
  (check-program-into* a p (mut s) validate-ownership false cx-out))

;;; Check a metaprogram closure against the retained compile-time environment
;;; (see `replaces_meta_consts`).
(defn check-closure-program-into [(a (dyn Allocator))
                                  (p (ptr Program))
                                  (s (mut LS))
                                  (cx-out (ptr (ptr Cx)))] (-> (Result (ptr Program)
                                                                       Diag))
  (check-program-into* a p (mut s) true true cx-out))

; ---- array lengths that name constants ---------------------------------------
; `(array u8 MAX-LEN)` names a constant, which resolution qualified. Before
; anything reads a type, the constant's value takes the name's place: every
; type in the program is rewritten to `(array u8 33)`, so the checker, mono and
; every backend see an ordinary fixed length. `(P (const N))` in a type takes
; N's value the same way.
;
; The order of evaluation. A constant built from integer literals, other
; constants, the integer operators, comparisons, `if` and casts is folded here,
; directly from its initializer. Any other constant (one that calls a
; function) is computed by running code, and code runs only once it is
; checked: `run-constant-lengths!` checks the closure of those constants (the
; functions they call, the constants they read, and every type that does not
; itself wait on one of them) as a program of its own, runs each with the
; comptime evaluator, and repeats while a round computes something, since a
; constant can need a type whose length another such constant gives. When a
; round computes nothing, each remaining constant needs a type whose length
; waits on it, and the cycle is reported along its path.

(defsum CeVal (CeInt [(v i64)]) (CeBool [(b bool)]))

(defstruct CeState
  [(a (dyn Allocator))
   (consts (HashMap (slice u8) i64))
   (values (HashMap (slice u8) i64))
   ; constants being evaluated, in order: a name met again is a cycle
   (path (ArrayList (slice u8)))
   (prog (ptr Program))
   ; the constants whose values need code run (a call); their lengths are
   ; left as they are, for `run-constant-lengths!`
   (pending (ArrayList (slice u8)))
   ; set when evaluation stopped at a form that needs code run
   (needs-run bool)
   ; the listed constant a length in the declaration being walked names, or ""
   (hit (slice u8))
   ; each declaration a listed constant's length appears in -> that constant
   (waits (HashMap (slice u8) (slice u8)))
   ; the expressions still to walk
   (stack (ArrayList (ptr Expr)))
   ; whether `consts` holds the program's constants yet
   (indexed bool)
   ; the constants a session's earlier submissions accepted, checked
   (base (ptr ConstBase))
   ; the program's import and export tables, null when there are none: they
   ; decide which trait a bare operator's call is in scope as (`ce-operator`),
   ; and a constant run (`ce-run-round!`) is checked under them
   (imports (ptr (ArrayList ImpEntry)))
   (exports (ptr (ArrayList ExpEntry)))])

;;; The values `run-constant-lengths!` computed by running code, for the
;;; check in progress. Empty outside one.
(defstruct CeRunValues [(ready bool) (map (HashMap (slice u8) i64))])

(defn ce-run-values [] (-> (ptr CeRunValues)) (primitive/alloc-static CeRunValues))

(defn constant-length-values-set! [(name (slice u8)) (v i64)] (-> i64)
  (let [rv (ce-run-values)]
    (unless (.ready rv)
      (set! (.map rv) (HashMap::new [(slice u8) i64] (malloc-allocator) (keyops)))
      (set! (.ready rv) true)
      0)
    (set! (mut (.map rv)) name v)
    0))

(defn constant-length-values-clear! [] (-> i64)
  (let [rv (ce-run-values)]
    (when (.ready rv)
      (free! (mut (.map rv)))
      (set! (.ready rv) false)
      0)
    0))

(defn constant-length-run-value [(name (slice u8))] (-> (Option i64))
  (let [rv (ce-run-values)]
    (if (.ready rv) (get (.map rv) name) (None [i64]))))

(defn ce-shown [(name (slice u8))] (-> (slice u8))
  (unqualified-tail (display-ident name)))

;;; A diagnostic at the place the array length NAME was written, when known.
(defn ce-site-diag [(name (slice u8)) (msg (slice u8))] (-> Diag)
  (match (extent-site name)
    (Some [site] (derr-at-src (.source site) (.lo site) (.hi site) msg))
    (None [] (derr msg))))

(defn ce-expr-diag [(e (ptr Expr)) (msg (slice u8))] (-> Diag)
  (if (< (.lo e) 0) (derr msg) (derr-at-src (.source e) (.lo e) (.hi e) msg)))

;;; The constant NAME, or null. The index is built on first use: most walks
;;; meet no type that names one.
(defn ce-const [(st (ptr CeState)) (name (slice u8))] (-> (ptr Const))
  (unless (.indexed st)
    (let [cs (load (field (.prog st) consts))]
      (for [i 0 (len (load cs))]
        (set! (mut (.consts st)) (.name (elem cs i)) i)))
    (set! (.indexed st) true)
    0)
  (match (get (.consts st) name)
    (Some [i] (elem (load (field (.prog st) consts)) i))
    (None [] (primitive/cast (ptr Const) 0))))

;;; The integer value of the constant NAME, an array length.
(defn ce-const-value [(st (ptr CeState)) (name (slice u8))] (-> (Result i64 Diag))
  (try (match (match (get (.values st) name)
                (Some [v] (Some v))
                (None [] (constant-length-run-value name)))
         (Some [v] (Ok [i64 Diag] v))
         (None []
           (let [a (.a st)
                 cp (ce-const st name)
                 shown (ce-shown name)]
             (when (= (primitive/cast i64 cp) 0)
               (let [entry (const-base-get (.base st) name)]
                 (break :try
                   (if (= (primitive/cast i64 entry) 0)
                       (Err [i64 Diag]
                            (ce-site-diag name (sconcat3 a "array length '" shown
                                                         "' names neither an integer constant nor an integer value parameter")))
                       (ce-session-const-value st name entry)))))
             (when (.runtime cp)
               (break :try (Err [i64 Diag]
                                (ce-site-diag name (sconcat3 a "array length '" shown
                                                             "' names a def; a length names a const, which is known at compile time")))))
             (when (block :cycle
                     (for [i 0 (len (.path st))]
                       (when (= (get (.path st) i) name) (break :cycle true)))
                     false)
               ; the same words as the checker's own report of a cycle
               (let [(mut chain) ""
                     (mut on) false]
                 (for [i 0 (len (.path st))]
                   (when (= (get (.path st) i) name) (set! on true))
                   (when (load on)
                     (set! chain (sconcat3 a (load chain) (ce-shown (get (.path st) i)) " -> "))))
                 (break :try (Err [i64 Diag]
                                  (ce-expr-diag (field cp value)
                                                (sconcat a (sconcat3 a "constant '" shown "' depends on its own value (")
                                                         (sconcat3 a (load chain) shown ")")))))))
             (push! (mut (.path st)) name)
             (let [r (ce-eval st (field cp value) name)]
               (pop! (mut (.path st)))
               ; a value that needs code run is listed for the run
               (when (.needs-run st)
                 (unless (block :listed
                           (for [i 0 (len (.pending st))]
                             (when (= (get (.pending st) i) name) (break :listed true)))
                           false)
                   (push! (mut (.pending st)) name)
                   0))
               (match (try! r)
                 (CeBool [_]
                   (Err [i64 Diag]
                        (ce-expr-diag (field cp value)
                                      (sconcat3 a "array length '" shown "' is a bool constant; a length is an integer"))))
                 (CeInt [v]
                   (do (set! (mut (.values st)) name v)
                       (Ok [i64 Diag] v))))))))))

(defn ce-int [(st (ptr CeState)) (e (ptr Expr)) (owner (slice u8))] (-> (Result i64 Diag))
  (try (match (try! (ce-eval st e owner))
         (CeInt [v] (Ok [i64 Diag] v))
         (CeBool [_] (Err [i64 Diag]
                          (ce-expr-diag e (sconcat3 (.a st) "array length '" (ce-shown owner)
                                                    "': an integer operator was given a bool")))))))

(defn ce-bool [(st (ptr CeState)) (e (ptr Expr)) (owner (slice u8))] (-> (Result bool Diag))
  (try (match (try! (ce-eval st e owner))
         (CeBool [b] (Ok [bool Diag] b))
         (CeInt [_] (Err [bool Diag]
                         (ce-expr-diag e (sconcat3 (.a st) "array length '" (ce-shown owner)
                                                   "': a condition is an integer, not a bool")))))))

;;; `v` as a value of the integer type `t`: wrapped to its width, then sign- or
;;; zero-extended, as a cast does.
(defn ce-wrap [(v i64) (t (ptr Type))] (-> i64)
  (match (load t)
    (TInt [bits signed]
      (if (>= bits 64)
          v
          (let [mask (- (primitive/ishl 1 bits) 1)
                low (primitive/iand v mask)]
            (if (and signed (!= (primitive/iand low (primitive/ishl 1 (- bits 1))) 0))
                (primitive/ior low (primitive/inot mask))
                low))))
    (_ v)))

(defn ce-binop [(a (dyn Allocator)) (e (ptr Expr)) (owner (slice u8)) (op (slice u8)) (x i64) (y i64)]
  (-> (Result i64 Diag))
  (cond (= op "+") (Ok [i64 Diag] (+ x y))
        (= op "-") (Ok [i64 Diag] (- x y))
        (= op "*") (Ok [i64 Diag] (* x y))
        (or (= op "/") (= op "%"))
          (if (= y 0)
              (Err [i64 Diag] (ce-expr-diag e (sconcat3 a "array length '" (ce-shown owner) "': division by zero")))
              (Ok [i64 Diag] (if (= op "/") (primitive/idiv x y) (primitive/irem x y))))
        (= op "&") (Ok [i64 Diag] (primitive/iand x y))
        (= op "|") (Ok [i64 Diag] (primitive/ior x y))
        (= op "^") (Ok [i64 Diag] (primitive/ixor x y))
        (= op "<<") (Ok [i64 Diag] (primitive/ishl x y))
        (= op ">>") (Ok [i64 Diag] (primitive/ishr x y))
        (= op "min") (Ok [i64 Diag] (if (< x y) x y))
        (= op "max") (Ok [i64 Diag] (if (> x y) x y))
        :else (Err [i64 Diag] (derr "internal: unknown constant operator"))))

;;; Is NAME spelled as an operator the constant evaluator folds?
(defn ce-operator-spelling? [(name (slice u8))] (-> bool)
  (or (= name "+") (= name "-") (= name "*") (= name "/") (= name "%")
      (= name "&") (= name "|") (= name "^") (= name "<<") (= name ">>")
      (= name "<") (= name "<=") (= name ">") (= name ">=") (= name "=") (= name "!=")
      (= name "not") (= name "and") (= name "or")))

;;; Is the bare call head METHOD, written in the declaration OWNER, core's
;;; operator? The resolver leaves a trait method's call bare for the checker to
;;; select, so this asks the checker's question: exactly one trait declaring
;;; METHOD is left in scope by the imports of OWNER's module, and it is core's.
(defn ce-core-method? [(st (ptr CeState)) (method (slice u8)) (owner (slice u8))] (-> bool)
  (let [traits (load (field (.prog st) traits))
        caller (module-prefix owner)
        (mut count) 0
        (mut core) false]
    (for [i 0 (len (load traits))]
      (let [td (elem traits i)
            ms (load (field td methods))]
        (when (block :declares
                (for [j 0 (len (load ms))]
                  (when (= (.name (elem ms j)) method) (break :declares true)))
                false)
          (unless (method-suppressed-in? (.imports st) (.a st) (.name td) method caller
                                         (> (len caller) 0))
            (set! count (+ (load count) 1))
            (set! core (core-name? (.name td) (after-last-dot (.name td))))
            0)
          0)))
    (and (= (load count) 1) (load core))))

;;; The operator a call head names, or "" when it may name anything else, which
;;; leaves the value to be computed by running it. A qualified head is an
;;; operator when it is core's (or `coil.math`'s `min` and `max`), and a bare one
;;; when it calls core's operator method (`ce-core-method?`).
(defn ce-operator [(st (ptr CeState)) (func (slice u8)) (owner (slice u8))] (-> (slice u8))
  (cond (= func "coil.math.min") "min"
        (= func "coil.math.max") "max"
        (has-dot func)
          (let [leaf (after-last-dot func)]
            (if (and (ce-operator-spelling? leaf) (core-name? func leaf)) leaf ""))
        (and (ce-operator-spelling? func) (ce-core-method? st func owner)) func
        :else ""))

(defn ce-compare [(op (slice u8)) (x i64) (y i64)] (-> bool)
  (cond (= op "<") (< x y) (= op "<=") (<= x y) (= op ">") (> x y) (= op ">=") (>= x y)
        (= op "=") (= x y) :else (!= x y)))

(defn ce-eval [(st (ptr CeState)) (e (ptr Expr)) (owner (slice u8))] (-> (Result CeVal Diag))
  (try
    (let [a (.a st)]
      (match (.kind e)
        (EInt [v] (Ok [CeVal Diag] (CeInt v)))
        (EBool [b] (Ok [CeVal Diag] (CeBool b)))
        (EVar [nm]
          (if (not (ce-known? st nm))
              (Err [CeVal Diag] (ce-expr-diag e (sconcat a (sconcat3 a "array length '" (ce-shown owner) "': '")
                                                       (sconcat a (ce-shown nm) "' is not a constant"))))
              (Ok [CeVal Diag] (CeInt (try! (ce-const-value st nm))))))
        (EAscribe [ty inner]
          (let [v (try! (ce-eval st inner owner))]
            (Ok [CeVal Diag] (match v (CeInt [n] (CeInt (ce-wrap n (box-type a ty)))) (_ v)))))
        (ECast [ty inner]
          (match (try! (ce-eval st inner owner))
            (CeInt [n] (Ok [CeVal Diag] (CeInt (ce-wrap n (box-type a ty)))))
            (CeBool [b] (Ok [CeVal Diag] (CeInt (if b 1 0))))))
        (EIf [c t f]
          (if (try! (ce-bool st c owner)) (ce-eval st t owner) (ce-eval st f owner)))
        (EDo [body]
          (if (= (len (load body)) 1)
              (ce-eval st (elem body 0) owner)
              (Err [CeVal Diag] (ce-unsupported st e owner))))
        (EComptime [inner] (ce-eval st inner owner))
        (ECmp [op l r]
          (let [x (try! (ce-int st l owner)) y (try! (ce-int st r owner))]
            (Ok [CeVal Diag]
                (CeBool (cond (= op 0) (< x y) (= op 1) (<= x y) (= op 2) (> x y)
                              (= op 3) (>= x y) (= op 4) (= x y) :else (!= x y))))))
        (EBin [op l r]
          (let [x (try! (ce-int st l owner)) y (try! (ce-int st r owner))
                name (cond (= op 0) "+" (= op 1) "-" (= op 2) "*" (= op 3) "/" (= op 4) "%"
                           (= op 7) "&" (= op 8) "|" (= op 9) "^" (= op 10) "<<" (= op 11) ">>"
                           :else "")]
            (if (= name "")
                (Err [CeVal Diag] (ce-unsupported st e owner))
                (Ok [CeVal Diag] (CeInt (try! (ce-binop a e owner name x y)))))))
        (ECall [func _ args]
          (let [op (ce-operator st func owner)
                n (len (load args))]
            (cond (= op "") (Err [CeVal Diag] (ce-unsupported st e owner))
                  (= op "not")
                    (Ok [CeVal Diag] (CeBool (not (try! (ce-bool st (elem args 0) owner)))))
                  (or (= op "and") (= op "or"))
                    (let [(mut acc) (= op "and")]
                      (for [i 0 n]
                        (let [b (try! (ce-bool st (elem args i) owner))]
                          (set! acc (if (= op "and") (and (load acc) b) (or (load acc) b)))))
                      (Ok [CeVal Diag] (CeBool (load acc))))
                  (or (= op "<") (= op "<=") (= op ">") (= op ">=") (= op "=") (= op "!="))
                    (let [x (try! (ce-int st (elem args 0) owner))
                          y (try! (ce-int st (elem args 1) owner))]
                      (Ok [CeVal Diag] (CeBool (ce-compare op x y))))
                  (and (= op "-") (= n 1))
                    (Ok [CeVal Diag] (CeInt (- 0 (try! (ce-int st (elem args 0) owner)))))
                  :else
                    (let [(mut acc) (try! (ce-int st (elem args 0) owner))]
                      (for [i 1 n]
                        (set! acc (try! (ce-binop a (elem args i) owner op (load acc)
                                                  (try! (ce-int st (elem args i) owner))))))
                      (Ok [CeVal Diag] (CeInt (load acc)))))))
        (_ (Err [CeVal Diag] (ce-unsupported st e owner)))))))

;;; The value of NAME, a constant an earlier submission of the session
;;; accepted: folded from the initializer that submission compiled (its native
;;; program keeps a computed constant's value), else from the checked one.
(defn ce-session-const-value [(st (ptr CeState)) (name (slice u8)) (entry (ptr ConstEntry))]
  (-> (Result i64 Diag))
  (let [a (.a st)
        shown (ce-shown name)
        native (const-base-native-get (.base st) name)
        value (if (= (primitive/cast i64 native) 0) (field entry value) (field native value))]
    (if (.runtime entry)
        (Err [i64 Diag]
             (ce-site-diag name (sconcat3 a "array length '" shown
                                          "' names a def; a length names a const, which is known at compile time")))
        (do
          (set! (.needs-run st) false)
          (match (ce-eval st value name)
            (Ok [v]
              (match v
                (CeInt [n] (do (set! (mut (.values st)) name n) (Ok [i64 Diag] n)))
                (CeBool [_] (Err [i64 Diag]
                                 (ce-site-diag name (sconcat3 a "array length '" shown
                                                              "' is a bool constant; a length is an integer"))))))
            (Err [d]
              (if (.needs-run st)
                  (do (set! (.needs-run st) false)
                      (Err [i64 Diag]
                           (ce-site-diag name (sconcat3 a "array length '" shown
                                                        "' names a constant an earlier submission computes by running code; a length can name such a constant only in the submission that defines it"))))
                  (Err [i64 Diag] d))))))))

;;; Does NAME's value need code run? It is evaluated once to find out, and a
;;; constant that needs a run is listed instead of reported.
(defn ce-deferred? [(st (ptr CeState)) (name (slice u8))] (-> bool)
  (set! (.needs-run st) false)
  (match (ce-const-value st name)
    (Ok [_] false)
    (Err [_]
      (let [listed (block :listed
                     (for [i 0 (len (.pending st))]
                       (when (= (get (.pending st) i) name) (break :listed true)))
                     false)]
        (set! (.needs-run st) false)
        listed))))

;;; E is not integer arithmetic on constants: the value needs code run. The
;;; constant is listed for the run (see `ce-const-value`), which reports
;;; instead of this diagnostic.
(defn ce-unsupported [(st (ptr CeState)) (e (ptr Expr)) (owner (slice u8))] (-> Diag)
  (set! (.needs-run st) true)
  (ce-expr-diag e (sconcat3 (.a st) "array length '" (ce-shown owner)
                            "': this part of the constant is computed by running code")))

;;; Does `t` name a constant, as an array length or as `(const N)`? Read only:
;;; most types name none, and are left untouched.
(defn ce-names-const? [(st (ptr CeState)) (t Type)] (-> bool)
  (match t
    (TArray [e k]
      (or (match k
            (ParamExtent [nm] (ce-type-const? st nm))
            (_ false))
          (ce-names-const? st (load e))))
    (TPtr [i] (ce-names-const? st (load i)))
    (TRef [_ i] (ce-names-const? st (load i)))
    (TSlice [i] (ce-names-const? st (load i)))
    (TVec [i _] (ce-names-const? st (load i)))
    (TFn [_ ps r] (or (ce-list-names-const? st ps) (ce-names-const? st (load r))))
    (TApp [_ args] (ce-list-names-const? st args))
    (TConst [v]
      (match v
        (ConstRef [nm] (ce-type-const? st nm))
        (_ false)))
    (_ false)))

;;; Does NAME, in a type, name one of the program's constants?
(defn ce-type-const? [(st (ptr CeState)) (name (slice u8))] (-> bool)
  (and (constant-named-in-types? name) (ce-known? st name)))

;;; Is NAME a constant, of the program or of an earlier submission?
(defn ce-known? [(st (ptr CeState)) (name (slice u8))] (-> bool)
  (or (!= (primitive/cast i64 (ce-const st name)) 0)
      (!= (primitive/cast i64 (const-base-get (.base st) name)) 0)))

(defn ce-list-names-const? [(st (ptr CeState)) (ts (ptr (ArrayList Type)))] (-> bool)
  (and (!= (primitive/cast i64 ts) 0)
       (block :found
         (for [i 0 (len (load ts))]
           (when (ce-names-const? st (load (elem ts i))) (break :found true)))
         false)))

;;; Rewrite each length in `t` that names a constant to its value, and each
;;; `(const N)` to N's value. A constant listed for a run is
;;; left in place and recorded as what the declaration being walked waits on.
(defn ce-type! [(st (ptr CeState)) (t (ptr Type))] (-> (Result i64 Diag))
  (try
    (do
      (when (ce-names-const? st (load t))
        (match (load t)
          (TArray [e k]
            (do (try! (ce-type! st e))
                (match k
                  (ParamExtent [nm]
                    (do (when (ce-known? st nm)
                          (if (ce-deferred? st nm)
                              (do (set! (.hit st) nm) 0)
                              (let [v (try! (ce-const-value st nm))]
                                (when (< v 0)
                                  (break :try (Err [i64 Diag]
                                                   (ce-site-diag nm (sconcat3 (.a st)
                                                                              (sconcat3 (.a st) "array length '" (ce-shown nm) "' is ")
                                                                              (i64->str (.a st) v)
                                                                              "; a length cannot be negative")))))
                                (store! t (TArray e (FixedExtent v)))
                                0)))
                        0))
                  (_ 0))))
          (TPtr [i] (try! (ce-type! st i)))
          (TRef [_ i] (try! (ce-type! st i)))
          (TSlice [i] (try! (ce-type! st i)))
          (TVec [i _] (try! (ce-type! st i)))
          (TFn [_ ps r] (do (try! (ce-types! st ps)) (try! (ce-type! st r))))
          (TApp [_ args] (try! (ce-types! st args)))
          (TConst [v]
            (match v
              (ConstRef [nm]
                (let [cp (ce-const st nm)
                      written (if (= (primitive/cast i64 cp) 0)
                                  (const-literal-value (field (const-base-get (.base st) nm) value))
                                  (const-literal-value (field cp value)))]
                  (match written
                    (Some [lit] (do (store! t (TConst lit)) 0))
                    (None []
                      (if (ce-deferred? st nm)
                          (do (set! (.hit st) nm) 0)
                          ; a constant of another kind is the checker's to report
                          (match (ce-const-value st nm)
                            (Ok [n] (do (store! t (TConst (ConstInt n))) 0))
                            (Err [_] 0)))))))
              (_ 0)))
          (_ 0))
        0)
      (Ok [i64 Diag] 0))))

(defn ce-types! [(st (ptr CeState)) (ts (ptr (ArrayList Type)))] (-> (Result i64 Diag))
  (try (do (unless (= (primitive/cast i64 ts) 0)
             (for [i 0 (len (load ts))] (try! (ce-type! st (elem ts i)))))
           (Ok [i64 Diag] 0))))

;;; `ty` with its constants put in place.
(defn ce-ty [(st (ptr CeState)) (ty Type)] (-> (Result Type Diag))
  (let [cell (box-type (.a st) ty)]
    (match (ce-type! st cell)
      (Err [d] (Err [Type Diag] d))
      (Ok [_] (Ok [Type Diag] (load cell))))))

;;; The types one expression node holds. A node is rewritten only when one of
;;; them names a constant: the walk visits every node of the program.
(defn ce-expr-node! [(st (ptr CeState)) (e (ptr Expr))] (-> (Result i64 Diag))
  (try
    (do
      (match (.kind e)
        (EZeroed [ty]
          (when (ce-names-const? st ty) (set! (.kind e) (EZeroed (try! (ce-ty st ty)))) 0))
        (ECall [_ ts _] (try! (ce-types! st ts)))
        (ENamedCall [_ ts _ _] (try! (ce-types! st ts)))
        (EBracketCall [_ ts args v]
          (do (try! (ce-types! st ts))
              (unless (= (primitive/cast i64 args) 0)
                (for [i 0 (len (load args))]
                  (push! (mut (.stack st)) (elem args i))))
              (unless (= (primitive/cast i64 v) 0) (push! (mut (.stack st)) v) 0)
              0))
        (EFnPtrInst [_ ts] (try! (ce-types! st ts)))
        (EAlloc [storage ty init symbol]
          (when (ce-names-const? st ty)
            (set! (.kind e) (EAlloc :storage storage :ty (try! (ce-ty st ty)) :init init :symbol symbol))
            0))
        (ECast [ty inner]
          (when (ce-names-const? st ty) (set! (.kind e) (ECast (try! (ce-ty st ty)) inner)) 0))
        (ESizeOf [ty]
          (when (ce-names-const? st ty) (set! (.kind e) (ESizeOf (try! (ce-ty st ty)))) 0))
        (EAlignOf [ty]
          (when (ce-names-const? st ty) (set! (.kind e) (EAlignOf (try! (ce-ty st ty)))) 0))
        (EOffsetOf [ty f]
          (when (ce-names-const? st ty) (set! (.kind e) (EOffsetOf (try! (ce-ty st ty)) f)) 0))
        (ELlvmIr [ty args body]
          (when (ce-names-const? st ty) (set! (.kind e) (ELlvmIr (try! (ce-ty st ty)) args body)) 0))
        (EIntrinsic [op ty args]
          (when (ce-names-const? st ty) (set! (.kind e) (EIntrinsic op (try! (ce-ty st ty)) args)) 0))
        (ETypeQuery [q ty]
          (when (ce-names-const? st ty) (set! (.kind e) (ETypeQuery q (try! (ce-ty st ty)))) 0))
        (EFieldMeta [m ty idx]
          (when (ce-names-const? st ty) (set! (.kind e) (EFieldMeta m (try! (ce-ty st ty)) idx)) 0))
        (EFieldIndex [ty nm]
          (when (ce-names-const? st ty) (set! (.kind e) (EFieldIndex (try! (ce-ty st ty)) nm)) 0))
        (EAscribe [ty inner]
          (when (ce-names-const? st ty) (set! (.kind e) (EAscribe (try! (ce-ty st ty)) inner)) 0))
        (EMakeSlice [d ty k]
          (when (ce-names-const? st ty) (set! (.kind e) (EMakeSlice d (try! (ce-ty st ty)) k)) 0))
        (EDynDispatch [dc] (let [ds (.dyn_struct dc) vs (.vtable_struct dc) mi (.method_index dc) cc (.cc dc) ps (.params dc) r (.ret dc) recv (.recv dc) args (.args dc)]
          (do (try! (ce-types! st ps))
              (when (ce-names-const? st r)
                (set! (.kind e) (EDynDispatch (box! (.a st) DynCall (DynCall :dyn_struct ds :vtable_struct vs :method_index mi :cc cc :params ps :ret (try! (ce-ty st r)) :recv recv :args args))))
                0))))
        (EPattern [op ty inner idx]
          (when (ce-names-const? st ty) (set! (.kind e) (EPattern op (try! (ce-ty st ty)) inner idx)) 0))
        (EVector [op r ots args]
          (do (try! (ce-types! st ots))
              (when (ce-names-const? st r)
                (set! (.kind e) (EVector op (try! (ce-ty st r)) ots args))
                0)))
        (EConstParam [nm ty]
          (when (ce-names-const? st ty) (set! (.kind e) (EConstParam nm (try! (ce-ty st ty)))) 0))
        (ERecordInit [ty]
          (when (ce-names-const? st ty) (set! (.kind e) (ERecordInit (try! (ce-ty st ty)))) 0))
        (_ 0))
      (Ok [i64 Diag] 0))))

(defn ce-expr! [(st (ptr CeState)) (root (ptr Expr))] (-> (Result i64 Diag))
  (try
    (do
      (set! (.len (field st stack)) 0)
      (push! (mut (.stack st)) root)
      (loop
        (match (pop! (mut (.stack st)))
          (None [] (break))
          (Some [e]
            (do (try! (ce-expr-node! st e))
                (ownership-children! e (field st stack))
                0))))
      (Ok [i64 Diag] 0))))

(defn ce-exprs! [(st (ptr CeState)) (es (ptr (ArrayList Expr)))] (-> (Result i64 Diag))
  (try (do (unless (= (primitive/cast i64 es) 0)
             (for [i 0 (len (load es))] (try! (ce-expr! st (elem es i)))))
           (Ok [i64 Diag] 0))))

(defn ce-params! [(st (ptr CeState)) (ps (ptr (ArrayList Param)))] (-> (Result i64 Diag))
  (try (do (unless (= (primitive/cast i64 ps) 0)
             (for [i 0 (len (load ps))] (try! (ce-type! st (field (elem ps i) ty)))))
           (Ok [i64 Diag] 0))))

(defn ce-fields! [(st (ptr CeState)) (fs (ptr (ArrayList Field)))] (-> (Result i64 Diag))
  (try (do (unless (= (primitive/cast i64 fs) 0)
             (for [i 0 (len (load fs))] (try! (ce-type! st (field (elem fs i) ty)))))
           (Ok [i64 Diag] 0))))

;;; A function's signature, and its body when resolution met a type naming a
;;; constant there: most bodies have none, and are not searched.
(defn ce-func! [(st (ptr CeState)) (f (ptr Func))] (-> (Result i64 Diag))
  (try (do (try! (ce-params! st (load (field f params))))
           (try! (ce-type! st (field f ret)))
           (when (constant-names-in-body? (.name f))
             (try! (ce-exprs! st (load (field f body))))
             0)
           (Ok [i64 Diag] 0))))

;;; The declaration NAME was just walked: record the listed constant one of
;;; its lengths named, if any.
(defn ce-owner! [(st (ptr CeState)) (name (slice u8))] (-> i64)
  (unless (= (.hit st) "")
    (set! (mut (.waits st)) name (.hit st))
    (set! (.hit st) "")
    0)
  0)

;;; The name an impl is recorded under when one of its lengths waits.
(defn ce-impl-key [(a (dyn Allocator)) (i i64)] (-> (slice u8))
  (sconcat a "impl#" (i64->str a i)))

;;; Put in place every length whose constant folds, and list (in the returned
;;; state's `pending`) the constants whose values need code run; their lengths
;;; are left for the run. BASE holds the constants a session's earlier
;;; submissions accepted.
(defn constant-lengths-needing-run [(a (dyn Allocator)) (p (ptr Program)) (base (ptr ConstBase))
                                    (imports (ptr (ArrayList ImpEntry)))
                                    (exports (ptr (ArrayList ExpEntry)))]
  (-> (Result (ptr CeState) Diag))
  (constant-lengths-walk! a p base imports exports))

;;; IMPORTS and EXPORTS are P's import and export tables, or null.
(defn constant-lengths-walk! [(a (dyn Allocator)) (p (ptr Program)) (base (ptr ConstBase))
                              (imports (ptr (ArrayList ImpEntry)))
                              (exports (ptr (ArrayList ExpEntry)))]
  (-> (Result (ptr CeState) Diag))
  (try
    (let [st (box! a CeState (CeState :a a
                                      :consts (HashMap::new [(slice u8) i64] a (keyops-borrowed))
                                      :values (HashMap::new [(slice u8) i64] a (keyops-borrowed))
                                      :path (ArrayList::new [(slice u8)] a)
                                      :prog p
                                      :pending (ArrayList::new [(slice u8)] a)
                                      :needs-run false
                                      :hit ""
                                      :waits (HashMap::new [(slice u8) (slice u8)] a (keyops-borrowed))
                                      :stack (ArrayList::new [(ptr Expr)] a)
                                      :indexed false
                                      :base base
                                      :imports imports
                                      :exports exports))
          cs (load (field p consts))]
      ; a session's earlier constants are in `base`, not the program
      (when (and (constant-names-in-types?)
                 (or (> (len (load cs)) 0) (!= (.base st) (const-no-base))))
        (for [i 0 (len (load (field p structs)))]
          (let [sd (elem (load (field p structs)) i)]
            (try! (ce-fields! st (load (field sd fields))))
            (ce-owner! st (.name sd))))
        (for [i 0 (len (load (field p sums)))]
          (let [ud (elem (load (field p sums)) i)
                vs (load (field ud variants))]
            (for [j 0 (len (load vs))]
              (try! (ce-fields! st (load (field (elem vs j) fields)))))
            (ce-owner! st (.name ud))))
        (for [i 0 (len (load (field p externs)))]
          (let [x (elem (load (field p externs)) i)]
            (try! (ce-types! st (load (field x params))))
            (try! (ce-type! st (field x ret)))
            (ce-owner! st (.name x))))
        (for [i 0 (len (load (field p funcs)))]
          (let [f (elem (load (field p funcs)) i)]
            (try! (ce-func! st f))
            (ce-owner! st (.name f))))
        (for [i 0 (len (load (field p impls)))]
          (let [im (elem (load (field p impls)) i)]
            (try! (ce-type! st (field im self_type)))
            (for [j 0 (len (load (field im methods)))]
              (try! (ce-func! st (elem (load (field im methods)) j))))
            (ce-owner! st (ce-impl-key a i))))
        (for [i 0 (len (load (field p traits)))]
          (let [td (elem (load (field p traits)) i)
                ms (load (field td methods))]
            (for [j 0 (len (load ms))]
              (let [m (elem ms j)]
                (try! (ce-params! st (load (field m params))))
                (try! (ce-type! st (field m ret)))))
            (ce-owner! st (.name td))))
        (for [i 0 (len (load cs))]
          (let [c (elem cs i)]
            (match (.ty c)
              (Some [t] (when (ce-names-const? st t) (set! (.ty c) (Some (try! (ce-ty st t)))) 0))
              (None [] 0))
            (try! (ce-expr! st (field c value)))
            (ce-owner! st (.name c))))
        (for [i 0 (len (load (field p asserts)))]
          (try! (ce-expr! st (field (elem (load (field p asserts)) i) cnd)))
          (set! (.hit st) "")))
      (Ok [(ptr CeState) Diag] st))))

; ---- running the constants that need code run --------------------------------

;;; Before the main program P is checked: put each constant an array length
;;; (or a `(const N)`) names in its place, running code for the constants whose
;;; values need it. Only the program's own check runs code: a metaprogram's
;;; closure is checked against an environment of its own, and leaves such a
;;; length for the checker to report.
(defn run-constant-lengths! [(a (dyn Allocator)) (p (ptr Program)) (base (ptr ConstBase))
                             (imports (ptr (ArrayList ImpEntry)))
                             (exports (ptr (ArrayList ExpEntry)))]
  (-> (Result i64 Diag))
  (if (not (constant-names-in-types?))
      (Ok [i64 Diag] 0)
      (let [r (ce-run-rounds! a p base imports exports)]
        (constant-length-values-clear!)
        r)))

;;; Put in place every length whose constant folds; one whose constant needs
;;; code run is left (see `run-constant-lengths!`).
(defn place-constant-lengths! [(a (dyn Allocator)) (p (ptr Program)) (base (ptr ConstBase))
                               (imports (ptr (ArrayList ImpEntry)))
                               (exports (ptr (ArrayList ExpEntry)))]
  (-> (Result i64 Diag))
  (match (constant-lengths-needing-run a p base imports exports)
    (Err [d] (Err [i64 Diag] d))
    (Ok [_] (Ok [i64 Diag] 0))))

;;; The constants the earlier submissions of S's session accepted.
(defn ce-session-base [(s (mut LS))] (-> (ptr ConstBase))
  (let [parent (.parent s)]
    (if (= (primitive/cast i64 parent) 0)
        (const-no-base)
        (let [prior (primitive/cast (ptr Cx) (.checker_context parent))]
          (if (= (primitive/cast i64 prior) 0) (const-no-base) (.const_base prior))))))

;;; D as the check's one diagnostic, owned by no function.
(defn check-failed-before-functions [(a (dyn Allocator)) (s (mut LS)) (d Diag)]
  (-> (Result (ptr Program) Diag))
  (let [(mut dgs) (ArrayList::new [Diag] a)
        (mut owners) (ArrayList::new [(slice u8)] a)]
    (push! (mut dgs) d)
    (push! (mut owners) "")
    (set! (.check_diags s) (box-al [Diag] a (load dgs)))
    (set! (.check_diag_owners s) (box-al [(slice u8)] a (load owners)))
    (Err [(ptr Program) Diag] d)))

;;; `check-program-mode` for the main program: the constants its array lengths
;;; name are computed first, running code where a value needs it.
(defn check-program-running-lengths [(a (dyn Allocator)) (p (ptr Program)) (s (mut LS))
                                     (validate-ownership bool)] (-> (Result (ptr Program) Diag))
  (match (run-constant-lengths! a p (ce-session-base (mut s)) (field s imports) (field s exports))
    (Err [d] (check-failed-before-functions a (mut s) d))
    (Ok [_] (check-program-mode a p (mut s) validate-ownership))))

(defn ce-run-rounds! [(a (dyn Allocator)) (p (ptr Program)) (base (ptr ConstBase))
                      (imports (ptr (ArrayList ImpEntry)))
                      (exports (ptr (ArrayList ExpEntry)))]
  (-> (Result i64 Diag))
  (try
    (do
      (loop
        (let [st (try! (constant-lengths-needing-run a p base imports exports))]
          (when (= (len (.pending st)) 0) (break))
          (try! (ce-run-round! a p st))
          0))
      (Ok [i64 Diag] 0))))

;;; A declaration and the names it refers to.
(defstruct CeDecl [(name (slice u8)) (refs (ptr (ArrayList (slice u8))))])

(defn ce-ref-names [(a (dyn Allocator)) (refs (HashMap (slice u8) i64))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (ArrayList::new [(slice u8)] a)]
    (for [k 0 (.cap refs)]
      (let [e (primitive/index (.slots refs) k)]
        (when (= (.state e) 1) (push! (mut out) (.key e)) 0)))
    (box-al [(slice u8)] a (load out))))

(defn ce-const-refs [(a (dyn Allocator)) (cp (ptr Const))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut refs) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        (mut seen) (HashMap::new [GraphKey i64] a (graph-keyops))]
    (type-refs/const! (mut refs) (mut seen) cp)
    (ce-ref-names a refs)))

(defn ce-func-refs [(a (dyn Allocator)) (fp (ptr Func))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut refs) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        (mut seen) (HashMap::new [GraphKey i64] a (graph-keyops))]
    (type-refs/func! (mut refs) (mut seen) fp)
    (ce-ref-names a refs)))

(defn ce-trait-refs [(a (dyn Allocator)) (tp (ptr TraitDef))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut refs) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        (mut seen) (HashMap::new [GraphKey i64] a (graph-keyops))]
    (type-refs/trait! (mut refs) (mut seen) tp)
    (ce-ref-names a refs)))

(defn ce-type-def-refs [(a (dyn Allocator)) (sd (ptr StructDef)) (ud (ptr SumDef))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut refs) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        (mut seen) (HashMap::new [GraphKey i64] a (graph-keyops))]
    (if (= (primitive/cast i64 sd) 0)
        (type-refs/sum! (mut refs) (mut seen) ud)
        (type-refs/struct! (mut refs) (mut seen) sd))
    (ce-ref-names a refs)))

;;; The types a check cannot lay out while the listed constants are unknown:
;;; a length names one, or a field holds such a type. Each is recorded in WHY
;;; with what it waits on.
(defn ce-left-out-types! [(a (dyn Allocator)) (p (ptr Program))
                          (why (mut (HashMap (slice u8) (slice u8))))] (-> i64)
  (let [pd (box! a Program (load p))
        (mut kept) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        (mut gone) (HashMap::new [(slice u8) i64] a (keyops-borrowed))]
    (drop-undeclared-type-dependents! a pd)
    (for [i 0 (len (load (field pd structs)))]
      (set! (mut kept) (.name (elem (load (field pd structs)) i)) 0))
    (for [i 0 (len (load (field pd sums)))]
      (set! (mut kept) (.name (elem (load (field pd sums)) i)) 0))
    (for [i 0 (len (load (field p structs)))]
      (let [nm (.name (elem (load (field p structs)) i))]
        (unless (contains? kept nm) (set! (mut gone) nm 0) 0)))
    (for [i 0 (len (load (field p sums)))]
      (let [nm (.name (elem (load (field p sums)) i))]
        (unless (contains? kept nm) (set! (mut gone) nm 0) 0)))
    (for [i 0 (len (load (field p structs)))]
      (let [sd (elem (load (field p structs)) i)]
        (when (contains? gone (.name sd))
          (ce-left-out-why! a (mut why) gone (.name sd)
                            (ce-type-def-refs a sd (primitive/cast (ptr SumDef) 0)))
          0)))
    (for [i 0 (len (load (field p sums)))]
      (let [ud (elem (load (field p sums)) i)]
        (when (contains? gone (.name ud))
          (ce-left-out-why! a (mut why) gone (.name ud)
                            (ce-type-def-refs a (primitive/cast (ptr StructDef) 0) ud))
          0)))
    0))

(defn ce-left-out-why! [(a (dyn Allocator))
                        (why (mut (HashMap (slice u8) (slice u8))))
                        (gone (HashMap (slice u8) i64))
                        (name (slice u8))
                        (refs (ptr (ArrayList (slice u8))))] (-> i64)
  (unless (contains? why name)
    (let [(mut cause) name]
      (for [k 0 (len (load refs))]
        (let [r (get (load refs) k)]
          (when (and (!= r name) (contains? gone r))
            (set! cause r)
            (break))))
      (set! (mut why) name (load cause))
      0))
  0)

;;; The listed constants and every compile-time constant they read.
(defn ce-needed-consts [(a (dyn Allocator)) (st (ptr CeState))] (-> (ptr (ArrayList Const)))
  (let [(mut out) (ArrayList::new [Const] a)
        (mut have) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        (mut work) (ArrayList::new [(slice u8)] a)]
    (for [i 0 (len (.pending st))] (push! (mut work) (get (.pending st) i)))
    (loop
      (match (pop! (mut work))
        (None [] (break))
        (Some [nm]
          (let [cp (ce-const st nm)]
            (unless (or (= (primitive/cast i64 cp) 0)
                        (.runtime cp)
                        (contains? have nm))
              (set! (mut have) nm 0)
              (push! (mut out) (load cp))
              (let [refs (ce-const-refs a cp)]
                (for [k 0 (len (load refs))]
                  (push! (mut work) (get (load refs) k))))
              0)
            0))))
    (box-al [Const] a (load out))))

;;; Whatever refers to something that waits, waits too.
(defn ce-spread-waits! [(why (mut (HashMap (slice u8) (slice u8))))
                        (decls (ArrayList CeDecl))] (-> i64)
  (loop
    (let [(mut changed) false]
      (for [i 0 (len decls)]
        (let [d (get decls i)]
          (unless (contains? why (.name d))
            (for [k 0 (len (load (.refs d)))]
              (let [r (get (load (.refs d)) k)]
                (when (and (!= r (.name d)) (contains? why r))
                  (set! (mut why) (.name d) r)
                  (set! changed true)
                  (break))))
            0)))
      (unless (load changed) (break))
      0))
  0)

;;; What waits, while the listed constants of ST are unknown: each declaration
;;; one of their lengths appears in, each type left without a layout, and
;;; whatever among CONSTS, the functions they reach and the traits refers to
;;; one of those, each mapped to what it waits on. WANTED is the closure of
;;; functions CONSTS call.
(defstruct CeWaiting [(why (HashMap (slice u8) (slice u8)))
                      (wanted (ptr (ArrayList (slice u8))))])

(defn ce-waiting [(a (dyn Allocator)) (p (ptr Program)) (st (ptr CeState))
                  (consts (ptr (ArrayList Const)))] (-> (ptr CeWaiting))
  (let [(mut why) (HashMap::new [(slice u8) (slice u8)] a (keyops-borrowed))]
    (for [k 0 (.cap (.waits st))]
      (let [e (primitive/index (.slots (.waits st)) k)]
        (when (= (.state e) 1) (set! (mut why) (.key e) (.val e)) 0)))
    (ce-left-out-types! a p (mut why))
    (let [closure-in (box! a Program (load p))]
      (set! (.consts closure-in) consts)
      (let [wanted (closure-funcs closure-in (box-al [(slice u8)] a (ArrayList::new [(slice u8)] a)) a)
            (mut wanted-set) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
            (mut decls) (ArrayList::new [CeDecl] a)]
        (for [i 0 (len (load wanted))] (set! (mut wanted-set) (get (load wanted) i) 0))
        (for [i 0 (len (load consts))]
          (let [cp (elem consts i)]
            (push! (mut decls) (CeDecl :name (.name cp) :refs (ce-const-refs a cp)))))
        (for [i 0 (len (load (field p funcs)))]
          (let [fp (elem (load (field p funcs)) i)]
            (when (contains? wanted-set (.name fp))
              (push! (mut decls) (CeDecl :name (.name fp) :refs (ce-func-refs a fp)))
              0)))
        (for [i 0 (len (load (field p traits)))]
          (let [tp (elem (load (field p traits)) i)]
            (push! (mut decls) (CeDecl :name (.name tp) :refs (ce-trait-refs a tp)))))
        (ce-spread-waits! (mut why) (load decls))
        (box! a CeWaiting (CeWaiting :why (load why) :wanted wanted))))))

;;; Every name E binds inside itself -- `let` bindings, match-arm bindings and
;;; `fn` parameters -- into BOUND. Scope is ignored: a name bound anywhere in E
;;; counts as bound everywhere in it, which can only find fewer names unbound.
(defn value-binders! [(a (dyn Allocator)) (e (ptr Expr))
                      (bound (mut (HashMap (slice u8) i64)))] (-> i64)
  (match (.kind e)
    (ELet [binds _]
      (for [i 0 (len (load binds))] (set! (mut bound) (.name (elem binds i)) 0)))
    (EMatch [_ arms]
      (for [i 0 (len (load arms))]
        (let [binds (.binds (elem arms i))]
          (for [k 0 (len (load binds))] (set! (mut bound) (get (load binds) k) 0)))))
    (EAnonFn [params _]
      (for [i 0 (len (load params))] (set! (mut bound) (get (load params) i) 0)))
    (_ 0))
  (let [(mut kids) (ArrayList::new [(ptr Expr)] a)]
    (ownership-children! e (mut kids))
    (for [i 0 (len kids)] (value-binders! a (get kids i) (mut bound))))
  0)

;;; Is FUNC a macro by KNOWN (`without-undeclared-value-dependents` maps a
;;; function returning Code to 1)? A call to one not yet expanded holds syntax,
;;; whose names its expansion binds, not values.
(defn known-macro? [(known (ptr (HashMap (slice u8) i64))) (func (slice u8))] (-> bool)
  (match (get (load known) func) (Some [k] (= k 1)) (None [] false)))

;;; The first variable E reads that it does not bind (BOUND) and the program does
;;; not declare (KNOWN), or "". Every declared name E reads or calls goes into REFS.
(defn value-name-undeclared [(a (dyn Allocator)) (e (ptr Expr))
                             (known (ptr (HashMap (slice u8) i64)))
                             (bound (ptr (HashMap (slice u8) i64)))
                             (refs (mut (ArrayList (slice u8))))] (-> (slice u8))
  (match (.kind e)
    (EVar [name]
      (cond (contains? (load bound) name) ""
            (contains? (load known) name) (do (push! (mut refs) name) "")
            :else name))
    (ECall [func _ _]
      (if (known-macro? known func)
          ""
          (do (push! (mut refs) func) (value-children-undeclared a e known bound (mut refs)))))
    (ENamedCall [func _ _ _]
      (if (known-macro? known func)
          ""
          (do (push! (mut refs) func) (value-children-undeclared a e known bound (mut refs)))))
    (EFnPtrOf [name] (do (push! (mut refs) name) ""))
    (_ (value-children-undeclared a e known bound (mut refs)))))

(defn value-children-undeclared [(a (dyn Allocator)) (e (ptr Expr))
                                 (known (ptr (HashMap (slice u8) i64)))
                                 (bound (ptr (HashMap (slice u8) i64)))
                                 (refs (mut (ArrayList (slice u8))))] (-> (slice u8))
  (let [(mut kids) (ArrayList::new [(ptr Expr)] a)
        _ (ownership-children! e (mut kids))
        found (block :found
                (for [i 0 (len kids)]
                  (let [n (value-name-undeclared a (get kids i) known bound (mut refs))]
                    (when (> (len n) 0) (break :found n))))
                "")]
    (free! (mut kids))
    found))

;;; The first name the expressions ES read that neither they nor PARAMS bind and
;;; KNOWN does not declare, or "". Every declared name they read or call goes
;;; into REFS.
(defn exprs-name-undeclared [(a (dyn Allocator)) (es (ptr (ArrayList Expr)))
                             (params (ptr (ArrayList Param)))
                             (known (ptr (HashMap (slice u8) i64)))
                             (refs (mut (ArrayList (slice u8))))] (-> (slice u8))
  (let [(mut bound) (HashMap::new [(slice u8) i64] a (keyops-borrowed))]
    (unless (= (primitive/cast i64 params) 0)
      (for [i 0 (len (load params))] (set! (mut bound) (.name (elem params i)) 0)))
    (for [i 0 (len (load es))] (value-binders! a (elem es i) (mut bound)))
    (let [found (block :found
                  (for [i 0 (len (load es))]
                    (let [n (value-name-undeclared a (elem es i) known (mut bound) (mut refs))]
                      (when (> (len n) 0) (break :found n))))
                  "")]
      (free! (mut bound))
      found)))

;;; What the program P's compile-time code is checked against, for
;;; `without-undeclared-value-dependents`: KNOWN maps every declared value name
;;; (to 1 for a macro), CONSTS and FUNCS index the compile-time constants and the
;;; functions by name, and MEMO holds each one's answer once known.
(defstruct ValueWaits
  [(known (HashMap (slice u8) i64))
   (consts (HashMap (slice u8) i64))
   (funcs (HashMap (slice u8) i64))
   (memo (HashMap (slice u8) (slice u8)))])

;;; The first undeclared name the constant or function NAME reads, directly or
;;; through the constants and functions it reads and calls, or "". A name being
;;; answered counts as clean, which ends a cycle.
(defn value-waits [(a (dyn Allocator)) (p (ptr Program)) (w (ptr ValueWaits)) (name (slice u8))]
  (-> (slice u8))
  (match (get (.memo w) name)
    (Some [answer] answer)
    (None []
      (do
        (set! (mut (.memo w)) name "")
        (let [(mut refs) (ArrayList::new [(slice u8)] a)
              own (match (get (.consts w) name)
                    (Some [ci]
                      (let [cp (elem (.consts p) ci)
                            (mut one) (ArrayList::new [Expr] a)]
                        (push! (mut one) (load (field cp value)))
                        (exprs-name-undeclared a (box-al [Expr] a (load one))
                                               (primitive/cast (ptr (ArrayList Param)) 0)
                                               (field w known) (mut refs))))
                    (None []
                      (match (get (.funcs w) name)
                        (Some [fi]
                          (let [fp (elem (.funcs p) fi)]
                            (if (lazy-body-force! fp)
                                (exprs-name-undeclared a (.body fp) (.params fp)
                                                       (field w known) (mut refs))
                                "")))
                        (None [] ""))))
              answer (if (> (len own) 0)
                         own
                         (block :found
                           (for [i 0 (len refs)]
                             (let [r (value-waits a p w (get refs i))]
                               (when (> (len r) 0) (break :found r))))
                           ""))]
          (free! (mut refs))
          (set! (mut (.memo w)) name answer)
          answer)))))

;;; P for a closure built before the program's `(meta …)` generators have run,
;;; which lacks what they declare: without each compile-time constant that reads
;;; such a name, directly -- `(const V (+ K 1))` with K generated -- or through
;;; the constants and functions it reads and calls (coil.fs's read-file reads the
;;; generated O_CLOEXEC). Kept, the constant fails the closure's check before any
;;; generator has run to declare the name, so no generator could ever run. It is
;;; left out as a struct naming an undeclared type is
;;; (`drop-undeclared-type-dependents!`); code in the closure that really reads it
;;; still fails its own check, and the program's final check, which sees every
;;; generated declaration, reports a name nothing declares. A call to a macro not
;;; yet expanded is syntax and is not looked into, and a function reached only
;;; through trait dispatch is not followed. P itself is returned when it has no
;;; generator left to run.
(defn without-undeclared-value-dependents [(a (dyn Allocator)) (p (ptr Program))] (-> (ptr Program))
  (if (or (= (primitive/cast i64 (.metas p)) 0) (= (len (load (.metas p))) 0))
      p
      (let [cs (.consts p)
            w (box! a ValueWaits
                    (ValueWaits :known (HashMap::new [(slice u8) i64] a (keyops-borrowed))
                                :consts (HashMap::new [(slice u8) i64] a (keyops-borrowed))
                                :funcs (HashMap::new [(slice u8) i64] a (keyops-borrowed))
                                :memo (HashMap::new [(slice u8) (slice u8)] a (keyops-borrowed))))
            (mut dropped) false]
        (for [i 0 (len (load cs))]
          (let [cp (elem cs i)]
            (set! (mut (.known w)) (.name cp) 0)
            (unless (or (.runtime cp) (.declared cp))
              (set! (mut (.consts w)) (.name cp) i)
              0)))
        (for [i 0 (len (load (.funcs p)))]
          (let [f (elem (.funcs p) i)]
            (set! (mut (.known w)) (.name f) (match (.ret f) (TCode [] 1) (_ 0)))
            (set! (mut (.funcs w)) (.name f) i)))
        (for ip (iter (load (.impls p)))
          (for f (iter (load (.methods ip))) (set! (mut (.known w)) (.name f) 0)))
        (for e (iter (load (.externs p))) (set! (mut (.known w)) (.name e) 0))
        (for s (iter (load (.structs p))) (set! (mut (.known w)) (.name s) 0))
        (for u (iter (load (.sums p)))
          (set! (mut (.known w)) (.name u) 0)
          (for v (iter (load (.variants u))) (set! (mut (.known w)) (.name v) 0)))
        (let [(mut kept) (ArrayList::new [Const] a)]
          (for [i 0 (len (load cs))]
            (let [cp (elem cs i)]
              (if (and (not (or (.runtime cp) (.declared cp)))
                       (> (len (value-waits a p w (.name cp))) 0))
                  (do (set! dropped true) 0)
                  (do (push! (mut kept) (load cp)) 0))))
          (if (load dropped)
              (let [q (box! a Program (load p))]
                (set! (.consts q) (box-al [Const] a (load kept)))
                q)
              p)))))

;;; P for a metaprogram's closure, which runs no code to compute a constant:
;;; its lengths put in place where their constants fold, and, when some need
;;; code run, without the constants that would need a type of unknown layout
;;; (the types themselves a closure leaves out on its own).
(defn constant-lengths-for-closure [(a (dyn Allocator)) (p (ptr Program))] (-> (ptr Program))
  ; A closure is checked against no import table of its own.
  (match (constant-lengths-needing-run a p (const-no-base) (primitive/cast (ptr (ArrayList ImpEntry)) 0)
                                    (primitive/cast (ptr (ArrayList ExpEntry)) 0))
    (Err [_] p)
    (Ok [st]
      (if (= (len (.pending st)) 0)
          p
          (let [cs (load (field p consts))
                (mut compile-time) (ArrayList::new [Const] a)]
            (for [i 0 (len (load cs))]
              (unless (.runtime (elem cs i))
                (push! (mut compile-time) (load (elem cs i)))
                0))
            (let [w (ce-waiting a p st (box-al [Const] a (load compile-time)))
                  (mut kept) (ArrayList::new [Const] a)
                  q (box! a Program (load p))]
              (for [i 0 (len (load cs))]
                (let [cp (elem cs i)]
                  (unless (contains? (.why w) (.name cp))
                    (push! (mut kept) (load cp))
                    0)))
              (set! (.consts q) (box-al [Const] a (load kept)))
              q))))))

;;; One round: check the closure of the listed constants that do not wait on a
;;; type of unknown layout, run each, and record its value. A round that can
;;; run none reports the cycle the first one is in.
(defn ce-run-round! [(a (dyn Allocator)) (p (ptr Program)) (st (ptr CeState))] (-> (Result i64 Diag))
  (try
    (let [pending (.pending st)
          needed (ce-needed-consts a st)
          w (ce-waiting a p st needed)
          why (.why w)
          wanted (.wanted w)
          (mut ready) (ArrayList::new [(slice u8)] a)]
      (for [i 0 (len pending)]
        (unless (contains? why (get pending i))
          (push! (mut ready) (get pending i))
          0))
      (when (= (len ready) 0)
        (break :try (Err [i64 Diag] (ce-cycle-diag a st (get pending 0) why))))
      ; the closure without what waits, checked as a program of its own
      (let [staged-in (box! a Program (load p))
            (mut consts) (ArrayList::new [Const] a)
            (mut traits) (ArrayList::new [TraitDef] a)
            (mut impls) (ArrayList::new [ImplDef] a)
            (mut runnable) (ArrayList::new [(slice u8)] a)]
        (for [i 0 (len (load needed))]
          (let [cp (elem needed i)]
            (unless (contains? why (.name cp))
              (push! (mut consts) (load cp))
              0)))
        (for [i 0 (len (load (field p traits)))]
          (let [tp (elem (load (field p traits)) i)]
            (unless (contains? why (.name tp))
              (push! (mut traits) (load tp))
              0)))
        (for [i 0 (len (load (field p impls)))]
          (unless (contains? why (ce-impl-key a i))
            (push! (mut impls) (load (elem (load (field p impls)) i)))
            0))
        (for [i 0 (len (load wanted))]
          (unless (contains? why (get (load wanted) i))
            (push! (mut runnable) (get (load wanted) i))
            0))
        (set! (.consts staged-in) (box-al [Const] a (load consts)))
        (set! (.traits staged-in) (box-al [TraitDef] a (load traits)))
        (set! (.impls staged-in) (box-al [ImplDef] a (load impls)))
        (let [staged (closure-subprogram staged-in (box-al [(slice u8)] a (load runnable)) a)
              checkls (primitive/alloc-stack LS)
              cxo (primitive/alloc-stack (ptr Cx))]
          (ls-init! (mut checkls) a)
          ; The closure's code is the program's, and is read under its imports.
          (unless (= (primitive/cast i64 (.imports st)) 0)
            (set! (.imports checkls) (ls-copy-list [ImpEntry] a (load (.imports st))))
            0)
          (unless (= (primitive/cast i64 (.exports st)) 0)
            (set! (.exports checkls) (ls-copy-list [ExpEntry] a (load (.exports st))))
            0)
          (store! cxo (primitive/cast (ptr Cx) 0))
          (let [checked (try! (check-program-into* a staged (mut checkls) true false cxo))
                ctc (mk-ctctx checked a)]
            (for [i 0 (len ready)]
              (let [nm (get ready i)]
                (constant-length-values-set! nm (try! (ce-run-value a st (load cxo) ctc nm)))))
            (Ok [i64 Diag] (len ready))))))))

;;; The integer a folded value reduced to.
(defn ce-literal-int [(e (ptr Expr))] (-> (Option i64))
  (match (.kind e)
    (EInt [n] (Some n))
    (ECast [_ inner] (ce-literal-int inner))
    (EAscribe [_ inner] (ce-literal-int inner))
    (_ (None [i64]))))

;;; Run the constant NAME, checked in CX, and read back its integer value.
(defn ce-run-value [(a (dyn Allocator)) (st (ptr CeState)) (cx (ptr Cx)) (ctc (ptr coil.compiler.ctval.CtCtx))
                    (name (slice u8))] (-> (Result i64 Diag))
  (try
    (let [cp (ce-const st name)
          shown (ce-shown name)
          ce (if (= (primitive/cast i64 cx) 0) (primitive/cast (ptr ConstEntry) 0) (const-find cx name))]
      (when (= (primitive/cast i64 ce) 0)
        (break :try (Err [i64 Diag]
                         (derr (sconcat3 a "array length '" shown
                                         "': the constant is missing from the checked closure that computes it (compiler bug)")))))
      (match (.ty ce)
        (TInt [_ _] 0)
        (_ (break :try (Err [i64 Diag]
                            (ce-expr-diag (field cp value)
                                          (sconcat a (sconcat3 a "array length '" shown "' is a constant of type ")
                                                   (sconcat a (ty-str a (field ce ty)) "; a length is an integer")))))))
      (let [v (field ce value)
            ep (box-expr a (mk-expr (EComptime (semantic-clone-expr-ptr a v))
                                    (.lo v) (.hi v) (.source v) (.ctxt v)))]
        (match (ce-literal-int v)
          (Some [n] (Ok [i64 Diag] n))
          (None []
            (do (try! (fold-expr ep ctc))
                (match (ce-literal-int ep)
                  (Some [n] (Ok [i64 Diag] n))
                  (None [] (Err [i64 Diag]
                                (ce-expr-diag (field cp value)
                                              (sconcat3 a "array length '" shown
                                                        "': the constant's value does not fit in 64 bits"))))))))))))

;;; The cycle the listed constant START is in, along the path of what waits on
;;; what.
(defn ce-cycle-diag [(a (dyn Allocator)) (st (ptr CeState)) (start (slice u8))
                     (why (HashMap (slice u8) (slice u8)))] (-> Diag)
  (let [(mut chain) (ce-shown start)
        (mut seen) (HashMap::new [(slice u8) i64] a (keyops-borrowed))
        (mut cur) start
        cp (ce-const st start)]
    (set! (mut seen) start 0)
    (loop
      (match (get why (load cur))
        (None [] (break))
        (Some [next]
          (do (set! chain (sconcat3 a (load chain) " -> " (ce-shown next)))
              (when (contains? seen next) (break))
              (set! (mut seen) next 0)
              (set! cur next)
              0))))
    (ce-expr-diag (field cp value)
                  (sconcat a (sconcat3 a "array length '" (ce-shown start)
                                       "': the constant is computed by running code that needs a type whose layout waits on the constant (")
                           (sconcat a (load chain) ")")))))

(defn check-program-into* [(a (dyn Allocator))
                           (p (ptr Program))
                           (s (mut LS))
                           (validate-ownership bool)
                           (replaces-meta-consts bool)
                           (cx-out (ptr (ptr Cx)))] (-> (Result (ptr Program)
                                                                Diag))
  ; before anything reads a type: a length that names a constant
  (match (place-constant-lengths! a p (ce-session-base (mut s)) (field s imports) (field s exports))
    ; reported like a setup failure (see below): not a function's diagnostic
    (Err [d] (check-failed-before-functions a (mut s) d))
    (Ok [_] (check-program-lengths-placed* a p (mut s) validate-ownership
                                           replaces-meta-consts cx-out))))

(defn check-program-lengths-placed* [(a (dyn Allocator))
                                     (p (ptr Program))
                                     (s (mut LS))
                                     (validate-ownership bool)
                                     (replaces-meta-consts bool)
                                     (cx-out (ptr (ptr Cx)))] (-> (Result (ptr Program)
                                                                          Diag))
  (tr/count "check.function-count" (len (load (field p funcs))))
  (tr/count "check.authoritative" (if validate-ownership 1 0))
  ; The three side maps have distinct record densities. These estimates cover
  ; the large generated compiler and app checks without forcing every binding
  ; and resolved-call table to match the much denser type table.
  (let [(mut functions) 0
        (mut inherited-types) 0
        (mut inherited-bindings) 0
        (mut inherited-resolutions) 0
        parent (.parent s)]
    (for [i 0 (len (load (.funcs p)))]
      (unless (ls-accepted-function? (mut s) (elem (.funcs p) i))
        (set! functions (+ (load functions) 1)) 0))
    (unless (= (primitive/cast i64 parent) 0)
      (let [maps (primitive/cast (ptr SemMapsSnap) (.semantic_maps parent))]
        (unless (= (primitive/cast i64 maps) 0)
          (set! inherited-types (.len (field maps tindex)))
          (set! inherited-bindings (.len (field maps bindex)))
          (set! inherited-resolutions (.len (field maps rindex))) 0))
      0)
    (semantic-maps-reset-reserved (+ (load inherited-types) (* (load functions) 64))
                                  (+ (load inherited-bindings) (* (load functions) 24))
                                  (+ (load inherited-resolutions) (* (load functions) 32))))
  (unless (= (primitive/cast i64 (.parent s)) 0)
    (let [maps (.semantic_maps (.parent s))]
      (unless (= (primitive/cast i64 maps) 0)
        (sem-maps-inherit! (primitive/cast (ptr SemMapsSnap) maps))
        0))
    0)
  (let [impb
          (box! a (ArrayList ImpEntry) (primitive/zeroed (ArrayList ImpEntry)))
        expb
          (box! a (ArrayList ExpEntry) (primitive/zeroed (ArrayList ExpEntry)))
        cx (box! a Cx (primitive/zeroed Cx))]
    (set! (.cx (drop-memo)) 0)
    (set! (.buf (trait-use-index)) 0)
    (set! (.anon_funcs cx) (ArrayList::new [Func] a))
    (set! (.anon_c_entries cx) (ArrayList::new [ExportC] a))
    (set! (.anon_counter cx) 0)
    (set! (.anon_outer_env cx) (primitive/cast (ptr (ArrayList EnvEntry)) 0))
    (set! (.validate_anon_ownership cx) validate-ownership)
    (set! (.recovered_diags cx) (ArrayList::new [Diag] a))
    (set! (.recover_statements cx) (not validate-ownership))
    (set! (.replaces_meta_consts cx) replaces-meta-consts)
    (set! (.trait_uses cx) (ArrayList::new [MonoTraitUse] a))
    (set! impb (.imports s))
    (set! expb (.exports s))
    (let [setup-span (tr/span-begin "frontend.check.setup")
          setup-result (setup-retained a cx p impb expb (.parent s))
          _setup-end (tr/span-end setup-span)]
      (match setup-result
        (Err [d]
             ; A setup failure (a const value, an extern, a signature) is not a
             ; FUNCTION diagnostic, so `check-all-funcs` — which owns this sink —
             ; never runs and never records it. Record it here, with the empty
             ; owner that marks a non-function diagnostic. `stage3-round` reads
             ; this list to steer tower recovery: a rejected macro-headed call is
             ; expanded and the round retried. Leaving the sink empty made every
             ; such diagnostic unrecoverable, which is why a macro call in a
             ; `const` initializer reached the user as a raw `Code` type error
             ; instead of being expanded like the same call in a function body.
             (let [(mut dgs) (ArrayList::new [Diag] a)
                   (mut owners) (ArrayList::new [(slice u8)] a)]
               (push! (mut dgs) d)
               (push! (mut owners) "")
               (set! (.check_diags s) (box-al [Diag] a (load dgs)))
               (set! (.check_diag_owners s)
                     (box-al [(slice u8)] a (load owners)))
               (Err [(ptr Program) Diag] d)))
        (Ok [allf]
            (set! (.checker_context s) (primitive/cast (ptr i8) cx))
            (set! (.entry_module cx) (.entry_module s))
            (unless (= (primitive/cast i64 cx-out) 0)
              (store! cx-out cx)
              0)
            (let [functions-span (tr/span-begin "frontend.check.functions")
                  functions-result
                    (check-all-funcs a cx allf (mut s) validate-ownership)
                  _functions-end (tr/span-end functions-span)]
              (match functions-result
                (Err [d] (Err [(ptr Program) Diag] d))
                (Ok [funcs]
                    (let [finish-span (tr/span-begin "frontend.check.finish")
                          result (finish a cx p (mut s) funcs)
                          _finish-end (tr/span-end finish-span)]
                      (tr/count "semantic.type.records" (len (load (type-map-list))))
                      (tr/count "semantic.type.capacity" (.cap (type-map-list)))
                      (tr/count "semantic.binding.records" (len (load (bind-map-list))))
                      (tr/count "semantic.binding.capacity" (.cap (bind-map-list)))
                      (tr/count "semantic.resolution.records" (len (load (res-map-list))))
                      (tr/count "semantic.resolution.capacity" (.cap (res-map-list)))
                      result)))))))))

; Provisional semantic models expose resolved calls, inferred types, and canonical
; binding identities to ownership-elaboration transforms, but deliberately stop
; before affine validation and drop insertion. Transform output is never trusted:
; the ordinary entry point below rebuilds all maps and performs authoritative
; ownership checking after the transform reaches its declared completion point.
(defn check-program-synthesis [(a (dyn Allocator))
                               (p (ptr Program))
                               (s (mut LS))] (-> (Result (ptr Program) Diag))
  (check-program-mode a p (mut s) false))

(defn check-program [(a (dyn Allocator)) (p (ptr Program)) (s (mut LS))] (-> (Result (ptr Program)
                                                                                     Diag))
  (check-program-mode a p (mut s) true))

; ============================ the mono pass =====================
; A PURE specializer: the checker already wrote explicit type-args on every
; generic call/construction, so mono instantiates each generic func/struct/sum
; per concrete type-arg set, rewrites calls to the specialized (mangled) names,
; and drops the generic templates. Output is a Program with no remaining
; generics. mono's String errors become spanless Diags (derr, lo=hi=-1) so they
; dump as (error@D:D "...").

; A type-parameter substitution (param-name -> concrete Type), parallel lists.)
