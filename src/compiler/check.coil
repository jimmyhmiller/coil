; src/compiler/check.coil — self-host Coil compiler, check module.

(module check)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.reader" :use *)
(import "ast" :use *)
(import "astdump" :use *)
(import "comptime" :use *)
(import "loader" :use *)
(import "parser" :use *)
(import "resolve" :use *)
(import "coil.hashmap" :use *)  ; the signature-name index (sig-find)
(import "trace" :as tr)

; the last `.`-separated component of a qualified name (the link/C symbol).
; Lives here (not in codegen.coil) so check has no codegen/LLVM dependency and
; the frontend can be built LLVM-free; codegen imports check and reuses it.
(defn last-component [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        (mut i) (primitive/isub n 1)
        (mut start) 0]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (if (= (primitive/cast i64 (slice-get s (load i))) (primitive/cast i64 46))
                  (do (set! start (primitive/iadd (load i) 1)) (set! i -1))
                  (set! i (primitive/isub (load i) 1)))))
    (substr s (load start) n)))

(defstruct Sig
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))
   ; Empty for externs, whose declarations carry types but no parameter names.
   (param_names (ptr (ArrayList (slice u8))))
   (params (ptr (ArrayList Type)))
   (ret Type)
   (is_extern bool)
   (variadic bool)
   (cc (slice u8))
   (fnptr_ok bool)])

(defstruct StructInfo
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))
   (fields (ptr (ArrayList Field)))
   (is_bits bool)])

(defstruct SumInfo
  [(name (slice u8))
   (type_params (ptr (ArrayList (slice u8))))
   (bounds (ptr (ArrayList Bound)))
   (variants (ptr (ArrayList Variant)))])

(defstruct VtoS [(variant (slice u8)) (sum (slice u8))])

(defstruct ConstEntry [(name (slice u8)) (value Expr) (ty Type)])

(defstruct MethodEntry [(name (slice u8)) (trait (slice u8)) (self_idx i64)])

; NOTE: registered impls are stored as plain `ImplDef`s (see `Cx.impls`). There used to
; be a cut-down `ImplPair {trait, for_type, self_type, type_params}` here — a strict
; SUBSET of ImplDef — and having two record types for one concept forced two copies of
; everything that reasons about impls (specificity, selection), one per type. Mono
; already had `ImplDef`; check now uses it too, so those functions exist once and both
; phases share them.
(defstruct LoopFrame [(label (Option (slice u8))) (break_ty (Option Type)) (expected (Option Type))])

; `bid` is the local-binding identity (see comptime.coil binding-map): a fresh id
; per let-binding / parameter, so `(primitive/binding-of REF)` distinguishes shadows.
(defstruct EnvEntry [(name (slice u8)) (ty Type) (bid i64)])

(defstruct EvalPair [(e Expr) (t Type)])

(defstruct FBox [(items (ArrayList Func))])

(defstruct ImplBucket [(items (ArrayList i64))])

(defstruct Cx
  [(a (dyn Allocator))
   (annotation_defs (ptr (ArrayList AnnotationDef)))
   ; annotation key -> index into `annotation_defs`
   (annotation_idx (HashMap (slice u8) i64))
   (sigs (ArrayList Sig))
   ; name -> index into `sigs` of the LAST signature declared under it; see sig-find
   (sigidx (HashMap (slice u8) i64))
   (structs (ArrayList StructInfo))
   (sums (ArrayList SumInfo))
   (variant_to_sum (ArrayList VtoS))
   (consts (ArrayList ConstEntry))
   (static_consts (ArrayList (slice u8)))
   (trait_defs (ArrayList TraitDef))
   (methods (ArrayList MethodEntry))
   (impls (ArrayList ImplDef))
   ; Candidate buckets contain indices into `impls`. Dispatch hashes directly to
   ; the relevant trait/type or method/type bucket instead of scanning every impl.
   (trait_impl_idx (HashMap (slice u8) (ptr ImplBucket)))
   (inherent_impl_idx (HashMap (slice u8) (ptr ImplBucket)))
   (inherent_name_idx (HashMap (slice u8) (ptr ImplBucket)))
   ; Exact concrete trait selections made by the checker. Deferred generic
   ; selections are appended by mono to the same structural report.
   (trait_uses (ArrayList MonoTraitUse))
   (imports (ptr (ArrayList ImpEntry)))
   (exports (ptr (ArrayList ExpEntry)))
   (conventions (ptr (ArrayList Convention)))
   (cur_bounds (ArrayList Bound))
   (loops (ArrayList LoopFrame))
   ; The entry file's module — the module `main` was written in. `main` is never
   ; renamed, so it is the one function whose own name cannot say where it lives.
   (entry_module (slice u8))])

(defn mk-evalpair [(e Expr) (t Type)] (-> EvalPair)
  (let [p (primitive/alloc-stack EvalPair)] (set! (.e p) e) (set! (.t p) t) (load p)))

(defn env-new [(a (dyn Allocator))] (-> (ptr (ArrayList EnvEntry)))
  (box-al [EnvEntry] a (al-new [EnvEntry] a)))

; Length-prefix the left component so `(ab,c)` cannot alias `(a,bc)`.
(defn impl-index-key [(a (dyn Allocator)) (left (slice u8)) (right (slice u8))] (-> (slice u8))
  (sconcat a (sconcat3 a (i64->str a (slice-len left)) ":" left) right))

(defn impl-index-add! [(a (dyn Allocator))
                       (idx (mut (HashMap (slice u8) (ptr ImplBucket))))
                       (key (slice u8))
                       (value i64)] (-> i64)
  (match (hm-get [(slice u8) (ptr ImplBucket)] (load idx) key)
    (Some [bucket] (al-push! (mut (.items bucket)) value))
    (None []
          (let [bucket (box! a ImplBucket (primitive/zeroed ImplBucket))]
            (set! (.items bucket) (al-new [i64] a))
            (al-push! (mut (.items bucket)) value)
            (hm-put! [(slice u8) (ptr ImplBucket)] (mut idx) key bucket))))
  0)

(defn impl-index-get [(idx (ptr (HashMap (slice u8) (ptr ImplBucket))))
                      (key (slice u8))] (-> (ptr ImplBucket))
  (match (hm-get [(slice u8) (ptr ImplBucket)] (load idx) key)
    (Some [bucket] bucket)
    (None [] (primitive/cast (ptr ImplBucket) 0))))

(defn checker-trait-use-record! [(cx (ptr Cx))
                                 (caller-source (slice u8))
                                 (trait-name (slice u8))
                                 (impl-source (slice u8))
                                 (method-name (slice u8))
                                 (generated (slice u8))] (-> i64)
  (let [(mut found) false]
    (for [i 0 (al-len [MonoTraitUse] (.trait_uses cx))]
      (let [use (al-elem [MonoTraitUse] (field cx trait_uses) i)]
        (if (and (= (.caller_source use) caller-source)
                 (and (= (.trait_name use) trait-name)
                      (and (= (.impl_source use) impl-source)
                           (and (= (.method_name use) method-name)
                                (= (.generated_artifact use) generated)))))
            (set! found true)
            0)))
    (if (load found)
        0
        (let [use (primitive/alloc-stack MonoTraitUse)]
          (set! (.caller_source use) caller-source)
          (set! (.trait_name use) trait-name)
          (set! (.impl_source use) impl-source)
          (set! (.method_name use) method-name)
          (set! (.generated_artifact use) generated)
          (al-push! (mut (field cx trait_uses)) (load use))
          0))))

; ---- Cx table lookups (return a live (ptr T) or null) ----------------------
; Record that the signature just appended is the one `name` now resolves to. Overwriting
; is the point: on a duplicate name the LAST one declared wins, which is exactly what a
; map insert does — the behaviour the old scan spelled out by deliberately NOT breaking
; on a match and running to the end of the list every time.
(defn sig-index-put! [(cx (ptr Cx)) (name (slice u8))] (-> i64)
  (hm-put! [(slice u8) i64]
           (mut (.sigidx cx))
           name
           (primitive/isub (al-len [Sig]
                                   (.sigs cx))
                           1))
  0)

; The signature `name` resolves to, or null. This is asked once per CALL SITE against
; every signature in the program; as a str-eq scan that ran to completion (see above) it
; was O(calls × functions) — quadratic in program size, and the largest single cost left
; in `check`. The index gives the identical answer in one probe.
(defn sig-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr Sig))
  (match (hm-get [(slice u8) i64] (.sigidx cx) name)
    (None [] (primitive/cast (ptr Sig) 0))
    (Some [i] (al-elem [Sig] (field cx sigs) i))))

; Levenshtein edit distance between two byte slices. Cold path (only computed
; when a call is already known-undefined), so a straightforward two-rolling-rows
; DP in scratch heap memory is fine.
(defn edit-dist [(a (dyn Allocator)) (s (slice u8)) (t (slice u8))] (-> i64)
  (let [m (slice-len s)
        n (slice-len t)]
    (if (= m (primitive/cast i64 0))
        n
        (if (= n (primitive/cast i64 0))
            m
            (let [prev
                    (slice-data (match (alloc [i64] a (primitive/iadd n 1))
                                  (Some [s] s)
                                  (None []
                                        (do
                                          (oom-at c"compiler check" -1)
                                          (alloc/alloc-slice-new (primitive/cast (ptr i64) 0) 0)))))
                  cur
                    (slice-data (match (alloc [i64] a (primitive/iadd n 1))
                                  (Some [s] s)
                                  (None []
                                        (do
                                          (oom-at c"compiler check" -1)
                                          (alloc/alloc-slice-new (primitive/cast (ptr i64) 0) 0)))))
                  (mut j) 0]
              (loop (if (> (load j) n)
                        (break)
                        (do
                          (set! (primitive/index prev (load j)) (load j))
                          (set! j (primitive/iadd (load j) 1)))))
              (let [(mut i) 1]
                (loop (if (> (load i) m)
                          (break)
                          (do
                            (set! (primitive/index cur 0) (load i))
                            (let [(mut jj) 1]
                              (loop (if (> (load jj) n)
                                        (break)
                                        (let [cost
                                                (unless (= (primitive/cast i64
                                                                           (slice-get s (primitive/isub (load i) 1)))
                                                           (primitive/cast i64
                                                                           (slice-get t (primitive/isub (load jj) 1))))
                                                  1)
                                              del (primitive/iadd (load (primitive/index prev (load jj))) 1)
                                              ins
                                                (primitive/iadd (load (primitive/index cur (primitive/isub (load jj) 1)))
                                                                1)
                                              sub
                                                (primitive/iadd (load (primitive/index prev
                                                                                       (primitive/isub (load jj) 1)))
                                                                cost)
                                              mn (if (< del ins) del ins)
                                              best (if (< mn sub) mn sub)]
                                          (do
                                            (set! (primitive/index cur (load jj)) best)
                                            (set! jj (primitive/iadd (load jj) 1)))))))
                            (let [(mut k) 0]
                              (loop (if (> (load k) n)
                                        (break)
                                        (do
                                          (set! (primitive/index prev (load k)) (load (primitive/index cur (load k))))
                                          (set! k (primitive/iadd (load k) 1))))))
                            (set! i (primitive/iadd (load i) 1)))))
                (load (primitive/index prev n))))))))

; The closest name in `cands` to `name` within a length-scaled edit budget (short
; names need a near-exact match, long names tolerate more), or None when even the
; nearest is too far to be a plausible typo. THE one "did you mean" ranking — both
; the check-time (`suggest-callable`) and resolve-time undefined-name hints route
; through it, so there is a single definition of what counts as a suggestion.
(defn nearest-name [(a (dyn Allocator)) (cands (ptr (ArrayList (slice u8)))) (name (slice u8))] (-> (Option (slice u8)))
  (let [n (al-len [(slice u8)] (load cands))
        (mut i) 0
        (mut best) -1
        (mut bestnm) name
        budget
          (let [l (slice-len name)
                t (primitive/udiv l 3)]
            (if (< t (primitive/cast i64 1)) 1 t))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [cand (last-component (al-get [(slice u8)] (load cands) (load i)))]
                  (unless (or (= (slice-len cand) (primitive/cast i64 0)) (= cand name))
                    (let [d (edit-dist a name cand)]
                      (when (or (< (load best) (primitive/cast i64 0)) (< d (load best)))
                        (store! best d)
                        (store! bestnm cand)
                        0))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (and (>= (load best) (primitive/cast i64 0)) (<= (load best) budget)) (Some (load bestnm)) (None [(slice u8)]))))

; A "did you mean" suggestion for an undefined call `name`: the closest surface
; name among all known signatures — the auto-referred core/stdlib (`println`/
; `print`/…) is always among them, so a typo of a bundled name gets a hint even
; with no explicit import.
(defn suggest-callable [(a (dyn Allocator)) (cx (ptr Cx)) (name (slice u8))] (-> (Option (slice u8)))
  (let [sigs (field cx sigs)
        n (al-len [Sig] (load sigs))
        (mut names) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut names) (.name (al-elem [Sig] sigs (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (nearest-name a (box-al [(slice u8)] a (load names)) name)))

; Everything BEFORE the last '.' of a qualified name — the module it lives in.
; Empty when the name is unqualified. (`last-component` is the other half.)
(defn module-prefix [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        (mut i) (primitive/isub n 1)
        (mut cut) -1]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (if (= (primitive/cast i64 (slice-get s (load i))) (primitive/cast i64 46))
                  (do (set! cut (load i)) (set! i -1))
                  (set! i (primitive/isub (load i) 1)))))
    (if (< (load cut) (primitive/cast i64 0)) "" (substr s 0 (load cut)))))

; The name EXISTS, exactly, in a module that isn't in scope here — the module it
; comes from. This is checked BEFORE the edit-distance hint, because `nearest-name`
; deliberately skips a candidate equal to the query: without this, asking for a real
; name you simply have not imported produced a typo suggestion for a DIFFERENT
; function ("did you mean 'str-len'?" for `str-eq`, "'al-len'?" for `al-elem`),
; which sends you looking for a misspelling that isn't there.
(defn suggest-out-of-scope [(a (dyn Allocator)) (cx (ptr Cx)) (name (slice u8))] (-> (Option (slice u8)))
  (let [sigs (field cx sigs)
        n (al-len [Sig] (load sigs))
        (mut i) 0
        (mut found) (None [(slice u8)])]
    (loop (if (or (>= (load i) n) (some? [(slice u8)] (load found)))
              (break)
              (do
                (let [qn (.name (al-elem [Sig] sigs (load i)))]
                  (when (= (last-component qn) name)
                    (let [m (module-prefix qn)]
                      (when (> (slice-len m) (primitive/cast i64 0))
                        (store! found (Some m))
                        0))))
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

; The undefined-call message. An exact name in an unimported module is reported as
; such; otherwise a "; did you mean 'X'?" tail when a plausibly intended name exists.
; One definition, used by every call-check site below.
(defn undefined-call-msg [(a (dyn Allocator)) (cx (ptr Cx)) (fname (slice u8)) (func (slice u8))] (-> (slice u8))
  (let [base (sconcat3 a (sconcat3 a "in '" fname "': call to undefined function '") func "'")]
    (match (suggest-out-of-scope a cx func)
      (Some [m]
            (sconcat3 a
                      (sconcat3 a base "; it is defined in module '" m)
                      "', which is not imported here"
                      ""))
      (None []
            (match (suggest-callable a cx func)
              (None [] base)
              (Some [s] (sconcat3 a base "; did you mean '" (sconcat a s "'?"))))))))

(defn struct-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr StructInfo))
  (let [n (al-len [StructInfo] (.structs cx))
        (mut i) 0
        (mut r) (primitive/cast (ptr StructInfo) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [StructInfo] (field cx structs) (load i)) name)) name)
                  (store! r (al-elem [StructInfo] (field cx structs) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn sum-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr SumInfo))
  (let [n (al-len [SumInfo] (.sums cx))
        (mut i) 0
        (mut r) (primitive/cast (ptr SumInfo) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [SumInfo] (field cx sums) (load i)) name)) name)
                  (store! r (al-elem [SumInfo] (field cx sums) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn vts-find [(cx (ptr Cx)) (variant (slice u8))] (-> (ptr VtoS))
  (let [n (al-len [VtoS] (.variant_to_sum cx))
        (mut i) 0
        (mut r) (primitive/cast (ptr VtoS) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [VtoS] (field cx variant_to_sum) (load i)) variant)) variant)
                  (store! r (al-elem [VtoS] (field cx variant_to_sum) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn trait-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr TraitDef))
  (let [n (al-len [TraitDef] (.trait_defs cx))
        (mut i) 0
        (mut r) (primitive/cast (ptr TraitDef) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [TraitDef] (field cx trait_defs) (load i)) name)) name)
                  (store! r (al-elem [TraitDef] (field cx trait_defs) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn const-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr ConstEntry))
  (let [n (al-len [ConstEntry] (.consts cx))
        (mut i) 0
        (mut r) (primitive/cast (ptr ConstEntry) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [ConstEntry] (field cx consts) (load i)) name)) name)
                  (store! r (al-elem [ConstEntry] (field cx consts) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn impl-has [(cx (ptr Cx)) (tr (slice u8)) (forty (slice u8))] (-> bool)
  (!= (primitive/cast i64
                      (impl-index-get (field cx trait_impl_idx)
                                      (impl-index-key (load (field cx a)) tr forty)))
      (primitive/cast i64 0)))

; ============================ pure type helpers ====================
(defn type-is-void [(t (ptr Type))] (-> bool)
  (match (load t) (TVoid [] true) (_ false)))

(defn type-is-never [(t (ptr Type))] (-> bool)
  (match (load t) (TNever [] true) (_ false)))

(defn type-is-int [(t (ptr Type))] (-> bool)
  (match (load t) (TInt [_ _] true) (_ false)))

(defn type-is-float [(t (ptr Type))] (-> bool)
  (match (load t) (TFloat [_] true) (_ false)))

(defn type-is-ptr [(t (ptr Type))] (-> bool)
  (match (load t) (TPtr [_] true) (_ false)))

; type_mentions
(defn type-list-mentions [(v (ptr (ArrayList Type))) (name (slice u8))] (-> bool)
  (let [n (al-len [Type] (load v))
        (mut i) 0
        (mut f) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (type-mentions (al-elem [Type] v (load i)) name) (store! f true) (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load f)))

(defn type-mentions [(t (ptr Type)) (name (slice u8))] (-> bool)
  (match (load t)
    (TStruct [n] (= n name))
    (TRef [m p] (type-mentions p name))
    (TPtr [p] (type-mentions p name))
    (TSlice [p] (type-mentions p name))
    (TArray [p k] (type-mentions p name))
    (TApp [n args] (type-list-mentions args name))
    (TFn [cc ps r] (or (type-list-mentions ps name) (type-mentions r name)))
    (_ false)))

; typename_to_type
(defn typename-to-type [(name (slice u8))] (-> Type)
  (cond (= name "bool") (TBool)
        (= name "externref") (TExternRef)
        (= name "f32") (TFloat 32)
        (= name "f64") (TFloat 64)
        :else
          (let [n (slice-len name)]
            (if (< n (primitive/cast i64 2))
                (TStruct name)
                (let [c0 (primitive/cast i64 (slice-get name 0))]
                  (if (or (= c0 (primitive/cast i64 105)) (= c0 (primitive/cast i64 117)))
                      (let [(mut ok) true
                            (mut val) 0
                            (mut j) 1]
                        (loop (if (>= (load j) n)
                                  (break)
                                  (do
                                    (let [ch (primitive/cast i64 (slice-get name (load j)))]
                                      (if (and (>= ch (primitive/cast i64 48)) (<= ch (primitive/cast i64 57)))
                                          (do
                                            (store! val
                                                    (primitive/iadd (primitive/imul (load val) 10)
                                                                    (primitive/isub ch 48)))
                                            0)
                                          (do (store! ok false) (break))))
                                    (store! j (primitive/iadd (load j) 1)))))
                        (if (load ok) (TInt (load val) (= c0 (primitive/cast i64 105))) (TStruct name)))
                      (TStruct name)))))))

; subst_self
(defn subst-self-list [(a (dyn Allocator)) (v (ptr (ArrayList Type))) (selfp (slice u8)) (concrete (ptr Type))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (al-new [Type] a)
        n (al-len [Type] (load v))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (subst-self a (al-elem [Type] v (load i)) selfp concrete))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn subst-self [(a (dyn Allocator)) (t (ptr Type)) (selfp (slice u8)) (concrete (ptr Type))] (-> Type)
  (match (load t)
    (TStruct [n] (if (= n selfp) (load concrete) (TStruct n)))
    (TRef [m p] (TRef m (box-type a (subst-self a p selfp concrete))))
    (TPtr [p] (TPtr (box-type a (subst-self a p selfp concrete))))
    (TSlice [p] (TSlice (box-type a (subst-self a p selfp concrete))))
    (TArray [p k] (TArray (box-type a (subst-self a p selfp concrete)) k))
    (TApp [n args] (TApp n (subst-self-list a args selfp concrete)))
    (TFn [cc ps r]
         (TFn
           :cc cc
           :params (subst-self-list a ps selfp concrete)
           :ret (box-type a (subst-self a r selfp concrete))))
    (_ (load t))))

; erase_refs
(defn erase-refs-list [(a (dyn Allocator)) (v (ptr (ArrayList Type)))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (al-new [Type] a)
        n (al-len [Type] (load v))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (erase-refs a (al-elem [Type] v (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn erase-refs [(a (dyn Allocator)) (t (ptr Type))] (-> Type)
  (match (load t)
    (TRef [m p] (TPtr (box-type a (erase-refs a p))))
    (TPtr [p] (TPtr (box-type a (erase-refs a p))))
    (TArray [e k] (TArray (box-type a (erase-refs a e)) k))
    (TFn [cc ps r]
         (TFn
           :cc cc
           :params (erase-refs-list a ps)
           :ret (box-type a (erase-refs a r))))
    (_ (load t))))

; param_ref_type
(defn is-aggregate-name [(cx (ptr Cx)) (name (slice u8)) (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (and (not (set-contains tps name))
       (or (!= (primitive/cast i64 (struct-find cx name)) (primitive/cast i64 0))
           (!= (primitive/cast i64 (sum-find cx name))
               (primitive/cast i64 0)))))

(defn param-ref-type [(cx (ptr Cx)) (t (ptr Type)) (tps (ptr (ArrayList (slice u8))))] (-> Type)
  (let [a (load (field cx a))]
    (match (load t)
      (TRef [m p] (load t))
      (TPtr [p] (load t))
      ; Legacy aggregates keep Coil's implicit immutable-reference ABI. An affine
      ; aggregate, however, must preserve a by-value ownership boundary: spelling
      ; `T` consumes it, while `(ref T)` and `(mut T)` explicitly borrow it.
      (TStruct [name]
               (if (is-aggregate-name cx name tps)
                   (if (type-is-affine a cx t) (load t) (TRef false (box-type a (load t))))
                   (load t)))
      (TApp [name args]
            (if (is-aggregate-name cx name tps)
                (if (type-is-affine a cx t) (load t) (TRef false (box-type a (load t))))
                (load t)))
      (TArray [e k] (if (type-is-affine a cx t) (load t) (TRef false (box-type a (load t)))))
      (_ (load t)))))

; Runtime aggregate parameters are still represented by an immutable pointer in a
; function body and in the lowered ABI. This is deliberately separate from the
; semantic call signature above: a plain affine `T` consumes ownership at the call
; boundary, then the callee receives a place containing that owner; explicit `(ref
; T)` remains a non-consuming borrow at both layers.
(defn param-body-ref-type [(cx (ptr Cx))
                           (t (ptr Type))
                           (tps (ptr (ArrayList (slice u8))))] (-> Type)
  (let [a (load (field cx a))]
    (match (load t)
      (TRef [_ _] (load t))
      (TPtr [_] (load t))
      (TStruct [name] (if (is-aggregate-name cx name tps) (TRef false (box-type a (load t))) (load t)))
      (TApp [name _] (if (is-aggregate-name cx name tps) (TRef false (box-type a (load t))) (load t)))
      (TArray [_ _] (TRef false (box-type a (load t))))
      (_ (load t)))))

; is_literal, is_literal_value (2827), numeric/is_cond/etc.
(defn al-last-expr [(v (ptr (ArrayList Expr)))] (-> (ptr Expr))
  (let [n (al-len [Expr] (load v))]
    (if (<= n (primitive/cast i64 0)) (primitive/cast (ptr Expr) 0) (al-elem [Expr] v (primitive/isub n 1)))))

(defn is-literal [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EInt [_] true)
    (EFloat [_] true)
    (EBin [op lhs rhs] (and (is-literal lhs) (is-literal rhs)))
    (EIf [cnd thn els] (and (is-literal thn) (is-literal els)))
    (EDo [body]
         (let [l (al-last-expr body)] (if (= (primitive/cast i64 l) (primitive/cast i64 0)) false (is-literal l))))
    (ELet [binds body]
          (let [l (al-last-expr body)] (if (= (primitive/cast i64 l) (primitive/cast i64 0)) false (is-literal l))))
    (_ false)))

(defn is-literal-value [(e (ptr Expr))] (-> bool)
  (match (.kind e) (EInt [_] true) (EFloat [_] true) (EBool [_] true) (_ false)))

(defn numeric [(t (ptr Type)) (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (match (load t) (TInt [_ _] true) (TFloat [_] true) (TStruct [n] (set-contains tps n)) (_ false)))

(defn is-cond [(t (ptr Type))] (-> bool)
  (match (load t) (TBool [] true) (TInt [_ _] true) (_ false)))

(defn same-number-kind [(x (ptr Type)) (y (ptr Type))] (-> bool)
  (or (and (type-is-int x) (type-is-int y)) (and (type-is-float x) (type-is-float y))))

(defn arg-ok [(got (ptr Type)) (want (ptr Type)) (is_extern bool)] (-> bool)
  (if (type-eq got want) true (and is_extern (and (type-is-ptr got) (type-is-ptr want)))))

; fits
(defn fits [(n i64) (bits i64) (signed bool)] (-> bool)
  (cond (>= bits (primitive/cast i64 64)) true
        signed
          (let [lo (primitive/isub 0 (primitive/ishl 1 (primitive/isub bits 1)))
                hi (primitive/isub (primitive/ishl 1 (primitive/isub bits 1)) 1)]
            (and (>= n lo) (<= n hi)))
        (>= bits (primitive/cast i64 63)) (>= n (primitive/cast i64 0))
        :else (and (>= n (primitive/cast i64 0)) (< n (primitive/ishl 1 bits)))))

(defn prefix-diag [(a (dyn Allocator)) (d Diag) (pre (slice u8))] (-> Diag)
  (let [dp (primitive/alloc-stack Diag)] (set! dp d) (derr (sconcat a pre (.msg dp)))))

; ============================ coerce =============================
; coerce_lit
(defn coerce-lit [(a (dyn Allocator)) (e Expr) (target (ptr Type)) (fname (slice u8))] (-> (Result Expr Diag))
  (let [ep (primitive/alloc-stack Expr)]
    (set! ep e)
    (let [wrap
            (mk-expr (ECast (load target) (box-expr a (load ep)))
                     (.lo ep)
                     (.hi ep)
                     (.source ep)
                     (.ctxt ep))]
      (match (.kind ep)
        (EInt [n]
              (match (load target)
                (TInt [bits signed]
                      (if (not (fits n bits signed))
                          (Err [Expr Diag]
                               (derr (sconcat a
                                              (sconcat a
                                                       (sconcat3 a "in '" fname "': literal ")
                                                       (i64->str a n))
                                              (sconcat a " does not fit in " (ty-str a target)))))
                          (Ok wrap)))
                (_ (Ok wrap))))
        (_ (Ok wrap))))))

; coerce
(defn coerce-fail [(a (dyn Allocator)) (et (ptr Type)) (target (ptr Type)) (fname (slice u8)) (what (slice u8))] (-> (Result Expr
                                                                                                                             Diag))
  (Err [Expr Diag]
       (derr (sconcat a
                      (sconcat a
                               (sconcat a
                                        (sconcat a (sconcat3 a "in '" fname "': ") (sconcat a what " has type "))
                                        (ty-str a et))
                               " but expected ")
                      (ty-str a target)))))

(defn coerce [(a (dyn Allocator))
              (e Expr)
              (et (ptr Type))
              (target (ptr Type))
              (is_extern bool)
              (fname (slice u8))
              (what (slice u8))] (-> (Result Expr Diag))
  (let [ep (primitive/alloc-stack Expr)]
    (set! ep e)
    (cond (type-eq et target) (Ok (load ep))
          (type-is-void target) (Ok (load ep))
          (type-is-void et)
            (Err [Expr Diag]
                 (derr (sconcat a
                                (sconcat3 a "in '" fname "': ")
                                (sconcat a what " uses a void value (a (-> void) call yields nothing)"))))
          (type-is-never et) (Ok (load ep))
          (and (same-number-kind et target) (is-literal ep)) (coerce-lit a (load ep) target fname)
          ; A fixed array can be borrowed as a slice. Spill rvalues into the
          ; function frame, then point the slice at element zero; named let
          ; places already lower through the same spill representation.
          (and (= (type-tag et) (primitive/cast i64 7))
               (= (type-tag target) (primitive/cast i64 8)))
            (match (load et)
              (TArray [ee n]
                      (match (load target)
                        (TSlice [te]
                                (if (type-eq ee te)
                                    (Ok (mk-expr (EMakeSlice
                                                   :data
                                                     (box-expr a
                                                               (mk-expr (EIndex (box-expr a
                                                                                          (mk-expr (ESpillRef (box-expr a
                                                                                                                        (load ep)))
                                                                                                   (load (field ep
                                                                                                                lo))
                                                                                                   (load (field ep
                                                                                                                hi))
                                                                                                   (load (field ep
                                                                                                                source))
                                                                                                   (load (field ep
                                                                                                                ctxt))))
                                                                                (box-expr a
                                                                                          (mk-expr (EInt 0)
                                                                                                   (load (field ep
                                                                                                                lo))
                                                                                                   (load (field ep
                                                                                                                hi))
                                                                                                   (load (field ep
                                                                                                                source))
                                                                                                   (load (field ep
                                                                                                                ctxt)))))
                                                                        (load (field ep lo))
                                                                        (load (field ep hi))
                                                                        (load (field ep source))
                                                                        (load (field ep ctxt))))
                                                   :elem (load ee)
                                                   :len n)
                                                 (load (field ep lo))
                                                 (load (field ep hi))
                                                 (load (field ep source))
                                                 (load (field ep ctxt))))
                                    (coerce-fail a et target fname what)))
                        (_ (coerce-fail a et target fname what))))
              (_ (coerce-fail a et target fname what)))
          (arg-ok et target is_extern) (Ok (load ep))
          :else
            (match (load et)
              (TRef [m inner]
                    (if (type-eq inner target)
                        (Ok (mk-expr (ELoad (box-expr a (load ep)))
                                     (load (field ep lo))
                                     (load (field ep hi))
                                     (load (field ep source))
                                     (load (field ep ctxt))))
                        (coerce-fail a et target fname what)))
              (TInt [_ _] (coerce-fail a et target fname what))
              (TFloat [_] (coerce-fail a et target fname what))
              (TBool [] (coerce-fail a et target fname what))
              (TVoid [] (coerce-fail a et target fname what))
              (TPtr [_] (coerce-fail a et target fname what))
              (TStruct [_] (coerce-fail a et target fname what))
              (TArray [_ _] (coerce-fail a et target fname what))
              (TSlice [_] (coerce-fail a et target fname what))
              (TVec [_ _] (coerce-fail a et target fname what))
              (TFn [_ _ _] (coerce-fail a et target fname what))
              (TApp [_ _] (coerce-fail a et target fname what))
              (TNever [] (coerce-fail a et target fname what))
              (TCode [] (coerce-fail a et target fname what))
              (TCodeBuilder [] (coerce-fail a et target fname what))
              (TExternRef [] (coerce-fail a et target fname what))))))

; const_entry
(defn const-entry [(a (dyn Allocator)) (cp (ptr Const))] (-> (Result EvalPair Diag))
  (let [nm (.name cp)]
    (match (.kind (.value cp))
      (EInt [n]
            (match (.ty cp)
              (None [] (Ok (mk-evalpair (mk-expr (EInt n) -1 -1 -1 0) (TInt 64 true))))
              (Some [wt]
                    (match wt
                      (TInt [bits signed]
                            (if (not (fits n bits signed))
                                (Err [EvalPair Diag]
                                     (derr (sconcat a
                                                    (sconcat a
                                                             (sconcat3 a "const '" nm "': literal ")
                                                             (i64->str a n))
                                                    (sconcat a
                                                             " does not fit in "
                                                             (ty-str a (box-type a wt))))))
                                (Ok (mk-evalpair (mk-expr (EInt n) -1 -1 -1 0) (TInt bits signed)))))
                      (_ (Err [EvalPair Diag]
                              (derr (sconcat a
                                             (sconcat3 a
                                                       "const '"
                                                       nm
                                                       "': integer value cannot have type ")
                                             (ty-str a (box-type a wt))))))))))
      (EFloat [bits]
              (match (.ty cp)
                (None [] (Ok (mk-evalpair (mk-expr (EFloat bits) -1 -1 -1 0) (TFloat 64))))
                (Some [wt]
                      (match wt
                        (TFloat [b]
                                (Ok (mk-evalpair (mk-expr (EFloat bits) -1 -1 -1 0) (TFloat b))))
                        (_ (Err [EvalPair Diag]
                                (derr (sconcat a
                                               (sconcat3 a
                                                         "const '"
                                                         nm
                                                         "': float value cannot have type ")
                                               (ty-str a (box-type a wt))))))))))
      (EBool [b]
             (match (.ty cp)
               (None [] (Ok (mk-evalpair (mk-expr (EBool b) -1 -1 -1 0) (TBool))))
               (Some [wt]
                     (match wt
                       (TBool [] (Ok (mk-evalpair (mk-expr (EBool b) -1 -1 -1 0) (TBool))))
                       (_ (Err [EvalPair Diag]
                               (derr (sconcat a
                                              (sconcat3 a
                                                        "const '"
                                                        nm
                                                        "': boolean value cannot have type ")
                                              (ty-str a (box-type a wt))))))))))
      (_ (do
           (unimplemented "check/const-entry called on non-literal (unreachable)")
           (Err [EvalPair Diag] (derr "")))))))

; ============================ validate_type ========================
(defn validate-type-list [(v (ptr (ArrayList Type))) (cx (ptr Cx)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                   Diag))
  (let [n (al-len [Type] (load v))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (validate-type (al-elem [Type] v (load i)) cx tps)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn impl-associated-bindings [(a (dyn Allocator)) (im (ptr ImplDef))
                                (td (ptr TraitDef)) (cty (ptr Type))]
  (-> (ptr (ArrayList SubstEntry)))
  (let [selfp (.self_param td) extras (load (field td type_params))
        (mut binds) (al-new [SubstEntry] a) tms (load (field td methods))]
    (for [i 0 (al-len [TraitMethod] (load tms))]
      (let [tm (al-elem [TraitMethod] tms i) method (impl-find-method im (.name tm))]
        (unless (= (primitive/cast i64 method) 0)
          (let [want (subst-self-params a tm selfp cty)
                wantret (subst-self a (field tm ret) selfp cty)]
            (unify-extras-params a want method extras (mut binds))
            (unify-trait-extras a (box-type a wantret) (field method ret) extras (mut binds))
            0))))
    (box-al [SubstEntry] a (load binds))))

(defn validate-struct-name [(a (dyn Allocator)) (cx (ptr Cx)) (name (slice u8)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64
                                                                                                                                Diag))
  (if (set-contains tps name)
      (Ok [i64 Diag] 0)
      (let [si (struct-find cx name)]
        (if (!= (primitive/cast i64 si) (primitive/cast i64 0))
            (let [np (al-len [(slice u8)] (load (field si type_params)))]
              (if (= np (primitive/cast i64 0))
                  (Ok [i64 Diag] 0)
                  (Err [i64 Diag]
                       (derr (sconcat a
                                      (sconcat a (sconcat3 a "generic type '" name "' expects ") (i64->str a np))
                                      " type arguments, got 0")))))
            (let [su (sum-find cx name)]
              (if (!= (primitive/cast i64 su) (primitive/cast i64 0))
                  (let [np (al-len [(slice u8)] (load (field su type_params)))]
                    (if (= np (primitive/cast i64 0))
                        (Ok [i64 Diag] 0)
                        (Err [i64 Diag]
                             (derr (sconcat a
                                            (sconcat a (sconcat3 a "generic type '" name "' expects ") (i64->str a np))
                                            " type arguments, got 0")))))
                  (Err [i64 Diag] (derr (sconcat3 a "unknown type '" name "'")))))))))

; index of `nm` in a name list, or -1.
(defn name-index [(lst (ptr (ArrayList (slice u8)))) (nm (slice u8))] (-> i64)
  (let [n (al-len [(slice u8)] (load lst))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (al-get [(slice u8)] (load lst) (load i)) nm) (store! r (load i)) (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; Enforce the declared bounds of a generic struct/sum at a use site `(Box f64)`. The
; bound `[(T Eq)]` means every instantiation's T must implement Eq. Checked only when
; the argument is CONCRETE: inside a generic body `(Box T)` the argument is itself an
; in-scope type param (abstract) and cannot be checked here — that instantiation is
; verified when the enclosing generic is itself instantiated with a concrete type.
(defn tapp-arg-abstract? [(t (ptr Type)) (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (match (load t) (TStruct [nm] (set-contains tps nm)) (_ false)))

(defn check-app-bounds [(a (dyn Allocator))
                        (cx (ptr Cx))
                        (name (slice u8))
                        (bounds (ptr (ArrayList Bound)))
                        (params (ptr (ArrayList (slice u8))))
                        (args (ptr (ArrayList Type)))
                        (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [nb (al-len [Bound] (load bounds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) nb)
              (break)
              (do
                (let [bp (al-elem [Bound] bounds (load i))
                      idx (name-index params (.name bp))]
                  (when (and (>= idx (primitive/cast i64 0)) (< idx (al-len [Type] (load args))))
                    (let [arg (al-elem [Type] args idx)]
                      (unless (tapp-arg-abstract? arg tps)
                        (let [trs (load (field bp traits))
                              nt (al-len [(slice u8)] (load trs))
                              (mut k) 0]
                          (loop (if (>= (load k) nt)
                                    (break)
                                    (do
                                      (let [tr (al-get [(slice u8)] (load trs) (load k))]
                                        (unless (impl-match a cx tr arg)
                                          (store! err
                                                  (derr (sconcat a
                                                                 (sconcat a
                                                                          (sconcat a
                                                                                   (sconcat4 a
                                                                                             "'"
                                                                                             (ty-str a arg)
                                                                                             "' does not implement '"
                                                                                             (sconcat a
                                                                                                      (display-name tr)
                                                                                                      "' (required by '"))
                                                                                   name)
                                                                          "' bound on '")
                                                                 (sconcat a
                                                                          (load (field bp
                                                                                       name))
                                                                          "')"))))
                                          (store! failed true)
                                          0))
                                      (if (load failed) (break) (store! k (primitive/iadd (load k) 1))))))))
                      0)))
                (if (load failed) (break) (set! i (primitive/iadd (load i) 1))))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn validate-app [(a (dyn Allocator))
                    (cx (ptr Cx))
                    (name (slice u8))
                    (args (ptr (ArrayList Type)))
                    (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (match (validate-type-list args cx tps)
    (Err [d] (Err [i64 Diag] d))
    (Ok [_]
        (let [si (struct-find cx name)
              su (sum-find cx name)
              (mut arity) -1]
          (if (!= (primitive/cast i64 si) (primitive/cast i64 0))
              (do (set! arity (al-len [(slice u8)] (load (field si type_params)))) 0)
              (when (!= (primitive/cast i64 su) (primitive/cast i64 0))
                (store! arity
                        (al-len [(slice u8)]
                                (load (field su
                                             type_params))))
                0))
          (if (< (load arity) (primitive/cast i64 0))
              (Err [i64 Diag] (derr (sconcat3 a "unknown generic type '" name "'")))
              (let [na (al-len [Type] (load args))]
                (cond (!= (load arity) na)
                        (Err [i64 Diag]
                             (derr (sconcat a
                                            (sconcat a
                                                     (sconcat a
                                                              (sconcat3 a "generic type '" name "' expects ")
                                                              (i64->str a (load arity)))
                                                     " type arguments, got ")
                                            (i64->str a na))))
                      ; arity ok — now enforce the type's declared bounds on concrete args.
                      (!= (primitive/cast i64 si) (primitive/cast i64 0))
                        (check-app-bounds a
                                          cx
                                          name
                                          (load (field si bounds))
                                          (load (field si
                                                       type_params))
                                          args
                                          tps)
                      (!= (primitive/cast i64 su) (primitive/cast i64 0))
                        (check-app-bounds a
                                          cx
                                          name
                                          (load (field su bounds))
                                          (load (field su
                                                       type_params))
                                          args
                                          tps)
                      :else (Ok [i64 Diag] 0))))))))

(defn validate-type [(t (ptr Type)) (cx (ptr Cx)) (tps (ptr (ArrayList (slice u8))))] (-> (Result i64 Diag))
  (let [a (load (field cx a))]
    (match (load t)
      (TNever [] (Ok [i64 Diag] 0))
      (TCode [] (Ok [i64 Diag] 0))
      (TCodeBuilder [] (Ok [i64 Diag] 0))
      (TExternRef [] (Ok [i64 Diag] 0))
      (TVoid [] (Err [i64 Diag] (derr "'void' is only valid as a return type")))
      (TInt [_ _] (Ok [i64 Diag] 0))
      (TFloat [_] (Ok [i64 Diag] 0))
      (TBool [] (Ok [i64 Diag] 0))
      (TPtr [p] (validate-type p cx tps))
      (TRef [m p] (validate-type p cx tps))
      (TArray [e k] (validate-type e cx tps))
      (TSlice [e] (validate-type e cx tps))
      (TVec [e k]
            (if (= k (primitive/cast i64 0))
                (Err [i64 Diag] (derr "vec must have a positive lane count"))
                (match (load e)
                  (TInt [_ _] (Ok [i64 Diag] 0))
                  (TFloat [_] (Ok [i64 Diag] 0))
                  (TStruct [p]
                           (if (set-contains tps p)
                               (Ok [i64 Diag] 0)
                               (Err [i64 Diag]
                                    (derr (sconcat a
                                                   "vec element must be a scalar int/float, got "
                                                   (ty-str a e))))))
                  (_ (Err [i64 Diag]
                          (derr (sconcat a "vec element must be a scalar int/float, got " (ty-str a e))))))))
      (TStruct [name] (validate-struct-name a cx name tps))
      (TFn [cc params ret]
           (match (validate-type-list params cx tps) (Err [d] (Err [i64 Diag] d)) (Ok [_] (validate-type ret cx tps))))
      (TApp [name args]
            (if (= name "$pack-var")
                (if (and (= (al-len [Type] (load args)) 1)
                         (set-contains tps (type-struct-name (al-elem [Type] args 0))))
                    (Ok [i64 Diag] 0)
                    (Err [i64 Diag] (derr "type pack is not declared in this generic scope")))
                (if (= name "$pack")
                    (validate-type-list args cx tps)
                    (validate-app a cx name args tps)))))))

; ============================ setup (Phase 1) ======================
(defn layout-is-bits [(l (ptr Layout))] (-> bool)
  (match (load l) (LBits [b o] true) (_ false)))

(defn conv-find [(cx (ptr Cx)) (name (slice u8))] (-> (ptr Convention))
  (let [cv (field cx conventions)
        n (al-len [Convention] (load (load (field cx conventions))))
        (mut i) 0
        (mut r) (primitive/cast (ptr Convention) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (conv-name (al-get [Convention] (load (load cv)) (load i))) name)
                  (store! r (al-elem [Convention] (load cv) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn conv-is-shim [(c (ptr Convention))] (-> bool)
  (match (.lowering c) (LShim [] true) (_ false)))

(defn conv-is-reset [(c (ptr Convention))] (-> bool)
  (match (.lowering c) (LReset [] true) (_ false)))

(defn conv-is-native [(cx (ptr Cx)) (name (slice u8))] (-> bool)
  (let [c (conv-find cx name)] (and (!= (primitive/cast i64 c) (primitive/cast i64 0)) (not (conv-is-shim c)))))

(defn conv-ret-none [(c (ptr Convention))] (-> bool)
  (match (.ret c) (None [] true) (_ false)))

(defn conv-params-len [(c (ptr Convention))] (-> i64)
  (al-len [(slice u8)] (load (field c params))))

(defn cx-init-tables [(cx (ptr Cx)) (a (dyn Allocator))] (-> i64)
  (set! (.a cx) a)
  (set! (.annotation_idx cx) (hm-new [(slice u8) i64] a (str-keyops)))
  (set! (.sigs cx) (al-new [Sig] a))
  (set! (.sigidx cx) (hm-new [(slice u8) i64] a (str-keyops)))
  (set! (.structs cx) (al-new [StructInfo] a))
  (set! (.sums cx) (al-new [SumInfo] a))
  (set! (.variant_to_sum cx) (al-new [VtoS] a))
  (set! (.consts cx) (al-new [ConstEntry] a))
  (set! (.static_consts cx) (al-new [(slice u8)] a))
  (set! (.trait_defs cx) (al-new [TraitDef] a))
  (set! (.methods cx) (al-new [MethodEntry] a))
  (set! (.impls cx) (al-new [ImplDef] a))
  (set! (.trait_impl_idx cx) (hm-new [(slice u8) (ptr ImplBucket)] a (str-keyops)))
  (set! (.inherent_impl_idx cx) (hm-new [(slice u8) (ptr ImplBucket)] a (str-keyops)))
  (set! (.inherent_name_idx cx) (hm-new [(slice u8) (ptr ImplBucket)] a (str-keyops)))
  (set! (.cur_bounds cx) (al-new [Bound] a))
  (set! (.loops cx) (al-new [LoopFrame] a))
  0)

(defn annotation-def-find [(cx (ptr Cx)) (key (slice u8))] (-> (ptr AnnotationDef))
  (match (hm-get [(slice u8) i64] (.annotation_idx cx) key)
    (Some [i] (al-elem [AnnotationDef] (load (field cx annotation_defs)) i))
    (None [] (primitive/cast (ptr AnnotationDef) 0))))

(defn setup-structs [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [fs (load (field prog structs))
        n (al-len [StructDef] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (al-elem [StructDef] fs (load i))
                      nm (.name sp)]
                  (if (!= (primitive/cast i64 (struct-find cx nm)) (primitive/cast i64 0))
                      (do
                        (set! err (derr (sconcat3 a "struct '" nm "' defined twice")))
                        (set! failed true)
                        (break))
                      (let [info (primitive/alloc-stack StructInfo)]
                        (set! (.name info) nm)
                        (set! (.type_params info) (load (field sp type_params)))
                        (set! (.bounds info) (load (field sp bounds)))
                        (set! (.fields info) (load (field sp fields)))
                        (set! (.is_bits info) (layout-is-bits (field sp layout)))
                        (al-push! (mut (.structs cx)) (load info)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn setup-sums [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [fs (load (field prog sums))
        n (al-len [SumDef] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sp (al-elem [SumDef] fs (load i))
                      nm (.name sp)]
                  (if (!= (primitive/cast i64 (sum-find cx nm)) (primitive/cast i64 0))
                      (do (set! err (derr (sconcat3 a "sum '" nm "' defined twice"))) (set! failed true) (break))
                      (do
                        (let [info (primitive/alloc-stack SumInfo)]
                          (set! (.name info) nm)
                          (set! (.type_params info) (load (field sp type_params)))
                          (set! (.bounds info) (load (field sp bounds)))
                          (set! (.variants info) (load (field sp variants)))
                          (al-push! (mut (.sums cx)) (load info)))
                        (let [vs (load (field sp variants))
                              vn (al-len [Variant] (load vs))
                              (mut j) 0]
                          (loop (if (>= (load j) vn)
                                    (break)
                                    (do
                                      (let [vp (al-elem [Variant] vs (load j))
                                            vnm (.name vp)]
                                        (if (!= (primitive/cast i64 (vts-find cx vnm)) (primitive/cast i64 0))
                                            (do
                                              (set! err
                                                    (derr (sconcat3 a
                                                                    "variant '"
                                                                    vnm
                                                                    "' is declared in two sum types")))
                                              (set! failed true)
                                              (break))
                                            (let [ve (primitive/alloc-stack VtoS)]
                                              (set! (.variant ve) vnm)
                                              (set! (.sum ve) nm)
                                              (al-push! (mut (.variant_to_sum cx)) (load ve)))))
                                      (set! j (primitive/iadd (load j) 1)))))
                          (when (load failed) (break))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn trait-method-self-idx [(tp (ptr TraitMethod)) (selfp (slice u8))] (-> i64)
  (let [ps (load (field tp params))
        n (al-len [Param] (load ps))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (type-mentions (field (al-elem [Param] ps (load i)) ty) selfp) (store! r (load i)) (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn setup-traits [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [ts (load (field prog traits))
        n (al-len [TraitDef] (load ts))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tp (al-elem [TraitDef] ts (load i))
                      tnm (.name tp)
                      selfp (.self_param tp)]
                  (let [ms (load (field tp methods))
                        mn (al-len [TraitMethod] (load ms))
                        (mut j) 0]
                    (loop (if (>= (load j) mn)
                              (break)
                              (do
                                (let [mp (al-elem [TraitMethod] ms (load j))
                                      mnm (.name mp)
                                      idx (trait-method-self-idx mp selfp)]
                                  (if (< idx (primitive/cast i64 0))
                                      (do
                                        (set! err
                                              (derr (sconcat a
                                                             (sconcat a
                                                                      (sconcat3 a "trait '" tnm "' method '")
                                                                      (sconcat3 a mnm "': needs a " selfp))
                                                             " (Self) parameter")))
                                        (set! failed true)
                                        (break))
                                      (let [me (primitive/alloc-stack MethodEntry)]
                                        (set! (.name me) mnm)
                                        (set! (.trait me) tnm)
                                        (set! (.self_idx me) idx)
                                        (al-push! (mut (.methods cx)) (load me)))))
                                (set! j (primitive/iadd (load j) 1))))))
                  (if (load failed)
                      (break)
                      (if (!= (primitive/cast i64 (trait-find cx tnm)) (primitive/cast i64 0))
                          (do
                            (set! err (derr (sconcat3 a "trait '" tnm "' defined twice")))
                            (set! failed true)
                            (break))
                          (al-push! (mut (.trait_defs cx)) (load tp)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn copy-funcs [(a (dyn Allocator)) (fb (ptr FBox)) (prog (ptr Program))] (-> i64)
  (let [fs (load (field prog funcs))
        n (al-len [Func] (load fs))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut (.items fb)) (al-get [Func] (load fs) (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn tmfn [(a (dyn Allocator)) (tr (slice u8)) (ty (slice u8)) (m (slice u8))] (-> (slice u8))
  (sconcat3 a (sconcat3 a tr "$" ty) "$" m))

(defn inherent-fn-name [(a (dyn Allocator)) (im (ptr ImplDef)) (m (slice u8))] (-> (slice u8))
  (tmfn a "inherent" (impl-mangle-key a (field im self_type) (load (field im type_params))) m))

; ---- impl mangling: one symbol per IMPL, not per (trait, key) ----------------
; Several impls can now share a dispatch key — `(Pair A B)` and `(Pair i64 i64)` both
; key to "Pair" — so `Trait$key$method` no longer names a unique function. The `ty`
; passed to `tmfn` is therefore the IMPL's key (`impl-mangle-key`), not the bare
; dispatch key.
;
; A faithful, injective rendering of a Type. Deterministic and independent of
; declaration order, so the rebootstrap fixpoint holds.
(defn ty-mangle-list [(a (dyn Allocator)) (v (ptr (ArrayList Type)))] (-> (slice u8))
  (let [n (al-len [Type] (load v))
        (mut i) 0
        (mut s) ""]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (> (load i) (primitive/cast i64 0)) (store! s (sconcat a (load s) ",")) 0)
                (set! s (sconcat a (load s) (ty-mangle a (al-elem [Type] v (load i)))))
                (set! i (primitive/iadd (load i) 1)))))
    (load s)))

(defn ty-mangle [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TInt [b s] (sconcat a (if s "i" "u") (i64->str a b)))
    (TFloat [b] (sconcat a "f" (i64->str a b)))
    (TBool [] "bool")
    (TVoid [] "void")
    (TStruct [n] n)
    (TApp [n args] (sconcat a n (sconcat3 a "<" (ty-mangle-list a args) ">")))
    (TPtr [i] (sconcat3 a "ptr<" (ty-mangle a i) ">"))
    (TSlice [i] (sconcat3 a "slice<" (ty-mangle a i) ">"))
    (TRef [m i] (sconcat3 a (if m "mut<" "ref<") (ty-mangle a i) ">"))
    (TArray [i n] (sconcat a "array<" (sconcat a (ty-mangle a i) (sconcat3 a "," (i64->str a n) ">"))))
    (TVec [i n] (sconcat a "vec<" (sconcat a (ty-mangle a i) (sconcat3 a "," (i64->str a n) ">"))))
    (TFn [cc ps r]
         (sconcat a
                  "fn<"
                  (sconcat a
                           cc
                           (sconcat a
                                    ","
                                    (sconcat a
                                             (ty-mangle-list a ps)
                                             (sconcat3 a "," (ty-mangle a r) ">"))))))
    (_ "?")))

(defn is-tparam? [(t (ptr Type)) (params (ptr (ArrayList (slice u8))))] (-> bool)
  (if (= (type-tag t) (primitive/cast i64 6)) (set-contains params (type-struct-name t)) false))

; every arg a type param, and no param used twice (so `(Pair A A)` is NOT general —
; it is a diagonal specialization of `(Pair A B)`)
(defn args-distinct-params? [(a (dyn Allocator)) (v (ptr (ArrayList Type))) (params (ptr (ArrayList (slice u8))))] (-> bool)
  (let [n (al-len [Type] (load v))
        (mut i) 0
        (mut ok) true]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (not (load ok)) (break))
                (let [e (al-elem [Type] v (load i))]
                  (if (not (is-tparam? e params))
                      (do (set! ok false) (break))
                      ; distinct: no EARLIER arg names the same param (all earlier args are
                      ; known tparams — we'd have bailed otherwise, so type-struct-name is safe)
                      (let [nm (type-struct-name e)
                            (mut j) 0]
                        (loop (if (>= (load j) (load i))
                                  (break)
                                  (do
                                    (when (= (type-struct-name (al-elem [Type] v (load j))) nm)
                                      (store! ok false)
                                      (break))
                                    (set! j (primitive/iadd (load j) 1))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load ok)))

; Is this impl the CANONICAL GENERAL one for its key — the head constructor applied to
; distinct type params, with nothing concrete anywhere? Those keep the plain,
; undecorated key. That is what makes this change symbol-compatible: every impl that
; existed before (scalars, plain structs, `(slice T)`, `(ArrayList T)`, `(ptr T)`, …)
; is general, so its mangled name is byte-identical to before and the blessed IR
; snapshots still match. Only genuinely specialized impls get a decorated name.
(defn impl-general? [(a (dyn Allocator)) (t (ptr Type)) (params (ptr (ArrayList (slice u8))))] (-> bool)
  (match (load t)
    (TInt [_ _] true)
    (TFloat [_] true)
    (TBool [] true)
    (TStruct [n] (not (set-contains params n)))
    (TPtr [i] (is-tparam? i params))
    (TSlice [i] (is-tparam? i params))
    (TApp [_ args] (args-distinct-params? a args params))
    ; array/vec carry a length and fn a signature — always part of the pattern, so
    ; these are never "the general impl" and always get a decorated name.
    (_ false)))

(defn impl-mangle-key [(a (dyn Allocator)) (t (ptr Type)) (params (ptr (ArrayList (slice u8))))] (-> (slice u8))
  (if (impl-general? a t params) (impl-base-name a t) (ty-mangle a t)))

(defn impl-find-method [(im (ptr ImplDef)) (mname (slice u8))] (-> (ptr Func))
  (let [ms (load (field im methods))
        n (al-len [Func] (load ms))
        (mut i) 0
        (mut r) (primitive/cast (ptr Func) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (func-name (al-get [Func] (load ms) (load i))) mname)
                  (store! r (al-elem [Func] ms (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn subst-self-params [(a (dyn Allocator)) (tm (ptr TraitMethod)) (selfp (slice u8)) (cty (ptr Type))] (-> (ptr (ArrayList Type)))
  (let [ps (load (field tm params))
        (mut out) (al-new [Type] a)
        n (al-len [Param] (load ps))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (subst-self a (field (al-elem [Param] ps (load i)) ty) selfp cty))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn param-types [(a (dyn Allocator)) (ps (ptr (ArrayList Param)))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (al-new [Type] a)
        n (al-len [Param] (load ps))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (.ty (al-elem [Param] ps (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn impl-prefix [(a (dyn Allocator)) (tr (slice u8)) (forty (slice u8))] (-> (slice u8))
  (sconcat a (sconcat3 a "impl " tr " for ") (sconcat a forty ": ")))

; ---- trait-extras unification --------------
; Match a trait-declared type (`want`, the trait's EXTRA type parameters open)
; against an impl method's declared type (`got`): bind each extra on first
; sight, require consistency after; everything else must match exactly. The
; impl's own type params appear as plain nominal names on both sides.
(defn extras-has [(extras (ptr (ArrayList (slice u8)))) (n (slice u8))] (-> bool)
  (let [k (al-len [(slice u8)] (load extras))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) k)
              (break)
              (do
                (when (= (al-get [(slice u8)] (load extras) (load i)) n) (store! r true) (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn pack-var? [(t (ptr Type))] (-> bool)
  (match (load t) (TApp [n xs] (and (= n "$pack-var") (= (al-len [Type] (load xs)) 1))) (_ false)))

(defn pack-value? [(t (ptr Type))] (-> bool)
  (match (load t) (TApp [n _] (= n "$pack")) (_ false)))

(defn pack-var-name [(t (ptr Type))] (-> (slice u8))
  (match (load t) (TApp [_ xs] (type-struct-name (al-elem [Type] xs 0))) (_ "")))

(defn make-pack [(a (dyn Allocator)) (xs (ptr (ArrayList Type))) (lo i64) (hi i64)] (-> Type)
  (let [(mut out) (al-new [Type] a)
        (mut i) lo]
    (loop (if (>= (load i) hi)
              (break)
              (do
                (al-push! (mut out) (al-get [Type] (load xs) (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (TApp "$pack" (box-al [Type] a (load out)))))

(defn list-pack-index [(xs (ptr (ArrayList Type)))] (-> i64)
  (let [n (al-len [Type] (load xs))
        (mut i) 0
        (mut found) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (pack-var? (al-elem [Type] xs (load i))) (store! found (load i)) (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn unify-extras-list [(a (dyn Allocator))
                         (w (ptr (ArrayList Type)))
                         (g (ptr (ArrayList Type)))
                         (extras (ptr (ArrayList (slice u8))))
                         (binds (ptr (ArrayList SubstEntry)))] (-> bool)
  (let [nw (al-len [Type] (load w))
        ng (al-len [Type] (load g))
        pi (list-pack-index w)
        (mut i) 0
        (mut ok) (if (< pi 0) (= nw ng) (>= ng (primitive/isub nw 1)))]
    (when (and (load ok) (>= pi 0))
      (let [tail (primitive/isub nw (primitive/iadd pi 1))
            count (primitive/isub ng (primitive/iadd pi tail))
            pn (pack-var-name (al-elem [Type] w pi))
            packed (make-pack a g pi (primitive/iadd pi count))
            prev (subst-get binds pn)]
        (if (= (primitive/cast i64 prev) (primitive/cast i64 0))
            (subst-insert! binds pn (box-type a packed))
            (unless (type-eq prev (box-type a packed)) (store! ok false)))
        (store! i 0)
        (loop (if (or (not (load ok)) (>= (load i) pi))
                  (break)
                  (do
                    (unless (unify-trait-extras a (al-elem [Type] w (load i)) (al-elem [Type] g (load i)) extras binds)
                      (store! ok false))
                    (store! i (primitive/iadd (load i) 1)))))
        (store! i 0)
        (loop (if (or (not (load ok)) (>= (load i) tail))
                  (break)
                  (do
                    (unless (unify-trait-extras a
                                                (al-elem [Type] w (primitive/iadd (primitive/iadd pi 1) (load i)))
                                                (al-elem [Type] g (primitive/iadd (primitive/iadd pi count) (load i)))
                                                extras
                                                binds)
                      (store! ok false))
                    (store! i (primitive/iadd (load i) 1)))))))
    (when (>= pi 0) (store! i nw))
    (loop (if (or (not (load ok)) (>= (load i) nw))
              (break)
              (do
                (unless (unify-trait-extras a (al-elem [Type] w (load i)) (al-elem [Type] g (load i)) extras binds)
                  (store! ok false)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load ok)))

(defn unify-trait-extras [(a (dyn Allocator))
                          (want (ptr Type))
                          (got (ptr Type))
                          (extras (ptr (ArrayList (slice u8))))
                          (binds (ptr (ArrayList SubstEntry)))] (-> bool)
  (match (load want)
    (TStruct [n]
             (if (extras-has extras n)
                 (let [b (subst-get binds n)]
                   (if (= (primitive/cast i64 b) (primitive/cast i64 0))
                       (do (subst-insert! binds n got) true)
                       (type-eq b got)))
                 (type-eq want got)))
    (TRef [mw pw]
          (match (load got)
            (TRef [mg pg] (and (if mw mg (not mg)) (unify-trait-extras a pw pg extras binds)))
            (_ false)))
    (TPtr [pw] (match (load got) (TPtr [pg] (unify-trait-extras a pw pg extras binds)) (_ false)))
    (TSlice [pw] (match (load got) (TSlice [pg] (unify-trait-extras a pw pg extras binds)) (_ false)))
    (TArray [pw nw]
            (match (load got)
              (TArray [pg ng] (and (= nw ng) (unify-trait-extras a pw pg extras binds)))
              (_ false)))
    (TVec [pw nw]
          (match (load got)
            (TVec [pg ng] (and (= nw ng) (unify-trait-extras a pw pg extras binds)))
            (_ false)))
    (TApp [nw aw]
          (match (load got)
            (TApp [ng ag] (and (= nw ng) (unify-extras-list a aw ag extras binds)))
            (_ false)))
    (TFn [cw pw rw]
         (match (load got)
           (TFn [cg pg rg]
                (and (= cw cg)
                     (and (unify-extras-list a pw pg extras binds)
                          (unify-trait-extras a rw rg extras binds))))
           (_ false)))
    (_ (type-eq want got))))

(defn unify-extras-params [(a (dyn Allocator))
                           (want (ptr (ArrayList Type)))
                           (m (ptr Func))
                           (extras (ptr (ArrayList (slice u8))))
                           (binds (ptr (ArrayList SubstEntry)))] (-> bool)
  (let [got (param-types a (load (field m params)))]
    (unify-extras-list a want got extras binds)))

(defn unify-call-params [(a (dyn Allocator))
                         (want (ptr (ArrayList Type)))
                         (m (ptr Func))
                         (self (ptr Type))
                         (tps (ptr (ArrayList (slice u8))))
                         (extras (ptr (ArrayList (slice u8))))
                         (binds (ptr (ArrayList SubstEntry)))] (-> bool)
  (let [got (param-types a (load (field m params)))
        n (al-len [Type] (load got))]
    (if (= n 0)
        false
        (if (not (call-receiver-matches? a self (al-elem [Type] got 0) tps))
            false
            (do
              (match (load (al-elem [Type] got 0))
                (TRef [_ inner] (store! (al-elem [Type] got 0) (load inner)))
                (_ 0))
              (unify-extras-list a want got extras binds))))))

(defn check-impl-methods [(a (dyn Allocator)) (cx (ptr Cx)) (im (ptr ImplDef)) (td (ptr TraitDef)) (cty (ptr Type))] (-> (Result i64
                                                                                                                                 Diag))
  (let [tr (impl-trait-name im)
        forty (.for_type im)
        selfp (.self_param td)
        extras (load (field td type_params))
        (mut binds) (al-new [SubstEntry] a)
        tms (load (field td methods))
        n (al-len [TraitMethod] (load tms))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tm (al-elem [TraitMethod] tms (load i))
                      tmn (.name tm)
                      m (impl-find-method im tmn)]
                  (if (= (primitive/cast i64 m) (primitive/cast i64 0))
                      (do
                        (set! err (derr (sconcat a (impl-prefix a tr forty) (sconcat3 a "missing method '" tmn "'"))))
                        (set! failed true)
                        (break))
                      (let [want (subst-self-params a tm selfp cty)
                            wantret (subst-self a (field tm ret) selfp cty)
                            ok-params
                              (if (= tmn "call")
                                  (unify-call-params a
                                                     want
                                                     m
                                                     cty
                                                     (load (field im type_params))
                                                     extras
                                                     (mut binds))
                                  (unify-extras-params a want m extras (mut binds)))
                            ok-ret (unify-trait-extras a (box-type a wantret) (field m ret) extras (mut binds))]
                        (when (or (not ok-params) (not ok-ret))
                          (store! err
                                  (derr (sconcat a
                                                 (impl-prefix a tr forty)
                                                 (sconcat3 a "method '" tmn "' signature doesn't match the trait"))))
                          (store! failed true)
                          (break)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

; A trait impl may expose its value through call syntax by defining a `call` method.
; `call` is an ordinary namespaced impl member, not owned by a compiler-known trait.
; Its call-syntax receiver may be the implementing type or an immutable reference
; to it. The latter lets affine callable values be invoked without consuming a
; hidden by-value copy of their owner.
(defn call-receiver-matches? [(a (dyn Allocator))
                              (self (ptr Type))
                              (recv (ptr Type))
                              (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (if (and (pat-matches? a self tps recv)
           (pat-matches? a recv tps self))
      true
      (match (load recv)
        (TRef [mutable inner]
              (and (not mutable)
                   (and (pat-matches? a self tps inner)
                        (pat-matches? a inner tps self))))
        (_ false))))

(defn check-call-method [(a (dyn Allocator)) (im (ptr ImplDef))] (-> (Result i64 Diag))
  (let [m (impl-find-method im "call")
        forty (.for_type im)]
    (if (= (primitive/cast i64 m) (primitive/cast i64 0))
        (Ok [i64 Diag] 0)
        (let [ps (load (field m params))]
          (if (= (al-len [Param] (load ps)) (primitive/cast i64 0))
              (Err [i64 Diag]
                   (derr (sconcat a
                                  (impl-prefix a (impl-trait-name im) forty)
                                  "'call' must take the callable value as its first parameter")))
              (let [recv (field (al-elem [Param] ps 0) ty)
                    self (field im self_type)
                    tps (load (field im type_params))]
                (if (call-receiver-matches? a self recv tps)
                    (Ok [i64 Diag] 0)
                    (Err [i64 Diag]
                         (derr (sconcat a
                                        (impl-prefix a (impl-trait-name im) forty)
                                        "'call' first parameter must be the implementing type"))))))))))

; Trait-method annotations are defaults inherited by every implementation. An
; implementation may not silently replace a trait-level contract such as Always.
(defn inherit-trait-method-annotations! [(im (ptr ImplDef)) (td (ptr TraitDef))] (-> i64)
  (let [tms (load (field td methods))
        n (al-len [TraitMethod] (load tms))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [tm (al-elem [TraitMethod] tms (load i))
                      m (impl-find-method im (.name tm))]
                  (unless (= (primitive/cast i64 m) (primitive/cast i64 0))
                    (let [src (load (field tm annotations))
                          sn (al-len [Annotation] (load src))
                          dst (load (field m annotations))
                          (mut j) 0]
                      (loop (if (>= (load j) sn)
                                (break)
                                (do
                                  (al-push! [Annotation] dst (al-get [Annotation] (load src) (load j)))
                                  (store! j (primitive/iadd (load j) 1))))))))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn append-impl-methods [(a (dyn Allocator)) (im (ptr ImplDef)) (fb (ptr FBox))] (-> i64)
  ; the IMPL's key, not the bare dispatch key — several impls can share the latter
  (let [tr (impl-trait-name im)
        forty (impl-mangle-key a (field im self_type) (load (field im type_params)))
        ms (load (field im methods))
        n (al-len [Func] (load ms))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [lf (primitive/alloc-stack Func)]
                  (set! lf (al-get [Func] (load ms) (load i)))
                  (set! (.name lf) (tmfn a tr forty (.name lf)))
                  (al-push! (mut (.items fb)) (load lf)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn append-inherent-methods [(a (dyn Allocator)) (im (ptr ImplDef)) (fb (ptr FBox))] (-> i64)
  (let [ms (load (field im methods))
        n (al-len [Func] (load ms))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [lf (primitive/alloc-stack Func)]
                  (set! lf (al-get [Func] (load ms) (load i)))
                  (set! (.name lf) (inherent-fn-name a im (.name lf)))
                  (al-push! (mut (.items fb)) (load lf)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn register-impl! [(a (dyn Allocator)) (cx (ptr Cx)) (im (ptr ImplDef))] (-> i64)
  (let [slot (al-len [ImplDef] (.impls cx))]
    (al-push! (mut (.impls cx)) (load im))
    (if (impl-is-trait im)
        (impl-index-add! a
                         (mut (.trait_impl_idx cx))
                         (impl-index-key a (impl-trait-name im) (.for_type im))
                         slot)
        (let [ms (load (field im methods))
              n (al-len [Func] (load ms))
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (let [name (.name (al-elem [Func] ms (load i)))]
                        (impl-index-add! a
                                         (mut (.inherent_impl_idx cx))
                                         (impl-index-key a name (.for_type im))
                                         slot)
                        (impl-index-add! a (mut (.inherent_name_idx cx)) name slot))
                      (set! i (primitive/iadd (load i) 1)))))))
    0))

; An inherent method is receiver-dispatched when its first parameter, after
; peeling ptr/ref, is the impl target pattern. Otherwise it is an associated
; function and must be called as `Type::name` because no argument identifies its
; owner. Parameter names carry no semantics; `(db (ptr LayoutDb))` works as well
; as `(self (ptr LayoutDb))`.
(defn inherent-receiver? [(a (dyn Allocator)) (im (ptr ImplDef)) (m (ptr Func))] (-> bool)
  (let [ps (load (field m params))]
    (if (= (al-len [Param] (load ps)) (primitive/cast i64 0))
        false
        (let [pt (field (al-elem [Param] ps 0) ty)
              base (peel-ref-ptr pt)
              tps (load (field im type_params))]
          (or (and (pat-matches? a (field im self_type) tps pt)
                   (pat-matches? a pt tps (field im self_type)))
              (and (pat-matches? a (field im self_type) tps base)
                   (pat-matches? a base tps (field im self_type))))))))

(defn inherent-method-duplicate? [(a (dyn Allocator)) (cx (ptr Cx)) (im (ptr ImplDef)) (m (ptr Func))] (-> bool)
  (let [name (.name m)
        recv (inherent-receiver? a im m)
        bucket
          (impl-index-get (field cx inherent_impl_idx)
                          (impl-index-key a name (.for_type im)))
        n (if (= (primitive/cast i64 bucket) (primitive/cast i64 0)) 0 (al-len [i64] (.items bucket)))
        (mut i) 0
        (mut dup) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [old
                        (al-elem [ImplDef]
                                 (field cx impls)
                                 (al-get [i64]
                                         (.items bucket)
                                         (load i)))
                      om (impl-find-method old name)]
                  (unless (= (primitive/cast i64 om) (primitive/cast i64 0))
                    (let [orecv (inherent-receiver? a old om)]
                      ; Associated functions have no receiver to select a
                      ; specialization, so one owner/name is the limit.
                      ; Every exact-pattern duplicate collides after
                      ; lowering, including receiver-vs-associated. Ordered
                      ; receiver specializations remain legal.
                      (when (or (and (pat-matches? a
                                                   (field old self_type)
                                                   (load (field old type_params))
                                                   (field im self_type))
                                     (pat-matches? a
                                                   (field im self_type)
                                                   (load (field im type_params))
                                                   (field old self_type)))
                                (and (not recv)
                                     (and (not orecv)
                                          (= (load (field old for_type)) (load (field im for_type))))))
                        (store! dup true)
                        (break)))))
                (set! i (primitive/iadd (load i) 1)))))
    (load dup)))

(defn setup-one-inherent [(a (dyn Allocator)) (cx (ptr Cx)) (im (ptr ImplDef)) (fb (ptr FBox))] (-> (Result i64 Diag))
  (try (do
         (let [ms (load (field im methods))
               n (al-len [Func] (load ms))
               (mut i) 0]
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (let [m (al-elem [Func] ms (load i))]
                         (let [(mut j) 0]
                           (loop (if (>= (load j) (load i))
                                     (break)
                                     (do
                                       (when (= (load (field (al-elem [Func] ms (load j)) name))
                                                (load (field m name)))
                                         (break :try
                                                  (Err [i64 Diag]
                                                       (derr (sconcat3 a
                                                                       "duplicate inherent method '"
                                                                       (load (field m name))
                                                                       "' in one impl")))))
                                       (store! j (primitive/iadd (load j) 1))))))
                         (when (inherent-method-duplicate? a cx im m)
                           (break :try
                                    (Err [i64 Diag]
                                         (derr (sconcat a
                                                        (sconcat3 a
                                                                  "duplicate inherent method '"
                                                                  (load (field m
                                                                               name))
                                                                  "' for '")
                                                        (sconcat a (ty-str a (field im self_type)) "'")))))))
                       (store! i (primitive/iadd (load i) 1))))))
         (register-impl! a cx im)
         (append-inherent-methods a im fb)
         (Ok 0))))

(defn setup-one-impl [(a (dyn Allocator)) (cx (ptr Cx)) (im (ptr ImplDef)) (fb (ptr FBox))] (-> (Result i64 Diag))
  (if (impl-is-inherent im)
      (setup-one-inherent a cx im fb)
      (try (do
             (let [tr (impl-trait-name im)
                   forty (load (field im for_type))]
               (when (= (primitive/cast i64 (trait-find cx tr)) (primitive/cast i64 0))
                 (break :try (Err [i64 Diag] (derr (sconcat3 a "impl: unknown trait '" tr "'")))))
               ; Several impls may share a dispatch key — `(Pair A B)` and `(Pair i64 i64)` both
               ; key to "Pair" — so a key clash is no longer a duplicate. Only two impls with the
               ; SAME PATTERN (each matching the other) are. Overlaps that are neither disjoint
               ; nor ordered (`(Pair i64 B)` vs `(Pair A bool)`) are reported at the use site
               ; that actually instantiates the overlap, not banned here.
               (when (impl-dup? a cx tr (field im self_type) (load (field im type_params)))
                 (break :try
                          (Err [i64 Diag]
                               (derr (sconcat a
                                              (sconcat3 a "duplicate impl of '" tr "' for '")
                                              (sconcat a (ty-str a (field im self_type)) "'"))))))
               (register-impl! a cx im)
               (let [td (trait-find cx tr)
                     cty (box-type a (load (field im self_type)))]
                 (try! (check-call-method a im))
                 (try! (check-impl-methods a cx im td cty))
                 (inherit-trait-method-annotations! im td))
               (append-impl-methods a im fb)
               (Ok 0))))))

(defn setup-impls [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program)) (fb (ptr FBox))] (-> (Result i64 Diag))
  (let [is (load (field prog impls))
        n (al-len [ImplDef] (load is))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (setup-one-impl a cx (al-elem [ImplDef] is (load i)) fb)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

; Copy is safe only when no destructor can be skipped by bitwise duplication.
; Validate after every impl has been registered so declaration order cannot hide
; a Drop implementation. Generic Copy impls must state a Copy bound for every
; parameter: otherwise `(impl [T] Copy (Box T))` would silently make
; `Box<Droppable>` copyable.
(defn copy-impl-generic-bounds? [(im (ptr ImplDef))] (-> bool)
  (if (match (load (field im self_type))
        ; These representations never own or destroy their element/pointee type.
        ; Requiring `T: Copy` for `(ptr T)` or `(slice T)` would incorrectly make
        ; a pointer's copyability depend on what it merely points at.
        (TPtr [_] true)
        (TRef [_ _] true)
        (TSlice [_] true)
        (TFn [_ _ _] true)
        (_ false))
      true
      (let [ps (load (field im type_params))
            n (al-len [(slice u8)] (load ps))
            (mut i) 0
            (mut valid) true]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (unless (bounds-has (load (field im bounds))
                                        (al-get [(slice u8)] (load ps) (load i))
                                        "coil.core.Copy")
                      (store! valid false)
                      (break))
                    (store! i (primitive/iadd (load i) 1)))))
        (load valid))))

(defn check-copy-impls [(a (dyn Allocator)) (cx (ptr Cx))] (-> (Result i64 Diag))
  (try (let [is (field cx impls)
             n (al-len [ImplDef] (load is))
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (let [im (al-elem [ImplDef] is (load i))]
                       (when (and (impl-is-trait im)
                                  (= (impl-trait-name im) "coil.core.Copy"))
                         (when (or (not (copy-impl-generic-bounds? im))
                                   (type-needs-drop a cx (field im self_type)))
                           (break :try
                                    (Err [i64 Diag]
                                         (derr (sconcat a
                                                        (sconcat3 a
                                                                  "impl: Copy for '"
                                                                  (ty-str a (field im self_type))
                                                                  "' is unsafe")
                                                        ": every generic parameter must be Copy and the type must not contain or implement Drop")))))))
                     (store! i (primitive/iadd (load i) 1)))))
         (Ok [i64 Diag] 0))))

; gen-8 supertrait enforcement. A `(deftrait Derived [Self] :requires [Base …])` makes
; `Base` a SUPERTRAIT: every `(impl Derived T)` must be accompanied by an `(impl Base T)`
; for the same implementing type. Run this AFTER `setup-impls` has registered every impl,
; so the required impl may appear anywhere in source order (impl-match sees the whole set).
(defn check-supertraits [(a (dyn Allocator)) (cx (ptr Cx))] (-> (Result i64 Diag))
  (let [is (field cx impls)
        n (al-len [ImplDef] (load is))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [im (al-elem [ImplDef] is (load i))]
                  (when (impl-is-trait im)
                    (let [tr (impl-trait-name im)
                          td (trait-find cx tr)]
                      (when (!= (primitive/cast i64 td) (primitive/cast i64 0))
                        (let [reqs (load (field td requires))
                              nr (al-len [(slice u8)] (load reqs))
                              (mut k) 0]
                          (loop (if (>= (load k) nr)
                                    (break)
                                    (do
                                      (let [req (al-get [(slice u8)] (load reqs) (load k))]
                                        (when (not (impl-match a cx req (field im self_type)))
                                          (store! err
                                                  (derr (sconcat a
                                                                 (impl-prefix a
                                                                              (display-name tr)
                                                                              (ty-str a (field im self_type)))
                                                                 (sconcat a
                                                                          "requires an impl of supertrait '"
                                                                          (sconcat a
                                                                                   (display-name req)
                                                                                   "' for the same type (declared by ':requires' on the trait)")))))
                                          (store! failed true)
                                          (break)))
                                      (if (load failed)
                                          (break)
                                          (store! k (primitive/iadd (load k) 1)))))))))))
                (if (load failed) (break) (set! i (primitive/iadd (load i) 1))))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn setup-one-sig [(a (dyn Allocator)) (cx (ptr Cx)) (fp (ptr Func))] (-> i64)
  (let [cc (.cc fp)
        tps (load (field fp type_params))
        native (conv-is-native cx cc)
        sg (primitive/alloc-stack Sig)]
    (set! (.name sg) (.name fp))
    (set! (.type_params sg) tps)
    (set! (.bounds sg) (load (field fp bounds)))
    (let [(mut names) (al-new [(slice u8)] a)
          ps (load (field fp params))
          n (al-len [Param] (load ps))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (al-push! (mut names) (.name (al-elem [Param] ps (load i))))
                  (set! i (primitive/iadd (load i) 1)))))
      (set! (.param_names sg) (box-al [(slice u8)] a (load names))))
    (set! (.params sg) (param-ref-types a cx (load (field fp params)) tps))
    (set! (.ret sg) (.ret fp))
    (set! (.is_extern sg) false)
    (set! (.variadic sg) false)
    (set! (.cc sg) cc)
    (set! (.fnptr_ok sg) (and native (= (al-len [(slice u8)] (load tps)) (primitive/cast i64 0))))
    (al-push! (mut (.sigs cx)) (load sg))
    (sig-index-put! cx (.name sg))
    0))

(defn param-ref-types [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (ps (ptr (ArrayList Param)))
                       (tps (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (al-new [Type] a)
        n (al-len [Param] (load ps))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (param-ref-type cx (field (al-elem [Param] ps (load i)) ty) tps))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn setup-sigs [(a (dyn Allocator)) (cx (ptr Cx)) (allf (ptr (ArrayList Func)))] (-> i64)
  (let [n (al-len [Func] (load allf))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (setup-one-sig a cx (al-elem [Func] allf (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn setup-externs [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [es (load (field prog externs))
        n (al-len [Extern] (load es))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (al-elem [Extern] es (load i))
                      nm (.name ep)]
                  ; validate the signature's types up front, so an unknown type in an extern
                  ; declaration is a clean diagnostic instead of a later codegen crash.
                  (match (validate-type-list (load (field ep params)) cx (empty-strs a))
                    (Err [d] (do (set! err d) (set! failed true) 0))
                    (Ok [_]
                        (unless (type-is-void (field ep ret))
                          ; void is valid in return position
                          (match (validate-type (field ep ret) cx (empty-strs a))
                            (Err [d] (do (store! err d) (store! failed true) 0))
                            (Ok [_] 0)))))
                  (if (load failed)
                      (break)
                      (if (!= (primitive/cast i64 (sig-find cx nm)) (primitive/cast i64 0))
                          (do
                            (set! err (derr (sconcat3 a "'" nm "' is declared more than once")))
                            (set! failed true)
                            (break))
                          (let [c (conv-find cx (.cc ep))]
                            (if (= (primitive/cast i64 c) (primitive/cast i64 0))
                                (do
                                  (set! err
                                        (derr (sconcat3 a
                                                        (sconcat3 a "extern '" nm "': unknown convention '")
                                                        (.cc ep)
                                                        "'")))
                                  (set! failed true)
                                  (break))
                                (if (conv-is-shim c)
                                    (do
                                      (set! err
                                            (derr (sconcat3 a
                                                            "extern '"
                                                            nm
                                                            "': shim conventions for externs are not supported yet")))
                                      (set! failed true)
                                      (break))
                                    (let [sg (primitive/alloc-stack Sig)]
                                      (set! (.name sg) nm)
                                      (set! (.type_params sg) (empty-strs a))
                                      (set! (.bounds sg) (box-al [Bound] a (al-new [Bound] a)))
                                      (set! (.param_names sg) (empty-strs a))
                                      (set! (.params sg) (load (field ep params)))
                                      (set! (.ret sg) (.ret ep))
                                      (set! (.is_extern sg) true)
                                      (set! (.variadic sg)
                                            (.variadic ep))
                                      (set! (.cc sg) (.cc ep))
                                      (set! (.fnptr_ok sg) true)
                                      (al-push! (mut (.sigs cx)) (load sg))
                                      (sig-index-put! cx (.name sg)))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn opt-type-some? [(o (ptr (Option Type)))] (-> bool)
  (match (load o) (Some [t] true) (_ false)))

(defn opt-type-val [(o (ptr (Option Type)))] (-> Type)
  (match (load o) (Some [t] t) (_ (TVoid))))

(defn type-is-aggregate-static [(t (ptr Type))] (-> bool)
  (match (load t) (TStruct [_] true) (TArray [_ _] true) (_ false)))

(defn compute-const-entry [(a (dyn Allocator)) (cx (ptr Cx)) (cp (ptr Const))] (-> (Result EvalPair Diag))
  (if (is-literal-value (field cp value))
      (const-entry a cp)
      ; non-literal const value = a compile-time computation:
      ; synth the value (fname "const <name>"), then—if the const declares a
      ; type—coerce to it; report (value, declared|synth type). A const reference
      ; later elaborates to `(comptime value)` for the fold pass (see synth EVar).
      (let [nm (.name cp)
            env (env-new a)
            tps (empty-strs a)
            expected (if (opt-type-some? (field cp ty)) (box-type a (opt-type-val (field cp ty))) (null-type))]
        (match (do-synth a (field cp value) expected env cx tps (sconcat a "const " nm))
          (Err [d] (Err [EvalPair Diag] d))
          (Ok [sp0]
              (let [sp (primitive/alloc-stack SynPair)]
                (set! sp sp0)
                (match (.ty cp)
                  (Some [want]
                        (let [wt (box-type a want)
                              tstr (ty-str a (load (field sp t)))]
                          (try (let [ev
                                       (try-or! (coerce a
                                                        (load (load (field sp e)))
                                                        (load (field sp
                                                                     t))
                                                        wt
                                                        false
                                                        nm
                                                        "const value")
                                                (Err [EvalPair Diag]
                                                     (derr (sconcat a
                                                                    (sconcat5 a
                                                                              "const '"
                                                                              nm
                                                                              "': value has type "
                                                                              tstr
                                                                              " but declared ")
                                                                    (ty-str a wt)))))]
                                 (Ok (mk-evalpair ev want))))))
                  (None []
                        (Ok (mk-evalpair (load (load (field sp e)))
                                         (load (load (field sp
                                                            t)))))))))))))

(defn setup-consts [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [cs (load (field prog consts))
        n (al-len [Const] (load cs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [cp (al-elem [Const] cs (load i))
                      nm (.name cp)]
                  (if (or (!= (primitive/cast i64 (sig-find cx nm)) (primitive/cast i64 0))
                          (!= (primitive/cast i64 (const-find cx nm))
                              (primitive/cast i64 0)))
                      (do
                        (set! err (derr (sconcat3 a "'" nm "' is declared more than once")))
                        (set! failed true)
                        (break))
                      (match (compute-const-entry a cx cp)
                        (Err [d] (do (set! err d) (set! failed true) (break)))
                        (Ok [epv]
                            (let [ep (primitive/alloc-stack EvalPair)]
                              (set! ep epv)
                              (do
                                ; An aggregate-typed const used to be classified as a
                                ; STATIC, and a reference to one elaborated to
                                ; `EStaticRef` — which NO backend can lower, because not
                                ; one of the four ever pushes to `cg.statics`. Statics
                                ; were a half-built representation with no consumer.
                                ;
                                ; Drop the classification entirely and let an aggregate
                                ; const take the path a non-literal const already takes:
                                ; `EComptime` of its value, materialized by the comptime
                                ; engine at each use. That machinery already handles
                                ; structs, sums and arrays, so the feature falls out of a
                                ; DELETION rather than four backends learning to emit
                                ; constant-initialized globals with each aggregate's
                                ; exact layout.
                                ;
                                ; The trade is that the value is materialized per use
                                ; rather than referenced once. That is what every other
                                ; non-literal const already does, and correctness before
                                ; a shared global for a `const`.
                                (let [ce (primitive/alloc-stack ConstEntry)]
                                  (set! (.name ce) nm)
                                  (set! (.value ce) (.e ep))
                                  (set! (.ty ce) (.t ep))
                                  (al-push! (mut (.consts cx)) (load ce)))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn setup-validate-const-types [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [cs (load (field prog consts))
        n (al-len [Const] (load cs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [cp (al-elem [Const] cs (load i))
                      nm (.name cp)]
                  (when (opt-type-some? (field cp ty))
                    (match (validate-type (box-type a (opt-type-val (field cp ty))) cx (empty-strs a))
                      (Err [d]
                           (do
                             (store! err (prefix-diag a d (sconcat3 a "const '" nm "': ")))
                             (store! failed true)
                             (break)))
                      (Ok [_] 0))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn validate-one-struct-fields [(a (dyn Allocator)) (cx (ptr Cx)) (sp (ptr StructDef))] (-> (Result i64 Diag))
  (let [nm (.name sp)
        tps (load (field sp type_params))
        fs (load (field sp fields))
        n (al-len [Field] (load fs))
        (mut i) 0
        (mut seen) (al-new [(slice u8)] a)
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Field] fs (load i))
                      fnm (.name fp)]
                  (if (set-contains (box-al [(slice u8)] a (load seen)) fnm)
                      (do
                        (set! err
                              (derr (sconcat a (sconcat3 a "struct '" nm "': duplicate field '") (sconcat a fnm "'"))))
                        (set! failed true)
                        (break))
                      (do
                        (al-push! (mut seen) fnm)
                        (match (validate-type (field fp ty) cx tps)
                          (Err [d]
                               (do
                                 (set! err
                                       (prefix-diag a
                                                    d
                                                    (sconcat a
                                                             (sconcat3 a "struct '" nm "' field '")
                                                             (sconcat a fnm "': "))))
                                 (set! failed true)
                                 (break)))
                          (Ok [_] 0)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn setup-validate-struct-fields [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [fs (load (field prog structs))
        n (al-len [StructDef] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (validate-one-struct-fields a cx (al-elem [StructDef] fs (load i)))
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn validate-one-variant-fields [(a (dyn Allocator))
                                   (cx (ptr Cx))
                                   (sumnm (slice u8))
                                   (tps (ptr (ArrayList (slice u8))))
                                   (vp (ptr Variant))] (-> (Result i64 Diag))
  (let [vnm (.name vp)
        fs (load (field vp fields))
        n (al-len [Field] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Field] fs (load i))
                      fnm (.name fp)]
                  (match (validate-type (field fp ty) cx tps)
                    (Err [d]
                         (do
                           (set! err
                                 (prefix-diag a
                                              d
                                              (sconcat a
                                                       (sconcat a
                                                                (sconcat3 a "sum '" sumnm "' variant '")
                                                                (sconcat3 a vnm "' field '" fnm))
                                                       "': ")))
                           (set! failed true)
                           (break)))
                    (Ok [_] 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn validate-one-sum-fields [(a (dyn Allocator)) (cx (ptr Cx)) (sp (ptr SumDef))] (-> (Result i64 Diag))
  (let [sumnm (.name sp)
        tps (load (field sp type_params))
        vs (load (field sp variants))
        n (al-len [Variant] (load vs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (validate-one-variant-fields a cx sumnm tps (al-elem [Variant] vs (load i)))
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn setup-validate-sum-fields [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result i64 Diag))
  (let [fs (load (field prog sums))
        n (al-len [SumDef] (load fs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (validate-one-sum-fields a cx (al-elem [SumDef] fs (load i)))
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

;; Is this `inline` entry the one `setup` itself appends, rather than a user's
;; `(defannotation :inline …)`? The compiler's carries `coil.core.InlinePolicy`,
;; an internal type nothing in user source binds to `:inline`, so the value type
;; is the signal — `(defannotation :inline bool)` is still the rejected case that
;; `tests/compiler/oracle/diag/inputs/22-annotation-reserved-inline.coil` pins.
(defn compiler-inline-def? [(ent (ptr AnnotationDef))] (-> bool)
  (match (.value_type ent)
    (TStruct [n] (= n "coil.core.InlinePolicy"))
    (_ false)))

(defn setup [(a (dyn Allocator))
             (cx (ptr Cx))
             (prog (ptr Program))
             (impb (ptr (ArrayList ImpEntry)))
             (expb (ptr (ArrayList ExpEntry)))] (-> (Result (ptr (ArrayList Func)) Diag))
  (try (do
         (cx-init-tables cx a)
         ; Bootstrap the one compiler-owned annotation without requiring the
         ; stage-0 compiler to understand `defannotation` in core's own source.
         ;
         ; ⚠ This APPENDS to the caller's `prog`, so `setup` must be idempotent: a
         ; program that already carries the compiler's own `inline` entry is being
         ; checked for the SECOND time, not redefining anything. Metaprogram
         ; staging is exactly that case — it copies `annotation_defs` from an
         ; already-checked program into the sub-program it builds
         ; (comptime.coil:3768, metalower.coil:894) and checks that — and without
         ; this the second pass tripped the redefinition guard below, reported as
         ; "macro 'coil.control.when' could not be compiled into the metaprogram
         ; engine: annotation ':inline' is compiler-defined and cannot be
         ; redefined". Which points at the metaprogram engine, where the bug is not.
         (let [defs (load (field prog annotation_defs))
               dn (al-len [AnnotationDef] (load defs))
               (mut di) 0
               (mut have-inline) false]
           (loop (if (>= (load di) dn)
                     (break)
                     (do
                       (let [ent (al-elem [AnnotationDef] defs (load di))
                             key (load (field ent key))]
                         (when (= key "inline")
                           ; ours, from a previous `setup` — adopt it and move on
                           (unless (compiler-inline-def? ent)
                             (break :try
                                      (Err [(ptr (ArrayList Func)) Diag]
                                           (derr "annotation ':inline' is compiler-defined and cannot be redefined"))))
                           (store! have-inline true))
                         (when (and (not (= key "inline"))
                                    (hm-contains? [(slice u8) i64] (load (field cx annotation_idx)) key))
                           (break :try
                                    (Err [(ptr (ArrayList Func)) Diag]
                                         (derr (sconcat3 a "duplicate annotation definition ':" key "'")))))
                         (hm-put! [(slice u8) i64] (mut (field cx annotation_idx)) key (load di)))
                       (store! di (primitive/iadd (load di) 1)))))
           (unless (load have-inline)
             (let [ad (primitive/alloc-stack AnnotationDef)]
               (store! (field ad key) "inline")
               (store! (field ad value_type) (TStruct "coil.core.InlinePolicy"))
               (hm-put! [(slice u8) i64] (mut (field cx annotation_idx)) "inline" dn)
               (al-push! [AnnotationDef] defs (load ad))
               0)))
         (store! (field cx annotation_defs) (load (field prog annotation_defs)))
         (store! (field cx imports) impb)
         (store! (field cx exports) expb)
         (store! (field cx conventions) (load (field prog conventions)))
         (try! (setup-structs a cx prog))
         (try! (setup-sums a cx prog))
         (try! (setup-traits a cx prog))
         (let [fb (box! a FBox (primitive/zeroed FBox))]
           (store! (field fb items) (al-new [Func] a))
           (copy-funcs a fb prog)
           (try! (setup-impls a cx prog fb))
           (try! (check-supertraits a cx))
           (try! (check-copy-impls a cx))
           (setup-sigs a cx (field fb items))
           (try! (setup-externs a cx prog))
           (try! (setup-consts a cx prog))
           (try! (setup-validate-const-types a cx prog))
           (try! (setup-validate-struct-fields a cx prog))
           (try! (setup-validate-sum-fields a cx prog))
           (Ok (field fb items))))))

; ============================ check_func (Phase 2) =================
(defn validate-params [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (ps (ptr (ArrayList Param)))
                       (tps (ptr (ArrayList (slice u8))))
                       (fnm (slice u8))] (-> (Result i64 Diag))
  (let [n (al-len [Param] (load ps))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pp (al-elem [Param] ps (load i))
                      pnm (.name pp)]
                  (match (validate-type (field pp ty) cx tps)
                    (Err [d]
                         (do
                           (set! err
                                 (prefix-diag a
                                              d
                                              (sconcat a
                                                       (sconcat3 a "function '" fnm "' param '")
                                                       (sconcat a pnm "': "))))
                           (set! failed true)
                           (break)))
                    (Ok [_] 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok [i64 Diag] 0))))

(defn build-param-env [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (ps (ptr (ArrayList Param)))
                       (tps (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList EnvEntry)))
  (let [(mut out) (al-new [EnvEntry] a)
        n (al-len [Param] (load ps))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pp (al-elem [Param] ps (load i))
                      ee (primitive/alloc-stack EnvEntry)
                      bid (next-bid)]
                  (set! (.name ee) (.name pp))
                  (set! (.ty ee) (param-body-ref-type cx (field pp ty) tps))
                  (set! (.bid ee) bid)
                  (set! (.bid pp) bid)
                  (set! (.owned_type pp)
                        (if (type-is-affine a cx (field pp ty))
                            (box-type a (.ty pp))
                            (primitive/cast (ptr Type) 0)))
                  (al-push! (mut out) (load ee)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [EnvEntry] a (load out))))

(defn erase-param-types [(a (dyn Allocator))
                         (cx (ptr Cx))
                         (ps (ptr (ArrayList Param)))
                         (tps (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList Param)))
  (let [(mut out) (al-new [Param] a)
        n (al-len [Param] (load ps))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pp (al-elem [Param] ps (load i))
                      np (primitive/alloc-stack Param)]
                  (set! (.name np) (.name pp))
                  (set! (.ty np) (erase-refs a (box-type a (param-body-ref-type cx (field pp ty) tps))))
                  (set! (.bid np) (.bid pp))
                  (set! (.owned_type np) (.owned_type pp))
                  (al-push! (mut out) (load np)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Param] a (load out))))

; check one body, accumulator-style (NO return-from inside the loop — gotcha #1).
(defn check-body [(a (dyn Allocator))
                  (cx (ptr Cx))
                  (fp (ptr Func))
                  (env (ptr (ArrayList EnvEntry)))
                  (tps (ptr (ArrayList (slice u8))))
                  (fnm (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [body (load (field fp body))
        bn (al-len [Expr] (load body))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) bn)
              (break)
              (do
                (let [ep (al-elem [Expr] body (load i))
                      istail (= (primitive/iadd (load i) 1) bn)]
                  (if istail
                      (match (synth a ep (field fp ret) env cx tps fnm)
                        (Err [d] (do (set! err d) (set! failed true) (break)))
                        (Ok [rv]
                            (let [r (primitive/alloc-stack EvalPair)]
                              (set! r rv)
                              (try (let [; point at the TAIL expression: `ep` is it, and its span was right
                                         ; here unused. Without it the message names a type mismatch but not
                                         ; which of a 60-line body's expressions is the offending tail —
                                         ; exactly the question the reader is asking.
                                         ee
                                           (try-or! (coerce a
                                                            (load (field r e))
                                                            (box-type a (load (field r t)))
                                                            (field fp ret)
                                                            false
                                                            fnm
                                                            "body")
                                                    (do
                                                      (store! err
                                                              (dwspan (derr (sconcat a
                                                                                     (sconcat a
                                                                                              (sconcat a
                                                                                                       (sconcat3 a
                                                                                                                 "function '"
                                                                                                                 fnm
                                                                                                                 "': body has type ")
                                                                                                       (ty-str a
                                                                                                               (box-type a
                                                                                                                         (load (field r
                                                                                                                                      t)))))
                                                                                              " but the declared return type is ")
                                                                                     (ty-str a (field fp ret))))
                                                                      (load (field ep source))
                                                                      (load (field ep lo))
                                                                      (load (field ep hi))
                                                                      (load (field ep ctxt))))
                                                      (store! failed true)
                                                      (break)))]
                                     (al-push! (mut out) ee))))))
                      (match (synth a ep (primitive/cast (ptr Type) 0) env cx tps fnm)
                        (Err [d] (do (set! err d) (set! failed true) (break)))
                        (Ok [rv]
                            (let [r (primitive/alloc-stack EvalPair)]
                              (set! r rv)
                              (al-push! (mut out)
                                        (.e r)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err (load err)) (Ok (box-al [Expr] a (load out))))))

(defn check-annotations [(a (dyn Allocator))
                         (cx (ptr Cx))
                         (fp (ptr Func))
                         (tps (ptr (ArrayList (slice u8))))] (-> (Result (ptr (ArrayList Annotation)) Diag))
  (try (let [src (load (field fp annotations))
             n (al-len [Annotation] (load src))
             (mut out) (al-new [Annotation] a)
             env (env-new a)
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (let [ap (al-elem [Annotation] src (load i))
                         key (load (field ap key))
                         def (annotation-def-find cx key)]
                     (when (= (primitive/cast i64 def) (primitive/cast i64 0))
                       (break :try
                                (Err [(ptr (ArrayList Annotation)) Diag]
                                     (derr (sconcat3 a "unknown annotation ':" key "'")))))
                     (let [(mut j) 0]
                       (loop (if (>= (load j) (load i))
                                 (break)
                                 (do
                                   (when (= (load (field (al-elem [Annotation] src (load j)) key)) key)
                                     (break :try
                                              (Err [(ptr (ArrayList Annotation)) Diag]
                                                   (derr (sconcat3 a "duplicate annotation ':" key "'")))))
                                   (store! j (primitive/iadd (load j) 1))))))
                     (let [checked
                             (try! (check-to a
                                             (field ap value)
                                             (field def value_type)
                                             env
                                             cx
                                             tps
                                             (load (field fp name))
                                             (sconcat3 a "annotation ':" key "' value")))
                           np (primitive/alloc-stack Annotation)]
                       (store! (field np key) key)
                       ; Annotation values use the full expression language but
                       ; are declaration-time data, never runtime work. Mark the
                       ; checked expression for the ordinary comptime fold.
                       (store! (field np value)
                               (mk-expr (EComptime (box-expr a checked))
                                        (load (field (field ap value) lo))
                                        (load (field (field ap value) hi))
                                        (load (field (field ap value) source))
                                        (load (field (field ap value) ctxt))))
                       (al-push! (mut out) (load np)))
                     (store! i (primitive/iadd (load i) 1)))))
         (Ok (box-al [Annotation] a (load out))))))

(defn check-func [(a (dyn Allocator)) (cx (ptr Cx)) (fp (ptr Func))] (-> (Result Func Diag))
  (try (do
         (let [tps (load (field fp type_params))
               fnm (load (field fp name))]
           (store! (field cx cur_bounds) (load (load (field fp bounds))))
           (let [conv (conv-find cx (load (field fp cc)))]
             (if (= (primitive/cast i64 conv) (primitive/cast i64 0))
                 (return-from :try
                                (Err [Func Diag]
                                     (derr (sconcat3 a
                                                     (sconcat3 a "function '" fnm "': unknown convention '")
                                                     (load (field fp cc))
                                                     "'"))))
                 (do
                   (when (conv-is-shim conv)
                     (when (conv-ret-none conv)
                       (break :try
                                (Err [Func Diag]
                                     (derr (sconcat3 a
                                                     (sconcat3 a "function '" fnm "': shim convention '")
                                                     (load (field fp cc))
                                                     "' needs a :ret register")))))
                     (when (< (conv-params-len conv)
                              (al-len [Param]
                                      (load (load (field fp
                                                         params)))))
                       (break :try
                                (Err [Func Diag]
                                     (derr (sconcat a
                                                    (sconcat a
                                                             (sconcat a
                                                                      (sconcat a
                                                                               (sconcat3 a
                                                                                         "function '"
                                                                                         fnm
                                                                                         "': convention '")
                                                                               (sconcat a
                                                                                        (load (field fp
                                                                                                     cc))
                                                                                        "' provides "))
                                                                      (i64->str a (conv-params-len conv)))
                                                             (sconcat a
                                                                      " param registers but the function has "
                                                                      (i64->str a
                                                                                (al-len [Param]
                                                                                        (load (load (field fp
                                                                                                           params)))))))
                                                    " parameters"))))))
                   (when (conv-is-reset conv)
                     (when (match (load (field conv ret)) (Some [_] true) (None [] false))
                       (break :try
                                (Err [Func Diag]
                                     (derr (sconcat3 a
                                                     "function '"
                                                     fnm
                                                     "': reset convention cannot name a return register")))))
                     (when (> (conv-params-len conv)
                              (al-len [Param] (load (load (field fp params)))))
                       (break :try
                                (Err [Func Diag]
                                     (derr (sconcat3 a
                                                     "function '"
                                                     fnm
                                                     "': reset convention has more register parameters than the function"))))))
                   0)))
           (try! (validate-params a cx (load (field fp params)) tps fnm))
           (unless (type-is-void (field fp ret))
             (match (validate-type (field fp ret) cx tps)
               (Err [d]
                    (return-from :try
                                   (Err [Func Diag] (prefix-diag a d (sconcat3 a "function '" fnm "' return type: ")))))
               (Ok [_] 0)))
           (let [env (build-param-env a cx (load (field fp params)) tps)
                 body (load (field fp body))
                 bn (al-len [Expr] (load body))]
             ; An empty body has type VOID. `check-body`'s loop never runs when bn = 0,
             ; so this is the ONLY place an empty body is type-checked. It used to
             ; whitelist an i64 return type here (and report "body has type i64"),
             ; which let `(defn f [] (-> i64))` compile and return an undefined value.
             ; Worded as the ORDINARY return-type mismatch, and located like one. A body
             ; with no forms has type void; that it happens to be empty is not a special
             ; kind of error and saying so sent readers down the wrong repair. The shape
             ; that lands here is nearly always a C-style forward declaration, and
             ; "your body is empty" invites changing the RETURN TYPE to void — which
             ; compiles and leaves a useless function — when the fix is to delete the
             ; line, because Coil resolves references within a file in any order,
             ; mutual recursion included. It also had no span at all, alone among the
             ; type errors, so it could not be jumped to.
             (when (and (= bn (primitive/cast i64 0)) (not (type-is-void (field fp ret))))
               (break :try
                        (Err [Func Diag]
                             (derr-at-src (load (field fp source))
                                          (load (field fp lo))
                                          (load (field fp hi))
                                          (sconcat a
                                                   (sconcat3 a
                                                             "function '"
                                                             fnm
                                                             "': body has type void but the declared return type is ")
                                                   (ty-str a (field fp ret)))))))
             (let [checked-annotations (try! (check-annotations a cx fp tps))
                   out-body (try! (check-body a cx fp env (assoc-body-tps a cx (load (field fp bounds)) tps) fnm))
                   outf (primitive/alloc-stack Func)]
               (store! (field outf name) fnm)
               (store! (field outf type_params) tps)
               (store! (field outf bounds) (load (field fp bounds)))
               (store! (field outf cc) (load (field fp cc)))
               (store! (field outf annotations) checked-annotations)
               (store! (field outf params) (erase-param-types a cx (load (field fp params)) tps))
               (store! (field outf ret) (erase-refs a (field fp ret)))
               (store! (field outf body) out-body)
               (store! (field outf macro_variadic) (load (field fp macro_variadic)))
               (store! (field outf lo) (load (field fp lo)))
               (store! (field outf hi) (load (field fp hi)))
               (store! (field outf source) (load (field fp source)))
               (store! (field outf ctxt) (load (field fp ctxt)))
               (Ok (load outf))))))))

; ============================ synth helpers =======================
(defstruct SynPair [(e (ptr Expr)) (t (ptr Type))])

(defstruct SubstEntry [(name (slice u8)) (ty Type)])

(defstruct ArgSlot [(present bool) (e (ptr Expr)) (t (ptr Type))])

(defstruct Deferred [(idx i64) (err Diag)])

(defstruct SumVars [(found bool) (name (slice u8)) (variants (ptr (ArrayList Variant)))])

(defstruct TargsOpt [(found bool) (targs (ptr (ArrayList Type)))])

(defstruct Branch [(e (ptr Expr)) (t (ptr Type))])

(defn sconcat1 [(a (dyn Allocator)) (x (slice u8))] (-> (slice u8))
  x)

(defn sconcat4 [(a (dyn Allocator)) (w (slice u8)) (x (slice u8)) (y (slice u8)) (z (slice u8))] (-> (slice u8))
  (sconcat a (sconcat3 a w x y) z))

(defn sconcat5 [(a (dyn Allocator)) (v (slice u8)) (w (slice u8)) (x (slice u8)) (y (slice u8)) (z (slice u8))] (-> (slice u8))
  (sconcat a (sconcat4 a v w x y) z))

; Scoped resolver keys are internal. User diagnostics retain the identifier's
; source spelling and never expose deterministic-but-unstable scope numbers.
(defn display-ident [(name (slice u8))] (-> (slice u8))
  (scoped-ident-raw name))

(defn unscoped-datum-ident? [(name (slice u8))] (-> bool)
  (and (>= (slice-len [u8] name) (primitive/cast i64 6))
       (str-eq (subslice name 0 6) "$datum")))

(defn mk-synpair [(a (dyn Allocator)) (e (ptr Expr)) (t (ptr Type))] (-> SynPair)
  (let [p (primitive/alloc-stack SynPair)] (set! (.e p) e) (set! (.t p) t) (load p)))

(defn ok-ep [(e Expr) (t Type)] (-> (Result EvalPair Diag))
  (Ok [EvalPair Diag] (mk-evalpair e t)))

(defn err-ep [(d Diag)] (-> (Result EvalPair Diag))
  (Err [EvalPair Diag] d))

(defn do-synth [(a (dyn Allocator))
                (e (ptr Expr))
                (expected (ptr Type))
                (env (ptr (ArrayList EnvEntry)))
                (cx (ptr Cx))
                (tps (ptr (ArrayList (slice u8))))
                (fname (slice u8))] (-> (Result SynPair Diag))
  (match (synth a e expected env cx tps fname)
    (Err [d] (Err [SynPair Diag] d))
    (Ok [rv]
        (let [r (primitive/alloc-stack EvalPair)]
          (set! r rv)
          ; S2: record this expression's inferred type, keyed by its NODE ID, so a
          ; metaprogram can ask `(primitive/type-of NODE)` for any expression's exact type.
          (type-map-record (.nid e) (.t r))
          ; The checked output node inherits the INPUT node's id (never dumped, so
          ; oracles are unaffected): metalower reads the type map through the
          ; checked AST, and without this every rebuilt node would be nid -1.
          (set! (.nid (.e r)) (.nid e))
          ; S1: record a reference's RESOLVED entity (qualified name) by node id, so
          ; `(primitive/code-decl NODE)` answers with the exact function/variant/etc. it picked.
          (match (.kind e)
            (ECall [func targs args] (res-map-record (.nid e) func))
            (EFnPtrOf [name] (res-map-record (.nid e) name))
            ; Dedicated memory nodes still have declarations. Lints use these
            ; authoritative identities so an alias or lookalike user function
            ; cannot be mistaken for a primitive operation.
            (EField [_ _] (res-map-record (.nid e) "coil.primitive.field"))
            (ELoad [_] (res-map-record (.nid e) "coil.primitive.load"))
            (EStore [_ _] (res-map-record (.nid e) "coil.primitive.store!"))
            ; S3: record which LOCAL binding a reference resolves to, so
            ; `(primitive/binding-of NODE)` distinguishes shadowed locals for a borrow checker.
            (EVar [name] (bind-map-record (.nid e) (env-get-bid env name)))
            (_ 0))
          ; Qualified primitive calls elaborate into dedicated memory nodes. Record
          ; that checked identity as the final answer for the authored call node.
          (match (.kind (.e r))
            (EField [_ _] (res-map-record (.nid e) "coil.primitive.field"))
            (ELoad [_] (res-map-record (.nid e) "coil.primitive.load"))
            (EStore [_ _] (res-map-record (.nid e) "coil.primitive.store!"))
            (_ 0))
          (Ok (mk-synpair a (box-expr a (.e r)) (box-type a (.t r))))))))

(defn expected-some? [(expected (ptr Type))] (-> bool)
  (!= (primitive/cast i64 expected) (primitive/cast i64 0)))

(defn null-type [] (-> (ptr Type))
  (primitive/cast (ptr Type) 0))

; Lower `[a b ...]` after element checking. The temporary is a normal mutable
; aggregate let-place, which already has the entry-block allocation and lifetime
; semantics array literals need; no backend-specific literal node is required.
(defn synth-array-literal [(a (dyn Allocator))
                           (items (ptr (ArrayList Expr)))
                           (expected (ptr Type))
                           (env (ptr (ArrayList EnvEntry)))
                           (cx (ptr Cx))
                           (tps (ptr (ArrayList (slice u8))))
                           (fname (slice u8))
                           (lo i64)
                           (hi i64)
                           (src i64)
                           (ctxt i64)] (-> (Result EvalPair Diag))
  (try (let [n (al-len [Expr] (load items))]
         (when (= n 0)
           (break :try
                    (err-ep (derr (sconcat3 a
                                            "in '"
                                            fname
                                            "': an empty array literal needs an element type; use (: [] (array T 0)) once zero-length arrays are supported")))))
         (let [(mut elem) (primitive/zeroed Type)
               (mut inferred_place_element) false
               (mut checked) (al-new [Expr] a)
               (mut i) 0]
           (match (if (expected-some? expected)
                      (match (load expected)
                        (TArray [et en]
                                (if (= en n)
                                    (check-to a (al-elem [Expr] items 0) et env cx tps fname "array element")
                                    (Err [Expr Diag]
                                         (derr (sconcat a
                                                        (sconcat3 a "in '" fname "': array literal has ")
                                                        (sconcat a
                                                                 (i64->str a n)
                                                                 (sconcat a " elements but expected " (i64->str a en))))))))
                        (TSlice [et]
                                (check-to a (al-elem [Expr] items 0) et env cx tps fname "array element"))
                        (_ (match (do-synth a (al-elem [Expr] items 0) (null-type) env cx tps fname)
                             (Err [d] (Err [Expr Diag] d))
                             (Ok [sp]
                                 (let [p (primitive/alloc-stack SynPair)]
                                   (store! p sp)
                                   (Ok [Expr Diag] (load (load (field p e)))))))))
                      (match (do-synth a (al-elem [Expr] items 0) (null-type) env cx tps fname)
                        (Err [d] (Err [Expr Diag] d))
                        (Ok [sp]
                            (let [p (primitive/alloc-stack SynPair)]
                              (store! p sp)
                              (Ok [Expr Diag] (load (load (field p e))))))))
             (Err [d] (break :try (err-ep d)))
             (Ok [first]
                 (do
                   (if (and (expected-some? expected)
                            (or (= (type-tag expected) (primitive/cast i64 7))
                                (= (type-tag expected) (primitive/cast i64 8))))
                       (match (load expected)
                         (TArray [et _] (store! elem (load et)))
                         (TSlice [et] (store! elem (load et)))
                         (_ 0))
                       (let [sp (try! (do-synth a (al-elem [Expr] items 0) (null-type) env cx tps fname))
                             p (primitive/alloc-stack SynPair)]
                         (store! p sp)
                         (store! elem (load (load (field p t))))
                         ; Aggregate constructors synthesize to places because
                         ; Coil represents them with backing storage. An inferred
                         ; array literal owns the values copied from those places;
                         ; it is not an array of references to constructor
                         ; temporaries. Preserve an explicitly requested `(ref
                         ; T)` element type, but strip this inferred place wrapper.
                         (match (load elem)
                           (TRef [_ pointee]
                                 (do
                                   (store! elem (load pointee))
                                   (store! inferred_place_element true)))
                           (_ 0))))
                   (al-push! (mut checked)
                             (if (load inferred_place_element)
                                 (mk-expr (ELoad (box-expr a first)) lo hi src ctxt)
                                 first)))))
           (store! i 1)
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (al-push! (mut checked)
                                 (try! (check-to a
                                                 (al-elem [Expr] items (load i))
                                                 (mut elem)
                                                 env
                                                 cx
                                                 tps
                                                 fname
                                                 "array element")))
                       (store! i (+ (load i) 1)))))
           (let [aty (TArray (box-type a (load elem)) n)
                 nm (sconcat a "$arraylit" (i64->str a lo))
                 (mut binds) (al-new [Bind] a)
                 (mut body) (al-new [Expr] a)]
             (al-push! (mut binds)
                       (mk-bind nm false (mk-expr (EAlloc 3 aty (primitive/cast (ptr Expr) 0)) lo hi src ctxt)))
             (store! i 0)
             (loop (if (>= (load i) n)
                       (break)
                       (do
                         (al-push! (mut body)
                                   (mk-expr (EStore (box-expr a
                                                              (mk-expr (EIndex (box-expr a
                                                                                         (mk-expr (EVar nm)
                                                                                                  lo
                                                                                                  hi
                                                                                                  src
                                                                                                  ctxt))
                                                                               (box-expr a
                                                                                         (mk-expr (EInt (load i))
                                                                                                  lo
                                                                                                  hi
                                                                                                  src
                                                                                                  ctxt)))
                                                                       lo
                                                                       hi
                                                                       src
                                                                       ctxt))
                                                    (box-expr a (al-get [Expr] (load checked) (load i))))
                                            lo
                                            hi
                                            src
                                            ctxt))
                         (store! i (+ (load i) 1)))))
             (al-push! (mut body)
                       (if (and (expected-some? expected)
                                (= (type-tag expected) (primitive/cast i64 8)))
                           (mk-expr (EMakeSlice
                                      :data
                                        (box-expr a
                                                  (mk-expr (EIndex (box-expr a
                                                                             (mk-expr (EVar nm) lo hi src ctxt))
                                                                   (box-expr a
                                                                             (mk-expr (EInt 0) lo hi src ctxt)))
                                                           lo
                                                           hi
                                                           src
                                                           ctxt))
                                      :elem (load elem)
                                      :len n)
                                    lo
                                    hi
                                    src
                                    ctxt)
                           (mk-expr (ELoad (box-expr a (mk-expr (EVar nm) lo hi src ctxt))) lo hi src ctxt)))
             (ok-ep (mk-expr (ELet (box-al [Bind] a (load binds)) (box-al [Expr] a (load body))) lo hi src ctxt)
                    (if (and (expected-some? expected) (= (type-tag expected) (primitive/cast i64 8)))
                        (TSlice (box-type a (load elem)))
                        aty)))))))

; ---- env --------------------------------------------------------------------
(defn env-get [(env (ptr (ArrayList EnvEntry))) (name (slice u8))] (-> (ptr Type))
  (let [n (al-len [EnvEntry] (load env))
        (mut i) (primitive/isub n 1)
        (mut r) (primitive/cast (ptr Type) 0)]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (do
                (when (= (load (field (al-elem [EnvEntry] env (load i)) name)) name)
                  (store! r (field (al-elem [EnvEntry] env (load i)) ty))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (load r)))

(defn env-insert! [(env (ptr (ArrayList EnvEntry))) (name (slice u8)) (ty (ptr Type))] (-> i64)
  (let [ee (primitive/alloc-stack EnvEntry)
        bid (next-bid)]
    (set! (.name ee) name)
    (set! (.ty ee) (load ty))
    (set! (.bid ee) bid)
    (al-push! [EnvEntry] env (load ee))
    bid))

; the binding id a name resolves to in the current env (0 = not a local)
(defn env-get-bid [(env (ptr (ArrayList EnvEntry))) (name (slice u8))] (-> i64)
  (let [n (al-len [EnvEntry] (load env))
        (mut i) (primitive/isub n 1)
        (mut r) 0]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (do
                (when (= (load (field (al-elem [EnvEntry] env (load i)) name)) name)
                  (store! r (load (field (al-elem [EnvEntry] env (load i)) bid)))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (load r)))

(defn env-truncate! [(env (ptr (ArrayList EnvEntry))) (newlen i64)] (-> i64)
  (set! (.len env) newlen)
  0)

; ---- substitution map -------------------------------------------------------
(defn subst-new [(a (dyn Allocator))] (-> (ptr (ArrayList SubstEntry)))
  (box-al [SubstEntry] a (al-new [SubstEntry] a)))

(defn subst-get [(s (ptr (ArrayList SubstEntry))) (name (slice u8))] (-> (ptr Type))
  (let [n (al-len [SubstEntry] (load s))
        (mut i) 0
        (mut r) (primitive/cast (ptr Type) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [SubstEntry] s (load i)) name)) name)
                  (store! r (field (al-elem [SubstEntry] s (load i)) ty))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn subst-has [(s (ptr (ArrayList SubstEntry))) (name (slice u8))] (-> bool)
  (!= (primitive/cast i64 (subst-get s name)) (primitive/cast i64 0)))

(defn subst-insert! [(s (ptr (ArrayList SubstEntry))) (name (slice u8)) (ty (ptr Type))] (-> i64)
  (let [se (primitive/alloc-stack SubstEntry)]
    (set! (.name se) name)
    (set! (.ty se) (load ty))
    (al-push! [SubstEntry] s (load se))))

; ---- pure type helpers ------------------------------------------------------
; The module part of a qualified name: `hyglib5.Mine` -> `hyglib5`. Empty when the
; name carries no dot. Companion to `after-last-dot`, which returns the tail.
(defn before-last-dot [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len [u8] s)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get s (load i))) (primitive/cast i64 46))
                  (store! at (load i))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (if (< (load at) (primitive/cast i64 0)) "" (subslice [u8] s 0 (load at)))))

(defn after-last-dot [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len [u8] s)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get s (load i))) (primitive/cast i64 46))
                  (store! at (load i))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (if (< (load at) (primitive/cast i64 0)) s (subslice [u8] s (primitive/iadd (load at) 1) n))))

(defn is-struct-or-app [(t (ptr Type))] (-> bool)
  (let [tg (type-tag t)] (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 11)))))

(defn struct-name [(t (ptr Type))] (-> (slice u8))
  (let [tg (type-tag t)]
    (if (= tg (primitive/cast i64 6)) (type-struct-name t) (if (= tg (primitive/cast i64 11)) (t-app-name t) ""))))

(defn place-pointee [(t (ptr Type))] (-> (ptr Type))
  (let [tg (type-tag t)]
    (if (or (= tg (primitive/cast i64 4)) (= tg (primitive/cast i64 5))) (t-inner t) (primitive/cast (ptr Type) 0))))

(defn is-writable [(t (ptr Type))] (-> bool)
  (let [tg (type-tag t)] (or (= tg (primitive/cast i64 4)) (and (= tg (primitive/cast i64 5)) (t-ref-mut t)))))

(defn replace-pointee [(a (dyn Allocator)) (place (ptr Type)) (new (ptr Type))] (-> Type)
  (if (= (type-tag place) (primitive/cast i64 5))
      (TRef (t-ref-mut place) (box-type a (load new)))
      (TPtr (box-type a (load new)))))

(defn is-place-value-type [(t (ptr Type)) (cx (ptr Cx))] (-> bool)
  (let [tg (type-tag t)]
    (cond (= tg (primitive/cast i64 6))
            (!= (primitive/cast i64 (struct-find cx (type-struct-name t))) (primitive/cast i64 0))
          (= tg (primitive/cast i64 11))
            (!= (primitive/cast i64 (struct-find cx (t-app-name t))) (primitive/cast i64 0))
          (= tg (primitive/cast i64 7)) true
          :else false)))

; The dispatch key. There is exactly ONE definition of it — `parser.coil::impl-base-name`
; — and check/mono both delegate here. This used to be three hand-synced copies (here,
; the parser, and `mono.coil::mono-impl-name`); adding pointers to two of the three
; shipped a compiler that type-checked `(!= p q)` and then died in mono. One key, one
; place. "" = the type can't carry an impl.
(defn type-impl-name [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (impl-base-name a t))

(defn has-impl-name [(a (dyn Allocator)) (t (ptr Type))] (-> bool)
  (!= (slice-len (impl-base-name a t)) (primitive/cast i64 0)))

; ---- impl selection ---------------------------------------------------------
; The key (type-impl-name) names only the head constructor, so a key hit alone would
; answer "yes" for EVERY instantiation of it — `impl Len (Pair i64 i64)` would claim
; `(Pair u8 bool)`, and the mismatch would only surface later as a confusing
; argument-type error rather than "does not implement Len". So the key merely narrows
; the candidates; selection then matches the receiver against each candidate's own
; self_type pattern, binding that impl's type params (unify-trait-extras).

; Does pattern `pt` (with variables `pp`) match the type `t`? One-way: only `pp`'s
; names bind. Used both to test a receiver and to compare two impls' generality.
(defn pat-matches? [(a (dyn Allocator)) (pt (ptr Type)) (pp (ptr (ArrayList (slice u8)))) (t (ptr Type))] (-> bool)
  (unify-trait-extras a pt t pp (subst-new a)))

; Is `x` at least as specific as `y`? Exactly: y's pattern matches x's self_type, so
; every type x accepts, y accepts too. `(Pair i64 i64)` <= `(Pair A B)` because
; `(Pair A B)` matches `(Pair i64 i64)` but not conversely. `(Pair A A)` <= `(Pair A B)`
; for the same reason (A binds twice, and the second binding must agree).
(defn impl-le? [(a (dyn Allocator)) (x (ptr ImplDef)) (y (ptr ImplDef))] (-> bool)
  (pat-matches? a (field y self_type) (load (field y type_params)) (field x self_type)))

; The impls of `tr` whose pattern accepts `recv`, reduced to the single most specific
; one. `ambiguous` = two candidates matched and neither is more specific than the other
; (e.g. `(Pair i64 B)` and `(Pair A bool)` at `(Pair i64 bool)`), which is reported at
; the use site rather than forbidden at definition — disjoint or ordered impls are fine,
; only an actually-instantiated overlap is an error.
(defstruct ImplSel [(ip (ptr ImplDef)) (ambiguous bool)])

; Does candidate `ip` of `tr` accept `recv`? (`key` narrows by head constructor first)
(defn impl-cand? [(a (dyn Allocator)) (tr (slice u8)) (key (slice u8)) (recv (ptr Type)) (ip (ptr ImplDef))] (-> bool)
  (and (and (and (impl-is-trait ip) (= (impl-trait-name ip) tr)) (= (.for_type ip) key))
       (pat-matches? a (field ip self_type) (load (field ip type_params)) recv)))

; Takes an impl list plus its precomputed candidate bucket, so check and mono share
; one specificity algorithm without either phase scanning unrelated impls.
(defn impl-select-indexed [(a (dyn Allocator))
                           (impls (ptr (ArrayList ImplDef)))
                           (bucket (ptr ImplBucket))
                           (tr (slice u8))
                           (recv (ptr Type))] (-> ImplSel)
  (let [r (primitive/alloc-stack ImplSel)]
    (set! (.ip r) (primitive/cast (ptr ImplDef) 0))
    (set! (.ambiguous r) false)
    (if (not (has-impl-name a recv))
        (load r)
        (let [key (type-impl-name a recv)
              n
                (if (= (primitive/cast i64 bucket) (primitive/cast i64 0))
                    0
                    (al-len [i64] (.items bucket)))]
          ; pass 1 — greedy minimum under the specificity order
          (let [(mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (let [ip
                                (al-elem [ImplDef]
                                         impls
                                         (al-get [i64] (.items bucket) (load i)))]
                          (when (impl-cand? a tr key recv ip)
                            (let [best (load (field r ip))]
                              (when (or (= (primitive/cast i64 best) (primitive/cast i64 0)) (impl-le? a ip best))
                                (store! (field r
                                               ip)
                                        ip)
                                0))))
                        (set! i (primitive/iadd (load i) 1))))))
          ; pass 2 — the winner must be at least as specific as EVERY candidate, not just
          ; the ones it happened to be compared against. A single greedy scan would let
          ; `(Pair i64 B)` and `(Pair A bool)` at `(Pair i64 bool)` silently pick whichever
          ; came last instead of reporting the overlap.
          (let [best (load (field r ip))
                (mut j) 0]
            (unless (= (primitive/cast i64 best) (primitive/cast i64 0))
              (loop (if (>= (load j) n)
                        (break)
                        (do
                          (let [ip
                                  (al-elem [ImplDef]
                                           impls
                                           (al-get [i64] (load (field bucket items)) (load j)))]
                            (when (impl-cand? a tr key recv ip)
                              (unless (impl-le? a best ip) (store! (field r ambiguous) true) (break))))
                          (store! j (primitive/iadd (load j) 1)))))))
          (load r)))))

(defn inherent-owner-matches? [(owner (slice u8)) (qual (slice u8))] (-> bool)
  (or (= (slice-len qual) (primitive/cast i64 0))
      (or (= owner qual) (= (after-last-dot owner) qual))))

(defn inherent-cand? [(a (dyn Allocator))
                      (name (slice u8))
                      (qual (slice u8))
                      (key (slice u8))
                      (recv (ptr Type))
                      (ip (ptr ImplDef))] (-> bool)
  (if (or (impl-is-trait ip)
          (or (not (= (.for_type ip) key))
              (not (inherent-owner-matches? (.for_type ip) qual))))
      false
      (let [m (impl-find-method ip name)]
        (and (!= (primitive/cast i64 m) (primitive/cast i64 0))
             (and (inherent-receiver? a ip m)
                  (pat-matches? a (field ip self_type) (load (field ip type_params)) recv))))))

; Receiver-method selection is the trait specialization order restricted to
; inherent impls that actually define `name`. A generic `(impl [T] (Box T) …)`
; and a concrete `(impl (Box i64) …)` may coexist; the concrete method wins for
; Box<i64>, while unordered overlaps are diagnosed at the call site.
(defn inherent-select [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (name (slice u8))
                       (qual (slice u8))
                       (recv (ptr Type))] (-> ImplSel)
  (let [r (primitive/alloc-stack ImplSel)]
    (set! (.ip r) (primitive/cast (ptr ImplDef) 0))
    (set! (.ambiguous r) false)
    (if (not (has-impl-name a recv))
        (load r)
        (let [key (type-impl-name a recv)
              bucket (impl-index-get (field cx inherent_impl_idx) (impl-index-key a name key))
              n
                (if (= (primitive/cast i64 bucket) (primitive/cast i64 0))
                    0
                    (al-len [i64] (.items bucket)))
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (let [ip
                              (al-elem [ImplDef]
                                       (field cx impls)
                                       (al-get [i64] (.items bucket) (load i)))]
                        (when (inherent-cand? a name qual key recv ip)
                          (let [best (load (field r ip))]
                            (when (or (= (primitive/cast i64 best) (primitive/cast i64 0)) (impl-le? a ip best))
                              (store! (field r ip) ip)
                              0))))
                      (set! i (primitive/iadd (load i) 1)))))
          (let [best (load (field r ip))
                (mut j) 0]
            (unless (= (primitive/cast i64 best) (primitive/cast i64 0))
              (loop (if (>= (load j) n)
                        (break)
                        (do
                          (let [ip
                                  (al-elem [ImplDef]
                                           (field cx impls)
                                           (al-get [i64] (load (field bucket items)) (load j)))]
                            (when (inherent-cand? a name qual key recv ip)
                              (unless (impl-le? a best ip)
                                (store! (field r ambiguous) true)
                                (break))))
                          (store! j (primitive/iadd (load j) 1)))))))
          (load r)))))

; Like trait autoderef, try the receiver's own type before peeling. This matters
; now that structural types can carry extension methods: an impl on `(ptr T)` must
; win over a method on T when the argument itself is a pointer.
(defn inherent-select-deref [(a (dyn Allocator))
                             (cx (ptr Cx))
                             (name (slice u8))
                             (qual (slice u8))
                             (recv0 (ptr Type))] (-> ImplSel)
  (let [out (primitive/alloc-stack ImplSel)
        (mut recv) recv0
        (mut done) false]
    (set! (.ip out) (primitive/cast (ptr ImplDef) 0))
    (set! (.ambiguous out) false)
    (loop (if (load done)
              (break)
              (let [one (primitive/alloc-stack ImplSel)]
                (set! one (inherent-select a cx name qual (load recv)))
                (if (or (.ambiguous one)
                        (!= (primitive/cast i64 (load (field one ip))) (primitive/cast i64 0)))
                    (do (set! out (load one)) (set! done true) 0)
                    (let [tg (type-tag (load recv))]
                      (if (or (= tg (primitive/cast i64 4)) (= tg (primitive/cast i64 5)))
                          (set! recv (t-inner (load recv)))
                          (set! done true)))))))
    (load out)))

; Associated functions have no receiver from which to choose a specialization.
; Setup rejects duplicate owner/name definitions, so more than one match here can
; only be a short-name ambiguity between modules and is reported as such.
(defn inherent-associated-select [(a (dyn Allocator))
                                  (cx (ptr Cx))
                                  (name (slice u8))
                                  (qual (slice u8))] (-> ImplSel)
  (let [r (primitive/alloc-stack ImplSel)
        bucket (impl-index-get (field cx inherent_name_idx) name)
        n
          (if (= (primitive/cast i64 bucket) (primitive/cast i64 0))
              0
              (al-len [i64] (.items bucket)))
        (mut i) 0]
    (set! (.ip r) (primitive/cast (ptr ImplDef) 0))
    (set! (.ambiguous r) false)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ip
                        (al-elem [ImplDef]
                                 (field cx impls)
                                 (al-get [i64] (.items bucket) (load i)))]
                  (when (and (impl-is-inherent ip)
                             (inherent-owner-matches? (load (field ip for_type)) qual))
                    (let [m (impl-find-method ip name)]
                      (when (and (!= (primitive/cast i64 m) (primitive/cast i64 0)) (not (inherent-receiver? a ip m)))
                        (if (= (primitive/cast i64 (load (field r ip))) (primitive/cast i64 0))
                            (store! (field r ip) ip)
                            (store! (field r ambiguous) true))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn inherent-has-name [(cx (ptr Cx)) (name (slice u8))] (-> bool)
  (!= (primitive/cast i64 (impl-index-get (field cx inherent_name_idx) name)) (primitive/cast i64 0)))

(defn cx-impl-select [(a (dyn Allocator)) (cx (ptr Cx)) (tr (slice u8)) (recv (ptr Type))] (-> ImplSel)
  (let [key (type-impl-name a recv)]
    (impl-select-indexed a
                         (field cx impls)
                         (impl-index-get (field cx trait_impl_idx) (impl-index-key a tr key))
                         tr
                         recv)))

(defn impl-match [(a (dyn Allocator)) (cx (ptr Cx)) (tr (slice u8)) (recv (ptr Type))] (-> bool)
  (let [s (primitive/alloc-stack ImplSel)]
    (set! s (cx-impl-select a cx tr recv))
    (!= (primitive/cast i64 (load (field s ip))) (primitive/cast i64 0))))

; ---- ownership type properties ---------------------------------------------
; These are deliberately semantic properties rather than representation guesses.
; A raw pointer/reference/view is Copy regardless of its pointee, while an aggregate
; is Copy only when explicitly implemented or every value it contains is Copy. Drop
; propagates through contained values. Recursive values necessarily cross a pointer,
; which stops the structural walk.
(defn ownership-bound-has [(cx (ptr Cx)) (t (ptr Type)) (tr (slice u8))] (-> bool)
  (match (load t)
    (TStruct [name] (bounds-has (field cx cur_bounds) name tr))
    (_ false)))

(defn ownership-field-list-all-copy [(a (dyn Allocator))
                                     (cx (ptr Cx))
                                     (fs (ptr (ArrayList Field)))] (-> bool)
  (let [n (al-len [Field] (load fs))
        (mut i) 0
        (mut yes) true]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (not (type-is-copy a cx (field (al-elem [Field] fs (load i)) ty)))
                  (store! yes false)
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (load yes)))

(defn ownership-field-list-needs-drop [(a (dyn Allocator))
                                       (cx (ptr Cx))
                                       (fs (ptr (ArrayList Field)))] (-> bool)
  (let [n (al-len [Field] (load fs))
        (mut i) 0
        (mut yes) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (type-needs-drop a cx (field (al-elem [Field] fs (load i)) ty))
                  (store! yes true)
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (load yes)))

(defn ownership-sum-all-copy [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (let [sv (primitive/alloc-stack SumVars)]
    (store! sv (sum-variants a t cx))
    (if (not (.found sv))
        false
        (let [vs (.variants sv)
              n (al-len [Variant] (load vs))
              (mut i) 0
              (mut yes) true]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (when (not (ownership-field-list-all-copy a cx (.fields (al-elem [Variant] vs (load i)))))
                        (store! yes false)
                        (break))
                      (store! i (primitive/iadd (load i) 1)))))
          (load yes)))))

(defn ownership-sum-needs-drop [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (let [sv (primitive/alloc-stack SumVars)]
    (store! sv (sum-variants a t cx))
    (if (not (.found sv))
        false
        (let [vs (.variants sv)
              n (al-len [Variant] (load vs))
              (mut i) 0
              (mut yes) false]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (when (ownership-field-list-needs-drop a cx (.fields (al-elem [Variant] vs (load i))))
                        (store! yes true)
                        (break))
                      (store! i (primitive/iadd (load i) 1)))))
          (load yes)))))

(defn ownership-struct-all-copy [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (match (struct-fields a t cx)
    (Ok [fs] (ownership-field-list-all-copy a cx fs))
    (Err [_] false)))

(defn ownership-struct-needs-drop [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (match (struct-fields a t cx)
    (Ok [fs] (ownership-field-list-needs-drop a cx fs))
    (Err [_] false)))

(defn type-is-copy [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (if (or (ownership-bound-has cx t "coil.core.Copy")
          (impl-match a cx "coil.core.Copy" t))
      true
      (match (load t)
        (TInt [_ _] true)
        (TFloat [_] true)
        (TBool [] true)
        (TPtr [_] true)
        (TRef [_ _] true)
        (TSlice [_] true)
        (TFn [_ _ _] true)
        (TVec [_ _] true)
        (TExternRef [] true)
        (TArray [elem _] (type-is-copy a cx elem))
        (TStruct [_]
                 (if (ownership-sum-all-copy a cx t)
                     true
                     (ownership-struct-all-copy a cx t)))
        (TApp [_ _]
              (if (ownership-sum-all-copy a cx t)
                  true
                  (ownership-struct-all-copy a cx t)))
        (_ false))))

(defn type-needs-drop [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (if (match (load t)
        (TApp [name _] (= name "coil.core.ManuallyDrop"))
        (_ false))
      false
      (if (or (ownership-bound-has cx t "coil.core.Drop")
              (impl-match a cx "coil.core.Drop" t))
          true
          (match (load t)
            (TArray [elem _] (type-needs-drop a cx elem))
            (TStruct [_]
                     (if (ownership-sum-needs-drop a cx t)
                         true
                         (ownership-struct-needs-drop a cx t)))
            (TApp [_ _]
                  (if (ownership-sum-needs-drop a cx t)
                      true
                      (ownership-struct-needs-drop a cx t)))
            (_ false)))))

(defn type-is-affine [(a (dyn Allocator)) (cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (or (type-needs-drop a cx t)
      (match (load t)
        ; An unconstrained generic is not implicitly copyable. Bounds can prove
        ; Copy, otherwise ownership is deferred until concrete substitution.
        (TStruct [name]
                 (and (= (primitive/cast i64 (struct-find cx name)) (primitive/cast i64 0))
                      (= (primitive/cast i64 (sum-find cx name)) (primitive/cast i64 0))
                      (not (ownership-bound-has cx t "coil.core.Copy"))))
        (TApp [name _] (= name "coil.core.ManuallyDrop"))
        (_ false))))

; Is an impl of `tr` with this exact pattern already registered? Two patterns are the
; same iff each matches the other (`(Pair A B)` and `(Pair X Y)` are the same impl
; modulo renaming, and must still collide).
(defn impl-dup? [(a (dyn Allocator))
                 (cx (ptr Cx))
                 (tr (slice u8))
                 (st (ptr Type))
                 (params (ptr (ArrayList (slice u8))))] (-> bool)
  (let [forty (type-impl-name a st)
        bucket (impl-index-get (field cx trait_impl_idx) (impl-index-key a tr forty))
        n (if (= (primitive/cast i64 bucket) (primitive/cast i64 0)) 0 (al-len [i64] (.items bucket)))
        (mut i) 0
        (mut f) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ip
                        (al-elem [ImplDef]
                                 (field cx impls)
                                 (al-get [i64] (.items bucket) (load i)))]
                  (when (and (pat-matches? a (field ip self_type) (load (field ip type_params)) st)
                             (pat-matches? a st params (field ip self_type)))
                    (store! f true)
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load f)))

(defn subst-apply-list [(a (dyn Allocator)) (v (ptr (ArrayList Type))) (subst (ptr (ArrayList SubstEntry)))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (al-new [Type] a)
        n (al-len [Type] (load v))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [rt (subst-apply a (al-elem [Type] v (load i)) subst)
                      rtp (box-type a rt)]
                  (if (pack-value? rtp)
                      (let [items (t-fn-params rtp)
                            nn (al-len [Type] (load items))
                            (mut j) 0]
                        (loop (if (>= (load j) nn)
                                  (break)
                                  (do
                                    (al-push! (mut out) (al-get [Type] (load items) (load j)))
                                    (set! j (primitive/iadd (load j) 1))))))
                      (al-push! (mut out) rt)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn subst-apply [(a (dyn Allocator)) (t (ptr Type)) (subst (ptr (ArrayList SubstEntry)))] (-> Type)
  (match (load t)
    (TPtr [p] (TPtr (box-type a (subst-apply a p subst))))
    (TRef [m p] (TRef m (box-type a (subst-apply a p subst))))
    (TArray [e k] (TArray (box-type a (subst-apply a e subst)) k))
    (TSlice [e] (TSlice (box-type a (subst-apply a e subst))))
    (TVec [e k] (TVec (box-type a (subst-apply a e subst)) k))
    (TStruct [n]
             (let [r (subst-get subst n)] (if (= (primitive/cast i64 r) (primitive/cast i64 0)) (TStruct n) (load r))))
    (TApp [n args]
          (if (= n "$pack-var")
              (let [r (subst-get subst (type-struct-name (al-elem [Type] args 0)))]
                (if (= (primitive/cast i64 r) (primitive/cast i64 0)) (TApp n args) (load r)))
              (TApp n (subst-apply-list a args subst))))
    (TFn [cc ps r]
         (TFn
           :cc cc
           :params (subst-apply-list a ps subst)
           :ret (box-type a (subst-apply a r subst))))
    (_ (load t))))

(defn fields-subst [(a (dyn Allocator)) (si (ptr StructInfo)) (args (ptr (ArrayList Type)))] (-> (ptr (ArrayList Field)))
  (let [subst (subst-new a)
        tparams (load (field si type_params))
        np (al-len [(slice u8)] (load tparams))
        (mut i) 0]
    (loop (if (>= (load i) np)
              (break)
              (do
                (subst-insert! subst (al-get [(slice u8)] (load tparams) (load i)) (al-elem [Type] args (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (let [fs (load (field si fields))
          nf (al-len [Field] (load fs))
          (mut out) (al-new [Field] a)
          (mut j) 0]
      (loop (if (>= (load j) nf)
                (break)
                (do
                  (let [fp (al-elem [Field] fs (load j))
                        nf2 (primitive/alloc-stack Field)]
                    (set! (.name nf2) (.name fp))
                    (set! (.ty nf2) (subst-apply a (field fp ty) subst))
                    (al-push! (mut out) (load nf2)))
                  (set! j (primitive/iadd (load j) 1)))))
      (box-al [Field] a (load out)))))

(defn struct-fields [(a (dyn Allocator)) (t (ptr Type)) (cx (ptr Cx))] (-> (Result (ptr (ArrayList Field)) Diag))
  (let [tg (type-tag t)]
    (if (= tg (primitive/cast i64 6))
        (let [si (struct-find cx (type-struct-name t))]
          (if (= (primitive/cast i64 si) (primitive/cast i64 0))
              (Err [(ptr (ArrayList Field)) Diag] (derr (sconcat3 a "unknown struct '" (type-struct-name t) "'")))
              (Ok (load (field si fields)))))
        (if (= tg (primitive/cast i64 11))
            (let [si (struct-find cx (t-app-name t))]
              (if (= (primitive/cast i64 si) (primitive/cast i64 0))
                  (Err [(ptr (ArrayList Field)) Diag] (derr (sconcat3 a "unknown generic struct '" (t-app-name t) "'")))
                  (Ok (fields-subst a si (t-fn-params t)))))
            (Err [(ptr (ArrayList Field)) Diag] (derr (sconcat a "not a struct: " (ty-str a t))))))))

(defn mk-sumvars [(found bool) (name (slice u8)) (variants (ptr (ArrayList Variant)))] (-> SumVars)
  (let [p (primitive/alloc-stack SumVars)]
    (set! (.found p) found)
    (set! (.name p) name)
    (set! (.variants p) variants)
    (load p)))

(defn variants-subst [(a (dyn Allocator)) (si (ptr SumInfo)) (args (ptr (ArrayList Type)))] (-> (ptr (ArrayList Variant)))
  (let [subst (subst-new a)
        tparams (load (field si type_params))
        np (al-len [(slice u8)] (load tparams))
        (mut i) 0]
    (loop (if (>= (load i) np)
              (break)
              (do
                (subst-insert! subst (al-get [(slice u8)] (load tparams) (load i)) (al-elem [Type] args (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (let [vs (load (field si variants))
          nv (al-len [Variant] (load vs))
          (mut out) (al-new [Variant] a)
          (mut j) 0]
      (loop (if (>= (load j) nv)
                (break)
                (do
                  (let [vp (al-elem [Variant] vs (load j))
                        fs (load (field vp fields))
                        nf (al-len [Field] (load fs))
                        (mut fout) (al-new [Field] a)
                        (mut k) 0
                        nv2 (primitive/alloc-stack Variant)]
                    (loop (if (>= (load k) nf)
                              (break)
                              (do
                                (let [fp (al-elem [Field] fs (load k))
                                      nf2 (primitive/alloc-stack Field)]
                                  (set! (.name nf2) (.name fp))
                                  (set! (.ty nf2) (subst-apply a (field fp ty) subst))
                                  (al-push! (mut fout) (load nf2)))
                                (set! k (primitive/iadd (load k) 1)))))
                    (set! (.name nv2) (.name vp))
                    (set! (.fields nv2) (box-al [Field] a (load fout)))
                    (al-push! (mut out) (load nv2)))
                  (set! j (primitive/iadd (load j) 1)))))
      (box-al [Variant] a (load out)))))

(defn sum-variants [(a (dyn Allocator)) (t (ptr Type)) (cx (ptr Cx))] (-> SumVars)
  (let [tg (type-tag t)]
    (if (= tg (primitive/cast i64 6))
        (let [si (sum-find cx (type-struct-name t))]
          (if (= (primitive/cast i64 si) (primitive/cast i64 0))
              (mk-sumvars false "" (primitive/cast (ptr (ArrayList Variant)) 0))
              (mk-sumvars true (type-struct-name t) (load (field si variants)))))
        (if (= tg (primitive/cast i64 11))
            (let [si (sum-find cx (t-app-name t))]
              (if (= (primitive/cast i64 si) (primitive/cast i64 0))
                  (mk-sumvars false "" (primitive/cast (ptr (ArrayList Variant)) 0))
                  (mk-sumvars true (t-app-name t) (variants-subst a si (t-fn-params t)))))
            (mk-sumvars false "" (primitive/cast (ptr (ArrayList Variant)) 0))))))

(defn expected-sum-targs [(a (dyn Allocator)) (expected (ptr Type)) (sumname (slice u8)) (arity i64)] (-> TargsOpt)
  (let [p (primitive/alloc-stack TargsOpt)
        tg (type-tag expected)]
    (set! (.found p) false)
    (set! (.targs p) (primitive/cast (ptr (ArrayList Type)) 0))
    (if (= tg (primitive/cast i64 11))
        (when (and (= (t-app-name expected) sumname) (= (al-len [Type] (load (t-fn-params expected))) arity))
          (store! (field p found) true)
          (store! (field p targs) (t-fn-params expected))
          0)
        (when (and (= tg (primitive/cast i64 6))
                   (and (= (type-struct-name expected) sumname) (= arity (primitive/cast i64 0))))
          (store! (field p found) true)
          (store! (field p targs) (box-items-type a))
          0))
    (load p)))

(defn mismatch-msg [(a (dyn Allocator)) (x (ptr Type)) (y (ptr Type)) (fname (slice u8)) (what (slice u8))] (-> Diag)
  (if (and (type-is-int x) (type-is-int y))
      (if (not (= (t-int-bits x) (t-int-bits y)))
          (derr (sconcat a
                         (sconcat a
                                  (sconcat a (sconcat3 a "in '" fname "': ") (sconcat a what " on mixed widths ("))
                                  (i64->str a (t-int-bits x)))
                         (sconcat a " and " (sconcat a (i64->str a (t-int-bits y)) " bits)"))))
          (derr (sconcat a
                         (sconcat a
                                  (sconcat a (sconcat3 a "in '" fname "': ") (sconcat a what " on mixed signedness ("))
                                  (ty-str a x))
                         (sconcat a " and " (sconcat a (ty-str a y) ")")))))
      (derr (sconcat a
                     (sconcat a
                              (sconcat a (sconcat3 a "in '" fname "': ") (sconcat a what " on different types ("))
                              (ty-str a x))
                     (sconcat a " vs " (sconcat a (ty-str a y) ")"))))))

; unify_branches: fill `out` with coerced exprs, return target type.
(defn unify-branches [(a (dyn Allocator))
                      (branches (ptr (ArrayList Branch)))
                      (out (ptr (ArrayList Expr)))
                      (fname (slice u8))
                      (what (slice u8))] (-> (Result Type Diag))
  (let [n (al-len [Branch] (load branches))
        (mut i) 0
        (mut have) false
        (mut concrete) (primitive/cast (ptr Type) 0)
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [bp (al-elem [Branch] branches (load i))
                      be (load (field bp e))
                      bt (load (field bp t))]
                  (when (and (not (is-literal be)) (not (type-is-never bt)))
                    (if (not (load have))
                        (do (store! have true) (store! concrete bt) 0)
                        (when (not (type-eq (load concrete) bt))
                          (store! err (mismatch-msg a (load concrete) bt fname what))
                          (store! failed true)
                          (break)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [Type Diag] (load err))
        (let [(mut target) (primitive/cast (ptr Type) 0)]
          (if (load have)
              (do (set! target (load concrete)) 0)
              (let [(mut j) 0
                    (mut done) false]
                (loop (if (or (load done) (>= (load j) n))
                          (break)
                          (do
                            (let [bp (al-elem [Branch] branches (load j))]
                              (when (not (type-is-never (load (field bp t))))
                                (store! target (load (field bp t)))
                                (store! done true)
                                0))
                            (set! j (primitive/iadd (load j) 1)))))
                (when (not (load done)) (store! target (box-type a (TInt 64 true))) 0)))
          (let [(mut k) 0
                (mut err2) (primitive/zeroed Diag)
                (mut failed2) false]
            (loop (if (>= (load k) n)
                      (break)
                      (do
                        (let [bp (al-elem [Branch] branches (load k))
                              be (load (field bp e))
                              bt (load (field bp t))]
                          (if (or (type-eq bt (load target)) (type-is-never bt))
                              (al-push! [Expr] out (load be))
                              (if (and (same-number-kind bt (load target)) (is-literal be))
                                  (match (coerce-lit a (load be) (load target) fname)
                                    (Err [d] (do (set! err2 d) (set! failed2 true) (break)))
                                    (Ok [ce] (al-push! [Expr] out ce)))
                                  (do
                                    (set! err2 (mismatch-msg a bt (load target) fname what))
                                    (set! failed2 true)
                                    (break)))))
                        (set! k (primitive/iadd (load k) 1)))))
            (if (load failed2) (Err [Type Diag] (load err2)) (Ok (load (load target)))))))))

; coerce_arg
; The offending argument's own span, so an argument-type error underlines the
; argument (`"hello"`) not the whole call. dwspan only fills an unset (lo<0)
; span, so once attached here the enclosing call's synth won't overwrite it.
(defn coerce-arg-inner [(a (dyn Allocator))
                        (is_mut_borrow bool)
                        (ae Expr)
                        (at (ptr Type))
                        (want (ptr Type))
                        (is_extern bool)
                        (fname (slice u8))
                        (what (slice u8))] (-> (Result Expr Diag))
  (let [aep (primitive/alloc-stack Expr)]
    (set! aep ae)
    (let [wtg (type-tag want)]
      (cond (= wtg (primitive/cast i64 5))
              (let [wp (t-inner want)
                    want_mut (t-ref-mut want)
                    ap (place-pointee at)]
                (cond (= (primitive/cast i64 ap) (primitive/cast i64 0))
                        (if want_mut
                            (Err [Expr Diag]
                                 (derr (sconcat a
                                                (sconcat a
                                                         (sconcat3 a "in '" fname "': ")
                                                         (sconcat a what " is a (mut "))
                                                (sconcat a
                                                         (ty-str a wp)
                                                         ") parameter; pass a mutable place as (mut …)"))))
                            (if (not (type-eq at wp))
                                (Err [Expr Diag]
                                     (derr (sconcat a
                                                    (sconcat a
                                                             (sconcat a
                                                                      (sconcat3 a "in '" fname "': ")
                                                                      (sconcat a what " expects a reference to "))
                                                             (ty-str a wp))
                                                    (sconcat a ", got " (ty-str a at)))))
                                (Ok (mk-expr (ESpillRef (box-expr a (load aep)))
                                             (load (field aep lo))
                                             (load (field aep hi))
                                             (load (field aep source))
                                             (load (field aep ctxt))))))
                      (not (type-eq ap wp))
                        (Err [Expr Diag]
                             (derr (sconcat a
                                            (sconcat a
                                                     (sconcat a
                                                              (sconcat3 a "in '" fname "': ")
                                                              (sconcat a what " has type "))
                                                     (ty-str a at))
                                            (sconcat a " but expected a reference to " (ty-str a wp)))))
                      want_mut
                        (let [explicitly_mut (or is_mut_borrow (type-is-ptr at))]
                          (if (not explicitly_mut)
                              (Err [Expr Diag]
                                   (derr (sconcat a
                                                  (sconcat a
                                                           (sconcat3 a "in '" fname "': ")
                                                           (sconcat a what " is a (mut "))
                                                  (sconcat a
                                                           (ty-str a wp)
                                                           ") parameter; pass a mutable place as (mut …)"))))
                              (if (not (is-writable at))
                                  (Err [Expr Diag]
                                       (derr (sconcat a
                                                      (sconcat3 a "in '" fname "': ")
                                                      (sconcat a what " cannot be mutably borrowed (it is immutable)"))))
                                  (Ok (load aep)))))
                      :else (Ok (load aep))))
            (= wtg (primitive/cast i64 6))
              (if (type-eq at want)
                  (Ok (load aep))
                  (if is_extern
                      (let [pp (place-pointee at)]
                        (if (and (!= (primitive/cast i64 pp) (primitive/cast i64 0))
                                 (= (struct-name pp)
                                    (type-struct-name want)))
                            (Ok (load aep))
                            (coerce a (load aep) at want is_extern fname what)))
                      (coerce a (load aep) at want is_extern fname what)))
            (= wtg (primitive/cast i64 4))
              (let [wp (t-inner want)
                    pp (place-pointee at)]
                (if (and (!= (primitive/cast i64 pp) (primitive/cast i64 0)) (and (type-eq pp wp) (is-writable at)))
                    (Ok (load aep))
                    (coerce a (load aep) at want is_extern fname what)))
            :else (coerce a (load aep) at want is_extern fname what)))))

(defn coerce-arg [(a (dyn Allocator))
                  (is_mut_borrow bool)
                  (ae Expr)
                  (at (ptr Type))
                  (want (ptr Type))
                  (is_extern bool)
                  (fname (slice u8))
                  (what (slice u8))] (-> (Result Expr Diag))
  (let [aep (primitive/alloc-stack Expr)]
    (set! aep ae)
    (match (coerce-arg-inner a is_mut_borrow ae at want is_extern fname what)
      (Ok [e] (Ok [Expr Diag] e))
      (Err [d]
           (Err [Expr Diag]
                (dwspan d
                        (.source aep)
                        (.lo aep)
                        (.hi aep)
                        (.ctxt aep)))))))

(defn check-to [(a (dyn Allocator))
                (e (ptr Expr))
                (want (ptr Type))
                (env (ptr (ArrayList EnvEntry)))
                (cx (ptr Cx))
                (tps (ptr (ArrayList (slice u8))))
                (fname (slice u8))
                (what (slice u8))] (-> (Result Expr Diag))
  (match (do-synth a e want env cx tps fname)
    (Err [d] (Err [Expr Diag] d))
    (Ok [sp0]
        (let [sp (primitive/alloc-stack SynPair)]
          (set! sp sp0)
          (coerce a (load (load (field sp e))) (load (field sp t)) want false fname what)))))

; unify
(defn unify [(a (dyn Allocator))
             (decl (ptr Type))
             (actual (ptr Type))
             (tpset (ptr (ArrayList (slice u8))))
             (subst (ptr (ArrayList SubstEntry)))
             (fname (slice u8))] (-> (Result i64 Diag))
  (if (and (type-is-void decl) (type-is-void actual))
      (Ok [i64 Diag] 0)
      (if (or (type-is-void decl) (type-is-void actual))
          (Err [i64 Diag]
               (derr (sconcat3 a
                               "in '"
                               fname
                               "': a void value cannot be used as a type argument (a (-> void) call yields nothing)")))
          (if (and (= (type-tag decl) (primitive/cast i64 6)) (set-contains tpset (type-struct-name decl)))
              (let [p (type-struct-name decl)
                    act (if (= (type-tag actual) (primitive/cast i64 5)) (t-inner actual) actual)
                    prev (subst-get subst p)]
                (if (!= (primitive/cast i64 prev) (primitive/cast i64 0))
                    (if (not (type-eq prev act))
                        (Err [i64 Diag]
                             (derr (sconcat a
                                            (sconcat a
                                                     (sconcat a
                                                              (sconcat4 a
                                                                        "in '"
                                                                        fname
                                                                        "': conflicting types for parameter '"
                                                                        (sconcat a p "' ("))
                                                              (ty-str a prev))
                                                     " vs ")
                                            (sconcat a (ty-str a act) ")"))))
                        (Ok [i64 Diag] 0))
                    (do (subst-insert! subst p act) (Ok [i64 Diag] 0))))
              (let [dt (type-tag decl)
                    at2 (type-tag actual)]
                (cond (and (= dt (primitive/cast i64 4)) (= at2 (primitive/cast i64 4)))
                        (unify a (t-inner decl) (t-inner actual) tpset subst fname)
                      ; a (ptr T) argument satisfies a (mut T)/(ref T) parameter — see through
                      ; BOTH wrappers; a BARE type-parameter pointee keeps the
                      ; general Ref-arm reading below (T := the whole pointer)
                      (and (and (= dt (primitive/cast i64 5)) (= at2 (primitive/cast i64 4)))
                           (not (and (= (type-tag (t-inner decl)) (primitive/cast i64 6))
                                     (set-contains tpset (type-struct-name (t-inner decl))))))
                        (unify a (t-inner decl) (t-inner actual) tpset subst fname)
                      (= dt (primitive/cast i64 5)) (unify a (t-inner decl) actual tpset subst fname)
                      (= at2 (primitive/cast i64 5)) (unify a decl (t-inner actual) tpset subst fname)
                      (and (= dt (primitive/cast i64 7)) (= at2 (primitive/cast i64 7)))
                        (unify a (t-inner decl) (t-inner actual) tpset subst fname)
                      ; TVec(9), same as the array arm above. Absent until structural impls made
                      ; `(impl [T] Trait (vec T N))` expressible: nothing had ever been generic over
                      ; a vector, so `(vec T 4)` vs `(vec i64 4)` fell through and T went unsolved.
                      (and (= dt (primitive/cast i64 9)) (= at2 (primitive/cast i64 9)))
                        (unify a (t-inner decl) (t-inner actual) tpset subst fname)
                      (and (= dt (primitive/cast i64 8)) (= at2 (primitive/cast i64 8)))
                        (unify a (t-inner decl) (t-inner actual) tpset subst fname)
                      (and (and (= dt (primitive/cast i64 11)) (= at2 (primitive/cast i64 11)))
                           (and (= (t-app-name decl) (t-app-name actual))
                                (= (al-len [Type] (load (t-fn-params decl)))
                                   (al-len [Type] (load (t-fn-params actual))))))
                        (unify-list a (t-fn-params decl) (t-fn-params actual) tpset subst fname)
                      (and (and (= dt (primitive/cast i64 10)) (= at2 (primitive/cast i64 10)))
                           (let [dp (t-fn-params decl)
                                 ap (t-fn-params actual)]
                             (if (>= (list-pack-index dp) 0)
                                 (>= (al-len [Type] (load ap)) (primitive/isub (al-len [Type] (load dp)) 1))
                                 (= (al-len [Type] (load dp)) (al-len [Type] (load ap))))))
                        (match (unify-list a
                                           (t-fn-params decl)
                                           (t-fn-params actual)
                                           tpset
                                           subst
                                           fname)
                          (Err [d] (Err [i64 Diag] d))
                          (Ok [_] (unify a (t-fn-ret decl) (t-fn-ret actual) tpset subst fname)))
                      :else (Ok [i64 Diag] 0)))))))

(defn unify-list [(a (dyn Allocator))
                  (xs (ptr (ArrayList Type)))
                  (ys (ptr (ArrayList Type)))
                  (tpset (ptr (ArrayList (slice u8))))
                  (subst (ptr (ArrayList SubstEntry)))
                  (fname (slice u8))] (-> (Result i64 Diag))
  (let [n (al-len [Type] (load xs))
        ny (al-len [Type] (load ys))
        pi (list-pack-index xs)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (when (>= pi 0)
      (let [tail (primitive/isub n (primitive/iadd pi 1))]
        (if (< ny (primitive/isub n 1))
            (do
              (store! err (derr (sconcat3 a "in '" fname "': not enough arguments for parameter pack")))
              (store! failed true))
            (let [count (primitive/isub ny (primitive/iadd pi tail))
                  pn (pack-var-name (al-elem [Type] xs pi))
                  packed (make-pack a ys pi (primitive/iadd pi count))
                  prev (subst-get subst pn)]
              (if (= (primitive/cast i64 prev) (primitive/cast i64 0))
                  (subst-insert! subst pn (box-type a packed))
                  (when (not (type-eq prev (box-type a packed)))
                    (store! err (derr (sconcat3 a "in '" fname "': conflicting types for parameter pack")))
                    (store! failed true)))
              (store! i 0)
              (loop (if (or (load failed) (>= (load i) pi))
                        (break)
                        (do
                          (match (unify a (al-elem [Type] xs (load i)) (al-elem [Type] ys (load i)) tpset subst fname)
                            (Err [d] (do (store! err d) (store! failed true)))
                            (Ok [_] 0))
                          (store! i (primitive/iadd (load i) 1)))))
              (store! i 0)
              (loop (if (or (load failed) (>= (load i) tail))
                        (break)
                        (do
                          (match (unify a
                                        (al-elem [Type] xs (primitive/iadd (primitive/iadd pi 1) (load i)))
                                        (al-elem [Type] ys (primitive/iadd (primitive/iadd pi count) (load i)))
                                        tpset
                                        subst
                                        fname)
                            (Err [d] (do (store! err d) (store! failed true)))
                            (Ok [_] 0))
                          (store! i (primitive/iadd (load i) 1)))))))))
    (when (>= pi 0) (store! i n))
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (unify a (al-elem [Type] xs (load i)) (al-elem [Type] ys (load i)) tpset subst fname)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

; solve_type_args
(defn solve-type-args [(a (dyn Allocator))
                       (type_params (ptr (ArrayList (slice u8))))
                       (declared (ptr (ArrayList Type)))
                       (type_args (ptr (ArrayList Type)))
                       (arglist (ptr (ArrayList ArgSlot)))
                       (ret_tmpl (ptr Type))
                       (expected (ptr Type))
                       (cx (ptr Cx))
                       (tps (ptr (ArrayList (slice u8))))
                       (fname (slice u8))
                       (what (slice u8))] (-> (Result (ptr (ArrayList SubstEntry)) Diag))
  (let [subst (subst-new a)
        np (al-len [(slice u8)] (load type_params))]
    (if (> (al-len [Type] (load type_args)) (primitive/cast i64 0))
        (if (not (= (al-len [Type] (load type_args)) np))
            (Err [(ptr (ArrayList SubstEntry)) Diag]
                 (derr (sconcat a
                                (sconcat a
                                         (sconcat a
                                                  (sconcat4 a "in '" fname "': '" (sconcat a what "' expects "))
                                                  (i64->str a np))
                                         " type arguments, got ")
                                (i64->str a (al-len [Type] (load type_args))))))
            (let [(mut i) 0
                  (mut err) (primitive/zeroed Diag)
                  (mut failed) false]
              (loop (if (>= (load i) np)
                        (break)
                        (do
                          (match (validate-type (al-elem [Type] type_args (load i)) cx tps)
                            (Err [d]
                                 (do
                                   (set! err (prefix-diag a d (sconcat3 a "in '" fname "': type argument: ")))
                                   (set! failed true)
                                   (break)))
                            (Ok [_] 0))
                          (subst-insert! subst
                                         (al-get [(slice u8)] (load type_params) (load i))
                                         (al-elem [Type] type_args (load i)))
                          (set! i (primitive/iadd (load i) 1)))))
              (if (load failed) (Err [(ptr (ArrayList SubstEntry)) Diag] (load err)) (Ok subst))))
        (let [(mut err) (primitive/zeroed Diag)
              (mut failed) false]
          (when (expected-some? expected)
            (match (unify a ret_tmpl expected type_params subst fname)
              (Err [d] (do (store! err d) (store! failed true) 0))
              (Ok [_] 0)))
          (if (load failed)
              (Err [(ptr (ArrayList SubstEntry)) Diag] (load err))
              (let [nd (al-len [Type] (load declared))
                    na (al-len [ArgSlot] (load arglist))
                    (mut actuals) (al-new [Type] a)
                    (mut j) 0]
                (loop (if (>= (load j) na)
                          (break)
                          (do
                            (let [slot (al-elem [ArgSlot] arglist (load j))]
                              (when (load (field slot present))
                                (al-push! (mut actuals) (load (load (field slot t))))))
                            (set! j (primitive/iadd (load j) 1)))))
                (when (= (al-len [Type] (load actuals)) na)
                  (match (unify-list a declared (box-al [Type] a (load actuals)) type_params subst fname)
                    (Err [d] (do (store! err d) (store! failed true)))
                    (Ok [_] 0)))
                (if (load failed)
                    (Err [(ptr (ArrayList SubstEntry)) Diag] (load err))
                    (let [(mut k) 0
                          (mut missing) false
                          (mut mp) ""]
                      (loop (if (>= (load k) np)
                                (break)
                                (do
                                  (let [pn (al-get [(slice u8)] (load type_params) (load k))]
                                    (when (not (subst-has subst pn)) (store! missing true) (store! mp pn) (break)))
                                  (set! k (primitive/iadd (load k) 1)))))
                      (if (load missing)
                          (Err [(ptr (ArrayList SubstEntry)) Diag]
                               (derr (sconcat a
                                              (sconcat a
                                                       (sconcat4 a
                                                                 "in '"
                                                                 fname
                                                                 "': cannot infer type argument '"
                                                                 (sconcat a (load mp) "' for '"))
                                                       (sconcat a what "'; provide it explicitly: ("))
                                              (sconcat a what " [<types>] ...)"))))
                          (Ok subst))))))))))

; bit_field_type
(defn bit-field-type [(a (dyn Allocator))
                      (ptr (ptr Expr))
                      (field (slice u8))
                      (env (ptr (ArrayList EnvEntry)))
                      (cx (ptr Cx))
                      (tps (ptr (ArrayList (slice u8))))
                      (fname (slice u8))] (-> (Result SynPair Diag))
  (match (do-synth a ptr (null-type) env cx tps fname)
    (Err [d] (Err [SynPair Diag] d))
    (Ok [sp0]
        (let [sp (primitive/alloc-stack SynPair)]
          (set! sp sp0)
          (let [pt (load (field sp t))]
            (if (not (type-is-ptr pt))
                (Err [SynPair Diag]
                     (derr (sconcat a (sconcat3 a "in '" fname "': get/set! needs a pointer, got ") (ty-str a pt))))
                (let [pointee (t-inner pt)
                      s (struct-name pointee)
                      si (struct-find cx s)]
                  (if (and (is-struct-or-app pointee)
                           (and (!= (primitive/cast i64 si) (primitive/cast i64 0))
                                (.is_bits si)))
                      (try (let [fs
                                   (try-or! (struct-fields a pointee cx)
                                            (Err [SynPair Diag]
                                                 (derr (sconcat a
                                                                (sconcat a
                                                                         (sconcat5 a
                                                                                   "in '"
                                                                                   fname
                                                                                   "': bit struct '"
                                                                                   s
                                                                                   "' has no field '")
                                                                         field)
                                                                "'"))))]
                             (let [n (al-len [Field] (load fs))
                                   (mut i) 0
                                   (mut fty) (primitive/cast (ptr Type) 0)]
                               (loop (if (>= (load i) n)
                                         (break)
                                         (do
                                           (when (= (load (field (al-elem [Field] fs (load i)) name)) field)
                                             (store! fty (field (al-elem [Field] fs (load i)) ty))
                                             (break))
                                           (store! i (primitive/iadd (load i) 1)))))
                               (if (= (primitive/cast i64 (load fty)) (primitive/cast i64 0))
                                   (Err [SynPair Diag]
                                        (derr (sconcat a
                                                       (sconcat a
                                                                (sconcat5 a
                                                                          "in '"
                                                                          fname
                                                                          "': bit struct '"
                                                                          s
                                                                          "' has no field '")
                                                                field)
                                                       "'")))
                                   (Ok (mk-synpair a (load (field sp e)) (load fty)))))))
                      (Err [SynPair Diag]
                           (derr (sconcat a
                                          (sconcat a
                                                   (sconcat3 a
                                                             "in '"
                                                             fname
                                                             "': get/set! needs a pointer to a :layout bits struct, got (ptr ")
                                                   (ty-str a pointee))
                                          ")")))))))))))

; check_quasi
(defn check-quasi [(a (dyn Allocator))
                   (qp (ptr Quasi))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))] (-> (Result Quasi Diag))
  (match (load qp)
    (QLit [form] (Ok [Quasi Diag] (QLit form)))
    (QUnquote [e]
              (match (do-synth a e (null-type) env cx tps fname)
                (Err [d] (Err [Quasi Diag] d))
                (Ok [sp0]
                    (let [sp (primitive/alloc-stack SynPair)]
                      (set! sp sp0)
                      (Ok (QUnquote (load (field sp
                                                 e))))))))
    (QSplice [e]
             (match (do-synth a e (null-type) env cx tps fname)
               (Err [d] (Err [Quasi Diag] d))
               (Ok [sp0]
                   (let [sp (primitive/alloc-stack SynPair)]
                     (set! sp sp0)
                     (Ok (QSplice (load (field sp
                                               e))))))))
    (QList [items]
           (match (check-quasi-list a items env cx tps fname)
             (Err [d] (Err [Quasi Diag] d))
             (Ok [nl] (Ok (QList nl)))))
    (QVector [items]
             (match (check-quasi-list a items env cx tps fname)
               (Err [d] (Err [Quasi Diag] d))
               (Ok [nl] (Ok (QVector nl)))))
    (_ (Ok [Quasi Diag] (load qp)))))

(defn check-quasi-list [(a (dyn Allocator))
                        (items (ptr (ArrayList Quasi)))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))] (-> (Result (ptr (ArrayList Quasi)) Diag))
  (let [n (al-len [Quasi] (load items))
        (mut out) (al-new [Quasi] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (check-quasi a (al-elem [Quasi] items (load i)) env cx tps fname)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [q] (al-push! (mut out) q)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Quasi)) Diag] (load err)) (Ok (box-al [Quasi] a (load out))))))

; ---- dyn / trait helpers ----------------------------------------------------
(defn dyn-struct-trait [(cx (ptr Cx)) (name (slice u8))] (-> (slice u8))
  (let [n (slice-len [u8] name)]
    (if (< n (primitive/cast i64 4))
        ""
        (let [base (subslice [u8] name 0 (primitive/isub n 4))
              suf (subslice [u8] name (primitive/isub n 4) n)]
          (if (and (= suf "-dyn") (!= (primitive/cast i64 (trait-find cx base)) (primitive/cast i64 0))) base "")))))

(defn is-dyn-target [(t (ptr Type)) (cx (ptr Cx))] (-> bool)
  (let [tg (type-tag t)]
    (if (= tg (primitive/cast i64 6))
        (> (slice-len [u8] (dyn-struct-trait cx (type-struct-name t))) (primitive/cast i64 0))
        (if (= tg (primitive/cast i64 5))
            (let [inner (t-inner t)]
              (if (= (type-tag inner) (primitive/cast i64 6))
                  (> (slice-len [u8] (dyn-struct-trait cx (type-struct-name inner))) (primitive/cast i64 0))
                  false))
            false))))

(defn resolve-trait-name [(cx (ptr Cx)) (name (slice u8))] (-> (slice u8))
  (if (!= (primitive/cast i64 (trait-find cx name)) (primitive/cast i64 0))
      name
      (let [n (al-len [TraitDef] (.trait_defs cx))
            (mut i) 0
            (mut found) ""
            (mut cnt) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [k (.name (al-elem [TraitDef] (field cx trait_defs) (load i)))]
                      (when (= (after-last-dot k) name) (store! found k) (store! cnt (primitive/iadd (load cnt) 1))))
                    (set! i (primitive/iadd (load i) 1)))))
        (if (= (load cnt) (primitive/cast i64 1)) (load found) ""))))

; Has the CALLER explicitly taken this trait method out of scope?
;
; Deliberately NOT the same question as `trait-visible` below, which only breaks ties
; between several traits declaring one method name. A method whose declaring trait is
; unique is callable today with no import at all, so the ABSENCE of an import cannot
; suppress it — only a deliberate statement can:
;
;   * `:exclude`/`:rename` naming the trait or the method, on any import; or
;   * an explicit `(import "coil.core" …)`, which states core's refer set in full and is
;     therefore authoritative — `:use [Eq]` really does mean "no Ord".
;
; This is the surface that makes `:exclude [<]` bite. Hiding the NAME in the resolver
; while leaving the trait method callable would be worse than not having the feature.
(defn method-suppressed? [(cx (ptr Cx))
                          (tr (slice u8))
                          (method (slice u8))
                          (caller (slice u8))
                          (has_caller bool)] (-> bool)
  (if (or (not has_caller) (not (has-dot tr)))
      false
      (let [tmod (subslice [u8] tr 0 (find-slash-dot tr))
            tname (after-last-dot tr)
            imp (imports-find (load (field cx imports)) caller)]
        (if (= tmod (implicit-prelude-name (load (field cx a))))
            (if (or (core-drops? imp tname) (core-drops? imp method))
                true
                ; an explicit core import grants only what it names — referring the
                ; TRAIT brings its methods, and referring a method brings that one.
                (and (core-explicit? imp)
                     (and (opt-str-none? (core-refers imp tname))
                          (opt-str-none? (core-refers imp method)))))
            (let [up (use-for-target imp tmod)]
              (if (= (primitive/cast i64 up) (primitive/cast i64 0))
                  false
                  (or (use-drops? up tname) (use-drops? up method))))))))

(defn opt-str-none? [(o (Option (slice u8)))] (-> bool)
  (match o (Some [_] false) (None [] true)))

; Was ANY trait declaring `func` dropped by this module's imports? Distinguishes
; "you excluded this" from "no trait in scope declares it", which need different advice.
(defn method-any-suppressed? [(cx (ptr Cx))
                              (func (slice u8))
                              (caller (slice u8))
                              (has_caller bool)] (-> bool)
  (let [ms (field cx methods)
        n (al-len [MethodEntry] (.methods cx))
        (mut i) 0
        (mut r) false]
    (loop (if (or (load r) (>= (load i) n))
              (break)
              (do
                (let [me (al-elem [MethodEntry] ms (load i))]
                  (when (and (= (load (field me name)) func)
                             (method-suppressed? cx (load (field me trait)) func caller has_caller))
                    (store! r true)
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; The module whose import dropped it, for the message ("coil.core" for the prelude).
(defn method-suppressor [(a (dyn Allocator))
                         (cx (ptr Cx))
                         (func (slice u8))
                         (caller (slice u8))
                         (has_caller bool)] (-> (slice u8))
  (let [ms (field cx methods)
        n (al-len [MethodEntry] (.methods cx))
        (mut i) 0
        (mut r) "it"]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [me (al-elem [MethodEntry] ms (load i))
                      tr (.trait me)]
                  (when (and (= (load (field me name)) func)
                             (method-suppressed? cx tr func caller has_caller))
                    (store! r (sconcat3 a "'" (subslice [u8] tr 0 (find-slash-dot tr)) "'"))
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn trait-visible [(cx (ptr Cx)) (tr (slice u8)) (caller (slice u8)) (has_caller bool)] (-> bool)
  (if (not (has-dot tr))
      true
      (let [tmod (subslice [u8] tr 0 (find-slash-dot tr))
            tname (after-last-dot tr)]
        (if (or (= tmod (implicit-prelude-name (load (field cx a))))
                (and has_caller (= tmod caller)))
            true
            (if (not has_caller)
                false
                (let [imp (imports-find (load (field cx imports)) caller)]
                  (if (= (primitive/cast i64 imp) (primitive/cast i64 0))
                      false
                      (let [uses (field (field imp imp) uses)
                            nu (al-len [Use] (.uses (.imp imp)))
                            (mut i) 0
                            (mut vis) false]
                        (loop (if (>= (load i) nu)
                                  (break)
                                  (do
                                    (let [up (al-elem [Use] uses (load i))]
                                      (when (= (load (field up target)) tmod)
                                        (let [okspec
                                                (match (load (field up spec))
                                                  (UAll [] true)
                                                  (UNames [ns] (set-contains ns tname))
                                                  (_ false))]
                                          (when (and okspec (exports-check (load (field cx exports)) tmod tname))
                                            (store! vis true)
                                            (break)))))
                                    (set! i (primitive/iadd (load i) 1)))))
                        (load vis)))))))))

(defn find-slash-dot [(s (slice u8))] (-> i64)
  (let [n (slice-len [u8] s)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get s (load i))) (primitive/cast i64 46))
                  (store! at (load i))
                  (break))
                (set! i (primitive/isub (load i) 1)))))
    (load at)))

; The recoverable-collision hint (gen-6): every trait declaring `func`, rendered as
; the qualified call `Trait::func` (Trait by display-name), joined with " or ". So a
; same-name collision is now fixable — `(A::go x)` names the trait explicitly — and the
; error stops telling you to `:use` a module (useless when the traits are your own).
(defn method-qual-suggestions [(a (dyn Allocator)) (cx (ptr Cx)) (func (slice u8))] (-> (slice u8))
  (let [ms (field cx methods)
        n (al-len [MethodEntry] (.methods cx))
        (mut i) 0
        (mut out) ""
        (mut first) true]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [me (al-elem [MethodEntry] ms (load i))]
                  (when (= (load (field me name)) func)
                    (let [q (sconcat4 a "`" (display-name (load (field me trait))) "::" (sconcat a func "`"))]
                      (if (load first)
                          (do (store! out q) (store! first false) 0)
                          (do (store! out (sconcat3 a (load out) " or " q)) 0)))))
                (set! i (primitive/iadd (load i) 1)))))
    (load out)))

; Qualified `Trait::method` resolution (gen-6): pin the method to the named trait,
; bypassing in-scope ambiguity and module visibility (an explicit trait name IS the
; disambiguation). `qual` matches a trait by its full name or its last-dotted
; component, so both `A::go` and `app.A::go` select `app.A`. An empty `qual` delegates
; to the ordinary in-scope resolution.
; A method call whose head was MODULE-qualified by macro hygiene (`coil.core.=`).
; The module names where the template was written, so it selects among traits that
; declare the method — the lexical-scope answer to "which `=` did the macro mean?".
;
; `mod` empty means no module qualifier, and this is exactly `resolve-method-qual`.
; A module that matches no candidate also falls back to the unqualified path rather
; than erroring: hygiene may qualify a name whose trait lives elsewhere (a re-export,
; or a method reached through an import), and being stricter there would reject
; working code to enforce a rule the programmer never wrote.
(defn resolve-method-mod [(a (dyn Allocator))
                          (cx (ptr Cx))
                          (func (slice u8))
                          (qual (slice u8))
                          (mod (slice u8))
                          (fname (slice u8))] (-> (Result MethodEntry Diag))
  (if (or (!= (slice-len [u8] qual) (primitive/cast i64 0))
          (= (slice-len [u8] mod) (primitive/cast i64 0)))
      (resolve-method-qual a cx func qual fname)
      (let [ms (field cx methods)
            n (al-len [MethodEntry] (.methods cx))
            (mut i) 0
            (mut cnt) 0
            (mut only) (primitive/cast (ptr MethodEntry) 0)]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [me (al-elem [MethodEntry] ms (load i))]
                      (when (and (= (load (field me name)) func)
                                 (= (before-last-dot (load (field me trait))) mod))
                        (store! cnt (primitive/iadd (load cnt) 1))
                        (store! only me)
                        0))
                    (set! i (primitive/iadd (load i) 1)))))
        (if (= (load cnt) (primitive/cast i64 1))
            (Ok (load (load only)))
            (resolve-method-qual a cx func qual fname)))))

(defn resolve-method-qual [(a (dyn Allocator)) (cx (ptr Cx)) (func (slice u8)) (qual (slice u8)) (fname (slice u8))] (-> (Result MethodEntry
                                                                                                                                 Diag))
  (if (= (slice-len [u8] qual) (primitive/cast i64 0))
      (resolve-method a cx func fname)
      (let [ms (field cx methods)
            n (al-len [MethodEntry] (.methods cx))
            (mut i) 0
            (mut cnt) 0
            (mut only) (primitive/cast (ptr MethodEntry) 0)]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (let [me (al-elem [MethodEntry] ms (load i))]
                      (when (and (= (load (field me name)) func)
                                 (or (= (load (field me trait)) qual)
                                     (= (after-last-dot (load (field me trait))) qual)))
                        (store! cnt (primitive/iadd (load cnt) 1))
                        (store! only me)
                        0))
                    (set! i (primitive/iadd (load i) 1)))))
        (if (= (load cnt) (primitive/cast i64 1))
            (Ok (load (load only)))
            (if (= (load cnt) (primitive/cast i64 0))
                (Err [MethodEntry Diag]
                     (derr (sconcat a
                                    (sconcat5 a "in '" fname "': no trait '" qual "' declares method '")
                                    (sconcat a func "'"))))
                (let [head
                        (sconcat a
                                 (sconcat5 a "in '" fname "': qualifier '" qual "' is ambiguous — ")
                                 (i64->str a (load cnt)))]
                  (Err [MethodEntry Diag]
                       (derr (sconcat3 a
                                       head
                                       " traits named '"
                                       (sconcat a
                                                qual
                                                "' declare this method; qualify with the module-prefixed trait name"))))))))))

; resolve_method — returns a chosen MethodEntry.
(defn resolve-method [(a (dyn Allocator)) (cx (ptr Cx)) (func (slice u8)) (fname (slice u8))] (-> (Result MethodEntry
                                                                                                          Diag))
  (let [ms (field cx methods)
        n (al-len [MethodEntry] (.methods cx))
        ; `main` keeps its bare name, so fall back to the entry file's module for it —
        ; otherwise refer control silently stops applying inside `main`, which is where
        ; a small program keeps most of its code.
        entrym (.entry_module cx)
        hc0 (or (has-dot fname) (> (slice-len [u8] entrym) (primitive/cast i64 0)))
        caller0 (if (has-dot fname) (subslice [u8] fname 0 (find-slash-dot fname)) entrym)
        (mut i) 0
        (mut cnt) 0
        (mut only) (primitive/cast (ptr MethodEntry) 0)]
    ; An explicitly excluded method is not a candidate at all — including when its trait
    ; is the only one declaring it, which is the case for every operator.
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [me (al-elem [MethodEntry] ms (load i))]
                  (when (and (= (load (field me name)) func)
                             (not (method-suppressed? cx (load (field me trait)) func caller0 hc0)))
                    (store! cnt (primitive/iadd (load cnt) 1))
                    (store! only me)
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (= (load cnt) (primitive/cast i64 1))
        (Ok (load (load only)))
        (let [has_caller hc0
              caller caller0
              (mut j) 0
              (mut vcnt) 0
              (mut vonly) (primitive/cast (ptr MethodEntry) 0)]
          (loop (if (>= (load j) n)
                    (break)
                    (do
                      (let [me (al-elem [MethodEntry] ms (load j))]
                        (when (and (and (= (load (field me name)) func)
                                        (not (method-suppressed? cx (load (field me trait)) func caller has_caller)))
                                   (trait-visible cx (load (field me trait)) caller has_caller))
                          (store! vcnt (primitive/iadd (load vcnt) 1))
                          (store! vonly me)
                          0))
                      (set! j (primitive/iadd (load j) 1)))))
          (if (= (load vcnt) (primitive/cast i64 1))
              (Ok (load (load vonly)))
              (if (= (load vcnt) (primitive/cast i64 0))
                  ; Every candidate the module deliberately dropped is reported as such.
                  ; Suggesting `Ord::<` to someone who just wrote `:exclude [<]` reads as
                  ; the compiler not having noticed.
                  (if (method-any-suppressed? cx func caller has_caller)
                      (Err [MethodEntry Diag]
                           (derr (sconcat a
                                          (sconcat4 a
                                                    "in '"
                                                    fname
                                                    "': trait method '"
                                                    (sconcat a func "' is not in scope — this module's import of "))
                                          (sconcat a
                                                   (method-suppressor a cx func caller has_caller)
                                                   " does not refer it. Add it to :use, drop it from :exclude/:rename, or call it qualified"))))
                      (Err [MethodEntry Diag]
                           (derr (sconcat a
                                          (sconcat a
                                                   (sconcat a
                                                            (sconcat4 a
                                                                      "in '"
                                                                      fname
                                                                      "': trait method '"
                                                                      (sconcat a func "' is declared in "))
                                                            (i64->str a (load cnt)))
                                                   " traits, none in scope here — call it qualified: ")
                                          (method-qual-suggestions a cx func)))))
                  (Err [MethodEntry Diag]
                       (derr (sconcat a
                                      (sconcat a
                                               (sconcat a
                                                        (sconcat4 a
                                                                  "in '"
                                                                  fname
                                                                  "': trait method '"
                                                                  (sconcat a func "' is ambiguous — "))
                                                        (i64->str a (load vcnt)))
                                               " in-scope traits declare it; call it qualified: ")
                                      (method-qual-suggestions a cx func))))))))))

(defn bounds-has [(bounds (ptr (ArrayList Bound))) (tp (slice u8)) (tr (slice u8))] (-> bool)
  (let [n (al-len [Bound] (load bounds))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [bp (al-elem [Bound] bounds (load i))]
                  (when (= (load (field bp name)) tp)
                    (let [trs (load (field bp traits))
                          m (al-len [(slice u8)] (load trs))
                          (mut k) 0]
                      (loop (if (>= (load k) m)
                                (break)
                                (do
                                  (when (= (al-get [(slice u8)] (load trs) (load k)) tr)
                                    (store! r
                                            true)
                                    (break))
                                  (store! k (primitive/iadd (load k) 1))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; build_make_dyn / dyn dispatch — not yet ported (hard error, never reached by
; non-dyn programs because maybe-coerce-dyn/is-dyn-target gate on a -dyn struct).
(defn dyn-method-names [(a (dyn Allocator)) (td (ptr TraitDef)) (tr (slice u8)) (tn (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [ms (load (field td methods))
        n (al-len [TraitMethod] (load ms))
        (mut out) (al-new [(slice u8)] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (tmfn a tr tn (.name (al-elem [TraitMethod] ms (load i)))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load out))))

(defn build-make-dyn [(a (dyn Allocator))
                      (cx (ptr Cx))
                      (trait_name (slice u8))
                      (inner (ptr Expr))
                      (inner_ty (ptr Type))
                      (lo i64)
                      (hi i64)
                      (src i64)
                      (ctxt i64)
                      (fname (slice u8))] (-> (Result SynPair Diag))
  (let [tr (resolve-trait-name cx trait_name)]
    (if (= (slice-len [u8] tr) (primitive/cast i64 0))
        (Err [SynPair Diag]
             (derr-at-src src
                          lo
                          hi
                          (sconcat1 a
                                    (sconcat4 a "in '" fname "': make-dyn: unknown trait '" (sconcat a trait_name "'")))))
        (if (not (type-is-ptr inner_ty))
            (Err [SynPair Diag]
                 (derr-at-src src
                              lo
                              hi
                              (sconcat a
                                       (sconcat3 a "in '" fname "': make-dyn expects a pointer to an implementer, got ")
                                       (ty-str a inner_ty))))
            (let [pointee (t-inner inner_ty)]
              (if (not (has-impl-name a pointee))
                  (Err [SynPair Diag]
                       (derr-at-src src
                                    lo
                                    hi
                                    (sconcat a
                                             (sconcat a
                                                      (sconcat4 a "in '" fname "': make-dyn: " (ty-str a pointee))
                                                      " cannot implement a trait")
                                             "")))
                  ; the vtable must point at the SELECTED impl's functions — a specialized
                  ; impl on the pointee has a decorated name, so the bare key would name a
                  ; function that doesn't exist
                  (let [sel (primitive/alloc-stack ImplSel)]
                    (set! sel (cx-impl-select a cx tr pointee))
                    (if (= (primitive/cast i64 (load (field sel ip))) (primitive/cast i64 0))
                        (Err [SynPair Diag]
                             (derr-at-src src
                                          lo
                                          hi
                                          (sconcat a
                                                   (sconcat a
                                                            (sconcat a
                                                                     (sconcat5 a
                                                                               "in '"
                                                                               fname
                                                                               "': '"
                                                                               (ty-str a pointee)
                                                                               "' does not implement '")
                                                                     (display-name tr))
                                                            "' (needed for (dyn ")
                                                   (sconcat a (display-name tr) "))"))))
                        (if (.ambiguous sel)
                            (Err [SynPair Diag]
                                 (derr-at-src src
                                              lo
                                              hi
                                              (sconcat a
                                                       (sconcat a
                                                                (sconcat5 a
                                                                          "in '"
                                                                          fname
                                                                          "': ambiguous impls of '"
                                                                          (display-name tr)
                                                                          "' for '")
                                                                (ty-str a pointee))
                                                       "' — several match and none is more specific")))
                            (let [dyn_struct (sconcat a tr "-dyn")
                                  vtable_struct (sconcat a tr "-vtable")]
                              (if (= (primitive/cast i64 (struct-find cx dyn_struct)) (primitive/cast i64 0))
                                  (Err [SynPair Diag]
                                       (derr-at-src src
                                                    lo
                                                    hi
                                                    (sconcat a
                                                             (sconcat a
                                                                      (sconcat5 a
                                                                                "in '"
                                                                                fname
                                                                                "': trait '"
                                                                                (display-name tr)
                                                                                "' has no trait object — call (defdyn ")
                                                                      (display-name tr))
                                                             ") after the trait")))
                                  (let [ipp (load (field sel ip))]
                                    ; A GENERIC impl's methods are generic functions: the vtable would
                                    ; have to reference a per-instantiation mangled name (e.g. Box__i64),
                                    ; but the trait object erases the concrete type and mono only
                                    ; instantiates via direct trait calls — so the vtable ends up naming
                                    ; the un-instantiated `Trait$Box$method`, which codegen can't resolve
                                    ; (it used to SIGABRT there). Reject it here, located, until dyn
                                    ; coercion learns to monomorphize the vtable.
                                    (if (> (al-len [(slice u8)] (load (field ipp type_params))) (primitive/cast i64 0))
                                        (Err [SynPair Diag]
                                             (derr-at-src src
                                                          lo
                                                          hi
                                                          (sconcat a
                                                                   (sconcat a
                                                                            (sconcat5 a
                                                                                      "in '"
                                                                                      fname
                                                                                      "': cannot make a trait object of '"
                                                                                      (ty-str a pointee)
                                                                                      "': its impl of '")
                                                                            (display-name tr))
                                                                   "' is generic, and a (dyn Trait) vtable needs a concrete impl; erase a fully-concrete type instead")))
                                        (let [td (trait-find cx tr)
                                              methods
                                                (dyn-method-names a
                                                                  td
                                                                  tr
                                                                  (impl-mangle-key a
                                                                                   (field ipp self_type)
                                                                                   (load (field ipp
                                                                                                type_params))))]
                                          (Ok (mk-synpair a
                                                          (box-expr a
                                                                    (mk-expr (EMakeDyn
                                                                               :dyn_struct dyn_struct
                                                                               :vtable_struct vtable_struct
                                                                               :methods methods
                                                                               :inner inner)
                                                                             lo
                                                                             hi
                                                                             src
                                                                             ctxt))
                                                          (box-type a (TStruct dyn_struct))))))))))))))))))

(defn maybe-coerce-dyn [(a (dyn Allocator))
                        (cx (ptr Cx))
                        (ae (ptr Expr))
                        (at (ptr Type))
                        (want (ptr Type))
                        (lo i64)
                        (hi i64)
                        (src i64)
                        (ctxt i64)
                        (fname (slice u8))] (-> (Result SynPair Diag))
  (let [wtg (type-tag want)
        wdname
          (if (= wtg (primitive/cast i64 6))
              (type-struct-name want)
              (if (and (= wtg (primitive/cast i64 5)) (= (type-tag (t-inner want)) (primitive/cast i64 6)))
                  (type-struct-name (t-inner want))
                  ""))]
    (if (= (slice-len [u8] wdname) (primitive/cast i64 0))
        (Ok (mk-synpair a ae at))
        (if (and (type-is-ptr at)
                 (not (and (= (type-tag (t-inner at)) (primitive/cast i64 6))
                           (= (type-struct-name (t-inner at)) wdname))))
            (let [tr (dyn-struct-trait cx wdname)]
              (if (> (slice-len [u8] tr) (primitive/cast i64 0))
                  (build-make-dyn a cx tr ae at lo hi src ctxt fname)
                  (Ok (mk-synpair a ae at))))
            (Ok (mk-synpair a ae at))))))

; synth_construct
(defn variant-in-sum [(si (ptr SumInfo)) (variant (slice u8))] (-> (ptr Variant))
  (let [vs (load (field si variants))
        n (al-len [Variant] (load vs))
        (mut i) 0
        (mut r) (primitive/cast (ptr Variant) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [Variant] vs (load i)) name)) variant)
                  (store! r (al-elem [Variant] vs (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn field-types-of [(a (dyn Allocator)) (v (ptr Variant))] (-> (ptr (ArrayList Type)))
  (let [fs (load (field v fields))
        n (al-len [Field] (load fs))
        (mut out) (al-new [Type] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (.ty (al-elem [Field] fs (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn all-tparams-bound [(tparams (ptr (ArrayList (slice u8)))) (subst (ptr (ArrayList SubstEntry)))] (-> bool)
  (let [n (al-len [(slice u8)] (load tparams))
        (mut i) 0
        (mut all) true]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (not (subst-has subst (al-get [(slice u8)] (load tparams) (load i))))
                  (store! all
                          false)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load all)))

(defn synth-construct [(a (dyn Allocator))
                       (variant (slice u8))
                       (type_args (ptr (ArrayList Type)))
                       (args (ptr (ArrayList Expr)))
                       (expected (ptr Type))
                       (env (ptr (ArrayList EnvEntry)))
                       (cx (ptr Cx))
                       (tps (ptr (ArrayList (slice u8))))
                       (fname (slice u8))
                       (lo i64)
                       (hi i64)
                       (src i64)
                       (ctxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [sumname (load (field (vts-find cx variant) sum))
               si (sum-find cx (load (field (vts-find cx variant) sum)))
               v (variant-in-sum si variant)]
           (when (not (= (al-len [Field] (load (field v fields))) (al-len [Expr] (load args))))
             (break :try
                      (err-ep (derr (sconcat a
                                             (sconcat a
                                                      (sconcat a
                                                               (sconcat4 a
                                                                         "in '"
                                                                         fname
                                                                         "': variant '"
                                                                         (sconcat a variant "' takes "))
                                                               (i64->str a
                                                                         (al-len [Field]
                                                                                 (load (field v
                                                                                              fields)))))
                                                      " field(s), got ")
                                             (i64->str a (al-len [Expr] (load args))))))))
           (let [tparams (load (field si type_params))
                 field_types (field-types-of a v)
                 subst (subst-new a)
                 np (al-len [(slice u8)] (load tparams))]
             (if (> (al-len [Type] (load type_args)) (primitive/cast i64 0))
                 (do
                   (when (not (= (al-len [Type] (load type_args)) np))
                     (break :try
                              (err-ep (derr (sconcat a
                                                     (sconcat a
                                                              (sconcat a
                                                                       (sconcat4 a
                                                                                 "in '"
                                                                                 fname
                                                                                 "': '"
                                                                                 (sconcat a variant "' expects "))
                                                                       (i64->str a np))
                                                              " type arguments, got ")
                                                     (i64->str a (al-len [Type] (load type_args))))))))
                   (try! (validate-targs a cx type_args tps fname))
                   (build-subst! subst tparams type_args))
                 (when (expected-some? expected)
                   (let [to (alloc-stack-store-targs a expected sumname np)]
                     (when (load (field to found))
                       (build-subst! subst
                                     tparams
                                     (load (field to
                                                  targs)))))))
             (let [new_args
                     (if (all-tparams-bound tparams subst)
                         (try! (construct-check-args a field_types args subst variant env cx tps fname))
                         (try! (construct-infer-args a field_types args subst tparams variant env cx tps fname)))]
               (if (= np (primitive/cast i64 0))
                   (ok-ep (mk-expr (ECall
                                     :func variant
                                     :type_args (box-items-type a)
                                     :args new_args)
                                   lo
                                   hi
                                   src
                                   ctxt)
                          (TStruct sumname))
                   (let [out_targs (subst-targs a tparams subst)]
                     (ok-ep (mk-expr (ECall
                                       :func variant
                                       :type_args out_targs
                                       :args new_args)
                                     lo
                                     hi
                                     src
                                     ctxt)
                            (TApp sumname out_targs))))))))))

; Validate and reorder `:field value` constructor arguments to declaration order.
; The resolved variant owns the authoritative field list for both structs and sums.
(defn named-constructor-args [(a (dyn Allocator))
                              (variant (slice u8))
                              (fields (ptr (ArrayList Field)))
                              (names (ptr (ArrayList (slice u8))))
                              (args (ptr (ArrayList Expr)))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (try (let [nn (al-len [(slice u8)] (load names))
             nf (al-len [Field] (load fields))]
         (when (not (= nn (al-len [Expr] (load args))))
           (break :try
                    (Err [(ptr (ArrayList Expr)) Diag]
                         (derr "internal: named constructor name/value count mismatch"))))
         (let [(mut i) 0]
           (loop (if (>= (load i) nn)
                     (break)
                     (do
                       (let [name (al-get [(slice u8)] (load names) (load i))
                             (mut known) false
                             (mut j) 0]
                         (loop (if (>= (load j) nf)
                                   (break)
                                   (do
                                     (when (= name (load (field (al-elem [Field] fields (load j)) name)))
                                       (store! known true)
                                       (break))
                                     (store! j (primitive/iadd (load j) 1)))))
                         (when (not (load known))
                           (break :try
                                    (Err [(ptr (ArrayList Expr)) Diag]
                                         (derr (sconcat a
                                                        (sconcat3 a "constructor '" variant "' has no field :")
                                                        name)))))
                         (let [(mut k) 0]
                           (loop (if (>= (load k) (load i))
                                     (break)
                                     (do
                                       (when (= name (al-get [(slice u8)] (load names) (load k)))
                                         (break :try
                                                  (Err [(ptr (ArrayList Expr)) Diag]
                                                       (derr (sconcat a
                                                                      (sconcat3 a
                                                                                "constructor '"
                                                                                variant
                                                                                "' repeats field :")
                                                                      name)))))
                                       (store! k (primitive/iadd (load k) 1)))))))
                       (store! i (primitive/iadd (load i) 1))))))
         (let [(mut out) (al-new [Expr] a)
               (mut fi) 0]
           (loop (if (>= (load fi) nf)
                     (break)
                     (let [field-name (load (field (al-elem [Field] fields (load fi)) name))
                           (mut found) -1
                           (mut ai) 0]
                       (loop (if (>= (load ai) nn)
                                 (break)
                                 (do
                                   (when (= field-name (al-get [(slice u8)] (load names) (load ai)))
                                     (store! found (load ai))
                                     (break))
                                   (store! ai (primitive/iadd (load ai) 1)))))
                       (when (< (load found) (primitive/cast i64 0))
                         (break :try
                                  (Err [(ptr (ArrayList Expr)) Diag]
                                       (derr (sconcat a
                                                      (sconcat3 a "constructor '" variant "' is missing field :")
                                                      field-name)))))
                       (al-push! (mut out) (al-get [Expr] (load args) (load found)))
                       (store! fi (primitive/iadd (load fi) 1)))))
           (Ok (box-al [Expr] a (load out)))))))

; Validate function argument names and return the expressions in parameter order.
; Extern and variadic signatures deliberately have no usable name list.
(defn named-function-args [(a (dyn Allocator))
                           (func (slice u8))
                           (params (ptr (ArrayList (slice u8))))
                           (names (ptr (ArrayList (slice u8))))
                           (args (ptr (ArrayList Expr)))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (try (let [nn (al-len [(slice u8)] (load names))
             np (al-len [(slice u8)] (load params))]
         (when (not (= nn (al-len [Expr] (load args))))
           (break :try
                    (Err [(ptr (ArrayList Expr)) Diag]
                         (derr "internal: named function name/value count mismatch"))))
         (let [(mut i) 0]
           (loop (if (>= (load i) nn)
                     (break)
                     (do
                       (let [name (al-get [(slice u8)] (load names) (load i))]
                         (when (< (name-index params name) (primitive/cast i64 0))
                           (break :try
                                    (Err [(ptr (ArrayList Expr)) Diag]
                                         (derr (sconcat a
                                                        (sconcat3 a "function '" func "' has no parameter :")
                                                        name)))))
                         (let [(mut k) 0]
                           (loop (if (>= (load k) (load i))
                                     (break)
                                     (do
                                       (when (= name (al-get [(slice u8)] (load names) (load k)))
                                         (break :try
                                                  (Err [(ptr (ArrayList Expr)) Diag]
                                                       (derr (sconcat a
                                                                      (sconcat3 a
                                                                                "function '"
                                                                                func
                                                                                "' repeats parameter :")
                                                                      name)))))
                                       (store! k (primitive/iadd (load k) 1)))))))
                       (store! i (primitive/iadd (load i) 1))))))
         (let [(mut out) (al-new [Expr] a)
               (mut pi) 0]
           (loop (if (>= (load pi) np)
                     (break)
                     (let [pname (al-get [(slice u8)] (load params) (load pi))
                           ai (name-index names pname)]
                       (when (< ai (primitive/cast i64 0))
                         (break :try
                                  (Err [(ptr (ArrayList Expr)) Diag]
                                       (derr (sconcat a
                                                      (sconcat3 a "function '" func "' is missing parameter :")
                                                      pname)))))
                       (al-push! (mut out) (al-get [Expr] (load args) ai))
                       (store! pi (primitive/iadd (load pi) 1)))))
           (Ok (box-al [Expr] a (load out)))))))

(defn named-temp-name [(a (dyn Allocator)) (lo i64) (i i64)] (-> (slice u8))
  (sconcat3 a "$named-arg." (i64->str a lo) (sconcat a "." (i64->str a i))))

(defn named-same-order? [(decl-names (ptr (ArrayList (slice u8))))
                         (source-names (ptr (ArrayList (slice u8))))
                         (i i64)
                         (n i64)] (-> bool)
  (if (>= i n)
      true
      (if (= (al-get [(slice u8)] (load decl-names) i)
             (al-get [(slice u8)] (load source-names) i))
          (named-same-order? decl-names source-names (+ i 1) n)
          false)))

; The checked expressions arrive in declaration order. Bind them in the order in
; which their names occurred at the call site, then expose variables in declaration
; order for the ABI-level positional call or constructor lowering.
(defn named-source-binds [(a (dyn Allocator))
                          (decl-names (ptr (ArrayList (slice u8))))
                          (source-names (ptr (ArrayList (slice u8))))
                          (checked (ptr (ArrayList Expr)))
                          (lo i64)] (-> (ptr (ArrayList Bind)))
  (let [(mut out) (al-new [Bind] a)
        n (al-len [(slice u8)] (load source-names))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [di (name-index decl-names (al-get [(slice u8)] (load source-names) (load i)))]
                (al-push! (mut out)
                          (mk-bind (named-temp-name a lo (load i))
                                   false
                                   (al-get [Expr] (load checked) di)))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Bind] a (load out))))

(defn named-decl-vars [(a (dyn Allocator))
                       (decl-names (ptr (ArrayList (slice u8))))
                       (source-names (ptr (ArrayList (slice u8))))
                       (lo i64)
                       (hi i64)
                       (src i64)
                       (ctxt i64)] (-> (ptr (ArrayList Expr)))
  (let [(mut out) (al-new [Expr] a)
        n (al-len [(slice u8)] (load decl-names))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [si (name-index source-names (al-get [(slice u8)] (load decl-names) (load i)))]
                (al-push! (mut out) (mk-expr (EVar (named-temp-name a lo si)) lo hi src ctxt))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Expr] a (load out))))

(defn field-types [(a (dyn Allocator)) (fields (ptr (ArrayList Field)))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (al-new [Type] a)
        n (al-len [Field] (load fields))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (.ty (al-elem [Field] fields (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn field-names [(a (dyn Allocator)) (fields (ptr (ArrayList Field)))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (al-new [(slice u8)] a)
        n (al-len [Field] (load fields))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (.name (al-elem [Field] fields (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [(slice u8)] a (load out))))

; Materialize a struct constructor as ordinary checked language operations: one
; zeroed aggregate place followed by a typed store into every field. This keeps a
; single layout/codegen path for structs instead of teaching every backend a
; second aggregate representation.
(defn struct-constructor-source [(a (dyn Allocator))
                                 (ty Type)
                                 (fields (ptr (ArrayList Field)))
                                 (args (ptr (ArrayList Expr)))
                                 (lo i64)
                                 (hi i64)
                                 (src i64)
                                 (ctxt i64)] (-> Expr)
  (let [tmp (sconcat a "$named-ctor." (i64->str a lo))
        (mut binds) (al-new [Bind] a)
        (mut body) (al-new [Expr] a)
        n (al-len [Field] (load fields))
        (mut i) 0]
    (al-push! (mut binds) (mk-bind tmp true (mk-expr (EZeroed ty) lo hi src ctxt)))
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut body)
                          (mk-expr (EInitStore (box-expr a
                                                         (mk-expr (EField (box-expr a
                                                                                    (mk-expr (EVar tmp) lo hi src ctxt))
                                                                          (.name (al-elem [Field] fields (load i))))
                                                                  lo
                                                                  hi
                                                                  src
                                                                  ctxt))
                                               (box-expr a (al-get [Expr] (load args) (load i))))
                                   lo
                                   hi
                                   src
                                   ctxt))
                (set! i (primitive/iadd (load i) 1)))))
    (al-push! (mut body) (mk-expr (EVar tmp) lo hi src ctxt))
    (mk-expr (ELet (box-al [Bind] a (load binds)) (box-al [Expr] a (load body))) lo hi src ctxt)))

(defn synth-named-struct [(a (dyn Allocator))
                          (name (slice u8))
                          (st (ptr StructInfo))
                          (type-args (ptr (ArrayList Type)))
                          (source-names (ptr (ArrayList (slice u8))))
                          (args (ptr (ArrayList Expr)))
                          (expected (ptr Type))
                          (env (ptr (ArrayList EnvEntry)))
                          (cx (ptr Cx))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))
                          (lo i64)
                          (hi i64)
                          (src i64)
                          (ctxt i64)] (-> (Result EvalPair Diag))
  (try (let [params (load (field st type_params))
             fields (load (field st fields))
             ftypes (field-types a fields)
             subst (subst-new a)
             np (al-len [(slice u8)] (load params))]
         (if (> (al-len [Type] (load type-args)) (primitive/cast i64 0))
             (do
               (when (not (= (al-len [Type] (load type-args)) np))
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat3 a
                                                           "in '"
                                                           fname
                                                           "': wrong number of type arguments for struct '")
                                                 (sconcat a name "'"))))))
               (try! (validate-targs a cx type-args tps fname))
               (build-subst! subst params type-args))
             (when (expected-some? expected)
               (let [to (alloc-stack-store-targs a expected name np)]
                 (when (load (field to found))
                   (build-subst! subst params (load (field to targs)))))))
         (let [checked
                 (if (all-tparams-bound params subst)
                     (try! (construct-check-args a ftypes args subst name env cx tps fname))
                     (try! (construct-infer-args a ftypes args subst params name env cx tps fname)))
               out-args (if (= np (primitive/cast i64 0)) (box-items-type a) (subst-targs a params subst))
               out-ty (if (= np (primitive/cast i64 0)) (TStruct name) (TApp name out-args))
               decl-names (field-names a fields)]
           (if (named-same-order? decl-names source-names 0 (al-len [(slice u8)] (load decl-names)))
               (let [source (struct-constructor-source a out-ty fields checked lo hi src ctxt)]
                 (synth a (box-expr a source) expected env cx tps fname))
               (let [binds (named-source-binds a decl-names source-names checked lo)
                     vars (named-decl-vars a decl-names source-names lo hi src ctxt)
                     inner (struct-constructor-source a out-ty fields vars lo hi src ctxt)
                     (mut body) (al-new [Expr] a)]
                 (al-push! (mut body) inner)
                 (let [source (mk-expr (ELet binds (box-al [Expr] a (load body))) lo hi src ctxt)]
                   (synth a (box-expr a source) expected env cx tps fname))))))))

(defn synth-named-construct [(a (dyn Allocator))
                             (variant (slice u8))
                             (type-args (ptr (ArrayList Type)))
                             (names (ptr (ArrayList (slice u8))))
                             (args (ptr (ArrayList Expr)))
                             (expected (ptr Type))
                             (env (ptr (ArrayList EnvEntry)))
                             (cx (ptr Cx))
                             (tps (ptr (ArrayList (slice u8))))
                             (fname (slice u8))
                             (lo i64)
                             (hi i64)
                             (src i64)
                             (ctxt i64)] (-> (Result EvalPair Diag))
  (try (let [vt (vts-find cx variant)
             st (struct-find cx variant)]
         (if (!= (primitive/cast i64 vt) (primitive/cast i64 0))
             (let [si (sum-find cx (load (field vt sum)))
                   v (variant-in-sum si variant)
                   fields (load (field v fields))
                   ordered (try! (named-constructor-args a variant fields names args))
                   ep (try! (synth-construct a variant type-args ordered expected env cx tps fname lo hi src ctxt))]
               (source-order-named-call a (field-names a fields) names ep expected env cx tps fname lo hi src ctxt))
             (if (!= (primitive/cast i64 st) (primitive/cast i64 0))
                 (let [ordered (try! (named-constructor-args a variant (load (field st fields)) names args))]
                   (synth-named-struct a variant st type-args names ordered expected env cx tps fname lo hi src ctxt))
                 (err-ep (derr (sconcat a
                                        (sconcat3 a
                                                  "in '"
                                                  fname
                                                  "': named arguments require a struct or sum constructor; '")
                                        (sconcat a variant "' is not one")))))))))

; Replace the declaration-ordered checked arguments with temporaries whose
; initializers occur in source order. The inner call remains positional, so every
; later compiler phase and every calling convention stays unchanged.
(defn source-order-named-call [(a (dyn Allocator))
                               (decl-names (ptr (ArrayList (slice u8))))
                               (source-names (ptr (ArrayList (slice u8))))
                               (ep EvalPair)
                               (expected (ptr Type))
                               (env (ptr (ArrayList EnvEntry)))
                               (cx (ptr Cx))
                               (tps (ptr (ArrayList (slice u8))))
                               (fname (slice u8))
                               (lo i64)
                               (hi i64)
                               (src i64)
                               (ctxt i64)] (-> (Result EvalPair Diag))
  (if (named-same-order? decl-names source-names 0 (al-len [(slice u8)] (load decl-names)))
      (Ok [EvalPair Diag] ep)
      (match (.kind (.e ep))
        (ECall [func targs checked]
               (let [binds (named-source-binds a decl-names source-names checked lo)
                     vars (named-decl-vars a decl-names source-names lo hi src ctxt)
                     inner
                       (mk-expr (ECall
                                  :func func
                                  :type_args targs
                                  :args vars)
                                lo
                                hi
                                src
                                ctxt)
                     (mut body) (al-new [Expr] a)]
                 (al-push! (mut body) inner)
                 (let [source (mk-expr (ELet binds (box-al [Expr] a (load body))) lo hi src ctxt)]
                   (synth a (box-expr a source) expected env cx tps fname))))
        (_ (err-ep (derr "internal: named call did not lower to a direct call"))))))

(defn synth-named-call [(a (dyn Allocator))
                        (func (slice u8))
                        (type-args (ptr (ArrayList Type)))
                        (names (ptr (ArrayList (slice u8))))
                        (args (ptr (ArrayList Expr)))
                        (expected (ptr Type))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))
                        (lo i64)
                        (hi i64)
                        (src i64)
                        (ctxt i64)] (-> (Result EvalPair Diag))
  (if (or (!= (primitive/cast i64 (vts-find cx func)) (primitive/cast i64 0))
          (!= (primitive/cast i64 (struct-find cx func)) (primitive/cast i64 0)))
      (synth-named-construct a func type-args names args expected env cx tps fname lo hi src ctxt)
      (let [sig (sig-find cx func)]
        (if (= (primitive/cast i64 sig) (primitive/cast i64 0))
            (err-ep (derr (sconcat a
                                   (sconcat3 a
                                             "in '"
                                             fname
                                             "': named arguments require a function, struct, or sum constructor; '")
                                   (sconcat a func "' is not one"))))
            (if (or (.is_extern sig) (.variadic sig))
                (err-ep (derr (sconcat3 a
                                        "named arguments are not supported for extern or variadic function '"
                                        func
                                        "'")))
                (try (let [decl-names (load (field sig param_names))
                           ordered (try! (named-function-args a func decl-names names args))
                           ep
                             (try! (synth-call-general a
                                                       func
                                                       func
                                                       type-args
                                                       ordered
                                                       expected
                                                       env
                                                       cx
                                                       tps
                                                       fname
                                                       lo
                                                       hi
                                                       src
                                                       ctxt))]
                       (source-order-named-call a decl-names names ep expected env cx tps fname lo hi src ctxt))))))))

(defn validate-targs [(a (dyn Allocator))
                      (cx (ptr Cx))
                      (type_args (ptr (ArrayList Type)))
                      (tps (ptr (ArrayList (slice u8))))
                      (fname (slice u8))] (-> (Result i64 Diag))
  (let [n (al-len [Type] (load type_args))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (validate-type (al-elem [Type] type_args (load i)) cx tps)
                  (Err [d]
                       (do
                         (set! err (prefix-diag a d (sconcat3 a "in '" fname "': type argument: ")))
                         (set! failed true)
                         (break)))
                  (Ok [_] 0))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn build-subst! [(subst (ptr (ArrayList SubstEntry)))
                    (tparams (ptr (ArrayList (slice u8))))
                    (targs (ptr (ArrayList Type)))] (-> i64)
  (let [n (al-len [(slice u8)] (load tparams))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (subst-insert! subst (al-get [(slice u8)] (load tparams) (load i)) (al-elem [Type] targs (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn alloc-stack-store-targs [(a (dyn Allocator)) (expected (ptr Type)) (sumname (slice u8)) (np i64)] (-> (ptr TargsOpt))
  (box! a TargsOpt (expected-sum-targs a expected sumname np)))

(defn subst-targs [(a (dyn Allocator)) (tparams (ptr (ArrayList (slice u8)))) (subst (ptr (ArrayList SubstEntry)))] (-> (ptr (ArrayList Type)))
  (let [n (al-len [(slice u8)] (load tparams))
        (mut out) (al-new [Type] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (load (subst-get subst (al-get [(slice u8)] (load tparams) (load i)))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn construct-check-args [(a (dyn Allocator))
                            (field_types (ptr (ArrayList Type)))
                            (args (ptr (ArrayList Expr)))
                            (subst (ptr (ArrayList SubstEntry)))
                            (variant (slice u8))
                            (env (ptr (ArrayList EnvEntry)))
                            (cx (ptr Cx))
                            (tps (ptr (ArrayList (slice u8))))
                            (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [n (al-len [Expr] (load args))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [want (subst-apply a (al-elem [Type] field_types (load i)) subst)
                      wp (box-type a want)
                      what
                        (sconcat a
                                 (sconcat a
                                          (sconcat3 a "'" variant "' field ")
                                          (i64->str a (primitive/iadd (load i) 1)))
                                 "")]
                  (match (check-to a (al-elem [Expr] args (load i)) wp env cx tps fname what)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [ce] (al-push! (mut out) ce))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Expr)) Diag] (load err)) (Ok (box-al [Expr] a (load out))))))

(defn construct-infer-args [(a (dyn Allocator))
                            (field_types (ptr (ArrayList Type)))
                            (args (ptr (ArrayList Expr)))
                            (subst (ptr (ArrayList SubstEntry)))
                            (tparams (ptr (ArrayList (slice u8))))
                            (variant (slice u8))
                            (env (ptr (ArrayList EnvEntry)))
                            (cx (ptr Cx))
                            (tps (ptr (ArrayList (slice u8))))
                            (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [n (al-len [Expr] (load args))
        (mut argl) (al-new [ArgSlot] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (do-synth a (al-elem [Expr] args (load i)) (null-type) env cx tps fname)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [sp0]
                      (let [sp (primitive/alloc-stack SynPair)
                            sl (primitive/alloc-stack ArgSlot)]
                        (set! sp sp0)
                        (set! (.present sl) true)
                        (set! (.e sl) (load (field sp e)))
                        (set! (.t sl) (load (field sp t)))
                        (al-push! (mut argl) (load sl)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList Expr)) Diag] (load err))
        (let [argl2 (box-al [ArgSlot] a (load argl))
              (mut j) 0
              (mut err2) (primitive/zeroed Diag)
              (mut failed2) false]
          (loop (if (>= (load j) n)
                    (break)
                    (do
                      (match (unify a
                                    (al-elem [Type] field_types (load j))
                                    (load (field (al-elem [ArgSlot] argl2 (load j)) t))
                                    tparams
                                    subst
                                    fname)
                        (Err [d] (do (set! err2 d) (set! failed2 true) (break)))
                        (Ok [_] 0))
                      (set! j (primitive/iadd (load j) 1)))))
          (if (load failed2)
              (Err [(ptr (ArrayList Expr)) Diag] (load err2))
              (let [npm (al-len [(slice u8)] (load tparams))
                    (mut k) 0
                    (mut missing) false
                    (mut mp) ""]
                (loop (if (>= (load k) npm)
                          (break)
                          (do
                            (when (not (subst-has subst (al-get [(slice u8)] (load tparams) (load k))))
                              (store! missing true)
                              (store! mp (al-get [(slice u8)] (load tparams) (load k)))
                              (break))
                            (set! k (primitive/iadd (load k) 1)))))
                (if (load missing)
                    (Err [(ptr (ArrayList Expr)) Diag]
                         (derr (sconcat a
                                        (sconcat a
                                                 (sconcat4 a
                                                           "in '"
                                                           fname
                                                           "': cannot infer type argument '"
                                                           (sconcat a (load mp) "' for '"))
                                                 (sconcat a variant "'; provide it explicitly: ("))
                                        (sconcat a variant " [<types>] ...)"))))
                    (let [(mut m) 0
                          (mut out2) (al-new [Expr] a)
                          (mut err3) (primitive/zeroed Diag)
                          (mut failed3) false]
                      (loop (if (>= (load m) n)
                                (break)
                                (do
                                  (let [sl (al-elem [ArgSlot] argl2 (load m))
                                        want (subst-apply a (al-elem [Type] field_types (load m)) subst)
                                        wp (box-type a want)
                                        what
                                          (sconcat a
                                                   (sconcat3 a "'" variant "' field ")
                                                   (i64->str a (primitive/iadd (load m) 1)))]
                                    (match (coerce a
                                                   (load (load (field sl e)))
                                                   (load (field sl
                                                                t))
                                                   wp
                                                   false
                                                   fname
                                                   what)
                                      (Err [d] (do (set! err3 d) (set! failed3 true) (break)))
                                      (Ok [ce] (al-push! (mut out2) ce))))
                                  (set! m (primitive/iadd (load m) 1)))))
                      (if (load failed3)
                          (Err [(ptr (ArrayList Expr)) Diag] (load err3))
                          (Ok (box-al [Expr] a (load out2))))))))))))

; ---- ECall ----
(defn methods-has [(cx (ptr Cx)) (func (slice u8))] (-> bool)
  (let [n (al-len [MethodEntry] (.methods cx))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [MethodEntry] (field cx methods) (load i)) name)) func)
                  (store! r true)
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn trait-method-find [(td (ptr TraitDef)) (func (slice u8))] (-> (ptr TraitMethod))
  (let [ms (load (field td methods))
        n (al-len [TraitMethod] (load ms))
        (mut i) 0
        (mut r) (primitive/cast (ptr TraitMethod) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [TraitMethod] ms (load i)) name)) func)
                  (store! r (al-elem [TraitMethod] ms (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; Can this signature take `nargs` arguments at all? The gate for the
; arity-directed fallback below — variadic counts as "yes" from nparams up.
(defn sig-arity-ok? [(sig (ptr Sig)) (nargs i64)] (-> bool)
  (let [np (al-len [Type] (load (field sig params)))]
    (if (.variadic sig) (>= nargs np) (= nargs np))))

; Does ANY declared trait method named `simple` accept exactly `nargs` args?
; Scope and ambiguity are NOT judged here — that stays with the ordinary
; method-resolution path, which has its own diagnostics for both.
(defn method-arity-matches? [(cx (ptr Cx)) (simple (slice u8)) (nargs i64)] (-> bool)
  (let [ms (field cx methods)
        n (al-len [MethodEntry] (load ms))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [me (al-elem [MethodEntry] ms (load i))]
                  (when (= (load (field me name)) simple)
                    (let [td (trait-find cx (load (field me trait)))]
                      (unless (= (primitive/cast i64 td) (primitive/cast i64 0))
                        (let [tm (trait-method-find td simple)]
                          (unless (= (primitive/cast i64 tm) (primitive/cast i64 0))
                            (when (= (al-len [Param] (load (field tm params))) nargs)
                              (store! r true)
                              (break))
                            0))
                        0))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; The declaring trait of the first method named `simple`, for diagnostics.
(defn method-trait-of [(cx (ptr Cx)) (simple (slice u8))] (-> (slice u8))
  (let [ms (field cx methods)
        n (al-len [MethodEntry] (load ms))
        (mut i) 0
        (mut r) ""]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [MethodEntry] ms (load i)) name)) simple)
                  (store! r (load (field (al-elem [MethodEntry] ms (load i)) trait)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn is-mut-borrow [(e (ptr Expr))] (-> bool)
  (match (.kind e) (EBorrow [mu place] mu) (_ false)))

(defn peel-ref-ptr [(t (ptr Type))] (-> (ptr Type))
  (let [(mut r) t]
    (loop (let [tg (type-tag (load r))]
            (if (or (= tg (primitive/cast i64 4)) (= tg (primitive/cast i64 5)))
                (do (set! r (t-inner (load r))) 0)
                (break))))
    (load r)))

; Can a call to a `tr` method dispatch on a receiver of type `t`? Either an impl
; matches it, `t` is a (bounded) type parameter, or it's a `(dyn Trait)` receiver.
(defn dispatch-here? [(a (dyn Allocator))
                      (cx (ptr Cx))
                      (tr (slice u8))
                      (t (ptr Type))
                      (tps (ptr (ArrayList (slice u8))))] (-> bool)
  (if (not (has-impl-name a t))
      false
      (let [nm (type-impl-name a t)]
        (or (set-contains tps nm)
            (or (> (slice-len [u8] (dyn-struct-trait cx nm)) (primitive/cast i64 0))
                (impl-match a cx tr t))))))

; Method-dispatch autoderef. This was a single full `peel-ref-ptr`, which was fine
; while pointers couldn't carry impls — the pointee was the only possible receiver.
; Now that they can, a pointer's OWN impl must win: `(< p q)` with `Ord (ptr T)` in
; scope compares ADDRESSES, and must not silently peel to the pointee's `Ord`. So we
; try the receiver's own type first and peel one ptr/ref layer at a time, stopping at
; the first level that dispatches (the receiver type is tried before any
; autoderef step). `(len xs)` on `(ptr (ArrayList T))` still works: "ptr" has no `Len`
; impl, so the chain peels to the ArrayList exactly as before. If nothing in the chain
; dispatches, fall back to the fully-peeled type so existing diagnostics are unchanged.
(defn deref-to-impl [(a (dyn Allocator))
                     (cx (ptr Cx))
                     (tr (slice u8))
                     (t0 (ptr Type))
                     (tps (ptr (ArrayList (slice u8))))] (-> (ptr Type))
  (let [(mut r) t0
        (mut found) false]
    (loop (if (dispatch-here? a cx tr (load r) tps)
              (do (set! found true) (break))
              (let [tg (type-tag (load r))]
                (if (or (= tg (primitive/cast i64 4)) (= tg (primitive/cast i64 5)))
                    (do (set! r (t-inner (load r))) 0)
                    (break)))))
    (if (load found) (load r) (peel-ref-ptr t0))))

; ---- associated-type bounds (gen-1) ----------------------------------------
; A PARAMETERIZED trait `(deftrait Get [Self K E] …)` can be used as a bound
; `(C Get)`: its non-Self params (K, E) are ASSOCIATED TYPES — determined by C's
; impl, one impl per type. Inside the bounded generic they are unknown, so each is
; represented as a synthetic abstract type param `<C>$assoc$<Trait>$<K>` — a spelling
; no user identifier can produce (`$` isn't an identifier char), so it never collides
; with a real type. These names are added to the body's tps (so a call whose
; result/arg mentions one type-checks) and resolved to the impl's concrete type at
; monomorphization (mono reads them off the receiver's impl, exactly as it already
; reads a generic impl's own type params).
(defn assoc-tp-name [(a (dyn Allocator)) (base (slice u8)) (tr (slice u8)) (p (slice u8))] (-> (slice u8))
  (sconcat3 a base "$assoc$" (sconcat3 a (display-name tr) "$" p)))

; The deferred-call substitution: the trait method's `Self` -> the bounded type
; param `C`, and each extra trait param -> its associated type. `subst-apply` over
; this turns the trait method signature into the concrete-in-C signature the body
; is checked against.
(defn build-trait-subst [(a (dyn Allocator))
                         (self_pname (slice u8))
                         (self_name (slice u8))
                         (trait_name (slice u8))
                         (td (ptr TraitDef))] (-> (ptr (ArrayList SubstEntry)))
  (let [s (subst-new a)]
    (subst-insert! s self_pname (box-type a (TStruct self_name)))
    (let [tps2 (load (field td type_params))
          np (al-len [(slice u8)] (load tps2))
          (mut i) 0]
      (loop (if (>= (load i) np)
                (break)
                (do
                  (let [p (al-get [(slice u8)] (load tps2) (load i))]
                    (subst-insert! s p (box-type a (TStruct (assoc-tp-name a self_name trait_name p)))))
                  (set! i (primitive/iadd (load i) 1))))))
    s))

; `base` (the function's declared type params) extended with the associated-type
; names of every bound over a parameterized trait — the tps the BODY is checked
; against. The stored func `type_params` are unchanged: associated types are
; internal, never named by a caller.
(defn assoc-body-tps [(a (dyn Allocator))
                      (cx (ptr Cx))
                      (bounds (ptr (ArrayList Bound)))
                      (base (ptr (ArrayList (slice u8))))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (al-new [(slice u8)] a)
        nb (al-len [(slice u8)] (load base))
        (mut i) 0]
    (loop (if (>= (load i) nb)
              (break)
              (do
                (al-push! (mut out) (al-get [(slice u8)] (load base) (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (let [nbd (al-len [Bound] (load bounds))
          (mut j) 0]
      (loop (if (>= (load j) nbd)
                (break)
                (do
                  (let [bp (al-elem [Bound] bounds (load j))
                        trs (load (field bp traits))
                        m (al-len [(slice u8)] (load trs))
                        (mut k) 0]
                    (loop (if (>= (load k) m)
                              (break)
                              (do
                                (let [tr (al-get [(slice u8)] (load trs) (load k))
                                      td (trait-find cx tr)]
                                  (when (!= (primitive/cast i64 td) (primitive/cast i64 0))
                                    (let [tps2 (load (field td type_params))
                                          np (al-len [(slice u8)] (load tps2))
                                          (mut p) 0]
                                      (loop (if (>= (load p) np)
                                                (break)
                                                (do
                                                  (al-push! (mut out)
                                                            (assoc-tp-name a
                                                                           (load (field bp name))
                                                                           tr
                                                                           (al-get [(slice u8)] (load tps2) (load p))))
                                                  (store! p (primitive/iadd (load p) 1))))))))
                                (set! k (primitive/iadd (load k) 1))))))
                  (set! j (primitive/iadd (load j) 1))))))
    (box-al [(slice u8)] a (load out))))

; trait type-parameter Self deferred args. `subst` maps Self -> the
; bounded param and every associated type -> its synthetic name (build-trait-subst).
(defn trait-tp-args [(a (dyn Allocator))
                     (tm (ptr TraitMethod))
                     (subst (ptr (ArrayList SubstEntry)))
                     (args (ptr (ArrayList Expr)))
                     (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))
                     (func (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [ps (load (field tm params))
        n (al-len [Expr] (load args))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [want (subst-apply a (field (al-elem [Param] ps (load i)) ty) subst)
                      wp (box-type a want)
                      ismut (is-mut-borrow (al-elem [Expr] args (load i)))
                      exp (if (= (type-tag wp) (primitive/cast i64 5)) (t-inner wp) wp)
                      what
                        (sconcat a
                                 (sconcat a
                                          (sconcat3 a "argument " (i64->str a (primitive/iadd (load i) 1)) " to '")
                                          func)
                                 "'")]
                  (match (do-synth a (al-elem [Expr] args (load i)) exp env cx tps fname)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)]
                          (set! sp sp0)
                          (match (coerce-arg a
                                             ismut
                                             (load (load (field sp e)))
                                             (load (field sp
                                                          t))
                                             wp
                                             false
                                             fname
                                             what)
                            (Err [d] (do (set! err d) (set! failed true) (break)))
                            (Ok [ce] (al-push! (mut out) ce)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Expr)) Diag] (load err)) (Ok (box-al [Expr] a (load out))))))

; non-generic call args
(defn ca-nongeneric [(a (dyn Allocator))
                     (sig (ptr Sig))
                     (args (ptr (ArrayList Expr)))
                     (func (slice u8))
                     (elo i64)
                     (ehi i64)
                     (esrc i64)
                     (ectxt i64)
                     (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [params (load (field sig params))
        nparams (al-len [Type] (load params))
        is_extern (.is_extern sig)
        n (al-len [Expr] (load args))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (>= (load i) nparams)
                    (match (do-synth a (al-elem [Expr] args (load i)) (null-type) env cx tps fname)
                      (Err [d] (do (set! err d) (set! failed true) (break)))
                      (Ok [sp0]
                          (let [sp (primitive/alloc-stack SynPair)]
                            (set! sp sp0)
                            (if (type-is-void (load (field sp t)))
                                (do
                                  (set! err
                                        (derr (sconcat3 a
                                                        "in '"
                                                        fname
                                                        "': variadic argument uses a void value (a (-> void) call yields nothing)")))
                                  (set! failed true)
                                  (break))
                                (if (= (type-tag (load (field sp t))) (primitive/cast i64 5))
                                    (let [ae (al-elem [Expr] args (load i))
                                          nm (match (.kind ae) (EVar [n] n) (_ "…"))]
                                      (do
                                        (set! err
                                              (derr-at (.lo ae)
                                                       (.hi ae)
                                                       (sconcat3 a
                                                                 (sconcat5 a
                                                                           "in '"
                                                                           fname
                                                                           "': cannot pass "
                                                                           (ty-str a (load (field sp t)))
                                                                           " to a variadic parameter — it would pass the address; write (primitive/load ")
                                                                 nm
                                                                 ") for the value")))
                                        (set! failed true)
                                        (break)))
                                    (al-push! (mut out) (load (load (field sp e)))))))))
                    (let [want (al-elem [Type] params (load i))
                          ismut (is-mut-borrow (al-elem [Expr] args (load i)))
                          exp (if (= (type-tag want) (primitive/cast i64 5)) (t-inner want) want)
                          what
                            (sconcat a
                                     (sconcat a
                                              (sconcat3 a "argument " (i64->str a (primitive/iadd (load i) 1)) " to '")
                                              func)
                                     "'")]
                      (match (do-synth a (al-elem [Expr] args (load i)) exp env cx tps fname)
                        (Err [d] (do (set! err d) (set! failed true) (break)))
                        (Ok [sp0]
                            (let [sp (primitive/alloc-stack SynPair)]
                              (set! sp sp0)
                              (match (maybe-coerce-dyn a
                                                       cx
                                                       (load (field sp e))
                                                       (load (field sp t))
                                                       want
                                                       elo
                                                       ehi
                                                       esrc
                                                       ectxt
                                                       fname)
                                (Err [d] (do (set! err d) (set! failed true) (break)))
                                (Ok [mp0]
                                    (let [mp (primitive/alloc-stack SynPair)]
                                      (set! mp mp0)
                                      (match (coerce-arg a
                                                         ismut
                                                         (load (load (field mp e)))
                                                         (load (field mp t))
                                                         want
                                                         is_extern
                                                         fname
                                                         what)
                                        (Err [d] (do (set! err d) (set! failed true) (break)))
                                        (Ok [ce] (al-push! (mut out) ce)))))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Expr)) Diag] (load err)) (Ok (box-al [Expr] a (load out))))))

; generic call. Returns the elaborated ECall as EvalPair.
(defn ca-build-arglist [(a (dyn Allocator))
                        (args (ptr (ArrayList Expr)))
                        (defs (ptr (ArrayList Deferred)))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))] (-> (ptr (ArrayList ArgSlot)))
  (let [n (al-len [Expr] (load args))
        (mut out) (al-new [ArgSlot] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [saved (al-len [EnvEntry] (load env))]
                  (match (do-synth a (al-elem [Expr] args (load i)) (null-type) env cx tps fname)
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)
                              sl (primitive/alloc-stack ArgSlot)]
                          (set! sp sp0)
                          (set! (.present sl) true)
                          (set! (.e sl) (load (field sp e)))
                          (set! (.t sl) (load (field sp t)))
                          (al-push! (mut out) (load sl))))
                    (Err [d]
                         (do
                           (env-truncate! env saved)
                           (let [sl (primitive/alloc-stack ArgSlot)
                                 df (primitive/alloc-stack Deferred)]
                             (set! (.present sl) false)
                             (set! (.e sl) (primitive/cast (ptr Expr) 0))
                             (set! (.t sl) (primitive/cast (ptr Type) 0))
                             (al-push! (mut out) (load sl))
                             (set! (.idx df) (load i))
                             (set! (.err df) d)
                             (al-push! [Deferred] defs (load df)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [ArgSlot] a (load out))))

(defn ca-check-bounds [(a (dyn Allocator))
                       (sig (ptr Sig))
                       (subst (ptr (ArrayList SubstEntry)))
                       (func (slice u8))
                       (cx (ptr Cx))
                       (fname (slice u8))] (-> (Result i64 Diag))
  (let [bounds (load (field sig bounds))
        n (al-len [Bound] (load bounds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [bp (al-elem [Bound] bounds (load i))
                      param (.name bp)
                      tyr (subst-get subst (.name bp))]
                  (when (!= (primitive/cast i64 tyr) (primitive/cast i64 0))
                    (let [trs (load (field bp traits))
                          m (al-len [(slice u8)] (load trs))
                          (mut k) 0]
                      (loop (if (>= (load k) m)
                                (break)
                                (do
                                  (let [tr (al-get [(slice u8)] (load trs) (load k))
                                        ok (impl-match a cx tr tyr)]
                                    (when (not ok)
                                      (store! err
                                              (derr (sconcat a
                                                             (sconcat a
                                                                      (sconcat a
                                                                               (sconcat a
                                                                                        (sconcat4 a
                                                                                                  "in '"
                                                                                                  fname
                                                                                                  "': '"
                                                                                                  (sconcat a
                                                                                                           (ty-str a
                                                                                                                   tyr)
                                                                                                           "' does not implement '"))
                                                                                        (display-name tr))
                                                                               "' (required by '")
                                                                      func)
                                                             (sconcat a "' bound on '" (sconcat a param "')")))))
                                      (store! failed true)
                                      (break)))
                                  (store! k (primitive/iadd (load k) 1)))))
                      0)))
                (if (load failed) (break) (set! i (primitive/iadd (load i) 1))))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn ca-resynth-deferred [(a (dyn Allocator))
                           (defs (ptr (ArrayList Deferred)))
                           (argl (ptr (ArrayList ArgSlot)))
                           (sig (ptr Sig))
                           (subst (ptr (ArrayList SubstEntry)))
                           (args (ptr (ArrayList Expr)))
                           (env (ptr (ArrayList EnvEntry)))
                           (cx (ptr Cx))
                           (tps (ptr (ArrayList (slice u8))))
                           (fname (slice u8))] (-> (Result i64 Diag))
  (let [params (subst-apply-list a (load (field sig params)) subst)
        n (al-len [Deferred] (load defs))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [df (al-elem [Deferred] defs (load i))
                      idx (.idx df)
                      want (load (al-elem [Type] params idx))
                      wp (box-type a want)]
                  (try (let [sp0
                               (try-or! (do-synth a (al-elem [Expr] args idx) wp env cx tps fname)
                                        (do (store! err (load (field df err))) (store! failed true) (break)))]
                         (let [sp (primitive/alloc-stack SynPair)
                               sl (al-elem [ArgSlot] argl idx)]
                           (store! sp sp0)
                           (store! (field sl present) true)
                           (store! (field sl e) (load (field sp e)))
                           (store! (field sl t) (load (field sp t)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn ca-final-coerce [(a (dyn Allocator))
                       (argl (ptr (ArrayList ArgSlot)))
                       (sig (ptr Sig))
                       (subst (ptr (ArrayList SubstEntry)))
                       (args (ptr (ArrayList Expr)))
                       (func (slice u8))
                       (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [params (subst-apply-list a (load (field sig params)) subst)
        is_extern (.is_extern sig)
        n (al-len [Expr] (load args))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [sl (al-elem [ArgSlot] argl (load i))
                      want (load (al-elem [Type] params (load i)))
                      wp (box-type a want)
                      ismut (is-mut-borrow (al-elem [Expr] args (load i)))
                      what
                        (sconcat a
                                 (sconcat a
                                          (sconcat3 a "argument " (i64->str a (primitive/iadd (load i) 1)) " to '")
                                          func)
                                 "'")]
                  (match (coerce-arg a
                                     ismut
                                     (load (load (field sl e)))
                                     (load (field sl
                                                  t))
                                     wp
                                     is_extern
                                     fname
                                     what)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [ce] (al-push! (mut out) ce))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Expr)) Diag] (load err)) (Ok (box-al [Expr] a (load out))))))

(defn method-index-of [(td (ptr TraitDef)) (func (slice u8))] (-> i64)
  (let [ms (load (field td methods))
        n (al-len [TraitMethod] (load ms))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [TraitMethod] ms (load i)) name)) func)
                  (store! r
                          (load i))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn dyn-dispatch-args [(a (dyn Allocator))
                         (tm (ptr TraitMethod))
                         (self_idx i64)
                         (func (slice u8))
                         (args (ptr (ArrayList Expr)))
                         (env (ptr (ArrayList EnvEntry)))
                         (cx (ptr Cx))
                         (tps (ptr (ArrayList (slice u8))))
                         (fname (slice u8))
                         (elo i64)
                         (ehi i64)
                         (esrc i64)
                         (ectxt i64)
                         (params (ptr (ArrayList Type)))
                         (newargs (ptr (ArrayList Expr)))] (-> (Result i64 Diag))
  (let [ps (load (field tm params))
        n (al-len [Expr] (load args))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (unless (= (load i) self_idx)
                  (let [raw (field (al-elem [Param] ps (load i)) ty)
                        want (box-type a (param-ref-type cx raw tps))
                        exp (if (= (type-tag raw) (primitive/cast i64 5)) (t-inner raw) raw)
                        ismut (is-mut-borrow (al-elem [Expr] args (load i)))
                        what (sconcat1 a (sconcat3 a "argument to '" func "'"))]
                    (match (do-synth a (al-elem [Expr] args (load i)) exp env cx tps fname)
                      (Err [d] (do (store! err d) (store! failed true) (break)))
                      (Ok [sp0]
                          (let [sp (primitive/alloc-stack SynPair)]
                            (store! sp sp0)
                            (match (maybe-coerce-dyn a
                                                     cx
                                                     (load (field sp e))
                                                     (load (field sp t))
                                                     raw
                                                     elo
                                                     ehi
                                                     esrc
                                                     ectxt
                                                     fname)
                              (Err [d] (do (store! err d) (store! failed true) (break)))
                              (Ok [mp0]
                                  (let [mp (primitive/alloc-stack SynPair)]
                                    (store! mp mp0)
                                    (match (coerce-arg a
                                                       ismut
                                                       (load (load (field mp e)))
                                                       (load (field mp t))
                                                       want
                                                       false
                                                       fname
                                                       what)
                                      (Err [d] (do (store! err d) (store! failed true) (break)))
                                      (Ok [ce]
                                          (do
                                            (al-push! [Expr] newargs ce)
                                            (al-push! [Type] params (erase-refs a want))
                                            0)))))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn synth-dyn-dispatch [(a (dyn Allocator))
                          (cx (ptr Cx))
                          (func (slice u8))
                          (self_name (slice u8))
                          (self_idx i64)
                          (td (ptr TraitDef))
                          (tm (ptr TraitMethod))
                          (args (ptr (ArrayList Expr)))
                          (env (ptr (ArrayList EnvEntry)))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))
                          (elo i64)
                          (ehi i64)
                          (esrc i64)
                          (ectxt i64)] (-> (Result EvalPair Diag))
  (let [mi (method-index-of td func)
        dyn_ty (box-type a (TStruct self_name))]
    (match (do-synth a (al-elem [Expr] args self_idx) dyn_ty env cx tps fname)
      (Err [d] (err-ep d))
      (Ok [rsp0]
          (let [rsp (primitive/alloc-stack SynPair)]
            (set! rsp rsp0)
            (match (coerce a
                           (load (load (field rsp e)))
                           (load (field rsp t))
                           dyn_ty
                           false
                           fname
                           "trait-object receiver")
              (Err [d] (err-ep d))
              (Ok [recv]
                  (let [params (box-al [Type] a (al-new [Type] a))
                        newargs (box-al [Expr] a (al-new [Expr] a))]
                    (al-push! [Type] params (TPtr (box-type a (TInt 8 false))))
                    (match (dyn-dispatch-args a
                                              tm
                                              self_idx
                                              func
                                              args
                                              env
                                              cx
                                              tps
                                              fname
                                              elo
                                              ehi
                                              esrc
                                              ectxt
                                              params
                                              newargs)
                      (Err [d] (err-ep d))
                      (Ok [_]
                          (let [vtable_struct
                                  (sconcat a
                                           (subslice [u8] self_name 0 (primitive/isub (slice-len [u8] self_name) 4))
                                           "-vtable")]
                            (ok-ep (mk-expr (EDynDispatch
                                              :dyn_struct self_name
                                              :vtable_struct vtable_struct
                                              :method_index mi
                                              :cc "c"
                                              :params params
                                              :ret (.ret tm)
                                              :recv (box-expr a recv)
                                              :args newargs)
                                            elo
                                            ehi
                                            esrc
                                            ectxt)
                                   (.ret tm)))))))))))))

(defn synth-call-general [(a (dyn Allocator))
                          (func (slice u8))
                          (call_func (slice u8))
                          (type_args (ptr (ArrayList Type)))
                          (args (ptr (ArrayList Expr)))
                          (expected (ptr Type))
                          (env (ptr (ArrayList EnvEntry)))
                          (cx (ptr Cx))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))
                          (elo i64)
                          (ehi i64)
                          (esrc i64)
                          (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [sig (sig-find cx call_func)]
           (when (= (primitive/cast i64 sig) (primitive/cast i64 0))
             (break :try (err-ep (derr (undefined-call-msg a cx fname func)))))
           (let [nparams (al-len [Type] (load (field sig params)))
                 nargs (al-len [Expr] (load args))
                 variadic (load (field sig variadic))
                 pack_idx (list-pack-index (load (field sig params)))
                 arity_ok
                   (if variadic
                       (>= nargs nparams)
                       (if (>= pack_idx 0) (>= nargs (primitive/isub nparams 1)) (= nargs nparams)))]
             (when (not arity_ok)
               ; If a trait method shares this function's simple name, say so —
               ; the arity-directed fallback rescues arity MISmatches, so getting
               ; here with a colliding method in scope means the arities tie (or
               ; another path bypassed the dispatch), and `Trait::method` is the
               ; explicit spelling that resolves it.
               (let [simple (after-last-dot func)
                     coll (if (methods-has cx simple) (method-trait-of cx simple) "")
                     hint
                       (if (= (slice-len [u8] coll) (primitive/cast i64 0))
                           ""
                           (sconcat a
                                    (sconcat4 a
                                              "; trait '"
                                              (display-name coll)
                                              "' also declares '"
                                              (sconcat a simple "' — write "))
                                    (sconcat3 a (after-last-dot coll) "::" (sconcat a simple " to call it"))))]
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat a
                                                          (sconcat a
                                                                   (sconcat a
                                                                            (sconcat4 a
                                                                                      "in '"
                                                                                      fname
                                                                                      "': '"
                                                                                      (sconcat a func "' expects "))
                                                                            (if variadic "at least " ""))
                                                                   (i64->str a nparams))
                                                          (sconcat a " args, got " (i64->str a nargs)))
                                                 hint))))))
             (if (= (al-len [(slice u8)] (load (field sig type_params))) (primitive/cast i64 0))
                 (do
                   (when (> (al-len [Type] (load type_args)) (primitive/cast i64 0))
                     (break :try
                              (err-ep (derr (sconcat1 a
                                                      (sconcat5 a
                                                                "in '"
                                                                fname
                                                                "': '"
                                                                func
                                                                "' is not generic but got type arguments"))))))
                   (let [new_args (try! (ca-nongeneric a sig args func elo ehi esrc ectxt env cx tps fname))]
                     (return-from :try
                                    (ok-ep (mk-expr (ECall
                                                      :func call_func
                                                      :type_args (box-items-type a)
                                                      :args new_args)
                                                    elo
                                                    ehi
                                                    esrc
                                                    ectxt)
                                           (load (field sig ret))))))
                 (let [defs (box-al [Deferred] a (al-new [Deferred] a))
                       argl (ca-build-arglist a args defs env cx tps fname)
                       subst
                         (try! (solve-type-args a
                                                (load (field sig type_params))
                                                (load (field sig params))
                                                type_args
                                                argl
                                                (field sig ret)
                                                expected
                                                cx
                                                tps
                                                fname
                                                func))]
                   (try! (ca-check-bounds a sig subst func cx fname))
                   (try! (ca-resynth-deferred a defs argl sig subst args env cx tps fname))
                   (let [new_args (try! (ca-final-coerce a argl sig subst args func fname))
                         out_targs (subst-targs a (load (field sig type_params)) subst)
                         ret (subst-apply a (field sig ret) subst)]
                     ; call_func, not func: a trait-method call on a concrete receiver
                     ; was rewritten to the impl's lowered function — GENERIC for a
                     ; generic impl, so it lands here.
                     (ok-ep (mk-expr (ECall
                                       :func call_func
                                       :type_args out_targs
                                       :args new_args)
                                     elo
                                     ehi
                                     esrc
                                     ectxt)
                            ret)))))))))

(defn synth-inherent-general [(a (dyn Allocator))
                              (func (slice u8))
                              (call-func (slice u8))
                              (type-args (ptr (ArrayList Type)))
                              (args (ptr (ArrayList Expr)))
                              (expected (ptr Type))
                              (env (ptr (ArrayList EnvEntry)))
                              (cx (ptr Cx))
                              (tps (ptr (ArrayList (slice u8))))
                              (fname (slice u8))
                              (elo i64)
                              (ehi i64)
                              (esrc i64)
                              (ectxt i64)] (-> (Result (Option EvalPair) Diag))
  (match (synth-call-general a func call-func type-args args expected env cx tps fname elo ehi esrc ectxt)
    (Err [d] (Err [(Option EvalPair) Diag] d))
    (Ok [ep] (Ok [(Option EvalPair) Diag] (Some [EvalPair] ep)))))

; Try inherent dispatch without stealing ordinary or trait calls. A qualified
; `Type::name` first considers receiverless associated functions, then receiver
; methods. A bare `name` considers receiver methods only and infers the owner from
; argument zero. None means "not an inherent call" and the existing trait/general
; resolution continues unchanged.
(defn synth-inherent-call [(a (dyn Allocator))
                           (func (slice u8))
                           (mname (slice u8))
                           (qual (slice u8))
                           (qualified bool)
                           (type-args (ptr (ArrayList Type)))
                           (args (ptr (ArrayList Expr)))
                           (expected (ptr Type))
                           (env (ptr (ArrayList EnvEntry)))
                           (cx (ptr Cx))
                           (tps (ptr (ArrayList (slice u8))))
                           (fname (slice u8))
                           (elo i64)
                           (ehi i64)
                           (esrc i64)
                           (ectxt i64)] (-> (Result (Option EvalPair) Diag))
  (try (do
         (when qualified
           (let [asel (primitive/alloc-stack ImplSel)]
             (store! asel (inherent-associated-select a cx mname qual))
             (when (load (field asel ambiguous))
               (break :try
                        (Err [(Option EvalPair) Diag]
                             (derr (sconcat a
                                            (sconcat5 a
                                                      "in '"
                                                      fname
                                                      "': inherent method qualifier '"
                                                      qual
                                                      "' is ambiguous for '")
                                            (sconcat a mname "'"))))))
             (let [aip (load (field asel ip))]
               (unless (= (primitive/cast i64 aip) (primitive/cast i64 0))
                 (return-from :try
                                (synth-inherent-general a
                                                        func
                                                        (inherent-fn-name a aip mname)
                                                        type-args
                                                        args
                                                        expected
                                                        env
                                                        cx
                                                        tps
                                                        fname
                                                        elo
                                                        ehi
                                                        esrc
                                                        ectxt))))))
         (when (and (> (al-len [Expr] (load args)) (primitive/cast i64 0)) (inherent-has-name cx mname))
           (let [sp0 (try! (do-synth a (al-elem [Expr] args 0) (null-type) env cx tps fname))
                 sp (primitive/alloc-stack SynPair)]
             (store! sp sp0)
             (let [recv (load (field sp t))
                   sel (primitive/alloc-stack ImplSel)]
               (store! sel (inherent-select-deref a cx mname (if qualified qual "") recv))
               (when (load (field sel ambiguous))
                 (break :try
                          (Err [(Option EvalPair) Diag]
                               (derr (sconcat a
                                              (sconcat5 a "in '" fname "': ambiguous inherent method '" mname "' for '")
                                              (sconcat a (ty-str a recv) "'"))))))
               (let [ip (load (field sel ip))]
                 (unless (= (primitive/cast i64 ip) (primitive/cast i64 0))
                   (return-from :try
                                  (synth-inherent-general a
                                                          func
                                                          (inherent-fn-name a ip mname)
                                                          type-args
                                                          args
                                                          expected
                                                          env
                                                          cx
                                                          tps
                                                          fname
                                                          elo
                                                          ehi
                                                          esrc
                                                          ectxt)))))))
         (Ok [(Option EvalPair) Diag] (None [EvalPair])))))

; A symbol in call-head position may name a value instead of a global function.
; Find an ordinary trait impl that defines `call`, prepend the receiver, and lower
; directly to that impl method. No trait name or namespace is privileged here.
(defn synth-callable-value [(a (dyn Allocator))
                            (name (slice u8))
                            (args (ptr (ArrayList Expr)))
                            (expected (ptr Type))
                            (env (ptr (ArrayList EnvEntry)))
                            (cx (ptr Cx))
                            (tps (ptr (ArrayList (slice u8))))
                            (fname (slice u8))
                            (elo i64)
                            (ehi i64)
                            (esrc i64)
                            (ectxt i64)] (-> (Result EvalPair Diag))
  (try (let [head (box-expr a (mk-expr (EVar name) elo ehi esrc ectxt))
             hsp0 (try! (do-synth a head (null-type) env cx tps fname))
             hsp (primitive/alloc-stack SynPair)]
         (store! hsp hsp0)
         (let [recv (load (field hsp t))
               traits (field cx trait_defs)
               nt (al-len [TraitDef] (load traits))
               (mut ti) 0
               (mut found) (primitive/cast (ptr ImplDef) 0)
               (mut ambiguous) false]
           (loop (if (>= (load ti) nt)
                     (break)
                     (do
                       (let [tr0 (load (field (al-elem [TraitDef] traits (load ti)) name))
                             self0 (deref-to-impl a cx tr0 recv tps)
                             sel0 (primitive/alloc-stack ImplSel)]
                         (store! sel0 (cx-impl-select a cx tr0 self0))
                         (let [ip0 (load (field sel0 ip))]
                           (when (and (!= (primitive/cast i64 ip0) (primitive/cast i64 0))
                                      (!= (primitive/cast i64 (impl-find-method ip0 "call")) (primitive/cast i64 0)))
                             (if (= (primitive/cast i64 (load found)) (primitive/cast i64 0))
                                 (store! found ip0)
                                 (when (!= (primitive/cast i64 (load found)) (primitive/cast i64 ip0))
                                   (store! ambiguous true))))))
                       (store! ti (primitive/iadd (load ti) 1)))))
           (when (= (primitive/cast i64 (load found)) (primitive/cast i64 0))
             (break :try
                      (err-ep (derr (if (shadowed-call? esrc elo)
                                        (sconcat a
                                                 (sconcat4 a "in '" fname "': '" name)
                                                 "' is a local binding here, so it names the local rather than the macro of that name; the local is not callable")
                                        (sconcat a
                                                 (sconcat4 a "in '" fname "': value of type '" (ty-str a recv))
                                                 "' is not callable"))))))
           (when (load ambiguous)
             (break :try
                      (err-ep (derr (sconcat a
                                             (sconcat4 a
                                                       "in '"
                                                       fname
                                                       "': ambiguous call implementations for '"
                                                       (ty-str a recv))
                                             "'")))))
           (let [ip (load found)
                 tr (impl-trait-name ip)
                 method (impl-find-method ip "call")]
             (let [(mut all) (al-new [Expr] a)
                   n (al-len [Expr] (load args))
                   (mut i) 0]
               (al-push! (mut all) (load (load (field hsp e))))
               (loop (if (>= (load i) n)
                         (break)
                         (do
                           (al-push! (mut all) (al-get [Expr] (load args) (load i)))
                           (store! i (primitive/iadd (load i) 1)))))
               (synth-call-general a
                                   name
                                   (tmfn a
                                         tr
                                         (impl-mangle-key a
                                                          (field ip self_type)
                                                          (load (field ip type_params)))
                                         "call")
                                   (box-items-type a)
                                   (box-al [Expr] a (load all))
                                   expected
                                   env
                                   cx
                                   tps
                                   fname
                                   elo
                                   ehi
                                   esrc
                                   ectxt)))))))

(defn synth-call [(a (dyn Allocator))
                  (func (slice u8))
                  (nid i64)
                  (type_args (ptr (ArrayList Type)))
                  (args (ptr (ArrayList Expr)))
                  (expected (ptr Type))
                  (env (ptr (ArrayList EnvEntry)))
                  (cx (ptr Cx))
                  (tps (ptr (ArrayList (slice u8))))
                  (fname (slice u8))
                  (elo i64)
                  (ehi i64)
                  (esrc i64)
                  (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         ; Locals shadow global function names in call-head position. A global
         ; const is also a value head when no local of that name exists.
         (when (or (!= (primitive/cast i64 (env-get env func)) (primitive/cast i64 0))
                   (and (= (primitive/cast i64 (sig-find cx func)) (primitive/cast i64 0))
                        (!= (primitive/cast i64 (const-find cx func)) (primitive/cast i64 0))))
           (return-from :try (synth-callable-value a func args expected env cx tps fname elo ehi esrc ectxt)))
         (when (!= (primitive/cast i64 (vts-find cx func)) (primitive/cast i64 0))
           (break :try (synth-construct a func type_args args expected env cx tps fname elo ehi esrc ectxt)))
         ; A `Trait::method` head (gen-6) splits into the qualifier and the bare method
         ; name; `resolve-method-qual` then pins dispatch to the named trait. A plain call
         ; has no `::`, so `qual` is "" and `mname` is `func` — the original path, unchanged.
         (let [cc (find-coloncolon func)
               ;; A head may reach here in three shapes, and all three name the same
               ;; thing when the tail is a trait method:
               ;;
               ;;   =                 bare — resolved from the use site's scope
               ;;   Eq::=             explicit trait qualifier (gen-6)
               ;;   coil.core.=       MODULE-qualified, written by macro hygiene
               ;;
               ;; The third is new. Referential hygiene qualifies a macro template's
               ;; symbols to the macro's own module so they cannot be captured by the
               ;; caller, and trait methods must take part in that like every other
               ;; name — otherwise a template's `(= x y)` binds to whatever `=` the
               ;; CALLER happens to have, which is how `(assert-eq 1 999)` came to
               ;; pass. See docs/design/TRAIT_METHOD_HYGIENE.md.
               ;;
               ;; Splitting on the last dot recovers the method name. The prefix is a
               ;; MODULE, not a trait, so it is deliberately NOT used as `qual` —
               ;; that would ask "which trait is named coil.core?" and find none.
               ;; Which impl runs is still decided by the argument's type below; this
               ;; only recovers which NAME was meant.
               dotted-m (if (>= cc (primitive/cast i64 0)) "" (after-last-dot func))
               ;; …but a dotted head that names a REAL function or extern is a
               ;; RESOLVER-qualified reference, not a hygiene-qualified method.
               ;; `coil.io.read` (the POSIX extern, qualified by resolve inside
               ;; coil.io itself) must stay a function call even when some
               ;; unrelated module declares a trait method named `read` — without
               ;; this guard that program stopped compiling with an arity error
               ;; from the hijacked trait. A hygiene-qualified method never
               ;; collides here: `coil.core.=` names no defn or extern, so
               ;; sig-find misses and the method interpretation proceeds.
               dotted?
                 (and (< cc (primitive/cast i64 0))
                      (and (!= (slice-len [u8] dotted-m) (slice-len [u8] func))
                           (and (methods-has cx dotted-m)
                                (= (primitive/cast i64 (sig-find cx func))
                                   (primitive/cast i64 0)))))
               ;; The ARITY-DIRECTED FALLBACK — the same guard's other direction.
               ;; The head names a real function, but that function cannot take
               ;; this many arguments, and a declared trait method with the same
               ;; simple name can. The canonical collision is POSIX names:
               ;; `(read c)` in a module whose trait declares a 1-arg `read`,
               ;; while `:use *` of coil.io resolver-qualified the head to the
               ;; 3-arg extern. The function still wins whenever its arity fits,
               ;; so no compiling program changes meaning — only calls that were
               ;; hard arity errors gain the method reading. WHICH trait, and
               ;; whether the use site really has it in scope, is judged by the
               ;; ordinary method-resolution path this routes into. And it only
               ;; applies when the RESOLVER wrote the qualification: a user who
               ;; typed `(coil.io.read c)` or `(io/read c)` named that function
               ;; explicitly, so a wrong arity there stays a hard error
               ;; (head-was-implicit?, recorded at the resolver's ECall rewrite).
               arity-fb?
                 (and (< cc (primitive/cast i64 0))
                      (and (not dotted?)
                           (and (!= (slice-len [u8] dotted-m) (slice-len [u8] func))
                                (and (methods-has cx dotted-m)
                                     (let [sg (sig-find cx func)]
                                       (and (!= (primitive/cast i64 sg) (primitive/cast i64 0))
                                            (and (not (sig-arity-ok? sg (al-len [Expr] (load args))))
                                                 (and (method-arity-matches? cx
                                                                             dotted-m
                                                                             (al-len [Expr] (load args)))
                                                      (head-was-implicit? nid)))))))))
               ;; The module prefix DISAMBIGUATES. `MethodEntry.trait` is the fully
               ;; qualified trait name (`hyglib5.Mine`), so a head of
               ;; `hyglib5.mine` selects the trait declared in that module — which
               ;; is exactly what lexical scope should mean: the macro's module
               ;; decides which trait its template named, even when the caller has
               ;; a same-named method of its own in scope. Without this the call is
               ;; reported ambiguous, which is the old capture bug wearing a
               ;; diagnostic instead of silently choosing wrong.
               ;; NOT set for arity-fb?: there the prefix names the module of the
               ;; FUNCTION the call is falling away from, which must not steer
               ;; trait selection — the use site's ordinary scope decides.
               dotted-mod
                 (if dotted?
                     (subslice [u8]
                               func
                               0
                               (primitive/isub (slice-len [u8] func)
                                               (primitive/iadd (slice-len [u8] dotted-m) 1)))
                     "")
               qual (if (>= cc (primitive/cast i64 0)) (subslice [u8] func 0 cc) "")
               mname
                 (if (>= cc (primitive/cast i64 0))
                     (subslice [u8] func (primitive/iadd cc 2) (slice-len [u8] func))
                     (if (or dotted? arity-fb?) dotted-m func))
               (mut call_func) func]
           (let [inh
                   (try! (synth-inherent-call a
                                              func
                                              mname
                                              qual
                                              (>= cc (primitive/cast i64 0))
                                              type_args
                                              args
                                              expected
                                              env
                                              cx
                                              tps
                                              fname
                                              elo
                                              ehi
                                              esrc
                                              ectxt))]
             (match inh
               (Some [ep] (return-from :try (Ok [EvalPair Diag] ep)))
               (None [] 0)))
           (if (methods-has cx mname)
               (let [me0 (try! (resolve-method-mod a cx mname qual dotted-mod fname))
                     me (primitive/alloc-stack MethodEntry)]
                 (store! me me0)
                 (let [trait_name (load (field me trait))
                       self_idx (load (field me self_idx))
                       td (trait-find cx (load (field me trait)))
                       tm (trait-method-find (trait-find cx (load (field me trait))) mname)
                       self_pname (load (field td self_param))]
                   (when (not (= (al-len [Expr] (load args))
                                 (al-len [Param]
                                         (load (field tm
                                                      params)))))
                     (break :try
                              (err-ep (derr (sconcat a
                                                     (sconcat a
                                                              (sconcat a
                                                                       (sconcat4 a
                                                                                 "in '"
                                                                                 fname
                                                                                 "': '"
                                                                                 (sconcat a mname "' expects "))
                                                                       (i64->str a
                                                                                 (al-len [Param]
                                                                                         (load (field tm
                                                                                                      params)))))
                                                              " args, got ")
                                                     (i64->str a (al-len [Expr] (load args))))))))
                   (let [selfsp (try! (do-synth a (al-elem [Expr] args self_idx) (null-type) env cx tps fname))
                         ssp (primitive/alloc-stack SynPair)]
                     (store! ssp selfsp)
                     (let [self_ty (deref-to-impl a cx trait_name (load (field ssp t)) tps)]
                       (when (not (has-impl-name a self_ty))
                         (break :try
                                  (err-ep (derr (sconcat a
                                                         (sconcat a
                                                                  (sconcat4 a
                                                                            "in '"
                                                                            fname
                                                                            "': trait method '"
                                                                            (sconcat a
                                                                                     mname
                                                                                     "' called on a type that can't carry an impl: "))
                                                                  (ty-str a self_ty))
                                                         "")))))
                       (let [self_name (type-impl-name a self_ty)]
                         (when (> (slice-len [u8] (dyn-struct-trait cx self_name)) (primitive/cast i64 0))
                           (break :try
                                    (synth-dyn-dispatch a
                                                        cx
                                                        mname
                                                        self_name
                                                        self_idx
                                                        td
                                                        tm
                                                        args
                                                        env
                                                        tps
                                                        fname
                                                        elo
                                                        ehi
                                                        esrc
                                                        ectxt)))
                         (if (set-contains tps self_name)
                             ; Self is a type parameter: a DEFERRED trait call. The bound must
                             ; carry the trait (definition-time check). A parameterized trait's
                             ; extra params become associated types (build-trait-subst); the
                             ; method sig, substituted, types the call — mono resolves it to the
                             ; impl once Self is concrete.
                             (if (not (bounds-has (field cx cur_bounds) self_name trait_name))
                                 (return-from :try
                                                (err-ep (derr (sconcat a
                                                                       (sconcat a
                                                                                (sconcat a
                                                                                         (sconcat4 a
                                                                                                   "in '"
                                                                                                   fname
                                                                                                   "': type parameter '"
                                                                                                   (sconcat a
                                                                                                            self_name
                                                                                                            "' is not bounded by '"))
                                                                                         (display-name trait_name))
                                                                                "' (required to call '")
                                                                       (sconcat a mname "')")))))
                                 (let [subst (build-trait-subst a self_pname self_name trait_name td)
                                       new_args (try! (trait-tp-args a tm subst args env cx tps fname mname))
                                       ret (subst-apply a (field tm ret) subst)]
                                   (return-from :try
                                                  (ok-ep (mk-expr (ETraitCall
                                                                    :trait_name trait_name
                                                                    :method mname
                                                                    :self_tp self_name
                                                                    :args new_args)
                                                                  elo
                                                                  ehi
                                                                  esrc
                                                                  ectxt)
                                                         ret))))
                             ; Pick the most specific impl accepting this receiver, and call
                             ; THAT impl's function. Errors name the RECEIVER TYPE, not the
                             ; dispatch key: selection matches type arguments, so `(Pair u8 bool)`
                             ; can fail while `(Pair i64 i64)` succeeds — "'app.Pair' does not
                             ; implement" would be a lie in exactly the case this catches.
                             (let [sel (primitive/alloc-stack ImplSel)]
                               (store! sel (cx-impl-select a cx trait_name self_ty))
                               (when (= (primitive/cast i64 (load (field sel ip))) (primitive/cast i64 0))
                                 (break :try
                                          (err-ep (derr (sconcat a
                                                                 (sconcat a
                                                                          (sconcat5 a
                                                                                    "in '"
                                                                                    fname
                                                                                    "': '"
                                                                                    (ty-str a self_ty)
                                                                                    "' does not implement '")
                                                                          (display-name trait_name))
                                                                 "'")))))
                               (when (load (field sel ambiguous))
                                 (break :try
                                          (err-ep (derr (sconcat a
                                                                 (sconcat a
                                                                          (sconcat5 a
                                                                                    "in '"
                                                                                    fname
                                                                                    "': ambiguous impls of '"
                                                                                    (display-name trait_name)
                                                                                    "' for '")
                                                                          (ty-str a self_ty))
                                                                 "' — several match and none is more specific")))))
                               (let [ipp (load (field sel ip))]
                                 (let [impl-source
                                         (impl-mangle-key a
                                           (field ipp self_type)
                                           (load (field ipp type_params)))
                                       generated
                                         (tmfn a trait_name impl-source mname)]
                                   (store! call_func generated)
                                   (checker-trait-use-record! cx fname trait_name
                                     impl-source mname generated)
                                   0)))))))))
               ; `mname` is neither an inherent nor trait method. A bare call falls
               ; through to the general path; a qualified head promised a method.
               (when (>= cc (primitive/cast i64 0))
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat5 a "in '" fname "': '" func "' names no trait method '")
                                                 (sconcat3 a mname "' or inherent method '" (sconcat a mname "'"))))))))
           (synth-call-general a func (load call_func) type_args args expected env cx tps fname elo ehi esrc ectxt)))))

; ELet
(defn mk-bind [(name (slice u8)) (mutable bool) (value Expr)] (-> Bind)
  (let [p (primitive/alloc-stack Bind)]
    (set! (.name p) name)
    (set! (.mutable p) mutable)
    (set! (.value p) value)
    (set! (.bid p) 0)
    (set! (.owned_type p) (primitive/cast (ptr Type) 0))
    (load p)))

; Materialize one owning aggregate binding in its own frame slot. `value` is a
; by-value expression; for a move from an existing place it is an ELoad of that
; place, which the affine pass recognizes as the ownership transfer. The local
; remains represented as a TRef place for field access and eventual in-place drop.
(defn bind-owned-place! [(a (dyn Allocator))
                         (name (slice u8))
                         (mutable bool)
                         (value Expr)
                         (ty (ptr Type))
                         (is_owner bool)
                         (nbinds (ptr (ArrayList Bind)))
                         (env (ptr (ArrayList EnvEntry)))
                         (elo i64)
                         (ehi i64)
                         (esrc i64)
                         (ectxt i64)] (-> i64)
  (let [slot (sconcat a name ".slot")
        bid (env-insert! env name (box-type a (TRef mutable (box-type a (load ty)))))
        (mut initdo) (al-new [Expr] a)]
    (al-push! (mut initdo)
              (mk-expr (EStore (box-expr a (mk-expr (EVar slot) elo ehi esrc ectxt))
                               (box-expr a value))
                       elo
                       ehi
                       esrc
                       ectxt))
    (al-push! (mut initdo) (mk-expr (EVar slot) elo ehi esrc ectxt))
    (al-push! [Bind]
              nbinds
              (mk-bind slot
                       false
                       (mk-expr (EAlloc 3 (erase-refs a ty) (primitive/cast (ptr Expr) 0))
                                elo
                                ehi
                                esrc
                                ectxt)))
    (let [owned (primitive/alloc-stack Bind)]
      (set! owned
            (mk-bind name
                     false
                     (mk-expr (EDo (box-al [Expr] a (load initdo))) elo ehi esrc ectxt)))
      (set! (.bid owned) bid)
      (set! (.owned_type owned)
            (if is_owner (box-type a (load ty)) (primitive/cast (ptr Type) 0)))
      (al-push! [Bind] nbinds (load owned)))
    0))

(defn synth-let-body [(a (dyn Allocator))
                      (body (ptr (ArrayList Expr)))
                      (expected (ptr Type))
                      (out (ptr (ArrayList Expr)))
                      (env (ptr (ArrayList EnvEntry)))
                      (cx (ptr Cx))
                      (tps (ptr (ArrayList (slice u8))))
                      (fname (slice u8))
                      (what (slice u8))] (-> (Result Type Diag))
  ; An EMPTY body has type void, not i64. The old `(TInt 64 true)` default was
  ; never overwritten when n = 0, so `(do)` silently typed as i64 and a function
  ; declared `(-> i64)` with an empty body passed the return check and returned
  ; whatever was in the return register. void makes the mismatch a type error and
  ; makes an empty body legal exactly where it is meaningful — a `(-> void)` fn.
  (let [n (al-len [Expr] (load body))
        (mut i) 0
        (mut last) (TVoid)
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (if (= (primitive/iadd (load i) 1) n)
                    (if (expected-some? expected)
                        (match (check-to a (al-elem [Expr] body (load i)) expected env cx tps fname what)
                          (Err [d] (do (set! err d) (set! failed true) (break)))
                          (Ok [ce] (do (al-push! [Expr] out ce) (set! last (load expected)) 0)))
                        (match (do-synth a (al-elem [Expr] body (load i)) (null-type) env cx tps fname)
                          (Err [d] (do (set! err d) (set! failed true) (break)))
                          (Ok [sp0]
                              (let [sp (primitive/alloc-stack SynPair)]
                                (set! sp sp0)
                                (set! last (load (load (field sp t))))
                                (al-push! [Expr] out (load (load (field sp e))))))))
                    (match (do-synth a (al-elem [Expr] body (load i)) (null-type) env cx tps fname)
                      (Err [d] (do (set! err d) (set! failed true) (break)))
                      (Ok [sp0]
                          (let [sp (primitive/alloc-stack SynPair)]
                            (set! sp sp0)
                            (al-push! [Expr] out (load (load (field sp e))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [Type Diag] (load err)) (Ok (load last)))))

; The let body's tail variable — if the body's last expression is a bare `(EVar nm)`
; and the let has an expected type, that binding IS the let's result, so its value can
; be checked against the expected type. "" when there is no such tail or no expectation.
(defn let-tail-var [(body (ptr (ArrayList Expr))) (expected (ptr Type))] (-> (slice u8))
  (if (not (expected-some? expected))
      ""
      (let [l (al-last-expr body)]
        (if (= (primitive/cast i64 l) (primitive/cast i64 0))
            ""
            (match (.kind l) (EVar [nm] nm) (_ ""))))))

; Synthesize a let binding's value. Try WITHOUT an expectation first — every value that
; already infers is checked exactly as before, so nothing that compiled changes. Only if
; that STRANDS inference (an Err) and this binding is the let's returned tail (`bexp` is
; the let's expected type, else null) do we retry with the expected type, letting a type
; argument flow BACK from the return position (gen-9: `(let [r (Okk 5)] r)` returned as a
; `(Result i64 E)` — E is undetermined at the binding but fixed by the return).
(defn synth-bind-value [(a (dyn Allocator))
                        (bp (ptr Bind))
                        (bexp (ptr Type))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))] (-> (Result SynPair Diag))
  (match (do-synth a (field bp value) (null-type) env cx tps fname)
    (Ok [vsp] (Ok [SynPair Diag] vsp))
    (Err [d0]
         (if (expected-some? bexp)
             (try (let [vsp (try-or! (do-synth a (field bp value) bexp env cx tps fname) (Err [SynPair Diag] d0))]
                    (Ok [SynPair Diag] vsp)))
             (Err [SynPair Diag] d0)))))

(defn take-binding-value? [(value (ptr Expr))] (-> bool)
  (match (.kind value)
    (ECall [func _ _]
           (or (= func "take!")
               (or (= func "coil.core.take!")
                   (starts-with func "coil.core.take!__"))))
    (_ false)))

(defn checked-take-in-list? [(items (ptr (ArrayList Expr))) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (checked-take-value? (al-elem [Expr] items i))
          true
          (checked-take-in-list? items (+ i 1) n))))

(defn checked-take-value? [(value (ptr Expr))] (-> bool)
  (match (.kind value)
    (ECall [func _ _]
           (or (= func "take!")
               (or (= func "coil.core.take!")
                   (starts-with func "coil.core.take!__"))))
    (EDo [items]
         (checked-take-in-list? items 0 (al-len [Expr] (load items))))
    (EStore [_ inner] (checked-take-value? inner))
    (EInitStore [_ inner] (checked-take-value? inner))
    (ESpillRef [inner] (checked-take-value? inner))
    (_ false)))

(defn process-let-bind [(a (dyn Allocator))
                        (bp (ptr Bind))
                        (bexp (ptr Type))
                        (nbinds (ptr (ArrayList Bind)))
                        (env (ptr (ArrayList EnvEntry)))
                        (cx (ptr Cx))
                        (tps (ptr (ArrayList (slice u8))))
                        (fname (slice u8))
                        (elo i64)
                        (ehi i64)
                        (esrc i64)
                        (ectxt i64)] (-> (Result i64 Diag))
  (let [name (.name bp)
        mutable (.mutable bp)]
    (match (synth-bind-value a bp bexp env cx tps fname)
      (Err [d] (Err [i64 Diag] d))
      (Ok [vsp]
          (let [sp (primitive/alloc-stack SynPair)]
            (set! sp vsp)
            (let [ve (load (load (field sp e)))
                  vt (load (field sp t))]
              (cond (type-is-void vt)
                      (Err [i64 Diag]
                           (derr (sconcat1 a
                                           (sconcat4 a
                                                     "in '"
                                                     fname
                                                     "': cannot bind '"
                                                     (sconcat a
                                                              name
                                                              "' to a void value (a (-> void) call yields nothing)")))))
                    (= (type-tag vt) (primitive/cast i64 5))
                    ; The initializer is already a reference, so this binding either
                    ; ALIASES that place or reads a value out of it. Which one it is
                    ; follows the same rule as a call argument (see coerce-arg-inner):
                    ; an alias must be spelled `(mut …)`; a bare name is a value.
                    (let [borrowed (is-mut-borrow (field bp value))
                          src_mut (t-ref-mut vt)
                          pointee (t-inner vt)]
                      (cond (and mutable (not src_mut))
                              (Err [i64 Diag]
                                   (derr (sconcat1 a
                                                   (sconcat4 a
                                                             "in '"
                                                             fname
                                                             "': cannot make a mutable alias '"
                                                             (sconcat a name "' of an immutable reference")))))
                            ; A bare affine owner moves out of its old place and is
                            ; materialized in a fresh owning slot. Legacy aggregate
                            ; places retain Coil's historical view semantics.
                            (and (not borrowed) (type-is-affine a cx pointee))
                              (do
                                (bind-owned-place! a
                                                   name
                                                   mutable
                                                   (mk-expr (ELoad (box-expr a ve)) elo ehi esrc ectxt)
                                                   pointee
                                                   true
                                                   nbinds
                                                   env
                                                   elo
                                                   ehi
                                                   esrc
                                                   ectxt)
                                (Ok [i64 Diag] 0))
                            ; Without this, `(let [(mut b) a])` bound b to a's CELL, so a
                            ; store through either was visible through both — the same
                            ; silent aliasing a call site rejects outright. Affine values
                            ; were handled above: mutable controls their new owning slot,
                            ; not whether the source aliases.
                            (and mutable (not borrowed))
                              (Err [i64 Diag]
                                   (derr (sconcat1 a
                                                   (sconcat4 a
                                                             "in '"
                                                             fname
                                                             "': cannot bind '"
                                                             (sconcat a
                                                                      name
                                                                      "' as a mutable alias of a place; write (mut …) to alias it, or (load …) to copy its value")))))
                            ; A bare name reads the place, the value coercion a call
                            ; argument gets. Non-affine struct/array places stay
                            ; references — binding one remains a legacy view.
                            (and (not borrowed) (not (is-place-value-type pointee cx)))
                              (do
                                (env-insert! env name (box-type a (load pointee)))
                                (al-push! [Bind]
                                          nbinds
                                          (mk-bind name false (mk-expr (ELoad (box-expr a ve)) elo ehi esrc ectxt)))
                                (Ok [i64 Diag] 0))
                            :else
                              (do
                                (env-insert! env name (box-type a (TRef mutable pointee)))
                                (al-push! [Bind] nbinds (mk-bind name false ve))
                                (Ok [i64 Diag] 0))))
                      (or mutable
                          (or (is-place-value-type vt cx)
                              (or (type-is-affine a cx vt)
                                  (or (take-binding-value? (field bp value))
                                      (checked-take-value? (load (field sp e)))))))
                    (do
                      (bind-owned-place! a
                                         name
                                         mutable
                                         ve
                                         vt
                                         (or (type-is-affine a cx vt)
                                             (or (take-binding-value? (field bp value))
                                                 (checked-take-value? (load (field sp e)))))
                                         nbinds
                                         env
                                         elo
                                         ehi
                                         esrc
                                         ectxt)
                      (Ok [i64 Diag] 0))
                      :else
                    (do
                      (env-insert! env name (box-type a (load vt)))
                      (al-push! [Bind] nbinds (mk-bind name false ve))
                      (Ok [i64 Diag] 0)))))))))

(defn process-let-binds [(a (dyn Allocator))
                         (binds (ptr (ArrayList Bind)))
                         (nbinds (ptr (ArrayList Bind)))
                         (tailvar (slice u8))
                         (expected (ptr Type))
                         (env (ptr (ArrayList EnvEntry)))
                         (cx (ptr Cx))
                         (tps (ptr (ArrayList (slice u8))))
                         (fname (slice u8))
                         (elo i64)
                         (ehi i64)
                         (esrc i64)
                         (ectxt i64)] (-> (Result i64 Diag))
  (let [nb (al-len [Bind] (load binds))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) nb)
              (break)
              (do
                (let [bp (al-elem [Bind] binds (load i))
                      ; the let's returned tail binding gets the let's expected type as a
                      ; fallback (only used if it fails to infer on its own — see synth-bind-value)
                      bexp
                        (if (and (> (slice-len tailvar) (primitive/cast i64 0)) (= (.name bp) tailvar))
                            expected
                            (null-type))]
                  (match (process-let-bind a bp bexp nbinds env cx tps fname elo ehi esrc ectxt)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [_] 0)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn synth-let [(a (dyn Allocator))
                 (binds (ptr (ArrayList Bind)))
                 (body (ptr (ArrayList Expr)))
                 (expected (ptr Type))
                 (env (ptr (ArrayList EnvEntry)))
                 (cx (ptr Cx))
                 (tps (ptr (ArrayList (slice u8))))
                 (fname (slice u8))
                 (elo i64)
                 (ehi i64)
                 (esrc i64)
                 (ectxt i64)] (-> (Result EvalPair Diag))
  (let [saved (al-len [EnvEntry] (load env))
        nbinds (box-al [Bind] a (al-new [Bind] a))
        tailvar (let-tail-var body expected)]
    (match (process-let-binds a binds nbinds tailvar expected env cx tps fname elo ehi esrc ectxt)
      (Err [d] (err-ep d))
      (Ok [_]
          (let [outl (box-al [Expr] a (al-new [Expr] a))]
            (match (synth-let-body a body expected outl env cx tps fname "let body")
              (Err [d] (err-ep d))
              (Ok [last] (do (env-truncate! env saved) (ok-ep (mk-expr (ELet nbinds outl) elo ehi esrc ectxt) last)))))))))

; EMatch
(defn variant-by-name [(variants (ptr (ArrayList Variant))) (name (slice u8))] (-> (ptr Variant))
  (let [n (al-len [Variant] (load variants))
        (mut i) 0
        (mut r) (primitive/cast (ptr Variant) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [Variant] variants (load i)) name)) name)
                  (store! r (al-elem [Variant] variants (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn covered-has [(cov (ptr (ArrayList (slice u8)))) (name (slice u8))] (-> bool)
  (set-contains cov name))

; the variant names in `variants` not present in `covered`, formatted as
; "`Blue`" / "`Blue`, `Yellow`" / "`Blue`, `Yellow`, `Cyan` … and 4 more".
(defn missing-variants-str [(a (dyn Allocator))
                            (variants (ptr (ArrayList Variant)))
                            (covered (ptr (ArrayList (slice u8))))] (-> (slice u8))
  (let [n (al-len [Variant] (load variants))
        (mut i) 0
        (mut out) ""
        (mut shown) 0
        (mut extra) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [nm (.name (al-elem [Variant] variants (load i)))]
                  (unless (set-contains covered nm)
                    (if (< (load shown) (primitive/cast i64 5))
                        (do
                          (when (> (load shown) (primitive/cast i64 0)) (store! out (sconcat a (load out) ", ")) 0)
                          (store! out (sconcat a (load out) (sconcat3 a "`" nm "`")))
                          (store! shown (primitive/iadd (load shown) 1))
                          0)
                        (store! extra (primitive/iadd (load extra) 1)))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (> (load extra) (primitive/cast i64 0))
        (sconcat a (load out) (sconcat3 a " … and " (i64->str a (load extra)) " more"))
        (load out))))

(defn match-arms-loop [(a (dyn Allocator))
                       (arms (ptr (ArrayList Arm)))
                       (variants (ptr (ArrayList Variant)))
                       (sumname (slice u8))
                       (expected (ptr Type))
                       (covered (ptr (ArrayList (slice u8))))
                       (checked (ptr (ArrayList Arm)))
                       (synb (ptr (ArrayList Branch)))
                       (metav (ptr (ArrayList (slice u8))))
                       (metab (ptr (ArrayList (ptr (ArrayList (slice u8))))))
                       (env (ptr (ArrayList EnvEntry)))
                       (cx (ptr Cx))
                       (tps (ptr (ArrayList (slice u8))))
                       (fname (slice u8))
                       (borrow-kind i64)] (-> (Result i64 Diag))
  (let [narms (al-len [Arm] (load arms))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) narms)
              (break)
              (do
                (let [arm (al-elem [Arm] arms (load i))
                      av (.variant arm)
                      abinds (load (field arm binds))
                      wild (arm-wildcard? arm)
                      v (variant-by-name variants av)]
                  (cond (and (not wild) (= (primitive/cast i64 v) (primitive/cast i64 0)))
                          (do
                            (store! err
                                    (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat4 a
                                                                      "in '"
                                                                      fname
                                                                      "': sum '"
                                                                      (sconcat a sumname "' has no variant '"))
                                                            av)
                                                   "'")))
                            (store! failed true)
                            (break))
                        (and (not wild) (set-contains covered av))
                          (do
                            (store! err
                                    (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat4 a "in '" fname "': duplicate match arm for '" av)
                                                            "'")
                                                   "")))
                            (store! failed true)
                            (break))
                        (and (not wild)
                             (not (= (al-len [(slice u8)] (load abinds)) (al-len [Field] (load (field v fields))))))
                          (do
                            (store! err
                                    (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat a
                                                                     (sconcat a
                                                                              (sconcat4 a
                                                                                        "in '"
                                                                                        fname
                                                                                        "': arm '"
                                                                                        (sconcat a av "' binds "))
                                                                              (i64->str a
                                                                                        (al-len [(slice u8)]
                                                                                                (load abinds))))
                                                                     " name(s) but the variant has ")
                                                            (i64->str a (al-len [Field] (load (field v fields)))))
                                                   " field(s)")))
                            (store! failed true)
                            (break))
                        :else
                          (do
                            ; the catch-all covers whatever is left, so it contributes
                            ; no name to `covered` and binds nothing — which also keeps
                            ; the (null) `v` below out of reach, since the bind loop
                            ; that reads its fields runs zero times.
                            (unless wild (al-push! [(slice u8)] covered av))
                            (let [saved (al-len [EnvEntry] (load env))
                                  nbn (al-len [(slice u8)] (load abinds))
                                  (mut runtime-binds) (al-new [(slice u8)] a)
                                  (mut owner-binds) (al-new [Bind] a)
                                  (mut k) 0]
                              (loop (if (>= (load k) nbn)
                                        (break)
                                        (do
                                          (let [name (al-get [(slice u8)] (load abinds) (load k))
                                                ty (field (al-elem [Field] (load (field v fields)) (load k)) ty)]
                                            (cond
                                              (and (> borrow-kind (primitive/cast i64 0))
                                                   (type-is-affine a cx ty))
                                                (let [raw
                                                        (sconcat a
                                                          "$match.ref."
                                                          (sconcat a name (i64->str a (next-bid))))
                                                      ref-ty
                                                        (box-type a
                                                          (TRef (= borrow-kind (primitive/cast i64 2))
                                                            (box-type a (load ty))))]
                                                  (al-push! (mut runtime-binds) raw)
                                                  (env-insert! env raw ref-ty)
                                                  (env-insert! env name ref-ty)
                                                  (al-push! (mut owner-binds)
                                                    (mk-bind name false
                                                      (mk-expr (EVar raw)
                                                        (.lo (field arm body))
                                                        (.hi (field arm body))
                                                        (.source (field arm body))
                                                        (.ctxt (field arm body)))))
                                                  0)
                                              (type-is-affine a cx ty)
                                                (let [raw
                                                        (sconcat a
                                                                 "$match.in."
                                                                 (sconcat a name (i64->str a (next-bid))))]
                                                  (al-push! (mut runtime-binds) raw)
                                                  (env-insert! env raw ty)
                                                  (bind-owned-place! a
                                                                     name
                                                                     false
                                                                     (mk-expr (EVar raw)
                                                                              (.lo (field arm body))
                                                                              (.hi (field arm body))
                                                                              (.source (field arm body))
                                                                              (.ctxt (field arm body)))
                                                                     ty
                                                                     true
                                                                     (mut owner-binds)
                                                                     env
                                                                     (.lo (field arm body))
                                                                     (.hi (field arm body))
                                                                     (.source (field arm body))
                                                                     (.ctxt (field arm body)))
                                                  0)
                                              :else
                                                (do
                                                  (al-push! (mut runtime-binds) name)
                                                  (env-insert! env name ty)
                                                  0)))
                                          (store! k (primitive/iadd (load k) 1)))))
                              (if (expected-some? expected)
                                  (match (check-to a (field arm body) expected env cx tps fname "match arm")
                                    (Err [d]
                                         (do (env-truncate! env saved) (store! err d) (store! failed true) (break)))
                                    (Ok [be]
                                        (do
                                          (let [na (primitive/alloc-stack Arm)]
                                            (store! (field na variant) av)
                                            (store! (field na binds) (box-al [(slice u8)] a (load runtime-binds)))
                                            (store! (field na body)
                                                    (if (= (al-len [Bind] (load owner-binds)) 0)
                                                        be
                                                        (let [(mut wrapped-body) (al-new [Expr] a)]
                                                          (al-push! [Expr] (mut wrapped-body) be)
                                                          (mk-expr (ELet (box-al [Bind] a (load owner-binds))
                                                                         (box-al [Expr] a (load wrapped-body)))
                                                                   (.lo (field arm body))
                                                                   (.hi (field arm body))
                                                                   (.source (field arm body))
                                                                   (.ctxt (field arm body))))))
                                            (al-push! [Arm] checked (load na)))
                                          (env-truncate! env saved)
                                          0)))
                                  (match (do-synth a (field arm body) (null-type) env cx tps fname)
                                    (Err [d]
                                         (do (env-truncate! env saved) (store! err d) (store! failed true) (break)))
                                    (Ok [sp0]
                                        (let [sp (primitive/alloc-stack SynPair)
                                              br (primitive/alloc-stack Branch)]
                                          (store! sp sp0)
                                          (store! (field br e)
                                                  (if (= (al-len [Bind] (load owner-binds)) 0)
                                                      (load (field sp e))
                                                      (let [(mut wrapped-body) (al-new [Expr] a)]
                                                        (al-push! [Expr] (mut wrapped-body) (load (load (field sp e))))
                                                        (box-expr a
                                                                  (mk-expr (ELet (box-al [Bind] a (load owner-binds))
                                                                                 (box-al [Expr] a (load wrapped-body)))
                                                                           (.lo (field arm body))
                                                                           (.hi (field arm body))
                                                                           (.source (field arm body))
                                                                           (.ctxt (field arm body)))))))
                                          (store! (field br t) (load (field sp t)))
                                          (al-push! [Branch] synb (load br))
                                          (al-push! [(slice u8)] metav av)
                                          (al-push! [(ptr (ArrayList (slice u8)))]
                                                    metab
                                                    (box-al [(slice u8)] a (load runtime-binds)))
                                          (env-truncate! env saved)
                                          0)))))))
                  (set! i (primitive/iadd (load i) 1))))))
    (if (load failed) (Err [i64 Diag] (load err)) (Ok [i64 Diag] 0))))

(defn build-newarms [(a (dyn Allocator))
                     (metav (ptr (ArrayList (slice u8))))
                     (metab (ptr (ArrayList (ptr (ArrayList (slice u8))))))
                     (outl (ptr (ArrayList Expr)))] (-> (ptr (ArrayList Arm)))
  (let [nm (al-len [(slice u8)] (load metav))
        (mut newarms) (al-new [Arm] a)
        (mut j) 0]
    (loop (if (>= (load j) nm)
              (break)
              (do
                (let [na (primitive/alloc-stack Arm)]
                  (set! (.variant na) (al-get [(slice u8)] (load metav) (load j)))
                  (set! (.binds na) (al-get [(ptr (ArrayList (slice u8)))] (load metab) (load j)))
                  (set! (.body na) (al-get [Expr] (load outl) (load j)))
                  (al-push! (mut newarms) (load na)))
                (set! j (primitive/iadd (load j) 1)))))
    (box-al [Arm] a (load newarms))))

(defn synth-match [(a (dyn Allocator))
                   (scrut (ptr Expr))
                   (arms (ptr (ArrayList Arm)))
                   (expected (ptr Type))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [ssp0 (try! (do-synth a scrut (null-type) env cx tps fname))
               ssp (primitive/alloc-stack SynPair)]
           (store! ssp ssp0)
           (let [(mut se) (load (field ssp e))
                 st0 (load (field ssp t))
                 (mut st) st0
                 (mut borrow-kind) 0]
             (when (= (type-tag st0) (primitive/cast i64 5))
               (let [inner (t-inner st0)]
                 (when (load (field (alloc-stack-store-sumvars a inner cx) found))
                   (match (load st0)
                     (TRef [mutable _]
                       (store! borrow-kind
                         (if mutable (primitive/cast i64 2) (primitive/cast i64 1))))
                     (_ (store! se
                          (box-expr a
                            (mk-expr (ELoad (load se)) elo ehi esrc ectxt)))))
                   (store! st inner)
                   0)))
             (let [svp (alloc-stack-store-sumvars a (load st) cx)]
               (when (not (load (field svp found)))
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat3 a "in '" fname "': match expects a sum value, got ")
                                                 (ty-str a (load st)))))))
               (let [sumname (load (field svp name))
                     variants (load (field svp variants))]
                 (when (= (al-len [Arm] (load arms)) (primitive/cast i64 0))
                   (break :try (err-ep (derr (sconcat3 a "in '" fname "': empty match")))))
                 (let [covered (box-al [(slice u8)] a (al-new [(slice u8)] a))
                       checked (box-al [Arm] a (al-new [Arm] a))
                       synb (box-al [Branch] a (al-new [Branch] a))
                       metav (box-al [(slice u8)] a (al-new [(slice u8)] a))
                       metab (box-al [(ptr (ArrayList (slice u8)))] a (al-new [(ptr (ArrayList (slice u8)))] a))]
                   (try! (match-arms-loop a
                                          arms
                                          variants
                                          sumname
                                          expected
                                          covered
                                          checked
                                          synb
                                          metav
                                          metab
                                          env
                                          cx
                                          tps
                                          fname
                                          (load borrow-kind)))
                   (when (and (not (arms-have-wildcard arms))
                              (not (= (al-len [(slice u8)] (load covered)) (al-len [Variant] (load variants)))))
                     (break  ; the exhaustiveness check already knows WHICH variants are uncovered —
                            ; name them instead of just counting. For a 20-variant sum, "18 of 20"
                            ; told you nothing you didn't already know.
                            :try
                            (err-ep (derr (sconcat a
                                                   (sconcat a
                                                            (sconcat4 a
                                                                      "in '"
                                                                      fname
                                                                      "': non-exhaustive match on '"
                                                                      (sconcat a sumname "': "))
                                                            (missing-variants-str a variants covered))
                                                   " not covered")))))
                   (if (expected-some? expected)
                       (ok-ep (mk-expr (EMatch (load se) checked) elo ehi esrc ectxt) (load expected))
                       (let [outl (box-al [Expr] a (al-new [Expr] a))
                             t (try! (unify-branches a synb outl fname "match arms"))]
                         (ok-ep (mk-expr (EMatch (load se) (build-newarms a metav metab outl)) elo ehi esrc ectxt) t)))))))))))

(defn alloc-stack-store-sumvars [(a (dyn Allocator)) (t (ptr Type)) (cx (ptr Cx))] (-> (ptr SumVars))
  (box! a SumVars (sum-variants a t cx)))

; ---- loop / break / continue (cx.loops frames) ----
(defn loops-len [(cx (ptr Cx))] (-> i64)
  (al-len [LoopFrame] (.loops cx)))

(defn loop-label-exists [(cx (ptr Cx)) (l (slice u8))] (-> bool)
  (let [n (loops-len cx)
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (.label (al-elem [LoopFrame] (field cx loops) (load i)))
                  (Some [fl] (when (= fl l) (store! r true) (break)))
                  (_ 0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn loops-rpos-label [(cx (ptr Cx)) (l (slice u8))] (-> i64)
  (let [n (loops-len cx)
        (mut i) (primitive/isub n 1)
        (mut at) -1]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (do
                (match (.label (al-elem [LoopFrame] (field cx loops) (load i)))
                  (Some [fl] (when (= fl l) (store! at (load i)) (break)))
                  (_ 0))
                (set! i (primitive/isub (load i) 1)))))
    (load at)))

(defn label-some? [(label (Option (slice u8)))] (-> bool)
  (match label (Some [l] true) (_ false)))

(defn label-val [(label (Option (slice u8)))] (-> (slice u8))
  (match label (Some [l] l) (_ "")))

(defn run-loop-body [(a (dyn Allocator))
                     (label (Option (slice u8)))
                     (body (ptr (ArrayList Expr)))
                     (expected (ptr Type))
                     (out (ptr (ArrayList Expr)))
                     (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))] (-> (Result Type Diag))
  (let [fr (primitive/alloc-stack LoopFrame)]
    (set! (.label fr) label)
    (set! (.break_ty fr) (None [Type]))
    (set! (.expected fr) (if (expected-some? expected) (Some (load expected)) (None [Type])))
    (al-push! [LoopFrame] (field cx loops) (load fr)))
  (let [n (al-len [Expr] (load body))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (do-synth a (al-elem [Expr] body (load i)) (null-type) env cx tps fname)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [sp0]
                      (let [sp (primitive/alloc-stack SynPair)]
                        (set! sp sp0)
                        (al-push! [Expr]
                                  out
                                  (load (load (field sp
                                                     e)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (let [popped (al-pop! [LoopFrame] (field cx loops))]
      (if (load failed)
          (Err [Type Diag] (load err))
          (let [(mut lty) (TNever)]
            (if (expected-some? expected)
                (set! lty (load expected))
                (match popped
                  (Some [pf]
                        (let [pfp (primitive/alloc-stack LoopFrame)]
                          (set! pfp pf)
                          (match (.break_ty pfp)
                            (Some [bt] (set! lty bt))
                            (_ (set! lty (TNever))))))
                  (_ (set! lty (TNever)))))
            (Ok (load lty)))))))

(defn synth-loop [(a (dyn Allocator))
                  (label (Option (slice u8)))
                  (body (ptr (ArrayList Expr)))
                  (expected (ptr Type))
                  (env (ptr (ArrayList EnvEntry)))
                  (cx (ptr Cx))
                  (tps (ptr (ArrayList (slice u8))))
                  (fname (slice u8))
                  (elo i64)
                  (ehi i64)
                  (esrc i64)
                  (ectxt i64)] (-> (Result EvalPair Diag))
  (if (and (label-some? label) (loop-label-exists cx (label-val label)))
      (err-ep (derr (sconcat1 a
                              (sconcat4 a
                                        "in '"
                                        fname
                                        "': loop label ':"
                                        (sconcat a (label-val label) "' shadows an enclosing loop with the same label")))))
      (let [outl (box-al [Expr] a (al-new [Expr] a))]
        (match (run-loop-body a label body expected outl env cx tps fname)
          (Err [d] (err-ep d))
          (Ok [lty] (ok-ep (mk-expr (ELoop label outl) elo ehi esrc ectxt) lty))))))

(defn synth-break [(a (dyn Allocator))
                   (label (Option (slice u8)))
                   (value (Option (ptr Expr)))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (when (= (loops-len cx) (primitive/cast i64 0))
           (break :try (err-ep (derr (sconcat3 a "in '" fname "': break outside of a loop")))))
         (let [idx (match label (Some [l] (loops-rpos-label cx l)) (_ (primitive/isub (loops-len cx) 1)))]
           (match label
             (Some [l]
                   (when (< idx (primitive/cast i64 0))
                     (break :try
                              (err-ep (derr (sconcat a
                                                     (sconcat4 a
                                                               "in '"
                                                               fname
                                                               "': break to unknown loop label ':"
                                                               l)
                                                     "'"))))))
             (_ 0))
           (let [fr (al-elem [LoopFrame] (field cx loops) idx)
                 texp (field fr expected)]
             (let [valpair (primitive/alloc-stack SynPair)
                   (mut have_val) false
                   (mut valexpr) (primitive/cast (ptr Expr) 0)
                   (mut vty) (box-type a (TInt 64 true))]
               (match value
                 (Some [vp]
                       (do
                         (store! have_val true)
                         (match (load texp)
                           (Some [exp]
                                 (let [ve (try! (check-to a vp (box-type a exp) env cx tps fname "break value"))]
                                   (store! valexpr (box-expr a ve))
                                   (store! vty (box-type a exp))
                                   0))
                           (_ (let [vsp (try! (do-synth a vp (null-type) env cx tps fname))]
                                (store! valpair vsp)
                                (store! valexpr (load (field valpair e)))
                                (store! vty (load (field valpair t)))
                                0)))
                         0))
                 (None []
                       (match (load texp)
                         (Some [exp]
                               (when (not (type-eq (box-type a exp) (load vty)))
                                 (break :try
                                          (err-ep (derr (sconcat a
                                                                 (sconcat a
                                                                          (sconcat3 a
                                                                                    "in '"
                                                                                    fname
                                                                                    "': break value has type i64 but expected ")
                                                                          (ty-str a (box-type a exp)))
                                                                 "; use (break value) when the loop is in value position"))))))
                         (_ 0))))
               (when (not (type-is-never (load vty)))
                 (match (load (field (al-elem [LoopFrame] (field cx loops) idx) break_ty))
                   (Some [prev]
                         (when (not (type-eq (box-type a prev) (load vty)))
                           (break :try
                                    (err-ep (derr (sconcat a
                                                           (sconcat a
                                                                    (sconcat a
                                                                             (sconcat4 a
                                                                                       "in '"
                                                                                       fname
                                                                                       "': loop breaks with different value types ("
                                                                                       (ty-str a
                                                                                               (box-type a
                                                                                                         prev)))
                                                                             " vs ")
                                                                    (ty-str a (load vty)))
                                                           ")"))))))
                   (None []
                         (do
                           (store! (field (al-elem [LoopFrame] (field cx loops) idx) break_ty)
                                   (Some (load (load vty))))
                           0))))
               (ok-ep (mk-expr (EBreak label (if (load have_val) (Some (load valexpr)) (None [(ptr Expr)])))
                               elo
                               ehi
                               esrc
                               ectxt)
                      (TNever))))))))

(defn synth-continue [(a (dyn Allocator))
                      (label (Option (slice u8)))
                      (cx (ptr Cx))
                      (fname (slice u8))
                      (elo i64)
                      (ehi i64)
                      (esrc i64)
                      (ectxt i64)] (-> (Result EvalPair Diag))
  (if (= (loops-len cx) (primitive/cast i64 0))
      (err-ep (derr (sconcat3 a "in '" fname "': continue outside of a loop")))
      (match label
        (Some [l]
              (if (< (loops-rpos-label cx l) (primitive/cast i64 0))
                  (err-ep (derr (sconcat a
                                         (sconcat4 a "in '" fname "': continue to unknown loop label ':" l)
                                         "'")))
                  (ok-ep (mk-expr (EContinue label) elo ehi esrc ectxt) (TNever))))
        (_ (ok-ep (mk-expr (EContinue label) elo ehi esrc ectxt) (TNever))))))

; ---- bin/cmp ----
(defn mk-branch [(e (ptr Expr)) (t (ptr Type))] (-> Branch)
  (let [p (primitive/alloc-stack Branch)] (set! (.e p) e) (set! (.t p) t) (load p)))

(defn synth-binop [(a (dyn Allocator))
                   (op i64)
                   (lhs (ptr Expr))
                   (rhs (ptr Expr))
                   (iscmp bool)
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [lsp (try! (do-synth a lhs (null-type) env cx tps fname))
               lp (primitive/alloc-stack SynPair)]
           (store! lp lsp)
           (let [rsp (try! (do-synth a rhs (null-type) env cx tps fname))
                 rp (primitive/alloc-stack SynPair)]
             (store! rp rsp)
             (let [(mut brs) (al-new [Branch] a)
                   outl (box-al [Expr] a (al-new [Expr] a))]
               (al-push! (mut brs) (mk-branch (load (field lp e)) (load (field lp t))))
               (al-push! (mut brs) (mk-branch (load (field rp e)) (load (field rp t))))
               (let [t
                       (try! (unify-branches a
                                             (box-al [Branch] a (load brs))
                                             outl
                                             fname
                                             (if iscmp "comparison" "arithmetic")))
                     tp (box-type a t)]
                 (if (not (numeric tp tps))
                     (return-from :try
                                    (err-ep (derr (sconcat a
                                                           (sconcat3 a "in '" fname "': ")
                                                           (sconcat a
                                                                    (if iscmp
                                                                        "comparison requires integers, got "
                                                                        "arithmetic requires integers, got ")
                                                                    (ty-str a tp))))))
                     (if iscmp
                         (ok-ep (mk-expr (ECmp
                                           :op op
                                           :lhs (al-elem [Expr] outl 0)
                                           :rhs (al-elem [Expr] outl 1))
                                         elo
                                         ehi
                                         esrc
                                         ectxt)
                                (TBool))
                         (ok-ep (mk-expr (EBin
                                           :op op
                                           :lhs (al-elem [Expr] outl 0)
                                           :rhs (al-elem [Expr] outl 1))
                                         elo
                                         ehi
                                         esrc
                                         ectxt)
                                t))))))))))

; ---- small arg-loop helpers ----
(defn synth-discard-args [(a (dyn Allocator))
                          (args (ptr (ArrayList Expr)))
                          (forbidvoid bool)
                          (voidmsg (slice u8))
                          (env (ptr (ArrayList EnvEntry)))
                          (cx (ptr Cx))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [n (al-len [Expr] (load args))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (do-synth a (al-elem [Expr] args (load i)) (null-type) env cx tps fname)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [sp0]
                      (let [sp (primitive/alloc-stack SynPair)]
                        (set! sp sp0)
                        (if (and forbidvoid (type-is-void (load (field sp t))))
                            (do (set! err (derr voidmsg)) (set! failed true) (break))
                            (al-push! (mut out) (load (load (field sp e))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Expr)) Diag] (load err)) (Ok (box-al [Expr] a (load out))))))

(defn codeop-rty [(op i64)] (-> Type)
  (cond (or (= op (primitive/cast i64 40))
            (or (= op (primitive/cast i64 37))
                (or (= op (primitive/cast i64 3))
                    (or (= op (primitive/cast i64 6))
                        (or (= op (primitive/cast i64 14))
                            (or (= op (primitive/cast i64 16))
                                (or (= op (primitive/cast i64 19))
                                    (or (= op (primitive/cast i64 21))
                                        (or (= op (primitive/cast i64 22))
                                            (or (= op (primitive/cast i64 56))
                                                (or (= op (primitive/cast i64 71))
                                                    (or (= op (primitive/cast i64 77))
                                                    (= op
                                                       (primitive/cast i64
                                                                       24))))))))))))))
          (TInt 64 true)
        (or (= op (primitive/cast i64 41))
            (or (= op (primitive/cast i64 43))
                (or (= op (primitive/cast i64 5))
                    (or (= op (primitive/cast i64 13))
                        (or (= op
                               (primitive/cast i64
                                               33))
                            (or (= op
                                   (primitive/cast i64
                                                   38))
                                (= op
                                   (primitive/cast i64
                                                   52))))))))
          (TSlice (box-type (malloc-allocator) (TInt 8 false)))
        (or (= op (primitive/cast i64 0))
            (or (= op (primitive/cast i64 1))
                (or (= op (primitive/cast i64 2))
                    (or (= op (primitive/cast i64 10))
                        (or (= op (primitive/cast i64 11))
                            (or (= op (primitive/cast i64 34))
                                (or (= op (primitive/cast i64 45))
                                    (or (= op (primitive/cast i64 53))
                                        (or (= op (primitive/cast i64 39))
                                            (or (= op (primitive/cast i64 54))
                                                (or (= op (primitive/cast i64 55))
                                                    (or (= op (primitive/cast i64 57))
                                                        (= op (primitive/cast i64 73))))))))))))))
          (TBool)
        (or (= op (primitive/cast i64 69)) (= op (primitive/cast i64 70))) (TBool)
        (= op (primitive/cast i64 9)) (TNever)
        ; docs/design/META_MEMORY.md phase 4: 60 makes a builder, 61 returns the
        ; builder it pushed onto. 62 (code-list-done) freezes one and lands in
        ; the :else TCode bucket.
        (or (= op (primitive/cast i64 60)) (= op (primitive/cast i64 61))) (TCodeBuilder)
        :else (TCode)))

(defn ty-is-code-builder [(t Type)] (-> bool)
  (match t (TCodeBuilder [] true) (_ false)))

; docs/design/META_MEMORY.md phase 4: builder discipline for the code ops.
; `code-list-push!` (61) and `code-list-done` (62) REQUIRE a builder as their
; first argument — a finished Code list cannot be mutated in place — and every
; OTHER code op takes finished Code, so a builder anywhere else is an error
; that names the fix. This lives here rather than in a general signature table
; because the builder is the one code-op type that must not unify with Code.
(defn synth-codeop-args [(a (dyn Allocator))
                         (op i64)
                         (args (ptr (ArrayList Expr)))
                         (env (ptr (ArrayList EnvEntry)))
                         (cx (ptr Cx))
                         (tps (ptr (ArrayList (slice u8))))
                         (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [n (al-len [Expr] (load args))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false
        wants-builder (or (= op (primitive/cast i64 61)) (= op (primitive/cast i64 62)))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (do-synth a (al-elem [Expr] args (load i)) (null-type) env cx tps fname)
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [sp0]
                      (let [sp (primitive/alloc-stack SynPair)
                            _s (set! sp sp0)
                            isb (ty-is-code-builder (load (field sp t)))
                            first-builder-slot (and wants-builder (= (load i) (primitive/cast i64 0)))]
                        (cond (and first-builder-slot (not isb))
                                (do
                                  (store! err
                                          (derr (sconcat3 a
                                                          "in '"
                                                          fname
                                                          "': code-list-push!/code-list-done expect a builder from (primitive/code-list-new) — a finished Code list cannot be mutated in place")))
                                  (store! failed true)
                                  (break))
                              (and isb (not first-builder-slot))
                                (do
                                  (store! err
                                          (derr (sconcat3 a
                                                          "in '"
                                                          fname
                                                          "': this Code op reads finished Code — freeze the builder first with (primitive/code-list-done b)")))
                                  (store! failed true)
                                  (break))
                              :else (al-push! (mut out) (load (load (field sp e))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Expr)) Diag] (load err)) (Ok (box-al [Expr] a (load out))))))

(defn synth-callptr-args [(a (dyn Allocator))
                          (params (ptr (ArrayList Type)))
                          (args (ptr (ArrayList Expr)))
                          (env (ptr (ArrayList EnvEntry)))
                          (cx (ptr Cx))
                          (tps (ptr (ArrayList (slice u8))))
                          (fname (slice u8))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [n (al-len [Expr] (load args))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [wp (al-elem [Type] params (load i))
                      what (sconcat a "call-ptr argument " (i64->str a (primitive/iadd (load i) 1)))]
                  (match (do-synth a (al-elem [Expr] args (load i)) wp env cx tps fname)
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)]
                          (set! sp sp0)
                          (match (coerce a
                                         (load (load (field sp e)))
                                         (load (field sp
                                                      t))
                                         wp
                                         false
                                         fname
                                         what)
                            (Err [d] (do (set! err d) (set! failed true) (break)))
                            (Ok [ce] (al-push! (mut out) ce)))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Expr)) Diag] (load err)) (Ok (box-al [Expr] a (load out))))))

; ---- per-arm helpers for the complex variants ----
(defn synth-do [(a (dyn Allocator))
                (body (ptr (ArrayList Expr)))
                (expected (ptr Type))
                (env (ptr (ArrayList EnvEntry)))
                (cx (ptr Cx))
                (tps (ptr (ArrayList (slice u8))))
                (fname (slice u8))
                (elo i64)
                (ehi i64)
                (esrc i64)
                (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [outl (box-al [Expr] a (al-new [Expr] a))
               last (try! (synth-let-body a body expected outl env cx tps fname "do result"))]
           (ok-ep (mk-expr (EDo outl) elo ehi esrc ectxt) last)))))

(defn synth-if [(a (dyn Allocator))
                (cnd (ptr Expr))
                (thn (ptr Expr))
                (els (ptr Expr))
                (expected (ptr Type))
                (env (ptr (ArrayList EnvEntry)))
                (cx (ptr Cx))
                (tps (ptr (ArrayList (slice u8))))
                (fname (slice u8))
                (elo i64)
                (ehi i64)
                (esrc i64)
                (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [csp0 (try! (do-synth a cnd (null-type) env cx tps fname))
               csp (primitive/alloc-stack SynPair)]
           (store! csp csp0)
           (when (not (is-cond (load (field csp t))))
             (break :try
                      (err-ep (derr (sconcat a
                                             (sconcat3 a
                                                       "in '"
                                                       fname
                                                       "': if condition must be a bool or integer, got ")
                                             (ty-str a (load (field csp t))))))))
           (if (expected-some? expected)
               (let [te (try! (check-to a thn expected env cx tps fname "if branch"))
                     ee (try! (check-to a els expected env cx tps fname "if branch"))]
                 (ok-ep (mk-expr (EIf
                                   :cnd (load (field csp e))
                                   :thn (box-expr a te)
                                   :els (box-expr a ee))
                                 elo
                                 ehi
                                 esrc
                                 ectxt)
                        (load expected)))
               (let [tsp0 (try! (do-synth a thn (null-type) env cx tps fname))
                     tsp (primitive/alloc-stack SynPair)]
                 (store! tsp tsp0)
                 (let [esp0 (try! (do-synth a els (null-type) env cx tps fname))
                       esp (primitive/alloc-stack SynPair)]
                   (store! esp esp0)
                   (let [(mut brs) (al-new [Branch] a)
                         outl (box-al [Expr] a (al-new [Expr] a))]
                     (al-push! (mut brs)
                               (mk-branch (load (field tsp e))
                                          (load (field tsp
                                                       t))))
                     (al-push! (mut brs)
                               (mk-branch (load (field esp e))
                                          (load (field esp
                                                       t))))
                     (let [t (try! (unify-branches a (box-al [Branch] a (load brs)) outl fname "if branches"))]
                       (ok-ep (mk-expr (EIf
                                         :cnd (load (field csp e))
                                         :thn (al-elem [Expr] outl 0)
                                         :els (al-elem [Expr] outl 1))
                                       elo
                                       ehi
                                       esrc
                                       ectxt)
                              t))))))))))

(defn synth-field [(a (dyn Allocator))
                   (pp (ptr Expr))
                   (ffld (slice u8))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [psp (try! (do-synth a pp (null-type) env cx tps fname))
               sp (primitive/alloc-stack SynPair)]
           (store! sp psp)
           (let [pt (load (field sp t))
                 pointee (place-pointee pt)]
             ; `field` needs a PLACE. The value case is almost always a collection read
             ; used inline — `(field (al-get l i) x)` — and the old message said what was
             ; wrong without saying what to write, which left "one by-ref accessor per
             ; field" looking like the only way out. Both remedies are one line, so name
             ; them: a `let` gives the value an address, and the containers that can hand
             ; back a live element already expose `al-elem`.
             (when (= (primitive/cast i64 pointee) (primitive/cast i64 0))
               (break :try
                        (err-ep (derr (sconcat a
                                               (sconcat a
                                                        (sconcat3 a
                                                                  "in '"
                                                                  fname
                                                                  "': field access needs a pointer or reference, got ")
                                                        (ty-str a pt))
                                               "; bind it to a `let` first and take the field of that, or read the element by reference (coil.arraylist has `al-elem`, which returns a pointer to the live element)")))))
             (when (not (is-struct-or-app pointee))
               (break :try
                        (err-ep (derr (sconcat a
                                               (sconcat3 a
                                                         "in '"
                                                         fname
                                                         "': field access needs a pointer to a struct, got (ptr ")
                                               (sconcat a (ty-str a pointee) ")"))))))
             (let [sname (struct-name pointee)
                   si (struct-find cx sname)]
               (when (and (!= (primitive/cast i64 si) (primitive/cast i64 0)) (load (field si is_bits)))
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat a
                                                          (sconcat a
                                                                   (sconcat a
                                                                            (sconcat5 a
                                                                                      "in '"
                                                                                      fname
                                                                                      "': '"
                                                                                      sname
                                                                                      "' is a :layout bits struct; use (primitive/bit-get p ")
                                                                            ffld)
                                                                   ") / (primitive/bit-set! p ")
                                                          ffld)
                                                 " v)")))))
               (match (struct-fields a pointee cx)
                 (Err [d] (return-from :try (err-ep (prefix-diag a d (sconcat4 a "in '" fname "': " "")))))
                 (Ok [fs]
                     (let [nf (al-len [Field] (load fs))
                           (mut i) 0
                           (mut fty) (primitive/cast (ptr Type) 0)]
                       (loop (if (>= (load i) nf)
                                 (break)
                                 (do
                                   (when (= (load (field (al-elem [Field] fs (load i)) name)) ffld)
                                     (store! fty (field (al-elem [Field] fs (load i)) ty))
                                     (break))
                                   (store! i (primitive/iadd (load i) 1)))))
                       (when (= (primitive/cast i64 (load fty)) (primitive/cast i64 0))
                         (break :try
                                  (err-ep (derr (sconcat a
                                                         (sconcat a
                                                                  (sconcat4 a
                                                                            "in '"
                                                                            fname
                                                                            "': struct '"
                                                                            (sconcat a sname "' has no field '"))
                                                                  ffld)
                                                         "'")))))
                       (ok-ep (mk-expr (EField (load (field sp e)) ffld) elo ehi esrc ectxt) (replace-pointee a pt fty)))))))))))

(defn synth-store [(a (dyn Allocator))
                   (pp (ptr Expr))
                   (val (ptr Expr))
                   (initializing bool)
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [psp (try! (do-synth a pp (null-type) env cx tps fname))
               sp (primitive/alloc-stack SynPair)]
           (store! sp psp)
           (let [pt (load (field sp t))
                 pointee (place-pointee pt)]
             (when (= (primitive/cast i64 pointee) (primitive/cast i64 0))
               (break :try
                        (err-ep (derr (sconcat a
                                               (sconcat3 a
                                                         "in '"
                                                         fname
                                                         "': store! expects a pointer or reference, got ")
                                               (ty-str a pt))))))
             (when (not (is-writable pt))
               (break :try
                        (err-ep (derr (sconcat a
                                               (sconcat a
                                                        (sconcat4 a
                                                                  "in '"
                                                                  fname
                                                                  "': cannot store! through immutable reference of type "
                                                                  (ty-str a pt))
                                                        " (declare it `(mut …)` to make it writable)")
                                               "")))))
             (let [vsp (try! (do-synth a val pointee env cx tps fname))
                   vp (primitive/alloc-stack SynPair)]
               (store! vp vsp)
               (match (coerce a (load (load (field vp e))) (load (field vp t)) pointee false fname "store! value")
                 (Err [d] (return-from :try (err-ep d)))
                 ; std-12: store! is effect-only — it yields unit (canonical i64 0), not the
                 ; stored value's type, so an effect-only `if`/block no longer type-mismatches.
                 (Ok [ve]
                     (ok-ep (mk-expr (if initializing
                                         (EInitStore (load (field sp e)) (box-expr a ve))
                                         (EStore (load (field sp e)) (box-expr a ve)))
                                     elo
                                     ehi
                                     esrc
                                     ectxt)
                            (TInt 64 true))))))))))

(defn synth-index [(a (dyn Allocator))
                   (pp (ptr Expr))
                   (idx (ptr Expr))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [psp (try! (do-synth a pp (null-type) env cx tps fname))
               sp (primitive/alloc-stack SynPair)]
           (store! sp psp)
           (let [isp (try! (do-synth a idx (null-type) env cx tps fname))
                 ip (primitive/alloc-stack SynPair)]
             (store! ip isp)
             (let [ie
                     (match (coerce a
                                    (load (load (field ip e)))
                                    (load (field ip t))
                                    (box-type a (TInt 64 true))
                                    false
                                    fname
                                    "index")
                       (Err [_] (return-from :try (err-ep (derr (sconcat3 a "in '" fname "': index must be i64")))))
                       (Ok [ce] ce))
                   pt (load (field sp t))
                   pointee (place-pointee pt)]
               (when (= (primitive/cast i64 pointee) (primitive/cast i64 0))
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat3 a
                                                           "in '"
                                                           fname
                                                           "': index expects a pointer or reference, got ")
                                                 (ty-str a pt))))))
               (let [elem (if (= (type-tag pointee) (primitive/cast i64 7)) (t-inner pointee) pointee)]
                 (ok-ep (mk-expr (EIndex (load (field sp e)) (box-expr a ie)) elo ehi esrc ectxt)
                        (replace-pointee a pt elem)))))))))

(defn synth-cast [(a (dyn Allocator))
                  (ty Type)
                  (inner (ptr Expr))
                  (env (ptr (ArrayList EnvEntry)))
                  (cx (ptr Cx))
                  (tps (ptr (ArrayList (slice u8))))
                  (fname (slice u8))
                  (elo i64)
                  (ehi i64)
                  (esrc i64)
                  (ectxt i64)] (-> (Result EvalPair Diag))
  (let [tp (box-type a ty)]
    (match (validate-type tp cx tps)
      (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': cast target: "))))
      (Ok [_]
          (match (do-synth a inner (null-type) env cx tps fname)
            (Err [d] (err-ep d))
            (Ok [sp0]
                (let [sp (primitive/alloc-stack SynPair)]
                  (set! sp sp0)
                  (let [et (load (field sp t))
                        tt (type-tag tp)
                        etg (type-tag et)
                        ok
                          (or (and (= tt (primitive/cast i64 0)) (= etg (primitive/cast i64 0)))
                              (or (and (= tt (primitive/cast i64 4)) (= etg (primitive/cast i64 4)))
                                  (or (and (= tt (primitive/cast i64 0)) (= etg (primitive/cast i64 4)))
                                      (or (and (= tt (primitive/cast i64 4)) (= etg (primitive/cast i64 0)))
                                          (or (and (= tt (primitive/cast i64 1)) (= etg (primitive/cast i64 1)))
                                              (or (and (= tt (primitive/cast i64 1)) (= etg (primitive/cast i64 0)))
                                                  (or (and (= tt (primitive/cast i64 0)) (= etg (primitive/cast i64 1)))
                                                      (or (and (= tt (primitive/cast i64 10))
                                                               (= etg (primitive/cast i64 10)))
                                                          (or (and (= tt (primitive/cast i64 10))
                                                                   (= etg (primitive/cast i64 4)))
                                                              (and (= tt (primitive/cast i64 4))
                                                                   (= etg (primitive/cast i64 10))))))))))))]
                    (if ok
                        (ok-ep (mk-expr (ECast ty (load (field sp e))) elo ehi esrc ectxt) ty)
                        (err-ep (derr (sconcat a
                                               (sconcat a
                                                        (sconcat a
                                                                 (sconcat4 a
                                                                           "in '"
                                                                           fname
                                                                           "': cast only converts among int, float, and ptr (got "
                                                                           (ty-str a et))
                                                                 " to ")
                                                        (ty-str a tp))
                                               ")"))))))))))))

(defn synth-offsetof [(a (dyn Allocator))
                      (ty Type)
                      (ffld (slice u8))
                      (cx (ptr Cx))
                      (tps (ptr (ArrayList (slice u8))))
                      (fname (slice u8))
                      (elo i64)
                      (ehi i64)
                      (esrc i64)
                      (ectxt i64)] (-> (Result EvalPair Diag))
  (let [tp (box-type a ty)]
    (match (validate-type tp cx tps)
      (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': offsetof: "))))
      (Ok [_]
          (try (let [fs
                       (try-or! (struct-fields a tp cx)
                                (err-ep (derr (sconcat a
                                                       (sconcat3 a "in '" fname "': offsetof needs a struct type, got ")
                                                       (ty-str a tp)))))]
                 (let [nf (al-len [Field] (load fs))
                       (mut i) 0
                       (mut found) false]
                   (loop (if (>= (load i) nf)
                             (break)
                             (do
                               (when (= (load (field (al-elem [Field] fs (load i)) name)) ffld)
                                 (store! found true)
                                 (break))
                               (store! i (primitive/iadd (load i) 1)))))
                   (if (not (load found))
                       (err-ep (derr (sconcat a
                                              (sconcat a
                                                       (sconcat a
                                                                (sconcat4 a
                                                                          "in '"
                                                                          fname
                                                                          "': offsetof: struct '"
                                                                          (struct-name tp))
                                                                "' has no field '")
                                                       ffld)
                                              "'")))
                       (ok-ep (mk-expr (EOffsetOf ty ffld) elo ehi esrc ectxt) (TInt 64 true))))))))))

(defn synth-fnptr [(a (dyn Allocator))
                   (name (slice u8))
                   (cx (ptr Cx))
                   (fname (slice u8))
                   (elo i64)
                   (ehi i64)
                   (esrc i64)
                   (ectxt i64)] (-> (Result EvalPair Diag))
  (let [sig (sig-find cx name)]
    (cond (= (primitive/cast i64 sig) (primitive/cast i64 0))
            (err-ep (derr (sconcat a (sconcat4 a "in '" fname "': fnptr-of unknown function '" name) "'")))
          (> (al-len [(slice u8)] (load (field sig type_params))) (primitive/cast i64 0))
            (err-ep (derr (sconcat a
                                   (sconcat4 a
                                             "in '"
                                             fname
                                             "': cannot take a function pointer to generic function '"
                                             name)
                                   "'")))
          (not (load (field sig fnptr_ok)))
            (err-ep (derr (sconcat a
                                   (sconcat4 a "in '" fname "': cannot take a function pointer to '" name)
                                   "' (shim-convention functions are not supported yet)")))
          :else
            (ok-ep (mk-expr (EFnPtrOf name) elo ehi esrc ectxt)
                   (TFn
                     :cc (load (field sig cc))
                     :params (load (field sig params))
                     :ret
                       (box-type a
                                 (load (field sig
                                              ret))))))))

(defn synth-callptr [(a (dyn Allocator))
                     (fp (ptr Expr))
                     (args (ptr (ArrayList Expr)))
                     (env (ptr (ArrayList EnvEntry)))
                     (cx (ptr Cx))
                     (tps (ptr (ArrayList (slice u8))))
                     (fname (slice u8))
                     (elo i64)
                     (ehi i64)
                     (esrc i64)
                     (ectxt i64)] (-> (Result EvalPair Diag))
  (try (do
         (let [fsp (try! (do-synth a fp (null-type) env cx tps fname))
               sp (primitive/alloc-stack SynPair)]
           (store! sp fsp)
           (let [ft (load (field sp t))]
             (when (not (= (type-tag ft) (primitive/cast i64 10)))
               (break :try
                        (err-ep (derr (sconcat a
                                               (sconcat3 a
                                                         "in '"
                                                         fname
                                                         "': call-ptr expects a function pointer, got ")
                                               (ty-str a ft))))))
             (let [params (t-fn-params ft)
                   ret (t-fn-ret ft)]
               (when (not (= (al-len [Type] (load params)) (al-len [Expr] (load args))))
                 (break :try
                          (err-ep (derr (sconcat a
                                                 (sconcat a
                                                          (sconcat a
                                                                   (sconcat4 a
                                                                             "in '"
                                                                             fname
                                                                             "': function pointer expects "
                                                                             (i64->str a
                                                                                       (al-len [Type]
                                                                                               (load params))))
                                                                   " args, got ")
                                                          (i64->str a (al-len [Expr] (load args))))
                                                 "")))))
               (let [na (try! (synth-callptr-args a params args env cx tps fname))]
                 (ok-ep (mk-expr (ECallPtr (load (field sp e)) na) elo ehi esrc ectxt) (load ret)))))))))

; ============================ synth_inner =================
(defn synth-inner [(a (dyn Allocator))
                   (e (ptr Expr))
                   (expected (ptr Type))
                   (env (ptr (ArrayList EnvEntry)))
                   (cx (ptr Cx))
                   (tps (ptr (ArrayList (slice u8))))
                   (fname (slice u8))] (-> (Result EvalPair Diag))
  (let [elo (.lo e)
        ehi (.hi e)
        esrc (.source e)
        ectxt (.ctxt e)]
    (match (.kind e)
      (EInt [v] (ok-ep (mk-expr (EInt v) elo ehi esrc ectxt) (TInt 64 true)))
      (EFloat [bits] (ok-ep (mk-expr (EFloat bits) elo ehi esrc ectxt) (TFloat 64)))
      (EBool [b] (ok-ep (mk-expr (EBool b) elo ehi esrc ectxt) (TBool)))
      (EStr [s] (ok-ep (mk-expr (EStr s) elo ehi esrc ectxt) (TSlice (box-type a (TInt 8 false)))))
      (ECStr [s] (ok-ep (mk-expr (ECStr s) elo ehi esrc ectxt) (TPtr (box-type a (TInt 8 true)))))
      (EArrayLit [items]
                 (synth-array-literal a items expected env cx tps fname elo ehi esrc ectxt))
      (EMakeSlice [data elem len]
                  (match (do-synth a data (null-type) env cx tps fname)
                    (Err [d] (err-ep d))
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)]
                          (set! sp sp0)
                          (match (load (load (field sp t)))
                            (TPtr [got]
                                  (ok-ep (mk-expr (EMakeSlice
                                                    :data (load (field sp e))
                                                    :elem elem
                                                    :len len)
                                                  elo
                                                  ehi
                                                  esrc
                                                  ectxt)
                                         (TSlice (box-type a elem))))
                            (_ (err-ep (derr "internal: make-slice data is not a pointer"))))))))
      (EZeroed [ty]
               (let [tp (box-type a ty)]
                 (match (validate-type tp cx tps)
                   (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': zeroed: "))))
                   (Ok [_] (ok-ep (mk-expr (EZeroed ty) elo ehi esrc ectxt) ty)))))
      (EBorrow [mutable place]
               (match (do-synth a place (null-type) env cx tps fname)
                 (Err [d] (err-ep d))
                 (Ok [sp0]
                     (let [sp (primitive/alloc-stack SynPair)]
                       (set! sp sp0)
                       (let [pt (load (field sp t))
                             pointee (place-pointee pt)]
                         (if (= (primitive/cast i64 pointee) (primitive/cast i64 0))
                             (err-ep (derr (sconcat a
                                                    (sconcat3 a "in '" fname "': cannot borrow a non-place of type ")
                                                    (ty-str a pt))))
                             (if (and mutable (not (is-writable pt)))
                                 (err-ep (derr (sconcat a
                                                        (sconcat a
                                                                 (sconcat4 a
                                                                           "in '"
                                                                           fname
                                                                           "': cannot take a mutable borrow of immutable '"
                                                                           (ty-str a pt))
                                                                 "'")
                                                        "")))
                                 (ok-ep (load (load (field sp e))) (TRef mutable (box-type a (load pointee)))))))))))
      (EVar [name]
            (let [te (env-get env name)]
              (if (!= (primitive/cast i64 te) (primitive/cast i64 0))
                  (ok-ep (mk-expr (EVar name) elo ehi esrc ectxt) (load te))
                  (let [ce (const-find cx name)]
                    (if (!= (primitive/cast i64 ce) (primitive/cast i64 0))
                        (if (set-contains (field cx static_consts) name)
                            (ok-ep (mk-expr (EStaticRef name) elo ehi esrc ectxt)
                                   (TRef false (box-type a (.ty ce))))
                            (if (is-literal-value (field ce value))
                                (ok-ep (mk-expr (.kind (.value ce)) elo ehi esrc ectxt)
                                       (.ty ce))
                                (ok-ep (mk-expr (EComptime (box-expr a (.value ce))) elo ehi esrc ectxt)
                                       (.ty ce))))
                        (if (unscoped-datum-ident? name)
                            (err-ep (derr (sconcat a
                                                   (sconcat4 a
                                                             "in '"
                                                             fname
                                                             "': unscoped generated identifier '"
                                                             (display-ident name))
                                                   "'; use fresh-identifier or an explicit datum->syntax/syntax->datum operation")))
                            (err-ep (derr (sconcat a
                                                   (sconcat4 a
                                                             "in '"
                                                             fname
                                                             "': unbound variable '"
                                                             (display-ident name))
                                                   "'")))))))))
      (ELlvmIr [result args body]
               (let [rp (box-type a result)]
                 (match (validate-type rp cx tps)
                   (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': llvm-ir result type: "))))
                   (Ok [_]
                       (match (synth-discard-args a
                                                  args
                                                  true
                                                  (sconcat3 a
                                                            "in '"
                                                            fname
                                                            "': llvm-ir operand uses a void value (a (-> void) call yields nothing)")
                                                  env
                                                  cx
                                                  tps
                                                  fname)
                         (Err [d] (err-ep d))
                         (Ok [eargs]
                             (ok-ep (mk-expr (ELlvmIr
                                               :result result
                                               :args eargs
                                               :body body)
                                             elo
                                             ehi
                                             esrc
                                             ectxt)
                                    result)))))))
      (ETraitCall [trait_name method self_tp args]
                  ; A Func can appear both in the program's impl table and in the
                  ; flattened function worklist. The first synthesis turns a
                  ; bound call into ETraitCall; a later authoritative synthesis
                  ; of that same internal node must be idempotent. Source syntax
                  ; and transforms cannot manufacture this AST variant.
                  (let [td (trait-find cx trait_name)]
                    (if (= (primitive/cast i64 td) (primitive/cast i64 0))
                        (err-ep (derr (sconcat3 a "internal: unresolved trait '" trait_name "' in deferred call")))
                        (let [tm (trait-method-find td method)]
                          (if (= (primitive/cast i64 tm) (primitive/cast i64 0))
                              (err-ep (derr (sconcat3 a
                                                      "internal: unresolved trait method '"
                                                      method
                                                      "' in deferred call")))
                              (let [subst (build-trait-subst a (.self_param td) self_tp trait_name td)
                                    ret (subst-apply a (field tm ret) subst)]
                                (ok-ep (load e) ret)))))))
      (ECleanup [_ _]
                (err-ep (derr "internal: cleanup region appeared before ownership elaboration")))
      (EComptime [inner]
                 (match (do-synth a inner expected env cx tps fname)
                   (Err [d] (err-ep d))
                   (Ok [sp0]
                       (let [sp (primitive/alloc-stack SynPair)]
                         (set! sp sp0)
                         (ok-ep (mk-expr (EComptime (load (field sp e))) elo ehi esrc ectxt)
                                (load (load (field sp
                                                   t))))))))
      ; Type ascription `(: value type)`: check `inner` against `ty` (so a stranded type
      ; arg can be supplied and any legal coercion applies), then LOWER it away — the
      ; result is the coerced inner value at `ty`, so no EAscribe node reaches mono/codegen.
      (EAscribe [ty inner]
                (let [tp (box-type a ty)]
                  (match (validate-type tp cx tps)
                    (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': type ascription: "))))
                    (Ok [_]
                        (match (check-to a inner tp env cx tps fname "ascribed value")
                          (Err [d] (err-ep d))
                          (Ok [ce] (ok-ep ce (load tp))))))))
      (EStaticRef [name]
                  (err-ep (derr (sconcat a
                                         (sconcat4 a "in '" fname "': internal: unexpected static-ref '" name)
                                         "' in input"))))
      (ETypeQuery [q ty]
                  (let [tp (box-type a ty)]
                    (match (validate-type tp cx tps)
                      (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': type reflection: "))))
                      (Ok [_]
                          (ok-ep (mk-expr (ETypeQuery q ty) elo ehi esrc ectxt)
                                 (if (<= q (primitive/cast i64 1)) (TInt 64 true) (TBool)))))))
      (EFieldMeta [meta ty idx]
                  (let [tp (box-type a ty)]
                    (match (validate-type tp cx tps)
                      (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': field reflection: "))))
                      (Ok [_]
                          (match (do-synth a idx (box-type a (TInt 64 true)) env cx tps fname)
                            (Err [d] (err-ep d))
                            (Ok [sp0]
                                (let [sp (primitive/alloc-stack SynPair)]
                                  (set! sp sp0)
                                  (if (not (type-is-int (load (field sp t))))
                                      (err-ep (derr (sconcat a
                                                             (sconcat3 a
                                                                       "in '"
                                                                       fname
                                                                       "': field index must be an integer, got ")
                                                             (ty-str a (load (field sp t))))))
                                      (ok-ep (mk-expr (EFieldMeta
                                                        :meta meta
                                                        :ty ty
                                                        :idx (load (field sp e)))
                                                      elo
                                                      ehi
                                                      esrc
                                                      ectxt)
                                             (if (= meta (primitive/cast i64 1))
                                                 (TInt 64 true)
                                                 (TSlice (box-type a (TInt 8 false)))))))))))))
      (EQuote [form] (ok-ep (mk-expr (EQuote form) elo ehi esrc ectxt) (TCode)))
      (EQuasi [q]
              (let [qp (primitive/alloc-stack Quasi)]
                (set! qp q)
                (match (check-quasi a qp env cx tps fname)
                  (Err [d] (err-ep d))
                  (Ok [nq] (ok-ep (mk-expr (EQuasi nq) elo ehi esrc ectxt) (TCode))))))
      (ECodeOp [op args]
               (match (synth-codeop-args a op args env cx tps fname)
                 (Err [d] (err-ep d))
                 (Ok [na] (ok-ep (mk-expr (ECodeOp op na) elo ehi esrc ectxt) (codeop-rty op)))))
      (EFieldIndex [ty name]
                   (let [tp (box-type a ty)]
                     (match (validate-type tp cx tps)
                       (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': field-index: "))))
                       (Ok [_]
                           (match (do-synth a name (null-type) env cx tps fname)
                             (Err [d] (err-ep d))
                             (Ok [sp0]
                                 (let [sp (primitive/alloc-stack SynPair)]
                                   (set! sp sp0)
                                   (if (not (= (type-tag (load (field sp t))) (primitive/cast i64 8)))
                                       (err-ep (derr (sconcat a
                                                              (sconcat3 a
                                                                        "in '"
                                                                        fname
                                                                        "': field-index name must be a string, got ")
                                                              (ty-str a (load (field sp t))))))
                                       (ok-ep (mk-expr (EFieldIndex ty (load (field sp e))) elo ehi esrc ectxt)
                                              (TInt 64 true))))))))))
      (EBin [op lhs rhs] (synth-binop a op lhs rhs false env cx tps fname elo ehi esrc ectxt))
      (ENot [inner]
            (match (do-synth a inner (null-type) env cx tps fname)
              (Err [d] (err-ep d))
              (Ok [sp0]
                  (let [sp (primitive/alloc-stack SynPair)]
                    (set! sp sp0)
                    (if (not (numeric (load (field sp t)) tps))
                        (err-ep (derr (sconcat a
                                               (sconcat3 a "in '" fname "': inot requires an integer, got ")
                                               (ty-str a (load (field sp t))))))
                        (ok-ep (mk-expr (ENot (load (field sp e))) elo ehi esrc ectxt)
                               (load (load (field sp
                                                  t)))))))))
      (ECmp [op lhs rhs] (synth-binop a op lhs rhs true env cx tps fname elo ehi esrc ectxt))
      (ELoop [label body] (synth-loop a label body expected env cx tps fname elo ehi esrc ectxt))
      (EBreak [label value] (synth-break a label value env cx tps fname elo ehi esrc ectxt))
      (EContinue [label] (synth-continue a label cx fname elo ehi esrc ectxt))
      (EIf [cnd thn els] (synth-if a cnd thn els expected env cx tps fname elo ehi esrc ectxt))
      (EDo [body] (synth-do a body expected env cx tps fname elo ehi esrc ectxt))
      (ELet [binds body] (synth-let a binds body expected env cx tps fname elo ehi esrc ectxt))
      (ECall [func type_args args]
             (synth-call a func (.nid e) type_args args expected env cx tps fname elo ehi esrc ectxt))
      (ENamedCall [func type_args names args]
                  (synth-named-call a func type_args names args expected env cx tps fname elo ehi esrc ectxt))
      (EAlloc [storage ty init]
              (let [tp (box-type a ty)]
                (match (validate-type tp cx tps)
                  (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': alloc: "))))
                  (Ok [_]
                      (if (= (primitive/cast i64 init) 0)
                          (ok-ep (mk-expr (EAlloc storage ty init) elo ehi esrc ectxt) (TPtr (box-type a ty)))
                          (match (check-to a init tp env cx tps fname "alloc-static initializer")
                            (Err [d] (err-ep (prefix-diag a d "alloc-static initializer: ")))
                            (Ok [checked]
                                (ok-ep (mk-expr (EAlloc storage
                                                        ty
                                                        (box-expr a checked))
                                                elo
                                                ehi
                                                esrc
                                                ectxt)
                                       (TPtr (box-type a ty))))))))))
      (EField [pp ffld] (synth-field a pp ffld env cx tps fname elo ehi esrc ectxt))
      (ELoad [inner]
             (match (do-synth a inner (null-type) env cx tps fname)
               (Err [d] (err-ep d))
               (Ok [sp0]
                   (let [sp (primitive/alloc-stack SynPair)]
                     (set! sp sp0)
                     (let [pp (place-pointee (load (field sp t)))]
                       (if (!= (primitive/cast i64 pp) (primitive/cast i64 0))
                           (ok-ep (mk-expr (ELoad (load (field sp e))) elo ehi esrc ectxt) (load pp))
                           (err-ep (derr (sconcat a
                                                  (sconcat3 a
                                                            "in '"
                                                            fname
                                                            "': load expects a pointer or reference, got ")
                                                  (ty-str a (load (field sp t))))))))))))
      (EStore [pp val] (synth-store a pp val false env cx tps fname elo ehi esrc ectxt))
      (EInitStore [pp val] (synth-store a pp val true env cx tps fname elo ehi esrc ectxt))
      (EIndex [pp idx] (synth-index a pp idx env cx tps fname elo ehi esrc ectxt))
      (ECast [ty inner] (synth-cast a ty inner env cx tps fname elo ehi esrc ectxt))
      (ESizeOf [ty]
               (let [tp (box-type a ty)]
                 (match (validate-type tp cx tps)
                   (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': sizeof: "))))
                   (Ok [_] (ok-ep (mk-expr (ESizeOf ty) elo ehi esrc ectxt) (TInt 64 true))))))
      (EAlignOf [ty]
                (let [tp (box-type a ty)]
                  (match (validate-type tp cx tps)
                    (Err [d] (err-ep (prefix-diag a d (sconcat3 a "in '" fname "': alignof: "))))
                    (Ok [_] (ok-ep (mk-expr (EAlignOf ty) elo ehi esrc ectxt) (TInt 64 true))))))
      (EOffsetOf [ty ffld] (synth-offsetof a ty ffld cx tps fname elo ehi esrc ectxt))
      (EBitGet [pp bfld]
               (match (bit-field-type a pp bfld env cx tps fname)
                 (Err [d] (err-ep d))
                 (Ok [sp0]
                     (let [sp (primitive/alloc-stack SynPair)]
                       (set! sp sp0)
                       (ok-ep (mk-expr (EBitGet (load (field sp e)) bfld) elo ehi esrc ectxt)
                              (load (load (field sp t))))))))
      (EBitSet [pp bfld val]
               (match (bit-field-type a pp bfld env cx tps fname)
                 (Err [d] (err-ep d))
                 (Ok [sp0]
                     (let [sp (primitive/alloc-stack SynPair)]
                       (set! sp sp0)
                       (let [fty (load (field sp t))]
                         (match (do-synth a val fty env cx tps fname)
                           (Err [d] (err-ep d))
                           (Ok [vsp0]
                               (let [vsp (primitive/alloc-stack SynPair)]
                                 (set! vsp vsp0)
                                 (match (coerce a
                                                (load (load (field vsp e)))
                                                (load (field vsp t))
                                                fty
                                                false
                                                fname
                                                (sconcat a (sconcat3 a "set! into bitfield '" bfld "'") ""))
                                   (Err [d] (err-ep d))
                                   (Ok [ve]
                                       (ok-ep (mk-expr (EBitSet
                                                         :p (load (field sp e))
                                                         :fname bfld
                                                         :val (box-expr a ve))
                                                       elo
                                                       ehi
                                                       esrc
                                                       ectxt)
                                              (load fty))))))))))))
      (EFree [inner]
             (match (do-synth a inner (null-type) env cx tps fname)
               (Err [d] (err-ep d))
               (Ok [sp0]
                   (let [sp (primitive/alloc-stack SynPair)]
                     (set! sp sp0)
                     (if (type-is-ptr (load (field sp t)))
                         (ok-ep (mk-expr (EFree (load (field sp e))) elo ehi esrc ectxt) (TInt 64 true))
                         (err-ep (derr (sconcat a
                                                (sconcat3 a "in '" fname "': free expects a pointer, got ")
                                                (ty-str a (load (field sp t)))))))))))
      (EErase [trait_name inner]
              (match (do-synth a inner (null-type) env cx tps fname)
                (Err [d] (err-ep d))
                (Ok [sp0]
                    (let [sp (primitive/alloc-stack SynPair)]
                      (set! sp sp0)
                      (match (build-make-dyn a
                                             cx
                                             trait_name
                                             (load (field sp e))
                                             (load (field sp t))
                                             elo
                                             ehi
                                             esrc
                                             ectxt
                                             fname)
                        (Err [d] (err-ep d))
                        (Ok [mp0]
                            (let [mp (primitive/alloc-stack SynPair)]
                              (set! mp mp0)
                              (ok-ep (load (load (field mp e)))
                                     (load (load (field mp
                                                        t)))))))))))
      (EMatch [scrut arms] (synth-match a scrut arms expected env cx tps fname elo ehi esrc ectxt))
      (EFnPtrOf [name] (synth-fnptr a name cx fname elo ehi esrc ectxt))
      (ECallPtr [fp args] (synth-callptr a fp args env cx tps fname elo ehi esrc ectxt))
      (EConstruct [sum variant args]
                  (match (synth-construct a
                                          variant
                                          (box-items-type a)
                                          args
                                          (null-type)
                                          env
                                          cx
                                          tps
                                          fname
                                          elo
                                          ehi
                                          esrc
                                          ectxt)
                    (Err [d] (err-ep d))
                    (Ok [rv] (let [r (primitive/alloc-stack EvalPair)] (set! r rv) (ok-ep (.e r) (TStruct sum))))))
      (EMakeDyn [dyn_struct vtable_struct methods inner] (ok-ep (load e) (TStruct dyn_struct)))
      (EDynDispatch [ds vt mi cc params ret recv args] (ok-ep (load e) ret))
      ; Named struct construction materializes checked field values inside a
      ; generated let/store tree and checks that tree once more. An aggregate
      ; call argument may already have been normalized to a spill reference, so
      ; preserve that checker-owned place while rechecking its inner value.
      (ESpillRef [inner]
                 (match (do-synth a inner (null-type) env cx tps fname)
                   (Err [d] (err-ep d))
                   (Ok [sp0]
                       (let [sp (primitive/alloc-stack SynPair)]
                         (store! sp sp0)
                         (ok-ep (mk-expr (ESpillRef (load (field sp e))) elo ehi esrc ectxt)
                                (TRef false (box-type a (load (load (field sp t))))))))))
      (EMovePlace [place]
                  (match (do-synth a
                                   (box-expr a (mk-expr (ELoad place) elo ehi esrc ectxt))
                                   expected
                                   env
                                   cx
                                   tps
                                   fname)
                    (Err [d] (err-ep d))
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)]
                          (store! sp sp0)
                          (ok-ep (load (field sp e)) (load (load (field sp t)))))))))))

; synth — span-fill + auto dyn-coercion wrapper.
(defn synth [(a (dyn Allocator))
             (e (ptr Expr))
             (expected (ptr Type))
             (env (ptr (ArrayList EnvEntry)))
             (cx (ptr Cx))
             (tps (ptr (ArrayList (slice u8))))
             (fname (slice u8))] (-> (Result EvalPair Diag))
  (let [dynt (if (expected-some? expected) (is-dyn-target expected cx) false)]
    (match (synth-inner a e expected env cx tps fname)
      (Err [d]
           (err-ep (dwspan d
                           (.source e)
                           (.lo e)
                           (.hi e)
                           (.ctxt e))))
      (Ok [rv]
          (if (not dynt)
              (Ok [EvalPair Diag] rv)
              (let [r (primitive/alloc-stack EvalPair)]
                (set! r rv)
                (match (maybe-coerce-dyn a
                                         cx
                                         (box-expr a (.e r))
                                         (box-type a (.t r))
                                         expected
                                         (.lo e)
                                         (.hi e)
                                         (.source e)
                                         (.ctxt e)
                                         fname)
                  (Err [d] (err-ep d))
                  (Ok [mp0]
                      (let [mp (primitive/alloc-stack SynPair)]
                        (set! mp mp0)
                        (ok-ep (load (load (field mp e)))
                               (load (load (field mp
                                                  t)))))))))))))

; ============================ finish (Phase 3) =====================
; Static-assert conditions are synth'd + is-cond-checked. The comptime fold
; (comptime::fold_program), aggregate-const statics, (meta …) elaboration, and
; export-c symbol resolution are a separate unported subsystem: finish passes
; funcs through unchanged (a no-op fold for comptime-free programs — any program
; that actually USES comptime will then mismatch the reference and fail the gate,
; never silently pass), and hard-errors on (meta …)/(export-c …) which the dump
; would otherwise misrepresent. Aggregate-const statics do not affect the dump
; (the dumper hardcodes an empty (statics) section), so static_consts are ignored.
(defn finish-asserts [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result (ptr (ArrayList StaticAssert))
                                                                                          Diag))
  (let [as (load (field prog asserts))
        n (al-len [StaticAssert] (load as))
        (mut out) (al-new [StaticAssert] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false
        empty-tps (box-al [(slice u8)] a (al-new [(slice u8)] a))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ap (al-elem [StaticAssert] as (load i))
                      env (env-new a)]
                  (match (do-synth a (field ap cnd) (null-type) env cx empty-tps "static-assert")
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)]
                          (set! sp sp0)
                          (if (not (is-cond (load (field sp t))))
                              (do
                                (set! err
                                      (derr (sconcat a
                                                     "static-assert: condition must be a bool or integer, got "
                                                     (ty-str a (load (field sp t))))))
                                (set! failed true)
                                (break))
                              (let [na (primitive/alloc-stack StaticAssert)]
                                (set! (.cnd na) (load (load (field sp e))))
                                (set! (.msg na) (.msg ap))
                                (al-push! (mut out) (load na))
                                0))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed)
        (Err [(ptr (ArrayList StaticAssert)) Diag] (load err))
        (Ok (box-al [StaticAssert] a (load out))))))

; ---- finish: (meta …) elaboration + (export-c …) symbol resolution ----
; display_name: strip the auto-referred coil.core. prefix in diagnostics.
(defn display-name [(n (slice u8))] (-> (slice u8))
  (let [pfx "coil.core."
        pl (slice-len pfx)]
    (if (and (>= (slice-len n) pl) (= (subslice n 0 pl) pfx)) (subslice n pl (slice-len n)) n)))

; whether convention `cc` uses a :shim lowering (the C ABI needs a native lowering).
(defn conv-cc-is-shim [(cx (ptr Cx)) (cc (slice u8))] (-> bool)
  (let [cv (conv-find cx cc)] (and (!= (primitive/cast i64 cv) (primitive/cast i64 0)) (conv-is-shim cv))))

; a valid export-c PARAMETER type: scalars/ptr, or a C-layout struct (not a defsum).
(defn export-param-ok [(cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (let [tg (type-tag t)]  ; tg 14 = externref (a wasm reference scalar)
    (if (or (= tg (primitive/cast i64 14))
            (or (= tg (primitive/cast i64 0))
                (or (= tg (primitive/cast i64 1))
                    (or (= tg (primitive/cast i64 2))
                        (or (= tg
                               (primitive/cast i64 4))
                            ; A native function pointer is one C scalar pointer.
                            ; Its exact signature and calling convention remain
                            ; in TFn for call-site checking and header emission.
                            (= tg (primitive/cast i64 10)))))))
        true
        (if (= tg (primitive/cast i64 6))
            (= (primitive/cast i64 (sum-find cx (type-struct-name t))) (primitive/cast i64 0))
            false))))

; a valid export-c RETURN type: scalars/ptr/void, or a C-layout struct/App (not a defsum).
(defn export-ret-ok [(cx (ptr Cx)) (t (ptr Type))] (-> bool)
  (let [tg (type-tag t)]  ; tg 14 = externref (a wasm reference scalar)
    (if (or (= tg (primitive/cast i64 14))
            (or (= tg (primitive/cast i64 0))
                (or (= tg (primitive/cast i64 1))
                    (or (= tg (primitive/cast i64 2))
                        (or (= tg
                               (primitive/cast i64 3))
                            (= tg
                               (primitive/cast i64
                                               4)))))))
        true
        (if (or (= tg (primitive/cast i64 6)) (= tg (primitive/cast i64 11)))
            (= (primitive/cast i64
                               (sum-find cx (if (= tg (primitive/cast i64 6)) (type-struct-name t) (t-app-name t))))
               (primitive/cast i64 0))
            false))))

; the default C symbol: bare name (module dropped) with `-` -> `_`.
(defn default-c-symbol [(a (dyn Allocator)) (qualified (slice u8))] (-> (slice u8))
  (let [base (last-component qualified)
        n (slice-len base)
        (mut buf) (al-new [u8] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [c (slice-get base (load i))]
                  (al-push! (mut buf)
                            (if (= (primitive/cast i64 c)
                                   (primitive/cast i64 45))
                                (primitive/cast u8 95)
                                c)))
                (set! i (primitive/iadd (load i) 1)))))
    (al-slice [u8] (load buf))))

(defn c-ident-char? [(c i64) (first bool)] (-> bool)
  (or (= c (primitive/cast i64 95))
      (or (and (>= c (primitive/cast i64 65)) (<= c (primitive/cast i64 90)))
          (or (and (>= c (primitive/cast i64 97)) (<= c (primitive/cast i64 122)))
              (and (not first) (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57))))))))

(defn is-c-ident [(s (slice u8))] (-> bool)
  (let [n (slice-len s)]
    (if (= n (primitive/cast i64 0))
        false
        (let [(mut ok) (c-ident-char? (primitive/cast i64 (slice-get s 0)) true)
              (mut i) 1]
          (loop (if (or (not (load ok)) (>= (load i) n))
                    (break)
                    (do
                      (unless (c-ident-char? (primitive/cast i64 (slice-get s (load i))) false)
                        (store! ok
                                false)
                        0)
                      (set! i (primitive/iadd (load i) 1)))))
          (load ok)))))

(defn fn-param-types [(a (dyn Allocator)) (ps (ptr (ArrayList Param)))] (-> (ptr (ArrayList Type)))
  (let [n (al-len [Param] (load ps))
        (mut out) (al-new [Type] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (.ty (al-elem [Param] ps (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

(defn export-first-bad-param [(cx (ptr Cx)) (ps (ptr (ArrayList Param)))] (-> (ptr Param))
  (let [n (al-len [Param] (load ps))
        (mut i) 0
        (mut r) (primitive/cast (ptr Param) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [pp (al-elem [Param] ps (load i))]
                  (when (not (export-param-ok cx (field pp ty))) (store! r pp) (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn export-param-msg [(a (dyn Allocator)) (dn (slice u8)) (pname (slice u8)) (t (ptr Type))] (-> (slice u8))
  (sconcat a
           (sconcat3 a "export-c: '" dn "' parameter '")
           (sconcat a
                    pname
                    (sconcat a
                             "' has type "
                             (sconcat a
                                      (ty-str a t)
                                      ", which has no C representation (a slice, sum, SIMD vector, or generic instantiation can't cross the C boundary — take a `(ptr …)` or lower it to a C-layout struct)")))))

; validate ONE export and finalize its C symbol; returns the resolved ExportC.
(defn validate-export [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program)) (ep (ptr ExportC))] (-> (Result ExportC
                                                                                                              Diag))
  (try (let [ename (load (field ep name))
             dn (display-name ename)
             elo (load (field ep lo))
             ehi (load (field ep hi))
             esrc (load (field ep source))
             f (prog-fn-find prog ename)]
         (when (= (primitive/cast i64 f) (primitive/cast i64 0))
           (break :try
                    (Err [ExportC Diag]
                         (derr-at-src esrc elo ehi (sconcat3 a "export-c: unknown function '" dn "'")))))
         (when (> (al-len [(slice u8)] (load (field f type_params))) (primitive/cast i64 0))
           (break :try
                    (Err [ExportC Diag]
                         (derr-at-src esrc
                                      elo
                                      ehi
                                      (sconcat3 a
                                                "export-c: '"
                                                dn
                                                "' is generic — a generic function has no single C symbol; export a concrete wrapper instead")))))
         (when (conv-cc-is-shim cx (load (field f cc)))
           (break :try
                    (Err [ExportC Diag]
                         (derr-at-src esrc
                                      elo
                                      ehi
                                      (sconcat3 a
                                                "export-c: '"
                                                dn
                                                "' uses a :shim convention, which isn't the C ABI")))))
         (let [bp (export-first-bad-param cx (load (field f params)))]
           (when (!= (primitive/cast i64 bp) (primitive/cast i64 0))
             (break :try
                      (Err [ExportC Diag]
                           (derr-at-src esrc
                                        elo
                                        ehi
                                        (export-param-msg a
                                                          dn
                                                          (load (field bp name))
                                                          (field bp
                                                                 ty)))))))
         (when (not (export-ret-ok cx (field f ret)))
           (break :try
                    (Err [ExportC Diag]
                         (derr-at-src esrc
                                      elo
                                      ehi
                                      (sconcat a
                                               (sconcat3 a "export-c: '" dn "' returns ")
                                               (sconcat a
                                                        (ty-str a (field f ret))
                                                        ", which has no C representation"))))))
         (let [sym (match (load (field ep symbol)) (Some [s] s) (None [] (default-c-symbol a ename)))]
           (when (not (is-c-ident sym))
             (break :try
                      (Err [ExportC Diag]
                           (derr-at-src esrc
                                        elo
                                        ehi
                                        (sconcat a
                                                 (sconcat3 a "export-c: '" dn "' → '")
                                                 (sconcat a
                                                          sym
                                                          "' isn't a valid C identifier; give one with :as \"name\""))))))
           (let [ec (primitive/alloc-stack ExportC)]
             (store! (field ec name) ename)
             (store! (field ec symbol) (Some [(slice u8)] sym))
             (store! (field ec params) (fn-param-types a (load (field f params))))
             (store! (field ec lo) elo)
             (store! (field ec hi) ehi)
             (store! (field ec source) (load (field ep source)))
             (store! (field ec ctxt) (load (field ep ctxt)))
             (Ok [ExportC Diag] (load ec)))))))

(defn finish-metas [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result (ptr (ArrayList Expr)) Diag))
  (let [ms (load (field prog metas))
        n (al-len [Expr] (load ms))
        (mut out) (al-new [Expr] a)
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false
        empty-tps (box-al [(slice u8)] a (al-new [(slice u8)] a))]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [mp (al-elem [Expr] ms (load i))
                      env (env-new a)]
                  (match (do-synth a mp (null-type) env cx empty-tps "meta")
                    (Err [d] (do (set! err d) (set! failed true) (break)))
                    (Ok [sp0]
                        (let [sp (primitive/alloc-stack SynPair)]
                          (set! sp sp0)
                          (if (not (= (type-tag (load (field sp t))) (primitive/cast i64 13)))
                              (do
                                (set! err
                                      (derr (sconcat a
                                                     "meta: expression must produce Code, got "
                                                     (ty-str a (load (field sp t))))))
                                (set! failed true)
                                (break))
                              (do (al-push! (mut out) (load (load (field sp e)))) 0))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList Expr)) Diag] (load err)) (Ok (box-al [Expr] a (load out))))))

(defn finish-exports [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program))] (-> (Result (ptr (ArrayList ExportC))
                                                                                          Diag))
  (let [es (load (field prog exports))
        n (al-len [ExportC] (load es))
        (mut out) (al-new [ExportC] a)
        seenb (box! a SBox (primitive/zeroed SBox))
        (mut i) 0
        (mut err) (primitive/zeroed Diag)
        (mut failed) false]
    (set! (.items seenb) (al-new [(slice u8)] a))
    (loop (if (>= (load i) n)
              (break)
              (do
                (match (validate-export a cx prog (al-elem [ExportC] es (load i)))
                  (Err [d] (do (set! err d) (set! failed true) (break)))
                  (Ok [ec0]
                      (let [ec (primitive/alloc-stack ExportC)]
                        (set! ec ec0)
                        (let [sym (match (.symbol ec) (Some [s] s) (None [] ""))]
                          (if (set-contains (field seenb items) sym)
                              (do
                                (set! err
                                      (derr-at-src (.source ec)
                                                   (.lo ec)
                                                   (.hi ec)
                                                   (sconcat3 a
                                                             "export-c: two functions export the same C symbol '"
                                                             sym
                                                             "'")))
                                (set! failed true)
                                (break))
                              (do (al-push! (mut (.items seenb)) sym) (al-push! (mut out) (load ec))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (if (load failed) (Err [(ptr (ArrayList ExportC)) Diag] (load err)) (Ok (box-al [ExportC] a (load out))))))

(defn finish [(a (dyn Allocator)) (cx (ptr Cx)) (prog (ptr Program)) (funcs (ptr (ArrayList Func)))] (-> (Result (ptr Program)
                                                                                                                 Diag))
  (match (finish-asserts a cx prog)
    (Err [d] (Err [(ptr Program) Diag] d))
    (Ok [asserts]
        (match (finish-metas a cx prog)
          (Err [d] (Err [(ptr Program) Diag] d))
          (Ok [metas]
              (match (finish-exports a cx prog)
                (Err [d] (Err [(ptr Program) Diag] d))
                (Ok [exports]
                    (let [out (box! a Program (primitive/zeroed Program))]
                      (set! (.annotation_defs out) (load (field prog annotation_defs)))
                      (set! (.conventions out) (load (field prog conventions)))
                      (set! (.structs out) (load (field prog structs)))
                      (set! (.sums out) (load (field prog sums)))
                      (set! (.externs out) (load (field prog externs)))
                      (set! (.funcs out) funcs)
                      (set! (.asserts out) asserts)
                      (set! (.consts out) (load (field prog consts)))
                      (set! (.traits out) (load (field prog traits)))
                      (set! (.impls out) (load (field prog impls)))
                      (set! (.metas out) metas)
                      (set! (.exports out) exports)
                      (set! (.mono_trait_uses out)
                        (box-al [MonoTraitUse] a (.trait_uses cx)))
                      (let [(mut abis) (al-new [Extern] a)
                            ns (al-len [Sig] (.sigs cx))]
                        (for [i 0 ns]
                          (let [sig (al-elem [Sig] (mut (.sigs cx)) i)]
                            (if (and (not (.is_extern sig))
                                     (= (al-len [(slice u8)] (.type_params sig)) 0))
                                (let [surface (primitive/alloc-stack Extern)]
                                  (set! (.name surface) (.name sig))
                                  (set! (.cc surface) (.cc sig))
                                  (set! (.params surface) (.params sig))
                                  (set! (.variadic surface) false)
                                  (set! (.ret surface) (.ret sig))
                                  (al-push! (mut abis) (load surface)))
                                0)))
                        (set! (.function_abis out) (box-al [Extern] a (load abis))))
                      ; Phase 3 comptime fold: replace every
                      ; `(comptime …)` in a function body / static-assert with its literal.
                      ; A no-op for comptime-free programs (bootstrap + IR corpus unaffected).
                      (match (fold-program out (load (field out asserts)) a)
                        (Err [d] (Err [(ptr Program) Diag] d))
                        (Ok [_] (Ok out)))))))))))

; ============================ the check pass ===================
; check-program: setup (Phase 1, fail-fast) ->
; check_func over every function (Phase 2; FIRST error wins, matching the oracle's
; dump_error of diagnostics[0]) -> finish (Phase 3). Returns the typed/elaborated/
; LOWERED Program, or Err(diag) dumped canonically.
; Check every function body. Mirrors check_with Phase 2: it collects
; ALL body errors (checking continues past a failing function) into `diags`, so the
; build path can render every error (`N errors`). The single-Diag return keeps the
; dump-checked oracle unchanged (it reports diagnostics[0]).
; a function whose BODY failed to resolve (resolve poisoned it): its signature is in the
; table so callers resolve, but there is no point type-checking a body full of unresolved
; names — that only produces derivative noise on top of the resolve error already reported.
(defn func-poisoned? [(s (mut LS)) (nm (slice u8))] (-> bool)
  (let [pp (load (field s resolve_poisoned))]
    (if (= (primitive/cast i64 pp) (primitive/cast i64 0))
        false
        (let [n (al-len [(slice u8)] pp)
              (mut i) 0
              (mut r) false]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (when (= (al-get [(slice u8)] pp (load i)) nm) (store! r true) (break))
                      (set! i (primitive/iadd (load i) 1)))))
          (load r)))))

; ============================ affine ownership validation ===================
; This first ownership pass tracks whole bindings only. It intentionally rejects
; ownership that is consumed on only one control-flow path and ownership carried
; around a loop; projection-aware partial moves and conditional drop flags are a
; later extension. Binding identity comes from the authoritative checker side map,
; so shadowed names can never alias this state accidentally.
(defstruct MoveState
  [(bid i64)
   (moved bool)
   (name (slice u8))
   (ty (ptr Type))
   (lo i64)
   (hi i64)
   (source i64)
   (ctxt i64)])

(defstruct OwnershipLoop
  [(label (Option (slice u8)))
   ; Number of owners live outside the loop. Exiting to this loop drops every
   ; currently-live owner at an index greater than or equal to this depth.
   (owner_depth i64)])

(defn ownership-register! [(states (ptr (ArrayList MoveState)))
                           (bid i64)
                           (name (slice u8))
                           (ty (ptr Type))
                           (lo i64)
                           (hi i64)
                           (source i64)
                           (ctxt i64)] (-> i64)
  (when (and (> bid (primitive/cast i64 0))
             (= (primitive/cast i64 (move-state-find states bid)) (primitive/cast i64 0)))
    (let [st (primitive/alloc-stack MoveState)]
      (set! (.bid st) bid)
      (set! (.moved st) false)
      (set! (.name st) name)
      (set! (.ty st) ty)
      (set! (.lo st) lo)
      (set! (.hi st) hi)
      (set! (.source st) source)
      (set! (.ctxt st) ctxt)
      (al-push! [MoveState] states (load st)))
    0)
  0)

(defn move-states-clone [(a (dyn Allocator))
                         (src (ptr (ArrayList MoveState)))] (-> (ptr (ArrayList MoveState)))
  (let [(mut out) (al-new [MoveState] a)
        n (al-len [MoveState] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (al-get [MoveState] (load src) (load i)))
                (store! i (primitive/iadd (load i) 1)))))
    (box-al [MoveState] a (load out))))

(defn move-state-find [(states (ptr (ArrayList MoveState))) (bid i64)] (-> (ptr MoveState))
  (let [n (al-len [MoveState] (load states))
        (mut i) 0
        (mut found) (primitive/cast (ptr MoveState) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (.bid (al-elem [MoveState] states (load i))) bid)
                  (store! found (al-elem [MoveState] states (load i)))
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn move-state-find-name [(states (ptr (ArrayList MoveState)))
                            (name (slice u8))] (-> (ptr MoveState))
  (let [(mut i) (primitive/isub (al-len [MoveState] (load states)) 1)
        (mut found) (primitive/cast (ptr MoveState) 0)]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (let [st (al-elem [MoveState] states (load i))]
                (if (= (.name st) name)
                    (do (store! found st) (break))
                    (set! i (primitive/isub (load i) 1))))))
    (load found)))

(defn move-states-merge! [(dst (ptr (ArrayList MoveState)))
                          (src (ptr (ArrayList MoveState)))] (-> i64)
  (let [n (al-len [MoveState] (load src))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [from (al-elem [MoveState] src (load i))]
                  (when (.moved from)
                    (let [to (move-state-find dst (.bid from))]
                      (if (= (primitive/cast i64 to) (primitive/cast i64 0))
                          (al-push! [MoveState] dst (load from))
                          (unless (.moved to)
                            (set! (.moved to) true)
                            (set! (.name to) (.name from))
                            (set! (.lo to) (.lo from))
                            (set! (.hi to) (.hi from))
                            (set! (.source to) (.source from))
                            (set! (.ctxt to) (.ctxt from))
                            0)))))
                (store! i (primitive/iadd (load i) 1)))))
    0))

(defn move-state-moved? [(states (ptr (ArrayList MoveState))) (bid i64)] (-> bool)
  (let [st (move-state-find states bid)]
    (and (!= (primitive/cast i64 st) (primitive/cast i64 0)) (.moved st))))

(defn ownership-state-mismatch [(left (ptr (ArrayList MoveState)))
                                (right (ptr (ArrayList MoveState)))] (-> (ptr MoveState))
  (let [ln (al-len [MoveState] (load left))
        rn (al-len [MoveState] (load right))
        (mut i) 0
        (mut mismatch) (primitive/cast (ptr MoveState) 0)]
    (loop (if (>= (load i) ln)
              (break)
              (let [st (al-elem [MoveState] left (load i))]
                (when (!= (.moved st) (move-state-moved? right (.bid st)))
                  (store! mismatch st)
                  (break))
                (store! i (primitive/iadd (load i) 1)))))
    (when (= (primitive/cast i64 (load mismatch)) (primitive/cast i64 0))
      (store! i 0)
      (loop (if (>= (load i) rn)
                (break)
                (let [st (al-elem [MoveState] right (load i))]
                  (when (!= (.moved st) (move-state-moved? left (.bid st)))
                    (store! mismatch st)
                    (break))
                  (store! i (primitive/iadd (load i) 1))))))
    (load mismatch)))

(defn ownership-require-same-states [(a (dyn Allocator))
                                     (left (ptr (ArrayList MoveState)))
                                     (right (ptr (ArrayList MoveState)))
                                     (fname (slice u8))
                                     (reason (slice u8))] (-> (Result i64 Diag))
  (let [st (ownership-state-mismatch left right)]
    (if (= (primitive/cast i64 st) (primitive/cast i64 0))
        (Ok [i64 Diag] 0)
        (Err [i64 Diag]
             (derr-at-src (.source st)
                          (.lo st)
                          (.hi st)
                          (sconcat a
                                   (sconcat3 a "in '" fname "': ownership of '")
                                   (sconcat a
                                            (sconcat3 a (.name st) "' differs " reason)
                                            (sconcat3 a " (owner type " (ty-str a (.ty st)) ")"))))))))

(defn ownership-expr-type [(e (ptr Expr))] (-> (Option Type))
  (let [by-node (type-map-lookup (.nid e))]
    (match by-node
      (Some [t] (Some t))
      (None []
            (match (.kind e)
              (ELoad [inner]
                     (match (type-map-lookup (.nid inner))
                       (Some [it]
                             (match it
                               (TRef [_ pointee] (Some (load pointee)))
                               (TPtr [pointee] (Some (load pointee)))
                               (_ (None [Type]))))
                       (None [] (None [Type]))))
              (_ (None [Type])))))))

(defn ownership-expr-needs-drop [(a (dyn Allocator))
                                 (cx (ptr Cx))
                                 (e (ptr Expr))] (-> bool)
  (match (ownership-expr-type e)
    (Some [t]
          (let [tp (primitive/alloc-stack Type)]
            (set! tp t)
            (match t
              (TRef [_ inner] (type-needs-drop a cx inner))
              (_ (type-needs-drop a cx tp)))))
    (None [] false)))

(defn ownership-root-var [(e (ptr Expr))] (-> (ptr Expr))
  (match (.kind e)
    (EVar [_] e)
    (ELoad [inner] (ownership-root-var inner))
    (ESpillRef [inner] (ownership-root-var inner))
    (EMovePlace [inner] (ownership-root-var inner))
    (_ (primitive/cast (ptr Expr) 0))))

(defn ownership-place-root-var [(e (ptr Expr))] (-> (ptr Expr))
  (match (.kind e)
    (EVar [_] e)
    (ELoad [inner] (ownership-place-root-var inner))
    (ESpillRef [inner] (ownership-place-root-var inner))
    (EMovePlace [inner] (ownership-place-root-var inner))
    (EField [place _] (ownership-place-root-var place))
    (EIndex [place _] (ownership-place-root-var place))
    (_ (primitive/cast (ptr Expr) 0))))

(defn ownership-root-state [(e (ptr Expr))
                            (states (ptr (ArrayList MoveState)))] (-> (ptr MoveState))
  (let [root (ownership-place-root-var e)]
    (if (= (primitive/cast i64 root) (primitive/cast i64 0))
        (primitive/cast (ptr MoveState) 0)
        (let [bid (bind-map-lookup (.nid root))]
          (if (> bid (primitive/cast i64 0))
              (move-state-find states bid)
              (match (.kind root)
                (EVar [name] (move-state-find-name states name))
                (_ (primitive/cast (ptr MoveState) 0))))))))

; Type of a place projection rooted in `root-type`. Whole-binding move checking
; deliberately treats a consumed projection as consuming its owner; overwrite
; still needs the narrower projected type so it destroys exactly the replaced
; field or array element.
(defn ownership-place-type [(a (dyn Allocator))
                            (cx (ptr Cx))
                            (place (ptr Expr))
                            (root-type (ptr Type))] (-> (Option Type))
  (match (.kind place)
    (EVar [_] (Some (load root-type)))
    (ELoad [inner] (ownership-place-type a cx inner root-type))
    (ESpillRef [inner] (ownership-place-type a cx inner root-type))
    (EMovePlace [inner] (ownership-place-type a cx inner root-type))
    (EIndex [base _]
            (match (ownership-place-type a cx base root-type)
              (Some [base-type]
                    (match base-type
                      (TArray [elem _] (Some (load elem)))
                      (_ (None [Type]))))
              (None [] (None [Type]))))
    (EField [base name]
            (match (ownership-place-type a cx base root-type)
              (Some [base-type]
                    (let [bp (primitive/alloc-stack Type)]
                      (set! bp base-type)
                      (match (struct-fields a bp cx)
                        (Ok [fields]
                            (let [(mut i) 0
                                  (mut result) (None [Type])]
                              (loop (if (>= (load i) (al-len [Field] (load fields)))
                                        (break)
                                        (let [fp (al-elem [Field] fields (load i))]
                                          (if (= (.name fp) name)
                                              (do (set! result (Some (load (field fp ty)))) (break))
                                              (set! i (primitive/iadd (load i) 1))))))
                              (load result)))
                        (Err [_] (None [Type])))))
              (None [] (None [Type]))))
    (_ (None [Type]))))

(defn ownership-load-direct-place! [(a (dyn Allocator))
                                    (value (ptr Expr))
                                    (states (ptr (ArrayList MoveState)))] (-> i64)
  (match (.kind value)
    (EVar [_]
          (when (!= (primitive/cast i64 (ownership-root-state value states))
                    (primitive/cast i64 0))
            (let [saved (box-expr a (load value))]
              (set! (.kind value) (ELoad saved))
              0)))
    (_ 0))
  0)

(defn ownership-consume-root! [(a (dyn Allocator))
                               (e (ptr Expr))
                               (states (ptr (ArrayList MoveState)))
                               (fname (slice u8))] (-> (Result i64 Diag))
  (let [root (ownership-root-var e)]
    (if (= (primitive/cast i64 root) (primitive/cast i64 0))
        (Ok [i64 Diag] 0)
        (let [bid (bind-map-lookup (.nid root))
              old
                (if (> bid (primitive/cast i64 0))
                    (move-state-find states bid)
                    (match (.kind root)
                      (EVar [name] (move-state-find-name states name))
                      (_ (primitive/cast (ptr MoveState) 0))))]
          (if (and (<= bid (primitive/cast i64 0))
                   (= (primitive/cast i64 old) (primitive/cast i64 0)))
              (Ok [i64 Diag] 0)
              (let []
                (if (and (!= (primitive/cast i64 old) (primitive/cast i64 0)) (.moved old))
                    (Err [i64 Diag]
                         (derr-at-src (.source root)
                                      (.lo root)
                                      (.hi root)
                                      (sconcat a
                                               (sconcat3 a "in '" fname "': use of moved value '")
                                               (sconcat a (.name old) "'"))))
                    (do
                      ; Every affine parameter/let owner is registered at its
                      ; lexical introduction. An unregistered root is therefore
                      ; a Copy binding or non-owning compiler temporary.
                      (unless (= (primitive/cast i64 old) (primitive/cast i64 0))
                        (set! (.moved old) true)
                        0)
                      (Ok [i64 Diag] 0)))))))))

(defn ownership-require-live-root [(a (dyn Allocator))
                                   (e (ptr Expr))
                                   (states (ptr (ArrayList MoveState)))
                                   (fname (slice u8))] (-> (Result i64 Diag))
  (let [st (ownership-root-state e states)]
    (if (and (!= (primitive/cast i64 st) (primitive/cast i64 0)) (.moved st))
        (Err [i64 Diag]
             (derr-at-src (.source e)
                          (.lo e)
                          (.hi e)
                          (sconcat a
                                   (sconcat3 a "in '" fname "': use of moved value '")
                                   (sconcat a (.name st) "'"))))
        (Ok [i64 Diag] 0))))

(defn ownership-drop-call [(a (dyn Allocator))
                           (cx (ptr Cx))
                           (place (ptr Expr))
                           (ty (ptr Type))
                           (lo i64)
                           (hi i64)
                           (source i64)
                           (ctxt i64)] (-> (Option Expr))
  (if (= (primitive/cast i64 ty) (primitive/cast i64 0))
      (None [Expr])
      (let [(mut args) (al-new [Expr] a)
            arg (load place)]
        (al-push! (mut args) arg)
        (if (ownership-bound-has cx ty "coil.core.Drop")
            (match (load ty)
              (TStruct [self]
                       (Some (mk-expr (ETraitCall "coil.core.Drop"
                                                  "drop"
                                                  self
                                                  (box-al [Expr] a (load args)))
                                      lo
                                      hi
                                      source
                                      ctxt)))
              (_ (None [Expr])))
            (let [sel (primitive/alloc-stack ImplSel)]
              (set! sel (cx-impl-select a cx "coil.core.Drop" ty))
              (if (= (primitive/cast i64 (load (field sel ip))) (primitive/cast i64 0))
                  (None [Expr])
                  (let [ip (load (field sel ip))
                        binds (subst-new a)]
                    ; A generic impl method is itself generic. Cleanup synthesis
                    ; bypasses ordinary call checking, so recover the impl's type
                    ; arguments from the concrete receiver exactly as trait-call
                    ; monomorphization does.
                    (unify-trait-extras a
                                        (field ip self_type)
                                        ty
                                        (load (field ip type_params))
                                        binds)
                    (Some (mk-expr (ECall
                                     :func
                                       (tmfn a
                                             "coil.core.Drop"
                                             (impl-mangle-key a
                                                              (field ip self_type)
                                                              (load (field ip type_params)))
                                             "drop")
                                     :type_args
                                       (subst-targs a
                                                    (load (field ip type_params))
                                                    binds)
                                     :args (box-al [Expr] a (load args)))
                                   lo
                                   hi
                                   source
                                   ctxt)))))))))

(defn ownership-append-sum-glue! [(a (dyn Allocator))
                                  (cx (ptr Cx))
                                  (out (ptr (ArrayList Expr)))
                                  (place (ptr Expr))
                                  (ty (ptr Type))
                                  (lo i64)
                                  (hi i64)
                                  (source i64)
                                  (ctxt i64)] (-> bool)
  (let [svp (primitive/alloc-stack SumVars)]
    (set! svp (sum-variants a ty cx))
    (if (not (.found svp))
        false
        (let [variants (load (field svp variants))
              nv (al-len [Variant] (load variants))
              (mut arms) (al-new [Arm] a)
              (mut i) 0]
          (loop (if (>= (load i) nv)
                    (break)
                    (do
                      (let [vp (al-elem [Variant] variants (load i))
                            fields (load (field vp fields))
                            nf (al-len [Field] (load fields))
                            (mut names) (al-new [(slice u8)] a)
                            (mut drops) (al-new [Expr] a)
                            (mut j) 0]
                        (loop (if (>= (load j) nf)
                                  (break)
                                  (do
                                    (al-push! (mut names)
                                              (sconcat a
                                                       "$drop.payload."
                                                       (sconcat a
                                                                (i64->str a (load i))
                                                                (sconcat a "." (i64->str a (load j))))))
                                    (set! j (primitive/iadd (load j) 1)))))
                        (set! j (primitive/isub nf 1))
                        (loop (if (< (load j) (primitive/cast i64 0))
                                  (break)
                                  (do
                                    (let [fp (al-elem [Field] fields (load j))]
                                      (when (type-needs-drop a cx (field fp ty))
                                        (let [payload
                                                (box-expr a
                                                          (mk-expr (ESpillRef (box-expr a
                                                                                        (mk-expr (EVar (al-get [(slice u8)]
                                                                                                               (load names)
                                                                                                               (load j)))
                                                                                                 lo
                                                                                                 hi
                                                                                                 source
                                                                                                 ctxt)))
                                                                   lo
                                                                   hi
                                                                   source
                                                                   ctxt))]
                                          (ownership-append-drop-glue! a
                                                                       cx
                                                                       (mut drops)
                                                                       payload
                                                                       (field fp ty)
                                                                       lo
                                                                       hi
                                                                       source
                                                                       ctxt)
                                          0)))
                                    (set! j (primitive/isub (load j) 1)))))
                        ; Match is emitted as an ordinary value expression by all
                        ; backends. Give every cleanup arm the same disposable
                        ; scalar result; the surrounding cleanup discards it.
                        (al-push! (mut drops) (mk-expr (EInt 0) lo hi source ctxt))
                        (let [ap (primitive/alloc-stack Arm)]
                          (set! (.variant ap) (.name vp))
                          (set! (.binds ap) (box-al [(slice u8)] a (load names)))
                          (set! (.body ap)
                                (mk-expr (EDo (box-al [Expr] a (load drops))) lo hi source ctxt))
                          (al-push! (mut arms) (load ap))))
                      (set! i (primitive/iadd (load i) 1)))))
          (let [scrut (box-expr a (mk-expr (ELoad (box-expr a (load place))) lo hi source ctxt))]
            (al-push! [Expr]
                      out
                      (mk-expr (EMatch scrut (box-al [Arm] a (load arms))) lo hi source ctxt)))
          true))))

(defn ownership-append-drop-glue! [(a (dyn Allocator))
                                   (cx (ptr Cx))
                                   (out (ptr (ArrayList Expr)))
                                   (place (ptr Expr))
                                   (ty (ptr Type))
                                   (lo i64)
                                   (hi i64)
                                   (source i64)
                                   (ctxt i64)] (-> i64)
  ; User Drop runs first, while every field is still initialized. Structural
  ; field glue follows in reverse declaration order, matching lexical owners.
  (match (ownership-drop-call a cx place ty lo hi source ctxt)
    (Some [drop] (al-push! [Expr] out drop))
    (None [] 0))
  (if (ownership-append-sum-glue! a cx out place ty lo hi source ctxt)
      0
      (match (load ty)
        (TStruct [_]
                 (match (struct-fields a ty cx)
                   (Ok [fields]
                       (let [(mut i) (primitive/isub (al-len [Field] (load fields)) 1)]
                         (loop (if (< (load i) (primitive/cast i64 0))
                                   (break)
                                   (do
                                     (let [fp (al-elem [Field] fields (load i))]
                                       (when (type-needs-drop a cx (field fp ty))
                                         (let [field-place
                                                 (box-expr a
                                                           (mk-expr (EField (box-expr a (load place)) (.name fp))
                                                                    lo
                                                                    hi
                                                                    source
                                                                    ctxt))]
                                           (ownership-append-drop-glue! a
                                                                        cx
                                                                        out
                                                                        field-place
                                                                        (field fp ty)
                                                                        lo
                                                                        hi
                                                                        source
                                                                        ctxt)
                                           0)))
                                     (set! i (primitive/isub (load i) 1)))))
                         0))
                   (Err [_] 0)))
        (TApp [_ _]
              (match (struct-fields a ty cx)
                (Ok [fields]
                    (let [(mut i) (primitive/isub (al-len [Field] (load fields)) 1)]
                      (loop (if (< (load i) (primitive/cast i64 0))
                                (break)
                                (do
                                  (let [fp (al-elem [Field] fields (load i))]
                                    (when (type-needs-drop a cx (field fp ty))
                                      (let [field-place
                                              (box-expr a
                                                        (mk-expr (EField (box-expr a (load place)) (.name fp))
                                                                 lo
                                                                 hi
                                                                 source
                                                                 ctxt))]
                                        (ownership-append-drop-glue! a
                                                                     cx
                                                                     out
                                                                     field-place
                                                                     (field fp ty)
                                                                     lo
                                                                     hi
                                                                     source
                                                                     ctxt)
                                        0)))
                                  (set! i (primitive/isub (load i) 1)))))
                      0))
                (Err [_] 0)))
        (TArray [elem count]
                ; Array length is part of the type. Emit one statically indexed drop
                ; per element in reverse order, avoiding a mutable synthesized loop
                ; and giving every backend the same simple cleanup IR.
                (let [(mut i) (primitive/isub count 1)]
                  (loop (if (< (load i) (primitive/cast i64 0))
                            (break)
                            (do
                              (let [element-place
                                      (box-expr a
                                                (mk-expr (EIndex (box-expr a (load place))
                                                                 (box-expr a
                                                                           (mk-expr (EInt (load i)) lo hi source ctxt)))
                                                         lo
                                                         hi
                                                         source
                                                         ctxt))]
                                (ownership-append-drop-glue! a
                                                             cx
                                                             out
                                                             element-place
                                                             elem
                                                             lo
                                                             hi
                                                             source
                                                             ctxt)
                                0)
                              (set! i (primitive/isub (load i) 1)))))
                  0))
        (_ 0)))
  0)

(defn ownership-cleanups [(a (dyn Allocator))
                          (cx (ptr Cx))
                          (states (ptr (ArrayList MoveState)))
                          (start i64)] (-> (ptr (ArrayList Expr)))
  (let [(mut out) (al-new [Expr] a)
        (mut i) (primitive/isub (al-len [MoveState] (load states)) 1)]
    (loop (if (< (load i) start)
              (break)
              (do
                (let [st (al-elem [MoveState] states (load i))]
                  (unless (or (.moved st)
                              (not (type-needs-drop a cx (.ty st))))
                    (let [place
                            (box-expr a
                                      (mk-expr (EVar (.name st))
                                               (.lo st)
                                               (.hi st)
                                               (.source st)
                                               (.ctxt st)))]
                      (ownership-append-drop-glue! a
                                                   cx
                                                   (mut out)
                                                   place
                                                   (.ty st)
                                                   (.lo st)
                                                   (.hi st)
                                                   (.source st)
                                                   (.ctxt st))
                      0)
                    0))
                (set! i (primitive/isub (load i) 1)))))
    (box-al [Expr] a (load out))))

(defn ownership-expr-exits? [(e (ptr Expr))] (-> bool)
  (match (.kind e)
    (EBreak [_ _] true)
    (EContinue [_] true)
    (EDo [body]
         (let [tail (al-last-expr body)]
           (and (!= (primitive/cast i64 tail) (primitive/cast i64 0))
                (ownership-expr-exits? tail))))
    (ECleanup [body _] (ownership-expr-exits? body))
    (EIf [_ thn els]
         (and (ownership-expr-exits? thn) (ownership-expr-exits? els)))
    (_ false)))

(defn ownership-wrap-tail-cleanup! [(a (dyn Allocator))
                                    (body (ptr (ArrayList Expr)))
                                    (cleanups (ptr (ArrayList Expr)))
                                    (lo i64)
                                    (hi i64)
                                    (source i64)
                                    (ctxt i64)] (-> i64)
  (when (> (al-len [Expr] (load cleanups)) (primitive/cast i64 0))
    (let [n (al-len [Expr] (load body))]
      (if (= n (primitive/cast i64 0))
          (let [(mut empty) (al-new [Expr] a)]
            (al-push! [Expr]
                      body
                      (mk-expr (ECleanup :body
                                           (box-expr a (mk-expr (EDo (box-al [Expr] a (load empty))) lo hi source ctxt))
                                 :cleanups cleanups)
                               lo
                               hi
                               source
                               ctxt)))
          (let [tail (al-elem [Expr] body (primitive/isub n 1))]
            (unless (ownership-expr-exits? tail)
              (let [saved (box-expr a (load tail))]
                (set! (.kind tail) (ECleanup saved cleanups)))
              0))))
    0)
  0)

(defn ownership-loop-owner-depth [(loops (ptr (ArrayList OwnershipLoop)))
                                  (label (Option (slice u8)))] (-> i64)
  (let [(mut i) (primitive/isub (al-len [OwnershipLoop] (load loops)) 1)
        (mut found) -1]
    (loop (if (< (load i) (primitive/cast i64 0))
              (break)
              (let [lp (al-elem [OwnershipLoop] loops (load i))]
                (if (match label
                      (None [] true)
                      (Some [want]
                            (match (.label lp)
                              (Some [have] (= want have))
                              (None [] false))))
                    (do (store! found (.owner_depth lp)) (break))
                    (set! i (primitive/isub (load i) 1))))))
    (load found)))

(defn ownership-wrap-exit! [(a (dyn Allocator))
                            (cx (ptr Cx))
                            (e (ptr Expr))
                            (states (ptr (ArrayList MoveState)))
                            (depth i64)] (-> i64)
  (let [cleanups (ownership-cleanups a cx states depth)]
    (when (> (al-len [Expr] (load cleanups)) (primitive/cast i64 0))
      (match (.kind e)
        (EBreak [label value]
                (match value
                  (Some [v]
                        (let [saved (box-expr a (load v))]
                          (set! (.kind v) (ECleanup saved cleanups))))
                  (None []
                        (let [(mut seq) (al-new [Expr] a)
                              saved (load e)]
                          (for [i 0 (al-len [Expr] (load cleanups))]
                            (al-push! (mut seq) (al-get [Expr] (load cleanups) i))
                            0)
                          (al-push! (mut seq) saved)
                          (set! (.kind e) (EDo (box-al [Expr] a (load seq))))))))
        (EContinue [_]
                   (let [(mut seq) (al-new [Expr] a)
                         saved (load e)]
                     (for [i 0 (al-len [Expr] (load cleanups))]
                       (al-push! (mut seq) (al-get [Expr] (load cleanups) i))
                       0)
                     (al-push! (mut seq) saved)
                     (set! (.kind e) (EDo (box-al [Expr] a (load seq))))))
        (_ 0))
      0)
    0))

(defn ownership-walk-list [(a (dyn Allocator))
                           (cx (ptr Cx))
                           (items (ptr (ArrayList Expr)))
                           (states (ptr (ArrayList MoveState)))
                           (loops (ptr (ArrayList OwnershipLoop)))
                           (fname (slice u8))
                           (tail-consumes bool)] (-> (Result i64 Diag))
  (try (let [n (al-len [Expr] (load items))
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (try! (ownership-walk-expr a
                                                cx
                                                (al-elem [Expr] items (load i))
                                                states
                                                loops
                                                fname
                                                (and tail-consumes (= (primitive/iadd (load i) 1) n))))
                     (store! i (primitive/iadd (load i) 1)))))
         (Ok [i64 Diag] 0))))

(defn ownership-walk-all [(a (dyn Allocator))
                          (cx (ptr Cx))
                          (items (ptr (ArrayList Expr)))
                          (states (ptr (ArrayList MoveState)))
                          (loops (ptr (ArrayList OwnershipLoop)))
                          (fname (slice u8))
                          (consumes bool)] (-> (Result i64 Diag))
  (try (let [n (al-len [Expr] (load items))
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (try! (ownership-walk-expr a
                                                cx
                                                (al-elem [Expr] items (load i))
                                                states
                                                loops
                                                fname
                                                consumes))
                     (set! i (primitive/iadd (load i) 1)))))
         (Ok [i64 Diag] 0))))

(defn ownership-walk-construct-args [(a (dyn Allocator))
                                     (cx (ptr Cx))
                                     (items (ptr (ArrayList Expr)))
                                     (states (ptr (ArrayList MoveState)))
                                     (loops (ptr (ArrayList OwnershipLoop)))
                                     (fname (slice u8))] (-> (Result i64 Diag))
  (try (let [n (al-len [Expr] (load items))
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (let [arg (al-elem [Expr] items (load i))]
                       (try! (ownership-walk-expr a cx arg states loops fname true))
                       ; A generic value parameter materialized after mono is a
                       ; place, while a constructor field always receives the
                       ; value stored in that place.
                       (match (.kind arg)
                         (EVar [_]
                               (when (!= (primitive/cast i64 (ownership-root-state arg states))
                                         (primitive/cast i64 0))
                                 (let [saved (box-expr a (load arg))]
                                   (set! (.kind arg) (ELoad saved))
                                   0)))
                         (_ 0)))
                     (set! i (primitive/iadd (load i) 1)))))
         (Ok [i64 Diag] 0))))

(defn ownership-walk-branches [(a (dyn Allocator))
                               (cx (ptr Cx))
                               (left (ptr Expr))
                               (right (ptr Expr))
                               (states (ptr (ArrayList MoveState)))
                               (loops (ptr (ArrayList OwnershipLoop)))
                               (fname (slice u8))
                               (consumes bool)] (-> (Result i64 Diag))
  (try (let [ls (move-states-clone a states)
             rs (move-states-clone a states)]
         (try! (ownership-walk-expr a cx left ls loops fname consumes))
         (try! (ownership-walk-expr a cx right rs loops fname consumes))
         (try! (ownership-require-same-states a ls rs fname "between branches"))
         (move-states-merge! states ls)
         (Ok [i64 Diag] 0))))

(defn ownership-walk-call-args [(a (dyn Allocator))
                                (cx (ptr Cx))
                                (func (slice u8))
                                (args (ptr (ArrayList Expr)))
                                (states (ptr (ArrayList MoveState)))
                                (loops (ptr (ArrayList OwnershipLoop)))
                                (fname (slice u8))] (-> (Result i64 Diag))
  (try (let [sig (sig-find cx func)
             variant-entry (vts-find cx func)
             params
               (if (= (primitive/cast i64 sig) (primitive/cast i64 0))
                   (if (= (primitive/cast i64 variant-entry) (primitive/cast i64 0))
                       (primitive/cast (ptr (ArrayList Type)) 0)
                       (let [sum (sum-find cx (.sum variant-entry))]
                         (field-types-of a (variant-in-sum sum func))))
                   (load (field sig params)))
             np
               (if (= (primitive/cast i64 params) (primitive/cast i64 0))
                   0
                   (al-len [Type] (load params)))
             n (al-len [Expr] (load args))
             (mut i) 0]
         (loop (if (>= (load i) n)
                   (break)
                   (do
                     (let [arg (al-elem [Expr] args (load i))
                           consume
                             (and (< (load i) np)
                                  (type-is-affine a cx (al-elem [Type] params (load i))))]
                       (if (and (= (load i) (primitive/cast i64 0))
                                (or (= func "coil.core.take!")
                                    (starts-with func "coil.core.take!__")))
                           (match (.kind arg)
                             (EBorrow [_ place]
                                      (do
                                        (try! (ownership-walk-expr a cx place states loops fname false))
                                        (try! (ownership-consume-root! a place states fname))
                                        0))
                             (_ (do
                                  (try! (ownership-walk-expr a cx arg states loops fname false))
                                  (try! (ownership-consume-root! a arg states fname))
                                  0)))
                           (try! (ownership-walk-expr a cx arg states loops fname consume)))
                       ; Preserve an explicit distinction between a consumed place
                       ; and an aggregate value. Mono resolves this marker against
                       ; the callee's actual ABI after generic substitution.
                       (when (and consume
                                  (< (load i) np)
                                  (type-needs-drop a cx (al-elem [Type] params (load i))))
                         (match (.kind arg)
                           (ELoad [place]
                                  (when (!= (primitive/cast i64 (ownership-root-var place))
                                            (primitive/cast i64 0))
                                    (set! (.kind arg) (EMovePlace (box-expr a (load place))))
                                    0))
                           (ESpillRef [_] 0)
                           (_ (if (!= (primitive/cast i64 (ownership-root-state arg states))
                                      (primitive/cast i64 0))
                                  ; A direct affine parameter/local or one of its
                                  ; projections is already a place. Keep that fact
                                  ; explicit until mono selects the callee ABI.
                                  (let [saved (box-expr a (load arg))]
                                    (set! (.kind arg) (EMovePlace saved))
                                    0)
                                  ; Calls are type-checked before ownership lowering
                                  ; changes affine value parameters to their pointer
                                  ; ABI. Preserve a true rvalue in a frame temporary
                                  ; so the callee receives an owning place.
                                  (let [saved (box-expr a (load arg))]
                                    (set! (.kind arg) (ESpillRef saved))
                                    0))))
                         0))
                     (store! i (primitive/iadd (load i) 1)))))
         (Ok [i64 Diag] 0))))

; A ref/mut argument synthesized from an owning rvalue is represented as
; `ESpillRef(rvalue)`. The spill gives codegen an address, but by itself has no
; lexical owner and therefore no Drop cleanup. Materialize the same owned-place
; pair used by checked `let` bindings around the complete call expression. The
; call result is preserved by ECleanup while the temporary is destroyed after
; the borrow ends.
(defn ownership-wrap-borrowed-rvalues! [(a (dyn Allocator))
                                        (cx (ptr Cx))
                                        (call (ptr Expr))
                                        (args (ptr (ArrayList Expr)))
                                        (states (ptr (ArrayList MoveState)))] (-> bool)
  (let [(mut binds) (al-new [Bind] a)
        (mut changed) false]
    (for [i 0 (al-len [Expr] (load args))]
      (let [arg (al-elem [Expr] args i)]
        (match (.kind arg)
          (ESpillRef [inner]
            (if (or (!= (primitive/cast i64 (ownership-root-state inner states)) 0)
                    (not (ownership-expr-needs-drop a cx inner)))
                0
                (match (ownership-expr-type inner)
                  (None [] 0)
                  (Some [owner-type]
                    (let [name (sconcat a
                                  (sconcat a "$borrow.temp."
                                    (i64->str a (.nid call)))
                                  (sconcat a "." (i64->str a i)))
                          slot (sconcat a name ".slot")
                          bid (next-bid)
                          ownerp (box-type a owner-type)
                          (mut init) (al-new [Expr] a)]
                      (al-push! [Bind] (mut binds)
                        (mk-bind slot false
                          (mk-expr (EAlloc 3 owner-type (primitive/cast (ptr Expr) 0))
                            (.lo arg) (.hi arg) (.source arg) (.ctxt arg))))
                      (al-push! [Expr] (mut init)
                        (mk-expr
                          (EStore
                            (box-expr a
                              (mk-expr (EVar slot) (.lo arg) (.hi arg)
                                (.source arg) (.ctxt arg)))
                            (box-expr a (load inner)))
                          (.lo arg) (.hi arg) (.source arg) (.ctxt arg)))
                      (al-push! [Expr] (mut init)
                        (mk-expr (EVar slot) (.lo arg) (.hi arg)
                          (.source arg) (.ctxt arg)))
                      (let [owner (primitive/alloc-stack Bind)]
                        (set! owner
                          (mk-bind name false
                            (mk-expr (EDo (box-al [Expr] a (load init)))
                              (.lo arg) (.hi arg) (.source arg) (.ctxt arg))))
                        (set! (.bid owner) bid)
                        (set! (.owned_type owner) ownerp)
                        (al-push! [Bind] (mut binds) (load owner)))
                      (set! (.kind arg)
                        (EVar name))
                      (set! changed true)
                      0)))))
          (_ 0))))
    (if (not (load changed))
        false
        (let [(mut body) (al-new [Expr] a)
              saved (load call)]
          (al-push! [Expr] (mut body) saved)
          (set! (.kind call)
            (ELet (box-al [Bind] a (load binds))
                  (box-al [Expr] a (load body))))
          true))))

(defn ownership-walk-expr [(a (dyn Allocator))
                           (cx (ptr Cx))
                           (e (ptr Expr))
                           (states (ptr (ArrayList MoveState)))
                           (loops (ptr (ArrayList OwnershipLoop)))
                           (fname (slice u8))
                           (consumes bool)] (-> (Result i64 Diag))
  (try (do
         (when consumes
           (try! (ownership-consume-root! a e states fname))
           0)
         (unless consumes
           (try! (ownership-require-live-root a e states fname))
           0)
         (match (.kind e)
           (EBorrow [_ place] (ownership-walk-expr a cx place states loops fname false))
           (ELet [binds body]
                 (let [n (al-len [Bind] (load binds))
                       start (al-len [MoveState] (load states))
                       (mut i) 0]
                   (loop (if (>= (load i) n)
                             (break)
                             (do
                               (let [bp (al-elem [Bind] binds (load i))]
                                 (try! (ownership-walk-expr a cx (field bp value) states loops fname true))
                                 (unless (= (primitive/cast i64 (.owned_type bp)) (primitive/cast i64 0))
                                   (ownership-register! states
                                                        (.bid bp)
                                                        (.name bp)
                                                        (.owned_type bp)
                                                        (.lo (field bp value))
                                                        (.hi (field bp value))
                                                        (.source (field bp value))
                                                        (.ctxt (field bp value)))
                                   (when (or (= fname "coil.core.forget")
                                             (starts-with fname "coil.core.forget__"))
                                     (let [st (move-state-find states (.bid bp))]
                                       (when (!= (primitive/cast i64 st) (primitive/cast i64 0))
                                         (set! (.moved st) true)
                                         0))
                                     0)
                                   0))
                               (store! i (primitive/iadd (load i) 1)))))
                   (try! (ownership-walk-list a cx body states loops fname consumes))
                   (ownership-wrap-tail-cleanup! a
                                                 body
                                                 (ownership-cleanups a cx states start)
                                                 (.lo e)
                                                 (.hi e)
                                                 (.source e)
                                                 (.ctxt e))
                   (loop (if (<= (al-len [MoveState] (load states)) start)
                             (break)
                             (do (al-pop! [MoveState] states) 0)))
                   (Ok [i64 Diag] 0)))
           (EBin [_ lhs rhs]
                 (do
                   (try! (ownership-walk-expr a cx lhs states loops fname false))
                   (ownership-walk-expr a cx rhs states loops fname false)))
           (ENot [inner] (ownership-walk-expr a cx inner states loops fname false))
           (ECmp [_ lhs rhs]
                 (do
                   (try! (ownership-walk-expr a cx lhs states loops fname false))
                   (ownership-walk-expr a cx rhs states loops fname false)))
           (EIf [cnd thn els]
                (do
                  (try! (ownership-walk-expr a cx cnd states loops fname false))
                  (ownership-walk-branches a cx thn els states loops fname consumes)))
           (EDo [body] (ownership-walk-list a cx body states loops fname consumes))
           (ECall [func _ args]
             (if (ownership-wrap-borrowed-rvalues! a cx e args states)
                 (ownership-walk-expr a cx e states loops fname consumes)
                 (ownership-walk-call-args a cx func args states loops fname)))
           (EAlloc [_ _ init]
                   (if (= (primitive/cast i64 init) (primitive/cast i64 0))
                       (Ok [i64 Diag] 0)
                       (ownership-walk-expr a cx init states loops fname true)))
           (EField [p _] (ownership-walk-expr a cx p states loops fname false))
           (ELoad [inner]
                  (if consumes
                      ; A direct load from a named place was consumed by the root check at
                      ; entry. For a compound place-producing expression (notably a
                      ; constructor's synthesized ELet), descend so its tail owner is moved
                      ; and the temporary is not also dropped.
                      (if (= (primitive/cast i64 (ownership-root-var inner)) (primitive/cast i64 0))
                          (ownership-walk-expr a cx inner states loops fname true)
                          (Ok [i64 Diag] 0))
                      (ownership-walk-expr a cx inner states loops fname false)))
           (EStore [p value]
                   (let [owner (ownership-root-state p states)
                         owner-bid (if (= (primitive/cast i64 owner) (primitive/cast i64 0)) 0 (.bid owner))
                         owner-type
                           (if (= (primitive/cast i64 owner) (primitive/cast i64 0))
                               (primitive/cast (ptr Type) 0)
                               (.ty owner))]
                     (if (= (primitive/cast i64 owner) (primitive/cast i64 0))
                         (do
                           (try! (ownership-walk-expr a cx p states loops fname false))
                           (try! (ownership-walk-expr a cx value states loops fname true))
                           (ownership-load-direct-place! a value states)
                           (Ok [i64 Diag] 0))
                         (if (.moved owner)
                             ; A whole-owner store reinitializes a moved mutable binding.
                             ; A projection cannot be initialized while its enclosing owner
                             ; is absent; partial initialization needs drop flags.
                             (match (.kind p)
                               (EVar [_]
                                     (do
                                       (try! (ownership-walk-expr a cx value states loops fname true))
                                       (ownership-load-direct-place! a value states)
                                       (let [current (move-state-find states owner-bid)]
                                         (unless (= (primitive/cast i64 current) (primitive/cast i64 0))
                                           (set! (.moved current) false)
                                           0))
                                       (Ok [i64 Diag] 0)))
                               (_ (Err [i64 Diag]
                                       (derr-at-src (.source e)
                                                    (.lo e)
                                                    (.hi e)
                                                    (sconcat a
                                                             (sconcat3 a
                                                                       "in '"
                                                                       fname
                                                                       "': cannot initialize a field of moved value '")
                                                             (sconcat a (.name owner) "'"))))))
                             (do
                               (try! (ownership-walk-expr a cx p states loops fname false))
                               (try! (ownership-walk-expr a cx value states loops fname true))
                               (ownership-load-direct-place! a value states)
                               (match (ownership-place-type a cx p owner-type)
                                 (Some [target-type]
                                       (let [targetp (primitive/alloc-stack Type)]
                                         (set! targetp target-type)
                                         (when (type-needs-drop a cx targetp)
                                           ; Evaluate both operands before destruction, once and
                                           ; in source order. The replacement spill keeps the new
                                           ; value alive while old-value glue runs.
                                           (let [place-name (sconcat a "$overwrite.place." (i64->str a (.nid e)))
                                                 value-name (sconcat a "$overwrite.value." (i64->str a (.nid e)))
                                                 (mut binds) (al-new [Bind] a)
                                                 (mut body) (al-new [Expr] a)
                                                 place-var
                                                   (box-expr a
                                                             (mk-expr (EVar place-name)
                                                                      (.lo e)
                                                                      (.hi e)
                                                                      (.source e)
                                                                      (.ctxt e)))
                                                 value-var
                                                   (box-expr a
                                                             (mk-expr (EVar value-name)
                                                                      (.lo e)
                                                                      (.hi e)
                                                                      (.source e)
                                                                      (.ctxt e)))]
                                             (al-push! (mut binds) (mk-bind place-name false (load p)))
                                             (al-push! (mut binds)
                                                       (mk-bind value-name
                                                                false
                                                                (mk-expr (ESpillRef (box-expr a (load value)))
                                                                         (.lo e)
                                                                         (.hi e)
                                                                         (.source e)
                                                                         (.ctxt e))))
                                             (ownership-append-drop-glue! a
                                                                          cx
                                                                          (mut body)
                                                                          place-var
                                                                          targetp
                                                                          (.lo e)
                                                                          (.hi e)
                                                                          (.source e)
                                                                          (.ctxt e))
                                             (al-push! (mut body)
                                                       (mk-expr (EStore place-var
                                                                        (box-expr a
                                                                                  (mk-expr (ELoad value-var)
                                                                                           (.lo e)
                                                                                           (.hi e)
                                                                                           (.source e)
                                                                                           (.ctxt e))))
                                                                (.lo e)
                                                                (.hi e)
                                                                (.source e)
                                                                (.ctxt e)))
                                             (set! (.kind e)
                                                   (ELet (box-al [Bind] a (load binds))
                                                         (box-al [Expr] a (load body))))
                                             0))))
                                 (None [] 0))
                               (Ok [i64 Diag] 0))))))
           (EInitStore [p value]
                       (do
                         (try! (ownership-walk-expr a cx p states loops fname false))
                         (try! (ownership-walk-expr a cx value states loops fname true))
                         (ownership-load-direct-place! a value states)
                         (Ok [i64 Diag] 0)))
           (EIndex [p idx]
                   (do
                     (try! (ownership-walk-expr a cx p states loops fname false))
                     (ownership-walk-expr a cx idx states loops fname false)))
           (ECast [_ inner] (ownership-walk-expr a cx inner states loops fname false))
           (EBitGet [p _] (ownership-walk-expr a cx p states loops fname false))
           (EBitSet [p _ value]
                    (do
                      (try! (ownership-walk-expr a cx p states loops fname false))
                      (ownership-walk-expr a cx value states loops fname false)))
           (EFree [inner] (ownership-walk-expr a cx inner states loops fname false))
           (EErase [_ inner] (ownership-walk-expr a cx inner states loops fname false))
           (EMatch [scrut arms]
                   (do
                     (try! (ownership-walk-expr a cx scrut states loops fname false))
                     (let [n (al-len [Arm] (load arms))
                           (mut i) 0
                           (mut first) (primitive/cast (ptr (ArrayList MoveState)) 0)]
                       (loop (if (>= (load i) n)
                                 (break)
                                 (do
                                   (let [branch (move-states-clone a states)]
                                     (try! (ownership-walk-expr a
                                                                cx
                                                                (field (al-elem [Arm] arms (load i)) body)
                                                                branch
                                                                loops
                                                                fname
                                                                consumes))
                                     (if (= (load i) 0)
                                         (store! first branch)
                                         (try! (ownership-require-same-states a
                                                                              (load first)
                                                                              branch
                                                                              fname
                                                                              "between match arms"))))
                                   (store! i (primitive/iadd (load i) 1)))))
                       (when (!= (primitive/cast i64 (load first)) (primitive/cast i64 0))
                         (move-states-merge! states (load first)))
                       (Ok [i64 Diag] 0))))
           (ECallPtr [fp args]
                     (do
                       (try! (ownership-walk-expr a cx fp states loops fname false))
                       (ownership-walk-list a cx args states loops fname false)))
           (ELoop [label body]
                  (let [iteration (move-states-clone a states)
                        frame (primitive/alloc-stack OwnershipLoop)]
                    (set! (.label frame) label)
                    (set! (.owner_depth frame) (al-len [MoveState] (load states)))
                    (al-push! [OwnershipLoop] loops (load frame))
                    (try! (ownership-walk-list a cx body iteration loops fname false))
                    (al-pop! [OwnershipLoop] loops)
                    (try! (ownership-require-same-states a states iteration fname "across a loop iteration"))
                    (Ok [i64 Diag] 0)))
           (EBreak [label value]
                   (do
                     (match value
                       (Some [v] (try! (ownership-walk-expr a cx v states loops fname true)))
                       (None [] 0))
                     (let [depth (ownership-loop-owner-depth loops label)]
                       (when (>= depth (primitive/cast i64 0))
                         (ownership-wrap-exit! a cx e states depth)
                         0))
                     (Ok [i64 Diag] 0)))
           (EContinue [label]
                      (do
                        (let [depth (ownership-loop-owner-depth loops label)]
                          (when (>= depth (primitive/cast i64 0))
                            (ownership-wrap-exit! a cx e states depth)
                            0))
                        (Ok [i64 Diag] 0)))
           (ELlvmIr [_ args _] (ownership-walk-list a cx args states loops fname false))
           (EFieldMeta [_ _ idx] (ownership-walk-expr a cx idx states loops fname false))
           (EFieldIndex [_ name] (ownership-walk-expr a cx name states loops fname false))
           (ECodeOp [_ args] (ownership-walk-list a cx args states loops fname false))
           (EComptime [inner] (ownership-walk-expr a cx inner states loops fname false))
           (EAscribe [_ inner] (ownership-walk-expr a cx inner states loops fname consumes))
           (EArrayLit [items] (ownership-walk-all a cx items states loops fname true))
           (ESpillRef [inner] (ownership-walk-expr a cx inner states loops fname false))
           (EMovePlace [inner] (ownership-walk-expr a cx inner states loops fname false))
           (EMakeSlice [data _ _] (ownership-walk-expr a cx data states loops fname false))
           (EConstruct [_ _ args] (ownership-walk-construct-args a cx args states loops fname))
           (ETraitCall [_ _ _ args] (ownership-walk-list a cx args states loops fname false))
           (EDynDispatch [_ _ _ _ _ _ recv args]
                         (do
                           (try! (ownership-walk-expr a cx recv states loops fname false))
                           (ownership-walk-list a cx args states loops fname false)))
           (EMakeDyn [_ _ _ inner] (ownership-walk-expr a cx inner states loops fname false))
           (_ (Ok [i64 Diag] 0))))))

(defn ownership-check-func [(a (dyn Allocator)) (cx (ptr Cx)) (fp (ptr Func))] (-> (Result i64 Diag))
  (try (let [(mut states) (al-new [MoveState] a)
             (mut loops) (al-new [OwnershipLoop] a)
             ps (load (field fp params))
             np (al-len [Param] (load ps))
             (mut i) 0]
         (loop (if (>= (load i) np)
                   (break)
                   (do
                     (let [pp (al-elem [Param] ps (load i))]
                       (unless (= (primitive/cast i64 (.owned_type pp)) (primitive/cast i64 0))
                         (ownership-register! (mut states)
                                              (.bid pp)
                                              (.name pp)
                                              (.owned_type pp)
                                              (.lo fp)
                                              (.hi fp)
                                              (.source fp)
                                              (.ctxt fp))
                         0))
                     (set! i (primitive/iadd (load i) 1)))))
         ; The parameter has transferred into `forget`; marking it moved is the
         ; intrinsic semantic operation that deliberately suppresses cleanup.
         (when (or (= (.name fp) "coil.core.forget")
                   (starts-with (.name fp) "coil.core.forget__"))
           (set! i 0)
           (loop (if (>= (load i) (al-len [MoveState] (load states)))
                     (break)
                     (do
                       (set! (.moved (al-elem [MoveState] (mut states) (load i))) true)
                       (set! i (primitive/iadd (load i) 1)))))
           0)
         (try! (ownership-walk-list a
                                    cx
                                    (load (field fp body))
                                    (mut states)
                                    (mut loops)
                                    (.name fp)
                                    true))
         (ownership-wrap-tail-cleanup! a
                                       (load (field fp body))
                                       (ownership-cleanups a cx (mut states) 0)
                                       (.lo fp)
                                       (.hi fp)
                                       (.source fp)
                                       (.ctxt fp))
         (Ok [i64 Diag] 0))))

(defn check-all-funcs [(a (dyn Allocator))
                       (cx (ptr Cx))
                       (allf (ptr (ArrayList Func)))
                       (s (mut LS))
                       (validate-ownership bool)] (-> (Result (ptr (ArrayList Func))
                                                              Diag))
  (let [n (al-len [Func] (load allf))
        (mut out) (al-new [Func] a)
        (mut dgs) (al-new [Diag] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] allf (load i))]
                  (unless (func-poisoned? (mut s) (load (field fp name)))
                    (match (check-func a cx fp)
                      (Err [d] (al-push! (mut dgs) d))
                      (Ok [f]
                          (let [checked (primitive/alloc-stack Func)]
                            (set! checked f)
                            ; check-func leaves this function's bounds installed on Cx,
                            ; which is exactly the abstract ownership environment needed
                            ; by type-needs-drop for this pass.
                            (if (or (not validate-ownership)
                                    (> (al-len [(slice u8)] (load (field checked type_params)))
                                       (primitive/cast i64 0)))
                                ; Generic cleanup is elaborated by mono after type
                                ; substitution, when structural Drop is knowable.
                                (al-push! (mut out) f)
                                (match (ownership-check-func a cx checked)
                                  (Err [d] (al-push! (mut dgs) d))
                                  (Ok [_] (al-push! (mut out) f)))))))))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.check_diags s) (box-al [Diag] a (load dgs)))
    (if (> (al-len [Diag] (load dgs)) (primitive/cast i64 0))
        (Err (al-get [Diag] (load dgs) 0))
        (Ok (box-al [Func] a (load out))))))

(defn check-program-mode [(a (dyn Allocator))
                          (p (ptr Program))
                          (s (mut LS))
                          (validate-ownership bool)] (-> (Result (ptr Program) Diag))
  (type-map-reset)  ; S2: fresh per-expression type map for this check pass
  (bind-map-reset)  ; S3: fresh local-binding map + id counter for this check pass
  (res-map-reset)  ; S1: fresh call→callee resolution map
  (let [impb (box! a (ArrayList ImpEntry) (primitive/zeroed (ArrayList ImpEntry)))
        expb (box! a (ArrayList ExpEntry) (primitive/zeroed (ArrayList ExpEntry)))
        cx (box! a Cx (primitive/zeroed Cx))]
    (set! (.trait_uses cx) (al-new [MonoTraitUse] a))
    (set! impb (.imports s))
    (set! expb (.exports s))
    (let [setup-span (tr/span-begin "frontend.check.setup")
          setup-result (setup a cx p impb expb)
          _setup-end (tr/span-end setup-span)]
      (match setup-result
      (Err [d] (Err [(ptr Program) Diag] d))
      (Ok [allf]
          (set! (.entry_module cx) (.entry_module s))
          (let [functions-span (tr/span-begin "frontend.check.functions")
                functions-result (check-all-funcs a cx allf (mut s) validate-ownership)
                _functions-end (tr/span-end functions-span)]
            (match functions-result
            (Err [d] (Err [(ptr Program) Diag] d))
            (Ok [funcs]
                (let [finish-span (tr/span-begin "frontend.check.finish")
                      result (finish a cx p funcs)
                      _finish-end (tr/span-end finish-span)]
                  result)))))))))

; Provisional semantic models expose resolved calls, inferred types, and canonical
; binding identities to ownership-elaboration transforms, but deliberately stop
; before affine validation and drop insertion. Transform output is never trusted:
; the ordinary entry point below rebuilds all maps and performs authoritative
; ownership checking after the transform reaches its declared completion point.
(defn check-program-synthesis [(a (dyn Allocator)) (p (ptr Program)) (s (mut LS))] (-> (Result (ptr Program) Diag))
  (check-program-mode a p (mut s) false))

(defn check-program [(a (dyn Allocator)) (p (ptr Program)) (s (mut LS))] (-> (Result (ptr Program) Diag))
  (check-program-mode a p (mut s) true))

; ============================ the mono pass =====================
; A PURE specializer: the checker already wrote explicit type-args on every
; generic call/construction, so mono instantiates each generic func/struct/sum
; per concrete type-arg set, rewrites calls to the specialized (mangled) names,
; and drops the generic templates. Output is a Program with no remaining
; generics. mono's String errors become spanless Diags (derr, lo=hi=-1) so they
; dump as (error@D:D "...").

; A type-parameter substitution (param-name -> concrete Type), parallel lists.)
