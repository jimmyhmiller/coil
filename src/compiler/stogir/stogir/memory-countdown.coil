;;; Independent finite memory countdown reduction; retains zero-trip no-write.
(module stogir.memory-countdown)
(import "stogir.finite-countdown" :as finite)
(import "stogir.address-alias" :as alias)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.uses" :as uses)
(import "stogir.iter-control" :as control)
(import "stogir.bitqueue" :as queue)
(import "stogir.bitset" :as bits)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Option Some None])

(defstruct Plan [(header i32) (entry i32) (back i32) (load i32) (counter i32)
                 (step i32) (store i32) (branch i32) (predicate i32)
                 (inside i32) (outside i32) (zero i32)])

(defn only-use? [(edges uses/Uses) (ref i32) (user i32) (operand i32)] (-> bool)
 (let [range (get (.ranges edges) (cast i64 ref))]
  (and (= (.count range) 1)
       (let [edge (get (.edges edges) (.offset range))]
        (and (= (.user edge) user) (= (.operand edge) operand))))))

(defn integer-width [(graph g/Graph) (ref i32) (pointer-bytes i32)] (-> i32)
 (match (g/lookup graph ref)
  (None [] 0)
  (Some [node]
   (let [ty (cast i32 (n/type-id node)) size (types/scalar-size ty pointer-bytes)]
    (if (and (types/integer? ty) (!= ty 1) (!= ty 6) (> size 0) (<= size 8)) size 0)))))

(defn view? [(graph g/Graph) (ref i32) (width i32) (pointer-bytes i32)] (-> bool)
 (and (or (= (finite/node-op graph ref) 36)
          (and (= (finite/node-op graph ref) 68)
               (= (.op2 (get (.instructions graph) (cast i64 ref))) 0)))
      (= (integer-width graph ref pointer-bytes) width)
      (let [node (get (.instructions graph) (cast i64 ref))]
       (= (integer-width graph (.op1 node) pointer-bytes) width))))

(defn invariant-base? [(graph g/Graph) (base i32) (entry i32)] (-> bool)
 (if (< base 0) true
  (if (<= base 0) false
   (let [node (get (.instructions graph) (cast i64 base))]
    (case (n/opcode node)
     71 (finite/follows? graph entry (.op1 node))
     81 (finite/follows? graph entry base)
     false)))))

(defn select [(graph g/Graph) (edges uses/Uses) (header i32) (pointer-bytes i32)]
 (-> (Option Plan))
 (block :answer
  (unless (and (or (= (finite/node-op graph header) 112) (= (finite/node-op graph header) 113))
               (= (get (.arities graph) (cast i64 header)) 2)) (return-from :answer (None)))
  (let [hr (get (.ranges edges) (cast i64 header))]
   (unless (= (.count hr) 1) (return-from :answer (None)))
   (let [he (get (.edges edges) (.offset hr)) load-ref (.user he)
         width (integer-width graph load-ref pointer-bytes)]
    (unless (and (= (.operand he) 1) (= (finite/node-op graph load-ref) 91) (> width 0))
      (return-from :answer (None)))
    ; The sequenced load must have exactly one IF control successor.
    (let [lr (get (.ranges edges) (cast i64 load-ref)) (mut branch) (: 0 i32)]
     (for [i 0 (.count lr)]
      (let [edge (get (.edges edges) (+ (.offset lr) i)) user (.user edge)
            node (get (.instructions graph) (cast i64 user))]
       (when (= (op/operand-code (cast i32 (n/opcode node)) (.operand edge)) op/OPERAND-SRC)
        (unless (and (= branch 0) (= (n/opcode node) 116) (= (.operand edge) 1))
          (return-from :answer (None)))
        (set! branch user))))
     (unless (> branch 0) (return-from :answer (None)))
     (let [b (get (.instructions graph) (cast i64 branch)) predicate (.op2 b)
           cmp-op (finite/node-op graph predicate)]
      (unless (and (or (= cmp-op 14) (= cmp-op 15)) (only-use? edges predicate branch 2))
        (return-from :answer (None)))
      (let [cmp (get (.instructions graph) (cast i64 predicate)) counter (.op1 cmp)
            ty (if (> counter 0) (n/type-id (get (.instructions graph) (cast i64 counter))) (: 0 u8))]
       (unless (and (> counter 0) (= (integer-width graph counter pointer-bytes) width)
                    (finite/literal? graph (.op2 cmp) ty 0)) (return-from :answer (None)))
       (let [br (get (.ranges edges) (cast i64 branch))
             (mut inside) (: 0 i32) (mut outside) (: 0 i32)]
        (unless (= (.count br) 2) (return-from :answer (None)))
        (for [i 0 (.count br)]
         (let [edge (get (.edges edges) (+ (.offset br) i)) ref (.user edge)
               opcode (finite/node-op graph ref)]
          (unless (and (= (.operand edge) 1) (or (= opcode 107) (= opcode 108)))
            (return-from :answer (None)))
          (if (= (= opcode 107) (= cmp-op 15)) (set! inside ref) (set! outside ref))))
        (unless (and (> inside 0) (> outside 0)) (return-from :answer (None)))
        (let [ir (get (.ranges edges) (cast i64 inside))]
         (unless (= (.count ir) 1) (return-from :answer (None)))
         (let [ie (get (.edges edges) (.offset ir)) store (.user ie)]
          (unless (and (= (.operand ie) 1) (= (finite/node-op graph store) 93))
            (return-from :answer (None)))
          (let [st (get (.instructions graph) (cast i64 store)) step (.op3 st)
                sr (get (.ranges edges) (cast i64 store))]
           (unless (and (= (.count sr) 1) (= (finite/node-op graph step) 27)
                        (only-use? edges step store 3)) (return-from :answer (None)))
           (let [se (get (.edges edges) (.offset sr)) back (.user se)
                 h (get (.instructions graph) (cast i64 header))
                 next (get (.instructions graph) (cast i64 step))]
            (unless (and (= (.operand se) 1)
                         (or (= (finite/node-op graph back) 114) (= (finite/node-op graph back) 115))
                         (or (= back (.op1 h)) (= back (.op2 h)))
                         (= (n/type-id next) ty) (= (.op1 next) counter)
                         (finite/literal? graph (.op2 next) ty 1)) (return-from :answer (None)))
            (let [entry (if (= back (.op1 h)) (.op2 h) (.op1 h))
                  back-slot (if (= back (.op1 h)) (: 1 i32) 2)]
             (unless (and (= (finite/node-op graph entry) 114)
                          (only-use? edges entry header (if (= back-slot 1) 2 1))
                          (only-use? edges back header back-slot)) (return-from :answer (None)))
             (let [read (get (.instructions graph) (cast i64 load-ref))
                   left (alias/decompose graph (.op2 read) pointer-bytes)
                   right (alias/decompose graph (.op2 st) pointer-bytes)]
              (unless (and (= (.base left) (.base right)) (= (.offset left) (.offset right))
                           (= (.index left) 0) (= (.index right) 0)
                           (invariant-base? graph (.base left) entry)) (return-from :answer (None))))
             ; Counter views preserve exactly the memory width. No payload can
             ; escape; the last view has only comparison and subtraction users.
             (let [cr (get (.ranges edges) (cast i64 counter))]
              (unless (= (.count cr) (if (= counter load-ref) 3 2)) (return-from :answer (None)))
              (for [i 0 (.count cr)]
               (let [edge (get (.edges edges) (+ (.offset cr) i))]
                (unless (or (and (= (.user edge) predicate) (= (.operand edge) 1))
                            (and (= (.user edge) step) (= (.operand edge) 1))
                            (and (= counter load-ref) (= (.user edge) branch) (= (.operand edge) 1)))
                  (return-from :answer (None))))))
             (let [(mut at) counter (mut user) (: 0 i32) (mut budget) 16]
              (while (!= at load-ref)
               (unless (and (> budget 0) (view? graph at width pointer-bytes)
                            (or (= user 0) (only-use? edges at user 1))) (return-from :answer (None)))
               (set! user at) (set! at (.op1 (get (.instructions graph) (cast i64 at))))
               (set! budget (- budget 1)))
              (when (> user 0)
               (unless (= (.count lr) 2) (return-from :answer (None)))
               (for [i 0 (.count lr)]
                (let [edge (get (.edges edges) (+ (.offset lr) i))]
                 (unless (and (= (.operand edge) 1)
                              (or (= (.user edge) user) (= (.user edge) branch)))
                   (return-from :answer (None)))))))
             (let [out (get (.ranges edges) (cast i64 outside))]
              (for [i 0 (.count out)]
               (let [edge (get (.edges edges) (+ (.offset out) i))
                     node (get (.instructions graph) (cast i64 (.user edge)))]
                (unless (and (= (.operand edge) 1)
                             (= (op/operand-code (cast i32 (n/opcode node)) 1) op/OPERAND-SRC))
                  (return-from :answer (None))))))
             (Some (Plan :header header :entry entry :back back :load load-ref :counter counter
                      :step step :store store :branch branch :predicate predicate
                      :inside inside :outside outside :zero (.op2 cmp))))))))))))))))

;;; Reuse the entry END as the zero-path END and the old loop header as the
;;; acyclic exit merge. Initial zero never reaches STORE; no new nodes needed.
(defn rewrite! [(graph (mut g/Graph)) (edges (mut uses/Uses))
                 (work (mut queue/Queue)) (roots (mut (ArrayList i32)))
                 (protected (mut bits/Bits)) (header i32) (pointer-bytes i32)] (-> bool)
 (match (select graph edges header pointer-bytes)
  (None [] false)
  (Some [plan]
   (let [observations [(.header plan) (.entry plan) (.load plan) (.counter plan)
                        (.step plan) (.store plan) (.branch plan) (.predicate plan) (.inside plan)]
         h (get (.instructions graph) (cast i64 header))
         read (get (.instructions graph) (cast i64 (.load plan)))
         prior (.op1 (get (.instructions graph) (cast i64 (.entry plan))))]
    (block :answer
     (for ref observations
      (when (bits/contains? protected (cast i64 ref)) (return-from :answer false)))
     (let [(mut at) (.counter plan)]
      (while (!= at (.load plan))
       (when (bits/contains? protected (cast i64 at)) (return-from :answer false))
       (set! at (.op1 (get (.instructions graph) (cast i64 at))))))
     ; Redirect only preexisting exit uses; the entry END is attached afterward.
     (while (> (.count (get (.ranges edges) (cast i64 (.outside plan)))) 0)
      (let [range (get (.ranges edges) (cast i64 (.outside plan)))
            edge (get (.edges edges) (.offset range))]
       (unless (g/set-operand! (mut graph) (.user edge) (.operand edge) header)
        (panic "memory countdown exit edge disappeared"))
       (unless (uses/remove! (mut edges) (.outside plan) edge)
        (panic "memory countdown exit use disappeared"))
       (uses/add! (mut edges) header edge)
       (queue/add! (mut work) (cast i64 (.user edge)))))
     (for [i 0 (len roots)]
      (when (= (get roots i) (.outside plan)) (set! (mut roots) i header)))
     (when (bits/remove! (mut protected) (cast i64 (.outside plan)))
      (bits/add! (mut protected) (cast i64 header)))
     (control/rewrite! (mut graph) (mut edges) (mut work) (.load plan)
       91 (n/type-id read) (n/auxiliary read) [prior (.op2 read)])
     (let [ty (n/type-id (get (.instructions graph) (cast i64 (.step plan))))]
      (control/rewrite! (mut graph) (mut edges) (mut work) (.step plan)
        68 ty 0 [(.zero plan) (: 0 i32)]))
     (control/rewrite! (mut graph) (mut edges) (mut work) (.entry plan)
       114 0 0 [(.outside plan)])
     (control/rewrite! (mut graph) (mut edges) (mut work) (.back plan)
       114 0 0 [(.store plan)])
     (control/rewrite! (mut graph) (mut edges) (mut work) header
       112 0 2 [(.op1 h) (.op2 h)])
     true)))))
