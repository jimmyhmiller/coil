(defn count [] (-> i32)
  (cast i32 (len KINDS)))

(defn flags [(opcode i32)] (-> i32)
  (if (and (>= opcode 0) (< opcode (count)))
      (cast i32 (get KINDS (cast i64 opcode)))
      0))
