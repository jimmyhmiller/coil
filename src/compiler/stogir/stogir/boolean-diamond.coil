;;; Empty integer-literal diamonds follow ir_sccp.c:ir_optimize_phi, pinned 92171d0.
;;; Retain an END/BEGIN pair to preserve stable observable control references.
;;; The result is the original compact graph; rebuild def-use/CFG facts. See NOTICE.
(module stogir.boolean-diamond)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn input [(graph g/Graph) (r i32) (index i32)] (-> i32)
  (match (g/operand graph r index) (Some [v] v) (None [] 0)))

(defn integer-literal? [(graph g/Graph) (r i32) (ty u8)] (-> bool)
  (and (< r 0)
       (types/integer? (cast i32 ty))
       (match (g/lookup graph r)
         (None [] false)
         (Some [v]
               (and (= (n/type-id v) ty)
                    (symbols/numeric? v))))))

;;; RLOAD anti-dependencies and overflow flags are not modeled by GCM. Preserve
;;; the pinned exclusions instead of moving their conditions across writes.
(defn movable-condition? [(graph g/Graph) (reference i32)] (-> bool)
  (match (g/lookup graph reference)
    (None [] false)
    (Some [node]
          (let [opcode (cast i32 (n/opcode node))
                (mut safe) true]
            (when (or (= opcode 44) (= opcode 89)) (set! safe false))
            (when (and (>= opcode 14) (<= opcode 25))
              (let [operands [(.op1 node) (.op2 node)]]
                (for r operands
                  (match (g/lookup graph r)
                    (Some [v] (when (= (n/opcode v) 89) (set! safe false)))
                    (None [] (set! safe false))))))
            safe))))

(defn count [(edges uses/Uses) (r i32)] (-> i64)
  (.count (get (.ranges edges) (cast i64 r))))

(defn candidate [(graph g/Graph) (edges uses/Uses) (merge i32)] (-> i32)
  (let [region (get (.instructions graph) (cast i64 merge))
        first (.op1 region)
        second (.op2 region)]
    (if (or (!= (n/opcode region) 112)
            (!= (get (.arities graph) (cast i64 merge)) 2)
            (!= (count edges merge) 2))
        0
        (let [end1 (get (.instructions graph) (cast i64 first))
              end2 (get (.instructions graph) (cast i64 second))
              arm1 (.op1 end1)
              arm2 (.op1 end2)]
          (if (or (!= (n/opcode end1) 114)
                  (!= (n/opcode end2) 114)
                  (!= (count edges first) 1)
                  (!= (count edges second) 1))
              0
              (let [start1 (get (.instructions graph) (cast i64 arm1))
                    start2 (get (.instructions graph) (cast i64 arm2))
                    branch (.op1 start1)]
                (if (or (!= (+ (cast i32 (n/opcode start1))
                               (cast i32 (n/opcode start2)))
                            215)
                        (not (or (= (n/opcode start1) 107)
                                 (= (n/opcode start1) 108)))
                        (!= branch (.op1 start2))
                        (!= (count edges arm1) 1)
                        (!= (count edges arm2) 1)
                        (!= (count edges branch) 2)
                        (!= (n/opcode (get (.instructions graph)
                                           (cast i64 branch)))
                            116))
                    0
                    (let [range (get (.ranges edges) (cast i64 merge))
                          (mut phi) (: 0 i32)
                          (mut next) false]
                      (for [i
                            (.offset range)
                            (+ (.offset range) (.count range))]
                        (let [edge (get (.edges edges) i)
                              node
                                (get (.instructions graph)
                                     (cast i64 (.user edge)))]
                          (if (and (= (n/opcode node) 67)
                                   (= (.operand edge) 1)
                                   (= (get (.arities graph)
                                           (cast i64 (.user edge)))
                                      3))
                              (when (and (integer-literal? graph
                                                           (.op2 node)
                                                           (n/type-id node))
                                         (integer-literal? graph
                                                           (.op3 node)
                                                           (n/type-id node)))
                                (set! phi (.user edge)))
                              (when (and (op/control? (cast i32 (n/opcode node)))
                                         (= (op/operand-code (cast i32
                                                                   (n/opcode node))
                                                             (.operand edge))
                                            op/OPERAND-SRC))
                                (set! next true)))))
                      (if (and next
                               (> phi 0)
                               (movable-condition? graph (input graph branch 2)))
                          phi
                          0)))))))))

; Update exact operand uses while references remain stable. Detaching an IF's
; condition first makes its bucket slot available to the replacement COND.
(defn replace-node! [(graph (mut g/Graph))
                     (edges (mut uses/Uses))
                     (queue (mut q/Queue))
                     (reference i32)
                     (opcode u8)
                     (ty u8)
                     (inputs (slice i32))] (-> void)
  (let [node (get (.instructions graph) (cast i64 reference))
        arity (get (.arities graph) (cast i64 reference))]
    (for [i 1 (+ (cast i64 arity) 1)]
      (when (uses/edge-code? (op/operand-code (cast i32 (n/opcode node))
                                              (cast i32 i)))
        (let [value (input graph reference (cast i32 i))]
          (when (> value 0)
            (unless (uses/remove! (mut edges)
                                  value
                                  (uses/Use
                                    :user reference
                                    :operand (cast i32 i)))
              (panic "boolean diamond use edge missing"))
            (q/add! (mut queue) (cast i64 value))))))
    (unless (g/rewrite-inputs! (mut graph) reference opcode ty inputs)
      (panic "boolean diamond node rewrite failed"))
    (for [i 0 (len inputs)]
      (when (and (> (get inputs i) 0)
                 (uses/edge-code? (op/operand-code (cast i32 opcode)
                                                   (cast i32 (+ i 1)))))
        (uses/add! (mut edges)
                   (get inputs i)
                   (uses/Use :user reference :operand (cast i32 (+ i 1))))))
    (q/add! (mut queue) (cast i64 reference))))

;;; Typed COND folds from pinned ir_fold.h. Inverted wide integer results
;;; retain COND until a separate NOT/extension can be represented; never apply
;;; integer bitwise inversion to a widened boolean.
(defn replace-value! [(graph (mut g/Graph))
                      (edges (mut uses/Uses))
                      (queue (mut q/Queue))
                      (reference i32)
                      (ty u8)
                      (condition i32)
                      (yes i32)
                      (no i32)] (-> void)
  (let [source
          (match (g/lookup graph condition)
            (Some [v] (n/type-id v))
            (None [] (: 0 u8)))
        yes-bits
          (match (g/lookup graph yes)
            (Some [v] (n/constant-bits v))
            (None [] (: 0 u64)))
        no-bits
          (match (g/lookup graph no)
            (Some [v] (n/constant-bits v))
            (None [] (: 0 u64)))
        (mut opcode) (: 60 u8)]
    (when (and (= source 1)
               (<= yes-bits 1)
               (<= no-bits 1)
               (!= yes-bits no-bits))
      (if (= ty 1)
          (set! opcode (if (= yes-bits 1) (: 68 u8) 45))
          (when (= yes-bits 1)
            (set! opcode
                  (if (= (types/scalar-size (cast i32 ty) 8) 1)
                      (: 36 u8)
                      34)))))
    (if (= opcode 60)
        (replace-node! (mut graph)
                       (mut edges)
                       (mut queue)
                       reference
                       opcode
                       ty
                       [condition yes no])
        (replace-node! (mut graph)
                       (mut edges)
                       (mut queue)
                       reference
                       opcode
                       ty
                       (if (= opcode 68) [condition (: 0 i32)] [condition])))))

;;; Requires verified control/Phi shapes and def-use lists for this graph. Roots
;;; keep their positive control identity through the retained END/BEGIN pair.
(defn rewrite! [(graph (mut g/Graph))
                (roots (mut (ArrayList i32)))
                (edges (mut uses/Uses))
                (queue (mut q/Queue))
                (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut removed) (ArrayList::new [i32] a)
        (mut changes) (: 0 i32)
        (mut r) 1]
    (for [i 0 (len (.instructions graph))] (push! (mut removed) 0))
    (while (< r (len (.instructions graph)))
      (let [node (get (.instructions graph) r)
            arity (get (.arities graph) r)]
        (when (= (n/opcode node) 112)
          (let [phi (candidate graph edges (cast i32 r))]
            (when (> phi 0)
              (let [end1 (.op1 node)
                    end2 (.op2 node)
                    arm1 (input graph end1 1)
                    arm2 (input graph end2 1)
                    branch (input graph arm1 1)
                    previous (input graph branch 1)
                    condition (input graph branch 2)
                    value (get (.instructions graph) (cast i64 phi))
                    true-first
                      (= (n/opcode (get (.instructions graph) (cast i64 arm1)))
                         107)
                    yes (if true-first (.op2 value) (.op3 value))
                    no (if true-first (.op3 value) (.op2 value))]
                (replace-node! (mut graph)
                               (mut edges)
                               (mut queue)
                               branch
                               114
                               0
                               [previous])
                (replace-value! (mut graph)
                                (mut edges)
                                (mut queue)
                                phi
                                (n/type-id value)
                                condition
                                yes
                                no)
                (replace-node! (mut graph)
                               (mut edges)
                               (mut queue)
                               (cast i32 r)
                               106
                               0
                               [branch (: 0 i32)])
                (for dead [end1 end2 arm1 arm2]
                  (set! (mut removed) (cast i64 dead) branch)
                  (replace-node! (mut graph)
                                 (mut edges)
                                 (mut queue)
                                 dead
                                 0
                                 0
                                 []))
                (set! changes (+ changes 1))))))
        (set! r (+ r (/ (+ (cast i64 arity) 4) 4)))))
    (for [i 0 (len roots)]
      (let [replacement (get removed (cast i64 (get roots i)))]
        (when (> replacement 0) (set! (mut roots) i replacement))))
    (free! (mut removed))
    (Ok changes)))
