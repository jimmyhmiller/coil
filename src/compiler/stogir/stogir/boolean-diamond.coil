;;; Integer diamonds and IF/PHI splitting follow ir_sccp.c, pinned 92171d0.
;;; Retain an END/BEGIN pair to preserve stable observable control references.
;;; The result is the original compact graph; rebuild def-use/CFG facts. See NOTICE.
(module stogir.boolean-diamond)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "stogir.bitset" :as bits)
(import "stogir.conditional" :as conditional)
(import "stogir.switch-values" :as lookup)
(import "stogir.fold" :as fold)
(import "stogir.floating" :as floating)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Option Some None])

(defn input [(graph g/Graph) (r i32) (index i32)] (-> i32)
  (match (g/operand graph r index) (Some [v] v) (None [] 0)))

(defn integer-literal? [(graph g/Graph) (r i32) (ty u8)] (-> bool)
  (and (< r 0)
       (types/integer? (cast i32 ty))
       (match (g/lookup graph r)
         (None [] false)
         (Some [v]
               (and (= (n/type-id v) ty)
                    (symbols/numeric? v))))))

(defn movable-condition? [(graph g/Graph) (reference i32)] (-> bool)
  (conditional/movable-condition? graph reference))

(defn count [(edges uses/Uses) (r i32)] (-> i64)
  (.count (get (.ranges edges) (cast i64 r))))

(defn candidate [(graph g/Graph) (edges uses/Uses) (merge i32)] (-> i32)
  (let [region (get (.instructions graph) (cast i64 merge))
        first (.op1 region)
        second (.op2 region)]
    (if (or (!= (n/opcode region) 112)
            (!= (get (.arities graph) (cast i64 merge)) 2)
            (!= (count edges merge) 2))
        0
        (let [end1 (get (.instructions graph) (cast i64 first))
              end2 (get (.instructions graph) (cast i64 second))
              arm1 (.op1 end1)
              arm2 (.op1 end2)]
          (if (or (!= (n/opcode end1) 114)
                  (!= (n/opcode end2) 114)
                  (!= (count edges first) 1)
                  (!= (count edges second) 1))
              0
              (let [start1 (get (.instructions graph) (cast i64 arm1))
                    start2 (get (.instructions graph) (cast i64 arm2))
                    branch (.op1 start1)]
                (if (or (!= (+ (cast i32 (n/opcode start1))
                               (cast i32 (n/opcode start2)))
                            215)
                        (not (or (= (n/opcode start1) 107)
                                 (= (n/opcode start1) 108)))
                        (!= branch (.op1 start2))
                        (!= (count edges arm1) 1)
                        (!= (count edges arm2) 1)
                        (!= (count edges branch) 2)
                        (!= (n/opcode (get (.instructions graph)
                                           (cast i64 branch)))
                            116))
                    0
                    (let [range (get (.ranges edges) (cast i64 merge))
                          (mut phi) (: 0 i32)
                          (mut next) false]
                      (for [i
                            (.offset range)
                            (+ (.offset range) (.count range))]
                        (let [edge (get (.edges edges) i)
                              node
                                (get (.instructions graph)
                                     (cast i64 (.user edge)))]
                          (if (and (= (n/opcode node) 67)
                                   (= (.operand edge) 1)
                                   (= (get (.arities graph)
                                           (cast i64 (.user edge)))
                                      3))
                              (when (and (integer-literal? graph
                                                           (.op2 node)
                                                           (n/type-id node))
                                         (integer-literal? graph
                                                           (.op3 node)
                                                           (n/type-id node)))
                                (set! phi (.user edge)))
                              (when (and (op/control? (cast i32 (n/opcode node)))
                                         (= (op/operand-code (cast i32
                                                                   (n/opcode node))
                                                             (.operand edge))
                                            op/OPERAND-SRC))
                                (set! next true)))))
                      (if (and next
                               (> phi 0)
                               (movable-condition? graph (input graph branch 2)))
                          phi
                          0)))))))))

; Update exact operand uses while references remain stable. Detaching an IF's
; condition first makes its bucket slot available to the replacement COND.
(defn replace-node! [(graph (mut g/Graph))
                     (edges (mut uses/Uses))
                     (queue (mut q/Queue))
                     (reference i32)
                     (opcode u8)
                     (ty u8)
                     (inputs (slice i32))] (-> void)
  (let [node (get (.instructions graph) (cast i64 reference))
        arity (get (.arities graph) (cast i64 reference))]
    (for [i 1 (+ (cast i64 arity) 1)]
      (when (uses/edge-code? (op/operand-code (cast i32 (n/opcode node))
                                              (cast i32 i)))
        (let [value (input graph reference (cast i32 i))]
          (when (> value 0)
            (unless (uses/remove! (mut edges)
                                  value
                                  (uses/Use
                                    :user reference
                                    :operand (cast i32 i)))
              (panic "boolean diamond use edge missing"))
            (q/add! (mut queue) (cast i64 value))))))
    (unless (g/rewrite-inputs! (mut graph) reference opcode ty inputs)
      (panic "boolean diamond node rewrite failed"))
    (for [i 0 (len inputs)]
      (when (and (> (get inputs i) 0)
                 (uses/edge-code? (op/operand-code (cast i32 opcode)
                                                   (cast i32 (+ i 1)))))
        (uses/add! (mut edges)
                   (get inputs i)
                   (uses/Use :user reference :operand (cast i32 (+ i 1))))))
    (q/add! (mut queue) (cast i64 reference))))

;;; Typed COND folds from pinned ir_fold.h. Inverted wide integer results
;;; retain COND until a separate NOT/extension can be represented; never apply
;;; integer bitwise inversion to a widened boolean.
(defn replace-value! [(graph (mut g/Graph))
                      (edges (mut uses/Uses))
                      (queue (mut q/Queue))
                      (reference i32)
                      (ty u8)
                      (condition i32)
                      (yes i32)
                      (no i32)] (-> void)
  (let [source
          (match (g/lookup graph condition)
            (Some [v] (n/type-id v))
            (None [] (: 0 u8)))
        yes-bits
          (match (g/lookup graph yes)
            (Some [v] (n/constant-bits v))
            (None [] (: 0 u64)))
        no-bits
          (match (g/lookup graph no)
            (Some [v] (n/constant-bits v))
            (None [] (: 0 u64)))
        (mut opcode) (: 60 u8)]
    (when (and (= source 1)
               (<= yes-bits 1)
               (<= no-bits 1)
               (!= yes-bits no-bits))
      (if (= ty 1)
          (set! opcode (if (= yes-bits 1) (: 68 u8) 45))
          (when (= yes-bits 1)
            (set! opcode
                  (if (= (types/scalar-size (cast i32 ty) 8) 1)
                      (: 36 u8)
                      34)))))
    (if (= opcode 60)
        (replace-node! (mut graph)
                       (mut edges)
                       (mut queue)
                       reference
                       opcode
                       ty
                       [condition yes no])
        (replace-node! (mut graph)
                       (mut edges)
                       (mut queue)
                       reference
                       opcode
                       ty
                       (if (= opcode 68) [condition (: 0 i32)] [condition])))))

;;; Requires verified control/Phi shapes and def-use lists for this graph. Roots
;;; keep their positive control identity through the retained END/BEGIN pair.
;;; IF/PHI splitting follows pinned ir_sccp.c:ir_try_split_if/_cmp. Match only
;;; a closed two-input merge with an unobserved, single-use PHI and condition.
(defstruct Split
  [(phi i32)
   (branch i32)
   (comparison i32)
   (first i32)
   (second i32)
   (left i32)
   (right i32)
   (yes i32)
   (no i32)])

(defn split-candidate [(graph g/Graph)
                       (edges uses/Uses)
                       (protected bits/Bits)
                       (merge i32)] (-> (Option Split))
  (let [region (get (.instructions graph) (cast i64 merge))
        first (.op1 region)
        second (.op2 region)
        (mut good)
          (and (= (n/opcode region) 112)
               (= (get (.arities graph) (cast i64 merge)) 2)
               (= (count edges merge) 2)
               (> first 0)
               (> second 0)
               (!= first second))
        (mut phi) (: 0 i32)
        (mut branch) (: 0 i32)
        (mut comparison) (: 0 i32)
        (mut yes) (: 0 i32)
        (mut no) (: 0 i32)]
    (when good
      (for end [first second]
        (when (or (!= (n/opcode (get (.instructions graph) (cast i64 end))) 114)
                  (!= (count edges end) 1))
          (set! good false))))
    (when good
      (let [range (get (.ranges edges) (cast i64 merge))]
        (for [i (.offset range) (+ (.offset range) (.count range))]
          (let [edge (get (.edges edges) i)
                user (.user edge)
                node (get (.instructions graph) (cast i64 user))]
            (cond (and (= (.operand edge) 1)
                       (= (n/opcode node) 67)
                       (= (.op1 node) merge)
                       (= (get (.arities graph) (cast i64 user)) 3))
                    (set! phi user)
                  (and (= (.operand edge) 1)
                       (= (n/opcode node) 116)
                       (= (.op1 node) merge))
                    (set! branch user)
                  :else (set! good false)))))
      (when (or (= phi 0) (= branch 0)) (set! good false)))
    (when good
      (let [value (get (.instructions graph) (cast i64 phi))
            condition (input graph branch 2)
            incoming-values [(.op2 value) (.op3 value)]]
        (when (or (!= (count edges phi) 1)
                  (bits/contains? protected (cast i64 phi))
                  (= (n/type-id value) 0)
                  (not (types/valid-scalar? (cast i32 (n/type-id value)))))
          (set! good false))
        (for ref incoming-values
          (match (g/lookup graph ref)
            (None [] (set! good false))
            (Some [incoming]
                  (when (or (= ref 0)
                            (!= (n/type-id incoming) (n/type-id value))
                            (= (n/opcode incoming) 70)
                            (= (n/opcode incoming) 72))
                    (set! good false)))))
        (when (!= condition phi)
          (if (or (<= condition 0) (not (g/contains? graph condition)))
              (set! good false)
              (let [cmp (get (.instructions graph) (cast i64 condition))]
                (set! comparison condition)
                (when (or (< (n/opcode cmp) 14)
                          (> (n/opcode cmp) 23)
                          (!= (n/type-id cmp) 1)
                          (!= (.op1 cmp) phi)
                          (>= (.op2 cmp) 0)
                          (!= (count edges condition) 1)
                          (bits/contains? protected (cast i64 condition)))
                  (set! good false))
                (match (g/lookup graph (.op2 cmp))
                  (None [] (set! good false))
                  (Some [literal]
                        (when (or (not (symbols/numeric? literal))
                                  (!= (n/type-id literal) (n/type-id value)))
                          (set! good false)))))))))
    (when good
      (when (!= (count edges branch) 2) (set! good false))
      (let [range (get (.ranges edges) (cast i64 branch))]
        (for [i (.offset range) (+ (.offset range) (.count range))]
          (let [edge (get (.edges edges) i)
                user (.user edge)
                projection (get (.instructions graph) (cast i64 user))]
            (if (or (!= (.operand edge) 1) (!= (.op1 projection) branch))
                (set! good false)
                (case (n/opcode projection)
                  107 (set! yes user)
                  108 (set! no user)
                  (set! good false))))))
      (when (or (= yes 0) (= no 0)) (set! good false)))
    (if good
        (let [value (get (.instructions graph) (cast i64 phi))]
          (Some (Split
                  :phi phi
                  :branch branch
                  :comparison comparison
                  :first first
                  :second second
                  :left (.op2 value)
                  :right (.op3 value)
                  :yes yes
                  :no no)))
        (None))))

(defn split-truth [(graph g/Graph)
                   (comparison i32)
                   (value i32)
                   (pointer-bytes i32)] (-> (Option bool))
  (if (= comparison 0)
      (conditional/truth graph value)
      (if (>= value 0)
          (None)
          (let [cmp (get (.instructions graph) (cast i64 comparison))]
            (match (g/lookup graph value)
              (None [] (None))
              (Some [left]
                    (match (g/lookup graph (.op2 cmp))
                      (None [] (None))
                      (Some [right]
                            (if (not (symbols/numeric? left))
                                (None)
                                (let [ty (cast i32 (n/type-id left))
                                      result
                                        (if (types/integer? ty)
                                            (fold/integer-compare (cast i32
                                                                        (n/opcode cmp))
                                                                  ty
                                                                  pointer-bytes
                                                                  (n/constant-bits left)
                                                                  (n/constant-bits right))
                                            (floating/evaluate (cast i32
                                                                     (n/opcode cmp))
                                                               ty
                                                               (n/constant-bits left)
                                                               (n/constant-bits right)))]
                                  (match result
                                    (None [] (None))
                                    (Some [truth] (Some (!= truth 0))))))))))))))

;;; Rooted control points retain their incoming effects without forcing a new
;;; condition evaluation at an earlier observation point. Bits track the live
;;; root set so added observations are deduplicated.
(defn split-roots! [(roots (mut (ArrayList i32)))
                    (protected (mut bits/Bits))
                    (from i32)
                    (first i32)
                    (second i32)] (-> void)
  (let [(mut found) false]
    (for [i 0 (len roots)]
      (when (= (get roots i) from)
        (set! (mut roots) i first)
        (set! found true)))
    (when found
      (bits/remove! (mut protected) (cast i64 from))
      (bits/add! (mut protected) (cast i64 first))
      (when (and (> second 0)
                 (not (bits/contains? protected (cast i64 second))))
        (push! (mut roots) second)
        (bits/add! (mut protected) (cast i64 second))))))

(defn split-both! [(graph (mut g/Graph))
                   (roots (mut (ArrayList i32)))
                   (edges (mut uses/Uses))
                   (queue (mut q/Queue))
                   (protected (mut bits/Bits))
                   (merge i32)
                   (shape Split)
                   (first-true bool)] (-> i32)
  (split-roots! (mut roots)
                (mut protected)
                merge
                (.first shape)
                (.second shape))
  (split-roots! (mut roots)
                (mut protected)
                (.branch shape)
                (.first shape)
                (.second shape))
  (replace-node! (mut graph) (mut edges) (mut queue) (.branch shape) 0 0 [])
  (when (> (.comparison shape) 0)
    (replace-node! (mut graph)
                   (mut edges)
                   (mut queue)
                   (.comparison shape)
                   0
                   0
                   []))
  (replace-node! (mut graph) (mut edges) (mut queue) (.phi shape) 0 0 [])
  (replace-node! (mut graph) (mut edges) (mut queue) merge 0 0 [])
  (replace-node! (mut graph)
                 (mut edges)
                 (mut queue)
                 (.yes shape)
                 106
                 0
                 [(if first-true (.first shape) (.second shape)) (: 0 i32)])
  (replace-node! (mut graph)
                 (mut edges)
                 (mut queue)
                 (.no shape)
                 106
                 0
                 [(if first-true (.second shape) (.first shape)) (: 0 i32)])
  1)

(defn split-variable! [(graph (mut g/Graph))
                       (roots (mut (ArrayList i32)))
                       (edges (mut uses/Uses))
                       (queue (mut q/Queue))
                       (pending (mut q/Queue))
                       (protected (mut bits/Bits))
                       (merge i32)
                       (shape Split)
                       (known-end i32)
                       (variable-end i32)
                       (variable i32)
                       (known-true bool)] (-> i32)
  (let [previous (input graph variable-end 1)
        toward (if known-true (.yes shape) (.no shape))
        opposite (if known-true (.no shape) (.yes shape))
        condition (if (= (.comparison shape) 0) variable (.comparison shape))
        literal
          (if (= (.comparison shape) 0)
              0
              (input graph (.comparison shape) 2))
        compare-op
          (if (= (.comparison shape) 0)
              (: 0 u8)
              (n/opcode (get (.instructions graph)
                             (cast i64 (.comparison shape)))))]
    (split-roots! (mut roots) (mut protected) variable-end previous 0)
    (split-roots! (mut roots) (mut protected) merge known-end previous)
    (split-roots! (mut roots)
                  (mut protected)
                  (.branch shape)
                  known-end
                  variable-end)
    (replace-node! (mut graph)
                   (mut edges)
                   (mut queue)
                   (.branch shape)
                   114
                   0
                   [merge])
    (when (> (.comparison shape) 0)
      (replace-node! (mut graph)
                     (mut edges)
                     (mut queue)
                     (.comparison shape)
                     compare-op
                     1
                     [variable literal]))
    (replace-node! (mut graph) (mut edges) (mut queue) (.phi shape) 0 0 [])
    (replace-node! (mut graph)
                   (mut edges)
                   (mut queue)
                   variable-end
                   116
                   0
                   [previous condition])
    (replace-node! (mut graph)
                   (mut edges)
                   (mut queue)
                   merge
                   (if known-true (: 107 u8) 108)
                   0
                   [variable-end (: 0 i32)])
    (replace-node! (mut graph)
                   (mut edges)
                   (mut queue)
                   toward
                   112
                   0
                   [known-end (.branch shape)])
    (replace-node! (mut graph)
                   (mut edges)
                   (mut queue)
                   opposite
                   (if known-true (: 108 u8) 107)
                   0
                   [variable-end (: 0 i32)])
    ; Moving IF to its variable predecessor can expose another PHI/IF
    ; pair at an earlier merge. Revisit only that affected region.
    (when (= (n/opcode (get (.instructions graph) (cast i64 previous))) 112)
      (q/add! (mut pending) (cast i64 previous)))
    1))

(defn split-if! [(graph (mut g/Graph))
                 (roots (mut (ArrayList i32)))
                 (edges (mut uses/Uses))
                 (queue (mut q/Queue))
                 (pending (mut q/Queue))
                 (protected (mut bits/Bits))
                 (merge i32)
                 (pointer-bytes i32)] (-> i32)
  (match (split-candidate graph edges protected merge)
    (None [] 0)
    (Some [shape]
          (let [left
                  (split-truth graph
                               (.comparison shape)
                               (.left shape)
                               pointer-bytes)
                right
                  (split-truth graph
                               (.comparison shape)
                               (.right shape)
                               pointer-bytes)]
            (match left
              (Some [truth]
                    (match right
                      (Some [other]
                            (if (= truth other)
                                0
                                (split-both! (mut graph)
                                             (mut roots)
                                             (mut edges)
                                             (mut queue)
                                             (mut protected)
                                             merge
                                             shape
                                             truth)))
                      (None []
                            (split-variable! (mut graph)
                                             (mut roots)
                                             (mut edges)
                                             (mut queue)
                                             (mut pending)
                                             (mut protected)
                                             merge
                                             shape
                                             (.first shape)
                                             (.second shape)
                                             (.right shape)
                                             truth))))
              (None []
                    (match right
                      (None [] 0)
                      (Some [truth]
                            (split-variable! (mut graph)
                                             (mut roots)
                                             (mut edges)
                                             (mut queue)
                                             (mut pending)
                                             (mut protected)
                                             merge
                                             shape
                                             (.second shape)
                                             (.first shape)
                                             (.left shape)
                                             truth)))))))))

;;; A local recipe is consumed immediately, before any intervening mutation.
;;; Both the bulk pass and affected-merge iteration share this exact rewrite.
(defstruct Collapse
 [(merge i32) (phi i32) (end1 i32) (end2 i32) (arm1 i32) (arm2 i32)
  (branch i32) (previous i32) (condition i32) (yes i32) (no i32) (type u8)])

(defn collapse-plan [(graph g/Graph) (merge i32) (phi i32)] (-> Collapse)
 (let [region (get (.instructions graph) (cast i64 merge))
       end1 (.op1 region) end2 (.op2 region)
       arm1 (input graph end1 1) arm2 (input graph end2 1)
       branch (input graph arm1 1)
       value (get (.instructions graph) (cast i64 phi))
       true-first (= (n/opcode (get (.instructions graph) (cast i64 arm1))) 107)]
  (Collapse :merge merge :phi phi :end1 end1 :end2 end2 :arm1 arm1 :arm2 arm2
    :branch branch :previous (input graph branch 1) :condition (input graph branch 2)
    :yes (if true-first (.op2 value) (.op3 value))
    :no (if true-first (.op3 value) (.op2 value)) :type (n/type-id value))))

(defn apply-collapse! [(graph (mut g/Graph)) (edges (mut uses/Uses))
                       (queue (mut q/Queue)) (plan Collapse)] (-> void)
 (replace-node! (mut graph) (mut edges) (mut queue) (.branch plan) 114 0 [(.previous plan)])
 (replace-value! (mut graph) (mut edges) (mut queue) (.phi plan) (.type plan)
                 (.condition plan) (.yes plan) (.no plan))
 (replace-node! (mut graph) (mut edges) (mut queue) (.merge plan) 106 0 [(.branch plan) (: 0 i32)])
 (let [dead [(.end1 plan) (.end2 plan) (.arm1 plan) (.arm2 plan)]]
  (for reference dead
   (replace-node! (mut graph) (mut edges) (mut queue) reference 0 0 []))))

;;; Reconsider an affected MERGE using the unchanged literal-arm predicate.
;;; Root remapping matches the bulk pass, with protection updated immediately.
;;; The caller invalidates control reachability once at its ordinary boundary.
(defn at-merge! [(graph (mut g/Graph)) (roots (mut (ArrayList i32)))
                 (edges (mut uses/Uses)) (queue (mut q/Queue))
                 (protected (mut bits/Bits)) (merge i32)] (-> bool)
 (let [phi (candidate graph edges merge)]
  (if (<= phi 0) false
   (let [plan (collapse-plan graph merge phi)
         dead [(.end1 plan) (.end2 plan) (.arm1 plan) (.arm2 plan)]]
    (apply-collapse! (mut graph) (mut edges) (mut queue) plan)
    (for reference dead
     (split-roots! (mut roots) (mut protected) reference (.branch plan) 0))
    true))))

(defn rewrite! [(graph (mut g/Graph))
                (roots (mut (ArrayList i32)))
                (edges (mut uses/Uses))
                (queue (mut q/Queue))
                (pointer-bytes i32)
                (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut lookup-plan) (lookup/create a)
        (mut removed) (ArrayList::new [i32] a)
        (mut changes) (: 0 i32)
        (mut protected) (bits/create (len (.instructions graph)) a)
        (mut pending) (q/create (len (.instructions graph)) a)
        (mut r) 1]
    (for root roots (bits/add! (mut protected) (cast i64 root)))
    (for [i 0 (len (.instructions graph))] (push! (mut removed) 0))
    (while (< r (len (.instructions graph)))
      (let [(mut node) (get (.instructions graph) r)
            arity (get (.arities graph) r)]
        (when (= (n/opcode node) 112)
          (when (lookup/at-merge! (mut lookup-plan) (mut graph) (mut edges)
                                  (mut queue) protected (cast i32 r) pointer-bytes a)
            (set! changes (+ changes 1))
            (while (< (len removed) (len (.instructions graph)))
              (push! (mut removed) 0))
            (set! node (get (.instructions graph) r)))
          (set! changes
                (+ changes
                   (split-if! (mut graph)
                              (mut roots)
                              (mut edges)
                              (mut queue)
                              (mut pending)
                              (mut protected)
                              (cast i32 r)
                              pointer-bytes)))
          (let [phi
                  (if (= (n/opcode (get (.instructions graph) r)) 112)
                      (candidate graph edges (cast i32 r))
                      0)]
            (when (> phi 0)
              (let [plan (collapse-plan graph (cast i32 r) phi)
                    dead [(.end1 plan) (.end2 plan) (.arm1 plan) (.arm2 plan)]]
                (apply-collapse! (mut graph) (mut edges) (mut queue) plan)
                (for reference dead
                  (set! (mut removed) (cast i64 reference) (.branch plan)))
                (set! changes (+ changes 1))))))
        (set! r (+ r (/ (+ (cast i64 arity) 4) 4)))))
    (set! r (q/pop! (mut pending)))
    (while (>= r 0)
      (when (= (n/opcode (get (.instructions graph) r)) 112)
        (set! changes
              (+ changes
                 (split-if! (mut graph)
                            (mut roots)
                            (mut edges)
                            (mut queue)
                            (mut pending)
                            (mut protected)
                            (cast i32 r)
                            pointer-bytes))))
      (set! r (q/pop! (mut pending))))
    (for [i 0 (len roots)]
      (let [replacement (get removed (cast i64 (get roots i)))]
        (when (> replacement 0) (set! (mut roots) i replacement))))
    (lookup/release! (mut lookup-plan))
    (free! (mut removed))
    (bits/release! (mut protected))
    (q/release! (mut pending))
    (Ok changes)))
