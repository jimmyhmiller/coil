;;; Linker names of C identifiers on the target system.
;;;
;;; Images carry symbol names exactly as the object file or loader will see them:
;;; no layer adds or strips a prefix. Mach-O spells the C function `foo` as
;;; `_foo`; ELF spells it `foo`. Code that names C symbols for both systems asks
;;; here for the spelling.
(module stogir.symbol-name)
(import "stogir.target" :as target)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])

;;; What the target system puts before a C identifier: "_" on Darwin, nothing
;;; on Linux.
(defn c-prefix [] (-> (slice u8))
  (target/os-pick "_" ""))

;;; The linker name of C identifier `identifier`, owned by the caller.
(defn c-name [(identifier (slice u8)) (allocator (dyn Allocator))]
  (-> (ArrayList u8))
  (let [(mut name) (ArrayList::new [u8] allocator)]
    (for byte (c-prefix) (push! (mut name) byte))
    (for byte identifier (push! (mut name) byte))
    name))
