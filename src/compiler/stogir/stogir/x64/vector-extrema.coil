;;; Lane-wise MIN and MAX on 8- and 16-byte vectors, SSE2.
;;;
;;; SSE2 has pminub/pmaxub (unsigned bytes) and pminsw/pmaxsw (signed words)
;;; only. Every other integer lane is a compare and a select:
;;;   mask = a > b (signed or unsigned by the lane type)
;;;   MAX  = (mask & a) | (~mask & b),  MIN = (mask & b) | (~mask & a)
;;;
;;; Floating lanes keep the scalar selection contract (stogir.x64.floating,
;;; the AArch64 backend): MIN is `a <= b ? a : b` and MAX `a >= b ? a : b` on
;;; the raw operands, so the right operand is returned when the lanes are
;;; unordered and the left one for equal lanes (signed zeros), bit for bit.
;;; minps/maxps return their second operand in both cases, so the mask is
;;; cmpleps and the lanes are selected with pand/pandn/por.
;;;
;;; Registers: see stogir.x64.simd-lanes.
(module stogir.x64.vector-extrema)
(import "stogir.types" :as types)
(import "stogir.vector-arithmetic" :as vector)
(import "stogir.x64.code" :as code)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.registers" :as registers)
(import "stogir.x64.simd-lanes" :as simd)
(import "stogir.x64.vector-comparison" :as comparison)

;;; The single instruction of an integer extremum, -1 when there is none.
(defn direct-op [(opcode i32) (ty i32)] (-> i32)
  (let [signed (types/signed? (types/base-type ty))
        lane (simd/element ty)
        minimum (= opcode 58)]
    (cond (simd/floating? ty) -1
          (and (= lane 1) (not signed)) (if minimum encode/PMINUB encode/PMAXUB)
          (and (= lane 2) signed) (if minimum encode/PMINSW encode/PMAXSW)
          :else -1)))

(defn temporaries [(opcode i32) (ty i32)] (-> i32)
  (if (>= (direct-op opcode ty) 0) 0 2))

;;; t1 = (t1 & yes) | (~t1 & no), with t2 as the second copy of the mask.
(defn select! [(out (mut code/Buffer)) (error (mut (slice u8))) (yes i32) (no i32)] (-> void)
  (simd/move! (mut out) (mut error) simd/T2 simd/T1)
  (simd/sse! (mut out) (mut error) encode/PAND simd/T1 yes)
  (simd/sse! (mut out) (mut error) encode/PANDN simd/T2 no)
  (simd/sse! (mut out) (mut error) encode/POR simd/T1 simd/T2))

(defn emit-registers! [(out (mut code/Buffer)) (error (mut (slice u8))) (opcode i32)
                       (ty i32) (rd i32) (a i32) (b i32)] (-> void)
  (let [minimum (= opcode 58)
        direct (direct-op opcode ty)]
    (cond (or (not (vector/extrema? opcode))
              (not (vector/valid-type? opcode ty))
              (not (types/short-vector? ty 8))
              (not (registers/simd? rd))
              (not (registers/simd? a))
              (not (registers/simd? b)))
            (simd/fail! (mut error) "unsupported x86-64 vector extrema shape or registers")
          (>= direct 0) (simd/two-address! (mut out) (mut error) direct rd a b true)
          (simd/floating? ty)
            (do
              ; mask = a <= b (MIN) or b <= a (MAX), false when unordered.
              (simd/move! (mut out) (mut error) simd/T1 (if minimum a b))
              (simd/sse-imm! (mut out) (mut error)
                             (if (= (types/base-type ty) 12) encode/CMPPD encode/CMPPS)
                             simd/T1 (if minimum b a) 2)
              (select! (mut out) (mut error) a b)
              (simd/move! (mut out) (mut error) rd simd/T1))
          :else
            (do
              (comparison/greater! (mut out) (mut error) (simd/element ty)
                                   (not (types/signed? (types/base-type ty)))
                                   simd/T1 simd/T2 a b)
              (if minimum
                  (select! (mut out) (mut error) b a)
                  (select! (mut out) (mut error) a b))
              (simd/move! (mut out) (mut error) rd simd/T1)))))
