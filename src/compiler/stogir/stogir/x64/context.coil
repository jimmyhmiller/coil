;;; What an x86-64 emitter may read while it produces one node's code.
;;;
;;; The driver (stogir.x64.function) builds one Context per function and
;;; passes it to every emitter, core or family. It is a borrowed, immutable
;;; view: never release or mutate anything through it.
;;;
;;;   graph       the function's graph
;;;   parts       post-allocation location lookup (stogir.locations/resolve)
;;;   base        frame base for logical frame offsets
;;;               (stogir.x64.frame-address/slot)
;;;   matched     the matching plan (tiles, fusions, family side tables)
;;;   frame       the laid-out frame: `(.locals frame)` maps an owner
;;;               reference to its object's logical offset
;;;   frame-size  the prologue's rsp adjustment N. Without an anchored frame
;;;               the return address is at rsp + N and the first stack
;;;               parameter at rsp + N + 8; in general address a stack
;;;               parameter with stogir.x64.frame-address/parameter!
;;;   outgoing-size  bytes of outgoing call area at the bottom of the stack
;;;               (a multiple of `alignment`); address them with
;;;               stogir.x64.frame-address/outgoing, never through `base`
;;;   alignment   the frame's alignment (16, or more for an over-aligned
;;;               frame); dynamic stack objects are rounded to it
;;;
;;; Scratch registers free to every emitter: r10, r11, xmm14, xmm15. Nothing
;;; allocated lives in them and nothing is preserved in them between nodes.
(module stogir.x64.context)
(import "stogir.graph" :as g)
(import "stogir.locations" :as loc)
(import "stogir.frame" :as frame-layout)
(import "stogir.x64.frame-address" :as frame)
(import "stogir.x64.plan" :as plan)

(defstruct Context
  [(graph g/Graph)
   (parts loc/View)
   (base frame/Base)
   (matched plan/Plan)
   (frame frame-layout/Frame)
   (frame-size i64)
   (outgoing-size i64)
   (alignment i64)])
