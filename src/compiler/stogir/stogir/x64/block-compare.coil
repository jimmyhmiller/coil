;;; A memcmp of a fixed count of 0..16 bytes as straight-line code, in place
;;; of the runtime call the ABI lowering has already set up (System V): the
;;; two ranges are addressed by rdi and rsi and the result is left in eax.
;;;
;;; Entry points for the call family (the a64 call emitter is the model:
;;; stogir.a64.call, `inline-compare-count`): when a direct CALL declared
;;; BUILTIN-COMPARE has a count known to be a literal for which `inline?`
;;; holds and its two ranges are in rdi and rsi, emit `(emit! text count)`
;;; instead of `call`.
;;;
;;; Each range is read as one or two chunks of 8, 4, 2 or 1 bytes: the first
;;; at offset zero, the second ending at the last byte and overlapping the
;;; first when the count is not twice the chunk size. Every byte of both
;;; ranges is read, none outside them, and no alignment is assumed; memcmp's
;;; contract makes all count bytes of both ranges accessible. A chunk, or a
;;; pair of 4- or 2-byte chunks packed into one register, is byte-reversed
;;; with `bswap` so that unsigned register order is the lexicographic order
;;; of its bytes. When the first chunks differ their order decides; otherwise
;;; the overlapped bytes of the second chunks are equal and the remaining
;;; bytes decide. The result is -1, 0 or 1 with memcmp's sign.
;;;
;;; Written: rax, rcx, rdx, r8 and the flags. All are caller-saved and dead
;;; at the call this replaces, as is rdx's argument value. rdi and rsi keep
;;; their values.
;;;
;;; The a64 module of this name is not shared: it is AArch64 encodings of the
;;; same plan.
(module stogir.x64.block-compare)
(import "stogir.x64.encode" :as e)
(import "stogir.x64.registers" :as registers)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn maximum [] (-> i64) 16)

(defn inline? [(count i64)] (-> bool)
  (and (>= count 0) (<= count (maximum))))

(defn accept! [(error (mut (slice u8))) (result (Result i64 (slice u8)))] (-> void)
  (match result
    (Err [message] (when (= error "") (set! error message)))
    (Ok [_] 0)))

;;; The bytes of the range at `base` in lexicographic register order: for a
;;; count of at most eight, all of them in `first`; above that, the first
;;; eight in `first` and the last eight in `second`.
(defn gather! [(out (mut (ArrayList u8))) (error (mut (slice u8))) (base i32) (count i64)
               (first i32) (second i32)] (-> void)
  (let [chunk (cond (>= count 8) (: 8 i64) (>= count 4) 4 (>= count 2) 2 :else 1)
        two (> count chunk)
        bits (cast i32 (* chunk 8))
        head (e/mem base 0)
        tail (e/mem base (- count chunk))]
    ; Chunks below four bytes are zero-extended so the 32-bit comparison
    ; sees only their bytes.
    (accept! (mut error)
             (if (< chunk 4)
                 (e/movzx-rm (mut out) 32 bits first head)
                 (e/mov-rm (mut out) bits first head)))
    (when two
      (accept! (mut error)
               (if (< chunk 4)
                   (e/movzx-rm (mut out) 32 bits second tail)
                   (e/mov-rm (mut out) bits second tail))))
    (cond (= chunk 8)
            (do
              (accept! (mut error) (e/bswap (mut out) 64 first))
              (when two (accept! (mut error) (e/bswap (mut out) 64 second))))
          (= chunk 4)
            (if two
                ; The first chunk in the low half: reversed, its bytes lead.
                (do
                  (accept! (mut error) (e/shift-ri (mut out) e/SHL 64 second 32))
                  (accept! (mut error) (e/alu-rr (mut out) e/OR 64 first second))
                  (accept! (mut error) (e/bswap (mut out) 64 first)))
                (accept! (mut error) (e/bswap (mut out) 32 first)))
          (= chunk 2)
            (do
              (when two
                (accept! (mut error) (e/shift-ri (mut out) e/SHL 32 second 16))
                (accept! (mut error) (e/alu-rr (mut out) e/OR 32 first second)))
              (accept! (mut error) (e/bswap (mut out) 32 first)))
          :else 0)))

(defn emit! [(out (mut (ArrayList u8))) (count i64)] (-> (Result i32 (slice u8)))
  (if (not (inline? count))
      (Err "block compare count outside the inline range")
      (let [before (len out)
            (mut error) ""
            bits (if (>= count 5) (: 64 i32) 32)
            a (: registers/RAX i32)
            a2 (: registers/RCX i32)
            b (: registers/RDX i32)
            b2 (: registers/R8 i32)]
        (if (= count 0)
            (accept! (mut error) (e/mov-ri (mut out) 32 a 0))
            (do
              (gather! (mut out) (mut error) registers/RDI count a a2)
              (gather! (mut out) (mut error) registers/RSI count b b2)
              (accept! (mut error) (e/alu-rr (mut out) e/CMP bits a b))
              (when (> count 8)
                ; Differing first chunks decide; equal ones leave it to the
                ; second chunks, which then replace them in the comparison.
                (accept! (mut error) (e/cmov-rr (mut out) e/CC-E 64 a a2))
                (accept! (mut error) (e/cmov-rr (mut out) e/CC-E 64 b b2))
                (accept! (mut error) (e/alu-rr (mut out) e/CMP 64 a b)))
              ; 1 when the first range is higher, minus 1 when it is lower.
              (accept! (mut error) (e/setcc-r (mut out) e/CC-A a))
              (accept! (mut error) (e/setcc-r (mut out) e/CC-B a2))
              (accept! (mut error) (e/movzx-rr (mut out) 32 8 a a))
              (accept! (mut error) (e/movzx-rr (mut out) 32 8 a2 a2))
              (accept! (mut error) (e/alu-rr (mut out) e/SUB 32 a a2))))
        (if (= error "")
            (Ok (cast i32 (- (len out) before)))
            (do
              (while (> (len out) before) (pop! (mut out)))
              (Err error))))))
