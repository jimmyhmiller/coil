;;; Advisory register preferences on x86-64: they change which legal register
;;; the allocator picks, never a value's identity or a hard constraint.
;;;
;;; The constraints builder and the operation families record them in the
;;; uses/Set (`preferences`: a value would like one register; `hints`: a
;;; value would like the register another value had, as a two-address result
;;; does with its first operand). `apply!` attaches them to the allocation
;;; parts.
;;;
;;; The a64 module of this name is not shared: it derives its preferences by
;;; walking the graph with AAPCS64 argument tables.
(module stogir.x64.preferences)
(import "stogir.allocation" :as allocation)
(import "stogir.x64.coalesce" :as coalesce)
(import "stogir.x64.uses" :as uses)
(import "coil.arraylist" :use [ArrayList])

;;; Index of the part of graph value `reference`, -1 when it has none. Before
;;; reservations and splits the parts are sorted by parent.
(defn find [(parts (ArrayList allocation/Part)) (reference i32)] (-> i32)
  (let [(mut lo) 0
        (mut hi) (len parts)]
    (while (< lo hi)
      (let [mid (+ lo (/ (- hi lo) 2))]
        (if (< (.parent (at parts mid)) reference)
            (set! lo (+ mid 1))
            (set! hi mid))))
    (if (and (< lo (len parts)) (= (.parent (at parts lo)) reference))
        (cast i32 lo)
        -1)))

;;; Attach every preference and hint of `set`. Joined values are resolved to
;;; their owner first; the first preference of a value wins.
(defn apply! [(parts (mut (ArrayList allocation/Part)))
              (aliases (ArrayList i32))
              (set uses/Set)] (-> void)
  (for [i 0 (len parts)]
    (let [part (elem (mut parts) i)]
      (set! (.hint-owner part) (cast i32 i))
      (set! (.last-register part) (.register part))))
  (for preference (.preferences set)
    (let [index (find parts (coalesce/canonical aliases (.reference preference)))]
      (when (>= index 0)
        (let [part (elem (mut parts) (cast i64 index))]
          (when (< (.preferred part) 0) (set! (.preferred part) (.register preference)))))))
  (for hint (.hints set)
    (let [target (coalesce/canonical aliases (.reference hint))
          source (coalesce/canonical aliases (.source hint))
          target-part (find parts target)
          source-part (find parts source)]
      (when (and (!= target source) (>= target-part 0) (>= source-part 0))
        (let [part (elem (mut parts) (cast i64 target-part))]
          (when (< (.hint part) 0) (set! (.hint part) source-part)))))))
