;;; Test support for the x86-64 call family (tests/x64-call-*.coil): graph
;;; shorthands for prototypes and calls, and loading an image whose undefined
;;; symbols are resolved to host functions. Only tests import this module.
(module stogir.x64.call-testing)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.call-groups" :as groups)
(import "stogir.call-results" :as results)
(import "stogir.symbols" :as symbols)
(import "stogir.image" :as image)
(import "stogir.jit.native" :as jit)
(import "stogir.x64.compile" :as compile)
(import "stogir.x64.testing" :as support)
(import "stogir.graph-seal" :as seal)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Option Some None])

(defn need [(result (Result i32 (slice u8)))] (-> i32)
  (match result
    (Ok [value] value)
    (Err [message] (panic "x64 call test graph construction failed: {}" message))))

;;; A prototype of convention 8 (System V), variadic when `variadic`.
(defn prototype [(variadic bool) (result u8) (parameters (slice u8))
                 (descriptors (slice groups/Group)) (a (dyn Allocator))] (-> calls/Prototype)
  (match (calls/create-grouped (if variadic 24 8) result parameters descriptors a)
    (Ok [built] built)
    (Err [message] (panic "x64 call test prototype: {}" message))))

;;; A prototype whose result is an aggregate role; parameter 0 is its place.
(defn result-prototype [(parameters (slice u8)) (descriptors (slice groups/Group))
                        (spec results/Spec) (a (dyn Allocator))] (-> calls/Prototype)
  (match (calls/create-result 8 parameters descriptors spec a)
    (Ok [built] built)
    (Err [message] (panic "x64 call test result prototype: {}" message))))

(defn memory! [(prototype (mut calls/Prototype)) (ordinal i32) (size i64) (alignment i32)]
  (-> void)
  (match (calls/memory-parameter! (mut prototype) ordinal size alignment)
    (Ok [_] 0)
    (Err [message] (panic "x64 call test MEMORY record: {}" message)))
  0)

;;; Declare `prototype` the signature of the function `graph` defines.
(defn declare! [(graph (mut g/Graph)) (prototype calls/Prototype) (a (dyn Allocator))] (-> void)
  (need (calls/function! (mut graph) prototype a))
  0)

(defn group [(first i32) (count i32) (alignment i32)] (-> groups/Group)
  (groups/Group :first first :count count :alignment alignment))

;;; The named function constant `name` (called with `call rel32`, PLT32).
(defn named! [(graph (mut g/Graph)) (name (slice u8))] (-> i32)
  (need (symbols/function! (mut graph) name 0)))

;;; The numeric address constant `address`.
(defn address! [(graph (mut g/Graph)) (address u64)] (-> i32)
  (need (b/scalar-constant! (mut graph) 6 address 8)))

(defn call! [(graph (mut g/Graph)) (prototype calls/Prototype) (control i32) (callee i32)
             (arguments (slice i32)) (a (dyn Allocator))] (-> i32)
  (need (calls/emit! (mut graph) prototype control callee arguments a)))

;;; TAILCALL followed by its UNREACHABLE; the result is the terminal root.
(defn tail! [(graph (mut g/Graph)) (prototype calls/Prototype) (control i32) (callee i32)
             (arguments (slice i32)) (a (dyn Allocator))] (-> i32)
  (need (calls/emit-tail! (mut graph) prototype control callee arguments 0 a)))

;;; ARGVAL of `size` bytes at address value `source`.
(defn by-value! [(graph (mut g/Graph)) (source i32) (size i32) (alignment i32)] (-> i32)
  (need (b/argument-value! (mut graph) source size alignment)))

;;; The image of `graph` compiled as given, or a panic naming `label`.
(defn image-of [(label (slice u8)) (graph g/Graph) (start i32) (roots (slice i32))
                (a (dyn Allocator))] (-> image/Image)
  (match (let [sealed (seal/seal graph)
               outcome (compile/image graph start roots "x64_call_test_entry" a)]
           (support/unchanged! sealed graph label)
           outcome)
    (Ok [code] code)
    (Err [message] (panic "{}: compile failed: {}" label message))))

;;; Map `code`, resolving each undefined symbol named in `names` to the
;;; address at the same index of `addresses`. The entry is `(entry loaded)`.
(defn map-resolved [(label (slice u8)) (code image/Image) (names (slice (slice u8)))
            (addresses (slice u64)) (a (dyn Allocator))] (-> jit/Loaded)
  (let [(mut values) (ArrayList::new [u64] a)
        (mut found) (ArrayList::new [bool] a)]
    (for symbol (.symbols code)
      (let [(mut value) (: 0 u64)
            (mut present) false]
        (for [i 0 (len names)]
          (when (image/same-name? code symbol (get names i))
            (set! value (get addresses i))
            (set! present true)))
        (push! (mut values) value)
        (push! (mut found) present)))
    (let [result (jit/map-image-resolved code (slice values) (slice found) a)]
      (free! (mut values))
      (free! (mut found))
      (match result
        (Ok [loaded] loaded)
        (Err [message] (panic "{}: load failed: {}" label message))))))

;;; Compile and load in one step; the image is released.
(defn build [(label (slice u8)) (graph g/Graph) (start i32) (roots (slice i32))
             (names (slice (slice u8))) (addresses (slice u64)) (a (dyn Allocator))]
  (-> jit/Loaded)
  (let [(mut code) (image-of label graph start roots a)
        loaded (map-resolved label code names addresses a)]
    (image/release! (mut code))
    loaded))

(defn entry [(loaded jit/Loaded)] (-> (ptr u8))
  (.base (.memory loaded)))
