;;; PLACEHOLDER for the x86-64 backend's compile entry points.
;;;
;;; Every function here has the signature of its `stogir.a64.compile` namesake
;;; and fails with "x86-64 backend: NAME is not implemented yet". The real
;;; backend replaces this file; `stogir.native.compile` forwards to it when the
;;; program is compiled for x86-64, so the facade-level tests become its gate
;;; one entry point at a time.
;;;
;;; `object` and `object-with-options` are not here: the facade builds them from
;;; `image` / `image-with-options` and `stogir.aot.native/image-object`.
;;;
;;; The private context types come from `stogir.native.private-types`.
(module stogir.x64.compile)
(export validate text image vector-image image-with-options image-with-private image-for-private-module image-for-private-module-optimized image-with-options-optimized image-for-private-module-proven image-with-options-proven)
(import "stogir.graph" :as g)
(import "stogir.options" :as options)
(import "stogir.image" :as code)
(import "stogir.native.private-types" :as private)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn validate [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (Err "x86-64 backend: validate is not implemented yet"))

(defn text [(graph g/Graph) (entry i32) (roots (slice i32)) (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (Err "x86-64 backend: text is not implemented yet"))

(defn image [(graph g/Graph) (entry i32) (roots (slice i32)) (symbol (slice u8))
             (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (Err "x86-64 backend: image is not implemented yet"))

(defn vector-image [(graph g/Graph) (entry i32) (roots (slice i32)) (symbol (slice u8))
                    (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (Err "x86-64 backend: vector-image is not implemented yet"))

(defn image-with-options [(graph g/Graph) (entry i32) (roots (slice i32))
                          (symbol (slice u8)) (configuration options/Options)
                          (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (Err "x86-64 backend: image-with-options is not implemented yet"))

(defn image-with-private [(graph g/Graph) (entry i32) (roots (slice i32))
                          (symbol (slice u8)) (configuration options/Options)
                          (a (dyn Allocator)) (context private/Context)]
  (-> (Result code/Image (slice u8)))
  (Err "x86-64 backend: image-with-private is not implemented yet"))

(defn image-for-private-module [(graph g/Graph) (entry i32) (roots (slice i32))
                                (symbol (slice u8)) (configuration options/Options)
                                (a (dyn Allocator)) (context private/Context)
                                (publication private/Publication) (scope usize)]
  (-> (Result code/Image (slice u8)))
  (Err "x86-64 backend: image-for-private-module is not implemented yet"))

(defn image-for-private-module-optimized [(graph g/Graph) (entry i32) (roots (slice i32))
                                          (symbol (slice u8)) (configuration options/Options)
                                          (a (dyn Allocator)) (context private/Context)
                                          (publication private/Publication) (scope usize)]
  (-> (Result code/Image (slice u8)))
  (Err "x86-64 backend: image-for-private-module-optimized is not implemented yet"))

(defn image-with-options-optimized [(graph g/Graph) (entry i32) (roots (slice i32))
                                    (symbol (slice u8)) (configuration options/Options)
                                    (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (Err "x86-64 backend: image-with-options-optimized is not implemented yet"))

(defn image-for-private-module-proven [(graph g/Graph) (entry i32) (roots (slice i32))
                                       (symbol (slice u8)) (configuration options/Options)
                                       (a (dyn Allocator)) (context private/Context)
                                       (publication private/Publication) (scope usize)
                                       (proof u128)]
  (-> (Result code/Image (slice u8)))
  (Err "x86-64 backend: image-for-private-module-proven is not implemented yet"))

(defn image-with-options-proven [(graph g/Graph) (entry i32) (roots (slice i32))
                                 (symbol (slice u8)) (configuration options/Options)
                                 (a (dyn Allocator)) (proof u128)]
  (-> (Result code/Image (slice u8)))
  (Err "x86-64 backend: image-with-options-proven is not implemented yet"))
