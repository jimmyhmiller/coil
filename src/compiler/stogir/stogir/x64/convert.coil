;;; Integer conversions: SEXT, ZEXT, TRUNC and integer BITCAST.
;;;
;;; Sources are read at their own width and results defined at least at the
;;; arithmetic width (stogir.x64.value). TRUNC and a BITCAST that is not a
;;; conversion to BOOL are plain moves of the whole register: they are views
;;; (stogir.x64.coalesce). A BOOL result is canonicalized to 0
;;; or 1 from the low byte, as stogir.conversion/bits-evaluate folds it.
;;; A constant source is folded with that same function and built with `mov`.
;;;
;;; INT2FP, FP2INT, FP2FP and BITCAST between the register banks belong to
;;; the floating family (stogir.x64.floating); vector casts to the vector
;;; family.
(module stogir.x64.convert)
(import "stogir.conversion" :as conversion)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.x64.code" :as code)
(import "stogir.x64.context" :as context)
(import "stogir.x64.emit" :as emit)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.registers" :as registers)
(import "stogir.x64.value" :as value)
(import "coil.result" :use [Result Ok Err Some None])

;;; Whether node `reference` is SEXT/ZEXT/TRUNC/BITCAST from an integer type
;;; to an integer type.
(defn integer? [(graph g/Graph) (reference i32)] (-> bool)
  (match (g/lookup graph reference)
    (None [] false)
    (Some [node]
          (and (>= (n/opcode node) 33)
               (<= (n/opcode node) 36)
               (types/integer? (cast i32 (n/type-id node)))
               (types/integer? (value/type-of graph (.op1 node)))))))

(defn emit! [(out (mut code/Buffer)) (cx context/Context) (reference i32) (position i64)]
  (-> (Result i32 (slice u8)))
  (let [node (get (.instructions (.graph cx)) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        target (cast i32 (n/type-id node))
        origin (value/type-of (.graph cx) (.op1 node))
        from (value/type-bits origin)
        to (value/type-bits target)
        wide (value/operation-bits target)]
    (match (conversion/validate (.graph cx) reference 8)
      (Err [message] (Err message))
      (Ok [_]
          (match (emit/destination cx reference position)
            (Err [message] (Err message))
            (Ok [rd]
                (let [(mut error) ""]
                  ; A numeric constant is folded; a named one (a symbol's
                  ; address) is an operand like any register value.
                  (match (value/constant-bits (.graph cx) (.op1 node))
                    (Some [raw]
                          (match (conversion/evaluate opcode origin target 8 raw)
                            (None [] (set! error "conversion constant cannot be evaluated"))
                            (Some [folded]
                                  (code/accept-count! (mut error)
                                                      (value/bits! (mut out) rd folded to)))))
                    (None []
                      (match (emit/operand! (mut out) cx (.op1 node) position
                                            registers/SCRATCH-GPR)
                        (Err [message] (set! error message))
                        (Ok [ra]
                            (cond (and (= target 1) (!= origin 1))
                                    (do
                                      (code/accept! (mut error)
                                                    (encode/test-rr (mut (.text out)) 8 ra ra))
                                      (code/accept-count! (mut error)
                                                          (emit/set-condition! (mut out)
                                                                               encode/CC-NE rd)))
                                  (= opcode 33)
                                    (code/accept! (mut error)
                                                  (encode/movsx-rr (mut (.text out)) wide from rd ra))
                                  (= opcode 34)
                                    (code/accept! (mut error)
                                                  (encode/movzx-rr (mut (.text out)) wide from rd ra))
                                  ; TRUNC and BITCAST are views that may
                                  ; share a register group with a wider
                                  ; value that lives on
                                  ; (stogir.x64.coalesce): when the registers
                                  ; differ the whole register is moved.
                                  :else (emit/move! (mut out) (mut error) 64 rd ra))))))
                  (if (= error "") (Ok 0) (Err error)))))))))
