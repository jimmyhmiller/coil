;;; Lane-wise ADD SUB MUL DIV MOD AND OR XOR on 8- and 16-byte vectors, SSE2.
;;;
;;;   ADD SUB           padd*/psub*; addps/addpd, subps/subpd
;;;   AND OR XOR        pand/por/pxor (integer lanes only, as the IR allows)
;;;   MUL  2-byte       pmullw
;;;        1-byte       even and odd bytes multiplied as words (pmullw) and
;;;                     recombined: SSE2 has no byte multiply
;;;        4-byte       pmuludq on the even and on the odd lanes, low halves
;;;                     interleaved (pmulld is SSE4.1)
;;;        8-byte       lo*lo + ((hi*lo + lo*hi) << 32) from three pmuludq
;;;        float        mulps/mulpd
;;;   DIV  float        divps/divpd
;;;   DIV MOD integer   one `div`/`idiv` per lane through the node's scratch
;;;                     frame object (`divide!`): the same instruction, operand
;;;                     extension and traps as scalar division (zero divisor
;;;                     and MIN / -1 raise #DE; 1- and 2-byte lanes divide as
;;;                     32-bit values and cannot overflow).
;;;
;;; A single DOUBLE lane (the 8-byte vector of one f64) uses the scalar
;;; instructions, so the unspecified upper quadword is not computed with.
;;; Integer results wrap at the lane width; floating results are the
;;; hardware's, as for scalars (stogir.x64.floating).
;;;
;;; Registers: see stogir.x64.simd-lanes. `temporaries` is how many of
;;; T1..T3 an operation writes.
(module stogir.x64.vector-arithmetic)
(import "stogir.types" :as types)
(import "stogir.vector-arithmetic" :as vector)
(import "stogir.x64.code" :as code)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.registers" :as registers)
(import "stogir.x64.simd-lanes" :as simd)

;;; Integer DIV and MOD: done lane by lane in general registers.
(defn lane-expanded? [(opcode i32) (ty i32)] (-> bool)
  (and (types/integer? (types/base-type ty)) (or (= opcode 29) (= opcode 30))))

(defn binary? [(opcode i32)] (-> bool)
  (or (and (>= opcode 26) (<= opcode 30)) (and (>= opcode 46) (<= opcode 48))))

(defn temporaries [(opcode i32) (ty i32)] (-> i32)
  (if (and (= opcode 28) (not (simd/floating? ty)))
      (case (simd/element ty) 1 2 2 0 4 3 2)
      0))

;;; The instruction of a floating lane operation.
(defn floating-op [(opcode i32) (ty i32)] (-> i32)
  (let [double (= (types/base-type ty) 12)
        single-lane (and double (= (simd/width ty) 8))]
    (case opcode
      26 (cond single-lane encode/ADDSD double encode/ADDPD :else encode/ADDPS)
      27 (cond single-lane encode/SUBSD double encode/SUBPD :else encode/SUBPS)
      28 (cond single-lane encode/MULSD double encode/MULPD :else encode/MULPS)
      29 (cond single-lane encode/DIVSD double encode/DIVPD :else encode/DIVPS)
      -1)))

;;; rd = a * b for integer lanes that need a sequence (all but 2-byte lanes).
(defn multiply! [(out (mut code/Buffer)) (error (mut (slice u8))) (lane i32) (rd i32)
                 (a i32) (b i32)] (-> void)
  (let [t1 (: simd/T1 i32)
        t2 (: simd/T2 i32)
        t3 (: simd/T3 i32)]
    (cond (= lane 1)
            (do
              ; Odd bytes: (a >> 8) * (b >> 8) as words, back in the high byte.
              (simd/move! (mut out) (mut error) t1 a)
              (simd/shift! (mut out) (mut error) encode/PSRLW-I t1 8)
              (simd/move! (mut out) (mut error) t2 b)
              (simd/shift! (mut out) (mut error) encode/PSRLW-I t2 8)
              (simd/sse! (mut out) (mut error) encode/PMULLW t1 t2)
              (simd/shift! (mut out) (mut error) encode/PSLLW-I t1 8)
              ; Even bytes: the low byte of the word product.
              (simd/move! (mut out) (mut error) t2 a)
              (simd/sse! (mut out) (mut error) encode/PMULLW t2 b)
              (simd/shift! (mut out) (mut error) encode/PSLLW-I t2 8)
              (simd/shift! (mut out) (mut error) encode/PSRLW-I t2 8)
              (simd/sse! (mut out) (mut error) encode/POR t1 t2)
              (simd/move! (mut out) (mut error) rd t1))
          (= lane 4)
            (do
              (simd/sse-imm! (mut out) (mut error) encode/PSHUFD t2 a 0xF5)
              (simd/sse-imm! (mut out) (mut error) encode/PSHUFD t3 b 0xF5)
              (simd/sse! (mut out) (mut error) encode/PMULUDQ t2 t3)
              (simd/move! (mut out) (mut error) t1 a)
              (simd/sse! (mut out) (mut error) encode/PMULUDQ t1 b)
              (simd/sse-imm! (mut out) (mut error) encode/PSHUFD t1 t1 0xE8)
              (simd/sse-imm! (mut out) (mut error) encode/PSHUFD t2 t2 0xE8)
              (simd/sse! (mut out) (mut error) encode/PUNPCKLDQ t1 t2)
              (simd/move! (mut out) (mut error) rd t1))
          (= lane 8)
            (do
              (simd/move! (mut out) (mut error) t1 a)
              (simd/shift! (mut out) (mut error) encode/PSRLQ-I t1 32)
              (simd/sse! (mut out) (mut error) encode/PMULUDQ t1 b)
              (simd/move! (mut out) (mut error) t2 b)
              (simd/shift! (mut out) (mut error) encode/PSRLQ-I t2 32)
              (simd/sse! (mut out) (mut error) encode/PMULUDQ t2 a)
              (simd/sse! (mut out) (mut error) encode/PADDQ t1 t2)
              (simd/shift! (mut out) (mut error) encode/PSLLQ-I t1 32)
              (simd/move! (mut out) (mut error) t2 a)
              (simd/sse! (mut out) (mut error) encode/PMULUDQ t2 b)
              (simd/sse! (mut out) (mut error) encode/PADDQ t1 t2)
              (simd/move! (mut out) (mut error) rd t1))
          :else (simd/fail! (mut error) "invalid x86-64 vector multiplication lane"))))

;;; rd = a OP b for every binary operation that stays in XMM registers
;;; (everything but integer DIV and MOD). rd, a and b are XMM registers under
;;; the roles of stogir.x64.simd-lanes.
(defn emit-registers! [(out (mut code/Buffer)) (error (mut (slice u8))) (opcode i32)
                       (ty i32) (rd i32) (a i32) (b i32)] (-> void)
  (let [lane (simd/element ty)]
    (cond (or (not (binary? opcode))
              (not (vector/valid-type? opcode ty))
              (not (types/short-vector? ty 8))
              (lane-expanded? opcode ty)
              (not (registers/simd? rd))
              (not (registers/simd? a))
              (not (registers/simd? b)))
            (simd/fail! (mut error) "unsupported x86-64 vector binary shape or registers")
          (simd/floating? ty)
            (simd/two-address! (mut out) (mut error) (floating-op opcode ty) rd a b
                               (or (= opcode 26) (= opcode 28)))
          (= opcode 26)
            (simd/two-address! (mut out) (mut error) (simd/add-op lane) rd a b true)
          (= opcode 27)
            (simd/two-address! (mut out) (mut error) (simd/subtract-op lane) rd a b false)
          (= opcode 46) (simd/two-address! (mut out) (mut error) encode/POR rd a b true)
          (= opcode 47) (simd/two-address! (mut out) (mut error) encode/PAND rd a b true)
          (= opcode 48) (simd/two-address! (mut out) (mut error) encode/PXOR rd a b true)
          (= lane 2) (simd/two-address! (mut out) (mut error) encode/PMULLW rd a b true)
          :else (multiply! (mut out) (mut error) lane rd a b))))

;;; rd = a / b (DIV) or a % b (MOD) for integer lanes, through the scratch
;;; frame object `slot` (32 bytes): a is stored at slot, b at slot + 16, each
;;; lane is divided in rax:rdx with its result written over a's lane, and rd
;;; is loaded back. The caller has rax and rdx clobbered; r11 is written.
(defn divide! [(out (mut code/Buffer)) (error (mut (slice u8))) (opcode i32) (ty i32)
               (slot encode/Mem) (rd i32) (a i32) (b i32)] (-> void)
  (let [lane (simd/element ty)
        bits (* lane 8)
        wide (if (< bits 32) (: 32 i32) bits)
        signed (types/signed? (types/base-type ty))
        result (if (= opcode 29) (: registers/RAX i32) registers/RDX)]
    (if (or (not (lane-expanded? opcode ty))
            (not (vector/valid-type? opcode ty))
            (not (types/short-vector? ty 8)))
        (simd/fail! (mut error) "unsupported x86-64 vector division shape")
        (do
          (simd/write! (mut out) (mut error) slot a 16)
          (simd/write! (mut out) (mut error) (simd/after slot 16) b 16)
          (for [index 0 (cast i64 (types/lanes ty))]
            (let [dividend (simd/after slot (* index (cast i64 lane)))
                  divisor (simd/after dividend 16)]
              (if (< bits 32)
                  (do
                    (code/accept! (mut error)
                                  (if signed
                                      (encode/movsx-rm (mut (.text out)) 32 bits registers/RAX
                                                       dividend)
                                      (encode/movzx-rm (mut (.text out)) 32 bits registers/RAX
                                                       dividend)))
                    (code/accept! (mut error)
                                  (if signed
                                      (encode/movsx-rm (mut (.text out)) 32 bits simd/R11 divisor)
                                      (encode/movzx-rm (mut (.text out)) 32 bits simd/R11
                                                       divisor))))
                  (code/accept! (mut error)
                                (encode/mov-rm (mut (.text out)) bits registers/RAX dividend)))
              (code/accept! (mut error)
                            (if signed
                                (encode/sign-extend-rax-rdx (mut (.text out)) wide)
                                (encode/zero-r (mut (.text out)) registers/RDX)))
              (code/accept! (mut error)
                            (if (< bits 32)
                                (encode/unary-r (mut (.text out))
                                                (if signed encode/IDIV encode/DIV) 32 simd/R11)
                                (encode/unary-m (mut (.text out))
                                                (if signed encode/IDIV encode/DIV) bits divisor)))
              (code/accept! (mut error)
                            (encode/mov-mr (mut (.text out)) bits dividend result))))
          (simd/read! (mut out) (mut error) rd slot (simd/width ty))))))
