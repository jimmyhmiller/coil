;;; The floating constant pool of one x86-64 function.
;;;
;;; A FLOAT or DOUBLE constant other than +0.0 is loaded with
;;; `movss/movsd xmm, [rip + disp32]` (stogir.x64.value/float-constant!),
;;; which leaves a pending stogir.x64.code/Reference: kind PC32, addend -4,
;;; target the constant's graph reference. `finish!` runs when the function's
;;; text is complete and nothing in it can move any more. It appends the pool
;;; to the text (after the last instruction, which never falls through),
;;; patches every such displacement and removes the references it resolved.
;;; The pool is part of the function's text, at a fixed distance from each
;;; load, so no image relocation and no data symbol are involved; the bytes
;;; are recorded as a text data range (stogir.text-data, kind 1: plain data).
;;;
;;; Layout: padding (0xCC) to a multiple of 8 bytes from the function's
;;; start, the 8-byte constants, then the 4-byte ones. Identical bit patterns
;;; of one size share an entry. The function's alignment is raised to 8 so
;;; an image places the 8-byte entries on their natural alignment.
;;;
;;; References to anything else (named constants: the memory and call
;;; families) are left alone for stogir.x64.image/finish!.
(module stogir.x64.pool)
(import "stogir.alignment" :as alignment)
(import "stogir.graph" :as g)
(import "stogir.text-data" :as text-data)
(import "stogir.x64.code" :as code)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.value" :as value)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

;;; One pool entry: `size` bytes (4 or 8) holding `bits`, at text `offset`.
(defstruct Entry [(size i32) (bits u64) (offset i64)])

;;; The entry index of (`size`, `bits`), added when new.
(defn entry! [(entries (mut (ArrayList Entry))) (size i32) (bits u64)] (-> i64)
  (let [(mut found) (: -1 i64)]
    (for [i 0 (len entries)]
      (let [entry (get entries i)]
        (when (and (= (.size entry) size) (= (.bits entry) bits)) (set! found i))))
    (when (< found 0)
      (set! found (len entries))
      (push! (mut entries) (Entry :size size :bits bits :offset -1)))
    found))

(defn finish! [(out (mut code/Buffer)) (graph g/Graph) (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut entries) (ArrayList::new [Entry] allocator)
        ; The entry of each reference, -1 for one that is not a pool load.
        (mut owners) (ArrayList::new [i64] allocator)
        (mut error) ""]
    (for reference (.references out)
      (match (value/float-constant-bits graph (.target reference))
        (None [] (push! (mut owners) -1))
        (Some [bits]
              (if (or (!= (.kind reference) 5)
                      (!= (.addend reference) -4)
                      (< (.offset reference) 0)
                      (> (.offset reference) (- (len (.text out)) 4)))
                  (do
                    (set! error "invalid x86-64 floating constant reference")
                    (push! (mut owners) -1))
                  (push! (mut owners)
                         (entry! (mut entries)
                                 (if (value/double? (value/type-of graph (.target reference)))
                                     8
                                     4)
                                 bits))))))
    (when (and (= error "") (> (len entries) 0))
      (while (!= (% (len (.text out)) 8) 0) (push! (mut (.text out)) 0xCC))
      (let [begin (len (.text out))]
        (for size [(: 8 i32) 4]
          (for [i 0 (len entries)]
            (let [entry (get entries i)]
              (when (= (.size entry) size)
                (set! (mut entries) i
                      (Entry :size size :bits (.bits entry) :offset (len (.text out))))
                (encode/imm! (mut (.text out)) size (cast i64 (.bits entry)))))))
        (push! (mut (.text-data out))
               (text-data/Range :offset begin :length (- (len (.text out)) begin) :kind 1))
        (set! (.alignment out) (alignment/maximum (.alignment out) 8)))
      ; Patch the loads and keep only the references that are not ours.
      (let [(mut kept) 0]
        (for [i 0 (len (.references out))]
          (let [reference (get (.references out) i)
                owner (get owners i)]
            (if (< owner 0)
                (do
                  (set! (mut (.references out)) kept reference)
                  (set! kept (+ kept 1)))
                (let [displacement (- (.offset (get entries owner))
                                      (+ (.offset reference) 4))]
                  (if (not (encode/fits32? displacement))
                      (set! error "x86-64 floating constant pool is out of reach")
                      (for [k 0 4]
                        (set! (mut (.text out)) (+ (.offset reference) k)
                              (cast u8 (& (>> displacement (* k 8)) 255)))))))))
        (while (> (len (.references out)) kept) (pop! (mut (.references out))))))
    (let [count (cast i32 (len entries))]
      (free! (mut entries))
      (free! (mut owners))
      (if (= error "") (Ok count) (Err error)))))
