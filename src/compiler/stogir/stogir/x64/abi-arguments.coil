;;; System V x86-64 argument placement, shared by callers and callees.
;;;
;;; The Coil compiler's CIR arrives classified into eightbytes, so this module
;;; only places: every parameter is one eightbyte (an integer type, FLOAT or
;;; DOUBLE), a group (stogir.call-groups) is one aggregate of one or two
;;; eightbytes, and a MEMORY record is one aggregate passed in memory.
;;;
;;;   * Integer eightbytes take rdi rsi rdx rcx r8 r9 in order, floating ones
;;;     xmm0..xmm7. The two banks are independent.
;;;   * A group takes registers only when every member fits; otherwise the
;;;     whole group goes to the stack and its banks are NOT exhausted: a later
;;;     argument still takes the next free register.
;;;   * A stack argument takes one 8-byte slot. A group of alignment 16 and a
;;;     MEMORY aggregate of alignment 16 start at a multiple of 16; alignment
;;;     has no effect on register placement (there is no even-register rule).
;;;   * A MEMORY aggregate occupies its size rounded up to 8 bytes of stack
;;;     and no register.
;;;   * Unnamed arguments of a variadic call are placed like named ones; an
;;;     unnamed FLOAT is promoted to DOUBLE. `vectors` counts the xmm
;;;     registers used (the caller passes it in al).
;;;   * An indirect result's hidden pointer is the first integer argument
;;;     (rdi). The result place of register pieces consumes nothing.
;;;
;;; Offsets are relative to the first stack argument: [rsp] at the call
;;; instruction, [entry rsp + 8] in the callee.
;;;
;;; The a64 module of this name is not shared: it is the AAPCS64/Darwin rules
;;; (banks exhausted by a group that does not fit, HFAs of up to four members,
;;; x8, naturally sized stack arguments, unnamed arguments on the stack).
(module stogir.x64.abi-arguments)
(import "stogir.call-groups" :as groups)
(import "stogir.call-results" :as results)
(import "stogir.types" :as types)
(import "stogir.x64.registers" :as registers)
(import "coil.slice" :use [subslice])
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

;;; register: a library register (general 0..15, XMM 32..47); -1 for a stack
;;; argument at `offset`; -2 for the result place of register pieces, which is
;;; not passed. size: bytes written to a stack slot (8, or 4 for a FLOAT).
;;; promote?: an unnamed FLOAT, converted to DOUBLE before it is passed.
;;; memory: byte size of a MEMORY aggregate at `offset`, else 0.
(defstruct Part [(register i32) (offset i64) (size i32) (promote? bool) (memory i64)])

(defstruct Layout [(parts (ArrayList Part)) (stack i64) (vectors i32)])

(defn release! [(layout (mut Layout))] (-> void)
  (free! (mut (.parts layout))))

;;; One eightbyte of the floating class.
(defn sse? [(ty u8)] (-> bool)
  (types/floating? (cast i32 ty)))

(const NOT-AN-EIGHTBYTE "x86-64 backend: only integer, FLOAT and DOUBLE arguments are placed (vector arguments belong to the vector family)")

(const GROUP-SHAPE "x86-64 backend: a System V argument group has one or two eightbytes")

(defn round-up [(value i64) (alignment i64)] (-> i64)
  (* (/ (+ value (- alignment 1)) alignment) alignment))

;;; Place `parameters` (the first `fixed` are named). `descriptors` and
;;; `memory` are sorted by ordinal and disjoint; a memory ordinal is an ADDR.
(defn plan-result [(parameters (slice u8))
                   (fixed i64)
                   (variadic? bool)
                   (descriptors (slice groups/Group))
                   (memory (slice groups/Memory))
                   (result-spec results/Spec)
                   (allocator (dyn Allocator))]
  (-> (Result Layout (slice u8)))
  (let [(mut result) (Layout :parts (ArrayList::new [Part] allocator) :stack 0 :vectors 0)
        (mut general) (: 0 i32)
        (mut floating) (: 0 i32)
        (mut i) (: 0 i64)
        (mut next-group) (: 0 i64)
        (mut next-memory) (: 0 i64)
        (mut error) ""]
    (cond (or (< fixed 0) (> fixed (len parameters)) (> (len parameters) 65533)
              (and (not variadic?) (!= fixed (len parameters))))
            (set! error "invalid x86-64 argument count")
          (not (groups/valid? (subslice parameters 0 fixed) descriptors))
            (set! error "invalid x86-64 argument groups")
          (or (not (results/valid? 0 parameters result-spec))
              (and (!= (.kind result-spec) 0) (< fixed 1)))
            (set! error "invalid x86-64 aggregate result role")
          (and (= (.kind result-spec) 1) (= (.second result-spec) 0)
               (or (> (.count result-spec) 2)
                   (not (results/eightbyte? (.ty result-spec)))))
            (set! error "x86-64 backend: register results are one or two integer or floating pieces")
          :else 0)
    (when (and (= error "") (!= (.kind result-spec) 0))
      (push! (mut (.parts result))
             (Part
               :register (if (= (.kind result-spec) 2) (: registers/RDI i32) -2)
               :offset -1
               :size 8
               :promote? false
               :memory 0))
      (when (= (.kind result-spec) 2) (set! general 1))
      (set! i 1))
    (while (and (= error "") (< i (len parameters)))
      (let [ty (get parameters i)
            unnamed? (and variadic? (>= i fixed))
            grouped? (and (< next-group (len descriptors))
                          (= (cast i64 (.first (get descriptors next-group))) i))
            memory? (and (< next-memory (len memory))
                         (= (cast i64 (.ordinal (get memory next-memory))) i))]
        (cond
          (and grouped? memory?) (set! error "x86-64 MEMORY argument belongs to a group")
          memory?
            (let [record (get memory next-memory)
                  alignment (if (> (.alignment record) 8) (: 16 i64) 8)]
              (if (or (!= ty 6) (<= (.size record) 0))
                  (set! error "x86-64 MEMORY argument requires an ADDR parameter and a size")
                  (do
                    (set! (.stack result) (round-up (.stack result) alignment))
                    (push! (mut (.parts result))
                           (Part :register -1 :offset (.stack result) :size 8
                                 :promote? false :memory (.size record)))
                    (set! (.stack result)
                          (+ (.stack result) (round-up (.size record) 8)))))
              (set! next-memory (+ next-memory 1))
              (set! i (+ i 1)))
          :else
            (let [group (if grouped?
                            (get descriptors next-group)
                            (groups/Group :first (cast i32 i) :count 1 :alignment 8))
                  count (cast i64 (.count group))
                  (mut need-general) (: 0 i32)
                  (mut need-floating) (: 0 i32)]
              (if (or (> count 2) (> (+ i count) (len parameters)))
                  (set! error GROUP-SHAPE)
                  (do
                    (for [j 0 count]
                      (let [member (get parameters (+ i j))]
                        (cond (sse? member) (set! need-floating (+ need-floating 1))
                              (types/integer? (cast i32 member))
                                (set! need-general (+ need-general 1))
                              :else (set! error NOT-AN-EIGHTBYTE))))
                    (when (= error "")
                      (if (and (<= (+ general need-general) registers/GPR-ARGUMENTS)
                               (<= (+ floating need-floating) registers/SIMD-ARGUMENTS))
                          (for [j 0 count]
                            (let [member (get parameters (+ i j))]
                              (push! (mut (.parts result))
                                     (Part
                                       :register (if (sse? member)
                                                     (registers/simd-argument floating)
                                                     (registers/gpr-argument general))
                                       :offset -1
                                       :size 8
                                       :promote? (and unnamed? (not grouped?) (= member 13))
                                       :memory 0))
                              (if (sse? member)
                                  (set! floating (+ floating 1))
                                  (set! general (+ general 1)))))
                          (do
                            (when (and grouped? (= (.alignment group) 16))
                              (set! (.stack result) (round-up (.stack result) 16)))
                            (for [j 0 count]
                              (let [member (get parameters (+ i j))
                                    promote? (and unnamed? (not grouped?) (= member 13))]
                                (push! (mut (.parts result))
                                       (Part
                                         :register -1
                                         :offset (.stack result)
                                         :size (if (and (= member 13) (not promote?)) 4 8)
                                         :promote? promote?
                                         :memory 0))
                                (set! (.stack result) (+ (.stack result) 8)))))))))
              (set! i (+ i count))
              (when grouped? (set! next-group (+ next-group 1)))))))
    (when (and (= error "")
               (or (< next-group (len descriptors)) (< next-memory (len memory))))
      (set! error "x86-64 argument group or MEMORY record names no argument"))
    (set! (.vectors result) floating)
    (if (= error "") (Ok result) (do (release! (mut result)) (Err error)))))

;;; Placement of register result piece `index` of a kind-1 spec: rax then rdx
;;; for integer pieces, xmm0 then xmm1 for floating ones, in order per class.
(defn result-register [(spec results/Spec) (index i32)] (-> i32)
  (let [(mut general) (: 0 i32)
        (mut floating) (: 0 i32)
        (mut register) (: -1 i32)]
    (for [i 0 (cast i64 (.count spec))]
      (let [float? (sse? (results/piece-type spec (cast i32 i)))]
        (when (= (cast i32 i) index)
          (set! register (if float?
                             (+ floating registers/XMM0)
                             (if (= general 0) (: registers/RAX i32) registers/RDX))))
        (if float? (set! floating (+ floating 1)) (set! general (+ general 1)))))
    register))
