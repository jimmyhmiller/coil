;;; The preserved general registers a function uses (rbx r12 r13 r14 r15) are
;;; stored with `mov` into a callee-saved area at the top of the fixed frame
;;; and reloaded before every return (docs/X86_PORT.md, "Frame"). Moves keep
;;; the offset model of the a64 backend, so shrink-wrapping can carry over.
;;;
;;; The a64 module of this name is not shared: the register range and the
;;; paired store encodings are AArch64's.
(module stogir.x64.callee-saved)
(import "stogir.allocation" :as allocation)
(import "stogir.frame" :as frame)
(import "stogir.x64.code" :as code)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.registers" :as registers)
(import "stogir.x64.frame-address" :as address)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

;;; `mask` has one bit per saved register; `offset` is the logical frame
;;; offset of the area, -1 when nothing is saved.
(defstruct Saved [(mask u64) (offset i64)])

(defn none [] (-> Saved)
  (Saved :mask 0 :offset -1))

;;; Reserve one 8-byte slot per preserved register any allocated part holds.
(defn layout! [(parts (ArrayList allocation/Part)) (area (mut frame/Frame))]
  (-> (Result Saved (slice u8)))
  (let [(mut mask) (: 0 u64)
        (mut count) (: 0 i64)]
    (for part parts
      (when (and (> (.parent part) 0)
                 (> (len (.ranges part)) 0)
                 (registers/preserved? (.register part)))
        (set! mask (| mask (<< (: 1 u64) (cast u64 (.register part)))))))
    (for [reg 0 16]
      (when (!= (& mask (<< (: 1 u64) (cast u64 reg))) 0) (set! count (+ count 1))))
    (if (= count 0)
        (Ok (none))
        (match (frame/private-slot! (mut area) (* count 8) 8)
          (Err [message] (Err message))
          (Ok [offset] (Ok (Saved :mask mask :offset offset)))))))

;;; Store (`load` false) or reload (`load` true) every saved register. rsp is
;;; at its fixed-frame value. Only moves: flags and every other register
;;; survive.
(defn emit! [(output (mut (ArrayList u8))) (saved Saved) (load bool) (base address/Base)]
  (-> (Result i32 (slice u8)))
  (let [begin (len output)
        (mut offset) (.offset saved)
        (mut error) ""]
    (for [reg 0 16]
      (when (!= (& (.mask saved) (<< (: 1 u64) (cast u64 reg))) 0)
        (match (address/slot base offset)
          (Err [message] (when (= error "") (set! error message)))
          (Ok [m]
              (code/accept! (mut error)
                            (if load
                                (encode/mov-rm (mut output) 64 (cast i32 reg) m)
                                (encode/mov-mr (mut output) 64 m (cast i32 reg))))))
        (set! offset (+ offset 8))))
    (if (= error "") (Ok (cast i32 (- (len output) begin))) (Err error))))
