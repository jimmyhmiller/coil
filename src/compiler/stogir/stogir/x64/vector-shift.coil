;;; Lane-wise SHL SHR SAR ROL ROR on 8- and 16-byte integer vectors, SSE2.
;;;
;;; Counts are reduced modulo the lane's bit width, lane by lane, exactly as
;;; the AArch64 backend does: only the low log2(bits) bits of a count matter.
;;;
;;; One count for every lane (the count operand is a scalar integer):
;;; `uniform!`. The masked count goes into an XMM register and the vector is
;;; shifted with psll*/psrl*/psra*, whose count is the whole low quadword, so
;;; a count of `bits` (the complementary shift of a rotation by zero) gives
;;; zero as it must. What SSE2 lacks is synthesized:
;;;   1-byte lanes   no byte shifts exist. The even and the odd bytes are
;;;                  shifted as halves of words and masked back to their
;;;                  byte: SHL  ((x & 0x00FF) << c) & 0x00FF | (x & 0xFF00) << c
;;;                        SHR  (x & 0x00FF) >> c | ((x & 0xFF00) >> c) & 0xFF00
;;;                        SAR  the high byte from psraw, the low byte
;;;                             sign-extended into its word first
;;;   8-byte SAR     no psraq: ((x >> c) ^ m) - m with m = (1 << 63) >> c
;;;   ROL, ROR       (x << c) | (x >> (bits - c)) and the mirror image
;;;
;;; One count per lane (the count operand is a vector): `variable!` stores
;;; both vectors in the node's scratch frame object and shifts each lane in
;;; memory by cl (`shl/shr/sar/rol/ror [lane], cl`), since SSE2 has no
;;; per-lane counts. The hardware reduces cl modulo 64 for 8-byte lanes and
;;; modulo 32 otherwise, so 1- and 2-byte SHL SHR SAR mask the count first;
;;; their rotations do not need to (a rotation count is taken modulo the
;;; operand size after the modulo-32 reduction).
;;;
;;; Registers: see stogir.x64.simd-lanes. `uniform!` also writes xmm15 (the
;;; count) and r10; `variable!` writes rcx, which its caller has clobbered.
(module stogir.x64.vector-shift)
(import "stogir.types" :as types)
(import "stogir.vector-arithmetic" :as vector)
(import "stogir.x64.code" :as code)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.registers" :as registers)
(import "stogir.x64.simd-lanes" :as simd)

(defn temporaries [(opcode i32) (ty i32) (scalar-count bool)] (-> i32)
  (if scalar-count 3 0))

;;; d = x shifted by the count in XMM register `count`: `kind` 49 SHL,
;;; 50 SHR, 51 SAR. d and s are written; neither is x or `count`.
(defn shifted! [(out (mut code/Buffer)) (error (mut (slice u8))) (kind i32) (lane i32)
                (d i32) (s i32) (x i32) (count i32)] (-> void)
  (cond (and (= lane 1) (= kind 49))
          (do
            (simd/ones! (mut out) (mut error) d)
            (simd/shift! (mut out) (mut error) encode/PSRLW-I d 8)
            (simd/move! (mut out) (mut error) s x)
            (simd/sse! (mut out) (mut error) encode/PAND s d)
            (simd/sse! (mut out) (mut error) encode/PSLLW s count)
            (simd/sse! (mut out) (mut error) encode/PAND s d)
            (simd/sse! (mut out) (mut error) encode/PANDN d x)
            (simd/sse! (mut out) (mut error) encode/PSLLW d count)
            (simd/sse! (mut out) (mut error) encode/POR d s))
        (and (= lane 1) (= kind 50))
          (do
            (simd/ones! (mut out) (mut error) d)
            (simd/shift! (mut out) (mut error) encode/PSRLW-I d 8)
            (simd/move! (mut out) (mut error) s x)
            (simd/sse! (mut out) (mut error) encode/PAND s d)
            (simd/sse! (mut out) (mut error) encode/PSRLW s count)
            (simd/sse! (mut out) (mut error) encode/PANDN d x)
            (simd/sse! (mut out) (mut error) encode/PSRLW d count)
            (simd/shift! (mut out) (mut error) encode/PSRLW-I d 8)
            (simd/shift! (mut out) (mut error) encode/PSLLW-I d 8)
            (simd/sse! (mut out) (mut error) encode/POR d s))
        (= lane 1)
          (do
            (simd/move! (mut out) (mut error) d x)
            (simd/sse! (mut out) (mut error) encode/PSRAW d count)
            (simd/shift! (mut out) (mut error) encode/PSRLW-I d 8)
            (simd/shift! (mut out) (mut error) encode/PSLLW-I d 8)
            (simd/move! (mut out) (mut error) s x)
            (simd/shift! (mut out) (mut error) encode/PSLLW-I s 8)
            (simd/shift! (mut out) (mut error) encode/PSRAW-I s 8)
            (simd/sse! (mut out) (mut error) encode/PSRAW s count)
            (simd/shift! (mut out) (mut error) encode/PSLLW-I s 8)
            (simd/shift! (mut out) (mut error) encode/PSRLW-I s 8)
            (simd/sse! (mut out) (mut error) encode/POR d s))
        (and (= lane 8) (= kind 51))
          (do
            (simd/ones! (mut out) (mut error) s)
            (simd/shift! (mut out) (mut error) encode/PSLLQ-I s 63)
            (simd/sse! (mut out) (mut error) encode/PSRLQ s count)
            (simd/move! (mut out) (mut error) d x)
            (simd/sse! (mut out) (mut error) encode/PSRLQ d count)
            (simd/sse! (mut out) (mut error) encode/PXOR d s)
            (simd/sse! (mut out) (mut error) encode/PSUBQ d s))
        :else
          (do
            (simd/move! (mut out) (mut error) d x)
            (simd/sse! (mut out) (mut error)
                       (cond (= kind 49) (simd/left-op lane)
                             (= kind 50) (simd/right-op lane)
                             (= lane 2) encode/PSRAW
                             :else encode/PSRAD)
                       d count))))

;;; xmm15 = the count in r10d as a shift count.
(defn count! [(out (mut code/Buffer)) (error (mut (slice u8)))] (-> void)
  (code/accept! (mut error) (encode/movd-xr (mut (.text out)) 32 simd/X15 simd/R10)))

;;; rd = a OPCODE count, the same count for every lane. `count` is the
;;; general register holding the scalar count operand (any integer type; it
;;; may be r10 or r11). a is not xmm15.
(defn uniform! [(out (mut code/Buffer)) (error (mut (slice u8))) (opcode i32) (ty i32)
                (rd i32) (a i32) (count i32)] (-> void)
  (let [lane (simd/element ty)
        bits (* lane 8)
        t1 (: simd/T1 i32)
        t2 (: simd/T2 i32)
        t3 (: simd/T3 i32)]
    (if (or (not (vector/shift? opcode))
            (not (vector/valid-type? opcode ty))
            (not (types/short-vector? ty 8))
            (not (registers/simd? rd))
            (not (registers/simd? a))
            (= a simd/X15)
            (not (registers/gpr? count)))
        (simd/fail! (mut error) "unsupported x86-64 vector shift shape or registers")
        (do
          (code/accept! (mut error) (encode/mov-rr (mut (.text out)) 32 simd/R10 count))
          (code/accept! (mut error)
                        (encode/alu-ri (mut (.text out)) encode/AND 32 simd/R10
                                       (cast i64 (- bits 1))))
          (count! (mut out) (mut error))
          (if (vector/rotate? opcode)
              (do
                (shifted! (mut out) (mut error) (if (= opcode 52) 49 50) lane t1 t2 a simd/X15)
                ; r10d = bits - count, in 1..bits.
                (code/accept! (mut error)
                              (encode/unary-r (mut (.text out)) encode/NEG 32 simd/R10))
                (code/accept! (mut error)
                              (encode/alu-ri (mut (.text out)) encode/ADD 32 simd/R10
                                             (cast i64 bits)))
                (count! (mut out) (mut error))
                (shifted! (mut out) (mut error) (if (= opcode 52) 50 49) lane t3 t2 a simd/X15)
                (simd/sse! (mut out) (mut error) encode/POR t1 t3))
              (shifted! (mut out) (mut error) opcode lane t1 t2 a simd/X15))
          (simd/move! (mut out) (mut error) rd t1)))))

(defn shift-kind [(opcode i32)] (-> i32)
  (case opcode
    49 encode/SHL
    50 encode/SHR
    51 encode/SAR
    52 encode/ROL
    encode/ROR))

;;; rd = a OPCODE b with one count per lane, through the scratch frame
;;; object `slot` (a at slot, the counts at slot + 16). rcx is written.
(defn variable! [(out (mut code/Buffer)) (error (mut (slice u8))) (opcode i32) (ty i32)
                 (slot encode/Mem) (rd i32) (a i32) (b i32)] (-> void)
  (let [lane (simd/element ty)
        bits (* lane 8)]
    (if (or (not (vector/shift? opcode))
            (not (vector/valid-type? opcode ty))
            (not (types/short-vector? ty 8)))
        (simd/fail! (mut error) "unsupported x86-64 vector shift shape")
        (do
          (simd/write! (mut out) (mut error) slot a 16)
          (simd/write! (mut out) (mut error) (simd/after slot 16) b 16)
          (for [index 0 (cast i64 (types/lanes ty))]
            (let [m (simd/after slot (* index (cast i64 lane)))]
              ; The count's low byte is enough for any lane width.
              (code/accept! (mut error)
                            (encode/movzx-rm (mut (.text out)) 32 8 registers/RCX
                                             (simd/after m 16)))
              (when (and (< bits 32) (not (vector/rotate? opcode)))
                (code/accept! (mut error)
                              (encode/alu-ri (mut (.text out)) encode/AND 32 registers/RCX
                                             (cast i64 (- bits 1)))))
              (code/accept! (mut error)
                            (encode/shift-mc (mut (.text out)) (shift-kind opcode) bits m))))
          (simd/read! (mut out) (mut error) rd slot (simd/width ty))))))
