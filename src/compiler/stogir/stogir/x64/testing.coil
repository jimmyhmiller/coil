;;; Test support for the x86-64 backend (used by tests/x64-core-*.coil and
;;; meant for the tests of every operation family; nothing else imports it).
;;;
;;;   * graph shorthands over stogir.builder that stop the test on a malformed
;;;     graph (a builder error is a bug in the test, not a result);
;;;   * an independent reference evaluator for the integer operations, written
;;;     with wide arithmetic and sharing nothing with the backend or with
;;;     stogir.fold;
;;;   * a failure tally with compile-and-map and check helpers;
;;;   * mapping and calling generated code on an x86-64 host. Every function
;;;     is called through one twelve-argument System V signature: the first
;;;     six arguments arrive in registers, the rest on the stack, and a
;;;     function that declares fewer simply ignores the others.
;;;   * for the floating family: an independent reference evaluator for the
;;;     floating operations (bit patterns in, bit patterns out, with the
;;;     x86-64 NaN rules), and calls with floating arguments and results
;;;     ("Floating support" below).
(module stogir.x64.testing)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.types" :as types)
(import "stogir.target" :as target)
(import "stogir.jit.native" :as jit)
(import "stogir.numeric-conversion" :as numeric)
(import "coil.math" :as math)
(import "stogir.x64.compile" :as compile)
(import "stogir.x64.code" :as buffer)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err Option Some None])

;;; Whether generated x86-64 code can run in this process.
(defn host? [] (-> bool)
  (target/arch-pick false true))

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result
    (Ok [value] value)
    (Err [message] (panic "x64 test graph construction failed: {}" message))))

(defn start! [(graph (mut g/Graph))] (-> i32)
  (require (b/emit! (mut graph) 104 0 [(: 0 i32)])))

;;; PARAM `ordinal` of `ty`.
(defn param! [(graph (mut g/Graph)) (start i32) (ty i32) (ordinal i32)] (-> i32)
  (require (b/emit! (mut graph) 71 ty [start (: 0 i32) ordinal])))

;;; The constant of `ty` whose bits are the low bits of `value`.
(defn constant! [(graph (mut g/Graph)) (ty i32) (value u64)] (-> i32)
  (require (b/scalar-constant! (mut graph) ty (& value (mask ty)) 8)))

;;; A binary operation. DIV and MOD get their optional control guard as 0.
(defn binary! [(graph (mut g/Graph)) (opcode i32) (ty i32) (left i32) (right i32)] (-> i32)
  (if (or (= opcode 29) (= opcode 30))
      (require (b/emit! (mut graph) opcode ty [left right (: 0 i32)]))
      (require (b/emit! (mut graph) opcode ty [left right]))))

(defn unary! [(graph (mut g/Graph)) (opcode i32) (ty i32) (value i32)] (-> i32)
  (require (b/emit! (mut graph) opcode ty [value])))

;;; An integer comparison; its type is BOOL.
(defn compare! [(graph (mut g/Graph)) (opcode i32) (left i32) (right i32)] (-> i32)
  (require (b/emit! (mut graph) opcode 1 [left right])))

(defn select! [(graph (mut g/Graph)) (ty i32) (condition i32) (yes i32) (no i32)] (-> i32)
  (require (b/emit! (mut graph) 60 ty [condition yes no])))

;;; RETURN of `value` (`ty` 0 and `value` 0 for a void return).
(defn return! [(graph (mut g/Graph)) (control i32) (ty i32) (value i32)] (-> i32)
  (require (b/emit! (mut graph) 120 ty [control value (: 0 i32)])))

;;; COPY of `value`.
(defn copy! [(graph (mut g/Graph)) (ty i32) (value i32)] (-> i32)
  (require (b/emit! (mut graph) 68 ty [value (: 0 i32)])))

;;; UNREACHABLE ending block `control`; it is an exit root of the function.
(defn unreachable! [(graph (mut g/Graph)) (control i32)] (-> i32)
  (require (b/unreachable! (mut graph) control 0)))

;;; TRAP in block `control`.
(defn trap! [(graph (mut g/Graph)) (control i32)] (-> i32)
  (require (b/trap! (mut graph) control)))

(defn end! [(graph (mut g/Graph)) (control i32)] (-> i32)
  (require (b/emit! (mut graph) 114 0 [control])))

(defn loop-end! [(graph (mut g/Graph)) (control i32)] (-> i32)
  (require (b/emit! (mut graph) 115 0 [control])))

;;; LOOP_BEGIN entered from block end `entry`; patch operand 2 with the
;;; LOOP_END once the body exists.
(defn loop-begin! [(graph (mut g/Graph)) (entry i32)] (-> i32)
  (require (b/loop-begin! (mut graph) entry)))

;;; A PHI of loop header `header` that starts as `initial`; patch operand 3
;;; with the value carried round the loop.
(defn loop-phi! [(graph (mut g/Graph)) (header i32) (initial i32)] (-> i32)
  (require (b/loop-phi! (mut graph) header initial)))

(defn if! [(graph (mut g/Graph)) (control i32) (condition i32)] (-> i32)
  (require (b/emit! (mut graph) 116 0 [control condition])))

(defn if-true! [(graph (mut g/Graph)) (branch i32)] (-> i32)
  (require (b/emit! (mut graph) 107 0 [branch (: 0 i32)])))

(defn if-false! [(graph (mut g/Graph)) (branch i32)] (-> i32)
  (require (b/emit! (mut graph) 108 0 [branch (: 0 i32)])))

;;; MERGE of two block ends.
(defn merge! [(graph (mut g/Graph)) (first i32) (second i32)] (-> i32)
  (require (b/emit! (mut graph) 112 0 [first second])))

;;; PHI of `ty` at a two-predecessor region.
(defn phi! [(graph (mut g/Graph)) (ty i32) (region i32) (first i32) (second i32)] (-> i32)
  (require (b/emit! (mut graph) 67 ty [region first second])))

(defn patch! [(graph (mut g/Graph)) (reference i32) (index i32) (value i32)] (-> void)
  (require (b/patch! (mut graph) reference index value))
  0)

(defn bits [(ty i32)] (-> i32)
  (* 8 (types/scalar-size ty 8)))

(defn mask [(ty i32)] (-> u64)
  (if (>= (bits ty) 64)
      (: 0xFFFFFFFFFFFFFFFF u64)
      (- (<< (: 1 u64) (cast u64 (bits ty))) 1)))

;;; The low `bits ty` bits of `value` read as a signed number.
(defn signed [(ty i32) (value u64)] (-> i128)
  (let [modulus (<< (: 1 u128) (cast u128 (bits ty)))
        x (cast u128 (& value (mask ty)))]
    (if (>= x (/ modulus 2))
        (- (cast i128 x) (cast i128 modulus))
        (cast i128 x))))

;;; Whether DIV/MOD of these operands is defined: no zero divisor and no
;;; overflowing signed quotient.
(defn divisible? [(ty i32) (a u64) (b u64)] (-> bool)
  (let [y (& b (mask ty))
        x (& a (mask ty))]
    (and (!= y 0)
         (not (and (types/signed? ty)
                   (= x (<< (: 1 u64) (cast u64 (- (bits ty) 1))))
                   (= y (mask ty)))))))

;;; Reference result of integer binary operation `opcode` on type `ty`,
;;; masked to the type. Comparisons (14..23) yield 0 or 1. Shift and rotate
;;; counts are reduced modulo the width. DIV/MOD require `divisible?`. MIN
;;; (58) and MAX (59) compare by the type's signedness.
(defn binary [(opcode i32) (ty i32) (a u64) (b u64)] (-> u64)
  (let [width (bits ty)
        modulus (<< (: 1 u128) (cast u128 width))
        m (mask ty)
        x (& a m)
        y (& b m)
        sx (signed ty a)
        sy (signed ty b)
        shift (cast u128 (% y (cast u64 width)))
        wide (cast u128 x)]
    (cond (= opcode 14) (if (= x y) 1 0)
          (= opcode 15) (if (!= x y) 1 0)
          (= opcode 16) (if (< sx sy) 1 0)
          (= opcode 17) (if (>= sx sy) 1 0)
          (= opcode 18) (if (<= sx sy) 1 0)
          (= opcode 19) (if (> sx sy) 1 0)
          (= opcode 20) (if (< x y) 1 0)
          (= opcode 21) (if (>= x y) 1 0)
          (= opcode 22) (if (<= x y) 1 0)
          (= opcode 23) (if (> x y) 1 0)
          (= opcode 26) (& (cast u64 (% (+ wide (cast u128 y)) modulus)) m)
          (= opcode 27) (& (cast u64 (% (- (+ wide modulus) (cast u128 y)) modulus)) m)
          (= opcode 28) (& (cast u64 (% (* wide (cast u128 y)) modulus)) m)
          (= opcode 29)
            (if (types/signed? ty)
                (& (cast u64 (% (+ (/ sx sy) (cast i128 modulus)) (cast i128 modulus))) m)
                (/ x y))
          (= opcode 30)
            (if (types/signed? ty)
                (& (cast u64 (% (+ (- sx (* (/ sx sy) sy)) (cast i128 modulus))
                                (cast i128 modulus)))
                   m)
                (- x (* (/ x y) y)))
          (= opcode 46) (| x y)
          (= opcode 47) (& x y)
          (= opcode 48) (^ x y)
          (= opcode 49) (& (cast u64 (% (<< wide shift) modulus)) m)
          (= opcode 50) (cast u64 (>> wide shift))
          (= opcode 51)
            ; Arithmetic shift: floor division of the signed value by 2^shift.
            (let [power (<< (: 1 i128) (cast i128 shift))
                  quotient (if (>= sx 0) (/ sx power) (- 0 (/ (+ (- 0 sx) (- power 1)) power)))]
              (& (cast u64 (% (+ quotient (cast i128 modulus)) (cast i128 modulus))) m))
          (= opcode 52)
            (& (cast u64 (% (| (<< wide shift)
                               (>> wide (- (cast u128 width) shift)))
                            modulus))
               m)
          (= opcode 53)
            (& (cast u64 (% (| (>> wide shift)
                               (<< wide (- (cast u128 width) shift)))
                            modulus))
               m)
          (= opcode 58) (if (types/signed? ty) (if (< sx sy) x y) (if (< x y) x y))
          (= opcode 59) (if (types/signed? ty) (if (> sx sy) x y) (if (> x y) x y))
          ; The value of ADD_OV, SUB_OV and MUL_OV is the wrapped result.
          (and (>= opcode 41) (<= opcode 43)) (binary (- opcode 15) ty a b)
          :else (panic "x64 test reference: unknown binary opcode {}" opcode))))

;;; Reference OVERFLOW of ADD_OV (41), SUB_OV (42) or MUL_OV (43) on `ty`:
;;; 1 when the exact result does not fit the type, else 0.
(defn overflow [(opcode i32) (ty i32) (a u64) (b u64)] (-> u64)
  (let [width (bits ty)
        x (cast u128 (& a (mask ty)))
        y (cast u128 (& b (mask ty)))
        sx (signed ty a)
        sy (signed ty b)
        modulus (<< (: 1 u128) (cast u128 width))
        limit (cast i128 (/ modulus 2))]
    (if (types/signed? ty)
        (let [exact (cond (= opcode 41) (+ sx sy)
                          (= opcode 42) (- sx sy)
                          (= opcode 43) (* sx sy)
                          :else (panic "x64 test reference: unknown checked opcode {}" opcode))]
          (if (or (< exact (- 0 limit)) (>= exact limit)) 1 0))
        (cond (= opcode 41) (if (>= (+ x y) modulus) 1 0)
              (= opcode 42) (if (< x y) 1 0)
              (= opcode 43) (if (>= (* x y) modulus) 1 0)
              :else (panic "x64 test reference: unknown checked opcode {}" opcode)))))

;;; Reference result of NEG (31), NOT (45), ABS (32), BSWAP (54), CTPOP (55),
;;; CTLZ (56) and CTTZ (57). NOT of a BOOL flips bit 0.
(defn unary [(opcode i32) (ty i32) (a u64)] (-> u64)
  (let [m (mask ty)
        x (& a m)]
    (cond (= opcode 31) (& (+ (^ x m) 1) m)
          (and (= opcode 45) (= ty 1)) (^ x 1)
          (= opcode 45) (^ x m)
          ; ABS of the minimum is the minimum.
          (= opcode 32) (if (< (signed ty a) 0) (& (+ (^ x m) 1) m) x)
          (= opcode 54)
            (let [(mut rest) x
                  (mut result) (: 0 u64)]
              (for [i 0 (/ (cast i64 (bits ty)) 8)]
                (set! result (| (<< result 8) (& rest 255)))
                (set! rest (>> rest 8)))
              result)
          (= opcode 55)
            (let [(mut count) (: 0 u64)]
              (for [i 0 (cast i64 (bits ty))]
                (set! count (+ count (& (>> x (cast u64 i)) 1))))
              count)
          ; The IR leaves the count of a zero undefined. The backends agree
          ; on the type's width for CTLZ, and for CTTZ on the width the
          ; operation runs at: 32 for every type narrower than 32 bits.
          (= opcode 56)
            (let [(mut count) (: 0 u64)
                  (mut i) (- (cast i64 (bits ty)) 1)]
              (while (and (>= i 0) (= (& (>> x (cast u64 i)) 1) 0))
                (set! count (+ count 1))
                (set! i (- i 1)))
              count)
          (= opcode 57)
            (if (= x 0)
                (if (< (bits ty) 32) 32 (cast u64 (bits ty)))
                (let [(mut count) (: 0 u64)]
                  (while (= (& (>> x count) 1) 0) (set! count (+ count 1)))
                  count))
          :else (panic "x64 test reference: unknown unary opcode {}" opcode))))

;;; Reference result of SEXT (33), ZEXT (34), TRUNC (35) and BITCAST (36)
;;; between integer types. A BOOL result is 0 or 1 (nonzero low byte).
(defn convert [(opcode i32) (source i32) (target i32) (a u64)] (-> u64)
  (let [x (& a (mask source))
        value (if (= opcode 33) (cast u64 (cast i64 (signed source a))) x)
        result (& value (mask target))]
    (if (= target 1) (if (= result 0) 0 1) result)))

;;; What a caller sees in the low 32 or 64 bits of rax for a returned value
;;; of `ty` whose bits are `value`: narrow types are extended to 32 bits by
;;; signedness. Compare with `returned-mask`.
(defn returned [(ty i32) (value u64)] (-> u64)
  (let [width (bits ty)]
    (cond (>= width 64) value
          (= width 32) (& value 0xFFFFFFFF)
          (types/signed? ty) (& (cast u64 (cast i64 (signed ty value))) 0xFFFFFFFF)
          :else (& value (mask ty)))))

;;; The bits of rax that a returned value of `ty` defines.
(defn returned-mask [(ty i32)] (-> u64)
  (if (>= (bits ty) 64) (: 0xFFFFFFFFFFFFFFFF u64) 0xFFFFFFFF))

;;; A deterministic 64-bit generator (splitmix64) for stress tests.
(defn random! [(state (mut u64))] (-> u64)
  (set! state (primitive/iadd state (: 0x9E3779B97F4A7C15 u64)))
  (let [a (primitive/imul (^ state (>> state 30)) (: 0xBF58476D1CE4E5B9 u64))
        c (primitive/imul (^ a (>> a 27)) (: 0x94D049BB133111EB u64))]
    (^ c (>> c 31))))

;;; Mapped generated code.
(defstruct Mapped [(image jit/Image)])

(defn map [(text (slice u8))] (-> (Result Mapped (slice u8)))
  (match (jit/map-text text)
    (Err [message] (Err message))
    (Ok [image] (Ok (Mapped :image image)))))

(defn unmap! [(mapped (mut Mapped))] (-> void)
  (jit/release! (mut (.image mapped)))
  0)

;;; Call mapped code with up to twelve integer arguments (missing ones are
;;; zero) and return rax.
(defn invoke [(mapped Mapped) (arguments (slice u64))] (-> u64)
  (let [f (primitive/cast (fnptr (cc/C) [u64 u64 u64 u64 u64 u64 u64 u64 u64 u64 u64 u64] u64)
                          (.base (.image mapped)))
        (mut a) (primitive/zeroed (array u64 12))]
    (when (> (len arguments) 12) (panic "x64 test call with more than twelve arguments"))
    (for [i 0 (len arguments)] (set! (mut a) i (get arguments i)))
    (call-ptr f (get a 0) (get a 1) (get a 2) (get a 3) (get a 4) (get a 5)
              (get a 6) (get a 7) (get a 8) (get a 9) (get a 10) (get a 11))))

;;; Counts of one test program.
(defstruct Tally [(checks i64) (failures i64) (functions i64)])

(defn tally [] (-> Tally)
  (Tally :checks 0 :failures 0 :functions 0))

(defn fail! [(counts (mut Tally))] (-> void)
  (set! (.failures counts) (+ (.failures counts) 1)))

;;; Compile `graph` as given (stogir.x64.compile/text) and map it. A compile
;;; or mapping failure is printed with `label` and counted.
(defn compiled [(counts (mut Tally)) (label (slice u8)) (graph g/Graph) (start i32)
                (roots (slice i32)) (allocator (dyn Allocator))] (-> (Option Mapped))
  (set! (.functions counts) (+ (.functions counts) 1))
  (match (compile/text graph start roots allocator)
    (Err [message]
         (println "{}: compile failed: {}" label message)
         (fail! (mut counts))
         (None))
    (Ok [text]
        (let [(mut bytes) text
              result (match (map (slice bytes))
                       (Err [message]
                            (println "{}: map failed: {}" label message)
                            (fail! (mut counts))
                            (None [Mapped]))
                       (Ok [mapped] (Some mapped)))]
          (free! (mut bytes))
          result))))

;;; Call `mapped` and compare the bits a result of `ty` defines in rax with
;;; `expected` (a value of `ty`; narrow types are checked in their 32-bit
;;; extended form).
(defn expect! [(counts (mut Tally)) (label (slice u8)) (mapped Mapped) (ty i32)
               (arguments (slice u64)) (expected u64)] (-> void)
  (let [wanted (returned ty expected)
        actual (& (invoke mapped arguments) (returned-mask ty))]
    (set! (.checks counts) (+ (.checks counts) 1))
    (when (!= actual wanted)
      (when (< (.failures counts) 25)
        (println "{}: got {:x} expected {:x} (type {}, first arguments {:x} {:x})"
                 label actual wanted ty
                 (if (> (len arguments) 0) (get arguments 0) 0)
                 (if (> (len arguments) 1) (get arguments 1) 0)))
      (fail! (mut counts)))))

;;; Garbage above the low `bits ty` bits of `value`: what a caller may leave
;;; in the unused part of a narrow argument.
(defn dirty [(ty i32) (value u64)] (-> u64)
  (| (& value (mask ty))
     (& (: 0xA5C3F00DDEADBE00 u64) (^ (mask ty) 0xFFFFFFFFFFFFFFFF))))

;;; Mapped code with what the driver reported about it: the emission summary
;;; (jumps by form, padding, tables, reused flags) and the text size.
(defstruct Generated [(mapped Mapped) (summary buffer/Summary) (size i64)])

;;; As `compiled`, through stogir.x64.compile/generate, keeping the summary.
(defn generated [(counts (mut Tally)) (label (slice u8)) (graph g/Graph) (start i32)
                 (roots (slice i32)) (allocator (dyn Allocator))] (-> (Option Generated))
  (set! (.functions counts) (+ (.functions counts) 1))
  (match (compile/generate graph start roots allocator)
    (Err [message]
         (println "{}: compile failed: {}" label message)
         (fail! (mut counts))
         (None))
    (Ok [emitted]
        (let [(mut emitted) emitted
              result (if (> (len (.references emitted)) 0)
                         (do (println "{}: unexpected references" label)
                             (fail! (mut counts))
                             (None [Generated]))
                         (match (map (slice (.text emitted)))
                           (Err [message]
                                (println "{}: map failed: {}" label message)
                                (fail! (mut counts))
                                (None [Generated]))
                           (Ok [mapped]
                               (Some (Generated :mapped mapped :summary (.summary emitted)
                                                :size (len (.text emitted)))))))]
          (buffer/release! (mut emitted))
          result))))

;;; Count one check of a property of generated code; print `label` and the
;;; two numbers when it does not hold.
(defn check! [(counts (mut Tally)) (holds bool) (label (slice u8)) (got i64) (wanted i64)]
  (-> void)
  (set! (.checks counts) (+ (.checks counts) 1))
  (unless holds
    (when (< (.failures counts) 25) (println "{}: got {}, expected {}" label got wanted))
    (fail! (mut counts))))

;;; BEGIN of the block entered from one block end.
(defn begin! [(graph (mut g/Graph)) (end i32)] (-> i32)
  (require (b/emit! (mut graph) 106 0 [end (: 0 i32)])))

;;; MERGE of any number of block ends, and a PHI over it (one value per end,
;;; in the same order).
(defn merge-all! [(graph (mut g/Graph)) (ends (slice i32))] (-> i32)
  (require (b/emit! (mut graph) 112 0 ends)))

(defn phi-all! [(graph (mut g/Graph)) (ty i32) (region i32) (values (slice i32))
                (allocator (dyn Allocator))] (-> i32)
  (let [(mut inputs) (ArrayList::new [i32] allocator)]
    (push! (mut inputs) region)
    (for value values (push! (mut inputs) value))
    (let [phi (require (b/emit! (mut graph) 67 ty (slice inputs)))]
      (free! (mut inputs))
      phi)))

(defn switch! [(graph (mut g/Graph)) (control i32) (selector i32)] (-> i32)
  (require (b/switch! (mut graph) control selector)))

(defn case-value! [(graph (mut g/Graph)) (source i32) (value i32)] (-> i32)
  (require (b/case-value! (mut graph) source value)))

(defn case-range! [(graph (mut g/Graph)) (source i32) (low i32) (high i32)] (-> i32)
  (require (b/case-range! (mut graph) source low high)))

(defn case-default! [(graph (mut g/Graph)) (source i32)] (-> i32)
  (require (b/case-default! (mut graph) source)))

;;; ---- Floating support -------------------------------------------------------
;;;
;;; Values are bit patterns (u64; a FLOAT in the low 32 bits). The reference
;;; functions below define what the x86-64 backend must produce, bit for bit:
;;;
;;;   * ADD SUB MUL DIV SQRT: IEEE round-to-nearest results (computed by the
;;;     host on non-NaN operands). A NaN operand is returned quieted, the
;;;     left one first; an invalid operation gives the x86 default NaN (sign
;;;     set, quiet bit only).
;;;   * NEG ABS: the sign bit flipped or cleared.
;;;   * MIN MAX (selecting): left <= right ? left : right, left >= right ? ...
;;;   * FMIN FMAX FMINNM FMAXNM: IEEE 754-2019 / minNum with the AArch64 NaN
;;;     selection (a signalling NaN first, the left operand first).
;;;   * ROUND_*: computed with integer arithmetic on the truncated value.
;;;   * comparisons: by classifying the bit patterns.
;;; `float-ambiguous?` names the one case the IR leaves to the machine in a
;;; way an optimizer may legitimately change: arithmetic on two different
;;; NaNs (constant folding may pick the other payload).

(defn float-sign [(ty i32)] (-> u64)
  (if (= ty 12) (: 0x8000000000000000 u64) 0x80000000))

(defn float-quiet-bit [(ty i32)] (-> u64)
  (if (= ty 12) (: 0x0008000000000000 u64) 0x00400000))

(defn float-infinity [(ty i32)] (-> u64)
  (if (= ty 12) (: 0x7FF0000000000000 u64) 0x7F800000))

(defn float-nan? [(ty i32) (value u64)] (-> bool)
  (> (& value (- (float-sign ty) 1)) (float-infinity ty)))

(defn float-signalling? [(ty i32) (value u64)] (-> bool)
  (and (float-nan? ty value) (= (& value (float-quiet-bit ty)) 0)))

(defn float-quiet [(ty i32) (value u64)] (-> u64)
  (| value (float-quiet-bit ty)))

;;; The NaN x86-64 produces for an invalid operation.
(defn float-default-nan [(ty i32)] (-> u64)
  (| (float-sign ty) (float-infinity ty) (float-quiet-bit ty)))

(defn f64-of [(value u64)] (-> f64)
  (let [(mut x) (: 0.0 f64)]
    (store! (primitive/cast (ptr u64) (mut x)) value)
    x))

(defn f64-bits [(value f64)] (-> u64)
  (let [(mut x) value]
    (load (primitive/cast (ptr u64) (mut x)))))

(defn f32-of [(value u64)] (-> f32)
  (let [(mut x) (: 0.0 f32)]
    (store! (primitive/cast (ptr u32) (mut x)) (cast u32 (& value 0xFFFFFFFF)))
    x))

(defn f32-bits [(value f32)] (-> u64)
  (let [(mut x) value]
    (cast u64 (load (primitive/cast (ptr u32) (mut x))))))

;;; A key that orders non-NaN values as numbers, with -0 directly below +0.
(defn float-key [(ty i32) (value u64)] (-> i128)
  (let [magnitude (cast i128 (& value (- (float-sign ty) 1)))]
    (if (!= (& value (float-sign ty)) 0) (- (- 0 magnitude) 1) magnitude)))

(defn float-zero? [(ty i32) (value u64)] (-> bool)
  (= (& value (- (float-sign ty) 1)) 0))

;;; -1, 0, 1 for less, equal, greater (the zeros are equal); 2 when unordered.
(defn float-order [(ty i32) (a u64) (b u64)] (-> i32)
  (cond (or (float-nan? ty a) (float-nan? ty b)) 2
        (and (float-zero? ty a) (float-zero? ty b)) 0
        (< (float-key ty a) (float-key ty b)) -1
        (> (float-key ty a) (float-key ty b)) 1
        :else 0))

;;; Reference result (0 or 1) of comparison `opcode` (14..25) on floats.
(defn float-compare [(opcode i32) (ty i32) (a u64) (b u64)] (-> u64)
  (let [order (float-order ty a b)
        unordered (= order 2)
        truth (cond (= opcode 14) (= order 0)
                    (= opcode 15) (!= order 0)
                    (= opcode 16) (= order -1)
                    (= opcode 17) (or (= order 1) (= order 0))
                    (= opcode 18) (or (= order -1) (= order 0))
                    (= opcode 19) (= order 1)
                    (= opcode 20) (or unordered (= order -1))
                    (= opcode 21) (or unordered (= order 1) (= order 0))
                    (= opcode 22) (or unordered (= order -1) (= order 0))
                    (= opcode 23) (or unordered (= order 1))
                    (= opcode 24) (not unordered)
                    (= opcode 25) unordered
                    :else (panic "x64 test reference: unknown floating comparison {}" opcode))]
    (if truth 1 0)))

;;; A floating value used as a condition: true unless it is a zero.
(defn float-truth [(ty i32) (value u64)] (-> bool)
  (not (float-zero? ty value)))

;;; Whether arithmetic on these operands may give either NaN.
(defn float-ambiguous? [(ty i32) (a u64) (b u64)] (-> bool)
  (and (float-nan? ty a) (float-nan? ty b) (!= a b)))

;;; AArch64's NaN choice for two operands of which at least one is a NaN.
(defn float-processed-nan [(ty i32) (a u64) (b u64)] (-> u64)
  (cond (float-signalling? ty a) (float-quiet ty a)
        (float-signalling? ty b) (float-quiet ty b)
        (float-nan? ty a) a
        :else b))

;;; Reference result of a floating binary operation: ADD SUB MUL DIV (26..29),
;;; MIN MAX (58, 59), FMIN FMAX FMINNM FMAXNM (133..136).
(defn float-binary [(opcode i32) (ty i32) (a u64) (b u64)] (-> u64)
  (let [order (float-order ty a b)]
    (cond (and (>= opcode 26) (<= opcode 29))
            (cond (float-nan? ty a) (float-quiet ty a)
                  (float-nan? ty b) (float-quiet ty b)
                  :else
                    (let [result
                            (if (= ty 12)
                                (let [x (f64-of a)
                                      y (f64-of b)]
                                  (f64-bits (cond (= opcode 26) (+ x y)
                                                  (= opcode 27) (- x y)
                                                  (= opcode 28) (* x y)
                                                  :else (/ x y))))
                                (let [x (f32-of a)
                                      y (f32-of b)]
                                  (f32-bits (cond (= opcode 26) (+ x y)
                                                  (= opcode 27) (- x y)
                                                  (= opcode 28) (* x y)
                                                  :else (/ x y)))))]
                      (if (float-nan? ty result) (float-default-nan ty) result)))
          (= opcode 58) (if (or (= order -1) (= order 0)) a b)
          (= opcode 59) (if (or (= order 1) (= order 0)) a b)
          (and (>= opcode 133) (<= opcode 136))
            (let [minimum (or (= opcode 133) (= opcode 135))
                  number (>= opcode 135)]
              (cond (and number (float-nan? ty a) (not (float-signalling? ty a))
                         (not (float-nan? ty b)))
                      b
                    (and number (float-nan? ty b) (not (float-signalling? ty b))
                         (not (float-nan? ty a)))
                      a
                    (= order 2) (float-processed-nan ty a b)
                    (= order 0) (if minimum (| a b) (& a b))
                    (= (= order -1) minimum) a
                    :else b))
          :else (panic "x64 test reference: unknown floating binary opcode {}" opcode))))

;;; The value of `value` (magnitude below 2^52, not a NaN) rounded to an
;;; integral value by ROUND_EVEN UP DOWN ZERO AWAY (137..141), as a double.
(defn rounded [(opcode i32) (value f64)] (-> f64)
  (let [whole (cast i64 value)
        fraction (- value (cast f64 whole))
        magnitude (if (< fraction 0.0) (- 0.0 fraction) fraction)
        away (if (< value 0.0) (- whole 1) (+ whole 1))
        odd (!= (& whole 1) 0)
        chosen (cond (= fraction 0.0) whole
                     (= opcode 137)
                       (if (or (> magnitude 0.5) (and (= magnitude 0.5) odd)) away whole)
                     (= opcode 138) (if (> fraction 0.0) (+ whole 1) whole)
                     (= opcode 139) (if (< fraction 0.0) (- whole 1) whole)
                     (= opcode 140) whole
                     :else (if (>= magnitude 0.5) away whole))]
    (cast f64 chosen)))

;;; Reference result of a floating unary operation: NEG (31), ABS (32),
;;; SQRT (131), ROUND_* (137..141).
(defn float-unary [(opcode i32) (ty i32) (a u64)] (-> u64)
  (let [sign (float-sign ty)
        negative (!= (& a sign) 0)
        magnitude (& a (- sign 1))]
    (cond (= opcode 31) (^ a sign)
          (= opcode 32) magnitude
          (float-nan? ty a) (float-quiet ty a)
          (= opcode 131)
            (cond (float-zero? ty a) a
                  negative (float-default-nan ty)
                  (= ty 12) (f64-bits (math/sqrt (f64-of a)))
                  :else (f32-bits (math/sqrt (f32-of a))))
          (and (>= opcode 137) (<= opcode 141))
            (let [limit (if (= ty 12) (: 0x4330000000000000 u64) 0x4B000000)]
              (if (>= magnitude limit)
                  a
                  (let [result (rounded opcode (if (= ty 12)
                                                   (f64-of a)
                                                   (cast f64 (f32-of a))))
                        raw (if (= ty 12) (f64-bits result) (f32-bits (cast f32 result)))]
                    ; The operand's sign survives, for -0.0 and for values
                    ; that round to zero.
                    (| (& raw (- sign 1)) (& a sign)))))
          :else (panic "x64 test reference: unknown floating unary opcode {}" opcode))))

;;; Reference result of INT2FP from integer type `source` (the value in the
;;; low bits of `a`) to floating type `target`.
(defn float-from-integer [(source i32) (target i32) (a u64)] (-> u64)
  (let [x (& a (mask source))]
    (if (types/signed? source)
        (let [value (cast i64 (signed source a))]
          (if (= target 12) (f64-bits (cast f64 value)) (f32-bits (cast f32 value))))
        (if (= target 12) (f64-bits (cast f64 x)) (f32-bits (cast f32 x))))))

;;; Reference result of FP2INT from floating type `source` to integer type
;;; `target`: what constant folding gives (stogir.numeric-conversion, exact
;;; integer decoding). None when the IR leaves the conversion undefined (a
;;; NaN, or a truncated value the target type cannot hold).
(defn float-to-integer [(source i32) (target i32) (a u64)] (-> (Option u64))
  (numeric/evaluate 38 source target 8 a))

;;; Reference result of FP2FP between the two floating types.
(defn float-to-float [(source i32) (target i32) (a u64)] (-> u64)
  (cond (= source target) (& a (mask source))
        (= source 13) (f64-bits (cast f64 (f32-of a)))
        :else (f32-bits (cast f32 (f64-of a)))))

;;; Call mapped code whose parameters are, in order, up to twelve floating
;;; values (xmm0..xmm7, then four stack slots) followed by up to twelve
;;; integers (six registers, then six stack slots). A FLOAT argument is
;;; passed as the low 32 bits of its slot. Returns rax.
(defn invoke-mixed [(mapped Mapped) (floats (slice u64)) (integers (slice u64))] (-> u64)
  (let [f (primitive/cast (fnptr (cc/C) [f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64
                                         u64 u64 u64 u64 u64 u64 u64 u64 u64 u64 u64 u64]
                                 u64)
                          (.base (.image mapped)))
        (mut x) (primitive/zeroed (array f64 12))
        (mut a) (primitive/zeroed (array u64 12))]
    (when (or (> (len floats) 12) (> (len integers) 12))
      (panic "x64 test call with more than twelve arguments of one class"))
    (for [i 0 (len floats)] (set! (mut x) i (f64-of (get floats i))))
    (for [i 0 (len integers)] (set! (mut a) i (get integers i)))
    (call-ptr f (get x 0) (get x 1) (get x 2) (get x 3) (get x 4) (get x 5)
              (get x 6) (get x 7) (get x 8) (get x 9) (get x 10) (get x 11)
              (get a 0) (get a 1) (get a 2) (get a 3) (get a 4) (get a 5)
              (get a 6) (get a 7) (get a 8) (get a 9) (get a 10) (get a 11))))

;;; As invoke-mixed for a function that returns a floating value: the bits
;;; of xmm0 (mask to 32 bits for a FLOAT).
(defn invoke-floating [(mapped Mapped) (floats (slice u64)) (integers (slice u64))] (-> u64)
  (let [f (primitive/cast (fnptr (cc/C) [f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64
                                         u64 u64 u64 u64 u64 u64 u64 u64 u64 u64 u64 u64]
                                 f64)
                          (.base (.image mapped)))
        (mut x) (primitive/zeroed (array f64 12))
        (mut a) (primitive/zeroed (array u64 12))]
    (when (or (> (len floats) 12) (> (len integers) 12))
      (panic "x64 test call with more than twelve arguments of one class"))
    (for [i 0 (len floats)] (set! (mut x) i (f64-of (get floats i))))
    (for [i 0 (len integers)] (set! (mut a) i (get integers i)))
    (f64-bits (call-ptr f (get x 0) (get x 1) (get x 2) (get x 3) (get x 4) (get x 5)
                        (get x 6) (get x 7) (get x 8) (get x 9) (get x 10) (get x 11)
                        (get a 0) (get a 1) (get a 2) (get a 3) (get a 4) (get a 5)
                        (get a 6) (get a 7) (get a 8) (get a 9) (get a 10) (get a 11)))))

;;; The bits of floating `value` as an integer the function can return in
;;; rax: BITCAST to U64, or to U32 and then ZEXT for a FLOAT.
(defn float-bits! [(graph (mut g/Graph)) (ty i32) (value i32)] (-> i32)
  (if (= ty 12)
      (unary! (mut graph) 36 5 value)
      (unary! (mut graph) 34 5 (unary! (mut graph) 36 4 value))))

;;; The floating value of `ty` whose bits are integer `value` (a U64): the
;;; inverse of float-bits!.
(defn float-value! [(graph (mut g/Graph)) (ty i32) (value i32)] (-> i32)
  (if (= ty 12)
      (unary! (mut graph) 36 12 value)
      (unary! (mut graph) 36 13 (unary! (mut graph) 35 4 value))))

;;; Bit patterns every floating test should cover, for type `ty`: zeros, the
;;; smallest and largest subnormals and normals, ones, values around one
;;; half, integers at the edge of exact representation, infinities, and
;;; quiet and signalling NaNs of both signs with payloads.
(defn float-specials [(ty i32) (index i64)] (-> u64)
  (let [wide [(: 0x0000000000000000 u64) 0x8000000000000000 0x0000000000000001
              0x8000000000000001 0x000FFFFFFFFFFFFF 0x0010000000000000
              0x3FF0000000000000 0xBFF0000000000000 0x3FE0000000000000
              0xBFE0000000000000 0x3FDFFFFFFFFFFFFF 0x3FE0000000000001
              0x3FF8000000000000 0xC004000000000000 0x400921FB54442D18
              0x4330000000000000 0x432FFFFFFFFFFFFF 0xC32FFFFFFFFFFFFF
              0x7FEFFFFFFFFFFFFF 0xFFEFFFFFFFFFFFFF 0x7FF0000000000000
              0xFFF0000000000000 0x7FF8000000000000 0xFFF8123456789ABC
              0x7FF0123456789ABC 0xFFF0000000000001]
        narrow [(: 0x00000000 u64) 0x80000000 0x00000001 0x80000001 0x007FFFFF 0x00800000
                0x3F800000 0xBF800000 0x3F000000 0xBF000000 0x3EFFFFFF 0x3F000001
                0x3FC00000 0xC0200000 0x40490FDB 0x4B000000 0x4AFFFFFF 0xCAFFFFFF
                0x7F7FFFFF 0xFF7FFFFF 0x7F800000 0xFF800000 0x7FC00000 0xFFC12345
                0x7F812345 0xFF800001]]
    (if (= ty 12) (get wide index) (get narrow index))))

(const FLOAT-SPECIALS 26)
