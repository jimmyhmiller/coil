;;; Vector LOAD/STORE and vector local variables on x86-64.
;;;
;;;   LOAD, LOAD_v (91, 92) of an 8- or 16-byte vector    movq/movups rd, [address]
;;;   STORE, STORE_v (93, 94) of one                      movq/movups [address], value
;;;   VLOAD, VLOAD_v (85, 86) of a vector                 movq/movups rd, [slot]
;;;   VSTORE, VSTORE_v (87, 88) of a vector value         movq/movups [slot], value
;;;
;;; Nothing is assumed about alignment: user memory may be unaligned, and a
;;; narrower vector may view the start of a wider variable. An 8-byte access
;;; reads and writes exactly eight bytes.
;;;
;;; The address of a LOAD or STORE is the addressing mode the memory family
;;; selected (stogir.x64.memory/fuse!): its base and index are the access's
;;; register operands and stogir.x64.address/operand! is its memory operand.
;;; The node's own address operand may have been absorbed and is not read.
;;; A local access addresses its VAR's slot (stogir.x64.locals/slot); the VAR
;;; itself belongs to the locals family, which requests the slot.
;;;
;;; `claims?` is what stogir.x64.families asks to route a node here.
(module stogir.x64.vector-memory)
(import "stogir.graph" :as g)
(import "stogir.locals" :as local)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.vector" :as vector)
(import "stogir.x64.address" :as address)
(import "stogir.x64.code" :as code)
(import "stogir.x64.context" :as context)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.locals" :as locals)
(import "stogir.x64.plan" :as plan)
(import "stogir.x64.simd-lanes" :as simd)
(import "stogir.x64.uses" :as uses)
(import "stogir.x64.value" :as value)
(import "stogir.x64.vector-value" :as vv)
(import "coil.result" :use [Result Ok Err Some None])

(const CONFLICT "conflicting x86-64 register constraints")

(defn operation? [(opcode i32)] (-> bool)
  (or (and (>= opcode 85) (<= opcode 88)) (and (>= opcode 91) (<= opcode 94))))

(defn load? [(opcode i32)] (-> bool)
  (or (= opcode 85) (= opcode 86) (= opcode 91) (= opcode 92)))

(defn local? [(opcode i32)] (-> bool)
  (and (>= opcode 85) (<= opcode 88)))

;;; The type an access moves: the node's own for a load, the stored value's
;;; for a store.
(defn accessed-type [(graph g/Graph) (node n/Node)] (-> i32)
  (if (load? (cast i32 (n/opcode node)))
      (cast i32 (n/type-id node))
      (value/type-of graph (.op3 node))))

;;; Whether scheduled node `reference` is a memory or local access of a
;;; vector value (of any width: an unsupported width is refused here, with
;;; this family's message, rather than by the integer accesses).
(defn claims? [(graph g/Graph) (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))]
    (and (operation? (cast i32 (n/opcode node)))
         (types/vector? (accessed-type graph node)))))

;;; Shape of the access; the accessed type.
(defn validate [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        ty (accessed-type graph node)]
    (if (not (vv/supported? ty))
        (Err vv/UNSUPPORTED)
        (match (if (local? opcode)
                   (local/validate graph reference 8)
                   (vector/validate graph reference 8))
          (Err [message] (Err message))
          (Ok [_] (Ok ty))))))

(defn constrain! [(set (mut uses/Set)) (graph g/Graph) (matched plan/Plan)
                  (reference i32) (position i64)] (-> (Result i32 (slice u8)))
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))]
    (match (validate graph reference)
      (Err [message] (Err message))
      (Ok [_]
          (let [(mut accepted) true]
            (unless (local? opcode)
              (let [selected (address/parts matched graph reference)]
                (unless (and (uses/use! (mut set) (.base selected) position)
                             (uses/use! (mut set) (.index selected) position))
                  (set! accepted false))))
            (unless (if (load? opcode)
                        (uses/define! (mut set) reference position)
                        (uses/use-anywhere! (mut set) (.op3 node) position))
              (set! accepted false))
            (if accepted (Ok 0) (Err CONFLICT)))))))

(defn emit! [(out (mut code/Buffer)) (cx context/Context) (reference i32) (position i64)]
  (-> (Result i32 (slice u8)))
  (let [node (get (.instructions (.graph cx)) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        (mut error) ""]
    (match (validate (.graph cx) reference)
      (Err [message] (set! error message))
      (Ok [ty]
          (match (if (local? opcode)
                     (locals/slot cx (.op2 node))
                     (address/operand! (mut out) cx reference position))
            (Err [message] (set! error message))
            (Ok [m]
                (if (load? opcode)
                    (match (vv/destination (.graph cx) (.parts cx) reference position)
                      (Err [message] (set! error message))
                      (Ok [rd] (simd/read! (mut out) (mut error) rd m (types/size ty 8))))
                    (match (vv/register! (mut out) (.graph cx) (.parts cx) (.base cx)
                                         (.op3 node) position simd/X14)
                      (Err [message] (set! error message))
                      (Ok [source]
                          (simd/write! (mut out) (mut error) m source (types/size ty 8)))))))))
    (if (= error "") (Ok 0) (Err error))))
