;;; The x86-64 matching plan: what selection decided for every graph node.
;;;
;;; `Plan` is the immutable result the constraints builder, the allocator
;;; bridge and the emitters read. `Matching` is the same tables while the
;;; matcher (stogir.x64.match) is still filling them; family `select!` hooks
;;; receive it and may set tiles, mark producers omitted and fill their own
;;; side tables. All tables are indexed by graph reference and zero-filled.
;;;
;;; Tables
;;;   operands      machine uses/definitions per node (stogir.matched-uses)
;;;   tiles         the selected rule per node (stogir.x64.select)
;;;   families      the operation family of each scheduled node
;;;                 (stogir.x64.families), computed once
;;;   comparisons   for an IF or COND that reads flags directly: the
;;;                 comparison node whose tile is its flags recipe, else 0;
;;;                 for a SWITCH that dispatches on the 32-bit source of its
;;;                 selector: the retired extension (stogir.x64.switch)
;;;   addresses, offsets, indices, index-shifts
;;;                 folded address of a memory access: base reference,
;;;                 displacement, index reference and log2 scale. Owned by the
;;;                 memory family; all zero in the core.
;;;   tails         per CALL/TAILCALL: 0 an ordinary call, 1 a native tail jump,
;;;                 2 a call followed by the epilogue (stogir.x64.tail-plan).
;;;                 Empty when the function has no tail call. Owned by the
;;;                 call family.
(module stogir.x64.plan)
(import "stogir.matched-uses" :as machine)
(import "stogir.x64.select" :as select)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defstruct Plan
  [(operands machine/Plan)
   (tiles (ArrayList select/Tile))
   (families (ArrayList i32))
   (comparisons (ArrayList i32))
   (addresses (ArrayList i32))
   (offsets (ArrayList i64))
   (indices (ArrayList i32))
   (index-shifts (ArrayList i32))
   (tails (ArrayList i32))])

;;; Mutable matching state. `omitted[r]`: node r emits nothing and defines no
;;; register (its consumer absorbed it). `counts[r]`: operand edges that read
;;; r from scheduled nodes still wanting its register. `blocks[r]`: the block
;;; start of scheduled node r. `protected[r]`: r is a root the caller observes.
;;; `switch-extensions`: SWITCH nodes whose selector extension may be retired
;;; (owned by stogir.x64.switch).
(defstruct Matching
  [(tiles (ArrayList select/Tile))
   (families (ArrayList i32))
   (comparisons (ArrayList i32))
   (addresses (ArrayList i32))
   (offsets (ArrayList i64))
   (indices (ArrayList i32))
   (index-shifts (ArrayList i32))
   (tails (ArrayList i32))
   (omitted (ArrayList bool))
   (counts (ArrayList i64))
   (blocks (ArrayList i32))
   (protected (ArrayList bool))
   (switch-extensions (ArrayList i32))])

;;; The flags recipe of an IF or COND with `comparisons[reference] > 0`.
(defn condition-tile [(plan Plan) (reference i32)] (-> select/Tile)
  (get (.tiles plan) (cast i64 (get (.comparisons plan) (cast i64 reference)))))

(defn fused? [(plan Plan) (reference i32)] (-> bool)
  (> (get (.comparisons plan) (cast i64 reference)) 0))

(defn selected [(plan Plan) (reference i32)] (-> (Result select/Tile (slice u8)))
  (let [tile (get (.tiles plan) (cast i64 reference))]
    (if (= (.rule tile) select/RULE-NONE)
        (Err "instruction has no selected x86-64 rule")
        (Ok tile))))

;;; The operation family of scheduled node `reference`.
(defn family [(plan Plan) (reference i32)] (-> i32)
  (get (.families plan) (cast i64 reference)))

;;; How CALL or TAILCALL `reference` is lowered: 0 call, 1 jump, 2 call + return.
(defn tail-mode [(plan Plan) (reference i32)] (-> i32)
  (if (< (cast i64 reference) (len (.tails plan)))
      (get (.tails plan) (cast i64 reference))
      0))

(defn omitted? [(plan Plan) (reference i32)] (-> bool)
  (get (.omitted (.operands plan)) (cast i64 reference)))

(defn release! [(plan (mut Plan))] (-> void)
  (machine/release! (mut (.operands plan)))
  (free! (mut (.tiles plan)))
  (free! (mut (.families plan)))
  (free! (mut (.comparisons plan)))
  (free! (mut (.addresses plan)))
  (free! (mut (.offsets plan)))
  (free! (mut (.indices plan)))
  (free! (mut (.index-shifts plan)))
  (free! (mut (.tails plan))))
