;;; Vector COND on x86-64: rd = condition ? yes : no, the whole vector chosen
;;; by one scalar condition.
;;;
;;; The condition is an ordinary scalar value (the matcher never fuses a
;;; comparison into a vector COND, as on AArch64): its truth flags come from
;;; stogir.x64.truth, an integer test or a floating compare with zero whose
;;; condition may involve the parity flag. SSE2 has no conditional move for
;;; XMM registers, so the choice is a short forward branch over a `movaps`,
;;; the same shape as a scalar floating COND (stogir.x64.floating). The arms
;;; are read after the flags are set, with moves, constant builds and loads
;;; that do not write flags. Either arm's bits reach rd unchanged, which is
;;; what the AArch64 mask-and-BSL sequence gives.
(module stogir.x64.vector-select)
(import "stogir.node" :as n)
(import "stogir.x64.code" :as code)
(import "stogir.x64.context" :as context)
(import "stogir.x64.fcompare" :as fcompare)
(import "stogir.x64.local" :as local)
(import "stogir.x64.simd-lanes" :as simd)
(import "stogir.x64.truth" :as truth)
(import "stogir.x64.vector-value" :as vv)

(defn emit! [(out (mut code/Buffer)) (error (mut (slice u8))) (cx context/Context)
             (node n/Node) (position i64) (rd i32)] (-> void)
  (match (truth/flags! (mut out) cx (.op1 node) position)
    (Err [message] (simd/fail! (mut error) message))
    (Ok [condition]
        (let [yes (.op2 node)
              no (.op3 node)
              ryes (vv/register-of (.graph cx) (.parts cx) yes position)
              (mut jumps) (local/create)
              done (local/label! (mut jumps))]
          (if (= ryes rd)
              (do
                (fcompare/jump-if! (mut out) (mut error) (mut jumps) condition done)
                (simd/check! (mut error)
                             (vv/into! (mut out) (.graph cx) (.parts cx) (.base cx) no position
                                       rd)))
              (do
                (simd/check! (mut error)
                             (vv/into! (mut out) (.graph cx) (.parts cx) (.base cx) no position
                                       rd))
                (fcompare/jump-if! (mut out) (mut error) (mut jumps)
                                   (fcompare/invert condition) done)
                (simd/check! (mut error)
                             (vv/into! (mut out) (.graph cx) (.parts cx) (.base cx) yes position
                                       rd))))
          (local/bind! (mut out) (mut jumps) done)
          (local/finish! (mut out) (mut error) jumps)))))
