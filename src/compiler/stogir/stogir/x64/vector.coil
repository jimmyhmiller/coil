;;; x86-64 short vectors (8 and 16 bytes, every lane type), SSE2 baseline.
;;;
;;; This family owns every node of a vector type and every node that reads a
;;; vector (stogir.x64.families/of): lane arithmetic, logic, shifts, unary
;;; operations, extrema and comparisons, EXTRACT/REPLACE/SPLAT, vector COPY,
;;; COND and PHI, BITCAST to and from a vector, vector LOAD/STORE and local
;;; accesses, and the vector forms of PARAM and RETURN, which the driver
;;; emits (stogir.x64.function) after this module constrained them. It
;;; covers what the AArch64 backend covers, with the same results lane for
;;; lane; SHUFFLE has no emitter on either target.
;;;
;;; Modules (the a64 names where the same job exists)
;;;   vector-value       representation, constants, operands, the scratch
;;;                      frame object
;;;   simd-lanes         SSE2 building blocks and the register roles
;;;   vector-arithmetic  ADD SUB MUL DIV MOD AND OR XOR
;;;   vector-unary       NEG ABS NOT BSWAP and the three bit counts
;;;   vector-shift       SHL SHR SAR ROL ROR, uniform and per-lane counts
;;;   vector-extrema     MIN MAX
;;;   vector-comparison  lane masks
;;;   vector-select      COND
;;;   vector-lanes       EXTRACT REPLACE SPLAT
;;;   vector-memory      LOAD STORE VLOAD VSTORE
;;;
;;; Operands and registers. A vector operand may be in a register or in its
;;; spill slot; the first operand is read into xmm14 and the second into
;;; xmm15 when it is a constant or spilled. Scalar operands (shift counts,
;;; lane indexes, lane values) are in registers, constants in r10/r11/xmm15.
;;; A sequence that needs temporaries has xmm13, xmm12, xmm11 clobbered (as
;;; many as its module's `temporaries` says); integer division has rax and
;;; rdx clobbered and a per-lane shift rcx, as their scalar forms do. Nodes
;;; that go through memory own a 32-byte scratch frame object
;;; (stogir.x64.vector-value).
;;;
;;; Not selected here: the AArch64 rule that turns an integer multiplication
;;; by SPLAT(2) into an addition (docs/VECTOR_DOUBLING.md) is a target tuning
;;; rule; the multiplication is emitted as it is.
;;;
;;; Interface (called through stogir.x64.families; see docs/X86_FAMILIES.md):
;;; `select!`, `constrain!`, `emit!`.
(module stogir.x64.vector)
(import "stogir.conditional" :as conditional-ops)
(import "stogir.conversion" :as conversion)
(import "stogir.copy" :as copy)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.vector-arithmetic" :as va)
(import "stogir.vector-comparison" :as vc)
(import "stogir.vector-lanes" :as vl)
(import "stogir.x64.code" :as code)
(import "stogir.x64.context" :as context)
(import "stogir.x64.emit" :as emit)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.plan" :as plan)
(import "stogir.x64.registers" :as registers)
(import "stogir.x64.simd-lanes" :as simd)
(import "stogir.x64.uses" :as uses)
(import "stogir.x64.value" :as value)
(import "stogir.x64.vector-arithmetic" :as arithmetic)
(import "stogir.x64.vector-comparison" :as comparison)
(import "stogir.x64.vector-extrema" :as extrema)
(import "stogir.x64.vector-lanes" :as lanes)
(import "stogir.x64.vector-memory" :as memory)
(import "stogir.x64.vector-select" :as selection)
(import "stogir.x64.vector-shift" :as shift)
(import "stogir.x64.vector-unary" :as unary)
(import "stogir.x64.vector-value" :as vv)
(import "coil.result" :use [Result Ok Err Some None])

(const CONFLICT "conflicting x86-64 register constraints")

(const OTHER "x86-64 backend: this operation on a vector value is not implemented")

(defn fail! [(error (mut (slice u8))) (message (slice u8))] (-> void)
  (when (= error "") (set! error message)))

(defn require! [(error (mut (slice u8))) (accepted bool)] (-> void)
  (when (not accepted) (fail! (mut error) CONFLICT)))

(defn check! [(error (mut (slice u8))) (result (Result i32 (slice u8)))] (-> void)
  (match result
    (Err [message] (fail! (mut error) message))
    (Ok [_] 0)))

;;; Whether the second operand of shift `node` is one scalar count for every
;;; lane (a vector of counts otherwise).
(defn scalar-count? [(graph g/Graph) (node n/Node)] (-> bool)
  (types/integer? (value/type-of graph (.op2 node))))

;;; ---- Selection --------------------------------------------------------------

(defn select! [(state (mut plan/Matching)) (graph g/Graph) (reference i32)]
  (-> (Result i32 (slice u8)))
  (Ok 0))

;;; ---- Constraints ------------------------------------------------------------

;;; Keep the first `count` temporaries (xmm13, xmm12, xmm11) free of operands,
;;; live values and the result while the node at `position` runs.
(defn temporaries! [(set (mut uses/Set)) (position i64) (count i32)] (-> void)
  (when (>= count 1) (uses/clobber! (mut set) simd/T1 position (+ position 2)))
  (when (>= count 2) (uses/clobber! (mut set) simd/T2 position (+ position 2)))
  (when (>= count 3) (uses/clobber! (mut set) simd/T3 position (+ position 2))))

;;; A vector type the node may not have or read.
(defn unsupported? [(graph g/Graph) (node n/Node)] (-> bool)
  (let [ty (cast i32 (n/type-id node))]
    (and (types/vector? ty) (not (vv/supported? ty)))))

(defn constrain-arithmetic! [(set (mut uses/Set)) (error (mut (slice u8))) (graph g/Graph)
                             (reference i32) (node n/Node) (position i64)] (-> void)
  (let [opcode (cast i32 (n/opcode node))
        ty (cast i32 (n/type-id node))]
    (require! (mut error) (uses/use-anywhere! (mut set) (.op1 node) position))
    (require! (mut error) (uses/define! (mut set) reference position))
    (cond (va/unary? opcode)
            (if (unary/lane-expanded? opcode ty)
                (vv/scratch! (mut set) reference)
                (temporaries! (mut set) position (unary/temporaries opcode ty)))
          (va/shift? opcode)
            (if (scalar-count? graph node)
                (do
                  (require! (mut error) (uses/use! (mut set) (.op2 node) position))
                  (temporaries! (mut set) position (shift/temporaries opcode ty true)))
                (do
                  (require! (mut error) (uses/use-anywhere! (mut set) (.op2 node) position))
                  (vv/scratch! (mut set) reference)
                  (uses/clobber! (mut set) registers/RCX position (+ position 2))))
          (va/extrema? opcode)
            (do
              (require! (mut error) (uses/use-anywhere! (mut set) (.op2 node) position))
              (temporaries! (mut set) position (extrema/temporaries opcode ty))
              (when (= (extrema/temporaries opcode ty) 0)
                (uses/hint! (mut set) reference (.op1 node))))
          (arithmetic/lane-expanded? opcode ty)
            (do
              (require! (mut error) (uses/use-anywhere! (mut set) (.op2 node) position))
              (vv/scratch! (mut set) reference)
              (uses/clobber! (mut set) registers/RAX position (+ position 2))
              (uses/clobber! (mut set) registers/RDX position (+ position 2)))
          :else
            (do
              (require! (mut error) (uses/use-anywhere! (mut set) (.op2 node) position))
              (temporaries! (mut set) position (arithmetic/temporaries opcode ty))
              (when (= (arithmetic/temporaries opcode ty) 0)
                (uses/hint! (mut set) reference (.op1 node)))))))

(defn constrain-lanes! [(set (mut uses/Set)) (error (mut (slice u8))) (graph g/Graph)
                        (reference i32) (node n/Node) (position i64)] (-> void)
  (let [opcode (cast i32 (n/opcode node))]
    (require! (mut error) (uses/define! (mut set) reference position))
    (if (= opcode 63)
        (require! (mut error) (uses/use! (mut set) (.op1 node) position))
        (do
          (require! (mut error) (uses/use-anywhere! (mut set) (.op1 node) position))
          (when (< (vl/constant-index graph (.op2 node)) 0)
            (require! (mut error) (uses/use! (mut set) (.op2 node) position))
            (vv/scratch! (mut set) reference))
          (when (= opcode 62)
            (require! (mut error) (uses/use! (mut set) (.op3 node) position))
            (temporaries! (mut set) position
                          (lanes/temporaries opcode (cast i32 (n/type-id node))))
            (uses/hint! (mut set) reference (.op1 node)))))))

(defn constrain! [(set (mut uses/Set)) (graph g/Graph) (matched plan/Plan)
                  (reference i32) (position i64)] (-> (Result i32 (slice u8)))
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        ty (cast i32 (n/type-id node))
        (mut error) ""]
    (cond (unsupported? graph node) (fail! (mut error) vv/UNSUPPORTED)
          (memory/operation? opcode)
            (check! (mut error) (memory/constrain! (mut set) graph matched reference position))
          ; PHI: the edges write it.
          (= opcode 67) 0
          (= opcode 71)
            (let [parameter (.parameter (at (.values set) (cast i64 reference)))]
              (if (= (.kind parameter) 2)
                  (require! (mut error)
                            (uses/define-fixed! (mut set) reference position
                                                (.register parameter)))
                  (fail! (mut error) "unsupported x86-64 vector parameter")))
          (= opcode 120)
            (do
              (require! (mut error) (uses/use-anywhere! (mut set) (.op2 node) position))
              (uses/prefer! (mut set) (.op2 node) registers/XMM0))
          (= opcode 68)
            (match (copy/validate graph reference)
              (Err [message] (fail! (mut error) message))
              (Ok [_]
                  (require! (mut error) (uses/use-anywhere! (mut set) (.op1 node) position))
                  (require! (mut error) (uses/define! (mut set) reference position))
                  (uses/hint! (mut set) reference (.op1 node))))
          (= opcode 60)
            (match (conditional-ops/validate graph reference)
              (Err [message] (fail! (mut error) message))
              (Ok [_]
                  (require! (mut error) (uses/use! (mut set) (.op1 node) position))
                  (require! (mut error) (uses/use-anywhere! (mut set) (.op2 node) position))
                  (require! (mut error) (uses/use-anywhere! (mut set) (.op3 node) position))
                  (require! (mut error) (uses/define! (mut set) reference position))
                  ; The emitter puts the false arm into rd first.
                  (uses/hint! (mut set) reference (.op3 node))))
          (= opcode 36)
            (match (conversion/validate graph reference 8)
              (Err [message] (fail! (mut error) message))
              (Ok [_]
                  (let [origin (value/type-of graph (.op1 node))]
                    (if (and (types/vector? origin) (not (vv/supported? origin)))
                        (fail! (mut error) vv/UNSUPPORTED)
                        (do
                          (require! (mut error)
                                    (if (types/integer? origin)
                                        (uses/use! (mut set) (.op1 node) position)
                                        (uses/use-anywhere! (mut set) (.op1 node) position)))
                          (require! (mut error) (uses/define! (mut set) reference position))
                          (unless (or (types/integer? origin) (types/integer? ty))
                            (uses/hint! (mut set) reference (.op1 node))))))))
          (vl/operation? opcode)
            (match (vl/validate graph reference 8)
              (Err [message] (fail! (mut error) message))
              (Ok [vector-type]
                  (if (not (vv/supported? vector-type))
                      (fail! (mut error) vv/UNSUPPORTED)
                      (constrain-lanes! (mut set) (mut error) graph reference node position))))
          (vc/node? graph reference)
            (match (vc/validate graph reference 8)
              (Err [message] (fail! (mut error) message))
              (Ok [operand-type]
                  (if (not (vv/supported? operand-type))
                      (fail! (mut error) vv/UNSUPPORTED)
                      (do
                        (require! (mut error) (uses/use-anywhere! (mut set) (.op1 node) position))
                        (require! (mut error) (uses/use-anywhere! (mut set) (.op2 node) position))
                        (require! (mut error) (uses/define! (mut set) reference position))
                        (temporaries! (mut set) position
                                      (comparison/temporaries opcode operand-type))
                        (when (= (comparison/temporaries opcode operand-type) 0)
                          (uses/hint! (mut set) reference (.op1 node)))))))
          (va/node? graph reference)
            (match (va/validate graph reference)
              (Err [message] (fail! (mut error) message))
              (Ok [_] (constrain-arithmetic! (mut set) (mut error) graph reference node position)))
          :else (fail! (mut error) OTHER))
    (if (= error "") (Ok 0) (Err error))))

;;; ---- Emission ---------------------------------------------------------------

;;; The XMM register of vector operand `reference` (`scratch` for a constant
;;; or a reload); -1 after recording a failure.
(defn operand! [(out (mut code/Buffer)) (error (mut (slice u8))) (cx context/Context)
                (reference i32) (position i64) (scratch i32)] (-> i32)
  (match (vv/register! (mut out) (.graph cx) (.parts cx) (.base cx) reference position scratch)
    (Err [message] (fail! (mut error) message) -1)
    (Ok [register] register)))

;;; The general register of integer operand `reference` (`scratch` for a
;;; constant or a reload); -1 after recording a failure.
(defn integer! [(out (mut code/Buffer)) (error (mut (slice u8))) (cx context/Context)
                (reference i32) (position i64) (scratch i32)] (-> i32)
  (match (emit/operand! (mut out) cx reference position scratch)
    (Err [message] (fail! (mut error) message) -1)
    (Ok [register] register)))

;;; The register of scalar operand `reference` of a lane operation: a general
;;; register (r11 for a constant or reload) for an integer, an XMM register
;;; (xmm15 likewise) for a FLOAT or DOUBLE.
(defn scalar! [(out (mut code/Buffer)) (error (mut (slice u8))) (cx context/Context)
               (reference i32) (position i64)] (-> i32)
  (if (types/floating? (value/type-of (.graph cx) reference))
      (match (value/float-register! (mut out) (.graph cx) (.parts cx) (.base cx) reference
                                    position simd/X15)
        (Err [message] (fail! (mut error) message) -1)
        (Ok [register] register))
      (integer! (mut out) (mut error) cx reference position simd/R11)))

;;; The memory operand of the node's scratch frame object.
(defn scratch [(error (mut (slice u8))) (cx context/Context) (reference i32)] (-> encode/Mem)
  (match (vv/scratch cx reference)
    (Err [message] (fail! (mut error) message) (encode/mem registers/RSP 0))
    (Ok [m] m)))

(defn emit-arithmetic! [(out (mut code/Buffer)) (error (mut (slice u8))) (cx context/Context)
                        (reference i32) (node n/Node) (position i64) (rd i32)] (-> void)
  (let [opcode (cast i32 (n/opcode node))
        ty (cast i32 (n/type-id node))
        a (operand! (mut out) (mut error) cx (.op1 node) position simd/X14)]
    (cond (va/unary? opcode)
            (if (unary/lane-expanded? opcode ty)
                (unary/leading-zeros! (mut out) (mut error) ty (scratch (mut error) cx reference)
                                      rd a)
                (unary/emit-registers! (mut out) (mut error) opcode ty rd a))
          (and (va/shift? opcode) (scalar-count? (.graph cx) node))
            (let [count (integer! (mut out) (mut error) cx (.op2 node) position simd/R11)]
              (shift/uniform! (mut out) (mut error) opcode ty rd a count))
          :else
            (let [b (operand! (mut out) (mut error) cx (.op2 node) position simd/X15)]
              (cond (va/shift? opcode)
                      (shift/variable! (mut out) (mut error) opcode ty
                                       (scratch (mut error) cx reference) rd a b)
                    (va/extrema? opcode)
                      (extrema/emit-registers! (mut out) (mut error) opcode ty rd a b)
                    (arithmetic/lane-expanded? opcode ty)
                      (arithmetic/divide! (mut out) (mut error) opcode ty
                                          (scratch (mut error) cx reference) rd a b)
                    :else (arithmetic/emit-registers! (mut out) (mut error) opcode ty rd a b))))))

;;; EXTRACT, REPLACE, SPLAT. `vector-type` is the type of the vector involved.
(defn emit-lanes! [(out (mut code/Buffer)) (error (mut (slice u8))) (cx context/Context)
                   (reference i32) (node n/Node) (position i64) (vector-type i32)] (-> void)
  (let [opcode (cast i32 (n/opcode node))
        ty (cast i32 (n/type-id node))
        graph (.graph cx)]
    (if (= opcode 61)
        (match (if (types/floating? ty)
                   (value/float-destination graph (.parts cx) reference position)
                   (emit/destination cx reference position))
          (Err [message] (fail! (mut error) message))
          (Ok [rd]
              (let [lane (vl/constant-index graph (.op2 node))
                    a (operand! (mut out) (mut error) cx (.op1 node) position simd/X14)]
                (if (>= lane 0)
                    (lanes/extract! (mut out) (mut error) vector-type ty lane rd a)
                    (let [index (integer! (mut out) (mut error) cx (.op2 node) position simd/R10)]
                      (lanes/extract-dynamic! (mut out) (mut error) vector-type ty
                                              (value/type-of graph (.op2 node))
                                              (scratch (mut error) cx reference) rd a index))))))
        (match (vv/destination graph (.parts cx) reference position)
          (Err [message] (fail! (mut error) message))
          (Ok [rd]
              (if (= opcode 63)
                  (let [scalar (scalar! (mut out) (mut error) cx (.op1 node) position)]
                    (lanes/splat! (mut out) (mut error) ty rd scalar))
                  (let [lane (vl/constant-index graph (.op2 node))
                        a (operand! (mut out) (mut error) cx (.op1 node) position simd/X14)
                        scalar (scalar! (mut out) (mut error) cx (.op3 node) position)]
                    (if (>= lane 0)
                        (lanes/replace! (mut out) (mut error) ty lane rd a scalar)
                        (let [index (integer! (mut out) (mut error) cx (.op2 node) position
                                              simd/R10)]
                          (lanes/replace-dynamic! (mut out) (mut error) ty
                                                  (value/type-of graph (.op2 node))
                                                  (scratch (mut error) cx reference) rd a index
                                                  scalar))))))))))

;;; BITCAST with a vector source or result: a register copy inside the XMM
;;; bank, `movq` between an 8-byte vector and a general register.
(defn emit-bitcast! [(out (mut code/Buffer)) (error (mut (slice u8))) (cx context/Context)
                     (reference i32) (node n/Node) (position i64)] (-> void)
  (let [target (cast i32 (n/type-id node))
        origin (value/type-of (.graph cx) (.op1 node))
        graph (.graph cx)]
    (cond (types/integer? target)
            (match (emit/destination cx reference position)
              (Err [message] (fail! (mut error) message))
              (Ok [rd]
                  (let [a (operand! (mut out) (mut error) cx (.op1 node) position simd/X14)]
                    (code/accept! (mut error) (encode/movd-rx (mut (.text out)) 64 rd a)))))
          (types/floating? target)
            (match (value/float-destination graph (.parts cx) reference position)
              (Err [message] (fail! (mut error) message))
              (Ok [rd]
                  (check! (mut error)
                          (vv/into! (mut out) graph (.parts cx) (.base cx) (.op1 node) position
                                    rd))))
          :else
            (match (vv/destination graph (.parts cx) reference position)
              (Err [message] (fail! (mut error) message))
              (Ok [rd]
                  (cond (types/integer? origin)
                          (let [a (integer! (mut out) (mut error) cx (.op1 node) position
                                            simd/R10)]
                            (code/accept! (mut error)
                                          (encode/movd-xr (mut (.text out)) 64 rd a)))
                        (types/floating? origin)
                          (check! (mut error)
                                  (value/float-into! (mut out) graph (.parts cx) (.base cx)
                                                     (.op1 node) position rd))
                        :else
                          (check! (mut error)
                                  (vv/into! (mut out) graph (.parts cx) (.base cx) (.op1 node)
                                            position rd))))))))

(defn emit! [(out (mut code/Buffer)) (cx context/Context) (reference i32) (position i64)]
  (-> (Result i32 (slice u8)))
  (let [graph (.graph cx)
        node (get (.instructions graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        (mut error) ""]
    (cond (unsupported? graph node) (fail! (mut error) vv/UNSUPPORTED)
          (memory/operation? opcode)
            (check! (mut error) (memory/emit! (mut out) cx reference position))
          (or (= opcode 71) (= opcode 120))
            (fail! (mut error) "x86-64 backend: vector PARAM and RETURN are emitted by the driver")
          (= opcode 36)
            (match (conversion/validate graph reference 8)
              (Err [message] (fail! (mut error) message))
              (Ok [_] (emit-bitcast! (mut out) (mut error) cx reference node position)))
          (vl/operation? opcode)
            (match (vl/validate graph reference 8)
              (Err [message] (fail! (mut error) message))
              (Ok [vector-type]
                  (if (not (vv/supported? vector-type))
                      (fail! (mut error) vv/UNSUPPORTED)
                      (emit-lanes! (mut out) (mut error) cx reference node position
                                   vector-type))))
          :else
            (match (vv/destination graph (.parts cx) reference position)
              (Err [message] (fail! (mut error) message))
              (Ok [rd]
                  (cond (= opcode 68)
                          (check! (mut error)
                                  (vv/into! (mut out) graph (.parts cx) (.base cx) (.op1 node)
                                            position rd))
                        (= opcode 60)
                          (match (conditional-ops/validate graph reference)
                            (Err [message] (fail! (mut error) message))
                            (Ok [_] (selection/emit! (mut out) (mut error) cx node position rd)))
                        (vc/node? graph reference)
                          (match (vc/validate graph reference 8)
                            (Err [message] (fail! (mut error) message))
                            (Ok [operand-type]
                                (let [a (operand! (mut out) (mut error) cx (.op1 node) position
                                                  simd/X14)
                                      b (operand! (mut out) (mut error) cx (.op2 node) position
                                                  simd/X15)]
                                  (comparison/emit-registers! (mut out) (mut error) opcode
                                                              operand-type rd a b))))
                        (va/node? graph reference)
                          (match (va/validate graph reference)
                            (Err [message] (fail! (mut error) message))
                            (Ok [_]
                                (emit-arithmetic! (mut out) (mut error) cx reference node
                                                  position rd)))
                        :else (fail! (mut error) OTHER)))))
    (if (= error "") (Ok 0) (Err error))))
