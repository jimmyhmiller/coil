;;; Short forward jumps inside one node's code (x86-64).
;;;
;;; Block-level branches go through stogir.x64.fixups, whose records a later
;;; relaxation pass may re-encode. A jump whose target lies in the same
;;; node's emission, with only fixed-length instructions of that node in
;;; between, needs none of that: it is emitted as `jcc rel8` / `jmp rel8` and
;;; patched when the node's code is complete. No fixup record may be created
;;; between such a jump and its target, so nothing ever moves between them.
;;;
;;; Use: `(label! jumps)` for each target, `jump!` to it any number of times,
;;; `bind!` where it lands, and `finish!` once at the end, which patches every
;;; displacement and fails on an unbound label or a distance beyond rel8.
;;; A node may use at most CAPACITY jumps and CAPACITY labels; the tables are
;;; inline so emission allocates nothing.
(module stogir.x64.local)
(import "stogir.x64.code" :as code)
(import "stogir.x64.encode" :as encode)
(import "coil.result" :use [Result Ok Err])

(const CAPACITY 12)

(defstruct Jumps
  [(count i64)
   (labels i64)
   (fields (array i64 12))
   (owners (array i64 12))
   (targets (array i64 12))])

(defn create [] (-> Jumps)
  (Jumps :count 0 :labels 0
         :fields (zeroed (array i64 12))
         :owners (zeroed (array i64 12))
         :targets (zeroed (array i64 12))))

;;; A new, unbound label; -1 when the table is full (`jump!` then reports it).
(defn label! [(jumps (mut Jumps))] (-> i64)
  (let [id (.labels jumps)]
    (if (>= id CAPACITY)
        -1
        (do
          (set! (mut (.targets jumps)) id -1)
          (set! (.labels jumps) (+ id 1))
          id))))

;;; `jcc rel8` to `label` when `condition` holds; `jmp rel8` for -1.
(defn jump! [(out (mut code/Buffer)) (error (mut (slice u8))) (jumps (mut Jumps))
             (condition i32) (label i64)] (-> void)
  (if (or (>= (.count jumps) CAPACITY) (< label 0) (>= label (.labels jumps)))
      (when (= error "") (set! error "x86-64 local jump table overflow or unknown label"))
      (match (if (= condition -1)
                 (encode/jmp-rel8 (mut (.text out)) 0)
                 (encode/jcc-rel8 (mut (.text out)) condition 0))
        (Err [message] (when (= error "") (set! error message)))
        (Ok [field]
            (set! (mut (.fields jumps)) (.count jumps) field)
            (set! (mut (.owners jumps)) (.count jumps) label)
            (set! (.count jumps) (+ (.count jumps) 1))))))

;;; `label` is the next byte emitted.
(defn bind! [(out (mut code/Buffer)) (jumps (mut Jumps)) (label i64)] (-> void)
  (when (and (>= label 0) (< label (.labels jumps)))
    (set! (mut (.targets jumps)) label (len (.text out)))))

;;; Patch every jump. An error leaves the displacements unpatched; the caller
;;; discards the code.
(defn finish! [(out (mut code/Buffer)) (error (mut (slice u8))) (jumps Jumps)] (-> void)
  (for [i 0 (.count jumps)]
    (let [field (get (.fields jumps) i)
          target (get (.targets jumps) (get (.owners jumps) i))
          distance (- target (+ field 1))]
      (if (or (< target 0) (< distance 0) (> distance 127))
          (when (= error "") (set! error "x86-64 local jump is unbound or out of rel8 range"))
          (set! (mut (.text out)) field (cast u8 distance))))))
