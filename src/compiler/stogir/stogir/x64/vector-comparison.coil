;;; Lane-wise comparisons producing full-lane masks (all ones or zero), SSE2.
;;; The results are the AArch64 backend's, lane for lane.
;;;
;;; Integer lanes. The opcode alone picks the order: LT GE LE GT (16..19)
;;; compare as signed and ULT UGE ULE UGT (20..23) as unsigned, whatever the
;;; lane type. Everything is built from two primitives and a complement:
;;;   equal     pcmpeqb/w/d; 8-byte lanes AND the two pcmpeqd halves
;;;             (pcmpeqq is SSE4.1)
;;;   greater   signed: pcmpgtb/w/d. Unsigned: both operands XOR the lane's
;;;             sign bit, then the signed compare. 8-byte lanes (pcmpgtq is
;;;             SSE4.2) take the sign of
;;;               signed    (b & ~a) | (~(b ^ a) & (b - a))
;;;               unsigned  (~b & a) | (~(b ^ a) & (b - a))
;;;             which is the borrow of b - a corrected for overflow, spread
;;;             over the lane with psrad and pshufd.
;;;
;;; Floating lanes use cmpps/cmppd with the predicate that is false (LT GE LE
;;; GT EQ ORDERED) or true (NE ULT UGE ULE UGT UNORDERED) for unordered
;;; operands; GE and GT and their unordered forms exchange the operands.
;;;
;;; Registers: see stogir.x64.simd-lanes; `ty` is the operands' type.
(module stogir.x64.vector-comparison)
(import "stogir.types" :as types)
(import "stogir.vector-comparison" :as vector)
(import "stogir.x64.code" :as code)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.registers" :as registers)
(import "stogir.x64.simd-lanes" :as simd)

(defn temporaries [(opcode i32) (ty i32)] (-> i32)
  (if (simd/floating? ty) 0 2))

;;; d = (a > b) per lane, signed or unsigned. `d` and `s` are registers the
;;; sequence writes; neither is a or b, which are only read.
(defn greater! [(out (mut code/Buffer)) (error (mut (slice u8))) (lane i32)
                (unsigned bool) (d i32) (s i32) (a i32) (b i32)] (-> void)
  (cond (= lane 8)
          (do
            (simd/move! (mut out) (mut error) d b)
            (simd/sse! (mut out) (mut error) encode/PSUBQ d a)
            (simd/move! (mut out) (mut error) s b)
            (simd/sse! (mut out) (mut error) encode/PXOR s a)
            (simd/sse! (mut out) (mut error) encode/PANDN s d)
            ; signed: ~a & b; unsigned: ~b & a.
            (simd/move! (mut out) (mut error) d (if unsigned b a))
            (simd/sse! (mut out) (mut error) encode/PANDN d (if unsigned a b))
            (simd/sse! (mut out) (mut error) encode/POR d s)
            (simd/shift! (mut out) (mut error) encode/PSRAD-I d 31)
            (simd/sse-imm! (mut out) (mut error) encode/PSHUFD d d 0xF5))
        unsigned
          (do
            (simd/splat-bits! (mut out) (mut error) s (simd/sign-bits lane))
            (simd/move! (mut out) (mut error) d a)
            (simd/sse! (mut out) (mut error) encode/PXOR d s)
            (simd/sse! (mut out) (mut error) encode/PXOR s b)
            (simd/sse! (mut out) (mut error) (simd/greater-op lane) d s))
        :else
          (do
            (simd/move! (mut out) (mut error) d a)
            (simd/sse! (mut out) (mut error) (simd/greater-op lane) d b))))

;;; d = (a == b) per lane; `d` and `s` as for greater!.
(defn equal! [(out (mut code/Buffer)) (error (mut (slice u8))) (lane i32) (d i32) (s i32)
              (a i32) (b i32)] (-> void)
  (if (= lane 8)
      (do
        (simd/move! (mut out) (mut error) d a)
        (simd/sse! (mut out) (mut error) encode/PCMPEQD d b)
        (simd/sse-imm! (mut out) (mut error) encode/PSHUFD s d 0xB1)
        (simd/sse! (mut out) (mut error) encode/PAND d s))
      (do
        (simd/move! (mut out) (mut error) d a)
        (simd/sse! (mut out) (mut error) (simd/equal-op lane) d b))))

;;; cmpps/cmppd predicate of a floating comparison, and whether the operands
;;; are exchanged.
(defn predicate [(opcode i32)] (-> i32)
  (case opcode
    14 0
    15 4
    16 1
    17 2
    18 2
    19 1
    20 6
    21 5
    22 5
    23 6
    24 7
    3))

(defn exchanged? [(opcode i32)] (-> bool)
  (or (= opcode 17) (= opcode 19) (= opcode 20) (= opcode 22)))

;;; rd = the mask of `a OPCODE b` per lane.
(defn emit-registers! [(out (mut code/Buffer)) (error (mut (slice u8))) (opcode i32)
                       (ty i32) (rd i32) (a i32) (b i32)] (-> void)
  (let [lane (simd/element ty)
        t1 (: simd/T1 i32)
        t2 (: simd/T2 i32)]
    (cond (or (not (vector/valid-type? opcode ty))
              (not (types/short-vector? ty 8))
              (not (registers/simd? rd))
              (not (registers/simd? a))
              (not (registers/simd? b)))
            (simd/fail! (mut error) "unsupported x86-64 vector comparison shape or registers")
          (simd/floating? ty)
            (simd/two-address-imm! (mut out) (mut error)
                                   (if (= (types/base-type ty) 12) encode/CMPPD encode/CMPPS)
                                   rd
                                   (if (exchanged? opcode) b a)
                                   (if (exchanged? opcode) a b)
                                   (predicate opcode))
          :else
            (let [unsigned (>= opcode 20)
                  ; The relation computed before the optional complement.
                  swapped (or (= opcode 16) (= opcode 17) (= opcode 20) (= opcode 21))
                  complemented (or (= opcode 15) (= opcode 17) (= opcode 18) (= opcode 21)
                                   (= opcode 22))]
              (if (<= opcode 15)
                  (equal! (mut out) (mut error) lane t1 t2 a b)
                  (greater! (mut out) (mut error) lane unsigned t1 t2
                            (if swapped b a) (if swapped a b)))
              (when complemented
                (simd/ones! (mut out) (mut error) t2)
                (simd/sse! (mut out) (mut error) encode/PXOR t1 t2))
              (simd/move! (mut out) (mut error) rd t1)))))
