;;; SSE2 building blocks shared by the x86-64 vector emitters: instruction
;;; wrappers, the registers a sequence may use, constants built without
;;; memory, two-address lowering, whole-vector moves to and from memory, and
;;; the transfer of one lane between an XMM register and a general register.
;;;
;;; Register roles inside one vector node (stogir.x64.vector decides them and
;;; tells the allocator):
;;;   rd         the node's result: an allocated XMM register, never a scratch
;;;              and never a temporary. It may be the register of an operand.
;;;   a, b       operands: an allocated XMM register, or xmm14 (first operand)
;;;              / xmm15 (second operand) holding a constant or a reload.
;;;              A sequence never writes an operand register, except rd once
;;;              every operand has been read for the last time.
;;;   T1 T2 T3   xmm13, xmm12, xmm11: temporaries. A node that needs n of them
;;;              (`temporaries` of its emitter module) has the first n
;;;              clobbered over its whole position pair, so no operand, no
;;;              live value and not the result is in one. Sequences that are
;;;              more than one two-address instruction compute in
;;;              temporaries and move the result to rd last, which makes
;;;              every aliasing of rd, a and b correct by construction.
;;;   r10, r11   general scratches; r10 also carries 64-bit patterns into
;;;              XMM registers (`bits!`).
;;; No SSE instruction used here writes EFLAGS.
;;;
;;; The a64 module of this name holds AArch64 UMOV/SMOV/INS words; SSE2 has
;;; only pextrw/pinsrw, so the other lane widths are sequences.
(module stogir.x64.simd-lanes)
(import "stogir.types" :as types)
(import "stogir.x64.code" :as code)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.registers" :as registers)
(import "stogir.x64.value" :as value)
(import "coil.result" :use [Result Ok Err])

(const T1 45)

(const T2 44)

(const T3 43)

(const X14 registers/SCRATCH-SIMD)

(const X15 registers/SCRATCH-SIMD-2)

(const R10 registers/SCRATCH-GPR)

(const R11 registers/SCRATCH-GPR-2)

(defn fail! [(error (mut (slice u8))) (message (slice u8))] (-> void)
  (when (= error "") (set! error message)))

(defn check! [(error (mut (slice u8))) (result (Result i32 (slice u8)))] (-> void)
  (match result
    (Err [message] (fail! (mut error) message))
    (Ok [_] 0)))

;;; Bytes of one lane: 1, 2, 4 or 8.
(defn element [(ty i32)] (-> i32)
  (types/scalar-size (types/base-type ty) 8))

;;; Bytes of the whole vector: 8 or 16 for the vectors this backend accepts.
(defn width [(ty i32)] (-> i32)
  (types/size ty 8))

(defn floating? [(ty i32)] (-> bool)
  (types/floating? (types/base-type ty)))

;;; op dst, src
(defn sse! [(out (mut code/Buffer)) (error (mut (slice u8))) (op i32) (dst i32) (src i32)]
  (-> void)
  (code/accept! (mut error) (encode/sse-rr (mut (.text out)) op dst src)))

;;; op dst, src, imm8
(defn sse-imm! [(out (mut code/Buffer)) (error (mut (slice u8))) (op i32) (dst i32)
                (src i32) (imm i32)] (-> void)
  (code/accept! (mut error) (encode/sse-rri (mut (.text out)) op dst src imm)))

;;; One of the `*-I` packed shifts by an immediate count.
(defn shift! [(out (mut code/Buffer)) (error (mut (slice u8))) (op i32) (register i32)
              (count i32)] (-> void)
  (code/accept! (mut error) (encode/sse-shift-ri (mut (.text out)) op register count)))

;;; movaps dst, src; nothing when they are one register.
(defn move! [(out (mut code/Buffer)) (error (mut (slice u8))) (dst i32) (src i32)] (-> void)
  (when (!= dst src)
    (code/accept! (mut error) (encode/sse-mov-rr (mut (.text out)) encode/MOVAPS dst src))))

(defn zero! [(out (mut code/Buffer)) (error (mut (slice u8))) (register i32)] (-> void)
  (sse! (mut out) (mut error) encode/PXOR register register))

(defn ones! [(out (mut code/Buffer)) (error (mut (slice u8))) (register i32)] (-> void)
  (sse! (mut out) (mut error) encode/PCMPEQD register register))

;;; `register` = `raw` in both quadwords, through r10.
(defn splat-bits! [(out (mut code/Buffer)) (error (mut (slice u8))) (register i32)
                   (raw u64)] (-> void)
  (check! (mut error) (value/bits! (mut out) R10 raw 64))
  (code/accept! (mut error) (encode/movd-xr (mut (.text out)) 64 register R10))
  (sse! (mut out) (mut error) encode/PUNPCKLQDQ register register))

;;; The byte `byte` in every byte of a quadword.
(defn bytes-of [(byte u64)] (-> u64)
  (* byte (: 0x0101010101010101 u64)))

;;; The sign bit of every lane of `lane` bytes, as a quadword pattern.
(defn sign-bits [(lane i32)] (-> u64)
  (case lane
    1 (: 0x8080808080808080 u64)
    2 0x8000800080008000
    4 0x8000000080000000
    0x8000000000000000))

;;; Lane-wise integer instructions by lane size. -1 where SSE2 has none.
(defn add-op [(lane i32)] (-> i32)
  (case lane 1 encode/PADDB 2 encode/PADDW 4 encode/PADDD encode/PADDQ))

(defn subtract-op [(lane i32)] (-> i32)
  (case lane 1 encode/PSUBB 2 encode/PSUBW 4 encode/PSUBD encode/PSUBQ))

(defn equal-op [(lane i32)] (-> i32)
  (case lane 1 encode/PCMPEQB 2 encode/PCMPEQW 4 encode/PCMPEQD -1))

(defn greater-op [(lane i32)] (-> i32)
  (case lane 1 encode/PCMPGTB 2 encode/PCMPGTW 4 encode/PCMPGTD -1))

;;; Shifts by the count in the low quadword of an XMM register.
(defn left-op [(lane i32)] (-> i32)
  (case lane 2 encode/PSLLW 4 encode/PSLLD 8 encode/PSLLQ -1))

(defn right-op [(lane i32)] (-> i32)
  (case lane 2 encode/PSRLW 4 encode/PSRLD 8 encode/PSRLQ -1))

;;; Shifts by an immediate count.
(defn left-immediate [(lane i32)] (-> i32)
  (case lane 2 encode/PSLLW-I 4 encode/PSLLD-I 8 encode/PSLLQ-I -1))

(defn right-immediate [(lane i32)] (-> i32)
  (case lane 2 encode/PSRLW-I 4 encode/PSRLD-I 8 encode/PSRLQ-I -1))

;;; rd = a OP b for one instruction `op dst, src`, every aliasing of rd, a and
;;; b. When rd is b's register a commutative operation swaps its operands and
;;; any other is computed beside rd: in a's own register when that is a
;;; scratch copy (xmm14/xmm15), else in xmm14, which is then free because b
;;; is an allocated register.
(defn two-address! [(out (mut code/Buffer)) (error (mut (slice u8))) (op i32) (rd i32)
                    (a i32) (b i32) (commutative bool)] (-> void)
  (cond (= rd a) (sse! (mut out) (mut error) op rd b)
        (and (= rd b) commutative) (sse! (mut out) (mut error) op rd a)
        (= rd b)
          (let [work (if (or (= a X14) (= a X15)) a X14)]
            (move! (mut out) (mut error) work a)
            (sse! (mut out) (mut error) op work b)
            (move! (mut out) (mut error) rd work))
        :else
          (do
            (move! (mut out) (mut error) rd a)
            (sse! (mut out) (mut error) op rd b))))

;;; As two-address! for `op dst, src, imm8` (never commutative).
(defn two-address-imm! [(out (mut code/Buffer)) (error (mut (slice u8))) (op i32) (rd i32)
                        (a i32) (b i32) (imm i32)] (-> void)
  (cond (= rd a) (sse-imm! (mut out) (mut error) op rd b imm)
        (= rd b)
          (let [work (if (or (= a X14) (= a X15)) a X14)]
            (move! (mut out) (mut error) work a)
            (sse-imm! (mut out) (mut error) op work b imm)
            (move! (mut out) (mut error) rd work))
        :else
          (do
            (move! (mut out) (mut error) rd a)
            (sse-imm! (mut out) (mut error) op rd b imm))))

;;; The operand `displacement` bytes after `m`.
(defn after [(m encode/Mem) (displacement i64)] (-> encode/Mem)
  (encode/Mem :base (.base m) :index (.index m) :scale (.scale m)
              :disp (+ (.disp m) displacement)))

;;; register <- the `size` (8 or 16) bytes at m, no alignment assumed. An
;;; 8-byte load zeroes the upper quadword.
(defn read! [(out (mut code/Buffer)) (error (mut (slice u8))) (register i32)
             (m encode/Mem) (size i32)] (-> void)
  (code/accept! (mut error)
                (if (= size 16)
                    (encode/sse-mov-rm (mut (.text out)) encode/MOVUPS register m)
                    (encode/movd-xm (mut (.text out)) 64 register m))))

;;; The `size` (8 or 16) low bytes of register -> m, no alignment assumed.
(defn write! [(out (mut code/Buffer)) (error (mut (slice u8))) (m encode/Mem)
              (register i32) (size i32)] (-> void)
  (code/accept! (mut error)
                (if (= size 16)
                    (encode/sse-mov-mr (mut (.text out)) encode/MOVUPS m register)
                    (encode/movd-mx (mut (.text out)) 64 m register))))

;;; General register `rd` = lane `lane` (of `lane-bytes` bytes) of XMM
;;; register `source`, defined in the lane's own low bits; the bits above
;;; them are unspecified for 1-byte lanes and zero otherwise (a 4-byte lane
;;; clears the upper half of rd). `work` is an XMM register the sequence may
;;; write (lanes other than the first of 4 and 8 bytes are shuffled into it);
;;; it may be `source` only when the caller no longer needs the vector.
;;; Flags are written only for an odd 1-byte lane (`shr`).
(defn lane-extract! [(out (mut code/Buffer)) (error (mut (slice u8))) (lane-bytes i32)
                     (lane i32) (rd i32) (source i32) (work i32)] (-> void)
  (cond (or (< lane 0) (>= lane (/ 16 lane-bytes)))
          (fail! (mut error) "invalid x86-64 vector lane")
        (= lane-bytes 1)
          (do
            (code/accept! (mut error)
                          (encode/pextr-rx (mut (.text out)) 16 rd source (/ lane 2)))
            (when (= (% lane 2) 1)
              (code/accept! (mut error)
                            (encode/shift-ri (mut (.text out)) encode/SHR 32 rd 8))))
        (= lane-bytes 2)
          (code/accept! (mut error) (encode/pextr-rx (mut (.text out)) 16 rd source lane))
        (= lane 0)
          (code/accept! (mut error)
                        (encode/movd-rx (mut (.text out)) (* lane-bytes 8) rd source))
        :else
          (do
            (sse-imm! (mut out) (mut error) encode/PSHUFD work source
                      (if (= lane-bytes 4) lane 0xEE))
            (code/accept! (mut error)
                          (encode/movd-rx (mut (.text out)) (* lane-bytes 8) rd work)))))

;;; Lane `lane` of XMM register `rd` = the low `lane-bytes` bytes of general
;;; register `source`; the other lanes are kept. `scratch` is a general
;;; register other than `source` and `work` an XMM register other than rd;
;;; both are written for some lane sizes. Flags are written.
(defn lane-insert! [(out (mut code/Buffer)) (error (mut (slice u8))) (lane-bytes i32)
                    (lane i32) (rd i32) (source i32) (scratch i32) (work i32)] (-> void)
  (cond (or (< lane 0) (>= lane (/ 16 lane-bytes)) (= scratch source) (= work rd))
          (fail! (mut error) "invalid x86-64 vector lane insertion")
        (= lane-bytes 1)
          (do
            ; The word that holds the byte goes through `scratch`.
            (code/accept! (mut error)
                          (encode/pextr-rx (mut (.text out)) 16 scratch rd (/ lane 2)))
            (when (= (% lane 2) 1)
              (code/accept! (mut error)
                            (encode/shift-ri (mut (.text out)) encode/SHL 32 scratch 8)))
            (code/accept! (mut error) (encode/mov-rr (mut (.text out)) 8 scratch source))
            (when (= (% lane 2) 1)
              (code/accept! (mut error)
                            (encode/shift-ri (mut (.text out)) encode/ROL 16 scratch 8)))
            (code/accept! (mut error)
                          (encode/pinsr-xr (mut (.text out)) 16 rd scratch (/ lane 2))))
        (= lane-bytes 2)
          (code/accept! (mut error) (encode/pinsr-xr (mut (.text out)) 16 rd source lane))
        (= lane-bytes 4)
          (do
            (code/accept! (mut error)
                          (encode/pinsr-xr (mut (.text out)) 16 rd source (* lane 2)))
            (code/accept! (mut error) (encode/mov-rr (mut (.text out)) 32 scratch source))
            (code/accept! (mut error)
                          (encode/shift-ri (mut (.text out)) encode/SHR 32 scratch 16))
            (code/accept! (mut error)
                          (encode/pinsr-xr (mut (.text out)) 16 rd scratch (+ (* lane 2) 1))))
        :else
          (do
            (code/accept! (mut error) (encode/movd-xr (mut (.text out)) 64 work source))
            (if (= lane 0)
                (code/accept! (mut error)
                              (encode/sse-mov-rr (mut (.text out)) encode/MOVSD rd work))
                (sse! (mut out) (mut error) encode/PUNPCKLQDQ rd work)))))
