;;; System V x86-64 parameter locations from a complete signature, and the
;;; code that makes each PARAM's value available at its definition.
;;;
;;; Placement is stogir.x64.abi-arguments (the same rules callers use): integer
;;; eightbytes in rdi rsi rdx rcx r8 r9, floating ones in xmm0..xmm7, groups
;;; whole in registers or whole on the stack, MEMORY aggregates on the stack.
;;; Stack offsets are relative to the first stack argument, which is at entry
;;; rsp + 8 (the return address is at entry rsp).
;;;
;;; Result roles (stogir.call-results) decide what PARAM 0 is:
;;;   * register pieces: the address of a private frame buffer (kind 3); RETURN
;;;     loads the pieces from it into rax/rdx/xmm0/xmm1;
;;;   * indirect: the caller's hidden pointer in rdi (kind 0). The prologue
;;;     saves it in a frame slot and RETURN reloads it into rax.
;;;
;;; A callee never trusts the bits of a narrow integer above its type's width
;;; (stogir.x64.value), so no parameter is extended here.
;;;
;;; The a64 module of this name is not shared: it places parameters through
;;; the AAPCS64/Darwin planner and loads them with AArch64 encodings.
(module stogir.x64.incoming)
(import "stogir.locations" :as locations)
(import "stogir.x64.code" :as code)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.frame-address" :as frame)
(import "stogir.x64.registers" :as registers)
(import "stogir.x64.value" :as value)
(import "stogir.x64.abi-arguments" :as arguments)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.calls" :as calls)
(import "stogir.strings" :as strings)
(import "stogir.call-groups" :as groups)
(import "stogir.call-results" :as results)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

;;; kind: -1 absent, 0 general register, 1 incoming stack slot, 2 XMM register,
;;; 3 the private frame buffer of register result pieces (the value is its
;;; address), 4 a MEMORY aggregate in the incoming stack arguments (the value
;;; is its address).
;;; `register` is the library register number (general 0..15, XMM 32..47).
;;; `offset` is relative to the first stack argument (entry rsp + 8).
(defstruct Parameter
  [(reference i32)
   (kind i32)
   (register i32)
   (offset i64)
   (size i32)])

(defn absent [] (-> Parameter)
  (Parameter :reference 0 :kind -1 :register -1 :offset -1 :size 0))

;;; The calling-convention number in a prototype's flags: 0 (default) and 8
;;; (System V) are this backend's convention.
(defn convention? [(flags u8)] (-> bool)
  (or (= (& flags 15) 0) (= (& flags 15) 8)))

;;; Groups and MEMORY records of validated prototype `bytes`, in order.
(defn records! [(bytes (slice u8))
                (descriptors (mut (ArrayList groups/Group)))
                (memory (mut (ArrayList groups/Memory)))] (-> void)
  (for [i 0 (groups/count bytes)]
    (if (groups/memory? bytes i)
        (push! (mut memory) (groups/memory-at bytes i))
        (push! (mut descriptors) (groups/at bytes i)))))

;;; One Parameter per PARAM projection of `entry`. Requires structural
;;; verification. Without a declared prototype every preceding parameter must
;;; have a PARAM projection, or positions cannot be inferred.
(defn build [(graph g/Graph) (entry i32) (allocator (dyn Allocator))]
  (-> (Result (ArrayList Parameter) (slice u8)))
  (let [(mut result) (ArrayList::new [Parameter] allocator)
        (mut parameters) (ArrayList::new [u8] allocator)
        (mut references) (ArrayList::new [i32] allocator)
        (mut descriptors) (ArrayList::new [groups/Group] allocator)
        (mut memory) (ArrayList::new [groups/Memory] allocator)
        declared? (!= (.function-prototype graph) 0)
        (mut return-type) (: 0 u8)
        (mut result-spec) (results/ordinary)
        (mut error) ""
        (mut r) 1]
    (when declared?
      (match (strings/lookup (.strings graph) (.function-prototype graph))
        (None [] (set! error "function prototype string missing"))
        (Some [bytes]
              (cond (not (calls/valid-bytes? bytes))
                      (set! error "malformed function prototype")
                    (not (convention? (get bytes 0)))
                      (set! error "unsupported x86-64 function convention")
                    :else
                      (do
                        (set! return-type (get bytes 1))
                        (set! result-spec (results/decode bytes))
                        (records! bytes (mut descriptors) (mut memory))
                        (for [i 3 (+ 3 (cast i64 (get bytes 2)))]
                          (push! (mut parameters) (get bytes i))
                          (push! (mut references) 0)))))))
    (while (and (= error "") (< r (len (.instructions graph))))
      (let [node (get (.instructions graph) r)
            count (get (.arities graph) r)]
        (when (= (n/opcode node) 71)
          (let [ordinal (cast i64 (.op3 node))]
            (if (or (!= (.op1 node) entry)
                    (< ordinal 0)
                    (and declared? (>= ordinal (len parameters)))
                    (and (not declared?) (>= ordinal (len (.instructions graph)))))
                (set! error "invalid parameter region or ordinal")
                (do
                  (while (<= (len parameters) ordinal)
                    (push! (mut parameters) 0)
                    (push! (mut references) 0))
                  (when (!= (get references ordinal) 0)
                    (set! error "duplicate parameter projection"))
                  (if declared?
                      (when (!= (get parameters ordinal) (n/type-id node))
                        (set! error "parameter type disagrees with function prototype"))
                      (set! (mut parameters) ordinal (n/type-id node)))
                  (set! (mut references) ordinal (cast i32 r))))))
        (when (and declared? (= (n/opcode node) 120) (!= (n/type-id node) return-type))
          (set! error "return type disagrees with function prototype"))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    (for ty parameters
      (when (and (= error "") (or (= ty 0) (not (types/valid? (cast i32 ty)))))
        (set! error "incomplete parameter types; declare a function prototype")))
    (when (= error "")
      (match (arguments/plan-result (slice parameters) (len parameters) false
                                    (slice descriptors) (slice memory) result-spec allocator)
        (Err [message] (set! error message))
        (Ok [layout]
            (let [(mut layout) layout]
              (for [i 0 (len (.parts layout))]
                (let [part (get (.parts layout) i)
                      reference (get references i)
                      register (.register part)]
                  (when (> reference 0)
                    (push! (mut result)
                           (Parameter
                             :reference reference
                             :kind (cond (= register -2) 3
                                         (> (.memory part) 0) 4
                                         (< register 0) 1
                                         (registers/simd? register) 2
                                         :else 0)
                             :register (if (< register 0) (: -1 i32) register)
                             :offset (.offset part)
                             :size (.size part))))))
              (arguments/release! (mut layout))))))
    (free! (mut parameters))
    (free! (mut references))
    (free! (mut descriptors))
    (free! (mut memory))
    (if (= error "") (Ok result) (do (free! (mut result)) (Err error)))))

;;; The declared function's result role; ordinary without a prototype.
(defn result-role [(graph g/Graph)] (-> (Result results/Spec (slice u8)))
  (calls/function-result graph))

;;; Bytes of stack arguments the declared function receives above its return
;;; address: the part of its caller's frame a tail call may overwrite with the
;;; stack arguments of its own callee. Zero without a declared prototype and
;;; for a variadic one, whose caller's area this signature does not bound.
(defn stack-bytes [(graph g/Graph) (allocator (dyn Allocator))] (-> (Result i64 (slice u8)))
  (if (= (.function-prototype graph) 0)
      (Ok 0)
      (match (strings/lookup (.strings graph) (.function-prototype graph))
        (None [] (Err "function prototype string missing"))
        (Some [bytes]
              (cond (not (calls/valid-bytes? bytes)) (Err "malformed function prototype")
                    (!= (& (get bytes 0) 16) 0) (Ok 0)
                    :else
                      (let [(mut parameters) (ArrayList::new [u8] allocator)
                            (mut descriptors) (ArrayList::new [groups/Group] allocator)
                            (mut memory) (ArrayList::new [groups/Memory] allocator)]
                        (for [i 3 (+ 3 (cast i64 (get bytes 2)))]
                          (push! (mut parameters) (get bytes i)))
                        (records! bytes (mut descriptors) (mut memory))
                        (let [result
                                (match (arguments/plan-result (slice parameters) (len parameters)
                                                              false (slice descriptors)
                                                              (slice memory) (results/decode bytes)
                                                              allocator)
                                  (Err [message] (Err [i64 (slice u8)] message))
                                  (Ok [layout]
                                      (let [(mut layout) layout
                                            size (.stack layout)]
                                        (arguments/release! (mut layout))
                                        (Ok size))))]
                          (free! (mut parameters))
                          (free! (mut descriptors))
                          (free! (mut memory))
                          result)))))))

;;; Make parameter `parameter` available in its allocated register at its PARAM
;;; definition (`position + 1`). `frame-size` is the rsp adjustment of the
;;; prologue and `base` the frame base, which together locate the first
;;; stack argument (stogir.x64.frame-address/parameter!); `result-slot` is
;;; the logical frame offset of the register-piece result buffer (kind 3
;;; only). Register parameters are already in place.
(defn emit-entry-with-locations! [(out (mut code/Buffer))
                                  (graph g/Graph)
                                  (parts locations/View)
                                  (parameter Parameter)
                                  (position i64)
                                  (frame-size i64)
                                  (base frame/Base)
                                  (result-slot i64)] (-> (Result i32 (slice u8)))
  (let [begin (len (.text out))
        ty (value/type-of graph (.reference parameter))
        kind (.kind parameter)]
    (cond (or (= kind 0) (= kind 2)) (Ok 0)
          (or (< kind 0) (> kind 4)) (Err "invalid x86-64 parameter kind")
          (and (= kind 3) (< result-slot 0)) (Err "x86-64 result buffer has no frame slot")
          :else
            (match (locations/resolve parts (.reference parameter) (+ position 1))
              (Err [message] (Err message))
              (Ok [location]
                  (let [destination (cast i32 (.value location))]
                    (if (or (!= (.kind location) 0) (not (registers/allocatable? ty destination)))
                        (Err "stack parameter definition requires a register of its class")
                        (match
                          (if (= kind 3)
                              (match (frame/slot base result-slot)
                                (Err [message] (Err [i64 (slice u8)] message))
                                (Ok [buffer] (encode/lea (mut (.text out)) 64 destination buffer)))
                              ; The anchor of an over-aligned frame goes through
                              ; the destination itself, or r10 for an XMM one.
                              (match (frame/parameter! (mut (.text out)) base frame-size
                                                       (.offset parameter)
                                                       (if (registers/gpr? destination)
                                                           destination
                                                           (: registers/SCRATCH-GPR i32)))
                                (Err [message] (Err [i64 (slice u8)] message))
                                (Ok [incoming]
                                    (cond (= kind 4)
                                            (encode/lea (mut (.text out)) 64 destination incoming)
                                          (types/integer? ty)
                                            (encode/mov-rm (mut (.text out))
                                                           (value/operation-bits ty)
                                                           destination incoming)
                                          (types/floating? ty)
                                            (encode/sse-mov-rm (mut (.text out))
                                                               (value/float-move ty)
                                                               destination incoming)
                                          :else (Err "x86-64 backend: vector stack parameters are not implemented (vector family)")))))
                          (Err [message] (Err message))
                          (Ok [_] (Ok (cast i32 (- (len (.text out)) begin))))))))))))
