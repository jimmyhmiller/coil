;;; PLACEHOLDER for the x86-64 backend's private-leaf context.
;;;
;;; Every function here has the signature of its `stogir.a64.private-leaf`
;;; namesake and fails with "x86-64 backend: NAME is not implemented yet": an
;;; `Err` where the signature has a Result, a panic where it has none. The real
;;; backend replaces this file; `stogir.native.private-leaf` forwards to it when
;;; the program is compiled for x86-64.
;;;
;;; The types and the option switches on `Context` are shared with AArch64
;;; through `stogir.native.private-types`, so they are not repeated here.
(module stogir.x64.private-leaf)
(export context-create context-release! register! register-as! freeze! confirm-publication! seal-module! module-valid? binding verify-publication)
(import "stogir.native.private-types" :use [Context Publication])
(import "stogir.image" :as image)
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Option Result Ok Err])

(defn context-create [(a (dyn Allocator))] (-> Context)
  (panic "x86-64 backend: context-create is not implemented yet"))

(defn context-release! [(context (mut Context))] (-> void)
  (panic "x86-64 backend: context-release! is not implemented yet"))

(defn register-as! [(context (mut Context)) (name (slice u8)) (source image/Image)
                    (symbol i32) (size i64) (signature (slice u8))]
  (-> (Result bool (slice u8)))
  (Err "x86-64 backend: register-as! is not implemented yet"))

(defn register! [(context (mut Context)) (source image/Image) (symbol i32)
                 (size i64) (signature (slice u8))] (-> (Result bool (slice u8)))
  (Err "x86-64 backend: register! is not implemented yet"))

(defn freeze! [(context (mut Context))] (-> void)
  (panic "x86-64 backend: freeze! is not implemented yet"))

(defn confirm-publication! [(context (mut Context)) (scope usize) (name (slice u8))
                            (symbol i64) (binding u8) (text (slice u8))]
  (-> (Result bool (slice u8)))
  (Err "x86-64 backend: confirm-publication! is not implemented yet"))

(defn seal-module! [(context (mut Context)) (scope usize)] (-> (Option Publication))
  (panic "x86-64 backend: seal-module! is not implemented yet"))

(defn module-valid? [(context Context) (publication Publication) (scope usize)] (-> bool)
  (panic "x86-64 backend: module-valid? is not implemented yet"))

(defn binding [(context Context) (publication Publication) (scope usize) (name (slice u8))]
  (-> (Option i64))
  (panic "x86-64 backend: binding is not implemented yet"))

(defn verify-publication [(context Context) (publication Publication) (scope usize)
                          (name (slice u8)) (symbol i64) (kind u8) (text (slice u8))]
  (-> bool)
  (panic "x86-64 backend: verify-publication is not implemented yet"))
