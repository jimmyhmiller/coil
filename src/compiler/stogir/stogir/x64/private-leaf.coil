;;; The x86-64 private-leaf context: module-private leaf functions whose
;;; direct callers clobber only what the leaf really writes.
;;;
;;; The context, its registry and the publication protocol are the ones of
;;; stogir.a64.private-leaf, whose state types and target-neutral functions
;;; (create/release of the context, freezing, publication confirmation,
;;; sealing, bindings) are used here as they are. What is x86-64's own:
;;;
;;;   * A leaf's written-register set is not decoded from its bytes. The
;;;     emitter records it (stogir.x64.code `written`/`calls`) and the image
;;;     carries it (`Image.leaf-effects`, image/LEAF-RECORDED). `create`
;;;     accepts only an image whose whole text is that one recorded function:
;;;     no call, no tail jump, no relocation, no data in text.
;;;   * The clobber set of a direct CALL to a registered leaf with the same
;;;     ABI prototype is (the leaf's writes + the registers this call's own
;;;     setup writes) within the caller-saved allocatable registers. Setup
;;;     writes the argument registers of the call and, for a variadic call,
;;;     rax. Tail calls, indirect calls and calls to unknown names keep the
;;;     full System V set.
;;;   * A bound leaf is appended to the caller's image at a 16-byte boundary,
;;;     padded with int3.
(module stogir.x64.private-leaf)
(export context-create context-release! register! register-as! freeze! confirm-publication! seal-module! module-valid? binding verify-publication create call-clobbers full-clobbers validate-references bind-image!)
(import "stogir.a64.private-leaf" :as shared)
(import "stogir.native.private-types" :use [Context Publication active?])
(import "stogir.x64.call-abi" :as abi)
(import "stogir.x64.code" :as code)
(import "stogir.x64.incoming" :as incoming)
(import "stogir.x64.registers" :as registers)
(import "stogir.image" :as image)
(import "stogir.text-data" :as text-data)
(import "stogir.prototype-bytes" :as prototype)
(import "stogir.bytes" :as bytes)
(import "stogir.graph" :as graph)
(import "stogir.node" :as node)
(import "stogir.calls" :as calls)
(import "stogir.symbols" :as symbols)
(import "stogir.strings" :as strings)
(import "coil.slice" :use [subslice])
(import "coil.alloc" :use [Allocator])
(import "coil.primitive" :as p)
(import "coil.result" :use [Option Some None Result Ok Err])

;;; Every allocatable register a System V call may overwrite: rax rcx rdx rsi
;;; rdi r8 r9 and xmm0..xmm13 (r10, r11, xmm14 and xmm15 are never allocated).
(defn full-clobbers [] (-> u64)
  (| (& (registers/caller-gpr-mask) (registers/gpr-mask))
     (& (registers/caller-simd-mask) (registers/simd-mask))))

(defn context-create [(a (dyn Allocator))] (-> Context)
  (shared/context-create a))

(defn context-release! [(context (mut Context))] (-> void)
  (shared/context-release! (mut context)))

;;; Snapshot the leaf that is the whole text of `source`, defined by local text
;;; symbol `symbol` at offset 0 with `size` bytes. None when the image does
;;; not carry the emitter's leaf record for exactly that function.
(defn create [(source image/Image) (symbol i32) (size i64)
              (signature (slice u8)) (a (dyn Allocator))] (-> (Option shared/Frozen))
  (if (or (< symbol 0) (>= (cast i64 symbol) (len (.symbols source)))
          (!= (.machine source) image/X86-64)
          (not (image/valid-alignments? source))
          (not (prototype/valid-bytes? signature))
          (not (incoming/convention? (get signature 0)))
          (= (& (.leaf-effects source) image/LEAF-RECORDED) 0))
      (None)
      (let [definition (get (.symbols source) (cast i64 symbol))
            name-start (.name definition)
            name-size (.length definition)
            (mut valid) true]
        (when (or (.global? definition) (!= (.section definition) 1)
                  (!= (.offset definition) 0)
                  (<= size 0) (!= size (len (.text source)))
                  (< name-start 0) (> name-start (len (.names source)))
                  (<= name-size 0) (> name-size (- (len (.names source)) name-start)))
          (set! valid false))
        (match (text-data/validate (.text-data source) (len (.text source)))
          (Err [_] (set! valid false))
          (Ok [_] 0))
        ; The record covers a function without relocations or data in text.
        (for relocation (.relocations source)
          (when (= (.section relocation) 1) (set! valid false)))
        (when (> (len (.text-data source)) 0) (set! valid false))
        (if (not valid)
            (None)
            (let [name (subslice (slice (.names source)) name-start (+ name-start name-size))]
              (for byte name (when (= byte 0) (set! valid false)))
              (if (not valid)
                  (None)
                  (Some (shared/own name signature (slice (.text source))
                                    (& (.leaf-effects source) (- image/LEAF-RECORDED 1))
                                    a))))))))

(defn register-as! [(context (mut Context)) (name (slice u8)) (source image/Image)
                    (symbol i32) (size i64) (signature (slice u8))]
  (-> (Result bool (slice u8)))
  (if (not (active? context))
      (Err "private context is released")
      (let [s (p/cast (ptr shared/ContextState) (.state context))]
        (cond
          (.frozen s) (Err "private context is frozen")
          (not (symbols/valid-name? name)) (Err "invalid private binding name")
          (>= (shared/find-leaf s name) 0) (Err "duplicate private leaf name")
          :else
            (match (create source symbol size signature (.a s))
              (None [] (Ok false))
              (Some [leaf]
                    (let [(mut leaf) leaf
                          body (p/cast (ptr shared/State) (.state leaf))
                          hash (image/hash-name name)
                          head (match (get (.heads s) hash) (None [] (: -1 i32)) (Some [i] i))
                          index (len (.leaves s))]
                      (if (> index 2147483647)
                          (do (shared/release! (mut leaf))
                              (Err "private leaf index space exhausted"))
                          (do
                            (unless (shared/same? name (slice (.name body)))
                              (clear! (mut (.name body)))
                              (for byte name (push! (mut (.name body)) byte)))
                            (push! (mut (.next s)) head)
                            (push! (mut (.targets s)) (: -1 i64))
                            (push! (mut (.leaves s)) leaf)
                            (set! (mut (.heads s)) hash (cast i32 index))
                            (Ok true))))))))))

(defn register! [(context (mut Context)) (source image/Image) (symbol i32)
                 (size i64) (signature (slice u8))] (-> (Result bool (slice u8)))
  (cond (not (active? context)) (Err "private context is released")
        (.frozen (p/cast (ptr shared/ContextState) (.state context)))
          (Err "private context is frozen")
        :else
          (match (shared/source-name source symbol)
            (None [] (Ok false))
            (Some [name] (register-as! (mut context) name source symbol size signature)))))

(defn freeze! [(context (mut Context))] (-> void)
  (shared/freeze! (mut context)))

(defn confirm-publication! [(context (mut Context)) (scope usize) (name (slice u8))
                            (symbol i64) (binding u8) (text (slice u8))]
  (-> (Result bool (slice u8)))
  (shared/confirm-publication! (mut context) scope name symbol binding text))

(defn seal-module! [(context (mut Context)) (scope usize)] (-> (Option Publication))
  (shared/seal-module! (mut context) scope))

(defn module-valid? [(context Context) (publication Publication) (scope usize)] (-> bool)
  (shared/module-valid? context publication scope))

(defn binding [(context Context) (publication Publication) (scope usize) (name (slice u8))]
  (-> (Option i64))
  (shared/binding context publication scope name))

(defn verify-publication [(context Context) (publication Publication) (scope usize)
                          (name (slice u8)) (symbol i64) (kind u8) (text (slice u8))]
  (-> bool)
  (shared/verify-publication context publication scope name symbol kind text))

;;; The leaf's recorded writes when `name` and `signature` are exactly its
;;; own name and ABI prototype.
(defn leaf-writes [(leaf shared/Frozen) (name (slice u8)) (signature (slice u8))]
  (-> (Option u64))
  (if (= (p/cast usize (.state leaf)) 0)
      (None)
      (let [s (p/cast (ptr shared/State) (.state leaf))]
        (if (and (shared/same? name (slice (.name s)))
                 (prototype/valid-bytes? signature)
                 (shared/same-abi? signature (slice (.prototype s))))
            (Some (.writes s))
            (None)))))

;;; The registers a call at `reference` overwrites, within the allocatable
;;; caller-saved set: the full set, or the narrowed one for an ordinary
;;; (`mode` 0) direct declared CALL of a leaf registered in the frozen
;;; `context` under the callee's name with the call's ABI prototype.
;;; `arguments` is the call's layout. The image entry point must bind-image!
;;; (or publish through a sealed module) before the image is exposed.
(defn call-clobbers [(context Context) (source graph/Graph) (reference i32) (mode i32)
                     (arguments (slice abi/Argument))] (-> u64)
  (let [full (full-clobbers)
        (mut mask) full]
    (when (and (!= (p/cast usize (.state context)) 0) (= mode 0))
      (let [s (p/cast (ptr shared/ContextState) (.state context))
            call (get (.instructions source) (cast i64 reference))]
        (when (and (.frozen s) (= (node/opcode call) 79) (< (.op2 call) 0))
          (match (graph/lookup source (.op2 call))
            (None [] 0)
            (Some [target]
                  (when (and (= (node/opcode target) 74) (symbols/validate source target))
                    (match (calls/validate-call source reference)
                      (Err [_] 0)
                      (Ok [signature]
                          (when (> (.id signature) 0)
                            (match (strings/lookup (.strings source)
                                                   (cast i32 (node/constant-bits target)))
                              (None [] 0)
                              (Some [name]
                                    (let [index (shared/find-leaf s name)]
                                      (when (>= index 0)
                                        (match (strings/lookup (.strings source) (.id signature))
                                          (None [] 0)
                                          (Some [bytes]
                                                (match (leaf-writes (get (.leaves s) (cast i64 index))
                                                                    name bytes)
                                                  (None [] 0)
                                                  (Some [writes]
                                                        (let [(mut setup)
                                                                (if (!= (& (.flags signature) 16) 0)
                                                                    (: 1 u64)
                                                                    0)]
                                                          (for argument arguments
                                                            (when (>= (.register argument) 0)
                                                              (set! setup
                                                                    (| setup
                                                                       (<< (: 1 u64)
                                                                           (cast u64 (.register argument)))))))
                                                          (set! mask (& (| writes setup) full))))))))))))))))))))
    mask))

;;; Validate the references actually emitted: a named function the context
;;; owns may only be referenced with a declared prototype of the leaf's ABI.
;;; Unknown names stay ordinary external references.
(defn validate-references [(context Context) (source graph/Graph)
                           (references (slice code/Reference))]
  (-> (Result i32 (slice u8)))
  (if (not (active? context))
      (Ok 0)
      (let [s (p/cast (ptr shared/ContextState) (.state context))
            (mut count) (: 0 i32)
            (mut error) ""]
        (if (not (.frozen s))
            (Err "private context must be frozen before emission")
            (do
              (for pending references
                (match (if (code/runtime? pending)
                           ; A runtime routine is never a private leaf.
                           (graph/lookup source 0)
                           (graph/lookup source (.target pending)))
                  (None [] (unless (code/runtime? pending)
                             (set! error "private reference target missing")))
                  (Some [target]
                        (when (= (node/opcode target) 74)
                          (match (strings/lookup (.strings source)
                                                 (cast i32 (node/constant-bits target)))
                            (None [] (set! error "private function name missing"))
                            (Some [name]
                                  (let [index (shared/find-leaf s name)]
                                    (when (and (>= index 0) (> (node/auxiliary target) 0))
                                      (match (strings/lookup (.strings source)
                                                             (cast i32 (node/auxiliary target)))
                                        (None [] (set! error "private function requires a declared prototype"))
                                        (Some [signature]
                                              (match (leaf-writes (get (.leaves s) (cast i64 index))
                                                                  name signature)
                                                (None [] (set! error "private function ABI prototype mismatch"))
                                                (Some [_] (set! count (+ count 1))))))))))))))
              (if (= error "") (Ok count) (Err error)))))))

;;; Internalize the undefined declaration `id` and publish the leaf's exact
;;; bytes at the next 16-byte boundary of `output`'s text.
(defn install! [(leaf shared/Frozen) (output (mut image/Image)) (id i32)]
  (-> (Result i32 (slice u8)))
  (let [s (p/cast (ptr shared/State) (.state leaf))
        declaration (get (.symbols output) (cast i64 id))
        before (len (.text output))
        size (len (.text s))
        pad (% (- 16 (% before 16)) 16)]
    (if (or (!= (.section declaration) 0) (not (.global? declaration))
            (> before (- (- 0x7FFFFFFFFFFFFFFF size) pad)))
        (Err "private binding conflicts with an existing definition or text limit")
        (do
          (let [symbol (elem (mut (.symbols output)) (cast i64 id))]
            (set! (.section symbol) 1)
            (set! (.offset symbol) (+ before pad))
            (set! (.global? symbol) false))
          (for [i 0 pad] (push! (mut (.text output)) (: 0xCC u8)))
          (if (bytes/append-slice! (mut (.text output)) (slice (.text s)))
              (Ok id)
              (Err "private binding text append failed"))))))

;;; Bind every undefined symbol of `output` that names a registered leaf to a
;;; private copy of that leaf appended to the image.
(defn bind-image! [(context Context) (output (mut image/Image))]
  (-> (Result i32 (slice u8)))
  (if (= (p/cast usize (.state context)) 0)
      (Ok 0)
      (let [s (p/cast (ptr shared/ContextState) (.state context))
            (mut count) (: 0 i32)
            (mut error) ""]
        (cond (not (.frozen s)) (Err "private context must be frozen before binding")
              (!= (.machine output) image/X86-64) (Err "private binding requires an x86-64 image")
              :else
                (do
                  (for [i 0 (len (.symbols output))]
                    (when (= error "")
                      (let [symbol (get (.symbols output) i)
                            name (subslice (slice (.names output)) (.name symbol)
                                           (+ (.name symbol) (.length symbol)))
                            index (shared/find-leaf s name)]
                        (when (>= index 0)
                          (match (install! (get (.leaves s) (cast i64 index)) (mut output)
                                           (cast i32 i))
                            (Err [message] (set! error message))
                            (Ok [_]
                                ; The image is no longer one recorded function.
                                (set! (.leaf-effects output) 0)
                                (set! count (+ count 1))))))))
                  (if (= error "") (Ok count) (Err error)))))))
