;;; x86-64 (System V) register numbering shared by the whole x86 backend.
;;; General registers 0..15 are the hardware numbers; XMM registers are 32..47
;;; (library register = 32 + hardware number), disjoint as on AArch64.
(module stogir.x64.registers)
(import "stogir.types" :as types)

(const RAX 0)

(const RCX 1)

(const RDX 2)

(const RBX 3)

(const RSP 4)

(const RBP 5)

(const RSI 6)

(const RDI 7)

(const R8 8)

(const R9 9)

(const R10 10)

(const R11 11)

(const R12 12)

(const R13 13)

(const R14 14)

(const R15 15)

(const XMM0 32)

(const XMM1 33)

(const XMM14 46)

(const XMM15 47)

;;; r10 and r11 are never allocated: instruction selection and move resolution
;;; may clobber them freely. Both are caller-saved and carry no argument.
(const SCRATCH-GPR R10)

(const SCRATCH-GPR-2 R11)

;;; xmm14 and xmm15 are the reserved floating/vector scratches.
(const SCRATCH-SIMD XMM14)

(const SCRATCH-SIMD-2 XMM15)

(const GPR-ARGUMENTS 6)

(const SIMD-ARGUMENTS 8)

(defn gpr? [(register i32)] (-> bool)
  (and (>= register 0) (< register 16)))

(defn simd? [(register i32)] (-> bool)
  (and (>= register 32) (< register 48)))

;;; Hardware number (0..15) of a general or XMM register, -1 for anything else.
(defn physical [(register i32)] (-> i32)
  (if (gpr? register)
      register
      (if (simd? register) (- register 32) -1)))

;;; The XMM register with hardware number `number`, -1 when out of range.
(defn xmm [(number i32)] (-> i32)
  (if (and (>= number 0) (< number 16)) (+ number 32) -1))

;;; System V integer argument order: rdi rsi rdx rcx r8 r9. -1 past the sixth.
(defn gpr-argument [(ordinal i32)] (-> i32)
  (case ordinal
    0 RDI
    1 RSI
    2 RDX
    3 RCX
    4 R8
    5 R9
    -1))

;;; System V floating argument order: xmm0..xmm7. -1 past the eighth.
(defn simd-argument [(ordinal i32)] (-> i32)
  (if (and (>= ordinal 0) (< ordinal SIMD-ARGUMENTS)) (+ ordinal 32) -1))

;;; rax rcx rdx rsi rdi r8 r9 r10 r11 are volatile across a System V call.
(defn caller-gpr-mask [] (-> u64)
  0xFC7)

;;; rbx rbp r12 r13 r14 r15 are preserved by the callee.
(defn callee-gpr-mask [] (-> u64)
  0xF028)

;;; Every XMM register is volatile across a System V call.
(defn caller-simd-mask [] (-> u64)
  0xFFFF00000000)

;;; Ordinary call setup writes the six integer argument registers, rax (the
;;; result and the variadic vector count in al) and rdx (the second result).
;;; Copy/normalization helpers otherwise use the reserved r10/r11 and
;;; xmm14/xmm15. Keep the whole bank even when a signature needs less.
(defn call-setup-gpr-mask [] (-> u64)
  0x3C7)

;;; Allocatable general registers: everything but rsp, rbp and the r10/r11
;;; scratches.
(defn gpr-mask [] (-> u64)
  0xF3CF)

;;; Allocatable XMM registers: xmm0..xmm13 (xmm14/xmm15 are scratches).
(defn simd-mask [] (-> u64)
  0x3FFF00000000)

(defn simd-type? [(ty i32)] (-> bool)
  (or (types/floating? ty) (types/short-vector? ty 8)))

(defn class-mask [(ty i32)] (-> u64)
  (if (types/integer? ty)
      (gpr-mask)
      (if (simd-type? ty) (simd-mask) (: 0 u64))))

(defn allocatable? [(ty i32) (register i32)] (-> bool)
  (and (>= register 0)
       (< register 64)
       (!= (& (class-mask ty) (<< (: 1 u64) (cast u64 register))) 0)))
