;;; What the x86-64 constraints builder tells the allocator bridge.
;;;
;;; The constraint vocabulary is the neutral one (stogir.constraints): a use
;;; at position 2i (an operand of scheduled node i) or 2i+1 (a definition) of
;;; kind 0 (any location), 1 (a register) or 2 (one fixed register). On top
;;; of it x86-64 needs the items below, collected in one `Set` so that every
;;; operation family adds them through this module and never edits the
;;; allocator bridge (stogir.x64.allocate):
;;;
;;;   clobbers          registers an instruction overwrites: nothing else may
;;;                     live in `register` over [start, end). Even start =
;;;                     operands may not be there either; start = position + 1
;;;                     covers only values live across the instruction and its
;;;                     result.
;;;   preferences       advisory: the value would like this register.
;;;   hints             advisory: the value would like the register its
;;;                     `source` value had (two-address results name operand 1).
;;;   definition-moves  odd positions at which the emitter itself lowers
;;;                     register transfers of the allocator (calls).
;;;   locals            frame objects a node owns (owner reference, size,
;;;                     alignment), found at emission through the frame.
;;;   outgoing-size     bytes of outgoing call area at the bottom of the frame.
;;;   alignment         the largest stack alignment any node needs (16 default).
;;;                     A frame object's own alignment (its Local) raises the
;;;                     frame's as well; above 16 the frame is anchored.
;;;   anchored          the frame needs rbp as its base (dynamic stack,
;;;                     FRAME_ADDR).
;;;   calls             the function executes a call instruction: it needs a
;;;                     frame even without contents, so that rsp is 16-byte
;;;                     aligned at the call.
;;;   floating          some scheduled value is of a floating or vector type
;;;                     (set by the constraints builder before any family
;;;                     hook runs): only then do calls clobber the XMM bank.
;;;   private           the private-leaf context of this compilation (inactive
;;;                     by default); the call family narrows the clobbers of
;;;                     direct calls to its leaves.
(module stogir.x64.uses)
(import "stogir.constraints" :as c)
(import "stogir.x64.incoming" :as incoming)
(import "stogir.native.private-types" :as private)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])

(defstruct Value
  [(uses (ArrayList c/Use)) (parameter incoming/Parameter) (rematerialized bool)])

;;; `except` > 0: the clobber does not apply when that value has a live range
;;; (it is then the instruction's own result, defined in `register`).
(defstruct Clobber [(register i32) (start i64) (end i64) (except i32)])

(defstruct Preference [(reference i32) (register i32)])

(defstruct Hint [(reference i32) (source i32)])

(defstruct Local [(owner i32) (size i64) (alignment i64)])

(defstruct Set
  [(values (ArrayList Value))
   (clobbers (ArrayList Clobber))
   (preferences (ArrayList Preference))
   (hints (ArrayList Hint))
   (definition-moves (ArrayList i64))
   (locals (ArrayList Local))
   (outgoing-size i64)
   (alignment i64)
   (anchored bool)
   (calls bool)
   (floating bool)
   (private private/Context)])

(defn create [(allocator (dyn Allocator))] (-> Set)
  (Set
    :values (ArrayList::new [Value] allocator)
    :clobbers (ArrayList::new [Clobber] allocator)
    :preferences (ArrayList::new [Preference] allocator)
    :hints (ArrayList::new [Hint] allocator)
    :definition-moves (ArrayList::new [i64] allocator)
    :locals (ArrayList::new [Local] allocator)
    :outgoing-size 0
    :alignment 16
    :anchored false
    :calls false
    :floating false
    :private (private/no-context)))

(defn release! [(set (mut Set))] (-> void)
  (for [i 0 (len (.values set))]
    (free! (mut (.uses (elem (mut (.values set)) i)))))
  (free! (mut (.values set)))
  (free! (mut (.clobbers set)))
  (free! (mut (.preferences set)))
  (free! (mut (.hints set)))
  (free! (mut (.definition-moves set)))
  (free! (mut (.locals set))))

;;; Add one constraint on value `reference`. Constants (references below one)
;;; need none. False when it conflicts with a fixed register already required
;;; at `position`, or when a rematerialized value is given a fixed register.
(defn add! [(set (mut Set)) (reference i32) (position i64) (kind i32) (register i32)]
  (-> bool)
  (if (<= reference 0)
      true
      (let [value (elem (mut (.values set)) (cast i64 reference))]
        (if (.rematerialized value)
            (!= kind 2)
            (c/add! (mut (.uses value)) position kind register)))))

;;; Operand `reference` of the node at `position` must be in a register.
(defn use! [(set (mut Set)) (reference i32) (position i64)] (-> bool)
  (add! (mut set) reference position 1 -1))

;;; Operand `reference` may be read from a register or its spill slot.
(defn use-anywhere! [(set (mut Set)) (reference i32) (position i64)] (-> bool)
  (add! (mut set) reference position 0 -1))

;;; Operand `reference` must be in `register` when the node at `position` runs.
;;; Only safe for an operand that dies at this node: one that lives on may
;;; have to leave the register at the odd definition position, which the
;;; allocator cannot do (docs/X86_PORT.md, "Fixed registers"). Prefer
;;; `clobber!` over [position, position + 1) and a copy in the emitter.
(defn use-fixed! [(set (mut Set)) (reference i32) (position i64) (register i32)] (-> bool)
  (add! (mut set) reference position 2 register))

;;; The node at `position` defines `reference` in a register.
(defn define! [(set (mut Set)) (reference i32) (position i64)] (-> bool)
  (add! (mut set) reference (+ position 1) 1 -1))

;;; The node at `position` defines `reference` in `register`.
(defn define-fixed! [(set (mut Set)) (reference i32) (position i64) (register i32)] (-> bool)
  (add! (mut set) reference (+ position 1) 2 register))

;;; Nothing else may live in `register` over [start, end).
(defn clobber! [(set (mut Set)) (register i32) (start i64) (end i64)] (-> void)
  (push! (mut (.clobbers set)) (Clobber :register register :start start :end end :except 0)))

;;; As clobber!, unless value `except` is live: an instruction's result in a
;;; fixed register (uses/define-fixed!) occupies that register itself when it
;;; is used, and leaves it clobbered when it is dead.
(defn clobber-unless-live! [(set (mut Set)) (register i32) (start i64) (end i64) (except i32)]
  (-> void)
  (push! (mut (.clobbers set))
         (Clobber :register register :start start :end end :except except)))

(defn prefer! [(set (mut Set)) (reference i32) (register i32)] (-> void)
  (when (> reference 0)
    (push! (mut (.preferences set)) (Preference :reference reference :register register))))

;;; `reference` would like the register `source` held (both instructions).
(defn hint! [(set (mut Set)) (reference i32) (source i32)] (-> void)
  (when (and (> reference 0) (> source 0) (!= reference source))
    (push! (mut (.hints set)) (Hint :reference reference :source source))))
