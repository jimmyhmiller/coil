;;; Operation families of the x86-64 backend and the dispatch to them.
;;;
;;; The core (integer values, compares, branches, PHIs, parameters, returns)
;;; is handled by stogir.x64.match, stogir.x64.constraints and
;;; stogir.x64.function themselves. Every other node belongs to one family,
;;; and each family is one module with three entry points (`select!`,
;;; `constrain!`, `emit!`). This module is the only place that names them:
;;; `of` classifies a node, and the three dispatchers forward to its family.
;;; Adding an operation to a family never touches the core; see
;;; docs/X86_FAMILIES.md.
(module stogir.x64.families)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.matched-uses" :as machine)
(import "stogir.schedule" :as schedule)
(import "stogir.atomic" :as atomic-ops)
(import "stogir.checked" :as checked-ops)
(import "stogir.locals" :as locals-ops)
(import "stogir.stack" :as stack-ops)
(import "stogir.x64.code" :as code)
(import "stogir.x64.context" :as context)
(import "stogir.x64.plan" :as plan)
(import "stogir.x64.uses" :as uses)
(import "stogir.x64.value" :as value)
(import "stogir.x64.atomic" :as atomic)
(import "stogir.x64.bits" :as bits)
(import "stogir.x64.call" :as call)
(import "stogir.x64.checked" :as checked)
(import "stogir.x64.floating" :as floating)
(import "stogir.x64.float-memory" :as float-memory)
(import "stogir.x64.locals" :as locals)
(import "stogir.x64.memory" :as memory)
(import "stogir.x64.stack" :as stack)
(import "stogir.x64.vector" :as vector)
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

;;; Handled by the matcher, the constraints builder and the driver directly.
(const CORE 0)

(const MEMORY 1)

(const LOCALS 2)

(const STACK 3)

(const CALL 4)

(const FLOATING 5)

(const VECTOR 6)

(const ATOMIC 7)

(const CHECKED 8)

;;; SWITCH: dispatched by the driver itself, because its emitter needs the
;;; branch state (stogir.x64.switch/emit!).
(const SWITCH 9)

(const BITS 10)

;;; An opcode no family claims.
(const UNSUPPORTED 11)

(defn type-family [(ty i32)] (-> i32)
  (cond (types/vector? ty) VECTOR
        (types/floating? ty) FLOATING
        :else CORE))

;;; The family of an operand. An integer constant, numeric or named, is an
;;; ordinary operand: stogir.x64.value/constant! rebuilds either kind.
(defn operand-family [(graph g/Graph) (reference i32)] (-> i32)
  (match (g/lookup graph reference)
    (None [] CORE)
    (Some [node]
          (let [ty (cast i32 (n/type-id node))]
            (cond (!= (type-family ty) CORE) (type-family ty)
                  (and (< reference 0) (not (types/integer? ty))) UNSUPPORTED
                  :else CORE)))))

;;; The family that owns scheduled node `reference`.
(defn of [(graph g/Graph) (reference i32)] (-> i32)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        ty (cast i32 (n/type-id node))
        (mut family) (type-family ty)]
    ; A node of an integer or void type still belongs to the floating or
    ; vector family when it reads such a value (compares, FP2INT, EXTRACT).
    (for [j 1 (+ (cast i64 (get (.arities graph) (cast i64 reference))) 1)]
      (when (and (= family CORE) (machine/data-code? (op/operand-code opcode (cast i32 j))))
        (match (g/operand graph reference (cast i32 j))
          (None [] 0)
          (Some [input] (set! family (operand-family graph input))))))
    (cond (atomic-ops/operation? opcode) ATOMIC
          (or (= opcode 79) (= opcode 80) (= opcode 70) (= opcode 40) (= opcode 125)
              (and (>= opcode 97) (<= opcode 100)))
            CALL
          ; Floating LOAD/STORE and floating locals (stogir.x64.float-memory).
          (float-memory/claims? graph reference) FLOATING
          (locals-ops/operation? opcode) LOCALS
          (stack-ops/operation? opcode) STACK
          (or (and (>= opcode 89) (<= opcode 95))) MEMORY
          (or (= opcode 117)) SWITCH
          (!= family CORE) family
          (or (and (>= opcode 61) (<= opcode 64))) VECTOR
          (or (and (>= opcode 37) (<= opcode 39)) (= opcode 24) (= opcode 25)
              (>= opcode 131))
            FLOATING
          (checked-ops/operation? opcode) CHECKED
          (= opcode 44) CHECKED
          (or (= opcode 32) (and (>= opcode 54) (<= opcode 59))) BITS
          (or (op/block-start? opcode)
              (= opcode 114) (= opcode 115) (= opcode 116) (= opcode 120)
              (= opcode 121) (= opcode 96) (= opcode 67) (= opcode 71)
              (= opcode 68) (= opcode 60) (= opcode 31) (= opcode 45)
              (and (>= opcode 14) (<= opcode 23))
              (and (>= opcode 26) (<= opcode 30))
              (and (>= opcode 33) (<= opcode 36))
              (and (>= opcode 46) (<= opcode 53)))
            CORE
          :else UNSUPPORTED)))

(const NO-FAMILY "x86-64 backend: this operation is not implemented by any family; see docs/X86_FAMILIES.md")

(defn select! [(state (mut plan/Matching)) (graph g/Graph) (reference i32) (family i32)]
  (-> (Result i32 (slice u8)))
  (cond
    (= family MEMORY) (memory/select! (mut state) graph reference)
    (= family LOCALS) (locals/select! (mut state) graph reference)
    (= family STACK) (stack/select! (mut state) graph reference)
    (= family CALL) (call/select! (mut state) graph reference)
    (= family FLOATING) (floating/select! (mut state) graph reference)
    (= family VECTOR) (vector/select! (mut state) graph reference)
    (= family ATOMIC) (atomic/select! (mut state) graph reference)
    (= family CHECKED) (checked/select! (mut state) graph reference)
    (= family BITS) (bits/select! (mut state) graph reference)
    :else (Err NO-FAMILY)))

;;; Whole-function selection that needs every tile and the core's comparison
;;; fusion to be final: memory operands (address modes, fused loads,
;;; read-modify-write stores). The matcher calls it once, after its own
;;; fusion and before the machine inputs are built.
(defn fuse! [(state (mut plan/Matching)) (graph g/Graph) (scheduled schedule/Schedule)
             (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (memory/fuse! (mut state) graph scheduled allocator))

;;; Rebuild the machine inputs of nodes whose operands `fuse!` changed. The
;;; matcher calls it on the freshly built plan, before its own patches.
(defn inputs! [(operands (mut machine/Plan)) (state plan/Matching) (graph g/Graph)
               (scheduled schedule/Schedule)] (-> void)
  (memory/inputs! (mut operands) state graph scheduled))

;;; Requirements of a scheduled node that defines no register but is rebuilt
;;; at each use (stogir.matched-uses/rematerialized?): a static frame object
;;; needs its frame slot.
(defn constrain-recipe! [(set (mut uses/Set)) (graph g/Graph) (reference i32)]
  (-> (Result i32 (slice u8)))
  (stack/object! (mut set) graph reference))

(defn constrain! [(set (mut uses/Set)) (graph g/Graph) (matched plan/Plan)
                  (reference i32) (position i64) (family i32)]
  (-> (Result i32 (slice u8)))
  (cond
    (= family MEMORY) (memory/constrain! (mut set) graph matched reference position)
    (= family LOCALS) (locals/constrain! (mut set) graph matched reference position)
    (= family STACK) (stack/constrain! (mut set) graph matched reference position)
    (= family CALL) (call/constrain! (mut set) graph matched reference position)
    (= family FLOATING) (floating/constrain! (mut set) graph matched reference position)
    (= family VECTOR) (vector/constrain! (mut set) graph matched reference position)
    (= family ATOMIC) (atomic/constrain! (mut set) graph matched reference position)
    (= family CHECKED) (checked/constrain! (mut set) graph matched reference position)
    (= family BITS) (bits/constrain! (mut set) graph matched reference position)
    :else (Err NO-FAMILY)))

(defn emit! [(out (mut code/Buffer)) (cx context/Context) (reference i32)
             (position i64) (family i32)] (-> (Result i32 (slice u8)))
  (cond
    (= family MEMORY) (memory/emit! (mut out) cx reference position)
    (= family LOCALS) (locals/emit! (mut out) cx reference position)
    (= family STACK) (stack/emit! (mut out) cx reference position)
    (= family CALL) (call/emit! (mut out) cx reference position)
    (= family FLOATING) (floating/emit! (mut out) cx reference position)
    (= family VECTOR) (vector/emit! (mut out) cx reference position)
    (= family ATOMIC) (atomic/emit! (mut out) cx reference position)
    (= family CHECKED) (checked/emit! (mut out) cx reference position)
    (= family BITS) (bits/emit! (mut out) cx reference position)
    :else (Err NO-FAMILY)))
