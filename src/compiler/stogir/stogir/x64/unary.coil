;;; Integer NOT and NEG.
;;;
;;; Both are two-address: `mov rd, ra; not rd`. NOT of a BOOL flips the low
;;; bit so the value stays 0 or 1 (stogir.fold agrees).
;;;
;;; ABS, BSWAP, CTPOP, CTLZ and CTTZ (stogir.integer-unary) and integer MIN
;;; and MAX are the integer-completeness family (stogir.x64.bits).
(module stogir.x64.unary)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.integer-unary" :as unary)
(import "stogir.x64.code" :as code)
(import "stogir.x64.context" :as context)
(import "stogir.x64.emit" :as emit)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.value" :as value)
(import "coil.result" :use [Result Ok Err Some None])

;;; Whether node `reference` is an integer NOT or NEG.
(defn operation? [(graph g/Graph) (reference i32)] (-> bool)
  (match (g/lookup graph reference)
    (None [] false)
    (Some [node]
          (and (or (= (n/opcode node) 31) (= (n/opcode node) 45))
               (types/integer? (cast i32 (n/type-id node)))))))

(defn emit! [(out (mut code/Buffer)) (cx context/Context) (reference i32) (position i64)]
  (-> (Result i32 (slice u8)))
  (let [node (get (.instructions (.graph cx)) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        ty (cast i32 (n/type-id node))
        bits (value/operation-bits ty)]
    (if (or (not (unary/valid-type? opcode ty))
            (!= (value/type-of (.graph cx) (.op1 node)) ty))
        (Err "invalid x86-64 integer unary instruction")
        (match (emit/destination cx reference position)
          (Err [message] (Err message))
          (Ok [rd]
              (let [(mut error) ""]
                (code/accept-count! (mut error) (emit/into! (mut out) cx (.op1 node) position rd))
                (code/accept! (mut error)
                              (cond (and (= opcode 45) (= ty 1))
                                      (encode/alu-ri (mut (.text out)) encode/XOR 32 rd 1)
                                    (= opcode 45)
                                      (encode/unary-r (mut (.text out)) encode/NOT bits rd)
                                    :else (encode/unary-r (mut (.text out)) encode/NEG bits rd)))
                ; NEG sets ZF and SF by its result (CF by its operand); the
                ; BOOL XOR is an ordinary logic instruction; NOT sets nothing.
                (cond (and (= opcode 45) (= ty 1))
                        (code/note-flags! (mut out) rd 32 code/FLAGS-LOGIC)
                      (= opcode 31) (code/note-flags! (mut out) rd bits code/FLAGS-RESULT)
                      :else 0)
                (if (= error "") (Ok 0) (Err error))))))))
