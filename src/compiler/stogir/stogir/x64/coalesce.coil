;;; Virtual-register joining before allocation on x86-64.
;;;
;;;   * Non-overlapping PHI inputs and results share one allocation identity,
;;;     so most PHI edge copies disappear (the neutral stogir.phi-coalesce).
;;;   * Integer register views share their source's identity (the neutral
;;;     stogir.view-coalesce): COPY, a same-size BITCAST and every TRUNC.
;;;
;;; Why those are views here. A value occupies the low bits of its register
;;; and every higher bit is unspecified (stogir.x64.value), so the low part
;;; of a wider value is already a valid narrower one: TRUNC, like COPY and a
;;; BITCAST between integer types of one size, is emitted as a plain move,
;;; and as nothing when source and result have one register. A conversion
;;; to BOOL is not a view: it canonicalizes to 0 or 1. The source of a view
;;; owns the joined group, so moves and spills of the group have the
;;; source's width. The emitters of the three views likewise move the whole
;;; register when source and result are in different places: the group may
;;; hold a wider value that lives on in the result's register, even behind
;;; a narrow view (a COPY of a TRUNC of a 64-bit value).
;;;
;;; Extensions are never views: SEXT and ZEXT define bits their source
;;; leaves unspecified. COPY and BITCAST of floating and vector values
;;; belong to their families and are not joined here.
(module stogir.x64.coalesce)
(import "stogir.graph" :as g)
(import "stogir.cfg" :as cfg)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.live-ranges" :as ranges)
(import "stogir.phi-coalesce" :as phi)
(import "stogir.view-coalesce" :as views)
(import "stogir.allocation" :as allocation)
(import "stogir.locations" :as locations)
(import "stogir.schedule" :as schedule)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Some None])

;;; Whether scheduled node `reference` is an integer view of its operand.
(defn reusable? [(graph g/Graph) (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (n/opcode node)
        ty (cast i32 (n/type-id node))]
    (and (or (= opcode 68) (= opcode 36) (= opcode 35))
         (> (.op1 node) 0)
         (types/integer? ty)
         (or (= opcode 68) (!= ty 1))
         (match (g/lookup graph (.op1 node))
           (None [] false)
           (Some [source]
                 (let [input (cast i32 (n/type-id source))]
                   (and (types/integer? input)
                        (if (= opcode 35)
                            (< (types/size ty 8) (types/size input 8))
                            (= (types/size ty 8) (types/size input 8))))))))))

;;; The view kinds of every scheduled node (stogir.view-coalesce).
(defn kinds [(graph g/Graph) (scheduled schedule/Schedule) (a (dyn Allocator))]
  (-> (ArrayList u8))
  (let [(mut result) (ArrayList::new [u8] a)]
    (extend-zeroed! (mut result) (len (.instructions graph)))
    (for reference (.nodes scheduled)
      (when (reusable? graph reference)
        (set! (mut result) (cast i64 reference) views/REUSABLE)))
    result))

;;; The allocation owner of graph value `reference`. `parents` is empty when
;;; nothing was joined.
(defn canonical [(parents (ArrayList i32)) (reference i32)] (-> i32)
  (if (= (len parents) 0)
      reference
      (let [(mut result) reference]
        (while (!= (get parents (cast i64 result)) result)
          (set! result (get parents (cast i64 result))))
        result)))

;;; Join PHI groups and views in `parts` (unsplit, unassigned, sorted by
;;; parent). `originals[r]` is value r's own lifetime before any joining.
;;; The result maps each graph reference to its owner, or is empty.
(defn run-prepared! [(parts (mut (ArrayList allocation/Part)))
                     (graph g/Graph) (scheduled schedule/Schedule)
                     (blocks cfg/Blocks) (depths (ArrayList i32))
                     (originals (slice ranges/Value))
                     (a (dyn Allocator))] (-> (ArrayList i32))
  (let [(mut parents) (ArrayList::new [i32] a)
        (mut groups) (phi/run! (mut parts) (mut parents) graph scheduled blocks depths a)
        (mut marked) (kinds graph scheduled a)]
    (views/extend! (mut parents) groups (mut parts) graph scheduled originals (slice marked) a)
    (free! (mut marked))
    (free! (mut groups))
    parents))

;;; Make the finalized location index answer for joined values: an alias
;;; borrows its owner's split children.
(defn index! [(index (mut locations/Index)) (parents (ArrayList i32))] (-> void)
  (when (> (len parents) 0) (set! (.coalesced index) true))
  (for [r 1 (len parents)]
    (let [parent (get parents r)]
      (when (!= parent (cast i32 r))
        (set! (mut (.parents index)) r (get (.parents index) (cast i64 parent)))))))

;;; Whether the transfer of group `parent` at `position` sits at the
;;; definition of a COPY or BITCAST that belongs to the group. The neutral
;;; stogir.allocation-transfers/redefined? keeps such a transfer, because the
;;; node may be a view of a source that lives on in the group. On x86-64 the
;;; node's emitter performs exactly that transfer: it reads its operand
;;; where the group is before the definition (register, spill slot or
;;; constant) and writes the register the group has from the definition on,
;;; moving the whole register (stogir.x64.emit/copy!, stogir.x64.convert). The
;;; transfer itself would be a move at a definition position, which the
;;; driver cannot place.
(defn view-defined? [(graph g/Graph) (scheduled schedule/Schedule)
                     (parts (ArrayList allocation/Part)) (index locations/Index)
                     (parent i32) (position i64)] (-> bool)
  (and (.coalesced index)
       (= (% position 2) 1)
       (let [reference (get (.nodes scheduled) (/ position 2))
             opcode (n/opcode (get (.instructions graph) (cast i64 reference)))]
         (and (or (= opcode 68) (= opcode 36))
              (> (.count (get (.parents index) (cast i64 reference))) 0)
              (= (locations/owner parts index reference) parent)))))
