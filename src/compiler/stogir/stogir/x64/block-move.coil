;;; A fixed-size memmove of 1..256 bytes as straight-line code, in place of
;;; the runtime call the ABI lowering has already set up (System V):
;;; destination in rdi, source in rsi, and the destination returned in rax.
;;;
;;; Entry points for the call family (the a64 call emitter is the model:
;;; stogir.a64.call, `inline-move-size`): when a direct CALL declared
;;; BUILTIN-MOVE has a literal count for which `inline?` holds and its first
;;; two arguments are in rdi and rsi, emit `(emit! text size)` instead of
;;; `call`. Nothing else about the call changes: its argument moves and its
;;; result capture stay as they are.
;;;
;;; Every source byte is loaded before any destination byte is stored, so
;;; overlapping and identical regions behave exactly as memmove does. No
;;; access reaches outside [0, size) of either region and none assumes an
;;; alignment.
;;;   * 16 bytes and more: whole 16-byte `movdqu` vectors from offset 0,
;;;     and for a remainder one more vector ending at the last byte,
;;;     overlapping its predecessor. At most sixteen vectors.
;;;   * below 16 bytes: two general-register chunks of 8, 4, 2 or 1 bytes,
;;;     the second ending at the last byte (one chunk when the size is 1, 2,
;;;     4 or 8).
;;;
;;; Written: rax (the destination, memmove's result), rcx, and xmm0 up to
;;; xmm15 as far as the size needs them. All are caller-saved and dead at the
;;; call this replaces: the call's constraints clobber every allocatable XMM
;;; register and rax/rcx, and xmm14/xmm15 are scratch. rdi and rsi keep their
;;; values and flags are untouched (only moves are emitted).
;;;
;;; The a64 module of this name is not shared: it is AArch64 vector pairs.
(module stogir.x64.block-move)
(import "stogir.x64.encode" :as e)
(import "stogir.x64.registers" :as registers)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn minimum [] (-> i64) 1)

(defn maximum [] (-> i64) 256)

(defn inline? [(size i64)] (-> bool)
  (and (>= size (minimum)) (<= size (maximum))))

(defn accept! [(error (mut (slice u8))) (result (Result i64 (slice u8)))] (-> void)
  (match result
    (Err [message] (when (= error "") (set! error message)))
    (Ok [_] 0)))

;;; All vector loads from rsi (`load` true) or all stores to rdi of one plan.
(defn vectors! [(out (mut (ArrayList u8))) (error (mut (slice u8))) (load bool) (size i64)]
  (-> void)
  (let [whole (/ size 16)
        tail (- size (* whole 16))
        base (if load (: registers/RSI i32) registers/RDI)]
    (for [k 0 (+ whole (if (> tail 0) 1 0))]
      (let [register (registers/xmm (cast i32 k))
            m (e/mem base (if (< k whole) (* k 16) (- size 16)))]
        (accept! (mut error)
                 (if load
                     (e/sse-mov-rm (mut out) e/MOVDQU register m)
                     (e/sse-mov-mr (mut out) e/MOVDQU m register)))))))

;;; The two general-register chunks of a size below 16: loads into rax and
;;; rcx, or stores from them.
(defn chunks! [(out (mut (ArrayList u8))) (error (mut (slice u8))) (load bool) (size i64)]
  (-> void)
  (let [chunk (cond (>= size 8) (: 8 i64) (>= size 4) 4 (>= size 2) 2 :else 1)
        bits (cast i32 (* chunk 8))
        base (if load (: registers/RSI i32) registers/RDI)]
    (for [k 0 (if (> size chunk) 2 1)]
      (let [register (if (= k 0) (: registers/RAX i32) registers/RCX)
            m (e/mem base (if (= k 0) 0 (- size chunk)))]
        (accept! (mut error)
                 (if load
                     (e/mov-rm (mut out) bits register m)
                     (e/mov-mr (mut out) bits m register)))))))

(defn emit! [(out (mut (ArrayList u8))) (size i64)] (-> (Result i32 (slice u8)))
  (if (not (inline? size))
      (Err "block move size outside the inline range")
      (let [before (len out)
            (mut error) ""]
        (if (>= size 16)
            (do
              (vectors! (mut out) (mut error) true size)
              (vectors! (mut out) (mut error) false size))
            (do
              (chunks! (mut out) (mut error) true size)
              (chunks! (mut out) (mut error) false size)))
        (accept! (mut error) (e/mov-rr (mut out) 64 registers/RAX registers/RDI))
        (if (= error "")
            (Ok (cast i32 (- (len out) before)))
            (do
              (while (> (len out) before) (pop! (mut out)))
              (Err error))))))
