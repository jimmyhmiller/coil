;;; The x86-64 profitability rule of loop strength reduction
;;; (stogir.loop-strength): which products of a loop are worth replacing by
;;; a loop-carried sum.
;;;
;;; A recurrence costs a register for the whole loop and an addition per
;;; iteration, so it must remove arithmetic that would otherwise be a real
;;; multiply (`imul`, three cycles and one port). It removes nothing when the
;;; product is already cheap:
;;;   * times 2, 4 or 8 is a scaled index inside an address, or one `shl`;
;;;     times 3, 5 or 9 is one `lea` (base plus scaled index);
;;;   * times any other power of two is one `shl`;
;;;   * times 0 or 1 folds away.
;;; Every other multiplier, and a product of two values that vary together,
;;; is a machine multiply. This is the rule of stogir.a64.strength-cost with
;;; the x86-64 addressing modes in place of AArch64's shifted operands; the
;;; predicate affects profitability only, never the correctness of a
;;; recurrence.
(module stogir.x64.strength-cost)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.loop-strength" :as strength)
(import "stogir.x64.value" :as value)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

;;; Whether multiplying by `multiplier` (a value of `bits` bits) needs no
;;; `imul`: zero, one, a power of two, or 3, 5 or 9.
(defn cheap-multiplier? [(multiplier u64) (bits i32)] (-> bool)
  (let [value (& multiplier (value/mask bits))]
    (or (= value 0)
        (= (& value (- value 1)) 0)
        (= value 3) (= value 5) (= value 9))))

;;; Whether MUL node `reference` is emitted as a machine multiply.
(defn machine-multiply? [(graph g/Graph) (reference i32)] (-> bool)
  (if (or (<= reference 0) (>= (cast i64 reference) (len (.instructions graph))))
      false
      (let [node (get (.instructions graph) (cast i64 reference))
            bits (value/type-bits (cast i32 (n/type-id node)))]
        (and (= (n/opcode node) 28)
             (> bits 0)
             (match (value/constant-bits graph (.op2 node))
               (Some [right] (not (cheap-multiplier? right bits)))
               (None []
                     (match (value/constant-bits graph (.op1 node))
                       (Some [left] (not (cheap-multiplier? left bits)))
                       (None [] true))))))))

(defn run [(graph g/Graph) (entry i32) (roots (slice i32)) (a (dyn Allocator))]
  (-> (Result strength/Reduced (slice u8)))
  (strength/run-with-cost graph entry roots a (p/fnptr-of machine-multiply?)))
