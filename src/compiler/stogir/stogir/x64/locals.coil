;;; x86-64 local variables.
;;;
;;; Operations: VAR (72), VADDR (65), VLOAD/VLOAD_v (85, 86) and
;;; VSTORE/VSTORE_v (87, 88) of integer values (stogir.locals). Floating and
;;; vector variable accesses belong to their families and report a clear
;;; error here; they address the variable with `slot`.
;;;
;;; A VAR is storage, not a value: it owns a frame object (a uses/Local of the
;;; shape stogir.locals/shape gives, requested in `constrain!`) and emits
;;; nothing. VADDR is `lea rd, [slot]`. An access is a move between a
;;; register and the slot at the accessed type's width; a narrower type may
;;; view the start of a wider variable. Loads extend narrow values to 32 bits
;;; by signedness and stores write an immediate when the constant fits, as
;;; stogir.x64.memory does. The slot is addressed from the frame base, so an
;;; anchored frame (dynamic stack, over-alignment) needs nothing special.
;;;
;;; The a64 module of this name is not shared: it forms the address in x16
;;; and uses AArch64 access encodings.
;;;
;;; Interface (called through stogir.x64.families; see docs/X86_FAMILIES.md):
;;; `select!`, `constrain!`, `emit!`.
(module stogir.x64.locals)
(import "stogir.graph" :as g)
(import "stogir.locals" :as local)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.x64.code" :as code)
(import "stogir.x64.context" :as context)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.frame-address" :as frame)
(import "stogir.x64.memory" :as memory)
(import "stogir.x64.plan" :as plan)
(import "stogir.x64.uses" :as uses)
(import "stogir.x64.value" :as value)
(import "coil.result" :use [Result Ok Err Some None])

(const OTHER-CLASS "x86-64 backend: floating and vector VLOAD/VSTORE are not implemented yet (floating/vector families; address the variable with stogir.x64.locals/slot)")

(const CONFLICT "conflicting x86-64 register constraints")

;;; The VAR a local operation names.
(defn variable [(node n/Node)] (-> i32)
  (if (= (n/opcode node) 65) (.op1 node) (.op2 node)))

;;; The memory operand of the first byte of VAR `variable`.
(defn slot [(cx context/Context) (variable i32)] (-> (Result encode/Mem (slice u8)))
  (match (local/shape (.graph cx) variable 8)
    (Err [message] (Err message))
    (Ok [shape]
        (match (get (.locals (.frame cx)) variable)
          (None [] (Err "local variable has no frame slot"))
          (Some [index]
                (if (or (< index 0) (>= index (len (.slots (.frame cx)))))
                    (Err "invalid local frame slot index")
                    (let [placed (get (.slots (.frame cx)) index)]
                      (if (or (!= (.size placed) (.size shape))
                              (!= (.alignment placed) (.alignment shape))
                              (> (.alignment shape) (.alignment cx)))
                          (Err "local frame slot shape mismatch")
                          (frame/slot (.base cx) (.offset placed))))))))))

(defn select! [(state (mut plan/Matching)) (graph g/Graph) (reference i32)]
  (-> (Result i32 (slice u8)))
  (match (local/validate graph reference 8)
    (Err [message] (Err message))
    (Ok [_] (Ok 0))))

(defn constrain! [(set (mut uses/Set)) (graph g/Graph) (matched plan/Plan)
                  (reference i32) (position i64)] (-> (Result i32 (slice u8)))
  (match (local/validate graph reference 8)
    (Err [message] (Err message))
    (Ok [_]
        (let [node (get (.instructions graph) (cast i64 reference))
              opcode (cast i32 (n/opcode node))
              store (or (= opcode 87) (= opcode 88))
              ty (if store (value/type-of graph (.op3 node)) (cast i32 (n/type-id node)))
              (mut accepted) true]
          (cond (= opcode 72)
                  (match (local/shape graph reference 8)
                    (Err [message] (Err message))
                    (Ok [shape]
                        (push! (mut (.locals set))
                               (uses/Local :owner reference :size (.size shape)
                                           :alignment (.alignment shape)))
                        (Ok 0)))
                (and (!= opcode 65) (not (types/integer? ty))) (Err OTHER-CLASS)
                :else
                  (do
                    (if store
                        (match (value/immediate graph (.op3 node) (value/type-bits ty))
                          (Some [_] 0)
                          (None [] (set! accepted (uses/use! (mut set) (.op3 node) position))))
                        (set! accepted (uses/define! (mut set) reference position)))
                    (if accepted (Ok 0) (Err CONFLICT))))))))

(defn emit! [(out (mut code/Buffer)) (cx context/Context) (reference i32) (position i64)]
  (-> (Result i32 (slice u8)))
  (match (local/validate (.graph cx) reference 8)
    (Err [message] (Err message))
    (Ok [_]
        (let [node (get (.instructions (.graph cx)) (cast i64 reference))
              opcode (cast i32 (n/opcode node))
              store (or (= opcode 87) (= opcode 88))
              ty (if store (value/type-of (.graph cx) (.op3 node)) (cast i32 (n/type-id node)))
              (mut error) ""]
          (cond (= opcode 72) 0
                (and (!= opcode 65) (not (types/integer? ty))) (set! error OTHER-CLASS)
                :else
                  (match (slot cx (variable node))
                    (Err [message] (set! error message))
                    (Ok [m]
                        (if store
                            (code/accept-count! (mut error)
                                                (memory/write! (mut out) cx ty m (.op3 node)
                                                               position))
                            (match (value/destination (.graph cx) (.parts cx) reference position)
                              (Err [message] (set! error message))
                              (Ok [rd]
                                  (code/accept! (mut error)
                                                (if (= opcode 65)
                                                    (encode/lea (mut (.text out)) 64 rd m)
                                                    (memory/read! (mut out) ty rd m)))))))))
          (if (= error "") (Ok 0) (Err error))))))
