;;; Incremental data/dead-load removal follows ir_sccp.c:ir_iter_remove_insn
;;; and ir_is_dead_load. Observable values remain protected. See NOTICE.
(module stogir.dead-code)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.symbols" :as symbols)
(import "stogir.types" :as types)
(import "stogir.opcode" :as op)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "stogir.bitset" :as bits)
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Some None])

;;; Cache the function-level proof: scope/free and explicit frame/register
;;; operations can observe stack depth independently of an allocation's value.
(defstruct Context [(checked bool) (stack-safe bool)])

(defn stack-safe! [(context (mut Context)) (graph g/Graph)] (-> bool)
  (unless (.checked context)
    (set! (.checked context) true)
    (set! (.stack-safe context) true)
    (let [(mut r) 1]
      (while (< r (len (.instructions graph)))
        (let [opcode (n/opcode (get (.instructions graph) r))]
          (when (or (= opcode 65)
                    (= opcode 66)
                    (and (>= opcode 82) (<= opcode 84))
                    (= opcode 89)
                    (= opcode 90)
                    (and (>= opcode 97) (<= opcode 103))
                    (and (>= opcode 122) (<= opcode 125)))
            (set! (.stack-safe context) false))
          (set! r (+ r (/ (+ (cast i64 (get (.arities graph) r)) 4) 4)))))))
  (.stack-safe context))

(defn empty-static? [(graph g/Graph) (node n/Node)] (-> bool)
  (and (= (n/opcode node) 81)
       (< (.op2 node) 0)
       (match (g/lookup graph (.op2 node))
         (Some [size]
               (and (symbols/numeric? size)
                    (types/integer? (cast i32 (n/type-id size)))
                    (> (n/constant-bits size) 0)
                    (<= (n/constant-bits size) 0x7FFFFFFFFFFFFFFF)))
         (None [] false))))

(defn data? [(opcode i32)] (-> bool)
  (and (>= opcode 14) (<= opcode 68)))

(defn detach! [(graph g/Graph)
               (edges (mut uses/Uses))
               (queue (mut q/Queue))
               (reference i32)] (-> void)
  (let [node (get (.instructions graph) (cast i64 reference))
        count (get (.arities graph) (cast i64 reference))]
    (for [i 1 (+ (cast i64 count) 1)]
      (when (uses/edge-code? (op/operand-code (cast i32 (n/opcode node))
                                              (cast i32 i)))
        (match (g/operand graph reference (cast i32 i))
          (None [] (panic "dead instruction operand missing"))
          (Some [source]
                (when (> source 0)
                  (unless (uses/remove! (mut edges)
                                        source
                                        (uses/Use
                                          :user reference
                                          :operand (cast i32 i)))
                    (panic "dead instruction input use missing"))
                  (q/add! (mut queue) (cast i64 source)))))))))

;;; A removed LOAD or empty static allocation has only a control successor.
;;; Empty allocation removal extends mem2ssa liveness into cleanup. Never remove
;;; volatile/atomic accesses, used values, roots or a malformed control cycle.
(defn remove! [(graph (mut g/Graph))
               (edges (mut uses/Uses))
               (queue (mut q/Queue))
               (protected bits/Bits)
               (context (mut Context))
               (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        range (get (.ranges edges) (cast i64 reference))
        (mut changed) false]
    (unless (bits/contains? protected (cast i64 reference))
      (cond (and (data? opcode) (= (.count range) 0))
              (do
                (detach! graph (mut edges) (mut queue) reference)
                (unless (g/make-nop! (mut graph) reference)
                  (panic "dead data removal failed"))
                (set! changed true))
            (and (= (.count range) 1)
                 (or (= opcode 91)
                     (and (empty-static? graph node)
                          (stack-safe! (mut context) graph))))
              (let [(mut successor-use) (get (.edges edges) (.offset range))
                    successor (.user successor-use)
                    previous (.op1 node)]
                (when (and (> previous 0)
                           (!= previous reference)
                           (!= previous successor)
                           (!= successor reference)
                           (= (.operand successor-use) 1)
                           (op/control? (cast i32
                                              (n/opcode (get (.instructions graph)
                                                             (cast i64
                                                                   successor)))))
                           (= (op/operand-code (cast i32
                                                     (n/opcode (get (.instructions graph)
                                                                    (cast i64
                                                                          successor))))
                                               1)
                              op/OPERAND-SRC))
                  (detach! graph (mut edges) (mut queue) reference)
                  (unless (uses/remove! (mut edges) reference successor-use)
                    (panic "dead control successor use missing"))
                  (unless (g/set-operand! (mut graph) successor 1 previous)
                    (panic "dead control bypass failed"))
                  (uses/add! (mut edges) previous successor-use)
                  (q/add! (mut queue) (cast i64 successor))
                  (unless (g/make-nop! (mut graph) reference)
                    (panic "dead control removal failed"))
                  (set! changed true)))
            :else 0))
    changed))

;;; Reuse the caller's exact uses. Prune before memory promotion so unused reads
;;; do not make otherwise-private uninitialized stack objects look observable.
;;; No SCCP analysis, graph copy, new references or repeated full scan is needed.
(defn prune! [(graph (mut g/Graph))
              (edges (mut uses/Uses))
              (roots (slice i32))
              (a (dyn Allocator))] (-> i32)
  (let [(mut protected) (bits/create (len (.instructions graph)) a)
        (mut queue) (q/create (len (.instructions graph)) a)
        (mut changes) (: 0 i32)
        (mut context) (zeroed Context)
        (mut r) 1]
    (for root roots (bits/add! (mut protected) (cast i64 root)))
    (while (< r (len (.instructions graph)))
      (let [opcode (cast i32 (n/opcode (get (.instructions graph) r)))
            count (.count (get (.ranges edges) r))]
        (when (or (and (data? opcode) (= count 0))
                  (and (or (= opcode 91) (= opcode 81)) (= count 1)))
          (q/add! (mut queue) r))
        (set! r (+ r (/ (+ (cast i64 (get (.arities graph) r)) 4) 4)))))
    (set! r (q/pop! (mut queue)))
    (while (>= r 0)
      (when (remove! (mut graph)
                     (mut edges)
                     (mut queue)
                     protected
                     (mut context)
                     (cast i32 r))
        (set! changes (+ changes 1)))
      (set! r (q/pop! (mut queue))))
    (q/release! (mut queue))
    (bits/release! (mut protected))
    changes))
