;;; LONG_CONST header geometry and byte hashing follow dstogov/ir ir.c. See NOTICE.
(module stogir.long-constant)
(import "stogir.node" :as n)
(import "stogir.types" :as types)

(defn cells [(size i64)] (-> i32)
  (if (or (<= size 0) (> size 65520)) -1 (cast i32 (+ 1 (/ (+ size 15) 16)))))

(defn valid-header? [(node n/Node) (pointer-bytes i32)] (-> bool)
  (and (= (n/opcode node) 78)
       (types/vector? (cast i32 (n/type-id node)))
       (> (n/auxiliary node) 0)
       (= (types/size (cast i32 (n/type-id node)) pointer-bytes)
          (cast i32 (n/auxiliary node)))
       (> (cells (cast i64 (n/auxiliary node))) 1)))

(defn hash-step [(hash u32) (byte u8)] (-> u32)
  (cast u32 (+ (* (cast u64 hash) 33) (cast u64 byte))))

(defn hash [(header u32) (payload (slice u8))] (-> u64)
  (let [(mut hash) (: 5381 u32)]
    (for byte payload (set! hash (hash-step hash byte)))
    (cast u64 (^ hash header))))
