;;; Checked vector transport over the upstream type encoding and memory/Phi IR.
(module stogir.vector)
(import "coil.primitive" :as p)
(import "stogir.graph" :as g)
(import "stogir.copy" :as copy)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.locals" :as locals)
(import "stogir.vector-arithmetic" :as va)
(import "stogir.vector-comparison" :as vc)
(import "stogir.vector-lanes" :as vl)
(import "stogir.conditional" :as conditional)
(import "stogir.conversion" :as conversion)
(import "coil.result" :use [Result Ok Err Some None])

;;; Control edges may come from vector loads without consuming their data.
;;; Only data operands count as vector involvement in a scalar-typed user.
(defn involves? [(graph g/Graph) (reference i32)] (-> bool)
  (let [pointer (g/borrow-node graph reference)]
    (if (= pointer (p/cast (ptr n/Node) 0))
        false
        (let [node (load pointer)
              (mut found) (types/vector? (cast i32 (n/type-id node)))
              (mut i) (: 1 i32)]
          (when (> reference 0)
            (while (and (not found)
                        (<= i (get (.arities graph) (cast i64 reference))))
              (let [kind (op/operand-code (cast i32 (n/opcode node)) i)]
                (when (or (= kind op/OPERAND-DEF) (= kind op/OPERAND-REF))
                  (match (g/operand graph reference i)
                    (None [] 0)
                    (Some [input]
                          (let [value (g/borrow-node graph input)]
                            (when (and (!= value (p/cast (ptr n/Node) 0))
                                       (types/vector? (cast i32
                                                            (n/type-id (load value)))))
                              (set! found true)))))))
              (set! i (+ i 1))))
          found))))

(defn memory-inputs [(graph g/Graph)
                     (ty i32)
                     (pointer-bytes i32)
                     (control i32)
                     (address i32)]
  (-> (Result i32 (slice u8)))
  (if (or (not (types/vector? ty)) (<= (types/size ty pointer-bytes) 0))
      (Err "invalid vector memory type or target pointer width")
      (match (g/lookup graph control)
        (None [] (Err "vector memory control missing"))
        (Some [prior]
              (if (or (<= control 0)
                      (not (op/control? (cast i32 (n/opcode prior))))
                      (op/block-end? (cast i32 (n/opcode prior))))
                  (Err "vector memory requires an open control chain")
                  (match (g/lookup graph address)
                    (None [] (Err "vector memory address missing"))
                    (Some [value]
                          (if (or (!= (n/type-id value) 6)
                                  (= (n/opcode value) 72)
                                  (= (n/opcode value) 70))
                              (Err "vector memory address must be an ADDR value")
                              (Ok (types/size ty pointer-bytes))))))))))

(defn store-inputs [(graph g/Graph)
                    (pointer-bytes i32)
                    (control i32)
                    (address i32)
                    (value i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph value)
    (None [] (Err "vector store value missing"))
    (Some [node]
          (memory-inputs graph
                         (cast i32 (n/type-id node))
                         pointer-bytes
                         control
                         address))))

;;; The represented vector transport families are explicit. Other vector
;;; operations/ABI roles reject until their complete semantics are implemented.
(defn validate [(graph g/Graph) (reference i32) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "vector instruction missing"))
    (Some [node]
          (if (<= reference 0)
              (Err "vector instruction validation requires a positive reference")
              (let [opcode (cast i32 (n/opcode node))
                    ty (cast i32 (n/type-id node))
                    count (get (.arities graph) (cast i64 reference))]
                (if (or (= opcode 36) (= opcode 68))
                    (if (= opcode 68)
                        (copy/validate graph reference)
                        (conversion/validate graph reference pointer-bytes))
                    (if (= opcode 60)
                        (conditional/validate graph reference)
                        (if (vl/operation? opcode)
                            (vl/validate graph reference pointer-bytes)
                            (if (vc/node? graph reference)
                                (vc/validate graph reference pointer-bytes)
                                (if (or (= opcode 71)
                                        (= opcode 79)
                                        (= opcode 120)
                                        (locals/operation? opcode)
                                        (va/node? graph reference))
                                    (if (va/node? graph reference)
                                        (va/validate graph reference)
                                        (if (locals/operation? opcode)
                                            (locals/validate graph
                                                             reference
                                                             pointer-bytes)
                                            (Ok 0)))
                                    (if (or (= opcode 91) (= opcode 92))
                                        (if (!= count 2)
                                            (Err "invalid vector load shape")
                                            (memory-inputs graph
                                                           ty
                                                           pointer-bytes
                                                           (.op1 node)
                                                           (.op2 node)))
                                        (if (or (= opcode 93) (= opcode 94))
                                            (if (or (!= count 3) (!= ty 0))
                                                (Err "invalid vector store shape")
                                                (store-inputs graph
                                                              pointer-bytes
                                                              (.op1 node)
                                                              (.op2 node)
                                                              (.op3 node)))
                                            (if (= opcode 67)
                                                (let [(mut error) ""
                                                      (mut i) (: 2 i32)]
                                                  (when (or (not (types/vector? ty))
                                                            (<= (types/size ty
                                                                            pointer-bytes)
                                                                0)
                                                            (< count 3))
                                                    (set! error
                                                          "invalid vector Phi type or shape"))
                                                  (match (g/lookup graph
                                                                   (.op1 node))
                                                    (None []
                                                          (set! error
                                                                "vector Phi region missing"))
                                                    (Some [region]
                                                          (when (or (<= (.op1 node)
                                                                        0)
                                                                    (not (or (= (n/opcode region)
                                                                                112)
                                                                             (= (n/opcode region)
                                                                                113)))
                                                                    (!= count
                                                                        (+ 1
                                                                           (get (.arities graph)
                                                                                (cast i64
                                                                                      (.op1 node))))))
                                                            (set! error
                                                                  "invalid vector Phi region"))))
                                                  (while (and (= error "")
                                                              (<= i count))
                                                    (match (g/operand graph
                                                                      reference
                                                                      i)
                                                      (None []
                                                            (set! error
                                                                  "vector Phi input missing"))
                                                      (Some [input]
                                                            (match (g/lookup graph
                                                                             input)
                                                              (None []
                                                                    (set! error
                                                                          "vector Phi input missing"))
                                                              (Some [value]
                                                                    (when (!= (cast i32
                                                                                    (n/type-id value))
                                                                              ty)
                                                                      (set! error
                                                                            "vector Phi input type mismatch"))))))
                                                    (set! i (+ i 1)))
                                                  (if (= error "")
                                                      (Ok (types/size ty
                                                                      pointer-bytes))
                                                      (Err error)))
                                                (Err "unsupported vector operation or ABI role"))))))))))))))
