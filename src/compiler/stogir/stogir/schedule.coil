;;; Local dependency ordering over finalized node placements.
(module stogir.schedule)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.uses" :as uses)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn local-edge? [(opcode i32) (index i32)] (-> bool)
  (and (not (op/block-start? opcode))
       (not (and (= opcode 67) (>= index 2)))
       (uses/edge-code? (op/operand-code opcode index))))

;;; Returns an interleaved order; filtering by block gives that block's schedule.
;;; Graph must be verified, placements finalized, and live mask dependency-closed.
(defn order [(graph g/Graph)
             (mapping (ArrayList i32))
             (live (ArrayList bool))
             (allocator (dyn Allocator))]
  (-> (Result (ArrayList i32) (slice u8)))
  (let [(mut users) (uses/build graph allocator)
        result (order-with-uses graph mapping live users allocator)]
    (uses/release! (mut users))
    result))

;;; An update x' = f(v, ...) that feeds a Phi can share that Phi's register
;;; with v only when v dies at the update. That is wanted when v is the Phi
;;; itself (a loop-carried update), another input of the same Phi (a value
;;; updated on one path into a merge), or a Phi fed by that Phi through a few
;;; merges (a loop-carried update whose paths join before the loop Phi).
;;; Reports whether REFERENCE is such an update whose v has another body user
;;; in the same block. Already ordered users count too: selection may fuse an
;;; ordered address or operand node into a later consumer, which then reads v.
(defn carried-update? [(graph g/Graph)
                       (mapping (ArrayList i32))
                       (live (ArrayList bool))
                       (users uses/Uses)
                       (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        count (get (.arities graph) (cast i64 reference))
        range (get (.ranges users) (cast i64 reference))
        (mut found) false
        (mut j) 0]
    (when (and (!= opcode 67) (not (op/block-end? opcode)))
      (while (and (not found) (< j (.count range)))
        (let [edge (get (.edges users) (+ (.offset range) j))
              phi (.user edge)]
          (when (and (>= (.operand edge) 2)
                     (get live (cast i64 phi))
                     (= (n/opcode (get (.instructions graph) (cast i64 phi))) 67))
            (let [(mut i) (: 1 i32)]
              (while (and (not found) (<= i count))
                (when (local-edge? opcode i)
                  (let [source (uses/verified-input graph (cast i64 reference) i)]
                    (when (and (> source 0)
                               (or (= source phi)
                                   (phi-input? graph phi source)
                                   (and (= (n/opcode (get (.instructions graph)
                                                          (cast i64 source)))
                                           67)
                                        (feeds-phi? graph live users phi source 3)))
                               (other-body-user? graph mapping live users
                                                 source reference))
                      (set! found true))))
                (set! i (+ i 1))))))
        (set! j (+ j 1))))
    found))

(defn phi-input? [(graph g/Graph) (phi i32) (value i32)] (-> bool)
  (let [count (get (.arities graph) (cast i64 phi))
        (mut found) false
        (mut i) (: 2 i32)]
    (while (and (not found) (<= i count))
      (when (= (uses/verified-input graph (cast i64 phi) i) value)
        (set! found true))
      (set! i (+ i 1)))
    found))

;;; Whether Phi FROM reaches Phi TARGET through at most DEPTH Phi inputs, as a
;;; loop-carried update does when its paths join at merges before the loop Phi.
(defn feeds-phi? [(graph g/Graph)
                  (live (ArrayList bool))
                  (users uses/Uses)
                  (from i32)
                  (target i32)
                  (depth i32)] (-> bool)
  (let [range (get (.ranges users) (cast i64 from))
        (mut found) false
        (mut j) 0]
    (while (and (not found) (< j (.count range)))
      (let [edge (get (.edges users) (+ (.offset range) j))
            user (.user edge)]
        (when (and (>= (.operand edge) 2)
                   (get live (cast i64 user))
                   (= (n/opcode (get (.instructions graph) (cast i64 user))) 67)
                   (or (= user target)
                       (and (> depth 1)
                            (feeds-phi? graph live users user target (- depth 1)))))
          (set! found true)))
      (set! j (+ j 1)))
    found))

;;; Whether VALUE has a live body user other than UPDATE in UPDATE's block.
(defn other-body-user? [(graph g/Graph)
                        (mapping (ArrayList i32))
                        (live (ArrayList bool))
                        (users uses/Uses)
                        (value i32)
                        (update i32)] (-> bool)
  (let [block (get mapping (cast i64 update))
        range (get (.ranges users) (cast i64 value))
        (mut found) false
        (mut j) 0]
    (while (and (not found) (< j (.count range)))
      (let [edge (get (.edges users) (+ (.offset range) j))
            user (cast i64 (.user edge))
            opcode (cast i32 (n/opcode (get (.instructions graph) user)))]
        (when (and (!= (.user edge) update)
                   (get live user)
                   (= (get mapping user) block)
                   (not (op/block-end? opcode))
                   (local-edge? opcode (.operand edge)))
          (set! found true)))
      (set! j (+ j 1)))
    found))

;;; Orders REFERENCE now, or holds a loop-carried update until no other
;;; reference is ready. Draining first places the update after every node that
;;; does not need it, and a user that itself needs the update cannot deadlock.
(defn ready! [(graph g/Graph)
              (mapping (ArrayList i32))
              (live (ArrayList bool))
              (users uses/Uses)
              (work (mut (ArrayList i32)))
              (held (mut (ArrayList i32)))
              (reference i32)] (-> void)
  (if (carried-update? graph mapping live users reference)
      (push! (mut held) reference)
      (push! (mut work) reference)))

;;; Borrows exact use lists for the unchanged graph; caller retains ownership.
(defn order-with-uses [(graph g/Graph)
                       (mapping (ArrayList i32))
                       (live (ArrayList bool))
                       (users uses/Uses)
                       (allocator (dyn Allocator))]
  (-> (Result (ArrayList i32) (slice u8)))
  (let [(mut pending) (ArrayList::new [i64] allocator)
        (mut ends) (ArrayList::new [i32] allocator)
        (mut bodies) (ArrayList::new [i64] allocator)
        (mut work) (ArrayList::new [i32] allocator)
        (mut held) (ArrayList::new [i32] allocator)
        (mut released) 0
        (mut error) ""
        (mut total) 0
        (mut r) 0]
    (extend-zeroed! (mut ends) (len (.instructions graph)))
    (extend-zeroed! (mut bodies) (len (.instructions graph)))
    (while (< r (len (.instructions graph)))
      (push! (mut pending) -1)
      (set! r (+ r 1)))
    (set! r 1)
    (while (and (= error "") (< r (len pending)))
      (when (and (g/contains? graph (cast i32 r)) (get live r))
        (let [block (get mapping r)
              node (get (.instructions graph) r)
              opcode (cast i32 (n/opcode node))
              count (get (.arities graph) r)
              (mut dependencies) 0
              (mut i) (: 1 i32)]
          (if (<= block 0)
              (set! error "live node lacks placement")
              (do
                (set! total (+ total 1))
                (if (op/block-end? opcode)
                    (if (!= (get ends (cast i64 block)) 0)
                        (set! error "multiple block ends")
                        (set! (mut ends) (cast i64 block) (cast i32 r)))
                    (set! (mut bodies)
                          (cast i64 block)
                          (+ (get bodies (cast i64 block)) 1)))
                (while (<= i count)
                  (when (local-edge? opcode i)
                    (match (g/operand graph (cast i32 r) i)
                      (None [] (set! error "missing scheduled operand"))
                      (Some [source]
                            (when (and (> source 0)
                                       (= (get mapping (cast i64 source)) block))
                              (set! dependencies (+ dependencies 1))))))
                  (set! i (+ i 1)))
                (set! (mut pending) r dependencies)))))
      (set! r (+ r 1)))
    (set! r 1)
    (while (< r (len pending))
      (when (>= (get pending r) 0)
        (let [block (get mapping r)]
          (when (= (get ends (cast i64 block)) (cast i32 r))
            (set! (mut pending)
                  r
                  (+ (get pending r) (get bodies (cast i64 block)))))
          (when (= (get pending r) 0)
            (ready! graph mapping live users (mut work) (mut held)
                    (cast i32 r)))))
      (set! r (+ r 1)))
    (let [(mut cursor) 0]
      (while (and (= error "")
                  (or (< cursor (len work)) (< released (len held))))
        (when (= cursor (len work))
          (push! (mut work) (get held released))
          (set! released (+ released 1)))
        (let [ref (get work cursor)
              block (get mapping (cast i64 ref))
              range (get (.ranges users) (cast i64 ref))
              (mut i) 0]
          (while (< i (.count range))
            (let [edge (get (.edges users) (+ (.offset range) i))
                  user (cast i64 (.user edge))
                  node (get (.instructions graph) user)]
              (when (and (get live user)
                         (= (get mapping user) block)
                         (local-edge? (cast i32 (n/opcode node))
                                      (.operand edge)))
                (set! (mut pending) user (- (get pending user) 1))
                (when (= (get pending user) 0)
                  (ready! graph mapping live users (mut work) (mut held)
                          (.user edge)))))
            (set! i (+ i 1)))
          (let [end (get ends (cast i64 block))]
            (when (and (> end 0) (!= end ref))
              (set! (mut pending)
                    (cast i64 end)
                    (- (get pending (cast i64 end)) 1))
              (when (= (get pending (cast i64 end)) 0) (push! (mut work) end)))))
        (set! cursor (+ cursor 1))))
    (free! (mut pending))
    (free! (mut held))
    (free! (mut ends))
    (free! (mut bodies))
    (when (and (= error "") (!= (len work) total))
      (set! error "local dependency cycle"))
    (if (= error "")
        (let [ordered (entry-prefix graph work allocator)]
          (free! (mut work))
          (Ok ordered))
        (do (free! (mut work)) (Err error)))))

;;; Region projections must capture incoming values before body instructions.
;;; Starts have no local inputs; PARAM has only its region input. Moving these
;;; two classes first preserves local dependencies and prevents calls from
;;; clobbering an incoming register before its PARAM projection is scheduled.
(defn entry-prefix [(graph g/Graph)
                    (work (ArrayList i32))
                    (allocator (dyn Allocator))] (-> (ArrayList i32))
  (let [(mut result) (ArrayList::new [i32] allocator)
        (mut phase) 0]
    (while (< phase 3)
      (let [items-1 work (mut for-index-1) (: 0 i64)] (while (< for-index-1 (len items-1)) (let [reference (get items-1 for-index-1)]
        (let [opcode
                (cast i32
                      (n/opcode (get (.instructions graph) (cast i64 reference))))
              category (if (op/block-start? opcode) 0 (if (= opcode 71) 1 2))]
          (when (= category phase) (push! (mut result) reference)))) (set! for-index-1 (+ for-index-1 1))))
      (set! phase (+ phase 1)))
    result))

(defstruct Range [(offset i64) (count i64)])

(defstruct Schedule [(ranges (ArrayList Range)) (nodes (ArrayList i32))])

;;; Stable grouping preserves each block's dependency order while laying blocks
;;; out in caller-provided CFG order. All scheduled blocks must be in block-order.
(defn pack [(local-order (ArrayList i32))
            (mapping (ArrayList i32))
            (block-order (ArrayList i32))
            (allocator (dyn Allocator))] (-> Schedule)
  (let [(mut result)
          (Schedule
            :ranges (ArrayList::new [Range] allocator)
            :nodes (ArrayList::new [i32] allocator))
        (mut cursor) (ArrayList::new [i64] allocator)]
    (extend-zeroed! (mut (.ranges result)) (len mapping))
    (extend-zeroed! (mut cursor) (len mapping))
    (let [items-2 local-order (mut for-index-2) (: 0 i64)] (while (< for-index-2 (len items-2)) (let [node (get items-2 for-index-2)]
      (let [block (cast i64 (get mapping (cast i64 node)))
            (mut range) (get (.ranges result) block)]
        (set! (.count range) (+ (.count range) 1))
        (set! (mut (.ranges result)) block range))) (set! for-index-2 (+ for-index-2 1))))
    (let [(mut offset) 0]
      (let [items-3 block-order (mut for-index-3) (: 0 i64)] (while (< for-index-3 (len items-3)) (let [block (get items-3 for-index-3)]
        (let [idx (cast i64 block)
              (mut range) (get (.ranges result) idx)]
          (set! (.offset range) offset)
          (set! (mut (.ranges result)) idx range)
          (set! (mut cursor) idx offset)
          (set! offset (+ offset (.count range))))) (set! for-index-3 (+ for-index-3 1)))))
    (extend-zeroed! (mut (.nodes result)) (len local-order))
    (let [items-4 local-order (mut for-index-4) (: 0 i64)] (while (< for-index-4 (len items-4)) (let [node (get items-4 for-index-4)]
      (let [block (cast i64 (get mapping (cast i64 node)))
            slot (get cursor block)]
        (set! (mut (.nodes result)) slot node)
        (set! (mut cursor) block (+ slot 1)))) (set! for-index-4 (+ for-index-4 1))))
    (free! (mut cursor))
    result))

(defn release! [(schedule (mut Schedule))] (-> void)
  (free! (mut (.ranges schedule)))
  (free! (mut (.nodes schedule))))
