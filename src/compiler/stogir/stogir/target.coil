;;; Which machine and system the code being compiled is for. These are macros:
;;; each expands to the chosen form only, so the other target's code (and the
;;; externs it names) never reaches the program.
(module stogir.target)
(import "coil.primitive" :as primitive)

;;; `a64` when compiling for AArch64, `x64` when compiling for x86-64.
(defn arch-pick [(a64 Code) (x64 Code)] (-> Code)
  (match (target-arch)
    (Aarch64 [] a64)
    (X86_64 [] x64)
    (_ (primitive/error "stogir: no native backend for this architecture"))))

;;; `darwin` when compiling for macOS, `linux` when compiling for Linux.
(defn os-pick [(darwin Code) (linux Code)] (-> Code)
  (match (target-os)
    (Darwin [] darwin)
    (Linux [] linux)
    (_ (primitive/error "stogir: no native support for this operating system"))))
