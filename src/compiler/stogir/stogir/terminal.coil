;;; TRAP and UNREACHABLE shapes follow dstogov/ir ir.h and ir.c. See NOTICE.
(module stogir.terminal)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn operation? [(opcode i32)] (-> bool)
  (or (= opcode 96) (= opcode 121)))

(defn previous-input [(graph g/Graph) (previous i32)]
  (-> (Result i32 (slice u8)))
  (if (= previous 0)
      (Ok 0)
      (match (g/lookup graph previous)
        (None [] (Err "terminal chain target missing"))
        (Some [node]
              (if (or (<= previous 0)
                      (not (op/terminator? (cast i32 (n/opcode node)))))
                  (Err "terminal chain requires a terminal instruction")
                  (Ok previous))))))

(defn inputs [(graph g/Graph) (opcode i32) (control i32) (previous i32)]
  (-> (Result i32 (slice u8)))
  (if (or (not (operation? opcode)) (and (= opcode 96) (!= previous 0)))
      (Err "invalid trap/terminal opcode or chain")
      (match (g/lookup graph control)
        (None [] (Err "trap/terminal control missing"))
        (Some [node]
              (if (or (<= control 0)
                      (not (op/control? (cast i32 (n/opcode node))))
                      (op/block-end? (cast i32 (n/opcode node))))
                  (Err "trap/terminal requires an open control chain")
                  (previous-input graph previous))))))

(defn validate [(graph g/Graph) (reference i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "trap/terminal instruction missing"))
    (Some [node]
          (let [opcode (cast i32 (n/opcode node))]
            (if (or (<= reference 0)
                    (not (operation? opcode))
                    (!= (n/type-id node) 0)
                    (!= (get (.arities graph) (cast i64 reference))
                        (if (= opcode 96) 1 3))
                    (and (= opcode 121) (!= (.op2 node) 0)))
                (Err "invalid trap/terminal shape")
                (inputs graph
                        opcode
                        (.op1 node)
                        (if (= opcode 121) (.op3 node) 0)))))))

(defn chain? [(opcode i32)] (-> bool)
  (and (op/terminator? opcode) (= (op/operand-code opcode 3) op/OPERAND-RET)))

(defn previous [(graph g/Graph) (reference i32)] (-> i32)
  (let [node (get (.instructions graph) (cast i64 reference))]
    (if (chain? (cast i32 (n/opcode node))) (.op3 node) 0)))

;;; Requires structurally and individually validated nodes. A linear color walk
;;; permits forward links while rejecting cycles; zero-only chains allocate nothing.
(defn verify-chains [(graph g/Graph) (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (verify-chains-walk graph [] false allocator))

;;; verify-chains for a graph that verify/structure-noting has just passed,
;;; with NOTED as it filled it: START and the chain members are visited
;;; through that list.
(defn verify-chains-among [(graph g/Graph) (noted (slice i32)) (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (verify-chains-walk graph noted true allocator))

;;; One pair of loops serves both: LISTED steps through NOTED, otherwise
;;; through every node start.
(defn verify-chains-walk [(graph g/Graph) (noted (slice i32)) (listed bool)
                          (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut first) (: 0 i64)
        (mut first-k) (: 0 i64)
        (mut k) (: 0 i64)
        (mut r) (: 1 i64)
        (mut error) ""]
    (while (and (= error "")
                (if listed (< k (len noted)) (< r (len (.instructions graph)))))
      (when listed (set! r (cast i64 (get noted k))))
      (let [node (get (.instructions graph) r)
            opcode (cast i32 (n/opcode node))]
        (when (or (= opcode 104) (chain? opcode))
          (match (previous-input graph
                                 (if (= opcode 104) (.op1 node) (.op3 node)))
            (Err [message] (set! error message))
            (Ok [value]
                (when (and (chain? opcode) (!= value 0) (= first 0))
                  (set! first r)
                  (set! first-k k)))))
        (if listed
            (set! k (+ k 1))
            (set! r (+ r (/ (+ (cast i64 (get (.arities graph) r)) 4) 4))))))
    (if (!= error "")
        (Err error)
        (if (= first 0)
            (Ok 0)
            (let [(mut colors) (ArrayList::new [u8] allocator)
                  (mut i) (: 0 i64)
                  (mut count) (: 0 i32)]
              (extend-zeroed! (mut colors) (len (.instructions graph)))
              (set! i first)
              (set! k first-k)
              (while (and (= error "")
                          (if listed (< k (len noted)) (< i (len (.instructions graph)))))
                (when listed (set! i (cast i64 (get noted k))))
                (let [node (get (.instructions graph) i)]
                  (when (chain? (cast i32 (n/opcode node)))
                    (let [(mut current) (cast i32 i)]
                      (while (and (!= current 0)
                                  (= (get colors (cast i64 current)) 0))
                        (set! (mut colors) (cast i64 current) 1)
                        (set! current (previous graph current)))
                      (when (and (!= current 0)
                                 (= (get colors (cast i64 current)) 1))
                        (set! error "cycle in terminal return chain"))
                      (when (= error "")
                        (set! current (cast i32 i))
                        (while (and (!= current 0)
                                    (= (get colors (cast i64 current)) 1))
                          (set! (mut colors) (cast i64 current) 2)
                          (set! count (+ count 1))
                          (set! current (previous graph current))))))
                  (if listed
                      (set! k (+ k 1))
                      (set! i (+ i (/ (+ (cast i64 (get (.arities graph) i)) 4) 4))))))
              (free! (mut colors))
              (if (= error "") (Ok count) (Err error)))))))
