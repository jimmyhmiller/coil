;;; Demand-driven SSA construction for the nonescaping fields classified by
;;; mem2ssa. Follows pinned ir_mem2ssa.c's control/value separation and typed
;;; Phi renaming. Explicit work frames keep host stack usage bounded. See NOTICE.
(module stogir.mem2ssa-flow)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.cfg" :as cfg)
(import "stogir.adjacency" :as adj)
(import "stogir.mem2ssa-state" :use [Cell])
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Created [(reference i32) (owner i32)])

(defstruct Frame [(block i32) (edge i64) (phi i32) (value i32)])

(defstruct State
  [(blocks cfg/Blocks)
   (pred adj/Index)
   (outputs (HashMap u64 i32))
   (inputs (HashMap u64 i32))
   (active (HashMap u64 u64))
   (epoch u64)
   (created (ArrayList Created))
   (a (dyn Allocator))])

(defn key [(block i32) (cell i32)] (-> u64)
  (| (cast u64 (cast u32 block)) (<< (cast u64 (cast u32 cell)) 32)))

(defn publish! [(s (ptr State)) (block i32) (cell i32) (value i32)] (-> void)
  (set! (mut (.inputs s)) (key block cell) value)
  ; The last store in a block is its outgoing value, independent of its input.
  (match (get (.outputs s) (key block cell))
    (Some [_] 0)
    (None [] (set! (mut (.outputs s)) (key block cell) value))))

;;; Resolve the value on block entry. A join is published before walking its
;;; predecessors, breaking loop cycles. Single-predecessor cycles without a
;;; published join are uninitialized; an epoch detects them without recursion.
(defn incoming! [(s (ptr State))
                 (graph (mut g/Graph))
                 (block i32)
                 (cell i32)
                 (description Cell)
                 (complete (mut (ArrayList i32)))]
  (-> (Result i32 (slice u8)))
  (let [(mut stack) (ArrayList::new [Frame] (.a s))
        (mut error) ""]
    (set! (.epoch s) (+ (.epoch s) 1))
    (push! (mut stack)
           (Frame
             :block block
             :edge -1
             :phi 0
             :value 0))
    (while (and (= error "") (> (len stack) 0))
      (let [index (- (len stack) 1)
            (mut frame) (get stack index)
            k (key (.block frame) cell)
            range (get (.ranges (.pred s)) (cast i64 (.block frame)))]
        (if (< (.edge frame) 0)
            (match (get (.inputs s) k)
              (Some [_] (pop! (mut stack)))
              (None []
                    (let [cycle
                            (match (get (.active s) k)
                              (Some [epoch] (= epoch (.epoch s)))
                              (None [] false))]
                      (set! (mut (.active s)) k (.epoch s))
                      (if (or cycle
                              (= (.count range) 0)
                              (= (.block frame)
                                 (get (.membership (.blocks s))
                                      (cast i64 (.owner description)))))
                          (do
                            (publish! s (.block frame) cell 0)
                            (pop! (mut stack)))
                          (do
                            (set! (.edge frame) 0)
                            (when (> (.count range) 1)
                              (let [(mut operands) (ArrayList::new [i32] (.a s))]
                                (push! (mut operands) (.block frame))
                                (for [i 0 (.count range)]
                                  (push! (mut operands) 0))
                                (match (g/append-inputs! (mut graph)
                                                         67
                                                         (.ty description)
                                                         (slice operands))
                                  (None []
                                        (set! error
                                              "promotion Phi reference space exhausted"))
                                  (Some [phi]
                                        (set! (.phi frame) phi)
                                        (publish! s (.block frame) cell phi)
                                        (push! (mut (.created s))
                                               (Created
                                                 :reference phi
                                                 :owner (.owner description)))
                                        (set! (.epoch s) (+ (.epoch s) 1))))
                                (free! (mut operands))))
                            (set! (mut stack) index frame))))))
            (if (>= (.edge frame) (.count range))
                (do
                  (publish! s
                            (.block frame)
                            cell
                            (if (> (.phi frame) 0) (.phi frame) (.value frame)))
                  (pop! (mut stack)))
                (let [edge
                        (get (.edges (.blocks s))
                             (get (.edges (.pred s))
                                  (+ (.offset range) (.edge frame))))
                      predecessor (.from edge)]
                  (match (get (.outputs s) (key predecessor cell))
                    (None []
                          (push! (mut stack)
                                 (Frame
                                   :block predecessor
                                   :edge -1
                                   :phi 0
                                   :value 0)))
                    (Some [value]
                          (when (= value 0)
                            (set! (mut complete)
                                  (cast i64 (.owner description))
                                  0))
                          (if (> (.phi frame) 0)
                              (g/set-operand! (mut graph)
                                              (.phi frame)
                                              (+ (.position edge) 1)
                                              value)
                              (set! (.value frame) value))
                          (set! (.edge frame) (+ (.edge frame) 1))
                          (set! (mut stack) index frame))))))))
    (free! (mut stack))
    (if (!= error "")
        (Err error)
        (Ok (match (get (.inputs s) (key block cell)) (Some [v] v) (None [] 0))))))

(defn append-owned! [(s (ptr State)) (graph (mut g/Graph))
                      (owner i32) (opcode u8) (ty u8) (inputs (slice i32))]
  (-> i32)
  (match (g/append-inputs! (mut graph) opcode ty inputs)
    (None [] 0)
    (Some [reference]
      (push! (mut (.created s)) (Created :reference reference :owner owner))
      reference)))

;;; A provisional COPY supplies the previous cell value. Outgoing expressions
;;; must exist before predecessor traversal, including loop backedges. Patch the
;;; COPY during the ordered block walk; incomplete owners discard every created
;;; expression together with their provisional Phis.
(defstruct Insertion [(value i32) (previous i32)])

(defn partial-store! [(s (ptr State)) (graph (mut g/Graph))
                       (cell Cell) (input i32) (width i32)] (-> (Result Insertion (slice u8)))
  (let [ty (.ty cell)
        full (if (= (.size cell) 8) (: 0xFFFFFFFFFFFFFFFF u64)
                 (- (<< (: 1 u64) (cast u64 (* (.size cell) 8))) 1))
        low (- (<< (: 1 u64) (cast u64 (* width 8))) 1)]
    (match (g/intern-scalar! (mut graph) ty 0)
      (None [] (Err "promotion zero reference space exhausted"))
      (Some [zero]
        (match (g/intern-scalar! (mut graph) ty (^ full low))
          (None [] (Err "promotion mask reference space exhausted"))
          (Some [mask]
            (let [old (append-owned! s (mut graph) (.owner cell) 68 ty [zero (: 0 i32)])
                  high (append-owned! s (mut graph) (.owner cell) 47 ty [old mask])
                  extended (append-owned! s (mut graph) (.owner cell) 34 ty [input])
                  value (append-owned! s (mut graph) (.owner cell) 48 ty [high extended])]
              (if (or (= old 0) (= high 0) (= extended 0) (= value 0))
                  (Err "promotion insertion reference space exhausted")
                  (Ok (Insertion :value value :previous old))))))))))

(defn apply! [(graph (mut g/Graph))
              (starts (ArrayList i32))
              (next (ArrayList i32))
              (accesses (ArrayList i32))
              (eligible (ArrayList i32))
              (complete (mut (ArrayList i32)))
              (cells (mut (ArrayList Cell)))
              (data (mut (ArrayList i32)))
              (casts (mut (ArrayList i32)))
              (control (mut (ArrayList i32)))
              (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (cfg/build graph a)
    (Err [message] (Err message))
    (Ok [blocks]
        (let [(mut state)
                (State
                  :blocks blocks
                  :pred (adj/build blocks true a)
                  :outputs (HashMap::new-scalar [u64 i32] a)
                  :inputs (HashMap::new-scalar [u64 i32] a)
                  :active (HashMap::new-scalar [u64 u64] a)
                  :epoch 0
                  :created (ArrayList::new [Created] a)
                  :a a)
              s (cast (ptr State) (mut state))
              (mut stored) (ArrayList::new [i32] a)
              (mut previous) (ArrayList::new [i32] a)
              (mut error) ""
              (mut changes) (: 0 i32)]
          (for [i 0 (len accesses)] (push! (mut stored) 0))
          ; Record outgoing definitions before requesting any incoming values.
          (for block starts
            (let [(mut current) (get next (cast i64 block))]
              (while (> current 0)
                (let [node (get (.instructions graph) (cast i64 current))
                      id (get accesses (cast i64 current))]
                  (when (and (> id 0) (= (n/opcode node) 93))
                    (let [cell (get cells (cast i64 (- id 1)))]
                      (when (> (get eligible (cast i64 (.owner cell))) 0)
                        (let [input (.op3 node)
                              ty
                                (match (g/lookup graph input)
                                  (Some [v] (n/type-id v))
                                  (None [] (: 0 u8)))
                              width (types/size (cast i32 ty) 8)
                              canonical
                                (if (< width (.size cell))
                                    (match (partial-store! s (mut graph) cell input width)
                                      (Err [message] (set! error message) (: 0 i32))
                                      (Ok [pair]
                                        (when (= (len previous) 0)
                                          (reserve! (mut previous) (len accesses))
                                          (for [i 0 (len accesses)] (push! (mut previous) 0)))
                                        (set! (mut previous) (cast i64 current) (.previous pair))
                                        (.value pair)))
                                    (if (= ty (.ty cell))
                                        input
                                        (match (g/append-inputs! (mut graph)
                                                                 36
                                                                 (.ty cell)
                                                                 [input])
                                          (Some [r] r)
                                          (None [] 0))))]
                          (when (and (= canonical 0) (= error ""))
                            (set! error
                                  "promotion cast reference space exhausted"))
                          (set! (mut stored) (cast i64 current) canonical)
                          (set! (mut (.outputs s)) (key block id) canonical)))))
                  (set! current (get next (cast i64 current)))))))
          (for block starts
            (let [(mut current) (get next (cast i64 block))]
              (while (and (> current 0) (= error ""))
                (let [node (get (.instructions graph) (cast i64 current))
                      id (get accesses (cast i64 current))]
                  (when (> id 0)
                    (let [index (cast i64 (- id 1))
                          (mut cell) (get cells index)
                          owner (cast i64 (.owner cell))]
                      (when (> (get eligible owner) 0)
                        (if (= (n/opcode node) 93)
                            (do
                              (let [old (if (= (len previous) 0) (: 0 i32)
                                             (get previous (cast i64 current)))]
                                (when (> old 0)
                                  (match (if (= (.block cell) block)
                                             (Ok [i32 (slice u8)] (.value cell))
                                             (incoming! s (mut graph) block id cell (mut complete)))
                                    (Err [message] (set! error message))
                                    (Ok [value]
                                      (if (= value 0)
                                          (set! (mut complete) owner 0)
                                          (g/set-operand! (mut graph) old 1 value))))))
                              (set! (.value cell)
                                    (get stored (cast i64 current)))
                              (set! (.block cell) block)
                              (set! (mut cells) index cell))
                            (let [incoming
                                    (if (= (.block cell) block)
                                        (Ok [i32 (slice u8)] (.value cell))
                                        (incoming! s
                                                   (mut graph)
                                                   block
                                                   id
                                                   cell
                                                   (mut complete)))]
                              (match incoming
                                (Err [message] (set! error message))
                                (Ok [value]
                                    (if (= value 0)
                                        (set! (mut complete) owner 0)
                                        (do
                                          (if (= (n/type-id node) (.ty cell))
                                              (set! (mut data)
                                                    (cast i64 current)
                                                    value)
                                              (set! (mut casts)
                                                    (cast i64 current)
                                                    value))
                                          (set! (mut control)
                                                (cast i64 current)
                                                (.op1 node)))))))))))
                  (set! current (get next (cast i64 current)))))))
          ; Uninitialized paths retain the whole allocation. Discard provisional
          ; Phis and partial-store expressions together before exposing the graph.
          (for created (.created s)
            (if (= (get complete (cast i64 (.owner created))) 0)
                (g/make-nop! (mut graph) (.reference created))
                (set! changes (+ changes 1))))
          (for [i 0 (len accesses)]
            (let [id (get accesses i)]
              (when (and (> id 0)
                         (= (get complete
                                 (cast i64
                                       (.owner (get cells (cast i64 (- id 1))))))
                            0))
                (set! (mut data) i 0)
                (set! (mut casts) i 0)
                (set! (mut control) i 0))))
          (free! (mut stored))
          (free! (mut previous))
          (free! (mut (.outputs s)))
          (free! (mut (.inputs s)))
          (free! (mut (.active s)))
          (free! (mut (.created s)))
          (adj/release! (mut (.pred s)))
          (cfg/release! (mut (.blocks s)))
          (if (= error "") (Ok changes) (Err error))))))
