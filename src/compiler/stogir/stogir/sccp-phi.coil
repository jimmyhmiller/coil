;;; Feasible-input Phi transfer from pinned ir_sccp.c:ir_sccp_analyze_phi.
;;; The enclosing SCCP analysis owns graph verification and use notification.
(module stogir.sccp-phi)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.sccp-values" :as values)
(import "stogir.uses" :as uses)
(import "coil.result" :use [Some None])
(import "coil.panic" :use [panic])

(defn input [(graph g/Graph) (reference i32) (index i32)] (-> i32)
  (match (g/operand graph reference index)
    (Some [value] value)
    (None [] (panic "invalid SCCP Phi operand {}:{}" reference index))))

(defn constant [(graph g/Graph) (reference i32)] (-> n/Node)
  (match (g/lookup graph reference)
    (Some [node] node)
    (None [] (panic "invalid SCCP constant reference {}" reference))))

(defn same-constant? [(left n/Node) (right n/Node)] (-> bool)
  (and (= (& (.header left) 65535) (& (.header right) 65535))
       (= (n/constant-bits left) (n/constant-bits right))))

;;; Preconditions: verified Phi/region shape and types; domain covers all graph
;;; cells; incoming control facts are valid; the Phi is not already bottom.
;;; Self identities and infeasible predecessors do not contribute to the meet.
;;; Top inputs trigger once-only backward discovery. A differing candidate
;;; splits a former copy partition through the shared combined value domain.
(defn transfer! [(graph g/Graph)
                 (domain (mut values/Domain))
                 (edges uses/Uses)
                 (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        region (.op1 node)
        phi-identity (values/identity domain reference)
        count (get (.arities graph) (cast i64 reference))
        (mut selected) false
        (mut mismatch) false
        (mut chosen-copy) (: 0 i32)
        (mut chosen-identity) (: 0 i32)
        (mut chosen-constant) (n/make 0 0 0 0 0 0)
        (mut index) (: 2 i32)]
    (when (values/reachable? domain region)
      ; Match upstream's retention of long Phi operand cells. They are storage,
      ; not independent top-valued instructions to discover or eliminate.
      (when (and (> count 3) (values/top? domain reference))
        (for [tail 1 (cast i64 (+ 1 (/ count 4)))]
          (values/kind! (mut domain) (+ reference (cast i32 tail)) (op/count))))
      (while (and (<= index count) (not mismatch))
        (let [predecessor (input graph region (- index 1))]
          (when (values/reachable? domain predecessor)
            (let [source (input graph reference index)
                  (mut candidate) false
                  (mut copy) (: 0 i32)
                  (mut identity) (: 0 i32)
                  (mut literal) (n/make 0 0 0 0 0 0)]
              (if (< source 0)
                  (let [value (constant graph source)]
                    (set! candidate true)
                    (if (= (n/opcode value) 78)
                        (set! copy source)
                        (set! literal value)))
                  (when (!= source reference)
                    (let [value (values/at domain source)
                          kind (values/state-kind value)]
                      (if (= kind 0)
                          (values/add-input! (mut domain) source)
                          (if (= kind 68)
                              (let [root (values/identity domain (.op1 value))]
                                (when (!= root phi-identity)
                                  (set! candidate true)
                                  (set! copy (.op1 value))
                                  (set! identity root)))
                              (if (= kind 78)
                                  (do
                                    (set! candidate true)
                                    (set! copy (.op2 value)))
                                  (if (= kind (op/count))
                                      (when (!= source phi-identity)
                                        (set! candidate true)
                                        (set! copy source)
                                        (set! identity source))
                                      (do
                                        (set! candidate true)
                                        (set! literal value)))))))))
              (when candidate
                (if (not selected)
                    (do
                      (set! selected true)
                      (set! chosen-copy copy)
                      (set! chosen-identity identity)
                      (set! chosen-constant literal))
                    (if (!= chosen-copy 0)
                        (when (or (= copy 0)
                                  (if (< chosen-copy 0)
                                      (!= chosen-copy copy)
                                      (!= chosen-identity identity)))
                          (set! mismatch true))
                        (when (or (!= copy 0)
                                  (not (same-constant? chosen-constant literal)))
                          (set! mismatch true))))))))
        (set! index (+ index 1))))
    (if mismatch
        (do (values/make-bottom! (mut domain) edges reference) true)
        (if (not selected)
            false
            (if (> chosen-copy 0)
                (values/meet-copy! (mut domain) edges reference chosen-copy)
                (if (< chosen-copy 0)
                    (values/meet-long! (mut domain)
                                       edges
                                       reference
                                       chosen-copy
                                       (constant graph chosen-copy))
                    (values/meet-constant! (mut domain)
                                           edges
                                           reference
                                           chosen-constant)))))))
