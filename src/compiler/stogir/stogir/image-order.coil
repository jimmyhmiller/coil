;;; Stable O(n log n) image relocation order and overlap validation.
(module stogir.image-order)
(import "stogir.image" :as image)
(import "stogir.text-data" :as text-data)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(defn before? [(a image/Relocation) (b image/Relocation)] (-> bool)
  (or (< (.section a) (.section b))
      (and (= (.section a) (.section b)) (>= (.offset a) (.offset b)))))

(defn relocations [(source image/Image) (allocator (dyn Allocator))]
  (-> (Result (ArrayList image/Relocation) (slice u8)))
  (let [(mut ordered) (ArrayList::new [image/Relocation] allocator)
        (mut scratch) (ArrayList::new [image/Relocation] allocator)
        count (len (.relocations source))
        (mut error) ""
        (mut width) (: 1 i64)]
    (when (not (image/valid-alignments? source))
      (set! error
            (if (image/known-machine? (.machine source))
                "invalid image section alignment"
                "unknown image machine")))
    (match (text-data/validate (.text-data source) (len (.text source)))
      (Err [message] (set! error message))
      (Ok [_] 0))
    (for relocation (.relocations source)
      (match (image/check-relocation source relocation)
        (Err [message] (set! error message))
        (Ok [_] 0))
      (push! (mut ordered) relocation)
      (push! (mut scratch) relocation))
    (while (and (= error "") (< width count))
      (let [(mut start) 0]
        (while (< start count)
          (let [mid (if (< (+ start width) count) (+ start width) count)
                end
                  (if (< (+ start (* width 2)) count)
                      (+ start (* width 2))
                      count)
                (mut a) start
                (mut b) mid
                (mut out) start]
            (while (< out end)
              (if (and (< a mid)
                       (or (>= b end) (before? (get ordered a) (get ordered b))))
                  (do (set! (mut scratch) out (get ordered a)) (set! a (+ a 1)))
                  (do (set! (mut scratch) out (get ordered b)) (set! b (+ b 1))))
              (set! out (+ out 1))))
          (set! start (+ start (* width 2)))))
      (let [(mut i) 0]
        (while (< i count)
          (set! (mut ordered) i (get scratch i))
          (set! i (+ i 1))))
      (set! width (* width 2)))
    (let [(mut i) 1]
      (while (and (= error "") (< i count))
        (let [previous (get ordered (- i 1))
              current (get ordered i)
              size (image/relocation-width (.kind current))]
          (when (and (= (.section current) (.section previous))
                     (> (+ (.offset current) size) (.offset previous)))
            (set! error "overlapping image relocations")))
        (set! i (+ i 1))))
    (free! (mut scratch))
    (if (= error "") (Ok ordered) (do (free! (mut ordered)) (Err error)))))
