; Ported/adapted from dstogov/ir (ir_fold.h), commit 92171d0. See NOTICE.
;;; Integer constant rules corresponding to upstream ir_fold.h.
(module stogir.fold)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.symbols" :as symbols)
(import "stogir.types" :as t)
(import "stogir.integer-unary" :as unary)
(import "stogir.integer-binary" :as binary)
(import "coil.result" :use [Option Some None])

;;; Preserve upstream's refusal to fold divide-by-zero and signed min/-1.
;;; Widened signed arithmetic avoids host overflow even for 64-bit constants.
(defn integer-division [(opcode i32) (ty i32) (width i32) (a u64) (b u64)]
  (-> (Option u64))
  (let [modulus (<< (: 1 i128) (cast i128 width))
        mask (cast u64 (- modulus 1))
        x (& a mask)
        y (& b mask)
        sign (<< (: 1 u64) (cast u64 (- width 1)))]
    (if (or (= y 0) (and (t/signed? ty) (= x sign) (= y mask)))
        (None)
        (if (t/signed? ty)
            (let [sx
                    (if (!= (& x sign) 0)
                        (- (cast i128 x) modulus)
                        (cast i128 x))
                  sy
                    (if (!= (& y sign) 0)
                        (- (cast i128 y) modulus)
                        (cast i128 y))]
              (Some (& (cast u64 (if (= opcode 29) (/ sx sy) (% sx sy))) mask)))
            (Some (if (= opcode 29) (/ x y) (% x y)))))))

;;; A missing result means no applicable rule. Wide arithmetic avoids host overflow
;;; before explicit truncation to the IR result width. Pointer width is target-owned.
(defn integer-binary [(opcode i32) (ty i32) (pointer-bytes i32) (a u64) (b u64)]
  (-> (Option u64))
  (let [size (t/scalar-size ty pointer-bytes)]
    (if (or (not (binary/valid-type? opcode ty))
            (<= size 0)
            (and (= ty 1) (or (> a 1) (> b 1))))
        (None)
        (let [width (* size 8)
              mask
                (if (= width 64)
                    (: 0xFFFFFFFFFFFFFFFF u64)
                    (- (<< (: 1 u64) (cast u64 width)) 1))
              x (cast u128 (& a mask))
              y (cast u128 (& b mask))]
          (match opcode
            (26 (Some (& (cast u64 (+ x y)) mask)))
            (27 (Some (& (cast u64 (- (+ x (: 18446744073709551616 u128)) y))
                         mask)))
            (28 (Some (& (cast u64 (* x y)) mask)))
            (29 (integer-division opcode ty width a b))
            (30 (integer-division opcode ty width a b))
            (58 (let [bias
                        (if (t/signed? ty)
                            (<< (: 1 u64) (cast u64 (- width 1)))
                            (: 0 u64))]
                  (Some (cast u64
                              (if (<= (^ (cast u64 x) bias)
                                      (^ (cast u64 y) bias))
                                  x
                                  y)))))
            (59 (let [bias
                        (if (t/signed? ty)
                            (<< (: 1 u64) (cast u64 (- width 1)))
                            (: 0 u64))]
                  (Some (cast u64
                              (if (>= (^ (cast u64 x) bias)
                                      (^ (cast u64 y) bias))
                                  x
                                  y)))))
            (46 (Some (& (| a b) mask)))
            (47 (Some (& (& a b) mask)))
            (48 (Some (& (^ a b) mask)))
            (49 (Some (& (<< (& a mask) (& b (cast u64 (- width 1)))) mask)))
            (50 (Some (>> (& a mask) (& b (cast u64 (- width 1))))))
            (51 (let [shift (& b (cast u64 (- width 1)))
                      value (& a mask)
                      sign (<< (: 1 u64) (cast u64 (- width 1)))
                      fill
                        (if (and (!= (& value sign) 0) (!= shift 0))
                            (^ mask (>> mask shift))
                            (: 0 u64))]
                  (Some (| (>> value shift) fill))))
            (52 (let [shift (& b (cast u64 (- width 1)))
                      value (& a mask)]
                  (Some (if (= shift 0)
                            value
                            (& (| (<< value shift)
                                  (>> value (- (cast u64 width) shift)))
                               mask)))))
            (53 (let [shift (& b (cast u64 (- width 1)))
                      value (& a mask)]
                  (Some (if (= shift 0)
                            value
                            (& (| (>> value shift)
                                  (<< value (- (cast u64 width) shift)))
                               mask)))))
            (_ (None)))))))

(defn binary! [(graph (mut g/Graph))
               (opcode i32)
               (ty i32)
               (pointer-bytes i32)
               (left i32)
               (right i32)] (-> (Option i32))
  (if (and (or (= opcode 58) (= opcode 59)) (= left right))
      (match (g/lookup graph left)
        (None [] (None))
        (Some [node]
              (if (and (binary/valid-type? opcode ty)
                       (> (t/scalar-size ty pointer-bytes) 0)
                       (= (cast i32 (n/type-id node)) ty))
                  (Some left)
                  (None))))
      (binary-values! (mut graph) opcode ty pointer-bytes left right)))

(defn binary-values! [(graph (mut g/Graph))
                      (opcode i32)
                      (ty i32)
                      (pointer-bytes i32)
                      (left i32)
                      (right i32)] (-> (Option i32))
  (if (or (>= left 0) (>= right 0))
      (None)
      (match (g/lookup graph left)
        (None [] (None))
        (Some [a]
              (match (g/lookup graph right)
                (None [] (None))
                (Some [b]
                      (if (or (not (symbols/numeric? a))
                              (not (symbols/numeric? b))
                              (!= (cast i32 (n/type-id a)) ty)
                              (!= (cast i32 (n/type-id b)) ty))
                          (None)
                          (match (integer-binary opcode
                                                 ty
                                                 pointer-bytes
                                                 (n/constant-bits a)
                                                 (n/constant-bits b))
                            (None [] (None))
                            (Some [bits]
                                  (if (or (= opcode 58) (= opcode 59))
                                      (Some (if (= bits (n/constant-bits a))
                                                left
                                                right))
                                      (g/intern-scalar! (mut graph)
                                                        (cast u8 ty)
                                                        bits)))))))))))

(defn integer-unary [(opcode i32) (ty i32) (pointer-bytes i32) (bits u64)]
  (-> (Option u64))
  (let [size (t/scalar-size ty pointer-bytes)]
    (if (or (not (unary/valid-type? opcode ty)) (<= size 0))
        (None)
        (if (= ty 1)
            (if (and (= opcode 45) (<= bits 1)) (Some (^ bits 1)) (None))
            (let [mask
                    (if (= size 8)
                        (: 0xFFFFFFFFFFFFFFFF u64)
                        (- (<< (: 1 u64) (cast u64 (* size 8))) 1))]
              (match opcode
                (31 (Some (& (cast u64
                                   (- (: 18446744073709551616 u128)
                                      (cast u128 (& bits mask))))
                             mask)))
                (32 (let [value (& bits mask)
                          sign (<< (: 1 u64) (cast u64 (- (* size 8) 1)))]
                      (Some (if (= (& value sign) 0)
                                value
                                (& (cast u64
                                         (- (: 18446744073709551616 u128)
                                            (cast u128 value)))
                                   mask)))))
                (45 (Some (^ (& bits mask) mask)))
                (54 (let [(mut value) (& bits mask)
                          (mut result) (: 0 u64)
                          (mut i) (: 0 i32)]
                      (while (< i size)
                        (set! result (| (<< result 8) (& value 255)))
                        (set! value (>> value 8))
                        (set! i (+ i 1)))
                      (Some result)))
                (55 (let [(mut value) (& bits mask)
                          (mut count) (: 0 u64)]
                      (while (!= value 0)
                        (set! count (+ count (& value 1)))
                        (set! value (>> value 1)))
                      (Some count)))
                (56 (let [(mut value) (& bits mask)
                          (mut count) (: 0 u64)
                          sign (<< (: 1 u64) (cast u64 (- (* size 8) 1)))]
                      (if (= value 0)
                          (None)
                          (do
                            (while (= (& value sign) 0)
                              (set! count (+ count 1))
                              (set! value (<< value 1)))
                            (Some count)))))
                (57 (let [(mut value) (& bits mask)
                          (mut count) (: 0 u64)]
                      (if (= value 0)
                          (None)
                          (do
                            (while (= (& value 1) 0)
                              (set! count (+ count 1))
                              (set! value (>> value 1)))
                            (Some count)))))
                (_ (None))))))))

(defn unary! [(graph (mut g/Graph))
              (opcode i32)
              (ty i32)
              (pointer-bytes i32)
              (value i32)] (-> (Option i32))
  (if (>= value 0)
      (None)
      (match (g/lookup graph value)
        (None [] (None))
        (Some [node]
              (if (or (not (symbols/numeric? node))
                      (!= (cast i32 (n/type-id node)) ty))
                  (None)
                  (match (integer-unary opcode
                                        ty
                                        pointer-bytes
                                        (n/constant-bits node))
                    (None [] (None))
                    (Some [bits]
                          (g/intern-scalar! (mut graph) (cast u8 ty) bits))))))))

;;; Signed comparisons bias the sign bit, then use unsigned ordering.
(defn integer-compare [(opcode i32)
                       (ty i32)
                       (pointer-bytes i32)
                       (a u64)
                       (b u64)]
  (-> (Option u64))
  (let [size (t/scalar-size ty pointer-bytes)]
    (if (or (< opcode 14) (> opcode 23) (not (t/integer? ty)) (<= size 0))
        (None)
        (let [width (* size 8)
              mask
                (if (= width 64)
                    (: 0xFFFFFFFFFFFFFFFF u64)
                    (- (<< (: 1 u64) (cast u64 width)) 1))
              bias
                (if (and (>= opcode 16) (<= opcode 19))
                    (<< (: 1 u64) (cast u64 (- width 1)))
                    (: 0 u64))
              x (^ (& a mask) bias)
              y (^ (& b mask) bias)
              result
                (match opcode
                  (14 (= x y))
                  (15 (!= x y))
                  (16 (< x y))
                  (17 (>= x y))
                  (18 (<= x y))
                  (19 (> x y))
                  (20 (< x y))
                  (21 (>= x y))
                  (22 (<= x y))
                  (23 (> x y))
                  (_ false))]
          (Some (if result (: 1 u64) (: 0 u64)))))))

(defn compare! [(graph (mut g/Graph))
                (opcode i32)
                (operand-type i32)
                (pointer-bytes i32)
                (left i32)
                (right i32)] (-> (Option i32))
  (if (or (>= left 0) (>= right 0))
      (None)
      (match (g/lookup graph left)
        (None [] (None))
        (Some [a]
              (match (g/lookup graph right)
                (None [] (None))
                (Some [b]
                      (if (or (not (symbols/numeric? a))
                              (not (symbols/numeric? b))
                              (!= (cast i32 (n/type-id a)) operand-type)
                              (!= (cast i32 (n/type-id b)) operand-type))
                          (None)
                          (match (integer-compare opcode
                                                  operand-type
                                                  pointer-bytes
                                                  (n/constant-bits a)
                                                  (n/constant-bits b))
                            (None [] (None))
                            (Some [bits] (g/intern-scalar! (mut graph) 1 bits))))))))))

;;; Pinned ir_fold.h OR/ADD(SHL,SHR) and rotate-by-one MUL restarts.
;;; Structural inputs only: transient lattice facts on grandchildren cannot
;;; justify a rewrite after an enclosing value has become Bottom.
(defn rotate [(graph g/Graph) (reference i32) (pointer-bytes i32)] (-> n/Node)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (n/opcode node)
        ty (cast i32 (n/type-id node))
        (mut result) (n/make 0 0 0 0 0 0)]
    (when (and (or (= opcode 46) (= opcode 26))
               (t/integer? ty) (!= ty 1) (!= ty 6)
               (> (.op1 node) 0) (> (.op2 node) 0))
      (let [left (get (.instructions graph) (cast i64 (.op1 node)))
            right (get (.instructions graph) (cast i64 (.op2 node)))
            width (cast u64 (* 8 (t/scalar-size ty pointer-bytes)))
            lc (.op2 left)
            rc (.op2 right)
            (mut source) (: 0 i32)
            (mut count) (: 0 i32)
            (mut rotation) (: 0 u8)]
        (when (and (= (n/type-id left) (n/type-id node))
                   (= (n/type-id right) (n/type-id node))
                   (= (.op1 left) (.op1 right)))
          (cond (or (and (= (n/opcode left) 49) (= (n/opcode right) 50))
                    (and (= (n/opcode left) 50) (= (n/opcode right) 49)))
                  (do
                    (when (and (< lc 0) (< rc 0))
                      (let [a (get (.constants graph) (- (- 0 (cast i64 lc)) 1))
                            b (get (.constants graph) (- (- 0 (cast i64 rc)) 1))
                            x (n/constant-bits a)
                            y (n/constant-bits b)]
                        (when (and (symbols/numeric? a) (symbols/numeric? b)
                                   (= (+ (cast u128 x) (cast u128 y)) (cast u128 width))
                                   ; ADD requires disjoint contributions. At an
                                   ; endpoint both masked shifts produce x.
                                   (or (= opcode 46) (and (> x 0) (< x width))))
                          (set! source (.op1 left))
                          (set! count lc)
                          (set! rotation (+ (n/opcode left) 3)))))
                    ; OR is valid even when the dynamic masked count is zero.
                    ; ADD would need an independent nonzero-count range proof.
                    (when (and (= rotation 0) (= opcode 46))
                      (for swapped [false true]
                        (let [first (if swapped right left)
                              second (if swapped left right)]
                          (when (> (.op2 second) 0)
                            (let [sub (get (.instructions graph) (cast i64 (.op2 second)))]
                              (when (and (= (n/opcode sub) 27)
                                         (< (.op1 sub) 0)
                                         (= (.op2 sub) (.op2 first)))
                                (let [literal (get (.constants graph) (- (- 0 (cast i64 (.op1 sub))) 1))]
                                  (when (and (symbols/numeric? literal)
                                             (= (n/constant-bits literal) width))
                                    (set! source (.op1 first))
                                    (set! count (.op2 first))
                                    (set! rotation (+ (n/opcode first) 3)))))))))))
                :else
                  (for swapped [false true]
                    (let [mul (if swapped right left)
                          shr (if swapped left right)]
                      (when (and (= (n/opcode mul) 28) (= (n/opcode shr) 50)
                                 (< (.op2 mul) 0) (< (.op2 shr) 0))
                        (let [a (get (.constants graph) (- (- 0 (cast i64 (.op2 mul))) 1))
                              b (get (.constants graph) (- (- 0 (cast i64 (.op2 shr))) 1))]
                          (when (and (symbols/numeric? a) (symbols/numeric? b)
                                     (= (n/constant-bits a) 2)
                                     (= (n/constant-bits b) (- width 1)))
                            (set! source (.op1 shr))
                            (set! count (.op2 shr))
                            (set! rotation 53))))))))
        (when (!= rotation 0)
          (set! result (n/make rotation (n/type-id node) 0 source count 0)))))
    result))
