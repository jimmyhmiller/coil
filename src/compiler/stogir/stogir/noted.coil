;;; What verify/structure-noting records for the checks that follow it on the
;;; same unchanged graph, so each of them reads its nodes from here instead of
;;; walking every node again.
(module stogir.noted)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])

;;; One reference operand naming a SWITCH: OPERAND of USER holds TARGET.
(defstruct SwitchUse [(target i32) (user i32) (operand i32)])

;;; nodes: every node start with a role in a later check, in increasing order.
;;; switch-uses: every reference operand whose value is a SWITCH node, in walk
;;; order (increasing user, then operand), which is the order of a use index.
(defstruct Noted [(nodes (ArrayList i32)) (switch-uses (ArrayList SwitchUse))])

(defn create [(a (dyn Allocator))] (-> Noted)
  (Noted :nodes (ArrayList::new [i32] a)
         :switch-uses (ArrayList::new [SwitchUse] a)))

(defn release! [(noted (mut Noted))] (-> void)
  (free! (mut (.nodes noted)))
  (free! (mut (.switch-uses noted))))
