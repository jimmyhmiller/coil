;;; Ordered register-use constraints for linear-scan allocation.
(module stogir.constraints)
(import "coil.arraylist" :use [ArrayList])

;;; kind: 0=location allowed, 1=register required, 2=fixed register required.
;;; Fixed register numbering is target/register-class specific.
(defstruct Use [(position i64) (kind i32) (register i32)])

;;; Merge coincident requirements. Returns false on incompatible fixed registers
;;; or invalid input, without changing existing constraints.
(defn add! [(uses (mut (ArrayList Use)))
            (position i64)
            (kind i32)
            (register i32)]
  (-> bool)
  (if (or (< position 0) (< kind 0) (> kind 2) (and (= kind 2) (< register 0)))
      false
      (let [(mut index) 0]
        (while (and (< index (len uses))
                    (< (.position (get uses index)) position))
          (set! index (+ index 1)))
        (if (and (< index (len uses)) (= (.position (get uses index)) position))
            (let [old (get uses index)]
              (if (and (= (.kind old) 2)
                       (= kind 2)
                       (!= (.register old) register))
                  false
                  (do
                    (when (> kind (.kind old))
                      (set! (mut uses)
                            index
                            (Use
                              :position position
                              :kind kind
                              :register register)))
                    true)))
            (do
              (push! (mut uses)
                     (Use
                       :position position
                       :kind kind
                       :register register))
              (let [(mut i) (- (len uses) 1)]
                (while (> i index)
                  (set! (mut uses) i (get uses (- i 1)))
                  (set! i (- i 1))))
              (set! (mut uses)
                    index
                    (Use
                      :position position
                      :kind kind
                      :register register))
              true)))))

;;; First constraint at/after position with at least minimum-kind, or -1.
(defn next-use [(uses (ArrayList Use)) (position i64) (minimum-kind i32)]
  (-> i64)
  (let [(mut lo) 0
        (mut hi) (len uses)]
    (while (< lo hi)
      (let [mid (+ lo (/ (- hi lo) 2))]
        (if (< (.position (get uses mid)) position)
            (set! lo (+ mid 1))
            (set! hi mid))))
    (let [(mut found) -1]
      (while (and (< lo (len uses)) (< found 0))
        (let [use (get uses lo)]
          (when (>= (.kind use) minimum-kind) (set! found (.position use))))
        (set! lo (+ lo 1)))
      found)))

;;; Last constraint strictly before position with at least minimum-kind, or -1.
(defn last-use-before [(uses (ArrayList Use)) (position i64) (minimum-kind i32)]
  (-> i64)
  (let [(mut lo) 0
        (mut hi) (len uses)]
    (while (< lo hi)
      (let [mid (+ lo (/ (- hi lo) 2))]
        (if (< (.position (get uses mid)) position)
            (set! lo (+ mid 1))
            (set! hi mid))))
    (let [(mut found) -1]
      (while (and (> lo 0) (< found 0))
        (set! lo (- lo 1))
        (let [use (get uses lo)]
          (when (>= (.kind use) minimum-kind) (set! found (.position use)))))
      found)))

;;; Exact fixed requirement at a scan position, or -1 when none exists.
(defn required-at [(uses (ArrayList Use)) (position i64)] (-> i32)
  (let [(mut lo) 0
        (mut hi) (len uses)]
    (while (< lo hi)
      (let [mid (+ lo (/ (- hi lo) 2))]
        (if (< (.position (get uses mid)) position)
            (set! lo (+ mid 1))
            (set! hi mid))))
    (if (and (< lo (len uses))
             (= (.position (get uses lo)) position)
             (= (.kind (get uses lo)) 2))
        (.register (get uses lo))
        -1)))

;;; Earliest future fixed requirement incompatible with selected register.
(defn register-limit [(uses (ArrayList Use)) (position i64) (register i32)]
  (-> i64)
  (let [(mut result) (: 0x7FFFFFFFFFFFFFFF i64)
        (mut i) 0]
    (while (and (< i (len uses)) (= result 0x7FFFFFFFFFFFFFFF))
      (let [use (get uses i)]
        (when (and (>= (.position use) position)
                   (= (.kind use) 2)
                   (!= (.register use) register))
          (set! result (.position use))))
      (set! i (+ i 1)))
    result))

;;; The first effective fixed use limits every register except its own. That
;;; register is limited by the first subsequent use requiring a different one.
;;; MAX positions are inert, matching register-limit's unbounded sentinel.
(defstruct FixedLimits [(register i32) (first i64) (other i64)])

(defn fixed-limits [(uses (ArrayList Use)) (position i64)] (-> FixedLimits)
  (let [(mut result) (FixedLimits :register -1 :first 0x7FFFFFFFFFFFFFFF
                                 :other 0x7FFFFFFFFFFFFFFF)
        (mut seen) false (mut done) false (mut i) 0]
    (while (and (< i (len uses)) (not done))
      (let [use (get uses i)]
        (when (and (>= (.position use) position) (= (.kind use) 2)
                   (!= (.position use) 0x7FFFFFFFFFFFFFFF))
          (if (not seen)
              (do (set! (.register result) (.register use))
                  (set! (.first result) (.position use)) (set! seen true))
              (when (!= (.register use) (.register result))
                (set! (.other result) (.position use)) (set! done true)))))
      (set! i (+ i 1)))
    result))

(defn summarized-register-limit [(limits FixedLimits) (register i32)] (-> i64)
  (if (= register (.register limits)) (.other limits) (.first limits)))
