;;; Compose address-independent images without mutating inputs or their IDs.
(module stogir.link)
(import "stogir.image" :as image)
(import "stogir.alignment" :as alignment)
(import "stogir.image-order" :as order)
(import "stogir.text-data" :as text-data)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.alloc" :use [Allocator])
(import "coil.slice" :use [subslice])
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Part [(text i64) (data i64) (symbols (ArrayList i32))])

(defstruct Module [(image image/Image) (parts (ArrayList Part))])

(defn release! [(module (mut Module))] (-> void)
  (for part (.parts module)
    (let [(mut ids) (.symbols part)] (free! (mut ids))))
  (free! (mut (.parts module)))
  (image/release! (mut (.image module))))

;;; Requires validated name bounds; views borrow the immutable input image.
(defn name [(source image/Image) (symbol image/Symbol)] (-> (slice u8))
  (subslice (slice (.names source))
            (.name symbol)
            (+ (.name symbol) (.length symbol))))

;;; Do not trust an input's mutable hash heads or collision links. Validate names
;;; with a separate index so raw duplicate records cannot be silently merged.
(defn validate-symbols [(source image/Image) (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut heads) (HashMap::new-scalar [u64 i32] allocator)
        (mut next) (ArrayList::new [i32] allocator)
        (mut error) ""
        (mut i) (: 0 i64)]
    (when (> (len (.symbols source)) 2147483647)
      (set! error "input symbol count exceeds i32"))
    (while (and (= error "") (< i (len (.symbols source))))
      (let [symbol (get (.symbols source) i)
            section (.section symbol)
            size (if (= section 1) (len (.text source)) (len (.data source)))]
        (if (or (< section 0)
                (> section 2)
                (< (.offset symbol) 0)
                (and (= section 0)
                     (or (!= (.offset symbol) 0) (not (.global? symbol))))
                (and (!= section 0) (> (.offset symbol) size))
                (< (.name symbol) 0)
                (<= (.length symbol) 0)
                (> (.length symbol) (len (.names source)))
                (> (.name symbol) (- (len (.names source)) (.length symbol))))
            (set! error "invalid input image symbol")
            (let [text (name source symbol)
                  hash (image/hash-name text)
                  head
                    (match (get heads hash) (Some [id] id) (None [] (: -1 i32)))
                  (mut cursor) head]
              (for byte text
                (when (= byte 0) (set! error "input symbol name contains zero")))
              (while (and (= error "") (>= cursor 0))
                (let [previous (get (.symbols source) (cast i64 cursor))]
                  (when (image/same-name? source previous text)
                    (set! error "duplicate input symbol name"))
                  (set! cursor (get next (cast i64 cursor)))))
              (push! (mut next) head)
              (set! (mut heads) hash (cast i32 i)))))
      (set! i (+ i 1)))
    (free! (mut heads))
    (free! (mut next))
    (if (= error "") (Ok (cast i32 i)) (Err error))))

(defn validate [(source image/Image) (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (if (!= (% (len (.text source)) 4) 0)
      (Err "input text must be instruction aligned")
      (match (validate-symbols source allocator)
        (Err [message] (Err message))
        (Ok [count]
            (match (order/relocations source allocator)
              (Err [message] (Err message))
              (Ok [records]
                  (let [(mut owned) records] (free! (mut owned)) (Ok count))))))))

(defn aligned [(offset i64) (required i64)] (-> (Result i64 (slice u8)))
  (alignment/up offset required))

(defn bind-global! [(output (mut image/Image))
                    (source image/Image)
                    (symbol image/Symbol)
                    (offset i64)]
  (-> (Result i32 (slice u8)))
  (let [text (name source symbol)
        (mut duplicate?) false]
    (match (image/find-symbol output text)
      (None [] 0)
      (Some [id]
            (when (and (!= (.section symbol) 0)
                       (!= (.section (get (.symbols output) (cast i64 id))) 0))
              (set! duplicate? true))))
    (if duplicate?
        (Err "multiple public symbol definitions")
        (image/symbol! (mut output) text (.section symbol) offset))))

;;; Preserve every input section requirement and raise output requirements to
;;; their maxima, so nested composition retains absolute object alignment.
(defn compose [(sources (slice image/Image)) (allocator (dyn Allocator))]
  (-> (Result Module (slice u8)))
  (let [(mut result)
          (Module
            :image (image/create allocator)
            :parts (ArrayList::new [Part] allocator))
        (mut text-size) (: 0 i64)
        (mut data-size) (: 0 i64)
        (mut error) ""
        (mut i) (: 0 i64)]
    ; Plan and validate every source before copying bytes or binding names.
    (for source sources
      (when (= error "")
        (match (validate source allocator)
          (Err [message] (set! error message))
          (Ok [_] 0))
        (match (aligned text-size (.text-alignment source))
          (Err [message] (set! error message))
          (Ok [value] (set! text-size value)))
        (match (aligned data-size (.data-alignment source))
          (Err [message] (set! error message))
          (Ok [value] (set! data-size value)))
        (when (= error "")
          (image/require-alignments! (mut (.image result))
                                     (.text-alignment source)
                                     (.data-alignment source))
          (let [(mut ids) (ArrayList::new [i32] allocator)]
            (for symbol (.symbols source) (push! (mut ids) -1))
            (push! (mut (.parts result))
                   (Part
                     :text text-size
                     :data data-size
                     :symbols ids)))
          (if (or (> (len (.text source))
                     (- (: 0x7FFFFFFFFFFFFFFF i64) text-size))
                  (> (len (.data source))
                     (- (: 0x7FFFFFFFFFFFFFFF i64) data-size)))
              (set! error "image composition section overflow")
              (do
                (set! text-size (+ text-size (len (.text source))))
                (set! data-size (+ data-size (len (.data source)))))))))
    ; Bind all public names before generating any private names, including names
    ; that happen to use the private-label prefix. Declaration IDs stay stable.
    (while (and (= error "") (< i (len sources)))
      (let [source (get sources i)
            part (get (.parts result) i)
            (mut j) (: 0 i64)]
        (for symbol (.symbols source)
          (when (and (= error "") (.global? symbol))
            (let [offset
                    (+ (.offset symbol)
                       (if (= (.section symbol) 1)
                           (.text part)
                           (if (= (.section symbol) 2) (.data part) 0)))]
              (match (bind-global! (mut (.image result)) source symbol offset)
                (Err [message] (set! error message))
                (Ok [id]
                    (let [target (elem (mut (.parts result)) i)]
                      (set! (mut (.symbols target)) j id))))))
          (set! j (+ j 1))))
      (set! i (+ i 1)))
    (set! i 0)
    (while (and (= error "") (< i (len sources)))
      (let [source (get sources i)
            part (get (.parts result) i)
            (mut j) (: 0 i64)]
        (for symbol (.symbols source)
          (when (and (= error "") (not (.global? symbol)))
            (let [offset
                    (+ (.offset symbol)
                       (if (= (.section symbol) 1) (.text part) (.data part)))]
              (match (image/fresh-local! (mut (.image result))
                                         (.section symbol)
                                         offset
                                         allocator)
                (Err [message] (set! error message))
                (Ok [id]
                    (let [target (elem (mut (.parts result)) i)]
                      (set! (mut (.symbols target)) j id))))))
          (set! j (+ j 1))))
      (set! i (+ i 1)))
    (when (= error "")
      (reserve! (mut (.text (.image result))) text-size)
      (reserve! (mut (.data (.image result))) data-size))
    (set! i 0)
    (while (and (= error "") (< i (len sources)))
      (let [source (get sources i)
            part (get (.parts result) i)]
        (while (< (len (.text (.image result))) (.text part))
          (bytes/append32! (mut (.text (.image result))) 0xD503201F))
        (while (< (len (.data (.image result))) (.data part))
          (push! (mut (.data (.image result))) 0))
        (when (or (not (bytes/append-slice! (mut (.text (.image result)))
                                            (slice (.text source))))
                  (not (bytes/append-slice! (mut (.data (.image result)))
                                            (slice (.data source)))))
          (set! error "image composition byte append failed"))
        (for range (.text-data source)
          (push! (mut (.text-data (.image result)))
                 (text-data/Range
                   :offset (+ (.text part) (.offset range))
                   :length (.length range)
                   :kind (.kind range))))
        (for record (.relocations source)
          (when (= error "")
            (when (not (image/relocate! (mut (.image result))
                                        (image/Relocation
                                          :section (.section record)
                                          :offset
                                            (+ (.offset record)
                                               (if (= (.section record) 1)
                                                   (.text part)
                                                   (.data part)))
                                          :kind (.kind record)
                                          :symbol
                                            (get (.symbols part)
                                                 (cast i64 (.symbol record)))
                                          :addend (.addend record))))
              (set! error "invalid rebased image relocation")))))
      (set! i (+ i 1)))
    (if (= error "") (Ok result) (do (release! (mut result)) (Err error)))))
