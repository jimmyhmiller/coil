; Scalar binary families follow dstogov/ir ir_builder.h, 92171d0. See NOTICE.
(module stogir.integer-binary)
(import "stogir.types" :as types)

(defn logical? [(opcode i32)] (-> bool)
  (or (= opcode 46) (= opcode 47) (= opcode 48)))

(defn operation? [(opcode i32)] (-> bool)
  (or (and (>= opcode 26) (<= opcode 30))
      (and (>= opcode 46) (<= opcode 53))
      (= opcode 58)
      (= opcode 59)))

(defn valid-type? [(opcode i32) (ty i32)] (-> bool)
  (and (operation? opcode)
       (types/integer? ty)
       (or (!= ty 1) (logical? opcode) (= opcode 58) (= opcode 59))))
