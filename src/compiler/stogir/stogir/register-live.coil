;;; Register-value uses/definitions for scheduled blocks and phi edges.
(module stogir.register-live)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.schedule" :as schedule)
(import "stogir.bitset" :as bits)
(import "stogir.cfg" :as cfg)
(import "stogir.adjacency" :as adj)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Some None])

(defstruct Facts [(uses bits/Bits) (defs bits/Bits)])

(defn data-edge? [(kind (slice u8))] (-> bool)
  (or (= kind "def") (= kind "ref") (= kind "arg")))

;;; Requires verified graph and valid packed schedule/block start.
;;; Bit positions are instruction refs; constants need no virtual register.
(defn block-facts [(graph g/Graph)
                   (scheduled schedule/Schedule)
                   (block i32)
                   (allocator (dyn Allocator))] (-> Facts)
  (let [size (len (.instructions graph))
        (mut result)
          (Facts
            :uses (bits/create size allocator)
            :defs (bits/create size allocator))
        range (get (.ranges scheduled) (cast i64 block))
        (mut i) 0]
    (while (< i (.count range))
      (let [reference (get (.nodes scheduled) (+ (.offset range) i))
            node (get (.instructions graph) (cast i64 reference))
            opcode (cast i32 (n/opcode node))
            count (get (.arities graph) (cast i64 reference))
            (mut j) (: 1 i32)]
        (when (!= opcode 67)
          (while (<= j count)
            (when (data-edge? (op/operand-kind opcode j))
              (match (g/operand graph reference j)
                (None [] 0)
                (Some [value]
                      (when (and (> value 0)
                                 (not (bits/contains? (.defs result)
                                                      (cast i64 value))))
                        (bits/add! (mut (.uses result)) (cast i64 value))))))
            (set! j (+ j 1))))
        (when (and (!= opcode 72)
                   (!= (n/type-id node) 0)
                   (not (op/block-start? opcode))
                   (not (op/block-end? opcode)))
          (bits/add! (mut (.defs result)) (cast i64 reference))))
      (set! i (+ i 1)))
    result))

(defn release! [(facts (mut Facts))] (-> void)
  (bits/release! (mut (.uses facts)))
  (bits/release! (mut (.defs facts))))

;;; Add phi incoming registers used on this precise CFG edge to dst. Constants
;;; need no virtual registers. Successor phi definitions are killed separately.
(defn phi-edge-uses! [(dst (mut bits/Bits))
                      (graph g/Graph)
                      (scheduled schedule/Schedule)
                      (target i32)
                      (position i32)]
  (-> bool)
  (let [range (get (.ranges scheduled) (cast i64 target))
        (mut changed) false
        (mut i) 0]
    (while (< i (.count range))
      (let [reference (get (.nodes scheduled) (+ (.offset range) i))
            node (get (.instructions graph) (cast i64 reference))]
        (when (= (n/opcode node) 67)
          (match (g/operand graph reference (+ position 1))
            (None [] 0)
            (Some [source]
                  (when (> source 0)
                    (when (bits/add! (mut dst) (cast i64 source))
                      (set! changed true)))))))
      (set! i (+ i 1)))
    changed))

(defn phi-defs [(graph g/Graph)
                (scheduled schedule/Schedule)
                (block i32)
                (allocator (dyn Allocator))] (-> bits/Bits)
  (let [(mut result) (bits/create (len (.instructions graph)) allocator)
        range (get (.ranges scheduled) (cast i64 block))
        (mut i) 0]
    (while (< i (.count range))
      (let [reference (get (.nodes scheduled) (+ (.offset range) i))
            node (get (.instructions graph) (cast i64 reference))]
        (when (= (n/opcode node) 67)
          (bits/add! (mut result) (cast i64 reference))))
      (set! i (+ i 1)))
    result))

;;; out[pred] includes (in[succ] - phi-defs[succ]) plus edge-specific phi uses.
;;; dst accumulates across successor edges; sizes match the graph reference space.
(defn edge-transfer! [(dst (mut bits/Bits))
                      (successor-in bits/Bits)
                      (successor-phis bits/Bits)
                      (edge-uses bits/Bits)] (-> bool)
  (let [(mut changed) false
        (mut i) 0]
    (while (< i (len (.words dst)))
      (let [previous (get (.words dst) i)
            next
              (| previous
                 (get (.words edge-uses) i)
                 (& (get (.words successor-in) i)
                    (^ (get (.words successor-phis) i)
                       (: 0xFFFFFFFFFFFFFFFF u64))))]
        (when (!= previous next)
          (set! changed true)
          (set! (mut (.words dst)) i next)))
      (set! i (+ i 1)))
    changed))

(defstruct State
  [(facts Facts) (phis bits/Bits) (input bits/Bits) (output bits/Bits)])

(defstruct Analysis [(indices (ArrayList i64)) (states (ArrayList State))])

(defn analyze [(graph g/Graph)
               (blocks cfg/Blocks)
               (scheduled schedule/Schedule)
               (order (ArrayList i32))
               (allocator (dyn Allocator))] (-> Analysis)
  (let [(mut result)
          (Analysis
            :indices (ArrayList::new [i64] allocator)
            :states (ArrayList::new [State] allocator))
        (mut predecessors) (adj/build blocks true allocator)
        (mut successors) (adj/build blocks false allocator)
        (mut work) (ArrayList::new [i32] allocator)
        (mut queued) (bits/create (len (.instructions graph)) allocator)
        (mut edge-uses) (bits/create (len (.instructions graph)) allocator)
        (mut i) 0]
    (while (< i (len (.instructions graph)))
      (push! (mut (.indices result)) -1)
      (set! i (+ i 1)))
    (for block order
      (set! (mut (.indices result)) (cast i64 block) (len (.states result)))
      (push! (mut (.states result))
             (State
               :facts (block-facts graph scheduled block allocator)
               :phis (phi-defs graph scheduled block allocator)
               :input (bits/create (len (.instructions graph)) allocator)
               :output (bits/create (len (.instructions graph)) allocator)))
      (push! (mut work) block)
      (bits/add! (mut queued) (cast i64 block)))
    (let [(mut cursor) 0]
      (while (< cursor (len work))
        (let [block (get work cursor)
              state
                (elem (mut (.states result))
                      (get (.indices result) (cast i64 block)))
              range (get (.ranges successors) (cast i64 block))
              (mut j) 0]
          (bits/remove! (mut queued) (cast i64 block))
          (while (< j (.count range))
            (let [edge-index (get (.edges successors) (+ (.offset range) j))
                  edge (get (.edges blocks) edge-index)
                  target-index (get (.indices result) (cast i64 (.to edge)))]
              (when (>= target-index 0)
                (let [target (elem (mut (.states result)) target-index)
                      (mut k) 0]
                  (while (< k (len (.words edge-uses)))
                    (set! (mut (.words edge-uses)) k 0)
                    (set! k (+ k 1)))
                  (phi-edge-uses! (mut edge-uses)
                                  graph
                                  scheduled
                                  (.to edge)
                                  (.position edge))
                  (edge-transfer! (mut (.output state))
                                  (.input target)
                                  (.phis target)
                                  edge-uses))))
            (set! j (+ j 1)))
          (when (bits/transfer! (mut (.input state))
                                (.uses (.facts state))
                                (.output state)
                                (.defs (.facts state)))
            (let [incoming (get (.ranges predecessors) (cast i64 block))
                  (mut k) 0]
              (while (< k (.count incoming))
                (let [edge-index
                        (get (.edges predecessors) (+ (.offset incoming) k))
                      edge (get (.edges blocks) edge-index)
                      source (.from edge)]
                  (when (and (>= (get (.indices result) (cast i64 source)) 0)
                             (not (bits/contains? queued (cast i64 source))))
                    (bits/add! (mut queued) (cast i64 source))
                    (push! (mut work) source)))
                (set! k (+ k 1))))))
        (set! cursor (+ cursor 1))))
    (bits/release! (mut edge-uses))
    (bits/release! (mut queued))
    (free! (mut work))
    (adj/release! (mut predecessors))
    (adj/release! (mut successors))
    result))

(defn release-analysis! [(analysis (mut Analysis))] (-> void)
  (let [(mut i) 0]
    (while (< i (len (.states analysis)))
      (let [state (elem (mut (.states analysis)) i)]
        (release! (mut (.facts state)))
        (bits/release! (mut (.phis state)))
        (bits/release! (mut (.input state)))
        (bits/release! (mut (.output state))))
      (set! i (+ i 1))))
  (free! (mut (.states analysis)))
  (free! (mut (.indices analysis))))
