;;; Machine def/use metadata over the unchanged Sea-of-Nodes graph. Target
;;; matching supplies omitted nodes and redirected uses before liveness.
(module stogir.matched-uses)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.stack" :as stack)
(import "stogir.opcode" :as op)
(import "stogir.schedule" :as schedule)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Some None])

(defstruct Range [(offset i64) (count i64)])

(defstruct Plan
  [(ranges (ArrayList Range))
   (inputs (ArrayList i32))
   (definitions (ArrayList bool))
   (omitted (ArrayList bool))
   (rematerialized (ArrayList bool))
   (output-ranges (ArrayList Range))
   (outputs (ArrayList i32))
   (definers (ArrayList i32))])

(defn rematerialized? [(plan Plan) (reference i32)] (-> bool)
  (and (> reference 0) (< (cast i64 reference) (len (.rematerialized plan)))
       (get (.rematerialized plan) (cast i64 reference))))

;;; Withdraw an ordinary definition before liveness: the value has no register
;;; and each use rebuilds it from the recipe the target indexes for it.
(defn rematerialize! [(plan (mut Plan)) (reference i32)] (-> void)
  (when (= (len (.rematerialized plan)) 0)
    (extend-zeroed! (mut (.rematerialized plan)) (len (.definitions plan))))
  (set! (mut (.definitions plan)) (cast i64 reference) false)
  (set! (mut (.rematerialized plan)) (cast i64 reference) true))

;;; A matched instruction may define several original SSA values. These sparse
;;; groups are allocated only when selected; ordinary scalar definitions retain
;;; their existing representation. Output order belongs to the target rule.
(defn output-range [(plan Plan) (reference i32)] (-> Range)
  (if (and (> reference 0) (< (cast i64 reference) (len (.output-ranges plan))))
      (get (.output-ranges plan) (cast i64 reference))
      (Range :offset 0 :count 0)))

(defn definition-count [(plan Plan) (reference i32)] (-> i64)
  (+ (.count (output-range plan reference))
     (if (get (.definitions plan) (cast i64 reference)) 1 0)))

;;; index is in [0, definition-count). Ordinary result precedes extra outputs.
(defn definition-at [(plan Plan) (reference i32) (index i64)] (-> i32)
  (let [ordinary (if (get (.definitions plan) (cast i64 reference)) 1 0)
        range (output-range plan reference)]
    (if (< index ordinary) reference
        (get (.outputs plan) (+ (.offset range) (- index ordinary))))))

(defn defining-reference [(plan Plan) (reference i32)] (-> i32)
  (if (and (> reference 0) (< (cast i64 reference) (len (.definers plan)))
           (> (get (.definers plan) (cast i64 reference)) 0))
      (get (.definers plan) (cast i64 reference))
      reference))

;;; Transfer ordinary definitions to one selected producer. Validate the entire
;;; group before mutating: distinct, currently defined, non-rematerialized values
;;; with no previous transfer. The target must prove dominance and semantics.
(defn define-outputs! [(plan (mut Plan)) (producer i32) (values (slice i32))]
  (-> bool)
  (let [size (len (.definitions plan)) (mut valid?) true]
    (when (or (<= producer 0) (>= (cast i64 producer) size)
              (= (len values) 0) (> (.count (output-range plan producer)) 0))
      (set! valid? false))
    (when (and valid?
               (or (get (.omitted plan) (cast i64 producer))
                   (!= (defining-reference plan producer) producer)))
      (set! valid? false))
    (for [i 0 (len values)]
      (let [value (get values i)]
        (if (or (<= value 0) (>= (cast i64 value) size) (= value producer))
            (set! valid? false)
            (when (or (not (get (.definitions plan) (cast i64 value)))
                      (rematerialized? plan value)
                      (!= (defining-reference plan value) value)
                      (> (.count (output-range plan value)) 0))
              (set! valid? false)))
        (for [j 0 i]
          (when (= value (get values j)) (set! valid? false)))))
    (when valid?
      (when (= (len (.output-ranges plan)) 0)
        (extend-zeroed! (mut (.output-ranges plan)) size)
        (extend-zeroed! (mut (.definers plan)) size))
      (set! (mut (.output-ranges plan)) (cast i64 producer)
            (Range :offset (len (.outputs plan)) :count (len values)))
      (let [items-102 values (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [value (get items-102 for-index-102)]
        (push! (mut (.outputs plan)) value)
        (set! (mut (.definitions plan)) (cast i64 value) false)
        (set! (mut (.definers plan)) (cast i64 value) producer)) (set! for-index-102 (+ for-index-102 1)))))
    valid?))

(defn data-edge? [(kind (slice u8))] (-> bool)
  (or (= kind "def") (= kind "ref") (= kind "arg")))

(defn data-code? [(kind u32)] (-> bool)
  (or (= kind op/OPERAND-DEF) (= kind op/OPERAND-REF)))

;;; Graph and schedule are verified. Omitted is transferred to the plan;
;;; redirects is borrowed and maps a consumer to its fused producer's inputs.
;;; unary-inputs overrides a consumer with one direct positive data reference;
;;; its definition identity stays unchanged. Empty slices retain ordinary uses.
(defn build-with-unary-inputs [(graph g/Graph)
                               (scheduled schedule/Schedule)
                               (omitted (ArrayList bool))
                               (redirects (ArrayList i32))
                               (addresses (slice i32))
                               (doubles (slice i32))
                               (unary-inputs (slice i32))
                               (a (dyn Allocator))] (-> Plan)
  (let [(mut result)
          (Plan
            :ranges (ArrayList::new [Range] a)
            :inputs (ArrayList::new [i32] a)
            :definitions (ArrayList::new [bool] a)
            :omitted omitted
            :rematerialized (ArrayList::new [bool] a)
            :output-ranges (ArrayList::new [Range] a)
            :outputs (ArrayList::new [i32] a)
            :definers (ArrayList::new [i32] a))]
    (extend-zeroed! (mut (.ranges result)) (len (.instructions graph)))
    (extend-zeroed! (mut (.definitions result)) (len (.instructions graph)))
    (let [items-101 (.nodes scheduled) (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [reference (get items-101 for-index-101)]
      (let [index (cast i64 reference)
            node (get (.instructions graph) index)
            opcode (cast i32 (n/opcode node))
            start (len (.inputs result))]
        (when (stack/frame-object? node)
          (when (= (len (.rematerialized result)) 0)
            (extend-zeroed! (mut (.rematerialized result)) (len (.instructions graph))))
          (set! (mut (.rematerialized result)) index true))
        (unless (get omitted index)
          (let [redirect (get redirects index)
                source (if (> redirect 0) redirect reference)
                input-node (get (.instructions graph) (cast i64 source))]
            (unless (= opcode 67)
              (if (and (< index (len unary-inputs))
                       (> (get unary-inputs index) 0))
                  (push! (mut (.inputs result)) (get unary-inputs index))
                  (if (and (< index (len doubles)) (> (get doubles index) 0))
                      (do
                        (push! (mut (.inputs result)) (get doubles index))
                        (push! (mut (.inputs result)) (get doubles index)))
                      (for [j
                            1
                            (+ (cast i64
                                     (get (.arities graph) (cast i64 source)))
                               1)]
                        (when (data-code? (op/operand-code (cast i32
                                                                 (n/opcode input-node))
                                                           (cast i32 j)))
                          (match (g/operand graph source (cast i32 j))
                            (Some [value]
                                  (push! (mut (.inputs result))
                                         (if (and (= source reference)
                                                  (= j 2)
                                                  (< index (len addresses))
                                                  (> (get addresses index) 0))
                                             (get addresses index)
                                             value)))
                            (None [] 0))))))))
          (when (and (not (stack/frame-object? node)) (!= opcode 72) (!= opcode 80)
                     (!= (n/type-id node) 0)
                     (not (op/block-start? opcode))
                     (not (op/block-end? opcode)))
            (set! (mut (.definitions result)) index true)))
        (set! (mut (.ranges result))
              index
              (Range :offset start :count (- (len (.inputs result)) start))))) (set! for-index-101 (+ for-index-101 1))))
    result))

(defn build-selected [(graph g/Graph)
                      (scheduled schedule/Schedule)
                      (omitted (ArrayList bool))
                      (redirects (ArrayList i32))
                      (addresses (slice i32))
                      (doubles (slice i32))
                      (a (dyn Allocator))] (-> Plan)
  (build-with-unary-inputs graph
                           scheduled
                           omitted
                           redirects
                           addresses
                           doubles
                           []
                           a))

(defn build-with-addresses [(graph g/Graph)
                            (scheduled schedule/Schedule)
                            (omitted (ArrayList bool))
                            (redirects (ArrayList i32))
                            (addresses (slice i32))
                            (a (dyn Allocator))] (-> Plan)
  (build-selected graph scheduled omitted redirects addresses [] a))

(defn build [(graph g/Graph)
             (scheduled schedule/Schedule)
             (omitted (ArrayList bool))
             (redirects (ArrayList i32))
             (a (dyn Allocator))] (-> Plan)
  (build-with-addresses graph scheduled omitted redirects [] a))

(defn identity [(graph g/Graph)
                (scheduled schedule/Schedule)
                (a (dyn Allocator))] (-> Plan)
  (let [(mut omitted) (ArrayList::new [bool] a)
        (mut redirects) (ArrayList::new [i32] a)]
    (extend-zeroed! (mut omitted) (len (.instructions graph)))
    (extend-zeroed! (mut redirects) (len (.instructions graph)))
    (let [result (build graph scheduled omitted redirects a)]
      (free! (mut redirects))
      result)))

(defn release! [(plan (mut Plan))] (-> void)
  (free! (mut (.output-ranges plan)))
  (free! (mut (.outputs plan)))
  (free! (mut (.definers plan)))
  (free! (mut (.rematerialized plan)))
  (free! (mut (.ranges plan)))
  (free! (mut (.inputs plan)))
  (free! (mut (.definitions plan)))
  (free! (mut (.omitted plan))))
