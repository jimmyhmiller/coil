;;; Active/inactive register assignments and free-until bounds for linear scan.
(module stogir.scan)
(import "stogir.live-ranges" :as live)
(import "stogir.interval" :as interval)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])

(defstruct Binding [(interval i32) (register i32) (active bool)])

;;; Drop expired assignments and reclassify lifetime holes at the scan position.
(defn advance! [(bindings (mut (ArrayList Binding)))
                (values (ArrayList live/Value))
                (position i64)] (-> void)
  (let [(mut i) 0
        (mut kept) 0]
    (while (< i (len bindings))
      (let [(mut binding) (get bindings i)
            value (at values (cast i64 (.interval binding)))
            count (len (.ranges value))]
        (when (and (> count 0)
                   (> (.end (get (.ranges value) (- count 1))) position))
          (set! (.active binding) (interval/covers? (.ranges value) position))
          (set! (mut bindings) kept binding)
          (set! kept (+ kept 1))))
      (set! i (+ i 1)))
    (while (> (len bindings) kept) (pop! (mut bindings)))))

;;; No intersection gives MAX_I64; an active conflict gives position itself.
;;; Bindings may include target fixed-register interference intervals.
(defn free-until [(current (ArrayList interval/Range))
                  (values (ArrayList live/Value))
                  (bindings (ArrayList Binding))
                  (position i64)
                  (register-count i32)
                  (allocator (dyn Allocator))]
  (-> (ArrayList i64))
  (let [(mut result) (ArrayList::new [i64] allocator)
        (mut i) (: 0 i32)]
    (while (< i register-count)
      (push! (mut result) 0x7FFFFFFFFFFFFFFF)
      (set! i (+ i 1)))
    (for binding bindings
      (let [value (at values (cast i64 (.interval binding)))
            hit (interval/intersection current (.ranges value) position)
            reg (cast i64 (.register binding))]
        (when (and (>= hit 0) (< hit (get result reg)))
          (set! (mut result) reg hit))))
    result))

(defstruct Choice [(register i32) (until i64)])

;;; Select longest available register, restricted by target allocatable mask and
;;; an optional fixed requirement (-1 means none). Ties prefer lower register ID.
(defn choose-free [(availability (ArrayList i64))
                   (position i64)
                   (allowed u64)
                   (required i32)] (-> Choice)
  (let [(mut best) (: -1 i32)
        (mut until) position
        (mut i) 0]
    (while (and (< i (len availability)) (< i 64))
      (when (and (!= (& allowed (<< (: 1 u64) (cast u64 i))) 0)
                 (or (< required 0) (= (cast i32 i) required))
                 (> (get availability i) until))
        (set! best (cast i32 i))
        (set! until (get availability i)))
      (set! i (+ i 1)))
    (Choice :register best :until until)))
