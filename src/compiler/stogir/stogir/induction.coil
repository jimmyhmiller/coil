;;; On-demand recognition of one guarded unit-step loop counter. A query
;;; inspects one PHI, its region's two predecessors and the dominator chain of
;;; the back edge; nothing is computed for the rest of the graph.
(module stogir.induction)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.dominators" :as dom)
(import "stogir.branch-facts" :as facts)
(import "coil.arraylist" :use [ArrayList])

;;; kind 0: not a recognized counter.
;;; kind 1: the back edge is guarded by a signed `next < other` on the updated
;;;   value. The PHI is in [seed, MAX-1] provided seed <= MAX-1, so the update
;;;   never wraps anywhere and next is in [seed+1, MAX].
;;; kind 2: the back edge is guarded by a signed `phi < other`. The update
;;;   does not wrap on the back edge, so the PHI is in [seed, MAX]; next may
;;;   wrap on an exit path and has no range of its own.
;;; kind 3: the back edge is guarded by a signed `next + 1 < other`, the test a
;;;   bottom-tested loop makes for its following iteration. While next <= MAX-1
;;;   the sum does not wrap, so a passed test gives next + 1 <= MAX-1, which is
;;;   the following iteration's next; with seed <= MAX-2 the first next is
;;;   seed + 1 <= MAX-1. The PHI is in [seed, MAX-2] and next in [seed+1, MAX-1].
;;; seed is the entry input of the PHI, next its (BITCAST-free) back input.
(defstruct Counter [(kind i32) (seed i32) (next i32) (width i32)])

(defn none [] (-> Counter) (Counter :kind 0 :seed 0 :next 0 :width 0))

;;; Block start of a control node, following control predecessors for at most
;;; `limit` steps. Zero when the walk gives up.
(defn block-of [(graph g/Graph) (reference i32) (limit i32)] (-> i32)
  (let [(mut current) reference (mut left) limit (mut found) (: 0 i32)]
    (while (and (> current 0) (< (cast i64 current) (len (.instructions graph)))
                (> left 0) (= found 0))
      (let [node (get (.instructions graph) (cast i64 current))]
        (if (op/block-start? (cast i32 (n/opcode node)))
            (set! found current)
            (set! current (.op1 node))))
      (set! left (- left 1)))
    found))

(defn reachable? [(idom (ArrayList i32)) (block i32)] (-> bool)
  (and (> block 0) (< (cast i64 block) (len idom)) (!= (get idom (cast i64 block)) 0)))

;;; `tested` is `value` plus the literal one at `width` bytes.
(defn bumped? [(graph g/Graph) (tested i32) (value i32) (width i32)] (-> bool)
  (and (> tested 0) (< (cast i64 tested) (len (.instructions graph)))
       (let [sum (get (.instructions graph) (cast i64 tested))
             left (facts/operand graph (.op1 sum))
             right (facts/operand graph (.op2 sum))
             step (facts/literal-range graph (if (= left value) right left))]
         (and (= (n/opcode sum) 26)
              (facts/range-type? (cast i32 (n/type-id sum)))
              (= (types/size (cast i32 (n/type-id sum)) 8) width)
              (or (= left value) (= right value))
              (.valid step) (= (.width step) width) (= (.low step) 1)))))

;;; The counter kind the projections between the header and the back edge
;;; establish, or zero: a signed strict comparison value < other at `width`
;;; bytes with value being `next` (1), `phi` (2) or `next` plus one (3); the
;;; lowest kind found wins. Every block on the immediate-dominator chain from
;;; the back-edge block to the header is passed in the iteration that takes
;;; the back edge.
(defn guard-kind [(graph g/Graph) (idom (ArrayList i32))
                  (phi i32) (next i32) (width i32) (header i32) (back i32)] (-> i32)
  (let [(mut cursor) back (mut found) (: 0 i32) (mut done) false]
    (while (and (reachable? idom cursor) (!= found 1) (not done))
      (let [node (get (.instructions graph) (cast i64 cursor)) opcode (n/opcode node)
            parent (get idom (cast i64 cursor))]
        (when (and (or (= opcode 107) (= opcode 108)) (> (.op1 node) 0))
          (let [source (get (.instructions graph) (cast i64 (.op1 node)))]
            (when (= (n/opcode source) 116)
              (let [fact (facts/relation graph (.op2 source))
                    mask (if (= opcode 107) (.mask fact) (^ (.mask fact) 7))
                    lesser (cond (and (= (.domain fact) 1) (= (.width fact) width) (= mask 1))
                                   (.left fact)
                                 (and (= (.domain fact) 1) (= (.width fact) width)
                                      (= (facts/swap-mask mask) 1))
                                   (.right fact)
                                 :else 0)
                    kind (cond (= lesser 0) (: 0 i32)
                               (= lesser next) 1
                               (= lesser phi) 2
                               (bumped? graph lesser next width) 3
                               :else 0)]
                (when (and (!= kind 0) (or (= found 0) (< kind found)))
                  (set! found kind))))))
        (set! done (or (= cursor header) (= parent cursor)))
        (set! cursor parent)))
    found))

;;; The region has exactly one predecessor it dominates (the back edge) and
;;; one it does not (the entry), both reachable; MERGE and LOOP_BEGIN are both
;;; accepted. Region input k carries PHI input k+1. A region with a second
;;; back edge has three inputs and is rejected.
(defn counter [(graph g/Graph) (idom (ArrayList i32)) (reference i32) (limit i32)]
  (-> Counter)
  (let [(mut out) (none)]
    (when (and (> reference 0) (< (cast i64 reference) (len (.instructions graph))))
      (let [phi (get (.instructions graph) (cast i64 reference))
            ty (cast i32 (n/type-id phi))
            width (types/size ty 8)
            header (.op1 phi)]
        (when (and (= (n/opcode phi) 67) (facts/range-type? ty)
                   (= (get (.arities graph) (cast i64 reference)) 3)
                   (> header 0) (< (cast i64 header) (len (.instructions graph))))
          (let [region (get (.instructions graph) (cast i64 header))]
            (when (and (or (= (n/opcode region) 112) (= (n/opcode region) 113))
                       (= (get (.arities graph) (cast i64 header)) 2))
              (let [first (block-of graph (.op1 region) limit)
                    second (block-of graph (.op2 region) limit)]
                (when (and (reachable? idom first) (reachable? idom second)
                           (reachable? idom header))
                  (let [first-back (dom/dominates? idom header first)
                        second-back (dom/dominates? idom header second)]
                    (when (!= first-back second-back)
                      (let [seed (if first-back (.op3 phi) (.op2 phi))
                            next (facts/operand graph (if first-back (.op2 phi) (.op3 phi)))
                            back (if first-back first second)]
                        (when (and (> next 0) (!= seed 0))
                          (let [update (get (.instructions graph) (cast i64 next))
                                left (facts/operand graph (.op1 update))
                                right (facts/operand graph (.op2 update))
                                step (facts/literal-range graph
                                                          (if (= left reference) right left))]
                            (when (and (= (n/opcode update) 26)
                                       (facts/range-type? (cast i32 (n/type-id update)))
                                       (= (types/size (cast i32 (n/type-id update)) 8) width)
                                       (or (= left reference) (= right reference))
                                       (.valid step) (= (.width step) width) (= (.low step) 1))
                              (let [kind (guard-kind graph idom reference next width header back)]
                                (when (!= kind 0)
                                  (set! out (Counter :kind kind :seed seed :next next
                                                     :width width)))))))))))))))))
    out))
