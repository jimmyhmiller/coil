;;; Address-independent reservation/protection layout for aligned JIT images.
(module stogir.jit.layout)
(import "stogir.alignment" :as alignment)
(import "stogir.image" :as image)
(import "coil.result" :use [Result Ok Err])

(defstruct Plan
  [(text-size i64)
   (text-pages i64)
   (data-offset i64)
   (data-pages i64)
   (size i64)
   (reservation i64)
   (alignment i64)])

;;; AArch64 layout: text in instruction words, 16-byte branch veneers.
(defn plan [(text i64)
            (data i64)
            (veneers i64)
            (page i64)
            (text-alignment i64)
            (data-alignment i64)]
  (-> (Result Plan (slice u8)))
  (plan-for image/AARCH64 text data veneers page text-alignment data-alignment))

;;; Bytes of one external-call veneer, appended to the text after the image's
;;; own code. AArch64: LDR x16, #8; BR x16; 8-byte target. x86-64:
;;; jmp [rip+0]; 8-byte target; two bytes of int3 padding.
(defn veneer-size [(machine i32)] (-> i64)
  16)

;;; Text length and alignment are checked against the machine's text unit
;;; (4 bytes on AArch64, 1 on x86-64).
(defn plan-for [(machine i32)
                (text i64)
                (data i64)
                (veneers i64)
                (page i64)
                (text-alignment i64)
                (data-alignment i64)]
  (-> (Result Plan (slice u8)))
  (if (not (image/known-machine? machine))
      (Err "unknown image machine")
      (if (or (< text 0)
              (!= (% text (image/text-unit machine)) 0)
              (< data 0)
              (< veneers 0)
              (< page 4)
              (not (alignment/valid? page))
              (< text-alignment (image/text-unit machine))
              (< data-alignment 8)
              (not (alignment/valid? text-alignment))
              (not (alignment/valid? data-alignment))
              (> veneers
                 (/ (- (: 0x7FFFFFFFFFFFFFFF i64) text) (veneer-size machine))))
          (Err "invalid JIT image sizes or alignments")
          (let [code (+ text (* veneers (veneer-size machine)))]
            (if (and (= code 0) (= data 0))
                (Err "empty JIT image")
                (match (alignment/up code page)
                  (Err [message] (Err message))
                  (Ok [text-pages]
                      (match (alignment/up text-pages
                                           (alignment/maximum page
                                                              data-alignment))
                        (Err [message] (Err message))
                        (Ok [data-offset]
                            (match (alignment/up data page)
                              (Err [message] (Err message))
                              (Ok [data-pages]
                                  (let [required
                                          (alignment/maximum page
                                                             (alignment/maximum text-alignment
                                                                                data-alignment))
                                        extra (- required page)]
                                    (if (or (> data-pages
                                               (- (: 0x7FFFFFFFFFFFFFFF i64)
                                                  data-offset))
                                            (> (+ data-offset data-pages)
                                               (- (: 0x7FFFFFFFFFFFFFFF i64)
                                                  extra)))
                                        (Err "JIT reservation size overflow")
                                        (Ok (Plan
                                              :text-size code
                                              :text-pages text-pages
                                              :data-offset data-offset
                                              :data-pages data-pages
                                              :size (+ data-offset data-pages)
                                              :reservation
                                                (+ data-offset data-pages extra)
                                              :alignment required)))))))))))))))
