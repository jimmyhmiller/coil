;;; A read whose value is needed on one side only of the branch below it moves
;;; to that side. Independent of upstream; uses the control shapes of
;;; entry-load and load-forward.
(module stogir.load-sink)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as ty)
(import "stogir.uses" :as uses)
(import "stogir.bitset" :as bits)
(import "coil.result" :use [Some None])

;;; BRANCH is the IF that LOAD is sequenced above, TARGET the IF_TRUE or
;;; IF_FALSE that receives the read. Zero TARGET means no proof.
(defstruct Plan [(branch i32) (target i32)])

(defn none [] (-> Plan)
  (Plan :branch 0 :target 0))

;;; The one node sequenced directly after REFERENCE; zero when there is none
;;; or more than one.
(defn successor [(graph g/Graph) (edges uses/Uses) (reference i32)] (-> i32)
  (let [range (get (.ranges edges) (cast i64 reference))
        (mut found) (: 0 i32)
        (mut count) 0]
    (for [i (.offset range) (+ (.offset range) (.count range))]
      (let [edge (get (.edges edges) i)
            user (get (.instructions graph) (cast i64 (.user edge)))]
        (when (= (op/operand-code (cast i32 (n/opcode user)) (.operand edge))
                 op/OPERAND-SRC)
          (set! found (.user edge))
          (set! count (+ count 1)))))
    (if (= count 1) found 0)))

;;; The IF that executes exactly when LOAD does and before any write: only
;;; plain reads (at most six) are sequenced between them. Zero otherwise.
(defn branch-below [(graph g/Graph) (edges uses/Uses) (load i32)] (-> i32)
  (let [(mut cursor) (successor graph edges load)
        (mut steps) 0
        (mut answer) (: 0 i32)]
    (while (> cursor 0)
      (let [opcode (n/opcode (get (.instructions graph) (cast i64 cursor)))]
        (cond (= opcode 116) (do (set! answer cursor) (set! cursor 0))
              (and (= opcode 91) (< steps 6))
                (do (set! steps (+ steps 1))
                    (set! cursor (successor graph edges cursor)))
              :else (set! cursor 0))))
    answer))

(defstruct Budget [(steps i64)])

;;; Every control path from the function entry to START passes TARGET: each
;;; backward path from START reaches TARGET before LOAD, BRANCH, the entry or
;;; anything that is not sequenced under exactly one predecessor. Joins queue
;;; every input once; a revisited join shares its queued obligation, so a
;;; cycle that never leaves the region below TARGET is no escape. At most 16
;;; joins and 16 path heads per query and BUDGET steps over all queries.
(defn dominated? [(graph g/Graph) (start i32) (target i32) (load i32) (branch i32)
                  (budget (mut Budget))] (-> bool)
  (let [(mut pending) (zeroed (array i32 16))
        (mut joins) (zeroed (array i32 16))
        (mut queued) (: 1 i64)
        (mut joined) (: 0 i64)
        (mut head) (: 0 i64)
        (mut good) true]
    (set! (mut pending) 0 start)
    (while (and good (< head queued))
      (let [(mut cursor) (get pending head)
            (mut more) true]
        (set! head (+ head 1))
        (while (and good more)
          (cond
            (= cursor target) (set! more false)
            (or (<= cursor 0) (= cursor load) (= cursor branch) (<= (.steps budget) 0))
              (set! good false)
            :else
              (let [prior (get (.instructions graph) (cast i64 cursor))
                    opcode (cast i32 (n/opcode prior))]
                (set! (.steps budget) (- (.steps budget) 1))
                (cond
                  (or (= opcode 112) (= opcode 113))
                    (let [(mut seen) false
                          count (cast i64 (get (.arities graph) (cast i64 cursor)))]
                      (for [i 0 joined] (when (= (get joins i) cursor) (set! seen true)))
                      (unless seen
                        (if (or (<= count 0) (>= joined 16) (> (+ queued count) 16))
                            (set! good false)
                            (do
                              (set! (mut joins) joined cursor)
                              (set! joined (+ joined 1))
                              (for [k 1 (+ count 1)]
                                (match (g/operand graph cursor (cast i32 k))
                                  (None [] (set! good false))
                                  (Some [predecessor]
                                    (do (set! (mut pending) queued predecessor)
                                        (set! queued (+ queued 1)))))))))
                      (set! more false))
                  (and (!= opcode 104) (!= opcode 105)
                       (= (op/operand-code opcode 1) op/OPERAND-SRC))
                    (set! cursor (.op1 prior))
                  :else (set! good false)))))))
    good))

;;; Every use of LOAD's value happens under TARGET. A sequenced user uses it
;;; where it is sequenced; a PHI uses it at the end of the matching input of
;;; its join; a comparison, arithmetic, conversion or COPY (the operations
;;; entry-load follows) uses it wherever its own users do. Any other user, or
;;; more than 24 visited uses, is no proof.
(defn uses-under? [(graph g/Graph) (edges uses/Uses) (load i32) (branch i32) (target i32)]
  (-> bool)
  (let [(mut pending) (zeroed (array i32 12))
        (mut depth) (: 1 i64)
        (mut visited) 0
        (mut budget) (Budget :steps 96)
        (mut good) true]
    (set! (mut pending) 0 load)
    (while (and good (> depth 0))
      (set! depth (- depth 1))
      (let [value (get pending depth)
            range (get (.ranges edges) (cast i64 value))]
        (for [i (.offset range) (+ (.offset range) (.count range))]
          (when good
            (let [edge (get (.edges edges) i)
                  user (.user edge)
                  node (get (.instructions graph) (cast i64 user))
                  opcode (cast i32 (n/opcode node))
                  kind (op/operand-code opcode (.operand edge))]
              (set! visited (+ visited 1))
              (cond
                (> visited 24) (set! good false)
                ; The node sequenced after the read does not use its value.
                (= kind op/OPERAND-SRC) (unless (= value load) (set! good false))
                (not (uses/edge-code? kind)) (set! good false)
                (= opcode 67)
                  (match (g/operand graph (.op1 node) (- (.operand edge) 1))
                    (None [] (set! good false))
                    (Some [end]
                      (unless (and (>= (.operand edge) 2)
                                   (dominated? graph end target load branch (mut budget)))
                        (set! good false))))
                (= (op/operand-code opcode 1) op/OPERAND-SRC)
                  (unless (dominated? graph user target load branch (mut budget))
                    (set! good false))
                (or (and (>= opcode 14) (<= opcode 39))
                    (and (>= opcode 45) (<= opcode 66))
                    (= opcode 68))
                  (if (>= depth 12)
                      (set! good false)
                      (do (set! (mut pending) depth user)
                          (set! depth (+ depth 1))))
                :else (set! good false)))))))
    (and good (> visited 1))))

;;; No other access names LOAD's address node: forwarding has nothing to gain
;;; from the read's present position.
(defn alone? [(graph g/Graph) (edges uses/Uses) (load i32)] (-> bool)
  (let [address (.op2 (get (.instructions graph) (cast i64 load)))
        (mut good) (> address 0)]
    (when good
      (let [range (get (.ranges edges) (cast i64 address))]
        (for [i (.offset range) (+ (.offset range) (.count range))]
          (let [user (.user (get (.edges edges) i))
                opcode (n/opcode (get (.instructions graph) (cast i64 user)))]
            (when (and (!= user load) (or (= opcode 91) (= opcode 93)))
              (set! good false))))))
    good))

;;; LOAD's address is computed from a PHI or from a value produced in sequence
;;; (a read, a call): it names a different location from one execution to the
;;; next, so no loop-entry move could ever serve it. An address made of
;;; parameters, storage and constants alone is left where the loop-entry
;;; proofs can still reach it, in this function or after inlining. Pure
;;; operations are followed to their leaves, at most 16 nodes.
(defn varying? [(graph g/Graph) (load i32)] (-> bool)
  (let [(mut pending) (zeroed (array i32 16))
        (mut depth) (: 1 i64)
        (mut visited) (: 0 i64)
        (mut answer) false]
    (set! (mut pending) 0 (.op2 (get (.instructions graph) (cast i64 load))))
    (while (and (not answer) (> depth 0) (< visited 16))
      (set! depth (- depth 1))
      (set! visited (+ visited 1))
      (let [current (get pending depth)]
        (when (> current 0)
          (let [node (get (.instructions graph) (cast i64 current))
                opcode (cast i32 (n/opcode node))]
            (cond
              (or (= opcode 67) (= opcode 79) (= opcode 91)) (set! answer true)
              (or (and (>= opcode 14) (<= opcode 39))
                  (and (>= opcode 45) (<= opcode 66))
                  (= opcode 68))
                (let [count (get (.arities graph) (cast i64 current))]
                  (for [i 1 (+ (cast i64 count) 1)]
                    (when (uses/edge-code? (op/operand-code opcode (cast i32 i)))
                      (match (g/operand graph current (cast i32 i))
                        (None [] 0)
                        (Some [input]
                          (when (and (> input 0) (< depth 16))
                            (set! (mut pending) depth input)
                            (set! depth (+ depth 1))))))))
              :else 0)))))
    answer))

;;; LOAD's value is used on one side only of the IF it is sequenced above, and
;;; nothing but plain reads lies between them, so reading it first thing on
;;; that side yields the same bytes: a read writes nothing and the IF has no
;;; effect. The read then runs on a subset of the paths that ran it before; it
;;; is never performed where it was not, and the other side never observed its
;;; value. The side keeps every use under it (uses-under?), so the moved read
;;; still dominates them.
(defn plan [(graph g/Graph) (edges uses/Uses) (load i32) (pointer-bytes i32)] (-> Plan)
  (let [node (get (.instructions graph) (cast i64 load))]
    (if (or (!= (n/opcode node) 91)
            (<= (ty/size (cast i32 (n/type-id node)) pointer-bytes) 0)
            (not (ty/valid-scalar? (cast i32 (n/type-id node)))))
        (none)
        (let [branch (branch-below graph edges load)]
          (if (or (= branch 0) (not (alone? graph edges load)) (not (varying? graph load)))
              (none)
              (let [range (get (.ranges edges) (cast i64 branch))
                    (mut answer) (none)]
                (for [i (.offset range) (+ (.offset range) (.count range))]
                  (let [side (.user (get (.edges edges) i))
                        opcode (n/opcode (get (.instructions graph) (cast i64 side)))]
                    (when (and (= (.target answer) 0)
                               (or (= opcode 107) (= opcode 108))
                               (!= (successor graph edges side) 0)
                               (uses-under? graph edges load branch side))
                      (set! answer (Plan :branch branch :target side)))))
                answer))))))

(defn set-control! [(graph (mut g/Graph)) (edges (mut uses/Uses))
                    (user i32) (old i32) (new i32)] (-> void)
  (unless (uses/remove! (mut edges) old (uses/Use :user user :operand 1))
    (panic "sunk load control use missing"))
  (unless (g/set-operand! (mut graph) user 1 new)
    (panic "sunk load control rewrite failed"))
  (uses/add! (mut edges) new (uses/Use :user user :operand 1)))

;;; Unlink LOAD from its block and sequence it directly under PLAN's side. The
;;; cell, its value and its data uses stay; no node is created.
(defn move! [(graph (mut g/Graph)) (edges (mut uses/Uses)) (load i32) (target Plan)] (-> void)
  (let [previous (.op1 (get (.instructions graph) (cast i64 load)))
        after (successor graph edges load)
        side (.target target)
        first (successor graph edges side)]
    (when (or (= after 0) (= first 0) (= first load))
      (panic "sunk load control shape"))
    (set-control! (mut graph) (mut edges) after load previous)
    (set-control! (mut graph) (mut edges) first side load)
    (set-control! (mut graph) (mut edges) load previous side)))

;;; Move every read plan admits, each as far down as its uses allow (at most
;;; eight branches). Runs once the loop-entry moves and loop rotation have had
;;; their chance at the reads: a read moved under a branch is out of their
;;; reach. EDGES is the graph's use index and stays current. PROTECTED reads
;;; are observed where they are and stay. Returns the number of reads moved.
(defn run! [(graph (mut g/Graph)) (edges (mut uses/Uses)) (protected bits/Bits)
            (pointer-bytes i32)] (-> i32)
  (let [(mut moved) (: 0 i32)
        (mut r) (: 1 i64)]
    (while (< r (len (.instructions graph)))
      (when (and (= (n/opcode (get (.instructions graph) r)) 91)
                 (not (bits/contains? protected r)))
        (let [(mut levels) 0 (mut more) true]
          (while (and more (< levels 8))
            (let [target (plan graph edges (cast i32 r) pointer-bytes)]
              (if (= (.target target) 0)
                  (set! more false)
                  (do (move! (mut graph) (mut edges) (cast i32 r) target)
                      (set! levels (+ levels 1))))))
          (when (> levels 0) (set! moved (+ moved 1)))))
      (set! r (+ r (/ (+ (cast i64 (get (.arities graph) r)) 4) 4))))
    moved))
