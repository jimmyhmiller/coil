;;; Deterministic allocation replay records. Diagnostics never mutate inputs.
(module stogir.allocation-snapshot)
(import "stogir.allocation" :as a)
(import "stogir.frame" :as frame)
(import "stogir.split-position" :as split)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Some None])

(defn parts [(label (slice u8)) (items (ArrayList a/Part))] (-> void)
  (println "ra-snapshot parts {} {}" label (len items))
  (for [i 0 (len items)]
    (let [part (at items i)]
      (println "ra-snapshot part {} {} {} {} {} {} {} {} {}" i
        (.parent part) (.allowed part) (.register part) (.spill-slot part)
        (.preferred part) (.hint part) (.hint-owner part) (.last-register part))
      (for r (.ranges part)
        (println "ra-snapshot range {} {} {}" i (.start r) (.end r)))
      (for u (.uses part)
        (println "ra-snapshot use {} {} {} {}" i (.position u) (.kind u) (.register u))))))

;;; AArch64 bridge owners are graph references in [0, len(shapes)).
(defn input [(items (ArrayList a/Part)) (layout frame/Frame)
              (register-count i32) (allowed u64) (shapes (slice a/SpillShape))
              (moves (slice i64)) (blocks (slice split/Block)) (tuning a/Tuning)] (-> void)
  (println "ra-snapshot begin 2 {} {} {}" register-count allowed (.size layout))
  (println "ra-snapshot tuning {} {} {} {} {}" (.position (.late tuning))
    (.mask (.late tuning)) (if (.loop-reloads tuning) 1 0) (.loop-evict-mask tuning)
    (if (.call-holes tuning) 1 0))
  (for slot (.slots layout)
    (println "ra-snapshot slot {} {} {}" (.offset slot) (.size slot) (.alignment slot)))
  (for [i 0 (len shapes)]
    (let [shape (get shapes i)]
      (println "ra-snapshot shape {} {} {}" i (.size shape) (.alignment shape)))
    (match (get (.parents layout) (cast i32 i))
      (Some [slot] (println "ra-snapshot parent {} {}" i slot)) (None [] 0))
    (match (get (.locals layout) (cast i32 i))
      (Some [slot] (println "ra-snapshot local {} {}" i slot)) (None [] 0)))
  (for position moves (println "ra-snapshot move {}" position))
  (for block blocks
    (println "ra-snapshot block {} {} {} {} {}" (.start block) (.end block)
      (.depth block) (.header block) (.idom block)))
  (parts "input" items))
