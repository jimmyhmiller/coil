;;; Ranges embedded in executable text, using Mach-O DICE_KIND identifiers.
(module stogir.text-data)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defstruct Range [(offset i64) (length i64) (kind i32)])

(defn width [(kind i32)] (-> i64)
  (if (or (= kind 1) (= kind 2))
      1
      (if (= kind 3) 2 (if (or (= kind 4) (= kind 5)) 4 0))))

;;; Ordered, nonoverlapping ranges; subtraction avoids offset+length overflow.
(defn validate [(ranges (ArrayList Range)) (text-size i64)]
  (-> (Result i32 (slice u8)))
  (let [(mut end) (: 0 i64)
        (mut error) (if (< text-size 0) "negative text size" "")]
    (for range ranges
      (let [size (width (.kind range))]
        (if (or (= size 0)
                (< (.offset range) end)
                (<= (.length range) 0)
                (> (.offset range) text-size)
                (> (.length range) (- text-size (.offset range)))
                (and (> size 0)
                     (or (!= (% (.offset range) size) 0)
                         (!= (% (.length range) size) 0))))
            (set! error "invalid, overlapping or unaligned text data range")
            (set! end (+ (.offset range) (.length range))))))
    (if (= error "") (Ok (cast i32 (len ranges))) (Err error))))

;;; Requires validated ranges. On-disk lengths are u16. Split large tables at element boundaries.
(defn entry-count [(ranges (ArrayList Range))] (-> i64)
  (let [(mut count) (: 0 i64)]
    (for range ranges
      (let [size (width (.kind range))
            limit (* (/ 65535 size) size)]
        (set! count
              (+ count
                 (+ (/ (.length range) limit)
                    (if (= (% (.length range) limit) 0) 0 1))))))
    count))
