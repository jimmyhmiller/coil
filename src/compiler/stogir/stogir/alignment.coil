;;; Checked power-of-two layout arithmetic shared by images and loaders.
(module stogir.alignment)
(import "coil.result" :use [Result Ok Err])

(defn valid? [(value i64)] (-> bool)
  (and (> value 0) (= (& value (- value 1)) 0)))

(defn up [(offset i64) (alignment i64)] (-> (Result i64 (slice u8)))
  (if (or (< offset 0)
          (not (valid? alignment))
          (> offset (- (: 0x7FFFFFFFFFFFFFFF i64) (- alignment 1))))
      (Err "alignment rounding overflow or invalid layout")
      (Ok (& (+ offset (- alignment 1)) (- (: 0 i64) alignment)))))

(defn exponent [(value i64)] (-> i32)
  (let [(mut rest) value
        (mut result) (: 0 i32)]
    (while (> rest 1) (set! rest (/ rest 2)) (set! result (+ result 1)))
    result))

(defn maximum [(a i64) (b i64)] (-> i64)
  (if (> a b) a b))
