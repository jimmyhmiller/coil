;;; Edge-specific parallel copies for SSA deconstruction.
(module stogir.phi)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.cfg" :as cfg)
(import "stogir.adjacency" :as adj)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Some None])

(defstruct Copy [(edge i64) (source i32) (destination i32)])

;;; Requires verified phi arities and matching CFG. Copies on one edge are
;;; simultaneous: consumers must resolve cycles after assigning locations.
(defn collect [(graph g/Graph) (blocks cfg/Blocks) (allocator (dyn Allocator))]
  (-> (ArrayList Copy))
  (let [(mut result) (ArrayList::new [Copy] allocator)
        (mut predecessors) (adj/build blocks true allocator)
        (mut r) 1]
    (while (< r (len (.instructions graph)))
      (let [node (get (.instructions graph) r)
            count (get (.arities graph) r)]
        (when (= (n/opcode node) 67)
          (let [region (.op1 node)
                range (get (.ranges predecessors) (cast i64 (.op1 node)))
                (mut i) 0]
            (while (< i (.count range))
              (let [edge-index (get (.edges predecessors) (+ (.offset range) i))
                    edge (get (.edges blocks) edge-index)]
                (when (= (.to edge) region)
                  (match (g/operand graph (cast i32 r) (+ (.position edge) 1))
                    (None [] 0)
                    (Some [source]
                          (when (!= source (cast i32 r))
                            (push! (mut result)
                                   (Copy
                                     :edge edge-index
                                     :source source
                                     :destination (cast i32 r))))))))
              (set! i (+ i 1)))))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    (adj/release! (mut predecessors))
    result))
