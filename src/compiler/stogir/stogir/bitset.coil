;;; Dense bitsets for compiler analyses, with explicit allocation and ownership.
(module stogir.bitset)
(import "coil.alloc" :use [Allocator])
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use [ArrayList])

(defstruct Bits [(words (ArrayList u64)) (size i64)])

;;; Nonnegative size is a caller precondition; word count avoids size+63 overflow.
(defn create [(size i64) (allocator (dyn Allocator))] (-> Bits)
  (let [(mut result) (Bits :words (ArrayList::new [u64] allocator) :size size)
        count (+ (/ size 64) (if (!= (% size 64) 0) 1 0))
        (mut i) 0]
    (while (< i count) (push! (mut (.words result)) 0) (set! i (+ i 1)))
    result))

(defn contains? [(bits Bits) (index i64)] (-> bool)
  (if (or (< index 0) (>= index (.size bits)))
      false
      (!= (& (get (.words bits) (/ index 64))
             (<< (: 1 u64) (cast u64 (% index 64))))
          0)))

;;; Return whether membership changed; out-of-range indices never mutate storage.
(defn add! [(bits (mut Bits)) (index i64)] (-> bool)
  (if (or (< index 0) (>= index (.size bits)))
      false
      (let [word (/ index 64)
            previous (get (.words bits) word)
            next (| previous (<< (: 1 u64) (cast u64 (% index 64))))]
        (set! (mut (.words bits)) word next)
        (!= previous next))))

(defn remove! [(bits (mut Bits)) (index i64)] (-> bool)
  (if (or (< index 0) (>= index (.size bits)))
      false
      (let [word (/ index 64)
            previous (get (.words bits) word)
            next
              (& previous
                 (^ (<< (: 1 u64) (cast u64 (% index 64)))
                    (: 0xFFFFFFFFFFFFFFFF u64)))]
        (set! (mut (.words bits)) word next)
        (!= previous next))))

;;; Matching sizes required. Propagates src into dst and reports fixed-point change.
(defn clear! [(bits (mut Bits))] (-> void)
  (for [i 0 (len (.words bits))] (set! (mut (.words bits)) i 0)))

(defn union! [(dst (mut Bits)) (src Bits)] (-> bool)
  (let [(mut changed) false
        (mut i) 0]
    (while (< i (len (.words dst)))
      (let [old (get (.words dst) i)
            next (| old (get (.words src) i))]
        (when (!= old next)
          (set! changed true)
          (set! (mut (.words dst)) i next)))
      (set! i (+ i 1)))
    changed))

;;; dst := use OR (out AND NOT def). All sets have equal sizes.
(defn transfer! [(dst (mut Bits)) (uses Bits) (out Bits) (defs Bits)] (-> bool)
  (let [(mut changed) false
        (mut i) 0]
    (while (< i (len (.words dst)))
      (let [next
              (| (get (.words uses) i)
                 (& (get (.words out) i)
                    (^ (get (.words defs) i) (: 0xFFFFFFFFFFFFFFFF u64))))]
        (when (!= (get (.words dst) i) next)
          (set! changed true)
          (set! (mut (.words dst)) i next)))
      (set! i (+ i 1)))
    changed))

(defn release! [(bits (mut Bits))] (-> void)
  (free! (mut (.words bits)))
  (set! (.size bits) 0))

;;; Next present index at or after from, or -1. Skips empty 64-bit words.
(defn next-set [(bits Bits) (from i64)] (-> i64)
  (let [(mut index) (if (< from 0) 0 from)
        (mut answer) -1]
    (when (< index (.size bits))
      (let [(mut word) (/ index 64)
            (mut value)
              (& (get (.words bits) (/ index 64))
                 (<< (: 0xFFFFFFFFFFFFFFFF u64) (cast u64 (% index 64))))]
        (while (and (< word (len (.words bits))) (< answer 0))
          (when (!= value 0)
            (let [candidate
                    (+ (* word 64) (cast i64 (primitive/ctz (cast u64 value))))]
              (when (< candidate (.size bits)) (set! answer candidate))))
          (set! word (+ word 1))
          (when (< word (len (.words bits)))
            (set! value (get (.words bits) word))))))
    answer))
