;;; Integer relation facts established by dominating branch projections.
;;; Only individual IF condition edges are rewritten; shared comparisons and
;;; operands are unchanged. SCCP performs subsequent control/PHI/root repair.
(module stogir.branch-facts)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.pipeline" :as pipeline)
(import "stogir.dominators" :as dom)
(import "stogir.symbols" :as symbols)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Option Some None])

;;; mask uses LT=1, EQ=2, GT=4. Domain 0 is order-independent equality;
;;; domain 1 is signed ordering, domain 2 unsigned. Width is in bytes.
(defstruct Relation [(left i32) (right i32) (mask i32) (domain i32) (width i32)])
(defstruct Change [(branch i32) (truth bool)])

(defn type-of [(graph g/Graph) (ref i32)] (-> i32)
  (match (g/lookup graph ref) (Some [node] (cast i32 (n/type-id node))) (None [] 0)))

;;; Equal-width integer BITCASTs preserve all comparison operand bits. Do not
;;; look through loads, extensions, truncations, floating casts or COPY barriers.
(defn operand [(graph g/Graph) (ref i32)] (-> i32)
  (let [(mut current) ref (mut left) (len (.instructions graph)) (mut done) false]
    (while (and (> current 0) (> left 0) (not done))
      (let [node (get (.instructions graph) (cast i64 current))
            ty (cast i32 (n/type-id node))]
        (if (and (= (n/opcode node) 36) (types/integer? ty)
                 (types/integer? (type-of graph (.op1 node)))
                 (= (types/size ty 8) (types/size (type-of graph (.op1 node)) 8)))
            (set! current (.op1 node))
            (set! done true)))
      (set! left (- left 1)))
    current))

(defn swap-mask [(mask i32)] (-> i32)
  (| (& mask 2) (<< (& mask 1) 2) (>> (& mask 4) 2)))

(defn relation [(graph g/Graph) (ref i32)] (-> Relation)
  (let [(mut out) (Relation :left 0 :right 0 :mask 0 :domain 0 :width 0)]
    (when (> ref 0)
      (let [node (get (.instructions graph) (cast i64 ref))
            op (cast i32 (n/opcode node))]
        (when (and (>= op 14) (<= op 23) (= (n/type-id node) 1)
                   (types/integer? (type-of graph (.op1 node)))
                   (= (type-of graph (.op1 node)) (type-of graph (.op2 node))))
          (let [left (operand graph (.op1 node)) right (operand graph (.op2 node))
                mask (cast i32 (match op (14 2) (15 5) (16 1) (17 6) (18 3) (19 4)
                               (20 1) (21 6) (22 3) (23 4) (_ 0)))]
            (set! out (Relation :left (if (< left right) left right)
                       :right (if (< left right) right left)
                       :mask (if (< left right) mask (swap-mask mask))
                       :domain (if (< op 16) 0 (if (< op 20) 1 2))
                       :width (types/size (type-of graph (.op1 node)) 8)))))))
    out))

;;; Domains may mix only when one relation is equality/inequality. Do not infer
;;; signed ordering from unsigned ordering (or conversely) across the sign bit.
(defn compatible? [(a Relation) (b Relation)] (-> bool)
  (and (!= (.mask a) 0) (!= (.mask b) 0)
       (= (.left a) (.left b)) (= (.right a) (.right b)) (= (.width a) (.width b))
       (or (= (.domain a) (.domain b)) (= (.domain a) 0) (= (.domain b) 0))))

;;; Result: -1 unknown, 0 false, 1 true. A fresh LOAD is a different SSA value,
;;; so a write between two reads cannot accidentally inherit an earlier fact.
(defn prove [(graph g/Graph) (prepared pipeline/Prepared) (branch i32)] (-> i32)
  (let [query (relation graph (.op2 (get (.instructions graph) (cast i64 branch))))
        (mut cursor) (get (.membership (.blocks prepared)) (cast i64 branch))
        (mut signed) (: 7 i32) (mut unsigned) (: 7 i32) (mut result) (: -1 i32)]
    (when (!= (.mask query) 0)
      (while (and (> cursor 0) (< result 0))
        (let [start (get (.instructions graph) (cast i64 cursor))
              op (n/opcode start)
              parent (get (.idom prepared) (cast i64 cursor))]
          (when (or (= op 107) (= op 108))
            (let [source (get (.instructions graph) (cast i64 (.op1 start)))
                  fact (relation graph (.op2 source))]
              (when (compatible? query fact)
                (let [mask (if (= op 107) (.mask fact) (^ (.mask fact) 7))]
                  ; Keep the two orderings independent even for an EQ/NE
                  ; query: signed LE and unsigned GE do not imply equality.
                  (when (!= (.domain fact) 2) (set! signed (& signed mask)))
                  (when (!= (.domain fact) 1) (set! unsigned (& unsigned mask)))
                  (for domain [(: 1 i32) 2]
                    (when (or (= (.domain query) 0) (= (.domain query) domain))
                      (let [available (if (= domain 1) signed unsigned)]
                        (when (!= available 0)
                          (if (= (& available (.mask query)) 0)
                              (set! result 0)
                              (when (= (& available (.mask query)) available)
                                (set! result 1)))))))))))
          (set! cursor (if (= parent cursor) 0 parent)))))
    result))

;;; Signed mathematical intervals over integer bit patterns. Signedness of an
;;; ordering comes from its opcode, not the scalar storage type (Coil uses u64
;;; containers for signed word operations too). i128 keeps endpoint arithmetic
;;; exact even at the 64-bit limits.
(defstruct Range [(valid bool) (low i128) (high i128) (width i32)])

(defn no-range [] (-> Range) (Range :valid false :low 0 :high 0 :width 0))
(defn range-type? [(ty i32)] (-> bool)
  (and (types/integer? ty) (> ty 1) (!= ty 6)))

(defn literal-range [(graph g/Graph) (ref i32)] (-> Range)
  (let [(mut out) (no-range)]
    (when (< ref 0)
      (match (g/lookup graph ref)
        (None [] 0)
        (Some [node]
          (let [ty (cast i32 (n/type-id node)) width (types/size ty 8)]
            (when (and (range-type? ty) (symbols/numeric? node))
              (let [modulus (<< (: 1 i128) (cast i128 (* width 8)))
                    bits (& (cast i128 (n/constant-bits node)) (- modulus 1))
                    value (if (>= bits (/ modulus 2)) (- bits modulus) bits)]
                (set! out (Range :valid true :low value :high value :width width))))))))
    out))

;;; A dominating signed strict comparison v < other establishes v <= MAX-1,
;;; regardless of whether other is constant or loop-invariant. Only projections
;;; within this iteration (from the back-edge block up to the header) count.
(defn strict-upper? [(graph g/Graph) (prepared pipeline/Prepared)
                    (value i32) (width i32) (header i32) (back i32)] (-> bool)
  (let [(mut cursor) back (mut found) false (mut done) false]
    (while (and (> cursor 0) (not found) (not done))
      (let [node (get (.instructions graph) (cast i64 cursor)) op (n/opcode node)
            parent (get (.idom prepared) (cast i64 cursor))]
        (when (or (= op 107) (= op 108))
          (let [source (get (.instructions graph) (cast i64 (.op1 node)))
                fact (relation graph (.op2 source))
                mask (if (= op 107) (.mask fact) (^ (.mask fact) 7))]
            (when (and (= (.domain fact) 1) (= (.width fact) width))
              (when (or (and (= (.left fact) value) (= mask 1))
                        (and (= (.right fact) value) (= (swap-mask mask) 1)))
                (set! found true)))))
        (set! done (or (= cursor header) (= parent cursor)))
        (set! cursor parent)))
    found))

;;; An intentionally small induction family, proved from the immutable graph:
;;; one external entry, one natural back edge, and a unit ADD recurrence. MERGE
;;; and LOOP_BEGIN are both accepted; CFG edge positions select the PHI inputs.
;;; No inferred range is used to justify another recurrence.
(defn induction! [(graph g/Graph) (prepared pipeline/Prepared) (ref i32)
                  (ranges (mut (ArrayList Range)))] (-> void)
  (let [phi (get (.instructions graph) (cast i64 ref)) ty (cast i32 (n/type-id phi))
        header (.op1 phi) width (types/size ty 8)]
    (when (and (= (n/opcode phi) 67) (range-type? ty)
               (= (get (.arities graph) (cast i64 ref)) 3) (> header 0))
      (let [region (get (.instructions graph) (cast i64 header))
            (mut entry-slot) (: 0 i32) (mut back-slot) (: 0 i32)
            (mut back) (: 0 i32) (mut valid) true]
        (when (and (or (= (n/opcode region) 112) (= (n/opcode region) 113))
                   (= (get (.arities graph) (cast i64 header)) 2))
          (for edge (.edges (.blocks prepared))
            (when (= (.to edge) header)
              (if (or (<= (.from edge) 0) (= (get (.idom prepared) (cast i64 (.from edge))) 0))
                  (set! valid false)
                  (if (dom/dominates? (.idom prepared) header (.from edge))
                      (if (!= back-slot 0) (set! valid false)
                          (do (set! back-slot (.position edge)) (set! back (.from edge))))
                      (if (!= entry-slot 0) (set! valid false)
                          (set! entry-slot (.position edge)))))))
          (when (and valid (!= entry-slot 0) (!= back-slot 0))
            (let [initial (if (= entry-slot 1) (.op2 phi) (.op3 phi))
                  next (operand graph (if (= back-slot 1) (.op2 phi) (.op3 phi)))
                  seed (literal-range graph initial)
                  maximum (- (<< (: 1 i128) (cast i128 (- (* width 8) 1))) 1)]
              (when (and (.valid seed) (= (.width seed) width) (> next 0))
                (let [update (get (.instructions graph) (cast i64 next))
                      left (operand graph (.op1 update)) right (operand graph (.op2 update))
                      step (literal-range graph (if (= left ref) right left))]
                  (when (and (= (n/opcode update) 26)
                             (range-type? (cast i32 (n/type-id update)))
                             (= (types/size (cast i32 (n/type-id update)) 8) width)
                             (or (= left ref) (= right ref))
                             (.valid step) (= (.width step) width) (= (.low step) 1))
                    (cond
                      ; Back-edge guard on the updated value: PHI <= MAX-1.
                      ; Hence the ADD is safe everywhere it can be observed.
                      (and (< (.high seed) maximum)
                           (strict-upper? graph prepared next width header back))
                        (do
                          (set! (mut ranges) (cast i64 ref)
                            (Range :valid true :low (.low seed) :high (- maximum 1) :width width))
                          (set! (mut ranges) (cast i64 next)
                            (Range :valid true :low (+ (.low seed) 1) :high maximum :width width)))
                      ; Guard on the old PHI: the update is safe on the back
                      ; edge, but could wrap on an exit path. Record only PHI.
                      (strict-upper? graph prepared ref width header back)
                        (set! (mut ranges) (cast i64 ref)
                          (Range :valid true :low (.low seed) :high maximum :width width))
                      :else 0)))))))))))

(defn induction-ranges [(graph g/Graph) (prepared pipeline/Prepared) (a (dyn Allocator))]
  (-> (ArrayList Range))
  (let [(mut ranges) (ArrayList::new [Range] a)]
    (for [i 0 (len (.instructions graph))] (push! (mut ranges) (no-range)))
    (for ref (.nodes (.schedule prepared))
      (when (= (n/opcode (get (.instructions graph) (cast i64 ref))) 67)
        (induction! graph prepared ref (mut ranges))))
    ranges))

(defn value-range [(graph g/Graph) (ranges (ArrayList Range)) (ref i32)] (-> Range)
  (let [value (operand graph ref)]
    (if (< value 0) (literal-range graph value)
        (if (and (> value 0) (< (cast i64 value) (len ranges)))
            (get ranges (cast i64 value)) (no-range)))))

;;; An interval crossing the sign bit becomes the full unsigned domain. Do not
;;; treat its signed endpoints as an ordered unsigned interval.
(defn unsigned-range [(r Range)] (-> Range)
  (let [modulus (<< (: 1 i128) (cast i128 (* (.width r) 8)))]
    (if (>= (.low r) 0) r
        (if (< (.high r) 0)
            (Range :valid (.valid r) :low (+ (.low r) modulus) :high (+ (.high r) modulus) :width (.width r))
            (Range :valid (.valid r) :low 0 :high (- modulus 1) :width (.width r))))))

(defn prove-range [(graph g/Graph) (ranges (ArrayList Range)) (branch i32)] (-> i32)
  (let [query (relation graph (.op2 (get (.instructions graph) (cast i64 branch))))
        (mut result) (: -1 i32)]
    (when (!= (.mask query) 0)
      (let [left (value-range graph ranges (.left query))
            right (value-range graph ranges (.right query))]
        (when (and (.valid left) (.valid right) (= (.width left) (.width query))
                   (= (.width right) (.width query)))
          (let [l (if (= (.domain query) 2) (unsigned-range left) left)
                r (if (= (.domain query) 2) (unsigned-range right) right)
                possible (| (if (< (.low l) (.high r)) (: 1 i32) 0)
                            (if (and (<= (.low l) (.high r)) (<= (.low r) (.high l))) (: 2 i32) 0)
                            (if (> (.high l) (.low r)) (: 4 i32) 0))]
            (if (= (& possible (.mask query)) 0) (set! result 0)
                (when (= (& possible (.mask query)) possible) (set! result 1)))))))
    result))

;;; graph: an owned edited graph, only when a branch outcome is proven.
;;; prepared: when no outcome is proven, the structural preparation of the
;;; caller's unchanged graph for this entry and these roots; the caller owns it
;;; and may hand it to a later stage over that same graph.
(defstruct Outcome [(graph (Option g/Graph)) (prepared (Option pipeline/Prepared))])

;;; All proofs use the original graph and dominators, independent of edit order.
(defn run-keeping-preparation [(graph g/Graph) (entry i32) (roots (slice i32))
                               (allocator (dyn Allocator)) (induction bool)]
  (-> (Result Outcome (slice u8)))
  (match (pipeline/prepare graph entry roots allocator)
    (Err [message] (Err message))
    (Ok [prepared]
      (let [(mut prepared) prepared (mut changes) (ArrayList::new [Change] allocator)
            (mut ranges) (if induction (induction-ranges graph prepared allocator)
                              (ArrayList::new [Range] allocator))]
        (for ref (.nodes (.schedule prepared))
          (when (= (n/opcode (get (.instructions graph) (cast i64 ref))) 116)
            (let [dominated (prove graph prepared ref)
                  truth (if (or (>= dominated 0) (not induction)) dominated
                            (prove-range graph ranges ref))]
              (when (>= truth 0)
                (push! (mut changes) (Change :branch ref :truth (!= truth 0)))))))
        (free! (mut ranges))
        (let [result
          (if (= (len changes) 0)
              (Outcome :graph (None [g/Graph]) :prepared (Some prepared))
              (let [(mut working) (g/duplicate graph allocator)]
                (pipeline/release! (mut prepared))
                (for change changes
                  (let [constant (match (g/intern-scalar! (mut working) 1 (if (.truth change) (: 1 u64) (: 0 u64)))
                                   (Some [r] r) (None [] (panic "branch fact constant allocation failed")))]
                    (unless (g/set-operand! (mut working) (.branch change) 2 constant)
                      (panic "branch fact condition update failed"))))
                (Outcome :graph (Some working) :prepared (None [pipeline/Prepared]))))]
          (free! (mut changes))
          (Ok result))))))

;;; Return an owned edited graph only when a branch outcome is proven.
(defn run-with-induction [(graph g/Graph) (entry i32) (roots (slice i32)) (allocator (dyn Allocator))
                           (induction bool)]
  (-> (Result (Option g/Graph) (slice u8)))
  (match (run-keeping-preparation graph entry roots allocator induction)
    (Err [message] (Err message))
    (Ok [outcome]
      (match (.prepared outcome)
        (Some [unused] (let [(mut unused) unused] (pipeline/release! (mut unused)) 0))
        (None [] 0))
      (Ok (.graph outcome)))))

(defn run [(graph g/Graph) (entry i32) (roots (slice i32)) (allocator (dyn Allocator))]
  (-> (Result (Option g/Graph) (slice u8)))
  (run-with-induction graph entry roots allocator false))
