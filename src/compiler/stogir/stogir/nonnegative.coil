;;; On-demand proof that an integer SSA value has a clear sign bit, used to
;;; select unsigned forms of signed operations. Two sources are combined:
;;; the structure of the defining expression, and integer comparisons against
;;; a literal on IF projections dominating the block where the user is placed,
;;; and the value's range, which knows guarded unit-step loop counters.
;;; Nothing here is a whole-graph analysis: a query walks bounded expressions
;;; and dominator chains.
(module stogir.nonnegative)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.fact-fold" :as fact-fold)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Option Some None])

;;; Scalar integers with a sign bit. BOOL is excluded: it has no signed value.
(defn word-type? [(ty i32)] (-> bool)
  (and (>= ty 2) (<= ty 11)))

(defn bits-of [(ty i32)] (-> i32)
  (if (word-type? ty) (* 8 (types/scalar-size ty 8)) 0))

(defn type-of [(graph g/Graph) (reference i32)] (-> i32)
  (match (g/lookup graph reference)
    (Some [node] (cast i32 (n/type-id node)))
    (None [] 0)))

;;; Bits of a numeric literal of a word type, truncated to that type's width.
;;; Named and address-of-function constants are relocations, never literals.
;;; A COPY of a literal (a constant hoisted out of a loop) has its value.
(defn literal [(graph g/Graph) (reference i32)] (-> (Option u64))
  (if (>= reference 0)
      (if (and (> reference 0) (g/contains? graph reference)
               (= (n/opcode (get (.instructions graph) (cast i64 reference))) 68)
               (< (.op1 (get (.instructions graph) (cast i64 reference))) 0))
          (literal graph (.op1 (get (.instructions graph) (cast i64 reference))))
          (None))
      (match (g/lookup graph reference)
        (None [] (None))
        (Some [node]
          (let [ty (cast i32 (n/type-id node)) width (bits-of ty)]
            (if (or (= width 0) (!= (cast i32 (n/opcode node)) ty))
                (None)
                (Some (if (= width 64)
                          (n/constant-bits node)
                          (& (n/constant-bits node)
                             (- (<< (: 1 u64) (cast u64 width)) 1))))))))))

(defn sign-bit [(width i32)] (-> u64)
  (<< (: 1 u64) (cast u64 (- width 1))))

;;; Same-width integer BITCAST keeps every bit and SEXT keeps the signed
;;; mathematical value, so the whole chain has one signed value. Loads,
;;; truncations, zero extensions, COPY barriers and PHIs end the chain.
(defn root [(graph g/Graph) (reference i32)] (-> i32)
  (let [(mut current) reference (mut done) false]
    (while (and (> current 0) (not done))
      (let [node (get (.instructions graph) (cast i64 current))
            opcode (n/opcode node)
            width (bits-of (cast i32 (n/type-id node)))
            source (bits-of (type-of graph (.op1 node)))]
        (if (and (> width 0) (> source 0)
                 (or (and (= opcode 36) (= source width))
                     (and (= opcode 33) (< source width))))
            (set! current (.op1 node))
            (set! done true))))
    current))

;;; Sign bit clear by construction. Every rule is a property of the value
;;; itself, so it holds for each dynamic instance and may cross a PHI.
(defn structural? [(graph g/Graph) (reference i32) (depth i32)] (-> bool)
  (if (< reference 0)
      (match (literal graph reference)
        (None [] false)
        (Some [bits]
          (= (& bits (sign-bit (bits-of (type-of graph reference)))) 0)))
      (if (or (= reference 0) (<= depth 0))
          false
          (let [node (get (.instructions graph) (cast i64 reference))
                opcode (n/opcode node)
                ty (cast i32 (n/type-id node))
                width (bits-of ty)
                source (type-of graph (.op1 node))]
            (if (= width 0)
                false
                (cond
                  (= opcode 36)
                    (and (= (bits-of source) width)
                         (structural? graph (.op1 node) (- depth 1)))
                  (= opcode 33)
                    (and (> (bits-of source) 0) (< (bits-of source) width)
                         (structural? graph (.op1 node) (- depth 1)))
                  (= opcode 34)
                    (and (types/integer? source)
                         (< (* 8 (types/scalar-size source 8)) width))
                  (= opcode 47)
                    (or (structural? graph (.op1 node) (- depth 1))
                        (structural? graph (.op2 node) (- depth 1)))
                  (= opcode 50)
                    (match (literal graph (.op2 node))
                      (None [] false)
                      (Some [count] (and (>= count 1) (< count (cast u64 width)))))
                  (= opcode 29)
                    (and (types/unsigned? ty)
                         (match (literal graph (.op2 node))
                           (None [] false)
                           (Some [divisor] (>= divisor 2))))
                  (= opcode 30)
                    (and (types/unsigned? ty)
                         (match (literal graph (.op2 node))
                           (None [] false)
                           (Some [divisor]
                             (and (>= divisor 1) (<= divisor (sign-bit width))))))
                  (and (>= opcode 55) (<= opcode 57))
                    true
                  (= opcode 60)
                    (and (structural? graph (.op2 node) (- depth 1))
                         (structural? graph (.op3 node) (- depth 1)))
                  (= opcode 67)
                    (let [arity (cast i32 (get (.arities graph) (cast i64 reference)))
                          (mut all) (and (>= arity 2) (<= arity 5))
                          (mut slot) (: 2 i32)]
                      (while (and all (<= slot arity))
                        (set! all
                              (match (g/operand graph reference slot)
                                (None [] false)
                                (Some [input]
                                  (structural? graph input (- depth 1)))))
                        (set! slot (+ slot 1)))
                      all)
                  :else false))))))

;;; Does `condition` having the given truth imply that the value whose chain
;;; root is `target` is non-negative? Outcome mask of (value ? literal): LT=1,
;;; EQ=2, GT=4. Signedness comes from the comparison opcode. The comparison is
;;; evaluated at its operand width on a value equal, as a signed integer, to
;;; the target, so the literal is interpreted at that width.
(defn implied? [(graph g/Graph) (condition i32) (truth bool) (target i32) (depth i32)]
  (-> bool)
  (if (or (<= condition 0) (<= depth 0))
      false
      (let [node (get (.instructions graph) (cast i64 condition))
            opcode (cast i32 (n/opcode node))]
        (cond
          (!= (n/type-id node) 1) false
          ; A true conjunction makes both operands true; a false disjunction
          ; makes both false. Either operand may carry the fact.
          (or (and (= opcode 47) truth) (and (= opcode 46) (not truth)))
            (and (= (type-of graph (.op1 node)) 1) (= (type-of graph (.op2 node)) 1)
                 (or (implied? graph (.op1 node) truth target (- depth 1))
                     (implied? graph (.op2 node) truth target (- depth 1))))
          (and (>= opcode 14) (<= opcode 23))
            (let [width (bits-of (type-of graph (.op1 node)))
                  direct (cast i32 (match opcode (14 2) (15 5) (16 1) (17 6) (18 3) (19 4)
                           (20 1) (21 6) (22 3) (23 4) (_ 0)))
                  (mut mask) (: 0 i32)
                  (mut bits) (: 0 u64)]
              (when (and (> width 0)
                         (= (type-of graph (.op1 node)) (type-of graph (.op2 node))))
                (match (literal graph (.op2 node))
                  (Some [value]
                    (when (= (root graph (.op1 node)) target)
                      (set! mask direct) (set! bits value)))
                  (None []
                    (match (literal graph (.op1 node))
                      (Some [value]
                        (when (= (root graph (.op2 node)) target)
                          (set! mask (| (& direct 2) (<< (& direct 1) 2)
                                        (>> (& direct 4) 2)))
                          (set! bits value)))
                      (None [] 0)))))
              (when (and (!= mask 0) (not truth)) (set! mask (^ mask 7)))
              (if (= mask 0)
                  false
                  (let [negative (!= (& bits (sign-bit width)) 0)
                        ones (if (= width 64) (: 0xFFFFFFFFFFFFFFFF u64)
                                 (- (<< (: 1 u64) (cast u64 width)) 1))]
                    (if (< opcode 20)
                        ; value >= literal >= 0, or value > -1.
                        (and (= (& mask 1) 0)
                             (or (not negative) (and (= mask 4) (= bits ones))))
                        ; value <=u literal <= signed max, or value <u 2^(w-1).
                        (and (= (& mask 4) 0)
                             (or (not negative)
                                 (and (= mask 1) (= bits (sign-bit width)))))))))
          :else false))))

;;; `block` is the block start where the user is scheduled. A block starting
;;; with an IF projection is entered only through it, and that projection
;;; dominates every block reached by following immediate dominators, so the
;;; tested SSA value still satisfies the condition at the user. The walk is
;;; bounded; an unvisited ancestor only loses a proof.
(defn dominated? [(graph g/Graph) (idom (ArrayList i32)) (block i32) (target i32)]
  (-> bool)
  (let [(mut cursor) block (mut found) false (mut left) (: 64 i32)]
    (while (and (> cursor 0) (< (cast i64 cursor) (len idom)) (not found) (> left 0))
      (let [start (get (.instructions graph) (cast i64 cursor))
            opcode (n/opcode start)
            parent (get idom (cast i64 cursor))]
        (when (and (or (= opcode 107) (= opcode 108)) (> (.op1 start) 0))
          (let [branch (get (.instructions graph) (cast i64 (.op1 start)))]
            (when (= (n/opcode branch) 116)
              (set! found (implied? graph (.op2 branch) (= opcode 107) target 3)))))
        (set! cursor (if (= parent cursor) 0 parent))
        (set! left (- left 1))))
    found))

;;; Branch facts apply only to the value's own BITCAST/SEXT chain: a PHI input
;;; tested on this path may be a different dynamic instance than the one the
;;; PHI carries. An empty idom disables the dominating-branch source and the
;;; ranges that need control flow (guarded loop counters and sums of them).
(defn proven? [(graph g/Graph) (idom (ArrayList i32)) (block i32) (value i32)]
  (-> bool)
  (or (structural? graph value 4)
      (let [target (root graph value)]
        (and (> target 0) (> (len idom) 0)
             (or (dominated? graph idom block target)
                 (let [range (fact-fold/value-range graph idom true target 4)]
                   (and (.valid range) (>= (.low range) 0))))))))
