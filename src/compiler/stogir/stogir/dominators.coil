;;; Iterative immediate dominators over reachable reverse postorder.
(module stogir.dominators)
(import "stogir.fill" :as fill)
(import "stogir.cfg" :as cfg)
(import "stogir.adjacency" :as adj)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])

(defn intersect [(idom (ArrayList i32)) (rank (ArrayList i64)) (a i32) (b i32)]
  (-> i32)
  (let [(mut x) a
        (mut y) b]
    (while (!= x y)
      (while (> (get rank (cast i64 x)) (get rank (cast i64 y)))
        (set! x (get idom (cast i64 x))))
      (while (> (get rank (cast i64 y)) (get rank (cast i64 x)))
        (set! y (get idom (cast i64 y)))))
    x))

;;; Valid CFG, matching adjacency, nonempty reachable RPO are required.
;;; Entry dominates itself; unreachable/non-block entries retain zero.
(defn build [(blocks cfg/Blocks)
             (predecessors adj/Index)
             (order (ArrayList i32))
             (allocator (dyn Allocator))]
  (-> (ArrayList i32))
  (let [(mut idom) (ArrayList::new [i32] allocator)
        (mut rank) (ArrayList::new [i64] allocator)
        (mut i) 0]
    (extend-zeroed! (mut idom) (len (.membership blocks)))
    (fill/append! (mut rank) (len (.membership blocks)) -1)
    (set! i 0)
    (while (< i (len order))
      (set! (mut rank) (cast i64 (get order i)) i)
      (set! i (+ i 1)))
    (when (> (len order) 0)
      (let [entry (get order 0)
            (mut changed) true]
        (set! (mut idom) (cast i64 entry) entry)
        (while changed
          (set! changed false)
          (set! i 1)
          (while (< i (len order))
            (let [block (get order i)
                  range (get (.ranges predecessors) (cast i64 block))
                  (mut parent) (: 0 i32)
                  (mut j) 0]
              (while (< j (.count range))
                (let [edge-index
                        (get (.edges predecessors) (+ (.offset range) j))
                      edge (get (.edges blocks) edge-index)
                      source (.from edge)]
                  (when (!= (get idom (cast i64 source)) 0)
                    (set! parent
                          (if (= parent 0)
                              source
                              (intersect idom rank parent source)))))
                (set! j (+ j 1)))
              (when (!= (get idom (cast i64 block)) parent)
                (set! (mut idom) (cast i64 block) parent)
                (set! changed true)))
            (set! i (+ i 1))))))
    (free! (mut rank))
    idom))

(defn dominates? [(idom (ArrayList i32)) (ancestor i32) (block i32)] (-> bool)
  (let [(mut current) block
        (mut done) false
        (mut answer) false]
    (while (not done)
      (if (or (<= current 0) (>= (cast i64 current) (len idom)))
          (set! done true)
          (let [parent (get idom (cast i64 current))]
            (if (= parent 0)
                (set! done true)
                (if (= current ancestor)
                    (do (set! answer true) (set! done true))
                    (if (= current parent)
                        (set! done true)
                        (set! current parent)))))))
    answer))

;;; Common dominator for reachable blocks, or zero if either is unreachable.
(defn common [(idom (ArrayList i32)) (a i32) (b i32)] (-> i32)
  (if (or (<= a 0)
          (<= b 0)
          (>= (cast i64 a) (len idom))
          (>= (cast i64 b) (len idom)))
      0
      (if (or (= (get idom (cast i64 a)) 0) (= (get idom (cast i64 b)) 0))
          0
          (let [(mut x) a
                (mut y) b
                (mut dx) 0
                (mut dy) 0]
            (while (!= x (get idom (cast i64 x)))
              (set! x (get idom (cast i64 x)))
              (set! dx (+ dx 1)))
            (while (!= y (get idom (cast i64 y)))
              (set! y (get idom (cast i64 y)))
              (set! dy (+ dy 1)))
            (set! x a)
            (set! y b)
            (while (> dx dy)
              (set! x (get idom (cast i64 x)))
              (set! dx (- dx 1)))
            (while (> dy dx)
              (set! y (get idom (cast i64 y)))
              (set! dy (- dy 1)))
            (while (!= x y)
              (set! x (get idom (cast i64 x)))
              (set! y (get idom (cast i64 y))))
            x))))

;;; Immutable Euler intervals over a valid immediate-dominator forest. Zero
;;; parents are unreachable/non-block entries. Roots point to themselves.
;;; Iterative traversal keeps host stack usage bounded even for deep CFGs.
(defstruct Index [(first (ArrayList i32)) (last (ArrayList i32))])

(defn release-index! [(index (mut Index))] (-> void)
  (free! (mut (.first index)))
  (free! (mut (.last index))))

(defn build-index [(idom (ArrayList i32)) (a (dyn Allocator))] (-> Index)
  (let [size (len idom)
        (mut result) (Index :first (ArrayList::new [i32] a) :last (ArrayList::new [i32] a))
        (mut child) (ArrayList::new [i32] a)
        (mut sibling) (ArrayList::new [i32] a)
        (mut work) (ArrayList::new [i32] a)
        (mut clock) (: 0 i32)]
    (extend-zeroed! (mut (.first result)) size)
    (extend-zeroed! (mut (.last result)) size)
    (extend-zeroed! (mut child) size)
    (extend-zeroed! (mut sibling) size)
    (for [i 1 size]
      (let [parent (get idom i)]
        (when (and (> parent 0) (!= (cast i64 parent) i))
          (set! (mut sibling) i (get child (cast i64 parent)))
          (set! (mut child) (cast i64 parent) (cast i32 i)))))
    (for [root 1 size]
      (when (= (cast i64 (get idom root)) root)
        (set! clock (+ clock 1))
        (set! (mut (.first result)) root clock)
        (push! (mut work) (cast i32 root))
        (while (> (len work) 0)
          (let [block (cast i64 (get work (- (len work) 1)))
                next (get child block)]
            (if (> next 0)
                (do
                  (set! (mut child) block (get sibling (cast i64 next)))
                  (set! clock (+ clock 1))
                  (set! (mut (.first result)) (cast i64 next) clock)
                  (push! (mut work) next))
                (do
                  (set! (mut (.last result)) block clock)
                  (pop! (mut work))))))))
    (free! (mut work))
    (free! (mut sibling))
    (free! (mut child))
    result))

(defn indexed-dominates? [(index Index) (ancestor i32) (block i32)] (-> bool)
  (and (> ancestor 0) (> block 0)
       (< (cast i64 ancestor) (len (.first index)))
       (< (cast i64 block) (len (.first index)))
       (> (get (.first index) (cast i64 ancestor)) 0)
       (> (get (.first index) (cast i64 block)) 0)
       (<= (get (.first index) (cast i64 ancestor)) (get (.first index) (cast i64 block)))
       (>= (get (.last index) (cast i64 ancestor)) (get (.last index) (cast i64 block)))))
