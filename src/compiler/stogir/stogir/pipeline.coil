;;; Standalone graph-to-schedule orchestration and owned pass results.
(module stogir.pipeline)
(import "stogir.graph" :as g)
(import "stogir.verify" :as verify)
(import "stogir.node" :as node)
(import "stogir.opcode" :as opcode)
(import "stogir.cfg" :as cfg)
(import "stogir.adjacency" :as adj)
(import "stogir.dominators" :as dom)
(import "stogir.loops" :as loops)
(import "stogir.liveness" :as live)
(import "stogir.placement" :as placement)
(import "stogir.schedule" :as schedule)
(import "stogir.checked-schedule" :as checked-schedule)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Prepared
  [(blocks cfg/Blocks)
   (order (ArrayList i32))
   (schedule schedule/Schedule)
   (idom (ArrayList i32))
   (depths (ArrayList i32))])

(defn release! [(prepared (mut Prepared))] (-> void)
  (cfg/release! (mut (.blocks prepared)))
  (free! (mut (.order prepared)))
  (free! (mut (.idom prepared)))
  (free! (mut (.depths prepared)))
  (schedule/release! (mut (.schedule prepared))))

(defn validate-input [(graph g/Graph) (entry i32) (roots (slice i32))]
  (-> (Result i32 (slice u8)))
  (match (verify/structure graph)
    (Err [msg] (Err msg))
    (Ok [_]
        (let [(mut error) ""]
          (match (g/lookup graph entry)
            (None [] (set! error "entry missing"))
            (Some [instruction]
                  (when (or (<= entry 0)
                            (not (opcode/block-start? (cast i32
                                                            (node/opcode instruction)))))
                    (set! error "entry must be a block start"))))
          (when (= (len roots) 0)
            (set! error "compilation requires observable roots"))
          (for root roots
            (when (or (<= root 0) (not (g/contains? graph root)))
              (set! error "invalid root reference")))
          (if (= error "") (verify/phis graph) (Err error))))))

;;; Entry is a reachable block-start node, roots include observable control exits.
;;; Current verifier/placement coverage is scalar; unsupported emission is separate.
(defn prepare [(graph g/Graph)
               (entry i32)
               (roots (slice i32))
               (allocator (dyn Allocator))] (-> (Result Prepared (slice u8)))
  (match (validate-input graph entry roots)
    (Err [msg] (Err msg))
    (Ok [_]
        (if (or (<= entry 0) (not (g/contains? graph entry)))
            (Err "invalid entry reference")
            (match (cfg/build graph allocator)
              (Err [msg] (Err msg))
              (Ok [blocks]
                  (let [(mut owned) blocks
                        (mut pred) (adj/build owned true allocator)
                        (mut succ) (adj/build owned false allocator)
                        (mut order)
                          (adj/reverse-postorder owned succ entry allocator)
                        (mut idom) (dom/build owned pred order allocator)
                        (mut depth) (loops/depths owned pred idom allocator)
                        (mut marked) (live/mark graph roots allocator)
                        (mut error) ""
                        (mut packed)
                          (schedule/Schedule
                            :ranges (ArrayList::new [schedule/Range] allocator)
                            :nodes (ArrayList::new [i32] allocator))]
                    (match (placement/pinned graph owned allocator)
                      (Err [msg] (set! error msg))
                      (Ok [mapping]
                          (let [(mut placed) mapping]
                            (match (placement/early! graph
                                                     (mut placed)
                                                     idom
                                                     entry
                                                     allocator)
                              (Err [msg] (set! error msg))
                              (Ok [_] 0))
                            (when (= error "")
                              (match (placement/late! graph
                                                      (mut placed)
                                                      idom
                                                      depth
                                                      marked
                                                      allocator)
                                (Err [msg] (set! error msg))
                                (Ok [_] 0)))
                            (when (= error "")
                              (match (checked-schedule/place! graph
                                                              (mut placed)
                                                              marked)
                                (Err [message] (set! error message))
                                (Ok [_] 0)))
                            (when (= error "")
                              (match (schedule/order graph
                                                     placed
                                                     marked
                                                     allocator)
                                (Err [msg] (set! error msg))
                                (Ok [local]
                                    (let [(mut local-order) local]
                                      (schedule/release! (mut packed))
                                      (set! packed
                                            (schedule/pack local-order
                                                           placed
                                                           order
                                                           allocator))
                                      (match (checked-schedule/cluster! graph
                                                                        placed
                                                                        (mut packed)
                                                                        allocator)
                                        (Err [message] (set! error message))
                                        (Ok [_] 0))
                                      (free! (mut local-order))))))
                            (free! (mut placed)))))
                    (adj/release! (mut pred))
                    (adj/release! (mut succ))
                    (free! (mut marked))
                    (if (!= error "")
                        (do
                          (free! (mut idom))
                          (free! (mut depth))
                          (cfg/release! (mut owned))
                          (free! (mut order))
                          (schedule/release! (mut packed))
                          (Err error))
                        (Ok (Prepared
                              :idom idom
                              :depths depth
                              :blocks owned
                              :order order
                              :schedule packed))))))))))
