;;; Standalone graph-to-schedule orchestration and owned pass results.
(module stogir.pipeline)
(export Prepared release! validate-input prepare prepare-native prepare-after-validate
        prepare-native-anchored prepare-anchored-after-validate schedule-appended!)
(import "stogir.graph" :as g)
(import "stogir.verify" :as verify)
(import "stogir.uses" :as uses)
(import "stogir.node" :as node)
(import "stogir.opcode" :as opcode)
(import "stogir.cfg" :as cfg)
(import "stogir.adjacency" :as adj)
(import "stogir.dominators" :as dom)
(import "stogir.loops" :as loops)
(import "stogir.liveness" :as live)
(import "stogir.placement" :as placement)
(import "stogir.schedule" :as schedule)
(import "stogir.checked-schedule" :as checked-schedule)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

;;; users are the use lists placement and scheduling built for this exact,
;;; immutable graph; later stages over the same graph may borrow them.
(defstruct Prepared
  [(blocks cfg/Blocks)
   (order (ArrayList i32))
   (schedule schedule/Schedule)
   (idom (ArrayList i32))
   (depths (ArrayList i32))
   (users uses/Uses)])

(defn release! [(prepared (mut Prepared))] (-> void)
  (cfg/release! (mut (.blocks prepared)))
  (free! (mut (.order prepared)))
  (free! (mut (.idom prepared)))
  (free! (mut (.depths prepared)))
  (uses/release! (mut (.users prepared)))
  (schedule/release! (mut (.schedule prepared))))

;;; Schedule floating nodes appended to graph since prepared was built for its
;;; unchanged prefix. Each node has no instruction operands, so it may sit
;;; anywhere; it is placed last in its block, before the block end. The caller
;;; has already rewritten the users, each dominated by that block. Per-reference
;;; facts grow to the new graph size and the use lists are rebuilt; block
;;; structure, dominance and loop depths are unchanged. nodes and blocks are
;;; parallel. On error prepared is unchanged.
(defn schedule-appended! [(prepared (mut Prepared)) (graph g/Graph)
                          (nodes (slice i32)) (blocks (slice i32))
                          (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [size (len (.instructions graph))
        scheduled (.schedule prepared)
        (mut error) ""]
    (when (or (!= (len nodes) (len blocks)) (< size (len (.ranges scheduled))))
      (set! error "appended schedule does not match the graph"))
    (for [i 0 (len nodes)]
      (when (= error "")
        (let [reference (get nodes i) block (get blocks i)]
          (if (or (< (cast i64 reference) (len (.ranges scheduled)))
                  (>= (cast i64 reference) size)
                  (<= block 0) (>= (cast i64 block) (len (.ranges scheduled))))
              (set! error "appended node or its block is out of range")
              (let [range (get (.ranges scheduled) (cast i64 block))
                    node (get (.instructions graph) (cast i64 reference))]
                (if (< (.count range) 2)
                    (set! error "appended node needs a block with start and end")
                    (let [last (get (.nodes scheduled) (- (+ (.offset range) (.count range)) 1))]
                      (unless (and (opcode/block-end?
                                     (cast i32 (node/opcode (get (.instructions graph)
                                                                 (cast i64 last)))))
                                   (!= (& (opcode/properties (cast i32 (node/opcode node)))
                                          opcode/FLAG-FLOATING-DATA) 0))
                        (set! error "appended node is not floating or block has no end")))))))))
    ; Every block's range must begin with its own start node, in layout order.
    (let [(mut cursor) (: 0 i64) old (.nodes scheduled)]
      (while (and (= error "") (< cursor (len old)))
        (let [block (get old cursor)
              range (get (.ranges scheduled) (cast i64 block))]
          (if (or (!= (.offset range) cursor) (< (.count range) 1)
                  (not (opcode/block-start?
                         (cast i32 (node/opcode (get (.instructions graph) (cast i64 block)))))))
              (set! error "schedule is not a sequence of block ranges")
              (set! cursor (+ cursor (.count range)))))))
    (if (!= error "")
        (Err error)
        (let [added (- size (len (.ranges scheduled)))
              (mut merged) (ArrayList::new [i32] allocator)
              old (.nodes scheduled)]
          (extend-zeroed! (mut (.membership (.blocks prepared))) added)
          (extend-zeroed! (mut (.idom prepared)) added)
          (extend-zeroed! (mut (.depths prepared)) added)
          (extend-zeroed! (mut (.ranges (.schedule prepared))) added)
          (reserve! (mut merged) (+ (len old) (len nodes)))
          ; Blocks keep their layout order; each grows by its appended nodes.
          (let [(mut cursor) (: 0 i64)]
            (while (< cursor (len old))
              (let [block (get old cursor)
                    range (get (.ranges (.schedule prepared)) (cast i64 block))
                    start (len merged)
                    (mut extra) (: 0 i64)]
                (for [i 0 (len nodes)]
                  (when (= (get blocks i) block) (set! extra (+ extra 1))))
                (if (= extra 0)
                    (for [k 0 (.count range)]
                      (push! (mut merged) (get old (+ cursor k))))
                    (do
                      (for [k 0 (- (.count range) 1)]
                        (push! (mut merged) (get old (+ cursor k))))
                      (for [i 0 (len nodes)]
                        (when (= (get blocks i) block) (push! (mut merged) (get nodes i))))
                      (push! (mut merged) (get old (- (+ cursor (.count range)) 1)))))
                (set! (mut (.ranges (.schedule prepared))) (cast i64 block)
                      (schedule/Range :offset start :count (- (len merged) start)))
                (set! cursor (+ cursor (.count range))))))
          (free! (mut (.nodes (.schedule prepared))))
          (set! (.nodes (.schedule prepared)) merged)
          (uses/release! (mut (.users prepared)))
          (set! (.users prepared) (uses/build graph allocator))
          (Ok (cast i32 (len nodes)))))))

(defn validate-input [(graph g/Graph) (entry i32) (roots (slice i32))]
  (-> (Result i32 (slice u8)))
  (verify/schedule-input graph entry roots))

;;; Entry is a reachable block-start node, roots include observable control exits.
;;; Current verifier/placement coverage is scalar; unsupported emission is separate.
;;; Callers verify the graph's structure and control sources first.
(defn prepare-checked [(graph g/Graph)
               (entry i32)
               (roots (slice i32))
               (allocator (dyn Allocator))] (-> (Result Prepared (slice u8)))
  (prepare-anchored-checked graph entry roots [] allocator))

;;; As prepare-checked; anchors are uses outside the graph's operand edges that
;;; late placement must honour (placement/Anchor).
(defn prepare-anchored-checked [(graph g/Graph)
               (entry i32)
               (roots (slice i32))
               (anchors (slice placement/Anchor))
               (allocator (dyn Allocator))] (-> (Result Prepared (slice u8)))
  (if (or (<= entry 0) (not (g/contains? graph entry)))
      (Err "invalid entry reference")
      (match (cfg/build-verified graph allocator)
        (Err [msg] (Err msg))
        (Ok [blocks]
            (let [(mut owned) blocks
                  (mut pred) (adj/build owned true allocator)
                  (mut succ) (adj/build owned false allocator)
                  (mut order)
                    (adj/reverse-postorder owned succ entry allocator)
                  (mut idom) (dom/build owned pred order allocator)
                  (mut depth) (loops/depths owned pred idom allocator)
                  (mut marked) (live/mark graph roots allocator)
                  ; Placement and scheduling only mutate their own facts.
                  (mut users) (uses/build graph allocator)
                  (mut error) ""
                  (mut packed)
                    (schedule/Schedule
                      :ranges (ArrayList::new [schedule/Range] allocator)
                      :nodes (ArrayList::new [i32] allocator))]
              (match (placement/pinned graph owned allocator)
                (Err [msg] (set! error msg))
                (Ok [mapping]
                    (let [(mut placed) mapping]
                      (match (placement/early-with-uses! graph
                                                         (mut placed)
                                                         idom
                                                         entry
                                                         users
                                                         allocator)
                        (Err [msg] (set! error msg))
                        (Ok [_] 0))
                      (when (= error "")
                        (match (placement/late-anchored-with-uses! graph
                                                          (mut placed)
                                                          idom
                                                          depth
                                                          marked
                                                          users
                                                          anchors
                                                          allocator)
                          (Err [msg] (set! error msg))
                          (Ok [_] 0)))
                      (when (= error "")
                        (match (checked-schedule/place! graph
                                                        (mut placed)
                                                        marked)
                          (Err [message] (set! error message))
                          (Ok [_] 0)))
                      (when (= error "")
                        (match (loops/reorder! owned
                                               succ
                                               idom
                                               depth
                                               (mut order)
                                               allocator)
                          (Err [message] (set! error message))
                          (Ok [_] 0)))
                      (when (= error "")
                        (match (schedule/order-with-uses graph
                                                         placed
                                                         marked
                                                         users
                                                         allocator)
                          (Err [msg] (set! error msg))
                          (Ok [local]
                              (let [(mut local-order) local]
                                (schedule/release! (mut packed))
                                (set! packed
                                      (schedule/pack local-order
                                                     placed
                                                     order
                                                     allocator))
                                (match (checked-schedule/cluster! graph
                                                                  placed
                                                                  (mut packed)
                                                                  allocator)
                                  (Err [message] (set! error message))
                                  (Ok [_] 0))
                                (free! (mut local-order))))))
                      (free! (mut placed)))))
              (adj/release! (mut pred))
              (adj/release! (mut succ))
              (free! (mut marked))
              (if (!= error "")
                  (do
                    (uses/release! (mut users))
                    (free! (mut idom))
                    (free! (mut depth))
                    (cfg/release! (mut owned))
                    (free! (mut order))
                    (schedule/release! (mut packed))
                    (Err error))
                  (Ok (Prepared
                        :idom idom
                        :depths depth
                        :blocks owned
                        :order order
                        :schedule packed
                        :users users))))))))


;;; Public wrappers retain all checks; the shared implementation is private.
(defn prepare [(graph g/Graph) (entry i32) (roots (slice i32))
                 (allocator (dyn Allocator))] (-> (Result Prepared (slice u8)))
  (match (verify/schedule-input-and-control graph entry roots)
    (Err [message] (Err message))
    (Ok [_] (prepare-checked graph entry roots allocator))))

;;; Complete native validation and scheduling share an immutable input scope.
;;; No unchecked entry or stored validation proof is exported.
(defn prepare-native [(graph g/Graph) (entry i32) (roots (slice i32))
                        (allocator (dyn Allocator))] (-> (Result Prepared (slice u8)))
  (match (verify/native-input-and-control graph entry roots)
    (Err [message] (Err message))
    (Ok [_] (prepare-checked graph entry roots allocator))))

;;; prepare-native whose late placement also honours anchors.
(defn prepare-native-anchored [(graph g/Graph) (entry i32) (roots (slice i32))
                               (anchors (slice placement/Anchor))
                               (allocator (dyn Allocator))] (-> (Result Prepared (slice u8)))
  (match (verify/native-input-and-control graph entry roots)
    (Err [message] (Err message))
    (Ok [_] (prepare-anchored-checked graph entry roots anchors allocator))))

;;; prepare-after-validate (native true) whose late placement also honours anchors.
(defn prepare-anchored-after-validate [(graph g/Graph) (entry i32) (roots (slice i32))
                                       (anchors (slice placement/Anchor))
                                       (allocator (dyn Allocator))]
  (-> (Result Prepared (slice u8)))
  (match (verify/native-input-and-control-after-validate graph entry roots)
    (Err [message] (Err message))
    (Ok [_] (prepare-anchored-checked graph entry roots anchors allocator))))

;;; prepare (native false) or prepare-native (native true) for a graph whose
;;; exact content passed sccp-rewrite/validate at eight-byte pointers, as the
;;; caller established for this unchanged graph (see verify's after-validate
;;; checks). Only the checks that validation does not cover run here.
(defn prepare-after-validate [(graph g/Graph) (entry i32) (roots (slice i32)) (native bool)
                              (allocator (dyn Allocator))] (-> (Result Prepared (slice u8)))
  (match (if native
             (verify/native-input-and-control-after-validate graph entry roots)
             (verify/schedule-input-and-control-after-validate graph entry roots))
    (Err [message] (Err message))
    (Ok [_] (prepare-checked graph entry roots allocator))))
