;;; Logical transfers before physical-copy lowering. Keep identities between
;;; distinct children: recoloring can turn an identity into a real transfer.
(module stogir.allocation-transfers)
(import "stogir.allocation" :as a)
(import "stogir.allocation-recolor" :as rc)
(import "stogir.interval" :as ranges)
(import "stogir.locations" :as loc)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.cfg" :as cfg)
(import "stogir.matched-uses" :as machine)
(import "stogir.schedule" :as schedule)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn child [(parts (ArrayList a/Part)) (index loc/Index) (parent i32) (position i64)] (-> i32)
  (let [(mut found) (: -1 i32)]
    (when (and (>= parent 0) (< (cast i64 parent) (len (.parents index))))
      (let [bucket (get (.parents index) (cast i64 parent))]
        (for [i (.offset bucket) (+ (.offset bucket) (.count bucket))]
          (let [part (get (.children index) i)]
            (when (ranges/covers? (.ranges (get parts (cast i64 part))) position)
              (assert (< found 0)) (set! found part))))))
    found))

(defn endpoint [(parts (ArrayList a/Part)) (index loc/Index) (reference i32) (position i64)]
  (-> (Result rc/Endpoint (slice u8)))
  (let [constant (loc/constant-reference-indexed index reference)]
    (if (< constant 0) (Ok (rc/recipe (loc/Location :kind 4 :value (cast i64 constant))))
        (let [part (child parts index reference position)]
          (if (>= part 0) (Ok (rc/allocated part))
              (match (loc/query parts index true reference position)
                (Err [message] (Err message))
                (Ok [location]
                  (if (and (>= (.kind location) 2) (<= (.kind location) 4))
                      (Ok (rc/recipe location)) (Err "transfer source lacks allocation child")))))))))

;;; Bound static loop weighting independently of nesting depth. This is a cost
;;; heuristic, not a dynamic profile; saturating here prevents score overflow.
(defn weight [(depths (ArrayList i32)) (block i32)] (-> i64)
  (let [depth (if (and (>= block 0) (< (cast i64 block) (len depths)))
                 (get depths (cast i64 block)) 0)
        (mut result) (: 1 i64)]
    (for [i 0 6] (when (< i (cast i64 depth)) (set! result (* result 10)))) result))

;;; Adjacent coalesced ranges may be separate SSA definitions. These are
;;; births, not value transfers. Both cost construction and emission use this
;;; predicate, including all outputs of selected multi-result instructions.
(defn redefined? [(graph g/Graph) (scheduled schedule/Schedule) (parts (ArrayList a/Part))
                   (index loc/Index) (matched machine/Plan) (parent i32) (position i64)] (-> bool)
  (let [(mut found) false]
    (when (and (.coalesced index) (= (% position 2) 1))
      (let [reference (get (.nodes scheduled) (/ position 2))
            opcode (n/opcode (get (.instructions graph) (cast i64 reference)))]
        (unless (or (= opcode 68) (= opcode 36))
          (for [output 0 (machine/definition-count matched reference)]
            (let [value (machine/definition-at matched reference output)
                  bucket (get (.parents index) (cast i64 value))]
              (when (and (> (.count bucket) 0) (= (loc/owner parts index value) parent))
                (set! found true)))))))
    found))

(defn build [(parts (ArrayList a/Part)) (index loc/Index) (graph g/Graph)
              (blocks cfg/Blocks) (scheduled schedule/Schedule) (depths (ArrayList i32)) (matched machine/Plan)
              (allocator (dyn Allocator))] (-> (Result (ArrayList rc/Copy) (slice u8)))
  (let [(mut copies) (ArrayList::new [rc/Copy] allocator)
        (mut excluded) (ArrayList::new [i32] allocator)
        (mut error) ""]
    (for [e 0 (len (.edges blocks))]
      (let [edge (get (.edges blocks) e)
            from (get (.ranges scheduled) (cast i64 (.from edge)))
            to (get (.ranges scheduled) (cast i64 (.to edge)))
            source-position (- (* (+ (.offset from) (.count from)) 2) 1)
            destination-position (* (.offset to) 2)
            left (weight depths (.from edge)) right (weight depths (.to edge))
            cost (if (< left right) left right)]
        ; CFG may retain unreachable blocks omitted from the schedule.
        (when (and (> (.count from) 0) (> (.count to) 0))
          (clear! (mut excluded))
          (for [i (.offset to) (+ (.offset to) (.count to))]
            (let [ref (get (.nodes scheduled) i) node (get (.instructions graph) (cast i64 ref))]
              (when (= (n/opcode node) 67)
                (let [target (child parts index ref destination-position)]
                  (if (< target 0) (set! error "phi destination lacks allocation child")
                      (do
                        (push! (mut excluded) (.parent (get parts (cast i64 target))))
                        (match (g/operand graph ref (+ (.position edge) 1))
                          (None [] (set! error "phi transfer operand missing"))
                          (Some [source]
                            (match (endpoint parts index source source-position)
                              (Err [message] (set! error message))
                              (Ok [source] (rc/add-copy! (mut copies) source target e cost)))))))))))
          ; Exact coverage at successor entry is ordinary live-in plus PHI
          ; definitions. Excluding canonical PHI owners leaves ordinary values.
          (for [i 0 (len parts)]
            (let [part (get parts i)]
              (when (and (>= (.parent part) 0) (ranges/covers? (.ranges part) source-position))
                (let [target (child parts index (.parent part) destination-position) (mut phi) false]
                  (for owner excluded (when (= owner (.parent part)) (set! phi true)))
                  (when (and (>= target 0) (not phi))
                    (rc/add-copy! (mut copies) (rc/allocated (cast i32 i)) target e cost)))))))))
    ; Internal cuts are precisely contiguous children, as in locations. Group
    ; by position, including call-definition phases, and omit block boundaries.
    (for block (.starts blocks)
      (let [range (get (.ranges scheduled) (cast i64 block)) cost (weight depths block)]
        (for [position (+ (* (.offset range) 2) 1) (* (+ (.offset range) (.count range)) 2)]
          (for [i 0 (len parts)]
            (let [part (get parts i)]
              (when (and (>= (.parent part) 0) (> (len (.ranges part)) 0)
                         (= (.start (get (.ranges part) 0)) position))
                (let [prior (child parts index (.parent part) (- position 1))]
                  (when (>= prior 0)
                    (let [before (.ranges (get parts (cast i64 prior)))]
                      (when (and (= (.end (get before (- (len before) 1))) position)
                                 (not (redefined? graph scheduled parts index matched (.parent part) position)))
                        (let [reference (get (.nodes scheduled) (/ position 2))
                              opcode (n/opcode (get (.instructions graph) (cast i64 reference)))]
                          (rc/add-copy-with-limit! (mut copies) (rc/allocated prior) (cast i32 i)
                            (+ (len (.edges blocks)) position) cost
                            (and (= (% position 2) 1) (!= opcode 79) (!= opcode 80))))))))))))))
    (free! (mut excluded))
    ; Blocks.starts need not be schedule order; stably sort complete internal
    ; sites so the copy scorer can deduplicate physical pairs at each position.
    (for [i 1 (len copies)]
      (let [copy (get copies i) (mut j) i]
        (while (and (> j 0) (> (.site (get copies (- j 1))) (.site copy)))
          (set! (mut copies) j (get copies (- j 1))) (set! j (- j 1)))
        (set! (mut copies) j copy)))
    (if (= error "") (Ok copies) (do (free! (mut copies)) (Err error)))))
