;;; Bulk initialization of analysis arrays: one reservation and a store loop
;;; instead of n capacity-checked pushes.
(module stogir.fill)
(export append!)
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)

;;; Append n copies of v.
(defn append! [T] [(xs (mut (ArrayList T))) (n i64) (v T)] (-> void)
  (when (> n 0)
    (let [start (len xs)]
      (extend-zeroed! (mut xs) n)
      (let [d (.data xs)]
        (for i (range start (+ start n)) (store! (p/index d i) v))))))
