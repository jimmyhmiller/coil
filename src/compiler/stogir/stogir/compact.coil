;;; Reference compaction: copy a verified graph without its dead NOP cells,
;;; renumbering instruction references while keeping their relative order.
;;; Constants, strings and the function prototype are unchanged, so constant
;;; references (relocation targets, symbols) keep their meaning. Every later
;;; analysis sizes its arrays and walks by instruction cells, so removed NOPs
;;; are work no backend stage repeats.
(module stogir.compact)
(import "coil.primitive" :as p)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.uses" :as uses)
(import "stogir.map-copy" :as map-copy)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Option Some None])

(defstruct Compacted [(graph g/Graph) (roots (ArrayList i32))])

(defn release! [(compacted (mut Compacted))] (-> void)
  (g/release! (mut (.graph compacted)))
  (free! (mut (.roots compacted))))

(defn cells [(graph g/Graph) (reference i64)] (-> i64)
  (/ (+ (cast i64 (get (.arities graph) reference)) 4) 4))

;;; Number of dead NOP cells among instruction cells. Safe on unverified
;;; graphs: a malformed start marker advances one cell and counts nothing.
(defn nop-cells [(graph g/Graph)] (-> i64)
  (let [(mut count) (: 0 i64)
        (mut r) (: 1 i64)
        limit (if (< (len (.arities graph)) (len (.instructions graph)))
                  (len (.arities graph))
                  (len (.instructions graph)))]
    (while (< r limit)
      (let [arity (get (.arities graph) r)
            span (if (< arity 0) (: 1 i64) (cells graph r))]
        (when (and (>= arity 0) (= (n/opcode (get (.instructions graph) r)) 0))
          (set! count (+ count span)))
        (set! r (+ r span))))
    count))

;;; Requires a structurally verified graph whose entry START is reference one.
;;; A NOP that a live edge or root still names is kept, so no reference dangles.
(defn compact [(source g/Graph) (roots (slice i32)) (a (dyn Allocator))] (-> Compacted)
  (let [size (len (.instructions source))
        (mut keep) (ArrayList::new [bool] a)
        (mut r) (: 1 i64)]
    (extend-zeroed! (mut keep) size)
    (while (< r size)
      (let [node (get (.instructions source) r)
            arity (get (.arities source) r)]
        (when (!= (n/opcode node) 0)
          (set! (mut keep) r true)
          (let [facts (get (op/metadata) (cast i64 (n/opcode node)))
                (mut i) (: 1 i32)]
            (while (<= i arity)
              (when (uses/edge-code? (op/operand-code-word facts i))
                (let [value (uses/verified-input source r i)]
                  (when (> value 0) (set! (mut keep) (cast i64 value) true))))
              (set! i (+ i 1)))))
        (set! r (+ r (cells source r)))))
    (let [items-103 roots (mut for-index-103) (: 0 i64)] (while (< for-index-103 (len items-103)) (let [root (get items-103 for-index-103)] (when (> root 0) (set! (mut keep) (cast i64 root) true))) (set! for-index-103 (+ for-index-103 1))))
    (compact-keeping source roots keep a)))

;;; compact, given its keep set: KEEP holds true at every node start that is
;;; not a NOP, that an edge operand of a node that is not a NOP names, or that
;;; a positive root names, and false elsewhere. KEEP is consumed.
(defn compact-keeping [(source g/Graph) (roots (slice i32)) (keep (ArrayList bool))
                       (a (dyn Allocator))]
  (-> Compacted)
  (let [size (len (.instructions source))
        (mut keep) keep
        (mut map) (ArrayList::new [i32] a)
        (mut result) (g/create a)
        (mut mapped) (ArrayList::new [i32] a)
        (mut r) (: 1 i64)]
    (extend-zeroed! (mut map) size)
    (let [(mut next) (: 1 i64)]
      (set! r 1)
      (while (< r size)
        (when (get keep r)
          (set! (mut map) r (cast i32 next))
          (set! next (+ next (cells source r))))
        (set! r (+ r (cells source r))))
      (reserve! (mut (.instructions result)) next)
      (reserve! (mut (.arities result)) next))
    ; Kept cells are copied a run of adjacent kept nodes at a time, in order;
    ; the operand renumbering below then finds every kept node in place.
    (let [(mut run) (: 0 i64)]
      (set! r 1)
      (while (< r size)
        (let [span (cells source r)]
          (if (get keep r)
              (when (= run 0) (set! run r))
              (when (> run 0)
                (extend! (mut (.instructions result)) (p/index (.data (.instructions source)) run)
                         (- r run))
                (extend! (mut (.arities result)) (p/index (.data (.arities source)) run) (- r run))
                (set! run 0)))
          (set! r (+ r span))))
      (when (> run 0)
        (extend! (mut (.instructions result)) (p/index (.data (.instructions source)) run)
                 (- size run))
        (extend! (mut (.arities result)) (p/index (.data (.arities source)) run) (- size run))))
    (set! r 1)
    (while (< r size)
      (let [span (cells source r)]
        (when (get keep r)
          (let [node (get (.instructions source) r)
                arity (get (.arities source) r)
                facts (get (op/metadata) (cast i64 (n/opcode node)))
                target (get map r)
                (mut i) (: 1 i32)]
            (while (<= i arity)
              (when (uses/edge-code? (op/operand-code-word facts i))
                (let [value (uses/verified-input source r i)]
                  (when (> value 0)
                    (g/write-input-word! (mut result) target i (get map (cast i64 value))))))
              (set! i (+ i 1)))))
        (set! r (+ r span))))
    (extend! (mut (.constants result)) (.data (.constants source)) (len (.constants source)))
    (extend! (mut (.constant-spans result))
             (.data (.constant-spans source))
             (len (.constant-spans source)))
    (extend! (mut (.bytes (.strings result)))
             (.data (.bytes (.strings source)))
             (len (.bytes (.strings source))))
    (extend! (mut (.entries (.strings result)))
             (.data (.entries (.strings source)))
             (len (.entries (.strings source))))
    (free! (mut (.constant-heads result)))
    (set! (.constant-heads result) (map-copy/scalar (.constant-heads source) a))
    (free! (mut (.heads (.strings result))))
    (set! (.heads (.strings result)) (map-copy/scalar (.heads (.strings source)) a))
    (set! (.function-prototype result) (.function-prototype source))
    (let [items-102 roots (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [root (get items-102 for-index-102)] (push! (mut mapped) (if (> root 0) (get map (cast i64 root)) root))) (set! for-index-102 (+ for-index-102 1))))
    (free! (mut keep))
    (free! (mut map))
    (Compacted :graph result :roots mapped)))

;;; Whether compact may run on a graph that has not been validated yet: cells
;;; are well formed, every edge operand and positive root names a cell start,
;;; and every NOP cell nothing names is a canonical dead cell (all fields and
;;; arity zero, as make-nop! leaves it). Compaction then only renumbers and
;;; drops cells that validation would accept and nothing reads, so validating
;;; the compacted graph decides the same as validating the source.
(defn compactable? [(source g/Graph) (roots (slice i32)) (a (dyn Allocator))] (-> bool)
  (let [size (len (.instructions source))
        (mut starts) (ArrayList::new [bool] a)
        (mut named) (ArrayList::new [bool] a)
        (mut ok) (and (= (len (.arities source)) size) (> size 1))
        (mut r) (: 1 i64)]
    (when ok
      (extend-zeroed! (mut starts) size)
      (extend-zeroed! (mut named) size)
      (while (and ok (< r size))
        (let [arity (get (.arities source) r)
              opcode (cast i64 (n/opcode (get (.instructions source) r)))]
          (if (or (< arity 0) (>= opcode (len (op/metadata))))
              (set! ok false)
              (let [span (cells source r)]
                (if (> (+ r span) size)
                    (set! ok false)
                    (do
                      (set! (mut starts) r true)
                      (for [k (+ r 1) (+ r span)]
                        (when (>= (get (.arities source) k) 0) (set! ok false)))
                      (set! r (+ r span))))))))
      (set! r 1)
      (while (and ok (< r size))
        (let [node (get (.instructions source) r)
              arity (get (.arities source) r)
              facts (get (op/metadata) (cast i64 (n/opcode node)))
              (mut i) (: 1 i32)]
          (while (and ok (<= i arity))
            (when (uses/edge-code? (op/operand-code-word facts i))
              (let [value (uses/verified-input source r i)]
                (when (> value 0)
                  (if (and (< (cast i64 value) size) (get starts (cast i64 value)))
                      (set! (mut named) (cast i64 value) true)
                      (set! ok false)))))
            (set! i (+ i 1)))
          (set! r (+ r (cells source r)))))
      (let [items-101 roots (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [root (get items-101 for-index-101)]
        (when (> root 0)
          (if (and (< (cast i64 root) size) (get starts (cast i64 root)))
              (set! (mut named) (cast i64 root) true)
              (set! ok false)))) (set! for-index-101 (+ for-index-101 1))))
      (set! r 1)
      (while (and ok (< r size))
        (let [node (get (.instructions source) r)]
          (when (and (= (n/opcode node) 0) (not (get named r))
                     (or (!= (.header node) 0) (!= (.op1 node) 0) (!= (.op2 node) 0)
                         (!= (.op3 node) 0) (!= (get (.arities source) r) 0)))
            (set! ok false))
          (set! r (+ r (cells source r))))))
    (free! (mut starts))
    (free! (mut named))
    ok))

;;; compact of a graph that has not been validated yet, when compactable?
;;; holds and its entry START is reference one; otherwise None. The walks are
;;; compactable?'s own, and the one that reads every edge operand also marks
;;; compact's keep set, so the operands are read once for both.
(defn compact-checked [(source g/Graph) (roots (slice i32)) (a (dyn Allocator))]
  (-> (Option Compacted))
  (let [size (len (.instructions source))
        (mut starts) (ArrayList::new [bool] a)
        (mut named) (ArrayList::new [bool] a)
        (mut keep) (ArrayList::new [bool] a)
        (mut ok) (and (= (len (.arities source)) size) (> size 1))
        (mut r) (: 1 i64)]
    (when ok
      (extend-zeroed! (mut starts) size)
      (extend-zeroed! (mut named) size)
      (extend-zeroed! (mut keep) size)
      (while (and ok (< r size))
        (let [arity (get (.arities source) r)
              opcode (cast i64 (n/opcode (get (.instructions source) r)))]
          (if (or (< arity 0) (>= opcode (len (op/metadata))))
              (set! ok false)
              (let [span (cells source r)]
                (if (> (+ r span) size)
                    (set! ok false)
                    (do
                      (set! (mut starts) r true)
                      (for [k (+ r 1) (+ r span)]
                        (when (>= (get (.arities source) k) 0) (set! ok false)))
                      (set! r (+ r span))))))))
      (set! r 1)
      (while (and ok (< r size))
        (let [node (get (.instructions source) r)
              arity (get (.arities source) r)
              facts (get (op/metadata) (cast i64 (n/opcode node)))
              live (!= (n/opcode node) 0)
              (mut i) (: 1 i32)]
          (when live (set! (mut keep) r true))
          (while (and ok (<= i arity))
            (when (uses/edge-code? (op/operand-code-word facts i))
              (let [value (uses/verified-input source r i)]
                (when (> value 0)
                  (if (and (< (cast i64 value) size) (get starts (cast i64 value)))
                      (do
                        (set! (mut named) (cast i64 value) true)
                        (when live (set! (mut keep) (cast i64 value) true)))
                      (set! ok false)))))
            (set! i (+ i 1)))
          (set! r (+ r (cells source r)))))
      (let [items-101 roots (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [root (get items-101 for-index-101)]
        (when (> root 0)
          (if (and (< (cast i64 root) size) (get starts (cast i64 root)))
              (do
                (set! (mut named) (cast i64 root) true)
                (set! (mut keep) (cast i64 root) true))
              (set! ok false)))) (set! for-index-101 (+ for-index-101 1))))
      (set! r 1)
      (while (and ok (< r size))
        (let [node (get (.instructions source) r)]
          (when (and (= (n/opcode node) 0) (not (get named r))
                     (or (!= (.header node) 0) (!= (.op1 node) 0) (!= (.op2 node) 0)
                         (!= (.op3 node) 0) (!= (get (.arities source) r) 0)))
            (set! ok false))
          (set! r (+ r (cells source r))))))
    (free! (mut starts))
    (free! (mut named))
    (if (and ok (= (n/opcode (get (.instructions source) 1)) 104))
        (Some (compact-keeping source roots keep a))
        (do (free! (mut keep)) (None)))))
