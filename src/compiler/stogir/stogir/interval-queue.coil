;;; Min-heap for linear-scan unhandled intervals and split children.
(module stogir.interval-queue)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Option Some None])

(defstruct Item [(position i64) (interval i32)])

(defn before? [(a Item) (b Item)] (-> bool)
  (or (< (.position a) (.position b))
      (and (= (.position a) (.position b)) (< (.interval a) (.interval b)))))

(defn insert! [(heap (mut (ArrayList Item))) (item Item)] (-> void)
  (let [(mut i) (len heap)]
    (push! (mut heap) item)
    (let [(mut done) false]
      (while (and (> i 0) (not done))
        (let [parent (/ (- i 1) 2)
              value (get heap parent)]
          (if (before? item value)
              (do (set! (mut heap) i value) (set! i parent))
              (set! done true)))))
    (set! (mut heap) i item)))

(defn take! [(heap (mut (ArrayList Item)))] (-> (Option Item))
  (if (= (len heap) 0)
      (None)
      (let [result (get heap 0)
            last (get heap (- (len heap) 1))]
        (pop! (mut heap))
        (when (> (len heap) 0)
          (let [(mut i) 0
                (mut done) false]
            (while (not done)
              (let [left (+ (* i 2) 1)
                    right (+ left 1)]
                (if (>= left (len heap))
                    (set! done true)
                    (let [child
                            (if (and (< right (len heap))
                                     (before? (get heap right) (get heap left)))
                                right
                                left)
                          value (get heap child)]
                      (if (before? value last)
                          (do (set! (mut heap) i value) (set! i child))
                          (set! done true))))))
            (set! (mut heap) i last)))
        (Some result))))
