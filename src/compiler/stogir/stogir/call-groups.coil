;;; Explicit groups of scalar ABI pieces; this metadata is a Coil extension.
(module stogir.call-groups)
(import "stogir.types" :as types)
(import "stogir.call-results" :as results)
(import "coil.arraylist" :use [ArrayList])

;;; Ordinals index flattened scalar parameters. Integer pairs have two 64-bit
;;; pieces; homogeneous floating groups have one through four identical pieces.
(defstruct Group [(first i32) (count i32) (alignment i32)])

(defn shape? [(group Group)] (-> bool)
  (and (>= (.first group) 0)
       (<= (.first group) 65532)
       (>= (.count group) 1)
       (<= (.count group) 4)
       (<= (+ (.first group) (.count group)) 65533)
       (>= (.alignment group) 4)
       (<= (.alignment group) 16)
       (= (& (.alignment group) (- (.alignment group) 1)) 0)))

(defn members? [(group Group) (ty u8)] (-> bool)
  (let [size (types/size (cast i32 ty) 8)]
    (and (shape? group)
         (or (and (= (.count group) 2) (or (= ty 5) (= ty 11)))
             (types/floating? (cast i32 ty))
             (types/short-vector? (cast i32 ty) 8))
         (>= (.alignment group) size)
         (= (% (* size (.count group)) (.alignment group)) 0))))

;;; Sorted, disjoint records. A group cannot straddle the fixed/unnamed boundary.
;;; Unnamed group types are checked later against the actual CALL operands.
(defn valid? [(parameters (slice u8)) (groups (slice Group))] (-> bool)
  (let [(mut end) (: 0 i32)
        (mut good?) true]
    (let [items-102 groups (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [group (get items-102 for-index-102)]
      (when (or (not (shape? group))
                (< (.first group) end)
                (and (< (cast i64 (.first group)) (len parameters))
                     (> (cast i64 (+ (.first group) (.count group)))
                        (len parameters))))
        (set! good? false))
      (when (and good? (< (cast i64 (.first group)) (len parameters)))
        (let [ty (get parameters (cast i64 (.first group)))
              (mut i) (: 0 i32)]
          (when (not (members? group ty)) (set! good? false))
          (while (< i (.count group))
            (when (!= (get parameters (cast i64 (+ (.first group) i))) ty)
              (set! good? false))
            (set! i (+ i 1)))))
      (when good? (set! end (+ (.first group) (.count group))))) (set! for-index-102 (+ for-index-102 1))))
    good?))

;;; After the unchanged flags/result/count/type prefix: SGAG, version1, zero,
;;; u16 count, then records {u16 first,u8 count,u8 alignment,u32 reserved=0}.
(defn append-result! [(bytes (mut (ArrayList u8)))
                      (groups (slice Group))
                      (result results/Spec)] (-> void)
  (when (or (> (len groups) 0) (!= (.kind result) 0))
    (for byte [(: 83 u8) 71 65 71] (push! (mut bytes) byte))
    (push! (mut bytes) (if (= (.kind result) 0) (: 1 u8) (: 2 u8)))
    (push! (mut bytes) (cast u8 (.kind result)))
    (push! (mut bytes) (cast u8 (& (len groups) 255)))
    (push! (mut bytes) (cast u8 (>> (len groups) 8)))
    (when (!= (.kind result) 0)
      (push! (mut bytes) (.ty result))
      (push! (mut bytes) (cast u8 (.count result)))
      (for byte [(: 0 u8) 0 0 0 0 0] (push! (mut bytes) byte)))
    (let [items-101 groups (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [group (get items-101 for-index-101)]
      (push! (mut bytes) (cast u8 (& (.first group) 255)))
      (push! (mut bytes) (cast u8 (>> (.first group) 8)))
      (push! (mut bytes) (cast u8 (.count group)))
      (push! (mut bytes) (cast u8 (.alignment group)))
      (for byte [(: 0 u8) 0 0 0] (push! (mut bytes) byte))) (set! for-index-101 (+ for-index-101 1))))))

;;; Version 3 declares a builtin with known semantics and no groups or result
;;; role: SGAG, 3, builtin id, u16 zero count, then eight reserved zero bytes.
;;; BUILTIN-MOVE (1) is memmove(destination, source, count) -> destination with
;;; prototype (ADDR, ADDR, U64) -> ADDR: it writes exactly the destination
;;; range from the source range as read before the call, and has no other effect.
(def BUILTIN-MOVE (: 1 u8))

;;; BUILTIN-COMPARE (2) is memcmp(first, second, count) with prototype
;;; (ADDR, ADDR, U64 or I64) -> I32 or U32: it reads exactly count bytes of
;;; each range, all of which are accessible, writes nothing, and returns zero
;;; when they are equal and otherwise a value whose sign is that of the
;;; difference of the first differing bytes read as unsigned. A U64 or I64
;;; result is a word container of the C int: only its low word is the result
;;; and its upper word is unspecified.
(def BUILTIN-COMPARE (: 2 u8))

(defn append-builtin! [(bytes (mut (ArrayList u8))) (builtin u8)] (-> void)
  (for byte [(: 83 u8) 71 65 71] (push! (mut bytes) byte))
  (push! (mut bytes) 3)
  (push! (mut bytes) builtin)
  (for byte [(: 0 u8) 0 0 0 0 0 0 0 0 0] (push! (mut bytes) byte)))

(defn builtin-shape? [(builtin u8) (result u8) (parameters (slice u8))] (-> bool)
  (and (= (len parameters) 3)
       (= (get parameters 0) 6)
       (= (get parameters 1) 6)
       (or (and (= builtin BUILTIN-MOVE)
                (= result 6)
                (= (get parameters 2) 5))
           (and (= builtin BUILTIN-COMPARE)
                (or (= result 10) (= result 4) (= result 5) (= result 11))
                (or (= (get parameters 2) 5) (= (get parameters 2) 11))))))

(defn append! [(bytes (mut (ArrayList u8))) (groups (slice Group))] (-> void)
  (append-result! (mut bytes) groups (results/ordinary)))

(defn header-size [(bytes (slice u8))] (-> i64)
  (let [base (+ 3 (cast i64 (get bytes 2)))]
    (if (= (get bytes (+ base 4)) 1) 8 16)))

;;; Accessors require a validated complete prototype (including its prefix).
(defn count [(bytes (slice u8))] (-> i64)
  (let [base (+ 3 (cast i64 (get bytes 2)))]
    (if (= (len bytes) base)
        0
        (+ (cast i64 (get bytes (+ base 6)))
           (<< (cast i64 (get bytes (+ base 7))) 8)))))

(defn at [(bytes (slice u8)) (index i64)] (-> Group)
  (let [base (+ 3 (cast i64 (get bytes 2)) (header-size bytes) (* index 8))]
    (Group
      :first
        (+ (cast i32 (get bytes base)) (<< (cast i32 (get bytes (+ base 1))) 8))
      :count (cast i32 (get bytes (+ base 2)))
      :alignment (cast i32 (get bytes (+ base 3))))))

;;; Builtin id of a validated complete prototype, or zero.
(defn builtin [(bytes (slice u8))] (-> u8)
  (let [base (+ 3 (cast i64 (get bytes 2)))]
    (if (or (= (len bytes) base) (!= (get bytes (+ base 4)) 3))
        0
        (get bytes (+ base 5)))))

(defn valid-builtin-trailer? [(bytes (slice u8)) (parameters (slice u8)) (base i64)]
  (-> bool)
  (let [(mut good?)
          (and (= (len bytes) (+ base 16))
               (builtin-shape? (get bytes (+ base 5)) (get bytes 1) parameters)
               (= (& (get bytes 0) 16) 0))
        (mut i) (: 6 i64)]
    (while (< i 16)
      (when (!= (get bytes (+ base i)) 0) (set! good? false))
      (set! i (+ i 1)))
    good?))

(defn valid-trailer? [(bytes (slice u8)) (parameters (slice u8))] (-> bool)
  (if (or (< (len bytes) 3) (!= (cast i64 (get bytes 2)) (len parameters)))
      false
      (let [base (+ 3 (len parameters))]
        (if (= (len bytes) base)
            true
            (if (< (len bytes) (+ base 8))
                false
                (if (and (= (get bytes (+ base 4)) 3)
                         (= (get bytes base) 83)
                         (= (get bytes (+ base 1)) 71)
                         (= (get bytes (+ base 2)) 65)
                         (= (get bytes (+ base 3)) 71))
                (valid-builtin-trailer? bytes parameters base)
                (let [version (get bytes (+ base 4))
                      header
                        (if (= version 1)
                            (: 8 i64)
                            (if (or (= version 2) (= version 4)) (: 16 i64) (: 0 i64)))]
                  (if (or (= header 0)
                          (< (len bytes) (+ base header))
                          (!= (get bytes base) 83)
                          (!= (get bytes (+ base 1)) 71)
                          (!= (get bytes (+ base 2)) 65)
                          (!= (get bytes (+ base 3)) 71))
                      false
                      (let [count (count bytes)
                            result (results/decode bytes)
                            (mut end) (: 0 i32)
                            (mut i) (: 0 i64)
                            (mut good?)
                              (and (= (len bytes) (+ base header (* count 8)))
                                   (cond (= version 1)
                                           (and (> count 0)
                                                (= (get bytes (+ base 5)) 0))
                                         (= version 2)
                                           (and (!= (.kind result) 0)
                                                (results/valid? (get bytes 1)
                                                                parameters
                                                                result))
                                         ; Version 4 may describe an ordinary
                                         ; result and no groups: its effect
                                         ; record is the reason it exists.
                                         :else
                                           (and (results/valid? (get bytes 1) parameters result)
                                                (= (& (get bytes (+ base 10)) 1) 1)
                                                (= (& (get bytes (+ base 10)) 252) 0))))]
                        (when (= version 2)
                          (set! i 10)
                          (while (< i 16)
                            (when (!= (get bytes (+ base i)) 0)
                              (set! good? false))
                            (set! i (+ i 1))))
                        (set! i 0)
                        (while (and good? (< i count))
                          (let [group (at bytes i)
                                offset (+ base header (* i 8))]
                            (when (or (not (valid? parameters [group]))
                                      (and (= (& (get bytes 0) 16) 0)
                                           (> (cast i64
                                                    (+ (.first group)
                                                       (.count group)))
                                              (len parameters)))
                                      (< (.first group) end)
                                      (!= (get bytes (+ offset 4)) 0)
                                      (!= (get bytes (+ offset 5)) 0)
                                      (!= (get bytes (+ offset 6)) 0)
                                      (!= (get bytes (+ offset 7)) 0))
                              (set! good? false))
                            (when good?
                              (set! end (+ (.first group) (.count group)))))
                          (set! i (+ i 1)))
                        good?)))))))))

;;; Version 4 is version 2's layout with the six reserved header bytes holding
;;; an effect record computed from the callee's own body, and with an ordinary
;;; result and an empty group list allowed. Byte 10: bit 0 always set, bit 1
;;; "may write memory this record does not describe". Bytes 11-12: little-endian
;;; mask of the parameters (ordinals 0..15) the callee may write through, each
;;; write lying in [0, extent) bytes from the pointer passed. Bytes 13-14: mask
;;; of the parameters whose pointer value the callee may keep (store, return or
;;; hand to something that keeps it). Byte 15: extent in 8-byte units. See
;;; docs/CALL_EFFECTS.md for what a consumer may conclude.
(defstruct Effects [(present bool) (unknown bool) (writes i32) (captures i32) (extent i64)])

(defn no-effects [] (-> Effects)
  (Effects :present false :unknown true :writes 65535 :captures 65535 :extent 0))

;;; Effect record of a validated complete prototype.
(defn effects [(bytes (slice u8))] (-> Effects)
  (let [base (+ 3 (cast i64 (get bytes 2)))]
    (if (or (= (len bytes) base) (!= (get bytes (+ base 4)) 4))
        (no-effects)
        (Effects :present true
                 :unknown (!= (& (get bytes (+ base 10)) 2) 0)
                 :writes (| (cast i32 (get bytes (+ base 11)))
                            (<< (cast i32 (get bytes (+ base 12))) 8))
                 :captures (| (cast i32 (get bytes (+ base 13)))
                              (<< (cast i32 (get bytes (+ base 14))) 8))
                 :extent (* 8 (cast i64 (get bytes (+ base 15))))))))

;;; Largest write extent a record can state.
(def MAX-EXTENT (: 2040 i64))

;;; OUT becomes the validated prototype BYTES restated as version 4 carrying
;;; RECORD, whatever version BYTES is. False, with OUT empty, for a builtin
;;; declaration (its semantics are fixed), a variadic prototype (a record
;;; describes fixed parameters only) or a record that does not fit.
(defn with-effects! [(out (mut (ArrayList u8))) (bytes (slice u8)) (record Effects)] (-> bool)
  (let [base (+ 3 (cast i64 (get bytes 2)))
        bare (= (len bytes) base)
        version (if bare (: 0 u8) (get bytes (+ base 4)))]
    (clear! (mut out))
    (if (or (= version 3) (not (.present record)) (!= (& (get bytes 0) 16) 0)
            (< (.extent record) 0) (> (.extent record) MAX-EXTENT)
            (< (.writes record) 0) (> (.writes record) 65535)
            (< (.captures record) 0) (> (.captures record) 65535))
        false
        (let [units (/ (+ (.extent record) 7) 8)]
          (for [i 0 base] (push! (mut out) (get bytes i)))
          (for byte [(: 83 u8) 71 65 71 4] (push! (mut out) byte))
          ; kind, group count
          (push! (mut out) (if bare (: 0 u8) (get bytes (+ base 5))))
          (push! (mut out) (if bare (: 0 u8) (get bytes (+ base 6))))
          (push! (mut out) (if bare (: 0 u8) (get bytes (+ base 7))))
          ; piece type and count
          (push! (mut out) (if (or bare (= version 1)) (: 0 u8) (get bytes (+ base 8))))
          (push! (mut out) (if (or bare (= version 1)) (: 0 u8) (get bytes (+ base 9))))
          (push! (mut out) (if (.unknown record) (: 3 u8) (: 1 u8)))
          (push! (mut out) (cast u8 (& (.writes record) 255)))
          (push! (mut out) (cast u8 (>> (.writes record) 8)))
          (push! (mut out) (cast u8 (& (.captures record) 255)))
          (push! (mut out) (cast u8 (>> (.captures record) 8)))
          (push! (mut out) (cast u8 units))
          (unless bare
            (for [i (+ base (header-size bytes)) (len bytes)] (push! (mut out) (get bytes i))))
          true))))

;;; Whether two validated prototypes with equal parameter counts declare the
;;; same result role and argument groups. Effect records and the trailer
;;; version that carries them are not part of the calling convention.
(defn same-convention? [(left (slice u8)) (right (slice u8))] (-> bool)
  (let [base (+ 3 (cast i64 (get left 2)))
        a (results/decode left)
        b (results/decode right)
        groups (count left)]
    (and (= (cast i64 (get right 2)) (cast i64 (get left 2)))
         (= (builtin left) (builtin right))
         (= (.kind a) (.kind b)) (= (.ty a) (.ty b)) (= (.count a) (.count b))
         (= groups (count right))
         (or (= groups 0)
             (let [first (+ base (header-size left))
                   second (+ base (header-size right))
                   (mut same) true]
               (for [i 0 (* groups 8)]
                 (when (!= (get left (+ first i)) (get right (+ second i))) (set! same false)))
               same)))))
