;;; Target-independent frame layout with distinct local-object and spill ownership.
(module stogir.frame)

(export Slot
        Frame
        create
        valid-alignment?
        spill-slot!
        private-slot!
        local-slot!
        aligned-size
        release!)

(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Slot [(offset i64) (size i64) (alignment i64)])

(defstruct Frame
  [(slots (ArrayList Slot))
   (parents (HashMap i32 i64))
   (locals (HashMap i32 i64))
   (size i64)])

(defn create [(allocator (dyn Allocator))] (-> Frame)
  (Frame
    :slots (ArrayList::new [Slot] allocator)
    :parents (HashMap::new-scalar [i32 i64] allocator)
    :locals (HashMap::new-scalar [i32 i64] allocator)
    :size 0))

(defn valid-alignment? [(alignment i64)] (-> bool)
  (and (> alignment 0) (= (& alignment (- alignment 1)) 0)))

(defn allocate-slot! [(frame (mut Frame)) (size i64) (alignment i64)]
  (-> (Result i64 (slice u8)))
  (if (> (.size frame) (- 0x7FFFFFFFFFFFFFFF (- alignment 1)))
      (Err "frame area alignment overflow")
      (let [offset (* (/ (+ (.size frame) (- alignment 1)) alignment) alignment)]
        (if (> offset (- 0x7FFFFFFFFFFFFFFF size))
            (Err "frame area size overflow")
            (do
              (push! (mut (.slots frame))
                     (Slot
                       :offset offset
                       :size size
                       :alignment alignment))
              (set! (.size frame) (+ offset size))
              (Ok offset))))))

;;; Private ABI storage has no graph owner and never aliases a value/local slot.
(defn private-slot! [(frame (mut Frame)) (size i64) (alignment i64)]
  (-> (Result i64 (slice u8)))
  (if (or (<= size 0) (not (valid-alignment? alignment)))
      (Err "invalid private frame slot shape")
      (allocate-slot! (mut frame) size alignment)))

(defn existing-slot [(frame Frame) (index i64) (size i64) (alignment i64)]
  (-> (Result i64 (slice u8)))
  (let [slot (get (.slots frame) index)]
    (if (or (!= (.size slot) size) (!= (.alignment slot) alignment))
        (Err "incompatible frame slot request for owner")
        (Ok (.offset slot)))))

;;; Split children share their parent's spill slot. Local objects use a separate
;;; namespace even when their IR reference equals a spilled parent's reference.
(defn spill-slot! [(frame (mut Frame)) (parent i32) (size i64) (alignment i64)]
  (-> (Result i64 (slice u8)))
  (if (or (< parent 0) (<= size 0) (not (valid-alignment? alignment)))
      (Err "invalid spill slot shape")
      (match (get (.parents frame) parent)
        (Some [index] (existing-slot frame index size alignment))
        (None []
              (let [index (len (.slots frame))]
                (match (allocate-slot! (mut frame) size alignment)
                  (Err [message] (Err message))
                  (Ok [offset]
                      (set! (mut (.parents frame)) parent index)
                      (Ok offset))))))))

(defn local-slot! [(frame (mut Frame)) (owner i32) (size i64) (alignment i64)]
  (-> (Result i64 (slice u8)))
  (if (or (<= owner 0) (<= size 0) (not (valid-alignment? alignment)))
      (Err "invalid local slot shape")
      (match (get (.locals frame) owner)
        (Some [index] (existing-slot frame index size alignment))
        (None []
              (let [index (len (.slots frame))]
                (match (allocate-slot! (mut frame) size alignment)
                  (Err [message] (Err message))
                  (Ok [offset]
                      (set! (mut (.locals frame)) owner index)
                      (Ok offset))))))))

(defn aligned-size [(frame Frame) (alignment i64)] (-> (Result i64 (slice u8)))
  (if (or (not (valid-alignment? alignment))
          (> (.size frame) (- 0x7FFFFFFFFFFFFFFF (- alignment 1))))
      (Err "invalid frame alignment or overflow")
      (Ok (* (/ (+ (.size frame) (- alignment 1)) alignment) alignment))))

(defn release! [(frame (mut Frame))] (-> void)
  (free! (mut (.slots frame)))
  (free! (mut (.parents frame)))
  (free! (mut (.locals frame)))
  (set! (.size frame) 0))
