;;; Graph transformation adapted from pinned ir_sccp.c:ir_sccp_transform.
;;; Stable references and explicit external roots are Coil API requirements.
(module stogir.sccp-rewrite)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.sccp-analysis" :as analysis)
(import "stogir.sccp-values" :as v)
(import "stogir.sccp-phi" :as phi)
(import "stogir.uses" :as uses)
(import "stogir.bitset" :as bits)
(import "stogir.bitqueue" :as q)
(import "stogir.verify" :as verify)
(import "stogir.terminal" :as terminal)
(import "stogir.calls" :as calls)
(import "stogir.switch" :as switch)
(import "stogir.noted" :as noted)
(import "stogir.strings" :as strings)
(import "coil.mem" :as mem)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Option Some None])

;;; proof is content-hash of graph at its last successful validate, or zero.
(defstruct Rewritten
  [(graph g/Graph) (roots (ArrayList i32)) (changes i32) (iteration q/Queue)
   (proof u128)])

(defn mix [(h u64) (w u64) (k u64)] (-> u64)
  (let [x (* (^ h w) k)]
    (^ x (>> x 31))))

;;; 128-bit digest of everything validate reads: instruction cells and arities,
;;; constant cells and spans, string bytes and entries, the function prototype
;;; and the pointer width, with every length. Instruction words feed four
;;; independent chains (each word two of them, under different keys), folded so
;;; both output words depend on every word; the shorter arrays feed two chains,
;;; packed into 64-bit words after their lengths. A graph whose digest equals
;;; one recorded when it passed validate is treated as already validated; any
;;; edit makes the digests differ.
(defn content-hash [(graph g/Graph) (pointer-bytes i32)] (-> u128)
  (let [k1 (: 0x9E3779B97F4A7C15 u64)
        k2 (: 0xC2B2AE3D27D4EB4F u64)
        k3 (: 0x165667B19E3779F9 u64)
        k4 (: 0xD6E8FEB86659FD93 u64)
        (mut a) (: 0x243F6A8885A308D3 u64)
        (mut b) (: 0x13198A2E03707344 u64)
        (mut c) (: 0xA4093822299F31D0 u64)
        (mut d) (: 0x082EFA98EC4E6C89 u64)
        (mut i) (: 0 i64)]
    (set! a (mix a (cast u64 (len (.instructions graph))) k1))
    (set! b (mix b (cast u64 (len (.instructions graph))) k2))
    (while (< i (len (.instructions graph)))
      (let [node (get (.instructions graph) i)
            lo (| (cast u64 (.header node)) (<< (cast u64 (cast u32 (.op1 node))) 32))
            hi (| (cast u64 (cast u32 (.op2 node))) (<< (cast u64 (cast u32 (.op3 node))) 32))]
        (set! a (mix a lo k1))
        (set! c (mix c lo k3))
        (set! b (mix b hi k2))
        (set! d (mix d hi k4)))
      (set! i (+ i 1)))
    (set! a (mix a d k1))
    (set! b (mix b c k2))
    (set! a (mix a (cast u64 (len (.arities graph))) k1))
    (set! i 0)
    (while (< i (len (.arities graph)))
      (let [first (cast u64 (cast u32 (get (.arities graph) i)))
            word (if (< (+ i 1) (len (.arities graph)))
                     (| first (<< (cast u64 (cast u32 (get (.arities graph) (+ i 1)))) 32))
                     first)]
        (set! a (mix a word k1))
        (set! b (mix b word k2)))
      (set! i (+ i 2)))
    (set! b (mix b (cast u64 (len (.constants graph))) k2))
    (set! i 0)
    (while (< i (len (.constants graph)))
      (let [node (get (.constants graph) i)
            lo (| (cast u64 (.header node)) (<< (cast u64 (cast u32 (.op1 node))) 32))
            hi (| (cast u64 (cast u32 (.op2 node))) (<< (cast u64 (cast u32 (.op3 node))) 32))]
        (set! a (mix (mix a lo k1) hi k1))
        (set! b (mix (mix b hi k2) lo k2)))
      (set! i (+ i 1)))
    (set! a (mix a (cast u64 (len (.constant-spans graph))) k1))
    (set! i 0)
    (while (< i (len (.constant-spans graph)))
      (let [span (cast u64 (cast u32 (get (.constant-spans graph) i)))]
        (set! a (mix a span k1))
        (set! b (mix b span k2)))
      (set! i (+ i 1)))
    (set! b (mix b (cast u64 (len (.bytes (.strings graph)))) k2))
    (set! i 0)
    (while (< i (len (.bytes (.strings graph))))
      (let [(mut word) (: 0 u64)
            (mut k) (: 0 i64)]
        (while (and (< k 8) (< (+ i k) (len (.bytes (.strings graph)))))
          (set! word (| word (<< (cast u64 (get (.bytes (.strings graph)) (+ i k)))
                                 (cast u64 (* k 8)))))
          (set! k (+ k 1)))
        (set! a (mix a word k1))
        (set! b (mix b word k2)))
      (set! i (+ i 8)))
    (set! a (mix a (cast u64 (len (.entries (.strings graph)))) k1))
    (set! i 0)
    (while (< i (len (.entries (.strings graph))))
      (let [entry (get (.entries (.strings graph)) i)]
        (set! a (mix (mix a (cast u64 (.offset entry)) k1) (cast u64 (.length entry)) k1))
        (set! b (mix (mix b (cast u64 (.length entry)) k2) (cast u64 (cast u32 (.next entry))) k2)))
      (set! i (+ i 1)))
    (set! a (mix a (cast u64 (cast u32 (.function-prototype graph))) k1))
    (set! b (mix b (cast u64 (cast u32 pointer-bytes)) k2))
    (| (<< (cast u128 a) 64) (cast u128 b))))

(defn release! [(result (mut Rewritten))] (-> void)
  (g/release! (mut (.graph result)))
  (free! (mut (.roots result)))
  (q/release! (mut (.iteration result))))

(defn data-edge? [(kind (slice u8))] (-> bool)
  (or (= kind "def") (= kind "ref") (= kind "arg")))

(defn data-code? [(kind u32)] (-> bool)
  (or (= kind op/OPERAND-DEF) (= kind op/OPERAND-REF)))

;;; Terminal-list references do not imply execution. Preserve their relative
;;; order while unlinking provably unreachable members, including the head.
(defn previous-live [(graph g/Graph) (removed bits/Bits) (reference i32)]
  (-> i32)
  (let [(mut current) reference]
    (while (and (> current 0) (bits/contains? removed (cast i64 current)))
      (set! current (terminal/previous graph current)))
    current))

(defn compress! [(source g/Graph)
                 (graph (mut g/Graph))
                 (domain v/Domain)
                 (edges uses/Uses)
                 (mapping (ArrayList i32))
                 (reference i32)
                 (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut live) (ArrayList::new [i32] a)
        (mut positions) (ArrayList::new [i32] a)
        (mut inputs) (ArrayList::new [i32] a)
        count (get (.arities source) (cast i64 reference))
        (mut error) ""]
    (for [i 1 (+ (cast i64 count) 1)]
      (let [predecessor (phi/input source reference (cast i32 i))]
        (when (v/reachable? domain predecessor)
          (push! (mut live) predecessor)
          (push! (mut positions) (cast i32 i)))))
    (if (= (len live) 0)
        (set! error "reachable SCCP region has no feasible predecessor")
        (do
          (if (= (len live) 1)
              (when (not (g/rewrite-inputs! (mut graph)
                                            reference
                                            106
                                            0
                                            [(get live 0) (: 0 i32)]))
                (set! error "SCCP single-predecessor region rewrite failed"))
              (when (not (g/rewrite-inputs! (mut graph)
                                            reference
                                            (n/opcode (get (.instructions source)
                                                           (cast i64 reference)))
                                            0
                                            (slice live)))
                (set! error "SCCP region compression failed")))
          (let [range (get (.ranges edges) (cast i64 reference))]
            (for [i (.offset range) (+ (.offset range) (.count range))]
              (let [user (.user (get (.edges edges) i))
                    node (get (.instructions source) (cast i64 user))]
                (when (and (= (n/opcode node) 67)
                           (= (.op1 node) reference)
                           (= (get mapping (cast i64 user)) user))
                  (clear! (mut inputs))
                  (if (= (len live) 1)
                      (let [value
                              (phi/input source user (+ (get positions 0) 1))]
                        (if (= value user)
                            (set! error
                                  "SCCP single-predecessor Phi is self-referential")
                            (when (not (g/rewrite-inputs! (mut graph)
                                                          user
                                                          68
                                                          (n/type-id node)
                                                          [value (: 0 i32)]))
                              (set! error "SCCP Phi-to-COPY rewrite failed"))))
                      (do
                        (push! (mut inputs) reference)
                        (let [items-103 positions (mut for-index-103) (: 0 i64)] (while (< for-index-103 (len items-103)) (let [position (get items-103 for-index-103)]
                          (push! (mut inputs)
                                 (phi/input source user (+ position 1)))) (set! for-index-103 (+ for-index-103 1))))
                        (when (not (g/rewrite-inputs! (mut graph)
                                                      user
                                                      67
                                                      (n/type-id node)
                                                      (slice inputs)))
                          (set! error "SCCP Phi compression failed"))))))))))
    (free! (mut live))
    (free! (mut positions))
    (free! (mut inputs))
    (if (= error "") (Ok 0) (Err error))))

(defn validate [(graph g/Graph) (pointer-bytes i32) (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  ; The structure walk lists the nodes the Phi, chain, call and SWITCH checks
  ; act on, and every use of a SWITCH; each of those checks then reads its
  ; nodes from the lists.
  (let [(mut noted) (noted/create a)
        result
          (match (verify/operations-constants-and-phis-target-noting graph pointer-bytes
                                                                     (mut noted))
            (Err [message] (Err [i32 (slice u8)] message))
            (Ok [_]
                (match (terminal/verify-chains-among graph (slice (.nodes noted)) a)
                  (Err [message] (Err message))
                  (Ok [_]
                      (match (calls/verify-among graph (slice (.nodes noted)) a)
                        (Err [message] (Err message))
                        (Ok [_] (switch/verify-among graph noted a)))))))]
    (noted/release! (mut noted))
    result))

;;; Transport rewrite effects into the upstream-style iterative worklist.
;;; Original users and former inputs remain relevant even when their defining
;;; node became NOP. Compare every operand of variable-length instructions, not
;;; just their first compact cell. A single linear scan completes this bulk
;;; transformation; the subsequent iterative optimizer maintains uses in place.
(defn seed-iteration! [(source g/Graph)
                       (graph g/Graph)
                       (edges uses/Uses)
                       (facts analysis/Analysis)
                       (queue (mut q/Queue))]
  (-> void)
  (let [(mut r) (: 1 i64)]
    (while (< r (len (.instructions source)))
      (let [before (get (.instructions source) r)
            after (get (.instructions graph) r)
            old-count (get (.arities source) r)
            new-count (get (.arities graph) r)
            (mut changed)
              (or (!= (.header before) (.header after))
                  (!= old-count new-count))]
        ; Operands 1..3 live in the cells already loaded; both graphs are
        ; validated, so continuation words are read without rechecking the node.
        (unless changed
          (set! changed
                (or (and (>= old-count 1) (!= (.op1 before) (.op1 after)))
                    (and (>= old-count 2) (!= (.op2 before) (.op2 after)))
                    (and (>= old-count 3) (!= (.op3 before) (.op3 after)))))
          (let [(mut i) (: 4 i32)]
            (while (and (not changed) (<= i old-count))
              (when (!= (uses/verified-input source r i)
                        (uses/verified-input graph r i))
                (set! changed true))
              (set! i (+ i 1)))))
        ; Identity-only Phi cleanup is not part of the lattice transfer. Visit
        ; each remaining Phi once in this existing bulk walk, then rely on
        ; exact affected-user requeues for cascading identities.
        (when (or changed (= (n/opcode after) 67)
                  (q/contains? (.iteration facts) r))
          (q/add! (mut queue) r))
        (when changed
          (let [range (get (.ranges edges) r)]
            (for [i (.offset range) (+ (.offset range) (.count range))]
              (q/add! (mut queue) (cast i64 (.user (get (.edges edges) i))))))
          (for [i 1 (+ (cast i64 old-count) 1)]
            (when (uses/edge-code? (op/operand-code (cast i32 (n/opcode before))
                                                    (cast i32 i)))
              (let [input (phi/input source (cast i32 r) (cast i32 i))]
                (when (> input 0) (q/add! (mut queue) (cast i64 input))))))
          (for [i 1 (+ (cast i64 new-count) 1)]
            (when (uses/edge-code? (op/operand-code (cast i32 (n/opcode after))
                                                    (cast i32 i)))
              (let [input (phi/input graph (cast i32 r) (cast i32 i))]
                (when (> input 0) (q/add! (mut queue) (cast i64 input)))))))
        (set! r (+ r (/ (+ (cast i64 old-count) 4) 4)))))))

;;; Preconditions: analysis belongs to this exact immutable source graph and was
;;; produced with these roots observed. Mutations occur only in an owned copy;
;;; failed validation releases that copy and leaves all source storage untouched.
;;; The caller must rebuild uses/CFG/dominance/scheduling/matching for the result.
(defn rewrite [(source g/Graph)
               (facts analysis/Analysis)
               (roots (slice i32))
               (a (dyn Allocator))] (-> (Result Rewritten (slice u8)))
  (rewrite-sharing-uses source facts roots (None) false a))

;;; Whether two graphs agree in everything validate reads (see content-hash),
;;; compared exactly rather than by digest.
(defn same-content? [(first g/Graph) (second g/Graph)] (-> bool)
  (and (= (len (.instructions first)) (len (.instructions second)))
       (= (len (.arities first)) (len (.arities second)))
       (= (len (.constants first)) (len (.constants second)))
       (= (len (.constant-spans first)) (len (.constant-spans second)))
       (= (len (.bytes (.strings first))) (len (.bytes (.strings second))))
       (= (len (.entries (.strings first))) (len (.entries (.strings second))))
       (= (.function-prototype first) (.function-prototype second))
       (mem/eql (.data (.instructions first)) (.data (.instructions second))
                (len (.instructions first)))
       (mem/eql (.data (.arities first)) (.data (.arities second))
                (len (.arities first)))
       (mem/eql (.data (.constants first)) (.data (.constants second))
                (len (.constants first)))
       (mem/eql (.data (.constant-spans first)) (.data (.constant-spans second))
                (len (.constant-spans first)))
       (mem/eql (.data (.bytes (.strings first))) (.data (.bytes (.strings second)))
                (len (.bytes (.strings first))))
       (same-entries? (.strings first) (.strings second))))

(defn same-entries? [(first strings/Pool) (second strings/Pool)] (-> bool)
  (let [(mut same) true
        (mut i) (: 0 i64)]
    (while (and same (< i (len (.entries first))))
      (let [x (get (.entries first) i)
            y (get (.entries second) i)]
        (set! same (and (= (.offset x) (.offset y))
                        (= (.length x) (.length y))
                        (= (.next x) (.next y)))))
      (set! i (+ i 1)))
    same))

;;; As rewrite. SHARED, when given, is uses/build of this exact source (the
;;; analysis read the same index); it is only read here and stays the
;;; caller's. Without it the index is built and released here.
;;;
;;; STAGED is for sccp's own pipeline: SOURCE passed analysis/verify-input (or
;;; matched a proof) at this pointer width, and finish! follows, which
;;; validates the final graph and records its proof. The result then carries
;;; no proof of its own. When the rewritten graph's content is exactly
;;; SOURCE's, the operation, constant, Phi and SWITCH checks of verify-input
;;; and the chain check below already ran on that content, so only the call
;;; check, the remaining part of validate, runs on it.
(defn rewrite-sharing-uses [(source g/Graph)
                            (facts analysis/Analysis)
                            (roots (slice i32))
                            (shared (Option uses/Uses))
                            (staged bool)
                            (a (dyn Allocator))] (-> (Result Rewritten (slice u8)))
  (let [(mut error) ""
        size (len (.instructions source))]
    (when (= (len roots) 0)
      (set! error "SCCP rewrite requires observable roots"))
    (when (!= size (len (.values (.domain facts))))
      (set! error "SCCP analysis/graph size mismatch"))
    (let [items-102 roots (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [root (get items-102 for-index-102)]
      (when (or (<= root 0)
                (not (g/contains? source root))
                (not (bits/contains? (.observed facts) (cast i64 root))))
        (set! error "SCCP rewrite requires the analyzed observable roots"))) (set! for-index-102 (+ for-index-102 1))))
    (match (terminal/verify-chains source a)
      (Err [message] (set! error message))
      (Ok [_] 0))
    (if (!= error "")
        (Err error)
        (let [(mut graph) (g/duplicate source a)
              (mut mapping) (ArrayList::new [i32] a)
              (mut removed) (bits/create size a)
              (mut result-roots) (ArrayList::new [i32] a)
              (mut iteration) (q/create size a)
              (mut edges) (match shared
                            (Some [given] given)
                            (None [] (uses/build source a)))
              (mut changes) (: 0 i32)
              (mut mapped) false
              (mut r) (: 1 i64)]
          (reserve! (mut mapping) size)
          (for [i 0 size] (push! (mut mapping) (cast i32 i)))
          ; Build replacement facts before editing any original instruction.
          (while (and (< r size) (= error ""))
            (let [reference (cast i32 r)
                  node (get (.instructions source) r)
                  opcode (cast i32 (n/opcode node))
                  value (v/at (.domain facts) reference)
                  kind (v/state-kind value)
                  data (analysis/data? opcode)
                  observed (bits/contains? (.observed facts) r)]
              (cond (and (= kind 0) (!= opcode 0) (!= opcode 71))
                      (if (and data observed)
                          (set! error "observable SCCP data root is unresolved")
                          (do
                            (bits/add! (mut removed) r)
                            (set! (mut mapping) r 0)))
                    (or (and (>= kind 1) (<= kind 13))
                        (and (>= kind 73) (<= kind 77)))
                      (if (not data)
                          (set! error
                                "SCCP memory constant needs control bypass")
                          (match (g/intern-constant! (mut graph)
                                                     (n/opcode value)
                                                     (n/type-id value)
                                                     0
                                                     (n/constant-bits value))
                            (None []
                                  (set! error
                                        "SCCP constant reference space exhausted"))
                            (Some [literal] (set! (mut mapping) r literal))))
                    (= kind 78) (set! (mut mapping) r (.op2 value))
                    (= kind 68)
                      (set! (mut mapping)
                            r
                            (v/identity (.domain facts) reference))
                    :else 0)
              (when (!= (get mapping r) reference) (set! mapped true))
              (when (and (!= (get mapping r) reference) (!= kind 0))
                (when (not data)
                  (set! error "SCCP non-data replacement needs control bypass")))
              (set! r (+ r (/ (+ (cast i64 (get (.arities source) r)) 4) 4)))))
          ; Retain the END/BEGIN form from upstream's protected-destination case.
          (set! r 1)
          (while (and (< r size) (= error ""))
            (let [reference (cast i32 r)
                  node (get (.instructions source) r)
                  value (v/at (.domain facts) reference)
                  kind (v/state-kind value)]
              (cond (= kind 116)
                      (let [target (.op1 value)]
                        (when (or (not (g/rewrite-inputs! (mut graph)
                                                          reference
                                                          114
                                                          0
                                                          [(.op1 node)]))
                                  (not (g/rewrite-inputs! (mut graph)
                                                          target
                                                          106
                                                          0
                                                          [reference (: 0 i32)])))
                          (set! error "SCCP selected control rewrite failed"))
                        (set! changes (+ changes 1)))
                    (or (= kind 112)
                        (and (= kind (op/count))
                             (= (n/opcode node) 112)
                             (= (get (.arities source) r) 1)))
                      (match (compress! source
                                        (mut graph)
                                        (.domain facts)
                                        edges
                                        mapping
                                        reference
                                        a)
                        (Err [message] (set! error message))
                        (Ok [_] (set! changes (+ changes 1))))
                    :else 0)
              (set! r (+ r (/ (+ (cast i64 (get (.arities source) r)) 4) 4)))))
          ; With every reference mapped to itself nothing is removed or
          ; replaced: the two walks below would leave each cell as it is.
          (when mapped
          ; Data roots retain their positive reference via an observable COPY.
          (set! r 1)
          (while (and (< r size) (= error ""))
            (let [reference (cast i32 r)
                  replacement (get mapping r)
                  node (get (.instructions source) r)]
              (if (bits/contains? removed r)
                  (do
                    (when (not (g/make-nop! (mut graph) reference))
                      (set! error "SCCP removal failed"))
                    (set! changes (+ changes 1)))
                  (when (!= replacement reference)
                    (if (bits/contains? (.observed facts) r)
                        (when (not (and (= (n/opcode node) 68)
                                        (= (.op1 node) replacement)
                                        (= (.op2 node) 0)))
                          (when (not (g/rewrite-inputs-with-aux! (mut graph)
                                                                 reference
                                                                 68
                                                                 (n/type-id node)
                                                                 0
                                                                 [replacement
                                                                  (: 0 i32)]))
                            (set! error "SCCP observable COPY rewrite failed"))
                          (set! changes (+ changes 1)))
                        (do
                          (bits/add! (mut removed) r)
                          (when (not (g/make-nop! (mut graph) reference))
                            (set! error "SCCP replaced-node removal failed"))
                          (set! changes (+ changes 1))))))
              (set! r (+ r (/ (+ (cast i64 (get (.arities source) r)) 4) 4)))))
          ; Patch original data references and unlink unreachable terminal members.
          ; Walk the new arities: released continuation cells are standalone NOPs.
          (set! r 1)
          (while (and (< r size) (= error ""))
            (let [reference (cast i32 r)
                  node (get (.instructions graph) r)
                  opcode (cast i32 (n/opcode node))
                  count (get (.arities graph) r)]
              (when (!= opcode 0)
                (for [index 1 (+ (cast i64 count) 1)]
                  (let [position (cast i32 index)
                        kind (op/operand-code opcode position)
                        old (uses/verified-input graph r position)
                        (mut replacement) old]
                    (when (> old 0)
                      (if (= kind op/OPERAND-RET)
                          (set! replacement (previous-live source removed old))
                          (if (data-code? kind)
                              (set! replacement (get mapping (cast i64 old)))
                              (when (and (uses/edge-code? kind)
                                         (bits/contains? removed (cast i64 old)))
                                (set! error
                                      "live SCCP control edge targets removed instruction")))))
                    (when (!= replacement old)
                      (when (and (= replacement 0)
                                 (not (= kind op/OPERAND-RET)))
                        (set! error
                              "live SCCP data edge targets removed instruction"))
                      (if (not (g/set-operand! (mut graph)
                                               reference
                                               position
                                               replacement))
                          (set! error "SCCP edge replacement failed")
                          (set! changes (+ changes 1)))))))
              (set! r (+ r (/ (+ (cast i64 count) 4) 4))))))
          (let [items-101 roots (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [root (get items-101 for-index-101)]
            (when (not (bits/contains? removed (cast i64 root)))
              (push! (mut result-roots) root))) (set! for-index-101 (+ for-index-101 1))))
          (when (= error "")
            (match (if (and staged (same-content? source graph))
                       (calls/verify graph a)
                       (validate graph (.pointer-bytes facts) a))
              (Err [message] (set! error message))
              (Ok [_] 0)))
          (when (= error "")
            (seed-iteration! source graph edges facts (mut iteration)))
          (free! (mut mapping))
          (bits/release! (mut removed))
          (match shared
            (Some [_] 0)
            (None [] (uses/release! (mut edges)) 0))
          (if (= error "")
              (Ok (Rewritten
                    :graph graph
                    :roots result-roots
                    :changes changes
                    :iteration iteration
                    :proof (if staged
                               (: 0 u128)
                               (content-hash graph (.pointer-bytes facts)))))
              (do
                (g/release! (mut graph))
                (free! (mut result-roots))
                (q/release! (mut iteration))
                (Err error)))))))
