; Checked arithmetic/projection conventions follow dstogov/ir ir_fold.h, 92171d0. See NOTICE.
(module stogir.checked)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "coil.result" :use [Result Ok Err Option Some None])

(defstruct Evaluation [(bits u64) (overflow? bool)])

(defn operation? [(opcode i32)] (-> bool)
  (and (>= opcode 41) (<= opcode 43)))

(defn valid-type? [(ty i32)] (-> bool)
  (and (types/integer? ty) (!= ty 1)))

(defn evaluate [(opcode i32) (ty i32) (pointer-bytes i32) (a u64) (b u64)]
  (-> (Option Evaluation))
  (let [size (types/scalar-size ty pointer-bytes)]
    (if (or (not (operation? opcode)) (not (valid-type? ty)) (<= size 0))
        (None)
        (let [modulus (<< (: 1 u128) (cast u128 (* size 8)))
              mask (cast u64 (- modulus 1))
              x (cast u128 (& a mask))
              y (cast u128 (& b mask))]
          (if (types/signed? ty)
              (let [sx
                      (if (>= x (/ modulus 2))
                          (- (cast i128 x) (cast i128 modulus))
                          (cast i128 x))
                    sy
                      (if (>= y (/ modulus 2))
                          (- (cast i128 y) (cast i128 modulus))
                          (cast i128 y))
                    value
                      (if (= opcode 41)
                          (+ sx sy)
                          (if (= opcode 42) (- sx sy) (* sx sy)))
                    limit (cast i128 (/ modulus 2))]
                (Some (Evaluation
                        :bits (& (cast u64 value) mask)
                        :overflow? (or (< value (- 0 limit)) (>= value limit)))))
              (let [value
                      (if (= opcode 41)
                          (+ x y)
                          (if (= opcode 42) (- (+ x modulus) y) (* x y)))
                    overflow? (if (= opcode 42) (< x y) (>= value modulus))]
                (Some (Evaluation
                        :bits (& (cast u64 value) mask)
                        :overflow? overflow?))))))))

(defn operands [(graph g/Graph) (opcode i32) (ty i32) (left i32) (right i32)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""]
    (when (or (not (operation? opcode)) (not (valid-type? ty)))
      (set! error "checked arithmetic requires a non-Boolean integer type"))
    (for reference [left right]
      (match (g/lookup graph reference)
        (None [] (set! error "checked arithmetic operand missing"))
        (Some [node]
              (when (!= (cast i32 (n/type-id node)) ty)
                (set! error "checked arithmetic operand type mismatch")))))
    (if (= error "") (Ok ty) (Err error))))

(defn validate [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "checked arithmetic missing"))
    (Some [node]
          (if (or (<= reference 0)
                  (not (operation? (cast i32 (n/opcode node))))
                  (!= (get (.arities graph) (cast i64 reference)) 2))
              (Err "invalid checked arithmetic instruction")
              (operands graph
                        (cast i32 (n/opcode node))
                        (cast i32 (n/type-id node))
                        (.op1 node)
                        (.op2 node))))))

(defn projection [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "OVERFLOW source missing"))
    (Some [node]
          (if (operation? (cast i32 (n/opcode node)))
              (validate graph reference)
              (if (or (= (n/type-id node) 0)
                      (not (types/valid-scalar? (cast i32 (n/type-id node)))))
                  (Err "OVERFLOW requires a scalar value")
                  (Ok 0))))))

(defn validate-projection [(graph g/Graph) (reference i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "OVERFLOW missing"))
    (Some [node]
          (if (or (<= reference 0)
                  (!= (n/opcode node) 44)
                  (!= (n/type-id node) 1)
                  (!= (get (.arities graph) (cast i64 reference)) 1))
              (Err "invalid OVERFLOW instruction")
              (projection graph (.op1 node))))))

;;; Only non-overflowing constant arithmetic folds away the checked producer.
(defn build! [(graph (mut g/Graph))
              (opcode i32)
              (ty i32)
              (pointer-bytes i32)
              (left i32)
              (right i32)] (-> (Result i32 (slice u8)))
  (match (operands graph opcode ty left right)
    (Err [message] (Err message))
    (Ok [_]
        (if (<= (types/scalar-size ty pointer-bytes) 0)
            (Err "invalid checked arithmetic pointer width")
            (let [(mut folded) (: 0 i32)]
              (when (and (< left 0) (< right 0))
                (match (g/lookup graph left)
                  (None [] 0)
                  (Some [a]
                        (match (g/lookup graph right)
                          (None [] 0)
                          (Some [b]
                                (when (and (symbols/numeric? a)
                                           (symbols/numeric? b))
                                  (match (evaluate opcode
                                                   ty
                                                   pointer-bytes
                                                   (n/constant-bits a)
                                                   (n/constant-bits b))
                                    (None [] 0)
                                    (Some [value]
                                          (when (not (.overflow? value))
                                            (match (g/intern-scalar! (mut graph)
                                                                     (cast u8
                                                                           ty)
                                                                     (.bits value))
                                              (None [] 0)
                                              (Some [reference]
                                                    (set! folded reference))))))))))))
              (if (!= folded 0)
                  (Ok folded)
                  (let [commutative? (!= opcode 42)
                        a (if (and commutative? (< left right)) right left)
                        b (if (and commutative? (< left right)) left right)
                        key
                          (| (cast u128 opcode)
                             (<< (cast u128 ty) 8)
                             (<< (cast u128 (cast u32 a)) 16)
                             (<< (cast u128 (cast u32 b)) 48))]
                    (match (get (.expressions graph) key)
                      (Some [reference] (Ok reference))
                      (None []
                            (match (g/append-inputs! (mut graph)
                                                     (cast u8 opcode)
                                                     (cast u8 ty)
                                                     [a b])
                              (None []
                                    (Err "checked arithmetic reference space exhausted"))
                              (Some [reference]
                                    (do
                                      (set! (mut (.expressions graph))
                                            key
                                            reference)
                                      (Ok reference)))))))))))))

(defn overflow! [(graph (mut g/Graph)) (source i32)]
  (-> (Result i32 (slice u8)))
  (match (projection graph source)
    (Err [message] (Err message))
    (Ok [ty]
        (if (= ty 0)
            (match (g/intern-scalar! (mut graph) 1 0)
              (None [] (Err "constant reference space exhausted"))
              (Some [reference] (Ok reference)))
            (let [key
                    (| (: 44 u128)
                       (<< (: 1 u128) 8)
                       (<< (cast u128 (cast u32 source)) 16))]
              (match (get (.expressions graph) key)
                (Some [reference] (Ok reference))
                (None []
                      (match (g/append-inputs! (mut graph) 44 1 [source])
                        (None [] (Err "OVERFLOW reference space exhausted"))
                        (Some [reference]
                              (do
                                (set! (mut (.expressions graph)) key reference)
                                (Ok reference)))))))))))
