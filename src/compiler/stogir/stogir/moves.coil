;;; Parallel-copy resolution over abstract physical locations.
(module stogir.moves)
(import "coil.alloc" :use [Allocator])
(import "coil.hashmap" :use [HashMap])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Move [(source i32) (destination i32)])

;;; Scratch must not alias any participating location; destinations are unique.
;;; Locations include registers/spill slots, with classes resolved by the caller.
(defn resolve [(copies (slice Move)) (scratch i32) (allocator (dyn Allocator))]
  (-> (Result (ArrayList Move) (slice u8)))
  (let [(mut pending) (ArrayList::new [Move] allocator)
        (mut active) (ArrayList::new [bool] allocator)
        (mut result) (ArrayList::new [Move] allocator)
        (mut remaining) 0
        (mut error) ""
        (mut i) 0]
    (let [items-103 copies (mut for-index-103) (: 0 i64)] (while (< for-index-103 (len items-103)) (let [copy (get items-103 for-index-103)]
      (when (or (= (.source copy) scratch) (= (.destination copy) scratch))
        (set! error "scratch aliases parallel copy"))
      (let [(mut j) 0]
        (while (< j (len pending))
          (when (= (.destination (get pending j)) (.destination copy))
            (set! error "duplicate parallel-copy destination"))
          (set! j (+ j 1))))
      (push! (mut pending) copy)
      (push! (mut active) (!= (.source copy) (.destination copy)))
      (when (!= (.source copy) (.destination copy))
        (set! remaining (+ remaining 1)))) (set! for-index-103 (+ for-index-103 1))))
    (while (and (= error "") (> remaining 0))
      (let [(mut ready) -1]
        (set! i 0)
        (while (and (< i (len pending)) (< ready 0))
          (when (get active i)
            (let [copy (get pending i)
                  (mut used?) false
                  (mut j) 0]
              (while (< j (len pending))
                (when (and (get active j)
                           (= (.source (get pending j)) (.destination copy)))
                  (set! used? true))
                (set! j (+ j 1)))
              (when (not used?) (set! ready i))))
          (set! i (+ i 1)))
        (if (>= ready 0)
            (do
              (push! (mut result) (get pending ready))
              (set! (mut active) ready false)
              (set! remaining (- remaining 1)))
            (do
              (set! i 0)
              (while (not (get active i)) (set! i (+ i 1)))
              (let [saved (.destination (get pending i))]
                (push! (mut result) (Move :source saved :destination scratch))
                (set! i 0)
                (while (< i (len pending))
                  (when (get active i)
                    (let [(mut copy) (get pending i)]
                      (when (= (.source copy) saved)
                        (set! (.source copy) scratch)
                        (set! (mut pending) i copy))))
                  (set! i (+ i 1))))))))
    (free! (mut pending))
    (free! (mut active))
    (if (= error "") (Ok result) (do (free! (mut result)) (Err error)))))

;;; Per-edge raw byte extents. A cycle save must retain every byte needed by
;;; any outgoing edge of its original source, even if that location is also
;;; the destination of a narrower scalar edge.
(defstruct SizedMove [(source i32) (destination i32) (size i32)])

(defn resolve-sized [(copies (slice SizedMove))
                     (scratch i32)
                     (allocator (dyn Allocator))]
  (-> (Result (ArrayList SizedMove) (slice u8)))
  (let [(mut abstract) (ArrayList::new [Move] allocator)
        (mut sources) (HashMap::new-scalar [i32 i32] allocator)
        (mut destinations) (HashMap::new-scalar [i32 i32] allocator)
        (mut output) (ArrayList::new [SizedMove] allocator)
        (mut error) ""
        (mut held) (: 0 i32)]
    (let [items-102 copies (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [copy (get items-102 for-index-102)]
      (when (<= (.size copy) 0) (set! error "invalid parallel-copy extent"))
      (push! (mut abstract)
             (Move :source (.source copy) :destination (.destination copy)))
      (let [prior
              (match (get sources (.source copy))
                (Some [size] size)
                (None [] 0))]
        (when (> (.size copy) prior)
          (set! (mut sources) (.source copy) (.size copy))))
      (set! (mut destinations) (.destination copy) (.size copy))) (set! for-index-102 (+ for-index-102 1))))
    (when (= error "")
      (match (resolve (slice abstract) scratch allocator)
        (Err [message] (set! error message))
        (Ok [plan]
            (let [(mut plan) plan]
              (let [items-101 plan (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [move (get items-101 for-index-101)]
                (let [size
                        (match (get (if (= (.destination move) scratch)
                                        sources
                                        destinations)
                                    (if (= (.destination move) scratch)
                                        (.source move)
                                        (.destination move)))
                          (Some [size] size)
                          (None [] 0))]
                  (when (or (<= size 0)
                            (and (= (.source move) scratch) (> size held)))
                    (set! error "parallel-copy extent is unavailable"))
                  (when (= (.destination move) scratch) (set! held size))
                  (push! (mut output)
                         (SizedMove
                           :source (.source move)
                           :destination (.destination move)
                           :size size)))) (set! for-index-101 (+ for-index-101 1))))
              (free! (mut plan))))))
    (free! (mut abstract))
    (free! (mut sources))
    (free! (mut destinations))
    (if (= error "") (Ok output) (do (free! (mut output)) (Err error)))))
