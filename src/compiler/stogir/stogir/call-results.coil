;;; Explicit aggregate result-storage roles for the scalar IR ABI extension.
(module stogir.call-results)
(import "stogir.types" :as types)

;;; kind0=ordinary scalar/void result, kind1=register pieces, kind2=x8 indirect.
;;; With either aggregate kind, fixed parameter0 is the explicit ADDR result
;;; place and the IR CALL/RETURN type is void. It consumes no ordinary argument.
(defstruct Spec [(kind i32) (ty u8) (count i32)])

(defn ordinary [] (-> Spec)
  (Spec
    :kind 0
    :ty 0
    :count 0))

(defn indirect [] (-> Spec)
  (Spec
    :kind 2
    :ty 0
    :count 0))

(defn pieces [(ty u8) (count i32)] (-> Spec)
  (Spec
    :kind 1
    :ty ty
    :count count))

(defn shape? [(spec Spec)] (-> bool)
  (if (or (= (.kind spec) 0) (= (.kind spec) 2))
      (and (= (.ty spec) 0) (= (.count spec) 0))
      (and (= (.kind spec) 1)
           (>= (.count spec) 1)
           (if (or (= (.ty spec) 5) (= (.ty spec) 11))
               (<= (.count spec) 2)
               (and (or (types/floating? (cast i32 (.ty spec)))
                        (types/short-vector? (cast i32 (.ty spec)) 8))
                    (<= (.count spec) 4))))))

(defn valid? [(result u8) (parameters (slice u8)) (spec Spec)] (-> bool)
  (and (shape? spec)
       (or (= (.kind spec) 0)
           (and (= result 0) (> (len parameters) 0) (= (get parameters 0) 6)))))

;;; Access only a validated complete prototype. SGAG-v1 carries no result role;
;;; v2's 16-byte header adds kind, piece type/count and six reserved zero bytes.
;;; A v3 builtin declaration has an ordinary result.
(defn decode [(bytes (slice u8))] (-> Spec)
  (let [base (+ 3 (cast i64 (get bytes 2)))]
    (if (or (= (len bytes) base) (= (get bytes (+ base 4)) 1) (= (get bytes (+ base 4)) 3))
        (ordinary)
        (Spec
          :kind (cast i32 (get bytes (+ base 5)))
          :ty (get bytes (+ base 8))
          :count (cast i32 (get bytes (+ base 9)))))))

(defn size [(spec Spec)] (-> i64)
  (if (= (.kind spec) 1)
      (* (cast i64 (.count spec))
         (cast i64 (types/size (cast i32 (.ty spec)) 8)))
      0))
