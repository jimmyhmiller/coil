;;; Explicit aggregate result-storage roles for the scalar IR ABI extension.
(module stogir.call-results)
(import "stogir.types" :as types)
(import "stogir.target" :as target)

;;; Whether the target's convention is System V x86-64. The shapes that exist
;;; only there (result pairs here; mixed argument pairs and MEMORY parameters
;;; in stogir.call-groups) are invalid everywhere else, so no other target
;;; ever sees one in a validated prototype.
(defn system-v? [] (-> bool)
  (target/arch-pick false true))

;;; kind0=ordinary scalar/void result, kind1=register pieces, kind2=indirect
;;; (x8 on AArch64; the hidden first integer argument, returned in rax, on
;;; x86-64). With either aggregate kind, fixed parameter0 is the explicit ADDR
;;; result place and the IR CALL/RETURN type is void. It consumes no ordinary
;;; argument.
;;;
;;; Register pieces come in two shapes. `second` = 0: `count` pieces of the one
;;; type `ty`, stored back to back in the result place (piece i at
;;; i * size(ty)). `second` != 0 (count is then 2): a pair of one-eightbyte
;;; pieces of types `ty` and `second`, each from {U64, I64, DOUBLE, FLOAT},
;;; stored at offsets 0 and 8 of the result place; the two may differ in type
;;; and register class. A pair is the System V shape (rax/rdx for the integer
;;; pieces and xmm0/xmm1 for the floating ones, in order per class); AArch64
;;; placement rejects it.
(defstruct Spec [(kind i32) (ty u8) (count i32) (second u8)])

(defn ordinary [] (-> Spec)
  (Spec
    :kind 0
    :ty 0
    :count 0
    :second 0))

(defn indirect [] (-> Spec)
  (Spec
    :kind 2
    :ty 0
    :count 0
    :second 0))

(defn pieces [(ty u8) (count i32)] (-> Spec)
  (Spec
    :kind 1
    :ty ty
    :count count
    :second 0))

;;; Two one-eightbyte register pieces stored at offsets 0 and 8.
(defn pair [(first u8) (second u8)] (-> Spec)
  (Spec
    :kind 1
    :ty first
    :count 2
    :second second))

(defn pair? [(spec Spec)] (-> bool)
  (and (= (.kind spec) 1) (!= (.second spec) 0)))

;;; A type that fills one eightbyte of a pair: U64, I64, DOUBLE or FLOAT.
(defn eightbyte? [(ty u8)] (-> bool)
  (or (= ty 5) (= ty 11) (= ty 12) (= ty 13)))

(defn shape? [(spec Spec)] (-> bool)
  (if (or (= (.kind spec) 0) (= (.kind spec) 2))
      (and (= (.ty spec) 0) (= (.count spec) 0) (= (.second spec) 0))
      (and (= (.kind spec) 1)
           (>= (.count spec) 1)
           (if (!= (.second spec) 0)
               (and (system-v?)
                    (= (.count spec) 2) (eightbyte? (.ty spec)) (eightbyte? (.second spec)))
               (if (or (= (.ty spec) 5) (= (.ty spec) 11))
                   (<= (.count spec) 2)
                   (and (or (types/floating? (cast i32 (.ty spec)))
                            (types/short-vector? (cast i32 (.ty spec)) 8))
                        (<= (.count spec) 4)))))))

(defn valid? [(result u8) (parameters (slice u8)) (spec Spec)] (-> bool)
  (and (shape? spec)
       (or (= (.kind spec) 0)
           (and (= result 0) (> (len parameters) 0) (= (get parameters 0) 6)))))

;;; Access only a validated complete prototype. SGAG-v1 carries no result role;
;;; v2's 16-byte header adds kind, piece type/count and six reserved zero bytes.
;;; The count byte holds the piece count in its low four bits and a pair's
;;; second piece type in its high four (zero for every homogeneous shape, so
;;; prototypes written before pairs existed read back unchanged).
;;; A v3 builtin declaration has an ordinary result.
(defn decode [(bytes (slice u8))] (-> Spec)
  (let [base (+ 3 (cast i64 (get bytes 2)))]
    (if (or (= (len bytes) base) (= (get bytes (+ base 4)) 1) (= (get bytes (+ base 4)) 3))
        (ordinary)
        (Spec
          :kind (cast i32 (get bytes (+ base 5)))
          :ty (get bytes (+ base 8))
          :count (cast i32 (& (get bytes (+ base 9)) 15))
          :second (>> (get bytes (+ base 9)) 4)))))

;;; The serialized count byte of a shape-valid spec (see `decode`).
(defn count-byte [(spec Spec)] (-> u8)
  (| (cast u8 (& (.count spec) 15)) (<< (.second spec) 4)))

;;; Type of register piece `index` (0-based) of a kind-1 spec.
(defn piece-type [(spec Spec) (index i32)] (-> u8)
  (if (and (= index 1) (!= (.second spec) 0)) (.second spec) (.ty spec)))

;;; Byte offset of register piece `index` in the result place.
(defn piece-offset [(spec Spec) (index i32)] (-> i64)
  (if (!= (.second spec) 0)
      (* 8 (cast i64 index))
      (* (cast i64 index) (cast i64 (types/size (cast i32 (.ty spec)) 8)))))

(defn size [(spec Spec)] (-> i64)
  (if (= (.kind spec) 1)
      (if (!= (.second spec) 0)
          16
          (* (cast i64 (.count spec))
             (cast i64 (types/size (cast i32 (.ty spec)) 8))))
      0))
