;;; Chains of IF nodes that test one integer value for equality with distinct
;;; constants become one SWITCH, rewritten within the existing cells: the head
;;; IF becomes the SWITCH, each matching projection its CASE_VAL and the final
;;; missing projection the CASE_DEFAULT. Successors, MERGE predecessor order
;;; and PHI inputs are untouched. See docs/CONTROL.md.
(module stogir.equality-chain)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.switch" :as switch)
(import "stogir.dead-code" :as dead)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "stogir.bitset" :as bits)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

;;; One IF on EQ/NE(value, constant). match is the projection taken when the
;;; value equals the constant, miss the other one. branch is zero when the
;;; node is not such a test.
(defstruct Test [(branch i32) (value i32) (constant i32) (key u64) (match i32) (miss i32)])

(defn no-test [] (-> Test)
  (Test :branch 0 :value 0 :constant 0 :key 0 :match 0 :miss 0))

(defn count [(edges uses/Uses) (reference i32)] (-> i64)
  (.count (get (.ranges edges) (cast i64 reference))))

(defn test [(graph g/Graph) (edges uses/Uses) (reference i32)] (-> Test)
  (let [node (get (.instructions graph) (cast i64 reference))
        condition (.op2 node)]
    (if (or (!= (n/opcode node) 116)
            (!= (get (.arities graph) (cast i64 reference)) 2)
            (<= condition 0)
            (!= (count edges reference) 2))
        (no-test)
        (let [comparison (get (.instructions graph) (cast i64 condition))
              equal (= (n/opcode comparison) 14)
              value (.op1 comparison)
              constant (.op2 comparison)]
          (if (or (not (or equal (= (n/opcode comparison) 15)))
                  (<= value 0)
                  (>= constant 0))
              (no-test)
              (match (switch/selector-type graph value)
                (Err [_] (no-test))
                (Ok [ty]
                    (match (switch/key graph constant ty)
                      (Err [_] (no-test))
                      (Ok [key]
                          (let [range (get (.ranges edges) (cast i64 reference))
                                (mut yes) (: 0 i32)
                                (mut no) (: 0 i32)]
                            (for [i (.offset range) (+ (.offset range) (.count range))]
                              (let [edge (get (.edges edges) i)
                                    projection (get (.instructions graph) (cast i64 (.user edge)))]
                                (when (and (= (.operand edge) 1) (= (.op1 projection) reference))
                                  (cond (= (n/opcode projection) 107) (set! yes (.user edge))
                                        (= (n/opcode projection) 108) (set! no (.user edge))))))
                            (if (or (= yes 0) (= no 0))
                                (no-test)
                                (Test :branch reference
                                      :value value
                                      :constant constant
                                      :key key
                                      :match (if equal yes no)
                                      :miss (if equal no yes)))))))))))))

;;; The next link: the missing projection leads only, and directly, to another
;;; test of the same value. Observable roots are never removed.
(defn following [(graph g/Graph) (edges uses/Uses) (protected bits/Bits) (current Test)] (-> Test)
  (if (or (!= (count edges (.miss current)) 1)
          (bits/contains? protected (cast i64 (.miss current))))
      (no-test)
      (let [edge (get (.edges edges) (.offset (get (.ranges edges) (cast i64 (.miss current)))))
            next (if (and (= (.operand edge) 1)
                          (not (bits/contains? protected (cast i64 (.user edge)))))
                     (test graph edges (.user edge))
                     (no-test))]
        (if (and (!= (.branch next) 0) (= (.value next) (.value current)))
            next
            (no-test)))))

;;; A test is a chain head unless another test links to it.
(defn head? [(graph g/Graph) (edges uses/Uses) (protected bits/Bits) (current Test)] (-> bool)
  (let [previous (.op1 (get (.instructions graph) (cast i64 (.branch current))))]
    (if (<= previous 0)
        true
        (let [projection (get (.instructions graph) (cast i64 previous))]
          (if (or (not (or (= (n/opcode projection) 107) (= (n/opcode projection) 108)))
                  (<= (.op1 projection) 0))
              true
              (let [before (test graph edges (.op1 projection))]
                (or (= (.branch before) 0)
                    (!= (.miss before) previous)
                    (!= (.branch (following graph edges protected before))
                        (.branch current)))))))))

;;; Length of the longest prefix whose constants are pairwise distinct.
(defn distinct-prefix [(chain (ArrayList Test)) (a (dyn Allocator))] (-> i64)
  (if (= (len chain) 2)
      (if (= (.key (get chain 0)) (.key (get chain 1))) 1 2)
      (sorted-distinct-prefix chain a)))

;;; Sorting keeps this linear-logarithmic for arbitrarily long chains.
(defn sorted-distinct-prefix [(chain (ArrayList Test)) (a (dyn Allocator))] (-> i64)
  (let [(mut sorted) (ArrayList::new [switch/Case] a)
        (mut limit) (len chain)]
    (for [i 0 (len chain)]
      (push! (mut sorted) (switch/Case :low (.key (get chain i)) :high 0 :target (cast i32 i))))
    (switch/sort! (mut sorted))
    ; Within a run of equal keys, every position but the smallest repeats it.
    (let [(mut i) (: 0 i64)]
      (while (< i (len sorted))
        (let [(mut j) (+ i 1)
              (mut smallest) (cast i64 (.target (get sorted i)))
              (mut second) (len chain)]
          (while (and (< j (len sorted)) (= (.low (get sorted j)) (.low (get sorted i))))
            (let [position (cast i64 (.target (get sorted j)))]
              (if (< position smallest)
                  (do (set! second smallest) (set! smallest position))
                  (when (< position second) (set! second position))))
            (set! j (+ j 1)))
          (when (< second limit) (set! limit second))
          (set! i j))))
    (free! (mut sorted))
    limit))

;;; The sole user of a definition, or zero.
(defn only-user [(edges uses/Uses) (reference i32)] (-> i32)
  (if (= (count edges reference) 1)
      (.user (get (.edges edges) (.offset (get (.ranges edges) (cast i64 reference)))))
      0))

;;; The END through which a projection enters its final MERGE, crossing only
;;; blocks that hold nothing: its own, then any MERGE whose sole user is its
;;; END (so it has no PHI). Zero when the projection's block has contents.
;;; Nested short-circuit tests join this way.
(defn joining-end [(graph g/Graph) (edges uses/Uses) (projection i32)] (-> i32)
  (let [(mut start) projection
        (mut result) (: 0 i32)
        (mut steps) (: 0 i64)]
    (while (and (> start 0) (< steps (len (.instructions graph))))
      (let [end (only-user edges start)
            target (if (and (> end 0)
                            (= (n/opcode (get (.instructions graph) (cast i64 end))) 114))
                       (only-user edges end)
                       0)]
        (if (and (> target 0)
                 (= (n/opcode (get (.instructions graph) (cast i64 target))) 112))
            (do (set! result end) (set! start target))
            (set! start 0)))
      (set! steps (+ steps 1)))
    result))

;;; One-based predecessor position of end in merge, or zero.
(defn position [(graph g/Graph) (merge i32) (end i32)] (-> i32)
  (let [(mut found) (: 0 i32)]
    (for [i 1 (+ (cast i64 (get (.arities graph) (cast i64 merge))) 1)]
      (when (= (input graph merge (cast i32 i)) end) (set! found (cast i32 i))))
    found))

(defn input [(graph g/Graph) (reference i32) (index i32)] (-> i32)
  (match (g/operand graph reference index) (Some [value] value) (None [] 0)))

;;; Every match of the first length links enters one MERGE through empty
;;; blocks, and each PHI there takes one computed value from all of them (a
;;; constant would need its own move on every edge). The matches then share
;;; a code address, which a single range or bit test reaches.
(defn one-destination? [(graph g/Graph) (edges uses/Uses) (chain (ArrayList Test)) (length i64)]
  (-> bool)
  (let [first (joining-end graph edges (.match (get chain 0)))
        merge (if (> first 0) (only-user edges first) 0)
        (mut same) (> merge 0)]
    (when same
      (let [slot (position graph merge first)
            range (get (.ranges edges) (cast i64 merge))]
        (for [i 1 length]
          (when same
            (let [end (joining-end graph edges (.match (get chain i)))]
              (if (or (<= end 0) (!= (only-user edges end) merge))
                  (set! same false)
                  (when (!= end first)
                    (let [other (position graph merge end)]
                      (for [k (.offset range) (+ (.offset range) (.count range))]
                        (let [user (.user (get (.edges edges) k))]
                          (when (and (= (n/opcode (get (.instructions graph) (cast i64 user))) 67)
                                     (or (<= (input graph user (+ slot 1)) 0)
                                         (!= (input graph user (+ slot 1))
                                             (input graph user (+ other 1)))))
                            (set! same false))))))))))))
    same))

;;; Four tests always pay for one dispatch. Fewer do only as one destination:
;;; three become a bit test, two adjacent constants a range test. Other short
;;; chains stay IFs, which keep their source order and branch layout.
(defn profitable? [(graph g/Graph) (edges uses/Uses) (chain (ArrayList Test)) (length i64)] (-> bool)
  (cond (>= length 4) true
        (= length 3) (one-destination? graph edges chain 3)
        (= length 2)
          (let [a (.key (get chain 0))
                b (.key (get chain 1))]
            (and (= (if (> a b) (- a b) (- b a)) 1)
                 (one-destination? graph edges chain 2)))
        :else false))

(defn replace! [(graph (mut g/Graph))
                (edges (mut uses/Uses))
                (queue (mut q/Queue))
                (reference i32)
                (opcode u8)
                (inputs (slice i32))] (-> void)
  (dead/detach! graph (mut edges) (mut queue) reference)
  (unless (g/rewrite-inputs! (mut graph) reference opcode 0 inputs)
    (panic "equality chain rewrite failed"))
  (for [i 0 (len inputs)]
    (when (and (> (get inputs i) 0)
               (uses/edge-code? (op/operand-code (cast i32 opcode) (cast i32 (+ i 1)))))
      (uses/add! (mut edges)
                 (get inputs i)
                 (uses/Use :user reference :operand (cast i32 (+ i 1))))))
  (q/add! (mut queue) (cast i64 reference)))

(defn rewrite-chain! [(graph (mut g/Graph))
                      (edges (mut uses/Uses))
                      (queue (mut q/Queue))
                      (chain (ArrayList Test))
                      (length i64)] (-> void)
  (let [head (get chain 0)
        dispatch (.branch head)
        control (.op1 (get (.instructions graph) (cast i64 dispatch)))]
    (replace! (mut graph) (mut edges) (mut queue) dispatch 117 [control (.value head)])
    (for [i 0 length]
      (let [link (get chain i)]
        (replace! (mut graph) (mut edges) (mut queue) (.match link) 109
                  [dispatch (.constant link) (: 0 i32)])
        (if (= i (- length 1))
            (replace! (mut graph) (mut edges) (mut queue) (.miss link) 111 [dispatch (: 0 i32)])
            ; The next IF goes first: it is the only user of this projection.
            (do (replace! (mut graph) (mut edges) (mut queue) (.branch (get chain (+ i 1))) 0 [])
                (replace! (mut graph) (mut edges) (mut queue) (.miss link) 0 [])))))))

;;; edges are exact and stay exact. Detached comparisons are queued for the
;;; caller's cleanup. Returns the number of chains rewritten.
(defn rewrite! [(graph (mut g/Graph))
                (edges (mut uses/Uses))
                (queue (mut q/Queue))
                (protected bits/Bits)
                (a (dyn Allocator))] (-> i32)
  (let [(mut chain) (ArrayList::new [Test] a)
        (mut changes) (: 0 i32)
        (mut r) (: 1 i64)]
    (while (< r (len (.instructions graph)))
      (when (= (n/opcode (get (.instructions graph) r)) 116)
        (let [first (test graph edges (cast i32 r))]
          (when (and (!= (.branch first) 0) (head? graph edges protected first))
            (clear! (mut chain))
            (push! (mut chain) first)
            (let [(mut next) (following graph edges protected first)]
              (while (!= (.branch next) 0)
                (push! (mut chain) next)
                (set! next (following graph edges protected next))))
            (when (>= (len chain) 2)
              (let [length (distinct-prefix chain a)]
                (when (profitable? graph edges chain length)
                  (rewrite-chain! (mut graph) (mut edges) (mut queue) chain length)
                  (set! changes (+ changes 1))))))))
      (set! r (+ r (/ (+ (cast i64 (get (.arities graph) r)) 4) 4))))
    (free! (mut chain))
    changes))
