;;; Stage orchestration following pinned ir_sccp.c:ir_sccp: one analysis,
;;; one transformation, then affected-node iterative cleanup. The current
;;; iterative kernel covers scalar fold/CSE/DCE, diamonds and late constant
;;; IFs. Invalidated control reachability is rebuilt once, including merge/Phi
;;; repair. Exact-width aliasing loads use the affected worklist after that
;;; boundary; broader predicate, loop, partial-load and store cleanup is pending.
(module stogir.sccp)
(import "stogir.graph" :as g)
(import "stogir.mem2ssa" :as mem)
(import "stogir.load-forward" :as forward)
(import "stogir.copy-forward" :as copies)
(import "stogir.compact" :as compact)
(import "stogir.boolean-diamond" :as diamond)
(import "stogir.control-merge" :as control)
(import "stogir.equality-chain" :as chain)
(import "stogir.jump-thread" :as thread)
(import "stogir.node" :as n)
(import "stogir.verify" :as verify)
(import "coil.arraylist" :use [ArrayList])
(import "stogir.sccp-analysis" :as analysis)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.iter-fold" :as iter)
(import "stogir.uses" :as uses)
(import "stogir.bitset" :as bits)
(import "stogir.bitqueue" :as q)
(import "coil.alloc" :use [Allocator])
(import "coil.mem" :as memory)
(import "coil.result" :use [Result Ok Err Option Some None])

;;; Uses are rebuilt after the bulk rewrite. Only the owned working graph is
;;; mutable; no second copy or repeated SCCP fixed-point analysis is needed.
(defn finish! [(result (mut rewrite/Rewritten))
               (pointer-bytes i32)
               (a (dyn Allocator))] (-> (Result i32 (slice u8)))
  (finish-compacting! (mut result) pointer-bytes false a))

;;; As finish!; compacting lets the result drop dead cells, renumbering its
;;; references.
(defn finish-compacting! [(result (mut rewrite/Rewritten))
                          (pointer-bytes i32)
                          (compacting bool)
                          (a (dyn Allocator))] (-> (Result i32 (slice u8)))
  (finish-with-uses! (mut result) pointer-bytes compacting (None) a))

;;; As finish-compacting!. PREPARED, when given, is uses/build of the result's
;;; graph as it is now; it is consumed. Without it the index is built here.
(defn finish-with-uses! [(result (mut rewrite/Rewritten))
                         (pointer-bytes i32)
                         (compacting bool)
                         (prepared (Option uses/Uses))
                         (a (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [(mut edges) (match prepared
                      (Some [given] given)
                      (None [] (uses/build (.graph result) a)))
        ; Threading comes first: it appends nodes and may add observed ENDs,
        ; which the root set below must cover.
        threaded (thread/rewrite! (mut (.graph result))
                                  (mut (.roots result))
                                  (mut edges)
                                  (mut (.iteration result))
                                  pointer-bytes
                                  a)
        (mut protected) (bits/create (len (.instructions (.graph result))) a)
        (mut error) ""
        (mut changes) (: 0 i32)]
    (match threaded
      (Err [message] (set! error message))
      (Ok [count] (set! changes count)))
    (set! changes
          (+ changes
          (control/merge! (mut (.graph result))
                          (mut (.roots result))
                          (mut edges)
                          (mut (.iteration result))
                          a)))
    (match (diamond/rewrite! (mut (.graph result))
                             (mut (.roots result))
                             (mut edges)
                             (mut (.iteration result))
                             pointer-bytes
                             a)
      (Err [message] (set! error message))
      (Ok [count] (set! changes (+ changes count))))
    (for root (.roots result) (bits/add! (mut protected) (cast i64 root)))
    (match (iter/run-rooted! (mut (.graph result))
                             (mut (.roots result))
                             (mut edges)
                             (mut (.iteration result))
                             (mut protected)
                             pointer-bytes
                             a)
      (Err [message] (set! error message))
      (Ok [count] (set! changes (+ changes count))))
    ; Equality chains exist only once IF folding and splitting have settled.
    ; The second cleanup retires the comparisons the dispatch no longer reads.
    (when (= error "")
      (let [chains (chain/rewrite! (mut (.graph result))
                                   (mut edges)
                                   (mut (.iteration result))
                                   protected
                                   a)]
        (when (> chains 0)
          (set! changes (+ changes chains))
          (match (iter/run-rooted! (mut (.graph result))
                                   (mut (.roots result))
                                   (mut edges)
                                   (mut (.iteration result))
                                   (mut protected)
                                   pointer-bytes
                                   a)
            (Err [message] (set! error message))
            (Ok [count] (set! changes (+ changes count)))))))
    (set! (.proof result) 0)
    ; When dead NOP cells are an eighth of the graph, hand on a compacted
    ; copy. It is validated (and proven) itself, so later stages see the
    ; smaller graph with a proof that matches it.
    (when (and (= error "")
               compacting
               (>= (* (compact/nop-cells (.graph result)) 8)
                   (len (.instructions (.graph result))))
               (compact/compactable? (.graph result) (slice (.roots result)) a)
               (= (n/opcode (get (.instructions (.graph result)) 1)) 104))
      (let [packed (compact/compact (.graph result) (slice (.roots result)) a)]
        (g/release! (mut (.graph result)))
        (free! (mut (.roots result)))
        (q/release! (mut (.iteration result)))
        (set! (.graph result) (.graph packed))
        (set! (.roots result) (.roots packed))
        (set! (.iteration result) (q/create (len (.instructions (.graph packed))) a))))
    (when (= error "")
      (match (rewrite/validate (.graph result) pointer-bytes a)
        (Err [message] (set! error message))
        (Ok [_] (set! (.proof result) (rewrite/content-hash (.graph result) pointer-bytes)))))
    (uses/release! (mut edges))
    (bits/release! (mut protected))
    (when (= error "") (set! (.changes result) (+ (.changes result) changes)))
    (if (= error "") (Ok changes) (Err error))))

;;; Caller graph and root slice remain immutable on success and failure. The
;;; returned roots belong to the result. Consumers rebuild all CFG/dominance,
;;; placement, schedule and matching information after successful optimization.
(defn optimize [(source g/Graph)
                (pointer-bytes i32)
                (roots (slice i32))
                (a (dyn Allocator))]
  (-> (Result rewrite/Rewritten (slice u8)))
  (optimize-proven source pointer-bytes roots 0 a))

;;; A nonzero proof that still matches source's digest stands in for the
;;; analysis's input validation (see rewrite/content-hash).
(defn optimize-proven [(source g/Graph)
                       (pointer-bytes i32)
                       (roots (slice i32))
                       (proof u128)
                       (a (dyn Allocator))]
  (-> (Result rewrite/Rewritten (slice u8)))
  (optimize-proven-compacting source pointer-bytes roots proof false a))

;;; Whether two graphs hold the same instruction cells and arities, so a use
;;; index of one is exactly the use index of the other.
(defn same-instructions? [(first g/Graph) (second g/Graph)] (-> bool)
  (and (= (len (.instructions first)) (len (.instructions second)))
       (= (len (.arities first)) (len (.arities second)))
       (memory/eql (.data (.instructions first)) (.data (.instructions second))
                (len (.instructions first)))
       (memory/eql (.data (.arities first)) (.data (.arities second))
                (len (.arities first)))))

;;; As optimize-proven. When compacting, a result with many dead NOP cells is
;;; a compacted copy whose references are renumbered in order; only its roots
;;; name its nodes.
(defn optimize-proven-compacting [(source g/Graph)
                                  (pointer-bytes i32)
                                  (roots (slice i32))
                                  (proof u128)
                                  (compacting bool)
                                  (a (dyn Allocator))]
  (-> (Result rewrite/Rewritten (slice u8)))
  (optimize-checked-compacting source pointer-bytes roots
                               (and (!= proof 0)
                                    (= (rewrite/content-hash source pointer-bytes) proof))
                               false compacting a))

;;; As optimize-proven-compacting, for a caller that already knows what was
;;; checked on exactly this graph. proven: its digest equals a
;;; rewrite/Rewritten proof. structured: it has just passed verify/structure.
(defn optimize-checked-compacting [(source g/Graph)
                                   (pointer-bytes i32)
                                   (roots (slice i32))
                                   (proven bool)
                                   (structured bool)
                                   (compacting bool)
                                   (a (dyn Allocator))]
  (-> (Result rewrite/Rewritten (slice u8)))
  (match (analysis/verify-input-structured source pointer-bytes proven structured a)
    (Err [message] (Err message))
    (Ok [_]
        ; One use index of the source serves the analysis and the rewrite. A
        ; rewrite that left every instruction cell as it was hands the same
        ; index on to the cleanup, which otherwise indexes the rewritten graph.
        (let [(mut edges) (uses/build source a)]
          (match (analysis/analyze-verified source pointer-bytes roots edges a)
            (Err [message]
                 (uses/release! (mut edges))
                 (Err message))
            (Ok [facts]
                (let [(mut facts) facts
                      transformed (rewrite/rewrite-sharing-uses source facts roots (Some edges) true a)]
                  (analysis/release! (mut facts))
                  (match transformed
                    (Err [message]
                         (uses/release! (mut edges))
                         (Err message))
                    (Ok [result]
                        (let [(mut result) result
                              prepared (if (same-instructions? source (.graph result))
                                           (Some edges)
                                           (do
                                             (uses/release! (mut edges))
                                             (None [uses/Uses])))]
                          (match (finish-with-uses! (mut result) pointer-bytes compacting prepared a)
                            (Err [message]
                                 (rewrite/release! (mut result))
                                 (Err message))
                            (Ok [_] (Ok result)))))))))))))

;;; Upstream runs optional memory promotion before SCCP and resets CFG facts.
;;; Keep that ordering without changing the SCCP-only component entry point.
;;; Graph cloning and promotion remain inside the measured optimization boundary.
(defn optimize-memory [(source g/Graph)
                       (pointer-bytes i32)
                       (roots (slice i32))
                       (little-endian bool)
                       (a (dyn Allocator))]
  (-> (Result rewrite/Rewritten (slice u8)))
  (optimize-memory-compacting source pointer-bytes roots little-endian false a))

;;; As optimize-memory; compacting as for optimize-proven-compacting.
(defn optimize-memory-compacting [(source g/Graph)
                                  (pointer-bytes i32)
                                  (roots (slice i32))
                                  (little-endian bool)
                                  (compacting bool)
                                  (a (dyn Allocator))]
  (-> (Result rewrite/Rewritten (slice u8)))
  (match (verify/structure source)
    (Err [message] (Err message))
    (Ok [_]
        (let [(mut needed) false
              (mut r) 1
              (mut valid) true]
          (while (< r (len (.instructions source)))
            (when (or (= (n/opcode (get (.instructions source) r)) 81)
                      (and little-endian
                           (= (n/opcode (get (.instructions source) r)) 91)))
              (set! needed true))
            (set! r (+ r (/ (+ (cast i64 (get (.arities source) r)) 4) 4))))
          (for root roots
            (unless (and (> root 0) (g/contains? source root))
              (set! valid false)))
          (if (not valid)
              (Err "invalid promotion root")
              (if (or (not needed) (!= pointer-bytes 8))
                  ; The structure check above still describes this graph.
                  (optimize-checked-compacting source pointer-bytes roots false true compacting a)
                  (let [(mut working) (g/duplicate source a)
                        (mut observed) (ArrayList::new [i32] a)]
                    (for root roots (push! (mut observed) root))
                    (let [output
                            (match (match (copies/run! (mut working) (slice observed) a)
                                     (Err [message] (Err [i32 (slice u8)] message))
                                     (Ok [_]
                                         (forward/run! (mut working)
                                                       (mut observed)
                                                       pointer-bytes
                                                       little-endian
                                                       a)))
                              (Err [message]
                                   (Err [rewrite/Rewritten (slice u8)] message))
                              (Ok [_]
                                  (match (mem/promote-ordered! (mut working)
                                                       (mut observed)
                                                       little-endian
                                                       a)
                                    (Err [message]
                                         (Err [rewrite/Rewritten (slice u8)]
                                              message))
                                    (Ok [_]
                                        (optimize-proven-compacting working
                                                                    pointer-bytes
                                                                    (slice observed)
                                                                    0
                                                                    compacting
                                                                    a)))))]
                      (free! (mut observed))
                      (g/release! (mut working))
                      output))))))))

;;; Compaction renumbers only positive references; every root must name a cell.
(defn for-all-positive? [(roots (slice i32)) (graph g/Graph)] (-> bool)
  (let [(mut good) true]
    (for root roots
      (unless (and (> root 0) (g/contains? graph root)) (set! good false)))
    good))

;;; Compatibility entry retains the existing promotion/SCCP-only policy.
;;; Target backends opt into memory forwarding with an explicit byte order.
;;; optimize-memory for a caller that discards its graph afterwards: promotion
;;; mutates the graph in place instead of a duplicate. The graph is consumed:
;;; it is released on every path, so the caller must not release it again.
;;; Dead cells may be compacted away, before and after optimization, so the
;;; result's references are renumbered: only its roots name its nodes.
(defn optimize-memory-owned! [(source g/Graph)
                              (pointer-bytes i32)
                              (roots (slice i32))
                              (little-endian bool)
                              (a (dyn Allocator))]
  (-> (Result rewrite/Rewritten (slice u8)))
  (optimize-memory-owned-proven! source pointer-bytes roots little-endian 0 a))

;;; As optimize-memory-owned!, with a rewrite/Rewritten proof for source (or
;;; zero). A matching proof stands in for the entry structure check, and still
;;; does for the SCCP analysis when memory promotion leaves the digest unchanged.
(defn optimize-memory-owned-proven! [(source g/Graph)
                              (pointer-bytes i32)
                              (roots (slice i32))
                              (little-endian bool)
                              (proof u128)
                              (a (dyn Allocator))]
  (-> (Result rewrite/Rewritten (slice u8)))
  (let [(mut working) source
        (mut needed) false
        (mut valid) true
        proven (and (!= proof 0) (= (rewrite/content-hash source pointer-bytes) proof))
        (mut r) 1]
    (match (if proven (Ok [i32 (slice u8)] 0) (verify/structure working))
      (Err [message] (g/release! (mut working)) (Err message))
      (Ok [_]
          (if (and (>= (* (compact/nop-cells working) 8) (len (.instructions working)))
                   (for-all-positive? roots working))
              ; Dead NOP cells are a large share of this owned graph: optimize a
              ; compacted copy instead. References are renumbered in order.
              (let [(mut packed) (compact/compact working roots a)]
                (g/release! (mut working))
                (let [result (optimize-memory-owned! (.graph packed) pointer-bytes
                                                     (slice (.roots packed)) little-endian a)]
                  (free! (mut (.roots packed)))
                  result))
          (do
            (while (< r (len (.instructions working)))
              (when (or (= (n/opcode (get (.instructions working) r)) 81)
                        (and little-endian
                             (= (n/opcode (get (.instructions working) r)) 91)))
                (set! needed true))
              (set! r (+ r (/ (+ (cast i64 (get (.arities working) r)) 4) 4))))
            (for root roots
              (unless (and (> root 0) (g/contains? working root))
                (set! valid false)))
            (let [output
                    (cond (not valid)
                            (Err [rewrite/Rewritten (slice u8)] "invalid promotion root")
                          ; Nothing has touched the graph since the entry
                          ; check: a matching proof or that structure check
                          ; still describes it.
                          (or (not needed) (!= pointer-bytes 8))
                            (optimize-checked-compacting working pointer-bytes roots
                                                         proven (not proven) true a)
                          :else
                            (let [(mut observed) (ArrayList::new [i32] a)]
                              (for root roots (push! (mut observed) root))
                              (let [result
                                      (match (match (copies/run! (mut working) (slice observed) a)
                                               (Err [message] (Err [i32 (slice u8)] message))
                                               (Ok [copied]
                                                   (match (forward/run! (mut working)
                                                                        (mut observed)
                                                                        pointer-bytes
                                                                        little-endian
                                                                        a)
                                                     (Err [message] (Err [i32 (slice u8)] message))
                                                     (Ok [forwarded] (Ok (+ copied forwarded))))))
                                        (Err [message]
                                             (Err [rewrite/Rewritten (slice u8)] message))
                                        (Ok [forwarded]
                                            (match (mem/promote-ordered! (mut working)
                                                                         (mut observed)
                                                                         little-endian
                                                                         a)
                                              (Err [message]
                                                   (Err [rewrite/Rewritten (slice u8)]
                                                        message))
                                              (Ok [promoted]
                                                  ; A reported change means the proof no
                                                  ; longer applies; skip comparing digests.
                                                  (optimize-checked-compacting
                                                    working
                                                    pointer-bytes
                                                    (slice observed)
                                                    (and proven
                                                         (= forwarded 0)
                                                         (= promoted 0)
                                                         (= (rewrite/content-hash working pointer-bytes)
                                                            proof))
                                                    false
                                                    true
                                                    a)))))]
                                (free! (mut observed))
                                result)))]
              (g/release! (mut working))
              output)))))))

(defn optimize-promoted [(source g/Graph)
                         (pointer-bytes i32)
                         (roots (slice i32))
                         (a (dyn Allocator))]
  (-> (Result rewrite/Rewritten (slice u8)))
  (optimize-memory source pointer-bytes roots false a))
