;;; Whole-table copy of a scalar-keyed map.
(module stogir.map-copy)
(import "coil.hashmap" :use [HashMap Entry])
(import "coil.alloc" :as alloc :use [Allocator])
(import "coil.mem" :as mem)
(import "coil.result" :use [Some None])

;;; An independent map owned by A that answers every lookup as SOURCE does.
;;; Scalar keys own no storage, so the slot array (keys, values, kept hashes
;;; and tombstones alike) is copied as bytes: no key is hashed or probed
;;; again, unlike inserting each entry into a fresh table.
(defn scalar [K V] [(source (HashMap K V)) (a (dyn Allocator))] (-> (HashMap K V))
  (let [(mut result) (HashMap::new-scalar [K V] a)]
    (when (> (.cap source) 0)
      (match (alloc/alloc [(Entry K V)] a (.cap source))
        (None [] (panic "out of memory copying a {}-slot map" (.cap source)))
        (Some [slots]
              (mem/copy [(Entry K V)] (data slots) (.slots source) (.cap source))
              (set! (.slots result) (data slots))
              (set! (.cap result) (.cap source))
              (set! (.len result) (.len source))
              (set! (.tombs result) (.tombs source)))))
    result))
