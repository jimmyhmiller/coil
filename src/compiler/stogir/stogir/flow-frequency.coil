;;; Expected block visits per entry from normalized static edge weights.
;;; Solve (I - P^T) f = entry. Unlike a layout ranking heuristic, this keeps
;;; loop entry, backedge and exit traffic consistent. Sparse elimination is
;;; deliberately independent of graph/node numbering and allocation policy.
(module stogir.flow-frequency)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Option Some None])

(defstruct Edge [(from i32) (to i32) (weight i32)])
(defstruct Term [(column i32) (value f64)])
(defstruct Row [(terms (ArrayList Term)) (rhs f64)])

(defn absolute [(x f64)] (-> f64) (if (< x 0.0) (- 0.0 x) x))
(defn coefficient [(row Row) (column i32)] (-> f64)
  (let [(mut result) (: 0.0 f64)]
    (for term (.terms row) (when (= (.column term) column) (set! result (.value term))))
    result))
(defn add! [(row (mut Row)) (column i32) (value f64)] (-> void)
  (unless (= value 0.0)
    (let [(mut found) false]
      (for [i 0 (len (.terms row))]
        (when (= (.column (get (.terms row) i)) column)
          (let [term (elem (mut (.terms row)) i)]
            (set! (.value term) (+ (.value term) value)))
          (set! found true)))
      (unless found (push! (mut (.terms row)) (Term :column column :value value))))))

;;; A reachable closed recurrent class has no finite expected visit count.
;;; Near-singular/numerically unreliable systems also return None; callers can
;;; retain their prior cost model without changing the program. Invalid input
;;; is an error. Unreachable components have zero frequency, including cycles.
;;; Positive input weights are normalized per source, allowing rounded static
;;; percentages and duplicate CFG edges without losing probability mass.
(defn estimate [(count i32) (entry i32) (edges (slice Edge)) (a (dyn Allocator))]
  (-> (Result (Option (ArrayList f64)) (slice u8)))
  (let [(mut error) ""]
    (when (or (<= count 0) (< entry 0) (>= entry count)) (set! error "invalid frequency entry"))
    (for edge edges
      (when (or (< (.from edge) 0) (>= (.from edge) count)
                (< (.to edge) 0) (>= (.to edge) count) (<= (.weight edge) 0))
        (set! error "invalid frequency edge")))
    (if (!= error "") (Err error)
      (let [(mut totals) (ArrayList::new [i64] a)
            (mut reachable) (ArrayList::new [bool] a)
            (mut queue) (ArrayList::new [i32] a)
            (mut rows) (ArrayList::new [Row] a)
            (mut result) (ArrayList::new [f64] a)
            (mut expected) (ArrayList::new [f64] a)
            (mut valid) true]
        (for [i (: 0 i32) count]
          (push! (mut totals) 0) (push! (mut reachable) false)
          (push! (mut result) 0.0) (push! (mut expected) 0.0)
          (let [(mut row) (Row :terms (ArrayList::new [Term] a) :rhs (if (= i entry) 1.0 0.0))]
            (add! (mut row) i 1.0) (push! (mut rows) row)))
        (for edge edges
          (let [i (cast i64 (.from edge)) weight (cast i64 (.weight edge))]
            (if (> (get totals i) (- 9223372036854775807 weight))
              (set! error "frequency weight sum overflow")
              (set! (mut totals) i (+ (get totals i) weight)))))
        (set! (mut reachable) (cast i64 entry) true) (push! (mut queue) entry)
        (let [(mut head) 0]
          (while (< head (len queue))
            (let [source (get queue head)]
              (for edge edges
                (when (and (= (.from edge) source) (not (get reachable (cast i64 (.to edge)))))
                  (set! (mut reachable) (cast i64 (.to edge)) true)
                  (push! (mut queue) (.to edge)))))
            (set! head (+ head 1))))
        (when (= error "")
          (for edge edges
            (when (get reachable (cast i64 (.from edge)))
              (add! (elem (mut rows) (cast i64 (.to edge))) (.from edge)
                (- 0.0 (/ (cast f64 (.weight edge)) (cast f64 (get totals (cast i64 (.from edge)))))))))
          ; I-P^T is a nonsingular M-matrix when finite visits exist; its
          ; elimination pivots are positive, so row pivoting is unnecessary.
          ; Tiny pivots decline rather than manufacture extreme frequencies.
          (for [column (: 0 i32) count]
            (when valid
              (let [i (cast i64 column) pivot (coefficient (get rows i) column)]
                (if (or (!= pivot pivot) (<= pivot 0.000000000001))
                  (set! valid false)
                  (do
                    (let [row (elem (mut rows) i)]
                      (set! (.rhs row) (/ (.rhs row) pivot))
                      (for [j 0 (len (.terms row))]
                        (let [term (elem (mut (.terms row)) j)]
                          (when (>= (.column term) column) (set! (.value term) (/ (.value term) pivot))))))
                    (for [j (+ i 1) (len rows)]
                      (let [factor (coefficient (get rows j) column)]
                        (unless (= factor 0.0)
                          (let [row (elem (mut rows) j) source (get rows i)]
                            (add! row column (- 0.0 factor))
                            (set! (.rhs row) (- (.rhs row) (* factor (.rhs source))))
                            (for term (.terms source)
                              (when (> (.column term) column)
                                (add! row (.column term) (- 0.0 (* factor (.value term)))))))))))))))
          (let [(mut i) (- (len rows) 1)]
            (while (and valid (>= i 0))
              (let [row (get rows i) (mut value) (.rhs row)]
                (for term (.terms row)
                  (when (> (cast i64 (.column term)) i)
                    (set! value (- value (* (.value term) (get result (cast i64 (.column term))))))))
                (if (or (!= value value) (< value 0.0) (> value 1.0e300))
                  (set! valid false) (set! (mut result) i value)))
              (set! i (- i 1))))
          (when valid
            (set! (mut expected) (cast i64 entry) 1.0)
            (for edge edges
              (let [from (cast i64 (.from edge)) to (cast i64 (.to edge))]
                (set! (mut expected) to (+ (get expected to)
                  (* (get result from) (/ (cast f64 (.weight edge)) (cast f64 (get totals from))))))))
            (for [i 0 (len result)]
              (when (> (absolute (- (get result i) (get expected i))) (* 0.00000001 (+ 1.0 (get result i))))
                (set! valid false)))))
        (for row rows (let [(mut row) row] (free! (mut (.terms row)))))
        (free! (mut rows)) (free! (mut totals)) (free! (mut reachable))
        (free! (mut queue)) (free! (mut expected))
        (cond (!= error "") (do (free! (mut result)) (Err error))
              (not valid) (do (free! (mut result)) (Ok (None)))
              :else (Ok (Some result)))))))
