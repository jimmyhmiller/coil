;;; Darwin arm64 MH_OBJECT serialization of the shared text/data image.
(module stogir.aot.macho)

(export image-object text-object)

(import "stogir.image" :as image)
(import "stogir.alignment" :as alignment)
(import "stogir.text-data" :as text-data)
(import "stogir.image-order" :as order)
(import "stogir.aot.macho-symbols" :as symbols)
(import "stogir.a64.relocation" :as a64)
(import "stogir.relocate" :as relocation)
(import "stogir.bytes" :as b)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(defn u64! [(out (mut (ArrayList u8))) (value u64)] (-> void)
  (b/append32! (mut out) (cast u32 (& value 0xFFFFFFFF)))
  (b/append32! (mut out) (cast u32 (>> value 32))))

(defn name! [(out (mut (ArrayList u8))) (name (slice u8))] (-> void)
  (let [(mut i) 0]
    (while (< i 16)
      (push! (mut out) (if (< i (len name)) (get name i) (: 0 u8)))
      (set! i (+ i 1)))))

(defn align [(value i64) (alignment i64)] (-> i64)
  (* (/ (+ value (- alignment 1)) alignment) alignment))

(defn section! [(out (mut (ArrayList u8)))
                (name (slice u8))
                (segment (slice u8))
                (address i64)
                (size i64)
                (offset i64)
                (alignment i32)
                (relocations i64)
                (count i64)
                (flags u32)] (-> void)
  (name! (mut out) name)
  (name! (mut out) segment)
  (u64! (mut out) (cast u64 address))
  (u64! (mut out) (cast u64 size))
  (for word [(cast u32 offset)
             (cast u32 alignment)
             (if (= count 0) (: 0 u32) (cast u32 relocations))
             (cast u32 count)
             flags
             (: 0 u32)
             0
             0]
    (b/append32! (mut out) word)))

;;; Source names are exact object names (including Darwin's C underscore).
;;; Input bytes and stable IDs are never changed by serialization.
(defn image-object [(source image/Image) (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (if (or (not (image/valid-alignments? source))
          (> (.text-alignment source) 16384)
          (> (.data-alignment source) 16384)
          (!= (% (len (.text source)) 4) 0)
          (> (len (.text source)) 4294967295)
          (> (len (.data source)) 4294967295)
          (> (len (.relocations source)) 4294967295))
      (Err (if (not (image/valid-alignments? source))
               "invalid Mach-O section alignment"
               (if (or (> (.text-alignment source) 16384)
                       (> (.data-alignment source) 16384))
                   "Darwin arm64 linker cannot guarantee section alignment above 16384 bytes"
                   "invalid Mach-O section size or text alignment")))
      (match (symbols/build source allocator)
        (Err [msg] (Err msg))
        (Ok [table]
            (let [(mut owned) table
                  result
                    (match (order/relocations source allocator)
                      (Err [msg] (Err [(ArrayList u8) (slice u8)] msg))
                      (Ok [relocations]
                          (let [(mut sorted) relocations
                                object
                                  (emit-object source owned sorted allocator)]
                            (free! (mut sorted))
                            object)))]
              (symbols/release! (mut owned))
              result)))))

;;; Internal: table and sorted relocations have passed image bounds validation.
(defn emit-object [(source image/Image)
                   (table symbols/Table)
                   (relocations (ArrayList image/Relocation))
                   (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (let [text-size (len (.text source))
        data-size (len (.data source))
        data-address (align text-size (.data-alignment source))
        entries (text-data/entry-count (.text-data source))
        text-offset (if (= entries 0) (: 392 i64) (: 408 i64))
        data-offset (+ text-offset data-address)
        text-relocations (align (+ data-offset data-size) 4)
        (mut text-count) (: 0 i64)
        (mut data-count) (: 0 i64)
        (mut error) ""]
    (for record relocations
      (let [kind (.kind record)
            count (if (and (!= kind 1) (!= (.addend record) 0)) 2 1)]
        (when (or (> (.offset record) 2147483647)
                  (and (!= kind 1) (!= (% (.offset record) 4) 0))
                  (and (!= kind 1)
                       (or (< (.addend record) -8388608)
                           (> (.addend record) 8388607))))
          (set! error
                "Mach-O relocation offset/alignment or signed 24-bit addend is invalid"))
        (if (= (.section record) 1)
            (set! text-count (+ text-count count))
            (set! data-count (+ data-count count)))))
    (let [data-relocations (+ text-relocations (* text-count 8))
          symbol-offset (align (+ data-relocations (* data-count 8)) 8)
          string-offset (+ symbol-offset (* (len (.symbols source)) 16))
          strings-end (+ string-offset (.string-size table))
          entries-offset (align strings-end 4)
          file-size
            (if (= entries 0) strings-end (+ entries-offset (* entries 8)))]
      (if (or (!= error "")
              (> file-size 4294967295)
              (> text-count 4294967295)
              (> data-count 4294967295))
          (Err (if (!= error "") error "Mach-O file exceeds 32-bit offsets"))
          (let [(mut out) (ArrayList::new [u8] allocator)]
            (reserve! (mut out) file-size)
            ; Data-in-code adds one 16-byte load command only when needed.
            (for word [(: 0xFEEDFACF u32)
                       0x0100000C
                       0
                       1
                       (if (= entries 0) (: 4 u32) (: 5 u32))
                       (if (= entries 0) (: 360 u32) (: 376 u32))
                       0
                       0]
              (b/append32! (mut out) word))
            (b/append32! (mut out) 0x19)
            (b/append32! (mut out) 232)
            (name! (mut out) "")
            (u64! (mut out) 0)
            (u64! (mut out) (cast u64 (+ data-address data-size)))
            (u64! (mut out) (cast u64 text-offset))
            (u64! (mut out)
                  (cast u64 (- (+ data-offset data-size) text-offset)))
            (for word [(: 7 u32) 7 2 0] (b/append32! (mut out) word))
            (section! (mut out)
                      "__text"
                      "__TEXT"
                      0
                      text-size
                      text-offset
                      (alignment/exponent (.text-alignment source))
                      text-relocations
                      text-count
                      0x80000400)
            (section! (mut out)
                      "__data"
                      "__DATA"
                      data-address
                      data-size
                      data-offset
                      (alignment/exponent (.data-alignment source))
                      data-relocations
                      data-count
                      0)
            (for word [(: 2 u32)
                       24
                       (cast u32 symbol-offset)
                       (cast u32 (len (.symbols source)))
                       (cast u32 string-offset)
                       (cast u32 (.string-size table))]
              (b/append32! (mut out) word))
            ; LC_DYSYMTAB groups locals, external definitions, then undefineds.
            (for word [(: 0xB u32)
                       80
                       0
                       (cast u32 (.locals table))
                       (cast u32 (.locals table))
                       (cast u32 (.defined table))
                       (cast u32 (+ (.locals table) (.defined table)))
                       (cast u32
                             (- (len (.symbols source))
                                (+ (.locals table) (.defined table))))]
              (b/append32! (mut out) word))
            (let [(mut i) 0]
              (while (< i 12) (b/append32! (mut out) 0) (set! i (+ i 1))))
            (for word [(: 0x32 u32) 24 1 0x000B0000 0 0]
              (b/append32! (mut out) word))
            (when (> entries 0)
              (for word [(: 0x29 u32)
                         16
                         (cast u32 entries-offset)
                         (cast u32 (* entries 8))]
                (b/append32! (mut out) word)))
            (extend! (mut out) (.data (.text source)) (len (.text source)))
            (while (< (len out) data-offset) (push! (mut out) 0))
            (extend! (mut out) (.data (.data source)) (len (.data source)))
            (while (< (len out) text-relocations) (push! (mut out) 0))
            (for record relocations
              (when (= error "")
                (let [kind (.kind record)
                      offset (.offset record)
                      file-offset
                        (+ (if (= (.section record) 1) text-offset data-offset)
                           offset)
                      symbol-index
                        (get (.indices table) (cast i64 (.symbol record)))]
                  (if (= kind 1)
                      (do
                        (b/patch32! (mut out)
                                    file-offset
                                    (cast u32 (.addend record)))
                        (b/patch32! (mut out)
                                    (+ file-offset 4)
                                    (cast u32
                                          (>> (cast u64 (.addend record)) 32))))
                      (let [word
                              (if (= (.section record) 1)
                                  (relocation/read32 (.text source) offset)
                                  (relocation/read32 (.data source) offset))]
                        (match (a64/clear kind word)
                          (Err [msg] (set! error msg))
                          (Ok [cleared]
                              (b/patch32! (mut out) file-offset cleared)))
                        (when (!= (.addend record) 0)
                          (b/append32! (mut out) (cast u32 offset))
                          (b/append32! (mut out)
                                       (| (: 0xA4000000 u32)
                                          (& (cast u32 (.addend record))
                                             0xFFFFFF))))))
                  (b/append32! (mut out) (cast u32 offset))
                  (b/append32! (mut out)
                               (| (cast u32 symbol-index)
                                  (: 0x08000000 u32)
                                  (<< (if (= kind 1) (: 3 u32) (: 2 u32)) 25)
                                  (if (or (= kind 2) (= kind 3))
                                      (: 0x01000000 u32)
                                      (: 0 u32))
                                  (<< (if (= kind 1) (: 0 u32) (cast u32 kind))
                                      28))))))
            (while (< (len out) symbol-offset) (push! (mut out) 0))
            (for id (.order table)
              (let [symbol (get (.symbols source) (cast i64 id))
                    section (.section symbol)
                    type
                      (| (if (= section 0) (: 0 u32) (: 0xE u32))
                         (if (.global? symbol) (: 1 u32) (: 0 u32)))]
                (b/append32! (mut out)
                             (cast u32 (get (.strings table) (cast i64 id))))
                (b/append32! (mut out) (| type (<< (cast u32 section) 8)))
                (u64! (mut out)
                      (cast u64
                            (if (= section 0)
                                0
                                (+ (.offset symbol)
                                   (if (= section 2) data-address 0)))))))
            (push! (mut out) 0)
            (for id (.order table)
              (let [symbol (get (.symbols source) (cast i64 id))
                    (mut i) 0]
                (while (< i (.length symbol))
                  (push! (mut out) (get (.names source) (+ (.name symbol) i)))
                  (set! i (+ i 1)))
                (push! (mut out) 0)))
            (when (> entries 0)
              (while (< (len out) entries-offset) (push! (mut out) 0))
              ; MH_OBJECT entries use section VM offsets, not file offsets.
              ; __text starts at VM address zero; LLVM MC emits the same form.
              (for range (.text-data source)
                (let [width (text-data/width (.kind range))
                      limit (* (/ 65535 width) width)
                      (mut offset) (.offset range)
                      (mut remaining) (.length range)]
                  (while (> remaining 0)
                    (let [size (if (< remaining limit) remaining limit)]
                      (b/append32! (mut out) (cast u32 offset))
                      (b/append32! (mut out)
                                   (| (cast u32 size)
                                      (<< (cast u32 (.kind range)) 16)))
                      (set! offset (+ offset size))
                      (set! remaining (- remaining size)))))))
            (when (and (= error "") (!= (len out) file-size))
              (set! error "Mach-O serialization size mismatch"))
            (if (= error "") (Ok out) (do (free! (mut out)) (Err error))))))))

;;; Compatibility entry point; serialization uses the same shared-image writer.
(defn text-object [(text (slice u8))
                   (symbol (slice u8))
                   (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (if (= (len text) 0)
      (Err "empty function text")
      (let [(mut source) (image/create allocator)]
        (extend! (mut (.text source)) (data text) (len text))
        (let [result
                (match (image/symbol! (mut source) symbol 1 0)
                  (Err [msg] (Err [(ArrayList u8) (slice u8)] msg))
                  (Ok [_] (image-object source allocator)))]
          (image/release! (mut source))
          result))))
