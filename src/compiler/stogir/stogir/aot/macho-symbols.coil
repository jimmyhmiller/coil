;;; Mach-O symbol groups and stable image-ID to nlist-index mapping.
(module stogir.aot.macho-symbols)
(import "stogir.image" :as image)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(defstruct Table
  [(order (ArrayList i32))
   (indices (ArrayList i32))
   (strings (ArrayList i64))
   (string-size i64)
   (locals i64)
   (defined i64)])

(defn release! [(table (mut Table))] (-> void)
  (free! (mut (.order table)))
  (free! (mut (.indices table)))
  (free! (mut (.strings table))))

(defn group [(symbol image/Symbol)] (-> i32)
  (if (not (.global? symbol)) 0 (if (!= (.section symbol) 0) 1 2)))

(defn before? [(source image/Image) (left i32) (right i32)] (-> bool)
  (let [a (get (.symbols source) (cast i64 left))
        b (get (.symbols source) (cast i64 right))
        ga (group a)
        gb (group b)
        (mut i) 0
        (mut result) (<= (.length a) (.length b))
        (mut found?) false]
    (if (!= ga gb)
        (< ga gb)
        (do
          (while (and (not found?) (< i (.length a)) (< i (.length b)))
            (let [ca (get (.names source) (+ (.name a) i))
                  cb (get (.names source) (+ (.name b) i))]
              (when (!= ca cb) (set! result (< ca cb)) (set! found? true)))
            (set! i (+ i 1)))
          result))))

(defn build [(source image/Image) (allocator (dyn Allocator))]
  (-> (Result Table (slice u8)))
  (let [(mut table)
          (Table
            :order (ArrayList::new [i32] allocator)
            :indices (ArrayList::new [i32] allocator)
            :strings (ArrayList::new [i64] allocator)
            :string-size 1
            :locals 0
            :defined 0)
        (mut scratch) (ArrayList::new [i32] allocator)
        count (len (.symbols source))
        (mut error) ""
        (mut i) 0
        (mut width) (: 1 i64)]
    (when (> count 16777216) (set! error "Mach-O symbol index exceeds 24 bits"))
    (while (and (= error "") (< i count))
      (let [symbol (get (.symbols source) i)
            section (.section symbol)
            length (if (= section 1) (len (.text source)) (len (.data source)))]
        (if (or (< section 0)
                (> section 2)
                (< (.offset symbol) 0)
                (and (= section 0)
                     (or (!= (.offset symbol) 0) (not (.global? symbol))))
                (and (!= section 0) (> (.offset symbol) length))
                (< (.name symbol) 0)
                (<= (.length symbol) 0)
                (> (.length symbol) (len (.names source)))
                (> (.name symbol) (- (len (.names source)) (.length symbol))))
            (set! error "invalid Mach-O image symbol")
            (let [(mut j) 0]
              (while (< j (.length symbol))
                (when (= (get (.names source) (+ (.name symbol) j)) 0)
                  (set! error "Mach-O symbol name contains zero"))
                (set! j (+ j 1)))))
        (when (= (group symbol) 0) (set! (.locals table) (+ (.locals table) 1)))
        (when (= (group symbol) 1)
          (set! (.defined table) (+ (.defined table) 1))))
      (push! (mut (.order table)) (cast i32 i))
      (push! (mut scratch) (cast i32 i))
      (push! (mut (.indices table)) 0)
      (push! (mut (.strings table)) 0)
      (set! i (+ i 1)))
    (while (and (= error "") (< width count))
      (let [(mut start) 0]
        (while (< start count)
          (let [mid (if (< (+ start width) count) (+ start width) count)
                end
                  (if (< (+ start (* width 2)) count)
                      (+ start (* width 2))
                      count)
                (mut a) start
                (mut b) mid
                (mut out) start]
            (while (< out end)
              (if (and (< a mid)
                       (or (>= b end)
                           (before? source
                                    (get (.order table) a)
                                    (get (.order table) b))))
                  (do
                    (set! (mut scratch) out (get (.order table) a))
                    (set! a (+ a 1)))
                  (do
                    (set! (mut scratch) out (get (.order table) b))
                    (set! b (+ b 1))))
              (set! out (+ out 1))))
          (set! start (+ start (* width 2)))))
      (set! i 0)
      (while (< i count)
        (set! (mut (.order table)) i (get scratch i))
        (set! i (+ i 1)))
      (set! width (* width 2)))
    (set! i 0)
    (while (and (= error "") (< i count))
      (let [id (cast i64 (get (.order table) i))
            symbol (get (.symbols source) id)]
        (set! (mut (.indices table)) id (cast i32 i))
        (set! (mut (.strings table)) id (.string-size table))
        (if (> (.length symbol) (- 4294967295 (+ (.string-size table) 1)))
            (set! error "Mach-O string table exceeds 32-bit size")
            (set! (.string-size table)
                  (+ (.string-size table) (.length symbol) 1))))
      (set! i (+ i 1)))
    (free! (mut scratch))
    (if (= error "") (Ok table) (do (release! (mut table)) (Err error)))))
