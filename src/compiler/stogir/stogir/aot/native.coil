;;; One object-writer entry for every supported image: the object format follows
;;; the image's machine. AArch64 images are macOS Mach-O objects; x86-64 images
;;; are Linux ELF objects. Symbol names are written exactly as the image has
;;; them (see `stogir.symbol-name` for C names per system).
(module stogir.aot.native)

(export image-object text-object)

(import "stogir.image" :as image)
(import "stogir.target" :as target)
(import "stogir.aot.macho" :as macho)
(import "stogir.aot.elf" :as elf)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(defn image-object [(source image/Image) (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (if (= (.machine source) image/AARCH64)
      (macho/image-object source allocator)
      (if (= (.machine source) image/X86-64)
          (elf/image-object source allocator)
          (Err "unknown image machine"))))

;;; `text` is machine code for the machine this program is compiled for.
(defn text-object [(text (slice u8))
                   (symbol (slice u8))
                   (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (target/arch-pick (macho/text-object text symbol allocator)
                    (elf/text-object text symbol allocator)))
