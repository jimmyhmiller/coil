; Scalar floating rules follow dstogov/ir ir_fold.h, 92171d0. See NOTICE.
(module stogir.floating)
(import "coil.primitive" :as p)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.opcode" :as op)
(import "stogir.symbols" :as symbols)
(import "coil.primitive" :as primitive)
(import "coil.result" :use [Result Ok Err Option Some None])

(defn comparison? [(opcode i32)] (-> bool)
  (and (>= opcode 14) (<= opcode 25)))

;;; Extension opcodes beyond the pinned table (see stogir.opcode): SQRT 131,
;;; FMA 132, FMIN 133, FMAX 134, FMINNM 135, FMAXNM 136 and the roundings to an
;;; integral value 137..141 (to even, up, down, toward zero, half away).
(defn extension? [(opcode i32)] (-> bool)
  (and (>= opcode 131) (<= opcode 141)))

(defn rounding? [(opcode i32)] (-> bool)
  (and (>= opcode 137) (<= opcode 141)))

;;; IEEE extrema, as opposed to the selecting MIN/MAX (58/59).
(defn extremum? [(opcode i32)] (-> bool)
  (and (>= opcode 133) (<= opcode 136)))

;;; FMA takes three values: op1 * op2 + op3, rounded once.
(defn ternary? [(opcode i32)] (-> bool)
  (= opcode 132))

(defn unary? [(opcode i32)] (-> bool)
  (or (= opcode 31) (= opcode 32) (= opcode 131) (rounding? opcode)))

(defn operation? [(opcode i32)] (-> bool)
  (or (comparison? opcode)
      (unary? opcode)
      (and (>= opcode 26) (<= opcode 29))
      (= opcode 58)
      (= opcode 59)
      (extension? opcode)))

(defn node? [(graph g/Graph) (reference i32)] (-> bool)
  (let [null (p/cast (ptr n/Node) 0)
        pointer (g/borrow-node graph reference)]
    (if (= pointer null)
        false
        (let [node (load pointer)
              input (g/borrow-node graph (.op1 node))]
          (and (not (types/vector? (cast i32 (n/type-id node))))
               (or (= input null)
                   (not (types/vector? (cast i32 (n/type-id (load input))))))
               (operation? (cast i32 (n/opcode node)))
               (or (= (n/opcode node) 24)
                   (= (n/opcode node) 25)
                   (types/floating? (cast i32 (n/type-id node)))
                   (and (!= input null)
                        (types/floating? (cast i32 (n/type-id (load input)))))))))))

;;; GUARD is the division guard of DIV and the addend of FMA; zero otherwise.
(defn operands [(graph g/Graph)
                (opcode i32)
                (ty i32)
                (left i32)
                (right i32)
                (guard i32)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""]
    (when (or (not (operation? opcode)) (not (types/floating? ty)))
      (set! error "invalid floating operation or type"))
    (for input [left
                (if (unary? opcode) left right)
                (if (ternary? opcode) guard left)]
      (match (g/lookup graph input)
        (None [] (set! error "floating operand missing"))
        (Some [node]
              (when (!= (cast i32 (n/type-id node)) ty)
                (set! error "floating operand type mismatch")))))
    (when (and (!= guard 0) (not (ternary? opcode)))
      (if (!= opcode 29)
          (set! error "only floating DIV accepts a guard")
          (match (g/lookup graph guard)
            (None [] (set! error "division guard missing"))
            (Some [node]
                  (when (or (< guard 0)
                            (not (or (op/block-start? (cast i32 (n/opcode node)))
                                     (= (n/opcode node) 101)
                                     (= (n/opcode node) 102))))
                    (set! error "division guard must be a block start or guard"))))))
    (if (= error "") (Ok ty) (Err error))))

(defn validate [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "floating instruction missing"))
    (Some [node]
          (let [opcode (cast i32 (n/opcode node))]
            (if (or (<= reference 0)
                    (not (operation? opcode))
                    (!= (get (.arities graph) (cast i64 reference))
                        (if (unary? opcode)
                            1
                            (if (or (= opcode 29) (ternary? opcode)) 3 2))))
                (Err "invalid floating instruction")
                (match (g/lookup graph (.op1 node))
                  (None [] (Err "floating operand missing"))
                  (Some [input]
                        (let [ty (cast i32 (n/type-id input))]
                          (if (!= (cast i32 (n/type-id node))
                                  (if (comparison? opcode) 1 ty))
                              (Err "floating result type mismatch")
                              (operands graph
                                        opcode
                                        ty
                                        (.op1 node)
                                        (.op2 node)
                                        (if (or (= opcode 29) (ternary? opcode))
                                            (.op3 node)
                                            0)))))))))))

(defn compare32 [(opcode i32) (a f32) (b f32)] (-> bool)
  (match opcode
    (14 (= a b))
    (15 (!= a b))
    (16 (< a b))
    (17 (>= a b))
    (18 (<= a b))
    (19 (> a b))
    (20 (not (>= a b)))
    (21 (not (< a b)))
    (22 (not (> a b)))
    (23 (not (<= a b)))
    (24 (and (= a a) (= b b)))
    (25 (or (!= a a) (!= b b)))
    (_ false)))

(defn compare64 [(opcode i32) (a f64) (b f64)] (-> bool)
  (match opcode
    (14 (= a b))
    (15 (!= a b))
    (16 (< a b))
    (17 (>= a b))
    (18 (<= a b))
    (19 (> a b))
    (20 (not (>= a b)))
    (21 (not (< a b)))
    (22 (not (> a b)))
    (23 (not (<= a b)))
    (24 (and (= a a) (= b b)))
    (25 (or (!= a a) (!= b b)))
    (_ false)))

;;; A rounding to an integral value of the finite, non-NaN BITS of the format
;;; with MANTISSA fraction bits. The fraction below the units place is dropped
;;; or carried; a carry out of the significand increments the exponent, which is
;;; the next power of two. Exact by IEEE 754, so it equals FRINTN/P/M/Z/A.
(defn round-bits [(opcode i32) (bits u64) (mantissa u64) (sign u64)] (-> u64)
  (let [negative (!= (& bits sign) 0)
        magnitude (& bits (- sign 1))
        field (>> magnitude mantissa)
        bias (- (>> sign (+ mantissa 1)) 1)
        one (| (<< bias mantissa) (& bits sign))
        zero (& bits sign)]
    (cond (or (= magnitude 0) (>= field (+ bias mantissa))) bits
          (< field bias)
            (let [half? (= field (- bias 1))
                  above-half? (and half? (!= (<< magnitude (- 64 mantissa)) 0))]
              (match opcode
                (137 (if above-half? one zero))
                (138 (if negative zero one))
                (139 (if negative one zero))
                (140 zero)
                (_ (if half? one zero))))
          :else
            (let [unit (<< (: 1 u64) (- mantissa (- field bias)))
                  fraction (& bits (- unit 1))
                  down (- bits fraction)
                  up (+ down unit)
                  half (>> unit 1)]
              (if (= fraction 0)
                  bits
                  (match opcode
                    (137
                      (if (or (> fraction half)
                              (and (= fraction half) (!= (& down unit) 0)))
                          up
                          down))
                    (138 (if negative down up))
                    (139 (if negative up down))
                    (140 down)
                    (_ (if (>= fraction half) up down))))))))

;;; Constant results of the extension opcodes, only where IEEE 754 fixes every
;;; bit independent of the machine: extrema and roundings of non-NaN operands.
;;; A NaN operand (payload and quieting rules), SQRT and FMA are left to the
;;; target instruction.
(defn evaluate-extension [(opcode i32) (ty i32) (left u64) (right u64)]
  (-> (Option u64))
  (let [mantissa (if (= ty 12) (: 52 u64) 23)
        sign (if (= ty 12) (: 0x8000000000000000 u64) 0x80000000)
        infinity (- sign (<< (: 1 u64) mantissa))
        x (& left (| sign (- sign 1)))
        y (& right (| sign (- sign 1)))
        x-magnitude (& x (- sign 1))
        y-magnitude (& y (- sign 1))]
    (cond (rounding? opcode)
            (if (>= x-magnitude infinity)
                (if (= x-magnitude infinity) (Some x) (None))
                (Some (round-bits opcode x mantissa sign)))
          (extremum? opcode)
            (if (or (> x-magnitude infinity) (> y-magnitude infinity))
                (None)
                (let [a (if (= x x-magnitude)
                            (cast i64 x-magnitude)
                            (- 0 (cast i64 x-magnitude)))
                      b (if (= y y-magnitude)
                            (cast i64 y-magnitude)
                            (- 0 (cast i64 y-magnitude)))
                      minimum? (or (= opcode 133) (= opcode 135))]
                  ; Equal values differ in bits only as -0 and +0.
                  (Some (cond (= a b) (if minimum? (| x y) (& x y))
                              (= (< a b) minimum?) x
                              :else y))))
          :else (None))))

;;; NEG/ABS and extrema select raw operand bits. In particular extrema preserve
;;; the left signed zero on equality and select the right operand when unordered.
(defn evaluate [(opcode i32) (ty i32) (left u64) (right u64)] (-> (Option u64))
  (if (or (not (operation? opcode)) (not (types/floating? ty)))
      (None)
      (let [mask (if (= ty 12) (: 0xFFFFFFFFFFFFFFFF u64) 0xFFFFFFFF)
            sign (if (= ty 12) (: 0x8000000000000000 u64) 0x80000000)
            x (& left mask)
            y (& right mask)]
        (if (extension? opcode)
            (evaluate-extension opcode ty left right)
        (if (unary? opcode)
            (Some (if (= opcode 31) (^ x sign) (& x (^ mask sign))))
            (if (= ty 12)
                (let [(mut a) (: 0.0 f64)
                      (mut b) (: 0.0 f64)
                      (mut result) (: 0.0 f64)]
                  (store! (primitive/cast (ptr u64) (mut a)) x)
                  (store! (primitive/cast (ptr u64) (mut b)) y)
                  (if (comparison? opcode)
                      (Some (if (compare64 opcode a b) (: 1 u64) 0))
                      (if (or (= opcode 58) (= opcode 59))
                          (Some (if (if (= opcode 58) (<= a b) (>= a b)) x y))
                          (do
                            (set! result
                                  (match opcode
                                    (26 (+ a b))
                                    (27 (- a b))
                                    (28 (* a b))
                                    (_ (/ a b))))
                            (Some (load (primitive/cast (ptr u64) (mut result))))))))
                (let [(mut a) (: 0.0 f32)
                      (mut b) (: 0.0 f32)
                      (mut result) (: 0.0 f32)]
                  (store! (primitive/cast (ptr u32) (mut a)) (cast u32 x))
                  (store! (primitive/cast (ptr u32) (mut b)) (cast u32 y))
                  (if (comparison? opcode)
                      (Some (if (compare32 opcode a b) (: 1 u64) 0))
                      (if (or (= opcode 58) (= opcode 59))
                          (Some (if (if (= opcode 58) (<= a b) (>= a b)) x y))
                          (do
                            (set! result
                                  (match opcode
                                    (26 (+ a b))
                                    (27 (- a b))
                                    (28 (* a b))
                                    (_ (/ a b))))
                            (Some (cast u64
                                        (load (primitive/cast (ptr u32)
                                                              (mut result)))))))))))))))

;;; Ordered expression keys deliberately preserve operand order: NaNs and equal
;;; signed zeros make floating extrema noncommutative. No fast-math rewrites.
;;; GUARD carries FMA's addend (see operands).
(defn build! [(graph (mut g/Graph))
              (opcode i32)
              (ty i32)
              (left i32)
              (right i32)
              (guard i32)]
  (-> (Result i32 (slice u8)))
  (match (operands graph opcode ty left right guard)
    (Err [message] (Err message))
    (Ok [_]
        (let [(mut folded) (: 0 i32)
              result-type (if (comparison? opcode) 1 ty)]
          (when (and (< left 0) (or (unary? opcode) (< right 0)))
            (match (g/lookup graph left)
              (None [] 0)
              (Some [a]
                    (match (g/lookup graph (if (unary? opcode) left right))
                      (None [] 0)
                      (Some [b]
                            (when (and (symbols/numeric? a)
                                       (symbols/numeric? b))
                              (match (evaluate opcode
                                               ty
                                               (n/constant-bits a)
                                               (n/constant-bits b))
                                (None [] 0)
                                (Some [bits]
                                      (match (g/intern-scalar! (mut graph)
                                                               (cast u8
                                                                     result-type)
                                                               bits)
                                        (None [] 0)
                                        (Some [reference]
                                              (set! folded reference)))))))))))
          (if (!= folded 0)
              (Ok folded)
              (let [key
                      (| (cast u128 opcode)
                         (<< (cast u128 ty) 8)
                         (<< (cast u128 (cast u32 left)) 16)
                         (<< (cast u128 (cast u32 (if (unary? opcode) 0 right)))
                             48)
                         (<< (cast u128 (cast u32 guard)) 80))]
                (match (get (.expressions graph) key)
                  (Some [reference] (Ok reference))
                  (None []
                        (let [added
                                (if (unary? opcode)
                                    (g/append-inputs! (mut graph)
                                                      (cast u8 opcode)
                                                      (cast u8 result-type)
                                                      [left])
                                    (if (or (= opcode 29) (ternary? opcode))
                                        (g/append-inputs! (mut graph)
                                                          (cast u8 opcode)
                                                          (cast u8 result-type)
                                                          [left right guard])
                                        (g/append-inputs! (mut graph)
                                                          (cast u8 opcode)
                                                          (cast u8 result-type)
                                                          [left right])))]
                          (match added
                            (None [] (Err "floating reference space exhausted"))
                            (Some [reference]
                                  (do
                                    (set! (mut (.expressions graph))
                                          key
                                          reference)
                                    (Ok reference)))))))))))))
