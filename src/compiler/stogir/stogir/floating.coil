; Scalar floating rules follow dstogov/ir ir_fold.h, 92171d0. See NOTICE.
(module stogir.floating)
(import "coil.primitive" :as p)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.opcode" :as op)
(import "stogir.symbols" :as symbols)
(import "coil.primitive" :as primitive)
(import "coil.result" :use [Result Ok Err Option Some None])

(defn comparison? [(opcode i32)] (-> bool)
  (and (>= opcode 14) (<= opcode 25)))

(defn unary? [(opcode i32)] (-> bool)
  (or (= opcode 31) (= opcode 32)))

(defn operation? [(opcode i32)] (-> bool)
  (or (comparison? opcode)
      (unary? opcode)
      (and (>= opcode 26) (<= opcode 29))
      (= opcode 58)
      (= opcode 59)))

(defn node? [(graph g/Graph) (reference i32)] (-> bool)
  (let [null (p/cast (ptr n/Node) 0)
        pointer (g/borrow-node graph reference)]
    (if (= pointer null)
        false
        (let [node (load pointer)
              input (g/borrow-node graph (.op1 node))]
          (and (not (types/vector? (cast i32 (n/type-id node))))
               (or (= input null)
                   (not (types/vector? (cast i32 (n/type-id (load input))))))
               (operation? (cast i32 (n/opcode node)))
               (or (= (n/opcode node) 24)
                   (= (n/opcode node) 25)
                   (types/floating? (cast i32 (n/type-id node)))
                   (and (!= input null)
                        (types/floating? (cast i32 (n/type-id (load input)))))))))))

(defn operands [(graph g/Graph)
                (opcode i32)
                (ty i32)
                (left i32)
                (right i32)
                (guard i32)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""]
    (when (or (not (operation? opcode)) (not (types/floating? ty)))
      (set! error "invalid floating operation or type"))
    (for input [left (if (unary? opcode) left right)]
      (match (g/lookup graph input)
        (None [] (set! error "floating operand missing"))
        (Some [node]
              (when (!= (cast i32 (n/type-id node)) ty)
                (set! error "floating operand type mismatch")))))
    (when (!= guard 0)
      (if (!= opcode 29)
          (set! error "only floating DIV accepts a guard")
          (match (g/lookup graph guard)
            (None [] (set! error "division guard missing"))
            (Some [node]
                  (when (or (< guard 0)
                            (not (or (op/block-start? (cast i32 (n/opcode node)))
                                     (= (n/opcode node) 101)
                                     (= (n/opcode node) 102))))
                    (set! error "division guard must be a block start or guard"))))))
    (if (= error "") (Ok ty) (Err error))))

(defn validate [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "floating instruction missing"))
    (Some [node]
          (let [opcode (cast i32 (n/opcode node))]
            (if (or (<= reference 0)
                    (not (operation? opcode))
                    (!= (get (.arities graph) (cast i64 reference))
                        (if (unary? opcode) 1 (if (= opcode 29) 3 2))))
                (Err "invalid floating instruction")
                (match (g/lookup graph (.op1 node))
                  (None [] (Err "floating operand missing"))
                  (Some [input]
                        (let [ty (cast i32 (n/type-id input))]
                          (if (!= (cast i32 (n/type-id node))
                                  (if (comparison? opcode) 1 ty))
                              (Err "floating result type mismatch")
                              (operands graph
                                        opcode
                                        ty
                                        (.op1 node)
                                        (.op2 node)
                                        (if (= opcode 29) (.op3 node) 0)))))))))))

(defn compare32 [(opcode i32) (a f32) (b f32)] (-> bool)
  (match opcode
    (14 (= a b))
    (15 (!= a b))
    (16 (< a b))
    (17 (>= a b))
    (18 (<= a b))
    (19 (> a b))
    (20 (not (>= a b)))
    (21 (not (< a b)))
    (22 (not (> a b)))
    (23 (not (<= a b)))
    (24 (and (= a a) (= b b)))
    (25 (or (!= a a) (!= b b)))
    (_ false)))

(defn compare64 [(opcode i32) (a f64) (b f64)] (-> bool)
  (match opcode
    (14 (= a b))
    (15 (!= a b))
    (16 (< a b))
    (17 (>= a b))
    (18 (<= a b))
    (19 (> a b))
    (20 (not (>= a b)))
    (21 (not (< a b)))
    (22 (not (> a b)))
    (23 (not (<= a b)))
    (24 (and (= a a) (= b b)))
    (25 (or (!= a a) (!= b b)))
    (_ false)))

;;; NEG/ABS and extrema select raw operand bits. In particular extrema preserve
;;; the left signed zero on equality and select the right operand when unordered.
(defn evaluate [(opcode i32) (ty i32) (left u64) (right u64)] (-> (Option u64))
  (if (or (not (operation? opcode)) (not (types/floating? ty)))
      (None)
      (let [mask (if (= ty 12) (: 0xFFFFFFFFFFFFFFFF u64) 0xFFFFFFFF)
            sign (if (= ty 12) (: 0x8000000000000000 u64) 0x80000000)
            x (& left mask)
            y (& right mask)]
        (if (unary? opcode)
            (Some (if (= opcode 31) (^ x sign) (& x (^ mask sign))))
            (if (= ty 12)
                (let [(mut a) (: 0.0 f64)
                      (mut b) (: 0.0 f64)
                      (mut result) (: 0.0 f64)]
                  (store! (primitive/cast (ptr u64) (mut a)) x)
                  (store! (primitive/cast (ptr u64) (mut b)) y)
                  (if (comparison? opcode)
                      (Some (if (compare64 opcode a b) (: 1 u64) 0))
                      (if (or (= opcode 58) (= opcode 59))
                          (Some (if (if (= opcode 58) (<= a b) (>= a b)) x y))
                          (do
                            (set! result
                                  (match opcode
                                    (26 (+ a b))
                                    (27 (- a b))
                                    (28 (* a b))
                                    (_ (/ a b))))
                            (Some (load (primitive/cast (ptr u64) (mut result))))))))
                (let [(mut a) (: 0.0 f32)
                      (mut b) (: 0.0 f32)
                      (mut result) (: 0.0 f32)]
                  (store! (primitive/cast (ptr u32) (mut a)) (cast u32 x))
                  (store! (primitive/cast (ptr u32) (mut b)) (cast u32 y))
                  (if (comparison? opcode)
                      (Some (if (compare32 opcode a b) (: 1 u64) 0))
                      (if (or (= opcode 58) (= opcode 59))
                          (Some (if (if (= opcode 58) (<= a b) (>= a b)) x y))
                          (do
                            (set! result
                                  (match opcode
                                    (26 (+ a b))
                                    (27 (- a b))
                                    (28 (* a b))
                                    (_ (/ a b))))
                            (Some (cast u64
                                        (load (primitive/cast (ptr u32)
                                                              (mut result))))))))))))))

;;; Ordered expression keys deliberately preserve operand order: NaNs and equal
;;; signed zeros make floating extrema noncommutative. No fast-math rewrites.
(defn build! [(graph (mut g/Graph))
              (opcode i32)
              (ty i32)
              (left i32)
              (right i32)
              (guard i32)]
  (-> (Result i32 (slice u8)))
  (match (operands graph opcode ty left right guard)
    (Err [message] (Err message))
    (Ok [_]
        (let [(mut folded) (: 0 i32)
              result-type (if (comparison? opcode) 1 ty)]
          (when (and (< left 0) (or (unary? opcode) (< right 0)))
            (match (g/lookup graph left)
              (None [] 0)
              (Some [a]
                    (match (g/lookup graph (if (unary? opcode) left right))
                      (None [] 0)
                      (Some [b]
                            (when (and (symbols/numeric? a)
                                       (symbols/numeric? b))
                              (match (evaluate opcode
                                               ty
                                               (n/constant-bits a)
                                               (n/constant-bits b))
                                (None [] 0)
                                (Some [bits]
                                      (match (g/intern-scalar! (mut graph)
                                                               (cast u8
                                                                     result-type)
                                                               bits)
                                        (None [] 0)
                                        (Some [reference]
                                              (set! folded reference)))))))))))
          (if (!= folded 0)
              (Ok folded)
              (let [key
                      (| (cast u128 opcode)
                         (<< (cast u128 ty) 8)
                         (<< (cast u128 (cast u32 left)) 16)
                         (<< (cast u128 (cast u32 (if (unary? opcode) 0 right)))
                             48)
                         (<< (cast u128 (cast u32 guard)) 80))]
                (match (get (.expressions graph) key)
                  (Some [reference] (Ok reference))
                  (None []
                        (let [added
                                (if (unary? opcode)
                                    (g/append-inputs! (mut graph)
                                                      (cast u8 opcode)
                                                      (cast u8 result-type)
                                                      [left])
                                    (if (= opcode 29)
                                        (g/append-inputs! (mut graph)
                                                          (cast u8 opcode)
                                                          (cast u8 result-type)
                                                          [left right guard])
                                        (g/append-inputs! (mut graph)
                                                          (cast u8 opcode)
                                                          (cast u8 result-type)
                                                          [left right])))]
                          (match added
                            (None [] (Err "floating reference space exhausted"))
                            (Some [reference]
                                  (do
                                    (set! (mut (.expressions graph))
                                          key
                                          reference)
                                    (Ok reference)))))))))))))
