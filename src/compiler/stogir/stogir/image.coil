;;; Address-independent code image shared by loaders and object writers.
(module stogir.image)
(import "stogir.bytes" :as bytes)
(import "stogir.alignment" :as alignment)
(import "stogir.text-data" :as text-data)
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

;;; section: 0=undefined, 1=text, 2=data. Names are owned in a byte arena.
(defstruct Symbol
  [(name i64) (length i64) (section i32) (offset i64) (next i32) (global? bool)])

;;; Machine identity of an image: which instruction set its text holds. Neutral
;;; layers (relocation, composition, loading, object writing) act per machine.
(const AARCH64 1)

(const X86-64 2)

;;; Relocation kinds. ABS64 is shared; every other kind belongs to one machine.
;;; PC32 and PLT32 both store int32(S + A - P): the addend is explicit (-4 for a
;;; field that ends its instruction, more negative when an immediate follows).
;;; They differ in meaning only: PLT32 marks a call or jump, so a loader or
;;; linker may route it through a stub; PC32 must reach the symbol itself.
(const ABS64 1)

(const A64-BRANCH26 2)

(const A64-PAGE21 3)

(const A64-PAGEOFF12 4)

(const X64-PC32 5)

(const X64-PLT32 6)

;;; kind: 1=ABS64; AArch64 2=BRANCH26, 3=PAGE21, 4=PAGEOFF12; x86-64 5=PC32,
;;; 6=PLT32. The addend is added to the symbol address for every kind.
(defstruct Relocation
  [(section i32) (offset i64) (kind i32) (symbol i32) (addend i64)])

;;; machine: AARCH64 or X86-64, fixed at creation. text-alignment is the
;;; alignment of the text section's start, which composition preserves for every
;;; part; it is at least the machine's text unit (see `text-unit`).
(defstruct Image
  [(machine i32)
   (text-alignment i64)
   (data-alignment i64)
   (text (ArrayList u8))
   (text-data (ArrayList text-data/Range))
   (data (ArrayList u8))
   (names (ArrayList u8))
   (symbols (ArrayList Symbol))
   (heads (HashMap u64 i32))
   (relocations (ArrayList Relocation))
   (local-sequence u64)])

;;; An empty image for `machine` with the machine's minimum section alignments.
;;; An unknown machine is not rejected here: every consumer validates it.
(defn empty [(machine i32) (allocator (dyn Allocator))] (-> Image)
  (Image
    :machine machine
    :text-alignment (text-unit machine)
    :data-alignment 8
    :text (ArrayList::new [u8] allocator)
    :text-data (ArrayList::new [text-data/Range] allocator)
    :data (ArrayList::new [u8] allocator)
    :names (ArrayList::new [u8] allocator)
    :symbols (ArrayList::new [Symbol] allocator)
    :heads (HashMap::new-scalar [u64 i32] allocator)
    :relocations (ArrayList::new [Relocation] allocator)
    :local-sequence 0))

;;; An empty AArch64 image: text aligned to one instruction word.
(defn create [(allocator (dyn Allocator))] (-> Image)
  (empty AARCH64 allocator))

;;; An empty x86-64 image. Text starts 16-aligned, the System V function
;;; alignment; instructions have byte granularity, so text length is unrestricted
;;; and `require-alignments!` accepts any power of two down to 1.
(defn create-x64 [(allocator (dyn Allocator))] (-> Image)
  (let [(mut image) (empty X86-64 allocator)]
    (set! (.text-alignment image) 16)
    image))

(defn known-machine? [(machine i32)] (-> bool)
  (or (= machine AARCH64) (= machine X86-64)))

;;; Size of the smallest instruction unit: text length is a multiple of it, text
;;; alignment is at least it, and instruction relocations sit on its boundaries.
(defn text-unit [(machine i32)] (-> i64)
  (if (= machine X86-64) 1 4))

;;; Bytes a relocation of `kind` patches.
(defn relocation-width [(kind i32)] (-> i64)
  (if (= kind ABS64) 8 4))

(defn kind-for-machine? [(machine i32) (kind i32)] (-> bool)
  (or (= kind ABS64)
      (and (= machine AARCH64) (>= kind A64-BRANCH26) (<= kind A64-PAGEOFF12))
      (and (= machine X86-64) (>= kind X64-PC32) (<= kind X64-PLT32))))

(defn valid-alignments? [(image Image)] (-> bool)
  (and (known-machine? (.machine image))
       (>= (.text-alignment image) (text-unit (.machine image)))
       (alignment/valid? (.text-alignment image))
       (>= (.data-alignment image) 8)
       (alignment/valid? (.data-alignment image))))

;;; Requirements only increase; lowering one could invalidate earlier objects.
(defn require-alignments! [(image (mut Image)) (text i64) (data i64)]
  (-> (Result i32 (slice u8)))
  (if (or (not (valid-alignments? image))
          (< text (text-unit (.machine image)))
          (< data 8)
          (not (alignment/valid? text))
          (not (alignment/valid? data)))
      (Err "invalid image section alignment")
      (do
        (set! (.text-alignment image)
              (alignment/maximum text (.text-alignment image)))
        (set! (.data-alignment image)
              (alignment/maximum data (.data-alignment image)))
        (Ok 0))))

;;; Reserve zeroed object storage, including alignment padding. The returned
;;; offset is section-relative; section alignment preserves it through linking.
(defn data-space! [(image (mut Image)) (size i64) (required i64)]
  (-> (Result i64 (slice u8)))
  (if (or (not (valid-alignments? image)) (< size 0))
      (Err "invalid image storage size or alignment")
      (match (alignment/up (len (.data image)) required)
        (Err [message] (Err message))
        (Ok [offset]
            (if (> size (- (: 0x7FFFFFFFFFFFFFFF i64) offset))
                (Err "image object size overflow")
                (let [end (+ offset size)]
                  (reserve! (mut (.data image)) end)
                  (while (< (len (.data image)) end)
                    (push! (mut (.data image)) 0))
                  (set! (.data-alignment image)
                        (alignment/maximum required (.data-alignment image)))
                  (Ok offset)))))))

(defn hash-name [(name (slice u8))] (-> u64)
  (let [(mut hash) (: 14695981039346656037 u64)]
    (let [items-101 name
          (mut for-index-101) (: 0 i64)]
      (while (< for-index-101 (len items-101))
        (let [byte (get items-101 for-index-101)]
          (set! hash
                (cast u64
                      (* (cast u128 (^ hash (cast u64 byte)))
                         (: 1099511628211 u128)))))
        (set! for-index-101 (+ for-index-101 1))))
    hash))

(defn same-name? [(image Image) (symbol Symbol) (name (slice u8))] (-> bool)
  (let [(mut equal?) (= (.length symbol) (len name))
        (mut i) 0]
    (while (and equal? (< i (len name)))
      (when (!= (get (.names image) (+ (.name symbol) i)) (get name i))
        (set! equal? false))
      (set! i (+ i 1)))
    equal?))

(defn find-symbol [(image Image) (name (slice u8))] (-> (Option i32))
  (let [(mut index) (: -1 i32)
        (mut found) (: -1 i32)]
    (match (get (.heads image) (hash-name name))
      (Some [id] (set! index id))
      (None [] 0))
    (while (and (>= index 0) (< found 0))
      (let [symbol (get (.symbols image) (cast i64 index))]
        (if (same-name? image symbol name)
            (set! found index)
            (set! index (.next symbol)))))
    (if (< found 0) (None) (Some found))))

;;; Reserve all public names first. Private names skip collisions deterministically.
(defn fresh-local! [(image (mut Image))
                    (section i32)
                    (offset i64)
                    (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [(mut name) (ArrayList::new [u8] allocator)
        (mut found?) false
        (mut exhausted?) false]
    (while (and (not found?) (not exhausted?))
      (clear! (mut name))
      (bytes/append-slice! (mut name) "L_stogir_")
      (let [sequence (.local-sequence image)
            (mut shift) (: 60 i32)]
        (while (>= shift 0)
          (let [digit (cast u8 (& (>> sequence (cast u64 shift)) 15))]
            (push! (mut name) (+ (if (< digit 10) (: 48 u8) (: 87 u8)) digit)))
          (set! shift (- shift 4)))
        (if (= sequence 0xFFFFFFFFFFFFFFFF)
            (set! exhausted? true)
            (set! (.local-sequence image) (+ sequence 1))))
      (match (find-symbol image (slice name))
        (None [] (set! found? true))
        (Some [_] 0)))
    (let [result
            (if found?
                (local-symbol! (mut image) (slice name) section offset)
                (Err [i32 (slice u8)] "private symbol name space exhausted"))]
      (free! (mut name))
      result)))

;;; Declare/intern a symbol; a later compatible definition may fill an undefined
;;; symbol without changing its ID or existing relocation references.
(defn symbol! [(image (mut Image)) (name (slice u8)) (section i32) (offset i64)]
  (-> (Result i32 (slice u8)))
  (symbol-with-binding! (mut image) name section offset true))

(defn local-symbol! [(image (mut Image))
                     (name (slice u8))
                     (section i32)
                     (offset i64)]
  (-> (Result i32 (slice u8)))
  (if (= section 0)
      (Err "local symbol requires a definition")
      (symbol-with-binding! (mut image) name section offset false)))

(defn symbol-with-binding! [(image (mut Image))
                            (name (slice u8))
                            (section i32)
                            (offset i64)
                            (global? bool)]
  (-> (Result i32 (slice u8)))
  (let [hash (hash-name name)
        (mut head) (: -1 i32)
        (mut found) (: -1 i32)
        (mut invalid?) (= (len name) 0)]
    (let [items-102 name
          (mut for-index-102) (: 0 i64)]
      (while (< for-index-102 (len items-102))
        (let [byte (get items-102 for-index-102)]
          (when (= byte 0) (set! invalid? true)))
        (set! for-index-102 (+ for-index-102 1))))
    (match (get (.heads image) hash)
      (Some [index] (set! head index))
      (None [] 0))
    (let [(mut index) head]
      (while (and (>= index 0) (< found 0))
        (let [symbol (get (.symbols image) (cast i64 index))]
          (if (same-name? image symbol name)
              (set! found index)
              (set! index (.next symbol))))))
    (if (or invalid?
            (< section 0)
            (> section 2)
            (< offset 0)
            (and (= section 0) (or (!= offset 0) (not global?))))
        (Err "invalid image symbol")
        (if (>= found 0)
            (let [(mut old) (get (.symbols image) (cast i64 found))]
              (if (or (!= (.global? old) global?)
                      (and (!= section 0)
                           (!= (.section old) 0)
                           (or (!= section (.section old))
                               (!= offset (.offset old)))))
                  (Err "conflicting symbol definition")
                  (do
                    (when (!= section 0)
                      (set! (.section old) section)
                      (set! (.offset old) offset)
                      (set! (mut (.symbols image)) (cast i64 found) old))
                    (Ok found))))
            (let [index (len (.symbols image))
                  name-offset (len (.names image))]
              (if (> index 2147483647)
                  (Err "symbol ID space exhausted")
                  (if (not (bytes/append-slice! (mut (.names image)) name))
                      (Err "symbol name arena exhausted")
                      (do
                        (push! (mut (.symbols image))
                               (Symbol
                                 :name name-offset
                                 :length (len name)
                                 :section section
                                 :offset offset
                                 :next head
                                 :global? global?))
                        (set! (mut (.heads image)) hash (cast i32 index))
                        (Ok (cast i32 index))))))))))

;;; Why `relocation` cannot belong to `image`, or Ok. Shared by `relocate!` and
;;; by every consumer that revalidates raw relocation records.
(defn check-relocation [(image Image) (relocation Relocation)]
  (-> (Result i32 (slice u8)))
  (let [kind (.kind relocation)
        section (.section relocation)]
    (if (not (known-machine? (.machine image)))
        (Err "unknown image machine")
        (if (or (< kind ABS64) (> kind X64-PLT32))
            (Err "unknown image relocation kind")
            (if (not (kind-for-machine? (.machine image) kind))
                (Err "relocation kind does not belong to the image machine")
                (if (or (< section 1)
                        (> section 2)
                        (< (.symbol relocation) 0)
                        (>= (cast i64 (.symbol relocation))
                            (len (.symbols image)))
                        (< (.offset relocation) 0)
                        (> (.offset relocation)
                           (- (if (= section 1)
                                  (len (.text image))
                                  (len (.data image)))
                              (relocation-width kind))))
                    (Err "invalid image relocation bounds or symbol")
                    (Ok 0)))))))

(defn relocate! [(image (mut Image)) (relocation Relocation)] (-> bool)
  (match (check-relocation image relocation)
    (Err [_] false)
    (Ok [_] (do (push! (mut (.relocations image)) relocation) true))))

(defn release! [(image (mut Image))] (-> void)
  (free! (mut (.text image)))
  (free! (mut (.text-data image)))
  (free! (mut (.data image)))
  (free! (mut (.names image)))
  (free! (mut (.symbols image)))
  (free! (mut (.heads image)))
  (free! (mut (.relocations image))))
