;;; Incremental fold/CSE/DCE kernel adapted from pinned ir_sccp.c:ir_iter_fold,
;;; ir_iter_replace_insn and ir_iter_find_cse. Control cleanup and promotion are
;;; separate pending parts of ir_iter_opt; this module does not claim full parity.
(module stogir.iter-fold)
(import "stogir.graph" :as g)
(import "stogir.dead-code" :as dead)
(import "stogir.iter-control" :as control)
(import "stogir.control-merge" :as boundaries)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "stogir.opcode" :as op)
(import "stogir.sccp-fold" :as fold)
(import "stogir.sccp-values" :as v)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.verify" :as verify)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "stogir.bitset" :as bits)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn foldable? [(opcode i32)] (-> bool)
  (and (>= opcode 14) (<= opcode 68)))

;;; Exact expression CSE searches the smallest positive input's bucket, as
;;; upstream does. Earlier references win; later duplicates are put on the queue.
;;; The full node words include guards and prototype/flag metadata.
(defn find-cse! [(graph g/Graph)
                 (lists uses/Uses)
                 (queue (mut q/Queue))
                 (reference i32)] (-> i32)
  (let [node (get (.instructions graph) (cast i64 reference))
        count (get (.arities graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        (mut selected) (: 0 i32)
        (mut size) (: 0 i64)
        (mut found) (: 0 i32)]
    (for [i 1 (+ (cast i64 count) 1)]
      (when (uses/edge-code? (op/operand-code opcode (cast i32 i)))
        (match (g/operand graph reference (cast i32 i))
          (Some [input]
                (when (> input 0)
                  (let [range (get (.ranges lists) (cast i64 input))]
                    (when (or (= selected 0) (< (.count range) size))
                      (set! selected input)
                      (set! size (.count range))))))
          (None [] 0))))
    (when (> selected 0)
      (let [range (get (.ranges lists) (cast i64 selected))]
        (for [i (.offset range) (+ (.offset range) (.count range))]
          (let [user (.user (get (.edges lists) i))
                other (get (.instructions graph) (cast i64 user))]
            (when (and (!= user reference)
                       (= (& (.header node) 65535) (& (.header other) 65535))
                       (= (.op1 node) (.op1 other))
                       (= (.op2 node) (.op2 other))
                       (= (.op3 node) (.op3 other)))
              (if (< user reference)
                  (when (or (= found 0) (< user found)) (set! found user))
                  (q/add! (mut queue) (cast i64 user))))))))
    found))

;;; Detach all original inputs before changing the allocation. Removal can make
;;; former inputs dead; processing those references is deduplicated by the queue.
(defn detach! [(graph g/Graph)
               (lists (mut uses/Uses))
               (queue (mut q/Queue))
               (reference i32)] (-> void)
  (let [opcode
          (cast i32 (n/opcode (get (.instructions graph) (cast i64 reference))))
        count (get (.arities graph) (cast i64 reference))]
    (for [i 1 (+ (cast i64 count) 1)]
      (when (uses/edge-code? (op/operand-code opcode (cast i32 i)))
        (match (g/operand graph reference (cast i32 i))
          (Some [input]
                (when (> input 0)
                  (when (not (uses/remove! (mut lists)
                                           input
                                           (uses/Use
                                             :user reference
                                             :operand (cast i32 i))))
                    (panic "iterative input edge missing"))
                  (q/add! (mut queue) (cast i64 input))))
          (None [] (panic "iterative input operand missing")))))))

;;; Redirect exact edges one at a time and re-read buckets after each add: adding
;;; a use of the replacement may relocate/reallocate the shared edge buffer.
(defn replace! [(graph (mut g/Graph))
                (lists (mut uses/Uses))
                (queue (mut q/Queue))
                (protected bits/Bits)
                (reference i32)
                (replacement i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        rooted (bits/contains? protected (cast i64 reference))
        canonical
          (and rooted
               (= (n/opcode node) 68)
               (= (.op1 node) replacement)
               (= (.op2 node) 0))]
    (if (or (= reference replacement) canonical)
        false
        (do
          (detach! graph (mut lists) (mut queue) reference)
          (while (> (.count (get (.ranges lists) (cast i64 reference))) 0)
            (let [range (get (.ranges lists) (cast i64 reference))
                  edge (get (.edges lists) (.offset range))]
              (when (= (.user edge) reference)
                (panic "iterative self replacement"))
              (when (not (g/set-operand! (mut graph)
                                         (.user edge)
                                         (.operand edge)
                                         replacement))
                (panic "iterative user operand missing"))
              (uses/remove! (mut lists) reference edge)
              (when (> replacement 0) (uses/add! (mut lists) replacement edge))
              (q/add! (mut queue) (cast i64 (.user edge)))))
          (if rooted
              (do
                (when (not (g/rewrite-inputs! (mut graph)
                                              reference
                                              68
                                              (n/type-id node)
                                              [replacement (: 0 i32)]))
                  (panic "iterative root COPY allocation failed"))
                (when (> replacement 0)
                  (uses/add! (mut lists)
                             replacement
                             (uses/Use :user reference :operand 1))))
              (when (not (g/make-nop! (mut graph) reference))
                (panic "iterative NOP allocation failed")))
          true))))

(defn rewrite-expression! [(graph (mut g/Graph))
                           (lists (mut uses/Uses))
                           (queue (mut q/Queue))
                           (reference i32)
                           (opcode u8)
                           (type u8)
                           (inputs (slice i32))] (-> bool)
  (detach! graph (mut lists) (mut queue) reference)
  (unless (g/rewrite-inputs! (mut graph) reference opcode type inputs)
    (panic "iterative expression restart allocation failed"))
  (for [i 0 (len inputs)]
    (let [input (get inputs i)]
      (when (> input 0)
        (uses/add! (mut lists)
                   input
                   (uses/Use :user reference :operand (cast i32 (+ i 1)))))))
  (q/add! (mut queue) (cast i64 reference))
  (let [range (get (.ranges lists) (cast i64 reference))]
    (for [i (.offset range) (+ (.offset range) (.count range))]
      (q/add! (mut queue) (cast i64 (.user (get (.edges lists) i))))))
  true)

(defn rewrite-unary! [(graph (mut g/Graph))
                      (lists (mut uses/Uses))
                      (queue (mut q/Queue))
                      (reference i32)
                      (opcode u8)
                      (type u8)
                      (input i32)] (-> bool)
  (rewrite-expression! (mut graph)
                       (mut lists)
                       (mut queue)
                       reference
                       opcode
                       type
                       [input]))

;;; Pinned ir_fold.h NOT(integer comparison): invert the predicate, retaining
;;; its operands. Float predicates deliberately stay unchanged (NaN semantics).
;;; Rewriting only the NOT cell preserves shared and observed comparisons.
(defn not-compare! [(graph (mut g/Graph))
                    (lists (mut uses/Uses))
                    (queue (mut q/Queue))
                    (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        input (.op1 node)]
    (if (and (= (n/opcode node) 45) (= (n/type-id node) 1) (> input 0))
        (let [comparison (get (.instructions graph) (cast i64 input))
              opcode (n/opcode comparison)
              left (.op1 comparison)
              right (.op2 comparison)]
          (if (and (>= opcode 14)
                   (<= opcode 23)
                   (= (n/type-id comparison) 1))
              (match (g/lookup graph left)
                (None [] false)
                (Some [operand]
                      (if (types/integer? (cast i32 (n/type-id operand)))
                          (rewrite-expression! (mut graph)
                                               (mut lists)
                                               (mut queue)
                                               reference
                                               (^ opcode (: 1 u8))
                                               1
                                               [left right])
                          false)))
              false))
        false)))

;;; Pinned ir_fold.h COND(Boolean, 1, 0) and Boolean false/true arms.
;;; Keep the original result type: byte results need BITCAST, wider integers
;;; need ZEXT. No new graph cells or repeated graph analysis are needed.
(defn boolean-choice! [(graph (mut g/Graph))
                       (lists (mut uses/Uses))
                       (queue (mut q/Queue))
                       (protected bits/Bits)
                       (reference i32)
                       (pointer-bytes i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        type (n/type-id node)
        source (.op1 node)
        yes (.op2 node)
        no (.op3 node)
        (mut changed) false]
    (when (and (= (n/opcode node) 60)
               (types/integer? (cast i32 type))
               (> source 0)
               (< yes 0)
               (< no 0))
      (let [condition (get (.instructions graph) (cast i64 source))
            first (fold/structural-value graph yes)
            second (fold/structural-value graph no)]
        (when (and (= (n/type-id condition) 1)
                   (symbols/numeric? first)
                   (symbols/numeric? second)
                   (= (n/type-id first) type)
                   (= (n/type-id second) type))
          (cond (and (= (n/constant-bits first) 1)
                     (= (n/constant-bits second) 0))
                  (set! changed
                        (if (= type 1)
                            (replace! (mut graph)
                                      (mut lists)
                                      (mut queue)
                                      protected
                                      reference
                                      source)
                            (rewrite-unary! (mut graph)
                                            (mut lists)
                                            (mut queue)
                                            reference
                                            (if (> (types/scalar-size (cast i32
                                                                            type)
                                                                      pointer-bytes)
                                                   1)
                                                34
                                                36)
                                            type
                                            source)))
                (and (= type 1)
                     (= (n/constant-bits first) 0)
                     (= (n/constant-bits second) 1))
                  (set! changed
                        (rewrite-unary! (mut graph)
                                        (mut lists)
                                        (mut queue)
                                        reference
                                        45
                                        1
                                        source))
                :else 0))))
    changed))

;;; Pinned ir_fold.h EQ/NE(C_BOOL), and its explicit BOOL special case
;;; for EQ/NE(SEXT/ZEXT, literal). Other extension/range rules stay separate.
(defn boolean-compare! [(graph (mut g/Graph))
                        (lists (mut uses/Uses))
                        (queue (mut q/Queue))
                        (protected bits/Bits)
                        (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (n/opcode node)
        left (.op1 node)
        right (.op2 node)
        (mut source) (: 0 i32)
        (mut changed) false]
    (when (and (or (= opcode 14) (= opcode 15))
               (= (n/type-id node) 1)
               (> left 0)
               (< right 0))
      (let [value (get (.instructions graph) (cast i64 left))]
        (match (g/lookup graph right)
          (None [] 0)
          (Some [literal]
                (when (and (symbols/numeric? literal)
                           (= (n/type-id literal) (n/type-id value))
                           (<= (n/constant-bits literal) 1))
                  (if (= (n/type-id value) 1)
                      (set! source left)
                      (when (and (or (= (n/opcode value) 33)
                                     (= (n/opcode value) 34))
                                 (= (.count (get (.ranges lists)
                                                 (cast i64 left)))
                                    1)
                                 (not (bits/contains? protected (cast i64 left))))
                        (match (g/lookup graph (.op1 value))
                          (Some [base]
                                (when (= (n/type-id base) 1)
                                  (set! source (.op1 value))))
                          (None [] 0))))
                  (when (!= source 0)
                    (if (= (= opcode 14) (= (n/constant-bits literal) 1))
                        (set! changed
                              (replace! (mut graph)
                                        (mut lists)
                                        (mut queue)
                                        protected
                                        reference
                                        source))
                        (set! changed
                              (rewrite-unary! (mut graph)
                                              (mut lists)
                                              (mut queue)
                                              reference
                                              45
                                              1
                                              source)))))))))
    changed))

;;; Nested scalar conversion restart rules from pinned ir_fold.h. BOOL's
;;; canonicalization is an explicit boundary: no rule crosses a BOOL view.
;;; Instruction IDs/types and rooted observations remain stable; uses are
;;; updated before affected consumers return to the ordinary worklist.
(defn conversion-restart! [(graph (mut g/Graph))
                           (lists (mut uses/Uses))
                           (queue (mut q/Queue))
                           (protected bits/Bits)
                           (reference i32)
                           (pointer-bytes i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (n/opcode node)
        type (n/type-id node)
        middle (.op1 node)
        (mut changed) false]
    (when (and (>= opcode 33)
               (<= opcode 36)
               (> middle 0)
               (types/valid-scalar? (cast i32 type))
               (> type 1))
      (let [inner (get (.instructions graph) (cast i64 middle))
            inner-op (n/opcode inner)
            inner-type (n/type-id inner)
            base (.op1 inner)]
        (when (and (types/valid-scalar? (cast i32 inner-type)) (> inner-type 1))
          (match (g/lookup graph base)
            (None [] 0)
            (Some [source]
                  (let [source-type (n/type-id source)
                        from
                          (types/scalar-size (cast i32 source-type)
                                             pointer-bytes)
                        to (types/scalar-size (cast i32 type) pointer-bytes)
                        integers
                          (and (types/integer? (cast i32 type))
                               (types/integer? (cast i32 source-type)))
                        (mut next-op) opcode
                        (mut next-input) middle
                        (mut copied) (: 0 i32)]
                    (when (and (types/valid-scalar? (cast i32 source-type))
                               (> source-type 1))
                      (cond (and (= opcode 35)
                                 (or (= inner-op 33) (= inner-op 34))
                                 integers)
                              (if (= source-type type)
                                  (set! copied base)
                                  (do
                                    (set! next-input base)
                                    (set! next-op
                                          (if (= from to)
                                              36
                                              (if (> from to) 35 inner-op)))))
                            (and (= inner-op 36)
                                 (or (= opcode 33) (= opcode 34) (= opcode 35))
                                 integers)
                              (set! next-input base)
                            (and (= opcode 36) (= inner-op 36))
                              (if (= source-type type)
                                  (set! copied base)
                                  (set! next-input base))
                            (and (= opcode inner-op)
                                 (or (= opcode 33) (= opcode 34) (= opcode 35)))
                              (set! next-input base)
                            (and (= opcode 33) (= inner-op 34))
                              (do (set! next-op 34) (set! next-input base))
                            :else 0)
                      (when (and (= opcode 33)
                                 (or (= inner-op 47) (= inner-op 50)))
                        (match (g/lookup graph (.op2 inner))
                          (None [] 0)
                          (Some [amount]
                                (when (and (types/integer? (cast i32
                                                                 (n/type-id amount)))
                                           (= (n/opcode amount)
                                              (n/type-id amount)))
                                  (let [width
                                          (* 8
                                             (types/scalar-size (cast i32
                                                                      inner-type)
                                                                pointer-bytes))
                                        bits (n/constant-bits amount)]
                                    (when (or (and (= inner-op 47)
                                                   (= (& bits
                                                         (<< (: 1 u64)
                                                             (cast u64
                                                                   (- width 1))))
                                                      0))
                                              (and (= inner-op 50)
                                                   (!= (& bits
                                                          (cast u64 (- width 1)))
                                                       0)))
                                      (set! next-op 34)))))))
                      (if (!= copied 0)
                          (set! changed
                                (replace! (mut graph)
                                          (mut lists)
                                          (mut queue)
                                          protected
                                          reference
                                          copied))
                          (when (or (!= next-op opcode) (!= next-input middle))
                            (set! changed
                                  (rewrite-unary! (mut graph)
                                                  (mut lists)
                                                  (mut queue)
                                                  reference
                                                  next-op
                                                  type
                                                  next-input)))))))))))
    changed))

;;; Independent typed identity: sign-extending a truncated high field is an
;;; arithmetic right shift of the original word. Reuse the private TRUNC cell
;;; as SAR; its width can change only when the extension is its sole use and
;;; it is not rooted. A final BITCAST retains the extension's signed type.
(defn extend-high! [(graph (mut g/Graph))
                    (lists (mut uses/Uses))
                    (queue (mut q/Queue))
                    (protected bits/Bits)
                    (reference i32)
                    (pointer-bytes i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        middle (.op1 node)
        (mut changed) false]
    (when (and (= (n/opcode node) 33)
               (> middle 0)
               (= (.count (get (.ranges lists) (cast i64 middle))) 1)
               (not (bits/contains? protected (cast i64 middle))))
      (let [trunc (get (.instructions graph) (cast i64 middle))
            shift (.op1 trunc)]
        (when (and (= (n/opcode trunc) 35) (> shift 0))
          (let [producer (get (.instructions graph) (cast i64 shift))
                source-type (n/type-id producer)
                wide (types/size (cast i32 source-type) pointer-bytes)
                narrow (types/size (cast i32 (n/type-id trunc)) pointer-bytes)
                target (n/type-id node)]
            (when (and (= (n/opcode producer) 50)
                       (types/integer? (cast i32 source-type))
                       (!= source-type 1)
                       (!= source-type 6)
                       (types/integer? (cast i32 (n/type-id trunc)))
                       (!= (n/type-id trunc) 1)
                       (!= (n/type-id trunc) 6)
                       (types/integer? (cast i32 target))
                       (!= target 1)
                       (!= target 6)
                       (= wide (types/size (cast i32 target) pointer-bytes))
                       (> narrow 0)
                       (> wide narrow)
                       (< (.op2 producer) 0))
              (match (g/lookup graph (.op2 producer))
                (Some [amount]
                      (when (and (symbols/numeric? amount)
                                 (= (n/constant-bits amount)
                                    (cast u64 (* (- wide narrow) 8))))
                        (detach! graph (mut lists) (mut queue) reference)
                        (detach! graph (mut lists) (mut queue) middle)
                        (unless (g/rewrite-inputs! (mut graph)
                                                   middle
                                                   51
                                                   source-type
                                                   [(.op1 producer)
                                                    (.op2 producer)])
                          (panic "high-field shift rewrite failed"))
                        (unless (g/rewrite-inputs! (mut graph)
                                                   reference
                                                   36
                                                   target
                                                   [middle])
                          (panic "high-field view rewrite failed"))
                        (for [i 1 3]
                          (match (g/operand graph middle (cast i32 i))
                            (Some [input]
                                  (when (> input 0)
                                    (uses/add! (mut lists)
                                               input
                                               (uses/Use
                                                 :user middle
                                                 :operand (cast i32 i)))))
                            (None [] (panic "high-field operand missing"))))
                        (uses/add! (mut lists)
                                   middle
                                   (uses/Use :user reference :operand 1))
                        (q/add! (mut queue) (cast i64 middle))
                        (set! changed true)))
                (None [] 0)))))))
    changed))

;;; Caller owns graph/lists/queue. Only seeded nodes and users/inputs affected by
;;; changes are visited. Bottom facts expose current graph values to the shared
;;; fold rules; no second SCCP analysis or persistent alternative IR is built.
(defstruct Progress [(changes i32) (control bool)])

(defn run-core! [(graph (mut g/Graph))
                 (lists (mut uses/Uses))
                 (queue (mut q/Queue))
                 (protected bits/Bits)
                 (pointer-bytes i32)
                 (fold-control bool)
                 (a (dyn Allocator))]
  (-> (Result Progress (slice u8)))
  (let [(mut domain) (v/create (len (.instructions graph)) a)
        (mut changes) (: 0 i32)
        (mut control-changed) false
        (mut dead-context) (zeroed dead/Context)
        (mut error) ""
        (mut next) (q/pop! (mut queue))]
    (for [i 1 (len (.instructions graph))]
      (v/kind! (mut domain) (cast i32 i) 131))
    (while (and (>= next 0) (= error ""))
      (when (and fold-control
                 (control/fold-if! (mut graph)
                                   (mut lists)
                                   (mut queue)
                                   (cast i32 next)))
        (set! changes (+ changes 1))
        (set! control-changed true))
      (let [opcode (n/opcode (get (.instructions graph) next))
            changed
              (cond (= opcode 60)
                      (boolean-choice! (mut graph)
                                       (mut lists)
                                       (mut queue)
                                       protected
                                       (cast i32 next)
                                       pointer-bytes)
                    (= opcode 45)
                      (not-compare! (mut graph)
                                    (mut lists)
                                    (mut queue)
                                    (cast i32 next))
                    (or (= opcode 14) (= opcode 15))
                      (boolean-compare! (mut graph)
                                        (mut lists)
                                        (mut queue)
                                        protected
                                        (cast i32 next))
                    :else false)]
        (when changed (set! changes (+ changes 1))))
      (when (conversion-restart! (mut graph)
                                 (mut lists)
                                 (mut queue)
                                 protected
                                 (cast i32 next)
                                 pointer-bytes)
        (set! changes (+ changes 1)))
      (when (extend-high! (mut graph)
                          (mut lists)
                          (mut queue)
                          protected
                          (cast i32 next)
                          pointer-bytes)
        (set! changes (+ changes 1)))
      (when (dead/remove! (mut graph)
                          (mut lists)
                          (mut queue)
                          protected
                          (mut dead-context)
                          (cast i32 next))
        (set! changes (+ changes 1)))
      (let [reference (cast i32 next)
            node (get (.instructions graph) next)
            opcode (cast i32 (n/opcode node))]
        (when (and (foldable? opcode) (!= opcode 67))
          (match (fold/evaluate graph domain reference pointer-bytes)
            (Err [message] (set! error message))
            (Ok [decision]
                (let [(mut replacement) (: 0 i32)]
                  (match (.kind decision)
                    (1 (let [value (.constant decision)]
                         (match (g/intern-constant! (mut graph)
                                                    (n/opcode value)
                                                    (n/type-id value)
                                                    0
                                                    (n/constant-bits value))
                           (Some [r] (set! replacement r))
                           (None []
                                 (set! error
                                       "iterative constant reference space exhausted")))))
                    (2 (set! replacement (.source decision)))
                    (3 (set! replacement
                             (find-cse! graph lists (mut queue) reference)))
                    (_ 0))
                  (when (and (!= replacement 0) (= error ""))
                    (when (replace! (mut graph)
                                    (mut lists)
                                    (mut queue)
                                    protected
                                    reference
                                    replacement)
                      (set! changes (+ changes 1)))))))))
      (set! next (q/pop! (mut queue))))
    (v/release! (mut domain))
    (if (= error "")
        (Ok (Progress :changes changes :control control-changed))
        (Err error))))

;;; Scalar-only compatibility entry. This does not expose transient control
;;; graphs to callers that supply protection bits without a mutable root list.
(defn run! [(graph (mut g/Graph))
            (lists (mut uses/Uses))
            (queue (mut q/Queue))
            (protected bits/Bits)
            (pointer-bytes i32)
            (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (run-core! (mut graph)
                    (mut lists)
                    (mut queue)
                    protected
                    pointer-bytes
                    false
                    a)
    (Err [message] (Err message))
    (Ok [progress] (Ok (.changes progress)))))

;;; Roots and protection bits must name the same observation set. Finish late
;;; control changes at the same reachability boundary as upstream CFG construction. Rebuild only control reachability, then drain affected
;;; scalar folds after merge/Phi repair. No repeated SCCP analysis is performed.
(defn run-rooted! [(graph (mut g/Graph))
                   (roots (mut (ArrayList i32)))
                   (lists (mut uses/Uses))
                   (queue (mut q/Queue))
                   (protected (mut bits/Bits))
                   (pointer-bytes i32)
                   (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (run-core! (mut graph)
                    (mut lists)
                    (mut queue)
                    protected
                    pointer-bytes
                    true
                    a)
    (Err [message] (Err message))
    (Ok [progress]
        (if (not (.control progress))
            (Ok (.changes progress))
            (match (control/prune! (mut graph)
                                   (mut roots)
                                   (mut lists)
                                   (mut queue)
                                   (mut protected)
                                   a)
              (Err [message] (Err message))
              (Ok [pruned]
                  (let [merged
                          (boundaries/merge! (mut graph)
                                             (mut roots)
                                             (mut lists)
                                             (mut queue)
                                             a)]
                    ; Boundary removal remaps control observations.
                    (bits/clear! (mut protected))
                    (for root roots (bits/add! (mut protected) (cast i64 root)))
                    (match (run-core! (mut graph)
                                      (mut lists)
                                      (mut queue)
                                      protected
                                      pointer-bytes
                                      false
                                      a)
                      (Err [message] (Err message))
                      (Ok [after]
                          (Ok (+ (+ (.changes progress) pruned)
                                 (+ merged (.changes after)))))))))))))

;;; Transactional public entry: validate first, transform an owned graph, validate
;;; again, and discard failed output. Roots keep their positive references through
;;; COPY nodes. All structural analyses must be rebuilt after successful edits.
(defn optimize [(source g/Graph)
                (pointer-bytes i32)
                (roots (slice i32))
                (seeds (slice i32))
                (a (dyn Allocator))]
  (-> (Result rewrite/Rewritten (slice u8)))
  (let [(mut error) ""]
    (when (not (or (= pointer-bytes 4) (= pointer-bytes 8)))
      (set! error "iterative pointer width must be four or eight"))
    (when (= error "")
      (match (rewrite/validate source pointer-bytes a)
        (Err [message] (set! error message))
        (Ok [_] 0)))
    (for r roots
      (when (or (<= r 0) (not (g/contains? source r)))
        (set! error "iterative root is not an instruction")))
    (for r seeds
      (when (or (<= r 0) (not (g/contains? source r)))
        (set! error "iterative seed is not an instruction")))
    (if (!= error "")
        (Err error)
        (let [(mut graph) (g/duplicate source a)
              (mut lists) (uses/build graph a)
              (mut queue) (q/create (len (.instructions graph)) a)
              (mut protected) (bits/create (len (.instructions graph)) a)
              (mut output-roots) (ArrayList::new [i32] a)
              (mut changes) (: 0 i32)]
          (for r roots
            (bits/add! (mut protected) (cast i64 r))
            (push! (mut output-roots) r))
          (for r seeds (q/add! (mut queue) (cast i64 r)))
          (match (run-rooted! (mut graph)
                              (mut output-roots)
                              (mut lists)
                              (mut queue)
                              (mut protected)
                              pointer-bytes
                              a)
            (Err [message] (set! error message))
            (Ok [count] (set! changes count)))
          (when (= error "")
            (match (rewrite/validate graph pointer-bytes a)
              (Err [message] (set! error message))
              (Ok [_] 0)))
          (uses/release! (mut lists))
          (bits/release! (mut protected))
          (if (= error "")
              (Ok (rewrite/Rewritten
                    :graph graph
                    :roots output-roots
                    :changes changes
                    :iteration queue))
              (do
                (g/release! (mut graph))
                (free! (mut output-roots))
                (q/release! (mut queue))
                (Err error)))))))
