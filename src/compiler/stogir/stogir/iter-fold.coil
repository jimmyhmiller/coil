;;; Incremental fold/CSE/DCE kernel adapted from pinned ir_sccp.c:ir_iter_fold,
;;; ir_iter_replace_insn and ir_iter_find_cse. Control cleanup and promotion are
;;; supported incrementally, including guarded backward modular integer widths;
;;; broader predicate/loop and range-dependent type promotion remains pending.
(module stogir.iter-fold)
(import "stogir.finite-countdown" :as countdown)
(import "stogir.memory-countdown" :as memory-countdown)
(import "stogir.graph" :as g)
(import "stogir.boolean-diamond" :as diamond)
(import "stogir.iter-constant-cse" :as literal-cse)
(import "stogir.iter-memory" :as memory)
(import "stogir.dead-code" :as dead)
(import "stogir.iter-control" :as control)
(import "stogir.control-merge" :as boundaries)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.conversion" :as conversion)
(import "stogir.symbols" :as symbols)
(import "stogir.opcode" :as op)
(import "stogir.sccp-fold" :as fold)
(import "stogir.fold" :as structural)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.verify" :as verify)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "stogir.bitset" :as bits)
(import "coil.slice" :use [subslice])
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Option Some None])

(defn foldable? [(opcode i32)] (-> bool)
  (and (>= opcode 14) (<= opcode 68)))

;;; Exact expression CSE searches the smallest positive input's bucket, as
;;; upstream does. Earlier references win; later duplicates are put on the queue.
;;; The full node words include guards and prototype/flag metadata.
(defn find-cse! [(graph g/Graph)
                 (lists uses/Uses)
                 (queue (mut q/Queue))
                 (reference i32)] (-> i32)
  (let [node (get (.instructions graph) (cast i64 reference))
        count (get (.arities graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        (mut selected) (: 0 i32)
        (mut size) (: 0 i64)
        (mut found) (: 0 i32)]
    (for [i 1 (+ (cast i64 count) 1)]
      (when (uses/edge-code? (op/operand-code opcode (cast i32 i)))
        (match (g/operand graph reference (cast i32 i))
          (Some [input]
                (when (> input 0)
                  (let [range (get (.ranges lists) (cast i64 input))]
                    (when (or (= selected 0) (< (.count range) size))
                      (set! selected input)
                      (set! size (.count range))))))
          (None [] 0))))
    (when (> selected 0)
      (let [range (get (.ranges lists) (cast i64 selected))]
        (for [i (.offset range) (+ (.offset range) (.count range))]
          (let [user (.user (get (.edges lists) i))
                other (get (.instructions graph) (cast i64 user))]
            (when (and (!= user reference)
                       (= (& (.header node) 65535) (& (.header other) 65535))
                       (= (.op1 node) (.op1 other))
                       (= (.op2 node) (.op2 other))
                       (= (.op3 node) (.op3 other)))
              (if (< user reference)
                  (when (or (= found 0) (< user found)) (set! found user))
                  (q/add! (mut queue) (cast i64 user))))))))
    found))

;;; Detach all original inputs before changing the allocation. Removal can make
;;; former inputs dead; processing those references is deduplicated by the queue.
(defn detach! [(graph g/Graph)
               (lists (mut uses/Uses))
               (queue (mut q/Queue))
               (reference i32)] (-> void)
  (let [opcode
          (cast i32 (n/opcode (get (.instructions graph) (cast i64 reference))))
        count (get (.arities graph) (cast i64 reference))]
    (for [i 1 (+ (cast i64 count) 1)]
      (when (uses/edge-code? (op/operand-code opcode (cast i32 i)))
        (match (g/operand graph reference (cast i32 i))
          (Some [input]
                (when (> input 0)
                  (when (not (uses/remove! (mut lists)
                                           input
                                           (uses/Use
                                             :user reference
                                             :operand (cast i32 i))))
                    (panic "iterative input edge missing"))
                  (q/add! (mut queue) (cast i64 input))))
          (None [] (panic "iterative input operand missing")))))))

;;; Redirect exact edges one at a time and re-read buckets after each add: adding
;;; a use of the replacement may relocate/reallocate the shared edge buffer.
(defn replace! [(graph (mut g/Graph))
                (lists (mut uses/Uses))
                (queue (mut q/Queue))
                (protected bits/Bits)
                (reference i32)
                (replacement i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        rooted (bits/contains? protected (cast i64 reference))
        canonical
          (and rooted
               (= (n/opcode node) 68)
               (= (.op1 node) replacement)
               (= (.op2 node) 0))]
    (if (or (= reference replacement) canonical)
        false
        (do
          (detach! graph (mut lists) (mut queue) reference)
          (while (> (.count (get (.ranges lists) (cast i64 reference))) 0)
            (let [range (get (.ranges lists) (cast i64 reference))
                  edge (get (.edges lists) (.offset range))]
              (when (= (.user edge) reference)
                (panic "iterative self replacement"))
              (when (not (g/set-operand! (mut graph)
                                         (.user edge)
                                         (.operand edge)
                                         replacement))
                (panic "iterative user operand missing"))
              (uses/remove! (mut lists) reference edge)
              (when (> replacement 0) (uses/add! (mut lists) replacement edge))
              (q/add! (mut queue) (cast i64 (.user edge)))))
          (if rooted
              (do
                (when (not (g/rewrite-inputs! (mut graph)
                                              reference
                                              68
                                              (n/type-id node)
                                              [replacement (: 0 i32)]))
                  (panic "iterative root COPY allocation failed"))
                (when (> replacement 0)
                  (uses/add! (mut lists)
                             replacement
                             (uses/Use :user reference :operand 1))))
              (when (not (g/make-nop! (mut graph) reference))
                (panic "iterative NOP allocation failed")))
          true))))

;;; Identity-only Phi cleanup after other affected-node rewrites. All nonself
;;; inputs must be the exact same reference; no value/range facts are inferred.
;;; All-self cycles retain their definition. No CFG or feasibility is changed.
(defn phi-source [(graph g/Graph) (reference i32)] (-> i32)
  (let [(mut source) (: 0 i32) (mut equal?) true (mut i) (: 2 i32)
        count (get (.arities graph) (cast i64 reference))]
    (while (and equal? (<= i count))
      (match (g/operand graph reference (cast i32 i))
        (None [] (set! equal? false))
        (Some [value]
          (unless (= value reference)
            (if (= source 0) (set! source value)
                (unless (= source value) (set! equal? false))))))
      (set! i (+ i 1)))
    (if equal? source 0)))

(defn rewrite-expression! [(graph (mut g/Graph))
                           (lists (mut uses/Uses))
                           (queue (mut q/Queue))
                           (reference i32)
                           (opcode u8)
                           (type u8)
                           (inputs (slice i32))] (-> bool)
  (detach! graph (mut lists) (mut queue) reference)
  (unless (g/rewrite-inputs! (mut graph) reference opcode type inputs)
    (panic "iterative expression restart allocation failed"))
  (for [i 0 (len inputs)]
    (let [input (get inputs i)]
      (when (> input 0)
        (uses/add! (mut lists)
                   input
                   (uses/Use :user reference :operand (cast i32 (+ i 1)))))))
  (q/add! (mut queue) (cast i64 reference))
  (let [range (get (.ranges lists) (cast i64 reference))]
    (for [i (.offset range) (+ (.offset range) (.count range))]
      (q/add! (mut queue) (cast i64 (.user (get (.edges lists) i))))))
  true)

(defn rewrite-unary! [(graph (mut g/Graph))
                      (lists (mut uses/Uses))
                      (queue (mut q/Queue))
                      (reference i32)
                      (opcode u8)
                      (type u8)
                      (input i32)] (-> bool)
  (rewrite-expression! (mut graph)
                       (mut lists)
                       (mut queue)
                       reference
                       opcode
                       type
                       [input]))

;;; Restart the same power rule used at construction. Ordinary edge mutation
;;; detaches the proven-unneeded guard and requeues the expression and users.
(defn power-division! [(graph (mut g/Graph))
                       (lists (mut uses/Uses))
                       (queue (mut q/Queue))
                       (reference i32)
                       (pointer-bytes i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))]
    (match (structural/power-division graph node pointer-bytes)
      (None [] false)
      (Some [plan]
            (let [constant
                    (match (g/intern-scalar! (mut graph) (n/type-id node)
                                             (.bits plan))
                      (Some [r] r)
                      (None [] (panic "division restart constant space exhausted")))]
              (rewrite-expression! (mut graph) (mut lists) (mut queue)
                                   reference (.opcode plan) (n/type-id node)
                                   [(.op1 node) constant]))))))

;;; Pinned ir_fold.h AND(ZEXT, full-source-mask). The zero extension
;;; already guarantees all higher bits are zero. Retain shared/rooted inputs.
(defn and-extension! [(graph (mut g/Graph))
                      (lists (mut uses/Uses))
                      (queue (mut q/Queue))
                      (protected bits/Bits)
                      (reference i32)
                      (pointer-bytes i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        (mut input) (.op1 node)
        (mut literal) (.op2 node)]
    (when (and (< input 0) (> literal 0))
      (set! input (.op2 node))
      (set! literal (.op1 node)))
    (if (and (= (n/opcode node) 47) (> input 0) (< literal 0))
        (let [extension (get (.instructions graph) (cast i64 input))]
          (if (and (= (n/opcode extension) 34)
                   (= (n/type-id extension) (n/type-id node)))
              (match (g/lookup graph (.op1 extension))
                (None [] false)
                (Some [source]
                      (match (g/lookup graph literal)
                        (None [] false)
                        (Some [mask]
                              (let [width
                                      (types/scalar-size (cast i32
                                                               (n/type-id source))
                                                         pointer-bytes)]
                                (if (and (types/integer? (cast i32
                                                               (n/type-id source)))
                                         (or (= width 1)
                                             (= width 2)
                                             (= width 4))
                                         (symbols/numeric? mask)
                                         (= (n/type-id mask) (n/type-id node))
                                         (= (n/constant-bits mask)
                                            (- (<< (: 1 u64)
                                                   (cast u64 (* width 8)))
                                               1)))
                                    (replace! (mut graph)
                                              (mut lists)
                                              (mut queue)
                                              protected
                                              reference
                                              input)
                                    false))))))
              false))
        false)))

;;; Pinned ir_fold.h NOT(integer comparison): invert the predicate, retaining
;;; its operands. Float predicates deliberately stay unchanged (NaN semantics).
;;; Rewriting only the NOT cell preserves shared and observed comparisons.
(defn not-compare! [(graph (mut g/Graph))
                    (lists (mut uses/Uses))
                    (queue (mut q/Queue))
                    (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        input (.op1 node)]
    (if (and (= (n/opcode node) 45) (= (n/type-id node) 1) (> input 0))
        (let [comparison (get (.instructions graph) (cast i64 input))
              opcode (n/opcode comparison)
              left (.op1 comparison)
              right (.op2 comparison)]
          (if (and (>= opcode 14)
                   (<= opcode 23)
                   (= (n/type-id comparison) 1))
              (match (g/lookup graph left)
                (None [] false)
                (Some [operand]
                      (if (types/integer? (cast i32 (n/type-id operand)))
                          (rewrite-expression! (mut graph)
                                               (mut lists)
                                               (mut queue)
                                               reference
                                               (^ opcode (: 1 u8))
                                               1
                                               [left right])
                          false)))
              false))
        false)))

(defstruct TestedBit [(value i32) (mask u64) (positive bool)])

;;; Independent local proof: a value whose allowed-bit mask has one bit is
;;; either zero or that bit. No transient SCCP facts participate in this proof.
(defn tested-bit [(graph g/Graph) (condition i32) (pointer-bytes i32)]
  (-> (Option TestedBit))
  (if (<= condition 0)
      (None)
      (let [comparison (get (.instructions graph) (cast i64 condition))
            opcode (n/opcode comparison)
            input (.op1 comparison)
            literal (.op2 comparison)]
        (if (and (or (= opcode 14) (= opcode 15))
                 (= (n/type-id comparison) 1)
                 (> input 0)
                 (< literal 0))
            (let [value (fold/structural-value graph input)
                  right (fold/structural-value graph literal)
                  type (cast i32 (n/type-id value))]
              (if (and (symbols/numeric? right)
                       (= (n/type-id right) (n/type-id value)))
                  (match (fold/comparison-mask graph value pointer-bytes)
                    (None [] (None))
                    (Some [mask]
                          (let [limit
                                  (& (n/constant-bits right)
                                     (fold/width-mask type pointer-bytes))]
                            (if (and (!= mask 0)
                                     (= (& mask (- mask 1)) 0)
                                     (or (= limit 0) (= limit mask)))
                                (Some (TestedBit
                                        :value input
                                        :mask mask
                                        :positive (= (= opcode 15) (= limit 0))))
                                (None)))))
                  (None)))
            (None)))))

(defn materialize-bit! [(graph (mut g/Graph))
                        (lists (mut uses/Uses))
                        (queue (mut q/Queue))
                        (protected bits/Bits)
                        (reference i32)
                        (type u8)
                        (value i32)
                        (pointer-bytes i32)] (-> bool)
  (let [from-type (n/type-id (get (.instructions graph) (cast i64 value)))
        from (types/scalar-size (cast i32 from-type) pointer-bytes)
        to (types/scalar-size (cast i32 type) pointer-bytes)]
    (if (= from-type type)
        (replace! (mut graph) (mut lists) (mut queue) protected reference value)
        (rewrite-unary! (mut graph)
                        (mut lists)
                        (mut queue)
                        reference
                        (if (= from to) 36 (if (< from to) 34 35))
                        type
                        value))))

;;; Reconstructing the tested bit with a select is the original masked value.
;;; Also remove Boolean-to-integer materialization of a positive bit-zero test
;;; when that tested value is already exactly zero/one.
(defn bit-choice! [(graph (mut g/Graph))
                   (lists (mut uses/Uses))
                   (queue (mut q/Queue))
                   (protected bits/Bits)
                   (reference i32)
                   (pointer-bytes i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (n/opcode node)
        type (n/type-id node)
        condition (.op1 node)
        yes (.op2 node)
        no (.op3 node)
        (mut changed) false]
    (when (and (types/integer? (cast i32 type))
               (or (= opcode 60) (= opcode 33) (= opcode 34) (= opcode 36)))
      (match (tested-bit graph condition pointer-bytes)
        (None [] 0)
        (Some [test]
              (let [mask (.mask test)
                    value (.value test)
                    positive (.positive test)]
                (when (and (= (& mask
                                 (fold/width-mask (cast i32 type) pointer-bytes))
                              mask)
                           (or (!= type 1) (= mask 1)))
                  (if (= opcode 60)
                      (when (and (< yes 0) (< no 0))
                        (let [first (fold/structural-value graph yes)
                              second (fold/structural-value graph no)]
                          (when (and (symbols/numeric? first)
                                     (symbols/numeric? second)
                                     (= (n/type-id first) type)
                                     (= (n/type-id second) type)
                                     (if positive
                                         (and (= (n/constant-bits first) mask)
                                              (= (n/constant-bits second) 0))
                                         (and (= (n/constant-bits first) 0)
                                              (= (n/constant-bits second) mask))))
                            (set! changed
                                  (materialize-bit! (mut graph)
                                                    (mut lists)
                                                    (mut queue)
                                                    protected
                                                    reference
                                                    type
                                                    value
                                                    pointer-bytes)))))
                      (when (and positive (= mask 1))
                        (set! changed
                              (materialize-bit! (mut graph)
                                                (mut lists)
                                                (mut queue)
                                                protected
                                                reference
                                                type
                                                value
                                                pointer-bytes)))))))))
    changed))

;;; COND selects on nonzero truth exactly like IF: canonicalize its condition
;;; with the same truth-preserving rule, exchanging the arms for an inversion.
;;; Rooted COND values keep their identity; only their inputs change.
(defn condition-choice! [(graph (mut g/Graph))
                         (lists (mut uses/Uses))
                         (queue (mut q/Queue))
                         (protected bits/Bits)
                         (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))]
    (if (or (!= (n/opcode node) 60)
            (<= (.op1 node) 0)
            (types/vector? (cast i32 (n/type-id node))))
        false
        (let [canonical (control/canonical-condition graph lists (.op1 node))]
          (if (and (not (.swap canonical)) (= (.reference canonical) (.op1 node)))
              false
              (rewrite-expression! (mut graph) (mut lists) (mut queue) reference 60
                                   (n/type-id node)
                                   [(.reference canonical)
                                    (if (.swap canonical) (.op3 node) (.op2 node))
                                    (if (.swap canonical) (.op2 node) (.op3 node))]))))))

;;; Pinned ir_fold.h COND(Boolean, 1, 0) and Boolean false/true arms.
;;; Keep the original result type: byte results need BITCAST, wider integers
;;; need ZEXT. No new graph cells or repeated graph analysis are needed.
(defn boolean-choice! [(graph (mut g/Graph))
                       (lists (mut uses/Uses))
                       (queue (mut q/Queue))
                       (protected bits/Bits)
                       (reference i32)
                       (pointer-bytes i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        type (n/type-id node)
        source (.op1 node)
        yes (.op2 node)
        no (.op3 node)
        (mut changed) false]
    (when (and (= (n/opcode node) 60)
               (types/integer? (cast i32 type))
               (> source 0)
               (< yes 0)
               (< no 0))
      (let [condition (get (.instructions graph) (cast i64 source))
            first (fold/structural-value graph yes)
            second (fold/structural-value graph no)]
        (when (and (= (n/type-id condition) 1)
                   (symbols/numeric? first)
                   (symbols/numeric? second)
                   (= (n/type-id first) type)
                   (= (n/type-id second) type))
          (cond (and (= (n/constant-bits first) 1)
                     (= (n/constant-bits second) 0))
                  (set! changed
                        (if (= type 1)
                            (replace! (mut graph)
                                      (mut lists)
                                      (mut queue)
                                      protected
                                      reference
                                      source)
                            (rewrite-unary! (mut graph)
                                            (mut lists)
                                            (mut queue)
                                            reference
                                            (if (> (types/scalar-size (cast i32
                                                                            type)
                                                                      pointer-bytes)
                                                   1)
                                                34
                                                36)
                                            type
                                            source)))
                (and (= type 1)
                     (= (n/constant-bits first) 0)
                     (= (n/constant-bits second) 1))
                  (set! changed
                        (rewrite-unary! (mut graph)
                                        (mut lists)
                                        (mut queue)
                                        reference
                                        45
                                        1
                                        source))
                :else 0))))
    changed))

;;; Pinned ir_fold.h EQ/NE(C_BOOL), and its explicit BOOL special case
;;; for EQ/NE(SEXT/ZEXT, literal). Other extension/range rules stay separate.
(defn boolean-compare! [(graph (mut g/Graph))
                        (lists (mut uses/Uses))
                        (queue (mut q/Queue))
                        (protected bits/Bits)
                        (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (n/opcode node)
        left (.op1 node)
        right (.op2 node)
        (mut source) (: 0 i32)
        (mut inverted) false
        (mut changed) false]
    (when (and (or (= opcode 14) (= opcode 15))
               (= (n/type-id node) 1)
               (> left 0)
               (< right 0))
      (let [value (get (.instructions graph) (cast i64 left))]
        (match (g/lookup graph right)
          (None [] 0)
          (Some [literal]
                (when (and (symbols/numeric? literal)
                           (= (n/type-id literal) (n/type-id value))
                           (<= (n/constant-bits literal) 1))
                  ;;; Independent exact 0/1 projection of a Boolean choice.
                  ;;; The COND can be shared/rooted: only its comparison changes.
                  (when (and (= (n/opcode value) 60)
                             (types/integer? (cast i32 (n/type-id value)))
                             (> (.op1 value) 0)
                             (< (.op2 value) 0)
                             (< (.op3 value) 0))
                    (let [condition (fold/structural-value graph (.op1 value))
                          yes (fold/structural-value graph (.op2 value))
                          no (fold/structural-value graph (.op3 value))]
                      (when (and (= (n/type-id condition) 1)
                                 (symbols/numeric? yes)
                                 (symbols/numeric? no)
                                 (= (n/type-id yes) (n/type-id value))
                                 (= (n/type-id no) (n/type-id value))
                                 (<= (n/constant-bits yes) 1)
                                 (<= (n/constant-bits no) 1)
                                 (!= (n/constant-bits yes) (n/constant-bits no)))
                        (set! source (.op1 value))
                        (set! inverted (= (n/constant-bits yes) 0)))))
                  (when (= source 0)
                    (if (= (n/type-id value) 1)
                        (set! source left)
                        (when (and (or (= (n/opcode value) 33)
                                       (= (n/opcode value) 34))
                                   (= (.count (get (.ranges lists)
                                                   (cast i64 left)))
                                      1)
                                   (not (bits/contains? protected
                                                        (cast i64 left))))
                          (match (g/lookup graph (.op1 value))
                            (Some [base]
                                  (when (= (n/type-id base) 1)
                                    (set! source (.op1 value))))
                            (None [] 0)))))
                  (when (!= source 0)
                    (if (!= (= (= opcode 14) (= (n/constant-bits literal) 1))
                            inverted)
                        (set! changed
                              (replace! (mut graph)
                                        (mut lists)
                                        (mut queue)
                                        protected
                                        reference
                                        source))
                        (set! changed
                              (rewrite-unary! (mut graph)
                                              (mut lists)
                                              (mut queue)
                                              reference
                                              45
                                              1
                                              source)))))))))
    changed))

;;; Boolean value of one integer PHI input: a 0/1 literal, COND(Boolean, 0/1,
;;; 1/0) or ZEXT(Boolean). Polarity false means the integer is the inverse.
(defstruct BooleanInput [(kind i32) (source i32) (positive bool) (bit bool)])

(defn boolean-input [(graph g/Graph) (reference i32) (type u8)] (-> BooleanInput)
  (let [none (BooleanInput :kind 0 :source 0 :positive true :bit false)]
    (if (< reference 0)
        (match (g/lookup graph reference)
          (None [] none)
          (Some [literal]
                (if (and (symbols/numeric? literal)
                         (= (n/type-id literal) type)
                         (<= (n/constant-bits literal) 1))
                    (BooleanInput :kind 1 :source 0 :positive true
                                  :bit (= (n/constant-bits literal) 1))
                    none)))
        (let [value (get (.instructions graph) (cast i64 reference))]
          (cond (and (= (n/opcode value) 60)
                     (= (n/type-id value) type)
                     (> (.op1 value) 0)
                     (< (.op2 value) 0)
                     (< (.op3 value) 0))
                  (let [condition (fold/structural-value graph (.op1 value))
                        yes (fold/structural-value graph (.op2 value))
                        no (fold/structural-value graph (.op3 value))]
                    (if (and (= (n/type-id condition) 1)
                             (symbols/numeric? yes)
                             (symbols/numeric? no)
                             (= (n/type-id yes) type)
                             (= (n/type-id no) type)
                             (<= (n/constant-bits yes) 1)
                             (<= (n/constant-bits no) 1)
                             (!= (n/constant-bits yes) (n/constant-bits no)))
                        (BooleanInput :kind 2 :source (.op1 value)
                                      :positive (= (n/constant-bits yes) 1)
                                      :bit false)
                        none))
                (and (= (n/opcode value) 34)
                     (= (n/type-id value) type)
                     (> (.op1 value) 0)
                     (= (n/type-id (get (.instructions graph) (cast i64 (.op1 value))))
                        1))
                  (BooleanInput :kind 2 :source (.op1 value) :positive true :bit false)
                :else none)))))

;;; EQ/NE(PHI(integer 0/1 views of Booleans), 0/1) becomes a Boolean PHI of the
;;; underlying predicates, or its NOT. Every non-literal input must share one
;;; polarity; literals absorb it. The PHI's only use is this comparison and it
;;; is not observed, so retyping it in place changes no other consumer.
(defn boolean-phi! [(graph (mut g/Graph))
                    (lists (mut uses/Uses))
                    (queue (mut q/Queue))
                    (protected bits/Bits)
                    (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (n/opcode node)
        phi (.op1 node)
        right (.op2 node)
        (mut changed) false]
    (when (and (or (= opcode 14) (= opcode 15))
               (= (n/type-id node) 1)
               (> phi 0)
               (< right 0)
               (= (n/opcode (get (.instructions graph) (cast i64 phi))) 67)
               (= (.count (get (.ranges lists) (cast i64 phi))) 1)
               (not (bits/contains? protected (cast i64 phi))))
      (let [header (get (.instructions graph) (cast i64 phi))
            type (n/type-id header)
            count (get (.arities graph) (cast i64 phi))]
        (match (g/lookup graph right)
          (None [] 0)
          (Some [literal]
                (when (and (types/integer? (cast i32 type))
                           (!= type 1)
                           (symbols/numeric? literal)
                           (= (n/type-id literal) type)
                           (<= (n/constant-bits literal) 1)
                           (>= count 3))
                  (let [(mut inputs) (ArrayList::new [BooleanInput] (.alc (.instructions graph)))
                        (mut valid) true
                        (mut polarity) (: 0 i32)]
                    (for [i 2 (+ (cast i64 count) 1)]
                      (match (g/operand graph phi (cast i32 i))
                        (None [] (set! valid false))
                        (Some [input]
                              (let [view (boolean-input graph input type)]
                                (cond (= (.kind view) 0) (set! valid false)
                                      (= input phi) (set! valid false)
                                      (= (.kind view) 2)
                                        (let [p (: (if (.positive view) 1 2) i32)]
                                          (if (or (= polarity 0) (= polarity p))
                                              (set! polarity p)
                                              (set! valid false)))
                                      :else 0)
                                (push! (mut inputs) view)))))
                    (when (and valid (> polarity 0))
                      (let [positive (= polarity 1)
                            (mut sources) (ArrayList::new [i32] (.alc (.instructions graph)))]
                        (push! (mut sources) (.op1 header))
                        (let [items-102 inputs (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [view (get items-102 for-index-102)]
                          (if (= (.kind view) 1)
                              (match (g/intern-scalar! (mut graph) 1
                                                       (if (= (.bit view) positive) 1 0))
                                (Some [constant] (push! (mut sources) constant))
                                (None [] (panic "Boolean PHI constant space exhausted")))
                              (push! (mut sources) (.source view)))) (set! for-index-102 (+ for-index-102 1))))
                        (rewrite-expression! (mut graph) (mut lists) (mut queue)
                                             phi 67 1 (slice sources))
                        ; NE(v,0) and EQ(v,1) test v; v is the PHI when positive.
                        (let [tests-value (= (= opcode 15) (= (n/constant-bits literal) 0))]
                          (set! changed
                                (if (= tests-value positive)
                                    (replace! (mut graph) (mut lists) (mut queue)
                                              protected reference phi)
                                    (rewrite-unary! (mut graph) (mut lists) (mut queue)
                                                    reference 45 1 phi))))
                        (free! (mut sources))))
                    (free! (mut inputs))))))))
    changed))

;;; Whether the 64-bit integer REFERENCE always equals the extension of its
;;; own low word: the sign extension for kind 33, the zero extension for kind
;;; 34. Structural and bounded: literals, extensions from at most a word, AND
;;; with a literal mask, right shifts by at least a word, and PHI/COND/BITCAST
;;; of such values. A PHI reached again within the bound proves nothing.
(defn word-extended? [(graph g/Graph) (reference i32) (kind u8) (depth i32)] (-> bool)
  (match (g/lookup graph reference)
    (None [] false)
    (Some [node]
      (let [opcode (n/opcode node)
            ty (n/type-id node)]
        (cond (not (or (= ty 5) (= ty 11))) false
              (< reference 0)
                (and (symbols/numeric? node)
                     (let [bits (n/constant-bits node)]
                       (if (= kind 33)
                           (or (< bits 0x80000000) (>= bits 0xFFFFFFFF80000000))
                           (<= bits 0xFFFFFFFF))))
              (or (= opcode 33) (= opcode 34))
                (match (g/lookup graph (.op1 node))
                  (None [] false)
                  (Some [source]
                    (let [from (cast i32 (n/type-id source))
                          width (types/scalar-size from 8)]
                      (and (types/integer? from) (!= from 1) (!= from 6)
                           (>= width 1) (<= width 4)
                           ; A zero extension of less than a word is also
                           ; its own sign extension.
                           (or (= opcode kind) (and (= opcode 34) (< width 4)))))))
              (<= depth 0) false
              (= opcode 47)
                (or (literal-below? graph (.op1 node) (if (= kind 33) 0x80000000 0x100000000))
                    (literal-below? graph (.op2 node) (if (= kind 33) 0x80000000 0x100000000)))
              (or (= opcode 50) (= opcode 51))
                (match (g/lookup graph (.op2 node))
                  (None [] false)
                  (Some [amount]
                    (and (< (.op2 node) 0) (symbols/numeric? amount)
                         (< (n/constant-bits amount) 64)
                         (if (= opcode 51)
                             (and (= kind 33) (>= (n/constant-bits amount) 32))
                             (>= (n/constant-bits amount) (if (= kind 33) 33 32))))))
              (= opcode 36)
                (word-extended? graph (.op1 node) kind (- depth 1))
              (= opcode 60)
                (and (word-extended? graph (.op2 node) kind (- depth 1))
                     (word-extended? graph (.op3 node) kind (- depth 1)))
              (= opcode 67)
                (let [count (get (.arities graph) (cast i64 reference))
                      (mut good) (>= count 2)
                      (mut i) (: 2 i32)]
                  (while (and good (<= i count))
                    (match (g/operand graph reference i)
                      (None [] (set! good false))
                      (Some [input]
                        (unless (or (= input reference)
                                    (word-extended? graph input kind (- depth 1)))
                          (set! good false))))
                    (set! i (+ i 1)))
                  good)
              :else false)))))

;;; A numeric 64-bit literal below LIMIT.
(defn literal-below? [(graph g/Graph) (reference i32) (limit u64)] (-> bool)
  (and (< reference 0)
       (match (g/lookup graph reference)
         (None [] false)
         (Some [literal]
           (and (symbols/numeric? literal)
                (or (= (n/type-id literal) 5) (= (n/type-id literal) 11))
                (< (n/constant-bits literal) limit))))))

;;; SEXT/ZEXT to 64 bits of the 32-bit TRUNC of a 64-bit value that already
;;; is that extension of its low word is the value itself. Independent typed
;;; identity; a BITCAST keeps a differing 64-bit result type.
(defn extension-identity! [(graph (mut g/Graph))
                           (lists (mut uses/Uses))
                           (queue (mut q/Queue))
                           (protected bits/Bits)
                           (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (n/opcode node)
        ty (n/type-id node)
        view (.op1 node)]
    (if (not (and (or (= opcode 33) (= opcode 34)) (or (= ty 5) (= ty 11)) (> view 0)))
        false
        (let [truncation (get (.instructions graph) (cast i64 view))
              source (.op1 truncation)]
          (if (not (and (= (n/opcode truncation) 35)
                        (or (= (n/type-id truncation) 4) (= (n/type-id truncation) 10))
                        (> source 0)
                        (word-extended? graph source opcode 6)))
              false
              (if (= (n/type-id (get (.instructions graph) (cast i64 source))) ty)
                  (replace! (mut graph) (mut lists) (mut queue) protected reference source)
                  (rewrite-unary! (mut graph) (mut lists) (mut queue) reference 36 ty source)))))))

;;; A 64-bit PHI that is the extension of its own low word makes every
;;; extension of its word views an identity: revisit those extensions, which
;;; the worklist would otherwise reach only after some other change.
(defn queue-word-views! [(graph g/Graph) (lists uses/Uses) (queue (mut q/Queue))
                         (reference i32)] (-> void)
  (let [node (get (.instructions graph) (cast i64 reference))]
    (when (and (= (n/opcode node) 67)
               (or (= (n/type-id node) 5) (= (n/type-id node) 11)))
      (let [range (get (.ranges lists) (cast i64 reference))
            (mut proven) 0]
        (for [i (.offset range) (+ (.offset range) (.count range))]
          (let [view (.user (get (.edges lists) i))
                truncation (get (.instructions graph) (cast i64 view))]
            (when (and (= (n/opcode truncation) 35)
                       (or (= (n/type-id truncation) 4) (= (n/type-id truncation) 10)))
              (let [readers (get (.ranges lists) (cast i64 view))]
                (for [j (.offset readers) (+ (.offset readers) (.count readers))]
                  (let [reader (.user (get (.edges lists) j))
                        kind (n/opcode (get (.instructions graph) (cast i64 reader)))]
                    (when (or (= kind 33) (= kind 34))
                      ; One proof per kind: bit0 sign known, bit1 sign holds,
                      ; bit2 zero known, bit3 zero holds.
                      (let [known (if (= kind 33) 1 4)
                            holds (if (= kind 33) 2 8)]
                        (when (= (& proven known) 0)
                          (set! proven
                                (| proven known
                                   (if (word-extended? graph reference kind 6) holds 0))))
                        (when (!= (& proven holds) 0)
                          (q/add! (mut queue) (cast i64 reader)))))))))))))))

;;; Nested scalar conversion restart rules from pinned ir_fold.h. BOOL's
;;; canonicalization is an explicit boundary: no rule crosses a BOOL view.
;;; Instruction IDs/types and rooted observations remain stable; uses are
;;; updated before affected consumers return to the ordinary worklist.
(defn conversion-restart! [(graph (mut g/Graph))
                           (lists (mut uses/Uses))
                           (queue (mut q/Queue))
                           (protected bits/Bits)
                           (reference i32)
                           (pointer-bytes i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (n/opcode node)
        type (n/type-id node)
        middle (.op1 node)
        (mut changed) false]
    (when (and (>= opcode 33)
               (<= opcode 36)
               (> middle 0)
               (types/valid-scalar? (cast i32 type))
               (> type 1))
      (let [inner (get (.instructions graph) (cast i64 middle))
            inner-op (n/opcode inner)
            inner-type (n/type-id inner)
            base (.op1 inner)]
        (when (and (types/valid-scalar? (cast i32 inner-type)) (> inner-type 1))
          (match (g/lookup graph base)
            (None [] 0)
            (Some [source]
                  (let [source-type (n/type-id source)
                        from
                          (types/scalar-size (cast i32 source-type)
                                             pointer-bytes)
                        to (types/scalar-size (cast i32 type) pointer-bytes)
                        integers
                          (and (types/integer? (cast i32 type))
                               (types/integer? (cast i32 source-type)))
                        (mut next-op) opcode
                        (mut next-input) middle
                        (mut copied) (: 0 i32)]
                    (when (and (types/valid-scalar? (cast i32 source-type))
                               (> source-type 1))
                      (cond (and (= opcode 35)
                                 (or (= inner-op 33) (= inner-op 34))
                                 integers)
                              (if (= source-type type)
                                  (set! copied base)
                                  (do
                                    (set! next-input base)
                                    (set! next-op
                                          (if (= from to)
                                              36
                                              (if (> from to) 35 inner-op)))))
                            (and (= inner-op 36)
                                 (or (= opcode 33) (= opcode 34) (= opcode 35))
                                 integers)
                              (set! next-input base)
                            (and (= opcode 36) (= inner-op 36))
                              (if (= source-type type)
                                  (set! copied base)
                                  (set! next-input base))
                            (and (= opcode inner-op)
                                 (or (= opcode 33) (= opcode 34) (= opcode 35)))
                              (set! next-input base)
                            (and (= opcode 33) (= inner-op 34))
                              (do (set! next-op 34) (set! next-input base))
                            :else 0)
                      ; Pinned ir_fold.h TRUNC(AND): the destination already
                      ; discards exactly these high bits. Rewrite only this
                      ; consumer, preserving any other observation of the AND.
                      (when (and (= opcode 35) (= inner-op 47) integers
                                 (or (= to 1) (= to 2) (= to 4)))
                        (match (g/lookup graph (.op2 inner))
                          (None [] 0)
                          (Some [mask]
                            (when (and (symbols/numeric? mask)
                                       (= (n/type-id mask) inner-type)
                                       (= (n/constant-bits mask)
                                          (- (<< (: 1 u64) (cast u64 (* to 8))) 1)))
                              (set! next-input base)))))
                      (when (and (= opcode 33)
                                 (or (= inner-op 47) (= inner-op 50)))
                        (match (g/lookup graph (.op2 inner))
                          (None [] 0)
                          (Some [amount]
                                (when (and (types/integer? (cast i32
                                                                 (n/type-id amount)))
                                           (= (n/opcode amount)
                                              (n/type-id amount)))
                                  (let [width
                                          (* 8
                                             (types/scalar-size (cast i32
                                                                      inner-type)
                                                                pointer-bytes))
                                        bits (n/constant-bits amount)]
                                    (when (or (and (= inner-op 47)
                                                   (= (& bits
                                                         (<< (: 1 u64)
                                                             (cast u64
                                                                   (- width 1))))
                                                      0))
                                              (and (= inner-op 50)
                                                   (!= (& bits
                                                          (cast u64 (- width 1)))
                                                       0)))
                                      (set! next-op 34)))))))
                      (if (!= copied 0)
                          (set! changed
                                (replace! (mut graph)
                                          (mut lists)
                                          (mut queue)
                                          protected
                                          reference
                                          copied))
                          (when (or (!= next-op opcode) (!= next-input middle))
                            (set! changed
                                  (rewrite-unary! (mut graph)
                                                  (mut lists)
                                                  (mut queue)
                                                  reference
                                                  next-op
                                                  type
                                                  next-input)))))))))))
    changed))

;;; Independent typed identity: sign-extending a truncated high field is an
;;; arithmetic right shift of the original word. Reuse the private TRUNC cell
;;; as SAR; its width can change only when the extension is its sole use and
;;; it is not rooted. A final BITCAST retains the extension's signed type.
(defn extend-high! [(graph (mut g/Graph))
                    (lists (mut uses/Uses))
                    (queue (mut q/Queue))
                    (protected bits/Bits)
                    (reference i32)
                    (pointer-bytes i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        middle (.op1 node)
        (mut changed) false]
    (when (and (= (n/opcode node) 33)
               (> middle 0)
               (= (.count (get (.ranges lists) (cast i64 middle))) 1)
               (not (bits/contains? protected (cast i64 middle))))
      (let [trunc (get (.instructions graph) (cast i64 middle))
            shift (.op1 trunc)]
        (when (and (= (n/opcode trunc) 35) (> shift 0))
          (let [producer (get (.instructions graph) (cast i64 shift))
                source-type (n/type-id producer)
                wide (types/size (cast i32 source-type) pointer-bytes)
                narrow (types/size (cast i32 (n/type-id trunc)) pointer-bytes)
                target (n/type-id node)]
            (when (and (= (n/opcode producer) 50)
                       (types/integer? (cast i32 source-type))
                       (!= source-type 1)
                       (!= source-type 6)
                       (types/integer? (cast i32 (n/type-id trunc)))
                       (!= (n/type-id trunc) 1)
                       (!= (n/type-id trunc) 6)
                       (types/integer? (cast i32 target))
                       (!= target 1)
                       (!= target 6)
                       (= wide (types/size (cast i32 target) pointer-bytes))
                       (> narrow 0)
                       (> wide narrow)
                       (< (.op2 producer) 0))
              (match (g/lookup graph (.op2 producer))
                (Some [amount]
                      (when (and (symbols/numeric? amount)
                                 (= (n/constant-bits amount)
                                    (cast u64 (* (- wide narrow) 8))))
                        (detach! graph (mut lists) (mut queue) reference)
                        (detach! graph (mut lists) (mut queue) middle)
                        (unless (g/rewrite-inputs! (mut graph)
                                                   middle
                                                   51
                                                   source-type
                                                   [(.op1 producer)
                                                    (.op2 producer)])
                          (panic "high-field shift rewrite failed"))
                        (unless (g/rewrite-inputs! (mut graph)
                                                   reference
                                                   36
                                                   target
                                                   [middle])
                          (panic "high-field view rewrite failed"))
                        (for [i 1 3]
                          (match (g/operand graph middle (cast i32 i))
                            (Some [input]
                                  (when (> input 0)
                                    (uses/add! (mut lists)
                                               input
                                               (uses/Use
                                                 :user middle
                                                 :operand (cast i32 i)))))
                            (None [] (panic "high-field operand missing"))))
                        (uses/add! (mut lists)
                                   middle
                                   (uses/Use :user reference :operand 1))
                        (q/add! (mut queue) (cast i64 middle))
                        (set! changed true)))
                (None [] 0)))))))
    changed))

;;; Backward integer-width propagation follows pinned ir_sccp.c's truncation
;;; preflight/apply split. MIN/MAX/ABS require stronger range/order proofs and
;;; remain unchanged (see INTEGER_TYPE_PROMOTION_AUDIT.md).
(defstruct PromotionNode [(reference i32) (opcode u8) (begin i64) (count i64)])
(defstruct PromotionFrame [(reference i32) (plan i64) (cursor i64) (slot i64)])
(defstruct PromotionContext
  [(states (ArrayList u8)) (mapped (ArrayList i32))
   (touched (ArrayList i32)) (stack (ArrayList PromotionFrame))
   (nodes (ArrayList PromotionNode)) (inputs (ArrayList i32))])

(defn promotion-context [(a (dyn Allocator))] (-> PromotionContext)
  (PromotionContext :states (ArrayList::new [u8] a)
    :mapped (ArrayList::new [i32] a) :touched (ArrayList::new [i32] a)
    :stack (ArrayList::new [PromotionFrame] a)
    :nodes (ArrayList::new [PromotionNode] a) :inputs (ArrayList::new [i32] a)))

(defn release-promotion! [(c (mut PromotionContext))] (-> void)
  (free! (mut (.states c))) (free! (mut (.mapped c)))
  (free! (mut (.touched c))) (free! (mut (.stack c)))
  (free! (mut (.nodes c))) (free! (mut (.inputs c))))

(defn promotion-value-input? [(opcode u8) (index i64)] (-> bool)
  (and (not (and (>= opcode 33) (<= opcode 36)))
       (or (not (or (= opcode 60) (= opcode 67))) (> index 0))))

;;; -1 rejects; zero bypasses an existing extension without changing it.
(defn promotion-op [(graph g/Graph) (lists uses/Uses) (protected bits/Bits)
                    (reference i32) (root i32) (target u8) (pointer-bytes i32)]
  (-> i32)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        range (get (.ranges lists) (cast i64 reference))
        width (types/scalar-size (cast i32 target) pointer-bytes)]
    (cond (or (= reference root)
              (= (n/type-id node) 6)
              (bits/contains? protected (cast i64 reference))
              (not (types/integer? (cast i32 (n/type-id node))))
              (<= (types/scalar-size (cast i32 (n/type-id node)) pointer-bytes) width)) -1
          (and (>= opcode 33) (<= opcode 35))
            (let [source (get (.instructions graph) 0)
                  input (match (g/lookup graph (.op1 node))
                          (None [] source) (Some [value] value))
                  from (types/scalar-size (cast i32 (n/type-id input)) pointer-bytes)]
              (cond (or (= (.op1 node) root)
                        (= (n/type-id input) 1) (= (n/type-id input) 6)
                        (not (types/integer? (cast i32 (n/type-id input))))) -1
                    (= (n/type-id input) target) 0
                    (!= (.count range) 1) -1
                    (= from width) 36
                    (> from width) 35
                    (or (= opcode 33) (= opcode 34)) opcode
                    :else (if (types/signed? (cast i32 target)) 33 34)))
          (= opcode 67)
            (let [(mut external) 0]
              (for [i (.offset range) (+ (.offset range) (.count range))]
                (unless (= (.user (get (.edges lists) i)) reference)
                  (set! external (+ external 1))))
              (if (= external 1) opcode -1))
          (!= (.count range) 1) -1
          (or (= opcode 26) (= opcode 27) (= opcode 28)
              (= opcode 31) (= opcode 45)
              (= opcode 46) (= opcode 47) (= opcode 48)) opcode
          (= opcode 49)
            (match (g/lookup graph (.op2 node))
              (None [] -1)
              (Some [amount]
                (if (and (< (.op2 node) 0) (symbols/numeric? amount)
                         (types/integer? (cast i32 (n/type-id amount)))
                         (< (n/constant-bits amount) (cast u64 (* width 8)))) opcode -1)))
          (and (= opcode 60) (!= (.op1 node) (.op2 node))
               (!= (.op1 node) (.op3 node))) opcode
          :else -1)))

;;; Marks/maps are allocated lazily once and reset only at touched references.
;;; An explicit stack rejects foreign cycles without recursive host-stack use.
(defn plan-promotion! [(c (mut PromotionContext)) (graph g/Graph)
                       (lists uses/Uses) (protected bits/Bits)
                       (root i32) (source i32) (target u8) (pointer-bytes i32)]
  (-> i32)
  (let [items-1 (.touched c) (mut for-index-1) (: 0 i64)] (while (< for-index-1 (len items-1)) (let [reference (get items-1 for-index-1)] (set! (mut (.states c)) (cast i64 reference) 0)) (set! for-index-1 (+ for-index-1 1))))
  (clear! (mut (.touched c))) (clear! (mut (.stack c)))
  (clear! (mut (.nodes c))) (clear! (mut (.inputs c)))
  (when (< (len (.states c)) (len (.instructions graph)))
    (extend-zeroed! (mut (.states c)) (- (len (.instructions graph)) (len (.states c))))
    (extend-zeroed! (mut (.mapped c)) (- (len (.instructions graph)) (len (.mapped c)))))
  (push! (mut (.stack c)) (PromotionFrame :reference source :plan -1 :cursor -1 :slot -1))
  (let [(mut valid) true (mut result) (: 0 i32)]
    (while (and valid (> (len (.stack c)) 0))
      (let [last (- (len (.stack c)) 1)
            frame (get (.stack c) last)
            reference (.reference frame)
            index (cast i64 reference)
            (mut finished) false (mut replacement) reference]
        (if (= (.cursor frame) -1)
            (cond (= (get (.states c) index) 1) (set! valid false)
                  (= (get (.states c) index) 2)
                    (do (set! finished true) (set! replacement (get (.mapped c) index)))
                  :else
                    (let [opcode (promotion-op graph lists protected reference root target pointer-bytes)
                          node (get (.instructions graph) index)]
                      (if (< opcode 0) (set! valid false)
                          (do
                            (push! (mut (.touched c)) reference)
                            (set! (mut (.states c)) index 1)
                            (if (= opcode 0)
                                (do (set! finished true) (set! replacement (.op1 node)))
                                (let [begin (len (.inputs c))
                                      count (cast i64 (get (.arities graph) index))
                                      planned (len (.nodes c))]
                                  (for [i 1 (+ count 1)]
                                    (match (g/operand graph reference (cast i32 i))
                                      (None [] (panic "promotion operand missing"))
                                      (Some [input] (push! (mut (.inputs c)) input))))
                                  (push! (mut (.nodes c)) (PromotionNode :reference reference
                                    :opcode (cast u8 opcode) :begin begin :count count))
                                  (set! (mut (.stack c)) last
                                    (PromotionFrame :reference reference :plan planned :cursor 0 :slot (.slot frame)))))))))
            (let [planned (get (.nodes c) (.plan frame))]
              (if (>= (.cursor frame) (.count planned)) (set! finished true)
                  (let [slot (+ (.begin planned) (.cursor frame))
                        input (get (.inputs c) slot)]
                    (set! (.cursor (elem (mut (.stack c)) last)) (+ (.cursor frame) 1))
                    (when (promotion-value-input? (.opcode planned) (.cursor frame))
                      (if (< input 0)
                          (match (g/lookup graph input)
                            (None [] (set! valid false))
                            (Some [literal]
                              (unless (and (symbols/numeric? literal)
                                           (types/integer? (cast i32 (n/type-id literal))))
                                (set! valid false))))
                          (unless (and (= (.opcode planned) 67) (= input reference))
                            (if (<= input 0) (set! valid false)
                                (push! (mut (.stack c))
                                  (PromotionFrame :reference input :plan -1 :cursor -1 :slot slot))))))))))
        (when finished
          (set! (mut (.states c)) index 2)
          (set! (mut (.mapped c)) index replacement)
          (if (< (.slot frame) 0) (set! result replacement)
              (set! (mut (.inputs c)) (.slot frame) replacement))
          (pop! (mut (.stack c))))))
    (if valid result 0)))

(defn narrow-arithmetic! [(graph (mut g/Graph)) (lists (mut uses/Uses))
                          (queue (mut q/Queue)) (protected bits/Bits)
                          (c (mut PromotionContext)) (reference i32) (pointer-bytes i32)]
  (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        target (n/type-id node)]
    (if (or (!= (n/opcode node) 35) (<= (.op1 node) 0)
            (<= target 1) (= target 6) (not (types/integer? (cast i32 target))))
        false
        (let [replacement (plan-promotion! (mut c) graph lists protected reference
                                           (.op1 node) target pointer-bytes)]
          (if (= replacement 0) false
              (do
                (let [(mut i) (- (len (.nodes c)) 1)]
                  (while (>= i 0)
                    (let [planned (get (.nodes c) i)]
                      (for [k 0 (.count planned)]
                        (let [slot (+ (.begin planned) k) input (get (.inputs c) slot)]
                          (when (and (< input 0) (promotion-value-input? (.opcode planned) k))
                            (let [literal (match (g/lookup graph input)
                                             (Some [value] value)
                                             (None [] (panic "promotion constant missing")))
                                  from (types/scalar-size (cast i32 (n/type-id literal)) pointer-bytes)
                                  to (types/scalar-size (cast i32 target) pointer-bytes)
                                  opcode (if (= from to) 36 (if (> from to) 35
                                             (if (types/signed? (cast i32 (n/type-id literal))) 33 34)))
                                  value (match (conversion/evaluate (cast i32 opcode) (cast i32 (n/type-id literal))
                                                        (cast i32 target) pointer-bytes (n/constant-bits literal))
                                          (Some [value] value)
                                          (None [] (panic "promotion constant conversion invalid")))
                                  mapped (match (g/intern-scalar! (mut graph) target value)
                                           (Some [value] value)
                                           (None [] (panic "promotion constant reference exhaustion")))]
                              (set! (mut (.inputs c)) slot mapped)))))
                      (rewrite-expression! (mut graph) (mut lists) (mut queue)
                        (.reference planned) (.opcode planned) target
                        (subslice (slice (.inputs c)) (.begin planned) (+ (.begin planned) (.count planned)))))
                    (set! i (- i 1))))
                (replace! (mut graph) (mut lists) (mut queue) protected reference replacement)))))))

;;; Caller owns graph/lists/queue. Only seeded nodes and users/inputs affected by
;;; changes are visited. Current graph values feed the shared fold rules;
;;; no second SCCP analysis or persistent alternative IR is built.
(defstruct Progress [(changes i32) (control bool)])

(defn run-core-indexed! [(graph (mut g/Graph))
                         (lists (mut uses/Uses))
                         (queue (mut q/Queue))
                         (roots (mut (ArrayList i32)))
                         (pending-loads (mut (ArrayList i32)))
                         (protected (mut bits/Bits))
                         (rooted bool)
                         (constants (mut literal-cse/Index))
                         (pointer-bytes i32)
                         (fold-control bool)
                         (a (dyn Allocator))]
  (-> (Result Progress (slice u8)))
  (let [(mut changes) (: 0 i32)
        (mut control-changed) false
        (mut dead-context) (zeroed dead/Context)
        (mut promotion) (promotion-context a)
        (mut error) ""
        (mut next) (q/pop! (mut queue))]
    (while (and (>= next 0) (= error ""))
      (when (and fold-control
                 (or (control/fold-if! (mut graph)
                                       (mut lists)
                                       (mut queue)
                                       (cast i32 next))
                     (control/split-if! (mut graph) (mut lists) (mut queue)
                                        protected (cast i32 next) pointer-bytes)))
        (set! changes (+ changes 1))
        (set! control-changed true))
      (let [opcode (n/opcode (get (.instructions graph) next))
            changed
              (cond (and fold-control (or (= opcode 112) (= opcode 113)))
                      (let [changed? (or (and (= opcode 112)
                                          (diamond/at-merge! (mut graph) (mut roots)
                                            (mut lists) (mut queue) (mut protected) (cast i32 next)))
                                        (countdown/rewrite! (mut graph) (mut lists)
                                       (mut queue) (mut roots) (mut protected) (cast i32 next))
                                        (memory-countdown/rewrite! (mut graph) (mut lists)
                                          (mut queue) (mut roots) (mut protected) (cast i32 next) pointer-bytes))]
                        (when changed? (set! control-changed true))
                        changed?)
                    (= opcode 67)
                      (let [source (phi-source graph (cast i32 next))]
                        (and (!= source 0)
                             (replace! (mut graph) (mut lists) (mut queue)
                                       protected (cast i32 next) source)))
                    (or (= opcode 29) (= opcode 30))
                      (power-division! (mut graph) (mut lists) (mut queue)
                                        (cast i32 next) pointer-bytes)
                    (= opcode 47)
                      (and-extension! (mut graph) (mut lists) (mut queue)
                                       protected (cast i32 next) pointer-bytes)
                    (= opcode 60)
                      (if (or (condition-choice! (mut graph) (mut lists) (mut queue)
                                                 protected (cast i32 next))
                              (bit-choice! (mut graph)
                                       (mut lists)
                                       (mut queue)
                                       protected
                                       (cast i32 next)
                                       pointer-bytes))
                          true
                          (boolean-choice! (mut graph)
                                           (mut lists)
                                           (mut queue)
                                           protected
                                           (cast i32 next)
                                           pointer-bytes))
                    (or (= opcode 33) (= opcode 34) (= opcode 36))
                      (bit-choice! (mut graph)
                                   (mut lists)
                                   (mut queue)
                                   protected
                                   (cast i32 next)
                                   pointer-bytes)
                    (= opcode 45)
                      (not-compare! (mut graph)
                                    (mut lists)
                                    (mut queue)
                                    (cast i32 next))
                    (or (= opcode 14) (= opcode 15))
                      (if (boolean-compare! (mut graph)
                                            (mut lists)
                                            (mut queue)
                                            protected
                                            (cast i32 next))
                          true
                          (boolean-phi! (mut graph)
                                        (mut lists)
                                        (mut queue)
                                        protected
                                        (cast i32 next)))
                    :else false)]
        (when changed (set! changes (+ changes 1))))
      (let [rotation (structural/rotate graph (cast i32 next) pointer-bytes)]
        (when (!= (n/opcode rotation) 0)
          (rewrite-expression! (mut graph) (mut lists) (mut queue)
                               (cast i32 next) (n/opcode rotation)
                               (n/type-id rotation) [(.op1 rotation) (.op2 rotation)])
          (set! changes (+ changes 1))))
      (queue-word-views! graph lists (mut queue) (cast i32 next))
      (when (extension-identity! (mut graph) (mut lists) (mut queue) protected (cast i32 next))
        (set! changes (+ changes 1)))
      (when (conversion-restart! (mut graph)
                                 (mut lists)
                                 (mut queue)
                                 protected
                                 (cast i32 next)
                                 pointer-bytes)
        (set! changes (+ changes 1)))
      (when (narrow-arithmetic! (mut graph) (mut lists) (mut queue) protected
                                 (mut promotion) (cast i32 next) pointer-bytes)
        (set! changes (+ changes 1)))
      (when (extend-high! (mut graph)
                          (mut lists)
                          (mut queue)
                          protected
                          (cast i32 next)
                          pointer-bytes)
        (set! changes (+ changes 1)))
      (when (dead/remove! (mut graph)
                          (mut lists)
                          (mut queue)
                          protected
                          (mut dead-context)
                          (cast i32 next))
        (set! changes (+ changes 1)))
      (when (= (n/opcode (get (.instructions graph) next)) 91)
        (if fold-control
            (push! (mut pending-loads) (cast i32 next))
            (let [type (n/type-id (get (.instructions graph) next))
                  forwarded
                    (memory/prepare! (mut graph)
                                     (mut lists)
                                     (mut queue)
                                     (mut roots)
                                     (mut protected)
                                     rooted
                                     (cast i32 next)
                                     pointer-bytes)
                  source (.source forwarded)
                  opcode (.opcode forwarded)]
              (when (!= source 0)
                (if (= opcode 0)
                    (replace! (mut graph)
                              (mut lists)
                              (mut queue)
                              protected
                              (cast i32 next)
                              source)
                    (rewrite-unary! (mut graph)
                                    (mut lists)
                                    (mut queue)
                                    (cast i32 next)
                                    opcode
                                    type
                                    source))
                (set! changes (+ changes 1))))))
      (let [reference (cast i32 next)
            node (get (.instructions graph) next)
            opcode (cast i32 (n/opcode node))]
        (when (and (foldable? opcode) (!= opcode 67))
          (match (fold/evaluate-current graph reference pointer-bytes)
            (Err [message] (set! error message))
            (Ok [decision]
                (let [(mut replacement) (: 0 i32)]
                  (match (.kind decision)
                    (1 (let [value (.constant decision)]
                         (match (g/intern-constant! (mut graph)
                                                    (n/opcode value)
                                                    (n/type-id value)
                                                    0
                                                    (n/constant-bits value))
                           (Some [r] (set! replacement r))
                           (None []
                                 (set! error
                                       "iterative constant reference space exhausted")))))
                    (2 (set! replacement (.source decision)))
                    (4 (let [restart (.constant decision)]
                         (when (rewrite-unary! (mut graph) (mut lists) (mut queue)
                                               reference (n/opcode restart) (n/type-id restart)
                                               (.source decision))
                           (set! changes (+ changes 1)))))
                    (3 (set! replacement
                             (let [ordinary
                                     (find-cse! graph
                                                lists
                                                (mut queue)
                                                reference)]
                               (if (and (= ordinary 0) (< (.op1 node) 0))
                                   (literal-cse/find! (mut constants)
                                                      graph
                                                      (mut queue)
                                                      reference)
                                   ordinary))))
                    (_ 0))
                  (when (and (!= replacement 0) (= error ""))
                    (when (replace! (mut graph)
                                    (mut lists)
                                    (mut queue)
                                    protected
                                    reference
                                    replacement)
                      (set! changes (+ changes 1)))))))))
      ; An ancestry query reads a comparison's operands, not only its SSA
      ; identity. Input canonicalization may leave that comparison in place,
      ; so its IF users must be revisited even when scalar folding keeps it.
      (when fold-control
        (let [opcode (n/opcode (get (.instructions graph) next))]
          (when (and (>= opcode 14) (<= opcode 23))
            (let [range (get (.ranges lists) next)]
              (for [i (.offset range) (+ (.offset range) (.count range))]
                (let [edge (get (.edges lists) i)
                      user (.user edge)]
                  (when (and (= (.operand edge) 2)
                             (= (n/opcode (get (.instructions graph) (cast i64 user))) 116))
                    (q/add! (mut queue) (cast i64 user)))))))))
      ; Promotion can introduce a loop-carried Phi after its header was visited.
      ; Reconsider that header from the affected Phi rather than rescanning CFGs.
      (when fold-control
        (let [node (get (.instructions graph) next)]
          (when (and (= (n/opcode node) 67)
                     (= (.count (get (.ranges lists) (cast i64 (.op1 node)))) 2))
            (q/add! (mut queue) (cast i64 (.op1 node))))))
      (set! next (q/pop! (mut queue))))
    (release-promotion! (mut promotion))
    (if (= error "")
        (Ok (Progress :changes changes :control control-changed))
        (Err error))))

(defn run-core! [(graph (mut g/Graph))
                 (lists (mut uses/Uses))
                 (queue (mut q/Queue))
                 (protected bits/Bits)
                 (pointer-bytes i32)
                 (fold-control bool)
                 (a (dyn Allocator))]
  (-> (Result Progress (slice u8)))
  (let [(mut constants) (literal-cse/create a)
        (mut roots) (ArrayList::new [i32] a)
        (mut pending-loads) (ArrayList::new [i32] a)
        (mut protection) protected
        result
          (run-core-indexed! (mut graph)
                             (mut lists)
                             (mut queue)
                             (mut roots)
                             (mut pending-loads)
                             (mut protection)
                             false
                             (mut constants)
                             pointer-bytes
                             fold-control
                             a)]
    (literal-cse/release! (mut constants))
    (free! (mut pending-loads))
    (free! (mut roots))
    result))

;;; Rootless compatibility entry: no transient IF changes or protected-load
;;; replacement without a mutable observation list. Ordinary dead/aliased loads
;;; can still be bypassed without changing basic-block structure.
(defn run! [(graph (mut g/Graph))
            (lists (mut uses/Uses))
            (queue (mut q/Queue))
            (protected bits/Bits)
            (pointer-bytes i32)
            (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (run-core! (mut graph)
                    (mut lists)
                    (mut queue)
                    protected
                    pointer-bytes
                    false
                    a)
    (Err [message] (Err message))
    (Ok [progress] (Ok (.changes progress)))))

;;; Roots and protection bits must name the same observation set. Finish late
;;; control changes at the same reachability boundary as upstream CFG construction. Rebuild only control reachability, then drain affected
;;; scalar folds after merge/Phi repair. No repeated SCCP analysis is performed.
(defn run-rooted-indexed! [(graph (mut g/Graph))
                           (roots (mut (ArrayList i32)))
                           (lists (mut uses/Uses))
                           (queue (mut q/Queue))
                           (protected (mut bits/Bits))
                           (constants (mut literal-cse/Index))
                           (pending-loads (mut (ArrayList i32)))
                           (pointer-bytes i32)
                           (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut changes) (: 0 i32)
        (mut error) ""
        (mut control-pending) true]
    ; Pruning and boundary merging enqueue affected users. They can expose
    ; another control fold, so drain those notifications before permitting
    ; memory replacement to retire an explicit data observation.
    (while (and control-pending (= error ""))
      (set! control-pending false)
      (match (run-core-indexed! (mut graph)
                                (mut lists)
                                (mut queue)
                                (mut roots)
                                (mut pending-loads)
                                (mut protected)
                                true
                                (mut constants)
                                pointer-bytes
                                true
                                a)
        (Err [message] (set! error message))
        (Ok [progress]
            (set! changes (+ changes (.changes progress)))
            (when (.control progress)
              (match (control/prune! (mut graph)
                                     (mut roots)
                                     (mut lists)
                                     (mut queue)
                                     (mut protected)
                                     a)
                (Err [message] (set! error message))
                (Ok [pruned]
                    (set! changes (+ changes pruned))
                    (set! changes
                          (+ changes
                             (boundaries/merge! (mut graph)
                                                (mut roots)
                                                (mut lists)
                                                (mut queue)
                                                a)))
                    (bits/clear! (mut protected))
                    (let [items-2 roots (mut for-index-2) (: 0 i64)] (while (< for-index-2 (len items-2)) (let [root (get items-2 for-index-2)] (bits/add! (mut protected) (cast i64 root))) (set! for-index-2 (+ for-index-2 1))))
                    (set! control-pending true)))))))
    (when (= error "")
      ; Delay memory replacement until all control cleanup notifications and
      ; unreachable data observations have been checked.
      (let [items-101 pending-loads (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [reference (get items-101 for-index-101)]
        (when (and (g/contains? graph reference)
                   (= (n/opcode (get (.instructions graph)
                                     (cast i64 reference))) 91))
          (q/add! (mut queue) (cast i64 reference)))) (set! for-index-101 (+ for-index-101 1))))
      (clear! (mut pending-loads))
      (match (run-core-indexed! (mut graph)
                                (mut lists)
                                (mut queue)
                                (mut roots)
                                (mut pending-loads)
                                (mut protected)
                                true
                                (mut constants)
                                pointer-bytes
                                false
                                a)
        (Err [message] (set! error message))
        (Ok [after] (set! changes (+ changes (.changes after))))))
    (if (= error "") (Ok changes) (Err error))))

(defn run-rooted! [(graph (mut g/Graph))
                   (roots (mut (ArrayList i32)))
                   (lists (mut uses/Uses))
                   (queue (mut q/Queue))
                   (protected (mut bits/Bits))
                   (pointer-bytes i32)
                   (a (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [(mut constants) (literal-cse/create a)
        (mut pending-loads) (ArrayList::new [i32] a)
        result
          (run-rooted-indexed! (mut graph)
                               (mut roots)
                               (mut lists)
                               (mut queue)
                               (mut protected)
                               (mut constants)
                               (mut pending-loads)
                               pointer-bytes
                               a)]
    (literal-cse/release! (mut constants))
    (free! (mut pending-loads))
    result))

;;; Transactional public entry: validate first, transform an owned graph, validate
;;; again, and discard failed output. Roots keep their positive references through
;;; COPY nodes. All structural analyses must be rebuilt after successful edits.
(defn optimize [(source g/Graph)
                (pointer-bytes i32)
                (roots (slice i32))
                (seeds (slice i32))
                (a (dyn Allocator))]
  (-> (Result rewrite/Rewritten (slice u8)))
  (let [(mut error) ""]
    (when (not (or (= pointer-bytes 4) (= pointer-bytes 8)))
      (set! error "iterative pointer width must be four or eight"))
    (when (= error "")
      (match (rewrite/validate source pointer-bytes a)
        (Err [message] (set! error message))
        (Ok [_] 0)))
    (let [items-3 roots (mut for-index-3) (: 0 i64)] (while (< for-index-3 (len items-3)) (let [r (get items-3 for-index-3)]
      (when (or (<= r 0) (not (g/contains? source r)))
        (set! error "iterative root is not an instruction"))) (set! for-index-3 (+ for-index-3 1))))
    (let [items-4 seeds (mut for-index-4) (: 0 i64)] (while (< for-index-4 (len items-4)) (let [r (get items-4 for-index-4)]
      (when (or (<= r 0) (not (g/contains? source r)))
        (set! error "iterative seed is not an instruction"))) (set! for-index-4 (+ for-index-4 1))))
    (if (!= error "")
        (Err error)
        (let [(mut graph) (g/duplicate source a)
              (mut lists) (uses/build graph a)
              (mut queue) (q/create (len (.instructions graph)) a)
              (mut protected) (bits/create (len (.instructions graph)) a)
              (mut output-roots) (ArrayList::new [i32] a)
              (mut changes) (: 0 i32)]
          (let [items-5 roots (mut for-index-5) (: 0 i64)] (while (< for-index-5 (len items-5)) (let [r (get items-5 for-index-5)]
            (bits/add! (mut protected) (cast i64 r))
            (push! (mut output-roots) r)) (set! for-index-5 (+ for-index-5 1))))
          (let [items-6 seeds (mut for-index-6) (: 0 i64)] (while (< for-index-6 (len items-6)) (let [r (get items-6 for-index-6)] (q/add! (mut queue) (cast i64 r))) (set! for-index-6 (+ for-index-6 1))))
          (match (run-rooted! (mut graph)
                              (mut output-roots)
                              (mut lists)
                              (mut queue)
                              (mut protected)
                              pointer-bytes
                              a)
            (Err [message] (set! error message))
            (Ok [count] (set! changes count)))
          (when (= error "")
            (match (rewrite/validate graph pointer-bytes a)
              (Err [message] (set! error message))
              (Ok [_] 0)))
          (uses/release! (mut lists))
          (bits/release! (mut protected))
          (if (= error "")
              (Ok (rewrite/Rewritten
                    :graph graph
                    :roots output-roots
                    :changes changes
                    :iteration queue
                    :proof (rewrite/content-hash graph pointer-bytes)))
              (do
                (g/release! (mut graph))
                (free! (mut output-roots))
                (q/release! (mut queue))
                (Err error)))))))
