; Named address constants follow dstogov/ir ir.c at 92171d0. See NOTICE.
(module stogir.symbols)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.strings" :as strings)
(import "stogir.prototype-bytes" :as prototype)
(import "coil.result" :use [Result Ok Err Some None])

(defn named? [(opcode u8)] (-> bool)
  (or (= opcode 74) (= opcode 75) (= opcode 77)))

(defn numeric? [(node n/Node)] (-> bool)
  (or (= (n/opcode node) (n/type-id node)) (= (n/opcode node) 73)))

(defn valid-prototype? [(graph g/Graph) (id i32)] (-> bool)
  (if (= id 0)
      true
      (if (or (< id 0) (>= id 65535))
          false
          (match (strings/lookup (.strings graph) id)
            (None [] false)
            (Some [bytes] (prototype/valid-bytes? bytes))))))

(defn valid-name? [(name (slice u8))] (-> bool)
  (let [(mut valid?) (> (len name) 0)
        (mut i) (: 0 i64)]
    (while (and valid? (< i (len name)))
      (when (= (get name i) 0) (set! valid? false))
      (set! i (+ i 1)))
    valid?))

(defn named! [(graph (mut g/Graph)) (opcode u8) (name (slice u8)) (proto i32)]
  (-> (Result i32 (slice u8)))
  (if (or (not (named? opcode))
          (and (!= opcode 77) (not (valid-name? name)))
          (not (valid-prototype? graph proto))
          (and (!= opcode 74) (!= proto 0)))
      (Err "invalid named address constant or prototype")
      (match (strings/intern! (mut (.strings graph)) name)
        (None [] (Err "symbol string space exhausted"))
        (Some [id]
              (match (g/intern-constant! (mut graph)
                                         opcode
                                         6
                                         (cast u16 proto)
                                         (cast u64 id))
                (None [] (Err "constant reference space exhausted"))
                (Some [reference] (Ok reference)))))))

(defn function! [(graph (mut g/Graph)) (name (slice u8)) (proto i32)]
  (-> (Result i32 (slice u8)))
  (named! (mut graph) 74 name proto))

(defn symbol! [(graph (mut g/Graph)) (name (slice u8))]
  (-> (Result i32 (slice u8)))
  (named! (mut graph) 75 name 0))

(defn string! [(graph (mut g/Graph)) (bytes (slice u8))]
  (-> (Result i32 (slice u8)))
  (named! (mut graph) 77 bytes 0))

(defn function-address! [(graph (mut g/Graph)) (address u64) (proto i32)]
  (-> (Result i32 (slice u8)))
  (if (not (valid-prototype? graph proto))
      (Err "invalid function prototype")
      (match (g/intern-constant! (mut graph) 73 6 (cast u16 proto) address)
        (Some [reference] (Ok reference))
        (None [] (Err "constant reference space exhausted")))))

(defn validate [(graph g/Graph) (node n/Node)] (-> bool)
  (let [opcode (n/opcode node)
        proto (cast i32 (n/auxiliary node))
        bits (n/constant-bits node)]
    (and (= (n/type-id node) 6)
         (if (= opcode 73)
             (valid-prototype? graph proto)
             (and (named? opcode)
                  (> bits 0)
                  (<= bits 2147483647)
                  (if (= opcode 74) (valid-prototype? graph proto) (= proto 0))
                  (match (strings/lookup (.strings graph) (cast i32 bits))
                    (None [] false)
                    (Some [bytes] (or (= opcode 77) (valid-name? bytes)))))))))
