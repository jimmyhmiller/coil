; Division control-guard validation follows dstogov/ir ir_check.c, 92171d0. See NOTICE.
;;; Structural verification; operation typing and dominance are separate passes.
(module stogir.verify)

(export classifications
        structure
        constants
        scalar-constants
        phis
        schedule-input
        native-operations
        native-input
        integer-operations-target
        integer-operations
        control-sources
        schedule-input-and-control
        native-input-and-control
        schedule-input-and-control-after-validate
        native-input-after-validate
        native-input-and-control-after-validate
        operations-and-phis-target
        operations-and-phis-target-structured
        operations-and-phis-target-noting
        operations-constants-and-phis-target
        operations-constants-and-phis-target-noting
        structure-noting
        phis-among
        phis-structured)

(import "stogir.graph" :as g)
(import "stogir.calls" :as calls)
(import "stogir.argument-value" :as argval)
(import "coil.primitive" :as p)
(import "stogir.uses" :as uses)
(import "stogir.copy" :as copy)
(import "stogir.atomic" :as atomic)
(import "stogir.vector" :as vector)
(import "stogir.vector-lanes" :as vl)
(import "stogir.long-constant" :as long)
(import "stogir.strings" :as strings)
(import "stogir.node" :as n)
(import "stogir.integer-unary" :as unary)
(import "stogir.integer-binary" :as binary)
(import "stogir.conditional" :as cond)
(import "stogir.checked" :as checked)
(import "stogir.conversion" :as conversion)
(import "stogir.floating" :as floating)
(import "stogir.locals" :as locals)
(import "stogir.stack" :as stack)
(import "stogir.switch" :as switch)
(import "stogir.terminal" :as terminal)
(import "stogir.symbols" :as symbols)
(import "stogir.opcode" :as op)
(import "stogir.validation-kind" :as kind)
(import "stogir.types" :as t)
(import "stogir.noted" :as noted)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.result" :use [Result Ok Err Some None])

;;; Whether a walk after structure's gives OPCODE a role of its own: PHI
;;; (phis-structured), PROTO, CALL and TAILCALL (calls/verify), SWITCH
;;; (switch/verify), START and the terminal chain members (terminal/verify-chains).
(defn noted? [(opcode i32)] (-> bool)
  (or (= opcode 67) (= opcode 40) (= opcode 79) (= opcode 80) (= opcode 117)
      (= opcode 104) (terminal/chain? opcode)))

;;; The list handed to structure-noting is never filled without NOTING, so it
;;; never allocates; it is built on the process allocator rather than the
;;; graph's so that no path from here can touch the graph's allocator.
(defn structure [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (let [(mut unused) (noted/create (malloc-allocator))]
    (structure-noting graph (mut unused) false)))

;;; structure. With NOTING (NOTED empty on entry), every node start whose
;;; opcode satisfies noted? is also appended to NOTED's nodes, in increasing
;;; order. After success that lists exactly the nodes that phis-structured,
;;; calls/verify, switch/verify's SWITCH search and terminal/verify-chains act
;;; on, in the order their own walks over the same unchanged graph reach them:
;;; those walks step from node start to node start by the same arity extents
;;; this one checks. NOTED's switch-uses likewise receives every reference
;;; operand (a kind uses/edge-code? accepts) whose value is a SWITCH node
;;; start, in walk order: the edges switch/verify's own operand scan gathers.
(defn structure-noting [(graph g/Graph) (noted (mut noted/Noted)) (noting bool)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut r) 1
        (mut checked) (: 0 i32)
        ; The graph is not edited during the walk: its storage is read through
        ; these once-loaded bounds and bases. Every index below is checked
        ; against them first, as the list accessors would check it.
        size (len (.instructions graph))
        words (p/cast (ptr i32) (.data (.instructions graph)))
        arities (.data (.arities graph))
        constant-count (len (.constants graph))
        spans? (= constant-count (len (.constant-spans graph)))
        spans (.data (.constant-spans graph))
        constants (p/cast (ptr i32) (.data (.constants graph)))]
    (when (!= size (len (.arities graph)))
      (set! error "instruction and arity storage lengths differ"))
    ; Positive cell references are i32; index0 is reserved. This is the same
    ; storage domain enforced by Graph.append-inputs-with-aux!.
    (when (and (= error "") (> size 2147483648))
      (set! error "instruction storage exceeds signed reference domain"))
    (while (and (= error "") (< r size))
      (let [header (cast u32 (load (p/index words (* r 4))))
            opcode (cast i32 (& header 255))
            ty (cast i32 (& (>> header 8) 255))
            count (load (p/index arities r))]
        (if (or (< count 0) (> count 65535))
            (set! error "invalid node start or operand count")
            (if (or (not (op/valid? opcode))
                    (not (t/valid? ty)))
                (set! error "invalid opcode or type")
                (if (and (>= (op/operand-slots opcode) 0)
                         (!= count (op/operand-slots opcode)))
                    (set! error "operand count does not match opcode")
                    (do
                      (when (and (= (op/input-count opcode) -1)
                                 (!= count (cast i32 (>> header 16))))
                        (set! error "variable input header count mismatch"))
                      (when (and noting (noted? opcode))
                        (push! (mut (.nodes noted)) (cast i32 r)))
                      (let [cells (/ (+ (cast i64 count) 4) 4)
                            shape-word (get (op/metadata) (cast i64 opcode))
                            (mut j) 1]
                        (when (> (+ r cells) size)
                          (set! error "truncated instruction"))
                        (while (and (= error "") (< j cells))
                          (when (!= (load (p/index arities (+ r j))) -1)
                            (set! error "invalid continuation marker"))
                          (set! j (+ j 1)))
                        (let [(mut i) (: 1 i32)]
                          (while (and (= error "") (<= i count))
                            ; Lengths, reference domain, count and complete
                            ; extent are checked before this loop. Thus word
                            ; 4r+i lies within the proven extent, including
                            ; continuation headers.
                            (let [kind (op/operand-code-word shape-word i)
                                  v (load (p/index words (+ (* r 4) (cast i64 i))))]
                              (when (= kind op/OPERAND-PRO)
                                (match (strings/lookup (.strings graph) v)
                                  (None []
                                        (set! error "dangling prototype string operand"))
                                  (Some [_] 0)))
                              (when (uses/edge-code? kind)
                                ; g/contains? over the bounds loaded above; the
                                ; instruction and arity lengths are equal here.
                                (let [present
                                        (if (> v 0)
                                            (and (< (cast i64 v) size)
                                                 (>= (load (p/index arities (cast i64 v))) 0))
                                            (and (< v 0)
                                                 spans?
                                                 (<= (- 0 (cast i64 v)) constant-count)
                                                 (> (load (p/index spans (- (- 0 (cast i64 v)) 1))) 0)))]
                                  (if present
                                      (let [target (& (load (if (> v 0)
                                                                (p/index words (* (cast i64 v) 4))
                                                                (p/index constants
                                                                         (* (- (- 0 (cast i64 v)) 1) 4))))
                                                      255)]
                                        ; A data operand must not name local storage.
                                        (when (and (= target 72)
                                                   (or (= kind op/OPERAND-DEF)
                                                       (= kind op/OPERAND-REF)))
                                          (set! error "local storage is not a register value"))
                                        (when (and noting (= target 117) (> v 0))
                                          (push! (mut (.switch-uses noted))
                                                 (noted/SwitchUse :target v
                                                                  :user (cast i32 r)
                                                                  :operand i))))
                                      ; op/optional-reference? for this operand's kind.
                                      (when (not (and (= v 0)
                                                      (or (= kind op/OPERAND-GRD)
                                                          (= kind op/OPERAND-RET)
                                                          (= kind op/OPERAND-LBL)
                                                          (and (= opcode 120) (= ty 0) (= i 2)))))
                                        (set! error "dangling reference operand"))))))
                            (set! i (+ i 1))))
                        (set! r (+ r cells))
                        (set! checked (+ checked 1)))))))))
    (if (= error "") (Ok checked) (Err error))))

;;; Validate every constant header and its complete storage extent. Payload
;;; cells are not values; reverse traversal matches negative-reference ordering.
(defn constants [(graph g/Graph) (pointer-bytes i32)]
  (-> (Result i64 (slice u8)))
  (let [(mut error) ""
        (mut i) (- (len (.constants graph)) 1)
        (mut checked) (: 0 i64)]
    (when (not (or (= pointer-bytes 4) (= pointer-bytes 8)))
      (set! error "invalid target pointer width"))
    (when (!= (len (.constants graph)) (len (.constant-spans graph)))
      (set! error "constant and span storage lengths differ"))
    (while (and (= error "") (>= i 0))
      (let [node (get (.constants graph) i)
            span (get (.constant-spans graph) i)
            reference (cast i32 (- -1 i))
            ty (cast i32 (n/type-id node))
            bits (n/constant-bits node)
            previous (.op1 node)]
        (if (= (n/opcode node) 78)
            (if (or (not (long/valid-header? node pointer-bytes))
                    (!= span (long/cells (cast i64 (n/auxiliary node))))
                    (< i (- (cast i64 span) 1)))
                (set! error "invalid LONG_CONST type, size or storage extent")
                (let [(mut j) (: 1 i64)
                      (mut hash) (: 5381 u32)]
                  (while (and (= error "") (< j (cast i64 span)))
                    (when (!= (get (.constant-spans graph) (- i j)) 0)
                      (set! error "invalid LONG_CONST continuation marker"))
                    (set! j (+ j 1)))
                  (set! j 0)
                  (while (and (= error "") (< j (cast i64 (n/auxiliary node))))
                    (match (g/long-byte graph reference j)
                      (None [] (set! error "LONG_CONST payload missing"))
                      (Some [byte] (set! hash (long/hash-step hash byte))))
                    (set! j (+ j 1)))
                  (when (!= bits (cast u64 (^ hash (.header node))))
                    (set! error "LONG_CONST payload hash mismatch"))))
            (if (!= span 1)
                (set! error "invalid constant header or orphan payload cell")
                (let [size (t/scalar-size ty pointer-bytes)]
                  (if (= (cast i32 (n/opcode node)) ty)
                      (if (<= size 0)
                          (set! error "invalid scalar constant type")
                          (when (or (and (= ty 1) (> bits 1))
                                    (and (< size 8)
                                         (!= (>> bits (cast u64 (* size 8))) 0)))
                            (set! error
                                  "scalar constant payload exceeds type width")))
                      (if (not (symbols/validate graph node))
                          (set! error
                                "invalid address constant opcode, name or prototype")
                          (when (and (= (n/opcode node) 73)
                                     (= pointer-bytes 4)
                                     (!= (>> bits 32) 0))
                            (set! error
                                  "function address exceeds target pointer width")))))))
        (when (or (> previous 0)
                  (and (!= previous 0)
                       (or (<= previous reference)
                           (not (g/contains? graph previous)))))
          (set! error "constant chain must refer to an earlier header"))
        (set! i (- i (cast i64 span)))
        (set! checked (+ checked 1))))
    (if (= error "") (Ok checked) (Err error))))

;;; Compatibility entry point; includes LONG_CONST validation as well.
(defn scalar-constants [(graph g/Graph) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (constants graph pointer-bytes)
    (Err [message] (Err message))
    (Ok [count]
        (if (> count 2147483647)
            (Err "constant count exceeds compatibility result width")
            (Ok (cast i32 count))))))

;;; The Phi checks of one node start holding opcode 67; "" when all pass.
(defn phi-error [(graph g/Graph) (r i64) (node n/Node) (count i32)] (-> (slice u8))
  (let [(mut error) ""]
    (if (< count 3)
        (set! error "phi requires region and at least two values")
        (match (g/operand graph (cast i32 r) 1)
          (None [] (set! error "phi lacks region"))
          (Some [region]
                (match (g/lookup graph region)
                  (None [] (set! error "phi region missing"))
                  (Some [header]
                        (if (or (<= region 0)
                                (not (or (= (n/opcode header) 112)
                                         (= (n/opcode header) 113))))
                            (set! error
                                  "phi region must be MERGE or LOOP_BEGIN")
                            (when (!= count
                                      (+ 1
                                         (get (.arities graph)
                                              (cast i64 region))))
                              (set! error
                                    "phi values do not match region predecessors"))))))))
    (when (= (n/type-id node) 0)
      (set! error "phi cannot have void type"))
    (let [(mut i) (: 2 i32)]
      (while (and (= error "") (<= i count))
        (match (g/operand graph (cast i32 r) i)
          (None [] (set! error "phi value missing"))
          (Some [value]
                (match (g/lookup graph value)
                  (None [] (set! error "phi value missing"))
                  (Some [incoming]
                        (when (!= (n/type-id incoming)
                                  (n/type-id node))
                          (set! error "phi incoming type mismatch"))))))
        (set! i (+ i 1))))
    error))

;;; Phi-specific semantics, run after structural verification succeeds.
(defn phis-structured [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (phis-walk graph [] false))

;;; phis-structured for a graph that structure-noting has just passed, with
;;; NOTED the nodes it listed: the Phis are visited through that list.
(defn phis-among [(graph g/Graph) (noted (slice i32))] (-> (Result i32 (slice u8)))
  (phis-walk graph noted true))

;;; One loop serves both: LISTED steps through NOTED, otherwise through every
;;; node start.
(defn phis-walk [(graph g/Graph) (noted (slice i32)) (listed bool)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut checked) (: 0 i32)
        (mut k) (: 0 i64)
        (mut r) 1]
    (while (and (= error "")
                (if listed (< k (len noted)) (< r (len (.instructions graph)))))
      (when listed (set! r (cast i64 (get noted k))))
      (let [node (get (.instructions graph) r)
            count (get (.arities graph) r)]
        (when (= (n/opcode node) 67)
          (set! error (phi-error graph r node count))
          (set! checked (+ checked 1)))
        (if listed
            (set! k (+ k 1))
            (set! r (+ r (/ (+ (cast i64 count) 4) 4))))))
    (if (= error "") (Ok checked) (Err error))))

(defn phis [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (match (structure graph)
    (Err [message] (Err message))
    (Ok [_] (phis-structured graph))))

(defstruct Classifications [(vector? bool) (floating? bool)])

;;; Whether any instruction node or constant cell of GRAPH has a vector type.
;;; Every data operand a node can read is one of those cells (g/borrow-node
;;; yields only node starts and constant cells), so when this is false no
;;; operand of any node is a vector.
(defn vector-typed? [(graph g/Graph)] (-> bool)
  (let [(mut found) false
        (mut i) (: 0 i64)
        cells (if (< (len (.instructions graph)) (len (.arities graph)))
                  (len (.instructions graph))
                  (len (.arities graph)))]
    (while (and (not found) (< i cells))
      (when (and (>= (get (.arities graph) i) 0)
                 (t/vector? (cast i32 (n/type-id (get (.instructions graph) i)))))
        (set! found true))
      (set! i (+ i 1)))
    (set! i 0)
    (while (and (not found) (< i (len (.constants graph))))
      (when (t/vector? (cast i32 (n/type-id (get (.constants graph) i))))
        (set! found true))
      (set! i (+ i 1)))
    found))

;;; The structural cursor has already checked this instruction and its arity.
;;; Consume input borrows immediately. The two predicates remain independent:
;;; a vector second input must not suppress the original floating predicate.
(defn classifications [(graph g/Graph) (reference i32) (node n/Node) (count i32)]
  (-> Classifications)
  (classifications-among graph reference node count true))

;;; As classifications. VECTORS false states that vector-typed? is false for
;;; this graph: the node and each operand then have scalar types, so the
;;; operand walk, which could only look for a vector one, is not made.
(defn classifications-among [(graph g/Graph) (reference i32) (node n/Node) (count i32)
                             (vectors bool)]
  (-> Classifications)
  (let [ty (cast i32 (n/type-id node))
        opcode (cast i32 (n/opcode node))
        (mut vector?) (t/vector? ty)
        floating-family? (floating/operation? opcode)
        first-read? (and floating-family? (not vector?))
        (mut first-type) (: -1 i32)
        (mut i) (: 1 i32)]
    (when first-read?
      (let [cell (g/borrow-node graph (.op1 node))]
        (when (!= cell (p/cast (ptr n/Node) 0))
          (set! first-type (cast i32 (n/type-id (load cell)))))))
    (let [floating?
            (and first-read? (not (t/vector? first-type))
                 (or (= opcode 24) (= opcode 25) (t/floating? ty)
                     (t/floating? first-type)))]
      (while (and vectors (not vector?) (<= i count))
        (let [kind (op/operand-code opcode i)]
          (when (or (= kind op/OPERAND-DEF) (= kind op/OPERAND-REF))
            (if (and (= i 1) first-read?)
                (set! vector? (t/vector? first-type))
                ; These fields belong to the validated cursor itself. Only
                ; continuation payloads require another checked cell access.
                (let [input (case i
                              1 (.op1 node)
                              2 (.op2 node)
                              3 (.op3 node)
                              (match (g/operand graph reference i)
                                (None [] 0)
                                (Some [r] r)))
                      cell (g/borrow-node graph input)]
                  (when (and (!= cell (p/cast (ptr n/Node) 0))
                             (t/vector? (cast i32 (n/type-id (load cell)))))
                    (set! vector? true))))))
        (set! i (+ i 1)))
      (Classifications :vector? vector? :floating? floating?))))

;;; Only for a data operand of the immutable graph after structure succeeds.
;;; structure checked DEF/REF membership, including constant span headers, before
;;; this phase. Zero remains null for optional data roles. Promote reference to
;;; i64 before negation so the signed minimum cannot overflow during indexing.
;;; This private borrow is consumed immediately; no graph mutation intervenes.
(defn structured-data-cell [(graph g/Graph) (reference i32)] (-> (ptr n/Node))
  (if (= reference 0) (p/cast (ptr n/Node) 0)
      (if (> reference 0)
          (p/index (.data (.instructions graph)) (cast i64 reference))
          (p/index (.data (.constants graph)) (- (- 0 (cast i64 reference)) 1)))))

;;; Validate implemented scalar families, COPY, RETURN and registered vector roles.
;;; Other opcode families are outside this pass, not implicitly validated.
;;; The caller has successfully run structure on this immutable graph. Operand
;;; fields1/2 therefore exist in the current header. Structure also proved
;;; DEF/REF membership; semantic type/width rules remain checked below.
;;; The calling target policy supplies a valid four/eight-byte pointer width.
(defn integer-operations-target-structured [(graph g/Graph) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut checked) (: 0 i32)
        vectors (vector-typed? graph)
        (mut r) 1]
    (while (and (= error "") (< r (len (.instructions graph))))
      (let [node (get (.instructions graph) r)
            opcode (cast i32 (n/opcode node))
            count (get (.arities graph) r)
            families (kind/flags opcode)
            comparison? (and (>= opcode 14) (<= opcode 23))
            binary? (!= (& families kind/BINARY) 0)
            unary? (!= (& families kind/UNARY) 0)
            ; These pure classifications share the same immutable node/graph.
            ; Reuse only within this iteration; all validators still run below.
            classes (classifications-among graph (cast i32 r) node count vectors)
            vector-values? (.vector? classes)
            floating-values? (.floating? classes)]
        (when (or (!= (& families kind/LANES) 0)
                  vector-values?)
          (match (vector/validate graph (cast i32 r) pointer-bytes)
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (and (= opcode 68)
                   (not vector-values?))
          (match (copy/validate graph (cast i32 r))
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (and (or (= opcode 29) (= opcode 30)) (!= (.op3 node) 0))
          (match (g/lookup graph (.op3 node))
            (None [] (set! error "division guard missing"))
            (Some [guard]
                  (when (or (< (.op3 node) 0)
                            (not (or (op/block-start? (cast i32
                                                            (n/opcode guard)))
                                     (= (n/opcode guard) 101)
                                     (= (n/opcode guard) 102))))
                    (set! error
                          "division guard must be a block start or guard")))))
        ; Preserve every family check and its diagnostic priority.
        ; Ordinary arithmetic nodes have none of these semantic roles.
        (when (or (= opcode 44)
                  (!= (& families (cast i32 (| kind/CHECKED (| kind/ATOMIC (| kind/TERMINAL (| kind/SWITCH (| kind/STACK (| kind/LOCALS kind/CONVERSION)))))))) 0))
          (when (or (!= (& families kind/CHECKED) 0) (= opcode 44))
            (match (if (= opcode 44)
                       (checked/validate-projection graph (cast i32 r))
                       (checked/validate graph (cast i32 r)))
              (Err [message] (set! error message))
              (Ok [_] (set! checked (+ checked 1)))))
          (when (!= (& families kind/ATOMIC) 0)
            (match (atomic/validate graph (cast i32 r))
              (Err [message] (set! error message))
              (Ok [_] (set! checked (+ checked 1)))))
          (when (!= (& families kind/TERMINAL) 0)
            (match (terminal/validate graph (cast i32 r))
              (Err [message] (set! error message))
              (Ok [_] (set! checked (+ checked 1)))))
          (when (!= (& families kind/SWITCH) 0)
            (match (switch/validate graph (cast i32 r))
              (Err [message] (set! error message))
              (Ok [_] (set! checked (+ checked 1)))))
          (when (!= (& families kind/STACK) 0)
            (match (stack/validate graph (cast i32 r))
              (Err [message] (set! error message))
              (Ok [_] (set! checked (+ checked 1)))))
          (when (!= (& families kind/LOCALS) 0)
            (match (locals/validate graph (cast i32 r) pointer-bytes)
              (Err [message] (set! error message))
              (Ok [_] (set! checked (+ checked 1)))))
          (when (!= (& families kind/CONVERSION) 0)
            (match (conversion/validate graph (cast i32 r) pointer-bytes)
              (Err [message] (set! error message))
              (Ok [_] (set! checked (+ checked 1)))))
)
        (when (= opcode 60)
          (match (cond/validate graph (cast i32 r))
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (= opcode 120)
          (if (= (n/type-id node) 0)
              (when (!= (.op2 node) 0)
                (set! error "void return cannot have a value"))
              (match (g/lookup graph (.op2 node))
                (None [] (set! error "return value missing"))
                (Some [value]
                      (when (!= (n/type-id value) (n/type-id node))
                        (set! error "return value type mismatch")))))
          (set! checked (+ checked 1)))
        (when floating-values?
          (match (floating/validate graph (cast i32 r))
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (and (not vector-values?)
                   (not floating-values?)
                   (or comparison? binary? unary?))
          (let [left-cell (structured-data-cell graph (.op1 node))]
            (if (= left-cell (p/cast (ptr n/Node) 0))
                (set! error "missing integer operand")
                ; Structure proved these data references; consume immediately.
                (let [ty (cast i32 (n/type-id (load left-cell)))
                      pointer? (and (= (n/type-id node) 6)
                                    (= ty 6)
                                    (or (= opcode 26) (= opcode 27)))]
                  (when (or (not (t/integer? ty))
                            (and unary? (not (unary/valid-type? opcode ty)))
                            (and binary? (not (binary/valid-type? opcode ty))))
                    (set! error "invalid integer operand type"))
                  (when (!= (cast i32 (n/type-id node))
                            (if comparison? 1 ty))
                    (set! error "integer operation result type mismatch"))
                  (when (or comparison? binary?)
                    (let [right-cell (structured-data-cell graph (.op2 node))]
                      (if (= right-cell (p/cast (ptr n/Node) 0))
                          (set! error "missing right integer operand")
                          (let [right-ty (cast i32 (n/type-id (load right-cell)))]
                            (when (not (or (= ty right-ty)
                                           (and pointer?
                                                (or (= right-ty 5)
                                                    (= right-ty 11)))))
                              (set! error "integer operand type mismatch")))))))))
          (set! checked (+ checked 1)))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    (if (= error "") (Ok checked) (Err error))))

(defn integer-operations-target [(graph g/Graph) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (structure graph)
    (Err [message] (Err message))
    (Ok [_] (integer-operations-target-structured graph pointer-bytes))))

;;; Check source-control edges; block projection and dominance rules are separate.

;;; Existing native entry points target AArch64 with eight-byte addresses.
(defn integer-operations [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (integer-operations-target graph 8))

(defn control-sources-structured [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut checked) (: 0 i32)
        (mut r) 1]
    (while (and (= error "") (< r (len (.instructions graph))))
      (let [node (get (.instructions graph) r)
            opcode (cast i32 (n/opcode node))
            count (get (.arities graph) r)
            ; The word op/operand-code decodes for every operand of this node.
            ; Operand i reads nibble i-1, and nibble 4 from the fifth on, so a
            ; word with no SRC nibble gives no operand of this node the role.
            facts (if (op/valid? opcode) (get (op/metadata) (cast i64 opcode)) (: 0 u32))
            sources (or (= (& facts 15) op/OPERAND-SRC)
                        (= (& (>> facts 4) 15) op/OPERAND-SRC)
                        (= (& (>> facts 8) 15) op/OPERAND-SRC)
                        (= (& (>> facts 12) 15) op/OPERAND-SRC)
                        (= (& (>> facts 16) 15) op/OPERAND-SRC))
            (mut i) (: 1 i32)]
        (while (and sources (= error "") (<= i count))
          (when (= (op/operand-code-word facts i) op/OPERAND-SRC)
            (match (g/operand graph (cast i32 r) i)
              (None [] (set! error "control source missing"))
              (Some [source]
                    (if (<= source 0)
                        (set! error
                              "control source must be an instruction")
                        (match (g/lookup graph source)
                          (None [] (set! error "control source missing"))
                          (Some [producer]
                                (when (not (op/control? (cast i32
                                                              (n/opcode producer))))
                                  (set! error
                                        "control source is a data node")))))))
            (set! checked (+ checked 1)))
          (set! i (+ i 1)))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    (if (= error "") (Ok checked) (Err error))))

(defn control-sources [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (match (structure graph)
    (Err [msg] (Err msg))
    (Ok [_] (control-sources-structured graph))))

;;; A single immutable transaction shares its immediate structural check.
;;; Helpers are not exported; callers cannot retain or reuse a stale proof.
;;; Return the Phi check count, exactly as the prior sequential composition did.
(defn operations-and-phis-target [(graph g/Graph) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (structure graph)
    (Err [message] (Err message))
    (Ok [_]
        (match (integer-operations-target-structured graph pointer-bytes)
          (Err [message] (Err message))
          (Ok [_] (phis-structured graph))))))

;;; operations-and-phis-target for a graph the caller has just passed through
;;; structure, with no edit in between.
(defn operations-and-phis-target-structured [(graph g/Graph) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (integer-operations-target-structured graph pointer-bytes)
    (Err [message] (Err message))
    (Ok [_] (phis-structured graph))))

;;; Preserve rewrite validation's operations, constants, Phi diagnostic order.
(defn operations-constants-and-phis-target [(graph g/Graph) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (structure graph)
    (Err [message] (Err message))
    (Ok [_]
        (match (integer-operations-target-structured graph pointer-bytes)
          (Err [message] (Err message))
          (Ok [_]
              (match (constants graph pointer-bytes)
                (Err [message] (Err message))
                (Ok [_] (phis-structured graph))))))))

;;; operations-constants-and-phis-target, also filling NOTED (empty on entry)
;;; as structure-noting does; the Phi check reads its nodes from that list.
(defn operations-constants-and-phis-target-noting [(graph g/Graph) (pointer-bytes i32)
                                                   (noted (mut noted/Noted))]
  (-> (Result i32 (slice u8)))
  (match (structure-noting graph (mut noted) true)
    (Err [message] (Err message))
    (Ok [_]
        (match (integer-operations-target-structured graph pointer-bytes)
          (Err [message] (Err message))
          (Ok [_]
              (match (constants graph pointer-bytes)
                (Err [message] (Err message))
                (Ok [_] (phis-among graph (slice (.nodes noted))))))))))

;;; operations-and-phis-target, also filling NOTED (empty on entry) likewise.
(defn operations-and-phis-target-noting [(graph g/Graph) (pointer-bytes i32)
                                         (noted (mut noted/Noted))]
  (-> (Result i32 (slice u8)))
  (match (structure-noting graph (mut noted) true)
    (Err [message] (Err message))
    (Ok [_]
        (match (integer-operations-target-structured graph pointer-bytes)
          (Err [message] (Err message))
          (Ok [_] (phis-among graph (slice (.nodes noted))))))))

;;; One immutable transaction preserves pipeline's structure, entry/root and
;;; Phi diagnostic ordering without checking the same structure twice. No proof
;;; escapes this call; the ordinary public phis entry still checks its own input.
(defn schedule-input [(graph g/Graph) (entry i32) (roots (slice i32))]
  (-> (Result i32 (slice u8)))
  (match (structure graph)
    (Err [message] (Err message))
    (Ok [_] (schedule-input-structured graph entry roots))))

(defn schedule-input-structured [(graph g/Graph) (entry i32) (roots (slice i32))]
  (-> (Result i32 (slice u8)))
  (match (entry-and-roots graph entry roots)
    (Err [message] (Err message))
    (Ok [_] (phis-structured graph))))

(defn entry-and-roots [(graph g/Graph) (entry i32) (roots (slice i32))]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""]
    (match (g/lookup graph entry)
      (None [] (set! error "entry missing"))
      (Some [instruction]
            (when (or (<= entry 0)
                      (not (op/block-start? (cast i32
                                                      (n/opcode instruction)))))
              (set! error "entry must be a block start"))))
    (when (= (len roots) 0)
      (set! error "compilation requires observable roots"))
    (for root roots
      (when (or (<= root 0) (not (g/contains? graph root)))
        (set! error "invalid root reference")))
    (if (= error "") (Ok 0) (Err error))))


;;; Verification only reads GRAPH. Its scratch lists (SWITCH, terminal chain
;;; and ARGVAL indices) come from ALLOCATOR, the allocator of the compile call
;;; that asked: never from the graph's own allocator, which an embedder may
;;; share between graphs that other threads are compiling.
(defn native-operations [(graph g/Graph) (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (constants graph 8)
    (Err [message] (Err message))
    (Ok [_]
      (match (structure graph)
        (Err [message] (Err message))
        (Ok [_]
          (match (integer-operations-target-structured graph 8)
            (Err [message] (Err message))
            (Ok [_]
              (match (switch/verify graph allocator)
                (Err [message] (Err message))
                (Ok [_]
                  (match (terminal/verify-chains graph allocator)
                    (Err [message] (Err message))
                    (Ok [_]
                      (match (argval/verify graph allocator)
                        (Err [message] (Err message))
                        (Ok [_] (calls/verify graph allocator))))))))))))))

;;; Complete native input transaction: no mutation or stored proof between the
;;; operation checks and entry/root/Phi checks. All public inputs are checked.
(defn native-input [(graph g/Graph) (entry i32) (roots (slice i32))
                    (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (native-operations graph allocator)
    (Err [message] (Err message))
    (Ok [_] (schedule-input-structured graph entry roots))))

;;; Scheduling input checks followed by control-source checks, in the order the
;;; separate schedule-input and control-sources calls report, with one
;;; structural check. For cfg/build-verified on exactly this graph.
(defn schedule-input-and-control [(graph g/Graph) (entry i32) (roots (slice i32))]
  (-> (Result i32 (slice u8)))
  (match (schedule-input graph entry roots)
    (Err [message] (Err message))
    (Ok [_] (control-sources-structured graph))))

;;; The after-validate checks are for a graph whose exact content passed
;;; sccp-rewrite/validate at eight-byte pointers, established by the caller
;;; for this unchanged graph (its content hash equals the recorded proof).
;;; That validation covers structure, operations, constants, Phis, terminal
;;; chains, calls and SWITCH; these add the remaining native-input checks
;;; (argument values, entry and roots) and, for the -and-control forms,
;;; control sources.
(defn native-input-after-validate [(graph g/Graph) (entry i32) (roots (slice i32))
                                   (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (argval/verify graph allocator)
    (Err [message] (Err message))
    (Ok [_] (entry-and-roots graph entry roots))))

(defn native-input-and-control-after-validate [(graph g/Graph) (entry i32)
                                               (roots (slice i32))
                                               (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (native-input-after-validate graph entry roots allocator)
    (Err [message] (Err message))
    (Ok [_] (control-sources-structured graph))))

(defn schedule-input-and-control-after-validate [(graph g/Graph) (entry i32)
                                                 (roots (slice i32))]
  (-> (Result i32 (slice u8)))
  (match (entry-and-roots graph entry roots)
    (Err [message] (Err message))
    (Ok [_] (control-sources-structured graph))))

;;; native-input then control sources, with one structural check.
(defn native-input-and-control [(graph g/Graph) (entry i32) (roots (slice i32))
                                (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (native-input graph entry roots allocator)
    (Err [message] (Err message))
    (Ok [_] (control-sources-structured graph))))
