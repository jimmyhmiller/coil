; Division control-guard validation follows dstogov/ir ir_check.c, 92171d0. See NOTICE.
;;; Structural verification; operation typing and dominance are separate passes.
(module stogir.verify)

(export classifications
        structure
        constants
        scalar-constants
        phis
        schedule-input
        native-operations
        native-input
        integer-operations-target
        integer-operations
        control-sources
        operations-and-phis-target
        operations-constants-and-phis-target)

(import "stogir.graph" :as g)
(import "stogir.calls" :as calls)
(import "stogir.argument-value" :as argval)
(import "coil.primitive" :as p)
(import "stogir.uses" :as uses)
(import "stogir.copy" :as copy)
(import "stogir.atomic" :as atomic)
(import "stogir.vector" :as vector)
(import "stogir.vector-lanes" :as vl)
(import "stogir.long-constant" :as long)
(import "stogir.strings" :as strings)
(import "stogir.node" :as n)
(import "stogir.integer-unary" :as unary)
(import "stogir.integer-binary" :as binary)
(import "stogir.conditional" :as cond)
(import "stogir.checked" :as checked)
(import "stogir.conversion" :as conversion)
(import "stogir.floating" :as floating)
(import "stogir.locals" :as locals)
(import "stogir.stack" :as stack)
(import "stogir.switch" :as switch)
(import "stogir.terminal" :as terminal)
(import "stogir.symbols" :as symbols)
(import "stogir.opcode" :as op)
(import "stogir.validation-kind" :as kind)
(import "stogir.types" :as t)
(import "coil.result" :use [Result Ok Err Some None])

(defn structure [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut r) 1
        (mut checked) (: 0 i32)]
    (when (!= (len (.instructions graph)) (len (.arities graph)))
      (set! error "instruction and arity storage lengths differ"))
    ; Positive cell references are i32; index0 is reserved. This is the same
    ; storage domain enforced by Graph.append-inputs-with-aux!.
    (when (and (= error "") (> (len (.instructions graph)) 2147483648))
      (set! error "instruction storage exceeds signed reference domain"))
    (while (and (= error "") (< r (len (.instructions graph))))
      (let [node (get (.instructions graph) r)
            opcode (cast i32 (n/opcode node))
            count (get (.arities graph) r)]
        (if (or (< count 0) (> count 65535))
            (set! error "invalid node start or operand count")
            (if (or (not (op/valid? opcode))
                    (not (t/valid? (cast i32 (n/type-id node)))))
                (set! error "invalid opcode or type")
                (if (and (>= (op/operand-slots opcode) 0)
                         (!= count (op/operand-slots opcode)))
                    (set! error "operand count does not match opcode")
                    (do
                      (when (and (= (op/input-count opcode) -1)
                                 (!= count (cast i32 (n/auxiliary node))))
                        (set! error "variable input header count mismatch"))
                      (let [cells (/ (+ (cast i64 count) 4) 4)
                            shape-word (get (op/metadata) (cast i64 opcode))
                            (mut j) 1]
                        (when (> (+ r cells) (len (.instructions graph)))
                          (set! error "truncated instruction"))
                        (while (and (= error "") (< j cells))
                          (when (!= (get (.arities graph) (+ r j)) -1)
                            (set! error "invalid continuation marker"))
                          (set! j (+ j 1)))
                        (let [(mut i) (: 1 i32)]
                          (while (and (= error "") (<= i count))
                            ; Lengths, reference domain, count and complete
                            ; extent are checked before this loop. Thus i/4
                            ; selects a cell within the proven extent, including
                            ; continuation headers, and i%4 its signed word.
                            (let [kind (op/operand-code-word shape-word i)
                                  word (cast u32 i)
                                  cell (at (.instructions graph) (+ r (cast i64 (/ word 4))))
                                  slot (cast i64 (% word 4))
                                  v (load (p/index (p/cast (ptr i32) cell) slot))]
                                      (let [data?
                                              (or (= kind op/OPERAND-DEF)
                                                  (= kind op/OPERAND-REF))
                                            (mut present) false]
                                        ; Checked membership is identical to lookup.
                                        ; Consume the cell before leaving this scope;
                                        ; the verifier never mutates graph storage.
                                        (when data?
                                          (let [cell (g/borrow-node graph v)]
                                            (set! present
                                                  (!= cell
                                                      (p/cast (ptr n/Node) 0)))
                                            (when (and present
                                                       (= (n/opcode (load cell))
                                                          72))
                                              (set! error
                                                    "local storage is not a register value"))))
                                        (when (= kind op/OPERAND-PRO)
                                          (match (strings/lookup (.strings graph)
                                                                 v)
                                            (None []
                                                  (set! error
                                                        "dangling prototype string operand"))
                                            (Some [_] 0)))
                                        (when (uses/edge-code? kind)
                                          (when (not (or (if data?
                                                             present
                                                             (g/contains? graph
                                                                          v))
                                                         (and (= v 0)
                                                              (op/optional-reference? opcode
                                                                                      (cast i32
                                                                                            (n/type-id node))
                                                                                      i))))
                                            (set! error
                                                  "dangling reference operand")))))
                            (set! i (+ i 1))))
                        (set! r (+ r cells))
                        (set! checked (+ checked 1)))))))))
    (if (= error "") (Ok checked) (Err error))))

;;; Validate every constant header and its complete storage extent. Payload
;;; cells are not values; reverse traversal matches negative-reference ordering.
(defn constants [(graph g/Graph) (pointer-bytes i32)]
  (-> (Result i64 (slice u8)))
  (let [(mut error) ""
        (mut i) (- (len (.constants graph)) 1)
        (mut checked) (: 0 i64)]
    (when (not (or (= pointer-bytes 4) (= pointer-bytes 8)))
      (set! error "invalid target pointer width"))
    (when (!= (len (.constants graph)) (len (.constant-spans graph)))
      (set! error "constant and span storage lengths differ"))
    (while (and (= error "") (>= i 0))
      (let [node (get (.constants graph) i)
            span (get (.constant-spans graph) i)
            reference (cast i32 (- -1 i))
            ty (cast i32 (n/type-id node))
            bits (n/constant-bits node)
            previous (.op1 node)]
        (if (= (n/opcode node) 78)
            (if (or (not (long/valid-header? node pointer-bytes))
                    (!= span (long/cells (cast i64 (n/auxiliary node))))
                    (< i (- (cast i64 span) 1)))
                (set! error "invalid LONG_CONST type, size or storage extent")
                (let [(mut j) (: 1 i64)
                      (mut hash) (: 5381 u32)]
                  (while (and (= error "") (< j (cast i64 span)))
                    (when (!= (get (.constant-spans graph) (- i j)) 0)
                      (set! error "invalid LONG_CONST continuation marker"))
                    (set! j (+ j 1)))
                  (set! j 0)
                  (while (and (= error "") (< j (cast i64 (n/auxiliary node))))
                    (match (g/long-byte graph reference j)
                      (None [] (set! error "LONG_CONST payload missing"))
                      (Some [byte] (set! hash (long/hash-step hash byte))))
                    (set! j (+ j 1)))
                  (when (!= bits (cast u64 (^ hash (.header node))))
                    (set! error "LONG_CONST payload hash mismatch"))))
            (if (!= span 1)
                (set! error "invalid constant header or orphan payload cell")
                (let [size (t/scalar-size ty pointer-bytes)]
                  (if (= (cast i32 (n/opcode node)) ty)
                      (if (<= size 0)
                          (set! error "invalid scalar constant type")
                          (when (or (and (= ty 1) (> bits 1))
                                    (and (< size 8)
                                         (!= (>> bits (cast u64 (* size 8))) 0)))
                            (set! error
                                  "scalar constant payload exceeds type width")))
                      (if (not (symbols/validate graph node))
                          (set! error
                                "invalid address constant opcode, name or prototype")
                          (when (and (= (n/opcode node) 73)
                                     (= pointer-bytes 4)
                                     (!= (>> bits 32) 0))
                            (set! error
                                  "function address exceeds target pointer width")))))))
        (when (or (> previous 0)
                  (and (!= previous 0)
                       (or (<= previous reference)
                           (not (g/contains? graph previous)))))
          (set! error "constant chain must refer to an earlier header"))
        (set! i (- i (cast i64 span)))
        (set! checked (+ checked 1))))
    (if (= error "") (Ok checked) (Err error))))

;;; Compatibility entry point; includes LONG_CONST validation as well.
(defn scalar-constants [(graph g/Graph) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (constants graph pointer-bytes)
    (Err [message] (Err message))
    (Ok [count]
        (if (> count 2147483647)
            (Err "constant count exceeds compatibility result width")
            (Ok (cast i32 count))))))

;;; Phi-specific semantics, run after structural verification succeeds.
(defn phis-structured [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut checked) (: 0 i32)
        (mut r) 1]
    (while (and (= error "") (< r (len (.instructions graph))))
      (let [node (get (.instructions graph) r)
            count (get (.arities graph) r)]
        (when (= (n/opcode node) 67)
          (if (< count 3)
              (set! error "phi requires region and at least two values")
              (match (g/operand graph (cast i32 r) 1)
                (None [] (set! error "phi lacks region"))
                (Some [region]
                      (match (g/lookup graph region)
                        (None [] (set! error "phi region missing"))
                        (Some [header]
                              (if (or (<= region 0)
                                      (not (or (= (n/opcode header) 112)
                                               (= (n/opcode header) 113))))
                                  (set! error
                                        "phi region must be MERGE or LOOP_BEGIN")
                                  (when (!= count
                                            (+ 1
                                               (get (.arities graph)
                                                    (cast i64 region))))
                                    (set! error
                                          "phi values do not match region predecessors"))))))))
          (when (= (n/type-id node) 0)
            (set! error "phi cannot have void type"))
          (let [(mut i) (: 2 i32)]
            (while (and (= error "") (<= i count))
              (match (g/operand graph (cast i32 r) i)
                (None [] (set! error "phi value missing"))
                (Some [value]
                      (match (g/lookup graph value)
                        (None [] (set! error "phi value missing"))
                        (Some [incoming]
                              (when (!= (n/type-id incoming)
                                        (n/type-id node))
                                (set! error "phi incoming type mismatch"))))))
              (set! i (+ i 1))))
          (set! checked (+ checked 1)))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    (if (= error "") (Ok checked) (Err error))))

(defn phis [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (match (structure graph)
    (Err [message] (Err message))
    (Ok [_] (phis-structured graph))))

(defstruct Classifications [(vector? bool) (floating? bool)])

;;; The structural cursor has already checked this instruction and its arity.
;;; Consume input borrows immediately. The two predicates remain independent:
;;; a vector second input must not suppress the original floating predicate.
(defn classifications [(graph g/Graph) (reference i32) (node n/Node) (count i32)]
  (-> Classifications)
  (let [ty (cast i32 (n/type-id node))
        opcode (cast i32 (n/opcode node))
        (mut vector?) (t/vector? ty)
        floating-family? (floating/operation? opcode)
        first-read? (and floating-family? (not vector?))
        (mut first-type) (: -1 i32)
        (mut i) (: 1 i32)]
    (when first-read?
      (let [cell (g/borrow-node graph (.op1 node))]
        (when (!= cell (p/cast (ptr n/Node) 0))
          (set! first-type (cast i32 (n/type-id (load cell)))))))
    (let [floating?
            (and first-read? (not (t/vector? first-type))
                 (or (= opcode 24) (= opcode 25) (t/floating? ty)
                     (t/floating? first-type)))]
      (while (and (not vector?) (<= i count))
        (let [kind (op/operand-code opcode i)]
          (when (or (= kind op/OPERAND-DEF) (= kind op/OPERAND-REF))
            (if (and (= i 1) first-read?)
                (set! vector? (t/vector? first-type))
                ; These fields belong to the validated cursor itself. Only
                ; continuation payloads require another checked cell access.
                (let [input (case i
                              1 (.op1 node)
                              2 (.op2 node)
                              3 (.op3 node)
                              (match (g/operand graph reference i)
                                (None [] 0)
                                (Some [r] r)))
                      cell (g/borrow-node graph input)]
                  (when (and (!= cell (p/cast (ptr n/Node) 0))
                             (t/vector? (cast i32 (n/type-id (load cell)))))
                    (set! vector? true))))))
        (set! i (+ i 1)))
      (Classifications :vector? vector? :floating? floating?))))

;;; Validate implemented scalar families, COPY, RETURN and registered vector roles.
;;; Other opcode families are outside this pass, not implicitly validated.
;;; The caller has successfully run structure on this immutable graph. Operand
;;; fields1/2 therefore exist in the current header; referenced cells and all
;;; type/width rules still require the checks below.
;;; The calling target policy supplies a valid four/eight-byte pointer width.
(defn integer-operations-target-structured [(graph g/Graph) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut checked) (: 0 i32)
        (mut r) 1]
    (while (and (= error "") (< r (len (.instructions graph))))
      (let [node (get (.instructions graph) r)
            opcode (cast i32 (n/opcode node))
            count (get (.arities graph) r)
            families (kind/flags opcode)
            comparison? (and (>= opcode 14) (<= opcode 23))
            binary? (!= (& families kind/BINARY) 0)
            unary? (!= (& families kind/UNARY) 0)
            ; These pure classifications share the same immutable node/graph.
            ; Reuse only within this iteration; all validators still run below.
            classes (classifications graph (cast i32 r) node count)
            vector-values? (.vector? classes)
            floating-values? (.floating? classes)]
        (when (or (!= (& families kind/LANES) 0)
                  vector-values?)
          (match (vector/validate graph (cast i32 r) pointer-bytes)
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (and (= opcode 68)
                   (not vector-values?))
          (match (copy/validate graph (cast i32 r))
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (and (or (= opcode 29) (= opcode 30)) (!= (.op3 node) 0))
          (match (g/lookup graph (.op3 node))
            (None [] (set! error "division guard missing"))
            (Some [guard]
                  (when (or (< (.op3 node) 0)
                            (not (or (op/block-start? (cast i32
                                                            (n/opcode guard)))
                                     (= (n/opcode guard) 101)
                                     (= (n/opcode guard) 102))))
                    (set! error
                          "division guard must be a block start or guard")))))
        (when (or (!= (& families kind/CHECKED) 0) (= opcode 44))
          (match (if (= opcode 44)
                     (checked/validate-projection graph (cast i32 r))
                     (checked/validate graph (cast i32 r)))
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (!= (& families kind/ATOMIC) 0)
          (match (atomic/validate graph (cast i32 r))
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (!= (& families kind/TERMINAL) 0)
          (match (terminal/validate graph (cast i32 r))
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (!= (& families kind/SWITCH) 0)
          (match (switch/validate graph (cast i32 r))
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (!= (& families kind/STACK) 0)
          (match (stack/validate graph (cast i32 r))
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (!= (& families kind/LOCALS) 0)
          (match (locals/validate graph (cast i32 r) pointer-bytes)
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (!= (& families kind/CONVERSION) 0)
          (match (conversion/validate graph (cast i32 r) pointer-bytes)
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (= opcode 60)
          (match (cond/validate graph (cast i32 r))
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (= opcode 120)
          (if (= (n/type-id node) 0)
              (when (!= (.op2 node) 0)
                (set! error "void return cannot have a value"))
              (match (g/lookup graph (.op2 node))
                (None [] (set! error "return value missing"))
                (Some [value]
                      (when (!= (n/type-id value) (n/type-id node))
                        (set! error "return value type mismatch")))))
          (set! checked (+ checked 1)))
        (when floating-values?
          (match (floating/validate graph (cast i32 r))
            (Err [message] (set! error message))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (and (not vector-values?)
                   (not floating-values?)
                   (or comparison? binary? unary?))
          (let [left-cell (g/borrow-node graph (.op1 node))]
            (if (= left-cell (p/cast (ptr n/Node) 0))
                (set! error "missing integer operand")
                ; Consume the checked borrow immediately; no graph mutation.
                (let [ty (cast i32 (n/type-id (load left-cell)))
                      pointer? (and (= (n/type-id node) 6)
                                    (= ty 6)
                                    (or (= opcode 26) (= opcode 27)))]
                  (when (or (not (t/integer? ty))
                            (and unary? (not (unary/valid-type? opcode ty)))
                            (and binary? (not (binary/valid-type? opcode ty))))
                    (set! error "invalid integer operand type"))
                  (when (!= (cast i32 (n/type-id node))
                            (if comparison? 1 ty))
                    (set! error "integer operation result type mismatch"))
                  (when (or comparison? binary?)
                    (let [right-cell (g/borrow-node graph (.op2 node))]
                      (if (= right-cell (p/cast (ptr n/Node) 0))
                          (set! error "missing right integer operand")
                          (let [right-ty (cast i32 (n/type-id (load right-cell)))]
                            (when (not (or (= ty right-ty)
                                           (and pointer?
                                                (or (= right-ty 5)
                                                    (= right-ty 11)))))
                              (set! error "integer operand type mismatch")))))))))
          (set! checked (+ checked 1)))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    (if (= error "") (Ok checked) (Err error))))

(defn integer-operations-target [(graph g/Graph) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (structure graph)
    (Err [message] (Err message))
    (Ok [_] (integer-operations-target-structured graph pointer-bytes))))

;;; Check source-control edges; block projection and dominance rules are separate.

;;; Existing native entry points target AArch64 with eight-byte addresses.
(defn integer-operations [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (integer-operations-target graph 8))

(defn control-sources [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (match (structure graph)
    (Err [msg] (Err msg))
    (Ok [_]
        (let [(mut error) ""
              (mut checked) (: 0 i32)
              (mut r) 1]
          (while (and (= error "") (< r (len (.instructions graph))))
            (let [node (get (.instructions graph) r)
                  opcode (cast i32 (n/opcode node))
                  count (get (.arities graph) r)
                  (mut i) (: 1 i32)]
              (while (and (= error "") (<= i count))
                (when (= (op/operand-code opcode i) op/OPERAND-SRC)
                  (match (g/operand graph (cast i32 r) i)
                    (None [] (set! error "control source missing"))
                    (Some [source]
                          (if (<= source 0)
                              (set! error
                                    "control source must be an instruction")
                              (match (g/lookup graph source)
                                (None [] (set! error "control source missing"))
                                (Some [producer]
                                      (when (not (op/control? (cast i32
                                                                    (n/opcode producer))))
                                        (set! error
                                              "control source is a data node")))))))
                  (set! checked (+ checked 1)))
                (set! i (+ i 1)))
              (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
          (if (= error "") (Ok checked) (Err error))))))

;;; A single immutable transaction shares its immediate structural check.
;;; Helpers are not exported; callers cannot retain or reuse a stale proof.
;;; Return the Phi check count, exactly as the prior sequential composition did.
(defn operations-and-phis-target [(graph g/Graph) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (structure graph)
    (Err [message] (Err message))
    (Ok [_]
        (match (integer-operations-target-structured graph pointer-bytes)
          (Err [message] (Err message))
          (Ok [_] (phis-structured graph))))))

;;; Preserve rewrite validation's operations, constants, Phi diagnostic order.
(defn operations-constants-and-phis-target [(graph g/Graph) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (structure graph)
    (Err [message] (Err message))
    (Ok [_]
        (match (integer-operations-target-structured graph pointer-bytes)
          (Err [message] (Err message))
          (Ok [_]
              (match (constants graph pointer-bytes)
                (Err [message] (Err message))
                (Ok [_] (phis-structured graph))))))))

;;; One immutable transaction preserves pipeline's structure, entry/root and
;;; Phi diagnostic ordering without checking the same structure twice. No proof
;;; escapes this call; the ordinary public phis entry still checks its own input.
(defn schedule-input [(graph g/Graph) (entry i32) (roots (slice i32))]
  (-> (Result i32 (slice u8)))
  (match (structure graph)
    (Err [message] (Err message))
    (Ok [_] (schedule-input-structured graph entry roots))))

(defn schedule-input-structured [(graph g/Graph) (entry i32) (roots (slice i32))]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""]
    (match (g/lookup graph entry)
      (None [] (set! error "entry missing"))
      (Some [instruction]
            (when (or (<= entry 0)
                      (not (op/block-start? (cast i32
                                                      (n/opcode instruction)))))
              (set! error "entry must be a block start"))))
    (when (= (len roots) 0)
      (set! error "compilation requires observable roots"))
    (for root roots
      (when (or (<= root 0) (not (g/contains? graph root)))
        (set! error "invalid root reference")))
    (if (= error "") (phis-structured graph) (Err error))))


(defn native-operations [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (match (constants graph 8)
    (Err [message] (Err message))
    (Ok [_]
      (match (structure graph)
        (Err [message] (Err message))
        (Ok [_]
          (match (integer-operations-target-structured graph 8)
            (Err [message] (Err message))
            (Ok [_]
              (match (switch/verify graph (.alc (.instructions graph)))
                (Err [message] (Err message))
                (Ok [_]
                  (match (terminal/verify-chains graph (.alc (.instructions graph)))
                    (Err [message] (Err message))
                    (Ok [_]
                      (match (argval/verify graph (.alc (.instructions graph)))
                        (Err [message] (Err message))
                        (Ok [_] (calls/verify graph))))))))))))))

;;; Complete native input transaction: no mutation or stored proof between the
;;; operation checks and entry/root/Phi checks. All public inputs are checked.
(defn native-input [(graph g/Graph) (entry i32) (roots (slice i32))]
  (-> (Result i32 (slice u8)))
  (match (native-operations graph)
    (Err [message] (Err message))
    (Ok [_] (schedule-input-structured graph entry roots))))
