;;; Typed vector arithmetic operations over the shared scalar/vector opcode space.
(module stogir.vector-arithmetic)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.opcode" :as op)
(import "stogir.integer-unary" :as unary)
(import "coil.result" :use [Result Ok Err Some None])

(defn unary? [(opcode i32)] (-> bool)
  (unary/operation? opcode))

(defn rotate? [(opcode i32)] (-> bool)
  (or (= opcode 52) (= opcode 53)))

(defn shift? [(opcode i32)] (-> bool)
  (and (>= opcode 49) (<= opcode 53)))

(defn extrema? [(opcode i32)] (-> bool)
  (or (= opcode 58) (= opcode 59)))

(defn operation? [(opcode i32)] (-> bool)
  (or (unary? opcode)
      (extrema? opcode)
      (shift? opcode)
      (= opcode 26)
      (= opcode 27)
      (= opcode 28)
      (= opcode 29)
      (= opcode 30)
      (= opcode 46)
      (= opcode 47)
      (= opcode 48)))

(defn valid-type? [(opcode i32) (ty i32)] (-> bool)
  (let [base (types/base-type ty)]
    (and (types/vector? ty)
         (operation? opcode)
         (if (unary? opcode)
             (or (unary/valid-type? opcode base)
                 (and (types/floating? base) (or (= opcode 31) (= opcode 32))))
             (if (shift? opcode)
                 (and (types/integer? base) (!= base 1))
                 (if (or (= opcode 46) (= opcode 47) (= opcode 48))
                     (types/integer? base)
                     (if (types/floating? base)
                         (!= opcode 30)
                         (and (types/integer? base)
                              (or (!= base 1) (extrema? opcode))))))))))

(defn node? [(graph g/Graph) (reference i32)] (-> bool)
  (match (g/lookup graph reference)
    (None [] false)
    (Some [node]
          (and (operation? (cast i32 (n/opcode node)))
               (types/vector? (cast i32 (n/type-id node)))))))

(defn operands [(graph g/Graph)
                (opcode i32)
                (ty i32)
                (left i32)
                (right i32)
                (guard i32)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""]
    (when (not (valid-type? opcode ty))
      (set! error "unsupported vector arithmetic operation or element type"))
    (let [(mut index) (: 0 i32)]
      (while (< index (if (unary? opcode) 1 2))
        (let [input (if (= index 0) left right)]
          (match (g/lookup graph input)
            (None [] (set! error "vector arithmetic operand missing"))
            (Some [node]
                  (when (or (not (or (= (cast i32 (n/type-id node)) ty)
                                     (and (= index 1)
                                          (shift? opcode)
                                          (types/integer? (cast i32
                                                                (n/type-id node))))))
                            (= (n/opcode node) 72)
                            (= (n/opcode node) 70))
                    (set! error
                          "vector arithmetic operand type or storage mismatch")))))
        (set! index (+ index 1))))
    (when (!= guard 0)
      (if (not (or (= opcode 29) (= opcode 30)))
          (set! error "only vector DIV/MOD accepts a guard")
          (match (g/lookup graph guard)
            (None [] (set! error "vector division guard missing"))
            (Some [node]
                  (when (or (<= guard 0)
                            (not (or (op/block-start? (cast i32 (n/opcode node)))
                                     (= (n/opcode node) 101)
                                     (= (n/opcode node) 102))))
                    (set! error
                          "vector division guard must be a block start or guard"))))))
    (if (= error "") (Ok ty) (Err error))))

(defn validate [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "vector arithmetic instruction missing"))
    (Some [node]
          (let [opcode (cast i32 (n/opcode node))]
            (if (or (<= reference 0)
                    (not (node? graph reference))
                    (!= (get (.arities graph) (cast i64 reference))
                        (if (unary? opcode)
                            1
                            (if (or (= opcode 29) (= opcode 30)) 3 2))))
                (Err "invalid vector arithmetic instruction shape")
                (operands graph
                          opcode
                          (cast i32 (n/type-id node))
                          (.op1 node)
                          (.op2 node)
                          (if (or (= opcode 29) (= opcode 30)) (.op3 node) 0)))))))
