;;; Canonical function exit over the same compact, typed control/value graph.
(module stogir.return-merge)
(export Canonical canonicalize release!)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.builder" :as b)
(import "stogir.terminal" :as terminal)
(import "stogir.sccp-rewrite" :as rewrite)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Canonical [(graph g/Graph) (roots (ArrayList i32)) (returned i32)])
(defn release! [(value (mut Canonical))] (-> void)
  (g/release! (mut (.graph value))) (free! (mut (.roots value))))

;;; Terminal membership links are metadata, not executable control edges.
;;; The original graph/chains are validated before this bounded walk is used.
(defn skip-returns [(source g/Graph) (reference i32)] (-> i32)
  (let [(mut r) reference]
    (while (and (> r 0) (= (n/opcode (get (.instructions source) (cast i64 r))) 120))
      (set! r (terminal/previous source r)))
    r))

;;; Own the transformed version; never mutate a provider's registered snapshot.
;;; Every RETURN must be observed, have the same type, and belong to one START.
;;; Existing closure/ABI/ownership/Never proofs remain the inliner's job.
(defn canonicalize [(source g/Graph) (entry i32) (roots (slice i32))
                    (pointer-bytes i32) (a (dyn Allocator))]
  (-> (Result Canonical (slice u8)))
  (match (rewrite/validate source pointer-bytes a)
    (Err [message] (Err message))
    (Ok [_]
      (let [(mut returns) (ArrayList::new [i32] a)
            (mut inputs) (ArrayList::new [i32] a)
            (mut ty) (: -1 i32) (mut starts) 0 (mut r) (: 1 i64)
            (mut error) ""]
        (for root roots
          (when (or (<= root 0) (not (g/contains? source root)))
            (set! error "invalid return canonicalization root")))
        (while (< r (len (.instructions source)))
          (let [node (get (.instructions source) r)]
            (when (= (n/opcode node) 104)
              (set! starts (+ starts 1))
              (when (!= (cast i32 r) entry) (set! error "canonicalization entry mismatch")))
            (when (= (n/opcode node) 120)
              (let [(mut observed) false]
                (for root roots (when (= root (cast i32 r)) (set! observed true)))
                (unless observed (set! error "canonicalization return is not observed")))
              (when (and (>= ty 0) (!= ty (cast i32 (n/type-id node))))
                (set! error "canonicalization return types differ"))
              (set! ty (cast i32 (n/type-id node)))
              (push! (mut returns) (cast i32 r)))
            (set! r (+ r (/ (+ (cast i64 (get (.arities source) r)) 4) 4)))))
        (when (or (!= starts 1) (< (len returns) 2))
          (set! error "canonicalization requires one function with multiple returns"))
        (let [result
          (if (!= error "") (Err [Canonical (slice u8)] error)
            (let [(mut graph) (g/duplicate source a)
                  (mut observed) (ArrayList::new [i32] a)
                  (mut merged) (: 0 i32) (mut value) (: 0 i32) (mut returned) (: 0 i32)
                  old-head (.op1 (get (.instructions source) (cast i64 entry)))
                  head (skip-returns source old-head)]
              ; Unlink replaced terminals without losing other membership links.
              (set! r 1)
              (while (< r (len (.instructions source)))
                (let [node (get (.instructions source) r) opcode (cast i32 (n/opcode node))]
                  (when (and (terminal/chain? opcode) (!= opcode 120))
                    (g/set-operand! (mut graph) (cast i32 r) 3 (skip-returns source (.op3 node))))
                  (set! r (+ r (/ (+ (cast i64 (get (.arities source) r)) 4) 4)))))
              (for reference returns
                (let [node (get (.instructions source) (cast i64 reference))]
                  (unless (g/rewrite-inputs! (mut graph) reference 114 0 [(.op1 node)])
                    (set! error "return-to-END rewrite failed"))))
              (match (b/emit! (mut graph) 112 0 (slice returns))
                (Err [message] (set! error message)) (Ok [x] (set! merged x)))
              (when (and (= error "") (!= ty 0))
                (push! (mut inputs) merged)
                (for reference returns
                  (push! (mut inputs) (.op2 (get (.instructions source) (cast i64 reference)))))
                (match (b/emit! (mut graph) 67 ty (slice inputs))
                  (Err [message] (set! error message)) (Ok [x] (set! value x))))
              (when (= error "")
                (match (b/emit! (mut graph) 120 ty [merged value head])
                  (Err [message] (set! error message)) (Ok [x] (set! returned x)))
                (when (and (= error "") (!= old-head 0))
                  (g/set-operand! (mut graph) entry 1 returned)))
              (when (= error "")
                (push! (mut observed) returned)
                (for root roots
                  (unless (= (n/opcode (get (.instructions source) (cast i64 root))) 120)
                    (push! (mut observed) root)))
                ; No immutable proof survives this graph edit.
                (match (rewrite/validate graph pointer-bytes a)
                  (Err [message] (set! error message)) (Ok [_] 0)))
              (if (= error "")
                  (Ok (Canonical :graph graph :roots observed :returned returned))
                  (do (g/release! (mut graph)) (free! (mut observed))
                      (Err [Canonical (slice u8)] error)))))]
          (free! (mut returns)) (free! (mut inputs)) result)))))
