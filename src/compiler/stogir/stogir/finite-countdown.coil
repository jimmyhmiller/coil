;;; Independent finite unit-countdown analysis, not a pinned-upstream pass port.
(module stogir.finite-countdown)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.uses" :as uses)
(import "stogir.iter-control" :as control)
(import "stogir.bitqueue" :as queue)
(import "stogir.bitset" :as bits)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Option Some None])

(defstruct Plan [(header i32) (entry i32) (back i32) (branch i32)
                 (inside i32) (outside i32) (counter i32) (step i32)
                 (predicate i32) (zero i32)])

(defn node-op [(graph g/Graph) (ref i32)] (-> i32)
  (if (and (> ref 0) (g/contains? graph ref))
      (cast i32 (n/opcode (get (.instructions graph) (cast i64 ref)))) -1))

;;; Exact SRC-only control ancestry. A merge or cycle has no guessed parent.
(defn follows? [(graph g/Graph) (from i32) (ancestor i32)] (-> bool)
  (let [(mut at) from (mut remaining) (len (.instructions graph))]
    (while (and (> at 0) (!= at ancestor) (> remaining 0))
      (let [node (get (.instructions graph) (cast i64 at))]
        (if (= (op/operand-code (cast i32 (n/opcode node)) 1) op/OPERAND-SRC)
            (set! at (.op1 node)) (set! at 0)))
      (set! remaining (- remaining 1)))
    (= at ancestor)))

(defn literal? [(graph g/Graph) (ref i32) (ty u8) (bits u64)] (-> bool)
  (and (< ref 0)
       (match (g/lookup graph ref)
         (None [] false)
         (Some [value] (and (= (n/opcode value) ty) (= (n/type-id value) ty)
                            (= (n/constant-bits value) bits))))))

;;; Only direct constants, parameters and sequenced loads before entry qualify.
;;; A Phi/pure expression from a surrounding loop is conservatively unsupported.
(defn initial-before? [(graph g/Graph) (initial i32) (entry i32)] (-> bool)
  (if (< initial 0) true
      (if (<= initial 0) false
          (let [node (get (.instructions graph) (cast i64 initial))]
            (case (n/opcode node)
              71 (follows? graph entry (.op1 node))
              91 (follows? graph entry initial)
              false)))))

(defn select [(graph g/Graph) (edges uses/Uses) (header i32)] (-> (Option Plan))
 (block :answer
  (unless (and (or (= (node-op graph header) 112) (= (node-op graph header) 113))
               (= (get (.arities graph) (cast i64 header)) 2))
    (return-from :answer (None)))
  (let [h (get (.instructions graph) (cast i64 header))
        (mut counter) (: 0 i32) (mut branch) (: 0 i32)
        (mut valid?) true range (get (.ranges edges) (cast i64 header))]
   (unless (= (.count range) 2) (return-from :answer (None)))
   (for [i 0 (.count range)]
    (let [edge (get (.edges edges) (+ (.offset range) i)) ref (.user edge)]
     (cond (and (= (.operand edge) 1) (= (node-op graph ref) 67) (= counter 0))
             (set! counter ref)
           (and (= (.operand edge) 1) (= (node-op graph ref) 116) (= branch 0))
             (set! branch ref)
           :else (set! valid? false))))
   (unless (and valid? (> counter 0) (> branch 0)) (return-from :answer (None)))
   (let [phi (get (.instructions graph) (cast i64 counter))
         ty (n/type-id phi) b (get (.instructions graph) (cast i64 branch))
         predicate (.op2 b) cmp-op (node-op graph predicate)]
    (unless (and (= (get (.arities graph) (cast i64 counter)) 3)
                 (types/integer? (cast i32 ty)) (!= ty 1) (!= ty 6)
                 (> (types/scalar-size (cast i32 ty) 8) 0)
                 (<= (types/scalar-size (cast i32 ty) 8) 8)
                 (or (= cmp-op 14) (= cmp-op 15)))
      (return-from :answer (None)))
    (let [cmp (get (.instructions graph) (cast i64 predicate))]
     (unless (and (= (.op1 cmp) counter) (literal? graph (.op2 cmp) ty 0))
       (return-from :answer (None)))
     (let [(mut inside) (: 0 i32) (mut outside) (: 0 i32)
           users (get (.ranges edges) (cast i64 branch))]
      (unless (= (.count users) 2) (return-from :answer (None)))
      (for [i 0 (.count users)]
       (let [edge (get (.edges edges) (+ (.offset users) i)) ref (.user edge)
             opcode (node-op graph ref)]
        (unless (and (= (.operand edge) 1) (or (= opcode 107) (= opcode 108)))
          (return-from :answer (None)))
        (if (= (= opcode 107) (= cmp-op 15)) (set! inside ref) (set! outside ref))))
      (unless (and (> inside 0) (> outside 0)) (return-from :answer (None)))
      (let [body-users (get (.ranges edges) (cast i64 inside))]
       (unless (= (.count body-users) 1) (return-from :answer (None)))
       (let [edge (get (.edges edges) (.offset body-users)) back (.user edge)
             back-op (node-op graph back)]
        (unless (and (= (.operand edge) 1) (or (= back-op 114) (= back-op 115))
                     (or (= back (.op1 h)) (= back (.op2 h))))
          (return-from :answer (None)))
        (let [back-first? (= back (.op1 h))
              entry (if back-first? (.op2 h) (.op1 h))
              initial (if back-first? (.op3 phi) (.op2 phi))
              step (if back-first? (.op2 phi) (.op3 phi))
              back-users (get (.ranges edges) (cast i64 back))]
         (unless (and (> entry 0) (= (.count back-users) 1)
                      (= (.user (get (.edges edges) (.offset back-users))) header)
                      (!= entry back) (initial-before? graph initial entry)
                      (= (node-op graph step) 27))
           (return-from :answer (None)))
         (let [next (get (.instructions graph) (cast i64 step))
               step-users (get (.ranges edges) (cast i64 step))]
          (unless (and (= (n/type-id next) ty) (= (.op1 next) counter)
                       (literal? graph (.op2 next) ty 1) (= (.count step-users) 1)
                       (= (.user (get (.edges edges) (.offset step-users))) counter)
                       (= (.operand (get (.edges edges) (.offset step-users)))
                          (if back-first? 2 3)))
            (return-from :answer (None))))
         ; Every other live observation of the carried value must be sequenced
         ; after this exact exit. Pure data uses without control are rejected.
         (let [counter-users (get (.ranges edges) (cast i64 counter))]
          (for [i 0 (.count counter-users)]
           (let [edge (get (.edges edges) (+ (.offset counter-users) i))
                 ref (.user edge) user (get (.instructions graph) (cast i64 ref))]
            (unless (or (and (= ref predicate) (= (.operand edge) 1))
                        (and (= ref step) (= (.operand edge) 1))
                        (and (> (.operand edge) 1)
                             (= (op/operand-code (cast i32 (n/opcode user)) 1) op/OPERAND-SRC)
                             (follows? graph (.op1 user) outside)))
              (return-from :answer (None))))))
         (Some (Plan :header header :entry entry :back back :branch branch
                 :inside inside :outside outside :counter counter :step step
                 :predicate predicate :zero (.op2 cmp))))))))))))

;;; For w-bit wrapping SUB, the unsigned representation strictly decreases on
;;; every nonzero iteration, so zero is reached in at most2^w-1iterations.
;;; The only body control is the backedge. Exit-dominated users see exactly0.
;;; Explicit data observations and interior control roots remain protected;
;;; a backedge reachability root is remapped to the proven eventual exit.
(defn rewrite! [(graph (mut g/Graph)) (edges (mut uses/Uses))
                 (work (mut queue/Queue)) (roots (mut (ArrayList i32)))
                 (protected (mut bits/Bits)) (header i32)] (-> bool)
 (match (select graph edges header)
  (None [] false)
  (Some [plan]
   (let [observed [(.header plan) (.branch plan) (.inside plan) (.counter plan)
                    (.predicate plan) (.step plan)]
         controls [(.header plan) (.branch plan) (.inside plan)]]
   (block :answer
    (for ref observed
     (when (bits/contains? protected (cast i64 ref)) (return-from :answer false)))
    (for [i 0 (len roots)]
     (when (= (get roots i) (.back plan)) (set! (mut roots) i (.outside plan))))
    (when (bits/remove! (mut protected) (cast i64 (.back plan)))
     (bits/add! (mut protected) (cast i64 (.outside plan))))
    (let [ty (n/type-id (get (.instructions graph) (cast i64 (.counter plan))))]
     (control/rewrite! (mut graph) (mut edges) (mut work) (.counter plan)
       68 ty 0 [(.zero plan) (: 0 i32)]))
    (control/rewrite! (mut graph) (mut edges) (mut work) (.outside plan)
      106 0 0 [(.entry plan) (: 0 i32)])
    (for ref controls
     (control/rewrite! (mut graph) (mut edges) (mut work) ref
       106 0 0 [(: 0 i32) 0]))
    true)))))
