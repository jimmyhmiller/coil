;;; Address-dependent image relocation after symbol resolution and layout.
(module stogir.relocate)
(import "stogir.image" :as image)

(export apply! read32)

(import "stogir.a64.relocation" :as a64)
(import "stogir.image-order" :as order)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(defstruct Patch [(section i32) (offset i64) (width i32) (value u64)])

(defn read32 [(section (ArrayList u8)) (offset i64)] (-> u32)
  (| (cast u32 (get section offset))
     (<< (cast u32 (get section (+ offset 1))) 8)
     (<< (cast u32 (get section (+ offset 2))) 16)
     (<< (cast u32 (get section (+ offset 3))) 24)))

;;; Addresses match stable image symbol IDs. Undefined-symbol resolution belongs
;;; to the loader; zero is a valid resolved address and not a missing marker.
(defn apply! [(image (mut image/Image))
              (addresses (ArrayList u64))
              (text-base u64)
              (data-base u64)
              (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (order/relocations image allocator)
    (Err [msg] (Err msg))
    (Ok [records]
        (let [(mut owned) records
              result
                (apply-ordered! (mut image)
                                addresses
                                text-base
                                data-base
                                owned
                                allocator)]
          (free! (mut owned))
          result))))

(defn apply-ordered! [(image (mut image/Image))
                      (addresses (ArrayList u64))
                      (text-base u64)
                      (data-base u64)
                      (records (ArrayList image/Relocation))
                      (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut patches) (ArrayList::new [Patch] allocator)
        (mut error) ""]
    (for relocation records
      (when (= error "")
        (let [section (.section relocation)
              offset (.offset relocation)
              width (if (= (.kind relocation) 1) 8 4)
              length (if (= section 1) (len (.text image)) (len (.data image)))
              symbol (cast i64 (.symbol relocation))]
          (if (or (< section 1)
                  (> section 2)
                  (< offset 0)
                  (> offset (- length width))
                  (< symbol 0)
                  (>= symbol (len addresses)))
              (set! error "invalid relocation location or symbol address")
              (let [target
                      (+ (cast i128 (get addresses symbol))
                         (cast i128 (.addend relocation)))]
                (if (or (< target 0) (> target (: 18446744073709551615 i128)))
                    (set! error "relocation address overflow")
                    (if (= (.kind relocation) 1)
                        (push! (mut patches)
                               (Patch
                                 :section section
                                 :offset offset
                                 :width 8
                                 :value (cast u64 target)))
                        (let [base (if (= section 1) text-base data-base)
                              place (+ (cast i128 base) (cast i128 offset))
                              word
                                (if (= section 1)
                                    (read32 (.text image) offset)
                                    (read32 (.data image) offset))]
                          (if (or (!= (% offset 4) 0)
                                  (> place (: 18446744073709551615 i128)))
                              (set! error
                                    "invalid instruction relocation position")
                              (match (a64/instruction (.kind relocation)
                                                      word
                                                      (cast u64 target)
                                                      (cast u64 place))
                                (Err [msg] (set! error msg))
                                (Ok [encoded]
                                    (push! (mut patches)
                                           (Patch
                                             :section section
                                             :offset offset
                                             :width 4
                                             :value (cast u64 encoded))))))))))))))
    (if (!= error "")
        (do (free! (mut patches)) (Err error))
        (let [count (cast i32 (len patches))]
          (for patch patches
            (let [offset (.offset patch)
                  value (.value patch)]
              (if (= (.section patch) 1)
                  (do
                    (bytes/patch32! (mut (.text image))
                                    offset
                                    (cast u32 (& value 0xFFFFFFFF)))
                    (when (= (.width patch) 8)
                      (bytes/patch32! (mut (.text image))
                                      (+ offset 4)
                                      (cast u32 (>> value 32)))))
                  (do
                    (bytes/patch32! (mut (.data image))
                                    offset
                                    (cast u32 (& value 0xFFFFFFFF)))
                    (when (= (.width patch) 8)
                      (bytes/patch32! (mut (.data image))
                                      (+ offset 4)
                                      (cast u32 (>> value 32))))))))
          (free! (mut patches))
          (Ok count)))))
