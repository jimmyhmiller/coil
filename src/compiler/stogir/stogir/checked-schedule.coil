;;; Checked arithmetic and its flag projections form one scheduling unit.
(module stogir.checked-schedule)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.checked" :as checked)
(import "stogir.schedule" :as schedule)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

;;; Hoist each live projection to its producer's chosen block. A projection has
;;; no other dependency, and the producer already dominates all projection uses.
(defn place! [(graph g/Graph)
              (mapping (mut (ArrayList i32)))
              (live (ArrayList bool))]
  (-> (Result i32 (slice u8)))
  (let [(mut reference) (: 1 i64)
        (mut count) (: 0 i32)
        (mut error) ""]
    (while (and (= error "") (< reference (len (.instructions graph))))
      (let [node (get (.instructions graph) reference)
            arity (get (.arities graph) reference)]
        (when (and (= (n/opcode node) 44) (get live reference))
          (match (checked/validate-projection graph (cast i32 reference))
            (Err [message] (set! error message))
            (Ok [ty]
                (when (!= ty 0)
                  (let [block (get mapping (cast i64 (.op1 node)))]
                    (if (<= block 0)
                        (set! error "overflow producer lacks placement")
                        (do
                          (set! (mut mapping) reference block)
                          (set! count (+ count 1)))))))))
        (set! reference (+ reference (/ (+ (cast i64 arity) 4) 4)))))
    (if (= error "") (Ok count) (Err error))))

(defn validate-nodes [(graph g/Graph) (nodes (ArrayList i32))]
  (-> (Result i32 (slice u8)))
  (let [(mut producer) (: 0 i32)
        (mut count) (: 0 i32)
        (mut error) ""]
    (for reference nodes
      (when (= error "")
        (match (g/lookup graph reference)
          (Some [node]
                (if (checked/operation? (cast i32 (n/opcode node)))
                    (match (checked/validate graph reference)
                      (Err [message] (set! error message))
                      (Ok [_] (set! producer reference)))
                    (if (= (n/opcode node) 44)
                        (match (checked/validate-projection graph reference)
                          (Err [message] (set! error message))
                          (Ok [ty]
                              (if (= ty 0)
                                  (set! producer 0)
                                  (if (!= producer (.op1 node))
                                      (set! error
                                            "OVERFLOW must immediately follow its checked producer")
                                      (set! count (+ count 1))))))
                        (set! producer 0))))
          (None [] (set! error "scheduled overflow reference missing")))))
    (if (= error "") (Ok count) (Err error))))

(defn validate [(graph g/Graph) (scheduled schedule/Schedule)]
  (-> (Result i32 (slice u8)))
  (validate-nodes graph (.nodes scheduled)))

;;; Stable projection clustering within blocks, before liveness/allocation.
;;; Ordinary functions avoid index allocation entirely.
(defn cluster! [(graph g/Graph)
                (mapping (ArrayList i32))
                (scheduled (mut schedule/Schedule))
                (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [(mut count) (: 0 i32)
        (mut error) ""]
    (for reference (.nodes scheduled)
      (let [node (get (.instructions graph) (cast i64 reference))]
        (when (= (n/opcode node) 44)
          (match (checked/validate-projection graph reference)
            (Err [message] (set! error message))
            (Ok [ty] (when (!= ty 0) (set! count (+ count 1))))))))
    (if (!= error "")
        (Err error)
        (if (= count 0)
            (validate graph scheduled)
            (let [(mut heads) (ArrayList::new [i32] allocator)
                  (mut tails) (ArrayList::new [i32] allocator)
                  (mut next) (ArrayList::new [i32] allocator)
                  (mut paired) (ArrayList::new [bool] allocator)
                  (mut ordered) (ArrayList::new [i32] allocator)
                  (mut i) (: 0 i64)]
              (extend-zeroed! (mut heads) (len (.instructions graph)))
              (extend-zeroed! (mut tails) (len (.instructions graph)))
              (extend-zeroed! (mut next) (len (.instructions graph)))
              (extend-zeroed! (mut paired) (len (.instructions graph)))
              (set! i (len (.instructions graph)))
              (for reference (.nodes scheduled)
                (let [node (get (.instructions graph) (cast i64 reference))]
                  (when (= (n/opcode node) 44)
                    (match (checked/projection graph (.op1 node))
                      (Err [message] (set! error message))
                      (Ok [ty]
                          (when (!= ty 0)
                            (let [parent (cast i64 (.op1 node))
                                  tail (get tails parent)]
                              (when (!= (get mapping parent)
                                        (get mapping (cast i64 reference)))
                                (set! error
                                      "overflow projection is not in its producer block"))
                              (if (= tail 0)
                                  (set! (mut heads) parent reference)
                                  (set! (mut next) (cast i64 tail) reference))
                              (set! (mut tails) parent reference)
                              (set! (mut paired) (cast i64 reference) true))))))))
              (for reference (.nodes scheduled)
                (when (not (get paired (cast i64 reference)))
                  (push! (mut ordered) reference)
                  (let [(mut projection) (get heads (cast i64 reference))]
                    (while (!= projection 0)
                      (push! (mut ordered) projection)
                      (set! projection (get next (cast i64 projection)))))))
              (when (!= (len ordered) (len (.nodes scheduled)))
                (set! error
                      "overflow producer absent or duplicated in schedule"))
              (when (= error "")
                (match (validate-nodes graph ordered)
                  (Err [message] (set! error message))
                  (Ok [_] 0)))
              (free! (mut heads))
              (free! (mut tails))
              (free! (mut next))
              (free! (mut paired))
              (if (= error "")
                  (do
                    (free! (mut (.nodes scheduled)))
                    (set! (.nodes scheduled) ordered)
                    (Ok count))
                  (do (free! (mut ordered)) (Err error))))))))
