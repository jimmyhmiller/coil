; Ported/adapted from dstogov/ir (ir.h), commit 92171d0. See NOTICE.
;;; Upstream-compatible scalar identifiers and vector type geometry.
(module stogir.types)

(defn valid-scalar? [(t i32)] (-> bool)
  (and (>= t 0) (<= t 13)))

(defn unsigned? [(t i32)] (-> bool)
  (and (>= t 1) (<= t 6)))

(defn signed? [(t i32)] (-> bool)
  (and (>= t 7) (<= t 11)))

(defn integer? :inline (Always) [(t i32)] (-> bool)
  (and (>= t 1) (<= t 11)))

(defn floating? :inline (Always) [(t i32)] (-> bool)
  (or (= t 12) (= t 13)))

;;; Address size is supplied by the target, never inferred from the host.
;;; Returns -1 for invalid types or unsupported pointer widths; void has size 0.
(defn scalar-size :inline (Always) [(t i32) (pointer-bytes i32)] (-> i32)
  (if (not (or (= pointer-bytes 4) (= pointer-bytes 8)))
      -1
      (if (= t 0)
          0
          (if (or (= t 1) (= t 2) (= t 7) (= t 8))
              1
              (if (or (= t 3) (= t 9))
                  2
                  (if (or (= t 4) (= t 10) (= t 13))
                      4
                      (if (or (= t 5) (= t 11) (= t 12))
                          8
                          (if (= t 6) pointer-bytes -1))))))))

;;; A vector retains the scalar base in bits0..3 and log2(lanes)+1 in
;;; bits4..6, exactly as ir.h. Representation validity is independent of which
;;; shapes an operation or target supports. No type uses bit7.
(defn vector? :inline (Always) [(ty i32)] (-> bool)
  (and (> ty 15)
       (< ty 128)
       (>= (& ty 15) 1)
       (<= (& ty 15) 13)))

(defn valid? [(ty i32)] (-> bool)
  (or (valid-scalar? ty) (vector? ty)))

(defn base-type [(ty i32)] (-> i32)
  (if (valid? ty) (& ty 15) -1))

;;; Void has zero lanes; an ordinary scalar value has one. Invalid codes fail.
(defn lanes [(ty i32)] (-> i32)
  (if (vector? ty)
      (<< (: 1 i32) (- (>> ty 4) 1))
      (if (valid-scalar? ty) (if (= ty 0) 0 1) -1)))

;;; Checked vector type construction. Scalar identifiers are never rewritten.
(defn vector-type [(base i32) (count i32)] (-> i32)
  (if (or (< base 1)
          (> base 13)
          (< count 1)
          (> count 64)
          (!= (& count (- count 1)) 0))
      -1
      (let [(mut remaining) count
            (mut encoding) (: 16 i32)]
        (while (> remaining 1)
          (set! remaining (>> remaining 1))
          (set! encoding (+ encoding 16)))
        (| encoding base))))

;;; Storage extent of a validated scalar/vector type for an explicit target.
;;; The full representation supports larger vectors; individual targets impose
;;; their own legal widths rather than truncating them to a native register.
(defn size :inline (Always) [(ty i32) (pointer-bytes i32)] (-> i32)
  (if (vector? ty)
      (let [width (scalar-size (base-type ty) pointer-bytes)]
        (if (< width 0) -1 (* width (lanes ty))))
      (scalar-size ty pointer-bytes)))

(defn short-vector? [(ty i32) (pointer-bytes i32)] (-> bool)
  (and (vector? ty)
       (or (= (size ty pointer-bytes) 8) (= (size ty pointer-bytes) 16))))
