;;; Combined SCCP/copy lattice and partition invalidation, adapted from
;;; pinned ir_sccp.c. This is analysis state over the original graph references.
(module stogir.sccp-values)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.bitqueue" :as q)
(import "stogir.uses" :as uses)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])

;;; Provides original signed references; each lattice entry is one 16-byte node.
(defstruct Domain [(values (ArrayList n/Node)) (pending q/Queue)])

;;; The upstream union is retained: op1 is copy identity, control fact, or
;;; top visitation; op2/op3 are next/previous for copies, constant payload for
;;; scalar constants, or a signed constant reference for long constants.
(defn state-kind [(value n/Node)] (-> i32)
  (cast i32 (n/opcode value)))

(defn copy-source [(value n/Node)] (-> i32)
  (.op1 value))

(defn next-member [(value n/Node)] (-> i32)
  (.op2 value))

(defn previous-member [(value n/Node)] (-> i32)
  (.op3 value))

(defn create [(size i64) (a (dyn Allocator))] (-> Domain)
  (let [(mut result)
          (Domain
            :values (ArrayList::new [n/Node] a)
            :pending (q/create size a))]
    ; A top value is the all-zero cell.
    (extend-zeroed! (mut (.values result)) size)
    result))

(defn release! [(domain (mut Domain))] (-> void)
  (free! (mut (.values domain)))
  (q/release! (mut (.pending domain))))

(defn at [(domain Domain) (reference i32)] (-> n/Node)
  (get (.values domain) (cast i64 reference)))

;;; Positive valid node references are a precondition, as in upstream internals.
(defn kind! [(domain (mut Domain)) (reference i32) (kind i32)] (-> void)
  (let [(mut value) (at domain reference)]
    (set! (.header value) (cast u32 kind))
    (set! (mut (.values domain)) (cast i64 reference) value)))

(defn reference! [(domain (mut Domain)) (reference i32) (source i32)]
  (-> void)
  (let [(mut value) (at domain reference)]
    (set! (.op1 value) source)
    (set! (mut (.values domain)) (cast i64 reference) value)))

(defn next! [(domain (mut Domain)) (reference i32) (next i32)]
  (-> void)
  (let [(mut value) (at domain reference)]
    (set! (.op2 value) next)
    (set! (mut (.values domain)) (cast i64 reference) value)))

(defn previous! [(domain (mut Domain)) (reference i32) (previous i32)]
  (-> void)
  (let [(mut value) (at domain reference)]
    (set! (.op3 value) previous)
    (set! (mut (.values domain)) (cast i64 reference) value)))

(defn top? [(domain Domain) (reference i32)] (-> bool)
  (and (>= reference 0) (= (state-kind (at domain reference)) 0)))

(defn bottom? [(domain Domain) (reference i32)] (-> bool)
  (and (>= reference 0) (= (state-kind (at domain reference)) (op/count))))

(defn reachable? [(domain Domain) (reference i32)] (-> bool)
  (!= (state-kind (at domain reference)) 0))

(defn identity [(domain Domain) (reference i32)] (-> i32)
  (let [(mut result) reference]
    (when (> result 0)
      (if (= (state-kind (at domain result)) 68)
          (while (= (state-kind (at domain result)) 68)
            (set! result (copy-source (at domain result))))
          (when (= (state-kind (at domain result)) 78)
            (set! result (.op2 (at domain result))))))
    result))

;;; A changed value wakes each non-bottom consumer, once even for repeated edges.
(defn add-uses! [(domain (mut Domain)) (edges uses/Uses) (reference i32)]
  (-> void)
  (let [range (get (.ranges edges) (cast i64 reference))]
    (for [i (.offset range) (+ (.offset range) (.count range))]
      (let [user (.user (get (.edges edges) i))]
        (when (not (bottom? domain user))
          (q/add! (mut (.pending domain)) (cast i64 user)))))))

;;; Backward discovery happens once while a data value is still top.
(defn add-input! [(domain (mut Domain)) (reference i32)] (-> void)
  (let [(mut value) (at domain reference)]
    (when (and (= (state-kind value) 0) (= (.op1 value) 0))
      (set! (.op1 value) 1)
      (set! (mut (.values domain)) (cast i64 reference) value)
      (q/add! (mut (.pending domain)) (cast i64 reference)))))

;;; The source must resolve to a bottom root; destination is neither copy nor
;;; bottom and cannot be that root. The SCCP transfer functions enforce this.
(defn add-identity! [(domain (mut Domain)) (source i32) (destination i32)]
  (-> void)
  (kind! (mut domain) destination 68)
  (reference! (mut domain) destination source)
  (let [root (identity domain source)]
    (when (and (bottom? domain source)
               (!= (copy-source (at domain source)) source))
      (reference! (mut domain) source source)
      (next! (mut domain) source source)
      (previous! (mut domain) source source))
    (let [previous (previous-member (at domain root))]
      (next! (mut domain) destination root)
      (previous! (mut domain) destination previous)
      (previous! (mut domain) root destination)
      (next! (mut domain) previous destination))))

;;; A copy that becomes overdefined splits its dependent identities into a new
;;; circular partition. Independent copies stay attached to the old root.
;;; Requeue every affected non-bottom member and every non-bottom consumer,
;;; matching upstream's invalidation rule.
(defn split! [(domain (mut Domain)) (edges uses/Uses) (reference i32)]
  (-> void)
  (kind! (mut domain) reference (op/count))
  (reference! (mut domain) reference reference)
  (let [(mut member) (next-member (at domain reference))
        (mut head) (: 0 i32)
        (mut tail) (: 0 i32)]
    (while (!= member reference)
      (when (not (bottom? domain member))
        (q/add! (mut (.pending domain)) (cast i64 member)))
      (add-uses! (mut domain) edges member)
      (let [next (next-member (at domain member))]
        (when (= (identity domain member) reference)
          (let [previous (previous-member (at domain member))]
            (next! (mut domain) previous next)
            (previous! (mut domain) next previous))
          (if (= head 0)
              (do (set! head member) (set! tail member))
              (do
                (next! (mut domain) tail member)
                (previous! (mut domain) member tail)
                (set! tail member))))
        (set! member next)))
    (let [next (next-member (at domain reference))
          previous (previous-member (at domain reference))]
      (next! (mut domain) previous next)
      (previous! (mut domain) next previous))
    (if (!= head 0)
        (do
          (next! (mut domain) reference head)
          (previous! (mut domain) reference tail)
          (next! (mut domain) tail reference)
          (previous! (mut domain) head reference))
        (do
          (next! (mut domain) reference reference)
          (previous! (mut domain) reference reference)))))

(defn make-bottom! [(domain (mut Domain)) (edges uses/Uses) (reference i32)]
  (-> void)
  (if (= (state-kind (at domain reference)) 68)
      (split! (mut domain) edges reference)
      (kind! (mut domain) reference (op/count))))

;;; Return whether the lattice value changed. Constant payload comparison is
;;; bitwise, including NaN payloads, signed zero and symbolic constants.
(defn meet-constant! [(domain (mut Domain))
                      (edges uses/Uses)
                      (reference i32)
                      (constant n/Node)] (-> bool)
  (let [old (at domain reference)]
    (if (= (state-kind old) 0)
        (let [(mut value) old
              (mut stored) constant]
          (set! (.header stored) (& (.header stored) 65535))
          (set! (.header value) (.header stored))
          (set! (.op2 value) (.op2 stored))
          (set! (.op3 value) (.op3 stored))
          (set! (mut (.values domain)) (cast i64 reference) value)
          true)
        (if (and (= (state-kind old) (cast i32 (n/opcode constant)))
                 (= (& (.header old) 65535)
                    (& (.header constant) 65535))
                 (= (n/constant-bits old)
                    (n/constant-bits constant)))
            false
            (do (make-bottom! (mut domain) edges reference) true)))))

(defn meet-long! [(domain (mut Domain))
                  (edges uses/Uses)
                  (reference i32)
                  (constant-reference i32)
                  (constant n/Node)]
  (-> bool)
  (let [old (at domain reference)]
    (if (= (state-kind old) 0)
        (let [(mut value) old
              (mut stored) constant]
          (set! (.header stored) (& (.header stored) 65535))
          (set! (.header value) (.header stored))
          (set! (.op2 value) constant-reference)
          (set! (.op3 value) (if (< constant-reference 0) -1 0))
          (set! (mut (.values domain)) (cast i64 reference) value)
          true)
        (if (and (= (state-kind old) 78)
                 (= (& (.header old) 65535)
                    (& (.header constant) 65535))
                 (= (.op2 old) constant-reference))
            false
            (do (make-bottom! (mut domain) edges reference) true)))))

(defn meet-copy! [(domain (mut Domain))
                  (edges uses/Uses)
                  (reference i32)
                  (source i32)] (-> bool)
  (if (= (state-kind (at domain reference)) 68)
      (if (= (identity domain reference) (identity domain source))
          false
          (do (split! (mut domain) edges reference) true))
      (do (add-identity! (mut domain) source reference) true)))
