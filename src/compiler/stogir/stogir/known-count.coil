;;; The literal value a 64-bit count is known to have where control reaches a
;;; call: the count itself, or what a dominating equality test proves. Used
;;; by both backends to expand a builtin memcmp of a known small count inline
;;; (moved from stogir.a64.call).
(module stogir.known-count)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.symbols" :as symbols)
(import "coil.result" :use [Option Some None])

;;; The literal that the Boolean TEST having the given TRUTH proves the 64-bit
;;; integer REFERENCE equal to: EQ(reference, literal) when true, NE when
;;; false, and through a Boolean AND that is true or a Boolean OR that is
;;; false, either of whose operands then has that truth too.
(defn implied-count [(graph g/Graph) (test i32) (truth bool) (reference i32) (depth i32)]
  (-> (Option u64))
  (if (or (<= test 0) (<= depth 0))
      (None)
      (let [node (get (.instructions graph) (cast i64 test))
            opcode (n/opcode node)]
        (cond (= opcode (if truth 14 15))
                (let [other (if (= (.op1 node) reference) (.op2 node)
                                (if (= (.op2 node) reference) (.op1 node) 0))]
                  (if (>= other 0)
                      (None)
                      (match (g/lookup graph other)
                        (None [] (None))
                        (Some [literal]
                          (if (and (symbols/numeric? literal)
                                   (or (= (n/type-id literal) 5) (= (n/type-id literal) 11)))
                              (Some (n/constant-bits literal))
                              (None))))))
              (and (= opcode (if truth 47 46)) (= (n/type-id node) 1))
                (match (implied-count graph (.op1 node) truth reference (- depth 1))
                  (Some [bits] (Some bits))
                  (None [] (implied-count graph (.op2 node) truth reference (- depth 1))))
              :else (None)))))

;;; The value of the 64-bit integer REFERENCE where control reaches CONTROL,
;;; when that is a literal: REFERENCE itself, or the literal an IF projection
;;; above CONTROL proves it equal to (implied-count). Only single-predecessor
;;; control is walked upward (memory accesses, calls, IF projections and their
;;; IFs, plain BEGIN/END pairs), so every node passed dominates CONTROL and the
;;; tested SSA value is the same dynamic instance there: a value redefined per
;;; iteration is a PHI of a loop header the walk never crosses. At most 24
;;; control nodes are walked.
(defn known-count [(graph g/Graph) (reference i32) (control i32)] (-> (Option u64))
  (let [(mut cursor) control
        (mut steps) 0
        (mut answer) (: (None) (Option u64))]
    (if (< reference 0)
        (match (g/lookup graph reference)
          (None [] (None))
          (Some [literal]
            (if (and (symbols/numeric? literal)
                     (or (= (n/type-id literal) 5) (= (n/type-id literal) 11)))
                (Some (n/constant-bits literal))
                (None))))
        (do
          (while (and (> cursor 0) (< steps 24))
            (let [node (get (.instructions graph) (cast i64 cursor))
                  opcode (n/opcode node)]
              (set! steps (+ steps 1))
              (cond (or (= opcode 91) (= opcode 93) (= opcode 79))
                      (set! cursor (.op1 node))
                    (and (= opcode 106) (= (.op2 node) 0) (> (.op1 node) 0)
                         (= (n/opcode (get (.instructions graph) (cast i64 (.op1 node)))) 114))
                      (set! cursor (.op1 (get (.instructions graph) (cast i64 (.op1 node)))))
                    (and (or (= opcode 107) (= opcode 108)) (> (.op1 node) 0)
                         (= (n/opcode (get (.instructions graph) (cast i64 (.op1 node)))) 116))
                      (let [branch (get (.instructions graph) (cast i64 (.op1 node)))]
                        (match (implied-count graph (.op2 branch) (= opcode 107) reference 3)
                          (Some [bits]
                            (set! answer (Some bits))
                            (set! cursor 0))
                          (None [] (set! cursor (.op1 branch)))))
                    :else (set! cursor 0))))
          answer))))

