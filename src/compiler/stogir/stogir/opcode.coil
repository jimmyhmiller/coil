(def SHAPES ["v"
             "r0"
             "d2C"
             "d2"
             "d3"
             "d1"
             "d1X1"
             "d0"
             "pN"
             "p2"
             "d1X2"
             "p1X2"
             "xN"
             "a2X1"
             "s2"
             "a1"
             "l2"
             "s3"
             "l1X2"
             "s2X1"
             "x1"
             "x2"
             "x3"
             "x2X1"
             "c3"
             "S0X1"
             "S1X1"
             "S2X1"
             "S3"
             "SN"
             "E1"
             "E2"
             "T2X1"
             "T1X2"
             "x3X1"
             "x4"])

;;; Stable codes in packed operand metadata and the public name table.
(def OPERAND-DEF (: 2 u32))

(def OPERAND-GRD (: 3 u32))

(def OPERAND-LBL (: 4 u32))

(def OPERAND-PRO (: 8 u32))

(def OPERAND-REF (: 9 u32))

(def OPERAND-RET (: 11 u32))

(def OPERAND-SRC (: 12 u32))

(def OPERAND-KINDS ["___"
                    "alg"
                    "def"
                    "grd"
                    "lbl"
                    "num"
                    "opt"
                    "prb"
                    "pro"
                    "ref"
                    "reg"
                    "ret"
                    "src"
                    "str"
                    "var"])

(defn metadata [] (-> (slice u32))
  METADATA)

(defn shapes [] (-> (slice (slice u8)))
  SHAPES)

(defn operand-kinds [] (-> (slice (slice u8)))
  OPERAND-KINDS)

(defn operand-code [(op i32) (index i32)] (-> u32)
  (if (and (valid? op) (> index 0))
      (let [slot (if (> index 4) 4 (- index 1))
            bits (get (metadata) (cast i64 op))]
        (& (>> bits (cast u32 (* slot 4))) 15))
      0))

(defn shape [(op i32)] (-> (slice u8))
  (if (valid? op)
      (get (shapes)
           (cast i64 (>> (get (metadata) (cast i64 op)) 20)))
      ""))

