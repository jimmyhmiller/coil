;;; Indexed metadata follows the pinned opcode order. Low five nibbles encode
;;; operands 1..4 and the repeating tail (5+); bits 20..25 select the shape.
;;; Explicit operand 4 preserves SIMD lane/immediate rules; it is not always
;;; the same category as operand 3. Invalid opcodes/indices keep the old API.
(def METADATA [(: 0 u32)  ; 0 NOP
               1048576  ; 1 C_BOOL
               1048576  ; 2 C_U8
               1048576  ; 3 C_U16
