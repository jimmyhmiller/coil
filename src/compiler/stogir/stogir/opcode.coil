; Ported/adapted from dstogov/ir (ir.h), commit 92171d0. See NOTICE.
;;; Opcode ordering and metadata ported from upstream ir.h at 92171d0.
(module stogir.opcode)

(defn count [] (-> i32)
  131)

(defn valid? [(op i32)] (-> bool)
  (and (>= op 0) (< op (count))))

(defn name [(op i32)] (-> (slice u8))
