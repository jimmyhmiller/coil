               2097186  ; 46 OR
               2097186  ; 47 AND
               2097186  ; 48 XOR
               3145762  ; 49 SHL
               3145762  ; 50 SHR
               3145762  ; 51 SAR
               3145762  ; 52 ROL
               3145762  ; 53 ROR
               5242882  ; 54 BSWAP
               5242882  ; 55 CTPOP
               5242882  ; 56 CTLZ
               5242882  ; 57 CTTZ
               2097186  ; 58 MIN
               2097186  ; 59 MAX
               4334114  ; 60 COND
               3145762  ; 61 EXTRACT
               4334114  ; 62 REPLACE
               5242882  ; 63 SPLAT
