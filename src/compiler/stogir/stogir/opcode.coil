;;; Operand kind names match upstream. Variadic operands repeat the third kind.
(defn operand-kind [(op i32) (index i32)] (-> (slice u8))
  (match op
    (0 (if (= index 1)
           "___"
           (if (= index 2) "___" (if (>= index 3) "___" "___"))))
    (1 (if (= index 1)
           "___"
           (if (= index 2) "___" (if (>= index 3) "___" "___"))))
    (2 (if (= index 1)
           "___"
           (if (= index 2) "___" (if (>= index 3) "___" "___"))))
