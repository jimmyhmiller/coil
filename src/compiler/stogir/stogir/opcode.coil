;;; Memory operations also participate in the explicit control chain.
(defn control? [(opcode i32)] (-> bool)
  (let [flags (shape opcode)]
    (if (= (len flags) 0)
        false
        (let [kind (get flags 0)]
          (or (= kind #\c)
              (= kind #\S)
              (= kind #\E)
              (= kind #\T)
              (= kind #\l)
              (= kind #\s)
              (= kind #\x)
              (= kind #\a))))))

(defn block-start? [(opcode i32)] (-> bool)
  (let [flags (shape opcode)]
    (and (> (len flags) 0) (= (get flags 0) #\S))))

(defn block-end? [(opcode i32)] (-> bool)
  (let [flags (shape opcode)]
    (and (> (len flags) 0) (or (= (get flags 0) #\E) (= (get flags 0) #\T)))))

(defn terminator? [(opcode i32)] (-> bool)
  (let [flags (shape opcode)]
    (and (> (len flags) 0) (= (get flags 0) #\T))))

;;; Zero denotes absence only for optional links and a void RETURN's value.
(defn optional-reference? [(opcode i32) (ty i32) (index i32)] (-> bool)
  (let [kind (operand-kind opcode index)]
    (or (= kind "grd")
        (= kind "ret")
        (= kind "lbl")
        (and (= opcode 120) (= ty 0) (= index 2)))))
