;;; SWITCH and case shapes follow dstogov/ir ir.h and ir_builder.h. See NOTICE.
(module stogir.switch)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "stogir.uses" :as uses)
(import "stogir.fill" :as fill)
(import "stogir.noted" :as noted)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])
(import "coil.slice" :use [subslice])

;;; Keys map signed two's-complement values to increasing unsigned order.
(defstruct Case [(low u64) (high u64) (target i32)])

(defstruct Dispatch
  [(selector i32) (ty i32) (cases (ArrayList Case)) (fallback i32)])

(defn operation? [(opcode i32)] (-> bool)
  (or (= opcode 117) (and (>= opcode 109) (<= opcode 111))))

(defn sign-mask [(ty i32)] (-> u64)
  (if (types/signed? ty)
      (<< (: 1 u64) (cast u64 (- (* 8 (types/scalar-size ty 8)) 1)))
      0))

(defn selector-type [(graph g/Graph) (selector i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph selector)
    (None [] (Err "SWITCH selector missing"))
    (Some [node]
          (if (or (not (types/integer? (cast i32 (n/type-id node))))
                  (= (n/opcode node) 72))
              (Err "SWITCH requires an integer value")
              (Ok (cast i32 (n/type-id node)))))))

(defn switch-inputs [(graph g/Graph) (control i32) (selector i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph control)
    (None [] (Err "SWITCH control missing"))
    (Some [node]
          (if (or (<= control 0)
                  (not (op/control? (cast i32 (n/opcode node))))
                  (op/block-end? (cast i32 (n/opcode node))))
              (Err "invalid SWITCH control")
              (selector-type graph selector)))))

(defn key [(graph g/Graph) (reference i32) (ty i32)]
  (-> (Result u64 (slice u8)))
  (if (not (types/integer? ty))
      (Err "switch case requires an integer type")
      (match (g/lookup graph reference)
        (None [] (Err "switch case constant missing"))
        (Some [node]
              (let [bits (n/constant-bits node)
                    width (* 8 (types/scalar-size ty 8))]
                (if (or (>= reference 0)
                        (not (symbols/numeric? node))
                        (!= (cast i32 (n/type-id node)) ty)
                        (and (< width 64) (!= (>> bits (cast u64 width)) 0))
                        (and (= ty 1) (> bits 1)))
                    (Err "switch case must be a same-type integer constant")
                    (Ok (^ bits (sign-mask ty)))))))))

(defn case-inputs [(graph g/Graph)
                   (opcode i32)
                   (source i32)
                   (low i32)
                   (high i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph source)
    (None [] (Err "switch case source missing"))
    (Some [node]
          (if (or (<= source 0)
                  (!= (n/opcode node) 117)
                  (!= (n/type-id node) 0)
                  (!= (get (.arities graph) (cast i64 source)) 2)
                  (not (and (>= opcode 109) (<= opcode 111))))
              (Err "case projection requires SWITCH")
              (match (switch-inputs graph (.op1 node) (.op2 node))
                (Err [message] (Err message))
                (Ok [ty]
                    (if (= opcode 111)
                        (Ok ty)
                        (match (key graph low ty)
                          (Err [message] (Err message))
                          (Ok [lo]
                              (match (key graph (if (= opcode 109) low high) ty)
                                (Err [message] (Err message))
                                (Ok [hi]
                                    (if (> lo hi)
                                        (Err "reversed switch case range")
                                        (Ok ty)))))))))))))

(defn validate [(graph g/Graph) (reference i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "switch instruction missing"))
    (Some [node]
          (let [opcode (cast i32 (n/opcode node))]
            (if (or (<= reference 0)
                    (not (operation? opcode))
                    (!= (n/type-id node) 0)
                    (!= (get (.arities graph) (cast i64 reference))
                        (if (or (= opcode 109) (= opcode 110)) 3 2)))
                (Err "invalid switch instruction shape")
                (if (= opcode 117)
                    (switch-inputs graph (.op1 node) (.op2 node))
                    (case-inputs graph
                                 opcode
                                 (.op1 node)
                                 (.op2 node)
                                 (.op3 node))))))))

(defn swap! [(items (mut (ArrayList Case))) (a i64) (b i64)] (-> void)
  (let [saved (get items a)]
    (set! (mut items) a (get items b))
    (set! (mut items) b saved)))

;;; In-place heapsort: bounded memory and O(n log n), even for adversarial tags.
(defn sift! [(items (mut (ArrayList Case))) (root i64) (end i64)] (-> void)
  (let [(mut current) root
        (mut done?) false]
    (while (and (not done?) (< current (/ end 2)))
      (let [(mut child) (+ (* current 2) 1)]
        (when (and (< (+ child 1) end)
                   (< (.low (get items child)) (.low (get items (+ child 1)))))
          (set! child (+ child 1)))
        (if (>= (.low (get items current)) (.low (get items child)))
            (set! done? true)
            (do (swap! (mut items) current child) (set! current child)))))))

(defn sort! [(items (mut (ArrayList Case)))] (-> void)
  (let [(mut i) (/ (len items) 2)
        (mut end) (len items)]
    (while (> i 0)
      (set! i (- i 1))
      (sift! (mut items) i end))
    (while (> end 1)
      (set! end (- end 1))
      (swap! (mut items) 0 end)
      (sift! (mut items) 0 end))))

;;; Every use of the SWITCH, in use-index order (ascending user, then operand).
(defn collect-edges [(graph g/Graph)
                     (reference i32)
                     (edges (slice uses/Use))
                     (allocator (dyn Allocator))] (-> (Result Dispatch (slice u8)))
  (match (validate graph reference)
    (Err [message] (Err message))
    (Ok [ty]
        (let [node (get (.instructions graph) (cast i64 reference))
              (mut items) (ArrayList::new [Case] allocator)
              (mut fallback) (: 0 i32)
              (mut error) ""
              (mut i) (: 0 i64)]
          (when (!= (n/opcode node) 117)
            (set! error "dispatch requires SWITCH"))
          (while (and (= error "") (< i (len edges)))
            (let [edge (get edges i)
                  user (get (.instructions graph) (cast i64 (.user edge)))
                  opcode (cast i32 (n/opcode user))]
              (if (or (!= (.operand edge) 1) (< opcode 109) (> opcode 111))
                  (set! error "SWITCH has a non-case successor")
                  (match (validate graph (.user edge))
                    (Err [message] (set! error message))
                    (Ok [_]
                        (if (= opcode 111)
                            (if (!= fallback 0)
                                (set! error "duplicate switch default")
                                (set! fallback (.user edge)))
                            (match (key graph (.op2 user) ty)
                              (Err [message] (set! error message))
                              (Ok [lo]
                                  (match (key graph
                                              (if (= opcode 109)
                                                  (.op2 user)
                                                  (.op3 user))
                                              ty)
                                    (Err [message] (set! error message))
                                    (Ok [hi]
                                        (push! (mut items)
                                               (Case
                                                 :low lo
                                                 :high hi
                                                 :target (.user edge))))))))))))
            (set! i (+ i 1)))
          (when (= fallback 0)
            (set! error "SWITCH requires one default projection"))
          (when (= error "")
            (sort! (mut items))
            (set! i 1)
            (while (and (= error "") (< i (len items)))
              (when (<= (.low (get items i)) (.high (get items (- i 1))))
                (set! error "overlapping switch cases"))
              (set! i (+ i 1))))
          (if (= error "")
              (Ok (Dispatch
                    :selector (.op2 node)
                    :ty ty
                    :cases items
                    :fallback fallback))
              (do (free! (mut items)) (Err error)))))))

;;; Requires structural verification and a complete use index. All control
;;; successors participate, including projections omitted by observable roots.
(defn collect [(graph g/Graph)
               (reference i32)
               (indexed uses/Uses)
               (allocator (dyn Allocator))] (-> (Result Dispatch (slice u8)))
  (let [range (get (.ranges indexed) (cast i64 reference))]
    (collect-edges graph reference
                   (subslice (slice (.edges indexed)) (.offset range) (+ (.offset range) (.count range)))
                   allocator)))

;;; Requires structural and individual node validation first. One operand scan
;;; gathers exactly the edges a complete use index would hold for each SWITCH,
;;; in the same order, without indexing every other definition.
(defstruct SwitchEdge [(switch i64) (edge uses/Use)])

(defn verify [(graph g/Graph) (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut none) (noted/create allocator)
        result (verify-walk graph none false allocator)]
    (noted/release! (mut none))
    result))

;;; verify for a graph that verify/structure-noting has just passed, with NOTED
;;; as it filled it: the SWITCH nodes and the operands naming them are read
;;; from NOTED instead of being searched for.
(defn verify-among [(graph g/Graph) (noted noted/Noted) (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (verify-walk graph noted true allocator))

;;; Position of REFERENCE in the increasing list SWITCHES, or -1.
(defn position [(switches (ArrayList i32)) (reference i32)] (-> i64)
  (let [(mut lo) (: 0 i64)
        (mut hi) (len switches)]
    (while (< lo hi)
      (let [mid (+ lo (/ (- hi lo) 2))]
        (if (< (get switches mid) reference) (set! lo (+ mid 1)) (set! hi mid))))
    (if (and (< lo (len switches)) (= (get switches lo) reference)) lo -1)))

;;; One body serves both: LISTED takes the SWITCH nodes and their uses from
;;; NOTED, otherwise both come from walks over every node start.
(defn verify-walk [(graph g/Graph) (noted noted/Noted) (listed bool)
                   (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut switches) (ArrayList::new [i32] allocator)
        (mut k) (: 0 i64)
        (mut r) (: 1 i64)]
    (while (if listed (< k (len (.nodes noted))) (< r (len (.instructions graph))))
      (when listed (set! r (cast i64 (get (.nodes noted) k))))
      (when (= (n/opcode (get (.instructions graph) r)) 117)
        (push! (mut switches) (cast i32 r)))
      (if listed
          (set! k (+ k 1))
          (set! r (+ r (/ (+ (cast i64 (get (.arities graph) r)) 4) 4)))))
    (if (= (len switches) 0)
        (do (free! (mut switches)) (Ok 0))
        (let [(mut found) (ArrayList::new [SwitchEdge] allocator)
              (mut counts) (ArrayList::new [i64] allocator)
              (mut position-of) (ArrayList::new [i32] allocator)
              (mut count) (: 0 i32)
              (mut error) ""]
          (if listed
              ; The noted uses are the operands the scan below would find, in
              ; its order; each names a SWITCH node start, so it is listed.
              (for [u 0 (len (.switch-uses noted))]
                (let [use (get (.switch-uses noted) u)
                      slot (position switches (.target use))]
                  (when (< slot 0) (panic "noted SWITCH use names no noted SWITCH"))
                  (push! (mut found)
                         (SwitchEdge :switch slot
                                     :edge (uses/Use :user (.user use)
                                                     :operand (.operand use))))))
              (do
          ; Dense SWITCH positions (plus one) make each operand test one load.
          (fill/append! (mut position-of) (len (.instructions graph)) 0)
          (for [k 0 (len switches)]
            (set! (mut position-of) (cast i64 (get switches k)) (cast i32 (+ k 1))))
          (set! r 1)
          (while (< r (len (.instructions graph)))
            (let [node (get (.instructions graph) r)
                  arity (get (.arities graph) r)
                  facts (get (op/metadata) (cast i64 (n/opcode node)))
                  (mut i) (: 1 i32)]
              (while (<= i arity)
                (when (uses/edge-code? (op/operand-code-word facts i))
                  (let [value (uses/verified-input graph r i)
                        position (if (and (> value 0) (< (cast i64 value) (len position-of)))
                                     (- (cast i64 (get position-of (cast i64 value))) 1)
                                     -1)]
                    (when (>= position 0)
                      (push! (mut found)
                             (SwitchEdge :switch position
                                         :edge (uses/Use :user (cast i32 r) :operand i))))))
                (set! i (+ i 1)))
              (set! r (+ r (/ (+ (cast i64 arity) 4) 4)))))))
          ; Stable counting sort by SWITCH keeps each group's scan order.
          (for [k 0 (+ (len switches) 1)] (push! (mut counts) 0))
          (let [items-102 found (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [item (get items-102 for-index-102)]
            (set! (mut counts) (+ (.switch item) 1) (+ (get counts (+ (.switch item) 1)) 1))) (set! for-index-102 (+ for-index-102 1))))
          (for [k 0 (len switches)]
            (set! (mut counts) (+ k 1) (+ (get counts (+ k 1)) (get counts k))))
          (let [(mut grouped) (ArrayList::new [uses/Use] allocator)
                (mut cursor) (ArrayList::new [i64] allocator)]
            (extend-zeroed! (mut grouped) (len found))
            (for [k 0 (len switches)] (push! (mut cursor) (get counts k)))
            (let [items-101 found (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [item (get items-101 for-index-101)]
              (let [slot (get cursor (.switch item))]
                (set! (mut grouped) slot (.edge item))
                (set! (mut cursor) (.switch item) (+ slot 1)))) (set! for-index-101 (+ for-index-101 1))))
            (let [(mut k) (: 0 i64)]
              (while (and (= error "") (< k (len switches)))
                (match (collect-edges graph (get switches k)
                                      (subslice (slice grouped) (get counts k) (get counts (+ k 1)))
                                      allocator)
                  (Err [message] (set! error message))
                  (Ok [dispatch]
                      (let [(mut owned) dispatch]
                        (free! (mut (.cases owned)))
                        (set! count (+ count 1)))))
                (set! k (+ k 1))))
            (free! (mut cursor))
            (free! (mut grouped)))
          (free! (mut counts))
          (free! (mut position-of))
          (free! (mut found))
          (free! (mut switches))
          (if (= error "") (Ok count) (Err error))))))
