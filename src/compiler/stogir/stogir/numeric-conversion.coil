; Numeric conversion families follow dstogov/ir ir_fold.h, 92171d0. See NOTICE.
; FP-to-integer folding uses exact IEEE decoding instead of undefined host casts.
(module stogir.numeric-conversion)

(export operation? valid-types? evaluate)

(import "stogir.types" :as types)
(import "coil.primitive" :as primitive)
(import "coil.result" :use [Option Some None])

(defn operation? [(opcode i32)] (-> bool)
  (and (>= opcode 37) (<= opcode 39)))

(defn valid-types? [(opcode i32) (src i32) (dst i32)] (-> bool)
  (match opcode
    (37 (and (types/integer? src) (types/floating? dst)))
    (38 (and (types/floating? src) (types/integer? dst)))
    (39 (and (types/floating? src) (types/floating? dst)))
    (_ false)))

;;; Every magnitude fits u128. Fractional magnitudes below one truncate to zero,
;;; including negative fractions for unsigned destinations. No host FP cast.
(defn fp-to-int [(src i32) (dst i32) (pointer-bytes i32) (bits u64)]
  (-> (Option u64))
  (let [fraction-bits (if (= src 12) (: 52 i32) 23)
        exponent-mask (if (= src 12) (: 2047 u64) 255)
        bias (if (= src 12) (: 1023 i32) 127)
        exponent (& (>> bits (cast u64 fraction-bits)) exponent-mask)
        power (- (cast i32 exponent) bias)
        negative?
          (!= (& bits (if (= src 12) (: 0x8000000000000000 u64) 0x80000000)) 0)
        width (* 8 (types/scalar-size dst pointer-bytes))]
    (if (or (= exponent exponent-mask) (>= power 64))
        (None)
        (let [fraction-mask (- (<< (: 1 u64) (cast u64 fraction-bits)) 1)
              significand
                (| (<< (: 1 u128) (cast u128 fraction-bits))
                   (cast u128 (& bits fraction-mask)))
              magnitude
                (if (or (= exponent 0) (< power 0))
                    (: 0 u128)
                    (if (>= power fraction-bits)
                        (<< significand (cast u128 (- power fraction-bits)))
                        (>> significand (cast u128 (- fraction-bits power)))))
              modulus (<< (: 1 u128) (cast u128 width))
              limit (/ modulus 2)
              valid?
                (if (types/signed? dst)
                    (if negative? (<= magnitude limit) (< magnitude limit))
                    (and (or (not negative?) (= magnitude 0))
                         (< magnitude modulus)))]
          (if (not valid?)
              (None)
              (let [raw
                      (& (cast u64
                               (if negative?
                                   (- (: 0 i128) (cast i128 magnitude))
                                   (cast i128 magnitude)))
                         (cast u64 (- modulus 1)))]
                (Some (if (= dst 1) (if (= raw 0) (: 0 u64) 1) raw))))))))

(defn evaluate [(opcode i32) (src i32) (dst i32) (pointer-bytes i32) (bits u64)]
  (-> (Option u64))
  (let [src-size (types/scalar-size src pointer-bytes)
        dst-size (types/scalar-size dst pointer-bytes)]
    (if (or (not (valid-types? opcode src dst)) (<= src-size 0) (<= dst-size 0))
        (None)
        (if (= opcode 38)
            (fp-to-int src dst pointer-bytes bits)
            (if (= opcode 37)
                (let [modulus (<< (: 1 u128) (cast u128 (* src-size 8)))
                      raw (& bits (cast u64 (- modulus 1)))
                      signed-value
                        (cast i64
                              (if (>= (cast u128 raw) (/ modulus 2))
                                  (- (cast i128 raw) (cast i128 modulus))
                                  (cast i128 raw)))]
                  (if (and (= src 1) (> raw 1))
                      (None)
                      (if (= dst 12)
                          (let [(mut result)
                                  (if (types/signed? src)
                                      (cast f64 signed-value)
                                      (cast f64 raw))]
                            (Some (load (primitive/cast (ptr u64) (mut result)))))
                          (let [(mut result)
                                  (if (types/signed? src)
                                      (cast f32 signed-value)
                                      (cast f32 raw))]
                            (Some (cast u64
                                        (load (primitive/cast (ptr u32)
                                                              (mut result)))))))))
                (if (= src dst)
                    (Some (& bits
                             (if (= src 12)
                                 (: 0xFFFFFFFFFFFFFFFF u64)
                                 0xFFFFFFFF)))
                    (let [exponent
                            (if (= src 12)
                                (: 0x7FF0000000000000 u64)
                                0x7F800000)
                          fraction
                            (if (= src 12) (: 0xFFFFFFFFFFFFF u64) 0x7FFFFF)]
                      ;; NaN narrowing/extension payload processing is target-owned.
                      (if (and (= (& bits exponent) exponent)
                               (!= (& bits fraction) 0))
                          (None)
                          (if (= src 12)
                              (let [(mut input) (: 0.0 f64)]
                                (store! (primitive/cast (ptr u64) (mut input))
                                        bits)
                                (let [(mut result) (cast f32 input)]
                                  (Some (cast u64
                                              (load (primitive/cast (ptr u32)
                                                                    (mut result)))))))
                              (let [(mut input) (: 0.0 f32)]
                                (store! (primitive/cast (ptr u32) (mut input))
                                        (cast u32 bits))
                                (let [(mut result) (cast f64 input)]
                                  (Some (load (primitive/cast (ptr u64)
                                                              (mut result)))))))))))))))
