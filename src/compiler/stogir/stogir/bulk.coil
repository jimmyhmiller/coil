;;; Native bulk memory expressed entirely in the existing scalar/control IR.
(module stogir.bulk)

(export copy! move! zero! copy-bytes! move-bytes! zero-bytes! inline-limit)

(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.symbols" :as symbols)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Option Some None])

;;; Inline a bounded constant extent before memory promotion. The 128-byte
;;; experimental budget must be measured for generation cost as well as runtime.
(defn inline-limit [] (-> u64)
  128)

(defn address? [(graph g/Graph) (reference i32)] (-> bool)
  (match (g/lookup graph reference)
    (None [] false)
    (Some [node] (and (= (n/type-id node) 6) (!= (n/opcode node) 72)))))

(defn base-inputs [(graph g/Graph)
                   (control i32)
                   (destination i32)
                   (source i32)
                   (zero? bool)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph control)
    (None [] (Err "bulk memory control missing"))
    (Some [node]
          (if (or (<= control 0)
                  (not (op/control? (cast i32 (n/opcode node))))
                  (op/block-end? (cast i32 (n/opcode node))))
              (Err "bulk memory requires an open control chain")
              (if (or (not (address? graph destination))
                      (and (not zero?) (not (address? graph source))))
                  (Err "bulk memory requires ADDR values")
                  (Ok control))))))

(defn count-input [(graph g/Graph) (count i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph count)
    (None [] (Err "bulk byte count missing"))
    (Some [node]
          (if (or (!= (n/type-id node) 5)
                  (= (n/opcode node) 72)
                  (and (< count 0) (not (symbols/numeric? node))))
              (Err "bulk byte count must be a U64 value")
              (Ok count)))))

(defn known [(graph g/Graph) (count i32)] (-> (Option u64))
  (if (>= count 0)
      (None)
      (match (g/lookup graph count)
        (None [] (None))
        (Some [node] (Some (n/constant-bits node))))))

(defn capture [(result (Result i32 (slice u8))) (error (mut (slice u8)))]
  (-> i32)
  (match result (Err [message] (set! error message) 0) (Ok [value] value)))

(defn emit! [(graph (mut g/Graph))
             (error (mut (slice u8)))
             (opcode i32)
             (ty i32)
             (inputs (slice i32))] (-> i32)
  (if (!= error "")
      0
      (capture (b/emit! (mut graph) opcode ty inputs) (mut error))))

(defn constant! [(graph (mut g/Graph))
                 (error (mut (slice u8)))
                 (ty i32)
                 (bits u64)] (-> i32)
  (if (!= error "")
      0
      (capture (b/scalar-constant! (mut graph) ty bits 8) (mut error))))

(defn pointer! [(graph (mut g/Graph))
                (error (mut (slice u8)))
                (base i32)
                (offset i32)] (-> i32)
  (match (known graph offset)
    (Some [value]
          (if (= value 0)
              base
              (emit! (mut graph) (mut error) 26 6 [base offset])))
    (None [] (emit! (mut graph) (mut error) 26 6 [base offset]))))

(defn patch! [(graph (mut g/Graph))
              (error (mut (slice u8)))
              (reference i32)
              (index i32)
              (value i32)] (-> void)
  (when (= error "")
    (capture (b/patch! (mut graph) reference index value) (mut error))))

(defn width [(remaining u64)] (-> i32)
  (if (>= remaining 8) 8 (if (>= remaining 4) 4 (if (>= remaining 2) 2 1))))

(defn type-for [(width i32)] (-> i32)
  (if (= width 8) 5 (if (= width 4) 4 (if (= width 2) 3 2))))

;;; One exact transfer. Normal memory may be unaligned; no access exceeds size.
(defn transfer! [(graph (mut g/Graph))
                 (error (mut (slice u8)))
                 (control i32)
                 (destination i32)
                 (source i32)
                 (offset i32)
                 (size i32)
                 (zero? bool)] (-> i32)
  (let [target (pointer! (mut graph) (mut error) destination offset)
        value
          (if zero?
              (constant! (mut graph) (mut error) (type-for size) 0)
              (emit! (mut graph)
                     (mut error)
                     91
                     (type-for size)
                     [control (pointer! (mut graph) (mut error) source offset)]))]
    (emit! (mut graph) (mut error) 93 0 [(if zero? control value) target value])))

;;; Small moves read the entire source before any destination store. Copies and
;;; zeroes can stream exact 8/4/2/1-byte chunks with lower live-value pressure.
(defn inline! [(graph (mut g/Graph))
               (error (mut (slice u8)))
               (control i32)
               (destination i32)
               (source i32)
               (count u64)
               (move? bool)
               (zero? bool)] (-> i32)
  (let [(mut current) control
        (mut offset) (: 0 u64)
        (mut values) (ArrayList::new [i32] (.alc (.instructions graph)))]
    (while (< offset count)
      (let [size (width (- count offset))
            index (constant! (mut graph) (mut error) 5 offset)]
        (if move?
            (let [address (pointer! (mut graph) (mut error) source index)
                  loaded
                    (emit! (mut graph)
                           (mut error)
                           91
                           (type-for size)
                           [current address])]
              (push! (mut values) loaded)
              (set! current loaded))
            (set! current
                  (transfer! (mut graph)
                             (mut error)
                             current
                             destination
                             source
                             index
                             size
                             zero?)))
        (set! offset (+ offset (cast u64 size)))))
    (when move?
      (set! offset 0)
      (let [(mut i) (: 0 i64)]
        (while (< offset count)
          (let [size (width (- count offset))
                index (constant! (mut graph) (mut error) 5 offset)
                target (pointer! (mut graph) (mut error) destination index)]
            (set! current
                  (emit! (mut graph)
                         (mut error)
                         93
                         0
                         [current target (get values i)]))
            (set! offset (+ offset (cast u64 size)))
            (set! i (+ i 1))))))
    (free! (mut values))
    current))

;;; One loop over [initial,limit), or downward over (limit,initial]. Its index
;;; never wraps: guarded body subtraction/addition remains within the byte range.
(defn loop! [(graph (mut g/Graph))
             (error (mut (slice u8)))
             (control i32)
             (destination i32)
             (source i32)
             (initial i32)
             (limit i32)
             (size i32)
             (backward? bool)
             (zero? bool)] (-> i32)
  (let [entry (emit! (mut graph) (mut error) 114 0 [control])
        header
          (if (!= error "")
              0
              (capture (b/loop-begin! (mut graph) entry) (mut error)))
        index
          (if (!= error "")
              0
              (capture (b/loop-phi! (mut graph) header initial) (mut error)))
        condition
          (emit! (mut graph) (mut error) (if backward? 23 20) 1 [index limit])
        split (emit! (mut graph) (mut error) 116 0 [header condition])
        body (emit! (mut graph) (mut error) 107 0 [split (: 0 i32)])
        exit (emit! (mut graph) (mut error) 108 0 [split (: 0 i32)])
        amount (constant! (mut graph) (mut error) 5 (cast u64 size))
        next
          (emit! (mut graph) (mut error) (if backward? 27 26) 5 [index amount])
        stored
          (transfer! (mut graph)
                     (mut error)
                     body
                     destination
                     source
                     (if backward? next index)
                     size
                     zero?)
        back (emit! (mut graph) (mut error) 115 0 [stored])]
    (patch! (mut graph) (mut error) header 2 back)
    (patch! (mut graph) (mut error) index 3 next)
    exit))

(defn streamed! [(graph (mut g/Graph))
                 (error (mut (slice u8)))
                 (control i32)
                 (destination i32)
                 (source i32)
                 (count i32)
                 (backward? bool)
                 (zero? bool)] (-> i32)
  (let [zero (constant! (mut graph) (mut error) 5 0)
        mask (constant! (mut graph) (mut error) 5 0xFFFFFFFFFFFFFFF8)
        bulk
          (match (known graph count)
            (Some [value]
                  (constant! (mut graph)
                             (mut error)
                             5
                             (& value 0xFFFFFFFFFFFFFFF8)))
            (None [] (emit! (mut graph) (mut error) 47 5 [count mask])))]
    (if backward?
        (let [tail
                (loop! (mut graph)
                       (mut error)
                       control
                       destination
                       source
                       count
                       bulk
                       1
                       true
                       zero?)]
          (loop! (mut graph)
                 (mut error)
                 tail
                 destination
                 source
                 bulk
                 zero
                 8
                 true
                 zero?))
        (let [words
                (loop! (mut graph)
                       (mut error)
                       control
                       destination
                       source
                       zero
                       bulk
                       8
                       false
                       zero?)]
          (loop! (mut graph)
                 (mut error)
                 words
                 destination
                 source
                 bulk
                 count
                 1
                 false
                 zero?)))))

(defn build! [(graph (mut g/Graph))
              (control i32)
              (destination i32)
              (source i32)
              (count i32)
              (move? bool)
              (zero? bool)]
  (-> (Result i32 (slice u8)))
  (match (base-inputs graph control destination source zero?)
    (Err [message] (Err message))
    (Ok [_]
        (match (count-input graph count)
          (Err [message] (Err message))
          (Ok [_]
              (let [(mut error) ""
                    (mut result) control]
                (if (and (not zero?) (= destination source))
                    0
                    (match (known graph count)
                      (Some [size]
                            (when (!= size 0)
                              (if (<= size (inline-limit))
                                  (set! result
                                        (inline! (mut graph)
                                                 (mut error)
                                                 control
                                                 destination
                                                 source
                                                 size
                                                 move?
                                                 zero?))
                                  (if (not move?)
                                      (set! result
                                            (streamed! (mut graph)
                                                       (mut error)
                                                       control
                                                       destination
                                                       source
                                                       count
                                                       false
                                                       zero?))
                                      (set! result
                                            (move-streamed! (mut graph)
                                                            (mut error)
                                                            control
                                                            destination
                                                            source
                                                            count))))))
                      (None []
                            (set! result
                                  (if move?
                                      (move-streamed! (mut graph)
                                                      (mut error)
                                                      control
                                                      destination
                                                      source
                                                      count)
                                      (streamed! (mut graph)
                                                 (mut error)
                                                 control
                                                 destination
                                                 source
                                                 count
                                                 false
                                                 zero?))))))
                (if (= error "") (Ok result) (Err error))))))))

(defn move-streamed! [(graph (mut g/Graph))
                      (error (mut (slice u8)))
                      (control i32)
                      (destination i32)
                      (source i32)
                      (count i32)] (-> i32)
  (let [condition (emit! (mut graph) (mut error) 20 1 [destination source])
        split (emit! (mut graph) (mut error) 116 0 [control condition])
        yes (emit! (mut graph) (mut error) 107 0 [split (: 0 i32)])
        no (emit! (mut graph) (mut error) 108 0 [split (: 0 i32)])
        forward
          (streamed! (mut graph)
                     (mut error)
                     yes
                     destination
                     source
                     count
                     false
                     false)
        backward
          (streamed! (mut graph)
                     (mut error)
                     no
                     destination
                     source
                     count
                     true
                     false)
        a (emit! (mut graph) (mut error) 114 0 [forward])
        b (emit! (mut graph) (mut error) 114 0 [backward])]
    (emit! (mut graph) (mut error) 112 0 [a b])))

;;; Copy requires disjoint ranges or identical pointers. Move permits overlap.
;;; Counts are U64 byte counts. Valid accessible ranges are the caller's contract.
(defn copy! [(graph (mut g/Graph))
             (control i32)
             (destination i32)
             (source i32)
             (count i32)]
  (-> (Result i32 (slice u8)))
  (build! (mut graph) control destination source count false false))

(defn move! [(graph (mut g/Graph))
             (control i32)
             (destination i32)
             (source i32)
             (count i32)]
  (-> (Result i32 (slice u8)))
  (build! (mut graph) control destination source count true false))

(defn zero! [(graph (mut g/Graph)) (control i32) (destination i32) (count i32)]
  (-> (Result i32 (slice u8)))
  (build! (mut graph) control destination 0 count false true))

(defn fixed! [(graph (mut g/Graph))
              (control i32)
              (destination i32)
              (source i32)
              (size i64)
              (move? bool)
              (zero? bool)] (-> (Result i32 (slice u8)))
  (if (< size 0)
      (Err "negative bulk byte count")
      (match (base-inputs graph control destination source zero?)
        (Err [message] (Err message))
        (Ok [_]
            (if (or (= size 0) (and (not zero?) (= destination source)))
                (Ok control)
                (match (b/scalar-constant! (mut graph) 5 (cast u64 size) 8)
                  (Err [message] (Err message))
                  (Ok [count]
                      (build! (mut graph)
                              control
                              destination
                              source
                              count
                              move?
                              zero?))))))))

(defn copy-bytes! [(graph (mut g/Graph))
                   (control i32)
                   (destination i32)
                   (source i32)
                   (size i64)]
  (-> (Result i32 (slice u8)))
  (fixed! (mut graph) control destination source size false false))

(defn move-bytes! [(graph (mut g/Graph))
                   (control i32)
                   (destination i32)
                   (source i32)
                   (size i64)]
  (-> (Result i32 (slice u8)))
  (fixed! (mut graph) control destination source size true false))

(defn zero-bytes! [(graph (mut g/Graph))
                   (control i32)
                   (destination i32)
                   (size i64)]
  (-> (Result i32 (slice u8)))
  (fixed! (mut graph) control destination 0 size false true))
