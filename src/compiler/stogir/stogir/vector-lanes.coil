;;; Typed lane transport: EXTRACT, REPLACE and SPLAT over explicit target geometry.
(module stogir.vector-lanes)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "coil.result" :use [Result Ok Err Some None])

(defn operation? [(opcode i32)] (-> bool)
  (and (>= opcode 61) (<= opcode 63)))

(defn compatible? [(vector-type i32) (scalar-type i32) (pointer-bytes i32)]
  (-> bool)
  (let [base (types/base-type vector-type)]
    (and (types/vector? vector-type)
         (or (= pointer-bytes 4) (= pointer-bytes 8))
         (types/valid-scalar? scalar-type)
         (> scalar-type 0)
         (or (= base scalar-type)
             (and (types/integer? base)
                  (types/integer? scalar-type)
                  (= (types/scalar-size base pointer-bytes)
                     (types/scalar-size scalar-type pointer-bytes)))))))

(defn ordinary? [(node n/Node)] (-> bool)
  (and (!= (n/opcode node) 72) (!= (n/opcode node) 70)))

;;; -1 denotes a dynamic (possibly symbolic) scalar index, never a literal lane.
(defn constant-index [(graph g/Graph) (reference i32)] (-> i32)
  (match (g/lookup graph reference)
    (None [] -1)
    (Some [node]
          (if (and (< reference 0)
                   (types/integer? (cast i32 (n/type-id node)))
                   (symbols/numeric? node)
                   (< (n/constant-bits node) 64))
              (cast i32 (n/constant-bits node))
              -1))))

(defn operands [(graph g/Graph)
                (opcode i32)
                (result-type i32)
                (pointer-bytes i32)
                (input i32)
                (index i32)
                (replacement i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph input)
    (None [] (Err "vector lane operand missing"))
    (Some [source]
          (let [vector-type
                  (if (= opcode 61) (cast i32 (n/type-id source)) result-type)
                scalar-type
                  (if (= opcode 61) result-type (cast i32 (n/type-id source)))
                (mut error) ""]
            (when (or (not (operation? opcode))
                      (not (types/vector? vector-type))
                      (not (or (= pointer-bytes 4) (= pointer-bytes 8)))
                      (not (ordinary? source)))
              (set! error
                    "invalid vector lane operation, operand or target width"))
            (if (= opcode 63)
                (when (or (not (compatible? vector-type
                                            scalar-type
                                            pointer-bytes))
                          (!= index 0)
                          (!= replacement 0))
                  (set! error "invalid vector splat source or shape"))
                (do
                  (when (and (= opcode 61)
                             (not (compatible? vector-type
                                               result-type
                                               pointer-bytes)))
                    (set! error "vector extraction scalar type mismatch"))
                  (when (and (= opcode 62)
                             (!= (cast i32 (n/type-id source)) vector-type))
                    (set! error "vector replacement source type mismatch"))
                  (match (g/lookup graph index)
                    (None [] (set! error "vector lane index missing"))
                    (Some [count]
                          (when (or (not (types/integer? (cast i32
                                                               (n/type-id count))))
                                    (not (ordinary? count)))
                            (set! error
                                  "vector lane index requires a scalar integer"))
                          (when (and (< index 0)
                                     (symbols/numeric? count)
                                     (>= (n/constant-bits count)
                                         (cast u64 (types/lanes vector-type))))
                            (set! error
                                  "vector literal lane index outside vector"))))
                  (if (= opcode 62)
                      (match (g/lookup graph replacement)
                        (None []
                              (set! error "vector replacement value missing"))
                        (Some [value]
                              (when (or (not (ordinary? value))
                                        (not (compatible? vector-type
                                                          (cast i32
                                                                (n/type-id value))
                                                          pointer-bytes)))
                                (set! error
                                      "vector replacement scalar type mismatch"))))
                      (when (!= replacement 0)
                        (set! error "vector extraction shape mismatch")))))
            (if (= error "") (Ok vector-type) (Err error))))))

(defn validate [(graph g/Graph) (reference i32) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "vector lane instruction missing"))
    (Some [node]
          (let [opcode (cast i32 (n/opcode node))]
            (if (or (<= reference 0)
                    (not (operation? opcode))
                    (!= (get (.arities graph) (cast i64 reference))
                        (if (= opcode 61) 2 (if (= opcode 62) 3 1))))
                (Err "invalid vector lane instruction shape")
                (operands graph
                          opcode
                          (cast i32 (n/type-id node))
                          pointer-bytes
                          (.op1 node)
                          (if (= opcode 63) 0 (.op2 node))
                          (if (= opcode 62) (.op3 node) 0)))))))
