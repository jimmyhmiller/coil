;;; Natural-loop membership from dominance backedges.
(module stogir.loops)
(import "stogir.cfg" :as cfg)
(import "stogir.adjacency" :as adj)
(import "stogir.dominators" :as dom)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

;;; Multiple backedges to a header are unioned before increasing nesting depth.
;;; Irreducible cycles require separate analysis; this counts natural loops only.
(defn depths [(blocks cfg/Blocks)
              (predecessors adj/Index)
              (idom (ArrayList i32))
              (allocator (dyn Allocator))]
  (-> (ArrayList i32))
  (let [(mut dominance) (dom/build-index idom allocator)
        (mut depth) (ArrayList::new [i32] allocator)
        (mut seen) (ArrayList::new [i32] allocator)
        (mut work) (ArrayList::new [i32] allocator)]
    (extend-zeroed! (mut depth) (len (.membership blocks)))
    (extend-zeroed! (mut seen) (len (.membership blocks)))
    (for header (.starts blocks)
      (clear! (mut work))
      ; Valid CFG starts are unique positive references, so each header is
      ; its own visitation epoch. Do not clear the whole graph per header.
      (set! (mut seen) (cast i64 header) header)
      (let [incoming (get (.ranges predecessors) (cast i64 header))
            (mut backedge?) false
            (mut j) 0]
        (while (< j (.count incoming))
          (let [index (get (.edges predecessors) (+ (.offset incoming) j))
                edge (get (.edges blocks) index)
                source (.from edge)]
            (when (dom/indexed-dominates? dominance header source)
              (unless backedge?
                (set! (mut depth) (cast i64 header) (+ (get depth (cast i64 header)) 1)))
              (set! backedge? true)
              (when (!= (get seen (cast i64 source)) header)
                (set! (mut seen) (cast i64 source) header)
                (set! (mut depth) (cast i64 source) (+ (get depth (cast i64 source)) 1))
                (push! (mut work) source))))
          (set! j (+ j 1)))
        (when backedge?
          (let [(mut cursor) 0]
            (while (< cursor (len work))
              (let [block (get work cursor)
                    range (get (.ranges predecessors) (cast i64 block))
                    (mut k) 0]
                (while (< k (.count range))
                  (let [index (get (.edges predecessors) (+ (.offset range) k))
                        edge (get (.edges blocks) index)
                        source (.from edge)]
                    (when (and (!= (get idom (cast i64 source)) 0)
                               (!= (get seen (cast i64 source)) header))
                      (set! (mut seen) (cast i64 source) header)
                      (set! (mut depth) (cast i64 source) (+ (get depth (cast i64 source)) 1))
                      (push! (mut work) source)))
                  (set! k (+ k 1))))
              (set! cursor (+ cursor 1)))))))
    (dom/release-index! (mut dominance))
    (free! (mut seen))
    (free! (mut work))
    depth))

;;; Upstream ir_gcm.c:ir_fix_bb_order visits shallower successors first in its
;;; postorder walk, placing deeper loops first after reversal. Equal depths use
;;; reverse successor order. A heap preserves that priority without quadratic
;;; rescanning at high-fanout switches. Entries are indices into cfg edges.
(defn before? [(blocks cfg/Blocks) (depth (ArrayList i32)) (a i64) (b i64)]
  (-> bool)
  (let [left (get depth (cast i64 (.to (get (.edges blocks) a))))
        right (get depth (cast i64 (.to (get (.edges blocks) b))))]
    (or (< left right) (and (= left right) (> a b)))))

(defn sift! [(heap (mut (ArrayList i64)))
             (offset i64)
             (count i64)
             (start i64)
             (blocks cfg/Blocks)
             (depth (ArrayList i32))] (-> void)
  (let [(mut parent) start
        (mut done) false]
    (while (and (not done) (< (+ (* parent 2) 1) count))
      (let [(mut child) (+ (* parent 2) 1)]
        (when (and (< (+ child 1) count)
                   (before? blocks
                            depth
                            (get heap (+ offset child 1))
                            (get heap (+ offset child))))
          (set! child (+ child 1)))
        (if (before? blocks
                     depth
                     (get heap (+ offset child))
                     (get heap (+ offset parent)))
            (let [value (get heap (+ offset parent))]
              (set! (mut heap) (+ offset parent) (get heap (+ offset child)))
              (set! (mut heap) (+ offset child) value)
              (set! parent child))
            (set! done true))))))

(defn heapify! [(heap (mut (ArrayList i64)))
                (range adj/Range)
                (blocks cfg/Blocks)
                (depth (ArrayList i32))] (-> void)
  (let [(mut i) (/ (.count range) 2)]
    (while (> i 0)
      (set! i (- i 1))
      (sift! (mut heap) (.offset range) (.count range) i blocks depth))))

;;; Reachable reducible CFGs only. For irreducible retreating edges retain the
;;; existing order; upstream's irreducible-side-entry classification is not yet
;;; represented here. The graph and block reference IDs are never rewritten.
(defn reorder! [(blocks cfg/Blocks)
                (successors adj/Index)
                (idom (ArrayList i32))
                (depth (ArrayList i32))
                (order (mut (ArrayList i32)))
                (allocator (dyn Allocator))]
  (-> (Result bool (slice u8)))
  (let [(mut needed) false]
    (for edge (.edges blocks)
      (when (and (> (get idom (cast i64 (.from edge))) 0)
                 (> (get idom (cast i64 (.to edge))) 0)
                 (>= (.from edge) (.to edge))
                 (not (dom/dominates? idom (.to edge) (.from edge))))
        (set! needed true)))
    (if (= (len order) 0)
        (Ok false)
        (if (not needed)
            ; ir_schedule keeps the original block order when it already satisfies
            ; predecessor/backedge constraints. The initial RPO was only for idom.
            (let [(mut count) 0
                  (mut changed) false]
              (for block (.starts blocks)
                (when (> (get idom (cast i64 block)) 0)
                  (set! count (+ count 1))))
              (if (!= count (len order))
                  (Err "canonical scheduling changed reachable block count")
                  (do
                    (set! count 0)
                    (for block (.starts blocks)
                      (when (> (get idom (cast i64 block)) 0)
                        (when (!= (get order count) block) (set! changed true))
                        (set! (mut order) count block)
                        (set! count (+ count 1))))
                    (Ok changed))))
            (let [(mut ranks) (ArrayList::new [i32] allocator)
                  (mut reducible) true]
              (for [i 0 (len idom)] (push! (mut ranks) -1))
              (for [i 0 (len order)]
                (set! (mut ranks) (cast i64 (get order i)) (cast i32 i)))
              (for edge (.edges blocks)
                (let [from (get ranks (cast i64 (.from edge)))
                      to (get ranks (cast i64 (.to edge)))]
                  (when (and (>= from 0)
                             (>= to 0)
                             (>= from to)
                             (not (dom/dominates? idom (.to edge) (.from edge))))
                    (set! reducible false))))
              (if (not reducible)
                  (do (free! (mut ranks)) (Ok false))
                  (let [(mut heap) (ArrayList::new [i64] allocator)
                        (mut stack) (ArrayList::new [adj/Frame] allocator)
                        (mut postorder) (ArrayList::new [i32] allocator)
                        entry (get order 0)]
                    (for [i 0 (len ranks)] (set! (mut ranks) i 0))
                    (for index (.edges successors) (push! (mut heap) index))
                    (let [range (get (.ranges successors) (cast i64 entry))]
                      (heapify! (mut heap) range blocks depth)
                      (push! (mut stack)
                             (adj/Frame :block entry :next-edge (.count range))))
                    (set! (mut ranks) (cast i64 entry) 1)
                    (while (> (len stack) 0)
                      (let [top (- (len stack) 1)
                            (mut frame) (get stack top)
                            range
                              (get (.ranges successors)
                                   (cast i64 (.block frame)))]
                        (if (= (.next-edge frame) 0)
                            (do
                              (push! (mut postorder) (.block frame))
                              (pop! (mut stack)))
                            (let [index (get heap (.offset range))
                                  target (.to (get (.edges blocks) index))]
                              (set! (.next-edge frame) (- (.next-edge frame) 1))
                              (set! (mut heap)
                                    (.offset range)
                                    (get heap
                                         (+ (.offset range) (.next-edge frame))))
                              (sift! (mut heap)
                                     (.offset range)
                                     (.next-edge frame)
                                     0
                                     blocks
                                     depth)
                              (set! (mut stack) top frame)
                              (when (= (get ranks (cast i64 target)) 0)
                                (let [next-range
                                        (get (.ranges successors)
                                             (cast i64 target))]
                                  (heapify! (mut heap) next-range blocks depth)
                                  (push! (mut stack)
                                         (adj/Frame
                                           :block target
                                           :next-edge (.count next-range))))
                                (set! (mut ranks) (cast i64 target) 1))))))
                    (let [complete (= (len postorder) (len order))
                          (mut changed) false]
                      (when complete
                        (for [i 0 (len order)]
                          (let [block
                                  (get postorder (- (- (len postorder) 1) i))]
                            (when (!= (get order i) block) (set! changed true))
                            (set! (mut order) i block))))
                      (free! (mut ranks))
                      (free! (mut heap))
                      (free! (mut stack))
                      (free! (mut postorder))
                      (if complete
                          (Ok changed)
                          (Err "loop-aware scheduling changed reachable block count"))))))))))
