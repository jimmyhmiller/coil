; Ported/adapted from dstogov/ir (ir.h and ir.c), commit 92171d0. See NOTICE.
;;; Signed-reference graph storage. References survive array growth; pointers do not.
;;; Separate contiguous instruction/constant arrays implement the two directions.
;;; Callers retain references; checked node borrows are scoped to immutable reads.
(module stogir.graph)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.long-constant" :as long)
(import "stogir.strings" :as strings)
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.hashmap" :use [HashMap])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Option Some None])

(defstruct Graph
  [(instructions (ArrayList n/Node))
   (constants (ArrayList n/Node))
   (constant-spans (ArrayList i32))
   (arities (ArrayList i32))
   (constant-heads (HashMap u64 i32))
   (expressions (HashMap u128 i32))
   (strings strings/Pool)
   (function-prototype i32)])

(defn create [(a (dyn Allocator))] (-> Graph)
  (let [(mut cells) (ArrayList::new [n/Node] a)
        (mut arities) (ArrayList::new [i32] a)]
    (push! (mut cells) (n/make 0 0 0 0 0 0))
    (push! (mut arities) -1)
    (Graph
      :instructions cells
      :constants (ArrayList::new [n/Node] a)
      :constant-spans (ArrayList::new [i32] a)
      :arities arities
      :constant-heads (HashMap::new-scalar [u64 i32] a)
      :expressions (HashMap::new-scalar [u128 i32] a)
      :strings (strings/create a)
      :function-prototype 0)))

(defn contains? [(g Graph) (r i32)] (-> bool)
  (if (> r 0)
      (and (< (cast i64 r) (len (.instructions g)))
           (>= (get (.arities g) (cast i64 r)) 0))
      (and (< r 0)
           (= (len (.constants g)) (len (.constant-spans g)))
           (<= (- 0 (cast i64 r)) (len (.constants g)))
           (> (get (.constant-spans g) (- (- 0 (cast i64 r)) 1)) 0))))

(defn lookup [(g Graph) (r i32)] (-> (Option n/Node))
  (if (not (contains? g r))
      (None)
      (Some (if (> r 0)
                (get (.instructions g) (cast i64 r))
                (get (.constants g) (- (- 0 (cast i64 r)) 1))))))

;;; Checked short-lived borrow, following upstream's instruction-cell reads.
;;; Null has exactly lookup's absent-reference meaning. Requires consistent
;;; graph storage, like lookup. Do not mutate/grow/release the graph while this
;;; pointer is in use; retain references, never pointers, across such operations.
(defn borrow-node [(graph Graph) (reference i32)] (-> (ptr n/Node))
  (if (not (contains? graph reference))
      (p/cast (ptr n/Node) 0)
      (if (> reference 0)
          (p/index (.data (.instructions graph)) (cast i64 reference))
          (p/index (.data (.constants graph)) (- (- 0 (cast i64 reference)) 1)))))

;;; Storage primitive for initialized instruction extents. Callers validate the
;;; reference/index and invalidate construction CSE when changing existing nodes.
(defn write-input-word! [(g (mut Graph)) (r i32) (index i32) (value i32)]
  (-> void)
  (let [word (cast i64 index)
        cell (+ (cast i64 r) (/ word 4))
        slot (% word 4)
        (mut node) (get (.instructions g) cell)]
    (if (= slot 0)
        (set! (.header node) (cast u32 value))
        (if (= slot 1)
            (set! (.op1 node) value)
            (if (= slot 2)
                (set! (.op2 node) value)
                (set! (.op3 node) value))))
    (set! (mut (.instructions g)) cell node)))

;;; None reports reference-space exhaustion. Allocation failure follows allocator policy.
(defn append! [(g (mut Graph)) (node n/Node)] (-> (Option i32))
  (let [idx (len (.instructions g))]
    (if (> idx 2147483647)
        (None)
        (do
          (push! (mut (.instructions g)) node)
          (push! (mut (.arities g)) 3)
          (Some (cast i32 idx))))))

(defn append-constant! [(g (mut Graph)) (node n/Node)] (-> (Option i32))
  (let [idx (len (.constants g))]
    (if (>= idx 2147483648)
        (None)
        (do
          (push! (mut (.constants g)) node)
          (push! (mut (.constant-spans g)) 1)
          (Some (cast i32 (- -1 idx)))))))

(defn release! [(g (mut Graph))] (-> void)
  (free! (mut (.instructions g)))
  (free! (mut (.constants g)))
  (free! (mut (.constant-spans g)))
  (free! (mut (.arities g)))
  (free! (mut (.constant-heads g)))
  (free! (mut (.expressions g)))
  (strings/release! (mut (.strings g))))

;;; Owned copy of the same graph representation, retaining every reference and
;;; interned string/prototype ID. Optimizers can mutate this working graph while
;;; immutable compilation APIs continue to preserve the caller's graph.
(defn duplicate [(source Graph) (a (dyn Allocator))] (-> Graph)
  (let [(mut result) (create a)]
    (clear! (mut (.instructions result)))
    (clear! (mut (.arities result)))
    (extend! (mut (.instructions result))
             (.data (.instructions source))
             (len (.instructions source)))
    (extend! (mut (.arities result))
             (.data (.arities source))
             (len (.arities source)))
    (extend! (mut (.constants result))
             (.data (.constants source))
             (len (.constants source)))
    (extend! (mut (.constant-spans result))
             (.data (.constant-spans source))
             (len (.constant-spans source)))
    (extend! (mut (.bytes (.strings result)))
             (.data (.bytes (.strings source)))
             (len (.bytes (.strings source))))
    (extend! (mut (.entries (.strings result)))
             (.data (.entries (.strings source)))
             (len (.entries (.strings source))))
    (when (> (len (.constant-heads source)) 0)
      (for key (.constant-heads source)
        (match (get (.constant-heads source) key)
          (Some [value] (set! (mut (.constant-heads result)) key value))
          (None [] (panic "constant interner changed during graph duplication")))))
    (when (> (len (.expressions source)) 0)
      (for key (.expressions source)
        (match (get (.expressions source) key)
          (Some [value] (set! (mut (.expressions result)) key value))
          (None [] (panic "expression cache changed during graph duplication")))))
    (when (> (len (.heads (.strings source))) 0)
      (for key (.heads (.strings source))
        (match (get (.heads (.strings source)) key)
          (Some [value] (set! (mut (.heads (.strings result))) key value))
          (None [] (panic "string interner changed during graph duplication")))))
    (set! (.function-prototype result) (.function-prototype source))
    result))

;;; The arity metadata distinguishes node starts from continuation cells.
;;; Raw append! reserves all three operand words; opcode validation is separate.
(defn append-inputs! [(g (mut Graph)) (opcode u8) (ty u8) (inputs (slice i32))]
  (-> (Option i32))
  (if (> (len inputs) 65535)
      (None)
      (append-inputs-with-aux! (mut g) opcode ty (cast u16 (len inputs)) inputs)))

;;; Initialize auxiliary metadata as part of append. This does not mutate an
;;; existing expression, so construction must not invalidate the CSE table.
(defn append-inputs-with-aux! [(g (mut Graph))
                               (opcode u8)
                               (ty u8)
                               (auxiliary u16)
                               (inputs (slice i32))]
  (-> (Option i32))
  (let [count (len inputs)
        start (len (.instructions g))
        cells (/ (+ count 4) 4)]
    (if (or (> count 65535) (> (+ start cells) 2147483648))
        (None)
        (do
          (push! (mut (.instructions g))
                 (n/make opcode ty auxiliary 0 0 0))
          (push! (mut (.arities g)) (cast i32 count))
          (let [(mut j) 1]
            (while (< j cells)
              (push! (mut (.instructions g)) (n/make 0 0 0 0 0 0))
              (push! (mut (.arities g)) -1)
              (set! j (+ j 1))))
          (for [i 0 count]
            (write-input-word! (mut g)
                               (cast i32 start)
                               (cast i32 (+ i 1))
                               (get inputs i)))
          (Some (cast i32 start))))))

;;; Operand indices are one-based, as in upstream ir_insn_op.
(defn operand [(g Graph) (r i32) (index i32)] (-> (Option i32))
  (if (or (<= r 0) (not (contains? g r)))
      (None)
      (if (or (< index 1) (> index (get (.arities g) (cast i64 r))))
          (None)
          (let [word (cast i64 index)
                node (get (.instructions g) (+ (cast i64 r) (/ word 4)))
                slot (% word 4)]
            (Some (if (= slot 0)
                      (cast i32 (.header node))
                      (if (= slot 1)
                          (.op1 node)
                          (if (= slot 2) (.op2 node) (.op3 node)))))))))

(defn invalidate-expressions! [(g (mut Graph))] (-> void)
  ; Repeated rewrites must not rescan a retained, already-empty hash table.
  (when (> (len (.expressions g)) 0)
    (clear! (mut (.expressions g)))))

;;; Patching keeps the node allocation and all references stable.
(defn set-operand! [(g (mut Graph)) (r i32) (index i32) (value i32)] (-> bool)
  (if (or (<= r 0) (not (contains? g r)))
      false
      (if (or (< index 1) (> index (get (.arities g) (cast i64 r))))
          false
          (do
            (write-input-word! (mut g) r index value)
            (invalidate-expressions! (mut g))
            true))))

;;; Replace a node within its current allocation without moving any preexisting
;;; valid reference. A smaller extent exposes its cleared tail as zero-arity
;;; NOPs, so every graph walk retains valid start/continuation metadata. Growing
;;; beyond the original cell extent fails without mutation. Inputs must not
;;; alias graph storage. Analysis/use-list caches held by the caller are invalid
;;; after success; construction CSE is invalidated here.
(defn rewrite-inputs-with-aux! [(g (mut Graph))
                                (r i32)
                                (opcode u8)
                                (ty u8)
                                (auxiliary u16)
                                (inputs (slice i32))] (-> bool)
  (if (or (<= r 0)
          (!= (len (.arities g)) (len (.instructions g)))
          (not (contains? g r))
          (> (len inputs) 65535))
      false
      (let [start (cast i64 r)
            old-count (get (.arities g) start)
            old-cells (/ (+ (cast i64 old-count) 4) 4)
            cells (/ (+ (len inputs) 4) 4)]
        (if (or (> old-count 65535)
                (> cells old-cells)
                (> (+ start old-cells) (len (.instructions g))))
            false
            (do
              (for [i start (+ start old-cells)]
                (set! (mut (.instructions g)) i (n/make 0 0 0 0 0 0))
                (set! (mut (.arities g)) i 0))
              (set! (mut (.instructions g))
                    start
                    (n/make opcode ty auxiliary 0 0 0))
              (set! (mut (.arities g)) start (cast i32 (len inputs)))
              (for [i (+ start 1) (+ start cells)]
                (set! (mut (.arities g)) i -1))
              (for [i 0 (len inputs)]
                (write-input-word! (mut g) r (cast i32 (+ i 1)) (get inputs i)))
              (invalidate-expressions! (mut g))
              true)))))

(defn rewrite-inputs! [(g (mut Graph))
                       (r i32)
                       (opcode u8)
                       (ty u8)
                       (inputs (slice i32))] (-> bool)
  (if (> (len inputs) 65535)
      false
      (rewrite-inputs-with-aux! (mut g)
                                r
                                opcode
                                ty
                                (cast u16 (len inputs))
                                inputs)))

;;; Incoming graph edges/roots must be removed or remapped by the owning pass.
(defn make-nop! [(g (mut Graph)) (r i32)] (-> bool)
  (rewrite-inputs-with-aux! (mut g) r 0 0 0 []))

(defn set-auxiliary! [(g (mut Graph)) (r i32) (value u16)] (-> bool)
  (if (or (<= r 0) (not (contains? g r)))
      false
      (let [(mut node) (get (.instructions g) (cast i64 r))]
        (set! (.header node)
              (| (& (.header node) 65535) (<< (cast u32 value) 16)))
        (set! (mut (.instructions g)) (cast i64 r) node)
        (invalidate-expressions! (mut g))
        true)))

;;; Exact header/payload interning; numeric constants keep their original hashes.
(defn intern-scalar! [(g (mut Graph)) (ty u8) (bits u64)] (-> (Option i32))
  (intern-constant! (mut g) ty ty 0 bits))

(defn intern-constant! [(g (mut Graph))
                        (opcode u8)
                        (ty u8)
                        (auxiliary u16)
                        (bits u64)]
  (-> (Option i32))
  (let [header (.header (n/make opcode ty auxiliary 0 0 0))
        key
          (^ bits
             (<< (cast u64 ty) 56)
             (<< (cast u64 (^ opcode ty)) 48)
             (<< (cast u64 auxiliary) 32))
        (mut head) (: 0 i32)
        (mut found) (: 0 i32)]
    (match (get (.constant-heads g) key) (Some [r] (set! head r)) (None [] 0))
    (let [(mut r) head]
      (while (and (!= r 0) (= found 0))
        (match (lookup g r)
          (Some [node]
                (if (and (= (.header node) header)
                         (= (n/constant-bits node) bits))
                    (set! found r)
                    (set! r (.op1 node))))
          (None [] (set! r 0)))))
    (if (!= found 0)
        (Some found)
        (match (append-constant! (mut g)
                                 (n/make opcode
                                         ty
                                         auxiliary
                                         head
                                         (cast i32 (cast u32 bits))
                                         (cast i32 (>> bits 32))))
          (Some [r] (do (set! (mut (.constant-heads g)) key r) (Some r)))
          (None [] (None))))))

;;; Header is at the most-negative reference; payload cell k is ref+k+1.
;;; Metadata distinguishes payload cells from usable negative graph values.
(defn long-size [(g Graph) (reference i32)] (-> i64)
  (match (lookup g reference)
    (None [] -1)
    (Some [node]
          (let [index (- (- 0 (cast i64 reference)) 1)
                size (cast i64 (n/auxiliary node))
                span (long/cells size)]
            (if (or (>= reference 0)
                    (!= (n/opcode node) 78)
                    (< span 2)
                    (!= (get (.constant-spans g) index) span)
                    (< index (- (cast i64 span) 1)))
                -1
                size)))))

(defn long-byte [(g Graph) (reference i32) (index i64)] (-> (Option u8))
  (let [size (long-size g reference)]
    (if (or (< index 0) (>= index size))
        (None)
        (let [cell (- (- (- 0 (cast i64 reference)) 2) (/ index 16))]
          (if (!= (get (.constant-spans g) cell) 0)
              (None)
              (Some (n/payload-byte (get (.constants g) cell)
                                    (cast i32 (% index 16)))))))))

;;; Complete immutable vector bytes, with upstream header/hash/payload ordering.
;;; Allocation failure follows allocator policy. None reports invalid geometry,
;;; malformed interning chains, or exhausted signed reference space.
(defn intern-vector! [(g (mut Graph))
                      (ty i32)
                      (pointer-bytes i32)
                      (payload (slice u8))]
  (-> (Option i32))
  (let [size (len payload)
        span (long/cells size)
        header-node (n/make 78 (cast u8 ty) (cast u16 size) 0 0 0)]
    (if (or (not (types/vector? ty))
            (!= (cast i64 (types/size ty pointer-bytes)) size)
            (< span 2)
            (!= (len (.constants g)) (len (.constant-spans g))))
        (None)
        (let [header (.header header-node)
              hash (long/hash header payload)
              head
                (match (get (.constant-heads g) hash) (Some [r] r) (None [] 0))
              (mut reference) head
              (mut found) (: 0 i32)
              (mut valid) true]
          (while (and (!= reference 0) (= found 0) valid)
            (if (> reference 0)
                (set! valid false)
                (match (lookup g reference)
                  (None [] (set! valid false))
                  (Some [node]
                        (when (and (= (.header node) header)
                                   (= (n/constant-bits node) hash))
                          (let [(mut same) (= (long-size g reference) size)
                                (mut i) (: 0 i64)]
                            (while (and same (< i size))
                              (match (long-byte g reference i)
                                (None [] (set! same false))
                                (Some [byte]
                                      (when (!= byte (get payload i))
                                        (set! same false))))
                              (set! i (+ i 1)))
                            (when same (set! found reference))))
                        (let [previous (.op1 node)]
                          (if (and (!= previous 0) (<= previous reference))
                              (set! valid false)
                              (set! reference previous)))))))
          (if (not valid)
              (None)
              (if (!= found 0)
                  (Some found)
                  (if (> (+ (len (.constants g)) (cast i64 span)) 2147483648)
                      (None)
                      (let [(mut chunk) (- span 1)]
                        (while (> chunk 0)
                          (set! chunk (- chunk 1))
                          (push! (mut (.constants g))
                                 (n/payload-cell payload
                                                 (* (cast i64 chunk) 16)))
                          (push! (mut (.constant-spans g)) 0))
                        (match (append-constant! (mut g)
                                                 (n/make 78
                                                         (cast u8 ty)
                                                         (cast u16 size)
                                                         head
                                                         (cast i32
                                                               (cast u32 hash))
                                                         (cast i32 (>> hash 32))))
                          (None [] (None))
                          (Some [r]
                                (set! (mut (.constant-spans g))
                                      (- (len (.constant-spans g)) 1)
                                      span)
                                (set! (mut (.constant-heads g)) hash r)
                                (Some r)))))))))))
