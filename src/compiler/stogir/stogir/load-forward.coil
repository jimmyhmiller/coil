;;; Memory-chain forwarding follows ir.c:ir_find_aliasing_load_i. See NOTICE.
;;; Contained-offset extraction is an independent little-endian extension.
(module stogir.load-forward)
(import "stogir.graph" :as g)
(import "stogir.address-alias" :as alias)
(import "stogir.calls" :as calls)
(import "stogir.strings" :as strings)
(import "stogir.call-results" :as results)
(import "stogir.call-effects" :as effects)
(import "stogir.private-object" :as private)
(import "stogir.node" :as n)
(import "stogir.symbols" :as symbols)
(import "stogir.opcode" :as op)
(import "stogir.types" :as ty)
(import "stogir.uses" :as uses)
(import "stogir.mem2ssa" :as mem)
(import "stogir.fill" :as fill)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Address [(base i32) (offset i64)])

;;; A bounded decomposition only proves facts for constant displacements. Unknown
;;; expressions retain their exact reference as base; no pointer provenance or
;;; integer expression equivalence is inferred. Full-width pointer/integer BITCAST
;;; preserves address bits and may be peeled; no distinct-base nonalias fact is used. Bounds prevent offset overflow.
(defn word? [(type u8)] (-> bool)
  (or (= type 5) (= type 6) (= type 11)))

(defn address [(graph g/Graph) (reference i32)] (-> Address)
  (let [(mut base) reference
        (mut offset) 0
        (mut steps) 0
        (mut more) true]
    (while (and more (< steps 16))
      (set! more false)
      (match (g/lookup graph base)
        (Some [node]
              (if (and (= (n/opcode node) 36) (word? (n/type-id node)))
                  (match (g/lookup graph (.op1 node))
                    (Some [input]
                          (when (word? (n/type-id input))
                            (set! base (.op1 node))
                            (set! more true)))
                    (None [] 0))
                  (when (and (= (n/opcode node) 26) (word? (n/type-id node)))
                    (let [(mut parent) (.op1 node)
                          (mut constant) (.op2 node)]
                      (when (< parent 0)
                        (set! parent (.op2 node))
                        (set! constant (.op1 node)))
                      (match (g/lookup graph constant)
                        (Some [value]
                              (when (and (< constant 0)
                                         (symbols/numeric? value)
                                         (ty/integer? (cast i32
                                                            (n/type-id value)))
                                         (= (ty/size (cast i32
                                                           (n/type-id value))
                                                     8)
                                            8))
                                (let [delta (cast i64 (n/constant-bits value))]
                                  (when (and (>= delta -1073741824)
                                             (<= delta 1073741824))
                                    (set! offset (+ offset delta))
                                    (set! base parent)
                                    (set! more true)))))
                        (None [] 0))))))
        (None [] 0))
      (set! steps (+ steps 1)))
    (Address :base base :offset offset)))

(defn scalar? [(type u8) (pointer-bytes i32)] (-> bool)
  (and (> type 0)
       (ty/valid-scalar? (cast i32 type))
       (> (ty/size (cast i32 type) pointer-bytes) 0)))

;;; Exact width views preserve bits. Partial integer views exclude BOOL and
;;; pointers. Never reinterpret floating point numerically or truncate provenance.
(defn convertible? [(source u8)
                    (target u8)
                    (offset i64)
                    (pointer-bytes i32)] (-> bool)
  (let [wide (ty/size (cast i32 source) pointer-bytes)
        narrow (ty/size (cast i32 target) pointer-bytes)]
    (and (scalar? source pointer-bytes)
         (scalar? target pointer-bytes)
         (>= offset 0)
         (or (= source target) (and (!= source 1) (!= target 1)))
         (<= (+ offset (cast i64 narrow)) (cast i64 wide))
         (or (and (= offset 0) (= wide narrow))
             (and (ty/integer? (cast i32 source))
                  (ty/integer? (cast i32 target))
                  (!= source 1)
                  (!= target 1)
                  (!= source 6)
                  (!= target 6))))))

(defstruct Found [(value i32) (offset i64)])

;;; Pinned CONST/PURE declarations preserve all memory only for scalar calls.
;;; Aggregate capture writes remain visible to the address-specific query.
(defn call-preserves-memory? [(graph g/Graph) (reference i32)] (-> bool)
  (effects/preserves-memory? graph reference))

;;; Conservative proof for an already validated, immutable scalar function.
;;; Unknown operations, allocation scopes, volatile/atomic/register accesses,
;;; stores, aggregate results and unqualified calls reject. No effect fact may
;;; survive graph mutation. Compiler interprocedural propagation is separate.
(defn nonwriting-verified-body? [(graph g/Graph)] (-> bool)
  (match (calls/function-result graph)
    (Err [_] false)
    (Ok [result]
      (if (!= (.kind result) 0) false
          (let [(mut good) true (mut reference) (: 1 i64)]
            (while (and good (< reference (len (.instructions graph))))
              (let [opcode (cast i32 (n/opcode (get (.instructions graph) reference)))
                    count (get (.arities graph) reference)]
                (unless (or (= opcode 0) (and (>= opcode 14) (<= opcode 78))
                            (= opcode 85) (= opcode 91)
                            (and (>= opcode 104) (<= opcode 117))
                            (= opcode 120) (= opcode 121)
                            (and (= opcode 79) (call-preserves-memory? graph (cast i32 reference))))
                  (set! good false))
                (set! reference (+ reference (/ (+ (cast i64 count) 4) 4)))))
            good)))))

;;; Native-target proof for the compiler's immutable definition registry. This
;;; does not claim that a caller aggregate CALL preserves its capture memory.
(defn nonwriting-native-verified-body? [(graph g/Graph) (a (dyn Allocator))] (-> bool)
  (match (calls/function-result graph)
    (Err [_] false)
    (Ok [spec]
          (if (= (.kind spec) 0) (nonwriting-verified-body? graph)
              (effects/register-result-body-readonly? graph a)))))

;;; At most32 control predecessors per query. Single-predecessor branch control,
;;; projections, END and plain BEGIN preserve memory. Joins, loop headers,
;;; annotated BEGIN, unrecognized effects, unqualified calls, volatile/atomic
;;; accesses and register writes are barriers. Scalar declared CONST/PURE calls
;;; preserve all memory; register-result capture is checked against the queried
;;; footprint and indirect results remain barriers. RSTORE stays
;;; conservative relative to upstream.
(defstruct Boundary [(join i32) (steps i32)])

(defn find-linear [(graph g/Graph) (load i32) (pointer-bytes i32)
                   (boundary (mut Boundary)) (owned (mut private/Query))] (-> Found)
  (let [node (get (.instructions graph) (cast i64 load))
        target (n/type-id node)
        target-size (cast i64 (ty/size (cast i32 target) pointer-bytes))
        target-address (alias/decompose graph (.op2 node) pointer-bytes)
        (mut cursor) (.op1 node)
        (mut steps) 0
        (mut found) (Found :value 0 :offset 0)]
    (set! (.join boundary) 0) (set! (.steps boundary) 0)
    (while (and (> cursor 0) (< steps 32) (= (.value found) 0))
      (let [prior (get (.instructions graph) (cast i64 cursor))
            opcode (cast i32 (n/opcode prior))]
        (if (or (= opcode 91) (= opcode 93))
            (let [source (if (= opcode 91) cursor (.op3 prior))
                  value
                    (match (g/lookup graph source)
                      (Some [v] v)
                      (None [] (n/make 0 0 0 0 0 0)))
                  source-type (n/type-id value)
                  source-size
                    (cast i64 (ty/size (cast i32 source-type) pointer-bytes))
                  source-address (alias/decompose graph (.op2 prior) pointer-bytes)
                  same-base (alias/same-origin? target-address source-address)
                  delta (- (.offset target-address) (.offset source-address))]
              (if (and same-base
                       (convertible? source-type target delta pointer-bytes)
                       (!= (n/opcode value) 89))
                  (set! found (Found :value source :offset delta))
                  (when (and (= opcode 93)
                             (not (alias/disjoint? graph target-address source-address
                                                   target-size source-size pointer-bytes))
                             (not (private/store-spares? graph (mut owned) source-address)))
                    (set! cursor 0)))
              (when (> cursor 0) (set! cursor (.op1 prior))))
            (if (or (= opcode 107)
                    (= opcode 108)
                    (= opcode 109)
                    (= opcode 110)
                    (= opcode 111)
                    (= opcode 117)
                    (= opcode 114)
                    (= opcode 116)
                    (and (= opcode 106) (= (.op2 prior) 0))
                    (and (= opcode 79)
                         (or (effects/preserves-address? graph cursor target-address target-size pointer-bytes)
                             (private/call-spares? graph (mut owned) cursor))))
                (set! cursor (.op1 prior))
                (do
                  (when (or (= opcode 112) (= opcode 113))
                    (set! (.join boundary) cursor)
                    (set! (.steps boundary) (cast i32 steps)))
                  (set! cursor 0)))))
      (set! steps (+ steps 1)))
    found))

;;; Public pinned linear query retains its existing result contract.
(defn find [(graph g/Graph) (load i32) (pointer-bytes i32)] (-> Found)
  (let [(mut boundary) (Boundary :join 0 :steps 0)
        (mut owned) (private/none (zeroed uses/Uses))]
    (find-linear graph load pointer-bytes (mut boundary) (mut owned))))

;;; Independent bounded all-path extension of the pinned linear search, for a
;;; LOAD whose linear search stopped at the join BOUNDARY names.
;;; Every backward path must reach the same existing value before a clobber or
;;; entry. Revisited joins share an already queued proof obligation; no path is
;;; assumed safe merely because another predecessor succeeded. On a backedge,
;;; the queried read is skipped as a non-writing event, never used as its own
;;; replacement. Entry paths still need an independent already executed source.
;;; No load is speculated or moved earlier: the answer was read or written on
;;; every path that reaches LOAD, so it dominates LOAD and its location still
;;; holds it there. At most 128 control nodes, 64 path heads and 64 joins and
;;; branches are visited; paths meeting at a visited join or branch share what
;;; lies before it.
(defn find-joined [(graph g/Graph) (load i32) (pointer-bytes i32)
                   (boundary Boundary) (owned (mut private/Query))] (-> Found)
  (let [node (get (.instructions graph) (cast i64 load))
        target (n/type-id node)
        target-size (cast i64 (ty/size (cast i32 target) pointer-bytes))
        target-address (alias/decompose graph (.op2 node) pointer-bytes)
        (mut pending) (zeroed (array i32 64))
        (mut joins) (zeroed (array i32 64))
        (mut queued) (: 1 i64)
        (mut joined) (: 0 i64)
        (mut answer) (Found :value 0 :offset 0)
        (mut good) true (mut head) (: 0 i64) (mut steps) (.steps boundary)]
    (set! (mut pending) 0 (.join boundary))
    (while (and good (< head queued))
      (let [(mut cursor) (get pending head)]
        (set! head (+ head 1))
        (when (<= cursor 0) (set! good false))
        (while (and good (> cursor 0))
          (if (>= steps 128)
              (set! good false)
              (let [prior (get (.instructions graph) (cast i64 cursor))
                    opcode (cast i32 (n/opcode prior))]
                (set! steps (+ steps 1))
                (cond
                  (= cursor load) (set! cursor (.op1 prior))
                  (or (= opcode 91) (= opcode 93))
                    (let [source (if (= opcode 91) cursor (.op3 prior))
                          value (match (g/lookup graph source)
                                  (Some [v] v) (None [] (n/make 0 0 0 0 0 0)))
                          source-type (n/type-id value)
                          source-size (cast i64 (ty/size (cast i32 source-type) pointer-bytes))
                          source-address (alias/decompose graph (.op2 prior) pointer-bytes)
                          delta (- (.offset target-address) (.offset source-address))]
                      (if (and (alias/same-origin? target-address source-address)
                               (convertible? source-type target delta pointer-bytes)
                               (!= (n/opcode value) 89))
                          (do
                            (if (= (.value answer) 0)
                                (set! answer (Found :value source :offset delta))
                                (unless (and (= (.value answer) source) (= (.offset answer) delta))
                                  (set! good false)))
                            (set! cursor 0))
                          (if (and (= opcode 93)
                                   (not (alias/disjoint? graph target-address source-address
                                                        target-size source-size pointer-bytes))
                                   (not (private/store-spares? graph (mut owned) source-address)))
                              (set! good false)
                              (set! cursor (.op1 prior)))))
                  (or (= opcode 112) (= opcode 113))
                    (let [(mut seen) false
                          count (cast i64 (get (.arities graph) (cast i64 cursor)))]
                      (for [i 0 joined] (when (= (get joins i) cursor) (set! seen true)))
                      (unless seen
                        (if (or (<= count 0) (>= joined 64) (> (+ queued count) 64))
                            (set! good false)
                            (do
                              (set! (mut joins) joined cursor)
                              (set! joined (+ joined 1))
                              (for [k 1 (+ count 1)]
                                (match (g/operand graph cursor (cast i32 k))
                                  (None [] (set! good false))
                                  (Some [predecessor]
                                    (if (<= predecessor 0) (set! good false)
                                        (do (set! (mut pending) queued predecessor)
                                            (set! queued (+ queued 1))))))))))
                      (set! cursor 0))
                  ; Paths that split at one branch share everything before
                  ; it: the first to arrive carries the obligation.
                  (or (= opcode 116) (= opcode 117))
                    (let [(mut seen) false]
                      (for [i 0 joined] (when (= (get joins i) cursor) (set! seen true)))
                      (cond seen (set! cursor 0)
                            (>= joined 64) (set! good false)
                            :else (do (set! (mut joins) joined cursor)
                                      (set! joined (+ joined 1))
                                      (set! cursor (.op1 prior)))))
                  (or (= opcode 107) (= opcode 108) (= opcode 109)
                      (= opcode 110) (= opcode 111)
                      (= opcode 114) (= opcode 115)
                      (and (= opcode 106) (= (.op2 prior) 0))
                      (and (= opcode 79)
                           (or (effects/preserves-address? graph cursor target-address target-size pointer-bytes)
                               (private/call-spares? graph (mut owned) cursor))))
                    (set! cursor (.op1 prior))
                  :else (set! good false)))))))
    (if (and good (!= (.value answer) load)) answer (Found :value 0 :offset 0))))

;;; Opcode-only preview of the linear search: could it stop at a join? True
;;; for some loads whose search stops earlier, never false for one that
;;; reaches a join.
(defn under-join? [(graph g/Graph) (load i32)] (-> bool)
  (let [(mut cursor) (.op1 (get (.instructions graph) (cast i64 load)))
        (mut steps) 0
        (mut answer) false]
    (while (and (> cursor 0) (< steps 32))
      (let [prior (get (.instructions graph) (cast i64 cursor))
            opcode (cast i32 (n/opcode prior))]
        (cond (or (= opcode 112) (= opcode 113))
                (do (set! answer true) (set! cursor 0))
              (or (= opcode 91) (= opcode 93) (= opcode 79) (= opcode 106)
                  (and (>= opcode 107) (<= opcode 111))
                  (and (>= opcode 114) (<= opcode 117)))
                (set! cursor (.op1 prior))
              :else (set! cursor 0)))
      (set! steps (+ steps 1)))
    answer))

;;; The linear search, then the all-path proof when it stopped at a join.
(defn find-across [(graph g/Graph) (edges uses/Uses) (load i32) (pointer-bytes i32)] (-> Found)
  (let [(mut boundary) (Boundary :join 0 :steps 0)
        node (get (.instructions graph) (cast i64 load))
        (mut owned) (private/query edges (alias/decompose graph (.op2 node) pointer-bytes)
                                   (cast i64 (ty/size (cast i32 (n/type-id node)) pointer-bytes)))
        found (find-linear graph load pointer-bytes (mut boundary) (mut owned))]
    (if (and (= (.value found) 0) (> (.join boundary) 0))
        (find-joined graph load pointer-bytes boundary (mut owned))
        found)))

;;; Dead-store marking follows ir.c:ir_find_aliasing_store, extended from equal
;;; addresses to covered byte ranges. Walking up from STORE, an earlier STORE in
;;; the same straight-line control chain whose bytes STORE rewrites completely is
;;; never read: CONTROL then bypasses it and it is appended to DEAD. Any other
;;; STORE is passed (a store reads nothing). A LOAD is passed only when it is
;;; provably disjoint from the rewritten bytes. A plain BEGIN and its END are
;;; crossed (one predecessor, one successor). Every other control operation,
;;; including calls, branches, joins, volatile and atomic accesses, stops the
;;; walk, so no path can observe the removed write. Roots are never removed.
(defn mark-dead-stores! [(graph g/Graph) (store i32) (pointer-bytes i32)
                         (roots (ArrayList i32))
                         (control (mut (ArrayList i32)))
                         (dead (mut (ArrayList i32)))] (-> i32)
  (let [node (get (.instructions graph) (cast i64 store))
        size (match (g/lookup graph (.op3 node))
               (Some [v] (cast i64 (ty/size (cast i32 (n/type-id v)) pointer-bytes)))
               (None [] 0))
        address (alias/decompose graph (.op2 node) pointer-bytes)
        (mut cursor) (.op1 node)
        (mut steps) 0
        (mut marked) (: 0 i32)]
    (while (and (> cursor 0) (> size 0) (< steps 32))
      (let [prior (get (.instructions graph) (cast i64 cursor))
            opcode (cast i32 (n/opcode prior))]
        (cond
          (= opcode 93)
            (let [prior-size (match (g/lookup graph (.op3 prior))
                               (Some [v] (cast i64 (ty/size (cast i32 (n/type-id v)) pointer-bytes)))
                               (None [] 0))
                  prior-address (alias/decompose graph (.op2 prior) pointer-bytes)
                  (mut rooted) false]
              (when (and (> prior-size 0)
                         (= (get control (cast i64 cursor)) 0)
                         (alias/same-origin? address prior-address)
                         (<= (.offset address) (.offset prior-address))
                         (<= (+ (.offset prior-address) prior-size)
                             (+ (.offset address) size)))
                (for root roots (when (= root cursor) (set! rooted true)))
                (unless rooted
                  (set! (mut control) (cast i64 cursor) (.op1 prior))
                  (push! (mut dead) cursor)
                  (set! marked (+ marked 1))))
              (set! cursor (.op1 prior)))
          (= opcode 91)
            (let [width (cast i64 (ty/size (cast i32 (n/type-id prior)) pointer-bytes))]
              (if (and (> width 0)
                       (alias/disjoint? graph address
                                        (alias/decompose graph (.op2 prior) pointer-bytes)
                                        size width pointer-bytes))
                  (set! cursor (.op1 prior))
                  (set! cursor 0)))
          ; A plain BEGIN has exactly one predecessor END, and that END has no
          ; other successor: the chain stays straight-line across the pair.
          (and (= opcode 106) (= (.op2 prior) 0) (> (.op1 prior) 0)
               (= (n/opcode (get (.instructions graph) (cast i64 (.op1 prior)))) 114))
            (set! cursor (.op1 (get (.instructions graph) (cast i64 (.op1 prior)))))
          :else (set! cursor 0)))
      (set! steps (+ steps 1)))
    marked))

(defn append! [(graph (mut g/Graph))
               (opcode u8)
               (type u8)
               (left i32)
               (right i32)] (-> i32)
  (match (if (= right 0)
             (g/append-inputs! (mut graph) opcode type [left])
             (g/append-inputs! (mut graph) opcode type [left right]))
    (Some [r] r)
    (None [] (panic "load forwarding reference exhaustion"))))

;;; Apply proven forwarding maps together, preserving value and control roots.
;;; DATA/CONTROL are indexed by the original graph's cells; conversions may
;;; already have been appended. Neither map may contain a replacement cycle.
(defn apply-maps! [(graph (mut g/Graph)) (roots (mut (ArrayList i32)))
                   (data (ArrayList i32)) (control (ArrayList i32))] (-> void)
  (let [size (len data) (mut r) (: 1 i64)]
    (unless (= size (len control)) (panic "forwarding map sizes differ"))
    (while (< r (len (.instructions graph)))
      (let [node (get (.instructions graph) r)
            count (get (.arities graph) r)]
        (for [i 1 (+ (cast i64 count) 1)]
          (let [kind
                  (op/operand-code (cast i32 (n/opcode node)) (cast i32 i))]
            (when (uses/edge-code? kind)
              (match (g/operand graph (cast i32 r) (cast i32 i))
                (Some [old]
                      (let [new
                              (mem/resolve (if (= kind op/OPERAND-SRC)
                                               control
                                               data)
                                           old)]
                        (when (!= old new)
                          (g/set-operand! (mut graph)
                                          (cast i32 r)
                                          (cast i32 i)
                                          new))))
                (None [] 0)))))
        (when (and (< r size) (!= (get data r) 0))
          (g/rewrite-inputs! (mut graph)
                             (cast i32 r)
                             68
                             (n/type-id node)
                             [(mem/resolve data (get data r)) (: 0 i32)]))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    ; Preserve both observations when a root defines a value and control.
    ; COPY retains its value identity; an added control root retains effects
    ; that were reachable only through the original LOAD's predecessor.
    (let [count (len roots)]
      (for [i 0 count]
        (let [root (get roots i)]
          (when (and (> root 0)
                     (< (cast i64 root) size)
                     (!= (get data (cast i64 root)) 0)
                     (!= (get control (cast i64 root)) 0))
            (push! (mut roots) (mem/resolve control root))))))))

;;; Explicit endian argument guards the independent contained-offset extension.
;;; Same-address partial forwarding also requires little endian. Big-endian
;;; callers retain memory until their extraction convention is implemented.
(defn run! [(graph (mut g/Graph))
            (roots (mut (ArrayList i32)))
            (pointer-bytes i32)
            (little-endian bool)
            (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (if (not little-endian)
      (Ok 0)
      (let [size (len (.instructions graph))
            (mut data) (mem/zeros size a)
            (mut control) (mem/zeros size a)
            (mut changes) (: 0 i32)
            (mut r) 1]
        (while (< r size)
          (let [node (get (.instructions graph) r)
                count (get (.arities graph) r)]
            (when (and (= (n/opcode node) 91)
                       (scalar? (n/type-id node) pointer-bytes))
              (let [found (find graph (cast i32 r) pointer-bytes)]
                (when (!= (.value found) 0)
                  (let [(mut value) (mem/resolve data (.value found))
                        source
                          (match (g/lookup graph value)
                            (Some [v] v)
                            (None [] (panic "forwarded value missing")))
                        source-type (n/type-id source)
                        target (n/type-id node)]
                    (when (> (.offset found) 0)
                      (let [shift
                              (match (g/intern-constant! (mut graph)
                                                         source-type
                                                         source-type
                                                         0
                                                         (cast u64
                                                               (* (.offset found)
                                                                  8)))
                                (Some [v] v)
                                (None []
                                      (panic "forward shift constant failed")))]
                        (set! value
                              (append! (mut graph) 50 source-type value shift))))
                    (when (!= source-type target)
                      (set! value
                            (append! (mut graph)
                                     (if (= (ty/size (cast i32 source-type)
                                                     pointer-bytes)
                                            (ty/size (cast i32 target)
                                                     pointer-bytes))
                                         36
                                         35)
                                     target
                                     value
                                     0)))
                    (set! (mut data) r value)
                    (set! (mut control) r (.op1 node))
                    (set! changes (+ changes 1))))))
            (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
        (apply-maps! (mut graph) (mut roots) data control)
        (free! (mut data))
        (free! (mut control))
        (Ok changes))))
;;; Remove stores that a later store in the same straight-line chain rewrites
;;; completely (mark-dead-stores!). Run after promotion and forwarding have
;;; removed the reads between them. Returns the number of stores removed; the
;;; graph is untouched when there are none.
(defn dead-stores! [(graph (mut g/Graph))
                    (roots (mut (ArrayList i32)))
                    (pointer-bytes i32)
                    (a (dyn Allocator))] (-> i32)
  (let [size (len (.instructions graph))
        (mut control) (ArrayList::new [i32] a)
        (mut dead) (ArrayList::new [i32] a)
        (mut removed) (: 0 i32)
        (mut r) 1]
    (while (< r size)
      (when (= (n/opcode (get (.instructions graph) r)) 93)
        (let [prior (.op1 (get (.instructions graph) r))]
          ; Only a store directly after another access can cover anything.
          (when (and (> prior 0)
                     (let [code (n/opcode (get (.instructions graph) (cast i64 prior)))]
                       (or (= code 93) (= code 91) (= code 106))))
            (when (= (len control) 0) (fill/append! (mut control) size 0))
            (set! removed (+ removed (mark-dead-stores! graph (cast i32 r) pointer-bytes
                                                        (load roots) (mut control) (mut dead)))))))
      (set! r (+ r (/ (+ (cast i64 (get (.arities graph) r)) 4) 4))))
    (when (> removed 0)
      (let [(mut data) (mem/zeros size a)]
        (apply-maps! (mut graph) (mut roots) data control)
        (free! (mut data)))
      (for store dead
        (unless (g/make-nop! (mut graph) store) (panic "dead store removal failed"))))
    (free! (mut control))
    (free! (mut dead))
    removed))
