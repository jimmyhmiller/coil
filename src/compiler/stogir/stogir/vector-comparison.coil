;;; Vector predicates return integer masks with the same lane geometry as inputs.
(module stogir.vector-comparison)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "coil.result" :use [Result Ok Err Some None])

(defn operation? [(opcode i32)] (-> bool)
  (and (>= opcode 14) (<= opcode 25)))

(defn valid-type? [(opcode i32) (ty i32)] (-> bool)
  (and (operation? opcode)
       (types/vector? ty)
       (or (types/floating? (types/base-type ty))
           (and (types/integer? (types/base-type ty)) (<= opcode 23)))))

;;; Canonical unsigned mask type; raw IR may also use matching signed/address masks.
(defn mask-type [(ty i32) (pointer-bytes i32)] (-> i32)
  (if (or (not (types/vector? ty))
          (not (or (= pointer-bytes 4) (= pointer-bytes 8))))
      0
      (let [size (types/scalar-size (types/base-type ty) pointer-bytes)]
        (types/vector-type (if (= size 1)
                               2
                               (if (= size 2) 3 (if (= size 4) 4 5)))
                           (types/lanes ty)))))

(defn node? [(graph g/Graph) (reference i32)] (-> bool)
  (match (g/lookup graph reference)
    (None [] false)
    (Some [node]
          (and (operation? (cast i32 (n/opcode node)))
               (types/vector? (cast i32 (n/type-id node)))))))

;;; Returns the operand type, which may differ from the result mask type.
(defn operands [(graph g/Graph)
                (opcode i32)
                (result-type i32)
                (pointer-bytes i32)
                (left i32)
                (right i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph left)
    (None [] (Err "vector comparison operand missing"))
    (Some [a]
          (match (g/lookup graph right)
            (None [] (Err "vector comparison operand missing"))
            (Some [b]
                  (let [ty (cast i32 (n/type-id a))]
                    (if (or (not (or (= pointer-bytes 4) (= pointer-bytes 8)))
                            (not (valid-type? opcode ty))
                            (!= (n/type-id a) (n/type-id b))
                            (= (n/opcode a) 72)
                            (= (n/opcode a) 70)
                            (= (n/opcode b) 72)
                            (= (n/opcode b) 70)
                            (not (types/vector? result-type))
                            (not (types/integer? (types/base-type result-type)))
                            (!= (types/lanes result-type) (types/lanes ty))
                            (!= (types/scalar-size (types/base-type result-type)
                                                   pointer-bytes)
                                (types/scalar-size (types/base-type ty)
                                                   pointer-bytes)))
                        (Err "vector comparison operand or mask geometry mismatch")
                        (Ok ty))))))))

(defn validate [(graph g/Graph) (reference i32) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "vector comparison instruction missing"))
    (Some [node]
          (if (or (<= reference 0)
                  (not (node? graph reference))
                  (!= (get (.arities graph) (cast i64 reference)) 2))
              (Err "invalid vector comparison instruction shape")
              (operands graph
                        (cast i32 (n/opcode node))
                        (cast i32 (n/type-id node))
                        pointer-bytes
                        (.op1 node)
                        (.op2 node))))))
