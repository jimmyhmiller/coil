;;; Immutable physical reservations, indexed by register/start and maximum end.
;;; Query facts complement pinned ir_ra.c's active/inactive interval policy.
(module stogir.reserved-ranges)
(import "stogir.fixed-uses" :as f)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(defstruct Reservation [(start i64) (end i64) (register i32) (owner i32)])

(defstruct Index
  [(events (ArrayList f/Event))
   (ends (ArrayList i64))
   (starts (ArrayList i64))
   (maximum (ArrayList i64))
   (base i64)
   ; Per register: its events are pairwise disjoint (so ends rise with starts),
   ; and the first event that may still meet a range at or after the position
   ; last passed to advance!.
   (disjoint (ArrayList bool))
   (cursor (ArrayList i64))])

(defn empty [(a (dyn Allocator))] (-> Index)
  (Index
    :events (ArrayList::new [f/Event] a)
    :ends (ArrayList::new [i64] a)
    :starts (ArrayList::new [i64] a)
    :maximum (ArrayList::new [i64] a)
    :base 1
    :disjoint (ArrayList::new [bool] a)
    :cursor (ArrayList::new [i64] a)))

(defn release! [(index (mut Index))] (-> void)
  (free! (mut (.events index)))
  (free! (mut (.ends index)))
  (free! (mut (.starts index)))
  (free! (mut (.maximum index)))
  (free! (mut (.disjoint index)))
  (free! (mut (.cursor index))))

;;; Each immutable part contributes exactly one range. Other parts remain in the
;;; general live collection rather than being approximated by this index.
(defn create [(parts i64)
              (registers i32)
              (input (slice Reservation))
              (a (dyn Allocator))] (-> (Result Index (slice u8)))
  (let [(mut index) (empty a)
        (mut error) ""]
    (when (or (< parts 0)
              (> parts 2147483647)
              (<= registers 0)
              (> registers 64))
      (set! error "invalid reservation index domain"))
    (for item input
      (when (or (< (.start item) 0)
                (<= (.end item) (.start item))
                (< (.register item) 0)
                (>= (.register item) registers)
                (< (.owner item) 0)
                (>= (cast i64 (.owner item)) parts))
        (set! error "invalid physical reservation")))
    (when (= error "")
      (reserve! (mut (.events index)) (len input))
      (reserve! (mut (.ends index)) parts)
      (reserve! (mut (.starts index)) (+ (cast i64 registers) 1))
      (for [i 0 parts] (push! (mut (.ends index)) -1))
      (for item input
        (if (>= (get (.ends index) (cast i64 (.owner item))) 0)
            (set! error "duplicate immutable reservation owner")
            (do
              (set! (mut (.ends index)) (cast i64 (.owner item)) (.end item))
              (push! (mut (.events index))
                     (f/Event
                       :position (.start item)
                       :register (.register item)
                       :owner (.owner item))))))
      (f/sort! (mut (.events index)) a)
      (let [(mut cursor) 0]
        (for [reg 0 (+ (cast i64 registers) 1)]
          (while (and (< cursor (len (.events index)))
                      (< (cast i64 (.register (at (.events index) cursor))) reg))
            (set! cursor (+ cursor 1)))
          (push! (mut (.starts index)) cursor)))
      (for [reg 0 (cast i64 registers)]
        (let [first (get (.starts index) reg)
              stop (get (.starts index) (+ reg 1))
              (mut separate) true]
          (for [k (+ first 1) stop]
            (when (< (.position (at (.events index) k))
                     (get (.ends index) (cast i64 (.owner (at (.events index) (- k 1))))))
              (set! separate false)))
          (push! (mut (.disjoint index)) separate)
          (push! (mut (.cursor index)) first)))
      (while (< (.base index) (len input))
        (set! (.base index) (* (.base index) 2)))
      (reserve! (mut (.maximum index)) (* (.base index) 2))
      (for [i 0 (* (.base index) 2)] (push! (mut (.maximum index)) -1))
      (for [i 0 (len (.events index))]
        (set! (mut (.maximum index))
              (+ (.base index) i)
              (get (.ends index) (cast i64 (.owner (at (.events index) i))))))
      (let [(mut i) (- (.base index) 1)]
        (while (> i 0)
          (let [left (get (.maximum index) (* i 2))
                right (get (.maximum index) (+ (* i 2) 1))]
            (set! (mut (.maximum index)) i (if (> left right) left right)))
          (set! i (- i 1)))))
    (if (= error "")
        (Ok index)
        (do (release! (mut index)) (Err error)))))

(defn lower-bound [(index Index) (lo i64) (hi i64) (position i64)] (-> i64)
  (let [(mut first) lo
        (mut last) hi]
    (while (< first last)
      (let [mid (+ first (/ (- last first) 2))]
        (if (< (.position (at (.events index) mid)) position)
            (set! first (+ mid 1))
            (set! last mid))))
    first))

;;; Find the first leaf in [lo,hi) with end>threshold. Standard segment-tree
;;; first-above traversal visits logarithmically many nodes without recursion,
;;; a per-query stack or a scan behind one long incoming reservation.
(defn first-above [(index Index) (lo i64) (hi i64) (threshold i64)] (-> i64)
  (if (or (< lo 0) (>= lo hi) (> hi (len (.events index))))
      -1
      (let [(mut node) (+ lo (.base index))
            (mut done) false
            (mut answer) (: -1 i64)]
        (while (not done)
          (while (= (% node 2) 0) (set! node (/ node 2)))
          (if (> (get (.maximum index) node) threshold)
              (do
                (while (< node (.base index))
                  (set! node (* node 2))
                  (when (<= (get (.maximum index) node) threshold)
                    (set! node (+ node 1))))
                (when (< (- node (.base index)) hi)
                  (set! answer (- node (.base index))))
                (set! done true))
              (do
                (set! node (+ node 1))
                (when (= (& node (- node 1)) 0) (set! done true)))))
        answer)))

;;; Whether this immutable register bucket contains events. Deactivation and
;;; ownership changes do not remove events, so true does not imply a live hit.
(defn has-register? [(index Index) (register i32)] (-> bool)
  (and (>= register 0)
       (< (+ (cast i64 register) 1) (len (.starts index)))
       (< (get (.starts index) (cast i64 register))
          (get (.starts index) (+ (cast i64 register) 1)))))

;;; Lowest start>=minimum among reservations intersecting [begin,end). Exact
;;; self exclusion also supports oracle queries on the reservations themselves.
(defn first [(index Index)
             (register i32)
             (minimum i64)
             (begin i64)
             (end i64)
             (exclude i32)] (-> i64)
  (if (or (< register 0)
          (>= (+ (cast i64 register) 1) (len (.starts index)))
          (< begin 0)
          (<= end begin))
      -1
      (let [start (get (.starts index) (cast i64 register))
            stop (get (.starts index) (+ (cast i64 register) 1))
            (mut lo) (lower-bound index start stop minimum)
            hi (lower-bound index start stop end)
            (mut answer) (first-above index lo hi begin)]
        (while (and (>= answer 0)
                    (= (.owner (at (.events index) answer)) exclude))
          (set! lo (+ answer 1))
          (set! answer (first-above index lo hi begin)))
        answer)))

;;; Positions passed here never decrease. In a disjoint register, an event that
;;; ends at or before position meets no range starting at or after it.
(defn advance! [(index (mut Index)) (position i64)] (-> void)
  (for [reg 0 (len (.disjoint index))]
    (when (get (.disjoint index) reg)
      (let [stop (get (.starts index) (+ reg 1))
            (mut k) (get (.cursor index) reg)]
        (while (and (< k stop)
                    (<= (get (.ends index) (cast i64 (.owner (at (.events index) k)))) position))
          (set! k (+ k 1)))
        (set! (mut (.cursor index)) reg k)))))

;;; first, for a begin at or after the last advance! position. In a disjoint
;;; register, ends rise with starts: the answer is the first event at or after
;;; both the first one ending after begin and the first starting at minimum,
;;; skipping the excluded owner, provided it starts before end.
(defn first-advanced [(index Index)
                      (register i32)
                      (minimum i64)
                      (begin i64)
                      (end i64)
                      (exclude i32)] (-> i64)
  (if (or (< register 0)
          (>= (+ (cast i64 register) 1) (len (.starts index)))
          (not (get (.disjoint index) (cast i64 register)))
          (< begin 0)
          (<= end begin))
      (first index register minimum begin end exclude)
      (let [stop (get (.starts index) (+ (cast i64 register) 1))
            (mut low) (get (.cursor index) (cast i64 register))
            (mut high) stop]
        (while (< low high)
          (let [middle (+ low (/ (- high low) 2))]
            (if (<= (get (.ends index) (cast i64 (.owner (at (.events index) middle)))) begin)
                (set! low (+ middle 1))
                (set! high middle))))
        (while (and (< low stop) (< (.position (at (.events index) low)) minimum))
          (set! low (+ low 1)))
        (while (and (< low stop) (= (.owner (at (.events index) low)) exclude))
          (set! low (+ low 1)))
        (if (and (< low stop) (< (.position (at (.events index) low)) end)) low -1))))
