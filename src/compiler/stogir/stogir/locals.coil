; Local-variable shapes follow dstogov/ir ir.h and ir_ra.c, 92171d0. See NOTICE.
(module stogir.locals)

(export Shape operation? shape validate)

(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.strings" :as strings)
(import "stogir.frame" :as frame)
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Shape [(size i64) (alignment i64)])

(defn operation? [(opcode i32)] (-> bool)
  (or (= opcode 65) (= opcode 72) (and (>= opcode 85) (<= opcode 88))))

;;; VAR is storage, not a register value. Alignment zero means natural type
;;; alignment; a target must separately establish any requested over-alignment.
(defn shape [(graph g/Graph) (reference i32) (pointer-bytes i32)]
  (-> (Result Shape (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "local variable missing"))
    (Some [node]
          (let [size (types/size (cast i32 (n/type-id node)) pointer-bytes)
                alignment
                  (if (= (.op3 node) 0) (cast i64 size) (cast i64 (.op3 node)))
                (mut valid-name?) (= (.op2 node) 0)]
            (when (> (.op2 node) 0)
              (match (strings/lookup (.strings graph) (.op2 node))
                (None [] 0)
                (Some [_] (set! valid-name? true))))
            (if (or (<= reference 0)
                    (!= (n/opcode node) 72)
                    (!= (get (.arities graph) (cast i64 reference)) 3)
                    (<= size 0)
                    (not valid-name?)
                    (not (frame/valid-alignment? alignment)))
                (Err "invalid local variable shape")
                (match (g/lookup graph (.op1 node))
                  (None [] (Err "local variable region missing"))
                  (Some [region]
                        (if (or (<= (.op1 node) 0)
                                (not (op/block-start? (cast i32
                                                            (n/opcode region)))))
                            (Err "local variable requires a block-start region")
                            (Ok (Shape
                                  :size (cast i64 size)
                                  :alignment alignment))))))))))

;;; A narrower or differently typed access may view the same storage,
;;; but must fit its extent. Volatile variants retain the same type rules.
(defn validate [(graph g/Graph) (reference i32) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "local operation missing"))
    (Some [node]
          (let [opcode (cast i32 (n/opcode node))
                load? (or (= opcode 85) (= opcode 86))
                store? (or (= opcode 87) (= opcode 88))
                expected (if (= opcode 65) (: 1 i32) (if load? 2 3))]
            (if (or (<= reference 0)
                    (not (operation? opcode))
                    (!= (get (.arities graph) (cast i64 reference)) expected))
                (Err "invalid local operation")
                (match (shape graph
                              (if (or (= opcode 65) (= opcode 72))
                                  (if (= opcode 72) reference (.op1 node))
                                  (.op2 node))
                              pointer-bytes)
                  (Err [message] (Err message))
                  (Ok [storage]
                      (if (= opcode 72)
                          (Ok (cast i32 (.size storage)))
                          (if (= opcode 65)
                              (if (= (n/type-id node) 6)
                                  (Ok pointer-bytes)
                                  (Err "local address must have ADDR type"))
                              (match (g/lookup graph (.op1 node))
                                (None [] (Err "local access control missing"))
                                (Some [control]
                                      (if (or (<= (.op1 node) 0)
                                              (not (op/control? (cast i32
                                                                      (n/opcode control))))
                                              (op/block-end? (cast i32
                                                                   (n/opcode control))))
                                          (Err "invalid local access control")
                                          (match (if store?
                                                     (g/lookup graph
                                                               (.op3 node))
                                                     (Some node))
                                            (None []
                                                  (Err "local store value missing"))
                                            (Some [input]
                                                  (let [width
                                                          (types/size (cast i32
                                                                            (n/type-id input))
                                                                      pointer-bytes)]
                                                    (if (or (<= width 0)
                                                            (> (cast i64 width)
                                                               (.size storage))
                                                            (and store?
                                                                 (!= (n/type-id node)
                                                                     0))
                                                            (= (n/opcode input)
                                                               72))
                                                        (Err "invalid local access type or extent")
                                                        (Ok width)))))))))))))))))
