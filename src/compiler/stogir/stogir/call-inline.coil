;;; Bounded direct graph-call expansion. This is an independent module-level
;;; extension; upstream's compact graph, typed prototypes and control chains stay
;;; the semantic representation. See NOTICE and docs/PROVENANCE.md.
(module stogir.call-inline)

(export Callee Site optimize optimize-sites)

(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.strings" :as strings)
(import "stogir.symbols" :as symbols)
(import "stogir.call-results" :as results)
(import "stogir.uses" :as uses)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.bitqueue" :as q)
(import "stogir.liveness" :as live)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

;;; Borrowed immutable function definition; the provider owns its name/graph/roots
;;; until optimization returns. Never is explicit and always takes precedence.
(defstruct Callee
  [(name (slice u8))
   (graph g/Graph)
   (entry i32)
   (roots (slice i32))
   (never bool)])

(defn scalar? [(type u8)] (-> bool)
  (and (> type 0) (types/valid-scalar? (cast i32 type))))

;;; No frame-dependent operations, nested calls, loops or division guards in
;;; this bounded acyclic component. Scalar argument groups retain their exact
;;; prototype; aggregate results and variadic calls stay intact.
(defn pure? [(opcode i32)] (-> bool)
  (and (>= opcode 14)
       (<= opcode 68)
       (!= opcode 29)
       (!= opcode 30)
       (!= opcode 40)
       (!= opcode 65)
       (!= opcode 66)))

(defn signed-pair? [(left u8) (right u8)] (-> bool)
  (or (and (>= left 2) (<= left 5) (= (cast i32 right) (+ (cast i32 left) 6)))
      (and (>= right 2) (<= right 5) (= (cast i32 left) (+ (cast i32 right) 6)))))

;;; Exact flags, result, arity and ABI group trailer. Ordinary integer parameter
;;; signedness may differ at the same width; mapping inserts an explicit BITCAST.
;;; Bool/char, pointer, floating and width changes are deliberately excluded.
(defn compatible? [(call (slice u8)) (definition (slice u8))] (-> bool)
  (let [(mut good) (and (>= (len call) 3) (= (len call) (len definition)))]
    (when good
      (let [end (+ 3 (cast i64 (get definition 2)))]
        (for [i 0 (len call)]
          (let [left (get call i)
                right (get definition i)]
            (when (and (!= left right)
                       (not (and (>= i 3) (< i end) (signed-pair? left right))))
              (set! good false))))))
    good))

(defn closed-acyclic? [(graph g/Graph) (roots (slice i32)) (a (dyn Allocator))]
  (-> bool)
  (let [(mut ready) (zeros (len (.instructions graph)) a)
        (mut marked) (live/mark graph roots a)
        (mut good) true
        (mut changed) true
        (mut pending) true]
    ; Bounded topological elimination includes data and control references. A
    ; remaining cycle cannot be expanded by this acyclic component.
    (while (and changed pending)
      (set! changed false)
      (set! pending false)
      (let [(mut r) 1]
        (while (< r (len (.instructions graph)))
          (let [node (get (.instructions graph) r)
                opcode (n/opcode node)
                count (get (.arities graph) r)]
            (when (= (get ready r) 0)
              (let [(mut available) true]
                (for [i 1 (+ (cast i64 count) 1)]
                  (when (uses/edge-code? (op/operand-code (cast i32 opcode)
                                                          (cast i32 i)))
                    (match (g/operand graph (cast i32 r) (cast i32 i))
                      (None [] (set! available false))
                      (Some [input]
                            (when (and (> input 0)
                                       (= (get ready (cast i64 input)) 0))
                              (set! available false))))))
                (if available
                    (do (set! (mut ready) r 1) (set! changed true))
                    (set! pending true))))
            (when (and (op/control? (cast i32 opcode)) (not (get marked r)))
              (set! good false))
            (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))))
    (free! (mut ready))
    (free! (mut marked))
    (and good (not pending))))

(defn eligible? [(caller g/Graph)
                 (reference i32)
                 (target Callee)
                 (budget i32)
                 (a (dyn Allocator))]
  (-> bool)
  (let [callee (.graph target)
        call (get (.instructions caller) (cast i64 reference))
        size (len (.instructions callee))
        (mut good)
          (and (!= (.op1 call) reference)
               (not (.never target))
               (> budget 0)
               (<= size (+ (cast i64 budget) 1))
               (> (.entry target) 0)
               (= (len (.roots target)) 1)
               (> (.function-prototype callee) 0))]
    (when good
      (let [entry (.entry target)
            ret (get (.roots target) 0)]
        (if (or (not (g/contains? callee entry)) (not (g/contains? callee ret)))
            (set! good false)
            (let [start (get (.instructions callee) (cast i64 entry))
                  returned (get (.instructions callee) (cast i64 ret))]
              (when (or (!= (n/opcode start) 104)
                        (!= (.op1 start) 0)
                        (!= (n/opcode returned) 120)
                        (!= (.op3 returned) 0))
                (set! good false))
              (match (g/lookup caller (.op2 call))
                (None [] (set! good false))
                (Some [function]
                      (if (or (!= (n/opcode function) 74)
                              (= (n/auxiliary function) 0))
                          (set! good false)
                          (match (strings/lookup (.strings caller)
                                                 (cast i32
                                                       (n/constant-bits function)))
                            (None [] (set! good false))
                            (Some [name]
                                  (when (!= name (.name target))
                                    (set! good false))
                                  (match (strings/lookup (.strings caller)
                                                         (cast i32
                                                               (n/auxiliary function)))
                                    (None [] (set! good false))
                                    (Some [signature]
                                          (match (strings/lookup (.strings callee)
                                                                 (.function-prototype callee))
                                            (None [] (set! good false))
                                            (Some [definition]
                                                  (if (or (not (compatible? signature
                                                                            definition))
                                                          (< (len definition) 3))
                                                      (set! good false)
                                                      (let [parameters
                                                              (cast i32
                                                                    (get definition
                                                                         2))
                                                            result
                                                              (get definition 1)
                                                            (mut conversions)
                                                              (: 0 i64)
                                                            (mut effects) 0
                                                            (mut r) 1]
                                                        (when (or (!= (& (get definition
                                                                              0)
                                                                         16)
                                                                      0)
                                                                  (!= (.kind (results/decode definition))
                                                                      0)
                                                                  (!= (get (.arities caller)
                                                                           (cast i64
                                                                                 reference))
                                                                      (+ parameters
                                                                         2))
                                                                  (!= result
                                                                      (n/type-id call))
                                                                  (!= result
                                                                      (n/type-id returned))
                                                                  (and (!= result
                                                                           0)
                                                                       (not (scalar? result)))
                                                                  (and (= result
                                                                          0)
                                                                       (!= (.op2 returned)
                                                                           0)))
                                                          (set! good false))
                                                        (for [i
                                                              0
                                                              (cast i64
                                                                    parameters)]
                                                          (when (not (scalar? (get definition
                                                                                   (+ i
                                                                                      3))))
                                                            (set! good false))
                                                          (match (g/operand caller
                                                                            reference
                                                                            (cast i32
                                                                                  (+ i
                                                                                     3)))
                                                            (Some [argument]
                                                                  (when (= argument
                                                                           reference)
                                                                    (set! good
                                                                          false)))
                                                            (None []
                                                                  (set! good
                                                                        false))))
                                                        (when (!= result 0)
                                                          (match (g/lookup callee
                                                                           (.op2 returned))
                                                            (Some [value]
                                                                  (when (!= (n/type-id value)
                                                                            result)
                                                                    (set! good
                                                                          false)))
                                                            (None []
                                                                  (set! good
                                                                        false))))
                                                        (while (and good
                                                                    (< r size))
                                                          (let [node
                                                                  (get (.instructions callee)
                                                                       r)
                                                                opcode
                                                                  (cast i32
                                                                        (n/opcode node))
                                                                count
                                                                  (get (.arities callee)
                                                                       r)]
                                                            (when (and (= opcode
                                                                          71)
                                                                       (>= (.op3 node)
                                                                           0)
                                                                       (< (.op3 node)
                                                                          parameters))
                                                              (when (!= (get signature
                                                                             (+ 3
                                                                                (cast i64
                                                                                      (.op3 node))))
                                                                        (n/type-id node))
                                                                (set! conversions
                                                                      (+ conversions
                                                                         1))))
                                                            (cond (= opcode 0) 0
                                                                  (= opcode 104)
                                                                    (when (!= r
                                                                              (cast i64
                                                                                    entry))
                                                                      (set! good
                                                                            false))
                                                                  (= opcode 120)
                                                                    (when (!= r
                                                                              (cast i64
                                                                                    ret))
                                                                      (set! good
                                                                            false))
                                                                  (= opcode 71)
                                                                    (if (or (!= (.op1 node)
                                                                                entry)
                                                                            (< (.op3 node)
                                                                               0)
                                                                            (>= (.op3 node)
                                                                                parameters))
                                                                        (set! good
                                                                              false)
                                                                        (when (!= (n/type-id node)
                                                                                  (get definition
                                                                                       (+ 3
                                                                                          (cast i64
                                                                                                (.op3 node)))))
                                                                          (set! good
                                                                                false)))
                                                                  (or (= opcode
                                                                         91)
                                                                      (= opcode
                                                                         93))
                                                                    (do
                                                                      (set! effects
                                                                            (+ effects
                                                                               1))
                                                                      (when (and (= opcode
                                                                                    91)
                                                                                 (not (scalar? (n/type-id node))))
                                                                        (set! good
                                                                              false)))
                                                                  (or (= opcode
                                                                         106)
                                                                      (= opcode
                                                                         107)
                                                                      (= opcode
                                                                         108)
                                                                      (= opcode
                                                                         112)
                                                                      (= opcode
                                                                         114)
                                                                      (= opcode
                                                                         116))
                                                                    0
                                                                  (and (pure? opcode)
                                                                       (scalar? (n/type-id node)))
                                                                    0
                                                                  :else
                                                                    (set! good
                                                                          false))
                                                            (for [i
                                                                  1
                                                                  (+ (cast i64
                                                                           count)
                                                                     1)]
                                                              (when (uses/edge-code? (op/operand-code opcode
                                                                                                      (cast i32
                                                                                                            i)))
                                                                (match (g/operand callee
                                                                                  (cast i32
                                                                                        r)
                                                                                  (cast i32
                                                                                        i))
                                                                  (Some [input]
                                                                        (when (< input
                                                                                 0)
                                                                          (match (g/lookup callee
                                                                                           input)
                                                                            (Some [value]
                                                                                  (when (or (not (scalar? (n/type-id value)))
                                                                                            (not (or (= (n/opcode value)
                                                                                                        (n/type-id value))
                                                                                                     (= (n/opcode value)
                                                                                                        74)
                                                                                                     (= (n/opcode value)
                                                                                                        75))))
                                                                                    (set! good
                                                                                          false)))
                                                                            (None []
                                                                                  (set! good
                                                                                        false)))))
                                                                  (None []
                                                                        (set! good
                                                                              false)))))
                                                            (set! r
                                                                  (+ r
                                                                     (/ (+ (cast i64
                                                                                 count)
                                                                           4)
                                                                        4)))))
                                                        (when (> (+ (- size 1)
                                                                    conversions)
                                                                 (cast i64
                                                                       budget))
                                                          (set! good false))
                                                        (when (not (closed-acyclic? callee
                                                                                    (.roots target)
                                                                                    a))
                                                          (set! good false)))))))))))))))))
    good))

(defn zeros [(count i64) (a (dyn Allocator))] (-> (ArrayList i32))
  (let [(mut result) (ArrayList::new [i32] a)]
    (for [i 0 count] (push! (mut result) 0))
    result))

(defn constant! [(caller (mut g/Graph)) (callee g/Graph) (value n/Node)]
  (-> (Result i32 (slice u8)))
  (let [opcode (n/opcode value)]
    (if (or (= opcode 74) (= opcode 75))
        (match (strings/lookup (.strings callee)
                               (cast i32 (n/constant-bits value)))
          (None [] (Err "inline symbol name missing"))
          (Some [name]
                (let [(mut proto) (: 0 i32)
                      (mut error) ""]
                  (when (> (n/auxiliary value) 0)
                    (match (strings/lookup (.strings callee)
                                           (cast i32 (n/auxiliary value)))
                      (None [] (set! error "inline symbol prototype missing"))
                      (Some [bytes]
                            (match (strings/intern! (mut (.strings caller))
                                                    bytes)
                              (None []
                                    (set! error
                                          "inline symbol prototype space exhausted"))
                              (Some [id] (set! proto id))))))
                  (if (!= error "")
                      (Err error)
                      (symbols/named! (mut caller) opcode name proto)))))
        (match (g/intern-constant! (mut caller)
                                   opcode
                                   (n/type-id value)
                                   (n/auxiliary value)
                                   (n/constant-bits value))
          (None [] (Err "inline constant reference space exhausted"))
          (Some [reference] (Ok reference))))))

(defn mapped! [(caller (mut g/Graph))
               (callee g/Graph)
               (mapping (ArrayList i32))
               (constants (mut (ArrayList i32)))
               (reference i32)] (-> (Result i32 (slice u8)))
  (if (>= reference 0)
      (if (= reference 0)
          (Ok 0)
          (let [value (get mapping (cast i64 reference))]
            (if (= value 0)
                (Err "inline operand has no mapped definition")
                (Ok value))))
      (let [index (- (- 0 (cast i64 reference)) 1)
            known (get constants index)]
        (if (!= known 0)
            (Ok known)
            (match (g/lookup callee reference)
              (None [] (Err "inline constant missing"))
              (Some [value]
                    (match (constant! (mut caller) callee value)
                      (Err [message] (Err message))
                      (Ok [new] (set! (mut constants) index new) (Ok new)))))))))

;;; The graph is owned and eligible; all old references remain stable. Reserve
;;; every clone before patching edges so legal forward references remain legal.
(defn apply! [(graph (mut g/Graph))
              (roots (mut (ArrayList i32)))
              (reference i32)
              (target Callee)
              (seeds (mut (ArrayList i32)))
              (a (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [callee (.graph target)
        (mut call) (get (.instructions graph) (cast i64 reference))
        ret (get (.instructions callee) (cast i64 (get (.roots target) 0)))
        (mut mapping) (zeros (len (.instructions callee)) a)
        (mut constants) (zeros (len (.constants callee)) a)
        (mut inputs) (ArrayList::new [i32] a)
        (mut error) ""
        (mut r) 1]
    (set! (mut mapping) (cast i64 (.entry target)) (.op1 call))
    (for [i 3 (+ (cast i64 (get (.arities graph) (cast i64 reference))) 1)]
      (match (g/operand graph reference (cast i32 i))
        (Some [input] (when (> input 0) (push! (mut seeds) input)))
        (None [] (set! error "inline call argument missing"))))
    (while (and (= error "") (< r (len (.instructions callee))))
      (let [node (get (.instructions callee) r)
            opcode (n/opcode node)
            count (get (.arities callee) r)]
        (cond (= opcode 71)
                (match (g/operand graph reference (+ (.op3 node) 3))
                  (Some [input]
                        (match (g/lookup graph input)
                          (None [] (set! error "inline argument disappeared"))
                          (Some [actual]
                                (if (= (n/type-id actual) (n/type-id node))
                                    (set! (mut mapping) r input)
                                    (match (g/append-inputs! (mut graph)
                                                             36
                                                             (n/type-id node)
                                                             [input])
                                      (None []
                                            (set! error
                                                  "inline argument cast space exhausted"))
                                      (Some [casted]
                                            (set! (mut mapping) r casted)
                                            (push! (mut seeds) casted)))))))
                  (None [] (set! error "inline parameter missing")))
              (or (= opcode 0) (= opcode 104) (= opcode 120)) 0
              :else
                (do
                  (clear! (mut inputs))
                  (for [i 0 (cast i64 count)] (push! (mut inputs) 0))
                  (match (g/append-inputs-with-aux! (mut graph)
                                                    opcode
                                                    (n/type-id node)
                                                    (n/auxiliary node)
                                                    (slice inputs))
                    (None [] (set! error "inline instruction space exhausted"))
                    (Some [cloned]
                          (set! (mut mapping) r cloned)
                          (push! (mut seeds) cloned)))))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    (set! r 1)
    (while (and (= error "") (< r (len (.instructions callee))))
      (let [node (get (.instructions callee) r)
            opcode (n/opcode node)
            count (get (.arities callee) r)
            cloned (get mapping r)]
        (unless (or (= opcode 0) (= opcode 104) (= opcode 120) (= opcode 71))
          (for [i 1 (+ (cast i64 count) 1)]
            (match (g/operand callee (cast i32 r) (cast i32 i))
              (None [] (set! error "inline source operand missing"))
              (Some [input]
                    (let [value
                            (if (uses/edge-code? (op/operand-code (cast i32
                                                                        opcode)
                                                                  (cast i32 i)))
                                (mapped! (mut graph)
                                         callee
                                         mapping
                                         (mut constants)
                                         input)
                                (Ok [i32 (slice u8)] input))]
                      (match value
                        (Err [message] (set! error message))
                        (Ok [replacement]
                            (g/write-input-word! (mut graph)
                                                 cloned
                                                 (cast i32 i)
                                                 replacement))))))))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    (when (= error "")
      (match (mapped! (mut graph) callee mapping (mut constants) (.op1 ret))
        (Err [message] (set! error message))
        (Ok [control]
            (match (mapped! (mut graph)
                            callee
                            mapping
                            (mut constants)
                            (.op2 ret))
              (Err [message] (set! error message))
              (Ok [value]
                  (set! r 1)
                  (while (< r (len (.instructions graph)))
                    (let [node (get (.instructions graph) r)
                          count (get (.arities graph) r)]
                      (when (!= r (cast i64 reference))
                        (for [i 1 (+ (cast i64 count) 1)]
                          (let [kind
                                  (op/operand-code (cast i32 (n/opcode node))
                                                   (cast i32 i))]
                            (when (uses/edge-code? kind)
                              (match (g/operand graph (cast i32 r) (cast i32 i))
                                (Some [old]
                                      (when (= old reference)
                                        (g/write-input-word! (mut graph)
                                                             (cast i32 r)
                                                             (cast i32 i)
                                                             (if (= kind
                                                                    op/OPERAND-SRC)
                                                                 control
                                                                 value))
                                        (push! (mut seeds) (cast i32 r))))
                                (None []
                                      (set! error "inline user operand missing")))))))
                      (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
                  (let [count (len roots)]
                    (for [i 0 count]
                      (when (= (get roots i) reference)
                        (if (= (n/type-id call) 0)
                            (set! (mut roots) i control)
                            (push! (mut roots) control)))))
                  (if (= (n/type-id call) 0)
                      (g/make-nop! (mut graph) reference)
                      (g/rewrite-inputs! (mut graph)
                                         reference
                                         68
                                         (n/type-id call)
                                         [value (: 0 i32)]))
                  (g/invalidate-expressions! (mut graph))
                  (push! (mut seeds) reference))))))
    (free! (mut inputs))
    (free! (mut constants))
    (free! (mut mapping))
    (if (= error "") (Ok 1) (Err error))))

(defstruct Site [(reference i32) (target Callee)])

;;; One transaction and graph copy for an ordered set of distinct original CALLs.
;;; The budget bounds total cloned cells, not each individual call. Definitions
;;; are borrowed and immutable throughout; all structural analyses are rebuilt.
(defn optimize-sites [(source g/Graph)
                      (roots (slice i32))
                      (sites (slice Site))
                      (pointer-bytes i32)
                      (budget i32)
                      (a (dyn Allocator))]
  (-> (Result rewrite/Rewritten (slice u8)))
  (let [(mut error) ""
        (mut seen) (zeros (len (.instructions source)) a)]
    (when (or (< budget 0) (> budget 16384))
      (set! error "invalid inline budget"))
    (match (rewrite/validate source pointer-bytes a)
      (Err [message] (set! error message))
      (Ok [_] 0))
    (for root roots
      (when (or (<= root 0) (not (g/contains? source root)))
        (set! error "invalid inline caller root")))
    (for site sites
      (let [target (.target site)
            reference (.reference site)]
        (when (= error "")
          (match (rewrite/validate (.graph target) pointer-bytes a)
            (Err [message] (set! error message))
            (Ok [_] 0)))
        (for root (.roots target)
          (when (or (<= root 0) (not (g/contains? (.graph target) root)))
            (set! error "invalid inline callee root")))
        (match (g/lookup source reference)
          (Some [call]
                (if (or (<= reference 0) (!= (n/opcode call) 79))
                    (set! error "inline target must be CALL")
                    (if (!= (get seen (cast i64 reference)) 0)
                        (set! error "duplicate inline CALL")
                        (set! (mut seen) (cast i64 reference) 1))))
          (None [] (set! error "inline CALL missing")))))
    (free! (mut seen))
    (if (!= error "")
        (Err error)
        (let [(mut graph) (g/duplicate source a)
              (mut observed) (ArrayList::new [i32] a)
              (mut seeds) (ArrayList::new [i32] a)
              (mut changes) (: 0 i32)
              (mut remaining) budget]
          (for root roots (push! (mut observed) root))
          (for site sites
            (let [target (.target site)
                  reference (.reference site)]
              (when (and (= error "")
                         (eligible? graph reference target remaining a))
                (let [before (len (.instructions graph))]
                  (match (apply! (mut graph)
                                 (mut observed)
                                 reference
                                 target
                                 (mut seeds)
                                 a)
                    (Err [message] (set! error message))
                    (Ok [count]
                        (set! changes (+ changes count))
                        (set! remaining
                              (- remaining
                                 (cast i32
                                       (- (len (.instructions graph)) before))))))))))
          (when (= error "")
            (match (rewrite/validate graph pointer-bytes a)
              (Err [message] (set! error message))
              (Ok [_] 0)))
          (if (!= error "")
              (do
                (g/release! (mut graph))
                (free! (mut observed))
                (free! (mut seeds))
                (Err error))
              (let [(mut queue) (q/create (len (.instructions graph)) a)]
                (for seed seeds (q/add! (mut queue) (cast i64 seed)))
                (free! (mut seeds))
                (Ok (rewrite/Rewritten
                      :graph graph
                      :roots observed
                      :changes changes
                      :iteration queue))))))))

;;; Transactional single-site convenience API.
(defn optimize [(source g/Graph)
                (roots (slice i32))
                (reference i32)
                (target Callee)
                (pointer-bytes i32)
                (budget i32)
                (a (dyn Allocator))] (-> (Result rewrite/Rewritten (slice u8)))
  (optimize-sites source
                  roots
                  [(Site :reference reference :target target)]
                  pointer-bytes
                  budget
                  a))
