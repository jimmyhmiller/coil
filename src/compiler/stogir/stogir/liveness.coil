;;; Root-driven dependency closure. Callers supply all observable control roots.
(module stogir.liveness)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.uses" :as uses)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Some None])

;;; Requires a structurally verified graph and valid positive root references.
;;; Marks instruction cells only; constants are not allocation/scheduling candidates.
;;; Work is bounded by reachable nodes and reference edges, including cycles.
(defn mark [(graph g/Graph) (roots (slice i32)) (allocator (dyn Allocator))]
  (-> (ArrayList bool))
  (let [(mut live) (ArrayList::new [bool] allocator)
        (mut work) (ArrayList::new [i32] allocator)
        (mut i) 0]
    (while (< i (len (.instructions graph)))
      (push! (mut live) false)
      (set! i (+ i 1)))
    (for root roots
      (when (and (> root 0) (g/contains? graph root))
        (when (not (get live (cast i64 root)))
          (set! (mut live) (cast i64 root) true)
          (push! (mut work) root))))
    (let [(mut cursor) 0]
      (while (< cursor (len work))
        (let [r (get work cursor)
              node (get (.instructions graph) (cast i64 r))
              count (get (.arities graph) (cast i64 r))
              (mut index) (: 1 i32)]
          (while (<= index count)
            (when (uses/edge-kind? (op/operand-kind (cast i32 (n/opcode node))
                                                    index))
              (match (g/operand graph r index)
                (Some [value]
                      (when (> value 0)
                        (when (not (get live (cast i64 value)))
                          (set! (mut live) (cast i64 value) true)
                          (push! (mut work) value))))
                (None [] 0)))
            (set! index (+ index 1))))
        (set! cursor (+ cursor 1))))
    (free! (mut work))
    live))
