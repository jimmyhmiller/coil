;;; Coil extension: sequentially consistent raw integer atomics.
;;; Storage types U8/U16/U32/U64 separate byte width from signed RMW predicates.
(module stogir.atomic)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "coil.result" :use [Result Ok Err Some None])

(defn operation? [(opcode i32)] (-> bool)
  (and (>= opcode 126) (<= opcode 130)))

(defn ordinary? [(graph g/Graph) (reference i32) (ty i32)] (-> bool)
  (match (g/lookup graph reference)
    (None [] false)
    (Some [value]
          (and (= (cast i32 (n/type-id value)) ty)
               (!= (n/opcode value) 70)
               (!= (n/opcode value) 72)))))

(defn validate [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "atomic instruction missing"))
    (Some [node]
          (let [opcode (cast i32 (n/opcode node))
                ty (cast i32 (n/type-id node))
                (mut storage) ty
                (mut error) ""]
            (when (or (<= reference 0)
                      (not (operation? opcode))
                      (!= (get (.arities graph) (cast i64 reference))
                          (op/operand-slots opcode)))
              (set! error "invalid atomic instruction shape"))
            (match (g/lookup graph (.op1 node))
              (None [] (set! error "atomic control missing"))
              (Some [control]
                    (when (or (<= (.op1 node) 0)
                              (not (op/control? (cast i32 (n/opcode control))))
                              (op/block-end? (cast i32 (n/opcode control))))
                      (set! error "invalid atomic control"))))
            (when (= opcode 130)
              (when (!= ty 0) (set! error "atomic fence must be void")))
            (when (!= opcode 130)
              (when (not (ordinary? graph (.op2 node) 6))
                (set! error "atomic address must be ADDR"))
              (when (= opcode 127)
                (when (!= ty 0) (set! error "atomic store must be void"))
                (match (g/lookup graph (.op3 node))
                  (None [] (set! error "atomic store value missing"))
                  (Some [value] (set! storage (cast i32 (n/type-id value))))))
              (when (or (< storage 2) (> storage 5))
                (set! error "atomic storage must be U8/U16/U32/U64"))
              (when (and (!= opcode 126)
                         (not (ordinary? graph (.op3 node) storage)))
                (set! error "atomic input storage type mismatch")))
            (when (or (= opcode 128) (= opcode 129))
              (match (g/operand graph reference 4)
                (None [] (set! error "atomic fourth operand missing"))
                (Some [last]
                      (if (= opcode 128)
                          (when (or (< last 0) (> last 9))
                            (set! error "invalid atomic RMW operation"))
                          (when (not (ordinary? graph last storage))
                            (set! error "atomic desired storage type mismatch"))))))
            (if (= error "")
                (Ok (if (= opcode 130) 0 (types/scalar-size storage 8)))
                (Err error))))))
