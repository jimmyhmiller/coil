;;; Physical locations and contiguous split-boundary transfers.
(module stogir.locations)
(import "stogir.allocation" :as a)
(import "stogir.interval" :as range)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Option Some None Ok Err])

;;; kind0=register,1=spill byte offset,2=read-only x29-relative address,
;;; 3=read-only SP-relative address,4=read-only graph constant reference.
;;; Frame offsets are base-relative; kind4 values are negative instruction refs.
(defstruct Location [(kind i32) (value i64)])

(defn rematerialized? [(location Location)] (-> bool)
  (or (= (.kind location) 2) (= (.kind location) 3)))

(defn constant? [(location Location)] (-> bool)
  (and (= (.kind location) 4) (< (.value location) 0) (>= (.value location) -2147483648)))

(defn address-base [(location Location)] (-> i32)
  (if (= (.kind location) 2) 29 (if (= (.kind location) 3) 31 -1)))

;;; Distinguish a frame address from memory contents at the same offset.
(defn identity-key [(location Location)] (-> u128)
  (| (<< (cast u128 (cast u32 (.kind location))) 64)
     (cast u128 (cast u64 (.value location)))))

(defn identity-location [(id i32) (identities (ArrayList Location))] (-> Location)
  (if (< id 64) (Location :kind 0 :value (cast i64 id))
      (get identities (cast i64 (- id 64)))))

(defstruct Transfer
  [(position i64) (parent i32) (source Location) (destination Location)])

(defn of-part [(part a/Part)] (-> Location)
  (if (>= (.register part) 0)
      (Location :kind 0 :value (cast i64 (.register part)))
      (Location :kind 1 :value (.spill-slot part))))

(defn same? [(a Location) (b Location)] (-> bool)
  (and (= (.kind a) (.kind b)) (= (.value a) (.value b))))

(defn lookup [(parts (ArrayList a/Part)) (parent i32) (position i64)]
  (-> (Result Location (slice u8)))
  (let [(mut found) false
        (mut result) (Location :kind 1 :value -1)
        (mut error) ""
        (mut i) 0]
    (while (< i (len parts))
      (let [part (at parts i)]
        (when (and (= (.parent part) parent)
                   (range/covers? (.ranges part) position))
          (if found
              (set! error "overlapping split children")
              (do (set! found true) (set! result (of-part (load part)))))))
      (set! i (+ i 1)))
    (if (!= error "")
        (Err error)
        (if (or (not found) (< (.value result) 0))
            (Err "value has no location at position")
            (Ok result)))))

;;; Only contiguous split boundaries are handled here. CFG edge reconciliation
;;; must additionally handle holes, cross-block transitions and phi copies.
(defn contiguous [(parts (ArrayList a/Part)) (allocator (dyn Allocator))]
  (-> (ArrayList Transfer))
  (let [(mut result) (ArrayList::new [Transfer] allocator)
        (mut i) 0]
    (while (< i (len parts))
      (let [child (at parts i)]
        ; Negative parents describe physical reservations, not virtual values.
        (when (and (>= (.parent child) 0) (> (len (.ranges child)) 0))
          (let [position (.start (get (.ranges child) 0))
                (mut j) 0]
            (while (< j (len parts))
              (let [prior (at parts j)
                    count (len (.ranges prior))]
                (when (and (!= i j)
                           (= (.parent prior) (.parent child))
                           (> count 0)
                           (= (.end (get (.ranges prior) (- count 1))) position))
                  (let [source (of-part (load prior))
                        destination (of-part (load child))]
                    (when (not (same? source destination))
                      (push! (mut result)
                             (Transfer
                               :position position
                               :parent (.parent child)
                               :source source
                               :destination destination))))))
              (set! j (+ j 1))))))
      (set! i (+ i 1)))
    result))

;;; Immutable per-value split-child index, built only after allocation finishes.
;;; Children retain their original part order. Physical reservations (negative
;;; parents) are excluded. Rebuild after any part/range/assignment mutation.
(defstruct ParentRange [(offset i64) (count i64)])

(defstruct Rematerialized [(parent i32) (location Location)])

(defstruct Index
  [(parents (ArrayList ParentRange))
   (children (ArrayList i32))
   (coalesced bool)
   (rematerialized (ArrayList Rematerialized))])

(defn empty-index [(allocator (dyn Allocator))] (-> Index)
  (Index
    :parents (ArrayList::new [ParentRange] allocator)
    :children (ArrayList::new [i32] allocator)
    :coalesced false
    :rematerialized (ArrayList::new [Rematerialized] allocator)))

(defn release-index! [(index (mut Index))] (-> void)
  (free! (mut (.rematerialized index)))
  (free! (mut (.parents index)))
  (free! (mut (.children index))))

(defn build-index [(parts (ArrayList a/Part))
                   (parent-count i64)
                   (allocator (dyn Allocator))] (-> (Result Index (slice u8)))
  (let [(mut index) (empty-index allocator)
        (mut error) ""
        (mut offset) 0]
    (when (< parent-count 0) (set! error "invalid location parent count"))
    (when (> parent-count 0)
      (extend-zeroed! (mut (.parents index)) parent-count))
    (for part parts
      (when (>= (.parent part) 0)
        (if (>= (cast i64 (.parent part)) parent-count)
            (set! error "location parent outside index")
            (let [slot (elem (mut (.parents index)) (cast i64 (.parent part)))]
              (set! (.count slot) (+ (.count slot) 1))))))
    (for [i 0 (len (.parents index))]
      (let [slot (elem (mut (.parents index)) i)]
        (set! (.offset slot) offset)
        (set! offset (+ offset (.count slot)))
        (set! (.count slot) 0)))
    (extend-zeroed! (mut (.children index)) offset)
    (when (= error "")
      (for [i 0 (len parts)]
        (let [part (at parts i)]
          (when (>= (.parent part) 0)
            (let [slot (elem (mut (.parents index)) (cast i64 (.parent part)))]
              (set! (mut (.children index))
                    (+ (.offset slot) (.count slot))
                    (cast i32 i))
              (set! (.count slot) (+ (.count slot) 1)))))))
    (if (= error "")
        (Ok index)
        (do (release-index! (mut index)) (Err error)))))

(defn rematerialized-location [(index Index) (parent i32)] (-> (Option Location))
  (let [(mut lo) (: 0 i64) (mut hi) (len (.rematerialized index))]
    (while (< lo hi)
      (let [mid (+ lo (/ (- hi lo) 2))]
        (if (< (.parent (get (.rematerialized index) mid)) parent)
            (set! lo (+ mid 1)) (set! hi mid))))
    (if (and (< lo (len (.rematerialized index)))
             (= (.parent (get (.rematerialized index) lo)) parent))
        (Some (.location (get (.rematerialized index) lo))) (None))))

(defn constant-reference-indexed [(index Index) (reference i32)] (-> i32)
  (if (< reference 0) reference
      (match (rematerialized-location index reference)
        (Some [location] (if (constant? location) (cast i32 (.value location)) 0))
        (None [] 0))))

;;; Uses exact lifetime ranges, preserving the linear oracle's overlap errors.
(defn lookup-indexed [(parts (ArrayList a/Part))
                      (index Index)
                      (parent i32)
                      (position i64)]
  (-> (Result Location (slice u8)))
  ; Physical reservation queries retain the generic API's negative-parent
  ; semantics; the per-value index intentionally stores nonnegative values only.
  (if (< parent 0)
      (lookup parts parent position)
      (let [(mut found) false
            (mut result) (Location :kind 1 :value -1)
            (mut error) ""]
        (when (and (>= parent 0) (< (cast i64 parent) (len (.parents index))))
          (let [bucket (get (.parents index) (cast i64 parent))]
            (for [i (.offset bucket) (+ (.offset bucket) (.count bucket))]
              (let [part (at parts (cast i64 (get (.children index) i)))]
                (when (range/covers? (.ranges part) position)
                  (if found
                      (set! error "overlapping split children")
                      (do (set! found true) (set! result (of-part (load part))))))))))
        (if (!= error "")
            (Err error)
            (if (not found)
                (if (< position 0) (Err "value has no location at position")
                (match (rematerialized-location index parent)
                  (Some [location] (Ok location))
                  (None [] (Err "value has no location at position"))))
                (if (< (.value result) 0) (Err "value has no location at position")
                    (Ok result)))))))

;;; Legacy callers retain linear queries; finalized backend callers supply the
;;; owned index. This selector does not modify allocation or resolve errors.
(defn query [(parts (ArrayList a/Part))
             (index Index)
             (indexed bool)
             (parent i32)
             (position i64)] (-> (Result Location (slice u8)))
  (if indexed
      (lookup-indexed parts index parent position)
      (lookup parts parent position)))

;;; Same transfer sequence as contiguous, restricted to each parent's children.
(defn contiguous-indexed [(parts (ArrayList a/Part))
                          (index Index)
                          (allocator (dyn Allocator))]
  (-> (ArrayList Transfer))
  (let [(mut result) (ArrayList::new [Transfer] allocator)]
    (for [i 0 (len parts)]
      (let [child (at parts i)]
        (when (and (>= (.parent child) 0) (> (len (.ranges child)) 0))
          (let [position (.start (get (.ranges child) 0))
                bucket (get (.parents index) (cast i64 (.parent child)))]
            (for [k (.offset bucket) (+ (.offset bucket) (.count bucket))]
              (let [j (cast i64 (get (.children index) k))
                    prior (at parts j)
                    count (len (.ranges prior))]
                (when (and (!= i j)
                           (> count 0)
                           (= (.end (get (.ranges prior) (- count 1))) position))
                  (let [source (of-part (load prior))
                        destination (of-part (load child))]
                    (when (not (same? source destination))
                      (push! (mut result)
                             (Transfer
                               :position position
                               :parent (.parent child)
                               :source source
                               :destination destination)))))))))))
    result))

;;; Borrowed immutable post-allocation lookup context. The owner retains both
;;; arrays and index; never release or mutate their headers through this view.
(defstruct View [(parts (ArrayList a/Part)) (index Index) (indexed bool)])

(defn indexed-view [(parts (ArrayList a/Part)) (index Index)] (-> View)
  (View
    :parts parts
    :index index
    :indexed true))

;;; Compatibility callers retain full-scan semantics without building an index.
(defn linear-view [(parts (ArrayList a/Part))] (-> View)
  (View
    :parts parts
    :index (empty-index (.alc parts))
    :indexed false))

;;; Whether the value is held at position by its original register assignment,
;;; before any split: the register then still holds what the value's definition
;;; wrote. Split children only ever take suffixes, and coalesced members never
;;; write the shared register while this value is live. Linear views answer
;;; false.
(defn original-register? [(view View) (parent i32) (position i64)] (-> bool)
  (and (.indexed view)
       (>= parent 0)
       (< (cast i64 parent) (len (.parents (.index view))))
       (let [bucket (get (.parents (.index view)) (cast i64 parent))]
         (and (> (.count bucket) 0)
              (let [part (at (.parts view)
                             (cast i64 (get (.children (.index view)) (.offset bucket))))]
                (and (>= (.register part) 0)
                     (range/covers? (.ranges part) position)))))))

(defn resolve [(view View) (parent i32) (position i64)]
  (-> (Result Location (slice u8)))
  (if (.indexed view)
      (lookup-indexed (.parts view) (.index view) parent position)
      (lookup (.parts view) parent position)))

(defn constant-reference [(view View) (reference i32)] (-> i32)
  (if (< reference 0) reference
      (if (.indexed view) (constant-reference-indexed (.index view) reference) 0)))

;;; Allocated children share one virtual owner, including aliases. Read-only
;;; frame addresses retain their own graph identity without allocation children.
(defn owner [(parts (ArrayList a/Part)) (index Index) (parent i32)] (-> i32)
  (let [bucket (get (.parents index) (cast i64 parent))]
    (if (> (.count bucket) 0)
        (.parent (at parts (cast i64 (get (.children index) (.offset bucket)))))
        (match (rematerialized-location index parent)
          (Some [_] parent)
          (None [] (panic "value has no allocation owner"))))))
