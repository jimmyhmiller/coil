;;; A frame object nobody else can address. Independent of upstream; extends
;;; the pinned memory model of address-alias with one fact: when every use of
;;; a function-lifetime frame object's address is one of the uses below, no
;;; other address in the function, no callee that is not handed the address,
;;; and nothing those callees keep can name its bytes. See docs/CALL_EFFECTS.md.
(module stogir.private-object)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.uses" :as uses)
(import "stogir.address-alias" :as alias)
(import "stogir.calls" :as calls)
(import "stogir.call-groups" :as groups)
(import "stogir.call-results" :as results)
(import "stogir.call-effects" :as effects)
(import "stogir.strings" :as strings)
(import "coil.result" :use [Some None])

;;; One load's question, answered at most once: OBJECT is the frame object
;;; that wholly contains the queried bytes when STATE is 1 and that object is
;;; unshared; STATE 2 means there is no such object; 0, not asked yet. A query
;;; made with `none` never has one. EDGES must be the use index of the graph
;;; as it is now.
(defstruct Query [(edges uses/Uses) (address alias/Address) (width i64)
                  (object i32) (state i32)])

(defn query [(edges uses/Uses) (address alias/Address) (width i64)] (-> Query)
  (Query :edges edges :address address :width width :object 0 :state 0))

(defn none [(edges uses/Uses)] (-> Query)
  (Query :edges edges :address (alias/Address :base 0 :index 0 :offset 0) :width 0
         :object 0 :state 2))

;;; The result role CALL's prototype states; ordinary when it has none.
(defn result-role [(graph g/Graph) (call i32)] (-> results/Spec)
  (let [node (get (.instructions graph) (cast i64 call))]
    (match (calls/signature graph (.op2 node) (n/type-id node)
                            (- (get (.arities graph) (cast i64 call)) 2))
      (Err [_] (results/indirect))
      (Ok [found]
          (if (= (.id found) 0) (results/ordinary)
              (match (strings/lookup (.strings graph) (.id found))
                (None [] (results/indirect))
                (Some [bytes] (results/decode bytes))))))))

;;; Whether operand OPERAND of CALL takes a pointer the callee cannot keep: the
;;; place of register result pieces, which the callee never sees; an operand of
;;; a builtin move or compare (the caller checks the move's result apart); an
;;; argument its effect record does not capture, or any argument of a
;;; declared read-only target whose result is narrower than a pointer.
(defn passes-unkept? [(graph g/Graph) (call i32) (operand i32)] (-> bool)
  (and (>= operand 3)
       (or (!= (calls/builtin-call graph call) 0)
           (and (= operand 3) (= (.kind (result-role graph call)) 1))
       (match (calls/effect-prototype graph call)
         (Some [bytes]
               (and (< operand 19)
                    (= (& (.captures (groups/effects bytes)) (<< (: 1 i32) (- operand 3))) 0)))
         (None []
               (match (effects/declared-result graph call)
                 (None [] false)
                 (Some [spec]
                       (and (= (.kind spec) 0)
                            (< (types/size (cast i32 (n/type-id (get (.instructions graph)
                                                                     (cast i64 call)))) 8)
                               8)))))))))

;;; Every use of OBJECT's address, followed through the pointer steps that
;;; alias/decompose resolves back to OBJECT, is the address of a LOAD or
;;; STORE, a comparison, or an argument its callee cannot keep. So the address
;;; is never stored, returned, merged or converted: a pointer that does not
;;; decompose to OBJECT cannot point into it. At most 256 uses and 64 derived
;;; pointers are examined; more is "shared".
(defn unshared? [(graph g/Graph) (edges uses/Uses) (object i32)] (-> bool)
  (let [(mut work) (zeroed (array i32 64))
        (mut queued) (: 1 i64) (mut head) (: 0 i64) (mut seen) 0 (mut good) true]
    (set! (mut work) 0 object)
    (while (and good (< head queued))
      (let [pointer (get work head)
            range (get (.ranges edges) (cast i64 pointer))]
        (set! head (+ head 1))
        (for [i (.offset range) (+ (.offset range) (.count range))]
          (when good
            (let [edge (get (.edges edges) i)
                  user (.user edge)
                  node (get (.instructions graph) (cast i64 user))
                  opcode (cast i32 (n/opcode node))]
              (set! seen (+ seen 1))
              (cond
                (> seen 256) (set! good false)
                (= (op/operand-code opcode (.operand edge)) op/OPERAND-SRC) 0
                (and (or (= opcode 91) (= opcode 93)) (= (.operand edge) 2)) 0
                (and (>= opcode 14) (<= opcode 23)) 0
                (or (= opcode 26) (= opcode 27) (= opcode 36) (= opcode 68))
                  (if (and (< queued 64)
                           (= (.base (alias/decompose graph user 8)) object))
                      (let [(mut known) false]
                        (for [k 0 queued] (when (= (get work k) user) (set! known true)))
                        (unless known
                          (set! (mut work) queued user)
                          (set! queued (+ queued 1))))
                      (set! good false))
                (= opcode 79)
                  (if (not (passes-unkept? graph user (.operand edge)))
                      (set! good false)
                      ; A builtin move returns its destination: a pointer into
                      ; the object that does not decompose to it, so no value
                      ; may use it.
                      (when (and (= (.operand edge) 3)
                                 (= (calls/builtin-call graph user) groups/BUILTIN-MOVE))
                        (let [results (get (.ranges edges) (cast i64 user))]
                          (for [k (.offset results) (+ (.offset results) (.count results))]
                            (let [use (get (.edges edges) k)]
                              (unless (= (op/operand-code
                                           (cast i32 (n/opcode (get (.instructions graph)
                                                                    (cast i64 (.user use)))))
                                           (.operand use))
                                         op/OPERAND-SRC)
                                (set! good false)))))))
                :else (set! good false)))))))
    good))

;;; Settle the query: its bytes lie wholly inside an unshared frame object.
(defn settle! [(graph g/Graph) (q (mut Query))] (-> bool)
  (when (= (.state q) 0)
    (set! (.state q) 2)
    (let [base (.base (.address q))]
      (when (and (> base 0) (< (cast i64 base) (len (.ranges (.edges q)))))
        (let [extent (alias/private-extent graph base 8)]
          (when (and (> extent 0) (alias/contained? (.address q) (.width q) extent)
                     (unshared? graph (.edges q) base))
            (set! (.object q) base)
            (set! (.state q) 1))))))
  (= (.state q) 1))

;;; A STORE at TARGET cannot write the queried bytes: they are in an unshared
;;; frame object and TARGET is not one of its pointers. Another frame object
;;; is left to the ordinary containment rules.
(defn store-spares? [(graph g/Graph) (q (mut Query)) (target alias/Address)] (-> bool)
  (and (!= (.state q) 2)
       (!= (.base target) (.base (.address q)))
       (match (g/lookup graph (.base target))
         (None [] false)
         (Some [node] (!= (n/opcode node) 81)))
       (settle! graph (mut q))))

;;; CALL cannot write the queried bytes: they are in an unshared frame object,
;;; so the callee reaches them only through an argument that decomposes to the
;;; object. Each such argument must be one its record does not write through,
;;; or writes only clear of the queried bytes; without a record the target
;;; must be declared read-only. The register pieces of an aggregate result
;;; captured into the object must land clear of them too.
(defn call-spares? [(graph g/Graph) (q (mut Query)) (call i32)] (-> bool)
  (if (or (= (.state q) 2) (not (settle! graph (mut q))))
      false
      (let [object (.object q)
            count (- (cast i64 (get (.arities graph) (cast i64 call))) 2)
            record (calls/effect-prototype graph call)
            role (result-role graph call)
            readonly (match (effects/declared-result graph call)
                       (Some [spec] (or (= (.kind spec) 0) (= (.kind spec) 1)))
                       (None [] false))
            builtin (calls/builtin-call graph call)
            (mut good) true]
        (for [j 0 count]
          (when good
            (match (g/operand graph call (cast i32 (+ j 3)))
              (None [] (set! good false))
              (Some [argument]
                    (let [target (alias/decompose graph argument 8)]
                      (when (= (.base target) object)
                        (cond
                          ; A compare only reads; a move writes its
                          ; destination range and reads its source.
                          (!= builtin 0)
                            (when (and (= builtin groups/BUILTIN-MOVE) (= j 0)
                                       (not (alias/disjoint? graph (.address q) target (.width q)
                                                             (calls/move-bytes graph call) 8)))
                              (set! good false))
                          ; The place of register pieces: written after the call.
                          (and (= j 0) (= (.kind role) 1))
                            (unless (alias/disjoint? graph (.address q) target (.width q)
                                                     (results/size role) 8)
                              (set! good false))
                          :else
                            (match record
                              (Some [bytes]
                                    (let [effect (groups/effects bytes)]
                                      (cond (>= j 16) (set! good false)
                                            (= (& (.writes effect) (<< (: 1 i32) (cast i32 j))) 0) 0
                                            :else
                                              (unless (alias/disjoint? graph (.address q) target
                                                                       (.width q) (.extent effect) 8)
                                                (set! good false)))))
                              (None [] (unless readonly (set! good false)))))))))))
        good)))
