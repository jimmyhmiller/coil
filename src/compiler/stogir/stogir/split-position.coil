;;; Loop-entry split selection adapted from pinned ir_ra.c; see NOTICE.
(module stogir.split-position)
(import "stogir.fill" :as fill)
(import "stogir.cfg" :as cfg)
(import "stogir.schedule" :as schedule)
(import "stogir.dominators" :as dom)
(import "stogir.interval" :as interval)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])

;;; Packed allocation order. Header/idom are indices into this immutable list.
;;; Empty metadata preserves the caller's original split position.
(defstruct Block [(start i64) (end i64) (depth i32) (header i32) (idom i32)])

;;; Reuse the prepared dominance and natural-loop depths. No new dominator pass.
;;; Unclassified natural-loop structure conservatively keeps the old policy.
(defn build [(blocks cfg/Blocks) (scheduled schedule/Schedule)
              (idom (ArrayList i32)) (depths (ArrayList i32)) (a (dyn Allocator))]
  (-> (ArrayList Block))
  (let [(mut result) (ArrayList::new [Block] a) (mut needed) false]
    (let [items-103 (.starts blocks) (mut for-index-103) (: 0 i64)] (while (< for-index-103 (len items-103)) (let [block (get items-103 for-index-103)]
      (when (and (< (cast i64 block) (len depths)) (> (get depths (cast i64 block)) 0))
        (set! needed true))) (set! for-index-103 (+ for-index-103 1))))
    (when (and needed (= (len idom) (len depths))
               (= (len idom) (len (.membership blocks))))
      (let [(mut ranks) (ArrayList::new [i32] a)
            (mut headers) (ArrayList::new [bool] a)
            (mut refs) (ArrayList::new [i32] a)
            (mut dominance) (dom/build-index idom a) (mut valid) true]
        (fill/append! (mut ranks) (len idom) -1)
        (extend-zeroed! (mut headers) (len idom))
        (for [i 0 (len (.nodes scheduled))]
          (let [ref (get (.nodes scheduled) i)]
            (when (= (get (.membership blocks) (cast i64 ref)) ref)
              (when (> (len result) 0)
                (set! (.end (elem (mut result) (- (len result) 1))) (* i 2)))
              (set! (mut ranks) (cast i64 ref) (cast i32 (len result)))
              (push! (mut refs) ref)
              (push! (mut result) (Block :start (* i 2) :end (* (len (.nodes scheduled)) 2)
                                   :depth (get depths (cast i64 ref)) :header -1 :idom -1)))))
        (let [items-102 (.edges blocks) (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [edge (get items-102 for-index-102)]
          (when (and (>= (get ranks (cast i64 (.from edge))) 0)
                     (>= (get ranks (cast i64 (.to edge))) 0)
                     (dom/indexed-dominates? dominance (.to edge) (.from edge)))
            (set! (mut headers) (cast i64 (.to edge)) true))) (set! for-index-102 (+ for-index-102 1))))
        (for [i 0 (len result)]
          (let [ref (get refs i) parent (get idom (cast i64 ref))
                depth (.depth (at result i)) (mut cursor) ref (mut left) (len refs)]
            (when (or (<= parent 0) (>= (cast i64 parent) (len ranks))
                      (< (get ranks (cast i64 parent)) 0)
                      (> (cast i64 (get ranks (cast i64 parent))) i))
              (set! valid false))
            (when valid
              (set! (.idom (elem (mut result) i)) (get ranks (cast i64 parent)))
              (when (> depth 0)
                (while (and (> left 0)
                            (not (and (get headers (cast i64 cursor))
                                      (= (get depths (cast i64 cursor)) depth))))
                  (let [next (get idom (cast i64 cursor))]
                    (if (or (<= next 0) (= next cursor)) (set! left 0)
                        (do (set! cursor next) (set! left (- left 1))))))
                (if (= left 0) (set! valid false)
                    (let [header (get ranks (cast i64 cursor))]
                      (if (or (< header 0) (> (cast i64 header) i)) (set! valid false)
                          (set! (.header (elem (mut result) i)) header))))))))
        (dom/release-index! (mut dominance))
        (free! (mut ranks)) (free! (mut headers)) (free! (mut refs))
        (unless valid (clear! (mut result)))))
    result))

(defn block-at [(blocks (slice Block)) (position i64)] (-> i32)
  (let [(mut lo) 0 (mut hi) (len blocks)]
    (while (< lo hi)
      (let [mid (+ lo (/ (- hi lo) 2))]
        (if (<= (.start (get blocks mid)) position) (set! lo (+ mid 1)) (set! hi mid))))
    (if (and (> lo 0) (< position (.end (get blocks (- lo 1)))))
        (cast i32 (- lo 1)) -1)))

(defn hole? [(ranges (ArrayList interval/Range)) (minimum i64) (maximum i64)] (-> bool)
  (block :found
    (let [items-101 ranges (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [range (get items-101 for-index-101)]
      (when (and (<= (.start range) minimum) (< minimum (.end range)))
        (break :found (> maximum (.end range))))) (set! for-index-101 (+ for-index-101 1))))
    true))

;;; The loop walk of ir_find_optimal_split_position: from maximum's block out
;;; through loop entries while they stay at or after minimum.
(defn walk [(blocks (slice Block)) (minimum i64) (maximum i64) (max-block i32)] (-> i64)
  (let [(mut cursor) max-block (mut done) false]
    (when (> (.depth (get blocks (cast i64 cursor))) 0)
      (while (and (not done) (> (.depth (get blocks (cast i64 cursor))) 0))
        (let [header (.header (get blocks (cast i64 cursor)))
              entry (.idom (get blocks (cast i64 header)))]
          (if (or (= entry cursor) (< (- (.end (get blocks (cast i64 entry))) 1) minimum))
              (set! done true) (set! cursor entry))))
      (when (< (- (.end (get blocks (cast i64 cursor))) 1) maximum)
        (set! done true)))
    (if (and done (< (- (.end (get blocks (cast i64 cursor))) 1) maximum))
        (- (.end (get blocks (cast i64 cursor))) 1)
        (if (> (.start (get blocks (cast i64 cursor))) minimum)
            (.start (get blocks (cast i64 cursor))) maximum))))

;;; Pinned ir_find_optimal_split_position. The caller supplies legal bounds and
;;; adapts definition/use phases for its transfer direction. Eviction stores may
;;; use odd definition positions; general register reloads may not.
(defn choose [(blocks (slice Block)) (ranges (ArrayList interval/Range))
               (minimum i64) (maximum i64) (prefer-maximum bool)] (-> i64)
  (let [min-block (block-at blocks minimum) max-block (block-at blocks maximum)]
    (if (or (< min-block 0) (< max-block 0)) maximum
        (if (or (= minimum maximum) (= min-block max-block) (hole? ranges minimum maximum))
            (if prefer-maximum maximum minimum)
            (walk blocks minimum maximum max-block)))))

;;; The walked position between two blocks even when the lifetime has a hole
;;; between them, provided the value is live there; -1 when the bounds share a
;;; block or it is not. Cold blocks a value is dead in (paths to UNREACHABLE)
;;; lie inside most long lifetimes in allocation order, and choose's hole rule
;;; then gives up on the loop entry.
(defn loop-entry [(blocks (slice Block)) (ranges (ArrayList interval/Range))
                  (minimum i64) (maximum i64)] (-> i64)
  (let [min-block (block-at blocks minimum) max-block (block-at blocks maximum)]
    (if (or (< min-block 0) (< max-block 0) (= minimum maximum) (= min-block max-block))
        -1
        (let [position (walk blocks minimum maximum max-block)]
          (if (interval/covers? ranges position) position -1)))))

;;; Header of the loop next outside the loop headed by block header, or -1.
;;; A header's dominator chain may pass through completed sibling loops, which
;;; are at least as deep; the first shallower block lies in the enclosing loop.
(defn outer-loop [(blocks (slice Block)) (header i32)] (-> i32)
  (let [depth (.depth (get blocks (cast i64 header)))
        (mut cursor) (.idom (get blocks (cast i64 header)))
        (mut left) (len blocks)]
    (while (and (> left 0) (>= (.depth (get blocks (cast i64 cursor))) depth))
      (set! cursor (.idom (get blocks (cast i64 (.header (get blocks (cast i64 cursor)))))))
      (set! left (- left 1)))
    (if (or (= left 0) (= (.depth (get blocks (cast i64 cursor))) 0))
        -1
        (.header (get blocks (cast i64 cursor))))))

;;; Depth of the innermost loop holding both positions; zero when none does.
(defn shared-depth [(blocks (slice Block)) (first i64) (second i64)] (-> i32)
  (let [a (block-at blocks first) b (block-at blocks second)]
    (if (or (< a 0) (< b 0))
        0
        (let [(mut la) (if (> (.depth (get blocks (cast i64 a))) 0) (.header (get blocks (cast i64 a))) -1)
              (mut lb) (if (> (.depth (get blocks (cast i64 b))) 0) (.header (get blocks (cast i64 b))) -1)]
          (while (and (>= la 0) (>= lb 0) (!= la lb))
            (let [da (.depth (get blocks (cast i64 la))) db (.depth (get blocks (cast i64 lb)))]
              (when (>= da db) (set! la (outer-loop blocks la)))
              (when (>= db da) (set! lb (outer-loop blocks lb)))))
          (if (and (>= la 0) (= la lb)) (.depth (get blocks (cast i64 la))) 0)))))
