; Prototype format follows dstogov/ir ir.h at 92171d0. See NOTICE.
(module stogir.prototype-bytes)
(import "stogir.types" :as types)
(import "stogir.call-groups" :as groups)
(import "coil.slice" :use [subslice])

(defn valid-bytes? [(bytes (slice u8))] (-> bool)
  (if (< (len bytes) 3)
      false
      (let [(mut valid?)
              (and (>= (len bytes) (+ 3 (cast i64 (get bytes 2))))
                   (types/valid? (cast i32 (get bytes 1))))
            (mut i) 3]
        (while (and valid? (< i (+ 3 (cast i64 (get bytes 2)))))
          (let [ty (get bytes i)]
            (when (or (= ty 0) (not (types/valid? (cast i32 ty))))
              (set! valid? false)))
          (set! i (+ i 1)))
        (and valid?
             (groups/valid-trailer? bytes
                                    (subslice bytes
                                              3
                                              (+ 3 (cast i64 (get bytes 2)))))))))
