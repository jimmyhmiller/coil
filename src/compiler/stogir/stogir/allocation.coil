;;; Owned split-interval state for linear-scan allocation.
(module stogir.allocation)
(import "stogir.split-position" :as split-position)
(import "stogir.interval" :as range)
(import "stogir.constraints" :as c)
(import "stogir.scan" :as scan)
(import "stogir.interval-queue" :as queue)
(import "stogir.frame" :as frame)
(import "stogir.fixed-uses" :as fixed)
(import "stogir.reserved-ranges" :as reserved)
(import "coil.result" :use [Result Ok Err])
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.primitive" :as primitive)

;;; Optional preferences do not constrain assignments. hint is an original part
;;; index; split children share hint-owner, whose last-register is advisory.
(defstruct Part
  [(ranges (ArrayList range/Range))
   (uses (ArrayList c/Use))
   (parent i32)
   (allowed u64)
   (register i32)
   (spill-slot i64)
   (preferred i32)
   (hint i32)
   (hint-owner i32)
   (last-register i32)])

(defn create [(parent i32) (allocator (dyn Allocator))] (-> Part)
  (Part
    :ranges (ArrayList::new [range/Range] allocator)
    :uses (ArrayList::new [c/Use] allocator)
    :parent parent
    :allowed 0xFFFFFFFFFFFFFFFF
    :register -1
    :spill-slot -1
    :preferred -1
    :hint -1
    :hint-owner -1
    :last-register -1))

;;; Position must be a legal split point selected by the allocator. A split in a
;;; lifetime hole is valid; constraints at the split belong to the suffix.
(defn split! [(part (ptr Part)) (position i64) (allocator (dyn Allocator))]
  (-> Part)
  (let [(mut child)
          (Part
            :ranges (range/split! (mut (.ranges part)) position allocator)
            :uses (ArrayList::new [c/Use] allocator)
            :parent (.parent part)
            :allowed (.allowed part)
            :register -1
            :spill-slot (.spill-slot part)
            :preferred (.preferred part)
            :hint (.hint part)
            :hint-owner (.hint-owner part)
            :last-register -1)
        (mut kept) 0
        (mut i) 0]
    (while (< i (len (.uses part)))
      (let [use (get (.uses part) i)]
        (if (>= (.position use) position)
            (push! (mut (.uses child)) use)
            (do (set! (mut (.uses part)) kept use) (set! kept (+ kept 1)))))
      (set! i (+ i 1)))
    (while (> (len (.uses part)) kept) (pop! (mut (.uses part))))
    child))

(defn release! [(part (ptr Part))] (-> void)
  (free! (mut (.ranges part)))
  (free! (mut (.uses part))))

;;; Find the split child owning a position, using lifetime ranges rather than
;;; bounding spans. Multiple children of a parent may share its spill slot.
(defn covers? [(part Part) (position i64)] (-> bool)
  (range/covers? (.ranges part) position))

;;; Cap register availability by future incompatible fixed uses, then choose the
;;; longest legal assignment. A returned boundary requires splitting before use.
(defn preferred-choice [(limits (ArrayList i64))
                        (position i64)
                        (end i64)
                        (allowed u64)
                        (required i32)
                        (preferred i32)] (-> scan/Choice)
  (if (and (>= preferred 0)
           (< (cast i64 preferred) (len limits))
           (< preferred 64)
           (!= (& allowed (<< (: 1 u64) (cast u64 preferred))) 0)
           (or (< required 0) (= required preferred))
           (> (get limits (cast i64 preferred)) position)
           (>= (get limits (cast i64 preferred)) end))
      (scan/Choice :register preferred :until (get limits (cast i64 preferred)))
      (scan/Choice :register -1 :until position)))

(defn extra-boundary? [(positions (slice i64)) (position i64)] (-> bool)
  (let [(mut lo) 0 (mut hi) (len positions)]
    (while (< lo hi)
      (let [mid (+ lo (/ (- hi lo) 2))]
        (if (< (get positions mid) position) (set! lo (+ mid 1)) (set! hi mid))))
    (and (< lo (len positions)) (= (get positions lo) position))))

;;; Hints never shorten an assignment or override real constraints. As upstream,
;;; try a register hint, then the source's recent register, only when available
;;; through the entire interval. Otherwise keep longest-available allocation.
;;; Scratch must not alias availability or any part storage. Contents are replaced.
(defn free-decision-with-limits! [(part Part)
                            (availability (ArrayList i64))
                            (position i64)
                            (allowed u64)
                            (source i32)
                            (boundary-step i64)
                            (extra-boundaries (slice i64))
                            (limits (mut (ArrayList i64)))] (-> scan/Choice)
  (clear! (mut limits))
  (let [(mut i) 0
        (mut best) (: -1 i32)
        (mut best-until) position
        mask (& allowed (.allowed part))
        required (c/required-at (.uses part) position)
        end (if (= (len (.ranges part)) 0) position
                (.end (get (.ranges part) (- (len (.ranges part)) 1))))
        fixed-limits (c/fixed-limits (.uses part) position)]
    (while (< i (len availability))
      (let [free (get availability i)
            fixed (c/summarized-register-limit fixed-limits (cast i32 i))
            until (if (< free fixed) free fixed)
            limit (if (and (< until end)
                           (not (extra-boundary? extra-boundaries until)))
                      (- until (% until boundary-step)) until)]
        ; A target may only lower general location changes at input boundaries.
        ; Round interference limits before choosing a register, so an illegal
        ; short assignment cannot win and later produce an unlowerable move.
        ; Complete assignments need no transfer and keep their original bound.
        (push! (mut limits) limit)
        ; Same ascending-register/strict-improvement policy as choose-free.
        ; Compute it while producing limits instead of rescanning the array.
        (when (and (< i 64)
                   (!= (& mask (<< (: 1 u64) (cast u64 i))) 0)
                   (or (< required 0) (= (cast i32 i) required))
                   (> limit best-until))
          (set! best (cast i32 i))
          (set! best-until limit)))
      (set! i (+ i 1)))
    (let [direct
            (preferred-choice limits
                              position
                              end
                              mask
                              required
                              (.preferred part))
          from-source
            (if (>= (.register direct) 0)
                direct
                (preferred-choice limits position end mask required source))
          choice
            (if (>= (.register from-source) 0)
                from-source
                (scan/Choice :register best :until best-until))]
      choice)))

;;; Solver-only decision: inspect admissible registers in ascending order without
;;; constructing limits for other register classes. Full-limit callers retain
;;; free-decision-with-limits!. Hints still require a complete assignment.
(defn free-decision-for-class [(part Part)
                               (availability (ArrayList i64))
                               (position i64) (allowed u64) (source i32)
                               (boundary-step i64) (extra-boundaries (slice i64))]
  (-> scan/Choice)
  (let [count (len availability)
        mask (& allowed (.allowed part))
        required (c/required-at (.uses part) position)
        end (if (= (len (.ranges part)) 0) position
                (.end (at (.ranges part) (- (len (.ranges part)) 1))))
        fixed-limits (c/fixed-limits (.uses part) position)
        (mut remaining) mask
        (mut best) (scan/Choice :register -1 :until position)
        (mut preferred) (scan/Choice :register -1 :until position)
        (mut hinted) (scan/Choice :register -1 :until position)]
    (when (>= required 0)
      (set! remaining (if (< required 64)
                           (& remaining (<< (: 1 u64) (cast u64 required)))
                           (: 0 u64))))
    (while (!= remaining 0)
      (let [i (cast i64 (primitive/ctz (cast u64 remaining)))]
        (set! remaining (& remaining (- remaining 1)))
        (when (< i count)
          (let [free (get availability i)
                fixed (if (= (cast i32 i) (.register fixed-limits))
                          (.other fixed-limits) (.first fixed-limits))
                until (if (< free fixed) free fixed)
                limit (if (and (< until end)
                               (not (extra-boundary? extra-boundaries until)))
                          (- until (% until boundary-step)) until)]
            (when (> limit (.until best))
              (set! best (scan/Choice :register (cast i32 i) :until limit)))
            (when (and (> limit position) (>= limit end))
              (when (= (cast i32 i) (.preferred part))
                (set! preferred (scan/Choice :register (cast i32 i) :until limit)))
              (when (= (cast i32 i) source)
                (set! hinted (scan/Choice :register (cast i32 i) :until limit))))))))
    (if (>= (.register preferred) 0) preferred
        (if (>= (.register hinted) 0) hinted best))))

;;; Compatibility entry owns its temporary storage. Allocator runs instead
;;; reuse one private buffer, cleared before every decision including retries.
(defn free-decision-at-boundaries [(part Part)
                            (availability (ArrayList i64))
                            (position i64) (allowed u64) (source i32)
                            (boundary-step i64) (extra-boundaries (slice i64))
                            (allocator (dyn Allocator))] (-> scan/Choice)
  (let [(mut limits) (ArrayList::new [i64] allocator)
        choice (free-decision-with-limits! part availability position allowed source
                                          boundary-step extra-boundaries (mut limits))]
    (free! (mut limits))
    choice))

(defn free-decision-hinted [(part Part)
                            (availability (ArrayList i64))
                            (position i64) (allowed u64) (source i32)
                            (allocator (dyn Allocator))] (-> scan/Choice)
  (free-decision-at-boundaries part availability position allowed source 1 [] allocator))

;;; Compatibility callers have no source hint; create supplies no preferred reg.
(defn free-decision [(part Part)
                     (availability (ArrayList i64))
                     (position i64)
                     (allowed u64)
                     (allocator (dyn Allocator))]
  (-> scan/Choice)
  (free-decision-hinted part availability position allowed -1 allocator))

;;; action: 0=spill current until its next required use, 1=evict register owners,
;;; 2=unsatisfiable simultaneous register requirements. No mutation occurs here.
(defstruct BlockedDecision [(action i32) (register i32) (next-use i64)])

;;; owner-next[reg] is the earliest required use among evictable owners;
;;; fixed-at[reg] is the next non-evictable interference position, or MAX_I64.
(defn blocked-decision [(part Part)
                        (owner-next (ArrayList i64))
                        (fixed-at (ArrayList i64))
                        (position i64)
                        (allowed u64)]
  (-> BlockedDecision)
  (let [required (c/required-at (.uses part) position)
        next (c/next-use (.uses part) position 1)
        current-next (if (< next 0) (: 0x7FFFFFFFFFFFFFFF i64) next)
        (mut best) (: -1 i32)
        (mut farthest) position
        (mut i) 0]
    (while (and (< i (len owner-next)) (< i 64))
      (when (and (!= (& (& allowed (.allowed part)) (<< (: 1 u64) (cast u64 i)))
                     0)
                 (or (< required 0) (= (cast i32 i) required))
                 (> (get fixed-at i) position))
        (let [use (get owner-next i)]
          (when (> use farthest) (set! best (cast i32 i)) (set! farthest use))))
      (set! i (+ i 1)))
    (if (and (>= best 0) (< current-next farthest))
        (BlockedDecision
          :action 1
          :register best
          :next-use farthest)
        (if (> current-next position)
            (BlockedDecision
              :action 0
              :register -1
              :next-use current-next)
            (BlockedDecision
              :action 2
              :register -1
              :next-use position)))))

;;; blocked-decision inside a loop, with loop depth as an estimate of frequency.
;;; costs[reg] is the deepest loop shared by position and an anchor of an
;;; evictable owner of reg (anchor-depth): evicting it costs a store or reload on
;;; every iteration of that loop, even when its next use in linear order is far
;;; (a use earlier in the loop body comes round again). The register cheapest
;;; by that measure is taken, the farthest next use deciding among equals; the
;;; current part is spilled instead when its own next use shares no deeper loop
;;; with position than the cheapest owner's anchors.
(defn blocked-decision-weighed [(part Part)
                                (owner-next (ArrayList i64))
                                (fixed-at (ArrayList i64))
                                (costs (ArrayList i32))
                                (position i64)
                                (allowed u64)
                                (blocks (slice split-position/Block))]
  (-> BlockedDecision)
  (let [required (c/required-at (.uses part) position)
        next (c/next-use (.uses part) position 1)
        current-next (if (< next 0) (: 0x7FFFFFFFFFFFFFFF i64) next)
        own (if (< next 0) (: 0 i32) (split-position/shared-depth blocks position next))
        (mut best) (: -1 i32)
        (mut best-cost) (: 0 i32)
        (mut farthest) position
        (mut i) 0]
    (while (and (< i (len owner-next)) (< i 64))
      (when (and (!= (& (& allowed (.allowed part)) (<< (: 1 u64) (cast u64 i)))
                     0)
                 (or (< required 0) (= (cast i32 i) required))
                 (> (get fixed-at i) position))
        (let [use (get owner-next i)
              cost (get costs i)]
          (when (and (> use position)
                     (or (< best 0) (< cost best-cost)
                         (and (= cost best-cost) (> use farthest))))
            (set! best (cast i32 i))
            (set! best-cost cost)
            (set! farthest use))))
      (set! i (+ i 1)))
    (if (and (>= best 0)
             (or (<= current-next position)
                 (< best-cost own)
                 (and (= best-cost own) (< current-next farthest))))
        (BlockedDecision :action 1 :register best :next-use farthest)
        (if (> current-next position)
            (BlockedDecision :action 0 :register -1 :next-use current-next)
            (BlockedDecision :action 2 :register -1 :next-use position)))))

;;; Fill costs for blocked-decision-weighed from the live assigned parts.
(defn owner-costs! [(parts (ArrayList Part)) (index i32) (live (ArrayList i32))
                    (position i64) (blocks (slice split-position/Block))
                    (costs (mut (ArrayList i32)))] (-> void)
  (let [here (split-position/block-at blocks position)
        limit (if (< here 0) (: 0 i32) (.depth (get blocks (cast i64 here))))]
    (for [i 0 (len costs)] (set! (mut costs) i 0))
    (for id live
      (let [owner (at parts (cast i64 id))
            reg (cast i64 (.register owner))]
        (when (and (!= id index) (>= (.parent owner) 0) (>= reg 0) (< reg (len costs))
                   (< (get costs reg) limit)
                   (range/covers? (.ranges owner) position))
          (let [cost (anchor-depth (load owner) position blocks limit)]
            (when (> cost (get costs reg)) (set! (mut costs) reg cost))))))))

;;; Assign a free register to the current part, splitting/requeueing its suffix
;;; when availability or a future fixed constraint ends before its final range.
;;; Returns false when no free assignment exists; caller then runs blocked policy.
(defn notify-split! [(events (ptr fixed/Index))
                     (part i32)
                     (child i32)
                     (cut i64)]
  (-> void)
  (when (!= (cast i64 events) 0)
    (unless (fixed/split! events part child cut)
      (panic "fixed-use split ownership update failed"))))

;;; Pinned ir_try_allocate_free_reg splits a partially available assignment
;;; after its last register use before the conflict, at the position chosen by
;;; ir_find_optimal_split_position, which moves the cut out to a loop's entry.
;;; Only fixed-register uses bound the cut here: ordinary register uses inside
;;; the loop are served by the suffix's own register, so a value crossing a
;;; call in a loop moves once at the loop entry instead of around every call.
;;; The cut moves only when that leaves the conflict's loop for a shallower
;;; block; otherwise the original availability boundary is kept. An odd block-end
;;; result becomes the following block start, an edge-resolved even boundary.
;;; With holes the loop entry is also looked for across lifetime holes
;;; (split-position/loop-entry).
(defn free-split-cut [(part Part) (start i64) (until i64)
                      (blocks (slice split-position/Block)) (holes bool)] (-> i64)
  (if (= (len blocks) 0)
      until
      (let [deep (split-position/block-at blocks until)]
        (if (or (< deep 0) (= (.depth (get blocks (cast i64 deep))) 0))
            until
            (let [last (c/last-use-before (.uses part) until 2)
                  floor (if (> last start) last start)
                  minimum (+ floor 1)]
              (if (>= minimum until)
                  until
                  (let [chosen (if holes
                                   (let [entry (split-position/loop-entry blocks (.ranges part) minimum until)]
                                     (if (< entry 0) minimum entry))
                                   (split-position/choose blocks (.ranges part) minimum until false))
                        source (split-position/block-at blocks chosen)
                        cut (+ chosen (% chosen 2))]
                    (if (and (>= source 0)
                             (> cut start)
                             (< cut until)
                             (< (.depth (get blocks (cast i64 source)))
                                (.depth (get blocks (cast i64 deep)))))
                        cut
                        until))))))))

(defn grant-free-impl! [(parts (mut (ArrayList Part)))
                           (unhandled (mut (ArrayList queue/Item)))
                           (index i32)
                           (availability (ArrayList i64))
                           (allowed u64)
                           (allocator (dyn Allocator))
                           (events (ptr fixed/Index))
                           (boundary-step i64)
                           (extra-boundaries (slice i64))
                           (limits (mut (ArrayList i64)))
                           (complete-limits? bool)
                           (split-blocks (slice split-position/Block))
                           (late Late) (holes bool)] (-> bool)
  (let [part (elem (mut parts) (cast i64 index))]
    (if (= (len (.ranges part)) 0)
        false
        (let [position (.start (get (.ranges part) 0))
              end (.end (get (.ranges part) (- (len (.ranges part)) 1)))
              source (if (and (>= (.hint part) 0)
                              (< (cast i64 (.hint part)) (len parts)))
                         (.last-register (at parts (cast i64 (.hint part)))) -1)
              usual (if complete-limits?
                        (free-decision-with-limits! (load part) availability position
                          allowed source boundary-step extra-boundaries (mut limits))
                        (free-decision-for-class (load part) availability position
                          allowed source boundary-step extra-boundaries))
              choice (late-choice (load part) availability position end allowed source
                                  boundary-step extra-boundaries usual late)]
          (if (< (.register choice) 0)
              false
              (do
                (set! (.register part) (.register choice))
                (when (< (.until choice) end)
                  (let [cut (free-split-cut (load part) position (.until choice) split-blocks holes)
                        child (split! part cut allocator)
                        child-index (cast i32 (len parts))]
                    (push! (mut parts) child)
                    (notify-split! events index child-index cut)
                    (let [suffix (at parts (cast i64 child-index))]
                      (when (> (len (.ranges suffix)) 0)
                        (queue/insert! (mut unhandled)
                                       (queue/Item
                                         :position
                                           (.start (get (.ranges suffix) 0))
                                         :interval child-index))))))
                true))))))

;;; Late assignment of avoided registers. A part starting before position whose
;;; usual choice is in mask instead takes the best register outside mask, when
;;; that one stays free until position (or the part's end); the part is then
;;; split there as for any shorter free range and the suffix allocated later.
;;; A shrink-wrapping target passes its preserved registers and first call, so
;;; values cross into preserved registers where a call first needs them rather
;;; than at their definition. Position -1 disables it.
(defstruct Late [(position i64) (mask u64)])

(defn no-late [] (-> Late) (Late :position -1 :mask 0))

;;; Optional allocation policies; plain-tuning is the pinned behavior.
;;; loop-reloads: reload a spilled value at the entry of the loop holding its
;;; next use (reload-cut). loop-evict-mask: registers whose holder may be
;;; evicted for a loop value (cold-owner); zero disables it.
;;; call-holes: a value whose best register a call clobbers, with no register
;;; free for its whole interval, keeps that register on both sides of the call
;;; and sits in its slot only at the clobber (call-hole!).
(defstruct Tuning [(late Late) (loop-reloads bool) (loop-evict-mask u64) (call-holes bool)])

(defn plain-tuning [] (-> Tuning)
  (Tuning :late (no-late) :loop-reloads false :loop-evict-mask 0 :call-holes false))

;;; Split around a call, after LLVM's split-around-call: when the best free
;;; register for the current part is clobbered by a call at an odd definition
;;; position u (a one-position reservation, the register otherwise free right
;;; after it) and no register lasts the part's interval, the part becomes
;;; [start, u) to be assigned that register now, [u, u+1) in its spill slot
;;; (stored at the call, as call transitions are lowered), and [u+1, end)
;;; queued preferring the same register. The value then leaves its register only
;;; where the call runs, instead of for the rest of its interval.
(defn call-hole! [(parts (mut (ArrayList Part))) (unhandled (mut (ArrayList queue/Item)))
                  (index i32) (free (ArrayList i64)) (allowed u64)
                  (boundary-step i64) (extra-boundaries (slice i64))
                  (frame (mut frame/Frame)) (shape SpillShape)
                  (events (ptr fixed/Index)) (allocator (dyn Allocator))]
  (-> (Result bool (slice u8)))
  (let [part (at parts (cast i64 index))]
    (if (= (len (.ranges part)) 0)
        (Ok false)
        (let [start (.start (at (.ranges part) 0))
              end (.end (at (.ranges part) (- (len (.ranges part)) 1)))
              usual (free-decision-for-class (load part) free start allowed -1
                                             boundary-step extra-boundaries)
              reg (.register usual)
              u (.until usual)
              ; The clobber: a one-position reservation of reg at u or u + 1
              ; (the limit is rounded down to an input boundary).
              (mut clobber) (: -1 i64)
              (mut blocked) false]
          (when (and (>= reg 0) (< u end) (> u start))
            (for [k 0 (len parts)]
              (let [other (at parts k)]
                (when (and (!= k (cast i64 index)) (= (.register other) reg)
                           (< (.parent other) 0) (= (len (.ranges other)) 1)
                           (= (.end (at (.ranges other) 0)) (+ (.start (at (.ranges other) 0)) 1))
                           (or (= (.start (at (.ranges other) 0)) u)
                               (= (.start (at (.ranges other) 0)) (+ u 1))))
                  (set! clobber (.start (at (.ranges other) 0))))))
            (when (>= clobber 0)
              (for [k 0 (len parts)]
                (let [other (at parts k)]
                  (when (and (!= k (cast i64 index)) (= (.register other) reg)
                             (not (and (< (.parent other) 0)
                                       (= (.start (at (.ranges other) 0)) clobber)))
                             (or (range/covers? (.ranges other) u)
                                 (range/covers? (.ranges other) clobber)
                                 (range/covers? (.ranges other) (+ clobber 1))))
                    (set! blocked true))))))
          (if (or (< clobber 0) blocked (>= (+ clobber 1) end)
                  (not (range/covers? (.ranges part) u))
                  (not (range/covers? (.ranges part) (+ clobber 1)))
                  (let [first (c/next-use (.uses part) u 0)]
                    (and (>= first 0) (<= first (+ clobber 1)))))
              (Ok false)
              (match (frame/spill-slot! (mut frame) (.parent part) (.size shape) (.alignment shape))
                (Err [message] (Err message))
                (Ok [slot]
                    (let [hole (split! (elem (mut parts) (cast i64 index)) u allocator)
                          hole-index (cast i32 (len parts))]
                      (push! (mut parts) hole)
                      (notify-split! events index hole-index u)
                      (let [after (split! (elem (mut parts) (cast i64 hole-index)) (+ clobber 1) allocator)
                            after-index (cast i32 (len parts))]
                        (push! (mut parts) after)
                        (notify-split! events hole-index after-index (+ clobber 1))
                        (let [middle (elem (mut parts) (cast i64 hole-index))]
                          (set! (.spill-slot middle) slot)
                          (set! (.register middle) -1))
                        (let [suffix (elem (mut parts) (cast i64 after-index))]
                          (set! (.spill-slot suffix) slot)
                          (set! (.preferred suffix) reg)
                          (when (> (len (.ranges suffix)) 0)
                            (queue/insert! (mut unhandled)
                                           (queue/Item :position (.start (at (.ranges suffix) 0))
                                                       :interval after-index))))
                        (Ok true))))))))))

;;; End position of the loop region holding position: the run of laid-out blocks
;;; from position's block with at least its loop depth. -1 outside loops.
(defn loop-window [(blocks (slice split-position/Block)) (position i64)] (-> i64)
  (let [at (split-position/block-at blocks position)]
    (if (or (< at 0) (= (.depth (get blocks (cast i64 at))) 0))
        -1
        (let [depth (.depth (get blocks (cast i64 at)))
              (mut cursor) (cast i64 at)]
          (while (and (< (+ cursor 1) (len blocks))
                      (>= (.depth (get blocks (+ cursor 1))) depth))
            (set! cursor (+ cursor 1)))
          (.end (get blocks cursor))))))

;;; Deepest loop shared by position and an anchor of part: its start, or a
;;; register use. A value defined or used in a loop is needed in a register on
;;; every iteration of it, so evicting the value at position costs a store or a
;;; reload at that loop's frequency. Stops at limit.
(defn anchor-depth [(part Part) (position i64) (blocks (slice split-position/Block))
                    (limit i32)] (-> i32)
  (let [(mut result) (if (= (len (.ranges part)) 0) (: 0 i32)
                         (split-position/shared-depth blocks (.start (at (.ranges part) 0)) position))
        (mut i) 0]
    (while (and (< i (len (.uses part))) (< result limit))
      (let [use (get (.uses part) i)]
        (when (>= (.kind use) 1)
          (let [depth (split-position/shared-depth blocks (.position use) position)]
            (when (> depth result) (set! result depth)))))
      (set! i (+ i 1)))
    result))

;;; Deepest block holding a register use of part strictly inside (position, end).
(defn use-depth [(part Part) (position i64) (end i64) (blocks (slice split-position/Block))]
  (-> i32)
  (let [(mut result) (: 0 i32)]
    (for use (.uses part)
      (when (and (>= (.kind use) 1) (> (.position use) position) (< (.position use) end))
        (let [at (split-position/block-at blocks (.position use))]
          (when (and (>= at 0) (> (.depth (get blocks (cast i64 at))) result))
            (set! result (.depth (get blocks (cast i64 at))))))))
    result))

;;; Spill-weight eviction for loops, after LLVM's greedy allocator: a part used
;;; inside a loop that no free register can carry through the loop (a call
;;; clobbers them) may take a register in mask from a holder with no register
;;; use for the rest of that loop. Holders are weighed by loop depth as an
;;; estimate of frequency: the holder must be anchored (anchor-depth) in a
;;; shallower loop than the part's deepest use in the window, and the holder
;;; anchored shallowest loses its register, so the cost lands where the code
;;; runs least. Among equals the farthest next register use is taken.
;;; Returns the holder's part index, or -1.
(defn cold-owner [(parts (ArrayList Part)) (index i32) (position i64)
                  (free (ArrayList i64)) (fixed-at (ArrayList i64))
                  (blocks (slice split-position/Block)) (allowed u64) (mask u64)]
  (-> i32)
  (let [part (at parts (cast i64 index))
        window (if (or (= mask 0) (= (len blocks) 0)) -1 (loop-window blocks position))
        end (if (= (len (.ranges part)) 0) position
                (.end (at (.ranges part) (- (len (.ranges part)) 1))))
        target (if (< window end) window end)
        next (c/next-use (.uses part) position 1)
        admissible (& allowed (.allowed part))]
    (if (or (< window 0) (<= target position) (< next 0) (>= next target)
            (>= (c/required-at (.uses part) position) 0))
        -1
        (let [(mut best-free) position]
          (for [i 0 (len free)]
            (when (and (< i 64) (!= (& admissible (<< (: 1 u64) (cast u64 i))) 0)
                       (> (get free i) best-free))
              (set! best-free (get free i))))
          (if (>= best-free target)
              -1
              (let [benefit (use-depth (load part) position target blocks)
                    (mut victim) (: -1 i32) (mut victim-next) (: -1 i64)
                    (mut victim-cost) benefit]
                (for [k 0 (len parts)]
                  (let [owner (at parts k)
                        reg (.register owner)]
                    (when (and (!= k (cast i64 index)) (>= (.parent owner) 0)
                               (>= reg 0) (< reg 64)
                               (!= (& (& mask admissible) (<< (: 1 u64) (cast u64 reg))) 0)
                               (< (cast i64 reg) (len fixed-at))
                               (>= (get fixed-at (cast i64 reg)) target)
                               (range/covers? (.ranges owner) position))
                      (let [use (c/next-use (.uses owner) position 1)
                            later (if (< use 0) (: 0x7FFFFFFFFFFFFFFF i64) use)]
                        (when (>= later target)
                          (let [cost (anchor-depth (load owner) position blocks victim-cost)]
                            (when (or (< cost victim-cost)
                                      (and (= cost victim-cost) (>= victim 0) (> later victim-next)))
                              (set! victim (cast i32 k))
                              (set! victim-cost cost)
                              (set! victim-next later))))))))
                victim))))))

(defn late-choice [(part Part) (availability (ArrayList i64)) (position i64) (end i64)
                   (allowed u64) (source i32) (boundary-step i64)
                   (extra-boundaries (slice i64)) (usual scan/Choice) (late Late)]
  (-> scan/Choice)
  (if (and (>= (.position late) 0)
           (< position (.position late))
           (>= (.register usual) 0)
           (< (.register usual) 64)
           (!= (& (.mask late) (<< (: 1 u64) (cast u64 (.register usual)))) 0))
      (let [early (free-decision-for-class part availability position
                                           (& allowed (^ (.mask late) (: 0xFFFFFFFFFFFFFFFF u64))) source
                                           boundary-step extra-boundaries)
            needed (if (< (.position late) end) (.position late) end)]
        (if (and (>= (.register early) 0) (>= (.until early) needed)) early usual))
      usual))

;;; Compatibility entry fills all limits, including inadmissible registers.
(defn grant-free-with-limits! [(parts (mut (ArrayList Part)))
                             (unhandled (mut (ArrayList queue/Item)))
                             (index i32) (availability (ArrayList i64))
                             (allowed u64) (allocator (dyn Allocator))
                             (events (ptr fixed/Index)) (boundary-step i64)
                             (extra-boundaries (slice i64))
                             (limits (mut (ArrayList i64)))] (-> bool)
  (grant-free-impl! (mut parts) (mut unhandled) index availability allowed
    allocator events boundary-step extra-boundaries (mut limits) true [] (no-late) false))

;;; Compatibility path retains call-scoped ownership of decision scratch.
(defn grant-free-at-boundaries! [(parts (mut (ArrayList Part)))
                           (unhandled (mut (ArrayList queue/Item)))
                           (index i32) (availability (ArrayList i64))
                           (allowed u64) (allocator (dyn Allocator))
                           (events (ptr fixed/Index)) (boundary-step i64)
                           (extra-boundaries (slice i64))] (-> bool)
  (let [(mut limits) (ArrayList::new [i64] allocator)
        result (grant-free-with-limits! (mut parts) (mut unhandled) index availability
                   allowed allocator events boundary-step extra-boundaries (mut limits))]
    (free! (mut limits))
    result))

;;; Where a spilled part's register suffix begins. As pinned ir_ra.c applies
;;; ir_find_optimal_split_position to the split before a blocked interval's next
;;; use, a next use inside a loop the spill is not in reloads at that loop's
;;; entry (the end of its preheader) rather than at the use, so the value enters
;;; every iteration in a register instead of being reloaded in each. The cut
;;; moves only when it leaves the use's loop for a shallower block; an odd
;;; block-end becomes the following block start, an edge-resolved boundary.
;;; Empty blocks keep the cut at the use. The cut never precedes floor, the
;;; allocator's current position (an evicted owner's prefix starts earlier).
;;; The entry is looked for across lifetime holes; when the value is not live
;;; at it, the cut stays at the use.
(defn reload-cut [(part Part) (start i64) (next i64) (floor i64)
                  (blocks (slice split-position/Block))]
  (-> i64)
  (let [minimum (if (> floor (+ start 1)) floor (+ start 1))]
  (if (or (= (len blocks) 0) (<= next minimum))
      next
      (let [deep (split-position/block-at blocks next)]
        (if (or (< deep 0) (= (.depth (get blocks (cast i64 deep))) 0))
            next
            (let [chosen (split-position/loop-entry blocks (.ranges part) minimum next)
                  cut (+ chosen (% chosen 2))
                  source (if (< chosen 0) -1 (split-position/block-at blocks chosen))]
              (if (and (>= source 0) (>= chosen minimum) (> cut start) (< cut next)
                       (< (.depth (get blocks (cast i64 source)))
                          (.depth (get blocks (cast i64 deep)))))
                  cut
                  next)))))))

;;; Spill only a prefix containing no register-required use. The suffix is queued
;;; for reassignment at its next required position (or the loop entry before it,
;;; see reload-cut), preserving parent slot identity.
(defn spill-prefix-tracked! [(parts (mut (ArrayList Part)))
                             (unhandled (mut (ArrayList queue/Item)))
                             (index i32)
                             (frame (mut frame/Frame))
                             (size i64)
                             (alignment i64)
                             (allocator (dyn Allocator))
                             (events (ptr fixed/Index))
                             (reload-blocks (slice split-position/Block))
                             (floor i64)]
  (-> (Result i64 (slice u8)))
  (let [part (elem (mut parts) (cast i64 index))]
    (if (= (len (.ranges part)) 0)
        (Err "cannot spill empty interval")
        (let [start (.start (get (.ranges part) 0))
              end (.end (get (.ranges part) (- (len (.ranges part)) 1)))
              next (c/next-use (.uses part) start 1)]
          (if (= next start)
              (Err "cannot spill at required register use")
              (match (frame/spill-slot! (mut frame)
                                        (.parent part)
                                        size
                                        alignment)
                (Err [msg] (Err msg))
                (Ok [slot]
                    (do
                      (set! (.spill-slot part) slot)
                      (set! (.register part) -1)
                      (when (and (> next start) (< next end))
                        (let [cut (reload-cut (load part) start next floor reload-blocks)
                              child (split! part cut allocator)
                              child-index (cast i32 (len parts))]
                          (push! (mut parts) child)
                          (notify-split! events index child-index cut)
                          (let [suffix (at parts (cast i64 child-index))]
                            (when (> (len (.ranges suffix)) 0)
                              (queue/insert! (mut unhandled)
                                             (queue/Item
                                               :position
                                                 (.start (get (.ranges suffix)
                                                              0))
                                               :interval child-index))))))
                      (Ok slot)))))))))

;;; Evict one assigned part at a legal position. Inactive intervals resume at
;;; their next range start; active suffixes spill until their next required use.
(defn evict-tracked! [(parts (mut (ArrayList Part)))
                      (unhandled (mut (ArrayList queue/Item)))
                      (index i32)
                      (position i64)
                      (frame (mut frame/Frame))
                      (size i64)
                      (alignment i64)
                      (allocator (dyn Allocator))
                      (events (ptr fixed/Index))
                      (reload-blocks (slice split-position/Block))
                      (floor i64)] (-> (Result i32 (slice u8)))
  (let [part (elem (mut parts) (cast i64 index))]
    (if (or (= (len (.ranges part)) 0) (< (.register part) 0))
        (Err "eviction requires an assigned interval")
        (let [start (.start (get (.ranges part) 0))
              end (.end (get (.ranges part) (- (len (.ranges part)) 1)))
              next (c/next-use (.uses part) position 1)]
          (if (or (< position start) (>= position end) (= next position))
              (Err "illegal eviction point or simultaneous register use")
              (if (or (= position start)
                      (let [first (c/next-use (.uses part) start 0)]
                        (or (< first 0) (>= first position))))
                  ; Upstream ir_ra.c:ir_allocate_blocked_reg uses child=other when
                  ; there is no earlier use. A register-only prefix has no
                  ; observable assignment to preserve, even if its range starts
                  ; earlier. Include location-allowed uses: they may have read
                  ; the assigned register before the eviction point.
                  (match (spill-prefix-tracked! (mut parts)
                                                (mut unhandled)
                                                index
                                                (mut frame)
                                                size
                                                alignment
                                                allocator
                                                events
                                                reload-blocks
                                                floor)
                    (Err [message] (Err message))
                    (Ok [_] (Ok index)))
                  (match (frame/spill-slot! (mut frame)
                                            (.parent part)
                                            size
                                            alignment)
                    (Err [msg] (Err msg))
                    (Ok [slot]
                        (do
                          (set! (.spill-slot part) slot)
                          (let [child (split! part position allocator)
                                child-index (cast i32 (len parts))]
                            (push! (mut parts) child)
                            (notify-split! events index child-index position)
                            (let [suffix (at parts (cast i64 child-index))
                                  first (.start (get (.ranges suffix) 0))]
                              (if (> first position)
                                  (do
                                    (queue/insert! (mut unhandled)
                                                   (queue/Item
                                                     :position first
                                                     :interval child-index))
                                    (Ok child-index))
                                  (match (spill-prefix-tracked! (mut parts)
                                                                (mut unhandled)
                                                                child-index
                                                                (mut frame)
                                                                size
                                                                alignment
                                                                allocator
                                                                events
                                                                reload-blocks
                                                                floor)
                                    (Err [msg] (Err msg))
                                    (Ok [_] (Ok child-index)))))))))))))))

(defn grant-free-tracked! [(parts (mut (ArrayList Part)))
                           (unhandled (mut (ArrayList queue/Item)))
                           (index i32) (availability (ArrayList i64))
                           (allowed u64) (allocator (dyn Allocator))
                           (events (ptr fixed/Index))] (-> bool)
  (grant-free-at-boundaries! (mut parts) (mut unhandled) index availability
                             allowed allocator events 1 []))

;;; Compatibility entry points have no external event index to maintain.
(defn grant-free! [(parts (mut (ArrayList Part)))
                   (unhandled (mut (ArrayList queue/Item)))
                   (index i32)
                   (availability (ArrayList i64))
                   (allowed u64)
                   (allocator (dyn Allocator))] (-> bool)
  (grant-free-tracked! (mut parts)
                       (mut unhandled)
                       index
                       availability
                       allowed
                       allocator
                       (cast (ptr fixed/Index) 0)))

(defn spill-prefix! [(parts (mut (ArrayList Part)))
                     (unhandled (mut (ArrayList queue/Item)))
                     (index i32)
                     (area (mut frame/Frame))
                     (size i64)
                     (alignment i64)
                     (allocator (dyn Allocator))] (-> (Result i64 (slice u8)))
  (spill-prefix-tracked! (mut parts)
                         (mut unhandled)
                         index
                         (mut area)
                         size
                         alignment
                         allocator
                         (cast (ptr fixed/Index) 0)
                         []
                         -1))

(defn evict! [(parts (mut (ArrayList Part)))
              (unhandled (mut (ArrayList queue/Item)))
              (index i32)
              (position i64)
              (area (mut frame/Frame))
              (size i64)
              (alignment i64)
              (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (evict-tracked! (mut parts)
                  (mut unhandled)
                  index
                  position
                  (mut area)
                  size
                  alignment
                  allocator
                  (cast (ptr fixed/Index) 0)
                  []
                  -1))

(defstruct Pressure
  [(free (ArrayList i64))
   (next-use (ArrayList i64))
   (fixed-at (ArrayList i64))])

;;; Include unhandled fixed constraints so early allocations cannot occupy a
;;; register needed by a later ABI definition/use. Physical IDs may span classes;
;;; per-part masks prevent assignment across classes.
(defn pressure [(parts (ArrayList Part))
                (index i32)
                (register-count i32)
                (allocator (dyn Allocator))] (-> Pressure)
  (let [(mut result)
          (Pressure
            :free (ArrayList::new [i64] allocator)
            :next-use (ArrayList::new [i64] allocator)
            :fixed-at (ArrayList::new [i64] allocator))
        current (at parts (cast i64 index))
        position (.start (get (.ranges current) 0))
        (mut i) (: 0 i32)]
    (while (< i register-count)
      (push! (mut (.free result)) 0x7FFFFFFFFFFFFFFF)
      (push! (mut (.next-use result)) 0x7FFFFFFFFFFFFFFF)
      (push! (mut (.fixed-at result)) 0x7FFFFFFFFFFFFFFF)
      (set! i (+ i 1)))
    (let [(mut j) 0]
      (while (< j (len parts))
        (when (!= j (cast i64 index))
          (let [other (at parts j)
                reg (.register other)]
            (when (>= reg 0)
              (let [hit
                      (range/intersection (.ranges current)
                                          (.ranges other)
                                          position)
                    next (c/next-use (.uses other) position 1)]
                (when (>= hit 0)
                  (when (< hit (get (.free result) (cast i64 reg)))
                    (set! (mut (.free result)) (cast i64 reg) hit))
                  (when (and (< (.parent other) 0) (= hit position))
                    (set! (mut (.fixed-at result)) (cast i64 reg) position))
                  (when (and (>= next 0)
                             (< next (get (.next-use result) (cast i64 reg))))
                    (set! (mut (.next-use result)) (cast i64 reg) next)))))
            (for use (.uses other)
              (when (and (= (.kind use) 2)
                         (>= (.position use) position)
                         (range/covers? (.ranges current) (.position use)))
                (let [r (cast i64 (.register use))]
                  (when (< (.position use) (get (.fixed-at result) r))
                    (set! (mut (.fixed-at result)) r (.position use)))
                  (when (< (.position use) (get (.free result) r))
                    (set! (mut (.free result)) r (.position use))))))))
        (set! j (+ j 1))))
    result))

;;; The solver only removes/moves existing uses when splitting, and appends
;;; children. Existing part IDs remain stable. This index is a conservative
;;; superset: an indexed prefix may lose its last fixed use without removal.
(defstruct PressureIndex [(known i64) (parts (ArrayList i32))])

(defn refresh-pressure! [(fixed (mut PressureIndex)) (parts (ArrayList Part))]
  (-> void)
  (for [i (.known fixed) (len parts)]
    (let [(mut found) false]
      (for use (.uses (at parts i))
        (when (= (.kind use) 2) (set! found true)))
      (when found (push! (mut (.parts fixed)) (cast i32 i)))))
  (set! (.known fixed) (len parts)))

;;; Reusable per-register arrays. All three arrays have the requested length.
(defn pressure-buffer [(register-count i32) (allocator (dyn Allocator))]
  (-> Pressure)
  (let [(mut result)
          (Pressure
            :free (ArrayList::new [i64] allocator)
            :next-use (ArrayList::new [i64] allocator)
            :fixed-at (ArrayList::new [i64] allocator))]
    (for [i 0 (cast i64 register-count)]
      (push! (mut (.free result)) 0x7FFFFFFFFFFFFFFF)
      (push! (mut (.next-use result)) 0x7FFFFFFFFFFFFFFF)
      (push! (mut (.fixed-at result)) 0x7FFFFFFFFFFFFFFF))
    result))

;;; Same decision as pressure. The caller supplies equal-sized arrays covering
;;; the validated register domain and refreshes fixed after appending children.
;;; Clear every entry so no prior query contributes a constraint or next use.
(defn clear-pressure! [(result (mut Pressure))] (-> void)
  (for [i 0 (len (.free result))]
    (set! (mut (.free result)) i 0x7FFFFFFFFFFFFFFF)
    (set! (mut (.next-use result)) i 0x7FFFFFFFFFFFFFFF)
    (set! (mut (.fixed-at result)) i 0x7FFFFFFFFFFFFFFF)))

(defn assigned-pressure! [(parts (ArrayList Part))
                          (index i32)
                          (result (mut Pressure))] (-> void)
  (let [current (at parts (cast i64 index))
        position (.start (get (.ranges current) 0))]
    (clear-pressure! (mut result))
    (for [j 0 (len parts)]
      (when (!= j (cast i64 index))
        (let [other (at parts j)
              reg (.register other)]
          (when (>= reg 0)
            (let [hit
                    (range/intersection (.ranges current)
                                        (.ranges other)
                                        position)]
              (when (>= hit 0)
                (let [next (c/next-use (.uses other) position 1)]
                  (when (< hit (get (.free result) (cast i64 reg)))
                    (set! (mut (.free result)) (cast i64 reg) hit))
                  (when (and (< (.parent other) 0) (= hit position))
                    (set! (mut (.fixed-at result)) (cast i64 reg) position))
                  (when (and (>= next 0)
                             (< next (get (.next-use result) (cast i64 reg))))
                    (set! (mut (.next-use result)) (cast i64 reg) next)))))))))))

;;; Only canonical immutable physical reservations use the static range tree.
;;; All other assignments retain exact range/next-use handling in the live set.
(defstruct AssignedIndex
  [(physical reserved/Index)
   (live (ArrayList i32))
   (present (ArrayList bool))
   (last i64)])

(defn empty-assigned [(a (dyn Allocator))] (-> AssignedIndex)
  (AssignedIndex
    :physical (reserved/empty a)
    :live (ArrayList::new [i32] a)
    :present (ArrayList::new [bool] a)
    :last -1))

(defn release-assigned! [(state (mut AssignedIndex))] (-> void)
  (reserved/release! (mut (.physical state)))
  (free! (mut (.live state)))
  (free! (mut (.present state))))

(defn canonical-reservation? [(part Part)] (-> bool)
  (and (< (.parent part) 0)
       (>= (.register part) 0)
       (= (len (.ranges part)) 1)
       (= (len (.uses part)) 1)
       (= (.kind (at (.uses part) 0)) 2)
       (= (.register (at (.uses part) 0)) (.register part))
       (= (.position (at (.uses part) 0)) (.start (at (.ranges part) 0)))))

(defn assigned-index [(parts (ArrayList Part))
                      (registers i32)
                      (a (dyn Allocator))]
  (-> (Result AssignedIndex (slice u8)))
  (let [(mut state) (empty-assigned a)
        (mut entries) (ArrayList::new [reserved/Reservation] a)]
    (reserve! (mut (.present state)) (len parts))
    (for [i 0 (len parts)]
      (let [part (at parts i)
            assigned (and (>= (.register part) 0) (> (len (.ranges part)) 0))]
        (push! (mut (.present state)) assigned)
        (when assigned
          (if (canonical-reservation? (load part))
              (push! (mut entries)
                     (reserved/Reservation
                       :start (.start (at (.ranges part) 0))
                       :end (.end (at (.ranges part) 0))
                       :register (.register part)
                       :owner (cast i32 i)))
              (push! (mut (.live state)) (cast i32 i))))))
    (let [built (reserved/create (len parts) registers (slice entries) a)]
      (free! (mut entries))
      (match built
        (Err [message] (release-assigned! (mut state)) (Err message))
        (Ok [index]
            (reserved/release! (mut (.physical state)))
            (set! (.physical state) index)
            (Ok state))))))

(defn note-assigned! [(state (mut AssignedIndex)) (part i32)] (-> void)
  (while (<= (len (.present state)) (cast i64 part))
    (push! (mut (.present state)) false))
  (unless (get (.present state) (cast i64 part))
    (set! (mut (.present state)) (cast i64 part) true)
    (push! (mut (.live state)) part)))

;;; Registers 64 and above are never admissible (validate-input).
(defn in-mask? [(mask u64) (reg i64)] (-> bool)
  (and (< reg 64) (!= (& mask (<< (: 1 u64) (cast u64 reg))) 0)))

;;; Query positions advance monotonically, including repeated post-eviction
;;; queries at the same point. Holes remain live until the final range expires.
(defn assigned-indexed-pressure! [(parts (ArrayList Part))
                                  (index i32)
                                  (state (mut AssignedIndex))
                                  (result (mut Pressure))
                                  (mask u64)]
  (-> bool)
  (let [current (at parts (cast i64 index))]
    (if (= (len (.ranges current)) 0)
        false
        (let [position (.start (at (.ranges current) 0))]
          (if (< position (.last state))
              false
              (do
                (set! (.last state) position)
                (reserved/advance! (mut (.physical state)) position)
                (clear-pressure! (mut result))
                ; Ranges are sorted and disjoint. A reservation meeting a later
                ; range but starting earlier also meets this one, so the first
                ; range with a hit (and settled next use) fixes this register.
                (for [reg 0 (len (.free result))]
                  (when (and (in-mask? mask reg)
                             (reserved/has-register? (.physical state) (cast i32 reg)))
                    (let [ranges (.ranges current)
                          (mut k) (: 0 i64)]
                      (while (< k (len ranges))
                        (let [r (at ranges k)
                              found
                                (reserved/first-advanced (.physical state)
                                                (cast i32 reg)
                                                0
                                                (.start r)
                                                (.end r)
                                                index)]
                          (set! k (+ k 1))
                          (when (>= found 0)
                            (let [start
                                    (.position (at (.events (.physical state))
                                                   found))
                                  hit (if (> start (.start r)) start (.start r))]
                              (when (< hit (get (.free result) reg))
                                (set! (mut (.free result)) reg hit))
                              (when (= hit position)
                                (set! (mut (.fixed-at result)) reg position))
                              (if (>= start position)
                                  (do
                                    (when (< start (get (.next-use result) reg))
                                      (set! (mut (.next-use result)) reg start))
                                    (set! k (len ranges)))
                                  (let [next
                                          (reserved/first-advanced (.physical state)
                                                          (cast i32 reg)
                                                          position
                                                          (.start r)
                                                          (.end r)
                                                          index)]
                                    (when (>= next 0)
                                      (let [use
                                              (.position (at (.events (.physical state))
                                                             next))]
                                        (when (< use (get (.next-use result) reg))
                                          (set! (mut (.next-use result)) reg use))
                                        (set! k (len ranges)))))))))))))
                (let [(mut kept) 0]
                  (for [j 0 (len (.live state))]
                    (let [id (get (.live state) j)
                          other (at parts (cast i64 id))
                          reg (.register other)
                          count (len (.ranges other))]
                      (if (and (>= reg 0)
                               (> count 0)
                               (> (.end (at (.ranges other) (- count 1)))
                                  position))
                          (do
                            (set! (mut (.live state)) kept id)
                            (set! kept (+ kept 1))
                            (when (and (!= id index) (in-mask? mask (cast i64 reg)))
                              (let [hit
                                      (range/intersection (.ranges current)
                                                          (.ranges other)
                                                          position)]
                                (when (>= hit 0)
                                  (let [next
                                          (c/next-use (.uses other) position 1)]
                                    (when (< hit
                                             (get (.free result) (cast i64 reg)))
                                      (set! (mut (.free result))
                                            (cast i64 reg)
                                            hit))
                                    (when (and (< (.parent other) 0) (= hit position))
                                      (set! (mut (.fixed-at result)) (cast i64 reg) position))
                                    (when (and (>= next 0)
                                               (< next
                                                  (get (.next-use result)
                                                       (cast i64 reg))))
                                      (set! (mut (.next-use result))
                                            (cast i64 reg)
                                            next)))))))
                          (set! (mut (.present state)) (cast i64 id) false))))
                  (set! (.len (.live state)) kept))
                true))))))

(defn pressure-into! [(parts (ArrayList Part))
                      (index i32)
                      (fixed PressureIndex)
                      (result (mut Pressure))] (-> void)
  (assigned-pressure! parts index (mut result))
  (let [current (at parts (cast i64 index))
        position (.start (get (.ranges current) 0))]
    (for j (.parts fixed)
      (when (!= j index)
        (let [other (at parts (cast i64 j))]
          (for use (.uses other)
            (when (and (= (.kind use) 2)
                       (>= (.position use) position)
                       (range/covers? (.ranges current) (.position use)))
              (let [r (cast i64 (.register use))]
                (when (< (.position use) (get (.fixed-at result) r))
                  (set! (mut (.fixed-at result)) r (.position use)))
                (when (< (.position use) (get (.free result) r))
                  (set! (mut (.free result)) r (.position use)))))))))))

(defn event-index [(parts (ArrayList Part))
                   (registers i32)
                   (allocator (dyn Allocator))]
  (-> (Result fixed/Index (slice u8)))
  (let [(mut events) (ArrayList::new [fixed/Event] allocator)]
    (for [i 0 (len parts)]
      (for use (.uses (at parts i))
        (when (= (.kind use) 2)
          (push! (mut events)
                 (fixed/Event
                   :position (.position use)
                   :register (.register use)
                   :owner (cast i32 i))))))
    (let [result (fixed/create (len parts) registers (slice events) allocator)]
      (free! (mut events))
      result)))

(defn fixed-pressure! [(parts (ArrayList Part))
                       (index i32)
                       (events (mut fixed/Index))
                       (result (mut Pressure))
                       (mask u64)]
  (-> void)
  ; Hits in later sorted ranges are later positions: stop at the first one.
  (for [reg 0 (len (.free result))]
    (when (and (in-mask? mask reg) (fixed/has-register? events (cast i32 reg)))
      (let [ranges (.ranges (at parts (cast i64 index)))
            (mut k) (: 0 i64)]
        (while (< k (len ranges))
          (let [r (at ranges k)
                hit
                  (fixed/first-other! (mut events)
                                      (cast i32 reg)
                                      (.start r)
                                      (.end r)
                                      index)]
            (set! k (+ k 1))
            (when (>= hit 0)
              (when (< hit (get (.fixed-at result) reg))
                (set! (mut (.fixed-at result)) reg hit))
              (when (< hit (get (.free result) reg))
                (set! (mut (.free result)) reg hit))
              (set! k (len ranges)))))))))

(defn pressure-events-into! [(parts (ArrayList Part))
                             (index i32)
                             (events (mut fixed/Index))
                             (result (mut Pressure))] (-> void)
  (assigned-pressure! parts index (mut result))
  (fixed-pressure! parts index (mut events) (mut result) 0xFFFFFFFFFFFFFFFF))

;;; Pressure for the registers in mask; the others stay cleared. The solver
;;; reads only registers admissible for the current value.
(defn pressure-class-into! [(parts (ArrayList Part))
                            (index i32)
                            (events (mut fixed/Index))
                            (state (mut AssignedIndex))
                            (result (mut Pressure))
                            (mask u64)] (-> bool)
  (if (assigned-indexed-pressure! parts index (mut state) (mut result) mask)
      (do (fixed-pressure! parts index (mut events) (mut result) mask) true)
      false))

(defn pressure-state-into! [(parts (ArrayList Part))
                            (index i32)
                            (events (mut fixed/Index))
                            (state (mut AssignedIndex))
                            (result (mut Pressure))] (-> bool)
  (pressure-class-into! parts index (mut events) (mut state) (mut result)
                        0xFFFFFFFFFFFFFFFF))

;;; Owned compatibility result; the solver uses one buffer for its whole run.
(defn pressure-indexed [(parts (ArrayList Part))
                        (index i32)
                        (register-count i32)
                        (fixed PressureIndex)
                        (allocator (dyn Allocator))] (-> Pressure)
  (let [(mut result) (pressure-buffer register-count allocator)]
    (pressure-into! parts index fixed (mut result))
    result))

(defn release-pressure! [(pressure (mut Pressure))] (-> void)
  (free! (mut (.free pressure)))
  (free! (mut (.next-use pressure)))
  (free! (mut (.fixed-at pressure))))

(defn register-allowed? [(register i32) (register-count i32) (allowed u64)]
  (-> bool)
  (and (>= register 0)
       (< register register-count)
       (< register 64)
       (!= (& allowed (<< (: 1 u64) (cast u64 register))) 0)))

;;; Validate register IDs before pressure indexes fixed/assigned locations.
;;; Class masks are immutable for a value and copied into every split suffix.
(defn validate-input [(parts (ArrayList Part))
                      (register-count i32)
                      (allowed u64)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut count) (: 0 i32)]
    (if (or (<= register-count 0) (> register-count 64))
        (set! error "invalid physical register count")
        (let [target-mask
                (if (= register-count 64)
                    (: 0xFFFFFFFFFFFFFFFF u64)
                    (- (<< (: 1 u64) (cast u64 register-count)) 1))]
          (for part parts
            (when (> (len (.ranges part)) 0)
              (let [mask (& (& allowed target-mask) (.allowed part))]
                (when (= mask 0)
                  (set! error "interval has no admissible target register"))
                (when (and (>= (.register part) 0)
                           (not (register-allowed? (.register part)
                                                   register-count
                                                   mask)))
                  (set! error "preassigned register violates interval class"))
                (for use (.uses part)
                  (when (and (= (.kind use) 2)
                             (not (register-allowed? (.register use)
                                                     register-count
                                                     mask)))
                    (set! error "fixed register violates interval class"))))
              (set! count (+ count 1))))))
    (if (= error "") (Ok count) (Err error))))

;;; Immutable spill geometry indexed by the virtual parent's identifier.
;;; Physical reservations have negative parents and need no storage shape.
(defstruct SpillShape [(size i64) (alignment i64)])

(defn valid-shape? [(shape SpillShape)] (-> bool)
  (and (> (.size shape) 0) (frame/valid-alignment? (.alignment shape))))

(defn shape-of [(parent i32) (shapes (slice SpillShape)) (uniform SpillShape)]
  (-> SpillShape)
  (if (= (len shapes) 0)
      uniform
      (if (and (>= parent 0) (< (cast i64 parent) (len shapes)))
          (get shapes (cast i64 parent))
          (SpillShape :size 0 :alignment 0))))

;;; Active eviction may shorten an already assigned prefix, but never move
;;; a past operand use or enqueue a required use behind the scan cursor.
;;; With holes the loop entry is also looked for across lifetime holes.
(defn active-eviction-cut [(part Part) (position i64)
                            (blocks (slice split-position/Block)) (holes bool)] (-> i64)
  (if (= (len blocks) 0) position
      (let [(mut lo) 0 (mut hi) (len (.uses part))]
        (while (< lo hi)
          (let [mid (+ lo (/ (- hi lo) 2))]
            (if (< (.position (get (.uses part) mid)) position)
                (set! lo (+ mid 1)) (set! hi mid))))
        (if (= lo 0) position
            (let [minimum (+ (.position (get (.uses part) (- lo 1))) 1)
                  start (.start (get (.ranges part) 0))]
              (if (or (<= minimum start) (>= minimum position)) position
                  (if holes
                      (let [entry (split-position/loop-entry blocks (.ranges part) minimum position)]
                        (if (< entry 0) position entry))
                      (split-position/choose blocks (.ranges part) minimum position true))))))))

;;; Allocate physical registers restricted by each value's admissible class mask.
;;; Input parts are unassigned except reservations. Shapes are immutable per
;;; parent, so splitting and eviction always consult the owning value.
(defn run-impl! [(parts (mut (ArrayList Part)))
                 (frame (mut frame/Frame))
                 (register-count i32)
                 (allowed u64)
                 (shapes (slice SpillShape))
                 (uniform SpillShape)
                 (boundary-step i64)
                 (extra-boundaries (slice i64))
                 (split-blocks (slice split-position/Block))
                 (tuning Tuning)
                 (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [late (.late tuning)
        reload-blocks (if (.loop-reloads tuning) split-blocks [])
        (mut work) (ArrayList::new [queue/Item] allocator)
        (mut limits) (ArrayList::new [i64] allocator)
        (mut events) (fixed/empty allocator)
        (mut assigned) (empty-assigned allocator)
        (mut summary) (pressure-buffer 0 allocator)
        (mut costs) (ArrayList::new [i32] allocator)
        (mut error) ""
        (mut i) 0
        (mut processed) (: 0 i32)]
    (match (validate-input parts register-count allowed)
      (Err [message] (set! error message))
      (Ok [_] 0))
    (for part parts
      (when (and (>= (.parent part) 0) (> (len (.ranges part)) 0))
        (let [shape (shape-of (.parent part) shapes uniform)]
          (when (not (valid-shape? shape))
            (set! error "missing or invalid parent spill shape")))))
    (while (and (= error "") (< i (len parts)))
      (let [part (at parts i)]
        (when (and (> (len (.ranges part)) 0) (< (.register part) 0))
          (queue/insert! (mut work)
                         (queue/Item
                           :position (.start (get (.ranges part) 0))
                           :interval (cast i32 i)))))
      (set! i (+ i 1)))
    (when (and (= error "") (> (len work) 0))
      (release-pressure! (mut summary))
      (set! summary (pressure-buffer register-count allocator))
      (for [k 0 (cast i64 register-count)] (push! (mut costs) 0))
      (match (event-index parts register-count allocator)
        (Err [message] (set! error message))
        (Ok [built]
            (fixed/release! (mut events))
            (set! events built)))
      (when (= error "")
        (match (assigned-index parts register-count allocator)
          (Err [message] (set! error message))
          (Ok [built]
              (release-assigned! (mut assigned))
              (set! assigned built)))))
    (while (and (= error "") (> (len work) 0))
      (match (queue/take! (mut work))
        (None [] 0)
        (Some [item]
              (let [index (.interval item)
                    position (.position item)]
                (unless (pressure-class-into! parts
                                              index
                                              (mut events)
                                              (mut assigned)
                                              (mut summary)
                                              (& allowed
                                                 (.allowed (at parts (cast i64 index)))))
                  (set! error "allocator pressure query moved backwards"))
                (when (and (= error "") (.call-holes tuning))
                  (let [shape (shape-of (.parent (at parts (cast i64 index))) shapes uniform)]
                    (match (call-hole! (mut parts) (mut work) index (.free summary)
                                       (& allowed (.allowed (at parts (cast i64 index))))
                                       boundary-step extra-boundaries (mut frame) shape
                                       (cast (ptr fixed/Index) (mut events)) allocator)
                      (Err [msg] (set! error msg))
                      (Ok [_] 0))))
                (when (and (= error "") (!= (.loop-evict-mask tuning) 0))
                  (let [victim (cold-owner parts index position (.free summary) (.fixed-at summary)
                                           split-blocks allowed (.loop-evict-mask tuning))]
                    (when (>= victim 0)
                      (let [owner-shape (shape-of (.parent (at parts (cast i64 victim))) shapes uniform)]
                        (match (evict-tracked! (mut parts) (mut work) victim
                                               (active-eviction-cut (load (at parts (cast i64 victim))) position split-blocks
                                                                    (.loop-reloads tuning))
                                               (mut frame)
                                               (.size owner-shape) (.alignment owner-shape) allocator
                                               (cast (ptr fixed/Index) (mut events)) reload-blocks position)
                          (Err [msg] (set! error msg))
                          (Ok [_]
                              (unless (pressure-class-into! parts index (mut events) (mut assigned)
                                                            (mut summary)
                                                            (& allowed (.allowed (at parts (cast i64 index)))))
                                (set! error "allocator pressure query moved backwards"))))))))
                (when (and (= error "")
                           (not (grant-free-impl! (mut parts)
                                                     (mut work)
                                                     index
                                                     (.free summary)
                                                     allowed
                                                     allocator
                                                     (cast (ptr fixed/Index)
                                                           (mut events))
                                                     boundary-step extra-boundaries (mut limits) false split-blocks late
                                                     (.loop-reloads tuning))))
                  (let [part (at parts (cast i64 index))
                        shape (shape-of (.parent part) shapes uniform)
                        weighed (and (!= (.loop-evict-mask tuning) 0)
                                     (let [here (split-position/block-at split-blocks position)]
                                       (and (>= here 0)
                                            (> (.depth (get split-blocks (cast i64 here))) 0))))
                        decision
                          (if weighed
                              (do
                                (owner-costs! parts index (.live assigned) position split-blocks
                                              (mut costs))
                                (blocked-decision-weighed (load part)
                                                          (.next-use summary)
                                                          (.fixed-at summary)
                                                          costs
                                                          position
                                                          allowed
                                                          split-blocks))
                              (blocked-decision (load part)
                                                (.next-use summary)
                                                (.fixed-at summary)
                                                position
                                                allowed))]
                    (if (= (.action decision) 0)
                        (match (spill-prefix-tracked! (mut parts)
                                                      (mut work)
                                                      index
                                                      (mut frame)
                                                      (.size shape)
                                                      (.alignment shape)
                                                      allocator
                                                      (cast (ptr fixed/Index)
                                                            (mut events))
                                                      reload-blocks
                                                      position)
                          (Err [msg] (set! error msg))
                          (Ok [_] 0))
                        (if (= (.action decision) 2)
                            (set! error "unsatisfiable register pressure")
                            (let [original-count (len parts)
                                  (mut owner-index) 0]
                              (while (and (= error "")
                                          (< owner-index original-count))
                                (let [owner (at parts owner-index)]
                                  (when (and (!= owner-index (cast i64 index))
                                             (= (.register owner)
                                                (.register decision))
                                             (range/covers? (.ranges owner)
                                                            position))
                                    (let [owner-shape
                                            (shape-of (.parent owner)
                                                      shapes
                                                      uniform)]
                                      (match (evict-tracked! (mut parts)
                                                             (mut work)
                                                             (cast i32
                                                                   owner-index)
                                                             (active-eviction-cut (load owner) position split-blocks
                                                                                  (.loop-reloads tuning))
                                                             (mut frame)
                                                             (.size owner-shape)
                                                             (.alignment owner-shape)
                                                             allocator
                                                             (cast (ptr fixed/Index)
                                                                   (mut events))
                                                             reload-blocks
                                                             position)
                                        (Err [msg] (set! error msg))
                                        (Ok [_] 0)))))
                                (set! owner-index (+ owner-index 1)))
                              (when (= error "")
                                (unless (pressure-class-into! parts
                                                              index
                                                              (mut events)
                                                              (mut assigned)
                                                              (mut summary)
                                                              (& allowed
                                                                 (.allowed (at parts (cast i64 index)))))
                                  (set! error
                                        "allocator pressure query moved backwards"))
                                (when (and (= error "")
                                           (not (grant-free-impl! (mut parts)
                                                                     (mut work)
                                                                     index
                                                                     (.free summary)
                                                                     allowed
                                                                     allocator
                                                                     (cast (ptr fixed/Index)
                                                                           (mut events))
                                                                     boundary-step extra-boundaries (mut limits) false split-blocks late
                                                     (.loop-reloads tuning))))
                                  (set! error
                                        "eviction did not make a register available"))))))))
                (when (= error "")
                  (let [current (at parts (cast i64 index))
                        owner (.hint-owner current)
                        reg (.register current)]
                    (when (and (>= owner 0) (< (cast i64 owner) (len parts)))
                      (set! (.last-register (elem (mut parts) (cast i64 owner)))
                            reg))))
                (when (and (= error "")
                           (>= (.register (at parts (cast i64 index))) 0))
                  (note-assigned! (mut assigned) index))
                (set! processed (+ processed 1))))))
    (free! (mut work))
    (free! (mut limits))
    (fixed/release! (mut events))
    (release-assigned! (mut assigned))
    (release-pressure! (mut summary))
    (free! (mut costs))
    (if (= error "") (Ok processed) (Err error))))

;;; Explicit per-parent shapes. Missing/out-of-range live parents are errors,
;;; even when a particular run would happen not to spill them.
(defn run-shaped! [(parts (mut (ArrayList Part)))
                   (layout (mut frame/Frame))
                   (register-count i32)
                   (allowed u64)
                   (shapes (slice SpillShape))
                   (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (run-impl! (mut parts)
             (mut layout)
             register-count
             allowed
             shapes
             (SpillShape :size 0 :alignment 0)
             1
             []
             []
             (plain-tuning)
             allocator))

;;; Native use/definition schedules lower general moves at even input
;;; boundaries. Definition-position spill stores and call transitions still use
;;; their existing explicit lowering; this policy governs free-range splits.
(defn run-shaped-input-boundaries! [(parts (mut (ArrayList Part)))
                                    (layout (mut frame/Frame))
                                    (register-count i32) (allowed u64)
                                    (shapes (slice SpillShape))
                                    (definition-moves (slice i64))
                                    (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (run-impl! (mut parts) (mut layout) register-count allowed shapes
             (SpillShape :size 0 :alignment 0) 2 definition-moves [] (plain-tuning) allocator))

;;; Prepared target metadata currently controls active-owner eviction only.
;;; Free assignment and reload restart retain their legal boundary policy.
(defn run-shaped-with-splits! [(parts (mut (ArrayList Part))) (layout (mut frame/Frame))
                               (register-count i32) (allowed u64) (shapes (slice SpillShape))
                               (definition-moves (slice i64))
                               (split-blocks (slice split-position/Block))
                               (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (run-shaped-with-tuning! (mut parts) (mut layout) register-count allowed shapes
    definition-moves split-blocks (plain-tuning) allocator))

;;; As run-shaped-with-splits! under optional policies (see Tuning).
(defn run-shaped-with-tuning! [(parts (mut (ArrayList Part))) (layout (mut frame/Frame))
                               (register-count i32) (allowed u64) (shapes (slice SpillShape))
                               (definition-moves (slice i64))
                               (split-blocks (slice split-position/Block))
                               (tuning Tuning)
                               (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (run-impl! (mut parts) (mut layout) register-count allowed shapes
    (SpillShape :size 0 :alignment 0) 2 definition-moves split-blocks tuning allocator))

;;; Compatibility interface for targets whose values all share one spill shape.
(defn run! [(parts (mut (ArrayList Part)))
            (layout (mut frame/Frame))
            (register-count i32)
            (allowed u64)
            (size i64)
            (alignment i64)
            (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [uniform (SpillShape :size size :alignment alignment)]
    (if (not (valid-shape? uniform))
        (Err "invalid uniform spill shape")
        (run-impl! (mut parts)
                   (mut layout)
                   register-count
                   allowed
                   []
                   uniform
                   1
                   []
                   []
                   (plain-tuning)
                   allocator))))

;;; Non-evictable fixed interference interval; parent=-1 has no virtual value.
;;; Preassigned parts are reservations and are excluded from the unhandled queue.
(defn reserve! [(parts (mut (ArrayList Part)))
                (register i32)
                (start i64)
                (end i64)
                (allocator (dyn Allocator))] (-> bool)
  (if (or (< register 0) (>= register 64) (< start 0) (<= end start))
      false
      (let [(mut reservation) (create -1 allocator)]
        (range/add! (mut (.ranges reservation)) start end)
        (c/add! (mut (.uses reservation)) start 2 register)
        (set! (.register reservation) register)
        (push! (mut parts) reservation)
        true)))
