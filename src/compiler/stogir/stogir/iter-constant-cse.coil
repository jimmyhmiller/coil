;;; Construction-style exact CSE for pure expressions with no positive input.
;;; A lazy index complements upstream's positive use-list search. See provenance.
(module stogir.iter-constant-cse)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Some None])

(defstruct Entry [(reference i32) (next i64)])

(defstruct Bucket [(canonical i32) (head i64) (announced bool)])

(defstruct Index
  [(ready bool) (heads (HashMap u128 Bucket)) (entries (ArrayList Entry))])

(defn create [(a (dyn Allocator))] (-> Index)
  (Index
    :ready false
    :heads (HashMap::new-scalar [u128 Bucket] a)
    :entries (ArrayList::new [Entry] a)))

(defn key [(node n/Node)] (-> u128)
  (| (cast u128 (.header node))
     (<< (cast u128 (cast u32 (.op1 node))) 32)
     (<< (cast u128 (cast u32 (.op2 node))) 64)
     (<< (cast u128 (cast u32 (.op3 node))) 96)))

;;; At least one constant value and no positive reference. Zero-input context
;;; observations, memory/control and variable nodes never enter this index.
(defn eligible? [(graph g/Graph) (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        count (get (.arities graph) (cast i64 reference))
        (mut valid) (and (>= opcode 14) (<= opcode 64) (> count 0) (<= count 3))
        (mut constant) false]
    (when valid
      (for [i 1 (+ (cast i64 count) 1)]
        (when (uses/edge-code? (op/operand-code opcode (cast i32 i)))
          (let [input
                  (match (g/operand graph reference (cast i32 i))
                    (Some [value] value)
                    (None [] 0))]
            (when (> input 0) (set! valid false))
            (when (< input 0) (set! constant true))))))
    (and valid constant)))

(defn add-entry! [(index (mut Index)) (reference i32) (head i64)] (-> i64)
  (let [position (len (.entries index))]
    (push! (mut (.entries index)) (Entry :reference reference :next head))
    position))

;;; No scan occurs unless a constant-only CSE query needs the index. Each
;;; expression's duplicates are queued only when that expression is queried.
(defn prepare! [(index (mut Index)) (graph g/Graph)] (-> void)
  (unless (.ready index)
    (set! (.ready index) true)
    (let [(mut r) 1]
      (while (< r (len (.instructions graph)))
        (when (eligible? graph (cast i32 r))
          (let [entry (key (get (.instructions graph) r))
                bucket
                  (match (get (.heads index) entry)
                    (Some [value] value)
                    (None []
                          (Bucket
                            :canonical (cast i32 r)
                            :head -1
                            :announced false)))
                canonical (.canonical bucket)
                head (.head bucket)
                next (add-entry! (mut index) (cast i32 r) head)]
            (set! (mut (.heads index))
                  entry
                  (Bucket
                    :canonical canonical
                    :head next
                    :announced false))))
        (set! r (+ r (/ (+ (cast i64 (get (.arities graph) r)) 4) 4)))))))

(defn valid? [(graph g/Graph) (reference i32) (entry u128) (count i32)]
  (-> bool)
  (and (g/contains? graph reference)
       (eligible? graph reference)
       (= (get (.arities graph) (cast i64 reference)) count)
       (= (key (get (.instructions graph) (cast i64 reference))) entry)))

(defn find! [(index (mut Index))
             (graph g/Graph)
             (queue (mut q/Queue))
             (reference i32)] (-> i32)
  (if (not (eligible? graph reference))
      0
      (do
        (prepare! (mut index) graph)
        (let [entry (key (get (.instructions graph) (cast i64 reference)))
              count (get (.arities graph) (cast i64 reference))
              bucket
                (match (get (.heads index) entry)
                  (Some [value] value)
                  (None []
                        (Bucket
                          :canonical reference
                          :head -1
                          :announced false)))
              previous (.canonical bucket)
              old-head (.head bucket)
              announced (.announced bucket)
              valid (valid? graph previous entry count)
              (mut canonical)
                (if (and valid (< previous reference)) previous reference)
              (mut head) old-head
              (mut recorded) false]
          ; Revalidate a changed/deleted canonical. Normal duplicate lookups
          ; stay O(1), rather than repeatedly walking every remaining duplicate.
          (unless valid
            (let [(mut cursor) head]
              (while (>= cursor 0)
                (let [candidate (get (.entries index) cursor)
                      ref (.reference candidate)]
                  (when (and (< ref canonical) (valid? graph ref entry count))
                    (set! canonical ref))
                  (set! cursor (.next candidate))))))
          (when (or (not announced) (not valid))
            (let [(mut cursor) head]
              (while (>= cursor 0)
                (let [candidate (get (.entries index) cursor)
                      ref (.reference candidate)]
                  (when (= ref reference) (set! recorded true))
                  (when (and (> ref canonical)
                             (!= ref reference)
                             (valid? graph ref entry count))
                    (q/add! (mut queue) (cast i64 ref)))
                  (set! cursor (.next candidate))))))
          (when (and valid (> previous reference))
            (q/add! (mut queue) (cast i64 previous)))
          (when (and (= canonical reference)
                     (not recorded)
                     (or (!= previous reference) (< old-head 0) (not valid)))
            (set! head (add-entry! (mut index) reference head)))
          (set! (mut (.heads index))
                entry
                (Bucket
                  :canonical canonical
                  :head head
                  :announced true))
          (if (< canonical reference) canonical 0)))))

(defn release! [(index (mut Index))] (-> void)
  (free! (mut (.heads index)))
  (free! (mut (.entries index))))
