;;; Incremental aliasing-load cleanup follows pinned ir_sccp.c:ir_iter_opt.
;;; Exact-width forwarding is endian-independent; partial views remain in the
;;; target-aware early memory pass. See NOTICE and provenance.
(module stogir.iter-memory)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.load-forward" :as forward)
(import "stogir.entry-load" :as entry-load)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "stogir.bitset" :as bits)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Some None])

;;; Control uses have already been bypassed. The caller immediately replaces
;;; data uses or rewrites the original load cell as a typed BITCAST.
(defstruct Rewrite [(source i32) (opcode u8)])

(defn none [] (-> Rewrite)
  (Rewrite :source 0 :opcode 0))

(defn control-edge? [(graph g/Graph) (edge uses/Use)] (-> bool)
  (= (op/operand-code (cast i32
                            (n/opcode (get (.instructions graph)
                                           (cast i64 (.user edge)))))
                      (.operand edge))
     op/OPERAND-SRC))

(defn prepare! [(graph (mut g/Graph))
                (edges (mut uses/Uses))
                (queue (mut q/Queue))
                (roots (mut (ArrayList i32)))
                (protected (mut bits/Bits))
                (rooted bool)
                (reference i32)
                (pointer-bytes i32)] (-> Rewrite)
  (let [node (get (.instructions graph) (cast i64 reference))
        type (n/type-id node)
        previous (.op1 node)
        observed (bits/contains? protected (cast i64 reference))
        (mut result) (none)]
    (when (and (= (n/opcode node) 91)
               (forward/scalar? type pointer-bytes)
               (> previous 0)
               (!= previous reference)
               (or (not observed) rooted))
      (let [found (forward/find-across graph edges reference pointer-bytes)
            source (.value found)
            offset (.offset found)]
        (when (and (!= source 0) (!= source reference) (= offset 0))
          (match (g/lookup graph source)
            (None [] 0)
            (Some [value]
                  (let [source-type (n/type-id value)
                        range (get (.ranges edges) (cast i64 reference))
                        (mut allowed)
                          (and (= (types/size (cast i32 source-type)
                                              pointer-bytes)
                                  (types/size (cast i32 type) pointer-bytes))
                               (forward/convertible? source-type
                                                     type
                                                     0
                                                     pointer-bytes))]
                    ; Only ordinary data edges and control-source edges can be
                    ; remapped. Preflight everything before touching the graph.
                    (for [i (.offset range) (+ (.offset range) (.count range))]
                      (let [edge (get (.edges edges) i)
                            user (.user edge)
                            kind
                              (op/operand-code (cast i32
                                                     (n/opcode (get (.instructions graph)
                                                                    (cast i64
                                                                          user))))
                                               (.operand edge))]
                        (when (or (= user reference)
                                  (and (= kind op/OPERAND-SRC)
                                       (= user previous))
                                  (and (!= kind op/OPERAND-SRC)
                                       (!= kind op/OPERAND-REF)
                                       (!= kind op/OPERAND-DEF)))
                          (set! allowed false))))
                    (when allowed
                      ; A load observation includes both its value and predecessor
                      ; effects. Keep the value's reference and retain the effects.
                      (when (and observed
                                 (not (bits/contains? protected
                                                      (cast i64 previous))))
                        (push! (mut roots) previous)
                        (bits/add! (mut protected) (cast i64 previous)))
                      (let [(mut more) true]
                        (while more
                          (set! more false)
                          (let [current
                                  (get (.ranges edges) (cast i64 reference))
                                (mut position) (.offset current)]
                            (while (and (not more)
                                        (< position
                                           (+ (.offset current)
                                              (.count current))))
                              (let [edge (get (.edges edges) position)
                                    user (.user edge)
                                    operand (.operand edge)]
                                (when (control-edge? graph edge)
                                  (unless (uses/remove! (mut edges)
                                                        reference
                                                        edge)
                                    (panic "forwarded load control use missing"))
                                  (unless (g/set-operand! (mut graph)
                                                          user
                                                          operand
                                                          previous)
                                    (panic "forwarded load control bypass failed"))
                                  (uses/add! (mut edges) previous edge)
                                  (q/add! (mut queue) (cast i64 user))
                                  (set! more true)))
                              (set! position (+ position 1))))))
                      (set! result
                            (Rewrite
                              :source source
                              :opcode (if (= source-type type) 0 36))))))))))
    result))

;;; Cheap preview for a load nothing has queued. An earlier value can only come
;;; from another LOAD or STORE of the same address node (expression CSE has
;;; merged equal addresses by now), reached along the sequence when CHANGED
;;; control may have opened one, or through a join. A read sequenced directly
;;; under a join may also be a loop header's. True is only a reason to run the
;;; real proofs; false loses nothing but that chance.
(defn worth-asking? [(graph g/Graph) (edges uses/Uses) (reference i32) (changed bool)] (-> bool)
  (let [address (.op2 (get (.instructions graph) (cast i64 reference)))
        (mut shared) false]
    (when (> address 0)
      (let [range (get (.ranges edges) (cast i64 address))]
        (for [i (.offset range) (+ (.offset range) (.count range))]
          (let [user (.user (get (.edges edges) i))
                opcode (n/opcode (get (.instructions graph) (cast i64 user)))]
            (when (and (!= user reference) (or (= opcode 91) (= opcode 93)))
              (set! shared true))))))
    (or (and shared (or changed (forward/under-join? graph reference)))
        (!= (.header (entry-load/chain graph reference)) 0))))
