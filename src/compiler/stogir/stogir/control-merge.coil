;;; END/BEGIN block merging adapted from pinned ir_sccp.c:ir_merge_blocks.
;;; Observable roots are explicitly remapped through removed control boundaries.
(module stogir.control-merge)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])

(defn merge! [(graph (mut g/Graph))
              (roots (mut (ArrayList i32)))
              (edges (mut uses/Uses))
              (queue (mut q/Queue))
              (a (dyn Allocator))] (-> i32)
  (let [(mut mapping) (ArrayList::new [i32] a)
        (mut changes) (: 0 i32)
        (mut work) (q/create (len (.instructions graph)) a)
        (mut r) 1]
    (for [i 0 (len (.instructions graph))] (push! (mut mapping) 0))
    (while (< r (len (.instructions graph)))
      (let [arity (get (.arities graph) r)]
        (when (= (n/opcode (get (.instructions graph) r)) 106)
          (q/add! (mut work) r))
        (set! r (+ r (/ (+ (cast i64 arity) 4) 4)))))
    (set! r (q/pop! (mut work)))
    (while (>= r 0)
      (let [node (get (.instructions graph) r)]
        (when (and (= (n/opcode node) 106)
                   (= (.op2 node) 0)
                   (> (.op1 node) 0)
                   (= (.count (get (.ranges edges) r)) 1))
          (let [end (.op1 node)
                prior (get (.instructions graph) (cast i64 end))
                range (get (.ranges edges) r)
                next (get (.edges edges) (.offset range))
                successor (get (.instructions graph) (cast i64 (.user next)))
                previous (.op1 prior)]
            (when (and (= (n/opcode prior) 114)
                       (= (.count (get (.ranges edges) (cast i64 end))) 1)
                       (> previous 0)
                       (!= previous (cast i32 r))
                       (!= previous end)
                       (!= (.user next) (cast i32 r))
                       (!= (.user next) end)
                       (= (.operand next) 1)
                       (op/control? (cast i32 (n/opcode successor)))
                       (= (op/operand-kind (cast i32 (n/opcode successor)) 1)
                          "src"))
              ; Detach first, so the predecessor's bucket slot can be reused.
              (unless (uses/remove! (mut edges)
                                    previous
                                    (uses/Use :user end :operand 1))
                (panic "control merge predecessor use missing"))
              (unless (uses/remove! (mut edges)
                                    end
                                    (uses/Use :user (cast i32 r) :operand 1))
                (panic "control merge boundary use missing"))
              (unless (uses/remove! (mut edges) (cast i32 r) next)
                (panic "control merge successor use missing"))
              (unless (g/set-operand! (mut graph) (.user next) 1 previous)
                (panic "control merge successor rewrite failed"))
              (uses/add! (mut edges) previous next)
              (unless (and (g/rewrite-inputs! (mut graph) end 0 0 [])
                           (g/rewrite-inputs! (mut graph) (cast i32 r) 0 0 []))
                (panic "control merge boundary removal failed"))
              (set! (mut mapping) (cast i64 end) previous)
              (set! (mut mapping) r previous)
              (q/add! (mut queue) (cast i64 previous))
              (q/add! (mut queue) (cast i64 (.user next)))
              (when (= (n/opcode (get (.instructions graph) (cast i64 previous)))
                       106)
                (q/add! (mut work) (cast i64 previous)))
              (when (= (n/opcode successor) 106)
                (q/add! (mut work) (cast i64 (.user next))))
              (set! changes (+ changes 1)))))
        (set! r (q/pop! (mut work)))))
    (for [i 0 (len roots)]
      (let [(mut root) (get roots i)
            (mut steps) 0]
        (while (> (get mapping (cast i64 root)) 0)
          (set! root (get mapping (cast i64 root)))
          (set! steps (+ steps 1))
          (when (> steps (len mapping)) (panic "control root remapping cycle")))
        (set! (mut roots) i root)))
    (free! (mut mapping))
    (q/release! (mut work))
    changes))
