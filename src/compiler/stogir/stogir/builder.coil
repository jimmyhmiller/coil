; Ported/adapted from dstogov/ir (ir_builder.h and ir.c), commit 92171d0. See NOTICE.
;;; Checked construction. Constants accept raw bits, preserving floating payloads.
(module stogir.builder)

(export vector-extract!
        vector-replace!
        vector-splat!
        vector-compare!
        vector-unary!
        vector-binary!
        vector-constant!
        vector-load!
        vector-store!
        scalar-constant!
        emit!
        patch!
        integer-binary!
        integer-division!
        integer-unary!
        loop-begin!
        loop-phi!
        integer-compare!
        conditional!
        floating!
        conversion!
        checked!
        overflow!
        argument-value!
        variable!
        variable-address!
        frame-address!
        stack-allocate!
        stack-free!
        stack-save!
        stack-restore!
        switch!
        case-value!
        case-range!
        case-default!
        trap!
        unreachable!)

(import "stogir.graph" :as g)
(import "stogir.uses" :as uses)
(import "stogir.vector" :as vector)
(import "stogir.vector-arithmetic" :as va)
(import "stogir.vector-comparison" :as vc)
(import "stogir.vector-lanes" :as vl)
(import "stogir.strings" :as strings)
(import "stogir.locals" :as locals)
(import "stogir.argument-value" :as argval)
(import "stogir.stack" :as stack)
(import "stogir.switch" :as switch)
(import "stogir.terminal" :as terminal)
(import "stogir.frame" :as frame)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as t)
(import "stogir.integer-unary" :as unary)
(import "stogir.integer-binary" :as binary)
(import "stogir.conditional" :as cond)
(import "stogir.checked" :as checked)
(import "stogir.conversion" :as conversion)
(import "stogir.floating" :as floating)
(import "stogir.fold" :as fold)
(import "coil.result" :use [Result Ok Err Some None])

(defn scalar-constant! [(graph (mut g/Graph))
                        (ty i32)
                        (bits u64)
                        (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (let [size (t/scalar-size ty pointer-bytes)]
    (if (or (<= size 0) (and (= ty 1) (> bits 1)))
        (Err "invalid constant type, boolean payload, or pointer width")
        (if (and (< size 8) (!= (>> bits (cast u64 (* size 8))) 0))
            (Err "constant payload exceeds type width")
            (match (g/intern-scalar! (mut graph) (cast u8 ty) bits)
              (Some [r] (Ok r))
              (None [] (Err "constant reference space exhausted")))))))

;;; Validates storage shape, not operation-specific type or dominance constraints.
;;; Forward control/phi references are supplied through a later patching API.
(defn emit! [(graph (mut g/Graph)) (opcode i32) (ty i32) (inputs (slice i32))]
  (-> (Result i32 (slice u8)))
  (if (or (not (op/valid? opcode)) (not (t/valid? ty)))
      (Err "invalid opcode or type")
      (if (and (>= opcode 1) (<= opcode 13))
          (Err "use scalar-constant! for constants")
          (let [slots (op/operand-slots opcode)
                count (len inputs)]
            (if (or (> count 65535)
                    (and (>= slots 0) (!= count (cast i64 slots))))
                (Err "operand count does not match opcode")
                (let [(mut valid) true
                      (mut i) 0]
                  (while (< i count)
                    (let [kind (op/operand-code opcode (cast i32 (+ i 1)))
                          value (get inputs i)]
                      (when (= kind op/OPERAND-PRO)
                        (match (strings/lookup (.strings graph) value)
                          (None [] (set! valid false))
                          (Some [_] 0)))
                      (when (uses/edge-code? kind)
                        (when (not (or (g/contains? graph value)
                                       (and (= value 0)
                                            (op/optional-reference? opcode
                                                                    ty
                                                                    (cast i32
                                                                          (+ i
                                                                             1))))))
                          (set! valid false))))
                    (set! i (+ i 1)))
                  (if (not valid)
                      (Err "operand references missing node")
                      (match (g/append-inputs-with-aux! (mut graph)
                                                        (cast u8 opcode)
                                                        (cast u8 ty)
                                                        (if (>= slots 0)
                                                            (: 0 u16)
                                                            (cast u16 count))
                                                        inputs)
                        (Some [r] (Ok r))
                        (None [] (Err "instruction reference space exhausted"))))))))))

;;; Patch an existing reference operand, rejecting numeric metadata slots.
;;; Zero is allowed only for optional links and a void RETURN value.
(defn patch! [(graph (mut g/Graph)) (r i32) (index i32) (value i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph r)
    (None [] (Err "patch target is not a node"))
    (Some [node]
          (let [kind (op/operand-code (cast i32 (n/opcode node)) index)
                reference? (uses/edge-code? kind)]
            (if (or (<= r 0) (not reference?))
                (Err "patch target is not a reference operand")
                (if (not (or (g/contains? graph value)
                             (and (= value 0)
                                  (op/optional-reference? (cast i32
                                                                (n/opcode node))
                                                          (cast i32
                                                                (n/type-id node))
                                                          index))))
                    (Err "patch value references missing node")
                    (if (g/set-operand! (mut graph) r index value)
                        (Ok r)
                        (Err "patch operand out of bounds"))))))))

;;; Checked same-type scalar integer binary construction with on-build folding.
;;; Other binary families require their own typing rules; emit! remains raw.
(defn integer-binary! [(graph (mut g/Graph))
                       (opcode i32)
                       (ty i32)
                       (pointer-bytes i32)
                       (left i32)
                       (right i32)]
  (-> (Result i32 (slice u8)))
  (if (or (= opcode 29) (= opcode 30))
      (integer-division! (mut graph) opcode ty pointer-bytes left right 0)
      (integer-binary-value! (mut graph) opcode ty pointer-bytes left right)))

;;; DIV/MOD carry a third optional control guard, as in upstream ir_fold3.
;;; Guard identity participates in CSE; zero means no guard was requested.
(defn integer-division! [(graph (mut g/Graph))
                         (opcode i32)
                         (ty i32)
                         (pointer-bytes i32)
                         (left i32)
                         (right i32)
                         (guard i32)]
  (-> (Result i32 (slice u8)))
  (let [(mut valid?)
          (and (or (= opcode 29) (= opcode 30))
               (t/integer? ty)
               (!= ty 1)
               (> (t/scalar-size ty pointer-bytes) 0))]
    (for reference [left right]
      (match (g/lookup graph reference)
        (None [] (set! valid? false))
        (Some [node]
              (when (!= (cast i32 (n/type-id node)) ty) (set! valid? false)))))
    (when (!= guard 0)
      (match (g/lookup graph guard)
        (None [] (set! valid? false))
        (Some [node]
              (when (or (< guard 0)
                        (not (or (op/block-start? (cast i32 (n/opcode node)))
                                 (= (n/opcode node) 101)
                                 (= (n/opcode node) 102))))
                (set! valid? false)))))
    (if (not valid?)
        (Err "invalid integer division operands, type or control guard")
        (match (fold/binary! (mut graph) opcode ty pointer-bytes left right)
          (Some [reference] (Ok reference))
          (None []
                (match (fold/power-division graph
                                            (n/make (cast u8 opcode) (cast u8 ty)
                                                    0 left right guard)
                                            pointer-bytes)
                  (Some [plan]
                        (match (scalar-constant! (mut graph) ty (.bits plan)
                                                 pointer-bytes)
                          (Err [message] (Err message))
                          (Ok [constant]
                              (integer-binary-value! (mut graph)
                                                     (cast i32 (.opcode plan))
                                                     ty pointer-bytes left constant))))
                  (None []
                    (let [key
                            (| (cast u128 opcode)
                               (<< (cast u128 ty) 8)
                               (<< (cast u128 (cast u32 left)) 16)
                               (<< (cast u128 (cast u32 right)) 48)
                               (<< (cast u128 (cast u32 guard)) 80))]
                      (match (get (.expressions graph) key)
                        (Some [reference] (Ok reference))
                        (None []
                              (match (emit! (mut graph)
                                            opcode
                                            ty
                                            [left right guard])
                                (Err [msg] (Err msg))
                                (Ok [reference]
                                    (do
                                      (set! (mut (.expressions graph))
                                            key
                                            reference)
                                      (Ok reference))))))))))))))

(defn integer-binary-value! [(graph (mut g/Graph))
                             (opcode i32)
                             (ty i32)
                             (pointer-bytes i32)
                             (left i32)
                             (right i32)]
  (-> (Result i32 (slice u8)))
  (if (or (not (binary/valid-type? opcode ty))
          (<= (t/scalar-size ty pointer-bytes) 0))
      (Err "unsupported integer binary operation or type")
      (match (g/lookup graph left)
        (None [] (Err "missing left operand"))
        (Some [a]
              (match (g/lookup graph right)
                (None [] (Err "missing right operand"))
                (Some [b]
                      (if (or (!= (cast i32 (n/type-id a)) ty)
                              (!= (cast i32 (n/type-id b)) ty))
                          (Err "integer binary operand type mismatch")
                          (match (fold/binary! (mut graph)
                                               opcode
                                               ty
                                               pointer-bytes
                                               left
                                               right)
                            (Some [r] (Ok r))
                            (None []
                                  (pure-binary! (mut graph)
                                                opcode
                                                ty
                                                left
                                                right))))))))))

(defn integer-unary! [(graph (mut g/Graph))
                      (opcode i32)
                      (ty i32)
                      (pointer-bytes i32)
                      (value i32)]
  (-> (Result i32 (slice u8)))
  (if (or (not (unary/valid-type? opcode ty))
          (<= (t/scalar-size ty pointer-bytes) 0))
      (Err "unsupported integer unary operation or type")
      (match (g/lookup graph value)
        (None [] (Err "missing unary operand"))
        (Some [node]
              (if (!= (cast i32 (n/type-id node)) ty)
                  (Err "unary operand type mismatch")
                  (match (fold/unary! (mut graph) opcode ty pointer-bytes value)
                    (Some [r] (Ok r))
                    (None []
                          (let [key
                                  (| (cast u128 opcode)
                                     (<< (cast u128 ty) 8)
                                     (<< (cast u128 (cast u32 value)) 16))]
                            (match (get (.expressions graph) key)
                              (Some [reference] (Ok reference))
                              (None []
                                    (match (emit! (mut graph) opcode ty [value])
                                      (Err [message] (Err message))
                                      (Ok [reference]
                                          (do
                                            (set! (mut (.expressions graph))
                                                  key
                                                  reference)
                                            (Ok reference))))))))))))))

;;; Reserve a two-predecessor loop. Its absent backedge is intentionally invalid
;;; until patched; the verifier rejects an unsealed loop.
(defn loop-begin! [(graph (mut g/Graph)) (entry i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph entry)
    (None [] (Err "missing loop entry"))
    (Some [node]
          (if (not (or (= (n/opcode node) 114) (= (n/opcode node) 115)))
              (Err "loop entry must be an END or LOOP_END")
              (match (g/append-inputs! (mut graph) 113 0 [entry (: 0 i32)])
                (Some [r] (Ok r))
                (None [] (Err "instruction reference space exhausted")))))))

(defn loop-phi! [(graph (mut g/Graph)) (loop i32) (initial i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph loop)
    (None [] (Err "missing loop header"))
    (Some [header]
          (if (!= (n/opcode header) 113)
              (Err "phi region is not a loop header")
              (match (g/lookup graph initial)
                (None [] (Err "missing phi initial value"))
                (Some [value]
                      (if (= (n/type-id value) 0)
                          (Err "phi initial value is void")
                          (match (g/append-inputs! (mut graph)
                                                   67
                                                   (n/type-id value)
                                                   [loop initial (: 0 i32)])
                            (Some [r] (Ok r))
                            (None []
                                  (Err "instruction reference space exhausted"))))))))))

(defn integer-compare! [(graph (mut g/Graph))
                        (opcode i32)
                        (pointer-bytes i32)
                        (left i32)
                        (right i32)]
  (-> (Result i32 (slice u8)))
  (if (or (< opcode 14) (> opcode 23))
      (Err "invalid integer comparison opcode")
      (match (g/lookup graph left)
        (None [] (Err "missing comparison operand"))
        (Some [a]
              (match (g/lookup graph right)
                (None [] (Err "missing comparison operand"))
                (Some [b]
                      (let [ty (cast i32 (n/type-id a))]
                        (if (or (!= (n/type-id a) (n/type-id b))
                                (not (t/integer? ty))
                                (<= (t/scalar-size ty pointer-bytes) 0))
                            (Err "invalid comparison operand types or target width")
                            (match (fold/compare! (mut graph)
                                                  opcode
                                                  ty
                                                  pointer-bytes
                                                  left
                                                  right)
                              (Some [r] (Ok r))
                              (None []
                                    (emit! (mut graph) opcode 1 [left right])))))))))))

;;; Exact-key CSE for validated pure binary nodes. No memory/control nodes enter
;;; this table. Mutating graph operands invalidates all cached expressions.
(defn pure-binary! [(graph (mut g/Graph))
                    (opcode i32)
                    (ty i32)
                    (left i32)
                    (right i32)] (-> (Result i32 (slice u8)))
  (let [commutative?
          (or (= opcode 26)
              (= opcode 28)
              (= opcode 46)
              (= opcode 47)
              (= opcode 48)
              (= opcode 58)
              (= opcode 59)
              (= opcode 14)
              (= opcode 15))
        a (if (and commutative? (< left right)) right left)
        b (if (and commutative? (< left right)) left right)
        key
          (| (cast u128 opcode)
             (<< (cast u128 ty) 8)
             (<< (cast u128 (cast u32 a)) 16)
             (<< (cast u128 (cast u32 b)) 48))]
    (match (get (.expressions graph) key)
      (Some [r] (Ok r))
      (None []
            (match (emit! (mut graph) opcode ty [a b])
              (Err [msg] (Err msg))
              (Ok [r] (do (set! (mut (.expressions graph)) key r) (Ok r))))))))

;;; Conditions are scalar truth values; both value arms match the result type.
(defn conditional! [(graph (mut g/Graph))
                    (ty i32)
                    (condition i32)
                    (yes i32)
                    (no i32)]
  (-> (Result i32 (slice u8)))
  (cond/build! (mut graph) ty condition yes no))

(defn checked! [(graph (mut g/Graph))
                (opcode i32)
                (ty i32)
                (pointer-bytes i32)
                (left i32)
                (right i32)] (-> (Result i32 (slice u8)))
  (checked/build! (mut graph) opcode ty pointer-bytes left right))

(defn overflow! [(graph (mut g/Graph)) (source i32)]
  (-> (Result i32 (slice u8)))
  (checked/overflow! (mut graph) source))

(defn conversion! [(graph (mut g/Graph))
                   (opcode i32)
                   (ty i32)
                   (pointer-bytes i32)
                   (source i32)] (-> (Result i32 (slice u8)))
  (conversion/build! (mut graph) opcode ty pointer-bytes source))

;;; Floating type is the operand type; comparisons infer a Boolean result.
(defn floating! [(graph (mut g/Graph))
                 (opcode i32)
                 (ty i32)
                 (left i32)
                 (right i32)
                 (guard i32)] (-> (Result i32 (slice u8)))
  (floating/build! (mut graph) opcode ty left right guard))

;;; Named typed storage belongs to a block-start region. Alignment is in bytes;
;;; zero asks for the natural type alignment of the selected target.
(defn variable! [(graph (mut g/Graph))
                 (ty i32)
                 (region i32)
                 (name (slice u8))
                 (alignment i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph region)
    (None [] (Err "local variable region missing"))
    (Some [node]
          (if (or (<= region 0)
                  (not (op/block-start? (cast i32 (n/opcode node))))
                  (or (= ty 0) (not (t/valid? ty)))
                  (and (!= alignment 0)
                       (not (frame/valid-alignment? (cast i64 alignment)))))
              (Err "invalid local variable shape")
              (match (strings/intern! (mut (.strings graph)) name)
                (None [] (Err "local variable name interning failed"))
                (Some [id] (emit! (mut graph) 72 ty [region id alignment])))))))

(defn variable-address! [(graph (mut g/Graph)) (variable i32)]
  (-> (Result i32 (slice u8)))
  (match (locals/shape graph variable 8)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 65 6 [variable]))))

;;; Request the function's target frame address. The AArch64 target establishes
;;; a real frame record for functions containing this operation.
(defn frame-address! [(graph (mut g/Graph))] (-> (Result i32 (slice u8)))
  (emit! (mut graph) 66 6 []))

(defn stack-allocate! [(graph (mut g/Graph))
                       (control i32)
                       (size i32)
                       (alignment i32)]
  (-> (Result i32 (slice u8)))
  (match (stack/validate-inputs graph 81 6 control size alignment)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 81 6 [control size alignment]))))

(defn stack-free! [(graph (mut g/Graph)) (control i32) (size i32)]
  (-> (Result i32 (slice u8)))
  (match (stack/validate-inputs graph 82 0 control size 0)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 82 0 [control size]))))

;;; Snapshots represent raw SP, including the reserved outgoing argument area.
(defn stack-save! [(graph (mut g/Graph)) (control i32)]
  (-> (Result i32 (slice u8)))
  (match (stack/validate-scope-inputs graph 83 6 control 0)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 83 6 [control]))))

(defn stack-restore! [(graph (mut g/Graph)) (control i32) (saved i32)]
  (-> (Result i32 (slice u8)))
  (match (stack/validate-scope-inputs graph 84 0 control saved)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 84 0 [control saved]))))

(defn switch! [(graph (mut g/Graph)) (control i32) (selector i32)]
  (-> (Result i32 (slice u8)))
  (match (switch/switch-inputs graph control selector)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 117 0 [control selector]))))

;;; Complete dispatch validation checks default uniqueness and disjoint ranges.
(defn case-value! [(graph (mut g/Graph)) (source i32) (value i32)]
  (-> (Result i32 (slice u8)))
  (match (switch/case-inputs graph 109 source value value)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 109 0 [source value (: 0 i32)]))))

(defn case-range! [(graph (mut g/Graph)) (source i32) (low i32) (high i32)]
  (-> (Result i32 (slice u8)))
  (match (switch/case-inputs graph 110 source low high)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 110 0 [source low high]))))

(defn case-default! [(graph (mut g/Graph)) (source i32)]
  (-> (Result i32 (slice u8)))
  (match (switch/case-inputs graph 111 source 0 0)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 111 0 [source (: 0 i32)]))))

(defn trap! [(graph (mut g/Graph)) (control i32)]
  (-> (Result i32 (slice u8)))
  (match (terminal/inputs graph 96 control 0)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 96 0 [control]))))

;;; previous is an optional terminal-chain link; use zero for an unlinked exit.
(defn unreachable! [(graph (mut g/Graph)) (control i32) (previous i32)]
  (-> (Result i32 (slice u8)))
  (match (terminal/inputs graph 121 control previous)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 121 0 [control (: 0 i32) previous]))))

;;; An indirect aggregate argument is copied at the consuming call, not here.
(defn argument-value! [(graph (mut g/Graph))
                       (source i32)
                       (size i32)
                       (alignment i32)]
  (-> (Result i32 (slice u8)))
  (match (argval/inputs graph source size alignment)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 70 6 [source size alignment]))))

(defn vector-load! [(graph (mut g/Graph))
                    (ty i32)
                    (pointer-bytes i32)
                    (control i32)
                    (address i32)
                    (volatile? bool)]
  (-> (Result i32 (slice u8)))
  (match (vector/memory-inputs graph ty pointer-bytes control address)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) (if volatile? 92 91) ty [control address]))))

(defn vector-store! [(graph (mut g/Graph))
                     (pointer-bytes i32)
                     (control i32)
                     (address i32)
                     (value i32)
                     (volatile? bool)]
  (-> (Result i32 (slice u8)))
  (match (vector/store-inputs graph pointer-bytes control address value)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) (if volatile? 94 93) 0 [control address value]))))

(defn vector-constant! [(graph (mut g/Graph))
                        (ty i32)
                        (pointer-bytes i32)
                        (payload (slice u8))]
  (-> (Result i32 (slice u8)))
  (if (or (not (t/vector? ty))
          (!= (cast i64 (t/size ty pointer-bytes)) (len payload)))
      (Err "invalid vector constant type, target width or payload size")
      (match (g/intern-vector! (mut graph) ty pointer-bytes payload)
        (None []
              (Err "invalid vector constant storage or exhausted reference space"))
        (Some [reference] (Ok reference)))))

(defn vector-binary! [(graph (mut g/Graph))
                      (opcode i32)
                      (ty i32)
                      (left i32)
                      (right i32)
                      (guard i32)]
  (-> (Result i32 (slice u8)))
  (if (va/unary? opcode)
      (Err "vector-binary! requires a binary opcode")
      (match (va/operands graph opcode ty left right guard)
        (Err [message] (Err message))
        (Ok [_]
            (if (or (= opcode 29) (= opcode 30))
                (emit! (mut graph) opcode ty [left right guard])
                (emit! (mut graph) opcode ty [left right]))))))

(defn vector-unary! [(graph (mut g/Graph)) (opcode i32) (ty i32) (input i32)]
  (-> (Result i32 (slice u8)))
  (if (not (va/unary? opcode))
      (Err "invalid vector unary opcode")
      (match (va/operands graph opcode ty input input 0)
        (Err [message] (Err message))
        (Ok [_] (emit! (mut graph) opcode ty [input])))))

;;; Result is a full-lane integer mask; operand types are inferred and checked.
(defn vector-compare! [(graph (mut g/Graph))
                       (opcode i32)
                       (result-type i32)
                       (pointer-bytes i32)
                       (left i32)
                       (right i32)] (-> (Result i32 (slice u8)))
  (match (vc/operands graph opcode result-type pointer-bytes left right)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) opcode result-type [left right]))))

(defn vector-extract! [(graph (mut g/Graph))
                       (result-type i32)
                       (pointer-bytes i32)
                       (input i32)
                       (index i32)] (-> (Result i32 (slice u8)))
  (match (vl/operands graph 61 result-type pointer-bytes input index 0)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 61 result-type [input index]))))

(defn vector-replace! [(graph (mut g/Graph))
                       (ty i32)
                       (pointer-bytes i32)
                       (input i32)
                       (index i32)
                       (replacement i32)] (-> (Result i32 (slice u8)))
  (match (vl/operands graph 62 ty pointer-bytes input index replacement)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 62 ty [input index replacement]))))

(defn vector-splat! [(graph (mut g/Graph))
                     (ty i32)
                     (pointer-bytes i32)
                     (input i32)]
  (-> (Result i32 (slice u8)))
  (match (vl/operands graph 63 ty pointer-bytes input 0 0)
    (Err [message] (Err message))
    (Ok [_] (emit! (mut graph) 63 ty [input]))))
