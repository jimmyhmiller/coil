;;; CFG branch predictions and post-allocation physical block order. The compact graph and allocation
;;; subpositions stay unchanged. Algorithm reference: pinned ir_cfg.c; see NOTICE.
(module stogir.block-layout)
(import "stogir.fill" :as fill)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.cfg" :as cfg)
(import "stogir.adjacency" :as adj)
(import "stogir.dominators" :as dom)
(import "stogir.pipeline" :as pipeline)
(import "stogir.schedule" :as schedule)
(import "stogir.bitset" :as bits)
(import "stogir.flow-frequency" :as flow)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Option Some None])

(defstruct Block
  [(reference i32)
   (start-op i32)
   (end-op i32)
   (depth i32)
   (header bool)
   (empty bool)
   (probability i32)])

;;; Dense RPO numbers are CFG metadata, not a second instruction IR.
(defstruct Facts
  [(items (ArrayList Block))
   (ranks (ArrayList i32))
   (edges (ArrayList cfg/Edge))
   (successors adj/Index)
   (predecessors adj/Index)
   (irreducible bool)])

(defstruct Plan
  [(indices (ArrayList i64))
   (next (ArrayList i32))
   (aliases (ArrayList i32))
   (alignment (ArrayList i32))
   (blocks (ArrayList i32))
   (top-down bool)])

(defn release! [(plan (mut Plan))] (-> void)
  (free! (mut (.indices plan)))
  (free! (mut (.next plan)))
  (free! (mut (.aliases plan)))
  (free! (mut (.alignment plan)))
  (free! (mut (.blocks plan))))

(defn release-facts! [(facts (mut Facts))] (-> void)
  (free! (mut (.items facts)))
  (free! (mut (.ranks facts)))
  (free! (mut (.edges facts)))
  (adj/release! (mut (.successors facts)))
  (adj/release! (mut (.predecessors facts))))

(defn successor [(facts Facts) (block i32) (index i64)] (-> i32)
  (let [range (get (.ranges (.successors facts)) (cast i64 block))]
    (.to (get (.edges facts)
              (get (.edges (.successors facts)) (+ (.offset range) index))))))

(defn degree [(facts Facts) (block i32)] (-> i64)
  (.count (get (.ranges (.successors facts)) (cast i64 block))))

(defn skip-empty [(facts Facts) (block i32)] (-> i32)
  (let [(mut current) block]
    (while (.empty (get (.items facts) (cast i64 current)))
      (set! current (successor facts current 0)))
    current))

;;; Empty candidates have already been checked against machine moves. Pure
;;; empty cycles keep an anchor so canonical target resolution terminates.
(defn facts [(graph g/Graph)
             (prepared pipeline/Prepared)
             (empty (ArrayList bool))
             (allocator (dyn Allocator))] (-> Facts)
  (let [(mut items) (ArrayList::new [Block] allocator)
        (mut ranks) (ArrayList::new [i32] allocator)
        (mut edges) (ArrayList::new [cfg/Edge] allocator)
        (mut irreducible) false]
    (push! (mut items)
           (Block
             :reference 0
             :start-op 0
             :end-op 0
             :depth 0
             :header false
             :empty false
             :probability 0))
    (fill/append! (mut ranks) (len (.instructions graph)) 0)
    (let [items-105 (.order prepared) (mut for-index-105) (: 0 i64)] (while (< for-index-105 (len items-105)) (let [reference (get items-105 for-index-105)]
      (let [range (get (.ranges (.schedule prepared)) (cast i64 reference))]
        (when (> (.count range) 0)
          (let [start (get (.instructions graph) (cast i64 reference))
                ending
                  (get (.instructions graph)
                       (cast i64
                             (get (.nodes (.schedule prepared))
                                  (- (+ (.offset range) (.count range)) 1))))
                opcode (cast i32 (n/opcode start))
                rank (cast i32 (len items))]
            (set! (mut ranks) (cast i64 reference) rank)
            (push! (mut items)
                   (Block
                     :reference reference
                     :start-op opcode
                     :end-op (cast i32 (n/opcode ending))
                     :depth (get (.depths prepared) (cast i64 reference))
                     :header false
                     :empty (get empty (cast i64 reference))
                     :probability
                       (if (or (= opcode 107) (= opcode 108) (= opcode 111))
                           (.op2 start)
                           (if (= opcode 109) (.op3 start) 0)))))))) (set! for-index-105 (+ for-index-105 1))))
    (let [items-104 (.edges (.blocks prepared)) (mut for-index-104) (: 0 i64)] (while (< for-index-104 (len items-104)) (let [edge (get items-104 for-index-104)]
      (let [from (get ranks (cast i64 (.from edge)))
            to (get ranks (cast i64 (.to edge)))]
        (when (and (> from 0) (> to 0))
          (push! (mut edges)
                 (cfg/Edge
                   :from from
                   :to to
                   :source (.source edge)
                   :position (.position edge)))
          (when (>= from to)
            (if (dom/dominates? (.idom prepared) (.to edge) (.from edge))
                (set! (.header (elem (mut items) (cast i64 to))) true)
                (set! irreducible true)))))) (set! for-index-104 (+ for-index-104 1))))
    (let [(mut result)
            (Facts
              :items items
              :ranks ranks
              :edges edges
              :successors (adj/build-edges edges (len items) false allocator)
              :predecessors (adj/build-edges edges (len items) true allocator)
              :irreducible irreducible)]
      ; Only a single-successor non-entry block can disappear. Preserve one
      ; anchor per all-empty cycle: this port may receive unsimplified CFGs.
      (for [i 1 (len (.items result))]
        (let [block (elem (mut (.items result)) i)]
          (when (or (= (.start-op block) 104)
                    (= (.start-op block) 105)
                    (!= (degree result (cast i32 i)) 1))
            (set! (.empty block) false))))
      (let [(mut marks) (ArrayList::new [i32] allocator)]
        (fill/append! (mut marks) (len (.items result)) 0)
        (for [i 1 (len (.items result))]
          (when (and (.empty (get (.items result) i)) (= (get marks i) 0))
            (let [(mut current) (cast i32 i)]
              (while (and (.empty (get (.items result) (cast i64 current)))
                          (= (get marks (cast i64 current)) 0))
                (set! (mut marks) (cast i64 current) (cast i32 i))
                (set! current (successor result current 0)))
              (when (and (.empty (get (.items result) (cast i64 current)))
                         (= (get marks (cast i64 current)) (cast i32 i)))
                (let [first current
                      (mut anchor) current
                      (mut next) (successor result current 0)]
                  (while (!= next first)
                    (when (< next anchor) (set! anchor next))
                    (set! next (successor result next 0)))
                  (set! (.empty (elem (mut (.items result)) (cast i64 anchor)))
                        false))))))
        (free! (mut marks)))
      ; Preserve explicit branch weights; otherwise mark unreachable stop arms
      ; cold, using the same one-predecessor / one-level-merge policy upstream.
      (for [i 1 (len (.items result))]
        (when (and (= (.end-op (get (.items result) i)) 121)
                   (let [reference (.reference (get (.items result) i))
                         range
                           (get (.ranges (.schedule prepared))
                                (cast i64 reference))
                         ending
                           (get (.instructions graph)
                                (cast i64
                                      (get (.nodes (.schedule prepared))
                                           (- (+ (.offset range) (.count range))
                                              1))))]
                     (!= (n/opcode (get (.instructions graph)
                                        (cast i64 (.op1 ending))))
                         80)))
          (let [incoming (get (.ranges (.predecessors result)) i)]
            (if (= (.count incoming) 1)
                (cold! (mut result) (cast i32 i))
                (for [j 0 (.count incoming)]
                  (let [edge
                          (get (.edges result)
                               (get (.edges (.predecessors result))
                                    (+ (.offset incoming) j)))
                        predecessor (.from edge)]
                    (when (= (.count (get (.ranges (.predecessors result))
                                          (cast i64 predecessor)))
                             1)
                      (cold! (mut result) predecessor))))))))
      result)))

;;; Static branch prediction (an independent extension, not upstream ir_cfg.c).
;;; Ball-Larus heuristics combined by Dempster-Shafer, as GCC's predict.c does,
;;; give IF_TRUE/IF_FALSE arms percentages where the graph carries none and no
;;; arm is a cold UNREACHABLE stop. Percent of the first piece of evidence p,
;;; combined with q, is p*q / (p*q + (1-p)*(1-q)).
(defn combine [(p f64) (q f64)] (-> f64)
  (/ (* p q) (+ (* p q) (* (- 1.0 p) (- 1.0 q)))))

(defn node-at [(graph g/Graph) (reference i32)] (-> n/Node)
  (if (> reference 0)
      (get (.instructions graph) (cast i64 reference))
      (get (.constants graph) (- (- 0 (cast i64 reference)) 1))))

(defn zero-constant? [(graph g/Graph) (reference i32)] (-> bool)
  (and (< reference 0)
       (let [node (node-at graph reference)]
         (and (>= (n/opcode node) 1) (<= (n/opcode node) 11) (= (n/constant-bits node) 0)))))

;;; The last scheduled node of the block starting at REFERENCE.
(defn block-end [(graph g/Graph) (prepared pipeline/Prepared) (reference i32)] (-> n/Node)
  (let [range (get (.ranges (.schedule prepared)) (cast i64 reference))]
    (get (.instructions graph)
         (cast i64 (get (.nodes (.schedule prepared)) (- (+ (.offset range) (.count range)) 1))))))

;;; Whether an arm (followed while it has a single successor with no other
;;; predecessor, at most three blocks) calls, ends in RETURN, or enters a
;;; deeper loop, directly or through the loop's guard.
(defstruct Arm [(calls bool) (returns bool) (enters-loop bool)])

(defn arm [(graph g/Graph) (prepared pipeline/Prepared) (facts Facts) (rank i32) (depth i32)] (-> Arm)
  (let [(mut current) rank (mut steps) 0 (mut calls) false (mut returns) false
        (mut enters) false (mut done) false]
    (while (not done)
      (let [block (get (.items facts) (cast i64 current))
            range (get (.ranges (.schedule prepared)) (cast i64 (.reference block)))]
        (for [k 0 (.count range)]
          (let [opcode (n/opcode (get (.instructions graph)
                                      (cast i64 (get (.nodes (.schedule prepared)) (+ (.offset range) k)))))]
            (when (= opcode 79) (set! calls true))))
        (when (= (.end-op block) 120) (set! returns true))
        (when (and (.header block) (> (.depth block) depth)) (set! enters true))
        (set! steps (+ steps 1))
        ; A block ending in the guard of a bottom-tested loop enters that
        ; loop: one successor is the loop's own preheader.
        (when (= (degree facts current) 2)
          (for [side 0 2]
            (let [next (successor facts current side)]
              (when (and (> next current) (= (degree facts next) 1)
                         (= (.count (get (.ranges (.predecessors facts)) (cast i64 next))) 1))
                (let [after (get (.items facts) (cast i64 (successor facts next 0)))]
                  (when (and (.header after) (> (.depth after) depth)) (set! enters true)))))))
        (if (or (>= steps 3) (!= (degree facts current) 1))
            (set! done true)
            (let [next (successor facts current 0)]
              (if (or (<= next current)
                      (!= (.count (get (.ranges (.predecessors facts)) (cast i64 next))) 1))
                  (do (when (and (.header (get (.items facts) (cast i64 next)))
                                 (> (.depth (get (.items facts) (cast i64 next))) depth))
                        (set! enters true))
                      (set! done true))
                  (set! current next))))))
    (Arm :calls calls :returns returns :enters-loop enters)))

;;; Blocks every path from which reaches UNREACHABLE (not after a TAILCALL),
;;; computed backward over ranks in reverse RPO order. A successor at a lower
;;; rank (a backedge) counts as warm, so loops are never cold.
(defn cold-blocks [(graph g/Graph) (prepared pipeline/Prepared) (facts Facts)
                   (allocator (dyn Allocator))] (-> (ArrayList bool))
  (let [(mut cold) (ArrayList::new [bool] allocator)
        count (len (.items facts))]
    (fill/append! (mut cold) count false)
    (let [(mut i) (- count 1)]
      (while (>= i 1)
        (let [block (get (.items facts) i)
              degree (degree facts (cast i32 i))]
          (if (= (.end-op block) 121)
              (let [ending (block-end graph prepared (.reference block))]
                (when (!= (n/opcode (get (.instructions graph) (cast i64 (.op1 ending)))) 80)
                  (set! (mut cold) i true)))
              (when (> degree 0)
                (let [(mut all) true]
                  (for [k 0 degree]
                    (let [target (successor facts (cast i32 i) k)]
                      (unless (and (> target (cast i32 i)) (get cold (cast i64 target)))
                        (set! all false))))
                  (when all (set! (mut cold) i true))))))
        (set! i (- i 1))))
    cold))

(defn predict! [(graph g/Graph) (prepared pipeline/Prepared) (facts (mut Facts))
                (allocator (dyn Allocator))] (-> void)
  (let [(mut cold) (cold-blocks graph prepared facts allocator)]
  (for [i 1 (len (.items facts))]
    (let [block (get (.items facts) i)]
      (when (and (= (.end-op block) 116) (= (degree facts (cast i32 i)) 2))
        (let [a (successor facts (cast i32 i) 0)
              b (successor facts (cast i32 i) 1)
              first (get (.items facts) (cast i64 a))
              second (get (.items facts) (cast i64 b))]
          (when (and (= (.probability first) 0) (= (.probability second) 0)
                     (or (and (= (.start-op first) 107) (= (.start-op second) 108))
                         (and (= (.start-op first) 108) (= (.start-op second) 107))))
            (let [true-rank (if (= (.start-op first) 107) a b)
                  false-rank (if (= (.start-op first) 107) b a)
                  t (get (.items facts) (cast i64 true-rank))
                  f (get (.items facts) (cast i64 false-rank))
                  depth (.depth block)
                  condition (.op2 (block-end graph prepared (.reference block)))
                  true-cold (get cold (cast i64 true-rank))
                  false-cold (get cold (cast i64 false-rank))
                  (mut p) (: 0.5 f64)]
              ; Noreturn: an arm that can only reach UNREACHABLE is cold.
              (cond (and true-cold (not false-cold)) (set! p (combine p 0.01))
                    (and false-cold (not true-cold)) (set! p (combine p 0.99))
                    :else 0)
              ; Loop branch: staying in the loop is likely.
              (cond (and (>= (.depth t) depth) (< (.depth f) depth)) (set! p (combine p 0.88))
                    (and (< (.depth t) depth) (>= (.depth f) depth)) (set! p (combine p 0.12))
                    :else 0)
              ; Opcode and pointer heuristics on the condition.
              (when (> condition 0)
                (let [c (node-at graph condition)
                      opcode (n/opcode c)
                      pointer (= (n/type-id (node-at graph (.op1 c))) 6)
                      zero (zero-constant? graph (.op2 c))]
                  (cond (= opcode 14) (set! p (combine p (if pointer 0.3 0.34)))
                        (= opcode 15) (set! p (combine p (if pointer 0.7 0.66)))
                        (and zero (or (= opcode 16) (= opcode 18))) (set! p (combine p 0.36))
                        (and zero (or (= opcode 17) (= opcode 19))) (set! p (combine p 0.64))
                        :else 0)))
              (let [ta (arm graph prepared facts true-rank depth)
                    fa (arm graph prepared facts false-rank depth)]
                ; Loop header: an arm entering a loop is likely.
                (when (and (.enters-loop ta) (not (.enters-loop fa))) (set! p (combine p 0.75)))
                (when (and (.enters-loop fa) (not (.enters-loop ta))) (set! p (combine p 0.25)))
                ; Call heuristic: an arm that calls is unlikely.
                (when (and (.calls ta) (not (.calls fa))) (set! p (combine p 0.22)))
                (when (and (.calls fa) (not (.calls ta))) (set! p (combine p 0.78)))
                ; Return heuristic: an arm that returns is unlikely.
                (when (and (.returns ta) (not (.returns fa))) (set! p (combine p 0.28)))
                (when (and (.returns fa) (not (.returns ta))) (set! p (combine p 0.72))))
              (let [percent (cast i32 (+ (* p 100.0) 0.5))
                    clamped (cond (< percent 2) 2 (> percent 98) 98 :else percent)]
                (set! (.probability (elem (mut (.items facts)) (cast i64 true-rank))) clamped)
                (set! (.probability (elem (mut (.items facts)) (cast i64 false-rank))) (- 100 clamped)))))))))
  (free! (mut cold))))

(defn cold! [(facts (mut Facts)) (rank i32)] (-> void)
  (let [block (elem (mut (.items facts)) (cast i64 rank))]
    (when (and (= (.probability block) 0)
               (or (= (.start-op block) 107)
                   (= (.start-op block) 108)
                   (= (.start-op block) 109)
                   (= (.start-op block) 111)))
      (set! (.probability block) 1))))

(defstruct Weight [(first i32) (second i32) (total i32)])

(defn if-weight [(facts Facts) (rank i32)] (-> Weight)
  (let [first (get (.items facts) (cast i64 (successor facts rank 0)))
        second (get (.items facts) (cast i64 (successor facts rank 1)))
        p (.probability first)
        q (.probability second)
        depth (.depth (get (.items facts) (cast i64 rank)))]
    (cond (> p 0)
            (if (> q 0)
                (Weight
                  :first p
                  :second q
                  :total (+ p q))
                (let [clamped (if (> p 100) 100 p)]
                  (Weight
                    :first clamped
                    :second (- 100 clamped)
                    :total 100)))
          (> q 0)
            (let [clamped (if (> q 100) 100 q)]
              (Weight
                :first (- 100 clamped)
                :second clamped
                :total 100))
          (and (>= (.depth first) depth) (< (.depth second) depth))
            (Weight
              :first 90
              :second 10
              :total 100)
          (and (< (.depth first) depth) (>= (.depth second) depth))
            (Weight
              :first 10
              :second 90
              :total 100)
          (.empty second)
            (Weight
              :first 51
              :second 49
              :total 100)
          (.empty first)
            (Weight
              :first 49
              :second 51
              :total 100)
          :else
            (Weight
              :first 50
              :second 50
              :total 100))))

(defn probability [(facts Facts) (rank i32) (count i64) (top-down bool)]
  (-> i32)
  (let [block (get (.items facts) (cast i64 rank))]
    (if (= (.start-op block) 105)
        1
        (if (> (.probability block) 0)
            (.probability block)
            (+ (cast i32 (/ 100 count))
               (if (and top-down
                        (not (.empty block))
                        (or (= (.start-op block) 107) (= (.start-op block) 108)))
                   1
                   0))))))

(defstruct Chain [(head i32) (next i32) (previous i32)])

(defn flow-weight [(facts Facts) (source i32) (index i64)] (-> i32)
  (let [count (degree facts source)]
    (if (and (= count 2) (= (.end-op (get (.items facts) (cast i64 source))) 116))
      (let [weight (if-weight facts source)] (if (= index 0) (.first weight) (.second weight)))
      (let [p (if (= count 1) 100 (probability facts (successor facts source index) count false))]
        ; Preserve uniform mass when integer percentages round to zero.
        (if (> p 0) p 1)))))

;;; Exact CFG-edge identity includes parallel edges; do not key just by endpoints.
(defn flow-probability [(facts Facts) (edge i64)] (-> f64)
  (let [source (.from (get (.edges facts) edge))
        span (get (.ranges (.successors facts)) (cast i64 source))
        (mut total) (: 0 i64) (mut weight) (: 0 i32)]
    (for [i 0 (.count span)]
      (let [p (flow-weight facts source i)]
        (set! total (+ total (cast i64 p)))
        (when (= (get (.edges (.successors facts)) (+ (.offset span) i)) edge) (set! weight p))))
    (if (> total 0) (/ (cast f64 weight) (cast f64 total)) 0.0)))

;;; Allocation needs expected visits, not the layout algorithm's ranking
;;; frequencies. Share the same explicit/static branch weights, but conserve
;;; flow through loops. Result indices are dense Facts ranks (zero is unused).
;;; None means a reachable recurrent component or unreliable numeric solve;
;;; callers must retain a bounded fallback rather than inventing a profile.
(defn expected-frequencies [(facts Facts) (allocator (dyn Allocator))]
  (-> (Result (Option (ArrayList f64)) (slice u8)))
  (if (<= (len (.items facts)) 1)
    (let [(mut result) (ArrayList::new [f64] allocator)]
      (for [i 0 (len (.items facts))] (push! (mut result) 0.0))
      (Ok (Some result)))
    (let [(mut edges) (ArrayList::new [flow/Edge] allocator)]
      (for [rank 1 (len (.items facts))]
        (let [source (cast i32 rank)]
          (for [i 0 (degree facts source)]
            (let [p (flow-weight facts source i)]
              (when (> p 0)
                (push! (mut edges) (flow/Edge :from source :to (successor facts source i) :weight p)))))))
      (let [result (flow/estimate (cast i32 (len (.items facts))) 1 (slice edges) allocator)]
        (free! (mut edges)) result))))

(defstruct Edge [(from i32) (to i32) (frequency f32)])

(defn chain-head! [(chains (mut (ArrayList Chain))) (rank i32)] (-> i32)
  (let [(mut head) rank
        (mut current) rank]
    (while (!= (.head (get chains (cast i64 head))) head)
      (set! head (.head (get chains (cast i64 head)))))
    (while (!= current head)
      (let [next (.head (get chains (cast i64 current)))]
        (set! (.head (elem (mut chains) (cast i64 current))) head)
        (set! current next)))
    head))

;;; Circular lists use head.previous as tail, exactly as upstream's union.
(defn join! [(chains (mut (ArrayList Chain))) (source i32) (target i32)]
  (-> void)
  (let [source-tail (.previous (get chains (cast i64 source)))
        target-tail (.previous (get chains (cast i64 target)))]
    (set! (.next (elem (mut chains) (cast i64 target-tail))) source)
    (set! (.previous (elem (mut chains) (cast i64 target))) source-tail)
    (set! (.next (elem (mut chains) (cast i64 source-tail))) target)
    (set! (.previous (elem (mut chains) (cast i64 source))) target-tail)
    (set! (.head (elem (mut chains) (cast i64 target))) source)))

(defn before? [(first Edge) (second Edge)] (-> bool)
  (or (> (.frequency first) (.frequency second))
      (and (= (.frequency first) (.frequency second))
           (or (> (.from first) (.from second))
               (and (= (.from first) (.from second))
                    (< (.to first) (.to second)))))))

(defn swap! [(edges (mut (ArrayList Edge))) (first i64) (second i64)] (-> void)
  (let [saved (get edges first)]
    (set! (mut edges) first (get edges second))
    (set! (mut edges) second saved)))

(defn sift! [(edges (mut (ArrayList Edge))) (root i64) (end i64)] (-> void)
  (let [(mut current) root
        (mut done) false]
    (while (and (not done) (< current (/ end 2)))
      (let [(mut child) (+ (* current 2) 1)]
        (when (and (< (+ child 1) end)
                   (before? (get edges child) (get edges (+ child 1))))
          (set! child (+ child 1)))
        (if (not (before? (get edges current) (get edges child)))
            (set! done true)
            (do (swap! (mut edges) current child) (set! current child)))))))

(defn sort! [(edges (mut (ArrayList Edge)))] (-> void)
  (let [(mut i) (/ (len edges) 2)
        (mut end) (len edges)]
    (while (> i 0) (set! i (- i 1)) (sift! (mut edges) i end))
    (while (> end 1)
      (set! end (- end 1))
      (swap! (mut edges) 0 end)
      (sift! (mut edges) 0 end))))

;;; Upstream's minimum-RPO worklist, predecessor restart and empty-chain
;;; continuation order. Backedges do not feed the static frequency estimate.
(defn frequencies! [(facts Facts)
                    (chains (mut (ArrayList Chain)))
                    (frequency (mut (ArrayList f32)))
                    (edges (mut (ArrayList Edge)))
                    (deferred (mut (ArrayList i32)))
                    (allocator (dyn Allocator))] (-> void)
  (let [(mut pending) (bits/create (len (.items facts)) allocator)
        (mut visited) (bits/create (len (.items facts)) allocator)]
    (when (> (len (.items facts)) 1) (bits/add! (mut pending) 1))
    (let [(mut first) (bits/next-set pending 1)]
      (while (>= first 0)
        (bits/remove! (mut pending) first)
        (let [(mut rank) (cast i32 first)
              (mut restart) true]
          (while restart
            (set! restart false)
            (let [incoming (get (.ranges (.predecessors facts)) (cast i64 rank))
                  (mut index) 0]
              (while (and (not restart) (< index (.count incoming)))
                (let [edge
                        (get (.edges facts)
                             (get (.edges (.predecessors facts))
                                  (+ (.offset incoming) index)))
                      predecessor (.from edge)]
                  (when (and (< predecessor rank)
                             (not (bits/contains? visited
                                                  (cast i64 predecessor))))
                    (set! rank predecessor)
                    (bits/remove! (mut pending) (cast i64 rank))
                    (set! restart true)))
                (set! index (+ index 1))))
            (unless restart
              (bits/add! (mut visited) (cast i64 rank))
              (let [number (cast i64 rank)
                    block (get (.items facts) number)
                    count (degree facts rank)]
                (if (.empty block)
                    (do
                      (set! (.head (elem (mut chains) number)) 0)
                      (push! (mut deferred) rank)
                      (let [target (successor facts rank 0)]
                        (when (> target rank)
                          (set! (mut frequency)
                                (cast i64 target)
                                (+ (get frequency (cast i64 target))
                                   (get frequency number)))
                          (set! rank target)
                          (bits/remove! (mut pending) (cast i64 rank))
                          (set! restart true))))
                    (when (!= (.head (get chains number)) 0)
                      (when (.header block)
                        (set! (mut frequency)
                              number
                              (* (get frequency number) 10.0)))
                      (let [weight
                              (if (and (= count 2) (= (.end-op block) 116))
                                  (if-weight facts rank)
                                  (Weight
                                    :first 0
                                    :second 0
                                    :total 100))]
                        (for [index 0 count]
                          (let [target (successor facts rank index)
                                target-block
                                  (get (.items facts) (cast i64 target))
                                conditional
                                  (and (= count 2) (= (.end-op block) 116))
                                p
                                  (if conditional
                                      (if (= index 0)
                                          (.first weight)
                                          (.second weight))
                                      (if (= count 1)
                                          100
                                          (probability facts target count false)))
                                other
                                  (if (= index 0)
                                      (.second weight)
                                      (.first weight))
                                edge-frequency
                                  (/ (* (get frequency number) (cast f32 p))
                                     (cast f32 (.total weight)))
                                cold
                                  (and conditional
                                       (> target rank)
                                       (= (degree facts target) 0)
                                       (= (.probability target-block) 1))
                                (mut collected) false]
                            (when (> target rank)
                              (set! (mut frequency)
                                    (cast i64 target)
                                    (+ (get frequency (cast i64 target))
                                       edge-frequency))
                              (unless cold
                                (bits/add! (mut pending) (cast i64 target))))
                            (if cold
                                (do
                                  (set! (.head (elem (mut chains)
                                                     (cast i64 target)))
                                        0)
                                  (push! (mut deferred) target)
                                  (set! collected true))
                                (when (and conditional
                                           (> p other)
                                           (not (.empty target-block)))
                                  (let [head (.next (get chains number))]
                                    (when (and (= (.head (get chains
                                                              (cast i64 head)))
                                                  head)
                                               (= (.head (get chains
                                                              (cast i64 target)))
                                                  target)
                                               (!= head target))
                                      (join! (mut chains) head target)
                                      (set! collected true)))))
                            (unless collected
                              (push! (mut edges)
                                     (Edge
                                       :from rank
                                       :to (skip-empty facts target)
                                       :frequency edge-frequency))))))))))))
        (set! first (bits/next-set pending 1))))
    (bits/release! (mut visited))
    (bits/release! (mut pending))))

;;; Bottom-up Pettis-Hansen with upstream static frequencies, tie-breaking,
;;; early joins, loop rotation and final grouping. merge-empty-entry is disabled.
(defn bottom-up [(facts Facts)
                 (aligned (mut (ArrayList bool)))
                 (allocator (dyn Allocator))] (-> (ArrayList i32))
  (let [(mut chains) (ArrayList::new [Chain] allocator)
        (mut frequency) (ArrayList::new [f32] allocator)
        (mut edges) (ArrayList::new [Edge] allocator)
        (mut output) (ArrayList::new [i32] allocator)
        (mut deferred) (ArrayList::new [i32] allocator)]
    (reserve! (mut chains) (len (.items facts)))
    (for [i 0 (len (.items facts))]
      (push! (mut chains)
             (Chain
               :head (cast i32 i)
               :next (cast i32 i)
               :previous (cast i32 i)))
      (push! (mut frequency) 0.0))
    (when (> (len frequency) 1) (set! (mut frequency) 1 1.0))
    (frequencies! facts
                  (mut chains)
                  (mut frequency)
                  (mut edges)
                  (mut deferred)
                  allocator)
    (sort! (mut edges))
    (for [index 0 (len edges)]
      (let [edge (get edges index)
            target (.to edge)]
        (when (= (.head (get chains (cast i64 target))) target)
          (let [source (.next (get chains (cast i64 (.from edge))))]
            (when (= (.head (get chains (cast i64 source))) source)
              (if (!= source target)
                  (join! (mut chains) source target)
                  (when (< (degree facts (.from edge)) 2)
                    (let [(mut previous) source
                          (mut next) (.next (get chains (cast i64 source)))
                          (mut best) (: 0 i32)
                          (mut done) false]
                      (while (and (!= previous (.from edge)) (not done))
                        (let [block (get (.items facts) (cast i64 previous))]
                          (when (= (.end-op block) 116)
                            (if (and (= (.start-op block) 113)
                                     (> (.depth block) 1))
                                (do (set! best next) (set! done true))
                                (when (or (= best 0)
                                          (< (get frequency (cast i64 next))
                                             (get frequency (cast i64 best))))
                                  (set! best next)))))
                        (set! previous next)
                        (set! next (.next (get chains (cast i64 next)))))
                      (when (> best 0)
                        (set! (.head (elem (mut chains) (cast i64 source)))
                              best)
                        (set! (.head (elem (mut chains) (cast i64 best))) best)))))
              (set! (.from (elem (mut edges) index)) 0))))))
    ; A chain head in a cycle is aligned, including cycles through empty blocks.
    (let [items-103 (.edges facts) (mut for-index-103) (: 0 i64)] (while (< for-index-103 (len items-103)) (let [edge (get items-103 for-index-103)]
      (when (not (.empty (get (.items facts) (cast i64 (.from edge)))))
        (let [target (skip-empty facts (.to edge))]
          (when (and (= (.head (get chains (cast i64 target))) target)
                     (> (.depth (get (.items facts) (cast i64 target))) 0)
                     (= (chain-head! (mut chains) (.from edge)) target))
            (set! (mut aligned) (cast i64 target) true))))) (set! for-index-103 (+ for-index-103 1))))
    (let [items-102 edges (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [edge (get items-102 for-index-102)]
      (when (> (.from edge) 0)
        (let [source (chain-head! (mut chains) (.from edge))
              target (chain-head! (mut chains) (.to edge))]
          (when (!= source target)
            (if (= target 1)
                (join! (mut chains) target source)
                (join! (mut chains) source target)))))) (set! for-index-102 (+ for-index-102 1))))
    (for [i 1 (len chains)]
      (when (= (.head (get chains i)) (cast i32 i))
        (let [(mut rank) (cast i32 i)
              tail (.previous (get chains i))
              (mut done) false]
          (while (not done)
            (push! (mut output) rank)
            (if (= rank tail)
                (set! done true)
                (set! rank (.next (get chains (cast i64 rank)))))))))
    (let [(mut index) (len deferred)]
      (while (> index 0)
        (set! index (- index 1))
        (push! (mut output) (get deferred index))))
    (free! (mut deferred))
    (free! (mut edges))
    (free! (mut frequency))
    (free! (mut chains))
    output))

(defn top-down [(facts Facts) (allocator (dyn Allocator))] (-> (ArrayList i32))
  (let [(mut pending) (bits/create (len (.items facts)) allocator)
        (mut output) (ArrayList::new [i32] allocator)
        (mut deferred) (ArrayList::new [i32] allocator)]
    (for [i 1 (len (.items facts))] (bits/add! (mut pending) i))
    (let [(mut first) (bits/next-set pending 1)]
      (while (>= first 0)
        (let [(mut rank) (cast i32 first)
              (mut last) (: 0 i32)
              (mut done) false]
          (bits/remove! (mut pending) first)
          (while (not done)
            (let [block (get (.items facts) (cast i64 rank))
                  count (degree facts rank)
                  (mut best) (: 0 i32)
                  (mut best-probability) (: 0 i32)]
              (if (.empty block)
                  (push! (mut deferred) rank)
                  (do (push! (mut output) rank) (set! last rank)))
              (for [i 0 count]
                (let [target (successor facts rank i)]
                  (when (bits/contains? pending (cast i64 target))
                    (let [p (probability facts target count true)]
                      (when (or (= best 0)
                                (> (.depth (get (.items facts)
                                                (cast i64 target)))
                                   (.depth (get (.items facts) (cast i64 best))))
                                (> p best-probability))
                        (set! best target)
                        (set! best-probability p))))))
              (when (and (= best 0)
                         (.empty block)
                         (> last 0)
                         (= (degree facts last) 2)
                         (= (.end-op (get (.items facts) (cast i64 last))) 116))
                (let [first-target (successor facts last 0)
                      second-target (successor facts last 1)]
                  (if (bits/contains? pending (cast i64 first-target))
                      (set! best first-target)
                      (when (bits/contains? pending (cast i64 second-target))
                        (set! best second-target)))))
              (if (= best 0)
                  (set! done true)
                  (do
                    (bits/remove! (mut pending) (cast i64 best))
                    (set! rank best))))))
        (set! first (bits/next-set pending 1))))
    (let [(mut i) (len deferred)]
      (while (> i 0) (set! i (- i 1)) (push! (mut output) (get deferred i))))
    (free! (mut deferred))
    (bits/release! (mut pending))
    output))

;;; Caller supplies verified graph/preparation and post-allocation empty facts.
(defn build [(graph g/Graph)
             (prepared pipeline/Prepared)
             (empty (ArrayList bool))
             (predict bool)
             (allocator (dyn Allocator))] (-> Plan)
  (let [(mut metadata) (facts graph prepared empty allocator)
        (mut aligned) (ArrayList::new [bool] allocator)
        large (or (.irreducible metadata) (> (len (.items metadata)) 257))
        (mut ranks) (ArrayList::new [i32] allocator)]
    (when predict (predict! graph prepared (mut metadata) allocator))
    (fill/append! (mut aligned) (len (.items metadata)) false)
    (set! ranks
          (if (<= (len (.items metadata)) 3)
              (let [(mut direct) (ArrayList::new [i32] allocator)]
                (for [i 1 (len (.items metadata))]
                  (push! (mut direct) (cast i32 i)))
                direct)
              (if large
                  (top-down metadata allocator)
                  (bottom-up metadata (mut aligned) allocator))))
    (let [result
            (assemble graph
                      (.schedule prepared)
                      metadata
                      ranks
                      aligned
                      large
                      allocator)]
      (free! (mut ranks))
      (free! (mut aligned))
      (release-facts! (mut metadata))
      result)))

(defn assemble [(graph g/Graph)
                (scheduled schedule/Schedule)
                (facts Facts)
                (ranks (ArrayList i32))
                (aligned (ArrayList bool))
                (large bool)
                (allocator (dyn Allocator))] (-> Plan)
  (let [(mut result)
          (Plan
            :indices (ArrayList::new [i64] allocator)
            :next (ArrayList::new [i32] allocator)
            :aliases (ArrayList::new [i32] allocator)
            :alignment (ArrayList::new [i32] allocator)
            :blocks (ArrayList::new [i32] allocator)
            :top-down large)]
    (reserve! (mut (.aliases result)) (len (.instructions graph)))
    (for [i 0 (len (.instructions graph))]
      (push! (mut (.aliases result)) (cast i32 i)))
    (fill/append! (mut (.alignment result)) (len (.instructions graph)) 4)
    (extend-zeroed! (mut (.next result)) (len (.nodes scheduled)))
    (for [i 1 (len (.items facts))]
      (let [block (get (.items facts) i)
            reference (.reference block)]
        (set! (mut (.aliases result))
              (cast i64 reference)
              (.reference (get (.items facts)
                               (cast i64 (skip-empty facts (cast i32 i))))))
        (when (get aligned i)
          (set! (mut (.alignment result)) (cast i64 reference) 8))))
    (let [items-101 ranks (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [rank (get items-101 for-index-101)]
      (let [block (get (.items facts) (cast i64 rank))]
        (unless (.empty block)
          (push! (mut (.blocks result)) (.reference block))))) (set! for-index-101 (+ for-index-101 1))))
    (for [i 0 (len (.blocks result))]
      (let [reference (get (.blocks result) i)
            range (get (.ranges scheduled) (cast i64 reference))
            next
              (if (< (+ i 1) (len (.blocks result)))
                  (get (.blocks result) (+ i 1))
                  0)]
        (for [j 0 (.count range)]
          (let [position (+ (.offset range) j)]
            (push! (mut (.indices result)) position)
            (set! (mut (.next result)) position next)))))
    result))

;;; Legacy lower-level emission retains its supplied physical order.
(defn identity [(graph g/Graph)
                (scheduled schedule/Schedule)
                (allocator (dyn Allocator))] (-> Plan)
  (let [(mut result)
          (Plan
            :indices (ArrayList::new [i64] allocator)
            :next (ArrayList::new [i32] allocator)
            :aliases (ArrayList::new [i32] allocator)
            :alignment (ArrayList::new [i32] allocator)
            :blocks (ArrayList::new [i32] allocator)
            :top-down false)]
    (reserve! (mut (.aliases result)) (len (.instructions graph)))
    (for [i 0 (len (.instructions graph))]
      (push! (mut (.aliases result)) (cast i32 i)))
    (fill/append! (mut (.alignment result)) (len (.instructions graph)) 4)
    (reserve! (mut (.indices result)) (len (.nodes scheduled)))
    (reserve! (mut (.next result)) (len (.nodes scheduled)))
    (for [i 0 (len (.nodes scheduled))]
      (push! (mut (.indices result)) i)
      (push! (mut (.next result)) 0)
      (let [reference (get (.nodes scheduled) i)]
        (when (or (= i 0)
                  (> (.count (get (.ranges scheduled) (cast i64 reference))) 0))
          (when (= (.offset (get (.ranges scheduled) (cast i64 reference))) i)
            (push! (mut (.blocks result)) reference)))))
    (for [i 0 (len (.blocks result))]
      (let [reference (get (.blocks result) i)
            range (get (.ranges scheduled) (cast i64 reference))
            next
              (if (< (+ i 1) (len (.blocks result)))
                  (get (.blocks result) (+ i 1))
                  0)]
        (for [j 0 (.count range)]
          (set! (mut (.next result)) (+ (.offset range) j) next))))
    result))
