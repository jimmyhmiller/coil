;;; Numeric parameter specialization over an owned copy of the same compact IR.
(module stogir.parameter-specialize)
(export Binding Condition Specialized specialize release! bindings-match?)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.sccp" :as sccp)
(import "stogir.sccp-rewrite" :as rewrite)
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Option Some None])

(defstruct Binding [(parameter i32) (bits u64)])
(defstruct Condition [(ordinal i32) (ty i32) (bits u64)])
;;; This is equivalent to its source only under every attached condition. It is
;;; never an unconditional replacement definition or an alternative registry view.
(defstruct Specialized [(body rewrite/Rewritten) (conditions (ArrayList Condition)) (pointer-bytes i32)])

(defn release! [(value (mut Specialized))] (-> void)
  (rewrite/release! (mut (.body value)))
  (free! (mut (.conditions value))))

;;; Checks only the attached numeric argument conditions. Ordinary inliner
;;; identity, prototype, Never, recursion, ownership and budget proofs still apply.
;;; Named addresses are not numeric literal identities, even if payload IDs match.
(defn bindings-match? [(value Specialized) (caller g/Graph) (reference i32)
                       (pointer-bytes i32)] (-> bool)
  (if (!= pointer-bytes (.pointer-bytes value)) false
    (match (calls/validate-call caller reference)
    (Err [_] false)
    (Ok [_]
      (let [(mut good) true]
        (for condition (.conditions value)
          (match (g/operand caller reference (+ (.ordinal condition) 3))
            (None [] (set! good false))
            (Some [actual]
              (match (g/lookup caller actual)
                (None [] (set! good false))
                (Some [node]
                  (unless (and (< actual 0) (= (cast i32 (n/opcode node)) (.ty condition))
                               (= (cast i32 (n/type-id node)) (.ty condition))
                               (= (n/constant-bits node) (.bits condition)))
                    (set! good false)))))))
        good)))))

;;; Source validation precedes edits, so binding cannot hide malformed original
;;; instructions. Each PARAM is bound at its original reference with a typed COPY.
;;; SCCP owns the next analysis epoch and preserves/remaps the supplied roots.
;;; The source is immutable; failure releases all partially constructed storage.
(defn specialize [(source g/Graph) (roots (slice i32)) (bindings (slice Binding))
                  (pointer-bytes i32) (a (dyn Allocator))]
  (-> (Result Specialized (slice u8)))
  (match (rewrite/validate source pointer-bytes a)
    (Err [message] (Err message))
    (Ok [_]
      (let [(mut graph) (g/duplicate source a)
            (mut conditions) (ArrayList::new [Condition] a)
            (mut ordinals) (HashMap::new-scalar [i32 bool] a)
            (mut error) ""]
        (match (g/rebuild-constant-index! (mut graph) pointer-bytes)
          (Err [message] (set! error message)) (Ok [_] 0))
        (when (= (len bindings) 0) (set! error "parameter specialization requires bindings"))
        (for binding bindings
          (when (= error "")
            (let [reference (.parameter binding)]
              (match (g/lookup source reference)
                (None [] (set! error "specialization parameter missing"))
                (Some [node]
                  (if (or (<= reference 0) (!= (n/opcode node) 71)
                          (!= (.op1 node) 1) (!= (get (.arities source) (cast i64 reference)) 3))
                      (set! error "specialization requires an entry PARAM")
                      (match (get ordinals (.op3 node))
                        (Some [_] (set! error "duplicate specialization parameter ordinal"))
                        (None []
                          (match (b/scalar-constant! (mut graph) (cast i32 (n/type-id node))
                                                    (.bits binding) pointer-bytes)
                            (Err [message] (set! error message))
                            (Ok [literal]
                              (if (not (g/rewrite-inputs! (mut graph) reference 68
                                                         (n/type-id node) [literal (: 0 i32)]))
                                  (set! error "specialization parameter rewrite failed")
                                  (do
                                    (set! (mut ordinals) (.op3 node) true)
                                    (push! (mut conditions)
                                      (Condition :ordinal (.op3 node)
                                                 :ty (cast i32 (n/type-id node))
                                                 :bits (.bits binding)))))))))))))))
        (free! (mut ordinals))
        (let [result
          (if (!= error "") (Err [Specialized (slice u8)] error)
            (match (sccp/optimize graph pointer-bytes roots a)
              (Err [message] (Err [Specialized (slice u8)] message))
              (Ok [body] (Ok [Specialized (slice u8)]
                            (Specialized :body body :conditions conditions :pointer-bytes pointer-bytes)))))]
          (g/release! (mut graph))
          (match result
            (Err [_] (free! (mut conditions)) 0)
            (Ok [_] 0))
          result)))))
