;;; Affine recurrence strength reduction over ordinary modular word arithmetic.
;;; This independent pass changes no memory/control operation or loop test.
(module stogir.loop-strength)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.builder" :as b)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "stogir.pipeline" :as pipeline)
(import "stogir.adjacency" :as adj)
(import "stogir.dominators" :as dom)
(import "stogir.loop-rotate" :as rotate)
(import "stogir.loop-load-hoist" :as hoist)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Option Some None some?])

;;; Kind: -1 unvisited, -2 pending, 0 unsupported, 1 entry-invariant, 2 affine.
(defstruct Fact [(kind i32) (product bool)])
(defstruct Work [(ref i32) (ready bool)])
(defstruct Plan [(header i32) (entry-slot i32) (back-slot i32) (phi i32)
                 (initial i32) (step i32) (subtract bool) (facts (ArrayList Fact))
                 (targets (ArrayList i32))])
(defstruct Reduced [(graph (Option g/Graph)) (recurrences i64)])

(defn width [(graph g/Graph) (ref i32)] (-> i32)
  (match (g/lookup graph ref)
    (None [] 0)
    (Some [node]
      (let [ty (cast i32 (n/type-id node))]
        (if (or (= ty 4) (= ty 5) (= ty 6) (= ty 10) (= ty 11))
            (types/scalar-size ty 8) 0)))))

(defn view? [(node n/Node)] (-> bool)
  (or (= (n/opcode node) 36) (and (= (n/opcode node) 68) (= (.op2 node) 0))))

(defn identity [(graph g/Graph) (ref i32) (bytes i32)] (-> i32)
  (let [(mut r) ref (mut done) false]
    (while (and (> r 0) (not done))
      (let [node (get (.instructions graph) (cast i64 r))]
        (if (and (view? node) (= (width graph r) bytes) (= (width graph (.op1 node)) bytes))
            (set! r (.op1 node)) (set! done true))))
    r))

(defn available? [(prepared pipeline/Prepared) (owners (ArrayList i32))
                  (inside (ArrayList bool)) (entry i32) (ref i32)] (-> bool)
  (or (< ref 0)
      (and (> ref 0)
           (> (get owners (cast i64 ref)) 0)
           (not (get inside (cast i64 (get owners (cast i64 ref)))))
           (dom/dominates? (.idom prepared) (get owners (cast i64 ref)) entry))))

(defn fact [(graph g/Graph) (facts (ArrayList Fact)) (ref i32) (bytes i32)] (-> Fact)
  (if (!= (width graph ref) bytes) (Fact :kind 0 :product false)
      (if (< ref 0) (Fact :kind 1 :product false)
          (get facts (cast i64 ref)))))

;;; Explicit postorder worklist: no recursion depth depends on expression size.
;;; Other PHIs, checked arithmetic, narrowing/extensions and hard COPY barriers
;;; decline. MUL requires an invariant side; variable-by-variable is nonlinear.
(defn analyze! [(graph g/Graph) (ref i32) (bytes i32)
                 (facts (mut (ArrayList Fact))) (work (mut (ArrayList Work)))] (-> void)
  (clear! (mut work)) (push! (mut work) (Work :ref ref :ready false))
  (while (> (len work) 0)
    (let [item (match (pop! (mut work)) (Some [x] x) (None [] (panic "strength worklist")))
          r (.ref item)]
      (when (and (> r 0) (or (.ready item) (= (.kind (get facts (cast i64 r))) -1)))
        (let [node (get (.instructions graph) (cast i64 r)) code (n/opcode node)
              unary (view? node)
              supported (and (= (width graph r) bytes)
                             (or unary (= code 26) (= code 27) (= code 28)
                                 (and (= code 49) (< (.op2 node) 0))))]
          (cond
            (not supported) (set! (mut facts) (cast i64 r) (Fact :kind 0 :product false))
            (not (.ready item))
              (do
                (set! (mut facts) (cast i64 r) (Fact :kind -2 :product false))
                (push! (mut work) (Work :ref r :ready true))
                (unless unary (push! (mut work) (Work :ref (.op2 node) :ready false)))
                (push! (mut work) (Work :ref (.op1 node) :ready false)))
            :else
              (let [left (fact graph facts (.op1 node) bytes)
                    right (if unary (Fact :kind 1 :product false)
                              (fact graph facts (.op2 node) bytes))
                    valid (and (> (.kind left) 0) (> (.kind right) 0)
                               (not (and (= code 28) (= (.kind left) 2) (= (.kind right) 2))))]
                (set! (mut facts) (cast i64 r)
                  (Fact :kind (if (and valid (or (= (.kind left) 2) (= (.kind right) 2))) 2 0)
                    :product (and valid (or (= code 28) (.product left) (.product right))))))))))))

;;; Share a recurrence across representation views and constant field offsets.
;;; Those offsets remain available to normal load/store address selection.
(defn canonical [(graph g/Graph) (ref i32) (facts (ArrayList Fact))] (-> i32)
  (let [(mut r) ref (mut done) false]
    (while (and (> r 0) (not done))
      (let [node (get (.instructions graph) (cast i64 r)) code (n/opcode node)
            next (cond (view? node) (.op1 node)
                       (and (or (= code 26) (= code 27)) (literal? graph (.op2 node))) (.op1 node)
                       (and (= code 26) (literal? graph (.op1 node))) (.op2 node)
                       :else 0)]
        (if (and (> next 0) (= (.kind (get facts (cast i64 next))) 2)
                 (.product (get facts (cast i64 next))))
            (set! r next) (set! done true))))
    r))

(defn literal? [(graph g/Graph) (ref i32)] (-> bool)
  (and (< ref 0) (match (g/lookup graph ref) (Some [node] (symbols/numeric? node)) (None [] false))))

(defn release-plan! [(plan (mut Plan))] (-> void)
  (free! (mut (.facts plan))) (free! (mut (.targets plan))))

(defn find-phi [(graph g/Graph) (prepared pipeline/Prepared) (owners (ArrayList i32))
                (inside (ArrayList bool)) (roots (slice i32)) (header i32)
                (entry i32) (entry-slot i32) (back-slot i32) (phi i32) (a (dyn Allocator))]
  (-> (Option Plan))
  (let [bytes (width graph phi)
        initial (match (g/operand graph phi (+ entry-slot 1)) (Some [r] r) (None [] 0))
        back (match (g/operand graph phi (+ back-slot 1)) (Some [r] r) (None [] 0))
        next (identity graph back bytes)]
    (if (or (= bytes 0) (<= next 0)) (None)
        (let [update (get (.instructions graph) (cast i64 next)) code (n/opcode update)
              left (identity graph (.op1 update) bytes) right (identity graph (.op2 update) bytes)
              step (cond (and (or (= code 26) (= code 27)) (= left phi)) (.op2 update)
                         (and (= code 26) (= right phi)) (.op1 update) :else 0)]
          (if (not (and (!= step 0) (= (width graph next) bytes)
                        (= (width graph step) bytes)
                        (available? prepared owners inside entry step))) (None)
              (let [(mut facts) (ArrayList::new [Fact] a) (mut work) (ArrayList::new [Work] a)
                    (mut targets) (ArrayList::new [i32] a)]
                (for [i 0 (len (.instructions graph))]
                  (push! (mut facts) (Fact :kind (if (and (> i 0)
                    (available? prepared owners inside entry (cast i32 i))) 1 -1) :product false)))
                (set! (mut facts) (cast i64 phi) (Fact :kind 2 :product false))
                (for r (.nodes (.schedule prepared))
                  (when (get inside (cast i64 (get owners (cast i64 r))))
                    (analyze! graph r bytes (mut facts) (mut work))))
                (for r (.nodes (.schedule prepared))
                  (when (and (= (.kind (get facts (cast i64 r))) 2)
                             (.product (get facts (cast i64 r))))
                    (let [(mut boundary) false range (get (.ranges (.users prepared)) (cast i64 r))]
                      (for root roots (when (= root r) (set! boundary true)))
                      (for [i 0 (.count range)]
                        (let [user (.user (get (.edges (.users prepared)) (+ (.offset range) i)))]
                          (when (!= (.kind (get facts (cast i64 user))) 2) (set! boundary true))))
                      (when boundary
                        (let [target (canonical graph r facts)]
                          (unless (hoist/includes? targets target) (push! (mut targets) target)))))))
                (free! (mut work))
                (if (= (len targets) 0) (do (free! (mut facts)) (free! (mut targets)) (None))
                    (Some (Plan :header header :entry-slot entry-slot :back-slot back-slot :phi phi
                      :initial initial :step step :subtract (= code 27) :facts facts :targets targets)))))))))

;;; One reachable external entry and one natural back edge, in either PHI slot.
;;; The loop body may branch, call, write memory, contain nested loops or exit
;;; early. Only availability and arithmetic identities justify the transformation.
(defn find [(graph g/Graph) (prepared pipeline/Prepared) (roots (slice i32)) (a (dyn Allocator))]
  (-> (Option Plan))
  (let [(mut owners) (rotate/block-map graph prepared a) (mut pred) (adj/build (.blocks prepared) true a)
        (mut found) (None [Plan])]
    (for header (.order prepared)
      (when (and (not (some? found)) (= (get (.arities graph) (cast i64 header)) 2)
                 (or (= (hoist/opcode graph header) 112) (= (hoist/opcode graph header) 113)))
        (let [(mut entry) (: 0 i32) (mut back) (: 0 i32)
              (mut entry-slot) (: 0 i32) (mut back-slot) (: 0 i32) (mut valid) true
              range (get (.ranges pred) (cast i64 header))]
          (for [i 0 (.count range)]
            (let [edge (get (.edges (.blocks prepared)) (get (.edges pred) (+ (.offset range) i)))]
              (cond (or (<= (.from edge) 0) (= (get (.idom prepared) (cast i64 (.from edge))) 0))
                      (set! valid false)
                    (dom/dominates? (.idom prepared) header (.from edge))
                      (if (!= back 0) (set! valid false)
                          (do (set! back (.from edge)) (set! back-slot (.position edge))))
                    :else (if (!= entry 0) (set! valid false)
                              (do (set! entry (.from edge)) (set! entry-slot (.position edge)))))))
          (when (and valid (> entry 0) (> back 0))
            (let [(mut latches) (ArrayList::new [i32] a)]
              (push! (mut latches) back)
              (match (hoist/members graph prepared pred header latches a)
                (None [] 0)
                (Some [inside]
                  (let [(mut inside) inside span (get (.ranges (.schedule prepared)) (cast i64 header))]
                    (for [i (.offset span) (+ (.offset span) (.count span))]
                      (let [r (get (.nodes (.schedule prepared)) i) node (get (.instructions graph) (cast i64 r))]
                        (when (and (not (some? found)) (= (n/opcode node) 67) (= (.op1 node) header)
                                   (= (get (.arities graph) (cast i64 r)) 3))
                          (set! found (find-phi graph prepared owners inside roots header entry entry-slot back-slot r a)))))
                    (free! (mut inside)))))
              (free! (mut latches)))))))
    (adj/release! (mut pred)) (free! (mut owners)) found))

(defn emit! [(graph (mut g/Graph)) (code i32) (ty i32) (inputs (slice i32))
             (error (ptr (slice u8)))] (-> i32)
  (if (!= (load error) "") 0
      (match (b/emit! (mut graph) code ty inputs)
        (Ok [r] r) (Err [message] (store! error message) 0))))
(defn zero! [(graph (mut g/Graph)) (ty i32) (error (ptr (slice u8)))] (-> i32)
  (if (!= (load error) "") 0
      (match (b/scalar-constant! (mut graph) ty 0 8)
        (Ok [r] r) (Err [message] (store! error message) 0))))
(defn view! [(graph (mut g/Graph)) (ref i32) (ty i32) (error (ptr (slice u8)))] (-> i32)
  (if (!= (load error) "") 0
      (match (g/lookup graph ref)
        (None [] (store! error "strength input missing") 0)
        (Some [node] (if (= (cast i32 (n/type-id node)) ty) ref
                        (emit! (mut graph) 36 ty [ref] error))))))
(defn initial-ref [(map (ArrayList i32)) (ref i32)] (-> i32)
  (if (and (> ref 0) (!= (get map (cast i64 ref)) 0)) (get map (cast i64 ref)) ref))

;;; Clone the initial expression and its exact per-iteration difference.
;;; In Z/(2^width), d(a+b)=da+db and d(a*b)=da*b for invariant b.
(defn materialize! [(graph (mut g/Graph)) (plan Plan) (target i32)
                    (initials (mut (ArrayList i32))) (deltas (mut (ArrayList i32)))
                    (work (mut (ArrayList Work))) (error (ptr (slice u8)))] (-> void)
  (clear! (mut work)) (push! (mut work) (Work :ref target :ready false))
  (while (and (= (load error) "") (> (len work) 0))
    (let [item (match (pop! (mut work)) (Some [x] x) (None [] (panic "strength materialize")))
          r (.ref item)]
      (when (and (> r 0) (= (.kind (get (.facts plan) (cast i64 r))) 2)
                 (= (get initials (cast i64 r)) 0))
        (let [node (get (.instructions graph) (cast i64 r)) code (cast i32 (n/opcode node))
              ty (cast i32 (n/type-id node)) unary (view? node)]
          (if (not (.ready item))
              (do (push! (mut work) (Work :ref r :ready true))
                  (unless unary (push! (mut work) (Work :ref (.op2 node) :ready false)))
                  (push! (mut work) (Work :ref (.op1 node) :ready false)))
              (let [left (initial-ref initials (.op1 node)) right (if unary 0 (initial-ref initials (.op2 node)))
                    dl (if (> (.op1 node) 0) (get deltas (cast i64 (.op1 node))) 0)
                    dr (if (and (not unary) (> (.op2 node) 0)) (get deltas (cast i64 (.op2 node))) 0)
                    seed (emit! (mut graph) code ty
                           (if (= code 36) [left] (if (= code 68) [left (: 0 i32)] [left right])) error)
                    delta
                      (cond unary (view! (mut graph) dl ty error)
                            (or (= code 28) (= code 49))
                              (emit! (mut graph) code ty
                                (if (!= dl 0) [dl (.op2 node)] [(.op1 node) dr]) error)
                            (and (!= dl 0) (!= dr 0)) (emit! (mut graph) code ty [dl dr] error)
                            (!= dl 0) (view! (mut graph) dl ty error)
                            (= code 26) (view! (mut graph) dr ty error)
                            :else (let [zero (zero! (mut graph) ty error)]
                                    (emit! (mut graph) 27 ty [zero dr] error)))]
                (set! (mut initials) (cast i64 r) seed) (set! (mut deltas) (cast i64 r) delta))))))))

(defn apply! [(graph (mut g/Graph)) (plan Plan) (a (dyn Allocator))] (-> (Result i64 (slice u8)))
  (let [(mut initials) (ArrayList::new [i32] a) (mut deltas) (ArrayList::new [i32] a)
        (mut phis) (ArrayList::new [i32] a) (mut work) (ArrayList::new [Work] a) (mut error) ""
        ty (cast i32 (n/type-id (get (.instructions graph) (cast i64 (.phi plan)))))]
    (extend-zeroed! (mut initials) (len (.facts plan))) (extend-zeroed! (mut deltas) (len (.facts plan)))
    (set! (mut initials) (cast i64 (.phi plan)) (.initial plan))
    (let [step (view! (mut graph) (.step plan) ty (mut error))
          delta (if (.subtract plan)
                    (let [zero (zero! (mut graph) ty (mut error))]
                      (emit! (mut graph) 27 ty [zero step] (mut error))) step)]
      (set! (mut deltas) (cast i64 (.phi plan)) delta))
    (for target (.targets plan)
      (when (= error "")
        (materialize! (mut graph) plan target (mut initials) (mut deltas) (mut work) (mut error))
        (let [ty (cast i32 (n/type-id (get (.instructions graph) (cast i64 target))))
              initial (get initials (cast i64 target))
              phi (emit! (mut graph) 67 ty [(.header plan) initial initial] (mut error))
              next (emit! (mut graph) 26 ty [phi (get deltas (cast i64 target))] (mut error))]
          (when (and (= error "") (not (g/set-operand! (mut graph) phi (+ (.back-slot plan) 1) next)))
            (set! error "strength recurrence patch failed"))
          (push! (mut phis) phi))))
    ; Finish all clones before editing any original definition. References and
    ; roots remain stable; each original expression now reads its recurrence.
    (when (= error "")
      (for [i 0 (len (.targets plan))]
        (let [target (get (.targets plan) i) ty (n/type-id (get (.instructions graph) (cast i64 target)))]
          (unless (g/rewrite-inputs! (mut graph) target 68 ty [(get phis i) (: 0 i32)])
            (set! error "strength expression replacement failed")))))
    (free! (mut initials)) (free! (mut deltas)) (free! (mut phis)) (free! (mut work))
    (if (= error "") (Ok (len (.targets plan))) (Err error))))

;;; Rebuild proof facts after each batch. Products move outside their natural
;;; loop; new updates contain only ADD. Nested-loop reduction can repeat, but
;;; no stale scheduling/use/dominance facts cross a graph edit.
(defn run [(source g/Graph) (entry i32) (roots (slice i32)) (a (dyn Allocator))]
  (-> (Result Reduced (slice u8)))
  (let [(mut working) (None [g/Graph]) (mut count) (: 0 i64) (mut done) false (mut error) ""]
    (while (and (not done) (= error ""))
      (let [graph (match working (Some [owned] owned) (None [] source))]
        (match (pipeline/prepare graph entry roots a)
          (Err [message] (set! error message))
          (Ok [prepared]
            (let [(mut prepared) prepared plan (find graph prepared roots a)]
              (pipeline/release! (mut prepared))
              (match plan
                (None [] (set! done true))
                (Some [selected]
                  (let [(mut selected) selected
                        (mut owned) (match working (Some [owned] owned) (None [] (g/duplicate source a)))]
                    (match (apply! (mut owned) selected a)
                      (Err [message] (set! error message)) (Ok [n] (set! count (+ count n))))
                    (release-plan! (mut selected)) (set! working (Some owned))))))))))
    (if (= error "") (Ok (Reduced :graph working :recurrences count))
        (do (match working (None [] 0) (Some [owned] (let [(mut owned) owned] (g/release! (mut owned)))))
            (Err error)))))
