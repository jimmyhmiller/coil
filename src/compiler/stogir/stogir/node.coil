; Ported/adapted from dstogov/ir (ir.h), commit 92171d0. See NOTICE.
;;; A 16-byte instruction cell matching upstream's four 32-bit words.
;;; References are signed cell indices: zero is absent, negatives are constants.
;;; The auxiliary header halfword holds input count, CSE offset, or prototype.
(module stogir.node)

(defstruct Node [(header u32) (op1 i32) (op2 i32) (op3 i32)])

(defn make [(opcode u8) (ty u8) (aux u16) (a i32) (b i32) (c i32)] (-> Node)
  (Node
    :header (| (cast u32 opcode) (<< (cast u32 ty) 8) (<< (cast u32 aux) 16))
    :op1 a
    :op2 b
    :op3 c))

(defn opcode [(n Node)] (-> u8)
  (cast u8 (& (.header n) 255)))

(defn type-id [(n Node)] (-> u8)
  (cast u8 (& (>> (.header n) 8) 255)))

(defn auxiliary [(n Node)] (-> u16)
  (cast u16 (>> (.header n) 16)))

;;; Constant payload uses the last two words without numeric float conversion.
(defn constant [(opcode u8) (ty u8) (previous i32) (bits u64)] (-> Node)
  (make opcode
        ty
        0
        previous
        (cast i32 (& bits 0xFFFFFFFF))
        (cast i32 (>> bits 32))))

(defn constant-bits [(n Node)] (-> u64)
  (| (cast u64 (cast u32 (.op2 n))) (<< (cast u64 (cast u32 (.op3 n))) 32)))

;;; Variable-arity cells use ceil((input-count + header-word)/4) cells.
(defn input-cells [(input-count u16)] (-> i32)
  (/ (+ (cast i32 input-count) 4) 4))

;;; Raw long-constant cells are byte payload, independent of opcode fields.
;;; The checked graph accessor bounds the byte index to0..15.
(defn payload-byte [(node Node) (index i32)] (-> u8)
  (let [word
          (match (/ index 4)
            (0 (.header node))
            (1 (cast u32 (.op1 node)))
            (2 (cast u32 (.op2 node)))
            (_ (cast u32 (.op3 node))))]
    (cast u8 (>> word (cast u32 (* (% index 4) 8))))))

(defn payload-cell [(payload (slice u8)) (offset i64)] (-> Node)
  (let [(mut words) [(: 0 u32) 0 0 0]
        (mut i) (: 0 i64)]
    (while (< i 16)
      (when (and (>= (+ offset i) 0) (< (+ offset i) (len payload)))
        (let [word (/ i 4)]
          (set! (mut words)
                word
                (| (get words word)
                   (<< (cast u32 (get payload (+ offset i)))
                       (cast u32 (* (% i 4) 8)))))))
      (set! i (+ i 1)))
    (Node
      :header (get words 0)
      :op1 (cast i32 (get words 1))
      :op2 (cast i32 (get words 2))
      :op3 (cast i32 (get words 3)))))
