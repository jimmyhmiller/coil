;;; Non-escaping aggregate splitting follows pinned ir_mem2ssa.c. See NOTICE.
;;; Typed fields become SSA values across joins and loops. Uninitialized paths
;;; conservatively retain storage.
(module stogir.mem2ssa)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "stogir.stack" :as stack)
(import "stogir.uses" :as uses)
(import "stogir.dead-code" :as dead)
(import "stogir.mem2ssa-state" :use [Cell])
(import "stogir.mem2ssa-flow" :as flow)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn zeros [(size i64) (a (dyn Allocator))] (-> (ArrayList i32))
  (let [(mut result) (ArrayList::new [i32] a)]
    (reserve! (mut result) size)
    (for [i 0 size] (push! (mut result) 0))
    result))

(defn resolve [(mapping (ArrayList i32)) (reference i32)] (-> i32)
  (let [(mut r) reference
        (mut steps) 0]
    (while (and (> r 0)
                (< (cast i64 r) (len mapping))
                (!= (get mapping (cast i64 r)) 0))
      (set! r (get mapping (cast i64 r)))
      (set! steps (+ steps 1))
      (when (> steps (len mapping)) (panic "cyclic promotion replacement")))
    r))

(defn covers? [(outer-offset i64) (outer-size i32)
                (inner-offset i64) (inner-size i32)] (-> bool)
  (and (<= outer-offset inner-offset)
       (>= (+ outer-offset (cast i64 outer-size))
           (+ inner-offset (cast i64 inner-size)))))

;;; Same-width scalar views preserve bits through BITCAST as upstream does.
;;; Explicit little-endian policy also permits contained narrower integer views.
;;; Partial stores preserve every untouched byte in the canonical field.
;;; Crossing overlaps and mixed-width BOOL/pointer views retain memory.
(defn cell-ordered! [(cells (mut (ArrayList Cell)))
             (start i64)
             (owner i32)
             (offset i64)
             (size i32)
             (ty u8)
             (little-endian bool)]
  (-> i32)
  (let [(mut found) (: 0 i32)
        (mut conflict) false]
    (for [i start (len cells)]
      (let [cell (get cells i)]
        (when (and (< offset (+ (.offset cell) (cast i64 (.size cell))))
                   (< (.offset cell) (+ offset (cast i64 size))))
          (if (and (or (and (= offset (.offset cell)) (= size (.size cell)))
                       (and little-endian
                            (or (covers? (.offset cell) (.size cell) offset size)
                                (covers? offset size (.offset cell) (.size cell)))
                            (types/integer? (cast i32 ty))
                            (types/integer? (cast i32 (.ty cell)))
                            (!= ty 1) (!= ty 6)
                            (!= (.ty cell) 1) (!= (.ty cell) 6)))
                   (or (= found 0) (= found (cast i32 (+ i 1))))
                   (or (= ty (.ty cell))
                       (and (!= ty 1)
                            (!= (.ty cell) 1)
                            (types/valid-scalar? (cast i32 ty))
                            (types/valid-scalar? (cast i32 (.ty cell))))))
              (do
                (set! found (cast i32 (+ i 1)))
                ; All widest views precede narrower ones. A floating/pointer
                ; view forbids mixed-width promotion regardless of tie order.
                (when (and (= size (.size cell))
                           (or (= ty 6) (types/floating? (cast i32 ty))))
                  (let [(mut canonical) (get cells i)]
                    (set! (.ty canonical) ty)
                    (set! (mut cells) i canonical)))
                (when (> size (.size cell))
                  (let [(mut wider) cell]
                    (set! (.size wider) size)
                    (set! (.offset wider) offset)
                    (set! (.ty wider) ty)
                    (set! (mut cells) i wider))))
              (set! conflict true)))))
    (if conflict
        -1
        (if (> found 0)
            found
            (do
              (push! (mut cells)
                     (Cell
                       :owner owner
                       :offset offset
                       :size size
                       :ty ty
                       :value 0
                       :block 0))
              (cast i32 (len cells)))))))

(defstruct View [(reference i32) (offset i64) (width i32) (ty u8)])

(defn classify-accesses! [(const Fields bool)] [(graph g/Graph)
                 (edges uses/Uses)
                 (owner i32)
                 (extent i64)
                 (little-endian bool)
                 (owners (mut (ArrayList i32)))
                 (offsets (mut (ArrayList i32)))
                 (accesses (mut (ArrayList i32)))
                 (cells (mut (ArrayList Cell)))
                 (a (dyn Allocator))] (-> bool)
  (let [(mut work) (ArrayList::new [i32] a)
        (mut views) (ArrayList::new [View] a)
        (mut widths) (: 0 u64)
        start (len cells)
        (mut valid) true
        (mut cursor) 0]
    (push! (mut work) owner)
    (set! (mut owners) (cast i64 owner) owner)
    (while (and valid (< cursor (len work)))
      (let [pointer (get work cursor)
            offset (cast i64 (get offsets (cast i64 pointer)))
            range (get (.ranges edges) (cast i64 pointer))]
        (for [i (.offset range) (+ (.offset range) (.count range))]
          (let [edge (get (.edges edges) i)
                r (.user edge)
                node (get (.instructions graph) (cast i64 r))
                opcode (cast i32 (n/opcode node))]
            (cond (and (= pointer owner)
                       (= (.operand edge) 1)
                       (op/control? opcode)
                       (not (op/block-start? opcode)))
                    0
                  (and (or (= opcode 91) (= opcode 93)) (= (.operand edge) 2))
                    (let [ty
                            (if (= opcode 91)
                                (n/type-id node)
                                (match (g/lookup graph (.op3 node))
                                  (Some [v] (n/type-id v))
                                  (None [] (: 0 u8))))
                          size (types/size (cast i32 ty) 8)]
                      (if (or (<= size 0) (> (+ offset (cast i64 size)) extent))
                          (set! valid false)
                          (if Fields
                              (do
                                (push! (mut views) (View :reference r :offset offset :width size :ty ty))
                                (set! widths (| widths (cast u64 size))))
                              (set! (mut accesses) (cast i64 r) 1))))
                  (and (or (= opcode 68) (= opcode 36))
                       (= (.operand edge) 1)
                       (or (= (n/type-id node) 6)
                           (= (n/type-id node) 5)
                           (= (n/type-id node) 11))
                       (= (.op2 node) 0))
                    (do
                      (set! (mut owners) (cast i64 r) owner)
                      (set! (mut offsets) (cast i64 r) (cast i32 offset))
                      (push! (mut work) r))
                  (and (= opcode 26)
                       (= (.operand edge) 1)
                       (or (= (n/type-id node) 6)
                           (= (n/type-id node) 5)
                           (= (n/type-id node) 11))
                       (< (.op2 node) 0))
                    (match (g/lookup graph (.op2 node))
                      (None [] (set! valid false))
                      (Some [constant]
                            (let [bits (n/constant-bits constant)]
                              (if (or (not (symbols/numeric? constant))
                                      (not (types/integer? (cast i32
                                                                 (n/type-id constant))))
                                      (>= bits (cast u64 (- extent offset))))
                                  (set! valid false)
                                  (do
                                    (set! (mut owners) (cast i64 r) owner)
                                    (set! (mut offsets)
                                          (cast i64 r)
                                          (cast i32 (+ offset (cast i64 bits))))
                                    (push! (mut work) r))))))
                  :else (set! valid false))))
        (set! cursor (+ cursor 1))))
    ; Valid type sizes are powers of two up to512 bytes. Classify widest
    ; views first, independently of def-use order, so one wide initialization
    ; owns both adjacent narrow fields. Only populated size buckets are scanned.
    ; Crossing views without one containing canonical field conservatively fail.
    (when (and valid Fields)
      (let [(mut width) (: 512 i32)]
        (while (and valid (> width 0))
          (when (!= (& widths (cast u64 width)) 0)
            (for view views
              (when (and valid (= (.width view) width))
                (let [id (cell-ordered! (mut cells) start owner (.offset view)
                                        width (.ty view) little-endian)]
                  (if (< id 0)
                      (set! valid false)
                      (set! (mut accesses) (cast i64 (.reference view)) id))))))
          (set! width (/ width 2)))))
    (free! (mut views))
    (free! (mut work))
    valid))

;;; Field classification retains exact-width and optional little-endian rules.
(defn classify-ordered! [(graph g/Graph) (edges uses/Uses) (owner i32) (extent i64)
                         (little-endian bool) (owners (mut (ArrayList i32)))
                         (offsets (mut (ArrayList i32))) (accesses (mut (ArrayList i32)))
                         (cells (mut (ArrayList Cell))) (a (dyn Allocator))] (-> bool)
  (classify-accesses! [(const true)] graph edges owner extent little-endian
                       (mut owners) (mut offsets) (mut accesses) (mut cells) a))

;;; Effect analysis needs escape/bounds proof, not scalar replacement geometry.
;;; The same pointer walk marks each contained ordinary LOAD/STORE with1. Partial
;;; and overlapping accesses are legal here; they do not enable SSA promotion.
(defn classify-region! [(graph g/Graph) (edges uses/Uses) (owner i32) (extent i64)
                        (owners (mut (ArrayList i32))) (offsets (mut (ArrayList i32)))
                        (accesses (mut (ArrayList i32))) (a (dyn Allocator))] (-> bool)
  (let [(mut unused) (ArrayList::new [Cell] a)
        valid (classify-accesses! [(const false)] graph edges owner extent false
                                   (mut owners) (mut offsets) (mut accesses) (mut unused) a)]
    (free! (mut unused))
    valid))

;;; Requires a structurally verified 64-bit-target graph and valid positive roots.
;;; Mutates an owned graph, preserving reference numbers. Roots are updated for
;;; bypassed control effects; a rooted forwarded load remains an observable COPY.
;;; All analysis is local and discarded before SCCP/CFG/matching are rebuilt.
(defn promote-ordered! [(graph (mut g/Graph))
                (roots (mut (ArrayList i32)))
                (little-endian bool)
                (a (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [size (len (.instructions graph))
        (mut candidates) (ArrayList::new [i32] a)
        (mut scoped) false
        (mut r) 1]
    (while (< r size)
      (let [node (get (.instructions graph) r)
            opcode (cast i32 (n/opcode node))]
        (when (and (>= opcode 82) (<= opcode 84)) (set! scoped true))
        (when (and (= opcode 81) (< (.op2 node) 0))
          (match (g/lookup graph (.op2 node))
            (None [] 0)
            (Some [constant]
                  (let [bits (n/constant-bits constant)]
                    (when (and (symbols/numeric? constant)
                               (types/integer? (cast i32 (n/type-id constant)))
                               (> bits 0)
                               (<= bits 512))
                      (push! (mut candidates) (cast i32 r)))))))
        (set! r (+ r (/ (+ (cast i64 (get (.arities graph) r)) 4) 4)))))
    (let [(mut changes) (: 0 i32)
          (mut error) ""]
      (when (> (len candidates) 0)
        (let [(mut edges) (uses/build graph a)
              (mut owners) (zeros size a)
              (mut offsets) (zeros size a)
              (mut accesses) (zeros size a)
              (mut eligible) (zeros size a)
              (mut complete) (zeros size a)
              (mut next) (zeros size a)
              (mut data) (zeros size a)
              (mut casts) (zeros size a)
              (mut control) (zeros size a)
              (mut cells) (ArrayList::new [Cell] a)
              (mut blocks) (ArrayList::new [i32] a)
              (mut forked) false
              scopes-safe (or (not scoped) (stack/opaque-scopes? graph (slice roots) edges))]
          (set! changes
                (+ changes
                   (dead/prune! (mut graph) (mut edges) (slice roots) a)))
          (for owner candidates
            (let [node (get (.instructions graph) (cast i64 owner))
                  extent
                    (match (g/lookup graph (.op2 node))
                      (Some [v] (cast i64 (n/constant-bits v)))
                      (None [] 0))]
              (when (and (= (n/opcode node) 81)
                         scopes-safe
                         (or (not scoped) (stack/entry-allocation? graph owner))
                         (classify-ordered! graph
                                    edges
                                    owner
                                    extent
                                    little-endian
                                    (mut owners)
                                    (mut offsets)
                                    (mut accesses)
                                    (mut cells)
                                    a))
                (set! (mut eligible) (cast i64 owner) 1)
                (set! (mut complete) (cast i64 owner) 1))))
          ; Exposed pointer identity cannot be replaced by a scalar value.
          (for root roots
            (let [owner (get owners (cast i64 root))]
              (when (> owner 0) (set! (mut eligible) (cast i64 owner) 0))))
          (set! r 1)
          (while (< r size)
            (let [node (get (.instructions graph) r)
                  opcode (cast i32 (n/opcode node))]
              (if (op/block-start? opcode)
                  (push! (mut blocks) (cast i32 r))
                  (when (op/control? opcode)
                    (let [prev (cast i64 (.op1 node))]
                      (when (> (get next prev) 0) (set! forked true))
                      (set! (mut next) prev (cast i32 r)))))
              (set! r (+ r (/ (+ (cast i64 (get (.arities graph) r)) 4) 4)))))
          (unless forked
            (match (flow/apply! (mut graph)
                                blocks
                                next
                                accesses
                                offsets
                                eligible
                                (mut complete)
                                (mut cells)
                                (mut data)
                                (mut casts)
                                (mut control)
                                a)
              (Err [message] (set! error message))
              (Ok [count] (set! changes (+ changes count))))
            ; Remove storage/stores only when every load has an SSA replacement.
            (set! r 1)
            (while (< r size)
              (let [node (get (.instructions graph) r)
                    owner
                      (if (= (n/opcode node) 81)
                          (cast i32 r)
                          (let [id (get accesses r)]
                            (if (> id 0)
                                (.owner (get cells (cast i64 (- id 1))))
                                0)))]
                (when (and (> owner 0)
                           (> (get eligible (cast i64 owner)) 0)
                           (> (get complete (cast i64 owner)) 0)
                           (or (= (n/opcode node) 81) (= (n/opcode node) 93)))
                  (set! (mut control) r (.op1 node)))
                (set! r (+ r (/ (+ (cast i64 (get (.arities graph) r)) 4) 4)))))
            ; Patch control separately from values: LOAD and ALLOCA define both.
            (set! r 1)
            (while (< r size)
              (let [node (get (.instructions graph) r)
                    count (get (.arities graph) r)
                    owner (get owners r)
                    value (get data r)]
                (cond (!= (get casts r) 0)
                        (do
                          (g/rewrite-inputs! (mut graph)
                                             (cast i32 r)
                                             (let [source (resolve data (get casts r))]
                                               (match (g/lookup graph source)
                                                 (Some [v]
                                                   (if (> (types/size (cast i32 (n/type-id v)) 8)
                                                          (types/size (cast i32 (n/type-id node)) 8))
                                                       35 36))
                                                 (None [] (: 36 u8))))
                                             (n/type-id node)
                                             [(resolve data (get casts r))])
                          (set! changes (+ changes 1)))
                      (!= value 0)
                        (do
                          (g/rewrite-inputs! (mut graph)
                                             (cast i32 r)
                                             68
                                             (n/type-id node)
                                             [(resolve data value) (: 0 i32)])
                          (set! changes (+ changes 1)))
                      (or (!= (get control r) 0)
                          (and (> owner 0)
                               (> (get eligible (cast i64 owner)) 0)
                               (> (get complete (cast i64 owner)) 0)))
                        (do
                          (g/make-nop! (mut graph) (cast i32 r))
                          (set! changes (+ changes 1)))
                      :else 0)
                (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
            ; Include newly constructed Phis and scalar views when redirecting
            ; references, while the removal maps remain indexed by original IR.
            (set! r 1)
            (while (< r (len (.instructions graph)))
              (let [node (get (.instructions graph) r)
                    count (get (.arities graph) r)]
                (for [i 1 (+ (cast i64 count) 1)]
                  (let [index (cast i32 i)
                        kind (op/operand-code (cast i32 (n/opcode node)) index)]
                    (when (uses/edge-code? kind)
                      (match (g/operand graph (cast i32 r) index)
                        (None [] 0)
                        (Some [old]
                              (let [new
                                      (resolve (if (= kind op/OPERAND-SRC)
                                                   control
                                                   data)
                                               old)]
                                (when (!= new old)
                                  (g/set-operand! (mut graph)
                                                  (cast i32 r)
                                                  index
                                                  new))))))))
                (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
            (let [count (len roots)]
              (for [i 0 count]
                (let [root (get roots i)]
                  (when (!= (get control (cast i64 root)) 0)
                    (if (and (= (get data (cast i64 root)) 0)
                             (= (get casts (cast i64 root)) 0))
                        (set! (mut roots) i (resolve control root))
                        ; A promoted LOAD root keeps its typed value, while its
                        ; former control closure can retain unrelated effects.
                        (push! (mut roots) (resolve control root))))))))
          (uses/release! (mut edges))
          (free! (mut owners))
          (free! (mut offsets))
          (free! (mut accesses))
          (free! (mut eligible))
          (free! (mut complete))
          (free! (mut next))
          (free! (mut data))
          (free! (mut casts))
          (free! (mut control))
          (free! (mut cells))
          (free! (mut blocks))))
      (free! (mut candidates))
      (if (= error "") (Ok changes) (Err error)))))

;;; Compatibility policy is byte-order independent: exact-width field views.
(defn promote! [(graph (mut g/Graph))
                (roots (mut (ArrayList i32)))
                (a (dyn Allocator))] (-> (Result i32 (slice u8)))
  (promote-ordered! (mut graph) (mut roots) false a))

;;; Retain the exact-width classifier entry point for byte-order-independent users.
(defn cell! [(cells (mut (ArrayList Cell))) (start i64) (owner i32)
             (offset i64) (size i32) (ty u8)] (-> i32)
  (cell-ordered! (mut cells) start owner offset size ty false))

;;; Existing private-result proofs retain their exact-width policy.
(defn classify! [(graph g/Graph) (edges uses/Uses) (owner i32) (extent i64)
                 (owners (mut (ArrayList i32)))
                 (offsets (mut (ArrayList i32)))
                 (accesses (mut (ArrayList i32)))
                 (cells (mut (ArrayList Cell))) (a (dyn Allocator))] (-> bool)
  (classify-ordered! graph edges owner extent false (mut owners) (mut offsets)
                     (mut accesses) (mut cells) a))
