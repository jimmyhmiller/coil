;;; Independent consistency checks for completed physical assignments.
(module stogir.allocation-check)
(import "stogir.fill" :as fill)
(import "stogir.allocation" :as a)
(import "stogir.interval" :as r)
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "stogir.interval-queue" :as queue)
(import "coil.result" :use [Result Ok Err Some None])

;;; Empty children participate in the historical class check only when followed
;;; by a nonempty child. Retain that rule while indexing parent masks sparsely.
(defstruct Class [(mask u64) (mixed bool)])

(defn verify [(parts (ArrayList a/Part)) (register-count i32) (allowed u64)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut checked) (: 0 i32)
        (mut i) 0
        allocator (.alc parts)
        (mut classes) (HashMap::new-scalar [i32 Class] allocator)
        (mut pending) (ArrayList::new [queue/Item] allocator)
        (mut cursor) (ArrayList::new [i64] allocator)
        (mut ends) (ArrayList::new [i64] allocator)
        target-mask
          (if (and (> register-count 0) (< register-count 64))
              (- (<< (: 1 u64) (cast u64 register-count)) 1)
              (: 0xFFFFFFFFFFFFFFFF u64))]
    (when (> (len parts) 2147483647)
      (set! error "allocation reference space exhausted"))
    (when (or (<= register-count 0) (> register-count 64))
      (set! error "invalid physical register count"))
    (while (and (= error "") (< i (len parts)))
      (let [part (at parts i)
            reg (.register part)
            (mut last-end) -1]
        (when (> (len (.ranges part)) 0)
          (when (= (& (& allowed target-mask) (.allowed part)) 0)
            (set! error "interval has no admissible target register"))
          (if (>= reg 0)
              (when (or (>= reg register-count)
                        (>= reg 64)
                        (= (& (& allowed (.allowed part))
                              (<< (: 1 u64) (cast u64 reg)))
                           0))
                (set! error "assignment uses forbidden register"))
              (when (< (.spill-slot part) 0)
                (set! error "interval has no physical location")))
          (for range (.ranges part)
            (when (or (< (.start range) 0)
                      (<= (.end range) (.start range))
                      (<= (.start range) last-end))
              (set! error "invalid or unmerged live ranges"))
            (set! last-end (.end range)))
          (for use (.uses part)
            (when (not (r/covers? (.ranges part) (.position use)))
              (set! error "constraint outside interval"))
            (when (and (>= (.kind use) 1) (< reg 0))
              (set! error "register-required use spilled"))
            (when (and (= (.kind use) 2) (!= reg (.register use)))
              (set! error "fixed register constraint violated")))
          (when (and (= error "") (>= (.parent part) 0))
            (match (get classes (.parent part))
              (Some [previous]
                    (when (or (.mixed previous)
                              (!= (.mask previous) (.allowed part)))
                      (set! error "split intervals disagree on register class")))
              (None [] 0)))
          (set! checked (+ checked 1)))
        ; Index all preceding children, including empty ones, as the pairwise
        ; reference did. No array is indexed by arbitrary/sparse parent IDs.
        (when (>= (.parent part) 0)
          (match (get classes (.parent part))
            (None []
                  (set! (mut classes)
                        (.parent part)
                        (Class :mask (.allowed part) :mixed false)))
            (Some [previous]
                  (set! (mut classes)
                        (.parent part)
                        (Class
                          :mask (.mask previous)
                          :mixed
                            (or (.mixed previous)
                                (!= (.mask previous) (.allowed part)))))))))
      (set! i (+ i 1)))
    ; Merge each assigned interval's already sorted ranges by start position.
    ; A per-register end proves disjointness, including lifetime holes and fixed
    ; physical reservations. O(R log P), rather than all pairs of P children.
    (when (= error "")
      (fill/append! (mut ends) 64 -1)
      (for [index 0 (len parts)]
        (push! (mut cursor) 0)
        (let [part (at parts index)]
          (when (and (>= (.register part) 0) (> (len (.ranges part)) 0))
            (queue/insert! (mut pending)
                           (queue/Item
                             :position (.start (get (.ranges part) 0))
                             :interval (cast i32 index))))))
      (while (and (= error "") (> (len pending) 0))
        (match (queue/take! (mut pending))
          (None [] 0)
          (Some [item]
                (let [index (cast i64 (.interval item))
                      part (at parts index)
                      reg (cast i64 (.register part))
                      position (get cursor index)
                      range (get (.ranges part) position)]
                  (when (< (.start range) (get ends reg))
                    (set! error "overlapping intervals share register"))
                  (set! (mut ends) reg (.end range))
                  (set! (mut cursor) index (+ position 1))
                  (when (< (+ position 1) (len (.ranges part)))
                    (queue/insert! (mut pending)
                                   (queue/Item
                                     :position
                                       (.start (get (.ranges part)
                                                    (+ position 1)))
                                     :interval (.interval item)))))))))
    (free! (mut classes))
    (free! (mut pending))
    (free! (mut cursor))
    (free! (mut ends))
    (if (= error "") (Ok checked) (Err error))))
