; Conversion policy/folding adapted from dstogov/ir ir_fold.h, 92171d0. See NOTICE.
(module stogir.conversion)

(export operation? policy validate evaluate build!)

(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "stogir.numeric-conversion" :as numeric)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Option Some None])

(defn operation? [(opcode i32)] (-> bool)
  (and (>= opcode 33) (<= opcode 39)))

;;; BOOL occupies a byte. SEXT extends bit 7, not LLVM i1's bit 0.
(defn policy [(opcode i32) (src i32) (dst i32) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (let [vector-cast
          (and (= opcode 36)
               (or (types/vector? src) (types/vector? dst)))
        from
          (* 8
             (if vector-cast
                 (types/size src pointer-bytes)
                 (types/scalar-size src pointer-bytes)))
        to
          (* 8
             (if vector-cast
                 (types/size dst pointer-bytes)
                 (types/scalar-size dst pointer-bytes)))]
    (if (or (not (operation? opcode))
            (<= from 0)
            (<= to 0)
            (if (numeric/operation? opcode)
                (not (numeric/valid-types? opcode src dst))
                (if (= opcode 36)
                    (!= from to)
                    (or (not (types/integer? src))
                        (not (types/integer? dst))
                        (if (= opcode 35) (>= to from) (<= to from))))))
        (Err "invalid conversion types or widths")
        (Ok (if (or (= opcode 35) (= opcode 38)) to from)))))

(defn validate [(graph g/Graph) (reference i32) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "conversion missing"))
    (Some [node]
          (if (or (<= reference 0)
                  (not (operation? (cast i32 (n/opcode node))))
                  (!= (get (.arities graph) (cast i64 reference)) 1))
              (Err "invalid conversion instruction")
              (match (g/lookup graph (.op1 node))
                (None [] (Err "conversion source missing"))
                (Some [source]
                      (if (or (= (n/opcode source) 72) (= (n/opcode source) 70))
                          (Err "conversion requires an ordinary value")
                          (policy (cast i32 (n/opcode node))
                                  (cast i32 (n/type-id source))
                                  (cast i32 (n/type-id node))
                                  pointer-bytes))))))))

;;; Canonicalize Boolean destinations after truncating to their storage byte.
;;; This agrees with upstream constant folding and keeps BOOL values in {0,1}.
(defn bits-evaluate [(opcode i32)
                     (src i32)
                     (dst i32)
                     (pointer-bytes i32)
                     (bits u64)]
  (-> (Option u64))
  (match (policy opcode src dst pointer-bytes)
    (Err [_] (None))
    (Ok [_]
        (let [from (* 8 (types/scalar-size src pointer-bytes))
              to (* 8 (types/scalar-size dst pointer-bytes))
              src-modulus (<< (: 1 u128) (cast u128 from))
              dst-mask (cast u64 (- (<< (: 1 u128) (cast u128 to)) 1))
              x (& bits (cast u64 (- src-modulus 1)))
              value
                (if (and (= opcode 33) (>= (cast u128 x) (/ src-modulus 2)))
                    (cast u64 (- (cast i128 x) (cast i128 src-modulus)))
                    x)
              result (& value dst-mask)]
          (Some (if (= dst 1) (if (= result 0) (: 0 u64) 1) result))))))

(defn evaluate [(opcode i32) (src i32) (dst i32) (pointer-bytes i32) (bits u64)]
  (-> (Option u64))
  (if (or (types/vector? src) (types/vector? dst))
      (None)
      (if (numeric/operation? opcode)
          (numeric/evaluate opcode src dst pointer-bytes bits)
          (bits-evaluate opcode src dst pointer-bytes bits))))

;;; Reinterpret little-endian literal storage without FP arithmetic.
;;; Named scalar addresses remain instructions so relocations survive lowering.
;;; A builder operation: GRAPH is the caller's own (mutable) graph and the
;;; payload scratch comes from its allocator. It is reached only through
;;; build! with a vector source or result; the passes a compile runs
;;; (loop-vectorize, loop-guard) call build! with scalar types, on their own
;;; g/duplicate of the input, so no compile reaches this on its input graph.
(defn fold-vector-bitcast! [(graph (mut g/Graph))
                            (source i32)
                            (src i32)
                            (dst i32)
                            (pointer-bytes i32)]
  (-> (Option i32))
  (match (g/lookup graph source)
    (None [] (None))
    (Some [input]
          (if (or (>= source 0)
                  (if (types/vector? src)
                      (!= (g/long-size graph source)
                          (cast i64 (types/size src pointer-bytes)))
                      (not (symbols/numeric? input))))
              (None)
              (let [(mut payload)
                      (ArrayList::new [u8] (.alc (.constants graph)))
                    (mut i) (: 0 i32)
                    (mut valid) true
                    (mut bits) (: 0 u64)]
                (while (< i (types/size src pointer-bytes))
                  (let [byte
                          (if (types/vector? src)
                              (match (g/long-byte graph source (cast i64 i))
                                (None [] (do (set! valid false) (: 0 u8)))
                                (Some [value] value))
                              (cast u8
                                    (>> (n/constant-bits input)
                                        (* (cast u64 i) 8))))]
                    (push! (mut payload) byte)
                    (when (< i 8)
                      (set! bits
                            (| bits (<< (cast u64 byte) (* (cast u64 i) 8))))))
                  (set! i (+ i 1)))
                (let [result
                        (if (not valid)
                            (None)
                            (if (types/vector? dst)
                                (g/intern-vector! (mut graph)
                                                  dst
                                                  pointer-bytes
                                                  (slice payload))
                                (g/intern-scalar! (mut graph)
                                                  (cast u8 dst)
                                                  (if (= dst 1)
                                                      (if (= bits 0)
                                                          (: 0 u64)
                                                          1)
                                                      bits))))]
                  (free! (mut payload))
                  result))))))

(defn build-direct! [(graph (mut g/Graph))
                     (opcode i32)
                     (dst i32)
                     (pointer-bytes i32)
                     (source i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph source)
    (None [] (Err "conversion source missing"))
    (Some [input]
          (let [src (cast i32 (n/type-id input))]
            (match (if (or (= (n/opcode input) 72) (= (n/opcode input) 70))
                       (Err "conversion requires an ordinary value")
                       (policy opcode src dst pointer-bytes))
              (Err [message] (Err message))
              (Ok [_]
                  (if (and (or (= opcode 36) (= opcode 39)) (= src dst))
                      (Ok source)
                      (let [(mut folded) (: 0 i32)]
                        (when (and (= opcode 36)
                                   (or (types/vector? src) (types/vector? dst)))
                          (match (fold-vector-bitcast! (mut graph)
                                                       source
                                                       src
                                                       dst
                                                       pointer-bytes)
                            (None [] 0)
                            (Some [reference] (set! folded reference))))
                        (when (and (< source 0) (symbols/numeric? input))
                          (match (evaluate opcode
                                           src
                                           dst
                                           pointer-bytes
                                           (n/constant-bits input))
                            (None [] 0)
                            (Some [bits]
                                  (match (g/intern-scalar! (mut graph)
                                                           (cast u8 dst)
                                                           bits)
                                    (None [] 0)
                                    (Some [reference] (set! folded reference))))))
                        (if (!= folded 0)
                            (Ok folded)
                            (let [key
                                    (| (cast u128 opcode)
                                       (<< (cast u128 dst) 8)
                                       (<< (cast u128 pointer-bytes) 16)
                                       (<< (cast u128 (cast u32 source)) 24))]
                              (match (get (.expressions graph) key)
                                (Some [reference] (Ok reference))
                                (None []
                                      (match (g/append-inputs! (mut graph)
                                                               (cast u8 opcode)
                                                               (cast u8 dst)
                                                               [source])
                                        (None []
                                              (Err "conversion reference space exhausted"))
                                        (Some [reference]
                                              (do
                                                (set! (mut (.expressions graph))
                                                      key
                                                      reference)
                                                (Ok reference))))))))))))))))

;;; Pinned ir_fold.h BITCAST(BITCAST), with Boolean normalization excluded.
;;; Validate every removed conversion before restarting on the original bits.
(defn bitcast-source [(graph g/Graph) (source i32) (dst i32) (pointer-bytes i32)]
  (-> (Result i32 (slice u8)))
  (let [(mut cursor) source (mut left) (len (.instructions graph))
        (mut walking) (!= dst 1) (mut error) ""]
    (while (and walking (= error ""))
      (match (g/lookup graph cursor)
        (None [] (set! error "conversion source missing"))
        (Some [input]
          (if (or (!= (n/opcode input) 36) (= (n/type-id input) 1))
              (set! walking false)
              (if (<= left 0)
                  (set! error "cyclic bitcast chain")
                  (match (validate graph cursor pointer-bytes)
                    (Err [message] (set! error message))
                    (Ok [_]
                      (match (g/lookup graph (.op1 input))
                        (None [] (set! error "conversion source missing"))
                        (Some [original]
                          (if (= (n/type-id original) 1)
                              (set! walking false)
                              (do (set! cursor (.op1 input))
                                  (set! left (- left 1)))))))))))))
    (if (= error "") (Ok cursor) (Err error))))

;;; Pinned TRUNC(ZEXT)/TRUNC(SEXT) and BITCAST(BITCAST) restart rules.
(defn build! [(graph (mut g/Graph))
              (opcode i32)
              (dst i32)
              (pointer-bytes i32)
              (source i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph source)
    (None [] (Err "conversion source missing"))
    (Some [input]
          (if (and (= opcode 36) (= (n/opcode input) 36))
              (match (policy opcode (cast i32 (n/type-id input)) dst pointer-bytes)
                (Err [message] (Err message))
                (Ok [_]
                  (match (bitcast-source graph source dst pointer-bytes)
                    (Err [message] (Err message))
                    (Ok [original]
                      (build-direct! (mut graph) opcode dst pointer-bytes original)))))
              (if (and (= opcode 35)
                   (or (= (n/opcode input) 33) (= (n/opcode input) 34)))
              (match (policy opcode
                             (cast i32 (n/type-id input))
                             dst
                             pointer-bytes)
                (Err [message] (Err message))
                (Ok [_]
                    (match (validate graph source pointer-bytes)
                      (Err [message] (Err message))
                      (Ok [_]
                          (match (g/lookup graph (.op1 input))
                            (None [] (Err "extension operand missing"))
                            (Some [original]
                                  (let [src (cast i32 (n/type-id original))
                                        from
                                          (types/scalar-size src pointer-bytes)
                                        to (types/scalar-size dst pointer-bytes)]
                                    (if (= src dst)
                                        (Ok (.op1 input))
                                        (build! (mut graph)
                                                (cond (= from to) 36
                                                      (> from to) 35
                                                      :else
                                                        (cast i32
                                                              (n/opcode input)))
                                                dst
                                                pointer-bytes
                                                (.op1 input))))))))))
              (build-direct! (mut graph) opcode dst pointer-bytes source))))))
