;;; COPY retains the value type; operand two holds flags, including the
;;; IR_COPY_HARD fold barrier. Native register reuse is still permitted.
;;; The graph shape and identity follow pinned ir.h/ir_builder.h. See NOTICE.
(module stogir.copy)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "coil.result" :use [Result Ok Err Some None])

(defn hard? [(node n/Node)] (-> bool)
  (!= (& (.op2 node) 1) 0))

(defn validate [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "COPY instruction missing"))
    (Some [node]
          (let [ty (cast i32 (n/type-id node))]
            (if (or (<= reference 0)
                    (!= (n/opcode node) 68)
                    (!= (get (.arities graph) (cast i64 reference)) 2)
                    (= ty 0)
                    (not (types/valid? ty)))
                (Err "invalid COPY shape or result type")
                (match (g/lookup graph (.op1 node))
                  (None [] (Err "COPY source missing"))
                  (Some [source]
                        (if (!= (n/type-id source) (n/type-id node))
                            (Err "COPY source/result type mismatch")
                            (Ok ty)))))))))
