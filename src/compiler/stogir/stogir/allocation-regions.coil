;;; Preserve predecessor locations through control-only, single-entry blocks.
;;; The allocator's linear order may put a cold body's spill suffix over its
;;; bypass block. Reassigning the entire bypass region simultaneously avoids
;;; register -> slot -> register round trips on the path that skipped the body.
(module stogir.allocation-regions)
(import "stogir.fill" :as fill)
(import "stogir.allocation" :as a)
(import "stogir.interval" :as range)
(import "stogir.constraints" :as c)
(import "stogir.cfg" :as cfg)
(import "stogir.adjacency" :as adj)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.schedule" :as schedule)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.primitive" :as p)
(import "coil.result" :use [Option Some None some?])

(defstruct Change [(part i32) (register i32) (slot i64)])

;;; Splits retain the original register on both outside pieces. No allocation
;;; queue/event index is alive here: this pass runs after the scan finishes.
(defn assign-region! [(parts (mut (ArrayList a/Part))) (change Change)
                      (start i64) (end i64) (allocator (dyn Allocator))] (-> void)
  (let [(mut index) (.part change)
        original (at parts (cast i64 index))
        old-register (.register original)]
    (when (< (.start (get (.ranges original) 0)) start)
      (let [(mut middle) (a/split! (elem (mut parts) (cast i64 index)) start allocator)]
        (set! (.register middle) old-register)
        (set! index (cast i32 (len parts)))
        (push! (mut parts) middle)))
    (let [middle (at parts (cast i64 index))]
      (when (> (.end (get (.ranges middle) (- (len (.ranges middle)) 1))) end)
        (let [(mut suffix) (a/split! (elem (mut parts) (cast i64 index)) end allocator)]
          (set! (.register suffix) old-register)
          (push! (mut parts) suffix))))
    (let [middle (elem (mut parts) (cast i64 index))]
      (set! (.register middle) (.register change))
      (when (>= (.slot change) 0) (set! (.spill-slot middle) (.slot change))))))

;;; Lifetime bounds of every part: the start of its first range and the end of
;;; its last one. A part without ranges gets bounds no position lies within.
;;; A position outside a part's bounds is in none of its ranges, so the bounds
;;; let inherit-bounded! pass over a part without reading its range list. near
;;; is that function's scratch list of the parts whose bounds meet a region.
(defstruct Bounds [(lows (ArrayList i64)) (highs (ArrayList i64)) (near (ArrayList i32))])

(defn bound! [(bounds (mut Bounds)) (parts (ArrayList a/Part)) (index i64)] (-> void)
  (let [part (at parts index)
        count (len (.ranges part))
        low (if (> count 0) (.start (get (.ranges part) 0)) 9223372036854775807)
        high (if (> count 0) (.end (get (.ranges part) (- count 1))) -9223372036854775808)]
    (if (< index (len (.lows bounds)))
        (do (set! (mut (.lows bounds)) index low)
            (set! (mut (.highs bounds)) index high))
        (do (assert (= index (len (.lows bounds))))
            (push! (mut (.lows bounds)) low)
            (push! (mut (.highs bounds)) high)))))

(defn bounds-of [(parts (ArrayList a/Part)) (allocator (dyn Allocator))] (-> Bounds)
  (let [(mut bounds) (Bounds :lows (ArrayList::new [i64] allocator)
                             :highs (ArrayList::new [i64] allocator)
                             :near (ArrayList::new [i32] allocator))]
    (reserve! (mut (.lows bounds)) (len parts))
    (reserve! (mut (.highs bounds)) (len parts))
    (for [i 0 (len parts)] (bound! (mut bounds) parts i))
    bounds))

(defn release-bounds! [(bounds (mut Bounds))] (-> void)
  (free! (mut (.lows bounds)))
  (free! (mut (.highs bounds)))
  (free! (mut (.near bounds))))

;;; Caller proves the region contains no instructions or Phi definitions.
;;; Reject partial liveness, register-required uses, or fixed interference.
;;; Gather every desired location before changing any interval so exchanged
;;; registers are reassigned simultaneously, without transient dependencies.
(defn inherit! [(parts (mut (ArrayList a/Part))) (start i64) (end i64) (source i64)
                 (sources (mut (ArrayList i32))) (changes (mut (ArrayList Change)))
                 (allocator (dyn Allocator))] (-> i32)
  (let [(mut bounds) (bounds-of parts allocator)
        (mut touched) (ArrayList::new [i32] allocator)]
    (for [i 0 (len sources)] (set! (mut sources) i -1))
    (let [count (inherit-bounded! (mut parts) start end source (mut sources) (mut touched)
                                  (mut changes) (mut bounds) allocator)]
      (free! (mut touched))
      (release-bounds! (mut bounds))
      count)))

;;; The source of each parent live at SOURCE, from part I when its range list
;;; covers the position (the caller knows SOURCE lies within the part's bounds).
;;; False when the part's parent has no SOURCES entry.
(defn note-source! [(parts (ArrayList a/Part)) (i i64) (source i64)
                    (sources (mut (ArrayList i32))) (touched (mut (ArrayList i32)))] (-> bool)
  (let [part (at parts i)]
    (if (and (>= (.parent part) 0) (range/covers? (.ranges part) source))
        (if (>= (cast i64 (.parent part)) (len sources))
            false
            (do
              (push! (mut touched) (.parent part))
              (set! (mut sources) (cast i64 (.parent part)) (cast i32 i))
              true))
        true)))

;;; inherit! for a caller that keeps BOUNDS equal to bounds-of PARTS and enters
;;; with every SOURCES entry -1. The entries written here are listed in TOUCHED
;;; (cleared first) and left for the caller to reset; BOUNDS is brought up to
;;; date with the parts this call splits or appends.
(defn inherit-bounded! [(parts (mut (ArrayList a/Part))) (start i64) (end i64) (source i64)
                         (sources (mut (ArrayList i32))) (touched (mut (ArrayList i32)))
                         (changes (mut (ArrayList Change))) (bounds (mut Bounds))
                         (allocator (dyn Allocator))] (-> i32)
  (let [(mut valid) true
        count (len parts)
        lows (.data (.lows bounds))
        highs (.data (.highs bounds))]
    (assert (= count (len (.lows bounds))))
    (clear! (mut touched))
    (clear! (mut (.near bounds)))
    (for [i 0 count]
      (let [low (load (p/index lows i))
            high (load (p/index highs i))]
        ; A range holding source starts at or before it and ends after it.
        (when (and (<= low source) (> high source))
          (unless (note-source! parts i source (mut sources) (mut touched))
            (set! valid false)))
        ; Some range ends after start only when the last one does, and the first
        ; such range starts before end only when the first range of all does.
        ; Only these parts can meet the region; they are examined below, in
        ; order, once every source is known.
        (when (and (> high start) (< low end))
          (push! (mut (.near bounds)) (cast i32 i)))))
    (inherit-near! (mut parts) start end valid (mut sources) (mut changes) (mut bounds)
                   allocator)))

;;; The second half of inherit-bounded!: SOURCES holds every source and
;;; BOUNDS.near, in ascending order, every part whose bounds meet the region.
;;; GATHERED is false when a source could not be recorded.
(defn inherit-near! [(parts (mut (ArrayList a/Part))) (start i64) (end i64) (gathered bool)
                     (sources (mut (ArrayList i32))) (changes (mut (ArrayList Change)))
                     (bounds (mut Bounds)) (allocator (dyn Allocator))] (-> i32)
  (let [(mut valid) gathered
        count (len parts)]
    (clear! (mut changes))
    (for [k 0 (len (.near bounds))]
      (when valid
        (let [i (cast i64 (get (.near bounds) k))
              part (at parts i)
              r (range/first-ending-after (.ranges part) start)]
          (when (and (< r (len (.ranges part)))
                     (< (.start (get (.ranges part) r)) end))
            (let [parent (.parent part)
                  use (c/next-use (.uses part) start 1)]
              (if (or (< parent 0) (>= (cast i64 parent) (len sources))
                      (> (.start (get (.ranges part) r)) start)
                      (< (.end (get (.ranges part) r)) end)
                      (and (>= use 0) (< use end)))
                  (set! valid false)
                  (let [from (get sources (cast i64 parent))]
                    (if (< from 0)
                        (set! valid false)
                        (let [origin (at parts (cast i64 from))
                              reg (.register origin)
                              slot (.spill-slot origin)]
                          (if (or (and (< reg 0) (< slot 0))
                                  (and (>= reg 0)
                                       (or (>= reg 64)
                                           (= (& (.allowed part) (<< (: 1 u64) (cast u64 reg))) 0))))
                              (set! valid false)
                              (when (or (!= reg (.register part))
                                        (and (< reg 0) (!= slot (.spill-slot part))))
                                (push! (mut changes)
                                  (Change :part (cast i32 i) :register reg :slot slot)))))))))))))
    (if (not valid) 0
        (do
          (for [k 0 (len changes)]
            (let [change (get changes k)]
              (assign-region! (mut parts) change start end allocator)
              (bound! (mut bounds) parts (cast i64 (.part change)))))
          (for [i count (len parts)] (bound! (mut bounds) parts i))
          (cast i32 (len changes))))))

;;; For a fixed list of query positions, the parts whose bounds [low, high)
;;; hold each position, in ascending part order. A part's bounds only shrink
;;; while regions are assigned (a split keeps the original's index for one
;;; piece and appends the others), so lists made from the bounds at the start
;;; stay supersets for the parts that existed then; the reader re-checks the
;;; current bounds and scans the appended parts itself.
;;; ranks[p] is the number of queries below position p; query q has rank
;;; slot[q], and its parts are items[starts[r] .. starts[r + 1]) for that rank.
(defstruct Stabs [(ranks (ArrayList i32)) (slot (ArrayList i32))
                  (starts (ArrayList i32)) (items (ArrayList i32))])

(defn release-stabs! [(stabs (mut Stabs))] (-> void)
  (free! (mut (.ranks stabs))) (free! (mut (.slot stabs)))
  (free! (mut (.starts stabs))) (free! (mut (.items stabs))))

(defn clamp-position [(position i64) (limit i64)] (-> i64)
  (cond (< position 0) 0
        (> position limit) limit
        :else position))

;;; Stabs for the positions QUERIES (each in [0, LIMIT)): for each, the parts
;;; with low - SLACK <= position < high. None when the lists together would
;;; hold more than BUDGET entries; the caller then scans every part per query.
(defn stabs-of [(queries (ArrayList i64)) (limit i64) (slack i64) (bounds Bounds)
                (budget i64) (allocator (dyn Allocator))] (-> (Option Stabs))
  (let [count (len queries)
        parts (len (.lows bounds))
        lows (.data (.lows bounds))
        highs (.data (.highs bounds))
        (mut stabs) (Stabs :ranks (ArrayList::new [i32] allocator)
                           :slot (ArrayList::new [i32] allocator)
                           :starts (ArrayList::new [i32] allocator)
                           :items (ArrayList::new [i32] allocator))
        (mut cursor) (ArrayList::new [i32] allocator)
        (mut total) (: 0 i64)]
    ; Counting sort of the queries by position; equal positions take
    ; consecutive ranks.
    (fill/append! (mut (.ranks stabs)) (+ limit 2) 0)
    (for [q 0 count]
      (let [position (get queries q)]
        (assert (and (>= position 0) (< position limit)))
        (set! (mut (.ranks stabs)) (+ position 1) (+ (get (.ranks stabs) (+ position 1)) 1))))
    (for [position 1 (+ limit 2)]
      (set! (mut (.ranks stabs)) position
            (+ (get (.ranks stabs) position) (get (.ranks stabs) (- position 1)))))
    (fill/append! (mut cursor) limit 0)
    (fill/append! (mut (.slot stabs)) count 0)
    (for [q 0 count]
      (let [position (get queries q)
            taken (get cursor position)]
        (set! (mut (.slot stabs)) q (+ (get (.ranks stabs) position) taken))
        (set! (mut cursor) position (+ taken 1))))
    (free! (mut cursor))
    ; List lengths by difference: a part adds one to every rank from the first
    ; query at or above low - SLACK to the last one below high.
    (fill/append! (mut (.starts stabs)) (+ count 2) 0)
    (for [i 0 parts]
      (let [first (cast i64 (get (.ranks stabs)
                                 (clamp-position (- (load (p/index lows i)) slack) limit)))
            past (cast i64 (get (.ranks stabs) (clamp-position (load (p/index highs i)) limit)))]
        (when (< first past)
          (set! total (+ total (- past first)))
          (set! (mut (.starts stabs)) (+ first 1) (+ (get (.starts stabs) (+ first 1)) 1))
          (set! (mut (.starts stabs)) (+ past 1) (- (get (.starts stabs) (+ past 1)) 1)))))
    (if (> total budget)
        (do (release-stabs! (mut stabs)) (None))
        (do
          ; starts[r + 1] holds rank r's length; two running sums turn it into
          ; the list's end, then filling moves each list's cursor from its
          ; start (the previous list's end) up to that end.
          (let [(mut length) (: 0 i32) (mut end) (: 0 i32)]
            (for [r 1 (+ count 2)]
              (set! length (+ length (get (.starts stabs) r)))
              (let [begin end]
                (set! end (+ end length))
                (set! (mut (.starts stabs)) r begin))))
          ; Now starts[r + 1] is rank r's start; fill, advancing it to the end.
          (fill/append! (mut (.items stabs)) total 0)
          (for [i 0 parts]
            (let [first (cast i64 (get (.ranks stabs)
                                       (clamp-position (- (load (p/index lows i)) slack) limit)))
                  past (cast i64 (get (.ranks stabs)
                                      (clamp-position (load (p/index highs i)) limit)))]
              (for [r first past]
                (let [next (get (.starts stabs) (+ r 1))]
                  (set! (mut (.items stabs)) (cast i64 next) (cast i32 i))
                  (set! (mut (.starts stabs)) (+ r 1) (+ next 1))))))
          ; Each cursor now stands at its list's end, the next list's start:
          ; starts[r + 1] is the end of rank r and starts[r] its start, with
          ; starts[0] zero.
          (Some stabs)))))

;;; inherit-bounded! reading the parts near the positions from the lists of
;;; query Q in SOURCE-STABS (SOURCE) and REGION-STABS (START, slack 3 for a
;;; region of four positions), made when PARTS had ORIGINAL parts.
(defn inherit-indexed! [(parts (mut (ArrayList a/Part))) (start i64) (end i64) (source i64)
                         (sources (mut (ArrayList i32))) (touched (mut (ArrayList i32)))
                         (changes (mut (ArrayList Change))) (bounds (mut Bounds))
                         (source-stabs Stabs) (region-stabs Stabs) (q i64) (original i64)
                         (allocator (dyn Allocator))] (-> i32)
  (let [(mut valid) true
        count (len parts)
        lows (.data (.lows bounds))
        highs (.data (.highs bounds))
        source-rank (cast i64 (get (.slot source-stabs) q))
        region-rank (cast i64 (get (.slot region-stabs) q))]
    (assert (= count (len (.lows bounds))))
    (assert (= end (+ start 4)))
    (clear! (mut touched))
    (clear! (mut (.near bounds)))
    (for [k (cast i64 (get (.starts source-stabs) source-rank))
            (cast i64 (get (.starts source-stabs) (+ source-rank 1)))]
      (let [i (cast i64 (get (.items source-stabs) k))]
        (when (and (<= (load (p/index lows i)) source) (> (load (p/index highs i)) source))
          (unless (note-source! parts i source (mut sources) (mut touched))
            (set! valid false)))))
    (for [i original count]
      (when (and (<= (load (p/index lows i)) source) (> (load (p/index highs i)) source))
        (unless (note-source! parts i source (mut sources) (mut touched))
          (set! valid false))))
    (for [k (cast i64 (get (.starts region-stabs) region-rank))
            (cast i64 (get (.starts region-stabs) (+ region-rank 1)))]
      (let [i (cast i64 (get (.items region-stabs) k))]
        (when (and (> (load (p/index highs i)) start) (< (load (p/index lows i)) end))
          (push! (mut (.near bounds)) (cast i32 i)))))
    (for [i original count]
      (when (and (> (load (p/index highs i)) start) (< (load (p/index lows i)) end))
        (push! (mut (.near bounds)) (cast i32 i))))
    (inherit-near! (mut parts) start end valid (mut sources) (mut changes) (mut bounds)
                   allocator)))

;;; Below this many part visits (regions times parts) the per-region scan of
;;; every part is cheaper than building the position lists.
(defn indexed-threshold [] (-> i64)
  4096)

;;; The most list entries stabs-of may build for one function.
(defn stabs-budget [] (-> i64)
  4194304)

(defn run! [(parts (mut (ArrayList a/Part))) (graph g/Graph)
             (blocks cfg/Blocks) (scheduled schedule/Schedule)
             (allocator (dyn Allocator))] (-> i32)
  (let [(mut incoming) (adj/build blocks true allocator)
        (mut region-starts) (ArrayList::new [i64] allocator)
        (mut region-sources) (ArrayList::new [i64] allocator)
        (mut changed) (: 0 i32)]
    (for block (.starts blocks)
      (let [span (get (.ranges scheduled) (cast i64 block))
            pred (get (.ranges incoming) (cast i64 block))
            start-op (n/opcode (get (.instructions graph) (cast i64 block)))]
        (when (and (= (.count span) 2) (= (.count pred) 1)
                   (!= start-op 104) (!= start-op 105))
          (let [ending (get (.nodes scheduled) (+ (.offset span) 1))
                opcode (n/opcode (get (.instructions graph) (cast i64 ending)))
                predecessor (.from (get (.edges blocks) (get (.edges incoming) (.offset pred))))
                previous (get (.ranges scheduled) (cast i64 predecessor))]
            (when (and (or (= opcode 114) (= opcode 115))
                       (!= predecessor block) (> (.count previous) 0))
              (push! (mut region-starts) (* (.offset span) 2))
              (push! (mut region-sources) (- (* (+ (.offset previous) (.count previous)) 2) 1)))))))
    (adj/release! (mut incoming))
    (when (> (len region-starts) 0)
      (let [(mut sources) (ArrayList::new [i32] allocator)
            (mut changes) (ArrayList::new [Change] allocator)
            (mut touched) (ArrayList::new [i32] allocator)
            (mut bounds) (bounds-of parts allocator)
            original (len parts)
            limit (+ (* (len (.nodes scheduled)) 2) 8)
            indexed (> (* (len region-starts) original) (indexed-threshold))
            (mut source-stabs) (if indexed
                                   (stabs-of region-sources limit 0 bounds (stabs-budget) allocator)
                                   (None))
            (mut region-stabs) (if (some? source-stabs)
                                   (stabs-of region-starts limit 3 bounds (stabs-budget) allocator)
                                   (None))]
        (fill/append! (mut sources) (len (.instructions graph)) -1)
        (for [q 0 (len region-starts)]
          (let [start (get region-starts q)
                source (get region-sources q)]
            (set! changed (+ changed
              (match source-stabs
                (None [] (inherit-bounded! (mut parts) start (+ start 4) source
                           (mut sources) (mut touched) (mut changes) (mut bounds) allocator))
                (Some [by-source]
                  (match region-stabs
                    (None [] (inherit-bounded! (mut parts) start (+ start 4) source
                               (mut sources) (mut touched) (mut changes) (mut bounds) allocator))
                    (Some [by-region]
                      (inherit-indexed! (mut parts) start (+ start 4) source
                        (mut sources) (mut touched) (mut changes) (mut bounds)
                        by-source by-region q original allocator)))))))
            (for [k 0 (len touched)]
              (set! (mut sources) (cast i64 (get touched k)) -1))))
        (match source-stabs (None [] 0) (Some [stabs] (let [(mut owned) stabs] (release-stabs! (mut owned)) 0)))
        (match region-stabs (None [] 0) (Some [stabs] (let [(mut owned) stabs] (release-stabs! (mut owned)) 0)))
        (free! (mut sources)) (free! (mut changes))
        (free! (mut touched)) (release-bounds! (mut bounds))))
    (free! (mut region-starts)) (free! (mut region-sources))
    changed))
