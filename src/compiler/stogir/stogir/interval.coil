;;; Sorted disjoint half-open live ranges. Adjacent ranges are coalesced.
(module stogir.interval)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])

(defstruct Range [(start i64) (end i64)])

;;; Insert arbitrary valid range; no lifetime holes are lost.
(defn add! [(ranges (mut (ArrayList Range))) (start i64) (end i64)] (-> bool)
  (if (or (< start 0) (<= end start))
      false
      (let [(mut first) 0
            (mut last) 0
            (mut lo) start
            (mut hi) end]
        (while (and (< first (len ranges)) (< (.end (get ranges first)) start))
          (set! first (+ first 1)))
        (set! last first)
        (while (and (< last (len ranges)) (<= (.start (get ranges last)) hi))
          (let [range (get ranges last)]
            (when (< (.start range) lo) (set! lo (.start range)))
            (when (> (.end range) hi) (set! hi (.end range))))
          (set! last (+ last 1)))
        (if (= first last)
            (do
              (push! (mut ranges) (Range :start lo :end hi))
              (let [(mut i) (- (len ranges) 1)]
                (while (> i first)
                  (set! (mut ranges) i (get ranges (- i 1)))
                  (set! i (- i 1))))
              (set! (mut ranges) first (Range :start lo :end hi)))
            (do
              (set! (mut ranges) first (Range :start lo :end hi))
              (let [removed (- (- last first) 1)
                    old-length (len ranges)
                    (mut i) last]
                (while (< i old-length)
                  (set! (mut ranges) (- i removed) (get ranges i))
                  (set! i (+ i 1)))
                (let [(mut j) 0]
                  (while (< j removed) (pop! (mut ranges)) (set! j (+ j 1)))))))
        true)))

;;; Earliest intersecting position at/after from; -1 denotes no intersection.
(defn intersection [(a (ArrayList Range)) (b (ArrayList Range)) (from i64)]
  (-> i64)
  (let [(mut i) 0
        (mut j) 0
        (mut answer) -1]
    (while (and (< i (len a)) (< j (len b)) (< answer 0))
      (let [x (get a i)
            y (get b j)
            start (if (> (.start x) (.start y)) (.start x) (.start y))
            lo (if (> from start) from start)
            hi (if (< (.end x) (.end y)) (.end x) (.end y))]
        (when (< lo hi) (set! answer lo))
        (if (< (.end x) (.end y)) (set! i (+ i 1)) (set! j (+ j 1)))))
    answer))

;;; Split at position: retain the prefix and return the suffix, preserving holes.
(defn split! [(ranges (mut (ArrayList Range)))
              (position i64)
              (allocator (dyn Allocator))] (-> (ArrayList Range))
  (let [(mut suffix) (ArrayList::new [Range] allocator)
        (mut kept) 0
        (mut i) 0]
    (while (< i (len ranges))
      (let [range (get ranges i)]
        (when (> (.end range) position)
          (push! (mut suffix)
                 (Range
                   :start
                     (if (> (.start range) position) (.start range) position)
                   :end (.end range))))
        (when (< (.start range) position)
          (set! (mut ranges)
                kept
                (Range
                  :start (.start range)
                  :end (if (< (.end range) position) (.end range) position)))
          (set! kept (+ kept 1))))
      (set! i (+ i 1)))
    (while (> (len ranges) kept) (pop! (mut ranges)))
    suffix))

(defn covers? [(ranges (ArrayList Range)) (position i64)] (-> bool)
  (let [(mut lo) 0
        (mut hi) (len ranges)]
    (while (< lo hi)
      (let [mid (+ lo (/ (- hi lo) 2))]
        (if (<= (.end (get ranges mid)) position)
            (set! lo (+ mid 1))
            (set! hi mid))))
    (and (< lo (len ranges)) (<= (.start (get ranges lo)) position))))
