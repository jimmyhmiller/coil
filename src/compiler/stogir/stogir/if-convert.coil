;;; Independent extension: closed scalar diamonds with bounded total integer
;;; speculation. All recipes are proved against one immutable prepared graph.
;;; Structural regions are disjoint; branch/merge and value identities survive.
(module stogir.if-convert)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.pipeline" :as pipeline)
(import "stogir.dominators" :as dom)
(import "stogir.loop-rotate" :as rotate)
(import "stogir.boolean-diamond" :as diamond)
(import "stogir.conditional" :as conditional)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Option Some None])

(defstruct Plan [(shape diamond/Collapse) (phis (ArrayList i32))])
(defstruct Converted [(graph (Option g/Graph)) (roots (ArrayList i32)) (diamonds i64)])

(defn opcode [(graph g/Graph) (ref i32)] (-> i32)
  (cast i32 (n/opcode (get (.instructions graph) (cast i64 ref)))))
(defn has? [(values (ArrayList i32)) (ref i32)] (-> bool)
  (let [(mut found) false] (for value values (when (= value ref) (set! found true))) found))

;;; A whitelist of total, nontrapping integer operations. No memory, calls,
;;; division/remainder, overflow flags, float conversion, vector or register
;;; reads. Every input must be integer too (notably comparisons and BITCAST).
;;; MUL costs three units; the whole diamond may speculate at most four.
(defn cost [(graph g/Graph) (ref i32)] (-> i32)
  (let [node (get (.instructions graph) (cast i64 ref)) code (n/opcode node)
        (mut safe) (and (types/integer? (cast i32 (n/type-id node)))
          (or (and (>= code 14) (<= code 23))
              (and (>= code 26) (<= code 28))
              (and (>= code 31) (<= code 36))
              (and (>= code 45) (<= code 54))
              (and (>= code 58) (<= code 60))))]
    (when safe
      (for [i 1 (+ (cast i64 (get (.arities graph) (cast i64 ref))) 1)]
        (let [input (diamond/input graph ref (cast i32 i))]
          (match (g/lookup graph input)
            (None [] (set! safe false))
            (Some [value]
              (unless (types/integer? (cast i32 (n/type-id value))) (set! safe false)))))))
    (if safe (if (= code 28) 3 1) 0)))

;;; A scheduled definition dominating the branch is already available. Only
;;; whitelisted expressions may otherwise move out of an arm. Shared expression
;;; DAG nodes are charged once across all PHIs and both incoming edges.
(defn available? [(graph g/Graph) (prepared pipeline/Prepared) (owners (ArrayList i32))
                  (block i32) (ref i32) (speculated (mut (ArrayList i32))) (budget (mut i32))]
  (-> bool)
  (if (< ref 0) true
      (if (= ref 0) false
          (let [owner (get owners (cast i64 ref)) code (opcode graph ref)]
            (cond (or (= code 89) (= code 44)) false
                  (and (> owner 0) (dom/dominates? (.idom prepared) owner block)) true
                  (has? speculated ref) true
                  :else
                    (let [price (cost graph ref) (mut valid) true]
                      (if (or (= price 0) (> price budget)) false
                          (do
                            (set! budget (- budget price)) (push! (mut speculated) ref)
                            (for [i 1 (+ (cast i64 (get (.arities graph) (cast i64 ref))) 1)]
                              (unless (available? graph prepared owners block
                                        (diamond/input graph ref (cast i32 i)) (mut speculated) (mut budget))
                                (set! valid false)))
                            valid))))))))

(defn candidate [(graph g/Graph) (prepared pipeline/Prepared) (owners (ArrayList i32))
                 (merge i32) (a (dyn Allocator))] (-> (Option Plan))
  (let [edges (.users prepared) region (get (.instructions graph) (cast i64 merge))
        first (.op1 region) second (.op2 region)]
    (if (or (!= (n/opcode region) 112) (!= (get (.arities graph) (cast i64 merge)) 2)
            (<= first 0) (<= second 0) (= first second)
            (!= (opcode graph first) 114) (!= (opcode graph second) 114)
            (!= (diamond/count edges first) 1) (!= (diamond/count edges second) 1))
        (None)
        (let [arm1 (diamond/input graph first 1) arm2 (diamond/input graph second 1)
              branch (diamond/input graph arm1 1)]
          (if (or (not (or (and (= (opcode graph arm1) 107) (= (opcode graph arm2) 108))
                          (and (= (opcode graph arm1) 108) (= (opcode graph arm2) 107))))
                  (!= branch (diamond/input graph arm2 1)) (!= (opcode graph branch) 116)
                  (!= (diamond/count edges arm1) 1) (!= (diamond/count edges arm2) 1)
                  (!= (diamond/count edges branch) 2)
                  (not (conditional/movable-condition? graph (diamond/input graph branch 2))))
              (None)
              (let [(mut phis) (ArrayList::new [i32] a) (mut speculated) (ArrayList::new [i32] a)
                    (mut budget) (: 4 i32) (mut valid) true (mut next) false
                    block (get owners (cast i64 branch))
                    range (get (.ranges edges) (cast i64 merge))]
                (for [i 0 (.count range)]
                  (let [edge (get (.edges edges) (+ (.offset range) i)) ref (.user edge)
                        node (get (.instructions graph) (cast i64 ref))]
                    (if (and (= (.operand edge) 1) (= (n/opcode node) 67)
                             (= (get (.arities graph) (cast i64 ref)) 3)
                             (types/integer? (cast i32 (n/type-id node))))
                        (do
                          (push! (mut phis) ref)
                          (let [incoming [(.op2 node) (.op3 node)]]
                            (for value incoming
                              (unless (available? graph prepared owners block value (mut speculated) (mut budget))
                                (set! valid false)))))
                        (if (and (op/control? (cast i32 (n/opcode node)))
                                 (= (op/operand-code (cast i32 (n/opcode node)) (.operand edge)) op/OPERAND-SRC))
                            (set! next true) (set! valid false)))))
                (free! (mut speculated))
                (if (and valid next (> block 0) (> (len phis) 0) (<= (len phis) 4))
                    (Some (Plan :shape (diamond/collapse-plan graph merge (get phis 0)) :phis phis))
                    (do (free! (mut phis)) (None)))))))))

(defn replace! [(graph (mut g/Graph)) (ref i32) (code u8) (ty u8) (inputs (slice i32))] (-> void)
  (unless (g/rewrite-inputs! (mut graph) ref code ty inputs) (panic "if-convert rewrite")))

;;; Stable END/BEGIN identities match the existing boolean-diamond convention.
;;; No use/CFG/schedule fact is consulted after the first mutation. All phi
;;; sources remain references to the original values, including adjacent plans.
(defn apply! [(graph (mut g/Graph)) (roots (mut (ArrayList i32))) (plan Plan)] (-> void)
  (let [shape (.shape plan) true-first (= (opcode graph (.arm1 shape)) 107)
        dead [(.end1 shape) (.end2 shape) (.arm1 shape) (.arm2 shape)]]
    (replace! (mut graph) (.branch shape) 114 0 [(.previous shape)])
    (for ref (.phis plan)
      (let [node (get (.instructions graph) (cast i64 ref))
            yes (if true-first (.op2 node) (.op3 node)) no (if true-first (.op3 node) (.op2 node))]
        (replace! (mut graph) ref 60 (n/type-id node) [(.condition shape) yes no])))
    (replace! (mut graph) (.merge shape) 106 0 [(.branch shape) (: 0 i32)])
    (for ref dead
      (replace! (mut graph) ref 0 0 [])
      (for [i 0 (len roots)]
        (when (= (get roots i) ref) (set! (mut roots) i (.branch shape)))))))

;;; Batched immutable proofs, then fresh preparation after each batch. Each
;;; conversion removes one IF and creates none, so the fixed point terminates.
(defn run [(source g/Graph) (entry i32) (roots (slice i32)) (a (dyn Allocator))]
  (-> (Result Converted (slice u8)))
  (let [(mut working) (None [g/Graph]) (mut exits) (ArrayList::new [i32] a)
        (mut changes) (: 0 i64) (mut done) false (mut error) ""]
    (for root roots (push! (mut exits) root))
    (while (and (not done) (= error ""))
      (let [graph (match working (Some [owned] owned) (None [] source))]
        (match (pipeline/prepare graph entry (slice exits) a)
          (Err [message] (set! error message))
          (Ok [prepared]
            (let [(mut prepared) prepared (mut owners) (rotate/block-map graph prepared a)
                  (mut plans) (ArrayList::new [Plan] a)]
              (for block (.order prepared)
                (match (candidate graph prepared owners block a)
                  (None [] 0) (Some [plan] (push! (mut plans) plan))))
              (free! (mut owners)) (pipeline/release! (mut prepared))
              (if (= (len plans) 0) (set! done true)
                  (let [(mut owned) (match working (Some [owned] owned) (None [] (g/duplicate source a)))]
                    (for plan plans
                      (apply! (mut owned) (mut exits) plan)
                      (let [(mut phis) (.phis plan)] (free! (mut phis))))
                    (set! changes (+ changes (len plans))) (set! working (Some owned))))
              (free! (mut plans)))))))
    (if (= error "") (Ok (Converted :graph working :roots exits :diamonds changes))
        (do (match working (None [] 0) (Some [owned] (let [(mut owned) owned] (g/release! (mut owned)))))
            (free! (mut exits)) (Err error)))))
