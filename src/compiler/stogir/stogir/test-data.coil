(module stogir.test-data)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

;;; Test cases written as data.
;;;
;;; `(table T [cell ...] [cell ...] ...)` is an array of struct `T` with one
;;; element per row. A row lists the fields of `T` in declaration order, so a
;;; table reads like the argument lists it replaces:
;;;
;;;     (defstruct CheckCase [(ty i32) (rd i32) (expected (slice u32))])
;;;
;;;     (def CHECK-CASES
;;;       (table CheckCase
;;;              [66 0 | 0x0F0D545F 0x2F0B07FF]
;;;              [66 1 | 0x0F0D545F]))
;;;
;;;     (for row CHECK-CASES
;;;       (set! failures
;;;             (+ failures (check (.ty row) (.rd row) (.expected row)))))
;;;
;;; A `|` ends the plain cells of a row: the cells after it, up to the next `|`
;;; or the end of the row, are the elements of one array field (none: an empty
;;; array). Written this way a row of numbers has no nested form, so `coil fmt`
;;; keeps it on one line when it fits and otherwise fills it like a paragraph;
;;; it never gives every cell a line of its own. An array field that is not at
;;; the end of a row is written as an ordinary `[...]` cell.
;;;
;;; The table expands to `[(T :field cell ...) ...]`: every cell is checked
;;; against the type of its field, and a row with too few or too many cells
;;; does not compile.
(defn table [(type Code) & (rows Code)] (-> Code)
  (let [fields (primitive/code-field-count type)
        (mut elements) (primitive/code-list-new)
        (mut index) (: 0 i64)]
    (for row rows
      (unless (primitive/code-vector? row)
        (primitive/error (primitive/code-str "table of "
                                             type
                                             ": row "
                                             index
                                             " is not written [cell ...]")))
      (let [(mut values) (primitive/code-list-new)
            (mut array) (primitive/code-list-new)
            (mut in-array) false]
        (for cell row
          (cond (and (primitive/code-sym? cell) (primitive/code-eq cell `|))
                  (do
                    (when in-array
                      (push! (mut values) `[~@array])
                      (set! array (primitive/code-list-new)))
                    (set! in-array true))
                in-array (push! (mut array) cell)
                :else (push! (mut values) cell)))
        (when in-array
          (push! (mut values) `[~@array]))
        (let [cells (primitive/code-list-done values)
              (mut named) (primitive/code-list-new)
              (mut field) (: 0 i64)]
          (when (!= (len cells) fields)
            (primitive/error (primitive/code-str "table of "
                                                 type
                                                 ": row "
                                                 index
                                                 " has "
                                                 (len cells)
                                                 " cells for "
                                                 fields
                                                 " fields")))
          (for cell cells
            (push! (mut named)
                   (primitive/code-symbol ":"
                                          (primitive/code-field-name type field)))
            (push! (mut named) cell)
            (set! field (+ field 1)))
          (push! (mut elements) `(~type ~@named))))
      (set! index (+ index 1)))
    `[~@elements]))

;;; The declarations of a run of numbered linked functions.
;;;
;;;     (meta (link-entries `entry "stogir_vector_shift_" 0 3 `[u64 u64] `void))
;;;
;;; declares `entry0`, `entry1` and `entry2` as the C functions
;;; `stogir_vector_shift_0` to `stogir_vector_shift_2`, each
;;; `(extern entryN :as "stogir_vector_shift_N" :cc (cc/C) [u64 u64] (-> void))`:
;;; the numbers run from `first` up to, not including, `end`.
(defn link-entries [(name Code)
                    (symbol (slice u8))
                    (first i64)
                    (end i64)
                    (parameters Code)
                    (result Code)] (-> Code)
  (let [(mut declarations) (primitive/code-list-new)]
    (for [number first end]
      (push! (mut declarations)
             `(extern ~(primitive/syntax->datum (primitive/code-symbol name
                                                                       number))
                      :as
                      ~(primitive/code-str symbol number)
                      :cc
                      (cc/C)
                      ~parameters
                      (-> ~result))))
    `(do ~@declarations)))
