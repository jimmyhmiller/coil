;;; The private-context types and option switches every backend shares.
;;;
;;; `Context` (an opaque state pointer plus the emission options that travel
;;; with it) and `Publication` are defined in `stogir.a64.private-leaf` today,
;;; although nothing in them is AArch64-specific. This module is the one neutral
;;; name for them: the facade and the x86-64 backend import the types from here,
;;; so moving the definitions out of the a64 module later changes this file only.
;;; The option setters and readers only read and write `Context` fields.
(module stogir.native.private-types)
(import "stogir.a64.private-leaf"
  :use [Context Publication no-context no-publication active?
        with-shrink-wrap shrink-wrap? with-shrink-retry shrink-retry?
        with-late-preserved late-preserved? with-prune-default prune-default?
        with-loop-reloads loop-reloads? with-loop-evict loop-evict?
        with-call-holes call-holes? with-frame-split frame-split?
        with-predict predict? with-rotate rotate? with-branch-facts branch-facts?
        with-induction induction? with-recolor recolor? with-regional regional?
        with-global-loads global-loads? with-if-convert if-convert?
        with-keep-diamonds keep-diamonds? with-hoist-loads hoist-loads?
        with-strength strength? with-allocation-trace allocation-trace?]
  :reexport)
