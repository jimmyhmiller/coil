;;; Compile entry points of the backend being compiled for: the API of
;;; `stogir.a64.compile` that embedders and target-neutral tests use, forwarding
;;; to `stogir.a64.compile` on AArch64 and `stogir.x64.compile` on x86-64. Only
;;; the chosen backend is imported, so the other never reaches the program.
;;;
;;; Objects are written by `stogir.aot.native`: Mach-O for an AArch64 image, ELF
;;; for an x86-64 one. Symbol names are exact object names; see
;;; `stogir.symbol-name` for the C spelling per system.
(module stogir.native.compile)
(export validate text image vector-image object image-with-options object-with-options image-with-private image-for-private-module image-for-private-module-optimized image-with-options-optimized image-for-private-module-proven image-with-options-proven)
(import "stogir.target" :as target)
(import "stogir.graph" :as g)
(import "stogir.options" :as options)
(import "stogir.image" :as code)
(import "stogir.aot.native" :as aot)
(import "stogir.native.private-types" :as private)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])
(target/arch-pick (import "stogir.a64.compile" :as backend)
                  (import "stogir.x64.compile" :as backend))

;;; Whether every operation of `graph` is one the backend can compile.
(defn validate [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (backend/validate graph))

;;; Machine code alone; an error when the code needs a relocation, which only
;;; an image can carry.
(defn text [(graph g/Graph) (entry i32) (roots (slice i32)) (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (backend/text graph entry roots allocator))

;;; An owned, address-independent image defining `symbol`, for the JIT or an
;;; object writer.
(defn image [(graph g/Graph) (entry i32) (roots (slice i32)) (symbol (slice u8))
             (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (backend/image graph entry roots symbol a))

(defn vector-image [(graph g/Graph) (entry i32) (roots (slice i32)) (symbol (slice u8))
                    (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (backend/vector-image graph entry roots symbol a))

(defn image-with-options [(graph g/Graph) (entry i32) (roots (slice i32))
                          (symbol (slice u8)) (configuration options/Options)
                          (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (backend/image-with-options graph entry roots symbol configuration a))

;;; Self-contained images own a private instance of every referenced leaf.
(defn image-with-private [(graph g/Graph) (entry i32) (roots (slice i32))
                          (symbol (slice u8)) (configuration options/Options)
                          (a (dyn Allocator)) (context private/Context)]
  (-> (Result code/Image (slice u8)))
  (backend/image-with-private graph entry roots symbol configuration a context))

;;; Private leaves stay undefined declarations that the caller binds to the
;;; sealed publication's bodies.
(defn image-for-private-module [(graph g/Graph) (entry i32) (roots (slice i32))
                                (symbol (slice u8)) (configuration options/Options)
                                (a (dyn Allocator)) (context private/Context)
                                (publication private/Publication) (scope usize)]
  (-> (Result code/Image (slice u8)))
  (backend/image-for-private-module graph entry roots symbol configuration a context
                                    publication scope))

;;; The -optimized entries take a graph that is already the optimizer's output
;;; for these roots; the -proven entries also take the proof it recorded.
(defn image-for-private-module-optimized [(graph g/Graph) (entry i32) (roots (slice i32))
                                          (symbol (slice u8)) (configuration options/Options)
                                          (a (dyn Allocator)) (context private/Context)
                                          (publication private/Publication) (scope usize)]
  (-> (Result code/Image (slice u8)))
  (backend/image-for-private-module-optimized graph entry roots symbol configuration a
                                              context publication scope))

(defn image-with-options-optimized [(graph g/Graph) (entry i32) (roots (slice i32))
                                    (symbol (slice u8)) (configuration options/Options)
                                    (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (backend/image-with-options-optimized graph entry roots symbol configuration a))

(defn image-for-private-module-proven [(graph g/Graph) (entry i32) (roots (slice i32))
                                       (symbol (slice u8)) (configuration options/Options)
                                       (a (dyn Allocator)) (context private/Context)
                                       (publication private/Publication) (scope usize)
                                       (proof u128)]
  (-> (Result code/Image (slice u8)))
  (backend/image-for-private-module-proven graph entry roots symbol configuration a context
                                           publication scope proof))

(defn image-with-options-proven [(graph g/Graph) (entry i32) (roots (slice i32))
                                 (symbol (slice u8)) (configuration options/Options)
                                 (a (dyn Allocator)) (proof u128)]
  (-> (Result code/Image (slice u8)))
  (backend/image-with-options-proven graph entry roots symbol configuration a proof))

(defn image-bytes [(compiled (Result code/Image (slice u8))) (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (match compiled
    (Err [message] (Err message))
    (Ok [built]
        (let [(mut source) built
              output (aot/image-object source allocator)]
          (code/release! (mut source))
          output))))

;;; A relocatable object in the target system's format, from the same image
;;; the JIT would map.
(defn object [(graph g/Graph) (entry i32) (roots (slice i32)) (symbol (slice u8))
              (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (image-bytes (image graph entry roots symbol allocator) allocator))

(defn object-with-options [(graph g/Graph) (entry i32) (roots (slice i32))
                           (symbol (slice u8)) (configuration options/Options)
                           (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (image-bytes (image-with-options graph entry roots symbol configuration allocator)
               allocator))
