;;; The private-leaf context of the backend being compiled for: the API of
;;; `stogir.a64.private-leaf` that embedders and target-neutral tests use.
;;;
;;; The types and option switches are shared by every backend
;;; (`stogir.native.private-types`). The functions that own leaf snapshots and
;;; publications forward to `stogir.a64.private-leaf` or
;;; `stogir.x64.private-leaf`; only the chosen backend is imported.
;;;
;;; Not here, because they are backend internals rather than embedder API:
;;; `Frozen`, `create`, `release!`, `call-mask`, `append-to!`, `context-mask`
;;; (register masks of one machine), `validate-references` and `bind-image!`
;;; (called by the backend's own compile entry points).
(module stogir.native.private-leaf)
(import "stogir.target" :as target)
(import "stogir.native.private-types" :use * :reexport)
(import "stogir.image" :as image)
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Option Result])
(target/arch-pick (import "stogir.a64.private-leaf" :as backend)
                  (import "stogir.x64.private-leaf" :as backend))

;;; A module-lifetime context that owns the leaves registered in it.
(defn context-create [(a (dyn Allocator))] (-> Context)
  (backend/context-create a))

(defn context-release! [(context (mut Context))] (-> void)
  (backend/context-release! (mut context)))

;;; Snapshot the private text definition `symbol` of `source` under `name`.
(defn register-as! [(context (mut Context)) (name (slice u8)) (source image/Image)
                    (symbol i32) (size i64) (signature (slice u8))]
  (-> (Result bool (slice u8)))
  (backend/register-as! (mut context) name source symbol size signature))

(defn register! [(context (mut Context)) (source image/Image) (symbol i32)
                 (size i64) (signature (slice u8))] (-> (Result bool (slice u8)))
  (backend/register! (mut context) source symbol size signature))

(defn freeze! [(context (mut Context))] (-> void)
  (backend/freeze! (mut context)))

(defn confirm-publication! [(context (mut Context)) (scope usize) (name (slice u8))
                            (symbol i64) (binding u8) (text (slice u8))]
  (-> (Result bool (slice u8)))
  (backend/confirm-publication! (mut context) scope name symbol binding text))

(defn seal-module! [(context (mut Context)) (scope usize)] (-> (Option Publication))
  (backend/seal-module! (mut context) scope))

(defn module-valid? [(context Context) (publication Publication) (scope usize)] (-> bool)
  (backend/module-valid? context publication scope))

(defn binding [(context Context) (publication Publication) (scope usize) (name (slice u8))]
  (-> (Option i64))
  (backend/binding context publication scope name))

(defn verify-publication [(context Context) (publication Publication) (scope usize)
                          (name (slice u8)) (symbol i64) (kind u8) (text (slice u8))]
  (-> bool)
  (backend/verify-publication context publication scope name symbol kind text))
