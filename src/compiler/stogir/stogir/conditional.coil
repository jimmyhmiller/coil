; COND shape/truth/folds follow dstogov/ir ir.h, ir_private.h, ir_fold.h, 92171d0. See NOTICE.
(module stogir.conditional)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "coil.result" :use [Result Ok Err Option Some None])

;;; RLOAD anti-dependencies and overflow flags are not modeled by GCM. Preserve
;;; the pinned exclusions instead of moving their conditions across writes.
(defn movable-condition? [(graph g/Graph) (reference i32)] (-> bool)
  (match (g/lookup graph reference)
    (None [] false)
    (Some [node]
          (let [opcode (cast i32 (n/opcode node))
                (mut safe) true]
            (when (or (= opcode 44) (= opcode 89)) (set! safe false))
            (when (and (>= opcode 14) (<= opcode 25))
              (let [operands [(.op1 node) (.op2 node)]]
                (for r operands
                  (match (g/lookup graph r)
                    (Some [v] (when (= (n/opcode v) 89) (set! safe false)))
                    (None [] (set! safe false))))))
            safe))))


;;; Both choices already feed this ordered integer comparison, so they are
;;; available before its branch. Match only exact complete-word identities;
;;; no arbitrary-value availability, constant-bound adjustment or float rule.
(defn comparison-input-choice? [(graph g/Graph) (ty u8) (condition i32)
                                (first i32) (second i32)] (-> bool)
  (let [width (types/scalar-size (cast i32 ty) 8)]
    (and (> condition 0) (types/integer? (cast i32 ty))
         (or (= width 4) (= width 8))
         (match (g/lookup graph condition)
           (None [] false)
           (Some [cmp]
             (and (>= (n/opcode cmp) 16) (<= (n/opcode cmp) 23)
                  (= (n/type-id cmp) 1)
                  (or (and (= first (.op1 cmp)) (= second (.op2 cmp)))
                      (and (= first (.op2 cmp)) (= second (.op1 cmp))))
                  (movable-condition? graph condition)
                  (match (g/lookup graph first)
                    (None [] false) (Some [a] (= (n/type-id a) ty)))
                  (match (g/lookup graph second)
                    (None [] false) (Some [b] (= (n/type-id b) ty)))))))))

(defn operands [(graph g/Graph) (ty i32) (condition i32) (yes i32) (no i32)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""]
    (when (or (= ty 0) (not (types/valid? ty)))
      (set! error "COND requires a scalar or vector value type"))
    (match (g/lookup graph condition)
      (None [] (set! error "COND condition missing"))
      (Some [node]
            (when (or (= (n/opcode node) 72)
                      (= (n/opcode node) 70)
                      (= (n/type-id node) 0)
                      (not (types/valid-scalar? (cast i32 (n/type-id node)))))
              (set! error "COND requires an ordinary scalar condition"))))
    (for reference [yes no]
      (match (g/lookup graph reference)
        (None [] (set! error "COND arm missing"))
        (Some [node]
              (when (or (= (n/opcode node) 72)
                        (= (n/opcode node) 70)
                        (!= (cast i32 (n/type-id node)) ty))
                (set! error "COND arm type or storage mismatch")))))
    (if (= error "") (Ok ty) (Err error))))

(defn validate [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "COND instruction missing"))
    (Some [node]
          (if (or (<= reference 0)
                  (!= (n/opcode node) 60)
                  (!= (get (.arities graph) (cast i64 reference)) 3))
              (Err "invalid COND instruction")
              (operands graph
                        (cast i32 (n/type-id node))
                        (.op1 node)
                        (.op2 node)
                        (.op3 node))))))

;;; Named addresses remain unresolved: the image resolver permits address zero.
;;; Numeric floating truth is false for either signed zero and true for NaNs.
(defn truth-value [(node n/Node)] (-> (Option bool))
  (if (not (symbols/numeric? node))
      (None)
      (let [ty (n/type-id node)
            bits (n/constant-bits node)]
        (if (types/integer? (cast i32 ty))
            (Some (!= bits 0))
            (if (= ty 12)
                (Some (!= (& bits 0x7FFFFFFFFFFFFFFF) 0))
                (if (= ty 13)
                    (Some (!= (& bits 0x7FFFFFFF) 0))
                    (None)))))))

(defn truth [(graph g/Graph) (reference i32)] (-> (Option bool))
  (if (>= reference 0)
      (None)
      (match (g/lookup graph reference)
        (None [] (None))
        (Some [node] (truth-value node)))))

;;; Integer comparison complements preserve exact SSA operands. Floating and
;;; vector predicates deliberately require exact identity: no NaN or lane facts
;;; are inferred here. Return 1 for equal, -1 for complementary, 0 for unknown.
;;; Truth-preserving normal form for comparing branch predicates: integer/BOOL
;;; extensions and integer BITCASTs, Boolean NOT, and EQ/NE against an integer
;;; zero. Floating views are never crossed (-0.0 has nonzero bits).
(defstruct Truth [(base i32) (positive bool)])

(defn truth-normal [(graph g/Graph) (reference i32)] (-> Truth)
  (let [(mut r) reference
        (mut positive) true
        (mut steps) 0]
    (while (< steps 16)
      (set! steps (+ steps 1))
      (if (<= r 0)
          (set! steps 16)
          (let [node (get (.instructions graph) (cast i64 r))
                opcode (n/opcode node)
                source (.op1 node)
                source-type
                  (if (> source 0)
                      (cast i32 (n/type-id (get (.instructions graph) (cast i64 source))))
                      0)]
            (cond (and (or (= opcode 33) (= opcode 34) (= opcode 36))
                       (> source 0)
                       (types/integer? (cast i32 (n/type-id node)))
                       (or (= source-type 1) (types/integer? source-type)))
                    (set! r source)
                  (and (= opcode 45) (= (n/type-id node) 1) (= source-type 1))
                    (do (set! positive (not positive)) (set! r source))
                  (and (or (= opcode 14) (= opcode 15))
                       (> source 0)
                       (or (= source-type 1) (types/integer? source-type))
                       (match (g/lookup graph (.op2 node))
                         (None [] false)
                         (Some [literal]
                               (and (< (.op2 node) 0)
                                    (symbols/numeric? literal)
                                    (= (n/constant-bits literal) 0)))))
                    (do (when (= opcode 14) (set! positive (not positive)))
                        (set! r source))
                  :else (set! steps 16)))))
    (Truth :base r :positive positive)))

(defn predicate-relation [(graph g/Graph) (first i32) (second i32)] (-> i32)
  (let [left (truth-normal graph first)
        right (truth-normal graph second)
        direct (exact-relation graph (.base left) (.base right))]
    (if (= direct 0)
        0
        (if (= (.positive left) (.positive right)) direct (- 0 direct)))))

(defn exact-relation [(graph g/Graph) (first i32) (second i32)] (-> i32)
  (if (= first second)
      1
      (match (g/lookup graph first)
        (None [] 0)
        (Some [left]
          (match (g/lookup graph second)
            (None [] 0)
            (Some [right]
              (let [opcode (cast i32 (n/opcode left))]
                (if (and (>= opcode 14) (<= opcode 23)
                         (= (cast i32 (n/opcode right)) (^ opcode 1))
                         (= (.op1 left) (.op1 right))
                         (= (.op2 left) (.op2 right)))
                    (match (g/lookup graph (.op1 left))
                      (None [] 0)
                      (Some [value]
                        (if (types/integer? (cast i32 (n/type-id value))) -1 0)))
                    0))))))))

(defn integer-comparison? [(graph g/Graph) (reference i32)] (-> bool)
  (match (g/lookup graph reference)
    (None [] false)
    (Some [node]
      (and (>= (n/opcode node) 14) (<= (n/opcode node) 23)
           (match (g/lookup graph (.op1 node))
             (None [] false)
             (Some [value] (types/integer? (cast i32 (n/type-id value)))))))))


;;; Pinned ir.c:ir_check_dominating_predicates_i. Inspect only the straight
;;; control chain and exact SSA identity (or integer complement operands); joins and independent entries are
;;; barriers. Coil may preallocate block headers, so numeric reference order
;;; cannot bound ancestry as it does in upstream's sequential builder. The step
;;; bound makes this read-only query total even on malformed control cycles.
(defn dominating-truth [(graph g/Graph) (control i32) (condition i32)]
  (-> (Option bool))
  (let [(mut current) control
        (mut previous) (: 0 u8)
        (mut steps) (: 0 i64)
        (mut scanning) (> condition 0)
        (mut result) (: (None) (Option bool))]
    (while (and scanning
                (> current 0)
                (< steps (len (.instructions graph))))
      (match (g/lookup graph current)
        (None [] (set! scanning false))
        (Some [node]
              (let [opcode (n/opcode node)]
                (cond (or (= opcode 101) (= opcode 102)
                          (and (= opcode 116)
                               (or (= previous 107) (= previous 108))))
                        (let [relation (predicate-relation graph (.op2 node) condition)]
                          (when (!= relation 0)
                            (let [known (if (= opcode 116) (= previous 107)
                                           (= opcode 101))]
                              (set! result (Some (if (= relation 1) known (not known))))
                              (set! scanning false))))
                      (or (= opcode 104)
                          (= opcode 105)
                          (and (= opcode 106) (!= (.op2 node) 0))
                          (= opcode 112)
                          (= opcode 113)
                          (not (op/control? (cast i32 opcode))))
                        (set! scanning false))
                (set! previous opcode)
                (set! current (.op1 node)))))
      (set! steps (+ steps 1)))
    result))

(defn build! [(graph (mut g/Graph)) (ty i32) (condition i32) (yes i32) (no i32)]
  (-> (Result i32 (slice u8)))
  (match (operands graph ty condition yes no)
    (Err [message] (Err message))
    (Ok [_]
        (if (= yes no)
            (Ok yes)
            (match (truth graph condition)
              (Some [known] (Ok (if known yes no)))
              (None []
                    (let [key
                            (| (: 60 u128)
                               (<< (cast u128 ty) 8)
                               (<< (cast u128 (cast u32 condition)) 16)
                               (<< (cast u128 (cast u32 yes)) 48)
                               (<< (cast u128 (cast u32 no)) 80))]
                      (match (get (.expressions graph) key)
                        (Some [reference] (Ok reference))
                        (None []
                              (match (g/append-inputs! (mut graph)
                                                       60
                                                       (cast u8 ty)
                                                       [condition yes no])
                                (None [] (Err "COND reference space exhausted"))
                                (Some [reference]
                                      (do
                                        (set! (mut (.expressions graph))
                                              key
                                              reference)
                                        (Ok reference)))))))))))))
