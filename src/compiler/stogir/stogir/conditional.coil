; COND shape/truth/folds follow dstogov/ir ir.h, ir_private.h, ir_fold.h, 92171d0. See NOTICE.
(module stogir.conditional)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "coil.result" :use [Result Ok Err Option Some None])

;;; RLOAD anti-dependencies and overflow flags are not modeled by GCM. Preserve
;;; the pinned exclusions instead of moving their conditions across writes.
(defn movable-condition? [(graph g/Graph) (reference i32)] (-> bool)
  (match (g/lookup graph reference)
    (None [] false)
    (Some [node]
          (let [opcode (cast i32 (n/opcode node))
                (mut safe) true]
            (when (or (= opcode 44) (= opcode 89)) (set! safe false))
            (when (and (>= opcode 14) (<= opcode 25))
              (let [operands [(.op1 node) (.op2 node)]]
                (for r operands
                  (match (g/lookup graph r)
                    (Some [v] (when (= (n/opcode v) 89) (set! safe false)))
                    (None [] (set! safe false))))))
            safe))))


(defn operands [(graph g/Graph) (ty i32) (condition i32) (yes i32) (no i32)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""]
    (when (or (= ty 0) (not (types/valid? ty)))
      (set! error "COND requires a scalar or vector value type"))
    (match (g/lookup graph condition)
      (None [] (set! error "COND condition missing"))
      (Some [node]
            (when (or (= (n/opcode node) 72)
                      (= (n/opcode node) 70)
                      (= (n/type-id node) 0)
                      (not (types/valid-scalar? (cast i32 (n/type-id node)))))
              (set! error "COND requires an ordinary scalar condition"))))
    (for reference [yes no]
      (match (g/lookup graph reference)
        (None [] (set! error "COND arm missing"))
        (Some [node]
              (when (or (= (n/opcode node) 72)
                        (= (n/opcode node) 70)
                        (!= (cast i32 (n/type-id node)) ty))
                (set! error "COND arm type or storage mismatch")))))
    (if (= error "") (Ok ty) (Err error))))

(defn validate [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "COND instruction missing"))
    (Some [node]
          (if (or (<= reference 0)
                  (!= (n/opcode node) 60)
                  (!= (get (.arities graph) (cast i64 reference)) 3))
              (Err "invalid COND instruction")
              (operands graph
                        (cast i32 (n/type-id node))
                        (.op1 node)
                        (.op2 node)
                        (.op3 node))))))

;;; Named addresses remain unresolved: the image resolver permits address zero.
;;; Numeric floating truth is false for either signed zero and true for NaNs.
(defn truth-value [(node n/Node)] (-> (Option bool))
  (if (not (symbols/numeric? node))
      (None)
      (let [ty (n/type-id node)
            bits (n/constant-bits node)]
        (if (types/integer? (cast i32 ty))
            (Some (!= bits 0))
            (if (= ty 12)
                (Some (!= (& bits 0x7FFFFFFFFFFFFFFF) 0))
                (if (= ty 13)
                    (Some (!= (& bits 0x7FFFFFFF) 0))
                    (None)))))))

(defn truth [(graph g/Graph) (reference i32)] (-> (Option bool))
  (if (>= reference 0)
      (None)
      (match (g/lookup graph reference)
        (None [] (None))
        (Some [node] (truth-value node)))))

;;; Pinned ir.c:ir_check_dominating_predicates_i. Inspect only the straight
;;; control chain and exact SSA identity; joins and independent entries are
;;; barriers. Coil may preallocate block headers, so numeric reference order
;;; cannot bound ancestry as it does in upstream's sequential builder. The step
;;; bound makes this read-only query total even on malformed control cycles.
(defn dominating-truth [(graph g/Graph) (control i32) (condition i32)]
  (-> (Option bool))
  (let [(mut current) control
        (mut previous) (: 0 u8)
        (mut steps) (: 0 i64)
        (mut scanning) (> condition 0)
        (mut result) (: (None) (Option bool))]
    (while (and scanning
                (> current 0)
                (< steps (len (.instructions graph))))
      (match (g/lookup graph current)
        (None [] (set! scanning false))
        (Some [node]
              (let [opcode (n/opcode node)]
                (cond (and (= opcode 102) (= (.op2 node) condition))
                        (do (set! result (Some false)) (set! scanning false))
                      (and (= opcode 101) (= (.op2 node) condition))
                        (do (set! result (Some true)) (set! scanning false))
                      (and (= opcode 116)
                           (= (.op2 node) condition)
                           (or (= previous 107) (= previous 108)))
                        (do
                          (set! result (Some (= previous 107)))
                          (set! scanning false))
                      (or (= opcode 104)
                          (= opcode 105)
                          (and (= opcode 106) (!= (.op2 node) 0))
                          (= opcode 112)
                          (= opcode 113)
                          (not (op/control? (cast i32 opcode))))
                        (set! scanning false))
                (set! previous opcode)
                (set! current (.op1 node)))))
      (set! steps (+ steps 1)))
    result))

(defn build! [(graph (mut g/Graph)) (ty i32) (condition i32) (yes i32) (no i32)]
  (-> (Result i32 (slice u8)))
  (match (operands graph ty condition yes no)
    (Err [message] (Err message))
    (Ok [_]
        (if (= yes no)
            (Ok yes)
            (match (truth graph condition)
              (Some [known] (Ok (if known yes no)))
              (None []
                    (let [key
                            (| (: 60 u128)
                               (<< (cast u128 ty) 8)
                               (<< (cast u128 (cast u32 condition)) 16)
                               (<< (cast u128 (cast u32 yes)) 48)
                               (<< (cast u128 (cast u32 no)) 80))]
                      (match (get (.expressions graph) key)
                        (Some [reference] (Ok reference))
                        (None []
                              (match (g/append-inputs! (mut graph)
                                                       60
                                                       (cast u8 ty)
                                                       [condition yes no])
                                (None [] (Err "COND reference space exhausted"))
                                (Some [reference]
                                      (do
                                        (set! (mut (.expressions graph))
                                              key
                                              reference)
                                        (Ok reference)))))))))))))
