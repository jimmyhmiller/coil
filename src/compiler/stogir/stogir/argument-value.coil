;;; ARGVAL metadata and indirect by-value semantics follow dstogov/ir. See NOTICE.
(module stogir.argument-value)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.frame" :as frame)
(import "stogir.uses" :as uses)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Shape [(size i64) (alignment i64)])

(defn inputs [(graph g/Graph) (source i32) (size i32) (alignment i32)]
  (-> (Result Shape (slice u8)))
  (if (or (< size 0)
          (< alignment 0)
          (and (!= alignment 0)
               (not (frame/valid-alignment? (cast i64 alignment)))))
      (Err "invalid ARGVAL size or alignment")
      (match (g/lookup graph source)
        (None [] (Err "ARGVAL source missing"))
        (Some [node]
              (if (or (!= (n/type-id node) 6)
                      (= (n/opcode node) 72)
                      (= (n/opcode node) 70))
                  (Err "ARGVAL source must be an ADDR value")
                  (Ok (Shape
                        :size (cast i64 size)
                        :alignment (if (< alignment 8) 8 (cast i64 alignment)))))))))

(defn validate [(graph g/Graph) (reference i32)]
  (-> (Result Shape (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "ARGVAL missing"))
    (Some [node]
          (if (or (<= reference 0)
                  (!= (n/opcode node) 70)
                  (!= (n/type-id node) 6)
                  (!= (get (.arities graph) (cast i64 reference)) 3))
              (Err "invalid ARGVAL shape")
              (inputs graph (.op1 node) (.op2 node) (.op3 node))))))

;;; ARGVAL denotes a call-time copy, not an ordinary address expression. It may
;;; be reused as multiple arguments, each of which gets its own private copy.
(defn verify [(graph g/Graph) (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut references) (ArrayList::new [i32] allocator)
        (mut r) (: 1 i64)
        (mut error) ""]
    (while (and (= error "") (< r (len (.instructions graph))))
      (let [node (get (.instructions graph) r)
            count (get (.arities graph) r)]
        (when (= (n/opcode node) 70)
          (match (validate graph (cast i32 r))
            (Err [message] (set! error message))
            (Ok [_] (push! (mut references) (cast i32 r)))))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    (when (and (= error "") (> (len references) 0))
      (let [(mut indexed) (uses/build graph allocator)]
        (for reference references
          (let [range (get (.ranges indexed) (cast i64 reference))
                (mut i) (: 0 i64)]
            (while (< i (.count range))
              (let [edge (get (.edges indexed) (+ (.offset range) i))
                    user (get (.instructions graph) (cast i64 (.user edge)))]
                (when (or (!= (n/opcode user) 79) (< (.operand edge) 3))
                  (set! error "ARGVAL is only valid as a CALL argument")))
              (set! i (+ i 1)))))
        (uses/release! (mut indexed))))
    (let [count (cast i32 (len references))]
      (free! (mut references))
      (if (= error "") (Ok count) (Err error)))))
