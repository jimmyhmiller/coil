;;; Deduplicating minimum-reference worklist, following pinned ir_private.h.
(module stogir.bitqueue)
(import "stogir.bitset" :as bits)
(import "coil.alloc" :use [Allocator])

(defstruct Queue [(members bits/Bits) (word i64)])

(defn create [(size i64) (a (dyn Allocator))] (-> Queue)
  (Queue :members (bits/create size a) :word 0))

(defn add! [(queue (mut Queue)) (reference i64)] (-> bool)
  (let [changed (bits/add! (mut (.members queue)) reference)]
    (when changed
      (set! (.word queue)
            (if (< (/ reference 64) (.word queue))
                (/ reference 64)
                (.word queue))))
    changed))

(defn remove! [(queue (mut Queue)) (reference i64)] (-> bool)
  (bits/remove! (mut (.members queue)) reference))

(defn contains? [(queue Queue) (reference i64)] (-> bool)
  (bits/contains? (.members queue) reference))

;;; Earlier additions rewind the word cursor; duplicates never add extra work.
(defn pop! [(queue (mut Queue))] (-> i64)
  (let [reference (bits/next-set (.members queue) (* (.word queue) 64))]
    (if (< reference 0)
        (set! (.word queue) (len (.words (.members queue))))
        (do
          (bits/remove! (mut (.members queue)) reference)
          (set! (.word queue) (/ reference 64))))
    reference))

(defn clear! [(queue (mut Queue))] (-> void)
  (for [i 0 (len (.words (.members queue)))]
    (set! (mut (.words (.members queue))) i 0))
  (set! (.word queue) 0))

(defn release! [(queue (mut Queue))] (-> void)
  (bits/release! (mut (.members queue)))
  (set! (.word queue) 0))
