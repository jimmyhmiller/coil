;;; Stable per-subposition transfer lists for linear-time emission grouping.
(module stogir.transfer-index)
(import "stogir.locations" :as locations)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(defstruct Index [(heads (ArrayList i64)) (next (ArrayList i64))])

(defn create [(allocator (dyn Allocator))] (-> Index)
  (Index
    :heads (ArrayList::new [i64] allocator)
    :next (ArrayList::new [i64] allocator)))

(defn release! [(index (mut Index))] (-> void)
  (free! (mut (.heads index)))
  (free! (mut (.next index))))

;;; The source copy list must remain unchanged while the index is in use.
;;; Empty positions have head=-1. Lists preserve the original order at a position.
(defn build [(copies (slice locations/Transfer))
             (positions i64)
             (allocator (dyn Allocator))]
  (-> (Result Index (slice u8)))
  (if (< positions 0)
      (Err "negative transfer position count")
      (let [(mut result) (create allocator)
            (mut tails) (ArrayList::new [i64] allocator)
            (mut error) ""
            (mut i) (: 0 i64)]
        (reserve! (mut (.heads result)) positions)
        (reserve! (mut tails) positions)
        (reserve! (mut (.next result)) (len copies))
        (while (< i positions)
          (push! (mut (.heads result)) -1)
          (push! (mut tails) -1)
          (set! i (+ i 1)))
        (set! i 0)
        (while (and (= error "") (< i (len copies)))
          (let [position (.position (get copies i))]
            (if (or (< position 0) (>= position positions))
                (set! error "transfer outside scheduled subpositions")
                (do
                  (push! (mut (.next result)) -1)
                  (let [tail (get tails position)]
                    (if (< tail 0)
                        (set! (mut (.heads result)) position i)
                        (set! (mut (.next result)) tail i)))
                  (set! (mut tails) position i))))
          (set! i (+ i 1)))
        (free! (mut tails))
        (if (= error "") (Ok result) (do (release! (mut result)) (Err error))))))
