;;; Construct hole-preserving virtual-register ranges from scheduled block facts.
(module stogir.live-ranges)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.schedule" :as schedule)
(import "stogir.register-live" :as live)
(import "stogir.interval" :as interval)
(import "stogir.interval-queue" :as queue)
(import "stogir.bitset" :as bits)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Some None])

(defstruct Value [(ranges (ArrayList interval/Range))])

;;; Position 2*i is an input use, 2*i+1 a definition; ranges are half-open.
;;; Matching verified graph/schedule/liveness and complete reachable order required.
(defn build [(graph g/Graph)
             (scheduled schedule/Schedule)
             (analysis live/Analysis)
             (order (ArrayList i32))
             (allocator (dyn Allocator))] (-> (ArrayList Value))
  (let [(mut result) (ArrayList::new [Value] allocator)
        (mut starts) (ArrayList::new [i64] allocator)
        (mut ends) (ArrayList::new [i64] allocator)
        (mut touched) (bits/create (len (.instructions graph)) allocator)
        (mut i) 0]
    (while (< i (len (.instructions graph)))
      (push! (mut result)
             (Value :ranges (ArrayList::new [interval/Range] allocator)))
      (push! (mut starts) -1)
      (push! (mut ends) 0)
      (set! i (+ i 1)))
    (for block order
      (let [range (get (.ranges scheduled) (cast i64 block))
            state
              (at (.states analysis) (get (.indices analysis) (cast i64 block)))
            begin (* (.offset range) 2)
            end (* (+ (.offset range) (.count range)) 2)
            (mut value) (bits/next-set (.output state) 0)
            (mut j) 0]
        (while (>= value 0)
          (set! (mut starts) value begin)
          (set! (mut ends) value end)
          (bits/add! (mut touched) value)
          (set! value (bits/next-set (.output state) (+ value 1))))
        (while (< j (.count range))
          (let [index (+ (.offset range) j)
                reference (get (.nodes scheduled) index)
                node (get (.instructions graph) (cast i64 reference))
                opcode (cast i32 (n/opcode node))
                position (* index 2)
                count (get (.arities graph) (cast i64 reference))
                (mut k) (: 1 i32)]
            (when (!= opcode 67)
              (while (<= k count)
                (when (live/data-edge? (op/operand-kind opcode k))
                  (match (g/operand graph reference k)
                    (None [] 0)
                    (Some [source]
                          (when (> source 0)
                            (let [v (cast i64 source)]
                              (when (< (get starts v) 0)
                                (set! (mut starts) v begin))
                              (when (< (get ends v) (+ position 1))
                                (set! (mut ends) v (+ position 1)))
                              (bits/add! (mut touched) v))))))
                (set! k (+ k 1))))
            (when (and (!= opcode 72)
                       (!= (n/type-id node) 0)
                       (not (op/block-start? opcode))
                       (not (op/block-end? opcode)))
              (let [v (cast i64 reference)]
                ; All Phi results exist together on entry. Their textual
                ; schedule positions are not independent definitions.
                (set! (mut starts) v (if (= opcode 67) begin (+ position 1)))
                (when (< (get ends v) (+ position 2))
                  (set! (mut ends) v (+ position 2)))
                (bits/add! (mut touched) v))))
          (set! j (+ j 1)))
        (set! value (bits/next-set touched 0))
        (while (>= value 0)
          (let [target (elem (mut result) value)]
            (interval/add! (mut (.ranges target))
                           (get starts value)
                           (get ends value)))
          (set! (mut starts) value -1)
          (set! (mut ends) value 0)
          (bits/remove! (mut touched) value)
          (set! value (bits/next-set touched (+ value 1))))))
    (bits/release! (mut touched))
    (free! (mut starts))
    (free! (mut ends))
    result))

(defn release! [(values (mut (ArrayList Value)))] (-> void)
  (let [(mut i) 0]
    (while (< i (len values))
      (let [value (elem (mut values) i)] (free! (mut (.ranges value))))
      (set! i (+ i 1))))
  (free! (mut values)))

;;; Queue nonempty virtual intervals in start order for linear scan.
(defn unhandled [(values (ArrayList Value)) (allocator (dyn Allocator))]
  (-> (ArrayList queue/Item))
  (let [(mut heap) (ArrayList::new [queue/Item] allocator)
        (mut i) 1]
    (while (< i (len values))
      (let [value (at values i)]
        (when (> (len (.ranges value)) 0)
          (queue/insert! (mut heap)
                         (queue/Item
                           :position (.start (get (.ranges value) 0))
                           :interval (cast i32 i)))))
      (set! i (+ i 1)))
    heap))
