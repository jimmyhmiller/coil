;;; Late conversion of two-way choices into COND, without control flow
;;; analysis. A MERGE of two ENDs that each leave a projection of one IF
;;; directly is a diamond whose arms hold no control: whatever its PHIs carry
;;; is pinned before the IF or floats. When every PHI is an integer, or an f32
;;; or f64 of an IF diamond, and its inputs cost at most BUDGET speculated
;;; operations in total (what the condition itself is computed from costs
;;; nothing), the PHIs become COND nodes on the IF's condition and the IF, its
;;; projections and both ENDs go away, in the END/BEGIN convention of
;;; stogir.if-convert. A floating COND chooses between two bit patterns
;;; (FCSEL), so NaN payloads and signed zeros pass through unchanged.
;;;
;;; A SWITCH whose cases all reach one MERGE through empty blocks, that MERGE
;;; and the default meeting at a second one, is the same choice between two
;;; values (stogir.equality-chain builds it from `(or (= c K1) (= c K2) ...)`).
;;; When the case constants lie within 64 of each other, the choice is one bit
;;; of a literal mask, and each PHI becomes
;;;   COND(UGT(c - low, span), default, COND(NE(AND(SHR(mask, c - low), 1), 0),
;;;                                         matched, default))
;;; under the same pricing of its two values. A shift count is taken modulo
;;; the width; the outer COND discards the bit read for a count out of range.
;;;
;;; Two walks of the node array. The first finds the shapes; a function with
;;; none returns after it. The second reads the PHIs of each shape and counts
;;; the references to the nodes that would be deleted, so a projection or END
;;; that anything else names (guarded data, another control user) keeps its
;;; diamond. Runs once: every plan is proved against the unedited graph, the
;;; structural regions are disjoint, and PHI inputs keep their references.
(module stogir.select-diamond)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.uses" :as uses)
(import "stogir.boolean-diamond" :as diamond)
(import "stogir.conditional" :as conditional)
(import "stogir.if-convert" :as convert)
(import "stogir.switch" :as switch)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Option Some None])

;;; Speculated operation units one diamond may introduce (stogir.if-convert's
;;; cost: one per total integer operation, three for MUL).
(def BUDGET (: 4 i32))

;;; PHIs one diamond may carry. Each becomes one conditional select.
(def MAX-PHIS (: 4 i64))

;;; For an IF diamond table is zero. For a SWITCH shape, branch is the SWITCH,
;;; table the MERGE of its cases (arm1), arm2 the default projection,
;;; match-first tells whether the first END of merge comes from table, and
;;; low/span/mask describe the case constants in the SWITCH's key order.
(defstruct Shape
  [(merge i32) (end1 i32) (end2 i32) (arm1 i32) (arm2 i32) (branch i32)
   (phi1 i32) (phi2 i32) (phi3 i32) (phi4 i32) (phis i64) (valid bool)
   (table i32) (match-first bool) (low u64) (span u64) (mask u64)])

;;; Cases one SWITCH shape may have: the bits of its mask.
(def MAX-CASES (: 64 i32))

;;; The graph may not have been verified yet (the stages after this one do
;;; that), so no operand is trusted to name a cell: an operand outside the
;;; graph reads as opcode 0 and is never indexed.
(defn inside? [(graph g/Graph) (reference i32)] (-> bool)
  (and (> reference 0) (< (cast i64 reference) (len (.instructions graph)))))

(defn code [(graph g/Graph) (reference i32)] (-> i32)
  (if (inside? graph reference)
      (cast i32 (n/opcode (get (.instructions graph) (cast i64 reference))))
      0))

;;; The diamond that MERGE closes, valid when the control shape holds; its
;;; PHIs are not read here.
(defn shape [(graph g/Graph) (merge i32)] (-> Shape)
  (let [region (get (.instructions graph) (cast i64 merge))
        end1 (.op1 region)
        end2 (.op2 region)
        ends (and (> end1 0) (> end2 0) (!= end1 end2)
                  (= (code graph end1) 114) (= (code graph end2) 114))
        arm1 (if ends (diamond/input graph end1 1) 0)
        arm2 (if ends (diamond/input graph end2 1) 0)
        arms (and (> arm1 0) (> arm2 0)
                  (or (and (= (code graph arm1) 107) (= (code graph arm2) 108))
                      (and (= (code graph arm1) 108) (= (code graph arm2) 107))))
        branch (if arms (diamond/input graph arm1 1) 0)]
    (Shape :merge merge :end1 end1 :end2 end2 :arm1 arm1 :arm2 arm2 :branch branch
           :phi1 0 :phi2 0 :phi3 0 :phi4 0 :phis 0
           :valid (and arms (> branch 0)
                       (= branch (diamond/input graph arm2 1))
                       (= (code graph branch) 116)
                       (conditional/movable-condition? graph (diamond/input graph branch 2)))
           :table 0 :match-first false :low 0 :span 0 :mask 0)))

;;; The SWITCH shape that MERGE closes, valid when the control shape and the
;;; case constants hold; its PHIs are not read here.
(defn dispatch-shape [(graph g/Graph) (merge i32)] (-> Shape)
  (let [region (get (.instructions graph) (cast i64 merge))
        end1 (.op1 region)
        end2 (.op2 region)
        ends (and (> end1 0) (> end2 0) (!= end1 end2)
                  (= (code graph end1) 114) (= (code graph end2) 114))
        from1 (if ends (diamond/input graph end1 1) 0)
        from2 (if ends (diamond/input graph end2 1) 0)
        match-first (= (code graph from1) 112)
        table (if match-first from1 from2)
        default (if match-first from2 from1)
        branch (if (= (code graph default) 111) (diamond/input graph default 1) 0)
        cases (if (= (code graph table) 112)
                  (cast i32 (get (.arities graph) (cast i64 table)))
                  0)
        (mut valid) (and ends (> branch 0) (= (code graph branch) 117)
                         (= (get (.arities graph) (cast i64 branch)) 2)
                         (>= cases 2) (<= cases MAX-CASES)
                         (conditional/movable-condition? graph (diamond/input graph branch 2)))
        (mut low) (: 0xFFFFFFFFFFFFFFFF u64)
        (mut high) (: 0 u64)
        (mut mask) (: 0 u64)]
    (when valid
      (match (switch/selector-type graph (diamond/input graph branch 2))
        (Err [_] (set! valid false))
        (Ok [ty]
          (if (or (= ty 1) (< (types/scalar-size ty 8) 1))
              (set! valid false)
              (do
                (for [pass (: 0 i32) 2]
                  (for [i (: 1 i32) (+ cases 1)]
                    (let [end (diamond/input graph table i)
                          arm (if (= (code graph end) 114) (diamond/input graph end 1) 0)]
                      (if (or (!= (code graph arm) 109)
                              (!= (diamond/input graph arm 1) branch))
                          (set! valid false)
                          (match (switch/key graph (diamond/input graph arm 2) ty)
                            (Err [_] (set! valid false))
                            (Ok [key]
                              (if (= pass 0)
                                  (do (when (< key low) (set! low key))
                                      (when (> key high) (set! high key)))
                                  (when (<= (- high low) 63)
                                    (set! mask (| mask (<< (: 1 u64) (- key low)))))))))))
                  (when (and (= pass 0) valid (> (- high low) 63))
                    (set! valid false))))))))
    (Shape :merge merge :end1 end1 :end2 end2 :arm1 table :arm2 default :branch branch
             :phi1 0 :phi2 0 :phi3 0 :phi4 0 :phis 0 :valid valid
           :table table :match-first match-first
           :low low :span (if valid (- high low) 0) :mask mask)))

;;; Values pinned to control. An arm without control holds none of them, so
;;; one that a PHI of the diamond carries was computed before the IF.
(defn pinned? [(opcode i32)] (-> bool)
  (or (= opcode 67) (= opcode 71) (= opcode 79) (= opcode 85) (= opcode 91)))

;;; Nodes the cone may hold; a walk that would exceed it stops adding.
(def CONE (: 24 i64))

;;; Values the IF's condition is computed from, the condition included: its
;;; floating inputs, transitively, and the address of a LOAD among them, which
;;; is computed before that read and so before the IF. Each of these exists on
;;; both paths already, so selecting one speculates nothing.
(defn cone! [(graph g/Graph) (condition i32) (cone (mut (ArrayList i32)))] (-> void)
  (clear! (mut cone))
  (when (inside? graph condition) (push! (mut cone) condition))
  (let [(mut next) (: 0 i64)
        size (cast i32 (len (.instructions graph)))]
    (while (and (< next (len cone)) (< (len cone) CONE))
      (let [reference (get cone next)
            node (get (.instructions graph) (cast i64 reference))
            opcode (cast i32 (n/opcode node))
            count (cast i32 (get (.arities graph) (cast i64 reference)))
            facts (get (op/metadata) (cast i64 opcode))]
        (cond (and (>= opcode 14) (<= opcode 64))
                (for [i 1 (+ (cast i64 count) 1)]
                  (when (uses/edge-code? (op/operand-code-word facts (cast i32 i)))
                    (let [value (diamond/input graph reference (cast i32 i))]
                      (when (and (> value 0) (< value size) (< (len cone) CONE)
                                 (not (convert/has? cone value)))
                        (push! (mut cone) value)))))
              (= opcode 91)
                (let [address (.op2 node)]
                  (when (and (> address 0) (< address size) (not (convert/has? cone address)))
                    (push! (mut cone) address)))
              :else 0))
      (set! next (+ next 1)))))

;;; The price of making a scalar floating operation unconditional, zero when
;;; it may not be: IEEE operations raise no trap in the default environment
;;; and read nothing, so the ones that are one short instruction are total.
;;; Add, subtract, negate, absolute value, the IEEE extrema and the roundings
;;; cost one unit; a multiply and a fused multiply-add three, as an integer
;;; MUL. Division and square root stay where they are. Every input is a
;;; floating value of the same type.
(defn floating-cost [(graph g/Graph) (reference i32)] (-> i32)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        ty (n/type-id node)
        price (cond (or (= opcode 26) (= opcode 27) (= opcode 31) (= opcode 32)) (: 1 i32)
                    (and (>= opcode 133) (<= opcode 141)) 1
                    (or (= opcode 28) (= opcode 132)) 3
                    :else 0)
        (mut safe) (and (> price 0) (types/floating? (cast i32 ty)))]
    (when safe
      (for [i 1 (+ (cast i64 (get (.arities graph) (cast i64 reference))) 1)]
        (match (g/lookup graph (diamond/input graph reference (cast i32 i)))
          (None [] (set! safe false))
          (Some [value] (unless (= (n/type-id value) ty) (set! safe false))))))
    (if safe price 0)))

;;; Whether `reference` may be a COND arm of type `ty`, charging `budget` for
;;; each floating operation it would make unconditional. Literals, pinned
;;; values and the condition's own `cone` are free. Any other floating
;;; operation is one of stogir.if-convert's total integer operations or a
;;; total floating one (floating-cost) over affordable inputs; `speculated` holds those already charged for this
;;; diamond.
(defn affordable? [(graph g/Graph) (reference i32) (ty u8) (top bool) (cone (ArrayList i32))
                   (speculated (mut (ArrayList i32))) (budget (mut i32))] (-> bool)
  (if (< reference 0)
      (match (g/lookup graph reference)
        (None [] false)
        (Some [value] (or (not top) (= (n/type-id value) ty))))
      (if (not (inside? graph reference))
          false
          (let [node (get (.instructions graph) (cast i64 reference))
                opcode (cast i32 (n/opcode node))]
            (cond (and top (!= (n/type-id node) ty)) false
                  (pinned? opcode) true
                  (convert/has? cone reference) true
                  (convert/has? speculated reference) true
                  :else
                    (let [integer-price (convert/cost graph reference)
                          price (if (> integer-price 0)
                                    integer-price
                                    (floating-cost graph reference))
                          (mut valid) (and (> price 0) (<= price budget))]
                      (when valid
                        (set! budget (- budget price))
                        (push! (mut speculated) reference)
                        (for [i 1 (+ (cast i64 (get (.arities graph) (cast i64 reference))) 1)]
                          (when valid
                            (unless (affordable? graph (diamond/input graph reference (cast i32 i))
                                                 ty false cone (mut speculated) (mut budget))
                              (set! valid false)))))
                      valid))))))

;;; Count a reference to a node that a conversion would delete: 2 is such a
;;; node unreferenced, 3 referenced once, 4 more often.
;;; A SWITCH that would become an END counts its references from 16 up.
(defn note! [(role (mut (ArrayList u8))) (value i32)] (-> void)
  (when (and (> value 0) (< (cast i64 value) (len role)))
    (let [seen (get role (cast i64 value))]
      (when (or (= seen 2) (= seen 3) (and (>= seen 16) (< seen 255)))
        (set! (mut role) (cast i64 value) (+ seen 1))))))

(defn find [(graph g/Graph) (a (dyn Allocator))] (-> (ArrayList Shape))
  (let [(mut shapes) (ArrayList::new [Shape] a)
        size (len (.instructions graph))
        (mut r) (: 1 i64)]
    (while (< r size)
      (let [count (cast i64 (get (.arities graph) r))]
        (when (and (= count 2) (= (n/opcode (get (.instructions graph) r)) 112))
          (let [found (shape graph (cast i32 r))]
            (if (.valid found)
                (push! (mut shapes) found)
                (let [dispatch (dispatch-shape graph (cast i32 r))]
                  (when (.valid dispatch) (push! (mut shapes) dispatch))))))
        (set! r (+ r (if (< count 0) 1 (/ (+ count 4) 4))))))
    shapes))

;;; Read the PHIs of every shape and the references to its doomed nodes.
;;; `slot` maps a MERGE to one more than its index in `shapes`.
(defn qualify! [(graph g/Graph) (shapes (mut (ArrayList Shape))) (a (dyn Allocator))] (-> void)
  (let [size (len (.instructions graph))
        (mut role) (ArrayList::new [u8] a)
        (mut slot) (ArrayList::new [i32] a)
        (mut budgets) (ArrayList::new [i32] a)
        (mut speculated) (ArrayList::new [i32] a)
        (mut cone) (ArrayList::new [i32] a)
        (mut broken) false
        (mut r) (: 1 i64)]
    (extend-zeroed! (mut role) size)
    (extend-zeroed! (mut slot) size)
    (for [i 0 (len shapes)]
      (let [found (get shapes i)
            doomed [(.end1 found) (.end2 found) (.arm1 found) (.arm2 found)]]
        (set! (mut slot) (cast i64 (.merge found)) (cast i32 (+ i 1)))
        (push! (mut budgets) BUDGET)
        (for reference doomed
          (set! (mut role) (cast i64 reference) 2))
        (when (!= (.table found) 0)
          (set! (mut role) (cast i64 (.branch found)) 16)
          (for [k (: 1 i32) (+ (cast i32 (get (.arities graph) (cast i64 (.table found)))) 1)]
            (let [end (diamond/input graph (.table found) k)]
              (set! (mut role) (cast i64 end) 2)
              (set! (mut role) (cast i64 (diamond/input graph end 1)) 2))))))
    (while (< r size)
      (let [node (get (.instructions graph) r)
            count (get (.arities graph) r)
            opcode (cast i32 (n/opcode node))
            facts (get (op/metadata) (cast i64 (if (op/valid? opcode) opcode 0)))]
        ; An unverified graph may claim operands beyond its last cell.
        (when (or (not (op/valid? opcode))
                  (> (+ r (/ (+ (cast i64 count) 4) 4)) size))
          (set! broken true)
          (set! r size))
        (when (not broken)
          (qualify-node! graph (mut shapes) (mut role) slot (mut budgets) (mut speculated)
                         (mut cone) r node count opcode facts))
        (set! r (+ r (if (< count 0) 1 (/ (+ (cast i64 count) 4) 4))))))
    (for [i 0 (len shapes)]
      (let [found (elem (mut shapes) i)]
        (when (or broken
                  (= (.phis found) 0)
                  (!= (get role (cast i64 (.end1 found))) 3)
                  (!= (get role (cast i64 (.end2 found))) 3)
                  (!= (get role (cast i64 (.arm1 found))) 3)
                  (!= (get role (cast i64 (.arm2 found))) 3))
          (set! (.valid found) false))
        ; Every case END and projection is read once, and the SWITCH by its
        ; projections only.
        (when (and (.valid found) (!= (.table found) 0))
          (let [cases (cast i32 (get (.arities graph) (cast i64 (.table found))))]
            (when (!= (cast i32 (get role (cast i64 (.branch found)))) (+ 17 cases))
              (set! (.valid found) false))
            (for [k (: 1 i32) (+ cases 1)]
              (let [end (diamond/input graph (.table found) k)]
                (when (or (!= (get role (cast i64 end)) 3)
                          (!= (get role (cast i64 (diamond/input graph end 1))) 3))
                  (set! (.valid found) false))))))))
    (free! (mut role))
    (free! (mut slot))
    (free! (mut budgets))
    (free! (mut cone))
    (free! (mut speculated))))

;;; One node of qualify!'s walk: count its references to doomed nodes and,
;;; when it is a PHI of a shape's MERGE, price it.
(defn qualify-node! [(graph g/Graph) (shapes (mut (ArrayList Shape))) (role (mut (ArrayList u8)))
                 (slot (ArrayList i32)) (budgets (mut (ArrayList i32)))
                 (speculated (mut (ArrayList i32))) (cone (mut (ArrayList i32)))
                 (r i64) (node n/Node) (count i32) (opcode i32) (facts u32)] (-> void)
  (do
    (when (and (>= count 1) (uses/edge-code? (op/operand-code-word facts 1)))
      (note! (mut role) (.op1 node)))
    (when (and (>= count 2) (uses/edge-code? (op/operand-code-word facts 2)))
      (note! (mut role) (.op2 node)))
    (when (and (>= count 3) (uses/edge-code? (op/operand-code-word facts 3)))
      (note! (mut role) (.op3 node)))
    (let [(mut i) (: 4 i32)]
      (while (<= i count)
        (when (uses/edge-code? (op/operand-code-word facts i))
          (note! (mut role) (uses/verified-input graph r i)))
        (set! i (+ i 1))))
    (when (and (= opcode 67) (inside? graph (.op1 node))
               (!= (get slot (cast i64 (.op1 node))) 0))
      (let [index (cast i64 (- (get slot (cast i64 (.op1 node))) 1))
            found (elem (mut shapes) index)
            ty (n/type-id node)
            (mut budget) (get budgets index)]
        ; The speculated set is per diamond; its PHIs are adjacent only by
        ; chance, so each PHI starts a fresh set and shares the budget.
        (clear! (mut speculated))
        (when (.valid found)
          (cone! graph (diamond/input graph (.branch found) 2) (mut cone)))
        (if (and (.valid found) (= count 3) (< (.phis found) MAX-PHIS)
                 (or (types/integer? (cast i32 ty))
                     (and (types/floating? (cast i32 ty)) (= (.table found) 0)))
                 (affordable? graph (.op2 node) ty true cone (mut speculated) (mut budget))
                 (affordable? graph (.op3 node) ty true cone (mut speculated) (mut budget)))
            (do
              (cond (= (.phis found) 0) (set! (.phi1 found) (cast i32 r))
                    (= (.phis found) 1) (set! (.phi2 found) (cast i32 r))
                    (= (.phis found) 2) (set! (.phi3 found) (cast i32 r))
                    :else (set! (.phi4 found) (cast i32 r)))
              (set! (.phis found) (+ (.phis found) 1))
              (set! (mut budgets) index budget))
            (set! (.valid found) false))))))

;;; After conversion: the second and later CONDs of `found` read a copy of
;;; the condition when it is an integer comparison of two operands.
(defn own-comparisons! [(graph (mut g/Graph)) (found Shape)] (-> void)
  (let [first (get (.instructions graph) (cast i64 (.phi1 found)))
        condition (.op1 first)
        extra [(.phi2 found) (.phi3 found) (.phi4 found)]]
    (when (and (> condition 0) (>= (.phis found) 2)
               (>= (code graph condition) 14) (<= (code graph condition) 23)
               (= (get (.arities graph) (cast i64 condition)) 2))
      (for [i 0 (- (.phis found) 1)]
        (let [node (get (.instructions graph) (cast i64 condition))]
          (match (g/append-inputs! (mut graph) (n/opcode node) (n/type-id node)
                                   [(.op1 node) (.op2 node)])
            (None [] (panic "select-diamond: comparison copy failed"))
            (Some [copy]
              (unless (g/set-operand! (mut graph) (get extra i) 1 copy)
                (panic "select-diamond: COND condition update failed")))))))))

;;; A new node, or a panic: the owned copy has room for a few appended cells.
(defn node! [(graph (mut g/Graph)) (opcode u8) (ty u8) (inputs (slice i32))] (-> i32)
  (match (g/append-inputs! (mut graph) opcode ty inputs)
    (None [] (panic "select-diamond: graph references exhausted"))
    (Some [created] created)))

(defn literal! [(graph (mut g/Graph)) (ty u8) (bits u64)] (-> i32)
  (match (g/intern-constant! (mut graph) ty ty 0 bits)
    (None [] (panic "select-diamond: constant references exhausted"))
    (Some [created] created)))

;;; Convert a qualified SWITCH shape (see the module comment).
(defn apply-dispatch! [(graph (mut g/Graph)) (roots (mut (ArrayList i32))) (found Shape)] (-> void)
  (let [branch (.branch found)
        selector (diamond/input graph branch 2)
        previous (diamond/input graph branch 1)
        ty (n/type-id (match (g/lookup graph selector)
                        (None [] (panic "select-diamond: SWITCH selector missing"))
                        (Some [node] node)))
        bytes (types/scalar-size (cast i32 ty) 8)
        width-mask (if (= bytes 8) (: 0xFFFFFFFFFFFFFFFF u64)
                       (- (<< (: 1 u64) (cast u64 (* 8 bytes))) 1))
        ; Keys are biased by the sign bit; the constant is not.
        low (& (^ (.low found) (switch/sign-mask (cast i32 ty))) width-mask)
        offset (if (= low 0) selector
                   (node! (mut graph) 27 ty [selector (literal! (mut graph) ty low)]))
        index (cond (= ty 5) offset
                    (= bytes 8) (node! (mut graph) 36 5 [offset])
                    :else (node! (mut graph) 34 5 [offset]))
        shifted (node! (mut graph) 50 5 [(literal! (mut graph) 5 (.mask found)) index])
        span (literal! (mut graph) 5 (.span found))
        one (literal! (mut graph) 5 1)
        zero (literal! (mut graph) 5 0)
        cases (cast i32 (get (.arities graph) (cast i64 (.table found))))
        phis [(.phi1 found) (.phi2 found) (.phi3 found) (.phi4 found)]
        (mut dead) (ArrayList::new [i32] (.alc roots))]
    (push! (mut dead) (.end1 found))
    (push! (mut dead) (.end2 found))
    (push! (mut dead) (.arm2 found))
    (for [k (: 1 i32) (+ cases 1)]
      (let [end (diamond/input graph (.table found) k)]
        (push! (mut dead) end)
        (push! (mut dead) (diamond/input graph end 1))))
    (push! (mut dead) (.table found))
    (for [i 0 (.phis found)]
      (let [phi (get phis i)
            node (get (.instructions graph) (cast i64 phi))
            matched (if (.match-first found) (.op2 node) (.op3 node))
            default (if (.match-first found) (.op3 node) (.op2 node))
            ; Each select reads comparisons of its own (see own-comparisons!).
            outside (node! (mut graph) 23 1 [index span])
            bit (node! (mut graph) 47 5 [shifted one])
            member (node! (mut graph) 15 1 [bit zero])
            inner (node! (mut graph) 60 (n/type-id node) [member matched default])]
        (convert/replace! (mut graph) phi 60 (n/type-id node) [outside default inner])))
    (convert/replace! (mut graph) branch 114 0 [previous])
    (convert/replace! (mut graph) (.merge found) 106 0 [branch (: 0 i32)])
    (for reference dead
      (convert/replace! (mut graph) reference 0 0 [])
      (for [i 0 (len roots)]
        (when (= (get roots i) reference) (set! (mut roots) i branch))))
    (free! (mut dead))))

;;; The converted copy (None when no diamond qualified) and its roots.
(defn run [(source g/Graph) (roots (slice i32)) (a (dyn Allocator))]
  (-> (Result convert/Converted (slice u8)))
  (let [(mut shapes) (find source a)
        (mut exits) (ArrayList::new [i32] a)
        (mut working) (None [g/Graph])
        (mut changes) (: 0 i64)]
    (for root roots (push! (mut exits) root))
    (when (> (len shapes) 0)
      (qualify! source (mut shapes) a)
      (for [i 0 (len shapes)]
        (let [found (get shapes i)]
          (when (.valid found)
            (let [(mut owned) (match working
                                (Some [graph] graph)
                                (None [] (g/duplicate source a)))
                  (mut phis) (ArrayList::new [i32] a)]
              (push! (mut phis) (.phi1 found))
              (when (>= (.phis found) 2) (push! (mut phis) (.phi2 found)))
              (when (>= (.phis found) 3) (push! (mut phis) (.phi3 found)))
              (when (>= (.phis found) 4) (push! (mut phis) (.phi4 found)))
              (if (!= (.table found) 0)
                  (apply-dispatch! (mut owned) (mut exits) found)
                  (do
                    (convert/apply! (mut owned) (mut exits)
                                    (convert/Plan :shape (diamond/collapse-plan source (.merge found)
                                                                                (.phi1 found))
                                                  :phis phis))
                    ; The matcher folds a comparison into the one select that reads
                    ; it; a second reader would make it a Boolean that each select
                    ; tests again. Every further select gets its own comparison.
                    (own-comparisons! (mut owned) found)))
              (free! (mut phis))
              (set! changes (+ changes 1))
              (set! working (Some owned)))))))
    (free! (mut shapes))
    (Ok (convert/Converted :graph working :roots exits :diamonds changes))))

;;; The result of converting nothing.
(defn none [(roots (slice i32)) (a (dyn Allocator))] (-> (Result convert/Converted (slice u8)))
  (let [(mut exits) (ArrayList::new [i32] a)]
    (for root roots (push! (mut exits) root))
    (Ok (convert/Converted :graph (None [g/Graph]) :roots exits :diamonds 0))))
