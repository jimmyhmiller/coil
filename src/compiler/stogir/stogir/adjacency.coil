;;; Packed CFG adjacency; entries are indices into cfg.Blocks.edges.
(module stogir.adjacency)
(import "stogir.cfg" :as cfg)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])

(defstruct Range [(offset i64) (count i64)])

(defstruct Index [(ranges (ArrayList Range)) (edges (ArrayList i64))])

;;; incoming=true indexes predecessors, false indexes successors. The original
;;; edge identity and destination position remain intact, including parallel edges.
(defn build [(blocks cfg/Blocks) (incoming bool) (allocator (dyn Allocator))]
  (-> Index)
  (let [(mut result)
          (Index
            :ranges (ArrayList::new [Range] allocator)
            :edges (ArrayList::new [i64] allocator))
        (mut cursors) (ArrayList::new [i64] allocator)
        (mut i) 0]
    (while (< i (len (.membership blocks)))
      (push! (mut (.ranges result)) (Range :offset 0 :count 0))
      (push! (mut cursors) 0)
      (set! i (+ i 1)))
    (for edge (.edges blocks)
      (let [node (cast i64 (if incoming (.to edge) (.from edge)))
            (mut range) (get (.ranges result) node)]
        (set! (.count range) (+ (.count range) 1))
        (set! (mut (.ranges result)) node range)))
    (let [(mut offset) 0]
      (set! i 0)
      (while (< i (len (.ranges result)))
        (let [(mut range) (get (.ranges result) i)]
          (set! (.offset range) offset)
          (set! (mut (.ranges result)) i range)
          (set! (mut cursors) i offset)
          (set! offset (+ offset (.count range))))
        (set! i (+ i 1))))
    (set! i 0)
    (while (< i (len (.edges blocks)))
      (push! (mut (.edges result)) 0)
      (set! i (+ i 1)))
    (set! i 0)
    (while (< i (len (.edges blocks)))
      (let [edge (get (.edges blocks) i)
            node (cast i64 (if incoming (.to edge) (.from edge)))
            slot (get cursors node)]
        (set! (mut (.edges result)) slot i)
        (set! (mut cursors) node (+ slot 1)))
      (set! i (+ i 1)))
    (free! (mut cursors))
    result))

(defn release! [(index (mut Index))] (-> void)
  (free! (mut (.ranges index)))
  (free! (mut (.edges index))))

;;; Forward reachability from a validated block-start reference.
(defn reachable [(blocks cfg/Blocks)
                 (successors Index)
                 (entry i32)
                 (allocator (dyn Allocator))] (-> (ArrayList bool))
  (let [(mut seen) (ArrayList::new [bool] allocator)
        (mut work) (ArrayList::new [i32] allocator)
        (mut i) 0]
    (while (< i (len (.membership blocks)))
      (push! (mut seen) false)
      (set! i (+ i 1)))
    (set! (mut seen) (cast i64 entry) true)
    (push! (mut work) entry)
    (set! i 0)
    (while (< i (len work))
      (let [node (get work i)
            range (get (.ranges successors) (cast i64 node))
            (mut j) 0]
        (while (< j (.count range))
          (let [edge-index (get (.edges successors) (+ (.offset range) j))
                edge (get (.edges blocks) edge-index)
                target (.to edge)]
            (when (not (get seen (cast i64 target)))
              (set! (mut seen) (cast i64 target) true)
              (push! (mut work) target)))
          (set! j (+ j 1))))
      (set! i (+ i 1)))
    (free! (mut work))
    seen))

(defstruct Frame [(block i32) (next-edge i64)])

;;; Reachable blocks in reverse DFS postorder; successors retain CFG edge order.
(defn reverse-postorder [(blocks cfg/Blocks)
                         (successors Index)
                         (entry i32)
                         (allocator (dyn Allocator))] (-> (ArrayList i32))
  (let [(mut seen) (ArrayList::new [bool] allocator)
        (mut stack) (ArrayList::new [Frame] allocator)
        (mut postorder) (ArrayList::new [i32] allocator)
        (mut order) (ArrayList::new [i32] allocator)
        (mut i) 0]
    (while (< i (len (.membership blocks)))
      (push! (mut seen) false)
      (set! i (+ i 1)))
    (push! (mut stack) (Frame :block entry :next-edge 0))
    (set! (mut seen) (cast i64 entry) true)
    (while (> (len stack) 0)
      (let [top (- (len stack) 1)
            (mut frame) (get stack top)
            range (get (.ranges successors) (cast i64 (.block frame)))]
        (if (>= (.next-edge frame) (.count range))
            (do
              (push! (mut postorder) (.block frame))
              (pop! (mut stack)))
            (let [edge-index
                    (get (.edges successors)
                         (+ (.offset range) (.next-edge frame)))
                  edge (get (.edges blocks) edge-index)
                  target (.to edge)]
              (set! (.next-edge frame) (+ (.next-edge frame) 1))
              (set! (mut stack) top frame)
              (when (not (get seen (cast i64 target)))
                (set! (mut seen) (cast i64 target) true)
                (push! (mut stack) (Frame :block target :next-edge 0)))))))
    (set! i (len postorder))
    (while (> i 0)
      (set! i (- i 1))
      (push! (mut order) (get postorder i)))
    (free! (mut seen))
    (free! (mut stack))
    (free! (mut postorder))
    order))
