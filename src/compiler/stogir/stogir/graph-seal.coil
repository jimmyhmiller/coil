;;; A fingerprint of everything a graph owns, for checking the contract of the
;;; compile entry points: a compile call only reads its graph.
;;;
;;; `seal` covers every container of the graph (instruction cells, arities,
;;; constants and their spans, both interning tables, the string pool) by
;;; address, length, capacity and raw contents, and the function prototype.
;;; Two seals of one graph are equal exactly when nothing in between wrote to
;;; the graph, appended to it, interned into it or reallocated its storage.
;;; Unlike sccp-rewrite/content-hash it is not a statement about the graph's
;;; meaning and is not stable across copies.
;;;
;;; It does not see scratch memory taken from the graph's allocator and
;;; released again; that is ruled out by never reading a graph container's
;;; `alc` in code a compile call reaches (docs/ARCHITECTURE.md).
(module stogir.graph-seal)
(import "stogir.graph" :as g)
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap Entry])
(import "coil.primitive" :as p)

(defn mix [(h u64) (w u64)] (-> u64)
  (let [x (p/imul (^ h w) (: 0x9E3779B97F4A7C15 u64))]
    (^ x (>> x 29))))

;;; Mix the bytes [first, last).
(defn bytes [(h u64) (first (ptr u8)) (last (ptr u8))] (-> u64)
  (let [count (- (p/cast i64 last) (p/cast i64 first))
        (mut result) (mix h (cast u64 count))]
    (for [i 0 count]
      (set! result (mix result (cast u64 (load (p/index first i))))))
    result))

(defn list [T] [(h u64) (xs (ArrayList T))] (-> u64)
  (let [header (mix (mix (mix h (cast u64 (p/cast i64 (.data xs)))) (cast u64 (.len xs)))
                    (cast u64 (.cap xs)))]
    (if (= (.len xs) 0)
        header
        (bytes header (p/cast (ptr u8) (.data xs))
               (p/cast (ptr u8) (p/index (.data xs) (.len xs)))))))

(defn table [K V] [(h u64) (map (HashMap K V))] (-> u64)
  (let [header (mix (mix (mix (mix h (cast u64 (p/cast i64 (.slots map))))
                              (cast u64 (.cap map)))
                         (cast u64 (.len map)))
                    (cast u64 (.tombs map)))]
    (if (= (.cap map) 0)
        header
        (bytes header (p/cast (ptr u8) (.slots map))
               (p/cast (ptr u8) (p/index (.slots map) (.cap map)))))))

(defn seal [(graph g/Graph)] (-> u64)
  (let [(mut h) (: 0x5EA1 u64)]
    (set! h (list h (.instructions graph)))
    (set! h (list h (.constants graph)))
    (set! h (list h (.constant-spans graph)))
    (set! h (list h (.arities graph)))
    (set! h (table h (.constant-heads graph)))
    (set! h (table h (.expressions graph)))
    (set! h (list h (.bytes (.strings graph))))
    (set! h (list h (.entries (.strings graph))))
    (set! h (table h (.heads (.strings graph))))
    (mix h (cast u64 (cast i64 (.function-prototype graph))))))
