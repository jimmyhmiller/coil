;;; Entry-block fixed stack objects follow IR_STATIC_ALLOCA in pinned
;;; ir_aarch64.dasc. Raw-SP operations remain distinct. See NOTICE.
(module stogir.a64.static-stack)
(import "stogir.fill" :as fill)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.stack" :as stack)
(import "stogir.schedule" :as schedule)
(import "stogir.frame" :as frame)
(import "stogir.locations" :as locations)
(import "stogir.a64.frame-address" :as address)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Some None Ok Err])

;;; Requires validated graph and schedule. Select only explicitly declared
;;; function-lifetime objects. Ordinary raw ALLOCA retains its SP semantics.
;;; A nonempty result is indexed by graph ref; zero means dynamic.
(defn select [(graph g/Graph) (scheduled schedule/Schedule) (a (dyn Allocator))]
  (-> (ArrayList i64))
  (let [(mut sizes) (ArrayList::new [i64] a)]
    (for reference (.nodes scheduled)
      (let [node (get (.instructions graph) (cast i64 reference))]
        (when (stack/frame-object? node)
          (match (stack/constant-size graph (.op2 node))
            (Err [_] 0)
            (Ok [size]
                (when (> size 0)
                  (when (= (len sizes) 0)
                    (reserve! (mut sizes) (len (.instructions graph)))
                    (fill/append! (mut sizes) (len (.instructions graph)) 0))
                  (set! (mut sizes) (cast i64 reference) size)))))))
    sizes))

(defn size [(sizes (ArrayList i64)) (reference i32)] (-> i64)
  (if (and (> reference 0) (< (cast i64 reference) (len sizes)))
      (get sizes (cast i64 reference))
      0))

;;; Fixed addresses are immutable read-only sources, indexed in reference order.
;;; They have no virtual allocation bucket and never denote spill contents.
(defn index! [(index (mut locations/Index)) (frame frame/Frame)
               (sizes (ArrayList i64)) (base address/Base)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) "" (mut count) (: 0 i32)]
    (for [r 1 (len sizes)]
      (when (and (= error "") (> (get sizes r) 0))
        (if (or (>= r (len (.parents index)))
                (!= (.count (get (.parents index) r)) 0))
            (set! error "static frame address still has a virtual allocation")
            (match (get (.locals frame) (cast i32 r))
              (None [] (set! error "static allocation has no frame object"))
              (Some [slot]
                    (match (address/offset base (.offset (get (.slots frame) slot)))
                      (Err [message] (set! error message))
                      (Ok [offset]
                          (push! (mut (.rematerialized index))
                                 (locations/Rematerialized
                                   :parent (cast i32 r)
                                   :location (locations/Location :kind (if (= (.reg base) 29) 2 3)
                                                                 :value offset)))
                          (set! count (+ count 1)))))))))
    (if (= error "") (Ok count) (Err error))))
