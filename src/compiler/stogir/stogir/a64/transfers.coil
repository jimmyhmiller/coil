;;; Physical GPR/SIMD location transfers relative to the spill-area SP base.
(module stogir.a64.transfers)
(import "stogir.locations" :as loc)
(import "stogir.a64.encode" :as e)
(import "stogir.a64.frame-address" :as frame)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.frame-memory" :as memory)
(import "coil.hashmap" :use [HashMap])
(import "stogir.bytes" :as bytes)
(import "stogir.moves" :as moves)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn valid? [(location loc/Location)] (-> bool)
  (if (= (.kind location) 0)
      (and (>= (.value location) 0)
           (< (.value location) 64)
           (!= (.value location) 31))
      (and (or (= (.kind location) 1) (loc/rematerialized? location))
           (>= (.value location) 0))))

;;; A complete 128-bit value may inhabit only a SIMD register or stack slot.
(defn width-location? [(location loc/Location) (size i32)] (-> bool)
  (and (valid? location)
       (or (not (loc/rematerialized? location)) (= size 8))
       (or (!= size 16)
           (= (.kind location) 1)
           (registers/simd? (cast i32 (.value location))))))

;;; Memory-to-memory data scratch must hold the whole value. Address scratch
;;; ownership is separate, so large Q-register accesses never truncate payloads.
(defn data-scratch? [(size i32) (scratch i32)] (-> bool)
  (if (= size 16)
      (registers/simd? scratch)
      (and (>= scratch 0) (< scratch 31))))

;;; Scratch must be reserved/dead for this transfer. All encodings are checked
;;; before appending, so a failed transfer never partially mutates output.
(defn emit-at-ordinary! [(output (mut (ArrayList u8)))
                (source loc/Location)
                (destination loc/Location)
                (size i32)
                (scratch i32)
                (base frame/Base)]
  (-> (Result i32 (slice u8)))
  (let [(mut source) source
        (mut destination) destination
        (mut error) ""]
    (when (or (loc/rematerialized? source) (loc/rematerialized? destination)
              (not (frame/valid-base? base))
              (= scratch (.reg base))
              (and (= (.reg base) 29)
                   (= (.kind destination) 0)
                   (= (.value destination) 29)))
      (set! error "invalid transfer frame base or anchor clobber"))
    (when (= (.kind source) 1)
      (match (frame/offset base (.value source))
        (Err [message] (set! error message))
        (Ok [offset] (set! (.value source) offset))))
    (when (= (.kind destination) 1)
      (match (frame/offset base (.value destination))
        (Err [message] (set! error message))
        (Ok [offset] (set! (.value destination) offset))))
    (if (!= error "")
        (Err error)
        (if (or (not (width-location? source size))
                (not (width-location? destination size))
                (not (or (= size 4) (= size 8) (= size 16)))
                (not (data-scratch? size scratch)))
            (Err "invalid physical transfer")
            (if (loc/same? source destination)
                (Ok 0)
                (if (= (.kind source) 0)
                    (let [src (cast i32 (.value source))
                          dst (cast i32 (.value destination))
                          instruction
                            (if (= (.kind destination) 0)
                                (if (registers/simd? src)
                                    (if (registers/simd? dst)
                                        (e/simd-move size
                                                     (registers/physical dst)
                                                     (registers/physical src))
                                        (e/scalar-transfer (= size 8)
                                                           false
                                                           dst
                                                           (registers/physical src)))
                                    (if (registers/simd? dst)
                                        (e/scalar-transfer (= size 8)
                                                           true
                                                           (registers/physical dst)
                                                           src)
                                        (e/logical-register (= size 8)
                                                            1
                                                            dst
                                                            31
                                                            src)))
                                (if (registers/simd? src)
                                    (e/floating-load-store false
                                                           size
                                                           (registers/physical src)
                                                           (.reg base)
                                                           (.value destination))
                                    (e/load-store false
                                                  size
                                                  (cast i32 (.value source))
                                                  (.reg base)
                                                  (.value destination))))]
                      (match instruction
                        (Err [msg] (Err msg))
                        (Ok [word]
                            (do (bytes/append32! (mut output) word) (Ok 4)))))
                    (if (= (.kind destination) 0)
                        (match (if (registers/simd? (cast i32
                                                          (.value destination)))
                                   (e/floating-load-store true
                                                          size
                                                          (registers/physical (cast i32
                                                                                    (.value destination)))
                                                          (.reg base)
                                                          (.value source))
                                   (e/load-store true
                                                 size
                                                 (cast i32 (.value destination))
                                                 (.reg base)
                                                 (.value source)))
                          (Err [msg] (Err msg))
                          (Ok [word]
                              (do (bytes/append32! (mut output) word) (Ok 4))))
                        (match (if (= size 16)
                                   (e/floating-load-store true
                                                          size
                                                          (registers/physical scratch)
                                                          (.reg base)
                                                          (.value source))
                                   (e/load-store true
                                                 size
                                                 scratch
                                                 (.reg base)
                                                 (.value source)))
                          (Err [msg] (Err msg))
                          (Ok [load-word]
                              (match (if (= size 16)
                                         (e/floating-load-store false
                                                                size
                                                                (registers/physical scratch)
                                                                (.reg base)
                                                                (.value destination))
                                         (e/load-store false
                                                       size
                                                       scratch
                                                       (.reg base)
                                                       (.value destination)))
                                (Err [msg] (Err msg))
                                (Ok [store-word]
                                    (do
                                      (bytes/append32! (mut output) load-word)
                                      (bytes/append32! (mut output) store-word)
                                      (Ok 8)))))))))))))

(defn emit! [(output (mut (ArrayList u8)))
             (source loc/Location)
             (destination loc/Location)
             (size i32)
             (scratch i32)]
  (-> (Result i32 (slice u8)))
  (emit-at! (mut output) source destination size scratch (frame/stack-base)))

;;; Distinct caller-owned data/address scratches allow large memory copies. Keep
;;; the immediate form allocation-free; temporary bytes make fallback errors atomic.
(defn emit-addressed-ordinary! [(output (mut (ArrayList u8)))
                       (source loc/Location)
                       (destination loc/Location)
                       (size i32)
                       (scratch i32)
                       (base frame/Base)
                       (address-scratch i32)]
  (-> (Result i32 (slice u8)))
  (if (or (loc/rematerialized? source) (loc/rematerialized? destination)
          (< address-scratch 0)
          (> address-scratch 30)
          (= address-scratch scratch)
          (= address-scratch (.reg base))
          (not (width-location? source size))
          (not (width-location? destination size))
          (not (or (= size 4) (= size 8) (= size 16)))
          (not (data-scratch? size scratch))
          (= scratch (.reg base))
          (not (frame/valid-base? base))
          (and (= (.reg base) 29)
               (= (.kind destination) 0)
               (= (.value destination) 29)))
      (Err "invalid addressed transfer or scratch ownership")
      (match (emit-at! (mut output) source destination size scratch base)
        (Ok [count] (Ok count))
        (Err [_]
             (let [(mut temporary) (ArrayList::new [u8] (.alc output))
                   (mut error) ""
                   (mut source-offset) (: 0 i64)
                   (mut destination-offset) (: 0 i64)]
               (when (= (.kind source) 1)
                 (match (frame/offset base (.value source))
                   (Err [message] (set! error message))
                   (Ok [offset] (set! source-offset offset))))
               (when (= (.kind destination) 1)
                 (match (frame/offset base (.value destination))
                   (Err [message] (set! error message))
                   (Ok [offset] (set! destination-offset offset))))
               (when (= error "")
                 (if (= (.kind source) 0)
                     (match (memory/access! (mut temporary)
                                            false
                                            size
                                            (cast i32 (.value source))
                                            (.reg base)
                                            destination-offset
                                            false
                                            (if (= (.value source)
                                                   (cast i64 address-scratch))
                                                scratch
                                                address-scratch))
                       (Err [message] (set! error message))
                       (Ok [_] 0))
                     (if (= (.kind destination) 0)
                         (match (memory/access! (mut temporary)
                                                true
                                                size
                                                (cast i32 (.value destination))
                                                (.reg base)
                                                source-offset
                                                false
                                                address-scratch)
                           (Err [message] (set! error message))
                           (Ok [_] 0))
                         (do
                           (match (memory/access! (mut temporary)
                                                  true
                                                  size
                                                  scratch
                                                  (.reg base)
                                                  source-offset
                                                  false
                                                  address-scratch)
                             (Err [message] (set! error message))
                             (Ok [_] 0))
                           (when (= error "")
                             (match (memory/access! (mut temporary)
                                                    false
                                                    size
                                                    scratch
                                                    (.reg base)
                                                    destination-offset
                                                    false
                                                    address-scratch)
                               (Err [message] (set! error message))
                               (Ok [_] 0)))))))
               (let [count (cast i32 (len temporary))]
                 (when (= error "")
                   (for byte temporary (push! (mut output) byte)))
                 (free! (mut temporary))
                 (if (= error "") (Ok count) (Err error))))))))

(defn emit-rematerialized! [(output (mut (ArrayList u8)))
                            (source loc/Location) (destination loc/Location)
                            (size i32) (scratch i32) (base frame/Base)
                            (address-scratch i32)] (-> (Result i32 (slice u8)))
  (if (or (not (loc/rematerialized? source))
          (not (width-location? source size))
          (not (width-location? destination size))
          (loc/rematerialized? destination)
          (not (frame/valid-base? base))
          (!= (loc/address-base source) (.reg base))
          (not (data-scratch? size scratch))
          (= scratch (.reg base))
          (and (= (.kind destination) 0) (= (.value destination) (cast i64 (.reg base)))))
      (Err "invalid rematerialized frame-address transfer")
      (let [(mut temporary) (ArrayList::new [u8] (.alc output))
            (mut error) ""
            direct (and (= (.kind destination) 0) (< (.value destination) 31))
            reg (if direct (cast i32 (.value destination)) scratch)]
        (match (frame/address! (mut temporary) reg (.reg base) (.value source))
          (Err [message] (set! error message)) (Ok [_] 0))
        (when (and (= error "") (not direct))
          (if (= (.kind destination) 0)
              (match (e/scalar-transfer true true (- (cast i32 (.value destination)) 32) reg)
                (Err [message] (set! error message))
                (Ok [word] (bytes/append32! (mut temporary) word)))
              (match (frame/offset base (.value destination))
                (Err [message] (set! error message))
                (Ok [offset]
                    (if (< address-scratch 0)
                        (match (e/load-store false 8 reg (.reg base) offset)
                          (Err [message] (set! error message))
                          (Ok [word] (bytes/append32! (mut temporary) word)))
                        (match (memory/access! (mut temporary) false 8 reg (.reg base)
                                               offset false address-scratch)
                          (Err [message] (set! error message)) (Ok [_] 0)))))))
        (let [count (cast i32 (len temporary))]
          (when (= error "") (for byte temporary (push! (mut output) byte)))
          (free! (mut temporary))
          (if (= error "") (Ok count) (Err error))))))

(defn emit-at! [(output (mut (ArrayList u8))) (source loc/Location)
                (destination loc/Location) (size i32) (scratch i32) (base frame/Base)]
  (-> (Result i32 (slice u8)))
  (if (loc/rematerialized? destination) (Err "frame addresses are read-only")
      (if (loc/rematerialized? source)
          (emit-rematerialized! (mut output) source destination size scratch base -1)
          (emit-at-ordinary! (mut output) source destination size scratch base))))

(defn emit-addressed! [(output (mut (ArrayList u8))) (source loc/Location)
                       (destination loc/Location) (size i32) (scratch i32)
                       (base frame/Base) (address-scratch i32)]
  (-> (Result i32 (slice u8)))
  (if (or (< address-scratch 0) (> address-scratch 30)
          (= address-scratch scratch) (= address-scratch (.reg base))
          (loc/rematerialized? destination))
      (Err "invalid addressed transfer or read-only destination")
      (if (loc/rematerialized? source)
          (emit-rematerialized! (mut output) source destination size scratch base address-scratch)
          (emit-addressed-ordinary! (mut output) source destination size scratch base address-scratch))))

;;; Whether a transfer of at most eight bytes leaves the data scratch alone: a
;;; register source is moved or stored directly, memory is loaded directly
;;; into any register, and an address or constant is built in place only in a
;;; general register.
(defn data-scratch-unused? [(source loc/Location) (destination loc/Location)] (-> bool)
  (cond (= (.kind source) 0) true
        (= (.kind source) 1) (= (.kind destination) 0)
        :else (and (= (.kind destination) 0) (< (.value destination) 31))))

;;; Read-only addresses get identities distinct from writable memory slots.
;;; They are never destinations, so the ordinary cycle solver can order them
;;; without inventing a spill load or losing pre-copy register contents.
(defn identity-id! [(location loc/Location)
                    (identities (mut (ArrayList loc/Location)))
                    (indices (mut (HashMap u128 i32)))] (-> (Result i32 (slice u8)))
  (if (= (.kind location) 0) (Ok (cast i32 (.value location)))
      (match (get indices (loc/identity-key location))
        (Some [id] (Ok id))
        (None []
              (if (>= (len identities) 2147483584)
                  (Err "parallel location identity space exhausted")
                  (let [id (cast i32 (+ 64 (len identities)))]
                    (push! (mut identities) location)
                    (set! (mut indices) (loc/identity-key location) id)
                    (Ok id)))))))

;;; Dense stack IDs keep the copy solver independent of byte-offset magnitude.
(defn location-id! [(location loc/Location)
                    (slots (mut (ArrayList i64)))
                    (indices (mut (HashMap i64 i32)))]
  (-> (Result i32 (slice u8)))
  (if (= (.kind location) 0)
      (Ok (cast i32 (.value location)))
      (match (get indices (.value location))
        (Some [id] (Ok id))
        (None []
              (if (>= (len slots) 2147483584)
                  (Err "parallel stack identity space exhausted")
                  (let [id (cast i32 (+ 64 (len slots)))]
                    (push! (mut slots) (.value location))
                    (set! (mut indices) (.value location) id)
                    (Ok id)))))))

;;; All copies form one simultaneous group and share one raw value width.
;;; Register IDs 0..63 and dense stack identities starting at 64 are disjoint.
;;; Scratch must be reserved and absent from copies. Temporary bytes keep errors atomic.
(defn parallel-impl! [(output (mut (ArrayList u8)))
                      (copies (slice loc/Transfer))
                      (size i32)
                      (scratch i32)
                      (memory-scratch i32)
                      (allocator (dyn Allocator))
                      (base frame/Base)
                      (address-scratch i32)]
  (-> (Result i32 (slice u8)))
  (let [(mut abstract) (ArrayList::new [moves/Move] allocator)
        (mut temporary) (ArrayList::new [u8] allocator)
        (mut slots) (ArrayList::new [loc/Location] allocator)
        (mut indices) (HashMap::new-scalar [u128 i32] allocator)
        (mut error)
          (if (or (not (frame/valid-base? base))
                  (= memory-scratch (.reg base))
                  (= scratch (.reg base))
                  (not (or (= size 4) (= size 8) (= size 16)))
                  (< scratch 0)
                  (> scratch
                     (if (and (< address-scratch 0) (!= size 16)) 30 63))
                  (= scratch 31)
                  (and (= size 16) (not (registers/simd? scratch)))
                  (< address-scratch -1)
                  (> address-scratch 30)
                  (and (>= address-scratch 0)
                       (or (= address-scratch (.reg base))
                           (= address-scratch memory-scratch)
                           (= address-scratch scratch)))
                  (= scratch memory-scratch)
                  (not (data-scratch? size memory-scratch)))
              "invalid parallel scratch registers"
              "")]
    (for copy copies
      (when (and (> (len copies) 0)
                 (!= (.position copy) (.position (get copies 0))))
        (set! error "parallel copies belong to different positions"))
      (let [source (.source copy)
            destination (.destination copy)]
        (if (or (and (= (.kind source) 0)
                     (= (.value source) (cast i64 memory-scratch)))
                (and (= (.kind destination) 0)
                     (= (.value destination) (cast i64 memory-scratch)))
                (and (>= address-scratch 0)
                     (or (and (= (.kind source) 0)
                              (= (.value source) (cast i64 address-scratch)))
                         (and (= (.kind destination) 0)
                              (= (.value destination)
                                 (cast i64 address-scratch)))))
                (not (width-location? source size))
                (not (width-location? destination size))
                (loc/rematerialized? destination))
            (set! error "invalid parallel transfer location")
            (match (identity-id! source (mut slots) (mut indices))
              (Err [message] (set! error message))
              (Ok [src]
                  (match (identity-id! destination (mut slots) (mut indices))
                    (Err [message] (set! error message))
                    (Ok [dst]
                        (push! (mut abstract)
                               (moves/Move :source src :destination dst)))))))))
    (when (= error "")
      (match (moves/resolve (slice abstract) scratch allocator)
        (Err [msg] (set! error msg))
        (Ok [plan]
            (let [(mut owned) plan]
              (for move owned
                (when (= error "")
                  (let [source (.source move)
                        destination (.destination move)
                        src (loc/identity-location source slots)
                        dst (loc/identity-location destination slots)]
                    (match (if (< address-scratch 0)
                               (emit-at! (mut temporary)
                                         src
                                         dst
                                         size
                                         memory-scratch
                                         base)
                               (emit-addressed! (mut temporary)
                                                src
                                                dst
                                                size
                                                memory-scratch
                                                base
                                                address-scratch))
                      (Err [msg] (set! error msg))
                      (Ok [_] 0)))))
              (free! (mut owned))))))
    (free! (mut abstract))
    (free! (mut slots))
    (free! (mut indices))
    (if (!= error "")
        (do (free! (mut temporary)) (Err error))
        (let [count (cast i32 (len temporary))]
          (for byte temporary (push! (mut output) byte))
          (free! (mut temporary))
          (Ok count)))))

(defn parallel-at! [(output (mut (ArrayList u8)))
                    (copies (slice loc/Transfer))
                    (size i32)
                    (scratch i32)
                    (memory-scratch i32)
                    (allocator (dyn Allocator))
                    (base frame/Base)]
  (-> (Result i32 (slice u8)))
  (parallel-impl! (mut output)
                  copies
                  size
                  scratch
                  memory-scratch
                  allocator
                  base
                  -1))

;;; Target-reserved v31 holds the cycle value. Q-register copies use v30 for
;;; memory data and x16 for addresses; smaller values use x17 for memory data.
;;; No allocatable register or live cycle value is lost.
(defn parallel-frame! [(output (mut (ArrayList u8)))
                       (copies (slice loc/Transfer))
                       (size i32)
                       (allocator (dyn Allocator))
                       (base frame/Base)]
  (-> (Result i32 (slice u8)))
  (parallel-impl! (mut output)
                  copies
                  size
                  63
                  (if (= size 16) 62 17)
                  allocator
                  base
                  16))

(defn parallel! [(output (mut (ArrayList u8)))
                 (copies (slice loc/Transfer))
                 (size i32)
                 (scratch i32)
                 (memory-scratch i32)
                 (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (parallel-at! (mut output)
                copies
                size
                scratch
                memory-scratch
                allocator
                (frame/stack-base)))
