;;; Private register-result capture selection over immutable graph references.
(module stogir.a64.result-projections)
(import "stogir.fill" :as fill)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.calls" :as calls)
(import "stogir.call-results" :as results)
(import "stogir.strings" :as strings)
(import "stogir.uses" :as uses)
(import "stogir.stack" :as stack)
(import "stogir.schedule" :as schedule)
(import "stogir.matched-uses" :as machine)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn result-spec [(graph g/Graph) (reference i32)] (-> results/Spec)
  (let [node (get (.instructions graph) (cast i64 reference))]
    (if (= (n/opcode node) 79)
        (match (calls/signature graph (.op2 node) (n/type-id node)
                                (- (get (.arities graph) (cast i64 reference)) 2))
          (Err [_] (results/ordinary))
          (Ok [signature]
              (match (strings/lookup (.strings graph) (.id signature))
                (None [] (results/ordinary))
                (Some [bytes] (results/decode bytes)))))
        (results/ordinary))))

(defn eligible-spec? [(spec results/Spec)] (-> bool)
  (and (= (.kind spec) 1) (or (= (.ty spec) 5) (= (.ty spec) 11))
       (>= (.count spec) 1) (<= (.count spec) 2)))

(defn data-use? [(graph g/Graph) (edge uses/Use)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 (.user edge)))
        kind (op/operand-code (cast i32 (n/opcode node)) (.operand edge))]
    (or (= kind op/OPERAND-DEF) (= kind op/OPERAND-REF))))

;;; All data users of this address must be ordinary, exact-width word loads.
;;; Each piece has one load, preventing ambiguous aliases or duplicate defs.
(defn collect-loads! [(graph g/Graph) (users uses/Uses) (address i32)
                       (call i32) (piece i32) (ty u8)
                       (blocks (ArrayList i32)) (protected (ArrayList bool))
                       (outputs (mut (ArrayList i32)))] (-> bool)
  (let [range (get (.ranges users) (cast i64 address)) (mut valid?) true]
    (for [i 0 (.count range)]
      (let [edge (get (.edges users) (+ (.offset range) i))
            ref (.user edge) node (get (.instructions graph) (cast i64 ref))]
        (when (data-use? graph edge)
          (if (and (= (n/opcode node) 91) (= (.operand edge) 2)
                   (= (n/type-id node) ty) (= (get outputs (cast i64 piece)) 0)
                   (= (get blocks (cast i64 ref)) (get blocks (cast i64 call)))
                   (not (get protected (cast i64 ref))))
              (set! (mut outputs) (cast i64 piece) ref)
              (set! valid? false)))))
    valid?))

;;; Complete privacy proof: exactly one capture role, direct loads of piece0,
;;; and optionally ADD(base,8) used exclusively by the piece1 load. Neither a
;;; pointer conversion, an ordinary call argument, a second capture nor a store
;;; can pass this check. Non-data control users do not observe the address.
(defn select-call! [(graph g/Graph) (users uses/Uses) (call i32)
                     (spec results/Spec) (blocks (ArrayList i32))
                     (protected (ArrayList bool)) (plan (mut machine/Plan))
                     (a (dyn Allocator))] (-> bool)
  (let [node (get (.instructions graph) (cast i64 call))
        place (.op3 node) (mut valid?) (> place 0)
        (mut captures) 0 (mut second) (: 0 i32)
        (mut outputs) (ArrayList::new [i32] a)]
    (fill/append! (mut outputs) (cast i64 (.count spec)) 0)
    (when valid?
      (let [buffer (get (.instructions graph) (cast i64 place))]
        (set! valid? (and (stack/frame-object? buffer)
                         (not (get protected (cast i64 place)))))
        (when valid?
          (match (stack/constant-size graph (.op2 buffer))
            (Err [_] (set! valid? false))
            (Ok [_]
                (match (g/lookup graph (.op2 buffer))
                  (None [] (set! valid? false))
                  (Some [size]
                        (when (< (n/constant-bits size) (cast u64 (results/size spec)))
                          (set! valid? false)))))))))
    (when valid?
      (let [range (get (.ranges users) (cast i64 place))]
        (for [i 0 (.count range)]
          (let [edge (get (.edges users) (+ (.offset range) i))
                ref (.user edge) user (get (.instructions graph) (cast i64 ref))]
            (when (data-use? graph edge)
              (cond (and (= ref call) (= (.operand edge) 3))
                      (set! captures (+ captures 1))
                    (and (= (n/opcode user) 91) (= (.operand edge) 2)
                         (= (n/type-id user) (.ty spec))
                         (= (get outputs 0) 0)
                         (= (get blocks (cast i64 ref)) (get blocks (cast i64 call)))
                         (not (get protected (cast i64 ref))))
                      (set! (mut outputs) 0 ref)
                    (and (= (.count spec) 2) (= (n/opcode user) 26)
                         (= (n/type-id user) 6) (= (.operand edge) 1)
                         (= second 0) (< (.op2 user) 0)
                         (not (get protected (cast i64 ref))))
                      (match (g/lookup graph (.op2 user))
                        (Some [offset]
                              (if (and (or (= (n/type-id offset) 5) (= (n/type-id offset) 11))
                                       (= (n/opcode offset) (n/type-id offset))
                                       (= (n/constant-bits offset) 8))
                                  (set! second ref) (set! valid? false)))
                        (None [] (set! valid? false)))
                    :else (set! valid? false)))))))
    (when (and valid? (= (.count spec) 2))
      (if (> second 0)
          (set! valid? (collect-loads! graph users second call 1 (.ty spec)
                                       blocks protected (mut outputs)))
          (set! valid? false)))
    (when (!= captures 1) (set! valid? false))
    (for output outputs
      (when (or (= output 0)
                (and (> output 0) (get (.omitted plan) (cast i64 output))))
        (set! valid? false)))
    ; The complete load chain is immediately controlled by this call. This
    ; excludes paths with intervening writes, calls or divergent control, while
    ; allowing either order of the two loads.
    (when valid?
      (for output outputs
        (let [(mut control) (.op1 (get (.instructions graph) (cast i64 output)))
              (mut remaining) (.count spec)]
          (while (and (!= control call) (> remaining 0))
            (if (or (= control (get outputs 0))
                    (and (= (.count spec) 2) (= control (get outputs 1))))
                (set! control (.op1 (get (.instructions graph) (cast i64 control))))
                (set! remaining 0))
            (set! remaining (- remaining 1)))
          (when (!= control call) (set! valid? false)))))
    (when valid?
      (set! valid? (machine/define-outputs! (mut plan) call (slice outputs)))
      (when valid?
        (for output outputs
          (set! (mut (.omitted plan)) (cast i64 output) true)
          (set! (mut (.ranges plan)) (cast i64 output)
                (machine/Range :offset 0 :count 0)))))
    (free! (mut outputs))
    valid?))

;;; Called after ordinary target fusion and before liveness. Existing roots,
;;; blocks and tail modes are borrowed; graph and schedule remain unchanged.
(defn select! [(graph g/Graph) (scheduled schedule/Schedule)
                 (blocks (ArrayList i32)) (protected (ArrayList bool))
                 (tail-modes (ArrayList i32)) (plan (mut machine/Plan))
                 (a (dyn Allocator))] (-> i32)
  (let [(mut candidates) (ArrayList::new [i32] a) (mut selected) (: 0 i32)]
    (for reference (.nodes scheduled)
      (let [node (get (.instructions graph) (cast i64 reference))]
        (when (and (= (n/opcode node) 79) (> (.op3 node) 0)
                   (not (get protected (cast i64 reference)))
                   (or (>= (cast i64 reference) (len tail-modes))
                       (= (get tail-modes (cast i64 reference)) 0))
                   (eligible-spec? (result-spec graph reference)))
          (push! (mut candidates) reference))))
    (when (> (len candidates) 0)
      (let [(mut users) (uses/build graph a)]
        (for reference candidates
          (when (select-call! graph users reference (result-spec graph reference)
                               blocks protected (mut plan) a)
            (set! selected (+ selected 1))))
        (uses/release! (mut users))))
    (free! (mut candidates))
    selected))
