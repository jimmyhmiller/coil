;;; Standalone AArch64 compilation entry point over the library IR.
(module stogir.a64.compile)
(import "stogir.split-position" :as split-position)
(export validate generate generate-matched text image object vector-image image-with-options object-with-options image-with-private image-for-private-module image-for-private-module-optimized image-with-options-optimized image-for-private-module-proven image-with-options-proven)
(import "stogir.graph" :as g)
(import "stogir.compact" :as compact)
(import "stogir.options" :as options)
(import "stogir.loop-vectorize" :as vectorize)
(import "stogir.loop-rotate" :as rotate)
(import "stogir.loop-load-hoist" :as load-hoist)
(import "stogir.if-convert" :as if-convert)
(import "stogir.branch-facts" :as branch-facts)
(import "stogir.sccp" :as sccp)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.calls" :as calls)
(import "stogir.argument-value" :as argval)
(import "stogir.switch" :as switch)
(import "stogir.terminal" :as terminal)
(import "stogir.aot.macho" :as macho)
(import "stogir.image" :as code)
(import "stogir.verify" :as verify)
(import "stogir.pipeline" :as pipeline)
(import "stogir.register-live" :as live)
(import "stogir.live-ranges" :as ranges)
(import "stogir.a64.match" :as matching)
(import "stogir.a64.return-values" :as return-values)
(import "stogir.matched-uses" :as machine)
(import "stogir.node" :as n)
(import "stogir.a64.constraints" :as constraints)
(import "stogir.a64.allocate" :as allocate)
(import "stogir.a64.private-leaf" :as private)
(import "stogir.a64.function" :as function)
(import "stogir.a64.code" :as buffer)
(import "stogir.a64.image" :as emitted-image)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Option Some None])

(defn validate [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (verify/native-operations graph))

;;; Returns owned text plus pending graph references. Finish as an image before
;;; releasing the graph. Scalar coverage is checked by constraints and selection.
;;; Selected RETURN uses preserve the semantic IR's void aggregate RETURN.
;;; The table is freshly produced by lowering and applied before live analysis.
(defn install-return-uses! [(graph g/Graph) (returns (slice return-values/Return))
                             (plan (mut machine/Plan))] (-> (Result i32 (slice u8)))
  (if (= (len returns) 0) (Ok 0)
      (match (calls/function-result graph)
        (Err [message] (Err message))
        (Ok [spec]
          (let [(mut error) ""]
            (unless (and (= (.kind spec) 1) (or (= (.ty spec) 5) (= (.ty spec) 11)))
              (set! error "direct return needs a GP result prototype"))
            (for item returns
              (when (= error "")
                (let [ref (.reference item)
                      node (get (.instructions graph) (cast i64 ref))
                      range (get (.ranges plan) (cast i64 ref))
                      offset (len (.inputs plan))
                      original (if (= (.count range) 1) (get (.inputs plan) (.offset range)) 0)]
                  (unless (and (= (n/opcode node) 120) (= (n/type-id node) 0)
                               (or (= (.count range) 0) (= (.count range) 1))
                               (not (get (.omitted plan) (cast i64 ref))))
                    (set! error "invalid or duplicate direct return site"))
                  ; Preserve the original selected void-return observation,
                  ; even when it is not the usual absent-value placeholder.
                  (push! (mut (.inputs plan)) original)
                  (for k (range 0 (cast i64 (.count spec)))
                    (let [piece (if (= k 0) (.low item) (.high item))]
                      (match (g/lookup graph piece)
                        (None [] (set! error "direct return value missing"))
                        (Some [value] (unless (= (n/type-id value) (.ty spec))
                                        (set! error "direct return value type mismatch"))))
                      (push! (mut (.inputs plan)) piece)))
                  (set! (mut (.ranges plan)) (cast i64 ref)
                        (machine/Range :offset offset :count (+ (cast i64 (.count spec)) 1))))))
            (if (= error "") (Ok (cast i32 (len returns))) (Err error)))))))

;;; Lowering retains the input's original constant namespace. Check every
;;; pending relocation before releasing the owned graph, so raw Buffer callers
;;; can still finish against the graph they supplied. Unsupported new recipes
;;; fall back to the original graph without leaking a foreign reference.
(defn shared-reference-namespace? [(source g/Graph) (lowered g/Graph) (code buffer/Buffer)]
  (-> bool)
  (let [(mut good) true]
    (for pending (.references code)
      (let [ref (.target pending)]
        (if (>= ref 0) (set! good false)
            (match (g/lookup source ref)
              (None [] (set! good false))
              (Some [before]
                (match (g/lookup lowered ref)
                  (None [] (set! good false))
                  (Some [after]
                    (unless (and (= (.header before) (.header after))
                                 (= (.op1 before) (.op1 after))
                                 (= (.op2 before) (.op2 after))
                                 (= (.op3 before) (.op3 after))) (set! good false)))))))))
    good))

(defn generate-private [(graph g/Graph) (entry i32) (roots (slice i32)) (a (dyn Allocator)) (context private/Context)]
  (-> (Result buffer/Buffer (slice u8)))
  (generate-private-reusing graph entry roots a context (None [pipeline/Prepared]) false))

;;; reuse is consumed. It applies only when return lowering keeps this graph.
;;; validated: graph's exact content passed sccp-rewrite/validate at eight-byte
;;; pointers (see validated?); it does not extend to a lowered copy.
(defn generate-private-reusing [(graph g/Graph) (entry i32) (roots (slice i32)) (a (dyn Allocator))
                                (context private/Context) (reuse (Option pipeline/Prepared))
                                (validated bool)]
  (-> (Result buffer/Buffer (slice u8)))
  (match (if validated
             (return-values/prepare-after-validate graph entry roots a)
             (return-values/prepare graph entry roots a))
    (Err [message]
         (match reuse (Some [p] (let [(mut p) p] (pipeline/release! (mut p)) 0)) (None [] 0))
         (Err message))
    (Ok [prepared]
      (match prepared
        (None [] (generate-core-reusing graph entry roots [] a context reuse validated))
        (Some [owned]
          (let [(mut owned) owned
                _ (match reuse (Some [p] (let [(mut p) p] (pipeline/release! (mut p)) 0)) (None [] 0))
                result (generate-core-private (.graph owned) entry (slice (.roots owned))
                                       (slice (.returns owned)) a context)
                answer
                  (match result
                    (Err [message] (Err [buffer/Buffer (slice u8)] message))
                    (Ok [code]
                      (let [(mut code) code]
                        (if (shared-reference-namespace? graph (.graph owned) code)
                            (Ok code)
                            (do (buffer/release! (mut code))
                                (generate-core-private graph entry roots [] a context))))))]
            (return-values/release! (mut owned)) answer))))))

(defn generate-core-private [(graph g/Graph)
                (entry i32)
                (roots (slice i32))
                (returns (slice return-values/Return))
                (allocator (dyn Allocator)) (context private/Context)]
  (-> (Result buffer/Buffer (slice u8)))
  (generate-core-reusing graph entry roots returns allocator context (None [pipeline/Prepared])
                         false))

;;; reuse, when present, is pipeline/prepare output for exactly this graph,
;;; entry and roots; it is consumed. The complete native-input verification
;;; still runs before it is used; only the structural preparation is shared.
;;; When validated (as for generate-private-reusing), the part of native-input
;;; that sccp-rewrite/validate covered is not repeated.
(defn generate-core-reusing [(graph g/Graph)
                (entry i32)
                (roots (slice i32))
                (returns (slice return-values/Return))
                (allocator (dyn Allocator)) (context private/Context)
                (reuse (Option pipeline/Prepared))
                (validated bool)]
  (-> (Result buffer/Buffer (slice u8)))
  (match (match reuse
           (None [] (if validated
                        (pipeline/prepare-after-validate graph entry roots true allocator)
                        (pipeline/prepare-native graph entry roots allocator)))
           (Some [prepared]
                 (match (if validated
                            (verify/native-input-after-validate graph entry roots)
                            (verify/native-input graph entry roots))
                   (Err [message]
                        (let [(mut unused) prepared] (pipeline/release! (mut unused)) 0)
                        (Err [pipeline/Prepared (slice u8)] message))
                   (Ok [_] (Ok prepared)))))
    (Err [msg] (Err msg))
    (Ok [prepared]
        (let [(mut owned) prepared
              result
                (match (matching/build-with-selects graph
                                       (.schedule owned)
                                       roots
                                       true
                                       (private/if-convert? context)
                                       allocator)
                  (Err [message] (Err [buffer/Buffer (slice u8)] message))
                  (Ok [selected]
                      (let [(mut matched) selected
                            installed (install-return-uses! graph returns (mut (.operands matched)))
                            emitted
                              (match installed
                                (Err [message] (Err [buffer/Buffer (slice u8)] message))
                                (Ok [_] (generate-matched-private graph owned matched allocator context)))]
                        (matching/release! (mut matched))
                        emitted)))]
          (pipeline/release! (mut owned))
          result))))

;;; Allocation as usual. With shrink-wrapping, when only preserved registers
;;; keep the entry path from being frameless, allocate again assigning them late
;;; and keep that allocation if it does give a frameless region.
(defn allocate-shrink-wrapped [(intervals (ArrayList ranges/Value))
                               (req (ArrayList constraints/Value))
                               (graph g/Graph) (owned pipeline/Prepared) (matched matching/Plan)
                               (allocator (dyn Allocator)) (context private/Context)
                               (split-blocks (slice split-position/Block))]
  (-> (Result allocate/Assigned (slice u8)))
  (let [usual (private/with-late-preserved context false)
        first (allocate/build-prepared-with-machine-private-splits intervals req graph
                (.schedule owned) (.static-sizes matched) (.operands matched) (.blocks owned)
                (.depths owned) allocator (slice (.modes (.tails matched))) usual split-blocks)]
    (if (not (private/shrink-wrap? context))
        first
        (match first
          (Err [message] (Err message))
          (Ok [assigned]
              (if (or (function/region-exists? graph (.schedule owned) assigned req matched false allocator)
                      (not (function/region-exists? graph (.schedule owned) assigned req matched true allocator)))
                  (Ok assigned)
                  (match (allocate/build-prepared-with-machine-private-splits intervals req graph
                           (.schedule owned) (.static-sizes matched) (.operands matched) (.blocks owned)
                           (.depths owned) allocator (slice (.modes (.tails matched)))
                           (private/with-late-preserved context true) split-blocks)
                    (Err [message]
                         (let [(mut unused) assigned] (allocate/release! (mut unused)) (Err message)))
                    (Ok [late]
                        (let [(mut late) late]
                          (if (function/region-exists? graph (.schedule owned) late req matched false allocator)
                              (let [(mut unused) assigned] (allocate/release! (mut unused)) (Ok late))
                              (do (allocate/release! (mut late)) (Ok assigned))))))))))))

(defn generate-matched-private [(graph g/Graph)
                        (owned pipeline/Prepared)
                        (matched matching/Plan)
                        (allocator (dyn Allocator)) (context private/Context)]
  (-> (Result buffer/Buffer (slice u8)))
  (let [(mut analysis)
          (live/analyze-matched graph
                                (.blocks owned)
                                (.schedule owned)
                                (.order owned)
                                (.operands matched)
                                allocator)
        (mut intervals)
          (ranges/build-matched graph
                                (.schedule owned)
                                analysis
                                (.order owned)
                                (.operands matched)
                                allocator)
        result
          (match (constraints/build-matched graph
                                            (.schedule owned)
                                            matched
                                            allocator)
            (Err [message] (Err [buffer/Buffer (slice u8)] message))
            (Ok [requirements]
                (let [(mut req) requirements
                      (mut split-blocks) (split-position/build (.blocks owned) (.schedule owned)
                                           (.idom owned) (.depths owned) allocator)
                      emitted
                        (match (allocate-shrink-wrapped intervals req graph owned matched allocator
                                                        context (slice split-blocks))
                          (Err [message]
                               (Err [buffer/Buffer (slice u8)] message))
                          (Ok [assigned]
                              (let [(mut allocation) assigned
                                    code
                                      (function/body-prepared graph
                                                              owned
                                                              allocation
                                                              analysis
                                                              req
                                                              matched
                                                              (private/shrink-wrap? context)
                                                              allocator)]
                                (allocate/release! (mut allocation))
                                code)))]
                  (free! (mut split-blocks))
                  (constraints/release! (mut req))
                  emitted)))]
    (ranges/release! (mut intervals))
    (live/release-analysis! (mut analysis))
    result))

;;; Byte-only output is valid only when no relocation remains to be resolved.
(defn text [(graph g/Graph)
            (entry i32)
            (roots (slice i32))
            (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (match (generate graph entry roots allocator)
    (Err [msg] (Err msg))
    (Ok [compiled]
        (let [(mut owned) compiled
              result
                (if (> (len (.references owned)) 0)
                    (Err [(ArrayList u8) (slice u8)]
                         "symbolic code requires an image")
                    (Ok (buffer/take-text! (mut owned) allocator)))]
          (buffer/release! (mut owned))
          result))))

;;; Transfer compiled text into an owned, address-independent shared image.
;;; The symbol is an exact target object name; the image is also directly JIT-able.
(defn image-private [(graph g/Graph)
             (entry i32)
             (roots (slice i32))
             (symbol (slice u8))
             (allocator (dyn Allocator)) (context private/Context) (embed bool)]
  (-> (Result code/Image (slice u8)))
  (image-private-reusing graph entry roots symbol allocator context embed (None [pipeline/Prepared])
                         false))

(defn image-private-reusing [(graph g/Graph)
             (entry i32)
             (roots (slice i32))
             (symbol (slice u8))
             (allocator (dyn Allocator)) (context private/Context) (embed bool)
             (reuse (Option pipeline/Prepared)) (validated bool)]
  (-> (Result code/Image (slice u8)))
  (match (generate-private-reusing graph entry roots allocator context reuse validated)
    (Err [msg] (Err msg))
    (Ok [compiled]
        (let [(mut owned) compiled
              result (match (private/validate-references context graph (slice (.references owned)))
                       (Err [message] (Err [code/Image (slice u8)] message))
                       (Ok [_] (emitted-image/finish! (mut owned) graph symbol allocator)))]
          (buffer/release! (mut owned))
          (match result
            (Err [message] (Err message))
            (Ok [compiled]
              (let [(mut compiled) compiled]
                (match (if embed (private/bind-image! context (mut compiled)) (Ok [i32 (slice u8)] 0))
                  (Err [message] (code/release! (mut compiled)) (Err message))
                  (Ok [_] (Ok compiled))))))))))

;;; AOT consumes the same shared image as JIT, without an extra text clone.
(defn object [(graph g/Graph)
              (entry i32)
              (roots (slice i32))
              (symbol (slice u8))
              (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (match (image graph entry roots symbol allocator)
    (Err [msg] (Err msg))
    (Ok [compiled]
        (let [(mut source) compiled
              result (macho/image-object source allocator)]
          (code/release! (mut source))
          result))))

;;; A nonzero proof is a content hash recorded when a graph passed
;;; sccp-rewrite/validate at eight-byte pointers. This graph is that graph,
;;; unchanged, when its own hash matches; the backend borrows it immutably, so
;;; the answer holds for the rest of this generation.
(defn validated? [(graph g/Graph) (proof u128)] (-> bool)
  (and (!= proof 0) (= (rewrite/content-hash graph 8) proof)))

;;; The optional vector extension owns its edited graph through image finish.
;;; The backend sizes every analysis by instruction cells. When at least an
;;; eighth of them are dead NOPs, generate from a compacted copy instead.
;;; proof is as for validated?, or zero.
(defn vector-image-private [(graph g/Graph)
                    (entry i32)
                    (roots (slice i32))
                    (symbol (slice u8))
                    (allocator (dyn Allocator)) (context private/Context) (embed bool)
                    (proof u128)]
  (-> (Result code/Image (slice u8)))
  (if (and (= entry 1)
           (>= (* (compact/nop-cells graph) 8) (len (.instructions graph))))
      (let [(mut compacted) (compact/compact graph roots allocator)
            output (vector-image-dense (.graph compacted) entry (slice (.roots compacted))
                                       symbol allocator context embed false)]
        (compact/release! (mut compacted))
        output)
      (vector-image-dense graph entry roots symbol allocator context embed
                          (validated? graph proof))))

(defn vector-image-dense [(graph g/Graph)
                    (entry i32)
                    (roots (slice i32))
                    (symbol (slice u8))
                    (allocator (dyn Allocator)) (context private/Context) (embed bool)
                    (validated bool)]
  (-> (Result code/Image (slice u8)))
  (if (not (or (private/branch-facts? context) (private/induction? context)))
      (vector-image-selects graph entry roots symbol allocator context embed validated)
      (match (branch-facts/run-with-induction graph entry roots allocator (private/induction? context))
        (Err [message] (Err message))
        (Ok [edited]
          (match edited
            (None [] (vector-image-selects graph entry roots symbol allocator context embed validated))
            (Some [working]
              (let [(mut working) working
                    result (sccp/optimize working 8 roots allocator)]
                (g/release! (mut working))
                (match result
                  (Err [message] (Err message))
                  (Ok [rewritten]
                    (let [(mut rewritten) rewritten
                          output (vector-image-selects (.graph rewritten) entry (slice (.roots rewritten))
                                    symbol allocator context embed false)]
                      (rewrite/release! (mut rewritten))
                      output))))))))))

(defn vector-image-selects [(graph g/Graph) (entry i32) (roots (slice i32))
                           (symbol (slice u8)) (allocator (dyn Allocator))
                           (context private/Context) (embed bool) (validated bool)]
  (-> (Result code/Image (slice u8)))
  (if (not (private/if-convert? context))
      (vector-image-loads graph entry roots symbol allocator context embed validated false)
      (match (if-convert/run graph entry roots allocator)
        (Err [message] (Err message))
        (Ok [result]
          (let [(mut exits) (.roots result)
                output (match (.graph result)
                  (None [] (vector-image-loads graph entry roots symbol allocator context embed validated false))
                  (Some [owned]
                    (let [(mut owned) owned
                          output (vector-image-loads owned entry (slice exits) symbol allocator context embed false false)]
                      (g/release! (mut owned)) output)))]
            (free! (mut exits)) output)))))

;;; Hoist header loads before rotation so they are not cloned into the latch.
;;; After a successful rotation, newly must-execute body loads can move onto
;;; the guarded loop entry without introducing reads on zero-trip paths.
(defn vector-image-loads [(graph g/Graph) (entry i32) (roots (slice i32))
                         (symbol (slice u8)) (allocator (dyn Allocator))
                         (context private/Context) (embed bool) (validated bool)
                         (after-rotation bool)]
  (-> (Result code/Image (slice u8)))
  (if (not (private/hoist-loads? context))
      (loads-next graph entry roots symbol allocator context embed validated after-rotation)
      (match (load-hoist/run graph entry roots allocator)
        (Err [message] (Err message))
        (Ok [result]
          (let [(mut exits) (.roots result)
                output (match (.graph result)
                  (None [] (loads-next graph entry roots symbol allocator context embed validated after-rotation))
                  (Some [owned]
                    (let [(mut owned) owned
                          output (loads-next owned entry (slice exits) symbol allocator context embed false after-rotation)]
                      (g/release! (mut owned)) output)))]
            (free! (mut exits)) output)))))

(defn loads-next [(graph g/Graph) (entry i32) (roots (slice i32))
                 (symbol (slice u8)) (allocator (dyn Allocator))
                 (context private/Context) (embed bool) (validated bool) (after-rotation bool)]
  (-> (Result code/Image (slice u8)))
  (if after-rotation
      (vector-image-unrotated graph entry roots symbol allocator context embed validated)
      (vector-image-rotation graph entry roots symbol allocator context embed validated)))

(defn vector-image-rotation [(graph g/Graph)
                    (entry i32)
                    (roots (slice i32))
                    (symbol (slice u8))
                    (allocator (dyn Allocator)) (context private/Context) (embed bool)
                    (validated bool)]
  (-> (Result code/Image (slice u8)))
  (if (not (private/rotate? context))
      (vector-image-unrotated graph entry roots symbol allocator context embed validated)
      (match (rotate/run graph entry roots allocator)
        (Err [message] (Err message))
        (Ok [result]
            (let [(mut rotated-roots) (.roots result)
                  output
                    (match (.graph result)
                      (None [] (vector-image-unrotated graph entry roots symbol allocator context
                                                       embed validated))
                      (Some [rotated]
                            (let [(mut rotated) rotated
                                  output (vector-image-loads rotated entry (slice rotated-roots)
                                                                 symbol allocator context embed false true)]
                              (g/release! (mut rotated))
                              output)))]
              (free! (mut rotated-roots))
              output)))))

(defn vector-image-unrotated [(graph g/Graph)
                    (entry i32)
                    (roots (slice i32))
                    (symbol (slice u8))
                    (allocator (dyn Allocator)) (context private/Context) (embed bool)
                    (validated bool)]
  (-> (Result code/Image (slice u8)))
  ; The vectorizer's last structural preparation describes the graph it
  ; returns (or the input when it made no edit); code generation reuses it.
  (match (if validated
             (vectorize/optimize-prepared-after-validate graph entry roots 2 allocator)
             (vectorize/optimize-prepared graph entry roots 2 allocator))
    (Err [message] (Err message))
    (Ok [result]
        (match (.graph result)
          (None [] (image-private-reusing graph entry roots symbol allocator context embed
                                          (.prepared result) validated))
          (Some [working]
                (let [(mut working) working
                      output (image-private-reusing working entry roots symbol allocator context
                                                    embed (.prepared result) false)]
                  (g/release! (mut working))
                  output))))))

;;; The image's SCCP works on its own copy of the caller's graph. When at least
;;; an eighth of the cells are dead NOPs, that copy is the compacted graph, which
;;; optimization then consumes in place.
(defn optimize-for-image [(graph g/Graph) (roots (slice i32)) (allocator (dyn Allocator))]
  (-> (Result rewrite/Rewritten (slice u8)))
  (if (< (* (compact/nop-cells graph) 8) (len (.instructions graph)))
      (sccp/optimize-memory-compacting graph 8 roots true true allocator)
      (match (verify/structure graph)
        (Err [message] (Err message))
        (Ok [_]
            (let [(mut packed) (compact/compact graph roots allocator)
                  result (sccp/optimize-memory-owned! (.graph packed) 8 (slice (.roots packed))
                                                      true allocator)]
              (free! (mut (.roots packed)))
              result)))))

;;; Positive modes retain the existing shared scheduling/allocation pipeline.
;;; Like upstream, levels above one add SCCP before CFG/GCM/matching/liveness.
;;; O0 needs the distinct de-SSA/fast allocation path and is rejected until that
;;; implementation exists. Missing promotion/control rules remain documented.
;;; Keep the working graph alive through finish!: Buffer references are not an
;;; owned image and must never escape after the optimized graph is released.
(defn image-with-private-impl [(graph g/Graph)
                          (entry i32)
                          (roots (slice i32))
                          (symbol (slice u8))
                          (configuration options/Options)
                          (allocator (dyn Allocator)) (context private/Context) (embed bool)
                          (optimized bool) (proof u128)]
  (-> (Result code/Image (slice u8)))
  (match (options/validate configuration)
    (Err [message] (Err message))
    (Ok [level]
        (if (= level 0)
            (Err "AArch64 O0 pipeline is not implemented")
            (if (or (= level 1) (and optimized (= level 2)))
                (image-private graph entry roots symbol allocator context embed)
                (if (and optimized (= level 3))
                    (vector-image-private graph entry roots symbol allocator context embed proof)
                (if (!= entry 1)
                    (Err "SCCP requires START at reference one")
                    (match (optimize-for-image graph roots allocator)
                      (Err [message] (Err message))
                      (Ok [optimized]
                          (let [(mut optimized) optimized
                                output
                                  (if (= level 3)
                                      (vector-image-private (.graph optimized)
                                                    entry
                                                    (slice (.roots optimized))
                                                    symbol
                                                    allocator context embed
                                                    (.proof optimized))
                                      (image-private (.graph optimized)
                                             entry
                                             (slice (.roots optimized))
                                             symbol
                                             allocator context embed))]
                            (rewrite/release! (mut optimized))
                            output))))))))))

;;; AOT and JIT share image-with-options; there is no separate optimizer or
;;; target emitter in the object path.
(defn object-with-options [(graph g/Graph)
                           (entry i32)
                           (roots (slice i32))
                           (symbol (slice u8))
                           (configuration options/Options)
                           (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (match (image-with-options graph entry roots symbol configuration allocator)
    (Err [message] (Err message))
    (Ok [compiled]
        (let [(mut compiled) compiled
              output (macho/image-object compiled allocator)]
          (code/release! (mut compiled))
          output))))

;;; Existing entry points retain full-ABI allocation and ordinary image binding.
(defn generate [(graph g/Graph) (entry i32) (roots (slice i32)) (a (dyn Allocator))]
  (-> (Result buffer/Buffer (slice u8)))
  (generate-private graph entry roots a (private/no-context)))
(defn generate-core [(graph g/Graph) (entry i32) (roots (slice i32))
                     (returns (slice return-values/Return)) (a (dyn Allocator))]
  (-> (Result buffer/Buffer (slice u8)))
  (generate-core-private graph entry roots returns a (private/no-context)))
(defn generate-matched [(graph g/Graph) (owned pipeline/Prepared)
                        (matched matching/Plan) (a (dyn Allocator))]
  (-> (Result buffer/Buffer (slice u8)))
  (generate-matched-private graph owned matched a (private/no-context)))
(defn image [(graph g/Graph) (entry i32) (roots (slice i32)) (symbol (slice u8))
             (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (image-private graph entry roots symbol a (private/no-context) true))
(defn vector-image [(graph g/Graph) (entry i32) (roots (slice i32)) (symbol (slice u8))
                    (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (vector-image-private graph entry roots symbol a (private/no-context) true 0))
(defn image-with-options [(graph g/Graph) (entry i32) (roots (slice i32))
                          (symbol (slice u8)) (configuration options/Options)
                          (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (image-with-private graph entry roots symbol configuration a (private/no-context)))

;;; Self-contained images own a private instance of every referenced leaf.
(defn image-with-private [(graph g/Graph) (entry i32) (roots (slice i32))
                          (symbol (slice u8)) (configuration options/Options)
                          (a (dyn Allocator)) (context private/Context)]
  (-> (Result code/Image (slice u8)))
  (image-with-private-impl graph entry roots symbol configuration a context true false 0))

;;; A target transport must bind the returned undefined declarations to binding()
;;; from this exact sealed publication. It may not resolve them externally or
;;; emit the private bodies again. The adapter verifies publication bytes/binding
;;; metadata and preserves symbol IDs through its final AOT/JIT image assembly.
(defn image-for-private-module [(graph g/Graph) (entry i32) (roots (slice i32))
                                (symbol (slice u8)) (configuration options/Options)
                                (a (dyn Allocator)) (context private/Context)
                                (publication private/Publication) (scope usize)]
  (-> (Result code/Image (slice u8)))
  (if (not (private/module-valid? context publication scope))
      (Err "private module publication is not valid for this target")
      (image-with-private-impl graph entry roots symbol configuration a context false false 0)))

;;; As image-for-private-module / image-with-options for a graph that is
;;; already the output of sccp/optimize-memory for these roots and unchanged
;;; since: levels two and three skip their entry SCCP, keeping the rest of the
;;; pipeline (CFG, GCM, vectorization at three, matching, liveness, allocation).
(defn image-for-private-module-optimized [(graph g/Graph) (entry i32) (roots (slice i32))
                                          (symbol (slice u8)) (configuration options/Options)
                                          (a (dyn Allocator)) (context private/Context)
                                          (publication private/Publication) (scope usize)]
  (-> (Result code/Image (slice u8)))
  (image-for-private-module-proven graph entry roots symbol configuration a context
                                   publication scope 0))

(defn image-with-options-optimized [(graph g/Graph) (entry i32) (roots (slice i32))
                                    (symbol (slice u8)) (configuration options/Options)
                                    (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (image-with-options-proven graph entry roots symbol configuration a 0))

;;; As the -optimized entries, with the proof the optimizer recorded for this
;;; graph (sccp-rewrite Rewritten proof), or zero. When the graph's content
;;; still hashes to it, code generation skips the native-input checks that
;;; the optimizer's validation already made.
(defn image-for-private-module-proven [(graph g/Graph) (entry i32) (roots (slice i32))
                                       (symbol (slice u8)) (configuration options/Options)
                                       (a (dyn Allocator)) (context private/Context)
                                       (publication private/Publication) (scope usize)
                                       (proof u128)]
  (-> (Result code/Image (slice u8)))
  (if (not (private/module-valid? context publication scope))
      (Err "private module publication is not valid for this target")
      (image-with-private-impl graph entry roots symbol configuration a context false true proof)))

(defn image-with-options-proven [(graph g/Graph) (entry i32) (roots (slice i32))
                                 (symbol (slice u8)) (configuration options/Options)
                                 (a (dyn Allocator)) (proof u128)]
  (-> (Result code/Image (slice u8)))
  (image-with-private-impl graph entry roots symbol configuration a (private/no-context) true true
                           proof))
