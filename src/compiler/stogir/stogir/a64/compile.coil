;;; Standalone AArch64 compilation entry point over the library IR.
(module stogir.a64.compile)
(export validate generate generate-matched text image object vector-image image-with-options object-with-options image-with-private image-for-private-module)
(import "stogir.graph" :as g)
(import "stogir.options" :as options)
(import "stogir.loop-vectorize" :as vectorize)
(import "stogir.sccp" :as sccp)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.calls" :as calls)
(import "stogir.argument-value" :as argval)
(import "stogir.switch" :as switch)
(import "stogir.terminal" :as terminal)
(import "stogir.aot.macho" :as macho)
(import "stogir.image" :as code)
(import "stogir.verify" :as verify)
(import "stogir.pipeline" :as pipeline)
(import "stogir.register-live" :as live)
(import "stogir.live-ranges" :as ranges)
(import "stogir.a64.match" :as matching)
(import "stogir.a64.return-values" :as return-values)
(import "stogir.matched-uses" :as machine)
(import "stogir.node" :as n)
(import "stogir.a64.constraints" :as constraints)
(import "stogir.a64.allocate" :as allocate)
(import "stogir.a64.private-leaf" :as private)
(import "stogir.a64.function" :as function)
(import "stogir.a64.code" :as buffer)
(import "stogir.a64.image" :as emitted-image)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Option Some None])

(defn validate [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (verify/native-operations graph))

;;; Returns owned text plus pending graph references. Finish as an image before
;;; releasing the graph. Scalar coverage is checked by constraints and selection.
;;; Selected RETURN uses preserve the semantic IR's void aggregate RETURN.
;;; The table is freshly produced by lowering and applied before live analysis.
(defn install-return-uses! [(graph g/Graph) (returns (slice return-values/Return))
                             (plan (mut machine/Plan))] (-> (Result i32 (slice u8)))
  (if (= (len returns) 0) (Ok 0)
      (match (calls/function-result graph)
        (Err [message] (Err message))
        (Ok [spec]
          (let [(mut error) ""]
            (unless (and (= (.kind spec) 1) (or (= (.ty spec) 5) (= (.ty spec) 11)))
              (set! error "direct return needs a GP result prototype"))
            (for item returns
              (when (= error "")
                (let [ref (.reference item)
                      node (get (.instructions graph) (cast i64 ref))
                      range (get (.ranges plan) (cast i64 ref))
                      offset (len (.inputs plan))
                      original (if (= (.count range) 1) (get (.inputs plan) (.offset range)) 0)]
                  (unless (and (= (n/opcode node) 120) (= (n/type-id node) 0)
                               (or (= (.count range) 0) (= (.count range) 1))
                               (not (get (.omitted plan) (cast i64 ref))))
                    (set! error "invalid or duplicate direct return site"))
                  ; Preserve the original selected void-return observation,
                  ; even when it is not the usual absent-value placeholder.
                  (push! (mut (.inputs plan)) original)
                  (for k (range 0 (cast i64 (.count spec)))
                    (let [piece (if (= k 0) (.low item) (.high item))]
                      (match (g/lookup graph piece)
                        (None [] (set! error "direct return value missing"))
                        (Some [value] (unless (= (n/type-id value) (.ty spec))
                                        (set! error "direct return value type mismatch"))))
                      (push! (mut (.inputs plan)) piece)))
                  (set! (mut (.ranges plan)) (cast i64 ref)
                        (machine/Range :offset offset :count (+ (cast i64 (.count spec)) 1))))))
            (if (= error "") (Ok (cast i32 (len returns))) (Err error)))))))

;;; Lowering retains the input's original constant namespace. Check every
;;; pending relocation before releasing the owned graph, so raw Buffer callers
;;; can still finish against the graph they supplied. Unsupported new recipes
;;; fall back to the original graph without leaking a foreign reference.
(defn shared-reference-namespace? [(source g/Graph) (lowered g/Graph) (code buffer/Buffer)]
  (-> bool)
  (let [(mut good) true]
    (for pending (.references code)
      (let [ref (.target pending)]
        (if (>= ref 0) (set! good false)
            (match (g/lookup source ref)
              (None [] (set! good false))
              (Some [before]
                (match (g/lookup lowered ref)
                  (None [] (set! good false))
                  (Some [after]
                    (unless (and (= (.header before) (.header after))
                                 (= (.op1 before) (.op1 after))
                                 (= (.op2 before) (.op2 after))
                                 (= (.op3 before) (.op3 after))) (set! good false)))))))))
    good))

(defn generate-private [(graph g/Graph) (entry i32) (roots (slice i32)) (a (dyn Allocator)) (context private/Context)]
  (-> (Result buffer/Buffer (slice u8)))
  (match (return-values/prepare graph entry roots a)
    (Err [message] (Err message))
    (Ok [prepared]
      (match prepared
        (None [] (generate-core-private graph entry roots [] a context))
        (Some [owned]
          (let [(mut owned) owned
                result (generate-core-private (.graph owned) entry (slice (.roots owned))
                                       (slice (.returns owned)) a context)
                answer
                  (match result
                    (Err [message] (Err [buffer/Buffer (slice u8)] message))
                    (Ok [code]
                      (let [(mut code) code]
                        (if (shared-reference-namespace? graph (.graph owned) code)
                            (Ok code)
                            (do (buffer/release! (mut code))
                                (generate-core-private graph entry roots [] a context))))))]
            (return-values/release! (mut owned)) answer))))))

(defn generate-core-private [(graph g/Graph)
                (entry i32)
                (roots (slice i32))
                (returns (slice return-values/Return))
                (allocator (dyn Allocator)) (context private/Context)]
  (-> (Result buffer/Buffer (slice u8)))
  (match (pipeline/prepare-native graph entry roots allocator)
    (Err [msg] (Err msg))
    (Ok [prepared]
        (let [(mut owned) prepared
              result
                (match (matching/build graph
                                       (.schedule owned)
                                       roots
                                       true
                                       allocator)
                  (Err [message] (Err [buffer/Buffer (slice u8)] message))
                  (Ok [selected]
                      (let [(mut matched) selected
                            installed (install-return-uses! graph returns (mut (.operands matched)))
                            emitted
                              (match installed
                                (Err [message] (Err [buffer/Buffer (slice u8)] message))
                                (Ok [_] (generate-matched-private graph owned matched allocator context)))]
                        (matching/release! (mut matched))
                        emitted)))]
          (pipeline/release! (mut owned))
          result))))

(defn generate-matched-private [(graph g/Graph)
                        (owned pipeline/Prepared)
                        (matched matching/Plan)
                        (allocator (dyn Allocator)) (context private/Context)]
  (-> (Result buffer/Buffer (slice u8)))
  (let [(mut analysis)
          (live/analyze-matched graph
                                (.blocks owned)
                                (.schedule owned)
                                (.order owned)
                                (.operands matched)
                                allocator)
        (mut intervals)
          (ranges/build-matched graph
                                (.schedule owned)
                                analysis
                                (.order owned)
                                (.operands matched)
                                allocator)
        result
          (match (constraints/build-matched graph
                                            (.schedule owned)
                                            matched
                                            allocator)
            (Err [message] (Err [buffer/Buffer (slice u8)] message))
            (Ok [requirements]
                (let [(mut req) requirements
                      emitted
                        (match (allocate/build-prepared-with-machine-private intervals
                                               req
                                               graph
                                               (.schedule owned)
                                               (.static-sizes matched)
                                               (.operands matched)
                                               (.blocks owned)
                                               (.depths owned)
                                               allocator (slice (.modes (.tails matched))) context)
                          (Err [message]
                               (Err [buffer/Buffer (slice u8)] message))
                          (Ok [assigned]
                              (let [(mut allocation) assigned
                                    code
                                      (function/body-prepared graph
                                                              owned
                                                              allocation
                                                              analysis
                                                              req
                                                              matched
                                                              allocator)]
                                (allocate/release! (mut allocation))
                                code)))]
                  (constraints/release! (mut req))
                  emitted)))]
    (ranges/release! (mut intervals))
    (live/release-analysis! (mut analysis))
    result))

;;; Byte-only output is valid only when no relocation remains to be resolved.
(defn text [(graph g/Graph)
            (entry i32)
            (roots (slice i32))
            (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (match (generate graph entry roots allocator)
    (Err [msg] (Err msg))
    (Ok [compiled]
        (let [(mut owned) compiled
              result
                (if (> (len (.references owned)) 0)
                    (Err [(ArrayList u8) (slice u8)]
                         "symbolic code requires an image")
                    (Ok (buffer/take-text! (mut owned) allocator)))]
          (buffer/release! (mut owned))
          result))))

;;; Transfer compiled text into an owned, address-independent shared image.
;;; The symbol is an exact target object name; the image is also directly JIT-able.
(defn image-private [(graph g/Graph)
             (entry i32)
             (roots (slice i32))
             (symbol (slice u8))
             (allocator (dyn Allocator)) (context private/Context) (embed bool)]
  (-> (Result code/Image (slice u8)))
  (match (generate-private graph entry roots allocator context)
    (Err [msg] (Err msg))
    (Ok [compiled]
        (let [(mut owned) compiled
              result (match (private/validate-references context graph (slice (.references owned)))
                       (Err [message] (Err [code/Image (slice u8)] message))
                       (Ok [_] (emitted-image/finish! (mut owned) graph symbol allocator)))]
          (buffer/release! (mut owned))
          (match result
            (Err [message] (Err message))
            (Ok [compiled]
              (let [(mut compiled) compiled]
                (match (if embed (private/bind-image! context (mut compiled)) (Ok [i32 (slice u8)] 0))
                  (Err [message] (code/release! (mut compiled)) (Err message))
                  (Ok [_] (Ok compiled))))))))))

;;; AOT consumes the same shared image as JIT, without an extra text clone.
(defn object [(graph g/Graph)
              (entry i32)
              (roots (slice i32))
              (symbol (slice u8))
              (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (match (image graph entry roots symbol allocator)
    (Err [msg] (Err msg))
    (Ok [compiled]
        (let [(mut source) compiled
              result (macho/image-object source allocator)]
          (code/release! (mut source))
          result))))

;;; The optional vector extension owns its edited graph through image finish.
(defn vector-image-private [(graph g/Graph)
                    (entry i32)
                    (roots (slice i32))
                    (symbol (slice u8))
                    (allocator (dyn Allocator)) (context private/Context) (embed bool)]
  (-> (Result code/Image (slice u8)))
  (match (vectorize/optimize graph entry roots 2 allocator)
    (Err [message] (Err message))
    (Ok [candidate]
        (match candidate
          (None [] (image-private graph entry roots symbol allocator context embed))
          (Some [working]
                (let [(mut working) working
                      output (image-private working entry roots symbol allocator context embed)]
                  (g/release! (mut working))
                  output))))))

;;; Positive modes retain the existing shared scheduling/allocation pipeline.
;;; Like upstream, levels above one add SCCP before CFG/GCM/matching/liveness.
;;; O0 needs the distinct de-SSA/fast allocation path and is rejected until that
;;; implementation exists. Missing promotion/control rules remain documented.
;;; Keep the working graph alive through finish!: Buffer references are not an
;;; owned image and must never escape after the optimized graph is released.
(defn image-with-private-impl [(graph g/Graph)
                          (entry i32)
                          (roots (slice i32))
                          (symbol (slice u8))
                          (configuration options/Options)
                          (allocator (dyn Allocator)) (context private/Context) (embed bool)]
  (-> (Result code/Image (slice u8)))
  (match (options/validate configuration)
    (Err [message] (Err message))
    (Ok [level]
        (if (= level 0)
            (Err "AArch64 O0 pipeline is not implemented")
            (if (= level 1)
                (image-private graph entry roots symbol allocator context embed)
                (if (!= entry 1)
                    (Err "SCCP requires START at reference one")
                    (match (sccp/optimize-memory graph 8 roots true allocator)
                      (Err [message] (Err message))
                      (Ok [optimized]
                          (let [(mut optimized) optimized
                                output
                                  (if (= level 3)
                                      (vector-image-private (.graph optimized)
                                                    entry
                                                    (slice (.roots optimized))
                                                    symbol
                                                    allocator context embed)
                                      (image-private (.graph optimized)
                                             entry
                                             (slice (.roots optimized))
                                             symbol
                                             allocator context embed))]
                            (rewrite/release! (mut optimized))
                            output)))))))))

;;; AOT and JIT share image-with-options; there is no separate optimizer or
;;; target emitter in the object path.
(defn object-with-options [(graph g/Graph)
                           (entry i32)
                           (roots (slice i32))
                           (symbol (slice u8))
                           (configuration options/Options)
                           (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (match (image-with-options graph entry roots symbol configuration allocator)
    (Err [message] (Err message))
    (Ok [compiled]
        (let [(mut compiled) compiled
              output (macho/image-object compiled allocator)]
          (code/release! (mut compiled))
          output))))

;;; Existing entry points retain full-ABI allocation and ordinary image binding.
(defn generate [(graph g/Graph) (entry i32) (roots (slice i32)) (a (dyn Allocator))]
  (-> (Result buffer/Buffer (slice u8)))
  (generate-private graph entry roots a (private/no-context)))
(defn generate-core [(graph g/Graph) (entry i32) (roots (slice i32))
                     (returns (slice return-values/Return)) (a (dyn Allocator))]
  (-> (Result buffer/Buffer (slice u8)))
  (generate-core-private graph entry roots returns a (private/no-context)))
(defn generate-matched [(graph g/Graph) (owned pipeline/Prepared)
                        (matched matching/Plan) (a (dyn Allocator))]
  (-> (Result buffer/Buffer (slice u8)))
  (generate-matched-private graph owned matched a (private/no-context)))
(defn image [(graph g/Graph) (entry i32) (roots (slice i32)) (symbol (slice u8))
             (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (image-private graph entry roots symbol a (private/no-context) true))
(defn vector-image [(graph g/Graph) (entry i32) (roots (slice i32)) (symbol (slice u8))
                    (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (vector-image-private graph entry roots symbol a (private/no-context) true))
(defn image-with-options [(graph g/Graph) (entry i32) (roots (slice i32))
                          (symbol (slice u8)) (configuration options/Options)
                          (a (dyn Allocator))] (-> (Result code/Image (slice u8)))
  (image-with-private graph entry roots symbol configuration a (private/no-context)))

;;; Self-contained images own a private instance of every referenced leaf.
(defn image-with-private [(graph g/Graph) (entry i32) (roots (slice i32))
                          (symbol (slice u8)) (configuration options/Options)
                          (a (dyn Allocator)) (context private/Context)]
  (-> (Result code/Image (slice u8)))
  (image-with-private-impl graph entry roots symbol configuration a context true))

;;; A target transport must bind the returned undefined declarations to binding()
;;; from this exact sealed publication. It may not resolve them externally or
;;; emit the private bodies again. The adapter verifies publication bytes/binding
;;; metadata and preserves symbol IDs through its final AOT/JIT image assembly.
(defn image-for-private-module [(graph g/Graph) (entry i32) (roots (slice i32))
                                (symbol (slice u8)) (configuration options/Options)
                                (a (dyn Allocator)) (context private/Context)
                                (publication private/Publication) (scope usize)]
  (-> (Result code/Image (slice u8)))
  (if (not (private/module-valid? context publication scope))
      (Err "private module publication is not valid for this target")
      (image-with-private-impl graph entry roots symbol configuration a context false)))
