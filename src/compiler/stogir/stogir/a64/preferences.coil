;;; Register and reference hints follow ir_ra.c:ir_try_allocate_preferred_reg
;;; and ir_aarch64.dasc target constraints. See NOTICE/provenance.
(module stogir.a64.preferences)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.allocation" :as allocation)
(import "stogir.schedule" :as schedule)
(import "stogir.a64.registers" :as registers)
(import "stogir.calls" :as calls)
(import "stogir.call-groups" :as groups)
(import "stogir.call-results" :as results)
(import "stogir.strings" :as strings)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Ok Err Some None])

;;; Before reservations/splits, build-core's parts are sorted by graph ref.
;;; Binary lookup avoids another dense graph-sized temporary map.
(defn find [(parts (ArrayList allocation/Part)) (reference i32)] (-> i32)
  (let [(mut lo) 0
        (mut hi) (len parts)]
    (while (< lo hi)
      (let [mid (+ lo (/ (- hi lo) 2))]
        (if (< (.parent (at parts mid)) reference)
            (set! lo (+ mid 1))
            (set! hi mid))))
    (if (and (< lo (len parts)) (= (.parent (at parts lo)) reference))
        (cast i32 lo)
        -1)))

(defn owner [(aliases (ArrayList i32)) (reference i32)] (-> i32)
  (if (= (len aliases) 0) reference (get aliases (cast i64 reference))))

;;; A preference changes only legal register selection, never value identity.
;;; Conversions may reuse a dead input even when they change bits or widths.
;;; Same-bank COPY/PROTO and scalar conversion emitters support rd == rn.
(defn reference-hint? [(graph g/Graph) (node n/Node)] (-> bool)
  (let [opcode (n/opcode node)]
    (and (> (.op1 node) 0)
         (or (= opcode 68) (= opcode 40) (and (>= opcode 33) (<= opcode 39)))
         (match (g/lookup graph (.op1 node))
           (None [] false)
           (Some [source]
                 (= (registers/class-mask (cast i32 (n/type-id source)))
                    (registers/class-mask (cast i32 (n/type-id node)))))))))

;;; Outgoing argument ports are advisory: an argument that can stay in its ABI
;;; register from definition to its last use needs no setup move. The walk
;;; follows abi-arguments/plan-result's register order (hidden result place,
;;; independent banks, whole groups, Darwin unnamed arguments on the stack). An
;;; earlier preference wins. Calls were validated when their uses were built;
;;; a prototype that cannot be read here yields no preference, never an error.
(defn prefer-arguments! [(parts (mut (ArrayList allocation/Part)))
                         (graph g/Graph)
                         (aliases (ArrayList i32))
                         (reference i32)] (-> void)
  (let [node (get (.instructions graph) (cast i64 reference))
        count (- (get (.arities graph) (cast i64 reference)) 2)]
    (match (calls/signature graph (.op2 node) (n/type-id node) count)
      (Err [_] 0)
      (Ok [signature]
        (let [bytes (if (> (.id signature) 0)
                        (match (strings/lookup (.strings graph) (.id signature))
                          (None [] "") (Some [found] found))
                        "")
              described? (> (len bytes) 0)
              group-count (if described? (groups/count bytes) 0)
              variadic? (!= (& (.flags signature) 16) 0)
              fixed (.count signature)
              (mut gp) (: 0 i32)
              (mut fp) (: 0 i32)
              (mut next-group) (: 0 i64)
              (mut i) (if (and described? (!= (.kind (results/decode bytes)) 0))
                          (: 1 i32) 0)]
          (while (< i count)
            (let [value (call-input graph reference (+ i 3))
                  floating? (and (> value 0)
                                 (registers/simd-type?
                                   (cast i32 (n/type-id (get (.instructions graph)
                                                             (cast i64 value))))))
                  grouped? (and (< next-group group-count)
                                (= (.first (groups/at bytes next-group)) i))
                  members (if grouped? (.count (groups/at bytes next-group)) 1)
                  available (if floating? fp gp)
                  unnamed? (and variadic? (>= i fixed))
                  fits? (and (not unnamed?) (<= (+ available members) 8))]
              (when fits?
                (for [member 0 (cast i64 members)]
                  (let [input (call-input graph reference
                                          (+ i 3 (cast i32 member)))]
                    (when (> input 0)
                      (let [index (find parts (owner aliases input))]
                        (when (>= index 0)
                          (let [part (elem (mut parts) (cast i64 index))]
                            (when (< (.preferred part) 0)
                              (set! (.preferred part)
                                    (+ available (cast i32 member)
                                       (if floating? 32 0)))))))))))
              (if fits?
                  (if floating? (set! fp (+ fp members)) (set! gp (+ gp members)))
                  (unless unnamed? (if floating? (set! fp 8) (set! gp 8))))
              (set! i (+ i members))
              (when grouped? (set! next-group (+ next-group 1))))))))))

(defn call-input [(graph g/Graph) (reference i32) (operand i32)] (-> i32)
  (match (g/operand graph reference operand) (None [] 0) (Some [value] value)))

;;; Stable original part indices own recent-assignment caches. Split children
;;; inherit their owner's index; appending children cannot invalidate a hint.
;;; Coalesced graph refs are resolved before attaching either hint kind.
(defn prepare! [(parts (mut (ArrayList allocation/Part)))
                (graph g/Graph)
                (scheduled schedule/Schedule)
                (aliases (ArrayList i32))] (-> void)
  (for [i 0 (len parts)]
    (let [part (elem (mut parts) i)]
      (set! (.hint-owner part) (cast i32 i))
      (set! (.last-register part) (.register part))))
  (for reference (.nodes scheduled)
    (let [node (get (.instructions graph) (cast i64 reference))]
      (when (and (= (n/opcode node) 120) (> (.op2 node) 0))
        (let [part (find parts (owner aliases (.op2 node)))]
          (when (>= part 0)
            (set! (.preferred (elem (mut parts) (cast i64 part)))
                  (if (registers/simd-type? (cast i32 (n/type-id node))) 32 0)))))
      (when (or (= (n/opcode node) 79) (= (n/opcode node) 80))
        (prefer-arguments! (mut parts) graph aliases reference))
      (when (reference-hint? graph node)
        (let [target (owner aliases reference)
              source (owner aliases (.op1 node))
              target-part (find parts target)
              source-part (find parts source)]
          (when (and (!= source target) (>= target-part 0) (>= source-part 0))
            (set! (.hint (elem (mut parts) (cast i64 target-part))) source-part)))))))

;;; Advisory result ports, not simultaneous hard constraints. First preference
;;; wins for a shared/coalesced value; the return copy still installs every port.
(defstruct ResultHint [(reference i32) (register i32)])
(defn result-word? [(ty u8)] (-> bool)
  (or (= ty 5) (= ty 6) (= ty 11)))

;;; Protected COPY roots may not coalesce into an existing Phi group. Carry
;;; their advisory port preference back to the word producer, before the copy
;;; can find that port occupied by another return piece. Do not cross a Phi,
;;; arithmetic, width-changing conversion or register-bank boundary.
(defn apply-results! [(parts (mut (ArrayList allocation/Part))) (graph g/Graph)
                       (aliases (ArrayList i32)) (hints (slice ResultHint))] (-> void)
  (for hint hints
    (let [(mut reference) (.reference hint) (mut steps) 0 (mut more) true]
      (while (and more (> reference 0) (< steps 16))
        (let [index (find parts (owner aliases reference))]
          (when (>= index 0)
            (let [part (elem (mut parts) (cast i64 index))]
              (when (< (.preferred part) 0) (set! (.preferred part) (.register hint))))))
        (set! more false)
        (match (g/lookup graph reference)
          (None [] 0)
          (Some [node]
            (when (and (or (= (n/opcode node) 68) (= (n/opcode node) 36))
                       (result-word? (n/type-id node)))
              (match (g/lookup graph (.op1 node))
                (None [] 0)
                (Some [source]
                  (when (result-word? (n/type-id source))
                    (set! reference (.op1 node)) (set! more true)))))))
        (set! steps (+ steps 1))))))
