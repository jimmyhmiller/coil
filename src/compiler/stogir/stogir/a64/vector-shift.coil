;;; Width-masked vector shifts and rotates with bounded SIMD sequences.
(module stogir.a64.vector-shift)
(import "stogir.vector-arithmetic" :as vector)
(import "stogir.types" :as types)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.simd-lanes" :as lanes)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(export emit-registers!)

;;; Internal helpers operate only on validated D/Q arrangements.
(defn normalize! [(out (mut (ArrayList u8)))
                  (element i32)
                  (width i32)
                  (source i32)] (-> void)
  (let [bits (* element 8)
        log
          (if (= element 1)
              (: 3 i32)
              (if (= element 2) 4 (if (= element 4) 5 6)))
        amount (- bits log)
        singleton? (and (= element 8) (= width 8))
        q (if (= width 16) (: 0x40000000 u32) (: 0 u32))]
    (bytes/append32! (mut out)
                     (| (if singleton?
                            (: 0x5F005400 u32)
                            (| q (: 0x0F005400 u32)))
                        (<< (cast u32 (+ bits amount)) 16)
                        (<< (cast u32 source) 5)
                        31))
    (bytes/append32! (mut out)
                     (| (if singleton?
                            (: 0x7F000400 u32)
                            (| q (: 0x2F000400 u32)))
                        (<< (cast u32 (- (* 2 bits) amount)) 16)
                        (<< (: 31 u32) 5)
                        31))))

(defn negate-count! [(out (mut (ArrayList u8)))
                     (singleton? bool)
                     (q u32)
                     (size i32)] (-> void)
  (bytes/append32! (mut out)
                   (| (if singleton?
                          (: 0x7EE0B800 u32)
                          (| q (: 0x2E20B800 u32) (<< (cast u32 size) 22)))
                      (<< (: 31 u32) 5)
                      31)))

(defn shifted! [(out (mut (ArrayList u8)))
                (singleton? bool)
                (q u32)
                (size i32)
                (arithmetic? bool)
                (rd i32)
                (rn i32)] (-> void)
  (bytes/append32! (mut out)
                   (| (if singleton?
                          (if arithmetic? (: 0x5EE04400 u32) (: 0x7EE04400 u32))
                          (| q
                             (<< (cast u32 size) 22)
                             (if arithmetic?
                                 (: 0x0E204400 u32)
                                 (: 0x2E204400 u32))))
                      (<< (: 31 u32) 16)
                      (<< (cast u32 rn) 5)
                      (cast u32 rd))))

;;; v31 is the private count workspace. Rotates also use v30 when the result
;;; aliases its data source; therefore their result cannot be v30/v31.
;;; Count normalization precedes that save, so a private count in v30 is legal.
(defn emit-registers! [(output (mut (ArrayList u8)))
                       (opcode i32)
                       (ty i32)
                       (rd i32)
                       (rn i32)
                       (count i32)
                       (scalar? bool)]
  (-> (Result i32 (slice u8)))
  (if (or (not (vector/shift? opcode))
          (not (vector/valid-type? opcode ty))
          (not (types/short-vector? ty 8))
          (< rd 0)
          (> rd 31)
          (and (vector/rotate? opcode) (>= rd 30))
          (< rn 0)
          (>= rn 31)
          (< count 0)
          (> count (if scalar? 30 31)))
      (Err "invalid AArch64 vector shift shape or reserved-register conflict")
      (let [(mut temporary) (ArrayList::new [u8] (.alc output))
            (mut error) ""
            element (types/scalar-size (types/base-type ty) 8)
            width (types/size ty 8)
            size
              (if (= element 1)
                  (: 0 i32)
                  (if (= element 2) 1 (if (= element 4) 2 3)))
            singleton? (and (= element 8) (= width 8))
            q (if (= width 16) (: 0x40000000 u32) (: 0 u32))]
        (if (and (vector/rotate? opcode) singleton?)
            (do
              ; Read the count first: it may already occupy scratch x16/x17.
              (if scalar?
                  (when (!= count 17)
                    (match (encode/logical-register true 1 17 31 count)
                      (Err [message] (set! error message))
                      (Ok [word] (bytes/append32! (mut temporary) word))))
                  (match (lanes/lane-extract false 8 0 17 count)
                    (Err [message] (set! error message))
                    (Ok [word] (bytes/append32! (mut temporary) word))))
              (match (lanes/lane-extract false 8 0 16 rn)
                (Err [message] (set! error message))
                (Ok [word] (bytes/append32! (mut temporary) word)))
              (when (= opcode 52)
                (match (encode/add-sub true true false 17 31 17)
                  (Err [message] (set! error message))
                  (Ok [word] (bytes/append32! (mut temporary) word))))
              (match (encode/variable-shift true 3 16 16 17)
                (Err [message] (set! error message))
                (Ok [word] (bytes/append32! (mut temporary) word)))
              (match (lanes/lane-insert 8 0 rd 16)
                (Err [message] (set! error message))
                (Ok [word] (bytes/append32! (mut temporary) word))))
            (do
              (when scalar?
                (if singleton?
                    (match (encode/scalar-transfer true true 31 count)
                      (Err [message] (set! error message))
                      (Ok [word] (bytes/append32! (mut temporary) word)))
                    (bytes/append32! (mut temporary)
                                     (| q
                                        (: 0x0E000C00 u32)
                                        (<< (cast u32 element) 16)
                                        (<< (cast u32 count) 5)
                                        31))))
              (normalize! (mut temporary) element width (if scalar? 31 count))
              (if (vector/rotate? opcode)
                  (let [source (if (= rd rn) (: 30 i32) rn)]
                    (when (= rd rn)
                      (match (encode/simd-move width 30 rn)
                        (Err [message] (set! error message))
                        (Ok [word] (bytes/append32! (mut temporary) word))))
                    (when (= opcode 53)
                      (negate-count! (mut temporary) singleton? q size))
                    (shifted! (mut temporary) singleton? q size false rd source)
                    (when (= opcode 52)
                      (negate-count! (mut temporary) singleton? q size))
                    ; (-count) mod element_bits is the complementary shift, including zero.
                    (normalize! (mut temporary) element width 31)
                    (when (= opcode 52)
                      (negate-count! (mut temporary) singleton? q size))
                    (shifted! (mut temporary) singleton? q size false 31 source)
                    (bytes/append32! (mut temporary)
                                     (| q
                                        (: 0x0EA01C00 u32)
                                        (<< (: 31 u32) 16)
                                        (<< (cast u32 rd) 5)
                                        (cast u32 rd))))
                  (do
                    (when (!= opcode 49)
                      (negate-count! (mut temporary) singleton? q size))
                    (shifted! (mut temporary)
                              singleton?
                              q
                              size
                              (= opcode 51)
                              rd
                              rn)))))
        (let [size (cast i32 (len temporary))]
          (when (= error "")
            (extend! (mut output) (.data temporary) (len temporary)))
          (free! (mut temporary))
          (if (= error "") (Ok size) (Err error))))))
