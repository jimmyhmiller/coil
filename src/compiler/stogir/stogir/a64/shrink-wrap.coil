;;; Optional shrink-wrapping: the frameless entry region. A Coil extension; the
;;; pinned upstream emits its whole prologue at entry.
;;;
;;; The region is a set of blocks, closed under predecessors and containing the
;;; entry, whose code never needs the frame. A block qualifies when it makes no
;;; call, addresses no frame storage (it materializes no frame address and
;;; uses no stack scope, VA, TLS or register slot; a static ALLOCA whose address
;;; is only rematerialized at its uses emits nothing), reads no incoming stack
;;; parameter, and while it runs no
;;; allocation part lives in a preserved register (x19..x28) or a spill slot
;;; and no transfer touches a spill slot. Because every path from entry to a
;;; region block stays in the region, such a part would have been written
;;; inside it, before the preserved register was saved or the frame existed.
;;;
;;; Emission then omits the entry prologue, returns from region blocks without
;;; an epilogue, and emits the prologue at the start of every transfer from a
;;; region block to a block outside it, before that edge's moves (see
;;; function.edge!). Edge emptiness tests (empty blocks, quiet projections,
;;; SWITCH stubs) observe that prologue, so no path enters an outside block
;;; without it.
;;;
;;; With frame-split (see allocate/Assigned) there is a second frameless set,
;;; the after region: blocks that qualify as above, closed under successors,
;;; and reached from the entry region through such blocks alone. No path from
;;; one comes back to code that needs the frame, so every transfer into one
;;; from a block that runs with the frame releases it, after that edge's moves
;;; (see function.edge!), and its RETURNs need no epilogue. A path through
;;; both regions never builds the frame; any other path builds it at most once
;;; and releases it at most once, as before. The after region replaces shared
;;; return tails, which are the after-region blocks of a single RETURN.
;;;
;;; Releasing the frame before the RETURN must not be observable. Spill slots
;;; and preserved registers are covered by the block test. Storage whose
;;; address the program holds is not: a pointer into an ALLOCA, a variable or
;;; the frame itself may have been copied anywhere before the frame is
;;; released. So when the function has any such storage (addressable?), an
;;; after-region block may not access memory at all (memory-opcode?); a
;;; function whose frame holds only the compiler's own slots has no such
;;; limit. With that, frame-split also wraps anchored frames (dynamic stack
;;; objects): the release restores the fixed SP like any epilogue.
;;;
;;; ignore-preserved answers whether preserved registers alone stand in the
;;; way: the allocator can then be asked to assign them late and retried.
;;;
;;; The result gives every node's state (see state). An empty result means the
;;; frame is built at entry as before: when the function has no frame, uses an
;;; anchored or over-aligned frame or an in-frame result buffer, or when no
;;; RETURN is reachable without the frame (nothing would be saved).
(module stogir.a64.shrink-wrap)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.schedule" :as schedule)
(import "stogir.locations" :as locations)
(import "stogir.frame" :as frame)
(import "stogir.fill" :as fill)
(import "stogir.a64.allocate" :as allocate)
(import "stogir.a64.constraints" :as constraints)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

;;; Opcodes whose lowering needs the frame or makes a call. A VAR emits nothing
;;; and a static ALLOCA only when its address is materialized (see region).
(defn frame-opcode? [(opcode i32)] (-> bool)
  (or (= opcode 79) (= opcode 80)            ; CALL, TAILCALL
      (= opcode 65) (= opcode 66)            ; VADDR, FRAME_ADDR
      (and (>= opcode 82) (<= opcode 90))    ; AFREE..RSTORE
      (= opcode 95)                          ; TLS_ADDR
      (and (>= opcode 97) (<= opcode 103)))) ; VA_*, GUARD*, SNAPSHOT

;;; Opcodes that create storage in the frame whose address the program holds:
;;; ALLOCA, VADDR, FRAME_ADDR and the variadic cursor operations.
(defn addressable-opcode? [(opcode i32)] (-> bool)
  (or (= opcode 81) (= opcode 65) (= opcode 66)
      (and (>= opcode 97) (<= opcode 100))))

;;; Opcodes that read or write memory through an address held in a value:
;;; LOAD and STORE forms, inline assembly and the atomic operations.
(defn memory-opcode? [(opcode i32)] (-> bool)
  (or (and (>= opcode 91) (<= opcode 94))
      (and (>= opcode 122) (<= opcode 130))))

;;; A frame-address recipe: the value is recomputed from x29 or SP at each use.
(defn frame-recipe? [(assigned allocate/Assigned) (value i32)] (-> bool)
  (and (> value 0)
       (match (locations/rematerialized-location (.locations assigned) value)
         (Some [location] (or (= (.kind location) 2) (= (.kind location) 3)))
         (None [] false))))

(defn has-parts? [(assigned allocate/Assigned) (value i32)] (-> bool)
  (and (>= value 0)
       (< (cast i64 value) (len (.parents (.locations assigned))))
       (> (.count (get (.parents (.locations assigned)) (cast i64 value))) 0)))

(defn preserved? [(register i32)] (-> bool)
  (and (>= register 19) (<= register 28)))

(defn needs-frame? [(assigned allocate/Assigned) (size i64)] (-> bool)
  (or (> size 0) (>= (.link-slot assigned) 0) (!= (.mask (.callee assigned)) 0)))

;;; Whether the entry block itself makes a call, uses a frame operation or reads
;;; a stack parameter. No region exists then, which this settles from the entry
;;; block alone, before anything is built.
(defn entry-needs-frame? [(graph g/Graph)
                          (scheduled schedule/Schedule)
                          (requirements (ArrayList constraints/Value))]
  (-> bool)
  (let [range (get (.ranges scheduled) (cast i64 (get (.nodes scheduled) 0)))
        (mut needed) false]
    (for [k 0 (.count range)]
      (let [reference (get (.nodes scheduled) (+ (.offset range) k))
            opcode (cast i32 (n/opcode (get (.instructions graph) (cast i64 reference))))]
        (when (or (frame-opcode? opcode)
                  (and (= opcode 71)
                       (let [kind (.kind (.parameter (get requirements (cast i64 reference))))]
                         (not (or (= kind 0) (= kind 2))))))
          (set! needed true))))
    needed))

;;; Whether any value is rematerialized as a frame address at its uses.
(defn frame-recipes? [(assigned allocate/Assigned)] (-> bool)
  (let [(mut found) false]
    (let [items-116 (.rematerialized (.locations assigned)) (mut for-index-116) (: 0 i64)] (while (< for-index-116 (len items-116)) (let [entry (get items-116 for-index-116)]
      (when (or (= (.kind (.location entry)) 2) (= (.kind (.location entry)) 3))
        (set! found true))) (set! for-index-116 (+ for-index-116 1))))
    found))

(defn region [(graph g/Graph)
              (scheduled schedule/Schedule)
              (assigned allocate/Assigned)
              (requirements (ArrayList constraints/Value))
              (moves (ArrayList locations/Transfer))
              (ignore-preserved bool)
              (allocator (dyn Allocator))]
  (-> (Result (ArrayList u8) (slice u8)))
  (let [(mut result) (ArrayList::new [u8] allocator)]
    (match (frame/aligned-size (.frame assigned) (.alignment assigned))
      (Err [message] (Err message))
      (Ok [size]
          (if (or (not (needs-frame? assigned size))
                  (>= (.entry-slot assigned) 0)
                  (> (.alignment assigned) 16)
                  (and (!= (.reg (.base assigned)) 31) (not (.frame-split assigned)))
                  (>= (.result-slot assigned) 0)
                  (= (len (.nodes scheduled)) 0)
                  (!= (n/opcode (get (.instructions graph)
                                     (cast i64 (get (.nodes scheduled) 0))))
                      104)
                  (entry-needs-frame? graph scheduled requirements))
              (Ok result)
              (let [count (len (.instructions graph))
                    slots (len (.nodes scheduled))
                    ; block-of: block start reference of each scheduled node.
                    (mut block-of) (ArrayList::new [i32] allocator)
                    ; Per schedule index: >0 while some preserved/stack part lives.
                    (mut pressure) (ArrayList::new [i32] allocator)
                    (mut bad) (ArrayList::new [bool] allocator)
                    (mut inside) (ArrayList::new [bool] allocator)
                    (mut moved) (ArrayList::new [bool] allocator)
                    (mut starts) (ArrayList::new [i32] allocator)
                    entry (get (.nodes scheduled) 0)
                    recipes (frame-recipes? assigned)]
                (fill/append! (mut block-of) count 0)
                (fill/append! (mut bad) count false)
                (fill/append! (mut inside) count false)
                (fill/append! (mut moved) count false)
                (fill/append! (mut pressure) (+ slots 1) 0)
                (let [items-115 (.nodes scheduled) (mut for-index-115) (: 0 i64)] (while (< for-index-115 (len items-115)) (let [reference (get items-115 for-index-115)]
                  (when (op/block-start? (cast i32 (n/opcode (get (.instructions graph) (cast i64 reference)))))
                    (push! (mut starts) reference)
                    (let [range (get (.ranges scheduled) (cast i64 reference))]
                      (for [k 0 (.count range)]
                        (set! (mut block-of)
                              (cast i64 (get (.nodes scheduled) (+ (.offset range) k)))
                              reference))))) (set! for-index-115 (+ for-index-115 1))))
                ; Difference counts over schedule indices for every part held in
                ; a preserved register or a spill slot.
                (let [items-114 (.parts assigned) (mut for-index-114) (: 0 i64)] (while (< for-index-114 (len items-114)) (let [part (get items-114 for-index-114)]
                  (when (or (and (not ignore-preserved) (preserved? (.register part)))
                            (and (< (.register part) 0) (>= (.spill-slot part) 0)))
                    (let [items-113 (.ranges part) (mut for-index-113) (: 0 i64)] (while (< for-index-113 (len items-113)) (let [range (get items-113 for-index-113)]
                      (let [first (/ (.start range) 2)
                            last (/ (- (.end range) 1) 2)]
                        (when (and (>= first 0) (< first slots))
                          (set! (mut pressure) first (+ (get pressure first) 1))
                          (let [stop (if (< (+ last 1) slots) (+ last 1) slots)]
                            (set! (mut pressure) stop (- (get pressure stop) 1)))))) (set! for-index-113 (+ for-index-113 1)))))) (set! for-index-114 (+ for-index-114 1))))
                (let [(mut live) (: 0 i32)]
                  (for [i 0 slots]
                    (set! live (+ live (get pressure i)))
                    (when (> live 0)
                      (set! (mut bad) (cast i64 (get block-of (cast i64 (get (.nodes scheduled) i)))) true))))
                ; A contiguous split at a block's own start is never emitted
                ; there: incoming edges reconcile it (see function.coil). With
                ; frame-split it therefore marks nothing. Without, it keeps
                ; counting, as function.coil's return tails count it: a shared
                ; tail must be a tail there too.
                (let [items-112 moves (mut for-index-112) (: 0 i64)] (while (< for-index-112 (len items-112)) (let [move (get items-112 for-index-112)]
                  (unless (let [index (/ (.position move) 2)]
                            (and (.frame-split assigned)
                                 (= (% (.position move) 2) 0) (>= index 0) (< index slots)
                                 (= (get block-of (cast i64 (get (.nodes scheduled) index)))
                                    (get (.nodes scheduled) index))))
                  (let [index (/ (.position move) 2)]
                    (when (and (>= index 0) (< index slots))
                      (set! (mut moved) (cast i64 (get block-of (cast i64 (get (.nodes scheduled) index)))) true)))
                  (when (or (= (.kind (.source move)) 1)
                            (= (.kind (.source move)) 2)
                            (= (.kind (.source move)) 3)
                            (= (.kind (.destination move)) 1)
                            (and (not ignore-preserved)
                                 (= (.kind (.destination move)) 0)
                                 (preserved? (cast i32 (.value (.destination move))))))
                    (let [index (/ (.position move) 2)]
                      (when (and (>= index 0) (< index slots))
                        (set! (mut bad) (cast i64 (get block-of (cast i64 (get (.nodes scheduled) index)))) true)))))) (set! for-index-112 (+ for-index-112 1))))
                (let [items-111 (.nodes scheduled) (mut for-index-111) (: 0 i64)] (while (< for-index-111 (len items-111)) (let [reference (get items-111 for-index-111)]
                  (let [opcode (cast i32 (n/opcode (get (.instructions graph) (cast i64 reference))))
                        block (get block-of (cast i64 reference))]
                    (when (frame-opcode? opcode) (set! (mut bad) (cast i64 block) true))
                    ; An ALLOCA held in a register computes its address here.
                    (when (and (= opcode 81)
                               (or (has-parts? assigned reference)
                                   (not (frame-recipe? assigned reference))))
                      (set! (mut bad) (cast i64 block) true))
                    ; Any data operand rematerialized as a frame address is
                    ; computed from the frame at this node. Control inputs
                    ; (an ALLOCA in the entry chain) emit nothing.
                    (when recipes
                      (let [arity (cast i64 (get (.arities graph) (cast i64 reference)))]
                        (for [i 1 (+ arity 1)]
                          (match (g/operand graph reference (cast i32 i))
                            (None [] 0)
                            (Some [input]
                                  (when (and (let [code (op/operand-code opcode (cast i32 i))]
                                               ; Control links, and plain numbers (an
                                               ; alignment, a probability, a register,
                                               ; a name) that are not references at all
                                               ; but may equal a recipe's.
                                               (not (or (= code op/OPERAND-SRC) (= code op/OPERAND-LBL)
                                                        (= code 1) (= code 5) (= code 7)
                                                        (= code 10) (= code 13))))
                                             (frame-recipe? assigned input)
                                             (not (has-parts? assigned input)))
                                    (set! (mut bad) (cast i64 block) true)))))))
                    ; Only register parameters are read without the frame.
                    (when (and (= opcode 71)
                               (let [kind (.kind (.parameter (get requirements (cast i64 reference))))]
                                 (not (or (= kind 0) (= kind 2)))))
                      (set! (mut bad) (cast i64 block) true)))) (set! for-index-111 (+ for-index-111 1))))
                ; Region: good blocks all of whose control predecessors are in it.
                (let [items-110 starts (mut for-index-110) (: 0 i64)] (while (< for-index-110 (len items-110)) (let [start (get items-110 for-index-110)]
                  (set! (mut inside) (cast i64 start) (not (get bad (cast i64 start))))) (set! for-index-110 (+ for-index-110 1))))
                (let [(mut changed) true]
                  (while changed
                    (set! changed false)
                    (let [items-109 starts (mut for-index-109) (: 0 i64)] (while (< for-index-109 (len items-109)) (let [start (get items-109 for-index-109)]
                      (when (and (get inside (cast i64 start)) (!= start entry))
                        (let [arity (cast i64 (get (.arities graph) (cast i64 start)))
                              (mut keep) true]
                          (for [i 1 (+ arity 1)]
                            (match (g/operand graph start (cast i32 i))
                              (None [] 0)
                              (Some [input]
                                    (when (and (> input 0)
                                               (< (cast i64 input) count)
                                               (op/control? (cast i32 (n/opcode (get (.instructions graph)
                                                                                     (cast i64 input)))))
                                               (> (get block-of (cast i64 input)) 0)
                                               (not (get inside (cast i64 (get block-of (cast i64 input))))))
                                      (set! keep false)))))
                          (unless keep
                            (set! (mut inside) (cast i64 start) false)
                            (set! changed true))))) (set! for-index-109 (+ for-index-109 1))))))
                ; Shared return tails: good blocks of only PHIs and a RETURN with
                ; no moves, entered by ENDs both inside and outside the region.
                ; Inside ENDs emit the tail in place without the frame.
                (let [(mut shared) (ArrayList::new [bool] allocator)
                      (mut after) (ArrayList::new [bool] allocator)
                      (mut reached) (ArrayList::new [bool] allocator)
                      split (and (.frame-split assigned) (get inside (cast i64 entry)))
                      (mut returns) false]
                  (fill/append! (mut shared) count false)
                  (fill/append! (mut reached) count false)
                  (when split
                    ; After region: good blocks all of whose successors are in
                    ; it. A block outside removes its control predecessors;
                    ; sweeping backward settles all but back edges at once.
                    (fill/append! (mut after) count false)
                    (let [items-108 starts (mut for-index-108) (: 0 i64)] (while (< for-index-108 (len items-108)) (let [start (get items-108 for-index-108)]
                      (set! (mut after) (cast i64 start) (not (get bad (cast i64 start))))) (set! for-index-108 (+ for-index-108 1))))
                    ; Addressable frame storage: no memory access after release.
                    (let [(mut addressable) false]
                      (let [items-107 (.nodes scheduled) (mut for-index-107) (: 0 i64)] (while (< for-index-107 (len items-107)) (let [reference (get items-107 for-index-107)]
                        (when (addressable-opcode?
                                (cast i32 (n/opcode (get (.instructions graph) (cast i64 reference)))))
                          (set! addressable true))) (set! for-index-107 (+ for-index-107 1))))
                      (when addressable
                        (let [items-106 (.nodes scheduled) (mut for-index-106) (: 0 i64)] (while (< for-index-106 (len items-106)) (let [reference (get items-106 for-index-106)]
                          (when (memory-opcode?
                                  (cast i32 (n/opcode (get (.instructions graph) (cast i64 reference)))))
                            (set! (mut after) (cast i64 (get block-of (cast i64 reference))) false))) (set! for-index-106 (+ for-index-106 1))))))
                    (let [(mut changed) true]
                      (while changed
                        (set! changed false)
                        (let [(mut s) (- (len starts) 1)]
                          (while (>= s 0)
                            (let [start (get starts s)]
                              (unless (get after (cast i64 start))
                                (let [arity (cast i64 (get (.arities graph) (cast i64 start)))]
                                  (for [i 1 (+ arity 1)]
                                    (match (g/operand graph start (cast i32 i))
                                      (None [] 0)
                                      (Some [input]
                                            (when (and (> input 0)
                                                       (< (cast i64 input) count)
                                                       (op/control? (cast i32 (n/opcode (get (.instructions graph)
                                                                                             (cast i64 input)))))
                                                       (> (get block-of (cast i64 input)) 0)
                                                       (get after (cast i64 (get block-of (cast i64 input)))))
                                              (set! (mut after) (cast i64 (get block-of (cast i64 input))) false)
                                              (set! changed true))))))))
                            (set! s (- s 1))))))
                    ; Reached: after-region blocks outside the entry region
                    ; with a predecessor in the entry region or already reached.
                    (let [(mut changed) true]
                      (while changed
                        (set! changed false)
                        (let [items-105 starts (mut for-index-105) (: 0 i64)] (while (< for-index-105 (len items-105)) (let [start (get items-105 for-index-105)]
                          (when (and (get after (cast i64 start))
                                     (not (get inside (cast i64 start)))
                                     (not (get reached (cast i64 start))))
                            (let [arity (cast i64 (get (.arities graph) (cast i64 start)))]
                              (for [i 1 (+ arity 1)]
                                (match (g/operand graph start (cast i32 i))
                                  (None [] 0)
                                  (Some [input]
                                        (when (and (> input 0)
                                                   (< (cast i64 input) count)
                                                   (op/control? (cast i32 (n/opcode (get (.instructions graph)
                                                                                         (cast i64 input)))))
                                                   (> (get block-of (cast i64 input)) 0)
                                                   (not (get reached (cast i64 start)))
                                                   (let [from (cast i64 (get block-of (cast i64 input)))]
                                                     (or (get inside from) (get reached from))))
                                          (set! (mut reached) (cast i64 start) true)
                                          (set! changed true)))))))) (set! for-index-105 (+ for-index-105 1)))))))
                  (when (and (not split) (get inside (cast i64 entry)))
                    (let [items-104 starts (mut for-index-104) (: 0 i64)] (while (< for-index-104 (len items-104)) (let [start (get items-104 for-index-104)]
                      (when (and (not (get inside (cast i64 start)))
                                 (not (get bad (cast i64 start)))
                                 (not (get moved (cast i64 start))))
                        (let [range (get (.ranges scheduled) (cast i64 start))
                              last (get (.nodes scheduled) (- (+ (.offset range) (.count range)) 1))
                              arity (cast i64 (get (.arities graph) (cast i64 start)))
                              (mut tail) (and (>= (.count range) 2)
                                              (= (n/opcode (get (.instructions graph) (cast i64 last))) 120))
                              (mut from-inside) false
                              (mut from-outside) false]
                          (for [k 1 (- (.count range) 1)]
                            (unless (= (n/opcode (get (.instructions graph)
                                                      (cast i64 (get (.nodes scheduled) (+ (.offset range) k)))))
                                       67)
                              (set! tail false)))
                          (for [i 1 (+ arity 1)]
                            (match (g/operand graph start (cast i32 i))
                              (None [] 0)
                              (Some [input]
                                    (when (and (> input 0) (< (cast i64 input) count)
                                               (op/control? (cast i32 (n/opcode (get (.instructions graph)
                                                                                     (cast i64 input))))))
                                      (if (and (= (n/opcode (get (.instructions graph) (cast i64 input))) 114)
                                               (> (get block-of (cast i64 input)) 0))
                                          (if (get inside (cast i64 (get block-of (cast i64 input))))
                                              (set! from-inside true)
                                              (set! from-outside true))
                                          (set! tail false))))))
                          (when (and tail from-inside from-outside)
                            (set! (mut shared) (cast i64 start) true)
                            (set! returns true))))) (set! for-index-104 (+ for-index-104 1))))
                    (let [items-103 (.nodes scheduled) (mut for-index-103) (: 0 i64)] (while (< for-index-103 (len items-103)) (let [reference (get items-103 for-index-103)]
                      (when (and (= (n/opcode (get (.instructions graph) (cast i64 reference))) 120)
                                 (get inside (cast i64 (get block-of (cast i64 reference)))))
                        (set! returns true))) (set! for-index-103 (+ for-index-103 1)))))
                  (when split
                    (let [items-102 (.nodes scheduled) (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [reference (get items-102 for-index-102)]
                      (when (and (= (n/opcode (get (.instructions graph) (cast i64 reference))) 120)
                                 (let [block (cast i64 (get block-of (cast i64 reference)))]
                                   (or (get inside block) (get reached block))))
                        (set! returns true))) (set! for-index-102 (+ for-index-102 1)))))
                  (when returns
                    (fill/append! (mut result) count (: 0 u8))
                    (let [items-101 (.nodes scheduled) (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [reference (get items-101 for-index-101)]
                      (let [block (cast i64 (get block-of (cast i64 reference)))]
                        (cond (get inside block) (set! (mut result) (cast i64 reference) (: 1 u8))
                              (get shared block) (set! (mut result) (cast i64 reference) (: 2 u8))
                              (get reached block) (set! (mut result) (cast i64 reference) (: 3 u8))
                              :else 0))) (set! for-index-101 (+ for-index-101 1)))))
                  (free! (mut shared)) (free! (mut after)) (free! (mut reached)))
                (free! (mut block-of)) (free! (mut pressure)) (free! (mut bad))
                (free! (mut inside)) (free! (mut starts)) (free! (mut moved))
                (Ok result)))))))

;;; Region state of reference R: 0 outside (or disabled), 1 inside, 2 a shared
;;; return tail that inside ENDs emit in place, 3 in the after region.
(defn state [(region (slice u8)) (r i32)] (-> u8)
  (if (and (> (len region) 0) (> r 0) (< (cast i64 r) (len region)))
      (get region (cast i64 r)) (: 0 u8)))

(defn frameless? [(region (slice u8)) (r i32)] (-> bool) (= (state region r) 1))

(defn shared-tail? [(region (slice u8)) (r i32)] (-> bool) (= (state region r) 2))

(defn after? [(region (slice u8)) (r i32)] (-> bool) (= (state region r) 3))

;;; Whether R runs without the frame: in the entry region or the after region.
(defn unframed? [(region (slice u8)) (r i32)] (-> bool)
  (let [s (state region r)] (or (= s 1) (= s 3))))
