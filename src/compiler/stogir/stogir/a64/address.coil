;;; Constant base/offset address selection, following upstream
;;; ir_aarch64.dasc:ir_match_fuse_addr. The semantic graph is never changed.
(module stogir.a64.address)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "coil.result" :use [Option Some None])

(defstruct Address [(base i32) (offset i64)])

(defn encodable? [(width i32) (offset i64)] (-> bool)
  (and (or (= width 1) (= width 2) (= width 4) (= width 8) (= width 16))
       (or (and (>= offset -256) (<= offset 255))
           (and (>= offset 0)
                (= (% offset (cast i64 width)) 0)
                (<= (/ offset (cast i64 width)) 4095)))))

;;; Only a direct ADDR ADD with a 64-bit numeric offset may be absorbed.
;;; COPY (including HARD), symbols, and nonconstant offsets remain explicit.
(defn select [(graph g/Graph) (reference i32) (width i32)]
  (-> (Option Address))
  (match (g/lookup graph reference)
    (None [] (None))
    (Some [node]
          (if (and (> reference 0)
                   (= (n/opcode node) 26)
                   (= (n/type-id node) 6)
                   (> (.op1 node) 0)
                   (< (.op2 node) 0))
              (match (g/lookup graph (.op1 node))
                (None [] (None))
                (Some [base]
                      (if (= (n/type-id base) 6)
                          (match (g/lookup graph (.op2 node))
                            (None [] (None))
                            (Some [literal]
                                  (let [offset
                                          (cast i64 (n/constant-bits literal))]
                                    (if (and (>= (n/opcode literal) 1)
                                             (<= (n/opcode literal) 13)
                                             (or (= (n/type-id literal) 5)
                                                 (= (n/type-id literal) 11))
                                             (encodable? width offset))
                                        (Some (Address
                                                :base (.op1 node)
                                                :offset offset))
                                        (None)))))
                          (None))))
              (None)))))
