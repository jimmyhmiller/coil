;;; Constant base/offset address selection, following upstream
;;; ir_aarch64.dasc:ir_match_fuse_addr. The semantic graph is never changed.
(module stogir.a64.address)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.symbols" :as symbols)
(import "stogir.a64.select" :as arithmetic)
(import "coil.result" :use [Option Some None Ok Err])

(defstruct Address [(base i32) (offset i64)])

(defn encodable? [(width i32) (offset i64)] (-> bool)
  (and (or (= width 1) (= width 2) (= width 4) (= width 8) (= width 16))
       (or (and (>= offset -256) (<= offset 255))
           (and (>= offset 0)
                (= (% offset (cast i64 width)) 0)
                (<= (/ offset (cast i64 width)) 4095)))))

(defn word? [(ty u8)] (-> bool)
  (or (= ty 5) (= ty 6) (= ty 11)))

;;; Full-width integer/address views preserve every address bit. COPY remains
;;; an explicit scheduling barrier. Bound traversal of adversarial cast chains.
(defn base-view [(graph g/Graph) (reference i32)] (-> i32)
  (let [(mut current) reference
        (mut depth) 0
        (mut done) false]
    (while (and (not done) (< depth 16))
      (match (g/lookup graph current)
        (Some [node]
              (if (and (> current 0)
                       (= (n/opcode node) 36)
                       (word? (n/type-id node))
                       (> (.op1 node) 0))
                  (match (g/lookup graph (.op1 node))
                    (Some [source]
                          (if (word? (n/type-id source))
                              (set! current (.op1 node))
                              (set! done true)))
                    (None [] (set! done true)))
                  (set! done true)))
        (None [] (set! done true)))
      (set! depth (+ depth 1)))
    current))

(defn numeric-word [(graph g/Graph) (constant i32)] (-> (Option i64))
  (if (>= constant 0)
      (None)
      (match (g/lookup graph constant)
        (None [] (None))
        (Some [literal]
              (if (and (word? (n/type-id literal)) (symbols/numeric? literal))
                  (Some (cast i64 (n/constant-bits literal)))
                  (None))))))

;;; Independent extension of the pinned one-level matcher: nested field
;;; addresses ADD(ADD(x, C1), C2) fold to [x, #C1+C2] while the total stays
;;; encodable. The caller's use counts retire intermediate ADDs only when every
;;; one of their uses was absorbed, so shared inner addresses stay live.
(defn pair [(graph g/Graph) (base i32) (constant i32) (width i32)]
  (-> (Option Address))
  (let [(mut source) (base-view graph base)
        (mut total) (: 0 i64)
        (mut good) (> source 0)]
    (match (numeric-word graph constant)
      (None [] (set! good false))
      (Some [offset] (set! total offset)))
    (when good
      (match (g/lookup graph source)
        (None [] (set! good false))
        (Some [node] (unless (word? (n/type-id node)) (set! good false)))))
    (let [(mut depth) 0 (mut done) (not good)]
      (while (and (not done) (< depth 8))
        (match (g/lookup graph source)
          (None [] (set! done true))
          (Some [node]
                (if (and (= (n/opcode node) 26) (word? (n/type-id node)))
                    (let [left (base-view graph (.op1 node))
                          right (base-view graph (.op2 node))
                          (mut next) (: 0 i32)
                          (mut added) (: 0 i64)]
                      (match (numeric-word graph (.op2 node))
                        (Some [offset] (set! next left) (set! added offset))
                        (None []
                          (match (numeric-word graph (.op1 node))
                            (Some [offset] (set! next right) (set! added offset))
                            (None [] 0))))
                      (if (and (> next 0)
                               (match (g/lookup graph next)
                                 (Some [inner] (word? (n/type-id inner)))
                                 (None [] false))
                               (encodable? width (+ total added)))
                          (do (set! source next) (set! total (+ total added)))
                          (set! done true)))
                    (set! done true))))
        (set! depth (+ depth 1))))
    (if (and good (encodable? width total))
        (Some (Address :base source :offset total))
        (None))))

;;; Match Coil's word ADD followed by an address view as well as ADDR ADD.
;;; Named symbols carry string IDs, never numeric displacement bits.
(defn select [(graph g/Graph) (reference i32) (width i32)]
  (-> (Option Address))
  (let [source (base-view graph reference)]
    (match (g/lookup graph source)
      (None [] (None))
      (Some [node]
            (if (and (> source 0)
                     (= (n/opcode node) 26)
                     (word? (n/type-id node)))
                (match (pair graph (.op1 node) (.op2 node) width)
                  (Some [chosen] (Some chosen))
                  (None [] (pair graph (.op2 node) (.op1 node) width)))
                (None))))))

;;; Independent target extension beyond pinned upstream's constant-only matcher.
;;; Both inputs are full-word SSA values. The caller substitutes these operands
;;; before liveness and retires absorbed definitions only when all uses vanish.
(defstruct Indexed [(base i32) (index i32) (shift i32)])

(defn scale [(width i32)] (-> i32)
  (case width 1 0 2 1 4 2 8 3 16 4 -1))

(defn word-shift [(graph g/Graph) (reference i32)] (-> (Option arithmetic/Tile))
  (match (g/lookup graph reference)
    (None [] (None))
    (Some [node]
      (if (and (> reference 0) (word? (n/type-id node))
               (or (= (n/opcode node) 28) (= (n/opcode node) 49)
                   (= (n/opcode node) 50) (= (n/opcode node) 51)))
          (match (arithmetic/select graph reference)
            (Err [_] (None))
            (Ok [tile]
              (if (and (.wide tile) (>= (.rule tile) 38) (<= (.rule tile) 40)
                       (> (.left tile) 0)) (Some tile) (None))))
          (None)))))

(defn register-pair [(graph g/Graph) (base i32) (index i32) (width i32)]
  (-> (Option Indexed))
  (let [left (base-view graph base) right (base-view graph index)]
    (if (or (<= left 0) (<= right 0) (< (scale width) 0)) (None)
        (match (g/lookup graph left)
          (None [] (None))
          (Some [base-node]
            (match (g/lookup graph right)
              (None [] (None))
              (Some [index-node]
                (if (not (and (word? (n/type-id base-node))
                              (word? (n/type-id index-node)))) (None)
                    (match (word-shift graph right)
                      ; Existing shifted-ADD can absorb these arithmetic tiles.
                      ; Do not force an extra shift merely to select a load.
                      (Some [tile]
                        (if (and (= (.rule tile) 38)
                                 (= (.immediate tile) (cast u64 (scale width))))
                            (Some (Indexed :base left :index (.left tile) :shift (scale width)))
                            (None)))
                      (None [] (Some (Indexed :base left :index right :shift 0))))))))))))

(defn select-indexed [(graph g/Graph) (reference i32) (width i32)]
  (-> (Option Indexed))
  (let [source (base-view graph reference)]
    (match (g/lookup graph source)
      (None [] (None))
      (Some [node]
        (if (and (> source 0) (= (n/opcode node) 26) (word? (n/type-id node)))
            (let [left (base-view graph (.op1 node)) right (base-view graph (.op2 node))]
              ; ADD is commutative. A selected shift belongs in the index field,
              ; irrespective of the original source operand ordering.
              (match (word-shift graph left)
                (Some [_]
                  (match (register-pair graph right left width)
                    (Some [chosen] (Some chosen))
                    (None []
                      (match (word-shift graph right)
                        (Some [_] (register-pair graph left right width))
                        (None [] (None))))))
                (None [] (register-pair graph left right width))))
            (None))))))
