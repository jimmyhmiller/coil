;;; Internal branch fixups in byte-offset space, independent of load address.
(module stogir.a64.fixups)
(import "stogir.fill" :as fill)
(import "stogir.a64.encode" :as e)
(import "stogir.bytes" :as bytes)
(import "stogir.a64.code" :as code)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defstruct Branch [(offset i64) (label i32) (condition i32) (link bool)])

;;; condition=-1 selects B/BL; 0..15 selects B.cond, 64..191 CBZ/CBNZ
;;; (encode/register-condition) and 256..4351 TBZ/TBNZ (encode/bit-condition).
;;; Labels contain
;;; section-relative byte offsets, with -1 meaning unbound.
;;; Validate every patch before mutation, so failure leaves output unchanged.
(defn apply! [(output (mut (ArrayList u8)))
              (labels (ArrayList i64))
              (branches (ArrayList Branch))] (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut checked) (: 0 i32)]
    (let [items-129 branches (mut for-index-129) (: 0 i64)] (while (< for-index-129 (len items-129)) (let [branch (get items-129 for-index-129)]
      (when (= error "")
        (if (or (< (.offset branch) 0)
                (> (.offset branch) (- (len output) 4))
                (!= (% (.offset branch) 4) 0)
                (< (.label branch) 0)
                (>= (cast i64 (.label branch)) (len labels)))
            (set! error "invalid branch fixup offset or label")
            (let [target (get labels (cast i64 (.label branch)))]
              (if (or (< target 0)
                      (> target (len output))
                      (!= (% target 4) 0)
                      (and (!= (.condition branch) -1) (.link branch)))
                  (set! error
                        "unbound/invalid branch target or conditional link")
                  (match (if (= (.condition branch) -1)
                             (e/branch (.link branch)
                                       (- target (.offset branch)))
                             (e/predicate-branch (.condition branch)
                                                 (- target (.offset branch))))
                    (Err [msg] (set! error msg))
                    (Ok [_] (set! checked (+ checked 1))))))))) (set! for-index-129 (+ for-index-129 1))))
    (if (!= error "")
        (Err error)
        (do
          (let [items-128 branches (mut for-index-128) (: 0 i64)] (while (< for-index-128 (len items-128)) (let [branch (get items-128 for-index-128)]
            (let [target (get labels (cast i64 (.label branch)))]
              (match (if (= (.condition branch) -1)
                         (e/branch (.link branch) (- target (.offset branch)))
                         (e/predicate-branch (.condition branch)
                                             (- target (.offset branch))))
                (Err [_] 0)
                (Ok [word]
                    (do (bytes/patch32! (mut output) (.offset branch) word) 0))))) (set! for-index-128 (+ for-index-128 1))))
          (Ok checked)))))

;;; Signed word at offset holds target-base. Both addresses are text-relative;
;;; the table stays position independent in raw JIT text and linked objects.
(defstruct Relative [(offset i64) (base i64) (label i32)])

(defn apply-relative! [(output (mut (ArrayList u8)))
                       (labels (ArrayList i64))
                       (records (ArrayList Relative))]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""]
    (let [items-127 records (mut for-index-127) (: 0 i64)] (while (< for-index-127 (len items-127)) (let [record (get items-127 for-index-127)]
      (if (or (< (.offset record) 0)
              (> (.offset record) (- (len output) 4))
              (!= (% (.offset record) 4) 0)
              (< (.base record) 0)
              (>= (.base record) (len output))
              (!= (% (.base record) 4) 0)
              (< (.label record) 0)
              (>= (cast i64 (.label record)) (len labels)))
          (set! error "invalid relative table patch bounds")
          (let [target (get labels (cast i64 (.label record)))]
            (when (or (< target 0)
                      (> target (len output))
                      (!= (% target 4) 0)
                      (< (- target (.base record)) -2147483648)
                      (> (- target (.base record)) 2147483647))
              (set! error "unbound or out-of-range relative table target"))))) (set! for-index-127 (+ for-index-127 1))))
    (if (!= error "")
        (Err error)
        (do
          (let [items-126 records (mut for-index-126) (: 0 i64)] (while (< for-index-126 (len items-126)) (let [record (get items-126 for-index-126)]
            (bytes/patch32! (mut output)
                            (.offset record)
                            (cast u32
                                  (- (get labels (cast i64 (.label record)))
                                     (.base record))))) (set! for-index-126 (+ for-index-126 1))))
          (Ok (cast i32 (len records)))))))

;;; A direct B.cond or CBZ/CBNZ has a smaller reach than B, and TBZ/TBNZ a
;;; smaller one still (encode/predicate-reach?). Expand only distant predicates
;;; into inverse B.cond +8 / B target. The common near case allocates nothing.
;;; Far expansion is transactional: the original buffer and all offset metadata
;;; survive any failure unchanged. Final application can safely be repeated.
(defn relax! [(output (mut code/Buffer))
              (labels (mut (ArrayList i64)))
              (branches (mut (ArrayList Branch)))
              (relatives (mut (ArrayList Relative)))]
  (-> (Result i32 (slice u8)))
  (let [(mut alignment) (ArrayList::new [i32] (.alc labels))
        result
          (relax-aligned! (mut output)
                          (mut labels)
                          (mut branches)
                          (mut relatives)
                          alignment)]
    (free! (mut alignment))
    result))

(defn relax-aligned! [(output (mut code/Buffer))
                      (labels (mut (ArrayList i64)))
                      (branches (mut (ArrayList Branch)))
                      (relatives (mut (ArrayList Relative)))
                      (alignment (ArrayList i32))]
  (-> (Result i32 (slice u8)))
  (let [(mut far) false
        (mut error) ""
        size (len (.text output))]
    (let [items-125 branches (mut for-index-125) (: 0 i64)] (while (< for-index-125 (len items-125)) (let [branch (get items-125 for-index-125)]
      (if (or (< (.offset branch) 0)
              (> (.offset branch) (- size 4))
              (!= (% (.offset branch) 4) 0)
              (< (.label branch) 0)
              (>= (cast i64 (.label branch)) (len labels))
              (and (!= (.condition branch) -1)
                   (not (e/branch-condition? (.condition branch))))
              (and (!= (.condition branch) -1) (.link branch)))
          (set! error "invalid branch layout record")
          (let [target (get labels (cast i64 (.label branch)))
                delta (- target (.offset branch))]
            (if (or (< target 0) (> target size) (!= (% target 4) 0))
                (set! error "invalid branch layout target")
                (when (and (>= (.condition branch) 0)
                           (not (e/predicate-reach? (.condition branch) delta)))
                  (if (and (> (.condition branch) 13) (< (.condition branch) 16))
                      (set! error
                            "cannot relax an unconditional condition code")
                      (set! far true))))))) (set! for-index-125 (+ for-index-125 1))))
    (let [items-124 labels (mut for-index-124) (: 0 i64)] (while (< for-index-124 (len items-124)) (let [label (get items-124 for-index-124)]
      (when (or (< label -1)
                (> label size)
                (and (>= label 0) (!= (% label 4) 0)))
        (set! error "invalid branch layout label"))) (set! for-index-124 (+ for-index-124 1))))
    (when (> (len alignment) (len labels))
      (set! error "too many block alignment records"))
    (for [i 0 (len alignment)]
      (let [value (get alignment i)]
        (if (or (< value 4) (> value 256) (!= (& value (- value 1)) 0))
            (set! error "invalid block alignment")
            (when (< i (len labels))
              (let [label (get labels i)]
                (when (>= label 0)
                  (when (!= (% label (cast i64 value)) 0) (set! far true))
                  (when (> value 4)
                    (let [items-123 (.text-data output) (mut for-index-123) (: 0 i64)] (while (< for-index-123 (len items-123)) (let [range (get items-123 for-index-123)]
                      (when (and (>= label (.offset range))
                                 (< label (+ (.offset range) (.length range))))
                        (set! error
                              "block alignment label overlaps inline data"))) (set! for-index-123 (+ for-index-123 1))))
                    (let [items-122 (.references output) (mut for-index-122) (: 0 i64)] (while (< for-index-122 (len items-122)) (let [reference (get items-122 for-index-122)]
                      (when (and (> label (.offset reference))
                                 (< label (+ (.offset reference) 4)))
                        (set! error
                              "block alignment splits a relocation instruction"))) (set! for-index-122 (+ for-index-122 1)))))))))))
    (if (!= error "")
        (Err error)
        (if (not far)
            (do
              (let [items-121 alignment (mut for-index-121) (: 0 i64)] (while (< for-index-121 (len items-121)) (let [value (get items-121 for-index-121)]
                (when (> (cast i64 value) (.alignment output))
                  (set! (.alignment output) (cast i64 value)))) (set! for-index-121 (+ for-index-121 1))))
              (Ok 0))
            (let [allocator (.alc (.text output))
                  (mut expanded) (code/create allocator)
                  (mut new-labels) (ArrayList::new [i64] (.alc labels))
                  (mut new-branches) (ArrayList::new [Branch] (.alc branches))
                  (mut new-relatives)
                    (ArrayList::new [Relative] (.alc relatives))]
              (let [items-120 labels (mut for-index-120) (: 0 i64)] (while (< for-index-120 (len items-120)) (let [label (get items-120 for-index-120)] (push! (mut new-labels) label)) (set! for-index-120 (+ for-index-120 1))))
              (let [items-119 branches (mut for-index-119) (: 0 i64)] (while (< for-index-119 (len items-119)) (let [branch (get items-119 for-index-119)] (push! (mut new-branches) branch)) (set! for-index-119 (+ for-index-119 1))))
              (let [items-118 relatives (mut for-index-118) (: 0 i64)] (while (< for-index-118 (len items-118)) (let [relative (get items-118 for-index-118)] (push! (mut new-relatives) relative)) (set! for-index-118 (+ for-index-118 1))))
              (let [result
                      (if (code/append! (mut expanded) output)
                          (relax-copy-aligned! (mut expanded)
                                               (mut new-labels)
                                               (mut new-branches)
                                               (mut new-relatives)
                                               alignment)
                          (Err [i32 (slice u8)]
                               "invalid code metadata during branch relaxation"))]
                (match result
                  (Err [_]
                       (code/release! (mut expanded))
                       (free! (mut new-labels))
                       (free! (mut new-branches))
                       (free! (mut new-relatives)))
                  (Ok [_]
                      (code/release! (mut output))
                      (free! (mut labels))
                      (free! (mut branches))
                      (free! (mut relatives))
                      (store! (mut output) expanded)
                      (store! (mut labels) new-labels)
                      (store! (mut branches) new-branches)
                      (store! (mut relatives) new-relatives)))
                result))))))

;;; Compute a monotone layout to a fixed point, then copy bytes only once.
;;; Branch records may be unordered. Prefix entries map original word boundaries
;;; to their growth; no allocation position or graph reference is renumbered.
(defn relax-copy! [(output (mut code/Buffer))
                   (labels (mut (ArrayList i64)))
                   (branches (mut (ArrayList Branch)))
                   (relatives (mut (ArrayList Relative)))]
  (-> (Result i32 (slice u8)))
  (let [(mut alignment) (ArrayList::new [i32] (.alc labels))
        result
          (relax-copy-aligned! (mut output)
                               (mut labels)
                               (mut branches)
                               (mut relatives)
                               alignment)]
    (free! (mut alignment))
    result))

(defn relax-copy-aligned! [(output (mut code/Buffer))
                           (labels (mut (ArrayList i64)))
                           (branches (mut (ArrayList Branch)))
                           (relatives (mut (ArrayList Relative)))
                           (alignment (ArrayList i32))]
  (-> (Result i32 (slice u8)))
  (let [allocator (.alc (.text output))
        size (len (.text output))
        (mut branch-at) (ArrayList::new [i64] allocator)
        (mut prefix) (ArrayList::new [i64] allocator)
        (mut boundary-alignment) (ArrayList::new [i32] allocator)
        (mut expanded) (ArrayList::new [bool] allocator)
        (mut error) ""
        (mut count) (: 0 i32)
        (mut changed) true]
    (fill/append! (mut branch-at) (+ (/ size 4) 1) -1)
    (extend-zeroed! (mut prefix) (+ (/ size 4) 1))
    (fill/append! (mut boundary-alignment) (+ (/ size 4) 1) 4)
    (for [i 0 (len alignment)]
      (let [label (get labels i)]
        (when (>= label 0)
          (let [word (/ label 4)
                value (get alignment i)]
            (when (> value (get boundary-alignment word))
              (set! (mut boundary-alignment) word value))))))
    (extend-zeroed! (mut expanded) (len branches))
    (for [index 0 (len branches)]
      (let [slot (/ (.offset (get branches index)) 4)]
        (when (>= (get branch-at slot) 0)
          (set! error "overlapping branch layout records"))
        (set! (mut branch-at) slot index)))
    (let [items-117 (.text-data output) (mut for-index-117) (: 0 i64)] (while (< for-index-117 (len items-117)) (let [range (get items-117 for-index-117)]
      (for [word
            (/ (.offset range) 4)
            (/ (+ (.offset range) (.length range) 3) 4)]
        (when (>= (get branch-at word) 0)
          (set! error "branch overlaps text data")))) (set! for-index-117 (+ for-index-117 1))))
    ; Each relocation names one instruction. ADRP/PAGEOFF pairs have separate
    ; records, and a direct-call relocation also covers exactly one word.
    (let [items-116 (.references output) (mut for-index-116) (: 0 i64)] (while (< for-index-116 (len items-116)) (let [reference (get items-116 for-index-116)]
      (let [word (/ (.offset reference) 4)]
        (when (and (< word (len branch-at)) (>= (get branch-at word) 0))
          (set! error "branch overlaps a relocation instruction")))) (set! for-index-116 (+ for-index-116 1))))
    ; Validate table bounds before using any table offset as a prefix index.
    (match (apply-relative! (mut (.text output)) labels relatives)
      (Err [message] (set! error message))
      (Ok [_]
          (let [items-115 relatives (mut for-index-115) (: 0 i64)] (while (< for-index-115 (len items-115)) (let [relative (get items-115 for-index-115)]
            (when (>= (get branch-at (/ (.offset relative) 4)) 0)
              (set! error "branch overlaps a relative table word"))) (set! for-index-115 (+ for-index-115 1))))))
    (while (and changed (= error ""))
      (set! changed false)
      (let [(mut growth) (: 0 i64)]
        (for [word 0 (len prefix)]
          (when (> word 0)
            (let [index (get branch-at (- word 1))]
              (when (and (>= index 0) (get expanded index))
                (set! growth (+ growth 4)))))
          (let [align (cast i64 (get boundary-alignment word))
                remainder (% (+ (* word 4) growth) align)]
            (when (!= remainder 0) (set! growth (+ growth (- align remainder)))))
          (set! (mut prefix) word growth)))
      (for [index 0 (len branches)]
        (let [branch (get branches index)
              old-target (get labels (cast i64 (.label branch)))
              offset (+ (.offset branch) (get prefix (/ (.offset branch) 4)))
              target (+ old-target (get prefix (/ old-target 4)))
              delta (- target offset)]
          (when (and (not (get expanded index))
                     (>= (.condition branch) 0)
                     (not (e/predicate-reach? (.condition branch) delta)))
            (if (and (> (.condition branch) 13) (< (.condition branch) 16))
                (set! error "cannot relax an unconditional condition code")
                (do
                  (set! (mut expanded) index true)
                  (set! count (+ count 1))
                  (set! changed true)))))))
    (when (= error "")
      (let [(mut text) (ArrayList::new [u8] allocator)]
        (reserve! (mut text) (+ size (get prefix (/ size 4))))
        (for [word 0 (/ size 4)]
          (while (< (len text) (+ (* word 4) (get prefix word)))
            (bytes/append32! (mut text) 0xD503201F))
          (let [index (get branch-at word)]
            (if (and (>= index 0) (get expanded index))
                (do
                  (match (e/predicate-branch (^ (.condition (get branches
                                                                   index))
                                                  1)
                                               8)
                    (Err [message] (set! error message))
                    (Ok [instruction] (bytes/append32! (mut text) instruction)))
                  (bytes/append32! (mut text) 0))
                (for [byte (* word 4) (+ (* word 4) 4)]
                  (push! (mut text) (get (.text output) byte))))))
        (while (< (len text) (+ (* (/ size 4) 4) (get prefix (/ size 4))))
          (bytes/append32! (mut text) 0xD503201F))
        (for [byte (* (/ size 4) 4) size]
          (push! (mut text) (get (.text output) byte)))
        (free! (mut (.text output)))
        (store! (mut (.text output)) text))
      (for [i 0 (len labels)]
        (let [offset (get labels i)]
          (when (>= offset 0)
            (set! (mut labels) i (+ offset (get prefix (/ offset 4)))))))
      (for [i 0 (len branches)]
        (let [branch (elem (mut branches) i)
              offset (.offset branch)]
          (set! (.offset branch)
                (+ offset (get prefix (/ offset 4)) (if (get expanded i) 4 0)))
          (when (get expanded i) (set! (.condition branch) -1))))
      (for [i 0 (len (.references output))]
        (let [reference (elem (mut (.references output)) i)
              offset (.offset reference)]
          (set! (.offset reference) (+ offset (get prefix (/ offset 4))))))
      (for [i 0 (len (.text-data output))]
        (let [range (elem (mut (.text-data output)) i)
              offset (.offset range)]
          (set! (.offset range) (+ offset (get prefix (/ offset 4))))))
      (for [i 0 (len relatives)]
        (let [relative (elem (mut relatives) i)
              offset (.offset relative)
              base (.base relative)]
          (set! (.offset relative) (+ offset (get prefix (/ offset 4))))
          (set! (.base relative) (+ base (get prefix (/ base 4))))))
      (match (apply! (mut (.text output)) labels branches)
        (Err [message] (set! error message))
        (Ok [_] 0))
      (when (= error "")
        (match (apply-relative! (mut (.text output)) labels relatives)
          (Err [message] (set! error message))
          (Ok [_] 0))))
    (when (= error "")
      (let [items-114 alignment (mut for-index-114) (: 0 i64)] (while (< for-index-114 (len items-114)) (let [value (get items-114 for-index-114)]
        (when (> (cast i64 value) (.alignment output))
          (set! (.alignment output) (cast i64 value)))) (set! for-index-114 (+ for-index-114 1)))))
    (free! (mut expanded))
    (free! (mut boundary-alignment))
    (free! (mut prefix))
    (free! (mut branch-at))
    (if (= error "") (Ok count) (Err error))))

;;; Adjacent LDR/STR (unsigned scaled offset, both 32- or both 64-bit GPR) or
;;; LDRSW of the same base at consecutive slots, in either order, become one
;;; LDP/STP/LDPSW at the lower slot followed by a NOP. A
;;; label on the second word, a relocation or inline data on either word, or
;;; (for loads) a first destination that is the base or equals the second keeps
;;; both words. Runs once per function after every label is bound; the word
;;; index of every NOP it writes is appended to removed for compaction.
(defn pair-word [(first u32) (second u32)] (-> u32)
  (let [kind (& first (: 0xFFC00000 u32))
        rt1 (& first (: 31 u32))
        rt2 (& second (: 31 u32))
        rn (& (>> first 5) (: 31 u32))
        imm1 (& (>> first 10) (: 0xFFF u32))
        imm2 (& (>> second 10) (: 0xFFF u32))
        signed (= kind (: 0xB9800000 u32))
        load (or (= kind (: 0xF9400000 u32)) (= kind (: 0xB9400000 u32)) signed)
        wide (or (= kind (: 0xF9000000 u32)) (= kind (: 0xF9400000 u32)))
        pairable (or (= kind (: 0xF9000000 u32)) (= kind (: 0xF9400000 u32))
                     (= kind (: 0xB9000000 u32)) (= kind (: 0xB9400000 u32)) signed)]
    (if (or (not pairable)
            (!= (& second (: 0xFFC00000 u32)) kind)
            (!= (& (>> second 5) (: 31 u32)) rn)
            (and (!= imm2 (+ imm1 1)) (!= imm1 (+ imm2 1)))
            (and load (or (= rt1 rn) (= rt1 rt2) (= rt1 31) (= rt2 31))))
        0
        ; The two accesses are disjoint and neither changes the base before
        ; the other reads it, so the lower slot may name either word's register.
        (let [ascending (= imm2 (+ imm1 1))
              low (if ascending imm1 imm2)]
          (if (> low 63)
              0
              (| (if wide
                     (if load (: 0xA9400000 u32) (: 0xA9000000 u32))
                     (if signed (: 0x69400000 u32)
                         (if load (: 0x29400000 u32) (: 0x29000000 u32))))
                 (<< low 15)
                 (<< (if ascending rt2 rt1) 10)
                 (<< rn 5)
                 (if ascending rt1 rt2)))))))

(defn read-word [(text (ArrayList u8)) (at i64)] (-> u32)
  (| (cast u32 (get text at))
     (<< (cast u32 (get text (+ at 1))) 8)
     (<< (cast u32 (get text (+ at 2))) 16)
     (<< (cast u32 (get text (+ at 3))) 24)))

(defn pair-adjacent! [(output (mut code/Buffer)) (labels (ArrayList i64))
                      (removed (mut (ArrayList i64)))]
  (-> i32)
  (let [size (len (.text output))
        words (/ size 4)
        allocator (.alc (.text output))
        (mut blocked) (ArrayList::new [bool] allocator)
        (mut entered) (ArrayList::new [bool] allocator)
        (mut pairs) (: 0 i32)]
    (extend-zeroed! (mut blocked) (+ words 1))
    (extend-zeroed! (mut entered) (+ words 1))
    (let [items-113 labels (mut for-index-113) (: 0 i64)] (while (< for-index-113 (len items-113)) (let [label (get items-113 for-index-113)]
      (when (and (>= label 0) (< label size) (= (% label 4) 0))
        (set! (mut entered) (/ label 4) true))) (set! for-index-113 (+ for-index-113 1))))
    (let [items-112 (.references output) (mut for-index-112) (: 0 i64)] (while (< for-index-112 (len items-112)) (let [reference (get items-112 for-index-112)]
      (when (and (>= (.offset reference) 0) (< (.offset reference) size))
        (set! (mut blocked) (/ (.offset reference) 4) true))) (set! for-index-112 (+ for-index-112 1))))
    (let [items-111 (.text-data output) (mut for-index-111) (: 0 i64)] (while (< for-index-111 (len items-111)) (let [range (get items-111 for-index-111)]
      (for [at (.offset range) (+ (.offset range) (.length range))]
        (when (and (>= at 0) (< at size)) (set! (mut blocked) (/ at 4) true)))) (set! for-index-111 (+ for-index-111 1))))
    (let [(mut i) (: 0 i64)]
      (while (< (+ i 1) words)
        (if (or (get blocked i) (get blocked (+ i 1)) (get entered (+ i 1)))
            (set! i (+ i 1))
            (let [merged (pair-word (read-word (.text output) (* i 4))
                                    (read-word (.text output) (* (+ i 1) 4)))]
              (if (= merged 0)
                  (set! i (+ i 1))
                  (do
                    (bytes/patch32! (mut (.text output)) (* i 4) merged)
                    (bytes/patch32! (mut (.text output)) (* (+ i 1) 4) 0xD503201F)
                    (push! (mut removed) (+ i 1))
                    (set! pairs (+ pairs 1))
                    (set! i (+ i 2))))))))
    (free! (mut blocked))
    (free! (mut entered))
    pairs))
;;; An NZCV value under which B.cond `condition` (0..13) is taken.
(defn satisfying-flags [(condition i32)] (-> u32)
  (match condition
    (0 4) (2 2) (4 8) (6 1) (8 2) (9 4) (11 8) (13 4) (_ 0)))

;;; CMP/CMN Rn, Rm or CMP/CMN Rn, #imm5 as the conditional comparison that
;;; performs it when `condition` holds and otherwise sets NZCV to `flags`;
;;; zero when the word is not such a comparison. The register form must be
;;; unshifted and the immediate unshifted and below 32; Rn = 31 (SP in the
;;; immediate form) is declined in both.
(defn conditional-compare-word [(word u32) (condition i32) (flags u32)] (-> u32)
  (let [register (= (& word (: 0x3FE0FC1F u32)) (: 0x2B00001F u32))
        immediate (and (= (& word (: 0x3FC0001F u32)) (: 0x3100001F u32))
                       (< (& (>> word 10) (: 0xFFF u32)) 32))
        rn (& (>> word 5) (: 31 u32))]
    (if (or (not (or register immediate)) (= rn 31) (< condition 0) (> condition 13))
        0
        (| (: 0x3A400000 u32)
           (& word (: 0xC0000000 u32))
           (if immediate (: 0x00000800 u32) (: 0 u32))
           (if immediate
               (<< (& (>> word 10) (: 31 u32)) 16)
               (& word (: 0x001F0000 u32)))
           (<< (cast u32 condition) 12)
           (<< rn 5)
           flags))))

;;; CMP Rn, #0 at the register's width; `register` is 0..30.
(defn compare-zero-word [(wide bool) (register i32)] (-> u32)
  (| (if wide (: 0xF100001F u32) (: 0x7100001F u32)) (<< (cast u32 register) 5)))

;;; A CBZ/CBNZ or TBZ/TBNZ condition as a flag-setting word and the B.cond
;;; condition that reads it the same way: CMP Rn,#0 with EQ/NE, or
;;; TST Rn,#(1 << k) with EQ/NE. Zero when `condition` is neither family.
(defstruct FlagTest [(word u32) (condition i32)])

(defn flag-test [(condition i32)] (-> FlagTest)
  (cond (e/register-condition? condition)
          (let [code (- condition 64)]
            (FlagTest :word (compare-zero-word (!= (& code 2) 0) (/ code 4))
                      :condition (& code 1)))
        (e/bit-condition? condition)
          (let [code (- condition 256)
                bit (/ code 64)]
            (match (e/test-bit (>= bit 32) (/ (& code 63) 2) bit)
              (Ok [word] (FlagTest :word word :condition (& code 1)))
              (Err [_] (FlagTest :word 0 :condition 0))))
        :else (FlagTest :word 0 :condition 0)))

;;; A CBZ/CBNZ, or a TBZ/TBNZ of the sign bit of either width, as CMP Rn,#0
;;; read by EQ/NE or PL/MI. Zero for any other condition.
(defn zero-compare [(condition i32)] (-> FlagTest)
  (cond (e/register-condition? condition)
          (let [code (- condition 64)]
            (FlagTest :word (compare-zero-word (!= (& code 2) 0) (/ code 4))
                      :condition (& code 1)))
        (e/bit-condition? condition)
          (let [code (- condition 256)
                bit (/ code 64)]
            (if (or (= bit 63) (= bit 31))
                (FlagTest :word (compare-zero-word (= bit 63) (/ (& code 63) 2))
                          :condition (if (= (& code 1) 1) 4 5))
                (FlagTest :word 0 :condition 0)))
        :else (FlagTest :word 0 :condition 0)))

;;; Two branches around at most one comparison,
;;;     B.c1 T ; CMP a, b ; B.c2 T          (either condition reaches T)
;;;     B.c1 S ; CMP a, b ; B.c2 T ; S:     (both conditions reach T)
;;; become CCMP a, b, #flags, !c1 ; B.c2 T: when c1 holds the comparison is
;;; skipped and flags are set so that c2 is taken (first form) or not taken
;;; (second form). NZCV is dead at every branch target and after a branch that
;;; is not taken only the flags of its own comparison are read, which are
;;; unchanged on that path. Requires that no branch or table entry targets any
;;; of the three words, no relocation or inline data on them, and no label
;;; there with more than word alignment. The first branch
;;; word becomes a NOP recorded in `removed` (so a chain merges again at the
;;; kept second branch) and its record is deleted; labels on it move to the
;;; comparison. Runs once every label is bound, before compaction.
;;;
;;; Register branches take part without a NOP. A first CBZ/CBNZ/TBZ/TBNZ
;;; before CMP ; B.c2 becomes its flag test (CMP Rn,#0 or TST Rn,#bit) in
;;; place, read by the conditional comparison; that word tests only its own
;;; register, so it may itself be a branch target. A second CBZ/CBNZ, or
;;; TBZ/TBNZ of a sign bit, directly after B.c1 becomes CCMP Rn,#0 in the
;;; first branch's word and B.EQ/NE/PL/MI in its own.
(defn merge-conditions! [(output (mut code/Buffer))
                         (labels (mut (ArrayList i64)))
                         (branches (mut (ArrayList Branch)))
                         (relatives (ArrayList Relative))
                         (alignment (ArrayList i32))
                         (removed (mut (ArrayList i64)))] (-> i32)
  (let [size (len (.text output))
        allocator (.alc (.text output))
        (mut merged) (ArrayList::new [i64] allocator)
        (mut targeted) (ArrayList::new [bool] allocator)
        (mut count) (: 0 i32)]
    (for [i 0 (- (len branches) 1)]
      (let [first (get branches i)
            second (get branches (+ i 1))
            at (.offset first)
            plain-first (and (>= (.condition first) 0) (<= (.condition first) 13))
            plain-second (and (>= (.condition second) 0) (<= (.condition second) 13))
            gap (- (.offset second) at)
            ; 0 none, 1 flag branches, 2 register branch first, 3 register branch second.
            form (cond (and plain-first plain-second (= gap 8)) 1
                       (and (not plain-first) plain-second (= gap 8)
                            (not (.link first)) (!= (.condition first) -1)) 2
                       (and plain-first (not plain-second) (= gap 4)
                            (not (.link second)) (!= (.condition second) -1)) 3
                       :else 0)
            end (+ (.offset second) 4)]
        (when (and (!= form 0)
                   (>= at 0) (<= end size)
                   (>= (.label first) 0) (< (cast i64 (.label first)) (len labels))
                   (>= (.label second) 0) (< (cast i64 (.label second)) (len labels)))
          (let [near (get labels (cast i64 (.label first)))
                far (get labels (cast i64 (.label second)))
                either (and (>= near 0) (= near far))
                both (and (not either) (= near end))
                head (if (= form 2) (flag-test (.condition first))
                         (FlagTest :word 1 :condition (.condition first)))
                tail (if (= form 3) (zero-compare (.condition second))
                         (FlagTest :word (read-word (.text output) (+ at 4))
                                   :condition (.condition second)))
                word (if (or (= (.word head) 0) (= (.word tail) 0))
                         0
                         (conditional-compare-word
                           (.word tail)
                           (^ (.condition head) 1)
                           (satisfying-flags (if either
                                                 (.condition tail)
                                                 (^ (.condition tail) 1)))))
                (mut ok) (and (or either both) (!= word 0))]
            (when ok
              ; One pass over every target, the first time a pair qualifies.
              (when (= (len targeted) 0)
                (extend-zeroed! (mut targeted) (+ (/ size 4) 2))
                (let [items-110 branches (mut for-index-110) (: 0 i64)] (while (< for-index-110 (len items-110)) (let [branch (get items-110 for-index-110)]
                  (when (and (>= (.label branch) 0) (< (cast i64 (.label branch)) (len labels)))
                    (let [target (get labels (cast i64 (.label branch)))]
                      (when (and (>= target 0) (<= target size))
                        (set! (mut targeted) (/ target 4) true))))) (set! for-index-110 (+ for-index-110 1))))
                (let [items-109 relatives (mut for-index-109) (: 0 i64)] (while (< for-index-109 (len items-109)) (let [relative (get items-109 for-index-109)]
                  (when (and (>= (.label relative) 0)
                             (< (cast i64 (.label relative)) (len labels)))
                    (let [target (get labels (cast i64 (.label relative)))]
                      (when (and (>= target 0) (<= target size))
                        (set! (mut targeted) (/ target 4) true))))) (set! for-index-109 (+ for-index-109 1)))))
              (when (or (and (!= form 2) (get targeted (/ at 4)))
                        (get targeted (/ (+ at 4) 4))
                        (and (!= form 3) (get targeted (/ (+ at 8) 4))))
                (set! ok false))
              (let [items-108 (.references output) (mut for-index-108) (: 0 i64)] (while (< for-index-108 (len items-108)) (let [reference (get items-108 for-index-108)]
                (when (and (>= (.offset reference) at) (< (.offset reference) end))
                  (set! ok false))) (set! for-index-108 (+ for-index-108 1))))
              (let [items-107 (.text-data output) (mut for-index-107) (: 0 i64)] (while (< for-index-107 (len items-107)) (let [range (get items-107 for-index-107)]
                (when (and (< (.offset range) end)
                           (> (+ (.offset range) (.length range)) at))
                  (set! ok false))) (set! for-index-107 (+ for-index-107 1))))
              (let [items-106 relatives (mut for-index-106) (: 0 i64)] (while (< for-index-106 (len items-106)) (let [relative (get items-106 for-index-106)]
                (when (and (>= (.offset relative) at) (< (.offset relative) end))
                  (set! ok false))) (set! for-index-106 (+ for-index-106 1))))
              (for [k 0 (len labels)]
                (let [label (get labels k)]
                  (when (and (>= label at) (< label end)
                             (< k (len alignment)) (> (get alignment k) 4))
                    (set! ok false)))))
            (when ok
              (cond (= form 1)
                      (do
                        (bytes/patch32! (mut (.text output)) at 0xD503201F)
                        (bytes/patch32! (mut (.text output)) (+ at 4) word)
                        (push! (mut removed) (/ at 4))
                        (for [k 0 (len labels)]
                          (when (= (get labels k) at) (set! (mut labels) k (+ at 4)))))
                    (= form 2)
                      (do
                        (bytes/patch32! (mut (.text output)) at (.word head))
                        (bytes/patch32! (mut (.text output)) (+ at 4) word))
                    :else
                      (do
                        (bytes/patch32! (mut (.text output)) at word)
                        (set! (mut branches) (+ i 1)
                              (Branch :offset (.offset second) :label (.label second)
                                      :condition (.condition tail) :link false))))
              (push! (mut merged) i)
              (set! count (+ count 1)))))))
    ; Delete the first-branch records, last first: the record swapped into a
    ; freed slot comes from behind every index still to be deleted.
    (let [(mut k) (len merged)]
      (while (> k 0)
        (set! k (- k 1))
        (let [index (get merged k)
              last (- (len branches) 1)]
          (when (!= index last) (set! (mut branches) index (get branches last)))
          (pop! (mut branches)))))
    (free! (mut merged))
    (free! (mut targeted))
    count))

;;; Delete the pairing NOPs before relaxation, while every position is still a
;;; record: labels, branch sites, relative table words and bases, relocations
;;; and inline data move down by four bytes per earlier removed word. Removed
;;; words are never a label, branch, relocation, table or data word (pairing
;;; excludes them). Fixed PC-relative encodings span only their own sequences;
;;; a switch table's ADR reads 16 bytes before the table base, so a removed word
;;; inside that window is kept. Branch reach can only shrink.
(defn compact-removed! [(output (mut code/Buffer))
                        (labels (mut (ArrayList i64)))
                        (branches (mut (ArrayList Branch)))
                        (relatives (mut (ArrayList Relative)))
                        (removed (ArrayList i64))] (-> (Result i32 (slice u8)))
  (if (= (len removed) 0)
      (Ok 0)
      (let [size (len (.text output))
            words (/ size 4)
            allocator (.alc (.text output))
            (mut drop) (ArrayList::new [bool] allocator)
            (mut shift) (ArrayList::new [i64] allocator)
            (mut error) ""
            (mut count) (: 0 i32)]
        (extend-zeroed! (mut drop) (+ words 1))
        (let [items-105 removed (mut for-index-105) (: 0 i64)] (while (< for-index-105 (len items-105)) (let [word (get items-105 for-index-105)]
          (if (or (< word 0) (>= word words)
                  (!= (read-word (.text output) (* word 4)) (: 0xD503201F u32)))
              (set! error "invalid pairing NOP record")
              (set! (mut drop) word true))) (set! for-index-105 (+ for-index-105 1))))
        (let [items-104 relatives (mut for-index-104) (: 0 i64)] (while (< for-index-104 (len items-104)) (let [relative (get items-104 for-index-104)]
          (let [table (/ (.base relative) 4)]
            (for [word (- table 4) table]
              (when (and (>= word 0) (< word words)) (set! (mut drop) word false))))) (set! for-index-104 (+ for-index-104 1))))
        (let [items-103 labels (mut for-index-103) (: 0 i64)] (while (< for-index-103 (len items-103)) (let [label (get items-103 for-index-103)]
          (when (and (>= label 0) (< label size) (get drop (/ label 4)))
            (set! error "pairing NOP is a label target"))) (set! for-index-103 (+ for-index-103 1))))
        (let [items-102 branches (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [branch (get items-102 for-index-102)]
          (when (get drop (/ (.offset branch) 4)) (set! error "pairing NOP is a branch"))) (set! for-index-102 (+ for-index-102 1))))
        (let [items-101 (.references output) (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [reference (get items-101 for-index-101)]
          (when (get drop (/ (.offset reference) 4)) (set! error "pairing NOP is relocated"))) (set! for-index-101 (+ for-index-101 1))))
        (if (!= error "")
            (do (free! (mut drop)) (free! (mut shift)) (Err error))
            (let [(mut gone) (: 0 i64)
                  (mut text) (ArrayList::new [u8] allocator)]
              (reserve! (mut shift) (+ words 1))
              (for [word 0 (+ words 1)]
                (push! (mut shift) (* gone 4))
                (when (and (< word words) (get drop word))
                  (set! gone (+ gone 1))
                  (set! count (+ count 1))))
              (reserve! (mut text) (- size (* gone 4)))
              (for [word 0 words]
                (unless (get drop word)
                  (for [byte (* word 4) (+ (* word 4) 4)]
                    (push! (mut text) (get (.text output) byte)))))
              (for [byte (* words 4) size] (push! (mut text) (get (.text output) byte)))
              (for [i 0 (len labels)]
                (let [label (get labels i)]
                  (when (>= label 0)
                    (set! (mut labels) i (- label (get shift (/ label 4)))))))
              (for [i 0 (len branches)]
                (let [branch (elem (mut branches) i)]
                  (set! (.offset branch) (- (.offset branch) (get shift (/ (.offset branch) 4))))))
              (for [i 0 (len relatives)]
                (let [relative (elem (mut relatives) i)]
                  (set! (.offset relative) (- (.offset relative) (get shift (/ (.offset relative) 4))))
                  (set! (.base relative) (- (.base relative) (get shift (/ (.base relative) 4))))))
              (for [i 0 (len (.references output))]
                (let [reference (elem (mut (.references output)) i)]
                  (set! (.offset reference) (- (.offset reference) (get shift (/ (.offset reference) 4))))))
              (for [i 0 (len (.text-data output))]
                (let [range (elem (mut (.text-data output)) i)]
                  (set! (.offset range) (- (.offset range) (get shift (/ (.offset range) 4))))))
              (free! (mut (.text output)))
              (store! (mut (.text output)) text)
              (free! (mut drop))
              (free! (mut shift))
              (Ok count))))))
