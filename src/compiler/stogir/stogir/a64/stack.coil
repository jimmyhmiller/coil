; Dynamic stack lowering follows dstogov/ir ir_aarch64.dasc, 92171d0. See NOTICE.
(module stogir.a64.stack)
(import "stogir.a64.registers" :as registers)
(import "stogir.stack" :as stack)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.allocation" :as allocation)
(import "stogir.locations" :as locations)
(import "stogir.a64.frame-address" :as frame)
(import "stogir.a64.value" :as value)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.emit" :as emit)
(import "stogir.a64.constants" :as constants)
(import "stogir.a64.code" :as code)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn constant! [(output (mut code/Buffer)) (error (mut (slice u8))) (bits u64)]
  (-> void)
  (match (constants/emit! (mut (.text output)) true 17 bits)
    (Err [message] (set! error message))
    (Ok [_] 0)))

;;; Count normalization and rounding are identical for ALLOCA and AFREE. Invalid
;;; runtime counts trap before SP changes, including negative signed operands.
(defn dynamic-aligned-with-locations! [(output (mut code/Buffer))
                                       (graph g/Graph)
                                       (parts locations/View)
                                       (size i32)
                                       (position i64)
                                       (subtract? bool)
                                       (alignment i64)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph size)
    (None [] (Err "dynamic stack count missing"))
    (Some [input]
          (let [ty (cast i32 (n/type-id input))
                width (types/scalar-size ty 8)
                begin (len (.text output))
                (mut error) ""]
            (match (value/register-with-locations! (mut output)
                                                   graph
                                                   parts
                                                   size
                                                   position
                                                   16
                                                   62)
              (Err [message] (set! error message))
              (Ok [reg]
                  (emit/word! (mut (.text output))
                              (mut error)
                              (encode/extend true
                                             (types/signed? ty)
                                             (* width 8)
                                             16
                                             reg))))
            (when (and (= error "") (or (= width 8) (types/signed? ty)))
              (constant! (mut output)
                         (mut error)
                         (cast u64
                               (- (: 0x7FFFFFFFFFFFFFFF i64) (- alignment 1))))
              (emit/word! (mut (.text output))
                          (mut error)
                          (encode/add-sub true true true 31 16 17))
              (emit/word! (mut (.text output))
                          (mut error)
                          (encode/conditional-branch 9 8))
              ; BRK #0: the unsigned comparison rejects negative/overflowing counts.
              (emit/word! (mut (.text output))
                          (mut error)
                          (Ok (: 0xD4200000 u32))))
            (when (= error "")
              (match (encode/add-sub-immediate true
                                               false
                                               false
                                               16
                                               16
                                               (- alignment 1))
                (Ok [word]
                    (emit/word! (mut (.text output)) (mut error) (Ok word)))
                (Err [_]
                     (constant! (mut output)
                                (mut error)
                                (cast u64 (- alignment 1)))
                     (emit/word! (mut (.text output))
                                 (mut error)
                                 (encode/add-sub true false false 16 16 17))))
              (match (frame/alignment-shift alignment)
                (Err [message] (set! error message))
                (Ok [bits]
                    (emit/word! (mut (.text output))
                                (mut error)
                                (encode/clear-low-bits 16 16 bits))))
              (emit/word! (mut (.text output))
                          (mut error)
                          (encode/add-sub-extended subtract? 31 31 16)))
            (if (= error "")
                (Ok (cast i32 (- (len (.text output)) begin)))
                (Err error))))))

;;; The function reserves an outgoing prefix below every active dynamic object.
;;; Allocate d bytes: newSP=oldSP-d, result=newSP+outgoing. Fixed slots use x29.
(defn emit-allocation-with-locations! [(output (mut code/Buffer))
                                       (graph g/Graph)
                                       (parts locations/View)
                                       (reference i32)
                                       (position i64)
                                       (base frame/Base)
                                       (outgoing i64)
                                       (alignment i64)]
  (-> (Result i32 (slice u8)))
  (match (stack/validate graph reference)
    (Err [message] (Err message))
    (Ok [_]
        (let [node (get (.instructions graph) (cast i64 reference))
              allocating? (= (n/opcode node) 81)
              (mut temporary) (code/create (.alc (.text output)))
              (mut error) ""]
          (if (or (not (frame/valid-base? base))
                  (!= (.reg base) 29)
                  (< alignment 16)
                  (!= (& alignment (- alignment 1)) 0)
                  (< outgoing 0)
                  (!= (% outgoing alignment) 0)
                  (> outgoing (.bias base))
                  (not (or (= (n/opcode node) 81) (= (n/opcode node) 82)))
                  (and allocating? (> (cast i64 (.op3 node)) alignment)))
              (set! error
                    "dynamic stack requires anchored frame and supported alignment")
              (if (< (.op2 node) 0)
                  (match (stack/constant-size-aligned graph
                                                      (.op2 node)
                                                      alignment)
                    (Err [message] (set! error message))
                    (Ok [size]
                        (match (frame/adjust! (mut (.text temporary))
                                              allocating?
                                              size
                                              16)
                          (Err [message] (set! error message))
                          (Ok [_] 0))))
                  (match (dynamic-aligned-with-locations! (mut temporary)
                                                          graph
                                                          parts
                                                          (.op2 node)
                                                          position
                                                          allocating?
                                                          alignment)
                    (Err [message] (set! error message))
                    (Ok [_] 0))))
          (when (and (= error "") allocating?)
            (match (locations/resolve parts reference (+ position 1))
              (Err [message] (set! error message))
              (Ok [destination]
                  (if (or (!= (.kind destination) 0)
                          (< (.value destination) 0)
                          (> (.value destination) 31)
                          (not (registers/allocatable? 6
                                                       (cast i32
                                                             (.value destination)))))
                      (set! error "ALLOCA result requires an allocatable GPR")
                      (match (frame/address! (mut (.text temporary))
                                             (cast i32 (.value destination))
                                             31
                                             outgoing)
                        (Err [message] (set! error message))
                        (Ok [_] 0))))))
          (let [count (cast i32 (len (.text temporary)))]
            (when (and (= error "") (not (code/append! (mut output) temporary)))
              (set! error "invalid dynamic stack code references"))
            (code/release! (mut temporary))
            (if (= error "") (Ok count) (Err error)))))))

(defn emit-scope-with-locations! [(output (mut code/Buffer))
                                  (graph g/Graph)
                                  (parts locations/View)
                                  (reference i32)
                                  (position i64)
                                  (base frame/Base)]
  (-> (Result i32 (slice u8)))
  (match (stack/validate graph reference)
    (Err [message] (Err message))
    (Ok [_]
        (let [node (get (.instructions graph) (cast i64 reference))
              (mut temporary) (code/create (.alc (.text output)))
              (mut error) ""]
          (if (or (not (frame/valid-base? base)) (!= (.reg base) 29))
              (set! error "stack scope requires an anchored frame")
              (if (= (n/opcode node) 83)
                  (match (locations/resolve parts reference (+ position 1))
                    (Err [message] (set! error message))
                    (Ok [destination]
                        (if (or (!= (.kind destination) 0)
                                (< (.value destination) 0)
                                (> (.value destination) 31)
                                (not (registers/allocatable? 6
                                                             (cast i32
                                                                   (.value destination)))))
                            (set! error
                                  "saved stack pointer requires an allocatable GPR")
                            (emit/word! (mut (.text temporary))
                                        (mut error)
                                        (encode/add-sub-immediate true
                                                                  false
                                                                  false
                                                                  (cast i32
                                                                        (.value destination))
                                                                  31
                                                                  0)))))
                  (if (= (n/opcode node) 84)
                      (match (value/register-with-locations! (mut temporary)
                                                             graph
                                                             parts
                                                             (.op2 node)
                                                             position
                                                             16
                                                             62)
                        (Err [message] (set! error message))
                        (Ok [reg]
                            (emit/word! (mut (.text temporary))
                                        (mut error)
                                        (encode/add-sub-immediate true
                                                                  false
                                                                  false
                                                                  31
                                                                  reg
                                                                  0))))
                      (set! error "invalid stack scope opcode"))))
          (let [count (cast i32 (len (.text temporary)))]
            (when (and (= error "") (not (code/append! (mut output) temporary)))
              (set! error "invalid stack scope code references"))
            (code/release! (mut temporary))
            (if (= error "") (Ok count) (Err error)))))))

(defn emit-aligned-with-locations! [(output (mut code/Buffer))
                                    (graph g/Graph)
                                    (parts locations/View)
                                    (reference i32)
                                    (position i64)
                                    (base frame/Base)
                                    (outgoing i64)
                                    (alignment i64)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "stack instruction missing"))
    (Some [node]
          (if (or (= (n/opcode node) 83) (= (n/opcode node) 84))
              (emit-scope-with-locations! (mut output)
                                          graph
                                          parts
                                          reference
                                          position
                                          base)
              (emit-allocation-with-locations! (mut output)
                                               graph
                                               parts
                                               reference
                                               position
                                               base
                                               outgoing
                                               alignment)))))

(defn emit-with-locations! [(output (mut code/Buffer))
                            (graph g/Graph)
                            (parts locations/View)
                            (reference i32)
                            (position i64)
                            (base frame/Base)
                            (outgoing i64)] (-> (Result i32 (slice u8)))
  (emit-aligned-with-locations! (mut output)
                                graph
                                parts
                                reference
                                position
                                base
                                outgoing
                                16))

(defn dynamic-with-locations! [(output (mut code/Buffer))
                               (graph g/Graph)
                               (parts locations/View)
                               (size i32)
                               (position i64)
                               (subtract? bool)] (-> (Result i32 (slice u8)))
  (dynamic-aligned-with-locations! (mut output)
                                   graph
                                   parts
                                   size
                                   position
                                   subtract?
                                   16))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn dynamic-aligned! [(output (mut code/Buffer))
                        (graph g/Graph)
                        (parts (ArrayList allocation/Part))
                        (size i32)
                        (position i64)
                        (subtract? bool)
                        (alignment i64)] (-> (Result i32 (slice u8)))
  (dynamic-aligned-with-locations! (mut output)
                                   graph
                                   (locations/linear-view parts)
                                   size
                                   position
                                   subtract?
                                   alignment))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit-allocation! [(output (mut code/Buffer))
                        (graph g/Graph)
                        (parts (ArrayList allocation/Part))
                        (reference i32)
                        (position i64)
                        (base frame/Base)
                        (outgoing i64)
                        (alignment i64)] (-> (Result i32 (slice u8)))
  (emit-allocation-with-locations! (mut output)
                                   graph
                                   (locations/linear-view parts)
                                   reference
                                   position
                                   base
                                   outgoing
                                   alignment))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit-scope! [(output (mut code/Buffer))
                   (graph g/Graph)
                   (parts (ArrayList allocation/Part))
                   (reference i32)
                   (position i64)
                   (base frame/Base)] (-> (Result i32 (slice u8)))
  (emit-scope-with-locations! (mut output)
                              graph
                              (locations/linear-view parts)
                              reference
                              position
                              base))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit-aligned! [(output (mut code/Buffer))
                     (graph g/Graph)
                     (parts (ArrayList allocation/Part))
                     (reference i32)
                     (position i64)
                     (base frame/Base)
                     (outgoing i64)
                     (alignment i64)] (-> (Result i32 (slice u8)))
  (emit-aligned-with-locations! (mut output)
                                graph
                                (locations/linear-view parts)
                                reference
                                position
                                base
                                outgoing
                                alignment))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit! [(output (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList allocation/Part))
             (reference i32)
             (position i64)
             (base frame/Base)
             (outgoing i64)] (-> (Result i32 (slice u8)))
  (emit-with-locations! (mut output)
                        graph
                        (locations/linear-view parts)
                        reference
                        position
                        base
                        outgoing))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn dynamic! [(output (mut code/Buffer))
                (graph g/Graph)
                (parts (ArrayList allocation/Part))
                (size i32)
                (position i64)
                (subtract? bool)] (-> (Result i32 (slice u8)))
  (dynamic-with-locations! (mut output)
                           graph
                           (locations/linear-view parts)
                           size
                           position
                           subtract?))
