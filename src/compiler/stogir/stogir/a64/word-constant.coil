;;; Same-width address views can reuse the existing constant materializer.
;;; Matching selects this recipe before liveness; the logical graph stays intact.
(module stogir.a64.word-constant)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.symbols" :as symbols)
(import "coil.result" :use [Some None])

;;; Requires a validated AArch64 graph. Zero means no constant recipe. Only
;;; 64-bit integer/address results of a negative ADDR constant are eligible.
(defn source [(graph g/Graph) (reference i32)] (-> i32)
  (if (<= reference 0) 0
      (let [node (get (.instructions graph) (cast i64 reference))
            ty (n/type-id node)]
        (if (or (!= (n/opcode node) 36) (>= (.op1 node) 0)
                (not (or (= ty 5) (= ty 6) (= ty 11)))) 0
            (match (g/lookup graph (.op1 node))
              (None [] 0)
              (Some [constant]
                (let [opcode (n/opcode constant)]
                  (if (and (= (n/type-id constant) 6)
                           (or (= opcode 6) (and (>= opcode 73) (<= opcode 77))))
                      (.op1 node) 0))))))))

;;; A COPY of a numeric literal is a constant recipe once the plan marks it
;;; rematerialized (a hoisted constant returned to its uses). Zero otherwise.
(defn literal-copy [(graph g/Graph) (reference i32)] (-> i32)
  (if (<= reference 0) 0
      (let [node (get (.instructions graph) (cast i64 reference))]
        (if (or (!= (n/opcode node) 68) (>= (.op1 node) 0)) 0
            (match (g/lookup graph (.op1 node))
              (None [] 0)
              (Some [constant]
                (if (and (symbols/numeric? constant)
                         (= (n/type-id constant) (n/type-id node)))
                    (.op1 node) 0)))))))

;;; The constant a rematerialized definition is rebuilt from, or zero.
(defn recipe [(graph g/Graph) (reference i32)] (-> i32)
  (let [view (source graph reference)]
    (if (< view 0) view (literal-copy graph reference))))
