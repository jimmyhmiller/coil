(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

;;; Split and CFG-edge groups must remain simultaneous across value widths.
;;; Byte/halfword scalar values retain their normalized32-bit register form.
(defn typed-group! [(output (mut (ArrayList u8)))
                    (graph g/Graph)
                    (copies (slice locations/Transfer))
                    (allocator (dyn Allocator))
                    (base frame-address/Base)] (-> (Result i32 (slice u8)))
  (let [(mut typed) (ArrayList::new [typed-transfers/Copy] allocator)
        (mut error) ""]
    (for copy copies
      (match (g/lookup graph (.parent copy))
        (None [] (set! error "transfer has no owning graph value"))
        (Some [node]
              (let [size (types/size (cast i32 (n/type-id node)) 8)]
                (if (or (<= size 0) (> size 16))
                    (set! error "unsupported graph transfer extent")
                    (push! (mut typed)
                           (typed-transfers/Copy
                             :transfer copy
                             :size (if (< size 4) 4 size))))))))
    (let [result
            (if (= error "")
                (typed-transfers/parallel-frame! (mut output)
                                                 (slice typed)
                                                 allocator
                                                 base)
                (Err [i32 (slice u8)] error))]
      (free! (mut typed))
      result)))

;;; Simultaneous GP return installation handles shared values, cycles and
;;; spills through the same typed transfer machinery as CFG edges. Recipes are
;;; materialized after physical sources have been consumed, preserving x0/x1.
(defn direct-return! [(output (mut code/Buffer)) (graph g/Graph)
                       (assigned allocate/Assigned) (operands machine/Plan)
                       (reference i32) (position i64) (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [range (get (.ranges operands) (cast i64 reference))
        spec (.result assigned)
        (mut copies) (ArrayList::new [locations/Transfer] a)
        (mut recipes) (ArrayList::new [i32] a) (mut error) ""
        view (locations/indexed-view (.parts assigned) (.locations assigned))]
    (unless (and (= (.kind spec) 1) (or (= (.ty spec) 5) (= (.ty spec) 11))
                 (= (.count range) (+ (cast i64 (.count spec)) 1)))
      (set! error "incomplete direct GP return group"))
    (for k (range 0 (cast i64 (.count spec)))
      (let [ref (get (.inputs operands) (+ (.offset range) 1 k))]
        (push! (mut recipes) 0)
        (match (g/lookup graph ref)
          (None [] (set! error "return piece missing"))
          (Some [node]
            (unless (= (n/type-id node) (.ty spec)) (set! error "return piece type mismatch"))))
        (when (= error "")
          (if (< ref 0) (set! (mut recipes) k ref)
              (match (locations/resolve view ref position)
                (Err [message] (set! error message))
                (Ok [source]
                  (if (or (locations/rematerialized? source) (locations/constant? source))
                      (set! (mut recipes) k ref)
                      (push! (mut copies) (locations/Transfer :position position :parent ref
                        :source source :destination (locations/Location :kind 0 :value k))))))))))
    (when (= error "")
      (match (typed-group! (mut (.text output)) graph (slice copies) a (.base assigned))
        (Err [message] (set! error message)) (Ok [_] 0)))
    (for k (range 0 (len recipes))
      (when (and (= error "") (!= (get recipes k) 0))
        (match (emit/operand-register-with-locations! (mut output) graph view
                  (get recipes k) position true (cast i32 k))
          (Err [message] (set! error message))
          (Ok [reg] (unless (= reg (cast i32 k)) (set! error "return recipe did not materialize in its result register"))))))
    (free! (mut copies)) (free! (mut recipes))
    (if (= error "") (Ok 0) (Err error))))

(defn word! [(output (mut code/Buffer))
             (instruction (Result u32 (slice u8)))]
  (-> (Result i32 (slice u8)))
  (match instruction
    (Err [msg] (Err msg))
    (Ok [word] (do (bytes/append32! (mut (.text output)) word) (Ok 4)))))

;;; Unsupported instructions and ABI cases report errors. Odd boundaries that
;;; write registers require instruction-specific lowering; spill stores precede
;;; the instruction so they preserve values about to be clobbered.
(defstruct EdgeStub [(label i32) (target i32) (body code/Buffer)])

;;; Allocation positions remain the original schedule indices. This only asks
;;; which block follows an end instruction in the current emission order.
(defn next-block [(graph g/Graph) (scheduled schedule/Schedule) (index i64)]
  (-> i32)
  (if (< (+ index 1) (len (.nodes scheduled)))
      (let [reference (get (.nodes scheduled) (+ index 1))]
        (if (op/block-start? (cast i32
                                   (n/opcode (get (.instructions graph)
                                                  (cast i64 reference)))))
            reference
            0))
      0))

(defn finish-stubs! [(output (mut code/Buffer))
                     (stubs (ArrayList EdgeStub))
                     (labels (mut (ArrayList i64)))
                     (branches (mut (ArrayList fixups/Branch)))]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""]
    (for stub stubs
      (when (= error "")
        (set! (mut labels) (cast i64 (.label stub)) (len (.text output)))
        (if (code/append! (mut output) (.body stub))
            (switch-emit/branch! (mut output) (mut branches) (.target stub) -1)
            (set! error "invalid deferred edge code"))))
    (if (= error "") (Ok 0) (Err error))))

(defn release-stubs! [(stubs (mut (ArrayList EdgeStub)))] (-> void)
  (for [index 0 (len stubs)]
    (code/release! (mut (.body (elem (mut stubs) index)))))
  (free! (mut stubs)))

;;; Low-level callers retain the supplied schedule's physical order.
;;; Adjacent ranges in a coalesced vreg may belong to different SSA
;;; definitions. A split at the birth of a new value has no old value to carry.
;;; COPY/BITCAST aliases retain their existing lowering: they can describe the
;;; same still-live source rather than a disjoint redefinition.
(defn split-moves [(graph g/Graph) (scheduled schedule/Schedule)
                   (assigned allocate/Assigned) (matched matching/Plan)
                   (allocator (dyn Allocator))] (-> (ArrayList locations/Transfer))
  (let [(mut moves) (locations/contiguous-indexed (.parts assigned)
                                                (.locations assigned) allocator)
        (mut kept) 0]
    (when (.coalesced (.locations assigned))
      (for move moves
        (let [position (.position move)
              (mut redefined) false]
          (when (= (% position 2) 1)
            (let [reference (get (.nodes scheduled) (/ position 2))
                  node (get (.instructions graph) (cast i64 reference))]
              (when (and (!= (n/opcode node) 68) (!= (n/opcode node) 36))
                (for [output 0 (machine/definition-count (.operands matched) reference)]
                  (let [value (machine/definition-at (.operands matched) reference output)
                        bucket (get (.parents (.locations assigned)) (cast i64 value))]
                    (when (and (> (.count bucket) 0)
                               (= (locations/owner (.parts assigned) (.locations assigned) value)
                                  (.parent move)))
                      (set! redefined true)))))))
          (unless redefined
            (set! (mut moves) kept move)
            (set! kept (+ kept 1)))))
      (while (> (len moves) kept) (pop! (mut moves))))
    moves))

(defn resolved-split-moves [(graph g/Graph) (scheduled schedule/Schedule)
                             (assigned allocate/Assigned) (matched matching/Plan)
                             (allocator (dyn Allocator))] (-> (ArrayList locations/Transfer))
  (let [(mut moves) (split-moves graph scheduled assigned matched allocator)]
    (spill-homes/plan! graph scheduled assigned matched (mut moves) allocator)
    moves))

(defstruct HomePlan [(moves (ArrayList locations/Transfer)) (established (ArrayList i64))])

(defn assigned-home-view [(assigned allocate/Assigned) (established (slice i64))]
  (-> allocate/Assigned)
  (let [(mut view) assigned]
    (set! (.established-homes view) established) view))

(defn resolved-home-plan [(graph g/Graph) (scheduled schedule/Schedule)
                          (assigned allocate/Assigned) (matched matching/Plan)
                          (allocator (dyn Allocator))] (-> HomePlan)
  (let [(mut moves) (split-moves graph scheduled assigned matched allocator)
        (mut established) (ArrayList::new [i64] allocator)]
    (spill-homes/plan-certified! graph scheduled assigned matched (mut moves) (mut established) allocator)
    (HomePlan :moves moves :established established)))

(defn body-matched [(graph g/Graph)
                    (scheduled schedule/Schedule)
                    (assigned allocate/Assigned)
                    (analysis live/Analysis)
                    (requirements (ArrayList constraints/Value))
                    (matched matching/Plan)
                    (allocator (dyn Allocator))]
  (-> (Result code/Buffer (slice u8)))
  (let [(mut resolution)
          (resolved-home-plan graph scheduled assigned matched allocator)
        moves (.moves resolution)
        resolved (assigned-home-view assigned (slice (.established resolution)))
        (mut physical) (layout/identity graph scheduled allocator)
        result
          (body-ordered graph
                        scheduled
                        resolved
                        analysis
                        requirements
                        matched
                        physical
                        moves
                        allocator)]
    (layout/release! (mut physical))
    (free! (mut (.moves resolution)))
    (free! (mut (.established resolution)))
    result))

;;; Allocation positions are fixed before constructing physical block layout.
(defn body-prepared [(graph g/Graph)
                     (prepared pipeline/Prepared)
                     (assigned allocate/Assigned)
                     (analysis live/Analysis)
                     (requirements (ArrayList constraints/Value))
                     (matched matching/Plan)
                     (allocator (dyn Allocator))]
  (-> (Result code/Buffer (slice u8)))
  (if (<= (len (.order prepared)) 2)
      (body-matched graph
                    (.schedule prepared)
                    assigned
                    analysis
                    requirements
                    matched
                    allocator)
      (body-layout graph
                   prepared
                   assigned
                   analysis
                   requirements
                   matched
                   allocator)))

(defn body-layout [(graph g/Graph)
                   (prepared pipeline/Prepared)
                   (assigned allocate/Assigned)
                   (analysis live/Analysis)
                   (requirements (ArrayList constraints/Value))
                   (matched matching/Plan)
                   (allocator (dyn Allocator))]
  (-> (Result code/Buffer (slice u8)))
  (let [(mut resolution)
          (resolved-home-plan graph (.schedule prepared) assigned matched allocator)
        moves (.moves resolution)
        resolved (assigned-home-view assigned (slice (.established resolution)))
        result
          (match (empty-blocks graph prepared resolved analysis moves allocator)
            (Err [message] (Err [code/Buffer (slice u8)] message))
            (Ok [candidates]
                (let [(mut empty) candidates
                      (mut physical)
                        (layout/build graph prepared empty allocator)
                      emitted
                        (body-ordered graph
                                      (.schedule prepared)
                                      resolved
                                      analysis
                                      requirements
                                      matched
                                      physical
                                      moves
                                      allocator)]
                  (layout/release! (mut physical))
                  (free! (mut empty))
                  emitted)))]
    (free! (mut (.moves resolution)))
    (free! (mut (.established resolution)))
    result))

;;; Match upstream's structural start/END-only candidate, then account for all
;;; split transfers and outgoing edge copies after allocation. Self loops and
;;; entry blocks remain anchors. The generic layout pass protects cycle headers.
(defn empty-blocks [(graph g/Graph)
                    (prepared pipeline/Prepared)
                    (assigned allocate/Assigned)
                    (analysis live/Analysis)
                    (moves (ArrayList locations/Transfer))
                    (allocator (dyn Allocator))]
  (-> (Result (ArrayList bool) (slice u8)))
  (let [(mut result) (ArrayList::new [bool] allocator)
        (mut successors) (adj/build (.blocks prepared) false allocator)
        (mut error) ""]
    (for [i 0 (len (.instructions graph))] (push! (mut result) false))
    (for reference (.order prepared)
      (let [range (get (.ranges (.schedule prepared)) (cast i64 reference))
            outgoing (get (.ranges successors) (cast i64 reference))
            opcode (n/opcode (get (.instructions graph) (cast i64 reference)))]
        (when (and (= error "")
                   (= (.count range) 2)
                   (= (.count outgoing) 1)
                   (!= opcode 104)
                   (!= opcode 105))
          (let [ending (get (.nodes (.schedule prepared)) (+ (.offset range) 1))
                end-op (n/opcode (get (.instructions graph) (cast i64 ending)))
                target
                  (.to (get (.edges (.blocks prepared))
                            (get (.edges successors) (.offset outgoing))))
                begin (* (.offset range) 2)
                end (+ begin 4)
                (mut split) false]
            (for move moves
              (when (and (> (.position move) begin) (< (.position move) end))
                (set! split true)))
            (when (and (!= target reference)
                       (> (.count (get (.ranges (.schedule prepared))
                                       (cast i64 target)))
                          0)
                       (>= (get (.indices analysis) (cast i64 target)) 0)
                       (not split)
                       (or (= end-op 114) (= end-op 115)))
              (let [(mut transfer) (code/create allocator)]
                (match (edge! (mut transfer)
                              graph
                              assigned
                              (.schedule prepared)
                              analysis
                              target
                              (+ begin 3)
                              allocator)
                  (Err [message] (set! error message))
                  (Ok [_]
                      (when (= (len (.text transfer)) 0)
                        (set! (mut result) (cast i64 reference) true))))
                (code/release! (mut transfer))))))))
    (adj/release! (mut successors))
    (if (= error "") (Ok result) (do (free! (mut result)) (Err error)))))

;;; Pass the original successor reference to emission when its canonical target
;;; is physically next. Labels of skipped blocks bind to their canonical target.
(defn next-successor [(graph g/Graph)
                      (users uses/Uses)
                      (selected (ArrayList bool))
                      (reference i32)
                      (next i32)
                      (aliases (ArrayList i32))] (-> i32)
  (let [range (get (.ranges users) (cast i64 reference))
        (mut result) (: 0 i32)]
    (when (> next 0)
      (for [i 0 (.count range)]
        (let [edge (get (.edges users) (+ (.offset range) i))
              user (.user edge)]
          (when (and (get selected (cast i64 user))
                     (op/block-start? (cast i32
                                            (n/opcode (get (.instructions graph)
                                                           (cast i64 user)))))
                     (= (get aliases (cast i64 user)) next))
            (set! result user)))))
    result))

(defn body-ordered [(graph g/Graph)
                    (scheduled schedule/Schedule)
                    (assigned allocate/Assigned)
                    (analysis live/Analysis)
                    (requirements (ArrayList constraints/Value))
                    (matched matching/Plan)
                    (physical layout/Plan)
                    (moves (ArrayList locations/Transfer))
                    (allocator (dyn Allocator))]
  (-> (Result code/Buffer (slice u8)))
  (let [resolved
          (locations/indexed-view (.parts assigned) (.locations assigned))
        (mut output) (code/create allocator)
        (mut group) (ArrayList::new [locations/Transfer] allocator)
        (mut move-index) (transfer-index/create allocator)
        (mut labels) (ArrayList::new [i64] allocator)
        (mut branches) (ArrayList::new [fixups/Branch] allocator)
        (mut relatives) (ArrayList::new [fixups/Relative] allocator)
        (mut stubs) (ArrayList::new [EdgeStub] allocator)
        (mut indexed-users) (uses/build graph allocator)
        (mut selected) (ArrayList::new [bool] allocator)
        (mut frame-size) (: 0 i64)
        (mut error) ""
        (mut cursor) 0]
    (match (checked-schedule/validate graph scheduled)
      (Err [message] (set! error message))
      (Ok [_] 0))
    (match (transfer-index/build (slice moves)
                                 (* (len (.nodes scheduled)) 2)
                                 allocator)
      (Err [message] (set! error message))
      (Ok [index] (set! move-index index)))
    (let [(mut j) 0]
      (while (< j (len (.instructions graph)))
        (push! (mut labels) -1)
        (push! (mut selected) false)
        (set! j (+ j 1))))
    (for reference (.nodes scheduled)
      (set! (mut selected) (cast i64 reference) true))
    (match (frame/aligned-size (.frame assigned) (.alignment assigned))
      (Err [msg] (set! error msg))
      (Ok [size] (set! frame-size size)))
    (for move moves
      (when (and (= error "")
                 (!= (% (.position move) 2) 0)
                 (not (and (= (.kind (.source move)) 0)
                           (= (.kind (.destination move)) 1)))
                 (let [opcode
                         (n/opcode (get (.instructions graph)
                                        (cast i64
                                              (get (.nodes scheduled)
                                                   (/ (.position move) 2)))))]
                   (not (or (= opcode 79) (= opcode 80)))))
        (set! error "odd split boundary needs instruction-specific lowering")))
    (when (= error "")
      (match (prologue! (mut output) assigned frame-size)
        (Err [message] (set! error message))
        (Ok [_] 0)))
    (while (and (= error "") (< cursor (len (.indices physical))))
      (let [i (get (.indices physical) cursor)
            reference (get (.nodes scheduled) i)
            node (get (.instructions graph) (cast i64 reference))
            opcode (n/opcode node)
            position (* i 2)]
        (when (op/block-start? (cast i32 opcode))
          (when (> (cast i64 (get (.alignment physical) (cast i64 reference)))
                   (.alignment output))
            (set! (.alignment output)
                  (cast i64 (get (.alignment physical) (cast i64 reference)))))
          (while (!= (% (len (.text output))
                        (cast i64
                              (get (.alignment physical) (cast i64 reference))))
                     0)
            (bytes/append32! (mut (.text output)) 0xD503201F))
          (set! (mut labels) (cast i64 reference) (len (.text output))))
        ; The use and definition subpositions are ordered phases. In particular,
        ; a reload at the even use position must complete before an odd spill
        ; store preserves that same value ahead of a clobbering definition.
        ; Combining them as parallel copies would store the register's old value.
        (let [(mut phase) (: 0 i64)]
          (while (and (= error "") (< phase 2))
            (clear! (mut group))
            ; Incoming CFG edges already reconcile ordinary values to their
            ; entry locations. A contiguous split at this linear-layout boundary
            ; describes the preceding laid-out block, which need not be an
            ; actual predecessor. Replaying it would overwrite the edge copy.
            (when (or (!= phase 0) (not (op/block-start? (cast i32 opcode))))
              (let [(mut cursor) (get (.heads move-index) (+ position phase))]
                (while (>= cursor 0)
                  (push! (mut group) (get moves cursor))
                  (set! cursor (get (.next move-index) cursor)))))
            (when (and (> (len group) 0)
                       (not (and (= phase 1) (or (= opcode 79) (= opcode 80)))))
              (match (typed-group! (mut (.text output))
                                   graph
                                   (slice group)
                                   allocator
                                   (.base assigned))
                (Err [msg] (set! error msg))
                (Ok [_] 0)))
            (set! phase (+ phase 1))))
        (when (and (= error "") (= opcode 71))
          (match (if (= (.kind (.parameter (at requirements
                                               (cast i64 reference))))
                        3)
                     (result-emit/parameter-with-locations! (mut (.text output))
                                                            resolved
                                                            reference
                                                            position
                                                            (.base assigned)
                                                            (.result-slot assigned))
                     (incoming/emit-entry-with-locations! (mut (.text output))
                                                          graph
                                                          resolved
                                                          (.parameter (at requirements
                                                                          (cast i64
                                                                                reference)))
                                                          position
                                                          frame-size
                                                          (.base assigned)
                                                          (.entry-slot assigned)))
            (Err [msg] (set! error msg))
            (Ok [_] 0)))
        (when (and (= error "") (or (= opcode 96) (= opcode 121)))
          (emit/word! (mut (.text output)) (mut error) (encode/breakpoint 0))
          ; A resumed UNREACHABLE re-enters BRK instead of falling through.
          ; TRAP remains resumable and its control successor follows normally.
          (when (= opcode 121)
            (emit/word! (mut (.text output))
                        (mut error)
                        (encode/branch false -4))))
        (when (and (= error "")
                   (> (get (.extractions matched) (cast i64 reference)) 0)
                   (not (get (.omitted (.operands matched))
                             (cast i64 reference))))
          (match (emit/allocated-selected-with-locations! (mut output)
                                                          graph
                                                          resolved
                                                          reference
                                                          position
                                                          (get (.tiles matched)
                                                               (cast i64
                                                                     reference))
                                                          allocator)
            (Err [message] (set! error message))
            (Ok [_] 0)))
        (when (= error "")
          (if (or (machine/rematerialized? (.operands matched) reference)
                  (> (get (.extractions matched) (cast i64 reference)) 0)
                  (get (.omitted (.operands matched)) (cast i64 reference))
                  (op/block-start? (cast i32 opcode))
                  (= opcode 71)
                  (= opcode 72)
                  (= opcode 67)
                  (= opcode 96)
                  (= opcode 121))
              0
              (if (= opcode 120)
                  (do
                    ; RETURN has an ABI preference, not a hard allocation
                    ; constraint. Capture its actual register/spill location.
                    (when (and (> (.op2 node) 0) (> (n/type-id node) 0))
                      (match (call/capture-at-with-locations! (mut output)
                                                              graph
                                                              resolved
                                                              (.op2 node)
                                                              position
                                                              (if (registers/simd-type? (cast i32
                                                                                              (n/type-id node)))
                                                                  32
                                                                  0)
                                                              (.base assigned))
                        (Err [msg] (set! error msg))
                        (Ok [_] 0)))
                    (when (< (.op2 node) 0)
                      (match (g/lookup graph (.op2 node))
                        (None [] (set! error "return constant missing"))
                        (Some [constant]
                              (match (value/constant! (mut output)
                                                      graph
                                                      (.op2 node)
                                                      (if (registers/simd-type? (cast i32
                                                                                      (n/type-id constant)))
                                                          32
                                                          0)
                                                      16)
                                (Err [msg] (set! error msg))
                                (Ok [_] 0)))))
                    (match (abi/normalize! (mut (.text output))
                                           (n/type-id node)
                                           0)
                      (Err [msg] (set! error msg))
                      (Ok [_] 0))
                    (when (= error "")
                      (match (if (and (= (.kind (.result assigned)) 1) (< (.result-slot assigned) 0))
                                  (direct-return! (mut output) graph assigned (.operands matched)
                                                   reference position allocator)
                                  (result-emit/return! (mut (.text output))
                                                  (.result assigned)
                                                  (.base assigned)
                                                  (.result-slot assigned)))
                        (Err [message] (set! error message))
                        (Ok [_] 0)))
                    (match (epilogue! (mut output) assigned frame-size)
                      (Err [message] (set! error message))
                      (Ok [_] 0)))
                  (if (or (= opcode 114) (= opcode 115))
                      (match (unconditional-layout! (mut output)
                                                    graph
                                                    assigned
                                                    scheduled
                                                    analysis
                                                    reference
                                                    position
                                                    indexed-users
                                                    selected
                                                    (mut branches)
                                                    (next-successor graph
                                                                    indexed-users
                                                                    selected
                                                                    reference
                                                                    (get (.next physical)
                                                                         i)
                                                                    (.aliases physical))
                                                    allocator)
                        (Err [msg] (set! error msg))
                        (Ok [_] 0))
                      (if (or (= opcode 116) (= opcode 117))
                          (match (if (= opcode 117)
                                     (switch! (mut output)
                                              graph
                                              assigned
                                              reference
                                              position
                                              indexed-users
                                              selected
                                              scheduled
                                              analysis
                                              (mut labels)
                                              (mut branches)
                                              (mut relatives)
                                              allocator)
                                     (conditional-layout-selected! (mut output)
                                                                   graph
                                                                   assigned
                                                                   reference
                                                                   position
                                                                   indexed-users
                                                                   selected
                                                                   scheduled
                                                                   analysis
                                                                   (mut labels)
                                                                   (mut branches)
                                                                   (get (.comparisons matched)
                                                                        (cast i64
                                                                              reference))
                                                                   (get (.tiles matched)
                                                                        (cast i64
                                                                              (get (.comparisons matched)
                                                                                   (cast i64
                                                                                         reference))))
                                                                   (next-successor graph
                                                                                   indexed-users
                                                                                   selected
                                                                                   reference
                                                                                   (get (.next physical)
                                                                                        i)
                                                                                   (.aliases physical))
                                                                   (mut stubs)
                                                                   allocator))
                            (Err [msg] (set! error msg))
                            (Ok [_] 0))
                          (if (= opcode 66)
                              (match (frame-value-with-locations! (mut output)
                                                                  resolved
                                                                  reference
                                                                  position
                                                                  (.base assigned))
                                (Err [msg] (set! error msg))
                                (Ok [_] 0))
                              (if (or (= opcode 81)
                                      (= opcode 82)
                                      (= opcode 83)
                                      (= opcode 84))
                                  (match (stackemit/emit-aligned-with-locations! (mut output)
                                                                                 graph
                                                                                 resolved
                                                                                 reference
                                                                                 position
                                                                                 (.base assigned)
                                                                                 (.outgoing-size assigned)
                                                                                 (.alignment assigned))
                                    (Err [msg] (set! error msg))
                                    (Ok [_] 0))
                                  (if (or (= opcode 40)
                                          (= opcode 68)
                                          (= opcode 70))
                                      (match (locations/lookup-indexed (.parts assigned)
                                                                       (.locations assigned)
                                                                       reference
                                                                       (+ position
                                                                          1))
                                        (Err [msg] (set! error msg))
                                        (Ok [destination]
                                            (if (!= (.kind destination) 0)
                                                (set! error
                                                      "identity result requires register")
                                                (match (call/capture-at-with-locations! (mut output)
                                                                                        graph
                                                                                        resolved
                                                                                        (.op1 node)
                                                                                        position
                                                                                        (cast i32
                                                                                              (.value destination))
                                                                                        (.base assigned))
                                                  (Err [msg] (set! error msg))
                                                  (Ok [_] 0)))))
                                      (if (or (= opcode 79) (= opcode 80))
                                          (match (if (or (= opcode 80)
                                                         (and (< (cast i64
                                                                       reference)
                                                                 (len (.modes (.tails matched))))
                                                              (> (get (.modes (.tails matched))
                                                                      (cast i64
                                                                            reference))
                                                                 0)))
                                                     (tailcall! (mut output)
                                                                graph
                                                                assigned
                                                                matched
                                                                reference
                                                                position
                                                                frame-size
                                                                (slice group)
                                                                allocator)
                                                     (call/emit-projected-at-with-locations! (mut output)
                                                                                             graph
                                                                                             resolved
                                                                                             reference
                                                                                             position
                                                                                             allocator
                                                                                             (.base assigned)
                                                                                             (slice group)
                                                                                             (> (.count (machine/output-range (.operands matched) reference)) 0)))
                                            (Err [msg] (set! error msg))
                                            (Ok [_] 0))
                                          (if (locals/operation? (cast i32
                                                                       opcode))
                                              (match (local/emit-aligned-with-locations! (mut output)
                                                                                         graph
                                                                                         resolved
                                                                                         (.frame assigned)
                                                                                         reference
                                                                                         position
                                                                                         (.base assigned)
                                                                                         (.alignment assigned))
                                                (Err [msg] (set! error msg))
                                                (Ok [_] 0))
                                              (if (or (and (>= opcode 91)
                                                           (<= opcode 94))
                                                      (atomic/operation? (cast i32
                                                                               opcode)))
                                                  (match (if (atomic/operation? (cast i32
                                                                                      opcode))
                                                             (atomic-emit/emit-with-locations! (mut output)
                                                                                               graph
                                                                                               resolved
                                                                                               reference
                                                                                               position)
                                                             (memory/emit-indexed-address-with-locations! (mut output)
                                                                                                  graph
                                                                                                  resolved
                                                                                                  reference
                                                                                                  position
                                                                                                  (if (> (get (.addresses matched)
                                                                                                              (cast i64
                                                                                                                    reference))
                                                                                                         0)
                                                                                                      (get (.addresses matched)
                                                                                                           (cast i64
                                                                                                                 reference))
                                                                                                      (.op2 node))
                                                                                                  (get (.offsets matched) (cast i64 reference))
                                                                                                  (get (.indices matched) (cast i64 reference))
                                                                                                  (get (.index-shifts matched) (cast i64 reference))))
                                                    (Err [msg] (set! error msg))
                                                    (Ok [_] 0))
                                                  (if (or (vl/operation? (cast i32
                                                                               opcode))
                                                          (vc/node? graph
                                                                    reference)
                                                          (va/node? graph
                                                                    reference)
                                                          (floating/node? graph
                                                                          reference)
                                                          (checked/operation? (cast i32
                                                                                    opcode))
                                                          (and (= opcode 60)
                                                               (not (and (>= (.rule (at (.tiles matched) (cast i64 reference))) 34)
                                                                         (<= (.rule (at (.tiles matched) (cast i64 reference))) 37))))
                                                          (and (>= opcode 33)
                                                               (<= opcode 39))
                                                          (unary/operation? (cast i32
                                                                                  opcode)))
                                                      (match (if (vl/operation? (cast i32
                                                                                      opcode))
                                                                 (vlemit/emit-with-locations! (mut output)
                                                                                              graph
                                                                                              resolved
                                                                                              reference
                                                                                              position)
                                                                 (if (vc/node? graph
                                                                               reference)
                                                                     (vcemit/emit-with-locations! (mut output)
                                                                                                  graph
                                                                                                  resolved
                                                                                                  reference
                                                                                                  position)
                                                                     (if (va/node? graph
                                                                                   reference)
                                                                         (if (> (get (.doubles matched)
                                                                                     (cast i64
                                                                                           reference))
                                                                                0)
                                                                             (vaemit/emit-doubled-with-locations! (mut output)
                                                                                                                  graph
                                                                                                                  resolved
                                                                                                                  reference
                                                                                                                  position
                                                                                                                  (get (.doubles matched)
                                                                                                                       (cast i64
                                                                                                                             reference)))
                                                                             (vaemit/emit-with-locations! (mut output)
                                                                                                          graph
                                                                                                          resolved
                                                                                                          reference
                                                                                                          position))
                                                                         (if (floating/node? graph
                                                                                             reference)
                                                                             (fpemit/emit-with-locations! (mut output)
                                                                                                          graph
                                                                                                          resolved
                                                                                                          reference
                                                                                                          position)
                                                                             (if (checked/operation? (cast i32
                                                                                                           opcode))
                                                                                 (checked/emit-with-locations! (mut output)
                                                                                                               graph
                                                                                                               resolved
                                                                                                               reference
                                                                                                               position
                                                                                                               (and (< (+ i
                                                                                                                          1)
                                                                                                                       (len (.nodes scheduled)))
                                                                                                                    (let [next
                                                                                                                            (get (.instructions graph)
                                                                                                                                 (cast i64
                                                                                                                                       (get (.nodes scheduled)
                                                                                                                                            (+ i
                                                                                                                                               1))))]
                                                                                                                      (and (= (n/opcode next)
                                                                                                                              44)
                                                                                                                           (= (.op1 next)
                                                                                                                              reference))))
                                                                                                               allocator)
                                                                                 (if (= opcode
                                                                                        60)
                                                                                     (cond/emit-with-locations! (mut output)
                                                                                                                graph
                                                                                                                resolved
                                                                                                                reference
                                                                                                                position
                                                                                                                allocator)
                                                                                     (if (unary/operation? (cast i32
                                                                                                                 opcode))
                                                                                         (unary/emit-with-locations! (mut output)
                                                                                                                     graph
                                                                                                                     resolved
                                                                                                                     reference
                                                                                                                     position
                                                                                                                     allocator)
                                                                                         (convert/emit-with-locations! (mut output)
                                                                                                                       graph
                                                                                                                       resolved
                                                                                                                       reference
                                                                                                                       position))))))))
                                                        (Err [msg]
                                                             (set! error msg))
                                                        (Ok [_] 0))
                                                      (match (emit/allocated-selected-with-locations! (mut output)
                                                                                                      graph
                                                                                                      resolved
                                                                                                      reference
                                                                                                      position
                                                                                                      (get (.tiles matched)
                                                                                                           (cast i64
                                                                                                                 reference))
                                                                                                      allocator)
                                                        (Err [msg]
                                                             (set! error msg))
                                                        (Ok [_] 0)))))))))))))))
      (set! cursor (+ cursor 1)))
    (when (= error "")
      (for [reference 1 (len (.aliases physical))]
        (let [target (get (.aliases physical) reference)]
          (when (!= target (cast i32 reference))
            (set! (mut labels) reference (get labels (cast i64 target)))))))
    (when (= error "")
      (match (finish-stubs! (mut output) stubs (mut labels) (mut branches))
        (Err [message] (set! error message))
        (Ok [_] 0)))
    (when (= error "")
      (match (fixups/relax-aligned! (mut output)
                                    (mut labels)
                                    (mut branches)
                                    (mut relatives)
                                    (.alignment physical))
        (Err [message] (set! error message))
        (Ok [_] 0)))
    (when (= error "")
      (match (fixups/apply! (mut (.text output)) labels branches)
        (Err [msg] (set! error msg))
        (Ok [_] 0)))
    (when (= error "")
      (match (fixups/apply-relative! (mut (.text output)) labels relatives)
        (Err [msg] (set! error msg))
        (Ok [_] 0)))
    (release-stubs! (mut stubs))
    (free! (mut relatives))
    (free! (mut selected))
    (uses/release! (mut indexed-users))
    (free! (mut labels))
    (free! (mut branches))
    (transfer-index/release! (mut move-index))
    (free! (mut group))
    (if (= error "") (Ok output) (do (code/release! (mut output)) (Err error)))))

(defn body [(graph g/Graph)
            (scheduled schedule/Schedule)
            (assigned allocate/Assigned)
            (analysis live/Analysis)
            (requirements (ArrayList constraints/Value))
            (allocator (dyn Allocator))] (-> (Result code/Buffer (slice u8)))
  (match (matching/plain graph scheduled allocator)
    (Err [message] (Err message))
    (Ok [plan]
        (let [(mut plan) plan
              result
                (body-matched graph
                              scheduled
                              assigned
                              analysis
                              requirements
                              plan
                              allocator)]
          (matching/release! (mut plan))
          result))))

(defn switch! [(output (mut code/Buffer))
               (graph g/Graph)
               (assigned allocate/Assigned)
               (reference i32)
               (position i64)
               (indexed-users uses/Uses)
               (selected (ArrayList bool))
               (scheduled schedule/Schedule)
               (analysis live/Analysis)
               (labels (mut (ArrayList i64)))
               (branches (mut (ArrayList fixups/Branch)))
               (relatives (mut (ArrayList fixups/Relative)))
               (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (match (switch/collect graph reference indexed-users allocator)
    (Err [message] (Err message))
    (Ok [dispatch]
        (let [(mut owned) dispatch
              (mut stubs) (ArrayList::new [i32] allocator)
              (mut targets) (ArrayList::new [i32] allocator)
              (mut error) ""]
          (for item (.cases owned)
            (push! (mut targets) (.target item)))
          (push! (mut targets) (.fallback owned))
          (for target targets
            (when (not (get selected (cast i64 target)))
              (set! error "SWITCH projection omitted by observable roots"))
            (push! (mut stubs) (cast i32 (len labels)))
            (push! (mut labels) -1))
          (when (= error "")
            (match (value/register-with-locations! (mut output)
                                                   graph
                                                   (locations/indexed-view (.parts assigned)
                                                                           (.locations assigned))
                                                   (.selector owned)
                                                   position
                                                   16
                                                   62)
              (Err [message] (set! error message))
              (Ok [reg]
                  (emit/word! (mut (.text output))
                              (mut error)
                              (encode/extend true
                                             false
                                             (* 8
                                                (types/scalar-size (.ty owned)
                                                                   8))
                                             16
                                             reg))))
            (when (!= (switch/sign-mask (.ty owned)) 0)
              (match (constants/emit! (mut (.text output))
                                      true
                                      17
                                      (switch/sign-mask (.ty owned)))
                (Err [message] (set! error message))
                (Ok [_] 0))
              (emit/word! (mut (.text output))
                          (mut error)
                          (encode/logical-register true 2 16 16 17)))
            (switch-emit/dispatch! (mut output)
                                   owned
                                   stubs
                                   (get stubs (len (.cases owned)))
                                   (mut labels)
                                   (mut branches)
                                   (mut relatives)
                                   (mut error)))
          (let [(mut i) (: 0 i64)]
            (while (and (= error "") (< i (len targets)))
              (let [target (get targets i)]
                (set! (mut labels)
                      (cast i64 (get stubs i))
                      (len (.text output)))
                (match (edge! (mut output)
                              graph
                              assigned
                              scheduled
                              analysis
                              target
                              (+ position 1)
                              allocator)
                  (Err [message] (set! error message))
                  (Ok [_] 0))
                (switch-emit/branch! (mut output) (mut branches) target -1))
              (set! i (+ i 1))))
          (free! (mut targets))
          (free! (mut stubs))
          (free! (mut (.cases owned)))
          (if (= error "") (Ok 0) (Err error))))))

;;; The immutable matcher decided eligibility before liveness/allocation.
(defn tailcall! [(output (mut code/Buffer))
                 (graph g/Graph)
                 (assigned allocate/Assigned)
                 (matched matching/Plan)
                 (reference i32)
                 (position i64)
                 (size i64)
                 (preserve (slice locations/Transfer))
                 (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [mode (get (.modes (.tails matched)) (cast i64 reference))
        node (get (.instructions graph) (cast i64 reference))
        (mut error) ""
        begin (len (.text output))]
    (if (not (or (= mode 1) (= mode 2)))
        (Err "TAILCALL has no persistent lowering proof")
        (do
          (accept! (mut error)
                   (call/emit-call-mode-at-with-locations! (mut output)
                                                           graph
                                                           (locations/indexed-view (.parts assigned)
                                                                                   (.locations assigned))
                                                           reference
                                                           position
                                                           a
                                                           (.base assigned)
                                                           preserve
                                                           mode))
          (when (= error "")
            (if (= mode 2)
                (accept! (mut error) (epilogue! (mut output) assigned size))
                (do
                  (accept! (mut error)
                           (restore-frame! (mut output) assigned size))
                  (when (= error "")
                    (let [direct
                            (if (< (.op2 node) 0)
                                (match (g/lookup graph (.op2 node))
                                  (None [] false)
                                  (Some [callee] (= (n/opcode callee) 74)))
                                false)]
                      (accept! (mut error)
                               (if direct
                                   (code/direct-jump! (mut output)
                                                      graph
                                                      (.op2 node))
                                   (word! (mut output)
                                          (encode/branch-register 15)))))))))
          (if (= error "")
              (Ok (cast i32 (- (len (.text output)) begin)))
              (Err error))))))

(defn comparison-condition [(graph g/Graph) (reference i32)] (-> i32)
  (match (select/comparison graph reference)
    (Err [_] -1)
    (Ok [tile] (- (.rule tile) 20))))

;;; Native compilation passes the persistent pre-allocation selection here.
;;; Only full-width comparisons are fused by the current matcher.
(defn comparison-flags-selected! [(output (mut code/Buffer))
                                  (graph g/Graph)
                                  (assigned allocate/Assigned)
                                  (tile select/Tile)
                                  (position i64)]
  (-> (Result i32 (slice u8)))
  (if (not (.wide tile))
      (Err "fused comparison requires full-width operands")
      (match (emit/operand-register-with-locations! (mut output)
                                                    graph
                                                    (locations/indexed-view (.parts assigned)
                                                                            (.locations assigned))
                                                    (.left tile)
                                                    position
                                                    true
                                                    16)
        (Err [message] (Err message))
        (Ok [left]
            (match (if (= (.right tile) 0)
                       (Ok (: 0 i32))
                       (emit/operand-register-with-locations! (mut output)
                                                              graph
                                                              (locations/indexed-view (.parts assigned)
                                                                                      (.locations assigned))
                                                              (.right tile)
                                                              position
                                                              true
                                                              17))
              (Err [message] (Err message))
              (Ok [right]
                  (word! (mut output) (emit/comparison-word tile left right))))))))

;;; Compatibility entry selects from the unchanged graph. The pipeline uses
;;; comparison-flags-selected! with its stored tile instead.
(defn comparison-flags! [(output (mut code/Buffer))
                         (graph g/Graph)
                         (assigned allocate/Assigned)
                         (reference i32)
                         (position i64)]
  (-> (Result i32 (slice u8)))
  (match (select/comparison graph reference)
    (Err [message] (Err message))
    (Ok [tile]
        (comparison-flags-selected! (mut output) graph assigned tile position))))

(defn conditional! [(output (mut code/Buffer))
                    (graph g/Graph)
                    (assigned allocate/Assigned)
                    (reference i32)
                    (position i64)
                    (indexed-users uses/Uses)
                    (selected (ArrayList bool))
                    (scheduled schedule/Schedule)
                    (analysis live/Analysis)
                    (labels (mut (ArrayList i64)))
                    (branches (mut (ArrayList fixups/Branch)))
                    (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (conditional-matched! (mut output)
                        graph
                        assigned
                        reference
                        position
                        indexed-users
                        selected
                        scheduled
                        analysis
                        (mut labels)
                        (mut branches)
                        0
                        allocator))

(defn conditional-matched! [(output (mut code/Buffer))
                            (graph g/Graph)
                            (assigned allocate/Assigned)
                            (reference i32)
                            (position i64)
                            (indexed-users uses/Uses)
                            (selected (ArrayList bool))
                            (scheduled schedule/Schedule)
                            (analysis live/Analysis)
                            (labels (mut (ArrayList i64)))
                            (branches (mut (ArrayList fixups/Branch)))
                            (comparison i32)
                            (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut yes) (: 0 i32)
        (mut no) (: 0 i32)
        (mut r) 1]
    (let [range (get (.ranges indexed-users) (cast i64 reference))]
      (set! r 0)
      (while (< r (.count range))
        (let [edge (get (.edges indexed-users) (+ (.offset range) r))
              user (.user edge)
              node (get (.instructions graph) (cast i64 user))]
          (when (and (= (.operand edge) 1) (get selected (cast i64 user)))
            (when (= (n/opcode node) 107) (set! yes user))
            (when (= (n/opcode node) 108) (set! no user))))
        (set! r (+ r 1))))
    (if (or (= yes 0) (= no 0))
        (Err "IF requires both projections")
        (let [node (get (.instructions graph) (cast i64 reference))]
          (match (if (> comparison 0)
                     (comparison-flags! (mut output)
                                        graph
                                        assigned
                                        comparison
                                        position)
                     (truth/flags-with-locations! (mut output)
                                                  graph
                                                  (locations/indexed-view (.parts assigned)
                                                                          (.locations assigned))
                                                  (.op2 node)
                                                  position))
            (Err [msg] (Err msg))
            (Ok [_]
                (let [true-label (cast i32 (len labels))]
                  (push! (mut labels) -1)
                  (push! (mut branches)
                         (fixups/Branch
                           :offset (len (.text output))
                           :label true-label
                           :condition
                             (if (> comparison 0)
                                 (comparison-condition graph comparison)
                                 1)
                           :link false))
                  (bytes/append32! (mut (.text output)) 0)
                  (match (edge! (mut output)
                                graph
                                assigned
                                scheduled
                                analysis
                                no
                                (+ position 1)
                                allocator)
                    (Err [msg] (Err msg))
                    (Ok [_]
                        (do
                          (push! (mut branches)
                                 (fixups/Branch
                                   :offset (len (.text output))
                                   :label no
                                   :condition -1
                                   :link false))
                          (bytes/append32! (mut (.text output)) 0)
                          (set! (mut labels)
                                (cast i64 true-label)
                                (len (.text output)))
                          (match (edge! (mut output)
                                        graph
                                        assigned
                                        scheduled
                                        analysis
                                        yes
                                        (+ position 1)
                                        allocator)
                            (Err [msg] (Err msg))
                            (Ok [_]
                                (do
                                  (push! (mut branches)
                                         (fixups/Branch
                                           :offset (len (.text output))
                                           :label yes
                                           :condition -1
                                           :link false))
                                  (bytes/append32! (mut (.text output)) 0)
                                  (Ok 0))))))))))))))

(defn conditional-layout! [(output (mut code/Buffer))
                           (graph g/Graph)
                           (assigned allocate/Assigned)
                           (reference i32)
                           (position i64)
                           (indexed-users uses/Uses)
                           (selected (ArrayList bool))
                           (scheduled schedule/Schedule)
                           (analysis live/Analysis)
                           (labels (mut (ArrayList i64)))
                           (branches (mut (ArrayList fixups/Branch)))
                           (comparison i32)
                           (next i32)
                           (stubs (mut (ArrayList EdgeStub)))
                           (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (if (> comparison 0)
      (match (select/comparison graph comparison)
        (Err [message] (Err message))
        (Ok [tile]
            (conditional-layout-selected! (mut output)
                                          graph
                                          assigned
                                          reference
                                          position
                                          indexed-users
                                          selected
                                          scheduled
                                          analysis
                                          (mut labels)
                                          (mut branches)
                                          comparison
                                          tile
                                          next
                                          (mut stubs)
                                          allocator)))
      (conditional-layout-selected! (mut output)
                                    graph
                                    assigned
                                    reference
                                    position
                                    indexed-users
                                    selected
                                    scheduled
                                    analysis
                                    (mut labels)
                                    (mut branches)
                                    comparison
                                    (select/Tile
                                      :rule 0
                                      :wide false
                                      :left 0
                                      :right 0
                                      :immediate 0)
                                    next
                                    (mut stubs)
                                    allocator)))

(defn conditional-layout-selected! [(output (mut code/Buffer))
                                    (graph g/Graph)
                                    (assigned allocate/Assigned)
                                    (reference i32)
                                    (position i64)
                                    (indexed-users uses/Uses)
                                    (selected (ArrayList bool))
                                    (scheduled schedule/Schedule)
                                    (analysis live/Analysis)
                                    (labels (mut (ArrayList i64)))
                                    (branches (mut (ArrayList fixups/Branch)))
                                    (comparison i32)
                                    (tile select/Tile)
                                    (next i32)
                                    (stubs (mut (ArrayList EdgeStub)))
                                    (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut yes) (: 0 i32)
        (mut no) (: 0 i32)
        (mut r) 1]
    (let [range (get (.ranges indexed-users) (cast i64 reference))]
      (set! r 0)
      (while (< r (.count range))
        (let [edge (get (.edges indexed-users) (+ (.offset range) r))
              user (.user edge)
              node (get (.instructions graph) (cast i64 user))]
          (when (and (= (.operand edge) 1) (get selected (cast i64 user)))
            (when (= (n/opcode node) 107) (set! yes user))
            (when (= (n/opcode node) 108) (set! no user))))
        (set! r (+ r 1))))
    (if (or (= yes 0) (= no 0))
        (Err "IF requires both projections")
        (let [node (get (.instructions graph) (cast i64 reference))]
          (match (if (> comparison 0)
                     (comparison-flags-selected! (mut output)
                                                 graph
                                                 assigned
                                                 tile
                                                 position)
                     (truth/flags-with-locations! (mut output)
                                                  graph
                                                  (locations/indexed-view (.parts assigned)
                                                                          (.locations assigned))
                                                  (.op2 node)
                                                  position))
            (Err [msg] (Err msg))
            (Ok [_]
                (let [condition
                        (if (> comparison 0)
                            (- (.rule tile) 20)
                            1)
                      fallthrough (if (= next yes) yes no)
                      taken (if (= next yes) no yes)
                      branch-condition
                        (if (= next yes) (^ condition 1) condition)]
                  (match (conditional-edge! (mut output)
                                            graph
                                            assigned
                                            scheduled
                                            analysis
                                            taken
                                            (+ position 1)
                                            branch-condition
                                            (mut labels)
                                            (mut branches)
                                            (mut stubs)
                                            allocator)
                    (Err [message] (Err message))
                    (Ok [_]
                        (match (edge! (mut output)
                                      graph
                                      assigned
                                      scheduled
                                      analysis
                                      fallthrough
                                      (+ position 1)
                                      allocator)
                          (Err [message] (Err message))
                          (Ok [_]
                              (do
                                (when (!= fallthrough next)
                                  (switch-emit/branch! (mut output)
                                                       (mut branches)
                                                       fallthrough
                                                       -1))
                                (Ok 0)))))))))))))

;;; Edge transfers belong to their selected path. Empty transfers branch directly;
;;; nonempty transfers are emitted out of line so the other path can fall through.
(defn conditional-edge! [(output (mut code/Buffer))
                         (graph g/Graph)
                         (assigned allocate/Assigned)
                         (scheduled schedule/Schedule)
                         (analysis live/Analysis)
                         (target i32)
                         (position i64)
                         (condition i32)
                         (labels (mut (ArrayList i64)))
                         (branches (mut (ArrayList fixups/Branch)))
                         (stubs (mut (ArrayList EdgeStub)))
                         (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut transfer) (code/create allocator)]
    (match (edge! (mut transfer)
                  graph
                  assigned
                  scheduled
                  analysis
                  target
                  position
                  allocator)
      (Err [message] (do (code/release! (mut transfer)) (Err message)))
      (Ok [_]
          (let [label
                  (if (= (len (.text transfer)) 0)
                      target
                      (let [id (cast i32 (len labels))]
                        (push! (mut labels) -1)
                        (push! (mut stubs)
                               (EdgeStub
                                 :label id
                                 :target target
                                 :body transfer))
                        id))]
            (when (= label target) (code/release! (mut transfer)))
            (switch-emit/branch! (mut output) (mut branches) label condition)
            (Ok 0))))))

(defn edge! [(output (mut code/Buffer))
             (graph g/Graph)
             (assigned allocate/Assigned)
             (scheduled schedule/Schedule)
             (analysis live/Analysis)
             (target i32)
             (source-position i64)
             (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [state-index (get (.indices analysis) (cast i64 target))
        state (at (.states analysis) state-index)
        range (get (.ranges scheduled) (cast i64 target))
        source-ref (get (.nodes scheduled) (/ source-position 2))
        header (get (.instructions graph) (cast i64 target))
        count (get (.arities graph) (cast i64 target))
        (mut ordinal) (: 0 i32)
        (mut i) (: 1 i32)]
    (while (<= i count)
      (match (g/operand graph target i)
        (None [] 0)
        (Some [value] (when (= value source-ref) (set! ordinal i))))
      (set! i (+ i 1)))
    (match (edges/ordinary-indexed (.parts assigned)
                                   (.locations assigned)
                                   (.input state)
                                   source-position
                                   (* (.offset range) 2)
                                   allocator)
      (Err [msg] (Err msg))
      (Ok [moves]
          (let [(mut owned) moves
                (mut error) ""]
            (spill-homes/omit-established-stores! (mut owned) (.established-homes assigned))
            (match (edges/phis-indexed graph
                                       scheduled
                                       (.parts assigned)
                                       (.locations assigned)
                                       target
                                       ordinal
                                       source-position
                                       allocator)
              (Err [msg] (set! error msg))
              (Ok [group]
                  (let [(mut phis) group]
                    (for move (.moves phis) (push! (mut owned) move))
                    (match (typed-group! (mut (.text output))
                                         graph
                                         (slice owned)
                                         allocator
                                         (.base assigned))
                      (Err [msg] (set! error msg))
                      (Ok [_] 0))
                    (for literal (.literals phis)
                      (when (= error "")
                        (let [destination (.destination literal)
                              ty
                                (match (g/lookup graph (.reference literal))
                                  (None [] 0)
                                  (Some [constant]
                                        (cast i32 (n/type-id constant))))
                              simd? (registers/simd-type? ty)
                              size (types/size ty 8)
                              move-size (if (< size 4) 4 size)
                              reg
                                (if (= (.kind destination) 0)
                                    (cast i32 (.value destination))
                                    (if simd? 62 16))]
                          (match (value/constant! (mut output)
                                                  graph
                                                  (.reference literal)
                                                  reg
                                                  16)
                            (Err [msg] (set! error msg))
                            (Ok [_] 0))
                          (when (and (= error "") (= (.kind destination) 1))
                            (match (transfers/emit-addressed! (mut (.text output))
                                                              (locations/Location
                                                                :kind 0
                                                                :value
                                                                  (cast i64 reg))
                                                              destination
                                                              move-size
                                                              (if (= move-size
                                                                     16)
                                                                  63
                                                                  17)
                                                              (.base assigned)
                                                              16)
                              (Err [msg] (set! error msg))
                              (Ok [_] 0))))))
                    (edges/release-phis! (mut phis)))))
            (free! (mut owned))
            (if (= error "") (Ok 0) (Err error)))))))

(defn unconditional! [(output (mut code/Buffer))
                      (graph g/Graph)
                      (assigned allocate/Assigned)
                      (scheduled schedule/Schedule)
                      (analysis live/Analysis)
                      (reference i32)
                      (position i64)
                      (users uses/Uses)
                      (selected (ArrayList bool))
                      (branches (mut (ArrayList fixups/Branch)))
                      (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (unconditional-layout! (mut output)
                         graph
                         assigned
                         scheduled
                         analysis
                         reference
                         position
                         users
                         selected
                         (mut branches)
                         0
                         allocator))

(defn unconditional-layout! [(output (mut code/Buffer))
                             (graph g/Graph)
                             (assigned allocate/Assigned)
                             (scheduled schedule/Schedule)
                             (analysis live/Analysis)
                             (reference i32)
                             (position i64)
                             (users uses/Uses)
                             (selected (ArrayList bool))
                             (branches (mut (ArrayList fixups/Branch)))
                             (next i32)
                             (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [range (get (.ranges users) (cast i64 reference))
        (mut target) (: 0 i32)
        (mut i) 0]
    (while (< i (.count range))
      (let [edge (get (.edges users) (+ (.offset range) i))
            user (.user edge)
            node (get (.instructions graph) (cast i64 user))]
        (when (and (get selected (cast i64 user))
                   (op/block-start? (cast i32 (n/opcode node))))
          (set! target user)))
      (set! i (+ i 1)))
    (if (= target 0)
        (Err "block end has no scheduled successor")
        (match (edge! (mut output)
                      graph
                      assigned
                      scheduled
                      analysis
                      target
                      (+ position 1)
                      allocator)
          (Err [msg] (Err msg))
          (Ok [_]
              (do
                (when (!= target next)
                  (switch-emit/branch! (mut output) (mut branches) target -1))
                (Ok (if (= target next) 0 4))))))))

;;; FRAME_ADDR forces a real frame record even in a leaf function.
(defn frame-value-with-locations! [(output (mut code/Buffer))
                                   (parts locations/View)
                                   (reference i32)
                                   (position i64)
                                   (base frame-address/Base)]
  (-> (Result i32 (slice u8)))
  (if (or (not (frame-address/valid-base? base)) (!= (.reg base) 29))
      (Err "FRAME_ADDR requires an anchored frame")
      (match (locations/resolve parts reference (+ position 1))
        (Err [message] (Err message))
        (Ok [destination]
            (if (or (!= (.kind destination) 0)
                    (< (.value destination) 0)
                    (> (.value destination) 31)
                    (not (registers/allocatable? 6
                                                 (cast i32 (.value destination)))))
                (Err "frame address requires an allocatable GPR")
                (word! (mut output)
                       (encode/add-sub-immediate true
                                                 false
                                                 false
                                                 (cast i32 (.value destination))
                                                 29
                                                 0)))))))

(defn accept! [(error (mut (slice u8))) (result (Result i32 (slice u8)))]
  (-> void)
  (match result
    (Err [message] (when (= error "") (set! error message)))
    (Ok [_] 0)))

;;; Over-aligned frames keep original entry SP in x16 until its owned slot is
;;; installed. Every intervening address calculation uses x17 or x29 itself.
(defn prologue! [(output (mut code/Buffer))
                 (assigned allocate/Assigned)
                 (size i64)]
  (-> (Result i32 (slice u8)))
  (let [saved? (>= (.entry-slot assigned) 0)
        begin (len (.text output))
        (mut error) ""]
    (when saved?
      (accept! (mut error)
               (word! (mut output)
                      (encode/add-sub-immediate true false false 16 31 0))))
    (accept! (mut error)
             (frame-address/adjust! (mut (.text output))
                                    true
                                    size
                                    (if saved? 17 16)))
    (accept! (mut error)
             (frame-address/align-stack! (mut (.text output))
                                         (.alignment assigned)))
    (when (>= (.link-slot assigned) 0)
      (accept! (mut error)
               (frame-memory/access! (mut (.text output))
                                     false
                                     8
                                     29
                                     31
                                     (- (.link-slot assigned) 8)
                                     false
                                     (if saved? 17 16)))
      (accept! (mut error)
               (frame-memory/access! (mut (.text output))
                                     false
                                     8
                                     30
                                     31
                                     (.link-slot assigned)
                                     false
                                     (if saved? 17 16)))
      (accept! (mut error)
               (frame-address/address! (mut (.text output))
                                       29
                                       31
                                       (- (.link-slot assigned) 8))))
    (when saved?
      (accept! (mut error)
               (frame-memory/access! (mut (.text output))
                                     false
                                     8
                                     16
                                     31
                                     (.entry-slot assigned)
                                     false
                                     17)))
    (accept! (mut error)
             (callee/emit! (mut (.text output)) (.callee assigned) false))
    (if (= error "") (Ok (cast i32 (- (len (.text output)) begin))) (Err error))))

;;; Reconstruct fixed SP first. Saved entry SP stays in x17 while x16 addresses
;;; the previous FP/LR, then replaces SP exactly, including realignment padding.
(defn restore-frame! [(output (mut code/Buffer))
                      (assigned allocate/Assigned)
                      (size i64)]
  (-> (Result i32 (slice u8)))
  (let [begin (len (.text output))
        (mut error) ""]
    (accept! (mut error)
             (frame-address/restore! (mut (.text output)) (.base assigned)))
    (accept! (mut error)
             (callee/emit! (mut (.text output)) (.callee assigned) true))
    (when (>= (.entry-slot assigned) 0)
      (accept! (mut error)
               (frame-memory/access! (mut (.text output))
                                     true
                                     8
                                     17
                                     31
                                     (.entry-slot assigned)
                                     false
                                     16)))
    (when (>= (.link-slot assigned) 0)
      (accept! (mut error)
               (frame-memory/access! (mut (.text output))
                                     true
                                     8
                                     29
                                     31
                                     (- (.link-slot assigned) 8)
                                     false
                                     16))
      (accept! (mut error)
               (frame-memory/access! (mut (.text output))
                                     true
                                     8
                                     30
                                     31
                                     (.link-slot assigned)
                                     false
                                     16)))
    (if (>= (.entry-slot assigned) 0)
        (accept! (mut error)
                 (word! (mut output)
                        (encode/add-sub-immediate true false false 31 17 0)))
        (accept! (mut error)
                 (frame-address/adjust! (mut (.text output)) false size 16)))
    (if (= error "") (Ok (cast i32 (- (len (.text output)) begin))) (Err error))))

(defn epilogue! [(output (mut code/Buffer))
                 (assigned allocate/Assigned)
                 (size i64)]
  (-> (Result i32 (slice u8)))
  (match (restore-frame! (mut output) assigned size)
    (Err [message] (Err message))
    (Ok [bytes]
        (match (word! (mut output) (encode/ret 30))
          (Err [message] (Err message))
          (Ok [more] (Ok (+ bytes more)))))))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn frame-value! [(output (mut code/Buffer))
                    (parts (ArrayList allocation/Part))
                    (reference i32)
                    (position i64)
                    (base frame-address/Base)] (-> (Result i32 (slice u8)))
  (frame-value-with-locations! (mut output)
                               (locations/linear-view parts)
                               reference
                               position
                               base))
