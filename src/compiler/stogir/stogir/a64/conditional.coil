; Scalar COND lowering follows dstogov/ir ir_aarch64.dasc, 92171d0. See NOTICE.
(module stogir.a64.conditional)
(import "stogir.bytes" :as bytes)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.symbols" :as symbols)
(import "stogir.types" :as types)
(import "stogir.conditional" :as cond)
(import "stogir.allocation" :as a)
(import "stogir.locations" :as loc)
(import "stogir.a64.code" :as code)
(import "stogir.a64.value" :as value)
(import "stogir.a64.truth" :as truth)
(import "stogir.a64.vector-select" :as vector)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.select" :as select)
(import "stogir.a64.emit" :as emit)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.call-abi" :as abi)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn width [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (cond/validate graph reference)
    (Err [message] (Err message))
    (Ok [ty]
        (if (and (types/vector? ty) (not (types/short-vector? ty 8)))
            (Err "unsupported AArch64 vector selection width")
            (Ok (* 8 (types/size ty 8)))))))

;;; Literal integer 0/1 choices are exactly a condition-code result. Named
;;; addresses and nonliteral arms retain ordinary selection and relocations.
(defn boolean-choice [(graph g/Graph) (node n/Node)] (-> i32)
  (let [(mut choice) (: 0 i32)]
    (when (and (types/integer? (cast i32 (n/type-id node)))
               (< (.op2 node) 0)
               (< (.op3 node) 0))
      (match (g/lookup graph (.op2 node))
        (None [] 0)
        (Some [yes]
              (match (g/lookup graph (.op3 node))
                (None [] 0)
                (Some [no]
                      (when (and (symbols/numeric? yes)
                                 (symbols/numeric? no)
                                 (= (n/type-id yes) (n/type-id node))
                                 (= (n/type-id no) (n/type-id node)))
                        (cond (and (= (n/constant-bits yes) 1)
                                   (= (n/constant-bits no) 0))
                                (set! choice 1)
                              (and (= (n/constant-bits yes) 0)
                                   (= (n/constant-bits no) 1))
                                (set! choice 2)
                              :else 0)))))))
    choice))

;;; The tile is selected before liveness. Inputs remain live at the COND,
;;; and flags are captured before choice materialization reuses the scratches.
(defn comparison-flags! [(out (mut code/Buffer)) (graph g/Graph) (parts loc/View)
                         (tile select/Tile) (position i64)] (-> (Result i32 (slice u8)))
  (if (not (select/direct-comparison? graph tile))
      (Err "invalid fused select comparison")
      (match (emit/operand-register-with-locations! (mut out) graph parts (.left tile) position (.wide tile) 16)
        (Err [message] (Err message))
        (Ok [left]
          (match (if (= (.right tile) 0) (Ok (: 0 i32))
                     (emit/operand-register-with-locations! (mut out) graph parts (.right tile) position (.wide tile) 17))
            (Err [message] (Err message))
            (Ok [right]
              (match (emit/comparison-word tile left right)
                (Err [message] (Err message))
                (Ok [word] (bytes/append32! (mut (.text out)) word) (Ok (- (.rule tile) 20))))))))))

;;; COMPARISON is a persistent integer-word recipe, or rule zero for ordinary
;;; scalar truth. The matcher excludes vectors from comparison fusion.
;;; Capture flags before arm materialization. Typed MOV/FMOV and address loads
;;; preserve NZCV, including when all three inputs need the reserved scratches.
(defn emit-selected-with-locations! [(out (mut code/Buffer))
                            (graph g/Graph)
                            (parts loc/View)
                            (reference i32)
                            (position i64)
                            (comparison select/Tile)
                            (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (width graph reference)
    (Err [message] (Err message))
    (Ok [bits]
        (let [(mut temp) (code/create allocator)
              (mut error) ""
              node (get (.instructions graph) (cast i64 reference))
              choice (boolean-choice graph node)
              integer-select? (types/integer? (cast i32 (n/type-id node)))
              (mut yes) (: -1 i32)
              (mut no) (: -1 i32)
              (mut destination) (: -1 i32)
              (mut condition) (: 1 i32)]
          (match (if (= (.rule comparison) 0)
                     (match (truth/flags-with-locations! (mut temp) graph parts (.op1 node) position)
                       (Err [message] (Err message)) (Ok [_] (Ok (: 1 i32))))
                     (comparison-flags! (mut temp) graph parts comparison position))
            (Err [message] (set! error message))
            (Ok [cc] (set! condition cc)))
          ; CSEL reads source register 31 as WZR/XZR, so a literal integer
          ; zero arm needs no materialization.
          (when (= choice 0)
            (match (if (and integer-select? (emit/zero-literal? graph (.op2 node)))
                       (Ok (: 31 i32))
                       (value/register-with-locations! (mut temp)
                                                       graph
                                                       parts
                                                       (.op2 node)
                                                       position
                                                       16
                                                       62))
              (Err [message] (set! error message))
              (Ok [reg] (set! yes reg)))
            (match (if (and integer-select? (emit/zero-literal? graph (.op3 node)))
                       (Ok (: 31 i32))
                       (value/register-with-locations! (mut temp)
                                                       graph
                                                       parts
                                                       (.op3 node)
                                                       position
                                                       17
                                                       63))
              (Err [message] (set! error message))
              (Ok [reg] (set! no reg))))
          (match (loc/resolve parts reference (+ position 1))
            (Err [message] (set! error message))
            (Ok [location]
                (if (and (= (.kind location) 0)
                         (registers/allocatable? (cast i32 (n/type-id node))
                                                 (cast i32 (.value location))))
                    (set! destination (cast i32 (.value location)))
                    (set! error "COND result requires register of its class"))))
          (when (= error "")
            (if (> choice 0)
                (emit/word! (mut (.text temp))
                            (mut error)
                            (encode/conditional-set (= bits 64)
                                                    destination
                                                    (if (= choice 1) condition (^ condition 1))))
                (if (types/vector? (cast i32 (n/type-id node)))
                    (match (vector/emit-flags! (mut (.text temp))
                                               (cast i32 (n/type-id node))
                                               (- destination 32)
                                               (- yes 32)
                                               (- no 32))
                      (Err [message] (set! error message))
                      (Ok [_] 0))
                    (emit/word! (mut (.text temp))
                                (mut error)
                                (if (types/floating? (cast i32 (n/type-id node)))
                                    (encode/floating-select (= bits 64)
                                                            (- destination 32)
                                                            (- yes 32)
                                                            (- no 32)
                                                            condition)
                                    (encode/conditional-select (= bits 64)
                                                               destination
                                                               yes
                                                               no
                                                               condition)))))
            (when (= choice 0)
              (match (abi/normalize! (mut (.text temp))
                                     (n/type-id node)
                                     destination)
                (Err [message] (set! error message))
                (Ok [_] 0))))
          (let [count (cast i32 (len (.text temp)))]
            (when (and (= error "") (not (code/append! (mut out) temp)))
              (set! error "invalid COND code references"))
            (code/release! (mut temp))
            (if (= error "") (Ok count) (Err error)))))))

(defn emit-with-locations! [(out (mut code/Buffer)) (graph g/Graph) (parts loc/View)
                            (reference i32) (position i64) (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (emit-selected-with-locations! (mut out) graph parts reference position
    (select/Tile :rule 0 :wide false :left 0 :right 0 :immediate 0) allocator))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit! [(out (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList a/Part))
             (reference i32)
             (position i64)
             (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (emit-with-locations! (mut out)
                        graph
                        (loc/linear-view parts)
                        reference
                        position
                        allocator))
