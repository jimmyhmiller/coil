;;; AArch64 binary encoding primitives. Instruction words are host-independent.
(module stogir.a64.encode)
(import "coil.result" :use [Result Ok Err])

;;; BLR reads its target before updating x30. Register 31 is not a target.
(defn call-register [(target i32)] (-> (Result u32 (slice u8)))
  (if (or (< target 0) (> target 30))
      (Err "invalid AArch64 indirect call target")
      (Ok (| (: 0xD63F0000 u32) (<< (cast u32 target) 5)))))

(defn register? [(reg i32)] (-> bool)
  (and (>= reg 0) (<= reg 31)))

;;; AND Xd, Xn, #~((1<<bits)-1). Logical-immediate operands use ZR, not SP.
;;; The mask is one rotated run of ones in a 64-bit element; NZCV is preserved.
(defn clear-low-bits [(rd i32) (rn i32) (bits i32)]
  (-> (Result u32 (slice u8)))
  (if (or (not (register? rd)) (not (register? rn)) (< bits 1) (> bits 63))
      (Err "invalid AArch64 low-bit alignment mask")
      (Ok (| (: 0x92400000 u32)
             (<< (cast u32 (- 64 bits)) 16)
             (<< (cast u32 (- 63 bits)) 10)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; In shifted-register ADD/SUB, register 31 denotes ZR, never SP.
(defn add-sub [(wide bool)
               (subtract bool)
               (flags bool)
               (rd i32)
               (rn i32)
               (rm i32)] (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn) (register? rm)))
      (Err "invalid AArch64 register")
      (Ok (| (: 0x0B000000 u32)
             (if wide (: 0x80000000 u32) (: 0 u32))
             (if subtract (: 0x40000000 u32) (: 0 u32))
             (if flags (: 0x20000000 u32) (: 0 u32))
             (<< (cast u32 rm) 16)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; 64-bit extended-register ADD/SUB with UXTX and no shift. Register 31
;;; denotes SP in the base and destination, and XZR in the offset operand.
;;; This form preserves NZCV and can form addresses from SP using large offsets.
(defn add-sub-extended [(subtract bool) (rd i32) (rn i32) (rm i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn) (register? rm)))
      (Err "invalid AArch64 extended add/sub register")
      (Ok (| (: 0x8B206000 u32)
             (if subtract (: 0x40000000 u32) (: 0 u32))
             (<< (cast u32 rm) 16)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

(defn multiply [(wide bool) (rd i32) (rn i32) (rm i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn) (register? rm)))
      (Err "invalid AArch64 register")
      (Ok (| (: 0x1B007C00 u32)
             (if wide (: 0x80000000 u32) (: 0 u32))
             (<< (cast u32 rm) 16)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

(defn ret [(rn i32)] (-> (Result u32 (slice u8)))
  (if (or (< rn 0) (> rn 30))
      (Err "invalid return register")
      (Ok (| (: 0xD65F0000 u32) (<< (cast u32 rn) 5)))))

;;; Byte displacement is relative to this instruction, not the next one.
(defn branch [(link bool) (displacement i64)] (-> (Result u32 (slice u8)))
  (if (or (!= (% displacement 4) 0)
          (< displacement -134217728)
          (> displacement 134217724))
      (Err "unaligned or out-of-range AArch64 branch")
      (Ok (| (if link (: 0x94000000 u32) (: 0x14000000 u32))
             (& (cast u32 (/ displacement 4)) (: 0x03FFFFFF u32))))))

(defn conditional-branch [(condition i32) (displacement i64)]
  (-> (Result u32 (slice u8)))
  (if (or (< condition 0)
          (> condition 15)
          (!= (% displacement 4) 0)
          (< displacement -1048576)
          (> displacement 1048572))
      (Err "invalid AArch64 conditional branch")
      (Ok (| (: 0x54000000 u32)
             (cast u32 condition)
             (<< (& (cast u32 (/ displacement 4)) (: 0x7FFFF u32)) 5)))))

;;; kind: 0=MOVN, 2=MOVZ, 3=MOVK. Shift is a halfword index.
(defn move-wide [(wide bool) (kind i32) (rd i32) (immediate i32) (halfword i32)]
  (-> (Result u32 (slice u8)))
  (if (or (not (or (= kind 0) (= kind 2) (= kind 3)))
          (not (register? rd))
          (< immediate 0)
          (> immediate 65535)
          (< halfword 0)
          (> halfword (if wide 3 1)))
      (Err "invalid AArch64 wide move")
      (Ok (| (: 0x12800000 u32)
             (if wide (: 0x80000000 u32) (: 0 u32))
             (<< (cast u32 kind) 29)
             (<< (cast u32 halfword) 21)
             (<< (cast u32 immediate) 5)
             (cast u32 rd)))))

;;; Immediate is unsigned; subtract selects sign. Register 31 denotes SP for
;;; inputs and non-flag outputs, ZR for flag-setting outputs.
(defn add-sub-immediate [(wide bool)
                         (subtract bool)
                         (flags bool)
                         (rd i32)
                         (rn i32)
                         (immediate i64)]
  (-> (Result u32 (slice u8)))
  (if (or (not (register? rd))
          (not (register? rn))
          (< immediate 0)
          (and (> immediate 4095)
               (or (!= (% immediate 4096) 0) (> (/ immediate 4096) 4095))))
      (Err "invalid AArch64 add/sub immediate")
      (let [shifted (> immediate 4095)
            value (if shifted (/ immediate 4096) immediate)]
        (Ok (| (: 0x11000000 u32)
               (if wide (: 0x80000000 u32) (: 0 u32))
               (if subtract (: 0x40000000 u32) (: 0 u32))
               (if flags (: 0x20000000 u32) (: 0 u32))
               (if shifted (: 0x00400000 u32) (: 0 u32))
               (<< (cast u32 value) 10)
               (<< (cast u32 rn) 5)
               (cast u32 rd))))))

;;; Unsigned byte offset scaled by transfer width. Base register 31 is SP;
;;; transfer register 31 is ZR. Signed loads have separate encodings.
(defn load-store [(load? bool) (size i32) (rt i32) (rn i32) (offset i64)]
  (-> (Result u32 (slice u8)))
  (if (or (not (or (= size 1) (= size 2) (= size 4) (= size 8)))
          (not (register? rt))
          (not (register? rn))
          (< offset 0))
      (Err "invalid AArch64 load/store operands")
      (if (or (!= (% offset (cast i64 size)) 0)
              (> (/ offset (cast i64 size)) 4095))
          (Err "invalid AArch64 scaled memory offset")
          (let [scale (if (= size 1) 0 (if (= size 2) 1 (if (= size 4) 2 3)))]
            (Ok (| (: 0x39000000 u32)
                   (<< (cast u32 scale) 30)
                   (if load? (: 0x00400000 u32) (: 0 u32))
                   (<< (cast u32 (/ offset (cast i64 size))) 10)
                   (<< (cast u32 rn) 5)
                   (cast u32 rt)))))))

;;; kind: 0=AND, 1=ORR, 2=EOR, 3=ANDS. Registers 31 denote ZR.
(defn logical-register [(wide bool) (kind i32) (rd i32) (rn i32) (rm i32)]
  (-> (Result u32 (slice u8)))
  (if (or (< kind 0)
          (> kind 3)
          (not (and (register? rd) (register? rn) (register? rm))))
      (Err "invalid AArch64 logical operands")
      (Ok (| (: 0x0A000000 u32)
             (if wide (: 0x80000000 u32) (: 0 u32))
             (<< (cast u32 kind) 29)
             (<< (cast u32 rm) 16)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

(defn conditional-set [(wide bool) (rd i32) (condition i32)]
  (-> (Result u32 (slice u8)))
  (if (or (not (register? rd)) (< condition 0) (> condition 13))
      (Err "invalid AArch64 conditional set")
      (Ok (| (: 0x1A9F07E0 u32)
             (if wide (: 0x80000000 u32) (: 0 u32))
             (<< (cast u32 (^ condition 1)) 12)
             (cast u32 rd)))))

;;; CSETM produces all-one bits when the condition holds; 31 denotes ZR.
(defn conditional-set-mask [(wide bool) (rd i32) (condition i32)]
  (-> (Result u32 (slice u8)))
  (if (or (not (register? rd)) (< condition 0) (> condition 13))
      (Err "invalid AArch64 conditional mask")
      (Ok (| (: 0x5A9F03E0 u32)
             (if wide (: 0x80000000 u32) (: 0 u32))
             (<< (cast u32 (^ condition 1)) 12)
             (cast u32 rd)))))

;;; kind 0=LSLV, 1=LSRV, 2=ASRV, 3=RORV. Hardware masks counts by width.
(defn variable-shift [(wide bool) (kind i32) (rd i32) (rn i32) (rm i32)]
  (-> (Result u32 (slice u8)))
  (if (or (< kind 0)
          (> kind 3)
          (not (and (register? rd) (register? rn) (register? rm))))
      (Err "invalid AArch64 variable shift")
      (Ok (| (: 0x1AC02000 u32)
             (if wide (: 0x80000000 u32) (: 0 u32))
             (<< (cast u32 kind) 10)
             (<< (cast u32 rm) 16)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; Signed scaled load. Byte/halfword may extend to W or X; word extends to X.
(defn signed-load [(wide bool) (size i32) (rt i32) (rn i32) (offset i64)]
  (-> (Result u32 (slice u8)))
  (if (or (not (or (= size 1) (= size 2) (and (= size 4) wide)))
          (not (register? rt))
          (not (register? rn))
          (< offset 0))
      (Err "invalid signed load")
      (if (or (!= (% offset (cast i64 size)) 0)
              (> (/ offset (cast i64 size)) 4095))
          (Err "invalid signed load offset")
          (let [scale (if (= size 1) 0 (if (= size 2) 1 2))]
            (Ok (| (: 0x39800000 u32)
                   (<< (cast u32 scale) 30)
                   (if wide (: 0 u32) (: 0x00400000 u32))
                   (<< (cast u32 (/ offset (cast i64 size))) 10)
                   (<< (cast u32 rn) 5)
                   (cast u32 rt)))))))

;;; Low-bit extraction with signed/unsigned extension to 32 or 64 bits.
(defn extend [(wide bool) (signed? bool) (bits i32) (rd i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (if (or (< bits 1)
          (> bits (if wide 64 32))
          (not (register? rd))
          (not (register? rn)))
      (Err "invalid integer extension")
      (Ok (| (if signed? (: 0x13000000 u32) (: 0x53000000 u32))
             (if wide (: 0x80400000 u32) (: 0 u32))
             (<< (cast u32 (- bits 1)) 10)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; Immediate LSL/LSR/ASR use the bitfield encodings, with architectural
;;; word-width counts already normalized by selection.
(defn shift-immediate [(wide bool) (kind i32) (rd i32) (rn i32) (amount i32)]
  (-> (Result u32 (slice u8)))
  (let [bits (if wide (: 64 i32) (: 32 i32))]
    (if (or (< kind 0)
            (> kind 2)
            (< amount 0)
            (>= amount bits)
            (not (register? rd))
            (not (register? rn)))
        (Err "invalid immediate shift")
        (Ok (| (if (= kind 2) (: 0x13000000 u32) (: 0x53000000 u32))
               (if wide (: 0x80400000 u32) (: 0 u32))
               (<< (cast u32 (if (= kind 0) (% (- bits amount) bits) amount))
                   16)
               (<< (cast u32 (if (= kind 0) (- (- bits 1) amount) (- bits 1)))
                   10)
               (<< (cast u32 rn) 5)
               (cast u32 rd))))))

;;; Integer divide truncates toward zero for signed operands. A64 does not trap
;;; on zero or signed overflow; those cases are not folded by the IR builder.
(defn divide [(wide bool) (signed? bool) (rd i32) (rn i32) (rm i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn) (register? rm)))
      (Err "invalid AArch64 divide register")
      (Ok (| (: 0x1AC00800 u32)
             (if wide (: 0x80000000 u32) (: 0 u32))
             (if signed? (: 0x400 u32) (: 0 u32))
             (<< (cast u32 rm) 16)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; rd = ra - rn * rm, with register-width wrapping and simultaneous sources.
(defn multiply-subtract [(wide bool) (rd i32) (rn i32) (rm i32) (ra i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn) (register? rm) (register? ra)))
      (Err "invalid AArch64 multiply-subtract register")
      (Ok (| (: 0x1B008000 u32)
             (if wide (: 0x80000000 u32) (: 0 u32))
             (<< (cast u32 rm) 16)
             (<< (cast u32 ra) 10)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

(defn invert [(wide bool) (rd i32) (rn i32)] (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn)))
      (Err "invalid invert register")
      (Ok (| (: 0x2A2003E0 u32)
             (if wide (: 0x80000000 u32) (: 0 u32))
             (<< (cast u32 rn) 16)
             (cast u32 rd)))))

(defn conditional-negate [(wide bool) (rd i32) (rn i32) (condition i32)]
  (-> (Result u32 (slice u8)))
  (if (or (not (and (register? rd) (register? rn)))
          (< condition 0)
          (> condition 13))
      (Err "invalid conditional negate operands")
      (Ok (| (: 0x5A800400 u32)
             (if wide (: 0x80000000 u32) (: 0 u32))
             (<< (cast u32 rn) 16)
             (<< (cast u32 (^ condition 1)) 12)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; kind: 0=RBIT, 1=REV16 (W only), 2=REV32 (W only), 3=REV64 (X only), 4=CLZ.
(defn unary-bits [(wide bool) (kind i32) (rd i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (if (or (not (and (register? rd) (register? rn)))
          (< kind 0)
          (> kind 4)
          (and wide (or (= kind 1) (= kind 2)))
          (and (not wide) (= kind 3)))
      (Err "invalid unary bit operands")
      (Ok (| (: 0x5AC00000 u32)
             (if wide (: 0x80000000 u32) (: 0 u32))
             (<< (cast u32 kind) 10)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; Scalar SIMD/GPR transfers zero the other SIMD lanes when writing S/D.
(defn scalar-transfer [(wide bool) (to-simd? bool) (rd i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn)))
      (Err "invalid scalar transfer register")
      (Ok (| (: 0x1E260000 u32)
             (if wide (: 0x80400000 u32) (: 0 u32))
             (if to-simd? (: 0x10000 u32) (: 0 u32))
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; Baseline Advanced SIMD byte population count / horizontal byte sum.
(defn vector-byte-count [(sum? bool) (rd i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn)))
      (Err "invalid vector byte-count register")
      (Ok (| (if sum? (: 0x0E31B800 u32) (: 0x0E205800 u32))
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; Logical register form with an LSL source shift (31 denotes ZR).
(defn logical-shifted [(wide bool)
                       (kind i32)
                       (rd i32)
                       (rn i32)
                       (rm i32)
                       (shift i32)]
  (-> (Result u32 (slice u8)))
  (if (or (< shift 0) (>= shift (if wide 64 32)))
      (Err "logical register shift outside width")
      (match (logical-register wide kind rd rn rm)
        (Err [message] (Err message))
        (Ok [word] (Ok (| word (<< (cast u32 shift) 10)))))))

;;; CSEL reads both sources before writing its destination; 31 denotes ZR.
(defn conditional-select [(wide bool)
                          (rd i32)
                          (yes i32)
                          (no i32)
                          (condition i32)]
  (-> (Result u32 (slice u8)))
  (if (or (not (and (register? rd) (register? yes) (register? no)))
          (< condition 0)
          (> condition 13))
      (Err "invalid conditional select operands")
      (Ok (| (: 0x1A800000 u32)
             (if wide (: 0x80000000 u32) (: 0 u32))
             (<< (cast u32 no) 16)
             (<< (cast u32 condition) 12)
             (<< (cast u32 yes) 5)
             (cast u32 rd)))))

;;; Full 32x32 product in Xd (SMULL / UMULL aliases with Ra=ZR).
(defn multiply-long [(signed? bool) (rd i32) (rn i32) (rm i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn) (register? rm)))
      (Err "invalid multiply-long register")
      (Ok (| (if signed? (: 0x9B207C00 u32) (: 0x9BA07C00 u32))
             (<< (cast u32 rm) 16)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; High half of the signed/unsigned 64x64 product.
(defn multiply-high [(signed? bool) (rd i32) (rn i32) (rm i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn) (register? rm)))
      (Err "invalid multiply-high register")
      (Ok (| (if signed? (: 0x9B407C00 u32) (: 0x9BC07C00 u32))
             (<< (cast u32 rm) 16)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

(defn arithmetic-shift-immediate [(wide bool) (rd i32) (rn i32) (shift i32)]
  (-> (Result u32 (slice u8)))
  (if (or (not (and (register? rd) (register? rn)))
          (< shift 0)
          (>= shift (if wide 64 32)))
      (Err "invalid arithmetic shift immediate")
      (Ok (| (if wide (: 0x93400000 u32) (: 0x13000000 u32))
             (<< (cast u32 shift) 16)
             (if wide (: 0xFC00 u32) (: 0x7C00 u32))
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; Scalar FMOV within the SIMD register bank (physical v0..v31).
(defn floating-move [(wide bool) (rd i32) (rn i32)] (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn)))
      (Err "invalid scalar SIMD move register")
      (Ok (| (: 0x1E204000 u32)
             (if wide (: 0x400000 u32) (: 0 u32))
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; Raw SIMD register move. A 16-byte value needs ORR Vd.16B,Vn.16B,Vn.16B;
;;; scalar FMOV would discard its upper half. Smaller values retain FMOV.
(defn simd-move [(size i32) (rd i32) (rn i32)] (-> (Result u32 (slice u8)))
  (if (= size 16)
      (if (not (and (register? rd) (register? rn)))
          (Err "invalid SIMD move register")
          (Ok (| (: 0x4EA01C00 u32)
                 (<< (cast u32 rn) 16)
                 (<< (cast u32 rn) 5)
                 (cast u32 rd))))
      (if (or (= size 4) (= size 8))
          (floating-move (= size 8) rd rn)
          (Err "invalid SIMD move width"))))

;;; SIMD unsigned scaled offset loads/stores, including complete Q registers.
;;; Base register31 denotes SP. The register number is physical v0..v31.
(defn floating-load-store [(load? bool)
                           (size i32)
                           (rt i32)
                           (rn i32)
                           (offset i64)]
  (-> (Result u32 (slice u8)))
  (if (or (not (or (= size 4) (= size 8) (= size 16)))
          (not (register? rt))
          (not (register? rn))
          (< offset 0))
      (Err "invalid SIMD memory operands")
      (if (or (!= (% offset (cast i64 size)) 0)
              (> (/ offset (cast i64 size)) 4095))
          (Err "invalid SIMD scaled memory offset")
          (Ok (| (if (= size 16)
                     (: 0x3D800000 u32)
                     (if (= size 8) (: 0xFD000000 u32) (: 0xBD000000 u32)))
                 (if load? (: 0x400000 u32) (: 0 u32))
                 (<< (cast u32 (/ offset (cast i64 size))) 10)
                 (<< (cast u32 rn) 5)
                 (cast u32 rt))))))

;;; Scalar FCVT between single and double precision; source/destination may alias.
(defn floating-convert [(widen? bool) (rd i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn)))
      (Err "invalid scalar floating conversion register")
      (Ok (| (if widen? (: 0x1E22C000 u32) (: 0x1E624000 u32))
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; Scalar IEEE arithmetic, no fast-math or fused-operation substitutions.
(defn floating-binary [(wide bool) (opcode i32) (rd i32) (rn i32) (rm i32)]
  (-> (Result u32 (slice u8)))
  (if (or (< opcode 26)
          (> opcode 29)
          (not (and (register? rd) (register? rn) (register? rm))))
      (Err "invalid scalar floating arithmetic operands")
      (Ok (| (match opcode
               (26 (: 0x1E202800 u32))
               (27 (: 0x1E203800 u32))
               (28 (: 0x1E200800 u32))
               (_ (: 0x1E201800 u32)))
             (if wide (: 0x400000 u32) (: 0 u32))
             (<< (cast u32 rm) 16)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

(defn floating-unary [(wide bool) (absolute? bool) (rd i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn)))
      (Err "invalid scalar floating unary operands")
      (Ok (| (if absolute? (: 0x1E20C000 u32) (: 0x1E214000 u32))
             (if wide (: 0x400000 u32) (: 0 u32))
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

(defn floating-compare [(wide bool) (rn i32) (rm i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rn) (register? rm)))
      (Err "invalid scalar floating compare operands")
      (Ok (| (: 0x1E202000 u32)
             (if wide (: 0x400000 u32) (: 0 u32))
             (<< (cast u32 rm) 16)
             (<< (cast u32 rn) 5)))))

(defn floating-select [(wide bool) (rd i32) (rn i32) (rm i32) (condition i32)]
  (-> (Result u32 (slice u8)))
  (if (or (not (and (register? rd) (register? rn) (register? rm)))
          (< condition 0)
          (> condition 13))
      (Err "invalid scalar floating select operands")
      (Ok (| (: 0x1E200C00 u32)
             (if wide (: 0x400000 u32) (: 0 u32))
             (<< (cast u32 rm) 16)
             (<< (cast u32 condition) 12)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

(defn floating-compare-zero [(wide bool) (rn i32)] (-> (Result u32 (slice u8)))
  (if (not (register? rn))
      (Err "invalid scalar floating truth register")
      (Ok (| (: 0x1E202008 u32)
             (if wide (: 0x400000 u32) (: 0 u32))
             (<< (cast u32 rn) 5)))))

(defn integer-to-floating [(floating-wide bool)
                           (integer-wide bool)
                           (signed? bool)
                           (rd i32)
                           (rn i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn)))
      (Err "invalid integer-to-floating registers")
      (Ok (| (if signed? (: 0x1E220000 u32) (: 0x1E230000 u32))
             (if floating-wide (: 0x400000 u32) (: 0 u32))
             (if integer-wide (: 0x80000000 u32) (: 0 u32))
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; Explicit toward-zero conversion; out-of-range target results are not folded.
(defn floating-to-integer [(floating-wide bool)
                           (integer-wide bool)
                           (signed? bool)
                           (rd i32)
                           (rn i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rd) (register? rn)))
      (Err "invalid floating-to-integer registers")
      (Ok (| (if signed? (: 0x1E380000 u32) (: 0x1E390000 u32))
             (if floating-wide (: 0x400000 u32) (: 0 u32))
             (if integer-wide (: 0x80000000 u32) (: 0 u32))
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

;;; ADR forms PC+signed byte displacement. It never reads SP or changes flags.
(defn address-relative [(rd i32) (displacement i64)]
  (-> (Result u32 (slice u8)))
  (if (or (< rd 0) (> rd 30) (< displacement -1048576) (> displacement 1048575))
      (Err "invalid AArch64 ADR destination or displacement")
      (Ok (| (: 0x10000000 u32)
             (cast u32 rd)
             (<< (& (cast u32 displacement) 3) 29)
             (<< (& (>> (cast u32 displacement) 2) 0x7FFFF) 5)))))

;;; LDRSW Xt,[Xn,Xm,LSL #2]. The base may be SP; index/result 31 denote ZR.
(defn load-signed-word-indexed [(rt i32) (rn i32) (rm i32)]
  (-> (Result u32 (slice u8)))
  (if (not (and (register? rt) (register? rn) (register? rm)))
      (Err "invalid AArch64 indexed signed-word load")
      (Ok (| (: 0xB8A07800 u32)
             (<< (cast u32 rm) 16)
             (<< (cast u32 rn) 5)
             (cast u32 rt)))))

(defn branch-register [(rn i32)] (-> (Result u32 (slice u8)))
  (if (or (< rn 0) (> rn 30))
      (Err "invalid AArch64 indirect branch target")
      (Ok (| (: 0xD61F0000 u32) (<< (cast u32 rn) 5)))))

(defn breakpoint [(immediate i32)] (-> (Result u32 (slice u8)))
  (if (or (< immediate 0) (> immediate 65535))
      (Err "invalid AArch64 breakpoint immediate")
      (Ok (| (: 0xD4200000 u32) (<< (cast u32 immediate) 5)))))
