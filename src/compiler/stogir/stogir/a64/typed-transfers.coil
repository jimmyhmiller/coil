;;; Mixed-width simultaneous physical copies; all widths share one cycle plan.
(module stogir.a64.typed-transfers)
(import "stogir.a64.transfers" :as transfers)
(import "stogir.a64.frame-address" :as frame)
(import "stogir.locations" :as loc)
(import "stogir.moves" :as moves)
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Copy [(transfer loc/Transfer) (size i32)])

;;; Sort only a validation copy. Dense location IDs retain their original order.
(defn sift! [(values (mut (ArrayList i64))) (root i64) (end i64)] (-> void)
  (let [(mut root) root
        (mut done) false]
    (while (and (not done) (< root (/ end 2)))
      (let [left (+ (* root 2) 1)
            right (+ left 1)
            child
              (if (and (< right end) (> (get values right) (get values left)))
                  right
                  left)]
        (if (>= (get values root) (get values child))
            (set! done true)
            (let [saved (get values root)]
              (set! (mut values) root (get values child))
              (set! (mut values) child saved)
              (set! root child)))))))

(defn sort! [(values (mut (ArrayList i64)))] (-> void)
  (let [(mut root) (/ (len values) 2)
        (mut end) (len values)]
    (while (> root 0) (set! root (- root 1)) (sift! (mut values) root end))
    (while (> end 1)
      (set! end (- end 1))
      (let [saved (get values 0)]
        (set! (mut values) 0 (get values end))
        (set! (mut values) end saved))
      (sift! (mut values) 0 end))))

(defn location [(id i32) (slots (ArrayList i64))] (-> loc/Location)
  (loc/Location
    :kind (if (< id 64) 0 1)
    :value (if (< id 64) (cast i64 id) (get slots (cast i64 (- id 64))))))

;;; v31 retains a cycle source at its complete required width. v30 is separate
;;; memory data scratch for16-byte moves; x17 handles smaller memory values and
;;; x16 materializes addresses. These four locations must be absent from input.
;;; Stack IDs at distinct offsets must have nonoverlapping declared extents.
;;; Validation and emission are transactional with respect to output bytes.
(defn parallel-frame! [(output (mut (ArrayList u8)))
                       (copies (slice Copy))
                       (allocator (dyn Allocator))
                       (base frame/Base)]
  (-> (Result i32 (slice u8)))
  (let [(mut abstract) (ArrayList::new [moves/SizedMove] allocator)
        (mut slots) (ArrayList::new [i64] allocator)
        (mut extents) (ArrayList::new [i32] allocator)
        (mut ordered) (ArrayList::new [i64] allocator)
        (mut indices) (HashMap::new-scalar [i64 i32] allocator)
        (mut temporary) (ArrayList::new [u8] allocator)
        (mut error)
          (if (frame/valid-base? base) "" "invalid typed transfer frame base")]
    (for copy copies
      (let [size (.size copy)
            transfer (.transfer copy)
            inputs [(.source transfer) (.destination transfer)]
            (mut source) (: -1 i32)
            (mut destination) (: -1 i32)]
        (when (and (> (len copies) 0)
                   (!= (.position transfer)
                       (.position (.transfer (get copies 0)))))
          (set! error "typed parallel copies belong to different positions"))
        (when (not (or (= size 4) (= size 8) (= size 16)))
          (set! error "invalid typed transfer extent"))
        (for input inputs
          (when (or (not (transfers/width-location? input size))
                    (and (= (.kind input) 0)
                         (or (= (.value input) 16)
                             (= (.value input) 17)
                             (= (.value input) 62)
                             (= (.value input) 63))))
            (set! error "invalid typed transfer location or reserved scratch"))
          (when (and (= (.kind input) 1) (> size 0))
            (when (or (< (.value input) (.bias base))
                      (> (.value input) (- 0x7FFFFFFFFFFFFFFF (cast i64 size))))
              (set! error "invalid typed transfer stack extent"))))
        (when (= error "")
          (match (transfers/location-id! (.source transfer)
                                         (mut slots)
                                         (mut indices))
            (Err [message] (set! error message))
            (Ok [id] (set! source id)))
          (match (transfers/location-id! (.destination transfer)
                                         (mut slots)
                                         (mut indices))
            (Err [message] (set! error message))
            (Ok [id] (set! destination id)))
          (while (< (len extents) (len slots)) (push! (mut extents) 0))
          (for id [source destination]
            (when (and (>= id 64) (> size (get extents (cast i64 (- id 64)))))
              (set! (mut extents) (cast i64 (- id 64)) size)))
          (push! (mut abstract)
                 (moves/SizedMove
                   :source source
                   :destination destination
                   :size size)))))
    (when (= error "")
      (for offset slots (push! (mut ordered) offset))
      (sort! (mut ordered))
      (let [(mut i) (: 1 i64)]
        (while (< i (len ordered))
          (let [prior (get ordered (- i 1))
                current (get ordered i)
                extent
                  (match (get indices prior)
                    (Some [id] (get extents (cast i64 (- id 64))))
                    (None [] 0))]
            (when (> (+ prior (cast i64 extent)) current)
              (set! error "overlapping typed transfer stack identities")))
          (set! i (+ i 1)))))
    (when (= error "")
      (match (moves/resolve-sized (slice abstract) 63 allocator)
        (Err [message] (set! error message))
        (Ok [plan]
            (let [(mut plan) plan]
              (for move plan
                (when (= error "")
                  (match (transfers/emit-addressed! (mut temporary)
                                                    (location (.source move)
                                                              slots)
                                                    (location (.destination move)
                                                              slots)
                                                    (.size move)
                                                    (if (= (.size move) 16)
                                                        62
                                                        17)
                                                    base
                                                    16)
                    (Err [message] (set! error message))
                    (Ok [_] 0))))
              (free! (mut plan))))))
    (let [count (cast i32 (len temporary))]
      (when (= error "") (for byte temporary (push! (mut output) byte)))
      (free! (mut abstract))
      (free! (mut slots))
      (free! (mut extents))
      (free! (mut ordered))
      (free! (mut indices))
      (free! (mut temporary))
      (if (= error "") (Ok count) (Err error)))))
