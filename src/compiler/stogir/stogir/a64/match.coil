                                 ; 64-bit LOAD nothing else reads: the LOAD
                                 ; accesses the word in the extended form.
                                 (word-view-load? graph counts protected omitted blocks reference)
                                   (let [load (.op1 (get (.instructions graph) (cast i64 view)))]
                                     (set! (mut tiles) (cast i64 load)
                                           (select/Tile :rule 57 :wide false :left 0 :right 0
