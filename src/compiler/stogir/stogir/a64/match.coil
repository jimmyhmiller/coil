;;; Persistent target rules, built after scheduling and before virtual-register
;;; liveness. References continue to identify the original Sea-of-Nodes nodes.
(module stogir.a64.match)
(import "stogir.fill" :as fill)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.uses" :as uses)
(import "stogir.schedule" :as schedule)
(import "stogir.matched-uses" :as machine)
(import "stogir.conditional" :as conditional)
(import "stogir.nonnegative" :as nonnegative)
(import "stogir.a64.select" :as select)
(import "stogir.a64.address" :as address)
(import "stogir.a64.memory" :as memory)
(import "stogir.a64.tail-plan" :as tail-plan)
(import "stogir.a64.static-stack" :as static-stack)
(import "stogir.a64.word-constant" :as word-constant)
(import "stogir.a64.result-projections" :as result-projections)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

;;; exact-decrements lists SUB/ADD-literal nodes proven not to overflow as
;;; signed subtractions (nonnegative/decrement-exact?); only those an IF may
;;; compare with zero through GT/LE are examined. Usually empty.
(defstruct Plan
  [(operands machine/Plan)
   (tiles (ArrayList select/Tile))
   (comparisons (ArrayList i32))
   (addresses (ArrayList i32))
   (offsets (ArrayList i64))
   (indices (ArrayList i32))
   (index-shifts (ArrayList i32))
   (doubles (ArrayList i32))
   (extractions (ArrayList i32))
   (tails tail-plan/Plan)
   (static-sizes (ArrayList i64))
   (exact-decrements (ArrayList i32))])

(defn scalar-tile? [(graph g/Graph) (node n/Node)] (-> bool)
  (let [opcode (cast i32 (n/opcode node))]
    (if (and (>= opcode 14) (<= opcode 23))
        (match (g/lookup graph (.op1 node))
          (Some [left] (types/integer? (cast i32 (n/type-id left))))
          (None [] false))
        (and (types/integer? (cast i32 (n/type-id node)))
             (or (and (>= opcode 26) (<= opcode 30))
                 (and (>= opcode 46) (<= opcode 53))
                 (= opcode 58)
                 (= opcode 59))))))

;;; An operand emission may have to build in x16/x17: a literal, a frame
;;; address or a constant view. Conservative; allocated values never need one.
(defn scratch-operand? [(graph g/Graph) (reference i32)] (-> bool)
  (or (<= reference 0)
      (let [node (get (.instructions graph) (cast i64 reference))]
        (or (= (n/opcode node) 81)
            (and (or (= (n/opcode node) 36) (= (n/opcode node) 68))
                 (< (.op1 node) 0))))))

;;; A register MUL whose only use is the consumer in its own block. MADD and
;;; MSUB have two scratch registers for their three sources.
(defn fusable-product? [(graph g/Graph) (tiles (ArrayList select/Tile))
                        (counts (ArrayList i64)) (protected (ArrayList bool))
                        (omitted (ArrayList bool)) (blocks (ArrayList i32))
                        (consumer i64) (product i32) (addend i32)] (-> bool)
  (and (> product 0) (> addend 0) (!= product addend)
       (let [index (cast i64 product) tile (get tiles index)]
         (and (= (.rule tile) 3)
              (= (.wide tile) (.wide (get tiles consumer)))
              (= (get counts index) 1)
              (not (get protected index))
              (not (get omitted index))
              (= (get blocks index) (get blocks consumer))
              (<= (+ (if (scratch-operand? graph addend) 1 0)
                     (if (scratch-operand? graph (.left tile)) 1 0)
                     (if (scratch-operand? graph (.right tile)) 1 0))
                  2)))))

;;; An X-form, or W-form word, integer comparison of one register value with
;;; an encodable immediate. Repeating it at a later use needs only that value,
;;; which SSA dominance supplies; RLOAD inputs are pinned to their original
;;; position. The value of a narrowed comparison is its extension's source.
(defn immediate-comparison? [(graph g/Graph) (tile select/Tile) (reference i32)] (-> bool)
  (and (select/direct-comparison? graph tile)
       (= (.right tile) 0) (> (.left tile) 0)
       (conditional/movable-condition? graph reference)))

;;; For EQ/NE(ZEXT(Boolean integer comparison), 0), the inner comparison;
;;; otherwise zero. Floating predicates are excluded: scalar-tile? selects
;;; integer comparisons only, and their inversion would need unordered codes.
(defn truth-source [(graph g/Graph) (tiles (ArrayList select/Tile)) (tile select/Tile)] (-> i32)
  (if (and (or (= (.rule tile) 20) (= (.rule tile) 21)) (.wide tile)
           (= (.right tile) 0) (= (.immediate tile) 0) (> (.left tile) 0))
      (let [view (get (.instructions graph) (cast i64 (.left tile)))
            inner (.op1 view)]
        (if (and (= (n/opcode view) 34) (> inner 0)
                 (= (n/type-id (get (.instructions graph) (cast i64 inner))) 1)
                 (>= (.rule (get tiles (cast i64 inner))) 20)
                 (<= (.rule (get tiles (cast i64 inner))) 33))
            inner
            0))
      0))

;;; The flags recipe of a fused IF or COND: an IF may carry its own (possibly
;;; inverted) recipe; otherwise the absorbed comparison's selected tile.
(defn condition-tile [(plan Plan) (reference i32)] (-> select/Tile)
  (let [own (get (.tiles plan) (cast i64 reference))]
    (if (and (>= (.rule own) 20) (<= (.rule own) 33))
        own
        (get (.tiles plan) (cast i64 (get (.comparisons plan) (cast i64 reference)))))))

;;; A plan borrows graph references and becomes invalid after graph mutation.
;;; Branch fusion mirrors IR_CMP_AND_BRANCH_INT: a single-use, unobserved,
;;; same-block full-width integer comparison is consumed by its IF, and with
;;; fuse-selects by an integer COND. Beyond upstream, a comparison with an
;;; encodable immediate is repeated at every IF/COND user wherever it was
;;; placed, and IF(EQ/NE(ZEXT(such a comparison), 0)) uses its flags directly.
;;; The comparison keeps its definition only while another user needs the
;;; Boolean. Other rules keep ordinary def/uses.
;;; idom is indexed by block-start reference (pipeline dominators); an empty
;;; list restricts signed power-of-two division proofs to expression structure.
(defn build-with-selects [(graph g/Graph)
             (scheduled schedule/Schedule)
             (idom (ArrayList i32))
             (roots (slice i32))
             (fuse bool)
             (fuse-selects bool)
             (a (dyn Allocator))] (-> (Result Plan (slice u8)))
  (let [(mut tiles) (ArrayList::new [select/Tile] a)
        (mut comparisons) (ArrayList::new [i32] a)
        (mut addresses) (ArrayList::new [i32] a)
        (mut offsets) (ArrayList::new [i64] a)
        (mut indices) (ArrayList::new [i32] a)
        (mut index-shifts) (ArrayList::new [i32] a)
        (mut doubles) (ArrayList::new [i32] a)
        (mut extractions) (ArrayList::new [i32] a)
        (mut tails) (tail-plan/empty a)
        (mut has-tail) false
        (mut omitted) (ArrayList::new [bool] a)
        (mut blocks) (ArrayList::new [i32] a)
        (mut counts) (ArrayList::new [i64] a)
        (mut protected) (ArrayList::new [bool] a)
        (mut retired) (ArrayList::new [i32] a)
        (mut word-views) (ArrayList::new [i32] a)
        (mut choices) (ArrayList::new [i32] a)
        (mut selects) (ArrayList::new [i32] a)
        (mut narrowable) (ArrayList::new [i32] a)
        (mut narrow-tiles) (ArrayList::new [select/Tile] a)
        (mut narrow-users) (ArrayList::new [i32] a)
        (mut narrow-switches) (ArrayList::new [i32] a)
        (mut wide-switches) (ArrayList::new [i32] a)
        (mut exact-decrements) (ArrayList::new [i32] a)
        (mut block) (: 0 i32)
        (mut error) ""]
    ; One sized allocation per per-cell table instead of a growing push each.
    (let [cells (len (.instructions graph))]
      (fill/append! (mut tiles)
                    cells
                    (select/Tile
                      :rule 0
                      :wide false
                      :left 0
                      :right 0
                      :immediate 0))
      (extend-zeroed! (mut comparisons) cells)
      (extend-zeroed! (mut addresses) cells)
      (extend-zeroed! (mut offsets) cells)
      (extend-zeroed! (mut indices) cells)
      (extend-zeroed! (mut index-shifts) cells)
      (extend-zeroed! (mut doubles) cells)
      (extend-zeroed! (mut extractions) cells)
      (extend-zeroed! (mut omitted) cells)
      (extend-zeroed! (mut blocks) cells)
      (extend-zeroed! (mut counts) cells)
      (extend-zeroed! (mut protected) cells))
    (for root roots
      (when (and (> root 0) (< (cast i64 root) (len protected)))
        (set! (mut protected) (cast i64 root) true)))
    (let [items-1 (.nodes scheduled) (mut for-index-1) (: 0 i64)] (while (< for-index-1 (len items-1)) (let [reference (get items-1 for-index-1)]
      (let [index (cast i64 reference)
            node (get (.instructions graph) index)]
        (when (op/block-start? (cast i32 (n/opcode node)))
          (set! block reference))
        (set! (mut blocks) index block)
        ; Discover recipes in the existing node walk. Most nodes cannot be
        ; address BITCASTs, so do not call the recipe helper on every node.
        (when (and fuse (= (n/opcode node) 36) (< (.op1 node) 0)
                   (< (word-constant/source graph reference) 0))
          (push! (mut word-views) reference))
        (for [j 1 (+ (cast i64 (get (.arities graph) index)) 1)]
          (when (uses/edge-code? (op/operand-code (cast i32 (n/opcode node))
                                                  (cast i32 j)))
            (match (g/operand graph reference (cast i32 j))
              (Some [value]
                    (when (> value 0)
                      (set! (mut counts)
                            (cast i64 value)
                            (+ (get counts (cast i64 value)) 1))))
              (None [] 0))))
        (when (or (= (n/opcode node) 80)
                  (and fuse
                       (> (.function-prototype graph) 0)
                       (= (n/opcode node) 120)
                       (> (.op1 node) 0)
                       (= (n/opcode (get (.instructions graph)
                                         (cast i64 (.op1 node))))
                          79)))
          (set! has-tail true))
        ; A SWITCH on a word extension can dispatch on the source word when
        ; every case literal is itself such an extension.
        (when (and fuse (>= (n/opcode node) 109) (<= (n/opcode node) 117))
          (cond (= (n/opcode node) 117)
                  (when (> (select/switch-extension graph node) 0)
                    (push! (mut narrow-switches) reference))
                (<= (n/opcode node) 110)
                  (let [source (get (.instructions graph) (cast i64 (.op1 node)))
                        selector (if (= (n/opcode source) 117)
                                     (select/switch-extension graph source)
                                     0)]
                    (when (and (> selector 0)
                               (not (and (select/word-case? graph selector (.op2 node))
                                         (or (= (n/opcode node) 109)
                                             (select/word-case? graph selector (.op3 node))))))
                      (push! (mut wide-switches) (.op1 node))))
                :else 0))
        ; Discover choices in the existing walk; no extra whole-schedule scan.
        (when (and (= (n/opcode node) 60) fuse (= error ""))
          (match (select/ordered-choice graph reference)
            (None [] 0)
            (Some [tile]
              (set! (mut tiles) index tile)
              (push! (mut choices) reference))))
        (when (scalar-tile? graph node)
          (match (select/select graph reference)
            (Err [message] (set! error message))
            ; A signed power-of-two DIV/MOD of a dividend proven non-negative
            ; at this block equals the unsigned one: a single LSR or AND.
            (Ok [tile]
              (set! (mut tiles) index
                    (if (and fuse (or (= (.rule tile) 45) (= (.rule tile) 47))
                             (>= (types/scalar-size (cast i32 (n/type-id node)) 8) 4)
                             (nonnegative/proven? graph idom block (.left tile)))
                        (select/Tile :rule (- (.rule tile) 1) :wide (.wide tile)
                                     :left (.left tile) :right 0
                                     :immediate (.immediate tile))
                        tile))
              ; Only a 64-bit comparison of an extension can be narrowed.
              (when (and fuse (.wide tile) (>= (.rule tile) 20) (<= (.rule tile) 33)
                         (or (select/word-extension? graph (.left tile))
                             (select/word-extension? graph (.right tile))))
                (push! (mut narrowable) reference))))))) (set! for-index-1 (+ for-index-1 1))))
    ; Remove only each consumed Boolean edge. Shared/protected comparisons
    ; remain definitions; no new arithmetic edges are speculated.
    (for reference choices
      (let [node (get (.instructions graph) (cast i64 reference))
            tile (get tiles (cast i64 reference))
            condition (cast i64 (.op1 node))
            values [(.left tile) (.right tile)]]
        (set! (mut counts) condition (- (get counts condition) 1))
        (when (and (= (get counts condition) 0) (not (get protected condition)))
          (set! (mut omitted) condition true)
          (for value values
            (when (> value 0)
              (set! (mut counts) (cast i64 value)
                    (- (get counts (cast i64 value)) 1)))))))
    ; Compare and dispatch on the 32-bit sources of SEXT/ZEXT directly. An
    ; extension is retired only when every machine use is such a comparison
    ; or SWITCH; otherwise all of them keep the extended value, which is then
    ; free to read. Take each candidate's extension edges, then return those
    ; of rejected candidates until every remaining extension has no other use.
    (for reference wide-switches
      (for [i 0 (len narrow-switches)]
        (when (= (get narrow-switches i) reference)
          (set! (mut narrow-switches) i 0))))
    (free! (mut wide-switches))
    (when (and (> (+ (len narrowable) (len narrow-switches)) 0) (= error ""))
      (for [i 0 (len narrow-switches)]
        (let [reference (get narrow-switches i)]
          (when (> reference 0)
            (let [selector (cast i64 (.op2 (get (.instructions graph) (cast i64 reference))))]
              (set! (mut counts) selector (- (get counts selector) 1))))))
      (for [i 0 (len narrowable)]
        (let [reference (get narrowable i)
              tile (get tiles (cast i64 reference))]
          (push! (mut narrow-tiles) tile)
          (match (if (get omitted (cast i64 reference)) (None)
                     (select/narrowed-comparison graph tile))
            (None [] (set! (mut narrowable) i 0))
            (Some [narrow]
              (set! (mut narrow-tiles) i narrow)
              (when (!= (.left narrow) (.left tile))
                (set! (mut counts) (cast i64 (.left tile))
                      (- (get counts (cast i64 (.left tile))) 1)))
              (when (!= (.right narrow) (.right tile))
                (set! (mut counts) (cast i64 (.right tile))
                      (- (get counts (cast i64 (.right tile))) 1)))))))
      (let [(mut stable) false]
        (while (not stable)
          (set! stable true)
          (for [i 0 (len narrowable)]
            (let [reference (get narrowable i)]
              (when (> reference 0)
                (let [tile (get tiles (cast i64 reference))
                      narrow (get narrow-tiles i)
                      left? (!= (.left narrow) (.left tile))
                      right? (!= (.right narrow) (.right tile))]
                  (when (or (and left?
                                 (or (!= (get counts (cast i64 (.left tile))) 0)
                                     (get protected (cast i64 (.left tile)))))
                            (and right?
                                 (or (!= (get counts (cast i64 (.right tile))) 0)
                                     (get protected (cast i64 (.right tile))))))
                    (when left?
                      (set! (mut counts) (cast i64 (.left tile))
                            (+ (get counts (cast i64 (.left tile))) 1)))
                    (when right?
                      (set! (mut counts) (cast i64 (.right tile))
                            (+ (get counts (cast i64 (.right tile))) 1)))
                    (set! (mut narrowable) i 0)
                    (set! stable false))))))
          (for [i 0 (len narrow-switches)]
            (let [reference (get narrow-switches i)]
              (when (> reference 0)
                (let [selector (cast i64 (.op2 (get (.instructions graph) (cast i64 reference))))]
                  (when (or (!= (get counts selector) 0) (get protected selector))
                    (set! (mut counts) selector (+ (get counts selector) 1))
                    (set! (mut narrow-switches) i 0)
                    (set! stable false))))))))
      (for reference narrow-switches
        (when (> reference 0)
          (let [selector (cast i64 (.op2 (get (.instructions graph) (cast i64 reference))))
                source (cast i64 (.op1 (get (.instructions graph) selector)))]
            (set! (mut counts) source (+ (get counts source) 1))
            (unless (get omitted selector)
              (set! (mut omitted) selector true)
              (set! (mut counts) source (- (get counts source) 1)))
            (push! (mut narrow-users) reference))))
      ; Each absorbed edge now reads the source; a retired extension gives
      ; up its own source edge exactly once.
      (for [i 0 (len narrowable)]
        (let [reference (get narrowable i)]
          (when (> reference 0)
            (let [tile (get tiles (cast i64 reference))
                  narrow (get narrow-tiles i)
                  extensions [(.left tile) (.right tile)]
                  sources [(.left narrow) (.right narrow)]]
              (for [j 0 2]
                (let [extension (get extensions j)
                      source (cast i64 (get sources j))]
                  (when (!= (get sources j) extension)
                    (set! (mut counts) source (+ (get counts source) 1))
                    (unless (get omitted (cast i64 extension))
                      (set! (mut omitted) (cast i64 extension) true)
                      (set! (mut counts) source (- (get counts source) 1))))))
              (set! (mut tiles) (cast i64 reference) narrow))))))
    (free! (mut narrow-tiles))
    (free! (mut narrow-switches))
    (when (and fuse (= error ""))
      (let [items-2 (.nodes scheduled) (mut for-index-2) (: 0 i64)] (while (< for-index-2 (len items-2)) (let [reference (get items-2 for-index-2)]
        (let [node (get (.instructions graph) (cast i64 reference))
              selection (and fuse-selects (= (n/opcode node) 60)
                             (types/integer? (cast i32 (n/type-id node)))
                             (= (.rule (get tiles (cast i64 reference))) 0))
              source (if selection (.op1 node) (.op2 node))]
          (when (and (or selection (= (n/opcode node) 116)) (> source 0))
            (let [index (cast i64 source)
                  tile (get tiles index)]
              ; IF(value > 0) or IF(value <= 0): a decrement that reaches the
              ; test, directly or through a PHI, may set the flags itself
              ; when it is exact. The emitter checks the actual words.
              (when (and (= (n/opcode node) 116) (> (len idom) 0)
                         (or (= (.rule tile) 32) (= (.rule tile) 33))
                         (= (.right tile) 0) (= (.immediate tile) 0) (> (.left tile) 0))
                (let [value (.left tile)
                      tested (get (.instructions graph) (cast i64 value))]
                  (if (= (n/opcode tested) 67)
                      (for [slot 2 (+ (cast i64 (get (.arities graph) (cast i64 value))) 1)]
                        (match (g/operand graph value (cast i32 slot))
                          (None [] 0)
                          (Some [input]
                            (when (and (> input 0)
                                       (nonnegative/decrement-exact?
                                         graph idom (get blocks (cast i64 input)) input 4095))
                              (push! (mut exact-decrements) input)))))
                      (when (nonnegative/decrement-exact?
                              graph idom (get blocks index) value 4095)
                        (push! (mut exact-decrements) value)))))
              (let [inner (if selection 0 (truth-source graph tiles tile))
                    inverted (and (> inner 0)
                                  (immediate-comparison? graph (get tiles (cast i64 inner)) inner))]
                (if (and (not inverted)
                         (= (get counts index) 1)
                         (not (get protected index))
                         (= (get blocks index)
                            (get blocks (cast i64 reference)))
                         (select/direct-comparison? graph tile)
                         (or (not selection) (conditional/movable-condition? graph source)))
                    (do
                      (set! (mut omitted) index true)
                      (set! (mut comparisons) (cast i64 reference) source)
                      (unless (.wide tile) (push! (mut narrow-users) reference))
                      (when selection (push! (mut selects) reference)))
                    (if inverted
                        ; IF(EQ/NE(ZEXT(comparison), 0)) branches on the inner
                        ; flags, inverted for EQ. Each absorbed edge is released
                        ; in turn; a still-used link keeps its definition.
                        (let [base (get tiles (cast i64 inner))
                              operand (cast i64 (.left base))
                              (mut link) source
                              (mut live) true]
                          (set! (mut comparisons) (cast i64 reference) inner)
                          (unless (.wide base) (push! (mut narrow-users) reference))
                          (set! (mut tiles) (cast i64 reference)
                                (select/Tile :rule (if (= (.rule tile) 20)
                                                       (+ 20 (^ (- (.rule base) 20) 1))
                                                       (.rule base))
                                             :wide (.wide base) :left (.left base) :right 0
                                             :immediate (.immediate base)))
                          (set! (mut counts) operand (+ (get counts operand) 1))
                          (while live
                            (let [slot (cast i64 link)]
                              (set! (mut counts) slot (- (get counts slot) 1))
                              (if (and (= (get counts slot) 0) (not (get protected slot)))
                                  (do
                                    (set! (mut omitted) slot true)
                                    (if (= link inner)
                                        (do
                                          (set! (mut counts) operand (- (get counts operand) 1))
                                          (set! live false))
                                        (set! link (if (= link source) (.left tile) inner))))
                                  (set! live false)))))
                        ; A shared or earlier-placed comparison with an encodable
                        ; immediate is repeated at each IF and word COND: its one
                        ; register input replaces the Boolean one-for-one in every
                        ; live range, so pressure never grows. Two-register forms
                        ; stay Booleans unless single-use in the same block.
                        (when (and (or selection (= (n/opcode node) 116))
                                   (immediate-comparison? graph tile source))
                          (set! (mut comparisons) (cast i64 reference) source)
                          (unless (.wide tile) (push! (mut narrow-users) reference))
                          (when selection (push! (mut selects) reference))
                          (set! (mut counts) index (- (get counts index) 1))
                          (if (and (= (get counts index) 0) (not (get protected index)))
                              (set! (mut omitted) index true)
                              (set! (mut counts) (cast i64 (.left tile))
                                    (+ (get counts (cast i64 (.left tile))) 1))))))))))) (set! for-index-2 (+ for-index-2 1)))))
    ; TRUNC(SHR/SAR) extracts a field; SHL(SHR/SAR) with matching counts
    ; clears low bits with one AND; SEXT/ZEXT of a word TRUNC view extends the
    ; low word of the view's source. Each selects a single machine input.
    ; UBFX clears every bit above its field, so ZEXT of an extracted field is
    ; that same extraction; its TRUNC was visited first in schedule order.
    ; Redirect each use first, then retire a producer only after all actual
    ; edges have been absorbed. Shared and rooted shifts remain definitions.
    (when (and fuse (= error ""))
      (let [items-3 (.nodes scheduled) (mut for-index-3) (: 0 i64)] (while (< for-index-3 (len items-3)) (let [reference (get items-3 for-index-3)]
        (let [opcode (n/opcode (get (.instructions graph) (cast i64 reference)))]
        (when (or (= opcode 35) (= opcode 49)
                  (and (or (= opcode 33) (= opcode 34))
                       (not (get omitted (cast i64 reference)))))
          (match (cond (= opcode 35) (select/extraction graph reference)
                       (= opcode 49) (select/shift-mask graph reference)
                       :else
                         ; Only for the last reader of the TRUNC: reading
                         ; past a TRUNC that stays would keep its source live
                         ; across it and cost the copy that a view avoids.
                         (let [view (.op1 (get (.instructions graph) (cast i64 reference)))]
                           (cond (or (<= view 0) (!= (get counts (cast i64 view)) 1)
                                     (get protected (cast i64 view)))
                                   (None)
                                 (> (get extractions (cast i64 view)) 0)
                                   (if (and (= opcode 34)
                                            (= (.rule (get tiles (cast i64 view))) 48)
                                            (= (n/opcode (get (.instructions graph) (cast i64 view)))
                                               35))
                                       (Some (get tiles (cast i64 view)))
                                       (None))
                                 :else (select/word-view-extension graph reference))))
            (None [] 0)
            (Some [tile]
                  (let [index (cast i64 reference)
                        producer (.op1 (get (.instructions graph) index))
                        input (.left tile)]
                    (when (= (get blocks index)
                             (get blocks (cast i64 producer)))
                      (set! (mut tiles) index tile)
                      (set! (mut extractions) index input)
                      (set! (mut counts)
                            (cast i64 input)
                            (+ (get counts (cast i64 input)) 1))
                      (set! (mut counts)
                            (cast i64 producer)
                            (- (get counts (cast i64 producer)) 1))
                      (when (= (get counts (cast i64 producer)) 0)
                        (push! (mut retired) producer))))))))) (set! for-index-3 (+ for-index-3 1)))))
    ; Every absorbed memory edge is replaced with its base before liveness.
    ; Keep a shared/rooted ADD unless all of its actual uses were absorbed.
    (when (and fuse (= error ""))
      (let [items-4 (.nodes scheduled) (mut for-index-4) (: 0 i64)] (while (< for-index-4 (len items-4)) (let [reference (get items-4 for-index-4)]
        (let [node (get (.instructions graph) (cast i64 reference))
              opcode (n/opcode node)]
          (when (and (>= opcode 91) (<= opcode 94))
            (match (memory/size graph reference)
              (Err [message] (set! error message))
              (Ok [width]
                  (match (address/select graph (.op2 node) width)
                    (None []
                      (match (address/select-indexed graph (.op2 node) width)
                        (None []
                          (match (address/select-view graph (.op2 node) width)
                            (None [] 0)
                            (Some [chosen]
                              (set! (mut addresses) (cast i64 reference) (.base chosen))
                              (let [original (cast i64 (.op2 node)) base (cast i64 (.base chosen))]
                                (set! (mut counts) original (- (get counts original) 1))
                                (set! (mut counts) base (+ (get counts base) 1))
                                (when (= (get counts original) 0)
                                  (push! (mut retired) (.op2 node)))))))
                        (Some [chosen]
                          (set! (mut addresses) (cast i64 reference) (.base chosen))
                          (set! (mut indices) (cast i64 reference) (.index chosen))
                          (set! (mut index-shifts) (cast i64 reference) (.shift chosen))
                          (let [original (cast i64 (.op2 node))]
                            (set! (mut counts) original (- (get counts original) 1))
                            (let [base-slot (cast i64 (.base chosen))
                                  index-slot (cast i64 (.index chosen))]
                              (set! (mut counts) base-slot (+ (get counts base-slot) 1))
                              (set! (mut counts) index-slot (+ (get counts index-slot) 1)))
                            (when (= (get counts original) 0)
                              (push! (mut retired) (.op2 node)))))))
                    (Some [chosen]
                          (set! (mut addresses)
                                (cast i64 reference)
                                (.base chosen))
                          (set! (mut offsets)
                                (cast i64 reference)
                                (.offset chosen))
                          (let [index (cast i64 (.op2 node))]
                            (set! (mut counts) index (- (get counts index) 1))
                            (let [base (cast i64 (.base chosen))]
                              (set! (mut counts) base (+ (get counts base) 1)))
                            (when (= (get counts index) 0)
                              (push! (mut retired) (.op2 node))))))))))) (set! for-index-4 (+ for-index-4 1)))))
    ; Independent target extension: absorb a same-block constant word shift
    ; into ADD/SUB before liveness. Keep shared/rooted producer definitions.
    (when (and fuse (= error ""))
      (let [items-5 (.nodes scheduled) (mut for-index-5) (: 0 i64)] (while (< for-index-5 (len items-5)) (let [reference (get items-5 for-index-5)]
        (let [index (cast i64 reference) tile (get tiles index)
              node (get (.instructions graph) index)
              width (types/scalar-size (cast i32 (n/type-id node)) 8)]
          (when (and (not (get omitted index))
                     (or (> (get counts index) 0) (get protected index))
                     (or (= (.rule tile) 1) (= (.rule tile) 2)) (or (= width 4) (= width 8)))
            (let [(mut producer) (.right tile) (mut other) (.left tile)]
              (when (and (= (.rule tile) 1)
                         (or (<= producer 0)
                             (< (.rule (get tiles (cast i64 producer))) 38)
                             (> (.rule (get tiles (cast i64 producer))) 40)))
                (set! producer (.left tile)) (set! other (.right tile)))
              (when (> producer 0)
                (let [shift (get tiles (cast i64 producer))]
                  (when (and (>= (.rule shift) 38) (<= (.rule shift) 40)
                             (> (.left shift) 0)
                             (= (.wide shift) (.wide tile))
                             (= (get blocks index) (get blocks (cast i64 producer)))
                             (> other 0))
                    (set! (mut tiles) index
                      (select/Tile :rule (+ (.rule tile) 49) :wide (.wide tile)
                        :left other :right (.left shift)
                        :immediate (| (<< (cast u64 (- (.rule shift) 38)) 8) (.immediate shift))))
                    (set! (mut counts) (cast i64 (.left shift))
                          (+ (get counts (cast i64 (.left shift))) 1))
                    (set! (mut counts) (cast i64 producer) (- (get counts (cast i64 producer)) 1))
                    (when (= (get counts (cast i64 producer)) 0)
                      (push! (mut retired) producer))))))
            ; Independent target extension: ADD/SUB of a single-use same-block
            ; register MUL is one MADD/MSUB. All three sources are exposed to
            ; liveness below; the retired MUL releases its own operand edges.
            (let [current (get tiles index)]
              (when (or (= (.rule current) 1) (= (.rule current) 2))
                (let [(mut product) (: 0 i32) (mut addend) (: 0 i32)]
                  (if (fusable-product? graph tiles counts protected omitted blocks
                                        index (.right current) (.left current))
                      (do (set! product (.right current)) (set! addend (.left current)))
                      (when (and (= (.rule current) 1)
                                 (fusable-product? graph tiles counts protected omitted blocks
                                                   index (.left current) (.right current)))
                        (set! product (.left current)) (set! addend (.right current))))
                  (when (> product 0)
                    (let [multiply (get tiles (cast i64 product))
                          sources [(.left multiply) (.right multiply)]]
                      (set! (mut tiles) index
                        (select/Tile :rule (+ (.rule current) 53) :wide (.wide current)
                          :left addend :right (.left multiply)
                          :immediate (cast u64 (cast i64 (.right multiply)))))
                      (for value sources
                        (when (> value 0)
                          (set! (mut counts) (cast i64 value)
                                (+ (get counts (cast i64 value)) 1))))
                      (set! (mut counts) (cast i64 product) 0)
                      (push! (mut retired) product))))))))) (set! for-index-5 (+ for-index-5 1)))))
    ; Retire only pure word expressions whose last original edge was absorbed.
    ; Count replacement base edges before cascading, so shared bases stay live.
    (let [(mut cursor) 0]
      (while (< cursor (len retired))
        (let [reference (get retired cursor)
              index (cast i64 reference)
              node (get (.instructions graph) index)]
          (when (and (= (get counts index) 0)
                     (not (get protected index))
                     (not (get omitted index))
                     (or (and (address/word? (n/type-id node))
                              (or (= (n/opcode node) 26)
                                  (and (= (n/opcode node) 36)
                                       (match (g/lookup graph (.op1 node))
                                         (Some [source]
                                               (address/word? (n/type-id source)))
                                         (None [] false)))))
                         (and (types/integer? (cast i32 (n/type-id node)))
                              (or (= (types/scalar-size (cast i32
                                                              (n/type-id node))
                                                        8)
                                     4)
                                  (= (types/scalar-size (cast i32
                                                              (n/type-id node))
                                                        8)
                                     8))
                              (or (= (n/opcode node) 28) (= (n/opcode node) 49)
                                  (= (n/opcode node) 50) (= (n/opcode node) 51)))
                         ; A TRUNC whose extensions all read its source.
                         (and (= (n/opcode node) 35)
                              (types/integer? (cast i32 (n/type-id node))))))
            (set! (mut omitted) index true)
            ; Fused unary and shifted ADD/SUB tiles already replaced their
            ; uses. Retirement must subtract those selected edges, including
            ; when a later address match absorbs a selected shift-mask tile.
            (let [tile (get tiles index)
                  unary (get extractions index)
                  shifted? (or (= (.rule tile) 50) (= (.rule tile) 51))]
             (for [j 1 (+ (cast i64 (if (> unary 0) 1
                                       (if shifted? 2 (get (.arities graph) index)))) 1)]
              (match (if (> unary 0) (Some unary)
                         (if shifted?
                             (Some (if (= j 1) (.left tile) (.right tile)))
                             (g/operand graph reference (cast i32 j))))
                (Some [value]
                      (when (> value 0)
                        (let [input (cast i64 value)]
                          (set! (mut counts) input (- (get counts input) 1))
                          (when (= (get counts input) 0)
                            (push! (mut retired) value)))))
                (None [] 0))))))
        (set! cursor (+ cursor 1))))
    (free! (mut retired))
    (when (and fuse (= error ""))
      (let [items-6 (.nodes scheduled) (mut for-index-6) (: 0 i64)] (while (< for-index-6 (len items-6)) (let [reference (get items-6 for-index-6)]
        (let [node (get (.instructions graph) (cast i64 reference))]
          (when (and (= (n/opcode node) 28)
                     (types/vector? (cast i32 (n/type-id node))))
            (let [source (select/doubling-source graph reference)]
              (when (> source 0)
                (set! (mut doubles) (cast i64 reference) source)
                (let [constant
                        (if (= source (.op1 node)) (.op2 node) (.op1 node))
                      index (cast i64 constant)]
                  (set! (mut counts) index (- (get counts index) 1))
                  (when (and (= (get counts index) 0)
                             (not (get protected index)))
                    (set! (mut omitted) index true)))))))) (set! for-index-6 (+ for-index-6 1)))))
    (when (and has-tail (= error ""))
      (match (tail-plan/select graph scheduled roots fuse a)
        (Err [message] (set! error message))
        (Ok [owned]
            (set! tails owned)
            (for reference (.returns tails)
              (set! (mut omitted) (cast i64 reference) true)))))
    (free! (mut counts))
    (if (!= error "")
        (do
          (free! (mut blocks))
          (free! (mut protected))
          (free! (mut word-views))
          (free! (mut narrowable))
          (free! (mut narrow-users))
          (free! (mut choices))
          (free! (mut selects))
          (free! (mut tiles))
          (free! (mut comparisons))
          (free! (mut addresses))
          (free! (mut offsets))
          (free! (mut indices))
          (free! (mut index-shifts))
          (free! (mut doubles))
          (free! (mut extractions))
          (free! (mut omitted))
          (free! (mut exact-decrements))
          (tail-plan/release! (mut tails))
          (Err error))
        (let [(mut static-sizes) (static-stack/select graph scheduled a)
              (mut operands)
                (machine/build-with-unary-inputs graph
                                                 scheduled
                                                 omitted
                                                 comparisons
                                                 (slice addresses)
                                                 (slice doubles)
                                                 (slice extractions)
                                                 a)]
          ; Memory keeps its original source identities. Append an independent
          ; machine-use range including the selected index before liveness.
          (let [items-7 (.nodes scheduled) (mut for-index-7) (: 0 i64)] (while (< for-index-7 (len items-7)) (let [reference (get items-7 for-index-7)]
            (when (> (get indices (cast i64 reference)) 0)
              (let [range (get (.ranges operands) (cast i64 reference))
                    offset (len (.inputs operands))]
                (for [i 0 (.count range)]
                  (push! (mut (.inputs operands))
                         (get (.inputs operands) (+ (.offset range) i))))
                (push! (mut (.inputs operands)) (get indices (cast i64 reference)))
                (set! (mut (.ranges operands)) (cast i64 reference)
                      (machine/Range :offset offset :count (+ (.count range) 1)))))) (set! for-index-7 (+ for-index-7 1))))
          ; A verified ADD/SUB has exactly two data operands. Replace those
          ; slots with the selected tile inputs before constructing liveness.
          ; Definition identities and the stable graph remain unchanged.
          (let [items-8 (.nodes scheduled) (mut for-index-8) (: 0 i64)] (while (< for-index-8 (len items-8)) (let [reference (get items-8 for-index-8)]
            (let [tile (get tiles (cast i64 reference))]
              (when (and (not (get (.omitted operands) (cast i64 reference)))
                         (or (= (.rule tile) 50) (= (.rule tile) 51)))
                (let [range (get (.ranges operands) (cast i64 reference))]
                  (set! (mut (.inputs operands)) (.offset range) (.left tile))
                  (set! (mut (.inputs operands)) (+ (.offset range) 1) (.right tile))))
              ; MADD/MSUB read three sources; give them their own range.
              (when (and (not (get (.omitted operands) (cast i64 reference)))
                         (or (= (.rule tile) 54) (= (.rule tile) 55)))
                (let [offset (len (.inputs operands))]
                  (push! (mut (.inputs operands)) (.left tile))
                  (push! (mut (.inputs operands)) (.right tile))
                  (push! (mut (.inputs operands)) (select/multiplier tile))
                  (set! (mut (.ranges operands)) (cast i64 reference)
                        (machine/Range :offset offset :count 3)))))) (set! for-index-8 (+ for-index-8 1))))
          ; A narrowed comparison, or the branch that consumed it, was given
          ; the comparison's graph operands. Read each retired extension
          ; through its source, as the selected tile does.
          (for reference narrowable (push! (mut narrow-users) reference))
          (free! (mut narrowable))
          (for reference narrow-users
            (when (and (> reference 0)
                       (not (get (.omitted operands) (cast i64 reference))))
              (let [range (get (.ranges operands) (cast i64 reference))]
                (for [i 0 (.count range)]
                  (let [value (get (.inputs operands) (+ (.offset range) i))]
                    (when (and (> value 0) (get (.omitted operands) (cast i64 value))
                               (select/word-extension? graph value))
                      (set! (mut (.inputs operands)) (+ (.offset range) i)
                            (.op1 (get (.instructions graph) (cast i64 value))))))))))
          (free! (mut narrow-users))
          ; Only selected choices need replacement input ranges.
          (for reference choices
            (let [index (cast i64 reference) tile (get tiles index)
                  offset (len (.inputs operands))]
              (push! (mut (.inputs operands)) (.left tile))
              (push! (mut (.inputs operands)) (.right tile))
              (set! (mut (.ranges operands)) index
                    (machine/Range :offset offset :count 2))))
          (free! (mut choices))
          ; A fused COND consumes the comparison inputs and both choices at
          ; the select position. Its Boolean producer is no longer a use/def.
          ; Immediate comparison RHSs have no machine-value use.
          (for reference selects
            (let [index (cast i64 reference) node (get (.instructions graph) index)
                  tile (get tiles (cast i64 (get comparisons index)))
                  offset (len (.inputs operands))]
              (push! (mut (.inputs operands)) (.left tile))
              (when (!= (.right tile) 0) (push! (mut (.inputs operands)) (.right tile)))
              (push! (mut (.inputs operands)) (.op2 node))
              (push! (mut (.inputs operands)) (.op3 node))
              (set! (mut (.ranges operands)) index
                    (machine/Range :offset offset :count (- (len (.inputs operands)) offset)))))
          (free! (mut selects))
          (for reference word-views
            (when (not (get (.omitted operands) (cast i64 reference)))
              (when (= (len (.rematerialized operands)) 0)
                (extend-zeroed! (mut (.rematerialized operands)) (len (.instructions graph))))
              (set! (mut (.definitions operands)) (cast i64 reference) false)
              (set! (mut (.rematerialized operands)) (cast i64 reference) true)))
          (free! (mut word-views))
          (let [items-9 (.nodes scheduled) (mut for-index-9) (: 0 i64)] (while (< for-index-9 (len items-9)) (let [reference (get items-9 for-index-9)]
            (when (> (static-stack/size static-sizes reference) 0)
              (set! (mut (.definitions operands)) (cast i64 reference) false)
              (set! (mut (.rematerialized operands)) (cast i64 reference) true))
            (when (and (< (cast i64 reference) (len (.modes tails)))
                       (> (get (.modes tails) (cast i64 reference)) 0))
              (set! (mut (.definitions operands)) (cast i64 reference) false))) (set! for-index-9 (+ for-index-9 1))))
          (when fuse
            (result-projections/select! graph scheduled blocks protected
                                         (.modes tails) (mut operands) a))
          (free! (mut blocks))
          (free! (mut protected))
          (Ok (Plan
                :operands operands
                :tiles tiles
                :comparisons comparisons
                :addresses addresses
                :offsets offsets
                :indices indices
                :index-shifts index-shifts
                :doubles doubles
                :extractions extractions
                :tails tails
                :static-sizes static-sizes
                :exact-decrements exact-decrements))))))

(defn plain [(graph g/Graph) (scheduled schedule/Schedule) (a (dyn Allocator))]
  (-> (Result Plan (slice u8)))
  (let [(mut roots) (ArrayList::new [i32] a)
        result (build graph scheduled (slice roots) false a)]
    (free! (mut roots))
    result))

;;; The machine selector of a SWITCH: its operand, or the 32-bit source of an
;;; extension that matching retired in favor of word dispatch.
(defn switch-selector [(plan Plan) (graph g/Graph) (reference i32)] (-> i32)
  (let [selector (.op2 (get (.instructions graph) (cast i64 reference)))]
    (if (and (select/word-extension? graph selector)
             (get (.omitted (.operands plan)) (cast i64 selector)))
        (.op1 (get (.instructions graph) (cast i64 selector)))
        selector)))

(defn selected [(plan Plan) (reference i32)]
  (-> (Result select/Tile (slice u8)))
  (let [tile (get (.tiles plan) (cast i64 reference))]
    (if (= (.rule tile) 0)
        (Err "instruction has no selected scalar rule")
        (Ok tile))))

(defn build [(graph g/Graph) (scheduled schedule/Schedule) (roots (slice i32))
             (fuse bool) (a (dyn Allocator))] (-> (Result Plan (slice u8)))
  (let [(mut idom) (ArrayList::new [i32] a)
        result (build-with-selects graph scheduled idom roots fuse false a)]
    (free! (mut idom))
    result))

(defn release! [(plan (mut Plan))] (-> void)
  (free! (mut (.static-sizes plan)))
  (free! (mut (.exact-decrements plan)))
  (machine/release! (mut (.operands plan)))
  (free! (mut (.tiles plan)))
  (free! (mut (.comparisons plan)))
  (free! (mut (.addresses plan)))
  (free! (mut (.offsets plan)))
  (free! (mut (.indices plan)))
  (free! (mut (.index-shifts plan)))
  (free! (mut (.doubles plan)))
  (free! (mut (.extractions plan)))
  (tail-plan/release! (mut (.tails plan))))
