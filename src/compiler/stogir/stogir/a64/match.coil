    ; A variable shift reads its count from the source of each conversion
    ; that has no other reader; the retired conversions release their inputs.
    (when (= error "")
      (for [i 0 (len count-shifts)]
        (let [reference (get count-shifts i)
              index (cast i64 reference)
              tile (get tiles index)
              (mut count) (.right tile)
              (mut depth) 0
              (mut walking) (not (get omitted index))]
