;;; Persistent target rules, built after scheduling and before virtual-register
;;; liveness. References continue to identify the original Sea-of-Nodes nodes.
(module stogir.a64.match)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.uses" :as uses)
(import "stogir.schedule" :as schedule)
(import "stogir.matched-uses" :as machine)
(import "stogir.a64.select" :as select)
(import "stogir.a64.address" :as address)
(import "stogir.a64.memory" :as memory)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Plan
  [(operands machine/Plan)
   (tiles (ArrayList select/Tile))
   (comparisons (ArrayList i32))
   (addresses (ArrayList i32))
   (offsets (ArrayList i64))
   (doubles (ArrayList i32))
   (extractions (ArrayList i32))])

(defn scalar-tile? [(graph g/Graph) (node n/Node)] (-> bool)
  (let [opcode (cast i32 (n/opcode node))]
    (if (and (>= opcode 14) (<= opcode 23))
        (match (g/lookup graph (.op1 node))
          (Some [left] (types/integer? (cast i32 (n/type-id left))))
          (None [] false))
        (and (types/integer? (cast i32 (n/type-id node)))
             (or (and (>= opcode 26) (<= opcode 30))
                 (and (>= opcode 46) (<= opcode 53))
                 (= opcode 58)
                 (= opcode 59))))))

;;; A plan borrows graph references and becomes invalid after graph mutation.
;;; Initial fusion coverage mirrors IR_CMP_AND_BRANCH_INT for a single-use,
;;; same-block 64-bit comparison. Other rules retain their ordinary def/uses.
(defn build [(graph g/Graph)
             (scheduled schedule/Schedule)
             (roots (slice i32))
             (fuse bool)
             (a (dyn Allocator))] (-> (Result Plan (slice u8)))
  (let [(mut tiles) (ArrayList::new [select/Tile] a)
        (mut comparisons) (ArrayList::new [i32] a)
        (mut addresses) (ArrayList::new [i32] a)
        (mut offsets) (ArrayList::new [i64] a)
        (mut doubles) (ArrayList::new [i32] a)
        (mut extractions) (ArrayList::new [i32] a)
        (mut omitted) (ArrayList::new [bool] a)
        (mut blocks) (ArrayList::new [i32] a)
        (mut counts) (ArrayList::new [i64] a)
        (mut protected) (ArrayList::new [bool] a)
        (mut retired) (ArrayList::new [i32] a)
        (mut block) (: 0 i32)
        (mut error) ""]
    (for [i 0 (len (.instructions graph))]
      (push! (mut tiles)
             (select/Tile
               :rule 0
               :wide false
               :left 0
               :right 0
               :immediate 0))
      (push! (mut comparisons) 0)
      (push! (mut addresses) 0)
      (push! (mut offsets) 0)
      (push! (mut doubles) 0)
      (push! (mut extractions) 0)
      (push! (mut omitted) false)
      (push! (mut blocks) 0)
      (push! (mut counts) 0)
      (push! (mut protected) false))
    (for root roots
      (when (and (> root 0) (< (cast i64 root) (len protected)))
        (set! (mut protected) (cast i64 root) true)))
    (for reference (.nodes scheduled)
      (let [index (cast i64 reference)
            node (get (.instructions graph) index)]
        (when (op/block-start? (cast i32 (n/opcode node)))
          (set! block reference))
        (set! (mut blocks) index block)
        (for [j 1 (+ (cast i64 (get (.arities graph) index)) 1)]
          (when (uses/edge-code? (op/operand-code (cast i32 (n/opcode node))
                                                  (cast i32 j)))
            (match (g/operand graph reference (cast i32 j))
              (Some [value]
                    (when (> value 0)
                      (set! (mut counts)
                            (cast i64 value)
                            (+ (get counts (cast i64 value)) 1))))
              (None [] 0))))
        (when (scalar-tile? graph node)
          (match (select/select graph reference)
            (Err [message] (set! error message))
            (Ok [tile] (set! (mut tiles) index tile))))))
    (when (and fuse (= error ""))
      (for reference (.nodes scheduled)
        (let [node (get (.instructions graph) (cast i64 reference))
              source (.op2 node)]
          (when (and (= (n/opcode node) 116) (> source 0))
            (let [index (cast i64 source)
                  tile (get tiles index)]
              (when (and (= (get counts index) 1)
                         (not (get protected index))
                         (= (get blocks index)
                            (get blocks (cast i64 reference)))
                         (>= (.rule tile) 20)
                         (<= (.rule tile) 33)
                         (.wide tile))
                (set! (mut omitted) index true)
                (set! (mut comparisons) (cast i64 reference) source)))))))
    ; TRUNC(SHR/SAR) is selected as a single unsigned field extraction.
    ; Redirect each use first, then retire a producer only after all actual
    ; edges have been absorbed. Shared and rooted shifts remain definitions.
    (when (and fuse (= error ""))
      (for reference (.nodes scheduled)
        (when (= (n/opcode (get (.instructions graph) (cast i64 reference))) 35)
          (match (select/extraction graph reference)
            (None [] 0)
            (Some [tile]
                  (let [index (cast i64 reference)
                        producer (.op1 (get (.instructions graph) index))
                        input (.left tile)]
                    (when (= (get blocks index)
                             (get blocks (cast i64 producer)))
                      (set! (mut tiles) index tile)
                      (set! (mut extractions) index input)
                      (set! (mut counts)
                            (cast i64 input)
                            (+ (get counts (cast i64 input)) 1))
                      (set! (mut counts)
                            (cast i64 producer)
                            (- (get counts (cast i64 producer)) 1))
                      (when (= (get counts (cast i64 producer)) 0)
                        (push! (mut retired) producer)))))))))
    ; Every absorbed memory edge is replaced with its base before liveness.
    ; Keep a shared/rooted ADD unless all of its actual uses were absorbed.
    (when (and fuse (= error ""))
      (for reference (.nodes scheduled)
        (let [node (get (.instructions graph) (cast i64 reference))
              opcode (n/opcode node)]
          (when (and (>= opcode 91) (<= opcode 94))
            (match (memory/size graph reference)
              (Err [message] (set! error message))
              (Ok [width]
                  (match (address/select graph (.op2 node) width)
                    (None [] 0)
                    (Some [chosen]
                          (set! (mut addresses)
                                (cast i64 reference)
                                (.base chosen))
                          (set! (mut offsets)
                                (cast i64 reference)
                                (.offset chosen))
                          (let [index (cast i64 (.op2 node))]
                            (set! (mut counts) index (- (get counts index) 1))
                            (let [base (cast i64 (.base chosen))]
                              (set! (mut counts) base (+ (get counts base) 1)))
                            (when (= (get counts index) 0)
                              (push! (mut retired) (.op2 node))))))))))))
    ; Retire only pure word expressions whose last original edge was absorbed.
    ; Count replacement base edges before cascading, so shared bases stay live.
    (let [(mut cursor) 0]
      (while (< cursor (len retired))
        (let [reference (get retired cursor)
              index (cast i64 reference)
              node (get (.instructions graph) index)]
          (when (and (= (get counts index) 0)
                     (not (get protected index))
                     (not (get omitted index))
                     (or (and (address/word? (n/type-id node))
                              (or (= (n/opcode node) 26)
                                  (and (= (n/opcode node) 36)
                                       (match (g/lookup graph (.op1 node))
                                         (Some [source]
                                               (address/word? (n/type-id source)))
                                         (None [] false)))))
                         (and (types/integer? (cast i32 (n/type-id node)))
                              (or (= (types/scalar-size (cast i32
                                                              (n/type-id node))
                                                        8)
                                     4)
                                  (= (types/scalar-size (cast i32
                                                              (n/type-id node))
                                                        8)
                                     8))
                              (or (= (n/opcode node) 50) (= (n/opcode node) 51)))))
            (set! (mut omitted) index true)
            (for [j 1 (+ (cast i64 (get (.arities graph) index)) 1)]
              (match (g/operand graph reference (cast i32 j))
                (Some [value]
                      (when (> value 0)
                        (let [input (cast i64 value)]
                          (set! (mut counts) input (- (get counts input) 1))
                          (when (= (get counts input) 0)
                            (push! (mut retired) value)))))
                (None [] 0)))))
        (set! cursor (+ cursor 1))))
    (free! (mut retired))
    (when (and fuse (= error ""))
      (for reference (.nodes scheduled)
        (let [node (get (.instructions graph) (cast i64 reference))]
          (when (and (= (n/opcode node) 28)
                     (types/vector? (cast i32 (n/type-id node))))
            (let [source (select/doubling-source graph reference)]
              (when (> source 0)
                (set! (mut doubles) (cast i64 reference) source)
                (let [constant
                        (if (= source (.op1 node)) (.op2 node) (.op1 node))
                      index (cast i64 constant)]
                  (set! (mut counts) index (- (get counts index) 1))
                  (when (and (= (get counts index) 0)
                             (not (get protected index)))
                    (set! (mut omitted) index true)))))))))
    (free! (mut blocks))
    (free! (mut counts))
    (free! (mut protected))
    (if (!= error "")
        (do
          (free! (mut tiles))
          (free! (mut comparisons))
          (free! (mut addresses))
          (free! (mut offsets))
          (free! (mut doubles))
          (free! (mut extractions))
          (free! (mut omitted))
          (Err error))
        (Ok (Plan
              :operands
                (machine/build-with-unary-inputs graph
                                                 scheduled
                                                 omitted
                                                 comparisons
                                                 (slice addresses)
                                                 (slice doubles)
                                                 (slice extractions)
                                                 a)
              :tiles tiles
              :comparisons comparisons
              :addresses addresses
              :offsets offsets
              :doubles doubles
              :extractions extractions)))))

(defn plain [(graph g/Graph) (scheduled schedule/Schedule) (a (dyn Allocator))]
  (-> (Result Plan (slice u8)))
  (let [(mut roots) (ArrayList::new [i32] a)
        result (build graph scheduled (slice roots) false a)]
    (free! (mut roots))
    result))

(defn selected [(plan Plan) (reference i32)]
  (-> (Result select/Tile (slice u8)))
  (let [tile (get (.tiles plan) (cast i64 reference))]
    (if (= (.rule tile) 0)
        (Err "instruction has no selected scalar rule")
        (Ok tile))))

(defn release! [(plan (mut Plan))] (-> void)
  (machine/release! (mut (.operands plan)))
  (free! (mut (.tiles plan)))
  (free! (mut (.comparisons plan)))
  (free! (mut (.addresses plan)))
  (free! (mut (.offsets plan)))
  (free! (mut (.doubles plan)))
  (free! (mut (.extractions plan))))
