      (let [(mut zero-views) (ArrayList::new [i32] a)]
        (for [i 0 (len load-views)]
          (let [reference (get load-views i)
                index (cast i64 reference)
                node (get (.instructions graph) index)
                opcode (n/opcode node)]
            (unless (get omitted index)
              (cond (= opcode 35)
                      (let [load (get (.instructions graph) (cast i64 (.op1 node)))
                            width (types/scalar-size (cast i32 (n/type-id node)) 8)]
                        (when (and (select/narrowable-load-type? (n/type-id load))
                                   (select/narrow-view-type? (n/type-id node))
                                   (< width (types/scalar-size (cast i32 (n/type-id load)) 8))
                                   (< width 4)
                                   (= (get counts (cast i64 (.op1 node))) 2)
                                   (not (get protected (cast i64 (.op1 node))))
                                   (not (get omitted (cast i64 (.op1 node))))
                                   (not (frame-load? graph (.op1 node))))
                          (set! (mut tiles) (cast i64 (.op1 node))
                                (select/Tile :rule 57 :wide false :left 0 :right 0
                                             :immediate (cast u64 width)))
                          (set! (mut tiles) index (select/extended-copy (.op1 node)))
                          (set! (mut extractions) index (.op1 node))))
                    :else
                      (let [load (zero-view-load graph counts protected omitted reference)]
                        (when (> load 0)
                          (when (= (len zero-views) 0)
                            (extend-zeroed! (mut zero-views) (len (.instructions graph))))
                          (set! (mut zero-views) (cast i64 load)
                                (+ (get zero-views (cast i64 load)) 1))))))))
        (for reference load-views
          (when (> (len zero-views) 0)
            (let [index (cast i64 reference)
                  node (get (.instructions graph) index)
                  load (zero-view-load graph counts protected omitted reference)
                  slot (cast i64 load)]
              (when (and (> load 0)
                         (= (get counts slot) (+ (cast i64 (get zero-views slot)) 1)))
