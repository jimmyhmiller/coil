                    (set! count source))
                  (set! walking false)))
            (set! depth (+ depth 1)))
          (if (= count (.right tile))
              (set! (mut count-shifts) i 0)
              (set! (mut tiles) index
                    (select/Tile :rule (.rule tile) :wide (.wide tile) :left (.left tile)
                                 :right count :immediate (.immediate tile)))))))
