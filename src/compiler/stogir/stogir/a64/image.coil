;;; Resolve emitted graph references into an owned, relocatable code image.
(module stogir.a64.image)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.strings" :as strings)
(import "stogir.symbols" :as symbols)
(import "stogir.long-constant" :as long)
(import "stogir.image" :as image)
(import "stogir.text-data" :as text-data)
(import "stogir.bytes" :as bytes)
(import "stogir.a64.code" :as code)
(import "coil.hashmap" :use [HashMap])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn string-target! [(output (mut image/Image))
                      (graph g/Graph)
                      (node n/Node)
                      (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (match (strings/lookup (.strings graph) (cast i32 (n/constant-bits node)))
    (None [] (Err "string bytes missing"))
    (Some [text]
          (let [offset (len (.data output))]
            (if (not (bytes/append-slice! (mut (.data output)) text))
                (Err "string data space exhausted")
                (do
                  (push! (mut (.data output)) 0)
                  (image/fresh-local! (mut output) 2 offset allocator)))))))

;;; Materialize one immutable complete payload. Verify bytes/hash before
;;; reserving data, preserve its natural extent alignment, and bind privately.
(defn long-target! [(output (mut image/Image))
                    (graph g/Graph)
                    (reference i32)
                    (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "long constant missing"))
    (Some [node]
          (let [size (g/long-size graph reference)
                (mut hash) (: 5381 u32)
                (mut i) (: 0 i64)
                (mut error) ""]
            (when (or (not (long/valid-header? node 8)) (<= size 0))
              (set! error "invalid long constant image target"))
            (while (and (= error "") (< i size))
              (match (g/long-byte graph reference i)
                (None [] (set! error "long constant image payload missing"))
                (Some [byte] (set! hash (long/hash-step hash byte))))
              (set! i (+ i 1)))
            (when (!= (n/constant-bits node) (cast u64 (^ hash (.header node))))
              (set! error "long constant image hash mismatch"))
            (if (!= error "")
                (Err error)
                (match (image/data-space! (mut output)
                                          size
                                          (if (< size 8) 8 size))
                  (Err [message] (Err message))
                  (Ok [offset]
                      (set! i 0)
                      (while (and (= error "") (< i size))
                        (match (g/long-byte graph reference i)
                          (None []
                                (set! error
                                      "long constant image payload missing"))
                          (Some [byte]
                                (set! (mut (.data output)) (+ offset i) byte)))
                        (set! i (+ i 1)))
                      (if (!= error "")
                          (Err error)
                          (image/fresh-local! (mut output) 2 offset allocator)))))))))

(defn address-slot! [(output (mut image/Image))
                     (target i32)
                     (addresses (mut (HashMap i32 i32)))
                     (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (get addresses target)
    (Some [slot] (Ok slot))
    (None []
          (if (< target 0)
              (Err "address symbol missing")
              (do
                (while (!= (% (len (.data output)) 8) 0)
                  (push! (mut (.data output)) 0))
                (let [offset (len (.data output))]
                  (bytes/append32! (mut (.data output)) 0)
                  (bytes/append32! (mut (.data output)) 0)
                  (match (image/fresh-local! (mut output) 2 offset allocator)
                    (Err [msg] (Err msg))
                    (Ok [slot]
                        (if (not (image/relocate! (mut output)
                                                  (image/Relocation
                                                    :section 2
                                                    :offset offset
                                                    :kind 1
                                                    :symbol target
                                                    :addend 0)))
                            (Err "invalid address slot relocation")
                            (do (set! (mut addresses) target slot) (Ok slot)))))))))))

(defn register-target! [(output (mut image/Image))
                        (graph g/Graph)
                        (reference i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "emitted symbol constant missing"))
    (Some [node]
          (if (= (n/opcode node) 78)
              (if (and (< reference 0)
                       (long/valid-header? node 8)
                       (> (g/long-size graph reference) 0))
                  (Ok -1)
                  (Err "invalid emitted long constant"))
              (if (or (>= reference 0)
                      (not (symbols/validate graph node))
                      (not (symbols/named? (n/opcode node))))
                  (Err "invalid emitted symbolic constant")
                  (if (= (n/opcode node) 77)
                      (Ok -1)
                      (match (strings/lookup (.strings graph)
                                             (cast i32 (n/constant-bits node)))
                        (None [] (Err "symbol name missing"))
                        (Some [name] (image/symbol! (mut output) name 0 0)))))))))

(defn relocation-target! [(output (mut image/Image))
                          (graph g/Graph)
                          (pending code/Reference)
                          (targets (HashMap i32 i32))
                          (addresses (mut (HashMap i32 i32)))
                          (literals (mut (HashMap i32 i32)))
                          (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut symbol) (: -1 i32)]
    (match (get targets (.target pending))
      (Some [id] (set! symbol id))
      (None [] 0))
    (match (g/lookup graph (.target pending))
      (None [] (Err "emitted constant missing"))
      (Some [node]
            (if (= (.kind pending) 2)
                (if (and (= (n/opcode node) 74) (>= symbol 0))
                    (Ok symbol)
                    (Err "direct branch requires named function"))
                (if (not (or (= (.kind pending) 3) (= (.kind pending) 4)))
                    (Err "unsupported emitted relocation")
                    (match (get literals (.target pending))
                      (Some [id] (Ok id))
                      (None []
                            (match (if (= (n/opcode node) 78)
                                       (long-target! (mut output)
                                                     graph
                                                     (.target pending)
                                                     allocator)
                                       (if (= (n/opcode node) 77)
                                           (string-target! (mut output)
                                                           graph
                                                           node
                                                           allocator)
                                           (address-slot! (mut output)
                                                          symbol
                                                          (mut addresses)
                                                          allocator)))
                              (Err [msg] (Err msg))
                              (Ok [id]
                                  (do
                                    (set! (mut literals) (.target pending) id)
                                    (Ok id))))))))))))

;;; One target per constant, one full-width address slot per named symbol.
;;; Register every public name before generating private names to avoid collisions.
(defn finish! [(source (mut code/Buffer))
               (graph g/Graph)
               (entry (slice u8))
               (allocator (dyn Allocator))] (-> (Result image/Image (slice u8)))
  (let [(mut output) (image/create allocator)
        (mut targets) (HashMap::new-scalar [i32 i32] allocator)
        (mut addresses) (HashMap::new-scalar [i32 i32] allocator)
        (mut literals) (HashMap::new-scalar [i32 i32] allocator)
        (mut error) ""]
    (match (image/require-alignments! (mut output) (.alignment source) 8)
      (Err [message] (set! error message))
      (Ok [_] 0))
    (match (text-data/validate (.text-data source) (len (.text source)))
      (Err [message] (set! error message))
      (Ok [_] 0))
    (set! (.text output) (code/take-text! (mut source) allocator))
    (let [items-103 (.text-data source) (mut for-index-103) (: 0 i64)] (while (< for-index-103 (len items-103)) (let [range (get items-103 for-index-103)] (push! (mut (.text-data output)) range)) (set! for-index-103 (+ for-index-103 1))))
    (match (image/symbol! (mut output) entry 1 0)
      (Err [msg] (set! error msg))
      (Ok [_] 0))
    (let [items-102 (.references source) (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [pending (get items-102 for-index-102)]
      (when (= error "")
        (match (get targets (.target pending))
          (Some [_] 0)
          (None []
                (match (register-target! (mut output) graph (.target pending))
                  (Err [msg] (set! error msg))
                  (Ok [target] (set! (mut targets) (.target pending) target))))))) (set! for-index-102 (+ for-index-102 1))))
    (let [items-101 (.references source) (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [pending (get items-101 for-index-101)]
      (when (= error "")
        (match (relocation-target! (mut output)
                                   graph
                                   pending
                                   targets
                                   (mut addresses)
                                   (mut literals)
                                   allocator)
          (Err [msg] (set! error msg))
          (Ok [destination]
              (when (not (image/relocate! (mut output)
                                          (image/Relocation
                                            :section 1
                                            :offset (.offset pending)
                                            :kind (.kind pending)
                                            :symbol destination
                                            :addend 0)))
                (set! error "invalid emitted relocation offset or target")))))) (set! for-index-101 (+ for-index-101 1))))
    (free! (mut targets))
    (free! (mut addresses))
    (free! (mut literals))
    (if (= error "") (Ok output) (do (image/release! (mut output)) (Err error)))))
