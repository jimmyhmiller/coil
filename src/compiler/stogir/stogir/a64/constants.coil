;;; Integer constant materialization with MOVZ/MOVN plus MOVK patches.
(module stogir.a64.constants)
(import "stogir.a64.encode" :as e)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

;;; Chooses the shorter zero-filled or ones-filled sequence, preferring MOVZ ties.
(defn emit! [(output (mut (ArrayList u8))) (wide bool) (rd i32) (bits u64)]
  (-> (Result i32 (slice u8)))
  (if (or (< rd 0) (> rd 30) (and (not wide) (!= (>> bits 32) 0)))
      (Err "invalid constant destination or width")
      (let [halves (if wide 4 2)
            (mut zeros) 0
            (mut ones) 0
            (mut i) 0]
        (while (< i halves)
          (let [value (& (>> bits (cast u64 (* i 16))) 65535)]
            (when (!= value 0) (set! zeros (+ zeros 1)))
            (when (!= value 65535) (set! ones (+ ones 1))))
          (set! i (+ i 1)))
        (let [invert? (< ones zeros)
              fill (if invert? (: 65535 u64) (: 0 u64))
              (mut first?) true
              (mut count) (: 0 i32)
              (mut error) ""]
          (set! i 0)
          (while (< i halves)
            (let [value (& (>> bits (cast u64 (* i 16))) 65535)]
              (when (or (!= value fill) (and first? (= i (- halves 1))))
                (let [kind (if first? (if invert? 0 2) 3)
                      immediate (if (and first? invert?) (^ value 65535) value)]
                  (match (e/move-wide wide
                                      (cast i32 kind)
                                      rd
                                      (cast i32 immediate)
                                      (cast i32 i))
                    (Err [msg] (set! error msg))
                    (Ok [word] (bytes/append32! (mut output) word)))
                  (set! count (+ count 1))
                  (set! first? false))))
            (set! i (+ i 1)))
          (if (= error "") (Ok count) (Err error))))))
