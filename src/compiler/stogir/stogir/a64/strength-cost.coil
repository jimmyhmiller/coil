;;; A recurrence must remove arithmetic that still selects a machine multiply.
;;; Powers of two and 2^k+1 already select shifts or shifted ADD, and may fold
;;; into an address. Adding a loop-carried value for those alone is not useful.
(module stogir.a64.strength-cost)
(import "stogir.graph" :as g)
(import "stogir.a64.select" :as select)
(import "stogir.loop-strength" :as strength)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(defn machine-multiply? [(graph g/Graph) (reference i32)] (-> bool)
  (match (select/arithmetic graph reference)
    (Ok [tile] (= (.rule tile) 3))
    (Err [_] false)))

(defn run [(graph g/Graph) (entry i32) (roots (slice i32)) (a (dyn Allocator))]
  (-> (Result strength/Reduced (slice u8)))
  (strength/run-with-cost graph entry roots a (p/fnptr-of machine-multiply?)))
