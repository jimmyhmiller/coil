;;; Lane-wise vector unary operations, preserving complete D/Q payloads.
(module stogir.a64.vector-unary)
(import "stogir.vector-arithmetic" :as vector)
(import "stogir.types" :as types)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.simd-lanes" :as lanes)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn valid? [(opcode i32) (ty i32) (rd i32) (rn i32)] (-> bool)
  (and (vector/unary? opcode)
       (vector/valid-type? opcode ty)
       (types/short-vector? ty 8)
       (>= rd 0)
       (<= rd 31)
       (>= rn 0)
       (<= rn 31)))

(defn fields [(rd i32) (rn i32)] (-> u32)
  (| (cast u32 rd) (<< (cast u32 rn) 5)))

(defn arrangement [(ty i32)] (-> u32)
  (if (= (types/size ty 8) 16) (: 0x40000000 u32) (: 0 u32)))

(defn size-code [(ty i32)] (-> u32)
  (let [element (types/scalar-size (types/base-type ty) 8)]
    (if (= element 1) (: 0 u32) (if (= element 2) 1 (if (= element 4) 2 3)))))

;;; Single-instruction families only. Multi-instruction counts use emit-registers!.
(defn instruction [(opcode i32) (ty i32) (rd i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (if (not (valid? opcode ty rd rn))
      (Err "unsupported AArch64 vector unary shape or registers")
      (let [base (types/base-type ty)
            width (types/size ty 8)
            element (types/scalar-size base 8)
            q (arrangement ty)
            size (size-code ty)
            regs (fields rd rn)]
        (if (or (= opcode 56) (= opcode 57) (and (= opcode 55) (= element 8)))
            (Err "vector count requires an instruction sequence")
            (if (types/floating? base)
                (if (and (= width 8) (= element 8))
                    (encode/floating-unary true (= opcode 32) rd rn)
                    (Ok (| regs
                           q
                           (if (= element 8) (: 0x00400000 u32) (: 0 u32))
                           (if (= opcode 31)
                               (: 0x2EA0F800 u32)
                               (: 0x0EA0F800 u32)))))
                (if (or (= opcode 31) (= opcode 32))
                    (Ok (| regs
                           (if (and (= width 8) (= element 8))
                               (if (= opcode 31)
                                   (: 0x7EE0B800 u32)
                                   (: 0x5EE0B800 u32))
                               (| q
                                  (<< size 22)
                                  (if (= opcode 31)
                                      (: 0x2E20B800 u32)
                                      (: 0x0E20B800 u32))))))
                    (Ok (| regs
                           q
                           (if (= opcode 45)
                               (: 0x2E205800 u32)
                               (if (= opcode 55)
                                   (| (: 0x2E204800 u32) (<< size 22))
                                   (if (= element 2)
                                       (: 0x0E201800 u32)
                                       (if (= element 4)
                                           (: 0x2E200800 u32)
                                           (: 0x0E200800 u32)))))))))))))

(defn word! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (word (Result u32 (slice u8)))] (-> void)
  (match word
    (Err [message] (set! error message))
    (Ok [bits] (bytes/append32! (mut out) bits))))

(defn emit-registers! [(output (mut (ArrayList u8)))
                       (opcode i32)
                       (ty i32)
                       (rd i32)
                       (rn i32)]
  (-> (Result i32 (slice u8)))
  (if (not (valid? opcode ty rd rn))
      (Err "unsupported AArch64 vector unary shape or registers")
      (let [(mut temporary) (ArrayList::new [u8] (.alc output))
            (mut error) ""
            element (types/scalar-size (types/base-type ty) 8)
            q (arrangement ty)]
        (if (= opcode 57)
            (do
              (bytes/append32! (mut temporary)
                               (| q (: 0x0E205800 u32) (fields rd rn)))
              (let [(mut current) (: 1 i32)
                    (mut size) (: 0 u32)]
                (while (< current element)
                  (bytes/append32! (mut temporary)
                                   (| q
                                      (: 0x2E202800 u32)
                                      (<< size 22)
                                      (fields rd rd)))
                  (set! current (* current 2))
                  (set! size (+ size 1)))))
            (if (and (= element 8) (or (= opcode 55) (= opcode 56)))
                (let [(mut lane) (: 0 i32)]
                  (while (< lane (types/lanes ty))
                    (word! (mut temporary)
                           (mut error)
                           (lanes/lane-extract false 8 lane 16 rn))
                    (when (= opcode 56)
                      (word! (mut temporary)
                             (mut error)
                             (encode/unary-bits true 0 16 16)))
                    (word! (mut temporary)
                           (mut error)
                           (encode/unary-bits true 4 16 16))
                    (word! (mut temporary)
                           (mut error)
                           (lanes/lane-insert 8 lane rd 16))
                    (set! lane (+ lane 1))))
                (if (= opcode 56)
                    (do
                      (bytes/append32! (mut temporary)
                                       (| q (: 0x2E605800 u32) (fields rd rn)))
                      (when (> element 1)
                        (word! (mut temporary)
                               (mut error)
                               (instruction 54 ty rd rd)))
                      (word! (mut temporary)
                             (mut error)
                             (instruction 55 ty rd rd)))
                    (word! (mut temporary)
                           (mut error)
                           (instruction opcode ty rd rn)))))
        (let [count (cast i32 (len temporary))]
          (when (= error "")
            (extend! (mut output) (.data temporary) (len temporary)))
          (free! (mut temporary))
          (if (= error "") (Ok count) (Err error))))))
