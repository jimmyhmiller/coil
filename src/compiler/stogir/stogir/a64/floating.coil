; Comparison conditions follow dstogov/ir ir_aarch64.dasc, 92171d0. See NOTICE.
(module stogir.a64.floating)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.floating" :as floating)
(import "stogir.allocation" :as a)
(import "stogir.locations" :as loc)
(import "stogir.a64.value" :as value)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.emit" :as emit)
(import "stogir.a64.code" :as code)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

;;; For FCMP, unordered sets N=0 Z=0 C=1 V=1. U-prefixed relations include NaNs.
(defn condition [(opcode i32)] (-> i32)
  (match opcode
    (14 0)
    (15 1)
    (16 4)
    (17 10)
    (18 9)
    (19 12)
    (20 11)
    (21 2)
    (22 13)
    (23 8)
    (24 7)
    (25 6)
    (_ -1)))

(defn emit-with-locations! [(out (mut code/Buffer))
                            (graph g/Graph)
                            (parts loc/View)
                            (reference i32)
                            (position i64)] (-> (Result i32 (slice u8)))
  (match (floating/validate graph reference)
    (Err [message] (Err message))
    (Ok [ty]
        (let [node (get (.instructions graph) (cast i64 reference))
              opcode (cast i32 (n/opcode node))
              wide (= ty 12)
              (mut temp) (code/create (.alc (.text out)))
              (mut error) ""
              (mut left) (: -1 i32)
              (mut right) (: -1 i32)
              (mut addend) (: -1 i32)
              (mut destination) (: -1 i32)]
          (match (loc/resolve parts reference (+ position 1))
            (Err [message] (set! error message))
            (Ok [location]
                (if (and (= (.kind location) 0)
                         (registers/allocatable? (cast i32 (n/type-id node))
                                                 (cast i32 (.value location))))
                    (set! destination (cast i32 (.value location)))
                    (set! error
                          "floating result requires register of its class"))))
          (match (value/register-with-locations! (mut temp)
                                                 graph
                                                 parts
                                                 (.op1 node)
                                                 position
                                                 16
                                                 62)
            (Err [message] (set! error message))
            (Ok [reg] (set! left (- reg 32))))
          (when (not (floating/unary? opcode))
            (match (value/register-with-locations! (mut temp)
                                                   graph
                                                   parts
                                                   (.op2 node)
                                                   position
                                                   17
                                                   63)
              (Err [message] (set! error message))
              (Ok [reg] (set! right (- reg 32)))))
          ; FMA's addend: a scratch the two factors left free, or else the
          ; result register. When both scratches are taken neither factor is
          ; in a register, so the result register holds no operand here.
          (when (and (= error "") (floating/ternary? opcode))
            (match (value/register-with-locations! (mut temp)
                                                   graph
                                                   parts
                                                   (.op3 node)
                                                   position
                                                   16
                                                   (cond (!= left 30) 62
                                                         (!= right 31) 63
                                                         :else destination))
              (Err [message] (set! error message))
              (Ok [reg] (set! addend (- reg 32)))))
          (when (= error "")
            (cond (floating/ternary? opcode)
                (emit/word! (mut (.text temp))
                            (mut error)
                            (encode/floating-multiply-add wide
                                                          (- destination 32)
                                                          left
                                                          right
                                                          addend))
                (floating/extension? opcode)
                (emit/word! (mut (.text temp))
                            (mut error)
                            (encode/floating-extension wide
                                                       opcode
                                                       (- destination 32)
                                                       left
                                                       (if (floating/unary? opcode)
                                                           left
                                                           right)))
                (floating/unary? opcode)
                (emit/word! (mut (.text temp))
                            (mut error)
                            (encode/floating-unary wide
                                                   (= opcode 32)
                                                   (- destination 32)
                                                   left))
                :else
                (if (or (floating/comparison? opcode)
                        (= opcode 58)
                        (= opcode 59))
                    (do
                      (emit/word! (mut (.text temp))
                                  (mut error)
                                  (encode/floating-compare wide left right))
                      (emit/word! (mut (.text temp))
                                  (mut error)
                                  (if (floating/comparison? opcode)
                                      (encode/conditional-set false
                                                              destination
                                                              (condition opcode))
                                      (encode/floating-select wide
                                                              (- destination 32)
                                                              left
                                                              right
                                                              (if (= opcode 58)
                                                                  9
                                                                  10)))))
                    (emit/word! (mut (.text temp))
                                (mut error)
                                (encode/floating-binary wide
                                                        opcode
                                                        (- destination 32)
                                                        left
                                                        right)))))
          (let [count (cast i32 (len (.text temp)))]
            (when (and (= error "") (not (code/append! (mut out) temp)))
              (set! error "invalid floating code references"))
            (code/release! (mut temp))
            (if (= error "") (Ok count) (Err error)))))))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit! [(out (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList a/Part))
             (reference i32)
             (position i64)] (-> (Result i32 (slice u8)))
  (emit-with-locations! (mut out)
                        graph
                        (loc/linear-view parts)
                        reference
                        position))
