;;; Control-pinned scalar GPR/SIMD memory emission.
(module stogir.a64.memory)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "stogir.allocation" :as a)
(import "stogir.locations" :as loc)
(import "stogir.a64.value" :as value)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.encode" :as encode)
(import "stogir.bytes" :as bytes)
(import "stogir.a64.code" :as code)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn size [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "memory node missing"))
    (Some [node]
          (let [opcode (n/opcode node)
                load? (<= opcode 92)]
            (if (or (<= reference 0)
                    (< opcode 91)
                    (> opcode 94)
                    (!= (get (.arities graph) (cast i64 reference))
                        (if load? 2 3)))
                (Err "invalid memory instruction")
                (match (g/lookup graph (.op2 node))
                  (None [] (Err "memory address missing"))
                  (Some [address]
                        (if (!= (n/type-id address) 6)
                            (Err "memory address must be ADDR")
                            (match (if load?
                                       (Some node)
                                       (g/lookup graph (.op3 node)))
                              (None [] (Err "store value missing"))
                              (Some [input]
                                    (let [ty (cast i32 (n/type-id input))]
                                      (if (and (not load?)
                                               (!= (n/type-id node) 0))
                                          (Err "store must be void")
                                          (if (or (types/integer? ty)
                                                  (types/floating? ty)
                                                  (types/short-vector? ty 8))
                                              (Ok (types/size ty 8))
                                              (Err "unsupported memory value type"))))))))))))))

;;; An all-zero scalar of at most eight bytes stores from WZR/XZR. Floating
;;; +0.0 has the same bit pattern, so the integer store writes identical bytes.
(defn zero-constant? [(graph g/Graph) (parts loc/View) (value i32)] (-> bool)
  (let [constant (loc/constant-reference parts value)]
    (and (< constant 0)
         (match (g/lookup graph constant)
           (None [] false)
           (Some [node]
                 (and (symbols/numeric? node)
                      (= (n/opcode node) (n/type-id node))
                      (types/valid-scalar? (cast i32 (n/type-id node)))
                      (= (n/constant-bits node) 0)))))))

;;; Displacement encodable by the scaled or unscaled immediate access forms.
(defn direct-displacement? [(offset i64) (width i32)] (-> bool)
  (or (and (>= offset -256) (<= offset 255))
      (and (>= offset 0)
           (= (% offset (cast i64 width)) 0)
           (<= (/ offset (cast i64 width)) 4095))))

;;; A frame address rematerialized at this position is base register plus a
;;; constant, so a direct access adds the constant to the displacement instead of
;;; building the address in x16 first. Returns the frame base register, or -1
;;; when the address is not such a location or the sum is not encodable.
(defn frame-base [(parts loc/View)
                  (address i32)
                  (position i64)
                  (offset i64)
                  (width i32)] (-> i32)
  (if (<= address 0)
      -1
      (match (loc/resolve parts address position)
        (Err [_] -1)
        (Ok [location]
            (if (and (loc/rematerialized? location)
                     (direct-displacement? (+ (.value location) offset) width))
                (loc/address-base location)
                -1)))))

(defn emit-indexed-address-with-locations! [(output (mut code/Buffer))
                                    (graph g/Graph)
                                    (parts loc/View)
                                    (reference i32)
                                    (position i64)
                                    (address i32)
                                    (offset i64)
                                    (index i32) (shift i32)]
  (-> (Result i32 (slice u8)))
  (emit-formed-with-locations! (mut output) graph parts reference position
                               address offset index shift 0))

;;; FORM, when nonzero, is the access form matching selected for an integer
;;; LOAD in place of the one its type gives: the access width in bytes in
;;; bits0..7, and bit8 when the access sign-extends into the X register (it
;;; zero-extends otherwise). The address and index were selected for that
;;; width.
(defn emit-formed-with-locations! [(output (mut code/Buffer))
                                   (graph g/Graph)
                                   (parts loc/View)
                                   (reference i32)
                                   (position i64)
                                   (address i32)
                                   (offset i64)
                                   (index i32) (shift i32) (form i32)]
  (-> (Result i32 (slice u8)))
  (match (if (and (!= form 0)
                  (or (!= (n/opcode (get (.instructions graph) (cast i64 reference))) 91)
                      (not (or (= (& form 255) 1) (= (& form 255) 2) (= (& form 255) 4)))
                      (> (>> form 8) 1)))
             (Err "invalid selected load form")
             (size graph reference))
    (Err [message] (Err message))
    (Ok [natural]
        (let [node (get (.instructions graph) (cast i64 reference))
              load? (<= (n/opcode node) 92)
              width (if (!= form 0) (& form 255) natural)
              signed-load? (if (!= form 0)
                               (!= (& form 256) 0)
                               (and load? (types/signed? (cast i32 (n/type-id node)))
                                    (<= width 4)))
              (mut temporary) (code/create (.alc (.text output)))
              (mut error) ""
              (mut base) (: -1 i32)
              (mut displacement) offset
              (mut reg) (: -1 i32)
              (mut index-reg) (: -1 i32)
              direct (if (> index 0) -1 (frame-base parts address position offset width))]
          (if (>= direct 0)
              (match (loc/resolve parts address position)
                (Err [message] (set! error message))
                (Ok [location]
                    (set! base direct)
                    (set! displacement (+ (.value location) offset))))
              (match (value/register-with-locations! (mut temporary)
                                                     graph
                                                     parts
                                                     address
                                                     position
                                                     16
                                                     62)
                (Err [message] (set! error message))
                (Ok [r] (set! base r))))
          (when (> index 0)
            (if (or (!= displacement 0) (< shift 0) (> shift 4)
                    (not (or (= shift 0) (= width (<< (: 1 i32) shift)))))
                (set! error "invalid selected register-offset address")
                (match (value/register-with-locations! (mut temporary)
                          graph parts index position 17 63)
                  (Err [message] (set! error message))
                  (Ok [r] (set! index-reg r)))))
          ; A rematerialized index and store value may both need x17. Consume the
          ; index into x16 before materializing the store value in that case.
          (when (and (= error "") (not load?) (= index-reg 17))
            (match (encode/add-sub-shifted true false 16 base index-reg 0 shift)
              (Err [message] (set! error message))
              (Ok [word]
                (bytes/append32! (mut (.text temporary)) word)
                (set! base 16)
                (set! index-reg -1))))
          (if load?
              (match (loc/resolve parts reference (+ position 1))
                (Err [message] (set! error message))
                (Ok [destination]
                    (if (and (= (.kind destination) 0)
                             (registers/allocatable? (cast i32 (n/type-id node))
                                                     (cast i32
                                                           (.value destination))))
                        (set! reg (cast i32 (.value destination)))
                        (set! error
                              "load result requires register of its class"))))
              (if (and (<= width 8) (zero-constant? graph parts (.op3 node)))
                  (set! reg 31)
                  (match (value/register-with-locations! (mut temporary)
                                                         graph
                                                         parts
                                                         (.op3 node)
                                                         position
                                                         17
                                                         63)
                    (Err [message] (set! error message))
                    (Ok [r] (set! reg r)))))
          (when (= error "")
            (match (if (>= index-reg 0)
                       (if (and signed-load? (not (registers/simd? reg)))
                           (encode/register-offset-signed-load width (registers/physical reg)
                                                               base index-reg (!= shift 0))
                           (encode/register-offset-memory load? false
                             (registers/simd? reg) width (registers/physical reg)
                             base index-reg (!= shift 0)))
                       (if (and (>= displacement 0)
                            (= (% displacement (cast i64 width)) 0)
                            (<= (/ displacement (cast i64 width)) 4095))
                       (if (registers/simd? reg)
                           (encode/floating-load-store load?
                                                       width
                                                       (registers/physical reg)
                                                       base
                                                       displacement)
                           (if signed-load?
                               (encode/signed-load true width reg base displacement)
                               (encode/load-store load? width reg base displacement)))
                       (encode/unscaled-load-store load?
                                                   (registers/simd? reg)
                                                   (and signed-load?
                                                        (not (registers/simd? reg)))
                                                   true
                                                   width
                                                   (registers/physical reg)
                                                   base
                                                   displacement)))
              (Err [message] (set! error message))
              (Ok [word] (bytes/append32! (mut (.text temporary)) word))))
          (let [count (cast i32 (len (.text temporary)))]
            (when (and (= error "") (not (code/append! (mut output) temporary)))
              (set! error "invalid memory code references"))
            (code/release! (mut temporary))
            (if (= error "") (Ok count) (Err error)))))))

(defn emit-address-with-locations! [(output (mut code/Buffer))
                                    (graph g/Graph) (parts loc/View)
                                    (reference i32) (position i64)
                                    (address i32) (offset i64)]
  (-> (Result i32 (slice u8)))
  (emit-indexed-address-with-locations! (mut output) graph parts reference position
                                       address offset 0 0))

(defn emit-with-locations! [(output (mut code/Buffer))
                            (graph g/Graph)
                            (parts loc/View)
                            (reference i32)
                            (position i64)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "memory node missing"))
    (Some [node]
          (emit-address-with-locations! (mut output)
                                        graph
                                        parts
                                        reference
                                        position
                                        (.op2 node)
                                        0))))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit-address! [(output (mut code/Buffer))
                     (graph g/Graph)
                     (parts (ArrayList a/Part))
                     (reference i32)
                     (position i64)
                     (address i32)
                     (offset i64)] (-> (Result i32 (slice u8)))
  (emit-address-with-locations! (mut output)
                                graph
                                (loc/linear-view parts)
                                reference
                                position
                                address
                                offset))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit! [(output (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList a/Part))
             (reference i32)
             (position i64)] (-> (Result i32 (slice u8)))
  (emit-with-locations! (mut output)
                        graph
                        (loc/linear-view parts)
                        reference
                        position))
