;;; macOS AArch64 FEAT_LSE atomics. Capture inputs before any result overwrite.
(module stogir.a64.atomic)
(import "stogir.atomic" :as atomic)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.allocation" :as a)
(import "stogir.locations" :as locations)
(import "stogir.a64.code" :as code)
(import "stogir.a64.value" :as value)
(import "stogir.a64.transfers" :as transfers)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.atomic-encode" :as enc)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn capture-with-locations! [(out (mut code/Buffer))
                               (graph g/Graph)
                               (parts locations/View)
                               (reference i32)
                               (position i64)
                               (destination i32)] (-> (Result i32 (slice u8)))
  (match (value/register-with-locations! (mut out)
                                         graph
                                         parts
                                         reference
                                         position
                                         destination
                                         62)
    (Err [message] (Err message))
    (Ok [source]
        (transfers/emit! (mut (.text out))
                         (locations/Location :kind 0 :value (cast i64 source))
                         (locations/Location
                           :kind 0
                           :value (cast i64 destination))
                         8
                         17))))

(defn append! [(out (mut code/Buffer))
               (error (mut (slice u8)))
               (word (Result u32 (slice u8)))] (-> void)
  (match word
    (Err [message] (set! error message))
    (Ok [bits] (bytes/append32! (mut (.text out)) bits))))

(defn emit-with-locations! [(output (mut code/Buffer))
                            (graph g/Graph)
                            (parts locations/View)
                            (reference i32)
                            (position i64)] (-> (Result i32 (slice u8)))
  (match (atomic/validate graph reference)
    (Err [message] (Err message))
    (Ok [width]
        (let [node (get (.instructions graph) (cast i64 reference))
              opcode (cast i32 (n/opcode node))
              (mut temporary) (code/create (.alc (.text output)))
              (mut error) ""
              (mut rd) (: 0 i32)]
          (when (and (!= opcode 127) (!= opcode 130))
            (match (locations/resolve parts reference (+ position 1))
              (Err [message] (set! error message))
              (Ok [destination]
                  (if (or (!= (.kind destination) 0)
                          (< (.value destination) 0)
                          (> (.value destination) 15))
                      (set! error "atomic result requires an allocated GPR")
                      (set! rd (cast i32 (.value destination)))))))
          (when (!= opcode 130)
            (match (capture-with-locations! (mut temporary)
                                            graph
                                            parts
                                            (.op2 node)
                                            position
                                            16)
              (Err [message] (set! error message))
              (Ok [_] 0))
            (when (!= opcode 126)
              (let [input
                      (if (= opcode 129)
                          (match (g/operand graph reference 4)
                            (None [] 0)
                            (Some [r] r))
                          (.op3 node))]
                (match (capture-with-locations! (mut temporary)
                                                graph
                                                parts
                                                input
                                                position
                                                17)
                  (Err [message] (set! error message))
                  (Ok [_] 0)))))
          (cond (= opcode 130)
                  (bytes/append32! (mut (.text temporary)) 0xD5033BBF)
                (or (= opcode 126) (= opcode 127))
                  (append! (mut temporary)
                           (mut error)
                           (enc/memory (= opcode 127)
                                       width
                                       (if (= opcode 127) 17 rd)
                                       16))
                (= opcode 128)
                  (match (g/operand graph reference 4)
                    (None [] (set! error "atomic operation missing"))
                    (Some [operation]
                          (when (= operation 1)
                            (append! (mut temporary)
                                     (mut error)
                                     (encode/add-sub true true false 17 31 17)))
                          (when (= operation 2)
                            (append! (mut temporary)
                                     (mut error)
                                     (encode/invert true 17 17)))
                          (append! (mut temporary)
                                   (mut error)
                                   (enc/rmw operation width 17 rd 16))))
                (= opcode 129)
                  (do
                    (match (capture-with-locations! (mut temporary)
                                                    graph
                                                    parts
                                                    (.op3 node)
                                                    position
                                                    rd)
                      (Err [message] (set! error message))
                      (Ok [_] 0))
                    (append! (mut temporary)
                             (mut error)
                             (enc/compare-exchange width rd 17 16)))
                :else (set! error "unknown atomic operation"))
          (let [size (cast i32 (len (.text temporary)))]
            (when (and (= error "") (not (code/append! (mut output) temporary)))
              (set! error "invalid atomic code references"))
            (code/release! (mut temporary))
            (if (= error "") (Ok size) (Err error)))))))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn capture! [(out (mut code/Buffer))
                (graph g/Graph)
                (parts (ArrayList a/Part))
                (reference i32)
                (position i64)
                (destination i32)] (-> (Result i32 (slice u8)))
  (capture-with-locations! (mut out)
                           graph
                           (locations/linear-view parts)
                           reference
                           position
                           destination))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit! [(output (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList a/Part))
             (reference i32)
             (position i64)] (-> (Result i32 (slice u8)))
  (emit-with-locations! (mut output)
                        graph
                        (locations/linear-view parts)
                        reference
                        position))
