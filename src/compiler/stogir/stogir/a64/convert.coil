; Conversion sequences follow dstogov/ir ir_aarch64.dasc, 92171d0; BOOL destinations are canonicalized. See NOTICE.
(module stogir.a64.convert)

(export width
        emit!
        emit-with-locations!
        zero-extended?
        widening-view?)

(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "stogir.conversion" :as conversion)
(import "stogir.allocation" :as a)
(import "stogir.locations" :as locations)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.emit" :as emit)
(import "stogir.a64.value" :as value)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.call-abi" :as abi)
(import "stogir.a64.transfers" :as transfers)
(import "stogir.bytes" :as bytes)
(import "stogir.a64.code" :as code)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn width [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (conversion/validate graph reference 8)
    (Err [message] (Err message))
    (Ok [bits]
        (let [node (get (.instructions graph) (cast i64 reference))]
          (if (and (types/vector? (cast i32 (n/type-id node)))
                   (not (types/short-vector? (cast i32 (n/type-id node)) 8)))
              (Err "native vector bitcast requires an 8- or 16-byte vector")
              (match (g/lookup graph (.op1 node))
                (None [] (Err "conversion source missing"))
                (Some [input]
                      (if (and (types/vector? (cast i32 (n/type-id input)))
                               (not (types/short-vector? (cast i32
                                                               (n/type-id input))
                                                         8)))
                          (Err "native vector bitcast requires an 8- or 16-byte vector")
                          (Ok bits)))))))))

(defn numeric! [(out (mut (ArrayList u8)))
                (opcode i32)
                (src-type i32)
                (dst-type i32)
                (source i32)
                (destination i32)] (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        begin (len out)]
    (if (= opcode 37)
        (let [bits (* 8 (types/scalar-size src-type 8))
              (mut reg) source]
          ;; Normalize into scratch, preserving a still-live narrow operand.
          (when (< bits 32)
            (emit/word! (mut out)
                        (mut error)
                        (encode/extend false
                                       (types/signed? src-type)
                                       bits
                                       16
                                       reg))
            (set! reg 16))
          (emit/word! (mut out)
                      (mut error)
                      (encode/integer-to-floating (= dst-type 12)
                                                  (= bits 64)
                                                  (types/signed? src-type)
                                                  (- destination 32)
                                                  reg)))
        (if (= opcode 38)
            (do
              (emit/word! (mut out)
                          (mut error)
                          (encode/floating-to-integer (= src-type 12)
                                                      (= (types/scalar-size dst-type
                                                                            8)
                                                         8)
                                                      (types/signed? dst-type)
                                                      destination
                                                      (- source 32)))
              (match (abi/normalize! (mut out) (cast u8 dst-type) destination)
                (Err [message] (set! error message))
                (Ok [_] 0)))
            (if (= src-type dst-type)
                (match (transfers/emit! (mut out)
                                        (locations/Location
                                          :kind 0
                                          :value (cast i64 source))
                                        (locations/Location
                                          :kind 0
                                          :value (cast i64 destination))
                                        (types/scalar-size dst-type 8)
                                        17)
                  (Err [message] (set! error message))
                  (Ok [_] 0))
                (emit/word! (mut out)
                            (mut error)
                            (encode/floating-convert (= dst-type 12)
                                                     (- destination 32)
                                                     (- source 32))))))
    (if (= error "") (Ok (cast i32 (- (len out) begin))) (Err error))))

;;; One value of an unsigned 8/16/32-bit type, or an I32 computed in W form, is
;;; known to have every register bit above its width clear. Its own emission guarantees that: zero-extending
;;; loads, ZEXT, narrowing TRUNC to 8/16 bits (UXTB/UXTH), W-form integer ALU
;;; results (32-bit forms, or narrow forms that re-extend unsigned results), and
;;; W-form constant materialization. Register moves and W-sized narrow spills
;;; preserve it.
(defn zero-extended-leaf? [(graph g/Graph) (reference i32)] (-> i32)
  (match (g/lookup graph reference)
    (None [] 0)
    (Some [node]
          (let [ty (n/type-id node)
                opcode (n/opcode node)
                arithmetic (or (and (>= opcode 26) (<= opcode 31))
                               (and (>= opcode 45) (<= opcode 51)))]
            (cond (= ty 1)
                    ; A comparison materializes 0/1 (CSET) and a BOOL load is
                    ; LDRB; OR/AND/XOR of such values keep every bit above
                    ; the low byte clear. NOT is excluded: it sets them.
                    (cond (< reference 0) (if (symbols/numeric? node) 1 0)
                          (and (>= opcode 14) (<= opcode 23)) 1
                          (= opcode 91) 1
                          (or (= opcode 67) (= opcode 68)
                              (= opcode 46) (= opcode 47) (= opcode 48)) 2
                          :else 0)
                  (= ty 10)
                    ; I32 W-form results and W-form I32 constants clear the
                    ; upper word; I32 loads sign-extend (LDRSW) and do not.
                    (cond (< reference 0) (if (symbols/numeric? node) 1 0)
                          (or (= opcode 67) (= opcode 68)) 2
                          (or arithmetic (= opcode 34)) 1
                          :else 0)
                  (or (< ty 2) (> ty 4)) 0
                  (< reference 0) (if (symbols/numeric? node) 1 0)
                  (or (= opcode 67) (= opcode 68)) 2
                  (or (= opcode 91) (= opcode 34)
                      (and (= opcode 35) (!= ty 4))
                      arithmetic) 1
                  :else 0)))))

;;; Signed 8/16/32-bit loads use the 64-bit sign-extending forms (LDRSB/LDRSH/
;;; LDRSW Xt), so SEXT from the loaded width is already in the register.
(defn sign-extending-load? [(graph g/Graph) (reference i32) (bits i32)] (-> bool)
  (and (> reference 0)
       (match (g/lookup graph reference)
         (None [] false)
         (Some [node]
               (let [ty (cast i32 (n/type-id node))]
                 (and (= (n/opcode node) 91)
                      (types/signed? ty)
                      (= (* 8 (types/scalar-size ty 8)) bits)
                      (<= bits 32)))))))

;;; Every value reaching a PHI/COPY web must be such a leaf. Cycles add no
;;; leaves; the bounded walk answers false when it cannot finish.
(defn zero-extended? [(graph g/Graph) (reference i32)] (-> bool)
  (let [(mut pending) (zeroed (array i32 32))
        (mut seen) (zeroed (array i32 32))
        (mut depth) (: 0 i64)
        (mut count) (: 0 i64)
        (mut good) true]
    (set! (mut pending) 0 reference)
    (set! depth 1)
    (while (and good (> depth 0))
      (set! depth (- depth 1))
      (let [current (get pending depth)
            (mut known) false]
        (for [i 0 count] (when (= (get seen i) current) (set! known true)))
        (unless known
          (match (zero-extended-leaf? graph current)
            (0 (set! good false))
            (1 0)
            (_ (if (>= count 32)
                   (set! good false)
                   (do
                     (set! (mut seen) count current)
                     (set! count (+ count 1))
                     (let [node (get (.instructions graph) (cast i64 current))
                           arity (get (.arities graph) (cast i64 current))
                           first (if (= (n/opcode node) 67) 2 1)]
                       (for [i first (+ (cast i64 arity) 1)]
                         (if (>= depth 32)
                             (set! good false)
                             (match (g/operand graph current (cast i32 i))
                               (None [] (set! good false))
                               (Some [input]
                                     (set! (mut pending) depth input)
                                     (set! depth (+ depth 1))))))))))))))
    good))

;;; A ZEXT of a zero-extended source, or a SEXT of a sign-extending load, finds
;;; its whole result already in the source's register (emit-with-locations!
;;; then copies the register or emits nothing). Graph-only half of that
;;; decision, for the allocator; integer registers of at most eight bytes.
(defn widening-view? [(graph g/Graph) (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (n/opcode node)
        ty (cast i32 (n/type-id node))]
    (and (or (= opcode 33) (= opcode 34))
         (> (.op1 node) 0)
         (types/integer? ty)
         (!= ty 1)
         (<= (types/size ty 8) 8)
         (match (g/lookup graph (.op1 node))
           (None [] false)
           (Some [source]
             (and (types/integer? (cast i32 (n/type-id source)))
                  (match (width graph reference)
                    (Err [_] false)
                    (Ok [bits]
                      (if (= opcode 34)
                          (zero-extended? graph (.op1 node))
                          (sign-extending-load? graph (.op1 node) bits))))))))))

;;; Temporary ownership makes materialization/encoding failure atomic, including
;;; symbol references introduced by pointer-to-integer bitcasts.
(defn emit-with-locations! [(output (mut code/Buffer))
                            (graph g/Graph)
                            (parts locations/View)
                            (reference i32)
                            (position i64)] (-> (Result i32 (slice u8)))
  (match (width graph reference)
    (Err [message] (Err message))
    (Ok [bits]
        (let [node (get (.instructions graph) (cast i64 reference))
              wide (= (types/scalar-size (cast i32 (n/type-id node)) 8) 8)
              (mut temporary) (code/create (.alc (.text output)))
              (mut error) ""]
          (match (locations/resolve parts reference (+ position 1))
            (Err [message] (set! error message))
            (Ok [destination]
                (if (or (!= (.kind destination) 0)
                        (not (registers/allocatable? (cast i32 (n/type-id node))
                                                     (cast i32
                                                           (.value destination)))))
                    (set! error "conversion result requires register")
                    ; An integer source that must be materialized (a frame
                    ; address, a symbol, a reload) is built in the result
                    ; register itself: nothing else is live in it at the
                    ; definition, and the copy out of a scratch disappears.
                    (match (value/register-with-locations! (mut temporary)
                                                           graph
                                                           parts
                                                           (.op1 node)
                                                           position
                                                           (if (and (< (n/opcode node) 37)
                                                                    (< (.value destination) 31))
                                                               (cast i32 (.value destination))
                                                               16)
                                                           62)
                      (Err [message] (set! error message))
                      (Ok [source]
                          (let [rd (cast i32 (.value destination))]
                            (if (>= (n/opcode node) 37)
                                (match (g/lookup graph (.op1 node))
                                  (None []
                                        (set! error
                                              "numeric conversion source missing"))
                                  (Some [input]
                                        (match (numeric! (mut (.text temporary))
                                                         (cast i32
                                                               (n/opcode node))
                                                         (cast i32
                                                               (n/type-id input))
                                                         (cast i32
                                                               (n/type-id node))
                                                         source
                                                         rd)
                                          (Err [message] (set! error message))
                                          (Ok [_] 0))))
                                (if (and (= (n/opcode node) 36)
                                         (or (>= source 32) (>= rd 32)))
                                    (match (transfers/emit! (mut (.text temporary))
                                                            (locations/Location
                                                              :kind 0
                                                              :value
                                                                (cast i64
                                                                      source))
                                                            destination
                                                            (/ bits 8)
                                                            (if (= bits 128)
                                                                63
                                                                17))
                                      (Err [message] (set! error message))
                                      (Ok [_] 0))
                                    (let [canonical-unsigned
                                            (zero-extended? graph (.op1 node))
                                          ; Pinned word TRUNC/integer BITCAST
                                          ; are register views, not extensions.
                                          ; Word views do not require clean
                                          ; upper X bits; later SEXT/ZEXT still
                                          ; explicitly normalize their source.
                                          full-copy
                                            (or (and (= (n/opcode node) 36)
                                                     (or (= bits 32)
                                                         (= bits 64)))
                                                (and (= (n/opcode node) 35)
                                                     (= bits 32))
                                                (and (= (n/opcode node) 34)
                                                     canonical-unsigned)
                                                ; A move or reload of the 32-bit
                                                ; value would not keep the sign.
                                                (and (= (n/opcode node) 33)
                                                     (sign-extending-load? graph (.op1 node) bits)
                                                     (locations/original-register?
                                                       parts (.op1 node) position)))]
                                      (if full-copy
                                          (unless (= rd source)
                                            (emit/word! (mut (.text temporary))
                                                        (mut error)
                                                        (encode/logical-register (or (= (n/opcode node)
                                                                                        34)
                                                                                     (= (n/opcode node)
                                                                                        33)
                                                                                     (= bits
                                                                                        64))
                                                                                 1
                                                                                 rd
                                                                                 source
                                                                                 31)))
                                          (emit/word! (mut (.text temporary))
                                                      (mut error)
                                                      (encode/extend wide
                                                                     (= (n/opcode node)
                                                                        33)
                                                                     bits
                                                                     rd
                                                                     source))))))
                            (when (= (n/type-id node) 1)
                              (emit/word! (mut (.text temporary))
                                          (mut error)
                                          (encode/add-sub false
                                                          true
                                                          true
                                                          31
                                                          rd
                                                          31))
                              (emit/word! (mut (.text temporary))
                                          (mut error)
                                          (encode/conditional-set false rd 1)))))))))
          (let [size (cast i32 (len (.text temporary)))]
            (when (and (= error "") (not (code/append! (mut output) temporary)))
              (set! error "invalid conversion code references"))
            (code/release! (mut temporary))
            (if (= error "") (Ok size) (Err error)))))))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit! [(output (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList a/Part))
             (reference i32)
             (position i64)] (-> (Result i32 (slice u8)))
  (emit-with-locations! (mut output)
                        graph
                        (locations/linear-view parts)
                        reference
                        position))
