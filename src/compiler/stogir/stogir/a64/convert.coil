; Conversion sequences follow dstogov/ir ir_aarch64.dasc, 92171d0; BOOL destinations are canonicalized. See NOTICE.
(module stogir.a64.convert)

(export width
        emit!
        emit-with-locations!)

(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.conversion" :as conversion)
(import "stogir.allocation" :as a)
(import "stogir.locations" :as locations)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.emit" :as emit)
(import "stogir.a64.value" :as value)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.call-abi" :as abi)
(import "stogir.a64.transfers" :as transfers)
(import "stogir.bytes" :as bytes)
(import "stogir.a64.code" :as code)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn width [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (conversion/validate graph reference 8)
    (Err [message] (Err message))
    (Ok [bits]
        (let [node (get (.instructions graph) (cast i64 reference))]
          (if (and (types/vector? (cast i32 (n/type-id node)))
                   (not (types/short-vector? (cast i32 (n/type-id node)) 8)))
              (Err "native vector bitcast requires an 8- or 16-byte vector")
              (match (g/lookup graph (.op1 node))
                (None [] (Err "conversion source missing"))
                (Some [input]
                      (if (and (types/vector? (cast i32 (n/type-id input)))
                               (not (types/short-vector? (cast i32
                                                               (n/type-id input))
                                                         8)))
                          (Err "native vector bitcast requires an 8- or 16-byte vector")
                          (Ok bits)))))))))

(defn numeric! [(out (mut (ArrayList u8)))
                (opcode i32)
                (src-type i32)
                (dst-type i32)
                (source i32)
                (destination i32)] (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        begin (len out)]
    (if (= opcode 37)
        (let [bits (* 8 (types/scalar-size src-type 8))
              (mut reg) source]
          ;; Normalize into scratch, preserving a still-live narrow operand.
          (when (< bits 32)
            (emit/word! (mut out)
                        (mut error)
                        (encode/extend false
                                       (types/signed? src-type)
                                       bits
                                       16
                                       reg))
            (set! reg 16))
          (emit/word! (mut out)
                      (mut error)
                      (encode/integer-to-floating (= dst-type 12)
                                                  (= bits 64)
                                                  (types/signed? src-type)
                                                  (- destination 32)
                                                  reg)))
        (if (= opcode 38)
            (do
              (emit/word! (mut out)
                          (mut error)
                          (encode/floating-to-integer (= src-type 12)
                                                      (= (types/scalar-size dst-type
                                                                            8)
                                                         8)
                                                      (types/signed? dst-type)
                                                      destination
                                                      (- source 32)))
              (match (abi/normalize! (mut out) (cast u8 dst-type) destination)
                (Err [message] (set! error message))
                (Ok [_] 0)))
            (if (= src-type dst-type)
                (match (transfers/emit! (mut out)
                                        (locations/Location
                                          :kind 0
                                          :value (cast i64 source))
                                        (locations/Location
                                          :kind 0
                                          :value (cast i64 destination))
                                        (types/scalar-size dst-type 8)
                                        17)
                  (Err [message] (set! error message))
                  (Ok [_] 0))
                (emit/word! (mut out)
                            (mut error)
                            (encode/floating-convert (= dst-type 12)
                                                     (- destination 32)
                                                     (- source 32))))))
    (if (= error "") (Ok (cast i32 (- (len out) begin))) (Err error))))

;;; Temporary ownership makes materialization/encoding failure atomic, including
;;; symbol references introduced by pointer-to-integer bitcasts.
(defn emit-with-locations! [(output (mut code/Buffer))
                            (graph g/Graph)
                            (parts locations/View)
                            (reference i32)
                            (position i64)] (-> (Result i32 (slice u8)))
  (match (width graph reference)
    (Err [message] (Err message))
    (Ok [bits]
        (let [node (get (.instructions graph) (cast i64 reference))
              wide (= (types/scalar-size (cast i32 (n/type-id node)) 8) 8)
              (mut temporary) (code/create (.alc (.text output)))
              (mut error) ""]
          (match (locations/resolve parts reference (+ position 1))
            (Err [message] (set! error message))
            (Ok [destination]
                (if (or (!= (.kind destination) 0)
                        (not (registers/allocatable? (cast i32 (n/type-id node))
                                                     (cast i32
                                                           (.value destination)))))
                    (set! error "conversion result requires register")
                    (match (value/register-with-locations! (mut temporary)
                                                           graph
                                                           parts
                                                           (.op1 node)
                                                           position
                                                           16
                                                           62)
                      (Err [message] (set! error message))
                      (Ok [source]
                          (let [rd (cast i32 (.value destination))]
                            (if (>= (n/opcode node) 37)
                                (match (g/lookup graph (.op1 node))
                                  (None []
                                        (set! error
                                              "numeric conversion source missing"))
                                  (Some [input]
                                        (match (numeric! (mut (.text temporary))
                                                         (cast i32
                                                               (n/opcode node))
                                                         (cast i32
                                                               (n/type-id input))
                                                         (cast i32
                                                               (n/type-id node))
                                                         source
                                                         rd)
                                          (Err [message] (set! error message))
                                          (Ok [_] 0))))
                                (if (and (= (n/opcode node) 36)
                                         (or (>= source 32) (>= rd 32)))
                                    (match (transfers/emit! (mut (.text temporary))
                                                            (locations/Location
                                                              :kind 0
                                                              :value
                                                                (cast i64
                                                                      source))
                                                            destination
                                                            (/ bits 8)
                                                            (if (= bits 128)
                                                                63
                                                                17))
                                      (Err [message] (set! error message))
                                      (Ok [_] 0))
                                    (let [canonical-unsigned
                                            (match (g/lookup graph (.op1 node))
                                              (None [] false)
                                              (Some [input]
                                                    (and (>= (n/type-id input)
                                                             2)
                                                         (<= (n/type-id input)
                                                             4)
                                                         (or (and (= (n/opcode input)
                                                                     35)
                                                                  (!= (n/type-id input)
                                                                      4))
                                                             (= (n/opcode input)
                                                                91)
                                                             (= (n/opcode input)
                                                                34)))))
                                          ; Pinned word TRUNC/integer BITCAST
                                          ; are register views, not extensions.
                                          ; Word views do not require clean
                                          ; upper X bits; later SEXT/ZEXT still
                                          ; explicitly normalize their source.
                                          full-copy
                                            (or (and (= (n/opcode node) 36)
                                                     (or (= bits 32)
                                                         (= bits 64)))
                                                (and (= (n/opcode node) 35)
                                                     (= bits 32))
                                                (and (= (n/opcode node) 34)
                                                     canonical-unsigned))]
                                      (if full-copy
                                          (unless (= rd source)
                                            (emit/word! (mut (.text temporary))
                                                        (mut error)
                                                        (encode/logical-register (or (= (n/opcode node)
                                                                                        34)
                                                                                     (= bits
                                                                                        64))
                                                                                 1
                                                                                 rd
                                                                                 source
                                                                                 31)))
                                          (emit/word! (mut (.text temporary))
                                                      (mut error)
                                                      (encode/extend wide
                                                                     (= (n/opcode node)
                                                                        33)
                                                                     bits
                                                                     rd
                                                                     source))))))
                            (when (= (n/type-id node) 1)
                              (emit/word! (mut (.text temporary))
                                          (mut error)
                                          (encode/add-sub false
                                                          true
                                                          true
                                                          31
                                                          rd
                                                          31))
                              (emit/word! (mut (.text temporary))
                                          (mut error)
                                          (encode/conditional-set false rd 1)))))))))
          (let [size (cast i32 (len (.text temporary)))]
            (when (and (= error "") (not (code/append! (mut output) temporary)))
              (set! error "invalid conversion code references"))
            (code/release! (mut temporary))
            (if (= error "") (Ok size) (Err error)))))))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit! [(output (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList a/Part))
             (reference i32)
             (position i64)] (-> (Result i32 (slice u8)))
  (emit-with-locations! (mut output)
                        graph
                        (locations/linear-view parts)
                        reference
                        position))
