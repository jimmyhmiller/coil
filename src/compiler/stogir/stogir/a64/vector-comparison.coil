;;; Full-lane predicate masks with the scalar library's signed/unordered rules.
(module stogir.a64.vector-comparison)

(export emit! emit-registers!)

(import "stogir.vector-comparison" :as vector)
(import "stogir.types" :as types)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.allocation" :as allocation)
(import "stogir.locations" :as loc)
(import "stogir.a64.code" :as code)
(import "stogir.a64.value" :as value)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.encode" :as encode)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

;;; kind 0=EQ, 1=signed/FP GT, 2=signed/FP GE, 3=unsigned HI, 4=unsigned HS.
(defn compare-word [(ty i32) (kind i32) (rd i32) (rn i32) (rm i32)] (-> u32)
  (let [base (types/base-type ty)
        width (types/size ty 8)
        element (types/scalar-size base 8)
        shape
          (if (and (= width 8) (= element 8))
              (: 0x50000000 u32)
              (if (= width 16) (: 0x40000000 u32) (: 0 u32)))
        operation
          (if (types/floating? base)
              (| (if (= kind 0)
                     (: 0x0E20E400 u32)
                     (if (= kind 1) (: 0x2EA0E400 u32) (: 0x2E20E400 u32)))
                 (if (= element 8) (: 0x00400000 u32) (: 0 u32)))
              (| (match kind
                   (0 (: 0x2E208C00 u32))
                   (1 (: 0x0E203400 u32))
                   (2 (: 0x0E203C00 u32))
                   (3 (: 0x2E203400 u32))
                   (_ (: 0x2E203C00 u32)))
                 (<< (cast u32
                           (if (= element 1)
                               0
                               (if (= element 2) 1 (if (= element 4) 2 3))))
                     22)))]
    (| operation shape (cast u32 rd) (<< (cast u32 rn) 5) (<< (cast u32 rm) 16))))

(defn emit-registers! [(output (mut (ArrayList u8)))
                       (opcode i32)
                       (ty i32)
                       (rd i32)
                       (rn i32)
                       (rm i32)] (-> (Result i32 (slice u8)))
  (if (or (not (vector/valid-type? opcode ty))
          (not (types/short-vector? ty 8))
          (< rd 0)
          (> rd 29)
          (< rn 0)
          (> rn 31)
          (< rm 0)
          (> rm 31))
      (Err "unsupported AArch64 vector comparison shape or registers")
      (let [(mut temporary) (ArrayList::new [u8] (.alc output))
            (mut error) ""
            fp? (types/floating? (types/base-type ty))
            width (types/size ty 8)
            q (if (= width 16) (: 0x40000000 u32) (: 0 u32))]
        (if (>= opcode 24)
            (let [(mut left) rn
                  (mut right) rm]
              ; Preserve a result-aliased input before computing the two self masks.
              ; Once both comparisons read their sources, v30 is free for mask two.
              (when (or (= rd rn) (= rd rm))
                (let [saved (if (or (= rn 30) (= rm 30)) (: 31 i32) 30)]
                  (match (encode/simd-move width saved rd)
                    (Err [message] (set! error message))
                    (Ok [word] (bytes/append32! (mut temporary) word)))
                  (when (= rd rn) (set! left saved))
                  (when (= rd rm) (set! right saved))))
              (bytes/append32! (mut temporary) (compare-word ty 0 rd left left))
              (bytes/append32! (mut temporary)
                               (compare-word ty 0 30 right right))
              (bytes/append32! (mut temporary)
                               (| (: 0x0E201C00 u32)
                                  q
                                  (cast u32 rd)
                                  (<< (cast u32 rd) 5)
                                  (<< (: 30 u32) 16))))
            (let [kind
                    (if fp?
                        (match opcode
                          (14 (: 0 i32))
                          (15 0)
                          (16 1)
                          (17 2)
                          (18 2)
                          (19 1)
                          (20 2)
                          (21 1)
                          (22 1)
                          (_ 2))
                        (match opcode
                          (14 (: 0 i32))
                          (15 0)
                          (16 1)
                          (17 2)
                          (18 2)
                          (19 1)
                          (20 3)
                          (21 4)
                          (22 4)
                          (_ 3)))
                  swap?
                    (if fp?
                        (or (= opcode 16)
                            (= opcode 18)
                            (= opcode 21)
                            (= opcode 23))
                        (or (= opcode 16)
                            (= opcode 18)
                            (= opcode 20)
                            (= opcode 22)))]
              (bytes/append32! (mut temporary)
                               (compare-word ty
                                             kind
                                             rd
                                             (if swap? rm rn)
                                             (if swap? rn rm)))))
        (when (or (= opcode 15)
                  (= opcode 25)
                  (and fp? (>= opcode 20) (<= opcode 23)))
          (bytes/append32! (mut temporary)
                           (| (: 0x2E205800 u32)
                              q
                              (cast u32 rd)
                              (<< (cast u32 rd) 5))))
        (let [size (cast i32 (len temporary))]
          (when (= error "")
            (extend! (mut output) (.data temporary) (len temporary)))
          (free! (mut temporary))
          (if (= error "") (Ok size) (Err error))))))

(defn emit! [(output (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList allocation/Part))
             (reference i32)
             (position i64)]
  (-> (Result i32 (slice u8)))
  (match (vector/validate graph reference 8)
    (Err [message] (Err message))
    (Ok [ty]
        (let [node (get (.instructions graph) (cast i64 reference))
              (mut temporary) (code/create (.alc (.text output)))
              (mut error) ""
              (mut destination) (: -1 i32)
              (mut left) (: -1 i32)
              (mut right) (: -1 i32)]
          (match (loc/lookup parts reference (+ position 1))
            (Err [message] (set! error message))
            (Ok [location]
                (if (and (= (.kind location) 0)
                         (registers/allocatable? (cast i32 (n/type-id node))
                                                 (cast i32 (.value location))))
                    (set! destination (- (cast i32 (.value location)) 32))
                    (set! error
                          "vector comparison result requires a SIMD register"))))
          (match (value/register! (mut temporary)
                                  graph
                                  parts
                                  (.op1 node)
                                  position
                                  16
                                  62)
            (Err [message] (set! error message))
            (Ok [reg] (set! left (- reg 32))))
          (match (value/register! (mut temporary)
                                  graph
                                  parts
                                  (.op2 node)
                                  position
                                  17
                                  63)
            (Err [message] (set! error message))
            (Ok [reg] (set! right (- reg 32))))
          (when (= error "")
            (match (emit-registers! (mut (.text temporary))
                                    (cast i32 (n/opcode node))
                                    ty
                                    destination
                                    left
                                    right)
              (Err [message] (set! error message))
              (Ok [_] 0)))
          (let [size (cast i32 (len (.text temporary)))]
            (when (and (= error "") (not (code/append! (mut output) temporary)))
              (set! error "invalid vector comparison code references"))
            (code/release! (mut temporary))
            (if (= error "") (Ok size) (Err error)))))))
