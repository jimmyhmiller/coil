;;; Used preserved GPR save area follows pinned ir_aarch64.dasc prologue/epilogue.
;;; Darwin reserves x18; x29/x30 and SIMD preserved lanes have separate policies.
(module stogir.a64.callee-saved)
(import "stogir.allocation" :as allocation)
(import "stogir.frame" :as frame)
(import "stogir.a64.frame-memory" :as memory)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defstruct Saved [(mask u64) (offset i64)])

(defn none [] (-> Saved)
  (Saved :mask 0 :offset -1))

(defn layout! [(parts (ArrayList allocation/Part)) (area (mut frame/Frame))]
  (-> (Result Saved (slice u8)))
  (let [(mut mask) (: 0 u64)
        (mut count) (: 0 i64)]
    (for part parts
      (let [reg (.register part)]
        (when (and (> (.parent part) 0)
                   (> (len (.ranges part)) 0)
                   (>= reg 19)
                   (<= reg 28))
          (set! mask (| mask (<< (: 1 u64) (cast u64 reg)))))))
    (for [reg 19 29]
      (when (!= (& mask (<< (: 1 u64) (cast u64 reg))) 0)
        (set! count (+ count 1))))
    (if (= count 0)
        (Ok (none))
        (match (frame/private-slot! (mut area) (* count 8) 8)
          (Err [message] (Err message))
          (Ok [offset] (Ok (Saved :mask mask :offset offset)))))))

;;; SP has already been restored to the fixed-frame base for reloads. x16 is
;;; scratch; preserve argument/result registers and all condition flags.
(defn emit! [(output (mut (ArrayList u8))) (saved Saved) (load bool)]
  (-> (Result i32 (slice u8)))
  (let [begin (len output)
        (mut offset) (.offset saved)
        (mut error) ""]
    ; Ascending saved registers occupy consecutive slots; adjacent ones pair.
    (let [(mut pending) (: -1 i32)]
      (for [reg 19 29]
        (when (!= (& (.mask saved) (<< (: 1 u64) (cast u64 reg))) 0)
          (if (< pending 0)
              (set! pending (cast i32 reg))
              (do
                (match (memory/pair-access! (mut output) load pending (cast i32 reg)
                                            31 offset 16)
                  (Err [message] (when (= error "") (set! error message)))
                  (Ok [_] 0))
                (set! offset (+ offset 16))
                (set! pending -1)))))
      (when (>= pending 0)
        (match (memory/access! (mut output) load 8 pending 31 offset false 16)
          (Err [message] (when (= error "") (set! error message)))
          (Ok [_] 0))))
    (if (= error "") (Ok (cast i32 (- (len output) begin))) (Err error))))
