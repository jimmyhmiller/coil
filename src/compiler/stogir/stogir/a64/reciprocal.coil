;;; Integer DIV/MOD by a literal that is not a power of two, as the high half
;;; of a multiplication by a fixed-point reciprocal (Granlund and Montgomery;
;;; the recipes follow Hacker's Delight chapter 10). This is an independent
;;; target extension: pinned upstream emits a machine divide.
;;;
;;; Tile rules (the immediate holds the divisor's bits in the type's width):
;;;   59/60 = unsigned/signed DIV, 61/62 = unsigned/signed MOD,
;;;   63/64 = signed DIV/MOD of a dividend proven non-negative by a positive
;;;           divisor, computed as the unsigned form of a dividend with a clear
;;;           top bit (no sign correction, never the wide-reciprocal fix-up).
;;; The quotient is built in x16 with x17 as the second temporary, so the
;;; dividend must be in neither; a dividend that emission put in a scratch is
;;; first moved to the result register. The remainder is dividend - q * d by
;;; one MSUB. NZCV is preserved.
;;;
;;; A tile whose right operand is set reads the reciprocal from that register
;;; (stogir.a64.constant-hoist defines it once outside a loop) instead of
;;; building it in x16. The register may itself be a scratch when the operand
;;; was rebuilt at this use; it is then moved to x16 before x17 is written.
(module stogir.a64.reciprocal)
(import "stogir.a64.select" :as select)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.constants" :as constants)
(import "stogir.reciprocal" :as recipes)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Option Some None])

(defn rule? [(rule i32)] (-> bool)
  (and (>= rule 59) (<= rule 64)))

;;; The reciprocal that the recipe of a rule 59..64 tile multiplies by, in the
;;; low 32 or 64 bits. A recipe that emit! rejects has none.
(defn magic [(tile select/Tile)] (-> (Option u64))
  (let [width (if (.wide tile) (: 64 i32) (: 32 i32))
        rule (.rule tile)
        d (.immediate tile)]
    (cond (or (not (rule? rule)) (< d 2) (!= (& d (recipes/mask-of width)) d)) (None)
          (or (= rule 60) (= rule 62)) (Some (.magic (recipes/signed-recipe d width)))
          :else
            (let [recipe (recipes/unsigned-recipe d width (if (>= rule 63) (: 1 i32) 0))]
              (if (and (.add recipe) (> (.pre recipe) 0))
                  (None)
                  (Some (.magic recipe)))))))

(defn remainder? [(rule i32)] (-> bool)
  (or (= rule 61) (= rule 62) (= rule 64)))

(defn word! [(output (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (instruction (Result u32 (slice u8)))] (-> void)
  (when (= error "")
    (match instruction
      (Err [message] (set! error message))
      (Ok [word] (bytes/append32! (mut output) word)))))

(defn constant! [(output (mut (ArrayList u8)))
                 (error (mut (slice u8)))
                 (wide bool)
                 (rd i32)
                 (bits u64)] (-> void)
  (when (= error "")
    (match (constants/emit! (mut output) wide rd bits)
      (Err [message] (set! error message))
      (Ok [_] 0))))

;;; High half of n * m into x16. The 32-bit form multiplies the two words
;;; into the full 64-bit product and shifts its high word down, arithmetically
;;; for a signed product so that the W register holds the signed high word.
(defn high! [(output (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (wide bool)
             (signed? bool)
             (n i32)
             (m i32)] (-> void)
  (if wide
      (word! (mut output) (mut error) (encode/multiply-high signed? 16 n m))
      (do
        (word! (mut output) (mut error) (encode/multiply-long signed? 16 n m))
        (word! (mut output) (mut error)
               (encode/shift-immediate true (if signed? 2 1) 16 16 32)))))

;;; RM holds the reciprocal when the tile's right operand is set and is
;;; ignored otherwise.
(defn emit! [(output (mut (ArrayList u8)))
             (tile select/Tile)
             (rd i32)
             (rn i32)
             (rm i32)] (-> (Result i32 (slice u8)))
  (let [wide (.wide tile)
        held? (!= (.right tile) 0)
        ; A dividend in a scratch moves to the result register; a reciprocal
        ; held there first moves to the other scratch.
        displaced? (and held? (= rm rd) (or (= rn 16) (= rn 17)))
        holder (if displaced? (if (= rn 16) (: 17 i32) (: 16 i32)) rm)
        ; The multiplier: the holding register, or x16 once it is built or
        ; moved there.
        m (if (and held? (!= holder 17)) holder (: 16 i32))
        width (if wide (: 64 i32) (: 32 i32))
        rule (.rule tile)
        d (.immediate tile)
        scratch-source? (or (= rn 16) (= rn 17))
        n (if scratch-source? rd rn)
        start (len output)
        (mut error) ""]
    (if (or (not (rule? rule))
            (< rd 0) (> rd 30) (< rn 0) (> rn 30)
            (= n 16) (= n 17)
            (and held? (or (< rm 0) (> rm 30)))
            (< d 2) (!= (& d (recipes/mask-of width)) d))
        (Err "reciprocal division lacks a dividend register outside the scratch pair")
        (do
          (when displaced?
            (word! (mut output) (mut error) (encode/logical-register true 1 holder 31 rm)))
          (when scratch-source?
            (word! (mut output) (mut error) (encode/logical-register wide 1 rd 31 rn)))
          (when (and held? (= holder 17))
            (word! (mut output) (mut error) (encode/logical-register true 1 16 31 17)))
          (if (or (= rule 60) (= rule 62))
              (let [recipe (recipes/signed-recipe d width)
                    minimum (<< (: 1 u64) (cast u64 (- width 1)))
                    negative-divisor? (!= (& d minimum) 0)
                    negative-magic? (!= (& (.magic recipe) minimum) 0)]
                ; The W-form constant is the magic word; SMULL sign-extends it.
                (unless held?
                  (constant! (mut output) (mut error) wide 16 (.magic recipe)))
                (high! (mut output) (mut error) wide true n m)
                (when (and (not negative-divisor?) negative-magic?)
                  (word! (mut output) (mut error) (encode/add-sub wide false false 16 16 n)))
                (when (and negative-divisor? (not negative-magic?))
                  (word! (mut output) (mut error) (encode/add-sub wide true false 16 16 n)))
                (when (> (.shift recipe) 0)
                  (word! (mut output) (mut error)
                         (encode/shift-immediate wide 2 16 16 (.shift recipe))))
                (word! (mut output) (mut error)
                       (encode/add-sub-shifted wide false
                                               (if (remainder? rule) (: 16 i32) rd)
                                               16 16 1 (- width 1))))
              (let [recipe (recipes/unsigned-recipe d width (if (>= rule 63) (: 1 i32) 0))]
                (when (and (.add recipe) (> (.pre recipe) 0))
                  (set! error "reciprocal division recipe needs both a pre-shift and a fix-up"))
                (when (> (.pre recipe) 0)
                  (word! (mut output) (mut error)
                         (encode/shift-immediate wide 1 17 n (.pre recipe))))
                (unless held?
                  (constant! (mut output) (mut error) wide 16 (.magic recipe)))
                (high! (mut output) (mut error) wide false
                       (if (> (.pre recipe) 0) (: 17 i32) n) m)
                (when (.add recipe)
                  (word! (mut output) (mut error) (encode/add-sub wide true false 17 n 16))
                  (word! (mut output) (mut error)
                         (encode/add-sub-shifted wide false 16 16 17 1 1)))
                (if (remainder? rule)
                    (when (> (.post recipe) 0)
                      (word! (mut output) (mut error)
                             (encode/shift-immediate wide 1 16 16 (.post recipe))))
                    (word! (mut output) (mut error)
                           (if (> (.post recipe) 0)
                               (encode/shift-immediate wide 1 rd 16 (.post recipe))
                               (encode/logical-register wide 1 rd 31 16))))))
          (when (remainder? rule)
            (constant! (mut output) (mut error) wide 17 d)
            (word! (mut output) (mut error) (encode/multiply-subtract wide rd 16 17 n)))
          (if (= error "") (Ok (cast i32 (- (len output) start))) (Err error))))))
