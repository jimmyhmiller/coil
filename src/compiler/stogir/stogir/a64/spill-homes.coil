;;; Canonical homes for existing spills, following ir_ra.c assign_regs. See NOTICE.
(module stogir.a64.spill-homes)
(import "stogir.fill" :as fill)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.opcode" :as op)
(import "stogir.schedule" :as schedule)
(import "stogir.locations" :as loc)
(import "stogir.matched-uses" :as machine)
(import "stogir.a64.match" :as matching)
(import "stogir.a64.allocate" :as allocate)
(import "stogir.a64.coalesce" :as coalesce)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Some None Ok Err])

(defstruct Home [(parent i32) (offset i64) (size i32)
                 (blocked bool) (seen bool) (last i64)])

(defn width [(graph g/Graph) (reference i32)] (-> i32)
  (match (g/lookup graph reference)
    (None [] 0)
    (Some [node]
      (let [size (types/size (cast i32 (n/type-id node)) 8)]
        (if (or (<= size 0) (> size 16)) 0 (if (< size 4) 4 size))))))

;;; A view (coalesce/reusable?) sharing its source's parent has the source's
;;; bits, which the source's own definition delivered to the home: the source
;;; is live up to the view, so no other member of the parent wrote in between.
;;; Its definition therefore writes nothing, whatever its width.
(defn view-of-parent? [(graph g/Graph) (assigned allocate/Assigned) (value i32) (parent i32)]
  (-> bool)
  (and (coalesce/reusable? graph value)
       (let [source (.op1 (get (.instructions graph) (cast i64 value)))]
         (and (> source 0)
              (< (cast i64 source) (len (.parents (.locations assigned))))
              (> (.count (get (.parents (.locations assigned)) (cast i64 source))) 0)
              (= (loc/owner (.parts assigned) (.locations assigned) source) parent)))))

;;; A Phi transfer from a register into the Phi's established home carries no
;;; news when the incoming value belongs to the same parent: its definition
;;; already wrote that home, and members of one parent are never live together.
(defn established-phi-store? [(graph g/Graph) (assigned allocate/Assigned)
                              (move loc/Transfer) (predecessor i32)] (-> bool)
  (let [established (.established-homes assigned)
        phi (.parent move)
        parents (.parents (.locations assigned))]
    (and (= (.kind (.source move)) 0) (= (.kind (.destination move)) 1)
         (> phi 0) (< (cast i64 phi) (len parents))
         (> (.count (get parents (cast i64 phi))) 0)
         (let [parent (cast i64 (loc/owner (.parts assigned) (.locations assigned) phi))]
           (and (> parent 0) (< parent (len established))
                (= (get established parent) (.value (.destination move)))
                (match (g/operand graph phi (+ predecessor 1))
                  (None [] false)
                  (Some [source]
                    (and (> source 0) (< (cast i64 source) (len parents))
                         (> (.count (get parents (cast i64 source))) 0)
                         (= (cast i64 (loc/owner (.parts assigned) (.locations assigned) source))
                            parent)))))))))

;;; Complete definitions establish a private parent's memory value. Later
;;; contiguous register-to-home stores then carry no new information. Keep the
;;; old protocol for parents whose definitions cannot all be certified.
;;; Writeback at the next use phase is after the defining instruction and before
;;; the next instruction. Valued block terminals/independent entries and exposed
;;; machine frames retain the original protocol. Layout sees every new action.
(defn plan! [(graph g/Graph) (scheduled schedule/Schedule)
              (assigned allocate/Assigned) (matched matching/Plan)
              (moves (mut (ArrayList loc/Transfer))) (a (dyn Allocator))] (-> i32)
  (let [(mut established) (ArrayList::new [i64] a)
        result (plan-certified! graph scheduled assigned matched (mut moves) (mut established) a)]
    (free! (mut established)) result))

;;; Filter only ordinary same-value edge stores using the complete-definition
;;; certificate. Phi edge transfers establish incoming values and are excluded.
(defn omit-established-stores! [(moves (mut (ArrayList loc/Transfer)))
                                 (established (slice i64))] (-> i64)
  (let [(mut kept) 0 original (len moves)]
    (let [items-108 moves (mut for-index-108) (: 0 i64)] (while (< for-index-108 (len items-108)) (let [move (get items-108 for-index-108)]
      (let [parent (cast i64 (.parent move))]
        (unless (and (> parent 0) (< parent (len established))
                     (= (.kind (.source move)) 0) (= (.kind (.destination move)) 1)
                     (>= (get established parent) 0)
                     (= (get established parent) (.value (.destination move))))
          (set! (mut moves) kept move) (set! kept (+ kept 1))))) (set! for-index-108 (+ for-index-108 1))))
    (while (> (len moves) kept) (pop! (mut moves)))
    (- original kept)))

(defn plan-certified! [(graph g/Graph) (scheduled schedule/Schedule)
              (assigned allocate/Assigned) (matched matching/Plan)
              (moves (mut (ArrayList loc/Transfer)))
              (established (mut (ArrayList i64))) (a (dyn Allocator))] (-> i32)
  (clear! (mut established))
  (let [(mut needed) false (mut supported) true]
    (let [items-107 moves (mut for-index-107) (: 0 i64)] (while (< for-index-107 (len items-107)) (let [move (get items-107 for-index-107)]
      (when (and (= (.kind (.source move)) 0) (= (.kind (.destination move)) 1))
        (set! needed true))) (set! for-index-107 (+ for-index-107 1))))
    (when needed
      (let [items-106 (.nodes scheduled) (mut for-index-106) (: 0 i64)] (while (< for-index-106 (len items-106)) (let [reference (get items-106 for-index-106)]
      (let [node (get (.instructions graph) (cast i64 reference))
            opcode (n/opcode node)]
        ; Stack scopes (BLOCK_BEGIN/BLOCK_END/AFREE) move SP below the fixed
        ; frame; homes stay fixed-frame slots, so they keep their meaning.
        (when (or (= opcode 66)
                  (= opcode 105) (= opcode 119)
                  (and (= opcode 106) (!= (.op2 node) 0)))
          (set! supported false)))) (set! for-index-106 (+ for-index-106 1)))))
    (if (not (and needed supported))
        0
        (let [(mut indices) (ArrayList::new [i32] a)
              (mut homes) (ArrayList::new [Home] a)
              (mut writes) (ArrayList::new [loc/Transfer] a)
              (mut entries) (ArrayList::new [i64] a)
              (mut changed) (: 0 i32)]
          (fill/append! (mut indices) (len (.instructions graph)) 0)
          (let [items-105 moves (mut for-index-105) (: 0 i64)] (while (< for-index-105 (len items-105)) (let [move (get items-105 for-index-105)]
            (let [parent (.parent move)]
              (when (and (> parent 0) (< (cast i64 parent) (len indices))
                         (= (.kind (.source move)) 0) (= (.kind (.destination move)) 1))
                (let [(mut id) (get indices (cast i64 parent))]
                  (when (= id 0)
                    (push! (mut homes) (Home :parent parent :offset (.value (.destination move))
                                          :size (width graph parent) :blocked false :seen false :last -1))
                    (set! id (cast i32 (len homes)))
                    (set! (mut indices) (cast i64 parent) id))
                  (let [home (elem (mut homes) (cast i64 (- id 1)))]
                    (when (!= (.offset home) (.value (.destination move))) (set! (.blocked home) true))
                    ; A value cut at framed spans is meant to stay out of
                    ; memory elsewhere: a home written at its definitions
                    ; would put a store on the paths the cut keeps frameless.
                    (when (allocate/cut-parent? assigned parent) (set! (.blocked home) true))
                    (match (get (.parents (.frame assigned)) parent)
                      (None [] (set! (.blocked home) true))
                      (Some [slot]
                        (if (or (< slot 0) (>= slot (len (.slots (.frame assigned)))))
                            (set! (.blocked home) true)
                            (let [shape (get (.slots (.frame assigned)) slot)]
                              (unless (and (> (.size home) 0) (= (cast i64 (.size home)) (.size shape))
                                           (= (.offset home) (.offset shape)))
                                (set! (.blocked home) true))))))))))) (set! for-index-105 (+ for-index-105 1))))
          ; Phi transfers deliver each incoming value to the Phi's location at
          ; its block entry (edge-moves.phis-impl), not at its own position.
          (fill/append! (mut entries) (len (.nodes scheduled)) 0)
          (let [items-104 (.ranges scheduled) (mut for-index-104) (: 0 i64)] (while (< for-index-104 (len items-104)) (let [range (get items-104 for-index-104)]
            (for [k 0 (.count range)]
              (set! (mut entries) (+ (.offset range) k) (* (.offset range) 2)))) (set! for-index-104 (+ for-index-104 1))))
          (for [i 0 (len (.nodes scheduled))]
            (let [reference (get (.nodes scheduled) i)
                  position (+ (* i 2) 1)
                  post (+ position 1)]
              (for [j 0 (machine/definition-count (.operands matched) reference)]
                (let [value (machine/definition-at (.operands matched) reference j)]
                  (when (and (> value 0) (< (cast i64 value) (len (.parents (.locations assigned))))
                             (> (.count (get (.parents (.locations assigned)) (cast i64 value))) 0))
                    (let [parent (loc/owner (.parts assigned) (.locations assigned) value)
                          id (if (and (> parent 0) (< (cast i64 parent) (len indices)))
                                 (get indices (cast i64 parent)) 0)]
                      (when (and (> id 0) (not (view-of-parent? graph assigned value parent)))
                        (let [home (elem (mut homes) (cast i64 (- id 1)))]
                          (set! (.seen home) true)
                          (when (or (= (.last home) position) (!= (width graph value) (.size home))
                                    (op/block-end? (cast i32 (n/opcode (get (.instructions graph)
                                                                                   (cast i64 reference)))))
                                    (>= (+ i 1) (len (.nodes scheduled))))
                            (set! (.blocked home) true))
                          (set! (.last home) position)
                          (when (< (+ i 1) (len (.nodes scheduled)))
                            (when (op/block-start? (cast i32 (n/opcode (get (.instructions graph)
                                      (cast i64 (get (.nodes scheduled) (+ i 1)))))))
                              (set! (.blocked home) true)))
                          ; A Phi in a register at entry is written there by its
                          ; transfers and literals; only entry in the home itself
                          ; establishes the home on every incoming edge.
                          (when (= (n/opcode (get (.instructions graph) (cast i64 reference))) 67)
                            (match (loc/lookup-indexed (.parts assigned) (.locations assigned)
                                                       value (get entries i))
                              (Err [_] (set! (.blocked home) true))
                              (Ok [entry]
                                (unless (and (= (.kind entry) 1) (= (.value entry) (.offset home)))
                                  (set! (.blocked home) true)))))
                          (match (loc/lookup-indexed (.parts assigned) (.locations assigned) value position)
                            (Err [_] (set! (.blocked home) true))
                            (Ok [source]
                              (cond (= (.kind source) 0)
                                      (push! (mut writes) (loc/Transfer :position post :parent parent
                                                :source source :destination (loc/Location :kind 1 :value (.offset home))))
                                    (and (= (.kind source) 1) (= (.value source) (.offset home))) 0
                                    :else (set! (.blocked home) true))))))))))))
          (let [(mut kept) 0]
            (let [items-103 moves (mut for-index-103) (: 0 i64)] (while (< for-index-103 (len items-103)) (let [move (get items-103 for-index-103)]
              (let [parent (.parent move)
                    id (if (and (> parent 0) (< (cast i64 parent) (len indices)))
                           (get indices (cast i64 parent)) 0)
                    remove (and (> id 0) (.seen (get homes (cast i64 (- id 1))))
                                (not (.blocked (get homes (cast i64 (- id 1)))))
                                (= (.kind (.source move)) 0) (= (.kind (.destination move)) 1))]
                (if remove (set! changed (+ changed 1))
                    (do (set! (mut moves) kept move) (set! kept (+ kept 1)))))) (set! for-index-103 (+ for-index-103 1))))
            (while (> (len moves) kept) (pop! (mut moves))))
          (let [items-102 writes (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [write (get items-102 for-index-102)]
            (let [id (get indices (cast i64 (.parent write))) home (get homes (cast i64 (- id 1)))]
              (when (and (.seen home) (not (.blocked home)))
                (push! (mut moves) write) (set! changed (+ changed 1))))) (set! for-index-102 (+ for-index-102 1))))
          (fill/append! (mut established) (len (.instructions graph)) -1)
          (let [items-101 homes (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [home (get items-101 for-index-101)]
            (when (and (.seen home) (not (.blocked home)))
              (set! (mut established) (cast i64 (.parent home)) (.offset home)))) (set! for-index-101 (+ for-index-101 1))))
          (free! (mut indices)) (free! (mut homes)) (free! (mut writes))
          (free! (mut entries))
          changed))))
