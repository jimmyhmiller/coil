;;; Disjoint physical numbering for general-purpose and scalar SIMD registers.
(module stogir.a64.registers)
(import "stogir.types" :as types)

(defn gpr? [(register i32)] (-> bool)
  (and (>= register 0) (< register 32)))

(defn simd? [(register i32)] (-> bool)
  (and (>= register 32) (< register 64)))

(defn physical [(register i32)] (-> i32)
  (if (or (gpr? register) (simd? register)) (& register 31) -1))

(defn gpr-mask [] (-> u64)
  0xFFFF)

;;; v0..v7 and v16..v29 are caller-saved. Avoid v8..v15 until callee-save
;;; preservation is implemented. v30/v31 are reserved floating scratches;
;;; integer population count also uses v31. x16/x17 remain GPR scratches.
(defn simd-mask [] (-> u64)
  0x3FFF00FF00000000)

(defn simd-type? [(ty i32)] (-> bool)
  (or (types/floating? ty) (types/short-vector? ty 8)))

(defn class-mask [(ty i32)] (-> u64)
  (if (types/integer? ty)
      (gpr-mask)
      (if (simd-type? ty) (simd-mask) (: 0 u64))))

(defn allocatable? [(ty i32) (register i32)] (-> bool)
  (and (>= register 0)
       (< register 64)
       (!= (& (class-mask ty) (<< (: 1 u64) (cast u64 register))) 0)))
