; Integer DIV/MOD/ROL sequences adapted from dstogov/ir ir_aarch64.dasc, 92171d0. See NOTICE.
;;; Emit selected arithmetic after physical register assignment.
(module stogir.a64.emit)
(import "stogir.a64.select" :as select)
(import "stogir.a64.encode" :as encode)
(import "stogir.bytes" :as bytes)
(import "stogir.graph" :as graph)
(import "stogir.node" :as node)
(import "stogir.types" :as types)
(import "stogir.allocation" :as allocation)
(import "stogir.locations" :as locations)
(import "stogir.a64.code" :as code)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn logical-word [(tile select/Tile) (operation i32) (rd i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (if (> (.immediate tile) 8191)
      (Err "logical immediate fields exceed encoding range")
      (encode/logical-immediate (.wide tile)
                                operation
                                rd
                                rn
                                (cast u32 (.immediate tile)))))

(defn comparison-word [(tile select/Tile) (rn i32) (rm i32)]
  (-> (Result u32 (slice u8)))
  (if (= (.right tile) 0)
      (let [value (cast i64 (.immediate tile))]
        (if (or (< value -16773120) (> value 16773120))
            (Err "comparison immediate exceeds encoding range")
            (encode/add-sub-immediate (.wide tile)
                                      (>= value 0)
                                      true
                                      31
                                      rn
                                      (if (< value 0) (- (: 0 i64) value) value))))
      (encode/add-sub (.wide tile) true true 31 rn rm)))

;;; rd/rn/rm are assigned general-purpose registers. SP/ZR are deliberately
;;; excluded here; instruction-specific ABI/frame lowering uses encoders directly.
(defn single! [(output (mut (ArrayList u8)))
               (tile select/Tile)
               (rd i32)
               (rn i32)
               (rm i32)] (-> (Result i32 (slice u8)))
  (if (or (< rd 0)
          (> rd 30)
          (< rn 0)
          (> rn 30)
          (and (not (or (= (.rule tile) 4) (= (.rule tile) 5)))
               (or (< rm 0) (> rm 30))))
      (Err "invalid arithmetic physical register")
      (let [instruction
              (match (.rule tile)
                (1 (encode/add-sub (.wide tile) false false rd rn rm))
                (2 (encode/add-sub (.wide tile) true false rd rn rm))
                (3 (encode/multiply (.wide tile) rd rn rm))
                (4 (if (> (.immediate tile) 16773120)
                       (Err "immediate exceeds encoding range")
                       (encode/add-sub-immediate (.wide tile)
                                                 false
                                                 false
                                                 rd
                                                 rn
                                                 (cast i64 (.immediate tile)))))
                (5 (if (> (.immediate tile) 16773120)
                       (Err "immediate exceeds encoding range")
                       (encode/add-sub-immediate (.wide tile)
                                                 true
                                                 false
                                                 rd
                                                 rn
                                                 (cast i64 (.immediate tile)))))
                (6 (encode/logical-register (.wide tile) 1 rd rn rm))
                (7 (encode/logical-register (.wide tile) 0 rd rn rm))
                (8 (encode/logical-register (.wide tile) 2 rd rn rm))
                (41 (logical-word tile 1 rd rn))
                (42 (logical-word tile 0 rd rn))
                (43 (logical-word tile 2 rd rn))
                (9 (encode/variable-shift (.wide tile) 0 rd rn rm))
                (10 (encode/variable-shift (.wide tile) 1 rd rn rm))
                (11 (encode/variable-shift (.wide tile) 2 rd rn rm))
                (13 (encode/variable-shift (.wide tile) 3 rd rn rm))
                (38 (encode/shift-immediate (.wide tile)
                                            0
                                            rd
                                            rn
                                            (cast i32 (.immediate tile))))
                (39 (encode/shift-immediate (.wide tile)
                                            1
                                            rd
                                            rn
                                            (cast i32 (.immediate tile))))
                (40 (encode/shift-immediate (.wide tile)
                                            2
                                            rd
                                            rn
                                            (cast i32 (.immediate tile))))
                (48 (encode/extract (.wide tile)
                                    (cast i32 (>> (.immediate tile) 8))
                                    (cast i32 (& (.immediate tile) 255)) rd rn))
                (14 (encode/divide (.wide tile) false rd rn rm))
                (15 (encode/divide (.wide tile) true rd rn rm))
                (_ (if (and (>= (.rule tile) 20) (<= (.rule tile) 33))
                       (encode/conditional-set false rd (- (.rule tile) 20))
                       (Err "unsupported arithmetic tile"))))]
        (match instruction
          (Err [msg] (Err msg))
          (Ok [word]
              (if (and (>= (.rule tile) 20) (<= (.rule tile) 33))
                  (match (comparison-word tile rn rm)
                    (Err [msg] (Err msg))
                    (Ok [compare-word]
                        (do
                          (bytes/append32! (mut output) compare-word)
                          (bytes/append32! (mut output) word)
                          (Ok 8))))
                  (do (bytes/append32! (mut output) word) (Ok 4))))))))

(defn operand-register-with-locations! [(output (mut code/Buffer))
                                        (graph graph/Graph)
                                        (parts locations/View)
                                        (value i32)
                                        (position i64)
                                        (wide bool)
                                        (scratch i32)]
  (-> (Result i32 (slice u8)))
  (if (< value 0)
      (match (graph/lookup graph value)
        (None [] (Err "missing constant operand"))
        (Some [node]
              (match (code/materialize! (mut output) graph value wide scratch)
                (Err [msg] (Err msg))
                (Ok [_] (Ok scratch)))))
      (match (locations/resolve parts value position)
        (Err [msg] (Err msg))
        (Ok [location]
            (if (!= (.kind location) 0)
                (Err "required operand is not in register")
                (Ok (cast i32 (.value location))))))))

(defn word! [(output (mut (ArrayList u8)))
             (error (ptr (slice u8)))
             (instruction (Result u32 (slice u8)))] (-> void)
  (when (= (load error) "")
    (match instruction
      (Err [message] (store! error message))
      (Ok [word] (bytes/append32! (mut output) word)))))

;;; Normalize into reserved scratches without altering still-live operands.
;;; Repeated byte/halfword patterns make a 32-bit ROR a narrow rotate.
(defn narrow! [(output (mut (ArrayList u8)))
               (tile select/Tile)
               (opcode i32)
               (ty i32)
               (bits i32)
               (rd i32)
               (rn i32)
               (rm i32)]
  (-> (Result i32 (slice u8)))
  (let [start (len output)
        (mut error) ""
        comparison? (and (>= opcode 14) (<= opcode 23))
        signed-compare? (and (>= opcode 16) (<= opcode 19))
        signed-values?
          (and (or (= opcode 29) (= opcode 30) (= opcode 58) (= opcode 59))
               (types/signed? ty))
        shift? (and (>= opcode 49) (<= opcode 51))
        rotate? (or (= opcode 52) (= opcode 53))]
    (word! (mut output)
           (mut error)
           (encode/extend false
                          (or signed-compare? signed-values? (= opcode 51))
                          bits
                          16
                          rn))
    (when (!= (.right tile) 0)
      (word! (mut output)
             (mut error)
             (encode/extend false
                            (or signed-compare? signed-values?)
                            (if shift? (if (= bits 8) 3 4) bits)
                            17
                            rm)))
    (when rotate?
      (when (= bits 8)
        (word! (mut output)
               (mut error)
               (encode/logical-shifted false 1 16 16 16 8)))
      (word! (mut output)
             (mut error)
             (encode/logical-shifted false 1 16 16 16 16)))
    (when (= error "")
      (match (arithmetic! (mut output)
                          tile
                          rd
                          16
                          (if (= (.right tile) 0) (: 0 i32) (: 17 i32)))
        (Err [message] (set! error message))
        (Ok [_] 0)))
    (when (not comparison?)
      (word! (mut output)
             (mut error)
             (encode/extend false (types/signed? ty) bits rd rd)))
    (if (= error "") (Ok (cast i32 (- (len output) start))) (Err error))))

(defn operands-with-locations! [(output (mut code/Buffer))
                                (graph graph/Graph)
                                (parts locations/View)
                                (tile select/Tile)
                                (opcode i32)
                                (rd i32)
                                (position i64)] (-> (Result i32 (slice u8)))
  (match (graph/lookup graph (.left tile))
    (None [] (Err "selected source missing"))
    (Some [source]
          (let [ty (cast i32 (node/type-id source))
                bits (* 8 (types/scalar-size ty 8))]
            (match (operand-register-with-locations! (mut output)
                                                     graph
                                                     parts
                                                     (.left tile)
                                                     position
                                                     (.wide tile)
                                                     16)
              (Err [message] (Err message))
              (Ok [left]
                  (match (if (= (.right tile) 0)
                             (Ok (: 0 i32))
                             (operand-register-with-locations! (mut output)
                                                               graph
                                                               parts
                                                               (.right tile)
                                                               position
                                                               (.wide tile)
                                                               17))
                    (Err [message] (Err message))
                    (Ok [right]
                        (if (< bits 32)
                            (narrow! (mut (.text output))
                                     tile
                                     opcode
                                     ty
                                     bits
                                     rd
                                     left
                                     right)
                            (arithmetic! (mut (.text output))
                                         tile
                                         rd
                                         left
                                         right))))))))))

;;; Allocation reserves x16/x17 for materialization, narrow normalization and
;;; cycle resolution. Compose bytes and pending references atomically.
(defn allocated-selected-with-locations! [(output (mut code/Buffer))
                                          (graph graph/Graph)
                                          (parts locations/View)
                                          (reference i32)
                                          (position i64)
                                          (tile select/Tile)
                                          (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut temporary) (code/create allocator)
        (mut error) ""]
    (match (locations/resolve parts reference (+ position 1))
      (Err [message] (set! error message))
      (Ok [destination]
          (if (!= (.kind destination) 0)
              (set! error "result lacks register")
              (match (operands-with-locations! (mut temporary)
                                               graph
                                               parts
                                               tile
                                               (cast i32
                                                     (node/opcode (get (.instructions graph)
                                                                       (cast i64
                                                                             reference))))
                                               (cast i32 (.value destination))
                                               position)
                (Err [message] (set! error message))
                (Ok [_] 0)))))
    (let [written (cast i32 (len (.text temporary)))]
      (when (and (= error "") (not (code/append! (mut output) temporary)))
        (set! error "invalid temporary code references"))
      (code/release! (mut temporary))
      (if (= error "") (Ok written) (Err error)))))

(defn allocated-arithmetic-with-locations! [(output (mut code/Buffer))
                                            (graph graph/Graph)
                                            (parts locations/View)
                                            (reference i32)
                                            (position i64)
                                            (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (select/select graph reference)
    (Err [message] (Err message))
    (Ok [tile]
        (allocated-selected-with-locations! (mut output)
                                            graph
                                            parts
                                            reference
                                            position
                                            tile
                                            allocator))))

;;; Emit two checked words atomically, so invalid operands leave output intact.
(defn pair! [(output (mut (ArrayList u8)))
             (first (Result u32 (slice u8)))
             (second (Result u32 (slice u8)))]
  (-> (Result i32 (slice u8)))
  (match first
    (Err [msg] (Err msg))
    (Ok [a]
        (match second
          (Err [msg] (Err msg))
          (Ok [b]
              (do
                (bytes/append32! (mut output) a)
                (bytes/append32! (mut output) b)
                (Ok 8)))))))

;;; x16/x17 are reserved scratch registers. With two literal operands both are
;;; occupied, so an independent destination holds the quotient. Never overwrite
;;; an original dividend/divisor before the multiply-subtract consumes it.
;;; Persistent power-of-two rules use a sign-derived bias for truncation toward
;;; zero. x16/x17 are reserved temporaries. Copy a source held in the chosen
;;; scratch before clobbering it; allocated live input registers remain intact.
(defn power-division! [(output (mut (ArrayList u8)))
                       (tile select/Tile)
                       (rd i32)
                       (rn i32)] (-> (Result i32 (slice u8)))
  (let [width (if (.wide tile) (: 64 i32) (: 32 i32))
        shift (cast i32 (.immediate tile))
        signed? (or (= (.rule tile) 45) (= (.rule tile) 47))
        remainder? (>= (.rule tile) 46)
        start (len output)
        (mut error) ""]
    (if (or (>= (.immediate tile) (cast u64 width))
            (and signed? (>= shift (- width 1))))
        (Err "power-of-two division exponent exceeds type range")
        (do
          (if (= shift 0)
              (word! (mut output)
                     (mut error)
                     (encode/logical-register (.wide tile)
                                              1
                                              rd
                                              31
                                              (if remainder? 31 rn)))
              (if (not signed?)
                  (if remainder?
                      (match (encode/logical-mask (.wide tile)
                                                  (- (<< (: 1 u64)
                                                         (cast u64 shift))
                                                     1))
                        (None []
                              (set! error
                                    "power-of-two remainder mask is invalid"))
                        (Some [fields]
                              (word! (mut output)
                                     (mut error)
                                     (encode/logical-immediate (.wide tile)
                                                               0
                                                               rd
                                                               rn
                                                               fields))))
                      (word! (mut output)
                             (mut error)
                             (encode/shift-immediate (.wide tile) 1 rd rn shift)))
                  (let [scratch (if (= rd 16) (: 17 i32) (: 16 i32))
                        source (if (= rn scratch) rd rn)]
                    (when (= rn scratch)
                      (word! (mut output)
                             (mut error)
                             (encode/logical-register (.wide tile) 1 rd 31 rn)))
                    (word! (mut output)
                           (mut error)
                           (encode/shift-immediate (.wide tile)
                                                   2
                                                   scratch
                                                   source
                                                   (- width 1)))
                    (word! (mut output)
                           (mut error)
                           (encode/shift-immediate (.wide tile)
                                                   1
                                                   scratch
                                                   scratch
                                                   (- width shift)))
                    (word! (mut output)
                           (mut error)
                           (encode/add-sub (.wide tile)
                                           false
                                           false
                                           rd
                                           source
                                           scratch))
                    (if remainder?
                        (do
                          (match (encode/logical-mask (.wide tile)
                                                      (- (<< (: 1 u64)
                                                             (cast u64 shift))
                                                         1))
                            (None []
                                  (set! error
                                        "power-of-two remainder mask is invalid"))
                            (Some [fields]
                                  (word! (mut output)
                                         (mut error)
                                         (encode/logical-immediate (.wide tile)
                                                                   0
                                                                   rd
                                                                   rd
                                                                   fields))))
                          (word! (mut output)
                                 (mut error)
                                 (encode/add-sub (.wide tile)
                                                 true
                                                 false
                                                 rd
                                                 rd
                                                 scratch)))
                        (word! (mut output)
                               (mut error)
                               (encode/shift-immediate (.wide tile)
                                                       2
                                                       rd
                                                       rd
                                                       shift))))))
          (if (= error "") (Ok (cast i32 (- (len output) start))) (Err error))))))

(defn arithmetic! [(output (mut (ArrayList u8)))
                   (tile select/Tile)
                   (rd i32)
                   (rn i32)
                   (rm i32)] (-> (Result i32 (slice u8)))
  (if (or (< rd 0)
          (> rd 30)
          (< rn 0)
          (> rn 30)
          (and (!= (.right tile) 0) (or (< rm 0) (> rm 30))))
      (Err "invalid arithmetic physical register")
      (if (and (>= (.rule tile) 44) (<= (.rule tile) 47))
          (power-division! (mut output) tile rd rn)
          (if (and (>= (.rule tile) 34) (<= (.rule tile) 37))
              (pair! (mut output)
                     (encode/add-sub (.wide tile) true true 31 rn rm)
                     (encode/conditional-select (.wide tile)
                                                rd
                                                rn
                                                rm
                                                (match (.rule tile)
                                                  (34 9)
                                                  (35 13)
                                                  (36 2)
                                                  (_ 10))))
              (if (= (.rule tile) 12)
                  (let [scratch (if (= rn 17) (: 16 i32) (: 17 i32))]
                    (pair! (mut output)
                           (encode/add-sub (.wide tile)
                                           true
                                           false
                                           scratch
                                           31
                                           rm)
                           (encode/variable-shift (.wide tile) 3 rd rn scratch)))
                  (if (or (= (.rule tile) 16) (= (.rule tile) 17))
                      (let [scratch
                              (if (and (!= rn 16) (!= rm 16))
                                  (: 16 i32)
                                  (if (and (!= rn 17) (!= rm 17))
                                      (: 17 i32)
                                      (if (and (!= rd rn) (!= rd rm))
                                          rd
                                          (: -1 i32))))]
                        (if (< scratch 0)
                            (Err "remainder requires independent quotient register")
                            (pair! (mut output)
                                   (encode/divide (.wide tile)
                                                  (= (.rule tile) 17)
                                                  scratch
                                                  rn
                                                  rm)
                                   (encode/multiply-subtract (.wide tile)
                                                             rd
                                                             scratch
                                                             rm
                                                             rn))))
                      (single! (mut output) tile rd rn rm)))))))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn operand-register! [(output (mut code/Buffer))
                         (graph graph/Graph)
                         (parts (ArrayList allocation/Part))
                         (value i32)
                         (position i64)
                         (wide bool)
                         (scratch i32)] (-> (Result i32 (slice u8)))
  (operand-register-with-locations! (mut output)
                                    graph
                                    (locations/linear-view parts)
                                    value
                                    position
                                    wide
                                    scratch))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn operands! [(output (mut code/Buffer))
                 (graph graph/Graph)
                 (parts (ArrayList allocation/Part))
                 (tile select/Tile)
                 (opcode i32)
                 (rd i32)
                 (position i64)] (-> (Result i32 (slice u8)))
  (operands-with-locations! (mut output)
                            graph
                            (locations/linear-view parts)
                            tile
                            opcode
                            rd
                            position))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn allocated-selected! [(output (mut code/Buffer))
                           (graph graph/Graph)
                           (parts (ArrayList allocation/Part))
                           (reference i32)
                           (position i64)
                           (tile select/Tile)
                           (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (allocated-selected-with-locations! (mut output)
                                      graph
                                      (locations/linear-view parts)
                                      reference
                                      position
                                      tile
                                      allocator))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn allocated-arithmetic! [(output (mut code/Buffer))
                             (graph graph/Graph)
                             (parts (ArrayList allocation/Part))
                             (reference i32)
                             (position i64)
                             (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (allocated-arithmetic-with-locations! (mut output)
                                        graph
                                        (locations/linear-view parts)
                                        reference
                                        position
                                        allocator))
