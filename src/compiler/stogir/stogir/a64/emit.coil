; Integer DIV/MOD/ROL sequences adapted from dstogov/ir ir_aarch64.dasc, 92171d0. See NOTICE.
;;; Emit selected arithmetic after physical register assignment.
(module stogir.a64.emit)
(import "stogir.a64.frame-address" :as frame-address)
(import "stogir.a64.select" :as select)
(import "stogir.a64.encode" :as encode)
(import "stogir.bytes" :as bytes)
(import "stogir.graph" :as graph)
(import "stogir.node" :as node)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "stogir.allocation" :as allocation)
(import "stogir.locations" :as locations)
(import "stogir.a64.code" :as code)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Option Some None])

(defn logical-word [(tile select/Tile) (operation i32) (rd i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (if (> (.immediate tile) 8191)
      (Err "logical immediate fields exceed encoding range")
      (encode/logical-immediate (.wide tile)
                                operation
                                rd
                                rn
                                (cast u32 (.immediate tile)))))

(defn comparison-word [(tile select/Tile) (rn i32) (rm i32)]
  (-> (Result u32 (slice u8)))
  (if (= (.right tile) 0)
      (let [value (cast i64 (.immediate tile))]
        (if (or (< value -16773120) (> value 16773120))
            (Err "comparison immediate exceeds encoding range")
            (encode/add-sub-immediate (.wide tile)
                                      (>= value 0)
                                      true
                                      31
                                      rn
                                      (if (< value 0) (- (: 0 i64) value) value))))
      (encode/add-sub (.wide tile) true true 31 rn rm)))

;;; Register forms whose source register 31 encodes XZR: ADD/SUB and logical
;;; shifted-register forms, MUL (MADD), the flag-setting comparison and the
;;; CMP/CSEL pair of MIN/MAX.
(defn zero-register-rule? [(rule i32)] (-> bool)
  (or (= rule 1) (= rule 2) (= rule 3) (= rule 6) (= rule 7) (= rule 8)
      (and (>= rule 20) (<= rule 37))))

(defn zero-literal? [(graph graph/Graph) (reference i32)] (-> bool)
  (and (< reference 0)
       (match (graph/lookup graph reference)
         (None [] false)
         (Some [node] (and (symbols/numeric? node) (types/integer? (cast i32 (node/type-id node)))
                           (= (node/constant-bits node) 0))))))

(defn source-register? [(rule i32) (r i32)] (-> bool)
  (and (>= r 0) (or (<= r 30) (and (= r 31) (zero-register-rule? rule)))))

;;; rd/rn/rm are assigned general-purpose registers. SP/ZR are deliberately
;;; excluded here; instruction-specific ABI/frame lowering uses encoders directly.
(defn single! [(output (mut (ArrayList u8)))
               (tile select/Tile)
               (rd i32)
               (rn i32)
               (rm i32)] (-> (Result i32 (slice u8)))
  (if (or (< rd 0)
          (> rd 30)
          (not (source-register? (.rule tile) rn))
          (and (not (or (= (.rule tile) 4) (= (.rule tile) 5)))
               (not (source-register? (.rule tile) rm))))
      (Err "invalid arithmetic physical register")
      (if (or (= (.rule tile) 56)
              (and (>= (.rule tile) 38) (<= (.rule tile) 40) (= (.immediate tile) 0)))
      ; A zero-count shift (selection also turns a multiply by one into LSL #0)
      ; is the source itself. A W result still zero-extends, as LSL W #0 would.
      ; Rule 56 is the same X-form move of an already extended source.
      (if (and (.wide tile) (= rd rn))
          (Ok 0)
          (match (encode/logical-register (.wide tile) 1 rd 31 rn)
            (Err [msg] (Err msg))
            (Ok [word] (do (bytes/append32! (mut output) word) (Ok 4)))))
      (let [instruction
              (match (.rule tile)
                (1 (encode/add-sub (.wide tile) false false rd rn rm))
                (2 (encode/add-sub (.wide tile) true false rd rn rm))
                (3 (encode/multiply (.wide tile) rd rn rm))
                (52 (encode/add-sub-shifted (.wide tile) false rd rn rn 0
                                            (cast i32 (.immediate tile))))
                (50 (encode/add-sub-shifted (.wide tile) false rd rn rm
                      (cast i32 (>> (.immediate tile) 8)) (cast i32 (& (.immediate tile) 255))))
                (51 (encode/add-sub-shifted (.wide tile) true rd rn rm
                      (cast i32 (>> (.immediate tile) 8)) (cast i32 (& (.immediate tile) 255))))
                (4 (if (> (.immediate tile) 16773120)
                       (Err "immediate exceeds encoding range")
                       (encode/add-sub-immediate (.wide tile)
                                                 false
                                                 false
                                                 rd
                                                 rn
                                                 (cast i64 (.immediate tile)))))
                (5 (if (> (.immediate tile) 16773120)
                       (Err "immediate exceeds encoding range")
                       (encode/add-sub-immediate (.wide tile)
                                                 true
                                                 false
                                                 rd
                                                 rn
                                                 (cast i64 (.immediate tile)))))
                (6 (encode/logical-register (.wide tile) 1 rd rn rm))
                (7 (encode/logical-register (.wide tile) 0 rd rn rm))
                (8 (encode/logical-register (.wide tile) 2 rd rn rm))
                (41 (logical-word tile 1 rd rn))
                (42 (logical-word tile 0 rd rn))
                (43 (logical-word tile 2 rd rn))
                (9 (encode/variable-shift (.wide tile) 0 rd rn rm))
                (10 (encode/variable-shift (.wide tile) 1 rd rn rm))
                (11 (encode/variable-shift (.wide tile) 2 rd rn rm))
                (13 (encode/variable-shift (.wide tile) 3 rd rn rm))
                (38 (encode/shift-immediate (.wide tile)
                                            0
                                            rd
                                            rn
                                            (cast i32 (.immediate tile))))
                (39 (encode/shift-immediate (.wide tile)
                                            1
                                            rd
                                            rn
                                            (cast i32 (.immediate tile))))
                (40 (encode/shift-immediate (.wide tile)
                                            2
                                            rd
                                            rn
                                            (cast i32 (.immediate tile))))
                (49 (encode/rotate-immediate (.wide tile) rd rn
                                             (cast i32 (.immediate tile))))
                (48 (encode/extract (.wide tile)
                                    (cast i32 (>> (.immediate tile) 8))
                                    (cast i32 (& (.immediate tile) 255)) rd rn))
                (53 (encode/extend true true 32 rd rn))
                (14 (encode/divide (.wide tile) false rd rn rm))
                (15 (encode/divide (.wide tile) true rd rn rm))
                (_ (if (and (>= (.rule tile) 20) (<= (.rule tile) 33))
                       (encode/conditional-set false rd (- (.rule tile) 20))
                       (Err "unsupported arithmetic tile"))))]
        (match instruction
          (Err [msg] (Err msg))
          (Ok [word]
              (if (and (>= (.rule tile) 20) (<= (.rule tile) 33))
                  (match (comparison-word tile rn rm)
                    (Err [msg] (Err msg))
                    (Ok [compare-word]
                        (do
                          (bytes/append32! (mut output) compare-word)
                          (bytes/append32! (mut output) word)
                          (Ok 8))))
                  (do (bytes/append32! (mut output) word) (Ok 4)))))))))

(defn operand-register-with-locations! [(output (mut code/Buffer))
                                        (graph graph/Graph)
                                        (parts locations/View)
                                        (value i32)
                                        (position i64)
                                        (wide bool)
                                        (scratch i32)]
  (-> (Result i32 (slice u8)))
  (if (< value 0)
      (match (graph/lookup graph value)
        (None [] (Err "missing constant operand"))
        (Some [node]
              (match (code/materialize! (mut output) graph value wide scratch)
                (Err [msg] (Err msg))
                (Ok [_] (Ok scratch)))))
      (match (locations/resolve parts value position)
        (Err [msg] (Err msg))
        (Ok [location]
            (if (locations/constant? location)
                (match (code/materialize! (mut output) graph (cast i32 (.value location)) true scratch)
                  (Err [message] (Err message)) (Ok [_] (Ok scratch)))
            (if (locations/rematerialized? location)
                (match (frame-address/address! (mut (.text output)) scratch
                                               (locations/address-base location) (.value location))
                  (Err [message] (Err message)) (Ok [_] (Ok scratch)))
                (if (!= (.kind location) 0)
                    (Err "required operand is not in register")
                    (Ok (cast i32 (.value location))))))))))

(defn word! [(output (mut (ArrayList u8)))
             (error (ptr (slice u8)))
             (instruction (Result u32 (slice u8)))] (-> void)
  (when (= (load error) "")
    (match instruction
      (Err [message] (store! error message))
      (Ok [word] (bytes/append32! (mut output) word)))))

;;; Low result bits of these depend only on the operands' low bits, so only the
;;; result needs normalizing; the operands' upper bits are never observed.
(defn low-bits-only? [(opcode i32)] (-> bool)
  (or (= opcode 26) (= opcode 27) (= opcode 28) (= opcode 31)
      (= opcode 45) (= opcode 46) (= opcode 47) (= opcode 48)))

;;; Normalize into reserved scratches without altering still-live operands.
;;; Repeated byte/halfword patterns make a 32-bit ROR a narrow rotate.
(defn narrow! [(output (mut (ArrayList u8)))
               (tile select/Tile)
               (opcode i32)
               (ty i32)
               (bits i32)
               (rd i32)
               (rn i32)
               (rm i32)]
  (-> (Result i32 (slice u8)))
  (let [start (len output)
        (mut error) ""
        comparison? (and (>= opcode 14) (<= opcode 23))
        signed-compare? (and (>= opcode 16) (<= opcode 19))
        signed-values?
          (and (or (= opcode 29) (= opcode 30) (= opcode 58) (= opcode 59))
               (types/signed? ty))
        shift? (and (>= opcode 49) (<= opcode 51))
        rotate? (or (= opcode 52) (= opcode 53))]
    (if (low-bits-only? opcode)
        (narrow-low! (mut output) tile ty bits rd rn rm)
    (do
    (word! (mut output)
           (mut error)
           (encode/extend false
                          (or signed-compare? signed-values? (= opcode 51))
                          bits
                          16
                          rn))
    (when (!= (.right tile) 0)
      (word! (mut output)
             (mut error)
             (encode/extend false
                            (or signed-compare? signed-values?)
                            (if shift? (if (= bits 8) 3 4) bits)
                            17
                            rm)))
    (when rotate?
      (when (= bits 8)
        (word! (mut output)
               (mut error)
               (encode/logical-shifted false 1 16 16 16 8)))
      (word! (mut output)
             (mut error)
             (encode/logical-shifted false 1 16 16 16 16)))
    (when (= error "")
      (match (arithmetic! (mut output)
                          tile
                          rd
                          16
                          (if (= (.right tile) 0) (: 0 i32) (: 17 i32)))
        (Err [message] (set! error message))
        (Ok [_] 0)))
    (when (not comparison?)
      (word! (mut output)
             (mut error)
             (encode/extend false (types/signed? ty) bits rd rd)))
    (if (= error "") (Ok (cast i32 (- (len output) start))) (Err error))))))

(defn narrow-low! [(output (mut (ArrayList u8)))
                   (tile select/Tile)
                   (ty i32)
                   (bits i32)
                   (rd i32)
                   (rn i32)
                   (rm i32)]
  (-> (Result i32 (slice u8)))
  (let [start (len output)
        (mut error) ""]
    (match (arithmetic! (mut output) tile rd rn rm)
      (Err [message] (set! error message))
      (Ok [_] 0))
    (unless (masked-within? tile ty bits)
      (word! (mut output)
             (mut error)
             (encode/extend false (types/signed? ty) bits rd rd)))
    (if (= error "") (Ok (cast i32 (- (len output) start))) (Err error))))

;;; A W-form AND with a logical immediate leaves a result no greater than the
;;; immediate. When that mask lies within the value bits of the narrow type
;;; (below the sign bit of a signed one), the result is already its own zero-
;;; and sign-extension and needs no normalizing. The mask is decoded from the
;;; tile's N:immr:imms fields: a 32-bit element is a rotated run of ones.
(defn masked-within? [(tile select/Tile) (ty i32) (bits i32)] (-> bool)
  (let [fields (.immediate tile)
        imms (& fields 63)
        rotation (& (>> fields 6) 63)]
    (and (= (.rule tile) 42) (not (.wide tile)) (= (.right tile) 0)
         (< fields 4096) (< imms 32) (< rotation 32) (>= bits 8) (< bits 32)
         (let [run (- (<< (: 1 u64) (+ imms 1)) 1)
               mask (& (| (>> run rotation) (<< run (- 32 rotation))) 0xFFFFFFFF)]
           (< mask (<< (: 1 u64) (cast u64 (if (types/signed? ty) (- bits 1) bits))))))))

;;; MADD/MSUB: rd = addend +/- multiplicand * multiplier. Matching admits at
;;; most two sources that need a scratch register; a third is a hard error.
(defn multiply-accumulate! [(output (mut code/Buffer))
                            (graph graph/Graph)
                            (parts locations/View)
                            (tile select/Tile)
                            (rd i32)
                            (position i64)] (-> (Result i32 (slice u8)))
  (match (operand-register-with-locations! (mut output) graph parts (.left tile)
                                           position (.wide tile) 16)
    (Err [message] (Err message))
    (Ok [ra]
      (match (operand-register-with-locations! (mut output) graph parts (.right tile)
                                               position (.wide tile) (if (= ra 16) 17 16))
        (Err [message] (Err message))
        (Ok [rn]
          (let [third (cond (and (!= ra 16) (!= rn 16)) (: 16 i32)
                            (and (!= ra 17) (!= rn 17)) (: 17 i32)
                            :else (: -1 i32))]
            (match (operand-register-with-locations! (mut output) graph parts
                                                     (select/multiplier tile)
                                                     position (.wide tile) third)
              (Err [message] (Err message))
              (Ok [rm]
                (if (or (< rd 0) (> rd 30) (< ra 0) (> ra 30) (< rn 0) (> rn 30)
                        (< rm 0) (> rm 30))
                    (Err "invalid multiply-accumulate physical register")
                    (match (if (= (.rule tile) 54)
                               (encode/multiply-add (.wide tile) rd rn rm ra)
                               (encode/multiply-subtract (.wide tile) rd rn rm ra))
                      (Err [message] (Err message))
                      (Ok [word]
                        (bytes/append32! (mut (.text output)) word)
                        (Ok 4))))))))))))

(defn operands-with-locations! [(output (mut code/Buffer))
                                (graph graph/Graph)
                                (parts locations/View)
                                (tile select/Tile)
                                (opcode i32)
                                (rd i32)
                                (position i64)] (-> (Result i32 (slice u8)))
  (if (or (= (.rule tile) 54) (= (.rule tile) 55))
      (multiply-accumulate! (mut output) graph parts tile rd position)
      (operands-selected-with-locations! (mut output) graph parts tile opcode rd position)))

;;; A byte or halfword shift by a literal count is one bitfield move. The
;;; general narrow sequence normalizes the source, reduces the count modulo the
;;; width, shifts and normalizes the result to the type; with a literal count
;;; K (already reduced) that is, for width B:
;;;   SHL: the low B-K source bits moved up by K, extended to the type
;;;        (UBFIZ/SBFIZ #K, #B-K);
;;;   SHR: the field [K, B) zero-extended, nonnegative in every type (UBFX);
;;;   SAR of a signed type: the field [K, B) sign-extended (SBFX);
;;;   K = 0: the source extended to the type.
;;; SAR of an unsigned type has no single form. Returns the instruction, or
;;; None when the tile is not such a shift.
(defn narrow-literal-shift [(graph graph/Graph) (tile select/Tile) (opcode i32)
                            (ty i32) (bits i32) (rd i32) (rn i32)]
  (-> (Option (Result u32 (slice u8))))
  (if (or (< opcode 49) (> opcode 51) (!= (.rule tile) (- opcode 40))
          (>= (.right tile) 0) (not (or (= bits 8) (= bits 16))) (= ty 1))
      (None)
      (match (graph/lookup graph (.right tile))
        (None [] (None))
        (Some [literal]
          (if (not (and (symbols/numeric? literal)
                        (types/integer? (cast i32 (node/type-id literal)))))
              (None)
              (let [count (cast i32 (& (node/constant-bits literal) (cast u64 (- bits 1))))
                    signed? (types/signed? ty)]
                (cond (= count 0)
                        (Some (encode/extend false signed? bits rd rn))
                      (= opcode 49)
                        (Some (encode/word-bitfield signed? (- 32 count) (- (- bits count) 1) rd rn))
                      (= opcode 50)
                        (Some (encode/word-bitfield false count (- bits 1) rd rn))
                      signed?
                        (Some (encode/word-bitfield true count (- bits 1) rd rn))
                      :else (None))))))))

(defn operands-selected-with-locations! [(output (mut code/Buffer))
                                (graph graph/Graph)
                                (parts locations/View)
                                (tile select/Tile)
                                (opcode i32)
                                (rd i32)
                                (position i64)] (-> (Result i32 (slice u8)))
  (match (graph/lookup graph (.left tile))
    (None [] (Err "selected source missing"))
    (Some [source]
          (let [ty (cast i32 (node/type-id source))
                bits (* 8 (types/scalar-size ty 8))
                literal-shift
                  (match (narrow-literal-shift graph tile opcode ty bits 0 0)
                    (Some [_] true)
                    (None [] false))]
            (if literal-shift
            (match (operand-register-with-locations! (mut output) graph parts (.left tile)
                                                     position false 16)
              (Err [message] (Err message))
              (Ok [left]
                (match (narrow-literal-shift graph tile opcode ty bits rd left)
                  (None [] (Err "narrow literal shift lost its form"))
                  (Some [instruction]
                    (match instruction
                      (Err [message] (Err message))
                      (Ok [word]
                        (bytes/append32! (mut (.text output)) word)
                        (Ok 4)))))))
            ; A literal zero source of a full-width register form reads XZR
            ; instead of being materialized into a scratch register.
            (match (if (and (>= bits 32) (zero-register-rule? (.rule tile))
                            ; An immediate comparison reads Rn=31 as SP.
                            (or (< (.rule tile) 20) (!= (.right tile) 0))
                            (zero-literal? graph (.left tile)))
                       (Ok (: 31 i32))
                       (operand-register-with-locations! (mut output)
                                                         graph
                                                         parts
                                                         (.left tile)
                                                         position
                                                         (.wide tile)
                                                         16))
              (Err [message] (Err message))
              (Ok [left]
                  (match (cond (= (.right tile) 0) (Ok (: 0 i32))
                               (and (>= bits 32) (zero-register-rule? (.rule tile))
                                    (zero-literal? graph (.right tile)))
                                 (Ok (: 31 i32))
                               :else
                                 (operand-register-with-locations! (mut output)
                                                                   graph
                                                                   parts
                                                                   (.right tile)
                                                                   position
                                                                   (.wide tile)
                                                                   17))
                    (Err [message] (Err message))
                    (Ok [right]
                        (if (and (< bits 32) (!= (.rule tile) 56))
                            (narrow! (mut (.text output))
                                     tile
                                     opcode
                                     ty
                                     bits
                                     rd
                                     left
                                     right)
                            (arithmetic! (mut (.text output))
                                         tile
                                         rd
                                         left
                                         right)))))))))))

;;; Allocation reserves x16/x17 for materialization, narrow normalization and
;;; cycle resolution. Compose bytes and pending references atomically.
(defn allocated-selected-with-locations! [(output (mut code/Buffer))
                                          (graph graph/Graph)
                                          (parts locations/View)
                                          (reference i32)
                                          (position i64)
                                          (tile select/Tile)
                                          (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut temporary) (code/create allocator)
        (mut error) ""]
    (match (locations/resolve parts reference (+ position 1))
      (Err [message] (set! error message))
      (Ok [destination]
          (if (!= (.kind destination) 0)
              (set! error "result lacks register")
              (match (operands-with-locations! (mut temporary)
                                               graph
                                               parts
                                               tile
                                               (cast i32
                                                     (node/opcode (get (.instructions graph)
                                                                       (cast i64
                                                                             reference))))
                                               (cast i32 (.value destination))
                                               position)
                (Err [message] (set! error message))
                (Ok [_] 0)))))
    (let [written (cast i32 (len (.text temporary)))]
      (when (and (= error "") (not (code/append! (mut output) temporary)))
        (set! error "invalid temporary code references"))
      (code/release! (mut temporary))
      (if (= error "") (Ok written) (Err error)))))

(defn allocated-arithmetic-with-locations! [(output (mut code/Buffer))
                                            (graph graph/Graph)
                                            (parts locations/View)
                                            (reference i32)
                                            (position i64)
                                            (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (select/select graph reference)
    (Err [message] (Err message))
    (Ok [tile]
        (allocated-selected-with-locations! (mut output)
                                            graph
                                            parts
                                            reference
                                            position
                                            tile
                                            allocator))))

;;; Emit two checked words atomically, so invalid operands leave output intact.
(defn pair! [(output (mut (ArrayList u8)))
             (first (Result u32 (slice u8)))
             (second (Result u32 (slice u8)))]
  (-> (Result i32 (slice u8)))
  (match first
    (Err [msg] (Err msg))
    (Ok [a]
        (match second
          (Err [msg] (Err msg))
          (Ok [b]
              (do
                (bytes/append32! (mut output) a)
                (bytes/append32! (mut output) b)
                (Ok 8)))))))

;;; x16/x17 are reserved scratch registers. With two literal operands both are
;;; occupied, so an independent destination holds the quotient. Never overwrite
;;; an original dividend/divisor before the multiply-subtract consumes it.
;;; Persistent power-of-two rules use a sign-derived bias for truncation toward
;;; zero. x16/x17 are reserved temporaries. Copy a source held in the chosen
;;; scratch before clobbering it; allocated live input registers remain intact.
(defn power-division! [(output (mut (ArrayList u8)))
                       (tile select/Tile)
                       (rd i32)
                       (rn i32)] (-> (Result i32 (slice u8)))
  (let [width (if (.wide tile) (: 64 i32) (: 32 i32))
        shift (cast i32 (.immediate tile))
        signed? (or (= (.rule tile) 45) (= (.rule tile) 47))
        remainder? (>= (.rule tile) 46)
        start (len output)
        (mut error) ""]
    (if (or (>= (.immediate tile) (cast u64 width))
            (and signed? (>= shift (- width 1))))
        (Err "power-of-two division exponent exceeds type range")
        (do
          (if (= shift 0)
              (word! (mut output)
                     (mut error)
                     (encode/logical-register (.wide tile)
                                              1
                                              rd
                                              31
                                              (if remainder? 31 rn)))
              (if (not signed?)
                  (if remainder?
                      (match (encode/logical-mask (.wide tile)
                                                  (- (<< (: 1 u64)
                                                         (cast u64 shift))
                                                     1))
                        (None []
                              (set! error
                                    "power-of-two remainder mask is invalid"))
                        (Some [fields]
                              (word! (mut output)
                                     (mut error)
                                     (encode/logical-immediate (.wide tile)
                                                               0
                                                               rd
                                                               rn
                                                               fields))))
                      (word! (mut output)
                             (mut error)
                             (encode/shift-immediate (.wide tile) 1 rd rn shift)))
                  (if (and (= shift 1) (not remainder?))
                      ; Halving: the rounding bias is the sign bit itself.
                      (do
                        (word! (mut output)
                               (mut error)
                               (encode/add-sub-shifted (.wide tile) false rd rn rn 1
                                                       (- width 1)))
                        (word! (mut output)
                               (mut error)
                               (encode/shift-immediate (.wide tile) 2 rd rd 1)))
                      ; The scratch holds the sign mask; its top `shift` bits
                      ; shifted down are the bias 2^shift-1 of a negative
                      ; dividend, added and (for a remainder) subtracted by
                      ; shifted-register forms.
                      (let [scratch (if (= rd 16) (: 17 i32) (: 16 i32))
                            source (if (= rn scratch) rd rn)]
                        (when (= rn scratch)
                          (word! (mut output)
                                 (mut error)
                                 (encode/logical-register (.wide tile) 1 rd 31 rn)))
                        (word! (mut output)
                               (mut error)
                               (encode/shift-immediate (.wide tile)
                                                       2
                                                       scratch
                                                       source
                                                       (- width 1)))
                        (word! (mut output)
                               (mut error)
                               (encode/add-sub-shifted (.wide tile) false rd source scratch 1
                                                       (- width shift)))
                        (if remainder?
                            (do
                              (match (encode/logical-mask (.wide tile)
                                                          (- (<< (: 1 u64)
                                                                 (cast u64 shift))
                                                             1))
                                (None []
                                      (set! error
                                            "power-of-two remainder mask is invalid"))
                                (Some [fields]
                                      (word! (mut output)
                                             (mut error)
                                             (encode/logical-immediate (.wide tile)
                                                                       0
                                                                       rd
                                                                       rd
                                                                       fields))))
                              (word! (mut output)
                                     (mut error)
                                     (encode/add-sub-shifted (.wide tile) true rd rd scratch 1
                                                             (- width shift))))
                            (word! (mut output)
                                   (mut error)
                                   (encode/shift-immediate (.wide tile)
                                                           2
                                                           rd
                                                           rd
                                                           shift)))))))
          (if (= error "") (Ok (cast i32 (- (len output) start))) (Err error))))))

(defn arithmetic! [(output (mut (ArrayList u8)))
                   (tile select/Tile)
                   (rd i32)
                   (rn i32)
                   (rm i32)] (-> (Result i32 (slice u8)))
  (if (or (< rd 0)
          (> rd 30)
          (not (source-register? (.rule tile) rn))
          (and (!= (.right tile) 0) (not (source-register? (.rule tile) rm))))
      (Err "invalid arithmetic physical register")
      (if (and (>= (.rule tile) 44) (<= (.rule tile) 47))
          (power-division! (mut output) tile rd rn)
          (if (and (>= (.rule tile) 34) (<= (.rule tile) 37))
              (pair! (mut output)
                     (encode/add-sub (.wide tile) true true 31 rn rm)
                     (encode/conditional-select (.wide tile)
                                                rd
                                                rn
                                                rm
                                                (match (.rule tile)
                                                  (34 9)
                                                  (35 13)
                                                  (36 2)
                                                  (_ 10))))
              (if (= (.rule tile) 12)
                  (let [scratch (if (= rn 17) (: 16 i32) (: 17 i32))]
                    (pair! (mut output)
                           (encode/add-sub (.wide tile)
                                           true
                                           false
                                           scratch
                                           31
                                           rm)
                           (encode/variable-shift (.wide tile) 3 rd rn scratch)))
                  (if (or (= (.rule tile) 16) (= (.rule tile) 17))
                      (let [scratch
                              (if (and (!= rn 16) (!= rm 16))
                                  (: 16 i32)
                                  (if (and (!= rn 17) (!= rm 17))
                                      (: 17 i32)
                                      (if (and (!= rd rn) (!= rd rm))
                                          rd
                                          (: -1 i32))))]
                        (if (< scratch 0)
                            (Err "remainder requires independent quotient register")
                            (pair! (mut output)
                                   (encode/divide (.wide tile)
                                                  (= (.rule tile) 17)
                                                  scratch
                                                  rn
                                                  rm)
                                   (encode/multiply-subtract (.wide tile)
                                                             rd
                                                             scratch
                                                             rm
                                                             rn))))
                      (single! (mut output) tile rd rn rm)))))))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn operand-register! [(output (mut code/Buffer))
                         (graph graph/Graph)
                         (parts (ArrayList allocation/Part))
                         (value i32)
                         (position i64)
                         (wide bool)
                         (scratch i32)] (-> (Result i32 (slice u8)))
  (operand-register-with-locations! (mut output)
                                    graph
                                    (locations/linear-view parts)
                                    value
                                    position
                                    wide
                                    scratch))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn operands! [(output (mut code/Buffer))
                 (graph graph/Graph)
                 (parts (ArrayList allocation/Part))
                 (tile select/Tile)
                 (opcode i32)
                 (rd i32)
                 (position i64)] (-> (Result i32 (slice u8)))
  (operands-with-locations! (mut output)
                            graph
                            (locations/linear-view parts)
                            tile
                            opcode
                            rd
                            position))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn allocated-selected! [(output (mut code/Buffer))
                           (graph graph/Graph)
                           (parts (ArrayList allocation/Part))
                           (reference i32)
                           (position i64)
                           (tile select/Tile)
                           (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (allocated-selected-with-locations! (mut output)
                                      graph
                                      (locations/linear-view parts)
                                      reference
                                      position
                                      tile
                                      allocator))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn allocated-arithmetic! [(output (mut code/Buffer))
                             (graph graph/Graph)
                             (parts (ArrayList allocation/Part))
                             (reference i32)
                             (position i64)
                             (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (allocated-arithmetic-with-locations! (mut output)
                                        graph
                                        (locations/linear-view parts)
                                        reference
                                        position
                                        allocator))
