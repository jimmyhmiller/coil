;;; A memcmp of a fixed count of 0..16 bytes as straight-line code, in place
;;; of the runtime call the ABI lowering has already set up: the two ranges
;;; are addressed by x0 and x1 and the result is left in w0.
;;;
;;; Each range is read as one or two chunks of 8, 4, 2 or 1 bytes: the first at
;;; offset zero, the second ending at the last byte and overlapping the first
;;; when the count is not twice the chunk size. Every byte of both ranges is
;;; read, none outside them, and no alignment is assumed; memcmp's contract
;;; makes all count bytes of both ranges accessible. A chunk, or a pair of 4-
;;; or 2-byte chunks packed into one register, is byte-reversed so that
;;; unsigned register order is the lexicographic order of its bytes. When the
;;; first chunks differ their order decides; otherwise the overlapped bytes of
;;; the second chunks are equal and the remaining bytes decide. The result is
;;; -1, 0 or 1 with memcmp's sign.
;;;
;;; x2..x5 and NZCV are written. They are caller-saved and dead at the call,
;;; as is x2's argument value.
(module stogir.a64.block-compare)
(import "stogir.a64.encode" :as e)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn maximum [] (-> i64) 16)

(defn inline? [(count i64)] (-> bool)
  (and (>= count 0) (<= count (maximum))))

(defn word! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (instruction (Result u32 (slice u8)))] (-> void)
  (when (= error "")
    (match instruction
      (Err [message] (set! error message))
      (Ok [word] (bytes/append32! (mut out) word)))))

(defn load! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (size i32)
             (rt i32)
             (base i32)
             (offset i64)] (-> void)
  (word! (mut out) (mut error) (e/unscaled-load-store true false false false size rt base offset)))

;;; The bytes of one range in lexicographic register order: for a count of at
;;; most eight, all of them in register FIRST; above that, the first eight in
;;; FIRST and the last eight in SECOND.
(defn gather! [(out (mut (ArrayList u8)))
               (error (mut (slice u8)))
               (base i32)
               (count i64)
               (first i32)
               (second i32)] (-> void)
  (let [chunk (if (>= count 8) (: 8 i32) (if (>= count 4) (: 4 i32) (if (>= count 2) (: 2 i32) 1)))
        two? (> count (cast i64 chunk))]
    (load! (mut out) (mut error) chunk first base 0)
    (when two?
      (load! (mut out) (mut error) chunk second base (- count (cast i64 chunk))))
    (cond (= chunk 8)
            (do
              (word! (mut out) (mut error) (e/unary-bits true 3 first first))
              (when two?
                (word! (mut out) (mut error) (e/unary-bits true 3 second second))))
          (= chunk 4)
            (if two?
                ; first chunk in the low word: reversed, its bytes come first
                (do
                  (word! (mut out) (mut error) (e/logical-shifted true 1 first first second 32))
                  (word! (mut out) (mut error) (e/unary-bits true 3 first first)))
                (word! (mut out) (mut error) (e/unary-bits false 2 first first)))
          (= chunk 2)
            (do
              (when two?
                (word! (mut out) (mut error) (e/logical-shifted false 1 first first second 16)))
              (word! (mut out) (mut error) (e/unary-bits false 2 first first)))
          :else 0)))

(defn emit! [(out (mut (ArrayList u8))) (count i64)] (-> (Result i32 (slice u8)))
  (if (not (inline? count))
      (Err "block compare count outside the inline range")
      (let [before (len out)
            (mut error) ""
            wide (>= count 5)]
        (if (= count 0)
            (word! (mut out) (mut error) (e/move-wide false 2 0 0 0))
            (do
              (gather! (mut out) (mut error) 0 count 2 3)
              (gather! (mut out) (mut error) 1 count 4 5)
              (word! (mut out) (mut error) (e/add-sub wide true true 31 2 4))
              (when (> count 8)
                ; Differing first chunks decide; equal ones leave it to the
                ; second chunks, which then replace them in the comparison.
                (word! (mut out) (mut error) (e/conditional-select true 2 2 3 1))
                (word! (mut out) (mut error) (e/conditional-select true 4 4 5 1))
                (word! (mut out) (mut error) (e/add-sub true true true 31 2 4)))
              ; 1 when different, negated when the first range is lower
              (word! (mut out) (mut error) (e/conditional-set false 0 1))
              (word! (mut out) (mut error) (e/conditional-negate false 0 0 3))))
        (if (= error "") (Ok (cast i32 (- (len out) before))) (Err error)))))
