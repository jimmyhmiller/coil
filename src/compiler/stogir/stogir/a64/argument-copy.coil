;;; Bounded native copying for ARGVAL. x16=source, x17=private destination;
;;; x30 and v31 are temporary. No allocatable register or runtime call is used.
(module stogir.a64.argument-copy)
(import "stogir.a64.encode" :as e)
(import "stogir.a64.constants" :as constants)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn word! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (instruction (Result u32 (slice u8)))] (-> void)
  (when (= error "")
    (match instruction
      (Err [message] (set! error message))
      (Ok [word] (bytes/append32! (mut out) word)))))

(defn transfer! [(out (mut (ArrayList u8)))
                 (error (mut (slice u8)))
                 (size i32)
                 (offset i64)] (-> void)
  (if (>= size 4)
      (do
        (word! (mut out)
               (mut error)
               (e/floating-load-store true size 31 16 offset))
        (word! (mut out)
               (mut error)
               (e/floating-load-store false size 31 17 offset)))
      (do
        (word! (mut out) (mut error) (e/load-store true size 30 16 offset))
        (word! (mut out) (mut error) (e/load-store false size 30 17 offset)))))

(defn copy! [(out (mut (ArrayList u8))) (size i64)]
  (-> (Result i32 (slice u8)))
  (if (or (< size 0) (> size 0x7FFFFFFF))
      (Err "invalid ARGVAL copy size")
      (let [before (len out)
            (mut error) ""
            (mut offset) (: 0 i64)
            (mut remaining) size]
        (when (> size 64)
          (match (constants/emit! (mut out) true 30 (cast u64 (/ size 8)))
            (Err [message] (set! error message))
            (Ok [_] 0))
          (let [header (len out)]
            (transfer! (mut out) (mut error) 8 0)
            (word! (mut out)
                   (mut error)
                   (e/add-sub-immediate true false false 16 16 8))
            (word! (mut out)
                   (mut error)
                   (e/add-sub-immediate true false false 17 17 8))
            (word! (mut out)
                   (mut error)
                   (e/add-sub-immediate true true true 30 30 1))
            (word! (mut out)
                   (mut error)
                   (e/conditional-branch 1 (- header (len out)))))
          (set! remaining (% size 8)))
        (while (> remaining 0)
          (let [width
                  (if (>= remaining 8)
                      (: 8 i32)
                      (if (>= remaining 4)
                          (: 4 i32)
                          (if (>= remaining 2) (: 2 i32) (: 1 i32))))]
            (transfer! (mut out) (mut error) width offset)
            (set! remaining (- remaining (cast i64 width)))
            (set! offset (+ offset (cast i64 width)))))
        (if (= error "") (Ok (cast i32 (- (len out) before))) (Err error)))))
