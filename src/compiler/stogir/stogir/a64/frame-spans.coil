;;; Where a function will need its frame, estimated before allocation.
;;;
;;; Shrink-wrapping (a64.shrink-wrap) leaves two kinds of block without the
;;; frame: the entry region, closed under predecessors, and the blocks after
;;; the last frame use that the entry region reaches without one, closed under
;;; successors. Every other block runs with the frame built. Which blocks those
;;; are depends on the allocation, but calls decide most of it, and they are
;;; known now: a block needs the frame when it calls, uses a frame operation
;;; or reads a stack parameter, and when the function has addressable frame
;;; storage a block that accesses memory cannot follow the frame's release.
;;;
;;; estimate returns, as framed, the maximal runs, adjacent in the schedule, of
;;; blocks outside both frameless regions under that estimate, as ascending
;;; half-open allocation position ranges. The allocator cuts values that cross
;;; calls at these spans (stogir.allocation-spans), so the frameless regions
;;; hold them in call-clobbered registers. Both lists are empty when the entry
;;; block itself needs the frame, no block does, no RETURN lies in a frameless
;;; region (there is then nothing to keep frameless), or some path runs framed
;;; from the entry region to a frameless block without a frame use. A wrong estimate costs transfers, never correctness:
;;; allocation and shrink-wrapping decide the real regions afterwards.
;;;
;;; last lists the framed blocks none of whose successors can reach another
;;; frame use: once such a block is entered, no later call follows it. A value
;;; that only dies there (an argument of its call, say) need not leave its
;;; call-clobbered register for it.
(module stogir.a64.frame-spans)
(export Estimate estimate release!)
(import "stogir.fill" :as fill)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.adjacency" :as adj)
(import "stogir.pipeline" :as pipeline)
(import "stogir.interval" :as range)
(import "stogir.a64.constraints" :as constraints)
(import "stogir.a64.shrink-wrap" :as shrink)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])

;;; Block states, by block start reference.
(def NEEDS (: 1 u8))   ; needs the frame
(def BEFORE (: 2 u8))  ; entry region
(def AFTER (: 4 u8))   ; no frame use on any path onward
(def REACHED (: 8 u8)) ; AFTER, and reached from the entry region without one
(def MEMORY (: 16 u8)) ; accesses memory
(def PASSING (: 32 u8)) ; framed, with a way to a frameless block past no frame use

(defn has? [(states (ArrayList u8)) (block i32) (flag u8)] (-> bool)
  (!= (& (get states (cast i64 block)) flag) 0))

(defn drop! [(states (mut (ArrayList u8))) (block i32) (flag u8)] (-> void)
  (set! (mut states) (cast i64 block) (& (get states (cast i64 block)) (^ flag (: 255 u8)))))

(defn raise! [(states (mut (ArrayList u8))) (block i32) (flag u8)] (-> void)
  (set! (mut states) (cast i64 block) (| (get states (cast i64 block)) flag)))

(defstruct Estimate [(framed (ArrayList range/Range)) (last (ArrayList range/Range))])

(defn release! [(estimate (mut Estimate))] (-> void)
  (free! (mut (.framed estimate)))
  (free! (mut (.last estimate))))

(defn estimate [(graph g/Graph)
                (prepared pipeline/Prepared)
                (requirements (ArrayList constraints/Value))
                (allocator (dyn Allocator))]
  (-> Estimate)
  (let [(mut result) (ArrayList::new [range/Range] allocator)
        (mut tails) (ArrayList::new [range/Range] allocator)
        scheduled (.schedule prepared)
        order (.order prepared)
        (mut states) (ArrayList::new [u8] allocator)
        (mut addressable) false
        (mut returns) false
        (mut any) false]
    (when (> (len order) 1)
      (fill/append! (mut states) (len (.instructions graph)) (: 0 u8))
      (for block order
        (let [span (get (.ranges scheduled) (cast i64 block))
              (mut needs) false
              (mut memory) false]
          (for [k 0 (.count span)]
            (let [reference (get (.nodes scheduled) (+ (.offset span) k))
                  opcode (cast i32 (n/opcode (get (.instructions graph) (cast i64 reference))))]
              (when (or (shrink/frame-opcode? opcode)
                        (and (= opcode 71)
                             (let [kind (.kind (.parameter (get requirements (cast i64 reference))))]
                               (not (or (= kind 0) (= kind 2))))))
                (set! needs true))
              (when (shrink/addressable-opcode? opcode) (set! addressable true))
              (when (shrink/memory-opcode? opcode) (set! memory true))))
          (if needs
              (do (set! (mut states) (cast i64 block) NEEDS) (set! any true))
              (set! (mut states) (cast i64 block)
                    (| BEFORE AFTER (if memory MEMORY (: 0 u8)))))))
      (when addressable
        (for block order
          (when (has? states block MEMORY) (drop! (mut states) block AFTER)))))
    (when (and any (not (has? states (get order 0) NEEDS)))
      (let [(mut successors) (adj/build (.blocks prepared) false allocator)
            (mut work) (ArrayList::new [i32] allocator)
            edges (.edges (.blocks prepared))]
        ; Entry region: a block leaves it when any predecessor is outside.
        (for block order
          (unless (has? states block BEFORE) (push! (mut work) block)))
        (while (> (len work) 0)
          (let [block (get work (- (len work) 1))
                out (get (.ranges successors) (cast i64 block))]
            (pop! (mut work))
            (for [k 0 (.count out)]
              (let [target (.to (get edges (get (.edges successors) (+ (.offset out) k))))]
                (when (has? states target BEFORE)
                  (drop! (mut states) target BEFORE)
                  (push! (mut work) target))))))
        ; After region: a block leaves it when any successor is outside. Each
        ; sweep in reverse order settles all forward edges; a back edge into
        ; a block that left later needs one more.
        (let [(mut changed) true]
          (while changed
            (set! changed false)
            (let [(mut i) (- (len order) 1)]
              (while (>= i 0)
                (let [block (get order i)
                      out (get (.ranges successors) (cast i64 block))]
                  (when (has? states block AFTER)
                    (for [k 0 (.count out)]
                      (let [target (.to (get edges (get (.edges successors) (+ (.offset out) k))))]
                        (unless (has? states target AFTER)
                          (when (has? states block AFTER)
                            (drop! (mut states) block AFTER)
                            (set! changed true)))))))
                (set! i (- i 1))))))
        ; Reached: after-region blocks entered from the entry region, onward.
        (for block order
          (when (has? states block BEFORE) (push! (mut work) block)))
        (while (> (len work) 0)
          (let [block (get work (- (len work) 1))
                out (get (.ranges successors) (cast i64 block))]
            (pop! (mut work))
            (for [k 0 (.count out)]
              (let [target (.to (get edges (get (.edges successors) (+ (.offset out) k))))]
                (when (and (has? states target AFTER)
                           (not (has? states target BEFORE))
                           (not (has? states target REACHED)))
                  (raise! (mut states) target REACHED)
                  (push! (mut work) target))))))
        ; Nothing is gained unless some RETURN runs without the frame:
        ; shrink-wrapping then builds it at entry, and a cut would only add
        ; transfers.
        (for block order
          (when (or (has? states block BEFORE) (has? states block REACHED))
            (let [span (get (.ranges scheduled) (cast i64 block))]
              (when (and (> (.count span) 0)
                         (= (n/opcode (get (.instructions graph)
                                           (cast i64 (get (.nodes scheduled)
                                                          (- (+ (.offset span) (.count span)) 1)))))
                            120))
                (set! returns true)))))
        ; A framed block that needs no frame itself, entered from the entry
        ; region, and from which a frameless block is reached without passing a
        ; frame use, lies on a path that runs framed yet makes no call. Values
        ; cut there would move to preserved registers and back for nothing, so
        ; such a function is left uncut. PASSING marks framed blocks with a
        ; frame-use-free way out; sweeps in reverse order settle forward edges.
        (let [(mut changed) true]
          (while changed
            (set! changed false)
            (let [(mut i) (- (len order) 1)]
              (while (>= i 0)
                (let [block (get order i)
                      out (get (.ranges successors) (cast i64 block))]
                  (when (= (& (get states (cast i64 block)) (| NEEDS BEFORE REACHED PASSING)) 0)
                    (for [k 0 (.count out)]
                      (let [target (.to (get edges (get (.edges successors) (+ (.offset out) k))))]
                        (when (and (or (has? states target REACHED) (has? states target PASSING))
                                   (not (has? states block PASSING)))
                          (raise! (mut states) block PASSING)
                          (set! changed true))))))
                (set! i (- i 1))))))
        (for block order
          (when (has? states block BEFORE)
            (let [out (get (.ranges successors) (cast i64 block))]
              (for [k 0 (.count out)]
                (when (has? states (.to (get edges (get (.edges successors) (+ (.offset out) k)))) PASSING)
                  (set! returns false))))))
        ; The schedule lays blocks out in this order, so framed blocks arrive
        ; by ascending position and extend the last span or follow it.
        (when returns
          (for block order
            (unless (or (has? states block BEFORE) (has? states block REACHED))
              (let [span (get (.ranges scheduled) (cast i64 block))
                    start (* (.offset span) 2)
                    end (* (+ (.offset span) (.count span)) 2)
                    last (- (len result) 1)]
                (when (> (.count span) 0)
                  (if (and (>= last 0) (>= (.end (get result last)) start))
                      (range/add! (mut result) start end)
                      (push! (mut result) (range/Range :start start :end end)))
                  (let [out (get (.ranges successors) (cast i64 block))
                        (mut final) true]
                    (for [k 0 (.count out)]
                      (unless (has? states (.to (get edges (get (.edges successors) (+ (.offset out) k)))) AFTER)
                        (set! final false)))
                    ; One entry per block, ascending as the schedule is.
                    (when (and final
                               (or (= (len tails) 0)
                                   (<= (.end (get tails (- (len tails) 1))) start)))
                      (push! (mut tails) (range/Range :start start :end end)))))))))
        (adj/release! (mut successors))
        (free! (mut work))))
    (free! (mut states))
    (Estimate :framed result :last tails)))
