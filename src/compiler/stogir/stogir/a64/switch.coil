;;; Integer/range dispatch; edge copies run only in terminal stubs.
(module stogir.a64.switch)
(import "stogir.switch" :as switch)
(import "stogir.text-data" :as text-data)
(import "stogir.a64.code" :as code)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.emit" :as emit)
(import "stogir.a64.constants" :as constants)
(import "stogir.a64.fixups" :as fixups)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn branch! [(output (mut code/Buffer))
               (branches (mut (ArrayList fixups/Branch)))
               (target i32)
               (condition i32)] (-> void)
  (push! (mut branches)
         (fixups/Branch
           :offset (len (.text output))
           :label target
           :condition condition
           :link false))
  (bytes/append32! (mut (.text output)) 0))

;;; x16 holds the normalized order key throughout dispatch, x17 is scratch.
;;; A W-form comparison reads only the low word of reg; its keys fit 32 bits.
(defn compare-in! [(output (mut code/Buffer)) (error (mut (slice u8))) (wide bool)
                   (reg i32) (key u64)]
  (-> void)
  (match (encode/add-sub-immediate wide true true 31 reg (cast i64 key))
    (Ok [word] (emit/word! (mut (.text output)) (mut error) (Ok word)))
    (Err [_]
         (match (constants/emit! (mut (.text output)) wide 17 key)
           (Err [message] (set! error message))
           (Ok [_] 0))
         (emit/word! (mut (.text output))
                     (mut error)
                     (encode/add-sub wide true true 31 reg 17)))))

;;; Half-open case interval [begin,end); recursion depth is O(log n).
(defn tree! [(output (mut code/Buffer))
             (wide bool)
             (reg i32)
             (dispatch switch/Dispatch)
             (stubs (ArrayList i32))
             (fallback i32)
             (begin i64)
             (end i64)
             (labels (mut (ArrayList i64)))
             (branches (mut (ArrayList fixups/Branch)))
             (error (mut (slice u8)))] (-> void)
  (when (= error "")
    (if (= begin end)
        (branch! (mut output) (mut branches) fallback -1)
        (let [middle (+ begin (/ (- end begin) 2))
              item (get (.cases dispatch) middle)
              left-label (if (= begin middle) fallback (cast i32 (len labels)))]
          (when (!= begin middle) (push! (mut labels) -1))
          (compare-in! (mut output) (mut error) wide reg (.low item))
          (if (= (.low item) (.high item))
              (do
                (branch! (mut output) (mut branches) (get stubs middle) 0)
                (when (!= begin middle)
                  (branch! (mut output) (mut branches) left-label 3)))
              (do
                (branch! (mut output) (mut branches) left-label 3)
                (compare-in! (mut output) (mut error) wide reg (.high item))
                (branch! (mut output) (mut branches) (get stubs middle) 9)))
          (tree! (mut output)
                 wide
                 reg
                 dispatch
                 stubs
                 fallback
                 (+ middle 1)
                 end
                 (mut labels)
                 (mut branches)
                 (mut error))
          (when (!= begin middle)
            (set! (mut labels) (cast i64 left-label) (len (.text output)))
            (tree! (mut output)
                   wide
                   reg
                   dispatch
                   stubs
                   fallback
                   begin
                   middle
                   (mut labels)
                   (mut branches)
                   (mut error)))))))

;;; Requires sorted, disjoint cases from switch/collect.
;;; Match the pinned upstream density rule: >2 singleton cases, span<count*8.
;;; Return zero for comparisons; arithmetic never wraps at full-width limits.
(defn table-length [(dispatch switch/Dispatch)] (-> i64)
  (let [count (len (.cases dispatch))
        (mut singleton?) true]
    (for item (.cases dispatch)
      (when (!= (.low item) (.high item)) (set! singleton? false)))
    (if (or (not singleton?) (<= count 2) (> count 1152921504606846975))
        0
        (let [first (.low (get (.cases dispatch) 0))
              last (.high (get (.cases dispatch) (- count 1)))]
          (if (or (< last first) (>= (- last first) (* (cast u64 count) 8)))
              0
              (cast i64 (+ (- last first) 1)))))))

;;; x16 = reg - base, in the key's width: a word key leaves its difference
;;; modulo 2^32 zero-extended in x16, which later X forms may read whole.
(defn subtract-base! [(output (mut code/Buffer)) (error (mut (slice u8))) (wide bool)
                      (reg i32) (base u64)]
  (-> void)
  (match (encode/add-sub-immediate wide true false 16 reg (cast i64 base))
    (Ok [word] (emit/word! (mut (.text output)) (mut error) (Ok word)))
    (Err [_]
         (match (constants/emit! (mut (.text output)) wide 17 base)
           (Err [message] (set! error message))
           (Ok [_] 0))
         (emit/word! (mut (.text output))
                     (mut error)
                     (encode/add-sub wide true false 16 reg 17)))))

;;; The inline table holds signed displacements relative to its first byte.
;;; ADR is adjacent, so its displacement is always 16, independently of size.
;;; A word key that starts at zero is compared and scaled as the low word of
;;; REG; otherwise the subtraction has left the whole index in x16.
(defn table! [(output (mut code/Buffer))
              (wide bool)
              (reg i32)
              (dispatch switch/Dispatch)
              (stubs (ArrayList i32))
              (fallback i32)
              (length i64)
              (branches (mut (ArrayList fixups/Branch)))
              (relatives (mut (ArrayList fixups/Relative)))
              (error (mut (slice u8)))] (-> void)
  (let [first (.low (get (.cases dispatch) 0))
        index (if (= first 0) reg 16)
        word-index? (and (not wide) (= first 0))]
    (when (!= first 0) (subtract-base! (mut output) (mut error) wide reg first))
    (compare-in! (mut output) (mut error) (not word-index?) index (cast u64 (- length 1)))
    (branch! (mut output) (mut branches) fallback 8)
    (let [base (+ (len (.text output)) 16)
          (mut slot) (: 0 i64)
          (mut case-index) (: 0 i64)]
      (emit/word! (mut (.text output))
                  (mut error)
                  (encode/address-relative 17 16))
      (emit/word! (mut (.text output))
                  (mut error)
                  (if word-index?
                      (encode/load-signed-word-extended 16 17 index)
                      (encode/load-signed-word-indexed 16 17 index)))
      (emit/word! (mut (.text output))
                  (mut error)
                  (encode/add-sub true false false 16 17 16))
      (emit/word! (mut (.text output)) (mut error) (encode/branch-register 16))
      (while (< slot length)
        (let [key (+ first (cast u64 slot))
              hit?
                (and (< case-index (len (.cases dispatch)))
                     (= key (.low (get (.cases dispatch) case-index))))
              target (if hit? (get stubs case-index) fallback)]
          (push! (mut relatives)
                 (fixups/Relative
                   :offset (len (.text output))
                   :base base
                   :label target))
          (bytes/append32! (mut (.text output)) 0)
          (when hit? (set! case-index (+ case-index 1))))
        (set! slot (+ slot 1)))
      (push! (mut (.text-data output))
             (text-data/Range
               :offset base
               :length (* length 4)
               :kind 4)))))

(defn singletons? [(dispatch switch/Dispatch)] (-> bool)
  (let [(mut all) true]
    (for item (.cases dispatch)
      (when (!= (.low item) (.high item)) (set! all false)))
    all))

;;; Up to three singleton cases: one compare and B.EQ per case, then the
;;; fallback branch, with no tree-internal labels or extra jumps.
(defn linear! [(output (mut code/Buffer))
               (wide bool)
               (reg i32)
               (dispatch switch/Dispatch)
               (stubs (ArrayList i32))
               (fallback i32)
               (branches (mut (ArrayList fixups/Branch)))
               (error (mut (slice u8)))] (-> void)
  (for [i 0 (len (.cases dispatch))]
    (when (= error "")
      (compare-in! (mut output) (mut error) wide reg (.low (get (.cases dispatch) i)))
      (branch! (mut output) (mut branches) (get stubs i) 0)))
  (when (= error "") (branch! (mut output) (mut branches) fallback -1)))

;;; Cases that share one code address, as bits of the key relative to a base.
(defstruct Group [(destination i32) (stub i32) (mask u64) (count i64)])

;;; Singleton cases within one 64-value window that reach at most three code
;;; addresses: one bounds check, then a mask test per address. The thresholds
;;; are LLVM's (three cases for one address, five for two, six for three).
;;; A single address covering its whole window needs the bounds check only.
;;; destinations parallels the cases; next is the address that follows the
;;; dispatch, or zero. Returns false, emitting nothing, when the shape does
;;; not apply. A word key is bounds-checked in its own width; the variable
;;; shift reads only the low six bits of the key register.
(defn bit-tests! [(output (mut code/Buffer))
                  (wide bool)
                  (reg i32)
                  (dispatch switch/Dispatch)
                  (stubs (ArrayList i32))
                  (destinations (ArrayList i32))
                  (fallback i32)
                  (next i32)
                  (branches (mut (ArrayList fixups/Branch)))
                  (error (mut (slice u8)))] (-> bool)
  (let [count (len (.cases dispatch))
        empty (Group :destination 0 :stub 0 :mask 0 :count 0)
        (mut groups) [empty empty empty]
        (mut used) (: 0 i64)
        (mut fits) (and (>= count 2) (singletons? dispatch))]
    (when fits
      (let [first (.low (get (.cases dispatch) 0))
            last (.low (get (.cases dispatch) (- count 1)))
            base (if (< last 64) (: 0 u64) first)]
        (when (>= (- last first) 64) (set! fits false))
        (for [i 0 count]
          (when fits
            (let [destination (get destinations i)
                  bit (<< (: 1 u64) (- (.low (get (.cases dispatch) i)) base))
                  (mut slot) (: 0 i64)]
              (while (and (< slot used) (!= (.destination (get groups slot)) destination))
                (set! slot (+ slot 1)))
              (cond (< slot used)
                      (let [group (get groups slot)]
                        (set! (mut groups) slot
                              (Group :destination destination
                                     :stub (.stub group)
                                     :mask (| (.mask group) bit)
                                     :count (+ (.count group) 1))))
                    (< used 3)
                      (do (set! (mut groups) used
                                (Group :destination destination
                                       :stub (get stubs i)
                                       :mask bit
                                       :count 1))
                          (set! used (+ used 1)))
                    :else (set! fits false)))))
        (let [whole (and (= used 1) (= (cast u64 count) (+ (- last first) 1)))]
          (unless (or whole
                      (and (= used 1) (>= count 3))
                      (and (= used 2) (>= count 5))
                      (and (= used 3) (>= count 6)))
            (set! fits false))
          (when fits
            (let [origin (if whole first base)
                  key (if (= origin 0) reg 16)]
              (when (!= origin 0) (subtract-base! (mut output) (mut error) wide reg origin))
              (compare-in! (mut output) (mut error) (or wide (!= origin 0)) key (- last origin))
              (if whole
                  (if (= (.destination (get groups 0)) next)
                      (branch! (mut output) (mut branches) fallback 8)
                      (do (branch! (mut output) (mut branches) (.stub (get groups 0)) 9)
                          (branch! (mut output) (mut branches) fallback -1)))
                  (do
                    (branch! (mut output) (mut branches) fallback 8)
                    (match (constants/emit! (mut (.text output)) true 17 1)
                      (Err [message] (set! error message))
                      (Ok [_] 0))
                    (emit/word! (mut (.text output)) (mut error)
                                (encode/variable-shift true 0 17 17 key))
                    ; Most cases first. x16 is free once the bit is in x17.
                    (for [round 0 used]
                      (let [(mut best) (: 0 i64)]
                        (for [slot 0 used]
                          (when (> (.count (get groups slot)) (.count (get groups best)))
                            (set! best slot)))
                        (let [group (get groups best)]
                          (match (encode/logical-mask true (.mask group))
                            (Some [fields]
                                  (emit/word! (mut (.text output)) (mut error)
                                              (encode/logical-immediate true 0 16 17 fields)))
                            (None []
                                  (match (constants/emit! (mut (.text output)) true 16 (.mask group))
                                    (Err [message] (set! error message))
                                    (Ok [_] 0))
                                  (emit/word! (mut (.text output)) (mut error)
                                              (encode/logical-register true 0 16 17 16))))
                          ; The last address can follow: branch away instead.
                          (if (and (= round (- used 1)) (= (.destination group) next))
                              (branch! (mut output) (mut branches) fallback
                                       (encode/register-condition 16 true false))
                              (do (branch! (mut output) (mut branches) (.stub group)
                                           (encode/register-condition 16 true true))
                                  (when (= round (- used 1))
                                    (branch! (mut output) (mut branches) fallback -1))))
                          (set! (mut groups) best
                                (Group :destination (.destination group)
                                       :stub (.stub group)
                                       :mask (.mask group)
                                       :count -1))))))))))))
    fits))

;;; One strategy for cases that all need a test.
(defn select! [(output (mut code/Buffer))
               (wide bool)
               (reg i32)
               (dispatch switch/Dispatch)
               (stubs (ArrayList i32))
               (destinations (ArrayList i32))
               (fallback i32)
               (next i32)
               (labels (mut (ArrayList i64)))
               (branches (mut (ArrayList fixups/Branch)))
               (relatives (mut (ArrayList fixups/Relative)))
               (error (mut (slice u8)))] (-> void)
  (let [length (table-length dispatch)]
    (unless (bit-tests! (mut output) wide reg dispatch stubs destinations fallback next
                        (mut branches) (mut error))
      (cond (and (= length 0) (<= (len (.cases dispatch)) 3) (singletons? dispatch))
              (linear! (mut output) wide reg dispatch stubs fallback (mut branches) (mut error))
            (= length 0)
              (tree! (mut output)
                     wide
                     reg
                     dispatch
                     stubs
                     fallback
                     0
                     (len (.cases dispatch))
                     (mut labels)
                     (mut branches)
                     (mut error))
            :else
              (table! (mut output)
                        wide
                        reg
                        dispatch
                        stubs
                        fallback
                        length
                        (mut branches)
                        (mut relatives)
                        (mut error))))))

;;; reg holds the normalized order key; it is x16 unless the selector needed
;;; no normalization. Tables jump through x16/x17. A word key (WIDE false) is
;;; the low word of reg, whose upper bits are unspecified: its comparisons and
;;; table index use the W form, and its case keys fit 32 bits. destinations
;;; names the code address behind each stub, the fallback's last: a case that
;;; reaches the fallback's address is the fallback, and needs no test. next is
;;; the address that directly follows the dispatch code, or zero when unknown.
(defn dispatch! [(output (mut code/Buffer))
                 (wide bool)
                 (reg i32)
                 (dispatch switch/Dispatch)
                 (stubs (ArrayList i32))
                 (destinations (ArrayList i32))
                 (fallback i32)
                 (next i32)
                 (labels (mut (ArrayList i64)))
                 (branches (mut (ArrayList fixups/Branch)))
                 (relatives (mut (ArrayList fixups/Relative)))
                 (error (mut (slice u8)))] (-> void)
  (let [count (len (.cases dispatch))
        beyond (get destinations count)
        (mut redundant) false]
    (for [i 0 count]
      (when (= (get destinations i) beyond) (set! redundant true)))
    (if (not redundant)
        (select! (mut output) wide reg dispatch stubs destinations fallback next
                 (mut labels) (mut branches) (mut relatives) (mut error))
        (let [(mut cases) (ArrayList::new [switch/Case] (.alc stubs))
              (mut kept-stubs) (ArrayList::new [i32] (.alc stubs))
              (mut kept-destinations) (ArrayList::new [i32] (.alc stubs))]
          (for [i 0 count]
            (when (!= (get destinations i) beyond)
              (push! (mut cases) (get (.cases dispatch) i))
              (push! (mut kept-stubs) (get stubs i))
              (push! (mut kept-destinations) (get destinations i))))
          (select! (mut output)
                   wide
                   reg
                   (switch/Dispatch :selector (.selector dispatch)
                                    :ty (.ty dispatch)
                                    :cases cases
                                    :fallback (.fallback dispatch))
                   kept-stubs kept-destinations fallback next
                   (mut labels) (mut branches) (mut relatives) (mut error))
          (free! (mut cases))
          (free! (mut kept-stubs))
          (free! (mut kept-destinations))))
    ; A closing jump to the fallback is dropped when the fallback follows.
    ; Labels bound at that jump then name the same address it reached.
    (when (and (= error "") (= beyond next) (> (len branches) 0))
      (let [closing (get branches (- (len branches) 1))]
        (when (and (= (.offset closing) (- (len (.text output)) 4))
                   (= (.condition closing) -1)
                   (= (.label closing) fallback))
          (pop! (mut branches))
          (for [i 0 4] (pop! (mut (.text output)))))))))
