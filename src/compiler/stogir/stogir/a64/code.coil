;;; Code bytes and pending graph references travel together through emission.
(module stogir.a64.code)
(import "stogir.graph" :as g)
(import "stogir.alignment" :as alignment)
(import "stogir.node" :as n)
(import "stogir.symbols" :as symbols)
(import "stogir.long-constant" :as long)
(import "stogir.bytes" :as bytes)
(import "stogir.text-data" :as text-data)
(import "stogir.a64.constants" :as constants)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.primitive" :as primitive)
(import "coil.result" :use [Result Ok Err Some None])

;;; Image relocation kind, with a negative graph constant reference as target.
(defstruct Reference [(offset i64) (kind i32) (target i32)])

;;; fixed holds the byte offsets of instruction words that are volatile
;;; accesses: each must stay the one instruction it is. Emission records them
;;; (fix-last-word!), append! carries them, and the word peephole that merges
;;; neighbouring accesses (fixups/pair-adjacent!) leaves them alone and then
;;; forgets them. Nothing may move text between emission and that peephole.
(defstruct Buffer
  [(alignment i64)
   (text (ArrayList u8))
   (references (ArrayList Reference))
   (text-data (ArrayList text-data/Range))
   (fixed (ArrayList i64))])

(defn create [(allocator (dyn Allocator))] (-> Buffer)
  (Buffer
    :alignment 4
    :text (ArrayList::new [u8] allocator)
    :text-data (ArrayList::new [text-data/Range] allocator)
    :references (ArrayList::new [Reference] allocator)
    :fixed (ArrayList::new [i64] allocator)))

(defn release! [(buffer (mut Buffer))] (-> void)
  (free! (mut (.text buffer)))
  (free! (mut (.text-data buffer)))
  (free! (mut (.references buffer)))
  (free! (mut (.fixed buffer))))

;;; The last word appended is a volatile access.
(defn fix-last-word! [(buffer (mut Buffer))] (-> void)
  (push! (mut (.fixed buffer)) (- (len (.text buffer)) 4)))

(defn take-text! [(buffer (mut Buffer)) (allocator (dyn Allocator))]
  (-> (ArrayList u8))
  (let [text (load (mut (.text buffer)))]
    (store! (mut (.text buffer)) (ArrayList::new [u8] allocator))
    text))

;;; Append a distinct temporary buffer and rebase every pending reference.
(defn append! [(output (mut Buffer)) (source Buffer)] (-> bool)
  (let [base (len (.text output))
        (mut valid?)
          (not (and (> (len (.references source)) 0)
                    (= (primitive/cast usize (.data (.references source)))
                       (primitive/cast usize (.data (.references output))))))]
    (when (or (< (.alignment source) 4)
              (< (.alignment output) 4)
              (not (alignment/valid? (.alignment source)))
              (not (alignment/valid? (.alignment output))))
      (set! valid? false))
    (when (and valid? (!= (% base (.alignment source)) 0)) (set! valid? false))
    (when (and (> (len (.text-data source)) 0)
               (= (primitive/cast usize (.data (.text-data source)))
                  (primitive/cast usize (.data (.text-data output)))))
      (set! valid? false))
    (match (text-data/validate (.text-data source) (len (.text source)))
      (Err [_] (set! valid? false))
      (Ok [_] 0))
    (match (text-data/validate (.text-data output) base)
      (Err [_] (set! valid? false))
      (Ok [_] 0))
    (let [items-103 (.references source) (mut for-index-103) (: 0 i64)] (while (< for-index-103 (len items-103)) (let [reference (get items-103 for-index-103)]
      (when (or (!= (% base 4) 0)
                (!= (% (.offset reference) 4) 0)
                (< (.offset reference) 0)
                (> (.offset reference) (- (len (.text source)) 4))
                (>= (.target reference) 0)
                (< (.kind reference) 2)
                (> (.kind reference) 4))
        (set! valid? false))) (set! for-index-103 (+ for-index-103 1))))
    (if (or (not valid?)
            (not (bytes/append-slice! (mut (.text output))
                                      (slice (.text source)))))
        false
        (do
          (set! (.alignment output)
                (alignment/maximum (.alignment output) (.alignment source)))
          (let [items-102 (.text-data source) (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [range (get items-102 for-index-102)]
            (push! (mut (.text-data output))
                   (text-data/Range
                     :offset (+ base (.offset range))
                     :length (.length range)
                     :kind (.kind range)))) (set! for-index-102 (+ for-index-102 1))))
          (for [i 0 (len (.fixed source))]
            (push! (mut (.fixed output)) (+ base (get (.fixed source) i))))
          (let [items-101 (.references source) (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [reference (get items-101 for-index-101)]
            (push! (mut (.references output))
                   (Reference
                     :offset (+ base (.offset reference))
                     :kind (.kind reference)
                     :target (.target reference)))) (set! for-index-101 (+ for-index-101 1))))
          true))))

;;; Named functions/data use a local full-width address slot (ADRP/LDR).
;;; String literals address their owned bytes directly (ADRP/ADD).
;;; Returns bytes emitted. All forms preserve NZCV for conditional selection.
(defn materialize! [(output (mut Buffer))
                    (graph g/Graph)
                    (reference i32)
                    (wide bool)
                    (reg i32)] (-> (Result i32 (slice u8)))
  (if (or (>= reference 0)
          (< reg 0)
          (> reg 30)
          (!= (% (len (.text output)) 4) 0))
      (Err "invalid constant reference or register")
      (match (g/lookup graph reference)
        (None [] (Err "constant missing"))
        (Some [node]
              (if (symbols/numeric? node)
                  (match (constants/emit! (mut (.text output))
                                          wide
                                          reg
                                          (n/constant-bits node))
                    (Err [message] (Err message))
                    (Ok [words] (Ok (* words 4))))
                  (if (or (not wide) (not (symbols/validate graph node)))
                      (Err "invalid symbolic address constant")
                      (reference-address! (mut output)
                                          reference
                                          reg
                                          (= (n/opcode node) 77))))))))

;;; Shared address template; direct data uses ADD, named address slots use LDR.
(defn reference-address! [(output (mut Buffer))
                          (reference i32)
                          (reg i32)
                          (direct? bool)]
  (-> (Result i32 (slice u8)))
  (if (or (>= reference 0)
          (< reg 0)
          (> reg 30)
          (!= (% (len (.text output)) 4) 0))
      (Err "invalid address reference or register")
      (let [offset (len (.text output))
            r (cast u32 reg)]
        (bytes/append32! (mut (.text output)) (| (: 0x90000000 u32) r))
        (bytes/append32! (mut (.text output))
                         (| (if direct? (: 0x91000000 u32) (: 0xF9400000 u32))
                            (<< r 5)
                            r))
        (push! (mut (.references output))
               (Reference
                 :offset offset
                 :kind 3
                 :target reference))
        (push! (mut (.references output))
               (Reference
                 :offset (+ offset 4)
                 :kind 4
                 :target reference))
        (Ok 8))))

(defn long-address! [(output (mut Buffer))
                     (graph g/Graph)
                     (reference i32)
                     (reg i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "long constant missing"))
    (Some [node]
          (if (or (not (long/valid-header? node 8))
                  (<= (g/long-size graph reference) 0))
              (Err "invalid long constant address")
              (reference-address! (mut output) reference reg true)))))

(defn direct-branch! [(output (mut Buffer))
                      (graph g/Graph)
                      (reference i32)
                      (link bool)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "call target missing"))
    (Some [node]
          (if (or (>= reference 0)
                  (!= (% (len (.text output)) 4) 0)
                  (!= (n/opcode node) 74)
                  (not (symbols/validate graph node)))
              (Err "direct call requires named FUNC constant")
              (let [offset (len (.text output))]
                (bytes/append32! (mut (.text output))
                                 (if link (: 0x94000000 u32) (: 0x14000000 u32)))
                (push! (mut (.references output))
                       (Reference
                         :offset offset
                         :kind 2
                         :target reference))
                (Ok 4))))))

(defn direct-call! [(output (mut Buffer)) (graph g/Graph) (reference i32)]
  (-> (Result i32 (slice u8)))
  (direct-branch! (mut output) graph reference true))

;;; B and BL share BRANCH26 relocation; the encoded link bit is preserved.
(defn direct-jump! [(output (mut Buffer)) (graph g/Graph) (reference i32)]
  (-> (Result i32 (slice u8)))
  (direct-branch! (mut output) graph reference false))
