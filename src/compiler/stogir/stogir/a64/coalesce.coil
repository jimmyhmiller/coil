;;; Contained COPY/same-bank BITCAST reuse follows ir_ra.c:ir_coalesce and
;;; ir_vregs_inside. Only allocation identity changes; see NOTICE/provenance.
(module stogir.a64.coalesce)
(import "stogir.fill" :as fill)
(import "stogir.graph" :as g)
(import "stogir.cfg" :as cfg)
(import "stogir.a64.phi-coalesce" :as phi)
(import "stogir.a64.convert" :as convert)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.interval" :as interval)
(import "stogir.live-ranges" :as ranges)
(import "stogir.constraints" :as c)
(import "stogir.interval-queue" :as queue)
(import "coil.hashmap" :use [HashMap])
(import "stogir.allocation" :as allocation)
(import "stogir.locations" :as locations)
(import "stogir.a64.registers" :as registers)
(import "stogir.schedule" :as schedule)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Some None])

;;; PROTO only names its address operand's prototype (emitted as an identity
;;; copy). A 64-to-32-bit integer TRUNC is also a register view: it is emitted as a
;;; plain move, and consumers of 32-bit values read only the low word (ZEXT
;;; knowledge never treats such a TRUNC as zero-extended).
(defn reusable? [(graph g/Graph) (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (n/opcode node)
        ty (cast i32 (n/type-id node))]
    (and (or (= opcode 68) (= opcode 36) (= opcode 35) (= opcode 40))
         (> (.op1 node) 0)
         (types/valid-scalar? ty)
         (> (types/size ty 8) 0)
         ; BOOL-producing conversions canonicalize nonzero bytes, so they
         ; cannot share a still-live source even at the same storage width.
         (or (= opcode 68) (= opcode 40) (!= ty 1))
         (<= (types/size ty 8) 8)
         (match (g/lookup graph (.op1 node))
           (None [] false)
           (Some [source]
                 (let [input (cast i32 (n/type-id source))]
                   (and (types/valid-scalar? input)
                        (if (= opcode 35)
                            (and (types/integer? ty) (types/integer? input)
                                 (= (types/size ty 8) 4) (= (types/size input 8) 8))
                            (= (types/size input 8) (types/size ty 8)))
                        (= (registers/class-mask input)
                           (registers/class-mask ty)))))))))

;;; Sorted, disjoint half-open ranges, including lifetime holes. A bounding
;;; span cannot establish containment. Empty values are never candidates.
(defn inside? [(parent (ArrayList interval/Range))
               (child (ArrayList interval/Range))] (-> bool)
  (let [(mut p) 0
        (mut result) (> (len child) 0)]
    (let [items-108 child (mut for-index-108) (: 0 i64)] (while (< for-index-108 (len items-108)) (let [range (get items-108 for-index-108)]
      (while (and (< p (len parent))
                  (<= (.end (get parent p)) (.start range)))
        (set! p (+ p 1)))
      (if (>= p (len parent))
          (set! result false)
          (let [outer (get parent p)]
            (when (or (> (.start outer) (.start range))
                      (< (.end outer) (.end range)))
              (set! result false))))) (set! for-index-108 (+ for-index-108 1))))
    result))

;;; Full position and graph reference identity; no schedule-size truncation.
(defn fixed-key [(parent i32) (position i64)] (-> u128)
  (| (<< (cast u128 (cast u64 position)) 32) (cast u128 (cast u32 parent))))

;;; Each member retains its sorted uses until every union is decided. Merge
;;; once per completed vreg group with a k-way heap, O(U log K), instead of
;;; repeatedly copying a growing source list for K contained copies.
(defn merge-group! [(parts (mut (ArrayList allocation/Part)))
                    (parent i32)
                    (head i32)
                    (links (ArrayList i32))
                    (cursors (mut (ArrayList i64)))
                    (a (dyn Allocator))] (-> void)
  (let [(mut pending) (ArrayList::new [queue/Item] a)
        (mut merged) (ArrayList::new [c/Use] a)
        (mut member) head]
    (while (>= member 0)
      (let [part (at parts (cast i64 member))]
        (when (> (len (.uses part)) 0)
          (queue/insert! (mut pending)
                         (queue/Item
                           :position (.position (get (.uses part) 0))
                           :interval member))))
      (set! member (get links (cast i64 member))))
    (while (> (len pending) 0)
      (match (queue/take! (mut pending))
        (None [] 0)
        (Some [item]
              (let [index (cast i64 (.interval item))
                    part (at parts index)
                    cursor (get cursors index)
                    use (get (.uses part) cursor)
                    last (- (len merged) 1)]
                (if (and (>= last 0)
                         (= (.position (get merged last)) (.position use)))
                    (when (> (.kind use) (.kind (get merged last)))
                      (set! (mut merged) last use))
                    (push! (mut merged) use))
                (set! (mut cursors) index (+ cursor 1))
                (when (< (+ cursor 1) (len (.uses part)))
                  (queue/insert! (mut pending)
                                 (queue/Item
                                   :position
                                     (.position (get (.uses part) (+ cursor 1)))
                                   :interval (.interval item))))))))
    (set! member head)
    (while (>= member 0)
      (let [part (elem (mut parts) (cast i64 member))]
        (if (= member parent)
            (free! (mut (.uses part)))
            (do (clear! (mut (.uses part))) (clear! (mut (.ranges part))))))
      (set! member (get links (cast i64 member))))
    (set! (.uses (elem (mut parts) (cast i64 parent))) merged)
    (free! (mut pending))))

(defn canonical [(parents (ArrayList i32)) (reference i32)] (-> i32)
  (let [(mut result) reference]
    (while (!= (get parents (cast i64 result)) result)
      (set! result (get parents (cast i64 result))))
    result))

;;; A Phi is redefined after incoming ordinary live values on every entry.
;;; Our compact two-position range model gives both phases the block's start;
;;; a child live there may still hold the previous iteration's Phi value.
(defn entry-conflict? [(graph g/Graph)
                       (scheduled schedule/Schedule)
                       (source i32)
                       (child (ArrayList interval/Range))] (-> bool)
  (let [node (get (.instructions graph) (cast i64 source))]
    (and (= (n/opcode node) 67)
         (interval/covers? child
                           (* (.offset (get (.ranges scheduled)
                                            (cast i64 (.op1 node))))
                              2)))))

;;; Graph reference to part index, built on the first candidate.
(defn index-parts! [(indices (mut (ArrayList i32))) (parts (ArrayList allocation/Part))
                    (graph g/Graph)] (-> void)
  (when (= (len indices) 0)
    (fill/append! (mut indices) (len (.instructions graph)) -1)
    (for [i 0 (len parts)]
      (let [part (at parts i)]
        (when (> (.parent part) 0)
          (set! (mut indices) (cast i64 (.parent part)) (cast i32 i)))))))

;;; A widening view (convert/widening-view?) shares its source's lifetime: the
;;; source's definition already leaves the whole widened value in its register,
;;; so the pair is one value of the wide type from that definition on. The wide
;;; member owns the group, so every move and spill of it has the wide type's
;;; size and keeps those bits; the source's other consumers read its low part.
;;; The source must be an unshared, non-Phi singleton (its definition needs a
;;; register, never a narrow memory home) whose coincident fixed uses agree.
;;; Returns whether joined.
(defn widen! [(parents (mut (ArrayList i32)))
              (groups (HashMap i32 bool))
              (parts (mut (ArrayList allocation/Part)))
              (indices (ArrayList i32))
              (heads (ArrayList i32))
              (graph g/Graph)
              (reference i32)
              (a (dyn Allocator))] (-> bool)
  (let [input (.op1 (get (.instructions graph) (cast i64 reference)))
        source (get indices (cast i64 input))
        target (get indices (cast i64 reference))]
    (if (or (< source 0) (< target 0)
            (= (n/opcode (get (.instructions graph) (cast i64 input))) 67)
            (and (> (len parents) 0)
                 (or (!= (get parents (cast i64 input)) input)
                     (!= (get parents (cast i64 reference)) reference)))
            (phi/group? groups input)
            (phi/group? groups reference)
            (and (> (len heads) 0)
                 (or (!= (get heads (cast i64 source)) source)
                     (!= (get heads (cast i64 target)) target))))
        false
        (let [s (at parts (cast i64 source))
              t (at parts (cast i64 target))
              alone (and (= (.allowed s) (.allowed t))
                         (> (len (.ranges s)) 0)
                         (> (len (.ranges t)) 0)
                         (phi/compatible? (.uses s) (.uses t)))]
          (if (not alone)
              false
              (let [ranges (phi/union-ranges (.ranges s) (.ranges t) a)
                    uses (phi/union-uses (.uses s) (.uses t) a)
                    owner (elem (mut parts) (cast i64 target))
                    member (elem (mut parts) (cast i64 source))]
                (free! (mut (.ranges owner)))
                (free! (mut (.uses owner)))
                (set! (.ranges owner) ranges)
                (set! (.uses owner) uses)
                (clear! (mut (.ranges member)))
                (clear! (mut (.uses member)))
                (when (= (len parents) 0)
                  (reserve! (mut parents) (len (.instructions graph)))
                  (for [r 0 (len (.instructions graph))]
                    (push! (mut parents) (cast i32 r))))
                (set! (mut parents) (cast i64 input) reference)
                true))))))

;;; A same-size view that is itself a member of a Phi group hands the group its
;;; source: the source (an unshared, non-Phi singleton) joins as one more
;;; non-overlapping member, exactly as a Phi input does, so the view's
;;; definition has nothing to copy. Returns whether joined.
(defn absorb! [(parents (mut (ArrayList i32)))
               (parts (mut (ArrayList allocation/Part)))
               (indices (ArrayList i32))
               (heads (ArrayList i32))
               (graph g/Graph)
               (reference i32)
               (a (dyn Allocator))] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        input (.op1 node)
        owner (phi/root parents reference)
        source (get indices (cast i64 input))
        target (get indices (cast i64 owner))]
    (and (!= (n/opcode node) 35)
         (>= source 0) (>= target 0) (!= source target)
         (> (len parents) 0)
         (= (get parents (cast i64 input)) input)
         (!= (n/opcode (get (.instructions graph) (cast i64 input))) 67)
         (or (= (len heads) 0) (= (get heads (cast i64 source)) source))
         (if (phi/join! (mut parts) target source a)
             (do (set! (mut parents) (cast i64 input) owner) true)
             false))))

;;; An 8- or 16-bit integer BITCAST is emitted as a zero-extension, in place
;;; when it shares its source's register. INPUT joined the sign-extending
;;; widening view OWNER (widen!), whose 64-bit value keeps the sign in those
;;; upper bits for as long as the group lives, so such a BITCAST of INPUT
;;; needs a register of its own.
(defn clears-sign? [(graph g/Graph) (reference i32) (input i32) (owner i32)]
  (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))]
    (and (!= owner input)
         (= (n/opcode node) 36)
         (< (types/size (cast i32 (n/type-id node)) 8) 4)
         (= (n/opcode (get (.instructions graph) (cast i64 owner))) 33))))

;;; Parts are unsplit and unassigned, before physical reservations. A view has
;;; its source's bits and neither is redefined while the other lives (a Phi
;;; source is excluded by entry-conflict?), so a child joins its source group
;;; whenever coincident fixed constraints agree. The group's lifetime becomes
;;; the union: a source that dies at the view hands its register on, and one
;;; that outlives it is not duplicated. In a valid forward data schedule each
;;; encountered COPY definition is a singleton; do not merge an existing group
;;; as a child. Original ranges/uses remain intact until all decisions finish.
;;; The empty result means no aliases and no change to indexed lookup.
(defn extend! [(parents (mut (ArrayList i32)))
               (groups (HashMap i32 bool))
               (parts (mut (ArrayList allocation/Part)))
            (graph g/Graph)
            (scheduled schedule/Schedule)
            (originals (slice ranges/Value))
            (a (dyn Allocator))] (-> void)
  (let [(mut indices) (ArrayList::new [i32] a)
        (mut heads) (ArrayList::new [i32] a)
        (mut links) (ArrayList::new [i32] a)
        (mut cursors) (ArrayList::new [i64] a)
        (mut fixed) (HashMap::new-scalar [u128 i32] a)
        (mut fixed-ready) false]
    ; One schedule walk. Index only on a reusable node, fixed uses only on a
    ; contained candidate, and group storage only after a successful proof.
    (let [items-107 (.nodes scheduled) (mut for-index-107) (: 0 i64)] (while (< for-index-107 (len items-107)) (let [reference (get items-107 for-index-107)]
     (do
      (when (convert/widening-view? graph reference)
        (index-parts! (mut indices) parts graph)
        (when (and (widen! (mut parents) groups (mut parts) indices heads graph reference a)
                   fixed-ready)
          ; The owner's fixed uses now include its source's definition.
          (let [items-106 (.uses (at parts (cast i64 (get indices (cast i64 reference))))) (mut for-index-106) (: 0 i64)] (while (< for-index-106 (len items-106)) (let [use (get items-106 for-index-106)]
            (when (= (.kind use) 2)
              (set! (mut fixed) (fixed-key reference (.position use)) (.register use)))) (set! for-index-106 (+ for-index-106 1))))))
      (when (reusable? graph reference)
        (index-parts! (mut indices) parts graph)
        (let [input (.op1 (get (.instructions graph) (cast i64 reference)))
              source (if (= (len parents) 0) input (canonical parents input))
              parent (get indices (cast i64 source))
              child (get indices (cast i64 reference))
              grouped (phi/group? groups source)]
          (when (and (!= source reference) (>= child 0) (not grouped)
                     (phi/group? groups (phi/root parents reference))
                     (absorb! (mut parents) (mut parts) indices heads graph reference a)
                     fixed-ready)
            (let [owner (phi/root parents reference)]
              (let [items-105 (.uses (at parts (cast i64 (get indices (cast i64 owner))))) (mut for-index-105) (: 0 i64)] (while (< for-index-105 (len items-105)) (let [use (get items-105 for-index-105)]
                (when (= (.kind use) 2)
                  (set! (mut fixed) (fixed-key owner (.position use)) (.register use)))) (set! for-index-105 (+ for-index-105 1))))))
          (when (and (!= source reference)
                     (>= parent 0)
                     (>= child 0)
                     (not (clears-sign? graph reference input source))
                     ; A Phi group holds other values once this source dies:
                     ; only a view inside the source's own lifetime may join.
                     (or (not grouped)
                         (and (< (cast i64 input) (len originals))
                              (inside? (.ranges (get originals (cast i64 input)))
                                       (.ranges (at parts (cast i64 child))))
                              (not (entry-conflict? graph scheduled input
                                                    (.ranges (at parts (cast i64 child)))))))
                     (not (phi/group? groups (phi/root parents reference)))
                     (or (= (len heads) 0)
                         (= (get heads (cast i64 child)) child)))
            (let [p (at parts (cast i64 parent))
                  v (at parts (cast i64 child))
                  contained (inside? (.ranges p) (.ranges v))
                  (mut compatible)
                    (and (= (.allowed p) (.allowed v))
                         (> (len (.ranges p)) 0)
                         (> (len (.ranges v)) 0)
                         (not (entry-conflict? graph
                                               scheduled
                                               source
                                               (.ranges v))))]
              (when compatible
                (unless fixed-ready
                  (let [items-104 parts (mut for-index-104) (: 0 i64)] (while (< for-index-104 (len items-104)) (let [part (get items-104 for-index-104)]
                    (when (> (.parent part) 0)
                      (let [items-103 (.uses part) (mut for-index-103) (: 0 i64)] (while (< for-index-103 (len items-103)) (let [use (get items-103 for-index-103)]
                        (when (= (.kind use) 2)
                          (set! (mut fixed)
                                (fixed-key (.parent part) (.position use))
                                (.register use)))) (set! for-index-103 (+ for-index-103 1)))))) (set! for-index-104 (+ for-index-104 1))))
                  (set! fixed-ready true))
                (let [items-102 (.uses v) (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [use (get items-102 for-index-102)]
                  (when (= (.kind use) 2)
                    (match (get fixed (fixed-key source (.position use)))
                      (None [] 0)
                      (Some [reg]
                            (when (!= reg (.register use))
                              (set! compatible false)))))) (set! for-index-102 (+ for-index-102 1)))))
              (when compatible
                (when (= (len parents) 0)
                  (reserve! (mut parents) (len (.instructions graph)))
                  (for [r 0 (len (.instructions graph))]
                    (push! (mut parents) (cast i32 r))))
                (when (= (len heads) 0)
                  (reserve! (mut heads) (len parts))
                  (reserve! (mut links) (len parts))
                  (for [i 0 (len parts)]
                    (push! (mut heads) (cast i32 i))
                    (push! (mut links) -1)))
                (let [items-101 (.uses v) (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [use (get items-101 for-index-101)]
                  (when (= (.kind use) 2)
                    (set! (mut fixed)
                          (fixed-key source (.position use))
                          (.register use)))) (set! for-index-101 (+ for-index-101 1))))
                ; A view outliving its source extends the shared lifetime at
                ; once, so later views of the group are tested against it.
                (unless contained
                  (let [joined (phi/union-ranges (.ranges p) (.ranges v) a)
                        owner (elem (mut parts) (cast i64 parent))]
                    (free! (mut (.ranges owner)))
                    (set! (.ranges owner) joined)))
                (set! (mut links)
                      (cast i64 child)
                      (get heads (cast i64 parent)))
                (set! (mut heads) (cast i64 parent) child)
                (set! (mut heads) (cast i64 child) -1)
                (set! (mut parents) (cast i64 reference) source)))))))) (set! for-index-107 (+ for-index-107 1))))
    (when (> (len heads) 0)
      (fill/append! (mut cursors) (len parts) 0)
      (for [i 0 (len parts)]
        (let [head (get heads i)]
          (when (and (>= head 0) (!= head (cast i32 i)))
            (merge-group! (mut parts) (cast i32 i) head links (mut cursors) a)))))
    (when (> (len parents) 0)
      (for [r 1 (len parents)]
        (set! (mut parents) r (canonical parents (cast i32 r)))))
    (free! (mut fixed))
    (free! (mut indices))
    (free! (mut heads))
    (free! (mut links))
    (free! (mut cursors))))

(defn run! [(parts (mut (ArrayList allocation/Part)))
            (graph g/Graph) (scheduled schedule/Schedule)
            (a (dyn Allocator))] (-> (ArrayList i32))
  (let [(mut parents) (ArrayList::new [i32] a)
        (mut groups) (HashMap::new-scalar [i32 bool] a)]
    (extend! (mut parents) groups (mut parts) graph scheduled [] a)
    (free! (mut groups))
    parents))

;;; Prepared CFG/depths belong to the same immutable graph/schedule epoch.
;;; originals[r] is value r's own lifetime before any joining (empty when
;;; unknown: views of Phi-group members then stay separate).
(defn run-prepared! [(parts (mut (ArrayList allocation/Part)))
                     (graph g/Graph) (scheduled schedule/Schedule)
                     (blocks cfg/Blocks) (depths (ArrayList i32))
                     (originals (slice ranges/Value))
                     (a (dyn Allocator))] (-> (ArrayList i32))
  (let [(mut parents) (ArrayList::new [i32] a)
        (mut groups) (phi/run! (mut parts) (mut parents) graph scheduled blocks depths a)]
    (extend! (mut parents) groups (mut parts) graph scheduled originals a)
    (free! (mut groups))
    parents))

;;; The immutable lookup index is the graph-ref to allocated-vreg map. Alias
;;; buckets borrow the canonical bucket's split children; no duplicate part or
;;; transfer is created. Generic non-coalesced indices keep their usual shape.
(defn index! [(index (mut locations/Index)) (parents (ArrayList i32))] (-> void)
  (when (> (len parents) 0) (set! (.coalesced index) true))
  (for [r 1 (len parents)]
    (let [parent (get parents r)]
      (when (!= parent (cast i32 r))
        (set! (mut (.parents index)) r (get (.parents index) (cast i64 parent)))))))
