;;; Whole-vector selection from captured scalar truth flags; NE means true.
(module stogir.a64.vector-select)

(export emit-flags!)

(import "stogir.types" :as types)
(import "stogir.a64.encode" :as encode)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn word! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (word (Result u32 (slice u8)))] (-> void)
  (match word
    (Err [message] (set! error message))
    (Ok [bits] (bytes/append32! (mut out) bits))))

;;; Mask register is distinct from both arms. If both scratches hold literals,
;;; the allocated destination is available for the mask. No arm bits are changed
;;; before BSL reads them, including when the result aliases an allocated arm.
(defn emit-flags! [(output (mut (ArrayList u8)))
                   (ty i32)
                   (rd i32)
                   (yes i32)
                   (no i32)] (-> (Result i32 (slice u8)))
  (if (or (not (types/short-vector? ty 8))
          (< rd 0)
          (> rd 29)
          (< yes 0)
          (> yes 31)
          (< no 0)
          (> no 31))
      (Err "unsupported AArch64 vector selection shape or registers")
      (let [(mut temporary) (ArrayList::new [u8] (.alc output))
            (mut error) ""
            width (types/size ty 8)
            mask
              (if (and (!= yes 30) (!= no 30))
                  (: 30 i32)
                  (if (and (!= yes 31) (!= no 31)) 31 rd))]
        (word! (mut temporary)
               (mut error)
               (encode/conditional-set-mask true 16 1))
        (if (= width 8)
            (word! (mut temporary)
                   (mut error)
                   (encode/scalar-transfer true true mask 16))
            (bytes/append32! (mut temporary)
                             (| (: 0x4E080C00 u32)
                                (<< (: 16 u32) 5)
                                (cast u32 mask))))
        (bytes/append32! (mut temporary)
                         (| (: 0x2E601C00 u32)
                            (if (= width 16) (: 0x40000000 u32) (: 0 u32))
                            (cast u32 mask)
                            (<< (cast u32 yes) 5)
                            (<< (cast u32 no) 16)))
        (when (!= mask rd)
          (word! (mut temporary) (mut error) (encode/simd-move width rd mask)))
        (let [size (cast i32 (len temporary))]
          (when (= error "")
            (extend! (mut output) (.data temporary) (len temporary)))
          (free! (mut temporary))
          (if (= error "") (Ok size) (Err error))))))
