; Local access lowering follows dstogov/ir ir_aarch64.dasc, 92171d0. See NOTICE.
(module stogir.a64.locals)
(import "stogir.locals" :as local)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.frame" :as frame)
(import "stogir.allocation" :as a)
(import "stogir.locations" :as loc)
(import "stogir.a64.value" :as value)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.frame-address" :as address)
(import "stogir.a64.code" :as code)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn offset-aligned [(layout frame/Frame)
                      (graph g/Graph)
                      (variable i32)
                      (base address/Base)
                      (alignment i64)]
  (-> (Result i64 (slice u8)))
  (match (local/shape graph variable 8)
    (Err [message] (Err message))
    (Ok [shape]
        (match (get (.locals layout) variable)
          (None [] (Err "local variable has no frame slot"))
          (Some [index]
                (if (or (< index 0) (>= index (len (.slots layout))))
                    (Err "invalid local frame slot index")
                    (let [slot (get (.slots layout) index)]
                      (if (or (!= (.size slot) (.size shape))
                              (!= (.alignment slot) (.alignment shape))
                              (or (not (frame/valid-alignment? alignment))
                                  (> (.alignment shape) alignment))
                              (< (.offset slot) 0)
                              (!= (% (.offset slot) (.alignment shape)) 0)
                              (> (.offset slot) (- (.size layout) (.size slot))))
                          (Err "local frame slot shape mismatch")
                          (address/offset base (.offset slot))))))))))

;;; Address calculation uses reserved x16; literal data uses x17/v31. Direct
;;; loads/stores at offset zero support unaligned views and large local offsets.
(defn emit-aligned! [(output (mut code/Buffer))
                     (graph g/Graph)
                     (parts (ArrayList a/Part))
                     (layout frame/Frame)
                     (reference i32)
                     (position i64)
                     (base address/Base)
                     (alignment i64)]
  (-> (Result i32 (slice u8)))
  (match (local/validate graph reference 8)
    (Err [message] (Err message))
    (Ok [width]
        (let [node (get (.instructions graph) (cast i64 reference))
              opcode (n/opcode node)
              address? (= opcode 65)
              load? (or (= opcode 85) (= opcode 86))
              variable (if address? (.op1 node) (.op2 node))]
          (if (= opcode 72)
              (Err "VAR has no machine instruction")
              (match (offset-aligned layout graph variable base alignment)
                (Err [message] (Err message))
                (Ok [displacement]
                    (let [(mut temporary) (code/create (.alc (.text output)))
                          (mut error) ""
                          (mut reg) (: -1 i32)]
                      (if (or address? load?)
                          (match (loc/lookup parts reference (+ position 1))
                            (Err [message] (set! error message))
                            (Ok [destination]
                                (if (and (= (.kind destination) 0)
                                         (registers/allocatable? (cast i32
                                                                       (n/type-id node))
                                                                 (cast i32
                                                                       (.value destination))))
                                    (set! reg (cast i32 (.value destination)))
                                    (set! error
                                          "local result needs a register of its class"))))
                          (match (value/register! (mut temporary)
                                                  graph
                                                  parts
                                                  (.op3 node)
                                                  position
                                                  17
                                                  63)
                            (Err [message] (set! error message))
                            (Ok [r] (set! reg r))))
                      (when (= error "")
                        (match (address/address! (mut (.text temporary))
                                                 (if address? reg 16)
                                                 (.reg base)
                                                 displacement)
                          (Err [message] (set! error message))
                          (Ok [_] 0)))
                      (when (and (= error "") (not address?))
                        (match (if (registers/simd? reg)
                                   (encode/floating-load-store load?
                                                               width
                                                               (registers/physical reg)
                                                               16
                                                               0)
                                   (if (and load?
                                            (< width 4)
                                            (types/signed? (cast i32
                                                                 (n/type-id node))))
                                       (encode/signed-load false width reg 16 0)
                                       (encode/load-store load? width reg 16 0)))
                          (Err [message] (set! error message))
                          (Ok [word]
                              (bytes/append32! (mut (.text temporary)) word))))
                      (let [count (cast i32 (len (.text temporary)))]
                        (when (and (= error "")
                                   (not (code/append! (mut output) temporary)))
                          (set! error "invalid local access code references"))
                        (code/release! (mut temporary))
                        (if (= error "") (Ok count) (Err error)))))))))))

(defn offset [(layout frame/Frame) (graph g/Graph) (variable i32)]
  (-> (Result i64 (slice u8)))
  (offset-at layout graph variable (address/stack-base)))

(defn emit! [(output (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList a/Part))
             (layout frame/Frame)
             (reference i32)
             (position i64)] (-> (Result i32 (slice u8)))
  (emit-at! (mut output)
            graph
            parts
            layout
            reference
            position
            (address/stack-base)))

(defn offset-at [(layout frame/Frame)
                 (graph g/Graph)
                 (variable i32)
                 (base address/Base)]
  (-> (Result i64 (slice u8)))
  (offset-aligned layout graph variable base 16))

(defn emit-at! [(output (mut code/Buffer))
                (graph g/Graph)
                (parts (ArrayList a/Part))
                (layout frame/Frame)
                (reference i32)
                (position i64)
                (base address/Base)]
  (-> (Result i32 (slice u8)))
  (emit-aligned! (mut output) graph parts layout reference position base 16))
