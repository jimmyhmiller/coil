;;; Initial AArch64 integer register constraints over a selected schedule.
(module stogir.a64.constraints)
(import "stogir.graph" :as g)
(import "stogir.copy" :as copy)
(import "stogir.a64.match" :as matching)
(import "stogir.atomic" :as atomic)
(import "stogir.types" :as types)
(import "stogir.vector-arithmetic" :as va)
(import "stogir.vector-comparison" :as vc)
(import "stogir.vector-lanes" :as vl)
(import "stogir.a64.registers" :as registers)
(import "stogir.calls" :as calls)
(import "stogir.argument-value" :as argval)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.a64.incoming" :as incoming)
(import "stogir.a64.select" :as select)
(import "stogir.a64.memory" :as memory)
(import "stogir.a64.convert" :as convert)
(import "stogir.a64.unary" :as unary)
(import "stogir.a64.conditional" :as cond)
(import "stogir.a64.checked" :as checked)
(import "stogir.floating" :as floating)
(import "stogir.locals" :as locals)
(import "stogir.stack" :as stack)
(import "stogir.terminal" :as terminal)
(import "stogir.constraints" :as c)
(import "stogir.schedule" :as schedule)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Value [(uses (ArrayList c/Use)) (parameter incoming/Parameter)])

(defn release! [(values (mut (ArrayList Value)))] (-> void)
  (let [(mut i) 0]
    (while (< i (len values))
      (let [value (elem (mut values) i)] (free! (mut (.uses value))))
      (set! i (+ i 1))))
  (free! (mut values)))

(defn add! [(values (mut (ArrayList Value)))
            (reference i32)
            (position i64)
            (kind i32)
            (register i32)] (-> bool)
  (if (<= reference 0)
      true
      (let [value (elem (mut values) (cast i64 reference))]
        (c/add! (mut (.uses value)) position kind register))))

;;; Scalar GPR/SIMD coverage with Darwin fixed/variadic calls and indirect
;;; ARGVAL copies. Direct aggregate grouping/results need additional ABI lowering.
(defn build-matched [(graph g/Graph)
                     (scheduled schedule/Schedule)
                     (matched matching/Plan)
                     (allocator (dyn Allocator))]
  (-> (Result (ArrayList Value) (slice u8)))
  (let [(mut values) (ArrayList::new [Value] allocator)
        (mut error) ""
        (mut i) 0]
    (while (< i (len (.instructions graph)))
      (push! (mut values)
             (Value
               :uses (ArrayList::new [c/Use] allocator)
               :parameter (incoming/absent)))
      (set! i (+ i 1)))
    (if (= (len (.nodes scheduled)) 0)
        (set! error "empty function schedule")
        (match (incoming/build graph (get (.nodes scheduled) 0) allocator)
          (Err [msg] (set! error msg))
          (Ok [parameters]
              (let [(mut owned) parameters]
                (for parameter owned
                  (let [value
                          (elem (mut values) (cast i64 (.reference parameter)))]
                    (set! (.parameter value) parameter)))
                (free! (mut owned))))))
    (set! i 0)
    (while (and (= error "") (< i (len (.nodes scheduled))))
      (let [reference (get (.nodes scheduled) i)
            node (get (.instructions graph) (cast i64 reference))
            opcode (n/opcode node)
            ty (n/type-id node)
            position (* i 2)]
        (cond (get (.omitted (.operands matched)) (cast i64 reference)) 0
              (> (get (.comparisons matched) (cast i64 reference)) 0)
                (let [comparison
                        (get (.comparisons matched) (cast i64 reference))
                      tile (get (.tiles matched) (cast i64 comparison))]
                  (add! (mut values) (.left tile) position 1 -1)
                  (add! (mut values) (.right tile) position 1 -1)
                  0)
              (> (get (.doubles matched) (cast i64 reference)) 0)
                (do
                  (add! (mut values)
                        (get (.doubles matched) (cast i64 reference))
                        position
                        1
                        -1)
                  (add! (mut values) reference (+ position 1) 1 -1)
                  0)
              :else
                (if (atomic/operation? (cast i32 opcode))
                    (match (atomic/validate graph reference)
                      (Err [message] (set! error message))
                      (Ok [_]
                          (when (!= opcode 130)
                            (add! (mut values) (.op2 node) position 1 -1))
                          (when (and (!= opcode 126) (!= opcode 130))
                            (add! (mut values) (.op3 node) position 1 -1))
                          (when (= opcode 129)
                            (match (g/operand graph reference 4)
                              (None []
                                    (set! error
                                          "atomic desired operand missing"))
                              (Some [r] (add! (mut values) r position 1 -1))))
                          (when (!= ty 0)
                            (add! (mut values) reference (+ position 1) 1 -1))
                          0))
                    (if (or (stack/operation? (cast i32 opcode))
                            (locals/operation? (cast i32 opcode)))
                        (match (if (stack/operation? (cast i32 opcode))
                                   (stack/validate graph reference)
                                   (locals/validate graph reference 8))
                          (Err [message] (set! error message))
                          (Ok [_]
                              (when (or (= opcode 81)
                                        (= opcode 82)
                                        (= opcode 84))
                                (add! (mut values) (.op2 node) position 1 -1))
                              (if (= opcode 72)
                                  0
                                  (if (or (= opcode 87)
                                          (= opcode 88)
                                          (= opcode 82)
                                          (= opcode 84))
                                      (do
                                        (when (and (!= opcode 82)
                                                   (!= opcode 84))
                                          (add! (mut values)
                                                (.op3 node)
                                                position
                                                1
                                                -1))
                                        0)
                                      (do
                                        (add! (mut values)
                                              reference
                                              (+ position 1)
                                              1
                                              -1)
                                        0)))))
                        (if (or (= opcode 40)
                                (= opcode 68)
                                (= opcode 70)
                                (or (vl/operation? (cast i32 opcode))
                                    (vc/node? graph reference))
                                (floating/node? graph reference)
                                (va/node? graph reference))
                            (if (or (or (vl/operation? (cast i32 opcode))
                                        (vc/node? graph reference))
                                    (floating/node? graph reference)
                                    (va/node? graph reference))
                                (match (if (vl/operation? (cast i32 opcode))
                                           (vl/validate graph reference 8)
                                           (if (vc/node? graph reference)
                                               (vc/validate graph reference 8)
                                               (if (va/node? graph reference)
                                                   (va/validate graph reference)
                                                   (floating/validate graph
                                                                      reference))))
                                  (Err [message] (set! error message))
                                  (Ok [_]
                                      (do
                                        (add! (mut values)
                                              reference
                                              (+ position 1)
                                              1
                                              -1)
                                        (add! (mut values)
                                              (.op1 node)
                                              position
                                              1
                                              -1)
                                        (when (not (or (= opcode 63)
                                                       (floating/unary? (cast i32
                                                                              opcode))
                                                       (va/unary? (cast i32
                                                                        opcode))))
                                          (add! (mut values)
                                                (.op2 node)
                                                position
                                                1
                                                -1))
                                        (when (= opcode 62)
                                          (add! (mut values)
                                                (.op3 node)
                                                position
                                                1
                                                -1))
                                        0)))
                                (do
                                  (when (= opcode 68)
                                    (match (copy/validate graph reference)
                                      (Err [message] (set! error message))
                                      (Ok [_]
                                          (when (> (types/size (cast i32 ty) 8)
                                                   16)
                                            (set! error
                                                  "unsupported AArch64 COPY extent")))))
                                  (when (= opcode 70)
                                    (match (argval/validate graph reference)
                                      (Err [message] (set! error message))
                                      (Ok [_] 0)))
                                  (add! (mut values)
                                        reference
                                        (+ position 1)
                                        1
                                        -1)
                                  (add! (mut values) (.op1 node) position 0 -1)
                                  0))
                            (if (= opcode 79)
                                (do
                                  (match (call-uses! (mut values)
                                                     graph
                                                     reference
                                                     position)
                                    (Err [msg] (set! error msg))
                                    (Ok [_] 0))
                                  0)
                                (if (or (op/block-start? (cast i32 opcode))
                                        (= opcode 114)
                                        (= opcode 115)
                                        (= opcode 96)
                                        (= opcode 121))
                                    (if (terminal/operation? (cast i32 opcode))
                                        (match (terminal/validate graph
                                                                  reference)
                                          (Err [message] (set! error message) 0)
                                          (Ok [_] 0))
                                        0)
                                    (if (= opcode 71)
                                        (let [parameter
                                                (.parameter (at values
                                                                (cast i64
                                                                      reference)))]
                                          (if (or (not (call-type? ty))
                                                  (not (or (= (.kind parameter)
                                                              0)
                                                           (= (.kind parameter)
                                                              1)
                                                           (= (.kind parameter)
                                                              2)
                                                           (= (.kind parameter)
                                                              3))))
                                              (do
                                                (set! error
                                                      "unsupported AArch64 scalar parameter")
                                                0)
                                              (do
                                                (add! (mut values)
                                                      reference
                                                      (+ position 1)
                                                      (if (or (= (.kind parameter)
                                                                 1)
                                                              (= (.kind parameter)
                                                                 3))
                                                          1
                                                          2)
                                                      (+ (.register parameter)
                                                         (if (= (.kind parameter)
                                                                2)
                                                             32
                                                             0)))
                                                0)))
                                        (if (= opcode 120)
                                            (do
                                              (when (not (or (= ty 0)
                                                             (call-type? ty)))
                                                (set! error
                                                      "unsupported AArch64 scalar return"))
                                              (when (!= ty 0)
                                                (add! (mut values)
                                                      (.op2 node)
                                                      position
                                                      0
                                                      -1))
                                              0)
                                            (if (= opcode 67)
                                                ; Edge copies define Phis simultaneously;
                                                ; a result may initially live in a stack slot.
                                                0
                                                (if (or (= opcode 116)
                                                        (= opcode 117))
                                                    (do
                                                      (add! (mut values)
                                                            (.op2 node)
                                                            position
                                                            1
                                                            -1)
                                                      0)
                                                    (if (and (>= opcode 91)
                                                             (<= opcode 94))
                                                        (match (memory/size graph
                                                                            reference)
                                                          (Err [msg]
                                                               (set! error msg))
                                                          (Ok [_]
                                                              (do
                                                                (add! (mut values)
                                                                      (if (> (get (.addresses matched)
                                                                                  (cast i64
                                                                                        reference))
                                                                             0)
                                                                          (get (.addresses matched)
                                                                               (cast i64
                                                                                     reference))
                                                                          (.op2 node))
                                                                      position
                                                                      1
                                                                      -1)
                                                                (if (<= opcode
                                                                        92)
                                                                    (add! (mut values)
                                                                          reference
                                                                          (+ position
                                                                             1)
                                                                          1
                                                                          -1)
                                                                    (add! (mut values)
                                                                          (.op3 node)
                                                                          position
                                                                          1
                                                                          -1))
                                                                0)))
                                                        (if (or (checked/operation? (cast i32
                                                                                          opcode))
                                                                (= opcode 60)
                                                                (and (>= opcode
                                                                         33)
                                                                     (<= opcode
                                                                         39))
                                                                (unary/operation? (cast i32
                                                                                        opcode)))
                                                            (match (if (checked/operation? (cast i32
                                                                                                 opcode))
                                                                       (checked/width graph
                                                                                      reference)
                                                                       (if (= opcode
                                                                              60)
                                                                           (cond/width graph
                                                                                       reference)
                                                                           (if (unary/operation? (cast i32
                                                                                                       opcode))
                                                                               (unary/width graph
                                                                                            reference)
                                                                               (convert/width graph
                                                                                              reference))))
                                                              (Err [msg]
                                                                   (set! error
                                                                         msg))
                                                              (Ok [_]
                                                                  (do
                                                                    (when (!= opcode
                                                                              44)
                                                                      (add! (mut values)
                                                                            (.op1 node)
                                                                            position
                                                                            1
                                                                            -1))
                                                                    (add! (mut values)
                                                                          reference
                                                                          (+ position
                                                                             1)
                                                                          1
                                                                          -1)
                                                                    (when (or (= opcode
                                                                                 41)
                                                                              (= opcode
                                                                                 42)
                                                                              (= opcode
                                                                                 43))
                                                                      (add! (mut values)
                                                                            (.op2 node)
                                                                            position
                                                                            1
                                                                            -1))
                                                                    (when (= opcode
                                                                             60)
                                                                      (add! (mut values)
                                                                            (.op2 node)
                                                                            position
                                                                            1
                                                                            -1)
                                                                      (add! (mut values)
                                                                            (.op3 node)
                                                                            position
                                                                            1
                                                                            -1))
                                                                    0)))
                                                            (match (matching/selected matched
                                                                                      reference)
                                                              (Err [msg]
                                                                   (set! error
                                                                         msg))
                                                              (Ok [tile]
                                                                  (do
                                                                    (add! (mut values)
                                                                          reference
                                                                          (+ position
                                                                             1)
                                                                          1
                                                                          -1)
                                                                    (add! (mut values)
                                                                          (.left tile)
                                                                          position
                                                                          1
                                                                          -1)
                                                                    (when (> (.right tile)
                                                                             0)
                                                                      (add! (mut values)
                                                                            (.right tile)
                                                                            position
                                                                            1
                                                                            -1))
                                                                    0))))))))))))))))
      (set! i (+ i 1)))
    (if (= error "") (Ok values) (do (release! (mut values)) (Err error)))))

;;; Arguments may remain in registers or spill slots. Explicit parallel copies
;;; at emission allow repeated arguments and cycles without conflicting fixed uses.
(defn build [(graph g/Graph)
             (scheduled schedule/Schedule)
             (allocator (dyn Allocator))]
  (-> (Result (ArrayList Value) (slice u8)))
  (match (matching/plain graph scheduled allocator)
    (Err [message] (Err message))
    (Ok [plan]
        (let [(mut plan) plan
              result (build-matched graph scheduled plan allocator)]
          (matching/release! (mut plan))
          result))))

(defn call-uses! [(values (mut (ArrayList Value)))
                  (graph g/Graph)
                  (reference i32)
                  (position i64)]
  (-> (Result i32 (slice u8)))
  (let [node (get (.instructions graph) (cast i64 reference))
        count (get (.arities graph) (cast i64 reference))
        ty (n/type-id node)
        (mut error) ""
        (mut j) (: 2 i32)]
    (match (calls/validate-call graph reference)
      (Err [msg] (set! error msg))
      (Ok [signature]
          (when (not (or (= (& (.flags signature) 15) 0)
                         (= (& (.flags signature) 15) 9)))
            (set! error "unsupported AArch64 calling convention"))))
    (when (< count 2)
      (set! error "AArch64 call requires control and callee"))
    (when (not (or (= ty 0) (call-type? ty)))
      (set! error "unsupported AArch64 call result type"))
    (while (and (= error "") (<= j count))
      (match (g/operand graph reference j)
        (None [] (set! error "missing call operand"))
        (Some [value]
              (match (g/lookup graph value)
                (None [] (set! error "invalid call operand"))
                (Some [input]
                      (when (if (= j 2)
                                (!= (n/type-id input) 6)
                                (not (call-type? (n/type-id input))))
                        (set! error "unsupported AArch64 call argument type"))
                      (when (not (add! (mut values) value position 0 -1))
                        (set! error "conflicting call operand constraint"))))))
      (set! j (+ j 1)))
    (when (!= ty 0)
      (when (not (add! (mut values)
                       reference
                       (+ position 1)
                       2
                       (if (registers/simd-type? (cast i32 ty)) 32 0)))
        (set! error "conflicting call result constraint")))
    (if (= error "") (Ok 0) (Err error))))

(defn call-type? [(ty u8)] (-> bool)
  (or (types/integer? (cast i32 ty)) (registers/simd-type? (cast i32 ty))))
