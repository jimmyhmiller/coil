;;; Native SIMD/GPR lane transfer primitives shared by arithmetic and lane users.
(module stogir.a64.simd-lanes)
(import "coil.result" :use [Result Ok Err])

;;; Signed byte/halfword lanes extend to W; 32-bit signed division interprets
;;; the same W bits as UMOV. A 64-bit lane always uses the X form.
(defn lane-extract [(signed? bool) (element i32) (lane i32) (rd i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (if (or (not (or (= element 1) (= element 2) (= element 4) (= element 8)))
          (< lane 0)
          (>= lane (/ 16 element))
          (< rd 0)
          (> rd 30)
          (< rn 0)
          (> rn 31))
      (Err "invalid SIMD lane extraction")
      (Ok (| (if (and signed? (< element 4))
                 (: 0x0E002C00 u32)
                 (: 0x0E003C00 u32))
             (if (= element 8) (: 0x40000000 u32) (: 0 u32))
             (<< (cast u32 (+ (* lane element 2) element)) 16)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))

(defn lane-insert [(element i32) (lane i32) (rd i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (if (or (not (or (= element 1) (= element 2) (= element 4) (= element 8)))
          (< lane 0)
          (>= lane (/ 16 element))
          (< rd 0)
          (> rd 31)
          (< rn 0)
          (> rn 30))
      (Err "invalid SIMD lane insertion")
      (Ok (| (: 0x4E001C00 u32)
             (<< (cast u32 (+ (* lane element 2) element)) 16)
             (<< (cast u32 rn) 5)
             (cast u32 rd)))))
