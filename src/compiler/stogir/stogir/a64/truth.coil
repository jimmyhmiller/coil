;;; Shared scalar nonzero flags for IF and COND. NE means true, including NaNs.
(module stogir.a64.truth)
(import "stogir.locations" :as emitted-locations)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.allocation" :as a)
(import "stogir.a64.value" :as value)
(import "stogir.a64.code" :as code)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.emit" :as emit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn flags-with-locations! [(out (mut code/Buffer))
                             (graph g/Graph)
                             (parts emitted-locations/View)
                             (reference i32)
                             (position i64)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "truth operand missing"))
    (Some [node]
          (let [ty (cast i32 (n/type-id node))
                size (types/scalar-size ty 8)]
            (if (<= size 0)
                (Err "truth requires a scalar value")
                (let [(mut temp) (code/create (.alc (.text out)))
                      (mut error) ""]
                  (match (value/register-with-locations! (mut temp)
                                                         graph
                                                         parts
                                                         reference
                                                         position
                                                         16
                                                         62)
                    (Err [message] (set! error message))
                    (Ok [input]
                        (let [(mut reg) input]
                          (if (types/floating? ty)
                              (emit/word! (mut (.text temp))
                                          (mut error)
                                          (encode/floating-compare-zero (= size
                                                                           8)
                                                                        (- reg
                                                                           32)))
                              (do
                                (when (< size 4)
                                  (emit/word! (mut (.text temp))
                                              (mut error)
                                              (encode/extend false
                                                             false
                                                             (* size 8)
                                                             16
                                                             reg))
                                  (set! reg 16))
                                (emit/word! (mut (.text temp))
                                            (mut error)
                                            (encode/add-sub (= size 8)
                                                            true
                                                            true
                                                            31
                                                            reg
                                                            31)))))))
                  (let [count (cast i32 (len (.text temp)))]
                    (when (and (= error "") (not (code/append! (mut out) temp)))
                      (set! error "invalid truth code references"))
                    (code/release! (mut temp))
                    (if (= error "") (Ok count) (Err error)))))))))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn flags! [(out (mut code/Buffer))
              (graph g/Graph)
              (parts (ArrayList a/Part))
              (reference i32)
              (position i64)] (-> (Result i32 (slice u8)))
  (flags-with-locations! (mut out)
                         graph
                         (emitted-locations/linear-view parts)
                         reference
                         position))
