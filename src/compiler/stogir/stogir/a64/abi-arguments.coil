;;; Shared Darwin scalar/group argument placement for callers and callees.
(module stogir.a64.abi-arguments)
(import "stogir.call-groups" :as groups)
(import "stogir.call-results" :as results)
(import "stogir.types" :as types)
(import "stogir.a64.registers" :as registers)
(import "stogir.alignment" :as alignment)
(import "coil.slice" :use [subslice])
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(defstruct Part [(register i32) (offset i64) (size i32) (promote? bool)])

(defstruct Layout [(parts (ArrayList Part)) (stack i64)])

(defn release! [(layout (mut Layout))] (-> void)
  (free! (mut (.parts layout))))

(defn validate [(parameters (slice u8))
                (fixed i64)
                (variadic? bool)
                (descriptors (slice groups/Group))] (-> bool)
  (if (or (< fixed 0)
          (> fixed (len parameters))
          (> (len parameters) 65533)
          (and (not variadic?) (!= fixed (len parameters))))
      false
      (let [(mut good?)
              (groups/valid? (subslice parameters 0 fixed) descriptors)]
        (for ty parameters
          (when (not (or (types/integer? (cast i32 ty))
                         (types/floating? (cast i32 ty))
                         (types/short-vector? (cast i32 ty) 8)))
            (set! good? false)))
        (for group descriptors
          (when good?
            (let [end (+ (.first group) (.count group))]
              (if (> (cast i64 end) (len parameters))
                  (set! good? false)
                  (let [ty (get parameters (cast i64 (.first group)))
                        (mut j) (: 0 i32)]
                    (when (not (groups/members? group ty)) (set! good? false))
                    (while (< j (.count group))
                      (when (!= (get parameters (cast i64 (+ (.first group) j)))
                                ty)
                        (set! good? false))
                      (set! j (+ j 1))))))))
        good?)))

;;; Group members are classified/coerced scalar pieces, not independent source
;;; arguments. A group exhausts its bank when it cannot fit there in full.
(defn plan-result [(parameters (slice u8))
                   (fixed i64)
                   (variadic? bool)
                   (descriptors (slice groups/Group))
                   (result-spec results/Spec)
                   (allocator (dyn Allocator))]
  (-> (Result Layout (slice u8)))
  (if (or (not (validate parameters fixed variadic? descriptors))
          (not (results/valid? 0 parameters result-spec))
          (and (!= (.kind result-spec) 0) (< fixed 1)))
      (Err "invalid scalar or grouped ABI arguments")
      (let [(mut result)
              (Layout :parts (ArrayList::new [Part] allocator) :stack 0)
            (mut gp) (: 0 i32)
            (mut fp) (: 0 i32)
            (mut i) (: 0 i64)
            (mut next-group) (: 0 i64)
            (mut error) ""]
        (when (!= (.kind result-spec) 0)
          (push! (mut (.parts result))
                 (Part
                   :register (if (= (.kind result-spec) 2) 8 (: -2 i32))
                   :offset -1
                   :size 8
                   :promote? false))
          (set! i 1))
        (while (and (= error "") (< i (len parameters)))
          (let [ty (get parameters i)
                width (types/size (cast i32 ty) 8)
                floating? (registers/simd-type? (cast i32 ty))
                unnamed? (and variadic? (>= i fixed))
                grouped?
                  (and (< next-group (len descriptors))
                       (= (cast i64 (.first (get descriptors next-group))) i))
                group
                  (if grouped?
                      (get descriptors next-group)
                      (groups/Group
                        :first (cast i32 i)
                        :count 1
                        :alignment width))
                count (.count group)
                available (if floating? fp gp)
                register
                  (if (or unnamed? (> (+ available count) 8))
                      (: -1 i32)
                      (+ available (if floating? 32 0)))
                size
                  (if (and unnamed? (not grouped?) (< width 8)) (: 8 i32) width)
                stack-alignment
                  (if unnamed? (: 8 i64) (cast i64 (.alignment group)))]
            (when (< register 0)
              (match (alignment/up (.stack result) stack-alignment)
                (Err [message] (set! error message))
                (Ok [offset] (set! (.stack result) offset))))
            (let [(mut j) (: 0 i32)]
              (while (< j count)
                (push! (mut (.parts result))
                       (Part
                         :register (if (< register 0) (: -1 i32) (+ register j))
                         :offset
                           (if (< register 0)
                               (+ (.stack result)
                                  (* (cast i64 j) (cast i64 size)))
                               -1)
                         :size size
                         :promote? (and unnamed? (not grouped?) (= ty 13))))
                (set! j (+ j 1))))
            (if (< register 0)
                (do
                  (set! (.stack result)
                        (+ (.stack result) (* (cast i64 count) (cast i64 size))))
                  (when unnamed?
                    (match (alignment/up (.stack result) 8)
                      (Err [message] (set! error message))
                      (Ok [offset] (set! (.stack result) offset))))
                  (when (not unnamed?) (if floating? (set! fp 8) (set! gp 8))))
                (if floating? (set! fp (+ fp count)) (set! gp (+ gp count))))
            (set! i (+ i (cast i64 count)))
            (when grouped? (set! next-group (+ next-group 1)))))
        (if (= error "") (Ok result) (do (release! (mut result)) (Err error))))))

(defn plan [(parameters (slice u8))
            (fixed i64)
            (variadic? bool)
            (descriptors (slice groups/Group))
            (allocator (dyn Allocator))]
  (-> (Result Layout (slice u8)))
  (plan-result parameters
               fixed
               variadic?
               descriptors
               (results/ordinary)
               allocator))
