;;; Typed GPR/SIMD memory access with a direct encoding or an explicit address.
(module stogir.a64.frame-memory)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.frame-address" :as frame)
(import "stogir.a64.registers" :as registers)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn valid? [(size i32) (reg i32) (base i32) (offset i64)] (-> bool)
  (and (>= reg 0)
       (< reg 64)
       (>= base 0)
       (<= base 31)
       (>= offset 0)
       (if (registers/simd? reg)
           (or (= size 4) (= size 8) (= size 16))
           (or (= size 1) (= size 2) (= size 4) (= size 8)))))

(defn word [(load? bool)
            (size i32)
            (reg i32)
            (base i32)
            (offset i64)
            (signed? bool)] (-> (Result u32 (slice u8)))
  (if (not (valid? size reg base offset))
      (Err "invalid scalar memory access")
      (if (registers/simd? reg)
          (encode/floating-load-store load?
                                      size
                                      (registers/physical reg)
                                      base
                                      offset)
          (if (and load? signed? (< size 4))
              (encode/signed-load false size reg base offset)
              (encode/load-store load? size reg base offset)))))

;;; Scratch is a caller-owned GPR. Loads may target it; stores must preserve
;;; their source. The fallback instruction is validated before emitting an address.
;;; MOV/ADD and the memory operation all preserve NZCV.
(defn access! [(output (mut (ArrayList u8)))
               (load? bool)
               (size i32)
               (reg i32)
               (base i32)
               (offset i64)
               (signed? bool)
               (scratch i32)]
  (-> (Result i32 (slice u8)))
  (if (or (not (valid? size reg base offset))
          (< scratch 0)
          (> scratch 30)
          (= scratch base))
      (Err "invalid scalar memory access or address scratch")
      (match (word load? size reg base offset signed?)
        (Ok [instruction] (bytes/append32! (mut output) instruction) (Ok 4))
        (Err [_]
             (if (and (not load?) (= reg scratch))
                 (Err "memory address scratch aliases stored value")
                 (match (word load? size reg scratch 0 signed?)
                   (Err [message] (Err message))
                   (Ok [instruction]
                       (match (frame/address! (mut output) scratch base offset)
                         (Err [message] (Err message))
                         (Ok [count]
                             (bytes/append32! (mut output) instruction)
                             (Ok (+ count 4)))))))))))
