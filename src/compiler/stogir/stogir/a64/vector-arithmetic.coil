;;; Complete D/Q arithmetic emission, with typed unary and binary operands.
(module stogir.a64.vector-arithmetic)
(import "stogir.vector-arithmetic" :as vector)
(import "stogir.types" :as types)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.allocation" :as allocation)
(import "stogir.locations" :as loc)
(import "stogir.a64.code" :as code)
(import "stogir.a64.value" :as value)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.simd-lanes" :as lanes)
(import "stogir.a64.vector-unary" :as unary)
(import "stogir.a64.vector-shift" :as shift)
(import "stogir.a64.vector-extrema" :as extrema)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn lane-expanded? [(opcode i32) (ty i32)] (-> bool)
  (and (types/integer? (types/base-type ty))
       (or (= opcode 29)
           (= opcode 30)
           (and (= opcode 28) (= (types/scalar-size (types/base-type ty) 8) 8)))))

(defn lane-extract [(signed? bool) (element i32) (lane i32) (rd i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (lanes/lane-extract signed? element lane rd rn))

(defn lane-insert [(element i32) (lane i32) (rd i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (lanes/lane-insert element lane rd rn))

(defn word! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (word (Result u32 (slice u8)))] (-> void)
  (match word
    (Err [message] (set! error message))
    (Ok [bits] (bytes/append32! (mut out) bits))))

;;; Only x16/x17 are used. MOD re-extracts its original dividend after quotient
;;; multiplication, so neither x30 nor another allocated register is clobbered.
;;; Insert only after both lane reads; every SIMD source/destination alias is legal.
(defn integer-sequence! [(output (mut (ArrayList u8)))
                         (opcode i32)
                         (ty i32)
                         (rd i32)
                         (rn i32)
                         (rm i32)]
  (-> (Result i32 (slice u8)))
  (if (or (or (vector/extrema? opcode)
              (vector/shift? opcode)
              (vector/unary? opcode)
              (not (vector/valid-type? opcode ty)))
          (not (types/short-vector? ty 8))
          (not (lane-expanded? opcode ty))
          (< rd 0)
          (> rd 31)
          (< rn 0)
          (> rn 31)
          (< rm 0)
          (> rm 31))
      (Err "unsupported expanded integer vector operation")
      (let [(mut temporary) (ArrayList::new [u8] (.alc output))
            base (types/base-type ty)
            element (types/scalar-size base 8)
            signed? (types/signed? base)
            wide? (= element 8)
            (mut lane) (: 0 i32)
            (mut error) ""]
        (while (< lane (types/lanes ty))
          (word! (mut temporary)
                 (mut error)
                 (lane-extract signed? element lane 16 rn))
          (word! (mut temporary)
                 (mut error)
                 (lane-extract signed? element lane 17 rm))
          (word! (mut temporary)
                 (mut error)
                 (if (= opcode 28)
                     (encode/multiply wide? 16 16 17)
                     (encode/divide wide? signed? 16 16 17)))
          (when (= opcode 30)
            (word! (mut temporary) (mut error) (encode/multiply wide? 16 16 17))
            (word! (mut temporary)
                   (mut error)
                   (lane-extract signed? element lane 17 rn))
            (word! (mut temporary)
                   (mut error)
                   (encode/add-sub wide? true false 16 17 16)))
          (word! (mut temporary) (mut error) (lane-insert element lane rd 16))
          (set! lane (+ lane 1)))
        (let [count (cast i32 (len temporary))]
          (when (= error "")
            (extend! (mut output) (.data temporary) (len temporary)))
          (free! (mut temporary))
          (if (= error "") (Ok count) (Err error))))))

(defn instruction [(opcode i32) (ty i32) (rd i32) (rn i32) (rm i32)]
  (-> (Result u32 (slice u8)))
  (if (or (or (vector/extrema? opcode)
              (vector/shift? opcode)
              (vector/unary? opcode)
              (not (vector/valid-type? opcode ty)))
          (not (types/short-vector? ty 8))
          (lane-expanded? opcode ty)
          (< rd 0)
          (> rd 31)
          (< rn 0)
          (> rn 31)
          (< rm 0)
          (> rm 31))
      (Err "unsupported AArch64 vector binary shape or registers")
      (let [base (types/base-type ty)
            width (types/size ty 8)
            element (types/scalar-size base 8)
            q (if (= width 16) (: 0x40000000 u32) (: 0 u32))
            size
              (if (= element 1)
                  (: 0 u32)
                  (if (= element 2) 1 (if (= element 4) 2 3)))
            fields (| (cast u32 rd) (<< (cast u32 rn) 5) (<< (cast u32 rm) 16))]
        (if (and (types/floating? base) (= width 8) (= element 8))
            (encode/floating-binary true opcode rd rn rm)
            (Ok (| fields
                   (if (or (= opcode 46) (= opcode 47) (= opcode 48))
                       (| q
                          (if (= opcode 46)
                              (: 0x0EA01C00 u32)
                              (if (= opcode 47)
                                  (: 0x0E201C00 u32)
                                  (: 0x2E201C00 u32))))
                       (if (types/floating? base)
                           (| q
                              (if (= element 8) (: 0x00400000 u32) (: 0 u32))
                              (match opcode
                                (26 (: 0x0E20D400 u32))
                                (27 (: 0x0EA0D400 u32))
                                (28 (: 0x2E20DC00 u32))
                                (_ (: 0x2E20FC00 u32))))
                           (if (= opcode 28)
                               (| q (<< size 22) (: 0x0E209C00 u32))
                               (if (and (= width 8) (= element 8))
                                   (if (= opcode 26)
                                       (: 0x5EE08400 u32)
                                       (: 0x7EE08400 u32))
                                   (| q
                                      (<< size 22)
                                      (if (= opcode 26)
                                          (: 0x0E208400 u32)
                                          (: 0x2E208400 u32)))))))))))))

(defn emit-operation! [(output (mut code/Buffer))
                       (graph g/Graph)
                       (parts (ArrayList allocation/Part))
                       (reference i32)
                       (position i64)
                       (opcode i32)
                       (left-reference i32)
                       (right-reference i32)]
  (-> (Result i32 (slice u8)))
  (match (vector/validate graph reference)
    (Err [message] (Err message))
    (Ok [ty]
        (let [(mut temporary) (code/create (.alc (.text output)))
              (mut error) ""
              (mut destination) (: -1 i32)
              (mut left) (: -1 i32)
              (mut right) (: -1 i32)
              (mut scalar-count?) false]
          (match (loc/lookup parts reference (+ position 1))
            (Err [message] (set! error message))
            (Ok [location]
                (if (and (= (.kind location) 0)
                         (registers/allocatable? ty
                                                 (cast i32 (.value location))))
                    (set! destination (- (cast i32 (.value location)) 32))
                    (set! error "vector result requires a SIMD register"))))
          (match (value/register! (mut temporary)
                                  graph
                                  parts
                                  left-reference
                                  position
                                  16
                                  62)
            (Err [message] (set! error message))
            (Ok [reg] (set! left (- reg 32))))
          (when (not (vector/unary? opcode))
            (match (value/register! (mut temporary)
                                    graph
                                    parts
                                    right-reference
                                    position
                                    17
                                    63)
              (Err [message] (set! error message))
              (Ok [reg]
                  (set! scalar-count? (< reg 32))
                  (set! right (if scalar-count? reg (- reg 32))))))
          (when (= error "")
            (if (vector/unary? opcode)
                (match (unary/emit-registers! (mut (.text temporary))
                                              opcode
                                              ty
                                              destination
                                              left)
                  (Err [message] (set! error message))
                  (Ok [_] 0))
                (if (vector/shift? opcode)
                    (match (shift/emit-registers! (mut (.text temporary))
                                                  opcode
                                                  ty
                                                  destination
                                                  left
                                                  right
                                                  scalar-count?)
                      (Err [message] (set! error message))
                      (Ok [_] 0))
                    (if (vector/extrema? opcode)
                        (match (extrema/emit-registers! (mut (.text temporary))
                                                        opcode
                                                        ty
                                                        destination
                                                        left
                                                        right)
                          (Err [message] (set! error message))
                          (Ok [_] 0))
                        (if (lane-expanded? opcode ty)
                            (match (integer-sequence! (mut (.text temporary))
                                                      opcode
                                                      ty
                                                      destination
                                                      left
                                                      right)
                              (Err [message] (set! error message))
                              (Ok [_] 0))
                            (match (instruction opcode
                                                ty
                                                destination
                                                left
                                                right)
                              (Err [message] (set! error message))
                              (Ok [word]
                                  (bytes/append32! (mut (.text temporary)) word))))))))
          (let [count (cast i32 (len (.text temporary)))]
            (when (and (= error "") (not (code/append! (mut output) temporary)))
              (set! error "invalid vector arithmetic code references"))
            (code/release! (mut temporary))
            (if (= error "") (Ok count) (Err error)))))))

;;; The matching plan has already proved integer SPLAT(2) multiplication.
(defn emit-doubled! [(output (mut code/Buffer))
                     (graph g/Graph)
                     (parts (ArrayList allocation/Part))
                     (reference i32)
                     (position i64)
                     (source i32)]
  (-> (Result i32 (slice u8)))
  (emit-operation! (mut output) graph parts reference position 26 source source))

(defn emit! [(output (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList allocation/Part))
             (reference i32)
             (position i64)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "vector arithmetic node missing"))
    (Some [node]
          (emit-operation! (mut output)
                           graph
                           parts
                           reference
                           position
                           (cast i32 (n/opcode node))
                           (.op1 node)
                           (.op2 node)))))
