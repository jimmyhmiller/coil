;;; Fixed-frame addresses and stack adjustments, preserving condition flags.
(module stogir.a64.frame-address)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.constants" :as constants)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

;;; Logical fixed-frame offsets are measured from SP after prologue allocation.
;;; An anchored frame uses x29 at logical offset bias, above outgoing arguments.
(defstruct Base [(reg i32) (bias i64)])

(defn stack-base [] (-> Base)
  (Base :reg 31 :bias 0))

(defn valid-base? [(base Base)] (-> bool)
  (or (and (= (.reg base) 31) (= (.bias base) 0))
      (and (= (.reg base) 29) (>= (.bias base) 0) (= (% (.bias base) 16) 0))))

(defn alignment-shift [(alignment i64)] (-> (Result i32 (slice u8)))
  (if (or (< alignment 16) (!= (& alignment (- alignment 1)) 0))
      (Err "invalid frame alignment")
      (let [(mut value) alignment
            (mut bits) (: 0 i32)]
        (while (> value 1) (set! value (/ value 2)) (set! bits (+ bits 1)))
        (Ok bits))))

;;; x16 may hold original entry SP. Only x17 is clobbered by realignment.
(defn align-stack! [(output (mut (ArrayList u8))) (alignment i64)]
  (-> (Result i32 (slice u8)))
  (match (alignment-shift alignment)
    (Err [message] (Err message))
    (Ok [bits]
        (if (= alignment 16)
            (Ok 0)
            (match (encode/add-sub-immediate true false false 17 31 0)
              (Err [message] (Err message))
              (Ok [capture]
                  (match (encode/clear-low-bits 17 17 bits)
                    (Err [message] (Err message))
                    (Ok [mask]
                        (match (encode/add-sub-immediate true
                                                         false
                                                         false
                                                         31
                                                         17
                                                         0)
                          (Err [message] (Err message))
                          (Ok [install]
                              (bytes/append32! (mut output) capture)
                              (bytes/append32! (mut output) mask)
                              (bytes/append32! (mut output) install)
                              (Ok 12)))))))))))

(defn offset [(base Base) (logical i64)] (-> (Result i64 (slice u8)))
  (if (or (not (valid-base? base)) (< logical (.bias base)))
      (Err "fixed storage precedes frame anchor or has invalid base")
      (Ok (- logical (.bias base)))))

;;; Restore the fixed-frame SP before reading saved frame registers. x16 is
;;; reserved, and the return value registers and condition flags are preserved.
(defn restore! [(output (mut (ArrayList u8))) (base Base)]
  (-> (Result i32 (slice u8)))
  (if (not (valid-base? base))
      (Err "invalid frame restoration base")
      (if (= (.reg base) 31)
          (Ok 0)
          (match (encode/add-sub-immediate true true false 31 29 (.bias base))
            (Ok [word] (bytes/append32! (mut output) word) (Ok 4))
            (Err [_]
                 (match (constants/emit! (mut output)
                                         true
                                         16
                                         (cast u64 (.bias base)))
                   (Err [message] (Err message))
                   (Ok [words]
                       (match (encode/add-sub-extended true 31 29 16)
                         (Err [message] (Err message))
                         (Ok [word]
                             (bytes/append32! (mut output) word)
                             (Ok (* (+ words 1) 4)))))))))))

;;; Destination doubles as the large-offset temporary, so it must differ from
;;; the base. Both SP and general registers are valid bases; SP is not a result.
(defn address! [(output (mut (ArrayList u8)))
                (destination i32)
                (base i32)
                (offset i64)] (-> (Result i32 (slice u8)))
  (if (or (< destination 0)
          (> destination 30)
          (< base 0)
          (> base 31)
          (= destination base)
          (< offset 0))
      (Err "invalid frame address")
      (match (encode/add-sub-immediate true false false destination base offset)
        (Ok [word]
            (bytes/append32! (mut output) word)
            (Ok 4))
        (Err [_]
             (match (constants/emit! (mut output)
                                     true
                                     destination
                                     (cast u64 offset))
               (Err [message] (Err message))
               (Ok [words]
                   (match (encode/add-sub-extended false
                                                   destination
                                                   base
                                                   destination)
                     (Err [message] (Err message))
                     (Ok [word]
                         (bytes/append32! (mut output) word)
                         (Ok (* (+ words 1) 4))))))))))

;;; Scratch is explicitly owned by the caller; adjustment never sets NZCV.
;;; Whole-frame adjustments preserve the ABI's sixteen-byte SP alignment.
(defn adjust! [(output (mut (ArrayList u8)))
               (subtract bool)
               (size i64)
               (scratch i32)] (-> (Result i32 (slice u8)))
  (if (or (< size 0) (!= (% size 16) 0) (< scratch 0) (> scratch 30))
      (Err "invalid aligned stack adjustment")
      (if (= size 0)
          (Ok 0)
          (match (encode/add-sub-immediate true subtract false 31 31 size)
            (Ok [word]
                (bytes/append32! (mut output) word)
                (Ok 4))
            (Err [_]
                 (match (constants/emit! (mut output)
                                         true
                                         scratch
                                         (cast u64 size))
                   (Err [message] (Err message))
                   (Ok [words]
                       (match (encode/add-sub-extended subtract 31 31 scratch)
                         (Err [message] (Err message))
                         (Ok [word]
                             (bytes/append32! (mut output) word)
                             (Ok (* (+ words 1) 4)))))))))))
