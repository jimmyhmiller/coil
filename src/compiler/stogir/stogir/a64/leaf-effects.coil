;;; Conservative effects of closed, relocation-free scalar AArch64 leaf text.
(module stogir.a64.leaf-effects)
(import "stogir.a64.code" :as code)
(import "stogir.alignment" :as alignment)
(import "coil.result" :use [Option Some None])

;;; A result is an instruction write set, not a binding or calling-convention
;;; certificate. Caller marshalling and immutable private ownership are separate.
;;; x31 (SP/ZR) is outside this GP set. Modifying x30 declines so RET keeps the
;;; incoming link. Unsupported instructions, including SIMD, always decline.
(defn destination [(word u32)] (-> (Option u64))
  (let [rd (& word 31)]
    (if (= rd 30) (None)
        (Some (if (= rd 31) (: 0 u64) (<< (: 1 u64) (cast u64 rd)))))))

(defn memory-operation? [(word u32)] (-> bool)
  (let [size (>> word 30) operation (& (>> word 22) 3)]
    (or (< operation 2) (and (= operation 2) (< size 3))
        (and (= operation 3) (< size 2)))))

;;; DecodeBitMasks' element-size and all-ones exclusions for logical immediates.
(defn logical-immediate? [(word u32)] (-> bool)
  (let [n (& (>> word 22) 1) imms (& (>> word 10) 63)
        (mut length-bits) (| (<< n 6) (^ imms 63))
        (mut element) (: 1 u32)]
    (while (> length-bits 1)
      (set! length-bits (>> length-bits 1))
      (set! element (* element 2)))
    (and (or (!= (& word 0x80000000) 0) (= n 0))
         (> element 1) (!= (& imms (- element 1)) (- element 1)))))

;;; No control instructions are accepted here. Each accepted encoding has one
;;; GP destination at bits0..4, or is a non-writeback store. Reserved variants
;;; and other instruction classes do not inherit effects from a broad prefix.
(defn instruction [(word u32)] (-> (Option u64))
  (let [wide (!= (& word 0x80000000) 0)
        shift (& (>> word 10) 63)
        (mut writes) false
        (mut store) false]
    (cond
      (= (& word 0x1F800000) 0x11000000)
        (set! writes true)
      (= (& word 0x1F200000) 0x0B000000)
        (set! writes (and (!= (& (>> word 22) 3) 3) (or wide (< shift 32))))
      (= (& word 0xBFE0FC00) 0x8B206000)
        (set! writes true)
      (= (& word 0x1F000000) 0x0A000000)
        (set! writes (or wide (< shift 32)))
      (= (& word 0x1F800000) 0x12000000)
        (set! writes (logical-immediate? word))
      (= (& word 0x1F800000) 0x12800000)
        (set! writes (and (!= (& (>> word 29) 3) 1)
                         (or wide (< (& (>> word 21) 3) 2))))
      (= (& word 0x1F800000) 0x13000000)
        (set! writes (and (!= (& (>> word 29) 3) 3)
                         (= wide (!= (& word 0x00400000) 0))
                         (or wide (and (< shift 32) (= (& word 0x00200000) 0)))))
      (= (& word 0x3FE00800) 0x1A800000)
        (set! writes true)
      (= (& word 0x7FE00000) 0x1B000000)
        (set! writes true)
      (or (= (& word 0x7FE0FC00) 0x1AC00800)
          (= (& word 0x7FE0FC00) 0x1AC00C00)
          (= (& word 0x7FE0FC00) 0x1AC02000)
          (= (& word 0x7FE0FC00) 0x1AC02400)
          (= (& word 0x7FE0FC00) 0x1AC02800)
          (= (& word 0x7FE0FC00) 0x1AC02C00))
        (set! writes true)
      (or (= (& word 0x7FFFFC00) 0x5AC00000)
          (= (& word 0x7FFFFC00) 0x5AC00400)
          (= (& word 0x7FFFFC00) 0x5AC00800)
          (= (& word 0x7FFFFC00) 0x5AC01000)
          (and wide (= (& word 0x7FFFFC00) 0x5AC00C00)))
        (set! writes true)
      (or (= (& word 0x3F000000) 0x39000000)
          (= (& word 0x3F200C00) 0x38000000)
          (and (= (& word 0x3F200C00) 0x38200800)
               (!= (& word 0x00004000) 0)))
        (when (memory-operation? word)
          (if (= (& word 0x00C00000) 0)
              (set! store true) (set! writes true)))
      :else 0)
    (if writes (destination word) (if store (Some (: 0 u64)) (None)))))

(defn read-word [(text (slice u8)) (offset i64)] (-> u32)
  (| (cast u32 (get text offset))
     (<< (cast u32 (get text (+ offset 1))) 8)
     (<< (cast u32 (get text (+ offset 2))) 16)
     (<< (cast u32 (get text (+ offset 3))) 24)))

(defn displacement [(bits u32) (width i32)] (-> i64)
  (let [sign (<< (: 1 i64) (cast i64 (- width 1)))
        value (cast i64 bits)]
    (* (- (^ value sign) sign) 4)))

;;; Every instruction is checked, including unreachable text. Branch targets
;;; must stay at instruction boundaries in this exact body. Ordinary instructions
;;; and conditional branches require an in-body fallthrough. No data is decoded.
(defn text [(bytes (slice u8))] (-> (Option u64))
  (let [size (len bytes) (mut offset) 0 (mut valid) true
        (mut returned) false (mut writes) (: 0 u64)]
    (when (or (= size 0) (!= (% size 4) 0)) (set! valid false))
    (while (and valid (< offset size))
      (let [word (read-word bytes offset) (mut fallthrough) true
            (mut branch) false (mut delta) (: 0 i64)]
        (cond
          (= word 0xD65F03C0)
            (do (set! returned true) (set! fallthrough false))
          (= (& word 0xFC000000) 0x14000000)
            (do (set! branch true) (set! fallthrough false)
                (set! delta (displacement (& word 0x03FFFFFF) 26)))
          (= (& word 0xFF000010) 0x54000000)
            (do (set! branch true)
                (set! delta (displacement (& (>> word 5) 0x7FFFF) 19)))
          (= (& word 0x7E000000) 0x34000000)
            (do (set! branch true)
                (set! delta (displacement (& (>> word 5) 0x7FFFF) 19)))
          (= (& word 0x7E000000) 0x36000000)
            (do (set! branch true)
                (set! delta (displacement (& (>> word 5) 0x3FFF) 14)))
          (= word 0xD503201F) 0
          :else
            (match (instruction word)
              (None [] (set! valid false))
              (Some [effect] (set! writes (| writes effect)))))
        (when branch
          (let [target (+ offset delta)]
            (unless (and (>= target 0) (< target size) (= (% target 4) 0))
              (set! valid false))))
        (when (and fallthrough (>= (+ offset 4) size)) (set! valid false)))
      (set! offset (+ offset 4)))
    (if (and valid returned) (Some writes) (None))))

(defn buffer [(body code/Buffer)] (-> (Option u64))
  (if (or (> (len (.references body)) 0) (> (len (.text-data body)) 0)
          (< (.alignment body) 4) (not (alignment/valid? (.alignment body))))
      (None) (text (slice (.text body)))))
