; Unary sequences adapted from dstogov/ir ir_aarch64.dasc, 92171d0. See NOTICE.
(module stogir.a64.unary)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.integer-unary" :as policy)
(import "stogir.allocation" :as a)
(import "stogir.locations" :as locations)
(import "stogir.a64.code" :as code)
(import "stogir.a64.emit" :as emit)
(import "stogir.a64.encode" :as encode)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

;;; v31 is the reserved SIMD scratch. Current allocation accepts GPR values
;;; only; live floating/vector values must not be enabled without reserving it.
(defn simd-scratch [] (-> i32)
  31)

(defn operation? [(opcode i32)] (-> bool)
  (policy/operation? opcode))

(defn width [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "unary instruction missing"))
    (Some [node]
          (if (or (<= reference 0)
                  (not (policy/valid-type? (cast i32 (n/opcode node))
                                           (cast i32 (n/type-id node)))))
              (Err "invalid unary opcode or type")
              (match (g/lookup graph (.op1 node))
                (None [] (Err "unary source missing"))
                (Some [source]
                      (if (!= (n/type-id source) (n/type-id node))
                          (Err "unary source type mismatch")
                          (Ok (* 8
                                 (types/scalar-size (cast i32 (n/type-id node))
                                                    8))))))))))

(defn word! [(output (mut code/Buffer))
             (error (ptr (slice u8)))
             (instruction (Result u32 (slice u8)))] (-> void)
  (when (= (load error) "")
    (match instruction
      (Err [message] (store! error message))
      (Ok [word] (bytes/append32! (mut (.text output)) word)))))

;;; Atomic at the outer buffer boundary, including symbolic ADDR operands.
(defn emit! [(output (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList a/Part))
             (reference i32)
             (position i64)
             (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (match (width graph reference)
    (Err [message] (Err message))
    (Ok [bits]
        (let [(mut temporary) (code/create allocator)
              (mut error) ""
              node (get (.instructions graph) (cast i64 reference))
              opcode (cast i32 (n/opcode node))
              ty (cast i32 (n/type-id node))
              wide (= bits 64)
              (mut source) (: -1 i32)
              (mut destination) (: -1 i32)]
          (match (emit/operand-register! (mut temporary)
                                         graph
                                         parts
                                         (.op1 node)
                                         position
                                         wide
                                         16)
            (Err [message] (set! error message))
            (Ok [register] (set! source register)))
          (match (locations/lookup parts reference (+ position 1))
            (Err [message] (set! error message))
            (Ok [location]
                (if (!= (.kind location) 0)
                    (set! error "unary result requires register")
                    (set! destination (cast i32 (.value location))))))
          (when (= error "")
            ;; Narrow sources can come from unsigned constants, signed loads or
            ;; phis. Normalize locally before sign-sensitive ABS and bit counts.
            (when (and (< bits 32) (!= ty 1))
              (word! (mut temporary)
                     (mut error)
                     (encode/extend false (= opcode 32) bits 16 source))
              (set! source 16))
            (match opcode
              (31 (word! (mut temporary)
                         (mut error)
                         (encode/add-sub wide true false destination 31 source)))
              (32 (do
                    (word! (mut temporary)
                           (mut error)
                           (encode/add-sub wide true true 31 source 31))
                    (word! (mut temporary)
                           (mut error)
                           (encode/conditional-negate wide
                                                      destination
                                                      source
                                                      11))))
              (45 (if (= ty 1)
                      (do
                        (word! (mut temporary)
                               (mut error)
                               (encode/add-sub false true true 31 source 31))
                        (word! (mut temporary)
                               (mut error)
                               (encode/conditional-set false destination 0)))
                      (word! (mut temporary)
                             (mut error)
                             (encode/invert wide destination source))))
              (54 (word! (mut temporary)
                         (mut error)
                         (encode/unary-bits wide
                                            (if (= bits 16) 1 (if wide 3 2))
                                            destination
                                            source)))
              (55 (do
                    (word! (mut temporary)
                           (mut error)
                           (encode/scalar-transfer wide
                                                   true
                                                   (simd-scratch)
                                                   source))
                    (word! (mut temporary)
                           (mut error)
                           (encode/vector-byte-count false
                                                     (simd-scratch)
                                                     (simd-scratch)))
                    (word! (mut temporary)
                           (mut error)
                           (encode/vector-byte-count true
                                                     (simd-scratch)
                                                     (simd-scratch)))
                    (word! (mut temporary)
                           (mut error)
                           (encode/scalar-transfer wide
                                                   false
                                                   destination
                                                   (simd-scratch)))))
              (56 (do
                    (word! (mut temporary)
                           (mut error)
                           (encode/unary-bits wide 4 destination source))
                    (when (< bits 32)
                      (word! (mut temporary)
                             (mut error)
                             (encode/add-sub-immediate false
                                                       true
                                                       false
                                                       destination
                                                       destination
                                                       (cast i64 (- 32 bits)))))))
              (57 (do
                    (word! (mut temporary)
                           (mut error)
                           (encode/unary-bits wide 0 destination source))
                    (word! (mut temporary)
                           (mut error)
                           (encode/unary-bits wide 4 destination destination))))
              (_ (set! error "unsupported unary operation")))
            (when (and (< bits 32) (!= ty 1))
              (word! (mut temporary)
                     (mut error)
                     (encode/extend false
                                    (types/signed? ty)
                                    bits
                                    destination
                                    destination))))
          (let [size (cast i32 (len (.text temporary)))]
            (when (and (= error "") (not (code/append! (mut output) temporary)))
              (set! error "invalid unary code references"))
            (code/release! (mut temporary))
            (if (= error "") (Ok size) (Err error)))))))
