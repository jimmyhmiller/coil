; Overflow conditions/sequences adapted from dstogov/ir ir_aarch64.dasc, 92171d0. See NOTICE.
(module stogir.a64.checked)

(export operation? width condition arithmetic! emit!)

(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.checked" :as checked)
(import "stogir.allocation" :as a)
(import "stogir.locations" :as locations)
(import "stogir.a64.code" :as code)
(import "stogir.a64.emit" :as emit)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.constants" :as constants)
(import "stogir.a64.transfers" :as transfers)
(import "stogir.a64.call-abi" :as abi)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn operation? [(opcode i32)] (-> bool)
  (or (checked/operation? opcode) (= opcode 44)))

(defn width [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "checked instruction missing"))
    (Some [node]
          (match (if (= (n/opcode node) 44)
                     (checked/validate-projection graph reference)
                     (checked/validate graph reference))
            (Err [message] (Err message))
            (Ok [ty]
                (Ok (if (= (n/opcode node) 44) 8 (* 8 (types/scalar-size ty 8)))))))))

(defn condition [(opcode i32) (ty i32)] (-> i32)
  (if (or (= opcode 43) (< (types/scalar-size ty 8) 4))
      1
      (if (types/signed? ty) 6 (if (= opcode 41) 2 3))))

;;; The result register may reuse either input. Compute high products before
;;; overwriting inputs, and preserve original virtual registers outside scratch.
(defn arithmetic-body! [(out (mut (ArrayList u8)))
                        (opcode i32)
                        (ty i32)
                        (rd i32)
                        (rn i32)
                        (rm i32)
                        (flags? bool)] (-> (Result i32 (slice u8)))
  (let [bits (* 8 (types/scalar-size ty 8))
        wide (= bits 64)
        signed? (types/signed? ty)
        (mut left) rn
        (mut right) rm
        (mut error) ""
        begin (len out)]
    (when (< bits 32)
      (emit/word! (mut out)
                  (mut error)
                  (encode/extend false signed? bits 16 rn))
      (emit/word! (mut out)
                  (mut error)
                  (encode/extend false signed? bits 17 rm))
      (set! left 16)
      (set! right 17))
    (if (not flags?)
        (emit/word! (mut out)
                    (mut error)
                    (if (= opcode 43)
                        (encode/multiply wide rd left right)
                        (encode/add-sub wide (= opcode 42) false rd left right)))
        (if (and (>= bits 32) (!= opcode 43))
            (emit/word! (mut out)
                        (mut error)
                        (encode/add-sub wide (= opcode 42) true rd left right))
            (if (< bits 32)
                (do
                  (emit/word! (mut out)
                              (mut error)
                              (if (= opcode 43)
                                  (encode/multiply false rd left right)
                                  (encode/add-sub false
                                                  (= opcode 42)
                                                  false
                                                  rd
                                                  left
                                                  right)))
                  (emit/word! (mut out)
                              (mut error)
                              (encode/extend false signed? bits 16 rd))
                  (emit/word! (mut out)
                              (mut error)
                              (encode/add-sub false true true 31 rd 16)))
                (if (= bits 32)
                    (do
                      (emit/word! (mut out)
                                  (mut error)
                                  (encode/multiply-long signed? rd left right))
                      (emit/word! (mut out)
                                  (mut error)
                                  (encode/extend true signed? 32 16 rd))
                      (emit/word! (mut out)
                                  (mut error)
                                  (encode/add-sub true true true 31 rd 16))
                      (emit/word! (mut out)
                                  (mut error)
                                  (encode/extend false false 32 rd rd)))
                    (let [high
                            (if (and (!= left 16) (!= right 16))
                                (: 16 i32)
                                (if (and (!= left 17) (!= right 17))
                                    (: 17 i32)
                                    (if (and (!= rd left) (!= rd right))
                                        rd
                                        (: -1 i32))))
                          low (if (= high rd) (: 16 i32) rd)]
                      (if (< high 0)
                          (set! error
                                "checked multiply requires independent high-half register")
                          (do
                            (emit/word! (mut out)
                                        (mut error)
                                        (encode/multiply-high signed?
                                                              high
                                                              left
                                                              right))
                            (emit/word! (mut out)
                                        (mut error)
                                        (encode/multiply true low left right))
                            (if signed?
                                (let [sign
                                        (if (= high 17) (: 16 i32) (: 17 i32))]
                                  (emit/word! (mut out)
                                              (mut error)
                                              (encode/arithmetic-shift-immediate true
                                                                                 sign
                                                                                 low
                                                                                 63))
                                  (emit/word! (mut out)
                                              (mut error)
                                              (encode/add-sub true
                                                              true
                                                              true
                                                              31
                                                              high
                                                              sign)))
                                (emit/word! (mut out)
                                            (mut error)
                                            (encode/add-sub true
                                                            true
                                                            true
                                                            31
                                                            high
                                                            31)))
                            (when (!= low rd)
                              (match (transfers/emit! (mut out)
                                                      (locations/Location
                                                        :kind 0
                                                        :value (cast i64 low))
                                                      (locations/Location
                                                        :kind 0
                                                        :value (cast i64 rd))
                                                      8
                                                      17)
                                (Err [message] (set! error message))
                                (Ok [_] 0))))))))))
    (when (= error "")
      (match (abi/normalize! (mut out) (cast u8 ty) rd)
        (Err [message] (set! error message))
        (Ok [_] 0)))
    (if (= error "") (Ok (cast i32 (- (len out) begin))) (Err error))))

;;; Current allocation class is x0..x15, with left/right literals in x16/x17.
(defn arithmetic! [(out (mut (ArrayList u8)))
                   (opcode i32)
                   (ty i32)
                   (rd i32)
                   (rn i32)
                   (rm i32)
                   (flags? bool)] (-> (Result i32 (slice u8)))
  (if (or (not (checked/operation? opcode))
          (not (checked/valid-type? ty))
          (< rd 0)
          (> rd 15)
          (< rn 0)
          (> rn 16)
          (< rm 0)
          (> rm 17)
          (= rm 16))
      (Err "checked arithmetic requires allocated GPRs and reserved literal scratches")
      (arithmetic-body! (mut out) opcode ty rd rn rm flags?)))

;;; Requires a schedule whose checked producers and projections are clustered.
;;; Capture NZCV into an allocated Boolean; later users then need no flags.
(defn emit! [(output (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList a/Part))
             (reference i32)
             (position i64)
             (flags? bool)
             (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (width graph reference)
    (Err [message] (Err message))
    (Ok [bits]
        (let [(mut temporary) (code/create allocator)
              (mut error) ""
              node (get (.instructions graph) (cast i64 reference))
              (mut destination) (: -1 i32)
              (mut left) (: -1 i32)
              (mut right) (: -1 i32)]
          (match (locations/lookup parts reference (+ position 1))
            (Err [message] (set! error message))
            (Ok [location]
                (if (!= (.kind location) 0)
                    (set! error "checked result requires register")
                    (set! destination (cast i32 (.value location))))))
          (if (= (n/opcode node) 44)
              (match (checked/projection graph (.op1 node))
                (Err [message] (set! error message))
                (Ok [ty]
                    (if (= ty 0)
                        (match (constants/emit! (mut (.text temporary))
                                                false
                                                destination
                                                0)
                          (Err [message] (set! error message))
                          (Ok [_] 0))
                        (match (g/lookup graph (.op1 node))
                          (None [] (set! error "overflow producer missing"))
                          (Some [producer]
                                (emit/word! (mut (.text temporary))
                                            (mut error)
                                            (encode/conditional-set false
                                                                    destination
                                                                    (condition (cast i32
                                                                                     (n/opcode producer))
                                                                               ty))))))))
              (do
                (match (emit/operand-register! (mut temporary)
                                               graph
                                               parts
                                               (.op1 node)
                                               position
                                               (= bits 64)
                                               16)
                  (Err [message] (set! error message))
                  (Ok [register] (set! left register)))
                (match (emit/operand-register! (mut temporary)
                                               graph
                                               parts
                                               (.op2 node)
                                               position
                                               (= bits 64)
                                               17)
                  (Err [message] (set! error message))
                  (Ok [register] (set! right register)))
                (when (= error "")
                  (match (arithmetic! (mut (.text temporary))
                                      (cast i32 (n/opcode node))
                                      (cast i32 (n/type-id node))
                                      destination
                                      left
                                      right
                                      flags?)
                    (Err [message] (set! error message))
                    (Ok [_] 0)))))
          (let [size (cast i32 (len (.text temporary)))]
            (when (and (= error "") (not (code/append! (mut output) temporary)))
              (set! error "invalid checked code references"))
            (code/release! (mut temporary))
            (if (= error "") (Ok size) (Err error)))))))
