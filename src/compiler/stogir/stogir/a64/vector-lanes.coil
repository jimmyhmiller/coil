;;; Register-only D/Q lane transport; dynamic indices never address stack memory.
(module stogir.a64.vector-lanes)

(export emit! emit-prepared!)

(import "stogir.vector-lanes" :as vector)
(import "stogir.types" :as types)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.allocation" :as allocation)
(import "stogir.locations" :as loc)
(import "stogir.a64.code" :as code)
(import "stogir.a64.value" :as value)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.constants" :as constants)
(import "stogir.a64.simd-lanes" :as lanes)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn word! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (word (Result u32 (slice u8)))] (-> void)
  (match word
    (Err [message] (set! error message))
    (Ok [bits] (bytes/append32! (mut out) bits))))

(defn constant! [(out (mut (ArrayList u8)))
                 (error (mut (slice u8)))
                 (rd i32)
                 (bits u64)] (-> void)
  (match (constants/emit! (mut out) true rd bits)
    (Err [message] (set! error message))
    (Ok [_] 0)))

(defn scalar-extract! [(out (mut (ArrayList u8)))
                       (error (mut (slice u8)))
                       (scalar-type i32)
                       (element i32)
                       (rd i32)
                       (rn i32)
                       (lane i32)] (-> void)
  (if (types/floating? scalar-type)
      (bytes/append32! (mut out)
                       (| (: 0x5E000400 u32)
                          (cast u32 (- rd 32))
                          (<< (cast u32 (+ (* lane element 2) element)) 16)
                          (<< (cast u32 rn) 5)))
      (word! (mut out)
             (mut error)
             (lanes/lane-extract (types/signed? scalar-type) element lane rd rn))))

(defn splat! [(out (mut (ArrayList u8)))
              (error (mut (slice u8)))
              (width i32)
              (element i32)
              (rd i32)] (-> void)
  (if (and (= width 8) (= element 8))
      (word! (mut out) (mut error) (encode/scalar-transfer true true rd 17))
      (bytes/append32! (mut out)
                       (| (: 0x0E000C00 u32)
                          (if (= width 16) (: 0x40000000 u32) (: 0 u32))
                          (<< (cast u32 element) 16)
                          (<< (: 17 u32) 5)
                          (cast u32 rd)))))

;;; Each byte identifies its element lane; constants avoid per-byte emitter work.
(defn lane-ids [(element i32) (half i32)] (-> u64)
  (match element
    (1 (if (= half 0) (: 0x0706050403020100 u64) 0x0F0E0D0C0B0A0908))
    (2 (if (= half 0) (: 0x0303020201010000 u64) 0x0707060605050404))
    (4 (if (= half 0) (: 0x0101010100000000 u64) 0x0303030302020202))
    (_ (if (= half 0) (: 0 u64) 0x0101010101010101))))

;;; Compare unsigned x16 with the lane count, then scale without changing NZCV.
;;; The caller selects 128 for invalid indices, outside all table bytes/lane ids.
(defn index-flags! [(out (mut (ArrayList u8)))
                    (error (mut (slice u8)))
                    (count i32)
                    (scale i32)] (-> void)
  (word! (mut out)
         (mut error)
         (encode/add-sub-immediate true true true 31 16 (cast i64 count)))
  (when (> scale 0)
    (word! (mut out) (mut error) (encode/logical-shifted true 1 16 31 16 scale))))

;;; Inputs are already captured: dynamic lane in x16, replacement/splat bits in
;;; x17. SIMD data is encoded register 32..62 (v31 is workspace); destination is
;;; allocated in its declared class. Capture occurs before any result alias writes.
;;; lane=-1 is dynamic; nonnegative lanes are checked immediate indices.
(defn emit-prepared! [(output (mut (ArrayList u8)))
                      (opcode i32)
                      (ty i32)
                      (scalar-type i32)
                      (rd i32)
                      (rn i32)
                      (lane i32)]
  (-> (Result i32 (slice u8)))
  (if (or (not (vector/operation? opcode))
          (not (types/short-vector? ty 8))
          (not (vector/compatible? ty scalar-type 8))
          (not (registers/allocatable? (if (= opcode 61) scalar-type ty) rd))
          (if (= opcode 63)
              (or (!= rn -1) (!= lane 0))
              (or (< rn 32) (> rn 62) (< lane -1) (>= lane (types/lanes ty)))))
      (Err "unsupported AArch64 vector lane shape, scalar class or registers")
      (let [(mut temporary) (ArrayList::new [u8] (.alc output))
            (mut error) ""
            width (types/size ty 8)
            element (types/scalar-size (types/base-type ty) 8)
            physical (- rd 32)
            source (- rn 32)
            q (if (= width 16) (: 0x40000000 u32) (: 0 u32))]
        (if (= opcode 63)
            (splat! (mut temporary) (mut error) width element physical)
            (if (= opcode 61)
                (if (>= lane 0)
                    (scalar-extract! (mut temporary)
                                     (mut error)
                                     scalar-type
                                     element
                                     rd
                                     source
                                     lane)
                    (do
                      (index-flags! (mut temporary)
                                    (mut error)
                                    (types/lanes ty)
                                    (if (= element 1)
                                        0
                                        (if (= element 2)
                                            1
                                            (if (= element 4) 2 3))))
                      (constant! (mut temporary) (mut error) 17 128)
                      (word! (mut temporary)
                             (mut error)
                             (encode/conditional-select true 16 16 17 3))
                      (for shift [(: 8 i32) 16 32]
                        (word! (mut temporary)
                               (mut error)
                               (encode/logical-shifted true 1 16 16 16 shift)))
                      (constant! (mut temporary)
                                 (mut error)
                                 17
                                 0x0706050403020100)
                      (word! (mut temporary)
                             (mut error)
                             (encode/add-sub true false false 16 16 17))
                      (word! (mut temporary)
                             (mut error)
                             (encode/scalar-transfer true true 31 16))
                      (bytes/append32! (mut temporary)
                                       (| (: 0x0E000000 u32)
                                          (<< (: 31 u32) 16)
                                          (<< (cast u32 source) 5)
                                          (: 31 u32)))
                      (scalar-extract! (mut temporary)
                                       (mut error)
                                       scalar-type
                                       element
                                       rd
                                       31
                                       0)))
                (do
                  (when (!= rd rn)
                    (word! (mut temporary)
                           (mut error)
                           (encode/simd-move width physical source)))
                  (if (>= lane 0)
                      (word! (mut temporary)
                             (mut error)
                             (lanes/lane-insert element lane physical 17))
                      (do
                        ; Save replacement bits while bounded index selection uses x17.
                        (word! (mut temporary)
                               (mut error)
                               (encode/scalar-transfer true true 31 17))
                        (index-flags! (mut temporary)
                                      (mut error)
                                      (types/lanes ty)
                                      0)
                        (constant! (mut temporary) (mut error) 17 128)
                        (word! (mut temporary)
                               (mut error)
                               (encode/conditional-select true 16 16 17 3))
                        (word! (mut temporary)
                               (mut error)
                               (encode/scalar-transfer true false 17 31))
                        ; DUP byte index, then create exact lane-id bytes in v30.
                        (bytes/append32! (mut temporary)
                                         (| (: 0x0E010C00 u32)
                                            q
                                            (<< (: 16 u32) 5)
                                            (: 31 u32)))
                        (let [(mut half) (: 0 i32)]
                          (while (< half (if (= width 16) 2 1))
                            (do
                              (constant! (mut temporary)
                                         (mut error)
                                         16
                                         (lane-ids element half))
                              (if (= half 0)
                                  (word! (mut temporary)
                                         (mut error)
                                         (encode/scalar-transfer true
                                                                 true
                                                                 30
                                                                 16))
                                  (word! (mut temporary)
                                         (mut error)
                                         (lanes/lane-insert 8 1 30 16))))
                            (set! half (+ half 1))))
                        (bytes/append32! (mut temporary)
                                         (| (: 0x2E208C00 u32)
                                            q
                                            (<< (: 31 u32) 16)
                                            (<< (: 30 u32) 5)
                                            (: 30 u32)))
                        (splat! (mut temporary) (mut error) width element 31)
                        (bytes/append32! (mut temporary)
                                         (| (: 0x2E601C00 u32)
                                            q
                                            (<< (cast u32 physical) 16)
                                            (<< (: 31 u32) 5)
                                            (: 30 u32)))
                        (word! (mut temporary)
                               (mut error)
                               (encode/simd-move width physical 30)))))))
        (let [size (cast i32 (len temporary))]
          (when (= error "")
            (extend! (mut output) (.data temporary) (len temporary)))
          (free! (mut temporary))
          (if (= error "") (Ok size) (Err error))))))

(defn emit! [(output (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList allocation/Part))
             (reference i32)
             (position i64)]
  (-> (Result i32 (slice u8)))
  (match (vector/validate graph reference 8)
    (Err [message] (Err message))
    (Ok [ty]
        (let [node (get (.instructions graph) (cast i64 reference))
              opcode (cast i32 (n/opcode node))
              scalar-reference (if (= opcode 63) (.op1 node) (.op3 node))
              (mut scalar-type) (cast i32 (n/type-id node))
              lane
                (if (= opcode 63)
                    (: 0 i32)
                    (vector/constant-index graph (.op2 node)))
              (mut temporary) (code/create (.alc (.text output)))
              (mut error) ""
              (mut rd) (: -1 i32)
              (mut rn) (: -1 i32)]
          (match (loc/lookup parts reference (+ position 1))
            (Err [message] (set! error message))
            (Ok [location]
                (if (and (= (.kind location) 0)
                         (registers/allocatable? (cast i32 (n/type-id node))
                                                 (cast i32 (.value location))))
                    (set! rd (cast i32 (.value location)))
                    (set! error
                          "vector lane result lacks a register of its class"))))
          (when (!= opcode 63)
            (match (value/register! (mut temporary)
                                    graph
                                    parts
                                    (.op1 node)
                                    position
                                    16
                                    62)
              (Err [message] (set! error message))
              (Ok [reg] (set! rn reg)))
            (when (< lane 0)
              (match (value/register! (mut temporary)
                                      graph
                                      parts
                                      (.op2 node)
                                      position
                                      16
                                      63)
                (Err [message] (set! error message))
                (Ok [reg]
                    (when (!= reg 16)
                      (word! (mut (.text temporary))
                             (mut error)
                             (encode/logical-register true 1 16 31 reg)))))))
          (when (!= opcode 61)
            (match (g/lookup graph scalar-reference)
              (None [] (set! error "vector scalar source missing"))
              (Some [source] (set! scalar-type (cast i32 (n/type-id source)))))
            (match (value/register! (mut temporary)
                                    graph
                                    parts
                                    scalar-reference
                                    position
                                    17
                                    63)
              (Err [message] (set! error message))
              (Ok [reg]
                  (if (>= reg 32)
                      (word! (mut (.text temporary))
                             (mut error)
                             (encode/scalar-transfer (= (types/scalar-size scalar-type
                                                                           8)
                                                        8)
                                                     false
                                                     17
                                                     (- reg 32)))
                      (when (!= reg 17)
                        (word! (mut (.text temporary))
                               (mut error)
                               (encode/logical-register true 1 17 31 reg)))))))
          (when (= error "")
            (match (emit-prepared! (mut (.text temporary))
                                   opcode
                                   ty
                                   scalar-type
                                   rd
                                   rn
                                   lane)
              (Err [message] (set! error message))
              (Ok [_] 0)))
          (let [size (cast i32 (len (.text temporary)))]
            (when (and (= error "") (not (code/append! (mut output) temporary)))
              (set! error "invalid vector lane code references"))
            (code/release! (mut temporary))
            (if (= error "") (Ok size) (Err error)))))))
