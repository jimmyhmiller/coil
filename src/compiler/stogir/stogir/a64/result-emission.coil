;;; Atomic result-bank capture and return installation for explicit result places.
(module stogir.a64.result-emission)
(import "stogir.call-results" :as results)
(import "stogir.types" :as types)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.frame-address" :as frame)
(import "stogir.a64.frame-memory" :as memory)
(import "stogir.locations" :as locations)
(import "stogir.allocation" :as allocation)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn parameter! [(out (mut (ArrayList u8)))
                  (parts (ArrayList allocation/Part))
                  (reference i32)
                  (position i64)
                  (base frame/Base)
                  (slot i64)]
  (-> (Result i32 (slice u8)))
  (match (frame/offset base slot)
    (Err [message] (Err message))
    (Ok [offset]
        (match (locations/lookup parts reference (+ position 1))
          (Err [message] (Err message))
          (Ok [destination]
              (if (or (!= (.kind destination) 0)
                      (> (.value destination) 15)
                      (< (.value destination) 0))
                  (Err "result place parameter requires a GPR")
                  (frame/address! (mut out)
                                  (cast i32 (.value destination))
                                  (.reg base)
                                  offset)))))))

(defn capture! [(out (mut (ArrayList u8)))
                (spec results/Spec)
                (save-offset i64)]
  (-> (Result i32 (slice u8)))
  (if (and (!= (.kind spec) 1) (results/shape? spec))
      (Ok 0)
      (if (or (not (results/shape? spec)) (< save-offset 0))
          (Err "invalid aggregate result capture")
          (let [(mut error) ""
                (mut bytes) (: 0 i32)
                (mut i) (: 0 i32)
                width (types/size (cast i32 (.ty spec)) 8)]
            (match (memory/access! (mut out) true 8 16 31 save-offset false 17)
              (Err [message] (set! error message))
              (Ok [n] (set! bytes n)))
            (while (and (= error "") (< i (.count spec)))
              (match (memory/access! (mut out)
                                     false
                                     width
                                     (+ i
                                        (if (registers/simd-type? (cast i32
                                                                        (.ty spec)))
                                            32
                                            0))
                                     16
                                     (* (cast i64 i) (cast i64 width))
                                     false
                                     17)
                (Err [message] (set! error message))
                (Ok [n] (set! bytes (+ bytes n))))
              (set! i (+ i 1)))
            (if (= error "") (Ok bytes) (Err error))))))

(defn return! [(out (mut (ArrayList u8)))
               (spec results/Spec)
               (base frame/Base)
               (slot i64)]
  (-> (Result i32 (slice u8)))
  (if (and (!= (.kind spec) 1) (results/shape? spec))
      (Ok 0)
      (if (not (results/shape? spec))
          (Err "invalid aggregate result return")
          (match (frame/offset base slot)
            (Err [message] (Err message))
            (Ok [offset]
                (let [(mut error) ""
                      (mut bytes) (: 0 i32)
                      (mut i) (: 0 i32)
                      width (types/size (cast i32 (.ty spec)) 8)]
                  (while (and (= error "") (< i (.count spec)))
                    (match (memory/access! (mut out)
                                           true
                                           width
                                           (+ i
                                              (if (registers/simd-type? (cast i32
                                                                              (.ty spec)))
                                                  32
                                                  0))
                                           (.reg base)
                                           (+ offset
                                              (* (cast i64 i) (cast i64 width)))
                                           false
                                           16)
                      (Err [message] (set! error message))
                      (Ok [n] (set! bytes (+ bytes n))))
                    (set! i (+ i 1)))
                  (if (= error "") (Ok bytes) (Err error))))))))
