;;; Typed scalar operand capture. SIMD constants preserve their exact payloads.
(module stogir.a64.value)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.allocation" :as a)
(import "stogir.locations" :as loc)
(import "stogir.a64.code" :as code)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.frame-address" :as frame)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn scalar-constant! [(out (mut code/Buffer))
                        (graph g/Graph)
                        (reference i32)
                        (destination i32)
                        (gpr-scratch i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "constant operand missing"))
    (Some [node]
          (let [floating? (types/floating? (cast i32 (n/type-id node)))
                wide (= (types/scalar-size (cast i32 (n/type-id node)) 8) 8)]
            (if (or (>= reference 0)
                    (< gpr-scratch 0)
                    (> gpr-scratch 30)
                    (if floating?
                        (not (registers/simd? destination))
                        (or (< destination 0) (> destination 30))))
                (Err "constant destination has wrong register class")
                (if floating?
                    (match (code/materialize! (mut out)
                                              graph
                                              reference
                                              wide
                                              gpr-scratch)
                      (Err [message] (Err message))
                      (Ok [size]
                          (match (encode/scalar-transfer wide
                                                         true
                                                         (registers/physical destination)
                                                         gpr-scratch)
                            (Err [message] (Err message))
                            (Ok [word]
                                (do
                                  (bytes/append32! (mut (.text out)) word)
                                  (Ok (+ size 4)))))))
                    (code/materialize! (mut out)
                                       graph
                                       reference
                                       wide
                                       destination)))))))

;;; A vector constant is loaded from its complete, aligned private image data.
(defn constant! [(out (mut code/Buffer))
                 (graph g/Graph)
                 (reference i32)
                 (destination i32)
                 (gpr-scratch i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "constant operand missing"))
    (Some [node]
          (let [ty (cast i32 (n/type-id node))]
            (if (not (types/vector? ty))
                (scalar-constant! (mut out)
                                  graph
                                  reference
                                  destination
                                  gpr-scratch)
                (if (or (>= reference 0)
                        (not (types/short-vector? ty 8))
                        (not (registers/simd? destination))
                        (< gpr-scratch 0)
                        (> gpr-scratch 30))
                    (Err "unsupported vector constant width or register class")
                    (match (encode/floating-load-store true
                                                       (types/size ty 8)
                                                       (registers/physical destination)
                                                       gpr-scratch
                                                       0)
                      (Err [message] (Err message))
                      (Ok [load]
                          (match (code/long-address! (mut out)
                                                     graph
                                                     reference
                                                     gpr-scratch)
                            (Err [message] (Err message))
                            (Ok [count]
                                (bytes/append32! (mut (.text out)) load)
                                (Ok (+ count 4))))))))))))

(defn register-with-locations! [(out (mut code/Buffer))
                                (graph g/Graph)
                                (parts loc/View)
                                (reference i32)
                                (position i64)
                                (gpr-scratch i32)
                                (simd-scratch i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "scalar operand missing"))
    (Some [node]
          (let [ty (cast i32 (n/type-id node))]
            (if (< reference 0)
                (let [destination
                        (if (registers/simd-type? ty) simd-scratch gpr-scratch)]
                  (match (constant! (mut out)
                                    graph
                                    reference
                                    destination
                                    gpr-scratch)
                    (Err [message] (Err message))
                    (Ok [_] (Ok destination))))
                (match (loc/resolve parts reference position)
                  (Err [message] (Err message))
                  (Ok [location]
                      (if (loc/constant? location)
                          (match (constant! (mut out) graph (cast i32 (.value location)) gpr-scratch gpr-scratch)
                            (Err [message] (Err message)) (Ok [_] (Ok gpr-scratch)))
                      (if (loc/rematerialized? location)
                          (if (or (!= ty 6) (< gpr-scratch 0) (> gpr-scratch 30))
                              (Err "invalid frame-address materialization destination")
                              (match (frame/address! (mut (.text out)) gpr-scratch
                                                     (loc/address-base location) (.value location))
                                (Err [message] (Err message)) (Ok [_] (Ok gpr-scratch))))
                      (if (or (!= (.kind location) 0)
                              (not (registers/allocatable? ty
                                                           (cast i32
                                                                 (.value location)))))
                          (Err "scalar operand requires register of its class")
                          (Ok (cast i32 (.value location)))))))))))))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn register! [(out (mut code/Buffer))
                 (graph g/Graph)
                 (parts (ArrayList a/Part))
                 (reference i32)
                 (position i64)
                 (gpr-scratch i32)
                 (simd-scratch i32)] (-> (Result i32 (slice u8)))
  (register-with-locations! (mut out)
                            graph
                            (loc/linear-view parts)
                            reference
                            position
                            gpr-scratch
                            simd-scratch))
