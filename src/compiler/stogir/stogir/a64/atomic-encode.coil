;;; Arm FEAT_LSE/acquire-release encodings, independently checked with LLVM MC.
(module stogir.a64.atomic-encode)
(import "coil.result" :use [Result Ok Err])

(defn size-code [(bytes i32)] (-> i32)
  (case bytes 1 0 2 1 4 2 8 3 -1))

(defn register? [(reg i32)] (-> bool)
  (and (>= reg 0) (< reg 31)))

(defn memory [(store? bool) (bytes i32) (rt i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (let [size (size-code bytes)]
    (if (or (< size 0) (not (register? rt)) (not (register? rn)))
        (Err "invalid acquire/release atomic memory operands")
        (Ok (| (if store? (: 0x089FFC00 u32) (: 0x08DFFC00 u32))
               (<< (cast u32 size) 30)
               (<< (cast u32 rn) 5)
               (cast u32 rt))))))

;;; SUB and AND use negated/complemented source bits before LDADD/LDCLR.
(defn rmw [(operation i32) (bytes i32) (rs i32) (rt i32) (rn i32)]
  (-> (Result u32 (slice u8)))
  (let [size (size-code bytes)
        code (case operation 0 0 1 0 2 1 3 3 4 2 5 8 6 4 7 5 8 6 9 7 -1)]
    (if (or (< size 0)
            (< code 0)
            (not (register? rs))
            (not (register? rt))
            (not (register? rn)))
        (Err "invalid LSE atomic RMW operands")
        (Ok (| (: 0x38E00000 u32)
               (<< (cast u32 size) 30)
               (<< (cast u32 rs) 16)
               (<< (cast u32 code) 12)
               (<< (cast u32 rn) 5)
               (cast u32 rt))))))

(defn compare-exchange [(bytes i32) (expected i32) (desired i32) (address i32)]
  (-> (Result u32 (slice u8)))
  (let [size (size-code bytes)]
    (if (or (< size 0)
            (not (register? expected))
            (not (register? desired))
            (not (register? address)))
        (Err "invalid LSE compare/exchange operands")
        (Ok (| (: 0x08E0FC00 u32)
               (<< (cast u32 size) 30)
               (<< (cast u32 expected) 16)
               (<< (cast u32 address) 5)
               (cast u32 desired))))))
