;;; A fixed-size memmove of 16..256 bytes as straight-line vector accesses, in
;;; place of the runtime call the ABI lowering has already set up: destination
;;; in x0, source in x1. Every source byte is loaded before any destination
;;; byte is stored, so overlapping and identical regions behave exactly as
;;; memmove does. Whole 32-byte pairs come first; a tail shorter than a pair
;;; is one more access ending at the last byte, overlapping its predecessor.
;;; No access reaches outside [0, size) of either region, and none assumes an
;;; alignment. Only the caller-saved vector registers v0..v7 and v16..v23 are
;;; written, which the replaced call already clobbers; x0 keeps the
;;; destination, the call's result, and NZCV is preserved.
(module stogir.a64.block-move)
(import "stogir.a64.encode" :as e)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn minimum [] (-> i64) 16)

(defn maximum [] (-> i64) 256)

(defn inline? [(size i64)] (-> bool)
  (and (>= size (minimum)) (<= size (maximum))))

;;; The k-th vector register of the sequence: v0..v7, then v16..v23.
(defn register [(index i64)] (-> i32)
  (cast i32 (if (< index 8) index (+ index 8))))

(defn word! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (instruction (Result u32 (slice u8)))] (-> void)
  (when (= error "")
    (match instruction
      (Err [message] (set! error message))
      (Ok [word] (bytes/append32! (mut out) word)))))

;;; All loads (load? true) from BASE, or all stores to BASE, of the same plan.
(defn pass! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (load? bool)
             (base i32)
             (size i64)] (-> void)
  (let [pairs (/ size 32)
        tail (- size (* pairs 32))]
    (for [k 0 pairs]
      (word! (mut out) (mut error)
             (e/vector-pair load? (register (* k 2)) (register (+ (* k 2) 1)) base (* k 32))))
    (cond (= tail 0) 0
          ; A tail of at most 16 bytes: the 16 bytes ending at the last byte.
          (<= tail 16)
            (word! (mut out) (mut error)
                   (e/unscaled-load-store load? true false false 16
                                          (register (* pairs 2)) base (- size 16)))
          ; A longer tail: two vectors ending at the last byte (the first at
          ; offset zero when there is no whole pair). The pair form needs a
          ; multiple of 16; any other offset takes two single accesses.
          (= (% size 16) 0)
            (word! (mut out) (mut error)
                   (e/vector-pair load? (register (* pairs 2)) (register (+ (* pairs 2) 1))
                                  base (- size 32)))
          :else
            (do
              (word! (mut out) (mut error)
                     (e/unscaled-load-store load? true false false 16
                                            (register (* pairs 2)) base
                                            (if (= pairs 0) 0 (- size 32))))
              (word! (mut out) (mut error)
                     (e/unscaled-load-store load? true false false 16
                                            (register (+ (* pairs 2) 1)) base (- size 16)))))))

(defn emit! [(out (mut (ArrayList u8))) (size i64)] (-> (Result i32 (slice u8)))
  (if (not (inline? size))
      (Err "block move size outside the inline range")
      (let [before (len out)
            (mut error) ""]
        (pass! (mut out) (mut error) true 1 size)
        (pass! (mut out) (mut error) false 0 size)
        (if (= error "") (Ok (cast i32 (- (len out) before))) (Err error)))))
