;;; Tail-jump eligibility over immutable graph facts. Native emission follows
;;; pinned ir_aarch64.dasc:ir_emit_tailcall; stack/copy arguments retain call/ret.
(module stogir.a64.tail-plan)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.uses" :as uses)
(import "stogir.bitset" :as bits)
(import "stogir.bitqueue" :as q)
(import "stogir.calls" :as calls)
(import "stogir.call-results" :as results)
(import "stogir.strings" :as strings)
(import "stogir.schedule" :as schedule)
(import "stogir.a64.call-abi" :as abi)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

;;; Register-result capture places are written by the caller after the call;
;;; their address is not passed to the target. All other call data uses escape.
(defn capture-place? [(graph g/Graph) (user i32) (operand i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 user))]
    (if (and (or (= (n/opcode node) 79) (= (n/opcode node) 80))
             (= operand 3))
        (match (calls/signature graph
                                (.op2 node)
                                (n/type-id node)
                                (- (get (.arities graph) (cast i64 user)) 2))
          (Err [_] false)
          (Ok [signature]
              (match (strings/lookup (.strings graph) (.id signature))
                (None [] false)
                (Some [bytes] (= (.kind (results/decode bytes)) 1)))))
        false)))

;;; Prove that no current-frame address is observable by a later callee. Track
;;; integer views too: converting a private pointer into bits does not make its
;;; lifetime longer. Unknown uses conservatively retain the ordinary call/ret.
(defn private-frame? [(graph g/Graph)
                      (scheduled schedule/Schedule)
                      (a (dyn Allocator))] (-> bool)
  (let [(mut origins) (ArrayList::new [i32] a)
        (mut register-result) false
        (mut safe) true]
    (match (calls/function-result graph)
      (Err [_] (set! safe false))
      (Ok [spec] (set! register-result (= (.kind spec) 1))))
    (for reference (.nodes scheduled)
      (let [node (get (.instructions graph) (cast i64 reference))
            opcode (n/opcode node)]
        (when (or (= opcode 65)
                  (= opcode 66)
                  (= opcode 81)
                  (= opcode 83)
                  (= opcode 89)
                  (and register-result (= opcode 71) (= (.op3 node) 0)))
          (push! (mut origins) reference))))
    (when (and safe (> (len origins) 0))
      (let [(mut edges) (uses/build graph a)
            (mut seen) (bits/create (len (.instructions graph)) a)
            (mut work) (q/create (len (.instructions graph)) a)]
        (for origin origins
          (bits/add! (mut seen) (cast i64 origin))
          (q/add! (mut work) (cast i64 origin)))
        (let [(mut next) (q/pop! (mut work))]
          (while (and safe (>= next 0))
            (let [range (get (.ranges edges) next)]
              (for [i (.offset range) (+ (.offset range) (.count range))]
                (let [edge (get (.edges edges) i)
                      user (.user edge)
                      position (.operand edge)
                      node (get (.instructions graph) (cast i64 user))
                      opcode (cast i32 (n/opcode node))
                      kind (op/operand-code opcode position)]
                  (when (or (= kind op/OPERAND-DEF) (= kind op/OPERAND-REF))
                    (cond (or (= opcode 26)
                              (= opcode 27)
                              (= opcode 36)
                              (= opcode 40)
                              (= opcode 60)
                              (= opcode 67)
                              (= opcode 68))
                            (unless (bits/contains? seen (cast i64 user))
                              (bits/add! (mut seen) (cast i64 user))
                              (q/add! (mut work) (cast i64 user)))
                          (or (and (>= opcode 14) (<= opcode 23))
                              (= opcode 116)
                              (= opcode 117)
                              (and (or (= opcode 91)
                                       (= opcode 92)
                                       (= opcode 93)
                                       (= opcode 94))
                                   (= position 2))
                              (and (= opcode 84) (= position 2))
                              (capture-place? graph user position))
                            0
                          :else (set! safe false))))))
            (set! next (q/pop! (mut work)))))
        (q/release! (mut work))
        (bits/release! (mut seen))
        (uses/release! (mut edges))))
    (free! (mut origins))
    safe))

(defstruct Plan [(modes (ArrayList i32)) (returns (ArrayList i32))])

(defstruct Candidate [(call i32) (return i32)])

(defn empty [(a (dyn Allocator))] (-> Plan)
  (Plan :modes (ArrayList::new [i32] a) :returns (ArrayList::new [i32] a)))

(defn release! [(plan (mut Plan))] (-> void)
  (free! (mut (.modes plan)))
  (free! (mut (.returns plan))))

;;; Pinned ir_emit.c:ir_try_tailcall checks a declared callee convention and
;;; return ABI before selecting the native TAILCALL rule for an ordinary CALL.
(defn return-compatible? [(graph g/Graph) (reference i32) (returning i32)]
  (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        count (get (.arities graph) (cast i64 reference))]
    (match (calls/signature graph (.op2 node) (n/type-id node) (- count 2))
      (Err [_] false)
      (Ok [signature]
          (match (strings/lookup (.strings graph) (.id signature))
            (None [] false)
            (Some [bytes]
                  (match (calls/tail-result-compatible graph
                                                       (.flags signature)
                                                       (.result signature)
                                                       (results/decode bytes)
                                                       (if (> count 2)
                                                           (match (g/operand graph
                                                                             reference
                                                                             3)
                                                             (Some [place]
                                                                   place)
                                                             (None [] 0))
                                                           0))
                    (Err [_]
                         ; Upstream also matches RETURN(void) after a scalar CALL whose
                         ; result is ignored. Extra scalar result registers are harmless.
                         (match (strings/lookup (.strings graph)
                                                (.function-prototype graph))
                           (None [] false)
                           (Some [own]
                                 (and (calls/valid-bytes? own)
                                      (= (n/type-id (get (.instructions graph)
                                                         (cast i64 returning)))
                                         0)
                                      (= (get own 1) 0)
                                      (= (.kind (results/decode own)) 0)
                                      (= (.kind (results/decode bytes)) 0)
                                      (= (& (get own 0) (: 15 u8))
                                         (& (.flags signature) (: 15 u8)))))))
                    (Ok [_] true))))))))

;;; mode1 jumps; mode2 is an explicit TAILCALL's call/return fallback. An
;;; ordinary CALL is selected only when it can really jump, so its original
;;; RETURN and result definition can be omitted together before liveness.
;;; The immutable semantic graph and all its externally observed IDs survive.
(defn select [(graph g/Graph)
              (scheduled schedule/Schedule)
              (roots (slice i32))
              (recognize-returns bool)
              (a (dyn Allocator))]
  (-> (Result Plan (slice u8)))
  (let [(mut result) (empty a)
        (mut candidates) (ArrayList::new [Candidate] a)
        (mut has-return) false
        (mut error) ""]
    (for reference (.nodes scheduled)
      (let [node (get (.instructions graph) (cast i64 reference))]
        (if (= (n/opcode node) 80)
            (push! (mut candidates) (Candidate :call reference :return 0))
            (when (and recognize-returns
                       (> (.function-prototype graph) 0)
                       (= (n/opcode node) 120)
                       (> (.op1 node) 0))
              (let [call (.op1 node)
                    source (get (.instructions graph) (cast i64 call))
                    (mut protected) false]
                (for root roots (when (= root call) (set! protected true)))
                (when (and (not protected)
                           (= (n/opcode source) 79)
                           (if (= (n/type-id node) 0)
                               (= (.op2 node) 0)
                               (and (= (n/type-id source) (n/type-id node))
                                    (= (.op2 node) call)))
                           (return-compatible? graph call reference))
                  (push! (mut candidates)
                         (Candidate :call call :return reference))
                  (set! has-return true)))))))
    (when (> (len candidates) 0)
      (let [safe (private-frame? graph scheduled a)
            (mut edges) (zeroed uses/Uses)]
        (when has-return (set! edges (uses/build graph a)))
        (for candidate candidates
          (let [reference (.call candidate)
                returning (.return candidate)
                node (get (.instructions graph) (cast i64 reference))
                (mut only-return) true]
            (when (> returning 0)
              (let [range (get (.ranges edges) (cast i64 reference))]
                (unless (= (.count range)
                           (if (= (n/type-id (get (.instructions graph)
                                                  (cast i64 returning)))
                                  0)
                               1
                               2))
                  (set! only-return false))
                (for [i (.offset range) (+ (.offset range) (.count range))]
                  (unless (= (.user (get (.edges edges) i)) returning)
                    (set! only-return false)))))
            (when (and (= error "") only-return)
              (match (abi/layout graph reference a)
                (Err [message] (set! error message))
                (Ok [owned]
                    (let [(mut layout) owned
                          (mut native) safe]
                      (for argument (.arguments layout)
                        (when (or (= (.register argument) -1)
                                  (>= (.copy-offset argument) 0))
                          (set! native false)))
                      (when (or (= returning 0) native)
                        (when (= (len (.modes result)) 0)
                          (for [i 0 (len (.instructions graph))]
                            (push! (mut (.modes result)) 0)))
                        (set! (mut (.modes result))
                              (cast i64 reference)
                              (if native 1 2))
                        (when (> returning 0)
                          (push! (mut (.returns result)) returning)))
                      (abi/release! (mut layout))))))))
        (when has-return (uses/release! (mut edges)))))
    (free! (mut candidates))
    (if (= error "") (Ok result) (do (release! (mut result)) (Err error)))))

;;; Explicit-TAILCALL compatibility view; no ordinary CALL is absorbed here.
(defn build [(graph g/Graph) (scheduled schedule/Schedule) (a (dyn Allocator))]
  (-> (Result (ArrayList i32) (slice u8)))
  (match (select graph scheduled [] false a)
    (Err [message] (Err message))
    (Ok [owned]
        (let [(mut owned) owned]
          (free! (mut (.returns owned)))
          (Ok (.modes owned))))))
