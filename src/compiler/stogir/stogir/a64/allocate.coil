;;; Bridge selected typed constraints and live ranges into allocation parts.
(module stogir.a64.allocate)
(import "stogir.live-ranges" :as ranges)
(import "stogir.matched-uses" :as machine)
(import "stogir.a64.constraints" :as constraints)
(import "stogir.a64.coalesce" :as coalesce)
(import "stogir.a64.static-stack" :as static-stack)
(import "stogir.a64.word-constant" :as word-constant)
(import "stogir.a64.preferences" :as preferences)
(import "stogir.allocation" :as allocation)
(import "stogir.allocation-check" :as check)
(import "stogir.locations" :as locations)
(import "stogir.frame" :as frame)
(import "stogir.graph" :as g)
(import "stogir.cfg" :as cfg)
(import "stogir.calls" :as calls)
(import "stogir.call-results" :as results)
(import "stogir.node" :as n)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.callee-saved" :as callee)
(import "stogir.types" :as types)
(import "stogir.locals" :as locals)
(import "stogir.stack" :as stack)
(import "stogir.a64.frame-address" :as address)
(import "stogir.schedule" :as schedule)
(import "stogir.a64.call-abi" :as call-abi)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defstruct Assigned
  [(parts (ArrayList allocation/Part))
   (locations locations/Index)
   (frame frame/Frame)
   (link-slot i64)
   (base address/Base)
   (outgoing-size i64)
   (alignment i64)
   (entry-slot i64)
   (result results/Spec)
   (result-slot i64)
   (callee callee/Saved)])

(defn release! [(assigned (mut Assigned))] (-> void)
  (let [(mut i) 0]
    (while (< i (len (.parts assigned)))
      (allocation/release! (elem (mut (.parts assigned)) i))
      (set! i (+ i 1))))
  (locations/release-index! (mut (.locations assigned)))
  (free! (mut (.parts assigned)))
  (frame/release! (mut (.frame assigned))))

;;; Merge constant recipes with sorted frame recipes transactionally. A selected
;;; constant view must have no allocated child. Existing frame kinds are intact.
(defn index-word-constants! [(index (mut locations/Index)) (graph g/Graph)
                             (requirements (ArrayList constraints/Value))
                             (a (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [(mut merged) (ArrayList::new [locations/Rematerialized] a)
        (mut cursor) (: 0 i64) (mut count) (: 0 i32) (mut error) ""
        original (.rematerialized index)]
    (for [r 1 (len requirements)]
      (when (and (= error "") (.rematerialized (get requirements r)))
        (let [source (word-constant/source graph (cast i32 r))]
          (when (< source 0)
            (while (and (< cursor (len original))
                        (< (cast i64 (.parent (get original cursor))) r))
              (push! (mut merged) (get original cursor))
              (set! cursor (+ cursor 1)))
            (if (or (>= r (len (.parents index)))
                    (!= (.count (get (.parents index) r)) 0)
                    (and (< cursor (len original)) (= (cast i64 (.parent (get original cursor))) r)))
                (set! error "constant view still has a location or allocation")
                (do
                  (push! (mut merged) (locations/Rematerialized :parent (cast i32 r)
                    :location (locations/Location :kind 4 :value (cast i64 source))))
                  (set! count (+ count 1))))))))
    (if (or (!= error "") (= count 0))
        (do (free! (mut merged)) (if (= error "") (Ok 0) (Err error)))
        (do
          (while (< cursor (len original))
            (push! (mut merged) (get original cursor)) (set! cursor (+ cursor 1)))
          (free! (mut (.rematerialized index)))
          (set! (.rematerialized index) merged)
          (Ok count)))))

;;; Explicit per-value GPR/SIMD masks; GPR-only graphs scan through x28, excluding reserved registers.
;;; x16/x17 and v30/v31 are reserved for emission/resolution.
;;; Calls reserve caller-saved registers and a link-register frame slot.
(defn build-core-results [(aliases (mut (ArrayList i32)))
                  (intervals (ArrayList ranges/Value))
                  (requirements (ArrayList constraints/Value))
                  (graph g/Graph)
                  (scheduled schedule/Schedule)
                  (static-sizes (ArrayList i64))
                  (outputs (slice machine/Range))
                  (blocks cfg/Blocks)
                  (depths (ArrayList i32))
                  (direct-results bool)
                  (allocator (dyn Allocator))]
  (-> (Result Assigned (slice u8)))
  (let [(mut assigned)
          (Assigned
            :parts (ArrayList::new [allocation/Part] allocator)
            :locations (locations/empty-index allocator)
            :frame (frame/create allocator)
            :link-slot -1
            :base (address/stack-base)
            :outgoing-size 0
            :alignment 16
            :entry-slot -1
            :result (results/ordinary)
            :result-slot -1
            :callee (callee/none))
        (mut shapes) (ArrayList::new [allocation/SpillShape] allocator)
        (mut i) 1
        (mut frame-error) ""
        (mut anchored?) false
        (mut register-count) (: 29 i32)
        (mut allowed) (registers/gpr-mask)]
    (push! (mut shapes) (allocation/SpillShape :size 0 :alignment 0))
    (while (< i (len intervals))
      (let [interval (at intervals i)
            uses (at requirements i)
            ty (cast i32 (n/type-id (get (.instructions graph) i)))
            width (types/size ty 8)
            extent (if (> width 8) (cast i64 width) (: 8 i64))]
        (when (and (> (len (.ranges interval)) 0)
                   (or (<= width 0) (> width 16)))
          (set! frame-error "unsupported allocated value extent"))
        ; Spill geometry stays indexed by graph reference, including dead cells.
        (push! (mut shapes)
               (allocation/SpillShape :size extent :alignment extent))
        (when (and (registers/simd-type? ty) (> (len (.ranges interval)) 0))
          (set! register-count 64)
          (set! allowed (| (registers/gpr-mask) (registers/simd-mask))))
        ; Parts use explicit parent refs, never their array position as a ref.
        ; Preserve constraints even on a part without ranges. Only records with
        ; neither ranges nor uses are inert for allocation and location lookup.
        (when (or (> (len (.ranges interval)) 0) (> (len (.uses uses)) 0))
          (let [(mut part) (allocation/create (cast i32 i) allocator)]
            (set! (.allowed part) (registers/class-mask ty))
            (for range (.ranges interval) (push! (mut (.ranges part)) range))
            (for use (.uses uses) (push! (mut (.uses part)) use))
            (push! (mut (.parts assigned)) part))))
      (set! i (+ i 1)))
    (set! aliases
          (if (= (len depths) 0)
              (coalesce/run! (mut (.parts assigned)) graph scheduled allocator)
              (coalesce/run-prepared! (mut (.parts assigned)) graph scheduled blocks depths allocator)))
    (preferences/prepare! (mut (.parts assigned)) graph scheduled aliases)
    ; Incoming GPRs are already live at entry. Reserve each until its PARAM
    ; definition so earlier stack-parameter loads cannot destroy that value.
    (set! i 0)
    (while (< i (len (.nodes scheduled)))
      (let [reference (get (.nodes scheduled) i)
            node (get (.instructions graph) (cast i64 reference))]
        (when (= (n/opcode node) 71)
          (let [parameter (.parameter (at requirements (cast i64 reference)))]
            (when (or (= (.kind parameter) 0) (= (.kind parameter) 2))
              (allocation/reserve! (mut (.parts assigned))
                                   (+ (.register parameter)
                                      (if (= (.kind parameter) 2) 32 0))
                                   0
                                   (+ (* i 2) 1)
                                   allocator)))))
      (set! i (+ i 1)))
    (for reference (.nodes scheduled)
      (let [node (get (.instructions graph) (cast i64 reference))
            opcode (cast i32 (n/opcode node))]
        (when (and (stack/operation? opcode)
                   (= (static-stack/size static-sizes reference) 0))
          (set! anchored? true))
        (when (or (= opcode 72) (= opcode 81) (= opcode 70))
          (let [(mut requested) (cast i64 (.op3 node))]
            ; VAR's zero alignment requests the type's natural alignment.
            (when (= opcode 72)
              (match (locals/shape graph reference 8)
                (Err [message] (set! frame-error message))
                (Ok [shape] (set! requested (.alignment shape)))))
            (when (> requested (.alignment assigned))
              (if (frame/valid-alignment? requested)
                  (set! (.alignment assigned) requested)
                  (set! frame-error "invalid frame object alignment")))))))
    (when (> (.alignment assigned) 16) (set! anchored? true))
    (match (call-abi/outgoing-size graph scheduled)
      (Err [msg] (set! frame-error msg))
      (Ok [size]
          (set! (.size (.frame assigned)) size)
          (match (frame/aligned-size (.frame assigned) (.alignment assigned))
            (Err [message] (set! frame-error message))
            (Ok [aligned]
                (set! (.size (.frame assigned)) aligned)
                (set! (.outgoing-size assigned) aligned)))))
    (let [calls
            (call-abi/reserve-with-outputs! (mut (.parts assigned))
                                           graph
                                           scheduled
                                           (= register-count 64)
                                           intervals
                                           outputs
                                           allocator)]
      (when (or anchored? (> calls 0))
        (match (frame/spill-slot! (mut (.frame assigned))
                                  0
                                  (if (> (.alignment assigned) 16) 32 16)
                                  16)
          (Err [msg] (set! frame-error msg))
          (Ok [offset]
              (set! (.link-slot assigned) (+ offset 8))
              (when (> (.alignment assigned) 16)
                (set! (.entry-slot assigned) (+ offset 16)))
              (when anchored?
                (set! (.base assigned) (address/Base :reg 29 :bias offset)))))))
    (match (calls/function-result graph)
      (Err [message] (set! frame-error message))
      (Ok [result]
          (set! (.result assigned) result)
          (when (and (= (.kind result) 1) (not direct-results))
            ; The entry reference cannot also own a VAR slot. Keep this private
            ; result buffer separate from all user objects and split-value spills.
            (match (frame/local-slot! (mut (.frame assigned))
                                      (get (.nodes scheduled) 0)
                                      (results/size result)
                                      (cast i64
                                            (types/size (cast i32
                                                              (.ty result))
                                                        8)))
              (Err [message] (set! frame-error message))
              (Ok [offset] (set! (.result-slot assigned) offset))))))
    (for reference (.nodes scheduled)
      (let [node (get (.instructions graph) (cast i64 reference))]
        (when (or (= (n/opcode node) 72) (> (static-stack/size static-sizes reference) 0))
          (match (if (= (n/opcode node) 72)
                     (locals/shape graph reference 8)
                     (Ok [locals/Shape (slice u8)]
                         (locals/Shape :size (static-stack/size static-sizes reference)
                                       :alignment (if (> (.op3 node) 16)
                                                      (cast i64 (.op3 node)) 16))))
            (Err [message] (set! frame-error message))
            (Ok [shape]
                (match (frame/local-slot! (mut (.frame assigned))
                                          reference
                                          (.size shape)
                                          (.alignment shape))
                  (Err [message] (set! frame-error message))
                  (Ok [_] 0)))))))
    (if (!= frame-error "")
        (do (free! (mut shapes)) (release! (mut assigned)) (Err frame-error))
        (let [(mut definition-moves) (ArrayList::new [i64] allocator)]
          ; Calls lower transitions at the definition phase explicitly after
          ; capturing operands. Other general moves require input boundaries.
          (for [index 0 (len (.nodes scheduled))]
            (let [opcode (n/opcode (get (.instructions graph)
                                       (cast i64 (get (.nodes scheduled) index))))]
              (when (or (= opcode 79) (= opcode 80))
                (push! (mut definition-moves) (+ (* index 2) 1)))))
          (let [result
                (allocation/run-shaped-input-boundaries! (mut (.parts assigned))
                                        (mut (.frame assigned))
                                        register-count
                                        allowed
                                        (slice shapes)
                                        (slice definition-moves)
                                        allocator)]
          (free! (mut definition-moves))
          (free! (mut shapes))
          (match result
            (Err [msg] (do (release! (mut assigned)) (Err msg)))
            (Ok [_]
                (match (check/verify (.parts assigned) register-count allowed)
                  (Err [msg] (do (release! (mut assigned)) (Err msg)))
                  (Ok [_]
                      (match (locations/build-index (.parts assigned)
                                                    (len (.instructions graph))
                                                    allocator)
                        (Err [msg] (do (release! (mut assigned)) (Err msg)))
                        (Ok [index]
                            (let [(mut index) index]
                              (coalesce/index! (mut index) aliases)
                              (locations/release-index! (mut (.locations assigned)))
                              (set! (.locations assigned) index))
                            (match (static-stack/index! (mut (.locations assigned))
                                                        (.frame assigned) static-sizes (.base assigned))
                              (Err [message] (release! (mut assigned)) (Err message))
                              (Ok [_]
                            (match (index-word-constants! (mut (.locations assigned)) graph requirements allocator)
                              (Err [message] (release! (mut assigned)) (Err message))
                              (Ok [_]
                            (match (callee/layout! (.parts assigned)
                                                   (mut (.frame assigned)))
                              (Err [message]
                                   (release! (mut assigned))
                                   (Err message))
                              (Ok [saved]
                                  (set! (.callee assigned) saved)
                                  (Ok assigned))))))))))))))))))

;;; Compatibility entry preserves the original implicit result-buffer policy.
(defn build-core [(aliases (mut (ArrayList i32))) (intervals (ArrayList ranges/Value))
                  (requirements (ArrayList constraints/Value)) (graph g/Graph)
                  (scheduled schedule/Schedule) (static-sizes (ArrayList i64))
                  (outputs (slice machine/Range)) (blocks cfg/Blocks)
                  (depths (ArrayList i32)) (allocator (dyn Allocator))]
  (-> (Result Assigned (slice u8)))
  (build-core-results (mut aliases) intervals requirements graph scheduled static-sizes
                      outputs blocks depths false allocator))

;;; Selected return uses replace the implicit private buffer only as a complete
;;; GP group at every scheduled RETURN, with no remaining result-place PARAM.
(defn build-prepared-with-machine [(intervals (ArrayList ranges/Value))
             (requirements (ArrayList constraints/Value)) (graph g/Graph)
             (scheduled schedule/Schedule) (static-sizes (ArrayList i64))
             (operands machine/Plan) (blocks cfg/Blocks) (depths (ArrayList i32))
             (a (dyn Allocator))] (-> (Result Assigned (slice u8)))
  (match (calls/function-result graph)
    (Err [message] (Err message))
    (Ok [spec]
      (let [(mut direct) (and (= (.kind spec) 1) (or (= (.ty spec) 5) (= (.ty spec) 11)))
            (mut count) 0 (mut aliases) (ArrayList::new [i32] a)]
        (for ref (.nodes scheduled)
          (let [node (get (.instructions graph) (cast i64 ref))]
            (when (and (= (n/opcode node) 71) (= (.op3 node) 0)) (set! direct false))
            (when (= (n/opcode node) 120)
              (set! count (+ count 1))
              (let [range (get (.ranges operands) (cast i64 ref))]
                (unless (= (.count range) (cast i64 (.count spec))) (set! direct false))
                (when direct
                  (for k (range 0 (.count range))
                    (match (g/lookup graph (get (.inputs operands) (+ (.offset range) k)))
                      (Some [piece] (unless (= (n/type-id piece) (.ty spec)) (set! direct false)))
                      (None [] (set! direct false)))))))))
        (let [answer (build-core-results (mut aliases) intervals requirements graph scheduled
                       static-sizes (slice (.output-ranges operands)) blocks depths
                       (and direct (> count 0)) a)]
          (free! (mut aliases)) answer)))))

;;; The temporary vreg aliases are absorbed by the finalized location index.
;;; Keeping their owner here releases them on every build-core error path.
(defn build-prepared-with-outputs [(intervals (ArrayList ranges/Value))
             (requirements (ArrayList constraints/Value))
             (graph g/Graph)
             (scheduled schedule/Schedule)
             (static-sizes (ArrayList i64))
             (outputs (slice machine/Range))
             (blocks cfg/Blocks)
             (depths (ArrayList i32))
             (allocator (dyn Allocator))] (-> (Result Assigned (slice u8)))
  (let [(mut aliases) (ArrayList::new [i32] allocator)
        result
          (build-core (mut aliases)
                      intervals
                      requirements
                      graph
                      scheduled
                      static-sizes
                      outputs
                      blocks
                      depths
                      allocator)]
    (free! (mut aliases))
    result))

;;; Compatibility callers have ordinary single-result definitions.
(defn build-prepared [(intervals (ArrayList ranges/Value))
                       (requirements (ArrayList constraints/Value))
                       (graph g/Graph) (scheduled schedule/Schedule)
                       (static-sizes (ArrayList i64)) (blocks cfg/Blocks)
                       (depths (ArrayList i32)) (allocator (dyn Allocator))]
  (-> (Result Assigned (slice u8)))
  (build-prepared-with-outputs intervals requirements graph scheduled static-sizes
                                [] blocks depths allocator))

;;; Low-level callers without a prepared CFG retain contained-copy reuse.
(defn build-selected [(intervals (ArrayList ranges/Value))
                      (requirements (ArrayList constraints/Value))
                      (graph g/Graph) (scheduled schedule/Schedule)
                      (static-sizes (ArrayList i64))
                      (allocator (dyn Allocator))] (-> (Result Assigned (slice u8)))
  (let [(mut blocks) (cfg/Blocks :starts (ArrayList::new [i32] allocator)
                                :membership (ArrayList::new [i32] allocator)
                                :edges (ArrayList::new [cfg/Edge] allocator))
        (mut depths) (ArrayList::new [i32] allocator)
        result (build-prepared intervals requirements graph scheduled static-sizes blocks depths allocator)]
    (cfg/release! (mut blocks))
    (free! (mut depths))
    result))

;;; Compatibility callers receive the same fixed-object selection as matching.
(defn build [(intervals (ArrayList ranges/Value))
             (requirements (ArrayList constraints/Value))
             (graph g/Graph)
             (scheduled schedule/Schedule)
             (allocator (dyn Allocator))] (-> (Result Assigned (slice u8)))
  (let [(mut sizes) (static-stack/select graph scheduled allocator)
        result (build-selected intervals requirements graph scheduled sizes allocator)]
    (free! (mut sizes))
    result))
