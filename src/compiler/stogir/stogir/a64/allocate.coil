;;; Bridge selected typed constraints and live ranges into allocation parts.
(module stogir.a64.allocate)
(import "stogir.split-position" :as split-position)
(import "stogir.live-ranges" :as ranges)
(import "stogir.matched-uses" :as machine)
(import "stogir.a64.constraints" :as constraints)
(import "stogir.a64.coalesce" :as coalesce)
(import "stogir.a64.static-stack" :as static-stack)
(import "stogir.a64.word-constant" :as word-constant)
(import "stogir.a64.preferences" :as preferences)
(import "stogir.allocation" :as allocation)
(import "stogir.allocation-snapshot" :as snapshot)
(import "stogir.allocation-regional" :as regional)
(import "stogir.allocation-regions" :as regions)
(import "stogir.allocation-transfers" :as transfers)
(import "stogir.allocation-recolor" :as recolor)
(import "stogir.allocation-check" :as check)
(import "stogir.allocation-spans" :as spans)
(import "stogir.interval" :as range)
(import "stogir.locations" :as locations)
(import "stogir.frame" :as frame)
(import "stogir.graph" :as g)
(import "stogir.cfg" :as cfg)
(import "stogir.calls" :as calls)
(import "stogir.call-results" :as results)
(import "stogir.node" :as n)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.callee-saved" :as callee)
(import "stogir.types" :as types)
(import "stogir.locals" :as locals)
(import "stogir.stack" :as stack)
(import "stogir.a64.frame-address" :as address)
(import "stogir.schedule" :as schedule)
(import "stogir.a64.call-abi" :as call-abi)
(import "stogir.a64.private-leaf" :as private)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

;;; Shrink-wrapping needs the frameless entry path to leave x19..x28 untouched.
;;; Under late-preserved, values starting before the first call take a
;;; call-clobbered register until that call when one is free that long
;;; (allocation.Late).
(defn late-preserved [(graph g/Graph) (scheduled schedule/Schedule) (context private/Context)]
  (-> allocation/Late)
  (if (not (private/late-preserved? context))
      (allocation/no-late)
      (let [(mut first) (: -1 i64)]
        (for [i 0 (len (.nodes scheduled))]
          (when (< first 0)
            (let [opcode (n/opcode (get (.instructions graph) (cast i64 (get (.nodes scheduled) i))))]
              (when (or (= opcode 79) (= opcode 80)) (set! first (* (cast i64 i) 2))))))
        (if (< first 0)
            (allocation/no-late)
            (allocation/Late :position first :mask (: 0x1FF80000 u64))))))

(defstruct Assigned
  [(parts (ArrayList allocation/Part))
   (locations locations/Index)
   (frame frame/Frame)
   (link-slot i64)
   (base address/Base)
   (outgoing-size i64)
   (alignment i64)
   (entry-slot i64)
   (result results/Spec)
   (result-slot i64)
   (callee callee/Saved)
   ; Borrowed only during emission from its owned transfer-resolution plan.
   (established-homes (slice i64))
   ; Borrowed only during emission: a64.shrink-wrap region flags, or empty.
   (frameless (slice u8))
   ; Emission option: a SWITCH default that only reaches UNREACHABLE is pruned.
   (prune-default bool)
   ; Emission option: blocks are ordered by static branch prediction.
   (predict bool)
   ; Values cut at framed spans (stogir.allocation-spans), ascending. Their
   ; children are not suffixes, and they take no canonical spill home.
   (cut-parents (ArrayList i32))
   ; The frame may be dropped again where framed blocks rejoin frameless code.
   (frame-split bool)])

;;; Whether parent was cut at a framed span before allocation.
(defn cut-parent? [(assigned Assigned) (parent i32)] (-> bool)
  (let [list (.cut-parents assigned)
        (mut lo) 0 (mut hi) (len list)]
    (while (< lo hi)
      (let [mid (+ lo (/ (- hi lo) 2))]
        (if (< (get list mid) parent) (set! lo (+ mid 1)) (set! hi mid))))
    (and (< lo (len list)) (= (get list lo) parent))))

(defn release! [(assigned (mut Assigned))] (-> void)
  (let [(mut i) 0]
    (while (< i (len (.parts assigned)))
      (allocation/release! (elem (mut (.parts assigned)) i))
      (set! i (+ i 1))))
  (locations/release-index! (mut (.locations assigned)))
  (free! (mut (.parts assigned)))
  (free! (mut (.cut-parents assigned)))
  (frame/release! (mut (.frame assigned))))

;;; Merge constant recipes with sorted frame recipes transactionally. A selected
;;; constant view must have no allocated child. Existing frame kinds are intact.
(defn index-word-constants! [(index (mut locations/Index)) (graph g/Graph)
                             (requirements (ArrayList constraints/Value))
                             (a (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [(mut merged) (ArrayList::new [locations/Rematerialized] a)
        (mut cursor) (: 0 i64) (mut count) (: 0 i32) (mut error) ""
        original (.rematerialized index)]
    (for [r 1 (len requirements)]
      (when (and (= error "") (.rematerialized (get requirements r)))
        (let [source (word-constant/recipe graph (cast i32 r))]
          (when (< source 0)
            (while (and (< cursor (len original))
                        (< (cast i64 (.parent (get original cursor))) r))
              (push! (mut merged) (get original cursor))
              (set! cursor (+ cursor 1)))
            (if (or (>= r (len (.parents index)))
                    (!= (.count (get (.parents index) r)) 0)
                    (and (< cursor (len original)) (= (cast i64 (.parent (get original cursor))) r)))
                (set! error "constant view still has a location or allocation")
                (do
                  (push! (mut merged) (locations/Rematerialized :parent (cast i32 r)
                    :location (locations/Location :kind 4 :value (cast i64 source))))
                  (set! count (+ count 1))))))))
    (if (or (!= error "") (= count 0))
        (do (free! (mut merged)) (if (= error "") (Ok 0) (Err error)))
        (do
          (while (< cursor (len original))
            (push! (mut merged) (get original cursor)) (set! cursor (+ cursor 1)))
          (free! (mut (.rematerialized index)))
          (set! (.rematerialized index) merged)
          (Ok count)))))

(defn make-index [(parts (ArrayList allocation/Part)) (aliases (ArrayList i32)) (graph g/Graph)
                  (static-sizes (ArrayList i64)) (requirements (ArrayList constraints/Value))
                  (area frame/Frame) (base address/Base) (a (dyn Allocator))]
  (-> (Result locations/Index (slice u8)))
  (match (locations/build-index parts (len (.instructions graph)) a)
    (Err [message] (Err message))
    (Ok [owned]
      (let [(mut index) owned (mut error) ""]
        (coalesce/index! (mut index) aliases)
        (match (static-stack/index! (mut index) area static-sizes base)
          (Err [message] (set! error message))
          (Ok [_] (match (index-word-constants! (mut index) graph requirements a)
            (Err [message] (set! error message)) (Ok [_] 0))))
        (if (= error "") (Ok index) (do (locations/release-index! (mut index)) (Err error)))))))

;;; Rebuild after assignment changes, including all aliases and recipes. The
;;; old index remains intact until the complete replacement succeeds.
(defn bind-index! [(assigned (mut Assigned)) (aliases (ArrayList i32)) (graph g/Graph)
                   (static-sizes (ArrayList i64)) (requirements (ArrayList constraints/Value))
                   (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (match (make-index (.parts assigned) aliases graph static-sizes requirements (.frame assigned) (.base assigned) allocator)
    (Err [message] (Err message))
    (Ok [index]
      (locations/release-index! (mut (.locations assigned)))
      (set! (.locations assigned) index) (Ok 0))))

;;; Partition candidates are separately owned. A no-improvement search leaves
;;; the original parts/index untouched. Successful assignments allocate real
;;; typed homes before the final callee-save area is chosen.
(defn apply-regional! [(assigned (mut Assigned)) (aliases (ArrayList i32)) (graph g/Graph)
                       (blocks cfg/Blocks) (scheduled schedule/Schedule) (depths (ArrayList i32))
                       (static-sizes (ArrayList i64)) (requirements (ArrayList constraints/Value))
                       (matched machine/Plan) (shapes (slice allocation/SpillShape))
                       (register-count i32) (allowed u64) (policy regional/Plan)
                       (trace bool) (a (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [(mut error) "" (mut total) (: 0 i32)]
    (let [items-106 (.regions policy) (mut for-index-106) (: 0 i64)] (while (< for-index-106 (len items-106)) (let [region (get items-106 for-index-106)]
      (when (= error "")
        (let [(mut candidate) (regional/partition (.parts assigned) region a)]
          (match (make-index (.parts candidate) aliases graph static-sizes requirements (.frame assigned) (.base assigned) a)
            (Err [message] (set! error message))
            (Ok [owned-index]
              (let [(mut index) owned-index (mut retained) false]
                (match (transfers/build (.parts candidate) index graph blocks scheduled depths matched a)
                  (Err [message] (set! error message))
                  (Ok [owned-copies]
                    (let [(mut copies) owned-copies (mut changes) (ArrayList::new [recolor/Change] a)]
                      (when (> (len (.weights policy)) 0)
                        (for [i 0 (len copies)]
                          (let [copy (elem (mut copies) i)]
                            (assert (< (.site copy) (len (.weights policy))))
                            (set! (.weight copy) (get (.weights policy) (.site copy))))))
                      (let [before (recolor/score (.parts candidate) copies changes)]
                        (match (recolor/run-scoped! (mut (.parts candidate)) (mut (.frame assigned)) shapes copies
                                 register-count allowed (slice (.mutable candidate)) true a)
                          (Err [message] (set! error message))
                          (Ok [count]
                            (when trace
                              (println "ra-regional region {} before {} after {} changes {}"
                                (.anchor region) before (recolor/score (.parts candidate) copies changes) count))
                            (when (> count 0)
                              (regional/release-parts! (mut (.parts assigned)))
                              (locations/release-index! (mut (.locations assigned)))
                              (set! (.parts assigned) (.parts candidate))
                              (set! (.parts candidate) (ArrayList::new [allocation/Part] a))
                              (set! (.locations assigned) index) (set! retained true)
                              (set! total (+ total count))
                              (match (bind-index! (mut assigned) aliases graph static-sizes requirements a)
                                (Err [message] (set! error message)) (Ok [_] 0))))))
                      (free! (mut copies)) (free! (mut changes)))))
                (unless retained (locations/release-index! (mut index))))))
          (regional/release-partition! (mut candidate))))) (set! for-index-106 (+ for-index-106 1))))
    (when (and (= error "") trace (> (len (.regions policy)) 0))
      (snapshot/parts "regional" (.parts assigned)))
    (if (= error "") (Ok total) (Err error))))

(defn finish-with-policy! [(assigned (mut Assigned)) (aliases (ArrayList i32)) (graph g/Graph)
               (blocks cfg/Blocks) (scheduled schedule/Schedule) (depths (ArrayList i32))
               (static-sizes (ArrayList i64)) (requirements (ArrayList constraints/Value))
               (matched machine/Plan) (shapes (slice allocation/SpillShape)) (register-count i32) (allowed u64)
               (context private/Context) (policy regional/Plan) (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [(mut error) ""]
    (match (check/verify (.parts assigned) register-count allowed)
      (Err [message] (set! error message)) (Ok [_] 0))
    (when (= error "")
      (regions/run! (mut (.parts assigned)) graph blocks scheduled allocator)
      (match (check/verify (.parts assigned) register-count allowed)
        (Err [message] (set! error message)) (Ok [_] 0)))
    (when (= error "")
      (match (bind-index! (mut assigned) aliases graph static-sizes requirements allocator)
        (Err [message] (set! error message)) (Ok [_] 0)))
    (when (and (= error "") (private/recolor? context))
      (match (transfers/build (.parts assigned) (.locations assigned) graph blocks scheduled depths matched allocator)
        (Err [message] (set! error message))
        (Ok [copies]
          (let [(mut copies) copies (mut plan) (ArrayList::new [recolor/Change] allocator)]
            (when (private/allocation-trace? context)
              (println "ra-recolor before {}" (recolor/score (.parts assigned) copies plan)))
            (match (recolor/run! (mut (.parts assigned)) (mut (.frame assigned)) shapes copies
                                register-count allowed allocator)
              (Err [message] (set! error message))
              (Ok [count]
                (when (private/allocation-trace? context)
                  (println "ra-recolor after {} changes {}" (recolor/score (.parts assigned) copies plan) count)
                  (snapshot/parts "recolor" (.parts assigned)))))
            (free! (mut plan)) (free! (mut copies)))))
      (when (= error "")
        (match (bind-index! (mut assigned) aliases graph static-sizes requirements allocator)
          (Err [message] (set! error message)) (Ok [_] 0))))
    (when (and (= error "") (> (len (.regions policy)) 0))
      (match (apply-regional! (mut assigned) aliases graph blocks scheduled depths static-sizes requirements
                matched shapes register-count allowed policy (private/allocation-trace? context) allocator)
        (Err [message] (set! error message)) (Ok [_] 0)))
    (when (= error "")
      (match (callee/layout! (.parts assigned) (mut (.frame assigned)))
        (Err [message] (set! error message))
        (Ok [saved] (set! (.callee assigned) saved))))
    (if (= error "") (Ok 0) (Err error))))

(defn finish! [(assigned (mut Assigned)) (aliases (ArrayList i32)) (graph g/Graph)
               (blocks cfg/Blocks) (scheduled schedule/Schedule) (depths (ArrayList i32))
               (static-sizes (ArrayList i64)) (requirements (ArrayList constraints/Value))
               (matched machine/Plan) (shapes (slice allocation/SpillShape)) (register-count i32) (allowed u64)
               (context private/Context) (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [(mut policy) (regional/empty allocator)
        result (finish-with-policy! (mut assigned) aliases graph blocks scheduled depths static-sizes requirements
                 matched shapes register-count allowed context policy allocator)]
    (regional/release! (mut policy)) result))

;;; Explicit per-value GPR/SIMD masks; GPR-only graphs scan through x28, excluding reserved registers.
;;; x16/x17 and v30/v31 are reserved for emission/resolution.
;;; Calls reserve caller-saved registers and a link-register frame slot.
(defn build-core-results-with-policy [(aliases (mut (ArrayList i32)))
                  (intervals (ArrayList ranges/Value))
                  (requirements (ArrayList constraints/Value))
                  (graph g/Graph)
                  (scheduled schedule/Schedule)
                  (static-sizes (ArrayList i64))
                  (outputs (slice machine/Range))
                  (blocks cfg/Blocks)
                  (depths (ArrayList i32))
                  (direct-results bool)
                  (result-hints (slice preferences/ResultHint))
                  (allocator (dyn Allocator))
                  (tail-modes (slice i32)) (context private/Context)
                  (split-blocks (slice split-position/Block)) (matched machine/Plan) (policy regional/Plan)
                  (framed (slice range/Range)) (last (slice range/Range))]
  (-> (Result Assigned (slice u8)))
  (let [(mut assigned)
          (Assigned
            :parts (ArrayList::new [allocation/Part] allocator)
            :locations (locations/empty-index allocator)
            :frame (frame/create allocator)
            :link-slot -1
            :base (address/stack-base)
            :outgoing-size 0
            :alignment 16
            :entry-slot -1
            :result (results/ordinary)
            :result-slot -1
            :callee (callee/none) :established-homes [] :frameless []
            :prune-default (private/prune-default? context)
            :predict (private/predict? context)
            :cut-parents (ArrayList::new [i32] allocator)
            :frame-split (private/frame-split? context))
        (mut shapes) (ArrayList::new [allocation/SpillShape] allocator)
        (mut i) 1
        (mut frame-error) ""
        (mut anchored?) false
        (mut passed) (: 0 i64)
        (mut register-count) (: 29 i32)
        (mut allowed) (registers/gpr-mask)]
    (reserve! (mut shapes) (+ (len intervals) 1))
    (push! (mut shapes) (allocation/SpillShape :size 0 :alignment 0))
    (while (< i (len intervals))
      (let [interval (at intervals i)
            uses (at requirements i)
            ty (cast i32 (n/type-id (get (.instructions graph) i)))
            width (types/size ty 8)
            extent (if (> width 8) (cast i64 width) (: 8 i64))]
        (when (and (> (len (.ranges interval)) 0)
                   (or (<= width 0) (> width 16)))
          (set! frame-error "unsupported allocated value extent"))
        ; Spill geometry stays indexed by graph reference, including dead cells.
        (push! (mut shapes)
               (allocation/SpillShape :size extent :alignment extent))
        (when (and (registers/simd-type? ty) (> (len (.ranges interval)) 0))
          (set! register-count 64)
          (set! allowed (| (registers/gpr-mask) (registers/simd-mask))))
        ; Parts use explicit parent refs, never their array position as a ref.
        ; Preserve constraints even on a part without ranges. Only records with
        ; neither ranges nor uses are inert for allocation and location lookup.
        (when (or (> (len (.ranges interval)) 0) (> (len (.uses uses)) 0))
          (let [(mut part) (allocation/create (cast i32 i) allocator)]
            (set! (.allowed part) (registers/class-mask ty))
            (when (> (len (.ranges interval)) 0)
              (extend! (mut (.ranges part)) (.data (.ranges interval)) (len (.ranges interval))))
            (when (> (len (.uses uses)) 0)
              (extend! (mut (.uses part)) (.data (.uses uses)) (len (.uses uses))))
            (push! (mut (.parts assigned)) part))))
      (set! i (+ i 1)))
    (set! aliases
          (if (= (len depths) 0)
              (coalesce/run! (mut (.parts assigned)) graph scheduled allocator)
              (coalesce/run-prepared! (mut (.parts assigned)) graph scheduled blocks depths
                                      (slice intervals) allocator)))
    (let [(mut views) (ArrayList::new [i32] allocator)]
      (preferences/prepare-collecting! (mut (.parts assigned)) graph scheduled aliases (mut views))
      (when direct-results
        (preferences/apply-results! (mut (.parts assigned)) graph aliases result-hints))
      (preferences/inherit! (mut (.parts assigned)) views)
      (free! (mut views)))
    ; Incoming GPRs are already live at entry. Reserve each until its PARAM
    ; definition so earlier stack-parameter loads cannot destroy that value.
    (set! i 0)
    (while (< i (len (.nodes scheduled)))
      (let [reference (get (.nodes scheduled) i)
            node (get (.instructions graph) (cast i64 reference))]
        (when (= (n/opcode node) 71)
          (let [parameter (.parameter (at requirements (cast i64 reference)))]
            (when (or (= (.kind parameter) 0) (= (.kind parameter) 2))
              (allocation/reserve! (mut (.parts assigned))
                                   (+ (.register parameter)
                                      (if (= (.kind parameter) 2) 32 0))
                                   0
                                   (+ (* i 2) 1)
                                   allocator)))))
      (set! i (+ i 1)))
    (let [items-105 (.nodes scheduled) (mut for-index-105) (: 0 i64)] (while (< for-index-105 (len items-105)) (let [reference (get items-105 for-index-105)]
      (let [node (get (.instructions graph) (cast i64 reference))
            opcode (cast i32 (n/opcode node))]
        (when (and (stack/operation? opcode)
                   (= (static-stack/size static-sizes reference) 0))
          (set! anchored? true))
        (when (or (= opcode 72) (= opcode 81) (= opcode 70))
          (let [(mut requested) (cast i64 (.op3 node))]
            ; VAR's zero alignment requests the type's natural alignment.
            (when (= opcode 72)
              (match (locals/shape graph reference 8)
                (Err [message] (set! frame-error message))
                (Ok [shape] (set! requested (.alignment shape)))))
            (when (> requested (.alignment assigned))
              (if (frame/valid-alignment? requested)
                  (set! (.alignment assigned) requested)
                  (set! frame-error "invalid frame object alignment"))))))) (set! for-index-105 (+ for-index-105 1))))
    (when (> (.alignment assigned) 16) (set! anchored? true))
    (match (call-abi/outgoing graph scheduled)
      (Err [msg] (set! frame-error msg))
      (Ok [area]
          (set! (.size (.frame assigned)) (.size area))
          (match (frame/aligned-size (.frame assigned) (.alignment assigned))
            (Err [message] (set! frame-error message))
            (Ok [aligned]
                (set! passed (.passed area))
                (set! (.outgoing-size assigned) aligned)))))
    (let [calls
            (call-abi/reserve-with-context! (mut (.parts assigned))
                                           graph
                                           scheduled
                                           (= register-count 64)
                                           intervals
                                           outputs
                                           tail-modes context
                                           allocator)
          record? (or anchored? (> calls 0))
          ; No callee reads memory at SP, so the outgoing area holds only this
          ; function's own call storage and may lie above the frame record. The
          ; record at SP itself lets the prologue and epilogue fold the frame's
          ; SP adjustment into the record's store and reload. An anchored frame
          ; keeps the area at SP, beneath its dynamic stack objects.
          beneath? (and record? (not anchored?) (= passed 0)
                        (> (.outgoing-size assigned) 0))]
      (set! (.size (.frame assigned)) (if beneath? 0 (.outgoing-size assigned)))
      (when record?
        (match (frame/spill-slot! (mut (.frame assigned))
                                  0
                                  (if (> (.alignment assigned) 16) 32 16)
                                  16)
          (Err [msg] (set! frame-error msg))
          (Ok [offset]
              (set! (.link-slot assigned) (+ offset 8))
              (when (> (.alignment assigned) 16)
                (set! (.entry-slot assigned) (+ offset 16)))
              (when anchored?
                (set! (.base assigned) (address/Base :reg 29 :bias offset :call-area 0)))
              (when beneath?
                (set! (.base assigned)
                      (address/Base :reg 31 :bias 0 :call-area (.size (.frame assigned))))
                (set! (.size (.frame assigned))
                      (+ (.size (.frame assigned)) (.outgoing-size assigned))))))))
    (match (calls/function-result graph)
      (Err [message] (set! frame-error message))
      (Ok [result]
          (set! (.result assigned) result)
          (when (and (= (.kind result) 1) (not direct-results))
            ; The entry reference cannot also own a VAR slot. Keep this private
            ; result buffer separate from all user objects and split-value spills.
            (match (frame/local-slot! (mut (.frame assigned))
                                      (get (.nodes scheduled) 0)
                                      (results/size result)
                                      (cast i64
                                            (types/size (cast i32
                                                              (.ty result))
                                                        8)))
              (Err [message] (set! frame-error message))
              (Ok [offset] (set! (.result-slot assigned) offset))))))
    (let [items-104 (.nodes scheduled) (mut for-index-104) (: 0 i64)] (while (< for-index-104 (len items-104)) (let [reference (get items-104 for-index-104)]
      (let [node (get (.instructions graph) (cast i64 reference))]
        (when (or (= (n/opcode node) 72) (> (static-stack/size static-sizes reference) 0))
          (match (if (= (n/opcode node) 72)
                     (locals/shape graph reference 8)
                     (Ok [locals/Shape (slice u8)]
                         (locals/Shape :size (static-stack/size static-sizes reference)
                                       :alignment (if (> (.op3 node) 16)
                                                      (cast i64 (.op3 node)) 16))))
            (Err [message] (set! frame-error message))
            (Ok [shape]
                (match (frame/local-slot! (mut (.frame assigned))
                                          reference
                                          (.size shape)
                                          (.alignment shape))
                  (Err [message] (set! frame-error message))
                  (Ok [_] 0))))))) (set! for-index-104 (+ for-index-104 1))))
    (if (!= frame-error "")
        (do (free! (mut shapes)) (release! (mut assigned)) (Err frame-error))
        (let [(mut definition-moves) (ArrayList::new [i64] allocator)]
          ; Calls lower transitions at the definition phase explicitly after
          ; capturing operands. Other general moves require input boundaries.
          (for [index 0 (len (.nodes scheduled))]
            (let [opcode (n/opcode (get (.instructions graph)
                                       (cast i64 (get (.nodes scheduled) index))))]
              (when (or (= opcode 79) (= opcode 80))
                (push! (mut definition-moves) (+ (* index 2) 1)))))
          (let [tuning (allocation/Tuning
                          :late (late-preserved graph scheduled context)
                          :loop-reloads (private/loop-reloads? context)
                          :loop-evict-mask (if (private/loop-evict? context)
                                              (: 0x1FF80000 u64) (: 0 u64))
                          :call-holes (private/call-holes? context))]
            ; Frames that shrink-wrapping never wraps (a64.shrink-wrap) gain
            ; nothing from a cut.
            (when (and (> (len framed) 0)
                       (< (.entry-slot assigned) 0)
                       (<= (.alignment assigned) 16)
                       (< (.result-slot assigned) 0))
              (spans/cut! (mut (.parts assigned)) (slice definition-moves) framed last
                          (mut (.cut-parents assigned)) allocator)
              (when (private/allocation-trace? context)
                (for span framed (println "ra-framed span {} {}" (.start span) (.end span)))
                (for parent (.cut-parents assigned) (println "ra-framed cut {}" parent))))
            (when (private/allocation-trace? context)
              (snapshot/input (.parts assigned) (.frame assigned) register-count allowed
                (slice shapes) (slice definition-moves) split-blocks tuning)
              (for [i 0 (len (.nodes scheduled))]
                (let [ref (get (.nodes scheduled) i)
                      node (get (.instructions graph) (cast i64 ref))]
                  (println "ra-snapshot node {} {} {} {} {} {}" (* i 2) ref
                    (.header node) (.op1 node) (.op2 node) (.op3 node))))
              (let [items-103 (.edges blocks) (mut for-index-103) (: 0 i64)] (while (< for-index-103 (len items-103)) (let [edge (get items-103 for-index-103)]
                (println "ra-snapshot edge {} {}" (.from edge) (.to edge))) (set! for-index-103 (+ for-index-103 1))))
              ; Version 2 makes boundary-cost analysis include coalesced values
              ; and PHI copies rather than counting only ordinary live values.
              (for [r 1 (len aliases)]
                (let [owner (coalesce/canonical aliases (cast i32 r))]
                  (when (!= owner (cast i32 r))
                    (println "ra-snapshot alias {} {}" r owner))))
              (let [items-102 (.nodes scheduled) (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [ref (get items-102 for-index-102)]
                (let [node (get (.instructions graph) (cast i64 ref))]
                  (when (= (n/opcode node) 67)
                    (for [i 0 (len (.edges blocks))]
                      (let [edge (get (.edges blocks) i)]
                        (when (= (.to edge) (.op1 node))
                          (match (g/operand graph ref (+ (.position edge) 1))
                            (None [] (panic "allocation trace: phi operand missing"))
                            (Some [source] (println "ra-snapshot phi {} {} {}" i source ref))))))))) (set! for-index-102 (+ for-index-102 1)))))
          (let [result
                (allocation/run-shaped-with-tuning! (mut (.parts assigned))
                  (mut (.frame assigned)) register-count allowed (slice shapes)
                  (slice definition-moves) split-blocks tuning allocator)]
            (when (private/allocation-trace? context)
              (snapshot/parts "output" (.parts assigned))
              (println "ra-snapshot end"))
          (free! (mut definition-moves))
          (let [finished
            (match result
              (Err [message] (release! (mut assigned)) (Err message))
              (Ok [_]
                (match (finish-with-policy! (mut assigned) aliases graph blocks scheduled depths static-sizes
                                requirements matched (slice shapes) register-count allowed context policy allocator)
                  (Err [message] (release! (mut assigned)) (Err message))
                  (Ok [_] (Ok assigned)))))]
            (free! (mut shapes))
            finished)))))))

(defn build-core-results-with-plan [(aliases (mut (ArrayList i32)))
                  (intervals (ArrayList ranges/Value)) (requirements (ArrayList constraints/Value))
                  (graph g/Graph) (scheduled schedule/Schedule) (static-sizes (ArrayList i64))
                  (outputs (slice machine/Range)) (blocks cfg/Blocks) (depths (ArrayList i32))
                  (direct-results bool) (result-hints (slice preferences/ResultHint))
                  (allocator (dyn Allocator)) (tail-modes (slice i32)) (context private/Context)
                  (split-blocks (slice split-position/Block)) (matched machine/Plan)] (-> (Result Assigned (slice u8)))
  (let [(mut policy) (regional/empty allocator)
        result (build-core-results-with-policy (mut aliases) intervals requirements graph scheduled static-sizes
                 outputs blocks depths direct-results result-hints allocator tail-modes context split-blocks matched policy [] [])]
    (regional/release! (mut policy)) result))

;;; Compatibility callers have no selected multi-output definitions.
(defn build-core-results-with-splits [(aliases (mut (ArrayList i32)))
                  (intervals (ArrayList ranges/Value)) (requirements (ArrayList constraints/Value))
                  (graph g/Graph) (scheduled schedule/Schedule) (static-sizes (ArrayList i64))
                  (outputs (slice machine/Range)) (blocks cfg/Blocks) (depths (ArrayList i32))
                  (direct-results bool) (result-hints (slice preferences/ResultHint))
                  (allocator (dyn Allocator)) (tail-modes (slice i32)) (context private/Context)
                  (split-blocks (slice split-position/Block))] (-> (Result Assigned (slice u8)))
  (let [(mut matched) (machine/identity graph scheduled allocator)
        result (build-core-results-with-plan (mut aliases) intervals requirements graph scheduled
                 static-sizes outputs blocks depths direct-results result-hints allocator tail-modes context split-blocks matched)]
    (machine/release! (mut matched)) result))

;;; Compatibility private entry without prepared split metadata.

(defn build-core-results-with-private [(aliases (mut (ArrayList i32)))
                  (intervals (ArrayList ranges/Value)) (requirements (ArrayList constraints/Value))
                  (graph g/Graph) (scheduled schedule/Schedule) (static-sizes (ArrayList i64))
                  (outputs (slice machine/Range)) (blocks cfg/Blocks) (depths (ArrayList i32))
                  (direct-results bool) (result-hints (slice preferences/ResultHint))
                  (allocator (dyn Allocator)) (tail-modes (slice i32)) (context private/Context)]
  (-> (Result Assigned (slice u8)))
  (build-core-results-with-splits (mut aliases) intervals requirements graph scheduled
    static-sizes outputs blocks depths direct-results result-hints allocator tail-modes context []))

;;; Complete-ABI compatibility entry for low-level allocation callers.
(defn build-core-results [(aliases (mut (ArrayList i32)))
                  (intervals (ArrayList ranges/Value)) (requirements (ArrayList constraints/Value))
                  (graph g/Graph) (scheduled schedule/Schedule) (static-sizes (ArrayList i64))
                  (outputs (slice machine/Range)) (blocks cfg/Blocks) (depths (ArrayList i32))
                  (direct-results bool) (result-hints (slice preferences/ResultHint))
                  (allocator (dyn Allocator))] (-> (Result Assigned (slice u8)))
  (build-core-results-with-private (mut aliases) intervals requirements graph scheduled
    static-sizes outputs blocks depths direct-results result-hints allocator [] (private/no-context)))

;;; Compatibility entry preserves the original implicit result-buffer policy.
(defn build-core [(aliases (mut (ArrayList i32))) (intervals (ArrayList ranges/Value))
                  (requirements (ArrayList constraints/Value)) (graph g/Graph)
                  (scheduled schedule/Schedule) (static-sizes (ArrayList i64))
                  (outputs (slice machine/Range)) (blocks cfg/Blocks)
                  (depths (ArrayList i32)) (allocator (dyn Allocator))]
  (-> (Result Assigned (slice u8)))
  (build-core-results (mut aliases) intervals requirements graph scheduled static-sizes
                      outputs blocks depths false [] allocator))

;;; Selected return uses replace the implicit private buffer only as a complete
;;; GP group at every scheduled RETURN, with no remaining result-place PARAM.
(defn build-prepared-with-machine-private-policy [(intervals (ArrayList ranges/Value))
             (requirements (ArrayList constraints/Value)) (graph g/Graph)
             (scheduled schedule/Schedule) (static-sizes (ArrayList i64))
             (operands machine/Plan) (blocks cfg/Blocks) (depths (ArrayList i32))
             (a (dyn Allocator)) (tail-modes (slice i32)) (context private/Context) (split-blocks (slice split-position/Block)) (policy regional/Plan)
             (framed (slice range/Range)) (last (slice range/Range))] (-> (Result Assigned (slice u8)))
  (match (calls/function-result graph)
    (Err [message] (Err message))
    (Ok [spec]
      (let [(mut direct) (and (= (.kind spec) 1) (or (= (.ty spec) 5) (= (.ty spec) 11)))
            (mut count) 0 (mut aliases) (ArrayList::new [i32] a)
            (mut hints) (ArrayList::new [preferences/ResultHint] a)]
        (let [items-101 (.nodes scheduled) (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [ref (get items-101 for-index-101)]
          (let [node (get (.instructions graph) (cast i64 ref))]
            (when (and (= (n/opcode node) 71) (= (.op3 node) 0)) (set! direct false))
            (when (= (n/opcode node) 120)
              (set! count (+ count 1))
              (let [range (get (.ranges operands) (cast i64 ref))]
                (unless (= (.count range) (+ (cast i64 (.count spec)) 1)) (set! direct false))
                (when direct
                  (for k (range 0 (cast i64 (.count spec)))
                    (match (g/lookup graph (get (.inputs operands) (+ (.offset range) 1 k)))
                      (Some [piece]
                        (unless (= (n/type-id piece) (.ty spec)) (set! direct false))
                        (push! (mut hints) (preferences/ResultHint
                          :reference (get (.inputs operands) (+ (.offset range) 1 k))
                          :register (cast i32 k))))
                      (None [] (set! direct false))))))))) (set! for-index-101 (+ for-index-101 1))))
        (let [answer (build-core-results-with-policy (mut aliases) intervals requirements graph scheduled
                       static-sizes (slice (.output-ranges operands)) blocks depths
                       (and direct (> count 0)) (slice hints) a tail-modes context split-blocks operands policy framed last)]
          (free! (mut aliases)) (free! (mut hints)) answer)))))

(defn build-prepared-with-machine-private-splits [(intervals (ArrayList ranges/Value))
             (requirements (ArrayList constraints/Value)) (graph g/Graph)
             (scheduled schedule/Schedule) (static-sizes (ArrayList i64))
             (operands machine/Plan) (blocks cfg/Blocks) (depths (ArrayList i32))
             (a (dyn Allocator)) (tail-modes (slice i32)) (context private/Context) (split-blocks (slice split-position/Block))]
  (-> (Result Assigned (slice u8)))
  (let [(mut policy) (regional/empty a)
        result (build-prepared-with-machine-private-policy intervals requirements graph scheduled static-sizes
                 operands blocks depths a tail-modes context split-blocks policy [] [])]
    (regional/release! (mut policy)) result))

(defn build-prepared-with-machine-private [(intervals (ArrayList ranges/Value))
             (requirements (ArrayList constraints/Value)) (graph g/Graph)
             (scheduled schedule/Schedule) (static-sizes (ArrayList i64))
             (operands machine/Plan) (blocks cfg/Blocks) (depths (ArrayList i32))
             (a (dyn Allocator)) (tail-modes (slice i32)) (context private/Context)]
  (-> (Result Assigned (slice u8)))
  (build-prepared-with-machine-private-splits intervals requirements graph scheduled static-sizes
    operands blocks depths a tail-modes context []))

(defn build-prepared-with-machine [(intervals (ArrayList ranges/Value))
             (requirements (ArrayList constraints/Value)) (graph g/Graph)
             (scheduled schedule/Schedule) (static-sizes (ArrayList i64))
             (operands machine/Plan) (blocks cfg/Blocks) (depths (ArrayList i32))
             (a (dyn Allocator))] (-> (Result Assigned (slice u8)))
  (build-prepared-with-machine-private intervals requirements graph scheduled static-sizes
    operands blocks depths a [] (private/no-context)))

;;; The temporary vreg aliases are absorbed by the finalized location index.
;;; Keeping their owner here releases them on every build-core error path.
(defn build-prepared-with-outputs [(intervals (ArrayList ranges/Value))
             (requirements (ArrayList constraints/Value))
             (graph g/Graph)
             (scheduled schedule/Schedule)
             (static-sizes (ArrayList i64))
             (outputs (slice machine/Range))
             (blocks cfg/Blocks)
             (depths (ArrayList i32))
             (allocator (dyn Allocator))] (-> (Result Assigned (slice u8)))
  (let [(mut aliases) (ArrayList::new [i32] allocator)
        result
          (build-core (mut aliases)
                      intervals
                      requirements
                      graph
                      scheduled
                      static-sizes
                      outputs
                      blocks
                      depths
                      allocator)]
    (free! (mut aliases))
    result))

;;; Compatibility callers have ordinary single-result definitions.
(defn build-prepared [(intervals (ArrayList ranges/Value))
                       (requirements (ArrayList constraints/Value))
                       (graph g/Graph) (scheduled schedule/Schedule)
                       (static-sizes (ArrayList i64)) (blocks cfg/Blocks)
                       (depths (ArrayList i32)) (allocator (dyn Allocator))]
  (-> (Result Assigned (slice u8)))
  (build-prepared-with-outputs intervals requirements graph scheduled static-sizes
                                [] blocks depths allocator))

;;; Low-level callers without a prepared CFG retain contained-copy reuse.
(defn build-selected [(intervals (ArrayList ranges/Value))
                      (requirements (ArrayList constraints/Value))
                      (graph g/Graph) (scheduled schedule/Schedule)
                      (static-sizes (ArrayList i64))
                      (allocator (dyn Allocator))] (-> (Result Assigned (slice u8)))
  (let [(mut blocks) (cfg/Blocks :starts (ArrayList::new [i32] allocator)
                                :membership (ArrayList::new [i32] allocator)
                                :edges (ArrayList::new [cfg/Edge] allocator))
        (mut depths) (ArrayList::new [i32] allocator)
        result (build-prepared intervals requirements graph scheduled static-sizes blocks depths allocator)]
    (cfg/release! (mut blocks))
    (free! (mut depths))
    result))

;;; Compatibility callers receive the same fixed-object selection as matching.
(defn build [(intervals (ArrayList ranges/Value))
             (requirements (ArrayList constraints/Value))
             (graph g/Graph)
             (scheduled schedule/Schedule)
             (allocator (dyn Allocator))] (-> (Result Assigned (slice u8)))
  (let [(mut sizes) (static-stack/select graph scheduled allocator)
        result (build-selected intervals requirements graph scheduled sizes allocator)]
    (free! (mut sizes))
    result))
