;;; Instruction fields shared by native relocation and Mach-O serialization.
(module stogir.a64.relocation)
(import "stogir.a64.encode" :as encode)
(import "coil.result" :use [Result Ok Err])

(defn pageoff-scale [(word u32)] (-> (Result i32 (slice u8)))
  (if (= (& word 0x7FC00000) 0x11000000)
      (Ok 0)
      (if (!= (& word 0x3B000000) 0x39000000)
          (Err "PAGEOFF12 requires unshifted ADD or unsigned-offset load/store")
          (let [size (cast i32 (>> word 30))
                vector? (!= (& word 0x04000000) 0)
                opc (cast i32 (& (>> word 22) 3))]
            (if (or (and vector? (>= opc 2) (!= size 0))
                    (and (not vector?) (= opc 3) (>= size 2)))
                (Err "reserved load/store encoding in PAGEOFF12")
                (Ok (if (and vector? (>= opc 2)) 4 size)))))))

;;; Clear existing instruction addends; the image relocation owns the addend.
(defn clear [(kind i32) (word u32)] (-> (Result u32 (slice u8)))
  (match kind
    (2 (if (or (= (& word 0xFC000000) 0x14000000)
               (= (& word 0xFC000000) 0x94000000))
           (Ok (& word 0xFC000000))
           (Err "BRANCH26 requires B or BL")))
    (3 (if (= (& word 0x9F000000) 0x90000000)
           (Ok (& word 0x9F00001F))
           (Err "PAGE21 requires ADRP")))
    (4 (match (pageoff-scale word)
         (Err [msg] (Err msg))
         (Ok [_] (Ok (& word 0xFFC003FF)))))
    (_ (Err "unsupported instruction relocation"))))

(defn page21 [(word u32) (target u64) (place u64)]
  (-> (Result u32 (slice u8)))
  (match (clear 3 word)
    (Err [msg] (Err msg))
    (Ok [base]
        (let [pages (- (cast i128 (>> target 12)) (cast i128 (>> place 12)))]
          (if (or (< pages -1048576) (> pages 1048575))
              (Err "PAGE21 target is outside signed 21-bit page range")
              (let [bits (& (cast u32 pages) 0x1FFFFF)]
                (Ok (| base (<< (& bits 3) 29) (<< (>> bits 2) 5)))))))))

(defn pageoff12 [(word u32) (target u64)] (-> (Result u32 (slice u8)))
  (match (pageoff-scale word)
    (Err [msg] (Err msg))
    (Ok [scale]
        (let [offset (& target 4095)
              alignment (<< (: 1 u64) (cast u64 scale))]
          (if (!= (% offset alignment) 0)
              (Err "PAGEOFF12 target is misaligned for scaled load/store")
              (Ok (| (& word 0xFFC003FF)
                     (<< (cast u32 (/ offset alignment)) 10))))))))

(defn branch26 [(word u32) (target u64) (place u64)]
  (-> (Result u32 (slice u8)))
  (match (clear 2 word)
    (Err [msg] (Err msg))
    (Ok [base]
        (let [delta (- (cast i128 target) (cast i128 place))]
          (if (or (< delta -134217728) (> delta 134217724))
              (Err "BRANCH26 target is outside signed 26-bit word range")
              (encode/branch (= base 0x94000000) (cast i64 delta)))))))

(defn instruction [(kind i32) (word u32) (target u64) (place u64)]
  (-> (Result u32 (slice u8)))
  (match kind
    (2 (branch26 word target place))
    (3 (page21 word target place))
    (4 (pageoff12 word target))
    (_ (Err "unsupported instruction relocation"))))
