;;; Darwin scalar parameter locations from a complete pre-DCE signature.
(module stogir.a64.incoming)
(import "stogir.allocation" :as allocation)
(import "stogir.locations" :as locations)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.frame-memory" :as memory)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.frame-address" :as frame)
(import "stogir.bytes" :as bytes)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.calls" :as calls)
(import "stogir.strings" :as strings)
(import "stogir.a64.abi-arguments" :as arguments)
(import "stogir.call-groups" :as groups)
(import "stogir.call-results" :as results)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

;;; kind: -1=absent, 0=GPR, 1=incoming stack, 2=FPR.
;;; Stack offset is relative to entry SP, before local frame allocation.
(defstruct Parameter
  [(reference i32)
   (kind i32)
   (register i32)
   (offset i64)
   (size i32)])

(defn absent [] (-> Parameter)
  (Parameter
    :reference 0
    :kind -1
    :register -1
    :offset -1
    :size 0))

;;; Requires structural verification.
;;; When no signature was supplied, every preceding parameter must have a PARAM
;;; projection, including unused ones. Otherwise register/stack positions cannot
;;; be inferred safely (in particular with mixed integer/floating parameters).
(defn build [(graph g/Graph) (entry i32) (allocator (dyn Allocator))]
  (-> (Result (ArrayList Parameter) (slice u8)))
  (let [(mut result) (ArrayList::new [Parameter] allocator)
        (mut parameters) (ArrayList::new [u8] allocator)
        (mut references) (ArrayList::new [i32] allocator)
        (mut descriptors) (ArrayList::new [groups/Group] allocator)
        (mut declared?) (!= (.function-prototype graph) 0)
        (mut return-type) (: 0 u8)
        (mut result-spec) (results/ordinary)
        (mut error) ""
        (mut r) 1]
    (when declared?
      (match (strings/lookup (.strings graph) (.function-prototype graph))
        (None [] (set! error "function prototype string missing"))
        (Some [bytes]
              (if (not (calls/valid-bytes? bytes))
                  (set! error "malformed function prototype")
                  (do
                    (when (not (or (= (& (get bytes 0) 15) 0)
                                   (= (& (get bytes 0) 15) 9)))
                      (set! error "unsupported AArch64 function convention"))
                    (set! return-type (get bytes 1))
                    (set! result-spec (results/decode bytes))
                    (let [(mut i) 3]
                      (while (< i (+ 3 (cast i64 (get bytes 2))))
                        (push! (mut parameters) (get bytes i))
                        (push! (mut references) 0)
                        (set! i (+ i 1))))
                    (let [(mut i) (: 0 i64)]
                      (while (< i (groups/count bytes))
                        (push! (mut descriptors) (groups/at bytes i))
                        (set! i (+ i 1)))))))))
    (while (and (= error "") (< r (len (.instructions graph))))
      (let [node (get (.instructions graph) r)
            count (get (.arities graph) r)]
        (when (= (n/opcode node) 71)
          (let [ordinal (cast i64 (.op3 node))]
            (if (or (!= (.op1 node) entry)
                    (< ordinal 0)
                    (and declared? (>= ordinal (len parameters)))
                    (and (not declared?)
                         (>= ordinal (len (.instructions graph)))))
                (set! error "invalid parameter region or ordinal")
                (do
                  (while (<= (len parameters) ordinal)
                    (push! (mut parameters) 0)
                    (push! (mut references) 0))
                  (when (!= (get references ordinal) 0)
                    (set! error "duplicate parameter projection"))
                  (if declared?
                      (when (!= (get parameters ordinal) (n/type-id node))
                        (set! error
                              "parameter type disagrees with function prototype"))
                      (set! (mut parameters) ordinal (n/type-id node)))
                  (set! (mut references) ordinal (cast i32 r))))))
        (when (and declared? (= (n/opcode node) 120))
          (when (!= (n/type-id node) return-type)
            (set! error "return type disagrees with function prototype"))
          (when (and (= error "") (!= return-type 0))
            (match (g/lookup graph (.op2 node))
              (None [] (set! error "return value missing"))
              (Some [value]
                    (when (!= (n/type-id value) return-type)
                      (set! error
                            "return value disagrees with function prototype"))))))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    (for ty parameters
      (when (or (= ty 0) (not (types/valid? (cast i32 ty))))
        (set! error "incomplete parameter types; declare a function prototype")))
    (when (= error "")
      (match (arguments/plan-result (slice parameters)
                                    (len parameters)
                                    false
                                    (slice descriptors)
                                    result-spec
                                    allocator)
        (Err [message] (set! error message))
        (Ok [layout]
            (let [(mut layout) layout
                  (mut i) (: 0 i64)]
              (for part (.parts layout)
                (let [reference (get references i)
                      floating?
                        (registers/simd-type? (cast i32 (get parameters i)))
                      reg (.register part)]
                  (when (> reference 0)
                    (push! (mut result)
                           (Parameter
                             :reference reference
                             :kind
                               (if (= reg -2)
                                   3
                                   (if (< reg 0) 1 (if floating? 2 0)))
                             :register
                               (if (< reg 0)
                                   (: -1 i32)
                                   (if floating? (- reg 32) reg))
                             :offset (.offset part)
                             :size (.size part)))))
                (set! i (+ i 1)))
              (arguments/release! (mut layout))))))
    (free! (mut descriptors))
    (free! (mut parameters))
    (free! (mut references))
    (if (= error "") (Ok result) (do (free! (mut result)) (Err error)))))

;;; Stack parameters load from the caller's area above the finalized local frame.
;;; Allocation requires a register at this definition; later splits may spill it.
(defn emit-entry-with-locations! [(output (mut (ArrayList u8)))
                                  (graph g/Graph)
                                  (parts locations/View)
                                  (parameter Parameter)
                                  (position i64)
                                  (frame-size i64)
                                  (base frame/Base)
                                  (entry-slot i64)] (-> (Result i32 (slice u8)))
  (if (not (frame/valid-base? base))
      (Err "invalid incoming frame base")
      (if (or (= (.kind parameter) 0) (= (.kind parameter) 2))
          (Ok 0)
          (if (or (!= (.kind parameter) 1)
                  (< (.offset parameter) 0)
                  (not (frame/valid-base? base))
                  (< frame-size (.bias base))
                  (> (.offset parameter) (- 0x7FFFFFFFFFFFFFFF frame-size))
                  (and (>= entry-slot 0)
                       (or (!= (.reg base) 29)
                           (< entry-slot (.bias base))
                           (> entry-slot (- frame-size 8)))))
              (Err "invalid incoming stack parameter")
              (match (locations/resolve parts
                                        (.reference parameter)
                                        (+ position 1))
                (Err [msg] (Err msg))
                (Ok [destination]
                    (if (!= (.kind destination) 0)
                        (Err "stack parameter definition requires register")
                        (let [node
                                (get (.instructions graph)
                                     (cast i64 (.reference parameter)))
                              size (.size parameter)
                              offset
                                (- (+ frame-size (.offset parameter))
                                   (.bias base))
                              reg (cast i32 (.value destination))]
                          (if (or (not (registers/allocatable? (cast i32
                                                                     (n/type-id node))
                                                               reg))
                                  (!= size
                                      (types/size (cast i32
                                                        (n/type-id node))
                                                  8)))
                              (Err "incoming parameter class or width mismatch")
                              (if (< entry-slot 0)
                                  (memory/access! (mut output)
                                                  true
                                                  size
                                                  reg
                                                  (.reg base)
                                                  offset
                                                  (types/signed? (cast i32
                                                                       (n/type-id node)))
                                                  16)
                                  (match (memory/access! (mut output)
                                                         true
                                                         8
                                                         16
                                                         (.reg base)
                                                         (- entry-slot
                                                            (.bias base))
                                                         false
                                                         17)
                                    (Err [message] (Err message))
                                    (Ok [count]
                                        (match (memory/access! (mut output)
                                                               true
                                                               size
                                                               reg
                                                               16
                                                               (.offset parameter)
                                                               (types/signed? (cast i32
                                                                                    (n/type-id node)))
                                                               17)
                                          (Err [message] (Err message))
                                          (Ok [more] (Ok (+ count more))))))))))))))))

(defn emit-at-with-locations! [(output (mut (ArrayList u8)))
                               (graph g/Graph)
                               (parts locations/View)
                               (parameter Parameter)
                               (position i64)
                               (frame-size i64)
                               (base frame/Base)]
  (-> (Result i32 (slice u8)))
  (emit-entry-with-locations! (mut output)
                              graph
                              parts
                              parameter
                              position
                              frame-size
                              base
                              -1))

(defn emit-with-locations! [(output (mut (ArrayList u8)))
                            (graph g/Graph)
                            (parts locations/View)
                            (parameter Parameter)
                            (position i64)
                            (frame-size i64)] (-> (Result i32 (slice u8)))
  (emit-at-with-locations! (mut output)
                           graph
                           parts
                           parameter
                           position
                           frame-size
                           (frame/stack-base)))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit-entry! [(output (mut (ArrayList u8)))
                   (graph g/Graph)
                   (parts (ArrayList allocation/Part))
                   (parameter Parameter)
                   (position i64)
                   (frame-size i64)
                   (base frame/Base)
                   (entry-slot i64)] (-> (Result i32 (slice u8)))
  (emit-entry-with-locations! (mut output)
                              graph
                              (locations/linear-view parts)
                              parameter
                              position
                              frame-size
                              base
                              entry-slot))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit-at! [(output (mut (ArrayList u8)))
                (graph g/Graph)
                (parts (ArrayList allocation/Part))
                (parameter Parameter)
                (position i64)
                (frame-size i64)
                (base frame/Base)] (-> (Result i32 (slice u8)))
  (emit-at-with-locations! (mut output)
                           graph
                           (locations/linear-view parts)
                           parameter
                           position
                           frame-size
                           base))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit! [(output (mut (ArrayList u8)))
             (graph g/Graph)
             (parts (ArrayList allocation/Part))
             (parameter Parameter)
             (position i64)
             (frame-size i64)] (-> (Result i32 (slice u8)))
  (emit-with-locations! (mut output)
                        graph
                        (locations/linear-view parts)
                        parameter
                        position
                        frame-size))
