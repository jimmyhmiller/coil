;;; Lane-wise extrema preserve the operand selection contract of scalar MIN/MAX.
(module stogir.a64.vector-extrema)
(import "stogir.vector-arithmetic" :as vector)
(import "stogir.types" :as types)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.simd-lanes" :as lanes)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn word! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (word (Result u32 (slice u8)))] (-> void)
  (match word
    (Err [message] (set! error message))
    (Ok [bits] (bytes/append32! (mut out) bits))))

;;; Destination excludes reserved v30/v31; either input may occupy either scratch.
;;; A floating comparison mask uses an unused scratch, or the distinct destination
;;; when both scratches hold inputs. Original operand bits survive BSL, even NaNs.
(defn emit-registers! [(output (mut (ArrayList u8)))
                       (opcode i32)
                       (ty i32)
                       (rd i32)
                       (rn i32)
                       (rm i32)]
  (-> (Result i32 (slice u8)))
  (if (or (not (vector/extrema? opcode))
          (not (vector/valid-type? opcode ty))
          (not (types/short-vector? ty 8))
          (< rd 0)
          (> rd 29)
          (< rn 0)
          (> rn 31)
          (< rm 0)
          (> rm 31))
      (Err "unsupported AArch64 vector extrema shape or registers")
      (let [(mut temporary) (ArrayList::new [u8] (.alc output))
            (mut error) ""
            base (types/base-type ty)
            element (types/scalar-size base 8)
            width (types/size ty 8)
            minimum? (= opcode 58)
            q (if (= width 16) (: 0x40000000 u32) (: 0 u32))]
        (if (types/floating? base)
            (if (and (= element 8) (= width 8))
                (do
                  (word! (mut temporary)
                         (mut error)
                         (encode/floating-compare true rn rm))
                  (word! (mut temporary)
                         (mut error)
                         (encode/floating-select true
                                                 rd
                                                 rn
                                                 rm
                                                 (if minimum? 9 10))))
                (let [mask
                        (if (and (!= rn 30) (!= rm 30))
                            30
                            (if (and (!= rn 31) (!= rm 31)) 31 rd))
                      first (if minimum? rm rn)
                      second (if minimum? rn rm)]
                  (bytes/append32! (mut temporary)
                                   (| (: 0x2E20E400 u32)
                                      q
                                      (if (= element 8)
                                          (: 0x00400000 u32)
                                          (: 0 u32))
                                      (cast u32 mask)
                                      (<< (cast u32 first) 5)
                                      (<< (cast u32 second) 16)))
                  (bytes/append32! (mut temporary)
                                   (| (: 0x2E601C00 u32)
                                      q
                                      (cast u32 mask)
                                      (<< (cast u32 rn) 5)
                                      (<< (cast u32 rm) 16)))
                  (when (!= mask rd)
                    (word! (mut temporary)
                           (mut error)
                           (encode/simd-move width rd mask)))))
            (if (= element 8)
                (let [(mut lane) (: 0 i32)
                      condition
                        (if (types/signed? base)
                            (if minimum? (: 13 i32) 10)
                            (if minimum? (: 9 i32) 2))]
                  (while (< lane (types/lanes ty))
                    (word! (mut temporary)
                           (mut error)
                           (lanes/lane-extract false 8 lane 16 rn))
                    (word! (mut temporary)
                           (mut error)
                           (lanes/lane-extract false 8 lane 17 rm))
                    (word! (mut temporary)
                           (mut error)
                           (encode/add-sub true true true 31 16 17))
                    (word! (mut temporary)
                           (mut error)
                           (encode/conditional-select true 16 16 17 condition))
                    (word! (mut temporary)
                           (mut error)
                           (lanes/lane-insert 8 lane rd 16))
                    (set! lane (+ lane 1))))
                (bytes/append32! (mut temporary)
                                 (| (: 0x0E206400 u32)
                                    q
                                    (if (types/signed? base)
                                        (: 0 u32)
                                        (: 0x20000000 u32))
                                    (if minimum? (: 0x800 u32) (: 0 u32))
                                    (<< (cast u32
                                              (if (= element 1)
                                                  0
                                                  (if (= element 2) 1 2)))
                                        22)
                                    (cast u32 rd)
                                    (<< (cast u32 rn) 5)
                                    (<< (cast u32 rm) 16)))))
        (let [size (cast i32 (len temporary))]
          (when (= error "")
            (extend! (mut output) (.data temporary) (len temporary)))
          (free! (mut temporary))
          (if (= error "") (Ok size) (Err error))))))
