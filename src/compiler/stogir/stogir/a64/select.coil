;;; Initial maximal-munch arithmetic selection over typed graph nodes.
(module stogir.a64.select)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.symbols" :as symbols)
(import "stogir.types" :as types)
(import "stogir.integer-binary" :as binary)
(import "stogir.conditional" :as conditional)
(import "stogir.a64.encode" :as encode)
(import "coil.result" :use [Result Ok Err Option Some None])

;;; Rules: 1..5=ADD/SUB/MUL and immediates; 6..8=logical; 9..13=shifts/rotates.
;;; 14/15=unsigned/signed DIV, 16/17=unsigned/signed MOD; 20..33=conditions.
;;; 34/35=unsigned/signed MIN, 36/37=unsigned/signed MAX.
;;; 38..40=constant shifts; 41..43=OR/AND/XOR logical immediates.
;;; 44..47=unsigned/signed DIV and MOD by a positive power of two.
;;; 48=unsigned bitfield extraction for selected TRUNC(SHR/SAR).
;;; 49=constant rotate, following pinned AArch64 IR_SHIFT_CONST.
;;; 50/51=ADD/SUB with constant word shift, chosen by persistent matching.
;;; Their immediate packs shift-kind in bits8..9 and amount in bits0..5.
;;; 52=MUL by 2^k+1 as ADD with the same source shifted by k.
;;; 53=sign extension of the low word of a 64-bit source (SXTW).
;;; Operands remain graph references until allocation. Immediate holds unsigned
;;; arithmetic bits/fields or the signed CMP/CMN displacement bit pattern.
(defstruct Tile [(rule i32) (wide bool) (left i32) (right i32) (immediate u64)])

;;; Exact word comparison choice. Comparison opcode, not result type, carries
;;; signedness: adapters may represent signed machine words with unsigned types.
;;; Both selected values are the comparison inputs, so this needs no speculative
;;; value motion. RLOAD/overflow exclusions retain the ordinary condition policy.
(defn ordered-choice [(graph g/Graph) (reference i32)] (-> (Option Tile))
  (match (g/lookup graph reference)
    (None [] (None))
    (Some [node]
      (if (and (= (n/opcode node) 60)
               (conditional/comparison-input-choice? graph (n/type-id node)
                 (.op1 node) (.op2 node) (.op3 node)))
          (let [condition (get (.instructions graph) (cast i64 (.op1 node)))
                opcode (n/opcode condition)
                less? (or (= opcode 16) (= opcode 18) (= opcode 20) (= opcode 22))
                minimum? (= less? (= (.op2 node) (.op1 condition)))]
            (Some (Tile :rule (cast i32 (+ (if minimum? 34 36) (if (< opcode 20) 1 0)))
                        :wide (= (types/scalar-size (cast i32 (n/type-id node)) 8) 8)
                        :left (.op1 condition) :right (.op2 condition) :immediate 0)))
          (None)))))

(defn immediate [(graph g/Graph) (value i32) (ty u8)] (-> (Option u64))
  (if (>= value 0)
      (None)
      (match (g/lookup graph value)
        (None [] (None))
        (Some [node]
              (let [bits (n/constant-bits node)]
                (if (and (symbols/numeric? node)
                         (or (= (n/type-id node) ty)
                             (and (= ty 6)
                                  (or (= (n/type-id node) 5)
                                      (= (n/type-id node) 11))))
                         (or (<= bits 4095)
                             (and (= (% bits 4096) 0) (<= (/ bits 4096) 4095))))
                    (Some bits)
                    (None)))))))

(defn register-rule [(opcode u8)] (-> i32)
  (match opcode
    (26 1)
    (27 2)
    (28 3)
    (46 6)
    (47 7)
    (48 8)
    (49 9)
    (50 10)
    (51 11)
    (52 12)
    (29 14)
    (30 16)
    (53 13)
    (58 34)
    (59 36)
    (_ 0)))

(defn arithmetic-register [(graph g/Graph) (reference i32)]
  (-> (Result Tile (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "selection node missing"))
    (Some [node]
          (let [opcode (n/opcode node)
                ty (n/type-id node)
                wide (or (= ty 6) (= ty 5) (= ty 11))
                rule
                  (+ (register-rule opcode)
                     (if (and (or (= opcode 29)
                                  (= opcode 30)
                                  (= opcode 58)
                                  (= opcode 59))
                              (types/signed? (cast i32 ty)))
                         1
                         0))]
            (if (or (<= reference 0)
                    (= rule 0)
                    (not (binary/valid-type? (cast i32 opcode) (cast i32 ty))))
                (Err "unsupported integer selection opcode/type")
                (match (g/lookup graph (.op1 node))
                  (None [] (Err "left operand missing"))
                  (Some [left]
                        (match (g/lookup graph (.op2 node))
                          (None [] (Err "right operand missing"))
                          (Some [right]
                                (if (or (!= (n/type-id left) ty)
                                        (not (or (= (n/type-id right) ty)
                                                 (and (= ty 6)
                                                      (or (= opcode 26)
                                                          (= opcode 27))
                                                      (or (= (n/type-id right)
                                                             5)
                                                          (= (n/type-id right)
                                                             11))))))
                                    (Err "integer operand type mismatch")
                                    (let [(mut lhs) (.op1 node)
                                          (mut rhs) (.op2 node)
                                          (mut literal)
                                            (if (or (= opcode 26) (= opcode 27))
                                                (immediate graph (.op2 node) ty)
                                                (None))]
                                      (when (= opcode 26)
                                        (match literal
                                          (Some [_] 0)
                                          (None []
                                                (match (immediate graph lhs ty)
                                                  (None [] 0)
                                                  (Some [bits]
                                                        (do
                                                          (set! literal
                                                                (Some bits))
                                                          (set! lhs rhs)
                                                          (set! rhs (.op1 node))))))))
                                      (match literal
                                        (Some [bits]
                                              (Ok (Tile
                                                    :rule (if (= opcode 26) 4 5)
                                                    :wide wide
                                                    :left lhs
                                                    :right 0
                                                    :immediate bits)))
                                        (None []
                                              (Ok (Tile
                                                    :rule rule
                                                    :wide wide
                                                    :left lhs
                                                    :right rhs
                                                    :immediate 0)))))))))))))))

(defn numeric-bits [(graph g/Graph) (reference i32)] (-> (Option u64))
  (if (>= reference 0)
      (None)
      (match (g/lookup graph reference)
        (Some [x] (if (symbols/numeric? x) (Some (n/constant-bits x)) (None)))
        (None [] (None)))))

;;; Logical immediate operands are selected before liveness, just like ADD
;;; immediates. The stored immediate is the canonical 13-bit N:immr:imms field.
(defn logical [(graph g/Graph) (tile Tile)] (-> Tile)
  (let [(mut source) (.left tile)
        (mut literal) (numeric-bits graph (.right tile))]
    (match literal
      (Some [_] 0)
      (None []
            (set! literal (numeric-bits graph (.left tile)))
            (set! source (.right tile))))
    (match literal
      (None [] tile)
      (Some [value]
            (match (encode/logical-mask (.wide tile) value)
              (None [] tile)
              (Some [fields]
                    (Tile
                      :rule (+ (.rule tile) 35)
                      :wide (.wide tile)
                      :left source
                      :right 0
                      :immediate (cast u64 fields))))))))

;;; Selection follows upstream DIV_PWR2/SDIV_PWR2/MOD_PWR2/SMOD_PWR2.
;;; A signed top-bit divisor is negative and retains general division. The
;;; immediate is the exponent; a zero RHS suppresses denominator materialization.
(defn division-power [(graph g/Graph) (tile Tile) (width i32)] (-> Tile)
  (match (numeric-bits graph (.right tile))
    (None [] tile)
    (Some [raw]
          (let [value
                  (& raw
                     (if (= width 64)
                         (: 0xFFFFFFFFFFFFFFFF u64)
                         (- (<< (: 1 u64) (cast u64 width)) 1)))
                signed? (or (= (.rule tile) 15) (= (.rule tile) 17))]
            (if (or (= value 0)
                    (!= (& value (- value 1)) 0)
                    (and signed?
                         (!= (& value (<< (: 1 u64) (cast u64 (- width 1)))) 0)))
                tile
                (let [(mut bits) value
                      (mut exponent) (: 0 u64)]
                  (while (> bits 1)
                    (set! bits (>> bits 1))
                    (set! exponent (+ exponent 1)))
                  (Tile
                    :rule (+ 44 (- (.rule tile) 14))
                    :wide (.wide tile)
                    :left (.left tile)
                    :right 0
                    :immediate exponent)))))))

;;; Constant shifts and multiply-by-power-of-two need no constant register.
;;; Narrow (<32-bit) shifts retain their width-specific lowering path.
(defn arithmetic [(graph g/Graph) (reference i32)] (-> (Result Tile (slice u8)))
  (match (arithmetic-register graph reference)
    (Err [message] (Err message))
    (Ok [tile]
        (let [x (get (.instructions graph) (cast i64 reference))
              size (types/scalar-size (cast i32 (n/type-id x)) 8)
              rule (.rule tile)]
          (if (and (>= rule 6) (<= rule 8))
              (Ok (logical graph tile))
              (let [(mut source) (.left tile)
                    (mut literal) (numeric-bits graph (.right tile))]
                (when (and (= rule 3)
                           (match literal (Some [_] false) (None [] true)))
                  (set! literal (numeric-bits graph (.left tile)))
                  (set! source (.right tile)))
                (if (or (< size 4)
                        (not (or (= rule 3) (and (>= rule 9) (<= rule 13)))))
                    (Ok (if (and (>= rule 14) (<= rule 17))
                            (division-power graph tile (* size 8))
                            tile))
                    (match literal
                      (None [] (Ok tile))
                      (Some [value]
                            (if (= rule 3)
                                (if (or (= value 0)
                                        (!= (& value (- value 1)) 0))
                                    (if (and (> value 2)
                                             (= (& (- value 1) (- value 2)) 0))
                                        (let [(mut bits) (- value 1) (mut exponent) (: 0 u64)]
                                          (while (> bits 1)
                                            (set! bits (>> bits 1))
                                            (set! exponent (+ exponent 1)))
                                          (Ok (Tile :rule 52 :wide (.wide tile)
                                                    :left source :right 0 :immediate exponent)))
                                        (Ok tile))
                                    (let [(mut bits) value
                                          (mut exponent) (: 0 u64)]
                                      (while (> bits 1)
                                        (set! bits (>> bits 1))
                                        (set! exponent (+ exponent 1)))
                                      (Ok (Tile
                                            :rule 38
                                            :wide (.wide tile)
                                            :left source
                                            :right 0
                                            :immediate exponent))))
                                (Ok (Tile
                                      :rule (if (>= rule 12) 49 (+ 38 (- rule 9)))
                                      :wide (.wide tile)
                                      :left source
                                      :right 0
                                      :immediate
                                        (let [mask (if (.wide tile) (: 63 u64) (: 31 u64))
                                              count (& value mask)]
                                          (if (= rule 12)
                                              (& (- (+ mask 1) count) mask)
                                              count))))))))))))))

;;; Equal masked right/left counts discard the low bits. Sign-fill from SAR
;;; is shifted out, so SHR and SAR have the same AND mask here. Keep the
;;; original graph; matching must replace the machine edge before liveness.
(defn shift-mask [(graph g/Graph) (reference i32)] (-> (Option Tile))
  (let [node (get (.instructions graph) (cast i64 reference))
        ty (cast i32 (n/type-id node))
        width (* 8 (types/scalar-size ty 8))
        producer (.op1 node)]
    (if (or (!= (n/opcode node) 49) (<= producer 0)
            (not (types/integer? ty)) (= ty 6)
            (not (or (= width 32) (= width 64))))
        (None)
        (let [shift (get (.instructions graph) (cast i64 producer))]
          (if (or (not (or (= (n/opcode shift) 50) (= (n/opcode shift) 51)))
                  (!= (n/type-id shift) (n/type-id node))
                  (<= (.op1 shift) 0))
              (None)
              (match (numeric-bits graph (.op2 node))
                (None [] (None))
                (Some [outer]
                  (match (numeric-bits graph (.op2 shift))
                    (None [] (None))
                    (Some [inner]
                      (let [count-mask (cast u64 (- width 1))
                            count (& outer count-mask)
                            full (if (= width 64) (: 0xFFFFFFFFFFFFFFFF u64)
                                     (: 0xFFFFFFFF u64))]
                        ; A zero count is the identity, not an encodable AND
                        ; immediate. Leave it to the ordinary shift rules.
                        (if (or (= count 0) (!= count (& inner count-mask)))
                            (None)
                            (match (encode/logical-mask (= width 64)
                                      (^ full (- (<< (: 1 u64) count) 1)))
                              (None [] (None))
                              (Some [fields]
                                (Some (Tile :rule 42 :wide (= width 64)
                                            :left (.op1 shift) :right 0
                                            :immediate (cast u64 fields))))))))))))))))

;;; Low bits of a truncated logical/arithmetic shift contain no sign-fill
;;; when the requested field ends within the original word. BOOL is excluded.
;;; A matcher must redirect the machine use before this tile can be emitted.
(defn extraction [(graph g/Graph) (reference i32)] (-> (Option Tile))
  (let [node (get (.instructions graph) (cast i64 reference))
        ty (cast i32 (n/type-id node))
        producer (.op1 node)
        width (* 8 (types/scalar-size ty 8))]
    (if (or (!= (n/opcode node) 35)
            (<= producer 0)
            (not (types/integer? ty))
            (= ty 1)
            (= ty 6))
        (None)
        (let [shift (get (.instructions graph) (cast i64 producer))
              input-type (cast i32 (n/type-id shift))
              bits (* 8 (types/scalar-size input-type 8))]
          (if (or (not (or (= (n/opcode shift) 50) (= (n/opcode shift) 51)))
                  (not (types/integer? input-type))
                  (not (or (= bits 32) (= bits 64)))
                  (>= width bits)
                  (<= (.op1 shift) 0))
              (None)
              (match (numeric-bits graph (.op2 shift))
                (None [] (None))
                (Some [amount]
                      (let [lsb (& amount (cast u64 (- bits 1)))]
                        (if (> (+ lsb (cast u64 width)) (cast u64 bits))
                            (None)
                            (Some (Tile
                                    :rule 48
                                    :wide (= bits 64)
                                    :left (.op1 shift)
                                    :right 0
                                    :immediate (| (<< lsb 8) (cast u64 width)))))))))))))

;;; SEXT/ZEXT of a 32-bit TRUNC view of a 64-bit integer reads the low word
;;; of that integer: one SXTW or UBFX #0,#32 from the original register,
;;; whether or not the view was given a register of its own. A matcher must
;;; redirect the machine use before this tile can be emitted.
(defn word-view-extension [(graph g/Graph) (reference i32)] (-> (Option Tile))
  (let [node (get (.instructions graph) (cast i64 reference))
        ty (n/type-id node)
        view (.op1 node)]
    (if (or (not (or (= (n/opcode node) 33) (= (n/opcode node) 34)))
            (not (or (= ty 5) (= ty 11)))
            (<= view 0))
        (None)
        (let [truncation (get (.instructions graph) (cast i64 view))
              narrow (n/type-id truncation)
              source (.op1 truncation)]
          (if (or (!= (n/opcode truncation) 35)
                  (not (or (= narrow 4) (= narrow 10)))
                  (<= source 0))
              (None)
              (let [input (get (.instructions graph) (cast i64 source))
                    from (n/type-id input)]
                (if (or (not (or (= from 5) (= from 11))) (= (n/opcode input) 89))
                    (None)
                    (Some (if (= (n/opcode node) 34)
                              (Tile :rule 48 :wide true :left source :right 0
                                    :immediate 32)
                              (Tile :rule 53 :wide true :left source :right 0
                                    :immediate 0))))))))))

(defn swapped-condition [(condition i32)] (-> i32)
  (case condition 2 9 3 8 8 3 9 2 10 13 11 12 12 11 13 10 condition))

;;; A zero RHS reference denotes an immediate, as with the existing arithmetic
;;; tiles. Its bits represent the signed CMP/CMN displacement, not a graph ref.
(defn comparison-immediate [(graph g/Graph) (tile Tile) (width i32)] (-> Tile)
  (let [(mut literal) (numeric-bits graph (.right tile))
        (mut source) (.left tile)
        (mut condition) (- (.rule tile) 20)]
    (match literal
      (Some [_] 0)
      (None []
            (set! literal (numeric-bits graph (.left tile)))
            (set! source (.right tile))
            (set! condition (swapped-condition condition))))
    (match literal
      (None [] tile)
      (Some [bits]
            (let [signed-order (and (>= condition 10) (<= condition 13))
                  value
                    (if (= width 64)
                        (cast i64 bits)
                        (if (or (= width 32) signed-order)
                            (>> (cast i64 (<< bits (cast u64 (- 64 width))))
                                (cast i64 (- 64 width)))
                            (cast i64
                                  (& bits (- (<< (: 1 u64) (cast u64 width)) 1)))))]
              (if (or (< value -16773120) (> value 16773120))
                  tile
                  (let [magnitude (if (< value 0) (- (: 0 i64) value) value)]
                    (if (or (<= magnitude 4095) (= (% magnitude 4096) 0))
                        (Tile
                          :rule (+ 20 condition)
                          :wide (.wide tile)
                          :left source
                          :right 0
                          :immediate (cast u64 value))
                        tile))))))))

;;; The 32-bit source of a SEXT/ZEXT into a 64-bit integer word, or zero.
;;; Narrower sources are excluded: their register bits above the value are
;;; not defined, so a W-form comparison would observe them. RLOAD keeps its
;;; pinned position. Kind is the extension opcode: 33=SEXT, 34=ZEXT.
(defn word-extension-source [(graph g/Graph) (reference i32) (kind u8)] (-> i32)
  (if (<= reference 0)
      0
      (let [node (get (.instructions graph) (cast i64 reference))
            ty (n/type-id node)
            source (.op1 node)]
        (if (or (!= (n/opcode node) kind) (not (or (= ty 5) (= ty 11))) (<= source 0))
            0
            (let [input (get (.instructions graph) (cast i64 source))
                  from (n/type-id input)]
              (if (and (or (= from 4) (= from 10)) (!= (n/opcode input) 89))
                  source
                  0))))))

;;; Case literal BITS of a SWITCH on the extension SELECTOR can be compared as
;;; a word: it is the extension of its own low word. An unsigned 64-bit
;;; selector orders cases as unsigned values, which both extensions preserve.
(defn word-case? [(graph g/Graph) (selector i32) (literal i32)] (-> bool)
  (match (numeric-bits graph literal)
    (None [] false)
    (Some [bits]
          (if (= (n/opcode (get (.instructions graph) (cast i64 selector))) 34)
              (<= bits 0xFFFFFFFF)
              (let [value (cast i64 bits)]
                (and (>= value -2147483648) (<= value 2147483647)))))))

;;; The SWITCH selector as a retirable unsigned 64-bit word extension, or zero.
(defn switch-extension [(graph g/Graph) (node n/Node)] (-> i32)
  (let [selector (.op2 node)]
    (if (and (word-extension? graph selector)
             (= (n/type-id (get (.instructions graph) (cast i64 selector))) 5)
             (> (word-extension-source graph selector
                  (n/opcode (get (.instructions graph) (cast i64 selector))))
                0))
        selector
        0)))

(defn word-extension? [(graph g/Graph) (reference i32)] (-> bool)
  (and (> reference 0)
       (let [opcode (n/opcode (get (.instructions graph) (cast i64 reference)))]
         (or (= opcode 33) (= opcode 34)))))

;;; Signed order on two zero-extended words is unsigned order on the words.
(defn unsigned-condition [(condition i32)] (-> i32)
  (case condition 10 2 11 3 12 8 13 9 condition))

;;; A 64-bit comparison whose inputs are extensions of 32-bit values is the
;;; 32-bit comparison of the sources, exactly in these cases:
;;;   SEXT(x) ? c, c in [-2^31, 2^31): every condition is unchanged. Sign
;;;     extension is strictly increasing for the signed order, and for the
;;;     unsigned order too (negative words map above all nonnegative ones).
;;;   ZEXT(x) ? c, c in [0, 2^32): equality and unsigned order are unchanged;
;;;     signed order becomes unsigned, as both 64-bit values are nonnegative.
;;;   SEXT(x) ? SEXT(y) and ZEXT(x) ? ZEXT(y): likewise.
;;; A literal outside the stated range, mixed extension kinds and non-word
;;; sources keep the 64-bit comparison. An immediate tile already holds the
;;; signed literal; a literal left in a register must also be a W-form
;;; constant, so a signed one is narrowed only when nonnegative.
;;; The caller must replace the machine uses before liveness.
(defn narrowed-comparison [(graph g/Graph) (tile Tile)] (-> (Option Tile))
  (if (or (not (.wide tile)) (< (.rule tile) 20) (> (.rule tile) 33))
      (None)
      (let [condition (- (.rule tile) 20)
            left (.left tile)
            right (.right tile)
            kind (if (> left 0)
                     (n/opcode (get (.instructions graph) (cast i64 left)))
                     (if (> right 0)
                         (n/opcode (get (.instructions graph) (cast i64 right)))
                         (: 0 u8)))
            rule (+ 20 (if (= kind 34) (unsigned-condition condition) condition))]
        (if (not (or (= kind 33) (= kind 34)))
            (None)
            (let [first (word-extension-source graph left kind)
                  second (word-extension-source graph right kind)]
              (cond (= right 0)
                      (if (or (= first 0)
                              (and (= kind 34) (< (cast i64 (.immediate tile)) 0)))
                          (None)
                          (Some (Tile :rule rule :wide false :left first :right 0
                                      :immediate (.immediate tile))))
                    (and (> first 0) (> second 0))
                      (Some (Tile :rule rule :wide false :left first :right second
                                  :immediate 0))
                    :else
                      (let [literal (if (> first 0) right left)
                            limit (if (= kind 34) (: 0xFFFFFFFF u64) (: 0x7FFFFFFF u64))]
                        (if (and (or (> first 0) (> second 0)) (< literal 0))
                            (match (numeric-bits graph literal)
                              (None [] (None))
                              (Some [bits]
                                    (if (> bits limit)
                                        (None)
                                        (Some (Tile :rule rule :wide false
                                                    :left (if (> first 0) first left)
                                                    :right (if (> first 0) right second)
                                                    :immediate 0)))))
                            (None)))))))))

;;; A comparison tile whose flags come from one X- or W-form CMP/CMN of its
;;; operands as they are held: X form, or W form with every operand at least a
;;; word. Byte and halfword operands need normalization first.
(defn direct-comparison? [(graph g/Graph) (tile Tile)] (-> bool)
  (and (>= (.rule tile) 20) (<= (.rule tile) 33)
       (or (.wide tile)
           (and (match (g/lookup graph (.left tile))
                  (None [] false)
                  (Some [operand] (>= (types/scalar-size (cast i32 (n/type-id operand)) 8) 4)))
                (or (= (.right tile) 0)
                    (match (g/lookup graph (.right tile))
                      (None [] false)
                      (Some [operand]
                            (>= (types/scalar-size (cast i32 (n/type-id operand)) 8) 4))))))))

(defn comparison [(graph g/Graph) (reference i32)] (-> (Result Tile (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "comparison missing"))
    (Some [node]
          (let [opcode (n/opcode node)
                condition
                  (match opcode
                    (14 0)
                    (15 1)
                    (16 11)
                    (17 10)
                    (18 13)
                    (19 12)
                    (20 3)
                    (21 2)
                    (22 9)
                    (23 8)
                    (_ -1))]
            (if (or (< condition 0) (!= (n/type-id node) 1))
                (Err "invalid comparison")
                (match (g/lookup graph (.op1 node))
                  (None [] (Err "comparison operand missing"))
                  (Some [left]
                        (match (g/lookup graph (.op2 node))
                          (None [] (Err "comparison operand missing"))
                          (Some [right]
                                (let [ty (n/type-id left)]
                                  (if (or (!= ty (n/type-id right))
                                          (not (types/integer? (cast i32 ty))))
                                      (Err "unsupported comparison types")
                                      (Ok (comparison-immediate graph
                                                                (Tile
                                                                  :rule
                                                                    (cast i32
                                                                          (+ 20
                                                                             condition))
                                                                  :wide
                                                                    (or (= ty 6)
                                                                        (= ty 5)
                                                                        (= ty
                                                                           11))
                                                                  :left
                                                                    (.op1 node)
                                                                  :right
                                                                    (.op2 node)
                                                                  :immediate 0)
                                                                (* (types/scalar-size (cast i32
                                                                                            ty)
                                                                                      8)
                                                                   8))))))))))))))

(defn select [(graph g/Graph) (reference i32)] (-> (Result Tile (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "selection node missing"))
    (Some [node]
          (if (and (>= (n/opcode node) 14) (<= (n/opcode node) 23))
              (comparison graph reference)
              (arithmetic graph reference)))))

;;; Integer vector multiplication by a direct typed SPLAT(2) is lane-wise
;;; doubling modulo the element width. Do not inspect through COPY barriers.
(defn splat-two? [(graph g/Graph) (reference i32) (ty i32)] (-> bool)
  (if (<= reference 0)
      false
      (match (g/lookup graph reference)
        (None [] false)
        (Some [node]
              (if (and (= (n/opcode node) 63)
                       (= (cast i32 (n/type-id node)) ty)
                       (< (.op1 node) 0))
                  (match (g/lookup graph (.op1 node))
                    (None [] false)
                    (Some [literal]
                          (and (symbols/numeric? literal)
                               (= (cast i32 (n/type-id literal))
                                  (types/base-type ty))
                               (= (n/constant-bits literal) 2))))
                  false)))))

(defn doubling-source [(graph g/Graph) (reference i32)] (-> i32)
  (match (g/lookup graph reference)
    (None [] 0)
    (Some [node]
          (let [ty (cast i32 (n/type-id node))]
            (if (and (= (n/opcode node) 28)
                     (types/vector? ty)
                     (types/integer? (types/base-type ty))
                     (!= (types/base-type ty) 1))
                (if (and (> (.op1 node) 0) (splat-two? graph (.op2 node) ty))
                    (.op1 node)
                    (if (and (> (.op2 node) 0)
                             (splat-two? graph (.op1 node) ty))
                        (.op2 node)
                        0))
                0)))))
