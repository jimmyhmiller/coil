;;; Initial maximal-munch arithmetic selection over typed graph nodes.
(module stogir.a64.select)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.symbols" :as symbols)
(import "stogir.types" :as types)
(import "stogir.integer-binary" :as binary)
(import "stogir.conditional" :as conditional)
(import "stogir.a64.encode" :as encode)
(import "coil.primitive" :as primitive)
(import "coil.result" :use [Result Ok Err Option Some None])

;;; Rules: 1..5=ADD/SUB/MUL and immediates; 6..8=logical; 9..13=shifts/rotates.
;;; 14/15=unsigned/signed DIV, 16/17=unsigned/signed MOD; 20..33=conditions.
;;; 34/35=unsigned/signed MIN, 36/37=unsigned/signed MAX.
;;; 38..40=constant shifts; 41..43=OR/AND/XOR logical immediates.
;;; 44..47=unsigned/signed DIV and MOD by a positive power of two.
;;; 48=unsigned bitfield extraction for selected TRUNC(SHR/SAR).
;;; 49=constant rotate, following pinned AArch64 IR_SHIFT_CONST.
;;; 50/51=ADD/SUB with constant word shift, chosen by persistent matching.
;;; Their immediate packs shift-kind in bits8..9 and amount in bits0..5.
;;; 52=MUL by 2^k+1 as ADD with the same source shifted by k.
;;; 53=sign extension of the low word of a 64-bit source (SXTW).
;;; 54/55=MADD/MSUB, chosen by persistent matching for ADD/SUB of a single-use
;;; register MUL: left is the addend/minuend, right the multiplicand and the
;;; immediate holds the multiplier's graph reference (see multiplier).
;;; 56=the 64-bit register of an already extended source, read as it is: a
;;; conversion of a LOAD that matching gave the wanted access form.
;;; 57=access form of a LOAD, never emitted as arithmetic: the immediate holds
;;; the access width in bytes in bits0..7 and bit8 when it sign-extends into
;;; the X register; without bit8 it zero-extends.
;;; 58=MUL by a literal as one or two shift/add/subtract steps (see product).
;;; 59..64=DIV/MOD by a literal through a reciprocal multiplication (see
;;; division-reciprocal and stogir.a64.reciprocal).
;;; A rule 20/21 comparison with zero may instead be a bit test (see bit-test).
;;; Operands remain graph references until allocation. Immediate holds unsigned
;;; arithmetic bits/fields or the signed CMP/CMN displacement bit pattern.
(defstruct Tile [(rule i32) (wide bool) (left i32) (right i32) (immediate u64)])

;;; Exact word comparison choice. Comparison opcode, not result type, carries
;;; signedness: adapters may represent signed machine words with unsigned types.
;;; Both selected values are the comparison inputs, so this needs no speculative
;;; value motion. RLOAD/overflow exclusions retain the ordinary condition policy.
(defn ordered-choice [(graph g/Graph) (reference i32)] (-> (Option Tile))
  (match (g/lookup graph reference)
    (None [] (None))
    (Some [node]
      (if (and (= (n/opcode node) 60)
               (conditional/comparison-input-choice? graph (n/type-id node)
                 (.op1 node) (.op2 node) (.op3 node)))
          (let [condition (get (.instructions graph) (cast i64 (.op1 node)))
                opcode (n/opcode condition)
                less? (or (= opcode 16) (= opcode 18) (= opcode 20) (= opcode 22))
                minimum? (= less? (= (.op2 node) (.op1 condition)))]
            (Some (Tile :rule (cast i32 (+ (if minimum? 34 36) (if (< opcode 20) 1 0)))
                        :wide (= (types/scalar-size (cast i32 (n/type-id node)) 8) 8)
                        :left (.op1 condition) :right (.op2 condition) :immediate 0)))
          (None)))))

;;; Third operand reference of a MADD/MSUB tile; zero for every other rule.
(defn multiplier [(tile Tile)] (-> i32)
  (if (or (= (.rule tile) 54) (= (.rule tile) 55))
      (cast i32 (cast i64 (.immediate tile)))
      0))

(defn immediate [(graph g/Graph) (value i32) (ty u8)] (-> (Option u64))
  (if (>= value 0)
      (None)
      (match (g/lookup graph value)
        (None [] (None))
        (Some [node]
              (let [bits (n/constant-bits node)]
                (if (and (symbols/numeric? node)
                         (or (= (n/type-id node) ty)
                             (and (= ty 6)
                                  (or (= (n/type-id node) 5)
                                      (= (n/type-id node) 11))))
                         (or (<= bits 4095)
                             (and (= (% bits 4096) 0) (<= (/ bits 4096) 4095))))
                    (Some bits)
                    (None)))))))

(defn register-rule [(opcode u8)] (-> i32)
  (match opcode
    (26 1)
    (27 2)
    (28 3)
    (46 6)
    (47 7)
    (48 8)
    (49 9)
    (50 10)
    (51 11)
    (52 12)
    (29 14)
    (30 16)
    (53 13)
    (58 34)
    (59 36)
    (_ 0)))

(defn arithmetic-register [(graph g/Graph) (reference i32)]
  (-> (Result Tile (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "selection node missing"))
    (Some [node]
          (let [opcode (n/opcode node)
                ty (n/type-id node)
                wide (or (= ty 6) (= ty 5) (= ty 11))
                rule
                  (+ (register-rule opcode)
                     (if (and (or (= opcode 29)
                                  (= opcode 30)
                                  (= opcode 58)
                                  (= opcode 59))
                              (types/signed? (cast i32 ty)))
                         1
                         0))]
            (if (or (<= reference 0)
                    (= rule 0)
                    (not (binary/valid-type? (cast i32 opcode) (cast i32 ty))))
                (Err "unsupported integer selection opcode/type")
                (match (g/lookup graph (.op1 node))
                  (None [] (Err "left operand missing"))
                  (Some [left]
                        (match (g/lookup graph (.op2 node))
                          (None [] (Err "right operand missing"))
                          (Some [right]
                                (if (or (!= (n/type-id left) ty)
                                        (not (or (= (n/type-id right) ty)
                                                 (and (= ty 6)
                                                      (or (= opcode 26)
                                                          (= opcode 27))
                                                      (or (= (n/type-id right)
                                                             5)
                                                          (= (n/type-id right)
                                                             11))))))
                                    (Err "integer operand type mismatch")
                                    (let [(mut lhs) (.op1 node)
                                          (mut rhs) (.op2 node)
                                          (mut literal)
                                            (if (or (= opcode 26) (= opcode 27))
                                                (immediate graph (.op2 node) ty)
                                                (None))]
                                      (when (= opcode 26)
                                        (match literal
                                          (Some [_] 0)
                                          (None []
                                                (match (immediate graph lhs ty)
                                                  (None [] 0)
                                                  (Some [bits]
                                                        (do
                                                          (set! literal
                                                                (Some bits))
                                                          (set! lhs rhs)
                                                          (set! rhs (.op1 node))))))))
                                      (match literal
                                        (Some [bits]
                                              (Ok (Tile
                                                    :rule (if (= opcode 26) 4 5)
                                                    :wide wide
                                                    :left lhs
                                                    :right 0
                                                    :immediate bits)))
                                        (None []
                                              (Ok (Tile
                                                    :rule rule
                                                    :wide wide
                                                    :left lhs
                                                    :right rhs
                                                    :immediate 0)))))))))))))))

;;; Index of the lowest set bit; value must be nonzero.
(defn trailing-zeros [(value u64)] (-> u64)
  (cast u64 (primitive/ctz value)))

(defn power-of-two? [(value u64)] (-> bool)
  (and (!= value 0) (= (& value (- value 1)) 0)))

(defn two-bits? [(value u64)] (-> bool)
  (and (!= value 0) (power-of-two? (& value (- value 1)))))

;;; Index of the highest set bit; value must be nonzero.
(defn highest-bit [(value u64)] (-> u64)
  (- 63 (cast u64 (primitive/clz value))))

;;; value = 2^a - 2^b with a > b + 1 and a below the width: the exponent a,
;;; otherwise zero. b is then the index of the lowest set bit.
(defn run-end [(value u64) (full u64)] (-> u64)
  (if (= value 0)
      0
      (let [top (& (+ value (& value (- 0 value))) full)]
        (if (and (power-of-two? top) (> (trailing-zeros top) (+ (trailing-zeros value) 1)))
            (trailing-zeros top)
            0))))

;;; One step of a rule 58 product of the source x, through a temporary t:
;;; kind 0: a << s; 1: a + (b << s); 2: a - (b << s); 3: -(b << s). Bits 0..5
;;; hold s, bit 6 selects t for a, bit 7 selects t for b, bits 8..9 the kind.
(defn step [(kind u64) (first-temporary bool) (shifted-temporary bool) (shift u64)] (-> u64)
  (| (<< kind 8) (if first-temporary (: 64 u64) 0) (if shifted-temporary (: 128 u64) 0) shift))

;;; The first step defines t (or the result, when it is the only one); the
;;; second defines the result. Immediate: count, then 16 bits per step.
(defn product-tile [(tile Tile) (source i32) (first u64) (second u64) (count u64)] (-> Tile)
  (Tile :rule 58 :wide (.wide tile) :left source :right 0
        :immediate (| count (<< first 8) (<< second 24))))

(defn product-steps [(tile Tile)] (-> i32)
  (cast i32 (& (.immediate tile) 255)))

(defn product-step [(tile Tile) (index i32)] (-> u64)
  (& (>> (.immediate tile) (cast u64 (+ 8 (* 16 index)))) 0x3FF))

;;; x + (x << k), the first step of most two-step products.
(defn scaled-sum [(k u64)] (-> u64)
  (step 1 false false k))

;;; MUL by the literal RAW in a 32- or 64-bit type as at most two shift, add
;;; and subtract instructions, or TILE itself. Powers of two and 2^k+1 were
;;; selected before. With c the literal modulo the width and a > b:
;;;   one step:   -2^k; 1 - 2^k.
;;;   two steps:  2^a + 2^b; 2^a - 2^b; 2^b - 2^a; -(2^a + 2^b);
;;;               1 + 2^a + 2^b; 1 - 2^a - 2^b; 1 + 2^a - 2^b; 1 - 2^a + 2^b;
;;;               (1 +/- 2^k)(1 +/- 2^s).
;;; Every step wraps modulo the width, as the multiplication does.
(defn product [(tile Tile) (source i32) (raw u64) (width i32)] (-> Tile)
  (let [full (if (= width 64) (: 0xFFFFFFFFFFFFFFFF u64) 0xFFFFFFFF)
        c (& raw full)
        negated (& (- 0 c) full)
        below (& (- c 1) full)
        above (& (- 1 c) full)]
    (cond (or (= c 0) (not (or (= width 32) (= width 64)))) tile
          (power-of-two? negated)
            (product-tile tile source (step 3 false false (trailing-zeros negated)) 0 1)
          (power-of-two? above)
            (product-tile tile source (step 2 false false (trailing-zeros above)) 0 1)
          (two-bits? c)
            (let [b (trailing-zeros c)]
              (product-tile tile source (scaled-sum (- (highest-bit c) b))
                            (step 0 true false b) 2))
          (> (run-end c full) 0)
            (product-tile tile source (step 0 false false (run-end c full))
                          (step 2 true false (trailing-zeros c)) 2)
          (> (run-end negated full) 0)
            (let [b (trailing-zeros negated)]
              (product-tile tile source (step 2 false false (- (run-end negated full) b))
                            (step 0 true false b) 2))
          (two-bits? negated)
            (let [b (trailing-zeros negated)]
              (product-tile tile source (scaled-sum (- (highest-bit negated) b))
                            (step 3 false true b) 2))
          (two-bits? below)
            (let [b (trailing-zeros below)]
              (product-tile tile source (scaled-sum (- (highest-bit below) b))
                            (step 1 false true b) 2))
          (two-bits? above)
            (let [b (trailing-zeros above)]
              (product-tile tile source (scaled-sum (- (highest-bit above) b))
                            (step 2 false true b) 2))
          (> (run-end below full) 0)
            (product-tile tile source (scaled-sum (run-end below full))
                          (step 2 true false (trailing-zeros below)) 2)
          (> (run-end above full) 0)
            (let [b (trailing-zeros above)]
              (product-tile tile source (step 2 false false (- (run-end above full) b))
                            (step 1 false true b) 2))
          :else
            ; (1 +/- 2^k)(1 +/- 2^s) with k <= s: the lowest set bit of c - 1
            ; is bit k, or bit k + 1 when k = s and the signs agree.
            (let [low (trailing-zeros below)
                  (mut found) tile]
              (for [choice (: 0 u64) 4]
                (let [k (if (< choice 2) low (- low 1))
                      kind (if (= (& choice 1) 0) (: 1 u64) 2)]
                  (when (and (= (.rule found) 3) (> k 0) (or (< choice 2) (> low 1)))
                    (let [s (factor-shift c full k kind)]
                      (when (> s 0)
                        (set! found
                              (product-tile tile source (step kind false false k)
                                            (step (& s 3) true true (>> s 2)) 2)))))))
              found))))

;;; With q = 1 + 2^k (kind 1) or 1 - 2^k (kind 2) and c = q(1 + 2^s) or
;;; q(1 - 2^s) modulo the width: s * 4 + the second step's kind (1 or 2), or
;;; zero. c is odd and k > 0.
(defn factor-shift [(c u64) (full u64) (k u64) (kind u64)] (-> u64)
  (let [power (<< (: 1 u64) k)
        factor (& (if (= kind 1) (+ 1 power) (- 1 power)) full)
        rest (& (- c factor) full)]
    (if (= rest 0)
        0
        (let [s (trailing-zeros rest)
              scaled (& (<< factor s) full)]
          (cond (= s 0) 0
                (= (& (+ factor scaled) full) c) (+ (* s 4) 1)
                (= (& (- factor scaled) full) c) (+ (* s 4) 2)
                :else 0)))))

(defn numeric-bits [(graph g/Graph) (reference i32)] (-> (Option u64))
  (if (>= reference 0)
      (None)
      (match (g/lookup graph reference)
        (Some [x] (if (symbols/numeric? x) (Some (n/constant-bits x)) (None)))
        (None [] (None)))))

;;; Logical immediate operands are selected before liveness, just like ADD
;;; immediates. The stored immediate is the canonical 13-bit N:immr:imms field.
(defn logical [(graph g/Graph) (tile Tile)] (-> Tile)
  (let [(mut source) (.left tile)
        (mut literal) (numeric-bits graph (.right tile))]
    (match literal
      (Some [_] 0)
      (None []
            (set! literal (numeric-bits graph (.left tile)))
            (set! source (.right tile))))
    (match literal
      (None [] tile)
      (Some [value]
            (match (encode/logical-mask (.wide tile) value)
              (None [] tile)
              (Some [fields]
                    (Tile
                      :rule (+ (.rule tile) 35)
                      :wide (.wide tile)
                      :left source
                      :right 0
                      :immediate (cast u64 fields))))))))

;;; The reciprocal form (rules 59..62, see stogir.a64.reciprocal) of a DIV/MOD
;;; tile (rules 14..17) by the literal RAW in a 32- or 64-bit type, or the tile
;;; itself. Powers of two were selected before; zero, one and minus one keep
;;; the machine divide's exact results, as does a literal dividend. The
;;; immediate holds the divisor's bits; a zero RHS suppresses its register.
(defn division-reciprocal [(tile Tile) (raw u64) (width i32)] (-> Tile)
  (let [full (if (= width 64) (: 0xFFFFFFFFFFFFFFFF u64) 0xFFFFFFFF)
        d (& raw full)
        signed? (or (= (.rule tile) 15) (= (.rule tile) 17))]
    (if (or (not (or (= width 32) (= width 64)))
            (< (.rule tile) 14) (> (.rule tile) 17)
            (<= (.left tile) 0)
            (< d 2)
            (= (& d (- d 1)) 0)
            (and signed? (= d full)))
        tile
        (Tile :rule (+ 59 (- (.rule tile) 14)) :wide (.wide tile)
              :left (.left tile) :right 0 :immediate d))))

;;; The non-negative form (rules 63/64) of a signed reciprocal tile whose
;;; divisor is positive, for a dividend proven to have a clear sign bit: the
;;; unsigned recipe of a dividend with a clear top bit. Otherwise TILE.
(defn reciprocal-nonnegative [(tile Tile)] (-> Tile)
  (let [width (if (.wide tile) (: 64 u64) 32)]
    (if (and (or (= (.rule tile) 60) (= (.rule tile) 62))
             (= (& (.immediate tile) (<< (: 1 u64) (- width 1))) 0))
        (Tile :rule (if (= (.rule tile) 60) 63 64) :wide (.wide tile)
              :left (.left tile) :right 0 :immediate (.immediate tile))
        tile)))

;;; Selection follows upstream DIV_PWR2/SDIV_PWR2/MOD_PWR2/SMOD_PWR2.
;;; A signed top-bit divisor is negative and retains general division. The
;;; immediate is the exponent; a zero RHS suppresses denominator materialization.
(defn division-power [(graph g/Graph) (tile Tile) (width i32)] (-> Tile)
  (match (numeric-bits graph (.right tile))
    (None [] tile)
    (Some [raw]
          (let [value
                  (& raw
                     (if (= width 64)
                         (: 0xFFFFFFFFFFFFFFFF u64)
                         (- (<< (: 1 u64) (cast u64 width)) 1)))
                signed? (or (= (.rule tile) 15) (= (.rule tile) 17))]
            (if (or (= value 0)
                    (!= (& value (- value 1)) 0)
                    (and signed?
                         (!= (& value (<< (: 1 u64) (cast u64 (- width 1)))) 0)))
                (division-reciprocal tile raw width)
                (let [(mut bits) value
                      (mut exponent) (: 0 u64)]
                  (while (> bits 1)
                    (set! bits (>> bits 1))
                    (set! exponent (+ exponent 1)))
                  (Tile
                    :rule (+ 44 (- (.rule tile) 14))
                    :wide (.wide tile)
                    :left (.left tile)
                    :right 0
                    :immediate exponent)))))))

;;; Constant shifts and multiply-by-power-of-two need no constant register.
;;; Narrow (<32-bit) shifts keep their width-specific lowering; only SAR of an
;;; unsigned byte or halfword by a literal selects the constant-shift rule.
(defn arithmetic [(graph g/Graph) (reference i32)] (-> (Result Tile (slice u8)))
  (match (arithmetic-register graph reference)
    (Err [message] (Err message))
    (Ok [tile]
        (let [x (get (.instructions graph) (cast i64 reference))
              size (types/scalar-size (cast i32 (n/type-id x)) 8)
              rule (.rule tile)]
          (if (and (>= rule 6) (<= rule 8))
              (Ok (logical graph tile))
              (let [(mut source) (.left tile)
                    (mut literal) (numeric-bits graph (.right tile))]
                (when (and (= rule 3)
                           (match literal (Some [_] false) (None [] true)))
                  (set! literal (numeric-bits graph (.left tile)))
                  (set! source (.right tile)))
                (if (or (< size 4)
                        (not (or (= rule 3) (and (>= rule 9) (<= rule 13)))))
                    (Ok (if (and (>= rule 14) (<= rule 17))
                            (division-power graph tile (* size 8))
                            ; A byte or halfword shift by a literal is one
                            ; bitfield move chosen at emission, except SAR of
                            ; an unsigned type by a nonzero count: there the
                            ; sign-extended source is shifted by the constant
                            ; (counts are taken modulo the type width).
                            (match (if (and (= rule 11) (> (.left tile) 0)
                                            (not (types/signed? (cast i32 (n/type-id x)))))
                                       literal
                                       (None))
                              (None [] tile)
                              (Some [count]
                                (if (= (& count (cast u64 (- (* size 8) 1))) 0)
                                    tile
                                    (Tile :rule 40 :wide false :left (.left tile) :right 0
                                          :immediate (& count (cast u64 (- (* size 8) 1)))))))))
                    (match literal
                      (None [] (Ok tile))
                      (Some [value]
                            (if (= rule 3)
                                (if (or (= value 0)
                                        (!= (& value (- value 1)) 0))
                                    (if (and (> value 2)
                                             (= (& (- value 1) (- value 2)) 0))
                                        (let [(mut bits) (- value 1) (mut exponent) (: 0 u64)]
                                          (while (> bits 1)
                                            (set! bits (>> bits 1))
                                            (set! exponent (+ exponent 1)))
                                          (Ok (Tile :rule 52 :wide (.wide tile)
                                                    :left source :right 0 :immediate exponent)))
                                        (Ok (product tile source value (cast i32 (* size 8)))))
                                    (let [(mut bits) value
                                          (mut exponent) (: 0 u64)]
                                      (while (> bits 1)
                                        (set! bits (>> bits 1))
                                        (set! exponent (+ exponent 1)))
                                      (Ok (Tile
                                            :rule 38
                                            :wide (.wide tile)
                                            :left source
                                            :right 0
                                            :immediate exponent))))
                                (Ok (Tile
                                      :rule (if (>= rule 12) 49 (+ 38 (- rule 9)))
                                      :wide (.wide tile)
                                      :left source
                                      :right 0
                                      :immediate
                                        (let [mask (if (.wide tile) (: 63 u64) (: 31 u64))
                                              count (& value mask)]
                                          (if (= rule 12)
                                              (& (- (+ mask 1) count) mask)
                                              count))))))))))))))

;;; Equal masked right/left counts discard the low bits. Sign-fill from SAR
;;; is shifted out, so SHR and SAR have the same AND mask here. Keep the
;;; original graph; matching must replace the machine edge before liveness.
(defn shift-mask [(graph g/Graph) (reference i32)] (-> (Option Tile))
  (let [node (get (.instructions graph) (cast i64 reference))
        ty (cast i32 (n/type-id node))
        width (* 8 (types/scalar-size ty 8))
        producer (.op1 node)]
    (if (or (!= (n/opcode node) 49) (<= producer 0)
            (not (types/integer? ty)) (= ty 6)
            (not (or (= width 32) (= width 64))))
        (None)
        (let [shift (get (.instructions graph) (cast i64 producer))]
          (if (or (not (or (= (n/opcode shift) 50) (= (n/opcode shift) 51)))
                  (!= (n/type-id shift) (n/type-id node))
                  (<= (.op1 shift) 0))
              (None)
              (match (numeric-bits graph (.op2 node))
                (None [] (None))
                (Some [outer]
                  (match (numeric-bits graph (.op2 shift))
                    (None [] (None))
                    (Some [inner]
                      (let [count-mask (cast u64 (- width 1))
                            count (& outer count-mask)
                            full (if (= width 64) (: 0xFFFFFFFFFFFFFFFF u64)
                                     (: 0xFFFFFFFF u64))]
                        ; A zero count is the identity, not an encodable AND
                        ; immediate. Leave it to the ordinary shift rules.
                        (if (or (= count 0) (!= count (& inner count-mask)))
                            (None)
                            (match (encode/logical-mask (= width 64)
                                      (^ full (- (<< (: 1 u64) count) 1)))
                              (None [] (None))
                              (Some [fields]
                                (Some (Tile :rule 42 :wide (= width 64)
                                            :left (.op1 shift) :right 0
                                            :immediate (cast u64 fields))))))))))))))))

;;; Low bits of a truncated logical/arithmetic shift contain no sign-fill
;;; when the requested field ends within the original word. BOOL is excluded.
;;; A matcher must redirect the machine use before this tile can be emitted.
(defn extraction [(graph g/Graph) (reference i32)] (-> (Option Tile))
  (let [node (get (.instructions graph) (cast i64 reference))
        ty (cast i32 (n/type-id node))
        producer (.op1 node)
        width (* 8 (types/scalar-size ty 8))]
    (if (or (!= (n/opcode node) 35)
            (<= producer 0)
            (not (types/integer? ty))
            (= ty 1)
            (= ty 6))
        (None)
        (let [shift (get (.instructions graph) (cast i64 producer))
              input-type (cast i32 (n/type-id shift))
              bits (* 8 (types/scalar-size input-type 8))]
          (if (or (not (or (= (n/opcode shift) 50) (= (n/opcode shift) 51)))
                  (not (types/integer? input-type))
                  (not (or (= bits 32) (= bits 64)))
                  (>= width bits)
                  (<= (.op1 shift) 0))
              (None)
              (match (numeric-bits graph (.op2 shift))
                (None [] (None))
                (Some [amount]
                      (let [lsb (& amount (cast u64 (- bits 1)))]
                        (if (> (+ lsb (cast u64 width)) (cast u64 bits))
                            (None)
                            (Some (Tile
                                    :rule 48
                                    :wide (= bits 64)
                                    :left (.op1 shift)
                                    :right 0
                                    :immediate (| (<< lsb 8) (cast u64 width)))))))))))))

;;; SEXT/ZEXT of a 32-bit TRUNC view of a 64-bit integer reads the low word
;;; of that integer: one SXTW or UBFX #0,#32 from the original register,
;;; whether or not the view was given a register of its own. A matcher must
;;; redirect the machine use before this tile can be emitted.
(defn word-view-extension [(graph g/Graph) (reference i32)] (-> (Option Tile))
  (let [node (get (.instructions graph) (cast i64 reference))
        ty (n/type-id node)
        view (.op1 node)]
    (if (or (not (or (= (n/opcode node) 33) (= (n/opcode node) 34)))
            (not (or (= ty 5) (= ty 11)))
            (<= view 0))
        (None)
        (let [truncation (get (.instructions graph) (cast i64 view))
              narrow (n/type-id truncation)
              source (.op1 truncation)]
          (if (or (!= (n/opcode truncation) 35)
                  (not (or (= narrow 4) (= narrow 10)))
                  (<= source 0))
              (None)
              (let [input (get (.instructions graph) (cast i64 source))
                    from (n/type-id input)]
                (if (or (not (or (= from 5) (= from 11))) (= (n/opcode input) 89))
                    (None)
                    (Some (if (= (n/opcode node) 34)
                              (Tile :rule 48 :wide true :left source :right 0
                                    :immediate 32)
                              (Tile :rule 53 :wide true :left source :right 0
                                    :immediate 0))))))))))

;;; Bit-test comparison tiles keep rule 20/21 (the tested value EQ/NE zero), so
;;; every consumer of comparison flags applies. Their immediate is outside the
;;; CMP/CMN displacement range:
;;;   BIT-TEST + k, right = 0: bit k of left (TST left, #(1 << k)).
;;;   BIT-TEST-SHIFTED: bit (right mod width) of left (LSR by right, TST #1).
(def BIT-TEST (: 0x10000000000 u64))
(def BIT-TEST-SHIFTED (: 0x20000000000 u64))

(defn bit-test? [(tile Tile)] (-> bool)
  (and (or (= (.rule tile) 20) (= (.rule tile) 21)) (>= (.immediate tile) BIT-TEST)
       (<= (.immediate tile) BIT-TEST-SHIFTED)))

(defn shifted-bit-test? [(tile Tile)] (-> bool)
  (and (or (= (.rule tile) 20) (= (.rule tile) 21)) (= (.immediate tile) BIT-TEST-SHIFTED)))

;;; Bit index of an unshifted bit-test tile.
(defn tested-bit [(tile Tile)] (-> i32)
  (cast i32 (- (.immediate tile) BIT-TEST)))

;;; A value an instruction placed later may read: defined by an ordinary
;;; instruction. RLOAD keeps its pinned position.
(defn free-value? [(graph g/Graph) (reference i32)] (-> bool)
  (and (> reference 0)
       (!= (n/opcode (get (.instructions graph) (cast i64 reference))) 89)))

;;; Bits of a numeric literal, or of a COPY of one: a constant held in a
;;; register (loop-invariant constants are hoisted as such copies).
(defn constant-bits [(graph g/Graph) (reference i32)] (-> (Option u64))
  (if (<= reference 0)
      (numeric-bits graph reference)
      (let [node (get (.instructions graph) (cast i64 reference))]
        (if (= (n/opcode node) 68) (numeric-bits graph (.op1 node)) (None)))))

;;; The count n of SHL(1, n) in the integer type ty, or zero.
(defn unit-shift-count [(graph g/Graph) (reference i32) (ty u8)] (-> i32)
  (if (<= reference 0)
      0
      (let [node (get (.instructions graph) (cast i64 reference))]
        (if (and (= (n/opcode node) 49) (= (n/type-id node) ty)
                 (free-value? graph (.op2 node))
                 (match (constant-bits graph (.op1 node))
                   (Some [bits] (= bits 1))
                   (None [] false)))
            (.op2 node)
            0))))

;;; TILE is EQ/NE(a, 0) as comparison-immediate left it. When a is an AND of a
;;; 32/64-bit integer type, the comparison is a bit test of the AND's input:
;;;   AND(x, 2^k): bit k of x.
;;;   AND(SHL(1, n), m): bit n of m. SHL masks its count to the type width, as
;;;     LSR does, so (1 << n) & m is nonzero exactly when (m >> n) & 1 is.
;;;   AND(TRUNC32(SHL64(1, n)), literal m): bit (n mod 64) of the zero-extended
;;;     literal, which is clear for every count from 32 up, as the truncated
;;;     bit is. The literal may be held by a COPY, whose register is the
;;;     zero-extended materialization; the upper word of any other register m
;;;     is not specified.
;;; The caller retires the AND once this was its last use and must replace the
;;; machine uses before liveness.
(defn bit-test [(graph g/Graph) (tile Tile)] (-> (Option Tile))
  (if (or (not (or (= (.rule tile) 20) (= (.rule tile) 21)))
          (!= (.right tile) 0) (!= (.immediate tile) 0) (<= (.left tile) 0))
      (None)
      (let [mask (get (.instructions graph) (cast i64 (.left tile)))
            ty (n/type-id mask)
            size (types/scalar-size (cast i32 ty) 8)]
        (if (or (!= (n/opcode mask) 47) (not (types/integer? (cast i32 ty)))
                (not (or (= size 4) (= size 8))))
            (None)
            (let [first-count (unit-shift-count graph (.op1 mask) ty)
                  count (if (> first-count 0) first-count
                            (unit-shift-count graph (.op2 mask) ty))
                  other (if (> first-count 0) (.op2 mask) (.op1 mask))
                  wide-first (if (= size 4) (truncated-unit-shift-count graph (.op1 mask)) 0)
                  wide-count (if (or (> wide-first 0) (!= size 4)) wide-first
                                 (truncated-unit-shift-count graph (.op2 mask)))
                  wide-other (if (> wide-first 0) (.op2 mask) (.op1 mask))]
              (cond (and (> count 0)
                         (or (free-value? graph other)
                             (match (numeric-bits graph other)
                               (Some [bits] (!= bits 0))
                               (None [] false))))
                      (Some (Tile :rule (.rule tile) :wide (= size 8) :left other
                                  :right count :immediate BIT-TEST-SHIFTED))
                    (and (> wide-count 0)
                         (match (constant-bits graph wide-other)
                           (Some [bits] (and (!= bits 0) (= (>> bits 32) 0)))
                           (None [] false)))
                      (Some (Tile :rule (.rule tile) :wide true :left wide-other
                                  :right wide-count :immediate BIT-TEST-SHIFTED))
                    :else
                      (let [literal (match (numeric-bits graph (.op2 mask))
                                      (Some [bits] (Some bits))
                                      (None [] (numeric-bits graph (.op1 mask))))
                            source (match (numeric-bits graph (.op2 mask))
                                     (Some [_] (.op1 mask))
                                     (None [] (.op2 mask)))]
                        (match literal
                          (None [] (None))
                          (Some [raw]
                            (let [bits (if (= size 8) raw (& raw 0xFFFFFFFF))]
                              (if (or (= bits 0) (!= (& bits (- bits 1)) 0)
                                      (not (free-value? graph source)))
                                  (None)
                                  (Some (Tile :rule (.rule tile) :wide (= size 8)
                                              :left source :right 0
                                              :immediate
                                                (+ BIT-TEST
                                                   (trailing-zeros bits)))))))))))))))

;;; The count n of TRUNC32(SHL64(1, n)), or zero.
(defn truncated-unit-shift-count [(graph g/Graph) (reference i32)] (-> i32)
  (if (<= reference 0)
      0
      (let [node (get (.instructions graph) (cast i64 reference))
            source (.op1 node)]
        (if (or (!= (n/opcode node) 35) (<= source 0)
                (not (types/integer? (cast i32 (n/type-id node)))))
            0
            (let [shift (get (.instructions graph) (cast i64 source))]
              (if (and (types/integer? (cast i32 (n/type-id shift)))
                       (= (types/scalar-size (cast i32 (n/type-id shift)) 8) 8))
                  (unit-shift-count graph source (n/type-id shift))
                  0))))))

;;; The access form matching chose for a LOAD, or zero for the form its type
;;; gives: see rule 57.
(defn load-form [(tile Tile)] (-> i32)
  (if (= (.rule tile) 57) (cast i32 (.immediate tile)) 0))

;;; The 64-bit move of rule 56 from SOURCE.
(defn extended-copy [(source i32)] (-> Tile)
  (Tile :rule 56 :wide true :left source :right 0 :immediate 0))

;;; An integer LOAD of WIDTH bytes can be read by a narrower access at the
;;; same address: memory is little-endian. Address-typed loads are excluded.
(defn narrowable-load-type? [(ty u8)] (-> bool)
  (or (= ty 3) (= ty 4) (= ty 5) (= ty 9) (= ty 10) (= ty 11)))

;;; Integer types a TRUNC view of a narrowed LOAD may have. BOOL and CHAR
;;; destinations are canonicalized by their own conversion.
(defn narrow-view-type? [(ty u8)] (-> bool)
  (or (= ty 2) (= ty 3) (= ty 4) (= ty 8) (= ty 9) (= ty 10)))

;;; A variable shift reads only the low bits of its count: six for an X form
;;; and five for a W form. SEXT, ZEXT, TRUNC and integer BITCAST between
;;; integer types of at least a byte keep those bits, so the count can be read
;;; from the conversion's source. Returns that source, or zero. BOOL is
;;; excluded on both sides: its conversions canonicalize.
(defn count-view-source [(graph g/Graph) (reference i32)] (-> i32)
  (if (<= reference 0)
      0
      (let [node (get (.instructions graph) (cast i64 reference))
            opcode (n/opcode node)
            ty (cast i32 (n/type-id node))
            source (.op1 node)]
        (if (or (< opcode 33) (> opcode 36) (<= source 0)
                (not (types/integer? ty)) (= ty 1) (= ty 6))
            0
            (let [from (cast i32 (n/type-id (get (.instructions graph) (cast i64 source))))]
              (if (or (not (types/integer? from)) (= from 1) (= from 6)
                      (= (n/opcode (get (.instructions graph) (cast i64 source))) 89))
                  0
                  source))))))

(defn swapped-condition [(condition i32)] (-> i32)
  (case condition 2 9 3 8 8 3 9 2 10 13 11 12 12 11 13 10 condition))

;;; A zero RHS reference denotes an immediate, as with the existing arithmetic
;;; tiles. Its bits represent the signed CMP/CMN displacement, not a graph ref.
(defn comparison-immediate [(graph g/Graph) (tile Tile) (width i32)] (-> Tile)
  (let [(mut literal) (numeric-bits graph (.right tile))
        (mut source) (.left tile)
        (mut condition) (- (.rule tile) 20)]
    (match literal
      (Some [_] 0)
      (None []
            (set! literal (numeric-bits graph (.left tile)))
            (set! source (.right tile))
            (set! condition (swapped-condition condition))))
    (match literal
      (None [] tile)
      (Some [bits]
            (let [signed-order (and (>= condition 10) (<= condition 13))
                  value
                    (if (= width 64)
                        (cast i64 bits)
                        (if (or (= width 32) signed-order)
                            (>> (cast i64 (<< bits (cast u64 (- 64 width))))
                                (cast i64 (- 64 width)))
                            (cast i64
                                  (& bits (- (<< (: 1 u64) (cast u64 width)) 1)))))]
              (if (displacement? value)
                  (Tile
                    :rule (+ 20 condition)
                    :wide (.wide tile)
                    :left source
                    :right 0
                    :immediate (cast u64 value))
                  ; An ordered comparison with a literal next to an encodable
                  ; one compares with that neighbor: x > c is x >= c + 1 and
                  ; x >= c is x > c - 1, in both orders. The neighbor is small,
                  ; so a signed literal cannot wrap; the largest unsigned
                  ; literal has no successor and zero no predecessor.
                  (let [unsigned (or (= condition 2) (= condition 3)
                                     (= condition 8) (= condition 9))
                        up (or (= condition 12) (= condition 13)
                               (= condition 8) (= condition 9))
                        ; Far literals have no encodable neighbor; leave
                        ; them alone rather than step past the i64 range.
                        neighbor (if (or (< value -16773121) (> value 16773121)) value
                                     (if up (+ value 1) (- value 1)))]
                    (if (and (>= width 32) (>= condition 2)
                             (not (and unsigned (= value (if up (: -1 i64) 0))))
                             (displacement? neighbor))
                        (Tile
                          :rule (+ 20 (case condition 12 10 13 11 10 12 11 13
                                            8 2 9 3 2 8 3 9 condition))
                          :wide (.wide tile)
                          :left source
                          :right 0
                          :immediate (cast u64 neighbor))
                        tile))))))))

;;; A signed CMP/CMN displacement: twelve bits, optionally shifted by twelve.
(defn displacement? [(value i64)] (-> bool)
  (and (>= value -16773120) (<= value 16773120)
       (let [magnitude (if (< value 0) (- (: 0 i64) value) value)]
         (or (<= magnitude 4095) (= (% magnitude 4096) 0)))))

;;; The 32-bit source of a SEXT/ZEXT into a 64-bit integer word, or zero.
;;; Narrower sources are excluded: their register bits above the value are
;;; not defined, so a W-form comparison would observe them. RLOAD keeps its
;;; pinned position. Kind is the extension opcode: 33=SEXT, 34=ZEXT.
(defn word-extension-source [(graph g/Graph) (reference i32) (kind u8)] (-> i32)
  (if (<= reference 0)
      0
      (let [node (get (.instructions graph) (cast i64 reference))
            ty (n/type-id node)
            source (.op1 node)]
        (if (or (!= (n/opcode node) kind) (not (or (= ty 5) (= ty 11))) (<= source 0))
            0
            (let [input (get (.instructions graph) (cast i64 source))
                  from (n/type-id input)]
              (if (and (or (= from 4) (= from 10)) (!= (n/opcode input) 89))
                  source
                  0))))))

;;; Case literal BITS of a SWITCH on the extension SELECTOR can be compared as
;;; a word: it is the extension of its own low word. An unsigned 64-bit
;;; selector orders cases as unsigned values, which both extensions preserve.
(defn word-case? [(graph g/Graph) (selector i32) (literal i32)] (-> bool)
  (match (numeric-bits graph literal)
    (None [] false)
    (Some [bits]
          (if (= (n/opcode (get (.instructions graph) (cast i64 selector))) 34)
              (<= bits 0xFFFFFFFF)
              (let [value (cast i64 bits)]
                (and (>= value -2147483648) (<= value 2147483647)))))))

;;; The SWITCH selector as a retirable unsigned 64-bit word extension, or zero.
(defn switch-extension [(graph g/Graph) (node n/Node)] (-> i32)
  (let [selector (.op2 node)]
    (if (and (word-extension? graph selector)
             (= (n/type-id (get (.instructions graph) (cast i64 selector))) 5)
             (> (word-extension-source graph selector
                  (n/opcode (get (.instructions graph) (cast i64 selector))))
                0))
        selector
        0)))

(defn word-extension? [(graph g/Graph) (reference i32)] (-> bool)
  (and (> reference 0)
       (let [opcode (n/opcode (get (.instructions graph) (cast i64 reference)))]
         (or (= opcode 33) (= opcode 34)))))

;;; Signed order on two zero-extended words is unsigned order on the words.
(defn unsigned-condition [(condition i32)] (-> i32)
  (case condition 10 2 11 3 12 8 13 9 condition))

;;; A 64-bit comparison whose inputs are extensions of 32-bit values is the
;;; 32-bit comparison of the sources, exactly in these cases:
;;;   SEXT(x) ? c, c in [-2^31, 2^31): every condition is unchanged. Sign
;;;     extension is strictly increasing for the signed order, and for the
;;;     unsigned order too (negative words map above all nonnegative ones).
;;;   ZEXT(x) ? c, c in [0, 2^32): equality and unsigned order are unchanged;
;;;     signed order becomes unsigned, as both 64-bit values are nonnegative.
;;;   SEXT(x) ? SEXT(y) and ZEXT(x) ? ZEXT(y): likewise.
;;; A literal outside the stated range, mixed extension kinds and non-word
;;; sources keep the 64-bit comparison. An immediate tile already holds the
;;; signed literal; a literal left in a register must also be a W-form
;;; constant, so a signed one is narrowed only when nonnegative.
;;; The caller must replace the machine uses before liveness.
(defn narrowed-comparison [(graph g/Graph) (tile Tile)] (-> (Option Tile))
  (if (or (not (.wide tile)) (< (.rule tile) 20) (> (.rule tile) 33))
      (None)
      (let [condition (- (.rule tile) 20)
            left (.left tile)
            right (.right tile)
            kind (if (> left 0)
                     (n/opcode (get (.instructions graph) (cast i64 left)))
                     (if (> right 0)
                         (n/opcode (get (.instructions graph) (cast i64 right)))
                         (: 0 u8)))
            rule (+ 20 (if (= kind 34) (unsigned-condition condition) condition))]
        (if (not (or (= kind 33) (= kind 34)))
            (None)
            (let [first (word-extension-source graph left kind)
                  second (word-extension-source graph right kind)]
              (cond (= right 0)
                      (if (or (= first 0)
                              (and (= kind 34) (< (cast i64 (.immediate tile)) 0)))
                          (None)
                          (Some (Tile :rule rule :wide false :left first :right 0
                                      :immediate (.immediate tile))))
                    (and (> first 0) (> second 0))
                      (Some (Tile :rule rule :wide false :left first :right second
                                  :immediate 0))
                    :else
                      (let [literal (if (> first 0) right left)
                            limit (if (= kind 34) (: 0xFFFFFFFF u64) (: 0x7FFFFFFF u64))]
                        (if (and (or (> first 0) (> second 0)) (< literal 0))
                            (match (numeric-bits graph literal)
                              (None [] (None))
                              (Some [bits]
                                    (if (> bits limit)
                                        (None)
                                        (Some (Tile :rule rule :wide false
                                                    :left (if (> first 0) first left)
                                                    :right (if (> first 0) right second)
                                                    :immediate 0)))))
                            (None)))))))))

;;; A comparison tile whose flags come from one X- or W-form CMP/CMN of its
;;; operands as they are held: X form, or W form with every operand at least a
;;; word. Byte and halfword operands need normalization first.
(defn direct-comparison? [(graph g/Graph) (tile Tile)] (-> bool)
  (and (>= (.rule tile) 20) (<= (.rule tile) 33)
       (or (.wide tile)
           (and (match (g/lookup graph (.left tile))
                  (None [] false)
                  (Some [operand] (>= (types/scalar-size (cast i32 (n/type-id operand)) 8) 4)))
                (or (= (.right tile) 0)
                    (match (g/lookup graph (.right tile))
                      (None [] false)
                      (Some [operand]
                            (>= (types/scalar-size (cast i32 (n/type-id operand)) 8) 4))))))))

(defn comparison [(graph g/Graph) (reference i32)] (-> (Result Tile (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "comparison missing"))
    (Some [node]
          (let [opcode (n/opcode node)
                condition
                  (match opcode
                    (14 0)
                    (15 1)
                    (16 11)
                    (17 10)
                    (18 13)
                    (19 12)
                    (20 3)
                    (21 2)
                    (22 9)
                    (23 8)
                    (_ -1))]
            (if (or (< condition 0) (!= (n/type-id node) 1))
                (Err "invalid comparison")
                (match (g/lookup graph (.op1 node))
                  (None [] (Err "comparison operand missing"))
                  (Some [left]
                        (match (g/lookup graph (.op2 node))
                          (None [] (Err "comparison operand missing"))
                          (Some [right]
                                (let [ty (n/type-id left)]
                                  (if (or (!= ty (n/type-id right))
                                          (not (types/integer? (cast i32 ty))))
                                      (Err "unsupported comparison types")
                                      (Ok (comparison-immediate graph
                                                                (Tile
                                                                  :rule
                                                                    (cast i32
                                                                          (+ 20
                                                                             condition))
                                                                  :wide
                                                                    (or (= ty 6)
                                                                        (= ty 5)
                                                                        (= ty
                                                                           11))
                                                                  :left
                                                                    (.op1 node)
                                                                  :right
                                                                    (.op2 node)
                                                                  :immediate 0)
                                                                (* (types/scalar-size (cast i32
                                                                                            ty)
                                                                                      8)
                                                                   8))))))))))))))

(defn select [(graph g/Graph) (reference i32)] (-> (Result Tile (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "selection node missing"))
    (Some [node]
          (if (and (>= (n/opcode node) 14) (<= (n/opcode node) 23))
              (comparison graph reference)
              (arithmetic graph reference)))))

;;; Integer vector multiplication by a direct typed SPLAT(2) is lane-wise
;;; doubling modulo the element width. Do not inspect through COPY barriers.
(defn splat-two? [(graph g/Graph) (reference i32) (ty i32)] (-> bool)
  (if (<= reference 0)
      false
      (match (g/lookup graph reference)
        (None [] false)
        (Some [node]
              (if (and (= (n/opcode node) 63)
                       (= (cast i32 (n/type-id node)) ty)
                       (< (.op1 node) 0))
                  (match (g/lookup graph (.op1 node))
                    (None [] false)
                    (Some [literal]
                          (and (symbols/numeric? literal)
                               (= (cast i32 (n/type-id literal))
                                  (types/base-type ty))
                               (= (n/constant-bits literal) 2))))
                  false)))))

(defn doubling-source [(graph g/Graph) (reference i32)] (-> i32)
  (match (g/lookup graph reference)
    (None [] 0)
    (Some [node]
          (let [ty (cast i32 (n/type-id node))]
            (if (and (= (n/opcode node) 28)
                     (types/vector? ty)
                     (types/integer? (types/base-type ty))
                     (!= (types/base-type ty) 1))
                (if (and (> (.op1 node) 0) (splat-two? graph (.op2 node) ty))
                    (.op1 node)
                    (if (and (> (.op2 node) 0)
                             (splat-two? graph (.op1 node) ty))
                        (.op2 node)
                        0))
                0)))))
