;;; Lattice-aware fold/meet bridge, following pinned ir_sccp.c:ir_sccp_fold.
;;; Scalar evaluation is shared with construction; the original graph is read-only.
(module stogir.sccp-fold)
(import "stogir.graph" :as g)
(import "stogir.copy" :as copies)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "stogir.fold" :as fold)
(import "stogir.integer-binary" :as binary)
(import "stogir.integer-unary" :as unary)
(import "stogir.floating" :as floating)
(import "stogir.conversion" :as conversion)
(import "stogir.conditional" :as conditional)
(import "stogir.checked" :as checked)
(import "stogir.sccp-values" :as v)
(import "stogir.sccp-phi" :as phi)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "coil.result" :use [Result Ok Err Option Some None])

;;; Decisions distinguish upstream EMIT, CONST, COPY, CSE and unary RESTART outcomes. They are
;;; transient rule results, not an additional graph or expression representation.
(defstruct Decision [(kind i32) (constant n/Node) (source i32)])

(defn emit [] (-> Decision)
  (Decision
    :kind 0
    :constant (n/make 0 0 0 0 0 0)
    :source 0))

(defn cse [] (-> Decision)
  (Decision
    :kind 3
    :constant (n/make 0 0 0 0 0 0)
    :source 0))

(defn scalar [(ty i32) (bits u64)] (-> Decision)
  (Decision
    :kind 1
    :constant (n/constant (cast u8 ty) (cast u8 ty) 0 bits)
    :source 0))

(defn copy [(source i32)] (-> Decision)
  (Decision
    :kind 2
    :constant (n/make 0 0 0 0 0 0)
    :source source))

;;; Resolve copies/long constants through their original signed references.
;;; A bottom value still exposes its original instruction for structural rules.
(defn value [(graph g/Graph) (domain v/Domain) (reference i32)] (-> n/Node)
  (let [identity (v/identity domain reference)]
    (if (< identity 0)
        (phi/constant graph identity)
        (let [fact (v/at domain identity)
              kind (v/state-kind fact)]
          (if (or (and (>= kind 1) (<= kind 13))
                  (and (>= kind 73) (<= kind 77)))
              fact
              (get (.instructions graph) (cast i64 identity)))))))

(defn numeric? [(value n/Node)] (-> bool)
  (and (symbols/numeric? value)
       (> (n/type-id value) 0)
       (types/valid-scalar? (cast i32 (n/type-id value)))))

(defn integer-literal? [(value n/Node)] (-> bool)
  (let [kind (cast i32 (n/opcode value))]
    (or (and (>= kind 2) (<= kind 6)) (and (>= kind 8) (<= kind 11)))))

(defn restart-unary [(opcode i32) (ty i32) (source i32)] (-> Decision)
  (Decision :kind 4 :constant (n/make (cast u8 opcode) (cast u8 ty) 0 source 0 0)
            :source source))

;;; Pinned ir_fold.h AND/OR/XOR(_, C_*), including BOOL and CHAR. Match
;;; actual scalar numeric constants only and retain required type views. Both
;;; orders are supported because raw/cloned graphs need not be canonicalized.
(defn bit-constant? [(value n/Node)] (-> bool)
  (let [ty (cast i32 (n/type-id value))]
    (and (= (cast i32 (n/opcode value)) ty) (types/integer? ty) (!= ty 6))))

(defn bit-literal [(opcode i32) (ty i32) (left i32) (first n/Node)
                    (right i32) (second n/Node) (pointer-bytes i32)]
  (-> (Option Decision))
  (if (and (or (= pointer-bytes 4) (= pointer-bytes 8))
           (>= opcode 46) (<= opcode 48) (types/integer? ty) (!= ty 6)
           (= (cast i32 (n/type-id first)) ty)
           (= (cast i32 (n/type-id second)) ty)
           (!= (bit-constant? first) (bit-constant? second)))
      (let [literal-left (bit-constant? first)
            literal (if literal-left first second)
            reference (if literal-left left right)
            input (if literal-left right left)
            width (if (= ty 1) 1 (* 8 (types/size ty pointer-bytes)))
            full (if (= width 64) (: 0xFFFFFFFFFFFFFFFF u64)
                     (- (<< (: 1 u64) (cast u64 width)) 1))
            value (n/constant-bits literal)]
        (cond (= value 0)
                (Some (copy (if (= opcode 47) reference input)))
              (= value full)
                (Some (case opcode
                        46 (copy reference)
                        47 (copy input)
                        (restart-unary 45 ty input)))
              :else (None)))
      (None)))

(defn optional [(ty i32) (bits (Option u64))] (-> Decision)
  (match bits (None [] (cse)) (Some [result] (scalar ty result))))

(defn structural-value [(graph g/Graph) (reference i32)] (-> n/Node)
  (match (g/lookup graph reference)
    (Some [node] node)
    (None [] (n/make 0 0 0 0 0 0))))

;;; A local bit-pattern bound, not a new SCCP lattice or a repeated graph
;;; analysis. Each supported expression has zero outside its returned mask.
;;; Read only the immutable graph here. SCCP facts on grandchildren can still
;;; change after their direct consumer becomes Bottom; those changes do not
;;; requeue this comparison. Using such facts would make a transient bound
;;; permanent (for example a loop-carried mask initially equal to zero).
;;; These generic mask proofs are an independent fold extension; see provenance.
(defn range-type? [(ty i32)] (-> bool)
  (and (types/integer? ty) (> ty 1) (!= ty 6)))

(defn width-mask [(ty i32) (pointer-bytes i32)] (-> u64)
  (let [width (* 8 (types/scalar-size ty pointer-bytes))]
    (if (= width 64)
        (: 0xFFFFFFFFFFFFFFFF u64)
        (- (<< (: 1 u64) (cast u64 width)) 1))))

(defn and-mask [(graph g/Graph)
                (node n/Node)
                (pointer-bytes i32)] (-> (Option u64))
  (if (and (= (n/opcode node) 47)
           (range-type? (cast i32 (n/type-id node))))
      (let [left (structural-value graph (.op1 node))
            right (structural-value graph (.op2 node))
            ty (n/type-id node)]
        (cond (and (numeric? right) (= (n/type-id right) ty))
                (Some (& (n/constant-bits right)
                         (width-mask (cast i32 ty) pointer-bytes)))
              (and (numeric? left) (= (n/type-id left) ty))
                (Some (& (n/constant-bits left)
                         (width-mask (cast i32 ty) pointer-bytes)))
              :else (None)))
      (None)))

;;; A truncation of a masked word retains only the destination's allowed bits.
(defn truncated-mask [(graph g/Graph)
                      (node n/Node)
                      (pointer-bytes i32)] (-> (Option u64))
  (if (and (= (n/opcode node) 35)
           (range-type? (cast i32 (n/type-id node))))
      (match (and-mask graph
                       (structural-value graph (.op1 node))
                       pointer-bytes)
        (None [] (None))
        (Some [mask]
              (Some (& mask
                       (width-mask (cast i32 (n/type-id node)) pointer-bytes)))))
      (and-mask graph node pointer-bytes)))

;;; Handle ZEXT and the proven nonnegative subset of SEXT, optionally after
;;; TRUNC(AND). Other conversion chains stay with the ordinary restart rules.
(defn comparison-mask [(graph g/Graph)
                       (node n/Node)
                       (pointer-bytes i32)] (-> (Option u64))
  (let [opcode (n/opcode node)]
    (if (and (or (= opcode 33) (= opcode 34))
             (range-type? (cast i32 (n/type-id node))))
        (let [source (structural-value graph (.op1 node))
              ty (cast i32 (n/type-id source))
              width (* 8 (types/scalar-size ty pointer-bytes))]
          (if (not (range-type? ty))
              (None)
              (let [bound (truncated-mask graph source pointer-bytes)]
                (if (= opcode 34)
                    (match bound
                      (Some [mask] (Some mask))
                      (None [] (Some (width-mask ty pointer-bytes))))
                    (match bound
                      (None [] (None))
                      (Some [mask]
                            (if (< mask (<< (: 1 u64) (cast u64 (- width 1))))
                                (Some mask)
                                (None))))))))
        (truncated-mask graph node pointer-bytes))))

(defn compare-mask [(graph g/Graph)
                    (opcode i32)
                    (left n/Node)
                    (right n/Node)
                    (pointer-bytes i32)] (-> (Option u64))
  (let [ty (cast i32 (n/type-id left))]
    (if (and (>= opcode 14)
             (<= opcode 23)
             (range-type? ty)
             (numeric? right)
             (= (n/type-id left) (n/type-id right)))
        (match (comparison-mask graph left pointer-bytes)
          (None [] (None))
          (Some [mask]
                (let [limit (n/constant-bits right)
                      full (width-mask ty pointer-bytes)
                      outside (!= (& (& limit full) (^ mask full)) 0)]
                  (if (or (= opcode 14) (= opcode 15))
                      (if (or outside (= mask 0))
                          (fold/integer-compare opcode ty pointer-bytes 0 limit)
                          (None))
                      (if (and (< opcode 20)
                               (>= mask
                                   (<< (: 1 u64)
                                       (cast u64
                                             (- (* 8
                                                   (types/scalar-size ty
                                                                      pointer-bytes))
                                                1)))))
                          (None)
                          (match (fold/integer-compare opcode
                                                       ty
                                                       pointer-bytes
                                                       0
                                                       limit)
                            (None [] (None))
                            (Some [low]
                                  (match (fold/integer-compare opcode
                                                               ty
                                                               pointer-bytes
                                                               mask
                                                               limit)
                                    (None [] (None))
                                    (Some [high]
                                          (if (= low high) (Some low) (None)))))))))))
        (None))))

;;; A transient read view: Some carries real SCCP facts; None means values
;;; are the current graph itself. Iterative folding has no lattice to allocate,
;;; initialize or release. Both callers share the same fold decision rules.
(defn view-identity [(facts (Option v/Domain)) (reference i32)] (-> i32)
  (match facts
    (None [] reference)
    (Some [domain] (v/identity domain reference))))

(defn view-value [(graph g/Graph) (facts (Option v/Domain)) (reference i32)]
  (-> n/Node)
  (match facts
    (None []
          (if (< reference 0)
              (phi/constant graph reference)
              (get (.instructions graph) (cast i64 reference))))
    (Some [domain] (value graph domain reference))))

(defn evaluate [(graph g/Graph)
                (domain v/Domain)
                (reference i32)
                (pointer-bytes i32)] (-> (Result Decision (slice u8)))
  (evaluate-view graph (Some domain) reference pointer-bytes))

(defn evaluate-current [(graph g/Graph) (reference i32) (pointer-bytes i32)]
  (-> (Result Decision (slice u8)))
  (evaluate-view graph (None) reference pointer-bytes))

(defn evaluate-view [(graph g/Graph)
                     (facts (Option v/Domain))
                     (reference i32)
                     (pointer-bytes i32)]
  (-> (Result Decision (slice u8)))
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        ty (cast i32 (n/type-id node))
        left (view-identity facts (.op1 node))
        first (view-value graph facts (.op1 node))
        from (cast i32 (n/type-id first))]
    (cond (= opcode 68) (Ok (if (copies/hard? node) (emit) (copy left)))
          ;;; These families have no literal rule in pinned ir_fold.h. Its
          ;;; default CSE outcome becomes Bottom in ir_sccp_fold, just as EMIT.
          (or (= opcode 40) (= opcode 65) (= opcode 66)) (Ok (cse))
          (= opcode 60)
            (let [yes (view-identity facts (.op2 node))
                  no (view-identity facts (.op3 node))]
              (if (= yes no)
                  (Ok (copy yes))
                  (match (conditional/truth-value first)
                    (None [] (Ok (cse)))
                    (Some [truth] (Ok (copy (if truth yes no)))))))
          (= opcode 44)
            (Ok (if (checked/operation? (cast i32 (n/opcode first)))
                    (cse)
                    (scalar 1 0)))
          ;;; Extension floating opcodes: literal operands fold only where
          ;;; floating/evaluate fixes every bit; otherwise exact-operand CSE.
          (floating/extension? opcode)
            (let [second
                    (view-value graph
                                facts
                                (if (floating/unary? opcode)
                                    (.op1 node)
                                    (.op2 node)))]
              (Ok (if (and (not (floating/ternary? opcode))
                           (numeric? first)
                           (numeric? second))
                      (optional ty
                                (floating/evaluate opcode
                                                   from
                                                   (n/constant-bits first)
                                                   (n/constant-bits second)))
                      (cse))))
          (types/vector? ty) (Err "SCCP vector fold family is not implemented")
          (and (= opcode 36) (= from ty) (not (numeric? first)))
            (Ok (copy left))
          (and (or (= opcode 31) (= opcode 45) (= opcode 54))
               (= (cast i32 (n/opcode first)) opcode))
            (Ok (copy (view-identity facts (.op1 first))))
          (and (= opcode 32) (= (n/opcode first) 32)) (Ok (copy left))
          (conversion/operation? opcode)
            (Ok (if (numeric? first)
                    (optional ty
                              (conversion/evaluate opcode
                                                   from
                                                   ty
                                                   pointer-bytes
                                                   (n/constant-bits first)))
                    (cse)))
          (or (binary/operation? opcode)
              (and (>= opcode 14) (<= opcode 25))
              (checked/operation? opcode))
            (let [right (view-identity facts (.op2 node))
                  second (view-value graph facts (.op2 node))
                  literals? (and (numeric? first) (numeric? second))
                  literal-bit
                    (if (and (not literals?) (>= opcode 46) (<= opcode 48))
                        (bit-literal opcode ty left first right second pointer-bytes)
                        (None))
                  masked
                    (if (and (not literals?) (>= opcode 14) (<= opcode 23))
                        (compare-mask graph
                                      opcode
                                      (structural-value graph (.op1 node))
                                      second
                                      pointer-bytes)
                        (None))]
              ;;; Same-reference rules are generic in pinned ir_fold.h. Only
              ;;; integer comparisons/subtraction may disregard NaN/signed zero.
              (cond (match literal-bit (Some [_] true) (None [] false))
                      (Ok (match literal-bit (Some [decision] decision) (None [] (cse))))
                    (match masked (Some [_] true) (None [] false))
                      (Ok (match masked
                            (Some [truth] (scalar 1 truth))
                            (None [] (cse))))
                    (and (not literals?)
                         (= left right)
                         (or (= opcode 46)
                             (= opcode 47)
                             (= opcode 58)
                             (= opcode 59)))
                      (Ok (copy left))
                    (and (= left right)
                         (types/integer? from)
                         (or (= opcode 27) (= opcode 42) (= opcode 48)))
                      (Ok (scalar ty 0))
                    (and (= left right)
                         (types/integer? from)
                         (>= opcode 14)
                         (<= opcode 23))
                      (Ok (scalar 1
                                  (if (or (= opcode 14)
                                          (= opcode 17)
                                          (= opcode 18)
                                          (= opcode 21)
                                          (= opcode 22))
                                      1
                                      0)))
                    ;;; Literal identity families exclude BOOL/CHAR in upstream.
                    ;;; Exact result-type checks avoid erasing required bitcasts
                    ;;; in mixed address/integer arithmetic.
                    (and (not literals?)
                         (integer-literal? second)
                         (= (n/constant-bits second) 0)
                         (= from ty)
                         (or (= opcode 26)
                             (= opcode 27)
                             (= opcode 41)
                             (= opcode 42)))
                      (Ok (copy left))
                    (and (= opcode 26)
                         (integer-literal? first)
                         (= (n/constant-bits first) 0)
                         (= (cast i32 (n/type-id second)) ty))
                      (Ok (copy right))
                    (and (= opcode 28)
                         (integer-literal? second)
                         (= (cast i32 (n/type-id second)) ty)
                         (<= (n/constant-bits second) 1))
                      (Ok (copy (if (= (n/constant-bits second) 0) right left)))
                    (and (= opcode 28)
                         (integer-literal? first)
                         (= from ty)
                         (<= (n/constant-bits first) 1))
                      (Ok (copy (if (= (n/constant-bits first) 0) left right)))
                    (not (and (numeric? first) (numeric? second)))
                      (Ok (if (checked/operation? opcode) (emit) (cse)))
                    (types/floating? from)
                      (Ok (optional ty
                                    (floating/evaluate opcode
                                                       from
                                                       (n/constant-bits first)
                                                       (n/constant-bits second))))
                    (checked/operation? opcode)
                      (Ok (match (checked/evaluate opcode
                                                   ty
                                                   pointer-bytes
                                                   (n/constant-bits first)
                                                   (n/constant-bits second))
                            (None [] (emit))
                            (Some [result]
                                  (if (.overflow? result)
                                      (emit)
                                      (scalar ty (.bits result))))))
                    (and (>= opcode 14) (<= opcode 23))
                      (Ok (optional 1
                                    (fold/integer-compare opcode
                                                          from
                                                          pointer-bytes
                                                          (n/constant-bits first)
                                                          (n/constant-bits second))))
                    :else
                      (Ok (match (fold/integer-binary opcode
                                                      ty
                                                      pointer-bytes
                                                      (n/constant-bits first)
                                                      (n/constant-bits second))
                            (Some [bits] (scalar ty bits))
                            (None []
                                  (if (or (= opcode 29) (= opcode 30))
                                      (emit)
                                      (cse)))))))
          (unary/operation? opcode)
            (Ok (if (numeric? first)
                    (optional ty
                              (if (types/floating? from)
                                  (floating/evaluate opcode
                                                     from
                                                     (n/constant-bits first)
                                                     0)
                                  (fold/integer-unary opcode
                                                      ty
                                                      pointer-bytes
                                                      (n/constant-bits first))))
                    (cse)))
          :else (Err "SCCP fold family is not implemented"))))

(defn meet-reference! [(graph g/Graph)
                       (domain (mut v/Domain))
                       (edges uses/Uses)
                       (reference i32)
                       (source i32)] (-> bool)
  (let [identity (v/identity domain source)
        constant (value graph domain source)
        kind (cast i32 (n/opcode constant))]
    (if (= kind 78)
        (v/meet-long! (mut domain) edges reference identity constant)
        (if (or (and (>= kind 1) (<= kind 13)) (and (>= kind 73) (<= kind 77)))
            (v/meet-constant! (mut domain) edges reference constant)
            (v/meet-copy! (mut domain) edges reference identity)))))

;;; Upstream only reevaluates a fold when direct lattice replacements can help
;;; (or this instruction already had a fact). Construction handles initial
;;; all-literal folds. Raw graph cloning can expose a new all-literal operation,
;;; so evaluate that case even without a positive lattice replacement.
;;; DIV/MOD's guard and COPY's metadata are not data inputs.
;;;
;;; A guarded DIV/MOD is computed only where its guard executes, so while the
;;; guard is unreached its value stays top, like an operand that is top. The
;;; runner notifies the users of a control node when it becomes reachable,
;;; which reevaluates the division. One whose guard is never reached ends top
;;; and is removed with the dead arm, together with what is computed from it.
(defn transfer! [(graph g/Graph)
                 (domain (mut v/Domain))
                 (edges uses/Uses)
                 (iteration (mut q/Queue))
                 (reference i32)
                 (pointer-bytes i32)]
  (-> (Result bool (slice u8)))
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))
        count (if (or (= opcode 29) (= opcode 30)) 2 (op/input-count opcode))
        (mut benefit)
          (or (not (v/top? domain reference))
              (= opcode 68)
              (and (>= opcode 46) (<= opcode 48)
                   (or (< (.op1 node) 0) (< (.op2 node) 0)))
              ; Raw mask/conversion comparisons can fold structurally without
              ; a direct lattice replacement. Try them before committing Bottom.
              (and (>= opcode 14)
                   (<= opcode 23)
                   (> (.op1 node) 0)
                   (< (.op2 node) 0)
                   (let [producer
                           (n/opcode (get (.instructions graph)
                                          (cast i64 (.op1 node))))]
                     (or (= producer 47)
                         (= producer 33)
                         (= producer 34)
                         (= producer 35)))))
        (mut all-literals) (> count 0)
        (mut top) (and (or (= opcode 29) (= opcode 30))
                       (> (.op3 node) 0)
                       (not (v/reachable? domain (.op3 node))))
        (mut changed) false
        (mut error) ""]
    (for [index 1 (+ (cast i64 count) 1)]
      (let [source (phi/input graph reference (cast i32 index))]
        (when (>= source 0) (set! all-literals false))
        (when (> source 0)
          (if (v/top? domain source)
              (do (set! top true) (v/add-input! (mut domain) source))
              (when (not (v/bottom? domain source)) (set! benefit true))))))
    (when (not top)
      (if (not (or benefit all-literals))
          (do (v/make-bottom! (mut domain) edges reference) (set! changed true))
          (match (evaluate graph domain reference pointer-bytes)
            (Err [message] (set! error message))
            (Ok [decision]
                (set! changed
                      (match (.kind decision)
                        (0 (v/make-bottom! (mut domain) edges reference) true)
                        (3 (v/make-bottom! (mut domain) edges reference) true)
                        (4 (q/add! (mut iteration) (cast i64 reference))
                           (v/make-bottom! (mut domain) edges reference) true)
                        (1 (v/meet-constant! (mut domain)
                                             edges
                                             reference
                                             (.constant decision)))
                        (_ (meet-reference! graph
                                            (mut domain)
                                            edges
                                            reference
                                            (.source decision))))))))
      (when (and changed
                 (v/bottom? domain reference)
                 (or (!= (n/opcode (fold/rotate graph reference pointer-bytes)) 0)
                     (= opcode 33)
                     (= opcode 35)
                     (and (or (= opcode 34) (= opcode 36))
                          (> (.op1 node) 0)
                          (let [inner
                                  (n/opcode (get (.instructions graph)
                                                 (cast i64 (.op1 node))))]
                            (or (= inner 34) (= inner 36))))
                     (= opcode 38)
                     (= opcode 39)
                     ; EQ/NE(COND(Boolean, literal, literal) or PHI, literal) are the
                     ; iterative Boolean compare/PHI rules; Bottom alone hides them.
                     (and (or (= opcode 14) (= opcode 15))
                          (> (.op1 node) 0)
                          (< (.op2 node) 0)
                          (let [producer (n/opcode (get (.instructions graph)
                                                        (cast i64 (.op1 node))))]
                            (or (= producer 60) (= producer 67))))))
        (q/add! (mut iteration) (cast i64 reference))))
    (if (= error "") (Ok changed) (Err error))))
