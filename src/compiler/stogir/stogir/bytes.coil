;;; Host-independent little-endian code/data output shared by JIT and AOT.
(module stogir.bytes)
(import "coil.primitive" :as primitive)
(import "coil.mem" :as mem)
(import "coil.arraylist" :use [ArrayList])

(defn append32! [(bytes (mut (ArrayList u8))) (word u32)] (-> void)
  (push! (mut bytes) (cast u8 (& word 255)))
  (push! (mut bytes) (cast u8 (& (>> word 8) 255)))
  (push! (mut bytes) (cast u8 (& (>> word 16) 255)))
  (push! (mut bytes) (cast u8 (>> word 24))))

(defn patch32! [(bytes (mut (ArrayList u8))) (offset i64) (word u32)] (-> bool)
  (if (or (< offset 0) (> offset (- (len bytes) 4)))
      false
      (do
        (set! (mut bytes) offset (cast u8 (& word 255)))
        (set! (mut bytes) (+ offset 1) (cast u8 (& (>> word 8) 255)))
        (set! (mut bytes) (+ offset 2) (cast u8 (& (>> word 16) 255)))
        (set! (mut bytes) (+ offset 3) (cast u8 (>> word 24)))
        true)))

;;; Append a borrowed slice, including a substring of this same byte arena.
;;; Rebase an aliased view after growth, then use one non-overlapping bulk copy.
(defn append-slice! [(out (mut (ArrayList u8))) (value (slice u8))] (-> bool)
  (let [offset (len out)]
    (if (> (len value) (- 0x7FFFFFFFFFFFFFFF offset))
        false
        (let [source (primitive/cast usize (data value))
              base (primitive/cast usize (.data out))
              alias?
                (and (> (len value) 0)
                     (>= source base)
                     (<= (- source base) (cast usize offset))
                     (<= (cast usize (len value))
                         (- (cast usize offset) (- source base))))]
          (if alias?
              (let [source-offset (cast i64 (- source base))
                    need (+ offset (len value))
                    capacity (.cap out)]
                (when (> need capacity)
                  (let [doubled
                          (if (> capacity 4611686018427387903)
                              need
                              (* capacity 2))]
                    (reserve! (mut out) (if (> doubled need) doubled need))))
                ; Source is within the old prefix, disjoint from the appended suffix.
                (mem/copy [u8]
                          (primitive/index (.data out) offset)
                          (primitive/index (.data out) source-offset)
                          (len value))
                (set! (.len out) need))
              (extend! (mut out) (data value) (len value)))
          true))))
