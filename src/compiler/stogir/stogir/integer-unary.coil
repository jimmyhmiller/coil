; Scalar unary families follow dstogov/ir ir_builder.h, 92171d0. See NOTICE.
(module stogir.integer-unary)
(import "stogir.types" :as types)

(defn operation? [(opcode i32)] (-> bool)
  (or (= opcode 31)
      (= opcode 32)
      (= opcode 45)
      (= opcode 54)
      (= opcode 55)
      (= opcode 56)
      (= opcode 57)))

(defn valid-type? [(opcode i32) (ty i32)] (-> bool)
  (and (operation? opcode)
       (types/integer? ty)
       (if (= opcode 45)
           true
           (and (!= ty 1)
                (if (= opcode 31)
                    (!= ty 6)
                    (if (= opcode 32)
                        (types/signed? ty)
                        (if (= opcode 54)
                            (or (= ty 3)
                                (= ty 4)
                                (= ty 5)
                                (= ty 6)
                                (= ty 9)
                                (= ty 10)
                                (= ty 11))
                            true)))))))
