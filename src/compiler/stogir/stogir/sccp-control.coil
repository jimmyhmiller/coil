;;; Control transfer from pinned ir_sccp.c:ir_sccp_analyze. Facts index the
;;; original graph; this module neither changes the graph nor owns its queues.
(module stogir.sccp-control)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "stogir.conditional" :as conditional)
(import "stogir.sccp-values" :as v)
(import "stogir.sccp-phi" :as phi)
(import "stogir.bitqueue" :as q)
(import "stogir.uses" :as uses)
(import "coil.result" :use [Option Some None])

;;; Every continuation cell belongs to its owning instruction, not the lattice
;;; worklist. Retention follows the original input-count storage convention.
(defn retain-tail! [(graph g/Graph) (domain (mut v/Domain)) (reference i32)]
  (-> void)
  (let [count (get (.arities graph) (cast i64 reference))]
    (for [tail 1 (cast i64 (+ 1 (/ count 4)))]
      (v/kind! (mut domain) (+ reference (cast i32 tail)) (op/count)))))

(defn literal [(graph g/Graph) (domain v/Domain) (reference i32)] (-> n/Node)
  (if (< reference 0) (phi/constant graph reference) (v/at domain reference)))

(defn constant? [(domain v/Domain) (reference i32)] (-> bool)
  (or (< reference 0)
      (let [kind (v/state-kind (v/at domain reference))]
        (and (>= kind 1) (<= kind 13)))))

;;; Returns true only when the runner should notify all users. A selected edge
;;; is enqueued directly and deliberately does not wake the unselected edge.
(defn select! [(domain (mut v/Domain)) (reference i32) (target i32)] (-> bool)
  (let [old (v/at domain reference)]
    (if (= (v/state-kind old) 0)
        (do
          (v/kind! (mut domain) reference 116)
          (v/reference! (mut domain) reference target)
          (q/add! (mut (.pending domain)) (cast i64 target))
          false)
        (if (and (= (v/state-kind old) 116) (= (.op1 old) target))
            false
            (do (v/kind! (mut domain) reference (op/count)) true)))))

(defn region! [(graph g/Graph) (domain (mut v/Domain)) (reference i32)]
  (-> bool)
  (let [count (get (.arities graph) (cast i64 reference))
        old (v/at domain reference)
        (mut unfeasible) (: 0 i32)]
    (when (v/top? domain reference) (retain-tail! graph (mut domain) reference))
    (for [index 1 (+ (cast i64 count) 1)]
      (when (not (v/reachable? domain
                               (phi/input graph reference (cast i32 index))))
        (set! unfeasible (+ unfeasible 1))))
    (if (= unfeasible 0)
        (do (v/kind! (mut domain) reference (op/count)) true)
        (if (and (= (v/state-kind old) 112) (= (.op1 old) unfeasible))
            false
            (do
              (v/kind! (mut domain) reference 112)
              (v/reference! (mut domain) reference unfeasible)
              true)))))

(defn if-target [(graph g/Graph) (edges uses/Uses) (reference i32) (yes bool)]
  (-> i32)
  (let [range (get (.ranges edges) (cast i64 reference))
        (mut target) (: 0 i32)]
    (for [i (.offset range) (+ (.offset range) (.count range))]
      (let [use (get (.edges edges) i)
            user (.user use)
            opcode (n/opcode (get (.instructions graph) (cast i64 user)))]
        (when (and (= (.operand use) 1) (= opcode (if yes 107 108)))
          (set! target user))))
    (when (= target 0) (panic "SCCP IF projection missing"))
    target))

;;; Case constants are already checked by the enclosing graph verifier.
;;; Signed narrow values use order keys to avoid host sign-extension ambiguity.
(defn in-range? [(value n/Node) (low n/Node) (high n/Node)] (-> bool)
  (let [ty (cast i32 (n/type-id value))
        bias
          (if (types/signed? ty)
              (<< (: 1 u64) (cast u64 (- (* 8 (types/scalar-size ty 8)) 1)))
              (: 0 u64))
        key (^ (n/constant-bits value) bias)]
    (and (>= key (^ (n/constant-bits low) bias))
         (<= key (^ (n/constant-bits high) bias)))))

(defn switch-target [(graph g/Graph)
                     (domain v/Domain)
                     (edges uses/Uses)
                     (reference i32)
                     (selector i32)] (-> i32)
  (let [value (literal graph domain selector)
        range (get (.ranges edges) (cast i64 reference))
        (mut target) (: 0 i32)
        (mut matched) false]
    (for [i (.offset range) (+ (.offset range) (.count range))]
      (let [use (get (.edges edges) i)
            user (.user use)
            node (get (.instructions graph) (cast i64 user))
            opcode (n/opcode node)]
        (when (and (= (.operand use) 1) (not matched))
          (cond (= opcode 111) (set! target user)
                (= opcode 109)
                  (when (= (n/constant-bits value)
                           (n/constant-bits (phi/constant graph (.op2 node))))
                    (set! target user)
                    (set! matched true))
                (= opcode 110)
                  (when (in-range? value
                                   (phi/constant graph (.op2 node))
                                   (phi/constant graph (.op3 node)))
                    (set! target user)
                    (set! matched true))
                :else 0))))
    target))

(defn transfer! [(graph g/Graph)
                 (domain (mut v/Domain))
                 (edges uses/Uses)
                 (iteration (mut q/Queue))
                 (reference i32)] (-> bool)
  (let [node (get (.instructions graph) (cast i64 reference))
        opcode (cast i32 (n/opcode node))]
    (if (op/block-start? opcode)
        (do
          (when (or (= opcode 106) (= opcode 112) (= opcode 113))
            (q/add! (mut iteration) (cast i64 reference)))
          (if (or (= opcode 112) (= opcode 113))
              (region! graph (mut domain) reference)
              (do (v/kind! (mut domain) reference (op/count)) true)))
        (if (not (v/reachable? domain (.op1 node)))
            false
            (if (or (= opcode 116) (= opcode 117))
                (let [selector (.op2 node)]
                  (if (v/top? domain selector)
                      (do (v/add-input! (mut domain) selector) false)
                      (let [(mut target) (: 0 i32)]
                        (when (constant? domain selector)
                          (if (= opcode 116)
                              (match (conditional/truth-value (literal graph
                                                                       domain
                                                                       selector))
                                (None [] 0)
                                (Some [yes]
                                      (set! target
                                            (if-target graph
                                                       edges
                                                       reference
                                                       yes))))
                              (when (symbols/numeric? (literal graph
                                                               domain
                                                               selector))
                                (set! target
                                      (switch-target graph
                                                     domain
                                                     edges
                                                     reference
                                                     selector)))))
                        (if (!= target 0)
                            (select! (mut domain) reference target)
                            (do
                              (v/kind! (mut domain) reference (op/count))
                              (when (= opcode 116)
                                (q/add! (mut iteration) (cast i64 reference)))
                              true)))))
                (let [count (op/input-count opcode)
                      shape (op/shape opcode)
                      dead-load
                        (and (= (get shape 0) #\l)
                             (= (.count (get (.ranges edges)
                                             (cast i64 reference)))
                                1))]
                  (if dead-load
                      (q/add! (mut iteration) (cast i64 reference))
                      (let [n
                              (if (< count 0)
                                  (get (.arities graph) (cast i64 reference))
                                  count)]
                        (when (and (< count 0) (> n 3))
                          (retain-tail! graph (mut domain) reference))
                        (for [index 2 (+ (cast i64 n) 1)]
                          (let [source
                                  (phi/input graph reference (cast i32 index))]
                            (when (and (> source 0) (v/top? domain source))
                              (v/add-input! (mut domain) source))))))
                  (v/kind! (mut domain) reference (op/count))
                  true))))))
