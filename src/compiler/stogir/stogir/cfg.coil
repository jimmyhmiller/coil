;;; Control-chain block membership for the scheduled CFG skeleton.
(module stogir.cfg)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.verify" :as verify)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Edge [(from i32) (to i32) (source i32) (position i32)])

(defstruct Blocks
  [(starts (ArrayList i32))
   (membership (ArrayList i32))
   (edges (ArrayList Edge))])

(defn release! [(blocks (mut Blocks))] (-> void)
  (free! (mut (.starts blocks)))
  (free! (mut (.membership blocks)))
  (free! (mut (.edges blocks))))

;;; Membership is the block-start node reference, zero for floating data.
;;; Block starts stop backward walks, including loop headers.
(defn build [(graph g/Graph) (allocator (dyn Allocator))]
  (-> (Result Blocks (slice u8)))
  (match (verify/control-sources graph)
    (Err [msg] (Err msg))
    (Ok [_]
        (let [(mut result)
                (Blocks
                  :starts (ArrayList::new [i32] allocator)
                  :membership (ArrayList::new [i32] allocator)
                  :edges (ArrayList::new [Edge] allocator))
              (mut path) (ArrayList::new [i32] allocator)
              (mut error) ""
              (mut r) 0]
          (while (< r (len (.instructions graph)))
            (push! (mut (.membership result)) 0)
            (set! r (+ r 1)))
          (set! r 1)
          (while (< r (len (.instructions graph)))
            (let [node (get (.instructions graph) r)
                  count (get (.arities graph) r)]
              (when (op/block-start? (cast i32 (n/opcode node)))
                (push! (mut (.starts result)) (cast i32 r))
                (set! (mut (.membership result)) r (cast i32 r)))
              (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
          (set! r 1)
          (while (and (= error "") (< r (len (.instructions graph))))
            (let [node (get (.instructions graph) r)
                  count (get (.arities graph) r)]
              (when (and (op/control? (cast i32 (n/opcode node)))
                         (= (get (.membership result) r) 0))
                (clear! (mut path))
                (let [(mut current) (cast i32 r)
                      (mut block) (: 0 i32)]
                  (while (and (= error "") (= block 0))
                    (set! block (get (.membership result) (cast i64 current)))
                    (when (= block 0)
                      (if (>= (len path) (len (.instructions graph)))
                          (set! error "control chain cycle without block start")
                          (do
                            (push! (mut path) current)
                            (match (g/operand graph current 1)
                              (None []
                                    (set! error
                                          "control node lacks predecessor"))
                              (Some [source]
                                    (if (or (<= source 0)
                                            (not (g/contains? graph source)))
                                        (set! error
                                              "invalid control predecessor")
                                        (set! current source))))))))
                  (when (= error "")
                    (for member path
                      (set! (mut (.membership result)) (cast i64 member) block)))))
              (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
          (when (= error "")
            (for start (.starts result)
              (let [node (get (.instructions graph) (cast i64 start))
                    count (get (.arities graph) (cast i64 start))
                    (mut i) (: 1 i32)]
                (while (and (= error "") (<= i count))
                  (when (= (op/operand-kind (cast i32 (n/opcode node)) i) "src")
                    (match (g/operand graph start i)
                      (None [] (set! error "missing block predecessor"))
                      (Some [source]
                            (let [from
                                    (get (.membership result) (cast i64 source))]
                              (if (= from 0)
                                  (set! error "block predecessor has no block")
                                  (push! (mut (.edges result))
                                         (Edge
                                           :from from
                                           :to start
                                           :source source
                                           :position i)))))))
                  (set! i (+ i 1))))))
          (free! (mut path))
          (if (= error "")
              (Ok result)
              (do (release! (mut result)) (Err error)))))))
