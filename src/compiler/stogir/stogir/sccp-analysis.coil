;;; Worklist orchestration adapted from pinned ir_sccp.c:ir_sccp_analyze.
;;; Development: remaining fold families and mem2ssa policy are not yet implemented.
(module stogir.sccp-analysis)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.verify" :as verify)
(import "stogir.switch" :as switch)
(import "stogir.sccp-values" :as v)
(import "stogir.sccp-phi" :as phi)
(import "stogir.sccp-control" :as control)
(import "stogir.sccp-fold" :as folding)
(import "stogir.bitqueue" :as q)
(import "stogir.bitset" :as bits)
(import "stogir.uses" :as uses)
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(defstruct Analysis
  [(domain v/Domain)
   (iteration q/Queue)
   (pointer-bytes i32)
   (observed bits/Bits)])

(defn release! [(analysis (mut Analysis))] (-> void)
  (v/release! (mut (.domain analysis)))
  (q/release! (mut (.iteration analysis)))
  (bits/release! (mut (.observed analysis))))

(defn data? [(opcode i32)] (-> bool)
  (!= (& (op/properties opcode) op/FLAG-DATA) 0))

;;; Preconditions: fresh analysis, verified graph and Phi shapes; entry START
;;; is reference one. MEM2SSA immediate-Phi policy is not yet supported.
;;; Edges must describe this exact graph. The caller owns analysis and may inspect
;;; iteration candidates, but no graph rewrite has been applied by this function.
(defn run! [(graph g/Graph) (edges uses/Uses) (analysis (mut Analysis))]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut reference) (: 0 i64)]
    (let [(mut root) (bits/next-set (.observed analysis) 1)]
      (while (>= root 0)
        (when (data? (cast i32 (n/opcode (get (.instructions graph) root))))
          (v/add-input! (mut (.domain analysis)) (cast i32 root)))
        (set! root (bits/next-set (.observed analysis) (+ root 1)))))
    (q/add! (mut (.pending (.domain analysis))) 1)
    (set! reference (q/pop! (mut (.pending (.domain analysis)))))
    (while (and (>= reference 0) (= error ""))
      (let [r (cast i32 reference)
            node (get (.instructions graph) reference)
            opcode (cast i32 (n/opcode node))
            (mut changed) false]
        (when (v/bottom? (.domain analysis) r)
          (panic "bottom SCCP worklist entry {}" r))
        (if (data? opcode)
            (when (or (> (.count (get (.ranges edges) reference)) 0)
                      (bits/contains? (.observed analysis) reference))
              (cond (= opcode 67)
                      (set! changed
                            (phi/transfer! graph
                                           (mut (.domain analysis))
                                           edges
                                           r))
                    (and (>= opcode 14) (<= opcode 68))
                      (match (folding/transfer! graph
                                                (mut (.domain analysis))
                                                edges
                                                (mut (.iteration analysis))
                                                r
                                                (.pointer-bytes analysis))
                        (Err [message] (set! error message))
                        (Ok [result] (set! changed result)))
                    :else
                      (do
                        (v/make-bottom! (mut (.domain analysis)) edges r)
                        (let [count (op/input-count opcode)]
                          (for [index 1 (+ (cast i64 count) 1)]
                            (let [source (phi/input graph r (cast i32 index))]
                              (when (and (> source 0)
                                         (v/top? (.domain analysis) source))
                                (v/add-input! (mut (.domain analysis)) source)))))
                        (set! changed true))))
            (set! changed
                  (control/transfer! graph
                                     (mut (.domain analysis))
                                     edges
                                     (mut (.iteration analysis))
                                     r)))
        (when changed (v/add-uses! (mut (.domain analysis)) edges r)))
      (when (= error "")
        (set! reference (q/pop! (mut (.pending (.domain analysis)))))))
    (if (= error "") (Ok 0) (Err error))))

(defn create [(size i64) (pointer-bytes i32) (a (dyn Allocator))] (-> Analysis)
  (Analysis
    :domain (v/create size a)
    :iteration (q/create size a)
    :pointer-bytes pointer-bytes
    :observed (bits/create size a)))

(defn analyze-rooted [(graph g/Graph)
                      (pointer-bytes i32)
                      (roots (slice i32))
                      (a (dyn Allocator))]
  (-> (Result Analysis (slice u8)))
  (analyze-rooted-proven graph pointer-bytes roots false a))

;;; The checks every SCCP analysis input must pass. proven: graph's content
;;; digest equals a rewrite/Rewritten proof, so it passed rewrite/validate,
;;; which includes every graph check below.
(defn verify-input [(graph g/Graph)
                    (pointer-bytes i32)
                    (proven bool)
                    (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (verify-input-structured graph pointer-bytes proven false a))

;;; As verify-input. structured: the caller has just passed this graph through
;;; verify/structure with no edit since, so that one check is not repeated.
(defn verify-input-structured [(graph g/Graph)
                               (pointer-bytes i32)
                               (proven bool)
                               (structured bool)
                               (a (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (if (not (or (= pointer-bytes 4) (= pointer-bytes 8)))
      (Err "invalid SCCP target pointer width")
      (match (if proven (Ok [i64 (slice u8)] 0) (verify/constants graph pointer-bytes))
        (Err [message] (Err message))
        (Ok [_]
            (match (cond proven (Ok [i32 (slice u8)] 0)
                         structured (verify/operations-and-phis-target-structured graph pointer-bytes)
                         :else (verify/operations-and-phis-target graph pointer-bytes))
              (Err [message] (Err message))
              (Ok [_]
                  (match (if proven (Ok [i32 (slice u8)] 0) (switch/verify graph a))
                    (Err [message] (Err message))
                    (Ok [_]
                        (if (or (<= (len (.instructions graph)) 1)
                                (!= (n/opcode (get (.instructions graph)
                                                   1))
                                    104))
                            (Err "SCCP requires START at reference one")
                            (Ok 0))))))))))

;;; Analysis of a graph that passed verify-input. EDGES is uses/build of this
;;; exact graph; it is only read, so the caller may hand it on to the rewrite.
(defn analyze-verified [(graph g/Graph)
                        (pointer-bytes i32)
                        (roots (slice i32))
                        (edges uses/Uses)
                        (a (dyn Allocator))]
  (-> (Result Analysis (slice u8)))
  (let [(mut result) (create (len (.instructions graph)) pointer-bytes a)
        (mut status) (Ok [i32 (slice u8)] 0)]
    (for root roots
      (let [valid (and (> root 0) (g/contains? graph root))]
        (when valid
          (bits/add! (mut (.observed result)) (cast i64 root)))
        (when (not valid)
          (set! status (Err [i32 (slice u8)] "invalid SCCP observable root")))))
    (match status
      (Err [_] 0)
      (Ok [_] (set! status (run! graph edges (mut result)))))
    (match status
      (Err [message]
           (release! (mut result))
           (Err message))
      (Ok [_] (Ok result)))))

;;; proven: as for verify-input.
(defn analyze-rooted-proven [(graph g/Graph)
                             (pointer-bytes i32)
                             (roots (slice i32))
                             (proven bool)
                             (a (dyn Allocator))]
  (-> (Result Analysis (slice u8)))
  (match (verify-input graph pointer-bytes proven a)
    (Err [message] (Err message))
    (Ok [_]
        (let [(mut edges) (uses/build graph a)
              result (analyze-verified graph pointer-bytes roots edges a)]
          (uses/release! (mut edges))
          result))))

;;; Legacy unrooted analysis uses the graph's control exits and data use lists.
(defn analyze [(graph g/Graph) (pointer-bytes i32) (a (dyn Allocator))]
  (-> (Result Analysis (slice u8)))
  (analyze-rooted graph pointer-bytes [] a))
