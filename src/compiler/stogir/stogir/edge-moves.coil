;;; Physical reconciliation of ordinary live values across CFG edges.
(module stogir.edge-moves)
(import "stogir.allocation" :as allocation)
(import "stogir.locations" :as locations)
(import "stogir.bitset" :as bits)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.schedule" :as schedule)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.hashmap" :use [HashMap])
(import "coil.result" :use [Result Ok Err Some None])

;;; successor-input excludes successor phi definitions; phi copies are additional.
;;; source-position is predecessor exit, destination-position successor entry.
;;; Every result is one simultaneous edge group, identified by position for emission.
(defn ordinary-impl [(parts (ArrayList allocation/Part))
                     (lookup-index locations/Index)
                     (indexed bool)
                     (successor-input bits/Bits)
                     (source-position i64)
                     (destination-position i64)
                     (allocator (dyn Allocator))]
  (-> (Result (ArrayList locations/Transfer) (slice u8)))
  (let [(mut result) (ArrayList::new [locations/Transfer] allocator)
        (mut seen) (HashMap::new-scalar [i32 bool] allocator)
        aliases (and indexed (.coalesced lookup-index))
        (mut value) (bits/next-set successor-input 0)
        (mut error) ""]
    (while (and (= error "") (>= value 0))
      (match (locations/query parts
                              lookup-index
                              indexed
                              (cast i32 value)
                              source-position)
        (Err [msg] (set! error msg))
        (Ok [source]
            (match (locations/query parts
                                    lookup-index
                                    indexed
                                    (cast i32 value)
                                    destination-position)
              (Err [msg] (set! error msg))
              (Ok [destination]
                  (when (not (locations/same? source destination))
                    (let [owner
                            (if aliases
                                (locations/owner parts
                                                 lookup-index
                                                 (cast i32 value))
                                (cast i32 value))
                          duplicate
                            (if aliases
                                (match (get seen owner)
                                  (Some [_] true)
                                  (None [] false))
                                false)]
                      (unless duplicate
                        (push! (mut result)
                               (locations/Transfer
                                 :position source-position
                                 :parent owner
                                 :source source
                                 :destination destination))
                        (when aliases (set! (mut seen) owner true)))))))))
      (set! value (bits/next-set successor-input (+ value 1))))
    (free! (mut seen))
    (if (= error "") (Ok result) (do (free! (mut result)) (Err error)))))

;;; bits/wide retain scalar convenience metadata. The owned constant reference
;;; is authoritative for vector payloads, which do not fit in these fields.
(defstruct Literal
  [(destination locations/Location) (bits u64) (wide bool) (reference i32)])

(defstruct PhiGroup
  [(moves (ArrayList locations/Transfer)) (literals (ArrayList Literal))])

(defn release-phis! [(group (mut PhiGroup))] (-> void)
  (free! (mut (.moves group)))
  (free! (mut (.literals group))))

;;; Build incoming phi copies for one predecessor ordinal. Constants are applied
;;; after resolving ordinary/phi register copies as one simultaneous group.
(defn phis-impl [(graph g/Graph)
                 (scheduled schedule/Schedule)
                 (parts (ArrayList allocation/Part))
                 (lookup-index locations/Index)
                 (indexed bool)
                 (target i32)
                 (predecessor i32)
                 (source-position i64)
                 (allocator (dyn Allocator))]
  (-> (Result PhiGroup (slice u8)))
  (let [(mut result)
          (PhiGroup
            :moves (ArrayList::new [locations/Transfer] allocator)
            :literals (ArrayList::new [Literal] allocator))
        range (get (.ranges scheduled) (cast i64 target))
        (mut i) 0
        (mut error) ""]
    (while (and (= error "") (< i (.count range)))
      (let [index (+ (.offset range) i)
            reference (get (.nodes scheduled) index)
            node (get (.instructions graph) (cast i64 reference))]
        (when (= (n/opcode node) 67)
          (match (locations/query parts
                                  lookup-index
                                  indexed
                                  reference
                                  (* (.offset range) 2))
            (Err [msg] (set! error msg))
            (Ok [destination]
                (match (g/operand graph reference (+ predecessor 1))
                  (None [] (set! error "phi predecessor missing"))
                  (Some [logical-source]
                    (let [constant (if indexed (locations/constant-reference-indexed lookup-index logical-source)
                                      (if (< logical-source 0) logical-source 0))
                          source (if (!= constant 0) constant logical-source)]
                        (if (< source 0)
                            (match (g/lookup graph source)
                              (None [] (set! error "phi constant missing"))
                              (Some [constant]
                                    (push! (mut (.literals result))
                                           (Literal
                                             :destination destination
                                             :reference source
                                             :bits (n/constant-bits constant)
                                             :wide
                                               (or (= (n/type-id node) 6)
                                                   (= (n/type-id node) 5)
                                                   (= (n/type-id node) 11)
                                                   (= (n/type-id node) 12))))))
                            (match (locations/query parts
                                                    lookup-index
                                                    indexed
                                                    source
                                                    source-position)
                              (Err [msg] (set! error msg))
                              (Ok [location]
                                  (when (not (locations/same? location
                                                              destination))
                                    (push! (mut (.moves result))
                                           (locations/Transfer
                                             :position source-position
                                             :parent reference
                                             :source location
                                             :destination destination)))))))))))))
      (set! i (+ i 1)))
    (if (= error "") (Ok result) (do (release-phis! (mut result)) (Err error)))))

;;; Compatibility API for callers without finalized allocation metadata.
(defn ordinary [(parts (ArrayList allocation/Part))
                (successor-input bits/Bits)
                (source-position i64)
                (destination-position i64)
                (allocator (dyn Allocator))]
  (-> (Result (ArrayList locations/Transfer) (slice u8)))
  (let [(mut index) (locations/empty-index allocator)
        result
          (ordinary-impl parts
                         index
                         false
                         successor-input
                         source-position
                         destination-position
                         allocator)]
    (locations/release-index! (mut index))
    result))

(defn phis [(graph g/Graph)
            (scheduled schedule/Schedule)
            (parts (ArrayList allocation/Part))
            (target i32)
            (predecessor i32)
            (source-position i64)
            (allocator (dyn Allocator))]
  (-> (Result PhiGroup (slice u8)))
  (let [(mut index) (locations/empty-index allocator)
        result
          (phis-impl graph
                     scheduled
                     parts
                     index
                     false
                     target
                     predecessor
                     source-position
                     allocator)]
    (locations/release-index! (mut index))
    result))

;;; Finalized backend API: index and parts are immutable for this phase.
(defn ordinary-indexed [(parts (ArrayList allocation/Part))
                        (index locations/Index)
                        (successor-input bits/Bits)
                        (source-position i64)
                        (destination-position i64)
                        (allocator (dyn Allocator))]
  (-> (Result (ArrayList locations/Transfer) (slice u8)))
  (ordinary-impl parts
                 index
                 true
                 successor-input
                 source-position
                 destination-position
                 allocator))

(defn phis-indexed [(graph g/Graph)
                    (scheduled schedule/Schedule)
                    (parts (ArrayList allocation/Part))
                    (index locations/Index)
                    (target i32)
                    (predecessor i32)
                    (source-position i64)
                    (allocator (dyn Allocator))]
  (-> (Result PhiGroup (slice u8)))
  (phis-impl graph
             scheduled
             parts
             index
             true
             target
             predecessor
             source-position
             allocator))
