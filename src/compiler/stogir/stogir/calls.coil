; Ported/adapted from dstogov/ir (ir.h, ir.c and ir_builder.h), commit 92171d0. See NOTICE.
;;; Upstream-shaped call prototypes and checked control-pinned CALL construction.
(module stogir.calls)
(import "stogir.graph" :as g)
(import "stogir.strings" :as strings)
(import "stogir.builder" :as builder)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.prototype-bytes" :as prototype-bytes)
(import "stogir.call-groups" :as groups)
(import "stogir.call-results" :as results)
(import "stogir.terminal" :as terminal)
(import "stogir.uses" :as uses)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Prototype
  [(flags u8)
   (result u8)
   (parameters (ArrayList u8))
   (groups (ArrayList groups/Group))
   (aggregate-result results/Spec)
   (builtin u8)])

(defn create [(flags u8)
              (result u8)
              (parameters (slice u8))
              (allocator (dyn Allocator))]
  (-> (Result Prototype (slice u8)))
  (let [(mut valid?)
          (and (types/valid? (cast i32 result))
               (<= (len parameters) 255))]
    (let [items-1 parameters (mut for-index-1) (: 0 i64)] (while (< for-index-1 (len items-1)) (let [ty (get items-1 for-index-1)]
      (when (or (= ty 0) (not (types/valid? (cast i32 ty))))
        (set! valid? false))) (set! for-index-1 (+ for-index-1 1))))
    (if (not valid?)
        (Err "invalid call prototype")
        (let [(mut owned) (ArrayList::new [u8] allocator)]
          (let [items-2 parameters (mut for-index-2) (: 0 i64)] (while (< for-index-2 (len items-2)) (let [ty (get items-2 for-index-2)] (push! (mut owned) ty)) (set! for-index-2 (+ for-index-2 1))))
          (Ok (Prototype
                :flags flags
                :result result
                :parameters owned
                :groups (ArrayList::new [groups/Group] allocator)
                :aggregate-result (results/ordinary)
                :builtin 0))))))

;;; The runtime memmove declared as BUILTIN-MOVE, so memory optimization may
;;; reason about exactly what it reads and writes. The caller guarantees that
;;; the callee it emits with this prototype has memmove's semantics.
(defn create-builtin-move [(flags u8) (allocator (dyn Allocator))]
  (-> (Result Prototype (slice u8)))
  (if (!= (& flags 16) 0)
      (Err "builtin move cannot be variadic")
      (match (create flags 6 [(: 6 u8) 6 5] allocator)
        (Err [message] (Err message))
        (Ok [prototype]
            (let [(mut prototype) prototype]
              (set! (.builtin prototype) groups/BUILTIN-MOVE)
              (Ok prototype))))))

;;; The runtime memcmp declared as BUILTIN-COMPARE. RESULT is I32 or U32, or a
;;; U64 or I64 word container of it, and COUNT-TYPE is U64 or I64. The caller guarantees that the callee it emits
;;; with this prototype has memcmp's semantics.
(defn create-builtin-compare [(flags u8) (result u8) (count-type u8)
                              (allocator (dyn Allocator))]
  (-> (Result Prototype (slice u8)))
  (if (or (!= (& flags 16) 0)
          (not (groups/builtin-shape? groups/BUILTIN-COMPARE result [(: 6 u8) 6 count-type])))
      (Err "invalid builtin compare prototype")
      (match (create flags result [(: 6 u8) 6 count-type] allocator)
        (Err [message] (Err message))
        (Ok [prototype]
            (let [(mut prototype) prototype]
              (set! (.builtin prototype) groups/BUILTIN-COMPARE)
              (Ok prototype))))))

;;; Builtin id declared by the prototype of CALL reference, or zero.
(defn builtin-of [(graph g/Graph) (reference i32)] (-> u8)
  (let [node (get (.instructions graph) (cast i64 reference))]
    (match (signature graph (.op2 node) (n/type-id node) 3)
      (Err [_] 0)
      (Ok [found]
        (if (= (.id found) 0)
            0
            (match (strings/lookup (.strings graph) (.id found))
              (None [] 0)
              (Some [bytes] (groups/builtin bytes))))))))

(defn create-grouped [(flags u8)
                      (result u8)
                      (parameters (slice u8))
                      (descriptors (slice groups/Group))
                      (allocator (dyn Allocator))]
  (-> (Result Prototype (slice u8)))
  (let [(mut valid?) (groups/valid? parameters descriptors)]
    (let [items-3 descriptors (mut for-index-3) (: 0 i64)] (while (< for-index-3 (len items-3)) (let [group (get items-3 for-index-3)]
      (when (and valid?
                 (= (& flags 16) 0)
                 (> (cast i64 (+ (.first group) (.count group)))
                    (len parameters)))
        (set! valid? false))) (set! for-index-3 (+ for-index-3 1))))
    (if (not valid?)
        (Err "invalid call argument groups")
        (match (create flags result parameters allocator)
          (Err [message] (Err message))
          (Ok [prototype]
              (let [(mut prototype) prototype]
                (let [items-4 descriptors (mut for-index-4) (: 0 i64)] (while (< for-index-4 (len items-4)) (let [group (get items-4 for-index-4)] (push! (mut (.groups prototype)) group)) (set! for-index-4 (+ for-index-4 1))))
                (Ok prototype)))))))

(defn create-result [(flags u8)
                     (parameters (slice u8))
                     (descriptors (slice groups/Group))
                     (result results/Spec)
                     (allocator (dyn Allocator))]
  (-> (Result Prototype (slice u8)))
  (if (or (= (.kind result) 0) (not (results/valid? 0 parameters result)))
      (Err "invalid aggregate result prototype")
      (match (create-grouped flags 0 parameters descriptors allocator)
        (Err [message] (Err message))
        (Ok [prototype]
            (let [(mut prototype) prototype]
              (set! (.aggregate-result prototype) result)
              (Ok prototype))))))

(defn valid-prototype? [(prototype Prototype) (function? bool)] (-> bool)
  (let [(mut good?)
          (and (<= (len (.parameters prototype)) 255)
               (or (= (.builtin prototype) 0)
                   (and (not function?)
                        (= (len (.groups prototype)) 0)
                        (= (.kind (.aggregate-result prototype)) 0)
                        (= (& (.flags prototype) 16) 0)
                        (groups/builtin-shape? (.builtin prototype)
                                               (.result prototype)
                                               (slice (.parameters prototype)))))
               (types/valid? (cast i32 (.result prototype)))
               (results/valid? (.result prototype)
                               (slice (.parameters prototype))
                               (.aggregate-result prototype))
               (groups/valid? (slice (.parameters prototype))
                              (slice (.groups prototype))))]
    (let [items-5 (.parameters prototype) (mut for-index-5) (: 0 i64)] (while (< for-index-5 (len items-5)) (let [ty (get items-5 for-index-5)]
      (when (or (= ty 0) (not (types/valid? (cast i32 ty))))
        (set! good? false))) (set! for-index-5 (+ for-index-5 1))))
    (let [items-104 (.groups prototype) (mut for-index-104) (: 0 i64)] (while (< for-index-104 (len items-104)) (let [group (get items-104 for-index-104)]
      (when (and good?
                 (or function? (= (& (.flags prototype) 16) 0))
                 (> (cast i64 (+ (.first group) (.count group)))
                    (len (.parameters prototype))))
        (set! good? false))) (set! for-index-104 (+ for-index-104 1))))
    good?))

;;; Serialized prototype prefix matches upstream flags/return/count/type bytes.
(defn encode [(prototype Prototype) (allocator (dyn Allocator))]
  (-> (ArrayList u8))
  (let [(mut bytes) (ArrayList::new [u8] allocator)]
    (push! (mut bytes) (.flags prototype))
    (push! (mut bytes) (.result prototype))
    (push! (mut bytes) (cast u8 (len (.parameters prototype))))
    (let [items-6 (.parameters prototype) (mut for-index-6) (: 0 i64)] (while (< for-index-6 (len items-6)) (let [ty (get items-6 for-index-6)] (push! (mut bytes) ty)) (set! for-index-6 (+ for-index-6 1))))
    (if (!= (.builtin prototype) 0)
        (groups/append-builtin! (mut bytes) (.builtin prototype))
        (groups/append-result! (mut bytes)
                               (slice (.groups prototype))
                               (.aggregate-result prototype)))
    bytes))

(defn group-arguments? [(graph g/Graph)
                        (arguments (slice i32))
                        (group groups/Group)] (-> bool)
  (if (or (not (groups/shape? group))
          (> (cast i64 (+ (.first group) (.count group))) (len arguments)))
      false
      (let [(mut good?) true
            (mut ty) (: 0 u8)
            (mut i) (: 0 i32)]
        (while (and good? (< i (.count group)))
          (match (g/lookup graph
                           (get arguments (cast i64 (+ (.first group) i))))
            (None [] (set! good? false))
            (Some [node]
                  (when (= i 0) (set! ty (n/type-id node)))
                  (when (or (!= ty (n/type-id node))
                            (not (groups/members? group ty)))
                    (set! good? false))))
          (set! i (+ i 1)))
        good?)))

(defn emit-kind! [(graph (mut g/Graph))
                  (opcode u8)
                  (prototype Prototype)
                  (control i32)
                  (callee i32)
                  (arguments (slice i32))
                  (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        count (len (.parameters prototype))
        varargs? (!= (& (.flags prototype) 16) 0)
        (mut i) 0
        (mut inputs) (ArrayList::new [i32] allocator)]
    (when (not (or (= opcode 79) (= opcode 80)))
      (set! error "invalid call opcode"))
    (when (or (< (len arguments) count)
              (and (not varargs?) (!= (len arguments) count))
              (> (len arguments) 65533))
      (set! error "call argument count mismatch"))
    (match (g/lookup graph control)
      (None [] (set! error "call control missing"))
      (Some [node]
            (when (or (<= control 0)
                      (not (op/control? (cast i32 (n/opcode node)))))
              (set! error "call requires control predecessor"))))
    (match (g/lookup graph callee)
      (None [] (set! error "callee missing"))
      (Some [node]
            (when (!= (n/type-id node) 6) (set! error "callee must be ADDR"))))
    (push! (mut inputs) control)
    (push! (mut inputs) callee)
    (let [items-103 arguments (mut for-index-103) (: 0 i64)] (while (< for-index-103 (len items-103)) (let [argument (get items-103 for-index-103)]
      (match (g/lookup graph argument)
        (None [] (set! error "call argument missing"))
        (Some [node]
              (when (or (= (n/type-id node) 0)
                        (and (< i count)
                             (!= (n/type-id node)
                                 (get (.parameters prototype) i))))
                (set! error "call argument type mismatch"))))
      (push! (mut inputs) argument)
      (set! i (+ i 1))) (set! for-index-103 (+ for-index-103 1))))
    (when (and (= error "") (!= (.kind (.aggregate-result prototype)) 0))
      (if (= (len arguments) 0)
          (set! error "aggregate result place missing")
          (match (g/lookup graph (get arguments 0))
            (None [] (set! error "aggregate result place missing"))
            (Some [place]
                  (when (or (!= (n/type-id place) 6)
                            (= (n/opcode place) 72)
                            (= (n/opcode place) 70))
                    (set! error "aggregate result place requires an ADDR value"))))))
    (let [items-102 (.groups prototype) (mut for-index-102) (: 0 i64)] (while (< for-index-102 (len items-102)) (let [group (get items-102 for-index-102)]
      (when (and (= error "") (not (group-arguments? graph arguments group)))
        (set! error "call group member type or count mismatch"))) (set! for-index-102 (+ for-index-102 1))))
    (let [result
            (if (!= error "")
                (Err [i32 (slice u8)] error)
                (match (attach! (mut graph) prototype callee allocator)
                  (Err [msg] (Err [i32 (slice u8)] msg))
                  (Ok [annotated]
                      (do
                        (set! (mut inputs) 1 annotated)
                        (match (g/append-inputs! (mut graph)
                                                 opcode
                                                 (.result prototype)
                                                 (slice inputs))
                          (None []
                                (Err [i32 (slice u8)]
                                     "call reference space exhausted"))
                          (Some [reference] (Ok reference)))))))]
      (free! (mut inputs))
      result)))

;;; Ordinary calls retain their existing construction and capture semantics.
(defn emit! [(graph (mut g/Graph))
             (prototype Prototype)
             (control i32)
             (callee i32)
             (arguments (slice i32))
             (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (emit-kind! (mut graph) 79 prototype control callee arguments allocator))

;;; A tail call returns directly according to the caller's declared result ABI.
;;; Aggregate result places must forward the original function PARAM0. A local
;;; result buffer would return the wrong indirect object after frame teardown.
(defn tail-result-compatible [(graph g/Graph)
                              (flags u8)
                              (result u8)
                              (spec results/Spec)
                              (place i32)]
  (-> (Result i32 (slice u8)))
  (match (strings/lookup (.strings graph) (.function-prototype graph))
    (None [] (Err "TAILCALL requires a declared function prototype"))
    (Some [bytes]
          (if (not (valid-bytes? bytes))
              (Err "TAILCALL function prototype is malformed")
              (let [own (results/decode bytes)]
                (if (or (!= (& flags (: 15 u8)) (& (get bytes 0) (: 15 u8)))
                        (!= result (get bytes 1))
                        (!= (.kind spec) (.kind own))
                        (!= (.ty spec) (.ty own))
                        (!= (.count spec) (.count own)))
                    (Err "TAILCALL result or calling convention does not match function")
                    (if (= (.kind spec) 0)
                        (Ok 0)
                        (match (g/lookup graph place)
                          (None []
                                (Err "TAILCALL aggregate result place missing"))
                          (Some [parameter]
                                (if (and (> place 0)
                                         (= (n/opcode parameter) 71)
                                         (= (n/type-id parameter) 6)
                                         (= (.op3 parameter) 0))
                                    (Ok 0)
                                    (Err "TAILCALL must forward function result PARAM0")))))))))))

;;; Follow pinned ir.c:_ir_TAILCALL_N: typed TAILCALL followed by UNREACHABLE.
;;; The returned reference is the terminal root, not a usable call result.
(defn emit-tail! [(graph (mut g/Graph))
                  (prototype Prototype)
                  (control i32)
                  (callee i32)
                  (arguments (slice i32))
                  (previous i32)
                  (allocator (dyn Allocator))]
  (-> (Result i32 (slice u8)))
  (match (tail-result-compatible graph
                                 (.flags prototype)
                                 (.result prototype)
                                 (.aggregate-result prototype)
                                 (if (> (len arguments) 0) (get arguments 0) 0))
    (Err [message] (Err message))
    (Ok [_]
        (match (terminal/inputs graph 121 control previous)
          (Err [message] (Err message))
          (Ok [_]
              (match (emit-kind! (mut graph)
                                 80
                                 prototype
                                 control
                                 callee
                                 arguments
                                 allocator)
                (Err [message] (Err message))
                (Ok [call] (builder/unreachable! (mut graph) call previous))))))))

(defn release! [(prototype (mut Prototype))] (-> void)
  (free! (mut (.parameters prototype)))
  (free! (mut (.groups prototype))))

;;; Check serialized scalar prototype bytes before exposing any indexed field.
(defn valid-bytes? [(bytes (slice u8))] (-> bool)
  (prototype-bytes/valid-bytes? bytes))

;;; Function signature belongs to the graph/context, independent of live PARAMs.
(defn function! [(graph (mut g/Graph))
                 (prototype Prototype)
                 (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (let [(mut bytes) (encode prototype allocator)
        result
          (if (or (not (valid-prototype? prototype true))
                  (not (valid-bytes? (slice bytes))))
              (Err [i32 (slice u8)] "invalid function prototype")
              (if (!= (.function-prototype graph) 0)
                  (match (strings/lookup (.strings graph)
                                         (.function-prototype graph))
                    (None []
                          (Err [i32 (slice u8)]
                               "function prototype string missing"))
                    (Some [existing]
                          (if (= existing (slice bytes))
                              (Ok (.function-prototype graph))
                              (Err [i32 (slice u8)]
                                   "conflicting function prototype"))))
                  (match (strings/intern! (mut (.strings graph)) (slice bytes))
                    (None []
                          (Err [i32 (slice u8)]
                               "prototype string space exhausted"))
                    (Some [id]
                          (do (set! (.function-prototype graph) id) (Ok id))))))]
    (free! (mut bytes))
    result))

;;; Upstream PROTO is a pure address identity carrying an interned binary-string
;;; ID in its second (metadata) operand. Equal annotations share an expression.
(defn attach! [(graph (mut g/Graph))
               (prototype Prototype)
               (callee i32)
               (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (match (g/lookup graph callee)
    (None [] (Err "callee missing"))
    (Some [node]
          (if (!= (n/type-id node) 6)
              (Err "callee must be ADDR")
              (let [(mut bytes) (encode prototype allocator)
                    result
                      (if (or (not (valid-prototype? prototype false))
                              (not (valid-bytes? (slice bytes))))
                          (Err [i32 (slice u8)] "invalid call prototype")
                          (match (strings/intern! (mut (.strings graph))
                                                  (slice bytes))
                            (None []
                                  (Err [i32 (slice u8)]
                                       "prototype string space exhausted"))
                            (Some [id]
                                  (attach-id! (mut graph) callee node id))))]
                (free! (mut bytes))
                result)))))

;;; FUNC/FUNC_ADDR retain the upstream 16-bit prototype in their header.
;;; Other addresses use a CSE'd PROTO identity instruction.
(defn attach-id! [(graph (mut g/Graph)) (callee i32) (node n/Node) (id i32)]
  (-> (Result i32 (slice u8)))
  (if (and (< callee 0) (or (= (n/opcode node) 73) (= (n/opcode node) 74)))
      (if (>= id 65535)
          (Err "function constant prototype space exhausted")
          (match (g/intern-constant! (mut graph)
                                     (n/opcode node)
                                     6
                                     (cast u16 id)
                                     (n/constant-bits node))
            (None [] (Err "constant reference space exhausted"))
            (Some [reference] (Ok reference))))
      (let [key
              (| (: 40 u128)
                 (<< (: 6 u128) 8)
                 (<< (cast u128 (cast u32 callee)) 16)
                 (<< (cast u128 (cast u32 id)) 48))]
        (match (get (.expressions graph) key)
          (Some [reference] (Ok reference))
          (None []
                (match (builder/emit! (mut graph) 40 6 [callee id])
                  (Err [msg] (Err msg))
                  (Ok [reference]
                      (do
                        (set! (mut (.expressions graph)) key reference)
                        (Ok reference)))))))))

(defstruct Signature [(flags u8) (result u8) (count i32) (id i32)])

;;; Raw unannotated callees keep upstream's default fixed-argument convention.
;;; An attached prototype is retained even when target lowering rejects its ABI.
(defn signature [(graph g/Graph) (callee i32) (result u8) (count i32)]
  (-> (Result Signature (slice u8)))
  (match (g/lookup graph callee)
    (None [] (Err "callee missing"))
    (Some [node]
          (if (!= (n/type-id node) 6)
              (Err "callee must be ADDR")
              (let [id
                      (if (= (n/opcode node) 40)
                          (.op2 node)
                          (if (and (< callee 0)
                                   (or (= (n/opcode node) 73)
                                       (= (n/opcode node) 74)))
                              (cast i32 (n/auxiliary node))
                              0))]
                (if (and (!= (n/opcode node) 40) (= id 0))
                    (Ok (Signature
                          :flags 0
                          :result result
                          :count count
                          :id 0))
                    (match (strings/lookup (.strings graph) id)
                      (None [] (Err "prototype string missing"))
                      (Some [bytes]
                            (if (not (valid-bytes? bytes))
                                (Err "malformed scalar call prototype")
                                (Ok (Signature
                                      :flags (get bytes 0)
                                      :result (get bytes 1)
                                      :count (cast i32 (get bytes 2))
                                      :id id)))))))))))

(defn validate-groups [(graph g/Graph) (reference i32) (bytes (slice u8))]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut i) (: 0 i64)
        actual (- (get (.arities graph) (cast i64 reference)) 2)]
    (when (!= (.kind (results/decode bytes)) 0)
      (match (g/operand graph reference 3)
        (None [] (set! error "aggregate result place missing"))
        (Some [value]
              (match (g/lookup graph value)
                (None [] (set! error "aggregate result place missing"))
                (Some [node]
                      (when (or (!= (n/type-id node) 6)
                                (= (n/opcode node) 72)
                                (= (n/opcode node) 70))
                        (set! error
                              "aggregate result place requires an ADDR value")))))))
    (while (and (= error "") (< i (groups/count bytes)))
      (let [group (groups/at bytes i)
            (mut j) (: 0 i32)
            (mut ty) (: 0 u8)]
        (if (> (+ (.first group) (.count group)) actual)
            (set! error "call argument group exceeds actual arguments")
            (while (and (= error "") (< j (.count group)))
              (match (g/operand graph reference (+ 3 (.first group) j))
                (None [] (set! error "call group member missing"))
                (Some [value]
                      (match (g/lookup graph value)
                        (None [] (set! error "call group member missing"))
                        (Some [node]
                              (when (= j 0) (set! ty (n/type-id node)))
                              (when (or (!= ty (n/type-id node))
                                        (not (groups/members? group ty)))
                                (set! error "call group member type mismatch"))))))
              (set! j (+ j 1)))))
      (set! i (+ i 1)))
    (if (= error "") (Ok (cast i32 (groups/count bytes))) (Err error))))

;;; Semantic validation also protects raw graphs and graphs changed after build.
(defn validate-call [(graph g/Graph) (reference i32)]
  (-> (Result Signature (slice u8)))
  (if (<= reference 0)
      (Err "call reference must be an instruction")
      (match (g/lookup graph reference)
        (None [] (Err "call missing"))
        (Some [node]
              (let [count (get (.arities graph) (cast i64 reference))]
                (if (or (not (or (= (n/opcode node) 79) (= (n/opcode node) 80))) (< count 2))
                    (Err "invalid CALL node")
                    (match (signature graph
                                      (.op2 node)
                                      (n/type-id node)
                                      (- count 2))
                      (Err [msg] (Err msg))
                      (Ok [sig]
                          (let [(mut error) ""
                                (mut j) (: 3 i32)
                                varargs? (!= (& (.flags sig) 16) 0)]
                            (when (or (!= (n/type-id node) (.result sig))
                                      (< (- count 2) (.count sig))
                                      (and (not varargs?)
                                           (!= (- count 2) (.count sig))))
                              (set! error
                                    "call prototype result or argument count mismatch"))
                            (match (g/lookup graph (.op1 node))
                              (None [] (set! error "call control missing"))
                              (Some [control]
                                    (when (or (<= (.op1 node) 0)
                                              (not (op/control? (cast i32
                                                                      (n/opcode control)))))
                                      (set! error
                                            "call requires control predecessor"))))
                            (while (and (= error "") (<= j count))
                              (match (g/operand graph reference j)
                                (None [] (set! error "call argument missing"))
                                (Some [argument]
                                      (match (g/lookup graph argument)
                                        (None []
                                              (set! error
                                                    "call argument missing"))
                                        (Some [value]
                                              (when (or (= (n/type-id value) 0)
                                                        (not (types/valid? (cast i32
                                                                                 (n/type-id value)))))
                                                (set! error
                                                      "invalid call argument type"))
                                              (when (and (> (.id sig) 0)
                                                         (< (- j 3)
                                                            (.count sig)))
                                                (match (strings/lookup (.strings graph)
                                                                       (.id sig))
                                                  (None []
                                                        (set! error
                                                              "prototype string missing"))
                                                  (Some [bytes]
                                                        (when (!= (get bytes
                                                                       (cast i64
                                                                             j))
                                                                  (n/type-id value))
                                                          (set! error
                                                                "call prototype argument type mismatch")))))))))
                              (set! j (+ j 1)))
                            (when (and (= error "") (> (.id sig) 0))
                              (match (strings/lookup (.strings graph) (.id sig))
                                (None []
                                      (set! error "prototype string missing"))
                                (Some [bytes]
                                      (match (validate-groups graph
                                                              reference
                                                              bytes)
                                        (Err [message] (set! error message))
                                        (Ok [_] 0)))))
                            (when (and (= error "") (= (n/opcode node) 80))
                              (match (strings/lookup (.strings graph) (.id sig))
                                (None [] (set! error "TAILCALL requires a declared callee prototype"))
                                (Some [bytes]
                                  (match (tail-result-compatible graph (.flags sig) (.result sig)
                                           (results/decode bytes)
                                           (if (> count 2)
                                               (match (g/operand graph reference 3)
                                                 (Some [value] value) (None [] 0)) 0))
                                    (Err [message] (set! error message))
                                    (Ok [_] 0)))))
                            (if (= error "") (Ok sig) (Err error)))))))))))

;;; Requires structural verification, including string and instruction bounds.
(defn verify [(graph g/Graph)] (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut r) 1
        (mut checked) (: 0 i32)
        (mut tails) (ArrayList::new [i32] (.alc (.instructions graph)))]
    (while (and (= error "") (< r (len (.instructions graph))))
      (let [node (get (.instructions graph) r)
            count (get (.arities graph) r)]
        (when (= (n/opcode node) 40)
          (when (!= (n/type-id node) 6)
            (set! error "PROTO must have ADDR type"))
          (match (g/lookup graph (.op1 node))
            (None [] (set! error "PROTO address missing"))
            (Some [value]
                  (when (!= (n/type-id value) 6)
                    (set! error "PROTO requires ADDR input"))))
          (match (signature graph (cast i32 r) 0 0)
            (Err [msg] (set! error msg))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (or (= (n/opcode node) 79) (= (n/opcode node) 80))
          (match (validate-call graph (cast i32 r))
            (Err [msg] (set! error msg))
            (Ok [_] (set! checked (+ checked 1)))))
        (when (= (n/opcode node) 80) (push! (mut tails) (cast i32 r)))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    (when (and (= error "") (> (len tails) 0))
      (let [(mut edges) (uses/build graph (.alc (.instructions graph)))]
        (let [items-101 tails (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [reference (get items-101 for-index-101)]
          (let [range (get (.ranges edges) (cast i64 reference))]
            (if (!= (.count range) 1)
                (set! error "TAILCALL must have only its UNREACHABLE successor")
                (let [edge (get (.edges edges) (.offset range))
                      user (get (.instructions graph) (cast i64 (.user edge)))]
                  (unless (and (= (.operand edge) 1) (= (n/opcode user) 121))
                    (set! error "TAILCALL must have only its UNREACHABLE successor")))))) (set! for-index-101 (+ for-index-101 1))))
        (uses/release! (mut edges))))
    (free! (mut tails))
    (if (= error "") (Ok checked) (Err error))))

(defn function-result [(graph g/Graph)] (-> (Result results/Spec (slice u8)))
  (if (= (.function-prototype graph) 0)
      (Ok (results/ordinary))
      (match (strings/lookup (.strings graph) (.function-prototype graph))
        (None [] (Err "function prototype string missing"))
        (Some [bytes]
              (if (not (valid-bytes? bytes))
                  (Err "malformed function prototype")
                  (Ok (results/decode bytes)))))))
