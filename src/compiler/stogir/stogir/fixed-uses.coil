;;; Position-indexed immutable fixed-use events with mutable split ownership.
;;; Complements the linear-scan interval policy in pinned ir_ra.c. See NOTICE.
(module stogir.fixed-uses)
(import "coil.arraylist" :use [ArrayList])
(import "stogir.fill" :as fill)
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(defstruct Event [(position i64) (register i32) (owner i32)])

(defstruct Fork [(part i32) (left i32) (right i32) (position i64)])

(defstruct Index
  [(events (ArrayList Event))
   (starts (ArrayList i64))
   (roots (ArrayList i32))
   (nodes (ArrayList Fork))
   (leaves (ArrayList i32))])

(defn before? [(x Event) (y Event)] (-> bool)
  (or (< (.register x) (.register y))
      (and (= (.register x) (.register y))
           (or (< (.position x) (.position y))
               (and (= (.position x) (.position y)) (< (.owner x) (.owner y)))))))

;;; Order within one register bucket.
(defn position-before? [(x Event) (y Event)] (-> bool)
  (or (< (.position x) (.position y))
      (and (= (.position x) (.position y)) (< (.owner x) (.owner y)))))

;;; Merge the sorted runs source[lo,middle) and source[middle,hi) into target.
(defn merge-runs! [(source (ArrayList Event))
                   (target (mut (ArrayList Event)))
                   (lo i64) (middle i64) (hi i64)] (-> void)
  (let [(mut i) lo
        (mut j) middle
        (mut k) lo]
    (while (< k hi)
      (if (and (< j hi)
               (or (>= i middle)
                   (position-before? (get source j) (get source i))))
          (do (set! (mut target) k (get source j)) (set! j (+ j 1)))
          (do (set! (mut target) k (get source i)) (set! i (+ i 1))))
      (set! k (+ k 1)))))

;;; Sort into before? order: registers by counting, then each register's
;;; events by a bottom-up merge sort. The order is total over distinct events,
;;; so the result is the unique sorted sequence. Registers must lie in [0,64).
(defn sort! [(events (mut (ArrayList Event))) (a (dyn Allocator))] (-> void)
  (let [count (len events)]
    (when (> count 1)
      (let [(mut starts) (ArrayList::new [i64] a)
            (mut work) (ArrayList::new [Event] a)
            (mut other) (ArrayList::new [Event] a)]
        (fill/append! (mut starts) 65 0)
        (for [i 0 count]
          (let [reg (.register (get events i))]
            (when (or (< reg 0) (>= reg 64))
              (panic "fixed-use event register outside the sort domain"))
            (set! (mut starts) (+ (cast i64 reg) 1) (+ (get starts (+ (cast i64 reg) 1)) 1))))
        (for [reg 0 64]
          (set! (mut starts) (+ reg 1) (+ (get starts (+ reg 1)) (get starts reg))))
        (extend-zeroed! (mut work) count)
        (extend-zeroed! (mut other) count)
        ; Scatter stably, using other as the per-register write cursors' home.
        (let [(mut cursor) (ArrayList::new [i64] a)]
          (for [reg 0 64] (push! (mut cursor) (get starts reg)))
          (for [i 0 count]
            (let [event (get events i)
                  reg (cast i64 (.register event))
                  at (get cursor reg)]
              (set! (mut work) at event)
              (set! (mut cursor) reg (+ at 1))))
          (free! (mut cursor)))
        (for [reg 0 64]
          (let [lo (get starts reg)
                hi (get starts (+ reg 1))]
            (when (> (- hi lo) 1)
              ; Insertion-sort runs of 16, then merge, alternating buffers.
              (let [(mut run) lo]
                (while (< run hi)
                  (let [stop (if (< (+ run 16) hi) (+ run 16) hi)]
                    (for [i (+ run 1) stop]
                      (let [value (get work i)
                            (mut j) i]
                        (while (and (> j run) (position-before? value (get work (- j 1))))
                          (set! (mut work) j (get work (- j 1)))
                          (set! j (- j 1)))
                        (set! (mut work) j value)))
                    (set! run stop))))
              (let [(mut width) (: 16 i64)
                    (mut in-work) true]
                (while (< width (- hi lo))
                  (let [(mut left) lo]
                    (while (< left hi)
                      (let [middle (if (< (+ left width) hi) (+ left width) hi)
                            right (if (< (+ left (* width 2)) hi) (+ left (* width 2)) hi)]
                        (if in-work
                            (merge-runs! work (mut other) left middle right)
                            (merge-runs! other (mut work) left middle right))
                        (set! left right))))
                  (set! in-work (not in-work))
                  (set! width (* width 2)))
                (unless in-work
                  (for [i lo hi] (set! (mut work) i (get other i))))))))
        (for [i 0 count] (set! (mut events) i (get work i)))
        (free! (mut starts))
        (free! (mut work))
        (free! (mut other))))))

(defn empty [(a (dyn Allocator))] (-> Index)
  (Index
    :events (ArrayList::new [Event] a)
    :starts (ArrayList::new [i64] a)
    :roots (ArrayList::new [i32] a)
    :nodes (ArrayList::new [Fork] a)
    :leaves (ArrayList::new [i32] a)))

(defn release! [(index (mut Index))] (-> void)
  (free! (mut (.events index)))
  (free! (mut (.starts index)))
  (free! (mut (.roots index)))
  (free! (mut (.nodes index)))
  (free! (mut (.leaves index))))

;;; Build after all initial reservations are present. Later mutations may only
;;; partition existing uses; notify each split before querying its children.
(defn create [(parts i64)
              (registers i32)
              (events (slice Event))
              (a (dyn Allocator))]
  (-> (Result Index (slice u8)))
  (let [(mut index)
          (Index
            :events (ArrayList::new [Event] a)
            :starts (ArrayList::new [i64] a)
            :roots (ArrayList::new [i32] a)
            :nodes (ArrayList::new [Fork] a)
            :leaves (ArrayList::new [i32] a))
        (mut error) ""]
    (when (or (< parts 0)
              (> parts 2147483647)
              (<= registers 0)
              (> registers 64))
      (set! error "invalid fixed-use index domain"))
    (let [items-1 events (mut for-index-1) (: 0 i64)] (while (< for-index-1 (len items-1)) (let [event (get items-1 for-index-1)]
      (when (or (< (.position event) 0)
                (< (.register event) 0)
                (>= (.register event) registers)
                (< (.owner event) 0)
                (>= (cast i64 (.owner event)) parts))
        (set! error "invalid fixed-use event"))) (set! for-index-1 (+ for-index-1 1))))
    (if (!= error "")
        (do (release! (mut index)) (Err error))
        (do
          (reserve! (mut (.events index)) (len events))
          (reserve! (mut (.roots index)) (len events))
          (reserve! (mut (.nodes index)) parts)
          (reserve! (mut (.leaves index)) parts)
          (reserve! (mut (.starts index)) (+ (cast i64 registers) 1))
          (let [items-2 events (mut for-index-2) (: 0 i64)] (while (< for-index-2 (len items-2)) (let [event (get items-2 for-index-2)] (push! (mut (.events index)) event)) (set! for-index-2 (+ for-index-2 1))))
          (sort! (mut (.events index)) a)
          (for [part 0 parts]
            (push! (mut (.nodes index))
                   (Fork
                     :part (cast i32 part)
                     :left -1
                     :right -1
                     :position 0))
            (push! (mut (.leaves index)) (cast i32 part)))
          (for event (.events index)
            (push! (mut (.roots index)) (.owner event)))
          (let [(mut cursor) 0]
            (for [reg 0 (+ (cast i64 registers) 1)]
              (while (and (< cursor (len (.events index)))
                          (< (cast i64 (.register (get (.events index) cursor)))
                             reg))
                (set! cursor (+ cursor 1)))
              (push! (mut (.starts index)) cursor)))
          (Ok index)))))

;;; A split is a persistent fork, not a guess based on live-range coverage:
;;; the generic allocator also permits fixed uses outside an interval's ranges.
(defn split! [(index (mut Index)) (part i32) (child i32) (position i64)]
  (-> bool)
  (if (or (< part 0)
          (>= (cast i64 part) (len (.leaves index)))
          (!= (cast i64 child) (len (.leaves index)))
          (< position 0)
          (> (len (.nodes index)) 2147483645))
      false
      (let [old (get (.leaves index) (cast i64 part))
            left (cast i32 (len (.nodes index)))
            right (+ left 1)]
        (push! (mut (.nodes index))
               (Fork
                 :part part
                 :left -1
                 :right -1
                 :position 0))
        (push! (mut (.nodes index))
               (Fork
                 :part child
                 :left -1
                 :right -1
                 :position 0))
        (set! (mut (.nodes index))
              (cast i64 old)
              (Fork
                :part -1
                :left left
                :right right
                :position position))
        (set! (mut (.leaves index)) (cast i64 part) left)
        (push! (mut (.leaves index)) right)
        true)))

;;; Resolve lazily from the event's last known leaf. Splits only add descendants,
;;; so every cached path remains valid and can be compressed after a query.
(defn owner! [(index (mut Index)) (event i64)] (-> i32)
  (let [position (.position (get (.events index) event))
        (mut cursor) (get (.roots index) event)
        (mut node) (get (.nodes index) (cast i64 cursor))]
    (while (>= (.left node) 0)
      (set! cursor
            (if (< position (.position node)) (.left node) (.right node)))
      (set! node (get (.nodes index) (cast i64 cursor))))
    (set! (mut (.roots index)) event cursor)
    (.part node)))

;;; Whether this immutable register bucket contains events. Deactivation and
;;; ownership changes do not remove events, so true does not imply a live hit.
(defn has-register? [(index Index) (register i32)] (-> bool)
  (and (>= register 0)
       (< (+ (cast i64 register) 1) (len (.starts index)))
       (< (get (.starts index) (cast i64 register))
          (get (.starts index) (+ (cast i64 register) 1)))))

;;; Earliest fixed use in [begin,end) owned by a different split child.
(defn first-other! [(index (mut Index))
                    (register i32)
                    (begin i64)
                    (end i64)
                    (part i32)] (-> i64)
  (if (or (< register 0)
          (>= (+ (cast i64 register) 1) (len (.starts index)))
          (< begin 0)
          (<= end begin))
      -1
      (let [(mut lo) (get (.starts index) (cast i64 register))
            stop (get (.starts index) (+ (cast i64 register) 1))
            (mut hi) stop
            (mut found) (: -1 i64)]
        (while (< lo hi)
          (let [mid (+ lo (/ (- hi lo) 2))]
            (if (< (.position (get (.events index) mid)) begin)
                (set! lo (+ mid 1))
                (set! hi mid))))
        (while (and (< lo stop)
                    (< found 0)
                    (< (.position (get (.events index) lo)) end))
          (when (!= (owner! (mut index) lo) part)
            (set! found (.position (get (.events index) lo))))
          (set! lo (+ lo 1)))
        found)))
