;;; Graph-owned binary string interning. IDs are one-based and stable across
;;; arena growth; embedded zeros are significant, as required for prototypes.
(module stogir.strings)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.alloc" :use [Allocator])
(import "coil.slice" :use [subslice])
(import "coil.result" :use [Option Some None])

(defstruct Entry [(offset i64) (length i64) (next i32)])

(defstruct Pool
  [(bytes (ArrayList u8))
   (entries (ArrayList Entry))
   (heads (HashMap u64 i32))])

(defn create [(allocator (dyn Allocator))] (-> Pool)
  (Pool
    :bytes (ArrayList::new [u8] allocator)
    :entries (ArrayList::new [Entry] allocator)
    :heads (HashMap::new-scalar [u64 i32] allocator)))

(defn hash [(value (slice u8))] (-> u64)
  (let [(mut result) (: 14695981039346656037 u64)]
    (let [items-101 value (mut for-index-101) (: 0 i64)] (while (< for-index-101 (len items-101)) (let [byte (get items-101 for-index-101)]
      (set! result
            (cast u64
                  (* (cast u128 (^ result (cast u64 byte)))
                     (: 1099511628211 u128))))) (set! for-index-101 (+ for-index-101 1))))
    result))

(defn same? [(pool Pool) (entry Entry) (value (slice u8))] (-> bool)
  (let [(mut equal?) (= (.length entry) (len value))
        (mut i) 0]
    (while (and equal? (< i (len value)))
      (when (!= (get (.bytes pool) (+ (.offset entry) i)) (get value i))
        (set! equal? false))
      (set! i (+ i 1)))
    equal?))

(defn intern! [(pool (mut Pool)) (value (slice u8))] (-> (Option i32))
  (let [key (hash value)
        head (match (get (.heads pool) key) (Some [id] id) (None [] (: 0 i32)))
        (mut cursor) head
        (mut found) (: 0 i32)]
    (while (and (> cursor 0) (= found 0))
      (let [entry (get (.entries pool) (- (cast i64 cursor) 1))]
        (if (same? pool entry value)
            (set! found cursor)
            (set! cursor (.next entry)))))
    (if (> found 0)
        (Some found)
        (if (or (>= (len (.entries pool)) 2147483647)
                (> (len value) (- 0x7FFFFFFFFFFFFFFF (len (.bytes pool)))))
            (None)
            (let [id (cast i32 (+ (len (.entries pool)) 1))
                  offset (len (.bytes pool))]
              (if (not (bytes/append-slice! (mut (.bytes pool)) value))
                  (None)
                  (do
                    (push! (mut (.entries pool))
                           (Entry
                             :offset offset
                             :length (len value)
                             :next head))
                    (set! (mut (.heads pool)) key id)
                    (Some id))))))))

;;; Returned view is valid until the pool's arena is mutated or released.
(defn lookup [(pool Pool) (id i32)] (-> (Option (slice u8)))
  (if (or (<= id 0) (> (cast i64 id) (len (.entries pool))))
      (None)
      (let [entry (get (.entries pool) (- (cast i64 id) 1))
            size (len (.bytes pool))]
        (if (or (< (.offset entry) 0)
                (> (.offset entry) size)
                (< (.length entry) 0)
                (> (.length entry) (- size (.offset entry))))
            (None)
            (Some (subslice (slice (.bytes pool))
                            (.offset entry)
                            (+ (.offset entry) (.length entry))))))))

(defn release! [(pool (mut Pool))] (-> void)
  (free! (mut (.bytes pool)))
  (free! (mut (.entries pool)))
  (free! (mut (.heads pool))))
