;;; Optimization-level policy follows pinned ir.h:ir_jit_compile. Native target
;;; support is checked at its entry point; a valid level is not a parity claim.
(module stogir.options)
(import "coil.result" :use [Result Ok Err])

(defstruct Options [(level i32)])

(defn defaults [] (-> Options)
  (Options :level 1))

(defn validate [(options Options)] (-> (Result i32 (slice u8)))
  (if (or (< (.level options) 0) (> (.level options) 3))
      (Err "optimization level must be between zero and three")
      (Ok (.level options))))
