(import "stogir.a64.compile" :as native)
(import "stogir.jit.darwin" :as jit)
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "stogir.finite-countdown" :as countdown)
(defn inspect [(graph g/Graph) (entry i32) (roots (slice i32))] (-> void)
 (let [a (malloc-allocator) (mut edges) (uses/build graph a)]
  (for [r 1 (len (.instructions graph))]
   (match (countdown/select graph edges (cast i32 r))
    (None [] 0)
    (Some [plan] (println "selected header {} counter {} step {} exit {}"
                   (.header plan) (.counter plan) (.step plan) (.outside plan)))))
  (uses/release! (mut edges)))
 (let [a (malloc-allocator)]
  (match (native/text graph entry roots a)
   (Err [e] (panic "{}" e))
   (Ok [text]
    (let [(mut bytes) text (mut values) (ArrayList::new [i64] a)]
     (println "native bytes {}" (len bytes))
     (for [i 0 256] (push! (mut values) i))
     (let [storage (.data values) capacity (cap values)]
      (match (jit/map-text (slice bytes))
       (Err [e] (panic "{}" e))
       (Ok [mapped]
        (let [(mut image) mapped f (p/cast (fnptr (cc/C) [(ptr i64)] i64) (.base image))]
         (for [count 0 257]
          (set! (.len values) count)
          (assert (= (call-ptr f (p/cast (ptr i64) (mut values))) 0))
          (assert (= (len values) 0))
          (assert (= (cap values) capacity))
          (assert (= (.data values) storage)))
         (jit/release! (mut image))))))
     (free! (mut values)) (free! (mut bytes)))))
  (println "captured clear: 257 native answers and preserved storage passed"))
 (println "entry {}" entry)
 (for root roots (println "root {}" root))
 (for [r 1 (len (.instructions graph))]
  (when (>= (get (.arities graph) r) 0)
   (let [node (get (.instructions graph) r)]
    (println "node {} op {} ty {} aux {} arity {} args {} {} {}" r (n/opcode node)
       (n/type-id node) (n/auxiliary node) (get (.arities graph) r)
       (.op1 node) (.op2 node) (.op3 node)))))
 (for [i 0 (len (.constants graph))]
  (let [node (get (.constants graph) i)]
   (println "constant {} ty {} bits {}" (- 0 (+ i 1)) (n/type-id node) (n/constant-bits node)))))
