(import "stogir.boolean-diamond" :as diamond)
(defn inspect [(graph g/Graph) (entry i32) (roots (slice i32))] (-> void)
 (let [a (malloc-allocator) (mut edges) (uses/build graph a)]
  (for [r 1 (len (.instructions graph))]
   (let [node (get (.instructions graph) r)]
    (when (and (= (get (.arities graph) r) 2) (= (n/opcode node) 112))
     (let [range (get (.ranges edges) r)]
      (for [i (.offset range) (+ (.offset range) (.count range))]
       (let [edge (get (.edges edges) i) phi (get (.instructions graph) (cast i64 (.user edge)))]
        (when (and (= (n/opcode phi) 67) (= (.operand edge) 1) (= (get (.arities graph) (cast i64 (.user edge))) 3))
         (println "merge {} phi {} arms {} {} literal-pair {} candidate {}" r (.user edge) (.op2 phi) (.op3 phi)
          (and (diamond/integer-literal? graph (.op2 phi) (n/type-id phi)) (diamond/integer-literal? graph (.op3 phi) (n/type-id phi)))
          (diamond/candidate graph edges (cast i32 r))))))))))
  (uses/release! (mut edges))
  (match (pipeline/prepare-native graph entry roots a)
   (Err [e] (panic "{}" e))
   (Ok [value] (let [(mut prepared) value (mut phis) 0 (mut same) 0]
    (for reference (.nodes (.schedule prepared))
     (let [node (get (.instructions graph) (cast i64 reference))]
      (when (= (n/opcode node) 67)
       (set! phis (+ phis 1))
       (when (and (= (get (.arities graph) (cast i64 reference)) 3) (= (.op2 node) (.op3 node)))
        (set! same (+ same 1))
        (println "live-identical-phi {} source {} type {}" reference (.op2 node) (n/type-id node))))))
    (println "scheduled phis {} identical {}" phis same)
    (pipeline/release! (mut prepared)))))))
