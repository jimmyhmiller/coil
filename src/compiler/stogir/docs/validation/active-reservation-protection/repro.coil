(module gaps.active-reservation)
(import "stogir.allocation" :as a)
(import "stogir.interval" :as r)
(import "stogir.constraints" :as c)
(import "stogir.frame" :as frame)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Ok Err])
(defn main [] (-> i64)
 (let [alc (malloc-allocator) (mut parts) (ArrayList::new [a/Part] alc)
       (mut area) (frame/create alc) (mut part) (a/create 0 alc)]
  (r/add! (mut (.ranges part)) 6 20)
  (c/add! (mut (.uses part)) 19 1 -1)
  (push! (mut parts) part)
  (a/reserve! (mut parts) 0 5 9 alc)
  (match (a/run! (mut parts) (mut area) 1 1 8 8 alc)
   (Err [e] (println "Err: {}" e)) (Ok [_] (println "Ok")))
  (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
  (free! (mut parts)) (frame/release! (mut area))) 0)
