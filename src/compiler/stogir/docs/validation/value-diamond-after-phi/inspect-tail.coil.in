(import "stogir.liveness" :as graph-live)
(import "stogir.boolean-diamond" :as diamond)
(defn shape-candidate [(graph g/Graph) (edges uses/Uses) (merge i32)] (-> i32)
  (let [region (get (.instructions graph) (cast i64 merge))
        first (.op1 region)
        second (.op2 region)]
    (if (or (!= (n/opcode region) 112)
            (!= (get (.arities graph) (cast i64 merge)) 2)
            (!= (diamond/count edges merge) 2))
        0
        (let [end1 (get (.instructions graph) (cast i64 first))
              end2 (get (.instructions graph) (cast i64 second))
              arm1 (.op1 end1)
              arm2 (.op1 end2)]
          (if (or (!= (n/opcode end1) 114)
                  (!= (n/opcode end2) 114)
                  (!= (diamond/count edges first) 1)
                  (!= (diamond/count edges second) 1))
              0
              (let [start1 (get (.instructions graph) (cast i64 arm1))
                    start2 (get (.instructions graph) (cast i64 arm2))
                    branch (.op1 start1)]
                (if (or (!= (+ (cast i32 (n/opcode start1))
                               (cast i32 (n/opcode start2)))
                            215)
                        (not (or (= (n/opcode start1) 107)
                                 (= (n/opcode start1) 108)))
                        (!= branch (.op1 start2))
                        (!= (diamond/count edges arm1) 1)
                        (!= (diamond/count edges arm2) 1)
                        (!= (diamond/count edges branch) 2)
                        (!= (n/opcode (get (.instructions graph)
                                           (cast i64 branch)))
                            116))
                    0
                    (let [range (get (.ranges edges) (cast i64 merge))
                          (mut phi) (: 0 i32)
                          (mut next) false]
                      (for [i
                            (.offset range)
                            (+ (.offset range) (.count range))]
                        (let [edge (get (.edges edges) i)
                              node
                                (get (.instructions graph)
                                     (cast i64 (.user edge)))]
                          (if (and (= (n/opcode node) 67)
                                   (= (.operand edge) 1)
                                   (= (get (.arities graph)
                                           (cast i64 (.user edge)))
                                      3))
                              (when true
                                (set! phi (.user edge)))
                              (when (and (op/control? (cast i32 (n/opcode node)))
                                         (= (op/operand-code (cast i32
                                                                   (n/opcode node))
                                                             (.operand edge))
                                            op/OPERAND-SRC))
                                (set! next true)))))
                      (if (and next
                               (> phi 0)
                               (diamond/movable-condition? graph (diamond/input graph branch 2)))
                          phi
                          0)))))))))

(defn inspect [(graph g/Graph) (entry i32) (roots (slice i32))] (-> void)
 (let [a (malloc-allocator) (mut edges) (uses/build graph a) (mut alive) (graph-live/mark graph roots a)]
  (for [r 1 (len (.instructions graph))]
   (let [node (get (.instructions graph) r)]
    (when (and (= (get (.arities graph) r) 2) (= (n/opcode node) 112))
     (let [range (get (.ranges edges) r)]
      (for [i (.offset range) (+ (.offset range) (.count range))]
       (let [edge (get (.edges edges) i) phi (get (.instructions graph) (cast i64 (.user edge)))]
        (when (and (= (n/opcode phi) 67) (= (.operand edge) 1) (= (get (.arities graph) (cast i64 (.user edge))) 3))
         (println "merge {} phi {} arms {} {} literal-pair {} candidate {}" r (.user edge) (.op2 phi) (.op3 phi)
          (and (diamond/integer-literal? graph (.op2 phi) (n/type-id phi)) (diamond/integer-literal? graph (.op3 phi) (n/type-id phi)))
          (diamond/candidate graph edges (cast i32 r)))
         (when (and (get alive (cast i64 (.user edge))) (= (shape-candidate graph edges (cast i32 r)) (.user edge)))
          (println "live-diamond-shape {} phi {} values {} {}" r (.user edge) (.op2 phi) (.op3 phi))
          (let [values [(.op2 phi) (.op3 phi)]] (for value values
           (match (g/lookup graph value)
            (None [] (panic "missing value"))
            (Some [v] (println "arm {} opcode {} type {} op1 {}" value (n/opcode v) (n/type-id v) (.op1 v))))))))))))))
  (uses/release! (mut edges)) (free! (mut alive))
  (match (pipeline/prepare-native graph entry roots a)
   (Err [e] (panic "{}" e))
   (Ok [value] (let [(mut prepared) value (mut phis) 0 (mut same) 0]
    (for reference (.nodes (.schedule prepared))
     (let [node (get (.instructions graph) (cast i64 reference))]
      (when (= (n/opcode node) 67)
       (set! phis (+ phis 1))
       (when (and (= (get (.arities graph) (cast i64 reference)) 3) (= (.op2 node) (.op3 node)))
        (set! same (+ same 1))
        (println "live-identical-phi {} source {} type {}" reference (.op2 node) (n/type-id node))))))
    (println "scheduled phis {} identical {}" phis same)
    (pipeline/release! (mut prepared)))))))
