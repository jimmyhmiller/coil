(module gaps.structure-operands-runner)
(import "stogir.builder" :as b)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as p)
(import "coil.result" :use [Option Some None Ok Err])
(extern gap_verify_structure [(ptr g/Graph) (ptr u8) i64] (-> i64))
(defn need [(x (Option i32))] (-> i32)
 (match x (Some [r] r) (None [] (panic "graph capacity"))))
(defn check [(count i64) (mode i64)] (-> void)
 (let [a (malloc-allocator) (mut graph) (g/create a)
       start (need (g/append-inputs! (mut graph) 104 0 [(: 0 i32)]))
       (mut inputs) (ArrayList::new [i32] a)]
  (for [i 0 count] (push! (mut inputs) start))
  (let [ref (need (g/append-inputs! (mut graph) 112 0 (slice inputs)))
        old (get (.instructions graph) (cast i64 ref))]
   (case mode
    1 (when (> count 0) (assert (g/set-operand! (mut graph) ref 1 0)))
    2 (when (> count 0) (assert (g/set-operand! (mut graph) ref (cast i32 count) -2147483648)))
    3 (when (> count 0) (assert (g/set-operand! (mut graph) ref (cast i32 count) 2147483647)))
    4 (set! (mut (.arities graph)) (cast i64 ref) 65536)
    5 (set! (mut (.arities graph)) (cast i64 ref) -2)
    6 (set! (mut (.instructions graph)) (cast i64 ref)
        (n/make 255 0 (cast u16 count) (.op1 old) (.op2 old) (.op3 old)))
    7 (set! (mut (.instructions graph)) (cast i64 ref)
        (n/make 112 255 (cast u16 count) (.op1 old) (.op2 old) (.op3 old)))
    8 (when (>= count 4) (set! (mut (.arities graph)) (+ (cast i64 ref) 1) 0))
    9 (do (pop! (mut (.instructions graph))) (pop! (mut (.arities graph))))
    10 (do (pop! (mut (.arities graph))) 0)
    11 (set! (mut (.instructions graph)) (cast i64 ref)
         (n/make 112 0 (cast u16 (+ count 1)) (.op1 old) (.op2 old) (.op3 old)))
    12 (when (>= count 4)
         (assert (g/set-operand! (mut graph) ref (cast i32 count) (+ ref 1))))
    13 (do (need (g/append-inputs! (mut graph) 79 5 [start (: 0 i32)])) 0)
    14 (let [local (match (b/variable! (mut graph) 11 start "local" 8) (Ok [r] r) (Err [e] (panic "{}" e)))
             literal (need (g/intern-scalar! (mut graph) 11 1))]
         (need (g/append-inputs! (mut graph) 26 11 [local literal])) 0)
    0)
   (let [(mut error) (ArrayList::new [u8] a)
         filled (extend-zeroed! (mut error) 128)
         result (gap_verify_structure (p/cast (ptr g/Graph) (mut graph))
                    (.data error) 128)]
    (print "{} {} {}" count mode result)
    (when (< result 0)
     (for [i 0 (- -1 result)] (print " {}" (get error i))))
    (println "") (free! (mut error))))
  (free! (mut inputs)) (g/release! (mut graph))))
(defn main [] (-> i64)
 (for count [(: 0 i64) 1 2 3 4 5 7 8 15 16 31 32 255 256 1023 4096 65535]
  (for [mode 0 15] (check count mode)))
 0)
