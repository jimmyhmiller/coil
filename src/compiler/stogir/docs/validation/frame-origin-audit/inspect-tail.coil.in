(defn inspect [(graph g/Graph) (entry i32) (roots (slice i32))] (-> void)
 (let [a (malloc-allocator)]
  (match (pipeline/prepare-native graph entry roots a)
   (Err [e] (panic "{}" e))
   (Ok [owned]
    (let [(mut prepared) owned]
     (match (matching/build graph (.schedule prepared) roots true a)
      (Err [e] (panic "{}" e))
      (Ok [owned-plan]
       (let [(mut plan) owned-plan
             (mut analysis) (live/analyze-matched graph (.blocks prepared) (.schedule prepared)
                              (.order prepared) (.operands plan) a)
             (mut intervals) (ranges/build-matched graph (.schedule prepared) analysis
                              (.order prepared) (.operands plan) a)]
        (match (constraints/build-matched graph (.schedule prepared) plan a)
         (Err [e] (panic "{}" e))
         (Ok [owned-req]
          (let [(mut req) owned-req]
           (match (allocate/build-prepared-with-machine intervals req graph (.schedule prepared)
                     (.static-sizes plan) (.operands plan) (.blocks prepared) (.depths prepared) a)
            (Err [e] (panic "{}" e))
            (Ok [owned-allocation]
             (let [(mut assigned) owned-allocation frame (.frame assigned)]
              (println "frame {} base {} bias {} outgoing {} link {} result {} saved {} at {}"
                (.size frame) (.reg (.base assigned)) (.bias (.base assigned)) (.outgoing-size assigned)
                (.link-slot assigned) (.result-slot assigned) (.mask (.callee assigned)) (.offset (.callee assigned)))
              (for [i 0 (len (.slots frame))]
               (let [slot (get (.slots frame) i)]
                (println "slot {} {} {} {}" i (.offset slot) (.size slot) (.alignment slot))))
              (for parent (.parents frame)
               (match (get (.parents frame) parent)
                (None [] (panic "missing spill owner"))
                (Some [slot] (println "spill {} {}" parent slot))))
              (for owner (.locals frame)
               (match (get (.locals frame) owner)
                (None [] (panic "missing local owner"))
                (Some [slot] (println "local {} {}" owner slot))))
              (for part (.parts assigned)
               (when (> (.parent part) 0)
                (println "part {} reg {} spill {}" (.parent part) (.register part) (.spill-slot part))
                (for range (.ranges part) (println "range {} {}" (.start range) (.end range)))
                (for use (.uses part) (println "use {} {} {}" (.position use) (.kind use) (.register use)))))
              (for block (.order prepared)
                (let [range (get (.ranges (.schedule prepared)) (cast i64 block))]
                  (println "block {} depth {} idom {} begin {} end {}" block
                    (get (.depths prepared) (cast i64 block)) (get (.idom prepared) (cast i64 block))
                    (* (.offset range) 2) (* (+ (.offset range) (.count range)) 2))))
              (for edge (.edges (.blocks prepared))
                (println "edge {} {}" (.from edge) (.to edge)))
              (for ref (.nodes (.schedule prepared))
               (let [node (get (.instructions graph) (cast i64 ref))]
                (println "node {} {} {} {} {} {}" ref (n/opcode node) (n/type-id node)
                         (.op1 node) (.op2 node) (.op3 node))))
              (match (function/body-prepared graph prepared assigned analysis req plan a)
               (Err [e] (panic "{}" e))
               (Ok [owned-code]
                (let [(mut output) owned-code]
                 (print "text") (for byte (.text output) (print " {}" byte)) (println "")
                 (for ref (.references output)
                  (println "reloc {} {} {}" (.offset ref) (.kind ref) (.target ref)))
                 (code/release! (mut output)))))
              (allocate/release! (mut assigned)))))
           (constraints/release! (mut req)))))
        (ranges/release! (mut intervals)) (live/release-analysis! (mut analysis))
        (matching/release! (mut plan)))))
     (pipeline/release! (mut prepared)))))))
