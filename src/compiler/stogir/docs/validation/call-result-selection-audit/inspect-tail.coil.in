(defn inspect [(graph g/Graph) (entry i32) (roots (slice i32))] (-> void)
 (let [a (malloc-allocator)]
  (match (pipeline/prepare-native graph entry roots a)
   (Err [e] (panic "{}" e))
   (Ok [owned]
    (let [(mut prepared) owned (mut blocks) (ArrayList::new [i32] a)
          (mut users) (uses/build graph a) (mut block) (: 0 i32)]
     (for [i 0 (len (.instructions graph))] (push! (mut blocks) 0))
     (for ref (.nodes (.schedule prepared))
      (let [node (get (.instructions graph) (cast i64 ref))]
       (when (op/block-start? (cast i32 (n/opcode node))) (set! block ref))
       (set! (mut blocks) (cast i64 ref) block)))
     (match (matching/build graph (.schedule prepared) roots true a)
      (Err [e] (panic "{}" e))
      (Ok [plan]
       (let [(mut plan) plan (mut calls) 0 (mut eligible) 0 (mut selected) 0]
        (for ref (.nodes (.schedule prepared))
         (let [node (get (.instructions graph) (cast i64 ref))]
          (when (= (n/opcode node) 79)
           (set! calls (+ calls 1))
           (let [spec (projection/result-spec graph ref)]
            (println "signature {} target {} kind {} ty {} count {}" ref (.op2 node) (.kind spec) (.ty spec) (.count spec))
            (when (projection/eligible-spec? spec)
             (set! eligible (+ eligible 1))
             (when (> (.count (machine/output-range (.operands plan) ref)) 0)
              (set! selected (+ selected 1)))
             (println "call {} block {} place {} pieces {} selected {}" ref
                (get blocks (cast i64 ref)) (.op3 node) (.count spec)
                (.count (machine/output-range (.operands plan) ref)))
             (when (> (.op3 node) 0)
              (let [range (get (.ranges users) (cast i64 (.op3 node)))]
               (for [i 0 (.count range)]
                (let [edge (get (.edges users) (+ (.offset range) i))
                      user (get (.instructions graph) (cast i64 (.user edge)))]
                 (when (projection/data-use? graph edge)
                  (println " use {} op {} ty {} operand {} block {} control {}" (.user edge)
                    (n/opcode user) (n/type-id user) (.operand edge)
                    (get blocks (cast i64 (.user edge))) (.op1 user))
                  (when (= (n/opcode user) 26)
                   (let [next (get (.ranges users) (cast i64 (.user edge)))]
                    (for [j 0 (.count next)]
                     (let [child (get (.edges users) (+ (.offset next) j))
                           child-node (get (.instructions graph) (cast i64 (.user child)))]
                      (when (projection/data-use? graph child)
                       (println "  use {} op {} ty {} operand {} block {} control {}" (.user child)
                         (n/opcode child-node) (n/type-id child-node) (.operand child)
                         (get blocks (cast i64 (.user child))) (.op1 child-node)))))))))))))))))
        (println "total calls {} eligible {} selected {}" calls eligible selected)
        (matching/release! (mut plan)))))
     (uses/release! (mut users)) (free! (mut blocks)) (pipeline/release! (mut prepared)))))))
