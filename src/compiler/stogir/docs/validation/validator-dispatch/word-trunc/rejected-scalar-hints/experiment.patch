diff --git a/src/stogir/types.coil b/src/stogir/types.coil
index bbecff6..3c3d9e9 100644
--- a/src/stogir/types.coil
+++ b/src/stogir/types.coil
@@ -2,19 +2,19 @@
 ;;; Upstream-compatible scalar identifiers and vector type geometry.
 (module stogir.types)
 
-(defn valid-scalar? [(t i32)] (-> bool)
+(defn valid-scalar? :inline (Always) [(t i32)] (-> bool)
   (and (>= t 0) (<= t 13)))
 
-(defn unsigned? [(t i32)] (-> bool)
+(defn unsigned? :inline (Always) [(t i32)] (-> bool)
   (and (>= t 1) (<= t 6)))
 
-(defn signed? [(t i32)] (-> bool)
+(defn signed? :inline (Always) [(t i32)] (-> bool)
   (and (>= t 7) (<= t 11)))
 
-(defn integer? [(t i32)] (-> bool)
+(defn integer? :inline (Always) [(t i32)] (-> bool)
   (and (>= t 1) (<= t 11)))
 
-(defn floating? [(t i32)] (-> bool)
+(defn floating? :inline (Always) [(t i32)] (-> bool)
   (or (= t 12) (= t 13)))
 
 ;;; Address size is supplied by the target, never inferred from the host.
@@ -37,20 +37,20 @@
 ;;; A vector retains the scalar base in bits0..3 and log2(lanes)+1 in
 ;;; bits4..6, exactly as ir.h. Representation validity is independent of which
 ;;; shapes an operation or target supports. No type uses bit7.
-(defn vector? [(ty i32)] (-> bool)
+(defn vector? :inline (Always) [(ty i32)] (-> bool)
   (and (> ty 15)
        (< ty 128)
        (>= (& ty 15) 1)
        (<= (& ty 15) 13)))
 
-(defn valid? [(ty i32)] (-> bool)
+(defn valid? :inline (Always) [(ty i32)] (-> bool)
   (or (valid-scalar? ty) (vector? ty)))
 
-(defn base-type [(ty i32)] (-> i32)
+(defn base-type :inline (Always) [(ty i32)] (-> i32)
   (if (valid? ty) (& ty 15) -1))
 
 ;;; Void has zero lanes; an ordinary scalar value has one. Invalid codes fail.
-(defn lanes [(ty i32)] (-> i32)
+(defn lanes :inline (Always) [(ty i32)] (-> i32)
   (if (vector? ty)
       (<< (: 1 i32) (- (>> ty 4) 1))
       (if (valid-scalar? ty) (if (= ty 0) 0 1) -1)))
