(defn inspect [(graph g/Graph) (entry i32) (roots (slice i32))] (-> void)
 (let [a (malloc-allocator) (mut edges) (uses/build graph a)]
  (match (pipeline/prepare-native graph entry roots a)
   (Err [e] (panic "{}" e))
   (Ok [value]
    (let [(mut prepared) value
          (mut owner) (ArrayList::new [i32] a)]
     (extend-zeroed! (mut owner) (len (.instructions graph)))
     (for block (.order prepared)
      (let [range (get (.ranges (.schedule prepared)) (cast i64 block))]
       (for [i (.offset range) (+ (.offset range) (.count range))]
        (set! (mut owner) (cast i64 (get (.nodes (.schedule prepared)) i)) block))))
     (match (matching/build graph (.schedule prepared) roots true a)
      (Err [e] (panic "{}" e))
      (Ok [value]
       (let [(mut plan) value]
        (for ref (.nodes (.schedule prepared))
         (let [opcode (n/opcode (get (.instructions graph) (cast i64 ref)))]
          (when (and (>= opcode 14) (<= opcode 23))
           (let [range (get (.ranges edges) (cast i64 ref))
                 (mut seen) 0 (mut ifs) 0 (mut fused) 0 (mut cross) 0]
            (for [i 0 (.count range)]
             (let [edge (get (.edges edges) (+ (.offset range) i)) user (.user edge)]
              (when (> (get owner (cast i64 user)) 0)
               (set! seen (+ seen 1))
               (when (and (= (.operand edge) 2)
                          (= (n/opcode (get (.instructions graph) (cast i64 user))) 116))
                (set! ifs (+ ifs 1))
                (when (!= (get owner (cast i64 ref)) (get owner (cast i64 user)))
                 (set! cross (+ cross 1)))
                (when (= (get (.comparisons plan) (cast i64 user)) ref)
                 (set! fused (+ fused 1)))))))
            (let [tile (get (.tiles plan) (cast i64 ref))]
             (println "comparison {} uses {} IFs {} cross-block {} fused {} rule {} wide {}" ref seen ifs cross fused (.rule tile) (.wide tile)))))))
        (matching/release! (mut plan)))))
     (free! (mut owner)) (pipeline/release! (mut prepared)))))
  (uses/release! (mut edges))))
