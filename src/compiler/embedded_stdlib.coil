; src/compiler/embedded_stdlib.coil — the prelude + bundled stdlib, embedded as
; string constants so the compiler is portable (runs outside the repo, where
; src/stdlib/*.coil don't exist). This is the same trick as Rust's `include_str!`:
; `(include-str "path")` reads the file AT COMPILE TIME and folds it into a string
; literal, so the bytes are baked into the compiler binary. Paths are resolved
; relative to THIS file's directory (src/compiler), so prelude.coil is a sibling
; and the bundled libs are ../stdlib. No escaping and no blob of copied text to
; keep in sync — editing prelude.coil or a bundled lib and rebuilding is all it
; takes (the embedded TEXT can never go stale relative to the build).
;
; The three manifest tables below — which files exist, and what namespace each
; declares — are the one part that CAN go stale, so they are generated from
; src/stdlib/ by scripts/compiler/gen-embedded-stdlib.py and gated by
; `gate-cli.sh`. Do not edit them by hand; add the file and regenerate. Omitting a
; namespace here does not fail in-repo (the loader falls back to scanning the
; source tree) — it fails only for a compiler run elsewhere, which is why it needs
; a generator and a gate rather than review.
;
; With COIL_STDLIB_DIR set, the loader prefers live source under it over these
; embedded copies (dev workflow); unset, the embedded copies are authoritative
; (loader.coil).
(module embedded_stdlib)

(import "coil.slice" :use *)
(import "coil.str" :use *)

(defn embedded-prelude [] (-> (slice u8))
  (include-str "prelude.coil"))

;; BEGIN GENERATED -- regenerate with scripts/compiler/gen-embedded-stdlib.py

; Public namespace discovery for the bundled library: what `coil namespaces`
; prints. Internal implementation-detail namespaces are importable but omitted
; here on purpose (see INTERNAL_NAMESPACES in the generator).
(defn embedded-namespaces [] (-> (slice u8))
  "coil.alloc\ncoil.args\ncoil.arraylist\ncoil.assert\ncoil.async\ncoil.async-runtime\ncoil.atomic\ncoil.brainfuck\ncoil.brainfuck.reader\ncoil.cancellation\ncoil.checked-ffi\ncoil.closure\ncoil.control\ncoil.core\ncoil.crash\ncoil.dbgalloc\ncoil.debug\ncoil.debug-runtime\ncoil.derive\ncoil.dyn\ncoil.fmt\ncoil.fs\ncoil.guardalloc\ncoil.hashmap\ncoil.http.client\ncoil.http.parser\ncoil.http.server\ncoil.io\ncoil.json\ncoil.lint.allocator\ncoil.lint.default\ncoil.lint.match-else\ncoil.lint.named-constructor\ncoil.lint.result-flow\ncoil.match\ncoil.mem\ncoil.mmio\ncoil.modernize\ncoil.os\ncoil.primitive\ncoil.print\ncoil.process\ncoil.prop\ncoil.prop.arbitrary\ncoil.prop.cov\ncoil.prop.db\ncoil.prop.derive\ncoil.prop.gen\ncoil.prop.source\ncoil.prop.stateful\ncoil.reader\ncoil.region\ncoil.result\ncoil.scratch\ncoil.selectors\ncoil.serde\ncoil.serde.derive\ncoil.serde.json\ncoil.serde.msgpack\ncoil.serde.sexp\ncoil.serde.value\ncoil.signals\ncoil.simd\ncoil.slice\ncoil.socket\ncoil.stacklint\ncoil.str\ncoil.subprocess\ncoil.sync\ncoil.thread\ncoil.time\ncoil.try\n")

