; Text of a bundled stdlib module by filename, or an empty slice if not
; bundled. `bundled?` in loader.coil derives from this: a name is bundled iff
; we carry its text. `include-str` reads the file at COMPILE time, so these
; bytes are baked into the compiler binary and cannot drift from the sources.
(defn embedded-lib [(name (slice u8))] (-> (slice u8))
  (cond (= name "alloc.coil") (include-str "../stdlib/alloc.coil")
        (= name "allocator_lint.coil") (include-str "../stdlib/allocator_lint.coil")
        (= name "args.coil") (include-str "../stdlib/args.coil")
