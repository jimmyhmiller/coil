; src/compiler/embedded_stdlib.coil — the prelude + bundled stdlib, embedded as
; string constants so the compiler is portable (runs outside the repo, where
; src/stdlib/*.coil don't exist). This is the same trick as the
; `include_str!`: `(include-str "path")` reads the file AT COMPILE TIME and folds it
; into a string literal, so the bytes are baked into the compiler binary. Paths are
; resolved relative to THIS file's directory (src/compiler), so prelude.coil is a
; sibling and the bundled libs are ../../lib. No external codegen step, no escaping,
; no generated blob to keep in sync — editing prelude.coil or a bundled lib and
; rebuilding is all it takes (the embed can never go stale relative to the build).
;
; With COIL_STDLIB_DIR set, the loader prefers live source under it over these
; embedded copies (dev workflow); unset, the embedded copies are authoritative
; (loader.coil).
(module embedded_stdlib)

(import "coil.slice" :use *)
(import "coil.str" :use *)

(defn embedded-prelude [] (-> (slice u8))
  (include-str "prelude.coil"))

; Public namespace discovery for the bundled library. Keep this beside
; `embedded-lib`: both tables are deliberately reviewable manifests of the API
; shipped inside a standalone compiler.
(defn embedded-namespaces [] (-> (slice u8))
  "coil.alloc\ncoil.arraylist\ncoil.assert\ncoil.async\ncoil.async-runtime\ncoil.atomic\ncoil.closure\ncoil.control\ncoil.core\ncoil.dbgalloc\ncoil.derive\ncoil.fmt\ncoil.fs\ncoil.hashmap\ncoil.http.client\ncoil.http.parser\ncoil.http.server\ncoil.io\ncoil.json\ncoil.lint.result-flow\ncoil.match\ncoil.mem\ncoil.mmio\ncoil.modernize\ncoil.os\ncoil.primitive\ncoil.print\ncoil.process\ncoil.result\ncoil.selectors\ncoil.serde\ncoil.serde.derive\ncoil.serde.json\ncoil.serde.msgpack\ncoil.serde.sexp\ncoil.serde.value\ncoil.sexp\ncoil.simd\ncoil.slice\ncoil.stacklint\ncoil.str\ncoil.subprocess\ncoil.thread\ncoil.time\ncoil.try\n")

(defn embedded-file-for-namespace [(name (slice u8))] (-> (slice u8))
  (cond (str-eq name "coil.alloc") "alloc.coil"
        (str-eq name "coil.arraylist") "arraylist.coil"
        (str-eq name "coil.assert") "assert.coil"
        (str-eq name "coil.async") "async.coil"
        (str-eq name "coil.async-runtime") "async_runtime.coil"
        (str-eq name "coil.atomic") "atomic.coil"
        (str-eq name "coil.closure") "closure.coil"
        (str-eq name "coil.control") "control.coil"
        (str-eq name "coil.dbgalloc") "dbgalloc.coil"
        (str-eq name "coil.derive") "derive.coil"
        (str-eq name "coil.fmt") "fmt.coil"
        (str-eq name "coil.fs") "fs.coil"
        (str-eq name "coil.hashmap") "hashmap.coil"
        (str-eq name "coil.http.client") "http_client.coil"
        (str-eq name "coil.http.parser") "llhttp.coil"
        (str-eq name "coil.http.parser.types") "llhttp_types.coil"
        (str-eq name "coil.http.parser.generated") "llhttp_generated.coil"
        (str-eq name "coil.http.server") "http_server.coil"
        (str-eq name "coil.io") "io.coil"
        (str-eq name "coil.json") "json.coil"
        (str-eq name "coil.lint.result-flow") "result_lint.coil"
        (str-eq name "coil.match") "match.coil"
        (str-eq name "coil.mem") "mem.coil"
        (str-eq name "coil.mmio") "mmio.coil"
        (str-eq name "coil.modernize") "modernize.coil"
        (str-eq name "coil.os") "os.coil"
        (str-eq name "coil.primitive") "primitive.coil"
        (str-eq name "coil.print") "print.coil"
        (str-eq name "coil.process") "process.coil"
        (str-eq name "coil.result") "result.coil"
        (str-eq name "coil.selectors") "selectors.coil"
        (str-eq name "coil.serde") "serde.coil"
        (str-eq name "coil.serde.derive") "serde_derive.coil"
        (str-eq name "coil.serde.json") "serde_json.coil"
        (str-eq name "coil.serde.msgpack") "serde_msgpack.coil"
        (str-eq name "coil.serde.sexp") "serde_sexp.coil"
        (str-eq name "coil.serde.value") "serde_value.coil"
        (str-eq name "coil.sexp") "sexp.coil"
        (str-eq name "coil.simd") "simd.coil"
        (str-eq name "coil.slice") "slice.coil"
        (str-eq name "coil.stacklint") "stacklint.coil"
        (str-eq name "coil.str") "str.coil"
        (str-eq name "coil.subprocess") "subprocess.coil"
        (str-eq name "coil.thread") "thread.coil"
        (str-eq name "coil.time") "time.coil"
        (str-eq name "coil.try") "try.coil"
        ""))

; text of a bundled stdlib module by filename, or an empty slice if not bundled.
; This `cond` is the single source of truth for what is bundled — `bundled?`
; derives from it, and the snapshot corpus globs src/stdlib/*.coil directly.
(defn embedded-lib [(name (slice u8))] (-> (slice u8))
  (cond (str-eq name "alloc.coil") (include-str "../stdlib/alloc.coil")
        (str-eq name "primitive.coil") (include-str "../stdlib/primitive.coil")
        (str-eq name "async.coil") (include-str "../stdlib/async.coil")
        (str-eq name "async_runtime.coil") (include-str "../stdlib/async_runtime.coil")
        (str-eq name "arraylist.coil") (include-str "../stdlib/arraylist.coil")
        (str-eq name "assert.coil") (include-str "../stdlib/assert.coil")
        (str-eq name "atomic.coil") (include-str "../stdlib/atomic.coil")
        (str-eq name "closure.coil") (include-str "../stdlib/closure.coil")
        (str-eq name "control.coil") (include-str "../stdlib/control.coil")
        (str-eq name "dbgalloc.coil") (include-str "../stdlib/dbgalloc.coil")
        (str-eq name "derive.coil") (include-str "../stdlib/derive.coil")
        (str-eq name "fmt.coil") (include-str "../stdlib/fmt.coil")
        (str-eq name "fs.coil") (include-str "../stdlib/fs.coil")
        (str-eq name "hashmap.coil") (include-str "../stdlib/hashmap.coil")
        (str-eq name "http_client.coil") (include-str "../stdlib/http_client.coil")
        (str-eq name "llhttp.coil") (include-str "../stdlib/llhttp.coil")
        (str-eq name "llhttp_types.coil") (include-str "../stdlib/llhttp_types.coil")
        (str-eq name "llhttp_generated.coil") (include-str "../stdlib/llhttp_generated.coil")
        (str-eq name "http_server.coil") (include-str "../stdlib/http_server.coil")
        (str-eq name "io.coil") (include-str "../stdlib/io.coil")
        (str-eq name "json.coil") (include-str "../stdlib/json.coil")
        (str-eq name "result_lint.coil") (include-str "../stdlib/result_lint.coil")
        (str-eq name "match.coil") (include-str "../stdlib/match.coil")
        (str-eq name "mem.coil") (include-str "../stdlib/mem.coil")
        (str-eq name "mmio.coil") (include-str "../stdlib/mmio.coil")
        (str-eq name "modernize.coil") (include-str "../stdlib/modernize.coil")
        (str-eq name "os.coil") (include-str "../stdlib/os.coil")
        (str-eq name "print.coil") (include-str "../stdlib/print.coil")
        (str-eq name "process.coil") (include-str "../stdlib/process.coil")
        (str-eq name "result.coil") (include-str "../stdlib/result.coil")
        (str-eq name "selectors.coil") (include-str "../stdlib/selectors.coil")
        (str-eq name "serde.coil") (include-str "../stdlib/serde.coil")
        (str-eq name "serde_derive.coil") (include-str "../stdlib/serde_derive.coil")
        (str-eq name "serde_json.coil") (include-str "../stdlib/serde_json.coil")
        (str-eq name "serde_msgpack.coil") (include-str "../stdlib/serde_msgpack.coil")
        (str-eq name "serde_sexp.coil") (include-str "../stdlib/serde_sexp.coil")
        (str-eq name "serde_value.coil") (include-str "../stdlib/serde_value.coil")
        (str-eq name "sexp.coil") (include-str "../stdlib/sexp.coil")
        (str-eq name "simd.coil") (include-str "../stdlib/simd.coil")
        (str-eq name "slice.coil") (include-str "../stdlib/slice.coil")
        (str-eq name "stacklint.coil") (include-str "../stdlib/stacklint.coil")
        (str-eq name "str.coil") (include-str "../stdlib/str.coil")
        (str-eq name "subprocess.coil") (include-str "../stdlib/subprocess.coil")
        (str-eq name "thread.coil") (include-str "../stdlib/thread.coil")
        (str-eq name "time.coil") (include-str "../stdlib/time.coil")
        (str-eq name "try.coil") (include-str "../stdlib/try.coil")
        ""))
