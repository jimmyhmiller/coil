;;; Immutable checked-function index shared between compiler revisions.
(module coil.compiler.checked_base)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.slice" :use [slice-new])
(import "coil.str" :use [str-keyops-borrowed])
(import "coil.arraylist" :use *)
(import "coil.pmap" :use *)
(import "coil.scratch" :as scratch)
(import "coil.compiler.ast" :use [Func Const])
(import "coil.compiler.resolution_base" :as res)
(import "coil.compiler.retained_heap" :as heap)
(import "coil.compiler.retained_graph" :as graph)

(defstruct CheckedEntry
  [(function (ptr Func)) (artifact (ptr heap/Artifact)) (owner (ptr heap/Heap))])

;;; Latest accepted metadata root for one stable module/root slot. Both strings
;;; own their bytes independently of the function artifact: superseding a root
;;; may retire that artifact while the monotonic version history must remain.
(defstruct CheckedRoot
  [(name res/ResKey) (version i64)])

(impl Clone CheckedRoot
  (clone [(self (ref CheckedRoot))] (-> CheckedRoot)
    (CheckedRoot :name (clone (field self name))
                 :version (.version self))))

(defstruct CheckedRootRecord
  [(slot (slice u8)) (name (slice u8)) (version i64)])

(impl Clone CheckedEntry
  (clone [(self (ref CheckedEntry))] (-> CheckedEntry)
    (do
      (heap/artifact-retain! (.artifact self))
      (CheckedEntry :function (.function self)
                    :artifact (.artifact self)
                    :owner (.owner self)))))

(impl Drop CheckedEntry
  (drop [(self (mut CheckedEntry))] (-> void)
    (heap/artifact-release! (.owner self) (.artifact self))))

(defn checked-lease-noop [(state (ptr i8))] (-> i64) 0)
(defn checked-lease [(a (dyn Allocator))] (-> AllocatorLease)
  (unsafe-allocator-lease-new a (p/cast (ptr i8) 0)
    (p/fnptr-of checked-lease-noop) (p/fnptr-of checked-lease-noop)))

(defstruct CheckedBase
  [(refs i64) (a (dyn Allocator))
   (entries (PMap (slice u8) CheckedEntry))
   (roots (PMap res/ResKey CheckedRoot))
   ; Names in the compiler-phase closure. ResKey owns each inserted spelling;
   ; derived revisions share unchanged trie paths and therefore the bytes too.
   (phase (PMap res/ResKey i64))
   (phase_constants (PMap res/ResKey i64))])

(defn checked-no-base [] (-> (ptr CheckedBase))
  (p/cast (ptr CheckedBase) 0))

(defn checked-base-new [(a (dyn Allocator))] (-> (ptr CheckedBase))
  (let [base (box! a CheckedBase (p/zeroed CheckedBase))]
    (set! (.refs base) 1)
    (set! (.a base) a)
    (set! (.entries base)
      (pm-new [(slice u8) CheckedEntry] (checked-lease a) (str-keyops-borrowed)))
    (set! (.roots base)
      (pm-new [res/ResKey CheckedRoot] (checked-lease a) (res/res-keyops)))
    (set! (.phase base)
      (pm-new [res/ResKey i64] (checked-lease a) (res/res-keyops)))
    (set! (.phase_constants base)
      (pm-new [res/ResKey i64] (checked-lease a) (res/res-keyops)))
    base))

(defn checked-base-derive [(a (dyn Allocator)) (parent (ptr CheckedBase))]
  (-> (ptr CheckedBase))
  (if (= parent (checked-no-base))
    (checked-base-new a)
    (let [base (box! a CheckedBase (p/zeroed CheckedBase))]
      (set! (.refs base) 1)
      (set! (.a base) a)
      (set! (.entries base)
        (pm-clone-at [(PMap (slice u8) CheckedEntry)] (field parent entries)))
      (set! (.roots base)
        (pm-clone-at [(PMap res/ResKey CheckedRoot)] (field parent roots)))
      (set! (.phase base)
        (pm-clone-at [(PMap res/ResKey i64)] (field parent phase)))
      (set! (.phase_constants base)
        (pm-clone-at [(PMap res/ResKey i64)] (field parent phase_constants)))
      base)))

(defn checked-base-release! [(base (ptr CheckedBase))] (-> i64)
  (unless (= base (checked-no-base))
    (let [remaining (- (.refs base) 1)]
      (set! (.refs base) remaining)
      (when (= remaining 0)
        (let [entries (take! [(PMap (slice u8) CheckedEntry)] (field base entries))] 0)
        (let [roots (take! [(PMap res/ResKey CheckedRoot)] (field base roots))] 0)
        (let [phase (take! [(PMap res/ResKey i64)] (field base phase))] 0)
        (let [constants
                (take! [(PMap res/ResKey i64)] (field base phase_constants))] 0)
        (free [CheckedBase] (.a base) (slice-new base 1))
        0))
    0)
  0)

(defn checked-base-get [(base (ptr CheckedBase)) (name (slice u8))]
  (-> (Option (ptr Func)))
  (if (= base (checked-no-base))
    (None [(ptr Func)])
    (match (pm-get-ptr (field base entries) name)
      (None [] (None [(ptr Func)]))
      (Some [entry] (Some (.function entry))))))

(defn checked-base-put! [(base (ptr CheckedBase)) (owner (ptr heap/Heap))
                         (function (ptr Func)) (artifact (ptr heap/Artifact))] (-> i64)
  (assert (!= (p/cast i64 artifact) 0))
  (heap/artifact-retain! artifact)
  (pm-assoc! (mut (.entries base)) (.name function)
    (CheckedEntry :function function :artifact artifact :owner owner)))

(defn checked-base-remove! [(base (ptr CheckedBase)) (name (slice u8))] (-> i64)
  (if (= base (checked-no-base)) 0
    (pm-dissoc! (mut (.entries base)) name)))

(defn checked-base-count [(base (ptr CheckedBase))] (-> i64)
  (if (= base (checked-no-base)) 0 (pm-len (field base entries))))

(defn checked-base-root-count [(base (ptr CheckedBase))] (-> i64)
  (if (= base (checked-no-base)) 0 (pm-len (field base roots))))

(defn checked-base-root-version [(base (ptr CheckedBase)) (slot (slice u8))]
  (-> i64)
  (if (= base (checked-no-base)) 0
    (match (pm-get-ptr (field base roots)
             (res/ResKey :module "" :raw slot
                         :owner (p/cast (ptr res/ResOwner) 0)))
      (None [] 0)
      (Some [root] (.version root)))))

(defn checked-base-root-put! [(base (ptr CheckedBase))
                              (slot (slice u8))
                              (name (slice u8))
                              (version i64)] (-> i64)
  (unless (= base (checked-no-base))
    (let [prior (checked-base-root-version base slot)]
      (when (> version prior)
        (let [owner (res/res-owner-new (.a base))
              oa (scratch/scratch-allocator (field owner arena))
              slot-key (res/ResKey :module "" :raw (res/res-own-bytes oa slot)
                         :owner owner)
              name-key (res/ResKey :module "" :raw (res/res-own-bytes oa name)
                         :owner owner)]
          ; One owner reference for the map key and one for the value's name.
          (set! (.refs owner) (+ (.refs owner) 2))
          (pm-assoc! (mut (.roots base)) slot-key
            (CheckedRoot :name name-key :version version))
          (res/res-owner-done! owner))
        0))
    0)
  0)

(defn checked-base-root-records! [(base (ptr CheckedBase))
                                  (out (mut (ArrayList CheckedRootRecord)))] (-> i64)
  (unless (= base (checked-no-base))
    (let [(mut it) (pm-iter (field base roots))]
      (loop (match (next (mut it))
        (None [] (break))
        (Some [entry]
          (push! (mut out)
            (CheckedRootRecord :slot (.raw (.key entry))
                               :name (.raw (.name (.val entry)))
                               :version (.version (.val entry))))))))
    0)
  0)

(defn checked-base-functions! [(base (ptr CheckedBase))
                               (out (mut (ArrayList Func)))] (-> i64)
  (unless (= base (checked-no-base))
    (let [(mut it) (pm-iter (field base entries))]
      (loop (match (next (mut it))
        (None [] (break))
        (Some [entry] (push! (mut out) (load (.function (.val entry))))))))
    0)
  0)

(defn checked-base-generic-functions! [(base (ptr CheckedBase))
                                       (out (mut (ArrayList Func)))] (-> i64)
  (unless (= base (checked-no-base))
    (let [(mut it) (pm-iter (field base entries))]
      (loop (match (next (mut it))
        (None [] (break))
        (Some [entry]
          (let [function (.function (.val entry))]
            (when (> (len (load (.type_params function))) 0)
              (push! (mut out) (load function)) 0))))))
    0)
  0)

(defn checked-base-mark-liveness! [(base (ptr CheckedBase))
                                   (g (ptr graph/Graph))] (-> i64)
  (unless (= base (checked-no-base))
    (let [(mut it) (pm-iter (field base entries))]
      (loop (match (next (mut it))
        (None [] (break))
        (Some [entry] (graph/graph-mark-artifact! g (.artifact (.val entry)))))))
    0)
  0)

(defn checked-phase-name? [(names (ref (ArrayList (slice u8))))
                           (name (slice u8))] (-> bool)
  (block :found
    (for [i 0 (len names)]
      (when (= (get names i) name) (break :found true)))
    false))

;;; Replace phase membership by a path-sharing delta. New keys own their bytes in
;;; one ref-counted arena; unchanged paths retain the prior revision's keys.
(defn checked-base-phase-replace! [(base (ptr CheckedBase))
                                   (names (ref (ArrayList (slice u8))))] (-> i64)
  (unless (= base (checked-no-base))
    (let [(mut old) (al-new [(slice u8)] (.a base))
          (mut it) (pm-iter (field base phase))
          owner (res/res-owner-new (.a base))
          oa (scratch/scratch-allocator (field owner arena))]
      (loop (match (next (mut it))
        (None [] (break))
        (Some [entry] (push! (mut old) (.raw (.key entry))))))
      (for [i 0 (len old)]
        (let [name (get old i)]
          (unless (checked-phase-name? names name)
            (pm-dissoc! (mut (.phase base))
              (res/ResKey :module "" :raw name
                          :owner (p/cast (ptr res/ResOwner) 0))) 0)))
      (for [i 0 (len names)]
        (let [name (get names i)]
          (match (pm-get (field base phase)
                   (res/ResKey :module "" :raw name
                               :owner (p/cast (ptr res/ResOwner) 0)))
            (Some [_] 0)
            (None []
              (let [key (res/ResKey :module "" :raw (res/res-own-bytes oa name)
                                     :owner owner)]
                (set! (.refs owner) (+ (.refs owner) 1))
                (pm-assoc! (mut (.phase base)) key 0))))))
      (res/res-owner-done! owner)
      (al-free! (mut old)))
    0)
  0)

(defn checked-base-phase-functions! [(base (ptr CheckedBase))
                                     (out (mut (ArrayList Func)))] (-> i64)
  (unless (= base (checked-no-base))
    (let [(mut it) (pm-iter (field base phase))]
      (loop (match (next (mut it))
        (None [] (break))
        (Some [entry]
          (match (checked-base-get base (.raw (.key entry)))
            (None [] 0)
            (Some [function] (push! (mut out) (load function))))))))
    0)
  0)

(defn checked-base-phase-constants-replace!
  [(base (ptr CheckedBase)) (names (ref (ArrayList (slice u8))))
   (constants (ptr (ArrayList Const)))] (-> i64)
  (unless (= base (checked-no-base))
    (let [(mut old) (al-new [(slice u8)] (.a base))
          (mut it) (pm-iter (field base phase_constants))
          owner (res/res-owner-new (.a base))
          oa (scratch/scratch-allocator (field owner arena))]
      (loop (match (next (mut it))
        (None [] (break))
        (Some [entry] (push! (mut old) (.raw (.key entry))))))
      (for [i 0 (len old)]
        (let [name (get old i)]
          (unless (checked-phase-name? names name)
            (pm-dissoc! (mut (.phase_constants base))
              (res/ResKey :module "" :raw name
                          :owner (p/cast (ptr res/ResOwner) 0))) 0)))
      (for [i 0 (len names)]
        (let [name (get names i)]
          (let [(mut index) -1]
            (for [j 0 (len (load constants))]
              (when (= (.name (al-elem [Const] constants j)) name)
                (set! index j)))
            (when (>= (load index) 0)
              (let [key (res/ResKey :module "" :raw (res/res-own-bytes oa name)
                                     :owner owner)]
                (set! (.refs owner) (+ (.refs owner) 1))
                (pm-assoc! (mut (.phase_constants base)) key (load index))) 0))))
      (res/res-owner-done! owner)
      (al-free! (mut old)))
    0)
  0)

(defn checked-base-phase-constant? [(base (ptr CheckedBase))
                                    (name (slice u8))] (-> bool)
  (if (= base (checked-no-base)) false
    (match (pm-get (field base phase_constants)
             (res/ResKey :module "" :raw name
                         :owner (p/cast (ptr res/ResOwner) 0)))
      (None [] false) (Some [_] true))))

(defn checked-base-phase-constants! [(base (ptr CheckedBase))
                                     (source (ptr (ArrayList Const)))
                                     (out (mut (ArrayList Const)))] (-> i64)
  (unless (= base (checked-no-base))
    (let [(mut it) (pm-iter (field base phase_constants))]
      (loop (match (next (mut it))
        (None [] (break))
        (Some [entry]
          (when (and (>= (.val entry) 0) (< (.val entry) (len (load source))))
            (push! (mut out) (get (load source) (.val entry))) 0)))))
    0)
  0)
