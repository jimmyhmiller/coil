;;; Precise relocation of a live compiler object graph. Generated typed visitors
;;; describe reachable byte ranges; integer-looking pointers are never scanned.
;;; Overlapping ranges are coalesced before copying, preserving interior aliases.
(module coil.compiler.retained_graph)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.slice" :use [slice-data])
(import "coil.mem" :use [mem-copy])
(import "coil.str" :use [str-find])

(defstruct GraphKey [(address i64) (kind i64)])
(defstruct GraphRange [(lo i64) (hi i64) (alignment i64) (offset i64)])
(defstruct GraphVisit [(kind i64) (address i64) (fix (fnptr c [(ptr Graph) (ptr i8) (ptr i8)] i64))])
(defstruct Graph
  [(a (dyn Allocator))
   (destination (dyn Allocator))
   (seen (HashMap GraphKey i64))
   (live-nids (HashMap i64 i64))
   (live-sources (HashMap i64 i64))
   (live-contexts (HashMap i64 i64))
   (live-scopes (HashMap i64 i64))
   (weak-alias bool)
   (ranges (ArrayList GraphRange))
   (visits (ArrayList GraphVisit))
   (data (ptr i8))
   (bytes i64)
   (payload-bytes i64)])

(defn graph-key-hash [(raw (ptr i8)) (size i64)] (-> i64)
  (let [key (p/cast (ptr GraphKey) raw)]
    (p/ixor (.address key) (p/imul (.kind key) 1099511628211))))
(defn graph-key-eq [(left (ptr i8)) (right (ptr i8)) (size i64)] (-> bool)
  (let [a (p/cast (ptr GraphKey) left) b (p/cast (ptr GraphKey) right)]
    (and (= (.address a) (.address b)) (= (.kind a) (.kind b)))))
(defn graph-keyops [] (-> (ptr KeyOps))
  (let [ops (p/alloc-static KeyOps)]
    (set! (.hash ops) (p/fnptr-of graph-key-hash))
    (set! (.eq ops) (p/fnptr-of graph-key-eq))
    (set! (.size ops) (p/sizeof GraphKey))
    ops))
(defn graph-new [(a (dyn Allocator)) (destination (dyn Allocator))] (-> Graph)
  (Graph :a a :destination destination :seen (hm-new [GraphKey i64] a (graph-keyops))
    :live-nids (hm-new [i64 i64] a (i64-keyops))
    :live-sources (hm-new [i64 i64] a (i64-keyops))
    :live-contexts (hm-new [i64 i64] a (i64-keyops))
    :live-scopes (hm-new [i64 i64] a (i64-keyops)) :weak-alias false
    :ranges (al-new [GraphRange] a) :visits (al-new [GraphVisit] a)
    :data (p/cast (ptr i8) 0) :bytes 0 :payload-bytes 0))
(defn graph-range! [(g (ptr Graph)) (address i64) (bytes i64) (alignment i64)] (-> i64)
  (when (and (!= address 0) (> bytes 0))
    (push! (mut (.ranges g))
      (GraphRange :lo address :hi (+ address bytes) :alignment alignment :offset 0)) 0)
  0)
(defn graph-enter! [(g (ptr Graph)) (address i64) (bytes i64) (alignment i64)
                    (kind i64) (fix (fnptr c [(ptr Graph) (ptr i8) (ptr i8)] i64))] (-> bool)
  (if (= address 0) false
    (let [key (GraphKey :address address :kind kind)]
      (if (hm-contains? [GraphKey i64] (.seen g) key) false
        (do
          (set! (mut (.seen g)) key 0)
          (graph-range! g address bytes alignment)
          (push! (mut (.visits g)) (GraphVisit :kind kind :address address :fix fix))
          true)))))

(extern retained.qsort :cc c [(ptr i8) u64 u64 (fnptr c [(ptr i8) (ptr i8)] i32)] (-> void))
(defn graph-range-compare [(left (ptr i8)) (right (ptr i8))] (-> i32)
  (let [a (p/cast (ptr GraphRange) left) b (p/cast (ptr GraphRange) right)]
    (p/cast i32 (if (< (.lo a) (.lo b)) -1 (if (> (.lo a) (.lo b)) 1 0)))))

;;; Every pointer must have been described by a typed visitor. Null stays null.
(defn graph-address [(g (ptr Graph)) (address i64)] (-> i64)
  (block :found
    (when (= address 0) (return-from :found 0))
    (let [(mut lo) 0 (mut hi) (len (.ranges g))]
      (loop
        (if (>= (load lo) (load hi))
            (break)
            (let [mid (/ (+ (load lo) (load hi)) 2)
                  range (al-elem [GraphRange] (field g ranges) mid)]
              (if (< address (.lo range))
                  (set! hi mid)
                  (if (>= address (.hi range))
                      (set! lo (+ mid 1))
                      (return-from :found
                        (+ (p/cast i64 (.data g))
                           (+ (.offset range) (- address (.lo range)))))))))))
    (abort)
    0))

(defn graph-finish! [(g (ptr Graph))] (-> i64)
  (let [ranges (field g ranges)]
    (retained.qsort (p/cast (ptr i8) (.data ranges)) (p/cast u64 (.len ranges))
      (p/cast u64 (p/sizeof GraphRange)) (p/fnptr-of graph-range-compare))
    (let [(mut count) 0]
      (for [i 0 (.len ranges)]
        (let [current (get (load ranges) i)]
          (if (= (load count) 0)
            (do (set! (al-elem [GraphRange] ranges 0) current) (set! count 1) 0)
            (let [last (al-elem [GraphRange] ranges (- (load count) 1))]
              (if (< (.lo current) (.hi last))
                (do
                  (when (> (.hi current) (.hi last)) (set! (.hi last) (.hi current)) 0)
                  (when (> (.alignment current) (.alignment last))
                    (set! (.alignment last) (.alignment current)) 0) 0)
                (do (set! (al-elem [GraphRange] ranges (load count)) current)
                  (set! count (+ (load count) 1)) 0))))))
      (set! (.len ranges) (load count)))
    (let [(mut total) 0 (mut alignment) 1]
      (for [i 0 (.len ranges)]
        (let [r (al-elem [GraphRange] ranges i) a (.alignment r)
              gap (% (+ (- (% (.lo r) a) (% (load total) a)) a) a)]
          (set! total (+ (load total) gap))
          (set! (.offset r) (load total))
          (set! total (+ (load total) (- (.hi r) (.lo r))))
          (set! (.payload-bytes g) (+ (.payload-bytes g) (- (.hi r) (.lo r))))
          (when (> a (load alignment)) (set! alignment a) 0)))
      (set! (.bytes g) (load total))
      (when (> (load total) 0)
        (match (alloc-bytes (.destination g) (load total) (load alignment))
          (Some [bytes] (set! (.data g) (p/cast (ptr i8) (slice-data bytes))))
          (None [] (oom-at c"retained compiler graph" (load total)))) 0))
    (for [i 0 (.len ranges)]
      (let [r (al-elem [GraphRange] ranges i)]
        (mem-copy [i8] (p/index (.data g) (.offset r))
          (p/cast (ptr i8) (.lo r)) (- (.hi r) (.lo r)))))
    (for [i 0 (len (.visits g))]
      (let [visit (al-elem [GraphVisit] (field g visits) i)]
        (p/call-ptr (.fix visit) g (p/cast (ptr i8) (.address visit))
          (p/cast (ptr i8) (graph-address g (.address visit)))))))
  0)


;;; Hygiene scopes are semantic identities. Alias tables are weak references;
;;; actual syntax and resolved names determine which scopes remain reachable.
(defn graph-name-scope [(name (slice u8))] (-> i64)
  (block :scope
    ; Most names contain no `$`; skip the substring search for them.
    (let [(mut dollar) false]
      (for [i 0 (len name)]
        (when (= (p/cast i64 (get name i)) 36) (set! dollar true) (break)))
      (unless (load dollar) (return-from :scope 0)))
    (match (str-find name "$scope")
      (None [] 0)
      (Some [start]
        (if (and (> start 0) (!= (p/cast i64 (get name (- start 1))) 46)) 0
          (let [(mut value) 0 (mut at) (+ start 6)]
            (loop (if (>= (load at) (len name)) (break)
              (let [ch (p/cast i64 (get name (load at)))]
                (when (= ch 64) (return-from :scope (load value)))
                (when (or (< ch 48) (> ch 57)) (return-from :scope 0))
                (set! value (+ (* (load value) 10) (- ch 48)))
                (set! at (+ (load at) 1)))))
            0))))))
(defn graph-mark-scope! [(g (ptr Graph)) (name (slice u8))] (-> i64)
  (unless (.weak-alias g)
    (let [scope (graph-name-scope name)]
      (when (> scope 0) (set! (mut (.live-scopes g)) scope 0) 0)) 0)
  0)
