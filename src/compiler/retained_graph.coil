;;; Precise relocation of a live compiler object graph. Generated typed visitors
;;; describe reachable byte ranges; integer-looking pointers are never scanned.
;;; Overlapping ranges are coalesced before copying, preserving interior aliases.
(module coil.compiler.retained_graph)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.slice" :use [slice-data slice-new slice-len])
(import "coil.mem" :use [mem-copy])
(import "coil.str" :use [str-find])
(import "coil.compiler.retained_source" :as sources)
(import "coil.compiler.retained_heap" :as heap)

(defstruct GraphKey [(address i64) (kind i64)])
(defstruct GraphRange [(lo i64) (hi i64) (alignment i64) (offset i64) (target i64) (frozen bool)])
(defstruct GraphVisit [(kind i64) (address i64) (fix (fnptr c [(ptr Graph) (ptr i8) (ptr i8)] i64))
  (walk (fnptr c [(ptr Graph) (ptr i8)] i64))])
;;; `count` records of `kind` starting at `address`, as the graph found them.
(defstruct NotedChunk [(kind i64) (address i64) (count i64)])
(defstruct Graph
  [(a (dyn Allocator))
   (destination (dyn Allocator))
   (seen (HashMap GraphKey i64))
   (live-nids (HashMap i64 i64))
   (live-sources (HashMap i64 i64))
   (live-contexts (HashMap i64 i64))
   (live-scopes (HashMap i64 i64))
   (weak-alias bool)
   (ranges (ArrayList GraphRange))
   (visits (ArrayList GraphVisit))
   (data (ptr i8))
   (bytes i64)
   (payload-bytes i64)
   (source-store (ptr sources/SourceStore))
   (source-cache (HashMap i64 (ptr sources/SourcePayload)))
   (source-owners (ArrayList (ptr sources/SourcePayload)))
   (heap (ptr heap/Heap)) (freezing bool)
   (frozen-roots (HashMap i64 i64))
   (held (HashMap i64 i64))
   (owners (ArrayList (ptr heap/Block)))
   ; Sealed closures this graph holds whole, without having walked into them.
   (artifacts (ArrayList (ptr heap/Artifact)))
   ; Runs of records this graph had to walk, to be recorded as chunks once sealed.
   (noted-chunks (ArrayList NotedChunk))
   (chunks-held i64) (chunk-records-held i64)
   ; What a walk is for. A graph that is only asked what is live needs no layout --
   ; no ranges, visits, owners or chunk notes -- and one that is only asked to lay
   ; the graph out has no use for the ids. Both are on unless the caller says so.
   (liveness bool) (layout bool)
   ; Slot arrays entered whole by `graph-name-index!`: address -> slot count.
   (slot-counts (HashMap i64 i64))])

;;; A table finds a slot from the LOW bits of this, and an address has none to speak
;;; of: allocations are sixteen-byte aligned, so the low four bits of every key were
;;; whatever the kind contributed and whole runs of nodes fell into the same slots.
;;; The visited table is probed for every record and pointer of every publication.
;;; Multiplying spreads the address over the word, and the fold brings its high
;;; bits, where that spread ends up, down to where the mask looks.
(defn graph-key-hash [(raw (ptr i8)) (size i64)] (-> i64)
  (let [key (p/cast (ptr GraphKey) raw)
        mixed (p/imul (p/ixor (.address key) (p/imul (.kind key) 1099511628211))
                      -7046029254386353131)]
    (p/ixor mixed
            (p/cast i64 (p/ishr (p/cast u64 mixed) (p/cast u64 29))))))
(defn graph-key-eq [(left (ptr i8)) (right (ptr i8)) (size i64)] (-> bool)
  (let [a (p/cast (ptr GraphKey) left) b (p/cast (ptr GraphKey) right)]
    (and (= (.address a) (.address b)) (= (.kind a) (.kind b)))))
(defn graph-keyops [] (-> (ptr KeyOps))
  (let [ops (p/alloc-static KeyOps)]
    (set! (.hash ops) (p/fnptr-of graph-key-hash))
    (set! (.eq ops) (p/fnptr-of graph-key-eq))
    (set! (.size ops) (p/sizeof GraphKey))
    ops))
(defn graph-new [(a (dyn Allocator)) (destination (dyn Allocator))] (-> Graph)
  (Graph :a a :destination destination :seen (hm-new [GraphKey i64] a (graph-keyops))
    :live-nids (hm-new [i64 i64] a (i64-keyops))
    :live-sources (hm-new [i64 i64] a (i64-keyops))
    :live-contexts (hm-new [i64 i64] a (i64-keyops))
    :live-scopes (hm-new [i64 i64] a (i64-keyops)) :weak-alias false
    :ranges (al-new [GraphRange] a) :visits (al-new [GraphVisit] a)
    :data (p/cast (ptr i8) 0) :bytes 0 :payload-bytes 0
    :source-store (p/cast (ptr sources/SourceStore) 0)
    :source-cache (hm-new [i64 (ptr sources/SourcePayload)] a (i64-keyops))
    :source-owners (al-new [(ptr sources/SourcePayload)] a)
    :heap (p/cast (ptr heap/Heap) 0) :freezing false
    :frozen-roots (hm-new [i64 i64] a (i64-keyops))
    :held (hm-new [i64 i64] a (i64-keyops))
    :owners (al-new [(ptr heap/Block)] a)
    :artifacts (al-new [(ptr heap/Artifact)] a)
    :noted-chunks (al-new [NotedChunk] a)
    :chunks-held 0 :chunk-records-held 0
    :liveness true :layout true
    :slot-counts (hm-new [i64 i64] a (i64-keyops))))

;;; A graph asked only what is live: `graph-finish!` must not be called on it.
(defn graph-liveness-only! [(g (ptr Graph))] (-> i64)
  (set! (.layout g) false) 0)

;;; A graph asked only to lay itself out; its live sets stay empty.
(defn graph-layout-only! [(g (ptr Graph))] (-> i64)
  (set! (.liveness g) false) 0)

(defn graph-hold! [(g (ptr Graph)) (item (ptr heap/Block))] (-> i64)
  (let [key (p/cast i64 item)]
    (unless (hm-contains? (.held g) key)
      (set! (mut (.held g)) key 0)
      (push! (mut (.owners g)) item) 0))
  0)

;;; Mark live everything `item` and its parts carry, as walking them would have.
(defn graph-mark-artifact! [(g (ptr Graph)) (item (ptr heap/Artifact))] (-> i64)
  (let [key (p/cast i64 item)]
    (unless (hm-contains? (.held g) key)
      (set! (mut (.held g)) key 0)
      ; An artifact holds its parts itself, so they matter here only for their ids.
      (when (.liveness g)
        (for [i 0 (len (.nids item))] (set! (mut (.live-nids g)) (get (.nids item) i) 0))
        (for [i 0 (len (.sources item))] (set! (mut (.live-sources g)) (get (.sources item) i) 0))
        (for [i 0 (len (.contexts item))] (set! (mut (.live-contexts g)) (get (.contexts item) i) 0))
        (for [i 0 (len (.scopes item))] (set! (mut (.live-scopes g)) (get (.scopes item) i) 0))
        (for [i 0 (len (.parts item))] (graph-mark-artifact! g (get (.parts item) i)))
        0)
      0))
  0)

;;; Hold `item` whole: an artifact is immutable, so what a walk would find in it
;;; cannot have changed since it was recorded. Only the outermost artifact is
;;; listed as held; it holds its parts itself.
(defn graph-hold-artifact! [(g (ptr Graph)) (item (ptr heap/Artifact))] (-> i64)
  (unless (hm-contains? (.held g) (p/cast i64 item))
    (push! (mut (.artifacts g)) item)
    (graph-mark-artifact! g item)
    0)
  0)

;;; If the closure rooted at `address` is a registered artifact, hold it instead of
;;; walking into it. Returns whether it was: the caller then does not descend.
(defn graph-enter-artifact! [(g (ptr Graph)) (address i64)] (-> bool)
  (let [item (heap/find-artifact (.heap g) address)]
    (if (= (p/cast i64 item) 0)
      false
      (do (graph-hold-artifact! g item) true))))

;;; If the `count` records of `kind` at `first` are, field for field, a run that was
;;; sealed and recorded before, hold that chunk instead of walking them. `identify`
;;; spells the records out. Identical spelling means identical pointers, and every
;;; pointer in a recorded chunk leads into sealed storage the chunk holds, so the
;;; records can be copied as they are, with nothing to relocate and nothing to find.
(defn graph-chunk-held? [(g (ptr Graph)) (kind i64) (first (ptr i8)) (count i64)
                         (identify (fnptr c [(ptr (ArrayList i64)) (ptr i8) i64] i64))] (-> bool)
  (if (= (p/cast i64 (.heap g)) 0)
    false
    (let [identity (p/alloc-stack (ArrayList i64))]
      (set! identity (al-new [i64] (.a g)))
      (p/call-ptr identify identity first count)
      (let [item (heap/find-chunk (.heap g) kind identity)]
        (al-free! identity)
        (if (= (p/cast i64 item) 0)
          false
          (do
            (graph-hold-artifact! g item)
            (set! (.chunks-held g) (+ (.chunks-held g) 1))
            (set! (.chunk-records-held g) (+ (.chunk-records-held g) count))
            true))))))

(defn graph-note-chunk! [(g (ptr Graph)) (kind i64) (address i64) (count i64)] (-> i64)
  (unless (or (= (p/cast i64 (.heap g)) 0) (not (.layout g)))
    (push! (mut (.noted-chunks g)) (NotedChunk :kind kind :address address :count count))
    0)
  0)

;;; The caller takes source-owners after graph-finish!, and releases that list
;;; when the destination snapshot retires. Marking never acquires ownership.
(defn graph-share-sources! [(g (ptr Graph)) (store (ptr sources/SourceStore))] (-> i64)
  (assert (= (len (.source-owners g)) 0))
  (set! (.source-store g) store)
  (set! (.source-owners g) (al-new [(ptr sources/SourcePayload)] (.a store)))
  0)
(defn graph-source! [(g (ptr Graph)) (name (slice u8)) (text (slice u8))
                     (lines (ptr (ArrayList i64)))] (-> (ptr sources/SourcePayload))
  (let [key (p/cast i64 lines)]
    (match (get (.source-cache g) key)
      (Some [source] source)
      (None []
        (let [source (sources/acquire! (.source-store g) name text lines)]
          (set! (mut (.source-cache g)) key source)
          (push! (mut (.source-owners g)) source)
          source)))))
(defn graph-range! [(g (ptr Graph)) (address i64) (bytes i64) (alignment i64)] (-> i64)
  (when (and (.layout g) (and (!= address 0) (> bytes 0)))
    (let [item (heap/find-block (.heap g) address)]
      (if (= (p/cast i64 item) 0)
        (push! (mut (.ranges g))
          (GraphRange :lo address :hi (+ address bytes) :alignment alignment :offset 0
            :target 0 :frozen (.freezing g)))
        (do
          (assert (<= (+ address bytes) (+ (p/cast i64 (.data item)) (.bytes item))))
          (graph-hold! g item)))) 0)
  0)
(defn graph-enter-typed! [(g (ptr Graph)) (address i64) (bytes i64) (alignment i64)
                    (kind i64) (fix (fnptr c [(ptr Graph) (ptr i8) (ptr i8)] i64))
                    (walk (fnptr c [(ptr Graph) (ptr i8)] i64))] (-> bool)
  (if (= address 0) false
    (let [key (GraphKey :address address :kind kind)
          ; One entry per typed node: 1 is visited, 2 is visited as immutable.
          ; Upgrading 1 -> 2 must walk again to promote its pointer closure.
          state (match (get (.seen g) key) (Some [value] value) (None [] 0))]
      (if (or (= state 2) (and (= state 1) (not (.freezing g)))) false
        (do
          (set! (mut (.seen g)) key (if (.freezing g) 2 1))
          (graph-range! g address bytes alignment)
          (when (and (.layout g)
                     (and (= state 0) (= (p/cast i64 (heap/find-block (.heap g) address)) 0)))
            (push! (mut (.visits g)) (GraphVisit :kind kind :address address :fix fix :walk walk)) 0)
          true)))))
;;; ---- name indexes ---------------------------------------------------------------
;;; A table from a declaration's name to its place in a list, whose keys are BORROWED:
;;; each is the very name held by the record it indexes, so its bytes are reached, and
;;; placed, through that record. Walking such a table slot by slot found nothing the
;;; records had not already found, and at one visited-table entry per slot it was half
;;; of all the records a publication of a large program touched. So the slot array is
;;; entered as ONE node, and its keys are pointed at their new places when it is copied.
;;; A key whose bytes no record reached is a broken invariant, and `graph-address`
;;; aborts on it rather than publish a dangling name.
(defn graph-name-index-kind [] (-> i64) 1000001)

(defn graph-name-index-fix [(g (ptr Graph)) (from (ptr i8)) (to (ptr i8))] (-> i64)
  (let [count (match (get (.slot-counts g) (p/cast i64 from)) (Some [n] n) (None [] (do (abort) 0)))
        source (p/cast (ptr (Entry (slice u8) i64)) from)
        target (p/cast (ptr (Entry (slice u8) i64)) to)]
    (for [i 0 count]
      (let [slot (p/index source i)
            out (p/index target i)]
        (set! out (load slot))
        (when (and (= (.state slot) 1) (> (slice-len (.key slot)) 0))
          (set! (.key out)
                (slice-new (p/cast (ptr u8)
                                   (graph-address g (p/cast i64 (slice-data (.key slot)))))
                           (slice-len (.key slot))))
          0))))
  0)

(defn graph-name-index! [(g (ptr Graph)) (slots (ptr (Entry (slice u8) i64))) (cap i64)] (-> i64)
  (when (and (> cap 0) (!= (p/cast i64 slots) 0))
    (set! (mut (.slot-counts g)) (p/cast i64 slots) cap)
    (graph-enter! g
                  (p/cast i64 slots)
                  (* cap (p/sizeof (Entry (slice u8) i64)))
                  (p/alignof (Entry (slice u8) i64))
                  (graph-name-index-kind)
                  (p/fnptr-of graph-name-index-fix))
    0)
  0)

(defn graph-untyped-walk [(g (ptr Graph)) (node (ptr i8))] (-> i64)
  ; Untyped clients may relocate graphs but must supply a walker to freeze an
  ; overlapping pointer closure. Silently omitting those edges is unsafe.
  (abort) 0)
(defn graph-enter! [(g (ptr Graph)) (address i64) (bytes i64) (alignment i64)
                    (kind i64) (fix (fnptr c [(ptr Graph) (ptr i8) (ptr i8)] i64))] (-> bool)
  (graph-enter-typed! g address bytes alignment kind fix
    (p/fnptr-of graph-untyped-walk)))

(extern retained.qsort :cc c [(ptr i8) u64 u64 (fnptr c [(ptr i8) (ptr i8)] i32)] (-> void))
(defn graph-range-compare [(left (ptr i8)) (right (ptr i8))] (-> i32)
  (let [a (p/cast (ptr GraphRange) left) b (p/cast (ptr GraphRange) right)]
    (p/cast i32 (if (< (.lo a) (.lo b)) -1 (if (> (.lo a) (.lo b)) 1 0)))))

;;; Where `address` lives once the graph is finished, or 0 if nothing the graph
;;; walked contains it.
(defn graph-try-address [(g (ptr Graph)) (address i64)] (-> i64)
  (block :found
    (when (= address 0) (return-from :found 0))
    (unless (= (p/cast i64 (heap/find-block (.heap g) address)) 0)
      (return-from :found address))
    (let [r (graph-containing-range g address)]
      (if (= (p/cast i64 r) 0)
          0
          (+ (.target r) (- address (.lo r)))))))

;;; Every pointer must have been described by a typed visitor. Null stays null.
(defn graph-address [(g (ptr Graph)) (address i64)] (-> i64)
  (block :found
    (when (= address 0) (return-from :found 0))
    (unless (= (p/cast i64 (heap/find-block (.heap g) address)) 0)
      (return-from :found address))
    (let [(mut lo) 0 (mut hi) (len (.ranges g))]
      (loop
        (if (>= (load lo) (load hi))
            (break)
            (let [mid (/ (+ (load lo) (load hi)) 2)
                  range (al-elem [GraphRange] (field g ranges) mid)]
              (if (< address (.lo range))
                  (set! hi mid)
                  (if (>= address (.hi range))
                      (set! lo (+ mid 1))
                      (return-from :found
                        (+ (.target range) (- address (.lo range))))))))))
    (abort)
    0))

(defn graph-coalesce! [(g (ptr Graph))] (-> i64)
  (let [ranges (field g ranges)]
    (retained.qsort (p/cast (ptr i8) (.data ranges)) (p/cast u64 (.len ranges))
      (p/cast u64 (p/sizeof GraphRange)) (p/fnptr-of graph-range-compare))
    (let [(mut count) 0]
      (for [i 0 (.len ranges)]
        (let [current (get (load ranges) i)]
          (if (= (load count) 0)
            (do (set! (al-elem [GraphRange] ranges 0) current) (set! count 1) 0)
            (let [last (al-elem [GraphRange] ranges (- (load count) 1))]
              (if (< (.lo current) (.hi last))
                (do
                  (set! (.frozen last) (or (.frozen last) (.frozen current)))
                  (when (> (.hi current) (.hi last)) (set! (.hi last) (.hi current)) 0)
                  (when (> (.alignment current) (.alignment last))
                    (set! (.alignment last) (.alignment current)) 0) 0)
                (do (set! (al-elem [GraphRange] ranges (load count)) current)
                  (set! count (+ (load count) 1)) 0))))))
      (set! (.len ranges) (load count))))
  0)

(defn graph-containing-range [(g (ptr Graph)) (address i64)] (-> (ptr GraphRange))
  (block :found
    (let [(mut lo) 0 (mut hi) (len (.ranges g))]
      (loop
        (when (>= (load lo) (load hi)) (break))
        (let [mid (/ (+ (load lo) (load hi)) 2)
              r (al-elem [GraphRange] (field g ranges) mid)]
          (cond (< address (.lo r)) (set! hi mid)
                (>= address (.hi r)) (set! lo (+ mid 1))
                :else (return-from :found r)))))
    (p/cast (ptr GraphRange) 0)))

;;; Overlapping typed ranges can expose more fields than the original body
;;; pointer. Promote their entire pointer closure before allocating anything.
(defn graph-freeze-closure! [(g (ptr Graph))] (-> i64)
  (loop
    (graph-coalesce! g)
    (let [(mut pending) (al-new [GraphVisit] (.a g))]
      (for [i 0 (len (.visits g))]
        (let [visit (get (.visits g) i)
              r (graph-containing-range g (.address visit))]
          (when (and (!= (p/cast i64 r) 0) (.frozen r))
            (unless (= (match (get (.seen g)
              (GraphKey :address (.address visit) :kind (.kind visit)))
                (Some [state] state) (None [] 0)) 2)
              (push! (mut pending) visit) 0))))
      (when (= (len (load pending)) 0) (break))
      (set! (.freezing g) true)
      (for [i 0 (len (load pending))]
        (let [visit (get (load pending) i)]
          (p/call-ptr (.walk visit) g (p/cast (ptr i8) (.address visit)))))
      (set! (.freezing g) false)))
  0)

(defn graph-finish! [(g (ptr Graph))] (-> i64)
  ; A graph that recorded no layout has nothing to finish, and would "relocate" an
  ; empty graph over whatever its caller then reads.
  (unless (.layout g) (abort) 0)
  (graph-freeze-closure! g)
  (let [ranges (field g ranges)]
    ; Everything this graph seals goes into ONE block, laid out like the snapshot
    ; beside it: each range keeps its residue against its own alignment, in a block
    ; aligned to the largest. A block per range made tens of thousands of tiny
    ; blocks, some forty to a page, and "which block holds this address" -- asked
    ; for every range, every visit and every pointer fixed -- walks a page's chain.
    (let [(mut total) 0 (mut alignment) 1
          (mut sealed) 0 (mut sealed-alignment) 1 (mut sealed-payload) 0]
      (for [i 0 (.len ranges)]
        (let [r (al-elem [GraphRange] ranges i) a (.alignment r)]
          (if (.frozen r)
            (let [gap (% (+ (- (% (.lo r) a) (% (load sealed) a)) a) a)]
              (set! sealed (+ (load sealed) gap))
              (set! (.offset r) (load sealed))
              (set! sealed (+ (load sealed) (- (.hi r) (.lo r))))
              (set! sealed-payload (+ (load sealed-payload) (- (.hi r) (.lo r))))
              (when (> a (load sealed-alignment)) (set! sealed-alignment a) 0))
            (let [gap (% (+ (- (% (.lo r) a) (% (load total) a)) a) a)]
              (set! total (+ (load total) gap))
              (set! (.offset r) (load total))
              (set! total (+ (load total) (- (.hi r) (.lo r))))
              (when (> a (load alignment)) (set! alignment a) 0)))
          (set! (.payload-bytes g) (+ (.payload-bytes g) (- (.hi r) (.lo r))))))
      (set! (.bytes g) (load total))
      (when (> (load total) 0)
        (match (alloc-bytes (.destination g) (load total) (load alignment))
          (Some [bytes] (set! (.data g) (p/cast (ptr i8) (slice-data bytes))))
          (None [] (oom-at c"retained compiler graph" (load total)))) 0)
      (when (> (load sealed) 0)
        (let [item (heap/allocate-packed-block! (.heap g) (load sealed) (load sealed-alignment) 0
                                                (load sealed-payload))
              base (p/cast i64 (.data item))]
          (graph-hold! g item)
          (for [i 0 (.len ranges)]
            (let [r (al-elem [GraphRange] ranges i)]
              (when (.frozen r) (set! (.target r) (+ base (.offset r))) 0))))
        0))
    (for [i 0 (.len ranges)]
      (let [r (al-elem [GraphRange] ranges i)]
        (unless (.frozen r) (set! (.target r) (+ (p/cast i64 (.data g)) (.offset r))) 0)
        (mem-copy [i8] (p/cast (ptr i8) (.target r))
          (p/cast (ptr i8) (.lo r)) (- (.hi r) (.lo r)))))
    (for [i 0 (len (.visits g))]
      (let [visit (al-elem [GraphVisit] (field g visits) i)
            target (graph-address g (.address visit)) destination (.destination g)]
        (unless (= (p/cast i64 (heap/find-block (.heap g) target)) 0)
          (set! (.destination g) (.a (.heap g))) 0)
        (p/call-ptr (.fix visit) g (p/cast (ptr i8) (.address visit))
          (p/cast (ptr i8) target))
        (set! (.destination g) destination))))
  (unless (= (p/cast i64 (.heap g)) 0)
    (let [(mut owners) (al-new [(ptr heap/Block)] (.a (.heap g)))]
      (for [i 0 (len (.owners g))]
        (let [item (get (.owners g) i)]
          (heap/retain! item)
          (push! (mut owners) item)))
      (set! (.owners g) (load owners)))
    (let [(mut holders) (al-new [(ptr heap/Artifact)] (.a (.heap g)))]
      (for [i 0 (len (.artifacts g))]
        (let [item (get (.artifacts g) i)]
          (heap/artifact-retain! item)
          (push! (mut holders) item)))
      (set! (.artifacts g) (load holders)))
    ; Fixups were the last writes any new block will ever receive.
    (heap/seal-all! (.heap g)) 0)
  0)


;;; Hygiene scopes are semantic identities. Alias tables are weak references;
;;; actual syntax and resolved names determine which scopes remain reachable.
(defn graph-name-scope [(name (slice u8))] (-> i64)
  (block :scope
    ; Most names contain no `$`; skip the substring search for them.
    (let [(mut dollar) false]
      (for [i 0 (len name)]
        (when (= (p/cast i64 (get name i)) 36) (set! dollar true) (break)))
      (unless (load dollar) (return-from :scope 0)))
    (match (str-find name "$scope")
      (None [] 0)
      (Some [start]
        (if (and (> start 0) (!= (p/cast i64 (get name (- start 1))) 46)) 0
          (let [(mut value) 0 (mut at) (+ start 6)]
            (loop (if (>= (load at) (len name)) (break)
              (let [ch (p/cast i64 (get name (load at)))]
                (when (= ch 64) (return-from :scope (load value)))
                (when (or (< ch 48) (> ch 57)) (return-from :scope 0))
                (set! value (+ (* (load value) 10) (- ch 48)))
                (set! at (+ (load at) 1)))))
            0))))))
(defn graph-mark-scope! [(g (ptr Graph)) (name (slice u8))] (-> i64)
  (unless (or (.weak-alias g) (not (.liveness g)))
    (let [scope (graph-name-scope name)]
      (when (> scope 0) (set! (mut (.live-scopes g)) scope 0) 0)) 0)
  0)

;;; Record the sealed closure rooted at `address` as an artifact, by walking it
;;; once with `scan`. Every range it reaches must already be in a block: the
;;; closure was sealed by a finished graph. Returns the artifact, unheld.
(defn graph-record-artifact! [(heap (ptr heap/Heap)) (scratch (dyn Allocator)) (address i64)
                              (scan (fnptr c [(ptr Graph) (ptr i8)] i64))] (-> (ptr heap/Artifact))
  (let [durable (.a heap)
        g (box! scratch Graph (graph-new scratch scratch))
        (mut nids) (al-new [i64] durable) (mut sources) (al-new [i64] durable)
        (mut contexts) (al-new [i64] durable) (mut scopes) (al-new [i64] durable)]
    (set! (.heap g) heap)
    (set! (.freezing g) true)
    (p/call-ptr scan g (p/cast (ptr i8) address))
    (unless (= (len (.ranges g)) 0)
      ; A sealed closure that reaches unsealed memory would outlive it.
      (abort) 0)
    (for [i 0 (.cap (.live-nids g))]
      (let [e (p/index (.slots (.live-nids g)) i)] (when (= (.state e) 1) (push! (mut nids) (.key e)) 0)))
    (for [i 0 (.cap (.live-sources g))]
      (let [e (p/index (.slots (.live-sources g)) i)] (when (= (.state e) 1) (push! (mut sources) (.key e)) 0)))
    (for [i 0 (.cap (.live-contexts g))]
      (let [e (p/index (.slots (.live-contexts g)) i)] (when (= (.state e) 1) (push! (mut contexts) (.key e)) 0)))
    (for [i 0 (.cap (.live-scopes g))]
      (let [e (p/index (.slots (.live-scopes g)) i)] (when (= (.state e) 1) (push! (mut scopes) (.key e)) 0)))
    (heap/artifact-new! heap address (.owners g) (.artifacts g)
                        (load nids) (load sources) (load contexts) (load scopes))))

;;; Record the `count` sealed records of `kind` at `first` as a chunk, by walking
;;; each one's fields with `walk`. Returns null, recording nothing, if any of them
;;; still reaches unsealed memory: such a run is simply walked again next time.
(defn graph-record-chunk! [(heap (ptr heap/Heap)) (scratch (dyn Allocator)) (kind i64)
                           (first (ptr i8)) (count i64) (stride i64)
                           (walk (fnptr c [(ptr Graph) (ptr i8)] i64))
                           (identify (fnptr c [(ptr (ArrayList i64)) (ptr i8) i64] i64))]
  (-> (ptr heap/Artifact))
  (let [durable (.a heap)
        g (box! scratch Graph (graph-new scratch scratch))]
    (set! (.heap g) heap)
    (set! (.freezing g) true)
    (for [i 0 count]
      (p/call-ptr walk g (p/cast (ptr i8) (+ (p/cast i64 first) (* i stride)))))
    (if (!= (len (.ranges g)) 0)
      (p/cast (ptr heap/Artifact) 0)
      (let [(mut nids) (al-new [i64] durable) (mut sources) (al-new [i64] durable)
            (mut contexts) (al-new [i64] durable) (mut scopes) (al-new [i64] durable)
            identity (p/alloc-stack (ArrayList i64))]
        (set! identity (al-new [i64] scratch))
        (for [i 0 (.cap (.live-nids g))]
          (let [e (p/index (.slots (.live-nids g)) i)] (when (= (.state e) 1) (push! (mut nids) (.key e)) 0)))
        (for [i 0 (.cap (.live-sources g))]
          (let [e (p/index (.slots (.live-sources g)) i)] (when (= (.state e) 1) (push! (mut sources) (.key e)) 0)))
        (for [i 0 (.cap (.live-contexts g))]
          (let [e (p/index (.slots (.live-contexts g)) i)] (when (= (.state e) 1) (push! (mut contexts) (.key e)) 0)))
        (for [i 0 (.cap (.live-scopes g))]
          (let [e (p/index (.slots (.live-scopes g)) i)] (when (= (.state e) 1) (push! (mut scopes) (.key e)) 0)))
        (p/call-ptr identify identity first count)
        (let [item (heap/artifact-new! heap 0 (.owners g) (.artifacts g)
                                       (load nids) (load sources) (load contexts) (load scopes))]
          (heap/chunk-register! heap item kind identity)
          item)))))
