; Is this namespace admitted by the allocation/environment-free profile?
(defn stdlib-hermetic-namespace? [(name (slice u8))] (-> bool)
  (cond (= name "coil.assert.hermetic") true
        (= name "coil.async") true
        (= name "coil.atomic") true
        (= name "coil.control") true
        (= name "coil.derive") true
