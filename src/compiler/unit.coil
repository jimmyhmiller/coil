(module coil.compiler.unit)

;;; The interface of a prebuilt unit.
;;;
;;; A unit is a module compiled ahead of time by `coil build-unit`. Consumers do
;;; not read its source; they read an INTERFACE that stands in for it: the
;;; module's types, every concrete function as a `declare` whose definition the
;;; unit's object supplies, and every generic function and macro as source,
;;; because a generic is instantiated wherever it is used and has no single
;;; definition to link. The interface is ordinary Coil, so it travels the same
;;; path as any other module and needs no second reader.
;;;
;;; Concrete records and declarations are printed from the CHECKED program with
;;; every type fully qualified, so they need no alias from the module's own
;;; imports; the interface then imports exactly the modules those types live
;;; in. A form copied as source keeps the aliases it was written with, so a unit
;;; that copies any source form also copies all of the module's imports.

(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use [sx-tag sx-sval sx-items sx-at sx-len sconcat sconcat3 i64->str])
(import "coil.compiler.loader" :use [l-list-head])
(import "coil.compiler.resolve" :use [ty-str])
(import "coil.compiler.check" :use [last-component])

(export unit-interface-render unit-module-of-name unit-concrete-function?)

;; The module a qualified name belongs to: everything before its last `.`, or
;; "" for a name with no module (a primitive type, a type parameter).
(defn unit-module-of-name [(name (slice u8))] (-> (slice u8))
  (let [n (len name)
        (mut cut) -1]
    (for [i 0 n]
      (when (= (primitive/cast i64 (get name i)) (primitive/cast i64 46))
        (set! cut i)
        0)
      0)
    (if (< (load cut) 0) "" (subslice name 0 (load cut)))))

(defn unit-names-add! [(names (mut (ArrayList (slice u8)))) (name (slice u8))] (-> i64)
  (let [(mut seen) false]
    (for [i 0 (len names)]
      (when (= (get names i) name) (set! seen true) 0)
      0)
    (unless (load seen) (push! (mut names) name) 0)
    0))

(defn unit-names-has? [(names (mut (ArrayList (slice u8)))) (name (slice u8))] (-> bool)
  (let [(mut seen) false]
    (for [i 0 (len names)]
      (when (= (get names i) name) (set! seen true) 0)
      0)
    (load seen)))

;; Collect the modules a type mentions, so the interface can import them.
(defn unit-type-modules! [(t (ptr Type)) (ns (slice u8)) (out (mut (ArrayList (slice u8))))] (-> i64)
  (match (load t)
    (TStruct [name]
             (let [m (unit-module-of-name name)]
               (unless (or (= m "") (= m ns)) (unit-names-add! (mut out) m) 0)
               0))
    (TApp [name args]
          (do
            (let [m (unit-module-of-name name)]
              (unless (or (= m "") (= m ns)) (unit-names-add! (mut out) m) 0))
            (for [i 0 (len (load args))]
              (unit-type-modules! (al-elem [Type] args i) ns (mut out))
              0)
            0))
    (TPtr [inner] (unit-type-modules! inner ns (mut out)))
    (TRef [mutable inner] (unit-type-modules! inner ns (mut out)))
    (TSlice [elem] (unit-type-modules! elem ns (mut out)))
    (TArray [elem n] (unit-type-modules! elem ns (mut out)))
    (TVec [elem n] (unit-type-modules! elem ns (mut out)))
    (TFn [cc params ret]
         (do
           (for [i 0 (len (load params))]
             (unit-type-modules! (al-elem [Type] params i) ns (mut out))
             0)
           (unit-type-modules! ret ns (mut out))))
    (_ 0)))

;; A checked callable surface whose declaration a consumer can compile against
;; at run time: a macro (a `Code` signature) runs only inside the compiler and
;; is copied as source instead.
(defn unit-concrete-function? [(surface (ptr Extern))] (-> bool)
  (let [(mut runtime) (match (.ret surface) (TCode [] false) (TCodeBuilder [] false) (_ true))
        ps (load (field surface params))]
    (for [i 0 (len (load ps))]
      (match (load (al-elem [Type] ps i))
        (TCode [] (set! runtime false))
        (TCodeBuilder [] (set! runtime false))
        (_ 0))
      0)
    (load runtime)))

(defn unit-find-surface [(p (ptr Program)) (name (slice u8))] (-> (ptr Extern))
  (let [abis (load (field p function_abis))
        (mut found) (primitive/cast (ptr Extern) 0)]
    (for [i 0 (len (load abis))]
      (let [surface (al-elem [Extern] abis i)]
        (when (= (.name surface) name) (set! found surface) 0))
      0)
    (load found)))

(defn unit-find-struct [(p (ptr Program)) (name (slice u8))] (-> (ptr StructDef))
  (let [ds (load (field p structs))
        (mut found) (primitive/cast (ptr StructDef) 0)]
    (for [i 0 (len (load ds))]
      (let [d (al-elem [StructDef] ds i)]
        (when (= (.name d) name) (set! found d) 0))
      0)
    (load found)))

(defn unit-find-sum [(p (ptr Program)) (name (slice u8))] (-> (ptr SumDef))
  (let [ds (load (field p sums))
        (mut found) (primitive/cast (ptr SumDef) 0)]
    (for [i 0 (len (load ds))]
      (let [d (al-elem [SumDef] ds i)]
        (when (= (.name d) name) (set! found d) 0))
      0)
    (load found)))

(defn unit-write-fields! [(a (dyn Allocator))
                          (out (mut StrBuf))
                          (fields (ptr (ArrayList Field)))
                          (ns (slice u8))
                          (mods (mut (ArrayList (slice u8))))] (-> i64)
  (sb-push-byte! (mut out) (primitive/cast u8 91))
  (for [i 0 (len (load fields))]
    (let [fld (al-elem [Field] fields i)]
      (when (> i 0) (sb-push-byte! (mut out) (primitive/cast u8 32)) 0)
      (sb-push-byte! (mut out) (primitive/cast u8 40))
      (sb-push-str! (mut out) (.name fld))
      (sb-push-byte! (mut out) (primitive/cast u8 32))
      (sb-push-str! (mut out) (ty-str a (field fld ty)))
      (unit-type-modules! (field fld ty) ns (mut mods))
      (sb-push-byte! (mut out) (primitive/cast u8 41)))
    0)
  (sb-push-byte! (mut out) (primitive/cast u8 93))
  0)

;; The name a top-level definition form declares: `(defn NAME …)`, `(defstruct NAME …)`.
(defn unit-form-name [(f (ptr Sexp))] (-> (Option (slice u8)))
  (match (.kind f)
    (KList [items]
           (if (and (> (len (load items)) 1)
                    (= (sx-tag (get (load items) 1)) (primitive/cast i64 2)))
               (Some (sx-sval (get (load items) 1)))
               (None [(slice u8)])))
    (_ (None [(slice u8)]))))

;; `(defstruct NAME [T …] …)`: a type-parameter vector right after the name.
(defn unit-form-generic? [(f (ptr Sexp))] (-> bool)
  (match (.kind f)
    (KList [items]
           (if (> (len (load items)) 2)
               (let [second (get (load items) 2)]
                 (if (= (sx-tag second) (primitive/cast i64 7))
                     (let [inner (sx-items second)]
                       (and (> (sx-len inner) 0)
                            (= (sx-tag (sx-at inner 0)) (primitive/cast i64 2))))
                     false))
               false))
    (_ false)))

;; A form's own text, copied as written.
(defn unit-copy-form! [(out (mut StrBuf)) (text (slice u8)) (f (ptr Sexp))] (-> i64)
  (sb-push-str! (mut out) (subslice text (.lo f) (.hi f)))
  (sb-push-byte! (mut out) (primitive/cast u8 10))
  0)

(defn unit-write-declare! [(a (dyn Allocator))
                           (out (mut StrBuf))
                           (surface (ptr Extern))
                           (leaf (slice u8))
                           (ns (slice u8))
                           (mods (mut (ArrayList (slice u8))))] (-> i64)
  (sb-push-str! (mut out) "(declare ")
  (sb-push-str! (mut out) leaf)
  (unless (= (.cc surface) "c")
    (sb-push-str! (mut out) " :cc ")
    (sb-push-str! (mut out) (.cc surface))
    0)
  (sb-push-str! (mut out) " [")
  (let [ps (load (field surface params))]
    (for [j 0 (len (load ps))]
      (do
        (when (> j 0) (sb-push-byte! (mut out) (primitive/cast u8 32)) 0)
        (sb-push-str! (mut out) "(p")
        (sb-push-str! (mut out) (i64->str a j))
        (sb-push-byte! (mut out) (primitive/cast u8 32))
        (sb-push-str! (mut out) (ty-str a (al-elem [Type] ps j)))
        (unit-type-modules! (al-elem [Type] ps j) ns (mut mods))
        (sb-push-byte! (mut out) (primitive/cast u8 41)))
      0))
  (sb-push-str! (mut out) "] (-> ")
  (sb-push-str! (mut out) (ty-str a (field surface ret)))
  (unit-type-modules! (field surface ret) ns (mut mods))
  (sb-push-str! (mut out) "))\n")
  0)

;; Render the interface of module `ns`, whose entry file is `text` read as
;; `forms`, from the monomorphized program `p` of a build of that entry.
;; `Err` names the first thing the module does that a unit cannot express.
(defn unit-interface-render [(a (dyn Allocator))
                             (p (ptr Program))
                             (forms (ptr (ArrayList Sexp)))
                             (text (slice u8))
                             (ns (slice u8))] (-> (Result (slice u8) (slice u8)))
  (let [(mut body) (sb-new a)
        (mut imports) (sb-new a)
        (mut mods) (al-new [(slice u8)] a)
        (mut copied-names) (al-new [(slice u8)] a)
        (mut copies-source) false
        (mut err) (None [(slice u8)])
        n (len (load forms))]
    (for [i 0 n]
      (let [f (al-elem [Sexp] forms i)]
        (match (l-list-head f)
          (None [] 0)
          (Some [head]
            (cond
              (= head "module") 0
              (= head "import")
                (do (unit-copy-form! (mut imports) text f) 0)
              (= head "export")
                (do (unit-copy-form! (mut body) text f) 0)
              (or (= head "defn") (= head "declare"))
                (match (unit-form-name f)
                  (None [] 0)
                  (Some [leaf]
                    (let [surface (unit-find-surface p (sconcat3 a ns "." leaf))]
                      (if (and (= head "defn")
                               (and (!= (primitive/cast i64 surface) 0)
                                    (and (not (unit-form-generic? f))
                                         (unit-concrete-function? surface))))
                          (unit-write-declare! a (mut body) surface leaf ns (mut mods))
                          ; A generic, a macro, or a declaration the module itself
                          ; makes: source, instantiated or declared where used.
                          (do
                            (unit-copy-form! (mut body) text f)
                            (unit-names-add! (mut copied-names) leaf)
                            (set! copies-source true)
                            0)))))
              (= head "defstruct")
                (match (unit-form-name f)
                  (None [] 0)
                  (Some [leaf]
                    (let [decl (unit-find-struct p (sconcat3 a ns "." leaf))
                          standard
                            (and (!= (primitive/cast i64 decl) 0)
                                 (match (.layout decl) (LC [] true) (_ false)))]
                      (if (and standard (not (unit-form-generic? f)))
                          (do
                            (sb-push-str! (mut body) "(defstruct ")
                            (sb-push-str! (mut body) leaf)
                            (sb-push-byte! (mut body) (primitive/cast u8 32))
                            (unit-write-fields! a (mut body) (load (field decl fields)) ns (mut mods))
                            (sb-push-str! (mut body) ")\n")
                            0)
                          (do
                            (unit-copy-form! (mut body) text f)
                            (set! copies-source true)
                            0)))))
              (= head "defsum")
                (match (unit-form-name f)
                  (None [] 0)
                  (Some [leaf]
                    (let [decl (unit-find-sum p (sconcat3 a ns "." leaf))]
                      (if (and (!= (primitive/cast i64 decl) 0) (not (unit-form-generic? f)))
                          (do
                            (sb-push-str! (mut body) "(defsum ")
                            (sb-push-str! (mut body) leaf)
                            (for [j 0 (len (load (field decl variants)))]
                              (let [variant (al-elem [Variant] (load (field decl variants)) j)]
                                (sb-push-str! (mut body) " (")
                                (sb-push-str! (mut body) (last-component (.name variant)))
                                (when (> (len (load (field variant fields))) 0)
                                  (sb-push-byte! (mut body) (primitive/cast u8 32))
                                  (unit-write-fields! a (mut body) (load (field variant fields)) ns (mut mods))
                                  0)
                                (sb-push-byte! (mut body) (primitive/cast u8 41)))
                              0)
                            (sb-push-str! (mut body) ")\n")
                            0)
                          (do
                            (unit-copy-form! (mut body) text f)
                            (set! copies-source true)
                            0)))))
              (= head "def")
                (do
                  (when (match (load err) (None [] true) (_ false))
                    (set! err (Some (sconcat3 a "cannot prebuild '" ns "': a runtime `def` is module state a consumer would need to share, which a unit cannot express yet; put it behind a function")))
                    0)
                  0)
              (= head "meta")
                (do
                  (when (match (load err) (None [] true) (_ false))
                    (set! err (Some (sconcat3 a "cannot prebuild '" ns "': a `meta` generator runs at every consumer's compile and cannot be prebuilt")))
                    0)
                  0)
              (or (= head "extern")
                  (or (= head "const")
                      (or (= head "deftrait")
                          (or (= head "impl")
                              (or (= head "defcc")
                                  (or (= head "defannotation")
                                      (or (= head "static-assert")
                                          (or (= head "defdyn-marker")
                                              (= head "reader-provider")))))))))
                (do
                  (unit-copy-form! (mut body) text f)
                  (set! copies-source true)
                  0)
              ; A top-level macro call: its expansion's concrete functions are in
              ; the object and declared below by name; nothing to copy here.
              :else 0)))))
    ; Every generic or macro the checked program holds for this module must have
    ; been copied from a form of its own; one produced by a top-level macro
    ; expansion has no source to copy.
    (let [fs (load (field p funcs))]
      (for [i 0 (len (load fs))]
        (let [fp (al-elem [Func] fs i)
              name (load (field fp name))]
          (when (and (= (unit-module-of-name name) ns)
                     (and (> (len (load (load (field fp type_params)))) 0)
                          (not (unit-names-has? (mut copied-names) (last-component name)))))
            (when (match (load err) (None [] true) (_ false))
              (set! err (Some (sconcat3 a (sconcat3 a "cannot prebuild '" ns "': the generic '") name "' has no source form of its own to copy into the interface (it was produced by a macro expansion)")))
              0)
            0))
        0))
    ; Concrete functions the expansion of a top-level macro produced: declared
    ; from the checked surface like any other, since no form named them above.
    (let [abis (load (field p function_abis))]
      (for [i 0 (len (load abis))]
        (let [surface (al-elem [Extern] abis i)
              name (.name surface)
              leaf (last-component name)]
          (when (and (= (unit-module-of-name name) ns)
                     (and (unit-concrete-function? surface)
                          (and (not (unit-names-has? (mut copied-names) leaf))
                               (not (unit-declared-by-form? forms leaf)))))
            (unit-write-declare! a (mut body) surface leaf ns (mut mods))
            0))
        0))
    (match (load err)
      (Some [e] (Err [(slice u8) (slice u8)] e))
      (None []
        (let [(mut out) (sb-new a)]
          (sb-push-str! (mut out) ";; Interface of the prebuilt unit `")
          (sb-push-str! (mut out) ns)
          (sb-push-str! (mut out) "`, written by `coil build-unit`. Do not edit: the\n;; object beside it defines what is declared here, and a consumer reads this\n;; file in place of the module's source.\n(module ")
          (sb-push-str! (mut out) ns)
          (sb-push-str! (mut out) ")\n")
          (if (load copies-source)
              (sb-push-str! (mut out) (sb-str (load imports)))
              (for [i 0 (len (load mods))]
                (sb-push-str! (mut out) "(import \"")
                (sb-push-str! (mut out) (get (load mods) i))
                (sb-push-str! (mut out) "\")\n")
                0))
          (sb-push-str! (mut out) (sb-str (load body)))
          (Ok [(slice u8) (slice u8)] (sb-str (load out))))))))

;; Did a `defn`/`declare` form of the entry name this leaf? (Its declare was
;; written while walking the forms.)
(defn unit-declared-by-form? [(forms (ptr (ArrayList Sexp))) (leaf (slice u8))] (-> bool)
  (let [(mut seen) false]
    (for [i 0 (len (load forms))]
      (let [f (al-elem [Sexp] forms i)]
        (match (l-list-head f)
          (Some [head]
            (when (or (= head "defn") (= head "declare"))
              (match (unit-form-name f)
                (Some [name] (when (= name leaf) (set! seen true) 0))
                (None [] 0))
              0))
          (None [] 0)))
      0)
    (load seen)))
