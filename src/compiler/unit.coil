(module coil.compiler.unit)

;;; The interface of a prebuilt unit.
;;;
;;; A unit is a module compiled ahead of time by `coil build-unit`. Consumers do
;;; not read its source; they read an INTERFACE that stands in for it. The
;;; interface promises exactly the module's PUBLIC surface -- what its `(export
;;; …)` names, or every definition when it has no export list -- and nothing else, so a consumer never compiles the module's
;;; private helpers nor its import closure. That is the whole point: a program
;;; embedding the JIT reads a few declarations, not the hundred thousand lines of
;;; compiler behind them.
;;;
;;; The public names are read from the declaration table after expansion, so a
;;; definition the module's `meta` or macros produced is public exactly as it is
;;; from source.
;;;
;;; A public concrete function becomes a `declare`, whose definition the unit's
;;; object supplies under the same Coil ABI (a non-affine aggregate stays
;;; `ref`), its parameters keeping their names. A public runtime `def` becomes a
;;; `(declare NAME TYPE)`: the object holds its one storage and exposes it, so a
;;; consumer reads and writes the unit's copy, the copy the unit's own functions
;;; use. A C function and a calling
;;; convention are printed from the checked program as an `extern` and a `defcc`.
;;; A constant is copied as its own source and computed again by the consumer;
;;; a function its value calls is declared, and compile-time evaluation calls
;;; the unit's definition. One a metaprogram generated is printed when the
;;; checked program holds its value as a literal.
;;;
;;; A public generic or macro is copied as its own source, because it is
;;; instantiated or expanded at each use site and has no single definition to
;;; link; a private concrete helper such a copied form calls is declared too, so
;;; the consumer's instantiation can reach it. A public record or sum is printed
;;; from the checked program with every type fully qualified, so the interface
;;; imports exactly the modules its declarations mention -- not the module's own
;;; imports, unless a copied source form drags them in.
;;;
;;; Traits and impls travel too. A concrete impl -- written, derived, or produced
;;; by the module's own metaprograms -- is carried by a forwarding impl whose
;;; methods call wrappers of the unit's compiled methods, so carrying it never
;;; drags the module's imports into the interface. A generic impl or derive the
;;; module wrote is copied as source; a trait is copied when written and printed
;;; from its checked signature when generated.
;;;
;;; A re-export travels as the import that makes it: the interface carries each
;;; `(import "M" … :reexport)` as written, so the consumer's resolver passes on
;;; exactly the names (`:use`, `:exclude`, `:rename`) it would from source, and the
;;; names are M's own, the same entities a consumer importing M directly reaches.
;;; M is compiled by the consumer (from source, or as its own unit), like a module
;;; the interface's declarations name. The interface's export list names the
;;; re-exported names too, as a module's export list limits what it re-exports.
;;;
;;; Annotation keys (`defannotation`) and primitive bindings (`defprimitive`)
;;; are copied as source, as impls are.
;;;
;;; A module the interface cannot express is refused by name, never shipped
;;; narrower than its source: a `def` carrying annotations (a `declare` of
;;; storage has none to carry them), a metaprogram registration, a generated GENERIC impl (no compiled method to forward to), a
;;; generated annotation key, or a public name that is neither a function, record,
;;; sum, trait, C function nor convention nor a copyable source form (a generic or
;;; macro a `meta` produced, say).
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.cc" :as cc)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser"
        :use
        [sx-tag sx-sval sx-items sx-at sx-len sconcat sconcat3 i64->str box-al impl-base-name])
(import "coil.compiler.loader" :use [l-list-head l-as-list TaggedForm])
(import "coil.compiler.resolve" :use [ty-str])
(import "coil.compiler.check" :use [last-component])

(export unit-interface-render unit-module-of-name unit-concrete-function?
        UnitForward unit-generated-forwards unit-wrapper-source
        ; the declaration printers, shared with program_query.coil
        unit-write-declare! unit-write-struct! unit-write-sum! unit-write-trait! unit-ty-str)

;; The monomorphized program's instantiation origins, while an interface renders.
;; The interface speaks the source language: an instance a checked program wrote
;; as `(ArrayList Item)` must print that way, not as its mangled artifact name,
;; which names no module a consumer could import.
(defn unit-origins-cell [] (-> (ptr (ptr (ArrayList MonoOrigin))))
  (primitive/alloc-static (ptr (ArrayList MonoOrigin))))

;; Is NAME a monomorphized struct or sum instance?
(defn unit-mono-instance? [(name (slice u8))] (-> bool)
  (let [origins (load (unit-origins-cell))
        (mut found) false]
    (unless (= (primitive/cast i64 origins) 0)
      (for [i 0 (len (load origins))]
        (let [o (elem origins i)]
          (when (and (= (.generated o) name) (or (= (.kind o) 2) (= (.kind o) 3)))
            (set! found true)
            0))
        0)
      0)
    (load found)))

(defn unit-demono-list [(a (dyn Allocator)) (ts (ptr (ArrayList Type)))] (-> (ptr (ArrayList Type)))
  (let [(mut out) (ArrayList::new [Type] a)]
    (for [i 0 (len (load ts))]
      (push! (mut out) (load (unit-demono a (elem ts i)))))
    (box-al [Type] a (load out))))

;; `t` with every monomorphized struct or sum instance replaced by the generic
;; application it came from, found through the recorded origins.
(defn unit-demono [(a (dyn Allocator)) (t (ptr Type))] (-> (ptr Type))
  (let [origins (load (unit-origins-cell))]
    (if (= (primitive/cast i64 origins) 0)
        t
        (match (load t)
          (TStruct [name]
            (let [(mut found) (primitive/cast (ptr MonoOrigin) 0)]
              (for [i 0 (len (load origins))]
                (let [o (elem origins i)]
                  (when (and (= (.generated o) name)
                             (and (or (= (.kind o) 2) (= (.kind o) 3))
                                  (= (primitive/cast i64 (load found)) 0)))
                    (set! found o))))
              (if (= (primitive/cast i64 (load found)) 0)
                  t
                  (box! a Type (TApp (.source found) (unit-demono-list a (.args found)))))))
          (TApp [name args] (box! a Type (TApp name (unit-demono-list a args))))
          (TPtr [inner] (box! a Type (TPtr (unit-demono a inner))))
          (TRef [m inner] (box! a Type (TRef m (unit-demono a inner))))
          (TSlice [e] (box! a Type (TSlice (unit-demono a e))))
          (TArray [e n] (box! a Type (TArray (unit-demono a e) n)))
          (TVec [e n] (box! a Type (TVec (unit-demono a e) n)))
          (TFn [cc ps r] (box! a Type (TFn cc (unit-demono-list a ps) (unit-demono a r))))
          (_ t)))))

(defn unit-ty-str [(a (dyn Allocator)) (t (ptr Type))] (-> (slice u8))
  (ty-str a (unit-demono a t)))

;; The module a qualified name belongs to: everything before its last `.`, or
;; "" for a name with no module (a primitive type, a type parameter).
(defn unit-module-of-name [(name (slice u8))] (-> (slice u8))
  (let [n (len name)
        (mut cut) -1]
    (for [i 0 n]
      (when (= (primitive/cast i64 (get name i)) 46)
        (set! cut i)
        0)
      0)
    (if (< (load cut) 0) "" (subslice name 0 (load cut)))))

(defn unit-add! [(names (mut (ArrayList (slice u8)))) (name (slice u8))] (-> i64)
  (let [(mut seen) false]
    (for [i 0 (len names)]
      (when (= (get names i) name) (set! seen true) 0)
      0)
    (unless (load seen) (push! (mut names) name) 0)
    0))

(defn unit-has? [(names (mut (ArrayList (slice u8)))) (name (slice u8))] (-> bool)
  (let [(mut seen) false]
    (for [i 0 (len names)]
      (when (= (get names i) name) (set! seen true) 0)
      0)
    (load seen)))

(defn unit-i64-has? [(xs (mut (ArrayList i64))) (x i64)] (-> bool)
  (let [(mut found) false]
    (for [i 0 (len xs)] (when (= (get xs i) x) (set! found true)) 0)
    (load found)))

;; Membership in a boxed list (the public-names list is passed by pointer).
(defn unit-ptr-has? [(names (ptr (ArrayList (slice u8)))) (name (slice u8))] (-> bool)
  (let [(mut seen) false]
    (for [i 0 (len (load names))]
      (when (= (get (load names) i) name) (set! seen true) 0)
      0)
    (load seen)))

;; Modules a type mentions (for the interface's imports), and, for a type in the
;; unit's own module, the leaf whose record/sum the interface must also emit.
(defn unit-type-refs! [(t (ptr Type))
                       (ns (slice u8))
                       (mods (mut (ArrayList (slice u8))))
                       (types (mut (ArrayList (slice u8))))] (-> i64)
  (unit-type-refs-demono! (unit-demono (unit-demono-allocator) t) ns (mut mods) (mut types)))

(defn unit-demono-allocator [] (-> (dyn Allocator))
  (load (unit-demono-allocator-cell)))

(defn unit-demono-allocator-cell [] (-> (ptr (dyn Allocator)))
  (primitive/alloc-static (dyn Allocator)))

(defn unit-type-refs-demono! [(t (ptr Type))
                              (ns (slice u8))
                              (mods (mut (ArrayList (slice u8))))
                              (types (mut (ArrayList (slice u8))))] (-> i64)
  (match (load t)
    ; A type parameter a macro introduced carries a hygienic `$scope…` name; it
    ; names no module.
    (TStruct [name]
             (let [m (if (unit-hygienic-name? name) "" (unit-module-of-name name))]
               (if (= m ns)
                   (unit-add! (mut types) (last-component name))
                   (unless (= m "") (unit-add! (mut mods) m) 0))
               0))
    (TApp [name args]
          (do
            (let [m (unit-module-of-name name)]
              (if (= m ns)
                  (unit-add! (mut types) (last-component name))
                  (unless (= m "") (unit-add! (mut mods) m) 0)))
            (for [i 0 (len (load args))]
              (unit-type-refs! (elem args i)
                               ns
                               (mut mods)
                               (mut types))
              0)
            0))
    (TPtr [inner] (unit-type-refs! inner ns (mut mods) (mut types)))
    (TRef [mutable inner] (unit-type-refs! inner ns (mut mods) (mut types)))
    (TSlice [elem] (unit-type-refs! elem ns (mut mods) (mut types)))
    (TArray [elem n] (unit-type-refs! elem ns (mut mods) (mut types)))
    (TVec [elem n] (unit-type-refs! elem ns (mut mods) (mut types)))
    (TFn [cc params ret]
         (do
           (for [i 0 (len (load params))]
             (unit-type-refs! (elem params i)
                              ns
                              (mut mods)
                              (mut types))
             0)
           (unit-type-refs! ret ns (mut mods) (mut types))))
    (_ 0)))

;; A callable surface a consumer can compile against at run time: a macro (a
;; `Code` signature) runs only in the compiler and is copied as source instead.
(defn unit-concrete-function? [(surface (ptr Extern))] (-> bool)
  (let [(mut runtime)
          (match (.ret surface)
            (TCode [] false)
            (TCodeBuilder [] false)
            (_ true))
        ps (load (field surface params))]
    (for [i 0 (len (load ps))]
      (match (load (elem ps i))
        (TCode [] (set! runtime false))
        (TCodeBuilder [] (set! runtime false))
        (_ 0))
      0)
    (load runtime)))

;; The function NAME itself as the compiled program defines it (not an instance
;; of it), or null.
(defn unit-find-func [(p (ptr Program)) (name (slice u8))] (-> (ptr Func))
  (let [fs (load (field p funcs))
        (mut found) (primitive/cast (ptr Func) 0)]
    (for [i 0 (len (load fs))]
      (when (and (= (primitive/cast i64 found) 0) (= (.name (elem fs i)) name))
        (set! found (elem fs i))
        0)
      0)
    (load found)))

;; Its parameters' names.
(defn unit-func-param-names [(a (dyn Allocator)) (f (ptr Func))] (-> (ptr (ArrayList (slice u8))))
  (let [(mut out) (ArrayList::new [(slice u8)] a)]
    (for [i 0 (len (load (.params f)))]
      (push! (mut out) (.name (elem (.params f) i)))
      0)
    (box-al [(slice u8)] a (load out))))

(defn unit-find-surface [(p (ptr Program)) (name (slice u8))] (-> (ptr Extern))
  (let [abis (load (field p function_abis))
        (mut found) (primitive/cast (ptr Extern) 0)]
    (for [i 0 (len (load abis))]
      (let [surface (elem abis i)]
        (when (= (.name surface) name) (set! found surface) 0))
      0)
    (load found)))

(defn unit-find-struct [(p (ptr Program)) (name (slice u8))] (-> (ptr StructDef))
  (let [ds (load (field p structs))
        (mut found) (primitive/cast (ptr StructDef) 0)]
    (for [i 0 (len (load ds))]
      (let [d (elem ds i)]
        (when (= (.name d) name) (set! found d) 0))
      0)
    (load found)))

;; The leaf name of the sum in module `ns` that declares the variant `leaf`, or "".
;; A concrete sum is in the checked program; a generic one the module wrote is
;; read from its `defsum` form, `(defsum NAME [T …] (VARIANT …) …)`.
(defn unit-variant-sum-leaf [(p (ptr Program))
                             (forms (ptr (ArrayList Sexp)))
                             (ns (slice u8))
                             (leaf (slice u8))] (-> (slice u8))
  (let [checked (unit-checked-variant-sum-leaf p ns leaf)]
    (if (> (len checked) 0)
        checked
        (let [(mut found) ""]
          (for [i 0 (len (load forms))]
            (let [f (elem forms i)]
              (when (= (unit-form-head f) "defsum")
                (let [items (l-as-list f)]
                  (for [j 2 (len (load items))]
                    (match (l-list-head (elem items j))
                      (Some [variant]
                            (when (= variant leaf)
                              (match (unit-form-name f)
                                (Some [name] (set! found name) 0)
                                (None [] 0))
                              0))
                      (None [] 0))
                    0))
                0))
            0)
          (load found)))))

;; An instance of a generic sum (`Maybe__i64`) carries the variants too; the sum
;; that declares them is the generic one, so instances are skipped.
(defn unit-checked-variant-sum-leaf [(p (ptr Program)) (ns (slice u8)) (leaf (slice u8))] (-> (slice u8))
  (let [ds (load (field p sums))
        prefix-len (+ (len ns) 1)
        (mut found) ""]
    (for [i 0 (len (load ds))]
      (let [d (elem ds i)
            name (.name d)]
        (when (and (> (len name) prefix-len)
                   (= (subslice [u8] name 0 (len ns)) ns)
                   (not (unit-mono-instance? name)))
          (for [j 0 (len (load (.variants d)))]
            (when (= (last-component (.name (elem (.variants d) j))) leaf)
              (set! found (subslice [u8] name prefix-len (len name)))
              0)
            0)
          0))
      0)
    (load found)))

(defn unit-find-sum [(p (ptr Program)) (name (slice u8))] (-> (ptr SumDef))
  (let [ds (load (field p sums))
        (mut found) (primitive/cast (ptr SumDef) 0)]
    (for [i 0 (len (load ds))]
      (let [d (elem ds i)]
        (when (= (.name d) name) (set! found d) 0))
      0)
    (load found)))

;; sx-at returns a value; a recursive walker needs a pointer to recurse into.
(defn sx-at-p [(l (ptr (ArrayList Sexp))) (i i64)] (-> (ptr Sexp))
  (elem l i))

;; Every symbol token in a form, so the interface knows which private helpers a
;; copied generic or macro reaches and must declare.
(defn unit-collect-syms! [(f (ptr Sexp)) (out (mut (ArrayList (slice u8))))] (-> i64)
  (match (.kind f)
    (KSym [_] (unit-add! (mut out) (sx-sval (load f))))
    (KList [items]
           (for [i 0 (sx-len items)]
             (unit-collect-syms! (sx-at-p items i) (mut out))
             0))
    (KVec [items]
          (for [i 0 (sx-len items)]
            (unit-collect-syms! (sx-at-p items i) (mut out))
            0))
    (_ 0)))

(defn unit-write-fields! [(a (dyn Allocator))
                          (out (mut StrBuf))
                          (fields (ptr (ArrayList Field)))
                          (ns (slice u8))
                          (mods (mut (ArrayList (slice u8))))
                          (types (mut (ArrayList (slice u8))))] (-> i64)
  (push! (mut out) (: 91 u8))
  (for [i 0 (len (load fields))]
    (let [fld (elem fields i)]
      (when (> i 0) (push! (mut out) (: 32 u8)) 0)
      (push! (mut out) (: 40 u8))
      (push-str! (mut out) (.name fld))
      (push! (mut out) (: 32 u8))
      (push-str! (mut out) (unit-ty-str a (field fld ty)))
      (unit-type-refs! (field fld ty) ns (mut mods) (mut types))
      (push! (mut out) (: 41 u8)))
    0)
  (push! (mut out) (: 93 u8))
  0)

;; The name a top-level definition form declares.
(defn unit-form-name [(f (ptr Sexp))] (-> (Option (slice u8)))
  (match (.kind f)
    (KList [items]
           (if (and (> (len (load items)) 1)
                    (= (sx-tag (get (load items) 1)) 2))
               (Some (sx-sval (get (load items) 1)))
               (None [(slice u8)])))
    (_ (None [(slice u8)]))))

(defn unit-copy-form! [(out (mut StrBuf)) (text (slice u8)) (f (ptr Sexp))] (-> i64)
  (push-str! (mut out) (subslice text (.lo f) (.hi f)))
  (push! (mut out) (: 10 u8))
  0)

;; A declaration of a concrete function, from its checked surface. NAMES are its
;; parameters' names, so a consumer may call it with named arguments as it may
;; from source; null, or a list that does not fit, names them p0, p1, ….
(defn unit-write-declare! [(a (dyn Allocator))
                           (out (mut StrBuf))
                           (surface (ptr Extern))
                           (names (ptr (ArrayList (slice u8))))
                           (leaf (slice u8))
                           (ns (slice u8))
                           (mods (mut (ArrayList (slice u8))))
                           (types (mut (ArrayList (slice u8))))] (-> i64)
  (push-str! (mut out) "(declare ")
  (push-str! (mut out) leaf)
  (unless (= (.cc surface) "c")
    (push-str! (mut out) " :cc ")
    (push-str! (mut out) (.cc surface))
    ; a convention of this module's own: the interface declares it too
    (when (= (unit-module-of-name (.cc surface)) ns)
      (unit-add! (mut types) (last-component (.cc surface)))
      0)
    0)
  (push-str! (mut out) " [")
  (let [ps (load (field surface params))
        named (unit-param-names-fit? names (len (load ps)))]
    (for [j 0 (len (load ps))]
      (do
        (when (> j 0) (push! (mut out) (: 32 u8)) 0)
        (push! (mut out) (: 40 u8))
        (push-str! (mut out)
                   (if named
                       (unit-plain-name (get (load names) j))
                       (sconcat a "p" (i64->str a j))))
        (push! (mut out) (: 32 u8))
        (push-str! (mut out) (unit-ty-str a (elem ps j)))
        (unit-type-refs! (elem ps j) ns (mut mods) (mut types))
        (push! (mut out) (: 41 u8)))
      0))
  (push-str! (mut out) "] (-> ")
  (push-str! (mut out) (unit-ty-str a (field surface ret)))
  (unit-type-refs! (field surface ret) ns (mut mods) (mut types))
  (push-str! (mut out) "))\n")
  0)

(defn unit-find-extern [(es (ptr (ArrayList Extern))) (name (slice u8))] (-> (ptr Extern))
  (let [(mut found) (primitive/cast (ptr Extern) 0)]
    (for [i 0 (len (load es))]
      (let [e (elem es i)]
        (when (= (.name e) name) (set! found e) 0))
      0)
    (load found)))

;; A C function the module declares, written or generated (a `cimport`, a macro
;; that emits an `extern`), printed from its checked signature as an `extern`:
;; from the checked program's, where a `(-> never)` one still says so.
(defn unit-write-extern! [(a (dyn Allocator))
                          (out (mut StrBuf))
                          (e (ptr Extern))
                          (leaf (slice u8))
                          (ns (slice u8))
                          (mods (mut (ArrayList (slice u8))))
                          (types (mut (ArrayList (slice u8))))] (-> i64)
  (push-str! (mut out) (sconcat3 a "(extern " leaf " :cc "))
  (push-str! (mut out) (.cc e))
  (match (.symbol e)
    (Some [symbol] (push-str! (mut out) (sconcat3 a " :as \"" symbol "\"")))
    (None [] 0))
  (push-str! (mut out) " [")
  (let [ps (load (field e params))]
    (for [j 0 (len (load ps))]
      (when (> j 0) (push! (mut out) (: 32 u8)) 0)
      (push-str! (mut out) (unit-ty-str a (elem ps j)))
      (unit-type-refs! (elem ps j) ns (mut mods) (mut types))
      0))
  (when (.variadic e) (push-str! (mut out) " ...") 0)
  (push-str! (mut out) "] (-> ")
  (push-str! (mut out) (unit-ty-str a (field e ret)))
  (unit-type-refs! (field e ret) ns (mut mods) (mut types))
  (push-str! (mut out) "))\n")
  0)

(defn unit-find-convention [(p (ptr Program)) (name (slice u8))] (-> (ptr Convention))
  (let [cs (load (field p conventions))
        (mut found) (primitive/cast (ptr Convention) 0)]
    (for [i 0 (len (load cs))]
      (let [c (elem cs i)]
        (when (= (.name c) name) (set! found c) 0))
      0)
    (load found)))

(defn unit-write-names! [(out (mut StrBuf)) (key (slice u8)) (names (ptr (ArrayList (slice u8))))] (-> i64)
  (push-str! (mut out) key)
  (push-str! (mut out) " [")
  (for [i 0 (len (load names))]
    (when (> i 0) (push! (mut out) (: 32 u8)) 0)
    (push-str! (mut out) (get (load names) i))
    0)
  (push-str! (mut out) "]")
  0)

;; A calling convention the module declares, written or generated (a macro that
;; picks the registers per target), printed from its checked form as a `defcc`.
(defn unit-write-convention! [(a (dyn Allocator))
                              (out (mut StrBuf))
                              (c (ptr Convention))
                              (leaf (slice u8))
                              (mods (mut (ArrayList (slice u8))))] (-> i64)
  (push-str! (mut out) (sconcat a "(defcc " leaf))
  (unit-write-names! (mut out) " :params" (.params c))
  (match (.ret c)
    (Some [r] (push-str! (mut out) (sconcat a " :ret " r)))
    (None [] 0))
  (unit-write-names! (mut out) " :clobber" (.clobber c))
  (unit-write-names! (mut out) " :preserve" (.preserve c))
  (unit-add! (mut mods) "coil.cc")
  (push-str! (mut out)
             (match (.lowering c)
               (LNative [cc]
                        (sconcat3 a
                                  " :lower (coil.cc.Native (coil.cc."
                                  (match cc
                                    (cc/C [] "C")
                                    (cc/Fast [] "Fast")
                                    (cc/Cold [] "Cold")
                                    (cc/Tail [] "Tail")
                                    (cc/SwiftTail [] "SwiftTail"))
                                  "))"))
               (LShim [] " :lower (coil.cc.Shim)")
               (LReset [] " :lower (coil.cc.Reset)")
               (LWritten [_] (panic "unit-write-convention!: convention '{}' was never resolved" leaf))))
  (push-str! (mut out) ")\n")
  0)

;; Can NAMES name N parameters: one each, every one distinct once its hygiene is
;; stripped?
(defn unit-param-names-fit? [(names (ptr (ArrayList (slice u8)))) (n i64)] (-> bool)
  (and (!= (primitive/cast i64 names) 0)
       (= (len (load names)) n)
       (let [(mut ok) true]
         (for [i 0 n]
           (let [x (unit-plain-name (get (load names) i))]
             (when (= (len x) 0) (set! ok false) 0)
             (for [j 0 i]
               (when (= (unit-plain-name (get (load names) j)) x) (set! ok false) 0)
               0))
           0)
         (load ok))))

(defn unit-write-struct! [(a (dyn Allocator))
                          (out (mut StrBuf))
                          (decl (ptr StructDef))
                          (leaf (slice u8))
                          (ns (slice u8))
                          (mods (mut (ArrayList (slice u8))))
                          (types (mut (ArrayList (slice u8))))] (-> i64)
  (push-str! (mut out) "(defstruct ")
  (push-str! (mut out) leaf)
  (push! (mut out) (: 32 u8))
  (unit-write-fields! a
                      (mut out)
                      (load (field decl fields))
                      ns
                      (mut mods)
                      (mut types))
  (push-str! (mut out) ")\n")
  0)

(defn unit-write-sum! [(a (dyn Allocator))
                       (out (mut StrBuf))
                       (decl (ptr SumDef))
                       (leaf (slice u8))
                       (ns (slice u8))
                       (mods (mut (ArrayList (slice u8))))
                       (types (mut (ArrayList (slice u8))))] (-> i64)
  (push-str! (mut out) "(defsum ")
  (push-str! (mut out) leaf)
  (for [j 0 (len (load (field decl variants)))]
    (let [variant (elem (load (field decl variants)) j)]
      (push-str! (mut out) " (")
      (push-str! (mut out) (last-component (.name variant)))
      (when (> (len (load (field variant fields))) 0)
        (push! (mut out) (: 32 u8))
        (unit-write-fields! a
                            (mut out)
                            (load (field variant fields))
                            ns
                            (mut mods)
                            (mut types))
        0)
      (push! (mut out) (: 41 u8)))
    0)
  (push-str! (mut out) ")\n")
  0)

;; ---- impls a module's own metaprograms produce ---------------------------
;;
;; A literal `impl` or `derive` is copied as source and the consumer compiles it
;; again. An impl that a `(meta …)` generator or a custom top-level macro produced
;; has no source form to copy, and re-running the generator in the consumer would
;; define its other outputs twice. Such an impl is carried by identity instead:
;; the unit compiles one small wrapper function per method, which calls the
;; method it already compiled, and the interface declares the wrapper and
;; carries a forwarding impl whose methods call it. The consumer dispatches to
;; the unit's own compiled method; nothing is expanded twice, so hygiene never
;; enters. A generated GENERIC impl has no single compiled method to forward to,
;; and is refused by name.

;;; One method of a generated impl, carried through a wrapper named `wrapper`.
(defstruct UnitForward
  [(trait (slice u8))          ; qualified trait name, or "" for an inherent impl
   (self_type Type)
   (method (slice u8))
   (params (ptr (ArrayList Type)))
   (ret Type)
   (wrapper (slice u8))
   (call_head (slice u8))      ; what the wrapper calls: `T::m`, or `m` for a receiver
   (source_lo i64)])           ; the literal `impl`/`derive` form it replaces, or -1

(defn unit-forwarded? [(forwards (ptr (ArrayList UnitForward))) (lo i64)] (-> bool)
  (let [(mut found) false]
    (for i (range 0 (len (load forwards)))
      (when (= (.source_lo (elem forwards i)) lo) (set! found true)))
    found))

(defn unit-list-items [(f (ptr Sexp))] (-> (ptr (ArrayList Sexp)))
  (match (.kind f)
    (KList [items] items)
    (_ (primitive/cast (ptr (ArrayList Sexp)) 0))))

;; The last dotted or `/`-qualified component of a symbol, or "" for a non-symbol.
(defn unit-sym-leaf [(f (ptr Sexp))] (-> (slice u8))
  (if (= (sx-tag (load f)) 2)
      (let [name (last-component (sx-sval (load f)))
            (mut at) -1]
        (for [i 0 (len name)]
          (when (= (get name i) (: 47 u8)) (set! at i)))
        (if (< at 0) name (subslice [u8] name (+ at 1) (len name))))
      ""))

;; The nominal head of a written type: `Point` for `Point` or `(Box T)`.
(defn unit-type-leaf [(f (ptr Sexp))] (-> (slice u8))
  (if (= (sx-tag (load f)) 2)
      (unit-sym-leaf f)
      (let [items (unit-list-items f)]
        (if (or (= (cast i64 items) 0) (= (len (load items)) 0))
            ""
            (unit-sym-leaf (elem items 0))))))

;; A method form inside an impl: a list with a parameter vector at top level.
(defn unit-method-form? [(f (ptr Sexp))] (-> bool)
  (let [items (unit-list-items f)
        (mut found) false]
    (unless (= (cast i64 items) 0)
      (for [i 0 (len (load items))]
        (when (= (sx-tag (get (load items) i)) 7) (set! found true))))
    found))

;; The shape of a written `(impl …)`: whether it has type parameters, its trait
;; leaf ("" for inherent), its type leaf, and its method names.
(defstruct UnitImplShape
  [(generic bool) (trait (slice u8)) (type (slice u8)) (methods (ArrayList (slice u8)))])

(defn unit-impl-shape [(a (dyn Allocator)) (f (ptr Sexp))] (-> UnitImplShape)
  (let [items (unit-list-items f)
        n (len (load items))
        (mut i) 1
        (mut generic) false
        (mut methods) (ArrayList::new [(slice u8)] a)]
    (when (and (< i n) (= (sx-tag (get (load items) i)) 7))
      (set! generic true)
      (set! i (+ i 1)))
    (let [first i
          ; `(impl Trait Type m…)` when the element after the first is not a method.
          trait-impl (and (< (+ first 1) n)
                          (not (unit-method-form? (elem items (+ first 1)))))
          type-at (if trait-impl (+ first 1) first)]
      (for [j (+ type-at 1) n]
        (let [m (elem items j)
              mi (unit-list-items m)]
          (unless (or (= (cast i64 mi) 0) (= (len (load mi)) 0))
            (push! (mut methods) (unit-sym-leaf (elem mi 0))))))
      (UnitImplShape :generic generic
                     :trait (if trait-impl (unit-sym-leaf (elem items first)) "")
                     :type (if (< type-at n) (unit-type-leaf (elem items type-at)) "")
                     :methods methods))))

;; `(derive T1 (T2 opts) … Type)`: does it produce an impl of `trait` for `type`?
(defn unit-derive-covers? [(f (ptr Sexp)) (trait (slice u8)) (type (slice u8))] (-> bool)
  (let [items (unit-list-items f)
        n (len (load items))
        (mut covers) false]
    (when (and (> n 2) (= (unit-type-leaf (elem items (- n 1))) type))
      (for [i 1 (- n 1)]
        (when (= (unit-type-leaf (elem items i)) trait) (set! covers true))))
    covers))

(defn unit-same-names? [(xs (ArrayList (slice u8))) (ys (ArrayList (slice u8)))] (-> bool)
  (let [(mut same) (= (len xs) (len ys))]
    (for x (iter xs)
      (let [(mut found) false]
        (for y (iter ys) (when (= x y) (set! found true)))
        (unless found (set! same false))))
    same))

(defn unit-type-is-self? [(t (ptr Type)) (self-str (slice u8)) (a (dyn Allocator))] (-> bool)
  (match (load t)
    (TRef [_ inner] (= (unit-ty-str a inner) self-str))
    (TPtr [inner] (= (unit-ty-str a inner) self-str))
    (_ (= (unit-ty-str a t) self-str))))

;;; The concrete impls of module `ns` among the pipeline's `expanded` forms, as
;;; one UnitForward per method. Every concrete impl is forwarded, whether the
;;; module wrote it, derived it, or a metaprogram generated it: copying its source
;;; instead would make the interface import everything the module imports, and a
;;; consumer would then compile the unit's whole import closure. A literal generic
;;; impl or derive, or a literal impl a forward cannot express, stays source (its
;;; UnitForwards carry no `source_lo` for it); a generated generic impl is refused.
(defn unit-generated-forwards [(a (dyn Allocator))
                               (p (ptr Program))
                               (expanded (ptr (ArrayList TaggedForm)))
                               (forms (ptr (ArrayList Sexp)))
                               (ns (slice u8))] (-> (Result (ArrayList UnitForward) (slice u8)))
  (let [(mut out) (ArrayList::new [UnitForward] a)
        (mut err) (None [(slice u8)])]
    (unless (= (cast i64 expanded) 0)
      (for k (range 0 (len (load expanded)))
        (let [t (elem expanded k)
              f (field t form)
              in-module (match (.module t) (Some [m] (= m ns)) (None [] false))]
          (when (and in-module
                     (and (= (unit-form-head f) "impl")
                          (match (load err) (None [] true) (_ false))))
            (let [(mut literal-lo) -1
                  shape (unit-impl-shape a f)]
              (for i (range 0 (len (load forms)))
                (let [g (elem forms i)
                      head (unit-form-head g)]
                  (when (and (= head "impl")
                             (and (= (.ctxt f) 0)
                                  (and (= (.lo g) (.lo f)) (= (.hi g) (.hi f)))))
                    (set! literal-lo (.lo g)))
                  (when (and (= head "derive")
                             (unit-derive-covers? g (.trait shape) (.type shape)))
                    (set! literal-lo (.lo g)))))
              (cond (.generic shape)
                      (when (< literal-lo 0)
                        (set! err (Some (sconcat3 a
                                                  (sconcat3 a "cannot prebuild '" ns "': a metaprogram generates a generic impl for '")
                                                  (.type shape)
                                                  "', which a unit cannot carry -- it has no compiled method to forward to; write it as source or make it concrete"))))
                    :else
                      (let [(mut these) (ArrayList::new [UnitForward] a)]
                        (match (unit-forward-impl! a p ns shape (len (load out)) literal-lo (mut these))
                          ; A literal impl a forward cannot express is copied as source.
                          (Some [e] (when (< literal-lo 0) (set! err (Some e))))
                          (None [] (for fw these (push! (mut out) fw)))))))))))
    (match (load err)
      (Some [e] (Err [(ArrayList UnitForward) (slice u8)] e))
      (None [] (Ok [(ArrayList UnitForward) (slice u8)] (load out))))))

;; Find the checked impl a generated `(impl …)` produced and add its methods.
(defn unit-forward-impl! [(a (dyn Allocator))
                          (p (ptr Program))
                          (ns (slice u8))
                          (shape UnitImplShape)
                          (base i64)
                          (source-lo i64)
                          (out (mut (ArrayList UnitForward)))] (-> (Option (slice u8)))
  (let [(mut found) (primitive/cast (ptr ImplDef) 0)]
    (for i (range 0 (len (load (field p impls))))
      (let [ip (elem (load (field p impls)) i)
            trait-leaf (if (impl-is-trait ip) (last-component (impl-trait-name ip)) "")
            (mut names) (ArrayList::new [(slice u8)] a)]
        (for m (range 0 (len (load (.methods ip))))
          (push! (mut names) (last-component (.name (elem (.methods ip) m)))))
        (when (and (= (cast i64 (load found)) 0)
                   (and (= trait-leaf (.trait shape))
                        (and (= (last-component (impl-base-name a (field ip self_type))) (.type shape))
                             (and (= (len (load (.type_params ip))) 0)
                                  (unit-same-names? (.methods shape) (load names))))))
          (set! found ip))))
    (if (= (cast i64 (load found)) 0)
        (Some (sconcat3 a "cannot prebuild '" ns
                        (sconcat3 a "': a generated impl for '" (.type shape)
                                  "' has no checked counterpart (compiler bug)")))
        (let [ip (load found)
              self-str (unit-ty-str a (field ip self_type))
              (mut problem) (None [(slice u8)])]
          (for m (range 0 (len (load (.methods ip))))
            (let [f (elem (.methods ip) m)
                  method (last-component (.name f))
                  (mut params) (ArrayList::new [Type] a)]
              (for k (range 0 (len (load (.params f))))
                (push! (mut params) (.ty (elem (.params f) k))))
              (let [receiver (and (> (len params) 0)
                                  (unit-type-is-self? (elem (mut params) 0) self-str a))
                    head (cond (impl-is-trait ip) (sconcat3 a (impl-trait-name ip) "::" method)
                               receiver method
                               :else (sconcat3 a self-str "::" method))]
                (when (and (not (impl-is-trait ip))
                           (and (not receiver) (some? (find self-str " "))))
                  (set! problem (Some (sconcat3 a "cannot prebuild '" ns
                                                (sconcat3 a "': a generated associated function '" method
                                                          "' of an applied type cannot be forwarded")))))
                (push! (mut out)
                       (UnitForward :trait (if (impl-is-trait ip) (impl-trait-name ip) "")
                                    :self_type (load (field ip self_type))
                                    :method method
                                    :params (box-al [Type] a (load params))
                                    :ret (load (field f ret))
                                    :wrapper (sconcat a "__unit-impl-" (i64->str a (+ base (len (load out)))))
                                    :call_head head
                                    :source_lo source-lo)))))
          (load problem)))))

(defn unit-push-params! [(a (dyn Allocator)) (out (mut StrBuf)) (params (ptr (ArrayList Type)))] (-> i64)
  (push-str! (mut out) "[")
  (for k (range 0 (len (load params)))
    (when (> k 0) (push! (mut out) (: 32 u8)))
    (push-str! (mut out) (sconcat3 a "(p" (i64->str a k) " "))
    (push-str! (mut out) (unit-ty-str a (elem params k)))
    (push-str! (mut out) ")"))
  (push-str! (mut out) "]")
  0)

(defn unit-push-args! [(a (dyn Allocator)) (out (mut StrBuf)) (params (ptr (ArrayList Type)))] (-> i64)
  (for k (range 0 (len (load params)))
    (push! (mut out) (: 32 u8))
    (let [mutable (match (load (elem params k)) (TRef [m _] m) (_ false))]
      (push-str! (mut out)
                 (if mutable
                     (sconcat3 a "(mut p" (i64->str a k) ")")
                     (sconcat a "p" (i64->str a k))))))
  0)

;;; The wrapper functions a unit with generated impls compiles in its module.
(defn unit-wrapper-source [(a (dyn Allocator)) (forwards (ptr (ArrayList UnitForward)))] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)]
    (push-str! (mut out) "\n; Wrappers `coil build-unit` added for impls a metaprogram generated.\n")
    (for i (range 0 (len (load forwards)))
      (let [fw (elem forwards i)]
        (push-str! (mut out) (sconcat3 a "(defn " (.wrapper fw) " "))
        (unit-push-params! a (mut out) (.params fw))
        (push-str! (mut out) (sconcat3 a " (-> " (unit-ty-str a (field fw ret)) ") ("))
        (push-str! (mut out) (.call_head fw))
        (unit-push-args! a (mut out) (.params fw))
        (push-str! (mut out) "))\n")))
    (str (load out))))

;; The forwarding impls, one per generated impl, into `out`; every type they name
;; and every wrapper they call enters the worklist.
(defn unit-write-forwards! [(a (dyn Allocator))
                            (out (mut StrBuf))
                            (forwards (ptr (ArrayList UnitForward)))
                            (ns (slice u8))
                            (mods (mut (ArrayList (slice u8))))
                            (work (mut (ArrayList (slice u8))))] (-> i64)
  (let [n (len (load forwards))
        (mut i) 0]
    (while (< i n)
      (let [first (elem forwards i)
            key-trait (.trait first)
            key-type (unit-ty-str a (field first self_type))]
        (push-str! (mut out) "(impl ")
        (unless (= key-trait "")
          (push-str! (mut out) (sconcat a key-trait " "))
          (let [m (unit-module-of-name key-trait)]
            (if (= m ns)
                (unit-add! (mut work) (last-component key-trait))
                (unless (= m "") (unit-add! (mut mods) m)))))
        (push-str! (mut out) key-type)
        (unit-type-refs! (field first self_type) ns (mut mods) (mut work))
        (while (and (< i n)
                    (let [fw (elem forwards i)]
                      (and (= (.trait fw) key-trait) (= (unit-ty-str a (field fw self_type)) key-type))))
          (let [fw (elem forwards i)]
            (push-str! (mut out) (sconcat3 a "\n  (" (.method fw) " "))
            (unit-push-params! a (mut out) (.params fw))
            (for k (range 0 (len (load (.params fw))))
              (unit-type-refs! (elem (.params fw) k) ns (mut mods) (mut work)))
            (push-str! (mut out) (sconcat3 a " (-> " (unit-ty-str a (field fw ret)) ") ("))
            (unit-type-refs! (field fw ret) ns (mut mods) (mut work))
            (push-str! (mut out) (.wrapper fw))
            (unit-push-args! a (mut out) (.params fw))
            (push-str! (mut out) "))")
            (unit-add! (mut work) (.wrapper fw))
            (set! i (+ i 1))))
        (push-str! (mut out) ")\n"))))
  0)

;; ---- traits ---------------------------------------------------------------

;; A binder a macro introduced is renamed `$scopeN@module$name`; within one
;; printed declaration its plain spelling names the same parameter.
(defn unit-hygienic-name? [(name (slice u8))] (-> bool)
  (and (> (len name) 0) (= (get name 0) (: 36 u8))))

(defn unit-plain-name [(name (slice u8))] (-> (slice u8))
  (if (unit-hygienic-name? name)
      (let [(mut at) 0]
        (for i (range 0 (len name))
          (when (= (get name i) (: 36 u8)) (set! at i)))
        (subslice [u8] name (+ at 1) (len name)))
      name))

;; `ty-str`, with each of a declaration's hygienic parameter names printed plainly.
(defn unit-plain-ty-str [(a (dyn Allocator)) (t (ptr Type)) (params (ptr (ArrayList (slice u8))))] (-> (slice u8))
  (let [(mut text) (unit-ty-str a t)]
    (for i (range 0 (len (load params)))
      (let [name (get (load params) i)]
        (when (unit-hygienic-name? name)
          (set! text (unit-replace-all a (load text) name (unit-plain-name name))))))
    text))

(defn unit-replace-all [(a (dyn Allocator)) (text (slice u8)) (from (slice u8)) (to (slice u8))] (-> (slice u8))
  (let [(mut out) (StrBuf::new a)
        (mut i) 0
        n (len text)
        m (len from)]
    (while (< i n)
      (if (and (<= (+ i m) n) (= (subslice [u8] text i (+ i m)) from))
          (do (push-str! (mut out) to) (set! i (+ i m)))
          (do (push! (mut out) (get text i)) (set! i (+ i 1)))))
    (str (load out))))

(defn unit-find-trait [(p (ptr Program)) (name (slice u8))] (-> (ptr TraitDef))
  (let [ds (load (field p traits))
        (mut found) (primitive/cast (ptr TraitDef) 0)]
    (for i (range 0 (len (load ds)))
      (let [d (elem ds i)]
        (when (= (.name d) name) (set! found d))))
    (load found)))

;; The leaf of the trait in `ns` whose object layout `leaf` is (`T-dyn` or
;; `T-vtable`, parser.coil dyn-struct-def), or "".
(defn unit-dyn-trait-leaf [(a (dyn Allocator)) (p (ptr Program)) (ns (slice u8)) (leaf (slice u8))] (-> (slice u8))
  (let [n (len leaf)
        trait (cond (and (> n 4) (= (subslice [u8] leaf (- n 4) n) "-dyn"))
                      (subslice [u8] leaf 0 (- n 4))
                    (and (> n 7) (= (subslice [u8] leaf (- n 7) n) "-vtable"))
                      (subslice [u8] leaf 0 (- n 7))
                    :else "")]
    (if (and (> (len trait) 0)
             (!= (primitive/cast i64 (unit-find-trait p (sconcat3 a ns "." trait))) 0))
        trait
        "")))

;; The leaf of the trait in `ns` that declares the method `leaf`, or "".
(defn unit-method-trait-leaf [(p (ptr Program)) (ns (slice u8)) (leaf (slice u8))] (-> (slice u8))
  (let [ds (load (field p traits))
        (mut found) ""]
    (for i (range 0 (len (load ds)))
      (let [d (elem ds i)]
        (when (= (unit-module-of-name (.name d)) ns)
          (for j (range 0 (len (load (.methods d))))
            (when (= (last-component (.name (elem (.methods d) j))) leaf)
              (set! found (last-component (.name d))))))))
    found))

;; A trait the module's metaprograms produced, printed from its checked
;; signature. `:inline` is the only method annotation a signature carries that a
;; consumer needs; any other annotation is refused by name.
(defn unit-write-trait! [(a (dyn Allocator))
                         (out (mut StrBuf))
                         (d (ptr TraitDef))
                         (ns (slice u8))
                         (mods (mut (ArrayList (slice u8))))
                         (work (mut (ArrayList (slice u8))))] (-> (Option (slice u8)))
  (let [(mut problem) (None [(slice u8)])
        (mut binders) (ArrayList::new [(slice u8)] a)]
    (push-str! (mut out) (sconcat3 a "(deftrait " (last-component (.name d)) " ["))
    (push-str! (mut out) (unit-plain-name (.self_param d)))
    (push! (mut binders) (.self_param d))
    (for tp (iter (load (.type_params d)))
      (push! (mut out) (: 32 u8))
      (push-str! (mut out) (unit-plain-name tp))
      (push! (mut binders) tp))
    (push-str! (mut out) "]")
    (when (> (len (load (.requires d))) 0)
      (push-str! (mut out) " :requires [")
      (for k (range 0 (len (load (.requires d))))
        (let [r (get (load (.requires d)) k)
              m (unit-module-of-name r)]
          (when (> k 0) (push! (mut out) (: 32 u8)))
          (push-str! (mut out) r)
          (if (= m ns) (unit-add! (mut work) (last-component r)) (unless (= m "") (unit-add! (mut mods) m)))))
      (push-str! (mut out) "]"))
    (for j (range 0 (len (load (.methods d))))
      (let [m (elem (.methods d) j)]
        (push-str! (mut out) (sconcat3 a "\n  (" (last-component (.name m)) ""))
        (for an (range 0 (len (load (.annotations m))))
          (let [ann (elem (.annotations m) an)]
            (if (= (.key ann) "inline")
                (let [c (annotation-constructor (field ann value))]
                  (if (= c "")
                      (set! problem (Some (sconcat3 a "cannot prebuild '" ns "': a generated trait method's :inline value is not a policy constructor")))
                      (push-str! (mut out) (sconcat3 a " :inline (" c ")"))))
                (set! problem (Some (sconcat3 a "cannot prebuild '" ns
                                              (sconcat3 a "': generated trait method '" (.name m)
                                                        "' carries an annotation a unit cannot print")))))))
        (push-str! (mut out) " [")
        (for k (range 0 (len (load (.params m))))
          (let [pm (elem (.params m) k)]
            (when (> k 0) (push! (mut out) (: 32 u8)))
            (push-str! (mut out) (sconcat3 a "(" (unit-plain-name (.name pm)) " "))
            (push-str! (mut out) (unit-plain-ty-str a (field pm ty) (mut binders)))
            (unit-type-refs! (field pm ty) ns (mut mods) (mut work))
            (push-str! (mut out) ")")))
        (push-str! (mut out) (sconcat3 a "] (-> " (unit-plain-ty-str a (field m ret) (mut binders)) "))"))
        (unit-type-refs! (field m ret) ns (mut mods) (mut work))))
    (push-str! (mut out) ")\n")
    (load problem)))

;; The definition form among the module's raw entry FORMS that declares LEAF, or
;; null when the module did not write one (its metaprograms produced it).
(defn unit-find-form [(forms (ptr (ArrayList Sexp))) (leaf (slice u8))] (-> (ptr Sexp))
  (let [(mut found) (primitive/cast (ptr Sexp) 0)]
    (for [i 0 (len (load forms))]
      (let [f (elem forms i)]
        (match (l-list-head f)
          (Some [head]
                (cond (unit-definition-head? head)
                        (match (unit-form-name f)
                          (Some [name] (when (= name leaf) (set! found f) 0))
                          (None [] 0))
                      ; `(defderive Trait …)` declares the generators `derive`
                      ; looks up by name (expander.coil defderive-desugar!).
                      (= head "defderive")
                        (match (unit-form-name f)
                          (Some [trait]
                                (when (or (unit-prefixed? leaf "__derive_struct_" trait)
                                          (unit-prefixed? leaf "__derive_sum_" trait))
                                  (set! found f)
                                  0))
                          (None [] 0))
                      :else 0))
          (None [] 0)))
      0)
    (load found)))

;; The runtime `def` NAME (qualified) the program defines, or null: not a
;; constant, and not a `declare` of storage another unit holds (one the module
;; writes is copied as its source).
(defn unit-find-def [(p (ptr Program)) (name (slice u8))] (-> (ptr Const))
  (let [cs (load (field p consts))
        (mut found) (primitive/cast (ptr Const) 0)]
    (for [i 0 (len (load cs))]
      (let [c (elem cs i)]
        (when (and (= (.name c) name) (.runtime c) (not (.declared c)))
          (set! found c)
          0))
      0)
    (load found)))

;; A runtime `def` as `(declare LEAF TYPE)`: storage the unit's object defines.
;; `Some` names why it cannot be declared: a `declare` of storage carries no
;; annotations, so a def with any (`:params`, say) would reach a consumer
;; without them.
(defn unit-write-def-declare! [(a (dyn Allocator))
                               (out (mut StrBuf))
                               (c (ptr Const))
                               (leaf (slice u8))
                               (ns (slice u8))
                               (mods (mut (ArrayList (slice u8))))
                               (types (mut (ArrayList (slice u8))))] (-> (Option (slice u8)))
  (if (and (!= (primitive/cast i64 (.annotations c)) 0)
           (> (len (load (.annotations c))) 0))
      (Some (sconcat a
                     (sconcat3 a "cannot prebuild '" ns "': its `def` '")
                     (sconcat3 a
                               leaf
                               "' carries the annotation :"
                               (sconcat a
                                        (.key (elem (.annotations c) 0))
                                        ", which the `declare` a unit's interface makes of a def cannot carry yet"))))
      (match (.ty c)
        (None [] (panic "unit-write-def-declare!: the checked def '{}' has no type" (.name c)))
        (Some [ty]
          (let [tp (box! a Type ty)]
            (push-str! (mut out) (sconcat3 a "(declare " leaf " "))
            (push-str! (mut out) (unit-ty-str a tp))
            (unit-type-refs! tp ns (mut mods) (mut types))
            (push-str! (mut out) ")\n")
            (None [(slice u8)]))))))

;; A constant NAME (qualified) the checked program holds as an integer or bool
;; literal, perhaps ascribed, written to OUT as `(const LEAF [TYPE] VALUE)`.
;; False, writing nothing, for any other constant.
(defn unit-write-literal-const! [(a (dyn Allocator))
                                 (out (mut StrBuf))
                                 (p (ptr Program))
                                 (name (slice u8))
                                 (leaf (slice u8))] (-> bool)
  (let [cs (load (field p consts))
        (mut text) ""]
    (for [i 0 (len (load cs))]
      (let [c (elem cs i)]
        (when (and (= (.name c) name) (not (.runtime c)) (= (len text) 0))
          (let [value (unit-literal-text a (field c value))]
            (when (> (len value) 0)
              (set! text
                    (match (.ty c)
                      (Some [t] (sconcat3 a (unit-ty-str a (box! a Type t)) " " value))
                      (None [] value)))
              0))
          0))
      0)
    (if (> (len text) 0)
        (do
          (push-str! (mut out) (sconcat3 a "(const " leaf " "))
          (push-str! (mut out) text)
          (push-str! (mut out) ")\n")
          true)
        false)))

;; The source of an integer or bool literal E, ascribed or not, or "".
(defn unit-literal-text [(a (dyn Allocator)) (e (ptr Expr))] (-> (slice u8))
  (match (.kind e)
    (EInt [n] (i64->str a n))
    (EBool [b] (if b "true" "false"))
    (EAscribe [t inner]
      (let [v (unit-literal-text a inner)]
        (if (> (len v) 0)
            (sconcat a (sconcat3 a "(: " v " ") (sconcat a (unit-ty-str a (box! a Type t)) ")"))
            "")))
    (_ "")))

;; Is NAME exactly PREFIX followed by REST?
(defn unit-prefixed? [(name (slice u8)) (prefix (slice u8)) (rest (slice u8))] (-> bool)
  (and (= (len name) (+ (len prefix) (len rest)))
       (= (subslice [u8] name 0 (len prefix)) prefix)
       (= (subslice [u8] name (len prefix) (len name)) rest)))

;; The heads of the definition forms the interface finds by name.
(defn unit-definition-head? [(head (slice u8))] (-> bool)
  (or (= head "defn") (= head "defn*") (= head "declare") (= head "defstruct")
      (= head "defsum") (= head "deftrait") (= head "defalias") (= head "const")))

(defn unit-form-head [(f (ptr Sexp))] (-> (slice u8))
  (match (l-list-head f) (Some [h] h) (None [] "")))

;; Is the expanded `(defannotation KEY …)` F one the module wrote among FORMS
;; (a written one with the same key)?
(defn unit-written-annotation? [(forms (ptr (ArrayList Sexp))) (f (ptr Sexp))] (-> bool)
  (let [key (unit-annotation-key f)
        (mut found) false]
    (for [i 0 (len (load forms))]
      (let [g (elem forms i)]
        (when (and (= (unit-form-head g) "defannotation") (= (unit-annotation-key g) key))
          (set! found true)
          0))
      0)
    (and (> (len key) 0) (load found))))

;; The keyword a `(defannotation :KEY TYPE)` form declares, or "".
(defn unit-annotation-key [(f (ptr Sexp))] (-> (slice u8))
  (let [items (l-as-list f)]
    (if (> (len (load items)) 1)
        (match (.kind (elem items 1)) (KKw [k] k) (_ ""))
        "")))

;; Does the import form F carry `:reexport`? The interface carries such an import
;; as written: it is part of the module's interface, and the consumer's resolver
;; then passes on exactly what it passes on from source.
(defn unit-reexport-import? [(f (ptr Sexp))] (-> bool)
  (let [items (l-as-list f)
        (mut found) false]
    (for [i 2 (len (load items))]
      (match (.kind (elem items i))
        (KKw [k] (when (= k "reexport") (set! found true) 0))
        (_ 0))
      0)
    found))

;; Render module `ns`'s interface from its raw entry `forms`/`text` and the
;; monomorphized program `p` of a build of that entry. The interface is the
;; transitive closure of the module's `public` names (`module-own-public-names`:
;; its export list, or with none -- `listed` false -- every name it declares after
;; expansion, generated ones included): an exported concrete function is
;; declared and its body left in the object (so nothing behind it is compiled by
;; the consumer); an exported generic or macro is copied as source and the names
;; IT reaches are pulled in too -- a private concrete helper it calls is declared
;; and marked external so the consumer's instantiation can link it. A build-time
;; helper no export reaches (a `meta`'s generator, say) is simply dropped. Every
;; `impl` and `derive` form is copied as source too, so the module's impls reach
;; its consumers.
;; `externals` is filled with the qualified names the object must expose; every
;; other function stays local, so a consumer that also compiles a module the unit
;; embeds does not collide with it. `Err` names the first exported thing a unit
;; cannot express.
(defn unit-interface-render [(a (dyn Allocator))
                             (p (ptr Program))
                             (forms (ptr (ArrayList Sexp)))
                             (text (slice u8))
                             (ns (slice u8))
                             (forwards (ptr (ArrayList UnitForward)))
                             (reexported (ptr (ArrayList (slice u8))))
                             (public (ptr (ArrayList (slice u8))))
                             (listed bool)
                             (externs-checked (ptr (ArrayList Extern)))
                             (expanded (ptr (ArrayList TaggedForm)))
                             (externals (mut (ArrayList (slice u8))))] (-> (Result (slice u8)
                                                                                   (slice u8)))
  (when (= (primitive/cast i64 reexported) 0)
    (panic "unit-interface-render: the build of '{}' recorded no re-exported names" ns))
  (when (= (primitive/cast i64 public) 0)
    (panic "unit-interface-render: the build of '{}' recorded no public names" ns))
  (when (= (primitive/cast i64 externs-checked) 0)
    (panic "unit-interface-render: the build of '{}' recorded no checked externs" ns))
  (let [(mut decls) (StrBuf::new a)
        (mut forward-out) (StrBuf::new a)
        (mut types-out) (StrBuf::new a)
        (mut copied) (StrBuf::new a)
        (mut import-forms) (StrBuf::new a)
        (mut reexport-forms) (StrBuf::new a)
        (mut mods) (ArrayList::new [(slice u8)] a)
        (mut work) (ArrayList::new [(slice u8)] a)
        (mut processed) (ArrayList::new [(slice u8)] a)
        (mut copies-source) false
        (mut copied-at) (ArrayList::new [i64] a)
        (mut err) (None [(slice u8)])
        roots public
        (mut head-i) 0]
    (set! (unit-origins-cell) (.mono_origins p))
    (set! (unit-demono-allocator-cell) a)
    ; The module's own imports, kept only if a copied source form needs their
    ; aliases; an interface of pure declarations imports by type instead. Its
    ; re-export imports are kept whatever else is: they are part of its interface.
    (for [i 0 (len (load forms))]
      (let [f (elem forms i)]
        (when (= (unit-form-head f) "import")
          (unit-copy-form! (mut import-forms) text f)
          (when (unit-reexport-import? f)
            (unit-copy-form! (mut reexport-forms) text f)
            0)
          0))
      0)
    ; Every impl the module writes, trait or inherent, directly or through
    ; `derive`: a consumer dispatches to it wherever the module's values go. A
    ; concrete one is forwarded (see unit-generated-forwards); a generic one is
    ; carried as source, like a generic function. The consumer compiles its own
    ; copy (the object keeps these methods local, so the two never collide) and
    ; the names a body reaches enter the worklist, which declares any private
    ; helper and marks it external.
    ;
    ; A metaprogram registration also acts on every importer, but a consumer
    ; cannot run the unit's metaprograms from an interface yet, so refuse it
    ; rather than ship less.
    (for [i 0 (len (load forms))]
      (let [f (elem forms i)
            head (unit-form-head f)]
        (cond (or (and (or (= head "impl") (= head "derive"))
                       (not (unit-forwarded? forwards (.lo f))))
                  ; An annotation key is declared to every importer, as an impl
                  ; is: a consumer that writes it needs its declaration. So is a
                  ; compiler primitive a module binds a name to.
                  (= head "defannotation")
                  (= head "defprimitive"))
                (do
                  (unit-copy-form! (mut copied) text f)
                  (unit-collect-syms! f (mut work))
                  (set! copies-source true)
                  0)
              (and (or (= head "checker") (= head "transform") (= head "transform-once")
                       (= head "provide-core") (= head "reader-provider"))
                   (match (load err) (None [] true) (_ false)))
                (set! err
                      (Some (sconcat a
                                     (sconcat3 a "cannot prebuild '" ns "': its `")
                                     (sconcat a
                                              head
                                              "` form acts on every importer, and a unit's interface cannot carry it yet; a consumer would silently lose it"))))
              :else 0))
      0)
    ; An annotation key its metaprograms declared has no source to copy, and
    ; the checked program does not say which module declared a key.
    (unless (= (primitive/cast i64 expanded) 0)
      (for [i 0 (len (load expanded))]
        (let [t (elem expanded i)
              f (field t form)]
          (when (and (match (.module t) (Some [m] (= m ns)) (None [] false))
                     (= (unit-form-head f) "defannotation")
                     (not (unit-written-annotation? forms f))
                     (match (load err) (None [] true) (_ false)))
            (set! err
                  (Some (sconcat3 a
                                  "cannot prebuild '"
                                  ns
                                  "': a metaprogram declares an annotation key, which a unit's interface cannot carry yet; a consumer would silently lose it; write the `defannotation` as source")))
            0))
        0)
      0)
    ; Impls the module's metaprograms generated forward to wrappers in the object.
    (unit-write-forwards! a (mut forward-out) forwards ns (mut mods) (mut work))
    ; Seed the worklist with the exports.
    (for [i 0 (len (load roots))] (push! (mut work) (get (load roots) i)) 0)
    ; Process each needed name once. A concrete function is declared and not
    ; followed (its body is in the object); a copied generic/macro/type feeds the
    ; names it references back onto the worklist.
    (loop (if (>= (load head-i) (len work))
              (break)
              (do
                (let [leaf (get work (load head-i))]
                  (set! head-i (primitive/iadd (load head-i) 1))
                  (unless (unit-has? (mut processed) leaf)
                    (unit-add! (mut processed) leaf)
                    (let [qname (sconcat3 a ns "." leaf)
                          surface (unit-find-surface p qname)
                          form (unit-find-form forms leaf)
                          form? (!= (primitive/cast i64 form) 0)
                          fhead (if form? (unit-form-head form) "")
                          ; A function the object defines under this very name: a
                          ; generic one is instantiated under other names, so
                          ; asking the compiled program, not the syntax, also
                          ; covers a bounded or annotated `defn` and a generated one.
                          concrete
                            (and (!= (primitive/cast i64 surface) 0)
                                 (unit-concrete-function? surface)
                                 (!= (primitive/cast i64 (unit-find-func p qname)) 0))
                          struct (unit-find-struct p qname)
                          sum (unit-find-sum p qname)
                          is-root (unit-ptr-has? roots leaf)]
                      (cond ; A C function, written or generated: its checked signature.
                            (!= (primitive/cast i64 (unit-find-extern externs-checked qname)) 0)
                              (unit-write-extern! a
                                                  (mut decls)
                                                  (unit-find-extern externs-checked qname)
                                                  leaf
                                                  ns
                                                  (mut mods)
                                                  (mut work))
                            ; An exported or reached concrete function: declare it, mark it
                            ; external in the object, and stop -- its body is in the object.
                            concrete
                              (do
                                (unit-write-declare! a
                                                     (mut decls)
                                                     surface
                                                     (unit-func-param-names a (unit-find-func p qname))
                                                     leaf
                                                     ns
                                                     (mut mods)
                                                     (mut work))
                                (unit-add! (mut externals) qname)
                                0)
                            ; A runtime `def` the module defines: the object holds its
                            ; storage and exposes it, and the interface declares it, so a
                            ; consumer shares the unit's one copy. Reached by a copied form
                            ; though private, it is exposed the same way.
                            (!= (primitive/cast i64 (unit-find-def p qname)) 0)
                              (match (unit-write-def-declare! a
                                                              (mut decls)
                                                              (unit-find-def p qname)
                                                              leaf
                                                              ns
                                                              (mut mods)
                                                              (mut work))
                                (Some [e]
                                  (when (match (load err) (None [] true) (_ false))
                                    (set! err (Some e)))
                                  0)
                                (None []
                                  (do (unit-add! (mut externals) qname) 0)))
                            ; A generic or macro the module wrote: its own source, plus the
                            ; names it reaches (a private concrete helper it calls, another
                            ; generic it uses).
                            (and form? (or (= fhead "defn") (= fhead "defn*")))
                              (do
                                (unit-copy-form! (mut copied) text form)
                                (unit-collect-syms! form (mut work))
                                (set! copies-source true)
                                0)
                            ; A calling convention, written or generated: its checked form.
                            (!= (primitive/cast i64 (unit-find-convention p qname)) 0)
                              (unit-write-convention! a (mut types-out) (unit-find-convention p qname) leaf (mut mods))
                            ; An alias, derive generator, constant or declaration the
                            ; module wrote: its own source, once (a `defderive` declares
                            ; two generators), plus the names it reaches (an alias's
                            ; target, the functions and types a constant's value uses).
                            ; A constant is computed again where the interface is
                            ; compiled; a function its value calls is declared, and
                            ; compile-time evaluation reaches the unit's definition.
                            (and form? (or (= fhead "defalias") (= fhead "defderive")
                                           (= fhead "const") (= fhead "declare")))
                              (do
                                (unless (unit-i64-has? (mut copied-at) (.lo form))
                                  (push! (mut copied-at) (.lo form))
                                  (unit-copy-form! (mut copied) text form)
                                  (unit-collect-syms! form (mut work))
                                  (set! copies-source true)
                                  0)
                                0)
                            ; An object-safe trait's layouts, `T-dyn` and `T-vtable`: the
                            ; trait declares them wherever it is compiled, so carrying
                            ; the trait carries them, and printing them too would
                            ; define them twice.
                            (> (len (unit-dyn-trait-leaf a p ns leaf)) 0)
                              (do
                                (push! (mut work) (unit-dyn-trait-leaf a p ns leaf))
                                0)
                            ; A concrete record.
                            (and (!= (primitive/cast i64 struct) 0)
                                 (and (match (.layout struct)
                                        (LC [] true)
                                        (_ false))
                                      (= (len (load (field struct type_params)))
                                         0)))
                              (unit-write-struct! a
                                                  (mut types-out)
                                                  struct
                                                  leaf
                                                  ns
                                                  (mut mods)
                                                  (mut work))
                            ; A concrete sum.
                            (and (!= (primitive/cast i64 sum) 0)
                                 (= (len (load (field sum type_params))) 0))
                              (unit-write-sum! a
                                               (mut types-out)
                                               sum
                                               leaf
                                               ns
                                               (mut mods)
                                               (mut work))
                            ; A generic record or sum: its source.
                            (and form?
                                 (or (= fhead "defstruct") (= fhead "defsum")))
                              (do
                                (unit-copy-form! (mut copied) text form)
                                (unit-collect-syms! form (mut work))
                                (set! copies-source true)
                                0)
                            ; A variant: its sum declares it, so the export needs only the sum.
                            (> (len (unit-variant-sum-leaf p forms ns leaf)) 0)
                              (do
                                (push! (mut work) (unit-variant-sum-leaf p forms ns leaf))
                                0)
                            ; A trait the module wrote: its source. One its metaprograms
                            ; produced: its checked signature.
                            (!= (primitive/cast i64 (unit-find-trait p qname)) 0)
                              (if (and form? (= fhead "deftrait"))
                                  (do
                                    (unit-copy-form! (mut copied) text form)
                                    (unit-collect-syms! form (mut work))
                                    (set! copies-source true)
                                    0)
                                  (match (unit-write-trait! a (mut types-out) (unit-find-trait p qname)
                                                            ns (mut mods) (mut work))
                                    (Some [e]
                                      (when (match (load err) (None [] true) (_ false))
                                        (set! err (Some e)))
                                      0)
                                    (None [] 0)))
                            ; A trait's method: its trait declares it.
                            (> (len (unit-method-trait-leaf p ns leaf)) 0)
                              (do
                                (push! (mut work) (unit-method-trait-leaf p ns leaf))
                                0)
                            ; An export of a name the module re-exports: the re-export
                            ; import the interface carries passes it on.
                            (and is-root (unit-ptr-has? reexported leaf))
                              0
                            ; An export naming nothing a unit can express (a macro another
                            ; macro produced, a runtime value): refuse. A NON-root name that
                            ; resolves to nothing here is simply another module's symbol the
                            ; copied form references, and its own imports cover it.
                            ; A constant its metaprograms generated: its value, when the
                            ; checked program holds it as a literal.
                            (unit-write-literal-const! a (mut types-out) p qname leaf)
                              0
                            is-root
                              (do
                                (when (match (load err)
                                        (None [] true)
                                        (_ false))
                                  (set! err
                                        (Some (sconcat3 a
                                                        (sconcat3 a
                                                                  "cannot prebuild '"
                                                                  ns
                                                                  "': it makes public '")
                                                        leaf
                                                        "', which its metaprograms generated as a generic function, macro, generic type or computed constant; a unit carries a generated definition only when it compiles to a declaration (a concrete function, record, sum, trait, C function, convention or literal constant), and copies as source only what the module wrote")))
                                  0)
                                0)
                            :else 0))))
                0)))
    (match (load err)
      (Some [e] (Err [(slice u8) (slice u8)] e))
      (None []
            (let [(mut out) (StrBuf::new a)]
              (push-str! (mut out) ";; Interface of the prebuilt unit `")
              (push-str! (mut out) ns)
              (push-str! (mut out)
                         "`, written by `coil build-unit`. Do not edit: the\n;; object beside it defines what is declared here, and a consumer reads this\n;; file in place of the module's source.\n(module ")
              (push-str! (mut out) ns)
              (push-str! (mut out) ")\n")
              ; Copied source needs the module's own imports (their aliases);
              ; printed declarations name their types' modules in full. Import
              ; each such module the copied imports do not already name.
              (let [copied-imports
                      (if (load copies-source)
                          (str (load import-forms))
                          (str (load reexport-forms)))]
                (push-str! (mut out) copied-imports)
                (for [i 0 (len (load mods))]
                  (let [m (get (load mods) i)]
                    ; coil.core is every module's implicit import; naming it
                    ; explicitly would REPLACE that import and hide its traits.
                    (unless (or (= m "coil.core")
                                (some? (find copied-imports (sconcat3 a "\"" m "\""))))
                      (push-str! (mut out) "(import \"")
                      (push-str! (mut out) m)
                      (push-str! (mut out) "\")\n")
                      0))
                  0))
              ; The export list keeps what the interface declares only for its own
              ; use (a helper a copied generic calls, a forwarding wrapper) private.
              ; It names re-exported names too, as a module's export list limits
              ; its re-exports: with an export list of its own the module already
              ; names the ones it passes on; without one, it passes on all of them.
              (let [(mut public) (ArrayList::new [(slice u8)] a)]
                (for [i 0 (len (load roots))] (unit-add! (mut public) (get (load roots) i)) 0)
                (unless listed
                  (for [i 0 (len (load reexported))]
                    (unit-add! (mut public) (get (load reexported) i))
                    0)
                  0)
                (when (> (len public) 0)
                  (push-str! (mut out) "(export")
                  (for [i 0 (len public)]
                    (push! (mut out) (: 32 u8))
                    (push-str! (mut out) (get public i))
                    0)
                  (push-str! (mut out) ")\n")
                  0))
              (push-str! (mut out) (str (load types-out)))
              (push-str! (mut out) (str (load decls)))
              (push-str! (mut out) (str (load copied)))
              (push-str! (mut out) (str (load forward-out)))
              (Ok [(slice u8) (slice u8)] (str (load out))))))))
