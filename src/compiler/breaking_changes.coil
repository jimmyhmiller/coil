; Fast, syntax-only probes for source spellings that a newer Coil toolchain can
; migrate mechanically. This is deliberately separate from the linter:
;
;   * this file answers only "should build offer a migration?" without loading or
;     typechecking a project;
;   * coil.modernize remains the one implementation of the actual safe rewrites;
;   * adding a breaking change means adding its old call head here and its checked
;     rewrite to the standard lint profile.
;
; Match parsed symbols rather than bytes, so examples in comments and strings do
; not make every future build nag the user.
(module breaking_changes)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use [slice-get slice-len])
(import "coil.reader" :use *)

; Only spellings that are no longer accepted belong here. `primitive/load`,
; `primitive/store!`, and `primitive/field` remain valid low-level operations:
; the semantic linter can modernize some uses, but a reader-only scan cannot know
; which ones without types. Treating all of them as breaking made the compiler
; nag about its own metaprogram ABI shim forever.
(defn breaking-head? [(name (slice u8))] (-> bool)
  (cond (= name "alloc-stack") true
        (= name "alloc-static") true
        (= name "alloc-heap") true
        :else false))

(defn breaking-import-path? [(name (slice u8))] (-> bool)
  (let [n (slice-len [u8] name)
        (mut i) 0
        (mut slash) false]
    (loop (if (or (>= (load i) n) (load slash))
              (break)
              (do
                (when (= (primitive/cast i64 (slice-get [u8] name (load i))) 47)
                  (set! slash true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (or (load slash)
        (and (>= n (cast i64 5))
             (and (= (primitive/cast i64 (slice-get [u8] name (- n 5))) 46)
                  (and (= (primitive/cast i64 (slice-get [u8] name (- n 4))) 99)
                       (and (= (primitive/cast i64 (slice-get [u8] name (- n 3))) 111)
                            (and (= (primitive/cast i64 (slice-get [u8] name (- n 2))) 105)
                                 (= (primitive/cast i64 (slice-get [u8] name (- n 1))) 108)))))))))

(defn breaking-list-head? [(items (ptr (ArrayList Sexp)))] (-> bool)
  (let [n (al-len [Sexp] (load items))]
    (and (> n (cast i64 0))
         (match (.kind (al-elem [Sexp] items 0))
           (KSym [name]
                 (or (breaking-head? name)
                     (and (= name "import")
                          (and (> n (cast i64 1))
                               (match (.kind (al-elem [Sexp] items 1))
                                 (KStr [path] (breaking-import-path? path))
                                 (_ false))))))
           (_ false)))))

(defn breaking-form? [(form Sexp)] (-> bool)
  (match (.kind form)
    (KList [items]
           (if (breaking-list-head? items)
               true
               (breaking-forms? items 0)))
    (KVec [items] (breaking-forms? items 0))
    (_ false)))

(defn breaking-forms? [(forms (ptr (ArrayList Sexp))) (i i64)] (-> bool)
  (if (>= i (al-len [Sexp] (load forms)))
      false
      (or (breaking-form? (load (al-elem [Sexp] forms i)))
          (breaking-forms? forms (primitive/iadd i 1)))))

;; True only for readable Coil containing a catalogued obsolete form. A damaged
;; file is the compiler diagnostic's job; it must not turn a build into a migration
;; prompt which cannot repair it.
(defn breaking-changes-in-source? [(a (dyn Allocator)) (src (slice u8))] (-> bool)
  (try (let [forms (try-or! (read-all a src 0) false)] (breaking-forms? forms 0))))
