; Fast, syntax-only probes for source spellings that a newer Coil toolchain can
; migrate mechanically. This is deliberately separate from the linter:
;
;   * this file answers only "should build offer a migration?" without loading or
;     typechecking a project;
;   * coil.modernize remains the one implementation of the actual safe rewrites;
;   * adding a breaking change means adding its old call head here and its checked
;     rewrite to the standard lint profile.
;
; Match parsed symbols rather than bytes, so examples in comments and strings do
; not make every future build nag the user.
(module breaking_changes)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)

; The catalog of obsolete call heads for which `coil lint --fix` owns a safe
; migration. Keep this intentionally narrow: ordinary style lint does not belong
; in the build-time offer.
(defn breaking-head? [(name (slice u8))] (-> bool)
  (cond (= name "primitive/load") true
        (= name "primitive/store!") true
        (= name "primitive/field") true
        :else false))

(defn breaking-form? [(form Sexp)] (-> bool)
  (match (load (field form kind))
    (KList [items]
           (if (and (> (al-len [Sexp] (load items)) (cast i64 0))
                    (match (load (field (al-elem [Sexp] items 0) kind))
                      (KSym [name] (breaking-head? name))
                      (_ false)))
               true
               (breaking-forms? items 0)))
    (KVec [items] (breaking-forms? items 0))
    (_ false)))

(defn breaking-forms? [(forms (ptr (ArrayList Sexp))) (i i64)] (-> bool)
  (if (>= i (al-len [Sexp] (load forms)))
      false
      (or (breaking-form? (load (al-elem [Sexp] forms i)))
          (breaking-forms? forms (primitive/iadd i 1)))))

;; True only for readable Coil containing a catalogued obsolete form. A damaged
;; file is the compiler diagnostic's job; it must not turn a build into a migration
;; prompt which cannot repair it.
(defn breaking-changes-in-source? [(a (ptr Allocator)) (src (slice u8))] (-> bool)
  (match (read-all a src 0)
    (Ok [forms] (breaking-forms? forms 0))
    (Err [_] false)))
