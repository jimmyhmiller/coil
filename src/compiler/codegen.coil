; src/compiler/codegen.coil — self-host Coil compiler, codegen module.
(module codegen)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "ffi" :use *)
(import "coil.reader" :use *)
(import "ast" :use *)
(import "astdump" :use *)
(import "check" :use *)
(import "comptime" :use *)
(import "loader" :use *)
(import "normalize" :use *)
(import "parser" :use *)
(import "resolve" :use *)
(import "layoutdb" :use *)

(defstruct Tv [(val (ptr i8)) (ty Type)])
(defn mk-tv [(v (ptr i8)) (t Type)] (-> Tv)
  (let [p (primitive/alloc-stack Tv)] (set! (.val p) v) (set! (.ty p) t) (load p)))
(defn tv-val [(t Tv)] (-> (ptr i8))
  (let [p (primitive/alloc-stack Tv)] (set! p t) (load (field p val))))
(defn tv-ty [(t Tv)] (-> Type)
  (let [p (primitive/alloc-stack Tv)] (set! p t) (.ty p)))

; ---- scope: a persistent cons-list (HashMap<String,Tv> with clone+insert = cons,
;      lookup = linear-from-head so a later binding shadows an earlier one).
(defsum Scope
  (SNil [])
  (SBind [(name (slice u8)) (val (ptr i8)) (ty Type) (rest (ptr Scope))]))
(defn scope-nil [(a (dyn Allocator))] (-> (ptr Scope))
  (box! a Scope (SNil)))
(defn scope-put [(a (dyn Allocator)) (s (ptr Scope)) (name (slice u8)) (v (ptr i8)) (t Type)] (-> (ptr Scope))
  (box! a
        Scope
        (SBind
          :name name
          :val v
          :ty t
          :rest s)))
(defn scope-get [(s (ptr Scope)) (name (slice u8))] (-> (Option Tv))
  (match (load s)
    (SNil [] (None [Tv]))
    (SBind [n v t rest] (if (= n name) (Some [Tv] (mk-tv v t)) (scope-get rest name)))))

; ---- C-ABI struct-by-value classification (StructAbi/Class + the codegen
;      ArgAbi/CSig). AArch64 AAPCS64 only (the self-host target); the SysV path is
;      a hard-error stub (never reached). StructAbi/CSig are always handled BY
;      POINTER (never threaded by value), Option = a null (ptr …).
(defsum AbiClass
  ; Passed/returned directly in register slots, coerced to these LLVM types.
  (ACDirect [(slots (ptr (ArrayList (ptr i8))))])
  ; Passed indirectly (pointer to a copy / sret). `align` = the struct's ABI align.
  (ACIndirect [(align i32)]))
(defstruct StructAbi
  [(arg AbiClass) (ret AbiClass) (llvm_ty (ptr i8)) (size i64) (align i32)])
(defsum ArgAbiK
  (AAScalar [])
  (AADirect [(sa (ptr StructAbi))])
  (AAIndirect [(sa (ptr StructAbi))]))
(defstruct CSig
  [(sret (ptr StructAbi))  ; null = scalar/direct return
   (ret_direct (ptr StructAbi))  ; null = scalar/sret/void return
   (args (ptr (ArrayList ArgAbiK)))
   (fn_ty (ptr i8))])
(defstruct CSigEntry [(name (slice u8)) (sig (ptr CSig))])
; One scalar leaf of a (possibly nested) struct, for the SysV field-walk
; Leaf): its absolute byte offset, byte size, SysV class (0=None 1=Integer 2=Sse),
; and whether the leaf is a 32-bit float. `AbiLeafBox` wraps the accumulator list so
; it can be threaded by pointer (the established self-host push-through-pointer idiom).
(defstruct AbiLeaf [(offset i64) (size i64) (cls i64) (is_f32 bool)])
(defstruct AbiLeafBox [(items (ArrayList AbiLeaf))])

; ---- Cg: codegen state. Maps are
;      ArrayLists keyed by name (the established self-host pattern; mono uses it).
(defstruct CgStruct [(name (slice u8)) (fields (ptr (ArrayList Field))) (ty (ptr i8)) (layout Layout)])
(defstruct CgSum
  [(name (slice u8)) (variants (ptr (ArrayList Variant))) (ty (ptr i8)) (vstructs (ptr (ArrayList (ptr i8))))])
(defstruct CgFunc [(name (slice u8)) (val (ptr i8))])
(defstruct CgRet [(name (slice u8)) (ty Type)])
(defstruct CgSig [(name (slice u8)) (cc (slice u8)) (params (ptr (ArrayList Type))) (ret Type)])
(defstruct CgBreak [(val (ptr i8)) (bb (ptr i8))])
(defstruct CgLoop
  [(label (Option (slice u8)))
   (body_bb (ptr i8))
   (after_bb (ptr i8))
   (breaks (ArrayList CgBreak))
   (break_ty (Option Type))])
(defstruct CgStatic [(name (slice u8)) (ptr (ptr i8)) (ty Type)])
; A `:shim` convention function's realization: the `ccc` __impl
; function that carries the body, plus the convention's register layout.
(defstruct CgShim
  [(name (slice u8))
   (impl_fn (ptr i8))
   (param_regs (ptr (ArrayList (slice u8))))
   (ret_reg (slice u8))
   (clobber (ptr (ArrayList (slice u8))))])
(defstruct Cg
  [(ctx (ptr i8))
   (module (ptr i8))
   (builder (ptr i8))
   (td (ptr i8))
   (layouts LayoutDb)
   (structs (ArrayList CgStruct))
   (sums (ArrayList CgSum))
   (funcs (ArrayList CgFunc))
   ; always-inline names, used to keep their calls out of musttail form
   (inline_funcs (HashMap (slice u8) bool))
   (rets (ArrayList CgRet))
   (sigs (ArrayList CgSig))
   (statics (ArrayList CgStatic))
   (shims (ArrayList CgShim))  ; :shim-convention functions
   (globals i64)
   (nstatic i64)  ; stable alloc-static ordinal within the current function
   (llvm_seq i64)
   (loops (ArrayList CgLoop))
   (csigs (ArrayList CSigEntry))  ; only struct-by-value callables
   (reset_func (ptr i8))
   (arch i64)  ; 0 = x86_64, 1 = aarch64, 2 = wasm32, 3 = riscv32
   (mach_o bool)  ; Mach-O (Apple) => asm symbols carry a leading `_`
   (sanitizer i64)  ; 0=off, 1=ASan, 2=TSan, 3=MSan, 4=UBSan checks
   (debug_checks bool)
   (a (dyn Allocator))])

; ---- map lookups (linear; names are unique so first/last match is the same) ----
(defn cg-inline-func? [(cg (ptr Cg)) (name (slice u8))] (-> bool)
  (hm-contains? [(slice u8) bool] (.inline_funcs cg) name))
(defn cg-struct-idx [(cg (ptr Cg)) (nm (slice u8))] (-> i64)
  (struct-index (field cg layouts) nm))
(defn cg-sum-idx [(cg (ptr Cg)) (nm (slice u8))] (-> i64)
  (sum-index (field cg layouts) nm))
(defn cg-func [(cg (ptr Cg)) (nm (slice u8))] (-> (ptr i8))  ; 0 if absent
  (let [n (al-len [CgFunc] (.funcs cg))
        (mut i) 0
        (mut r) (primitive/cast (ptr i8) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [CgFunc] (field cg funcs) (load i))]
                  (when (= (load (field fp name)) nm)
                    (store! r
                            (load (field fp
                                         val)))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn cg-ret [(cg (ptr Cg)) (nm (slice u8))] (-> (Option Type))
  (let [n (al-len [CgRet] (.rets cg))
        (mut i) 0
        (mut r) (None [Type])]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [CgRet] (field cg rets) (load i))]
                  (when (= (load (field fp name)) nm)
                    (store! r
                            (Some [Type]
                                  (load (field fp
                                               ty))))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn cg-sig-idx [(cg (ptr Cg)) (nm (slice u8))] (-> i64)
  (let [n (al-len [CgSig] (.sigs cg))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [CgSig] (field cg sigs) (load i)) name)) nm)
                  (store! r
                          (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn cg-static-idx [(cg (ptr Cg)) (nm (slice u8))] (-> i64)
  (let [n (al-len [CgStatic] (.statics cg))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [CgStatic] (field cg statics) (load i)) name)) nm)
                  (store! r (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; ---- small FFI conveniences ----
(defn cg-bug [(msg (slice u8))] (-> Tv)
  (unimplemented msg)
  (mk-tv (primitive/cast (ptr i8) 0) (TInt 64 true)))
(defn ty-is-void [(t (ptr Type))] (-> bool)
  (match (load t) (TVoid [] true) (_ false)))
(defn int-width [(ctx (ptr i8)) (bits i64)] (-> (ptr i8))
  (LLVMIntTypeInContext ctx (primitive/cast i32 bits)))
; an ArrayList of opaque handles -> a contiguous C array (ptr (ptr i8)).
(defn carr [(a (dyn Allocator)) (xs (ArrayList (ptr i8)))] (-> (ptr (ptr i8)))
  (let [n (al-len [(ptr i8)] xs)
        buf
          (primitive/cast (ptr (ptr i8))
                          (primitive/cast (ptr i8)
                                          (slice-data (match (alloc-bytes a
                                                                          (primitive/imul (if (= n
                                                                                                 (primitive/cast i64 0))
                                                                                              1
                                                                                              n)
                                                                                          8)
                                                                          8)
                                                        (Some [s] s)
                                                        (None []
                                                              (do
                                                                (oom-at c"compiler allocation"
                                                                        (primitive/imul (if (= n (primitive/cast i64 0))
                                                                                            1
                                                                                            n)
                                                                                        8))
                                                                (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0)))))))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (primitive/index buf (load i)) (al-get [(ptr i8)] xs (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    buf))
; LLVMConstInt of `ty` for value 0 (the const_zero of an int/bool type).
(defn cg-zero [(ty (ptr i8))] (-> (ptr i8))
  (LLVMConstInt ty 0 0))

; ---- the slice fat-pointer type { ptr, i64 } (a fresh literal struct; LLVM
;      uniques it so repeated calls return the same type, exactly like the LLVM API).
(defn cg-slice-ty [(cg (ptr Cg))] (-> (ptr i8))
  (let [ctx (load (field cg ctx))
        (mut fs) (al-new [(ptr i8)] (load (field cg a)))]
    (al-push! (mut fs) (LLVMPointerTypeInContext ctx 0))
    (al-push! (mut fs) (LLVMInt64TypeInContext ctx))
    (LLVMStructTypeInContext ctx (carr (load (field cg a)) (load fs)) 2 0)))

; ---- basic_ty: Coil Type -> LLVM type. void/App/Code are
;      compiler-bug paths (hard error, never a placeholder).
(defn basic-ty [(cg (ptr Cg)) (t (ptr Type))] (-> (ptr i8))
  (let [ctx (load (field cg ctx))]
    (match (load t)
      (TNever [] (LLVMInt64TypeInContext ctx))
      (TInt [bits s] (int-width ctx bits))
      (TFloat [b] (if (= b (primitive/cast i64 32)) (LLVMFloatTypeInContext ctx) (LLVMDoubleTypeInContext ctx)))
      (TBool [] (LLVMInt1TypeInContext ctx))
      (TPtr [i] (LLVMPointerTypeInContext ctx 0))
      (TRef [m i] (LLVMPointerTypeInContext ctx 0))
      (TFn [c p r] (LLVMPointerTypeInContext ctx 0))
      (TArray [el n] (LLVMArrayType2 (basic-ty cg el) n))
      (TSlice [el] (cg-slice-ty cg))
      (TStruct [nm] (cg-nominal-ty cg nm))
      (TVec [el n] (LLVMVectorType (basic-ty cg el) (primitive/cast i32 n)))
      ; `externref` is a wasm reference: an addrspace(10) pointer LLVM's wasm backend
      ; lowers to the externref value type. Opaque, scalar, never in linear memory.
      (TExternRef [] (LLVMPointerTypeInContext ctx 10))
      (TVoid []
             (do
               (unimplemented "codegen/basic_ty: void reached as a value type (checker hole)")
               (primitive/cast (ptr i8) 0)))
      (TApp [n a]
            (do (unimplemented "codegen/basic_ty: generic type survived monomorphization") (primitive/cast (ptr i8) 0)))
      (TCode [] (do (unimplemented "codegen/basic_ty: comptime-only Code reached codegen") (primitive/cast (ptr i8) 0)))
      (TCodeBuilder []
                    (do
                      (unimplemented "codegen/basic_ty: comptime-only CodeBuilder reached codegen")
                      (primitive/cast (ptr i8) 0))))))
(defn cg-nominal-ty [(cg (ptr Cg)) (nm (slice u8))] (-> (ptr i8))
  (let [ctx (load (field cg ctx))
        si (cg-struct-idx cg nm)]
    (if (>= si (primitive/cast i64 0))
        (let [sp (al-elem [CgStruct] (field cg structs) si)]
          (match (.layout sp) (LBits [backing offs] (int-width ctx backing)) (_ (load (field sp ty)))))
        (let [ui (cg-sum-idx cg nm)]
          (if (>= ui (primitive/cast i64 0))
              (load (field (al-elem [CgSum] (field cg sums) ui) ty))
              (do (unimplemented "codegen/basic_ty: unknown nominal type") (primitive/cast (ptr i8) 0)))))))

; ---- layout helpers: one shared source for runtime representation.
; align8 also remains a local LLVM ABI utility for padded temporary slots.
(defn align8 [(x i64)] (-> i64)
  (primitive/imul (primitive/udiv (primitive/iadd x 7) 8) 8))
(defn cg-sum-words [(cg (ptr Cg)) (sp (ptr CgSum))] (-> i64)
  (sum-words (field cg layouts) (load (field sp variants))))
(defn cg-sum-words-def [(cg (ptr Cg)) (sd (ptr SumDef))] (-> i64)
  (sum-words (field cg layouts) (load (field sd variants))))
(defn cg-sum-word-ty [(cg (ptr Cg))] (-> (ptr i8))
  (if (= (.arch cg) (primitive/cast i64 3)) (cg-i32t cg) (cg-i64t cg)))
; Keep LLVM authoritative for target-dependent scalar/view types (notably
; wasm32 pointers). Declared struct layouts, and arrays of them, are Coil's
; contract and come from the shared database.
(defn cg-layout-size [(cg (ptr Cg)) (t (ptr Type))] (-> i64)
  (match (load t)
    (TStruct [name]
             (if (>= (struct-index (field cg layouts) name) (primitive/cast i64 0))
                 (size (field cg layouts) t)
                 (LLVMABISizeOfType (load (field cg td)) (basic-ty cg t))))
    (TArray [elem n] (primitive/imul (cg-layout-size cg elem) n))
    (_ (LLVMABISizeOfType (load (field cg td)) (basic-ty cg t)))))
(defn cg-layout-align [(cg (ptr Cg)) (t (ptr Type))] (-> i64)
  (match (load t)
    (TStruct [name]
             (if (>= (struct-index (field cg layouts) name) (primitive/cast i64 0))
                 (align (field cg layouts) t)
                 (primitive/cast i64 (LLVMABIAlignmentOfType (load (field cg td)) (basic-ty cg t)))))
    (TArray [elem _n] (cg-layout-align cg elem))
    (_ (primitive/cast i64 (LLVMABIAlignmentOfType (load (field cg td)) (basic-ty cg t))))))
; ---- offset_of / const_eval (for static-assert) ----
(defn cg-offset-of [(cg (ptr Cg)) (t (ptr Type)) (fname (slice u8))] (-> i64)
  (match (load t)
    (TStruct [nm]
             (let [si (cg-struct-idx cg nm)]
               (if (< si (primitive/cast i64 0))
                   (do (unimplemented "codegen/offsetof: non-struct") 0)
                   (let [sp (al-elem [CgStruct] (field cg structs) si)
                         idx (field-number (field cg layouts) si fname)]
                     (match (.layout sp)
                       (LBits [_ _] 0)
                       (_ (field-offset (field cg layouts) si idx)))))))
    (_ (do (unimplemented "codegen/offsetof: needs a struct") 0))))
; const_eval_t -> (value, is_unsigned). Faithful to:3153.
(defstruct CEval [(v i64) (uns bool)])
(defn mk-ceval [(v i64) (u bool)] (-> CEval)
  (let [p (primitive/alloc-stack CEval)] (set! (.v p) v) (set! (.uns p) u) (load p)))
(defn cev-v [(c CEval)] (-> i64)
  (let [p (primitive/alloc-stack CEval)] (set! p c) (.v p)))
(defn cev-u [(c CEval)] (-> bool)
  (let [p (primitive/alloc-stack CEval)] (set! p c) (.uns p)))
; A spanless codegen error (A spanless error is rendered by `report` as a
; bare `error: <msg>` + exit 1). The self-host's codegen paths (const-eval-t → CEval,
; emit-expr → Tv, the extern C-ABI check → i64) have no Result channel, so — exactly
; like the assertion-failed case — print the rendered line and exit(1). The stderr
; text + exit code are byte-identical to the front-end returning the Err. Used for
; static-assert folding, the by-value-view C-ABI rejection, and bitwise-op-on-float.
(defn cg-fail [(msg (slice u8))] (-> i64)
  (let [w (stderr)] (ps w "error: ") (ps w msg) (wb w 10) (exit 1) 0))
(defn const-eval-bin [(op i64) (l i64) (lu bool) (r i64) (ru bool)] (-> CEval)
  (let [uns (or lu ru)]
    (mk-ceval (cond (= op (primitive/cast i64 0)) (primitive/iadd l r)
                    (= op (primitive/cast i64 1)) (primitive/isub l r)
                    (= op (primitive/cast i64 2)) (primitive/imul l r)
                    (= op (primitive/cast i64 7)) (primitive/iand l r)
                    (= op (primitive/cast i64 8)) (primitive/ior l r)
                    (= op (primitive/cast i64 9)) (primitive/ixor l r)
                    (= op (primitive/cast i64 10)) (primitive/ishl l r)
                    (= op (primitive/cast i64 11))
                      (if uns
                          (primitive/cast i64 (primitive/ishr (primitive/cast u64 l) (primitive/cast u64 r)))
                          (primitive/ishr l r))
                    (= op (primitive/cast i64 3))
                      (if (= r (primitive/cast i64 0))
                          (do (cg-fail "static-assert: divide/mod by zero") 0)
                          (if uns (primitive/udiv l r) (primitive/idiv l r)))
                    (= op (primitive/cast i64 4))
                      (if (= r (primitive/cast i64 0))
                          (do (cg-fail "static-assert: divide/mod by zero") 0)
                          (if uns (primitive/urem l r) (primitive/irem l r)))
                    (= op (primitive/cast i64 5))
                      (if (= r (primitive/cast i64 0))
                          (do (cg-fail "static-assert: divide/mod by zero") 0)
                          (primitive/udiv l r))
                    (= r (primitive/cast i64 0)) (do (cg-fail "static-assert: divide/mod by zero") 0)
                    :else (primitive/urem l r))
              uns)))
(defn const-eval-cmp [(op i64) (l i64) (lu bool) (r i64) (ru bool)] (-> CEval)
  (let [b
          (cond (or lu ru)
                  (let [lx (primitive/cast u64 l)
                        rx (primitive/cast u64 r)]
                    (cond (= op (primitive/cast i64 0)) (< lx rx)
                          (= op (primitive/cast i64 1)) (<= lx rx)
                          (= op (primitive/cast i64 2)) (> lx rx)
                          (= op (primitive/cast i64 3)) (>= lx rx)
                          (= op (primitive/cast i64 4)) (= lx rx)
                          :else (!= lx rx)))
                (= op (primitive/cast i64 0)) (< l r)
                (= op (primitive/cast i64 1)) (<= l r)
                (= op (primitive/cast i64 2)) (> l r)
                (= op (primitive/cast i64 3)) (>= l r)
                (= op (primitive/cast i64 4)) (= l r)
                :else (!= l r))]
    (mk-ceval (when b 1) false)))
(defn const-eval-t [(cg (ptr Cg)) (e (ptr Expr))] (-> CEval)
  (let [a (load (field cg a))]
    (match (.kind e)
      (EInt [v] (mk-ceval v false))
      (EBool [b] (mk-ceval (when b 1) false))
      (EIf [c thn els]
           (if (!= (cev-v (const-eval-t cg c)) (primitive/cast i64 0))
               (const-eval-t cg thn)
               (const-eval-t cg els)))
      (ESizeOf [t] (mk-ceval (cg-layout-size cg (box-type a t)) false))
      (EAlignOf [t]
                (mk-ceval (cg-layout-align cg (box-type a t)) false))
      (EOffsetOf [t fname] (mk-ceval (cg-offset-of cg (box-type a t) fname) false))
      (ECast [t inner]
             (mk-ceval (cev-v (const-eval-t cg inner)) (match t (TInt [bits s] (not s)) (_ false))))
      (EBin [op lhs rhs]
            (let [lc (const-eval-t cg lhs)
                  rc (const-eval-t cg rhs)]
              (const-eval-bin op (cev-v lc) (cev-u lc) (cev-v rc) (cev-u rc))))
      (ECmp [op lhs rhs]
            (let [lc (const-eval-t cg lhs)
                  rc (const-eval-t cg rhs)]
              (const-eval-cmp op (cev-v lc) (cev-u lc) (cev-v rc) (cev-u rc))))
      (_ (do
           (cg-fail "static-assert: only int literals, sizeof/alignof/offsetof, casts, arithmetic and comparisons are allowed")
           (mk-ceval 0 false))))))
(defn const-eval [(cg (ptr Cg)) (e (ptr Expr))] (-> i64)
  (cev-v (const-eval-t cg e)))

; ---- builder conveniences ----
(defn cg-bld [(cg (ptr Cg))] (-> (ptr i8))
  (load (field cg builder)))
(defn cg-ctx [(cg (ptr Cg))] (-> (ptr i8))
  (load (field cg ctx)))
(defn cg-i64t [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMInt64TypeInContext (cg-ctx cg)))
(defn cg-i32t [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMInt32TypeInContext (cg-ctx cg)))
(defn cg-const-i64 [(cg (ptr Cg)) (n i64)] (-> (ptr i8))
  (LLVMConstInt (cg-i64t cg) n 1))
(defn cg-zero-i64 [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMConstInt (cg-i64t cg) 0 0))
(defn cg-append [(cg (ptr Cg)) (func (ptr i8)) (nm (ptr i8))] (-> (ptr i8))
  (LLVMAppendBasicBlockInContext (cg-ctx cg) func nm))
(defn cg-pos [(cg (ptr Cg)) (bb (ptr i8))] (-> i64)
  (LLVMPositionBuilderAtEnd (cg-bld cg) bb)
  0)
(defn cg-cur-block [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMGetInsertBlock (cg-bld cg)))
(defn cg-cur-func [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMGetBasicBlockParent (cg-cur-block cg)))
; Entry-block alloca: a constant-size alloca is a STATIC (allocate-once) frame
; slot only when it sits in the function's ENTRY block. Emitted inline inside a
; loop it becomes a DYNAMIC per-iteration stack growth — the cause of unbounded
; stack use when compiling large programs (e.g. a by-value-aggregate `al-push!`
; loop). Build compiler-internal temp/spill slots here so each is allocated once
; and reused across iterations. Mirrors.
(defn cg-entry-alloca [(cg (ptr Cg)) (ty (ptr i8)) (name (ptr i8))] (-> (ptr i8))
  (let [b (cg-bld cg)
        cur (LLVMGetInsertBlock b)
        entry (LLVMGetEntryBasicBlock (LLVMGetBasicBlockParent cur))
        first (LLVMGetFirstInstruction entry)]
    (if (= (primitive/cast i64 first) (primitive/cast i64 0))
        (do (LLVMPositionBuilderAtEnd b entry) 0)
        (do (LLVMPositionBuilderBefore b first) 0))
    (let [slot (LLVMBuildAlloca b ty name)]
      (LLVMPositionBuilderAtEnd b cur)
      slot)))
(defn cg-terminated [(cg (ptr Cg))] (-> bool)
  (!= (primitive/cast i64 (LLVMGetBasicBlockTerminator (cg-cur-block cg))) (primitive/cast i64 0)))
(defn cg-bl [(cg (ptr Cg)) (s (slice u8))] (-> (ptr i8))
  (str->cstr (load (field cg a)) s))
; next global counter value (shared g/str/cstr counter, per).
(defn cg-next-global [(cg (ptr Cg))] (-> i64)
  (let [n (.globals cg)] (set! (.globals cg) (primitive/iadd n 1)) n))
(defn cg-gname [(cg (ptr Cg)) (prefix (slice u8)) (n i64)] (-> (ptr i8))
  (str->cstr (load (field cg a))
             (sconcat (load (field cg a))
                      prefix
                      (i64->str (load (field cg
                                             a))
                                n))))
; build a function type from Coil params/ret (fn_type_types), possibly variadic.
(defn cg-fn-type-v [(cg (ptr Cg)) (params (ptr (ArrayList Type))) (ret (ptr Type)) (variadic bool)] (-> (ptr i8))
  (let [n (al-len [Type] (load params))
        (mut tys) (al-new [(ptr i8)] (load (field cg a)))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut tys) (basic-ty cg (al-elem [Type] params (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (let [rt (if (ty-is-void ret) (LLVMVoidTypeInContext (cg-ctx cg)) (basic-ty cg ret))]
      (LLVMFunctionType rt (carr (load (field cg a)) (load tys)) (primitive/cast i32 n) (when variadic 1)))))
(defn cg-fn-type [(cg (ptr Cg)) (params (ptr (ArrayList Type))) (ret (ptr Type))] (-> (ptr i8))
  (cg-fn-type-v cg params ret false))

; ===== calling conventions +:shim trampolines =====
; A convention name -> its Convention (null if absent) in the codegen Program.
(defn cg-prog-conv [(p (ptr Program)) (name (slice u8))] (-> (ptr Convention))
  (let [cs (load (field p conventions))
        n (al-len [Convention] (load cs))
        (mut i) 0
        (mut r) (primitive/cast (ptr Convention) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (conv-name (al-get [Convention] (load cs) (load i))) name)
                  (store! r (al-elem [Convention] cs (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
; native-cc code -> LLVM CallingConv.h id.
(defn native-cc-llvm-id [(code i64)] (-> i64)
  (cond (= code (primitive/cast i64 0)) 0
        (= code (primitive/cast i64 1)) 8
        (= code (primitive/cast i64 2)) 9
        (= code (primitive/cast i64 3)) 18
        (= code (primitive/cast i64 4)) 20
        :else (do (unimplemented "codegen: unknown native calling-convention code") 0)))
; LLVM call-conv id for a native convention; -1 for a :shim (no native id).
(defn conv-native-id [(c (ptr Convention))] (-> i64)
  (match (.lowering c)
    (LNative [cc] (native-cc-llvm-id cc))
    (LShim [] -1)
    (LReset [] 0)))

; ---- shim registry ----
(defn cg-add-shim [(cg (ptr Cg))
                   (name (slice u8))
                   (impl-fn (ptr i8))
                   (param-regs (ptr (ArrayList (slice u8))))
                   (ret-reg (slice u8))
                   (clobber (ptr (ArrayList (slice u8))))] (-> i64)
  (let [s (primitive/alloc-stack CgShim)]
    (set! (.name s) name)
    (set! (.impl_fn s) impl-fn)
    (set! (.param_regs s) param-regs)
    (set! (.ret_reg s) ret-reg)
    (set! (.clobber s) clobber)
    (al-push! (mut (.shims cg)) (load s))
    0))
(defn cg-shim-find [(cg (ptr Cg)) (name (slice u8))] (-> (ptr CgShim))
  (let [n (al-len [CgShim] (.shims cg))
        (mut i) 0
        (mut r) (primitive/cast (ptr CgShim) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [CgShim] (field cg shims) (load i)) name)) name)
                  (store! r (al-elem [CgShim] (field cg shims) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; ---- arch register model ----
; Mach-O (Apple) target? Its inline-asm symbols carry a leading `_`.
(defn triple-mach-o [(triple (slice u8))] (-> bool)
  (or (match (str-find triple "apple") (Some [x0] true) (None [] false))
      (or (match (str-find triple "darwin") (Some [x1] true) (None [] false))
          (match (str-find triple "macosx") (Some [x2] true) (None [] false)))))
; the name to use when referencing a global symbol from inline asm.
(defn cg-asm-sym [(cg (ptr Cg)) (name (slice u8))] (-> (slice u8))
  (if (.mach_o cg) (sconcat (load (field cg a)) "_" name) name))
; the i-th C-ABI integer/pointer argument register.
(defn cg-c-arg-reg [(cg (ptr Cg)) (i i64)] (-> (slice u8))
  (cond (= (load (field cg arch)) (primitive/cast i64 0))
          (cond (= i (primitive/cast i64 0)) "rdi"
                (= i (primitive/cast i64 1)) "rsi"
                (= i (primitive/cast i64 2)) "rdx"
                (= i (primitive/cast i64 3)) "rcx"
                (= i (primitive/cast i64 4)) "r8"
                (= i (primitive/cast i64 5)) "r9"
                :else (do (unimplemented "codegen: too many shim args for the x86_64 C ABI") ""))
        (= i (primitive/cast i64 0)) "x0"
        (= i (primitive/cast i64 1)) "x1"
        (= i (primitive/cast i64 2)) "x2"
        (= i (primitive/cast i64 3)) "x3"
        (= i (primitive/cast i64 4)) "x4"
        (= i (primitive/cast i64 5)) "x5"
        (= i (primitive/cast i64 6)) "x6"
        (= i (primitive/cast i64 7)) "x7"
        :else (do (unimplemented "codegen: too many shim args for the aarch64 C ABI") "")))
; the C-ABI integer return register.
(defn cg-c-ret-reg [(cg (ptr Cg))] (-> (slice u8))
  (if (= (.arch cg) (primitive/cast i64 0)) "rax" "x0"))
; is `reg` a general-purpose register on the target arch?
(defn aarch64-xreg? [(reg (slice u8))] (-> bool)
  (let [n (slice-len reg)]
    (if (or (< n (primitive/cast i64 2)) (!= (primitive/cast i64 (slice-get reg 0)) (primitive/cast i64 120)))
        false
        (let [(mut i) 1
              (mut v) 0
              (mut ok) true]
          (loop (if (or (>= (load i) n) (not (load ok)))
                    (break)
                    (let [c (primitive/cast i64 (slice-get reg (load i)))]
                      (if (and (>= c (primitive/cast i64 48)) (<= c (primitive/cast i64 57)))
                          (do
                            (set! v (primitive/iadd (primitive/imul (load v) 10) (primitive/isub c 48)))
                            (set! i (primitive/iadd (load i) 1)))
                          (do (set! ok false) 0)))))
          (and (load ok) (<= (load v) (primitive/cast i64 30)))))))
(defn x86-gpr? [(r (slice u8))] (-> bool)
  (let [(mut ok) false]
    (when (= r "rax") (store! ok true) 0)
    (when (= r "rbx") (store! ok true) 0)
    (when (= r "rcx") (store! ok true) 0)
    (when (= r "rdx") (store! ok true) 0)
    (when (= r "rsi") (store! ok true) 0)
    (when (= r "rdi") (store! ok true) 0)
    (when (= r "rbp") (store! ok true) 0)
    (when (= r "rsp") (store! ok true) 0)
    (when (= r "r8") (store! ok true) 0)
    (when (= r "r9") (store! ok true) 0)
    (when (= r "r10") (store! ok true) 0)
    (when (= r "r11") (store! ok true) 0)
    (when (= r "r12") (store! ok true) 0)
    (when (= r "r13") (store! ok true) 0)
    (when (= r "r14") (store! ok true) 0)
    (when (= r "r15") (store! ok true) 0)
    (load ok)))
(defn aarch64-gpr? [(r (slice u8))] (-> bool)
  (let [(mut ok) (aarch64-xreg? r)]
    (when (= r "sp") (store! ok true) 0)
    (when (= r "lr") (store! ok true) 0)
    (when (= r "fp") (store! ok true) 0)
    (when (= r "xzr") (store! ok true) 0)
    (load ok)))
(defn cg-is-valid-gpr [(cg (ptr Cg)) (reg (slice u8))] (-> bool)
  (if (= (.arch cg) (primitive/cast i64 0)) (x86-gpr? reg) (aarch64-gpr? reg)))
; reject a shim convention naming a register that isn't a GPR on the target arch:
; a spanless `error: <msg>` + exit 1, via cg-fail. The message names the arch.
(defn cg-check-gpr [(cg (ptr Cg)) (reg (slice u8)) (what (slice u8))] (-> i64)
  (unless (cg-is-valid-gpr cg reg)
    (let [a (load (field cg a))
          arch (if (= (load (field cg arch)) (primitive/cast i64 0)) "x86_64" "aarch64")]
      (cg-fail (sconcat3 a
                         (sconcat3 a
                                   (sconcat3 a "codegen: shim convention names " what " register '")
                                   reg
                                   "', which is not a general-purpose register on the target architecture (")
                         arch
                         "). Declare the convention per-arch (see src/examples/per-arch.coil).")))))
(defn cg-check-shim-regs [(cg (ptr Cg)) (shim (ptr CgShim)) (n i64)] (-> i64)
  (let [prs (load (field shim param_regs))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (cg-check-gpr cg (al-get [(slice u8)] (load prs) (load i)) "parameter")
                (set! i (primitive/iadd (load i) 1))))))
  (cg-check-gpr cg (.ret_reg shim) "return")
  (let [cl (load (field shim clobber))
        nc (al-len [(slice u8)] (load cl))
        (mut j) 0]
    (loop (if (>= (load j) nc)
              (break)
              (do
                (cg-check-gpr cg (al-get [(slice u8)] (load cl) (load j)) "clobber")
                (set! j (primitive/iadd (load j) 1))))))
  0)

; is `name` one of the used registers (a param reg [0..n) or the return reg)?
(defn cg-reg-in-used [(prs (ptr (ArrayList (slice u8)))) (n i64) (ret-reg (slice u8)) (name (slice u8))] (-> bool)
  (if (= name ret-reg)
      true
      (let [(mut i) 0
            (mut r) false]
        (loop (if (or (>= (load i) n) (load r))
                  (break)
                  (do
                    (when (= (al-get [(slice u8)] (load prs) (load i)) name) (store! r true) 0)
                    (set! i (primitive/iadd (load i) 1)))))
        (load r))))

; ---- trampolines ----
(defn cg-x86-trampoline [(cg (ptr Cg)) (shim (ptr CgShim)) (n i64) (impl-name (slice u8))] (-> (slice u8))
  (let [a (load (field cg a))
        (mut sb) (sb-new a)
        prs (load (field shim param_regs))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (sb-push-str! (mut sb) "movq %")
                (sb-push-str! (mut sb) (al-get [(slice u8)] (load prs) (load i)))
                (sb-push-str! (mut sb) ", %")
                (sb-push-str! (mut sb) (cg-c-arg-reg cg (load i)))
                (sb-push-str! (mut sb) "\n")
                (set! i (primitive/iadd (load i) 1)))))
    (sb-push-str! (mut sb) "subq $$8, %rsp\n")
    (sb-push-str! (mut sb) "call ")
    (sb-push-str! (mut sb) impl-name)
    (sb-push-str! (mut sb) "\n")
    (sb-push-str! (mut sb) "addq $$8, %rsp\n")
    (when (not (= (load (field shim ret_reg)) (cg-c-ret-reg cg)))
      (sb-push-str! (mut sb) "movq %rax, %")
      (sb-push-str! (mut sb) (load (field shim ret_reg)))
      (sb-push-str! (mut sb) "\n")
      0)
    (sb-push-str! (mut sb) "ret\n")
    (sb-str (load sb))))
(defn cg-aarch64-trampoline [(cg (ptr Cg)) (shim (ptr CgShim)) (n i64) (impl-name (slice u8))] (-> (slice u8))
  (let [a (load (field cg a))
        (mut sb) (sb-new a)
        prs (load (field shim param_regs))
        (mut i) 0]
    (sb-push-str! (mut sb) "str x30, [sp, #-16]!\n")
    (loop (if (>= (load i) n)
              (break)
              (do
                (sb-push-str! (mut sb) "mov ")
                (sb-push-str! (mut sb) (cg-c-arg-reg cg (load i)))
                (sb-push-str! (mut sb) ", ")
                (sb-push-str! (mut sb) (al-get [(slice u8)] (load prs) (load i)))
                (sb-push-str! (mut sb) "\n")
                (set! i (primitive/iadd (load i) 1)))))
    (sb-push-str! (mut sb) "bl ")
    (sb-push-str! (mut sb) impl-name)
    (sb-push-str! (mut sb) "\n")
    (when (not (= (load (field shim ret_reg)) (cg-c-ret-reg cg)))
      (sb-push-str! (mut sb) "mov ")
      (sb-push-str! (mut sb) (load (field shim ret_reg)))
      (sb-push-str! (mut sb) ", x0\n")
      0)
    (sb-push-str! (mut sb) "ldr x30, [sp], #16\n")
    (sb-push-str! (mut sb) "ret\n")
    (sb-str (load sb))))
(defn cg-emit-trampoline [(cg (ptr Cg)) (tramp (ptr i8)) (shim (ptr CgShim)) (n i64)] (-> i64)
  (cg-check-shim-regs cg shim n)
  (let [a (load (field cg a))
        b (cg-bld cg)
        ctx (cg-ctx cg)
        entry (cg-append cg tramp (cg-bl cg "entry"))
        impl-name (cg-asm-sym cg (sconcat a (.name shim) "__impl"))
        asm
          (if (= (.arch cg) (primitive/cast i64 0))
              (cg-x86-trampoline cg shim n impl-name)
              (cg-aarch64-trampoline cg shim n impl-name))
        mem "~{memory}"
        void-ty (LLVMFunctionType (LLVMVoidTypeInContext ctx) (carr a (al-new [(ptr i8)] a)) 0 0)]
    (cg-pos cg entry)
    (let [asm-ptr
            (LLVMGetInlineAsm void-ty
                              (primitive/cast (ptr i8) (slice-data [u8] asm))
                              (slice-len asm)
                              (primitive/cast (ptr i8) (slice-data [u8] mem))
                              (slice-len mem)
                              1
                              0
                              0
                              0)]
      (LLVMBuildCall2 b void-ty asm-ptr (carr a (al-new [(ptr i8)] a)) 0 (cg-bl cg ""))
      (LLVMBuildUnreachable b)
      0)))

; ---- register-constrained shim call site ----
(defn cg-shim-constraints [(cg (ptr Cg)) (shim (ptr CgShim)) (n i64)] (-> (slice u8))
  (let [a (load (field cg a))
        (mut sb) (sb-new a)
        prs (load (field shim param_regs))
        ret-reg (.ret_reg shim)]
    (sb-push-str! (mut sb) "={")
    (sb-push-str! (mut sb) ret-reg)
    (sb-push-str! (mut sb) "}")
    (let [(mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (sb-push-str! (mut sb) ",{")
                  (sb-push-str! (mut sb) (al-get [(slice u8)] (load prs) (load i)))
                  (sb-push-str! (mut sb) "}")
                  (set! i (primitive/iadd (load i) 1))))))
    (let [cl (load (field shim clobber))
          nc (al-len [(slice u8)] (load cl))
          (mut j) 0]
      (loop (if (>= (load j) nc)
                (break)
                (do
                  (let [c (al-get [(slice u8)] (load cl) (load j))]
                    (when (not (cg-reg-in-used prs n ret-reg c))
                      (sb-push-str! (mut sb) ",~{")
                      (sb-push-str! (mut sb) c)
                      (sb-push-str! (mut sb) "}")
                      0))
                  (set! j (primitive/iadd (load j) 1))))))
    ; the `bl` clobbers the link register on AArch64; spell it `lr` so LLVM forces
    ; the caller to save/restore it.
    (when (and (= (load (field cg arch)) (primitive/cast i64 1))
               (and (not (cg-reg-in-used prs n ret-reg "lr")) (not (cg-reg-in-used prs n ret-reg "x30"))))
      (sb-push-str! (mut sb) ",~{lr}")
      0)
    (sb-push-str! (mut sb) ",~{memory}")
    (sb-str (load sb))))
(defn cg-emit-shim-call [(cg (ptr Cg)) (name (slice u8)) (shim (ptr CgShim)) (argvals (ptr (ArrayList (ptr i8))))] (-> (ptr i8))
  (let [a (load (field cg a))
        b (cg-bld cg)
        ctx (cg-ctx cg)
        n (al-len [(ptr i8)] (load argvals))]
    (cg-check-shim-regs cg shim n)
    (let [cons (cg-shim-constraints cg shim n)
          sym (cg-asm-sym cg name)
          (mut body) (sb-new a)]
      (if (= (.arch cg) (primitive/cast i64 0))
          (sb-push-str! (mut body) "call ")
          (sb-push-str! (mut body) "bl "))
      (sb-push-str! (mut body) sym)
      (let [bstr (sb-str (load body))
            (mut tys) (al-new [(ptr i8)] a)
            (mut i) 0]
        (loop (if (>= (load i) n)
                  (break)
                  (do
                    (al-push! (mut tys) (LLVMTypeOf (al-get [(ptr i8)] (load argvals) (load i))))
                    (set! i (primitive/iadd (load i) 1)))))
        (let [fn-ty (LLVMFunctionType (LLVMInt64TypeInContext ctx) (carr a (load tys)) (primitive/cast i32 n) 0)
              asm-ptr
                (LLVMGetInlineAsm fn-ty
                                  (primitive/cast (ptr i8) (slice-data [u8] bstr))
                                  (slice-len bstr)
                                  (primitive/cast (ptr i8) (slice-data [u8] cons))
                                  (slice-len cons)
                                  1
                                  1
                                  0
                                  0)]
          (LLVMBuildCall2 b fn-ty asm-ptr (carr a (load argvals)) (primitive/cast i32 n) (cg-bl cg "shimcall")))))))

; ---- variant index in a sum (position of `variant` in its variant list) ----
(defn cg-variant-idx [(cg (ptr Cg)) (sp (ptr CgSum)) (variant (slice u8))] (-> i64)
  (let [vs (load (field sp variants))
        n (al-len [Variant] (load vs))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [Variant] vs (load i)) name)) variant)
                  (store! r
                          (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; ---- string replace (for emit_llvm_ir placeholder substitution) ----
(defn str-replace-all [(a (dyn Allocator)) (hay (slice u8)) (needle (slice u8)) (rep (slice u8))] (-> (slice u8))
  (let [(mut sb) (sb-new a)
        nl (slice-len needle)
        n (slice-len hay)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (if (and (<= (primitive/iadd (load i) nl) n)
                       (= (substr hay (load i) (primitive/iadd (load i) nl)) needle))
                  (do (sb-push-str! (mut sb) rep) (set! i (primitive/iadd (load i) nl)))
                  (do (sb-push-byte! (mut sb) (slice-get hay (load i))) (set! i (primitive/iadd (load i) 1))))))
    (sb-str (load sb))))

; ---- emit a list of arg expressions to their LLVM values ----
(defn emit-vals [(cg (ptr Cg)) (es (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> (ArrayList (ptr i8)))
  (let [n (al-len [Expr] (load es))
        (mut out) (al-new [(ptr i8)] (load (field cg a)))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (tv-val (emit-expr cg (al-elem [Expr] es (load i)) scp)))
                (set! i (primitive/iadd (load i) 1)))))
    (load out)))

; ---- reconcile_args: spill a struct/array VALUE passed to a pointer param ----
(defn reconcile-args [(cg (ptr Cg)) (callee (ptr i8)) (vals (ArrayList (ptr i8)))] (-> (ArrayList (ptr i8)))
  (let [a (load (field cg a))
        fnty (LLVMGlobalGetValueType callee)
        np (primitive/cast i64 (LLVMCountParamTypes fnty))
        ptbuf
          (primitive/cast (ptr (ptr i8))
                          (primitive/cast (ptr i8)
                                          (slice-data (match (alloc-bytes a
                                                                          (primitive/imul (if (= np
                                                                                                 (primitive/cast i64 0))
                                                                                              1
                                                                                              np)
                                                                                          8)
                                                                          8)
                                                        (Some [s] s)
                                                        (None []
                                                              (do
                                                                (oom-at c"compiler allocation"
                                                                        (primitive/imul (if (= np
                                                                                               (primitive/cast i64 0))
                                                                                            1
                                                                                            np)
                                                                                        8))
                                                                (alloc/alloc-slice-new (primitive/cast (ptr u8) 0) 0)))))))
        n (al-len [(ptr i8)] vals)
        (mut out) (al-new [(ptr i8)] a)
        (mut i) 0]
    (LLVMGetParamTypes fnty ptbuf)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [v (al-get [(ptr i8)] vals (load i))
                      (mut av) v]
                  (when (< (load i) np)
                    (let [pt (load (primitive/index ptbuf (load i)))
                          vk (LLVMGetTypeKind (LLVMTypeOf v))]
                      (when (and (= (LLVMGetTypeKind pt) (primitive/cast i32 12))
                                 (or (= vk (primitive/cast i32 10))
                                     (= vk
                                        (primitive/cast i32
                                                        11))))
                        (let [slot (cg-entry-alloca cg (LLVMTypeOf v) (cg-bl cg "arg.spill"))]
                          (LLVMBuildStore (cg-bld cg) v slot)
                          (store! av slot)
                          0))))
                  (al-push! (mut out) (load av)))
                (set! i (primitive/iadd (load i) 1)))))
    (load out)))

; ======================== emit_expr =====================
(defn emit-expr [(cg (ptr Cg)) (e (ptr Expr)) (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        ctx (cg-ctx cg)]
    (match (.kind e)
      (EInt [v] (mk-tv (LLVMConstInt (cg-i64t cg) v 1) (TInt 64 true)))
      (EBool [bv] (mk-tv (LLVMConstInt (LLVMInt1TypeInContext ctx) (when bv 1) 0) (TBool)))
      (EFloat [bits]
              (mk-tv (LLVMConstReal (LLVMDoubleTypeInContext ctx) (bits->f64 bits))
                     (TFloat 64)))
      ; NUL-terminate the backing constant (last arg = DontNullTerminate = 0).
      ; The slice's length (below) is unchanged; the extra \0 only
      ; makes the pointer safe to hand to C string APIs (snprintf format, etc.).
      (EStr [s]
            (let [bytes
                    (LLVMConstStringInContext ctx
                                              (primitive/cast (ptr i8) (slice-data [u8] s))
                                              (primitive/cast i32 (slice-len s))
                                              0)
                  n (cg-next-global cg)
                  g (LLVMAddGlobal (load (field cg module)) (LLVMTypeOf bytes) (cg-gname cg "str." n))]
              (LLVMSetInitializer g bytes)
              (LLVMSetGlobalConstant g 1)
              (LLVMSetLinkage g 9)
              (let [(mut fs) (al-new [(ptr i8)] a)]
                (al-push! (mut fs) g)
                (al-push! (mut fs) (LLVMConstInt (cg-i64t cg) (slice-len s) 0))
                (mk-tv (LLVMConstStructInContext ctx (carr a (load fs)) 2 0) (TSlice (box-type a (TInt 8 false)))))))
      (ECStr [s]
             (let [bytes
                     (LLVMConstStringInContext ctx
                                               (primitive/cast (ptr i8) (slice-data [u8] s))
                                               (primitive/cast i32 (slice-len s))
                                               0)
                   n (cg-next-global cg)
                   g (LLVMAddGlobal (load (field cg module)) (LLVMTypeOf bytes) (cg-gname cg "cstr." n))]
               (LLVMSetInitializer g bytes)
               (LLVMSetGlobalConstant g 1)
               (LLVMSetLinkage g 9)
               (mk-tv g (TPtr (box-type a (TInt 8 true))))))
      (EVar [name]
            (match (scope-get scp name)
              (Some [tv] tv)
              (None [] (cg-bug (sconcat a "codegen: unbound " name)))))
      (EZeroed [t] (mk-tv (LLVMConstNull (basic-ty cg (box-type a t))) t))
      (EBorrow [m place] (emit-expr cg place scp))
      (ESpillRef [inner]
                 (let [tv (emit-expr cg inner scp)
                       t (tv-ty tv)
                       slot (cg-entry-alloca cg (basic-ty cg (box-type a t)) (cg-bl cg "spill"))]
                   (LLVMBuildStore b (tv-val tv) slot)
                   (mk-tv slot (TPtr (box-type a t)))))
      (EBin [op lhs rhs]
            (let [lv (emit-expr cg lhs scp)
                  rv (emit-expr cg rhs scp)
                  lt (tv-ty lv)
                  l (tv-val lv)
                  r (tv-val rv)]
              (if (match lt (TFloat [x] true) (_ false))
                  (mk-tv (cond (= op (primitive/cast i64 0)) (LLVMBuildFAdd b l r (cg-bl cg "fadd"))
                               (= op (primitive/cast i64 1)) (LLVMBuildFSub b l r (cg-bl cg "fsub"))
                               (= op (primitive/cast i64 2)) (LLVMBuildFMul b l r (cg-bl cg "fmul"))
                               (= op (primitive/cast i64 3)) (LLVMBuildFDiv b l r (cg-bl cg "fdiv"))
                               (= op (primitive/cast i64 4)) (LLVMBuildFRem b l r (cg-bl cg "frem"))
                               :else (do (cg-fail "codegen: bitwise op on a float") (primitive/cast (ptr i8) 0)))
                         lt)
                  (let [signed (match lt (TInt [bits s] s) (_ false))
                        bits (match lt (TInt [n s] n) (_ 64))]
                    ; Division/remainder by zero and an out-of-range shift are
                    ; invalid for every integer type. Guard before constructing
                    ; the LLVM instruction, whose own behavior would be poison.
                    (when (and (= (load (field cg sanitizer)) (primitive/cast i64 4))
                               (or (or (= op (primitive/cast i64 3)) (= op (primitive/cast i64 4)))
                                   (or (= op (primitive/cast i64 5)) (= op (primitive/cast i64 6)))))
                      (cg-ubsan-fail-if! cg
                                         (LLVMBuildICmp b
                                                        32
                                                        r
                                                        (LLVMConstInt (LLVMTypeOf r) 0 0)
                                                        (cg-bl cg "ubsan.divzero"))
                                         "integer division or remainder by zero")
                      0)
                    (when (and (= (load (field cg sanitizer)) (primitive/cast i64 4))
                               (and signed
                                    (and (<= bits (primitive/cast i64 64))
                                         (or (= op (primitive/cast i64 3)) (= op (primitive/cast i64 4))))))
                      (let [ismin
                              (LLVMBuildICmp b
                                             32
                                             l
                                             (LLVMConstInt (LLVMTypeOf l)
                                                           (primitive/ishl 1 (primitive/isub bits 1))
                                                           0)
                                             (cg-bl cg "ubsan.divmin"))
                            isnegone
                              (LLVMBuildICmp b
                                             32
                                             r
                                             (LLVMConstInt (LLVMTypeOf r) -1 1)
                                             (cg-bl cg "ubsan.divnegone"))]
                        (cg-ubsan-fail-if! cg
                                           (LLVMBuildAnd b ismin isnegone (cg-bl cg "ubsan.divoverflow"))
                                           "signed division overflow"))
                      0)
                    (when (and (= (load (field cg sanitizer)) (primitive/cast i64 4))
                               (or (= op (primitive/cast i64 10)) (= op (primitive/cast i64 11))))
                      (cg-ubsan-fail-if! cg
                                         (LLVMBuildICmp b
                                                        35
                                                        r
                                                        (LLVMConstInt (LLVMTypeOf r) bits 0)
                                                        (cg-bl cg "ubsan.shift"))
                                         "shift exponent is negative or too large")
                      0)
                    (mk-tv (cond (and (= (load (field cg sanitizer)) (primitive/cast i64 4))
                                      (and signed
                                           (or (= op (primitive/cast i64 0))
                                               (or (= op (primitive/cast i64 1)) (= op (primitive/cast i64 2))))))
                                   (cg-ubsan-overflow-op cg op l r bits)
                                 (= op (primitive/cast i64 0)) (LLVMBuildAdd b l r (cg-bl cg "add"))
                                 (= op (primitive/cast i64 1)) (LLVMBuildSub b l r (cg-bl cg "sub"))
                                 (= op (primitive/cast i64 2)) (LLVMBuildMul b l r (cg-bl cg "mul"))
                                 (= op (primitive/cast i64 3))
                                   (if signed
                                       (LLVMBuildSDiv b l r (cg-bl cg "div"))
                                       (LLVMBuildUDiv b l r (cg-bl cg "div")))
                                 (= op (primitive/cast i64 4))
                                   (if signed
                                       (LLVMBuildSRem b l r (cg-bl cg "rem"))
                                       (LLVMBuildURem b l r (cg-bl cg "rem")))
                                 (= op (primitive/cast i64 5)) (LLVMBuildUDiv b l r (cg-bl cg "udiv"))
                                 (= op (primitive/cast i64 6)) (LLVMBuildURem b l r (cg-bl cg "urem"))
                                 (= op (primitive/cast i64 7)) (LLVMBuildAnd b l r (cg-bl cg "and"))
                                 (= op (primitive/cast i64 8)) (LLVMBuildOr b l r (cg-bl cg "or"))
                                 (= op (primitive/cast i64 9)) (LLVMBuildXor b l r (cg-bl cg "xor"))
                                 (= op (primitive/cast i64 10)) (LLVMBuildShl b l r (cg-bl cg "shl"))
                                 signed (LLVMBuildAShr b l r (cg-bl cg "shr"))
                                 :else (LLVMBuildLShr b l r (cg-bl cg "shr")))
                           lt)))))
      (ENot [x]
            (let [xv (emit-expr cg x scp)]
              (mk-tv (LLVMBuildNot b (tv-val xv) (cg-bl cg "not")) (tv-ty xv))))
      (ECmp [op lhs rhs]
            (let [lv (emit-expr cg lhs scp)
                  rv (emit-expr cg rhs scp)
                  lt (tv-ty lv)
                  l (tv-val lv)
                  r (tv-val rv)]
              (if (match lt (TFloat [x] true) (_ false))
                  (let [pred
                          (cond (= op (primitive/cast i64 0)) 4
                                (= op (primitive/cast i64 1)) 5
                                (= op (primitive/cast i64 2)) 2
                                (= op (primitive/cast i64 3)) 3
                                (= op (primitive/cast i64 4)) 1
                                :else 6)]
                    (mk-tv (LLVMBuildFCmp b (primitive/cast i32 pred) l r (cg-bl cg "fcmp")) (TBool)))
                  (let [signed (match lt (TInt [bits s] s) (_ false))
                        pred
                          (cond (= op (primitive/cast i64 0)) (if signed 40 36)
                                (= op (primitive/cast i64 1)) (if signed 41 37)
                                (= op (primitive/cast i64 2)) (if signed 38 34)
                                (= op (primitive/cast i64 3)) (if signed 39 35)
                                (= op (primitive/cast i64 4)) 32
                                :else 33)]
                    (mk-tv (LLVMBuildICmp b (primitive/cast i32 pred) l r (cg-bl cg "cmp")) (TBool))))))
      (EDo [body] (emit-body cg body scp))
      (ELet [binds body]
            (let [child (emit-binds cg binds scp)] (emit-body cg body child)))
      (EIf [cnd thn els] (emit-if cg cnd thn els scp))
      (ELoop [label body] (emit-loop cg label body scp))
      (EBreak [label value] (emit-break cg label value scp))
      (EContinue [label] (emit-continue cg label))
      (ECall [func targs args] (emit-call cg func args scp))
      (ENamedCall [_func _targs _names _args]
                  (do
                    (cg-fail "named constructor call survived type checking")
                    (mk-tv (primitive/cast (ptr i8) 0) (TInt 64 true))))
      (EAlloc [storage t] (emit-alloc cg storage (box-type a t)))
      (EField [pe fname] (emit-field cg pe fname scp))
      (EBitGet [pe fname] (emit-bitget cg pe fname scp))
      (EBitSet [pe fname val] (emit-bitset cg pe fname val scp))
      (ELoad [inner]
             (let [pv (emit-expr cg inner scp)
                   pointee
                     (match (tv-ty pv)
                       (TPtr [pe] (load pe))
                       (_ (do (unimplemented "codegen: load of non-pointer") (TInt 64 true))))]
               (let [ins (LLVMBuildLoad2 b (basic-ty cg (box-type a pointee)) (tv-val pv) (cg-bl cg "load"))]
                 ; A byte-offset GEP may address a packed or explicitly placed
                 ; field.  The pointer type does not carry that reduced
                 ; alignment, so LLVM's natural default can be a false promise.
                 (LLVMSetAlignment ins 1)
                 (mk-tv ins pointee))))
      (EStore [pe val]
              (let [pv (emit-expr cg pe scp)
                    vv (emit-expr cg val scp)]
                ; std-12: store! yields unit (canonical i64 0), matching its checked type.
                (let [ins (LLVMBuildStore b (tv-val vv) (tv-val pv))]
                  (LLVMSetAlignment ins 1))
                (mk-tv (cg-zero-i64 cg) (TInt 64 true))))
      (EIndex [pe idx] (emit-index cg pe idx scp))
      (ECast [t inner] (emit-cast cg (box-type a t) inner scp))
      (ESizeOf [t]
               (mk-tv (cg-const-i64 cg (cg-layout-size cg (box-type a t)))
                      (TInt 64 true)))
      (EAlignOf [t]
                (mk-tv (cg-const-i64 cg (cg-layout-align cg (box-type a t)))
                       (TInt 64 true)))
      (EOffsetOf [t fname] (mk-tv (cg-const-i64 cg (cg-offset-of cg (box-type a t) fname)) (TInt 64 true)))
      (EFree [p] (let [pv (emit-expr cg p scp)] (LLVMBuildFree b (tv-val pv)) (mk-tv (cg-zero-i64 cg) (TInt 64 true))))
      (EConstruct [sum variant args] (emit-construct cg sum variant args scp))
      (EMatch [scrut arms] (emit-match cg scrut arms scp))
      (EFnPtrOf [name] (emit-fnptr cg name))
      (ECallPtr [fp args] (emit-callptr cg fp args scp))
      (ELlvmIr [result args body] (emit-llvm-ir cg (box-type a result) args body scp))
      (EStaticRef [name]
                  (let [si (cg-static-idx cg name)]
                    (if (< si (primitive/cast i64 0))
                        (cg-bug (sconcat a "codegen: unknown static const " name))
                        (let [sp (al-elem [CgStatic] (field cg statics) si)]
                          (mk-tv (load (field sp ptr))
                                 (TPtr (box-type a
                                                 (.ty sp))))))))
      (EErase [tn inner] (cg-bug "codegen: unlowered Erase (checker should have made it a MakeDyn)"))
      (ETraitCall [tn m s args] (cg-bug "codegen: unresolved trait call (compiler bug)"))
      (EComptime [inner] (cg-bug "codegen: unresolved comptime node (compiler bug)"))
      (EAscribe [ty inner]
                (cg-bug "codegen: unlowered ascription node — the checker should have replaced (: v t) with its coerced value (compiler bug)"))
      (EArrayLit [items] (cg-bug "codegen: unlowered array literal (checker bug)"))
      (EMakeSlice [data elem len]
                  (let [dv (emit-expr cg data scp)
                        st (basic-ty cg (box-type a (TSlice (box-type a elem))))
                        s0
                          (LLVMBuildInsertValue b
                                                (LLVMGetUndef st)
                                                (tv-val dv)
                                                0
                                                (cg-bl cg "slice.data"))
                        s1
                          (LLVMBuildInsertValue b
                                                s0
                                                (LLVMConstInt (cg-i64t cg) len 0)
                                                1
                                                (cg-bl cg "slice.len"))]
                    (mk-tv s1 (TSlice (box-type a elem)))))
      (EQuote [form] (cg-bug "codegen: a Code value has no runtime representation"))
      (ECodeOp [op args] (cg-bug "codegen: a Code value has no runtime representation"))
      (EQuasi [q] (cg-bug "codegen: a Code value has no runtime representation"))
      (ETypeQuery [q t] (cg-bug "codegen: unresolved type-query (compiler bug)"))
      (EFieldMeta [m t idx] (cg-bug "codegen: unresolved field-reflection (compiler bug)"))
      (EFieldIndex [t name] (cg-bug "codegen: unresolved field-reflection (compiler bug)"))
      (EMakeDyn [ds vt methods inner] (emit-make-dyn cg ds vt methods inner scp))
      (EDynDispatch [ds vt mi cc params ret recv args]
                    (emit-dyn-dispatch cg ds vt mi cc params (box-type (load (field cg a)) ret) recv args scp)))))

; ExprKind::MakeDyn — erase a concrete (ptr T) to a
; (dyn Trait) fat pointer. Materialise a constant vtable global (the impl methods'
; addresses in trait order) and a caller-frame { data, vtable } struct BY VALUE.
(defn emit-make-dyn [(cg (ptr Cg))
                     (ds (slice u8))
                     (vt (slice u8))
                     (methods (ptr (ArrayList (slice u8))))
                     (inner (ptr Expr))
                     (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        iv (emit-expr cg inner scp)
        data (tv-val iv)
        vsi (cg-struct-idx cg vt)]
    (if (< vsi (primitive/cast i64 0))
        (cg-bug (sconcat a "codegen: unknown vtable struct " vt))
        (let [vty (load (field (al-elem [CgStruct] (field cg structs) vsi) ty))
              nm (al-len [(slice u8)] (load methods))
              (mut fields) (al-new [(ptr i8)] a)
              (mut i) 0]
          (loop (if (>= (load i) nm)
                    (break)
                    (do
                      (let [mn (al-get [(slice u8)] (load methods) (load i))
                            fv (cg-func cg mn)]
                        (when (= (primitive/cast i64 fv) (primitive/cast i64 0))
                          (unimplemented (sconcat a "codegen: dyn vtable references unknown fn " mn))
                          0)
                        (al-push! (mut fields) fv))
                      (set! i (primitive/iadd (load i) 1)))))
          (let [g (LLVMAddGlobal (load (field cg module)) vty (str->cstr a (sconcat a "vtable." ds)))]
            (LLVMSetInitializer g (LLVMConstNamedStruct vty (carr a (load fields)) (primitive/cast i32 nm)))
            (LLVMSetGlobalConstant g 1)
            (let [dsi (cg-struct-idx cg ds)]
              (if (< dsi (primitive/cast i64 0))
                  (cg-bug (sconcat a "codegen: unknown dyn struct " ds))
                  (let [dty (load (field (al-elem [CgStruct] (field cg structs) dsi) ty))
                        slot (cg-entry-alloca cg dty (cg-bl cg "dyn.obj"))
                        dp (LLVMBuildStructGEP2 b dty slot 0 (cg-bl cg "dyn.data"))]
                    (LLVMBuildStore b data dp)
                    (let [vp (LLVMBuildStructGEP2 b dty slot 1 (cg-bl cg "dyn.vt"))]
                      (LLVMBuildStore b g vp)
                      (mk-tv (LLVMBuildLoad2 b dty slot (cg-bl cg "dyn.val")) (TStruct ds)))))))))))

; ExprKind::DynDispatch — call a trait method through the
; fat pointer's vtable: spill the receiver, load data + vtable, load the method's
; fnptr from vtable slot `mi`, then indirect-call (data, args…).
(defn emit-dyn-dispatch [(cg (ptr Cg))
                         (ds (slice u8))
                         (vt (slice u8))
                         (mi i64)
                         (cc (slice u8))
                         (params (ptr (ArrayList Type)))
                         (ret (ptr Type))
                         (recv (ptr Expr))
                         (args (ptr (ArrayList Expr)))
                         (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        pty (LLVMPointerTypeInContext (cg-ctx cg) 0)
        rv (emit-expr cg recv scp)
        dsi (cg-struct-idx cg ds)]
    (if (< dsi (primitive/cast i64 0))
        (cg-bug (sconcat a "codegen: unknown dyn struct " ds))
        (let [dty (load (field (al-elem [CgStruct] (field cg structs) dsi) ty))
              slot (cg-entry-alloca cg dty (cg-bl cg "dyn.recv"))]
          (LLVMBuildStore b (tv-val rv) slot)
          (let [dp (LLVMBuildStructGEP2 b dty slot 0 (cg-bl cg "dyn.data"))
                data (LLVMBuildLoad2 b pty dp (cg-bl cg "data"))
                vp (LLVMBuildStructGEP2 b dty slot 1 (cg-bl cg "dyn.vt"))
                vtab (LLVMBuildLoad2 b pty vp (cg-bl cg "vt"))
                vsi (cg-struct-idx cg vt)]
            (cg-validate-pointer! cg data "dyn.data" false)
            (cg-validate-pointer! cg vtab "dyn.vtable" false)
            (if (< vsi (primitive/cast i64 0))
                (cg-bug (sconcat a "codegen: unknown vtable struct " vt))
                (let [vty (load (field (al-elem [CgStruct] (field cg structs) vsi) ty))
                      mp (LLVMBuildStructGEP2 b vty vtab (primitive/cast i32 mi) (cg-bl cg "vt.m"))
                      fnptr (LLVMBuildLoad2 b pty mp (cg-bl cg "fn"))
                      fnty (cg-fn-type cg params ret)
                      (mut meta) (al-new [(ptr i8)] a)]
                  (cg-validate-pointer! cg fnptr "dyn.method" true)
                  (al-push! (mut meta) data)
                  (let [n (al-len [Expr] (load args))
                        (mut i) 0]
                    (loop (if (>= (load i) n)
                              (break)
                              (do
                                (let [av (emit-expr cg (al-elem [Expr] args (load i)) scp)]
                                  (al-push! (mut meta) (tv-val av)))
                                (set! i (primitive/iadd (load i) 1))))))
                  (let [cs
                          (LLVMBuildCall2 b
                                          fnty
                                          fnptr
                                          (carr a (load meta))
                                          (primitive/cast i32 (al-len [(ptr i8)] (load meta)))
                                          (cg-bl cg "dyn.call"))
                        id (native-cc-parse cc)]
                    (when (>= id (primitive/cast i64 0)) (LLVMSetInstructionCallConv cs (primitive/cast i32 id)) 0)
                    (mk-tv cs (load ret))))))))))

; emit a `do`/let body: last value, default (i64 0); stop at a terminator.
(defn emit-body [(cg (ptr Cg)) (body (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> Tv)
  (let [n (al-len [Expr] (load body))
        (mut last) (mk-tv (cg-zero-i64 cg) (TInt 64 true))
        (mut i) 0]
    (loop (if (or (>= (load i) n) (cg-terminated cg))
              (break)
              (do
                (set! last (emit-expr cg (al-elem [Expr] body (load i)) scp))
                (set! i (primitive/iadd (load i) 1)))))
    (load last)))
; bind a let's bindings into a child scp.
(defn emit-binds [(cg (ptr Cg)) (binds (ptr (ArrayList Bind))) (scp (ptr Scope))] (-> (ptr Scope))
  (let [a (load (field cg a))
        n (al-len [Bind] (load binds))
        (mut s) scp
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [bp (al-elem [Bind] binds (load i))
                      tv (emit-expr cg (field bp value) (load s))]
                  (set! s (scope-put a (load s) (.name bp) (tv-val tv) (tv-ty tv))))
                (set! i (primitive/iadd (load i) 1)))))
    (load s)))

(defn emit-call [(cg (ptr Cg)) (func (slice u8)) (args (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        ret-ty (match (cg-ret cg func) (Some [t] t) (None [] (cg-bug-ty (sconcat a "codegen: unknown callable " func))))
        shim (cg-shim-find cg func)]
    (if (!= (primitive/cast i64 shim) (primitive/cast i64 0))
        ; a :shim callee is reached through a register-constrained inline-asm call,
        ; not a plain direct call.
        (let [vals (emit-vals cg args scp)
              vp (primitive/alloc-stack (ArrayList (ptr i8)))]
          (set! vp vals)
          (mk-tv (cg-emit-shim-call cg func shim vp) ret-ty))
        (emit-call-native cg func args scp ret-ty))))
(defn emit-call-native [(cg (ptr Cg)) (func (slice u8)) (args (ptr (ArrayList Expr))) (scp (ptr Scope)) (ret-ty Type)] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        callee (cg-func cg func)]
    (if (= (primitive/cast i64 callee) (primitive/cast i64 0))
        (cg-bug (sconcat a "codegen: call to undefined " func))
        (let [sig (cg-csig cg func)]
          (if (!= (primitive/cast i64 sig) (primitive/cast i64 0))
              (emit-c-call cg callee sig (emit-argtv cg args scp) ret-ty)
              (let [vals (emit-vals cg args scp)
                    meta (reconcile-args cg callee vals)
                    cs
                      (LLVMBuildCall2 b
                                      (LLVMGlobalGetValueType callee)
                                      callee
                                      (carr a meta)
                                      (primitive/cast i32 (al-len [(ptr i8)] meta))
                                      (cg-call-name cg (LLVMGlobalGetValueType callee) "call"))]
                (LLVMSetInstructionCallConv cs (LLVMGetFunctionCallConv callee))
                (if (ty-is-void (box-type a ret-ty)) (mk-tv (cg-zero-i64 cg) (TVoid)) (mk-tv cs ret-ty))))))))
(defn cg-bug-ty [(msg (slice u8))] (-> Type)
  (unimplemented msg)
  (TInt 64 true))

(defn emit-field [(cg (ptr Cg)) (pe (ptr Expr)) (fname (slice u8)) (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        pv (emit-expr cg pe scp)
        sname
          (match (tv-ty pv)
            (TPtr [pe2]
                  (match (load pe2) (TStruct [s] s) (_ (cg-bug-sl "codegen: field on (ptr non-struct)"))))
            (_ (cg-bug-sl "codegen: field on non-pointer")))
        si (cg-struct-idx cg sname)]
    (if (< si (primitive/cast i64 0))
        (cg-bug (sconcat a "codegen: unknown struct " sname))
        (let [sp (al-elem [CgStruct] (field cg structs) si)
              fs (load (field sp fields))
              nf (al-len [Field] (load fs))
              (mut idx) -1
              (mut i) 0]
          (loop (if (>= (load i) nf)
                    (break)
                    (do
                      (when (= (load (field (al-elem [Field] fs (load i)) name)) fname)
                        (store! idx
                                (load i)))
                      (set! i (primitive/iadd (load i) 1)))))
          (if (< (load idx) (primitive/cast i64 0))
              (cg-bug "codegen: no such field")
              (let [fty (.ty (al-elem [Field] fs (load idx)))
                    gep
                      (match (.layout sp)
                        (LBits [_ _]
                               (LLVMBuildStructGEP2 b
                                                    (load (field sp ty))
                                                    (tv-val pv)
                                                    0
                                                    (cg-bl cg "field")))
                        (_ (let [(mut ix) (al-new [(ptr i8)] a)]
                             (al-push! (mut ix)
                                       (LLVMConstInt (cg-i64t cg)
                                                     (field-offset (field cg layouts) si (load idx))
                                                     0))
                             (LLVMBuildGEP2 b
                                            (LLVMInt8TypeInContext (cg-ctx cg))
                                            (tv-val pv)
                                            (carr a (load ix))
                                            1
                                            (cg-bl cg "field")))))]
                (mk-tv gep (TPtr (box-type a fty)))))))))
(defn cg-bug-sl [(msg (slice u8))] (-> (slice u8))
  (unimplemented msg)
  "")

(defn emit-index [(cg (ptr Cg)) (pe (ptr Expr)) (idx (ptr Expr)) (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        pv (emit-expr cg pe scp)
        iv (emit-expr cg idx scp)
        pointee
          (match (tv-ty pv)
            (TPtr [pe2] (load pe2))
            (_ (do (unimplemented "codegen: index of non-pointer") (TInt 64 true))))]
    (match pointee
      (TArray [elem nn]
              (let [(mut ix) (al-new [(ptr i8)] a)]
                (al-push! (mut ix) (cg-zero-i64 cg))
                (al-push! (mut ix) (tv-val iv))
                (mk-tv (LLVMBuildGEP2 b
                                      (basic-ty cg (box-type a pointee))
                                      (tv-val pv)
                                      (carr a (load ix))
                                      2
                                      (cg-bl cg "idx"))
                       (TPtr elem))))
      (_ (let [(mut ix) (al-new [(ptr i8)] a)]
           (al-push! (mut ix) (tv-val iv))
           (mk-tv (LLVMBuildGEP2 b
                                 (basic-ty cg (box-type a pointee))
                                 (tv-val pv)
                                 (carr a (load ix))
                                 1
                                 (cg-bl cg "idx"))
                  (TPtr (box-type a pointee))))))))

(defn emit-cast [(cg (ptr Cg)) (t (ptr Type)) (inner (ptr Expr)) (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        ctx (cg-ctx cg)
        iv (emit-expr cg inner scp)
        v (tv-val iv)
        vt (tv-ty iv)
        v-is-ptr (match vt (TPtr [x] true) (_ false))
        v-is-float (match vt (TFloat [x] true) (_ false))
        v-is-int (match vt (TInt [x y] true) (_ false))
        v-signed (match vt (TInt [x s] s) (_ false))]
    (match (load t)
      (TInt [to s]
            (if v-is-ptr
                (mk-tv (LLVMBuildPtrToInt b v (int-width ctx to) (cg-bl cg "ptrtoint")) (load t))
                (if v-is-float
                    (mk-tv (if s
                               (LLVMBuildFPToSI b v (int-width ctx to) (cg-bl cg "fptosi"))
                               (LLVMBuildFPToUI b v (int-width ctx to) (cg-bl cg "fptoui")))
                           (load t))
                    (let [from (cg-int-bits vt)]
                      (mk-tv (if (> to from)
                                 (if v-signed
                                     (LLVMBuildSExt b v (int-width ctx to) (cg-bl cg "sext"))
                                     (LLVMBuildZExt b v (int-width ctx to) (cg-bl cg "zext")))
                                 (if (< to from)
                                     (LLVMBuildTrunc b v (int-width ctx to) (cg-bl cg "trunc"))
                                     v))
                             (load t))))))
      (TPtr [inner2]
            (if v-is-int
                (mk-tv (LLVMBuildIntToPtr b v (LLVMPointerTypeInContext ctx 0) (cg-bl cg "inttoptr"))
                       (load t))
                (mk-tv v (load t))))
      (TFn [c p r] (mk-tv v (load t)))
      (TFloat [to]
              (let [ft (basic-ty cg t)]
                (if v-is-int
                    (mk-tv (if v-signed
                               (LLVMBuildSIToFP b v ft (cg-bl cg "sitofp"))
                               (LLVMBuildUIToFP b v ft (cg-bl cg "uitofp")))
                           (load t))
                    (if v-is-float
                        (let [from (cg-float-bits vt)]
                          (mk-tv (if (> to from)
                                     (LLVMBuildFPExt b v ft (cg-bl cg "fpext"))
                                     (if (< to from) (LLVMBuildFPTrunc b v ft (cg-bl cg "fptrunc")) v))
                                 (load t)))
                        (cg-bug "codegen: cannot cast to float")))))
      (_ (cg-bug "codegen: cannot cast to this type")))))
(defn cg-int-bits [(t Type)] (-> i64)
  (match t (TInt [b s] b) (_ 64)))
(defn cg-float-bits [(t Type)] (-> i64)
  (match t (TFloat [b] b) (_ 64)))

; ======================== emit_construct / emit_match ========================
(defn emit-construct [(cg (ptr Cg))
                      (sum (slice u8))
                      (variant (slice u8))
                      (args (ptr (ArrayList Expr)))
                      (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        ui (cg-sum-idx cg sum)]
    (if (< ui (primitive/cast i64 0))
        (cg-bug (sconcat a "codegen: unknown sum " sum))
        (let [sp (al-elem [CgSum] (field cg sums) ui)
              vidx (cg-variant-idx cg sp variant)
              sum-ty (load (field sp ty))
              var-struct (al-get [(ptr i8)] (load (field sp vstructs)) vidx)
              tmp (cg-entry-alloca cg sum-ty (cg-bl cg "sum.tmp"))
              tagptr (LLVMBuildStructGEP2 b sum-ty tmp 0 (cg-bl cg "tag"))]
          (LLVMBuildStore b (LLVMConstInt (cg-i32t cg) vidx 0) tagptr)
          (let [payload (LLVMBuildStructGEP2 b sum-ty tmp 1 (cg-bl cg "payload"))
                n (al-len [Expr] (load args))
                (mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (let [vv (emit-expr cg (al-elem [Expr] args (load i)) scp)
                              fptr
                                (LLVMBuildStructGEP2 b var-struct payload (primitive/cast i32 (load i)) (cg-bl cg "vf"))]
                          (LLVMBuildStore b (tv-val vv) fptr))
                        (set! i (primitive/iadd (load i) 1)))))
            (mk-tv (LLVMBuildLoad2 b sum-ty tmp (cg-bl cg "sum")) (TStruct sum)))))))

(defn emit-match [(cg (ptr Cg)) (scrut (ptr Expr)) (arms (ptr (ArrayList Arm))) (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        sv (emit-expr cg scrut scp)
        sumname (match (tv-ty sv) (TStruct [s] s) (_ (cg-bug-sl "codegen: match on non-sum")))
        ui (cg-sum-idx cg sumname)]
    (if (< ui (primitive/cast i64 0))
        (cg-bug (sconcat a "codegen: match on non-sum " sumname))
        (let [sp (al-elem [CgSum] (field cg sums) ui)
              sum-ty (load (field sp ty))
              tmp (cg-entry-alloca cg sum-ty (cg-bl cg "match.tmp"))]
          (LLVMBuildStore b (tv-val sv) tmp)
          (let [tagptr (LLVMBuildStructGEP2 b sum-ty tmp 0 (cg-bl cg "tag"))
                tag (LLVMBuildLoad2 b (cg-i32t cg) tagptr (cg-bl cg "tag"))
                payload (LLVMBuildStructGEP2 b sum-ty tmp 1 (cg-bl cg "payload"))
                func (cg-cur-func cg)
                narms (al-len [Arm] (load arms))
                ; a trailing `(_ …)` arm becomes the switch's DEFAULT destination
                ; instead of a case, so the tags it covers need no cases at all.
                ncases (if (arms-have-wildcard arms) (primitive/isub narms 1) narms)
                (mut armbbs) (al-new [(ptr i8)] a)
                (mut k) 0]
            (loop (if (>= (load k) narms)
                      (break)
                      (do
                        (al-push! (mut armbbs) (cg-append cg func (cg-bl cg "arm")))
                        (set! k (primitive/iadd (load k) 1)))))
            (let [default
                    (if (= ncases narms)
                        (cg-append cg func (cg-bl cg "match.default"))
                        (al-get [(ptr i8)] (load armbbs) ncases))
                  merge (cg-append cg func (cg-bl cg "match.end"))
                  sw (LLVMBuildSwitch b tag default (primitive/cast i32 ncases))
                  (mut k2) 0]
              (loop (if (>= (load k2) ncases)
                        (break)
                        (do
                          (let [ap (al-elem [Arm] arms (load k2))
                                vidx (cg-variant-idx cg sp (.variant ap))]
                            (LLVMAddCase sw
                                         (LLVMConstInt (cg-i32t cg) vidx 0)
                                         (al-get [(ptr i8)] (load armbbs) (load k2))))
                          (set! k2 (primitive/iadd (load k2) 1)))))
              (when (= ncases narms) (cg-pos cg default) (LLVMBuildUnreachable b) 0)
              ; emit arms; collect (value, end-block) for the merge phi.
              (let [(mut inc-vals) (al-new [(ptr i8)] a)
                    (mut inc-bbs) (al-new [(ptr i8)] a)
                    (mut result-ty) (TInt 64 true)
                    (mut k3) 0]
                (loop (if (>= (load k3) narms)
                          (break)
                          (do
                            (cg-pos cg (al-get [(ptr i8)] (load armbbs) (load k3)))
                            (let [ap (al-elem [Arm] arms (load k3))
                                  ; the catch-all names no variant and binds nothing;
                                  ; index 0 keeps the payload lookups below in range,
                                  ; and the bind loop that would read them never runs.
                                  vidx
                                    (if (>= (load k3) ncases)
                                        0
                                        (cg-variant-idx cg sp (.variant ap)))
                                  var-struct (al-get [(ptr i8)] (load (field sp vstructs)) vidx)
                                  vp (al-elem [Variant] (load (field sp variants)) vidx)
                                  vfs (load (field vp fields))
                                  binds (load (field ap binds))
                                  nb (al-len [(slice u8)] (load binds))
                                  (mut child) scp
                                  (mut j) 0]
                              (loop (if (>= (load j) nb)
                                        (break)
                                        (do
                                          (let [fptr
                                                  (LLVMBuildStructGEP2 b
                                                                       var-struct
                                                                       payload
                                                                       (primitive/cast i32 (load j))
                                                                       (cg-bl cg "vf"))
                                                fty (.ty (al-elem [Field] vfs (load j)))
                                                bname (al-get [(slice u8)] (load binds) (load j))
                                                fval
                                                  (LLVMBuildLoad2 b
                                                                  (basic-ty cg (box-type a fty))
                                                                  fptr
                                                                  (str->cstr a bname))]
                                            (set! child (scope-put a (load child) bname fval fty)))
                                          (set! j (primitive/iadd (load j) 1)))))
                              (let [bv (emit-expr cg (field ap body) (load child))
                                    endbb (cg-cur-block cg)]
                                (when (= (primitive/cast i64 (LLVMGetBasicBlockTerminator endbb))
                                         (primitive/cast i64 0))
                                  (store! result-ty (tv-ty bv))
                                  (LLVMBuildBr b merge)
                                  (al-push! (mut inc-vals) (tv-val bv))
                                  (al-push! (mut inc-bbs) endbb))))
                            (set! k3 (primitive/iadd (load k3) 1)))))
                (cg-pos cg merge)
                (if (= (al-len [(ptr i8)] (load inc-vals)) (primitive/cast i64 0))
                    (do (LLVMBuildUnreachable b) (mk-tv (cg-zero-i64 cg) (load result-ty)))
                    (let [phi (LLVMBuildPhi b (basic-ty cg (box-type a (load result-ty))) (cg-bl cg "match.val"))]
                      (LLVMAddIncoming phi
                                       (carr a (load inc-vals))
                                       (carr a (load inc-bbs))
                                       (primitive/cast i32 (al-len [(ptr i8)] (load inc-vals))))
                      (mk-tv phi (load result-ty)))))))))))

; ======================== emit_alloc / bit access ============================
; a struct with `:layout (align N)` (or explicit `:align`) forces its allocation
; alignment; 0 = no forced alignment.
(defn cg-force-align [(cg (ptr Cg)) (t (ptr Type))] (-> i64)
  (match (load t)
    (TStruct [nm]
             (let [si (cg-struct-idx cg nm)]
               (unless (< si (primitive/cast i64 0))
                 (let [want (load (field (struct-at (field cg layouts) si) align))
                       natural
                         (primitive/cast i64
                                         (LLVMABIAlignmentOfType (load (field cg td))
                                                                 (basic-ty cg t)))]
                   (if (> want natural) want 0)))))
    (TArray [elem _n] (cg-force-align cg elem))
    (_ 0)))
(defn emit-alloc [(cg (ptr Cg)) (storage i64) (t (ptr Type))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        bt (basic-ty cg t)
        fa (cg-force-align cg t)]
    (if (or (= storage (primitive/cast i64 0)) (= storage (primitive/cast i64 3)))
        (let [p
                (if (= storage (primitive/cast i64 3))
                    (let [cur (cg-cur-block cg)
                          entry (LLVMGetEntryBasicBlock (LLVMGetBasicBlockParent cur))]
                      ; Preserve the existing instruction order when the implicit
                      ; place is already in entry; only loop/branch-local sites need
                      ; to be moved out of their dynamic control-flow position.
                      (if (= (primitive/cast i64 cur) (primitive/cast i64 entry))
                          (LLVMBuildAlloca b bt (cg-bl cg "stack.slot"))
                          (cg-entry-alloca cg bt (cg-bl cg "stack.slot"))))
                    (LLVMBuildAlloca b bt (cg-bl cg "stack.slot")))]
          (when (> fa (primitive/cast i64 0)) (LLVMSetAlignment p (primitive/cast i32 fa)) 0)
          (mk-tv p (TPtr (box-type a (load t)))))
        (if (= storage (primitive/cast i64 2))
            (mk-tv (LLVMBuildMalloc b bt (cg-bl cg "heap.box")) (TPtr (box-type a (load t))))
            (let [_global-seq (cg-next-global cg)
                  n (load (field cg nstatic))
                  _next-static (set! (.nstatic cg) (primitive/iadd n 1))
                  function-name (cstr->slice (LLVMGetValueName (cg-cur-func cg)))
                  ; A recognizable, deterministic name lets incremental JIT backends
                  ; map this generation's alloc-static cell onto its prior address.
                  g
                    (LLVMAddGlobal (load (field cg module))
                                   bt
                                   (str->cstr a
                                              (sconcat a
                                                       "repl_static."
                                                       (sconcat a function-name (sconcat a "." (i64->str a n))))))]
              (LLVMSetInitializer g (LLVMConstNull bt))
              (when (> fa (primitive/cast i64 0)) (LLVMSetAlignment g (primitive/cast i32 fa)) 0)
              (mk-tv g (TPtr (box-type a (load t)))))))))

; ======================== emit_if / loop / break / continue ==================
(defn emit-if [(cg (ptr Cg)) (cnd (ptr Expr)) (thn (ptr Expr)) (els (ptr Expr)) (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        func (cg-cur-func cg)
        cv (emit-expr cg cnd scp)
        c (tv-val cv)
        cmp (LLVMBuildICmp b 33 c (cg-zero (LLVMTypeOf c)) (cg-bl cg "ifc"))
        then-bb (cg-append cg func (cg-bl cg "then"))
        else-bb (cg-append cg func (cg-bl cg "else"))]
    (LLVMBuildCondBr b cmp then-bb else-bb)
    (cg-pos cg then-bb)
    (let [tv (emit-expr cg thn scp)
          then-end (cg-cur-block cg)
          then-div (!= (primitive/cast i64 (LLVMGetBasicBlockTerminator then-end)) (primitive/cast i64 0))]
      (cg-pos cg else-bb)
      (let [ev (emit-expr cg els scp)
            else-end (cg-cur-block cg)
            else-div (!= (primitive/cast i64 (LLVMGetBasicBlockTerminator else-end)) (primitive/cast i64 0))]
        (cond (and (not then-div) (not else-div))
                (let [merge-bb (cg-append cg func (cg-bl cg "ifcont"))]
                  (cg-pos cg then-end)
                  (LLVMBuildBr b merge-bb)
                  (cg-pos cg else-end)
                  (LLVMBuildBr b merge-bb)
                  (cg-pos cg merge-bb)
                  ; A matched-void `if` merges control flow, but has no runtime value
                  ; to merge. LLVM has no void-typed phi, so preserve TVoid with the
                  ; same ignored sentinel used for a direct void call.
                  (if (ty-is-void (box-type a (tv-ty tv)))
                      (mk-tv (cg-zero-i64 cg) (TVoid))
                      (let [phi (LLVMBuildPhi b (basic-ty cg (box-type a (tv-ty tv))) (cg-bl cg "ifval"))
                            (mut vs) (al-new [(ptr i8)] a)
                            (mut bs) (al-new [(ptr i8)] a)]
                        (al-push! (mut vs) (tv-val tv))
                        (al-push! (mut vs) (tv-val ev))
                        (al-push! (mut bs) then-end)
                        (al-push! (mut bs) else-end)
                        (LLVMAddIncoming phi (carr a (load vs)) (carr a (load bs)) 2)
                        (mk-tv phi (tv-ty tv)))))
              (and (not then-div) else-div) (do (cg-pos cg then-end) tv)
              (and then-div (not else-div)) (do (cg-pos cg else-end) ev)
              :else
                (let [dead-bb (cg-append cg func (cg-bl cg "ifcont.dead"))]
                  (cg-pos cg dead-bb)
                  (LLVMBuildUnreachable b)
                  (mk-tv (cg-zero-i64 cg) (tv-ty tv))))))))

(defn emit-loop [(cg (ptr Cg)) (label (Option (slice u8))) (body (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        func (cg-cur-func cg)
        body-bb (cg-append cg func (cg-bl cg "loop.body"))
        after-bb (cg-append cg func (cg-bl cg "loop.after"))]
    (LLVMBuildBr b body-bb)
    (cg-pos cg body-bb)
    (let [lc (primitive/alloc-stack CgLoop)]
      (set! (.label lc) label)
      (set! (.body_bb lc) body-bb)
      (set! (.after_bb lc) after-bb)
      (set! (.breaks lc) (al-new [CgBreak] a))
      (set! (.break_ty lc) (None [Type]))
      (al-push! (mut (.loops cg)) (load lc)))
    (let [n (al-len [Expr] (load body))
          (mut i) 0]
      (loop (if (or (>= (load i) n) (cg-terminated cg))
                (break)
                (do (emit-expr cg (al-elem [Expr] body (load i)) scp) (set! i (primitive/iadd (load i) 1))))))
    (when (not (cg-terminated cg)) (LLVMBuildBr b body-bb) 0)
    (let [popped
            (match (al-pop! [CgLoop] (mut (.loops cg)))
              (Some [x] x)
              (None [] (do (unimplemented "loop ctx missing") (primitive/zeroed CgLoop))))
          lp (primitive/alloc-stack CgLoop)]
      (set! lp popped)
      (cg-pos cg after-bb)
      (let [nb (al-len [CgBreak] (.breaks lp))]
        (if (= nb (primitive/cast i64 0))
            (do (LLVMBuildUnreachable b) (mk-tv (cg-zero-i64 cg) (TInt 64 true)))
            (let [ty (match (.break_ty lp) (Some [t] t) (None [] (TInt 64 true)))
                  phi (LLVMBuildPhi b (basic-ty cg (box-type a ty)) (cg-bl cg "loop.val"))
                  (mut vs) (al-new [(ptr i8)] a)
                  (mut bs) (al-new [(ptr i8)] a)
                  (mut i) 0]
              (loop (if (>= (load i) nb)
                        (break)
                        (do
                          (let [bp (al-elem [CgBreak] (field lp breaks) (load i))]
                            (al-push! (mut vs) (load (field bp val)))
                            (al-push! (mut bs) (load (field bp bb))))
                          (set! i (primitive/iadd (load i) 1)))))
              (LLVMAddIncoming phi (carr a (load vs)) (carr a (load bs)) (primitive/cast i32 nb))
              (mk-tv phi ty)))))))

(defn cg-loop-index [(cg (ptr Cg)) (label (Option (slice u8)))] (-> i64)
  (let [n (al-len [CgLoop] (.loops cg))]
    (match label
      (Some [l]
            (let [(mut r) -1
                  (mut i) 0]
              (loop (if (>= (load i) n)
                        (break)
                        (do
                          (match (.label (al-elem [CgLoop] (field cg loops) (load i)))
                            (Some [ll] (when (= ll l) (store! r (load i))))
                            (None [] 0))
                          (set! i (primitive/iadd (load i) 1)))))
              (if (< (load r) (primitive/cast i64 0))
                  (do (unimplemented "codegen: break/continue to unknown loop label") -1)
                  (load r))))
      (None []
            (if (= n (primitive/cast i64 0))
                (do (unimplemented "codegen: break/continue outside of a loop") -1)
                (primitive/isub n 1))))))

(defn emit-break [(cg (ptr Cg)) (label (Option (slice u8))) (value (Option (ptr Expr))) (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        vtv (match value (Some [e] (emit-expr cg e scp)) (None [] (mk-tv (cg-zero-i64 cg) (TInt 64 true))))]
    (if (cg-terminated cg)
        (mk-tv (cg-zero-i64 cg) (TInt 64 true))
        (let [pred (cg-cur-block cg)
              idx (cg-loop-index cg label)
              lp (al-elem [CgLoop] (field cg loops) idx)
              site (primitive/alloc-stack CgBreak)]
          (set! (.val site) (tv-val vtv))
          (set! (.bb site) pred)
          (al-push! (mut (.breaks lp)) (load site))
          (match (.break_ty lp)
            (Some [x] 0)
            (None [] (do (set! (.break_ty lp) (Some [Type] (tv-ty vtv))) 0)))
          (LLVMBuildBr b (load (field lp after_bb)))
          (mk-tv (cg-zero-i64 cg) (TInt 64 true))))))

(defn emit-continue [(cg (ptr Cg)) (label (Option (slice u8)))] (-> Tv)
  (let [b (cg-bld cg)
        idx (cg-loop-index cg label)
        lp (al-elem [CgLoop] (field cg loops) idx)]
    (LLVMBuildBr b (load (field lp body_bb)))
    (mk-tv (cg-zero-i64 cg) (TInt 64 true))))

; ======================== bit access (BitGet/BitSet) =========================
(defstruct BitAcc [(pv (ptr i8)) (off i64) (width i64) (backing i64)])
(defn bit-access [(cg (ptr Cg)) (pe (ptr Expr)) (fname (slice u8)) (scp (ptr Scope))] (-> BitAcc)
  (let [a (load (field cg a))
        pv (emit-expr cg pe scp)
        sname
          (match (tv-ty pv)
            (TPtr [p2] (match (load p2) (TStruct [s] s) (_ (cg-bug-sl "bit access on non-struct"))))
            (_ (cg-bug-sl "bit access on non-pointer")))
        si (cg-struct-idx cg sname)
        sp (al-elem [CgStruct] (field cg structs) si)
        fs (load (field sp fields))
        nf (al-len [Field] (load fs))
        (mut idx) -1
        (mut i) 0
        r (primitive/alloc-stack BitAcc)]
    (loop (if (>= (load i) nf)
              (break)
              (do
                (when (= (load (field (al-elem [Field] fs (load i)) name)) fname)
                  (store! idx
                          (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.pv r) (tv-val pv))
    (set! (.width r)
          (match (.ty (al-elem [Field] fs (load idx)))
            (TInt [w s] w)
            (TFloat [$g20892] (do (unimplemented "bitfield not int") 0))
            (TBool [] (do (unimplemented "bitfield not int") 0))
            (TVoid [] (do (unimplemented "bitfield not int") 0))
            (TPtr [$g20893] (do (unimplemented "bitfield not int") 0))
            (TRef [$g20894 $g20895] (do (unimplemented "bitfield not int") 0))
            (TStruct [$g20896] (do (unimplemented "bitfield not int") 0))
            (TArray [$g20897 $g20898] (do (unimplemented "bitfield not int") 0))
            (TSlice [$g20899] (do (unimplemented "bitfield not int") 0))
            (TVec [$g20900 $g20901] (do (unimplemented "bitfield not int") 0))
            (TFn [$g20902 $g20903 $g20904] (do (unimplemented "bitfield not int") 0))
            (TApp [$g20905 $g20906] (do (unimplemented "bitfield not int") 0))
            (TNever [] (do (unimplemented "bitfield not int") 0))
            (TCode [] (do (unimplemented "bitfield not int") 0))
            (TCodeBuilder [] (do (unimplemented "bitfield not int") 0))
            (TExternRef [] (do (unimplemented "bitfield not int") 0))))
    (match (.layout sp)
      (LBits [backing offs]
             (do
               (set! (.backing r) backing)
               (set! (.off r) (al-get [i64] (load offs) (load idx)))))
      (_ (do (unimplemented "codegen: not a bit struct") 0)))
    (load r)))
(defn emit-bitget [(cg (ptr Cg)) (pe (ptr Expr)) (fname (slice u8)) (scp (ptr Scope))] (-> Tv)
  (let [b (cg-bld cg)
        ctx (cg-ctx cg)
        ba (primitive/alloc-stack BitAcc)]
    (set! ba (bit-access cg pe fname scp))
    (let [backing-ty (int-width ctx (.backing ba))
          loaded (LLVMBuildLoad2 b backing-ty (load (field ba pv)) (cg-bl cg "bits"))
          off (.off ba)
          width (.width ba)
          shifted
            (if (> off (primitive/cast i64 0))
                (LLVMBuildLShr b loaded (LLVMConstInt backing-ty off 0) (cg-bl cg "shr"))
                loaded)
          field-ty (int-width ctx width)
          res (if (< width (.backing ba)) (LLVMBuildTrunc b shifted field-ty (cg-bl cg "bget")) shifted)]
      (mk-tv res (TInt width false)))))
(defn emit-bitset [(cg (ptr Cg)) (pe (ptr Expr)) (fname (slice u8)) (val (ptr Expr)) (scp (ptr Scope))] (-> Tv)
  (let [b (cg-bld cg)
        ctx (cg-ctx cg)
        ba (primitive/alloc-stack BitAcc)]
    (set! ba (bit-access cg pe fname scp))
    (let [vv (emit-expr cg val scp)
          backing (.backing ba)
          off (.off ba)
          width (.width ba)
          backing-ty (int-width ctx backing)
          loaded (LLVMBuildLoad2 b backing-ty (load (field ba pv)) (cg-bl cg "bits"))
          field-mask (primitive/ishl (primitive/isub (primitive/ishl 1 width) 1) off)
          clear (LLVMConstInt backing-ty (primitive/ixor field-mask -1) 0)
          cleared (LLVMBuildAnd b loaded clear (cg-bl cg "clear"))
          vext (if (< width backing) (LLVMBuildZExt b (tv-val vv) backing-ty (cg-bl cg "vext")) (tv-val vv))
          vshift
            (if (> off (primitive/cast i64 0))
                (LLVMBuildShl b vext (LLVMConstInt backing-ty off 0) (cg-bl cg "vshl"))
                vext)
          newval (LLVMBuildOr b cleared vshift (cg-bl cg "set"))]
      (LLVMBuildStore b newval (load (field ba pv)))
      (mk-tv (tv-val vv) (TInt width false)))))

; ======================== fnptr-of / call-ptr / llvm-ir ======================
(defn emit-fnptr [(cg (ptr Cg)) (name (slice u8))] (-> Tv)
  (let [a (load (field cg a))
        fv (cg-func cg name)]
    (if (= (primitive/cast i64 fv) (primitive/cast i64 0))
        (cg-bug (sconcat a "codegen: fnptr-of unknown " name))
        (let [si (cg-sig-idx cg name)]
          (if (< si (primitive/cast i64 0))
              (cg-bug (sconcat a "codegen: no signature for " name))
              (let [sp (al-elem [CgSig] (field cg sigs) si)]
                (mk-tv fv
                       (TFn
                         :cc (.cc sp)
                         :params (load (field sp params))
                         :ret
                           (box-type a
                                     (.ret sp))))))))))
; An indirect call through a `(fnptr cc …)`.
;
; ⚠ A `c` fnptr must go through the SAME C-ABI lowering a direct extern gets. It
; used to build a plain call from the declared parameter types, so a by-value
; struct was passed as the raw LLVM aggregate while the callee — declared with the
; C-lowered signature — expected packed i64 slots. Structs of 16 and 32 bytes
; happened to agree; 4- and 8-byte ones arrived corrupt, silently
; (docs/archive/BUG_CALLPTR_C_ABI.md). c-signature takes params/ret directly rather than a
; callee name, so the indirect case can use it with no registry entry.
;
; Only the `c` convention is lowered. A non-`c` fnptr keeps the plain call it has
; always had — its convention is Coil-internal, not an ABI boundary.
(defn cg-indirect-cc-id [(cg (ptr Cg)) (name (slice u8))] (-> i64)
  (if (= name "c")
      0
      (let [n (al-len [CgSig] (.sigs cg))
            (mut i) 0
            (mut out) -1]
        ;; A fnptr type retains the source convention name, while LLVM retains only
        ;; its numeric id. Find any declared function using that convention and use
        ;; its already-established id. This also fixes fastcc pointers; hard-coding
        ;; Scheme's qualified convention spelling would be both brittle and wrong.
        (loop (if (>= (load i) n)
                  (break)
                  (let [s (al-elem [CgSig] (field cg sigs) (load i))]
                    (if (= (.cc s) name)
                        (let [f (cg-func cg (.name s))]
                          (when (!= (primitive/cast i64 f) 0)
                            (store! out (primitive/cast i64 (LLVMGetFunctionCallConv f)))
                            (break)))
                        0)
                    (set! i (primitive/iadd (load i) 1)))))
        (load out))))

(defn emit-callptr [(cg (ptr Cg)) (fp (ptr Expr)) (args (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        fpv (emit-expr cg fp scp)
        cc-params-ret
          (match (tv-ty fpv)
            (TFn [c p r] (mk-fnsig c p r))
            (_ (do
                 (unimplemented "codegen: call-ptr on non-fnptr")
                 (mk-fnsig "" (box-al [Type] a (al-new [Type] a)) (box-type a (TInt 64 true))))))
        params (fnsig-params cc-params-ret)
        retp (fnsig-ret cc-params-ret)]
    (cg-validate-pointer! cg (tv-val fpv) "callptr" true)
    (if (= (fnsig-cc cc-params-ret) "c")
        ; NOT guarded by cg-check-c-abi-types, deliberately. The bug report suggested
        ; it, reasoning that a by-value (slice u8) through a `c` fnptr slips past a
        ; rejection the direct path raises. But `c` is the DEFAULT convention for an
        ; ordinary defn, not a marker of an FFI boundary: driver.coil's whole backend
        ; injection surface is (fnptr c [… (slice u8) …] i64) passing Coil to Coil, and
        ; guarding here rejects the compiler's own source. A fnptr cannot tell us
        ; whether its target is a C function or a Coil one — both are `c` — so the
        ; guard has no way to fire only at real boundaries.
        ; The LOWERING below still applies to every `c` fnptr, and that is correct:
        ; fnptr-of hands back the function as declared, and a Coil defn with struct
        ; params IS declared with the C-lowered signature. A slice is unaffected —
        ; c-signature classifies it AAScalar, exactly the type the old path built.
        (let [sig (c-signature cg params retp false)]
          (emit-c-call-ty cg
                          (tv-val fpv)
                          (load (field sig fn_ty))
                          (primitive/cast i32 0)
                          sig
                          (emit-argtv cg args scp)
                          (load retp)
                          "callptr"))
        (let [fnty (cg-fn-type cg params retp)
              vals (emit-vals cg args scp)
              cs
                (LLVMBuildCall2 b
                                fnty
                                (tv-val fpv)
                                (carr a vals)
                                (primitive/cast i32 (al-len [(ptr i8)] vals))
                                (cg-bl cg "callptr"))]
          ;; An indirect pointer has no callee global to query. Recover the LLVM
          ;; id from another signature carrying the same named convention.
          (let [ccid (cg-indirect-cc-id cg (fnsig-cc cc-params-ret))]
            (when (>= ccid 0) (LLVMSetInstructionCallConv cs (primitive/cast i32 ccid)) 0))
          (mk-tv cs (load retp))))))
(defstruct FnSig [(cc (slice u8)) (params (ptr (ArrayList Type))) (ret (ptr Type))])
(defn mk-fnsig [(c (slice u8)) (p (ptr (ArrayList Type))) (r (ptr Type))] (-> FnSig)
  (let [x (primitive/alloc-stack FnSig)]
    (set! (.cc x) c)
    (set! (.params x) p)
    (set! (.ret x) r)
    (load x)))
(defn fnsig-params [(s FnSig)] (-> (ptr (ArrayList Type)))
  (let [x (primitive/alloc-stack FnSig)] (set! x s) (load (field x params))))
(defn fnsig-ret [(s FnSig)] (-> (ptr Type))
  (let [x (primitive/alloc-stack FnSig)] (set! x s) (load (field x ret))))
(defn fnsig-cc [(s FnSig)] (-> (slice u8))
  (let [x (primitive/alloc-stack FnSig)] (set! x s) (.cc x)))

(defn rv32-csr-number [(name (slice u8))] (-> i64)
  (cond (= name "mstatus") 768
        (= name "misa") 769
        (= name "mie") 772
        (= name "mtvec") 773
        (= name "mscratch") 832
        (= name "mepc") 833
        (= name "mcause") 834
        (= name "mtval") 835
        (= name "mip") 836
        (= name "cycle") 3072
        (= name "time") 3073
        (= name "instret") 3074
        (= name "mhartid") 3860
        :else -1))

; Emit one directly encoded RV32 instruction followed by `ret`. This is a tiny
; native system-instruction backend, not inline assembly: LLVM only carries the
; finished bytes in an executable section and emits calls to their address.
(defn cg-rv32-helper [(cg (ptr Cg)) (name (slice u8)) (instruction i64) (trailer i64)] (-> (ptr i8))
  (let [a (load (field cg a))
        ctx (cg-ctx cg)
        module (load (field cg module))
        prior (LLVMGetNamedGlobal module (str->cstr a name))]
    (if (!= (primitive/cast i64 prior) (primitive/cast i64 0))
        prior
        (let [i8t (LLVMInt8TypeInContext ctx)
              (mut bytes) (al-new [(ptr i8)] a)
              (mut i) 0]
          (loop (if (>= (load i) (primitive/cast i64 4))
                    (break)
                    (do
                      (al-push! (mut bytes)
                                (LLVMConstInt i8t
                                              (primitive/iand (primitive/ishr instruction
                                                                              (primitive/imul (load i) 8))
                                                              255)
                                              0))
                      (set! i (primitive/iadd (load i) 1)))))
          (set! i 0)
          (loop (if (>= (load i) (primitive/cast i64 4))
                    (break)
                    (do
                      (al-push! (mut bytes)
                                (LLVMConstInt i8t
                                              (primitive/iand (primitive/ishr trailer
                                                                              (primitive/imul (load i) 8))
                                                              255)
                                              0))
                      (set! i (primitive/iadd (load i) 1)))))
          (let [aty (LLVMArrayType2 i8t 8)
                g (LLVMAddGlobal module aty (str->cstr a name))]
            (LLVMSetInitializer g (LLVMConstArray2 i8t (carr a (load bytes)) 8))
            (LLVMSetGlobalConstant g 1)
            (LLVMSetAlignment g 4)
            (LLVMSetSection g c".text.coil.riscv.system")
            (LLVMSetLinkage g 8)
            g)))))

(defn emit-arch-primitive [(cg (ptr Cg))
                           (result (ptr Type))
                           (args (ptr (ArrayList Expr)))
                           (body (slice u8))
                           (scp (ptr Scope))] (-> Tv)
  (let [a (load (field cg a))
        ctx (cg-ctx cg)
        module (load (field cg module))]
    ; Linker symbols are target-independent. The remaining architecture
    ; primitives below are deliberately limited to the riscv32 reset/runtime API.
    (unless (or (= (load (field cg arch)) (primitive/cast i64 3))
                (starts-with body "coil.arch.linker-address:"))
      (cg-fail "architecture primitive requires a riscv32 target"))
    (cond (starts-with body "coil.arch.linker-address:")
            (let [name (subslice body 25 (slice-len body))
                  cname (str->cstr a name)
                  prior (LLVMGetNamedGlobal module cname)
                  prior-fn (LLVMGetNamedFunction module cname)
                  global
                    (if (!= (primitive/cast i64 prior) (primitive/cast i64 0))
                        prior
                        (if (!= (primitive/cast i64 prior-fn) (primitive/cast i64 0))
                            prior-fn
                            (LLVMAddGlobal module (LLVMInt8TypeInContext ctx) cname)))]
              (mk-tv global (load result)))
          (starts-with body "coil.arch.write-register:")
            (let [name (subslice body 25 (slice-len body))]
              (unless (or (= name "sp") (= name "gp"))
                (cg-fail "write-register!: riscv32 reset code may write only sp or gp"))
              (let [vals (emit-arg-tvs cg args scp)]
                (unless (= (al-len [Tv] (load vals)) (primitive/cast i64 1))
                  (cg-fail "write-register!: compiler operand mismatch"))
                (let [value (tv-val (al-get [Tv] (load vals) 0))
                      i32t (cg-i32t cg)
                      word (LLVMBuildPtrToInt (cg-bld cg) value i32t (cg-bl cg "reg.addr"))
                      (mut ptys) (al-new [(ptr i8)] a)]
                  (al-push! (mut ptys) (LLVMMetadataTypeInContext ctx))
                  (al-push! (mut ptys) i32t)
                  (let [fnty (LLVMFunctionType (LLVMVoidTypeInContext ctx) (carr a (load ptys)) 2 0)
                        prior (LLVMGetNamedFunction module c"llvm.write_register.i32")
                        fn
                          (if (!= (primitive/cast i64 prior) (primitive/cast i64 0))
                              prior
                              (LLVMAddFunction module c"llvm.write_register.i32" fnty))
                        md
                          (LLVMMDStringInContext2 ctx
                                                  (primitive/cast (ptr i8) (slice-data [u8] name))
                                                  (slice-len name))
                        (mut mdparts) (al-new [(ptr i8)] a)
                        (mut argv) (al-new [(ptr i8)] a)]
                    (al-push! (mut mdparts) md)
                    (let [mdnode (LLVMMDNodeInContext2 ctx (carr a (load mdparts)) 1)]
                      (al-push! (mut argv) (LLVMMetadataAsValue ctx mdnode)))
                    (al-push! (mut argv) word)
                    (LLVMBuildCall2 (cg-bld cg) fnty fn (carr a (load argv)) 2 (cg-bl cg ""))
                    (mk-tv (cg-zero-i64 cg) (load result))))))
          (starts-with body "coil.arch.csr-read:")
            (let [name (subslice body 19 (slice-len body))
                  csr (rv32-csr-number name)]
              (when (< csr (primitive/cast i64 0))
                (cg-fail (sconcat a "csr-read: unsupported CSR " name)))
              ; csrrs a0, csr, x0
              (let [instruction
                      (primitive/ior (primitive/ishl csr 20)
                                     (primitive/ior (primitive/ishl 2 12)
                                                    (primitive/ior (primitive/ishl 10 7) 115)))
                    helper (cg-rv32-helper cg (sconcat a "__coil_csr_read_" name) instruction 32871)
                    (mut ptys) (al-new [(ptr i8)] a)
                    fnty (LLVMFunctionType (cg-i32t cg) (carr a (load ptys)) 0 0)
                    (mut argv) (al-new [(ptr i8)] a)
                    call (LLVMBuildCall2 (cg-bld cg) fnty helper (carr a (load argv)) 0 (cg-bl cg "csr"))]
                (mk-tv call (load result))))
          (starts-with body "coil.arch.csr-write:")
            (let [name (subslice body 20 (slice-len body))
                  csr (rv32-csr-number name)
                  vals (emit-arg-tvs cg args scp)]
              (when (< csr (primitive/cast i64 0))
                (cg-fail (sconcat a "csr-write!: unsupported CSR " name)))
              (unless (= (al-len [Tv] (load vals)) (primitive/cast i64 1))
                (cg-fail "csr-write!: compiler operand mismatch"))
              ; csrrw x0, csr, a0
              (let [instruction
                      (primitive/ior (primitive/ishl csr 20)
                                     (primitive/ior (primitive/ishl 10 15)
                                                    (primitive/ior (primitive/ishl 1 12) 115)))
                    helper (cg-rv32-helper cg (sconcat a "__coil_csr_write_" name) instruction 32871)
                    (mut ptys) (al-new [(ptr i8)] a)
                    (mut argv) (al-new [(ptr i8)] a)]
                (al-push! (mut ptys) (cg-i32t cg))
                (al-push! (mut argv) (tv-val (al-get [Tv] (load vals) 0)))
                (let [fnty (LLVMFunctionType (LLVMVoidTypeInContext ctx) (carr a (load ptys)) 1 0)]
                  (LLVMBuildCall2 (cg-bld cg) fnty helper (carr a (load argv)) 1 (cg-bl cg ""))
                  (mk-tv (cg-zero-i64 cg) (load result)))))
          (= body "coil.arch.wfi")
            (let [helper (cg-rv32-helper cg "__coil_wfi" 273678451 32871)
                  (mut ptys) (al-new [(ptr i8)] a)
                  fnty (LLVMFunctionType (LLVMVoidTypeInContext ctx) (carr a (load ptys)) 0 0)
                  (mut argv) (al-new [(ptr i8)] a)]
              (LLVMBuildCall2 (cg-bld cg) fnty helper (carr a (load argv)) 0 (cg-bl cg ""))
              (mk-tv (cg-zero-i64 cg) (load result)))
          (= body "coil.arch.mret")
            (let [helper (cg-rv32-helper cg "__coil_mret" 807403635 0)
                  (mut ptys) (al-new [(ptr i8)] a)
                  fnty (LLVMFunctionType (LLVMVoidTypeInContext ctx) (carr a (load ptys)) 0 0)
                  (mut argv) (al-new [(ptr i8)] a)]
              (LLVMBuildCall2 (cg-bld cg) fnty helper (carr a (load argv)) 0 (cg-bl cg ""))
              (mk-tv (cg-zero-i64 cg) (load result)))
          :else
            (do
              (cg-fail "unknown architecture primitive")
              (mk-tv (primitive/cast (ptr i8) 0) (load result))))))

(defn alias-type-name [(t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TInt [bits _]
          (if (= bits 8)
              "omnipotent char"
              (if (= bits 16) "integer16" (if (= bits 32) "integer32" "integer64"))))
    (TBool [] "boolean")
    (TFloat [bits] (if (= bits 32) "float32" "float64"))
    (TPtr [_] "any pointer")
    (TRef [_ _] "any pointer")
    (TFn [_ _ _] "any pointer")
    (_ "omnipotent char")))

; Attach a scalar TBAA access tag. alias-load/alias-store! are an explicit unsafe
; promise that accesses obey type-based aliasing; ordinary Coil load/store keep
; the language's permissive pointer-cast semantics and deliberately have no tag.
(defn set-alias-metadata [(cg (ptr Cg)) (inst (ptr i8)) (t (ptr Type))] (-> i64)
  (let [ctx (cg-ctx cg)
        root-name "Coil explicit type aliasing"
        char-name "omnipotent char"
        root-text
          (LLVMMDStringInContext2 ctx
                                  (primitive/cast (ptr i8) (slice-data [u8] root-name))
                                  (slice-len root-name))
        root-ops (primitive/alloc-stack (array (ptr i8) 1))
        _a (store! (primitive/index root-ops 0) root-text)
        root (LLVMMDNodeInContext2 ctx root-ops 1)
        zero (LLVMValueAsMetadata (LLVMConstInt (cg-i64t cg) 0 0))
        char-text
          (LLVMMDStringInContext2 ctx
                                  (primitive/cast (ptr i8) (slice-data [u8] char-name))
                                  (slice-len char-name))
        char-ops (primitive/alloc-stack (array (ptr i8) 3))
        _b (store! (primitive/index char-ops 0) char-text)
        _c (store! (primitive/index char-ops 1) root)
        _d (store! (primitive/index char-ops 2) zero)
        char-node (LLVMMDNodeInContext2 ctx char-ops 3)
        type-name (alias-type-name t)
        type-node
          (if (= type-name char-name)
              char-node
              (let [type-text
                      (LLVMMDStringInContext2 ctx
                                              (primitive/cast (ptr i8) (slice-data [u8] type-name))
                                              (slice-len type-name))
                    type-ops (primitive/alloc-stack (array (ptr i8) 3))]
                (store! (primitive/index type-ops 0) type-text)
                (store! (primitive/index type-ops 1) char-node)
                (store! (primitive/index type-ops 2) zero)
                (LLVMMDNodeInContext2 ctx type-ops 3)))
        tag-ops (primitive/alloc-stack (array (ptr i8) 3))
        _e (store! (primitive/index tag-ops 0) type-node)
        _f (store! (primitive/index tag-ops 1) type-node)
        _g (store! (primitive/index tag-ops 2) zero)
        tag (LLVMMDNodeInContext2 ctx tag-ops 3)
        kind-name "tbaa"
        kind
          (LLVMGetMDKindIDInContext ctx
                                    (primitive/cast (ptr i8) (slice-data [u8] kind-name))
                                    4)]
    (LLVMSetMetadata inst kind (LLVMMetadataAsValue ctx tag))
    0))

(defn emit-memory-primitive [(cg (ptr Cg))
                             (result (ptr Type))
                             (args (ptr (ArrayList Expr)))
                             (body (slice u8))
                             (scp (ptr Scope))] (-> Tv)
  (let [vals (emit-arg-tvs cg args scp)
        b (cg-bld cg)]
    (cond (= body "coil.mem.volatile-load")
            (do
              (unless (= (al-len [Tv] (load vals)) (primitive/cast i64 1))
                (cg-fail "volatile-load: compiler operand mismatch"))
              (let [inst
                      (LLVMBuildLoad2 b
                                      (basic-ty cg result)
                                      (tv-val (al-get [Tv] (load vals) 0))
                                      (cg-bl cg "volatile.load"))]
                (LLVMSetVolatile inst 1)
                (mk-tv inst (load result))))
          (= body "coil.mem.volatile-store")
            (do
              (unless (= (al-len [Tv] (load vals)) (primitive/cast i64 2))
                (cg-fail "volatile-store!: compiler operand mismatch"))
              (let [inst
                      (LLVMBuildStore b
                                      (tv-val (al-get [Tv] (load vals) 1))
                                      (tv-val (al-get [Tv] (load vals) 0)))]
                (LLVMSetVolatile inst 1)
                (mk-tv (cg-zero-i64 cg) (load result))))
          (= body "coil.mem.alias-load")
            (do
              (unless (= (al-len [Tv] (load vals)) (primitive/cast i64 1))
                (cg-fail "alias-load: compiler operand mismatch"))
              (let [inst
                      (LLVMBuildLoad2 b
                                      (basic-ty cg result)
                                      (tv-val (al-get [Tv] (load vals) 0))
                                      (cg-bl cg "alias.load"))]
                (set-alias-metadata cg inst result)
                (mk-tv inst (load result))))
          (= body "coil.mem.alias-store")
            (do
              (unless (= (al-len [Tv] (load vals)) (primitive/cast i64 2))
                (cg-fail "alias-store!: compiler operand mismatch"))
              (let [value (al-get [Tv] (load vals) 1)
                    inst
                      (LLVMBuildStore b
                                      (tv-val value)
                                      (tv-val (al-get [Tv] (load vals) 0)))]
                (set-alias-metadata cg inst (box-type (load (field cg a)) (tv-ty value)))
                (mk-tv (cg-zero-i64 cg) (load result))))
          (= body "coil.mem.fence")
            (do
              (LLVMBuildFence b 7 0 (cg-bl cg "fence"))
              (mk-tv (cg-zero-i64 cg) (load result)))
          :else
            (do
              (cg-fail "unknown memory primitive")
              (mk-tv (primitive/cast (ptr i8) 0) (load result))))))

(defn emit-llvm-ir [(cg (ptr Cg)) (result (ptr Type)) (args (ptr (ArrayList Expr))) (body (slice u8)) (scp (ptr Scope))] (-> Tv)
  (if (starts-with body "coil.arch.")
      (emit-arch-primitive cg result args body scp)
      (if (starts-with body "coil.mem.")
          (emit-memory-primitive cg result args body scp)
          (let [a (load (field cg a))
                b (cg-bld cg)
                argtv (emit-arg-tvs cg args scp)
                nargs (al-len [Tv] (load argtv))
                ret-str (cstr->slice (LLVMPrintTypeToString (basic-ty cg result)))
                ; substitute placeholders, highest index first.
                (mut text) body
                (mut i) (primitive/isub nargs 1)]
            (loop (if (< (load i) (primitive/cast i64 0))
                      (break)
                      (do
                        (let [argstr
                                (cstr->slice (LLVMPrintTypeToString (basic-ty cg
                                                                              (box-type a
                                                                                        (tv-ty (al-get [Tv]
                                                                                                       (load argtv)
                                                                                                       (load i)))))))]
                          (set! text (str-replace-all a (load text) (sconcat a "$t" (i64->str a (load i))) argstr))
                          (set! text
                                (str-replace-all a
                                                 (load text)
                                                 (sconcat a "$" (i64->str a (load i)))
                                                 (sconcat a "%" (i64->str a (load i))))))
                        (set! i (primitive/isub (load i) 1)))))
            (set! text (str-replace-all a (load text) "$ret" ret-str))
            ; hoist `declare` lines; build the helper module text.
            (let [lines (nz-split-lines a (load text))
                  nl (al-len [(slice u8)] lines)
                  (mut decls) (sb-new a)
                  (mut fnbody) (sb-new a)
                  (mut j) 0]
              (loop (if (>= (load j) nl)
                        (break)
                        (do
                          (let [ln (al-get [(slice u8)] lines (load j))]
                            (if (starts-with (str-ltrim ln) "declare")
                                (do (sb-push-str! (mut decls) ln) (sb-push-byte! (mut decls) 10))
                                (do (sb-push-str! (mut fnbody) ln) (sb-push-byte! (mut fnbody) 10))))
                          (set! j (primitive/iadd (load j) 1)))))
              (let [seq (.llvm_seq cg)]
                (set! (.llvm_seq cg) (primitive/iadd seq 1))
                (let [name (sconcat a "__coil_llvm_ir_" (i64->str a seq))
                      (mut params) (sb-new a)
                      (mut k) 0]
                  (loop (if (>= (load k) nargs)
                            (break)
                            (do
                              (when (> (load k) (primitive/cast i64 0)) (sb-push-str! (mut params) ", "))
                              (let [argstr
                                      (cstr->slice (LLVMPrintTypeToString (basic-ty cg
                                                                                    (box-type a
                                                                                              (tv-ty (al-get [Tv]
                                                                                                             (load argtv)
                                                                                                             (load k)))))))]
                                (sb-push-str! (mut params) argstr)
                                (sb-push-str! (mut params) " %")
                                (sb-push-str! (mut params) (i64->str a (load k))))
                              (set! k (primitive/iadd (load k) 1)))))
                  (let [(mut mt) (sb-new a)]
                    (sb-push-str! (mut mt) (sb-str (load decls)))
                    (sb-push-str! (mut mt) "define ")
                    (sb-push-str! (mut mt) ret-str)
                    (sb-push-str! (mut mt) " @")
                    (sb-push-str! (mut mt) name)
                    (sb-push-str! (mut mt) "(")
                    (sb-push-str! (mut mt) (sb-str (load params)))
                    (sb-push-str! (mut mt) ") alwaysinline {\n")
                    (sb-push-str! (mut mt) (sb-str (load fnbody)))
                    (sb-push-str! (mut mt) "}\n")
                    (let [mtext (sb-str (load mt))
                          membuf
                            (LLVMCreateMemoryBufferWithMemoryRangeCopy (primitive/cast (ptr i8) (slice-data [u8] mtext))
                                                                       (slice-len mtext)
                                                                       (cg-bl cg "coil_llvm_ir"))
                          modout (primitive/alloc-stack (ptr i8))
                          errout (primitive/alloc-stack (ptr i8))]
                      (if (!= (LLVMParseIRInContext (cg-ctx cg) membuf modout errout) (primitive/cast i32 0))
                          ; Parse failure: the message is LLVM's own, which is
                          ; itself `{:?}` (Debug) over its `Deref::Target = CStr` — so the LLVM
                          ; error message (read from the `errout` char** out-param) is CStr-Debug-
                          ; escaped (quoted, `\n`, `\'`, `\xHH` …) via cstr-dbg-escape; the
                          ; `--- generated module ---` section is the module text we just built
                          ; (mtext). cg-fail renders it as `error: <body>` + exit 1.
                          (do
                            (cg-fail (sconcat a
                                              (sconcat3 a
                                                        "llvm-ir: could not parse IR: "
                                                        (sconcat3 a
                                                                  "\""
                                                                  (cstr-dbg-escape a (cstr->slice (load errout)))
                                                                  "\"")
                                                        "\n--- generated module ---\n")
                                              mtext))
                            (mk-tv (primitive/cast (ptr i8) 0) (load result)))
                          (let [helper (load modout)]
                            (LLVMSetTarget helper (LLVMGetTarget (load (field cg module))))
                            (LLVMSetDataLayout helper (LLVMGetDataLayoutStr (load (field cg module))))
                            (LLVMLinkModules2 (load (field cg module)) helper)
                            (let [callee (LLVMGetNamedFunction (load (field cg module)) (str->cstr a name))]
                              (LLVMSetLinkage callee 8)
                              (let [(mut vs) (al-new [(ptr i8)] a)
                                    (mut q) 0]
                                (loop (if (>= (load q) nargs)
                                          (break)
                                          (do
                                            (al-push! (mut vs) (tv-val (al-get [Tv] (load argtv) (load q))))
                                            (set! q (primitive/iadd (load q) 1)))))
                                (mk-tv (LLVMBuildCall2 b
                                                       (LLVMGlobalGetValueType callee)
                                                       callee
                                                       (carr a (load vs))
                                                       (primitive/cast i32 nargs)
                                                       (cg-bl cg "llvmir"))
                                       (load result)))))))))))))))
(defn emit-arg-tvs [(cg (ptr Cg)) (es (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> (ArrayList Tv))
  (let [n (al-len [Expr] (load es))
        (mut out) (al-new [Tv] (load (field cg a)))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (emit-expr cg (al-elem [Expr] es (load i)) scp))
                (set! i (primitive/iadd (load i) 1)))))
    (load out)))
(defn str-ltrim [(s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        (mut i) 0]
    (loop (if (or (>= (load i) n) (!= (primitive/cast i64 (slice-get s (load i))) (primitive/cast i64 32)))
              (break)
              (set! i (primitive/iadd (load i) 1))))
    (substr s (load i) n)))

; ======================== emit_func / emit_tail ==============================
(defn emit-c-return [(cg (ptr Cg)) (sig (ptr CSig)) (ret (ptr Type)) (last Tv)] (-> i64)
  (let [b (cg-bld cg)]
    (if (ty-is-void ret)
        (do (LLVMBuildRetVoid b) 0)
        (let [has-sret
                (and (!= (primitive/cast i64 sig) (primitive/cast i64 0))
                     (!= (primitive/cast i64
                                         (load (field sig
                                                      sret)))
                         (primitive/cast i64 0)))
              has-rd
                (and (!= (primitive/cast i64 sig) (primitive/cast i64 0))
                     (!= (primitive/cast i64
                                         (load (field sig
                                                      ret_direct)))
                         (primitive/cast i64 0)))]
          (if (not (or has-sret has-rd))
              (do (LLVMBuildRet b (tv-val last)) 0)
              (let [sa (if has-sret (load (field sig sret)) (load (field sig ret_direct)))
                    lv (tv-val last)
                    src
                      (if (= (LLVMGetTypeKind (LLVMTypeOf lv)) (primitive/cast i32 12))
                          lv
                          (let [slot (cg-struct-slot-padded cg sa "ret.spill")] (LLVMBuildStore b lv slot) slot))]
                (if has-sret
                    (do (cg-copy-struct cg (LLVMGetParam (cg-cur-func cg) 0) src sa) (LLVMBuildRetVoid b) 0)
                    (do
                      (LLVMBuildRet b (LLVMBuildLoad2 b (abi-direct-return-type cg sa) src (cg-bl cg "abi.ret.coerce")))
                      0))))))))
;; May this call in tail position be emitted as a tail call?
;;
;; SELF-calls have always qualified. MUTUAL tail calls now do too, when the
;; callee's LLVM function type is IDENTICAL to the caller's — which is exactly
;; what `musttail` requires: same return type, same parameter types, same calling
;; convention, and the call immediately followed by `ret`.
;;
;; Why this matters: without it, `(define (even? n) (if (= n 0) #t (odd? (- n 1))))`
;; emits a plain unmarked `call`. It only survives deep recursion when LLVM's
;; optimizer happens to apply TCE on its own — an accident, not a guarantee, and
;; R5RS requires the guarantee. Verified: before this change the mutual pair
;; emitted `call i64 @tcmutual.is-odd`, where the self-recursive case emitted
;; `musttail call`.
;;
;; The type-identity test is the safety property. A tail call to a function with
;; a different signature cannot reuse the frame — LLVM would reject the
;; `musttail` outright — so comparing `LLVMGlobalGetValueType` on both sides is
;; not a heuristic but the precondition itself. It is also why this is such a
;; good fit for the Scheme dialect: every Scheme procedure lowers to `i64` params
;; returning `i64`, so the types match uniformly.
;;
;; `cg-has-csig` still disqualifies: a function with a C signature goes through
;; ABI adaptation (sret pointers, aggregate coercion) that a tail call cannot
;; carry.
(defn tail-call-ok [(cg (ptr Cg)) (func (slice u8)) (function (ptr i8))] (-> bool)
  (if (or (cg-has-csig cg func) (cg-inline-func? cg func))
      false
      (let [callee (cg-func cg func)]
        (if (= (primitive/cast i64 callee) (primitive/cast i64 0))
            false
            (if (= (primitive/cast i64 callee) (primitive/cast i64 function))
                true
                ; ⚠ NOT ON WASM. LLVM lowers `musttail` to a `return_call`,
                ; which needs the Wasm 3.0 `+tail-call` feature — and
                ; `llvm-cpu-features` still returns an empty string with a
                ; TODO, so that feature is NOT enabled. Emitting musttail here
                ; fails the whole build:
                ;
                ;   error: in function mh_fail i64 (i64):
                ;          WebAssembly 'tail-call' feature not enabled
                ;
                ; This did not bite before mutual tail calls were allowed
                ; because self-recursion alone never reached the affected
                ; functions. Restricting to self-calls on wasm restores the
                ; previous behaviour exactly; when `+tail-call` is turned on,
                ; delete this clause (see issue #1).
                (if (= (.arch cg) (primitive/cast i64 2))
                    false
                    (let [cty (LLVMGlobalGetValueType callee)
                          fty (LLVMGlobalGetValueType function)
                          cc (primitive/cast i64 (LLVMGetFunctionCallConv function))]
                      ; A DIFFERENT function must use the same convention and
                      ; scalar-only ABI. Ordinary conventions additionally need
                      ; identical prototypes. LLVM tailcc deliberately relaxes that
                      ; last rule, which is what permits Scheme f/1 to tail call g/2.
                      (and (= (primitive/cast i64 (LLVMGetFunctionCallConv callee)) cc)
                           (and (cg-fnty-all-scalar? fty)
                                (and (cg-fnty-all-scalar? cty)
                                     (or (= (primitive/cast i64 cty) (primitive/cast i64 fty))
                                         (and (or (= cc 18) (= cc 20))
                                              (= (primitive/cast i64 (LLVMGetReturnType cty))
                                                 (primitive/cast i64 (LLVMGetReturnType fty)))))))))))))))

;; Every parameter and the return are first-class scalars (no pointers, structs
;; or arrays), so a tail call needs no ABI adaptation and carries no parameter
;; attributes that would make LLVM refuse it.
(defn cg-fnty-all-scalar? [(fnty (ptr i8))] (-> bool)
  (and (cg-llty-scalar? (LLVMGetReturnType fnty))
       (let [n (primitive/cast i64 (LLVMCountParamTypes fnty))
             a (primitive/alloc-stack (array (ptr i8) 32))]
         (if (> n (primitive/cast i64 32))
             false
             (do
               (LLVMGetParamTypes fnty (primitive/cast (ptr (ptr i8)) a))
               (let [(mut i) 0
                     (mut ok) true]
                 (loop (if (>= (load i) n)
                           (break)
                           (do
                             (when (not (cg-llty-scalar? (load (primitive/index a (load i)))))
                               (store! ok false)
                               0)
                             (set! i (primitive/iadd (load i) 1)))))
                 (load ok)))))))

;; Integer, float or double — the kinds that pass in registers with no parameter
;; attribute and no indirection. Struct (10), Array (11) and Pointer (12) are out.
;; Kind numbers are LLVM-C's, matching the existing uses in this file
;; (`slot-is-sse?` reads float=2/double=3, and the pointer checks read 12).
(defn cg-llty-scalar? [(t (ptr i8))] (-> bool)
  (let [k (primitive/cast i64 (LLVMGetTypeKind t))]
    (or (= k (primitive/cast i64 8))  ; Integer
        (or (= k (primitive/cast i64 2))  ; Float
            (= k (primitive/cast i64 3))))))  ; Double
(defn emit-tail [(cg (ptr Cg)) (e (ptr Expr)) (function (ptr i8)) (sig (ptr CSig)) (ret (ptr Type)) (scp (ptr Scope))] (-> i64)
  (let [a (load (field cg a))
        b (cg-bld cg)]
    (match (.kind e)
      (EDo [body]
           (let [n (al-len [Expr] (load body))]
             (if (= n (primitive/cast i64 0))
                 (emit-c-return cg sig ret (mk-tv (cg-zero-i64 cg) (TInt 64 true)))
                 (let [(mut i) 0]
                   (loop (if (or (>= (load i) (primitive/isub n 1)) (cg-terminated cg))
                             (break)
                             (do
                               (emit-expr cg (al-elem [Expr] body (load i)) scp)
                               (set! i (primitive/iadd (load i) 1)))))
                   (when (not (cg-terminated cg))
                     (emit-tail cg (al-elem [Expr] body (primitive/isub n 1)) function sig ret scp))))))
      (ELet [binds body]
            (let [child (emit-binds cg binds scp)
                  n (al-len [Expr] (load body))]
              (unless (= n (primitive/cast i64 0))
                (let [(mut i) 0]
                  (loop (if (or (>= (load i) (primitive/isub n 1)) (cg-terminated cg))
                            (break)
                            (do
                              (emit-expr cg (al-elem [Expr] body (load i)) child)
                              (store! i (primitive/iadd (load i) 1)))))
                  (when (not (cg-terminated cg))
                    (emit-tail cg (al-elem [Expr] body (primitive/isub n 1)) function sig ret child))))))
      (EIf [cnd thn els]
           (let [cv (emit-expr cg cnd scp)
                 c (tv-val cv)
                 cmp (LLVMBuildICmp b 33 c (cg-zero (LLVMTypeOf c)) (cg-bl cg "ifc"))
                 then-bb (cg-append cg function (cg-bl cg "then"))
                 else-bb (cg-append cg function (cg-bl cg "else"))]
             (LLVMBuildCondBr b cmp then-bb else-bb)
             (cg-pos cg then-bb)
             (emit-tail cg thn function sig ret scp)
             (cg-pos cg else-bb)
             (emit-tail cg els function sig ret scp)))
      (ECall [func targs args]
             (if (or (tail-call-ok cg func function)
                     (= (primitive/cast i64 function)
                        (primitive/cast i64 (load (field cg reset_func)))))
                 (let [vals (emit-vals cg args scp)
                       callee (cg-func cg func)
                       cs
                         (LLVMBuildCall2 b
                                         (LLVMGlobalGetValueType callee)
                                         callee
                                         (carr a vals)
                                         (primitive/cast i32 (al-len [(ptr i8)] vals))
                                         (cg-call-name cg (LLVMGlobalGetValueType callee) "tailcall"))]
                   (LLVMSetInstructionCallConv cs (LLVMGetFunctionCallConv callee))
                   ; musttail (kind 2) guarantees TCO, but the x86-64 SysV backend cannot
                   ; tail-call a self-recursion whose return is a large aggregate: SysV
                   ; classifies it MEMORY and returns it via a hidden sret pointer, and LLVM
                   ; aborts codegen ("failed to perform tail call elimination on a call site
                   ; marked musttail"). AArch64 returns aggregates via x8 and tail-calls them
                   ; fine, so it keeps musttail. On x86, when the callee's LLVM return type is
                   ; a Struct (10) or Array (11), downgrade to `tail` (kind 1): a hint LLVM
                   ; applies where it can (scalar self-calls still get real TCO) and otherwise
                   ; degrades to a normal call. Scalar/pointer returns keep guaranteed musttail.
                   (let [rk (LLVMGetTypeKind (LLVMGetReturnType (LLVMGlobalGetValueType callee)))
                         x86-agg
                           (and (= (.arch cg) (primitive/cast i64 0))
                                (or (= (primitive/cast i64 rk) (primitive/cast i64 10))
                                    (= (primitive/cast i64 rk)
                                       (primitive/cast i64 11))))]
                     (LLVMSetTailCallKind cs (if x86-agg 1 2)))
                   (if (ty-is-void ret) (do (LLVMBuildRetVoid b) 0) (do (LLVMBuildRet b cs) 0)))
                 (let [v (emit-expr cg e scp)] (when (not (cg-terminated cg)) (emit-c-return cg sig ret v)))))
      (ECallPtr [fp args]
                (let [v (emit-callptr cg fp args scp)]
                  (if (and (let [cc (primitive/cast i64 (LLVMGetFunctionCallConv function))]
                             (or (= cc 18) (= cc 20)))
                           (= (primitive/cast i64 (LLVMGetInstructionCallConv (tv-val v)))
                              (primitive/cast i64 (LLVMGetFunctionCallConv function))))
                      (do
                        ;; tailcc permits the pointer's argument list to differ from the
                        ;; caller's. The checker has already proved the pointer call's
                        ;; own argument types, and both Scheme sides return i64.
                        (LLVMSetTailCallKind (tv-val v) 2)
                        (LLVMBuildRet b (tv-val v))
                        0)
                      (when (not (cg-terminated cg)) (emit-c-return cg sig ret v)))))
      (EMatch [scrut arms] (emit-tail-match cg scrut arms function sig ret scp))
      (_ (let [v (emit-expr cg e scp)] (when (not (cg-terminated cg)) (emit-c-return cg sig ret v)))))))
(defn emit-tail-match [(cg (ptr Cg))
                       (scrut (ptr Expr))
                       (arms (ptr (ArrayList Arm)))
                       (function (ptr i8))
                       (sig (ptr CSig))
                       (ret (ptr Type))
                       (scp (ptr Scope))] (-> i64)
  (let [a (load (field cg a))
        b (cg-bld cg)
        sv (emit-expr cg scrut scp)
        sumname (match (tv-ty sv) (TStruct [s] s) (_ (cg-bug-sl "codegen: match on non-sum")))
        ui (cg-sum-idx cg sumname)
        sp (al-elem [CgSum] (field cg sums) ui)
        sum-ty (load (field sp ty))
        tmp (cg-entry-alloca cg sum-ty (cg-bl cg "match.tmp"))]
    (LLVMBuildStore b (tv-val sv) tmp)
    (let [tagptr (LLVMBuildStructGEP2 b sum-ty tmp 0 (cg-bl cg "tag"))
          tag (LLVMBuildLoad2 b (cg-i32t cg) tagptr (cg-bl cg "tag"))
          payload (LLVMBuildStructGEP2 b sum-ty tmp 1 (cg-bl cg "payload"))
          narms (al-len [Arm] (load arms))
          ncases (if (arms-have-wildcard arms) (primitive/isub narms 1) narms)
          (mut armbbs) (al-new [(ptr i8)] a)
          (mut k) 0]
      (loop (if (>= (load k) narms)
                (break)
                (do
                  (al-push! (mut armbbs) (cg-append cg function (cg-bl cg "arm")))
                  (set! k (primitive/iadd (load k) 1)))))
      (let [default
              (if (= ncases narms)
                  (cg-append cg function (cg-bl cg "match.default"))
                  (al-get [(ptr i8)] (load armbbs) ncases))
            (mut k2) 0
            sw (LLVMBuildSwitch b tag default (primitive/cast i32 ncases))]
        (loop (if (>= (load k2) ncases)
                  (break)
                  (do
                    (let [ap (al-elem [Arm] arms (load k2))
                          vidx (cg-variant-idx cg sp (.variant ap))]
                      (LLVMAddCase sw (LLVMConstInt (cg-i32t cg) vidx 0) (al-get [(ptr i8)] (load armbbs) (load k2))))
                    (set! k2 (primitive/iadd (load k2) 1)))))
        (when (= ncases narms) (cg-pos cg default) (LLVMBuildUnreachable b) 0)
        (let [(mut k3) 0]
          (loop (if (>= (load k3) narms)
                    (break)
                    (do
                      (cg-pos cg (al-get [(ptr i8)] (load armbbs) (load k3)))
                      (let [ap (al-elem [Arm] arms (load k3))
                            vidx
                              (if (>= (load k3) ncases)
                                  0
                                  (cg-variant-idx cg sp (.variant ap)))
                            var-struct (al-get [(ptr i8)] (load (field sp vstructs)) vidx)
                            vp (al-elem [Variant] (load (field sp variants)) vidx)
                            vfs (load (field vp fields))
                            binds (load (field ap binds))
                            nb (al-len [(slice u8)] (load binds))
                            (mut child) scp
                            (mut j) 0]
                        (loop (if (>= (load j) nb)
                                  (break)
                                  (do
                                    (let [fptr
                                            (LLVMBuildStructGEP2 b
                                                                 var-struct
                                                                 payload
                                                                 (primitive/cast i32 (load j))
                                                                 (cg-bl cg "vf"))
                                          fty (.ty (al-elem [Field] vfs (load j)))
                                          bname (al-get [(slice u8)] (load binds) (load j))
                                          fval
                                            (LLVMBuildLoad2 b (basic-ty cg (box-type a fty)) fptr (str->cstr a bname))]
                                      (set! child (scope-put a (load child) bname fval fty)))
                                    (set! j (primitive/iadd (load j) 1)))))
                        (emit-tail cg (field ap body) function sig ret (load child)))
                      (set! k3 (primitive/iadd (load k3) 1)))))
          0)))))

(defn func-inline-policy [(f (ptr Func))] (-> i64)
  (let [anns (load (field f annotations))
        n (al-len [Annotation] (load anns))
        (mut i) 0
        (mut policy) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ap (al-elem [Annotation] anns (load i))]
                  (when (= (load (field ap key)) "inline")
                    (match (load (field (field ap value) kind))
                      (EConstruct [_sum variant _args]
                                  (let [v (after-last-dot variant)]
                                    (if (= v "Always")
                                        (store! policy 1)
                                        (if (= v "Hint")
                                            (store! policy 2)
                                            (when (= v "Never") (store! policy 3))))))
                      (ECall [func _type_args _args]
                             (let [v (after-last-dot func)]
                               (if (= v "Always")
                                   (store! policy 1)
                                   (if (= v "Hint")
                                       (store! policy 2)
                                       (when (= v "Never") (store! policy 3))))))
                      (_ 0))))
                (set! i (primitive/iadd (load i) 1)))))
    (load policy)))

(defn func-inline-always? [(f (ptr Func))] (-> bool)
  (= (func-inline-policy f) 1))

(defn emit-func [(cg (ptr Cg)) (f (ptr Func)) (function (ptr i8))] (-> i64)
  (let [a (load (field cg a))
        b (cg-bld cg)
        entry (cg-append cg function (cg-bl cg "entry"))
        sig (cg-csig cg (.name f))
        base
          (when (and (!= (primitive/cast i64 sig) (primitive/cast i64 0))
                     (!= (primitive/cast i64
                                         (load (field sig
                                                      sret)))
                         (primitive/cast i64 0)))
            1)]
    (set! (.nstatic cg) 0)
    (let [policy (func-inline-policy f)]
      (if (= policy 1)
          (do (LLVMAddAttributeAtIndex function (primitive/cast i32 -1) (cg-enum-attr cg "alwaysinline" 0)) 0)
          (if (= policy 2)
              (do (LLVMAddAttributeAtIndex function (primitive/cast i32 -1) (cg-enum-attr cg "inlinehint" 0)) 0)
              (when (= policy 3)
                (LLVMAddAttributeAtIndex function (primitive/cast i32 -1) (cg-enum-attr cg "noinline" 0))
                0)))
      0)
    (cg-pos cg entry)
    (let [params (load (field f params))
          np (al-len [Param] (load params))
          (mut scp) (scope-nil a)
          (mut idx) base
          (mut i) 0]
      (loop (if (>= (load i) np)
                (break)
                (do
                  (let [pp (al-elem [Param] params (load i))
                        pname (.name pp)
                        pty (.ty pp)
                        aa (if (!= (primitive/cast i64 sig) (primitive/cast i64 0)) (cg-argabi sig (load i)) (AAScalar))]
                    (match aa
                      (AADirect [sa]
                                (let [slot (cg-struct-slot cg sa (sconcat a pname ".arg"))]
                                  (match (.arg sa)
                                    (ACDirect [slots]
                                              (let [ns (al-len [(ptr i8)] (load slots))
                                                    (mut k) 0]
                                                (loop (if (>= (load k) ns)
                                                          (break)
                                                          (do
                                                            (let [v
                                                                    (LLVMGetParam function
                                                                                  (primitive/cast i32
                                                                                                  (load idx)))
                                                                  off (primitive/imul (load k) 8)
                                                                  gep
                                                                    (if (= off (primitive/cast i64 0))
                                                                        slot
                                                                        (cg-gep-i8 cg slot off))]
                                                              (LLVMBuildStore b v gep)
                                                              (set! idx (primitive/iadd (load idx) 1)))
                                                            (set! k (primitive/iadd (load k) 1)))))
                                                0))
                                    (_ 0))
                                  (set! scp
                                        (scope-put a
                                                   (load scp)
                                                   pname
                                                   (LLVMBuildLoad2 b
                                                                   (load (field sa llvm_ty))
                                                                   slot
                                                                   (str->cstr a pname))
                                                   pty))))
                      (AAIndirect [sa]
                                  (let [ptr (LLVMGetParam function (primitive/cast i32 (load idx)))
                                        val (LLVMBuildLoad2 b (load (field sa llvm_ty)) ptr (str->cstr a pname))]
                                    (set! idx (primitive/iadd (load idx) 1))
                                    (set! scp (scope-put a (load scp) pname val pty))))
                      (AAScalar []
                                (let [v (LLVMGetParam function (primitive/cast i32 (load idx)))]
                                  (LLVMSetValueName2 v (str->cstr a pname) (slice-len pname))
                                  (set! idx (primitive/iadd (load idx) 1))
                                  (set! scp (scope-put a (load scp) pname v pty))))))
                  (set! i (primitive/iadd (load i) 1)))))
      (let [body (load (field f body))
            nb (al-len [Expr] (load body))]
        (if (= nb (primitive/cast i64 0))
            (when (not (cg-terminated cg)) (emit-c-return cg sig (field f ret) (mk-tv (cg-zero-i64 cg) (TInt 64 true))))
            (let [(mut j) 0]
              (loop (if (or (>= (load j) (primitive/isub nb 1)) (cg-terminated cg))
                        (break)
                        (do
                          (emit-expr cg (al-elem [Expr] body (load j)) (load scp))
                          (set! j (primitive/iadd (load j) 1)))))
              (when (not (cg-terminated cg))
                (emit-tail cg (al-elem [Expr] body (primitive/isub nb 1)) function sig (field f ret) (load scp))))))))
  0)

; ======================== the module driver (compile_for_dbg, dbg=None) ======
; `triple-override` = a NUL-terminated triple cstr to cross-compile for, or null to
; use the host default.
(defn codegen-module [(a (dyn Allocator))
                      (p (ptr Program))
                      (triple-override (ptr i8))
                      (sanitizer i64)
                      (debug-checks bool)] (-> (ptr i8))
  (let [ctx (LLVMContextCreate)]
    ; init targets so an arbitrary (possibly non-host) triple resolves.
    (LLVMInitializeAArch64TargetInfo)
    (LLVMInitializeAArch64Target)
    (LLVMInitializeAArch64TargetMC)
    (LLVMInitializeX86TargetInfo)
    (LLVMInitializeX86Target)
    (LLVMInitializeX86TargetMC)
    (LLVMInitializeRISCVTargetInfo)
    (LLVMInitializeRISCVTarget)
    (LLVMInitializeRISCVTargetMC)
    (LLVMInitializeWebAssemblyTargetInfo)
    (LLVMInitializeWebAssemblyTarget)
    (LLVMInitializeWebAssemblyTargetMC)
    (let [triple
            (if (!= (primitive/cast i64 triple-override) (primitive/cast i64 0))
                triple-override
                (LLVMGetDefaultTargetTriple))
          targetout (primitive/alloc-stack (ptr i8))
          errout (primitive/alloc-stack (ptr i8))]
      ; LLVMGetTargetFromTriple RETURNS a status and writes an error string; discarding
      ; both left `targetout` garbage and segfaulted LLVMCreateTargetMachine on it, so a
      ; bogus --target crashed the compiler instead of naming the triple. LLVM already
      ; wrote a perfectly good explanation into errout — print it.
      (when (!= (LLVMGetTargetFromTriple triple targetout errout) (primitive/cast i32 0))
        (let [w (stderr)]
          (ps w "error: unsupported --target '")
          (ps w (cstr->slice triple))
          (ps w "': ")
          (ps w (cstr->slice (load errout)))
          (wb w 10)
          (exit 1)
          0))
      (let [tm
              (LLVMCreateTargetMachine (load targetout)
                                       triple
                                       (llvm-cpu triple)
                                       (llvm-cpu-features triple)
                                       2
                                       (llvm-reloc-model triple)
                                       0)
            td (LLVMCreateTargetDataLayout tm)
            dl (LLVMCopyStringRepOfTargetData td)
            module (LLVMModuleCreateWithNameInContext c"coil" ctx)
            builder (LLVMCreateBuilderInContext ctx)
            cgp (primitive/alloc-stack Cg)]
        (LLVMSetTarget module triple)
        (LLVMSetDataLayout module dl)
        (set! (.ctx cgp) ctx)
        (set! (.module cgp) module)
        (set! (.builder cgp) builder)
        (set! (.td cgp) td)
        (set! (.structs cgp) (al-new [CgStruct] a))
        (set! (.sums cgp) (al-new [CgSum] a))
        (set! (.funcs cgp) (al-new [CgFunc] a))
        (set! (.inline_funcs cgp) (hm-new [(slice u8) bool] a (str-keyops)))
        (set! (.rets cgp) (al-new [CgRet] a))
        (set! (.sigs cgp) (al-new [CgSig] a))
        (set! (.statics cgp) (al-new [CgStatic] a))
        (set! (.shims cgp) (al-new [CgShim] a))
        (set! (.globals cgp) 0)
        (set! (.nstatic cgp) 0)
        (set! (.llvm_seq cgp) 0)
        (set! (.loops cgp) (al-new [CgLoop] a))
        (set! (.csigs cgp) (al-new [CSigEntry] a))
        (set! (.reset_func cgp) (primitive/cast (ptr i8) 0))
        (set! (.arch cgp) (arch-from-triple (cstr->slice triple)))
        (set! (.mach_o cgp) (triple-mach-o (cstr->slice triple)))
        (set! (.sanitizer cgp) sanitizer)
        (set! (.debug_checks cgp) debug-checks)
        (set! (.a cgp) a)
        (set! (.layouts cgp) (LayoutDb::new a p "codegen" (if (= (.arch cgp) (primitive/cast i64 3)) 4 8)))
        (let [fs (load (field p funcs))
              fn (al-len [Func] (load fs))
              (mut fi) 0]
          (loop (if (>= (load fi) fn)
                    (break)
                    (do
                      (let [fp (al-elem [Func] fs (load fi))]
                        (when (func-inline-always? fp)
                          (hm-put! [(slice u8) bool] (mut (field cgp inline_funcs)) (load (field fp name)) true)
                          0))
                      (set! fi (primitive/iadd (load fi) 1))))))
        (cg-register-types cgp p)
        (cg-eval-asserts cgp p)
        (cg-declare-externs cgp p)
        (cg-declare-funcs cgp p)
        (cg-emit-bodies cgp p)
        (cg-emit-thunks cgp p)
        module))))

; 0a-0d: two-phase type registration.
(defn cg-register-types [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [ctx (cg-ctx cg)
        ss (load (field p structs))
        ns (al-len [StructDef] (load ss))
        us (load (field p sums))
        nu (al-len [SumDef] (load us))
        (mut i) 0]
    ; 0a. opaque struct names.
    (loop (if (>= (load i) ns)
              (break)
              (do
                (let [sd (al-elem [StructDef] ss (load i))
                      nm (.name sd)
                      ty (LLVMStructCreateNamed ctx (str->cstr (load (field cg a)) nm))
                      cs (primitive/alloc-stack CgStruct)]
                  (set! (.name cs) nm)
                  (set! (.fields cs) (load (field sd fields)))
                  (set! (.ty cs) ty)
                  (set! (.layout cs) (.layout sd))
                  (al-push! (mut (.structs cg)) (load cs)))
                (set! i (primitive/iadd (load i) 1)))))
    ; 0a2. register ALL sum names (opaque) + their variants FIRST, so type sizing
    ;      (sum_words) can size a sum that references a not-yet-bodied sum/struct —
    ;      Sizing comes from the whole-program def maps, independent of build order.
    (set! i 0)
    (loop (if (>= (load i) nu)
              (break)
              (do
                (let [sd (al-elem [SumDef] us (load i))
                      nm (.name sd)
                      ty (LLVMStructCreateNamed ctx (str->cstr (load (field cg a)) nm))
                      cs (primitive/alloc-stack CgSum)]
                  (set! (.name cs) nm)
                  (set! (.variants cs) (load (field sd variants)))
                  (set! (.ty cs) ty)
                  (set! (.vstructs cs)
                        (box! (load (field cg a)) (ArrayList (ptr i8)) (al-new [(ptr i8)] (load (field cg a)))))
                  (al-push! (mut (.sums cg)) (load cs)))
                (set! i (primitive/iadd (load i) 1)))))
    ; 0b. set each sum's body { i32 tag, [words x i64] payload }.
    (set! i 0)
    (loop (if (>= (load i) nu)
              (break)
              (do
                (let [sd (al-elem [SumDef] us (load i))
                      words (cg-sum-words-def cg sd)
                      payload (LLVMArrayType2 (cg-sum-word-ty cg) words)
                      ty
                        (load (field (al-elem [CgSum]
                                              (field cg sums)
                                              (cg-sum-idx cg
                                                          (.name sd)))
                                     ty))
                      (mut bs) (al-new [(ptr i8)] (load (field cg a)))]
                  (al-push! (mut bs) (cg-i32t cg))
                  (al-push! (mut bs) payload)
                  (LLVMStructSetBody ty (carr (load (field cg a)) (load bs)) 2 0))
                (set! i (primitive/iadd (load i) 1)))))
    ; 0c. struct bodies.
    (set! i 0)
    (loop (if (>= (load i) ns)
              (break)
              (do
                (cg-set-struct-body cg (al-elem [StructDef] ss (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    ; LLVM IR has no type-level over-alignment. Once every named body exists,
    ; finalize them in dependency order and append tail padding until LLVM's
    ; by-value size/array stride matches LayoutDb. Allocation sites separately
    ; carry the database alignment via cg-force-align.
    (cg-finalize-struct-layouts! cg p)
    ; 0d. per-variant field structs.
    (set! i 0)
    (loop (if (>= (load i) nu)
              (break)
              (do
                (cg-fill-variant-structs cg (al-elem [SumDef] us (load i)) (load i))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn cg-finalize-struct-layouts! [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [a (load (field cg a))
        ctx (cg-ctx cg)
        ss (load (field p structs))
        n (al-len [StructDef] (load ss))
        (mut done) (al-new [i64] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (al-push! (mut done) 0) (set! i (primitive/iadd (load i) 1)))))
    (let [(mut pass) 0]
      (loop (if (>= (load pass) (primitive/iadd n 1))
                (break)
                (do
                  (let [(mut si) 0]
                    (loop (if (>= (load si) n)
                              (break)
                              (do
                                (when (and (= (al-get [i64] (load done) (load si)) (primitive/cast i64 0))
                                           (struct-ready? (field cg layouts) (load si) (mut done)))
                                  (let [sd (al-elem [StructDef] ss (load si))
                                        sp (al-elem [CgStruct] (field cg structs) (load si))]
                                    (match (load (field sd layout))
                                      (LBits [_ _] 0)
                                      (LExplicit [_ _ _] 0)
                                      (_ (let [fs (load (field sd fields))
                                               nf (al-len [Field] (load fs))
                                               (mut bs) (al-new [(ptr i8)] a)
                                               (mut fi) 0
                                               packed (match (load (field sd layout)) (LPacked [] 1) (_ 0))]
                                           (loop (if (>= (load fi) nf)
                                                     (break)
                                                     (do
                                                       (al-push! (mut bs)
                                                                 (basic-ty cg
                                                                           (field (al-elem [Field]
                                                                                           fs
                                                                                           (load fi))
                                                                                  ty)))
                                                       (store! fi (primitive/iadd (load fi) 1)))))
                                           (LLVMStructSetBody (load (field sp ty))
                                                              (carr a (load bs))
                                                              (primitive/cast i32 nf)
                                                              (primitive/cast i32 packed))
                                           (let [actual
                                                   (LLVMABISizeOfType (load (field cg td))
                                                                      (load (field sp
                                                                                   ty)))
                                                 want
                                                   (load (field (struct-at (field cg
                                                                                  layouts)
                                                                           (load si))
                                                                size))]
                                             (when (> actual want)
                                               (cg-fail "LLVM struct layout exceeds LayoutDb size"))
                                             (when (< actual want)
                                               (do
                                                 (al-push! (mut bs)
                                                           (LLVMArrayType2 (LLVMInt8TypeInContext ctx)
                                                                           (primitive/isub want actual)))
                                                 (LLVMStructSetBody (load (field sp ty))
                                                                    (carr a (load bs))
                                                                    (primitive/cast i32
                                                                                    (al-len [(ptr i8)]
                                                                                            (load bs)))
                                                                    (primitive/cast i32 packed))
                                                 0))))))
                                    (al-set! (mut done) (load si) 1)))
                                (set! si (primitive/iadd (load si) 1))))))
                  (set! pass (primitive/iadd (load pass) 1))))))
    0))
(defn cg-set-struct-body [(cg (ptr Cg)) (sd (ptr StructDef))] (-> i64)
  (let [a (load (field cg a))
        ctx (cg-ctx cg)
        si (cg-struct-idx cg (.name sd))
        sp (al-elem [CgStruct] (field cg structs) si)
        ty (load (field sp ty))
        fs (load (field sd fields))
        nf (al-len [Field] (load fs))]
    (match (.layout sd)
      (LBits [backing offs]
             (let [(mut bs) (al-new [(ptr i8)] a)]
               (al-push! (mut bs) (int-width ctx backing))
               (LLVMStructSetBody ty (carr a (load bs)) 1 0)
               0))
      (LExplicit [offs sz al]
                 (let [(mut computed) 0
                       (mut sizes) (al-new [i64] a)
                       (mut i) 0]
                   ; Gather each field's ABI size, track the minimum total, and — when the
                   ; struct declares an explicit :size — reject any field that spills past it
                   ; (LAYOUT.md's "each field fits within :size"). Same error surface as a
                   ; failed static-assert: a plain `error: …` on stderr + exit(1), no object.
                   (loop (if (>= (load i) nf)
                             (break)
                             (do
                               (let [off (al-get [i64] (load offs) (load i))
                                     fsz
                                       (LLVMABISizeOfType (load (field cg td))
                                                          (basic-ty cg
                                                                    (field (al-elem [Field] fs (load i)) ty)))
                                     end (primitive/iadd off fsz)]
                                 (al-push! (mut sizes) fsz)
                                 (match sz
                                   (Some [s]
                                         (when (> end s)
                                           (cg-fail (sconcat3 a
                                                              "defstruct '"
                                                              (load (field sd name))
                                                              (sconcat3 a
                                                                        "': field '"
                                                                        (load (field (al-elem [Field]
                                                                                              fs
                                                                                              (load i))
                                                                                     name))
                                                                        (sconcat3 a
                                                                                  "' at :at "
                                                                                  (i64->str a off)
                                                                                  (sconcat3 a
                                                                                            " occupies "
                                                                                            (i64->str a fsz)
                                                                                            (sconcat3 a
                                                                                                      " byte(s), past the declared :size "
                                                                                                      (i64->str a
                                                                                                                s)
                                                                                                      ""))))))))
                                   (None [] 0))
                                 (when (> end (load computed)) (store! computed end)))
                               (set! i (primitive/iadd (load i) 1)))))
                   ; Overlap at UNEQUAL :at is an error (equal :at is an intentional union);
                   ; name both colliding fields.
                   (let [(mut p) 0]
                     (loop (if (>= (load p) nf)
                               (break)
                               (do
                                 (let [(mut q) (primitive/iadd (load p) 1)]
                                   (loop (if (>= (load q) nf)
                                             (break)
                                             (do
                                               (let [op (al-get [i64] (load offs) (load p))
                                                     oq (al-get [i64] (load offs) (load q))
                                                     ep
                                                       (primitive/iadd op
                                                                       (al-get [i64] (load sizes) (load p)))
                                                     eq
                                                       (primitive/iadd oq
                                                                       (al-get [i64] (load sizes) (load q)))]
                                                 (when (and (!= op oq)
                                                            (and (< op eq) (< oq ep)))
                                                   (cg-fail (sconcat3 a
                                                                      "defstruct '"
                                                                      (load (field sd name))
                                                                      (sconcat3 a
                                                                                "': fields '"
                                                                                (load (field (al-elem [Field]
                                                                                                      fs
                                                                                                      (load p))
                                                                                             name))
                                                                                (sconcat3 a
                                                                                          "' (:at "
                                                                                          (i64->str a op)
                                                                                          (sconcat3 a
                                                                                                    ") and '"
                                                                                                    (load (field (al-elem [Field]
                                                                                                                          fs
                                                                                                                          (load q))
                                                                                                                 name))
                                                                                                    (sconcat3 a
                                                                                                              "' (:at "
                                                                                                              (i64->str a
                                                                                                                        oq)
                                                                                                              ") overlap at unequal offsets (equal :at = union)"))))))))
                                               (set! q (primitive/iadd (load q) 1))))))
                                 (set! p (primitive/iadd (load p) 1))))))
                   (let [size
                           (match sz
                             (Some [s] (if (> s (load computed)) s (load computed)))
                             (None [] (load computed)))
                         (mut bs) (al-new [(ptr i8)] a)]
                     (al-push! (mut bs) (LLVMArrayType2 (LLVMInt8TypeInContext ctx) size))
                     (LLVMStructSetBody ty (carr a (load bs)) 1 1)
                     0)))
      (_ (let [(mut bs) (al-new [(ptr i8)] a)
               (mut i) 0
               packed (match (.layout sd) (LPacked [] 1) (_ 0))]
           (loop (if (>= (load i) nf)
                     (break)
                     (do
                       (al-push! (mut bs) (basic-ty cg (field (al-elem [Field] fs (load i)) ty)))
                       (set! i (primitive/iadd (load i) 1)))))
           (LLVMStructSetBody ty (carr a (load bs)) (primitive/cast i32 nf) (primitive/cast i32 packed))
           0)))))
(defn cg-fill-variant-structs [(cg (ptr Cg)) (sd (ptr SumDef)) (ui i64)] (-> i64)
  (let [a (load (field cg a))
        ctx (cg-ctx cg)
        sp (al-elem [CgSum] (field cg sums) (cg-sum-idx cg (.name sd)))
        vs (load (field sd variants))
        nv (al-len [Variant] (load vs))
        (mut i) 0]
    (loop (if (>= (load i) nv)
              (break)
              (do
                (let [vp (al-elem [Variant] vs (load i))
                      fs (load (field vp fields))
                      nf (al-len [Field] (load fs))
                      (mut bs) (al-new [(ptr i8)] a)
                      (mut j) 0]
                  (loop (if (>= (load j) nf)
                            (break)
                            (do
                              (al-push! (mut bs) (basic-ty cg (field (al-elem [Field] fs (load j)) ty)))
                              (set! j (primitive/iadd (load j) 1)))))
                  (al-push! (mut (load (field sp vstructs)))
                            (LLVMStructTypeInContext ctx (carr a (load bs)) (primitive/cast i32 nf) 0)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

; 0e: static asserts.
(defn cg-eval-asserts [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [as (load (field p asserts))
        n (al-len [StaticAssert] (load as))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ap (al-elem [StaticAssert] as (load i))]
                  ; Mirror: a failed static-assert is
                  ; `Err("static assertion failed: {msg}")`, which `report`
                  ; renders as `error: static assertion failed: <msg>` and exits nonzero.
                  ; The message is spanless (a plain codegen string error), so it renders
                  ; like any other spanless Diag: bare `error: <msg>`. Codegen has no
                  ; Result channel here, so print the rendered line and exit(1) — the
                  ; observable behavior (stderr text + exit code, no object/link) is
                  ; byte-identical to the front-end returning the Err.
                  (when (= (const-eval cg (field ap cnd)) (primitive/cast i64 0))
                    (let [w (stderr)
                          msg
                            (sconcat (load (field cg a))
                                     "static assertion failed: "
                                     (load (field ap
                                                  msg)))]
                      (ps w "error: ")
                      (ps w msg)
                      (wb w 10)
                      (exit 1)
                      0)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

; helper: store a (name -> Type) into a CgRet list and (name cc params ret) into sigs.
(defn cg-record-callable [(cg (ptr Cg)) (name (slice u8)) (cc (slice u8)) (params (ptr (ArrayList Type))) (ret Type)] (-> i64)
  (let [r (primitive/alloc-stack CgRet)]
    (set! (.name r) name)
    (set! (.ty r) ret)
    (al-push! (mut (.rets cg)) (load r)))
  (let [s (primitive/alloc-stack CgSig)]
    (set! (.name s) name)
    (set! (.cc s) cc)
    (set! (.params s) params)
    (set! (.ret s) ret)
    (al-push! (mut (.sigs cg)) (load s)))
  0)
(defn cg-add-func [(cg (ptr Cg)) (name (slice u8)) (fv (ptr i8))] (-> i64)
  (let [r (primitive/alloc-stack CgFunc)]
    (set! (.name r) name)
    (set! (.val r) fv)
    (al-push! (mut (.funcs cg)) (load r)))
  0)

; `last-component` moved to check.coil (a pure path/string helper used by both
; check and codegen); codegen imports check, so it resolves here unchanged. This
; keeps check.coil free of any codegen (LLVM) dependency so the frontend can be
; built into an LLVM-free (arm64-only) compiler. See src/compiler/main_a64.coil.
(defn ty-list-has-struct [(cg (ptr Cg)) (l (ptr (ArrayList Type)))] (-> bool)
  (let [n (al-len [Type] (load l))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (cg-abi-struct? cg (al-elem [Type] l (load i))) (store! r true) 0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn cg-abi-struct? [(cg (ptr Cg)) (t (ptr Type))] (-> bool)
  (match (load t)
    (TStruct [nm]
             (let [si (cg-struct-idx cg nm)]
               (if (< si (primitive/cast i64 0))
                   false
                   (match (.layout (al-elem [CgStruct] (field cg structs) si))
                     (LBits [b o] false)
                     (_ true)))))
    (_ false)))

; ============================ C-ABI struct classification ====================
; Faithful (AArch64 AAPCS64 path) + the codegen ABI helpers.
; The x86_64 SysV path is a hard-error stub (the self-host targets AArch64).

; arch from a triple's first '-'-separated component.
(defn arch-from-triple [(triple (slice u8))] (-> i64)
  (let [n (slice-len triple)
        (mut i) 0]
    (loop (if (or (>= (load i) n) (= (primitive/cast i64 (slice-get triple (load i))) (primitive/cast i64 45)))
              (break)
              (set! i (primitive/iadd (load i) 1))))
    (let [a0 (substr triple 0 (load i))]
      (cond (or (= a0 "x86_64") (= a0 "amd64")) 0
            (or (= a0 "aarch64") (or (= a0 "arm64") (= a0 "arm64e"))) 1
            (or (= a0 "wasm32") (= a0 "wasm64")) 2
            (= a0 "riscv32") 3
            :else  ; wasm ABI class is width-agnostic; word width comes from the triple's datalayout
              (do (unimplemented "abi: unsupported target architecture") -1)))))

; LLVM subtarget-feature string for a triple's TargetMachine, as a C string for
; LLVMCreateTargetMachine's `Features` arg. wasm64's 64-bit memory is IMPLIED by the
; triple's datalayout (there is no `+memory64` subtarget feature in LLVM), so the only
; wasm feature we opt into is `+tail-call` (Wasm 3.0 tail calls — LLVM lowers `musttail`
; to `return_call`). Everything else takes LLVM's defaults (empty features).
(defn llvm-cpu [(triple (ptr i8))] (-> (ptr i8))
  (let [s (cstr->slice triple)]
    (if (match (str-find s "riscv32") (Some [_] true) (None [] false)) c"generic-rv32" c"generic")))

(defn llvm-cpu-features [(triple (ptr i8))] (-> (ptr i8))
  (let [s (cstr->slice triple)]
    (if (match (str-find s "riscv32") (Some [_] true) (None [] false)) c"+m,+c" c"")))

(defn llvm-reloc-model [(triple (ptr i8))] (-> i32)
  (let [s (cstr->slice triple)]
    (if (match (str-find s "riscv32") (Some [_] true) (None [] false)) 1 2)))

; smallest power-of-two-byte int width (bits) covering `bytes` data bytes.
(defn abi-int-bits-for-bytes [(bytes i64)] (-> i64)
  (cond (<= bytes (primitive/cast i64 1)) 8
        (= bytes (primitive/cast i64 2)) 16
        (<= bytes (primitive/cast i64 4)) 32
        :else 64))

; abi_struct: CgStruct index of a non-bits by-value struct type, else -1.
(defn cg-abi-struct-cs [(cg (ptr Cg)) (t (ptr Type))] (-> i64)
  (match (load t)
    (TStruct [nm]
             (let [si (cg-struct-idx cg nm)]
               (if (< si (primitive/cast i64 0))
                   -1
                   (match (.layout (al-elem [CgStruct] (field cg structs) si))
                     (LBits [b o] -1)
                     (_ si)))))
    (_ -1)))

; resolve_struct: the field list of a named struct (null if not a struct).
(defn cg-resolve-fields [(cg (ptr Cg)) (name (slice u8))] (-> (ptr (ArrayList Field)))
  (let [si (cg-struct-idx cg name)]
    (if (< si (primitive/cast i64 0))
        (primitive/cast (ptr (ArrayList Field)) 0)
        (load (field (al-elem [CgStruct] (field cg structs) si) fields)))))

; ---- HFA detection (faithful; never fires in the corpus = no float-only structs)
(defn abi-hfa-walk-ty [(cg (ptr Cg)) (ty (ptr Type)) (found (ptr (Option Type))) (count (ptr i64))] (-> bool)
  (let [a (load (field cg a))]
    (match (load ty)
      (TFloat [b]
              (let [(mut ok) true]
                (match (load found)
                  (None [] (do (set! found (Some (load ty))) 0))
                  (Some [prev] (unless (type-eq (box-type a prev) ty) (store! ok false) 0)))
                (set! count (primitive/iadd (load count) 1))
                (and (load ok) (<= (load count) (primitive/cast i64 4)))))
      (TArray [elem n]
              (let [(mut ok) true
                    (mut i) 0]
                (loop (if (or (>= (load i) n) (not (load ok)))
                          (break)
                          (do
                            (when (not (abi-hfa-walk-ty cg elem found count)) (store! ok false) 0)
                            (set! i (primitive/iadd (load i) 1)))))
                (load ok)))
      (TStruct [nm]
               (let [fs (cg-resolve-fields cg nm)]
                 (if (= (primitive/cast i64 fs) (primitive/cast i64 0))
                     false
                     (abi-hfa-walk-fields cg fs found count))))
      (_ false))))
(defn abi-hfa-walk-fields [(cg (ptr Cg)) (fields (ptr (ArrayList Field))) (found (ptr (Option Type))) (count (ptr i64))] (-> bool)
  (let [n (al-len [Field] (load fields))
        (mut ok) true
        (mut i) 0]
    (loop (if (or (>= (load i) n) (not (load ok)))
              (break)
              (do
                (when (not (abi-hfa-walk-ty cg (field (al-elem [Field] fields (load i)) ty) found count))
                  (store! ok false)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load ok)))
; returns the HFA member count (0 if not an HFA); writes the FP element type to out-fty.
(defn abi-hfa [(cg (ptr Cg)) (fields (ptr (ArrayList Field))) (out-fty (ptr Type))] (-> i64)
  (let [found (primitive/alloc-stack (Option Type))
        count (primitive/alloc-stack i64)]
    (set! found (None [Type]))
    (set! count 0)
    (unless (not (abi-hfa-walk-fields cg fields found count))
      (match (load found)
        (None [] 0)
        (Some [t]
              (when (and (>= (load count) (primitive/cast i64 1)) (<= (load count) (primitive/cast i64 4)))
                (store! out-fty
                        t)
                (load count)))))))

; a one-element slot list (the AArch64 coercion is always a single slot).
(defn abi-slots1 [(cg (ptr Cg)) (t (ptr i8))] (-> (ptr (ArrayList (ptr i8))))
  (let [a (load (field cg a))
        (mut xs) (al-new [(ptr i8)] a)]
    (al-push! (mut xs) t)
    (box-al [(ptr i8)] a (load xs))))

; ---- SysV AMD64: the byte-class flatten + eightbyte-coercion ----
; SysV "merge" rule for two classes covering the same byte: INTEGER dominates SSE,
; SSE dominates NONE (0=None 1=Integer 2=Sse).
(defn abi-merge [(x i64) (y i64)] (-> i64)
  (if (or (= x (primitive/cast i64 1)) (= y (primitive/cast i64 1)))
      1
      (when (or (= x (primitive/cast i64 2)) (= y (primitive/cast i64 2))) 2)))
(defn abi-align-up [(x i64) (al i64)] (-> i64)
  (if (= al (primitive/cast i64 0)) x (primitive/imul (primitive/udiv (primitive/iadd x (primitive/isub al 1)) al) al)))
; Flatten CgStruct `si`'s fields into scalar leaves at absolute byte offsets,
; recursing into nested structs and arrays. Offsets come from
; the struct's REAL LayoutDb offsets — never LLVM's natural offsets, which cannot
; express Coil's explicit/packed/over-aligned nesting contract.
(defn abi-flatten-cs [(cg (ptr Cg)) (si i64) (base i64) (out (ptr AbiLeafBox))] (-> i64)
  (let [td (load (field cg td))
        sp (al-elem [CgStruct] (field cg structs) si)
        fs (load (field sp fields))
        n (al-len [Field] (load fs))
        (mut i) 0]
    (match (.layout sp)
      (LBits [backing offs]
             ; bits struct: one integer backing word (unreachable via cg-abi-struct-cs,
             ; which reports bits structs as scalars — kept total for direct callers).
             (let [lf (primitive/alloc-stack AbiLeaf)]
               (set! (.offset lf) base)
               (set! (.size lf) (primitive/udiv backing 8))
               (set! (.cls lf) 1)
               (set! (.is_f32 lf) false)
               (al-push! (mut (.items out)) (load lf))
               0))
      (LExplicit [offs sz al]
                 (do
                   (loop (if (>= (load i) n)
                             (break)
                             (do
                               (abi-flatten-type cg
                                                 (field (al-elem [Field] fs (load i)) ty)
                                                 (primitive/iadd base (al-get [i64] (load offs) (load i)))
                                                 out)
                               (set! i (primitive/iadd (load i) 1)))))
                   0))
      (_ (do
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (abi-flatten-type cg
                                         (field (al-elem [Field] fs (load i)) ty)
                                         (primitive/iadd base (field-offset (field cg layouts) si (load i)))
                                         out)
                       (set! i (primitive/iadd (load i) 1)))))
           0)))))
(defn abi-flatten-type [(cg (ptr Cg)) (ty (ptr Type)) (offset i64) (out (ptr AbiLeafBox))] (-> i64)
  (let [a (load (field cg a))
        td (load (field cg td))]
    (match (load ty)
      (TFloat [bits]
              (let [lf (primitive/alloc-stack AbiLeaf)]
                (set! (.offset lf) offset)
                (set! (.size lf) (primitive/udiv bits 8))
                (set! (.cls lf) 2)
                (set! (.is_f32 lf) (= bits (primitive/cast i64 32)))
                (al-push! (mut (.items out)) (load lf))
                0))
      (TArray [elem n]
              (let [esz (LLVMABISizeOfType td (basic-ty cg elem))
                    (mut i) 0]
                (loop (if (>= (load i) n)
                          (break)
                          (do
                            (abi-flatten-type cg
                                              elem
                                              (primitive/iadd offset (primitive/imul (load i) esz))
                                              out)
                            (set! i (primitive/iadd (load i) 1)))))
                0))
      (TStruct [nm]
               (let [si (cg-struct-idx cg nm)]
                 (if (< si (primitive/cast i64 0))
                     (do (unimplemented "SysV ABI: nested type is not a classifiable struct") 0)
                     (abi-flatten-cs cg si offset out))))
      ; Generic/vector types have no supported C representation; the unreachable
      ; ones must NOT fall through to the Integer arm below. A slice is the
      ; ordinary two-word `{data, len}` value and both words classify INTEGER.
      (TVec [el n]
            (do
              (unimplemented "SysV ABI: passing a vec by value across the C boundary is not supported yet")
              0))
      (TSlice [el]
              (let [data (primitive/alloc-stack AbiLeaf)
                    len (primitive/alloc-stack AbiLeaf)]
                (set! (.offset data) offset)
                (set! (.size data) 8)
                (set! (.cls data) 1)
                (set! (.is_f32 data) false)
                (al-push! (mut (.items out)) (load data))
                (set! (.offset len) (primitive/iadd offset 8))
                (set! (.size len) 8)
                (set! (.cls len) 1)
                (set! (.is_f32 len) false)
                (al-push! (mut (.items out)) (load len))
                0))
      (TApp [nm args]
            (do (unimplemented "SysV ABI: generic type survived to ABI classification (compiler bug)") 0))
      (TNever [] (do (unimplemented "SysV ABI: Never type has no ABI representation") 0))
      (TCode [] (do (unimplemented "SysV ABI: Code type has no ABI representation") 0))
      (TExternRef [] (do (unimplemented "SysV ABI: externref has no SysV representation") 0))
      (TVoid [] (do (unimplemented "SysV ABI: void is a return type only; never a field/by-value param") 0))
      ; Int, Bool, Ptr, Ref, Fn -> a single INTEGER leaf.
      (_ (let [lf (primitive/alloc-stack AbiLeaf)]
           (set! (.offset lf) offset)
           (set! (.size lf) (LLVMABISizeOfType td (basic-ty cg ty)))
           (set! (.cls lf) 1)
           (set! (.is_f32 lf) false)
           (al-push! (mut (.items out)) (load lf))
           0)))))
; true if any leaf is a 32-bit float starting exactly at byte `off`.
(defn abi-leaves-has-f32-at [(leaves (ptr (ArrayList AbiLeaf))) (off i64)] (-> bool)
  (let [n (al-len [AbiLeaf] (load leaves))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [lf (al-elem [AbiLeaf] leaves (load i))]
                  (when (and (load (field lf is_f32))
                             (= (load (field lf
                                             offset))
                                off))
                    (store! r
                            true)
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn abi-classify-sysv [(cg (ptr Cg)) (si i64) (sty (ptr i8)) (size i64) (align i32)] (-> (ptr StructAbi))
  (let [a (load (field cg a))
        ctx (cg-ctx cg)
        p (box! a StructAbi (primitive/zeroed StructAbi))]
    (set! (.llvm_ty p) sty)
    (set! (.size p) size)
    (set! (.align p) align)
    ; Structs larger than two eightbytes (16 bytes) are passed in memory.
    (if (> size (primitive/cast i64 16))
        (do (set! (.arg p) (ACIndirect align)) (set! (.ret p) (ACIndirect align)))
        (let [lb (box! a AbiLeafBox (primitive/zeroed AbiLeafBox))]
          (set! (.items lb) (al-new [AbiLeaf] a))
          (abi-flatten-cs cg si 0 lb)
          (let [leaves (field lb items)
                nbytes size
                (mut bytes) (al-new [i64] a)
                (mut bi) 0]
            ; per-byte class array (None), then merge each leaf onto its byte range.
            (loop (if (>= (load bi) nbytes)
                      (break)
                      (do
                        (al-push! (mut bytes) 0)
                        (set! bi (primitive/iadd (load bi) 1)))))
            (let [nleaves (al-len [AbiLeaf] (load leaves))
                  (mut li) 0]
              (loop (if (>= (load li) nleaves)
                        (break)
                        (do
                          (let [lf (al-elem [AbiLeaf] leaves (load li))
                                lo (.offset lf)
                                hi
                                  (primitive/iadd (.offset lf)
                                                  (.size lf))]
                            (when (> hi nbytes) (unimplemented "SysV ABI: scalar runs past struct size") 0)
                            (let [(mut b) lo]
                              (loop (if (>= (load b) hi)
                                        (break)
                                        (do
                                          (al-set! [i64]
                                                   (mut bytes)
                                                   (load b)
                                                   (abi-merge (al-get [i64] (load bytes) (load b))
                                                              (.cls lf)))
                                          (set! b (primitive/iadd (load b) 1)))))))
                          (set! li (primitive/iadd (load li) 1)))))
              ; collapse into eightbyte coerced slots.
              (let [neb (primitive/udiv (primitive/iadd nbytes 7) 8)
                    (mut slots) (al-new [(ptr i8)] a)
                    (mut eb) 0]
                (loop (if (>= (load eb) neb)
                          (break)
                          (do
                            (let [lo (primitive/imul (load eb) 8)
                                  hi
                                    (if (< (primitive/iadd (primitive/imul (load eb) 8) 8) nbytes)
                                        (primitive/iadd (primitive/imul (load eb) 8) 8)
                                        nbytes)
                                  (mut cls) 0
                                  (mut bb) 0]
                              (set! bb lo)
                              (loop (if (>= (load bb) hi)
                                        (break)
                                        (do
                                          (set! cls (abi-merge (load cls) (al-get [i64] (load bytes) (load bb))))
                                          (set! bb (primitive/iadd (load bb) 1)))))
                              (let [used (primitive/isub hi lo)
                                    slot
                                      (if (= (load cls) (primitive/cast i64 2))
                                          ; SSE eightbyte: two distinct low/high 4-byte floats -> <2 x float>;
                                          ; one double (or 5..8 SSE bytes) -> double; a single 4-byte float -> float.
                                          (if (and (= used (primitive/cast i64 8))
                                                   (and (abi-leaves-has-f32-at leaves lo)
                                                        (abi-leaves-has-f32-at leaves (primitive/iadd lo 4))))
                                              (LLVMVectorType (LLVMFloatTypeInContext ctx) 2)
                                              (if (> used (primitive/cast i64 4))
                                                  (LLVMDoubleTypeInContext ctx)
                                                  (LLVMFloatTypeInContext ctx)))
                                          ; INTEGER (or padding-only) eightbyte -> smallest pow2 int covering its data bytes.
                                          (int-width ctx (abi-int-bits-for-bytes used)))]
                                (al-push! (mut slots) slot)))
                            (set! eb (primitive/iadd (load eb) 1)))))
                ; SysV arg and ret coerce to the SAME slots.
                (let [sp (box-al [(ptr i8)] a (load slots))]
                  (set! (.arg p) (ACDirect sp))
                  (set! (.ret p) (ACDirect sp))))))))
    p))

; classify a struct for the C ABI (StructAbi by pointer). Takes the CgStruct INDEX
; so the SysV flatten can honor the struct's real layout (packed/explicit offsets).
(defn abi-classify [(cg (ptr Cg)) (si i64)] (-> (ptr StructAbi))
  (let [sp (al-elem [CgStruct] (field cg structs) si)
        sty (load (field sp ty))
        le (struct-at (field cg layouts) si)
        size (.size le)
        align (primitive/cast i32 (.align le))]
    (cond (= (load (field cg arch)) (primitive/cast i64 1))
            (abi-classify-aapcs64 cg (load (field sp fields)) sty size align)
          (= (load (field cg arch)) (primitive/cast i64 3)) (abi-classify-rv32 cg sty size align)
          :else (abi-classify-sysv cg si sty size align))))

(defn abi-classify-rv32 [(cg (ptr Cg)) (sty (ptr i8)) (size i64) (align i32)] (-> (ptr StructAbi))
  (let [a (load (field cg a))
        p (box! a StructAbi (primitive/zeroed StructAbi))
        i32t (cg-i32t cg)]
    (set! (.llvm_ty p) sty)
    (set! (.size p) size)
    (set! (.align p) align)
    (if (> size (primitive/cast i64 8))
        (do (set! (.arg p) (ACIndirect align)) (set! (.ret p) (ACIndirect align)))
        (let [slots
                (if (<= size (primitive/cast i64 4))
                    (abi-slots1 cg i32t)
                    (abi-slots1 cg (LLVMArrayType2 i32t 2)))]
          (set! (.arg p) (ACDirect slots))
          (set! (.ret p) (ACDirect slots))))
    p))
(defn abi-classify-aapcs64 [(cg (ptr Cg)) (fields (ptr (ArrayList Field))) (sty (ptr i8)) (size i64) (align i32)] (-> (ptr StructAbi))
  (let [a (load (field cg a))
        ctx (cg-ctx cg)
        p (box! a StructAbi (primitive/zeroed StructAbi))
        fty (primitive/alloc-stack Type)
        nhfa (abi-hfa cg fields fty)]
    (set! (.llvm_ty p) sty)
    (set! (.size p) size)
    (set! (.align p) align)
    (if (> nhfa (primitive/cast i64 0))
        (let [elem (basic-ty cg fty)
              arr (LLVMArrayType2 elem nhfa)]
          (set! (.arg p) (ACDirect (abi-slots1 cg arr)))
          (set! (.ret p) (ACDirect (abi-slots1 cg sty))))
        (if (> size (primitive/cast i64 16))
            (do (set! (.arg p) (ACIndirect align)) (set! (.ret p) (ACIndirect align)))
            (do
              (set! (.arg p)
                    (ACDirect (abi-slots1 cg
                                          (if (<= size (primitive/cast i64 8))
                                              (cg-i64t cg)
                                              (LLVMArrayType2 (cg-i64t cg) 2)))))
              (set! (.ret p)
                    (ACDirect (abi-slots1 cg
                                          (if (<= size (primitive/cast i64 8))
                                              (int-width ctx (abi-int-bits-for-bytes size))
                                              (LLVMArrayType2 (cg-i64t cg) 2))))))))
    p))

; the single LLVM type a Direct return coerces to.
(defn abi-direct-return-type [(cg (ptr Cg)) (sa (ptr StructAbi))] (-> (ptr i8))
  (match (.ret sa)
    (ACDirect [slots]
              (let [n (al-len [(ptr i8)] (load slots))]
                (if (= n (primitive/cast i64 1))
                    (al-get [(ptr i8)] (load slots) 0)
                    (if (= n (primitive/cast i64 2))
                        (let [a (load (field cg a))
                              (mut fs) (al-new [(ptr i8)] a)]
                          (al-push! (mut fs) (al-get [(ptr i8)] (load slots) 0))
                          (al-push! (mut fs) (al-get [(ptr i8)] (load slots) 1))
                          (LLVMStructTypeInContext (cg-ctx cg) (carr a (load fs)) 2 0))
                        (do (unimplemented "abi: empty direct return classification") (primitive/cast (ptr i8) 0))))))
    (ACIndirect [al] (do (unimplemented "abi: direct-return-type on an indirect class") (primitive/cast (ptr i8) 0)))))
(defn abi-ret-indirect? [(sa (ptr StructAbi))] (-> bool)
  (match (.ret sa) (ACIndirect [a] true) (_ false)))

; ---- csigs map (only struct-by-value callables) ----
(defn cg-csig [(cg (ptr Cg)) (nm (slice u8))] (-> (ptr CSig))
  (let [n (al-len [CSigEntry] (.csigs cg))
        (mut i) 0
        (mut r) (primitive/cast (ptr CSig) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (al-elem [CSigEntry] (field cg csigs) (load i))]
                  (when (= (load (field ep name)) nm)
                    (store! r
                            (load (field ep
                                         sig)))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn cg-has-csig [(cg (ptr Cg)) (nm (slice u8))] (-> bool)
  (!= (primitive/cast i64 (cg-csig cg nm)) (primitive/cast i64 0)))
(defn cg-add-csig [(cg (ptr Cg)) (nm (slice u8)) (sig (ptr CSig))] (-> i64)
  (let [e (primitive/alloc-stack CSigEntry)]
    (set! (.name e) nm)
    (set! (.sig e) sig)
    (al-push! (mut (.csigs cg)) (load e)))
  0)
(defn cg-argabi [(sig (ptr CSig)) (i i64)] (-> ArgAbiK)
  (let [args (load (field sig args))]
    (if (< i (al-len [ArgAbiK] (load args))) (al-get [ArgAbiK] (load args) i) (AAScalar))))

; ---- SysV register accounting for by-value aggregates -----------------------
; An aggregate that classifies ACDirect is only ACTUALLY passed in registers if
; enough of them are still free at its position in the argument list. SysV says
; that when either of its eightbytes has no register left, the WHOLE aggregate
; goes in memory instead — it does not half-spill. Clang implements exactly this
; (compare `f(F2)` -> `double, double` against
; `f(double x7..., F2)` -> `ptr byval(%F2)`), and getting it wrong is invisible
; until a struct lands after enough scalars to exhaust one register file:
; the callee then reads one eightbyte from the last free register and the other
; from the stack, i.e. from the wrong place.
;
; `slot-is-sse?` reads the class back off the coerced slot type the classifier
; already computed: float/double/vector slots are SSE eightbytes, integer slots
; are INTEGER ones.
(defn slot-is-sse? [(t (ptr i8))] (-> bool)
  (let [k (LLVMGetTypeKind t)]
    (or (= k (primitive/cast i32 2)) (or (= k (primitive/cast i32 3)) (= k (primitive/cast i32 13))))))  ; float / double / vector

; How many INTEGER and SSE registers an ACDirect aggregate would consume.
(defn abi-slot-regs [(slots (ptr (ArrayList (ptr i8)))) (gpp (ptr i64)) (ssep (ptr i64))] (-> i64)
  (let [n (al-len [(ptr i8)] (load slots))
        (mut k) 0]
    (set! gpp 0)
    (set! ssep 0)
    (loop (if (>= (load k) n)
              (break)
              (do
                (if (slot-is-sse? (al-get [(ptr i8)] (load slots) (load k)))
                    (set! ssep (primitive/iadd (load ssep) 1))
                    (set! gpp (primitive/iadd (load gpp) 1)))
                (set! k (primitive/iadd (load k) 1)))))
    0))

; ---- c_signature: the C-ABI realization of a (params -> ret) signature ----
(defn c-signature [(cg (ptr Cg)) (params (ptr (ArrayList Type))) (ret (ptr Type)) (variadic bool)] (-> (ptr CSig))
  (let [a (load (field cg a))
        ctx (cg-ctx cg)
        sig (box! a CSig (primitive/zeroed CSig))
        (mut lp) (al-new [(ptr i8)] a)
        (mut argl) (al-new [ArgAbiK] a)
        (mut rty) (primitive/cast (ptr i8) 0)]  ; null = void return type
    (set! (.sret sig) (primitive/cast (ptr StructAbi) 0))
    (set! (.ret_direct sig) (primitive/cast (ptr StructAbi) 0))
    ; return classification
    (let [rcs (cg-abi-struct-cs cg ret)]
      (if (>= rcs (primitive/cast i64 0))
          (let [sa (abi-classify cg rcs)]
            (if (abi-ret-indirect? sa)
                (do (al-push! (mut lp) (LLVMPointerTypeInContext ctx 0)) (set! (.sret sig) sa) 0)
                (do (set! rty (abi-direct-return-type cg sa)) (set! (.ret_direct sig) sa) 0)))
          (unless (ty-is-void ret) (store! rty (basic-ty cg ret)) 0)))
    ; param classification.
    ; `ngp`/`nsse` track how many argument registers the parameters BEFORE this
    ; one have consumed, because on x86-64 an ACDirect aggregate is demoted to
    ; byval when its eightbytes no longer fit (see abi-slot-regs above). An sret
    ; pointer occupies the first integer register. AArch64 does not have this
    ; rule — its ACDirect coercion is a single slot and the classifier already
    ; accounts for HFA/size — so the demotion is x86-only.
    (let [n (al-len [Type] (load params))
          x86 (= (.arch cg) (primitive/cast i64 0))
          (mut ngp) (if (!= (primitive/cast i64 (load (field sig sret))) (primitive/cast i64 0)) 1 0)
          (mut nsse) 0
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [pty (al-elem [Type] params (load i))
                        pcs (cg-abi-struct-cs cg pty)]
                    (if (>= pcs (primitive/cast i64 0))
                        (let [sa (abi-classify cg pcs)]
                          (match (.arg sa)
                            (ACDirect [slots]
                                      (let [ns (al-len [(ptr i8)] (load slots))
                                            needg (primitive/alloc-stack i64)
                                            needs (primitive/alloc-stack i64)]
                                        (abi-slot-regs slots needg needs)
                                        (if (and x86
                                                 (or (> (primitive/iadd (load ngp) (load needg)) (primitive/cast i64 6))
                                                     (> (primitive/iadd (load nsse) (load needs))
                                                        (primitive/cast i64 8))))
                                            ; no room for BOTH eightbytes: the whole
                                            ; aggregate goes in memory, as byval.
                                            (do
                                              (al-push! (mut lp) (LLVMPointerTypeInContext ctx 0))
                                              (al-push! (mut argl) (AAIndirect sa))
                                              0)
                                            (let [(mut k) 0]
                                              (loop (if (>= (load k) ns)
                                                        (break)
                                                        (do
                                                          (al-push! (mut lp) (al-get [(ptr i8)] (load slots) (load k)))
                                                          (set! k (primitive/iadd (load k) 1)))))
                                              (set! ngp (primitive/iadd (load ngp) (load needg)))
                                              (set! nsse (primitive/iadd (load nsse) (load needs)))
                                              (al-push! (mut argl) (AADirect sa))
                                              0))))
                            (ACIndirect [al]
                                        (do
                                          ; a byval pointer still costs an integer
                                          ; register when one is available
                                          (when (< (load ngp) (primitive/cast i64 6))
                                            (store! ngp
                                                    (primitive/iadd (load ngp) 1))
                                            0)
                                          (al-push! (mut lp) (LLVMPointerTypeInContext ctx 0))
                                          (al-push! (mut argl) (AAIndirect sa))))))
                        (do
                          (if (type-is-float pty)
                              (when (< (load nsse) (primitive/cast i64 8))
                                (store! nsse (primitive/iadd (load nsse) 1))
                                0)
                              (when (< (load ngp) (primitive/cast i64 6)) (store! ngp (primitive/iadd (load ngp) 1)) 0))
                          (al-push! (mut lp) (basic-ty cg pty))
                          (al-push! (mut argl) (AAScalar)))))
                  (set! i (primitive/iadd (load i) 1))))))
    (let [rt (if (= (primitive/cast i64 (load rty)) (primitive/cast i64 0)) (LLVMVoidTypeInContext ctx) (load rty))
          fnty
            (LLVMFunctionType rt
                              (carr a (load lp))
                              (primitive/cast i32 (al-len [(ptr i8)] (load lp)))
                              (when variadic 1))]
      (set! (.args sig) (box-al [ArgAbiK] a (load argl)))
      (set! (.fn_ty sig) fnty)
      sig)))

; ---- attributes ----
(defn cg-enum-attr [(cg (ptr Cg)) (name (slice u8)) (val i64)] (-> (ptr i8))
  (LLVMCreateEnumAttribute (cg-ctx cg)
                           (LLVMGetEnumAttributeKindForName (str->cstr (load (field cg a)) name) (slice-len name))
                           val))

; UBSan is normally inserted by Clang's source-language frontend; LLVM has no
; general `ubsan` IR pass. Coil therefore emits the operation checks it defines
; as invalid directly during lowering. A failing check is self-contained and
; deterministic: report the class, then abort before LLVM evaluates the bad op.
(defn cg-ubsan-fail-if! [(cg (ptr Cg)) (bad (ptr i8)) (message (slice u8))] (-> i64)
  (when (= (load (field cg sanitizer)) (primitive/cast i64 4))
    (let [b (cg-bld cg)
          function (LLVMGetBasicBlockParent (LLVMGetInsertBlock b))
          fail (LLVMAppendBasicBlockInContext (cg-ctx cg) function (cg-gname cg "ubsan.fail." (cg-next-global cg)))
          good (LLVMAppendBasicBlockInContext (cg-ctx cg) function (cg-gname cg "ubsan.ok." (cg-next-global cg)))]
      (LLVMBuildCondBr b bad fail good)
      (LLVMPositionBuilderAtEnd b fail)
      (let [a (load (field cg a))
            full (sconcat a "coil: undefined behavior: " (sconcat a message " (--sanitize=undefined)\n"))
            bytes
              (LLVMConstStringInContext (cg-ctx cg)
                                        (primitive/cast (ptr i8) (slice-data full))
                                        (primitive/cast i32 (slice-len full))
                                        0)
            global
              (LLVMAddGlobal (load (field cg module))
                             (LLVMTypeOf bytes)
                             (cg-gname cg "ubsan.message." (cg-next-global cg)))]
        (LLVMSetInitializer global bytes)
        (LLVMSetGlobalConstant global 1)
        (LLVMSetLinkage global 9)
        (let [(mut wp) (al-new [(ptr i8)] a)]
          (al-push! (mut wp) (LLVMInt32TypeInContext (cg-ctx cg)))
          (al-push! (mut wp) (LLVMPointerTypeInContext (cg-ctx cg) 0))
          (al-push! (mut wp) (cg-i64t cg))
          (let [wty (LLVMFunctionType (cg-i64t cg) (carr a (load wp)) 3 0)
                oldw (LLVMGetNamedFunction (load (field cg module)) c"write")
                wf (if (= (primitive/cast i64 oldw) 0) (LLVMAddFunction (load (field cg module)) c"write" wty) oldw)
                (mut wa) (al-new [(ptr i8)] a)]
            (al-push! (mut wa) (LLVMConstInt (cg-i32t cg) 2 0))
            (al-push! (mut wa) global)
            (al-push! (mut wa) (LLVMConstInt (cg-i64t cg) (slice-len full) 0))
            (LLVMBuildCall2 b wty wf (carr a (load wa)) 3 (cg-bl cg "ubsan.write"))))
        (let [olda (LLVMGetNamedFunction (load (field cg module)) c"abort")
              aty (LLVMFunctionType (cg-i64t cg) (carr a (al-new [(ptr i8)] a)) 0 0)
              af (if (= (primitive/cast i64 olda) 0) (LLVMAddFunction (load (field cg module)) c"abort" aty) olda)]
          (LLVMBuildCall2 b aty af (carr a (al-new [(ptr i8)] a)) 0 (cg-bl cg "ubsan.abort"))
          (LLVMBuildUnreachable b)))
      (LLVMPositionBuilderAtEnd b good)
      0))
  0)

(defn cg-ubsan-overflow-op [(cg (ptr Cg)) (op i64) (l (ptr i8)) (r (ptr i8)) (bits i64)] (-> (ptr i8))
  (let [b (cg-bld cg)
        wide (LLVMIntTypeInContext (cg-ctx cg) (primitive/cast i32 (primitive/imul bits 2)))
        lw (LLVMBuildSExt b l wide (cg-bl cg "ubsan.lwide"))
        rw (LLVMBuildSExt b r wide (cg-bl cg "ubsan.rwide"))
        full
          (cond (= op (primitive/cast i64 0)) (LLVMBuildAdd b lw rw (cg-bl cg "ubsan.add"))
                (= op (primitive/cast i64 1)) (LLVMBuildSub b lw rw (cg-bl cg "ubsan.sub"))
                :else (LLVMBuildMul b lw rw (cg-bl cg "ubsan.mul")))
        narrow-ty (LLVMTypeOf l)
        result (LLVMBuildTrunc b full narrow-ty (cg-bl cg "ubsan.result"))
        restored (LLVMBuildSExt b result wide (cg-bl cg "ubsan.restored"))
        bad (LLVMBuildICmp b 33 full restored (cg-bl cg "ubsan.overflow"))]
    (cg-ubsan-fail-if! cg bad "signed integer overflow")
    result))

; Debug-only guard for pointers consumed by dynamic dispatch. Every checked
; pointer must be non-null and minimally aligned; actual call targets must also
; resolve into a loaded image. Keep this in codegen so disabled builds emit no
; branches, declarations, or data.
(defn cg-validate-pointer! [(cg (ptr Cg))
                            (value (ptr i8))
                            (label (slice u8))
                            (require-image bool)] (-> i64)
  (when (load (field cg debug_checks))
    (let [b (cg-bld cg)
          i64ty (LLVMInt64TypeInContext (cg-ctx cg))
          addr (LLVMBuildPtrToInt b value i64ty (cg-bl cg "indirect.addr"))
          isnull (LLVMBuildICmp b 32 addr (LLVMConstInt i64ty 0 0) (cg-bl cg "indirect.null"))
          odd (LLVMBuildAnd b addr (LLVMConstInt i64ty 1 0) (cg-bl cg "indirect.odd"))
          misaligned (LLVMBuildICmp b 33 odd (LLVMConstInt i64ty 0 0) (cg-bl cg "indirect.misaligned"))
          basic-invalid (LLVMBuildOr b isnull misaligned (cg-bl cg "indirect.basic-invalid"))
          pty (LLVMPointerTypeInContext (cg-ctx cg) 0)
          info (cg-entry-alloca cg (LLVMArrayType2 pty 4) (cg-bl cg "indirect.dl-info"))
          (mut dl-params) (al-new [(ptr i8)] (load (field cg a)))
          _dp0 (al-push! (mut dl-params) pty)
          _dp1 (al-push! (mut dl-params) pty)
          dl-ty
            (LLVMFunctionType (LLVMInt32TypeInContext (cg-ctx cg))
                              (carr (load (field cg a)) (load dl-params))
                              2
                              0)
          found-dl (LLVMGetNamedFunction (load (field cg module)) c"dladdr")
          dl-fn
            (if (= (primitive/cast i64 found-dl) 0)
                (LLVMAddFunction (load (field cg module)) c"dladdr" dl-ty)
                found-dl)
          (mut dl-args) (al-new [(ptr i8)] (load (field cg a)))
          _da0 (al-push! (mut dl-args) value)
          _da1 (al-push! (mut dl-args) info)
          dl-status
            (LLVMBuildCall2 b dl-ty dl-fn (carr (load (field cg a)) (load dl-args)) 2 (cg-bl cg "indirect.dladdr"))
          unresolved
            (LLVMBuildICmp b
                           32
                           dl-status
                           (LLVMConstInt (LLVMInt32TypeInContext (cg-ctx cg)) 0 0)
                           (cg-bl cg "indirect.unresolved"))
          invalid
            (if require-image
                (LLVMBuildOr b basic-invalid unresolved (cg-bl cg "indirect.invalid"))
                basic-invalid)
          function (LLVMGetBasicBlockParent (LLVMGetInsertBlock b))
          bad
            (LLVMAppendBasicBlockInContext (cg-ctx cg)
                                           function
                                           (str->cstr (load (field cg a)) (sconcat (load (field cg a)) label ".bad")))
          good
            (LLVMAppendBasicBlockInContext (cg-ctx cg)
                                           function
                                           (str->cstr (load (field cg a)) (sconcat (load (field cg a)) label ".ok")))]
      (LLVMBuildCondBr b invalid bad good)
      (LLVMPositionBuilderAtEnd b bad)
      (let [a (load (field cg a))
            message (sconcat a "coil: invalid indirect target in " (sconcat a label " (--debug-runtime)\n"))
            bytes
              (LLVMConstStringInContext (cg-ctx cg)
                                        (primitive/cast (ptr i8) (slice-data message))
                                        (primitive/cast i32 (slice-len message))
                                        0)
            global
              (LLVMAddGlobal (load (field cg module))
                             (LLVMTypeOf bytes)
                             (cg-gname cg "indirect.message." (cg-next-global cg)))]
        (LLVMSetInitializer global bytes)
        (LLVMSetGlobalConstant global 1)
        (LLVMSetLinkage global 9)
        (let [(mut write-params) (al-new [(ptr i8)] a)]
          (al-push! (mut write-params) (LLVMInt32TypeInContext (cg-ctx cg)))
          (al-push! (mut write-params) (LLVMPointerTypeInContext (cg-ctx cg) 0))
          (al-push! (mut write-params) i64ty)
          (let [write-ty (LLVMFunctionType i64ty (carr a (load write-params)) 3 0)
                found-write (LLVMGetNamedFunction (load (field cg module)) c"write")
                write-fn
                  (if (= (primitive/cast i64 found-write) 0)
                      (LLVMAddFunction (load (field cg module)) c"write" write-ty)
                      found-write)
                (mut write-args) (al-new [(ptr i8)] a)]
            (al-push! (mut write-args) (LLVMConstInt (LLVMInt32TypeInContext (cg-ctx cg)) 2 0))
            (al-push! (mut write-args) global)
            (al-push! (mut write-args) (LLVMConstInt i64ty (slice-len message) 0))
            (LLVMBuildCall2 b write-ty write-fn (carr a (load write-args)) 3 (cg-bl cg "indirect.report"))))
        (let [existing (LLVMGetNamedFunction (load (field cg module)) c"abort")
              abort-fn
                (if (= (primitive/cast i64 existing) 0)
                    (LLVMAddFunction (load (field cg module))
                                     c"abort"
                                     (LLVMFunctionType i64ty
                                                       (carr (load (field cg a))
                                                             (al-new [(ptr i8)] (load (field cg a))))
                                                       0
                                                       0))
                    existing)]
          (LLVMBuildCall2 b
                          (LLVMGlobalGetValueType abort-fn)
                          abort-fn
                          (carr (load (field cg a)) (al-new [(ptr i8)] (load (field cg a))))
                          0
                          (cg-bl cg "indirect.abort"))
          (LLVMBuildUnreachable b)))
      (LLVMPositionBuilderAtEnd b good)
      0))
  0)
(defn cg-add-function [(cg (ptr Cg)) (name (ptr i8)) (fnty (ptr i8))] (-> (ptr i8))
  (let [f (LLVMAddFunction (load (field cg module)) name fnty)]
    (when (= (load (field cg arch)) (primitive/cast i64 3))
      (LLVMSetSection f
                      (str->cstr (load (field cg a))
                                 (sconcat (load (field cg a)) ".text." (cstr->slice name))))
      0)
    (let [san (.sanitizer cg)]
      (when (= san (primitive/cast i64 1))
        (LLVMAddAttributeAtIndex f (primitive/cast i32 -1) (cg-enum-attr cg "sanitize_address" 0))
        0)
      (when (= san (primitive/cast i64 2))
        (LLVMAddAttributeAtIndex f (primitive/cast i32 -1) (cg-enum-attr cg "sanitize_thread" 0))
        0)
      (when (= san (primitive/cast i64 3))
        (LLVMAddAttributeAtIndex f (primitive/cast i32 -1) (cg-enum-attr cg "sanitize_memory" 0))
        0))
    (when (load (field cg debug_checks))
      ; LLVM inserts and verifies a stack canary in functions whose frames can
      ; expose writable local storage. This catches stack smashing at the frame
      ; that caused it instead of at an unrelated later indirect call.
      (LLVMAddAttributeAtIndex f
                               (primitive/cast i32 -1)
                               (cg-enum-attr cg "sspstrong" 0))
      0)
    f))
(defn cg-type-attr [(cg (ptr Cg)) (name (slice u8)) (ty (ptr i8))] (-> (ptr i8))
  (LLVMCreateTypeAttribute (cg-ctx cg)
                           (LLVMGetEnumAttributeKindForName (str->cstr (load (field cg a)) name) (slice-len name))
                           ty))
(defn cg-attr-at [(cg (ptr Cg)) (target (ptr i8)) (is-call bool) (pidx i64) (attr (ptr i8))] (-> i64)
  (if is-call
      (do (LLVMAddCallSiteAttribute target (primitive/cast i32 (primitive/iadd pidx 1)) attr) 0)
      (do (LLVMAddAttributeAtIndex target (primitive/cast i32 (primitive/iadd pidx 1)) attr) 0)))
; apply a CSig's attrs (sret/align, and x86 byval — never on AArch64) to a function
; declaration (is-call=false) or a call instruction (is-call=true).
(defn cg-apply-csig-attrs [(cg (ptr Cg)) (sig (ptr CSig)) (target (ptr i8)) (is-call bool)] (-> i64)
  (let [(mut idx) 0
        sret-sa (load (field sig sret))]
    (when (!= (primitive/cast i64 sret-sa) (primitive/cast i64 0))
      (cg-attr-at cg
                  target
                  is-call
                  (load idx)
                  (cg-type-attr cg
                                "sret"
                                (load (field sret-sa
                                             llvm_ty))))
      (cg-attr-at cg
                  target
                  is-call
                  (load idx)
                  (cg-enum-attr cg
                                "align"
                                (primitive/cast i64
                                                (load (field sret-sa
                                                             align)))))
      (store! idx (primitive/iadd (load idx) 1)))
    (let [args (load (field sig args))
          n (al-len [ArgAbiK] (load args))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (match (al-get [ArgAbiK] (load args) (load i))
                    (AADirect [sa]
                              (match (.arg sa)
                                (ACDirect [slots]
                                          (set! idx (primitive/iadd (load idx) (al-len [(ptr i8)] (load slots)))))
                                (_ 0)))
                    (AAIndirect [sa]
                                (do
                                  (when (= (load (field cg arch)) (primitive/cast i64 0))
                                    (cg-attr-at cg
                                                target
                                                is-call
                                                (load idx)
                                                (cg-type-attr cg "byval" (load (field sa llvm_ty))))
                                    (cg-attr-at cg
                                                target
                                                is-call
                                                (load idx)
                                                (cg-enum-attr cg
                                                              "align"
                                                              (primitive/cast i64
                                                                              (load (field sa
                                                                                           align))))))
                                  (set! idx (primitive/iadd (load idx) 1))))
                    (AAScalar [] (set! idx (primitive/iadd (load idx) 1))))
                  (set! i (primitive/iadd (load i) 1))))))
    0))

; ---- struct slot / arg pointer / memcpy / gep helpers ----
(defn cg-const-uoff [(cg (ptr Cg)) (n i64)] (-> (ptr i8))
  (LLVMConstInt (cg-i64t cg) n 0))
; the call's value name: empty for a void-returning callee (LLVM never
; name a void call), else `nm` — so named/bare calls match the reference exactly.
(defn cg-call-name [(cg (ptr Cg)) (fnty (ptr i8)) (nm (slice u8))] (-> (ptr i8))
  (if (= (LLVMGetTypeKind (LLVMGetReturnType fnty)) (primitive/cast i32 0)) (cg-bl cg "") (cg-bl cg nm)))
(defn cg-struct-slot [(cg (ptr Cg)) (sa (ptr StructAbi)) (name (slice u8))] (-> (ptr i8))
  (let [p (cg-entry-alloca cg (load (field sa llvm_ty)) (cg-bl cg name))
        al (.align sa)]
    (LLVMSetAlignment p (if (> al (primitive/cast i32 8)) al 8))
    p))
; A spill slot for an aggregate that is about to be read back as whole i64 ABI
; slots. Its size must be rounded UP to a multiple of 8: an ACDirect argument is
; passed by loading one i64 per slot, so a 4-byte struct sitting in an exactly
; 4-byte alloca would have that load reach 4 bytes past the end of the object.
; LLVM treats the out-of-bounds load as poison and folds it, which is how a
; (4x u8) struct arrived at a C callee as 0,0,0,0. The padding bytes are never
; read by the callee — it only looks at the struct's own fields.
(defn cg-struct-slot-padded [(cg (ptr Cg)) (sa (ptr StructAbi)) (name (slice u8))] (-> (ptr i8))
  (let [ctx (cg-ctx cg)
        ty (LLVMArrayType2 (LLVMInt8TypeInContext ctx) (align8 (.size sa)))
        p (cg-entry-alloca cg ty (cg-bl cg name))
        al (.align sa)]
    (LLVMSetAlignment p (if (> al (primitive/cast i32 8)) al 8))
    ; Direct ABI coercion loads every padded slot.  Leaving tail padding
    ; uninitialized makes the load poison, which may also destroy the defined
    ; bytes in a partial final slot (notably byte 9 of a packed struct).
    (let [z (LLVMBuildStore (cg-bld cg) (LLVMConstNull ty) p)]
      (LLVMSetAlignment z 1))
    p))
(defn cg-struct-arg-ptr [(cg (ptr Cg)) (v (ptr i8)) (sa (ptr StructAbi))] (-> (ptr i8))
  (if (= (LLVMGetTypeKind (LLVMTypeOf v)) (primitive/cast i32 12))
      v
      (let [slot (cg-struct-slot-padded cg sa "abi.arg")] (LLVMBuildStore (cg-bld cg) v slot) slot)))
(defn cg-copy-struct [(cg (ptr Cg)) (dst (ptr i8)) (src (ptr i8)) (sa (ptr StructAbi))] (-> i64)
  (LLVMBuildMemCpy (cg-bld cg)
                   dst
                   (.align sa)
                   src
                   (.align sa)
                   (cg-const-uoff cg (.size sa)))
  0)
(defn cg-gep-i8 [(cg (ptr Cg)) (base (ptr i8)) (off i64)] (-> (ptr i8))
  (let [a (load (field cg a))
        (mut ix) (al-new [(ptr i8)] a)]
    (al-push! (mut ix) (cg-const-uoff cg off))
    (LLVMBuildGEP2 (cg-bld cg) (LLVMInt8TypeInContext (cg-ctx cg)) base (carr a (load ix)) 1 (cg-bl cg "abi.eb"))))

; ---- reject by-value slice/vec crossing the C boundary
; reject_view_at_c_abi) ---- Runs eagerly over EVERY extern declaration (before,
; and independent of, per-target struct classification), so it holds on every
; target. A by-value slice or SIMD vec — direct, or nested in a by-value struct
; field / array — has no defined C representation. It is an error naming `<who>`
; rendered as a bare spanless `error: <msg>` + exit 1; codegen here has no Result
; channel, so cg-fail prints and exits — byte-identical stderr + exit code.
(defn cg-reject-view [(cg (ptr Cg)) (t (ptr Type)) (who (slice u8))] (-> i64)
  (let [a (load (field cg a))]
    (match (load t)
      (TSlice [el]
              (cg-fail (sconcat a
                                who
                                ": a slice cannot cross the C ABI by value (it is a Coil view type); for FFI pass a c\"…\"/(ptr i8) and a length")))
      (TVec [el n] (cg-fail (sconcat a who ": a vec cannot cross the C ABI by value; pass a pointer to it")))
      (TStruct [nm]
               (let [si (cg-struct-idx cg nm)]
                 (unless (< si (primitive/cast i64 0))
                   (match (load (field (al-elem [CgStruct] (field cg structs) si) layout))
                     (LBits [b o] 0)
                     (LC []
                         (let [fs
                                 (load (field (al-elem [CgStruct]
                                                       (field cg
                                                              structs)
                                                       si)
                                              fields))
                               n (al-len [Field] (load fs))
                               (mut i) 0]
                           (loop (if (>= (load i) n)
                                     (break)
                                     (do
                                       (cg-reject-view cg
                                                       (field (al-elem [Field] fs (load i)) ty)
                                                       who)
                                       (store! i (primitive/iadd (load i) 1)))))
                           0))
                     (LPacked []
                              (let [fs
                                      (load (field (al-elem [CgStruct]
                                                            (field cg
                                                                   structs)
                                                            si)
                                                   fields))
                                    n (al-len [Field] (load fs))
                                    (mut i) 0]
                                (loop (if (>= (load i) n)
                                          (break)
                                          (do
                                            (cg-reject-view cg
                                                            (field (al-elem [Field] fs (load i))
                                                                   ty)
                                                            who)
                                            (store! i (primitive/iadd (load i) 1)))))
                                0))
                     (LAligned [$g3488]
                               (let [fs
                                       (load (field (al-elem [CgStruct]
                                                             (field cg
                                                                    structs)
                                                             si)
                                                    fields))
                                     n (al-len [Field] (load fs))
                                     (mut i) 0]
                                 (loop (if (>= (load i) n)
                                           (break)
                                           (do
                                             (cg-reject-view cg
                                                             (field (al-elem [Field] fs (load i))
                                                                    ty)
                                                             who)
                                             (store! i (primitive/iadd (load i) 1)))))
                                 0))
                     (LExplicit [$g3489 $g3490 $g3491]
                                (let [fs
                                        (load (field (al-elem [CgStruct]
                                                              (field cg
                                                                     structs)
                                                              si)
                                                     fields))
                                      n (al-len [Field] (load fs))
                                      (mut i) 0]
                                  (loop (if (>= (load i) n)
                                            (break)
                                            (do
                                              (cg-reject-view cg
                                                              (field (al-elem [Field] fs (load i))
                                                                     ty)
                                                              who)
                                              (store! i (primitive/iadd (load i) 1)))))
                                  0))))))
      (TArray [el n] (cg-reject-view cg el who))
      (_ 0))))
(defn cg-check-c-abi-types [(cg (ptr Cg)) (params (ptr (ArrayList Type))) (ret (ptr Type)) (who (slice u8))] (-> i64)
  (cg-reject-view cg ret who)
  (let [n (al-len [Type] (load params))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (cg-reject-view cg (al-elem [Type] params (load i)) who) (set! i (primitive/iadd (load i) 1))))))
  0)

; ---- emit a call through the C struct ABI ----
(defn emit-argtv [(cg (ptr Cg)) (args (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> (ArrayList Tv))
  (let [a (load (field cg a))
        n (al-len [Expr] (load args))
        (mut out) (al-new [Tv] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (emit-expr cg (al-elem [Expr] args (load i)) scp))
                (set! i (primitive/iadd (load i) 1)))))
    (load out)))
; Emit a C-ABI call given the callee VALUE plus its function type and calling
; convention explicitly. A direct extern derives both from the global (emit-c-call
; below); an indirect `call-ptr` has neither — a raw function-pointer value has no
; global value type and no function callconv — so it passes the CSig's own fn_ty
; and the C convention id. Everything else here (classification, sret slot, byval
; copies, ACDirect slot loads, csig attrs) is shared verbatim.
; `label` names the call's SSA value. It is threaded through rather than fixed so
; an indirect call keeps its historic "callptr" name: a `c` fnptr whose args need
; no struct lowering emits exactly the instruction it always did, and the IR gate
; stays sensitive to real changes instead of drowning in a rename.
(defn emit-c-call-ty [(cg (ptr Cg))
                      (callee (ptr i8))
                      (fnty (ptr i8))
                      (ccid i32)
                      (sig (ptr CSig))
                      (argtv (ArrayList Tv))
                      (ret-ty Type)
                      (label (slice u8))] (-> Tv)
  (let [a (load (field cg a))
        b (cg-bld cg)
        ctx (cg-ctx cg)
        (mut meta) (al-new [(ptr i8)] a)
        sret-sa (load (field sig sret))
        (mut sret-slot) (primitive/cast (ptr i8) 0)
        nargs (al-len [Tv] argtv)
        nfixed (al-len [ArgAbiK] (load (field sig args)))]
    (when (!= (primitive/cast i64 sret-sa) (primitive/cast i64 0))
      (let [s (cg-struct-slot cg sret-sa "abi.sret")] (store! sret-slot s) (al-push! (mut meta) s)))
    (let [(mut i) 0]
      (loop (if (>= (load i) nfixed)
                (break)
                (do
                  (let [aa (al-get [ArgAbiK] (load (field sig args)) (load i))
                        tv (al-get [Tv] argtv (load i))
                        v (tv-val tv)]
                    (match aa
                      (AAScalar [] (al-push! (mut meta) v))
                      (AAIndirect [sa]
                                  (let [src (cg-struct-arg-ptr cg v sa)
                                        copy (cg-struct-slot cg sa "abi.byval")]
                                    (cg-copy-struct cg copy src sa)
                                    (al-push! (mut meta) copy)))
                      (AADirect [sa]
                                (let [src (cg-struct-arg-ptr cg v sa)]
                                  (match (.arg sa)
                                    (ACDirect [slots]
                                              (let [ns (al-len [(ptr i8)] (load slots))
                                                    (mut k) 0]
                                                (loop (if (>= (load k) ns)
                                                          (break)
                                                          (do
                                                            (let [slot-ty (al-get [(ptr i8)] (load slots) (load k))
                                                                  off (primitive/imul (load k) 8)
                                                                  gep
                                                                    (if (= off (primitive/cast i64 0))
                                                                        src
                                                                        (cg-gep-i8 cg src off))]
                                                              (al-push! (mut meta)
                                                                        (LLVMBuildLoad2 b
                                                                                        slot-ty
                                                                                        gep
                                                                                        (cg-bl cg "abi.slot"))))
                                                            (set! k (primitive/iadd (load k) 1)))))
                                                0))
                                    (ACIndirect [al] (do (unimplemented "abi: Direct arg has a Direct class") 0)))))))
                  (set! i (primitive/iadd (load i) 1))))))
    (let [(mut i) nfixed]
      (loop (if (>= (load i) nargs)
                (break)
                (do
                  (let [tv (al-get [Tv] argtv (load i))
                        v (tv-val tv)]
                    (if (and (>= (cg-abi-struct-cs cg (box-type a (tv-ty tv))) (primitive/cast i64 0))
                             (!= (LLVMGetTypeKind (LLVMTypeOf v)) (primitive/cast i32 12)))
                        (do
                          (unimplemented "codegen: passing a struct by value in a variadic argument is not supported")
                          0)
                        (al-push! (mut meta) v)))
                  (set! i (primitive/iadd (load i) 1))))))
    (let [cs
            (LLVMBuildCall2 b
                            fnty
                            callee
                            (carr a (load meta))
                            (primitive/cast i32 (al-len [(ptr i8)] (load meta)))
                            (cg-call-name cg fnty label))]
      (LLVMSetInstructionCallConv cs ccid)
      (cg-apply-csig-attrs cg sig cs true)
      (if (!= (primitive/cast i64 sret-sa) (primitive/cast i64 0))
          (mk-tv (LLVMBuildLoad2 b (load (field sret-sa llvm_ty)) (load sret-slot) (cg-bl cg "abi.ret")) ret-ty)
          (let [rd (load (field sig ret_direct))]
            (if (!= (primitive/cast i64 rd) (primitive/cast i64 0))
                (let [slot (cg-struct-slot-padded cg rd "abi.ret")]
                  (LLVMBuildStore b cs slot)
                  (mk-tv (LLVMBuildLoad2 b (load (field rd llvm_ty)) slot (cg-bl cg "abi.ret.val")) ret-ty))
                (if (ty-is-void (box-type a ret-ty)) (mk-tv (cg-zero-i64 cg) (TVoid)) (mk-tv cs ret-ty))))))))

; a DIRECT call to a named C function: the global carries both its type and its cc.
(defn emit-c-call [(cg (ptr Cg)) (callee (ptr i8)) (sig (ptr CSig)) (argtv (ArrayList Tv)) (ret-ty Type)] (-> Tv)
  (emit-c-call-ty cg
                  callee
                  (LLVMGlobalGetValueType callee)
                  (LLVMGetFunctionCallConv callee)
                  sig
                  argtv
                  ret-ty
                  "ccall"))

; Two `(extern …)` declarations that resolve to the same C symbol must agree on
; their LLVM function type. A module holds ONE function per symbol, so the second
; declaration is dropped and its calls are built with the second signature against
; the first declaration's type. On arm64 that mismatch is invisible (i32 and i64
; args share a register); on wasm32 the param types are distinct, so it emits an
; import whose signature contradicts its call sites and the module fails to
; validate ("type mismatch: expected i64, found i32"). Reject it at declaration:
; the mismatch is a real conflict either way, the wasm backend just can't hide it.
;
; The conflict is usually with a declaration the program never wrote itself (the
; prelude declares read/write/strlen/memcpy), so name the earlier extern. Scanning
; for it is O(n) over the externs already walked, but only on the fatal path.
(defn cg-extern-prior-decl [(p (ptr Program)) (csym (slice u8)) (upto i64)] (-> (slice u8))
  (let [es (load (field p externs))
        (mut i) 0
        (mut r) ""]
    (loop (if (>= (load i) upto)
              (break)
              (do
                (let [nm (.name (al-elem [Extern] es (load i)))]
                  (when (= (last-component nm) csym) (store! r nm) (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn cg-extern-redecl-check [(cg (ptr Cg))
                              (existing (ptr i8))
                              (fnty (ptr i8))
                              (prior (slice u8))
                              (ename (slice u8))
                              (csym (slice u8))] (-> i64)
  (let [a (load (field cg a))
        have (LLVMGlobalGetValueType existing)]
    (unless (= (primitive/cast i64 have) (primitive/cast i64 fnty))
      (cg-fail (sconcat3 a
                         (sconcat3 a "C symbol '" csym "' is declared twice with different signatures: ")
                         (sconcat3 a
                                   (if (> (slice-len prior) (primitive/cast i64 0))
                                       (sconcat3 a "'" prior "'")
                                       "an earlier declaration")
                                   " is "
                                   (cstr->slice (LLVMPrintTypeToString have)))
                         (sconcat3 a
                                   (sconcat3 a ", '" ename "' is ")
                                   (cstr->slice (LLVMPrintTypeToString fnty))
                                   ". One C symbol, one signature: fix the types to match, or use a different symbol"))))))

; 1a: declare externs.
(defn cg-declare-externs [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [a (load (field cg a))
        es (load (field p externs))
        n (al-len [Extern] (load es))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (al-elem [Extern] es (load i))
                      ename (.name ep)
                      params (load (field ep params))
                      ret (.ret ep)
                      csym (last-component ename)
                      ; the extern's convention -> its native LLVM calling-convention id
                      ; (externs are always native; a :shim extern is rejected in check).
                      conv (cg-prog-conv p (.cc ep))
                      cc-id (when (!= (primitive/cast i64 conv) (primitive/cast i64 0)) (conv-native-id conv))]
                  ; Eager C-ABI view check for EVERY extern
                  ; before — and regardless of — the struct-by-value branch below. A bare
                  ; `(slice u8)`/`(vec …)` param isn't a struct, so the struct branch
                  ; alone would wave it through; this catches it at declaration.
                  (cg-check-c-abi-types cg params (box-type a ret) (sconcat3 a "extern '" ename "'"))
                  (if (or (cg-abi-struct? cg (box-type a ret)) (ty-list-has-struct cg params))
                      (let [sig (c-signature cg params (box-type a ret) (.variadic ep))
                            existing (LLVMGetNamedFunction (load (field cg module)) (str->cstr a csym))
                            fv
                              (if (!= (primitive/cast i64 existing) (primitive/cast i64 0))
                                  (do
                                    (cg-extern-redecl-check cg
                                                            existing
                                                            (load (field sig fn_ty))
                                                            (cg-extern-prior-decl p csym (load i))
                                                            ename
                                                            csym)
                                    existing)
                                  (let [nf
                                          (cg-add-function cg
                                                           (str->cstr a csym)
                                                           (load (field sig fn_ty)))]
                                    (cg-apply-csig-attrs cg sig nf false)
                                    (LLVMSetFunctionCallConv nf (primitive/cast i32 cc-id))
                                    nf))]
                        (when (not (cg-has-csig cg ename)) (cg-add-csig cg ename sig))
                        (cg-add-func cg ename fv)
                        (cg-record-callable cg ename (.cc ep) params ret))
                      (let [existing (LLVMGetNamedFunction (load (field cg module)) (str->cstr a csym))
                            fnty (cg-fn-type-v cg params (box-type a ret) (.variadic ep))
                            fv
                              (if (!= (primitive/cast i64 existing) (primitive/cast i64 0))
                                  (do
                                    (cg-extern-redecl-check cg
                                                            existing
                                                            fnty
                                                            (cg-extern-prior-decl p csym (load i))
                                                            ename
                                                            csym)
                                    existing)
                                  (let [nf (cg-add-function cg (str->cstr a csym) fnty)]
                                    (LLVMSetFunctionCallConv nf (primitive/cast i32 cc-id))
                                    nf))]
                        (cg-add-func cg ename fv)
                        (cg-record-callable cg ename (.cc ep) params ret))))
                (set! i (primitive/iadd (load i) 1)))))
    0))

; 1b: declare functions (native path only; no shims/exports in corpus).
(defn cg-has-anchor [(p (ptr Program))] (-> bool)
  (let [fs (load (field p funcs))
        n (al-len [Func] (load fs))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [Func] fs (load i)) name)) "main")
                  (store! r
                          true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (or (load r) (> (al-len [ExportC] (load (field p exports))) (primitive/cast i64 0)))))
; find the ExportC for a function name (null if not exported).
(defn cg-export-find [(p (ptr Program)) (name (slice u8))] (-> (ptr ExportC))
  (let [es (load (field p exports))
        n (al-len [ExportC] (load es))
        (mut i) 0
        (mut r) (primitive/cast (ptr ExportC) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load (field (al-elem [ExportC] es (load i)) name)) name)
                  (store! r (al-elem [ExportC] es (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
; an export takes a struct BY VALUE (a TStruct param) -> it needs a C-ABI thunk (the
; internal function is reference-model, taking the struct by pointer).
(defn cg-export-needs-thunk [(e (ptr ExportC))] (-> bool)
  (let [ps (load (field e params))
        n (al-len [Type] (load ps))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (type-tag (al-elem [Type] ps (load i))) (primitive/cast i64 6)) (store! r true) (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))
(defn cg-declare-funcs [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [a (load (field cg a))
        fs (load (field p funcs))
        n (al-len [Func] (load fs))
        anchor (cg-has-anchor p)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] fs (load i))
                      fname (.name fp)
                      conv (cg-prog-conv p (.cc fp))
                      reset-cc (and (!= (primitive/cast i64 conv) (primitive/cast i64 0)) (conv-is-reset conv))
                      fparams (cg-param-types cg (load (field fp params)))
                      ret (.ret fp)
                      exp (cg-export-find p fname)
                      ; a thunk-FREE C export is emitted directly under its C symbol; everything
                      ; else (incl. a thunk-needing export's internal function) under its Coil name.
                      direct-sym
                        (if (and (!= (primitive/cast i64 exp) (primitive/cast i64 0)) (not (cg-export-needs-thunk exp)))
                            (.symbol exp)
                            (None [(slice u8)]))
                      llvm-name (if reset-cc "_start" (match direct-sym (Some [sm] sm) (None [] fname)))
                      external
                        (or reset-cc
                            (or (= fname "main")
                                (or (match direct-sym (Some [sm2] true) (None [] false)) (not anchor))))]
                  (cg-record-callable cg fname (.cc fp) fparams ret)
                  (if (and (!= (primitive/cast i64 conv) (primitive/cast i64 0)) (conv-is-shim conv))
                      ; :shim lowering -> a `ccc` __impl carrying the body + a `naked` void
                      ; trampoline under the Coil name.
                      (let [ret-reg
                              (match (.ret conv)
                                (Some [r] r)
                                (None []
                                      (do
                                        (unimplemented (sconcat3 a
                                                                 "shim convention '"
                                                                 (.cc fp)
                                                                 "' needs a :ret register"))
                                        "")))
                            fnty (cg-fn-type cg fparams (box-type a ret))
                            impl-fn (cg-add-function cg (str->cstr a (sconcat a fname "__impl")) fnty)
                            void-ty
                              (LLVMFunctionType (LLVMVoidTypeInContext (cg-ctx cg)) (carr a (al-new [(ptr i8)] a)) 0 0)
                            tramp (cg-add-function cg (str->cstr a fname) void-ty)]
                        (LLVMAddAttributeAtIndex tramp (primitive/cast i32 -1) (cg-enum-attr cg "naked" 0))
                        (LLVMAddAttributeAtIndex tramp (primitive/cast i32 -1) (cg-enum-attr cg "noinline" 0))
                        (cg-add-func cg fname tramp)
                        (cg-add-shim cg
                                     fname
                                     impl-fn
                                     (load (field conv params))
                                     ret-reg
                                     (load (field conv
                                                  clobber))))
                      (let [cc-id (when (!= (primitive/cast i64 conv) (primitive/cast i64 0)) (conv-native-id conv))]
                        (if (or (cg-abi-struct? cg (box-type a ret)) (ty-list-has-struct cg fparams))
                            (let [sig (c-signature cg fparams (box-type a ret) false)
                                  fv
                                    (cg-add-function cg
                                                     (str->cstr a llvm-name)
                                                     (load (field sig fn_ty)))]
                              (LLVMSetFunctionCallConv fv (primitive/cast i32 cc-id))
                              (when reset-cc
                                (LLVMSetSection fv c".text.entry")
                                (store! (field cg reset_func) fv)
                                (LLVMAddAttributeAtIndex fv (primitive/cast i32 -1) (cg-enum-attr cg "noinline" 0))
                                0)
                              (cg-apply-csig-attrs cg sig fv false)
                              (cg-add-csig cg fname sig)
                              (when (not external) (LLVMSetLinkage fv 8) 0)
                              (cg-add-func cg fname fv))
                            (let [fnty (cg-fn-type cg fparams (box-type a ret))
                                  fv (cg-add-function cg (str->cstr a llvm-name) fnty)]
                              (LLVMSetFunctionCallConv fv (primitive/cast i32 cc-id))
                              (when reset-cc
                                (LLVMSetSection fv c".text.entry")
                                (store! (field cg reset_func) fv)
                                (LLVMAddAttributeAtIndex fv (primitive/cast i32 -1) (cg-enum-attr cg "noinline" 0))
                                0)
                              (when (not external) (LLVMSetLinkage fv 8) 0)
                              (cg-add-func cg fname fv))))))
                (set! i (primitive/iadd (load i) 1)))))
    0))
; 2b: C-ABI export THUNKS. For each export that
; takes a struct by value, emit the external C-symbol function that marshals the C ABI
; into the reference-model (pointer) args the internal function takes, then calls it.
(defn cg-emit-export-thunk [(cg (ptr Cg))
                            (c-symbol (slice u8))
                            (internal-name (slice u8))
                            (internal (ptr i8))
                            (params (ptr (ArrayList Type)))
                            (ret (ptr Type))] (-> i64)
  (let [a (load (field cg a))
        b (cg-bld cg)
        sig (c-signature cg params ret false)
        thunk (cg-add-function cg (str->cstr a c-symbol) (load (field sig fn_ty)))]
    (LLVMSetFunctionCallConv thunk 0)
    (cg-apply-csig-attrs cg sig thunk false)
    (let [entry (cg-append cg thunk (cg-bl cg "entry"))]
      (cg-pos cg entry)
      (let [(mut meta) (al-new [(ptr i8)] a)
            sret-sa (load (field sig sret))
            (mut idx) 0]
        (when (!= (primitive/cast i64 sret-sa) (primitive/cast i64 0))
          (al-push! (mut meta) (LLVMGetParam thunk 0))
          (store! idx
                  1))
        (let [args (load (field sig args))
              n (al-len [ArgAbiK] (load args))
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (match (al-get [ArgAbiK] (load args) (load i))
                        (AAScalar []
                                  (do
                                    (al-push! (mut meta) (LLVMGetParam thunk (primitive/cast i32 (load idx))))
                                    (set! idx (primitive/iadd (load idx) 1))))
                        (AADirect [sa]
                                  ; padded for the same reason the call side is: the loop below
                                  ; STORES one whole i64 per ABI slot, so a 4-byte struct in a
                                  ; 4-byte alloca would be written 4 bytes past its end. LLVM
                                  ; folded that to poison and the argument reached the callee as
                                  ; zero — with `mov x0, xzr` right there in the disassembly.
                                  (let [slot (cg-struct-slot-padded cg sa "thunk.arg")]
                                    (match (.arg sa)
                                      (ACDirect [slots]
                                                (let [ns (al-len [(ptr i8)] (load slots))
                                                      (mut k) 0]
                                                  (loop (if (>= (load k) ns)
                                                            (break)
                                                            (do
                                                              (let [v
                                                                      (LLVMGetParam thunk
                                                                                    (primitive/cast i32
                                                                                                    (load idx)))
                                                                    off (primitive/imul (load k) 8)
                                                                    gep
                                                                      (if (= off (primitive/cast i64 0))
                                                                          slot
                                                                          (cg-gep-i8 cg slot off))]
                                                                (LLVMBuildStore b v gep)
                                                                (set! idx (primitive/iadd (load idx) 1)))
                                                              (set! k (primitive/iadd (load k) 1)))))
                                                  0))
                                      (_ 0))
                                    (al-push! (mut meta) slot)))
                        (AAIndirect [sa]
                                    (do
                                      (al-push! (mut meta) (LLVMGetParam thunk (primitive/cast i32 (load idx))))
                                      (set! idx (primitive/iadd (load idx) 1)))))
                      (set! i (primitive/iadd (load i) 1)))))
          (let [cs
                  (LLVMBuildCall2 b
                                  (LLVMGlobalGetValueType internal)
                                  internal
                                  (carr a (load meta))
                                  (primitive/cast i32 (al-len [(ptr i8)] (load meta)))
                                  (cg-call-name cg (LLVMGlobalGetValueType internal) "thunk.call"))]
            (LLVMSetInstructionCallConv cs (LLVMGetFunctionCallConv internal))
            (when (cg-has-csig cg internal-name) (cg-apply-csig-attrs cg (cg-csig cg internal-name) cs true))
            (if (or (!= (primitive/cast i64 sret-sa) (primitive/cast i64 0)) (ty-is-void ret))
                (do (LLVMBuildRetVoid b) 0)
                (do (LLVMBuildRet b cs) 0)))))
      0)))
(defn cg-emit-thunks [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [a (load (field cg a))
        es (load (field p exports))
        n (al-len [ExportC] (load es))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (al-elem [ExportC] es (load i))]
                  (when (cg-export-needs-thunk ep)
                    (let [sym (match (load (field ep symbol)) (Some [s] s) (None [] ""))
                          internal (cg-func cg (load (field ep name)))
                          ret
                            (match (cg-ret cg (load (field ep name)))
                              (Some [t] (box-type a t))
                              (None [] (box-type a (TVoid))))]
                      (cg-emit-export-thunk cg
                                            sym
                                            (load (field ep name))
                                            internal
                                            (load (field ep
                                                         params))
                                            ret))))
                (set! i (primitive/iadd (load i) 1)))))
    0))
(defn cg-param-types [(cg (ptr Cg)) (params (ptr (ArrayList Param)))] (-> (ptr (ArrayList Type)))
  (let [a (load (field cg a))
        n (al-len [Param] (load params))
        (mut out) (al-new [Type] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (al-push! (mut out) (.ty (al-elem [Param] params (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

; 2: emit bodies.
(defn cg-emit-bodies [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [fs (load (field p funcs))
        n (al-len [Func] (load fs))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (al-elem [Func] fs (load i))
                      fname (.name fp)
                      shim (cg-shim-find cg fname)]
                  ; a :shim function's body goes into the `ccc` __impl; then emit the
                  ; naked trampoline into the Coil-named function.
                  (if (!= (primitive/cast i64 shim) (primitive/cast i64 0))
                      (do
                        (emit-func cg fp (load (field shim impl_fn)))
                        (cg-emit-trampoline cg (cg-func cg fname) shim (al-len [Param] (load (field fp params)))))
                      (emit-func cg fp (cg-func cg fname))))
                (set! i (primitive/iadd (load i) 1)))))
    0))

; ===== Port of — cancels codegen's run-to-run nondeterminism
; so the self-host's LLVMPrintModuleToString text matches the normalized reference.
; Faithful, function-for-function port. Families: 0=g 1=str 2=cstr 3=llvmir.
; Categories: 0=type 1=global 2=declare 3=define 4=misc.
