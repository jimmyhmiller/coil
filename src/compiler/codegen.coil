; src/compiler/codegen.coil — self-host Coil compiler, codegen module.
(module coil.compiler.codegen)
(import "coil.primitive" :as primitive)
(import "coil.scratch" :as scratch)
(import "coil.compiler.retained_heap" :as retained-heap)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.mem" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.ffi" :use *)
(import "coil.reader" :use *)
(import "coil.cc" :as cc)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.astdump" :use *)
(import "coil.compiler.check" :use *)
(import "coil.compiler.comptime" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.diag" :use [report-backend-diag])
(import "coil.compiler.normalize" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.resolve" :use *)
(import "coil.compiler.layoutdb" :use *)
(import "coil.compiler.vector" :use *)
(import "coil.compiler.float_math" :use [f64-bits->f32-bits])

(defstruct Tv [(val (ptr i8)) (ty Type)])

(defn mk-tv [(v (ptr i8)) (t Type)] (-> Tv)
  (Tv :val v :ty t))

(defn tv-val [(t Tv)] (-> (ptr i8))
  (let [p (primitive/alloc-stack Tv)] (set! p t) (load (field p val))))

(defn tv-ty [(t Tv)] (-> Type)
  (let [(mut p) (: t Tv)] (.ty p)))

; ---- scope: a persistent cons-list (HashMap<String,Tv> with clone+insert = cons,
;      lookup = linear-from-head so a later binding shadows an earlier one).
(defsum Scope
  (SNil [])
  (SBind [(name (slice u8)) (val (ptr i8)) (ty Type) (rest (ptr Scope))]))

(defn scope-nil [(a (dyn Allocator))] (-> (ptr Scope))
  (box! a Scope (SNil)))

(defn scope-put [(a (dyn Allocator))
                 (s (ptr Scope))
                 (name (slice u8))
                 (v (ptr i8))
                 (t Type)] (-> (ptr Scope))
  (box! a
        Scope
        (SBind
          :name name
          :val v
          :ty t
          :rest s)))

(defn scope-get [(s (ptr Scope)) (name (slice u8))] (-> (Option Tv))
  (match (load s)
    (SNil [] (None [Tv]))
    (SBind [n v t rest]
           (if (= n name) (Some [Tv] (mk-tv v t)) (scope-get rest name)))))

; ---- C-ABI struct-by-value classification (StructAbi/Class + the codegen
;      ArgAbi/CSig). AArch64 AAPCS64 only (the self-host target); the SysV path is
;      a hard-error stub (never reached). StructAbi/CSig are always handled BY
;      POINTER (never threaded by value), Option = a null (ptr …).
(defsum AbiClass
  ; Passed/returned directly in register slots, coerced to these LLVM types.
  (ACDirect [(slots (ptr (ArrayList (ptr i8))))])
  ; Passed indirectly (pointer to a copy / sret). `align` = the struct's ABI align.
  (ACIndirect [(align i32)]))

(defstruct StructAbi
  [(arg AbiClass) (ret AbiClass) (llvm_ty (ptr i8)) (size i64) (align i32)])

(defsum ArgAbiK
  (AAScalar [])
  (AADirect [(sa (ptr StructAbi))])
  (AAIndirect [(sa (ptr StructAbi))]))

(defstruct CSig
  [(sret (ptr StructAbi))  ; null = scalar/direct return
   (ret_direct (ptr StructAbi))  ; null = scalar/sret/void return
   (args (ptr (ArrayList ArgAbiK)))
   (fn_ty (ptr i8))
   ; x86-64 integer and SSE argument registers the fixed parameters use: where
   ; a call's variadic arguments start
   (gp_used i64)
   (sse_used i64)])

(defstruct CSigEntry [(name (slice u8)) (sig (ptr CSig))])

; One scalar leaf of a (possibly nested) struct, for the SysV field-walk
; Leaf): its absolute byte offset, byte size, SysV class (0=None 1=Integer 2=Sse),
; and whether the leaf is a 32-bit float. `AbiLeafBox` wraps the accumulator list so
; it can be threaded by pointer (the established self-host push-through-pointer idiom).
(defstruct AbiLeaf [(offset i64) (size i64) (cls i64) (is_f32 bool)])

(defstruct AbiLeafBox [(items (ArrayList AbiLeaf))])

; ---- Cg: codegen state. Maps are
;      ArrayLists keyed by name (the established self-host pattern; mono uses it).
(defstruct CgStruct
  [(name (slice u8))
   (fields (ptr (ArrayList Field)))
   (ty (ptr i8))
   (layout Layout)])

(defstruct CgSum
  [(name (slice u8))
   (variants (ptr (ArrayList Variant)))
   (ty (ptr i8))
   (vstructs (ptr (ArrayList (ptr i8))))])

;;; `fnty` is 0 for an ordinary function, whose LLVM value type is its own. An extern
;;; whose C symbol another module declared with a different (ABI-compatible)
;;; signature shares that symbol's one LLVM function but keeps its own declared
;;; type here: each call site is built against the type its module wrote, the way
;;; separate C translation units each carry their own prototype.
(defstruct CgFunc [(name (slice u8)) (val (ptr i8)) (fnty (ptr i8))])

(defstruct CgRet [(name (slice u8)) (ty Type)])

(defstruct CgSig
  [(name (slice u8)) (cc (slice u8)) (params (ptr (ArrayList Type))) (ret Type)])

(defstruct CgBreak [(val (ptr i8)) (bb (ptr i8))])

(defstruct CgLoop
  [(label (Option (slice u8)))
   (body_bb (ptr i8))
   (after_bb (ptr i8))
   (breaks (ArrayList CgBreak))
   (break_ty (Option Type))])

(defstruct CgStatic [(name (slice u8)) (ptr (ptr i8)) (ty Type)])

;; A pointer the current function builds aggregates in, and the alignment it is
;; known to have: a destination stood in for a stack slot (see emit-let-into).
(defstruct CgAlign [(at (ptr i8)) (align i64)])

; A `:shim` convention function's realization: the `ccc` __impl
; function that carries the body, plus the convention's register layout.
(defstruct CgShim
  [(name (slice u8))
   (impl_fn (ptr i8))
   (param_regs (ptr (ArrayList (slice u8))))
   (ret_reg (slice u8))
   (clobber (ptr (ArrayList (slice u8))))
   ; a call site's assembly in place of the call: an inlined machine-code
   ; function's bytes as directives, or "" for a call
   (inline_asm (slice u8))])

(defstruct Cg
  [(ctx (ptr i8))
   (module (ptr i8))
   (builder (ptr i8))
   (td (ptr i8))
   (layouts LayoutDb)
   (structs (ArrayList CgStruct))
   (sums (ArrayList CgSum))
   (funcs (ArrayList CgFunc))
   ; always-inline names, used to keep their calls out of musttail form
   (inline_funcs (HashMap (slice u8) bool))
   ; This is a unit object (Program.unit_build: a `build-unit` object or a JIT
   ; revision). A unit object is self-contained: only its declared surface is
   ; external, its concrete static cells are internal, so a consumer that also
   ; compiles a module the unit embeds does not collide with the unit's private
   ; copy, and no function in it is the process entry.
   (unit_build bool)
   ; Names mono generated from a generic or a trait impl. A static cell inside
   ; one is instantiated by every compilation unit that uses the generic, so it
   ; is emitted weak_odr: the linker keeps one cell per program, the same
   ; rule C++ applies to a template's static. A cell in a concrete function
   ; has exactly one definition, in the unit that owns the function.
   (spec_names (HashMap (slice u8) bool))
   (rets (ArrayList CgRet))
   (sigs (ArrayList CgSig))
   (statics (ArrayList CgStatic))
   (static_owner (slice u8))
   ; The declaration a static initializer belongs to ("def app.greeting"), named
   ; in initializer diagnostics; empty outside cg-declare-statics.
   (static_context (slice u8))
   (shims (ArrayList CgShim))  ; :shim-convention functions
   (globals i64)
   (nstatic i64)  ; stable alloc-static ordinal within the current function
   (llvm_seq i64)
   ; `(primitive/llvm-ir …)` helpers, keyed by their generated module text with
   ; the helper's own name elided. See llvm-ir-helper.
   (llvm_ir_helpers (HashMap (slice u8) (ptr i8)))
   (loops (ArrayList CgLoop))
   ; alignments known for this function's non-alloca destinations
   (aligns (ArrayList CgAlign))
   (csigs (ArrayList CSigEntry))  ; only struct-by-value callables
   ; Finalized C exports for selecting the public ABI entry in fnptr-of.
   ; Direct calls continue to use `funcs`, which names the Coil entry.
   (exports (ptr (ArrayList ExportC)))
   ; The program's conventions: a convention name in a signature or a fnptr
   ; type is looked up here for its lowering.
   (conventions (ptr (ArrayList Convention)))
   (reset_func (ptr i8))
   (arch i64)  ; 0 = x86_64, 1 = aarch64, 2 = wasm32, 3 = riscv32
   (mach_o bool)  ; Mach-O (Apple) => asm symbols carry a leading `_`
   (freestanding bool)  ; no OS: no write(2) to report with, no abort(3) to stop
   (sanitizer i64)  ; 0=off, 1=ASan, 2=TSan, 3=MSan, 4=UBSan checks
   (debug_checks bool)
   (a (dyn Allocator))])

; ---- map lookups (linear; names are unique so first/last match is the same) ----
(defn cg-inline-func? [(cg (ptr Cg)) (name (slice u8))] (-> bool)
  (contains? (.inline_funcs cg) name))

(defn cg-struct-idx [(cg (ptr Cg)) (nm (slice u8))] (-> i64)
  (struct-index (field cg layouts) nm))

(defn cg-sum-idx [(cg (ptr Cg)) (nm (slice u8))] (-> i64)
  (sum-index (field cg layouts) nm))

(defn cg-func [(cg (ptr Cg)) (nm (slice u8))] (-> (ptr i8))  ; 0 if absent
  (let [n (len (.funcs cg))
        (mut i) 0
        (mut r) (primitive/cast (ptr i8) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (elem (field cg funcs) (load i))]
                  (when (= (.name fp) nm)
                    (set! r
                          (load (field fp
                                       val)))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

;;; The LLVM function type calls to `nm` are built against: the type its own
;;; declaration wrote (see CgFunc), else the global's.
(defn cg-func-fnty [(cg (ptr Cg)) (nm (slice u8)) (callee (ptr i8))] (-> (ptr i8))
  (let [n (len (.funcs cg))
        (mut i) 0
        (mut r) (primitive/cast (ptr i8) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (elem (field cg funcs) (load i))]
                  (when (= (.name fp) nm)
                    (set! r (load (field fp fnty)))
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (if (= (primitive/cast i64 (load r)) 0)
        (LLVMGlobalGetValueType callee)
        (load r))))

(defn cg-ret [(cg (ptr Cg)) (nm (slice u8))] (-> (Option Type))
  (let [n (len (.rets cg))
        (mut i) 0
        (mut r) (None [Type])]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (elem (field cg rets) (load i))]
                  (when (= (.name fp) nm)
                    (set! r
                          (Some [Type]
                                (.ty fp)))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn cg-sig-idx [(cg (ptr Cg)) (nm (slice u8))] (-> i64)
  (let [n (len (.sigs cg))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (.name (elem (field cg sigs) (load i)))
                         nm)
                  (set! r (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn cg-static-idx [(cg (ptr Cg)) (nm (slice u8))] (-> i64)
  (let [n (len (.statics cg))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (.name (elem (field cg statics)
                                      (load i)))
                         nm)
                  (set! r (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; ---- small FFI conveniences ----
(defn cg-bug [(msg (slice u8))] (-> Tv)
  (unimplemented msg)
  (mk-tv (primitive/cast (ptr i8) 0) (TInt 64 true)))

(defn ty-is-void [(t (ptr Type))] (-> bool)
  (match (load t) (TVoid [] true) (_ false)))

(defn int-width [(ctx (ptr i8)) (bits i64)] (-> (ptr i8))
  (LLVMIntTypeInContext ctx (primitive/cast i32 bits)))

; an ArrayList of opaque handles -> a contiguous C array (ptr (ptr i8)).
(defn carr [(a (dyn Allocator)) (xs (ArrayList (ptr i8)))] (-> (ptr (ptr i8)))
  (let [n (len xs)
        buf
          (primitive/cast (ptr (ptr i8))
                          (primitive/cast (ptr i8)
                                          (data (match (alloc-bytes a
                                                                    (primitive/imul (if (= n
                                                                                           0)
                                                                                        1
                                                                                        n)
                                                                                    8)
                                                                    8)
                                                  (Some [s] s)
                                                  (None []
                                                        (do
                                                          (oom-at c"compiler allocation"
                                                                  (primitive/imul (if (= n
                                                                                         0)
                                                                                      1
                                                                                      n)
                                                                                  8))
                                                          (slice::new (primitive/cast (ptr u8)
                                                                                      0)
                                                                      0)))))))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (set! (index buf (load i)) (get xs (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    buf))

; LLVMConstInt of `ty` for value 0 (the const_zero of an int/bool type).
(defn cg-zero [(ty (ptr i8))] (-> (ptr i8))
  (LLVMConstInt ty 0 0))

; ---- the slice fat-pointer type { ptr, i64 } (a fresh literal struct; LLVM
;      uniques it so repeated calls return the same type, exactly like the LLVM API).
(defn cg-slice-ty [(cg (ptr Cg))] (-> (ptr i8))
  (let [ctx (load (field cg ctx))
        (mut fs) (ArrayList::new [(ptr i8)] (.a cg))]
    (push! (mut fs) (LLVMPointerTypeInContext ctx 0))
    (push! (mut fs) (LLVMInt64TypeInContext ctx))
    (LLVMStructTypeInContext ctx (carr (.a cg) (load fs)) 2 0)))

; ---- basic_ty: Coil Type -> LLVM type. void/App/Code are
;      compiler-bug paths (hard error, never a placeholder).
(defn basic-ty [(cg (ptr Cg)) (t (ptr Type))] (-> (ptr i8))
  (let [ctx (load (field cg ctx))]
    (match (load t)
      (TConst [_]
              (do
                (unimplemented "generic constant argument reached runtime codegen")
                (primitive/cast (ptr i8) 0)))
      (TNever [] (LLVMInt64TypeInContext ctx))
      (TError [] (LLVMInt64TypeInContext ctx))
      (TInt [bits s] (int-width ctx bits))
      (TFloat [b]
              (if (= b 32)
                  (LLVMFloatTypeInContext ctx)
                  (LLVMDoubleTypeInContext ctx)))
      (TBool [] (LLVMInt1TypeInContext ctx))
      (TPtr [i] (LLVMPointerTypeInContext ctx 0))
      (TRef [m i] (LLVMPointerTypeInContext ctx 0))
      (TFn [c p r] (LLVMPointerTypeInContext ctx 0))
      (TArray [el n-extent]
              (let [n (extent-value n-extent)]
                (LLVMArrayType2 (basic-ty cg el) n)))
      (TSlice [el] (cg-slice-ty cg))
      (TStruct [nm] (cg-nominal-ty cg nm))
      (TVec [el n]
            (LLVMVectorType (basic-ty cg el)
                            (primitive/cast i32 (extent-value n))))
      ; `externref` is a wasm reference, lowered by LLVM's wasm backend to the
      ; externref value type. Opaque, scalar, never in linear memory.
      (TExternRef [] (llvm-externref-type ctx))
      (TVoid []
             (do
               (unimplemented "codegen/basic_ty: void reached as a value type (checker hole)")
               (primitive/cast (ptr i8) 0)))
      (TApp [n a]
            (do
              (unimplemented "codegen/basic_ty: generic type survived monomorphization")
              (primitive/cast (ptr i8) 0)))
      (TCode []
             (do
               (unimplemented "codegen/basic_ty: comptime-only Code reached codegen")
               (primitive/cast (ptr i8) 0)))
      (TCodeBuilder []
                    (do
                      (unimplemented "codegen/basic_ty: comptime-only CodeBuilder reached codegen")
                      (primitive/cast (ptr i8) 0))))))

(defn cg-nominal-ty [(cg (ptr Cg)) (nm (slice u8))] (-> (ptr i8))
  (let [ctx (load (field cg ctx))
        si (cg-struct-idx cg nm)]
    (if (>= si 0)
        (let [sp (elem (field cg structs) si)]
          (match (.layout sp)
            (LBits [backing offs] (int-width ctx backing))
            (_ (load (field sp ty)))))
        (let [ui (cg-sum-idx cg nm)]
          (if (>= ui 0)
              (load (field (elem (field cg sums) ui) ty))
              (do
                (unimplemented "codegen/basic_ty: unknown nominal type")
                (primitive/cast (ptr i8) 0)))))))

; ---- layout helpers: one shared source for runtime representation.
; align8 also remains a local LLVM ABI utility for padded temporary slots.
(defn align8 [(x i64)] (-> i64)
  (primitive/imul (primitive/udiv (primitive/iadd x 7) 8) 8))

(defn cg-sum-words [(cg (ptr Cg)) (sp (ptr CgSum))] (-> i64)
  (sum-words (field cg layouts) (load (field sp variants))))

(defn cg-sum-words-def [(cg (ptr Cg)) (sd (ptr SumDef))] (-> i64)
  (sum-words (field cg layouts) (load (field sd variants))))

(defn cg-sum-word-ty [(cg (ptr Cg))] (-> (ptr i8))
  (if (= (.sum_word_bytes (field cg layouts)) 4)
      (cg-i32t cg)
      (cg-i64t cg)))

; Keep LLVM authoritative for target-dependent scalar/view types (notably
; wasm32 pointers). Declared struct layouts, and arrays of them, are Coil's
; contract and come from the shared database.
(defn cg-layout-size [(cg (ptr Cg)) (t (ptr Type))] (-> i64)
  (match (load t)
    (TStruct [name]
             (if (>= (struct-index (field cg layouts) name)
                     0)
                 (size (field cg layouts) t)
                 (LLVMABISizeOfType (load (field cg td)) (basic-ty cg t))))
    (TArray [elem n-extent]
            (let [n (extent-value n-extent)]
              (primitive/imul (cg-layout-size cg elem) n)))
    (_ (LLVMABISizeOfType (load (field cg td)) (basic-ty cg t)))))

(defn cg-layout-align [(cg (ptr Cg)) (t (ptr Type))] (-> i64)
  (match (load t)
    (TStruct [name]
             (if (>= (struct-index (field cg layouts) name)
                     0)
                 (align (field cg layouts) t)
                 (primitive/cast i64
                                 (LLVMABIAlignmentOfType (load (field cg td))
                                                         (basic-ty cg t)))))
    (TArray [elem _n] (cg-layout-align cg elem))
    (_ (primitive/cast i64
                       (LLVMABIAlignmentOfType (load (field cg td))
                                               (basic-ty cg t))))))

; ---- offset_of / const_eval (for static-assert) ----
(defn cg-offset-of [(cg (ptr Cg)) (t (ptr Type)) (fname (slice u8))] (-> i64)
  (match (load t)
    (TStruct [nm]
             (let [si (cg-struct-idx cg nm)]
               (if (< si 0)
                   (do (unimplemented "codegen/offsetof: non-struct") 0)
                   (let [sp (elem (field cg structs) si)
                         idx (field-number (field cg layouts) si fname)]
                     (match (.layout sp)
                       (LBits [_ _] 0)
                       (_ (field-offset (field cg layouts) si idx)))))))
    (_ (do (unimplemented "codegen/offsetof: needs a struct") 0))))

; const_eval_t -> (value, is_unsigned). Faithful to:3153.
(defstruct CEval [(v i64) (uns bool)])

(defn mk-ceval [(v i64) (u bool)] (-> CEval)
  (CEval :v v :uns u))

(defn cev-v [(c CEval)] (-> i64)
  (let [(mut p) (: c CEval)] (.v p)))

(defn cev-u [(c CEval)] (-> bool)
  (let [(mut p) (: c CEval)] (.uns p)))

; A spanless codegen error (A spanless error is rendered by `report` as a
; bare `error: <msg>` + exit 1). The self-host's codegen paths (const-eval-t → CEval,
; emit-expr → Tv, the extern C-ABI check → i64) have no Result channel, so — exactly
; like the assertion-failed case — print the rendered line and exit(1). The stderr
; text + exit code are byte-identical to the front-end returning the Err. Used for
; static-assert folding, the by-value-view C-ABI rejection, and bitwise-op-on-float.
;;; Where codegen is: the declaration or expression being compiled, so that a
;;; program it cannot compile is reported there (see report-backend-diag).
(defstruct CgSite [(known bool) (source i64) (lo i64) (hi i64) (ctxt i64)])

(defn cg-site-cell [] (-> (ptr CgSite))
  (primitive/alloc-static CgSite))

(defn cg-at! [(source i64) (lo i64) (hi i64) (ctxt i64)] (-> i64)
  (when (and (>= lo 0) (>= source 0))
    (let [cell (cg-site-cell)]
      (set! (.known cell) true)
      (set! (.source cell) source)
      (set! (.lo cell) lo)
      (set! (.hi cell) hi)
      (set! (.ctxt cell) ctxt)
      0))
  0)

(defn cg-site-clear! [] (-> i64)
  (set! (.known (cg-site-cell)) false)
  0)

(defn cg-fail [(msg (slice u8))] (-> i64)
  (let [site (cg-site-cell)
        d (if (.known site)
              (dwspan (derr msg) (.source site) (.lo site) (.hi site) (.ctxt site))
              (derr msg))]
    (report-backend-diag (malloc-allocator) (stderr) d)
    (exit 1)
    0))

(defn const-eval-bin [(op i64) (l i64) (lu bool) (r i64) (ru bool)] (-> CEval)
  (let [uns (or lu ru)]
    (mk-ceval (cond (= op 0) (primitive/iadd l r)
                    (= op 1) (primitive/isub l r)
                    (= op 2) (primitive/imul l r)
                    (= op 7) (& l r)
                    (= op 8) (| l r)
                    (= op 9) (^ l r)
                    (= op 10) (<< l r)
                    (= op 11)
                      (if uns
                          (primitive/cast i64
                                          (>> (primitive/cast u64 l)
                                              (primitive/cast u64 r)))
                          (>> l r))
                    (= op 3)
                      (if (= r 0)
                          (do (cg-fail "static-assert: divide/mod by zero") 0)
                          (if uns (primitive/udiv l r) (/ l r)))
                    (= op 4)
                      (if (= r 0)
                          (do (cg-fail "static-assert: divide/mod by zero") 0)
                          (if uns (primitive/urem l r) (% l r)))
                    (= op 5)
                      (if (= r 0)
                          (do (cg-fail "static-assert: divide/mod by zero") 0)
                          (primitive/udiv l r))
                    (= r 0)
                      (do (cg-fail "static-assert: divide/mod by zero") 0)
                    :else (primitive/urem l r))
              uns)))

(defn const-eval-cmp [(op i64) (l i64) (lu bool) (r i64) (ru bool)] (-> CEval)
  (let [b
          (cond (or lu ru)
                  (let [lx (primitive/cast u64 l)
                        rx (primitive/cast u64 r)]
                    (cond (= op 0) (< lx rx)
                          (= op 1) (<= lx rx)
                          (= op 2) (> lx rx)
                          (= op 3) (>= lx rx)
                          (= op 4) (= lx rx)
                          :else (!= lx rx)))
                (= op 0) (< l r)
                (= op 1) (<= l r)
                (= op 2) (> l r)
                (= op 3) (>= l r)
                (= op 4) (= l r)
                :else (!= l r))]
    (mk-ceval (when b 1) false)))

(defn const-eval-t [(cg (ptr Cg)) (e (ptr Expr))] (-> CEval)
  (let [a (.a cg)]
    (match (.kind e)
      (EAnonFn [_ _] (do (abort) (zeroed CEval)))
      (EDefer [_ _] (do (unimplemented "codegen: a (defer …) region reached the backend before ownership elaboration lowered it") (zeroed CEval)))
      (EInt [v] (mk-ceval v false))
      (EBool [b] (mk-ceval (when b 1) false))
      (EIf [c thn els]
           (if (!= (cev-v (const-eval-t cg c)) 0)
               (const-eval-t cg thn)
               (const-eval-t cg els)))
      (ESizeOf [t] (mk-ceval (cg-layout-size cg (box-type a t)) false))
      (EAlignOf [t]
                (mk-ceval (cg-layout-align cg (box-type a t)) false))
      (EOffsetOf [t fname]
                 (mk-ceval (cg-offset-of cg (box-type a t) fname) false))
      (ECast [t inner]
             (mk-ceval (cev-v (const-eval-t cg inner))
                       (match t (TInt [bits s] (not s)) (_ false))))
      (EBin [op lhs rhs]
            (let [lc (const-eval-t cg lhs)
                  rc (const-eval-t cg rhs)]
              (const-eval-bin op (cev-v lc) (cev-u lc) (cev-v rc) (cev-u rc))))
      (ECmp [op lhs rhs]
            (let [lc (const-eval-t cg lhs)
                  rc (const-eval-t cg rhs)]
              (const-eval-cmp op (cev-v lc) (cev-u lc) (cev-v rc) (cev-u rc))))
      (_ (do
           (cg-fail "static-assert: only int literals, sizeof/alignof/offsetof, casts, arithmetic and comparisons are allowed")
           (mk-ceval 0 false))))))

(defn const-eval [(cg (ptr Cg)) (e (ptr Expr))] (-> i64)
  (cev-v (const-eval-t cg e)))

; ---- builder conveniences ----
(defn cg-bld [(cg (ptr Cg))] (-> (ptr i8))
  (.builder cg))

(defn cg-ctx [(cg (ptr Cg))] (-> (ptr i8))
  (.ctx cg))

(defn cg-i64t [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMInt64TypeInContext (cg-ctx cg)))

(defn cg-i32t [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMInt32TypeInContext (cg-ctx cg)))

(defn cg-const-i64 [(cg (ptr Cg)) (n i64)] (-> (ptr i8))
  (LLVMConstInt (cg-i64t cg) n 1))

(defn cg-zero-i64 [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMConstInt (cg-i64t cg) 0 0))

(defn cg-append [(cg (ptr Cg)) (func (ptr i8)) (nm (ptr i8))] (-> (ptr i8))
  (LLVMAppendBasicBlockInContext (cg-ctx cg) func nm))

(defn cg-pos [(cg (ptr Cg)) (bb (ptr i8))] (-> i64)
  (LLVMPositionBuilderAtEnd (cg-bld cg) bb)
  0)

(defn cg-cur-block [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMGetInsertBlock (cg-bld cg)))

(defn cg-cur-func [(cg (ptr Cg))] (-> (ptr i8))
  (LLVMGetBasicBlockParent (cg-cur-block cg)))

; Entry-block alloca: a constant-size alloca is a STATIC (allocate-once) frame
; slot only when it sits in the function's ENTRY block. Emitted inline inside a
; loop it becomes a DYNAMIC per-iteration stack growth — the cause of unbounded
; stack use when compiling large programs (e.g. a by-value-aggregate `push!`
; loop). Build compiler-internal temp/spill slots here so each is allocated once
; and reused across iterations. Mirrors.
(defn cg-entry-alloca [(cg (ptr Cg)) (ty (ptr i8)) (name (ptr i8))] (-> (ptr i8))
  (let [b (cg-bld cg)
        cur (LLVMGetInsertBlock b)
        entry (LLVMGetEntryBasicBlock (LLVMGetBasicBlockParent cur))
        first (LLVMGetFirstInstruction entry)]
    (if (= (primitive/cast i64 first) 0)
        (do (LLVMPositionBuilderAtEnd b entry) 0)
        (do (LLVMPositionBuilderBefore b first) 0))
    (let [slot (LLVMBuildAlloca b ty name)]
      (LLVMPositionBuilderAtEnd b cur)
      slot)))

(defn cg-terminated [(cg (ptr Cg))] (-> bool)
  (!= (primitive/cast i64 (LLVMGetBasicBlockTerminator (cg-cur-block cg)))
      0))

(defn cg-bl [(cg (ptr Cg)) (s (slice u8))] (-> (ptr i8))
  (to-cstr (.a cg) s))

; next global counter value (shared g/str/cstr counter, per).
(defn cg-next-global [(cg (ptr Cg))] (-> i64)
  (let [n (.globals cg)] (set! (.globals cg) (primitive/iadd n 1)) n))

(defn cg-gname [(cg (ptr Cg)) (prefix (slice u8)) (n i64)] (-> (ptr i8))
  (to-cstr (.a cg)
           (sconcat (.a cg)
                    prefix
                    (i64->str (.a cg)
                              n))))

; Call a width-overloaded LLVM integer intrinsic, declaring its exact mangled
; form once in the module. ctlz/cttz take the additional `is_zero_poison=false`
; argument, making zero's result the integer width.
(defn cg-int-unary-intrinsic [(cg (ptr Cg)) (op i64) (v (ptr i8)) (bits i64)] (-> (ptr i8))
  (let [a (.a cg)
        b (cg-bld cg)
        ity (LLVMTypeOf v)
        base
          (cond (= op 1) "llvm.ctlz.i"
                (= op 2) "llvm.cttz.i"
                (= op 3) "llvm.ctpop.i"
                :else "llvm.bswap.i")
        name (sconcat a base (i64->str a bits))
        (mut ptys) (ArrayList::new [(ptr i8)] a)
        (mut argv) (ArrayList::new [(ptr i8)] a)]
    (push! (mut ptys) ity)
    (push! (mut argv) v)
    (when (or (= op 1) (= op 2))
      (push! (mut ptys) (LLVMInt1TypeInContext (cg-ctx cg)))
      (push! (mut argv) (LLVMConstInt (LLVMInt1TypeInContext (cg-ctx cg)) 0 0)))
    (let [n (len (load ptys))
          fty
            (LLVMFunctionType ity (carr a (load ptys)) (primitive/cast i32 n) 0)
          old (LLVMGetNamedFunction (load (field cg module)) (to-cstr a name))
          fn
            (if (= (primitive/cast i64 old) 0)
                (LLVMAddFunction (load (field cg module))
                                 (to-cstr a name)
                                 fty)
                old)]
      (LLVMBuildCall2 b
                      fty
                      fn
                      (carr a (load argv))
                      (primitive/cast i32 n)
                      (cg-bl cg base)))))

(defn cg-int-binary-special [(cg (ptr Cg))
                             (op i64)
                             (l (ptr i8))
                             (r (ptr i8))
                             (bits i64)
                             (signed bool)] (-> (ptr i8))
  (let [a (.a cg)
        b (cg-bld cg)
        ity (LLVMTypeOf l)]
    (cond (or (= op 12) (= op 13))
            (let [base
                    (if (= op 12)
                        "llvm.fshl.i"
                        "llvm.fshr.i")
                  name (sconcat a base (i64->str a bits))
                  (mut tys) (ArrayList::new [(ptr i8)] a)
                  (mut vals) (ArrayList::new [(ptr i8)] a)]
              (push! (mut tys) ity)
              (push! (mut tys) ity)
              (push! (mut tys) ity)
              (push! (mut vals) l)
              (push! (mut vals) l)
              (push! (mut vals) r)
              (let [fty (LLVMFunctionType ity (carr a (load tys)) 3 0)
                    old
                      (LLVMGetNamedFunction (load (field cg module))
                                            (to-cstr a name))
                    fn
                      (if (= (primitive/cast i64 old) 0)
                          (LLVMAddFunction (load (field cg module))
                                           (to-cstr a name)
                                           fty)
                          old)]
                (LLVMBuildCall2 b fty fn (carr a (load vals)) 3 (cg-bl cg base))))
          (= op 14)
            (let [wide (int-width (cg-ctx cg) (primitive/imul bits 2))
                  lw
                    (if signed
                        (LLVMBuildSExt b l wide (cg-bl cg "mulhi.l"))
                        (LLVMBuildZExt b l wide (cg-bl cg "mulhi.l")))
                  rw
                    (if signed
                        (LLVMBuildSExt b r wide (cg-bl cg "mulhi.r"))
                        (LLVMBuildZExt b r wide (cg-bl cg "mulhi.r")))
                  full (LLVMBuildMul b lw rw (cg-bl cg "mulhi.full"))
                  high
                    (LLVMBuildLShr b
                                   full
                                   (LLVMConstInt wide bits 0)
                                   (cg-bl cg "mulhi.high"))]
              (LLVMBuildTrunc b high ity (cg-bl cg "mulhi")))
          :else
            (let [pair (cg-int-overflow-pair cg (- op 15) l r bits signed)]
              (LLVMBuildExtractValue b pair 1 (cg-bl cg "overflow"))))))

(defn cg-int-overflow-pair [(cg (ptr Cg))
                            (op i64)
                            (l (ptr i8))
                            (r (ptr i8))
                            (bits i64)
                            (signed bool)] (-> (ptr i8))
  (let [a (.a cg)
        b (cg-bld cg)
        ity (LLVMTypeOf l)
        kind (cond (= op 0) "add" (= op 1) "sub" :else "mul")
        name
          (sconcat a
                   (sconcat a (if signed "llvm.s" "llvm.u") kind)
                   (sconcat a ".with.overflow.i" (i64->str a bits)))
        (mut fields) (ArrayList::new [(ptr i8)] a)
        (mut tys) (ArrayList::new [(ptr i8)] a)
        (mut vals) (ArrayList::new [(ptr i8)] a)]
    (push! (mut fields) ity)
    (push! (mut fields) (LLVMInt1TypeInContext (cg-ctx cg)))
    (push! (mut tys) ity)
    (push! (mut tys) ity)
    (push! (mut vals) l)
    (push! (mut vals) r)
    (let [rty (LLVMStructTypeInContext (cg-ctx cg) (carr a (load fields)) 2 0)
          fty (LLVMFunctionType rty (carr a (load tys)) 2 0)
          old (LLVMGetNamedFunction (.module cg) (to-cstr a name))
          fn
            (if (= (primitive/cast i64 old) 0)
                (LLVMAddFunction (.module cg) (to-cstr a name) fty)
                old)]
      (LLVMBuildCall2 b
                      fty
                      fn
                      (carr a (load vals))
                      2
                      (cg-bl cg "overflow.pair")))))

; build a function type from Coil params/ret (fn_type_types), possibly variadic.
(defn cg-fn-type-v [(cg (ptr Cg))
                    (params (ptr (ArrayList Type)))
                    (ret (ptr Type))
                    (variadic bool)] (-> (ptr i8))
  (let [n (len (load params))
        (mut tys) (ArrayList::new [(ptr i8)] (.a cg))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut tys) (basic-ty cg (elem params (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (let [rt
            (if (ty-is-void ret)
                (LLVMVoidTypeInContext (cg-ctx cg))
                (basic-ty cg ret))]
      (LLVMFunctionType rt
                        (carr (.a cg) (load tys))
                        (primitive/cast i32 n)
                        (when variadic 1)))))

(defn cg-fn-type [(cg (ptr Cg))
                  (params (ptr (ArrayList Type)))
                  (ret (ptr Type))] (-> (ptr i8))
  (cg-fn-type-v cg params ret false))

; ===== calling conventions +:shim trampolines =====
; A convention name -> its Convention (null if absent) in the codegen Program.
(defn cg-prog-conv [(p (ptr Program)) (name (slice u8))] (-> (ptr Convention))
  (cg-prog-conv-in (load (field p conventions)) name))

(defn cg-prog-conv-in [(cs (ptr (ArrayList Convention))) (name (slice u8))] (-> (ptr Convention))
  (let [n (len (load cs))
        (mut i) 0
        (mut r) (primitive/cast (ptr Convention) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (conv-name (get (load cs) (load i))) name)
                  (set! r (elem cs (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; A native convention -> its LLVM CallingConv.h id.
(defn native-cc-llvm-id [(native cc/NativeCc)] (-> i64)
  (match native
    (cc/C [] 0)
    (cc/Fast [] 8)
    (cc/Cold [] 9)
    (cc/Tail [] 18)
    (cc/SwiftTail [] 20)))

; LLVM call-conv id for a native convention; -1 for a :shim (no native id).
(defn conv-native-id [(c (ptr Convention))] (-> i64)
  (match (.lowering c)
    (LNative [cc] (native-cc-llvm-id cc))
    (LShim [] -1)
    (LReset [] 0)
    (LowerWritten [_] (panic "codegen: convention '{}' was never resolved" (.name c)))))

; ---- shim registry ----
(defn cg-add-shim [(cg (ptr Cg))
                   (name (slice u8))
                   (impl-fn (ptr i8))
                   (param-regs (ptr (ArrayList (slice u8))))
                   (ret-reg (slice u8))
                   (clobber (ptr (ArrayList (slice u8))))
                   (inline-asm (slice u8))] (-> i64)
  (let [(mut s) (zeroed CgShim)]
    (set! (.name s) name)
    (set! (.impl_fn s) impl-fn)
    (set! (.param_regs s) param-regs)
    (set! (.ret_reg s) ret-reg)
    (set! (.clobber s) clobber)
    (set! (.inline_asm s) inline-asm)
    (push! (mut (.shims cg)) s)
    0))

(defn cg-shim-find [(cg (ptr Cg)) (name (slice u8))] (-> (ptr CgShim))
  (let [n (len (.shims cg))
        (mut i) 0
        (mut r) (primitive/cast (ptr CgShim) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (.name (elem (field cg shims)
                                      (load i)))
                         name)
                  (set! r (elem (field cg shims) (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; ---- arch register model ----
; Mach-O (Apple) target? Its inline-asm symbols carry a leading `_`.
(defn triple-mach-o [(triple (slice u8))] (-> bool)
  (or (match (find triple "apple") (Some [x0] true) (None [] false))
      (match (find triple "darwin") (Some [x1] true) (None [] false))
      (match (find triple "macosx") (Some [x2] true) (None [] false))))

; ELF target? LLVM gives every triple ELF that is not Mach-O, wasm or COFF.
(defn triple-elf [(triple (slice u8))] (-> bool)
  (not (or (triple-mach-o triple)
           (or (starts-with triple "wasm")
               (or (match (find triple "windows") (Some [_] true) (None [] false))
                   (match (find triple "uefi") (Some [_] true) (None [] false)))))))

; the name to use when referencing a global symbol from inline asm.
; A Coil function's symbol as inline assembly names it. Quoted, because a Coil
; name may hold `-` or `.`, which an unquoted operand reads as arithmetic
; (`bl _corpus.machine-code.sub2` was a subtraction), and with each `$` doubled,
; because a lone one introduces an asm operand (a generic instance's name holds
; them).
(defn cg-asm-sym [(cg (ptr Cg)) (name (slice u8))] (-> (slice u8))
  (let [(mut out) (StrBuf::new (.a cg))]
    (push-str! (mut out) "\"")
    (when (.mach_o cg) (push-str! (mut out) "_"))
    (for i (range 0 (len name))
      (when (= (get name i) (: 36 u8))
        (push-str! (mut out) "$"))
      (push! (mut out) (get name i)))
    (push-str! (mut out) "\"")
    (str out)))

; the i-th C-ABI integer/pointer argument register.
(defn cg-c-arg-reg [(cg (ptr Cg)) (i i64)] (-> (slice u8))
  (cond (= (.arch cg) 0)
          (cond (= i 0) "rdi"
                (= i 1) "rsi"
                (= i 2) "rdx"
                (= i 3) "rcx"
                (= i 4) "r8"
                (= i 5) "r9"
                :else
                  (do
                    (unimplemented "codegen: too many shim args for the x86_64 C ABI")
                    ""))
        (= (.arch cg) 3)
          (cond (= i 0) "a0"
                (= i 1) "a1"
                (= i 2) "a2"
                (= i 3) "a3"
                (= i 4) "a4"
                (= i 5) "a5"
                (= i 6) "a6"
                (= i 7) "a7"
                :else
                  (do
                    (unimplemented "codegen: too many shim args for the riscv32 C ABI")
                    ""))
        (= i 0) "x0"
        (= i 1) "x1"
        (= i 2) "x2"
        (= i 3) "x3"
        (= i 4) "x4"
        (= i 5) "x5"
        (= i 6) "x6"
        (= i 7) "x7"
        :else
          (do
            (unimplemented "codegen: too many shim args for the aarch64 C ABI")
            "")))

; the C-ABI integer return register.
(defn cg-c-ret-reg [(cg (ptr Cg))] (-> (slice u8))
  (cond (= (.arch cg) 0) "rax"
        (= (.arch cg) 3) "a0"
        :else "x0"))

(defn cg-is-valid-gpr [(cg (ptr Cg)) (reg (slice u8))] (-> bool)
  (arch-gpr? (cg-arch-name cg) reg))

; reject a shim convention naming a register that isn't a GPR on the target arch:
; a spanless `error: <msg>` + exit 1, via cg-fail. The message names the arch.
(defn cg-check-gpr [(cg (ptr Cg)) (reg (slice u8)) (what (slice u8))] (-> i64)
  (unless (cg-is-valid-gpr cg reg)
    (let [a (.a cg)
          arch (cg-arch-name cg)]
      (cg-fail (sconcat3 a
                         (sconcat3 a
                                   (sconcat3 a
                                             "codegen: shim convention names "
                                             what
                                             " register '")
                                   reg
                                   "', which is not a general-purpose register on the target architecture (")
                         arch
                         "). Declare the convention per-arch (see src/examples/shim.coil).")))))

(defn cg-check-shim-regs [(cg (ptr Cg)) (shim (ptr CgShim)) (n i64)] (-> i64)
  (let [prs (load (field shim param_regs))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (cg-check-gpr cg (get (load prs) (load i)) "parameter")
                (set! i (primitive/iadd (load i) 1))))))
  (when (> (len (.ret_reg shim)) 0) (cg-check-gpr cg (.ret_reg shim) "return"))
  (let [cl (load (field shim clobber))
        nc (len (load cl))
        (mut j) 0]
    (loop (if (>= (load j) nc)
              (break)
              (do
                (cg-check-gpr cg (get (load cl) (load j)) "clobber")
                (set! j (primitive/iadd (load j) 1))))))
  0)

; REG under the one name a constraint uses for it (see shim-reg-canon).
(defn cg-reg-canon [(cg (ptr Cg)) (reg (slice u8))] (-> (slice u8))
  (shim-reg-canon (.a cg) (cg-arch-name cg) reg))

(defn cg-reg-member? [(regs (ptr (ArrayList (slice u8)))) (reg (slice u8))] (-> bool)
  (block :found
         (for i (range 0 (len (load regs)))
           (when (= (get (load regs) i) reg) (break :found true)))
         false))

; ---- trampolines ----
; Whether a trampoline moves the C result into the convention's :ret register:
; not when it is the C one, and not when there is none.
(defn cg-shim-moves-result? [(cg (ptr Cg)) (shim (ptr CgShim))] (-> bool)
  (and (> (len (.ret_reg shim)) 0)
       (!= (cg-reg-canon cg (.ret_reg shim)) (cg-reg-canon cg (cg-c-ret-reg cg)))))

; A trampoline moves the convention's argument registers into the C ones. It
; stores them all, then loads each C register: moved one at a time, a
; convention taking (rsi rdi) would overwrite rdi before reading it.
(defn cg-x86-trampoline [(cg (ptr Cg))
                         (shim (ptr CgShim))
                         (n i64)
                         (impl-name (slice u8))] (-> (slice u8))
  (let [a (.a cg)
        (mut sb) (StrBuf::new a)
        prs (load (field shim param_regs))
        ; the return address leaves rsp 8 off a 16-byte boundary
        frame (if (= (% n 2) 0) (+ (* n 8) 8) (* n 8))]
    (push-str! (mut sb) (sconcat3 a "subq $$" (i64->str a frame) ", %rsp\n"))
    (for i (range 0 n)
      (push-str! (mut sb) (sconcat3 a "movq %" (get (load prs) i) ", "))
      (push-str! (mut sb) (sconcat a (i64->str a (* i 8)) "(%rsp)\n")))
    (for i (range 0 n)
      (push-str! (mut sb) (sconcat3 a "movq " (i64->str a (* i 8)) "(%rsp), %"))
      (push-str! (mut sb) (sconcat a (cg-c-arg-reg cg i) "\n")))
    (push-str! (mut sb) (sconcat3 a "call " impl-name "\n"))
    (push-str! (mut sb) (sconcat3 a "addq $$" (i64->str a frame) ", %rsp\n"))
    (when (cg-shim-moves-result? cg shim)
      (push-str! (mut sb) (sconcat3 a "movq %rax, %" (.ret_reg shim) "\n")))
    (push-str! (mut sb) "ret\n")
    (str (load sb))))

(defn cg-aarch64-trampoline [(cg (ptr Cg))
                             (shim (ptr CgShim))
                             (n i64)
                             (impl-name (slice u8))] (-> (slice u8))
  (let [a (.a cg)
        (mut sb) (StrBuf::new a)
        prs (load (field shim param_regs))
        ; the arguments, rounded to 16 bytes, then x30
        args (* (/ (+ n 1) 2) 16)
        frame (+ args 16)]
    (push-str! (mut sb) (sconcat3 a "sub sp, sp, #" (i64->str a frame) "\n"))
    (push-str! (mut sb) (sconcat3 a "str x30, [sp, #" (i64->str a args) "]\n"))
    (for i (range 0 n)
      (push-str! (mut sb) (sconcat3 a "str " (get (load prs) i) ", [sp, #"))
      (push-str! (mut sb) (sconcat a (i64->str a (* i 8)) "]\n")))
    (for i (range 0 n)
      (push-str! (mut sb) (sconcat3 a "ldr " (cg-c-arg-reg cg i) ", [sp, #"))
      (push-str! (mut sb) (sconcat a (i64->str a (* i 8)) "]\n")))
    (push-str! (mut sb) (sconcat3 a "bl " impl-name "\n"))
    (when (cg-shim-moves-result? cg shim)
      (push-str! (mut sb) (sconcat3 a "mov " (.ret_reg shim) ", x0\n")))
    (push-str! (mut sb) (sconcat3 a "ldr x30, [sp, #" (i64->str a args) "]\n"))
    (push-str! (mut sb) (sconcat3 a "add sp, sp, #" (i64->str a frame) "\n"))
    (push-str! (mut sb) "ret\n")
    (str (load sb))))

; A RISC-V call of SYM, as `call` expands it. `call` itself takes only a bare
; symbol, and a Coil name, which holds `-` and `!`, has to be quoted.
(defn cg-riscv-call [(cg (ptr Cg)) (sym (slice u8))] (-> (slice u8))
  (sconcat3 (.a cg) "1: auipc ra, %pcrel_hi(" sym ")\njalr ra, %pcrel_lo(1b)(ra)"))

; RV32: registers are 4 bytes and the stack is 16-byte aligned.
(defn cg-riscv32-trampoline [(cg (ptr Cg))
                             (shim (ptr CgShim))
                             (n i64)
                             (impl-name (slice u8))] (-> (slice u8))
  (let [a (.a cg)
        (mut sb) (StrBuf::new a)
        prs (load (field shim param_regs))
        ; the arguments, then ra, rounded to 16 bytes
        ra-at (* n 4)
        frame (* (/ (+ ra-at 19) 16) 16)]
    (push-str! (mut sb) (sconcat3 a "addi sp, sp, -" (i64->str a frame) "\n"))
    (push-str! (mut sb) (sconcat3 a "sw ra, " (i64->str a ra-at) "(sp)\n"))
    (for i (range 0 n)
      (push-str! (mut sb) (sconcat3 a "sw " (get (load prs) i) ", "))
      (push-str! (mut sb) (sconcat a (i64->str a (* i 4)) "(sp)\n")))
    (for i (range 0 n)
      (push-str! (mut sb) (sconcat3 a "lw " (cg-c-arg-reg cg i) ", "))
      (push-str! (mut sb) (sconcat a (i64->str a (* i 4)) "(sp)\n")))
    (push-str! (mut sb) (sconcat a (cg-riscv-call cg impl-name) "\n"))
    (when (cg-shim-moves-result? cg shim)
      (push-str! (mut sb) (sconcat3 a "mv " (.ret_reg shim) ", a0\n")))
    (push-str! (mut sb) (sconcat3 a "lw ra, " (i64->str a ra-at) "(sp)\n"))
    (push-str! (mut sb) (sconcat3 a "addi sp, sp, " (i64->str a frame) "\n"))
    (push-str! (mut sb) "ret\n")
    (str (load sb))))

(defn cg-emit-trampoline [(cg (ptr Cg))
                          (tramp (ptr i8))
                          (shim (ptr CgShim))
                          (n i64)] (-> i64)
  (cg-check-shim-regs cg shim n)
  (let [a (.a cg)
        b (cg-bld cg)
        ctx (cg-ctx cg)
        entry (cg-append cg tramp (cg-bl cg "entry"))
        impl-name (cg-asm-sym cg (sconcat a (.name shim) "__impl"))
        asm
          (cond (= (.arch cg) 0) (cg-x86-trampoline cg shim n impl-name)
                (= (.arch cg) 1) (cg-aarch64-trampoline cg shim n impl-name)
                :else (cg-riscv32-trampoline cg shim n impl-name))
        mem "~{memory}"
        void-ty
          (LLVMFunctionType (LLVMVoidTypeInContext ctx)
                            (carr a (ArrayList::new [(ptr i8)] a))
                            0
                            0)]
    (cg-pos cg entry)
    (let [asm-ptr
            (LLVMGetInlineAsm void-ty
                              (primitive/cast (ptr i8) (data asm))
                              (len asm)
                              (primitive/cast (ptr i8) (data mem))
                              (len mem)
                              1
                              0
                              0
                              0)]
      (LLVMBuildCall2 b
                      void-ty
                      asm-ptr
                      (carr a (ArrayList::new [(ptr i8)] a))
                      0
                      (cg-bl cg ""))
      (LLVMBuildUnreachable b)
      0)))

; ---- register-constrained shim call site ----
; A shim call is inline assembly whose operands are the convention's registers:
; the arguments in theirs, the result read from its, and every register the
; convention says the callee may change is either an output or a clobber. A
; clobbered argument register is an output nobody reads, so the caller does
; not expect its argument to survive there. The return register is always
; changed: a function with no result still runs code that may write it.
;
; The assembly is a call, or, for machine code with an :inline policy, the
; bytes themselves. Inlined bytes keep the call's whole contract but the call:
; no return address is written. The stack is aligned for them as for a call,
; which also keeps LLVM from leaving data below the stack pointer.
;
; LLVM reserves the frame pointer, so a convention that clobbers it has the
; assembly save and restore it around the call or the bytes. The stack pointer
; cannot be clobbered: nothing could find the frame afterwards.
(defstruct ShimAsm
  [(constraints (slice u8))
   (outputs (ArrayList (ptr i8)))  ; the LLVM type of each output, in order
   (saves_fp bool)])

; The frame and stack pointers, as cg-reg-canon spells them.
(defn cg-fp-reg [(cg (ptr Cg))] (-> (slice u8))
  (cond (= (.arch cg) 0) "rbp" (= (.arch cg) 1) "x29" :else "x8"))

(defn cg-sp-reg [(cg (ptr Cg))] (-> (slice u8))
  (cond (= (.arch cg) 0) "rsp" (= (.arch cg) 1) "sp" :else "x2"))

; BODY between a save and a restore of the frame pointer, on the stack.
(defn cg-save-fp-around [(cg (ptr Cg)) (body (slice u8))] (-> (slice u8))
  (let [a (.a cg)]
    (cond (= (.arch cg) 0)
            (sconcat3 a "subq $$16, %rsp\nmovq %rbp, (%rsp)\n" body
                      "\nmovq (%rsp), %rbp\naddq $$16, %rsp")
          (= (.arch cg) 1)
            (sconcat3 a "stp x29, xzr, [sp, #-16]!\n" body "\nldp x29, xzr, [sp], #16")
          :else
            (sconcat3 a "addi sp, sp, -16\nsw s0, 0(sp)\n" body
                      "\nlw s0, 0(sp)\naddi sp, sp, 16"))))

(defn cg-shim-constraints [(cg (ptr Cg))
                           (shim (ptr CgShim))
                           (argvals (ptr (ArrayList (ptr i8))))
                           (ret-llty (ptr i8))] (-> ShimAsm)
  (let [a (.a cg)
        n (len (load argvals))
        prs (load (field shim param_regs))
        cl (load (field shim clobber))
        (mut parts) (ArrayList::new [(slice u8)] a)
        (mut outputs) (ArrayList::new [(ptr i8)] a)
        (mut out-regs) (ArrayList::new [(slice u8)] a)
        (mut params) (ArrayList::new [(slice u8)] a)
        (mut changed) (ArrayList::new [(slice u8)] a)
        ret-reg (cg-reg-canon cg (.ret_reg shim))
        has-result (!= (LLVMGetTypeKind ret-llty) (: 0 i32))
        (mut sb) (StrBuf::new a)]
    (for i (range 0 n)
      (push! (mut params) (cg-reg-canon cg (get (load prs) i))))
    (when (> (len ret-reg) 0) (push! (mut changed) ret-reg))
    (for j (range 0 (len (load cl)))
      (let [c (cg-reg-canon cg (get (load cl) j))]
        (when (= c (cg-sp-reg cg))
          (cg-fail (sconcat a "codegen: a shim convention cannot clobber the stack pointer: "
                            (get (load cl) j))))
        (unless (cg-reg-member? (mut changed) c) (push! (mut changed) c))))
    (when (or (= ret-reg (cg-fp-reg cg)) (cg-reg-member? (mut params) (cg-fp-reg cg)))
      (cg-fail (sconcat a "codegen: a shim convention cannot pass a value in the frame pointer, which LLVM reserves: "
                        (cg-fp-reg cg))))
    ; a call writes the return address register (x86-64's is on the stack),
    ; and on AArch64 a linker veneer on the way may change x16 and x17
    (unless (> (len (.inline_asm shim)) 0)
      (let [(mut by-call) (ArrayList::new [(slice u8)] a)]
        (cond (= (.arch cg) 1)
                (do (push! (mut by-call) "x30") (push! (mut by-call) "x16") (push! (mut by-call) "x17") 0)
              (= (.arch cg) 3) (do (push! (mut by-call) "x1") 0)
              :else 0)
        (for k (range 0 (len (load by-call)))
          (unless (cg-reg-member? (mut changed) (get (load by-call) k))
            (push! (mut changed) (get (load by-call) k))))))
    (when has-result
      (push! (mut out-regs) ret-reg)
      (push! (mut outputs) ret-llty))
    (for i (range 0 n)
      (let [p (get (load params) i)]
        (when (and (cg-reg-member? (mut changed) p)
                   (not (cg-reg-member? (mut out-regs) p)))
          (push! (mut out-regs) p)
          (push! (mut outputs) (LLVMTypeOf (get (load argvals) i))))))
    (for k (range 0 (len (load out-regs)))
      (push! (mut parts) (sconcat3 a "={" (get (load out-regs) k) "}")))
    (for i (range 0 n)
      (push! (mut parts) (sconcat3 a "{" (get (load params) i) "}")))
    (for j (range 0 (len (load changed)))
      (let [c (get (load changed) j)]
        (unless (or (cg-reg-member? (mut out-regs) c) (= c (cg-fp-reg cg)))
          (push! (mut parts) (sconcat3 a "~{" c "}")))))
    ; Condition flags are changed by most instructions and by any call. A Coil
    ; body may change every vector register C does not preserve, which a
    ; :clobber, naming general-purpose registers, cannot list; for AArch64 that
    ; is all 32 counting the upper halves of v8-v15. RV32IMC has no others.
    (cond (= (.arch cg) 0)
            (do
              (push! (mut parts) "~{flags}")
              (push! (mut parts) "~{dirflag}")
              (push! (mut parts) "~{fpsr}")
              (when (!= (primitive/cast i64 (.impl_fn shim)) 0)
                (for k (range 0 32)
                  (push! (mut parts) (sconcat3 a "~{xmm" (i64->str a k) "}"))))
              0)
          (= (.arch cg) 1)
            (do
              (push! (mut parts) "~{cc}")
              (when (!= (primitive/cast i64 (.impl_fn shim)) 0)
                (for k (range 0 32)
                  (push! (mut parts) (sconcat3 a "~{q" (i64->str a k) "}"))))
              0)
          :else 0)
    (push! (mut parts) "~{memory}")
    (for k (range 0 (len (load parts)))
      (when (> k 0) (push-str! (mut sb) ","))
      (push-str! (mut sb) (get (load parts) k)))
    (ShimAsm :constraints (str (load sb))
             :outputs (load outputs)
             :saves_fp (cg-reg-member? (mut changed) (cg-fp-reg cg)))))

; A :shim register holds one value of at most the target's word: an integer
; no wider, or a pointer. A 64-bit integer on RV32 needs two registers, which
; a convention naming one cannot give it.
(defn cg-check-shim-value [(cg (ptr Cg))
                           (callee (slice u8))
                           (reg (slice u8))
                           (llty (ptr i8))] (-> i64)
  (let [a (.a cg)
        kind (LLVMGetTypeKind llty)
        word (if (= (.arch cg) 3) 32 64)]
    (unless (or (= kind (: 12 i32))
                (and (= kind (: 8 i32))
                     (<= (primitive/cast i64 (LLVMGetIntTypeWidth llty)) word)))
      (cg-fail (sconcat3 a
                         (sconcat3 a "codegen: a call to '" callee "' puts a value in register '")
                         reg
                         (sconcat3 a
                                   "' that it cannot hold: a :shim register holds an integer of at most "
                                   (i64->str a word)
                                   " bits, or a pointer"))))))

(defn cg-emit-shim-call [(cg (ptr Cg))
                         (name (slice u8))
                         (shim (ptr CgShim))
                         (argvals (ptr (ArrayList (ptr i8))))
                         (ret-ty (ptr Type))] (-> (ptr i8))
  (let [a (.a cg)
        b (cg-bld cg)
        ctx (cg-ctx cg)
        n (len (load argvals))
        inline (> (len (.inline_asm shim)) 0)
        ; a callee that never returns leaves nothing to read back
        ret-llty
          (match (load ret-ty)
            (TVoid [] (LLVMVoidTypeInContext ctx))
            (TNever [] (LLVMVoidTypeInContext ctx))
            (_ (basic-ty cg ret-ty)))]
    (cg-check-shim-regs cg shim n)
    (for i (range 0 n)
      (cg-check-shim-value cg name (get (load (load (field shim param_regs))) i)
                           (LLVMTypeOf (get (load argvals) i))))
    (unless (= (LLVMGetTypeKind ret-llty) (: 0 i32))
      (cg-check-shim-value cg name (.ret_reg shim) ret-llty))
    (let [shape (cg-shim-constraints cg shim argvals ret-llty)
          nout (len (.outputs shape))
          call-asm
            (cond inline (.inline_asm shim)
                  (= (.arch cg) 0) (sconcat a "call " (cg-asm-sym cg name))
                  (= (.arch cg) 1) (sconcat a "bl " (cg-asm-sym cg name))
                  :else (cg-riscv-call cg (cg-asm-sym cg name)))
          body (if (.saves_fp shape) (cg-save-fp-around cg call-asm) call-asm)
          (mut tys) (ArrayList::new [(ptr i8)] a)]
      (for i (range 0 n)
        (push! (mut tys) (LLVMTypeOf (get (load argvals) i))))
      (let [asm-ret
              (cond (= nout 0) (LLVMVoidTypeInContext ctx)
                    (= nout 1) (get (.outputs shape) 0)
                    :else (LLVMStructTypeInContext ctx
                                                   (carr a (.outputs shape))
                                                   (primitive/cast i32 nout)
                                                   0))
            fn-ty
              (LLVMFunctionType asm-ret
                                (carr a (load tys))
                                (primitive/cast i32 n)
                                0)
            asm-ptr
              (LLVMGetInlineAsm fn-ty
                                (primitive/cast (ptr i8) (data body))
                                (len body)
                                (primitive/cast (ptr i8) (data (.constraints shape)))
                                (len (.constraints shape))
                                1
                                1
                                0
                                0)
            call
              (LLVMBuildCall2 b
                              fn-ty
                              asm-ptr
                              (carr a (load argvals))
                              (primitive/cast i32 n)
                              (cg-call-name cg fn-ty "shimcall"))]
        ; a `never` result is a value of its type no one can observe
        (cond (match (load ret-ty) (TNever [] true) (_ false))
                (LLVMGetUndef (basic-ty cg ret-ty))
              (= (LLVMGetTypeKind ret-llty) (: 0 i32)) call
              (= nout 1) call
              :else (LLVMBuildExtractValue b call 0 (cg-bl cg "shimret")))))))

; ---- variant index in a sum (position of `variant` in its variant list) ----
(defn cg-variant-idx [(cg (ptr Cg)) (sp (ptr CgSum)) (variant (slice u8))] (-> i64)
  (let [vs (load (field sp variants))
        n (len (load vs))
        (mut i) 0
        (mut r) -1]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (.name (elem vs (load i)))
                         variant)
                  (set! r (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; ---- string replace (for emit_llvm_ir placeholder substitution) ----
(defn str-replace-all [(a (dyn Allocator))
                       (hay (slice u8))
                       (needle (slice u8))
                       (rep (slice u8))] (-> (slice u8))
  (let [(mut sb) (StrBuf::new a)
        nl (len needle)
        n (len hay)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (if (and (<= (primitive/iadd (load i) nl) n)
                       (= (substr hay (load i) (primitive/iadd (load i) nl))
                          needle))
                  (do
                    (push-str! (mut sb) rep)
                    (set! i (primitive/iadd (load i) nl)))
                  (do
                    (push! (mut sb) (get hay (load i)))
                    (set! i (primitive/iadd (load i) 1))))))
    (str (load sb))))

; ---- emit a list of arg expressions to their LLVM values ----
(defn emit-vals [(cg (ptr Cg)) (es (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> (ArrayList (ptr i8)))
  (let [n (len (load es))
        (mut out) (ArrayList::new [(ptr i8)] (.a cg))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out)
                       (tv-val (emit-expr cg (elem es (load i)) scp)))
                (set! i (primitive/iadd (load i) 1)))))
    (load out)))

; ---- reconcile_args: match argument values to a plain LLVM signature ----
; A memory value travels as its address, which is what a reference parameter
; takes; an aggregate-typed parameter (an array of a signature with no C ABI
; lowering) takes the value itself. A first-class aggregate (a slice) given to a
; pointer parameter is spilled.
(defn reconcile-args [(cg (ptr Cg))
                      (fnty (ptr i8))
                      (vals (ArrayList (ptr i8)))] (-> (ArrayList (ptr i8)))
  (let [a (.a cg)
        np (primitive/cast i64 (LLVMCountParamTypes fnty))
        ptbuf
          (primitive/cast (ptr (ptr i8))
                          (primitive/cast (ptr i8)
                                          (data (match (alloc-bytes a
                                                                    (primitive/imul (if (= np
                                                                                           0)
                                                                                        1
                                                                                        np)
                                                                                    8)
                                                                    8)
                                                  (Some [s] s)
                                                  (None []
                                                        (do
                                                          (oom-at c"compiler allocation"
                                                                  (primitive/imul (if (= np
                                                                                         0)
                                                                                      1
                                                                                      np)
                                                                                  8))
                                                          (slice::new (primitive/cast (ptr u8)
                                                                                      0)
                                                                      0)))))))
        n (len vals)
        (mut out) (ArrayList::new [(ptr i8)] a)
        (mut i) 0]
    (LLVMGetParamTypes fnty ptbuf)
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [v (get vals (load i))
                      (mut av) v]
                  (when (< (load i) np)
                    (let [pt (load (index ptbuf (load i)))
                          pk (LLVMGetTypeKind pt)
                          vk (LLVMGetTypeKind (LLVMTypeOf v))]
                      (cond (and (= pk (: 12 i32))
                                 (or (= vk (: 10 i32))
                                     (= vk (: 11 i32))))
                              (let [slot
                                      (cg-entry-alloca cg
                                                       (LLVMTypeOf v)
                                                       (cg-bl cg "arg.spill"))]
                                (LLVMBuildStore (cg-bld cg) v slot)
                                (set! av slot)
                                0)
                            (and (or (= pk (: 10 i32))
                                     (= pk (: 11 i32)))
                                 (= vk (: 12 i32)))
                              (let [ins
                                      (LLVMBuildLoad2 (cg-bld cg)
                                                      pt
                                                      v
                                                      (cg-bl cg "agg.value"))]
                                (LLVMSetAlignment ins 1)
                                (set! av ins)
                                0)
                            :else 0)))
                  (push! (mut out) (load av)))
                (set! i (primitive/iadd (load i) 1)))))
    (load out)))

; Materializing a loaded aggregate must preserve its value before later
; expressions run. Copy its storage directly instead of routing it through an
; LLVM aggregate SSA load/store: dynamic indexing then makes LLVM scalarize
; entire arrays into thousands of loads and stores. memcpy preserves the same
; snapshot, including when the subsequent index expression mutates the source.
(defn emit-spill-loaded [(cg (ptr Cg)) (pv Tv)] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        t
          (match (tv-ty pv)
            (TPtr [pointee] (load pointee))
            (_ (do
                 (cg-fail "codegen: spill load of non-pointer")
                 (TInt 64 true))))
        ty (basic-ty cg (box-type a t))
        slot (cg-entry-alloca cg ty (cg-bl cg "spill"))
        kind (LLVMGetTypeKind ty)]
    (if (or (= kind (: 10 i32)) (= kind (: 11 i32)))
        (do
          (LLVMBuildMemCpy b
                           slot
                           1
                           (tv-val pv)
                           1
                           (cg-const-uoff cg (cg-layout-size cg (box-type a t))))
          0)
        (let [value (LLVMBuildLoad2 b ty (tv-val pv) (cg-bl cg "load"))]
          (LLVMSetAlignment value 1)
          (LLVMBuildStore b value slot)
          0))
    (mk-tv slot (TPtr (box-type a t)))))

(defn emit-spill-ref [(cg (ptr Cg)) (inner (ptr Expr)) (scp (ptr Scope))] (-> Tv)
  (match (.kind inner)
    (ELoad [place] (emit-spill-loaded cg (emit-expr cg place scp)))
    (_ (let [a (.a cg)
             tv (emit-expr cg inner scp)
             t (tv-ty tv)
             slot
               (cg-entry-alloca cg
                                (basic-ty cg (box-type a t))
                                (cg-bl cg "spill"))]
         ; a copy even of a memory value: the reference may be written through,
         ; and that value's storage may back a binding still in scope
         (cg-store-tv! cg tv slot 0)
         (mk-tv slot (TPtr (box-type a t)))))))

(defn emit-store-ssa [(cg (ptr Cg)) (pv Tv) (val (ptr Expr)) (scp (ptr Scope))] (-> i64)
  (cg-store-tv! cg (emit-expr cg val scp) (tv-val pv) 1))

; Evaluate the destination first, then the source place, just as a value
; load/store would. There are no intervening expressions after the source load.
; memmove preserves the snapshot for self-assignment and overlapping pointers.
(defn emit-store-value [(cg (ptr Cg))
                        (pv Tv)
                        (val (ptr Expr))
                        (scp (ptr Scope))] (-> i64)
  (match (.kind val)
    (EZeroed [t]
             (let [ty (basic-ty cg (box-type (.a cg) t))
                   kind (LLVMGetTypeKind ty)]
               (if (or (= kind (: 10 i32))
                       (= kind (: 11 i32)))
                   (do
                     (LLVMBuildMemSet (cg-bld cg)
                                      (tv-val pv)
                                      (LLVMConstInt (LLVMInt8TypeInContext (cg-ctx cg))
                                                    0
                                                    0)
                                      (cg-const-uoff cg
                                                     (cg-layout-size cg
                                                                     (box-type (.a cg)
                                                                               t)))
                                      1)
                     0)
                   (emit-store-ssa cg pv val scp))))
    (ELoad [place]
           (let [t
                   (match (tv-ty pv)
                     (TPtr [pointee] (load pointee))
                     (_ (do
                          (cg-fail "codegen: store to non-pointer")
                          (TInt 64 true))))
                 ty (basic-ty cg (box-type (.a cg) t))
                 kind (LLVMGetTypeKind ty)]
             (if (or (= kind (: 10 i32))
                     (= kind (: 11 i32)))
                 (let [source (emit-expr cg place scp)]
                   (LLVMBuildMemMove (cg-bld cg)
                                     (tv-val pv)
                                     1
                                     (tv-val source)
                                     1
                                     (cg-const-uoff cg
                                                    (cg-layout-size cg
                                                                    (box-type (.a cg)
                                                                              t))))
                   0)
                 (emit-store-ssa cg pv val scp))))
    (_ (emit-store-ssa cg pv val scp))))

; ======================== emit_expr =====================
;;; Emit `e`, with it as codegen's site while it is being emitted: a failure in a
;;; subexpression is reported there, and one after it, back at `e`.
(defn emit-expr [(cg (ptr Cg)) (e (ptr Expr)) (scp (ptr Scope))] (-> Tv)
  (let [cell (cg-site-cell)
        saved (load cell)]
    (cg-at! (.source e) (.lo e) (.hi e) (.ctxt e))
    (let [tv (emit-expr-here cg e scp)]
      (store! cell saved)
      tv)))

(defn emit-expr-here [(cg (ptr Cg)) (e (ptr Expr)) (scp (ptr Scope))] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        ctx (cg-ctx cg)]
    (match (.kind e)
      (EAnonFn [_ _] (do (abort) (zeroed Tv)))
      (EDefer [_ _] (do (unimplemented "codegen: a (defer …) region reached the backend before ownership elaboration lowered it") (zeroed Tv)))
      (EBracketCall [_ _ _ _] (do (unimplemented "codegen: a bracket call reached the backend before resolution chose its reading") (zeroed Tv)))
      (EFnPtrInst [_ _] (do (unimplemented "codegen: a generic function's pointer reached the backend unspecialized") (zeroed Tv)))
      (EInt [v] (mk-tv (LLVMConstInt (cg-i64t cg) v 1) (TInt 64 true)))
      ; The checker leaves a wide literal only under a cast to its integer type;
      ; it is the i128 of its bits, which that cast narrows if the type is.
      (EWideInt [_ lo hi _ _] (mk-tv (cg-wide-const cg (LLVMIntTypeInContext ctx 128) lo hi) (TInt 128 true)))
      (EBool [bv]
             (mk-tv (LLVMConstInt (LLVMInt1TypeInContext ctx) (when bv 1) 0)
                    (TBool)))
      (EFloat [bits]
              (mk-tv (LLVMConstReal (LLVMDoubleTypeInContext ctx)
                                    (bits->f64 bits))
                     (TFloat 64)))
      ; NUL-terminate the backing constant (last arg = DontNullTerminate = 0).
      ; The slice's length (below) is unchanged; the extra \0 only
      ; makes the pointer safe to hand to C string APIs (snprintf format, etc.).
      (EStr [s]
            (let [bytes
                    (LLVMConstStringInContext ctx
                                              (primitive/cast (ptr i8)
                                                              (data s))
                                              (primitive/cast i32 (len s))
                                              0)
                  n (cg-next-global cg)
                  g
                    (LLVMAddGlobal (load (field cg module))
                                   (LLVMTypeOf bytes)
                                   (cg-gname cg "str." n))]
              (LLVMSetInitializer g bytes)
              (LLVMSetGlobalConstant g 1)
              (LLVMSetLinkage g 9)
              (let [(mut fs) (ArrayList::new [(ptr i8)] a)]
                (push! (mut fs) g)
                (push! (mut fs) (LLVMConstInt (cg-i64t cg) (len s) 0))
                (mk-tv (LLVMConstStructInContext ctx (carr a (load fs)) 2 0)
                       (TSlice (box-type a (TInt 8 false)))))))
      (ECStr [s]
             (let [bytes
                     (LLVMConstStringInContext ctx
                                               (primitive/cast (ptr i8)
                                                               (data s))
                                               (primitive/cast i32 (len s))
                                               0)
                   n (cg-next-global cg)
                   g
                     (LLVMAddGlobal (load (field cg module))
                                    (LLVMTypeOf bytes)
                                    (cg-gname cg "cstr." n))]
               (LLVMSetInitializer g bytes)
               (LLVMSetGlobalConstant g 1)
               (LLVMSetLinkage g 9)
               (mk-tv g (TPtr (box-type a (TInt 8 true))))))
      (EVar [name]
            (match (scope-get scp name)
              (Some [tv] tv)
              (None [] (cg-bug (sconcat a "codegen: unbound " name)))))
      (EZeroed [t] (emit-zeroed cg t))
      (ERecordInit [t] (emit-zeroed cg t))
      (EBorrow [m place] (emit-expr cg place scp))
      (ESpillRef [inner]
                 (emit-spill-ref cg inner scp))
      (EMovePlace [_]
                  (cg-bug "codegen: EMovePlace survived monomorphization (compiler bug)"))
      (EBin [op lhs rhs]
            (let [lv (emit-expr cg lhs scp)
                  rv (emit-expr cg rhs scp)
                  lt (tv-ty lv)
                  l (tv-val lv)
                  r (tv-val rv)]
              (if (match lt (TFloat [x] true) (_ false))
                  (mk-tv (cond (= op 0)
                                 (LLVMBuildFAdd b l r (cg-bl cg "fadd"))
                               (= op 1)
                                 (LLVMBuildFSub b l r (cg-bl cg "fsub"))
                               (= op 2)
                                 (LLVMBuildFMul b l r (cg-bl cg "fmul"))
                               (= op 3)
                                 (LLVMBuildFDiv b l r (cg-bl cg "fdiv"))
                               (= op 4)
                                 (LLVMBuildFRem b l r (cg-bl cg "frem"))
                               :else
                                 (do
                                   (cg-fail "codegen: bitwise op on a float")
                                   (primitive/cast (ptr i8) 0)))
                         lt)
                  (let [signed (match lt (TInt [bits s] s) (_ false))
                        bits (match lt (TInt [n s] n) (_ 64))]
                    ; Division/remainder by zero and an out-of-range shift are
                    ; invalid for every integer type. Guard before constructing
                    ; the LLVM instruction, whose own behavior would be poison.
                    (when (and (= (.sanitizer cg)
                                  4)
                               (or (= op 3)
                                   (= op 4)
                                   (= op 5)
                                   (= op 6)))
                      (cg-ubsan-fail-if! cg
                                         (LLVMBuildICmp b
                                                        32
                                                        r
                                                        (LLVMConstInt (LLVMTypeOf r)
                                                                      0
                                                                      0)
                                                        (cg-bl cg
                                                               "ubsan.divzero"))
                                         "integer division or remainder by zero")
                      0)
                    (when (and (= (.sanitizer cg)
                                  4)
                               (and signed
                                    (and (<= bits 64)
                                         (or (= op 3)
                                             (= op 4)))))
                      (let [ismin
                              (LLVMBuildICmp b
                                             32
                                             l
                                             (LLVMConstInt (LLVMTypeOf l)
                                                           (<< 1
                                                               (primitive/isub bits
                                                                               1))
                                                           0)
                                             (cg-bl cg "ubsan.divmin"))
                            isnegone
                              (LLVMBuildICmp b
                                             32
                                             r
                                             (LLVMConstInt (LLVMTypeOf r) -1 1)
                                             (cg-bl cg "ubsan.divnegone"))]
                        (cg-ubsan-fail-if! cg
                                           (LLVMBuildAnd b
                                                         ismin
                                                         isnegone
                                                         (cg-bl cg
                                                                "ubsan.divoverflow"))
                                           "signed division overflow"))
                      0)
                    (when (and (= (.sanitizer cg)
                                  4)
                               (or (= op 10)
                                   (= op 11)))
                      (cg-ubsan-fail-if! cg
                                         (LLVMBuildICmp b
                                                        35
                                                        r
                                                        (LLVMConstInt (LLVMTypeOf r)
                                                                      bits
                                                                      0)
                                                        (cg-bl cg "ubsan.shift"))
                                         "shift exponent is negative or too large")
                      0)
                    (mk-tv (cond (and (= (.sanitizer cg)
                                         4)
                                      (and signed
                                           (or (= op 0)
                                               (= op 1)
                                               (= op 2))))
                                   (cg-ubsan-overflow-op cg op l r bits)
                                 (= op 0)
                                   (LLVMBuildAdd b l r (cg-bl cg "add"))
                                 (= op 1)
                                   (LLVMBuildSub b l r (cg-bl cg "sub"))
                                 (= op 2)
                                   (LLVMBuildMul b l r (cg-bl cg "mul"))
                                 (= op 3)
                                   (if signed
                                       (LLVMBuildSDiv b l r (cg-bl cg "div"))
                                       (LLVMBuildUDiv b l r (cg-bl cg "div")))
                                 (= op 4)
                                   (if signed
                                       (LLVMBuildSRem b l r (cg-bl cg "rem"))
                                       (LLVMBuildURem b l r (cg-bl cg "rem")))
                                 (= op 5)
                                   (LLVMBuildUDiv b l r (cg-bl cg "udiv"))
                                 (= op 6)
                                   (LLVMBuildURem b l r (cg-bl cg "urem"))
                                 (= op 7)
                                   (LLVMBuildAnd b l r (cg-bl cg "and"))
                                 (= op 8)
                                   (LLVMBuildOr b l r (cg-bl cg "or"))
                                 (= op 9)
                                   (LLVMBuildXor b l r (cg-bl cg "xor"))
                                 (= op 10)
                                   (LLVMBuildShl b l r (cg-bl cg "shl"))
                                 (= op 11)
                                   (if signed
                                       (LLVMBuildAShr b l r (cg-bl cg "shr"))
                                       (LLVMBuildLShr b l r (cg-bl cg "shr")))
                                 :else
                                   (cg-int-binary-special cg op l r bits signed))
                           (if (>= op 15) (TBool) lt))))))
      (EIntUnary [op x]
                 (let [xv (emit-expr cg x scp)]
                   (if (= op 0)
                       (mk-tv (LLVMBuildNot b (tv-val xv) (cg-bl cg "not"))
                              (tv-ty xv))
                       (let [bits (match (tv-ty xv) (TInt [n _] n) (_ 64))]
                         (if (and (= op 4)
                                  (= bits 8))
                             xv
                             (mk-tv (cg-int-unary-intrinsic cg
                                                            op
                                                            (tv-val xv)
                                                            bits)
                                    (tv-ty xv)))))))
      (ECmp [op lhs rhs]
            (let [lv (emit-expr cg lhs scp)
                  rv (emit-expr cg rhs scp)
                  lt (tv-ty lv)
                  l (tv-val lv)
                  r (tv-val rv)]
              (if (match lt (TFloat [x] true) (_ false))
                  (let [pred
                          (cond (= op 0) 4
                                (= op 1) 5
                                (= op 2) 2
                                (= op 3) 3
                                (= op 4) 1
                                :else 6)]
                    (mk-tv (LLVMBuildFCmp b
                                          (primitive/cast i32 pred)
                                          l
                                          r
                                          (cg-bl cg "fcmp"))
                           (TBool)))
                  (let [signed (match lt (TInt [bits s] s) (_ false))
                        pred
                          (cond (= op 0) (if signed 40 36)
                                (= op 1) (if signed 41 37)
                                (= op 2) (if signed 38 34)
                                (= op 3) (if signed 39 35)
                                (= op 4) 32
                                :else 33)]
                    (mk-tv (LLVMBuildICmp b
                                          (primitive/cast i32 pred)
                                          l
                                          r
                                          (cg-bl cg "cmp"))
                           (TBool))))))
      (EDo [body] (emit-body cg body scp))
      (ECleanup [body cleanups]
                (let [result (emit-expr cg body scp)]
                  (emit-body cg cleanups scp)
                  result))
      (ELet [binds body]
            (let [child (emit-binds cg binds scp)] (emit-body cg body child)))
      (EIf [cnd thn els] (emit-if cg cnd thn els scp (no-dest)))
      (ELoop [label body] (emit-loop cg label body scp))
      (EBreak [label value] (emit-break cg label value scp))
      (EContinue [label] (emit-continue cg label))
      (ECall [func targs args] (emit-call cg func args scp (no-dest)))
      (ENamedCall [_func _targs _names _args]
                  (do
                    (cg-fail "named constructor call survived type checking")
                    (mk-tv (primitive/cast (ptr i8) 0) (TInt 64 true))))
      (EAlloc [storage t init symbol]
              (emit-alloc cg storage (box-type a t) init symbol))
      (EField [pe fname] (emit-field cg pe fname scp))
      (EAccessorField [pe fname] (emit-field cg pe fname scp))
      (EBitGet [pe fname] (emit-bitget cg pe fname scp))
      (EBitSet [pe fname val] (emit-bitset cg pe fname val scp))
      (ELoad [inner]
             (let [pv (emit-expr cg inner scp)
                   pointee
                     (match (tv-ty pv)
                       (TPtr [pe] (load pe))
                       (_ (do
                            (unimplemented "codegen: load of non-pointer")
                            (TInt 64 true))))]
               (if (cg-mem-ty? cg (box-type a pointee))
                   ; A memory value is a snapshot: later expressions may write
                   ; the place before this value is used.
                   (let [slot (cg-mem-temp cg (box-type a pointee) "load")]
                     (cg-mem-copy! cg slot (tv-val pv) (box-type a pointee))
                     (mk-tv slot pointee))
                   (let [ins
                           (LLVMBuildLoad2 b
                                           (basic-ty cg (box-type a pointee))
                                           (tv-val pv)
                                           (cg-bl cg "load"))]
                     ; A byte-offset GEP may address a packed or explicitly placed
                     ; field.  The pointer type does not carry that reduced
                     ; alignment, so LLVM's natural default can be a false promise.
                     (LLVMSetAlignment ins 1)
                     (mk-tv ins pointee)))))
      (EStore [pe val]
              (let [pv (emit-expr cg pe scp)]
                (emit-store-value cg pv val scp)
                ; store! yields canonical unit, matching its checked type.
                (mk-tv (cg-zero-i64 cg) (TInt 64 true))))
      ; Initialization of storage that has never held a value, and that the
      ; value cannot name: a memory value is built straight into it.
      (EInitStore [pe val]
                  (let [pv (emit-expr cg pe scp)]
                    (match (tv-ty pv)
                      (TPtr [pointee]
                            (if (cg-mem-ty? cg pointee)
                                (emit-into cg
                                           val
                                           (cg-dest-at cg (tv-val pv))
                                           scp)
                                (emit-store-value cg pv val scp)))
                      (_ (emit-store-value cg pv val scp)))
                    (mk-tv (cg-zero-i64 cg) (TInt 64 true))))
      (EIndex [pe idx] (emit-index cg pe idx scp))
      (ECast [t inner] (emit-cast cg (box-type a t) inner scp))
      (ESizeOf [t]
               (mk-tv (cg-const-i64 cg (cg-layout-size cg (box-type a t)))
                      (TInt 64 true)))
      (EAlignOf [t]
                (mk-tv (cg-const-i64 cg (cg-layout-align cg (box-type a t)))
                       (TInt 64 true)))
      (EOffsetOf [t fname]
                 (mk-tv (cg-const-i64 cg (cg-offset-of cg (box-type a t) fname))
                        (TInt 64 true)))
      (EFree [p]
             (let [pv (emit-expr cg p scp)]
               (LLVMBuildFree b (tv-val pv))
               (mk-tv (cg-zero-i64 cg) (TInt 64 true))))
      (EConstruct [sum variant args]
                  (emit-construct cg sum variant args scp (no-dest)))
      (EMatch [scrut arms] (emit-match cg scrut arms scp (no-dest)))
      (EFnPtrOf [name] (emit-fnptr cg name))
      (ECallPtr [fp args] (emit-callptr cg fp args scp (no-dest)))
      (ELlvmIr [result args body]
               (emit-llvm-ir cg (box-type a result) args body scp))
      (EIntrinsic [op result args]
                  (match op
                    (ILinkerAddress [symbol] (emit-linker-address cg (box-type a result) symbol))
                    (IMachineCodeSource [_] (cg-bug "codegen: machine-code that was never checked"))
                    (IMachineCode [_ _] (cg-bug "codegen: machine-code outside a machine-code function (checker bug)"))
                    (_ (emit-memory-primitive cg (box-type a result) args op scp))))
      (EStaticRef [name]
                  (let [si (cg-static-idx cg name)]
                    (if (< si 0)
                        (cg-bug (sconcat a
                                         "codegen: unknown static const "
                                         name))
                        (let [sp (elem (field cg statics) si)]
                          (mk-tv (load (field sp ptr))
                                 (TPtr (box-type a
                                                 (.ty sp))))))))
      (EErase [tn inner]
              (cg-bug "codegen: unlowered Erase (checker should have made it a MakeDyn)"))
      (ETraitCall [tn m s args]
                  (cg-bug "codegen: unresolved trait call (compiler bug)"))
      (EComptime [inner]
                 (cg-bug "codegen: unresolved comptime node (compiler bug)"))
      (EAscribe [ty inner]
                (cg-bug "codegen: unlowered ascription node — the checker should have replaced (: v t) with its coerced value (compiler bug)"))
      (EPattern [pattern-op ty inner pattern-index]
                (cg-bug "codegen: unlowered pattern projection — the checker should have replaced (: v t) with its coerced value (compiler bug)"))
      (EArrayLit [items]
                 (cg-bug "codegen: unlowered array literal (checker bug)"))
      (EStaticArray [_ _]
                    (cg-bug "static :elements escaped its allocation initializer"))
      (EMakeSlice [data elem len]
                  (let [dv (emit-expr cg data scp)
                        st (basic-ty cg (box-type a (TSlice (box-type a elem))))
                        s0
                          (LLVMBuildInsertValue b
                                                (LLVMGetUndef st)
                                                (tv-val dv)
                                                0
                                                (cg-bl cg "slice.data"))
                        s1
                          (LLVMBuildInsertValue b
                                                s0
                                                (LLVMConstInt (cg-i64t cg)
                                                              (extent-value len)
                                                              0)
                                                1
                                                (cg-bl cg "slice.len"))]
                    (mk-tv s1 (TSlice (box-type a elem)))))
      (EQuote [form]
              (cg-bug "codegen: a Code value has no runtime representation"))
      (ECodeOp [op args]
               (cg-bug "codegen: a Code value has no runtime representation"))
      (EQuasi [q]
              (cg-bug "codegen: a Code value has no runtime representation"))
      (ETypeQuery [q t]
                  (cg-bug "codegen: unresolved type-query (compiler bug)"))
      (EConstParam [_ _]
                   (cg-bug "codegen: unspecialized value parameter (compiler bug)"))
      (EVector [op result types args]
               (match (lower-vector-for-target a
                                               (.arch cg)
                                               op
                                               (box-type a result)
                                               types
                                               args)
                 (Ok [kind]
                     (emit-expr cg (box-expr a (mk-expr kind -1 -1 -1 0)) scp))
                 (Err [d] (let [diag d] (cg-bug (.msg diag))))))
      (EFieldMeta [m t idx]
                  (cg-bug "codegen: unresolved field-reflection (compiler bug)"))
      (EFieldIndex [t name]
                   (cg-bug "codegen: unresolved field-reflection (compiler bug)"))
      (EMakeDyn [ds vt methods inner]
                (emit-make-dyn cg ds vt methods inner scp (no-dest)))
      (EDynDispatch [ds vt mi cc params ret recv args]
                    (emit-dyn-dispatch cg
                                       ds
                                       vt
                                       mi
                                       cc
                                       params
                                       (box-type (.a cg) ret)
                                       recv
                                       args
                                       scp
                                       (no-dest))))))

; ExprKind::MakeDyn — erase a concrete (ptr T) to a
; (dyn Trait) fat pointer. Materialise a constant vtable global (the impl methods'
; addresses in trait order) and a caller-frame { data, vtable } struct BY VALUE.
(defn emit-make-dyn [(cg (ptr Cg))
                     (ds (slice u8))
                     (vt (slice u8))
                     (methods (ptr (ArrayList (slice u8))))
                     (inner (ptr Expr))
                     (scp (ptr Scope))
                     (dest Dest)] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        iv (emit-expr cg inner scp)
        data (tv-val iv)
        vsi (cg-struct-idx cg vt)]
    (if (< vsi 0)
        (cg-bug (sconcat a "codegen: unknown vtable struct " vt))
        (let [vty (load (field (elem (field cg structs) vsi) ty))
              nm (len (load methods))
              (mut fields) (ArrayList::new [(ptr i8)] a)
              (mut i) 0]
          (loop (if (>= (load i) nm)
                    (break)
                    (do
                      (let [mn (get (load methods) (load i))
                            fv (cg-func cg mn)]
                        (when (= (primitive/cast i64 fv) 0)
                          (unimplemented (sconcat a
                                                  "codegen: dyn vtable references unknown fn "
                                                  mn))
                          0)
                        (push! (mut fields) fv))
                      (set! i (primitive/iadd (load i) 1)))))
          (let [g
                  (LLVMAddGlobal (load (field cg module))
                                 vty
                                 (to-cstr a (sconcat a "vtable." ds)))]
            (LLVMSetInitializer g
                                (LLVMConstNamedStruct vty
                                                      (carr a (load fields))
                                                      (primitive/cast i32 nm)))
            (LLVMSetGlobalConstant g 1)
            ; One vtable per make-dyn site, and nothing refers to it by name:
            ; private, as the native backends already emit theirs. External
            ; vtables got auto-suffixed names and would collide, or silently
            ; merge, when two units each build one for the same impl.
            (LLVMSetLinkage g 9)
            (let [dsi (cg-struct-idx cg ds)]
              (if (< dsi 0)
                  (cg-bug (sconcat a "codegen: unknown dyn struct " ds))
                  (let [dty
                          (load (field (elem (field cg structs)
                                             dsi)
                                       ty))
                        slot
                          (if (dest-fits? dest
                                          (primitive/cast i64
                                                          (LLVMABIAlignmentOfType (.td cg)
                                                                                  dty)))
                              (.at dest)
                              (cg-entry-alloca cg dty (cg-bl cg "dyn.obj")))
                        dp
                          (LLVMBuildStructGEP2 b
                                               dty
                                               slot
                                               0
                                               (cg-bl cg "dyn.data"))]
                    (LLVMBuildStore b data dp)
                    (let [vp
                            (LLVMBuildStructGEP2 b
                                                 dty
                                                 slot
                                                 1
                                                 (cg-bl cg "dyn.vt"))]
                      (LLVMBuildStore b g vp)
                      (cg-deliver cg (mk-tv slot (TStruct ds)) dest))))))))))

; ExprKind::DynDispatch — call a trait method through the
; fat pointer's vtable: spill the receiver, load data + vtable, load the method's
; fnptr from vtable slot `mi`, then indirect-call (data, args…).
(defn emit-dyn-dispatch [(cg (ptr Cg))
                         (ds (slice u8))
                         (vt (slice u8))
                         (mi i64)
                         (cc (slice u8))
                         (params (ptr (ArrayList Type)))
                         (ret (ptr Type))
                         (recv (ptr Expr))
                         (args (ptr (ArrayList Expr)))
                         (scp (ptr Scope))
                         (dest Dest)] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        pty (LLVMPointerTypeInContext (cg-ctx cg) 0)
        rv (emit-expr cg recv scp)
        dsi (cg-struct-idx cg ds)]
    (if (< dsi 0)
        (cg-bug (sconcat a "codegen: unknown dyn struct " ds))
        (let [dty (load (field (elem (field cg structs) dsi) ty))
              ; the receiver is a memory value: read data and vtable in place
              slot (tv-val rv)]
          (let [dp (LLVMBuildStructGEP2 b dty slot 0 (cg-bl cg "dyn.data"))
                data (LLVMBuildLoad2 b pty dp (cg-bl cg "data"))
                vp (LLVMBuildStructGEP2 b dty slot 1 (cg-bl cg "dyn.vt"))
                vtab (LLVMBuildLoad2 b pty vp (cg-bl cg "vt"))
                vsi (cg-struct-idx cg vt)]
            (cg-validate-pointer! cg data "dyn.data" 1 false)
            (cg-validate-pointer! cg
                                  vtab
                                  "dyn.vtable"
                                  (primitive/cast i64
                                                  (LLVMABIAlignmentOfType (.td cg)
                                                                          pty))
                                  false)
            (if (< vsi 0)
                (cg-bug (sconcat a "codegen: unknown vtable struct " vt))
                (let [vty
                        (load (field (elem (field cg structs) vsi)
                                     ty))
                      mp
                        (LLVMBuildStructGEP2 b
                                             vty
                                             vtab
                                             (primitive/cast i32 mi)
                                             (cg-bl cg "vt.m"))
                      fnptr (LLVMBuildLoad2 b pty mp (cg-bl cg "fn"))
                      sig (c-signature cg params ret false)
                      (mut argtv) (ArrayList::new [Tv] a)]
                  (cg-validate-pointer! cg
                                        fnptr
                                        "dyn.method"
                                        (if (= (.arch cg) 1) 4 1)
                                        true)
                  ; A vtable stores the concrete implementation pointer verbatim.
                  ; Its declaration went through c-signature whenever any parameter
                  ; or the result is an aggregate, so the indirect call must use the
                  ; identical target ABI realization too. This matters especially on
                  ; wasm32, where an aggregate result is an sret parameter and Wasm
                  ; checks call_indirect signatures at runtime.
                  (push! (mut argtv)
                         (mk-tv data (load (elem params 0))))
                  (let [n (len (load args))
                        (mut i) 0]
                    (loop (if (>= (load i) n)
                              (break)
                              (do
                                (let [av
                                        (emit-expr cg
                                                   (elem args
                                                         (load i))
                                                   scp)]
                                  (push! (mut argtv) av))
                                (set! i (primitive/iadd (load i) 1))))))
                  (let [id (cg-cc-id cg cc)]
                    (emit-c-call-ty cg
                                    fnptr
                                    (load (field sig fn_ty))
                                    (primitive/cast i32
                                                    (if (>= id
                                                            0)
                                                        id
                                                        0))
                                    sig
                                    (load argtv)
                                    (load ret)
                                    "dyn.call"
                                    dest)))))))))

; emit a `do`/let body: last value, default (i64 0); stop at a terminator.
(defn emit-body [(cg (ptr Cg)) (body (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> Tv)
  (let [n (len (load body))
        (mut last) (mk-tv (cg-zero-i64 cg) (TInt 64 true))
        (mut i) 0]
    (loop (if (or (>= (load i) n) (cg-terminated cg))
              (break)
              (do
                (set! last (emit-expr cg (elem body (load i)) scp))
                (set! i (primitive/iadd (load i) 1)))))
    (load last)))

; bind a let's bindings into a child scp.
(defn emit-binds [(cg (ptr Cg))
                  (binds (ptr (ArrayList Bind)))
                  (scp (ptr Scope))] (-> (ptr Scope))
  (let [a (.a cg)
        n (len (load binds))
        (mut s) scp
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [bp (elem binds (load i))
                      tv (emit-expr cg (field bp value) (load s))]
                  (set! s
                        (scope-put a (load s) (.name bp) (tv-val tv) (tv-ty tv))))
                (set! i (primitive/iadd (load i) 1)))))
    (load s)))

;; ---- destination-driven aggregate emission ----
;; Where a memory value is to be built: storage nothing else can observe yet (a
;; slot no value has been stored to, or this function's own result), and the
;; alignment that storage is known to have. A null `at` is no destination: the
;; producer makes its own storage.
(defstruct Dest [(at (ptr i8)) (align i64)])

(defn no-dest [] (-> Dest)
  (Dest :at (primitive/cast (ptr i8) 0) :align 0))

(defn has-dest? [(d Dest)] (-> bool)
  (!= (primitive/cast i64 (.at d)) 0))

;; DEST, when there is one and it is aligned for NEED bytes: a producer may then
;; build in it directly instead of in storage of its own.
(defn dest-fits? [(d Dest) (need i64)] (-> bool)
  (and (has-dest? d) (>= (.align d) need)))

;; The alignment a destination pointer is known to have: an alloca's own, or
;; one recorded when a destination stood in for a slot; any other address (a
;; field of a packed struct, say) promises nothing.
(defn cg-known-align [(cg (ptr Cg)) (p (ptr i8))] (-> i64)
  (if (!= (primitive/cast i64 (LLVMIsAAllocaInst p)) 0)
      (primitive/cast i64 (LLVMGetAlignment p))
      (let [(mut r) 1]
        (for [i 0 (len (.aligns cg))]
          (let [k (elem (field cg aligns) i)]
            (when (= (primitive/cast i64 (.at k)) (primitive/cast i64 p))
              (set! r (.align k)))))
        (load r))))

(defn cg-note-align! [(cg (ptr Cg)) (d Dest)] (-> i64)
  (push! (mut (.aligns cg)) (CgAlign :at (.at d) :align (.align d)))
  0)

(defn cg-dest-at [(cg (ptr Cg)) (p (ptr i8))] (-> Dest)
  (Dest :at p :align (cg-known-align cg p)))

;; A produced value, handed to DEST when there is one the producer did not
;; build in.
(defn cg-deliver [(cg (ptr Cg)) (tv Tv) (dest Dest)] (-> Tv)
  (if (and (has-dest? dest)
           (and (!= (primitive/cast i64 (tv-val tv))
                    (primitive/cast i64 (.at dest)))
                (not (cg-terminated cg))))
      (do
        (cg-store-tv! cg tv (.at dest) 1)
        (mk-tv (.at dest) (tv-ty tv)))
      tv))

(defn cg-mem-zero! [(cg (ptr Cg)) (dst (ptr i8)) (t (ptr Type))] (-> i64)
  (LLVMBuildMemSet (cg-bld cg)
                   dst
                   (LLVMConstInt (LLVMInt8TypeInContext (cg-ctx cg)) 0 0)
                   (cg-const-uoff cg (cg-layout-size cg t))
                   1)
  0)

;; Evaluate E, of a memory type, straight into DEST. A call writes its result
;; there, a constructor builds there, and an `if` or `match` hands DEST to each
;; branch: clang's destination-driven aggregate emission, so a value is not built
;; in one temporary and copied through the next. DEST's freshness is what makes
;; this sound: no part of E can read or write it, so E cannot see it half built.
(defn emit-into [(cg (ptr Cg)) (e (ptr Expr)) (dest Dest) (scp (ptr Scope))] (-> i64)
  (let [a (.a cg)]
    (match (.kind e)
      (EZeroed [t] (cg-mem-zero! cg (.at dest) (box-type a t)))
      (ERecordInit [t] (cg-mem-zero! cg (.at dest) (box-type a t)))
      (ELoad [inner]
             (match (.kind inner)
               ; a nested record literal: a `let` that yields its slot's address
               (ELet [binds body] (emit-let-into cg binds body dest scp true))
               (_ (let [pv (emit-expr cg inner scp)]
                    (match (tv-ty pv)
                      (TPtr [pointee]
                            (cg-mem-copy! cg (.at dest) (tv-val pv) pointee))
                      (_ (do (unimplemented "codegen: load of non-pointer") 0)))))))
      (EDo [body] (emit-body-into cg body dest scp))
      (ELet [binds body] (emit-let-into cg binds body dest scp false))
      (ECleanup [body cleanups]
                (do
                  (emit-into cg body dest scp)
                  (emit-body cg cleanups scp)
                  0))
      (EIf [cnd thn els] (do (emit-if cg cnd thn els scp dest) 0))
      (EMatch [scrut arms] (do (emit-match cg scrut arms scp dest) 0))
      (ECall [func _targs args] (do (emit-call cg func args scp dest) 0))
      (ECallPtr [fp args] (do (emit-callptr cg fp args scp dest) 0))
      (EConstruct [sum variant args]
                  (do (emit-construct cg sum variant args scp dest) 0))
      (EMakeDyn [ds vt methods inner]
                (do (emit-make-dyn cg ds vt methods inner scp dest) 0))
      (EDynDispatch [ds vt mi cc params ret recv args]
                    (do
                      (emit-dyn-dispatch cg
                                         ds
                                         vt
                                         mi
                                         cc
                                         params
                                         (box-type a ret)
                                         recv
                                         args
                                         scp
                                         dest)
                      0))
      (_ (do (cg-deliver cg (emit-expr cg e scp) dest) 0)))))

;; A `do` body whose last value goes to DEST.
(defn emit-body-into [(cg (ptr Cg))
                      (body (ptr (ArrayList Expr)))
                      (dest Dest)
                      (scp (ptr Scope))] (-> i64)
  (let [n (len (load body))]
    (for [i 0 (- n 1)]
      (unless (cg-terminated cg) (emit-expr cg (elem body i) scp) 0))
    (when (and (> n 0) (not (cg-terminated cg)))
      (emit-into cg (elem body (- n 1)) dest scp))
    0))

;; A `let` whose value goes to DEST. When it ends by loading a stack slot it
;; allocated itself -- a record literal (a slot, its field stores, a load), or
;; `(let [(mut r) …] … r)` -- that slot is built in DEST and the final copy goes
;; away: the named return value optimization. It is sound only while nothing can
;; tell the slot lives in DEST, so the slot may be named solely as the root of a
;; place read or written in place, never passed, stored, borrowed or cast
;; (nrvo-slot). ADDRESS is the form a nested literal takes, `(load (let … slot))`:
;; the `let` ends with the slot's address and the load around it is the copy.
(defn emit-let-into [(cg (ptr Cg))
                     (binds (ptr (ArrayList Bind)))
                     (body (ptr (ArrayList Expr)))
                     (dest Dest)
                     (scp (ptr Scope))
                     (address bool)] (-> i64)
  (let [a (.a cg)
        slot (nrvo-slot cg binds body dest address)]
    (if (< slot 0)
        (if address
            ; the address of some storage: copy what it holds
            (let [pv
                    (emit-expr cg
                               (box-expr a
                                         (mk-expr (ELet binds body) -1 -1 -1 0))
                               scp)]
              (unless (cg-terminated cg)
                (match (tv-ty pv)
                  (TPtr [pointee]
                        (cg-mem-copy! cg (.at dest) (tv-val pv) pointee))
                  (_ (do (unimplemented "codegen: load of non-pointer") 0))))
              0)
            (emit-body-into cg body dest (emit-binds cg binds scp)))
        (let [n (len (load body))
              (mut s) scp]
          (for [i 0 (len (load binds))]
            (let [bp (elem binds i)
                  tv
                    (if (= i slot)
                        (match (.kind (field bp value))
                          (EAlloc [_ t _ _]
                                  (do
                                    (cg-note-align! cg dest)
                                    (mk-tv (.at dest) (TPtr (box-type a t)))))
                          (_ (cg-bug "codegen: the named return slot is not an alloc")))
                        (emit-expr cg (field bp value) (load s)))]
              (set! s (scope-put a (load s) (.name bp) (tv-val tv) (tv-ty tv)))))
          (for [i 0 (- n 1)]
            (unless (cg-terminated cg)
              (emit-expr cg (elem body i) (load s))
              0))
          0))))

;; The index of the bind whose stack slot a `let` may build in DEST (see
;; emit-let-into), or -1.
(defn nrvo-slot [(cg (ptr Cg))
                 (binds (ptr (ArrayList Bind)))
                 (body (ptr (ArrayList Expr)))
                 (dest Dest)
                 (address bool)] (-> i64)
  (let [a (.a cg)
        n (len (load body))
        nb (len (load binds))
        (mut result) -1]
    (when (> n 0)
      ; the slot a value-form `let` loads last, or an address-form one yields
      (match (if address
                 (.kind (elem body (- n 1)))
                 (match (.kind (elem body (- n 1)))
                   (ELoad [inner] (.kind inner))
                   (_ (EInt 0))))
        (EVar [x]
              (let [xi (bind-index binds x)
                    ; the loaded name is the slot, or a `do` that stores
                    ; the slot's first value and yields the slot
                    si
                      (if (< xi 0)
                          -1
                          (match (.kind (field (elem binds xi) value))
                            (EAlloc [_ _ _ _] xi)
                            (EDo [stmts]
                                 (let [k (len (load stmts))]
                                   (if (= k 0)
                                       -1
                                       (match (.kind (elem stmts
                                                           (- k 1)))
                                         (EVar [y] (bind-index binds y))
                                         (_ -1)))))
                            (_ -1)))]
                (when (>= si 0)
                  (match (.kind (field (elem binds si) value))
                    (EAlloc [storage t init _]
                            (let [tp (box-type a t)
                                  (mut names) (ArrayList::new [(slice u8)] a)]
                              (push! (mut names)
                                     (.name (elem binds si)))
                              (unless (= xi si) (push! (mut names) x) 0)
                              (when (and (or (= storage 0) (= storage 3))
                                         (and (= (primitive/cast i64 init) 0)
                                              (and (cg-mem-ty? cg tp)
                                                   (dest-fits? dest
                                                               (cg-slot-align cg
                                                                              tp)))))
                                (let [(mut ok) true]
                                  (for [i 0 nb]
                                    (let [bp (elem binds i)]
                                      (cond (= i si) 0
                                            ; a later bind that reuses a name hides the slot
                                            (and (!= i xi)
                                                 (name-in? (mut names)
                                                           (.name bp)))
                                              (do (set! ok false) 0)
                                            (= i xi)
                                              (match (.kind (field bp value))
                                                (EDo [stmts]
                                                     (do
                                                       (for [j
                                                             0
                                                             (- (len (load stmts))
                                                                1)]
                                                         (when (names-escape? (elem stmts
                                                                                    j)
                                                                              (mut names))
                                                           (set! ok false)))
                                                       0))
                                                (_ 0))
                                            :else
                                              (do
                                                (when (names-escape? (field bp
                                                                            value)
                                                                     (mut names))
                                                  (set! ok false))
                                                0))))
                                  (for [i 0 (- n 1)]
                                    (when (names-escape? (elem body i)
                                                         (mut names))
                                      (set! ok false)))
                                  (when (load ok) (set! result si))))
                              0))
                    (_ 0)))
                0))
        (_ 0)))
    (load result)))

(defn bind-index [(binds (ptr (ArrayList Bind))) (name (slice u8))] (-> i64)
  (let [(mut r) -1]
    (for [i 0 (len (load binds))]
      (when (= (.name (elem binds i)) name) (set! r i)))
    (load r)))

(defn name-in? [(names (ptr (ArrayList (slice u8)))) (n (slice u8))] (-> bool)
  (let [(mut r) false]
    (for [i 0 (len (load names))]
      (when (= (get (load names) i) n) (set! r true)))
    (load r)))

;; The alignment a stack slot of T gets: the ABI's, or a forced one.
(defn cg-slot-align [(cg (ptr Cg)) (t (ptr Type))] (-> i64)
  (let [fa (cg-force-align cg t)
        abi
          (primitive/cast i64 (LLVMABIAlignmentOfType (.td cg) (basic-ty cg t)))]
    (if (> fa abi) fa abi)))

;; Does E use one of NAMES other than as the root of a place it reads or writes
;; in place? Any expression kind not listed counts as a use, which only forgoes
;; the optimization.
(defn names-escape? [(e (ptr Expr)) (names (ptr (ArrayList (slice u8))))] (-> bool)
  (match (.kind e)
    (EVar [n] (name-in? names n))
    (ELoad [p] (place-escapes? p names))
    (EStore [p v] (or (place-escapes? p names) (names-escape? v names)))
    (EInitStore [p v] (or (place-escapes? p names) (names-escape? v names)))
    (EBitGet [p _] (place-escapes? p names))
    (EBitSet [p _ v] (or (place-escapes? p names) (names-escape? v names)))
    (EInt [_] false)
    (EFloat [_] false)
    (EBool [_] false)
    (EStr [_] false)
    (ECStr [_] false)
    (EZeroed [_] false)
    (ERecordInit [_] false)
    (ESizeOf [_] false)
    (EAlignOf [_] false)
    (EOffsetOf [_ _] false)
    (EFnPtrOf [_] false)
    (EStaticRef [_] false)
    (EContinue [_] false)
    (EField [p _] (names-escape? p names))
    (EIndex [p i] (or (names-escape? p names) (names-escape? i names)))
    (ECast [_ x] (names-escape? x names))
    (EBin [_ l r] (or (names-escape? l names) (names-escape? r names)))
    (ECmp [_ l r] (or (names-escape? l names) (names-escape? r names)))
    (EIntUnary [_ x] (names-escape? x names))
    (EIf [c t f]
         (or (names-escape? c names)
             (names-escape? t names)
             (names-escape? f names)))
    (EDo [body] (exprs-escape? body names))
    (ECall [_ _ args] (exprs-escape? args names))
    (ECallPtr [fp args]
              (or (names-escape? fp names) (exprs-escape? args names)))
    (EConstruct [_ _ args] (exprs-escape? args names))
    (EMakeSlice [d _ _] (names-escape? d names))
    (ESpillRef [x] (names-escape? x names))
    (EBorrow [_ x] (names-escape? x names))
    (ECleanup [b cs] (or (names-escape? b names) (exprs-escape? cs names)))
    (EDefer [c body] (or (names-escape? c names) (exprs-escape? body names)))
    (ELet [bs body]
          (let [(mut r) (exprs-escape? body names)]
            (for [i 0 (len (load bs))]
              (when (names-escape? (field (elem bs i) value) names)
                (set! r true)))
            (load r)))
    (EMatch [scrut arms]
            (let [(mut r) (names-escape? scrut names)]
              (for [i 0 (len (load arms))]
                (when (names-escape? (field (elem arms i) body) names)
                  (set! r true)))
              (load r)))
    (EAlloc [_ _ init _]
            (if (= (primitive/cast i64 init) 0)
                false
                (names-escape? init names)))
    (ELoop [_ body] (exprs-escape? body names))
    (EBreak [_ value]
            (match value (Some [v] (names-escape? v names)) (None [] false)))
    (EFree [x] (names-escape? x names))
    (EMakeDyn [_ _ _ inner] (names-escape? inner names))
    (EDynDispatch [_ _ _ _ _ _ recv args]
                  (or (names-escape? recv names) (exprs-escape? args names)))
    (ELlvmIr [_ args _] (exprs-escape? args names))
    (EIntrinsic [_ _ args] (exprs-escape? args names))
    (_ true)))

(defn exprs-escape? [(es (ptr (ArrayList Expr)))
                     (names (ptr (ArrayList (slice u8))))] (-> bool)
  (let [(mut r) false]
    (for [i 0 (len (load es))]
      (when (names-escape? (elem es i) names) (set! r true)))
    (load r)))

;; A place rooted at a name through field and index projections, or a borrow
;; of it that only serves as their base, is used in place; any other place
;; expression is an ordinary use of what it names.
(defn place-escapes? [(p (ptr Expr)) (names (ptr (ArrayList (slice u8))))] (-> bool)
  (match (.kind p)
    (EVar [_] false)
    (EBorrow [_ q] (place-escapes? q names))
    (EField [q _] (place-escapes? q names))
    (EIndex [q i] (or (place-escapes? q names) (names-escape? i names)))
    (_ (names-escape? p names))))

(defn emit-call [(cg (ptr Cg))
                 (func (slice u8))
                 (args (ptr (ArrayList Expr)))
                 (scp (ptr Scope))
                 (dest Dest)] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        ret-ty
          (match (cg-ret cg func)
            (Some [t] t)
            (None [] (cg-bug-ty (sconcat a "codegen: unknown callable " func))))
        shim (cg-shim-find cg func)]
    (if (!= (primitive/cast i64 shim) 0)
        ; a :shim callee is reached through a register-constrained inline-asm call,
        ; not a plain direct call.
        (let [vals (emit-vals cg args scp)
              vp (primitive/alloc-stack (ArrayList (ptr i8)))]
          (set! vp vals)
          (cg-deliver cg
                      (mk-tv (cg-emit-shim-call cg func shim vp (box-type a ret-ty)) ret-ty)
                      dest))
        (emit-call-native cg func args scp ret-ty dest))))

(defn emit-call-native [(cg (ptr Cg))
                        (func (slice u8))
                        (args (ptr (ArrayList Expr)))
                        (scp (ptr Scope))
                        (ret-ty Type)
                        (dest Dest)] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        callee (cg-func cg func)]
    (if (= (primitive/cast i64 callee) 0)
        (cg-bug (sconcat a "codegen: call to undefined " func))
        (let [sig (cg-csig cg func)]
          (if (!= (primitive/cast i64 sig) 0)
              (emit-c-call cg
                           func
                           callee
                           sig
                           (emit-argtv cg args scp)
                           ret-ty
                           dest)
              (let [fnty (cg-func-fnty cg func callee)
                    np (primitive/cast i64 (LLVMCountParamTypes fnty))
                    argtv (emit-argtv cg args scp)
                    (mut fixed) (ArrayList::new [(ptr i8)] a)
                    (mut byvals) (ArrayList::new [VarByval] a)]
                (for [i 0 (if (< np (len argtv)) np (len argtv))]
                  (push! (mut fixed) (tv-val (get argtv i))))
                (let [(mut meta) (reconcile-args cg fnty fixed)]
                  ; a variadic C struct needs its C-ABI lowering even when the
                  ; fixed signature has none
                  (when (!= (LLVMIsFunctionVarArg fnty) (: 0 i32))
                    (let [ptys
                            (primitive/cast (ptr (ptr i8))
                                            (data (match (alloc-bytes a
                                                                      (primitive/imul (if (> np
                                                                                             0)
                                                                                          np
                                                                                          1)
                                                                                      8)
                                                                      8)
                                                    (Some [bytes] bytes)
                                                    (None []
                                                          (do
                                                            (oom-at c"compiler allocation"
                                                                    8)
                                                            (slice::new (primitive/cast (ptr u8)
                                                                                        0)
                                                                        0))))))]
                      (LLVMGetParamTypes fnty ptys)
                      (cg-variadic-args! cg
                                         argtv
                                         np
                                         (cg-plain-reg-use fnty ptys)
                                         (mut meta)
                                         (mut byvals))))
                  (let [cs
                          (LLVMBuildCall2 b
                                          fnty
                                          callee
                                          (carr a meta)
                                          (primitive/cast i32 (len meta))
                                          (cg-call-name cg fnty "call"))]
                    (LLVMSetInstructionCallConv cs
                                                (LLVMGetFunctionCallConv callee))
                    (cg-variadic-byvals! cg cs byvals)
                    (if (ty-is-void (box-type a ret-ty))
                        (mk-tv (cg-zero-i64 cg) (TVoid))
                        (cg-deliver cg (cg-tv-of-ssa cg cs ret-ty) dest))))))))))

(defn cg-bug-ty [(msg (slice u8))] (-> Type)
  (unimplemented msg)
  (TInt 64 true))

(defn emit-field [(cg (ptr Cg))
                  (pe (ptr Expr))
                  (fname (slice u8))
                  (scp (ptr Scope))] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        pv (emit-expr cg pe scp)
        sname
          (match (tv-ty pv)
            (TPtr [pe2]
                  (match (load pe2)
                    (TStruct [s] s)
                    (_ (cg-bug-sl "codegen: field on (ptr non-struct)"))))
            (_ (cg-bug-sl "codegen: field on non-pointer")))
        si (cg-struct-idx cg sname)]
    (if (< si 0)
        (cg-bug (sconcat a "codegen: unknown struct " sname))
        (let [sp (elem (field cg structs) si)
              fs (load (field sp fields))
              nf (len (load fs))
              (mut idx) -1
              (mut i) 0]
          (loop (if (>= (load i) nf)
                    (break)
                    (do
                      (when (= (.name (elem fs (load i)))
                               fname)
                        (set! idx (load i)))
                      (set! i (primitive/iadd (load i) 1)))))
          (if (< (load idx) 0)
              (cg-bug "codegen: no such field")
              (let [fty (.ty (elem fs (load idx)))
                    gep
                      (match (.layout sp)
                        (LBits [_ _]
                               (LLVMBuildStructGEP2 b
                                                    (load (field sp ty))
                                                    (tv-val pv)
                                                    0
                                                    (cg-bl cg "field")))
                        (_ (let [(mut ix) (ArrayList::new [(ptr i8)] a)]
                             (push! (mut ix)
                                    (LLVMConstInt (cg-i64t cg)
                                                  (field-offset (field cg
                                                                       layouts)
                                                                si
                                                                (load idx))
                                                  0))
                             (LLVMBuildGEP2 b
                                            (LLVMInt8TypeInContext (cg-ctx cg))
                                            (tv-val pv)
                                            (carr a (load ix))
                                            1
                                            (cg-bl cg "field")))))]
                (mk-tv gep (TPtr (box-type a fty)))))))))

(defn cg-bug-sl [(msg (slice u8))] (-> (slice u8))
  (unimplemented msg)
  "")

(defn emit-index [(cg (ptr Cg))
                  (pe (ptr Expr))
                  (idx (ptr Expr))
                  (scp (ptr Scope))] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        pv (emit-expr cg pe scp)
        iv (emit-expr cg idx scp)
        pointee
          (match (tv-ty pv)
            (TPtr [pe2] (load pe2))
            (_ (do
                 (unimplemented "codegen: index of non-pointer")
                 (TInt 64 true))))]
    (match pointee
      (TArray [elem nn]
              (let [(mut ix) (ArrayList::new [(ptr i8)] a)]
                (push! (mut ix) (cg-zero-i64 cg))
                (push! (mut ix) (tv-val iv))
                (mk-tv (LLVMBuildGEP2 b
                                      (basic-ty cg (box-type a pointee))
                                      (tv-val pv)
                                      (carr a (load ix))
                                      2
                                      (cg-bl cg "idx"))
                       (TPtr elem))))
      (_ (let [(mut ix) (ArrayList::new [(ptr i8)] a)]
           (push! (mut ix) (tv-val iv))
           (mk-tv (LLVMBuildGEP2 b
                                 (basic-ty cg (box-type a pointee))
                                 (tv-val pv)
                                 (carr a (load ix))
                                 1
                                 (cg-bl cg "idx"))
                  (TPtr (box-type a pointee))))))))

(defn emit-cast [(cg (ptr Cg))
                 (t (ptr Type))
                 (inner (ptr Expr))
                 (scp (ptr Scope))] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        ctx (cg-ctx cg)
        iv (emit-expr cg inner scp)
        v (tv-val iv)
        vt (tv-ty iv)
        v-is-ptr (match vt (TPtr [x] true) (_ false))
        v-is-float (match vt (TFloat [x] true) (_ false))
        v-is-int (match vt (TInt [x y] true) (_ false))
        v-signed (match vt (TInt [x s] s) (_ false))]
    (match (load t)
      (TInt [to s]
            (if v-is-ptr
                (mk-tv (LLVMBuildPtrToInt b
                                          v
                                          (int-width ctx to)
                                          (cg-bl cg "ptrtoint"))
                       (load t))
                (if v-is-float
                    (mk-tv (if s
                               (LLVMBuildFPToSI b
                                                v
                                                (int-width ctx to)
                                                (cg-bl cg "fptosi"))
                               (LLVMBuildFPToUI b
                                                v
                                                (int-width ctx to)
                                                (cg-bl cg "fptoui")))
                           (load t))
                    (let [from (cg-int-bits vt)]
                      (mk-tv (if (> to from)
                                 (if v-signed
                                     (LLVMBuildSExt b
                                                    v
                                                    (int-width ctx to)
                                                    (cg-bl cg "sext"))
                                     (LLVMBuildZExt b
                                                    v
                                                    (int-width ctx to)
                                                    (cg-bl cg "zext")))
                                 (if (< to from)
                                     (LLVMBuildTrunc b
                                                     v
                                                     (int-width ctx to)
                                                     (cg-bl cg "trunc"))
                                     v))
                             (load t))))))
      (TPtr [inner2]
            (if v-is-int
                (mk-tv (LLVMBuildIntToPtr b
                                          v
                                          (LLVMPointerTypeInContext ctx 0)
                                          (cg-bl cg "inttoptr"))
                       (load t))
                (mk-tv v (load t))))
      (TFn [c p r] (mk-tv v (load t)))
      (TFloat [to]
              (let [ft (basic-ty cg t)]
                (if v-is-int
                    (mk-tv (if v-signed
                               (LLVMBuildSIToFP b v ft (cg-bl cg "sitofp"))
                               (LLVMBuildUIToFP b v ft (cg-bl cg "uitofp")))
                           (load t))
                    (if v-is-float
                        (let [from (cg-float-bits vt)]
                          (mk-tv (if (> to from)
                                     (LLVMBuildFPExt b v ft (cg-bl cg "fpext"))
                                     (if (< to from)
                                         (LLVMBuildFPTrunc b
                                                           v
                                                           ft
                                                           (cg-bl cg "fptrunc"))
                                         v))
                                 (load t)))
                        (cg-bug "codegen: cannot cast to float")))))
      (_ (cg-bug "codegen: cannot cast to this type")))))

(defn cg-int-bits [(t Type)] (-> i64)
  (match t (TInt [b s] b) (_ 64)))

(defn cg-float-bits [(t Type)] (-> i64)
  (match t (TFloat [b] b) (_ 64)))

; ======================== emit_construct / emit_match ========================
(defn emit-construct [(cg (ptr Cg))
                      (sum (slice u8))
                      (variant (slice u8))
                      (args (ptr (ArrayList Expr)))
                      (scp (ptr Scope))
                      (dest Dest)] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        ui (cg-sum-idx cg sum)]
    (if (< ui 0)
        (cg-bug (sconcat a "codegen: unknown sum " sum))
        (let [sp (elem (field cg sums) ui)
              vidx (cg-variant-idx cg sp variant)
              sum-ty (load (field sp ty))
              var-struct (get (load (field sp vstructs)) vidx)
              ; built in place when the destination is aligned for the sum
              in-place
                (dest-fits? dest
                            (primitive/cast i64
                                            (LLVMABIAlignmentOfType (.td cg)
                                                                    sum-ty)))
              tmp
                (if in-place
                    (.at dest)
                    (cg-entry-alloca cg sum-ty (cg-bl cg "sum.tmp")))
              tagptr (LLVMBuildStructGEP2 b sum-ty tmp 0 (cg-bl cg "tag"))]
          (LLVMBuildStore b (LLVMConstInt (cg-i32t cg) vidx 0) tagptr)
          (let [payload
                  (LLVMBuildStructGEP2 b sum-ty tmp 1 (cg-bl cg "payload"))
                n (len (load args))
                (mut i) 0]
            (loop (if (>= (load i) n)
                      (break)
                      (do
                        (let [fptr
                                (LLVMBuildStructGEP2 b
                                                     var-struct
                                                     payload
                                                     (primitive/cast i32
                                                                     (load i))
                                                     (cg-bl cg "vf"))
                              arg (elem args (load i))
                              vfs
                                (load (field (elem (load (field sp variants))
                                                   vidx)
                                             fields))
                              fty
                                (box-type a
                                          (.ty (elem vfs (load i))))]
                          ; the sum's storage is fresh and aligned, so each payload
                          ; field is too: the variant struct is unpacked
                          (if (cg-mem-ty? cg fty)
                              (emit-into cg
                                         arg
                                         (Dest :at fptr
                                           :align
                                             (primitive/cast i64
                                                             (LLVMABIAlignmentOfType (.td cg)
                                                                                     (basic-ty cg
                                                                                               fty))))
                                         scp)
                              (cg-store-tv! cg (emit-expr cg arg scp) fptr 0)))
                        (set! i (primitive/iadd (load i) 1)))))
            (cg-deliver cg (mk-tv tmp (TStruct sum)) dest))))))

;; The storage a match reads: the borrowed place, or the scrutinee's own
;; storage, since a sum value is a memory value.
(defn cg-match-storage [(cg (ptr Cg)) (sv Tv) (borrowed bool)] (-> (ptr i8))
  (unless (or borrowed (cg-mem-ty? cg (box-type (.a cg) (tv-ty sv))))
    (unimplemented "codegen: a matched sum value is not in memory"))
  (tv-val sv))

;; An arm's binding of the payload field at FPTR. A `$match.ref.` name on a
;; borrowed scrutinee binds the field's address. Any other binding is a value:
;; a memory value read from a borrowed place is copied, since the place may
;; change while the binding lives; one read from a scrutinee value is that
;; value's own storage, which nothing writes again.
(defn cg-match-binding [(cg (ptr Cg))
                        (fptr (ptr i8))
                        (fty Type)
                        (bname (slice u8))
                        (borrowed bool)] (-> Tv)
  (let [a (.a cg)
        ft (box-type a fty)]
    (cond (and borrowed (starts-with bname "$match.ref."))
            (mk-tv fptr (TPtr ft))
          (cg-mem-ty? cg ft)
            (if borrowed
                (let [slot (cg-mem-temp cg ft bname)]
                  (cg-mem-copy! cg slot fptr ft)
                  (mk-tv slot fty))
                (mk-tv fptr fty))
          :else
            (mk-tv (LLVMBuildLoad2 (cg-bld cg)
                                   (basic-ty cg ft)
                                   fptr
                                   (to-cstr a bname))
                   fty))))

(defn emit-match [(cg (ptr Cg))
                  (scrut (ptr Expr))
                  (arms (ptr (ArrayList Arm)))
                  (scp (ptr Scope))
                  (dest Dest)] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        sv (emit-expr cg scrut scp)
        borrowed
          (match (tv-ty sv)
            (TRef [_ inner] (match (load inner) (TStruct [_] true) (_ false)))
            (TPtr [inner] (match (load inner) (TStruct [_] true) (_ false)))
            (_ false))
        borrow-mutable (match (tv-ty sv) (TRef [mutable _] mutable) (_ false))
        sumname
          (match (tv-ty sv)
            (TStruct [s] s)
            (TRef [_ inner]
                  (match (load inner)
                    (TStruct [s] s)
                    (_ (cg-bug-sl "codegen: match on non-sum reference"))))
            (TPtr [inner]
                  (match (load inner)
                    (TStruct [s] s)
                    (_ (cg-bug-sl "codegen: match on non-sum pointer"))))
            (_ (cg-bug-sl "codegen: match on non-sum")))
        ui (cg-sum-idx cg sumname)]
    (if (< ui 0)
        (cg-bug (sconcat a "codegen: match on non-sum " sumname))
        (let [sp (elem (field cg sums) ui)
              sum-ty (load (field sp ty))
              tmp (cg-match-storage cg sv borrowed)]
          (let [tagptr (LLVMBuildStructGEP2 b sum-ty tmp 0 (cg-bl cg "tag"))
                tag (LLVMBuildLoad2 b (cg-i32t cg) tagptr (cg-bl cg "tag"))
                payload
                  (LLVMBuildStructGEP2 b sum-ty tmp 1 (cg-bl cg "payload"))
                func (cg-cur-func cg)
                narms (len (load arms))
                ; a trailing `(_ …)` arm becomes the switch's DEFAULT destination
                ; instead of a case, so the tags it covers need no cases at all.
                ncases
                  (if (arms-have-wildcard arms) (primitive/isub narms 1) narms)
                (mut armbbs) (ArrayList::new [(ptr i8)] a)
                (mut k) 0]
            (loop (if (>= (load k) narms)
                      (break)
                      (do
                        (push! (mut armbbs)
                               (cg-append cg func (cg-bl cg "arm")))
                        (set! k (primitive/iadd (load k) 1)))))
            (let [default
                    (if (= ncases narms)
                        (cg-append cg func (cg-bl cg "match.default"))
                        (get (load armbbs) ncases))
                  merge (cg-append cg func (cg-bl cg "match.end"))
                  sw (LLVMBuildSwitch b tag default (primitive/cast i32 ncases))
                  (mut k2) 0]
              (loop (if (>= (load k2) ncases)
                        (break)
                        (do
                          (let [ap (elem arms (load k2))
                                vidx (cg-variant-idx cg sp (.variant ap))]
                            (LLVMAddCase sw
                                         (LLVMConstInt (cg-i32t cg) vidx 0)
                                         (get (load armbbs) (load k2))))
                          (set! k2 (primitive/iadd (load k2) 1)))))
              (when (= ncases narms)
                (cg-pos cg default)
                (LLVMBuildUnreachable b)
                0)
              ; emit arms; collect (value, end-block) for the merge phi.
              (let [(mut inc-vals) (ArrayList::new [(ptr i8)] a)
                    (mut inc-bbs) (ArrayList::new [(ptr i8)] a)
                    (mut result-ty) (TInt 64 true)
                    (mut k3) 0]
                (loop (if (>= (load k3) narms)
                          (break)
                          (do
                            (cg-pos cg (get (load armbbs) (load k3)))
                            (let [ap (elem arms (load k3))
                                  ; the catch-all names no variant and binds nothing;
                                  ; index 0 keeps the payload lookups below in range,
                                  ; and the bind loop that would read them never runs.
                                  vidx
                                    (if (>= (load k3) ncases)
                                        0
                                        (cg-variant-idx cg sp (.variant ap)))
                                  var-struct
                                    (get (load (field sp vstructs)) vidx)
                                  vp
                                    (elem (load (field sp variants))
                                          vidx)
                                  vfs (load (field vp fields))
                                  binds (load (field ap binds))
                                  nb (len (load binds))
                                  (mut child) scp
                                  (mut j) 0]
                              (loop (if (>= (load j) nb)
                                        (break)
                                        (do
                                          (let [fptr
                                                  (LLVMBuildStructGEP2 b
                                                                       var-struct
                                                                       payload
                                                                       (primitive/cast i32
                                                                                       (load j))
                                                                       (cg-bl cg
                                                                              "vf"))
                                                fty
                                                  (.ty (elem vfs
                                                             (load j)))
                                                bname
                                                  (get (load binds) (load j))
                                                bv
                                                  (cg-match-binding cg
                                                                    fptr
                                                                    fty
                                                                    bname
                                                                    borrowed)]
                                            (set! child
                                                  (scope-put a
                                                             (load child)
                                                             bname
                                                             (tv-val bv)
                                                             (tv-ty bv))))
                                          (set! j (primitive/iadd (load j) 1)))))
                              (let [bv
                                      (emit-branch cg
                                                   (field ap body)
                                                   (load child)
                                                   dest)
                                    endbb (cg-cur-block cg)]
                                (when (= (primitive/cast i64
                                                         (LLVMGetBasicBlockTerminator endbb))
                                         0)
                                  (set! result-ty (tv-ty bv))
                                  (LLVMBuildBr b merge)
                                  (push! (mut inc-vals) (tv-val bv))
                                  (push! (mut inc-bbs) endbb))))
                            (set! k3 (primitive/iadd (load k3) 1)))))
                (cg-pos cg merge)
                (if (= (len (load inc-vals)) 0)
                    (do
                      (LLVMBuildUnreachable b)
                      (mk-tv (cg-zero-i64 cg) (load result-ty)))
                    ; A void match joins control flow but has no value to merge.
                    ; LLVM cannot represent a void-typed phi.
                    (if (ty-is-void (box-type a (load result-ty)))
                        (mk-tv (cg-zero-i64 cg) (TVoid))
                        (let [phi
                                (LLVMBuildPhi b
                                              (cg-value-ty cg
                                                           (box-type a
                                                                     (load result-ty)))
                                              (cg-bl cg "match.val"))]
                          (LLVMAddIncoming phi
                                           (carr a (load inc-vals))
                                           (carr a (load inc-bbs))
                                           (primitive/cast i32
                                                           (len (load inc-vals))))
                          (mk-tv phi (load result-ty))))))))))))

; ======================== emit_alloc / bit access ============================
; a struct with `:layout (layout/Align N)` (or explicit `:align`) forces its allocation
; alignment; 0 = no forced alignment.
(defn cg-force-align [(cg (ptr Cg)) (t (ptr Type))] (-> i64)
  (match (load t)
    (TStruct [nm]
             (let [si (cg-struct-idx cg nm)]
               (unless (< si 0)
                 (let [want (.align (struct-at (field cg layouts) si))
                       natural
                         (primitive/cast i64
                                         (LLVMABIAlignmentOfType (load (field cg
                                                                              td))
                                                                 (basic-ty cg t)))]
                   (if (> want natural) want 0)))))
    (TArray [elem _n] (cg-force-align cg elem))
    (_ 0)))

;;; The integer constant of type `bt` whose bits are (`hi`, `lo`).
(defn cg-wide-const [(cg (ptr Cg)) (bt (ptr i8)) (lo i64) (hi i64)] (-> (ptr i8))
  (let [words (primitive/alloc-stack (array i64 2))]
    (set! (mut words) 0 lo)
    (set! (mut words) 1 hi)
    (LLVMConstIntOfArbitraryPrecision bt 2 (primitive/cast (ptr i64) words))))

(defn cg-static-fail [(msg (slice u8))] (-> (ptr i8))
  (do (cg-fail msg) (primitive/cast (ptr i8) 0)))

; A static-initializer failure, naming the declaration being initialized when
; there is one.
(defn cg-static-fail-in [(cg (ptr Cg)) (msg (slice u8))] (-> (ptr i8))
  (if (= (len (.static_context cg)) 0)
      (cg-static-fail msg)
      (cg-static-fail (sconcat (.a cg)
                               (.static_context cg)
                               (sconcat (.a cg) ": " msg)))))

(defn cg-static-pad! [(cg (ptr Cg))
                      (values (mut (ArrayList (ptr i8))))
                      (cursor i64)
                      (to i64)] (-> i64)
  (when (> to cursor)
    (push! (mut values)
           (LLVMConstNull (LLVMArrayType2 (LLVMInt8TypeInContext (cg-ctx cg))
                                          (primitive/isub to cursor))))
    0)
  to)

; A sum value as a packed constant: the tag, then the variant's fields at the
; offsets the variant's payload struct gives them, zero padding everywhere else.
; Its physical type differs from the sum's nominal LLVM type, which is fine for a
; static: storage is sized and aligned by the logical type.
(defn cg-static-construct [(cg (ptr Cg))
                           (sum (slice u8))
                           (variant (slice u8))
                           (args (ptr (ArrayList Expr)))] (-> (ptr i8))
  (let [ui (cg-sum-idx cg sum)]
    (if (< ui 0)
        (cg-static-fail-in cg (sconcat (.a cg) "unknown sum type " sum))
        (let [sp (elem (field cg sums) ui)
              vidx (cg-variant-idx cg sp variant)
              sum-ty (load (field sp ty))
              var-struct (get (load (field sp vstructs)) vidx)
              fields
                (.fields (elem (load (field sp variants)) vidx))
              td (.td cg)
              payload (LLVMOffsetOfElement td sum-ty 1)
              total (cg-layout-size cg (box-type (.a cg) (TStruct sum)))
              (mut values) (ArrayList::new [(ptr i8)] (.a cg))
              (mut cursor) 4]
          (push! (mut values) (LLVMConstInt (cg-i32t cg) vidx 0))
          (for [i 0 (len (load args))]
            (let [at
                    (primitive/iadd payload
                                    (LLVMOffsetOfElement td
                                                         var-struct
                                                         (primitive/cast i32 i)))
                  v
                    (cg-static-constant cg
                                        (field (elem fields i) ty)
                                        (elem args i))]
              (set! cursor (cg-static-pad! cg (mut values) cursor at))
              (push! (mut values) v)
              (set! cursor
                    (primitive/iadd at (LLVMABISizeOfType td (LLVMTypeOf v))))))
          (cg-static-pad! cg (mut values) cursor total)
          (LLVMConstStructInContext (cg-ctx cg)
                                    (carr (.a cg) (load values))
                                    (primitive/cast i32 (len values))
                                    1)))))

(defn cg-static-cstr [(cg (ptr Cg)) (s (slice u8))] (-> (ptr i8))
  (let [bytes
          (LLVMConstStringInContext (cg-ctx cg)
                                    (primitive/cast (ptr i8)
                                                    (data s))
                                    (primitive/cast i32 (len s))
                                    0)
        g
          (LLVMAddGlobal (load (field cg module))
                         (LLVMTypeOf bytes)
                         (cg-gname cg "static.cstr." (cg-next-global cg)))]
    (LLVMSetInitializer g bytes)
    (LLVMSetGlobalConstant g 1)
    (LLVMSetLinkage g 9)
    g))

(defn cg-static-field-values [(cg (ptr Cg))
                              (fields (ptr (ArrayList Field)))
                              (body (ptr (ArrayList Expr)))] (-> (ArrayList (ptr Expr)))
  ; The value the body stores to each field, by name (null: none, so zero).
  (let [(mut values) (ArrayList::new [(ptr Expr)] (.a cg))]
    (for [i 0 (len (load fields))] (push! (mut values) (primitive/cast (ptr Expr) 0)))
    (for [i 0 (len (load body))]
      (let [item (elem body i)
            place (static-store-place item)]
        (if (= (primitive/cast i64 place) 0)
            (unless (static-body-result? body i)
              (cg-static-fail "alloc-static initializer: expected a materialized aggregate")
              0)
            (match (.kind place)
              (EField [_ fname]
                      (let [fi (block :found
                                 (for [k 0 (len (load fields))]
                                   (when (= (.name (elem fields k)) fname)
                                     (break :found k)))
                                 -1)]
                        (if (< fi 0)
                            (cg-static-fail (sconcat (.a cg) "alloc-static initializer: unknown field " fname))
                            (set! (mut values) fi (static-store-value item)))
                        0))
              (_ (do (cg-static-fail "alloc-static initializer: a store that is not to a field of the aggregate") 0))))
        0))
    values))

(defn cg-static-aggregate-body [(cg (ptr Cg))
                                (base (ptr i8))
                                (fields (ptr (ArrayList Field)))
                                (body (ptr (ArrayList Expr)))] (-> (ptr i8))
  (let [n (len (load fields))
        bt (LLVMTypeOf base)
        total (primitive/cast i64 (LLVMCountStructElementTypes bt))
        given (cg-static-field-values cg fields body)
        (mut values) (ArrayList::new [(ptr i8)] (.a cg))]
    (for [i 0 total]
      (let [value (if (< i n) (get given i) (primitive/cast (ptr Expr) 0))]
        (push! (mut values)
               (if (= (primitive/cast i64 value) 0)
                   (LLVMConstNull (LLVMStructGetTypeAtIndex bt (primitive/cast i32 i)))
                   (cg-static-constant cg (field (elem fields i) ty) value)))))
    (cg-const-struct cg bt (mut values))))

;;; A struct constant from its element constants. An element whose physical
;;; type is not the declared one (a sum's packed literal, a union holding a
;;; pointer) makes the constant a packed literal laid out at the struct's own
;;; offsets; the global it initializes takes that type, while size, alignment
;;; and every access still follow the logical struct.
(defn cg-const-struct [(cg (ptr Cg))
                       (bt (ptr i8))
                       (values (ptr (ArrayList (ptr i8))))] (-> (ptr i8))
  (let [a (.a cg)
        td (load (field cg td))
        n (len (load values))
        (mut same) true]
    (for [i 0 n]
      (unless (= (primitive/cast i64 (LLVMTypeOf (get (load values) i)))
                 (primitive/cast i64
                                 (LLVMStructGetTypeAtIndex bt
                                                           (primitive/cast i32
                                                                           i))))
        (set! same false)))
    (if same
        (LLVMConstNamedStruct bt (carr a (load values)) (primitive/cast i32 n))
        (let [(mut parts) (ArrayList::new [(ptr i8)] a)
              (mut cursor) 0
              total (LLVMABISizeOfType td bt)]
          (for [i 0 n]
            (let [v (get (load values) i)
                  off (LLVMOffsetOfElement td bt (primitive/cast i32 i))]
              (when (> off cursor)
                (push! (mut parts) (cg-zero-bytes cg (- off cursor))))
              (push! (mut parts) v)
              (set! cursor (+ off (LLVMABISizeOfType td (LLVMTypeOf v))))))
          (when (> total cursor)
            (push! (mut parts) (cg-zero-bytes cg (- total cursor))))
          (LLVMConstStructInContext (cg-ctx cg)
                                    (carr a (load parts))
                                    (primitive/cast i32 (len parts))
                                    1)))))

;;; An array constant; elements of differing physical types (see
;;; cg-const-struct) make it a packed literal of the same bytes.
(defn cg-const-array [(cg (ptr Cg))
                      (elem (ptr i8))
                      (values (ptr (ArrayList (ptr i8))))] (-> (ptr i8))
  (let [a (.a cg)
        n (len (load values))
        (mut same) true]
    (for [i 0 n]
      (unless (= (primitive/cast i64 (LLVMTypeOf (get (load values) i)))
                 (primitive/cast i64 elem))
        (set! same false)))
    (if same
        (LLVMConstArray2 elem (carr a (load values)) n)
        (LLVMConstStructInContext (cg-ctx cg)
                                  (carr a (load values))
                                  (primitive/cast i32 n)
                                  1))))

(defn cg-zero-bytes [(cg (ptr Cg)) (n i64)] (-> (ptr i8))
  (LLVMConstNull (LLVMArrayType2 (LLVMInt8TypeInContext (cg-ctx cg)) n)))

;;; A union's initial value, built the way memory would hold it: each field's
;;; constant written at its offset in declaration order, a later field
;;; overwriting the bytes of an earlier one. A pointer to another object has no
;;; bytes at compile time; it stays a relocation, which a later field may
;;; replace whole but not in part.
(defstruct CgReloc [(off i64) (value (ptr i8))])

(defstruct CgImage [(bytes (ArrayList i64)) (relocs (ArrayList CgReloc))])

(defn cg-image-clobber! [(img (ptr CgImage)) (off i64) (n i64)] (-> i64)
  (let [(mut kept) (ArrayList::new [CgReloc] (.alc (.relocs img)))]
    (for [i 0 (len (.relocs img))]
      (let [r (get (.relocs img) i)
            rend (+ (.off r) 8)]
        (cond (or (<= rend off) (>= (.off r) (+ off n))) (push! (mut kept) r)
              (and (>= (.off r) off) (<= rend (+ off n))) 0
              :else
                (cg-static-fail "alloc-static initializer: a later union field overwrites part of a pointer; a pointer has no link-time value in pieces"))))
    (set! (.relocs img) kept))
  0)

(defn cg-image-put-int! [(img (ptr CgImage)) (off i64) (v i64) (n i64)] (-> i64)
  (for [k 0 n]
    (set! (mut (.bytes img)) (+ off k) (& (>> v (* k 8)) 255)))
  0)

(defn cg-image-write! [(cg (ptr Cg)) (img (ptr CgImage)) (off i64) (c (ptr i8))] (-> i64)
  (let [td (load (field cg td))
        ty (LLVMTypeOf c)
        n (LLVMABISizeOfType td ty)
        kind (primitive/cast i64 (LLVMGetTypeKind ty))]
    (cg-image-clobber! img off n)
    (cond (!= (primitive/cast i64 (LLVMIsNull c)) 0)
            (cg-image-put-int! img off 0 n)
          (!= (primitive/cast i64 (LLVMIsAConstantInt c)) 0)
            (do
              (when (> (LLVMStoreSizeOfType td ty) 8)
                (cg-static-fail "alloc-static initializer: a union field's integer is wider than 64 bits"))
              (cg-image-put-int! img off 0 n)
              (cg-image-put-int! img
                                 off
                                 (LLVMConstIntGetZExtValue c)
                                 (LLVMStoreSizeOfType td ty)))
          (!= (primitive/cast i64 (LLVMIsAConstantFP c)) 0)
            (let [(mut loses) (: 0 i32)
                  d (LLVMConstRealGetDouble c (mut loses))]
              (if (= kind 2)
                  (cg-image-put-int! img
                                     off
                                     (f64-bits->f32-bits (f64-bits d))
                                     4)
                  (cg-image-put-int! img off (f64-bits d) 8)))
          (!= (primitive/cast i64 (LLVMIsAConstantStruct c)) 0)
            (do
              (cg-image-put-int! img off 0 n)
              (for [i 0 (primitive/cast i64 (LLVMCountStructElementTypes ty))]
                (cg-image-write! cg
                                 img
                                 (+ off
                                    (LLVMOffsetOfElement td
                                                         ty
                                                         (primitive/cast i32 i)))
                                 (LLVMGetOperand c (primitive/cast i32 i)))))
          (or (!= (primitive/cast i64 (LLVMIsAConstantArray c)) 0)
              (!= (primitive/cast i64 (LLVMIsAConstantDataArray c)) 0))
            (let [stride (LLVMABISizeOfType td (LLVMGetElementType ty))]
              (for [i 0 (LLVMGetArrayLength2 ty)]
                (cg-image-write! cg
                                 img
                                 (+ off (* i stride))
                                 (LLVMGetAggregateElement c
                                                          (primitive/cast i32 i)))))
          (= kind 12)
            ; a pointer to another object: a relocation, not bytes
            (do
              (for [k 0 8] (set! (mut (.bytes img)) (+ off k) -1))
              (push! (mut (.relocs img)) (CgReloc :off off :value c)))
          :else
            (cg-static-fail "alloc-static initializer: a union field's value is not a link-time constant"))
    0))

;;; The union constant: its bytes as [size x i8], or with pointer relocations a
;;; packed literal of byte runs and pointers (see cg-const-struct).
(defn cg-image-constant [(cg (ptr Cg)) (img (ptr CgImage))] (-> (ptr i8))
  (let [a (.a cg)
        i8t (LLVMInt8TypeInContext (cg-ctx cg))
        size (len (.bytes img))
        (mut parts) (ArrayList::new [(ptr i8)] a)
        (mut run) (ArrayList::new [(ptr i8)] a)
        (mut k) 0]
    (loop (if (>= k size)
              (break)
              (let [b (get (.bytes img) k)]
                (if (>= b 0)
                    (do
                      (push! (mut run) (LLVMConstInt i8t (if (< b 0) 0 b) 0))
                      (set! k (+ k 1)))
                    (do
                      (unless (= (len run) 0)
                        (push! (mut parts)
                               (LLVMConstArray2 i8t
                                                (carr a (load run))
                                                (len run)))
                        (set! (.len run) 0))
                      (let [(mut found) (primitive/cast (ptr i8) 0)]
                        (for [r 0 (len (.relocs img))]
                          (when (= (.off (get (.relocs img) r)) k)
                            (set! found (.value (get (.relocs img) r)))))
                        (push! (mut parts) found))
                      (set! k (+ k 8)))))))
    (if (= (len (.relocs img)) 0)
        (LLVMConstArray2 i8t (carr a (load run)) (len run))
        (do
          (unless (= (len run) 0)
            (push! (mut parts)
                   (LLVMConstArray2 i8t (carr a (load run)) (len run))))
          (LLVMConstStructInContext (cg-ctx cg)
                                    (carr a (load parts))
                                    (primitive/cast i32 (len parts))
                                    1)))))

; Explicit records normally lower to a packed sequence of typed fields and byte
; padding.  Build the initializer in physical-offset order while taking values
; from the constructor's declaration-order stores.  A union (fields sharing an
; offset) lowers to one byte blob, so its initial value is a byte image written
; in declaration order (cg-image-write!).
(defn cg-static-explicit-body [(cg (ptr Cg))
                               (base (ptr i8))
                               (fields (ptr (ArrayList Field)))
                               (offs (ptr (ArrayList i64)))
                               (body (ptr (ArrayList Expr)))] (-> (ptr i8))
  (if (cg-explicit-union? offs)
      (cg-static-union-body cg base fields offs body)
      (cg-static-explicit-fields cg base fields offs body)))

(defn cg-explicit-union? [(offs (ptr (ArrayList i64)))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (len (load offs))]
      (for [j 0 i]
        (when (= (get (load offs) i) (get (load offs) j)) (set! found true))))
    found))

(defn cg-static-union-body [(cg (ptr Cg))
                            (base (ptr i8))
                            (fields (ptr (ArrayList Field)))
                            (offs (ptr (ArrayList i64)))
                            (body (ptr (ArrayList Expr)))] (-> (ptr i8))
  (let [a (.a cg)
        size (LLVMABISizeOfType (load (field cg td)) (LLVMTypeOf base))
        (mut img) (CgImage :bytes (ArrayList::new [i64] a) :relocs (ArrayList::new [CgReloc] a))]
    (for [k 0 size] (push! (mut (.bytes img)) 0))
    (let [given (cg-static-field-values cg fields body)]
      ; Fields are written in declaration order, so a later field overlapping an
      ; earlier one wins, whatever order the initializer named them in.
      (for [i 0 (len (load fields))]
        (let [value (get given i)]
          (unless (= (primitive/cast i64 value) 0)
            (cg-image-write! cg (mut img) (get (load offs) i)
                             (cg-static-constant cg (field (elem fields i) ty) value))
            0))))
    (cg-image-constant cg (mut img))))

(defn cg-static-explicit-fields [(cg (ptr Cg))
                                 (base (ptr i8))
                                 (fields (ptr (ArrayList Field)))
                                 (offs (ptr (ArrayList i64)))
                                 (body (ptr (ArrayList Expr)))] (-> (ptr i8))
  (let [a (.a cg)
        bt (LLVMTypeOf base)
        n (len (load fields))
        total-size
          (primitive/cast i64 (LLVMABISizeOfType (load (field cg td)) bt))
        (mut used) (ArrayList::new [i64] a)
        (mut values) (ArrayList::new [(ptr i8)] a)
        given (cg-static-field-values cg fields body)
        (mut i) 0
        (mut cursor) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (push! (mut used) 0) (set! i (primitive/iadd (load i) 1)))))
    (set! i 0)
    (loop (if (>= (load i) n)
              (break)
              (let [(mut best) -1
                    (mut best-off) 9223372036854775807
                    (mut j) 0]
                (loop (if (>= (load j) n)
                          (break)
                          (do
                            (when (and (= (get (load used) (load j)) 0)
                                       (< (get (load offs) (load j))
                                          (load best-off)))
                              (set! best (load j))
                              (set! best-off (get (load offs) (load j))))
                            (set! j (primitive/iadd (load j) 1)))))
                (when (< (load best) 0)
                  (cg-static-fail "alloc-static initializer: explicit layout ordering failed")
                  0)
                (when (> (load best-off) (load cursor))
                  (push! (mut values)
                         (LLVMConstNull (LLVMArrayType2 (LLVMInt8TypeInContext (cg-ctx cg))
                                                        (primitive/isub (load best-off)
                                                                        (load cursor))))))
                (let [fty (field (elem fields (load best)) ty)
                      value (get given (load best))]
                  (push! (mut values)
                         (if (= (primitive/cast i64 value) 0)
                             (LLVMConstNull (basic-ty cg fty))
                             (cg-static-constant cg fty value))))
                (set! cursor
                      (primitive/iadd (load best-off)
                                      (primitive/cast i64
                                                      (LLVMABISizeOfType (load (field cg
                                                                                      td))
                                                                         (basic-ty cg
                                                                                   (field (elem fields
                                                                                                (load best))
                                                                                          ty))))))
                (set! (mut used) (load best) 1)
                (set! i (primitive/iadd (load i) 1)))))
    (when (< (load cursor) total-size)
      (push! (mut values)
             (LLVMConstNull (LLVMArrayType2 (LLVMInt8TypeInContext (cg-ctx cg))
                                            (primitive/isub total-size
                                                            (load cursor))))))
    (if (!= (len (load values))
            (primitive/cast i64 (LLVMCountStructElementTypes bt)))
        (cg-static-fail "alloc-static initializer: explicit layout ordering failed")
        (cg-const-struct cg bt (mut values)))))

(defn cg-static-array-body [(cg (ptr Cg))
                            (base (ptr i8))
                            (elem-ty (ptr Type))
                            (count i64)
                            (body (ptr (ArrayList Expr)))] (-> (ptr i8))
  (let [n (len (load body))
        (mut given) (ArrayList::new [(ptr Expr)] (.a cg))
        (mut values) (ArrayList::new [(ptr i8)] (.a cg))]
    (for [i 0 count] (push! (mut given) (primitive/cast (ptr Expr) 0)))
    ; Each store names its element's index; an element none names is zero.
    (for [i 0 n]
      (let [item (elem body i)
            place (static-store-place item)]
        (if (= (primitive/cast i64 place) 0)
            (unless (static-body-result? body i)
              (cg-static-fail "alloc-static initializer: expected a materialized array")
              0)
            (match (.kind place)
              (EIndex [_ index]
                      (match (.kind index)
                        (EInt [k]
                              (if (or (< k 0) (>= k count))
                                  (cg-static-fail "alloc-static initializer: array index is out of bounds")
                                  (set! (mut given) k (static-store-value item)))
                              0)
                        (_ (do (cg-static-fail "alloc-static initializer: array index is not constant") 0))))
              (_ (do (cg-static-fail "alloc-static initializer: a store that is not to an element of the array") 0))))
        0))
    (for [i 0 count]
      (let [value (get given i)]
        (push! (mut values)
               (if (= (primitive/cast i64 value) 0)
                   (LLVMConstNull (basic-ty cg elem-ty))
                   (cg-static-constant cg elem-ty value)))))
    (cg-const-array cg (basic-ty cg elem-ty) (mut values))))

; The physical initializer may be segmented, but its size/alignment and every
; indexed address obey the logical array type. Opaque LLVM pointers let the
; global use the compact physical type without changing the source ABI.
(defn cg-static-sparse-array [(cg (ptr Cg))
                              (t (ptr Type))
                              (indices (ptr (ArrayList i64)))
                              (items (ptr (ArrayList Expr)))] (-> (ptr i8))
  (match (load t)
    (TArray [elem-ty count-extent]
            (let [count (extent-value count-extent)]
              (let [(mut parts) (ArrayList::new [(ptr i8)] (.a cg))
                    (mut next) 0
                    bt (basic-ty cg elem-ty)]
                (for [i 0 (len (load items))]
                  (let [index (get (load indices) i)]
                    (when (> index (load next))
                      (push! (mut parts)
                             (LLVMConstNull (LLVMArrayType2 bt
                                                            (- index
                                                               (load next)))))
                      0)
                    (push! (mut parts)
                           (cg-static-constant cg elem-ty (elem items i)))
                    (set! next (+ index 1)))
                  0)
                (when (< (load next) count)
                  (push! (mut parts)
                         (LLVMConstNull (LLVMArrayType2 bt
                                                        (- count (load next)))))
                  0)
                (LLVMConstStructInContext (cg-ctx cg)
                                          (carr (.a cg) (load parts))
                                          (primitive/cast i32
                                                          (len (load parts)))
                                          1))))
    (_ (cg-static-fail "static :elements requires an array allocation"))))

(defn cg-static-storage! [(cg (ptr Cg))
                          (t (ptr Type))
                          (init (ptr Expr))
                          (name (slice u8))] (-> (ptr i8))
  (let [value
          (if (= (primitive/cast i64 init) 0)
              (LLVMConstNull (basic-ty cg t))
              (cg-static-constant cg t init))
        physical (LLVMTypeOf value)]
    (unless (= (LLVMABISizeOfType (.td cg) physical) (cg-layout-size cg t))
      (let [shown (LLVMPrintTypeToString physical)]
        (ps (stderr) (from-cstr shown))
        (wb (stderr) 10)
        (LLVMDisposeMessage shown)
        0)
      (cg-static-fail (sconcat (.a cg)
                               "static initializer physical size differs from its logical type: "
                               (sconcat (.a cg)
                                        name
                                        (sconcat (.a cg)
                                                 " (physical "
                                                 (sconcat (.a cg)
                                                          (i64->str (.a cg)
                                                                    (LLVMABISizeOfType (.td cg)
                                                                                       physical))
                                                          (sconcat (.a cg)
                                                                   ", logical "
                                                                   (sconcat (.a cg)
                                                                            (i64->str (.a cg)
                                                                                      (cg-layout-size cg
                                                                                                      t))
                                                                            ")")))))))
      0)
    (let [cname (to-cstr (.a cg) name)
          prior (LLVMGetNamedGlobal (.module cg) cname)
          function (LLVMGetNamedFunction (.module cg) cname)]
      (unless (= (primitive/cast i64 function) 0)
        (cg-static-fail (sconcat (.a cg)
                                 "static storage conflicts with function symbol: "
                                 name))
        0)
      (unless (= (primitive/cast i64 prior) 0)
        (unless (= (primitive/cast i64 (LLVMGetInitializer prior)) 0)
          (cg-static-fail (sconcat (.a cg)
                                   "duplicate static storage symbol: "
                                   name))
          0)
        ; linker-address may have introduced an untyped declaration. Its i8
        ; placeholder is not the allocation's physical type (sparse arrays can
        ; use a packed aggregate), so replace the declaration and all its uses.
        ; Release its name first: LLVM otherwise silently suffixes the definition.
        (LLVMSetValueName2 prior c"" 0)
        0)
      (let [g (LLVMAddGlobal (.module cg) physical cname)]
        (unless (= (primitive/cast i64 prior) 0)
          (LLVMReplaceAllUsesWith prior g)
          (LLVMDeleteGlobal prior)
          0)
        (LLVMSetInitializer g value)
        (LLVMSetAlignment g (primitive/cast i32 (cg-layout-align cg t)))
        g))))

;;; A pointer-typed static written as an integer, possibly through further
;;; casts: `(cast (ptr T) (cast (ptr i8) ADDR))` is the absolute address ADDR.
(defn cg-static-address [(cg (ptr Cg)) (bt (ptr i8)) (e (ptr Expr))] (-> (ptr i8))
  (match (.kind e)
    (EInt [n]
          (if (= n 0)
              (LLVMConstNull bt)
              (LLVMConstIntToPtr (LLVMConstInt (LLVMInt64TypeInContext (load (field cg ctx))) n 0) bt)))
    (ECast [_ inner] (cg-static-address cg bt inner))
    (_ (cg-static-fail "alloc-static initializer: pointer cast is not a link-time constant"))))

(defn cg-static-constant [(cg (ptr Cg)) (t (ptr Type)) (e (ptr Expr))] (-> (ptr i8))
  (let [bt (basic-ty cg t)]
    (match (.kind e)
      (EInt [n] (LLVMConstInt bt n 1))
      (EWideInt [_ lo hi _ _] (cg-wide-const cg bt lo hi))
      (EBool [v] (LLVMConstInt bt (when v 1) 0))
      (EFloat [bits] (LLVMConstReal bt (bits->f64 bits)))
      (ECStr [s] (cg-static-cstr cg s))
      ; A string literal is a (slice u8): a pointer to NUL-terminated static bytes
      ; and their length, exactly as an expression-position literal lowers.
      (EStr [s]
            (let [(mut parts) (ArrayList::new [(ptr i8)] (.a cg))]
              (push! (mut parts) (cg-static-cstr cg s))
              (push! (mut parts) (LLVMConstInt (cg-i64t cg) (len s) 0))
              (LLVMConstStructInContext (cg-ctx cg)
                                        (carr (.a cg) (load parts))
                                        2
                                        0)))
      (EConstruct [sum variant args] (cg-static-construct cg sum variant args))
      (EBin [_ _ _]
            (LLVMConstInt bt
                          (const-eval cg e)
                          (when (cev-u (const-eval-t cg e)) 0)))
      (ECmp [_ _ _] (LLVMConstInt bt (const-eval cg e) 0))
      (EIf [_ _ _] (LLVMConstInt bt (const-eval cg e) 0))
      (ESizeOf [_] (LLVMConstInt bt (const-eval cg e) 0))
      (EAlignOf [_] (LLVMConstInt bt (const-eval cg e) 0))
      (EOffsetOf [_ _] (LLVMConstInt bt (const-eval cg e) 0))
      (EZeroed [_] (LLVMConstNull bt))
      (ERecordInit [_] (LLVMConstNull bt))
      (EStaticArray [indices items] (cg-static-sparse-array cg t indices items))
      ; A slice: a pointer to the nested static it borrows, and its length.
      (EMakeSlice [data elem len]
                  (let [(mut parts) (ArrayList::new [(ptr i8)] (.a cg))]
                    (push! (mut parts)
                           (cg-static-constant cg
                                               (box-type (.a cg)
                                                         (TPtr (box-type (.a cg)
                                                                         elem)))
                                               data))
                    (push! (mut parts)
                           (LLVMConstInt (cg-i64t cg) (extent-value len) 0))
                    (LLVMConstStructInContext (cg-ctx cg)
                                              (carr (.a cg) (load parts))
                                              2
                                              0)))
      (EFnPtrOf [name]
                (let [f (cg-fnptr-value cg name)]
                  (if (= (primitive/cast i64 f) 0)
                      (cg-static-fail (sconcat (.a cg)
                                               "alloc-static initializer: unknown function "
                                               name))
                      f)))
      (EAlloc [storage ty init symbol]
              (if (!= storage 1)
                  (cg-static-fail "def initializer: only alloc-static storage is a link-time constant")
                  (let [n (.nstatic cg)
                        _next (set! (.nstatic cg) (primitive/iadd n 1))
                        et (box-type (.a cg) ty)
                        storage-name
                          (match symbol
                            (Some [name] name)
                            (None []
                                  (sconcat (.a cg)
                                           "repl_static.def."
                                           (sconcat (.a cg)
                                                    (.static_owner cg)
                                                    (sconcat (.a cg)
                                                             "."
                                                             (i64->str (.a cg)
                                                                       n))))))
                        g (cg-static-storage! cg et init storage-name)]
                    g)))
      (ECast [_ inner]
             (match (load t)
               (TPtr [_] (cg-static-address cg bt inner))
               (TFn [_ _ _]
                    (match (.kind inner)
                      (EFnPtrOf [_] (cg-static-constant cg t inner))
                      (_ (cg-static-address cg bt inner))))
               (_ (cg-static-constant cg t inner))))
      ; Aggregate construction synthesizes a temporary place and then loads its
      ; value. Static lowering reads the constructor body directly to build the
      ; constant aggregate; no runtime load is emitted.
      (ELoad [inner] (cg-static-constant cg t inner))
      (ELet [_ body]
            (match (load t)
              (TStruct [name]
                       (let [si (cg-struct-idx cg name)]
                         (if (< si 0)
                             (cg-static-fail "alloc-static initializer: unknown struct type")
                             (let [sp (elem (field cg structs) si)]
                               (match (.layout sp)
                                 (LBits [_ _]
                                        (cg-static-fail "alloc-static initializer: bit structs are not supported"))
                                 (LExplicit [offs _ _]
                                            (cg-static-explicit-body cg
                                                                     (LLVMConstNull bt)
                                                                     (load (field sp
                                                                                  fields))
                                                                     offs
                                                                     body))
                                 (_ (cg-static-aggregate-body cg
                                                              (LLVMConstNull bt)
                                                              (load (field sp
                                                                           fields))
                                                              body)))))))
              (TArray [elem count-extent]
                      (let [count (extent-value count-extent)]
                        (cg-static-array-body cg
                                              (LLVMConstNull bt)
                                              elem
                                              count
                                              body)))
              (_ (cg-static-fail "alloc-static initializer: materialized aggregate has the wrong type"))))
      (_ (cg-static-fail-in cg "initializer is not a link-time constant")))))

(defn cg-declare-statics [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [cs (load (field p consts))]
    (for [i 0 (len (load cs))]
      (let [cp (elem cs i)]
        (when (.runtime cp)
          (match (.ty cp)
            (None []
                  (do (cg-static-fail "internal: checked def has no type") 0))
            (Some [ty]
                  (let [tp (box-type (.a cg) ty)
                        (mut st) (zeroed CgStatic)]
                    (set! (.static_owner cg)
                          (match ty
                            (TStruct [tn]
                                     (sconcat (.a cg)
                                              (.name cp)
                                              (sconcat (.a cg) "." tn)))
                            (_ (.name cp))))
                    (set! (.static_context cg)
                          (sconcat (.a cg) "def " (.name cp)))
                    (set! (.nstatic cg) 0)
                    (if (.declared cp)
                        ; Another unit defines this storage: declare the global, give it
                        ; no initializer, and let the linker resolve it.
                        (let [g
                                (LLVMAddGlobal (load (field cg module))
                                               (basic-ty cg tp)
                                               (to-cstr (.a cg)
                                                        (sconcat (.a cg)
                                                                 "coil_def."
                                                                 (.name cp))))]
                          (LLVMSetGlobalConstant g 1)
                          (LLVMSetAlignment g
                                            (primitive/cast i32
                                                            (cg-layout-align cg
                                                                             tp)))
                          (set! (.ptr st)
                                g))
                        ; The constant decides the global's physical type (a sum constant
                        ; is a packed tag+payload literal, not the sum's nominal type);
                        ; size and alignment still come from the logical type.
                        (let [value (cg-static-constant cg tp (field cp value))
                              g
                                (LLVMAddGlobal (load (field cg module))
                                               (LLVMTypeOf value)
                                               (to-cstr (.a cg)
                                                        (sconcat (.a cg)
                                                                 "coil_def."
                                                                 (.name cp))))]
                          (unless (= (LLVMABISizeOfType (.td cg)
                                                        (LLVMTypeOf value))
                                     (cg-layout-size cg tp))
                            (cg-static-fail-in cg
                                               "initializer size differs from its type")
                            0)
                          (LLVMSetInitializer g value)
                          ; A def is never assigned (a mutable global is a Var, whose
                          ; cell is its own alloc-static global), so its storage is
                          ; constant and loads from it fold, e.g. an MMIO address.
                          (LLVMSetGlobalConstant g 1)
                          (LLVMSetAlignment g
                                            (primitive/cast i32
                                                            (cg-layout-align cg
                                                                             tp)))
                          ; A unit object exposes only the storage it publishes; a
                          ; def of a module it embeds is its private copy, so a
                          ; consumer that compiles that module too does not collide.
                          (when (and (.unit_build cg)
                                     (not (cg-unit-export? p (.name cp))))
                            (LLVMSetLinkage g 8)  ; internal
                            0)
                          (set! (.ptr st)
                                g)))
                    (set! (.static_context cg) "")
                    (set! (.name st)
                          (.name cp))
                    (set! (.ty st)
                          ty)
                    (push! (mut (.statics cg))
                           st)
                    0)))
          0)))
    0))

(defn emit-alloc [(cg (ptr Cg))
                  (storage i64)
                  (t (ptr Type))
                  (init (ptr Expr))
                  (symbol (Option (slice u8)))] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        bt (basic-ty cg t)
        fa (cg-force-align cg t)]
    (if (or (= storage 0)
            (= storage 3))
        (let [p
                (if (= storage 3)
                    (let [cur (cg-cur-block cg)
                          entry
                            (LLVMGetEntryBasicBlock (LLVMGetBasicBlockParent cur))]
                      ; Preserve the existing instruction order when the implicit
                      ; place is already in entry; only loop/branch-local sites need
                      ; to be moved out of their dynamic control-flow position.
                      (if (= (primitive/cast i64 cur)
                             (primitive/cast i64 entry))
                          (LLVMBuildAlloca b bt (cg-bl cg "stack.slot"))
                          (cg-entry-alloca cg bt (cg-bl cg "stack.slot"))))
                    (LLVMBuildAlloca b bt (cg-bl cg "stack.slot")))]
          (when (> fa 0)
            (LLVMSetAlignment p (primitive/cast i32 fa))
            0)
          (mk-tv p (TPtr (box-type a (load t)))))
        (if (= storage 2)
            (mk-tv (LLVMBuildMalloc b bt (cg-bl cg "heap.box"))
                   (TPtr (box-type a (load t))))
            (let [_global-seq (cg-next-global cg)
                  n (.nstatic cg)
                  _next-static (set! (.nstatic cg) (primitive/iadd n 1))
                  function-name
                    (from-cstr (LLVMGetValueName (cg-cur-func cg)))
                  ; A recognizable, deterministic name lets incremental JIT backends
                  ; map this generation's alloc-static cell onto its prior address.
                  storage-name
                    (match symbol
                      (Some [name] name)
                      (None []
                            (sconcat a
                                     "repl_static."
                                     (sconcat a
                                              function-name
                                              (sconcat a "." (i64->str a n))))))
                  g (cg-static-storage! cg t init storage-name)]
              (when (> fa 0)
                (LLVMSetAlignment g (primitive/cast i32 fa))
                0)
              ; See Cg.spec_names: a cell inside a generic instantiation is one
              ; per program, merged across units by the linker. An explicitly
              ; named cell is public storage and keeps its ordinary linkage.
              ; weak_odr rather than linkonce_odr: a partitioned build keeps the
              ; definition in one object and references it from others, and
              ; linkonce lets the optimizer drop a definition nothing in its own
              ; object uses.
              (cond ; A cell inside a generic instantiation is one per program: every
                    ; unit that instantiates the generic defines it weak, the linker
                    ; keeps one -- so it is shared across the boundary between a unit
                    ; and its consumer too.
                    (and (match symbol (Some [_] false) (None [] true))
                         (contains? (.spec_names cg)
                                    function-name))
                      (do (LLVMSetLinkage g 6) 0)  ; weak_odr
                    ; A concrete cell in a unit object is private to the unit: the
                    ; consumer calls the unit's declared functions, which carry their
                    ; own state; the consumer's own copy of an embedded module has its
                    ; own cell. Internal, so the two do not collide.
                    (and (.unit_build cg)
                         (match symbol (Some [_] false) (None [] true)))
                      (do (LLVMSetLinkage g 8) 0)  ; internal
                    ; A cell belongs to the function that owns it. When that function
                    ; is internal -- every non-exported function of a program or of a
                    ; `--lib` archive -- the cell is internal too; left external, a
                    ; library's copy of a stdlib cell collided with the program's own
                    ; (`duplicate symbol '_repl_static.coil.io.stdout.0'`).
                    (and (match symbol (Some [_] false) (None [] true))
                         (= (cast i64 (LLVMGetLinkage (cg-cur-func cg))) 8))
                      (do (LLVMSetLinkage g 8) 0)  ; internal
                    :else 0)
              (mk-tv g (TPtr (box-type a (load t)))))))))

; ======================== emit_if / loop / break / continue ==================
;; One arm of an `if` or `match`. With a destination the arm writes its value
;; there and yields nothing, so the merge needs no phi.
(defn emit-branch [(cg (ptr Cg)) (e (ptr Expr)) (scp (ptr Scope)) (dest Dest)] (-> Tv)
  (if (has-dest? dest)
      (do
        (emit-into cg e dest scp)
        (mk-tv (cg-zero-i64 cg) (TVoid)))
      (emit-expr cg e scp)))

(defn emit-if [(cg (ptr Cg))
               (cnd (ptr Expr))
               (thn (ptr Expr))
               (els (ptr Expr))
               (scp (ptr Scope))
               (dest Dest)] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        func (cg-cur-func cg)
        cv (emit-expr cg cnd scp)
        c (tv-val cv)
        cmp (LLVMBuildICmp b 33 c (cg-zero (LLVMTypeOf c)) (cg-bl cg "ifc"))
        then-bb (cg-append cg func (cg-bl cg "then"))
        else-bb (cg-append cg func (cg-bl cg "else"))]
    (LLVMBuildCondBr b cmp then-bb else-bb)
    (cg-pos cg then-bb)
    (let [tv (emit-branch cg thn scp dest)
          then-end (cg-cur-block cg)
          then-div
            (!= (primitive/cast i64 (LLVMGetBasicBlockTerminator then-end))
                0)]
      (cg-pos cg else-bb)
      (let [ev (emit-branch cg els scp dest)
            else-end (cg-cur-block cg)
            else-div
              (!= (primitive/cast i64 (LLVMGetBasicBlockTerminator else-end))
                  0)]
        (cond (and (not then-div) (not else-div))
                (let [merge-bb (cg-append cg func (cg-bl cg "ifcont"))]
                  (cg-pos cg then-end)
                  (LLVMBuildBr b merge-bb)
                  (cg-pos cg else-end)
                  (LLVMBuildBr b merge-bb)
                  (cg-pos cg merge-bb)
                  ; A matched-void `if` merges control flow, but has no runtime value
                  ; to merge. LLVM has no void-typed phi, so preserve TVoid with the
                  ; same ignored sentinel used for a direct void call.
                  (if (ty-is-void (box-type a (tv-ty tv)))
                      (mk-tv (cg-zero-i64 cg) (TVoid))
                      (let [phi
                              (LLVMBuildPhi b
                                            (cg-value-ty cg
                                                         (box-type a (tv-ty tv)))
                                            (cg-bl cg "ifval"))
                            (mut vs) (ArrayList::new [(ptr i8)] a)
                            (mut bs) (ArrayList::new [(ptr i8)] a)]
                        (push! (mut vs) (tv-val tv))
                        (push! (mut vs) (tv-val ev))
                        (push! (mut bs) then-end)
                        (push! (mut bs) else-end)
                        (LLVMAddIncoming phi
                                         (carr a (load vs))
                                         (carr a (load bs))
                                         2)
                        (mk-tv phi (tv-ty tv)))))
              (and (not then-div) else-div) (do (cg-pos cg then-end) tv)
              (and then-div (not else-div)) (do (cg-pos cg else-end) ev)
              :else
                (let [dead-bb (cg-append cg func (cg-bl cg "ifcont.dead"))]
                  (cg-pos cg dead-bb)
                  (LLVMBuildUnreachable b)
                  (mk-tv (cg-zero-i64 cg) (tv-ty tv))))))))

(defn emit-loop [(cg (ptr Cg))
                 (label (Option (slice u8)))
                 (body (ptr (ArrayList Expr)))
                 (scp (ptr Scope))] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        func (cg-cur-func cg)
        body-bb (cg-append cg func (cg-bl cg "loop.body"))
        after-bb (cg-append cg func (cg-bl cg "loop.after"))]
    (LLVMBuildBr b body-bb)
    (cg-pos cg body-bb)
    (let [lc (primitive/alloc-stack CgLoop)]
      (set! (.label lc) label)
      (set! (.body_bb lc) body-bb)
      (set! (.after_bb lc) after-bb)
      (set! (.breaks lc) (ArrayList::new [CgBreak] a))
      (set! (.break_ty lc) (None [Type]))
      (push! (mut (.loops cg)) (load lc)))
    (let [n (len (load body))
          (mut i) 0]
      (loop (if (or (>= (load i) n) (cg-terminated cg))
                (break)
                (do
                  (emit-expr cg (elem body (load i)) scp)
                  (set! i (primitive/iadd (load i) 1))))))
    (when (not (cg-terminated cg)) (LLVMBuildBr b body-bb) 0)
    (let [popped
            (match (pop! [CgLoop] (mut (.loops cg)))
              (Some [x] x)
              (None []
                    (do
                      (unimplemented "loop ctx missing")
                      (zeroed CgLoop))))
          lp (primitive/alloc-stack CgLoop)]
      (set! lp popped)
      (cg-pos cg after-bb)
      (let [nb (len (.breaks lp))]
        (if (= nb 0)
            (do
              (LLVMBuildUnreachable b)
              (mk-tv (cg-zero-i64 cg) (TInt 64 true)))
            (let [ty
                    (match (.break_ty lp) (Some [t] t) (None [] (TInt 64 true)))
                  phi
                    (LLVMBuildPhi b
                                  (cg-value-ty cg (box-type a ty))
                                  (cg-bl cg "loop.val"))
                  (mut vs) (ArrayList::new [(ptr i8)] a)
                  (mut bs) (ArrayList::new [(ptr i8)] a)
                  (mut i) 0]
              (loop (if (>= (load i) nb)
                        (break)
                        (do
                          (let [bp
                                  (elem (field lp breaks) (load i))]
                            (push! (mut vs) (load (field bp val)))
                            (push! (mut bs) (load (field bp bb))))
                          (set! i (primitive/iadd (load i) 1)))))
              (LLVMAddIncoming phi
                               (carr a (load vs))
                               (carr a (load bs))
                               (primitive/cast i32 nb))
              (mk-tv phi ty)))))))

(defn cg-loop-index [(cg (ptr Cg)) (label (Option (slice u8)))] (-> i64)
  (let [n (len (.loops cg))]
    (match label
      (Some [l]
            (let [(mut r) -1
                  (mut i) 0]
              (loop (if (>= (load i) n)
                        (break)
                        (do
                          (match (.label (elem (field cg loops)
                                               (load i)))
                            (Some [ll] (when (= ll l) (set! r (load i))))
                            (None [] 0))
                          (set! i (primitive/iadd (load i) 1)))))
              (if (< (load r) 0)
                  (do
                    (unimplemented "codegen: break/continue to unknown loop label")
                    -1)
                  (load r))))
      (None []
            (if (= n 0)
                (do
                  (unimplemented "codegen: break/continue outside of a loop")
                  -1)
                (primitive/isub n 1))))))

(defn emit-break [(cg (ptr Cg))
                  (label (Option (slice u8)))
                  (value (Option (ptr Expr)))
                  (scp (ptr Scope))] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        vtv
          (match value
            (Some [e] (emit-expr cg e scp))
            (None [] (mk-tv (cg-zero-i64 cg) (TInt 64 true))))]
    (if (cg-terminated cg)
        (mk-tv (cg-zero-i64 cg) (TInt 64 true))
        (let [pred (cg-cur-block cg)
              idx (cg-loop-index cg label)
              lp (elem (field cg loops) idx)
              (mut site) (zeroed CgBreak)]
          (set! (.val site) (tv-val vtv))
          (set! (.bb site) pred)
          (push! (mut (.breaks lp)) site)
          (match (.break_ty lp)
            (Some [x] 0)
            (None [] (do (set! (.break_ty lp) (Some [Type] (tv-ty vtv))) 0)))
          (LLVMBuildBr b (load (field lp after_bb)))
          (mk-tv (cg-zero-i64 cg) (TInt 64 true))))))

(defn emit-continue [(cg (ptr Cg)) (label (Option (slice u8)))] (-> Tv)
  (let [b (cg-bld cg)
        idx (cg-loop-index cg label)
        lp (elem (field cg loops) idx)]
    (LLVMBuildBr b (load (field lp body_bb)))
    (mk-tv (cg-zero-i64 cg) (TInt 64 true))))

; ======================== bit access (BitGet/BitSet) =========================
(defstruct BitAcc
  [(pv (ptr i8)) (off i64) (width i64) (signed bool) (backing i64)])

(defn bit-access [(cg (ptr Cg))
                  (pe (ptr Expr))
                  (fname (slice u8))
                  (scp (ptr Scope))] (-> BitAcc)
  (let [a (.a cg)
        pv (emit-expr cg pe scp)
        sname
          (match (tv-ty pv)
            (TPtr [p2]
                  (match (load p2)
                    (TStruct [s] s)
                    (_ (cg-bug-sl "bit access on non-struct"))))
            (_ (cg-bug-sl "bit access on non-pointer")))
        si (cg-struct-idx cg sname)
        sp (elem (field cg structs) si)
        fs (load (field sp fields))
        nf (len (load fs))
        (mut idx) -1
        (mut i) 0
        (mut r) (zeroed BitAcc)]
    (loop (if (>= (load i) nf)
              (break)
              (do
                (when (= (.name (elem fs (load i)))
                         fname)
                  (set! idx (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (set! (.pv r) (tv-val pv))
    (set! (.width r)
          (match (.ty (elem fs (load idx)))
            (TInt [w s] (do (set! (.signed r) s) w))
            (TFloat [_] (do (unimplemented "bitfield not int") 0))
            (TBool [] (do (unimplemented "bitfield not int") 0))
            (TVoid [] (do (unimplemented "bitfield not int") 0))
            (TPtr [_] (do (unimplemented "bitfield not int") 0))
            (TRef [_ _] (do (unimplemented "bitfield not int") 0))
            (TStruct [_] (do (unimplemented "bitfield not int") 0))
            (TArray [_ _] (do (unimplemented "bitfield not int") 0))
            (TSlice [_] (do (unimplemented "bitfield not int") 0))
            (TVec [_ _] (do (unimplemented "bitfield not int") 0))
            (TConst [_] (do (unimplemented "bitfield not int") 0))
            (TFn [_ _ _] (do (unimplemented "bitfield not int") 0))
            (TApp [_ _] (do (unimplemented "bitfield not int") 0))
            (TNever [] (do (unimplemented "bitfield not int") 0))
            (TError [] (do (unimplemented "bitfield not int") 0))
            (TCode [] (do (unimplemented "bitfield not int") 0))
            (TCodeBuilder [] (do (unimplemented "bitfield not int") 0))
            (TExternRef [] (do (unimplemented "bitfield not int") 0))))
    (match (.layout sp)
      (LBits [backing offs]
             (do
               (set! (.backing r) backing)
               (set! (.off r) (get (load offs) (load idx)))))
      (_ (do (unimplemented "codegen: not a bit struct") 0)))
    r))

(defn emit-bitget [(cg (ptr Cg))
                   (pe (ptr Expr))
                   (fname (slice u8))
                   (scp (ptr Scope))] (-> Tv)
  (let [b (cg-bld cg)
        ctx (cg-ctx cg)
        ba (primitive/alloc-stack BitAcc)]
    (set! ba (bit-access cg pe fname scp))
    (let [backing-ty (int-width ctx (.backing ba))
          loaded
            (LLVMBuildLoad2 b backing-ty (load (field ba pv)) (cg-bl cg "bits"))
          off (.off ba)
          width (.width ba)
          shifted
            (if (> off 0)
                (LLVMBuildLShr b
                               loaded
                               (LLVMConstInt backing-ty off 0)
                               (cg-bl cg "shr"))
                loaded)
          field-ty (int-width ctx width)
          res
            (if (< width (.backing ba))
                (LLVMBuildTrunc b shifted field-ty (cg-bl cg "bget"))
                shifted)]
      (mk-tv res (TInt width (.signed ba))))))

(defn emit-bitset [(cg (ptr Cg))
                   (pe (ptr Expr))
                   (fname (slice u8))
                   (val (ptr Expr))
                   (scp (ptr Scope))] (-> Tv)
  (let [b (cg-bld cg)
        ctx (cg-ctx cg)
        ba (primitive/alloc-stack BitAcc)]
    (set! ba (bit-access cg pe fname scp))
    (let [vv (emit-expr cg val scp)
          backing (.backing ba)
          off (.off ba)
          width (.width ba)
          backing-ty (int-width ctx backing)
          loaded
            (LLVMBuildLoad2 b backing-ty (load (field ba pv)) (cg-bl cg "bits"))
          field-mask (<< (primitive/isub (<< 1 width) 1) off)
          clear (LLVMConstInt backing-ty (^ field-mask -1) 0)
          cleared (LLVMBuildAnd b loaded clear (cg-bl cg "clear"))
          vext
            (if (< width backing)
                (LLVMBuildZExt b (tv-val vv) backing-ty (cg-bl cg "vext"))
                (tv-val vv))
          vshift
            (if (> off 0)
                (LLVMBuildShl b
                              vext
                              (LLVMConstInt backing-ty off 0)
                              (cg-bl cg "vshl"))
                vext)
          newval (LLVMBuildOr b cleared vshift (cg-bl cg "set"))]
      (LLVMBuildStore b newval (load (field ba pv)))
      (mk-tv (tv-val vv) (TInt width (.signed ba))))))

; ======================== fnptr-of / call-ptr / llvm-ir ======================
(defn cg-fnptr-export [(cg (ptr Cg)) (name (slice u8))] (-> (ptr ExportC))
  (let [es (load (field cg exports))
        n (len (load es))
        (mut i) 0
        (mut found) (primitive/cast (ptr ExportC) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (elem es (load i))]
                  (when (= (.name ep) name)
                    (set! found ep)
                    (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

(defn cg-fnptr-value [(cg (ptr Cg)) (name (slice u8))] (-> (ptr i8))
  (let [a (.a cg)
        internal (cg-func cg name)
        ep (cg-fnptr-export cg name)]
    (if (and (!= (primitive/cast i64 ep) 0)
             (export-c-needs-thunk? ep))
        (let [sym (match (.symbol ep) (Some [s] s) (None [] ""))]
          (LLVMGetNamedFunction (load (field cg module)) (to-cstr a sym)))
        internal)))

(defn emit-fnptr [(cg (ptr Cg)) (name (slice u8))] (-> Tv)
  (let [a (.a cg)
        ; An exported aggregate callback has two entries: the Coil reference-model
        ; function and its public by-value C ABI thunk. A `fnptr c` must name the
        ; latter. Thunks are declared/emitted before bodies so it is available here.
        fv (cg-fnptr-value cg name)]
    (if (= (primitive/cast i64 fv) 0)
        (cg-bug (sconcat a "codegen: fnptr-of unknown " name))
        (let [si (cg-sig-idx cg name)]
          (if (< si 0)
              (cg-bug (sconcat a "codegen: no signature for " name))
              (let [sp (elem (field cg sigs) si)
                    ep (cg-fnptr-export cg name)]
                ; The thunk's own C signature: a call through this pointer
                ; passes the aggregates by value, as the thunk receives them.
                (mk-tv fv
                       (TFn
                         :cc (CcResolved (.cc sp))
                         :params
                           (if (and (!= (primitive/cast i64 ep)
                                        0)
                                    (export-c-needs-thunk? ep))
                               (load (field ep params))
                               (load (field sp params)))
                         :ret
                           (box-type a
                                     (.ret sp))))))))))

; An indirect call through a `(fnptr cc …)`.
;
; ⚠ A `c` fnptr must go through the SAME C-ABI lowering a direct extern gets. It
; used to build a plain call from the declared parameter types, so a by-value
; struct was passed as the raw LLVM aggregate while the callee — declared with the
; C-lowered signature — expected packed i64 slots. Structs of 16 and 32 bytes
; happened to agree; 4- and 8-byte ones arrived corrupt, silently
; (docs/archive/BUG_CALLPTR_C_ABI.md). c-signature takes params/ret directly rather than a
; callee name, so the indirect case can use it with no registry entry.
;
;;; The LLVM calling-convention id of the convention named NAME in a signature
;;; or fnptr type, from its declaration; -1 for a `:shim` convention, which has
;;; none.
(defn cg-cc-id [(cg (ptr Cg)) (name (slice u8))] (-> i64)
  (let [conv (cg-prog-conv-in (.conventions cg) name)]
    (when (= (primitive/cast i64 conv) 0)
      (panic "codegen: convention '{}' is not declared" name))
    (conv-native-id conv)))

(defn emit-callptr [(cg (ptr Cg))
                    (fp (ptr Expr))
                    (args (ptr (ArrayList Expr)))
                    (scp (ptr Scope))
                    (dest Dest)] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        fpv (emit-expr cg fp scp)
        cc-params-ret
          (match (tv-ty fpv)
            (TFn [c p r] (mk-fnsig (cc-identity c) p r))
            (_ (do
                 (unimplemented "codegen: call-ptr on non-fnptr")
                 (mk-fnsig ""
                           (box-al [Type] a (ArrayList::new [Type] a))
                           (box-type a (TInt 64 true))))))
        params (fnsig-params cc-params-ret)
        retp (fnsig-ret cc-params-ret)]
    (cg-validate-pointer! cg
                          (tv-val fpv)
                          "callptr"
                          (if (= (.arch cg) 1) 4 1)
                          true)
    (if (or (= (fnsig-cc cc-params-ret) (c-convention))
            (cg-abi-aggregate? cg retp)
            (ty-list-has-aggregate cg params))
        ; NOT guarded by cg-check-c-abi-types, deliberately. The bug report suggested
        ; it, reasoning that a by-value (slice u8) through a `c` fnptr slips past a
        ; rejection the direct path raises. But `c` is the DEFAULT convention for an
        ; ordinary defn, not a marker of an FFI boundary: driver.coil's whole backend
        ; injection surface is (fnptr (cc/C) [… (slice u8) …] i64) passing Coil to Coil, and
        ; guarding here rejects the compiler's own source. A fnptr cannot tell us
        ; whether its target is a C function or a Coil one — both are `c` — so the
        ; guard has no way to fire only at real boundaries.
        ; The LOWERING below still applies to every `c` fnptr, and that is correct:
        ; fnptr-of hands back the function as declared, and a Coil defn with struct
        ; params IS declared with the C-lowered signature. A slice is unaffected —
        ; c-signature classifies it AAScalar, exactly the type the old path built.
        ; A function of another convention with an aggregate parameter or result
        ; is declared through c-signature too (cg-declare-funcs), so its pointer is
        ; called the same way, in its own convention.
        (let [sig (c-signature cg params retp false)
              ccid
                (if (= (fnsig-cc cc-params-ret) (c-convention))
                    0
                    (cg-cc-id cg (fnsig-cc cc-params-ret)))]
          (emit-c-call-ty cg
                          (tv-val fpv)
                          (load (field sig fn_ty))
                          (primitive/cast i32 (if (>= ccid 0) ccid 0))
                          sig
                          (emit-argtv cg args scp)
                          (load retp)
                          "callptr"
                          dest))
        (let [fnty (cg-fn-type cg params retp)
              vals (reconcile-args cg fnty (emit-vals cg args scp))
              cs
                (LLVMBuildCall2 b
                                fnty
                                (tv-val fpv)
                                (carr a vals)
                                (primitive/cast i32 (len vals))
                                (cg-bl cg "callptr"))]
          ;; An indirect pointer has no callee global to query. Recover the LLVM
          ;; id from another signature carrying the same named convention.
          (let [ccid (cg-cc-id cg (fnsig-cc cc-params-ret))]
            (when (>= ccid 0)
              (LLVMSetInstructionCallConv cs (primitive/cast i32 ccid))
              0))
          (if (ty-is-void retp)
              (mk-tv cs (load retp))
              (cg-deliver cg (cg-tv-of-ssa cg cs (load retp)) dest))))))

(defstruct FnSig
  [(cc (slice u8)) (params (ptr (ArrayList Type))) (ret (ptr Type))])

(defn mk-fnsig [(c (slice u8)) (p (ptr (ArrayList Type))) (r (ptr Type))] (-> FnSig)
  (FnSig
    :cc c
    :params p
    :ret r))

(defn fnsig-params [(s FnSig)] (-> (ptr (ArrayList Type)))
  (let [x (primitive/alloc-stack FnSig)] (set! x s) (load (field x params))))

(defn fnsig-ret [(s FnSig)] (-> (ptr Type))
  (let [x (primitive/alloc-stack FnSig)] (set! x s) (load (field x ret))))

(defn fnsig-cc [(s FnSig)] (-> (slice u8))
  (let [(mut x) (: s FnSig)] (.cc x)))

; A linker symbol's address. The symbol is declared as a byte unless the module
; already names it, as a global or as a function.
(defn emit-linker-address [(cg (ptr Cg)) (result (ptr Type)) (symbol (slice u8))] (-> Tv)
  (let [a (.a cg)
        module (load (field cg module))
        cname (to-cstr a symbol)
        prior (LLVMGetNamedGlobal module cname)
        prior-fn (LLVMGetNamedFunction module cname)
        global
          (cond (!= (primitive/cast i64 prior) 0) prior
                (!= (primitive/cast i64 prior-fn) 0) prior-fn
                :else
                  (LLVMAddGlobal module (LLVMInt8TypeInContext (cg-ctx cg)) cname))]
    (mk-tv global (load result))))

; The architecture a Cg targets, under the name `machine-code` uses for it.
(defn cg-arch-name [(cg (ptr Cg))] (-> (slice u8))
  (cond (= (.arch cg) 0) "x86_64"
        (= (.arch cg) 1) "aarch64"
        (= (.arch cg) 2) "wasm32"
        :else "riscv32"))

; The assembler directives that emit BYTES. Where the object format marks code
; apart from data (ELF's mapping symbols on AArch64 and RISC-V), each instruction
; is an `.inst` or `.insn` of its own, so a disassembler or debugger reads them as
; instructions; x86-64 has no such marking, and its bytes are `.byte`s.
(defn machine-code-directives! [(text (mut (ArrayList u8)))
                                (a (dyn Allocator))
                                (arch (slice u8))
                                (bytes (ArrayList u8))] (-> i64)
  (if (= arch "x86_64")
      (do
        (machine-code-push-text! (mut text) ".byte ")
        (for i (range 0 (len bytes))
          (when (> i 0)
            (push! (mut text) (: 44 u8)))
          (machine-code-push-text! (mut text) (i64->str a (primitive/cast i64 (get bytes i)))))
        0)
      (let [boxed (box-al [u8] a bytes)
            (mut i) 0]
        (while (< (load i) (len bytes))
          (let [size (machine-code-instruction-length arch boxed (load i))]
            (when (> (load i) 0)
              (machine-code-push-text! (mut text) "\n\t"))
            (machine-code-push-text! (mut text) (if (= arch "aarch64") ".inst 0x" ".insn 0x"))
            ; the instruction's bytes are little-endian: write its value most
            ; significant digit first
            (let [(mut k) (- size 1)]
              (while (>= (load k) 0)
                (let [byte (primitive/cast i64 (get bytes (+ (load i) (load k))))]
                  (push! (mut text) (primitive/cast u8 (hexd (& (>> byte 4) 15))))
                  (push! (mut text) (primitive/cast u8 (hexd (& byte 15)))))
                (set! k (- (load k) 1))))
            (set! i (+ (load i) size))))
        0)))

; What a call site holds in place of a call to F: its bytes as directives, for
; machine code its callers inline, else "".
(defn cg-machine-code-inline-asm [(cg (ptr Cg)) (f (ptr Func))] (-> (slice u8))
  (match (func-machine-code f)
    (Some [code]
          (if (func-machine-code-inlined? f)
              (let [a (.a cg)
                    (mut text) (ArrayList::new [u8] a)]
                (machine-code-directives! (mut text)
                                          a
                                          (.arch code)
                                          (load (.bytes code)))
                (slice (load text)))
              ""))
    (None [] "")))

; A machine-code function is a `naked` function: no prologue, its bytes, then
; the target's return unless it never returns. LLVM's assembler carries the
; bytes, so the definition is an ordinary function symbol in the object
; format's text section. A :shim function's Coil-named symbol is this function
; itself; it has no __impl and no trampoline.
(defn emit-machine-code-func [(cg (ptr Cg))
                              (f (ptr Func))
                              (function (ptr i8))
                              (code MachineCodeBody)] (-> i64)
  (let [a (.a cg)
        b (cg-bld cg)
        ctx (cg-ctx cg)
        bytes (load (.bytes code))
        (mut text) (ArrayList::new [u8] a)]
    (match (machine-code-target-error a
                                      (.name f)
                                      (.arch code)
                                      (cg-arch-name cg))
      (Some [message] (cg-bug (sconcat3 a "codegen: " message " (checker bug)")))
      (None [] 0))
    (LLVMAddAttributeAtIndex function (: -1 i32) (cg-enum-attr cg "naked" 0))
    (LLVMAddAttributeAtIndex function (: -1 i32) (cg-enum-attr cg "noinline" 0))
    (machine-code-directives! (mut text) a (.arch code) bytes)
    (when (func-machine-code-returns? f)
      (machine-code-push-text! (mut text) "\n\tret"))
    (cg-pos cg (cg-append cg function (cg-bl cg "entry")))
    (let [asm (slice (load text))
          void-ty
            (LLVMFunctionType (LLVMVoidTypeInContext ctx)
                              (carr a (ArrayList::new [(ptr i8)] a))
                              0
                              0)
          asm-ptr
            (LLVMGetInlineAsm void-ty
                              (primitive/cast (ptr i8) (data asm))
                              (len asm)
                              (primitive/cast (ptr i8) (data ""))
                              0
                              1
                              0
                              0
                              0)]
      (LLVMBuildCall2 b
                      void-ty
                      asm-ptr
                      (carr a (ArrayList::new [(ptr i8)] a))
                      0
                      (cg-bl cg ""))
      (LLVMBuildUnreachable b)
      0)))

(defn alias-type-name [(t (ptr Type))] (-> (slice u8))
  (match (load t)
    (TInt [bits _]
          (if (= bits 8)
              "omnipotent char"
              (if (= bits 16)
                  "integer16"
                  (if (= bits 32) "integer32" "integer64"))))
    (TBool [] "boolean")
    (TFloat [bits] (if (= bits 32) "float32" "float64"))
    (TPtr [_] "any pointer")
    (TRef [_ _] "any pointer")
    (TFn [_ _ _] "any pointer")
    (_ "omnipotent char")))

; Attach a scalar TBAA access tag. alias-load/alias-store! are an explicit unsafe
; promise that accesses obey type-based aliasing; ordinary Coil load/store keep
; the language's permissive pointer-cast semantics and deliberately have no tag.
(defn set-alias-metadata [(cg (ptr Cg)) (inst (ptr i8)) (t (ptr Type))] (-> i64)
  (let [ctx (cg-ctx cg)
        root-name "Coil explicit type aliasing"
        char-name "omnipotent char"
        root-text
          (LLVMMDStringInContext2 ctx
                                  (primitive/cast (ptr i8)
                                                  (data root-name))
                                  (len root-name))
        root-ops (primitive/alloc-stack (array (ptr i8) 1))
        _a (set! (index root-ops 0) root-text)
        root (LLVMMDNodeInContext2 ctx root-ops 1)
        zero (LLVMValueAsMetadata (LLVMConstInt (cg-i64t cg) 0 0))
        char-text
          (LLVMMDStringInContext2 ctx
                                  (primitive/cast (ptr i8)
                                                  (data char-name))
                                  (len char-name))
        char-ops (primitive/alloc-stack (array (ptr i8) 3))
        _b (set! (index char-ops 0) char-text)
        _c (set! (index char-ops 1) root)
        _d (set! (index char-ops 2) zero)
        char-node (LLVMMDNodeInContext2 ctx char-ops 3)
        type-name (alias-type-name t)
        type-node
          (if (= type-name char-name)
              char-node
              (let [type-text
                      (LLVMMDStringInContext2 ctx
                                              (primitive/cast (ptr i8)
                                                              (data type-name))
                                              (len type-name))
                    type-ops (primitive/alloc-stack (array (ptr i8) 3))]
                (set! (index type-ops 0) type-text)
                (set! (index type-ops 1) char-node)
                (set! (index type-ops 2) zero)
                (LLVMMDNodeInContext2 ctx type-ops 3)))
        tag-ops (primitive/alloc-stack (array (ptr i8) 3))
        _e (set! (index tag-ops 0) type-node)
        _f (set! (index tag-ops 1) type-node)
        _g (set! (index tag-ops 2) zero)
        tag (LLVMMDNodeInContext2 ctx tag-ops 3)
        kind-name "tbaa"
        kind
          (LLVMGetMDKindIDInContext ctx
                                    (primitive/cast (ptr i8)
                                                    (data kind-name))
                                    4)]
    (LLVMSetMetadata inst kind (LLVMMetadataAsValue ctx tag))
    0))

(defn emit-memory-primitive [(cg (ptr Cg))
                             (result (ptr Type))
                             (args (ptr (ArrayList Expr)))
                             (op Intrinsic)
                             (scp (ptr Scope))] (-> Tv)
  (let [vals (emit-arg-tvs cg args scp)
        b (cg-bld cg)]
    (match op
      (IStackBytes []
            (do
              (unless (= (len (load vals)) 1)
                (cg-fail "alloc-stack-bytes: compiler operand mismatch"))
              ;; Build in the current block, never an entry-block slot or an
              ;; inline-IR helper. LLVM owns frame restoration on every return.
              (let [inst
                      (LLVMBuildArrayAlloca b
                                            (basic-ty cg
                                                      (box-type (.a cg)
                                                                (TInt 8 false)))
                                            (tv-val (get (load vals) 0))
                                            (cg-bl cg "stack.bytes"))]
                (LLVMSetAlignment inst 16)
                (mk-tv inst (load result))))
)
      (IVolatileLoad []
            (do
              (unless (= (len (load vals)) 1)
                (cg-fail "volatile-load: compiler operand mismatch"))
              (let [inst
                      (LLVMBuildLoad2 b
                                      (basic-ty cg result)
                                      (tv-val (get (load vals) 0))
                                      (cg-bl cg "volatile.load"))]
                (LLVMSetVolatile inst 1)
                (cg-tv-of-ssa cg inst (load result))))
)
      (IVolatileStore []
            (do
              (unless (= (len (load vals)) 2)
                (cg-fail "volatile-store!: compiler operand mismatch"))
              (let [inst
                      (LLVMBuildStore b
                                      (cg-tv-ssa cg (get (load vals) 1))
                                      (tv-val (get (load vals) 0)))]
                (LLVMSetVolatile inst 1)
                (mk-tv (cg-zero-i64 cg) (load result))))
)
      (IAliasLoad []
            (do
              (unless (= (len (load vals)) 1)
                (cg-fail "alias-load: compiler operand mismatch"))
              (let [inst
                      (LLVMBuildLoad2 b
                                      (basic-ty cg result)
                                      (tv-val (get (load vals) 0))
                                      (cg-bl cg "alias.load"))]
                (set-alias-metadata cg inst result)
                (cg-tv-of-ssa cg inst (load result))))
)
      (IAliasStore []
            (do
              (unless (= (len (load vals)) 2)
                (cg-fail "alias-store!: compiler operand mismatch"))
              (let [value (get (load vals) 1)
                    inst
                      (LLVMBuildStore b
                                      (cg-tv-ssa cg value)
                                      (tv-val (get (load vals) 0)))]
                (set-alias-metadata cg
                                    inst
                                    (box-type (.a cg) (tv-ty value)))
                (mk-tv (cg-zero-i64 cg) (load result))))
)
      (IFence []
            (do
              ; a fence produces no value, so it has no name
              (LLVMBuildFence b 7 0 (cg-bl cg ""))
              (mk-tv (cg-zero-i64 cg) (load result)))
)
      (_ (cg-bug "codegen: emit-memory-primitive given an intrinsic that is not a memory primitive")))))

; A `(primitive/llvm-ir …)` operand becomes a one-function module that is parsed
; and linked into the module under construction. Monomorphization re-emits the
; same substituted text once per instantiation — compiling the compiler yields
; 1268 helpers from 4 distinct bodies — and every LLVMLinkModules2 constructs a
; fresh IRMover, whose ctor runs TypeFinder over the whole destination module.
; Linking per instantiation is therefore quadratic in module size. Link each
; distinct helper once and share its definition: the helper is `internal` and
; `alwaysinline`, so every call site still inlines its own copy.
;
; The key is the module text with the helper's own generated name elided, so two
; instantiations match exactly when their declares, signature and body agree.
(defn llvm-ir-helper [(cg (ptr Cg))
                      (decls (slice u8))
                      (ret-str (slice u8))
                      (params (slice u8))
                      (fnbody (slice u8))] (-> (ptr i8))
  (let [a (.a cg)
        (mut kb) (StrBuf::new a)]
    (push-str! (mut kb) decls)
    (push-str! (mut kb) "define ")
    (push-str! (mut kb) ret-str)
    (push-str! (mut kb) " @(")
    (push-str! (mut kb) params)
    (push-str! (mut kb) ") alwaysinline {\n")
    (push-str! (mut kb) fnbody)
    (push-str! (mut kb) "}\n")
    (let [key (str (load kb))]
      (match (get (.llvm_ir_helpers cg) key)
        (Some [cached] cached)
        (None []
              (let [seq (.llvm_seq cg)]
                (set! (.llvm_seq cg) (primitive/iadd seq 1))
                (let [name (sconcat a "__coil_llvm_ir_" (i64->str a seq))
                      (mut mt) (StrBuf::new a)]
                  (push-str! (mut mt) decls)
                  (push-str! (mut mt) "define ")
                  (push-str! (mut mt) ret-str)
                  (push-str! (mut mt) " @")
                  (push-str! (mut mt) name)
                  (push-str! (mut mt) "(")
                  (push-str! (mut mt) params)
                  (push-str! (mut mt) ") alwaysinline {\n")
                  (push-str! (mut mt) fnbody)
                  (push-str! (mut mt) "}\n")
                  (cg-link-ir-text! cg (str (load mt)))
                  (let [callee
                          (LLVMGetNamedFunction (load (field cg module))
                                                (to-cstr a name))]
                    (LLVMSetLinkage callee 8)
                    (set! (mut (.llvm_ir_helpers cg)) key callee)
                    callee))))))))

;;; Parse `mtext`, a module of LLVM IR, and link it into the module under
;;; construction.
(defn cg-link-ir-text! [(cg (ptr Cg)) (mtext (slice u8))] (-> i64)
  (let [a (.a cg)
        membuf
          (LLVMCreateMemoryBufferWithMemoryRangeCopy (primitive/cast (ptr i8)
                                                                     (data mtext))
                                                     (len mtext)
                                                     (cg-bl cg "coil_llvm_ir"))
        (mut modout) (zeroed (ptr i8))
        (mut errout) (zeroed (ptr i8))]
    (if (!= (LLVMParseIRInContext (cg-ctx cg)
                                  membuf
                                  (mut modout)
                                  (mut errout))
            (: 0 i32))
        ; Parse failure: the message is LLVM's own, which is
        ; itself `{:?}` (Debug) over its `Deref::Target = CStr` — so the LLVM
        ; error message (read from the `errout` char** out-param) is CStr-Debug-
        ; escaped (quoted, `\n`, `\'`, `\xHH` …) via cstr-dbg-escape; the
        ; `--- generated module ---` section is the module text we just built
        ; (mtext). cg-fail renders it as `error: <body>` + exit 1.
        (cg-fail (sconcat a
                          (sconcat3 a
                                    "llvm-ir: could not parse IR: "
                                    (sconcat3 a
                                              "\""
                                              (cstr-dbg-escape a (from-cstr errout))
                                              "\"")
                                    "\n--- generated module ---\n")
                          mtext))
        (let [linked modout]
          (LLVMSetTarget linked (LLVMGetTarget (load (field cg module))))
          (LLVMSetDataLayout linked
                             (LLVMGetDataLayoutStr (load (field cg module))))
          (LLVMLinkModules2 (load (field cg module)) linked)
          0))))

(defn emit-llvm-ir [(cg (ptr Cg))
                    (result (ptr Type))
                    (args (ptr (ArrayList Expr)))
                    (body (slice u8))
                    (scp (ptr Scope))] (-> Tv)
  (let [a (.a cg)
                b (cg-bld cg)
                argtv (emit-arg-tvs cg args scp)
                nargs (len (load argtv))
                ret-str
                  (from-cstr (LLVMPrintTypeToString (basic-ty cg result)))
                ; substitute placeholders, highest index first.
                (mut text) body
                (mut i) (primitive/isub nargs 1)]
            (loop (if (< (load i) 0)
                      (break)
                      (do
                        (let [argstr
                                (from-cstr (LLVMPrintTypeToString (basic-ty cg
                                                                              (box-type a
                                                                                        (tv-ty (get (load argtv)
                                                                                                    (load i)))))))]
                          (set! text
                                (str-replace-all a
                                                 (load text)
                                                 (sconcat a
                                                          "$t"
                                                          (i64->str a (load i)))
                                                 argstr))
                          (set! text
                                (str-replace-all a
                                                 (load text)
                                                 (sconcat a
                                                          "$"
                                                          (i64->str a (load i)))
                                                 (sconcat a
                                                          "%"
                                                          (i64->str a (load i))))))
                        (set! i (primitive/isub (load i) 1)))))
            (set! text (str-replace-all a (load text) "$ret" ret-str))
            ; hoist `declare` lines; build the helper module text.
            (let [lines (nz-split-lines a (load text))
                  nl (len lines)
                  (mut decls) (StrBuf::new a)
                  (mut fnbody) (StrBuf::new a)
                  (mut j) 0]
              (loop (if (>= (load j) nl)
                        (break)
                        (do
                          (let [ln (get lines (load j))]
                            (if (starts-with (str-ltrim ln) "declare")
                                (do
                                  (push-str! (mut decls) ln)
                                  (push! (mut decls) 10))
                                (do
                                  (push-str! (mut fnbody) ln)
                                  (push! (mut fnbody) 10))))
                          (set! j (primitive/iadd (load j) 1)))))
              (let [(mut params) (StrBuf::new a)
                    (mut k) 0]
                (loop (if (>= (load k) nargs)
                          (break)
                          (do
                            (when (> (load k) 0)
                              (push-str! (mut params) ", "))
                            (let [argstr
                                    (from-cstr (LLVMPrintTypeToString (basic-ty cg
                                                                                  (box-type a
                                                                                            (tv-ty (get (load argtv)
                                                                                                        (load k)))))))]
                              (push-str! (mut params) argstr)
                              (push-str! (mut params) " %")
                              (push-str! (mut params) (i64->str a (load k))))
                            (set! k (primitive/iadd (load k) 1)))))
                (let [callee
                        (llvm-ir-helper cg
                                        (str (load decls))
                                        ret-str
                                        (str (load params))
                                        (str (load fnbody)))
                      (mut vs) (ArrayList::new [(ptr i8)] a)
                      (mut q) 0]
                  (loop (if (>= (load q) nargs)
                            (break)
                            (do
                              (push! (mut vs)
                                     (cg-tv-ssa cg (get (load argtv) (load q))))
                              (set! q (primitive/iadd (load q) 1)))))
                  (let [call
                          (LLVMBuildCall2 b
                                          (LLVMGlobalGetValueType callee)
                                          callee
                                          (carr a (load vs))
                                          (primitive/cast i32 nargs)
                                          (cg-bl cg "llvmir"))]
                    (if (ty-is-void result)
                        (mk-tv call (load result))
                        (cg-tv-of-ssa cg call (load result)))))))))

(defn emit-arg-tvs [(cg (ptr Cg)) (es (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> (ArrayList Tv))
  (let [n (len (load es))
        (mut out) (ArrayList::new [Tv] (.a cg))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out)
                       (emit-expr cg (elem es (load i)) scp))
                (set! i (primitive/iadd (load i) 1)))))
    (load out)))

(defn str-ltrim [(s (slice u8))] (-> (slice u8))
  (let [n (len s)
        (mut i) 0]
    (loop (if (or (>= (load i) n)
                  (!= (primitive/cast i64 (get s (load i)))
                      32))
              (break)
              (set! i (primitive/iadd (load i) 1))))
    (substr s (load i) n)))

; ======================== emit_func / emit_tail ==============================
(defn emit-c-return [(cg (ptr Cg)) (sig (ptr CSig)) (ret (ptr Type)) (last Tv)] (-> i64)
  (let [b (cg-bld cg)]
    (if (ty-is-void ret)
        (do (LLVMBuildRetVoid b) 0)
        (let [has-sret
                (and (!= (primitive/cast i64 sig) 0)
                     (!= (primitive/cast i64
                                         (load (field sig
                                                      sret)))
                         0))
              has-rd
                (and (!= (primitive/cast i64 sig) 0)
                     (!= (primitive/cast i64
                                         (load (field sig
                                                      ret_direct)))
                         0))]
          (if (not (or has-sret has-rd))
              (do (LLVMBuildRet b (cg-tv-ssa cg last)) 0)
              (let [sa
                      (if has-sret
                          (load (field sig sret))
                          (load (field sig ret_direct)))
                    ; the result is a memory value: copy it from its storage
                    lv (tv-val last)]
                (if has-sret
                    (do
                      (LLVMBuildMemCpy b
                                       (LLVMGetParam (cg-cur-func cg) 0)
                                       (.align sa)
                                       lv
                                       1
                                       (cg-const-uoff cg (.size sa)))
                      (LLVMBuildRetVoid b)
                      0)
                    ; a direct return reads whole ABI slots, so it needs storage
                    ; padded to them, not the value's exactly sized storage
                    (let [rt (abi-direct-return-type cg sa)
                          slot (cg-struct-slot-padded cg sa "ret.spill")]
                      (LLVMBuildMemCpy b
                                       slot
                                       (.align sa)
                                       lv
                                       1
                                       (cg-const-uoff cg (.size sa)))
                      (if (= (LLVMGetTypeKind rt) (: 0 i32))
                          (LLVMBuildRetVoid b)
                          (LLVMBuildRet b
                                        (LLVMBuildLoad2 b
                                                        rt
                                                        slot
                                                        (cg-bl cg
                                                               "abi.ret.coerce"))))
                      0))))))))

;;; May this call in tail position be emitted as a tail call?
;;;
;;; Scalar-only SELF and MUTUAL calls qualify when the
;;; callee's LLVM function type is IDENTICAL to the caller's — which is exactly
;;; what `musttail` requires: same return type, same parameter types, same calling
;;; convention, and the call immediately followed by `ret`.
;;;
;;; Why this matters: without it, `(define (even? n) (if (= n 0) #t (odd? (- n 1))))`
;;; emits a plain unmarked `call`. It only survives deep recursion when LLVM's
;;; optimizer happens to apply TCE on its own — an accident, not a guarantee, and
;;; R5RS requires the guarantee. Verified: before this change the mutual pair
;;; emitted `call i64 @tcmutual.is-odd`, where the self-recursive case emitted
;;; `musttail call`.
;;;
;;; Scalar arguments cannot borrow the caller frame. A tail call to a function with
;;; a different signature cannot reuse the frame — LLVM would reject the
;;; `musttail` outright — so comparing `LLVMGlobalGetValueType` on both sides is
;;; not a heuristic but the precondition itself. It is also why this is such a
;;; good fit for the Scheme dialect: every Scheme procedure lowers to `i64` params
;;; returning `i64`, so the types match uniformly.
;;;
;;; `cg-has-csig` still disqualifies: a function with a C signature goes through
;;; ABI adaptation (sret pointers, aggregate coercion) that a tail call cannot
;;; carry.
(defn tail-call-ok [(cg (ptr Cg)) (func (slice u8)) (function (ptr i8))] (-> bool)
  ; a :shim callee is reached only through its register-constrained call site
  (if (or (cg-has-csig cg func)
          (cg-inline-func? cg func)
          (!= (primitive/cast i64 (cg-shim-find cg func)) 0))
      false
      (let [callee (cg-func cg func)]
        (if (= (primitive/cast i64 callee) 0)
            false
            (if (= (primitive/cast i64 callee) (primitive/cast i64 function))
                ; A reference argument may point into a temporary in this frame.
                ; Even self recursion cannot discard that storage. Leave aggregate
                ; and pointer calls ordinary so LLVM can prove any safe optimization.
                (cg-fnty-all-scalar? (LLVMGlobalGetValueType function))
                ; ⚠ NOT ON WASM. LLVM lowers `musttail` to a `return_call`,
                ; which needs the Wasm 3.0 `+tail-call` feature — and
                ; `llvm-cpu-features` still returns an empty string with a
                ; TODO, so that feature is NOT enabled. Emitting musttail here
                ; fails the whole build:
                ;
                ;   error: in function mh_fail i64 (i64):
                ;          WebAssembly 'tail-call' feature not enabled
                ;
                ; This did not bite before mutual tail calls were allowed
                ; because self-recursion alone never reached the affected
                ; functions. Restricting to self-calls on wasm restores the
                ; previous behaviour exactly; when `+tail-call` is turned on,
                ; delete this clause (see issue #1).
                (if (= (.arch cg) 2)
                    false
                    (let [cty (cg-func-fnty cg func callee)
                          fty (LLVMGlobalGetValueType function)
                          cc
                            (primitive/cast i64
                                            (LLVMGetFunctionCallConv function))]
                      ; A DIFFERENT function must use the same convention and
                      ; scalar-only ABI. Ordinary conventions additionally need
                      ; identical prototypes. LLVM tailcc deliberately relaxes that
                      ; last rule, which is what permits Scheme f/1 to tail call g/2.
                      (and (= (primitive/cast i64
                                              (LLVMGetFunctionCallConv callee))
                              cc)
                           (and (cg-fnty-all-scalar? fty)
                                (and (cg-fnty-all-scalar? cty)
                                     (or (= (primitive/cast i64 cty)
                                            (primitive/cast i64 fty))
                                         (and (or (= cc 18) (= cc 20))
                                              (= (primitive/cast i64
                                                                 (LLVMGetReturnType cty))
                                                 (primitive/cast i64
                                                                 (LLVMGetReturnType fty)))))))))))))))

;;; Every parameter and the return are first-class scalars (no pointers, structs
;;; or arrays), so a tail call needs no ABI adaptation and carries no parameter
;;; attributes that would make LLVM refuse it.
(defn cg-fnty-all-scalar? [(fnty (ptr i8))] (-> bool)
  (and (cg-llty-scalar? (LLVMGetReturnType fnty))
       (let [n (primitive/cast i64 (LLVMCountParamTypes fnty))
             a (primitive/alloc-stack (array (ptr i8) 32))]
         (if (> n 32)
             false
             (do
               (LLVMGetParamTypes fnty (primitive/cast (ptr (ptr i8)) a))
               (let [(mut i) 0
                     (mut ok) true]
                 (loop (if (>= (load i) n)
                           (break)
                           (do
                             (when (not (cg-llty-scalar? (load (index a
                                                                      (load i)))))
                               (set! ok false)
                               0)
                             (set! i (primitive/iadd (load i) 1)))))
                 (load ok)))))))

;;; Integer, float or double — the kinds that pass in registers with no parameter
;;; attribute and no indirection. Struct (10), Array (11) and Pointer (12) are out.
;;; Kind numbers are LLVM-C's, matching the existing uses in this file
;;; (`slot-is-sse?` reads float=2/double=3, and the pointer checks read 12).
(defn cg-llty-scalar? [(t (ptr i8))] (-> bool)
  (let [k (primitive/cast i64 (LLVMGetTypeKind t))]
    (or (= k 8)
        ; Integer
        (= k 2)
        ; Float
        (= k 3))))  ; Double

(defn emit-tail [(cg (ptr Cg))
                 (e (ptr Expr))
                 (function (ptr i8))
                 (sig (ptr CSig))
                 (ret (ptr Type))
                 (scp (ptr Scope))] (-> i64)
  (let [a (.a cg)
        b (cg-bld cg)
        sret-sa
          (if (= (primitive/cast i64 sig) 0)
              (primitive/cast (ptr StructAbi) 0)
              (load (field sig sret)))
        branches
          (match (.kind e) (EIf [_ _ _] true) (EMatch [_ _] true) (_ false))]
    ; A result returned through a hidden pointer is built in the caller's
    ; storage, which the caller hands over fresh (an `if` or `match` passes this
    ; down to each branch's own tail).
    (if (and (!= (primitive/cast i64 sret-sa) 0)
             (and (not branches) (cg-mem-ty? cg ret)))
        (do
          (emit-into cg
                     e
                     (Dest :at (LLVMGetParam function 0)
                       :align (primitive/cast i64 (.align sret-sa)))
                     scp)
          (unless (cg-terminated cg) (LLVMBuildRetVoid b))
          0)
        (match (.kind e)
          (ECleanup [_body _cleanups]
                    (emit-c-return cg sig ret (emit-expr cg e scp)))
          (EDo [body]
               (let [n (len (load body))]
                 (if (= n 0)
                     (emit-c-return cg
                                    sig
                                    ret
                                    (mk-tv (cg-zero-i64 cg) (TInt 64 true)))
                     (let [(mut i) 0]
                       (loop (if (or (>= (load i) (primitive/isub n 1))
                                     (cg-terminated cg))
                                 (break)
                                 (do
                                   (emit-expr cg
                                              (elem body (load i))
                                              scp)
                                   (set! i (primitive/iadd (load i) 1)))))
                       (when (not (cg-terminated cg))
                         (emit-tail cg
                                    (elem body (primitive/isub n 1))
                                    function
                                    sig
                                    ret
                                    scp))))))
          (ELet [binds body]
                (let [child (emit-binds cg binds scp)
                      n (len (load body))]
                  (unless (= n 0)
                    (let [(mut i) 0]
                      (loop (if (or (>= (load i) (primitive/isub n 1))
                                    (cg-terminated cg))
                                (break)
                                (do
                                  (emit-expr cg
                                             (elem body (load i))
                                             child)
                                  (set! i (primitive/iadd (load i) 1)))))
                      (when (not (cg-terminated cg))
                        (emit-tail cg
                                   (elem body (primitive/isub n 1))
                                   function
                                   sig
                                   ret
                                   child))))))
          (EIf [cnd thn els]
               (let [cv (emit-expr cg cnd scp)
                     c (tv-val cv)
                     cmp
                       (LLVMBuildICmp b
                                      33
                                      c
                                      (cg-zero (LLVMTypeOf c))
                                      (cg-bl cg "ifc"))
                     then-bb (cg-append cg function (cg-bl cg "then"))
                     else-bb (cg-append cg function (cg-bl cg "else"))]
                 (LLVMBuildCondBr b cmp then-bb else-bb)
                 (cg-pos cg then-bb)
                 (emit-tail cg thn function sig ret scp)
                 (cg-pos cg else-bb)
                 (emit-tail cg els function sig ret scp)))
          (ECall [func targs args]
                 ; A reset entry never returns, so its calls are forced into tail
                 ; calls -- except to a callee with a C signature, whose sret pointer
                 ; or coerced result the raw call below would not carry.
                 (if (or (tail-call-ok cg func function)
                         (and (= (primitive/cast i64 function)
                                 (primitive/cast i64
                                                 (load (field cg reset_func))))
                              (not (cg-has-csig cg func))
                              (= (primitive/cast i64 (cg-shim-find cg func)) 0)))
                     (let [callee (cg-func cg func)
                           cfnty (cg-func-fnty cg func callee)
                           vals
                             (reconcile-args cg cfnty (emit-vals cg args scp))
                           cs
                             (LLVMBuildCall2 b
                                             cfnty
                                             callee
                                             (carr a vals)
                                             (primitive/cast i32 (len vals))
                                             (cg-call-name cg cfnty "tailcall"))]
                       (LLVMSetInstructionCallConv cs
                                                   (LLVMGetFunctionCallConv callee))
                       ; musttail (kind 2) guarantees TCO, but the x86-64 SysV backend cannot
                       ; tail-call a self-recursion whose return is a large aggregate: SysV
                       ; classifies it MEMORY and returns it via a hidden sret pointer, and LLVM
                       ; aborts codegen ("failed to perform tail call elimination on a call site
                       ; marked musttail"). AArch64 returns aggregates via x8 and tail-calls them
                       ; fine, so it keeps musttail. On x86, when the callee's LLVM return type is
                       ; a Struct (10) or Array (11), downgrade to `tail` (kind 1): a hint LLVM
                       ; applies where it can (scalar self-calls still get real TCO) and otherwise
                       ; degrades to a normal call. Scalar/pointer returns keep guaranteed musttail.
                       (let [rk (LLVMGetTypeKind (LLVMGetReturnType cfnty))
                             x86-agg
                               (and (= (.arch cg) 0)
                                    (or (= (primitive/cast i64 rk)
                                           10)
                                        (= (primitive/cast i64 rk)
                                           11)))]
                         (LLVMSetTailCallKind cs (if x86-agg 1 2)))
                       (if (ty-is-void ret)
                           (do (LLVMBuildRetVoid b) 0)
                           (do (LLVMBuildRet b cs) 0)))
                     (let [v (emit-expr cg e scp)]
                       (when (not (cg-terminated cg))
                         (emit-c-return cg sig ret v)))))
          (ECallPtr [fp args]
                    (let [v (emit-callptr cg fp args scp (no-dest))]
                      (if (and (let [cc
                                       (primitive/cast i64
                                                       (LLVMGetFunctionCallConv function))]
                                 (or (= cc 18) (= cc 20)))
                               (= (primitive/cast i64
                                                  (LLVMGetInstructionCallConv (tv-val v)))
                                  (primitive/cast i64
                                                  (LLVMGetFunctionCallConv function))))
                          (do
                            ;; tailcc permits the pointer's argument list to differ from the
                            ;; caller's. The checker has already proved the pointer call's
                            ;; own argument types, and both Scheme sides return i64.
                            (LLVMSetTailCallKind (tv-val v) 2)
                            (LLVMBuildRet b (tv-val v))
                            0)
                          (when (not (cg-terminated cg))
                            (emit-c-return cg sig ret v)))))
          (EMatch [scrut arms]
                  (emit-tail-match cg scrut arms function sig ret scp))
          (_ (let [v (emit-expr cg e scp)]
               (when (not (cg-terminated cg)) (emit-c-return cg sig ret v))))))))

(defn emit-tail-match [(cg (ptr Cg))
                       (scrut (ptr Expr))
                       (arms (ptr (ArrayList Arm)))
                       (function (ptr i8))
                       (sig (ptr CSig))
                       (ret (ptr Type))
                       (scp (ptr Scope))] (-> i64)
  (let [a (.a cg)
        b (cg-bld cg)
        sv (emit-expr cg scrut scp)
        borrowed
          (match (tv-ty sv)
            (TRef [_ inner] (match (load inner) (TStruct [_] true) (_ false)))
            (TPtr [inner] (match (load inner) (TStruct [_] true) (_ false)))
            (_ false))
        borrow-mutable (match (tv-ty sv) (TRef [mutable _] mutable) (_ false))
        sumname
          (match (tv-ty sv)
            (TStruct [s] s)
            (TRef [_ inner]
                  (match (load inner)
                    (TStruct [s] s)
                    (_ (cg-bug-sl "codegen: match on non-sum reference"))))
            (TPtr [inner]
                  (match (load inner)
                    (TStruct [s] s)
                    (_ (cg-bug-sl "codegen: match on non-sum pointer"))))
            (_ (cg-bug-sl "codegen: match on non-sum")))
        ui (cg-sum-idx cg sumname)
        sp (elem (field cg sums) ui)
        sum-ty (load (field sp ty))
        tmp (cg-match-storage cg sv borrowed)]
    (let [tagptr (LLVMBuildStructGEP2 b sum-ty tmp 0 (cg-bl cg "tag"))
          tag (LLVMBuildLoad2 b (cg-i32t cg) tagptr (cg-bl cg "tag"))
          payload (LLVMBuildStructGEP2 b sum-ty tmp 1 (cg-bl cg "payload"))
          narms (len (load arms))
          ncases (if (arms-have-wildcard arms) (primitive/isub narms 1) narms)
          (mut armbbs) (ArrayList::new [(ptr i8)] a)
          (mut k) 0]
      (loop (if (>= (load k) narms)
                (break)
                (do
                  (push! (mut armbbs) (cg-append cg function (cg-bl cg "arm")))
                  (set! k (primitive/iadd (load k) 1)))))
      (let [default
              (if (= ncases narms)
                  (cg-append cg function (cg-bl cg "match.default"))
                  (get (load armbbs) ncases))
            (mut k2) 0
            sw (LLVMBuildSwitch b tag default (primitive/cast i32 ncases))]
        (loop (if (>= (load k2) ncases)
                  (break)
                  (do
                    (let [ap (elem arms (load k2))
                          vidx (cg-variant-idx cg sp (.variant ap))]
                      (LLVMAddCase sw
                                   (LLVMConstInt (cg-i32t cg) vidx 0)
                                   (get (load armbbs) (load k2))))
                    (set! k2 (primitive/iadd (load k2) 1)))))
        (when (= ncases narms) (cg-pos cg default) (LLVMBuildUnreachable b) 0)
        (let [(mut k3) 0]
          (loop (if (>= (load k3) narms)
                    (break)
                    (do
                      (cg-pos cg (get (load armbbs) (load k3)))
                      (let [ap (elem arms (load k3))
                            vidx
                              (if (>= (load k3) ncases)
                                  0
                                  (cg-variant-idx cg sp (.variant ap)))
                            var-struct (get (load (field sp vstructs)) vidx)
                            vp
                              (elem (load (field sp variants))
                                    vidx)
                            vfs (load (field vp fields))
                            binds (load (field ap binds))
                            nb (len (load binds))
                            (mut child) scp
                            (mut j) 0]
                        (loop (if (>= (load j) nb)
                                  (break)
                                  (do
                                    (let [fptr
                                            (LLVMBuildStructGEP2 b
                                                                 var-struct
                                                                 payload
                                                                 (primitive/cast i32
                                                                                 (load j))
                                                                 (cg-bl cg "vf"))
                                          fty
                                            (.ty (elem vfs (load j)))
                                          bname (get (load binds) (load j))
                                          bv
                                            (cg-match-binding cg
                                                              fptr
                                                              fty
                                                              bname
                                                              borrowed)]
                                      (set! child
                                            (scope-put a
                                                       (load child)
                                                       bname
                                                       (tv-val bv)
                                                       (tv-ty bv))))
                                    (set! j (primitive/iadd (load j) 1)))))
                        (emit-tail cg
                                   (field ap body)
                                   function
                                   sig
                                   ret
                                   (load child)))
                      (set! k3 (primitive/iadd (load k3) 1)))))
          0)))))

(defn func-inline-always? [(f (ptr Func))] (-> bool)
  (match (func-inline-policy f) (Some [(Always)] true) (_ false)))

;; Shared native entry setup for structured and explicit-CFG function bodies.
;; Parameter ABI reconstruction, attributes and fixed-slot insertion are owned
;; here, so a second body form cannot grow a different native calling convention.
(defn emit-func-entry [(cg (ptr Cg)) (f (ptr Func)) (function (ptr i8))] (-> (ptr Scope))
  (let [a (.a cg)
        b (cg-bld cg)
        entry (cg-append cg function (cg-bl cg "entry"))
        sig (cg-csig cg (.name f))
        base
          (when (and (!= (primitive/cast i64 sig) 0)
                     (!= (primitive/cast i64
                                         (load (field sig
                                                      sret)))
                         0))
            1)]
    (set! (.nstatic cg) 0)
    (clear! (mut (.aligns cg)))
    (match (func-inline-policy f)
      (Some [policy]
            (LLVMAddAttributeAtIndex function
                                     (: -1 i32)
                                     (cg-enum-attr cg
                                                   (match policy
                                                     (Always [] "alwaysinline")
                                                     (Hint [] "inlinehint")
                                                     (Never [] "noinline"))
                                                   0)))
      (None []))
    (cg-pos cg entry)
    (let [params (load (field f params))
          np (len (load params))
          (mut scp) (scope-nil a)
          (mut idx) base
          (mut i) 0]
      (loop (if (>= (load i) np)
                (break)
                (do
                  (let [pp (elem params (load i))
                        pname (.name pp)
                        pty (.ty pp)
                        aa
                          (if (!= (primitive/cast i64 sig)
                                  0)
                              (cg-argabi sig (load i))
                              (AAScalar))]
                    (match aa
                      (AADirect [sa]
                                ; The coerced slots cover the struct rounded up to
                                ; 8 bytes: a 12-byte struct arrives as [2 x i64].
                                ; Storing that into an exactly-sized alloca writes
                                ; past its end, which LLVM treats as UB and folds
                                ; away — the trailing field read back as 0.
                                (let [slot
                                        (cg-struct-slot-padded cg
                                                               sa
                                                               (sconcat a
                                                                        pname
                                                                        ".arg"))]
                                  (match (.arg sa)
                                    (ACDirect [slots]
                                              (let [ns (len (load slots))
                                                    (mut k) 0]
                                                (loop (if (>= (load k) ns)
                                                          (break)
                                                          (do
                                                            (let [v
                                                                    (LLVMGetParam function
                                                                                  (primitive/cast i32
                                                                                                  (load idx)))
                                                                  off
                                                                    (primitive/imul (load k)
                                                                                    8)
                                                                  gep
                                                                    (if (= off
                                                                           0)
                                                                        slot
                                                                        (cg-gep-i8 cg
                                                                                   slot
                                                                                   off))]
                                                              (LLVMBuildStore b
                                                                              v
                                                                              gep)
                                                              (set! idx
                                                                    (primitive/iadd (load idx)
                                                                                    1)))
                                                            (set! k
                                                                  (primitive/iadd (load k)
                                                                                  1)))))
                                                0))
                                    (_ 0))
                                  ; the reassembled slot holds the value
                                  (set! scp
                                        (scope-put a (load scp) pname slot pty))))
                      (AAIndirect [sa]
                                  ; the caller's copy holds the value
                                  (let [ptr
                                          (LLVMGetParam function
                                                        (primitive/cast i32
                                                                        (load idx)))]
                                    (set! idx (primitive/iadd (load idx) 1))
                                    (set! scp
                                          (scope-put a (load scp) pname ptr pty))))
                      (AAScalar []
                                (let [v
                                        (LLVMGetParam function
                                                      (primitive/cast i32
                                                                      (load idx)))]
                                  (LLVMSetValueName2 v
                                                     (to-cstr a pname)
                                                     (len pname))
                                  (set! idx (primitive/iadd (load idx) 1))
                                  ; an array of a plain LLVM signature arrives as a
                                  ; first-class value; give it storage
                                  (let [pv (cg-tv-of-ssa cg v pty)]
                                    (set! scp
                                          (scope-put a
                                                     (load scp)
                                                     pname
                                                     (tv-val pv)
                                                     pty)))))))
                  (set! i (primitive/iadd (load i) 1)))))
      (load scp))))

(defn emit-func [(cg (ptr Cg)) (f (ptr Func)) (function (ptr i8))] (-> i64)
  (compiler-work! "emit" (.name f))
  (let [sig (cg-csig cg (.name f))
        scp (emit-func-entry cg f function)]
    (let [body (load (field f body))
          nb (len (load body))]
      (if (= nb 0)
          (when (not (cg-terminated cg))
            (emit-c-return cg
                           sig
                           (field f ret)
                           (mk-tv (cg-zero-i64 cg) (TInt 64 true))))
          (let [(mut j) 0]
            (loop (if (or (>= (load j) (primitive/isub nb 1))
                          (cg-terminated cg))
                      (break)
                      (do
                        (emit-expr cg (elem body (load j)) scp)
                        (set! j (primitive/iadd (load j) 1)))))
            (when (not (cg-terminated cg))
              (emit-tail cg
                         (elem body (primitive/isub nb 1))
                         function
                         sig
                         (field f ret)
                         scp))))))
  0)

; One function's body into FUNCTION, the LLVM function its Coil name declared.
; A :shim function's body goes into the `ccc` __impl, then the naked trampoline
; into FUNCTION; machine code is FUNCTION's whole body in either case.
(defn cg-emit-func-body [(cg (ptr Cg))
                         (f (ptr Func))
                         (function (ptr i8))
                         (shim (ptr CgShim))] (-> i64)
  (match (func-machine-code f)
    (Some [code] (emit-machine-code-func cg f function code))
    (None []
          (if (= (primitive/cast i64 shim) 0)
              (emit-func cg f function)
              (do
                (emit-func cg f (.impl_fn shim))
                (cg-emit-trampoline cg function shim (len (load (.params f)))))))))

; ======================== the module driver (compile_for_dbg, dbg=None) ======
;; Declarations/layouts and LLVM IR belong to this unit session. A body can be
;; ingested from a shorter-lived function arena: neither emit-func nor LLVM keeps
;; its Expr tree. finish transfers the module/context to the caller; abort closes
;; them here. Ordinary codegen uses exactly the same declaration/body ordering.
(defstruct CodegenSession
  [(cg (ptr Cg))
   (machine (ptr i8))
   (layout (ptr i8))
   (triple (ptr i8))
   (owns_triple bool)
   (open bool)])

; The frame-pointer convention of the platform's C toolchain for `triple`: the
; value clang gives every function it defines, or None where frames may be
; omitted. AArch64 keeps a frame record in every non-leaf function -- Apple's ABI
; requires x29 to address a valid one, and Linux's toolchains follow it -- and
; x86_64 Darwin keeps one in every function. Elsewhere the unwinder reads DWARF
; CFI, which LLVM emits regardless. Without the attribute LLVM saves x29 but
; never points it at the new record, so backtrace(3), debuggers and sampling
; profilers lose every Coil frame between the innermost and the first C frame.
; ("non-leaf" rather than clang 22's "non-leaf-no-reserve": LLVM 21 rejects the
; latter, and the difference is only whether a leaf may use x29 as a register.)
(defn frame-pointer-kind [(triple (slice u8))] (-> (Option (ptr i8)))
  (cond (= (arch-from-triple triple) 1) (Some c"non-leaf")
        (triple-mach-o triple) (Some c"all")
        :else (None [(ptr i8)])))

; Applied once to every function the module defines, whichever path created it
; (bodies, trampolines, thunks, linked llvm-ir helpers), so no definition can be
; added without it.
(defn cg-set-frame-pointers! [(module (ptr i8)) (triple (slice u8))] (-> i64)
  (match (frame-pointer-kind triple)
    (Some [kind]
          (let [(mut f) (LLVMGetFirstFunction module)]
            (loop (if (= (primitive/cast i64 (load f)) 0)
                      (break)
                      (do
                        (when (= (LLVMIsDeclaration (load f))
                                 (: 0 i32))
                          (LLVMAddTargetDependentFunctionAttr (load f)
                                                              c"frame-pointer"
                                                              kind)
                          0)
                        (set! f (LLVMGetNextFunction (load f))))))
            0))
    (None [] 0)))

; A triple with no operating system: bare metal, where no C library exists.
(defn triple-freestanding [(triple (slice u8))] (-> bool)
  (match (find triple "-none") (Some [_] true) (None [] false)))

; On a target with no C library the optimizer must not turn code into libc calls
; it was not written with: a byte-scanning loop into `strlen`, a copy loop into
; `memcpy`, a `printf` into `puts`. "no-builtins" on every definition is what
; clang's -ffreestanding sets. LLVM still lowers its own memory intrinsics, an
; aggregate copy or zeroing, to memcpy, memmove, memset and memcmp:
; cg-provide-freestanding-mem! supplies those.
(defn cg-set-freestanding! [(module (ptr i8)) (triple (slice u8))] (-> i64)
  (when (triple-freestanding triple)
    (let [(mut f) (LLVMGetFirstFunction module)]
      (loop (if (= (primitive/cast i64 (load f)) 0)
                (break)
                (do
                  (when (= (LLVMIsDeclaration (load f)) (: 0 i32))
                    (LLVMAddTargetDependentFunctionAttr (load f)
                                                        c"no-builtins"
                                                        c"")
                    0)
                  (set! f (LLVMGetNextFunction (load f))))))
      0)
    0)
  0)

;;; Whether `--gc-sections` may group `g` on its own: a definition the object
;;; file emits (not a declaration, an `available_externally` copy, a `common`
;;; symbol or an `appending` llvm.* table) that no comdat already claims.
(defn llvm-groupable? [(g (ptr i8))] (-> bool)
  (let [linkage (LLVMGetLinkage g)]
    (and (= (LLVMIsDeclaration g) (: 0 i32))
         (and (= (primitive/cast i64 (LLVMGetComdat g)) 0)
              (not (or (= linkage (: 1 i32))  ; available_externally
                       (or (= linkage (: 7 i32))  ; appending
                           (= linkage (: 14 i32)))))))))  ; common

;;; Put `g` in a comdat of its own. An unnamed global is named first: the
;;; comdat's name is its section group's signature symbol.
(defn llvm-group-definition! [(module (ptr i8)) (g (ptr i8))] (-> i64)
  (when (= (len (from-cstr (LLVMGetValueName g))) 0)
    (LLVMSetValueName2 g c"coil.anon" 9)
    0)
  (let [comdat (LLVMGetOrInsertComdat module (LLVMGetValueName g))]
    (LLVMSetComdatSelectionKind comdat 3)  ; nodeduplicate
    (LLVMSetComdat g comdat))
  0)

;;; `ld --gc-sections` discards an ELF object one section at a time, so it can
;;; drop a definition only when nothing else shares its section. This gives every
;;; definition its own `nodeduplicate` comdat, which ELF lowers to a section group
;;; holding the definition's own uniquely named section -- of the kind LLVM picks,
;;; so a relocated constant still lands in .data.rel.ro under PIC -- together with
;;; its jump tables. It is what -ffunction-sections -fdata-sections arrange through
;;; TargetOptions, which the C API cannot reach. Without it an object is one
;;; .text, one .rodata and one .data, and the first use of any of them keeps every
;;; stdlib definition coil.core brings in, with the libc each one calls: a
;;; freestanding image cannot link. A nodeduplicate group is never merged with
;;; another object's, so symbol resolution is unchanged. Run after optimization,
;;; just before an object is emitted, so it also covers the globals passes create
;;; (switch tables, merged constants).
(defn llvm-group-definitions! [(module (ptr i8)) (triple (slice u8))] (-> i64)
  (when (triple-elf triple)
    (let [(mut f) (LLVMGetFirstFunction module)]
      (loop (if (= (primitive/cast i64 (load f)) 0)
                (break)
                (do
                  (when (llvm-groupable? (load f))
                    (llvm-group-definition! module (load f)))
                  (set! f (LLVMGetNextFunction (load f)))))))
    (let [(mut g) (LLVMGetFirstGlobal module)]
      (loop (if (= (primitive/cast i64 (load g)) 0)
                (break)
                (do
                  (when (and (llvm-groupable? (load g))
                             (not (starts-with (from-cstr (LLVMGetValueName (load g)))
                                               "llvm.")))
                    (llvm-group-definition! module (load g)))
                  (set! g (LLVMGetNextGlobal (load g)))))))
    0)
  0)

; The four functions LLVM's lowering of its memory intrinsics calls, for a target
; with no C library, where nothing else would define them. They are `weak`, as
; Rust's compiler_builtins and Zig's compiler_rt make theirs: a definition the
; program or a C library it links supplies wins, and a module that already
; defines one keeps its own. They copy a byte at a time, which is correct at any
; alignment, and aarch64-none objects are built `+strict-align`. They must be
; linked before cg-set-freestanding!: without "no-builtins" the optimizer would
; turn memset's own loop back into a call to memset.
(defn cg-provide-freestanding-mem! [(cg (ptr Cg)) (triple (slice u8))] (-> i64)
  (when (triple-freestanding triple)
    (let [a (.a cg)
          size (sconcat a
                        "i"
                        (i64->str a
                                  (primitive/cast i64
                                                  (LLVMGetIntTypeWidth (LLVMIntPtrTypeInContext (cg-ctx cg)
                                                                                                (.td cg))))))]
      (cg-link-ir-text! cg
                        (str-replace-all a
                                         "define weak ptr @memcpy(ptr %d, ptr %s, $size %n) {
entry:
  br label %loop
loop:
  %i = phi $size [0, %entry], [%next, %body]
  %done = icmp eq $size %i, %n
  br i1 %done, label %exit, label %body
body:
  %from = getelementptr i8, ptr %s, $size %i
  %byte = load i8, ptr %from
  %to = getelementptr i8, ptr %d, $size %i
  store i8 %byte, ptr %to
  %next = add $size %i, 1
  br label %loop
exit:
  ret ptr %d
}

define weak ptr @memmove(ptr %d, ptr %s, $size %n) {
entry:
  %dst = ptrtoint ptr %d to $size
  %src = ptrtoint ptr %s to $size
  %forward = icmp ule $size %dst, %src
  br i1 %forward, label %up, label %down
up:
  %i = phi $size [0, %entry], [%next, %up.body]
  %up.done = icmp eq $size %i, %n
  br i1 %up.done, label %exit, label %up.body
up.body:
  %up.from = getelementptr i8, ptr %s, $size %i
  %up.byte = load i8, ptr %up.from
  %up.to = getelementptr i8, ptr %d, $size %i
  store i8 %up.byte, ptr %up.to
  %next = add $size %i, 1
  br label %up
down:
  %j = phi $size [%n, %entry], [%prev, %down.body]
  %down.done = icmp eq $size %j, 0
  br i1 %down.done, label %exit, label %down.body
down.body:
  %prev = sub $size %j, 1
  %down.from = getelementptr i8, ptr %s, $size %prev
  %down.byte = load i8, ptr %down.from
  %down.to = getelementptr i8, ptr %d, $size %prev
  store i8 %down.byte, ptr %down.to
  br label %down
exit:
  ret ptr %d
}

define weak ptr @memset(ptr %d, i32 %c, $size %n) {
entry:
  %byte = trunc i32 %c to i8
  br label %loop
loop:
  %i = phi $size [0, %entry], [%next, %body]
  %done = icmp eq $size %i, %n
  br i1 %done, label %exit, label %body
body:
  %to = getelementptr i8, ptr %d, $size %i
  store i8 %byte, ptr %to
  %next = add $size %i, 1
  br label %loop
exit:
  ret ptr %d
}

define weak i32 @memcmp(ptr %x, ptr %y, $size %n) {
entry:
  br label %loop
loop:
  %i = phi $size [0, %entry], [%next, %same]
  %done = icmp eq $size %i, %n
  br i1 %done, label %equal, label %body
body:
  %xp = getelementptr i8, ptr %x, $size %i
  %xb = load i8, ptr %xp
  %yp = getelementptr i8, ptr %y, $size %i
  %yb = load i8, ptr %yp
  %eq = icmp eq i8 %xb, %yb
  br i1 %eq, label %same, label %differ
same:
  %next = add $size %i, 1
  br label %loop
differ:
  %xw = zext i8 %xb to i32
  %yw = zext i8 %yb to i32
  %diff = sub i32 %xw, %yw
  ret i32 %diff
equal:
  ret i32 0
}
"
                                         "$size"
                                         size))))
  0)

(defn codegen-session-finish! [(s (ptr CodegenSession))] (-> (ptr i8))
  (if (not (.open s))
      (primitive/cast (ptr i8) 0)
      (let [cg (.cg s)
            module (.module cg)]
        (cg-set-frame-pointers! module (from-cstr (.triple s)))
        (cg-provide-freestanding-mem! cg (from-cstr (.triple s)))
        (cg-set-freestanding! module (from-cstr (.triple s)))
        (LLVMDisposeBuilder (.builder cg))
        (LLVMDisposeTargetData (.td cg))
        (LLVMDisposeTargetMachine (.machine s))
        (LLVMDisposeMessage (.layout s))
        (when (.owns_triple s) (LLVMDisposeMessage (.triple s)) 0)
        (set! (.open s) false)
        (set! (.builder cg) (primitive/cast (ptr i8) 0))
        (set! (.td cg) (primitive/cast (ptr i8) 0))
        module)))

(defn codegen-session-abort! [(s (ptr CodegenSession))] (-> i64)
  (let [module (codegen-session-finish! s)]
    (unless (= (primitive/cast i64 module) 0)
      (codegen-dispose-module! module)
      0))
  0)

;; Caller-supplied declaration tables must remain valid until finish. Function
;; payloads need remain valid only during ingest. A missing/duplicate definition
;; or unbalanced lowered control flow is a protocol error, never silent IR.
(defn codegen-session-function! [(s (ptr CodegenSession))
                                 (f (ptr Func))
                                 (temporary (dyn Allocator))] (-> (Result i64
                                                                          Diag))
  (block :ingest
         (unless (.open s)
           (return-from :ingest
                          (Err [i64 Diag]
                               (derr "LLVM unit session is already closed"))))
         (let [cg (.cg s)
               function (cg-func cg (.name f))
               shim (cg-shim-find cg (.name f))
               prior (.a cg)]
           (when (= (primitive/cast i64 function) 0)
             (return-from :ingest
                            (Err [i64 Diag]
                                 (derr "LLVM unit body has no sealed function declaration"))))
           (when (!= (primitive/cast i64 (LLVMGetFirstBasicBlock function)) 0)
             (return-from :ingest
                            (Err [i64 Diag]
                                 (derr "LLVM unit function already has a body"))))
           (unless (= (len (.loops cg)) 0)
             (return-from :ingest
                            (Err [i64 Diag]
                                 (derr "LLVM unit retained a control-flow scope between functions"))))
           (set! (.a cg) temporary)
           (cg-emit-func-body cg f function shim)
           (set! (.a cg) prior)
           (if (= (len (.loops cg)) 0)
               (Ok [i64 Diag] 0)
               (Err [i64 Diag]
                    (derr "LLVM unit function left an open control-flow scope"))))))

; `triple-override` = a NUL-terminated triple cstr to cross-compile for, or null to
; use the host default.
(defn codegen-session-open-config [(a (dyn Allocator))
                                   (p (ptr Program))
                                   (triple-override (ptr i8))
                                   (sanitizer i64)
                                   (debug-checks bool)] (-> (ptr CodegenSession))
  (let [ctx (LLVMContextCreate)]
    ; init targets so an arbitrary (possibly non-host) triple resolves.
    (LLVMInitializeAArch64TargetInfo)
    (LLVMInitializeAArch64Target)
    (LLVMInitializeAArch64TargetMC)
    (LLVMInitializeX86TargetInfo)
    (LLVMInitializeX86Target)
    (LLVMInitializeX86TargetMC)
    (LLVMInitializeRISCVTargetInfo)
    (LLVMInitializeRISCVTarget)
    (LLVMInitializeRISCVTargetMC)
    (LLVMInitializeWebAssemblyTargetInfo)
    (LLVMInitializeWebAssemblyTarget)
    (LLVMInitializeWebAssemblyTargetMC)
    (let [triple
            (if (!= (primitive/cast i64 triple-override) 0)
                triple-override
                (LLVMGetDefaultTargetTriple))
          (mut targetout) (zeroed (ptr i8))
          (mut errout) (zeroed (ptr i8))]
      ; LLVMGetTargetFromTriple RETURNS a status and writes an error string; discarding
      ; both left `targetout` garbage and segfaulted LLVMCreateTargetMachine on it, so a
      ; bogus --target crashed the compiler instead of naming the triple. LLVM already
      ; wrote a perfectly good explanation into errout — print it.
      (when (!= (LLVMGetTargetFromTriple triple
                                         (mut targetout)
                                         (mut errout))
                (: 0 i32))
        (let [w (stderr)]
          (ps w "error: unsupported --target '")
          (ps w (from-cstr triple))
          (ps w "': ")
          (ps w
              (from-cstr errout))
          (wb w 10)
          (exit 1)
          0))
      (let [tm
              (LLVMCreateTargetMachine targetout
                                       triple
                                       (llvm-cpu triple)
                                       (llvm-cpu-features triple)
                                       (: 2 i32)
                                       (llvm-reloc-model triple)
                                       0)
            td (LLVMCreateTargetDataLayout tm)
            dl (LLVMCopyStringRepOfTargetData td)
            module (LLVMModuleCreateWithNameInContext c"coil" ctx)
            builder (LLVMCreateBuilderInContext ctx)
            cgp (box! a Cg (zeroed Cg))]
        (LLVMSetTarget module triple)
        (LLVMSetDataLayout module dl)
        (set! (.ctx cgp) ctx)
        (set! (.module cgp) module)
        (set! (.builder cgp) builder)
        (set! (.td cgp) td)
        (set! (.structs cgp) (ArrayList::new [CgStruct] a))
        (set! (.sums cgp) (ArrayList::new [CgSum] a))
        (set! (.funcs cgp) (ArrayList::new [CgFunc] a))
        (set! (.inline_funcs cgp) (HashMap::new [(slice u8) bool] a (keyops)))
        (set! (.spec_names cgp) (HashMap::new [(slice u8) bool] a (keyops)))
        (set! (.rets cgp) (ArrayList::new [CgRet] a))
        (set! (.sigs cgp) (ArrayList::new [CgSig] a))
        (set! (.statics cgp) (ArrayList::new [CgStatic] a))
        (set! (.static_owner cgp) "")
        (set! (.static_context cgp) "")
        (set! (.shims cgp) (ArrayList::new [CgShim] a))
        (set! (.globals cgp) 0)
        (set! (.nstatic cgp) 0)
        (set! (.llvm_seq cgp) 0)
        (set! (.llvm_ir_helpers cgp)
              (HashMap::new [(slice u8) (ptr i8)] a (keyops)))
        (set! (.loops cgp) (ArrayList::new [CgLoop] a))
        (set! (.aligns cgp) (ArrayList::new [CgAlign] a))
        (set! (.csigs cgp) (ArrayList::new [CSigEntry] a))
        (set! (.exports cgp) (load (field p exports)))
        (set! (.conventions cgp) (load (field p conventions)))
        (set! (.unit_build cgp) (load (field p unit_build)))
        (set! (.reset_func cgp) (primitive/cast (ptr i8) 0))
        (set! (.arch cgp) (arch-from-triple (from-cstr triple)))
        (set! (.mach_o cgp) (triple-mach-o (from-cstr triple)))
        (set! (.freestanding cgp) (triple-freestanding (from-cstr triple)))
        (set! (.sanitizer cgp) sanitizer)
        (set! (.debug_checks cgp) debug-checks)
        (set! (.a cgp) a)
        (set! (.layouts cgp)
              (LayoutDb::new a
                             p
                             "codegen"
                             (target-word-bytes (from-cstr triple))
                             (if (= (.arch cgp) 3) 4 8)))
        (let [fs (load (field p funcs))
              fn (len (load fs))
              (mut fi) 0]
          (loop (if (>= (load fi) fn)
                    (break)
                    (do
                      (let [fp (elem fs (load fi))]
                        (when (func-inline-always? fp)
                          (set! (mut (.inline_funcs cgp))
                                (.name fp)
                                true)
                          0))
                      (set! fi (primitive/iadd (load fi) 1))))))
        (cg-register-types cgp p)
        (cg-eval-asserts cgp p)
        (cg-declare-externs cgp p)
        (cg-declare-funcs cgp p)
        ; Static initializers and bodies may take a public C callback address.
        (cg-emit-thunks cgp p)
        (cg-declare-statics cgp p)
        (box! a
              CodegenSession
              (CodegenSession
                :cg cgp
                :machine tm
                :layout dl
                :triple triple
                :owns_triple (= (primitive/cast i64 triple-override) 0)
                :open true))))))

(defn codegen-session-open [(a (dyn Allocator))
                            (p (ptr Program))
                            (triple (ptr i8))
                            (sanitizer i64)
                            (debug-checks bool)] (-> (ptr CodegenSession))
  (codegen-session-open-config a p triple sanitizer debug-checks))

(defn codegen-module [(a (dyn Allocator))
                      (p (ptr Program))
                      (triple-override (ptr i8))
                      (sanitizer i64)
                      (debug-checks bool)] (-> (ptr i8))
  ; All Coil-side session tables are temporary. LLVM copies declarations,
  ; constants and instructions into the returned module's owned context. Keep
  ; those tables out of the compilation arena, including during meta JIT builds.
  (let [work (primitive/alloc-stack scratch/ScratchArena)]
    (scratch/ScratchArena::init-with-capacity work
      (retained-heap/compiler-scratch-parent) 65536)
    (let [session (codegen-session-open (allocator work) p triple-override sanitizer debug-checks)
          _bodies (cg-emit-bodies (.cg session) p)
          module (codegen-session-finish! session)]
      (close! work)
      module)))

; A module returned by codegen-module exclusively owns its fresh context.
; Execution-engine callers transfer this ownership into their generation;
; object/inspection callers release it immediately after consuming the module.
(defn codegen-dispose-module! [(module (ptr i8))] (-> i64)
  (let [context (LLVMGetModuleContext module)]
    (LLVMDisposeModule module)
    (LLVMContextDispose context)
    0))

; TargetData caches named-struct layouts even when the body is still opaque.
; Its cache must not survive any body mutation (including final tail padding).
(defn cg-set-type-body! [(cg (ptr Cg))
                         (ty (ptr i8))
                         (fields (ptr (ptr i8)))
                         (count i32)
                         (packed i32)] (-> i64)
  (LLVMStructSetBody ty fields count packed)
  (let [old (.td cg)
        layout (LLVMCopyStringRepOfTargetData old)]
    (set! (.td cg) (LLVMCreateTargetData layout))
    (LLVMDisposeTargetData old)
    (LLVMDisposeMessage layout)
    0))

; 0a-0d: two-phase type registration.
(defn cg-register-types [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [ctx (cg-ctx cg)
        ss (load (field p structs))
        ns (len (load ss))
        us (load (field p sums))
        nu (len (load us))
        (mut i) 0]
    ; 0a. opaque struct names.
    (loop (if (>= (load i) ns)
              (break)
              (do
                (let [sd (elem ss (load i))
                      nm (.name sd)
                      ty (LLVMStructCreateNamed ctx (to-cstr (.a cg) nm))
                      cs (primitive/alloc-stack CgStruct)]
                  (set! (.name cs) nm)
                  (set! (.fields cs) (load (field sd fields)))
                  (set! (.ty cs) ty)
                  (set! (.layout cs) (.layout sd))
                  (push! (mut (.structs cg)) (load cs)))
                (set! i (primitive/iadd (load i) 1)))))
    ; 0a2. register ALL sum names (opaque) + their variants FIRST, so type sizing
    ;      (sum_words) can size a sum that references a not-yet-bodied sum/struct —
    ;      Sizing comes from the whole-program def maps, independent of build order.
    (set! i 0)
    (loop (if (>= (load i) nu)
              (break)
              (do
                (let [sd (elem us (load i))
                      nm (.name sd)
                      ty (LLVMStructCreateNamed ctx (to-cstr (.a cg) nm))
                      (mut cs) (zeroed CgSum)]
                  (set! (.name cs) nm)
                  (set! (.variants cs) (load (field sd variants)))
                  (set! (.ty cs) ty)
                  (set! (.vstructs cs)
                        (box! (.a cg)
                              (ArrayList (ptr i8))
                              (ArrayList::new [(ptr i8)] (.a cg))))
                  (push! (mut (.sums cg)) cs))
                (set! i (primitive/iadd (load i) 1)))))
    ; 0b. set each sum's body { i32 tag, [words x i64] payload }.
    (set! i 0)
    (loop (if (>= (load i) nu)
              (break)
              (do
                (let [sd (elem us (load i))
                      words (cg-sum-words-def cg sd)
                      payload (LLVMArrayType2 (cg-sum-word-ty cg) words)
                      ty
                        (load (field (elem (field cg sums)
                                           (cg-sum-idx cg
                                                       (.name sd)))
                                     ty))
                      (mut bs) (ArrayList::new [(ptr i8)] (.a cg))]
                  (push! (mut bs) (cg-i32t cg))
                  (push! (mut bs) payload)
                  (cg-set-type-body! cg ty (carr (.a cg) (load bs)) 2 0))
                (set! i (primitive/iadd (load i) 1)))))
    ; 0c. Build/finalize bodies in by-value dependency order. LLVM cannot size
    ; opaque children, nor may a parent precede its child's final tail padding.
    ; LLVM IR has no type-level over-alignment: append tail padding until its
    ; by-value size/array stride matches LayoutDb. Allocation sites separately
    ; carry the database alignment via cg-force-align.
    (cg-finalize-struct-layouts! cg p)
    ; 0d. per-variant field structs.
    (set! i 0)
    (loop (if (>= (load i) nu)
              (break)
              (do
                (cg-fill-variant-structs cg
                                         (elem us (load i))
                                         (load i))
                (set! i (primitive/iadd (load i) 1)))))
    0))

;;; Rebuild a struct's LLVM body so its element offsets are the ones LayoutDb
;;; committed to, spelling out the gaps as i8 arrays and marking the result packed
;;; so LLVM re-pads nothing.
;;;
;;; This exists because LLVM has allocation alignment but no over-aligned struct
;;; TYPE. `(defstruct Over :layout (layout/Align 16) [(value i64)])` lowers to a body whose
;;; LLVM ABI alignment is 8, so a struct embedding it (an `OverOuter` wrapping an
;;; `(align 16)` struct, in a nested-sums test program) had LLVM place `inner` at 8
;;; where LayoutDb says 16, and the disagreement was a hard compile error with no way
;;; for the source to avoid it.
;;;
;;; Packing the type is safe precisely because the LLVM type's own element indices
;;; are not what addresses a field: cg-field GEPs by LayoutDb byte offset, and every
;;; allocation site (cg-struct-slot, the alloc-stack and static-storage paths) sets
;;; alignment from LayoutDb rather than inheriting the type's. What the type still
;;; owes the rest of codegen is its offsets and its size, which is what this restores.
(defn cg-pack-struct-body! [(cg (ptr Cg))
                            (sd (ptr StructDef))
                            (sp (ptr CgStruct))
                            (si i64)] (-> i64)
  (let [a (.a cg)
        ctx (cg-ctx cg)
        fs (load (field sd fields))
        nf (len (load fs))
        want (.size (struct-at (field cg layouts) si))
        (mut bs) (ArrayList::new [(ptr i8)] a)
        (mut elems) (ArrayList::new [i64] a)
        (mut cur) 0
        (mut fi) 0]
    (loop (if (>= (load fi) nf)
              (break)
              (do
                (let [off (field-offset (field cg layouts) si (load fi))
                      fty
                        (basic-ty cg (field (elem fs (load fi)) ty))]
                  (when (< off (load cur))
                    (cg-fail (sconcat a
                                      "LayoutDb places overlapping fields in: "
                                      (.name sd)))
                    0)
                  (when (> off (load cur))
                    (push! (mut bs)
                           (LLVMArrayType2 (LLVMInt8TypeInContext ctx)
                                           (primitive/isub off (load cur))))
                    0)
                  (push! (mut elems) (len (load bs)))
                  (push! (mut bs) fty)
                  ; Read the TargetData through cg every time: cg-set-type-body!
                  ; disposes the old one and installs a replacement, so any handle
                  ; cached across a body change is dangling.
                  (set! cur
                        (primitive/iadd off
                                        (LLVMABISizeOfType (load (field cg td))
                                                           fty))))
                (set! fi (primitive/iadd (load fi) 1)))))
    (when (> (load cur) want)
      (cg-fail (sconcat a
                        "LLVM struct layout exceeds LayoutDb size: "
                        (.name sd)))
      0)
    (when (< (load cur) want)
      (push! (mut bs)
             (LLVMArrayType2 (LLVMInt8TypeInContext ctx)
                             (primitive/isub want (load cur))))
      0)
    (cg-set-type-body! cg
                       (load (field sp ty))
                       (carr a (load bs))
                       (primitive/cast i32 (len (load bs)))
                       (: 1 i32))
    ; Packing is a repair, not a licence: re-check every field against LayoutDb so a
    ; layout this cannot express still fails loudly instead of silently miscompiling.
    (for [j 0 nf]
      (when (!= (LLVMOffsetOfElement (load (field cg td))
                                     (load (field sp ty))
                                     (primitive/cast i32 (get (load elems) j)))
                (field-offset (field cg layouts) si j))
        (cg-fail (sconcat a
                          "LLVM struct field layout disagrees with LayoutDb: "
                          (.name sd)))
        0)
      0)
    0))

(defn cg-finalize-struct-layouts! [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [a (.a cg)
        ctx (cg-ctx cg)
        ss (load (field p structs))
        n (len (load ss))
        (mut done) (ArrayList::new [i64] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do (push! (mut done) 0) (set! i (primitive/iadd (load i) 1)))))
    (let [(mut pass) 0]
      (loop (if (>= (load pass) (primitive/iadd n 1))
                (break)
                (do
                  (let [(mut si) 0]
                    (loop (if (>= (load si) n)
                              (break)
                              (do
                                (when (and (= (get (load done) (load si))
                                              0)
                                           (struct-ready? (field cg layouts)
                                                          (load si)
                                                          (mut done)))
                                  (let [sd (elem ss (load si))
                                        sp
                                          (elem (field cg structs)
                                                (load si))]
                                    (cg-set-struct-body cg sd)
                                    (match (.layout sd)
                                      (LBits [_ _] 0)
                                      (LExplicit [_ _ _] 0)
                                      (_ (let [fs (load (field sd fields))
                                               nf (len (load fs))
                                               (mut bs) (ArrayList::new [(ptr i8)] a)
                                               (mut fi) 0
                                               packed
                                                 (match (.layout sd)
                                                   (LPacked [] 1)
                                                   (_ 0))]
                                           (loop (if (>= (load fi) nf)
                                                     (break)
                                                     (do
                                                       (push! (mut bs)
                                                              (basic-ty cg
                                                                        (field (elem fs
                                                                                     (load fi))
                                                                               ty)))
                                                       (set! fi
                                                             (primitive/iadd (load fi)
                                                                             1)))))
                                           (cg-set-type-body! cg
                                                              (load (field sp
                                                                           ty))
                                                              (carr a (load bs))
                                                              (primitive/cast i32
                                                                              nf)
                                                              (primitive/cast i32
                                                                              packed))
                                           (let [actual
                                                   (LLVMABISizeOfType (load (field cg
                                                                                   td))
                                                                      (load (field sp
                                                                                   ty)))
                                                 want
                                                   (.size (struct-at (field cg
                                                                            layouts)
                                                                     (load si)))]
                                             (let [(mut natural) true
                                                   (mut oi) 0]
                                               (loop (if (>= (load oi) nf)
                                                         (break)
                                                         (do
                                                           (when (!= (LLVMOffsetOfElement (load (field cg
                                                                                                       td))
                                                                                          (load (field sp
                                                                                                       ty))
                                                                                          (primitive/cast i32
                                                                                                          (load oi)))
                                                                     (field-offset (field cg
                                                                                          layouts)
                                                                                   (load si)
                                                                                   (load oi)))
                                                             (set! natural
                                                                   false)
                                                             0)
                                                           (set! oi
                                                                 (primitive/iadd (load oi)
                                                                                 1)))))
                                               ; The unpacked body only reproduces LayoutDb when every field
                                               ; happens to land where LLVM's own rules put it. Where it does
                                               ; not — an embedded over-aligned struct, which LLVM has no type
                                               ; for — spell the padding out and pack it.
                                               (if (not (load natural))
                                                   (cg-pack-struct-body! cg
                                                                         sd
                                                                         sp
                                                                         (load si))
                                                   (do
                                                     (when (> actual want)
                                                       (cg-fail "LLVM struct layout exceeds LayoutDb size"))
                                                     (when (< actual want)
                                                       (do
                                                         (push! (mut bs)
                                                                (LLVMArrayType2 (LLVMInt8TypeInContext ctx)
                                                                                (primitive/isub want
                                                                                                actual)))
                                                         (cg-set-type-body! cg
                                                                            (load (field sp
                                                                                         ty))
                                                                            (carr a
                                                                                  (load bs))
                                                                            (primitive/cast i32
                                                                                            (len (load bs)))
                                                                            (primitive/cast i32
                                                                                            packed))
                                                         0))
                                                     0)))))))
                                    (set! (mut done) (load si) 1)))
                                (set! si (primitive/iadd (load si) 1))))))
                  (set! pass (primitive/iadd (load pass) 1))))))
    (for [j 0 n]
      (when (= (get (load done) j) 0)
        (cg-fail "cannot finalize recursive by-value struct layout")
        0)
      0)
    0))

(defn cg-set-struct-body [(cg (ptr Cg)) (sd (ptr StructDef))] (-> i64)
  (let [a (.a cg)
        ctx (cg-ctx cg)
        si (cg-struct-idx cg (.name sd))
        sp (elem (field cg structs) si)
        ty (load (field sp ty))
        fs (load (field sd fields))
        nf (len (load fs))]
    (match (.layout sd)
      (LBits [backing offs]
             (let [(mut bs) (ArrayList::new [(ptr i8)] a)]
               (push! (mut bs) (int-width ctx backing))
               (cg-set-type-body! cg ty (carr a (load bs)) 1 0)
               0))
      (LExplicit [offs sz al]
                 (let [(mut computed) 0
                       (mut sizes) (ArrayList::new [i64] a)
                       (mut i) 0]
                   ; Gather each field's ABI size, track the minimum total, and — when the
                   ; struct declares an explicit :size — reject any field that spills past it
                   ; (LAYOUT.md's "each field fits within :size"). Same error surface as a
                   ; failed static-assert: a plain `error: …` on stderr + exit(1), no object.
                   (loop (if (>= (load i) nf)
                             (break)
                             (do
                               (let [off (get (load offs) (load i))
                                     fsz
                                       (LLVMABISizeOfType (load (field cg td))
                                                          (basic-ty cg
                                                                    (field (elem fs
                                                                                 (load i))
                                                                           ty)))
                                     end (primitive/iadd off fsz)]
                                 (push! (mut sizes) fsz)
                                 (match sz
                                   (Some [s]
                                         (when (> end s)
                                           (cg-fail (sconcat3 a
                                                              "defstruct '"
                                                              (.name sd)
                                                              (sconcat3 a
                                                                        "': field '"
                                                                        (.name (elem fs
                                                                                     (load i)))
                                                                        (sconcat3 a
                                                                                  "' at :at "
                                                                                  (i64->str a
                                                                                            off)
                                                                                  (sconcat3 a
                                                                                            " occupies "
                                                                                            (i64->str a
                                                                                                      fsz)
                                                                                            (sconcat3 a
                                                                                                      " byte(s), past the declared :size "
                                                                                                      (i64->str a
                                                                                                                s)
                                                                                                      ""))))))))
                                   (None [] 0))
                                 (when (> end (load computed))
                                   (set! computed end)))
                               (set! i (primitive/iadd (load i) 1)))))
                   ; Overlap at UNEQUAL :at is an error (equal :at is an intentional union);
                   ; name both colliding fields.
                   (let [(mut p) 0]
                     (loop (if (>= (load p) nf)
                               (break)
                               (do
                                 (let [(mut q) (primitive/iadd (load p) 1)]
                                   (loop (if (>= (load q) nf)
                                             (break)
                                             (do
                                               (let [op
                                                       (get (load offs)
                                                            (load p))
                                                     oq
                                                       (get (load offs)
                                                            (load q))
                                                     ep
                                                       (primitive/iadd op
                                                                       (get (load sizes)
                                                                            (load p)))
                                                     eq
                                                       (primitive/iadd oq
                                                                       (get (load sizes)
                                                                            (load q)))]
                                                 (when (and (!= op oq)
                                                            (and (< op eq)
                                                                 (< oq ep)))
                                                   (cg-fail (sconcat3 a
                                                                      "defstruct '"
                                                                      (.name sd)
                                                                      (sconcat3 a
                                                                                "': fields '"
                                                                                (.name (elem fs
                                                                                             (load p)))
                                                                                (sconcat3 a
                                                                                          "' (:at "
                                                                                          (i64->str a
                                                                                                    op)
                                                                                          (sconcat3 a
                                                                                                    ") and '"
                                                                                                    (.name (elem fs
                                                                                                                 (load q)))
                                                                                                    (sconcat3 a
                                                                                                              "' (:at "
                                                                                                              (i64->str a
                                                                                                                        oq)
                                                                                                              ") overlap at unequal offsets (equal :at = union)"))))))))
                                               (set! q
                                                     (primitive/iadd (load q) 1))))))
                                 (set! p (primitive/iadd (load p) 1))))))
                   (let [size
                           (match sz
                             (Some [s]
                                   (if (> s (load computed)) s (load computed)))
                             (None [] (load computed)))
                         (mut bs) (ArrayList::new [(ptr i8)] a)
                         (mut used) (ArrayList::new [i64] a)
                         (mut union?) false
                         (mut ui) 0]
                     (loop (if (>= (load ui) nf)
                               (break)
                               (do
                                 (push! (mut used) 0)
                                 (let [(mut uj) 0]
                                   (loop (if (>= (load uj) (load ui))
                                             (break)
                                             (do
                                               (when (= (get (load offs)
                                                             (load uj))
                                                        (get (load offs)
                                                             (load ui)))
                                                 (set! union? true))
                                               (set! uj
                                                     (primitive/iadd (load uj)
                                                                     1))))))
                                 (set! ui (primitive/iadd (load ui) 1)))))
                     (if (load union?)
                         (push! (mut bs)
                                (LLVMArrayType2 (LLVMInt8TypeInContext ctx)
                                                size))
                         (let [(mut cursor) 0
                               (mut count) 0]
                           (loop (if (>= (load count) nf)
                                     (break)
                                     (let [(mut best) -1
                                           (mut best-off) 9223372036854775807
                                           (mut j) 0]
                                       (loop (if (>= (load j) nf)
                                                 (break)
                                                 (do
                                                   (when (and (= (get (load used)
                                                                      (load j))
                                                                 0)
                                                              (< (get (load offs)
                                                                      (load j))
                                                                 (load best-off)))
                                                     (set! best (load j))
                                                     (set! best-off
                                                           (get (load offs)
                                                                (load j))))
                                                   (set! j
                                                         (primitive/iadd (load j)
                                                                         1)))))
                                       (when (> (load best-off) (load cursor))
                                         (push! (mut bs)
                                                (LLVMArrayType2 (LLVMInt8TypeInContext ctx)
                                                                (primitive/isub (load best-off)
                                                                                (load cursor)))))
                                       (push! (mut bs)
                                              (basic-ty cg
                                                        (field (elem fs
                                                                     (load best))
                                                               ty)))
                                       (set! cursor
                                             (primitive/iadd (load best-off)
                                                             (get (load sizes)
                                                                  (load best))))
                                       (set! (mut used) (load best) 1)
                                       (set! count
                                             (primitive/iadd (load count) 1)))))
                           (when (< (load cursor) size)
                             (push! (mut bs)
                                    (LLVMArrayType2 (LLVMInt8TypeInContext ctx)
                                                    (primitive/isub size
                                                                    (load cursor)))))))
                     (cg-set-type-body! cg
                                        ty
                                        (carr a (load bs))
                                        (primitive/cast i32 (len (load bs)))
                                        1)
                     0)))
      (_ (let [(mut bs) (ArrayList::new [(ptr i8)] a)
               (mut i) 0
               packed (match (.layout sd) (LPacked [] 1) (_ 0))]
           (loop (if (>= (load i) nf)
                     (break)
                     (do
                       (push! (mut bs)
                              (basic-ty cg
                                        (field (elem fs (load i)) ty)))
                       (set! i (primitive/iadd (load i) 1)))))
           (cg-set-type-body! cg
                              ty
                              (carr a (load bs))
                              (primitive/cast i32 nf)
                              (primitive/cast i32 packed))
           0)))))

(defn cg-fill-variant-structs [(cg (ptr Cg)) (sd (ptr SumDef)) (ui i64)] (-> i64)
  (let [a (.a cg)
        ctx (cg-ctx cg)
        sp (elem (field cg sums) (cg-sum-idx cg (.name sd)))
        vs (load (field sd variants))
        nv (len (load vs))
        (mut i) 0]
    (loop (if (>= (load i) nv)
              (break)
              (do
                (let [vp (elem vs (load i))
                      fs (load (field vp fields))
                      nf (len (load fs))
                      (mut bs) (ArrayList::new [(ptr i8)] a)
                      (mut j) 0]
                  (loop (if (>= (load j) nf)
                            (break)
                            (do
                              (push! (mut bs)
                                     (basic-ty cg
                                               (field (elem fs
                                                            (load j))
                                                      ty)))
                              (set! j (primitive/iadd (load j) 1)))))
                  (push! (mut (load (field sp vstructs)))
                         (LLVMStructTypeInContext ctx
                                                  (carr a (load bs))
                                                  (primitive/cast i32 nf)
                                                  0)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

; 0e: static asserts.
(defn cg-eval-asserts [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [as (load (field p asserts))
        n (len (load as))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ap (elem as (load i))]
                  ; Mirror: a failed static-assert is
                  ; `Err("static assertion failed: {msg}")`, which `report`
                  ; renders as `error: static assertion failed: <msg>` and exits nonzero.
                  ; The message is spanless (a plain codegen string error), so it renders
                  ; like any other spanless Diag: bare `error: <msg>`. Codegen has no
                  ; Result channel here, so print the rendered line and exit(1) — the
                  ; observable behavior (stderr text + exit code, no object/link) is
                  ; byte-identical to the front-end returning the Err.
                  (when (= (const-eval cg (field ap cnd))
                           0)
                    (let [w (stderr)
                          msg
                            (sconcat (.a cg)
                                     "static assertion failed: "
                                     (.msg ap))]
                      (ps w "error: ")
                      (ps w msg)
                      (wb w 10)
                      (exit 1)
                      0)))
                (set! i (primitive/iadd (load i) 1)))))
    0))

; helper: store a (name -> Type) into a CgRet list and (name cc params ret) into sigs.
(defn cg-record-callable [(cg (ptr Cg))
                          (name (slice u8))
                          (cc (slice u8))
                          (params (ptr (ArrayList Type)))
                          (ret Type)] (-> i64)
  (let [(mut r) (zeroed CgRet)]
    (set! (.name r) name)
    (set! (.ty r) ret)
    (push! (mut (.rets cg)) r))
  (let [(mut s) (zeroed CgSig)]
    (set! (.name s) name)
    (set! (.cc s) cc)
    (set! (.params s) params)
    (set! (.ret s) ret)
    (push! (mut (.sigs cg)) s))
  0)

(defn cg-add-func-ty [(cg (ptr Cg))
                      (name (slice u8))
                      (fv (ptr i8))
                      (fnty (ptr i8))] (-> i64)
  (let [(mut r) (zeroed CgFunc)]
    (set! (.name r) name)
    (set! (.val r) fv)
    (set! (.fnty r) fnty)
    (push! (mut (.funcs cg)) r))
  0)

(defn cg-add-func [(cg (ptr Cg)) (name (slice u8)) (fv (ptr i8))] (-> i64)
  (cg-add-func-ty cg name fv (primitive/cast (ptr i8) 0)))

; `last-component` moved to check.coil (a pure path/string helper used by both
; check and codegen); codegen imports check, so it resolves here unchanged. This
; keeps check.coil free of any codegen (LLVM) dependency so the frontend can be
; built into an LLVM-free (arm64-only) compiler. See src/compiler/main_a64.coil.
(defn ty-list-has-aggregate [(cg (ptr Cg)) (l (ptr (ArrayList Type)))] (-> bool)
  (let [n (len (load l))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (cg-abi-aggregate? cg (elem l (load i)))
                  (set! r true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

; A value the C ABI classifies as an aggregate: a struct (not a bit-struct, which
; is one integer word), a fixed array, or a sum. Each travels like a C struct:
; in registers up to 16 bytes (an array of up to four floats as an HFA),
; otherwise through a hidden result pointer, which is how the native backends
; and native_call always passed them. A sum is laid out as integer words -- its
; tag, then its payload. Returning a sum or an array as an LLVM first-class value
; instead disagreed with the native backends, and made instruction selection
; expand a large one element by element (seconds for an array of 32 structs).
(defn cg-abi-aggregate? [(cg (ptr Cg)) (t (ptr Type))] (-> bool)
  (match (load t)
    (TStruct [nm]
             (let [si (cg-struct-idx cg nm)]
               (if (< si 0)
                   (>= (cg-sum-idx cg nm) 0)
                   (match (.layout (elem (field cg structs) si))
                     (LBits [b o] false)
                     (_ true)))))
    (TArray [_ _] true)
    (_ false)))

; ============================ C-ABI struct classification ====================
; Faithful (AArch64 AAPCS64 path) + the codegen ABI helpers.
; The x86_64 SysV path is a hard-error stub (the self-host targets AArch64).

; arch from a triple's first '-'-separated component.
(defn arch-from-triple [(triple (slice u8))] (-> i64)
  (let [n (len triple)
        (mut i) 0]
    (loop (if (or (>= (load i) n)
                  (= (primitive/cast i64 (get triple (load i)))
                     45))
              (break)
              (set! i (primitive/iadd (load i) 1))))
    (let [a0 (substr triple 0 (load i))]
      (cond (or (= a0 "x86_64") (= a0 "amd64")) 0
            (or (= a0 "aarch64") (= a0 "arm64") (= a0 "arm64e")) 1
            (or (= a0 "wasm32") (= a0 "wasm64")) 2
            (= a0 "riscv32") 3
            :else  ; wasm ABI class is width-agnostic; word width comes from the triple's datalayout
              (do (unimplemented "abi: unsupported target architecture") -1)))))

(defn target-word-bytes [(triple (slice u8))] (-> i64)
  (if (or (starts-with triple "wasm32-") (starts-with triple "riscv32-")) 4 8))

; LLVM subtarget-feature string for a triple's TargetMachine, as a C string for
; LLVMCreateTargetMachine's `Features` arg. wasm64's 64-bit memory is IMPLIED by the
; triple's datalayout (there is no `+memory64` subtarget feature in LLVM), so the only
; wasm feature we opt into is `+tail-call` (Wasm 3.0 tail calls — LLVM lowers `musttail`
; to `return_call`). Everything else takes LLVM's defaults (empty features).
;;; The type LLVM's wasm backend lowers to `externref`. LLVM 23 spells it as the
;;; target type `target("wasm.externref")`; earlier versions as a pointer in address
;;; space 10. Each rejects or miscompiles the other's spelling: LLVM 22 cannot
;;; allocate the target type, and LLVM 23 reads addrspace(10) as an ordinary pointer
;;; and stores it to linear memory a byte at a time.
(defn llvm-externref-type [(ctx (ptr i8))] (-> (ptr i8))
  (let [(mut major) (: 0 u32)
        (mut minor) (: 0 u32)
        (mut patch) (: 0 u32)]
    (LLVMGetVersion (mut major) (mut minor) (mut patch))
    (if (>= major (: 23 u32))
        (LLVMTargetExtTypeInContext ctx
                                    c"wasm.externref"
                                    (primitive/cast (ptr (ptr i8)) 0)
                                    (: 0 u32)
                                    (primitive/cast (ptr u32) 0)
                                    (: 0 u32))
        (LLVMPointerTypeInContext ctx 10))))

(defn llvm-cpu [(triple (ptr i8))] (-> (ptr i8))
  (let [s (from-cstr triple)]
    (if (match (find s "riscv32") (Some [_] true) (None [] false))
        c"generic-rv32"
        c"generic")))

; Bare-metal aarch64 starts with the MMU off, where all memory is Device memory
; and every unaligned access faults, so a `-none` object must not merge narrow
; accesses into wider unaligned ones. (Linux and Darwin enable unaligned access.)
(defn llvm-cpu-features [(triple (ptr i8))] (-> (ptr i8))
  (let [s (from-cstr triple)]
    (cond (match (find s "riscv32") (Some [_] true) (None [] false)) c"+m,+c"
          (and (starts-with s "aarch64") (triple-freestanding s))
            c"+strict-align"
          :else c"")))

(defn llvm-reloc-model [(triple (ptr i8))] (-> i32)
  (let [s (from-cstr triple)]
    (if (match (find s "riscv32") (Some [_] true) (None [] false)) 1 2)))

; smallest power-of-two-byte int width (bits) covering `bytes` data bytes.
(defn abi-int-bits-for-bytes [(bytes i64)] (-> i64)
  (cond (<= bytes 1) 8
        (= bytes 2) 16
        (<= bytes 4) 32
        :else 64))

; abi_struct: CgStruct index of a non-bits by-value struct type, else -1.

; resolve_struct: the field list of a named struct (null if not a struct).
(defn cg-resolve-fields [(cg (ptr Cg)) (name (slice u8))] (-> (ptr (ArrayList Field)))
  (let [si (cg-struct-idx cg name)]
    (if (< si 0)
        (primitive/cast (ptr (ArrayList Field)) 0)
        (load (field (elem (field cg structs) si) fields)))))

; ---- HFA detection (faithful; never fires in the corpus = no float-only structs)
(defn abi-hfa-walk-ty [(cg (ptr Cg))
                       (ty (ptr Type))
                       (found (ptr (Option Type)))
                       (count (ptr i64))] (-> bool)
  (let [a (.a cg)]
    (match (load ty)
      (TFloat [b]
              (let [(mut ok) true]
                (match (load found)
                  (None [] (do (set! found (Some (load ty))) 0))
                  (Some [prev]
                        (unless (type-eq (box-type a prev) ty)
                          (set! ok false)
                          0)))
                (set! count (primitive/iadd (load count) 1))
                (and (load ok) (<= (load count) 4))))
      (TArray [elem n-extent]
              (let [n (extent-value n-extent)]
                (let [(mut ok) true
                      (mut i) 0]
                  (loop (if (or (>= (load i) n) (not (load ok)))
                            (break)
                            (do
                              (when (not (abi-hfa-walk-ty cg elem found count))
                                (set! ok false)
                                0)
                              (set! i (primitive/iadd (load i) 1)))))
                  (load ok))))
      (TStruct [nm]
               (let [si (cg-struct-idx cg nm)]
                 (if (< si 0) false (abi-hfa-walk-record cg si found count))))
      (_ false))))

(defn abi-hfa-walk-fields [(cg (ptr Cg))
                           (fields (ptr (ArrayList Field)))
                           (found (ptr (Option Type)))
                           (count (ptr i64))] (-> bool)
  (let [n (len (load fields))
        (mut ok) true
        (mut i) 0]
    (loop (if (or (>= (load i) n) (not (load ok)))
              (break)
              (do
                (when (not (abi-hfa-walk-ty cg
                                            (field (elem fields
                                                         (load i))
                                                   ty)
                                            found
                                            count))
                  (set! ok false)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (load ok)))

; returns the HFA member count (0 if not an HFA); writes the FP element type to
; out-fty. A sum is integer words, so never an HFA (the walk rejects it).
(defn abi-hfa [(cg (ptr Cg)) (t (ptr Type)) (out-fty (ptr Type))] (-> i64)
  (let [found (primitive/alloc-stack (Option Type))
        count (primitive/alloc-stack i64)]
    (set! found (None [Type]))
    (set! count 0)
    (unless (not (abi-hfa-walk-ty cg t found count))
      (match (load found)
        (None [] 0)
        (Some [t]
              (when (and (>= (load count) 1)
                         (<= (load count) 4))
                (set! out-fty t)
                (load count)))))))

;; Explicit equal-offset fields are union alternatives: all alternatives must
;; have the same FP base type, but contribute the maximum member count, not the
;; sum. Distinct storage groups and enclosing structs still add their counts.
;; A valid HFA has at most four nonempty groups, so fixed stack state suffices.
(defn abi-hfa-walk-record [(cg (ptr Cg))
                           (si i64)
                           (found (ptr (Option Type)))
                           (count (ptr i64))] (-> bool)
  (let [record (elem (field cg structs) si)
        fields (.fields record)
        positions (primitive/alloc-stack (array i64 4))
        sizes (primitive/alloc-stack (array i64 4))
        part (primitive/alloc-stack i64)
        (mut groups) 0
        (mut total) 0]
    (block :walk
           (for [i 0 (len (load fields))]
             (store! part 0)
             (unless (abi-hfa-walk-ty cg
                                      (field (elem fields i) ty)
                                      found
                                      part)
               (return-from :walk false))
             (when (> (load part) 0)
               (let [offset (field-offset (field cg layouts) si i)
                     (mut group) -1]
                 (for [j 0 (load groups)]
                   (when (= (load (index positions j)) offset)
                     (set! group j)
                     0)
                   0)
                 (when (= (load group) -1)
                   (when (= (load groups) 4) (return-from :walk false))
                   (set! group (load groups))
                   (set! groups (+ (load groups) 1))
                   (store! (index positions (load group)) offset)
                   (store! (index sizes (load group)) 0)
                   0)
                 (let [prior (load (index sizes (load group)))]
                   (when (> (load part) prior)
                     (set! total (+ (load total) (- (load part) prior)))
                     (store! (index sizes (load group)) (load part))
                     0))
                 (when (> (+ (load count) (load total)) 4)
                   (return-from :walk false)))
               0)
             0)
           (store! count (+ (load count) (load total)))
           true)))

; a one-element slot list (the AArch64 coercion is always a single slot).
(defn abi-slots1 [(cg (ptr Cg)) (t (ptr i8))] (-> (ptr (ArrayList (ptr i8))))
  (let [a (.a cg)
        (mut xs) (ArrayList::new [(ptr i8)] a)]
    (push! (mut xs) t)
    (box-al [(ptr i8)] a (load xs))))

; ---- SysV AMD64: the byte-class flatten + eightbyte-coercion ----
; SysV "merge" rule for two classes covering the same byte: INTEGER dominates SSE,
; SSE dominates NONE (0=None 1=Integer 2=Sse).
(defn abi-merge [(x i64) (y i64)] (-> i64)
  (if (or (= x 1) (= y 1))
      1
      (when (or (= x 2) (= y 2)) 2)))

(defn abi-align-up [(x i64) (al i64)] (-> i64)
  (if (= al 0)
      x
      (primitive/imul (primitive/udiv (primitive/iadd x (primitive/isub al 1))
                                      al)
                      al)))

; Flatten CgStruct `si`'s fields into scalar leaves at absolute byte offsets,
; recursing into nested structs and arrays. Offsets come from
; the struct's REAL LayoutDb offsets — never LLVM's natural offsets, which cannot
; express Coil's explicit/packed/over-aligned nesting contract.
(defn abi-flatten-cs [(cg (ptr Cg)) (si i64) (base i64) (out (ptr AbiLeafBox))] (-> i64)
  (let [td (load (field cg td))
        sp (elem (field cg structs) si)
        fs (load (field sp fields))
        n (len (load fs))
        (mut i) 0]
    (match (.layout sp)
      (LBits [backing offs]
             ; bits struct: one integer backing word (unreachable via cg-abi-aggregate?,
             ; which reports bits structs as scalars — kept total for direct callers).
             (let [(mut lf) (zeroed AbiLeaf)]
               (set! (.offset lf) base)
               (set! (.size lf) (primitive/udiv backing 8))
               (set! (.cls lf) 1)
               (set! (.is_f32 lf) false)
               (push! (mut (.items out)) lf)
               0))
      (LExplicit [offs sz al]
                 (do
                   (loop (if (>= (load i) n)
                             (break)
                             (do
                               (abi-flatten-type cg
                                                 (field (elem fs
                                                              (load i))
                                                        ty)
                                                 (primitive/iadd base
                                                                 (get (load offs)
                                                                      (load i)))
                                                 out)
                               (set! i (primitive/iadd (load i) 1)))))
                   0))
      (_ (do
           (loop (if (>= (load i) n)
                     (break)
                     (do
                       (abi-flatten-type cg
                                         (field (elem fs (load i))
                                                ty)
                                         (primitive/iadd base
                                                         (field-offset (field cg
                                                                              layouts)
                                                                       si
                                                                       (load i)))
                                         out)
                       (set! i (primitive/iadd (load i) 1)))))
           0)))))

(defn abi-flatten-type [(cg (ptr Cg))
                        (ty (ptr Type))
                        (offset i64)
                        (out (ptr AbiLeafBox))] (-> i64)
  (let [a (.a cg)
        td (load (field cg td))]
    (match (load ty)
      (TFloat [bits]
              (let [(mut lf) (zeroed AbiLeaf)]
                (set! (.offset lf) offset)
                (set! (.size lf) (primitive/udiv bits 8))
                (set! (.cls lf) 2)
                (set! (.is_f32 lf) (= bits 32))
                (push! (mut (.items out)) lf)
                0))
      (TArray [elem n-extent]
              (let [n (extent-value n-extent)]
                (let [esz (LLVMABISizeOfType td (basic-ty cg elem))
                      (mut i) 0]
                  (loop (if (>= (load i) n)
                            (break)
                            (do
                              (abi-flatten-type cg
                                                elem
                                                (primitive/iadd offset
                                                                (primitive/imul (load i)
                                                                                esz))
                                                out)
                              (set! i (primitive/iadd (load i) 1)))))
                  0)))
      ; A sum is laid out as integer words (tag, then payload words), so every byte
      ; of it classifies INTEGER, exactly as its LLVM word-array type does.
      (TStruct [nm]
               (let [si (cg-struct-idx cg nm)]
                 (cond (>= si 0)
                         (abi-flatten-cs cg si offset out)
                       (>= (cg-sum-idx cg nm) 0)
                         (let [(mut lf) (zeroed AbiLeaf)]
                           (set! (.offset lf) offset)
                           (set! (.size lf)
                                 (LLVMABISizeOfType td (basic-ty cg ty)))
                           (set! (.cls lf) 1)
                           (set! (.is_f32 lf) false)
                           (push! (mut (.items out)) lf)
                           0)
                       :else
                         (do
                           (ps (stderr) "SysV ABI: unknown nominal field type ")
                           (ps (stderr) nm)
                           (wb (stderr) 10)
                           (unimplemented "SysV ABI: nested type is neither a struct nor a sum")
                           0))))
      ; A vector occupying one eightbyte is an SSE-class aggregate field. Wider
      ; vectors need SSEUP classification and cannot be flattened into two
      ; independent SSE arguments. A slice is the
      ; ordinary two-word `{data, len}` value and both words classify INTEGER.
      (TVec [el n]
            (let [size (LLVMABISizeOfType td (basic-ty cg ty))]
              (if (<= size 8)
                  (let [(mut lf) (zeroed AbiLeaf)]
                    (set! (.offset lf) offset)
                    (set! (.size lf) size)
                    (set! (.cls lf) 2)
                    (set! (.is_f32 lf) false)
                    (push! (mut (.items out)) lf)
                    0)
                  (do
                    (unimplemented "SysV ABI: vectors wider than one eightbyte need SSEUP classification")
                    0))))
      (TSlice [el]
              (let [(mut data) (zeroed AbiLeaf)
                    (mut len) (zeroed AbiLeaf)]
                (set! (.offset data) offset)
                (set! (.size data) 8)
                (set! (.cls data) 1)
                (set! (.is_f32 data) false)
                (push! (mut (.items out)) data)
                (set! (.offset len) (primitive/iadd offset 8))
                (set! (.size len) 8)
                (set! (.cls len) 1)
                (set! (.is_f32 len) false)
                (push! (mut (.items out)) len)
                0))
      (TApp [nm args]
            (do
              (unimplemented "SysV ABI: generic type survived to ABI classification (compiler bug)")
              0))
      (TNever []
              (do
                (unimplemented "SysV ABI: Never type has no ABI representation")
                0))
      (TCode []
             (do
               (unimplemented "SysV ABI: Code type has no ABI representation")
               0))
      (TExternRef []
                  (do
                    (unimplemented "SysV ABI: externref has no SysV representation")
                    0))
      (TVoid []
             (do
               (unimplemented "SysV ABI: void is a return type only; never a field/by-value param")
               0))
      ; Int, Bool, Ptr, Ref, Fn -> a single INTEGER leaf.
      (_ (let [(mut lf) (zeroed AbiLeaf)]
           (set! (.offset lf) offset)
           (set! (.size lf) (LLVMABISizeOfType td (basic-ty cg ty)))
           (set! (.cls lf) 1)
           (set! (.is_f32 lf) false)
           (push! (mut (.items out)) lf)
           0)))))

; true if any leaf is a 32-bit float starting exactly at byte `off`.
(defn abi-leaves-has-f32-at [(leaves (ptr (ArrayList AbiLeaf))) (off i64)] (-> bool)
  (let [n (len (load leaves))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [lf (elem leaves (load i))]
                  (when (and (.is_f32 lf)
                             (= (.offset lf)
                                off))
                    (set! r true)
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn abi-classify-sysv [(cg (ptr Cg))
                         (t (ptr Type))
                         (sty (ptr i8))
                         (size i64)
                         (align i32)] (-> (ptr StructAbi))
  (let [a (.a cg)
        ctx (cg-ctx cg)
        p (box! a StructAbi (zeroed StructAbi))]
    (set! (.llvm_ty p) sty)
    (set! (.size p) size)
    (set! (.align p) align)
    ; Structs larger than two eightbytes (16 bytes) are passed in memory.
    (if (> size 16)
        (do
          (set! (.arg p) (ACIndirect align))
          (set! (.ret p) (ACIndirect align)))
        (let [lb (box! a AbiLeafBox (zeroed AbiLeafBox))]
          (set! (.items lb) (ArrayList::new [AbiLeaf] a))
          (abi-flatten-type cg t 0 lb)
          (let [leaves (field lb items)
                nbytes size
                (mut bytes) (ArrayList::new [i64] a)
                (mut bi) 0]
            ; per-byte class array (None), then merge each leaf onto its byte range.
            (loop (if (>= (load bi) nbytes)
                      (break)
                      (do
                        (push! (mut bytes) 0)
                        (set! bi (primitive/iadd (load bi) 1)))))
            (let [nleaves (len (load leaves))
                  (mut li) 0]
              (loop (if (>= (load li) nleaves)
                        (break)
                        (do
                          (let [lf (elem leaves (load li))
                                lo (.offset lf)
                                hi
                                  (primitive/iadd (.offset lf)
                                                  (.size lf))]
                            (when (> hi nbytes)
                              (unimplemented "SysV ABI: scalar runs past struct size")
                              0)
                            (let [(mut b) lo]
                              (loop (if (>= (load b) hi)
                                        (break)
                                        (do
                                          (set! (mut bytes)
                                                (load b)
                                                (abi-merge (get (load bytes)
                                                                (load b))
                                                           (.cls lf)))
                                          (set! b (primitive/iadd (load b) 1)))))))
                          (set! li (primitive/iadd (load li) 1)))))
              ; collapse into eightbyte coerced slots.
              (let [neb (primitive/udiv (primitive/iadd nbytes 7) 8)
                    (mut slots) (ArrayList::new [(ptr i8)] a)
                    (mut eb) 0]
                (loop (if (>= (load eb) neb)
                          (break)
                          (do
                            (let [lo (primitive/imul (load eb) 8)
                                  hi
                                    (if (< (primitive/iadd (primitive/imul (load eb)
                                                                           8)
                                                           8)
                                           nbytes)
                                        (primitive/iadd (primitive/imul (load eb)
                                                                        8)
                                                        8)
                                        nbytes)
                                  (mut cls) 0
                                  (mut bb) 0]
                              (set! bb lo)
                              (loop (if (>= (load bb) hi)
                                        (break)
                                        (do
                                          (set! cls
                                                (abi-merge (load cls)
                                                           (get (load bytes)
                                                                (load bb))))
                                          (set! bb (primitive/iadd (load bb) 1)))))
                              (let [used (primitive/isub hi lo)
                                    slot
                                      (if (= (load cls) 2)
                                          ; SSE eightbyte: two distinct low/high 4-byte floats -> <2 x float>;
                                          ; one double (or 5..8 SSE bytes) -> double; a single 4-byte float -> float.
                                          (if (and (= used
                                                      8)
                                                   (and (abi-leaves-has-f32-at leaves
                                                                               lo)
                                                        (abi-leaves-has-f32-at leaves
                                                                               (primitive/iadd lo
                                                                                               4))))
                                              (LLVMVectorType (LLVMFloatTypeInContext ctx)
                                                              2)
                                              (if (> used
                                                     4)
                                                  (LLVMDoubleTypeInContext ctx)
                                                  (LLVMFloatTypeInContext ctx)))
                                          ; INTEGER (or padding-only) eightbyte -> smallest pow2 int covering its data bytes.
                                          (int-width ctx
                                                     (abi-int-bits-for-bytes used)))]
                                (push! (mut slots) slot)))
                            (set! eb (primitive/iadd (load eb) 1)))))
                ; SysV arg and ret coerce to the SAME slots.
                (let [sp (box-al [(ptr i8)] a (load slots))]
                  (set! (.arg p) (ACDirect sp))
                  (set! (.ret p) (ACDirect sp))))))))
    p))

; classify an aggregate (see cg-abi-aggregate?) for the C ABI (StructAbi by
; pointer). A struct's own layout drives the SysV flatten (packed/explicit
; offsets) and the HFA test; a sum is integer words and has no FP members.
(defn abi-classify [(cg (ptr Cg)) (t (ptr Type))] (-> (ptr StructAbi))
  (let [si
          (match (load t)
            (TStruct [nm] (cg-struct-idx cg nm))
            (TArray [_ _] -1)
            (_ (do (cg-bug "abi-classify: not an aggregate type") -1)))
        sty (basic-ty cg t)
        size (cg-layout-size cg t)
        align (primitive/cast i32 (cg-layout-align cg t))]
    (cond (= size 0)
            ; An empty struct: every C ABI here passes and returns nothing for it.
            (let [p (box! (.a cg) StructAbi (zeroed StructAbi))]
              (set! (.llvm_ty p) sty)
              (set! (.size p) size)
              (set! (.align p) align)
              (set! (.arg p)
                    (ACDirect (box-al [(ptr i8)]
                                      (.a cg)
                                      (ArrayList::new [(ptr i8)] (.a cg)))))
              (set! (.ret p)
                    (ACDirect (box-al [(ptr i8)]
                                      (.a cg)
                                      (ArrayList::new [(ptr i8)] (.a cg)))))
              p)
          (= (.arch cg) 1)
            (abi-classify-aapcs64 cg t sty size align)
          (= (.arch cg) 2)
            (abi-classify-wasm cg t sty size align)
          (= (.arch cg) 3)
            (abi-classify-rv32 cg sty size align)
          :else (abi-classify-sysv cg t sty size align))))

; clang's WebAssembly C ABI represents aggregate parameters and results in linear
; memory: a callee receives aggregate arguments through byval pointers and writes
; an aggregate result through a leading sret pointer. The exception is a struct
; whose only data is one scalar (through nesting and one-element arrays, with no
; padding): it travels as that scalar, in both directions. Never reuse a
; register ABI's size-based coercions here: opaque LLVM pointers can conceal the
; disagreement in IR, but Wasm validates the exact call_indirect function type
; at runtime.
(defn abi-classify-wasm [(cg (ptr Cg))
                         (t (ptr Type))
                         (sty (ptr i8))
                         (size i64)
                         (align i32)] (-> (ptr StructAbi))
  (let [p (box! (.a cg) StructAbi (zeroed StructAbi))
        single (cg-single-element cg t)]
    (set! (.llvm_ty p) sty)
    (set! (.size p) size)
    (set! (.align p) align)
    (if (and (!= (primitive/cast i64 single) 0)
             (= (LLVMABISizeOfType (load (field cg td)) single) size))
        (do
          (set! (.arg p) (ACDirect (abi-slots1 cg single)))
          (set! (.ret p) (ACDirect (abi-slots1 cg single))))
        (do
          (set! (.arg p) (ACIndirect align))
          (set! (.ret p) (ACIndirect align))))
    p))

;;; clang's "single-element struct": the LLVM type of the one scalar a struct's
;;; data amounts to, ignoring empty fields and seeing through nested structs and
;;; one-element arrays; null when it has more, or none, or is a bit-struct.
(defn cg-single-element [(cg (ptr Cg)) (t (ptr Type))] (-> (ptr i8))
  (let [none (primitive/cast (ptr i8) 0)]
    (match (load t)
      (TStruct [nm]
               (let [si (cg-struct-idx cg nm)]
                 (if (< si 0)
                     none
                     (let [sp (elem (field cg structs) si)]
                       (match (.layout sp)
                         (LBits [_ _] none)
                         (_ (let [fs (load (field sp fields))
                                  (mut found) none
                                  (mut count) 0]
                              (for [i 0 (len (load fs))]
                                (let [ft (field (elem fs i) ty)]
                                  (unless (= (cg-layout-size cg ft) 0)
                                    (set! count (+ count 1))
                                    (set! found (cg-single-element cg ft)))))
                              (if (= count 1) found none))))))))
      (TArray [elem n]
              (if (= (extent-value n) 1) (cg-single-element cg elem) none))
      (TInt [_ _] (basic-ty cg t))
      (TFloat [_] (basic-ty cg t))
      (TBool [] (basic-ty cg t))
      (TPtr [_] (basic-ty cg t))
      (TFn [_ _ _] (basic-ty cg t))
      (_ none))))

(defn abi-classify-rv32 [(cg (ptr Cg)) (sty (ptr i8)) (size i64) (align i32)] (-> (ptr StructAbi))
  (let [a (.a cg)
        p (box! a StructAbi (zeroed StructAbi))
        i32t (cg-i32t cg)]
    (set! (.llvm_ty p) sty)
    (set! (.size p) size)
    (set! (.align p) align)
    (if (> size 8)
        (do
          (set! (.arg p) (ACIndirect align))
          (set! (.ret p) (ACIndirect align)))
        (let [slots
                (if (<= size 4)
                    (abi-slots1 cg i32t)
                    (abi-slots1 cg (LLVMArrayType2 i32t 2)))]
          (set! (.arg p) (ACDirect slots))
          (set! (.ret p) (ACDirect slots))))
    p))

(defn abi-classify-aapcs64 [(cg (ptr Cg))
                            (t (ptr Type))
                            (sty (ptr i8))
                            (size i64)
                            (align i32)] (-> (ptr StructAbi))
  (let [a (.a cg)
        ctx (cg-ctx cg)
        p (box! a StructAbi (zeroed StructAbi))
        (mut fty) (zeroed Type)
        nhfa
          (abi-hfa cg
                   t
                   (mut fty))]
    (set! (.llvm_ty p) sty)
    (set! (.size p) size)
    (set! (.align p) align)
    (if (> nhfa 0)
        (let [elem
                (basic-ty cg
                          (mut fty))
              arr (LLVMArrayType2 elem nhfa)]
          (set! (.arg p) (ACDirect (abi-slots1 cg arr)))
          ;; The physical storage of a union is a byte array, not an HFA LLVM
          ;; type. Coerce results to the same FP aggregate as arguments so LLVM
          ;; uses the required FP return registers for unions and nesting too.
          (set! (.ret p) (ACDirect (abi-slots1 cg arr))))
        (if (> size 16)
            (do
              (set! (.arg p) (ACIndirect align))
              (set! (.ret p) (ACIndirect align)))
            (do
              (set! (.arg p)
                    (ACDirect (abi-slots1 cg
                                          (if (<= size 8)
                                              (cg-i64t cg)
                                              (LLVMArrayType2 (cg-i64t cg) 2)))))
              (set! (.ret p)
                    (ACDirect (abi-slots1 cg
                                          (if (<= size 8)
                                              (int-width ctx
                                                         (abi-int-bits-for-bytes size))
                                              (LLVMArrayType2 (cg-i64t cg) 2))))))))
    p))

; the single LLVM type a Direct return coerces to.
(defn abi-direct-return-type [(cg (ptr Cg)) (sa (ptr StructAbi))] (-> (ptr i8))
  (match (.ret sa)
    (ACDirect [slots]
              (let [n (len (load slots))]
                (if (= n 1)
                    (get (load slots) 0)
                    (if (= n 2)
                        (let [a (.a cg)
                              (mut fs) (ArrayList::new [(ptr i8)] a)]
                          (push! (mut fs) (get (load slots) 0))
                          (push! (mut fs) (get (load slots) 1))
                          (LLVMStructTypeInContext (cg-ctx cg)
                                                   (carr a (load fs))
                                                   2
                                                   0))
                        (if (= n 0)
                            ; an empty struct is returned as nothing
                            (LLVMVoidTypeInContext (cg-ctx cg))
                            (do
                              (unimplemented "abi: direct return in more than two slots")
                              (primitive/cast (ptr i8) 0)))))))
    (ACIndirect [al]
                (do
                  (unimplemented "abi: direct-return-type on an indirect class")
                  (primitive/cast (ptr i8) 0)))))

(defn abi-ret-indirect? [(sa (ptr StructAbi))] (-> bool)
  (match (.ret sa) (ACIndirect [a] true) (_ false)))

; ---- csigs map (only struct-by-value callables) ----
(defn cg-csig [(cg (ptr Cg)) (nm (slice u8))] (-> (ptr CSig))
  (let [n (len (.csigs cg))
        (mut i) 0
        (mut r) (primitive/cast (ptr CSig) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (elem (field cg csigs) (load i))]
                  (when (= (.name ep) nm)
                    (set! r
                          (load (field ep
                                       sig)))
                    0))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn cg-has-csig [(cg (ptr Cg)) (nm (slice u8))] (-> bool)
  (!= (primitive/cast i64 (cg-csig cg nm)) 0))

(defn cg-add-csig [(cg (ptr Cg)) (nm (slice u8)) (sig (ptr CSig))] (-> i64)
  (let [(mut e) (zeroed CSigEntry)]
    (set! (.name e) nm)
    (set! (.sig e) sig)
    (push! (mut (.csigs cg)) e))
  0)

(defn cg-argabi [(sig (ptr CSig)) (i i64)] (-> ArgAbiK)
  (let [args (load (field sig args))]
    (if (< i (len (load args))) (get (load args) i) (AAScalar))))

; ---- SysV register accounting for by-value aggregates -----------------------
; An aggregate that classifies ACDirect is only ACTUALLY passed in registers if
; enough of them are still free at its position in the argument list. SysV says
; that when either of its eightbytes has no register left, the WHOLE aggregate
; goes in memory instead — it does not half-spill. Clang implements exactly this
; (compare `f(F2)` -> `double, double` against
; `f(double x7..., F2)` -> `ptr byval(%F2)`), and getting it wrong is invisible
; until a struct lands after enough scalars to exhaust one register file:
; the callee then reads one eightbyte from the last free register and the other
; from the stack, i.e. from the wrong place.
;
; `slot-is-sse?` reads the class back off the coerced slot type the classifier
; already computed: float/double/vector slots are SSE eightbytes, integer slots
; are INTEGER ones.
(defn slot-is-sse? [(t (ptr i8))] (-> bool)
  (let [k (LLVMGetTypeKind t)]
    (or (= k (: 2 i32))
        (= k (: 3 i32))
        (= k (: 13 i32)))))  ; float / double / vector

; How many INTEGER and SSE registers an ACDirect aggregate would consume.
(defn abi-slot-regs [(slots (ptr (ArrayList (ptr i8))))
                     (gpp (ptr i64))
                     (ssep (ptr i64))] (-> i64)
  (let [n (len (load slots))
        (mut k) 0]
    (set! gpp 0)
    (set! ssep 0)
    (loop (if (>= (load k) n)
              (break)
              (do
                (if (slot-is-sse? (get (load slots) (load k)))
                    (set! ssep (primitive/iadd (load ssep) 1))
                    (set! gpp (primitive/iadd (load gpp) 1)))
                (set! k (primitive/iadd (load k) 1)))))
    0))

; ---- c_signature: the C-ABI realization of a (params -> ret) signature ----
(defn c-signature [(cg (ptr Cg))
                   (params (ptr (ArrayList Type)))
                   (ret (ptr Type))
                   (variadic bool)] (-> (ptr CSig))
  (let [a (.a cg)
        ctx (cg-ctx cg)
        sig (box! a CSig (zeroed CSig))
        (mut lp) (ArrayList::new [(ptr i8)] a)
        (mut argl) (ArrayList::new [ArgAbiK] a)
        (mut rty) (primitive/cast (ptr i8) 0)]  ; null = void return type
    (set! (.sret sig) (primitive/cast (ptr StructAbi) 0))
    (set! (.ret_direct sig) (primitive/cast (ptr StructAbi) 0))
    ; return classification
    (do
      (if (cg-abi-aggregate? cg ret)
          (let [sa (abi-classify cg ret)]
            (if (abi-ret-indirect? sa)
                (do
                  (push! (mut lp) (LLVMPointerTypeInContext ctx 0))
                  (set! (.sret sig) sa)
                  0)
                (do
                  (set! rty (abi-direct-return-type cg sa))
                  (set! (.ret_direct sig) sa)
                  0)))
          (unless (ty-is-void ret) (set! rty (basic-ty cg ret)) 0)))
    ; param classification.
    ; `ngp`/`nsse` track how many argument registers the parameters BEFORE this
    ; one have consumed, because on x86-64 an ACDirect aggregate is demoted to
    ; byval when its eightbytes no longer fit (see abi-slot-regs above). An sret
    ; pointer occupies the first integer register. AArch64 does not have this
    ; rule — its ACDirect coercion is a single slot and the classifier already
    ; accounts for HFA/size — so the demotion is x86-only.
    (let [n (len (load params))
          x86 (= (.arch cg) 0)
          (mut ngp)
            (if (!= (primitive/cast i64 (load (field sig sret)))
                    0)
                1
                0)
          (mut nsse) 0
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (let [pty (elem params (load i))]
                    (if (cg-abi-aggregate? cg pty)
                        (let [sa (abi-classify cg pty)]
                          (match (.arg sa)
                            (ACDirect [slots]
                                      (let [ns (len (load slots))
                                            (mut needg) (zeroed i64)
                                            (mut needs) (zeroed i64)]
                                        (abi-slot-regs slots
                                                       (mut needg)
                                                       (mut needs))
                                        (if (and x86
                                                 (or (> (primitive/iadd (load ngp)
                                                                        needg)
                                                        6)
                                                     (> (primitive/iadd (load nsse)
                                                                        needs)
                                                        8)))
                                            ; no room for BOTH eightbytes: the whole
                                            ; aggregate goes in memory, as byval.
                                            (do
                                              (push! (mut lp)
                                                     (LLVMPointerTypeInContext ctx
                                                                               0))
                                              (push! (mut argl) (AAIndirect sa))
                                              0)
                                            (let [(mut k) 0]
                                              (loop (if (>= (load k) ns)
                                                        (break)
                                                        (do
                                                          (push! (mut lp)
                                                                 (get (load slots)
                                                                      (load k)))
                                                          (set! k
                                                                (primitive/iadd (load k)
                                                                                1)))))
                                              (set! ngp
                                                    (primitive/iadd (load ngp)
                                                                    needg))
                                              (set! nsse
                                                    (primitive/iadd (load nsse)
                                                                    needs))
                                              (push! (mut argl) (AADirect sa))
                                              0))))
                            (ACIndirect [al]
                                        (do
                                          ; a byval pointer still costs an integer
                                          ; register when one is available
                                          (when (< (load ngp)
                                                   6)
                                            (set! ngp
                                                  (primitive/iadd (load ngp)
                                                                  1))
                                            0)
                                          (push! (mut lp)
                                                 (LLVMPointerTypeInContext ctx
                                                                           0))
                                          (push! (mut argl) (AAIndirect sa))))))
                        (do
                          (if (type-is-float pty)
                              (when (< (load nsse) 8)
                                (set! nsse (primitive/iadd (load nsse) 1))
                                0)
                              (when (< (load ngp) 6)
                                (set! ngp (primitive/iadd (load ngp) 1))
                                0))
                          (push! (mut lp) (basic-ty cg pty))
                          (push! (mut argl) (AAScalar)))))
                  (set! i (primitive/iadd (load i) 1)))))
      (set! (.gp_used sig) (load ngp))
      (set! (.sse_used sig) (load nsse)))
    (let [rt
            (if (= (primitive/cast i64 (load rty)) 0)
                (LLVMVoidTypeInContext ctx)
                (load rty))
          fnty
            (LLVMFunctionType rt
                              (carr a (load lp))
                              (primitive/cast i32 (len (load lp)))
                              (when variadic 1))]
      (set! (.args sig) (box-al [ArgAbiK] a (load argl)))
      (set! (.fn_ty sig) fnty)
      sig)))

; ---- attributes ----
(defn cg-enum-attr [(cg (ptr Cg)) (name (slice u8)) (val i64)] (-> (ptr i8))
  (LLVMCreateEnumAttribute (cg-ctx cg)
                           (LLVMGetEnumAttributeKindForName (to-cstr (.a cg)
                                                                     name)
                                                            (len name))
                           val))

;;; End the current block with a failure the compiler inserted: write the
;;; `n`-byte message `global` to stderr and abort, or, on a target with no OS,
;;; stop at a trap instruction (the message has nowhere to go).
(defn cg-build-hard-fail! [(cg (ptr Cg)) (global (ptr i8)) (n i64)] (-> i64)
  (let [a (.a cg)
        b (cg-bld cg)
        void-fn (LLVMFunctionType (LLVMVoidTypeInContext (cg-ctx cg))
                                  (carr a (ArrayList::new [(ptr i8)] a))
                                  0
                                  0)
        stop-name (if (.freestanding cg) c"llvm.trap" c"abort")
        existing (LLVMGetNamedFunction (load (field cg module)) stop-name)
        stop
          (if (= (primitive/cast i64 existing) 0)
              (LLVMAddFunction (load (field cg module)) stop-name void-fn)
              existing)]
    (unless (.freestanding cg)
      ; write(2) takes and returns the target's size_t/ssize_t, 32 bits on wasm32
      (let [(mut wp) (ArrayList::new [(ptr i8)] a)
            sizety (LLVMIntPtrTypeInContext (cg-ctx cg) (.td cg))]
        (push! (mut wp) (LLVMInt32TypeInContext (cg-ctx cg)))
        (push! (mut wp) (LLVMPointerTypeInContext (cg-ctx cg) 0))
        (push! (mut wp) sizety)
        (let [wty (LLVMFunctionType sizety (carr a (load wp)) 3 0)
              oldw (LLVMGetNamedFunction (load (field cg module)) c"write")
              wf
                (if (= (primitive/cast i64 oldw) 0)
                    (LLVMAddFunction (load (field cg module)) c"write" wty)
                    oldw)
              (mut wa) (ArrayList::new [(ptr i8)] a)]
          (push! (mut wa) (LLVMConstInt (cg-i32t cg) 2 0))
          (push! (mut wa) global)
          (push! (mut wa) (LLVMConstInt sizety n 0))
          (LLVMBuildCall2 b wty wf (carr a (load wa)) 3 (cg-bl cg "fail.write"))
          0)))
    (LLVMBuildCall2 b
                    (LLVMGlobalGetValueType stop)
                    stop
                    (carr a (ArrayList::new [(ptr i8)] a))
                    0
                    c"")
    (LLVMBuildUnreachable b)
    0))

; UBSan is normally inserted by Clang's source-language frontend; LLVM has no
; general `ubsan` IR pass. Coil therefore emits the operation checks it defines
; as invalid directly during lowering. A failing check is self-contained and
; deterministic: report the class, then abort before LLVM evaluates the bad op.
(defn cg-ubsan-fail-if! [(cg (ptr Cg)) (bad (ptr i8)) (message (slice u8))] (-> i64)
  (when (= (.sanitizer cg) 4)
    (let [b (cg-bld cg)
          function (LLVMGetBasicBlockParent (LLVMGetInsertBlock b))
          fail
            (LLVMAppendBasicBlockInContext (cg-ctx cg)
                                           function
                                           (cg-gname cg
                                                     "ubsan.fail."
                                                     (cg-next-global cg)))
          good
            (LLVMAppendBasicBlockInContext (cg-ctx cg)
                                           function
                                           (cg-gname cg
                                                     "ubsan.ok."
                                                     (cg-next-global cg)))]
      (LLVMBuildCondBr b bad fail good)
      (LLVMPositionBuilderAtEnd b fail)
      (let [a (.a cg)
            full
              (sconcat a
                       "coil: undefined behavior: "
                       (sconcat a message " (--sanitize=undefined)\n"))
            bytes
              (LLVMConstStringInContext (cg-ctx cg)
                                        (primitive/cast (ptr i8)
                                                        (data full))
                                        (primitive/cast i32 (len full))
                                        0)
            global
              (LLVMAddGlobal (load (field cg module))
                             (LLVMTypeOf bytes)
                             (cg-gname cg "ubsan.message." (cg-next-global cg)))]
        (LLVMSetInitializer global bytes)
        (LLVMSetGlobalConstant global 1)
        (LLVMSetLinkage global 9)
        (cg-build-hard-fail! cg global (len full)))
      (LLVMPositionBuilderAtEnd b good)
      0))
  0)

(defn cg-ubsan-overflow-op [(cg (ptr Cg))
                            (op i64)
                            (l (ptr i8))
                            (r (ptr i8))
                            (bits i64)] (-> (ptr i8))
  (let [b (cg-bld cg)
        wide
          (LLVMIntTypeInContext (cg-ctx cg)
                                (primitive/cast i32 (primitive/imul bits 2)))
        lw (LLVMBuildSExt b l wide (cg-bl cg "ubsan.lwide"))
        rw (LLVMBuildSExt b r wide (cg-bl cg "ubsan.rwide"))
        full
          (cond (= op 0)
                  (LLVMBuildAdd b lw rw (cg-bl cg "ubsan.add"))
                (= op 1)
                  (LLVMBuildSub b lw rw (cg-bl cg "ubsan.sub"))
                :else (LLVMBuildMul b lw rw (cg-bl cg "ubsan.mul")))
        narrow-ty (LLVMTypeOf l)
        result (LLVMBuildTrunc b full narrow-ty (cg-bl cg "ubsan.result"))
        restored (LLVMBuildSExt b result wide (cg-bl cg "ubsan.restored"))
        bad (LLVMBuildICmp b 33 full restored (cg-bl cg "ubsan.overflow"))]
    (cg-ubsan-fail-if! cg bad "signed integer overflow")
    result))

;;; `dladdr(value, &info) == 0`: the address lies in no loaded image.
(defn cg-unresolved-target [(cg (ptr Cg)) (value (ptr i8))] (-> (ptr i8))
  (let [b (cg-bld cg)
        pty (LLVMPointerTypeInContext (cg-ctx cg) 0)
        info
          (cg-entry-alloca cg
                           (LLVMArrayType2 pty 4)
                           (cg-bl cg "indirect.dl-info"))
        (mut dl-params) (ArrayList::new [(ptr i8)] (.a cg))
        _dp0 (push! (mut dl-params) pty)
        _dp1 (push! (mut dl-params) pty)
        dl-ty
          (LLVMFunctionType (LLVMInt32TypeInContext (cg-ctx cg))
                            (carr (.a cg) (load dl-params))
                            2
                            0)
        found-dl (LLVMGetNamedFunction (load (field cg module)) c"dladdr")
        dl-fn
          (if (= (primitive/cast i64 found-dl) 0)
              (LLVMAddFunction (load (field cg module)) c"dladdr" dl-ty)
              found-dl)
        (mut dl-args) (ArrayList::new [(ptr i8)] (.a cg))
        _da0 (push! (mut dl-args) value)
        _da1 (push! (mut dl-args) info)
        dl-status
          (LLVMBuildCall2 b
                          dl-ty
                          dl-fn
                          (carr (.a cg) (load dl-args))
                          2
                          (cg-bl cg "indirect.dladdr"))]
    (LLVMBuildICmp b
                   32
                   dl-status
                   (LLVMConstInt (LLVMInt32TypeInContext (cg-ctx cg)) 0 0)
                   (cg-bl cg "indirect.unresolved"))))

; Debug-only guard for pointers consumed by dynamic dispatch. Every checked
; pointer must be non-null and satisfy its ABI alignment; actual call targets must also
; resolve into a loaded image. Keep this in codegen so disabled builds emit no
; branches, declarations, or data. On WebAssembly a function pointer is an index
; into the instance's table, not an address: `call_indirect` itself traps on an
; index out of range or a signature that does not match, and there is no image to
; ask `dladdr` about, so a call target is left to it.
(defn cg-validate-pointer! [(cg (ptr Cg))
                            (value (ptr i8))
                            (label (slice u8))
                            (alignment i64)
                            (require-image bool)] (-> i64)
  (when (and (.debug_checks cg)
             (not (and require-image (= (.arch cg) 2))))
    (let [b (cg-bld cg)
          i64ty (LLVMInt64TypeInContext (cg-ctx cg))
          addr (LLVMBuildPtrToInt b value i64ty (cg-bl cg "indirect.addr"))
          isnull
            (LLVMBuildICmp b
                           32
                           addr
                           (LLVMConstInt i64ty 0 0)
                           (cg-bl cg "indirect.null"))
          odd
            (LLVMBuildAnd b
                          addr
                          (LLVMConstInt i64ty (- alignment 1) 0)
                          (cg-bl cg "indirect.odd"))
          misaligned
            (LLVMBuildICmp b
                           33
                           odd
                           (LLVMConstInt i64ty 0 0)
                           (cg-bl cg "indirect.misaligned"))
          basic-invalid
            (LLVMBuildOr b
                         isnull
                         misaligned
                         (cg-bl cg "indirect.basic-invalid"))
          ; a data pointer needs only the two tests; a call target must also
          ; resolve into a loaded image
          invalid
            (if require-image
                (LLVMBuildOr b
                             basic-invalid
                             (cg-unresolved-target cg value)
                             (cg-bl cg "indirect.invalid"))
                basic-invalid)
          function (LLVMGetBasicBlockParent (LLVMGetInsertBlock b))
          bad
            (LLVMAppendBasicBlockInContext (cg-ctx cg)
                                           function
                                           (to-cstr (.a cg)
                                                    (sconcat (.a cg)
                                                             label
                                                             ".bad")))
          good
            (LLVMAppendBasicBlockInContext (cg-ctx cg)
                                           function
                                           (to-cstr (.a cg)
                                                    (sconcat (.a cg)
                                                             label
                                                             ".ok")))]
      (LLVMBuildCondBr b invalid bad good)
      (LLVMPositionBuilderAtEnd b bad)
      (let [a (.a cg)
            message
              (sconcat a
                       "coil: invalid indirect target in "
                       (sconcat a label " (--debug-runtime)\n"))
            bytes
              (LLVMConstStringInContext (cg-ctx cg)
                                        (primitive/cast (ptr i8)
                                                        (data message))
                                        (primitive/cast i32 (len message))
                                        0)
            global
              (LLVMAddGlobal (load (field cg module))
                             (LLVMTypeOf bytes)
                             (cg-gname cg
                                       "indirect.message."
                                       (cg-next-global cg)))]
        (LLVMSetInitializer global bytes)
        (LLVMSetGlobalConstant global 1)
        (LLVMSetLinkage global 9)
        (cg-build-hard-fail! cg global (len message)))
      (LLVMPositionBuilderAtEnd b good)
      0))
  0)

(defn cg-add-function [(cg (ptr Cg)) (name (ptr i8)) (fnty (ptr i8))] (-> (ptr i8))
  (let [f (LLVMAddFunction (load (field cg module)) name fnty)]
    (let [san (.sanitizer cg)]
      (when (= san 1)
        (LLVMAddAttributeAtIndex f
                                 (: -1 i32)
                                 (cg-enum-attr cg "sanitize_address" 0))
        0)
      (when (= san 2)
        (LLVMAddAttributeAtIndex f
                                 (: -1 i32)
                                 (cg-enum-attr cg "sanitize_thread" 0))
        0)
      (when (= san 3)
        (LLVMAddAttributeAtIndex f
                                 (: -1 i32)
                                 (cg-enum-attr cg "sanitize_memory" 0))
        0))
    (when (.debug_checks cg)
      ; LLVM inserts and verifies a stack canary in functions whose frames can
      ; expose writable local storage. This catches stack smashing at the frame
      ; that caused it instead of at an unrelated later indirect call.
      (LLVMAddAttributeAtIndex f
                               (: -1 i32)
                               (cg-enum-attr cg "sspstrong" 0))
      0)
    f))

(defn cg-type-attr [(cg (ptr Cg)) (name (slice u8)) (ty (ptr i8))] (-> (ptr i8))
  (LLVMCreateTypeAttribute (cg-ctx cg)
                           (LLVMGetEnumAttributeKindForName (to-cstr (.a cg)
                                                                     name)
                                                            (len name))
                           ty))

(defn cg-attr-at [(cg (ptr Cg))
                  (target (ptr i8))
                  (is-call bool)
                  (pidx i64)
                  (attr (ptr i8))] (-> i64)
  (if is-call
      (do
        (LLVMAddCallSiteAttribute target
                                  (primitive/cast i32 (primitive/iadd pidx 1))
                                  attr)
        0)
      (do
        (LLVMAddAttributeAtIndex target
                                 (primitive/cast i32 (primitive/iadd pidx 1))
                                 attr)
        0)))

; apply a CSig's attrs (sret/align, and x86 byval — never on AArch64) to a function
; declaration (is-call=false) or a call instruction (is-call=true).
(defn cg-apply-csig-attrs [(cg (ptr Cg))
                           (sig (ptr CSig))
                           (target (ptr i8))
                           (is-call bool)] (-> i64)
  (let [(mut idx) 0
        sret-sa (load (field sig sret))]
    (when (!= (primitive/cast i64 sret-sa) 0)
      (cg-attr-at cg
                  target
                  is-call
                  (load idx)
                  (cg-type-attr cg
                                "sret"
                                (load (field sret-sa
                                             llvm_ty))))
      (cg-attr-at cg
                  target
                  is-call
                  (load idx)
                  (cg-enum-attr cg
                                "align"
                                (primitive/cast i64
                                                (.align sret-sa))))
      (set! idx (primitive/iadd (load idx) 1)))
    (let [args (load (field sig args))
          n (len (load args))
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (match (get (load args) (load i))
                    (AADirect [sa]
                              (match (.arg sa)
                                (ACDirect [slots]
                                          (set! idx
                                                (primitive/iadd (load idx)
                                                                (len (load slots)))))
                                (_ 0)))
                    (AAIndirect [sa]
                                (do
                                  (when (= (.arch cg)
                                           0)
                                    (cg-attr-at cg
                                                target
                                                is-call
                                                (load idx)
                                                (cg-type-attr cg
                                                              "byval"
                                                              (load (field sa
                                                                           llvm_ty))))
                                    (cg-attr-at cg
                                                target
                                                is-call
                                                (load idx)
                                                (cg-enum-attr cg
                                                              "align"
                                                              (primitive/cast i64
                                                                              (.align sa)))))
                                  (set! idx (primitive/iadd (load idx) 1))))
                    (AAScalar [] (set! idx (primitive/iadd (load idx) 1))))
                  (set! i (primitive/iadd (load i) 1))))))
    0))

; ---- struct slot / arg pointer / memcpy / gep helpers ----
(defn cg-const-uoff [(cg (ptr Cg)) (n i64)] (-> (ptr i8))
  (LLVMConstInt (cg-i64t cg) n 0))

; the call's value name: empty for a void-returning callee (LLVM never
; name a void call), else `nm` — so named/bare calls match the reference exactly.
(defn cg-call-name [(cg (ptr Cg)) (fnty (ptr i8)) (nm (slice u8))] (-> (ptr i8))
  (if (= (LLVMGetTypeKind (LLVMGetReturnType fnty)) (: 0 i32))
      (cg-bl cg "")
      (cg-bl cg nm)))

(defn cg-struct-slot [(cg (ptr Cg)) (sa (ptr StructAbi)) (name (slice u8))] (-> (ptr i8))
  (let [p (cg-entry-alloca cg (load (field sa llvm_ty)) (cg-bl cg name))
        al (.align sa)]
    (LLVMSetAlignment p (if (> al (: 8 i32)) al 8))
    p))

; A spill slot for an aggregate that is about to be read back as whole i64 ABI
; slots. Its size must be rounded UP to a multiple of 8: an ACDirect argument is
; passed by loading one i64 per slot, so a 4-byte struct sitting in an exactly
; 4-byte alloca would have that load reach 4 bytes past the end of the object.
; LLVM treats the out-of-bounds load as poison and folds it, which is how a
; (4x u8) struct arrived at a C callee as 0,0,0,0. The padding bytes are never
; read by the callee — it only looks at the struct's own fields.
(defn cg-struct-slot-padded [(cg (ptr Cg))
                             (sa (ptr StructAbi))
                             (name (slice u8))] (-> (ptr i8))
  (let [ctx (cg-ctx cg)
        ty (LLVMArrayType2 (LLVMInt8TypeInContext ctx) (align8 (.size sa)))
        p (cg-entry-alloca cg ty (cg-bl cg name))
        al (.align sa)]
    (LLVMSetAlignment p (if (> al (: 8 i32)) al 8))
    ; Direct ABI coercion loads every padded slot.  Leaving tail padding
    ; uninitialized makes the load poison, which may also destroy the defined
    ; bytes in a partial final slot (notably byte 9 of a packed struct).
    (let [z (LLVMBuildStore (cg-bld cg) (LLVMConstNull ty) p)]
      (LLVMSetAlignment z 1))
    p))

;; A struct, sum, `dyn` pair or fixed array is a MEMORY value: its Tv holds the
;; address of storage that nothing writes again while the Tv is live, never an
;; LLVM first-class aggregate. LLVM's advice to frontends is to move aggregates
;; with memcpy: first-class aggregate loads and stores make SROA and instruction
;; selection expand every field, which cost seconds per copy of a 3 KB struct.
;; A slice stays a first-class {ptr, i64}: a pair of scalars, as in Rust's
;; ScalarPair. Code that needs the value itself (inline LLVM IR, a volatile
;; store, an array parameter of a plain LLVM signature) loads it there, and
;; only there (cg-tv-ssa); the reverse boundary is cg-tv-of-ssa.
(defn cg-mem-ty? [(cg (ptr Cg)) (t (ptr Type))] (-> bool)
  (match (load t)
    (TSlice [_] false)
    (_ (let [k (LLVMGetTypeKind (basic-ty cg t))]
         (or (= k (: 10 i32)) (= k (: 11 i32)))))))

;; Fresh storage for one value of the memory type T, in the entry block.
(defn cg-mem-temp [(cg (ptr Cg)) (t (ptr Type)) (name (slice u8))] (-> (ptr i8))
  (let [slot (cg-entry-alloca cg (basic-ty cg t) (cg-bl cg name))
        al (cg-layout-align cg t)]
    (when (> al (primitive/cast i64 (LLVMGetAlignment slot)))
      (LLVMSetAlignment slot (primitive/cast i32 al)))
    slot))

;; Copy one value of the memory type T. The source is a memory value's storage
;; or a fresh slot, never storage overlapping DST, so this is a memcpy.
(defn cg-mem-copy! [(cg (ptr Cg)) (dst (ptr i8)) (src (ptr i8)) (t (ptr Type))] (-> i64)
  (LLVMBuildMemCpy (cg-bld cg)
                   dst
                   1
                   src
                   1
                   (cg-const-uoff cg (cg-layout-size cg t)))
  0)

;; The LLVM type a value of T travels as: a memory value as its address.
(defn cg-value-ty [(cg (ptr Cg)) (t (ptr Type))] (-> (ptr i8))
  (if (cg-mem-ty? cg t)
      (LLVMPointerTypeInContext (cg-ctx cg) 0)
      (basic-ty cg t)))

;; The value itself, for a boundary that needs a first-class LLVM value.
(defn cg-tv-ssa [(cg (ptr Cg)) (tv Tv)] (-> (ptr i8))
  (let [t (box-type (.a cg) (tv-ty tv))]
    (if (cg-mem-ty? cg t)
        (let [ins
                (LLVMBuildLoad2 (cg-bld cg)
                                (basic-ty cg t)
                                (tv-val tv)
                                (cg-bl cg "agg.value"))]
          (LLVMSetAlignment ins 1)
          ins)
        (tv-val tv))))

;; A first-class value an LLVM construct produced (a call with a plain LLVM
;; signature, inline IR, a volatile load), as a Tv: a memory value goes to
;; fresh storage.
(defn cg-tv-of-ssa [(cg (ptr Cg)) (v (ptr i8)) (t Type)] (-> Tv)
  (let [tp (box-type (.a cg) t)]
    (if (cg-mem-ty? cg tp)
        (let [slot (cg-mem-temp cg tp "agg.tmp")]
          (LLVMBuildStore (cg-bld cg) v slot)
          (mk-tv slot t))
        (mk-tv v t))))

;; Store a Tv's value at DST; a memory value is copied from its storage. A
;; nonzero ALIGN is the alignment DST promises a scalar store.
(defn cg-store-tv! [(cg (ptr Cg)) (tv Tv) (dst (ptr i8)) (align i32)] (-> i64)
  (let [t (box-type (.a cg) (tv-ty tv))]
    (if (cg-mem-ty? cg t)
        (cg-mem-copy! cg dst (tv-val tv) t)
        (let [ins (LLVMBuildStore (cg-bld cg) (tv-val tv) dst)]
          (when (!= align (: 0 i32)) (LLVMSetAlignment ins align))
          0))))

;; A zero of T: fresh zeroed storage for a memory type, else a constant.
(defn emit-zeroed [(cg (ptr Cg)) (t Type)] (-> Tv)
  (let [tp (box-type (.a cg) t)]
    (if (cg-mem-ty? cg tp)
        (let [slot (cg-mem-temp cg tp "zeroed")]
          (LLVMBuildMemSet (cg-bld cg)
                           slot
                           (LLVMConstInt (LLVMInt8TypeInContext (cg-ctx cg))
                                         0
                                         0)
                           (cg-const-uoff cg (cg-layout-size cg tp))
                           1)
          (mk-tv slot t))
        (mk-tv (LLVMConstNull (basic-ty cg tp)) t))))

;; The ABI copy of an aggregate argument. V is the address of a memory value,
;; an exactly sized object that promises no readable tail padding or register
;; alignment, so copy only the logical bytes into initialized, aligned storage.
(defn cg-struct-arg-ptr [(cg (ptr Cg)) (v (ptr i8)) (sa (ptr StructAbi))] (-> (ptr i8))
  (let [slot (cg-struct-slot-padded cg sa "abi.arg")]
    (if (= (LLVMGetTypeKind (LLVMTypeOf v)) (: 12 i32))
        (do
          (LLVMBuildMemCpy (cg-bld cg)
                           slot
                           (.align sa)
                           v
                           1
                           (cg-const-uoff cg (.size sa)))
          0)
        (do (unimplemented "codegen: an aggregate argument is not in memory") 0))
    slot))

(defn cg-copy-struct [(cg (ptr Cg))
                      (dst (ptr i8))
                      (src (ptr i8))
                      (sa (ptr StructAbi))] (-> i64)
  (LLVMBuildMemCpy (cg-bld cg)
                   dst
                   (.align sa)
                   src
                   (.align sa)
                   (cg-const-uoff cg (.size sa)))
  0)

(defn cg-gep-i8 [(cg (ptr Cg)) (base (ptr i8)) (off i64)] (-> (ptr i8))
  (let [a (.a cg)
        (mut ix) (ArrayList::new [(ptr i8)] a)]
    (push! (mut ix) (cg-const-uoff cg off))
    (LLVMBuildGEP2 (cg-bld cg)
                   (LLVMInt8TypeInContext (cg-ctx cg))
                   base
                   (carr a (load ix))
                   1
                   (cg-bl cg "abi.eb"))))

; ---- reject by-value slice/vec crossing the C boundary
; reject_view_at_c_abi) ---- Runs eagerly over EVERY extern declaration (before,
; and independent of, per-target struct classification), so it holds on every
; target. A by-value slice or SIMD vec — direct, or nested in a by-value struct
; field / array — has no defined C representation. It is an error naming `<who>`
; rendered as a bare spanless `error: <msg>` + exit 1; codegen here has no Result
; channel, so cg-fail prints and exits — byte-identical stderr + exit code.
(defn cg-reject-view [(cg (ptr Cg)) (t (ptr Type)) (who (slice u8))] (-> i64)
  (let [a (.a cg)]
    (match (load t)
      (TSlice [el]
              (cg-fail (sconcat a
                                who
                                ": a slice cannot cross the C ABI by value (it is a Coil view type); for FFI pass a c\"…\"/(ptr i8) and a length")))
      (TVec [el n]
            (cg-fail (sconcat a
                              who
                              ": a vec cannot cross the C ABI by value; pass a pointer to it")))
      (TStruct [nm]
               (let [si (cg-struct-idx cg nm)]
                 (unless (< si 0)
                   (match (.layout (elem (field cg structs)
                                         si))
                     (LayoutWritten [_ _] (panic "codegen: struct '{}' reached codegen with its :layout undecided" nm))
                     (LBits [b o] 0)
                     (LC []
                         (let [fs
                                 (load (field (elem (field cg
                                                           structs)
                                                    si)
                                              fields))
                               n (len (load fs))
                               (mut i) 0]
                           (loop (if (>= (load i) n)
                                     (break)
                                     (do
                                       (cg-reject-view cg
                                                       (field (elem fs
                                                                    (load i))
                                                              ty)
                                                       who)
                                       (set! i (primitive/iadd (load i) 1)))))
                           0))
                     (LPacked []
                              (let [fs
                                      (load (field (elem (field cg
                                                                structs)
                                                         si)
                                                   fields))
                                    n (len (load fs))
                                    (mut i) 0]
                                (loop (if (>= (load i) n)
                                          (break)
                                          (do
                                            (cg-reject-view cg
                                                            (field (elem fs
                                                                         (load i))
                                                                   ty)
                                                            who)
                                            (set! i (primitive/iadd (load i) 1)))))
                                0))
                     (LAligned [_]
                               (let [fs
                                       (load (field (elem (field cg
                                                                 structs)
                                                          si)
                                                    fields))
                                     n (len (load fs))
                                     (mut i) 0]
                                 (loop (if (>= (load i) n)
                                           (break)
                                           (do
                                             (cg-reject-view cg
                                                             (field (elem fs
                                                                          (load i))
                                                                    ty)
                                                             who)
                                             (set! i
                                                   (primitive/iadd (load i) 1)))))
                                 0))
                     (LExplicit [_ _ _]
                                (let [fs
                                        (load (field (elem (field cg
                                                                  structs)
                                                           si)
                                                     fields))
                                      n (len (load fs))
                                      (mut i) 0]
                                  (loop (if (>= (load i) n)
                                            (break)
                                            (do
                                              (cg-reject-view cg
                                                              (field (elem fs
                                                                           (load i))
                                                                     ty)
                                                              who)
                                              (set! i
                                                    (primitive/iadd (load i)
                                                                    1)))))
                                  0))))))
      (TArray [el n] (cg-reject-view cg el who))
      (_ 0))))

(defn cg-check-c-abi-types [(cg (ptr Cg))
                            (params (ptr (ArrayList Type)))
                            (ret (ptr Type))
                            (who (slice u8))] (-> i64)
  (cg-reject-view cg ret who)
  (let [n (len (load params))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (cg-reject-view cg (elem params (load i)) who)
                (set! i (primitive/iadd (load i) 1))))))
  0)

;;; A variadic struct copied into memory on x86-64 SysV: its position in the
;;; call's operand list, for the byval attribute added once the call exists.
(defstruct VarByval [(index i64) (sa (ptr StructAbi))])

;;; x86-64 argument registers still free for a call's variadic arguments.
(defstruct RegUse [(gp i64) (sse i64)])

;;; Lower a call's variadic arguments (argtv[from..]) onto `meta`. A C struct goes
;;; through the same C-ABI classification as a named one (the platform rules
;;; differ only on Apple AArch64, see cg-variadic-struct-abi); anything else is
;;; passed as its value. A struct copied to memory as byval on x86-64 is recorded
;;; in `byvals`, for cg-variadic-byvals! to mark once the call exists.
(defn cg-variadic-args! [(cg (ptr Cg))
                         (argtv (ArrayList Tv))
                         (from i64)
                         (start RegUse)
                         (meta (ptr (ArrayList (ptr i8))))
                         (byvals (ptr (ArrayList VarByval)))] (-> i64)
  (let [a (.a cg)
        b (cg-bld cg)
        (mut regs) (RegUse :gp (.gp start) :sse (.sse start))]
    (for [i from (len argtv)]
      (let [tv (get argtv i)
            v (tv-val tv)
            ty (box-type a (tv-ty tv))]
        (if (not (cg-abi-aggregate? cg ty))
            (push! meta (cg-tv-ssa cg tv))
            (let [sa (cg-variadic-struct-abi cg ty (mut regs))
                  src (cg-struct-arg-ptr cg v sa)]
              (match (.arg sa)
                (ACDirect [slots]
                          (for [k 0 (len (load slots))]
                            (let [off (primitive/imul k 8)
                                  gep (if (= off 0) src (cg-gep-i8 cg src off))]
                              (push! meta
                                     (LLVMBuildLoad2 b
                                                     (get (load slots) k)
                                                     gep
                                                     (cg-bl cg "abi.slot"))))))
                (ACIndirect [al]
                            (let [copy (cg-struct-slot cg sa "abi.byval")]
                              (cg-copy-struct cg copy src sa)
                              (when (= (.arch cg) 0)
                                (push! byvals
                                       (VarByval :index (len (load meta))
                                         :sa sa)))
                              (push! meta copy)))))))))
  0)

(defn cg-variadic-byvals! [(cg (ptr Cg))
                           (call (ptr i8))
                           (byvals (ArrayList VarByval))] (-> i64)
  (for [k 0 (len byvals)]
    (let [bv (get byvals k)]
      (cg-attr-at cg
                  call
                  true
                  (.index bv)
                  (cg-type-attr cg "byval" (load (field (.sa bv) llvm_ty))))
      (cg-attr-at cg
                  call
                  true
                  (.index bv)
                  (cg-enum-attr cg
                                "align"
                                (primitive/cast i64 (.align (.sa bv)))))))
  0)

;;; x86-64 argument registers a plain (struct-free) signature's fixed parameters
;;; use: each is one integer or one SSE register while any remain.
(defn cg-plain-reg-use [(fnty (ptr i8)) (ptys (ptr (ptr i8)))] (-> RegUse)
  (let [np (primitive/cast i64 (LLVMCountParamTypes fnty))
        (mut gp) 0
        (mut sse) 0]
    (for [i 0 np]
      (let [kind (LLVMGetTypeKind (load (index ptys i)))]
        (if (or (= kind (: 2 i32)) (= kind (: 3 i32)))
            (when (< sse 8) (set! sse (+ sse 1)))
            (when (< gp 6) (set! gp (+ gp 1))))))
    (RegUse :gp gp :sse sse)))

;;; How a C struct (layout index `cs`) is passed in a variadic slot, advancing the
;;; x86-64 register count. Every C ABI here passes a variadic struct as it would a
;;; named one, except Apple AArch64: its variadic arguments all go to the stack, so
;;; a homogeneous float aggregate loses its FP-register treatment and travels as
;;; integer words like any other aggregate of 16 bytes or less (larger ones are
;;; passed by reference either way). On x86-64 a struct whose eightbytes no longer
;;; fit in the remaining registers goes to memory whole, as byval.
(defn cg-variadic-struct-abi [(cg (ptr Cg)) (t (ptr Type)) (regs (mut RegUse))] (-> (ptr StructAbi))
  (let [sa (abi-classify cg t)
        arch (.arch cg)]
    (cond (and (= arch 1) (.mach_o cg))
            (if (> (.size sa) 16)
                sa
                (let [p (box! (.a cg) StructAbi (load sa))
                      words
                        (if (<= (.size sa) 8)
                            (cg-i64t cg)
                            (LLVMArrayType2 (cg-i64t cg) 2))]
                  (set! (.arg p) (ACDirect (abi-slots1 cg words)))
                  p))
          (= arch 0)
            (match (.arg sa)
              (ACDirect [slots]
                        (let [(mut needg) (zeroed i64)
                              (mut needs) (zeroed i64)]
                          (abi-slot-regs slots (mut needg) (mut needs))
                          (if (or (> (+ (.gp regs) needg) 6)
                                  (> (+ (.sse regs) needs) 8))
                              (let [p (box! (.a cg) StructAbi (load sa))]
                                (set! (.arg p) (ACIndirect (.align sa)))
                                p)
                              (do
                                (set! (.gp regs) (+ (.gp regs) needg))
                                (set! (.sse regs) (+ (.sse regs) needs))
                                sa))))
              (ACIndirect [al] sa))
          :else sa)))

; ---- emit a call through the C struct ABI ----
(defn emit-argtv [(cg (ptr Cg)) (args (ptr (ArrayList Expr))) (scp (ptr Scope))] (-> (ArrayList Tv))
  (let [a (.a cg)
        n (len (load args))
        (mut out) (ArrayList::new [Tv] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out)
                       (emit-expr cg (elem args (load i)) scp))
                (set! i (primitive/iadd (load i) 1)))))
    (load out)))

; Emit a C-ABI call given the callee VALUE plus its function type and calling
; convention explicitly. A direct extern derives both from the global (emit-c-call
; below); an indirect `call-ptr` has neither — a raw function-pointer value has no
; global value type and no function callconv — so it passes the CSig's own fn_ty
; and the C convention id. Everything else here (classification, sret slot, byval
; copies, ACDirect slot loads, csig attrs) is shared verbatim.
; `label` names the call's SSA value. It is threaded through rather than fixed so
; an indirect call keeps its historic "callptr" name: a `c` fnptr whose args need
; no struct lowering emits exactly the instruction it always did, and the IR gate
; stays sensitive to real changes instead of drowning in a rename.
(defn emit-c-call-ty [(cg (ptr Cg))
                      (callee (ptr i8))
                      (fnty (ptr i8))
                      (ccid i32)
                      (sig (ptr CSig))
                      (argtv (ArrayList Tv))
                      (ret-ty Type)
                      (label (slice u8))
                      (dest Dest)] (-> Tv)
  (let [a (.a cg)
        b (cg-bld cg)
        ctx (cg-ctx cg)
        (mut meta) (ArrayList::new [(ptr i8)] a)
        (mut byvals) (ArrayList::new [VarByval] a)
        sret-sa (load (field sig sret))
        (mut sret-slot) (primitive/cast (ptr i8) 0)
        nargs (len argtv)
        nfixed (len (load (field sig args)))]
    (when (!= (primitive/cast i64 sret-sa) 0)
      ; the callee writes its result straight into a destination aligned for it
      (let [s
              (if (dest-fits? dest (primitive/cast i64 (.align sret-sa)))
                  (.at dest)
                  (cg-struct-slot cg sret-sa "abi.sret"))]
        (set! sret-slot s)
        (push! (mut meta) s)))
    (let [(mut i) 0]
      (loop (if (>= (load i) nfixed)
                (break)
                (do
                  (let [aa (get (load (field sig args)) (load i))
                        tv (get argtv (load i))
                        v (tv-val tv)]
                    (match aa
                      (AAScalar [] (push! (mut meta) (cg-tv-ssa cg tv)))
                      ; the callee's own copy, straight from the value's storage
                      (AAIndirect [sa]
                                  (let [copy (cg-struct-slot cg sa "abi.byval")]
                                    (LLVMBuildMemCpy b
                                                     copy
                                                     (.align sa)
                                                     v
                                                     1
                                                     (cg-const-uoff cg
                                                                    (.size sa)))
                                    (push! (mut meta) copy)))
                      (AADirect [sa]
                                (let [src (cg-struct-arg-ptr cg v sa)]
                                  (match (.arg sa)
                                    (ACDirect [slots]
                                              (let [ns (len (load slots))
                                                    (mut k) 0]
                                                (loop (if (>= (load k) ns)
                                                          (break)
                                                          (do
                                                            (let [slot-ty
                                                                    (get (load slots)
                                                                         (load k))
                                                                  off
                                                                    (primitive/imul (load k)
                                                                                    8)
                                                                  gep
                                                                    (if (= off
                                                                           0)
                                                                        src
                                                                        (cg-gep-i8 cg
                                                                                   src
                                                                                   off))]
                                                              (push! (mut meta)
                                                                     (LLVMBuildLoad2 b
                                                                                     slot-ty
                                                                                     gep
                                                                                     (cg-bl cg
                                                                                            "abi.slot"))))
                                                            (set! k
                                                                  (primitive/iadd (load k)
                                                                                  1)))))
                                                0))
                                    (ACIndirect [al]
                                                (do
                                                  (unimplemented "abi: Direct arg has a Direct class")
                                                  0)))))))
                  (set! i (primitive/iadd (load i) 1))))))
    (cg-variadic-args! cg
                       argtv
                       nfixed
                       (RegUse :gp (.gp_used sig) :sse (.sse_used sig))
                       (mut meta)
                       (mut byvals))
    (let [cs
            (LLVMBuildCall2 b
                            fnty
                            callee
                            (carr a (load meta))
                            (primitive/cast i32 (len (load meta)))
                            (cg-call-name cg fnty label))]
      (LLVMSetInstructionCallConv cs ccid)
      (cg-apply-csig-attrs cg sig cs true)
      (cg-variadic-byvals! cg cs byvals)
      ; an aggregate result is a memory value where the call left it
      (if (!= (primitive/cast i64 sret-sa) 0)
          (cg-deliver cg (mk-tv (load sret-slot) ret-ty) dest)
          (let [rd (load (field sig ret_direct))]
            (if (!= (primitive/cast i64 rd) 0)
                (let [slot (cg-struct-slot-padded cg rd "abi.ret")]
                  ; an empty struct's call returns nothing; its value is the empty one
                  (unless (= (LLVMGetTypeKind (LLVMTypeOf cs))
                             (: 0 i32))
                    (LLVMBuildStore b cs slot))
                  (cg-deliver cg (mk-tv slot ret-ty) dest))
                (if (ty-is-void (box-type a ret-ty))
                    (mk-tv (cg-zero-i64 cg) (TVoid))
                    (cg-deliver cg (cg-tv-of-ssa cg cs ret-ty) dest))))))))

; a DIRECT call to a named C function: the global carries both its type and its cc.
(defn emit-c-call [(cg (ptr Cg))
                   (func (slice u8))
                   (callee (ptr i8))
                   (sig (ptr CSig))
                   (argtv (ArrayList Tv))
                   (ret-ty Type)
                   (dest Dest)] (-> Tv)
  (emit-c-call-ty cg
                  callee
                  (cg-func-fnty cg func callee)
                  (LLVMGetFunctionCallConv callee)
                  sig
                  argtv
                  ret-ty
                  "ccall"
                  dest))

; Two `(extern …)` declarations that resolve to the same C symbol must agree on
; their LLVM function type. A module holds ONE function per symbol, so the second
; declaration is dropped and its calls are built with the second signature against
; the first declaration's type. On arm64 that mismatch is invisible (i32 and i64
; args share a register); on wasm32 the param types are distinct, so it emits an
; import whose signature contradicts its call sites and the module fails to
; validate ("type mismatch: expected i64, found i32"). Reject it at declaration:
; the mismatch is a real conflict either way, the wasm backend just can't hide it.
;
; The conflict is usually with a declaration the program never wrote itself (the
; prelude declares read/write/strlen/memcpy), so name the earlier extern. Scanning
; for it is O(n) over the externs already walked, but only on the fatal path.
(defn cg-extern-prior-decl [(p (ptr Program)) (csym (slice u8)) (upto i64)] (-> (slice u8))
  (let [es (load (field p externs))
        (mut i) 0
        (mut r) ""]
    (loop (if (>= (load i) upto)
              (break)
              (do
                (let [ep (elem es (load i))
                      nm (.name ep)]
                  (when (= (extern-link-name ep) csym) (set! r nm) (break)))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

(defn cg-extern-redecl-check [(cg (ptr Cg))
                              (existing (ptr i8))
                              (fnty (ptr i8))
                              (prior (slice u8))
                              (ename (slice u8))
                              (csym (slice u8))] (-> i64)
  (let [a (.a cg)
        have (LLVMGlobalGetValueType existing)]
    ; Only wasm needs one signature per symbol. A native call is built against
    ; the type its own declaration wrote (CgFunc.fnty), so declarations of one C
    ; symbol may differ in integer width, as C translation units may.
    (when (and (= (.arch cg) 2)
               (!= (primitive/cast i64 have) (primitive/cast i64 fnty)))
      (cg-fail (sconcat3 a
                         (sconcat3 a
                                   "C symbol '"
                                   csym
                                   "' is declared twice with different signatures: ")
                         (sconcat3 a
                                   (if (> (len prior) 0)
                                       (sconcat3 a "'" prior "'")
                                       "an earlier declaration")
                                   " is "
                                   (from-cstr (LLVMPrintTypeToString have)))
                         (sconcat3 a
                                   (sconcat3 a ", '" ename "' is ")
                                   (from-cstr (LLVMPrintTypeToString fnty))
                                   ". One C symbol, one signature: fix the types to match, or use a different symbol"))))))

; 1a: declare externs.
(defn cg-declare-externs [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [a (.a cg)
        es (load (field p externs))
        n (len (load es))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (elem es (load i))
                      ename (.name ep)
                      params (load (field ep params))
                      ret (.ret ep)
                      csym (extern-link-name ep)
                      ; the extern's convention -> its native LLVM calling-convention id
                      ; (externs are always native; a :shim extern is rejected in check).
                      conv (cg-prog-conv p (cc-identity (.cc ep)))
                      cc-id
                        (when (!= (primitive/cast i64 conv)
                                  0)
                          (conv-native-id conv))]
                  (cg-at! (.span_source ep) (.params_lo ep) (.ret_hi ep) 0)
                  ; Eager C-ABI view check for EVERY extern
                  ; before — and regardless of — the struct-by-value branch below. A bare
                  ; `(slice u8)`/`(vec …)` param isn't a struct, so the struct branch
                  ; alone would wave it through; this catches it at declaration.
                  (cg-check-c-abi-types cg
                                        params
                                        (box-type a ret)
                                        (sconcat3 a "extern '" ename "'"))
                  (if (or (cg-abi-aggregate? cg (box-type a ret))
                          (ty-list-has-aggregate cg params))
                      (let [sig
                              (c-signature cg
                                           params
                                           (box-type a ret)
                                           (.variadic ep))
                            existing
                              (LLVMGetNamedFunction (load (field cg module))
                                                    (to-cstr a csym))
                            fv
                              (if (!= (primitive/cast i64 existing)
                                      0)
                                  (do
                                    (cg-extern-redecl-check cg
                                                            existing
                                                            (load (field sig
                                                                         fn_ty))
                                                            (cg-extern-prior-decl p
                                                                                  csym
                                                                                  (load i))
                                                            ename
                                                            csym)
                                    existing)
                                  (let [nf
                                          (cg-add-function cg
                                                           (to-cstr a csym)
                                                           (load (field sig
                                                                        fn_ty)))]
                                    (cg-apply-csig-attrs cg sig nf false)
                                    (LLVMSetFunctionCallConv nf
                                                             (primitive/cast i32
                                                                             cc-id))
                                    nf))]
                        (when (not (cg-has-csig cg ename))
                          (cg-add-csig cg ename sig))
                        (cg-add-func-ty cg ename fv (load (field sig fn_ty)))
                        (cg-record-callable cg ename (cc-identity (.cc ep)) params ret))
                      (let [existing
                              (LLVMGetNamedFunction (load (field cg module))
                                                    (to-cstr a csym))
                            fnty
                              (cg-fn-type-v cg
                                            params
                                            (box-type a ret)
                                            (.variadic ep))
                            fv
                              (if (!= (primitive/cast i64 existing)
                                      0)
                                  (do
                                    (cg-extern-redecl-check cg
                                                            existing
                                                            fnty
                                                            (cg-extern-prior-decl p
                                                                                  csym
                                                                                  (load i))
                                                            ename
                                                            csym)
                                    existing)
                                  (let [nf
                                          (cg-add-function cg
                                                           (to-cstr a csym)
                                                           fnty)]
                                    (LLVMSetFunctionCallConv nf
                                                             (primitive/cast i32
                                                                             cc-id))
                                    nf))]
                        (cg-add-func-ty cg ename fv fnty)
                        (cg-record-callable cg ename (cc-identity (.cc ep)) params ret))))
                (set! i (primitive/iadd (load i) 1)))))
    (cg-site-clear!)
    0))

; 1b: declare functions (native path only; no shims/exports in corpus).
; A name this unit publishes for other units to `declare` and link against.
(defn cg-unit-export? [(p (ptr Program)) (name (slice u8))] (-> bool)
  (let [ue (load (field p unit_exports))
        n (len (load ue))
        (mut r) false]
    (for [i 0 n] (when (= (get (load ue) i) name) (set! r true) 0) 0)
    (load r)))

(defn cg-has-anchor [(p (ptr Program))] (-> bool)
  (let [fs (load (field p funcs))
        n (len (load fs))
        (mut i) 0
        (mut r) false]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (.name (elem fs (load i)))
                         "main")
                  (set! r true)
                  0)
                (set! i (primitive/iadd (load i) 1)))))
    (let [es (load (field p exports))
          (mut published) false]
      (for [i 0 (len (load es))]
        (when (.published (elem es i)) (set! published true) 0))
      (or (load r) (load published)))))

; find the ExportC for a function name (null if not exported).
(defn cg-export-find [(p (ptr Program)) (name (slice u8))] (-> (ptr ExportC))
  (let [es (load (field p exports))
        n (len (load es))
        (mut i) 0
        (mut r) (primitive/cast (ptr ExportC) 0)]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (.name (elem es (load i)))
                         name)
                  (set! r (elem es (load i)))
                  (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load r)))

;;; An `(export-c [f :as "S"])` defines the C symbol S, and every extern of S in the
;;; program binds to that definition, as when C objects are linked and one defines
;;; what another declares. Externs are declared first, so S may already hold an
;;; extern's placeholder declaration; drop it before the definition takes the name
;;; (LLVM would otherwise rename the definition to `S.1`). Nothing has been emitted
;;; against a placeholder yet: only the name table knows it. 0 when there is none.
(defn cg-drop-extern-placeholder [(cg (ptr Cg)) (name (slice u8))] (-> (ptr i8))
  (let [old
          (LLVMGetNamedFunction (load (field cg module))
                                (to-cstr (.a cg) name))]
    (when (!= (primitive/cast i64 old) 0)
      (LLVMDeleteFunction old)
      0)
    old))

;;; Bind every name that pointed at the dropped placeholder to the definition. Each
;;; keeps the function type its own declaration wrote (CgFunc.fnty), so an extern
;;; declared with another integer width still calls the definition through its own
;;; prototype. wasm imports and calls are typed per symbol, so there the types must
;;; agree exactly.
(defn cg-repoint-extern-placeholder [(cg (ptr Cg)) (old (ptr i8)) (fv (ptr i8))] (-> i64)
  (unless (= (primitive/cast i64 old) 0)
    (let [defty (LLVMGlobalGetValueType fv)]
      (for [i 0 (len (.funcs cg))]
        (let [fp (elem (field cg funcs) i)]
          (when (= (primitive/cast i64 (load (field fp val)))
                   (primitive/cast i64 old))
            (when (and (= (.arch cg) 2)
                       (!= (primitive/cast i64 (load (field fp fnty)))
                           (primitive/cast i64 defty)))
              (cg-fail (sconcat3 (.a cg)
                                 "extern '"
                                 (.name fp)
                                 "' calls a C symbol this program exports; wasm needs the definition and the extern to agree on their exact types")))
            (set! (.val fp) fv)
            0)
          0))))
  0)

(defn cg-declare-funcs [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [a (.a cg)
        fs (load (field p funcs))
        n (len (load fs))
        anchor (cg-has-anchor p)
        (mut i) 0]
    (let [origins (load (field p mono_origins))]
      (for [k 0 (len (load origins))]
        (set! (mut (.spec_names cg))
              (.generated (elem origins k))
              true)
        0))
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (elem fs (load i))
                      fname (.name fp)
                      conv (cg-prog-conv p (cc-identity (.cc fp)))
                      reset-cc
                        (and (!= (primitive/cast i64 conv)
                                 0)
                             (conv-is-reset conv))
                      fparams (cg-param-types cg (load (field fp params)))
                      ret (.ret fp)
                      exp (cg-export-find p fname)
                      ; a thunk-FREE C export is emitted directly under its C symbol; everything
                      ; else (incl. a thunk-needing export's internal function) under its Coil name.
                      direct-sym
                        (if (and (!= (primitive/cast i64 exp)
                                     0)
                                 (not (export-c-needs-thunk? exp)))
                            (.symbol exp)
                            (None [(slice u8)]))
                      llvm-name
                        (if reset-cc
                            "_start"
                            (match direct-sym (Some [sm] sm) (None [] fname)))
                      ; A `declare`d function is a REFERENCE to another unit's
                      ; definition, and a unit export is a definition another unit
                      ; references: both are external whether or not this unit is
                      ; a program. `main` is the process entry only of a program;
                      ; a unit's is whatever the rest of these rules make it.
                      external
                        (or reset-cc
                            (and (not (.unit_build cg)) (= fname "main"))
                            (match direct-sym
                              (Some [sm2] true)
                              (None [] false))
                            (.declared fp)
                            (if (.unit_build cg)
                                (cg-unit-export? p fname)
                                (not anchor)))]
                  (cg-record-callable cg fname (cc-identity (.cc fp)) fparams ret)
                  (if (and (!= (primitive/cast i64 conv) 0)
                           (conv-is-shim conv))
                      ; :shim lowering -> a `ccc` __impl carrying the body + a `naked` void
                      ; trampoline under the Coil name. Machine code is that naked
                      ; function itself, so it has no __impl.
                      ; the checker allows no :ret only for a function with no result
                      (let [ret-reg (match (.ret conv) (Some [r] r) (None [] ""))
                            fnty (cg-fn-type cg fparams (box-type a ret))
                            impl-fn
                              (match (func-machine-code fp)
                                (Some [_] (primitive/cast (ptr i8) 0))
                                (None []
                                      (cg-add-function cg
                                                       (to-cstr a
                                                                (sconcat a
                                                                         fname
                                                                         "__impl"))
                                                       fnty)))
                            void-ty
                              (LLVMFunctionType (LLVMVoidTypeInContext (cg-ctx cg))
                                                (carr a (ArrayList::new [(ptr i8)] a))
                                                0
                                                0)
                            tramp
                              (cg-add-function cg (to-cstr a fname) void-ty)]
                        (LLVMAddAttributeAtIndex tramp
                                                 (: -1 i32)
                                                 (cg-enum-attr cg "naked" 0))
                        (LLVMAddAttributeAtIndex tramp
                                                 (: -1 i32)
                                                 (cg-enum-attr cg "noinline" 0))
                        (cg-add-func cg fname tramp)
                        (cg-add-shim cg
                                     fname
                                     impl-fn
                                     (load (field conv params))
                                     ret-reg
                                     (load (field conv
                                                  clobber))
                                     (cg-machine-code-inline-asm cg fp)))
                      (let [cc-id
                              (when (!= (primitive/cast i64 conv)
                                        0)
                                (conv-native-id conv))]
                        (if (or (cg-abi-aggregate? cg (box-type a ret))
                                (ty-list-has-aggregate cg fparams))
                            (let [sig
                                    (c-signature cg
                                                 fparams
                                                 (box-type a ret)
                                                 false)
                                  old
                                    (match direct-sym
                                      (Some [sm]
                                            (cg-drop-extern-placeholder cg sm))
                                      (None [] (primitive/cast (ptr i8) 0)))
                                  fv
                                    (cg-add-function cg
                                                     (to-cstr a llvm-name)
                                                     (load (field sig fn_ty)))]
                              (cg-repoint-extern-placeholder cg old fv)
                              (LLVMSetFunctionCallConv fv
                                                       (primitive/cast i32
                                                                       cc-id))
                              (when reset-cc
                                (LLVMSetSection fv c".text.entry")
                                (set! (.reset_func cg) fv)
                                (LLVMAddAttributeAtIndex fv
                                                         (: -1 i32)
                                                         (cg-enum-attr cg
                                                                       "noinline"
                                                                       0))
                                0)
                              (cg-apply-csig-attrs cg sig fv false)
                              (cg-add-csig cg fname sig)
                              (when (not external) (LLVMSetLinkage fv 8) 0)
                              (cg-add-func cg fname fv))
                            (let [fnty (cg-fn-type cg fparams (box-type a ret))
                                  old
                                    (match direct-sym
                                      (Some [sm]
                                            (cg-drop-extern-placeholder cg sm))
                                      (None [] (primitive/cast (ptr i8) 0)))
                                  fv
                                    (cg-add-function cg
                                                     (to-cstr a llvm-name)
                                                     fnty)]
                              (cg-repoint-extern-placeholder cg old fv)
                              (LLVMSetFunctionCallConv fv
                                                       (primitive/cast i32
                                                                       cc-id))
                              (when reset-cc
                                (LLVMSetSection fv c".text.entry")
                                (set! (.reset_func cg) fv)
                                (LLVMAddAttributeAtIndex fv
                                                         (: -1 i32)
                                                         (cg-enum-attr cg
                                                                       "noinline"
                                                                       0))
                                0)
                              (when (not external) (LLVMSetLinkage fv 8) 0)
                              (cg-add-func cg fname fv))))))
                (set! i (primitive/iadd (load i) 1)))))
    0))

; 2b: C-ABI export THUNKS. For each export that
; takes a struct by value, emit the external C-symbol function that marshals the C ABI
; into the reference-model (pointer) args the internal function takes, then calls it.
(defn cg-emit-export-thunk [(cg (ptr Cg))
                            (c-symbol (slice u8))
                            (internal-name (slice u8))
                            (internal (ptr i8))
                            (params (ptr (ArrayList Type)))
                            (ret (ptr Type))] (-> i64)
  (let [a (.a cg)
        b (cg-bld cg)
        sig (c-signature cg params ret false)
        thunk
          (cg-add-function cg (to-cstr a c-symbol) (load (field sig fn_ty)))]
    (LLVMSetFunctionCallConv thunk 0)
    (cg-apply-csig-attrs cg sig thunk false)
    (let [entry (cg-append cg thunk (cg-bl cg "entry"))]
      (cg-pos cg entry)
      (let [(mut meta) (ArrayList::new [(ptr i8)] a)
            sret-sa (load (field sig sret))
            (mut idx) 0]
        (when (!= (primitive/cast i64 sret-sa) 0)
          (push! (mut meta) (LLVMGetParam thunk 0))
          (set! idx 1))
        (let [args (load (field sig args))
              n (len (load args))
              (mut i) 0]
          (loop (if (>= (load i) n)
                    (break)
                    (do
                      (match (get (load args) (load i))
                        (AAScalar []
                                  (do
                                    (push! (mut meta)
                                           (LLVMGetParam thunk
                                                         (primitive/cast i32
                                                                         (load idx))))
                                    (set! idx (primitive/iadd (load idx) 1))))
                        (AADirect [sa]
                                  ; padded for the same reason the call side is: the loop below
                                  ; STORES one whole i64 per ABI slot, so a 4-byte struct in a
                                  ; 4-byte alloca would be written 4 bytes past its end. LLVM
                                  ; folded that to poison and the argument reached the callee as
                                  ; zero — with `mov x0, xzr` right there in the disassembly.
                                  (let [slot
                                          (cg-struct-slot-padded cg
                                                                 sa
                                                                 "thunk.arg")]
                                    (match (.arg sa)
                                      (ACDirect [slots]
                                                (let [ns (len (load slots))
                                                      (mut k) 0]
                                                  (loop (if (>= (load k) ns)
                                                            (break)
                                                            (do
                                                              (let [v
                                                                      (LLVMGetParam thunk
                                                                                    (primitive/cast i32
                                                                                                    (load idx)))
                                                                    off
                                                                      (primitive/imul (load k)
                                                                                      8)
                                                                    gep
                                                                      (if (= off
                                                                             0)
                                                                          slot
                                                                          (cg-gep-i8 cg
                                                                                     slot
                                                                                     off))]
                                                                (LLVMBuildStore b
                                                                                v
                                                                                gep)
                                                                (set! idx
                                                                      (primitive/iadd (load idx)
                                                                                      1)))
                                                              (set! k
                                                                    (primitive/iadd (load k)
                                                                                    1)))))
                                                  0))
                                      (_ 0))
                                    (push! (mut meta) slot)))
                        (AAIndirect [sa]
                                    (do
                                      (push! (mut meta)
                                             (LLVMGetParam thunk
                                                           (primitive/cast i32
                                                                           (load idx))))
                                      (set! idx (primitive/iadd (load idx) 1)))))
                      (set! i (primitive/iadd (load i) 1)))))
          (let [cs
                  (LLVMBuildCall2 b
                                  (LLVMGlobalGetValueType internal)
                                  internal
                                  (carr a (load meta))
                                  (primitive/cast i32 (len (load meta)))
                                  (cg-call-name cg
                                                (LLVMGlobalGetValueType internal)
                                                "thunk.call"))]
            (LLVMSetInstructionCallConv cs (LLVMGetFunctionCallConv internal))
            (when (cg-has-csig cg internal-name)
              (cg-apply-csig-attrs cg (cg-csig cg internal-name) cs true))
            (if (or (!= (primitive/cast i64 sret-sa) 0)
                    (ty-is-void ret))
                (do (LLVMBuildRetVoid b) 0)
                (do (LLVMBuildRet b cs) 0)))))
      0)))

(defn cg-emit-thunks [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [a (.a cg)
        es (load (field p exports))
        n (len (load es))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [ep (elem es (load i))]
                  (when (export-c-needs-thunk? ep)
                    (let [sym
                            (match (.symbol ep)
                              (Some [s] s)
                              (None [] ""))
                          internal (cg-func cg (.name ep))
                          ret
                            (match (cg-ret cg (.name ep))
                              (Some [t] (box-type a t))
                              (None [] (box-type a (TVoid))))]
                      (cg-emit-export-thunk cg
                                            sym
                                            (.name ep)
                                            internal
                                            (load (field ep
                                                         params))
                                            ret)
                      ; An unpublished entry is reached only through fnptr-of.
                      (unless (.published ep)
                        (LLVMSetLinkage (LLVMGetNamedFunction (load (field cg
                                                                           module))
                                                              (to-cstr a sym))
                                        8)
                        0))))
                (set! i (primitive/iadd (load i) 1)))))
    0))

(defn cg-param-types [(cg (ptr Cg)) (params (ptr (ArrayList Param)))] (-> (ptr (ArrayList Type)))
  (let [a (.a cg)
        n (len (load params))
        (mut out) (ArrayList::new [Type] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (push! (mut out) (.ty (elem params (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (box-al [Type] a (load out))))

; 2: emit bodies.
(defn cg-emit-bodies [(cg (ptr Cg)) (p (ptr Program))] (-> i64)
  (let [fs (load (field p funcs))
        n (len (load fs))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (let [fp (elem fs (load i))
                      fname (.name fp)
                      shim (cg-shim-find cg fname)]
                  (cg-at! (.source fp) (.lo fp) (.hi fp) 0)
                  ; A `declare`d function keeps the LLVM function it was declared
                  ; as: emitting its empty body would define the symbol as a
                  ; function that falls off its own end, and the real definition
                  ; in the other unit's object would then collide with it at link.
                  (unless (.declared fp)
                    (cg-emit-func-body cg fp (cg-func cg fname) shim)))
                (set! i (primitive/iadd (load i) 1)))))
    (cg-site-clear!)
    0))

; ===== Port of — cancels codegen's run-to-run nondeterminism
; so the self-host's LLVMPrintModuleToString text matches the normalized reference.
; Faithful, function-for-function port. Families: 0=g 1=str 2=cstr 3=llvmir.
; Categories: 0=type 1=global 2=declare 3=define 4=misc.
