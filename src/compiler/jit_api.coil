;; In-process incremental compiler and hot-reloading JIT.
;;
;; This is an opt-in source-linked SDK: importing `coil.jit` pulls the native
;; compiler implementation into this program. Programs that do not import it
;; contain no compiler or JIT code.
(module jit_api)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [Allocator alloc-bytes oom-at alloc-slice-new])
(import "coil.arraylist" :use [ArrayList al-new])
(import "coil.slice" :use [slice-data slice-len])
(import "coil.str" :use [str-trim starts-with])
(import "coil.io" :use [stdout print-str write-byte])
(import "coil.result" :use *)

; Private compiler-SDK implementation modules. Their types never occur in the
; exported API.
(import "ast" :use [Program])
(import "macho" :use [MObj])
(import "parser" :use [box-al])
(import "cga64" :use [cga64-build-mobj cga64-build-object])
(import "jit_llvm" :as llvm-jit)
(import "metaengine" :use [set-meta-build-mobj! set-meta-build-obj! set-meta-jit!])
(import "comptime_eval" :use [register-comptime-fold!])
(import "loader" :use [cstr->slice set-self-command!])
(import "driver" :as sdk)

(export JitSession
        jit-session-new
        jit-session-new-with-toolchain
        jit-submit!
        jit-source
        jit-reset!
        jit-supported?
        jit-backend
        jit-repl-main)

;; Opaque session owner. Treat `raw` as private; its representation is not a
;; compatibility promise. Session memory has the allocator's lifetime.
(defstruct JitSession [(raw (ptr i8))])

(defn sdk-meta-object [(a (dyn Allocator)) (mp (ptr Program)) (out (ptr i8))] (-> i64)
  (cga64-build-object a
                      mp
                      out
                      ""
                      ""
                      (box-al [(slice u8)] a (al-new [(slice u8)] a))
                      (box-al [(slice u8)] a (al-new [(slice u8)] a))
                      false))

(defn sdk-meta-mobj [(a (dyn Allocator)) (mp (ptr Program))] (-> MObj)
  (cga64-build-mobj a
                    mp
                    ""
                    ""
                    (box-al [(slice u8)] a (al-new [(slice u8)] a))
                    (box-al [(slice u8)] a (al-new [(slice u8)] a))
                    false))

(defn sdk-init-arm64! [(toolchain (slice u8))] (-> i64)
  ; The runtime compiler locates the matching stdlib relative to this command.
  ; A bare `coil` is resolved through PATH by loader.coil.
  (set-self-command! toolchain)
  (set-meta-build-obj! (primitive/fnptr-of sdk-meta-object))
  (set-meta-build-mobj! (primitive/fnptr-of sdk-meta-mobj))
  ; A JIT session must keep its entire compilation pipeline in-process. This also
  ; routes macros used by submitted forms through the MObj loader instead of the
  ; legacy temporary-dylib/cc path.
  (set-meta-jit! true)
  (register-comptime-fold!)
  0)

(defn sdk-meta-object-llvm [(a (dyn Allocator)) (mp (ptr Program)) (out (ptr i8))] (-> i64)
  (llvm-jit/jit-llvm-build-object a mp out))

(defn sdk-init-llvm! [(toolchain (slice u8))] (-> i64)
  (set-self-command! toolchain)
  ; Linux metaprograms still use the transactional temporary-dylib path. Their
  ; object must be host ELF, while submitted runtime programs use LLVM in-process.
  (set-meta-build-obj! (primitive/fnptr-of sdk-meta-object-llvm))
  (set-meta-jit! false)
  (register-comptime-fold!)
  0)

(defn sdk-session-arm64 [(a (dyn Allocator))] (-> (ptr i8))
  (sdk/repl-session-new-with-runner a (primitive/fnptr-of sdk/repl-arm64-runner)))

(defn sdk-session-llvm [(a (dyn Allocator))] (-> (ptr i8))
  (sdk/repl-session-new-with-runner a (primitive/fnptr-of llvm-jit/jit-llvm-run)))

; Generate the host-specific SDK calls so an ARM64 user program does not acquire
; LLVM references merely because the Linux implementation is available, and an
; x86-64 program never reaches the Mach-O builder.
(defn sdk-host-impl [] (-> Code)
  (let [linux-x64 (primitive/code-eq (primitive/target-os) `linux)
        ; hygiene: host-selected SDK declarations intentionally enter this module's namespace.
        init-name (primitive/syntax->datum `sdk-init!)
        session-name (primitive/syntax->datum `sdk-new-session)]
    `(do
       (defn ~init-name [(toolchain (slice u8))] (-> i64)
         (~(if linux-x64 `sdk-init-llvm! `sdk-init-arm64!) toolchain))
       (defn ~session-name [(a (dyn Allocator))] (-> (ptr i8))
         (~(if linux-x64 `sdk-session-llvm `sdk-session-arm64) a)))))
(meta (sdk-host-impl))

;; Create a session using `toolchain` to locate the runtime compiler's matching
;; standard library. Pass an absolute coil executable or a PATH-resolvable name.
(defn jit-session-new-with-toolchain [(a (dyn Allocator))
                                      (toolchain (slice u8))] (-> JitSession)
  (sdk-init! toolchain)
  (let [s (primitive/alloc-stack JitSession)]
    (set! (.raw s) (sdk-new-session a))
    (load s)))

;; Create a session using the `coil` executable found on PATH.
(defn jit-session-new [(a (dyn Allocator))] (-> JitSession)
  (jit-session-new-with-toolchain a "coil"))

;; Compile and evaluate one complete Coil form. Definitions are committed only
;; after successful compilation. Returns 0 on success and 1 after rendering a
;; diagnostic on stderr.
(defn jit-submit! [(session (ptr JitSession)) (source (slice u8))] (-> i64)
  (sdk/repl-session-submit! (load (field session raw)) source))

;; Accumulated successful definition source. Borrowed for the session lifetime.
(defn jit-source [(session (ptr JitSession))] (-> (slice u8))
  (sdk/repl-session-source (load (field session raw))))

;; Clear definitions and begin a fresh persistent-static lineage.
(defn jit-reset! [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-reset! (load (field session raw))))

; Generate truthful target queries without exposing compiler target state at runtime.
(defn sdk-target-api [] (-> Code)
  (let [darwin-arm
          (and (primitive/code-eq (primitive/target-os) `darwin)
               (primitive/code-eq (primitive/target-arch) `aarch64))
        linux-x64 (primitive/code-eq (primitive/target-os) `linux)
        supported (or darwin-arm linux-x64)
        ; hygiene: the generated public JIT API intentionally enters this module's namespace.
        supported-name (primitive/syntax->datum `jit-supported?)
        backend-name (primitive/syntax->datum `jit-backend)]
    `(do
       (defn ~supported-name [] (-> bool)
         ~supported)
       (defn ~backend-name [] (-> (slice u8))
         ~(if darwin-arm
              "arm64-macho"
              (if linux-x64 "llvm-mcjit-x86_64-linux" "unsupported"))))))
(meta (sdk-target-api))

;; The stock terminal UI is deliberately a client of this public module. Compiler
;; entrypoints pass this callback into their otherwise JIT-agnostic CLI driver.
(defn jit-repl-main [(a (dyn Allocator)) (argv (ptr (ptr i8)))] (-> i64)
  (let [toolchain (cstr->slice (load argv))
        (mut session) (jit-session-new-with-toolchain a toolchain)
        buf (primitive/cast (ptr i8) (slice-data [u8] (match (alloc-bytes a 4 1) (Some [s] s) (None [] (do (oom-at c"compiler allocation" 4) (alloc-slice-new (primitive/cast (ptr u8) 0) 0))))))
        out (stdout)]
    (print-str out
               "coil repl — evaluate an expr (printed by type), or (defn …)/(def …) to define. :help, Ctrl-D to exit.\n")
    (loop (print-str out "coil> ")
      (match (sdk/repl-read-form a buf)
        (None [] (break))
        (Some [line]
              (let [form (str-trim line)]
                (cond (or (= form ":quit") (= form ":q")) (break)
                      (or (= form ":help") (= form ":h")) (do (print-str out (sdk/repl-help-text)) 0)
                      :else
                        (let [rc (jit-submit! (mut session) form)]
                          (when (and (= rc 0)
                                     (or (starts-with form "(def")
                                         (or (starts-with form "(const")
                                             (starts-with form "(import"))))
                            (print-str out "; ok\n")
                            0)
                          rc))))))
    (write-byte out (primitive/cast u8 10))
    0))
