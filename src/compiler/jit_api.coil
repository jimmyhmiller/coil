;; In-process retained compiler and JIT.
;;
;; This is an opt-in source-linked SDK: importing `coil.jit` pulls the native
;; compiler implementation into this program. Programs that do not import it
;; contain no compiler or JIT code.
(module coil.compiler.jit_api)
(import "coil.compiler.live_ir" :as live-ir)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.fs" :as fs)
(import "coil.str" :as str)
(import "coil.reader" :as reader)
(import "coil.compiler.loader" :as loader)
(import "coil.result" :use *)

; Private compiler-SDK implementation modules. Their types never occur in the
; exported API.
(import "coil.compiler.ast" :use [Program])
(import "coil.compiler.macho" :use [MObj])
(import "coil.compiler.parser" :use [box-al new-boxed-list])
(import "coil.compiler.codegen_a64" :use [cga64-build-mobj cga64-build-object])
(import "coil.compiler.jit_llvm" :as llvm-jit)
(import "coil.compiler.metaengine"
        :use
        [set-meta-build-mobj! set-meta-build-obj! set-meta-jit!])
(import "coil.compiler.comptime_eval" :use [register-comptime-fold!])
(import "coil.compiler.loader" :use [set-self-command!])
(import "coil.compiler.driver" :as sdk)
(import "coil.cc" :as cc)

(export jit-checked-session-new-with-toolchain
        JitEnv
        jit-env-current
        jit-env-empty
        jit-env-check
        jit-env-valid?
        jit-env-retain
        jit-env-release!
        jit-env-defines?
        jit-env-live-function
        jit-env-stale-count
        jit-env-stale-name
        jit-env-definition-source
        jit-live-schema
        jit-checked-session-new
        jit-live-function
        JitSourceGraph
        jit-read-source-graph
        jit-source-graph-ok?
        jit-source-graph-entry
        jit-source-graph-diagnostic
        jit-source-graph-error-path
        jit-source-graph-error-line
        jit-source-graph-count
        jit-source-graph-module
        jit-source-graph-path
        jit-source-graph-text
        JitSession
        JitBackend
        Native
        Llvm
        Tpde
        JitOptions
        JitOptionsError
        UnsupportedBackend
        InvalidOptLevel
        jit-default-options
        jit-session-new-with-options
        jit-session-backend
        jit-backend-name
        jit-options-error-message
        jit-session-new
        jit-session-new-with-toolchain
        jit-session-set-environment!
        jit-session-load-project!
        jit-session-set-source-provider!
        jit-session-set-quiet!
        jit-session-set-source-name!
        jit-symbol-address
        jit-evaluate!
        jit-compile!
        jit-prepare!
        jit-prepare-with-entry!
        jit-compile-with-entry!
        jit-commit-prepared!
        jit-publish-prepared!
        jit-finalize-published!
        jit-finalization-pending?
        jit-abort-prepared!
        jit-prepared?
        jit-pending
        jit-diagnostic
        jit-condition-kind
        jit-repair-count
        jit-repair-function
        jit-repair-annotation-i64!
        jit-repair-diagnostic
        jit-status
        jit-epoch
        jit-generation-retain!
        jit-generation-release!
        jit-generation-leases
        jit-generation-count
