        jit-generation-retain-reserved!
        jit-generation-retain-current!
        jit-generation-release-token!
        jit-generation-token-leases
        jit-reclaim-retired!
        jit-reset!
        jit-session-free!
        jit-supported?
        jit-backend
        jit-repl-main)

;;; The code generator a session publishes runtime code with. `Native` is Coil's
;;; own arm64 backend: it compiles fast and generates unoptimized code, and exists
;;; only on macOS arm64. `Tpde` is the tpde backend (`--backend tpde`), loaded the
;;; same way: it compiles as fast and generates code faster than LLVM -O0's, on
;;; macOS arm64. `Llvm` compiles through LLVM's ORC JIT at a chosen
;;; optimization level, on macOS arm64 and Linux. Metaprograms run on the host's
;;; in-memory engine whichever backend publishes the runtime code.
(defsum JitBackend (Native) (Llvm) (Tpde))

;;; Options for `jit-session-new-with-options`. `toolchain` locates the runtime
;;; compiler's matching standard library (an absolute coil executable or a
;;; PATH-resolvable name). `opt-level` is 0-3 and applies to `Llvm` only; it runs
;;; LLVM's `default<ON>` pipeline, as an AOT `-ON` build does.
(defstruct JitOptions
  [(toolchain (slice u8)) (backend JitBackend) (opt-level i64)])

;;; Why `jit-session-new-with-options` refused its options.
(defsum JitOptionsError
  (UnsupportedBackend [(backend JitBackend)])
  (InvalidOptLevel [(level i64)]))

;;; Opaque session owner. Treat `raw` as private; its representation is not a
;;; compatibility promise. Session memory has the allocator's lifetime.
(defstruct JitSession [(raw (ptr i8)) (backend JitBackend)])

(impl Eq JitBackend
  (= [(a JitBackend) (b JitBackend)]
    (-> bool)
    (= (jit-backend-name a) (jit-backend-name b))))

(derive Debug JitBackend)

(derive Debug JitOptionsError)

;;; `"native"`, `"llvm"` or `"tpde"`.
(defn jit-backend-name [(backend JitBackend)] (-> (slice u8))
  (match backend (Native [] "native") (Llvm [] "llvm") (Tpde [] "tpde")))

;;; Why options were refused, as one line of text.
(defn jit-options-error-message [(error JitOptionsError)] (-> (slice u8))
  (match error
    (UnsupportedBackend [backend]
                        (match backend
                          (Native [] "this host has no native JIT backend")
                          (Llvm [] "this host has no LLVM JIT backend")
                          (Tpde [] "this host has no tpde JIT backend")))
    (InvalidOptLevel [_]
                     "opt-level must be 0-3, and 0 for the native and tpde backends")))

(defn sdk-meta-object [(a (dyn Allocator)) (mp (ptr Program)) (out (ptr i8))]
  (-> i64)
  (cga64-build-object a
                      mp
                      out
                      ""
                      ""
                      (new-boxed-list [(slice u8)] a)
                      (new-boxed-list [(slice u8)] a)
                      false))

(defn sdk-meta-mobj [(a (dyn Allocator)) (mp (ptr Program))] (-> MObj)
  (cga64-build-mobj a
                    mp
                    ""
                    ""
                    (new-boxed-list [(slice u8)] a)
                    (new-boxed-list [(slice u8)] a)
                    false))

(defn sdk-init-arm64! [(toolchain (slice u8))] (-> i64)
  ; The runtime compiler locates the matching stdlib relative to this command.
  ; A bare `coil` is resolved through PATH by loader.coil.
  (set-self-command! toolchain)
  (set-meta-build-obj! (fnptr-of sdk-meta-object))
  (set-meta-build-mobj! (fnptr-of sdk-meta-mobj))
  ; A JIT session must keep its entire compilation pipeline in-process. This also
  ; routes macros used by submitted forms through the MObj loader instead of the
  ; legacy temporary-dylib/cc path.
  (set-meta-jit! true)
  (sdk/select-meta-interp-from-env!)
  (register-comptime-fold!)
  0)

(defn sdk-meta-object-llvm [(a (dyn Allocator))
                            (mp (ptr Program))
                            (out (ptr i8))] (-> i64)
  (llvm-jit/jit-llvm-build-object a mp out))

(defn sdk-init-llvm! [(toolchain (slice u8))] (-> i64)
  (set-self-command! toolchain)
  ; Linux metaprograms still use the transactional temporary-dylib path. Their
  ; object must be host ELF, while submitted runtime programs use LLVM in-process.
  (set-meta-build-obj! (fnptr-of sdk-meta-object-llvm))
  (set-meta-jit! false)
  (sdk/select-meta-interp-from-env!)
  (register-comptime-fold!)
  0)

(defn sdk-session-arm64 [(a (dyn Allocator))] (-> (ptr i8))
  (sdk/repl-session-new-with-runner a
                                    (fnptr-of sdk/repl-arm64-runner)
                                    (fnptr-of sdk/repl-arm64-reclaim!)
                                    (fnptr-of sdk/repl-arm64-generation-count)
                                    (fnptr-of sdk/repl-arm64-retain-current!)
                                    (fnptr-of sdk/repl-arm64-release-token!)
                                    (fnptr-of sdk/repl-arm64-token-leases)
                                    (fnptr-of sdk/repl-arm64-set-roots!)))

;;; The native session with tpde compiling its code.
(defn sdk-session-tpde [(a (dyn Allocator))] (-> (ptr i8))
  (sdk/repl-session-new-with-runner a
                                    (fnptr-of sdk/repl-tpde-runner)
                                    (fnptr-of sdk/repl-arm64-reclaim!)
                                    (fnptr-of sdk/repl-arm64-generation-count)
                                    (fnptr-of sdk/repl-arm64-retain-current!)
                                    (fnptr-of sdk/repl-arm64-release-token!)
                                    (fnptr-of sdk/repl-arm64-token-leases)
                                    (fnptr-of sdk/repl-arm64-set-roots!)))

(defn sdk-llvm-runner [(opt-level i64)]
  (-> (fnptr (cc/C)
             [(ref (dyn Allocator))
              (ptr Program)
              (ptr (ArrayList (slice u8)))
              (ptr (ArrayList (slice u8)))
              (ptr (ptr i8))
              (slice u8)]
             i64))
  (cond (= opt-level 1) (fnptr-of llvm-jit/jit-llvm-run-o1)
        (= opt-level 2) (fnptr-of llvm-jit/jit-llvm-run-o2)
        (= opt-level 3) (fnptr-of llvm-jit/jit-llvm-run-o3)
        :else (fnptr-of llvm-jit/jit-llvm-run)))

(defn sdk-session-llvm [(a (dyn Allocator)) (opt-level i64)] (-> (ptr i8))
  (sdk/repl-session-new-with-runner a
                                    (sdk-llvm-runner opt-level)
                                    (fnptr-of llvm-jit/llvm-jit-reclaim!)
                                    (fnptr-of llvm-jit/llvm-jit-generation-count)
                                    (fnptr-of llvm-jit/llvm-jit-retain-current!)
                                    (fnptr-of llvm-jit/llvm-jit-release-token!)
                                    (fnptr-of llvm-jit/llvm-jit-token-leases)
                                    (fnptr-of llvm-jit/llvm-jit-set-roots!)))

(defn sdk-symbol-address-llvm [(raw (ptr i8)) (name (slice u8))] (-> (ptr i8))
  (let [state (sdk/repl-session-native-state raw)]
    (if (= (primitive/cast i64 state) 0)
        (primitive/cast (ptr i8) 0)
        (llvm-jit/llvm-jit-sym-lookup (primitive/cast (ptr llvm-jit/LLVMJitState)
                                                      state)
                                      name))))

; Generate the host-specific SDK calls. Metaprograms use the host's in-memory
; engine; the native runtime backend exists only on macOS arm64, so an x86-64
; program never reaches the Mach-O loader.
(defn sdk-host-impl [] (-> Code)
  (let [linux-x64 (match (target-os) (Linux [] true) (_ false))
        ; hygiene: host-selected SDK declarations intentionally enter this module's namespace.
        init-name (primitive/syntax->datum `sdk-init!)
        native-session-name (primitive/syntax->datum `sdk-native-session)
        native-lookup-name (primitive/syntax->datum `sdk-native-symbol-address)
        native-name (primitive/syntax->datum `sdk-native-available?)
        default-name (primitive/syntax->datum `sdk-default-backend)]
    `(do
       (defn ~init-name [(toolchain (slice u8))] (-> i64)
         (~(if linux-x64 `sdk-init-llvm! `sdk-init-arm64!) toolchain))
       (defn ~native-name [] (-> bool)
         ~(not linux-x64))
       (defn ~default-name [] (-> JitBackend)
         ~(if linux-x64 `(Llvm) `(Native)))
       ~(if linux-x64
            `(defn ~native-session-name [(a (dyn Allocator))] (-> (ptr i8))
               (primitive/cast (ptr i8) 0))
            `(defn ~native-session-name [(a (dyn Allocator))] (-> (ptr i8))
               (sdk-session-arm64 a)))
       ~(if linux-x64
            `(defn ~native-lookup-name [(raw (ptr i8)) (name (slice u8))]
               (-> (ptr i8))
               (primitive/cast (ptr i8) 0))
            `(defn ~native-lookup-name [(raw (ptr i8)) (name (slice u8))]
               (-> (ptr i8))
               (sdk/repl-arm64-symbol-address raw name))))))

(meta (sdk-host-impl))

;;; Create a session using `toolchain` to locate the runtime compiler's matching
;;; standard library. Pass an absolute coil executable or a PATH-resolvable name.
;;; The host's default options: the `coil` on PATH, the `Native` backend on macOS
;;; arm64 and `Llvm` elsewhere, and optimization level 0.
(defn jit-default-options [] (-> JitOptions)
  (JitOptions
    :toolchain "coil"
    :backend (sdk-default-backend)
    :opt-level 0))

;;; Create a session with explicit options. Fails without creating anything when
;;; this host has no such backend, or `opt-level` is outside 0-3 (or nonzero for
;;; `Native` or `Tpde`, which have no optimization levels).
(defn jit-session-new-with-options [(a (dyn Allocator)) (options JitOptions)]
  (-> (Result JitSession JitOptionsError))
  (let [level (.opt-level options)
        backend (.backend options)
        ; tpde publishes through the native runner and loader
        native? (match backend (Native [] true) (Llvm [] false) (Tpde [] true))]
    (cond (not (jit-supported?)) (Err (UnsupportedBackend backend))
          (and native? (not (sdk-native-available?)))
            (Err (UnsupportedBackend backend))
          (or (< level 0) (> level 3)) (Err (InvalidOptLevel level))
          (and native? (!= level 0)) (Err (InvalidOptLevel level))
          :else
            (do
              (sdk-init! (.toolchain options))
              (Ok (JitSession
                    :raw
                      (match backend
                        (Native [] (sdk-native-session a))
                        (Tpde [] (sdk-session-tpde a))
                        (Llvm [] (sdk-session-llvm a level)))
                    :backend backend))))))

;;; The backend this session publishes runtime code with.
(defn jit-session-backend [(session (ptr JitSession))] (-> JitBackend)
  (.backend session))

;;; Create a session with the host's default backend, using `toolchain` to locate
;;; the runtime compiler's matching standard library.
(defn jit-session-new-with-toolchain [(a (dyn Allocator))
                                      (toolchain (slice u8))] (-> JitSession)
  (sdk-init! toolchain)
  (let [backend (sdk-default-backend)]
    (JitSession
      :raw
        (match backend
          (Native [] (sdk-native-session a))
          (Tpde [] (sdk-session-tpde a))
          (Llvm [] (sdk-session-llvm a 0)))
      :backend backend)))

;;; Create a session using the `coil` executable found on PATH.
(defn jit-session-new [(a (dyn Allocator))] (-> JitSession)
  (jit-session-new-with-toolchain a "coil"))

;;; Capture Coil.toml in the current working directory before the first
;;; submission. Uses ordinary dependency/source-root discovery without changing
;;; the process environment. The host supplies native libraries at link time.
;;; Returns 0 on success, -1 after a session started, -2 when no manifest exists.
(defn jit-session-load-project! [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-load-project! (.raw session)))

;;; Give the session the program it runs in, before its first submission: TEXT is
;;; a description coil.meta's `describe` made when the program was built. Session
;;; code then calls the program's own functions and reads its own storage. 0 on
;;; success; -1 after the session started; -2 when TEXT has no toolchain header or
;;; another toolchain or target made it; -3 when the running program does not
;;; export a symbol TEXT declares; -4 when TEXT does not read or compile.
;;; `jit-diagnostic` says which.
(defn jit-session-set-environment! [(session (ptr JitSession))
                                    (text (slice u8))] (-> i64)
  (sdk/repl-session-set-environment! (.raw session) text))

;;; Compile a hygienic Code source provider once and retain it for this session.
;;; The provider receives the ordinary read-context Code value and returns the
;;; forms that enter the normal loader/checker/JIT pipeline. It can only be set
;;; before the first submission; -1 means the session already started.
(defn jit-session-set-source-provider! [(session (ptr JitSession))
                                        (module (slice u8))
                                        (function (slice u8))
                                        (owned-modules (slice u8))
                                        (abi-preamble (slice u8))] (-> i64)
  (sdk/repl-session-set-source-provider! (load (field session raw))
                                         module
                                         function
                                         owned-modules
                                         abi-preamble))

;;; Stop the session from also writing diagnostics to stderr. Every located
;;; diagnostic of a rejected submission is in `jit-diagnostic` either way; a client
;;; that reports them itself, or only inspects them, turns the echo off.
(defn jit-session-set-quiet! [(session (ptr JitSession)) (quiet bool)] (-> i64)
  (sdk/repl-session-set-quiet! (.raw session) quiet))

;;; Name submitted source NAME in diagnostics, so they read `--> NAME:LINE:COL`
;;; instead of `--> <jit>:LINE:COL`. Nothing is read from NAME. Source whose text
;;; is placed at its true lines and columns (preceded by blank lines and spaces)
;;; then reports locations in the file it came from.
(defn jit-session-set-source-name! [(session (ptr JitSession))
                                    (name (slice u8))] (-> i64)
  (sdk/repl-session-set-source-name! (.raw session) name))

;;; Compile a program or further definition forms against retained compiler
;;; state. Bindings are static; metaprograms define any dynamic update policy.
(defn jit-compile! [(session (ptr JitSession)) (source (slice u8))] (-> i64)
  (sdk/repl-session-compile! (.raw session) source "0"))

;;; Evaluate an expression in the retained environment, discarding its value.
;;; The expression may have any type. Returns compilation/publication status.
(defn jit-evaluate! [(session (ptr JitSession)) (expression (slice u8))]
  (-> i64)
  (sdk/repl-session-evaluate! (.raw session) expression))

;;; Look up a published native symbol (use export-c for a stable C name/ABI).
;;; Null means absent. The address is borrowed until reset or reclamation; retain
;;; a generation token when transferring it outside the owner's lifetime.
(defn jit-symbol-address [(session (ptr JitSession)) (name (slice u8))]
  (-> (ptr i8))
  (match (.backend session)
    (Native [] (sdk-native-symbol-address (.raw session) name))
    (Tpde [] (sdk-native-symbol-address (.raw session) name))
    (Llvm [] (sdk-symbol-address-llvm (.raw session) name))))

;;; Compile definitions and evaluate an i64 transaction entry. Zero accepts the
;;; candidate. Runtime effects belong to the caller/metaprogram's transaction.
(defn jit-compile-with-entry! [(session (ptr JitSession))
                               (source (slice u8))
                               (entry (slice u8))] (-> i64)
  (sdk/repl-session-compile! (.raw session) source entry))

;;; Load and publish the previously prepared native generation.
(defn jit-commit-prepared! [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-commit-prepared! (load (field session raw))))

;;; Accept native code while retaining its complete compiler arena. A successful
;;; result is final: abort cannot undo it. Generation leases and symbol lookup
;;; are available immediately. The caller must serialize compiler operations.
;;; Call finalize after publishing the application's view; the next preparation
;;; or reset also finalizes automatically. This does not defer typechecking,
;;; native loading, transaction execution, or generation ownership reservation.
(defn jit-publish-prepared! [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-publish-prepared! (.raw session)))

;;; Complete compiler metadata compaction for an accepted publication. No
;;; application code runs here; native callers may continue using leased code.
(defn jit-finalize-published! [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-finalize-published! (.raw session)))

(defn jit-finalization-pending? [(session (ptr JitSession))] (-> bool)
  (sdk/repl-session-finalization-pending? (.raw session)))

(defn jit-abort-prepared! [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-abort-prepared! (load (field session raw))))

(defn jit-prepared? [(session (ptr JitSession))] (-> bool)
  (sdk/repl-session-prepared? (load (field session raw))))

;;; The most recent rejected definition, owned by the session. Empty when idle
;;; or after a successful repair.
(defn jit-pending [(session (ptr JitSession))] (-> (slice u8))
  (sdk/repl-session-pending (load (field session raw))))

;;; Diagnostic text for the pending candidate. Empty after a successful
;;; definition or reset. This is data; clients do not scrape stderr.
(defn jit-diagnostic [(session (ptr JitSession))] (-> (slice u8))
  (sdk/repl-session-diagnostic (load (field session raw))))

;;; Structured metaprogram-selected rejection kind for the pending candidate.
;;; Zero means the compiler produced an ordinary syntax/type/backend rejection.
(defn jit-condition-kind [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-condition-kind (load (field session raw))))

;;; Exact function-owned checker failures for the pending candidate.
(defn jit-repair-count [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-repair-count (load (field session raw))))

(defn jit-repair-function [(session (ptr JitSession)) (index i64)]
  (-> (slice u8))
  (sdk/repl-session-repair-function (load (field session raw)) index))

;;; Read a literal i64 annotation from the exact function owning this failure.
; False leaves `value` untouched. Strings and annotation values remain owned by
; the session through candidate teardown, until the next transaction or reset.
(defn jit-repair-annotation-i64! [(session (ptr JitSession))
                                  (index i64)
                                  (key (slice u8))
                                  (value (ptr i64))] (-> bool)
  (sdk/repl-session-repair-annotation-i64! (.raw session) index key value))

(defn jit-repair-diagnostic [(session (ptr JitSession)) (index i64)]
  (-> (slice u8))
  (sdk/repl-session-repair-diagnostic (load (field session raw)) index))

;;; 0 = accepted/idle, 1 = rejected definition pending repair.
(defn jit-status [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-status (load (field session raw))))

;;; Monotonic accepted-definition generation. Failed candidates do not advance it.
(defn jit-epoch [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-epoch (load (field session raw))))

; A lease represents a native function/code pointer that may outlive the current
; call. Retired code cannot be reclaimed or reset until every lease is released.
(defn jit-generation-retain! [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-generation-retain! (load (field session raw))))

(defn jit-generation-release! [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-generation-release! (load (field session raw))))

(defn jit-generation-leases [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-generation-leases (load (field session raw))))

(defn jit-generation-count [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-generation-count (load (field session raw))))

; Exact generation leases return an opaque token identifying the image that is
; current at retention time. Releasing that token never affects a newer image.
;;; Reserve space for additional exact generation leases without acquiring one.
;;; Call before publication. Returns 0, -1 for an invalid count, -2 on allocation failure.
(defn jit-generation-reserve-tokens! [(session (ptr JitSession))
                                      (additional i64)] (-> i64)
  (sdk/repl-session-generation-reserve-tokens! (.raw session) additional))

;;; Acquire one current-generation token without allocation. Returns -1 without
;;; acquiring ownership when no reserved capacity or current generation exists.
(defn jit-generation-retain-reserved! [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-generation-retain-reserved! (.raw session)))

(defn jit-generation-retain-current! [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-generation-retain-current! (load (field session raw))))

(defn jit-generation-release-token! [(session (ptr JitSession))
                                     (token i64)] (-> i64)
  (sdk/repl-session-generation-release-token! (load (field session raw)) token))

(defn jit-generation-token-leases [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-generation-token-leases (load (field session raw))))

; The caller must establish quiescence before this operation. Pinned generations
; that own persistent static cells remain until reset; unpinned retired code is
; unmapped/disposed immediately.
(defn jit-reclaim-retired! [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-reclaim-retired! (load (field session raw))))

;;; Clear definitions and begin a fresh persistent-static lineage.
(defn jit-reset! [(session (ptr JitSession))] (-> i64)
  (sdk/repl-session-reset! (load (field session raw))))

;;; Release the session and everything it owns, including its native code; the
;;; handle is null afterwards. Returns -1 and changes nothing while a generation
;;; lease, client token or environment handle is outstanding. Pointers returned
;;; by `jit-symbol-address` are invalid once this succeeds.
(defn jit-session-free! [(session (ptr JitSession))] (-> i64)
  (let [raw (.raw session)]
    (if (= (primitive/cast i64 raw) 0)
        0
        (let [status (sdk/repl-session-free! raw)]
          (when (= status 0) (set! (.raw session) (primitive/cast (ptr i8) 0)))
          status))))

; Generate truthful target queries without exposing compiler target state at runtime.
(defn sdk-target-api [] (-> Code)
  (let [darwin-arm
          (match (target-os)
            (Darwin [] (match (target-arch) (Aarch64 [] true) (_ false)))
            (_ false))
        linux-x64 (match (target-os) (Linux [] true) (_ false))
        supported (or darwin-arm linux-x64)
        ; hygiene: the generated public JIT API intentionally enters this module's namespace.
        supported-name (primitive/syntax->datum `jit-supported?)
        backend-name (primitive/syntax->datum `jit-backend)]
    `(do
       (defn ~supported-name [] (-> bool)
         ~supported)
       (defn ~backend-name [] (-> (slice u8))
         ~(if darwin-arm
              "arm64-macho"
              (if linux-x64 "llvm-orc" "unsupported"))))))

(meta (sdk-target-api))

;;; The stock terminal UI is deliberately a client of this public module. Compiler
;;; entrypoints pass this callback into their otherwise JIT-agnostic CLI driver.
(defn jit-repl-main [(a (dyn Allocator)) (argv (ptr (ptr i8)))] (-> i64)
  (let [toolchain (str/from-cstr (load argv))
        nm (repl-argv-backend argv)
        backend
          (cond (= nm "tpde") (Some (Tpde))
                (= nm "llvm") (Some (Llvm))
                (or (= nm "native") (= nm "arm64")) (Some (Native))
                :else (None [JitBackend]))]
    (cond (= (len nm) 0)
            (let [(mut session) (jit-session-new-with-toolchain a toolchain)]
              (sdk/repl-terminal-main a (.raw session)))
          :else
            (match backend
              (None []
                    (do
                      (eprintln "error: unknown repl backend `{}` (native, tpde or llvm)"
                                nm)
                      1))
              (Some [b]
                    (match (jit-session-new-with-options a
                                                         (JitOptions
                                                           :toolchain toolchain
                                                           :backend b
                                                           :opt-level 0))
                      (Ok [session] (sdk/repl-terminal-main a (.raw session)))
                      (Err [e]
                           (do
                             (eprintln "error: {}"
                                       (jit-options-error-message e))
                             1))))))))

;;; `coil repl --backend native|tpde|llvm`: the backend named, or "".
(defn repl-argv-backend [(argv (ptr (ptr i8)))] (-> (slice u8))
  (let [(mut i) 1
        (mut r) ""]
    (while (!= (primitive/cast i64 (load (primitive/index argv i))) 0)
      (when (and (= (str/from-cstr (load (primitive/index argv i))) "--backend")
                 (!= (primitive/cast i64 (load (primitive/index argv (+ i 1))))
                     0))
        (set! r (str/from-cstr (load (primitive/index argv (+ i 1))))))
      (set! i (+ i 1)))
    r))

;;; One source read by the compiler loader. Bytes belong to the graph allocator.
;;; Synthesized sources have an empty module; paths retain the loader's spelling.
(defstruct JitSourceFile
  [(module (slice u8)) (path (slice u8)) (text (slice u8))])

;;; Read-only graph discovery; no expansion, typechecking, or native execution.
;;; Failed loads still return all sources read before the diagnostic.
(defstruct SdkSourceGraph
  [(ok bool)
   (entry-module (slice u8))
   (diagnostic (slice u8))
   (error-path (slice u8))
   (error-line i64)
   (files (ArrayList JitSourceFile))])

;;; Discover ENTRY with the ordinary namespace loader and current compiler
;;; environment. Initialize the SDK with jit-session-new first, and serialize
;;; this call with other SDK operations. The result uses A; all compiler AST and
;;; temporary resources are discarded before return. No session is modified.
(defn jit-read-source-graph [(a (dyn Allocator)) (entry (slice u8))]
  (-> JitSourceGraph)
  (let [(mut config) (sdk/compilation-unit-config a)
        (mut scope) (zeroed sdk/CompilationUnitSession)
        temp
          (sdk/compilation-unit-enter! (mut scope)
                                       (mut config)
                                       (primitive/cast (ptr (ArrayList loader/VirtualSource))
                                                       0)
                                       true)
        ls (primitive/alloc-stack loader/LS)
        (mut result)
          (load (SdkSourceGraph
                  :ok true
                  :entry-module ""
                  :diagnostic ""
                  :error-path ""
                  :error-line 0
                  :files (ArrayList::new [JitSourceFile] a)))]
    (loader/ls-init! (mut ls) temp)
    (try (let [text
                 (try-or! (fs/read-file temp entry)
                          (do
                            (set! (.ok result) false)
                            (set! (.diagnostic result)
                                  "cannot read source file")
                            (set! (.error-path result)
                                  (sdk-graph-text a entry ""))))]
           (do
             (loader/register-source! (mut ls) entry text)
             (set! (.srccount ls) 1)
             (match (reader/read-all temp text 0)
               (Err [d]
                    (let [diagnostic d]
                      (loader/ls-set-err! (mut ls) diagnostic)))
               (Ok [forms]
                   (do
                     (loader/namespace-index-build! (mut ls))
                     (unless (loader/ls-err? (mut ls))
                       (loader/load-program (mut ls)
                                            forms
                                            (loader/dirname entry))
                       0)
                     (set! (.entry-module result)
                           (sdk-graph-text a (.entry_module ls) "")))))
             0)))
    (when (loader/ls-err? (mut ls))
      (let [d (field ls loaderr)
            sid (.source d)]
        (set! (.ok result) false)
        (set! (.diagnostic result) (sdk-graph-text a (.msg d) ""))
        (when (and (>= sid 0) (< sid (len (.sources ls))))
          (let [source (get (.sources ls) sid)
                starts (.line_starts source)
                (mut line) 1]
            (set! (.error-path result) (sdk-graph-text a (.name source) ""))
            (for [i 0 (len (load starts))]
              (when (<= (get (load starts) i) (.lo d)) (set! line (+ i 1)) 0))
            (set! (.error-line result) (load line)))
          0))
      0)
    (for [i 0 (len (.sources ls))]
      (let [source (get (.sources ls) i)
            (mut module) (if (= (.name source) entry) (.entry-module result) "")]
        (for [j 0 (len (.readpaths ls))]
          (when (= (get (.readpaths ls) j) (.name source))
            (set! module (get (.readmods ls) j))
            0))
        (push! (mut (.files result))
               (JitSourceFile
                 :module (sdk-graph-text a (load module) "")
                 :path (sdk-graph-text a (.name source) "")
                 :text (sdk-graph-text a (.text source) "")))))
    (sdk/compilation-unit-leave! (mut scope))
    (JitSourceGraph
      :raw
        (primitive/cast (ptr i8)
                        (alloc/box! a
                                    SdkSourceGraph
                                    (load result))))))

(defn sdk-graph-text [(a (dyn Allocator)) (x (slice u8)) (y (slice u8))]
  (-> (slice u8))
  (let [(mut sb) (str/StrBuf::new a)]
    (push-str! (mut sb) x)
    (push-str! (mut sb) y)
    (finish! (mut sb))))

;;; Opaque graph owner; all memory belongs to the allocator passed at creation.
(defstruct JitSourceGraph [(raw (ptr i8))])

(defn sdk-graph [(g (ptr JitSourceGraph))] (-> (ptr SdkSourceGraph))
  (primitive/cast (ptr SdkSourceGraph) (.raw g)))

(defn jit-source-graph-ok? [(g (ptr JitSourceGraph))] (-> bool)
  (.ok (sdk-graph g)))

(defn jit-source-graph-entry [(g (ptr JitSourceGraph))] (-> (slice u8))
  (.entry-module (sdk-graph g)))

(defn jit-source-graph-diagnostic [(g (ptr JitSourceGraph))] (-> (slice u8))
  (.diagnostic (sdk-graph g)))

(defn jit-source-graph-error-path [(g (ptr JitSourceGraph))] (-> (slice u8))
  (.error-path (sdk-graph g)))

(defn jit-source-graph-error-line [(g (ptr JitSourceGraph))] (-> i64)
  (.error-line (sdk-graph g)))

(defn jit-source-graph-count [(g (ptr JitSourceGraph))] (-> i64)
  (len (.files (sdk-graph g))))

(defn jit-source-graph-module [(g (ptr JitSourceGraph)) (i i64)] (-> (slice u8))
  (if (or (< i 0) (>= i (jit-source-graph-count g)))
      ""
      (let [f (get (.files (sdk-graph g)) i)] (.module f))))

(defn jit-source-graph-path [(g (ptr JitSourceGraph)) (i i64)] (-> (slice u8))
  (if (or (< i 0) (>= i (jit-source-graph-count g)))
      ""
      (let [f (get (.files (sdk-graph g)) i)] (.path f))))

(defn jit-source-graph-text [(g (ptr JitSourceGraph)) (i i64)] (-> (slice u8))
  (if (or (< i 0) (>= i (jit-source-graph-count g)))
      ""
      (let [f (get (.files (sdk-graph g)) i)] (.text f))))

;;; Prepare new forms without publishing runtime code. Metaprogram expansion runs.
(defn jit-prepare! [(session (ptr JitSession)) (source (slice u8))] (-> i64)
  (sdk/repl-session-prepare! (.raw session) source "0"))

;;; Prepare new forms and their private i64 transaction entry. Zero accepts on commit.
(defn jit-prepare-with-entry! [(session (ptr JitSession))
                               (source (slice u8))
                               (entry (slice u8))] (-> i64)
  (sdk/repl-session-prepare! (.raw session) source entry))

;;; A verified layout-independent artifact allocated in the caller's region.
;;; Available only while a candidate is prepared. A present artifact can carry
;;; an unsupported-operation diagnostic; consumers must check live-ir/verify.
(defn jit-live-function [(allocator (dyn alloc/Allocator))
                         (session (ptr JitSession))
                         (name (slice u8))] (-> (Option live-ir/Function))
  (sdk/repl-session-live-function allocator (.raw session) name))

;;; Frontend-only sessions never monomorphize application bodies or invoke the
;;; native publication runner. Consumers execute explicitly verified artifacts.
(defn jit-checked-session-new [(allocator (dyn alloc/Allocator))]
  (-> JitSession)
  (jit-checked-session-new-with-toolchain allocator "coil"))

(defn jit-checked-session-new-with-toolchain [(allocator (dyn alloc/Allocator))
                                              (toolchain (slice u8))]
  (-> JitSession)
  (let [(mut session) (jit-session-new-with-toolchain allocator toolchain)]
    (assert (sdk/repl-session-checked-only! (.raw session)))
    (load session)))

(defn jit-live-schema [(allocator (dyn alloc/Allocator))
                       (session (ptr JitSession))
                       (name (slice u8))] (-> (Option live-ir/Schema))
  (sdk/repl-session-live-schema allocator (.raw session) name))

;;; ---- compiler states as values ---------------------------------------------------
;;; A `JitEnv` is everything the compiler knows after checking some source, held as
;;; a value. `jit-env-check` builds a new one from any you hold and never writes the
;;; one it was given, so several can be alive at once: the state before an edit and
;;; after it, or two different edits of one base. Nothing here is "current",
;;; "accepted" or "rejected" -- those are decisions for whoever holds the values.
;;;
;;;   (let [(mut session) (jit-checked-session-new a)
;;;         base (jit-env-check (mut session) (jit-env-empty) "(defn area [(w i64) (h i64)] (-> i64) (* w h))")
;;;         edit (jit-env-check (mut session) base "(defn area [(w i64)] (-> i64) (* w w))")]
;;;     ; base still says area takes two arguments; edit says one. Keep either, or both.
;;;     (jit-env-release! (mut session) edit)
;;;     (jit-env-release! (mut session) base))
;;;
;;; Every value from `jit-env-current`, `jit-env-check` (when valid) and
;;; `jit-env-retain` is one hold, released exactly once with `jit-env-release!`, in
;;; any order. `jit-reset!` refuses while any is held. A session that runs code
;;; checks value states too: `jit-env-current` is the running program's state,
;;; and a check of it never becomes native code or is published. A check never
;;; replaces a definition; writing one again is refused.
(defstruct JitEnv [(raw (ptr i8))])

;;; The state with nothing in it: what the first check builds on.
(defn jit-env-empty [] (-> JitEnv)
  (JitEnv :raw (primitive/cast (ptr i8) 0)))

;;; False for the empty state, and for the result of a check that failed; the
;;; session's diagnostic then says why.
(defn jit-env-valid? [(env JitEnv)] (-> bool)
  (!= (primitive/cast i64 (.raw env)) 0))

;;; A hold on the state the session itself currently serves.
(defn jit-env-current [(session (ptr JitSession))] (-> JitEnv)
  (JitEnv :raw (sdk/repl-session-env-current (.raw session))))

;;; Check `source` against `base`. Returns the resulting state, or an invalid one
;;; (see `jit-diagnostic`) if it does not check. `base` is unchanged either way,
;;; and nothing is published: the session's running code is untouched.
(defn jit-env-check [(session (ptr JitSession))
                     (base JitEnv)
                     (source (slice u8))] (-> JitEnv)
  (JitEnv :raw (sdk/repl-session-env-check! (.raw session) (.raw base) source)))

;;; Another hold on the same state.
(defn jit-env-retain [(session (ptr JitSession)) (env JitEnv)] (-> JitEnv)
  (JitEnv :raw (sdk/repl-session-env-retain! (.raw session) (.raw env))))

(defn jit-env-release! [(session (ptr JitSession)) (env JitEnv)] (-> i64)
  (sdk/repl-session-env-release! (.raw session) (.raw env)))

(defn jit-env-defines? [(session (ptr JitSession))
                        (env JitEnv)
                        (name (slice u8))] (-> bool)
  (sdk/repl-session-env-defines? (.raw session) (.raw env) name))

;;; One of `env`'s checked functions, lowered before native physical layout.
(defn jit-env-live-function [(allocator (dyn alloc/Allocator))
                             (session (ptr JitSession))
                             (env JitEnv)
                             (name (slice u8))] (-> (Option live-ir/Function))
  (sdk/repl-session-env-live-function allocator (.raw session) (.raw env) name))

;;; How many accepted functions the check that produced `env` left STALE: they read
;;; a function whose signature, or a type whose shape, that check changed, and were
;;; not part of it. They are still in `env`, as they were checked; the compiler
;;; reports them and does nothing else. A body-only edit stales nothing. Macros,
;;; constants that mention constants and impl availability are not tracked yet.
(defn jit-env-stale-count [(session (ptr JitSession)) (env JitEnv)] (-> i64)
  (sdk/repl-session-env-stale-count (.raw session) (.raw env)))

(defn jit-env-stale-name [(session (ptr JitSession)) (env JitEnv) (index i64)]
  (-> (slice u8))
  (sdk/repl-session-env-stale-name (.raw session) (.raw env) index))

;;; The source of the form defining function `name` in `env`, to check again after
;;; something it reads changed; "" if it has no authored form of its own.
(defn jit-env-definition-source [(session (ptr JitSession))
                                 (env JitEnv)
                                 (name (slice u8))] (-> (slice u8))
  (sdk/repl-session-env-definition-source (.raw session) (.raw env) name))
