; Source migrations for typed compile-time generic parameters
; (docs/design/COMPILE_TIME_PARAMETERS.md):
;
;   * A keyword in type position is a Keyword constant, so the keyword spelling of a
;     primitive type is gone: `(-> :i64)` becomes `(-> i64)`.
;   * A generic parameter's kind comes from its declaration, so a parameter used as a
;     width is declared as a value: `[T N]` with `(vec T N)` becomes
;     `[T (const N i64)]`.
;
; Neither old program loads any more, so this works on read syntax, before loading,
; as part of the lint syntax preflight (`prelint-run` in driver.coil) and the build's
; breaking-change scan. It edits only positions the core grammar makes types: return
; types, parameter and field types, the type operands of `cast`/`sizeof`/`alignof`/
; `zeroed`/`offsetof`/allocation and reflection forms, ascriptions, typed
; `const`/`def`, extern parameter vectors, `:backing`, impl target types, explicit
; type-argument vectors, and everything nested inside a type. A keyword in an
; expression is a Keyword value and is never touched. A width is recognized where
; it sizes a vector, mask or array, or where it is passed to a declared value
; parameter of a struct, sum or function in this file or a module it imports.
(module coil.compiler.generic_migration)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use [slice-get slice-len subslice])
(import "coil.str" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.parser" :use [sx-tag sx-sval sx-items sx-lo sx-hi box-al sconcat3])

;;; One text edit: replace source bytes [lo, hi) with `text`. `what` is 0 for a
;;; primitive keyword spelling and 1 for a width parameter declaration.
(defstruct GmEdit [(lo i64) (hi i64) (text (slice u8)) (what i64)])

(defstruct GmImport
  [(module (slice u8))
   (alias (slice u8))
   (use_all bool)
   (uses (ptr (ArrayList (slice u8))))])

;;; One read source file: its module name, forms and imports.
(defstruct GmFile
  [(module (slice u8))
   (forms (ptr (ArrayList Sexp)))
   (imports (ptr (ArrayList GmImport)))])

;;; A generic declaration and, per parameter, whether it is a value parameter.
(defstruct GmDecl
  [(module (slice u8))
   (name (slice u8))
   (kinds (ptr (ArrayList bool)))])

(defstruct GmCx
  [(a (dyn Allocator))
   (file (ptr GmFile))
   (decls (ptr (ArrayList GmDecl)))
   ; collect mode gathers width uses into `uses`; edit mode appends to `edits`
   (collect bool)
   (uses (ptr (ArrayList (slice u8))))
   (edits (ptr (ArrayList GmEdit)))])

; ---- syntax access ----------------------------------------------------------------

(defn gm-tag [(p (ptr Sexp))] (-> i64) (sx-tag (load p)))

(defn gm-list? [(p (ptr Sexp))] (-> bool) (= (gm-tag p) 6))

(defn gm-vec? [(p (ptr Sexp))] (-> bool) (= (gm-tag p) 7))

(defn gm-sym? [(p (ptr Sexp))] (-> bool) (= (gm-tag p) 2))

(defn gm-kw? [(p (ptr Sexp))] (-> bool) (= (gm-tag p) 3))

(defn gm-int? [(p (ptr Sexp))] (-> bool) (= (gm-tag p) 0))

(defn gm-text [(p (ptr Sexp))] (-> (slice u8)) (sx-sval (load p)))

(defn gm-count [(p (ptr Sexp))] (-> i64)
  (if (or (gm-list? p) (gm-vec? p)) (len (load (sx-items (load p)))) 0))

(defn gm-at [(p (ptr Sexp)) (i i64)] (-> (ptr Sexp))
  (al-elem [Sexp] (sx-items (load p)) i))

;;; The head symbol's text of a list, or "".
(defn gm-head [(p (ptr Sexp))] (-> (slice u8))
  (if (and (gm-list? p) (> (gm-count p) 0) (gm-sym? (gm-at p 0)))
      (gm-text (gm-at p 0))
      ""))

(defn gm-arrow? [(p (ptr Sexp))] (-> bool) (= (gm-head p) "->"))

(defn gm-digits? [(s (slice u8)) (from i64)] (-> bool)
  (let [(mut ok) (> (len s) from)]
    (for [i from (len s)]
      (let [c (primitive/cast i64 (get s i))]
        (when (or (< c 48) (> c 57)) (store! ok false) 0)
        0))
    (load ok)))

;;; The names `prim-type` in parser.coil accepts.
(defn gm-prim-name? [(s (slice u8))] (-> bool)
  (or (= s "f32") (= s "f64") (= s "bool") (= s "void") (= s "externref")
      (= s "usize") (= s "isize")
      (and (> (len s) 1)
           (or (= (primitive/cast i64 (get s 0)) 105)
               (= (primitive/cast i64 (get s 0)) 117))
           (gm-digits? s 1))))

(defn gm-prim-keyword? [(p (ptr Sexp))] (-> bool)
  (and (gm-kw? p) (gm-prim-name? (gm-text p))))

; ---- files and imports --------------------------------------------------------------

(defn gm-import [(a (dyn Allocator)) (f (ptr Sexp))] (-> GmImport)
  (let [out (primitive/alloc-stack GmImport)
        uses (box-al [(slice u8)] a (al-new [(slice u8)] a))
        n (gm-count f)]
    (set! (.module out) (if (= (gm-tag (gm-at f 1)) 4) (gm-text (gm-at f 1)) ""))
    (set! (.alias out) "")
    (set! (.use_all out) false)
    (set! (.uses out) uses)
    (for [i 2 (- n 1)]
      (let [k (gm-at f i)
            v (gm-at f (+ i 1))]
        (when (gm-kw? k)
          (cond (and (= (gm-text k) "as") (gm-sym? v)) (do (set! (.alias out) (gm-text v)) 0)
                (= (gm-text k) "use")
                  (cond (and (gm-sym? v) (= (gm-text v) "*")) (do (set! (.use_all out) true) 0)
                        (gm-vec? v)
                          (do (for [j 0 (gm-count v)]
                                (when (gm-sym? (gm-at v j)) (push! uses (gm-text (gm-at v j))) 0)
                                0)
                              0)
                        :else 0)
                :else 0)
          0)
        0))
    (load out)))

(defn gm-read-file [(a (dyn Allocator)) (forms (ptr (ArrayList Sexp)))] (-> GmFile)
  (let [out (primitive/alloc-stack GmFile)
        imports (box-al [GmImport] a (al-new [GmImport] a))]
    (set! (.module out) "")
    (set! (.forms out) forms)
    (set! (.imports out) imports)
    (for [i 0 (len (load forms))]
      (let [f (al-elem [Sexp] forms i)]
        (cond (and (= (gm-head f) "module") (= (gm-count f) 2) (gm-sym? (gm-at f 1)))
                (do (set! (.module out) (gm-text (gm-at f 1))) 0)
              (and (= (gm-head f) "import") (> (gm-count f) 1))
                (do (push! imports (gm-import a f)) 0)
              :else 0))
      0)
    (load out)))

;;; The namespaces a file imports, for the caller to read and pass back in.
(defn gm-imported-modules [(a (dyn Allocator)) (f (ptr GmFile))] (-> (ptr (ArrayList (slice u8))))
  (let [out (box-al [(slice u8)] a (al-new [(slice u8)] a))]
    (for [i 0 (len (load (.imports f)))]
      (let [m (.module (al-elem [GmImport] (.imports f) i))]
        (when (> (len m) 0) (push! out m) 0))
      0)
    out))

; ---- declarations ---------------------------------------------------------------------

(defn gm-find-slash [(s (slice u8))] (-> i64)
  (let [(mut at) -1]
    (for [i 0 (len s)]
      (when (and (< (load at) 0) (= (primitive/cast i64 (get s i)) 47)) (store! at i) 0)
      0)
    (load at)))

(defn gm-last-dot [(s (slice u8))] (-> i64)
  (let [(mut at) -1]
    (for [i 0 (len s)]
      (when (= (primitive/cast i64 (get s i)) 46) (store! at i) 0)
      0)
    (load at)))

(defn gm-uses-name? [(imp (ptr GmImport)) (name (slice u8))] (-> bool)
  (let [(mut found) (.use_all imp)]
    (for [i 0 (len (load (.uses imp)))]
      (when (= (get (load (.uses imp)) i) name) (store! found true) 0)
      0)
    (load found)))

(defn gm-decl-kinds [(decls (ptr (ArrayList GmDecl))) (module (slice u8)) (name (slice u8))] (-> (ptr (ArrayList bool)))
  (let [(mut out) (primitive/cast (ptr (ArrayList bool)) 0)]
    (for [i 0 (len (load decls))]
      (let [d (al-elem [GmDecl] decls i)]
        (when (and (= (.module d) module) (= (.name d) name)) (store! out (.kinds d)) 0))
      0)
    (load out)))

;;; The declared parameter kinds a spelling names from `cx.file`, or null.
(defn gm-lookup [(cx (ptr GmCx)) (spelling (slice u8))] (-> (ptr (ArrayList bool)))
  (let [f (.file cx)
        decls (.decls cx)
        slash (gm-find-slash spelling)
        (mut out) (primitive/cast (ptr (ArrayList bool)) 0)]
    (if (>= slash 0)
        (let [qual (subslice spelling 0 slash)
              name (subslice spelling (+ slash 1) (len spelling))]
          (store! out (gm-decl-kinds decls qual name))
          (for [i 0 (len (load (.imports f)))]
            (let [imp (al-elem [GmImport] (.imports f) i)]
              (when (and (= (primitive/cast i64 (load out)) 0) (= (.alias imp) qual))
                (store! out (gm-decl-kinds decls (.module imp) name))
                0))
            0))
        (let [dot (gm-last-dot spelling)]
          (if (> dot 0)
              (store! out (gm-decl-kinds decls
                                         (subslice spelling 0 dot)
                                         (subslice spelling (+ dot 1) (len spelling))))
              (do
                (store! out (gm-decl-kinds decls (.module f) spelling))
                (for [i 0 (len (load (.imports f)))]
                  (let [imp (al-elem [GmImport] (.imports f) i)]
                    (when (and (= (primitive/cast i64 (load out)) 0) (gm-uses-name? imp spelling))
                      (store! out (gm-decl-kinds decls (.module imp) spelling))
                      0))
                  0)
                0))))
    (load out)))

(defn gm-kind-value? [(kinds (ptr (ArrayList bool))) (i i64)] (-> bool)
  (and (!= (primitive/cast i64 kinds) 0)
       (< i (len (load kinds)))
       (get (load kinds) i)))

;;; The generic parameter vector of a declaration, or null. The positions are the
;;; parser's: a defn's and defstruct's is the vector directly followed by another
;;; vector; a defsum's is slot 2; an impl's is slot 1.
(defn gm-param-vector [(f (ptr Sexp))] (-> (ptr Sexp))
  (let [h (gm-head f)
        n (gm-count f)
        (mut out) (primitive/cast (ptr Sexp) 0)]
    (cond (and (= h "defsum") (> n 2) (gm-vec? (gm-at f 2))) (store! out (gm-at f 2))
          (and (= h "impl") (> n 1) (gm-vec? (gm-at f 1))) (store! out (gm-at f 1))
          (or (= h "defn") (= h "defn*") (= h "defstruct"))
            (for [i 2 (- n 1)]
              (when (and (= (primitive/cast i64 (load out)) 0)
                         (gm-vec? (gm-at f i))
                         (gm-vec? (gm-at f (+ i 1))))
                (store! out (gm-at f i))
                0)
              0)
          :else 0)
    (load out)))

(defn gm-const-entry? [(p (ptr Sexp))] (-> bool)
  (and (= (gm-head p) "const") (= (gm-count p) 3)))

; ---- width uses in a type ---------------------------------------------------------------

(defn gm-push-use! [(cx (ptr GmCx)) (p (ptr Sexp))] (-> i64)
  (when (gm-sym? p) (push! (.uses cx) (gm-text p)) 0)
  0)

(defn gm-type-uses! [(cx (ptr GmCx)) (t (ptr Sexp))] (-> i64)
  (let [h (gm-head t)
        n (gm-count t)]
    (cond (gm-vec? t) (for [i 0 n] (gm-type-uses! cx (gm-at t i)) 0)
          (not (gm-list? t)) 0
          (= h "const") 0
          (and (or (= h "vec") (= h "array")) (= n 3))
            (do (gm-type-uses! cx (gm-at t 1)) (gm-push-use! cx (gm-at t 2)))
          (and (= h "mask") (= n 2)) (gm-push-use! cx (gm-at t 1))
          (= h "") (for [i 0 n] (gm-type-uses! cx (gm-at t i)) 0)
          :else
            (let [kinds (gm-lookup cx h)]
              (for [i 1 n]
                (if (gm-kind-value? kinds (- i 1))
                    (gm-push-use! cx (gm-at t i))
                    (gm-type-uses! cx (gm-at t i)))
                0)
              0)))
  0)

; ---- type positions -------------------------------------------------------------------

(defn gm-type! [(cx (ptr GmCx)) (t (ptr Sexp))] (-> i64)
  (cond (.collect cx) (gm-type-uses! cx t)
        (gm-prim-keyword? t)
          (do (push! (.edits cx)
                     (GmEdit :lo (sx-lo (load t)) :hi (sx-hi (load t))
                             :text (gm-text t) :what 0))
              0)
        (= (gm-head t) "const") 0
        (or (gm-list? t) (gm-vec? t))
          (do (for [i 0 (gm-count t)] (gm-type! cx (gm-at t i)) 0) 0)
        :else 0))

;;; Field and parameter entries `(name TYPE option…)` and the bare types of an extern
;;; parameter vector.
(defn gm-entry-types! [(cx (ptr GmCx)) (v (ptr Sexp))] (-> i64)
  (for [i 0 (gm-count v)]
    (let [entry (gm-at v i)]
      (cond (gm-prim-keyword? entry) (gm-type! cx entry)
            (and (gm-list? entry) (> (gm-count entry) 1) (gm-sym? (gm-at entry 0))
                 (not (= (gm-head entry) "const")))
              (let [h (gm-head entry)]
                ; `(ptr i8)` in an extern vector is itself a type
                (if (or (= h "ptr") (= h "mut") (= h "ref") (= h "slice") (= h "array")
                        (= h "vec") (= h "mask") (= h "fnptr") (= h "dyn"))
                    (gm-type! cx entry)
                    (for [k 1 (gm-count entry)] (gm-type! cx (gm-at entry k)) 0)))
            (gm-list? entry) (gm-type! cx entry)
            :else 0))
    0)
  0)

(defn gm-type-operand-head? [(h (slice u8))] (-> bool)
  (let [slash (gm-find-slash h)
        name (if (>= slash 0) (subslice h (+ slash 1) (len h)) h)]
    (or (= name "cast") (= name "sizeof") (= name "alignof") (= name "zeroed")
        (= name "offsetof") (= name "alloc-stack") (= name "alloc-static")
        (= name "alloc-heap") (= name "llvm-ir")
        (= name "field-count") (= name "variant-count") (= name "struct?")
        (= name "sum?") (= name "int?") (= name "float?") (= name "ptr?")
        (= name "array?") (= name "field-name") (= name "field-type-kind")
        (= name "field-type-name") (= name "field-index"))))

(defn gm-declaration-head? [(h (slice u8))] (-> bool)
  (or (= h "defn") (= h "defn*") (= h "defstruct") (= h "defsum") (= h "deftrait")
      (= h "impl") (= h "extern") (= h "declare") (= h "defmacro") (= h "import")
      (= h "export") (= h "module")))

(defn gm-binding-head? [(h (slice u8))] (-> bool)
  (or (= h "let") (= h "let*") (= h "loop") (= h "for") (= h "fn") (= h "fn*")
      (= h "when-let") (= h "if-let") (= h "binding") (= h "with")))

;;; The old parser's explicit type-argument test, with primitive keywords counted as
;;; type forms: every item an integer or a type form, and at least one type form.
(defn gm-type-args-vector? [(v (ptr Sexp))] (-> bool)
  (and (gm-vec? v)
       (> (gm-count v) 0)
       (let [(mut ok) true
             (mut has-type) false]
         (for [i 0 (gm-count v)]
           (let [item (gm-at v i)]
             (cond (gm-int? item) 0
                   (or (gm-sym? item) (gm-prim-keyword? item)
                       (and (gm-list? item) (> (gm-count item) 0) (gm-sym? (gm-at item 0))))
                     (do (store! has-type true) 0)
                   :else (do (store! ok false) 0)))
           0)
         (and (load ok) (load has-type)))))

(defn gm-method-form? [(p (ptr Sexp))] (-> bool)
  (and (gm-list? p) (>= (gm-count p) 3) (gm-vec? (gm-at p 1)) (gm-arrow? (gm-at p 2))))

(defn gm-walk-from! [(cx (ptr GmCx)) (f (ptr Sexp)) (from i64)] (-> i64)
  (for [i from (gm-count f)] (gm-walk! cx (gm-at f i)) 0)
  0)

(defn gm-walk! [(cx (ptr GmCx)) (f (ptr Sexp))] (-> i64)
  (let [h (gm-head f)
        n (gm-count f)]
    (cond (gm-vec? f) (gm-walk-from! cx f 0)
          (not (gm-list? f)) 0
          (gm-arrow? f) (do (for [i 1 n] (gm-type! cx (gm-at f i)) 0) 0)
          (= h "defstruct")
            (do
              (for [i 2 n]
                (let [child (gm-at f i)]
                  (cond (and (= i (- n 1)) (gm-vec? child)) (gm-entry-types! cx child)
                        (and (gm-kw? child) (= (gm-text child) "backing") (< (+ i 1) n))
                          (gm-type! cx (gm-at f (+ i 1)))
                        :else 0))
                0)
              0)
          (= h "defsum")
            (do
              (for [i 2 n]
                (let [variant (gm-at f i)]
                  (when (gm-list? variant)
                    (for [k 0 (gm-count variant)]
                      (when (gm-vec? (gm-at variant k)) (gm-entry-types! cx (gm-at variant k)) 0)
                      0)
                    0))
                0)
              0)
          (= h "impl")
            (let [base (if (and (> n 1) (gm-vec? (gm-at f 1))) 2 1)]
              (when (< base n)
                (let [inherent (or (>= (+ base 1) n) (gm-method-form? (gm-at f (+ base 1))))
                      type-at (if inherent base (+ base 1))]
                  (when (< type-at n) (gm-type! cx (gm-at f type-at)) 0)
                  (gm-walk-from! cx f (+ type-at 1))))
              0)
          ; `(: value TYPE)`: the reader makes a bare `:` an empty keyword
          (and (= n 3) (gm-kw? (gm-at f 0)) (= (len (gm-text (gm-at f 0))) 0))
            (do (gm-walk! cx (gm-at f 1)) (gm-type! cx (gm-at f 2)))
          (and (> n 1) (gm-type-operand-head? h))
            (do (gm-type! cx (gm-at f 1)) (gm-walk-from! cx f 2))
          ; (def NAME :params [p …] [TYPE] VALUE): the names are not types.
          (and (= h "def") (and (>= n 5) (gm-kw? (gm-at f 2))))
            (do (when (= n 6) (gm-type! cx (gm-at f 4)) 0)
                (gm-walk! cx (gm-at f (- n 1))))
          (and (or (= h "const") (= h "def")) (= n 4))
            (do (gm-type! cx (gm-at f 2)) (gm-walk! cx (gm-at f 3)))
          (and (= h "defannotation") (= n 3)) (gm-type! cx (gm-at f 2))
          :else
            (do
              (for [i 1 n]
                (let [child (gm-at f i)]
                  (cond
                    ; parameter vectors, extern parameter vectors and method
                    ; signatures: the vector right before `(-> R)`
                    (and (gm-vec? child) (< (+ i 1) n) (gm-arrow? (gm-at f (+ i 1))))
                      (gm-entry-types! cx child)
                    ; explicit type arguments `(f [T 16] …)`
                    (and (= i 1) (> (len h) 0)
                         (not (gm-binding-head? h))
                         (not (gm-declaration-head? h))
                         (gm-type-args-vector? child))
                      (if (.collect cx)
                          (let [kinds (gm-lookup cx h)]
                            (for [k 0 (gm-count child)]
                              (if (gm-kind-value? kinds k)
                                  (gm-push-use! cx (gm-at child k))
                                  (gm-type! cx (gm-at child k)))
                              0)
                            0)
                          (gm-type! cx child))
                    :else (gm-walk! cx child)))
                0)
              0)))
  0)

; ---- kinds ----------------------------------------------------------------------------

(defn gm-kinds [(cx (ptr GmCx)) (f (ptr Sexp)) (params (ptr Sexp))] (-> (ptr (ArrayList bool)))
  (let [a (.a cx)
        uses (box-al [(slice u8)] a (al-new [(slice u8)] a))
        collect (primitive/alloc-stack GmCx)
        out (box-al [bool] a (al-new [bool] a))]
    (store! collect (load cx))
    (set! (.collect collect) true)
    (set! (.uses collect) uses)
    (gm-walk! collect f)
    (for [i 0 (gm-count params)]
      (let [entry (gm-at params i)
            (mut value) (gm-const-entry? entry)]
        (when (gm-sym? entry)
          (for [k 0 (len (load uses))]
            (when (= (get (load uses) k) (gm-text entry)) (store! value true) 0)
            0)
          0)
        (push! out (load value)))
      0)
    out))

(defn gm-cx [(a (dyn Allocator)) (file (ptr GmFile)) (decls (ptr (ArrayList GmDecl)))] (-> GmCx)
  (GmCx :a a
        :file file
        :decls decls
        :collect false
        :uses (box-al [(slice u8)] a (al-new [(slice u8)] a))
        :edits (box-al [GmEdit] a (al-new [GmEdit] a))))

(defn gm-bools-eq [(x (ptr (ArrayList bool))) (y (ptr (ArrayList bool)))] (-> bool)
  (and (= (len (load x)) (len (load y)))
       (let [(mut same) true]
         (for [i 0 (len (load x))]
           (when (not (= (get (load x) i) (get (load y) i))) (store! same false) 0)
           0)
         (load same))))

;;; Declarations of every file, with kinds propagated to a fixpoint: a parameter
;;; passed where another declaration takes a value is a value parameter too.
(defn gm-declarations [(a (dyn Allocator)) (files (ptr (ArrayList GmFile)))] (-> (ptr (ArrayList GmDecl)))
  (let [decls (box-al [GmDecl] a (al-new [GmDecl] a))
        (mut changed) true]
    (for [fi 0 (len (load files))]
      (let [file (al-elem [GmFile] files fi)]
        (for [i 0 (len (load (.forms file)))]
          (let [f (al-elem [Sexp] (.forms file) i)
                h (gm-head f)
                params (gm-param-vector f)]
            (when (and (or (= h "defn") (= h "defn*") (= h "defstruct") (= h "defsum"))
                       (> (gm-count f) 1)
                       (gm-sym? (gm-at f 1))
                       (!= (primitive/cast i64 params) 0))
              (let [kinds (box-al [bool] a (al-new [bool] a))]
                (for [k 0 (gm-count params)]
                  (push! kinds (gm-const-entry? (gm-at params k)))
                  0)
                (push! decls (GmDecl :module (.module file) :name (gm-text (gm-at f 1)) :kinds kinds)))
              0))
          0))
      0)
    ; Each round can only turn a parameter into a value parameter, so the number of
    ; parameters bounds the rounds.
    (loop
      (if (not (load changed))
          (break)
          (do
            (store! changed false)
            (for [di 0 (len (load decls))]
              (let [d (al-elem [GmDecl] decls di)]
                (for [fi 0 (len (load files))]
                  (let [file (al-elem [GmFile] files fi)]
                    (when (= (.module file) (.module d))
                      (for [i 0 (len (load (.forms file)))]
                        (let [f (al-elem [Sexp] (.forms file) i)
                              params (gm-param-vector f)]
                          (when (and (!= (primitive/cast i64 params) 0)
                                     (> (gm-count f) 1)
                                     (gm-sym? (gm-at f 1))
                                     (= (gm-text (gm-at f 1)) (.name d))
                                     (not (= (gm-head f) "impl")))
                            (let [cx (primitive/alloc-stack GmCx)]
                              (store! cx (gm-cx a file decls))
                              (let [next (gm-kinds cx f params)]
                                (unless (gm-bools-eq next (.kinds d))
                                  (set! (.kinds d) next)
                                  (store! changed true)
                                  0)))
                            0))
                        0)
                      0))
                  0))
              0))))
    decls))

; ---- edits --------------------------------------------------------------------------------

(defn gm-sort-desc! [(edits (ptr (ArrayList GmEdit)))] (-> i64)
  (let [n (len (load edits))]
    (for [i 1 n]
      (let [(mut j) i]
        (loop
          (if (or (<= (load j) 0)
                  (>= (.lo (al-elem [GmEdit] edits (- (load j) 1)))
                      (.lo (al-elem [GmEdit] edits (load j)))))
              (break)
              (let [tmp (get (load edits) (load j))]
                (store! (al-elem [GmEdit] edits (load j)) (get (load edits) (- (load j) 1)))
                (store! (al-elem [GmEdit] edits (- (load j) 1)) tmp)
                (store! j (- (load j) 1))))))
      0))
  0)

;;; The migration edits for `files[0]`, in descending source order. The other files
;;; are the modules it imports, read only for their declarations.
(defn gm-edits [(a (dyn Allocator)) (files (ptr (ArrayList GmFile)))] (-> (ptr (ArrayList GmEdit)))
  (let [decls (gm-declarations a files)
        file (al-elem [GmFile] files 0)
        cx (primitive/alloc-stack GmCx)]
    (store! cx (gm-cx a file decls))
    (for [i 0 (len (load (.forms file)))]
      (let [f (al-elem [Sexp] (.forms file) i)
            params (gm-param-vector f)]
        (when (!= (primitive/cast i64 params) 0)
          (let [kinds (gm-kinds cx f params)]
            (for [k 0 (gm-count params)]
              (let [entry (gm-at params k)]
                (when (and (gm-sym? entry) (get (load kinds) k))
                  (push! (.edits cx)
                         (GmEdit :lo (sx-lo (load entry)) :hi (sx-hi (load entry))
                                 :text (sconcat3 a "(const " (gm-text entry) " i64)")
                                 :what 1))
                  0))
              0))
          0)
        (gm-walk! cx f))
      0)
    (gm-sort-desc! (.edits cx))
    (.edits cx)))

;;; Does this source use a removed spelling? Reads only the file itself: a width
;;; passed to another module's declaration is found by the full migration.
(defn gm-breaking? [(a (dyn Allocator)) (forms (ptr (ArrayList Sexp)))] (-> bool)
  (let [files (box-al [GmFile] a (al-new [GmFile] a))]
    (push! files (gm-read-file a forms))
    (> (len (load (gm-edits a files))) 0)))
