; src/compiler/macho.coil — Mach-O MH_OBJECT (.o) writer for the arm64 backend.
; Zero dependencies: composes the object file byte-by-byte.
;
; Model: the caller builds sections (byte buffers), a symbol list, and a
; relocation list, then `macho-write` lays out and serializes the object.
;  - symbols reference sections by ORDINAL (1-based, in push order; 0 = undefined)
;  - relocations reference symbols by index into the caller's symbol list;
;    the writer sorts symbols into (local, external-defined, undefined) order
;    as LC_DYSYMTAB requires and remaps relocation symbol numbers.
(module macho)
(import "coil.primitive" :as primitive)

(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "a64" :use *)

; arm64 relocation types (r_type)
(defn reloc-unsigned [] (-> i64)
  0)  ; 8-byte absolute pointer
(defn reloc-branch26 [] (-> i64)
  2)  ; bl/b imm26
(defn reloc-page21 [] (-> i64)
  3)  ; adrp
(defn reloc-pageoff12 [] (-> i64)
  4)  ; add/ldr :lo12:
(defn reloc-got-load-page21 [] (-> i64)
  5)  ; adrp xN, symbol@GOTPAGE
(defn reloc-got-load-pageoff12 [] (-> i64)
  6)  ; ldr xN, [xN, symbol@GOTPAGEOFF]

(defstruct MSect
  [(segname (slice u8))
   (sectname (slice u8))
   (buf (ArrayList u8))
   (align i64)
   (flags i64)])
(defstruct MSym
  [(name (slice u8)) (sect i64) (off i64) (ext bool)])
(defstruct MReloc
  [(sect i64)  ; section ordinal the fixup lives in (1-based)
   (off i64)  ; byte offset of the fixup within that section
   (sym i64)  ; caller symbol index
   (rtype i64)
   (pcrel bool)
   (len i64)])  ; len: 2 = 4 bytes, 3 = 8 bytes

(defstruct MObj
  [(sects (ArrayList MSect))
   (syms (ArrayList MSym))
   (relocs (ArrayList MReloc))
   (a (dyn Allocator))])

(defn mobj-new [(a (dyn Allocator))] (-> MObj)
  (let [p (primitive/alloc-stack MObj)]
    (set! (.sects p) (al-new [MSect] a))
    (set! (.syms p) (al-new [MSym] a))
    (set! (.relocs p) (al-new [MReloc] a))
    (set! (.a p) a)
    (load p)))

; add a section; returns its 1-based ordinal.
(defn mobj-add-sect! [(o (mut MObj)) (seg (slice u8)) (sect (slice u8)) (align i64) (flags i64)] (-> i64)
  (let [s (primitive/alloc-stack MSect)]
    (set! (.segname s) seg)
    (set! (.sectname s) sect)
    (set! (.buf s) (al-new [u8] (load (field o a))))
    (set! (.align s) align)
    (set! (.flags s) flags)
    (al-push! (mut (.sects o)) (load s))
    (al-len [MSect] (.sects o))))

; add a symbol; returns its index (caller-side numbering used by relocs).
(defn mobj-add-sym! [(o (mut MObj)) (name (slice u8)) (sect i64) (off i64) (ext bool)] (-> i64)
  (let [s (primitive/alloc-stack MSym)]
    (set! (.name s) name)
    (set! (.sect s) sect)
    (set! (.off s) off)
    (set! (.ext s) ext)
    (al-push! (mut (.syms o)) (load s))
    (primitive/isub (al-len [MSym] (.syms o)) 1)))

(defn mobj-add-reloc! [(o (mut MObj)) (sect i64) (off i64) (sym i64) (rtype i64) (pcrel bool) (len i64)] (-> i64)
  (let [r (primitive/alloc-stack MReloc)]
    (set! (.sect r) sect)
    (set! (.off r) off)
    (set! (.sym r) sym)
    (set! (.rtype r) rtype)
    (set! (.pcrel r) pcrel)
    (set! (.len r) len)
    (al-push! (mut (.relocs o)) (load r))
    0))

; Whether the object has a relocation to an undefined symbol with this exact
; name.  Looking only at the symbol table is insufficient: source-linked
; compiler support can declare externs which dead stripping makes inert.
(defn mobj-references-undefined? [(o (mut MObj)) (name (slice u8))] (-> bool)
  (let [nr (al-len [MReloc] (.relocs o))
        ns (al-len [MSym] (.syms o))
        (mut i) 0
        (mut found) false]
    (loop (if (or (>= (load i) nr) (load found))
              (break)
              (let [si (.sym (al-at [MReloc] (field o relocs) (load i)))]
                (when (and (>= si 0) (< si ns))
                  (let [s (al-at [MSym] (field o syms) si)]
                    (when (and (= (.sect s) 0) (= (.name s) name))
                      (store! found true)
                      0)))
                (set! i (+ (load i) 1)))))
    (load found)))

; pointer to the byte buffer of section `ord` (1-based) — the caller emits into it.
(defn mobj-sect-buf [(o (mut MObj)) (ord i64)] (-> (ptr (ArrayList u8)))
  (field (al-at [MSect] (field o sects) (primitive/isub ord 1)) buf))
(defn mobj-sect-len [(o (mut MObj)) (ord i64)] (-> i64)
  (al-len [u8] (.buf (al-at [MSect] (field o sects) (primitive/isub ord 1)))))

; write a fixed-width (16-byte, NUL-padded) segment/section name
(defn mo-name16! [(b (mut (ArrayList u8))) (s (slice u8))] (-> i64)
  (let [n (slice-len s)
        (mut i) 0]
    (loop (if (>= (load i) (primitive/cast i64 16))
              (break)
              (do
                (if (< (load i) n)
                    (al-push! (mut b) (slice-get s (load i)))
                    (al-push! (mut b) (primitive/cast u8 0)))
                (set! i (primitive/iadd (load i) 1))))))
  0)

(defn align-up [(v i64) (align i64)] (-> i64)
  (let [rem (primitive/urem v align)]
    (if (= rem (primitive/cast i64 0)) v (primitive/iadd v (primitive/isub align rem)))))
(defn pow2 [(n i64)] (-> i64)
  (primitive/ishl 1 n))

; ============================ serialization ==================================
; Layout:  header | segment cmd (+sections) | build-version | symtab | dysymtab
;          | section contents | relocations | nlist symtab | string table
(defn macho-write [(o (mut MObj))] (-> (ptr (ArrayList u8)))
  (let [a (load (field o a))
        nsect (al-len [MSect] (.sects o))
        nsym (al-len [MSym] (.syms o))
        nrel (al-len [MReloc] (.relocs o))
        ; ---- symbol permutation: locals, then external defined, then undefined.
        ; order[i] = caller index of the i-th nlist entry; perm[caller] = nlist idx.
        (mut order) (al-new [i64] a)
        (mut perm) (al-new [i64] a)
        (mut nlocal) 0
        (mut nextdef) 0
        (mut nundef) 0]
    (let [(mut i) 0]
      (loop (if (>= (load i) nsym)
                (break)
                (do (al-push! (mut perm) 0) (set! i (primitive/iadd (load i) 1))))))
    ; pass 1: locals (defined, not ext)
    (let [(mut i) 0]
      (loop (if (>= (load i) nsym)
                (break)
                (do
                  (let [sp (al-at [MSym] (field o syms) (load i))]
                    (when (and (!= (load (field sp sect)) (primitive/cast i64 0))
                               (not (load (field sp
                                                 ext))))
                      (al-set! (mut perm) (load i) (al-len [i64] (load order)))
                      (al-push! (mut order) (load i))
                      (store! nlocal (primitive/iadd (load nlocal) 1))
                      0))
                  (set! i (primitive/iadd (load i) 1))))))
    ; pass 2: external defined
    (let [(mut i) 0]
      (loop (if (>= (load i) nsym)
                (break)
                (do
                  (let [sp (al-at [MSym] (field o syms) (load i))]
                    (when (and (!= (load (field sp sect)) (primitive/cast i64 0))
                               (load (field sp
                                            ext)))
                      (al-set! (mut perm) (load i) (al-len [i64] (load order)))
                      (al-push! (mut order) (load i))
                      (store! nextdef (primitive/iadd (load nextdef) 1))
                      0))
                  (set! i (primitive/iadd (load i) 1))))))
    ; pass 3: undefined
    (let [(mut i) 0]
      (loop (if (>= (load i) nsym)
                (break)
                (do
                  (let [sp (al-at [MSym] (field o syms) (load i))]
                    (when (= (load (field sp sect)) (primitive/cast i64 0))
                      (al-set! (mut perm) (load i) (al-len [i64] (load order)))
                      (al-push! (mut order) (load i))
                      (store! nundef (primitive/iadd (load nundef) 1))
                      0))
                  (set! i (primitive/iadd (load i) 1))))))
    ; ---- addresses: sections are laid out consecutively from vmaddr 0.
    (let [(mut addrs) (al-new [i64] a)
          (mut vm) 0]
      (let [(mut i) 0]
        (loop (if (>= (load i) nsect)
                  (break)
                  (do
                    (let [sp (al-at [MSect] (field o sects) (load i))]
                      (set! vm (align-up (load vm) (pow2 (.align sp))))
                      (al-push! (mut addrs) (load vm))
                      (set! vm
                            (primitive/iadd (load vm)
                                            (al-len [u8]
                                                    (.buf sp)))))
                    (set! i (primitive/iadd (load i) 1))))))
      ; ---- file offsets
      (let [ncmds 4
            sizeofcmds
              (primitive/iadd (primitive/iadd 72 (primitive/imul 80 nsect)) (primitive/iadd 24 (primitive/iadd 24 80)))
            hdrend (primitive/iadd 32 sizeofcmds)
            (mut foffs) (al-new [i64] a)
            (mut fo) hdrend]
        (let [(mut i) 0]
          (loop (if (>= (load i) nsect)
                    (break)
                    (do
                      (let [sp (al-at [MSect] (field o sects) (load i))]
                        (set! fo (align-up (load fo) (pow2 (.align sp))))
                        (al-push! (mut foffs) (load fo))
                        (set! fo
                              (primitive/iadd (load fo)
                                              (al-len [u8]
                                                      (.buf sp)))))
                      (set! i (primitive/iadd (load i) 1))))))
        ; relocations: grouped per section, 8-byte aligned
        (set! fo (align-up (load fo) 8))
        (let [(mut reloffs) (al-new [i64] a)
              (mut nrelocs) (al-new [i64] a)]
          (let [(mut si) 0]
            (loop (if (>= (load si) nsect)
                      (break)
                      (do
                        (let [(mut cnt) 0
                              (mut ri) 0]
                          (loop (if (>= (load ri) nrel)
                                    (break)
                                    (do
                                      (when (= (load (field (al-at [MReloc]
                                                                   (field o
                                                                          relocs)
                                                                   (load ri))
                                                            sect))
                                               (primitive/iadd (load si) 1))
                                        (store! cnt (primitive/iadd (load cnt) 1)))
                                      (set! ri (primitive/iadd (load ri) 1)))))
                          (al-push! (mut reloffs) (when (> (load cnt) (primitive/cast i64 0)) (load fo)))
                          (al-push! (mut nrelocs) (load cnt))
                          (set! fo (primitive/iadd (load fo) (primitive/imul 8 (load cnt)))))
                        (set! si (primitive/iadd (load si) 1))))))
          (let [symoff (align-up (load fo) 8)
                stroff (primitive/iadd symoff (primitive/imul 16 nsym))
                ; ---- string table (primitive/index 0 = NUL)
                (mut strtab) (al-new [u8] a)
                (mut strx) (al-new [i64] a)]
            (al-push! (mut strtab) (primitive/cast u8 0))
            ; strx is per NLIST order
            (let [(mut i) 0]
              (loop (if (>= (load i) nsym)
                        (break)
                        (do
                          (let [ci (al-get [i64] (load order) (load i))
                                sp (al-at [MSym] (field o syms) ci)]
                            (al-push! (mut strx) (al-len [u8] (load strtab)))
                            (b-bytes! (mut strtab) (.name sp))
                            (al-push! (mut strtab) (primitive/cast u8 0)))
                          (set! i (primitive/iadd (load i) 1))))))
            (let [strsize (al-len [u8] (load strtab))
                  (mut out) (al-new [u8] a)]
              ; ================= header =================
              (b-u32! (mut out) 4277009103)  ; MH_MAGIC_64 0xFEEDFACF
              (b-u32! (mut out) 16777228)  ; CPU_TYPE_ARM64
              (b-u32! (mut out) 0)  ; CPU_SUBTYPE_ARM64_ALL
              (b-u32! (mut out) 1)  ; MH_OBJECT
              (b-u32! (mut out) ncmds)
              (b-u32! (mut out) sizeofcmds)
              (b-u32! (mut out) 8192)  ; MH_SUBSECTIONS_VIA_SYMBOLS
              (b-u32! (mut out) 0)  ; reserved
              ; ================= LC_SEGMENT_64 =================
              (b-u32! (mut out) 25)  ; LC_SEGMENT_64
              (b-u32! (mut out) (primitive/iadd 72 (primitive/imul 80 nsect)))
              (mo-name16! (mut out) "")  ; segname (unnamed in objects)
              (b-u64! (mut out) 0)  ; vmaddr
              (b-u64! (mut out) (load vm))  ; vmsize
              (b-u64! (mut out) (if (> nsect (primitive/cast i64 0)) (al-get [i64] (load foffs) 0) hdrend))  ; fileoff
              ; filesize = end of the last section's contents - fileoff (relocs excluded)
              (b-u64! (mut out)
                      (when (> nsect (primitive/cast i64 0))
                        (primitive/isub (primitive/iadd (al-get [i64] (load foffs) (primitive/isub nsect 1))
                                                        (al-len [u8]
                                                                (load (field (al-at [MSect]
                                                                                    (field o sects)
                                                                                    (primitive/isub nsect 1))
                                                                             buf))))
                                        (al-get [i64] (load foffs) 0))))
              (b-u32! (mut out) 7)  ; maxprot rwx
              (b-u32! (mut out) 7)  ; initprot rwx
              (b-u32! (mut out) nsect)
              (b-u32! (mut out) 0)  ; flags
              ; section headers
              (let [(mut i) 0]
                (loop (if (>= (load i) nsect)
                          (break)
                          (do
                            (let [sp (al-at [MSect] (field o sects) (load i))]
                              (mo-name16! (mut out) (.sectname sp))
                              (mo-name16! (mut out) (.segname sp))
                              (b-u64! (mut out) (al-get [i64] (load addrs) (load i)))
                              (b-u64! (mut out) (al-len [u8] (.buf sp)))
                              (b-u32! (mut out) (al-get [i64] (load foffs) (load i)))
                              (b-u32! (mut out) (.align sp))
                              (b-u32! (mut out) (al-get [i64] (load reloffs) (load i)))
                              (b-u32! (mut out) (al-get [i64] (load nrelocs) (load i)))
                              (b-u32! (mut out) (.flags sp))
                              (b-u32! (mut out) 0)
                              (b-u32! (mut out) 0)
                              (b-u32! (mut out) 0))
                            (set! i (primitive/iadd (load i) 1))))))
              ; ================= LC_BUILD_VERSION =================
              (b-u32! (mut out) 50)  ; LC_BUILD_VERSION
              (b-u32! (mut out) 24)
              (b-u32! (mut out) 1)  ; PLATFORM_MACOS
              (b-u32! (mut out) 720896)  ; minos 11.0.0
              (b-u32! (mut out) 0)  ; sdk
              (b-u32! (mut out) 0)  ; ntools
              ; ================= LC_SYMTAB =================
              (b-u32! (mut out) 2)  ; LC_SYMTAB
              (b-u32! (mut out) 24)
              (b-u32! (mut out) symoff)
              (b-u32! (mut out) nsym)
              (b-u32! (mut out) stroff)
              (b-u32! (mut out) strsize)
              ; ================= LC_DYSYMTAB =================
              (b-u32! (mut out) 11)  ; LC_DYSYMTAB
              (b-u32! (mut out) 80)
              (b-u32! (mut out) 0)  ; ilocalsym
              (b-u32! (mut out) (load nlocal))  ; nlocalsym
              (b-u32! (mut out) (load nlocal))  ; iextdefsym
              (b-u32! (mut out) (load nextdef))  ; nextdefsym
              (b-u32! (mut out) (primitive/iadd (load nlocal) (load nextdef)))  ; iundefsym
              (b-u32! (mut out) (load nundef))  ; nundefsym
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              (b-u32! (mut out) 0)
              ; ================= section contents =================
              (let [(mut i) 0]
                (loop (if (>= (load i) nsect)
                          (break)
                          (do
                            (let [sp (al-at [MSect] (field o sects) (load i))]
                              (b-zeros! (mut out)
                                        (primitive/isub (al-get [i64] (load foffs) (load i)) (al-len [u8] (load out))))
                              (b-bytes! (mut out) (al-slice [u8] (.buf sp))))
                            (set! i (primitive/iadd (load i) 1))))))
              ; ================= relocations (grouped per section) =================
              (b-zeros! (mut out) (primitive/isub (align-up (al-len [u8] (load out)) 8) (al-len [u8] (load out))))
              (let [(mut si) 0]
                (loop (if (>= (load si) nsect)
                          (break)
                          (do
                            (let [(mut ri) 0]
                              (loop (if (>= (load ri) nrel)
                                        (break)
                                        (do
                                          (let [rp (al-at [MReloc] (field o relocs) (load ri))]
                                            (when (= (load (field rp sect)) (primitive/iadd (load si) 1))
                                              (b-u32! (mut out) (load (field rp off)))
                                              ; sym < 0 is a SECTION relocation (r_extern = 0):
                                              ; symbolnum is the target SECTION ordinal (-sym), not
                                              ; a symbol index — the DWARF-address scheme dsymutil
                                              ; wants. sym >= 0 is the usual extern symbol reloc.
                                              (let [secreloc (< (load (field rp sym)) (primitive/cast i64 0))
                                                    snum
                                                      (if secreloc
                                                          (primitive/isub 0 (load (field rp sym)))
                                                          (al-get [i64]
                                                                  (load perm)
                                                                  (load (field rp
                                                                               sym))))]
                                                (b-u32! (mut out)
                                                        (primitive/ior (primitive/iand snum 16777215)
                                                                       (primitive/ior (primitive/ishl (when (load (field rp
                                                                                                                         pcrel))
                                                                                                        1)
                                                                                                      24)
                                                                                      (primitive/ior (primitive/ishl (load (field rp
                                                                                                                                  len))
                                                                                                                     25)
                                                                                                     (primitive/ior (primitive/ishl (unless secreloc
                                                                                                                                      1)
                                                                                                                                    27)  ; r_extern
                                                                                                                    (primitive/ishl (load (field rp
                                                                                                                                                 rtype))
                                                                                                                                    28)))))))
                                              0))
                                          (set! ri (primitive/iadd (load ri) 1))))))
                            (set! si (primitive/iadd (load si) 1))))))
              ; ================= nlist symbol table =================
              (b-zeros! (mut out) (primitive/isub symoff (al-len [u8] (load out))))
              (let [(mut i) 0]
                (loop (if (>= (load i) nsym)
                          (break)
                          (do
                            (let [ci (al-get [i64] (load order) (load i))
                                  sp (al-at [MSym] (field o syms) ci)]
                              (b-u32! (mut out) (al-get [i64] (load strx) (load i)))
                              (if (= (.sect sp) (primitive/cast i64 0))
                                  (do
                                    (b-u8! (mut out) 1)  ; N_UNDF | N_EXT
                                    (b-u8! (mut out) 0)  ; NO_SECT
                                    (b-u16! (mut out) 0)  ; n_desc
                                    (b-u64! (mut out) 0)
                                    0)
                                  (do
                                    (b-u8! (mut out) (primitive/ior 14 (when (load (field sp ext)) 1)))  ; N_SECT (|N_EXT)
                                    (b-u8! (mut out) (.sect sp))
                                    (b-u16! (mut out) 0)
                                    (b-u64! (mut out)
                                            (primitive/iadd (al-get [i64]
                                                                    (load addrs)
                                                                    (primitive/isub (.sect sp)
                                                                                    1))
                                                            (.off sp)))
                                    0)))
                            (set! i (primitive/iadd (load i) 1))))))
              ; ================= string table =================
              (b-bytes! (mut out) (al-slice [u8] (load strtab)))
              (box! a (ArrayList u8) (load out)))))))))
