;;; Architecture-independent values and metadata operations for slot-based
;;; native lowering. Registers, instructions, ABI and object emission remain
;;; target policy. A context is a borrowed view of the target's existing state.
(module coil.compiler.native)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.arraylist" :use *)
(import "coil.control" :use *)
(import "coil.str" :use *)
(import "coil.slice" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use [const-overflow-test box-al])
(import "coil.mem" :use [f64-bits])
(import "coil.compiler.ir_syntax" :as irs)
(import "coil.compiler.layoutdb" :use *)
(import "coil.compiler.debuginfo" :use [dbg-name?])
(import "coil.compiler.dwarf" :use [DwVar DwLineEv])
(import "coil.compiler.text" :as text)

;;; Shared native debug-note policy; target state and callbacks are caller syntax.
(defn debug-variable [(g Code)
                      (offset Code)
                      (type-index Code)
                      (name Code)
                      (t Code)
                      (slot Code)
                      (indirect Code)
                      (param Code)
                      (src Code)
                      (lo Code)] (-> Code)
  `(let [ti (if (dbg-name? ~name) (~type-index ~g ~t) -1)]
     (unless (or (< ti 0)
                 (< ~src 0)
                 (< ~lo 0))
       (let [(mut v) (zeroed DwVar)]
         (set! (.name v)
               ~name)
         (set! (.tyidx v)
               ti)
         (set! (.slot v)
               ~slot)
         (set! (.indirect v)
               ~indirect)
         (set! (.param v)
               ~param)
         (set! (.source v)
               ~src)
         (set! (.lo v)
               ~lo)
         ; a local is live from here (its initializer has been emitted); a
         ; parameter is live for the whole function
         (set! (.start v)
               (if ~param -1 (~offset (mut (.asm ~g)))))
         (set! (.end v)
               -1)
         (push! (mut (.dwvars ~g))
                v)
         0))))

;;; Shared native debug-note policy; target state and callbacks are caller syntax.
(defn debug-binding [(g Code)
                     (record-variable Code)
                     (name Code)
                     (av Code)
                     (src Code)
                     (lo Code)] (-> Code)
  `(let [n (len ~name)
         (mut t) (av-ty ~av)]
     (unless (and (>= n 5)
                  (= (subslice ~name (primitive/isub n 5) n) ".slot"))
       (let [slotname (text/format (.a ~g) "{}.slot" ~name)]
         (match (gscope-get (.env ~g) slotname)
           (Some [_sl]
                 ; mut variable: value lives behind the pointer
                 (match t
                   (TPtr [inner]
                         (~record-variable ~g
                            ~name
                            inner
                            (av-v ~av)
                            true
                            false
                            ~src
                            ~lo))
                   (_ (~record-variable ~g
                         ~name
                         (mut t)
                         (av-v ~av)
                         false
                         false
                         ~src
                         ~lo))))
           (None []
                 (~record-variable ~g
                    ~name
                    (mut t)
                    (av-v ~av)
                    false
                    false
                    ~src
                    ~lo)))))))

;;; Shared native debug-note policy; target state and callbacks are caller syntax.
(defn debug-span [(g Code) (offset Code) (e Code)] (-> Code)
  `(let [src (.source ~e)
         lo (.lo ~e)]
     (unless (or (< src 0)
                 (< lo 0)
                 (and (= src (.dwcursrc ~g))
                      (= lo
                         (.dwcurlo ~g))))
       (let [(mut ev) (zeroed DwLineEv)]
         (set! (.textoff ev) (~offset (mut (.asm ~g))))
         (set! (.source ev) src)
         (set! (.lo ev) lo)
         (set! (.pe ev) false)
         (push! (mut (.dwevs ~g)) ev)
         (set! (.dwcursrc ~g) src)
         (set! (.dwcurlo ~g) lo)
         0))))

(deftrait ConstantErrors [Self]
  (native-user-fail [(self Self) (message (slice u8))] (-> i64)))

(deftrait NativeErrors [Self]
  :requires
  [ConstantErrors]
  (native-fail [(self Self) (message (slice u8))] (-> i64))
  (native-fail2 [(self Self) (message (slice u8)) (what (slice u8))] (-> i64)))

(defstruct NativeContext [D]
  [(a (dyn Allocator))
   (layouts (ptr LayoutDb))
   (frame (ptr i64))
   (loops (ptr (ArrayList GLoop)))
   (errors D)])

(defstruct GLoop
  [(label (Option (slice u8)))
   (contlabel i64)
   (breaklabel i64)
   (resslot i64)
   (resty Type)
   (has_res bool)])

; Interned string literal and runtime static cell.
(defstruct GStr [(s (slice u8)) (symidx i64)])

(defstruct GStatic [(name (slice u8)) (ty Type) (symidx i64)])

; AVal's kind is 0 for an integer/pointer immediate, 1 for a by-value stack
; slot, and 2 for immediate floating-point bits. No target register is stored.
(defstruct AVal [(kind i64) (v i64) (ty Type)])

(defsum GScope
  (GNil [])
  (GBind [(name (slice u8)) (av AVal) (rest (ptr GScope))]))

(defstruct GCEval [(v i64) (uns bool)])

(defn mk-aval [(kind i64) (v i64) (ty Type)] (-> AVal)
  (AVal
    :kind kind
    :v v
    :ty ty))

(defn av-kind [(x AVal)] (-> i64)
  (let [(mut p) (: x AVal)] (.kind p)))

(defn av-v [(x AVal)] (-> i64)
  (let [(mut p) (: x AVal)] (.v p)))

(defn av-ty [(x AVal)] (-> Type)
  (let [(mut p) (: x AVal)] (.ty p)))

(defn gscope-nil [(a (dyn Allocator))] (-> (ptr GScope))
  (box! a GScope (GNil)))

(defn gscope-put [(a (dyn Allocator))
                  (s (ptr GScope))
                  (name (slice u8))
                  (av AVal)] (-> (ptr GScope))
  (box! a
        GScope
        (GBind
          :name name
          :av av
          :rest s)))

(defn gscope-get [(s (ptr GScope)) (name (slice u8))] (-> (Option AVal))
  (match (load s)
    (GNil [] (None [AVal]))
    (GBind [n av rest] (if (= n name) (Some [AVal] av) (gscope-get rest name)))))

(defn g-last-component [(nm (slice u8))] (-> (slice u8))
  (let [n (len nm)
        (mut dot) -1]
    (for [i 0 n]
      (when (= (primitive/cast i64 (get nm i))
               46)
        (set! dot i)))
    (if (>= (load dot) 0)
        (subslice nm (primitive/iadd (load dot) 1) n)
        nm)))

(defn ty-is-float [(t (ptr Type))] (-> bool)
  (match (load t) (TFloat [_] true) (_ false)))

(defn ty-float-bytes [(t (ptr Type))] (-> i64)
  (match (load t) (TFloat [bits] (/ bits 8)) (_ 8)))

(defn mk-gcev [(v i64) (u bool)] (-> GCEval)
  (GCEval :v v :uns u))

(defn gcev-v [(c GCEval)] (-> i64)
  (let [(mut p) (: c GCEval)] (.v p)))

(defn gcev-u [(c GCEval)] (-> bool)
  (let [(mut p) (: c GCEval)] (.uns p)))

(defn g-const-cmp [(op i64) (l i64) (lu bool) (r i64) (ru bool)] (-> GCEval)
  (let [b
          (cond (or lu ru)
                  (let [lx (primitive/cast u64 l)
                        rx (primitive/cast u64 r)]
                    (cond (= op 0) (< lx rx)
                          (= op 1) (<= lx rx)
                          (= op 2) (> lx rx)
                          (= op 3) (>= lx rx)
                          (= op 4) (= lx rx)
                          :else (!= lx rx)))
                (= op 0) (< l r)
                (= op 1) (<= l r)
                (= op 2) (> l r)
                (= op 3) (>= l r)
                (= op 4) (= l r)
                :else (!= l r))]
    (mk-gcev (when b 1) false)))

(defn slot-new! [(D NativeErrors)] [(g (ref (NativeContext D)))
                                    (size i64)
                                    (align i64)] (-> i64)
  ; every slot is 8-aligned and 8-rounded (16 for 16-aligned types): stores of
  ; full x-words into small slots can never clobber a neighbor.
  (let [al (if (< align 8) 8 align)
        sz
          (primitive/imul (/ (primitive/iadd (if (< size
                                                    1)
                                                 1
                                                 size)
                                             7)
                             8)
                          8)
        off
          (primitive/imul (/ (primitive/iadd (load (.frame g))
                                             (primitive/isub al 1))
                             al)
                          al)]
    (store! (.frame g) (primitive/iadd off sz))
    off))

(defn g-loop-index [(D NativeErrors)] [(g (ref (NativeContext D)))
                                       (label (Option (slice u8)))] (-> i64)
  (let [n (len (load (.loops g)))]
    (match label
      (None []
            (do
              (when (= n 0)
                (native-fail (.errors g) "break/continue outside a loop"))
              (primitive/isub n 1)))
      (Some [want]
            (let [(mut i) (primitive/isub n 1)
                  (mut r) -1]
              (loop (if (< (load i) 0)
                        (break)
                        (do
                          (match (.label (layout-at (.loops g)
                                                    (load i)))
                            (None [] 0)
                            (Some [have]
                                  (when (and (< (load r) 0)
                                             (= have want))
                                    (set! r (load i))
                                    0)))
                          (set! i (primitive/isub (load i) 1)))))
              (when (< (load r) 0)
                (native-fail2 (.errors g) "no such loop label: " want))
              (load r))))))

(defn g-bits-info [(D NativeErrors)] [(g (ref (NativeContext D)))
                                      (nm (slice u8))
                                      (fname (slice u8))
                                      (lowp (ptr i64))
                                      (widthp (ptr i64))
                                      (signedp (ptr bool))
                                      (backp (ptr i64))] (-> i64)
  (let [si (struct-index (.layouts g) nm)]
    (when (< si 0)
      (native-fail2 (.errors g) "bit access on unknown struct: " nm))
    (let [e (struct-at (.layouts g) si)]
      (match (.layout e)
        (LBits [backing offs]
               (let [fi (field-number (.layouts g) si fname)]
                 (set! lowp (get (load offs) fi))
                 (set! backp backing)
                 (match (.ty (layout-at (.fields e) fi))
                   (TInt [bits sg] (do (set! widthp bits) (set! signedp sg) 0))
                   (TBool [] (do (set! widthp 1) (set! signedp false) 0))
                   (_ (native-fail (.errors g)
                                   "bit-struct field with non-int type")))))
        (_ (native-fail2 (.errors g) "bit access on non-bits struct: " nm))))))

(defn g-const-eval [(D NativeErrors)] [(g (ref (NativeContext D)))
                                       (e (ptr Expr))] (-> GCEval)
  (let [a (.a g)]
    (match (.kind e)
      (EInt [v] (mk-gcev v false))
      (EBool [b] (mk-gcev (when b 1) false))
      (EIf [c thn els]
           (if (!= (gcev-v (g-const-eval g c)) 0)
               (g-const-eval g thn)
               (g-const-eval g els)))
      (ESizeOf [t] (mk-gcev (size (.layouts g) (box-type a t)) false))
      (EAlignOf [t] (mk-gcev (align (.layouts g) (box-type a t)) false))
      (EOffsetOf [t fname]
                 (match t
                   (TStruct [nm]
                            (let [si (struct-index (.layouts g) nm)]
                              (when (< si 0)
                                (native-fail2 (.errors g)
                                              "offset-of on unknown struct: "
                                              nm))
                              (mk-gcev (field-offset (.layouts g)
                                                     si
                                                     (field-number (.layouts g)
                                                                   si
                                                                   fname))
                                       false)))
                   (_ (do
                        (native-user-fail (.errors g)
                                          "static-assert: offset-of on non-struct")
                        (mk-gcev 0 false)))))
      (ECast [t inner]
             (mk-gcev (gcev-v (g-const-eval g inner))
                      (match t (TInt [bits s] (not s)) (_ false))))
      (EBin [op lhs rhs]
            (let [lc (g-const-eval g lhs)
                  rc (g-const-eval g rhs)]
              (g-const-bin (.errors g)
                           op
                           (gcev-v lc)
                           (gcev-u lc)
                           (gcev-v rc)
                           (gcev-u rc))))
      (ECmp [op lhs rhs]
            (let [lc (g-const-eval g lhs)
                  rc (g-const-eval g rhs)]
              (g-const-cmp op (gcev-v lc) (gcev-u lc) (gcev-v rc) (gcev-u rc))))
      (_ (do
           (native-user-fail (.errors g)
                             "static-assert: only int literals, sizeof/alignof/offsetof, casts, arithmetic and comparisons are allowed")
           (mk-gcev 0 false))))))

(defn g-const-bin [(D ConstantErrors)] [(errors D)
                                        (op i64)
                                        (l i64)
                                        (lu bool)
                                        (r i64)
                                        (ru bool)] (-> GCEval)
  (let [uns (or lu ru)]
    (mk-gcev (cond (= op 0) (primitive/iadd l r)
                   (= op 1) (primitive/isub l r)
                   (= op 2) (primitive/imul l r)
                   (= op 7) (& l r)
                   (= op 8) (| l r)
                   (= op 9) (^ l r)
                   (= op 10) (<< l r)
                   (= op 11)
                     (if uns
                         (primitive/cast i64
                                         (>> (primitive/cast u64 l)
                                             (primitive/cast u64 r)))
                         (>> l r))
                   (= op 3)
                     (if (= r 0)
                         (do
                           (native-user-fail errors
                                             "static-assert: divide/mod by zero")
                           0)
                         (if uns (primitive/udiv l r) (/ l r)))
                   (= op 4)
                     (if (= r 0)
                         (do
                           (native-user-fail errors
                                             "static-assert: divide/mod by zero")
                           0)
                         (if uns (primitive/urem l r) (% l r)))
                   (= op 5)
                     (if (= r 0)
                         (do
                           (native-user-fail errors
                                             "static-assert: divide/mod by zero")
                           0)
                         (primitive/udiv l r))
                   (>= op 15) (const-overflow-test op l r uns)
                   (>= op 12)
                     (do
                       (native-user-fail errors
                                         "static-assert: a rotate or high multiply does not fold")
                       0)
                   (= r 0)
                     (do
                       (native-user-fail errors
                                         "static-assert: divide/mod by zero")
                       0)
                   :else (primitive/urem l r))
             uns)))

(defn ty-int-info [(t (ptr Type))
                   (bytesp (ptr i64))
                   (signedp (ptr bool))] (-> i64)
  (match (load t)
    (TInt [bits sg]
          (do
            (set! bytesp
                  (if (<= bits 8)
                      1
                      (if (<= bits 16)
                          2
                          (if (<= bits
                                  32)
                              4
                              8))))
            (set! signedp sg)
            0))
    (TBool [] (do (set! bytesp 1) (set! signedp false) 0))
    (_ (do (set! bytesp 8) (set! signedp false) 0))))

;;; A lowering invocation owns its SSA inputs and borrows a target machine.
;;; The interface statically selects target operations without erasing the state.
(deftrait NativeLowering [Self]
  (lowering-inputs [(g (ptr Self))] (-> (ptr IrInputs)))
  (lowering-allocator [(g (ptr Self))] (-> (dyn Allocator)))
  (lowering-fail [(g (ptr Self)) (message (slice u8))] (-> i64))
  (lowering-fail2 [(g (ptr Self)) (message (slice u8)) (what (slice u8))]
    (-> i64))
  (lowering-size [(g (ptr Self)) (t (ptr Type))] (-> i64))
  (lowering-type-slot [(g (ptr Self)) (t (ptr Type))] (-> i64))
  (lowering-value-slot [(g (ptr Self)) (av AVal)] (-> i64))
  (lowering-copy [(g (ptr Self)) (dst i64) (src i64) (size i64)] (-> i64))
  (lowering-cast [(g (ptr Self)) (t Type) (av AVal)] (-> AVal))
  (lowering-sext-bool [(g (ptr Self)) (av AVal) (dstty Type)] (-> AVal))
  (lowering-compare [(g (ptr Self)) (op i64) (lav AVal) (rav AVal)] (-> AVal))
  (lowering-wide-compare [(g (ptr Self))
                          (pred (slice u8))
                          (lav AVal)
                          (rav AVal)] (-> AVal))
  (lowering-store-mask-lane [(g (ptr Self)) (av AVal) (dst i64)] (-> i64))
  (lowering-zero [(g (ptr Self)) (dst i64) (size i64)] (-> i64))
  (lowering-store [(g (ptr Self)) (av AVal) (dst i64)] (-> i64))
  (lowering-expression [(g (ptr Self)) (e (ptr Expr))] (-> AVal))
  (lowering-ir-line [(irctx (ptr Self))
                     (retp (ptr AVal))
                     (donep (ptr bool))
                     (line (slice u8))] (-> i64))
  (lowering-aggregate-element [(g (ptr Self))
                               (t (ptr Type))
                               (idx i64)
                               (offp (ptr i64))] (-> Type))
  (lowering-select [(g (ptr Self)) (maskav AVal) (aav AVal) (bav AVal)]
    (-> AVal))
  (lowering-binary [(g (ptr Self)) (op i64) (lav AVal) (rav AVal)] (-> AVal))
  (lowering-value-float [(g (ptr Self)) (av AVal) (reg i64)] (-> i64))
  (lowering-load-float [(g (ptr Self)) (reg i64) (src i64) (size i64)] (-> i64))
  (lowering-store-float [(g (ptr Self)) (reg i64) (dst i64) (size i64)] (-> i64))
  (lowering-float-op [(g (ptr Self)) (op i64) (bits i64)] (-> i64))
  (lowering-address-base [(g (ptr Self)) (av AVal)] (-> i64))
  (lowering-address-offset [(g (ptr Self))
                            (base i64)
                            (index AVal)
                            (scale i64)
                            (preserve bool)] (-> i64))
  (lowering-store-word [(g (ptr Self)) (reg i64) (slot i64)] (-> i64))
  (lowering-frame-slot [(g (ptr Self)) (size i64) (align i64)] (-> i64)))

; The environment cell belongs to lower-ir!; sessions and input views are used
; synchronously and must not escape that call.
(defstruct IrInputs
  [(envp (ptr (ptr GScope)))
   (avsp (ptr (ArrayList AVal)))
   (argtysp (ptr (ArrayList Type)))
   (result Type)])

(defstruct IrContext [G] [(g (ptr G)) (inputs IrInputs)])

(defstruct NativeIrErrors [R] [(g (ptr R))])

(impl [(R NativeLowering)] irs/IrErrors (NativeIrErrors R)
  (ir-error [(self (NativeIrErrors R)) (message (slice u8)) (token (slice u8))]
    (-> i64)
    (lowering-fail2 (.g self) message token)))

;;; A delegate forwards the machine pointer unless marked :frame or :static.
;;; The :inputs getter exposes only this invocation's own SSA input storage.
(defn implement-lowering [(target Code) (delegates Code)] (-> Code)
  (let [methods (primitive/code-list-new)
        count (primitive/code-trait-method-count `NativeLowering)]
    (unless (primitive/icmp-eq (primitive/code-count delegates) count)
      (primitive/error "implement-lowering: one delegate is required for each operation"))
    (for [i 0 count]
      (let [entry (primitive/code-nth delegates i)
            name (primitive/code-trait-method-name `NativeLowering i)
            params (primitive/code-list-new)
            args (primitive/code-list-new)
            arity (primitive/code-trait-arity `NativeLowering i)
            mode
              (if (primitive/icmp-eq (primitive/code-count entry) 3)
                  (primitive/code-nth entry 2)
                  `:machine)
            receiver (primitive/fresh-identifier "receiver")]
        (unless (and (primitive/code-vector? entry)
                     (or (primitive/icmp-eq (primitive/code-count entry) 2)
                         (primitive/icmp-eq (primitive/code-count entry) 3))
                     (primitive/code-eq (primitive/code-nth entry 0) name)
                     (or (primitive/code-eq mode `:machine)
                         (primitive/code-eq mode `:static)
                         (primitive/code-eq mode `:frame)))
          (primitive/error "implement-lowering: invalid or out-of-order delegate"))
        (for [j 0 arity]
          (let [arg
                  (if (primitive/icmp-eq j 0)
                      receiver
                      (primitive/fresh-identifier "argument"))
                type
                  (if (primitive/icmp-eq j 0)
                      `(ptr ~target)
                      (primitive/code-trait-param-type `NativeLowering i j))]
            (primitive/code-list-push! params `(~arg ~type))
            (unless (and (primitive/icmp-eq j 0)
                         (primitive/code-eq mode `:static))
              (primitive/code-list-push! args
                                         (if (and (primitive/icmp-eq j 0)
                                                  (primitive/code-eq mode
                                                                     `:machine))
                                             `(.g ~arg)
                                             arg)))))
        (primitive/code-list-push! methods
                                   `(~name [~@(primitive/code-list-done params)]
                                       (-> ~(primitive/code-trait-ret-type `NativeLowering
                                                                           i))
                                       ~(if (primitive/code-eq (primitive/code-nth entry
                                                                                   1)
                                                               `:inputs)
                                            `(field ~receiver inputs)
                                            `(~(primitive/code-nth entry 1) ~@(primitive/code-list-done args)))))))
    `(impl NativeLowering ~target ~@(primitive/code-list-done methods))))

; a "view" AVal onto lane k of a (vec elemty n) value already resident in a
; slot: same frame, offset by k*lb. Reuses the scalar AVal-level ops (cmp/bin/
; cast) unchanged, one lane at a time — the same scalarization convention as
; `emit-vec-fbin!` below, generalized to every op that needs it.
(defn ir-lane-av [(R NativeLowering)] [(g (ptr R))
                                       (vecav AVal)
                                       (k i64)
                                       (elemty Type)
                                       (lb i64)] (-> AVal)
  (mk-aval 1
           (primitive/iadd (lowering-value-slot g vecav) (primitive/imul k lb))
           elemty))

; reinterpret an AVal's type as unsigned, for llvm-ir ops (icmp ult/.../uitofp)
; whose predicate/opcode carries signedness that ir-parse-type's tokens never
; do (every parsed int type token is TInt _ true — see ir-parse-type above).
(defn ir-as-unsigned [(av AVal)] (-> AVal)
  (let [(mut t) (av-ty av)]
    (match t
      (TInt [bits _] (mk-aval (av-kind av) (av-v av) (TInt bits false)))
      (_ av))))

(defn ir-force-unsigned-ty [(t Type)] (-> Type)
  (match t (TInt [bits _] (TInt bits false)) (_ t)))

; scalar icmp: maps the llvm predicate onto emit-cmp-av!'s op codes (0 lt, 1
; le, 2 gt, 3 ge, 4 eq, else ne), forcing the unsigned reading emit-cmp-av!
; can't otherwise reach (it derives signedness from the operand TYPE, but
; icmp's predicate carries it instead).
(defn ir-icmp-scalar! [(R NativeLowering)] [(g (ptr R))
                                            (pred (slice u8))
                                            (lav AVal)
                                            (rav AVal)]
  (-> AVal)
  (case pred
    "eq" (lowering-compare g 4 lav rav)
    "ne" (lowering-compare g 5 lav rav)
    "slt" (lowering-compare g 0 lav rav)
    "sle" (lowering-compare g 1 lav rav)
    "sgt" (lowering-compare g 2 lav rav)
    "sge" (lowering-compare g 3 lav rav)
    "ult" (lowering-compare g 0 (ir-as-unsigned lav) (ir-as-unsigned rav))
    "ule" (lowering-compare g 1 (ir-as-unsigned lav) (ir-as-unsigned rav))
    "ugt" (lowering-compare g 2 (ir-as-unsigned lav) (ir-as-unsigned rav))
    "uge" (lowering-compare g 3 (ir-as-unsigned lav) (ir-as-unsigned rav))
    (do
      (lowering-fail2 g "llvm-ir: unsupported icmp predicate: " pred)
      (mk-aval 0 0 (TBool)))))

; scalar fcmp: maps the llvm predicate onto emit-cmp-av!'s float op codes (0
; olt, 1 ole, 2 ogt, 3 oge, 4 oeq, 5 one). Only the ordered predicates are
; supported — nothing in the corpus needs an unordered (u*) or ord/uno compare.
(defn ir-fcmp-scalar! [(R NativeLowering)] [(g (ptr R))
                                            (pred (slice u8))
                                            (lav AVal)
                                            (rav AVal)]
  (-> AVal)
  (case pred
    "oeq" (lowering-compare g 4 lav rav)
    "one" (lowering-compare g 5 lav rav)
    "olt" (lowering-compare g 0 lav rav)
    "ole" (lowering-compare g 1 lav rav)
    "ogt" (lowering-compare g 2 lav rav)
    "oge" (lowering-compare g 3 lav rav)
    (do
      (lowering-fail2 g
                      "llvm-ir: unsupported fcmp predicate (only ordered oeq/one/olt/ole/ogt/oge supported): "
                      pred)
      (mk-aval 0 0 (TBool)))))

; shared core for sext/zext/trunc.
; zext retypes the source unsigned; sext/trunc retain the parsed signed type.
; The i1-to-integer 0/-1 case delegates to the target's boolean sign extension.
(defn ir-extend-op! [(R NativeLowering)] [(g (ptr R))
                                          (srcty Type)
                                          (srcav0 AVal)
                                          (dstty Type)
                                          (zext bool)
                                          (sext bool)] (-> AVal)
  (match dstty
    (TVec [delemp lanes]
          (let [selemp (match srcty (TVec [e _] (load e)) (_ (load srcty)))
                boolsrc (match selemp (TBool [] true) (_ false))
                slb (lowering-size g (box-type (lowering-allocator g) selemp))
                dlb (lowering-size g delemp)
                (mut dtp) (: dstty Type)]
            (let [dslot (lowering-type-slot g (mut dtp))]
              (for [k 0 (extent-value lanes)]
                (let [lelem0 (ir-lane-av g srcav0 k selemp slb)
                      rav
                        (cond (and sext boolsrc)
                                (lowering-sext-bool g lelem0 (load delemp))
                              zext
                                (lowering-cast g
                                               (load delemp)
                                               (ir-as-unsigned lelem0))
                              :else
                                (lowering-cast g
                                               (load delemp)
                                               (load lelem0)))]
                  (lowering-copy g
                                 (primitive/iadd dslot
                                                 (primitive/imul k
                                                                 dlb))
                                 (lowering-value-slot g rav)
                                 dlb)))
              (mk-aval 1 dslot dstty))))
    (_ (let [boolsrc (match srcty (TBool [] true) (_ false))]
         (cond (and sext boolsrc) (lowering-sext-bool g (load srcav0) dstty)
               zext (lowering-cast g dstty (ir-as-unsigned srcav0))
               :else (lowering-cast g dstty (load srcav0)))))))

; shared core for fptosi/fptoui/sitofp/uitofp/fptrunc/fpext: also reuses
; emit-cast-av!, overriding signedness the same way ir-extend-op! does
; (uitofp forces the source unsigned; fptoui forces the destination unsigned).
(defn ir-floatconv! [(R NativeLowering)] [(g (ptr R))
                                          (srcty Type)
                                          (srcav0 AVal)
                                          (dstty0 Type)
                                          (unsignedsrc bool)
                                          (unsigneddst bool)] (-> AVal)
  (match dstty0
    (TVec [delemp0 lanes]
          (let [selemp (match srcty (TVec [e _] (load e)) (_ (load srcty)))
                slb (lowering-size g (box-type (lowering-allocator g) selemp))
                delemty
                  (if unsigneddst
                      (ir-force-unsigned-ty (load delemp0))
                      (load delemp0))
                dlb (lowering-size g (box-type (lowering-allocator g) delemty))
                (mut dtp)
                  (fixed-vec (box-type (lowering-allocator g) delemty)
                             (extent-value lanes))]
            (let [dslot (lowering-type-slot g (mut dtp))]
              (for [k 0 (extent-value lanes)]
                (let [lelem0 (ir-lane-av g srcav0 k selemp slb)
                      lelem
                        (if unsignedsrc
                            (ir-as-unsigned lelem0)
                            (load lelem0))
                      rav (lowering-cast g delemty lelem)]
                  (lowering-copy g
                                 (primitive/iadd dslot
                                                 (primitive/imul k
                                                                 dlb))
                                 (lowering-value-slot g rav)
                                 dlb)))
              (mk-aval 1 dslot dtp))))
    (_ (let [dstty (if unsigneddst (ir-force-unsigned-ty dstty0) (load dstty0))
             srcav (if unsignedsrc (ir-as-unsigned srcav0) (load srcav0))]
         (lowering-cast g dstty srcav)))))

; resolve a VALUE token: %name (env), $N (arg), integer literal, undef/zeroinitializer.
(defn ir-value [(R NativeLowering)] [(irctx (ptr R))
                                     (env (ptr GScope))
                                     (tk (slice u8))
                                     (t Type)] (-> AVal)
  (let [g irctx
        avs (.avsp (lowering-inputs irctx))]
    (let [(mut tp)
            (: t
               Type)]
      (cond (= (primitive/cast i64 (get tk 0)) 37)  ; %
              (match (gscope-get env tk)
                (Some [av] av)
                (None []
                      (do
                        (lowering-fail2 g "llvm-ir: undefined value " tk)
                        (mk-aval 0 0 (TInt 64 true)))))
            (= (primitive/cast i64 (get tk 0)) 36)  ; $N
              (get (load avs)
                   (irs/integer (NativeIrErrors :g g) (subslice tk 1 (len tk))))
            (or (= tk "undef") (= tk "poison"))
              (mk-aval 1
                       (lowering-type-slot g
                                           (mut tp))
                       t)
            ; fresh, uninitialized slot (poison is a stricter undef; a fresh
            ; garbage slot is a valid choice for both here)
            (= tk "zeroinitializer")
              (let [slot
                      (lowering-type-slot g
                                          (mut tp))]
                (lowering-zero g
                               slot
                               (lowering-size g
                                              (mut tp)))
                (mk-aval 1 slot t))
            (= tk "true") (mk-aval 0 1 t)
            ; i1 literal, e.g. inside a <...> mask
            (= tk "false") (mk-aval 0 0 t)
            (ty-is-float (mut tp))  ; float literal, e.g. `float 1.0` inside a <...> literal
              ; kind-2 immediates are always f64-shaped, same as EFloat's own
              ; ordinary AVal construction — narrowing to f32 (if needed) happens
              ; the same way any other f64 kind-2 immediate narrows.
              (mk-aval 2
                       (f64-bits (irs/floating (NativeIrErrors :g g) tk))
                       (TFloat 64))
            :else  ; integer literal (also covers negative)
              ; av-slot! sign-extends an immediate across a slot wider than 8 bytes
              ; (the i128 marker type), so a literal needs no special case here.
              (mk-aval 0 (irs/integer (NativeIrErrors :g g) tk) t)))))

; an inline vector-constant literal: `< TY V0, TY V1, ... >`, tokp on entry
; pointing at "<". Used pervasively as an operand throughout the corpus (icmp/
; select/shl/or/fadd comparands and shuffle index masks) — always homogeneous,
; always plain per-element literals (never %name/$N).
(defn ir-lit-vec! [(R NativeLowering)] [(irctx (ptr R))
                                        (toks (ptr (ArrayList (slice u8))))
                                        (tokp (ptr i64))
                                        (t Type)] (-> AVal)
  (let [g irctx
        envp (.envp (lowering-inputs irctx))]
    (set! tokp (primitive/iadd (load tokp) 1))  ; skip "<"
    (match t
      (TVec [elemp lanes]
            (let [lb (lowering-size g elemp)
                  (mut tp)
                    (: t
                       Type)
                  (mut k) 0]
              (let [dslot
                      (lowering-type-slot g
                                          (mut tp))]
                (loop (if (>= (load k) (extent-value lanes))
                          (break)
                          (do
                            (let [ety (ir-parse-type irctx toks tokp)
                                  eav0
                                    (ir-value irctx
                                              (load envp)
                                              (get (load toks) (load tokp))
                                              ety)
                                  ; float literals always resolve as f64 kind-2
                                  ; immediates (matching EFloat's own AVal
                                  ; convention) — narrow to the element's actual
                                  ; declared width/type before storing.
                                  eav (lowering-cast g ety eav0)]
                              (set! tokp (primitive/iadd (load tokp) 1))
                              (lowering-store g
                                              eav
                                              (primitive/iadd dslot
                                                              (primitive/imul (load k)
                                                                              lb))))
                            (set! k (primitive/iadd (load k) 1)))))
                (set! tokp (primitive/iadd (load tokp) 1))
                ; skip ">"
                (mk-aval 1 dslot t))))
      (_ (do
           (lowering-fail g "llvm-ir: vector literal on non-vector type")
           (mk-aval 0 0 t))))))

; resolve a value token at the current stream position, advancing tokp past
; it — either a single token (the common case, same as ir-value) or a whole
; inline vector literal (ir-lit-vec!, several tokens). Every op below that
; parses a VALUE (as opposed to a plain SSA-name binding target) uses this
; instead of ir-value directly, so `<i32 1, i32 2, ...>`-shaped operands work
; anywhere a %name/$N/undef/zeroinitializer/integer-literal would.
(defn ir-value-adv! [(R NativeLowering)] [(irctx (ptr R))
                                          (toks (ptr (ArrayList (slice u8))))
                                          (tokp (ptr i64))
                                          (t Type)] (-> AVal)
  (let [envp (.envp (lowering-inputs irctx))]
    (if (= (get (load toks) (load tokp)) "<")
        (ir-lit-vec! irctx toks tokp t)
        (let [av (ir-value irctx (load envp) (get (load toks) (load tokp)) t)]
          (set! tokp (primitive/iadd (load tokp) 1))
          av))))

; parse an IR type token in the context of (result type, arg types).
; tokp = index of the first token of the type; returns the Type and advances
; *tokp past it. Handles $ret/$tN/i1/i8/i16/i32/i64/float/double/ptr and
; "{ ... }" / "< N x T >" forms (mapped to synthetic Coil types).
(defn ir-parse-type [(R NativeLowering)] [(irctx (ptr R))
                                          (toks (ptr (ArrayList (slice u8))))
                                          (tokp (ptr i64))] (-> Type)
  (let [g irctx
        result (.result (lowering-inputs irctx))
        argtys (.argtysp (lowering-inputs irctx))]
    (let [context
            (irs/TypeContext
              :allocator (lowering-allocator g)
              :result result
              :arguments argtys
              :errors (NativeIrErrors :g g))]
      (irs/read-type context toks tokp))))

(defn lower-ir! [(R NativeLowering)] [(g (ptr R))
                                      (result Type)
                                      (args (ptr (ArrayList Expr)))
                                      (body (slice u8))] (-> AVal)
  (let [a (lowering-allocator g)
        (mut avs) (ArrayList::new [AVal] a)
        (mut argtys) (ArrayList::new [Type] a)
        n (len (load args))]
    (for [i 0 n]
      (let [av (lowering-expression g (layout-at args i))]
        (push! (mut avs) av)
        (push! (mut argtys) (av-ty av))))
    (let [avsp (box-al a (load avs))
          argtysp (box-al a (load argtys))
          (mut envp) (gscope-nil a)
          irctx
            (do
              (store! (lowering-inputs g)
                      (IrInputs
                        :envp (primitive/cast (ptr (ptr GScope)) (mut envp))
                        :avsp avsp
                        :argtysp argtysp
                        :result result))
              g)
          (mut retp) (mk-aval 0 0 (TInt 64 true))
          (mut donep) false
          blen (len body)
          (mut pos) 0]
      (loop (if (>= (load pos) blen)
                (break)
                (do
                  (let [(mut eol) (load pos)]
                    (loop (if (or (>= (load eol) blen)
                                  (= (primitive/cast i64
                                                     (get body
                                                          (load eol)))
                                     10))
                              (break)
                              (set! eol (primitive/iadd (load eol) 1))))
                    (let [line (subslice body (load pos) (load eol))]
                      (set! pos (primitive/iadd (load eol) 1))
                      (unless (= (len line) 0)
                        (if donep
                            (lowering-fail2 g "llvm-ir: code after ret: " line)
                            (lowering-ir-line irctx (mut retp) (mut donep) line)))))
                  0)))
      (unless donep (lowering-fail g "llvm-ir: body did not ret"))
      retp)))

; An SSA instruction keeps the line's captured allocator/environment together
; with its tokens and identity. Construction does not parse operands or select
; a target operation; native dispatch keeps that order.
(defstruct IrInstruction
  [(allocator (dyn Allocator))
   (environment (ptr (ptr GScope)))
   (tokens (ptr (ArrayList (slice u8))))
   (name (slice u8))
   (opcode (slice u8))])

(defn ir-bind! [(R NativeLowering)] [(g (ptr R))
                                     (envp (ptr (ptr GScope)))
                                     (name (slice u8))
                                     (av AVal)] (-> i64)
  (set! envp (gscope-put (lowering-allocator g) (load envp) name av))
  0)

(defn ir-read-shuffle-mask! [(R NativeLowering)] [(g (ptr R))
                                                  (a (dyn Allocator))
                                                  (toks (ptr (ArrayList (slice u8))))
                                                  (tokp (ptr i64))
                                                  (n i64)]
  (-> (ptr (ArrayList i64)))
  (irs/read-mask a (NativeIrErrors :g g) toks tokp n))

(defn ir-extract-value! [(R NativeLowering)] [(irctx (ptr R))
                                              (instruction (ref IrInstruction))]
  (-> i64)
  (let [g irctx
        a (.allocator instruction)
        envp (.environment instruction)
        toks (.tokens instruction)
        t0 (.name instruction)]
    (let [(mut tokp) 3]
      (let [aggty (ir-parse-type irctx toks (mut tokp))
            vtk (get (load toks) tokp)
            idx
              (irs/integer (NativeIrErrors :g irctx)
                           (get (load toks)
                                (primitive/iadd tokp 1)))
            av (ir-value irctx (load envp) vtk aggty)
            (mut atp) aggty]
        (let [(mut offp) (zeroed i64)
              ety (lowering-aggregate-element g (mut atp) idx (mut offp))
              (mut etp) ety]
          (let [eslot (lowering-type-slot g (mut etp))]
            (lowering-copy g
                           eslot
                           (primitive/iadd (lowering-value-slot g av)
                                           offp)
                           (lowering-size g (mut etp)))
            (set! envp
                  (gscope-put a
                              (load envp)
                              t0
                              (mk-aval 1 eslot ety)))
            0))))))

(defn ir-insert-value! [(R NativeLowering)] [(irctx (ptr R))
                                             (instruction (ref IrInstruction))]
  (-> i64)
  (let [g irctx
        a (.allocator instruction)
        envp (.environment instruction)
        toks (.tokens instruction)
        t0 (.name instruction)]
    (let [(mut tokp) 3]
      (let [aggty (ir-parse-type irctx toks (mut tokp))
            aggtk (get (load toks) tokp)]
        (set! tokp (primitive/iadd tokp 1))
        (let [aggav (ir-value irctx (load envp) aggtk aggty)
              elty (ir-parse-type irctx toks (mut tokp))
              eltk (get (load toks) tokp)
              idx
                (irs/integer (NativeIrErrors :g irctx)
                             (get (load toks)
                                  (primitive/iadd tokp 1)))
              eav (ir-value irctx (load envp) eltk elty)
              (mut atp) aggty]
          (let [dslot (lowering-type-slot g (mut atp))
                (mut offp) (zeroed i64)]
            (lowering-copy g
                           dslot
                           (lowering-value-slot g aggav)
                           (lowering-size g (mut atp)))
            (lowering-aggregate-element g (mut atp) idx (mut offp))
            (lowering-store g
                            eav
                            (primitive/iadd dslot
                                            offp))
            (set! envp
                  (gscope-put a
                              (load envp)
                              t0
                              (mk-aval 1 dslot aggty)))
            0))))))

(defn ir-shuffle-vector! [(R NativeLowering)] [(irctx (ptr R))
                                               (instruction (ref IrInstruction))]
  (-> i64)
  (let [g irctx
        a (.allocator instruction)
        envp (.environment instruction)
        toks (.tokens instruction)
        t0 (.name instruction)]
    (let [(mut tokp) 3]
      (let [vty (ir-parse-type irctx toks (mut tokp))
            vav (ir-value-adv! irctx toks (mut tokp) vty)
            v2ty (ir-parse-type irctx toks (mut tokp))
            v2av (ir-value-adv! irctx toks (mut tokp) v2ty)
            maskty (ir-parse-type irctx toks (mut tokp))]
        (match vty
          (TVec [elemp srclanes]
                (match maskty
                  (TVec [_ dstlanes]
                        (let [lb (lowering-size g elemp)
                              idxs
                                (ir-read-shuffle-mask! irctx
                                                       a
                                                       toks
                                                       (mut tokp)
                                                       (extent-value dstlanes))
                              (mut vtp)
                                (fixed-vec (box-type a
                                                     (load elemp))
                                           (extent-value dstlanes))]
                          (let [dslot
                                  (lowering-type-slot g
                                                      (mut vtp))
                                vsrc (lowering-value-slot g vav)
                                v2src (lowering-value-slot g v2av)]
                            (for [k
                                  0
                                  (extent-value dstlanes)]
                              (let [idx
                                      (load (layout-at idxs
                                                       k))]
                                (if (< idx
                                       (extent-value srclanes))
                                    (lowering-copy g
                                                   (primitive/iadd dslot
                                                                   (primitive/imul k
                                                                                   lb))
                                                   (primitive/iadd vsrc
                                                                   (primitive/imul idx
                                                                                   lb))
                                                   lb)
                                    (lowering-copy g
                                                   (primitive/iadd dslot
                                                                   (primitive/imul k
                                                                                   lb))
                                                   (primitive/iadd v2src
                                                                   (primitive/imul (primitive/isub idx
                                                                                                   (extent-value srclanes))
                                                                                   lb))
                                                   lb))))
                            (ir-bind! g
                                      envp
                                      t0
                                      (mk-aval 1
                                               dslot
                                               vtp)))))
                  (_ (lowering-fail g
                                    "llvm-ir: shufflevector mask must be a vector"))))
          (_ (lowering-fail g "llvm-ir: shufflevector on non-vector")))))))

(defn ir-bitcast! [(R NativeLowering)] [(irctx (ptr R))
                                        (instruction (ref IrInstruction))]
  (-> i64)
  (let [g irctx
        envp (.environment instruction)
        toks (.tokens instruction)
        t0 (.name instruction)]
    (let [(mut tokp) 3]
      (let [srcty (ir-parse-type irctx toks (mut tokp))
            (mut srctp) srcty
            srcav
              (ir-value-adv! irctx
                             toks
                             (mut tokp)
                             srcty)]
        (set! tokp
              (primitive/iadd tokp
                              1))
        ; skip "to"
        (let [dstty (ir-parse-type irctx toks (mut tokp))
              (mut dsttp) dstty]
          (unless (= (lowering-size g
                                    (mut srctp))
                     (lowering-size g (mut dsttp)))
            (lowering-fail g "llvm-ir: bitcast between different-size types"))
          (ir-bind! g
                    envp
                    t0
                    (mk-aval 1 (lowering-value-slot g srcav) dstty)))))))

(defn ir-select! [(R NativeLowering)] [(irctx (ptr R))
                                       (instruction (ref IrInstruction))]
  (-> i64)
  (let [g irctx
        envp (.environment instruction)
        toks (.tokens instruction)
        t0 (.name instruction)]
    (let [(mut tokp) 3]
      (let [condty (ir-parse-type irctx toks (mut tokp))
            condav
              (ir-value-adv! irctx
                             toks
                             (mut tokp)
                             condty)]
        (let [valty (ir-parse-type irctx toks (mut tokp))
              aav
                (ir-value-adv! irctx
                               toks
                               (mut tokp)
                               valty)]
          (let [valty2 (ir-parse-type irctx toks (mut tokp))
                bav
                  (ir-value-adv! irctx
                                 toks
                                 (mut tokp)
                                 valty2)]
            (match valty
              (TVec [elemp lanes]
                    (let [lb (lowering-size g elemp)
                          (mut vtp) valty]
                      (let [dslot (lowering-type-slot g (mut vtp))]
                        (for [k 0 (extent-value lanes)]
                          (let [rav
                                  (lowering-select g
                                                   (ir-lane-av irctx
                                                               condav
                                                               k
                                                               (TBool)
                                                               1)
                                                   (ir-lane-av irctx
                                                               aav
                                                               k
                                                               (load elemp)
                                                               lb)
                                                   (ir-lane-av irctx
                                                               bav
                                                               k
                                                               (load elemp)
                                                               lb))]
                            (lowering-copy g
                                           (primitive/iadd dslot
                                                           (primitive/imul k
                                                                           lb))
                                           (lowering-value-slot g
                                                                rav)
                                           lb)))
                        (ir-bind! g
                                  envp
                                  t0
                                  (mk-aval 1
                                           dslot
                                           valty)))))
              (_ (ir-bind! g
                           envp
                           t0
                           (lowering-select g
                                            condav
                                            aav
                                            bav))))))))))

(defn ir-extend-instruction! [(R NativeLowering)] [(irctx (ptr R))
                                                   (instruction (ref IrInstruction))]
  (-> i64)
  (let [g irctx
        envp (.environment instruction)
        toks (.tokens instruction)
        t0 (.name instruction)
        op (.opcode instruction)]
    (let [(mut tokp) 3]
      (let [srcty (ir-parse-type irctx toks (mut tokp))
            srcav
              (ir-value-adv! irctx
                             toks
                             (mut tokp)
                             srcty)]
        (set! tokp (primitive/iadd tokp 1))
        (let [dstty (ir-parse-type irctx toks (mut tokp))]
          (ir-bind! g
                    envp
                    t0
                    (ir-extend-op! irctx
                                   srcty
                                   srcav
                                   dstty
                                   (= op "zext")
                                   (= op "sext"))))))))

(defn ir-convert-instruction! [(R NativeLowering)] [(irctx (ptr R))
                                                    (instruction (ref IrInstruction))]
  (-> i64)
  (let [g irctx
        envp (.environment instruction)
        toks (.tokens instruction)
        t0 (.name instruction)
        op (.opcode instruction)]
    (let [(mut tokp) 3]
      (let [srcty (ir-parse-type irctx toks (mut tokp))
            srcav
              (ir-value-adv! irctx
                             toks
                             (mut tokp)
                             srcty)]
        (set! tokp (primitive/iadd tokp 1))
        (let [dstty (ir-parse-type irctx toks (mut tokp))]
          (ir-bind! g
                    envp
                    t0
                    (ir-floatconv! irctx
                                   srcty
                                   srcav
                                   dstty
                                   (= op "uitofp")
                                   (= op "fptoui"))))))))

(defn ir-binary-instruction! [(R NativeLowering)] [(irctx (ptr R))
                                                   (instruction (ref IrInstruction))]
  (-> i64)
  (let [g irctx
        envp (.environment instruction)
        toks (.tokens instruction)
        t0 (.name instruction)
        op (.opcode instruction)]
    (let [(mut tokp) 3
          binop (case op "add" 0 "sub" 1 "mul" 2 "and" 7 "or" 8 "xor" 9 10)]
      (let [ty (ir-parse-type irctx toks (mut tokp))
            lav (ir-value-adv! irctx toks (mut tokp) ty)]
        (let [rav (ir-value-adv! irctx toks (mut tokp) ty)]
          (match ty
            (TVec [elemp lanes]
                  (let [lb (lowering-size g elemp)
                        (mut vtp) ty]
                    (let [dslot (lowering-type-slot g (mut vtp))]
                      (for [k 0 (extent-value lanes)]
                        (let [rlv
                                (lowering-binary g
                                                 binop
                                                 (ir-lane-av irctx
                                                             lav
                                                             k
                                                             (load elemp)
                                                             lb)
                                                 (ir-lane-av irctx
                                                             rav
                                                             k
                                                             (load elemp)
                                                             lb))]
                          (lowering-copy g
                                         (primitive/iadd dslot
                                                         (primitive/imul k
                                                                         lb))
                                         (lowering-value-slot g
                                                              rlv)
                                         lb)))
                      (ir-bind! g
                                envp
                                t0
                                (mk-aval 1 dslot ty)))))
            (_ (ir-bind! g
                         envp
                         t0
                         (lowering-binary g binop lav rav)))))))))

(defn ir-divide-instruction! [(R NativeLowering)] [(irctx (ptr R))
                                                   (instruction (ref IrInstruction))]
  (-> i64)
  (let [g irctx
        envp (.environment instruction)
        toks (.tokens instruction)
        t0 (.name instruction)
        op (.opcode instruction)]
    (let [(mut tokp) 3
          binop (case op "sdiv" 3 "srem" 4 "udiv" 5 6)]
      (let [ty (ir-parse-type irctx toks (mut tokp))]
        (match ty
          (TVec [_ _]
                (do
                  (lowering-fail2 g
                                  "llvm-ir: vector int div/rem not supported: "
                                  op)
                  0))
          (_ (let [lav
                     (ir-value-adv! irctx
                                    toks
                                    (mut tokp)
                                    ty)]
               (let [rav
                       (ir-value-adv! irctx
                                      toks
                                      (mut tokp)
                                      ty)]
                 (ir-bind! g
                           envp
                           t0
                           (lowering-binary g
                                            binop
                                            lav
                                            rav))))))))))

; Both native targets parse comparisons in the same order and build a byte per
; vector mask lane. Register selection and the wide integer comparison remain
; target operations; scalar predicate policy is shared above.
(defn ir-compare-scalar! [(R NativeLowering)] [(g (ptr R))
                                               (floating bool)
                                               (pred (slice u8))
                                               (lav AVal)
                                               (rav AVal)] (-> AVal)
  (if floating
      (ir-fcmp-scalar! g pred lav rav)
      (ir-icmp-scalar! g pred lav rav)))

(defn ir-compare-instruction! [(R NativeLowering)] [(irctx (ptr R))
                                                    (instruction (ref IrInstruction))]
  (-> i64)
  (let [a (.allocator instruction)
        envp (.environment instruction)
        toks (.tokens instruction)
        name (.name instruction)
        floating (= (.opcode instruction) "fcmp")
        pred (get (load toks) 3)
        (mut tokp) 4]
    (let [ty (ir-parse-type irctx toks (mut tokp))
          lav (ir-value-adv! irctx toks (mut tokp) ty)]
      (let [rav (ir-value-adv! irctx toks (mut tokp) ty)]
        (match ty
          (TVec [elemp lanes]
                (let [lb (lowering-size irctx elemp)
                      maskty
                        (fixed-vec (box-type a (TBool)) (extent-value lanes))
                      (mut masktp) maskty]
                  (let [dslot (lowering-type-slot irctx (mut masktp))]
                    (for [k 0 (extent-value lanes)]
                      (let [bav
                              (ir-compare-scalar! irctx
                                                  floating
                                                  pred
                                                  (ir-lane-av irctx
                                                              lav
                                                              k
                                                              (load elemp)
                                                              lb)
                                                  (ir-lane-av irctx
                                                              rav
                                                              k
                                                              (load elemp)
                                                              lb))]
                        (lowering-store-mask-lane irctx
                                                  bav
                                                  (primitive/iadd dslot k))))
                    (ir-bind! irctx envp name (mk-aval 1 dslot maskty)))))
          (TSlice [_]
                  (ir-bind! irctx
                            envp
                            name
                            (if floating
                                (ir-fcmp-scalar! irctx pred lav rav)
                                (lowering-wide-compare irctx pred lav rav))))
          (_ (ir-bind! irctx
                       envp
                       name
                       (ir-compare-scalar! irctx floating pred lav rav))))))))

; Sources are materialized once, before traversing lanes. Target callbacks only
; emit the same FP loads, arithmetic and stores; they allocate no frame slots.
(defn ir-vector-float! [(R NativeLowering)] [(g (ptr R))
                                             (op i64)
                                             (dst i64)
                                             (asrc i64)
                                             (bsrc i64)
                                             (lanes i64)
                                             (lb i64)] (-> i64)
  (for [k 0 lanes]
    (lowering-load-float g 0 (primitive/iadd asrc (primitive/imul k lb)) lb)
    (lowering-load-float g 1 (primitive/iadd bsrc (primitive/imul k lb)) lb)
    (lowering-float-op g op (primitive/imul lb 8))
    (lowering-store-float g 0 (primitive/iadd dst (primitive/imul k lb)) lb))
  0)

(defn ir-float-instruction! [(R NativeLowering)] [(irctx (ptr R))
                                                  (instruction (ref IrInstruction))]
  (-> i64)
  (let [a (.allocator instruction)
        envp (.environment instruction)
        toks (.tokens instruction)
        t0 (.name instruction)
        op (.opcode instruction)
        (mut tokp) 3
        opn (cond (= op "fadd") 0 (= op "fsub") 1 (= op "fmul") 2 :else 3)]
    (let [vty (ir-parse-type irctx toks (mut tokp))
          aav (ir-value-adv! irctx toks (mut tokp) vty)
          bav (ir-value-adv! irctx toks (mut tokp) vty)
          (mut vtp) vty]
      (match vty
        (TVec [elem lanes]
              (let [lb (lowering-size irctx elem)
                    dslot (lowering-type-slot irctx (mut vtp))]
                (ir-vector-float! irctx
                                  opn
                                  dslot
                                  (lowering-value-slot irctx aav)
                                  (lowering-value-slot irctx bav)
                                  (extent-value lanes)
                                  lb)
                (set! envp (gscope-put a (load envp) t0 (mk-aval 1 dslot vty)))
                0))
        (TFloat [bits]
                (let [dslot (lowering-type-slot irctx (mut vtp))]
                  (lowering-value-float irctx aav 0)
                  (lowering-value-float irctx bav 1)
                  (lowering-float-op irctx opn bits)
                  (lowering-store-float irctx 0 dslot (/ bits 8))
                  (set! envp
                        (gscope-put a (load envp) t0 (mk-aval 1 dslot vty)))
                  0))
        (_ (lowering-fail irctx "llvm-ir: float op on unsupported type"))))))

; Address-register handles stay opaque here. Preserve the base across vector
; lanes; the scalar result may reuse it. Allocation follows address emission
; for scalars and precedes it for vectors, as required by the original lowering.
(defn ir-gep! [(R NativeLowering)] [(irctx (ptr R))
                                    (instruction (ref IrInstruction))] (-> i64)
  (let [a (.allocator instruction)
        envp (.environment instruction)
        toks (.tokens instruction)
        t0 (.name instruction)
        (mut tokp) 3]
    (let [elemty (ir-parse-type irctx toks (mut tokp))
          (mut elemtp) elemty]
      (set! tokp (primitive/iadd tokp 1))  ; skip "ptr"
      (let [baseav
              (ir-value-adv! irctx
                             toks
                             (mut tokp)
                             (TPtr (box-type a (TInt 8 true))))
            idxty (ir-parse-type irctx toks (mut tokp))
            esz (lowering-size irctx (mut elemtp))]
        (match idxty
          (TVec [ielemp lanes]
                (let [idxav (ir-value-adv! irctx toks (mut tokp) idxty)
                      ielb (lowering-size irctx ielemp)
                      ptrty
                        (fixed-vec (box-type a (TPtr (box-type a elemty)))
                                   (extent-value lanes))
                      (mut ptp) ptrty]
                  (let [dslot (lowering-type-slot irctx (mut ptp))
                        base (lowering-address-base irctx baseav)]
                    (for [k 0 (extent-value lanes)]
                      (let [reg
                              (lowering-address-offset irctx
                                                       base
                                                       (ir-lane-av irctx
                                                                   idxav
                                                                   k
                                                                   (load ielemp)
                                                                   ielb)
                                                       esz
                                                       true)]
                        (lowering-store-word irctx
                                             reg
                                             (primitive/iadd dslot
                                                             (primitive/imul k
                                                                             8)))))
                    (ir-bind! irctx envp t0 (mk-aval 1 dslot ptrty)))))
          (_ (let [idxav (ir-value-adv! irctx toks (mut tokp) idxty)
                   base (lowering-address-base irctx baseav)
                   reg (lowering-address-offset irctx base idxav esz false)]
               (let [slot (lowering-frame-slot irctx 8 8)]
                 (lowering-store-word irctx reg slot)
                 (ir-bind! irctx
                           envp
                           t0
                           (mk-aval 1 slot (TPtr (box-type a elemty))))))))))
    0))

(defn ir-insert-element! [(R NativeLowering)] [(irctx (ptr R))
                                               (instruction (ref IrInstruction))]
  (-> i64)
  (let [a (.allocator instruction)
        envp (.environment instruction)
        toks (.tokens instruction)
        t0 (.name instruction)
        (mut tokp) 3]
    (let [vty (ir-parse-type irctx toks (mut tokp))
          aggtk (get (load toks) tokp)]
      (set! tokp (primitive/iadd tokp 1))
      (let [aggav (ir-value irctx (load envp) aggtk vty)
            elty (ir-parse-type irctx toks (mut tokp))
            eav (ir-value irctx (load envp) (get (load toks) tokp) elty)
            k
              (irs/integer (NativeIrErrors :g irctx)
                           (get (load toks) (primitive/iadd tokp 2)))
            (mut vtp) vty
            (mut etp) elty]
        (let [lb (lowering-size irctx (mut etp))
              dslot (lowering-type-slot irctx (mut vtp))]
          (lowering-copy irctx
                         dslot
                         (lowering-value-slot irctx aggav)
                         (lowering-size irctx (mut vtp)))
          (lowering-value-float irctx eav 0)
          (lowering-store-float irctx
                                0
                                (primitive/iadd dslot (primitive/imul k lb))
                                lb)
          (set! envp (gscope-put a (load envp) t0 (mk-aval 1 dslot vty)))
          0)))))
