; src/compiler/backend/normalize.coil — self-host Coil compiler, normalize module.

(module coil.compiler.normalize)
(import "coil.primitive" :as primitive)
(import "coil.compiler.trace" :as tr)
(import "coil.alloc" :as alloc :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.io" :use *)
(import "coil.control" :use *)
(import "coil.try" :use *)
(import "coil.compiler.ffi" :use *)
(import "coil.reader" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.astdump" :use *)
(import "coil.compiler.codegen" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.resolve" :use *)

(defstruct NumRes [(val i64) (len i64)])

(defstruct ScanRes [(fam i64) (num i64) (endd i64)])

(defstruct NzBlock [(cat i64) (name (slice u8)) (body (ArrayList (slice u8)))])

(defstruct NzParsed
  [(header (ArrayList (slice u8))) (blocks (ArrayList NzBlock))])

(defstruct Renum
  [(g (ArrayList i64))
   (st (ArrayList i64))
   (cs (ArrayList i64))
   (lv (ArrayList i64))])

(defstruct AttrDef [(old i64) (body (slice u8))])

(defn nz-b [(s (slice u8)) (i i64)] (-> i64)
  (primitive/cast i64 (get s i)))

(defn nz-digit? [(c i64)] (-> bool)
  (and (>= c 48) (<= c 57)))

(defn nz-alnum? [(c i64)] (-> bool)
  (or (and (>= c 48) (<= c 57))
      (and (>= c 65) (<= c 90))
      (and (>= c 97) (<= c 122))))

(defn nz-ident? [(c i64)] (-> bool)
  (or (nz-alnum? c) (= c 95)))

(defn nz-sym? [(c i64)] (-> bool)
  (or (nz-alnum? c)
      (= c 95)
      (= c 46)
      (= c 36)
      (= c
         45)))

(defn nz-contains? [(hay (slice u8)) (needle (slice u8))] (-> bool)
  (match (find hay needle) (Some [_] true) (None [] false)))

(defn nz-find-i64 [(l (ArrayList i64)) (x i64)] (-> i64)
  (let [n (len l)
        (mut i) 0
        (mut res) -1]
    (loop (if (or (>= (load i) n) (>= (load res) 0))
              (break)
              (if (= (get l (load i)) x)
                  (set! res (load i))
                  (set! i (primitive/iadd (load i) 1)))))
    (load res)))

(defn nz-all-digits? [(s (slice u8))] (-> bool)
  (let [n (len s)
        (mut i) 0
        (mut ok) true]
    (loop (if (or (>= (load i) n) (not (load ok)))
              (break)
              (if (nz-digit? (nz-b s (load i)))
                  (do (set! i (primitive/iadd (load i) 1)) 0)
                  (do
                    (set! ok false)
                    0))))
    (and (> n 0) (load ok))))

(defn nz-leading-number [(s (slice u8)) (start i64)] (-> NumRes)
  (let [n (len s)
        (mut j) start
        (mut v) 0]
    (loop (if (or (>= (load j) n) (not (nz-digit? (nz-b s (load j)))))
              (break)
              (do
                (set! v
                      (primitive/iadd (primitive/imul (load v) 10)
                                      (primitive/isub (nz-b s (load j)) 48)))
                (set! j (primitive/iadd (load j) 1)))))
    (let [(mut r) (zeroed NumRes)]
      (set! (.val r) (load v))
      (set! (.len r) (primitive/isub (load j) start))
      r)))

(defn nz-parse-int [(s (slice u8))] (-> i64)
  (let [(mut r) (nz-leading-number s 0)] (.val r)))

(defn nz-split-lines [(a (dyn Allocator)) (text (slice u8))]
  (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] a)
        n (len text)
        (mut start) 0
        (mut i) 0]
    (loop (cond (> (load i) n) (break)
                (= (load i) n)
                  (do
                    (push! (mut out) (subslice text (load start) (load i)))
                    (set! i (primitive/iadd (load i) 1)))
                (= (nz-b text (load i)) 10)
                  (do
                    (push! (mut out) (subslice text (load start) (load i)))
                    (set! start (primitive/iadd (load i) 1))
                    (set! i (primitive/iadd (load i) 1)))
                :else (set! i (primitive/iadd (load i) 1))))
    (load out)))

(defn nz-first-token [(l (slice u8))] (-> (slice u8))
  (match (find l " ") (Some [i] (subslice l 0 i)) (None [] l)))

(defn nz-at-symbol [(l (slice u8))] (-> (slice u8))
  (match (find l "@")
    (None [] l)
    (Some [at]
          (let [n (len l)
                (mut j) (primitive/iadd at 1)]
            (if (and (< (load j) n)
                     (= (nz-b l (load j)) 34))
                (do
                  (set! j (primitive/iadd (load j) 1))
                  (loop (if (or (>= (load j) n)
                                (= (nz-b l (load j)) 34))
                            (break)
                            (set! j (primitive/iadd (load j) 1))))
                  (when (< (load j) n) (set! j (primitive/iadd (load j) 1)))
                  (subslice l at (load j)))
                (do
                  (loop (if (or (>= (load j) n)
                                (not (nz-sym? (nz-b l (load j)))))
                            (break)
                            (set! j (primitive/iadd (load j) 1))))
                  (subslice l at (load j))))))))

(defn nz-pos-define-name? [(name (slice u8))] (-> bool)
  (let [pre "@__coil_llvm_ir_"
        pl (len pre)]
    (if (or (not (starts-with name pre)) (<= (len name) pl))
        false
        (nz-all-digits? (subslice name pl (len name))))))

; ---- scan_positional -------------------------------------------------------
(defn nz-mk-scan [(fam i64) (num i64) (endd i64)] (-> ScanRes)
  (let [(mut s) (zeroed ScanRes)]
    (set! (.fam s) fam)
    (set! (.num s) num)
    (set! (.endd s) endd)
    s))

(defn nz-try-fam [(s (slice u8)) (i i64) (pre (slice u8)) (fam i64)]
  (-> (Option ScanRes))
  (let [n (len s)
        pl (len pre)
        ps (primitive/iadd i 1)]
    (if (or (> (primitive/iadd ps pl) n)
            (not (= (subslice s ps (primitive/iadd ps pl)) pre)))
        (None [ScanRes])
        (let [(mut nr) (nz-leading-number s (primitive/iadd ps pl))]
          (if (= (.len nr) 0)
              (None [ScanRes])
              (let [endd (primitive/iadd (primitive/iadd ps pl) (.len nr))]
                (if (or (>= endd n) (not (nz-ident? (nz-b s endd))))
                    (Some (nz-mk-scan fam (.val nr) endd))
                    (None [ScanRes]))))))))

(defn nz-scan-positional [(s (slice u8)) (i i64)] (-> (Option ScanRes))
  (if (or (>= i (len s)) (!= (nz-b s i) 64))
      (None [ScanRes])
      (match (nz-try-fam s i "g." 0)
        (Some [r] (Some r))
        (None []
              (match (nz-try-fam s i "str." 1)
                (Some [r] (Some r))
                (None []
                      (match (nz-try-fam s i "cstr." 2)
                        (Some [r] (Some r))
                        (None [] (nz-try-fam s i "__coil_llvm_ir_" 3)))))))))

; ---- renumber map (4 first-encounter lists) --------------------------------
(defn nz-renum-assign! [(r (ptr Renum)) (fam i64) (old i64)] (-> i64)
  (cond (= fam 0)
          (when (< (nz-find-i64 (.g r) old) 0)
            (push! (mut (.g r))
                   old))
        (= fam 1)
          (when (< (nz-find-i64 (.st r) old) 0)
            (push! (mut (.st r))
                   old))
        (= fam 2)
          (when (< (nz-find-i64 (.cs r) old) 0)
            (push! (mut (.cs r))
                   old))
        (< (nz-find-i64 (.lv r) old) 0) (push! (mut (.lv r)) old)
        :else 0))

(defn nz-renum-lookup [(r (ptr Renum)) (fam i64) (old i64)] (-> i64)
  (cond (= fam 0) (nz-find-i64 (.g r) old)
        (= fam 1) (nz-find-i64 (.st r) old)
        (= fam 2) (nz-find-i64 (.cs r) old)
        :else (nz-find-i64 (.lv r) old)))

; Edits retain offsets and replacement numbers, never copied unchanged text.
(defstruct NzEdit [(start i64) (end i64) (family i64) (value i64)])

(defstruct NzPositional [(start i64) (end i64) (family i64) (value i64)])

(defn nz-quoted-end [(text (slice u8)) (start i64)] (-> i64)
  (let [n (len text)
        (mut i) (+ start 1)]
    (loop (if (or (>= (load i) n)
                  (= (nz-b text (load i)) 34)
                  (= (nz-b text (load i)) 10))
              (break)
              (set! i (+ (load i) 1))))
    (if (and (< (load i) n) (= (nz-b text (load i)) 34))
        (+ (load i) 1)
        (load i))))

; LLVM prints literal quotes and newlines as hex escapes. A quoted byte string
; or identifier is one lexical unit, so its contents cannot introduce a symbol.
(defn nz-next-positional [(text (slice u8)) (start i64)]
  (-> (Option NzPositional))
  (block :found
    (let [n (len text)
          (mut i) start]
      (loop (if (>= (load i) n)
                (break)
                (cond (= (nz-b text (load i)) 34)
                        (set! i (nz-quoted-end text (load i)))
                      (= (nz-b text (load i)) 64)
                        (match (nz-scan-positional text (load i))
                          (Some [s]
                                (break
                                  :found
                                    (Some (NzPositional
                                            :start (load i)
                                            :end (.endd s)
                                            :family (.fam s)
                                            :value (.num s)))))
                          (None [] (set! i (+ (load i) 1))))
                      :else (set! i (+ (load i) 1))))))
    (None [NzPositional])))

(defn nz-decimal-width [(value i64)] (-> i64)
  (let [(mut n) value
        (mut width) 1]
    (loop (if (< (load n) 10)
              (break)
              (do (set! n (/ (load n) 10)) (set! width (+ (load width) 1)))))
    (load width)))

(defn nz-edit-width [(edit NzEdit)] (-> i64)
  (+ (nz-decimal-width (.value edit))
     (if (< (.family edit) 0)
         1
         (if (= (.family edit) 3)
             (len "@__coil_llvm_ir_")
             (+ 2 (len (nz-fam-str (.family edit))))))))

(defn nz-apply-edits [(a (dyn Allocator))
                      (text (slice u8))
                      (edits (ArrayList NzEdit))] (-> (slice u8))
  (if (= (len edits) 0)
      text
      (let [(mut size) (len text)
            (mut out) (ArrayList::new [u8] a)
            (mut previous) 0]
        (for [i 0 (len edits)]
          (let [edit (get edits i)]
            (set! size
                  (+ (- (load size) (- (.end edit) (.start edit)))
                     (nz-edit-width edit)))))
        (reserve! (mut out) (load size))
        (for [i 0 (len edits)]
          (let [edit (get edits i)]
            (nz-push-str! (mut out)
                          (subslice text (load previous) (.start edit)))
            (if (< (.family edit) 0)
                (do
                  (push! (mut out) (: 35 u8))
                  (push-mag (mut out) (.value edit)))
                (nz-emit-renamed (mut out) (.family edit) (.value edit)))
            (set! previous (.end edit))))
        (nz-push-str! (mut out) (subslice text (load previous) (len text)))
        (slice (load out)))))

(defn nz-assign-line! [(r (ptr Renum)) (line (slice u8))] (-> i64)
  (let [(mut at) 0]
    (loop (match (nz-next-positional line (load at))
            (None [] (break))
            (Some [s]
                  (do
                    (nz-renum-assign! r (.family s) (.value s))
                    (set! at (.end s))))))
    0))

(defn nz-name-of [(blocks (ArrayList NzBlock)) (idx i64)] (-> (slice u8))
  (let [(mut b) (: (get blocks idx) NzBlock)] (.name b)))

(defn nz-pnum [(blocks (ArrayList NzBlock)) (idx i64) (r (ptr Renum))] (-> i64)
  (let [name (nz-name-of blocks idx)
        (mut nr) (nz-leading-number name (len "@__coil_llvm_ir_"))]
    (let [pos (nz-find-i64 (.lv r) (.val nr))]
      (if (< pos 0) 9223372036854775807 pos))))

(defn nz-assign-block-bodies [(r (ptr Renum))
                              (blocks (ArrayList NzBlock))
                              (idx i64)] (-> i64)
  (let [(mut b) (: (get blocks idx) NzBlock)]
    (let [body (.body b)
          n (len body)
          (mut i) 0]
      (loop (if (>= (load i) n)
                (break)
                (do
                  (nz-assign-line! r (get body (load i)))
                  (set! i (primitive/iadd (load i) 1))))))
    0))

(defn nz-assign-idxs [(r (ptr Renum))
                      (blocks (ArrayList NzBlock))
                      (idxs (ArrayList i64))] (-> i64)
  (let [n (len idxs)]
    (for [i 0 n]
      (nz-assign-block-bodies r blocks (get idxs i)))
    0))

(defn nz-sort-idx-by-name [(a (dyn Allocator))
                           (blocks (ArrayList NzBlock))
                           (idxs (ArrayList i64))] (-> (ArrayList i64))
  (let [n (len idxs)
        (mut used) (ArrayList::new [bool] a)
        (mut out) (ArrayList::new [i64] a)]
    (for [k 0 n]
      (push! (mut used) false))
    (let [(mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (let [(mut best) -1]
                    (for [bi 0 n]
                      (when (and (not (get (load used) bi))
                                 (or (< (load best)
                                        0)
                                     (str-lt (nz-name-of blocks
                                                         (get idxs
                                                              bi))
                                             (nz-name-of blocks
                                                         (get idxs
                                                              (load best))))))
                        (set! best bi)))
                    (set! (mut used) (load best) true)
                    (push! (mut out) (get idxs (load best))))
                  (set! c (primitive/iadd (load c) 1))))))
    (load out)))

(defn nz-sort-idx-by-pnum [(a (dyn Allocator))
                           (blocks (ArrayList NzBlock))
                           (idxs (ArrayList i64))
                           (r (ptr Renum))] (-> (ArrayList i64))
  (let [n (len idxs)
        (mut used) (ArrayList::new [bool] a)
        (mut out) (ArrayList::new [i64] a)]
    (for [k 0 n]
      (push! (mut used) false))
    (let [(mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (let [(mut best) -1]
                    (for [bi 0 n]
                      (when (and (not (get (load used) bi))
                                 (or (< (load best)
                                        0)
                                     (< (nz-pnum blocks
                                                 (get idxs bi)
                                                 r)
                                        (nz-pnum blocks
                                                 (get idxs
                                                      (load best))
                                                 r))))
                        (set! best bi)))
                    (set! (mut used) (load best) true)
                    (push! (mut out) (get idxs (load best))))
                  (set! c (primitive/iadd (load c) 1))))))
    (load out)))

(defn nz-build-renumber [(a (dyn Allocator)) (blocks (ArrayList NzBlock))]
  (-> Renum)
  (let [(mut rstk) (zeroed Renum)]
    (init-fields! rstk (ArrayList::new a) [g st cs lv])
    (let [nb (len blocks)
          (mut stable) (ArrayList::new [i64] a)
          (mut pos) (ArrayList::new [i64] a)]
      (for [k 0 nb]
        (let [(mut b) (: (get blocks k) NzBlock)]
          (when (= (.cat b) 3)
            (if (nz-pos-define-name? (.name b))
                (push! (mut pos) k)
                (push! (mut stable) k)))))
      (nz-assign-idxs (mut rstk)
                      blocks
                      (nz-sort-idx-by-name a blocks (load stable)))
      (nz-assign-idxs (mut rstk)
                      blocks
                      (nz-sort-idx-by-pnum a blocks (load pos) (mut rstk)))
      (let [(mut g2) 0]
        (loop (if (>= (load g2) nb)
                  (break)
                  (do
                    (let [(mut b) (: (get blocks (load g2)) NzBlock)]
                      (when (= (.cat b) 1)
                        (nz-assign-block-bodies (mut rstk) blocks (load g2))))
                    (set! g2 (primitive/iadd (load g2) 1)))))))
    rstk))

; ---- apply_renumber --------------------------------------------------------
(defn nz-push-str! [(out (mut (ArrayList u8))) (s (slice u8))] (-> i64)
  (extend! [u8] (mut out) (data s) (len s))
  0)

(defn nz-fam-str [(fam i64)] (-> (slice u8))
  (if (= fam 0)
      "g"
      (if (= fam 1) "str" "cstr")))

(defn nz-emit-renamed [(out (mut (ArrayList u8))) (fam i64) (newn i64)] (-> i64)
  (if (= fam 3)
      (do (nz-push-str! (mut out) "@__coil_llvm_ir_") (push-mag (mut out) newn))
      (do
        (push! (mut out) (: 64 u8))
        (nz-push-str! (mut out) (nz-fam-str fam))
        (push! (mut out) (: 46 u8))
        (push-mag (mut out) newn))))

(defn nz-apply-renumber [(a (dyn Allocator)) (line (slice u8)) (r (ptr Renum))]
  (-> (slice u8))
  (let [(mut edits) (ArrayList::new [NzEdit] a)
        (mut at) 0]
    (loop (match (nz-next-positional line (load at))
            (None [] (break))
            (Some [s]
                  (let [newn (nz-renum-lookup r (.family s) (.value s))]
                    (when (>= newn 0)
                      (let [edit
                              (NzEdit
                                :start (.start s)
                                :end (.end s)
                                :family (.family s)
                                :value newn)]
                        (when (or (!= newn (.value s))
                                  (!= (nz-edit-width edit)
                                      (- (.end s) (.start s))))
                          (push! (mut edits) edit)
                          0))
                      0)
                    (set! at (.end s))))))
    (nz-apply-edits a line (load edits))))

(defn nz-map-apply [(a (dyn Allocator))
                    (body (ArrayList (slice u8)))
                    (r (ptr Renum))] (-> (ArrayList (slice u8)))
  (let [n (len body)
        (mut out) (ArrayList::new [(slice u8)] a)]
    (reserve! (mut out) n)
    (for [i 0 n]
      (push! (mut out) (nz-apply-renumber a (get body i) r)))
    (load out)))

; ---- parse_blocks ----------------------------------------------------------
(defn nz-one-body [(a (dyn Allocator)) (l (slice u8))]
  (-> (ArrayList (slice u8)))
  (let [(mut b) (ArrayList::new [(slice u8)] a)] (push! (mut b) l) (load b)))

(defn nz-push-block! [(a (dyn Allocator))
                      (blocks (mut (ArrayList NzBlock)))
                      (cat i64)
                      (name (slice u8))
                      (body (ArrayList (slice u8)))] (-> i64)
  (let [(mut b) (zeroed NzBlock)]
    (set! (.cat b) cat)
    (set! (.name b) name)
    (set! (.body b) body)
    (push! (mut blocks) b)
    0))

(defn nz-parse-define [(a (dyn Allocator))
                       (blocks (mut (ArrayList NzBlock)))
                       (lines (ArrayList (slice u8)))
                       (nlines i64)
                       (i i64)
                       (l (slice u8))] (-> i64)
  (let [(mut body) (ArrayList::new [(slice u8)] a)
        (mut j) (primitive/iadd i 1)]
    (push! (mut body) l)
    (loop (if (or (>= (load j) nlines) (= (get lines (load j)) "}"))
              (break)
              (do
                (push! (mut body) (get lines (load j)))
                (set! j (primitive/iadd (load j) 1)))))
    (when (< (load j) nlines)
      (push! (mut body) (get lines (load j)))
      (set! j (primitive/iadd (load j) 1)))
    (nz-push-block! a (mut blocks) 3 (nz-at-symbol l) (load body))
    (load j)))

(defn nz-parse-one-block [(a (dyn Allocator))
                          (blocks (mut (ArrayList NzBlock)))
                          (lines (ArrayList (slice u8)))
                          (nlines i64)
                          (i i64)
                          (l (slice u8))] (-> i64)
  (cond (and (= (nz-b l 0) 37) (nz-contains? l "= type"))
          (do
            (nz-push-block! a
                            (mut blocks)
                            0
                            (nz-first-token l)
                            (nz-one-body a l))
            (primitive/iadd i 1))
        (= (nz-b l 0) 64)
          (do
            (nz-push-block! a
                            (mut blocks)
                            1
                            (nz-first-token l)
                            (nz-one-body a l))
            (primitive/iadd i 1))
        (starts-with l "declare")
          (do
            (nz-push-block! a (mut blocks) 2 (nz-at-symbol l) (nz-one-body a l))
            (primitive/iadd i 1))
        (starts-with l "define")
          (nz-parse-define a (mut blocks) lines nlines i l)
        :else
          (do
            (nz-push-block! a (mut blocks) 4 l (nz-one-body a l))
            (primitive/iadd i 1))))

(defn nz-parse-blocks [(a (dyn Allocator)) (text (slice u8))] (-> NzParsed)
  (let [lines (nz-split-lines a text)
        nlines (len lines)
        (mut header) (ArrayList::new [(slice u8)] a)
        (mut blocks) (ArrayList::new [NzBlock] a)
        (mut i) 0]
    (loop (if (or (>= (load i) nlines)
                  (= (len (get lines (load i))) 0))
              (break)
              (do
                (push! (mut header) (get lines (load i)))
                (set! i (primitive/iadd (load i) 1)))))
    (loop (if (>= (load i) nlines)
              (break)
              (let [l (get lines (load i))]
                (if (= (len l) 0)
                    (set! i (primitive/iadd (load i) 1))
                    (set! i
                          (nz-parse-one-block a
                                              (mut blocks)
                                              lines
                                              nlines
                                              (load i)
                                              l))))))
    (let [(mut p) (zeroed NzParsed)]
      (set! (.header p) (load header))
      (set! (.blocks p) (load blocks))
      p)))

; ---- block sort by (cat, name) ---------------------------------------------
(defn nz-block-lt [(blocks (ArrayList NzBlock)) (i i64) (j i64)] (-> bool)
  (let [(mut bi) (: (get blocks i) NzBlock)
        (mut bj) (: (get blocks j) NzBlock)]
    (let [ci (.cat bi)
          cj (.cat bj)]
      (if (< ci cj) true (if (> ci cj) false (str-lt (.name bi) (.name bj)))))))

(defn nz-sort-blocks [(a (dyn Allocator)) (blocks (ArrayList NzBlock))]
  (-> (ArrayList NzBlock))
  (let [n (len blocks)
        (mut used) (ArrayList::new [bool] a)
        (mut out) (ArrayList::new [NzBlock] a)]
    (for [k 0 n]
      (push! (mut used) false))
    (let [(mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (let [(mut best) -1]
                    (for [bi 0 n]
                      (when (and (not (get (load used) bi))
                                 (or (< (load best)
                                        0)
                                     (nz-block-lt blocks
                                                  bi
                                                  (load best))))
                        (set! best bi)))
                    (set! (mut used) (load best) true)
                    (push! (mut out) (get blocks (load best))))
                  (set! c (primitive/iadd (load c) 1))))))
    (load out)))

; ---- attribute-group renumber ----------------------------------------------
(defn nz-body-of [(defs (ArrayList AttrDef)) (idx i64)] (-> (slice u8))
  (let [(mut d) (: (get defs idx) AttrDef)] (.body d)))

(defn nz-sort-attrs [(a (dyn Allocator)) (defs (ArrayList AttrDef))]
  (-> (ArrayList AttrDef))
  (let [n (len defs)
        (mut used) (ArrayList::new [bool] a)
        (mut out) (ArrayList::new [AttrDef] a)]
    (for [k 0 n]
      (push! (mut used) false))
    (let [(mut c) 0]
      (loop (if (>= (load c) n)
                (break)
                (do
                  (let [(mut best) -1]
                    (for [bi 0 n]
                      (when (and (not (get (load used) bi))
                                 (or (< (load best)
                                        0)
                                     (str-lt (nz-body-of defs
                                                         bi)
                                             (nz-body-of defs
                                                         (load best)))))
                        (set! best bi)))
                    (set! (mut used) (load best) true)
                    (push! (mut out) (get defs (load best))))
                  (set! c (primitive/iadd (load c) 1))))))
    (load out)))

(defn nz-attr-newof [(defs (ArrayList AttrDef)) (old i64)] (-> i64)
  (let [n (len defs)
        (mut i) 0
        (mut res) -1]
    (loop (if (or (>= (load i) n) (>= (load res) 0))
              (break)
              (do
                (let [(mut d) (: (get defs (load i)) AttrDef)]
                  (when (= (.old d) old) (set! res (load i))))
                (set! i (primitive/iadd (load i) 1)))))
    (load res)))

(defn nz-replace-attr-refs [(a (dyn Allocator))
                            (text (slice u8))
                            (sorted (ArrayList AttrDef))] (-> (slice u8))
  (let [n (len text)
        (mut edits) (ArrayList::new [NzEdit] a)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (cond (= (nz-b text (load i)) 34)
                      (set! i (nz-quoted-end text (load i)))
                    (and (= (nz-b text (load i)) 35)
                         (and (< (+ (load i) 1) n)
                              (nz-digit? (nz-b text (+ (load i) 1)))))
                      (let [(mut end) (+ (load i) 1)]
                        (loop (if (or (>= (load end) n)
                                      (not (nz-digit? (nz-b text (load end)))))
                                  (break)
                                  (set! end (+ (load end) 1))))
                        (when (or (>= (load end) n)
                                  (not (nz-ident? (nz-b text (load end)))))
                          (let [old
                                  (nz-parse-int (subslice text
                                                          (+ (load i) 1)
                                                          (load end)))
                                newn (nz-attr-newof sorted old)]
                            (when (>= newn 0)
                              (let [edit
                                      (NzEdit
                                        :start (load i)
                                        :end (load end)
                                        :family -1
                                        :value newn)]
                                (when (or (!= old newn)
                                          (!= (nz-edit-width edit)
                                              (- (load end) (load i))))
                                  (push! (mut edits) edit)
                                  0))
                              0))
                          0)
                        (set! i (load end)))
                    :else (set! i (+ (load i) 1)))))
    (nz-apply-edits a text (load edits))))

(defn nz-renumber-attrs [(a (dyn Allocator)) (text (slice u8))] (-> (slice u8))
  (let [lines (nz-split-lines a text)
        nl (len lines)
        (mut defs) (ArrayList::new [AttrDef] a)
        pre "attributes #"]
    (for [i 0 nl]
      (let [l (get lines i)]
        (when (starts-with l pre)
          (let [rest (subslice l (len pre) (len l))]
            (match (find rest " = ")
              (None [] 0)
              (Some [eq]
                    (let [numpart (subslice rest 0 eq)]
                      (when (nz-all-digits? numpart)
                        (let [(mut d) (zeroed AttrDef)]
                          (set! (.old d) (nz-parse-int numpart))
                          (set! (.body d)
                                (subslice rest
                                          (primitive/iadd eq 3)
                                          (len rest)))
                          (push! (mut defs) d)
                          0)))))))))
    (if (= (len defs) 0)
        text
        (nz-replace-attr-refs a text (nz-sort-attrs a (load defs))))))

; ---- assemble + normalize --------------------------------------------------
(defn nz-assemble [(a (dyn Allocator))
                   (header (ArrayList (slice u8)))
                   (nblocks (ArrayList NzBlock))] (-> (slice u8))
  (let [(mut out) (ArrayList::new [u8] a)
        nh (len header)
        (mut i) 0
        (mut bytes) 1]
    (for [i 0 nh] (set! bytes (+ (load bytes) (+ (len (get header i)) 1))))
    (for [i 0 (len nblocks)]
      (let [body (.body (get nblocks i))]
        (for [j 0 (len body)]
          (set! bytes (+ (load bytes) (+ (len (get body j)) 1))))
        (set! bytes (+ (load bytes) 1))))
    (reserve! (mut out) (load bytes))
    (loop (if (>= (load i) nh)
              (break)
              (do
                (nz-push-str! (mut out) (get header (load i)))
                (push! (mut out) (: 10 u8))
                (set! i (primitive/iadd (load i) 1)))))
    (push! (mut out) (: 10 u8))
    (let [nb (len nblocks)
          (mut k) 0]
      (loop (if (>= (load k) nb)
                (break)
                (do
                  (let [(mut b) (: (get nblocks (load k)) NzBlock)]
                    (let [body (.body b)
                          nbody (len body)]
                      (for [j 0 nbody]
                        (nz-push-str! (mut out) (get body j))
                        (push! (mut out) (: 10 u8)))
                      (push! (mut out) (: 10 u8))))
                  (set! k (primitive/iadd (load k) 1))))))
    (loop (let [m (len (load out))]
            (if (and (>= m 2)
                     (and (= (nz-b (slice (load out))
                                   (primitive/isub m 1))
                             10)
                          (= (nz-b (slice (load out))
                                   (primitive/isub m 2))
                             10)))
                (do (pop! [u8] (mut out)) 0)
                (break))))
    (slice (load out))))

(defn normalize-ir [(a (dyn Allocator)) (ir (slice u8))] (-> (slice u8))
  (let [text (nz-renumber-attrs a ir)
        (mut parsed) (nz-parse-blocks a text)]
    (let [header (.header parsed)
          blocks0 (.blocks parsed)
          (mut rstk) (nz-build-renumber a blocks0)]
      (let [nb (len blocks0)
            (mut nblocks) (ArrayList::new [NzBlock] a)]
        (for [i 0 nb]
          (let [(mut b) (: (get blocks0 i) NzBlock)
                (mut nbk) (zeroed NzBlock)]
            (set! (.cat nbk) (.cat b))
            (set! (.name nbk) (nz-apply-renumber a (.name b) (mut rstk)))
            (set! (.body nbk) (nz-map-apply a (.body b) (mut rstk)))
            (push! (mut nblocks) nbk)))
        (nz-assemble a header (nz-sort-blocks a (load nblocks)))))))

; Tail of the pipeline: mono'd Program -> codegen -> print -> normalize -> stdout.
; Mirrors (emit_ir then normalize_ir::normalize).
(defn emit-ir-normalized [(a (dyn Allocator))
                          (w (ptr Writer))
                          (mp (ptr Program))
                          (triple (ptr i8))
                          (sanitizer i64)
                          (debug-checks bool)] (-> i64)
  (let [module-span (tr/span-begin "backend.llvm.module")
        m (codegen-module a mp triple sanitizer debug-checks)
        _module-emitted (tr/span-end module-span)
        print-span (tr/span-begin "backend.llvm.print")
        ir-cstr (LLVMPrintModuleToString m)
        _module-printed (tr/span-end print-span)
        dispose-span (tr/span-begin "backend.llvm.dispose")
        ; LLVM owns the printed copy independently of the module. Release the
        ; completed module/context before allocating normalization workspaces.
        _module-disposed (codegen-dispose-module! m)
        _module-released (tr/span-end dispose-span)
        ir (from-cstr ir-cstr)
        _text-length (tr/count "backend.llvm.text-bytes" (len ir))
        normalize-span (tr/span-begin "backend.llvm.normalize")
        norm (normalize-ir a ir)
        _normalized (tr/span-end normalize-span)]
    (ps w norm)
    (wb w 10)  ; mirror `coil dump-ir`'s println! trailing newline
    (LLVMDisposeMessage ir-cstr)
    0))

; Shared front of the pipeline: read -> load -> expand -> resolve -> check -> mono.
; Returns `(Some mono-Program)` on success; on any pass error it dumps the Diag to
; `w` and returns `(None)`. Both `dump-ir-program` (print IR) and `build-ir-program`
; (emit object) drive this so the two share ONE pipeline.
; ============================ diagnostic renderer ===========================
; Faithful render/render_all + report/print_error:
; `error: <msg>\n  --> file:line:col\n   |\nN | <src line>\n   |   ^^^^`, plus a
; `note: in expansion of macro …` trace and an `N errors` multi-error summary.
