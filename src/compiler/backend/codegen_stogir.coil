;;; Native CIR -> stogir adapter. Instruction selection/allocation is stogir's.
;;; CIR and the module assembler are shared transport, not a TPDE codegen fallback.
(module coil.compiler.codegen_stogir)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.scratch" :as scratch)
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.str" :as str :use [keyops-borrowed])
(import "coil.result" :use *)
(import "coil.cc" :as cc)
(import "coil.sync" :use [Mutex Condition])
(import "coil.thread" :as thread :use [Thread ThreadConfig])
(import "coil.compiler.ffi" :use [worker-stack-size])

(extern terminate :as "exit" :cc (cc/C) [i32] (-> never))

(import "coil.compiler.trace" :as tr)
(import "coil.compiler.unit_state" :use [unit-getenv])
(import "coil.compiler.parser" :use [sconcat i64->str])
(import "coil.slice" :use [subslice])
(import "tpde.cir" :as cir)
(import "tpde.asm" :as asm)
(import "tpde.buf" :as buf)
(import "coil.compiler.macho" :use [MTextData])
(import "stogir.graph" :as graph)
(import "stogir.builder" :as b)
(import "stogir.node" :as node)
(import "stogir.opcode" :as opcode)
(import "stogir.calls" :as calls)
(import "stogir.call-groups" :as groups)
(import "stogir.call-results" :as results)
(import "stogir.symbols" :as symbols)
(import "stogir.bulk" :as bulk)
(import "stogir.image" :as image)
(import "stogir.a64.compile" :as native)
(import "stogir.a64.private-leaf" :as private)
(import "stogir.link" :as native-link)
(import "stogir.options" :as native-options)
(import "stogir.call-inline" :as inlining)
(import "stogir.sccp" :as sccp)
(import "stogir.load-forward" :as memory-effects)
(import "stogir.call-effects" :as native-effects)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.return-merge" :as return-merge)
(import "stogir.strings" :as strings)
(import "stogir.bitqueue" :as queue)

(defn fail [(name (slice u8)) (message (slice u8))] (-> never)
  (eprintln "stogir: {}: {}" name message)
  (terminate 1))

(defstruct Adapter
  [(a (dyn Allocator))
   ; Content proof of g from its last library validation (rewrite/Rewritten
   ; proof), or zero. A stale proof never matches the graph's digest.
   (proof u128)
   (f (ptr cir/Func))
   (ta (ptr asm/Asm))
   (text-data (ptr (ArrayList MTextData)))
   (g graph/Graph)
   (return-place i32)
   (return-type i32)
   (return-count i32)
   (indirect-result bool)
   (start i32)
   (control i32)
   (values (ArrayList i32))
   (high-values (ArrayList i32))
   (capture-places (HashMap u32 i32))
   (regions (ArrayList i32))
   (order (ArrayList i64))
   (from (ArrayList i64))
   (to (ArrayList i64))
   (ends (ArrayList i32))
   (branches (ArrayList i32))
   (exits (ArrayList i32))
   ; The function's own symbol, or -1 when the adapter was not given one.
   (self i64)
   ; Self calls in tail position that jump back to the body (self-loop-site?):
   ; one reserved END per site in block order, the parameter PHIs of the body
   ; region (zero for a high half that does not exist), and the next site.
   (self-ends (ArrayList i32))
   (self-phis (ArrayList i32))
   (self-high-phis (ArrayList i32))
   (self-next i64)
   (import-names (ArrayList (slice u8)))
   (import-ids (ArrayList u32))
   ; g belongs to a frozen definition: an expansion replaces it without
   ; releasing it, and then owns its result as usual.
   (borrowed bool)])

(defn require [(s (ptr Adapter)) (result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [r] r) (Err [message] (fail (.name (.f s)) message))))

(defn emit! [(s (ptr Adapter)) (op i32) (ty i32) (args (slice i32))] (-> i32)
  (match (cond (and (or (= ty 5) (= ty 11))
                    (= (len args) 3)
                    (or (= op 29) (= op 30)))
                 (b/integer-division! (mut (.g s)) op ty 8
                                      (get args 0) (get args 1) (get args 2))
               (and (or (= ty 5) (= ty 11))
                    (= (len args) 2)
                    (or (and (>= op 26) (<= op 28))
                        (and (>= op 46) (<= op 53))
                        (= op 58)
                        (= op 59)))
                 (b/integer-binary! (mut (.g s))
                                    op
                                    ty
                                    8
                                    (get args 0)
                                    (get args 1))
               (and (or (= ty 5) (= ty 11))
                    (= (len args) 1)
                    (or (= op 31) (= op 45) (and (>= op 54) (<= op 57))))
                 (b/integer-unary! (mut (.g s)) op ty 8 (get args 0))
               :else (b/emit! (mut (.g s)) op ty args))
    (Ok [r] r)
    (Err [message]
         (eprintln "stogir: {}: graph opcode {}, type {}, operand count {}"
                   (.name (.f s))
                   op
                   ty
                   (len args))
         (fail (.name (.f s)) message))))

;;; Unsealed control/PHI nodes temporarily hold forward references. All links
;;; are patched before native/image runs the complete graph verifier.
(defn reserve! [(s (ptr Adapter)) (op i32) (ty i32) (args (slice i32))] (-> i32)
  (match (graph/append-inputs! (mut (.g s)) (cast u8 op) (cast u8 ty) args)
    (None [] (fail (.name (.f s)) "graph reference space exhausted"))
    (Some [r] r)))

(defn constant! [(s (ptr Adapter)) (ty i32) (bits u64)] (-> i32)
  (require s (b/scalar-constant! (mut (.g s)) ty bits 8)))

(defn convert! [(s (ptr Adapter)) (op i32) (ty i32) (value i32)] (-> i32)
  (require s (b/conversion! (mut (.g s)) op ty 8 value)))

(defn type-id [(s (ptr Adapter)) (ty u8)] (-> i32)
  (match (cast i64 ty)
    (0 0)
    (1 5)
    (2 5)
    (3 13)
    (4 12)
    (5 37)
    (_ (fail (.name (.f s)) "CIR register type is not implemented"))))

(defn value [(s (ptr Adapter)) (id u32)] (-> i32)
  (let [r (get (.values s) (cast i64 (cir/resolve (.f s) id)))]
    (when (= r 0)
      (fail (.name (.f s))
            "SSA operand has not been defined in dominance order"))
    r))

(defn operand [(s (ptr Adapter)) (x (ptr cir/Value)) (i u32)] (-> i32)
  (value s (cir/operand (.f s) x i)))

(defn address! [(s (ptr Adapter)) (value i32)] (-> i32)
  (convert! s 36 6 value))

(defn add-offset! [(s (ptr Adapter)) (base i32) (offset i64)] (-> i32)
  (if (= offset 0)
      base
      (emit! s 26 5 [base (constant! s 5 (p/cast u64 offset))])))

(defn import-name [(a (dyn Allocator)) (symbol u32)] (-> (slice u8))
  (sconcat a "_coil_stogir_import_" (i64->str a (cast i64 symbol))))

(defn symbol! [(s (ptr Adapter)) (id u32)] (-> i32)
  (let [(mut found) (: -1 i64)]
    (for [i 0 (len (.import-ids s))]
      (when (= (get (.import-ids s) i) id) (set! found i)))
    (when (< found 0)
      (set! found (len (.import-ids s)))
      (push! (mut (.import-ids s)) id)
      (push! (mut (.import-names s))
             (import-name (.a s) id)))
    (require s (symbols/function! (mut (.g s)) (get (.import-names s) found) 0))))

;;; CIR container values are normalized explicitly; memory and ABI widths remain typed.
(defn integer-type [(bytes i64) (signed bool)] (-> i32)
  (case bytes
    1 (if signed 8 2)
    2 (if signed 9 3)
    4 (if signed 10 4)
    8 (if signed 11 5)
    -1))

(defn argument-type [(s (ptr Adapter)) (ty u8) (flags u32)] (-> i32)
  (when (!= (& flags (: 0x1800 u32)) 0)
    (fail (.name (.f s))
          "grouped, sret, variadic or by-value argument needs ABI adaptation"))
  (let [size-code (& (>> flags (: 24 u32)) (: 7 u32))]
    (if (= (cast i64 ty) cir/T-I64)
        (if (cir/af-address? flags)
            (do
              (unless (= size-code 0)
                (fail (.name (.f s)) "pointer argument has narrow integer size"))
              6)
            (if (= size-code 0)
            5
            (integer-type (<< (: 1 i64) (- (cast i64 size-code) 1))
                          (or (!= (& flags (: 0x80 u32)) 0)
                              (cir/af-signed? flags)))))
        (type-id s ty))))

(defn container! [(s (ptr Adapter)) (ty i32) (v i32)] (-> i32)
  (if (= ty 5)
      v
      (if (or (= ty 12) (= ty 13) (= ty 37))
          v
          (if (or (= ty 11) (= ty 6))
              (convert! s 36 5 v)
              (convert! s (if (>= ty 7) 33 34) 5 v)))))

;;; CIR Boolean comparisons live in integer containers. Recover their original
;;; Boolean node when branching instead of comparing the normalized container again.
(defn truth! [(s (ptr Adapter)) (v i32)] (-> i32)
  (let [x
          (match (graph/lookup (.g s) v)
            (Some [n] n)
            (None [] (fail (.name (.f s)) "condition missing")))]
    (cond (= (node/type-id x) 1) v
          (and (= (node/opcode x) 34)
               (match (graph/lookup (.g s) (.op1 x))
                 (Some [input] (= (node/type-id input) 1))
                 (None [] false)))
            (.op1 x)
          :else
            (require s
                     (b/integer-compare! (mut (.g s)) 15 8 v (constant! s 5 0))))))

;;; Terminator successors occupy operands after the value operands.
(defn successors [(s (ptr Adapter)) (block i64)] (-> i64)
  (let [bb (cir/blk (.f s) (cast u32 block))]
    (if (= (.term bb) (cir/none))
        0
        (let [x (cir/val (.f s) (.term bb))
              op (cast i64 (.op x))]
          (cond (= op cir/OP-BR) 1
                (= op cir/OP-CONDBR) 2
                (= op cir/OP-SWITCH) (cast i64 (- (.ntotal x) (.nops x)))
                :else 0)))))

(defn successor [(s (ptr Adapter)) (block i64) (index i64)] (-> i64)
  (let [x (cir/val (.f s) (.term (cir/blk (.f s) (cast u32 block))))]
    (cast i64 (cir/operand (.f s) x (+ (.nops x) (cast u32 index))))))

(defn prepare-control! [(s (ptr Adapter))] (-> void)
  (let [(mut seen) (ArrayList::new [bool] (.a s))
        (mut work) (ArrayList::new [i64] (.a s))
        nb (len (.blocks (.f s)))]
    (for [i 0 nb]
      (push! (mut seen) false)
      (push! (mut (.regions s)) 0)
      (push! (mut (.branches s)) 0))
    (push! (mut work) 0)
    (while (> (len work) 0)
      (let [last (- (len work) 1)
            item (get work last)]
        (set! (.len work) last)
        (if (< item 0)
            (push! (mut (.order s)) (- (- 0 item) 1))
            (unless (get seen item)
              (set! (mut seen) item true)
              (push! (mut work) (- 0 (+ item 1)))
              (for [k 0 (successors s item)]
                (push! (mut work) (successor s item k)))))))
    (let [n (len (.order s))]
      (for [i 0 (/ n 2)]
        (let [j (- (- n 1) i)
              x (get (.order s) i)]
          (set! (mut (.order s)) i (get (.order s) j))
          (set! (mut (.order s)) j x))))
    (for block (.order s)
      (let [n (successors s block)
            term (cir/val (.f s) (.term (cir/blk (.f s) (cast u32 block))))
            switch? (= (cast i64 (.op term)) cir/OP-SWITCH)
            branch
              (if switch?
                  (reserve! s 117 0 [(: 0 i32) (constant! s 5 0)])
                  (if (= n 2)
                      (reserve! s 116 0 [(: 0 i32) (constant! s 1 0)])
                      0))]
        (set! (mut (.branches s)) block branch)
        (for [k 0 n]
          (let [prior
                  (if switch?
                      (if (= k 0)
                          (emit! s 111 0 [branch (: 0 i32)])
                          (emit! s
                                 109
                                 0
                                 [branch
                                  (constant! s
                                             5
                                             (get (.case-values (.f s))
                                                  (+ (.imm term) (- k 1))))
                                  (: 0 i32)]))
                      (if (= n 2)
                          (emit! s (if (= k 0) 107 108) 0 [branch (: 0 i32)])
                          0))]
            (push! (mut (.from s)) block)
            (push! (mut (.to s)) (successor s block k))
            (push! (mut (.ends s)) (reserve! s 114 0 [prior]))))))
    (set! (mut (.regions s)) 0 (.start s))
    (for block (.order s)
      (unless (= block 0)
        (let [(mut inputs) (ArrayList::new [i32] (.a s))]
          (for [i 0 (len (.ends s))]
            (when (= (get (.to s) i) block)
              (push! (mut inputs) (get (.ends s) i))))
          (set! (mut (.regions s)) block (emit! s 112 0 (slice inputs))))))
    (for block (.order s)
      (let [bb (cir/blk (.f s) (cast u32 block))]
        (for [j 0 (cast i64 (.phi-count bb))]
          (let [id (get (.phis (.f s)) (+ (cast i64 (.phi-begin bb)) j))
                x (cir/val (.f s) id)
                (mut inputs) (ArrayList::new [i32] (.a s))]
            (push! (mut inputs) (get (.regions s) block))
            (for [i 0 (len (.ends s))]
              (when (= (get (.to s) i) block) (push! (mut inputs) 0)))
            (set! (mut (.values s))
                  (cast i64 id)
                  (reserve! s 67 (type-id s (.ty x)) (slice inputs)))
            (when (= (.ty x) 2)
              (set! (mut (.high-values s))
                    (cast i64 id)
                    (reserve! s 67 5 (slice inputs))))))))))

(defn comparison-op [(predicate i64)] (-> i32)
  (case predicate 0 14 1 15 2 16 3 18 4 19 5 17 6 20 7 22 8 23 9 21 -1))

(defn basic-op [(op i64)] (-> i32)
  (case op
    10 26
    11 27
    12 28
    13 47
    14 46
    15 48
    16 49
    17 50
    18 51
    19 29
    20 29
    21 30
    22 30
    23 52
    24 53
    25 31
    26 45
    34 56
    35 57
    36 55
    37 54
    50 26
    51 27
    52 28
    53 29
    54 31
    55 32
    -1))

(defn piece-size [(ty i32)] (-> i64)
  (case ty 13 4 37 16 8))

(defn place-offset! [(s (ptr Adapter)) (place i32) (offset i64)] (-> i32)
  (if (= offset 0)
      place
      (emit! s 26 6 [place (constant! s 5 (cast u64 offset))])))

(defn append-group! [(s (ptr Adapter))
                     (out (mut (ArrayList groups/Group)))
                     (index i32)
                     (flags u32)
                     (ty i32)
                     (end (mut i32))] (-> void)
  (let [remaining (& (>> flags (: 16 u32)) (: 255 u32))]
    (when (and (> remaining 0) (>= index end))
      (let [count (+ (cast i32 remaining) 1)]
        (push! (mut out)
               (groups/Group
                 :first index
                 :count count
                 :alignment (cast i32 (piece-size ty))))
        (set! end (+ index count))))))

;;; The number of arguments the hosted C library routine NAME takes when its
;;; only memory effect is reading through its pointer arguments, or -1. The
;;; set follows what LLVM's TargetLibraryInfo marks `memory(argmem: read)`.
(defn readonly-library-arity [(name (slice u8))] (-> i64)
  (cond (or (= name "memcmp") (= name "bcmp") (= name "memchr") (= name "strncmp")) 3
        (= name "strcmp") 2
        (= name "strlen") 1
        :else -1))

;;; Whether a direct call of assembler symbol SYMBOL with ARGUMENTS arguments is
;;; a call of a read-only hosted C library routine. Such a call carries
;;; PURE_FUNC, which to the library means exactly "the target writes no memory
;;; the caller can observe": loads may be forwarded and kept across it. The
;;; call itself stays on the control chain, since its result depends on memory.
;;;
;;; Only an undefined external symbol qualifies. `tl-sym` gives exactly those
;;; their object symbol name, which is the C name behind the object format's
;;; `_` prefix; a symbol this program defines has no assembler name and a
;;; section, so a Coil function called `memcmp`, or one exported as the C symbol
;;; `memcmp`, never matches.
(defn pure-runtime-call? [(s (ptr Adapter)) (symbol u32) (arguments i64)] (-> bool)
  (let [target (asm/sym-at (.ta s) symbol)
        name (.name target)]
    (and (= (.sect target) -1)
         (= (.binding target) 1)
         (> (len name) 1)
         (= (get name 0) #\_)
         (= (readonly-library-arity (subslice name 1 (len name))) arguments))))

;;; Whether a direct call of assembler symbol SYMBOL is a call of the hosted C
;;; library's memcmp or bcmp (see pure-runtime-call? for why only an undefined
;;; external symbol qualifies) with the scalar shape the library's
;;; BUILTIN-COMPARE declares. memcmp's result satisfies bcmp's contract. The
;;; declaration lets the backend compare a short known count inline.
(defn runtime-compare-call? [(s (ptr Adapter)) (symbol u32) (result i32) (types (slice u8))]
  (-> bool)
  (let [target (asm/sym-at (.ta s) symbol)
        name (.name target)]
    (and (= (.sect target) -1)
         (= (.binding target) 1)
         (or (= name "_memcmp") (= name "_bcmp"))
         (groups/builtin-shape? groups/BUILTIN-COMPARE (cast u8 result) types))))

;;; Whether X is a call in tail position whose register result pieces are the
;;; function's own: it captures them straight into the function's result place
;;; (the callee returns what this function returns), so the call stays directly
;;; in front of its RETURN and can run as a jump.
(defn forwarded-result? [(s (ptr Adapter)) (x (ptr cir/Value))] (-> bool)
  (and (= (cast i64 (.op x)) cir/OP-TAILCALL)
       (> (physical-results s x (cast i32 (.aux x))) 1)))

(defn lower-call! [(s (ptr Adapter)) (id u32) (x (ptr cir/Value))] (-> i32)
  (let [(mut args) (ArrayList::new [i32] (.a s))
        (mut types) (ArrayList::new [u8] (.a s))
        (mut descriptors) (ArrayList::new [groups/Group] (.a s))
        (mut group-end) (: 0 i32)
        (mut fixed) (: -1 i64)
        (mut sret) false
        logical-count (cast i32 (.aux x))
        (mut nr) (: 0 i32)
        rt (type-id s (.ty x))
        (mut place) (: 0 i32)
        indirect (< (.imm x) 0)
        first (if indirect (: 1 u32) (: 0 u32))
        target
          (if indirect
              (address! s (operand s x 0))
              (symbol! s (cast u32 (.imm x))))]
    (for [i 0 (cast i64 logical-count)]
      (let [v (cir/val (.f s) (+ id (cast u32 i)))]
        (unless (= rt (type-id s (.ty v)))
          (fail (.name (.f s))
                "mixed aggregate result registers are unsupported"))
        (set! nr (+ nr (if (= (.ty v) 2) 2 1)))))
    (when (> nr 1)
      (set! place (if (forwarded-result? s x) (.return-place s) (capture-place s id)))
      (push! (mut types) 6)
      (push! (mut args) place))
    (for [i (cast i64 first) (cast i64 (.nops x))]
      (let [argid (cir/operand (.f s) x (cast u32 i))
            flags (get (.argflags (.f s)) (+ (cast i64 (.opb x)) i))
            result-arg (!= (& flags (: 0x100 u32)) 0)
            wide (wide-value? s argid)
            ty
              (if result-arg
                  6
                  (argument-type s (.ty (cir/val (.f s) argid)) flags))
            v (value s argid)
            index (cast i32 (len types))]
        (when result-arg
          (when (or (!= index 0) (> nr 1))
            (fail (.name (.f s)) "invalid indirect result argument position"))
          (set! sret true))
        (when (and (!= (& flags (: 0x200 u32)) 0) (< fixed 0))
          (set! fixed (len types)))
        (if wide
            (do
              (push! (mut descriptors)
                     (groups/Group
                       :first index
                       :count 2
                       :alignment 16))
              (set! group-end (+ index 2)))
            (append-group! s (mut descriptors) index flags ty (mut group-end)))
        (push! (mut types) (cast u8 ty))
        (push! (mut args)
               (if (= ty 6)
                   (address! s v)
                   (if (and (>= ty 1) (<= ty 10) (!= ty 5) (!= ty 6))
                       (convert! s 35 ty v)
                       v)))
        (when wide
          (push! (mut types) 5)
          (push! (mut args) (high-value s argid)))))
    (when (< fixed 0) (set! fixed (len types)))
    (let [flags (| (if (< fixed (len types)) (: 25 u8) (: 9 u8))
                   (if (and (not indirect) (not sret) (<= nr 1)
                            (= fixed (len types))
                            (pure-runtime-call? s (cast u32 (.imm x)) (len types)))
                       (: 64 u8) (: 0 u8)))
          parameters (subslice (slice types) 0 fixed)
          prototype
            (if (or sret (> nr 1))
                (calls/create-result flags
                                     parameters
                                     (slice descriptors)
                                     (if sret
                                         (results/indirect)
                                         (results/pieces (cast u8 rt) nr))
                                     (.a s))
                (if (and (!= (& flags 64) 0)
                         (= (len descriptors) 0)
                         (runtime-compare-call? s (cast u32 (.imm x)) rt parameters))
                    (calls/create-builtin-compare flags (cast u8 rt) (get parameters 2) (.a s))
                    (calls/create-grouped flags
                                          (cast u8 rt)
                                          parameters
                                          (slice descriptors)
                                          (.a s))))]
      (match prototype
        (Err [message] (fail (.name (.f s)) message))
        (Ok [proto]
            (let [r
                    (require s
                             (calls/emit! (mut (.g s))
                                          proto
                                          (.control s)
                                          target
                                          (slice args)
                                          (.a s)))]
              (set! (.control s) r)
              (if (and (> nr 1) (not (forwarded-result? s x)))
                  (let [(mut first-result) (: 0 i32)
                        (mut offset) 0]
                    (for [i 0 (cast i64 logical-count)]
                      (let [result-id (+ id (cast u32 i))
                            wide (wide-value? s result-id)
                            lo
                              (emit! s
                                     91
                                     rt
                                     [(.control s)
                                      (place-offset! s place offset)])]
                        (set! (.control s) lo)
                        (set! (mut (.values s)) (cast i64 result-id) lo)
                        (set! offset (+ offset (piece-size rt)))
                        (when wide
                          (let [hi
                                  (emit! s
                                         91
                                         5
                                         [(.control s)
                                          (place-offset! s place offset)])]
                            (set! (.control s) hi)
                            (set! (mut (.high-values s))
                                  (cast i64 result-id)
                                  hi)
                            (set! offset (+ offset 8))))
                        (when (= i 0) (set! first-result lo))))
                    first-result)
                  r)))))))

;;; CIR i128 values are legalized into two scalar u64 graph references. This
;;; adapter view never becomes a second semantic IR: stogir owns every scalar
;;; operation, PHI, memory dependency and ABI piece before optimization.
(defstruct Wide [(lo i32) (hi i32)])

(defn wide-value? [(s (ptr Adapter)) (id u32)] (-> bool)
  (= (.ty (cir/val (.f s) (cir/resolve (.f s) id))) 2))

(defn high-value [(s (ptr Adapter)) (id u32)] (-> i32)
  (let [r (get (.high-values s) (cast i64 (cir/resolve (.f s) id)))]
    (when (= r 0) (fail (.name (.f s)) "wide SSA high operand is undefined"))
    r))

(defn wide-value [(s (ptr Adapter)) (id u32)] (-> Wide)
  (Wide :lo (value s id) :hi (high-value s id)))

(defn wide-operand [(s (ptr Adapter)) (x (ptr cir/Value)) (i u32)] (-> Wide)
  (wide-value s (cir/operand (.f s) x i)))

(defn word! [(s (ptr Adapter)) (bits u64)] (-> i32)
  (constant! s 5 bits))

(defn bool-word! [(s (ptr Adapter)) (v i32)] (-> i32)
  (convert! s 34 5 v))

(defn cmp! [(s (ptr Adapter)) (op i32) (a i32) (b i32)] (-> i32)
  (require s (b/integer-compare! (mut (.g s)) op 8 a b)))

(defn choose! [(s (ptr Adapter)) (test i32) (yes i32) (no i32)] (-> i32)
  (require s (b/conditional! (mut (.g s)) 5 test yes no)))

(defn sar! [(s (ptr Adapter)) (a i32) (n i32)] (-> i32)
  (convert! s 36 5 (emit! s 51 11 [(convert! s 36 11 a) (convert! s 36 11 n)])))

;;; 32-bit limb decomposition avoids introducing a new semantic opcode for
;;; multiply-high. Every intermediate sum is bounded within one u64 word.
(defn umul-high! [(s (ptr Adapter)) (a i32) (b i32)] (-> i32)
  (let [mask (word! s 4294967295)
        n (word! s 32)
        a0 (emit! s 47 5 [a mask])
        a1 (emit! s 50 5 [a n])
        b0 (emit! s 47 5 [b mask])
        b1 (emit! s 50 5 [b n])
        p0 (emit! s 28 5 [a0 b0])
        t (emit! s 26 5 [(emit! s 28 5 [a1 b0]) (emit! s 50 5 [p0 n])])
        w1 (emit! s 47 5 [t mask])
        w2 (emit! s 50 5 [t n])
        mid (emit! s 26 5 [(emit! s 28 5 [a0 b1]) w1])]
    (emit! s
           26
           5
           [(emit! s 26 5 [(emit! s 28 5 [a1 b1]) w2])
            (emit! s 50 5 [mid n])])))

(defn mul-high! [(s (ptr Adapter)) (a i32) (b i32) (signed bool)] (-> i32)
  (let [hi (umul-high! s a b)]
    (if signed
        (emit! s
               27
               5
               [(emit! s 27 5 [hi (emit! s 47 5 [(sar! s a (word! s 63)) b])])
                (emit! s 47 5 [(sar! s b (word! s 63)) a])])
        hi)))

(defn wide-add! [(s (ptr Adapter)) (a Wide) (b Wide) (subtract bool)] (-> Wide)
  (let [op (if subtract (: 27 i32) (: 26 i32))
        lo (emit! s op 5 [(.lo a) (.lo b)])
        carry
          (bool-word! s
                      (if subtract
                          (cmp! s 20 (.lo a) (.lo b))
                          (cmp! s 20 lo (.lo a))))]
    (Wide :lo lo :hi (emit! s op 5 [(emit! s op 5 [(.hi a) (.hi b)]) carry]))))

(defn wide-mul! [(s (ptr Adapter)) (a Wide) (b Wide)] (-> Wide)
  (Wide
    :lo (emit! s 28 5 [(.lo a) (.lo b)])
    :hi
      (emit! s
             26
             5
             [(umul-high! s (.lo a) (.lo b))
              (emit! s
                     26
                     5
                     [(emit! s 28 5 [(.lo a) (.hi b)])
                      (emit! s 28 5 [(.hi a) (.lo b)])])])))

(defn wide-bitwise! [(s (ptr Adapter)) (op i32) (a Wide) (b Wide)] (-> Wide)
  (Wide
    :lo (emit! s op 5 [(.lo a) (.lo b)])
    :hi (emit! s op 5 [(.hi a) (.hi b)])))

(defn wide-shift! [(s (ptr Adapter)) (op i64) (a Wide) (amount i32)] (-> Wide)
  (let [zero (word! s 0)
        k (emit! s 47 5 [amount (word! s 63)])
        small (cmp! s 14 (emit! s 47 5 [amount (word! s 64)]) zero)
        nonzero (cmp! s 15 k zero)
        inverse (emit! s 27 5 [(word! s 64) k])]
    (if (= op cir/OP-SHL)
        (let [lo (emit! s 49 5 [(.lo a) k])
              cross (choose! s nonzero (emit! s 50 5 [(.lo a) inverse]) zero)
              hi (emit! s 46 5 [(emit! s 49 5 [(.hi a) k]) cross])]
          (Wide :lo (choose! s small lo zero) :hi (choose! s small hi lo)))
        (let [hi
                (if (= op cir/OP-ASHR)
                    (sar! s (.hi a) k)
                    (emit! s 50 5 [(.hi a) k]))
              cross (choose! s nonzero (emit! s 49 5 [(.hi a) inverse]) zero)
              lo (emit! s 46 5 [(emit! s 50 5 [(.lo a) k]) cross])
              fill (if (= op cir/OP-ASHR) (sar! s (.hi a) (word! s 63)) zero)]
          (Wide :lo (choose! s small lo hi) :hi (choose! s small hi fill))))))

;;; The 64-bit literal that CIR value ID is, when it is an I64 constant.
(defn word-literal [(s (ptr Adapter)) (id u32) (bits (mut u64))] (-> bool)
  (let [v (cir/val (.f s) (cir/resolve (.f s) id))]
    (if (and (= (cast i64 (.op v)) cir/OP-CONST) (= (cast i64 (.ty v)) cir/T-I64))
        (do (set! bits (p/cast u64 (.imm v))) true)
        false)))

;;; The two words of the 128-bit literal that CIR value ID is: a wide
;;; constant, a pair of word constants, a word constant extended from its low
;;; `imm` bits (as wide-instruction! lowers SEXT and ZEXT), or such a literal
;;; shifted left by a word constant (the count modulo 128, as wide-shift!).
(defn wide-literal [(s (ptr Adapter)) (id u32) (lo (mut u64)) (hi (mut u64))] (-> bool)
  (let [v (cir/val (.f s) (cir/resolve (.f s) id))
        op (cast i64 (.op v))]
    (cond (!= (.ty v) 2) false
          (= op cir/OP-CONST)
            (do
              (set! lo (p/cast u64 (.imm v)))
              (set! hi (p/cast u64 (.imm2 v)))
              true)
          (and (= op cir/OP-PAIR) (= (.nops v) 2))
            (and (word-literal s (cir/operand (.f s) v 0) (mut lo))
                 (word-literal s (cir/operand (.f s) v 1) (mut hi)))
          (and (or (= op cir/OP-SEXT) (= op cir/OP-ZEXT))
               (= (.nops v) 1)
               (>= (.imm v) 1)
               (<= (.imm v) 64))
            (let [(mut word) (: 0 u64)
                  unused (- 64 (p/cast u64 (.imm v)))]
              (if (word-literal s (cir/operand (.f s) v 0) (mut word))
                  (if (= op cir/OP-SEXT)
                      (let [extended (>> (p/cast i64 (<< word unused)) (p/cast i64 unused))]
                        (set! lo (p/cast u64 extended))
                        (set! hi (p/cast u64 (>> extended 63)))
                        true)
                      (do
                        (set! lo (>> (<< word unused) unused))
                        (set! hi 0)
                        true))
                  false))
          (and (= op cir/OP-SHL) (= (.nops v) 2))
            (let [(mut count) (: 0 u64)
                  (mut low) (: 0 u64)
                  (mut high) (: 0 u64)]
              (if (and (or (word-literal s (cir/operand (.f s) v 1) (mut count))
                           ; A wide count: its low word counts.
                           (wide-literal s (cir/operand (.f s) v 1) (mut count) (mut high)))
                       (wide-literal s (cir/operand (.f s) v 0) (mut low) (mut high)))
                  (let [k (& count 127)]
                    (cond (= k 0) (do (set! lo low) (set! hi high))
                          (< k 64)
                            (do
                              (set! lo (<< low k))
                              (set! hi (| (<< high k) (>> low (- 64 k)))))
                          :else (do (set! lo 0) (set! hi (<< low (- k 64)))))
                    true)
                  false))
          :else false)))

;;; The exponent K when the 128-bit pattern HI:LO is 2^K, otherwise -1.
(defn power-exponent [(lo u64) (hi u64)] (-> i64)
  (let [word (if (= hi 0) lo hi)]
    (if (and (or (= lo 0) (= hi 0))
             (!= word 0)
             (= (& word (p/isub word 1)) 0))
        (let [(mut k) (if (= hi 0) (: 0 i64) 64)
              (mut bit) word]
          (while (!= bit 1)
            (set! bit (>> bit 1))
            (set! k (+ k 1)))
          k)
        -1)))

;;; The exponent K when CIR value ID is the 128-bit literal 2^K (0..127 as an
;;; unsigned pattern), otherwise -1.
(defn wide-power [(s (ptr Adapter)) (id u32)] (-> i64)
  (let [(mut lo) (: 0 u64)
        (mut hi) (: 0 u64)]
    (if (wide-literal s id (mut lo) (mut hi)) (power-exponent lo hi) -1)))

;;; The exponent K when wide division or remainder X is computed inline
;;; (wide-divide-power!), otherwise -1: its divisor is the literal 2^K, or for
;;; a signed operation -(2^K), which sets NEGATIVE. As a signed divisor the
;;; pattern 2^127 is the minimum, neither form; it stays a runtime call like
;;; every other divisor.
(defn wide-division-power [(s (ptr Adapter)) (x (ptr cir/Value)) (negative (mut bool))] (-> i64)
  (let [op (cast i64 (.op x))
        signed (or (= op cir/OP-SDIV) (= op cir/OP-SREM))
        (mut lo) (: 0 u64)
        (mut hi) (: 0 u64)]
    (set! negative false)
    (if (and (= (.ty x) 2) (>= op cir/OP-SDIV) (<= op cir/OP-UREM) (= (.nops x) 2)
             (wide-literal s (cir/operand (.f s) x 1) (mut lo) (mut hi)))
        (let [k (power-exponent lo hi)]
          (cond (not signed) k
                (and (>= k 0) (< k 127)) k
                :else
                  ; The two's complement negation of the pattern.
                  (let [low (p/isub 0 lo)
                        high (p/isub (^ hi (: 0xFFFFFFFFFFFFFFFF u64)) (if (= lo 0) (: -1 u64) 0))
                        opposite (power-exponent low high)]
                    (if (and (>= opposite 0) (< opposite 127))
                        (do (set! negative true) opposite)
                        -1))))
        -1)))

(defn inline-wide-division? [(s (ptr Adapter)) (x (ptr cir/Value))] (-> bool)
  (let [(mut negative) false]
    (>= (wide-division-power s x (mut negative)) 0)))

;;; A shift of both halves by the literal count K in 0..127.
(defn wide-shift-by! [(s (ptr Adapter)) (op i64) (a Wide) (k i64)] (-> Wide)
  (let [zero (word! s 0)
        left (= op cir/OP-SHL)
        arithmetic (= op cir/OP-ASHR)
        count (word! s (cast u64 (if (< k 64) k (- k 64))))
        inverse (word! s (cast u64 (if (< k 64) (- 64 k) 0)))]
    (cond (= k 0) a
          left
            (cond (< k 64)
                    (Wide :lo (emit! s 49 5 [(.lo a) count])
                          :hi (emit! s 46 5 [(emit! s 49 5 [(.hi a) count])
                                             (emit! s 50 5 [(.lo a) inverse])]))
                  (= k 64) (Wide :lo zero :hi (.lo a))
                  :else (Wide :lo zero :hi (emit! s 49 5 [(.lo a) count])))
          :else
            (let [fill (if arithmetic (sar! s (.hi a) (word! s 63)) zero)]
              (cond (< k 64)
                      (Wide :lo (emit! s 46 5 [(emit! s 50 5 [(.lo a) count])
                                               (emit! s 49 5 [(.hi a) inverse])])
                            :hi (if arithmetic
                                    (sar! s (.hi a) count)
                                    (emit! s 50 5 [(.hi a) count])))
                    (= k 64) (Wide :lo (.hi a) :hi fill)
                    :else
                      (Wide :lo (if arithmetic
                                    (sar! s (.hi a) count)
                                    (emit! s 50 5 [(.hi a) count]))
                            :hi fill))))))

;;; A with its low K bits kept (KEEP) or cleared, K in 1..127.
(defn wide-low-bits! [(s (ptr Adapter)) (a Wide) (k i64) (keep bool)] (-> Wide)
  (let [zero (word! s 0)
        bits (if (< k 64) k (- k 64))
        low (p/isub (<< (: 1 u64) (cast u64 bits)) 1)
        mask (word! s (if keep low (^ low (: 0xFFFFFFFFFFFFFFFF u64))))]
    (cond (< k 64)
            (Wide :lo (emit! s 47 5 [(.lo a) mask]) :hi (if keep zero (.hi a)))
          (= k 64) (Wide :lo (if keep (.lo a) zero) :hi (if keep zero (.hi a)))
          :else
            (Wide :lo (if keep (.lo a) zero) :hi (emit! s 47 5 [(.hi a) mask])))))

;;; Wide division or remainder by the literal 2^K, or -(2^K) when NEGATIVE, as
;;; wide-division-power gives them. Unsigned: a shift, or the low K bits.
;;; Signed division truncates toward zero: a negative dividend is first raised
;;; by 2^K - 1 (the sign spread over 128 bits and shifted right by 128 - K),
;;; then shifted arithmetically; the remainder is the dividend less that
;;; quotient's multiple, the raised dividend with its low K bits cleared. A
;;; negative divisor negates the quotient (wrapping, as the division does) and
;;; leaves the remainder, whose sign is the dividend's.
(defn wide-divide-power! [(s (ptr Adapter)) (op i64) (a Wide) (k i64) (negative bool)] (-> Wide)
  (let [zero (word! s 0)
        quotient (or (= op cir/OP-SDIV) (= op cir/OP-UDIV))
        signed (or (= op cir/OP-SDIV) (= op cir/OP-SREM))]
    (cond (and negative quotient)
            (wide-add! s (Wide :lo zero :hi zero) (wide-divide-power! s op a k false) true)
          (= k 0) (if quotient a (Wide :lo zero :hi zero))
          (not signed)
            (if quotient
                (wide-shift-by! s cir/OP-LSHR a k)
                (wide-low-bits! s a k true))
          :else
            (let [sign (sar! s (.hi a) (word! s 63))
                  raise (wide-shift-by! s cir/OP-LSHR (Wide :lo sign :hi sign) (- 128 k))
                  raised
                    (if (<= k 64)
                        ; The raise fits the low word: only its carry reaches the high one.
                        (let [lo (emit! s 26 5 [(.lo a) (.lo raise)])]
                          (Wide :lo lo
                                :hi (emit! s 26 5 [(.hi a) (bool-word! s (cmp! s 20 lo (.lo a)))])))
                        (wide-add! s a raise false))]
              (if quotient
                  (wide-shift-by! s cir/OP-ASHR raised k)
                  (wide-add! s a (wide-low-bits! s raised k false) true))))))

(defn wide-compare! [(s (ptr Adapter)) (a Wide) (b Wide) (predicate i64)]
  (-> i32)
  (let [equal-hi (cmp! s 14 (.hi a) (.hi b))
        equal-lo (cmp! s 14 (.lo a) (.lo b))]
    (cond (= predicate 0) (emit! s 47 1 [equal-hi equal-lo])
          (= predicate 1)
            (emit! s
                   48
                   1
                   [(emit! s 47 1 [equal-hi equal-lo]) (constant! s 1 1)])
          :else
            (let [signed (and (>= predicate 2) (<= predicate 5))
                  reverse
                    (or (= predicate 4)
                        (= predicate 5)
                        (= predicate 8)
                        (= predicate 9))
                  inclusive
                    (or (= predicate 3)
                        (= predicate 5)
                        (= predicate 7)
                        (= predicate 9))
                  ah (if reverse (.hi b) (.hi a))
                  bh (if reverse (.hi a) (.hi b))
                  al (if reverse (.lo b) (.lo a))
                  bl (if reverse (.lo a) (.lo b))
                  less-hi
                    (if signed
                        (cmp! s 16 (convert! s 36 11 ah) (convert! s 36 11 bh))
                        (cmp! s 20 ah bh))
                  less-lo (cmp! s (if inclusive 22 20) al bl)]
              (emit! s 46 1 [less-hi (emit! s 47 1 [equal-hi less-lo])])))))

;;; A runtime arithmetic helper is ordinary C ABI lowering, matching native
;;; compiler-rt legalization; selection and allocation remain entirely stogir.
(defn wide-runtime! [(s (ptr Adapter))
                     (id u32)
                     (name (slice u8))
                     (args (slice i32))
                     (types (slice u8))
                     (descriptors (slice groups/Group))] (-> Wide)
  (let [target (symbol! s (asm/runtime-sym! (.ta s) name))
        place (capture-place s id)
        (mut argv) (ArrayList::new [i32] (.a s))
        (mut params) (ArrayList::new [u8] (.a s))]
    (push! (mut argv) place)
    (push! (mut params) 6)
    (for a args (push! (mut argv) a))
    (for t types (push! (mut params) t))
    (match (calls/create-result 9
                                (slice params)
                                descriptors
                                (results/pieces 5 2)
                                (.a s))
      (Err [message] (fail (.name (.f s)) message))
      (Ok [proto]
          (let [called
                  (require s
                           (calls/emit! (mut (.g s))
                                        proto
                                        (.control s)
                                        target
                                        (slice argv)
                                        (.a s)))
                lo (emit! s 91 5 [called place])
                hi (emit! s 91 5 [lo (place-offset! s place 8)])]
            (set! (.control s) hi)
            (Wide :lo lo :hi hi))))))

;;; LOAD and STORE, or LOAD_v and STORE_v for an access CIR marks volatile:
;;; those Stogir never removes, forwards, moves, repeats or merges.
(defn load-opcode [(s (ptr Adapter)) (id u32)] (-> i32)
  (if (cir/volatile? (.f s) id) 92 91))

(defn store-opcode [(s (ptr Adapter)) (id u32)] (-> i32)
  (if (cir/volatile? (.f s) id) 94 93))

(defn wide-context? [(s (ptr Adapter)) (x (ptr cir/Value))] (-> bool)
  (or (= (.ty x) 2)
      (and (> (.nops x) 0) (wide-value? s (cir/operand (.f s) x 0)))
      (and (= (cast i64 (.op x)) cir/OP-STORE)
           (wide-value? s (cir/operand (.f s) x 1)))))

(defn wide-instruction! [(s (ptr Adapter)) (id u32) (x (ptr cir/Value))]
  (-> i32)
  (let [op (cast i64 (.op x))
        zero (word! s 0)
        (mut result) (Wide :lo zero :hi zero)]
    (cond (or (= op cir/OP-SEXT) (= op cir/OP-ZEXT))
            (let [v (operand s x 0)
                  bits (.imm x)
                  shifted (emit! s 49 5 [v (word! s (cast u64 (- 64 bits)))])
                  lo
                    (if (= op cir/OP-SEXT)
                        (sar! s shifted (word! s (cast u64 (- 64 bits))))
                        (emit! s
                               50
                               5
                               [shifted (word! s (cast u64 (- 64 bits)))]))]
              (when (or (< bits 1) (> bits 64))
                (fail (.name (.f s)) "invalid wide extension width"))
              (set! result
                    (Wide
                      :lo lo
                      :hi (if (= op cir/OP-SEXT) (sar! s lo (word! s 63)) zero))))
          (= op cir/OP-PAIR)
            (set! result (Wide :lo (operand s x 0) :hi (operand s x 1)))
          (= op cir/OP-LO) (set! result (Wide :lo (operand s x 0) :hi zero))
          (= op cir/OP-HI)
            (set! result
                  (Wide :lo (high-value s (cir/operand (.f s) x 0)) :hi zero))
          (= op cir/OP-LOAD)
            (let [pointer (address! s (add-offset! s (operand s x 0) (.imm x)))
                  load (load-opcode s id)
                  lo (emit! s load 5 [(.control s) pointer])
                  hi (emit! s load 5 [lo (place-offset! s pointer 8)])]
              (when (!= (& (.imm2 x) 255) 16)
                (fail (.name (.f s)) "invalid wide load extent"))
              (set! (.control s) hi)
              (set! result (Wide :lo lo :hi hi)))
          (= op cir/OP-STORE)
            (let [pointer (address! s (add-offset! s (operand s x 0) (.imm x)))
                  v (wide-operand s x 1)
                  store (store-opcode s id)
                  lo (emit! s store 0 [(.control s) pointer (.lo v)])
                  hi (emit! s store 0 [lo (place-offset! s pointer 8) (.hi v)])]
              (when (!= (.imm2 x) 16)
                (fail (.name (.f s)) "invalid wide store extent"))
              (set! (.control s) hi)
              (set! result (Wide :lo hi :hi zero)))
          (= op cir/OP-ICMP)
            (set! result
                  (Wide
                    :lo
                      (bool-word! s
                                  (wide-compare! s
                                                 (wide-operand s x 0)
                                                 (wide-operand s x 1)
                                                 (.imm x)))
                    :hi zero))
          (= op cir/OP-SELECT)
            (let [a (wide-operand s x 1)
                  b (wide-operand s x 2)
                  c (truth! s (operand s x 0))]
              (set! result
                    (Wide
                      :lo (choose! s c (.lo a) (.lo b))
                      :hi (choose! s c (.hi a) (.hi b)))))
          :else
            (let [a (wide-operand s x 0)]
              (cond (or (= op cir/OP-ADD) (= op cir/OP-SUB))
                      (set! result
                            (wide-add! s
                                       a
                                       (wide-operand s x 1)
                                       (= op cir/OP-SUB)))
                    (= op cir/OP-MUL)
                      ; By a literal power of two: a shift of the other operand.
                      (let [right (wide-power s (cir/operand (.f s) x 1))
                            left (wide-power s (cir/operand (.f s) x 0))]
                        (set! result
                              (cond (>= right 0) (wide-shift-by! s cir/OP-SHL a right)
                                    (>= left 0)
                                      (wide-shift-by! s cir/OP-SHL (wide-operand s x 1) left)
                                    :else (wide-mul! s a (wide-operand s x 1)))))
                    (and (>= op cir/OP-AND) (<= op cir/OP-XOR))
                      (set! result
                            (wide-bitwise! s
                                           (basic-op op)
                                           a
                                           (wide-operand s x 1)))
                    (and (>= op cir/OP-SHL) (<= op cir/OP-ASHR))
                      ; The count is taken modulo 128 either way.
                      (let [(mut count) (: 0 u64)
                            (mut unused) (: 0 u64)
                            amount (cir/operand (.f s) x 1)]
                        (set! result
                              (if (or (word-literal s amount (mut count))
                                      (wide-literal s amount (mut count) (mut unused)))
                                  (wide-shift-by! s op a (cast i64 (& count 127)))
                                  (wide-shift! s op a (operand s x 1)))))
                    (inline-wide-division? s x)
                      (let [(mut negative) false
                            k (wide-division-power s x (mut negative))]
                        (set! result (wide-divide-power! s op a k negative)))
                    (and (>= op cir/OP-SDIV) (<= op cir/OP-UREM))
                      (let [b (wide-operand s x 1)
                            name
                              (case op
                                19 "__divti3"
                                20 "__udivti3"
                                21 "__modti3"
                                "__umodti3")]
                        (set! result
                              (wide-runtime! s
                                             id
                                             name
                                             [(.lo a) (.hi a) (.lo b) (.hi b)]
                                             [(: 5 u8) 5 5 5]
                                             [(groups/Group
                                                :first 1
                                                :count 2
                                                :alignment 16)
                                              (groups/Group
                                                :first 3
                                                :count 2
                                                :alignment 16)])))
                    (= op cir/OP-NEG)
                      (set! result
                            (wide-add! s (Wide :lo zero :hi zero) a true))
                    (= op cir/OP-NOT)
                      (set! result
                            (Wide
                              :lo (emit! s 45 5 [(.lo a)])
                              :hi (emit! s 45 5 [(.hi a)])))
                    (or (= op cir/OP-COPY) (= op cir/OP-BITCAST))
                      (set! result a)
                    (or (= op cir/OP-CLZ) (= op cir/OP-CTZ))
                      (let [first (if (= op cir/OP-CLZ) (.hi a) (.lo a))
                            second (if (= op cir/OP-CLZ) (.lo a) (.hi a))
                            native-op
                              (if (= op cir/OP-CLZ) (: 56 i32) (: 57 i32))
                            count
                              (choose! s
                                       (cmp! s 14 first zero)
                                       (emit! s
                                              26
                                              5
                                              [(word! s 64)
                                               (emit! s native-op 5 [second])])
                                       (emit! s native-op 5 [first]))]
                        (set! result (Wide :lo count :hi zero)))
                    (= op cir/OP-POPCNT)
                      (set! result
                            (Wide
                              :lo
                                (emit! s
                                       26
                                       5
                                       [(emit! s 55 5 [(.lo a)])
                                        (emit! s 55 5 [(.hi a)])])
                              :hi zero))
                    (= op cir/OP-BSWAP)
                      (set! result
                            (Wide
                              :lo (emit! s 54 5 [(.hi a)])
                              :hi (emit! s 54 5 [(.lo a)])))
                    :else
                      (fail (.name (.f s))
                            "wide CIR operation is not implemented"))))
    (when (= (.ty x) 2)
      (set! (mut (.high-values s)) (cast i64 id) (.hi result)))
    (.lo result)))

;;; CIR atomic storage widths survive container normalization. These use the
;;; library's explicit atomic extension, with no runtime/compiler fallback.
(defn lower-atomic! [(s (ptr Adapter)) (x (ptr cir/Value))] (-> i32)
  (let [op (cast i64 (.op x))
        ty (integer-type (.imm2 x) false)
        (mut r) (: 0 i32)]
    (if (= op cir/OP-FENCE)
        (set! r (emit! s 130 0 [(.control s)]))
        (let [pointer (address! s (operand s x 0))]
          (when (< ty 0)
            (fail (.name (.f s)) "unsupported atomic storage width"))
          (if (= op cir/OP-ATOMIC-LOAD)
              (set! r (emit! s 126 ty [(.control s) pointer]))
              (let [input
                      (if (= ty 5)
                          (operand s x 1)
                          (convert! s 35 ty (operand s x 1)))]
                (cond (= op cir/OP-ATOMIC-STORE)
                        (set! r (emit! s 127 0 [(.control s) pointer input]))
                      (= op cir/OP-ATOMIC-RMW)
                        (set! r
                              (emit! s
                                     128
                                     ty
                                     [(.control s)
                                      pointer
                                      input
                                      (cast i32 (.imm x))]))
                      (= op cir/OP-CMPXCHG)
                        (let [desired
                                (if (= ty 5)
                                    (operand s x 2)
                                    (convert! s 35 ty (operand s x 2)))]
                          (set! r
                                (emit! s
                                       129
                                       ty
                                       [(.control s) pointer input desired])))
                      :else (fail (.name (.f s)) "unknown atomic operation"))))))
    (set! (.control s) r)
    (if (or (= op cir/OP-ATOMIC-LOAD)
            (= op cir/OP-ATOMIC-RMW)
            (= op cir/OP-CMPXCHG))
        (container! s ty r)
        r)))

;;; Hosted fixed copies beyond the library's promotion/unroll budget use the
;;; platform runtime. memmove preserves identical-pointer and snapshot aliasing
;;; behavior; memset handles zero fill. Smaller copies retain scalar promotion.
;;; The memmove call is declared BUILTIN-MOVE, so reads of a private copy can
;;; be forwarded to its source and an unread copy removed.
(defn runtime-fixed-bulk! [(s (ptr Adapter)) (destination i32) (source i32)
                           (count i32) (zero? bool)] (-> i32)
  (let [target (symbol! s (asm/runtime-sym! (.ta s) (if zero? "memset" "memmove")))
        second (if zero? (constant! s 10 0) source)
        (mut result) (: 0 i32)]
    (match (if zero?
               (calls/create 9 6 [(: 6 u8) 10 5] (.a s))
               (calls/create-builtin-move 9 (.a s)))
      (Err [message] (fail (.name (.f s)) message))
      (Ok [owned]
        (let [(mut prototype) owned]
          (set! result (require s (calls/emit! (mut (.g s)) prototype (.control s)
                                             target [destination second count] (.a s))))
          (calls/release! (mut prototype)))))
    result))

(defn lower-bulk! [(s (ptr Adapter)) (x (ptr cir/Value))] (-> i32)
  (let [op (cast i64 (.op x))
        destination (address! s (operand s x 0))
        count (operand s x 2)
        (mut r) (: 0 i32)]
    (cond (and (= op cir/OP-MEMSETV)
               (let [size (cir/val (.f s) (cir/operand (.f s) x 2))
                     byte (cir/val (.f s) (cir/operand (.f s) x 1))]
                 (and (= (cast i64 (.op size)) cir/OP-CONST)
                      (= (cast i64 (.op byte)) cir/OP-CONST)
                      (= (.imm byte) 0)
                      (>= (.imm size) 0)
                      (<= (.imm size) (cast i64 (bulk/inline-limit))))))
            (set! r (require s (bulk/zero! (mut (.g s)) (.control s)
                                          destination count)))
          (= op cir/OP-MEMSETV)
            (let [target (symbol! s (asm/runtime-sym! (.ta s) "memset"))
                  byte (convert! s 35 10 (operand s x 1))]
              (match (calls/create 9 6 [(: 6 u8) 10 5] (.a s))
                (Err [message] (fail (.name (.f s)) message))
                (Ok [owned]
                    (let [(mut prototype) owned]
                      (set! r
                            (require s
                                     (calls/emit! (mut (.g s))
                                                  prototype
                                                  (.control s)
                                                  target
                                                  [destination byte count]
                                                  (.a s))))
                      (calls/release! (mut prototype))))))
          (let [size (cir/val (.f s) (cir/operand (.f s) x 2))]
            (and (= (cast i64 (.op size)) cir/OP-CONST)
                 (> (.imm size) (cast i64 (bulk/inline-limit)))))
            (set! r
                  (runtime-fixed-bulk! s
                                       destination
                                       (address! s (operand s x 1))
                                       count
                                       false))
          :else
            (set! r
                  (require s
                           (if (= op cir/OP-MEMMOVEV)
                               (bulk/move! (mut (.g s))
                                           (.control s)
                                           destination
                                           (address! s (operand s x 1))
                                           count)
                               (bulk/copy! (mut (.g s))
                                           (.control s)
                                           destination
                                           (address! s (operand s x 1))
                                           count)))))
    (set! (.control s) r)
    r))

(defn floating-predicate! [(s (ptr Adapter)) (x (ptr cir/Value))] (-> i32)
  (let [left (operand s x 0)
        right (operand s x 1)
        ty (type-id s (.ty (cir/val (.f s) (cir/operand (.f s) x 0))))
        predicate (.imm x)
        opcode
          (case predicate
            0 14
            1 15
            2 16
            3 18
            4 19
            5 17
            6 15
            7 14
            8 24
            9 25
            10 20
            11 22
            12 23
            13 21
            -1)]
    (when (< opcode 0) (fail (.name (.f s)) "unknown floating predicate"))
    (let [compared
            (require s
                     (b/floating! (mut (.g s))
                                  (cast i32 opcode)
                                  ty
                                  left
                                  right
                                  0))
          result
            (cond (= predicate 1)
                    (emit! s
                           47
                           1
                           [compared
                            (require s
                                     (b/floating! (mut (.g s))
                                                  24
                                                  ty
                                                  left
                                                  right
                                                  0))])
                  (= predicate 7)
                    (emit! s
                           46
                           1
                           [compared
                            (require s
                                     (b/floating! (mut (.g s))
                                                  25
                                                  ty
                                                  left
                                                  right
                                                  0))])
                  :else compared)]
      (container! s 1 result))))

(defn numeric-conversion! [(s (ptr Adapter)) (x (ptr cir/Value))] (-> i32)
  (let [op (cast i64 (.op x))
        input (operand s x 0)]
    (cond (or (= op cir/OP-FPEXT) (= op cir/OP-FPTRUNC))
            (convert! s 39 (type-id s (.ty x)) input)
          (or (= op cir/OP-SITOFP) (= op cir/OP-UITOFP))
            (convert! s
                      37
                      (type-id s (.ty x))
                      (if (= op cir/OP-SITOFP) (convert! s 36 11 input) input))
          :else
            (let [ty (integer-type (/ (.imm x) 8) (= op cir/OP-FPTOSI))]
              (when (< ty 0)
                (fail (.name (.f s)) "unsupported FP-to-integer width"))
              (container! s ty (convert! s 38 ty input))))))

;;; CIR's integer register is a u64 container. The operation's immediate is the
;;; source width, including odd-width integers; extension bits are not operands.
(defn narrow-bit! [(s (ptr Adapter)) (x (ptr cir/Value))] (-> i32)
  (let [op (cast i64 (.op x))
        bits (.imm x)]
    (when (or (< bits 1) (>= bits 64))
      (fail (.name (.f s)) "invalid narrow bit-operation width"))
    (let [shift (word! s (cast u64 (- 64 bits)))
          mask (emit! s 50 5 [(word! s 0xffffffffffffffff) shift])
          input (emit! s 47 5 [(operand s x 0) mask])]
      (cond (= op cir/OP-CLZ) (emit! s 27 5 [(emit! s 56 5 [input]) shift])
            (= op cir/OP-CTZ)
              (choose! s
                       (cmp! s 14 input (word! s 0))
                       (word! s (cast u64 bits))
                       (emit! s 57 5 [input]))
            (= op cir/OP-POPCNT) (emit! s 55 5 [input])
            (= op cir/OP-BSWAP)
              (do
                (when (!= (% bits 8) 0)
                  (fail (.name (.f s)) "byte-swap requires whole bytes"))
                (emit! s 50 5 [(emit! s 54 5 [input]) shift]))
            :else
              (if (or (= bits 8) (= bits 16) (= bits 32))
                  (let [ty (integer-type (/ bits 8) false)
                        a (convert! s 35 ty input)
                        b (convert! s 35 ty (operand s x 1))]
                    (container! s
                                ty
                                (require s
                                         (b/integer-binary! (mut (.g s))
                                                            (basic-op op)
                                                            ty
                                                            8
                                                            a
                                                            b))))
                  (let [n
                          (emit! s
                                 30
                                 5
                                 [(operand s x 1) (word! s (cast u64 bits)) 0])
                        inverse (emit! s 27 5 [(word! s (cast u64 bits)) n])
                        a (emit! s (if (= op cir/OP-ROTL) 49 50) 5 [input n])
                        b
                          (emit! s
                                 (if (= op cir/OP-ROTL) 50 49)
                                 5
                                 [input inverse])]
                    (emit! s 47 5 [(emit! s 46 5 [a b]) mask])))))))

;;; CIR's scalar floating operations beyond the upstream opcode set, each one
;;; AArch64 instruction with the result LLVM's intrinsic has: square root, the
;;; IEEE minimum/maximum (a NaN operand gives NaN, -0 < +0) and minNum/maxNum,
;;; rounding to an integral value by FRINT's mode, and a*b+c rounded once.
(defn floating-extension! [(s (ptr Adapter)) (x (ptr cir/Value))] (-> i32)
  (let [op (cast i64 (.op x))
        ty (type-id s (.ty x))
        native
          (cond (= op cir/OP-FSQRT) 131
                (= op cir/OP-FMA) 132
                (= op cir/OP-FMIN) 133
                (= op cir/OP-FMAX) 134
                (= op cir/OP-FMINNM) 135
                (= op cir/OP-FMAXNM) 136
                (and (>= (.imm x) 0) (<= (.imm x) 4)) (+ 137 (.imm x))
                :else (fail (.name (.f s)) "unknown floating rounding mode"))]
    (unless (or (= ty 12) (= ty 13))
      (fail (.name (.f s)) "floating operation on a value that is not f32 or f64"))
    (require s
             (b/floating! (mut (.g s))
                          (cast i32 native)
                          ty
                          (operand s x 0)
                          (if (> (.nops x) 1) (operand s x 1) 0)
                          (if (= op cir/OP-FMA) (operand s x 2) 0)))))

(defn lower-instruction! [(s (ptr Adapter)) (id u32) (x (ptr cir/Value))]
  (-> i32)
  (let [op (cast i64 (.op x))
        ty (type-id s (.ty x))
        native-op (basic-op op)]
    (cond (or (= op cir/OP-CALL) (= op cir/OP-TAILCALL)) (lower-call! s id x)
          (wide-context? s x) (wide-instruction! s id x)
          (and (or (= op cir/OP-ROTL)
                   (= op cir/OP-ROTR)
                   (= op cir/OP-CLZ)
                   (= op cir/OP-CTZ)
                   (= op cir/OP-POPCNT)
                   (= op cir/OP-BSWAP))
               (!= (.imm x) 64))
            (narrow-bit! s x)
          (or (= op cir/OP-SMULH) (= op cir/OP-UMULH))
            (mul-high! s (operand s x 0) (operand s x 1) (= op cir/OP-SMULH))
          (= op cir/OP-FCMP) (floating-predicate! s x)
          (and (>= op cir/OP-FSQRT) (<= op cir/OP-FMA)) (floating-extension! s x)
          (and (>= op cir/OP-FPEXT) (<= op cir/OP-FPTOUI))
            (numeric-conversion! s x)
          (or (= op cir/OP-ATOMIC-LOAD)
              (= op cir/OP-ATOMIC-STORE)
              (= op cir/OP-ATOMIC-RMW)
              (= op cir/OP-CMPXCHG)
              (= op cir/OP-FENCE))
            (lower-atomic! s x)
          (or (= op cir/OP-MEMCPYV)
              (= op cir/OP-MEMMOVEV)
              (= op cir/OP-MEMSETV))
            (lower-bulk! s x)
          (>= native-op 0)
            (let [a (operand s x 0)
                  signed (or (= op cir/OP-SDIV) (= op cir/OP-SREM))
                  left (if signed (convert! s 36 11 a) a)
                  right
                    (if (> (.nops x) 1)
                        (let [v (operand s x 1)]
                          (if signed (convert! s 36 11 v) v))
                        0)
                  r
                    (if (= right 0)
                        (emit! s native-op ty [left])
                        (if (or (= native-op 29) (= native-op 30))
                            (emit! s
                                   native-op
                                   (if signed 11 ty)
                                   [left right (: 0 i32)])
                            (emit! s native-op (if signed 11 ty) [left right])))]
              (if signed (convert! s 36 5 r) r))
          (= op cir/OP-ICMP)
            (container! s
                        1
                        (require s
                                 (b/integer-compare! (mut (.g s))
                                                     (comparison-op (.imm x))
                                                     8
                                                     (operand s x 0)
                                                     (operand s x 1))))
          (= op cir/OP-SELECT)
            (require s
                     (b/conditional! (mut (.g s))
                                     ty
                                     (operand s x 0)
                                     (operand s x 1)
                                     (operand s x 2)))
          (or (= op cir/OP-COPY) (= op cir/OP-BITCAST))
            (convert! s 36 ty (operand s x 0))
          (or (= op cir/OP-SEXT) (= op cir/OP-ZEXT))
            (let [bits (.imm x)
                  a (operand s x 0)]
              (when (or (< bits 1) (> bits 64))
                (fail (.name (.f s)) "integer extension width must be 1..64"))
              (cond (= bits 64) a
                    (or (= bits 8) (= bits 16) (= bits 32))
                      (let [narrow (integer-type (/ bits 8) (= op cir/OP-SEXT))]
                        (container! s narrow (convert! s 35 narrow a)))
                    :else
                      (let [shift (constant! s 5 (p/cast u64 (- 64 bits)))
                            left (emit! s 49 5 [a shift])]
                        (if (= op cir/OP-SEXT)
                            (convert! s
                                      36
                                      5
                                      (emit! s
                                             51
                                             11
                                             [(convert! s 36 11 left)
                                              (convert! s 36 11 shift)]))
                            (emit! s 50 5 [left shift])))))
          (or (= op cir/OP-ADDO) (= op cir/OP-SUBO) (= op cir/OP-MULO))
            (let [bits (.imm x)
                  narrow (integer-type (/ bits 8) (!= (.imm2 x) 0))]
              (when (or (< narrow 0) (!= (% bits 8) 0))
                (fail (.name (.f s)) "unsupported checked arithmetic width"))
              (let [a (convert! s (if (= bits 64) 36 35) narrow (operand s x 0))
                    b (convert! s (if (= bits 64) 36 35) narrow (operand s x 1))
                    value
                      (emit! s
                             (cast i32 (+ 41 (- op cir/OP-ADDO)))
                             narrow
                             [a b])]
                (container! s 1 (emit! s 44 1 [value]))))
          (= op cir/OP-ADDI) (add-offset! s (operand s x 0) (.imm x))
          (= op cir/OP-PTRADD)
            (add-offset! s
                         (emit! s
                                26
                                5
                                [(operand s x 0)
                                 (emit! s
                                        28
                                        5
                                        [(operand s x 1)
                                         (constant! s 5 (p/cast u64 (.imm x)))])])
                         (.imm2 x))
          (= op cir/OP-LOAD)
            (let [bytes (& (.imm2 x) 255)
                  memty
                    (if (= ty 5)
                        (integer-type bytes (!= (& (.imm2 x) 256) 0))
                        ty)
                  pointer (address! s (add-offset! s (operand s x 0) (.imm x)))
                  r (emit! s (load-opcode s id) memty [(.control s) pointer])]
              (set! (.control s) r)
              (if (= ty 5) (container! s memty r) r))
          (= op cir/OP-STORE)
            (let [pointer (address! s (add-offset! s (operand s x 0) (.imm x)))
                  input (operand s x 1)
                  source (cir/val (.f s) (cir/operand (.f s) x 1))
                  memty
                    (if (= (.ty source) 1)
                        (integer-type (.imm2 x) false)
                        (type-id s (.ty source)))
                  r
                    (if (and (= (.ty source) 1) (< (.imm2 x) 8))
                        (convert! s 35 memty input)
                        input)
                  stored (emit! s (store-opcode s id) 0 [(.control s) pointer r])]
              (set! (.control s) stored)
              stored)
          (or (= op cir/OP-CALL) (= op cir/OP-TAILCALL)) (lower-call! s id x)
          (or (= op cir/OP-MEMCPY) (= op cir/OP-MEMZERO))
            (let [dst (address! s (operand s x 0))
                  count (constant! s 5 (p/cast u64 (.imm x)))
                  r
                    (if (> (.imm x) (cast i64 (bulk/inline-limit)))
                        (runtime-fixed-bulk! s dst
                          (if (= op cir/OP-MEMZERO) 0 (address! s (operand s x 1)))
                          count (= op cir/OP-MEMZERO))
                        (require s
                          (if (= op cir/OP-MEMZERO)
                              (bulk/zero! (mut (.g s)) (.control s) dst count)
                              (bulk/copy! (mut (.g s)) (.control s) dst
                                          (address! s (operand s x 1)) count))))]
              (set! (.control s) r)
              r)
          (= op cir/OP-DYNALLOCA)
            (let [r
                    (require s
                             (b/stack-allocate! (mut (.g s))
                                                (.control s)
                                                (operand s x 0)
                                                (cast i32 (.imm x))))]
              (set! (.control s) r)
              (convert! s 36 5 r))
          ; The CIR operations with no Stogir lowering. Each stops the build
          ; with its own reason; none is approximated.
          (= op cir/OP-SHIMCALL)
            (fail (.name (.f s))
                  "a call under a :shim (register-pinned) convention is not implemented (CIR SHIMCALL): Stogir calls use the C register assignment and clobber set only")
          (= op cir/OP-MACHINE)
            (fail (.name (.f s))
                  "inline machine-code bytes inside a function body are not implemented (CIR MACHINE)")
          (= op cir/OP-BITREV)
            (fail (.name (.f s))
                  "bit reversal is not implemented (CIR BITREV): the library has no RBIT operation")
          (= op cir/OP-VLOAD-LANE)
            (fail (.name (.f s))
                  "a V128 lane load is not implemented (CIR VLOAD-LANE): CIR vectors reach Stogir only as whole 16-byte values")
          :else
            (do
              (eprintln "stogir: {}: unsupported CIR opcode {}"
                        (.name (.f s))
                        op)
              (fail (.name (.f s)) "instruction adaptation is not implemented")))))

(defn physical-results [(s (ptr Adapter)) (x (ptr cir/Value)) (logical i32)]
  (-> i32)
  (let [(mut count) (: 0 i32)]
    (for [i 0 (cast i64 logical)]
      (let [ty
              (if (= (cast i64 (.op x)) cir/OP-RET)
                  (.ty (cir/val (.f s) (cir/operand (.f s) x (cast u32 i))))
                  (.ty x))]
        (set! count (+ count (if (= ty 2) 2 1)))))
    count))

(defn capture-place [(s (ptr Adapter)) (id u32)] (-> i32)
  (match (get (.capture-places s) id)
    (Some [place] place)
    (None [] (fail (.name (.f s)) "missing private result capture storage"))))

;;; These addresses are compiler-owned ABI temporaries, never program values.
;;; Reserve a distinct fixed-size object per site at function entry, alongside
;;; CIR ALLOCA locals. Re-executing a call must not grow the dynamic stack.
(defn reserve-capture! [(s (ptr Adapter)) (id u32)] (-> void)
  (match (get (.capture-places s) id)
    (Some [_] 0)
    (None []
          (let [x (cir/val (.f s) id)
                op (cast i64 (.op x))
                bytes
                  (cond (or (= op cir/OP-CALL) (= op cir/OP-TAILCALL))
                          (let [count (physical-results s x (cast i32 (.aux x)))]
                            (if (and (> count 1) (not (forwarded-result? s x)))
                                (* (piece-size (type-id s (.ty x)))
                                   (cast i64 count))
                                (: 0 i64)))
                        (and (= (.ty x) 2)
                             (>= op cir/OP-SDIV)
                             (<= op cir/OP-UREM)
                             (not (inline-wide-division? s x)))
                          (: 16 i64)
                        :else (: 0 i64))]
            (when (> bytes 0)
              (let [place
                      (require s
                               (b/frame-object! (mut (.g s))
                                                (.control s)
                                                (word! s (cast u64 bytes))
                                                16))]
                (set! (.control s) place)
                (set! (mut (.capture-places s)) id place)))))))

;;; Whether terminator X is a self call in tail position that runs as a jump
;;; back to the function body with the parameters replaced. This is the rule
;;; of the other CIR backend (tpde cir/a64 tail-ok?) without its register
;;; limit: every argument passed plainly with the parameter's own type, and no
;;; integer or pointer argument once an address of the frame has escaped (it
;;; could address a local, which the next iteration reuses).
(defn self-loop-site? [(s (ptr Adapter)) (x (ptr cir/Value))] (-> bool)
  (let [f (.f s)]
    (and (= (cast i64 (.op x)) cir/OP-TAILCALL)
         (>= (.self s) 0)
         (= (.imm x) (.self s))
         (= (cast i64 (.nops x)) (len (.args f)))
         (block :plain
           (for [i 0 (len (.args f))]
             (let [flags (get (.argflags f) (+ (cast i64 (.opb x)) i))
                   own (get (.arg-flags f) i)
                   ty (.ty (cir/val f (cir/operand f x (cast u32 i))))
                   float (or (= (cast i64 ty) cir/T-F32) (= (cast i64 ty) cir/T-F64))]
               (when (or (get (.arg-sret f) i)
                         (!= (& flags (: 0x1b00 u32)) 0)
                         (!= (& own (: 0x1b00 u32)) 0)
                         (!= ty (.ty (cir/val f (get (.args f) i))))
                         (and (.frame-escapes f) (not float))
                         (!= (argument-type s ty flags) (argument-type s ty own)))
                 (return-from :plain false))))
           true))))

;;; The body region of a function with self-loop sites: the entry path and one
;;; reserved edge per site meet in a MERGE, and every parameter becomes a PHI
;;; over its incoming value and the arguments of each site.
(defn open-self-loop! [(s (ptr Adapter)) (sites i64)] (-> void)
  (let [f (.f s)
        (mut inputs) (ArrayList::new [i32] (.a s))]
    (push! (mut inputs) (reserve! s 114 0 [(.control s)]))
    (for [i 0 sites]
      (let [end (reserve! s 114 0 [(: 0 i32)])]
        (push! (mut inputs) end)
        (push! (mut (.self-ends s)) end)))
    (let [region (emit! s 112 0 (slice inputs))]
      (set! (.control s) region)
      (for [i 0 (len (.args f))]
        (let [id (get (.args f) i)
              (mut low) (ArrayList::new [i32] (.a s))
              (mut high) (ArrayList::new [i32] (.a s))
              wide (= (.ty (cir/val f id)) 2)]
          (push! (mut low) region)
          (push! (mut low) (get (.values s) (cast i64 id)))
          (push! (mut high) region)
          (push! (mut high) (get (.high-values s) (cast i64 id)))
          (for [k 0 sites] (push! (mut low) 0) (push! (mut high) 0))
          (let [phi (reserve! s 67 (type-id s (.ty (cir/val f id))) (slice low))]
            (push! (mut (.self-phis s)) phi)
            (set! (mut (.values s)) (cast i64 id) phi))
          (if wide
              (let [phi (reserve! s 67 5 (slice high))]
                (push! (mut (.self-high-phis s)) phi)
                (set! (mut (.high-values s)) (cast i64 id) phi))
              (push! (mut (.self-high-phis s)) 0))
          (free! (mut low))
          (free! (mut high)))))
    (free! (mut inputs))))

;;; Self-loop site X: each parameter PHI receives the argument exactly as the
;;; call would deliver it (narrowed to the parameter's ABI type and widened
;;; again by the callee), and control returns to the body region.
(defn close-self-loop! [(s (ptr Adapter)) (x (ptr cir/Value))] (-> void)
  (let [f (.f s)
        site (.self-next s)
        slot (cast i32 (+ site 3))
        end (get (.self-ends s) site)]
    (for [i 0 (len (.args f))]
      (let [id (get (.args f) i)
            argid (cir/operand f x (cast u32 i))
            ty (argument-type s (.ty (cir/val f id)) (get (.arg-flags f) i))
            v (value s argid)
            passed
              (if (= ty 6)
                  (address! s v)
                  (if (and (>= ty 1) (<= ty 10) (!= ty 5) (!= ty 6))
                      (convert! s 35 ty v)
                      v))]
        (require s (b/patch! (mut (.g s)) (get (.self-phis s) i) slot (container! s ty passed)))
        (when (= (.ty (cir/val f id)) 2)
          (require s
                   (b/patch! (mut (.g s))
                             (get (.self-high-phis s) i)
                             slot
                             (high-value s argid))))))
    (require s (b/patch! (mut (.g s)) end 1 (.control s)))
    (push! (mut (.exits s)) end)
    (set! (.self-next s) (+ site 1))))

(defn translate! [(s (ptr Adapter))] (-> void)
  (let [f (.f s)
        (mut argtypes) (ArrayList::new [u8] (.a s))
        (mut ret-type) (: 0 i32)
        (mut needed) (ArrayList::new [bool] (.a s))]
    (for [i 0 (len (.values f))]
      (push! (mut (.values s)) 0)
      (push! (mut (.high-values s)) 0))
    (prepare-control! s)
    (for [i 0 (len (.values f))] (push! (mut needed) false))
    (for block (.order s)
      (let [bb (cir/blk f (cast u32 block))]
        (for [j (cast i64 (.ibegin bb)) (cast i64 (.iend bb))]
          (let [x (cir/val f (get (.insts f) j))]
            (for [k 0 (cast i64 (.nops x))]
              (set! (mut needed) (cast i64 (cir/operand f x (cast u32 k))) true))))
        (for [j 0 (cast i64 (.phi-count bb))]
          (let [x (cir/val f (get (.phis f) (+ (cast i64 (.phi-begin bb)) j)))]
            (for [k 0 (cast i64 (.nops x))]
              (set! (mut needed) (cast i64 (cir/operand f x (cast u32 k))) true))))))
    (set! (.return-count s) -1)
    (for block (.order s)
      (let [x (cir/val f (.term (cir/blk f (cast u32 block))))
            op (cast i64 (.op x))]
        (when (or (= op cir/OP-RET) (= op cir/OP-TAILCALL))
          (let [count
                  (if (= op cir/OP-RET)
                      (cast i32 (.nops x))
                      (cast i32 (.aux x)))
                count (physical-results s x count)
                ty
                  (if (= count 0)
                      0
                      (if (= op cir/OP-RET)
                          (type-id s (.ty (cir/val f (cir/operand f x 0))))
                          (type-id s (.ty x))))]
            (when (and (>= (.return-count s) 0)
                       (or (!= count (.return-count s))
                           (!= ty (.return-type s))))
              (fail (.name f) "inconsistent return register shapes"))
            (when (= op cir/OP-RET)
              (for [i 0 (cast i64 (.nops x))]
                (unless (= ty
                           (type-id s
                                    (.ty (cir/val f
                                                  (cir/operand f x (cast u32 i))))))
                  (fail (.name f)
                        "mixed aggregate return registers are unsupported"))))
            (set! (.return-count s) count)
            (set! (.return-type s) ty)))))
    (when (> (.return-count s) 1)
      (push! (mut argtypes) 6)
      (set! (.return-place s) (emit! s 71 6 [(.start s) (: 0 i32) 0])))
    (for [i 0 (len (.args f))]
      (let [id (get (.args f) i)
            x (cir/val f id)
            ty
              (if (get (.arg-sret f) i)
                  6
                  (argument-type s (.ty x) (get (.arg-flags f) i)))
            ordinal (cast i32 (len argtypes))
            r (emit! s 71 ty [(.start s) (: 0 i32) ordinal])]
        (when (get (.arg-sret f) i)
          (when (or (!= i 0) (> (.return-count s) 0))
            (fail (.name f) "invalid function indirect result shape"))
          (set! (.indirect-result s) true))
        (push! (mut argtypes) (cast u8 ty))
        (set! (mut (.values s)) (cast i64 id) (container! s ty r))
        (when (= (.ty x) 2)
          (push! (mut argtypes) 5)
          (set! (mut (.high-values s))
                (cast i64 id)
                (emit! s 71 5 [(.start s) (: 0 i32) (+ ordinal 1)])))))
    (for [i 0 (len (.values f))]
      (let [x (cir/val f (cast u32 i))
            op (cast i64 (.op x))]
        (when (get needed i)
          (cond (= op cir/OP-CONST)
                  (do
                    (set! (mut (.values s))
                          i
                          (constant! s
                                     (type-id s (.ty x))
                                     (p/cast u64 (.imm x))))
                    (when (= (.ty x) 2)
                      (set! (mut (.high-values s))
                            i
                            (word! s (p/cast u64 (.imm2 x))))))
                (= op cir/OP-SYM)
                  (set! (mut (.values s))
                        i
                        (add-offset! s
                                     (convert! s
                                               36
                                               5
                                               (symbol! s (cast u32 (.imm x))))
                                     (.imm2 x)))
                (= op cir/OP-ALLOCA)
                  (let [size (constant! s 5 (p/cast u64 (.imm x)))
                        alignment (cast i32 (.imm2 x))
                        r (require s
                                   (if (> (.imm x) 0)
                                       (b/frame-object! (mut (.g s)) (.control s) size alignment)
                                       (b/stack-allocate! (mut (.g s)) (.control s) size alignment)))]
                    (set! (.control s) r)
                    (set! (mut (.values s)) i (convert! s 36 5 r)))
                :else 0))))
    ; All private result objects precede the first reachable block's body.
    ; The map handles a terminator also present in the instruction range once.
    (for block (.order s)
      (let [bb (cir/blk f (cast u32 block))]
        (for [j (cast i64 (.ibegin bb)) (cast i64 (.iend bb))]
          (reserve-capture! s (get (.insts f) j)))
        (reserve-capture! s (.term bb))))
    (let [(mut sites) 0]
      (for block (.order s)
        (when (self-loop-site? s (cir/val f (.term (cir/blk f (cast u32 block)))))
          (set! sites (+ sites 1))))
      (when (> sites 0) (open-self-loop! s sites)))
    (for block (.order s)
      (unless (= block 0) (set! (.control s) (get (.regions s) block)))
      (let [bb (cir/blk f (cast u32 block))]
        (for [j (cast i64 (.ibegin bb)) (cast i64 (.iend bb))]
          (let [id (get (.insts f) j)
                x (cir/val f id)
                op (cast i64 (.op x))]
            (unless (= id (.term bb))
              (set! (mut (.values s)) (cast i64 id) (lower-instruction! s id x)))))
        (let [x (cir/val f (.term bb))
              op (cast i64 (.op x))]
          (cond (= op cir/OP-CONDBR)
                  (let [branch (get (.branches s) block)
                        condition (truth! s (operand s x 0))]
                    (require s (b/patch! (mut (.g s)) branch 1 (.control s)))
                    (require s (b/patch! (mut (.g s)) branch 2 condition)))
                (= op cir/OP-SWITCH)
                  (let [branch (get (.branches s) block)]
                    (require s (b/patch! (mut (.g s)) branch 1 (.control s)))
                    (require s (b/patch! (mut (.g s)) branch 2 (operand s x 0))))
                (= op cir/OP-BR)
                  (for [k 0 (len (.ends s))]
                    (when (= (get (.from s) k) block)
                      (require s
                               (b/patch! (mut (.g s))
                                         (get (.ends s) k)
                                         1
                                         (.control s)))))
                (self-loop-site? s x) (close-self-loop! s x)
                (or (= op cir/OP-RET) (= op cir/OP-TAILCALL))
                  (let [r
                          (if (= op cir/OP-TAILCALL)
                              (let [called (lower-call! s (.term bb) x)]
                                (if (= (.return-count s) 0) 0 called))
                              (if (= (.nops x) 0) 0 (operand s x 0)))
                        count (.return-count s)]
                    (if (> count 1)
                        (do
                          ; A forwarded call already wrote the result place.
                          (unless (forwarded-result? s x)
                          (let [(mut offset) 0
                                logical
                                  (if (= op cir/OP-TAILCALL)
                                      (cast i64 (.aux x))
                                      (cast i64 (.nops x)))]
                            (for [i 0 logical]
                              (let [source-id
                                      (if (= op cir/OP-TAILCALL)
                                          (+ (.term bb) (cast u32 i))
                                          (cir/operand f x (cast u32 i)))
                                    wide (wide-value? s source-id)
                                    piece (value s source-id)
                                    stored
                                      (emit! s
                                             93
                                             0
                                             [(.control s)
                                              (place-offset! s
                                                             (.return-place s)
                                                             offset)
                                              piece])]
                                (set! (.control s) stored)
                                (set! offset
                                      (+ offset (piece-size (.return-type s))))
                                (when wide
                                  (set! (.control s)
                                        (emit! s
                                               93
                                               0
                                               [(.control s)
                                                (place-offset! s
                                                               (.return-place s)
                                                               offset)
                                                (high-value s source-id)]))
                                  (set! offset (+ offset 8)))))))
                          (push! (mut (.exits s))
                                 (emit! s 120 0 [(.control s) (: 0 i32) 0])))
                        (push! (mut (.exits s))
                               (emit! s
                                      120
                                      (.return-type s)
                                      [(.control s) r (: 0 i32)]))))
                (= op cir/OP-UNREACHABLE)
                  (push! (mut (.exits s))
                         (require s
                                  (b/unreachable! (mut (.g s)) (.control s) 0)))
                :else (fail (.name f) "unsupported terminator")))))
    (for block (.order s)
      (let [bb (cir/blk f (cast u32 block))]
        (for [j 0 (cast i64 (.phi-count bb))]
          (let [id (get (.phis f) (+ (cast i64 (.phi-begin bb)) j))
                x (cir/val f id)
                phi (get (.values s) (cast i64 id))
                (mut slot) (: 2 i32)]
            (for [k 0 (len (.ends s))]
              (when (= (get (.to s) k) block)
                (let [(mut found) false]
                  (for [n 0 (cast i64 (.nops x))]
                    (when (= (cast i64
                                   (cir/operand f x (+ (.nops x) (cast u32 n))))
                             (get (.from s) k))
                      (require s
                               (b/patch! (mut (.g s))
                                         phi
                                         slot
                                         (operand s x (cast u32 n))))
                      (when (= (.ty x) 2)
                        (require s
                                 (b/patch! (mut (.g s))
                                           (get (.high-values s) (cast i64 id))
                                           slot
                                           (high-value s
                                                       (cir/operand f
                                                                    x
                                                                    (cast u32 n))))))
                      (set! found true)))
                  (unless found (fail (.name f) "phi predecessor is missing")))
                (set! slot (+ slot 1))))))))
    (let [(mut descriptors) (ArrayList::new [groups/Group] (.a s))
          (mut group-end) (: 0 i32)
          offset (if (> (.return-count s) 1) (: 1 i32) 0)]
      (let [(mut ordinal) offset]
        (for [i 0 (len (.args f))]
          (let [wide (wide-value? s (get (.args f) i))]
            (if wide
                (do
                  (push! (mut descriptors)
                         (groups/Group
                           :first ordinal
                           :count 2
                           :alignment 16))
                  (set! group-end (+ ordinal 2)))
                (append-group! s
                               (mut descriptors)
                               ordinal
                               (get (.arg-flags f) i)
                               (cast i32 (get argtypes (cast i64 ordinal)))
                               (mut group-end)))
            (set! ordinal (+ ordinal (if wide 2 1))))))
      (match (if (or (.indirect-result s) (> (.return-count s) 1))
                 (calls/create-result 9
                                      (slice argtypes)
                                      (slice descriptors)
                                      (if (.indirect-result s)
                                          (results/indirect)
                                          (results/pieces (cast u8
                                                                (.return-type s))
                                                          (.return-count s)))
                                      (.a s))
                 (calls/create-grouped 9
                                       (cast u8 (.return-type s))
                                       (slice argtypes)
                                       (slice descriptors)
                                       (.a s)))
        (Err [message] (fail (.name f) message))
        (Ok [prototype]
            (require s (calls/function! (mut (.g s)) prototype (.a s))))))))

;;; The image symbol named by the address slot at data OFFSET, or -1.
(defn slot-of [(targets (ArrayList i32)) (offset i64)] (-> i32)
  (if (and (>= offset 0) (= (% offset 8) 0) (< (/ offset 8) (len targets)))
      (get targets (/ offset 8))
      -1))

;;; Merge independent stogir bytes into the compiler's existing module transport.
;;; The image reaches a named symbol through a private eight-byte address slot
;;; (ADRP/LDR of a data word relocated to the symbol). Here that is exactly a
;;; GOT load, so each reference to a slot becomes the GOT-load relocation pair
;;; against the symbol itself and the slot's own relocation is dropped: the
;;; linker turns the load into ADRP/ADD when the symbol is defined in the
;;; linked image and keeps one shared GOT entry otherwise. Data holding nothing
;;; but slots is not emitted at all.
(defn merge! [(s (ptr Adapter)) (source image/Image) (symbol u32) (module (ptr Module))] (-> void)
  (let [ta (.ta s)
        text-base
          (asm/sect-append! ta
                            asm/SEC-TEXT
                            (.data (.text source))
                            (len (.text source))
                            (.text-alignment source))
        ; Per data word: the image symbol its address slot names, or -1.
        (mut slot-target) (ArrayList::new [i32] (.a s))
        (mut slots) (: 0 i64)
        _ (for r (.relocations source)
            (when (and (= (.section r) 2) (= (.kind r) 1) (= (.addend r) 0)
                       (= (% (.offset r) 8) 0))
              (while (<= (len slot-target) (/ (.offset r) 8)) (push! (mut slot-target) -1))
              (set! (mut slot-target) (/ (.offset r) 8) (.symbol r))
              (set! slots (+ slots 1))))
        slots-only (and (> slots 0) (= (len (.data source)) (* slots 8)))
        data-base
          (if slots-only
              -1
              (asm/sect-append! ta
                                asm/SEC-DATA-CONST
                                (.data (.data source))
                                (len (.data source))
                                (.data-alignment source)))
        (mut mapping) (ArrayList::new [u32] (.a s))]
    (for range (.text-data source)
      (push! (.text-data s)
             (MTextData
               :section 0
               :offset (+ text-base (.offset range))
               :length (.length range)
               :kind (.kind range))))
    (for [i 0 (len (.symbols source))]
      (let [sy (get (.symbols source) i)
            (mut mapped) (cir/none)]
        (if (= (.section sy) 0)
            (for [j 0 (len (.import-ids s))]
              (when (image/same-name? source sy (get (.import-names s) j))
                (set! mapped (get (.import-ids s) j))))
            (if (image/same-name? source sy "_coil_stogir_body")
                (set! mapped symbol)
                ; An address slot gets no symbol: nothing refers to it below.
                (unless (and (= (.section sy) 2) (>= (slot-of slot-target (.offset sy)) 0))
                  (set! mapped
                        (asm/sym-add-anon! ta
                                           (if (= (.section sy) 1)
                                               asm/SEC-TEXT
                                               asm/SEC-DATA-CONST)
                                           (+ (if (= (.section sy) 1)
                                                  text-base
                                                  data-base)
                                              (.offset sy))
                                           0)))))
        (when (and (= (.section sy) 0) (!= (p/cast usize module) 0)
                   (> (.native-certified module) 0))
          (match (private/binding (.native-context module) (.native-publication module)
                                  (p/cast usize ta) (native-link/name source sy))
            (None [] 0)
            (Some [target]
              (unless (and (= mapped (cast u32 target))
                           (= (.binding (asm/sym-at ta mapped)) asm/BIND-LOCAL)
                           (= (.sect (asm/sym-at ta mapped)) asm/SEC-TEXT))
                (fail (.name (.f s)) "private native binding differs from publication")))))
        (when (and (= mapped (cir/none))
                   (not (and (= (.section sy) 2) (>= (slot-of slot-target (.offset sy)) 0))))
          (fail (.name (.f s)) "unmapped image symbol"))
        (push! (mut mapping) mapped)))
    (for r (.relocations source)
      (when (or (not (or (= (.section r) 1) (= (.section r) 2)))
                (!= (.addend r) 0))
        (eprintln "stogir relocation: section {}, kind {}, addend {}"
                  (.section r)
                  (.kind r)
                  (.addend r))
        (fail (.name (.f s)) "unsupported image relocation section or addend"))
      (let [sy (get (.symbols source) (cast i64 (.symbol r)))
            named (if (= (.section sy) 2) (slot-of slot-target (.offset sy)) -1)]
        (cond
          ; The slot's own relocation: every reference to it is rewritten.
          (and (= (.section r) 2) (= (.kind r) 1) (>= (slot-of slot-target (.offset r)) 0)) 0
          (>= named 0)
            (do
              (unless (and (= (.section r) 1) (or (= (.kind r) 3) (= (.kind r) 4)))
                (fail (.name (.f s)) "address slot referenced by something other than its load"))
              ; The pair must be the 64-bit LDR of the slot for the GOT form.
              (when (and (= (.kind r) 4)
                         (!= (& (buf/read32 (asm/sect-buf ta asm/SEC-TEXT) (+ text-base (.offset r)))
                                (: 0xFFC00000 u32))
                             (: 0xF9400000 u32)))
                (fail (.name (.f s)) "address slot is not read by a 64-bit load"))
              (asm/reloc! ta asm/SEC-TEXT (+ text-base (.offset r))
                          (get mapping (cast i64 named))
                          (if (= (.kind r) 3) asm/R-GOT-PAGE21 asm/R-GOT-PAGEOFF12)
                          0))
          :else
            (do
              (when (and (= (.section r) 2) slots-only)
                (fail (.name (.f s)) "relocation in data that was not emitted"))
              (asm/reloc! ta
                          (if (= (.section r) 1) asm/SEC-TEXT asm/SEC-DATA-CONST)
                          (+ (if (= (.section r) 1) text-base data-base) (.offset r))
                          (get mapping (cast i64 (.symbol r)))
                          (case (.kind r)
                            1 asm/R-ABS64
                            2 asm/R-BRANCH26
                            3 asm/R-PAGE21
                            4 asm/R-PAGEOFF12
                            (fail (.name (.f s)) "unsupported image relocation kind"))
                          0)))))
    (free! (mut slot-target))
    (asm/sym-def! ta symbol asm/SEC-TEXT text-base (len (.text source)))))

(defstruct Definition
  [(inlineable bool)
   ; The source is :inline (Always); the policy decides whether that is honored.
   (always bool)
   ; Not inlineable, but its only call cycle is its calls of itself. Those
   ; stay calls in every clone, so it expands only where expand-module! says.
   (recursive bool)
   ; The graph is sccp/optimize-memory output for its observed roots and has
   ; not changed since, so emission may skip the image's entry SCCP.
   (clean bool)
   ; What the finalized body may do to caller-visible memory (see
   ; call-effects/summarize); not present until then.
   (effects groups/Effects)
   (callee-handle i64)
   (symbol u32)
   (graph graph/Graph)
   (entry i32)
   (roots (ArrayList i32))
   (observed (ArrayList i32))
   (inline-controls (ArrayList i32))
   (name (slice u8))
   (source (ptr cir/Func))
   (import-names (ArrayList (slice u8)))
   (import-ids (ArrayList u32))
   ; Content proof of graph (see Adapter), or zero.
   (proof u128)
   ; Growth budget left when the template was finalized.
   (left i32)
   ; Cells a clone of the finalized template reserves (inlining/base-clone-cells).
   (cells i64)
   ; Finalized without the call and sparse exemptions (see template-policy).
   (deferred bool)])

;;; A non-template caller owns its final graph in a stable arena until emitted.
;;; Registry snapshots remain frozen; these bodies are never registered callees.
(defstruct EmissionBody
  [(definition Definition) (arena (ptr scratch/ScratchArena))])

;;; Candidate images are generated once before callers and published at their
;;; original assembler symbols. They remain owned until final byte verification.
(defstruct NativeCache
  [(source (ptr cir/Func)) (symbol u32) (name (slice u8)) (label (slice u8))
   (image image/Image) (certified bool)])

;;; Prepared once in source submission order, then immutable during emission.
;;; The module allocator owns every definition until all jobs have finished.
(defstruct Module
  [(a (dyn Allocator))
   (trace bool)
   (inline InlineSettings)
   ; Build each frame only on paths that need it (a64.shrink-wrap).
   (shrink-wrap bool)
   ; Allocate a second time, preserved registers late, to widen that region.
   (shrink-retry bool)
   ; Lower an exhaustive SWITCH without its unreachable default comparison.
   (prune-default bool)
   ; Reload spilled values used in a loop at the loop entry.
   (loop-reloads bool)
   ; Evict a preserved register's holder unused in a loop for a loop value.
   (loop-evict bool)
   ; Keep a value in its register around a call, stored only across it.
   (call-holes bool)
   ; Cut call-crossing values at framed blocks and release the frame where
   ; they rejoin frameless code (stogir.allocation-spans, a64.shrink-wrap).
   (frame-split bool)
   ; Order blocks by static branch prediction (block-layout.predict!).
   (predict bool)
   ; Rotate exit-test loop headers before code generation (stogir.loop-rotate).
   (rotate bool)
   (branch-facts bool)
   (induction bool)
   (recolor bool)
   (regional bool)
   (global-loads bool)
   (if-convert bool)
   (select bool)
   (hoist-loads bool)
   (strength bool)
   ; Summarize every finalized body (call-effects/summarize) and give its
   ; direct calls the full effect record, optimizing a template once more
   ; when the records enable it. Off, a body is only classified non-writing.
   (effects bool)
   ; COIL_STOGIR_GRAPH: the function whose graph and allocation are traced.
   (graph (slice u8))
   (frozen bool)
   (callees inlining/Registry)
   (definitions (ArrayList Definition))
   (bodies (ArrayList EmissionBody))
   (body-by-symbol (ArrayList i64))
   (by-symbol (ArrayList i64))
   ; Symbols of the functions declared :inline (Never).
   (outlined (ArrayList bool))
   ; Direct call instructions per target symbol over every submitted function.
   (call-sites (ArrayList i32))
   (bindings (HashMap (slice u8) u32))
   (native-context private/Context)
   (native-publication private/Publication)
   (native-target (ptr asm/Asm))
   (native-cache (ArrayList NativeCache))
   (native-by-symbol (ArrayList i64))
   (native-certified i64)])

(defn module-create [(a (dyn Allocator)) (trace bool)] (-> Module)
  (module-create-with a trace (settings-read)))

;;; Every option of a module comes from SETTINGS, so settings-key describes it.
(defn module-create-with [(a (dyn Allocator)) (trace bool) (settings Settings)] (-> Module)
  (Module
    :a a
    :trace trace
    :graph (.graph settings)
    :inline (inline-settings-from a (.inline settings))
    :shrink-wrap (.shrink-wrap settings)
    :shrink-retry (.shrink-retry settings)
    :prune-default (.prune-default settings)
    :loop-reloads (.loop-reload settings)
    :loop-evict (.loop-evict settings)
    :call-holes (.call-holes settings)
    :frame-split (.frame-split settings)
    :predict (.predict settings)
    :rotate (.rotate settings)
    :branch-facts (.branch-facts settings)
    :induction (.induction settings)
    :recolor (.recolor settings)
    :regional (.regional settings)
    :global-loads (.global-loads settings)
    :if-convert (.if-convert settings)
    :select (.select settings)
    :hoist-loads (.hoist-loads settings)
    :strength (.strength settings)
    :effects (.effects settings)
    :frozen false
    :callees (inlining/registry-create 8 a)
    :definitions (ArrayList::new [Definition] a)
    :bodies (ArrayList::new [EmissionBody] a)
    :body-by-symbol (ArrayList::new [i64] a)
    :by-symbol (ArrayList::new [i64] a)
    :outlined (ArrayList::new [bool] a)
    :call-sites (ArrayList::new [i32] a)
    :bindings (HashMap::new [(slice u8) u32] a (keyops-borrowed))
    :native-context (private/no-context)
    :native-publication (private/no-publication)
    :native-target (p/cast (ptr asm/Asm) 0)
    :native-cache (ArrayList::new [NativeCache] a)
    :native-by-symbol (ArrayList::new [i64] a)
    :native-certified 0))

;;; adapt-as! for a function whose own symbol is not known: a call to itself
;;; is then a call like any other.
(defn adapt! [(s (ptr Adapter))
              (f (ptr cir/Func))
              (ta (ptr asm/Asm))
              (text-data (ptr (ArrayList MTextData)))
              (a (dyn Allocator))] (-> void)
  (adapt-as! s f ta -1 text-data a))

;;; SELF is the symbol F is emitted as (or -1): a marked call to it in tail
;;; position can then jump back to the body (self-loop-site?).
(defn adapt-as! [(s (ptr Adapter))
                 (f (ptr cir/Func))
                 (ta (ptr asm/Asm))
                 (self i64)
                 (text-data (ptr (ArrayList MTextData)))
                 (a (dyn Allocator))] (-> void)
  (set! (.a s) a)
  (set! (.f s) f)
  (set! (.ta s) ta)
  (set! (.text-data s) text-data)
  (set! (.g s) (graph/create a))
  (set! (.values s) (ArrayList::new [i32] a))
  (set! (.high-values s) (ArrayList::new [i32] a))
  (set! (.capture-places s) (HashMap::new-scalar [u32 i32] a))
  (set! (.regions s) (ArrayList::new [i32] a))
  (set! (.order s) (ArrayList::new [i64] a))
  (set! (.from s) (ArrayList::new [i64] a))
  (set! (.to s) (ArrayList::new [i64] a))
  (set! (.ends s) (ArrayList::new [i32] a))
  (set! (.branches s) (ArrayList::new [i32] a))
  (set! (.exits s) (ArrayList::new [i32] a))
  (set! (.self s) self)
  (set! (.self-ends s) (ArrayList::new [i32] a))
  (set! (.self-phis s) (ArrayList::new [i32] a))
  (set! (.self-high-phis s) (ArrayList::new [i32] a))
  (set! (.self-next s) 0)
  (set! (.import-names s) (ArrayList::new [(slice u8)] a))
  (set! (.import-ids s) (ArrayList::new [u32] a))
  (set! (.start s) (emit! s 104 0 [(: 0 i32)]))
  (set! (.control s) (.start s))
  (translate! s)
  ; RETURN/UNREACHABLE already observe all terminating paths. Every cycle
  ; contains an edge that does not increase a total block order; observing
  ; those edges also preserves paths that never reach a terminal. Intermediate
  ; acyclic branch identities are implementation details, not program outputs.
  (let [(mut positions) (ArrayList::new [i64] a)]
    (for [i 0 (len (.blocks f))] (push! (mut positions) -1))
    (for [i 0 (len (.order s))]
      (set! (mut positions) (get (.order s) i) i))
    (for [i 0 (len (.ends s))]
      (let [from (get positions (get (.from s) i))
            to (get positions (get (.to s) i))]
        (when (or (< from 0) (< to 0))
          (fail (.name f) "control observation references an unordered block"))
        (when (<= to from)
          (push! (mut (.exits s)) (get (.ends s) i)))))
    (free! (mut positions))))

(defn own-definition! [(definition (ptr Definition))
                       (source graph/Graph)
                       (observed (slice i32))
                       (names (slice (slice u8)))
                       (ids (slice u32))
                       (a (dyn Allocator))] (-> void)
  ; A new owned graph version must acquire its own immutable proof.
  (set! (.callee-handle definition) 0)
  (set! (.effects definition) (groups/no-effects))
  (set! (.graph definition) (graph/duplicate source a))
  (set! (.roots definition) (ArrayList::new [i32] a))
  (set! (.observed definition) (ArrayList::new [i32] a))
  (set! (.inline-controls definition) (ArrayList::new [i32] a))
  ; CIR supplies block-end control observations. Optimization may additionally
  ; retain pure value identities (for example a CALL rewritten to COPY). Keep
  ; those anchors for this definition's own optimization, but do not promote
  ; them to unconditional observations in a specialized caller. Function values
  ; remain connected through RETURN; all control effects and side exits remain
  ; explicit, and the library still checks closure against this control view.
  (for root observed
    (push! (mut (.observed definition)) root)
    (match (graph/lookup source root)
      (None []
            (fail (.name (.source definition)) "template observation missing"))
      (Some [value]
            (when (opcode/control? (cast i32 (node/opcode value)))
              (push! (mut (.inline-controls definition)) root)))))
  (let [(mut r) 1]
    (while (< r (len (.instructions source)))
      (when (= (node/opcode (get (.instructions source) r)) 120)
        (push! (mut (.roots definition)) (cast i32 r)))
      (set! r (+ r (/ (+ (cast i64 (get (.arities source) r)) 4) 4)))))
  (set! (.import-names definition) (ArrayList::new [(slice u8)] a))
  (set! (.import-ids definition) (ArrayList::new [u32] a))
  (for name names (push! (mut (.import-names definition)) (sconcat a name "")))
  (for id ids (push! (mut (.import-ids definition)) id)))

;;; Analyses and adapter temporaries die with this scratch arena; only bounded
;;; definitions and their explicit symbol bindings enter the module allocator.
(defn inline-budget [] (-> i32)
  512)

;;; Module inline expansion policy. With COIL_STOGIR_INLINE unset it is
;;; inline-default-text: the fixed 512-cell budget and template bound, plus
;;; :inline (Always) templates at every site, inlined frame objects in the
;;; caller's static frame, callees with calls of at most 128 cloned cells
;;; uncharged in :inline (Never) functions, forwarders, self-recursive
;;; templates, templates of at most 256 cells kept free of larger callees
;;; (wrap), call-free callees of at most 80 cells uncharged at call sites
;;; inside loops, and callees of at most 40 cells around exactly one call
;;; uncharged at every site (thunk). On the compiler itself the first five are about 3% fewer
;;; host cycles for about 1.5% more generation; wrap is 0.1B fewer executed
;;; calls and 0.9B fewer loads and stores for 0.2% less generation, and the
;;; loop exemption another 0.2B calls and 0.7B loads and stores for about 1.2%
;;; more generation; thunk is 0.22B fewer executed direct calls, 0.4B fewer
;;; loads and 0.3B fewer stores for about 0.1% more generation (exact counts,
;;; November 10, 2026).
;;; COIL_STOGIR_INLINE, when set, replaces the default entirely: every key it
;;; does not name takes the value shown first below, not the default policy's.
;;; So COIL_STOGIR_INLINE=budget=512 (or the empty value) is the policy with
;;; no exemption at all, which was the default before November 10, 2026.
;;; It is comma-separated key=value pairs: budget=N (per-caller growth, 0..16384),
;;; template=N (largest registered template, 0..16384), small=N (sites cloning
;;; at most N cells are not charged), small-scope=loop|any, indirect=0|1 (callees
;;; with dyn/pointer calls), pair=0|1 (callees with two-register-result calls),
;;; always=0|1 (:inline (Always) templates inline at every site, uncharged),
;;; small-leaf=0|1 (the small exemption applies only to callees without calls),
;;; hoist=0|1 (inlined callees' frame objects join the caller's static frame
;;; instead of a dynamic stack scope), calls=N (sites cloning at most N cells
;;; are not charged even when the callee contains calls, of any shape),
;;; forward=0|1 (a caller whose only call is the site takes a callee with calls
;;; of any shape, charged), self=0|1 (a function whose only recursion is calling
;;; itself is a template for callers whose only call is that one), sparse=N
;;; with growth=G (as calls=N, for a callee whose cells times its direct call
;;; instructions in the module is at most G), exempt=never|bodies|all (the
;;; calls and sparse exemptions apply in :inline (Never) functions, which are
;;; emitted once and cloned nowhere; in every function that is not a template;
;;; or in templates as well),
;;; keep=N (under exempt=all a template of at most N cells still goes without
;;; them, so what its callers clone stays as small as before), final=0|1 (such
;;; a template gets them in its own emitted body, expanded once more),
;;; wrap=N (a template whose clone is at most N cells expands no call of a
;;; callee whose clone is larger than N: its callers clone the small body and
;;; decide the call in their own context, and its own emitted body takes the
;;; call then), small-caller=N (under small-scope=loop the small exemption
;;; also applies at every site of a function whose clone is at most N cells),
;;; small-charge=0|1 (a site the small exemption takes is charged while the
;;; budget lasts, so the exemption adds growth only where the budget is spent),
;;; thunk=N (a callee of at most N cloned cells that contains exactly one call,
;;; of any shape, inlines uncharged at every site, in templates too: the clone
;;; trades one executed call for one and drops a frame. A template that takes
;;; a thunk around a pointer or two-register-result call is then itself a
;;; call at sites whose policy does not clone that shape).
;;; Any other key or value is a hard error. A unit's key records the settings
;;; it was generated under (settings-key), so a cached unit is rebuilt when
;;; any of them differs.
(defstruct InlineSettings [(policy inlining/Policy) (template i32) (self bool) (growth i32)
                           (keep i32)
                           ; Templates of at most this many cells stay that small (wrap=N).
                           (wrap i32)
                           ; Where the calls and sparse exemptions apply: 0 in :inline (Never)
                           ; functions, 1 in every function that is not a template, 2 everywhere.
                           (scope i32) (final bool)])

(defn inline-default-text [] (-> (slice u8))
  "hoist=1,always=1,forward=1,self=1,calls=128,wrap=256,small=80,small-scope=loop,small-leaf=1,thunk=40")

(defn inline-setting-int [(key (slice u8)) (value (slice u8))] (-> i32)
  (match (str/parse-int value)
    (None [] (tl-inline-fail key value))
    (Some [n] (if (or (< n 0) (> n 16384)) (tl-inline-fail key value) (cast i32 n)))))

(defn inline-setting-flag [(key (slice u8)) (value (slice u8))] (-> bool)
  (cond (= value "1") true
        (= value "0") false
        :else (tl-inline-fail key value)))

(defn tl-inline-fail [(key (slice u8)) (value (slice u8))] (-> never)
  (eprintln "COIL_STOGIR_INLINE: invalid setting {}={}" key value)
  (terminate 1))

;;; Everything the environment tells this backend, read in one place
;;; (settings-read). A module takes its options from this structure only
;;; (module-create-with), and settings-key renders the whole structure into
;;; the key of a cached unit, so an option added here is part of the key
;;; without anyone having to remember it. Nothing else in this backend may
;;; read the environment.
;;;
;;; inline: COIL_STOGIR_INLINE, or inline-default-text when unset.
;;; shrink-wrap (default on): a function builds its frame only on paths that
;;; leave the frameless entry region (a64.shrink-wrap), at about 0.2% of
;;; generation. shrink-retry additionally allocates a second time with
;;; preserved registers assigned late where they alone keep the entry path
;;; framed; that costs about 2% of generation.
;;; frame-split (default on): a value that lives through calls is cut at the
;;; blocks expected to run with the frame built, so paths that make no call
;;; hold it in a call-clobbered register (a64.frame-spans,
;;; stogir.allocation-spans), and the frame is released again where framed
;;; blocks rejoin frameless code (a64.shrink-wrap). About +0.2% of generation.
;;; loop-evict (default on) lets a value used in a loop take a preserved
;;; register from a holder unused there (allocation.cold-owner).
;;; loop-reload (default on) reloads spilled values used inside a loop at its
;;; entry rather than at each use (allocation.reload-cut).
;;; predict (default on) orders blocks by static branch prediction
;;; (block-layout.predict!).
;;; select (default on): two-way choices whose values are nearly free become
;;; conditional selects late (select-diamond). This one is measurable: about
;;; half a percent of generation, all of it the structural check of each
;;; function the conversion edits.
;;; prune-default (default on): an exhaustive SWITCH (default reaching only
;;; UNREACHABLE) uses its last case as the fallback.
;;; graph: COIL_STOGIR_GRAPH, the function whose graph and allocation a
;;; traced build prints; "" for none. It changes no code, and is in the key so
;;; that asking for a trace is not answered by a cached unit.
;;; Each flag is COIL_STOGIR_<NAME> with the value 0 or 1; any other value is
;;; a hard error.
(defstruct Settings
  [(inline (slice u8))
   (shrink-wrap bool) (shrink-retry bool) (prune-default bool)
   (loop-reload bool) (loop-evict bool) (call-holes bool) (frame-split bool)
   (predict bool) (rotate bool) (branch-facts bool) (induction bool)
   (recolor bool) (regional bool) (global-loads bool) (if-convert bool)
   (select bool) (hoist-loads bool) (strength bool) (effects bool)
   (graph (slice u8))])
(derive Debug Settings)

(defn settings-text [(name (ptr i8)) (unset (slice u8))] (-> (slice u8))
  (let [raw (unit-getenv name)]
    (if (= (p/cast u64 raw) 0) unset (str/from-cstr raw))))

;;; A strict 0|1 setting; UNSET is its value when the variable is not set.
(defn settings-flag [(name (ptr i8)) (label (slice u8)) (unset bool)] (-> bool)
  (let [raw (unit-getenv name)]
    (if (= (p/cast u64 raw) 0) unset (inline-setting-flag label (str/from-cstr raw)))))

;;; Whether the variable NAME is set, to anything.
(defn settings-present [(name (ptr i8))] (-> bool)
  (!= (p/cast u64 (unit-getenv name)) 0))

(defn settings-read [] (-> Settings)
  (Settings
    :inline (settings-text c"COIL_STOGIR_INLINE" (inline-default-text))
    :shrink-wrap (settings-flag c"COIL_STOGIR_SHRINK_WRAP" "COIL_STOGIR_SHRINK_WRAP" true)
    :shrink-retry (settings-flag c"COIL_STOGIR_SHRINK_RETRY" "COIL_STOGIR_SHRINK_RETRY" false)
    :prune-default (settings-flag c"COIL_STOGIR_PRUNE_DEFAULT" "COIL_STOGIR_PRUNE_DEFAULT" true)
    :loop-reload (settings-flag c"COIL_STOGIR_LOOP_RELOAD" "COIL_STOGIR_LOOP_RELOAD" true)
    :loop-evict (settings-flag c"COIL_STOGIR_LOOP_EVICT" "COIL_STOGIR_LOOP_EVICT" true)
    :call-holes (settings-flag c"COIL_STOGIR_CALL_HOLES" "COIL_STOGIR_CALL_HOLES" false)
    :frame-split (settings-flag c"COIL_STOGIR_FRAME_SPLIT" "COIL_STOGIR_FRAME_SPLIT" true)
    :predict (settings-flag c"COIL_STOGIR_PREDICT" "COIL_STOGIR_PREDICT" true)
    :rotate (settings-flag c"COIL_STOGIR_ROTATE" "COIL_STOGIR_ROTATE" false)
    :branch-facts (settings-flag c"COIL_STOGIR_BRANCH_FACTS" "COIL_STOGIR_BRANCH_FACTS" false)
    :induction (settings-flag c"COIL_STOGIR_INDUCTION" "COIL_STOGIR_INDUCTION" false)
    :recolor (settings-flag c"COIL_STOGIR_RECOLOR" "COIL_STOGIR_RECOLOR" false)
    :regional (settings-flag c"COIL_STOGIR_REGIONAL" "COIL_STOGIR_REGIONAL" false)
    :global-loads (settings-flag c"COIL_STOGIR_GLOBAL_LOADS" "COIL_STOGIR_GLOBAL_LOADS" false)
    :if-convert (settings-flag c"COIL_STOGIR_IF_CONVERT" "COIL_STOGIR_IF_CONVERT" false)
    :select (settings-flag c"COIL_STOGIR_SELECT" "COIL_STOGIR_SELECT" true)
    :hoist-loads (settings-flag c"COIL_STOGIR_HOIST_LOADS" "COIL_STOGIR_HOIST_LOADS" false)
    :strength (settings-flag c"COIL_STOGIR_STRENGTH" "COIL_STOGIR_STRENGTH" false)
    :effects (settings-flag c"COIL_STOGIR_EFFECTS" "COIL_STOGIR_EFFECTS" false)
    :graph (settings-text c"COIL_STOGIR_GRAPH" "")))

;;; One line naming every field of SETTINGS and its value: what a cached unit
;;; records about the backend settings it was generated under.
(defn settings-key [(a (dyn Allocator)) (settings Settings)] (-> (slice u8))
  (let [(mut text) (str/StrBuf::new a)]
    (str/format! (mut text) "{:?}" settings)
    (let [key (str/StrBuf::finish! (mut text))]
      ; A key is one line of the unit's key file.
      (for [i 0 (len key)]
        (when (< (get key i) #\space)
          (eprintln "stogir: settings key holds a control character")
          (terminate 1)))
      key)))

;;; How generation is run, as opposed to what it generates. It is read here,
;;; beside settings-read and through the same readers, but it is deliberately
;;; a separate structure: Settings is rendered whole into the key of a cached
;;; unit, and nothing in Execution may be, because none of it changes a byte
;;; of the output (the object is the same for every worker count; see
;;; "Parallel emission" in src/compiler/stogir/README.md). A key that named
;;; it would rebuild units for nothing. scripts/tests/stogir-unit-settings.py
;;; checks both halves: the key ignores these variables, and it names every
;;; field of Settings.
;;; threads: COIL_STOGIR_THREADS, 1 to 64 (anything else is a hard error), or
;;; 0 when unset.
;;; serial: COIL_TPDE_SERIAL is set (to anything, as for the TPDE pipeline).
(defstruct Execution [(threads i64) (serial bool)])

(defn execution-read [] (-> Execution)
  (let [text (settings-text c"COIL_STOGIR_THREADS" "")]
    (Execution
      :threads
        (if (settings-present c"COIL_STOGIR_THREADS")
            (match (str/parse-int text)
              (Some [n]
                (if (and (>= n 1) (<= n 64))
                    n
                    (do (eprintln "COIL_STOGIR_THREADS: {} is not between 1 and 64" text)
                        (terminate 1))))
              (None []
                (eprintln "COIL_STOGIR_THREADS: {} is not a number" text)
                (terminate 1)))
            0)
      :serial (settings-present c"COIL_TPDE_SERIAL"))))

;;; The settings TEXT spells; a key it does not name is off or zero, with the
;;; fixed budget and template bound.
(defn inline-settings-from [(a (dyn Allocator)) (text (slice u8))] (-> InlineSettings)
  (let [(mut budget) (inline-budget) (mut template) (inline-budget)
        (mut small) (: 0 i32) (mut anywhere) false
        (mut indirect) false (mut pair) false (mut always) false (mut leaf) false (mut hoist) false
        (mut calls) (: 0 i32) (mut forward) false (mut self) false
        (mut sparse) (: 0 i32) (mut growth) (: 0 i32) (mut keep) (: 0 i32)
        (mut scope) (: 0 i32) (mut final) false (mut wrap) (: 0 i32)
        (mut small-caller) (: 0 i32) (mut small-charge) false
        (mut thunk) (: 0 i32)
        (mut items) (str/split a text ",")]
    (for item items
      (unless (= item "")
        (let [(mut parts) (str/split a item "=")]
          (unless (= (len parts) 2) (tl-inline-fail item ""))
          (let [key (get parts 0) value (get parts 1)]
            (cond (= key "budget") (set! budget (inline-setting-int key value))
                  (= key "template") (set! template (inline-setting-int key value))
                  (= key "small") (set! small (inline-setting-int key value))
                  (= key "small-scope")
                    (set! anywhere (cond (= value "any") true
                                         (= value "loop") false
                                         :else (tl-inline-fail key value)))
                  (= key "indirect") (set! indirect (inline-setting-flag key value))
                  (= key "pair") (set! pair (inline-setting-flag key value))
                  (= key "always") (set! always (inline-setting-flag key value))
                  (= key "small-leaf") (set! leaf (inline-setting-flag key value))
                  (= key "hoist") (set! hoist (inline-setting-flag key value))
                  (= key "calls") (set! calls (inline-setting-int key value))
                  (= key "forward") (set! forward (inline-setting-flag key value))
                  (= key "self") (set! self (inline-setting-flag key value))
                  (= key "keep") (set! keep (inline-setting-int key value))
                  (= key "wrap") (set! wrap (inline-setting-int key value))
                  (= key "small-caller") (set! small-caller (inline-setting-int key value))
                  (= key "small-charge") (set! small-charge (inline-setting-flag key value))
                  (= key "final") (set! final (inline-setting-flag key value))
                  (= key "thunk") (set! thunk (inline-setting-int key value))
                  (= key "exempt")
                    (set! scope (cond (= value "all") 2
                                      (= value "bodies") 1
                                      (= value "never") 0
                                      :else (tl-inline-fail key value)))
                  (= key "sparse") (set! sparse (inline-setting-int key value))
                  (= key "growth")
                    (set! growth (match (str/parse-int value)
                                   (None [] (tl-inline-fail key value))
                                   (Some [n] (if (or (< n 0) (> n 1048576))
                                                 (tl-inline-fail key value)
                                                 (cast i32 n)))))
                  :else (tl-inline-fail key value)))
          (free! (mut parts)))))
    (free! (mut items))
    (InlineSettings
      :policy (inlining/Policy :budget budget :small-cells small :small-anywhere anywhere
                               :small-leaf leaf
                               :indirect-calls indirect :pair-result-calls pair
                               :honor-always always :hoist-frames hoist
                               :call-cells calls :sparse-cells sparse
                               :forwarders forward :keep-cells 0
                               :small-callers small-caller :small-charged small-charge
                               :thunk-cells thunk)
      :template template :self self :growth growth :keep keep :wrap wrap
      :scope scope :final final)))

;;; What module-prepare! records about F before any template work: the
;;; :inline (Never) mark and, under a growth setting, its direct call sites.
(defn prepare-note! [(module (ptr Module)) (f (ptr cir/Func)) (symbol u32) (never bool)]
  (-> void)
  (when never
    (while (<= (len (.outlined module)) (cast i64 symbol))
      (push! (mut (.outlined module)) false))
    (set! (mut (.outlined module)) (cast i64 symbol) true))
  (when (> (.growth (.inline module)) 0)
    (for [j 0 (len (.insts f))]
      (let [x (cir/val f (get (.insts f) j))
            op (cast i64 (.op x))]
        (when (and (or (= op cir/OP-CALL) (= op cir/OP-TAILCALL)) (>= (.imm x) 0))
          (while (<= (len (.call-sites module)) (.imm x))
            (push! (mut (.call-sites module)) 0))
          (set! (mut (.call-sites module)) (.imm x)
                (+ (get (.call-sites module) (.imm x)) 1)))))))

;;; Whether F is small enough to be tried as an inline template.
(defn template-candidate? [(module (ptr Module)) (f (ptr cir/Func)) (never bool)] (-> bool)
  (and (not never) (<= (len (.insts f)) (cast i64 (.template (.inline module))))))

;;; Adapt F into S. The template's adapted graph is consumed by optimization.
;;; Only an optimized graph of at most budget+1 cells is registered; an adapted
;;; graph over 1.5x the budget is not optimized just to be discarded (on the
;;; compiler itself no such graph shrinks enough to register): it is released
;;; here and the result is false. This is the only step of template
;;; preparation that touches the assembler (it binds import symbols), so it
;;; runs on the submitting thread in submission order.
(defn prepare-adapt! [(module (ptr Module)) (s (ptr Adapter)) (f (ptr cir/Func))
                      (ta (ptr asm/Asm)) (symbol u32) (a (dyn Allocator))] (-> bool)
  (adapt-as! s f ta (cast i64 symbol) (p/cast (ptr (ArrayList MTextData)) 0) a)
  (if (> (* 2 (len (.instructions (.g s)))) (* 3 (cast i64 (.template (.inline module)))))
      (do (graph/release! (mut (.g s))) false)
      true))

;;; An adapted template after optimization: its graph and observations, the
;;; RETURN roots left in it, and whether return canonicalization edited the
;;; optimizer's output.
(defstruct PreparedTemplate
  [(optimized rewrite/Rewritten) (returns i64) (canonicalized bool)])

;;; Optimize the adapted graph of S and normalize a multi-return template.
;;; Reads and writes only S's graph and allocates only from A: prepared
;;; templates do not see each other, so workers run this concurrently.
(defn prepare-optimize! [(s (ptr Adapter)) (a (dyn Allocator))]
  (-> (Result PreparedTemplate (slice u8)))
  (match (sccp/optimize-memory-owned! (.g s) 8 (slice (.exits s)) true a)
    (Err [message] (Err message))
    (Ok [optimized]
        (let [(mut optimized) optimized
              (mut returns) (: 0 i64)
              (mut r) 1]
          ; Keep every control root during optimization. The library then
          ; proves control closure from every supplied observation.
          (while (< r (len (.instructions (.graph optimized))))
            (let [n (get (.instructions (.graph optimized)) r)
                  count (get (.arities (.graph optimized)) r)]
              (when (= (node/opcode n) 120) (set! returns (+ returns 1)))
              (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
          ; Normalize only owned multi-return templates. Rebuild the
          ; graph epoch before any immutable registry handle is issued.
          (if (> returns 1)
              (match (return-merge/canonicalize (.graph optimized) (.start s)
                       (slice (.roots optimized)) 8 a)
                (Err [message] (Err message))
                (Ok [canonical]
                  (graph/release! (mut (.graph optimized)))
                  (free! (mut (.roots optimized)))
                  (queue/release! (mut (.iteration optimized)))
                  (set! (.graph optimized) (.graph canonical))
                  (set! (.roots optimized) (.roots canonical))
                  (set! (.iteration optimized)
                        (queue/create (len (.instructions (.graph canonical))) a))
                  (Ok (PreparedTemplate :optimized optimized :returns 1 :canonicalized true))))
              (Ok (PreparedTemplate :optimized optimized :returns returns
                                    :canonicalized false)))))))

;;; Enter an optimized template into the module when it has one RETURN and
;;; fits: its definition and symbol bindings, owned by the module allocator.
;;; Runs on the submitting thread in submission order; releases the template.
(defn prepare-commit! [(module (ptr Module)) (s (ptr Adapter)) (f (ptr cir/Func))
                       (symbol u32) (always bool) (prepared PreparedTemplate)] (-> void)
  (let [keep (.a module)
        (mut optimized) (.optimized prepared)]
    (when (.trace module)
      (eprintln "stogir template {}: {} cells, {} returns"
                (.name f)
                (len (.instructions (.graph optimized)))
                (.returns prepared)))
    (when (and (= (.returns prepared) 1)
               (<= (len (.instructions (.graph optimized)))
                   (+ (cast i64 (.template (.inline module))) 1)))
      (let [(mut owned) (zeroed Definition)
            definition (cast (ptr Definition) (mut owned))]
        (set! (.symbol definition) symbol)
        (set! (.always definition) always)
        (set! (.source definition) f)
        (set! (.entry definition) (.start s))
        (set! (.name definition)
              (sconcat keep
                       "_coil_stogir_import_"
                       (i64->str keep (cast i64 symbol))))
        (own-definition! definition
                         (.graph optimized)
                         (slice (.roots optimized))
                         (slice (.import-names s))
                         (slice (.import-ids s))
                         keep)
        ; Return canonicalization edits the SCCP output.
        (set! (.clean definition) (not (.canonicalized prepared)))
        (set! (.proof definition) (if (.canonicalized prepared) 0 (.proof optimized)))
        (for [i 0 (len (.import-ids definition))]
          (let [name (get (.import-names definition) i)
                id (get (.import-ids definition) i)]
            (match (get (.bindings module) name)
              (Some [prior]
                    (when (!= prior id)
                      (fail (.name f)
                            "conflicting module symbol binding")))
              (None [] (set! (mut (.bindings module)) name id)))))
        (while (<= (len (.by-symbol module)) (cast i64 symbol))
          (push! (mut (.by-symbol module)) 0))
        (push! (mut (.definitions module)) owned)
        (set! (mut (.by-symbol module))
              (cast i64 symbol)
              (len (.definitions module)))))
    (rewrite/release! (mut optimized))))

(defn module-prepare! [(module (ptr Module))
                       (f (ptr cir/Func))
                       (ta (ptr asm/Asm))
                       (symbol u32)
                       (never bool)
                       (always bool)] (-> void)
  (prepare-note! module f symbol never)
  (when (template-candidate? module f never)
    (let [work (p/alloc-stack scratch/ScratchArena)]
      (scratch/ScratchArena::init-with-capacity work (malloc-allocator) 65536)
      (let [a (allocator work)
            (mut state) (zeroed Adapter)
            s (cast (ptr Adapter) (mut state))]
        (when (prepare-adapt! module s f ta symbol a)
          (match (prepare-optimize! s a)
            (Err [message] (fail (.name f) message))
            (Ok [prepared] (prepare-commit! module s f symbol always prepared)))))
      (close! work))))

(defn definition-index [(s (ptr Adapter))
                        (module (ptr Module))
                        (name (slice u8))] (-> i64)
  (let [(mut found) (: -1 i64)]
    (for [i 0 (len (.import-ids s))]
      (when (= name (get (.import-names s) i))
        (let [id (cast i64 (get (.import-ids s) i))]
          (when (< id (len (.by-symbol module)))
            (set! found (- (get (.by-symbol module) id) 1))))))
    found))

(defn bind-cloned-imports! [(s (ptr Adapter)) (module (ptr Module))] (-> void)
  (for [i 0 (len (.constants (.g s)))]
    (when (> (get (.constant-spans (.g s)) i) 0)
      (let [value (get (.constants (.g s)) i)]
        (when (or (= (node/opcode value) 74) (= (node/opcode value) 75))
          (match (strings/lookup (.strings (.g s))
                                 (cast i32 (node/constant-bits value)))
            (None [] (fail (.name (.f s)) "cloned symbol name missing"))
            (Some [name]
                  (let [(mut found) false]
                    (for prior (.import-names s)
                      (when (= prior name) (set! found true)))
                    (unless found
                      (match (get (.bindings module) name)
                        (None []
                              (fail (.name (.f s))
                                    "cloned symbol has no module binding"))
                        (Some [id]
                              (push! (mut (.import-ids s)) id)
                              ; Own bytes independently of any mutable graph string pool.
                              (push! (mut (.import-names s))
                                     (sconcat (.a s) name "")))))))))))))

;;; Adapter observations are program control exits, never externally requested
;;; intermediate values. Generic library rewrites preserve both roles: replacing
;;; an observed LOAD/CALL retains its value identity and adds its control closure.
;;; At the adapter boundary retain the control observations; RETURN and branch
;;; operands continue to carry every program value. In particular an inlined
;;; CALL value on a now-infeasible branch must not become an unconditional value
;;; request. The library's general value-root contract remains unchanged.
(defn retain-program-control! [(s (ptr Adapter))] (-> void)
  (let [(mut kept) (: 0 i64)
        count (len (.exits s))]
    (for [i 0 count]
      (let [root (get (.exits s) i)
            value (get (.instructions (.g s)) (cast i64 root))]
        (when (opcode/control? (cast i32 (node/opcode value)))
          (set! (mut (.exits s)) kept root)
          (set! kept (+ kept 1)))))
    (while (> (len (.exits s)) kept) (pop! (mut (.exits s))))))

;;; Whether cloning DEFINITION at every direct call of it in the module adds
;;; at most the growth setting, by its current cell count.
(defn sparse-definition? [(module (ptr Module)) (definition Definition)] (-> bool)
  (let [growth (cast i64 (.growth (.inline module)))
        symbol (cast i64 (.symbol definition))
        sites (if (< symbol (len (.call-sites module)))
                  (cast i64 (get (.call-sites module) symbol))
                  (: 0 i64))]
    (and (> growth 0)
         (<= (* sites (len (.instructions (.graph definition)))) growth))))

(defn definition-callee [(module (ptr Module)) (definition Definition)] (-> inlining/Callee)
  (inlining/Callee
    :name (.name definition)
    :graph (.graph definition)
    :entry (.entry definition)
    :roots (slice (.roots definition))
    :observed (slice (.inline-controls definition))
    :never (not (or (.inlineable definition) (.recursive definition)))
    :always (.always definition)
    :sparse (sparse-definition? module definition)))

;;; Preparation is serial. Each version owns a distinct registry snapshot;
;;; source mutation can never stale an earlier proof. Emission only reads the
;;; frozen registry and never lazily inserts from a worker.
(defn register-definition! [(module (ptr Module)) (definition (ptr Definition))]
  (-> i64)
  (when (= (.callee-handle definition) 0)
    (when (.frozen module)
      (fail (.name (.source definition))
            "unregistered frozen stogir definition"))
    (match (inlining/register-proven! (mut (.callees module))
                                      (definition-callee module (load definition))
                                      (.proof definition))
      (Err [message] (fail (.name (.source definition)) message))
      (Ok [handle] (set! (.callee-handle definition) handle))))
  (.callee-handle definition))

;;; The module arena still owns its source definitions and bindings. Registry
;;; snapshots have no readers after all emission jobs have completed.
(defn module-release-callees! [(module (ptr Module))] (-> void)
  (for [i 0 (len (.native-cache module))]
    (image/release! (mut (.image (elem (mut (.native-cache module)) i)))))
  (free! (mut (.native-cache module))) (free! (mut (.native-by-symbol module)))
  (private/context-release! (mut (.native-context module)))
  (inlining/registry-release! (mut (.callees module)))
  (for [i 0 (len (.bodies module))]
    (release-emission-body! module (.symbol (.definition (at (.bodies module) i))))))

;;; Whether GRAPH contains exactly one CALL and no TAILCALL.
(defn single-call? [(g graph/Graph)] (-> bool)
  (let [(mut calls) (: 0 i64) (mut r) (: 1 i64)]
    (while (and (< calls 2) (< r (len (.instructions g))))
      (let [opcode (node/opcode (get (.instructions g) r))]
        (cond (= opcode 79) (set! calls (+ calls 1))
              (= opcode 80) (set! calls 2)
              :else 0)
        (set! r (+ r (/ (+ (cast i64 (get (.arities g) r)) 4) 4)))))
    (= calls 1)))

;;; The expansion policy for a template being finalized. Forwarders are decided
;;; on emitted bodies only. A DEFERRED template (every template unless
;;; exempt=all, then one of at most the keep setting in cells) also goes
;;; without the call and sparse exemptions: a small template
;;; is what its callers clone, and a callee absorbed there both grows every
;;; such clone and can make the template clonable where it was not (measured
;;; on the compiler itself: reserve! absorbed reallocate, push! then absorbed
;;; reserve! and stayed a call at 230M more executed sites). Under the final
;;; setting its emitted body gets them instead (prepare-template-body!).
;;; A template being finalized is also held small under the wrap setting
;;; (Policy keep-cells); an emitted body never is.
;;; POLICY without the call and sparse exemptions, forwarders kept.
(defn forwarder-policy [(policy inlining/Policy)] (-> inlining/Policy)
  (inlining/Policy :budget (.budget policy) :small-cells (.small-cells policy)
                   :small-anywhere (.small-anywhere policy) :small-leaf (.small-leaf policy)
                   :indirect-calls (.indirect-calls policy)
                   :pair-result-calls (.pair-result-calls policy)
                   :honor-always (.honor-always policy) :hoist-frames (.hoist-frames policy)
                   :call-cells 0 :sparse-cells 0 :forwarders (.forwarders policy)
                   :keep-cells 0 :small-callers (.small-callers policy)
                   :small-charged (.small-charged policy)
                   :thunk-cells (.thunk-cells policy)))

(defn template-policy [(policy inlining/Policy) (deferred bool) (wrap i32)] (-> inlining/Policy)
  (inlining/Policy :budget (.budget policy) :small-cells (.small-cells policy)
                   :small-anywhere (.small-anywhere policy) :small-leaf (.small-leaf policy)
                   :indirect-calls (.indirect-calls policy)
                   :pair-result-calls (.pair-result-calls policy)
                   :honor-always (.honor-always policy) :hoist-frames (.hoist-frames policy)
                   :call-cells (if deferred 0 (.call-cells policy))
                   :sparse-cells (if deferred 0 (.sparse-cells policy))
                   :forwarders false :keep-cells wrap
                   :small-callers (.small-callers policy)
                   :small-charged (.small-charged policy)
                   :thunk-cells (.thunk-cells policy)))

;;; Submit the direct calls of registered definitions for expansion. FINAL says
;;; the graph is a body about to be emitted, expanded this once, rather than a
;;; template being finalized; DEFERRED withholds the call and sparse exemptions
;;; (template-policy) in either case. A call of the function being expanded is never a
;;; site. A recursive template is a site only in a FINAL caller whose one call
;;; it is: the clone carries calls of the template itself, so the caller
;;; becomes the function without its entry call, and those calls are never
;;; expanded again. Elsewhere a clone would only peel one level of the
;;; recursion (measured on the compiler itself: +1.6% generation for no fewer
;;; executed instructions).
(defn expand-module! [(s (ptr Adapter)) (module (ptr Module)) (budget i32) (final bool)
                      (deferred bool)]
  (-> i32)
  (if (= (p/cast i64 module) 0)
      0
      (let [a (.a s)
            source-cells (if (.trace module) (len (.instructions (.g s))) (: 0 i64))
            (mut sites) (ArrayList::new [inlining/RegisteredSite] a)
            (mut trace-sites) (ArrayList::new [inlining/Site] a)
            (mut changes) (: 0 i32)
            (mut r) 1]
        ; Only instruction starts are nodes; variadic payload cells are skipped.
        (while (< r (len (.instructions (.g s))))
          (let [call (get (.instructions (.g s)) r)
                count (get (.arities (.g s)) r)]
            (when (= (node/opcode call) 79)
              (match (graph/lookup (.g s) (.op2 call))
                (None [] 0)
                (Some [function]
                      (when (= (node/opcode function) 74)
                        (match (strings/lookup (.strings (.g s))
                                               (cast i32
                                                     (node/constant-bits function)))
                          (None [] 0)
                          (Some [name]
                                (let [index (definition-index s module name)]
                                  (when (and (>= index 0)
                                             (!= (p/cast u64 (.source (get (.definitions module) index)))
                                                 (p/cast u64 (.f s)))
                                             (or (not (.recursive (get (.definitions module) index)))
                                                 (and final (single-call? (.g s)))))
                                    (let [definition
                                            (elem (mut (.definitions module))
                                                  index)
                                          handle
                                            (register-definition! module
                                                                  definition)]
                                      (push! (mut sites)
                                             (inlining/RegisteredSite
                                               :reference (cast i32 r)
                                               :callee handle))
                                      (when (.trace module)
                                        (push! (mut trace-sites)
                                               (inlining/Site
                                                 :reference (cast i32 r)
                                                 :target
                                                   (definition-callee module (load definition))))))))))))))
            (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
        (when (.trace module)
          (for [i 0 (len sites)]
            (let [site (get sites i)]
              (eprintln "stogir inline-submitted {}: {} reference {} handle {}"
                        (.name (.f s)) i (.reference site) (.callee site)))))
        (when (.trace module)
          (for site trace-sites
            (let [target (.target site)
                  (mut label) (.name target)
                  proof
                    (inlining/inspect-verified-site (.g s)
                                                    (slice (.exits s))
                                                    (.reference site)
                                                    target
                                                    8
                                                    budget
                                                    a)]
              (for definition (.definitions module)
                (when (= (.name definition) (.name target))
                  (set! label (.name (.source definition)))))
              (let [callee (.graph target) (mut cursor) (: 1 i64)]
                (while (< cursor (len (.instructions callee)))
                  (let [parameter (get (.instructions callee) cursor)]
                    (when (= (node/opcode parameter) 71)
                      (match (graph/operand (.g s) (.reference site) (+ (.op3 parameter) 3))
                        (None [] 0)
                        (Some [actual]
                          (match (graph/lookup (.g s) actual)
                            (None [] 0)
                            (Some [value]
                              (eprintln "stogir inline-argument {} -> {}: ordinal {}, formal-type {}, ref {}, op {}, type {}, inputs [{}, {}, {}]"
                                (.name (.f s)) label (.op3 parameter) (node/type-id parameter)
                                actual (node/opcode value) (node/type-id value)
                                (.op1 value) (.op2 value) (.op3 value)))))))
                    (set! cursor (+ cursor (/ (+ (cast i64 (get (.arities callee) cursor)) 4) 4))))))
              (eprintln "stogir inline-check {} -> {}: common {}, capture {}, result {}, kind {}"
                        (.name (.f s))
                        label
                        (.common proof)
                        (.caller-private proof)
                        (.private-result proof)
                        (.result-kind proof)))))
        (when (> (len sites) 0)
          (match (inlining/optimize-registered-specialized-policy (.callees module)
                   (.g s) (.start s) (slice (.exits s)) (slice sites)
                   (inlining/with-budget (cond (not final)
                                                 (template-policy (.policy (.inline module)) deferred
                                                                  (.wrap (.inline module)))
                                               deferred
                                                 (forwarder-policy (.policy (.inline module)))
                                               :else (.policy (.inline module)))
                                         budget)
                   (.proof s) a)
            (Err [message] (fail (.name (.f s)) message))
            (Ok [outcome]
                (do
                  (match outcome
                    (None [] 0)
                    (Some [expanded]
                          (let [(mut expanded) expanded]
                            (set! changes (.changes expanded))
                            (unless (.borrowed s) (graph/release! (mut (.g s))))
                            (set! (.borrowed s) false)
                            (free! (mut (.exits s)))
                            (set! (.g s) (.graph expanded))
                            (set! (.exits s) (.roots expanded))
                            (set! (.proof s) (.proof expanded))
                            (retain-program-control! s)
                            (bind-cloned-imports! s module)
                            (queue/release! (mut (.iteration expanded))))))
                  (when (.trace module)
                    (for site trace-sites
                      (let [target (.target site)
                            callee (.graph target)
                            (mut label) (.name target)
                            (mut calls) (: 0 i64)
                            (mut cursor) (: 1 i64)]
                        (for definition (.definitions module)
                          (when (= (.name definition) (.name target))
                            (set! label (.name (.source definition)))))
                        (while (< cursor (len (.instructions callee)))
                          (when (= (node/opcode (get (.instructions callee) cursor)) 79)
                            (set! calls (+ calls 1)))
                          (set! cursor (+ cursor (/ (+ (cast i64 (get (.arities callee) cursor)) 4) 4))))
                        (eprintln "stogir inline-site {} -> {}: {}, {} cells, {} calls, never {}, always {}"
                                  (.name (.f s)) label
                                  (if (= (node/opcode (get (.instructions (.g s))
                                                           (cast i64 (.reference site)))) 79)
                                      "kept" "inlined")
                                  (len (.instructions callee)) calls
                                  (.never target) (.always target))))
                    (eprintln "stogir expand {}: {} sites, {} changes, {} reserved, {} remaining, {} contexts, final {}"
                              (.name (.f s))
                              (len sites)
                              changes
                              (- (len (.instructions (.g s))) source-cells)
                              (- (cast i64 budget) (- (len (.instructions (.g s))) source-cells))
                              (inlining/specialization-count (.callees module))
                              final))))))
        (free! (mut trace-sites))
        (free! (mut sites))
        changes)))

;;; Eliminating a result-capture CALL can make its ALLOCA promotable. Keep
;;; every observed control root while applying the ordinary memory/SCCP pipeline.
;;; This runs only after real expansion in a template containing stack storage.
(defn finish-private-template! [(s (ptr Adapter))] (-> bool)
  (let [(mut storage) false
        (mut r) 1]
    (while (< r (len (.instructions (.g s))))
      (when (= (node/opcode (get (.instructions (.g s)) r)) 81)
        (set! storage true))
      (set! r (+ r (/ (+ (cast i64 (get (.arities (.g s)) r)) 4) 4))))
    (when storage
      (match (sccp/optimize-memory-owned-proven! (.g s) 8 (slice (.exits s)) true (.proof s) (.a s))
        (Err [message] (fail (.name (.f s)) message))
        (Ok [optimized]
            (let [(mut optimized) optimized]
              (free! (mut (.exits s)))
              (set! (.g s) (.graph optimized))
              (set! (.exits s) (.roots optimized))
              (set! (.proof s) (.proof optimized))
              (queue/release! (mut (.iteration optimized)))))))
    storage))

(defn called-definition [(module (ptr Module))
                         (source graph/Graph)
                         (target i32)]
  (-> i64)
  (match (graph/lookup source target)
    (None [] -1)
    (Some [function]
          (if (= (node/opcode function) 74)
              (match (strings/lookup (.strings source)
                                     (cast i32 (node/constant-bits function)))
                (None [] -1)
                (Some [name]
                      (match (get (.bindings module) name)
                        (None [] -1)
                        (Some [symbol]
                              (let [id (cast i64 symbol)]
                                (if (< id (len (.by-symbol module)))
                                    (- (get (.by-symbol module) id) 1)
                                    -1))))))
              -1))))

;;; The definition a direct CALL reference of SOURCE names, when that definition
;;; has an effect record the call does not carry yet and the call's fixed
;;; prototype matches the definition's own (so argument positions are the
;;; callee's parameter ordinals), else -1. Only bodies of this module have
;;; records: an import, an indirect call or a function of another unit never
;;; acquires one.
(defn effects-target [(module (ptr Module)) (source graph/Graph) (reference i32)]
  (-> i64)
  (let [call (get (.instructions source) (cast i64 reference))
        index (called-definition module source (.op2 call))]
    (if (or (< index 0) (not (.present (.effects (get (.definitions module) index))))) -1
        (match (calls/signature source (.op2 call) (node/type-id call)
                   (- (get (.arities source) (cast i64 reference)) 2))
          (Err [_] -1)
          (Ok [signature]
            (if (or (= (.id signature) 0) (!= (& (.flags signature) 16) 0)) -1
                (match (strings/lookup (.strings source) (.id signature))
                  (None [] -1)
                  (Some [bytes]
                        (let [target (.graph (get (.definitions module) index))]
                          (if (.present (groups/effects bytes)) -1
                              (match (strings/lookup (.strings target) (.function-prototype target))
                                (None [] -1)
                                (Some [own]
                                      (if (inlining/compatible? bytes own) index -1)))))))))))))

;;; Caller owns this graph version exclusively. Only the prototype's effect
;;; record changes; instruction references, observations, result roles and ABI
;;; pieces are stable.
(defn annotate-call-effects! [(module (ptr Module)) (source (mut graph/Graph))
                              (a (dyn Allocator))] (-> i32)
  (let [(mut bytes) (ArrayList::new [u8] a) (mut r) (: 1 i64) (mut changes) (: 0 i32)]
    (while (< r (len (.instructions source)))
      (let [call (get (.instructions source) r)
            count (get (.arities source) r)]
        (when (= (node/opcode call) 79)
          (let [index (effects-target module source (cast i32 r))]
            (when (>= index 0)
              (match (calls/signature source (.op2 call) (node/type-id call) (- count 2))
                (Err [e] (fail "call effects" e))
                (Ok [signature]
                  (match (strings/lookup (.strings source) (.id signature))
                    (None [] (fail "call effects" "prototype disappeared"))
                    (Some [original]
                      (when (groups/with-effects! (mut bytes) original
                                                  (.effects (get (.definitions module) index)))
                        (let [id (match (strings/intern! (mut (.strings source)) (slice bytes))
                                   (None [] (fail "call effects" "prototype space exhausted"))
                                   (Some [id] id))
                              callee (match (graph/lookup source (.op2 call))
                                       (None [] (fail "call effects" "callee disappeared"))
                                       (Some [callee] callee))
                              target (match (calls/attach-id! (mut source) (.op2 call) callee id)
                                       (Err [e] (fail "call effects" e))
                                       (Ok [target] target))]
                          (unless (graph/set-operand! (mut source) (cast i32 r) 2 target)
                            (fail "call effects" "callee rewrite failed"))
                          (set! changes (+ changes 1)))))))))))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    (free! (mut bytes))
    changes))

;;; Registered graphs remain immutable. Lazily clone a changed declaration set,
;;; then obtain a fresh registry proof before inferring this version's effects.
;;;
;;; Writing effect records changes nothing validation reads except prototype
;;; strings that with-effects! derived from validated ones, so a graph proven
;;; before stays proven: its proof is restated for the new content. When the
;;; records can enable memory optimization here (native-effects/enables?) the
;;; template is optimized once more, so that its clones, its own emission and
;;; its summary all see the result.
(defn finish-definition-effects! [(module (ptr Module)) (definition (ptr Definition))]
  (-> void)
  (let [(mut r) (: 1 i64) (mut needed) false source (.graph definition)]
    (while (and (not needed) (< r (len (.instructions source))))
      (let [call (get (.instructions source) r) count (get (.arities source) r)]
        (when (and (= (node/opcode call) 79)
                   (>= (effects-target module source (cast i32 r)) 0))
          (set! needed true))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    (when needed
      (let [proven (and (.effects module) (!= (.proof definition) 0)
                        (= (rewrite/content-hash source 8) (.proof definition)))
            (mut owned) (graph/duplicate source (.a module))
            changes (annotate-call-effects! module (mut owned) (.a module))
            again (and (.effects module) (native-effects/enables? owned))]
        (set! (.graph definition) owned)
        (set! (.callee-handle definition) 0)
        (when (.effects module)
          (set! (.proof definition) (if proven (rewrite/content-hash owned 8) 0)))
        (when again
          (let [work (p/alloc-stack scratch/ScratchArena)]
            (scratch/ScratchArena::init-with-capacity work (malloc-allocator) 65536)
            (match (sccp/optimize-memory-owned-proven! (graph/duplicate owned (allocator work)) 8
                                                       (slice (.observed definition)) true
                                                       (.proof definition) (allocator work))
              (Err [message] (fail (.name (.source definition)) message))
              (Ok [optimized]
                  (let [(mut optimized) optimized]
                    (own-definition! definition (.graph optimized) (slice (.roots optimized))
                                     (slice (.import-names definition))
                                     (slice (.import-ids definition)) (.a module))
                    (set! (.clean definition) true)
                    (set! (.proof definition) (.proof optimized))
                    (queue/release! (mut (.iteration optimized))))))
            (close! work)))
        (when (.trace module)
          (eprintln "stogir effect-calls {}: {} again {}" (.name (.source definition)) changes again))))
    (register-definition! module definition)
    ; The summary borrows this exact registered graph version. Its scratch
    ; must not accumulate in the module arena.
    (let [work (p/alloc-stack scratch/ScratchArena)]
      (scratch/ScratchArena::init-with-capacity work (malloc-allocator) 4096)
      (set! (.effects definition)
            (cond (.effects module)
                    (native-effects/summarize (.graph definition) (allocator work))
                  ; The non-writing proof alone: nothing is said about what
                  ; the body keeps.
                  (memory-effects/nonwriting-native-verified-body? (.graph definition)
                                                                    (allocator work))
                    (groups/Effects :present true :unknown false :writes 0
                                    :captures 65535 :extent 0)
                  :else (groups/no-effects)))
      (close! work))
    (when (.trace module)
      (eprintln "stogir nonwriting-body {}: {}" (.name (.source definition))
                (and (.present (.effects definition)) (not (.unknown (.effects definition)))
                     (= (.writes (.effects definition)) 0)))
      (let [e (.effects definition)]
        (eprintln "stogir effects {}: present {} unknown {} writes {} captures {} extent {}"
                  (.name (.source definition)) (.present e) (.unknown e) (.writes e)
                  (.captures e) (.extent e))))))

;;; Conservative recursion policy: only definitions whose registered direct-call
;;; closure is acyclic can be cloned. Kahn elimination is linear in actual CALL
;;; edges, not function-address imports. Cycle members and their callers remain
;;; callable, and can themselves absorb acyclic helpers, but are not templates.
;;; Under the self setting a definition left only with calls of itself is
;;; marked recursive: a template for forwarders (see expand-module!), while
;;; its callers stay outside the acyclic order as before.
(defn mark-acyclic-definitions! [(module (ptr Module))] (-> (ArrayList i64))
  (let [a (.a module)
        count (len (.definitions module))
        (mut heads) (ArrayList::new [i64] a)
        (mut next) (ArrayList::new [i64] a)
        (mut callers) (ArrayList::new [i64] a)
        (mut pending) (ArrayList::new [i64] a)
        ; Calls of the definition itself, a subset of its pending calls.
        (mut own) (ArrayList::new [i64] a)
        (mut leaves) (queue/create count a)
        (mut order) (ArrayList::new [i64] a)]
    (for [i 0 count]
      (push! (mut heads) -1)
      (push! (mut pending) 0)
      (push! (mut own) 0)
      (set! (.recursive (elem (mut (.definitions module)) i)) false)
      (set! (.inlineable (elem (mut (.definitions module)) i)) false))
    (for [i 0 count]
      (let [source (.graph (get (.definitions module) i))
            (mut r) 1]
        (while (< r (len (.instructions source)))
          (let [call (get (.instructions source) r)
                arity (get (.arities source) r)]
            (when (= (node/opcode call) 79)
              (let [callee (called-definition module source (.op2 call))]
                (when (= callee i) (set! (mut own) i (+ (get own i) 1)))
                (when (>= callee 0)
                  (push! (mut callers) i)
                  (push! (mut next) (get heads callee))
                  (set! (mut heads) callee (- (len callers) 1))
                  (set! (mut pending) i (+ (get pending i) 1)))))
            (set! r (+ r (/ (+ (cast i64 arity) 4) 4)))))))
    (for [i 0 count]
      (when (= (get pending i) 0) (queue/add! (mut leaves) i)))
    (when (.self (.inline module))
      (for [i 0 count]
        (when (and (> (get own i) 0) (= (get pending i) (get own i)))
          (set! (.recursive (elem (mut (.definitions module)) i)) true))))
    (let [(mut index) (queue/pop! (mut leaves))]
      (while (>= index 0)
        (set! (.inlineable (elem (mut (.definitions module)) index)) true)
        (push! (mut order) index)
        (let [(mut edge) (get heads index)]
          (while (>= edge 0)
            (let [caller (get callers edge)
                  remaining (- (get pending caller) 1)]
              (set! (mut pending) caller remaining)
              (when (and (.self (.inline module)) (> remaining 0)
                         (= remaining (get own caller)))
                (set! (.recursive (elem (mut (.definitions module)) caller)) true))
              (when (= remaining 0) (queue/add! (mut leaves) caller)))
            (set! edge (get next edge))))
        (set! index (queue/pop! (mut leaves)))))
    ; Cycle closures are not templates, but can absorb finalized acyclic helpers.
    ; Recursive templates come first: a later caller may be their forwarder.
    (for [i 0 count]
      (when (.recursive (get (.definitions module) i)) (push! (mut order) i)))
    (for [i 0 count]
      (unless (or (.inlineable (get (.definitions module) i))
                  (.recursive (get (.definitions module) i)))
        (push! (mut order) i)))
    (when (.trace module)
      (for definition (.definitions module)
        (eprintln "stogir inline-policy {}: acyclic {}"
                  (.name (.source definition))
                  (.inlineable definition))))
    (queue/release! (mut leaves))
    (free! (mut pending))
    (free! (mut own))
    (free! (mut callers))
    (free! (mut next))
    (free! (mut heads))
    order))

;;; Finalize each actual direct-call DAG callee before its callers. A caller's
;;; bounded local revisits can expose nested calls or private storage promotion,
;;; but transitive callee graphs already have their final immutable contents.
;;; The same 512-cell growth accounting applies; recursive closures stay Never.
(defn module-finish! [(module (ptr Module))] (-> void)
  (let [a (.a module)
        count (len (.definitions module))
        (mut order) (mark-acyclic-definitions! module)
        (mut budgets) (ArrayList::new [i32] a)
        temporary (p/alloc-stack scratch/ScratchArena)]
    (for [i 0 count]
      (push! (mut budgets) (.budget (.policy (.inline module))))
      (set! (.deferred (elem (mut (.definitions module)) i))
            (or (< (.scope (.inline module)) 2)
                (<= (inlining/base-clone-cells (.graph (get (.definitions module) i)))
                    (cast i64 (.keep (.inline module)))))))
    (for index order
      (when (.trace module)
        (eprintln "stogir finalize-order {}: {}"
                  (.name (.source (get (.definitions module) index)))
                  index))
      (let [(mut changed) true]
        (while changed
          (set! changed false)
          (scratch/ScratchArena::init-with-capacity temporary
                                                    (malloc-allocator)
                                                    65536)
          (let [definition (elem (mut (.definitions module)) index)
                before (len (.instructions (.graph definition)))
                (mut state) (zeroed Adapter)
                s (cast (ptr Adapter) (mut state))]
            (set! (.a s) (allocator temporary))
            (set! (.f s) (.source definition))
            (set! (.g s) (.graph definition))
            (set! (.start s) (.entry definition))
            (set! (.exits s) (.observed definition))
            (set! (.import-names s) (.import-names definition))
            (set! (.import-ids s) (.import-ids definition))
            (set! (.proof s) (.proof definition))
            (when (> (expand-module! s module (get budgets index) false (.deferred definition)) 0)
              ; Charge reserved clone cells before cleanup; optimization never
              ; replenishes this definition's budget.
              ; Uncharged small-callee growth can exceed the remainder.
              (let [left (- (get budgets index)
                            (cast i32 (- (len (.instructions (.g s))) before)))]
                (set! (mut budgets) index (if (< left 0) 0 left)))
              (let [cleaned (finish-private-template! s)]
                (own-definition! definition
                                 (.g s)
                                 (slice (.exits s))
                                 (slice (.import-names s))
                                 (slice (.import-ids s))
                                 a)
                (set! (.clean definition) cleaned)
                (set! (.proof definition) (.proof s)))
              (set! changed true)))
          (close! temporary)))
      (finish-definition-effects! module (elem (mut (.definitions module)) index)))
    (set! (.frozen module) true)
    (when (.trace module)
      (for [i 0 count]
        (let [definition (get (.definitions module) i)
              graph (.graph definition)
              (mut base) (: 0 i64)
              (mut argvals) (: 0 i64)
              (mut histogram) (ArrayList::new [i32] (.a module))
              (mut r) (: 1 i64)]
          (for [op 0 (cast i64 (opcode/count))] (push! (mut histogram) 0))
          (while (< r (len (.instructions graph)))
            (let [opcode (node/opcode (get (.instructions graph) r))
                  cells (/ (+ (cast i64 (get (.arities graph) r)) 4) 4)]
              (unless (or (= opcode 0)
                          (= opcode 104)
                          (= opcode 71)
                          (= opcode 120))
                (set! base (+ base cells)))
              (set! (mut histogram)
                    (cast i64 opcode)
                    (+ (get histogram (cast i64 opcode)) 1))
              (when (= opcode 70) (set! argvals (+ argvals 1)))
              (set! r (+ r cells))))
          (eprintln "stogir finalized {}: {} cells, {} base clone cells, {} budget, {} ARGVALs"
                    (.name (.source definition))
                    (len (.instructions graph))
                    base
                    (get budgets i)
                    argvals)
          (for [op 0 (len histogram)]
            (when (> (get histogram op) 0)
              (eprintln "stogir finalized-op {}: {} {}"
                        (.name (.source definition))
                        op
                        (get histogram op))))
          (free! (mut histogram)))))
    (for [i 0 count]
      (set! (.left (elem (mut (.definitions module)) i)) (get budgets i))
      (set! (.cells (elem (mut (.definitions module)) i))
            (inlining/base-clone-cells (.graph (get (.definitions module) i)))))
    (free! (mut budgets))
    (free! (mut order))))

;;; Emission planning borrows exactly the frozen definition used by codegen.
(defn prepared-index [(module (ptr Module)) (f (ptr cir/Func)) (symbol u32)] (-> i64)
  (let [id (cast i64 symbol)]
    (if (and (.frozen module) (< id (len (.by-symbol module))))
        (let [index (- (get (.by-symbol module) id) 1)]
          (if (and (>= index 0)
                   (= (p/cast u64 (.source (get (.definitions module) index))) (p/cast u64 f)))
              index -1))
        -1)))

;;; The body prepared for F, when there is one.
(defn emission-body [(module (ptr Module)) (f (ptr cir/Func)) (symbol u32)]
  (-> (ptr Definition))
  (let [id (cast i64 symbol)]
    (if (and (< id (len (.body-by-symbol module)))
             (> (get (.body-by-symbol module) id) 0))
        (let [body (elem (mut (.bodies module)) (- (get (.body-by-symbol module) id) 1))]
          (if (= (p/cast u64 (.source (.definition body))) (p/cast u64 f))
              (cast (ptr Definition) (mut (.definition body)))
              (p/cast (ptr Definition) 0)))
        (p/cast (ptr Definition) 0))))

;;; The graph codegen emits for F: its prepared body (a non-template caller, or
;;; a template the final expansion changed), else its finalized template.
(defn emission-definition [(module (ptr Module)) (f (ptr cir/Func)) (symbol u32)]
  (-> (ptr Definition))
  (let [body (emission-body module f symbol)
        index (prepared-index module f symbol)]
    (cond (!= (p/cast i64 body) 0) body
          (>= index 0) (elem (mut (.definitions module)) index)
          :else (p/cast (ptr Definition) 0))))

;;; Whether the body of the non-template function SYMBOL goes without the call
;;; and sparse exemptions: under exempt=never, unless it is :inline (Never).
(defn body-deferred? [(module (ptr Module)) (symbol u32)] (-> bool)
  (and (= (.scope (.inline module)) 0)
       (not (and (< (cast i64 symbol) (len (.outlined module)))
                 (get (.outlined module) (cast i64 symbol))))))

;;; Whether POLICY has exemptions that apply only to emitted bodies.
(defn final-exemptions? [(policy inlining/Policy)] (-> bool)
  (or (> (.call-cells policy) 0) (> (.sparse-cells policy) 0) (.forwarders policy)))

;;; Whether the finalized template at INDEX has a direct call that the final
;;; expansion could take: any callee template when the call is the only one
;;; (a forwarder); for a deferred template, one whose clone fits its
;;; exemption size; for a template held small (wrap), a callee larger than
;;; that size which fits the budget it has left. Everything else
;;; was decided when the template was finalized.
(defn final-candidate? [(module (ptr Module)) (index i64)] (-> bool)
  (let [policy (.policy (.inline module))
        source (.graph (get (.definitions module) index))
        forwarder (and (.forwarders policy) (single-call? source))
        deferred (.deferred (get (.definitions module) index))
        held (and (> (.wrap (.inline module)) 0)
                  (<= (.cells (get (.definitions module) index))
                      (cast i64 (.wrap (.inline module)))))
        (mut found) false
        (mut r) (: 1 i64)]
    (while (and (not found) (< r (len (.instructions source))))
      (let [call (get (.instructions source) r)]
        (when (= (node/opcode call) 79)
          (let [callee (called-definition module source (.op2 call))]
            (when (and (>= callee 0) (!= callee index))
              (let [target (get (.definitions module) callee)
                    limit (cast i64 (if (and (> (.sparse-cells policy) (.call-cells policy))
                                             (sparse-definition? module target))
                                        (.sparse-cells policy)
                                        (.call-cells policy)))]
                (when (or (and forwarder (or (.inlineable target) (.recursive target)))
                          (and deferred (.final (.inline module))
                               (.inlineable target) (<= (.cells target) limit))
                          ; A call a small template may have withheld (wrap)
                          ; that the budget it has left can take.
                          (and held (.inlineable target)
                               (> (.cells target) (cast i64 (.wrap (.inline module))))
                               (<= (.cells target)
                                   (cast i64 (.left (get (.definitions module) index))))))
                  (set! found true))))))
        (set! r (+ r (/ (+ (cast i64 (get (.arities source) r)) 4) 4)))))
    found))

;;; Expand a finalized template once more under the full policy for emission.
;;; The template and its registry snapshot stay as callers cloned them; a
;;; changed graph becomes this function's emission body. The budget is what
;;; finalization left, at least one cell so that exemptions still apply.
(defn prepare-template-body! [(module (ptr Module)) (index i64) (symbol u32)] (-> void)
  (let [work (p/alloc-stack scratch/ScratchArena)]
    (scratch/ScratchArena::init-with-capacity work (malloc-allocator) 65536)
    (let [a (allocator work)
          template (elem (mut (.definitions module)) index)
          (mut state) (zeroed Adapter)
          s (cast (ptr Adapter) (mut state))]
      (set! (.a s) a)
      (set! (.f s) (.source template))
      (set! (.g s) (.graph template))
      (set! (.borrowed s) true)
      (set! (.start s) (.entry template))
      (set! (.proof s) (.proof template))
      (set! (.exits s) (ArrayList::new [i32] a))
      (set! (.import-names s) (ArrayList::new [(slice u8)] a))
      (set! (.import-ids s) (ArrayList::new [u32] a))
      (for [i 0 (len (.observed template))]
        (push! (mut (.exits s)) (get (.observed template) i)))
      (for [i 0 (len (.import-ids template))]
        (push! (mut (.import-names s)) (get (.import-names template) i))
        (push! (mut (.import-ids s)) (get (.import-ids template) i)))
      (when (> (expand-module! s module (if (> (.left template) 1) (.left template) 1) true
                               (not (.final (.inline module)))) 0)
        (let [keep (box! (.a module) scratch/ScratchArena (zeroed scratch/ScratchArena))
              (mut owned) (zeroed Definition)
              definition (cast (ptr Definition) (mut owned))]
          (scratch/ScratchArena::init-with-capacity keep (malloc-allocator) 4096)
          (set! (.clean definition) false) (set! (.proof definition) 0)
          (set! (.inlineable definition) false) (set! (.symbol definition) symbol)
          (set! (.entry definition) (.start s)) (set! (.name definition) (.name (.source template)))
          (set! (.source definition) (.source template))
          (own-definition! definition (.g s) (slice (.exits s))
                           (slice (.import-names s)) (slice (.import-ids s)) (allocator keep))
          (push! (mut (.bodies module)) (EmissionBody :definition owned :arena keep))
          (while (<= (len (.body-by-symbol module)) (cast i64 symbol))
            (push! (mut (.body-by-symbol module)) 0))
          (set! (mut (.body-by-symbol module)) (cast i64 symbol) (len (.bodies module))))))
    (close! work)))

;;; Serial planning moves the old raw-caller preparation before reachability.
;;; Only its finalized graph and bindings enter the retained arena. Adaptation,
;;; SCCP and inlining scratch dies immediately; emission releases the retained
;;; snapshot after use. Callee eligibility and the checked clone cap are unchanged.
(defn prepare-emission-body! [(module (ptr Module)) (f (ptr cir/Func))
                              (ta (ptr asm/Asm)) (symbol u32) (level i32)] (-> void)
  (when (and (= (p/cast i64 (emission-body module f symbol)) 0)
             (>= (prepared-index module f symbol) 0)
             (or (final-exemptions? (.policy (.inline module))) (> (.wrap (.inline module)) 0))
             (final-candidate? module (prepared-index module f symbol)))
    (prepare-template-body! module (prepared-index module f symbol) symbol))
  (when (= (p/cast i64 (emission-definition module f symbol)) 0)
    (unless (.frozen module) (fail (.name f) "emission preparation before registry freeze"))
    (let [work (p/alloc-stack scratch/ScratchArena)
          keep (box! (.a module) scratch/ScratchArena (zeroed scratch/ScratchArena))]
      (scratch/ScratchArena::init-with-capacity work (malloc-allocator) 65536)
      (scratch/ScratchArena::init-with-capacity keep (malloc-allocator) 4096)
      (let [a (allocator work) (mut state) (zeroed Adapter)
            s (cast (ptr Adapter) (mut state))
            (mut owned) (zeroed Definition)
            definition (cast (ptr Definition) (mut owned))]
        (adapt-as! s f ta (cast i64 symbol) (p/cast (ptr (ArrayList MTextData)) 0) a)
        (annotate-call-effects! module (mut (.g s)) a)
        (when (> level 1) (prepare-inline-caller! s))
        (let [changes (expand-module! s module (.budget (.policy (.inline module))) true
                                      (body-deferred? module symbol))]
          (set! (.clean definition) (and (> level 1) (= changes 0)))
          (set! (.proof definition) (if (and (> level 1) (= changes 0)) (.proof s) 0)))
        (set! (.inlineable definition) false) (set! (.symbol definition) symbol)
        (set! (.entry definition) (.start s)) (set! (.name definition) (.name f))
        (set! (.source definition) f)
        (own-definition! definition (.g s) (slice (.exits s))
                         (slice (.import-names s)) (slice (.import-ids s)) (allocator keep))
        (push! (mut (.bodies module)) (EmissionBody :definition owned :arena keep))
        (while (<= (len (.body-by-symbol module)) (cast i64 symbol))
          (push! (mut (.body-by-symbol module)) 0))
        (set! (mut (.body-by-symbol module)) (cast i64 symbol) (len (.bodies module))))
      (close! work))))

;;; Release the retained body of SYMBOL, if it has one, without a timing
;;; record: for a caller whose own record already spans this work.
(defn release-emission-body-untimed! [(module (ptr Module)) (symbol u32)] (-> void)
  (let [id (cast i64 symbol)]
    (when (and (< id (len (.body-by-symbol module))) (> (get (.body-by-symbol module) id) 0))
      (let [body (elem (mut (.bodies module)) (- (get (.body-by-symbol module) id) 1))
            work (.arena body)]
        (when (!= (p/cast i64 work) 0)
          (close! work)
          (set! (.arena body) (p/cast (ptr scratch/ScratchArena) 0)))))))

(defn release-emission-body! [(module (ptr Module)) (symbol u32)] (-> void)
  (let [started (tr/codegen-start)]
    (release-emission-body-untimed! module symbol)
    (tr/codegen-end "stogir" "ir-codegen" started)))

;;; Only references in instruction operands are edges. Dead constants retained
;;; in an interning pool are not function roots. Conservatively scanning every
;;; surviving instruction also retains references in not-yet-pruned CFG arms.
(defn reference-symbols! [(module (ptr Module)) (f (ptr cir/Func)) (symbol u32)
                          (references (mut (ArrayList u32)))] (-> bool)
  (let [definition (emission-definition module f symbol)]
    (if (= (p/cast i64 definition) 0)
        false
        (let [source (.graph definition)
              (mut bindings) (HashMap::new [(slice u8) u32] (.a module) (keyops-borrowed))
              (mut r) 1]
          (for [i 0 (len (.import-names definition))]
            (set! (mut bindings) (get (.import-names definition) i) (get (.import-ids definition) i)))
          (while (< r (len (.instructions source)))
            (let [cell (get (.instructions source) r)
                  count (get (.arities source) r)
                  (mut i) (: 1 i32)]
              (while (<= i count)
                (let [kind (opcode/operand-code (cast i32 (node/opcode cell)) i)]
                  (when (or (= kind opcode/OPERAND-DEF) (= kind opcode/OPERAND-REF))
                    (match (graph/operand source (cast i32 r) i)
                      (None [] (fail (.name f) "emission graph operand missing"))
                      (Some [ref]
                        (when (< ref 0)
                          (match (graph/lookup source ref)
                            (None [] (fail (.name f) "emission graph constant missing"))
                            (Some [constant]
                              (when (or (= (node/opcode constant) 74) (= (node/opcode constant) 75))
                                (match (strings/lookup (.strings source) (cast i32 (node/constant-bits constant)))
                                  (None [] (fail (.name f) "emission graph symbol name missing"))
                                  (Some [name]
                                    (match (get bindings name)
                                      (None [] (fail (.name f) "emission graph symbol binding missing"))
                                      (Some [target] (push! (mut references) target)))))))))))))
                (set! i (+ i 1)))
              (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
          (free! (mut bindings))
          true))))

;;; Raw large callers have not passed the template preparation epoch. Promote
;;; and fold them before context-sensitive inline selection, as templates already
;;; do. Cloning ends this epoch; the native options pipeline still cleans afterward.
(defn prepare-inline-caller! [(s (ptr Adapter))] (-> void)
  (match (sccp/optimize-memory-owned! (.g s) 8 (slice (.exits s)) true (.a s))
    (Err [message] (fail (.name (.f s)) message))
    (Ok [owned]
      (let [(mut owned) owned]
        (free! (mut (.exits s)))
        (set! (.g s) (.graph owned))
        (set! (.exits s) (.roots owned))
        (set! (.proof s) (.proof owned))
        (retain-program-control! s)
        (queue/release! (mut (.iteration owned)))))))

;;; Lossless semantic graph records for offline inspection/replay. This path is
;;; opt-in under existing tracing and never mutates borrowed graph or bindings.
;;; Raw cells preserve references/prototype flags; binary strings use byte rows.
(defn trace-graph! [(s (ptr Adapter)) (selected (slice u8))] (-> void)
  (do
    (when (= selected (.name (.f s)))
      (let [g (.g s)]
        (println "stogir-snapshot begin {} {}" (.start s) (.function-prototype g))
        (for root (.exits s) (println "stogir-snapshot root {}" root))
        (for [i 0 (len (.entries (.strings g)))]
          (match (strings/lookup (.strings g) (cast i32 (+ i 1)))
            (None [] (fail (.name (.f s)) "snapshot string disappeared"))
            (Some [bytes]
                  (print "stogir-snapshot string {} {}" (+ i 1) (len bytes))
                  (for byte bytes (print " {}" byte)) (println ""))))
        (for [i 0 (len (.constants g))]
          (let [cell (get (.constants g) i)]
            (println "stogir-snapshot constant {} {} {} {} {}"
                     (get (.constant-spans g) i) (.header cell) (.op1 cell) (.op2 cell) (.op3 cell))))
        (for [i 0 (len (.instructions g))]
          (let [cell (get (.instructions g) i)]
            (println "stogir-snapshot instruction {} {} {} {} {}"
                     (get (.arities g) i) (.header cell) (.op1 cell) (.op2 cell) (.op3 cell))))
        (for [i 0 (len (.import-names s))]
          (let [key (get (.import-names s) i)
                target (.name (asm/sym-at (.ta s) (get (.import-ids s) i)))]
            (print "stogir-snapshot binding {} {}" (len key) (len target))
            (for byte key (print " {}" byte))
            (for byte target (print " {}" byte)) (println "")))
        (println "stogir-snapshot end")))))

;;; A conservative source filter avoids compiling callers before their private
;;; callees. Every candidate is emitted exactly once, even if effect decoding
;;; later declines it. Only instruction starts are inspected.
(defn native-leaf-candidate? [(graph graph/Graph)] (-> bool)
  (let [(mut valid) (> (.function-prototype graph) 0) (mut r) (: 1 i64)]
    (while (and valid (< r (len (.instructions graph))))
      (if (>= r (len (.arities graph))) (set! valid false)
          (let [count (get (.arities graph) r)
                opcode (node/opcode (get (.instructions graph) r))]
            (if (or (< count 0) (= opcode 79) (= opcode 80))
                (set! valid false)
                (let [step (/ (+ (cast i64 count) 4) 4)]
                  (if (or (<= step 0) (> step (- (len (.instructions graph)) r)))
                      (set! valid false) (set! r (+ r step))))))))
    (and valid (= r (len (.instructions graph))))))

(defn native-cached? [(module (ptr Module)) (f (ptr cir/Func)) (symbol u32)] (-> bool)
  (let [id (cast i64 symbol)]
    (if (and (< id (len (.native-by-symbol module)))
             (> (get (.native-by-symbol module) id) 0))
        (let [entry (at (.native-cache module) (- (get (.native-by-symbol module) id) 1))]
          (unless (and (= (.symbol entry) symbol)
                       (= (p/cast usize (.source entry)) (p/cast usize f)))
            (fail (.name f) "native cache function identity changed"))
          true)
        false)))

(defn begin-native! [(module (ptr Module)) (ta (ptr asm/Asm))] (-> void)
  (unless (and (.frozen module) (= (p/cast usize (.native-target module)) 0))
    (fail "module" "native preparation requires a fresh frozen module"))
  (set! (.native-target module) ta)
  (set! (.native-context module)
        (private/with-strength (private/with-regional (private/with-recolor (private/with-global-loads
        (private/with-keep-diamonds (private/with-if-convert
        (private/with-hoist-loads
        (private/with-induction
        (private/with-branch-facts
        (private/with-rotate
        (private/with-predict
        (private/with-frame-split
        (private/with-call-holes
         (private/with-loop-evict
          (private/with-loop-reloads
            (private/with-prune-default
              (private/with-shrink-retry
                (private/with-shrink-wrap (private/context-create (.a module)) (.shrink-wrap module))
                (.shrink-retry module))
              (.prune-default module))
            (.loop-reloads module))
          (.loop-evict module))
         (.call-holes module))
        (.frame-split module))
        (.predict module))
        (.rotate module))
        (.branch-facts module))
        (.induction module))
        (.hoist-loads module)) (.if-convert module)) (not (.select module))) (.global-loads module)) (.recolor module)) (.regional module)) (.strength module))))

;;; Compose copies only the finished image into module ownership. All optimizer,
;;; CFG, allocation and temporary native image storage dies with per-leaf work.
(defn retain-native-image [(source image/Image) (a (dyn Allocator))] (-> image/Image)
  (match (native-link/compose [source] a)
    (Err [message] (fail "native cache" message))
    (Ok [cloned]
      (let [(mut cloned) cloned result (load (mut (.image cloned)))]
        (store! (mut (.image cloned)) (image/create a))
        (native-link/release! (mut cloned)) result))))

(defn published-native-text [(ta (ptr asm/Asm)) (entry NativeCache)] (-> (slice u8))
  (let [symbol (asm/sym-at ta (.symbol entry))
        text (buf/as-slice (asm/sect-buf ta asm/SEC-TEXT))]
    (unless (and (= (.binding symbol) asm/BIND-LOCAL) (= (.sect symbol) asm/SEC-TEXT)
                 (= (.size symbol) (len (.text (.image entry))))
                 (>= (.off symbol) 0) (<= (.off symbol) (len text))
                 (<= (.size symbol) (- (len text) (.off symbol))))
      (fail (.label entry) "private native publication metadata changed"))
    (subslice text (.off symbol) (+ (.off symbol) (.size symbol)))))

(defn precompile-native-leaf! [(module (ptr Module)) (f (ptr cir/Func))
                               (ta (ptr asm/Asm)) (symbol u32)
                               (text-data (ptr (ArrayList MTextData))) (level i32)] (-> void)
  (let [definition (emission-definition module f symbol)]
    (when (and (!= (p/cast usize definition) 0)
               (= (.binding (asm/sym-at ta symbol)) asm/BIND-LOCAL)
               (not (native-cached? module f symbol))
               (native-leaf-candidate? (.graph definition)))
      (let [work (p/alloc-stack scratch/ScratchArena)]
        (scratch/ScratchArena::init-with-capacity work (malloc-allocator) 65536)
        (let [(mut state) (zeroed Adapter) s (p/cast (ptr Adapter) (mut state))]
          (set! (.a s) (.a module)) (set! (.f s) f) (set! (.ta s) ta)
          (set! (.text-data s) text-data) (set! (.g s) (.graph definition))
          (set! (.start s) (.entry definition)) (set! (.exits s) (.observed definition))
          (set! (.import-names s) (.import-names definition))
          (set! (.import-ids s) (.import-ids definition))
          (when (.trace module) (trace-graph! s (.graph module)))
          (match (native/image-with-private (.graph definition) (.entry definition)
                   (slice (.observed definition)) "_coil_stogir_body"
                   (native-options/Options :level level) (allocator work)
                   (private/with-strength (private/with-regional (private/with-recolor (private/with-global-loads
                     (private/with-keep-diamonds (private/with-if-convert
                     (private/with-hoist-loads
                   (private/with-induction
                     (private/with-branch-facts (private/no-context) (.branch-facts module))
                     (.induction module)) (.hoist-loads module)) (.if-convert module)) (not (.select module))) (.global-loads module)) (.recolor module)) (.regional module)) (.strength module)))
            (Err [message] (fail (.name f) message))
            (Ok [temporary]
              (let [(mut temporary) temporary
                    (mut cached) (retain-native-image temporary (.a module))
                    root (match (image/find-symbol cached "_coil_stogir_body")
                           (None [] (fail (.name f) "cached entry missing")) (Some [root] root))
                    name (import-name (.a module) symbol)
                    signature (match (strings/lookup (.strings (.graph definition))
                                       (.function-prototype (.graph definition)))
                                (None [] (fail (.name f) "private function prototype missing"))
                                (Some [signature] signature))]
                ; The temporary label's privacy follows the actual target symbol,
                ; checked above. Its logical name stays intact for ordinary merge.
                (set! (.global? (elem (mut (.symbols cached)) (cast i64 root))) false)
                (let [accepted (match (private/register-as! (mut (.native-context module))
                                        name cached root (len (.text cached)) signature)
                                 (Err [message] (fail (.name f) message)) (Ok [accepted] accepted))
                      entry (NativeCache :source f :symbol symbol :name name
                              :label (sconcat (.a module) (.name f) "")
                              :image cached :certified accepted)]
                  (merge! s cached symbol module)
                  (when accepted
                    (let [actual (asm/sym-at ta symbol)]
                      (match (private/confirm-publication! (mut (.native-context module))
                               (p/cast usize ta) name (cast i64 symbol) (.binding actual)
                               (published-native-text ta entry))
                        (Err [message] (fail (.name f) message))
                        (Ok [confirmed] (unless confirmed (fail (.name f) "private body not registered")))))
                    (set! (.native-certified module) (+ (.native-certified module) 1)))
                  (while (<= (len (.native-by-symbol module)) (cast i64 symbol))
                    (push! (mut (.native-by-symbol module)) 0))
                  (push! (mut (.native-cache module)) entry)
                  (set! (mut (.native-by-symbol module)) (cast i64 symbol) (len (.native-cache module)))
                  (when (.trace module)
                    (eprintln "stogir native-leaf {}: certified{} bytes{}" (.name f) accepted (len (.text cached)))
                    (eprint "stogir native-prototype {} {}" name (.name f))
                    (for byte signature (eprint " {}" byte)) (eprintln "")))
                (image/release! (mut temporary))))))
        (close! work)))))

(defn seal-native! [(module (ptr Module)) (ta (ptr asm/Asm))] (-> void)
  (set! (.native-publication module)
    (match (private/seal-module! (mut (.native-context module)) (p/cast usize ta))
      (None [] (fail "module" "private native publication incomplete")) (Some [p] p)))
  (when (.trace module)
    (eprintln "stogir native-cache: {} images, {} certified" (len (.native-cache module)) (.native-certified module))))

(defn verify-native! [(module (ptr Module)) (ta (ptr asm/Asm))] (-> void)
  (for entry (.native-cache module)
    (when (.certified entry)
      (unless (private/verify-publication (.native-context module) (.native-publication module)
                 (p/cast usize ta) (.name entry) (cast i64 (.symbol entry))
                 (.binding (asm/sym-at ta (.symbol entry))) (published-native-text ta entry))
        (fail (.label entry) "private native publication changed before finalization")))))

(defn diagnostic-native-context [(module (ptr Module)) (f (ptr cir/Func))]
  (-> private/Context)
  (let [context (.native-context module)]
    (if (.trace module)
        (private/with-allocation-trace context (= (.graph module) (.name f)))
        context)))

;;; The image of one function body: the private-module pipeline when the
;;; module published certified leaves, the plain pipeline otherwise, each
;;; skipping its entry SCCP for a graph that is still optimizer output
;;; (OPTIMIZED). CONTEXT is the module's native context (or its diagnostic
;;; variant) and is only read; SCOPE identifies the target assembler. Nothing
;;; here writes shared state: GRAPH and ROOTS are borrowed, every allocation
;;; comes from A, so emission workers call it concurrently, one graph each.
(defn native-image [(module (ptr Module)) (g graph/Graph) (start i32) (roots (slice i32))
                    (proof u128) (optimized bool) (optimization i32) (a (dyn Allocator))
                    (context private/Context) (scope usize)]
  (-> (Result image/Image (slice u8)))
  (cond (and (!= (p/cast usize module) 0) (> (.native-certified module) 0) optimized)
          (native/image-for-private-module-proven g start roots
            "_coil_stogir_body" (native-options/Options :level optimization) a
            context (.native-publication module) scope proof)
        (and (!= (p/cast usize module) 0) (> (.native-certified module) 0))
          (native/image-for-private-module g start roots
            "_coil_stogir_body" (native-options/Options :level optimization) a
            context (.native-publication module) scope)
        (and (!= (p/cast usize module) 0) (or (.strength module) (.branch-facts module) (.induction module) (.hoist-loads module) (.if-convert module) (not (.select module)) (.global-loads module) (.recolor module) (.regional module)))
          (native/image-with-private g start roots
            "_coil_stogir_body" (native-options/Options :level optimization) a
            (private/with-strength (private/with-regional (private/with-recolor (private/with-global-loads
              (private/with-keep-diamonds (private/with-if-convert
              (private/with-hoist-loads
                (private/with-induction
                  (private/with-branch-facts (private/no-context) (.branch-facts module)) (.induction module))
                (.hoist-loads module)) (.if-convert module)) (not (.select module))) (.global-loads module)) (.recolor module)) (.regional module)) (.strength module)))
        optimized
          (native/image-with-options-proven g start roots
            "_coil_stogir_body" (native-options/Options :level optimization) a proof)
        :else
          (native/image-with-options g start roots
            "_coil_stogir_body" (native-options/Options :level optimization) a)))

(defn compile-with-module! [(f (ptr cir/Func))
                            (ta (ptr asm/Asm))
                            (symbol u32)
                            (text-data (ptr (ArrayList MTextData)))
                            (optimization i32)
                            (module (ptr Module))] (-> void)
  (when (and (!= (p/cast usize module) 0)
             (!= (p/cast usize (.native-target module)) 0)
             (!= (p/cast usize (.native-target module)) (p/cast usize ta)))
    (fail (.name f) "native module target changed"))
  (if (and (!= (p/cast usize module) 0) (native-cached? module f symbol))
      (when (.trace module) (eprintln "stogir reuse-native {}" (.name f)))
  (let [work (p/alloc-stack scratch/ScratchArena)
        codegen-start (tr/codegen-start)]
    (scratch/ScratchArena::init-with-capacity work (malloc-allocator) 65536)
    (let [a (allocator work)
          (mut state) (zeroed Adapter)
          s (cast (ptr Adapter) (mut state))
          (mut optimized) false]
      (let [(mut prepared) false]
        ; Finalized templates are immutable and already own their graph, roots
        ; and import bindings. Borrow them through image generation; the native
        ; options API still rebuilds optimization, CFG, matching and allocation.
        (when (!= (p/cast i64 module) 0)
          (let [definition (emission-definition module f symbol)]
            (when (!= (p/cast i64 definition) 0)
              (set! (.a s) a) (set! (.f s) f) (set! (.ta s) ta)
              (set! (.text-data s) text-data)
              (set! (.g s) (.graph definition)) (set! (.start s) (.entry definition))
              (set! (.exits s) (.observed definition))
              (set! (.import-names s) (.import-names definition))
              (set! (.import-ids s) (.import-ids definition))
              (set! (.proof s) (.proof definition))
              (set! optimized (and (.clean definition) (> optimization 1)))
              (set! prepared true))))
        (unless prepared
          (adapt-as! s f ta (cast i64 symbol) text-data a)
          (when (!= (p/cast i64 module) 0)
            (annotate-call-effects! module (mut (.g s)) a))
          (when (and (!= (p/cast i64 module) 0) (> optimization 1))
            (prepare-inline-caller! s)
            (set! optimized true))
          ; Inline expansion invalidates the SCCP fixpoint; zero changes keep it.
          (when (> (expand-module! s module (if (= (p/cast i64 module) 0) (inline-budget)
                                                (.budget (.policy (.inline module)))) true
                                   (and (!= (p/cast i64 module) 0) (body-deferred? module symbol))) 0)
            (set! optimized false))))
      (when (and (!= (p/cast u64 module) 0) (.trace module)) (trace-graph! s (.graph module)))
      (match (native-image module (.g s) (.start s) (slice (.exits s)) (.proof s) optimized
                           optimization a
                           (if (!= (p/cast usize module) 0)
                               (diagnostic-native-context module f)
                               (private/no-context))
                           (p/cast usize ta))
        (Err [message] (fail (.name f) message))
        (Ok [result] (merge! s result symbol module))))
    (close! work)
    (tr/codegen-end "stogir" "ir-codegen" codegen-start))))

;;; ---- Parallel generation ----
;;;
;;; Two stages of module generation consist of per-function work that reads
;;; and writes nothing but that function's own data: optimizing an adapted
;;; template (prepare-optimize!) and generating a function's image from its
;;; frozen definition (native-image). Those run on worker threads. Everything
;;; that touches shared state (the assembler, the module's lists and arena,
;;; the callee registry) stays on the submitting thread, which performs it
;;; in submission order at points fixed by task indices alone. The object is
;;; therefore the same bytes for any thread count and any scheduling, and
;;; nothing a worker decides depends on what another worker has finished.
;;; See "Parallel emission" in src/compiler/stogir/README.md.

;;; One unit of work for a worker and whether it has finished.
(defstruct PoolTask [(argument (ptr i8)) (done bool)])

;;; Worker threads running `run` on submitted arguments, each exactly once.
;;; `tasks` (reserved to `capacity` at creation, so that its storage never
;;; moves), `next` (the next unclaimed task), `closed` and `awaited` (the
;;; task the submitter is blocked on, or -1) are guarded by `mutex`. Workers
;;; wait on `work` for a task or the close; the one submitting thread waits
;;; on `finished` for its awaited task. A task's argument is handed to the
;;; worker and back to the submitter under that mutex, so the two never use
;;; it at the same time.
(defstruct Pool
  [(run (fnptr (cc/C) [(ptr i8)] (ptr i8)))
   (tasks (ArrayList PoolTask)) (capacity i64)
   (mutex Mutex) (work Condition) (finished Condition)
   (next i64) (closed bool) (awaited i64)
   (threads (ArrayList Thread)) (started i64)])

(defn pool-lock! [(pool (ptr Pool))] (-> void)
  (match (Mutex::lock! (field pool mutex))
    (Ok [_] 0) (Err [_] (fail "worker pool" "mutex lock failed"))))

(defn pool-unlock! [(pool (ptr Pool))] (-> void)
  (match (Mutex::unlock! (field pool mutex))
    (Ok [_] 0) (Err [_] (fail "worker pool" "mutex unlock failed"))))

;;; Wait on CONDITION (of POOL); the caller holds the mutex.
(defn pool-wait! [(pool (ptr Pool)) (condition (ptr Condition))] (-> void)
  (match (Condition::wait! condition (field pool mutex))
    (Ok [_] 0) (Err [_] (fail "worker pool" "condition wait failed"))))

(defn pool-notify-one! [(condition (ptr Condition))] (-> void)
  (match (Condition::notify-one! condition)
    (Ok [_] 0) (Err [_] (fail "worker pool" "condition notify failed"))))

(defn pool-notify-all! [(condition (ptr Condition))] (-> void)
  (match (Condition::notify-all! condition)
    (Ok [_] 0) (Err [_] (fail "worker pool" "condition notify failed"))))

(defn pool-worker [(argument (ptr i8))] (-> (ptr i8))
  (let [pool (p/cast (ptr Pool) argument)]
    (pool-lock! pool)
    (loop
      (while (and (>= (.next pool) (len (.tasks pool))) (not (.closed pool)))
        (pool-wait! pool (field pool work)))
      (if (>= (.next pool) (len (.tasks pool)))
          (break)
          (let [index (.next pool)
                task (.argument (get (.tasks pool) index))
                run (.run pool)]
            (set! (.next pool) (+ index 1))
            (pool-unlock! pool)
            (run task)
            (pool-lock! pool)
            (set! (.done (elem (mut (.tasks pool)) index)) true)
            (when (= index (.awaited pool)) (pool-notify-one! (field pool finished))))))
    (pool-unlock! pool)
    (p/cast (ptr i8) 0)))

;;; A pool of up to THREADS workers for at most CAPACITY tasks, or null when
;;; not even one thread could be started (nothing has been done; the caller
;;; takes its serial path). Workers get the stack of the compiler's own
;;; pipeline thread, which is what this work runs on serially.
(defn pool-start [(run (fnptr (cc/C) [(ptr i8)] (ptr i8))) (capacity i64) (threads i64)]
  (-> (ptr Pool))
  (when (or (< threads 1) (< capacity 0)) (fail "worker pool" "invalid pool size"))
  (let [pool (box! (malloc-allocator) Pool (zeroed Pool))
        (mut refused) false]
    (set! (.run pool) run) (set! (.capacity pool) capacity) (set! (.awaited pool) -1)
    (set! (.tasks pool) (ArrayList::new [PoolTask] (malloc-allocator)))
    (reserve! (mut (.tasks pool)) capacity)
    (set! (.threads pool) (ArrayList::new [Thread] (malloc-allocator)))
    ; Thread handles must not move once a thread has been created into one.
    (for [i 0 threads] (push! (mut (.threads pool)) (zeroed Thread)))
    (match (Mutex::init (field pool mutex))
      (Ok [_] 0) (Err [_] (fail "worker pool" "mutex creation failed")))
    (match (Condition::init (field pool work))
      (Ok [_] 0) (Err [_] (fail "worker pool" "condition creation failed")))
    (match (Condition::init (field pool finished))
      (Ok [_] 0) (Err [_] (fail "worker pool" "condition creation failed")))
    (while (and (not refused) (< (.started pool) threads))
      (if (= (Thread::spawn-configured (elem (mut (.threads pool)) (.started pool))
                                       (fnptr-of pool-worker)
                                       (p/cast (ptr i8) pool)
                                       (ThreadConfig::new (worker-stack-size) -1))
             (: 0 i32))
          (set! (.started pool) (+ (.started pool) 1))
          (set! refused true)))
    (if (> (.started pool) 0)
        pool
        (do (pool-finish! pool) (p/cast (ptr Pool) 0)))))

;;; Hand ARGUMENT to the workers; the result is its task index, counting up
;;; from zero. The submitter must not touch what ARGUMENT designates again
;;; before pool-await! of that index.
(defn pool-submit! [(pool (ptr Pool)) (argument (ptr i8))] (-> i64)
  (pool-lock! pool)
  (let [index (len (.tasks pool))]
    (when (or (.closed pool) (>= index (.capacity pool)))
      (fail "worker pool" "task submitted beyond the pool's capacity"))
    (push! (mut (.tasks pool)) (PoolTask :argument argument :done false))
    (pool-notify-one! (field pool work))
    (pool-unlock! pool)
    index))

;;; Block until task INDEX has run.
(defn pool-await! [(pool (ptr Pool)) (index i64)] (-> void)
  (pool-lock! pool)
  (when (>= index (len (.tasks pool))) (fail "worker pool" "awaited task was never submitted"))
  (set! (.awaited pool) index)
  (while (not (.done (get (.tasks pool) index))) (pool-wait! pool (field pool finished)))
  (set! (.awaited pool) -1)
  (pool-unlock! pool))

;;; Let the workers run out of tasks, join them and release POOL.
(defn pool-finish! [(pool (ptr Pool))] (-> void)
  (pool-lock! pool)
  (set! (.closed pool) true)
  (pool-notify-all! (field pool work))
  (pool-unlock! pool)
  (for [i 0 (.started pool)]
    (unless (= (Thread::join (elem (mut (.threads pool)) i)) (: 0 i32))
      (fail "worker pool" "thread join failed")))
  (match (Condition::destroy! (field pool work))
    (Ok [_] 0) (Err [_] (fail "worker pool" "condition release failed")))
  (match (Condition::destroy! (field pool finished))
    (Ok [_] 0) (Err [_] (fail "worker pool" "condition release failed")))
  (match (Mutex::destroy! (field pool mutex))
    (Ok [_] 0) (Err [_] (fail "worker pool" "mutex release failed")))
  (free! (mut (.threads pool)))
  (free! (mut (.tasks pool)))
  (destroy (malloc-allocator) pool))

;;; How many threads do the per-function work of module generation, from
;;; execution-read. COIL_TPDE_SERIAL is always one: the serial path. Otherwise
;;; COIL_STOGIR_THREADS=N is N. Otherwise one while COIL_CODEGEN_TIMINGS is on,
;;; whose records are summed as serial CPU time, and else the online
;;; processors, at most eight.
(defn generation-threads [] (-> i64)
  (let [execution (execution-read)]
    (cond (.serial execution) 1
          (> (.threads execution) 0) (.threads execution)
          (tr/codegen-enabled?) 1
          :else
            (match (thread/available-parallelism)
              (Ok [n] (cond (< n 1) 1 (> n 8) 8 :else n))
              (Err [_] 1)))))

;;; How far the submitting thread lets submitted work run ahead of the work
;;; it has taken back, per pool: enough that workers do not idle behind one
;;; slow function, bounded so that retained scratch arenas are.
(defn generation-lead [(threads i64)] (-> i64)
  (* 64 threads))

;;; ---- Parallel template preparation ----

;;; One template candidate between its adaptation and its commit. The arena
;;; holds the adapted graph and everything optimization allocates.
(defstruct PreparationItem
  [(source (ptr cir/Func)) (symbol u32) (always bool)
   (arena scratch/ScratchArena) (state Adapter)
   (failed bool) (message (slice u8)) (prepared PreparedTemplate)])

;;; module-prepare! with prepare-optimize! on workers. `items` holds the
;;; candidates submitted and not yet committed, oldest at `committed`.
(defstruct Preparation
  [(module (ptr Module)) (ta (ptr asm/Asm)) (pool (ptr Pool))
   (items (ArrayList (ptr PreparationItem))) (committed i64) (lead i64)])

(defn preparation-task [(argument (ptr i8))] (-> (ptr i8))
  (let [item (p/cast (ptr PreparationItem) argument)]
    (match (prepare-optimize! (cast (ptr Adapter) (mut (.state item)))
                              (allocator (field item arena)))
      (Err [message] (set! (.failed item) true) (set! (.message item) message))
      (Ok [prepared] (set! (.prepared item) prepared)))
    (p/cast (ptr i8) 0)))

;;; Start parallel preparation of at most CAPACITY functions, or null when no
;;; worker thread could be started (the caller then uses module-prepare!).
(defn preparation-start [(module (ptr Module)) (ta (ptr asm/Asm)) (capacity i64) (threads i64)]
  (-> (ptr Preparation))
  (when (or (.frozen module) (.trace module))
    (fail "preparation" "parallel preparation needs an unfrozen module without tracing"))
  (let [pool (pool-start (fnptr-of preparation-task) capacity threads)]
    (if (= (p/cast usize pool) 0)
        (p/cast (ptr Preparation) 0)
        (let [preparation (box! (malloc-allocator) Preparation (zeroed Preparation))]
          (set! (.module preparation) module) (set! (.ta preparation) ta)
          (set! (.pool preparation) pool) (set! (.lead preparation) (generation-lead threads))
          (set! (.items preparation)
                (ArrayList::new [(ptr PreparationItem)] (malloc-allocator)))
          preparation))))

;;; Take back the oldest submitted candidate and enter it into the module:
;;; module-prepare!'s commit, in submission order. A failed optimization is
;;; reported here.
(defn preparation-commit! [(preparation (ptr Preparation))] (-> void)
  (let [index (.committed preparation)
        item (get (.items preparation) index)]
    (pool-await! (.pool preparation) index)
    (when (.failed item) (fail (.name (.source item)) (.message item)))
    (prepare-commit! (.module preparation) (cast (ptr Adapter) (mut (.state item)))
                     (.source item) (.symbol item) (.always item) (.prepared item))
    (close! (field item arena))
    (destroy (malloc-allocator) item)
    (set! (.committed preparation) (+ index 1))))

;;; module-prepare! for F, with its optimization on a worker. F is adapted
;;; here, on the submitting thread, so import symbols are bound in the serial
;;; order. Its commit follows once `lead` later candidates have been
;;; submitted (or at preparation-finish!): a point fixed by submission
;;; counts, not by when workers finish. Neither adaptation nor optimization
;;; reads what a commit writes, so the module is the one module-prepare!
;;; builds.
(defn preparation-submit! [(preparation (ptr Preparation)) (f (ptr cir/Func)) (symbol u32)
                           (never bool) (always bool)] (-> void)
  (let [module (.module preparation)]
    (prepare-note! module f symbol never)
    (when (template-candidate? module f never)
      (let [item (box! (malloc-allocator) PreparationItem (zeroed PreparationItem))
            work (field item arena)]
        (scratch/ScratchArena::init-with-capacity work (malloc-allocator) 65536)
        (set! (.source item) f) (set! (.symbol item) symbol) (set! (.always item) always)
        (if (prepare-adapt! module (cast (ptr Adapter) (mut (.state item))) f
                            (.ta preparation) symbol (allocator work))
            (do
              (push! (mut (.items preparation)) item)
              (unless (= (pool-submit! (.pool preparation) (p/cast (ptr i8) item))
                         (- (len (.items preparation)) 1))
                (fail (.name f) "preparation task index differs from its item"))
              (while (> (- (len (.items preparation)) (.committed preparation))
                        (.lead preparation))
                (preparation-commit! preparation)))
            (do (close! work) (destroy (malloc-allocator) item)))))))

;;; Commit every remaining candidate, join the workers and release PREPARATION.
(defn preparation-finish! [(preparation (ptr Preparation))] (-> void)
  (while (< (.committed preparation) (len (.items preparation)))
    (preparation-commit! preparation))
  (pool-finish! (.pool preparation))
  (free! (mut (.items preparation)))
  (destroy (malloc-allocator) preparation))

;;; ---- Parallel emission ----
;;;
;;; After module-finish!, emission planning and the native leaf cache, every
;;; function still to be emitted has a frozen Definition (its finalized
;;; template or its prepared emission body) and its image depends on nothing
;;; else that changes: native-image reads that one graph, the sealed native
;;; context and the module's settings. So the images are generated on
;;; workers, and the submitting thread merges them into the assembler in
;;; submission order, exactly where the serial loop would have.

;;; One function awaiting its image. The arena is the worker's scratch for
;;; this function; it owns the image and is closed by the merging thread once
;;; the image is in the assembler.
(defstruct EmissionItem
  [(emission (ptr Emission)) (source (ptr cir/Func)) (symbol u32)
   (definition (ptr Definition))
   (failed bool) (message (slice u8)) (image image/Image)
   (arena scratch/ScratchArena)])

;;; `items` is complete before the pool starts and does not move afterwards.
;;; Items below `submitted` have been handed to the pool and those below
;;; `merged` are in the assembler.
(defstruct Emission
  [(module (ptr Module)) (ta (ptr asm/Asm)) (level i32)
   (items (ArrayList EmissionItem))
   (pool (ptr Pool)) (lead i64) (submitted i64) (merged i64)])

;;; Whether F can be emitted from frozen module state alone: it is already
;;; published from the native cache, or it has a prepared definition. A
;;; function without one is still adapted at emission, which creates
;;; assembler symbols in emission order and so stays on the serial path.
(defn emission-ready? [(module (ptr Module)) (f (ptr cir/Func)) (symbol u32)] (-> bool)
  (and (.frozen module) (not (.trace module))
       (or (native-cached? module f symbol)
           (!= (p/cast usize (emission-definition module f symbol)) 0))))

(defn emission-create [(module (ptr Module)) (ta (ptr asm/Asm)) (level i32)] (-> (ptr Emission))
  (unless (and (.frozen module) (not (.trace module)))
    (fail "emission" "parallel emission needs a frozen module without tracing"))
  (when (and (!= (p/cast usize (.native-target module)) 0)
             (!= (p/cast usize (.native-target module)) (p/cast usize ta)))
    (fail "emission" "native module target changed"))
  (let [e (box! (malloc-allocator) Emission (zeroed Emission))]
    (set! (.module e) module) (set! (.ta e) ta) (set! (.level e) level)
    (set! (.items e) (ArrayList::new [EmissionItem] (malloc-allocator)))
    e))

;;; Queue F for emission and return its item index, or -1 when its code is
;;; already published from the native cache. Items are merged in this order.
(defn emission-add! [(e (ptr Emission)) (f (ptr cir/Func)) (symbol u32)] (-> i64)
  (let [module (.module e)]
    (when (!= (p/cast usize (.pool e)) 0) (fail (.name f) "emission item added after start"))
    (if (native-cached? module f symbol)
        -1
        (let [definition (emission-definition module f symbol)
              (mut item) (zeroed EmissionItem)]
          (when (= (p/cast usize definition) 0)
            (fail (.name f) "parallel emission of an unprepared function"))
          (set! (.emission item) e)
          (set! (.source item) f) (set! (.symbol item) symbol)
          (set! (.definition item) definition)
          (push! (mut (.items e)) item)
          (- (len (.items e)) 1)))))

;;; A worker's whole effect on shared memory: the item's result fields. The
;;; definition, the module settings and the sealed native context are only
;;; read; every allocation is from the item's own arena.
(defn emission-task [(argument (ptr i8))] (-> (ptr i8))
  (let [item (p/cast (ptr EmissionItem) argument)
        e (.emission item) module (.module e) definition (.definition item)
        work (field item arena)]
    (scratch/ScratchArena::init-with-capacity work (malloc-allocator) 65536)
    (match (native-image module (.graph definition) (.entry definition)
                         (slice (.observed definition)) (.proof definition)
                         (and (.clean definition) (> (.level e) 1)) (.level e)
                         (allocator work) (.native-context module) (p/cast usize (.ta e)))
      (Err [message] (set! (.failed item) true) (set! (.message item) message))
      (Ok [result] (set! (.image item) result)))
    (p/cast (ptr i8) 0)))

;;; Start up to THREADS workers for the queued items. False when no thread
;;; could be started: nothing has been emitted and the caller emits serially
;;; (emission-finish! still releases E).
(defn emission-start! [(e (ptr Emission)) (threads i64)] (-> bool)
  (when (!= (p/cast usize (.pool e)) 0) (fail "emission" "emission started twice"))
  (set! (.lead e) (generation-lead threads))
  (set! (.pool e) (pool-start (fnptr-of emission-task) (len (.items e)) threads))
  (!= (p/cast usize (.pool e)) 0))

;;; Merge item INDEX into the assembler, waiting for its image. Items must be
;;; merged in increasing order with no gaps: that order, not the order in
;;; which workers finish, fixes every offset and symbol in the object. Items
;;; are handed to the workers up to `lead` ahead of the merge. A failed
;;; function is reported here, so the first failure in submission order is
;;; the one reported, as on the serial path.
(defn emission-merge! [(e (ptr Emission)) (index i64)
                       (text-data (ptr (ArrayList MTextData)))] (-> void)
  (when (or (= (p/cast usize (.pool e)) 0) (!= index (.merged e)) (>= index (len (.items e))))
    (fail "emission" "emission merge out of order"))
  (while (and (< (.submitted e) (len (.items e)))
              (< (.submitted e) (+ index (.lead e))))
    (unless (= (pool-submit! (.pool e)
                             (p/cast (ptr i8) (elem (mut (.items e)) (.submitted e))))
               (.submitted e))
      (fail "emission" "emission task index differs from its item"))
    (set! (.submitted e) (+ (.submitted e) 1)))
  (pool-await! (.pool e) index)
  (let [item (elem (mut (.items e)) index)
        definition (.definition item)
        work (field item arena)]
    (when (.failed item) (fail (.name (.source item)) (.message item)))
    (let [(mut state) (zeroed Adapter)
          s (cast (ptr Adapter) (mut state))]
      (set! (.a s) (allocator work)) (set! (.f s) (.source item)) (set! (.ta s) (.ta e))
      (set! (.text-data s) text-data)
      (set! (.import-names s) (.import-names definition))
      (set! (.import-ids s) (.import-ids definition))
      (merge! s (.image item) (.symbol item) (.module e)))
    (close! work)
    (set! (.merged e) (+ index 1))))

;;; Join the workers and release E. Every item must have been merged.
(defn emission-finish! [(e (ptr Emission))] (-> void)
  (when (!= (p/cast usize (.pool e)) 0)
    (when (!= (.merged e) (len (.items e)))
      (fail "emission" "emission finished with unmerged functions"))
    (pool-finish! (.pool e)))
  (free! (mut (.items e)))
  (destroy (malloc-allocator) e))

(defn compile! [(f (ptr cir/Func))
                (ta (ptr asm/Asm))
                (symbol u32)
                (text-data (ptr (ArrayList MTextData)))
                (optimization i32)] (-> void)
  (compile-with-module! f
                        ta
                        symbol
                        text-data
                        optimization
                        (p/cast (ptr Module) 0)))
